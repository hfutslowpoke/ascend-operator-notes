#define main main_bench_entry
#include "bench.asc"
#undef main

int main(int argc,char** argv) {
    // Same built kernel image serves numerical checking and original timing.
    if (argc >= 10) return main_bench_entry(argc, argv);
    try {
        if(argc!=3 && argc!=5) throw std::runtime_error("verify_batch DEVICE MANIFEST");
        const int repeats=argc==5?std::stoi(argv[3]):1;
        const std::string stressDir=argc==5?argv[4]:"";
        Session session(std::stoi(argv[1]));session.start();
        int64_t cores=0;check(aclrtGetDeviceInfo(session.device,ACL_DEV_ATTR_AICORE_CORE_NUM,&cores));
        std::ifstream list(argv[2]);if(!list)throw std::runtime_error("cannot read manifest");
        std::string name,dir;int64_t m,k,n,e;
        while(list>>name>>m>>k>>n>>e>>dir){
            DeviceMemory memory;
            const size_t xb=m*k,wb=e*k*n,sb=e*n*sizeof(float),gb=e*sizeof(int64_t),yb=m*n*sizeof(uint16_t);
            void* x=memory.allocate(xb);void* w=memory.allocate(wb);void* s=memory.allocate(sb);void* g=memory.allocate(gb);constexpr size_t guard=512;
            void* ya=memory.allocate(yb+2*guard);void* y=static_cast<char*>(ya)+guard;
            check(aclrtMemset(ya,yb+2*guard,0xa7,yb+2*guard));
            load(dir+"/input/x.bin",x,xb);load(dir+"/input/weight.bin",w,wb);load(dir+"/input/scale.bin",s,sb);load(dir+"/input/group_list.bin",g,gb);
            check(aclrtMemset(y,yb,0x5a,yb));
            int64_t xs[2]={m,k},ws[3]={e,k,n},ss[2]={e,n},gs[1]={e},ys[2]={m,n};
            TensorInfo xi{xs,2,3},wi{ws,3,3},si{ss,2,0},gi{gs,1,6},yi{ys,2,1};
            TensorGroupInfo xg{&xi,1},wg{&wi,1},sg{&si,1},gg{&gi,1},yg{&yi,1};
            for(int rep=0;rep<repeats;++rep){
            check(aclrtMemset(y,yb,0x5a,yb));
            run_kernel((GM_ADDR)x,xg,(GM_ADDR)w,wg,(GM_ADDR)s,sg,(GM_ADDR)g,gg,(GM_ADDR)y,yg,cores,session.stream);
            check(aclrtSynchronizeStream(session.stream));
            std::vector<unsigned char> prefixGuard(guard),suffixGuard(guard);
            check(aclrtMemcpy(prefixGuard.data(),guard,ya,guard,ACL_MEMCPY_DEVICE_TO_HOST));
            check(aclrtMemcpy(suffixGuard.data(),guard,static_cast<char*>(y)+yb,guard,ACL_MEMCPY_DEVICE_TO_HOST));
            for(auto v:prefixGuard)if(v!=0xa7)throw std::runtime_error("prefix overrun "+name);
            for(auto v:suffixGuard)if(v!=0xa7)throw std::runtime_error("suffix overrun "+name);
            // Numeric-only path: timing dispatch returns before this loop.
            auto unchanged = [&](const std::string& fileName, void* address, size_t bytes) {
                std::vector<char> before(bytes), after(bytes);
                std::ifstream input(dir+"/input/"+fileName, std::ios::binary);
                input.read(before.data(),bytes);
                if(!input) throw std::runtime_error("cannot reread input "+fileName);
                check(aclrtMemcpy(after.data(),bytes,address,bytes,ACL_MEMCPY_DEVICE_TO_HOST));
                if(before != after) throw std::runtime_error("kernel mutated input "+fileName+" in "+name);
            };
            unchanged("x.bin",x,xb);unchanged("weight.bin",w,wb);
            unchanged("scale.bin",s,sb);unchanged("group_list.bin",g,gb);
            std::vector<uint16_t> output(m*n);check(aclrtMemcpy(output.data(),yb,y,yb,ACL_MEMCPY_DEVICE_TO_HOST));
            std::ofstream file(stressDir.empty()?dir+"/output/y.bin":stressDir+"/"+name+"-r"+std::to_string(rep)+".bin",std::ios::binary);file.write(reinterpret_cast<const char*>(output.data()),yb);if(!file)throw std::runtime_error("output write failed");
            }
            std::cout<<name<<" complete\n"<<std::flush;
        }
        return 0;
    } catch(const std::exception& error){std::cerr<<error.what()<<"\n";return 2;}
}
