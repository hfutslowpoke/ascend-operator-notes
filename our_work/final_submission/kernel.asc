extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo &ix, GM_ADDR w, const TensorGroupInfo &iw,
													 GM_ADDR s, const TensorGroupInfo &is, GM_ADDR g, const TensorGroupInfo &ig,
													 GM_ADDR y, const TensorGroupInfo &iy, int64_t availableCoreNum,
													 aclrtStream stream) {
	const int64_t m = ix.tensors[0].shape[0], k = ix.tensors[0].shape[1], e = iw.tensors[0].shape[0],
								n = iw.tensors[0].shape[2];
	const int64_t coreBudget = availableCoreNum > 0 ? (availableCoreNum < 20 ? availableCoreNum : 20) : 1;
	const int tileIndex = gmm_host::Choose(m, k, n, e, coreBudget);
	const auto selectedTile = gmm_host::tiles[tileIndex];
	int64_t splitCores = availableCoreNum > 0 ? availableCoreNum : 1;
	{
		if (admitted(m, k, n, e, availableCoreNum)) {
			int kt = 8;
			while (kt < k)
				kt *= 2;
			short_gemv_i32_ub_tile<<<m *((n + 63) / 64), nullptr, stream>>>(x, w, s, g, y, m, k, n, e, kt);
			return;
		}
	}
	{
		if (m * n * k > 1024) {
			int64_t c = availableCoreNum > 0 ? (availableCoreNum < 20 ? availableCoreNum : 20) : 1,
							a = m < e ? m : e, q = (n + 127) / 128, l = ((m + 255) / 256 + e - 1) * q,
							t = (a + (m - a) / 256) * q;
			if (k >= 4096 && n % 32 && t < c && l >= 2 * c) {
				splitCores = (c < 4 * t ? c : 4 * t);
				goto split_k;
				return;
			}
			if (m <= 16) {
				auto z = gmm_host::tiles[gmm_host::Choose(m, k, n, e, c)];
				int64_t h = 0;
				for (auto v = e; v; v >>= 1)
					++h;
				int64_t p = (n + z.n - 1) / z.n, gp = (a + (m - a) / z.m) * p;
				if ((m < e && e > m * (h + 2) && m <= z.m && (m == 1 || k <= 8 * z.k) && !(k >= 4096 && l < 2 * c)) ||
						(e <= m && k <= 8 * z.k && z.n <= 128 && gp > a * ((n + 255) / 256) && gp <= c &&
						 ((n + 255) / 256) * 256 > p * z.n)) {
					goto generic;
					return;
				}
			}
		}
		if (Rg494SelectAlgorithm(m, k, n, e) != Rg494Algorithm::ApiFallback) {
			int64_t cores = coreBudget;
			void *workspace = nullptr;
			if (aclrtMalloc(&workspace, cores * 128 * 256 * sizeof(int32_t), ACL_MEM_MALLOC_HUGE_FIRST) !=
					ACL_SUCCESS)
				return;
			switch (k / Rg494ResidentResources::A_K_SLICE) {
			case 3:
				gmm_rg494_streamedB<1536><<<cores, nullptr, stream>>>(x, w, s, g, y, (GM_ADDR)workspace, m, n, e);
				break;
			case 4:
				gmm_rg494_streamedB<2048><<<cores, nullptr, stream>>>(x, w, s, g, y, (GM_ADDR)workspace, m, n, e);
				break;
			}
			aclrtSynchronizeStream(stream);
			aclrtFree(workspace);
			return;
		}
	}
	{
		int64_t cores = coreBudget;
		if (k == 1024 && n >= 512 && n <= 1024 && n % 256 == 0 && e > 0 && e <= 128) {
			const auto tile = selectedTile;
			const int64_t estimated = m / e, slab = estimated < tile.m ? estimated : tile.m;
			const bool resident = tile.m == 128 && tile.n == 256 && m % e == 0 && slab == 128;
			if (resident && n / 256 != 3) {
				const int64_t upper = ((m + 127) / 128 + e - 1) * ((n + 255) / 256);
				if (cores > upper)
					cores = upper;
				switch (n / 256) {
				case 2:
					RgC1B8K128<2><<<cores, nullptr, stream>>>(x, w, s, g, y, m, e);
					break;
				case 4:
					RgC1B8K128<4><<<cores, nullptr, stream>>>(x, w, s, g, y, m, e);
					break;
				}
				const auto status = aclrtSynchronizeStream(stream);
				if (status != ACL_SUCCESS)
					throw std::runtime_error("C1 B granularity synchronization");
				return;
			}
		}
	}
	{
		int64_t cores = coreBudget;
		const auto tile = selectedTile;
		const bool originalClassicTile = tile.m == 128 && tile.n == 256;
		if (originalClassicTile && k == 1024 && n >= 512 && n <= 1024 && n % 256 == 0 && e > 0 && e <= 128 &&
				m == e * 64) {
			const int64_t panels = n / 256, maxRowTiles = (m + 63) / 64 + e - 1;
			const int64_t maxPanels = (maxRowTiles * panels + cores - 1) / cores;
			const int64_t rawCap = (maxPanels + panels - 1) / panels + 1;
			const int64_t descCap = maxRowTiles < rawCap ? maxRowTiles : rawCap;
			const int32_t metaElements = ((descCap + 1 + 7) / 8) * 8;
			void *allocation = nullptr;
			if (aclrtMalloc(&allocation, cores * 2 * 64 * 256 * sizeof(int32_t) + cores * metaElements * 8,
											ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS)
				throw std::runtime_error("R2 staged tasks workspace allocation");
			GM_ADDR c = (GM_ADDR)allocation;
			switch (n / 256) {
			case 2:
				RgR2StagedTasks<2><<<cores, nullptr, stream>>>(x, w, s, g, y, c, m, e, metaElements);
				break;
			case 3:
				RgR2StagedTasks<3><<<cores, nullptr, stream>>>(x, w, s, g, y, c, m, e, metaElements);
				break;
			case 4:
				RgR2StagedTasks<4><<<cores, nullptr, stream>>>(x, w, s, g, y, c, m, e, metaElements);
				break;
			}
			aclrtSynchronizeStream(stream);
			aclrtFree(allocation);
			return;
		}
	}
	{
		int64_t cores = coreBudget;
		const auto tile = selectedTile;
		const bool originalNarrowFamily = tile.m == 64 && tile.n == 384;
		if (originalNarrowFamily && k == 512 && n >= 512 && n <= 1024 && n % 256 == 0 && e > 0 && e <= 128 &&
				m > 0 && m <= 65536) {
			const int64_t panels = n / 256, group = panels <= 3 ? panels : 2, ng = (panels + group - 1) / group;
			const int64_t tasks = ((m + 63) / 64) * ng;
			const int64_t maxDescAll = ng * ((m + 63) / 64 + e - 1),
										maxDescCore = (tasks + cores - 1) / cores + ng * (e - 1);
			const int64_t descCap = maxDescAll < maxDescCore ? maxDescAll : maxDescCore;
			const int32_t metaElements = ((descCap + 1 + 7) / 8) * 8;
			void *allocation = nullptr;
			if (aclrtMalloc(&allocation, cores * 2 * 64 * 256 * sizeof(int32_t) + cores * metaElements * 8,
											ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS)
				throw std::runtime_error("R3 staged GL workspace allocation");
			switch (n / 256) {
			case 2:
				RgR3StagedExactSlabs<2>
						<<<cores, nullptr, stream>>>(x, w, s, g, y, (GM_ADDR)allocation, m, e, metaElements);
				break;
			case 3:
				RgR3StagedExactSlabs<3>
						<<<cores, nullptr, stream>>>(x, w, s, g, y, (GM_ADDR)allocation, m, e, metaElements);
				break;
			case 4:
				RgR3StagedExactSlabs<4>
						<<<cores, nullptr, stream>>>(x, w, s, g, y, (GM_ADDR)allocation, m, e, metaElements);
				break;
			}
			aclrtSynchronizeStream(stream);
			aclrtFree(allocation);
			return;
		}
	}
	{
		int64_t cores = coreBudget;
		if (k == 256 && e >= 1 && e <= 128 && (e & (e - 1)) == 0 && m == e * 64 && n >= 256 && n <= 1024 &&
				n % 256 == 0 && selectedTile.m == 128 && selectedTile.n == 256) {
			void *ws = nullptr;
			if (aclrtMalloc(&ws, cores * 2 * 128 * n * 4, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS)
				return;
			switch (e * 4 + n / 256 - 1) {
			case 4:
				RgC3PrefetchALL_p1_e1_k256<<<cores, nullptr, stream>>>(x, w, s, g, y, (GM_ADDR)ws, m);
				break;
			case 5:
				RgC3PrefetchALL_p2_e1_k256<<<cores, nullptr, stream>>>(x, w, s, g, y, (GM_ADDR)ws, m);
				break;
			case 6:
				RgC3PrefetchALL_p3_e1_k256<<<cores, nullptr, stream>>>(x, w, s, g, y, (GM_ADDR)ws, m);
				break;
			case 7:
				RgC3PrefetchALL_p4_e1_k256<<<cores, nullptr, stream>>>(x, w, s, g, y, (GM_ADDR)ws, m);
				break;
			case 8:
				RgC3PrefetchALL_p1_e2_k256<<<cores, nullptr, stream>>>(x, w, s, g, y, (GM_ADDR)ws, m);
				break;
			case 9:
				RgC3PrefetchALL_p2_e2_k256<<<cores, nullptr, stream>>>(x, w, s, g, y, (GM_ADDR)ws, m);
				break;
			case 10:
				RgC3PrefetchALL_p3_e2_k256<<<cores, nullptr, stream>>>(x, w, s, g, y, (GM_ADDR)ws, m);
				break;
			case 11:
				RgC3PrefetchALL_p4_e2_k256<<<cores, nullptr, stream>>>(x, w, s, g, y, (GM_ADDR)ws, m);
				break;
			case 16:
				RgC3PrefetchALL_p1_e4_k256<<<cores, nullptr, stream>>>(x, w, s, g, y, (GM_ADDR)ws, m);
				break;
			case 17:
				RgC3PrefetchALL_p2_e4_k256<<<cores, nullptr, stream>>>(x, w, s, g, y, (GM_ADDR)ws, m);
				break;
			case 18:
				RgC3PrefetchALL_p3_e4_k256<<<cores, nullptr, stream>>>(x, w, s, g, y, (GM_ADDR)ws, m);
				break;
			case 19:
				RgC3PrefetchALL_p4_e4_k256<<<cores, nullptr, stream>>>(x, w, s, g, y, (GM_ADDR)ws, m);
				break;
			case 32:
				RgC3PrefetchALL_p1_e8_k256<<<cores, nullptr, stream>>>(x, w, s, g, y, (GM_ADDR)ws, m);
				break;
			case 33:
				RgC3PrefetchALL_p2_e8_k256<<<cores, nullptr, stream>>>(x, w, s, g, y, (GM_ADDR)ws, m);
				break;
			case 34:
				RgC3PrefetchALL_p3_e8_k256<<<cores, nullptr, stream>>>(x, w, s, g, y, (GM_ADDR)ws, m);
				break;
			case 35:
				RgC3PrefetchALL_p4_e8_k256<<<cores, nullptr, stream>>>(x, w, s, g, y, (GM_ADDR)ws, m);
				break;
			case 64:
				RgC3PrefetchALL_p1_e16_k256<<<cores, nullptr, stream>>>(x, w, s, g, y, (GM_ADDR)ws, m);
				break;
			case 65:
				RgC3PrefetchALL_p2_e16_k256<<<cores, nullptr, stream>>>(x, w, s, g, y, (GM_ADDR)ws, m);
				break;
			case 66:
				RgC3PrefetchALL_p3_e16_k256<<<cores, nullptr, stream>>>(x, w, s, g, y, (GM_ADDR)ws, m);
				break;
			case 67:
				RgC3PrefetchALL_p4_e16_k256<<<cores, nullptr, stream>>>(x, w, s, g, y, (GM_ADDR)ws, m);
				break;
			case 128:
				RgC3PrefetchALL_p1_e32_k256<<<cores, nullptr, stream>>>(x, w, s, g, y, (GM_ADDR)ws, m);
				break;
			case 129:
				RgC3PrefetchALL_p2_e32_k256<<<cores, nullptr, stream>>>(x, w, s, g, y, (GM_ADDR)ws, m);
				break;
			case 130:
				RgC3PrefetchALL_p3_e32_k256<<<cores, nullptr, stream>>>(x, w, s, g, y, (GM_ADDR)ws, m);
				break;
			case 131:
				RgC3PrefetchALL_p4_e32_k256<<<cores, nullptr, stream>>>(x, w, s, g, y, (GM_ADDR)ws, m);
				break;
			case 256:
				RgC3PrefetchALL_p1_e64_k256<<<cores, nullptr, stream>>>(x, w, s, g, y, (GM_ADDR)ws, m);
				break;
			case 257:
				RgC3PrefetchALL_p2_e64_k256<<<cores, nullptr, stream>>>(x, w, s, g, y, (GM_ADDR)ws, m);
				break;
			case 258:
				RgC3PrefetchALL_p3_e64_k256<<<cores, nullptr, stream>>>(x, w, s, g, y, (GM_ADDR)ws, m);
				break;
			case 259:
				RgC3PrefetchALL_p4_e64_k256<<<cores, nullptr, stream>>>(x, w, s, g, y, (GM_ADDR)ws, m);
				break;
			case 512:
				RgC3PrefetchALL_p1_e128_k256<<<cores, nullptr, stream>>>(x, w, s, g, y, (GM_ADDR)ws, m);
				break;
			case 513:
				RgC3PrefetchALL_p2_e128_k256<<<cores, nullptr, stream>>>(x, w, s, g, y, (GM_ADDR)ws, m);
				break;
			case 514:
				RgC3PrefetchALL_p3_e128_k256<<<cores, nullptr, stream>>>(x, w, s, g, y, (GM_ADDR)ws, m);
				break;
			case 515:
				RgC3PrefetchALL_p4_e128_k256<<<cores, nullptr, stream>>>(x, w, s, g, y, (GM_ADDR)ws, m);
				break;
			}
			aclrtSynchronizeStream(stream);
			aclrtFree(ws);
			return;
		}

		if (k == 1024 && n == 3 * 256 && e > 0 && e <= 128 && selectedTile.m == 128 && selectedTile.n == 256 &&
				m % e == 0 && m / e >= 128) {
			const int64_t upper = ((m + 127) / 128 + e - 1) * 3;
			if (cores > upper)
				cores = upper;
			RgC1FP32Prefetch<3><<<cores, nullptr, stream>>>(x, w, s, g, y, m, e);
			aclrtSynchronizeStream(stream);
			return;
		}
	}
	{
		if (e == 1 && m >= 32 && m <= 64 && m % 32 == 0 && k >= 32 && k <= 128 && k % 32 == 0 && n >= 32 &&
				n <= 128 && n % 32 == 0 && availableCoreNum >= (m / 32) * ((n > 128 && n % 128 == 0) ? n / 128 : 1)) {
			const int64_t smallCores = (m / 32) * ((n > 128 && n % 128 == 0) ? n / 128 : 1);
			void *strictR1Workspace = nullptr;
			if (aclrtMalloc(&strictR1Workspace, static_cast<size_t>(m * n * 4), ACL_MEM_MALLOC_HUGE_FIRST) !=
					ACL_SUCCESS)
				return;
			switch (k) {
			case 32:
				LaunchSmallRows32<32>(x, w, s, g, y, (GM_ADDR)strictR1Workspace, m, k, n, e, smallCores, stream);
				break;
			case 64:
				LaunchSmallRows32<64>(x, w, s, g, y, (GM_ADDR)strictR1Workspace, m, k, n, e, smallCores, stream);
				break;
			case 96:
				LaunchSmallRows32<96>(x, w, s, g, y, (GM_ADDR)strictR1Workspace, m, k, n, e, smallCores, stream);
				break;
			case 128:
				LaunchSmallRows32<128>(x, w, s, g, y, (GM_ADDR)strictR1Workspace, m, k, n, e, smallCores, stream);
				break;
			}
			aclrtSynchronizeStream(stream);
			aclrtFree(strictR1Workspace);
			return;
		}
		int64_t cores = coreBudget;
		constexpr int i4ResidentMode = 1;
		constexpr int scaleCacheMode = 1;
		const bool usePadAB = i4ResidentMode != 0;
		const bool rankOne = k >= 512 && k < 1024 && k % 128 == 1 && m * n * k > 1024 && e <= 128;
		if (usePadAB && !rankOne && k >= 512 && k <= 1024 && k % 32 != 0 && n % 32 != 0 && n > 256 && e <= 128 &&
				m * n * k > 1024) {
			const auto tile = selectedTile;
			const int64_t q = m / e, r = m % e;
			const int64_t rowTiles = (e - r) * gmm_host::DivUp(q, tile.m) + r * gmm_host::DivUp(q + 1, tile.m);
			const int64_t bPitch = ((n + 31) / 32) * 32, alignedK = ((k + 31) / 32) * 32;
			if (tile.m == 128 && tile.n == 256 && alignedK % 128 == 0 && rowTiles * n > 3 * e * bPitch) {
				const int64_t upper = (gmm_host::DivUp(m, 128) + e - 1) * gmm_host::DivUp(n, 256);
				if (cores > upper)
					cores = upper;
				const size_t bytes = cores * 4 * 128 * 256 * 4 + e * alignedK * bPitch + m * alignedK;
				void *workspace = nullptr;
				if (aclrtMalloc(&workspace, bytes, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS)
					return;
				bk128<<<cores, nullptr, stream>>>(x, w, s, g, y, (GM_ADDR)workspace, m, k, n, e, bPitch);
				aclrtSynchronizeStream(stream);
				aclrtFree(workspace);
				return;
			}
		}
	}
	{
		int64_t cores = coreBudget;
		const int64_t oldParts = k / 2048 > 3 ? 3 : k / 2048;
		const int64_t maxTiles = ((m + 255) / 256 + e - 1) * ((n + 127) / 128);
		const bool eligible = m <= 65536 && e <= 128 && oldParts >= 2 && maxTiles < 2 * cores && k <= 32768 &&
													k % 32 != 0 && cores % 4 == 0;
		const int mode = 2;
		if (mode && eligible) {
			const int64_t ak = (k + 31) / 32 * 32;
			void *ws = nullptr;
			if (aclrtMalloc(&ws, maxTiles * 4 * 256 * 128 * 4 + m * ak, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS)
				return;
			bk500<<<cores, nullptr, stream>>>(x, w, s, g, y, (GM_ADDR)ws, m, k, n, e);
			aclrtSynchronizeStream(stream);
			aclrtFree(ws);
			return;
		}
	}
	{
		const int mode = 1;
		if (mode && m <= 65536 && e <= 128 && k >= 1024 && k <= 1152 && k % 128 >= 4 && k % 128 <= 8 &&
				n <= 2048) {
			int64_t cores = coreBudget;
			const int64_t upper = ((m + 159) / 160 + e - 1) * ((n + 191) / 192);
			if (cores > upper)
				cores = upper;
			const int64_t bytes = (((n + 191) / 192) * 192 + cores * 2 * 160 * 192) * 4;
			void *ws = nullptr;
			if (aclrtMalloc(&ws, bytes, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS)
				return;
			bk494<<<cores, nullptr, stream>>>(x, w, s, g, y, (GM_ADDR)ws, m, k, n, e);
			aclrtSynchronizeStream(stream);
			aclrtFree(ws);
			return;
		}
	}
	{
		constexpr int64_t rangeScheduleMode = 1;
		constexpr int residentBMode = rangeScheduleMode ? 1 : 0;
		if (residentBMode && k >= 512 && k < 1024 && k % 128 == 1 && m * n * k > 1024 && e <= 128) {
			int64_t cores = coreBudget;
			const int64_t upper = (gmm_host::DivUp(m, 128) + e - 1) * gmm_host::DivUp(n, 256);
			if (cores > upper)
				cores = upper;
			void *workspace = nullptr;
			if (aclrtMalloc(&workspace, cores * 2 * 128 * 256 * 4, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS)
				return;
			bk129<<<cores, nullptr, stream>>>(x, w, s, g, y, (GM_ADDR)workspace, m, k, n, e, rangeScheduleMode);
			aclrtSynchronizeStream(stream);
			aclrtFree(workspace);
			return;
		}
	}
	{
		int64_t cores = coreBudget;
		const bool eligible =
				m <= 65536 && e <= 128 && k >= 1024 && k % 128 == 1 && (k / 128) * 128 <= 8 * 128 && n <= 2048;
		const int mode = 1;
		if (mode && eligible) {
			const int64_t alignedN = ((n + 31) / 32) * 32;
			const int64_t upperTasks = ((m + 255) / 256 + e - 1) * ((n + 127) / 128);
			if (upperTasks < cores)
				cores = upperTasks;
			const int64_t residentBytes = cores * 2 * 256 * alignedN * 4;
			const int64_t ordinaryBytes = cores * 2 * 32768 * 4;
			void *ws = nullptr;
			if (aclrtMalloc(&ws, residentBytes > ordinaryBytes ? residentBytes : ordinaryBytes,
											ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS)
				return;
			bk490<<<cores, nullptr, stream>>>(x, w, s, g, y, (GM_ADDR)ws, m, k, n, e);
			aclrtSynchronizeStream(stream);
			aclrtFree(ws);
			return;
		}
	}
	{
		int64_t cores = coreBudget;
		const bool shortTail = k >= 1024 && k % 128 >= 2 && k % 128 <= 3;
		if (m <= 65536 && e <= 128 && shortTail) {
			const int64_t packedMatrix = ((k + 31) / 32 * 32) * ((n + 31) / 32 * 32);
			const int64_t packLimit =
					(k > 0 && k <= 1056 && n > 0 && n <= 1056 && e > 0 && e <= 128) ? 2097152 / packedMatrix : 0;
			const int64_t packCount = e < packLimit ? e : packLimit;
			void *ws = nullptr;
			if (aclrtMalloc(&ws, cores * 2 * 32768 * 4 + packCount * packedMatrix, ACL_MEM_MALLOC_HUGE_FIRST) !=
					ACL_SUCCESS)
				return;
			if (k % 128 == 1)
				bk499<<<cores, nullptr, stream>>>(x, w, s, g, y, (GM_ADDR)ws, m, k, n, e);
			else
				bk498<<<cores, nullptr, stream>>>(x, w, s, g, y, (GM_ADDR)ws, m, k, n, e);
			aclrtSynchronizeStream(stream);
			aclrtFree(ws);
			return;
		}
	}
	{
		int64_t cores = coreBudget;
		const int64_t parts = k / 2048 > 3 ? 3 : k / 2048;
		const int64_t maxTiles = ((m + 255) / 256 + e - 1) * ((n + 127) / 128);
		const bool splitLongK = parts >= 2 && maxTiles < 2 * cores;
		const bool shortKBlock = k >= 1024 && k % 128 > 0 && k % 128 <= 32;
		const bool fitsMetadata = m <= 65536 && e <= 128;
		if (fitsMetadata && (splitLongK))
			goto split_k;
		else
			goto generic;
	}
split_k: {
	int64_t cores = splitCores;
	const int64_t limitParts = k / 1024, parts = limitParts > 4 ? 4 : limitParts;
	if (m >= 32 && k >= 4096 && k <= 8192 && k % 32 == 0 && n >= 32 && n <= 128 && n % 32 == 0) {
		const int64_t a = m < e ? m : e, u = (a + (m - a) / 256) * ((n + 127) / 128) * parts;
		if (cores > u)
			cores = u;
	}
	const int64_t maxTiles = ((m + 255) / 256 + e - 1) * ((n + 127) / 128);
	void *ws = nullptr;
	if (aclrtMalloc(&ws, maxTiles * parts * 256 * 128 * 4, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS)
		return;
	bk493<4><<<cores, nullptr, stream>>>(x, w, s, g, y, (GM_ADDR)ws, m, k, n, e, parts);
	aclrtSynchronizeStream(stream);
	aclrtFree(ws);
	return;
}
generic: {
	if (m * n * k <= 1024) {
		if (m * n > 1 && e * k * n <= 32768 && e * n <= 2048) {
			switch (k) {
			case 1:
				LaunchTinyShortDot<1>(x, w, s, g, y, m, k, n, e, stream);
				break;
			case 2:
				LaunchTinyShortDot<2>(x, w, s, g, y, m, k, n, e, stream);
				break;
			case 3:
				LaunchTinyShortDot<3>(x, w, s, g, y, m, k, n, e, stream);
				break;
			case 4:
				LaunchTinyShortDot<4>(x, w, s, g, y, m, k, n, e, stream);
				break;
			case 5:
				LaunchTinyShortDot<5>(x, w, s, g, y, m, k, n, e, stream);
				break;
			case 6:
				LaunchTinyShortDot<6>(x, w, s, g, y, m, k, n, e, stream);
				break;
			case 7:
				LaunchTinyShortDot<7>(x, w, s, g, y, m, k, n, e, stream);
				break;
			case 8:
				LaunchTinyShortDot<8>(x, w, s, g, y, m, k, n, e, stream);
				break;
			default:
				gmm_tiny_vector<0><<<4, nullptr, stream>>>(x, w, s, g, y, m, k, n, e);
				break;
			}
		} else {
			if (m * n == 1) {
				constexpr int64_t requestedSingletonWidth = 1;
				const int64_t vectorBudget = availableCoreNum > 0 ? availableCoreNum * 2 : 1;
				const int64_t singletonWidth =
						requestedSingletonWidth < vectorBudget ? requestedSingletonWidth : vectorBudget;
				switch (k) {
				case 1:
					bk484<1><<<singletonWidth, nullptr, stream>>>(x, w, s, g, y, k, e);
					break;
				case 2:
					bk484<2><<<singletonWidth, nullptr, stream>>>(x, w, s, g, y, k, e);
					break;
				case 3:
					bk484<3><<<singletonWidth, nullptr, stream>>>(x, w, s, g, y, k, e);
					break;
				case 4:
					bk484<4><<<singletonWidth, nullptr, stream>>>(x, w, s, g, y, k, e);
					break;
				case 5:
					bk484<5><<<singletonWidth, nullptr, stream>>>(x, w, s, g, y, k, e);
					break;
				case 6:
					bk484<6><<<singletonWidth, nullptr, stream>>>(x, w, s, g, y, k, e);
					break;
				case 7:
					bk484<7><<<singletonWidth, nullptr, stream>>>(x, w, s, g, y, k, e);
					break;
				case 8:
					bk484<8><<<singletonWidth, nullptr, stream>>>(x, w, s, g, y, k, e);
					break;
				default:
					bk484<0><<<singletonWidth, nullptr, stream>>>(x, w, s, g, y, k, e);
					break;
				}
			} else {
				gmm_tiny_scalar<<<1, nullptr, stream>>>(x, w, s, g, y, m, k, n, e);
			}
		}
		aclrtSynchronizeStream(stream);
		return;
	}
	if (e == 1 && m <= 64 && k <= 128 && n <= 128 && m % 16 == 0 && k % 32 == 0 && n % 32 == 0) {
		void *workspace = nullptr;
		if (aclrtMalloc(&workspace, m * n * sizeof(int32_t), ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS)
			return;
		const int64_t rowBlocks = m / 16;
		const int64_t smallCores = availableCoreNum >= rowBlocks ? rowBlocks : 1;
		constexpr bool useCompactSmall = true;
		if (useCompactSmall && smallCores == rowBlocks) {
			switch (k) {
			case 32:
				LaunchSmallAligned<32>(x, w, s, g, y, (GM_ADDR)workspace, m, k, n, e, smallCores, stream);
				break;
			case 64:
				LaunchSmallAligned<64>(x, w, s, g, y, (GM_ADDR)workspace, m, k, n, e, smallCores, stream);
				break;
			case 96:
				LaunchSmallAligned<96>(x, w, s, g, y, (GM_ADDR)workspace, m, k, n, e, smallCores, stream);
				break;
			case 128:
				LaunchSmallAligned<128>(x, w, s, g, y, (GM_ADDR)workspace, m, k, n, e, smallCores, stream);
				break;
			}
		} else {
			gmm_small::bk485<<<smallCores, nullptr, stream>>>(x, w, s, g, y, (GM_ADDR)workspace, m, k, n, e);
		}
		aclrtSynchronizeStream(stream);
		aclrtFree(workspace);
		return;
	}

	if (k > 2048 && k <= 4096 && k % 512 == 0 && n % 256 == 0) {
		void *workspace = nullptr;
		if (aclrtMalloc(&workspace, coreBudget * 128 * 256 * sizeof(int32_t), ACL_MEM_MALLOC_HUGE_FIRST) !=
				ACL_SUCCESS)
			return;
		new5_large_k_streamed_b<<<coreBudget, nullptr, stream>>>(x, w, s, g, y, (GM_ADDR)workspace, m, k, n, e);
		aclrtSynchronizeStream(stream);
		aclrtFree(workspace);
		return;
	}

	if (k <= 32 && n <= 32 && m * n * k > 1024) {
		const int64_t vectorBudget = coreBudget * 2;
		const int64_t maxNonempty = m < e ? m : e;
		const int64_t maximumTasks = maxNonempty + (m - maxNonempty) / 96;
		const int64_t vectorCores = maximumTasks < vectorBudget ? maximumTasks : vectorBudget;
		new5_narrow_short_k_gmm<<<vectorCores, nullptr, stream>>>(x, w, s, g, y, m, k, n, e);
		aclrtSynchronizeStream(stream);
		return;
	}
	if (k <= 32 && n >= 32 && m * n >= 4096) {
		const int64_t rowsPerSlab = k <= 16 ? 32 : 16;
		const int64_t vectorBudget = coreBudget * 2;
		const int64_t maxNonempty = m < e ? m : e;
		const int64_t maximumSlabs = maxNonempty + (m - maxNonempty) / rowsPerSlab;
		const int64_t maximumTasks = maximumSlabs * ((n + 255) / 256);
		const int64_t vectorCores = maximumTasks < vectorBudget ? maximumTasks : vectorBudget;
		if (k <= 16) {
			new5_short_k_panel_gmm_v2<<<vectorCores, nullptr, stream>>>(x, w, s, g, y, m, k, n, e);
		} else {
			new5_short_k_panel_gmm_k32<<<vectorCores, nullptr, stream>>>(x, w, s, g, y, m, k, n, e);
		}
		aclrtSynchronizeStream(stream);
		return;
	}

	if (n == 1 && k >= 256 && k <= 8192 && m >= 256 && m * k >= 1048576) {
		const int64_t maxNonempty = m < e ? m : e;
		const int64_t maximumTasks = maxNonempty + (m - maxNonempty) / 16;
		const int64_t vectorBudget = coreBudget * 2;
		const int64_t vectorCores = maximumTasks < vectorBudget ? maximumTasks : vectorBudget;
		new5_single_column_long_k_gmm<<<vectorCores, nullptr, stream>>>(x, w, s, g, y, m, k, e);
		aclrtSynchronizeStream(stream);
		return;
	}

	if (TryLaunchTerminalGenericNarrow(x, w, s, g, y, m, k, n, e, selectedTile.m, selectedTile.n,
																		 selectedTile.k, coreBudget, stream))
		return;
	int64_t cores = coreBudget;
	const int tile = tileIndex;
	const gmm_host::Tile t = gmm_host::tiles[tile];
	const int64_t estimatedRows = m / e;
	const int64_t slabRows = estimatedRows < t.m ? estimatedRows : t.m;
	int64_t searchLevels = 0;
	for (int64_t span = e; span > 0; span >>= 1)
		++searchLevels;
	const bool directRows = m < e && m <= t.m && e > m * (searchLevels + 2) && (m == 1 || k <= 8 * t.k);
	const int64_t fixedSlabs = directRows ? 1 : (m % e == 0 && slabRows == t.m ? slabRows : 0);
	const int64_t maxNonempty = m < e ? m : e;
	const int64_t upperTasks = (maxNonempty + (m - maxNonempty) / t.m) * gmm_host::DivUp(n, t.n);
	if (upperTasks < cores)
		cores = upperTasks;
	const int64_t smallGroup = m / e, largerGroups = m % e;
	const int64_t rowTiles = (e - largerGroups) * gmm_host::DivUp(smallGroup, t.m) +
													 largerGroups * gmm_host::DivUp(smallGroup + 1, t.m);
	const int64_t alignedN = gmm_host::DivUp(n, 32) * 32;
	const bool padA = k % 32 != 0;
	const int64_t alignedK = gmm_host::DivUp(k, 32) * 32;
	const bool padB = padA || (n != alignedN && rowTiles * n > 3 * e * alignedN);
	const int64_t bPitch = padB ? alignedN : n;
	const size_t bytes = static_cast<size_t>(cores) * 4 * t.m * t.n * sizeof(int32_t) +
											 (padB ? static_cast<size_t>(e) * alignedK * bPitch : 0) +
											 (padA ? static_cast<size_t>(m) * alignedK : 0);
	void *workspace = nullptr;
	if (aclrtMalloc(&workspace, bytes, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS)
		return;
	switch (tile) {
	case 0:
		bk121<<<cores, nullptr, stream>>>(x, w, s, g, y, (GM_ADDR)workspace, m, k, n, e, fixedSlabs, bPitch);
		break;
	case 1:
		bk122<<<cores, nullptr, stream>>>(x, w, s, g, y, (GM_ADDR)workspace, m, k, n, e, fixedSlabs, bPitch);
		break;
	case 2:
		bk123<<<cores, nullptr, stream>>>(x, w, s, g, y, (GM_ADDR)workspace, m, k, n, e, fixedSlabs, bPitch);
		break;
	case 3:
		bk124<<<cores, nullptr, stream>>>(x, w, s, g, y, (GM_ADDR)workspace, m, k, n, e, fixedSlabs, bPitch);
		break;
	case 4:
		bk125<<<cores, nullptr, stream>>>(x, w, s, g, y, (GM_ADDR)workspace, m, k, n, e, fixedSlabs, bPitch);
		break;
	case 5:
		bk126<<<cores, nullptr, stream>>>(x, w, s, g, y, (GM_ADDR)workspace, m, k, n, e, fixedSlabs, bPitch);
		break;
	case 6:
		bk118<<<cores, nullptr, stream>>>(x, w, s, g, y, (GM_ADDR)workspace, m, k, n, e, fixedSlabs, bPitch);
		break;
	case 7:
		bk119<<<cores, nullptr, stream>>>(x, w, s, g, y, (GM_ADDR)workspace, m, k, n, e, fixedSlabs, bPitch);
		break;
	case 8:
		bk120<<<cores, nullptr, stream>>>(x, w, s, g, y, (GM_ADDR)workspace, m, k, n, e, fixedSlabs, bPitch);
		break;
	}
	aclrtSynchronizeStream(stream);
	aclrtFree(workspace);
}
