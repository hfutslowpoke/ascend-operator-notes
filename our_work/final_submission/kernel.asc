inline void LaunchSmallRows32(GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR g, GM_ADDR y, GM_ADDR ws, int64_t m,
															int64_t k, int64_t n, int64_t e, int64_t cores, aclrtStream stream) {
