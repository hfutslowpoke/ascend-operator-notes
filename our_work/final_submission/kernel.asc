namespace rg_r3_fp32_config {
template <int TM, int TN> struct Config {
	static_assert(TM * 512 + TN * (TN > 256 ? 64 : 128) * 8 <= 512 * 1024, "Full A and streaming B fit L1");
	static_assert(TM % 16 == 0 && TN % 32 == 0, "Cube tile alignment");
	static_assert(TM * TN * 4 <= 128 * 1024, "L0C capacity");
	static_assert((TM + TN) * (TN > 256 ? 64 : 128) * 8 <= 512 * 1024, "L1 capacity");
	static_assert(26 * (TN == 512 ? 8 : 16) * TN + 4 * TN <= 192 * 1024, "UB capacity");
	using AType = AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, int8_t, false>;
	using BType = AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, int8_t, false>;
	using CType = AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, int32_t>;
	using BiasType = AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, int32_t>;
	static constexpr int32_t TILE_M = TM;
	static constexpr int32_t TILE_N = TN;
	static constexpr int32_t VEC_CHUNK_M = TN == 512 ? 8 : 16;
	static constexpr uint16_t GMM_SYNC_AIV_AIC = 3;
	static constexpr uint16_t GMM_SYNC_AIC_AIV = 5;
	static constexpr uint64_t SYNC_MODE2 = 2;
	static __aicore__ constexpr MatmulConfig MakeMatmulConfig() {
		MatmulConfig cfg{};
		cfg.doNorm = false;
		cfg.doBasicBlock = false;
		cfg.doMultiDataLoad = true;
		cfg.basicM = TILE_M;
		cfg.basicN = TILE_N;
		cfg.basicK = TN > 256 ? 64 : 128;
		cfg.intrinsicsCheck = false;
		cfg.isNBatch = false;
		cfg.enVecND2NZ = false;
		cfg.doSpecialBasicBlock = false;
		cfg.doMTE2Preload = 0;
		cfg.singleCoreM = TILE_M;
		cfg.singleCoreN = 1024;
		cfg.singleCoreK = 512;
		cfg.stepM = 0;
		cfg.stepN = 0;
		cfg.baseMN = 0;
		cfg.singleCoreMN = 0;
		cfg.enUnitFlag = true;
		cfg.isPerTensor = false;
		cfg.hasAntiQuantOffset = false;
		cfg.doIBShareNorm = false;
		cfg.doSpecialMDL = false;
		cfg.enableInit = false;
		cfg.batchMode = BatchMode::NONE;
		cfg.enableEnd = true;
		cfg.enableGetTensorC = true;
		cfg.enableSetOrgShape = true;
		cfg.enableSetBias = false;
		cfg.enableSetTail = true;
		cfg.enableQuantVector = false;
		cfg.enableSetDefineData = false;
		cfg.iterateMode = IterateMode::ITERATE_MODE_DEFAULT;
		cfg.enableReuse = true;
		cfg.enableUBReuse = true;
		cfg.enableL1CacheUB = false;
		cfg.intraBlockPartSum = false;
		cfg.iterateOrder = IterateOrder::UNDEF;
		cfg.scheduleType = ScheduleType::INNER_PRODUCT;
		cfg.enableDoubleCache = false;
		cfg.isBiasBatch = true;
		cfg.enableStaticPadZeros = false;
		cfg.isA2B2Shared = false;
		cfg.enableKdimReorderLoad = false;
		cfg.isCO1Shared = false;
		return cfg;
	}
	static __aicore__ constexpr MatmulApiStaticTiling MakeStaticTiling() {
		MatmulApiStaticTiling tiling =
				AscendC::GetMatmulApiTiling<AType, BType, CType, BiasType>(MakeMatmulConfig());
		tiling.depthA1 = 512 / (TN > 256 ? 64 : 128);
		tiling.depthB1 = 8;
		tiling.stepM = 1;
		tiling.stepN = 1;
		tiling.stepKa = 512 / (TN > 256 ? 64 : 128);
		tiling.stepKb = 4;
		tiling.dbL0A = 2;
		tiling.dbL0B = 2;
		tiling.dbL0C = 1;
		return tiling;
	}
	constexpr static MatmulApiStaticTiling STATIC_TILING = MakeStaticTiling();
	using MM = AscendC::MatmulImpl<AType, BType, CType, BiasType, STATIC_TILING>;
};

}
__aicore__ inline void RgR3FP32ScaleRows(const AscendC::LocalTensor<float> &z,
																				 const AscendC::LocalTensor<float> &s, int32_t rows, int32_t pitch) {
	using namespace AscendC;
	if (pitch % 64 == 0 && rows >= pitch / 64) {
		BinaryRepeatParams rp;
		rp.dstBlkStride = 1;
		rp.src0BlkStride = 1;
		rp.src1BlkStride = 1;
		rp.dstRepStride = pitch / 8;
		rp.src0RepStride = pitch / 8;
		rp.src1RepStride = 0;
		for (int col = 0; col < pitch; col += 64)
			Mul(z[col], z[col], s[col], uint64_t(64), rows, rp);
	} else {
		for (int row = 0; row < rows; ++row)
			Mul(z[row * pitch], z[row * pitch], s, pitch);
	}
}
__aicore__ inline void RgR3FP32GeluInplace(const AscendC::LocalTensor<float> &z,
																					 const AscendC::LocalTensor<float> &u, int32_t cnt) {
	using namespace AscendC;
	Mul(u, z, z, cnt);
	Muls(u, u, -0.07135481627260026f, cnt);
	Adds(u, u, -1.5957691216057308f, cnt);
	Mul(u, u, z, cnt);
	Exp(u, u, cnt);
	Adds(u, u, 1.0f, cnt);
	Div(u, z, u, cnt);
}
namespace rg_r3_staged_slabs {
template <int SLOTS> struct Config {
	using Base = rg_r3_fp32_config::Config<64, 256>;
	using AType = typename Base::AType;
	using BType = typename Base::BType;
	using CType = typename Base::CType;
	using BiasType = typename Base::BiasType;
	static __aicore__ constexpr MatmulApiStaticTiling MakeTiling() {
		auto t = Base::MakeStaticTiling();
		t.dbL0C = SLOTS;
		return t;
	}
	constexpr static MatmulApiStaticTiling TILING = MakeTiling();
	using MM = AscendC::MatmulImpl<AType, BType, CType, BiasType, TILING>;
};

__aicore__ inline void StageRegular(AscendC::TQue<AscendC::TPosition::VECIN, 2> &cq,
																		AscendC::TQue<AscendC::TPosition::VECIN, 2> &sq,
																		AscendC::GlobalTensor<int32_t> &cg, AscendC::GlobalTensor<float> &sg,
																		int32_t core, int32_t seq, int32_t first, int32_t rows, int32_t expert,
																		int32_t n, int32_t panel) {
	using namespace AscendC;
	constexpr int TN = 256;
	auto s = sq.AllocTensor<float>();
	DataCopy(s, sg[expert * n + panel * TN], TN);
	sq.EnQue(s);
	CrossCoreWaitFlag(5);
	auto value = cq.AllocTensor<int32_t>();
	DataCopy(value, cg[(core * 2 + (seq & 1)) * 64 * TN + first * TN], rows * TN);
	cq.EnQue(value);
	CrossCoreSetFlag<2, PIPE_MTE2>(3);
}

__aicore__ inline void FinalCastND(AscendC::LocalTensor<half> &out, AscendC::LocalTensor<float> &u,
																	 int32_t panel, int32_t rows, int32_t pitch) {
	using namespace AscendC;
	constexpr int TN = 256;
	UnaryRepeatParams rp;
	rp.dstBlkStride = 1;
	rp.srcBlkStride = 1;
	rp.dstRepStride = pitch * sizeof(half) / 32;
	rp.srcRepStride = TN * sizeof(float) / 32;
	for (int32_t col = 0; col < TN; col += 64)
		Cast(out[panel * TN + col], u[col], RoundMode::CAST_NONE, uint64_t(64), static_cast<uint8_t>(rows), rp);
	PipeBarrier<PIPE_V>();
}

struct ExpertSegment {
	int expert;
	int begin;
	int end;
	int firstN;
	int lastN;
};

__aicore__ inline ExpertSegment DecodeSegment(uint64_t token) {
	ExpertSegment segment;
	segment.expert = token & 127;
	segment.begin = (token >> 7) & 65535;
	segment.end = ((token >> 23) & 65535) + 1;
	segment.firstN = (token >> 39) & 3;
	segment.lastN = ((token >> 41) & 3) + 1;
	return segment;
}

template <int P> __aicore__ inline int WeightedTaskBoundary(int cost, int rows) {

	constexpr int ROW_UNIT = 5 * P + 1;
	constexpr int B_SETUP = 16 * P;
	if (cost <= 0)
		return 0;
	const int firstRows = rows < 64 ? rows : 64;
	const int firstUnit = ((firstRows + 15) / 16) * ROW_UNIT + B_SETUP;
	const int firstCost = P * firstUnit;
	if (cost <= firstCost)
		return (cost + firstUnit - 1) / firstUnit;
	const int remaining = rows > 64 ? rows - 64 : 0;
	const int full = remaining / 64;
	const int fullUnit = 4 * ROW_UNIT;
	const int fullCost = full * P * fullUnit;
	cost -= firstCost;
	if (cost <= fullCost)
		return P + (cost + fullUnit - 1) / fullUnit;
	const int tail = remaining % 64;
	if (!tail)
		return P + full * P;
	const int tailUnit = ((tail + 15) / 16) * ROW_UNIT;
	const int result = P + full * P + (cost - fullCost + tailUnit - 1) / tailUnit;
	const int tasks = P * ((rows + 63) / 64);
	return result < tasks ? result : tasks;
}

template <int P>
__aicore__ inline int BuildWeightedSegments(const AscendC::LocalTensor<int64_t> &gl,
																						AscendC::LocalTensor<uint64_t> &descriptors, int experts,
																						int core, int cores) {
	constexpr int ROW_UNIT = 5 * P + 1;
	constexpr int B_SETUP = 16 * P;
	int total = 0;
	int begin = 0;
	for (int expert = 0; expert < experts; ++expert) {
		const int end = gl.GetValue(expert);
		if (end > begin)
			total += P * (((end - begin + 15) / 16) * ROW_UNIT + B_SETUP);
		begin = end;
	}
	const int lower = total * core / cores;
	const int upper = total * (core + 1) / cores;
	int prefix = 0;
	int count = 0;
	begin = 0;
	for (int expert = 0; expert < experts && prefix < upper; ++expert) {
		const int end = gl.GetValue(expert);
		const int rows = end - begin;
		if (rows > 0) {
			const int cost = P * (((rows + 15) / 16) * ROW_UNIT + B_SETUP);
			if (prefix + cost > lower) {
				const int first = WeightedTaskBoundary<P>(lower - prefix, rows);
				const int last = WeightedTaskBoundary<P>(upper - prefix, rows);
				if (first < last) {
					const int row = begin + (first / P) * 64;
					const int stopTile = ((last - 1) / P + 1) * 64;
					const int stop = begin + stopTile < end ? begin + stopTile : end;
					const uint64_t token = static_cast<uint64_t>(expert) | (static_cast<uint64_t>(row) << 7) |
																 (static_cast<uint64_t>(stop - 1) << 23) |
																 (static_cast<uint64_t>(first % P) << 39) |
																 (static_cast<uint64_t>((last - 1) % P) << 41);
					descriptors.SetValue(++count, token);
				}
			}
			prefix += cost;
		}
		begin = end;
	}
	return count;
}

struct StreamWork {
	int row;
	int rows;
	int expert;
	int owned;
	int panels;
};

template <int P> __aicore__ inline StreamWork SegmentWork(const ExpertSegment &segment, int row) {
	StreamWork work;
	work.row = row;
	work.rows = segment.end - row < 64 ? segment.end - row : 64;
	work.expert = segment.expert;
	work.owned = row == segment.begin ? segment.firstN : 0;
	const int limit = row + 64 >= segment.end ? segment.lastN : P;
	work.panels = limit - work.owned;
	return work;
}

__aicore__ inline void StageStreamA(const StreamWork &work, int index, AscendC::LocalTensor<int8_t> &a1,
																		AscendC::GlobalTensor<int8_t> &x) {
	using namespace AscendC;
	const int bank = index & 1;
	if (index >= 2)
		WaitFlag<HardEvent::MTE1_MTE2>(4 + bank);
	Nd2NzParams p;
	p.ndNum = 1;
	p.nValue = work.rows;
	p.dValue = 512;
	p.srcNdMatrixStride = 0;
	p.srcDValue = 512;
	p.dstNzC0Stride = 64;
	p.dstNzNStride = 1;
	p.dstNzMatrixStride = 0;
	DataCopy(a1[bank * 64 * 512], x[work.row * 512], p);
	SetFlag<HardEvent::MTE2_MTE1>(4 + bank);
}

__aicore__ inline void LoadStreamA(const StreamWork &work, int index, AscendC::LocalTensor<int8_t> &a1,
																	 AscendC::LocalTensor<int8_t> &a2) {
	using namespace AscendC;
	const int bank = index & 1;
	WaitFlag<HardEvent::MTE2_MTE1>(4 + bank);
	const uint8_t pads[4] = {0, 0, 0, 0};
	SetFmatrix(1, 64, pads, FmatrixMode::FMATRIX_LEFT);
	const int padded = (work.rows + 15) / 16 * 16;
	for (int micro = 0; micro < 4; ++micro) {
		LoadData3DParamsV2Pro p;
		p.channelSize = 128;
		p.extConfig = (uint64_t(padded) << 16) | 128;
		p.enTranspose = false;
		LoadData(a2[micro * 64 * 128], a1[bank * 64 * 512 + micro * 64 * 128], p);
	}
	SetFlag<HardEvent::MTE1_MTE2>(4 + bank);
	SetFlag<HardEvent::MTE1_M>(2);
}

template <int P>
__aicore__ inline void StageExpertB(const ExpertSegment &segment, int block, bool reuse,
																		AscendC::LocalTensor<int8_t> &b1, AscendC::GlobalTensor<int8_t> &weight) {
	using namespace AscendC;
	if (reuse)
		WaitFlag<HardEvent::MTE1_MTE2>(6 + block);
	const bool multiple = segment.end - segment.begin > 64;
	const int first = multiple ? 0 : segment.firstN;
	const int last = multiple ? P : segment.lastN;
	Nd2NzParams p;
	p.ndNum = 1;
	p.nValue = 256;
	p.dValue = (last - first) * 256;
	p.srcNdMatrixStride = 0;
	p.srcDValue = P * 256;
	p.dstNzC0Stride = 256;
	p.dstNzNStride = 1;
	p.dstNzMatrixStride = 0;

	DataCopy(b1[block * P * 256 * 256 + first * 256 * 256],
					 weight[segment.expert * 512 * P * 256 + block * 256 * P * 256 + first * 256], p);
	SetFlag<HardEvent::MTE2_MTE1>(6 + block);
}

template <int P>
__aicore__ inline void LoadExpertB(int op, const StreamWork &work, bool firstTile, bool lastTile,
																	 bool hasNext, const ExpertSegment &next, AscendC::LocalTensor<int8_t> &b1,
																	 AscendC::LocalTensor<int8_t> &b2, AscendC::GlobalTensor<int8_t> &weight) {
	using namespace AscendC;
	const int bank = op & 1;
	const int panel = work.owned + op / 4;
	const int micro = op % 4;
	const int block = micro / 2;
	const int q = micro & 1;
	if (op >= 2)
		WaitFlag<HardEvent::M_MTE1>(6 + bank);
	if (firstTile && panel == work.owned && q == 0)
		WaitFlag<HardEvent::MTE2_MTE1>(6 + block);
	LoadData2dTransposeParams p;
	p.startIndex = 0;
	p.repeatTimes = 8;
	p.srcStride = 8;
	p.dstGap = 1;
	p.dstFracGap = 0;
	p.addrMode = 0;
	for (int ki = 0; ki < 4; ++ki)
		LoadDataWithTranspose(b2[bank * 128 * 256 + ki * 32 * 256],
													b1[block * P * 256 * 256 + panel * 256 * 256 + (q * 4 + ki) * 1024], p);
	SetFlag<HardEvent::MTE1_M>(6 + bank);
	if (lastTile && panel + 1 == work.owned + work.panels && q == 1 && hasNext) {
		SetFlag<HardEvent::MTE1_MTE2>(6 + block);
		StageExpertB<P>(next, block, true, b1, weight);
	}
}

struct PendingStreamC {
	int seq;
	int rows;
	int padded;
	bool valid;
};

__aicore__ inline void RetireStreamC(PendingStreamC &pending, int core, AscendC::GlobalTensor<int32_t> &c,
																		 AscendC::LocalTensor<int32_t> &all) {
	using namespace AscendC;
	if (!pending.valid)
		return;
	const int slot = pending.seq & 1;
	WaitFlag<HardEvent::M_FIX>(4 + slot);
	if (pending.seq >= 2)
		CrossCoreWaitFlag(3);
	FixpipeParamsV220 p;
	p.nSize = 256;
	p.mSize = pending.rows;
	p.srcStride = pending.padded;
	p.dstStride = 256;
	p.reluEn = false;
	p.quantPre = QuantMode_t::NoQuant;
	p.unitFlag = 0;
	Fixpipe<int32_t, int32_t, CFG_ROW_MAJOR>(c[(core * 2 + slot) * 64 * 256], all[slot * 64 * 256], p);
	CrossCoreSetFlag<2, PIPE_FIX>(5);
	SetFlag<HardEvent::FIX_M>(4 + slot);
	pending.valid = false;
}

template <int P>
__aicore__ inline void ComputeFallback(GM_ADDR x, GM_ADDR w, GM_ADDR scale, GM_ADDR groups, GM_ADDR y,
																			 GM_ADDR workspace, int32_t m, int32_t e, int32_t metaElements) {
	using namespace AscendC;
	using namespace gmm_common;
	constexpr int TM = 64, TN = 256, ROWS = 32, ELEMS = ROWS * TN, GROUP = P <= 3 ? P : 2, OUT_DEPTH = 1;
	static_assert(P >= 2 && P <= 4, "Supported grouped FP32 family");
	static_assert(2 * ELEMS * 4 + ELEMS * 4 + OUT_DEPTH * ROWS * GROUP * TN * 2 + 2 * TN * 4 <= 192 * 1024,
								"Live UB including scratch lifecycle");
	const int32_t n = P * TN, ng = (P + GROUP - 1) / GROUP, core = CoreGroupIndex(), sub = SubCoreIndex(),
								cores = GetBlockNum();
	GlobalTensor<int8_t> xg, wg;
	GlobalTensor<float> sg;
	GlobalTensor<int64_t> gl;
	GlobalTensor<int32_t> cg;
	GlobalTensor<half> yg;
	xg.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t *>(x), m * 512);
	wg.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t *>(w), e * 512 * n);
	sg.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(scale), e * n);
	gl.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t *>(groups), e);
	cg.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t *>(workspace), cores * 2 * TM * TN);
	yg.SetGlobalBuffer(reinterpret_cast<__gm__ half *>(y), m * n);
	GlobalTensor<uint64_t> metadataGm;
	GlobalTensor<int8_t> metadataBytesGm;
	auto metadataAddress = reinterpret_cast<__gm__ int8_t *>(workspace) + cores * 2 * TM * TN * 4;
	metadataGm.SetGlobalBuffer(reinterpret_cast<__gm__ uint64_t *>(metadataAddress), cores * metaElements);
	metadataBytesGm.SetGlobalBuffer(metadataAddress, cores * metaElements * 8);
	static_assert(2 * ELEMS * 4 + ELEMS * 4 + OUT_DEPTH * ROWS * GROUP * TN * 2 + 2 * TN * 4 + 1024 + 4096 <=
										192 * 1024,
								"GL and metadata UB fit");
	TPipe pipe;
	if ASCEND_IS_AIC {
		using MM = typename Config<2>::MM;
		MM mm;
		mm.SetSubBlockIdx(0);
		mm.Init(static_cast<TCubeTiling *>(nullptr), &pipe);
		int32_t seq = 0;
		const int64_t metadataBase = static_cast<int64_t>(core) * metaElements;
		for (int32_t offset = 0; offset < metaElements; offset += 8)
			DataCacheCleanAndInvalid<uint64_t, CacheLine::SINGLE_CACHE_LINE>(metadataGm[metadataBase + offset]);
		const auto retired = pipe.FetchEventID<HardEvent::S_MTE2>();
		SetFlag<HardEvent::S_MTE2>(retired);
		WaitFlag<HardEvent::S_MTE2>(retired);
		pipe.ReleaseEventID<HardEvent::S_MTE2>(retired);
		CrossCoreSetFlag<2, PIPE_MTE2>(8);
		CrossCoreWaitFlag(9);
		const int32_t taskCount = metadataGm.GetValue(metadataBase);
		for (int32_t descriptor = 0; descriptor < taskCount; ++descriptor) {
			const uint64_t token = metadataGm.GetValue(metadataBase + descriptor + 1);
			const int32_t expert = token & 127, owned = (token >> 29) & 3, taskPanels = ((token >> 31) & 3) + 1;
			int32_t row = (token >> 7) & 65535;
			const int32_t end = row + ((token >> 23) & 63) + 1, slabEnd = end;
			while (row < slabEnd) {
				const int32_t stop = end < slabEnd ? end : slabEnd, count = stop - row;
				const int32_t groupN = taskPanels * TN;
				mm.SetOrgShape(count, n, 512, 512, TN);
				mm.SetSingleShape(count, groupN, 512);
				mm.SetTensorA(xg[row * 512], false);
				mm.SetTensorB(wg[expert * 512 * n + owned * TN], false);
				int32_t panel = 0;
				while (mm.Iterate()) {
					if (seq >= 2)
						CrossCoreWaitFlag(3);
					const uint64_t slot = static_cast<uint64_t>(core * 2 + (seq & 1)) * TM * TN;
					const uint64_t base =
							reinterpret_cast<uint64_t>(workspace) + slot * 4 - static_cast<uint64_t>(panel) * TN * 4;
					GlobalTensor<int32_t> target;
					target.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t *>(base), TM * TN);
					mm.GetTensorC(target, 0, false);
					CrossCoreSetFlag<2, PIPE_FIX>(5);
					++seq;
					++panel;
				}
				row = stop;
			}
		}
	} else {
		TQue<TPosition::VECIN, 2> cq, sq;
		TQue<TPosition::VECOUT, OUT_DEPTH> oq;
		TBuf<TPosition::VECCALC> ub;
		pipe.InitBuffer(cq, 2, ELEMS * 4);
		pipe.InitBuffer(oq, OUT_DEPTH, ROWS * GROUP * TN * 2);
		pipe.InitBuffer(ub, ELEMS * 4 + 256);
		pipe.InitBuffer(sq, 2, TN * 4);
		auto u = ub.Get<float>()[64];
		int32_t seq = 0;
		TBuf<TPosition::VECCALC> glBuffer, metadataBuffer;
		pipe.InitBuffer(glBuffer, 1024);
		pipe.InitBuffer(metadataBuffer, metaElements * 8);
		auto glValues = glBuffer.Get<int64_t>();
		auto descriptors = metadataBuffer.Get<uint64_t>();
		GlobalTensor<int8_t> glBytes;
		glBytes.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t *>(groups), e * 8);
		DataCopyExtParams gcp{};
		gcp.blockCount = 1;
		gcp.blockLen = e * 8;
		DataCopyPadExtParams<int8_t> gpad{true, 0, 0, 0};
		DataCopyPad(glValues.ReinterpretCast<int8_t>(), glBytes, gcp, gpad);
		const auto glReady = pipe.FetchEventID<HardEvent::MTE2_S>();
		SetFlag<HardEvent::MTE2_S>(glReady);
		WaitFlag<HardEvent::MTE2_S>(glReady);
		pipe.ReleaseEventID<HardEvent::MTE2_S>(glReady);
		int32_t taskCount = 0;
		for (int32_t task = core; task < ((m + TM - 1) / TM) * ng; task += cores) {
			const int32_t slab = task / ng, owned = (task % ng) * GROUP;
			int32_t row = slab * TM;
			const int32_t slabEnd = row + TM < m ? row + TM : m;
			int32_t expert = slab;
			if (expert >= e)
				expert = e - 1;
			int32_t start = expert ? glValues.GetValue(expert - 1) : 0, end = glValues.GetValue(expert);
			if (!(start <= row && row < end)) {
				int32_t lo = 0, hi = e;
				while (lo < hi) {
					const int32_t mid = (lo + hi) / 2;
					if (glValues.GetValue(mid) <= row)
						lo = mid + 1;
					else
						hi = mid;
				}
				expert = lo;
				end = glValues.GetValue(expert);
			}
			while (row < slabEnd) {
				const int32_t stop = end < slabEnd ? end : slabEnd, rows = stop - row;
				const int32_t panels = P - owned < GROUP ? P - owned : GROUP;
				const uint64_t token = static_cast<uint64_t>(expert) | (static_cast<uint64_t>(row) << 7) |
															 (static_cast<uint64_t>(rows - 1) << 23) |
															 (static_cast<uint64_t>(owned) << 29) |
															 (static_cast<uint64_t>(panels - 1) << 31);
				descriptors.SetValue(++taskCount, token);
				row = stop;
				while (row < slabEnd && end <= row) {
					++expert;
					end = glValues.GetValue(expert);
				}
			}
		}
		descriptors.SetValue(0, static_cast<uint64_t>(taskCount));
		const int32_t publishedElements = ((taskCount + 1 + 7) / 8) * 8;
		for (int32_t i = taskCount + 1; i < publishedElements; ++i)
			descriptors.SetValue(i, 0);
		CrossCoreWaitFlag(8);
		if (sub == 0) {
			const auto visible = pipe.FetchEventID<HardEvent::S_MTE3>();
			SetFlag<HardEvent::S_MTE3>(visible);
			WaitFlag<HardEvent::S_MTE3>(visible);
			pipe.ReleaseEventID<HardEvent::S_MTE3>(visible);
			DataCopy(metadataBytesGm[core * metaElements * 8], descriptors.ReinterpretCast<int8_t>(),
							 publishedElements * 8);
		}
		CrossCoreSetFlag<2, PIPE_MTE3>(9);
		for (int32_t descriptor = 0; descriptor < taskCount; ++descriptor) {
			const uint64_t token = descriptors.GetValue(descriptor + 1);
			const int32_t expert = token & 127, owned = (token >> 29) & 3, taskPanels = ((token >> 31) & 3) + 1;
			int32_t row = (token >> 7) & 65535;
			const int32_t end = row + ((token >> 23) & 63) + 1, slabEnd = end;
			while (row < slabEnd) {
				const int32_t stop = end < slabEnd ? end : slabEnd, tileRows = stop - row;
				const int32_t per = (tileRows + 1) / 2, first = sub * per,
											rows = first < tileRows ? (tileRows - first < per ? tileRows - first : per) : 0;
				const int32_t panels = taskPanels, pitch = panels * TN;
				if (rows) {
					auto out = oq.template AllocTensor<half>();
					StageRegular(cq, sq, cg, sg, core, seq, first, rows, expert, n, owned);
					for (int32_t panel = 0; panel < panels; ++panel) {
						auto s = sq.DeQue<float>();
						auto value = cq.DeQue<int32_t>();
						auto z = value.ReinterpretCast<float>();
						const int32_t total = rows * TN;
						Cast(z, value, RoundMode::CAST_NONE, total);
						PipeBarrier<PIPE_V>();
						RgR3FP32ScaleRows(z, s, rows, TN);
						PipeBarrier<PIPE_V>();
						sq.FreeTensor(s);
						if (panel + 1 < panels)
							StageRegular(cq, sq, cg, sg, core, seq + 1, first, rows, expert, n, owned + panel + 1);
						RgR3FP32GeluInplace(z, u, total);
						PipeBarrier<PIPE_V>();
						FinalCastND(out, u, panel, rows, pitch);
						cq.FreeTensor(value);
						++seq;
					}
					oq.EnQue(out);
					out = oq.template DeQue<half>();
					DataCopyExtParams op{};
					op.blockCount = rows;
					op.blockLen = pitch * sizeof(half);
					op.dstStride = (n - pitch) * sizeof(half);
					DataCopyPad(yg[(row + first) * n + owned * TN], out, op);
					oq.FreeTensor(out);
				} else {
					for (int32_t panel = 0; panel < panels; ++panel) {
						CrossCoreWaitFlag(5);
						CrossCoreSetFlag<2, PIPE_MTE2>(3);
						++seq;
					}
				}
				row = stop;
			}
		}
	}
}
template <int P>
__aicore__ inline void ComputeResident(GM_ADDR x, GM_ADDR w, GM_ADDR scale, GM_ADDR groups, GM_ADDR y,
																			 GM_ADDR workspace, int32_t m, int32_t e, int32_t metaElements) {
	using namespace AscendC;
	using namespace gmm_common;
	constexpr int TM = 64, TN = 256, ROWS = 32, ELEMS = ROWS * TN, GROUP = P <= 3 ? P : 2, OUT_DEPTH = 1;
	static_assert(P >= 2 && P <= 4, "Supported grouped FP32 family");
	static_assert(2 * ELEMS * 4 + ELEMS * 4 + OUT_DEPTH * ROWS * GROUP * TN * 2 + 2 * TN * 4 <= 192 * 1024,
								"Live UB including scratch lifecycle");
	const int32_t n = P * TN, ng = (P + GROUP - 1) / GROUP, core = CoreGroupIndex(), sub = SubCoreIndex(),
								cores = GetBlockNum();
	GlobalTensor<int8_t> xg, wg;
	GlobalTensor<float> sg;
	GlobalTensor<int64_t> gl;
	GlobalTensor<int32_t> cg;
	GlobalTensor<half> yg;
	xg.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t *>(x), m * 512);
	wg.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t *>(w), e * 512 * n);
	sg.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(scale), e * n);
	gl.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t *>(groups), e);
	cg.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t *>(workspace), cores * 2 * TM * TN);
	yg.SetGlobalBuffer(reinterpret_cast<__gm__ half *>(y), m * n);
	GlobalTensor<uint64_t> metadataGm;
	GlobalTensor<int8_t> metadataBytesGm;
	auto metadataAddress = reinterpret_cast<__gm__ int8_t *>(workspace) + cores * 2 * TM * TN * 4;
	metadataGm.SetGlobalBuffer(reinterpret_cast<__gm__ uint64_t *>(metadataAddress), cores * metaElements);
	metadataBytesGm.SetGlobalBuffer(metadataAddress, cores * metaElements * 8);
	static_assert(2 * ELEMS * 4 + ELEMS * 4 + OUT_DEPTH * ROWS * GROUP * TN * 2 + 2 * TN * 4 + 1024 + 4096 <=
										192 * 1024,
								"GL and metadata UB fit");
	TPipe pipe;
	if ASCEND_IS_AIC {
		TBuf<TPosition::A1> arena;
		TBuf<TPosition::A2> a2buf;
		TBuf<TPosition::B2> b2buf;
		TBuf<TPosition::CO1> cbuf;
		pipe.InitBuffer(arena, 64 * 1024 + P * 128 * 1024);
		pipe.InitBuffer(a2buf, 32 * 1024);
		pipe.InitBuffer(b2buf, 64 * 1024);
		pipe.InitBuffer(cbuf, 128 * 1024);
		const uint32_t arenaBase = static_cast<uint32_t>(arena.Get<int8_t>().GetPhyAddr());
		LocalTensor<int8_t> a1(TPosition::A1, arenaBase, 64 * 1024);
		LocalTensor<int8_t> b1(TPosition::B1, arenaBase + 64 * 1024, P * 128 * 1024);
		auto a2 = a2buf.Get<int8_t>();
		auto b2 = b2buf.Get<int8_t>();
		auto all = cbuf.Get<int32_t>();
		const int64_t metadataBase = static_cast<int64_t>(core) * metaElements;
		for (int offset = 0; offset < metaElements; offset += 8)
			DataCacheCleanAndInvalid<uint64_t, CacheLine::SINGLE_CACHE_LINE>(metadataGm[metadataBase + offset]);
		const auto retired = pipe.FetchEventID<HardEvent::S_MTE2>();
		SetFlag<HardEvent::S_MTE2>(retired);
		WaitFlag<HardEvent::S_MTE2>(retired);
		pipe.ReleaseEventID<HardEvent::S_MTE2>(retired);
		CrossCoreSetFlag<2, PIPE_MTE2>(8);
		CrossCoreWaitFlag(9);
		const int count = metadataGm.GetValue(metadataBase);
		int seq = 0;
		int aIndex = 0;
		bool aheadA = false;
		bool aheadB = false;
		PendingStreamC pending{0, 0, 0, false};
		for (int descriptor = 0; descriptor < count; ++descriptor) {
			const ExpertSegment segment = DecodeSegment(metadataGm.GetValue(metadataBase + descriptor + 1));
			const bool hasNext = descriptor + 1 < count;
			ExpertSegment next{};
			if (hasNext)
				next = DecodeSegment(metadataGm.GetValue(metadataBase + descriptor + 2));
			if (!aheadB) {
				StageExpertB<P>(segment, 0, false, b1, wg);
				StageExpertB<P>(segment, 1, false, b1, wg);
			}
			aheadB = false;
			for (int row = segment.begin; row < segment.end; row += 64) {
				const StreamWork work = SegmentWork<P>(segment, row);
				const bool firstTile = row == segment.begin;
				const bool lastTile = row + 64 >= segment.end;
				if (!aheadA)
					StageStreamA(work, aIndex, a1, xg);
				aheadA = false;
				LoadStreamA(work, aIndex, a1, a2);
				if (!lastTile || hasNext) {
					const StreamWork nextWork =
							lastTile ? SegmentWork<P>(next, next.begin) : SegmentWork<P>(segment, row + 64);
					StageStreamA(nextWork, aIndex + 1, a1, xg);
					aheadA = true;
				}
				const int total = work.panels * 4;
				const int padded = (work.rows + 15) / 16 * 16;
				LoadExpertB<P>(0, work, firstTile, lastTile, hasNext, next, b1, b2, wg);
				LoadExpertB<P>(1, work, firstTile, lastTile, hasNext, next, b1, b2, wg);
				WaitFlag<HardEvent::MTE1_M>(2);
				for (int panel = 0; panel < work.panels; ++panel) {
					const int current = seq;
					const int slot = current & 1;
					if (current >= 2)
						WaitFlag<HardEvent::FIX_M>(4 + slot);
					for (int micro = 0; micro < 4; ++micro) {
						const int op = panel * 4 + micro;
						const int bank = op & 1;
						WaitFlag<HardEvent::MTE1_M>(6 + bank);
						MmadParams p;
						p.m = padded;
						p.n = 256;
						p.k = 128;
						p.cmatrixInitVal = micro == 0;
						p.unitFlag = 0;
						Mmad(all[slot * 64 * 256], a2[micro * 64 * 128], b2[bank * 128 * 256], p);
						SetFlag<HardEvent::M_MTE1>(6 + bank);
						if (op + 1 == total)
							SetFlag<HardEvent::M_MTE1>(2);
						if (op + 2 < total)
							LoadExpertB<P>(op + 2, work, firstTile, lastTile, hasNext, next, b1, b2, wg);
					}
					SetFlag<HardEvent::M_FIX>(4 + slot);
					RetireStreamC(pending, core, cg, all);
					pending = {current, work.rows, padded, true};
					++seq;
				}
				WaitFlag<HardEvent::M_MTE1>(6);
				WaitFlag<HardEvent::M_MTE1>(7);
				WaitFlag<HardEvent::M_MTE1>(2);
				++aIndex;
			}
			aheadB = hasNext;
		}
		RetireStreamC(pending, core, cg, all);
		for (int i = 0; i < (seq < 2 ? seq : 2); ++i)
			WaitFlag<HardEvent::FIX_M>(4 + i);
		for (int i = 0; i < (aIndex < 2 ? aIndex : 2); ++i)
			WaitFlag<HardEvent::MTE1_MTE2>(4 + i);

	} else {
		TQue<TPosition::VECIN, 2> cq, sq;
		TQue<TPosition::VECOUT, OUT_DEPTH> oq;
		TBuf<TPosition::VECCALC> ub;
		pipe.InitBuffer(cq, 2, ELEMS * 4);
		pipe.InitBuffer(oq, OUT_DEPTH, ROWS * GROUP * TN * 2);
		pipe.InitBuffer(ub, ELEMS * 4 + 256);
		pipe.InitBuffer(sq, 2, TN * 4);
		auto u = ub.Get<float>()[64];
		int32_t seq = 0;
		TBuf<TPosition::VECCALC> glBuffer, metadataBuffer;
		pipe.InitBuffer(glBuffer, 1024);
		pipe.InitBuffer(metadataBuffer, metaElements * 8);
		auto glValues = glBuffer.Get<int64_t>();
		auto descriptors = metadataBuffer.Get<uint64_t>();
		GlobalTensor<int8_t> glBytes;
		glBytes.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t *>(groups), e * 8);
		DataCopyExtParams gcp{};
		gcp.blockCount = 1;
		gcp.blockLen = e * 8;
		DataCopyPadExtParams<int8_t> gpad{true, 0, 0, 0};
		DataCopyPad(glValues.ReinterpretCast<int8_t>(), glBytes, gcp, gpad);
		const auto glReady = pipe.FetchEventID<HardEvent::MTE2_S>();
		SetFlag<HardEvent::MTE2_S>(glReady);
		WaitFlag<HardEvent::MTE2_S>(glReady);
		pipe.ReleaseEventID<HardEvent::MTE2_S>(glReady);
		const int32_t taskCount = BuildWeightedSegments<P>(glValues, descriptors, e, core, cores);
		descriptors.SetValue(0, static_cast<uint64_t>(taskCount));
		const int32_t publishedElements = ((taskCount + 1 + 7) / 8) * 8;
		for (int32_t i = taskCount + 1; i < publishedElements; ++i)
			descriptors.SetValue(i, 0);
		CrossCoreWaitFlag(8);
		if (sub == 0) {
			const auto visible = pipe.FetchEventID<HardEvent::S_MTE3>();
			SetFlag<HardEvent::S_MTE3>(visible);
			WaitFlag<HardEvent::S_MTE3>(visible);
			pipe.ReleaseEventID<HardEvent::S_MTE3>(visible);
			DataCopy(metadataBytesGm[core * metaElements * 8], descriptors.ReinterpretCast<int8_t>(),
							 publishedElements * 8);
		}
		CrossCoreSetFlag<2, PIPE_MTE3>(9);
		for (int32_t descriptor = 0; descriptor < taskCount; ++descriptor) {
			const ExpertSegment segment = DecodeSegment(descriptors.GetValue(descriptor + 1));
			const int32_t expert = segment.expert;
			int32_t row = segment.begin;
			while (row < segment.end) {
				const StreamWork work = SegmentWork<P>(segment, row);
				const int32_t stop = row + work.rows;
				const int32_t tileRows = work.rows;
				const int32_t owned = work.owned;
				const int32_t per = (tileRows + 1) / 2, first = sub * per,
											rows = first < tileRows ? (tileRows - first < per ? tileRows - first : per) : 0;
				const int32_t panels = work.panels, pitch = panels * TN;
				if (rows) {
					auto out = oq.template AllocTensor<half>();
					StageRegular(cq, sq, cg, sg, core, seq, first, rows, expert, n, owned);
					for (int32_t panel = 0; panel < panels; ++panel) {
						auto s = sq.DeQue<float>();
						auto value = cq.DeQue<int32_t>();
						auto z = value.ReinterpretCast<float>();
						const int32_t total = rows * TN;
						Cast(z, value, RoundMode::CAST_NONE, total);
						PipeBarrier<PIPE_V>();
						RgR3FP32ScaleRows(z, s, rows, TN);
						PipeBarrier<PIPE_V>();
						sq.FreeTensor(s);
						if (panel + 1 < panels)
							StageRegular(cq, sq, cg, sg, core, seq + 1, first, rows, expert, n, owned + panel + 1);
						RgR3FP32GeluInplace(z, u, total);
						PipeBarrier<PIPE_V>();
						FinalCastND(out, u, panel, rows, pitch);
						cq.FreeTensor(value);
						++seq;
					}
					oq.EnQue(out);
					out = oq.template DeQue<half>();
					DataCopyExtParams op{};
					op.blockCount = rows;
					op.blockLen = pitch * sizeof(half);
					op.dstStride = (n - pitch) * sizeof(half);
					DataCopyPad(yg[(row + first) * n + owned * TN], out, op);
					oq.FreeTensor(out);
				} else {
					for (int32_t panel = 0; panel < panels; ++panel) {
						CrossCoreWaitFlag(5);
						CrossCoreSetFlag<2, PIPE_MTE2>(3);
						++seq;
					}
				}
				row = stop;
			}
		}
	}
}
template <int P>
__aicore__ inline void Compute(GM_ADDR x, GM_ADDR w, GM_ADDR scale, GM_ADDR groups, GM_ADDR y,
															 GM_ADDR workspace, int32_t m, int32_t e, int32_t metaElements) {

	if constexpr (P * 512 * 256 + 2 * 64 * 512 <= 512 * 1024)
		ComputeResident<P>(x, w, scale, groups, y, workspace, m, e, metaElements);
	else
		ComputeFallback<P>(x, w, scale, groups, y, workspace, m, e, metaElements);
}

}
namespace rg_r2_fp32_config {
template <int TM, int TN> struct Config {
	static_assert(TM * 1024 + TN * (TN > 256 ? 64 : 128) * 8 <= 512 * 1024, "Full A and streaming B fit L1");
	static_assert(TM % 16 == 0 && TN % 32 == 0, "Cube tile alignment");
	static_assert(TM * TN * 4 <= 128 * 1024, "L0C capacity");
	static_assert((TM + TN) * (TN > 256 ? 64 : 128) * 8 <= 512 * 1024, "L1 capacity");
	static_assert(26 * (TN == 512 ? 8 : 16) * TN + 4 * TN <= 192 * 1024, "UB capacity");
	using AType = AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, int8_t, false>;
	using BType = AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, int8_t, false>;
	using CType = AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, int32_t>;
	using BiasType = AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, int32_t>;
	static constexpr int32_t TILE_M = TM;
	static constexpr int32_t TILE_N = TN;
	static constexpr int32_t VEC_CHUNK_M = TN == 512 ? 8 : 16;
	static constexpr uint16_t GMM_SYNC_AIV_AIC = 3;
	static constexpr uint16_t GMM_SYNC_AIC_AIV = 5;
	static constexpr uint64_t SYNC_MODE2 = 2;
	static __aicore__ constexpr MatmulConfig MakeMatmulConfig() {
		MatmulConfig cfg{};
		cfg.doNorm = false;
		cfg.doBasicBlock = false;
		cfg.doMultiDataLoad = true;
		cfg.basicM = TILE_M;
		cfg.basicN = TILE_N;
		cfg.basicK = TN > 256 ? 64 : 128;
		cfg.intrinsicsCheck = false;
		cfg.isNBatch = false;
		cfg.enVecND2NZ = false;
		cfg.doSpecialBasicBlock = false;
		cfg.doMTE2Preload = 0;
		cfg.singleCoreM = TILE_M;
		cfg.singleCoreN = 1024;
		cfg.singleCoreK = 1024;
		cfg.stepM = 0;
		cfg.stepN = 0;
		cfg.baseMN = 0;
		cfg.singleCoreMN = 0;
		cfg.enUnitFlag = true;
		cfg.isPerTensor = false;
		cfg.hasAntiQuantOffset = false;
		cfg.doIBShareNorm = false;
		cfg.doSpecialMDL = false;
		cfg.enableInit = false;
		cfg.batchMode = BatchMode::NONE;
		cfg.enableEnd = true;
		cfg.enableGetTensorC = true;
		cfg.enableSetOrgShape = true;
		cfg.enableSetBias = false;
		cfg.enableSetTail = true;
		cfg.enableQuantVector = false;
		cfg.enableSetDefineData = false;
		cfg.iterateMode = IterateMode::ITERATE_MODE_DEFAULT;
		cfg.enableReuse = true;
		cfg.enableUBReuse = true;
		cfg.enableL1CacheUB = false;
		cfg.intraBlockPartSum = false;
		cfg.iterateOrder = IterateOrder::UNDEF;
		cfg.scheduleType = ScheduleType::INNER_PRODUCT;
		cfg.enableDoubleCache = false;
		cfg.isBiasBatch = true;
		cfg.enableStaticPadZeros = false;
		cfg.isA2B2Shared = false;
		cfg.enableKdimReorderLoad = false;
		cfg.isCO1Shared = false;
		return cfg;
	}
	static __aicore__ constexpr MatmulApiStaticTiling MakeStaticTiling() {
		MatmulApiStaticTiling tiling =
				AscendC::GetMatmulApiTiling<AType, BType, CType, BiasType>(MakeMatmulConfig());
		tiling.depthA1 = 1024 / (TN > 256 ? 64 : 128);
		tiling.depthB1 = 8;
		tiling.stepM = 1;
		tiling.stepN = 1;
		tiling.stepKa = 1024 / (TN > 256 ? 64 : 128);
		tiling.stepKb = 4;
		tiling.dbL0A = 2;
		tiling.dbL0B = 2;
		tiling.dbL0C = 1;
		return tiling;
	}
	constexpr static MatmulApiStaticTiling STATIC_TILING = MakeStaticTiling();
	using MM = AscendC::MatmulImpl<AType, BType, CType, BiasType, STATIC_TILING>;
};

}
__aicore__ inline void RgR2FP32ScaleRows(const AscendC::LocalTensor<float> &z,
																				 const AscendC::LocalTensor<float> &s, int32_t rows, int32_t pitch) {
	using namespace AscendC;
	if (pitch % 64 == 0 && rows >= pitch / 64) {
		BinaryRepeatParams rp;
		rp.dstBlkStride = 1;
		rp.src0BlkStride = 1;
		rp.src1BlkStride = 1;
		rp.dstRepStride = pitch / 8;
		rp.src0RepStride = pitch / 8;
		rp.src1RepStride = 0;
		for (int col = 0; col < pitch; col += 64)
			Mul(z[col], z[col], s[col], uint64_t(64), rows, rp);
	} else {
		for (int row = 0; row < rows; ++row)
			Mul(z[row * pitch], z[row * pitch], s, pitch);
	}
}
__aicore__ inline void RgR2FP32GeluInplace(const AscendC::LocalTensor<float> &z,
																					 const AscendC::LocalTensor<float> &u, int32_t cnt) {
	using namespace AscendC;
	Mul(u, z, z, cnt);
	Muls(u, u, -0.07135481627260026f, cnt);
	Adds(u, u, -1.5957691216057308f, cnt);
	Mul(u, u, z, cnt);
	Exp(u, u, cnt);
	Adds(u, u, 1.0f, cnt);
	Div(u, z, u, cnt);
}
namespace rg_r2_staged_tasks {
using namespace AscendC;
struct NativeWork {
	int32_t row, rows, expert, ownedN, panels;
};
template <int DEPTH, int CM, int NB, int BK, int ASLICE>
__aicore__ inline void StageB(int stage, int firstN, bool recycled, int n, int expert,
															AscendC::GlobalTensor<int8_t> &w, AscendC::LocalTensor<int8_t> b1,
															AscendC::GlobalTensor<int8_t> &x, AscendC::LocalTensor<int8_t> a1, int rowBase,
															int validM) {
	using namespace AscendC;
	constexpr int K_STAGES = DEPTH / BK;
	const int bank = stage % NB, panel = firstN + stage / K_STAGES, ks = stage % K_STAGES;
	if (recycled)
		WaitFlag<HardEvent::MTE1_MTE2>(bank);
	if constexpr (ASLICE > 0) {
		if (stage < K_STAGES && (ks * BK) % ASLICE == 0) {
			Nd2NzParams a;
			a.ndNum = 1;
			a.nValue = validM;
			a.dValue = ASLICE;
			a.srcNdMatrixStride = 0;
			a.srcDValue = DEPTH;
			a.dstNzC0Stride = CM;
			a.dstNzNStride = 1;
			a.dstNzMatrixStride = 0;
			DataCopy(a1[ks * BK * CM], x[rowBase * DEPTH + ks * BK], a);
		}
	}
	Nd2NzParams p;
	p.ndNum = 1;
	p.nValue = BK;
	p.dValue = 256;
	p.srcNdMatrixStride = 0;
	p.srcDValue = n;
	p.dstNzC0Stride = BK;
	p.dstNzNStride = 1;
	p.dstNzMatrixStride = 0;
	DataCopy(b1[bank * BK * 256], w[expert * DEPTH * n + ks * BK * n + panel * 256], p);
	SetFlag<HardEvent::MTE2_MTE1>(bank);
}
template <int DEPTH, int CM, int NB, int BK, int ASLICE>
__aicore__ inline void
StageL0(int op, int firstN, int panelCount, int n, int expert, int paddedM, AscendC::GlobalTensor<int8_t> &w,
				AscendC::LocalTensor<int8_t> a1, AscendC::LocalTensor<int8_t> b1, AscendC::LocalTensor<int8_t> a2,
				AscendC::LocalTensor<int8_t> b2, AscendC::GlobalTensor<int8_t> &x, int rowBase, int validM) {
	using namespace AscendC;
	constexpr int K_MICROS = DEPTH / 128, K_STAGES = DEPTH / BK;
	const int local = op & 1, stage = op / (BK / 128), l1bank = stage % NB, q = op % (BK / 128);
	const int micro = op % K_MICROS;
	if (op >= 2)
		WaitFlag<HardEvent::M_MTE1>(local + 6);
	if (q == 0)
		WaitFlag<HardEvent::MTE2_MTE1>(l1bank);
	LoadData3DParamsV2Pro lda;
	lda.channelSize = 128;
	lda.extConfig = (uint64_t(paddedM) << 16) | 128;
	lda.enTranspose = false;
	LoadData(a2[local * CM * 128], a1[micro * CM * 128], lda);
	LoadData2dTransposeParams ldb;
	ldb.startIndex = 0;
	ldb.repeatTimes = 256 / 32;
	ldb.srcStride = BK / 32;
	ldb.dstGap = 1;
	ldb.dstFracGap = 0;
	ldb.addrMode = 0;
	for (int ki = 0; ki < 4; ++ki)
		LoadDataWithTranspose(b2[local * 128 * 256 + ki * 32 * 256], b1[l1bank * BK * 256 + (q * 4 + ki) * 1024],
													ldb);
	SetFlag<HardEvent::MTE1_M>(local + 6);
	if (q + 1 == BK / 128) {
		SetFlag<HardEvent::MTE1_MTE2>(l1bank);
		if (stage + NB < panelCount * K_STAGES)
			StageB<DEPTH, CM, NB, BK, ASLICE>(stage + NB, firstN, true, n, expert, w, b1, x, a1, rowBase, validM);
	}
}
template <int DEPTH, int CM, int SLOTS>
__aicore__ inline void Produce(const NativeWork &work, int n, int core, uint32_t arenaBase,
															 GlobalTensor<int8_t> &x, GlobalTensor<int8_t> &w, GlobalTensor<int32_t> &c,
															 LocalTensor<int8_t> &a2, LocalTensor<int8_t> &b2, LocalTensor<int32_t> &all,
															 int &iter) {
	constexpr int CN = 256, QK = 128, BK = 256, NB = 4, ASLICE = 0, KM = DEPTH / QK;
	static_assert(CM * DEPTH + NB * BK * CN <= 512 * 1024, "L1 views");
	static_assert(SLOTS * CM * CN * 4 <= 128 * 1024, "disjoint INT32 CO1 slots");
	LocalTensor<int8_t> a1(TPosition::A1, arenaBase, CM * DEPTH);
	LocalTensor<int8_t> b1(TPosition::B1, arenaBase + CM * DEPTH, NB * BK * CN);
	const uint8_t pads[4] = {0, 0, 0, 0};
	SetFmatrix(1, CM, pads, FmatrixMode::FMATRIX_LEFT);
	const int row = work.row, rows = work.rows, ei = work.expert, padded = (rows + 15) / 16 * 16;
	const int owned = work.ownedN, count = work.panels;
	for (int initial = 0; initial < NB && initial < count * (DEPTH / BK); ++initial)
		StageB<DEPTH, CM, NB, BK, ASLICE>(initial, owned, false, n, ei, w, b1, x, a1, row, rows);
	StageL0<DEPTH, CM, NB, BK, ASLICE>(0, owned, count, n, ei, padded, w, a1, b1, a2, b2, x, row, rows);
	StageL0<DEPTH, CM, NB, BK, ASLICE>(1, owned, count, n, ei, padded, w, a1, b1, a2, b2, x, row, rows);
	for (int panel = 0; panel < count; ++panel) {
		const int slot = SLOTS == 2 ? (iter & 1) : 0;
		auto acc = all[slot * CM * CN];
		for (int micro = 0; micro < KM; ++micro) {
			const int op = panel * KM + micro, bank = op & 1;
			WaitFlag<HardEvent::MTE1_M>(bank + 6);
			if (micro == 0 && iter >= SLOTS)
				WaitFlag<HardEvent::FIX_M>(slot + 6);
			MmadParams mm;
			mm.m = padded;
			mm.n = CN;
			mm.k = QK;
			mm.cmatrixInitVal = micro == 0;
			mm.unitFlag = 0;
			Mmad(acc, a2[bank * CM * QK], b2[bank * QK * CN], mm);
			SetFlag<HardEvent::M_MTE1>(bank + 6);
			if (op + 2 < count * KM)
				StageL0<DEPTH, CM, NB, BK, ASLICE>(op + 2, owned, count, n, ei, padded, w, a1, b1, a2, b2, x, row,
																					 rows);
		}
		if (panel + 1 == count) {
			WaitFlag<HardEvent::M_MTE1>(6);
			WaitFlag<HardEvent::M_MTE1>(7);
			for (int tail = 0; tail < NB && tail < count * (DEPTH / BK); ++tail)
				WaitFlag<HardEvent::MTE1_MTE2>(tail);
		}
		SetFlag<HardEvent::M_FIX>(7);
		WaitFlag<HardEvent::M_FIX>(7);
		if (iter >= SLOTS)
			CrossCoreWaitFlag(3);
		FixpipeParamsV220 fp;
		fp.nSize = CN;
		fp.mSize = rows;
		fp.srcStride = padded;
		fp.dstStride = CN;
		fp.reluEn = false;
		fp.quantPre = QuantMode_t::NoQuant;
		fp.unitFlag = 0;
		Fixpipe<int32_t, int32_t, CFG_ROW_MAJOR>(c[core * 128 * CN + slot * CM * CN], acc, fp);
		CrossCoreSetFlag<2, PIPE_FIX>(5);
		SetFlag<HardEvent::FIX_M>(6 + slot);
		++iter;
	}
}
template <int DEPTH>
__aicore__ inline void PairStageB(int stage, int owned, int count, bool reuse, int n, const NativeWork &work,
																	GlobalTensor<int8_t> &x, GlobalTensor<int8_t> &w, LocalTensor<int8_t> &a1,
																	LocalTensor<int8_t> &b1) {
	constexpr int CM = 64, BK = 256, CN = 512, NB = 3, KS = DEPTH / BK;
	const int bank = stage % NB, pair = stage / KS, ks = stage % KS;
	if (reuse)
		WaitFlag<HardEvent::MTE1_MTE2>(bank);
	Nd2NzParams b;
	b.ndNum = 1;
	b.nValue = BK;
	b.dValue = CN;
	b.srcNdMatrixStride = 0;
	b.srcDValue = n;
	b.dstNzC0Stride = BK;
	b.dstNzNStride = 1;
	b.dstNzMatrixStride = 0;
	DataCopy(b1[bank * BK * CN], w[work.expert * DEPTH * n + ks * BK * n + (owned + 2 * pair) * 256], b);
	SetFlag<HardEvent::MTE2_MTE1>(bank);
}
template <int DEPTH>
__aicore__ inline void PairStageL0(int op, int owned, int count, int n, const NativeWork &work, int padded,
																	 GlobalTensor<int8_t> &x, GlobalTensor<int8_t> &w, LocalTensor<int8_t> &a1,
																	 LocalTensor<int8_t> &b1, LocalTensor<int8_t> &a2,
																	 LocalTensor<int8_t> &b2) {
	constexpr int CM = 64, CN = 256, BK = 256, NB = 3, KM = DEPTH / 128, KS = DEPTH / BK;
	const int half = op & 1, micro = (op / 2) % KM, abank = micro & 1, stage = op / 4, bank = stage % NB,
						q = (op / 2) & 1;
	if (op >= 2)
		WaitFlag<HardEvent::M_MTE1>(6 + half);
	if (q == 0 && half == 0)
		WaitFlag<HardEvent::MTE2_MTE1>(bank);
	if (half == 0) {
		LoadData3DParamsV2Pro a;
		a.channelSize = 128;
		a.extConfig = (uint64_t(padded) << 16) | 128;
		a.enTranspose = false;
		LoadData(a2[abank * CM * 128], a1[micro * CM * 128], a);
	}
	LoadData2dTransposeParams b;
	b.startIndex = 0;
	b.repeatTimes = 8;
	b.srcStride = BK / 32;
	b.dstGap = 1;
	b.dstFracGap = 0;
	b.addrMode = 0;
	for (int ki = 0; ki < 4; ++ki)
		LoadDataWithTranspose(b2[half * 128 * CN + ki * 32 * CN],
													b1[bank * BK * 512 + half * BK * CN + (q * 4 + ki) * 1024], b);
	SetFlag<HardEvent::MTE1_M>(6 + half);
	if (q == 1 && half == 1) {
		SetFlag<HardEvent::MTE1_MTE2>(bank);
		if (stage + NB < count * KS)
			PairStageB<DEPTH>(stage + NB, owned, count, true, n, work, x, w, a1, b1);
	}
}
template <int DEPTH>
__aicore__ inline void ProducePairs(const NativeWork &work, int n, int core, uint32_t arena,
																		GlobalTensor<int8_t> &x, GlobalTensor<int8_t> &w,
																		GlobalTensor<int32_t> &c, LocalTensor<int8_t> &a2,
																		LocalTensor<int8_t> &b2, LocalTensor<int32_t> &all, int &iter) {
	constexpr int CM = 64, CN = 256, NB = 3, BK = 256, KM = DEPTH / 128, KS = DEPTH / BK;
	static_assert(CM * DEPTH + NB * BK * 512 <= 512 * 1024, "wide B supply arena");
	LocalTensor<int8_t> a1(TPosition::A1, arena, CM * DEPTH);
	LocalTensor<int8_t> b1(TPosition::B1, arena + CM * DEPTH, NB * BK * 512);
	const uint8_t pads[4] = {0, 0, 0, 0};
	SetFmatrix(1, CM, pads, FmatrixMode::FMATRIX_LEFT);
	const int count = work.panels / 2, padded = (work.rows + 15) / 16 * 16, owned = work.ownedN;
	for (int s = 0; s < NB && s < count * KS; ++s)
		PairStageB<DEPTH>(s, owned, count, false, n, work, x, w, a1, b1);
	PairStageL0<DEPTH>(0, owned, count, n, work, padded, x, w, a1, b1, a2, b2);
	PairStageL0<DEPTH>(1, owned, count, n, work, padded, x, w, a1, b1, a2, b2);
	for (int pair = 0; pair < count; ++pair) {
		const int baseIter = iter;
		for (int micro = 0; micro < KM; ++micro) {
			for (int half = 0; half < 2; ++half) {
				const int op = (pair * KM + micro) * 2 + half, slot = (baseIter + half) & 1;
				WaitFlag<HardEvent::MTE1_M>(6 + half);
				if (micro == 0 && baseIter + half >= 2)
					WaitFlag<HardEvent::FIX_M>(6 + slot);
				MmadParams mm;
				mm.m = padded;
				mm.n = CN;
				mm.k = 128;
				mm.cmatrixInitVal = micro == 0;
				mm.unitFlag = 0;
				Mmad(all[slot * CM * CN], a2[(micro & 1) * CM * 128], b2[half * 128 * CN], mm);
				SetFlag<HardEvent::M_MTE1>(6 + half);
				if (op + 2 < count * KM * 2)
					PairStageL0<DEPTH>(op + 2, owned, count, n, work, padded, x, w, a1, b1, a2, b2);
			}
		}
		if (pair + 1 == count) {
			WaitFlag<HardEvent::M_MTE1>(6);
			WaitFlag<HardEvent::M_MTE1>(7);
			for (int s = 0; s < NB && s < count * KS; ++s)
				WaitFlag<HardEvent::MTE1_MTE2>(s);
		}
		SetFlag<HardEvent::M_FIX>(7);
		WaitFlag<HardEvent::M_FIX>(7);
		for (int half = 0; half < 2; ++half) {
			const int slot = iter & 1;
			if (iter >= 2)
				CrossCoreWaitFlag(3);
			FixpipeParamsV220 f;
			f.nSize = CN;
			f.mSize = work.rows;
			f.srcStride = padded;
			f.dstStride = CN;
			f.reluEn = false;
			f.quantPre = QuantMode_t::NoQuant;
			f.unitFlag = 0;
			Fixpipe<int32_t, int32_t, CFG_ROW_MAJOR>(c[core * 128 * CN + slot * CM * CN], all[slot * CM * CN], f);
			CrossCoreSetFlag<2, PIPE_FIX>(5);
			SetFlag<HardEvent::FIX_M>(6 + slot);
			++iter;
		}
	}
}

template <int SLOTS> struct Config {
	using Base = rg_r2_fp32_config::Config<64, 256>;
	using AType = typename Base::AType;
	using BType = typename Base::BType;
	using CType = typename Base::CType;
	using BiasType = typename Base::BiasType;
	static __aicore__ constexpr MatmulApiStaticTiling MakeTiling() {
		auto t = Base::MakeStaticTiling();
		t.dbL0C = SLOTS;
		return t;
	}
	constexpr static MatmulApiStaticTiling TILING = MakeTiling();
	using MM = AscendC::MatmulImpl<AType, BType, CType, BiasType, TILING>;
};

__aicore__ inline void StageRegular(AscendC::TQue<AscendC::TPosition::VECIN, 2> &cq,
																		AscendC::TQue<AscendC::TPosition::VECIN, 2> &sq,
																		AscendC::GlobalTensor<int32_t> &cg, AscendC::GlobalTensor<float> &sg,
																		int32_t core, int32_t seq, int32_t first, int32_t rows, int32_t expert,
																		int32_t n, int32_t panel) {
	using namespace AscendC;
	constexpr int TN = 256;
	auto s = sq.AllocTensor<float>();
	DataCopy(s, sg[expert * n + panel * TN], TN);
	sq.EnQue(s);
	CrossCoreWaitFlag(5);
	auto value = cq.AllocTensor<int32_t>();
	DataCopy(value, cg[(core * 2 + (seq & 1)) * 64 * TN + first * TN], rows * TN);
	cq.EnQue(value);
	CrossCoreSetFlag<2, PIPE_MTE2>(3);
}

__aicore__ inline void FinalCastND(AscendC::LocalTensor<half> &out, AscendC::LocalTensor<float> &u,
																	 int32_t panel, int32_t rows, int32_t pitch) {
	using namespace AscendC;
	constexpr int TN = 256;
	UnaryRepeatParams rp;
	rp.dstBlkStride = 1;
	rp.srcBlkStride = 1;
	rp.dstRepStride = pitch * sizeof(half) / 32;
	rp.srcRepStride = TN * sizeof(float) / 32;
	for (int32_t col = 0; col < TN; col += 64)
		Cast(out[panel * TN + col], u[col], RoundMode::CAST_NONE, uint64_t(64), static_cast<uint8_t>(rows), rp);
	PipeBarrier<PIPE_V>();
}

template <int P, bool TASK_DESCRIPTORS>
__aicore__ inline void Compute(GM_ADDR x, GM_ADDR w, GM_ADDR scale, GM_ADDR groups, GM_ADDR y,
															 GM_ADDR workspace, int32_t m, int32_t e, int32_t metaElements) {
	using namespace AscendC;
	using namespace gmm_common;
	constexpr bool COALESCE = true, LATE_PREFETCH = true;
	constexpr int MAX_META_BYTES = 9280;
	constexpr int TM = 64, TN = 256, ROWS = 32, ELEMS = ROWS * TN, GROUP = P, OUT_DEPTH = 1;
	static_assert(P >= 2 && P <= 4, "Supported grouped FP32 family");
	static_assert(2 * ELEMS * 4 + ELEMS * 4 + OUT_DEPTH * ROWS * GROUP * TN * 2 + 2 * TN * 4 + 1024 + 9280 <=
										192 * 1024,
								"All live AIV buffers");
	static_assert(2 * ELEMS * 4 + ELEMS * 4 + OUT_DEPTH * ROWS * GROUP * TN * 2 + 2 * TN * 4 <= 192 * 1024,
								"Live UB including scratch lifecycle");
	const int32_t n = P * TN, ng = (P + GROUP - 1) / GROUP, core = CoreGroupIndex(), sub = SubCoreIndex(),
								cores = GetBlockNum();
	GlobalTensor<int8_t> xg, wg;
	GlobalTensor<float> sg;
	GlobalTensor<int64_t> gl;
	GlobalTensor<int32_t> cg;
	GlobalTensor<half> yg;
	xg.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t *>(x), m * 1024);
	wg.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t *>(w), e * 1024 * n);
	sg.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(scale), e * n);
	gl.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t *>(groups), e);
	cg.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t *>(workspace), cores * 2 * TM * TN);
	yg.SetGlobalBuffer(reinterpret_cast<__gm__ half *>(y), m * n);
	GlobalTensor<uint64_t> metadataGm;
	GlobalTensor<int8_t> metadataBytesGm;
	{
		auto metaAddress = reinterpret_cast<__gm__ int8_t *>(workspace) + cores * 2 * TM * TN * 4;
		metadataGm.SetGlobalBuffer(reinterpret_cast<__gm__ uint64_t *>(metaAddress), cores * metaElements);
		metadataBytesGm.SetGlobalBuffer(metaAddress, cores * metaElements * 8);
	}
	TPipe pipe;
	if ASCEND_IS_AIC {
		TBuf<TPosition::A1> arenaBuffer;
		TBuf<TPosition::A2> a2Buffer;
		TBuf<TPosition::B2> b2Buffer;
		TBuf<TPosition::CO1> cBuffer;
		pipe.InitBuffer(arenaBuffer, 64 * 1024 + 3 * 256 * 512);
		pipe.InitBuffer(a2Buffer, 2 * 64 * 128);
		pipe.InitBuffer(b2Buffer, 2 * 128 * 256);
		pipe.InitBuffer(cBuffer, 2 * 64 * 256 * 4);
		const uint32_t arenaBase = static_cast<uint32_t>(arenaBuffer.Get<int8_t>().GetPhyAddr());
		auto a2 = a2Buffer.Get<int8_t>();
		auto b2 = b2Buffer.Get<int8_t>();
		auto accum = cBuffer.Get<int32_t>();
		int32_t seq = 0;

		{
			const int64_t metadataBase = static_cast<int64_t>(core) * metaElements;

			for (int32_t offset = 0; offset < metaElements; offset += 8)
				DataCacheCleanAndInvalid<uint64_t, CacheLine::SINGLE_CACHE_LINE>(metadataGm[metadataBase + offset]);
			const auto retired = pipe.FetchEventID<HardEvent::S_MTE2>();
			SetFlag<HardEvent::S_MTE2>(retired);
			WaitFlag<HardEvent::S_MTE2>(retired);
			pipe.ReleaseEventID<HardEvent::S_MTE2>(retired);
			CrossCoreSetFlag<2, PIPE_MTE2>(8);
			CrossCoreWaitFlag(9);
			const int32_t taskCount = metadataGm.GetValue(metadataBase);
			for (int32_t descriptor = 0; descriptor < taskCount; ++descriptor) {
				const uint64_t token = metadataGm.GetValue(metadataBase + descriptor + 1);
				const int32_t expert = token & 127, owned = (token >> 29) & 3, taskPanels = ((token >> 31) & 3) + 1;
				int32_t row = (token >> 7) & 65535;
				const int32_t end = row + ((token >> 23) & 63) + 1, slabEnd = end;
				while (row < slabEnd) {
					const int32_t stop = end < slabEnd ? end : slabEnd, count = stop - row;
					LocalTensor<int8_t> residentA(TPosition::A1, arenaBase, 64 * 1024);
					Nd2NzParams ap;
					ap.ndNum = 1;
					ap.nValue = count;
					ap.dValue = 1024;
					ap.srcNdMatrixStride = 0;
					ap.srcDValue = 1024;
					ap.dstNzC0Stride = 64;
					ap.dstNzNStride = 1;
					ap.dstNzMatrixStride = 0;
					DataCopy(residentA, xg[row * 1024], ap);
					NativeWork work{row, count, expert, owned, taskPanels / 2 * 2};
					if (work.panels)
						ProducePairs<1024>(work, n, core, arenaBase, xg, wg, cg, a2, b2, accum, seq);
					if (taskPanels & 1) {
						work.ownedN = owned + work.panels;
						work.panels = 1;
						Produce<1024, 64, 2>(work, n, core, arenaBase, xg, wg, cg, a2, b2, accum, seq);
					}
					row = stop;
				}
			}
		}
		for (int slot = 0; slot < (seq < 2 ? seq : 2); ++slot)
			WaitFlag<HardEvent::FIX_M>(6 + slot);
	} else {
		TQue<TPosition::VECIN, 2> cq, sq;
		TQue<TPosition::VECOUT, OUT_DEPTH> oq;
		TBuf<TPosition::VECCALC> ub;
		pipe.InitBuffer(cq, 2, ELEMS * 4);
		pipe.InitBuffer(oq, OUT_DEPTH, ROWS * GROUP * TN * 2);
		pipe.InitBuffer(ub, ELEMS * 4);
		pipe.InitBuffer(sq, 2, TN * 4);
		auto u = ub.Get<float>();
		int32_t seq = 0;
		TBuf<TPosition::VECCALC> glBuffer;
		pipe.InitBuffer(glBuffer, 1024);
		auto glValues = glBuffer.Get<int64_t>();
		GlobalTensor<int8_t> glBytes;
		glBytes.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t *>(groups), e * 8);
		DataCopyExtParams gcp{};
		gcp.blockCount = 1;
		gcp.blockLen = e * 8;
		DataCopyPadExtParams<int8_t> gpad{true, 0, 0, 0};
		DataCopyPad(glValues.ReinterpretCast<int8_t>(), glBytes, gcp, gpad);
		const auto glReady = pipe.FetchEventID<HardEvent::MTE2_S>();
		SetFlag<HardEvent::MTE2_S>(glReady);
		WaitFlag<HardEvent::MTE2_S>(glReady);
		pipe.ReleaseEventID<HardEvent::MTE2_S>(glReady);
		int32_t actualGroupEnds[128], actualTileEnds[128];
		int32_t previous = 0, totalRowTiles = 0;
		for (int32_t expertIndex = 0; expertIndex < e; ++expertIndex) {
			const int32_t actualEnd = static_cast<int32_t>(glValues.GetValue(expertIndex));
			totalRowTiles += (actualEnd - previous + TM - 1) / TM;
			actualGroupEnds[expertIndex] = actualEnd;
			actualTileEnds[expertIndex] = totalRowTiles;
			previous = actualEnd;
		}
		const int32_t totalPanels = totalRowTiles * P;
		const int32_t rangeBegin = static_cast<int64_t>(totalPanels) * core / cores;
		const int32_t rangeEnd = static_cast<int64_t>(totalPanels) * (core + 1) / cores;
		{
			TBuf<TPosition::VECCALC> metadataBuffer;
			pipe.InitBuffer(metadataBuffer, metaElements * 8);
			auto descriptors = metadataBuffer.Get<uint64_t>();
			int32_t taskCount = 0;
			for (int32_t task = rangeBegin; task < rangeEnd;) {
				const int32_t slab = task / P, owned = task % P;
				const int32_t available = P - owned < rangeEnd - task ? P - owned : rangeEnd - task;
				const int32_t taskPanels = COALESCE ? available : 1;
				task += taskPanels;
				int32_t lo = 0, hi = e;
				while (lo < hi) {
					const int32_t mid = (lo + hi) / 2;
					if (actualTileEnds[mid] <= slab)
						lo = mid + 1;
					else
						hi = mid;
				}
				const int32_t expert = lo;
				const int32_t expertStart = expert ? actualGroupEnds[expert - 1] : 0;
				const int32_t firstExpertTile = expert ? actualTileEnds[expert - 1] : 0;
				int32_t row = expertStart + (slab - firstExpertTile) * TM;
				const int32_t end = actualGroupEnds[expert];
				const int32_t slabEnd = row + TM < end ? row + TM : end;
				const int32_t rows = slabEnd - row;
				const uint64_t token = static_cast<uint64_t>(expert) | (static_cast<uint64_t>(row) << 7) |
															 (static_cast<uint64_t>(rows - 1) << 23) |
															 (static_cast<uint64_t>(owned) << 29) |
															 (static_cast<uint64_t>(taskPanels - 1) << 31);
				descriptors.SetValue(++taskCount, token);
			}
			descriptors.SetValue(0, static_cast<uint64_t>(taskCount));
			const int32_t publishedElements = ((taskCount + 1 + 7) / 8) * 8;
			for (int32_t i = taskCount + 1; i < publishedElements; ++i)
				descriptors.SetValue(i, 0);
			CrossCoreWaitFlag(8);
			if (sub == 0) {
				const auto visible = pipe.FetchEventID<HardEvent::S_MTE3>();
				SetFlag<HardEvent::S_MTE3>(visible);
				WaitFlag<HardEvent::S_MTE3>(visible);
				pipe.ReleaseEventID<HardEvent::S_MTE3>(visible);
				DataCopy(metadataBytesGm[core * metaElements * 8], descriptors.ReinterpretCast<int8_t>(),
								 publishedElements * 8);
			}
			CrossCoreSetFlag<2, PIPE_MTE3>(9);
			for (int32_t descriptor = 0; descriptor < taskCount; ++descriptor) {
				const uint64_t token = descriptors.GetValue(descriptor + 1);
				const int32_t expert = token & 127, owned = (token >> 29) & 3, taskPanels = ((token >> 31) & 3) + 1;
				int32_t row = (token >> 7) & 65535;
				const int32_t end = row + ((token >> 23) & 63) + 1, slabEnd = end;
				while (row < slabEnd) {
					const int32_t stop = end < slabEnd ? end : slabEnd, tileRows = stop - row;
					const int32_t per = (tileRows + 1) / 2, first = sub * per,
												rows = first < tileRows ? (tileRows - first < per ? tileRows - first : per) : 0;
					const int32_t panels = taskPanels, pitch = panels * TN;
					if (rows) {
						auto out = oq.template AllocTensor<half>();
						StageRegular(cq, sq, cg, sg, core, seq, first, rows, expert, n, owned);
						for (int32_t panel = 0; panel < panels; ++panel) {
							auto s = sq.DeQue<float>();
							auto value = cq.DeQue<int32_t>();
							{
							}
							auto z = value.ReinterpretCast<float>();
							const int32_t total = rows * TN;
							Cast(z, value, RoundMode::CAST_NONE, total);
							PipeBarrier<PIPE_V>();
							RgR2FP32ScaleRows(z, s, rows, TN);
							PipeBarrier<PIPE_V>();
							sq.FreeTensor(s);
							{
								if (panel + 1 < panels)
									StageRegular(cq, sq, cg, sg, core, seq + 1, first, rows, expert, n, owned + panel + 1);
							}
							RgR2FP32GeluInplace(z, u, total);
							PipeBarrier<PIPE_V>();
							FinalCastND(out, u, panel, rows, pitch);
							cq.FreeTensor(value);
							++seq;
						}
						oq.EnQue(out);
						out = oq.template DeQue<half>();
						DataCopyExtParams op{};
						op.blockCount = rows;
						op.blockLen = pitch * sizeof(half);
						op.dstStride = (n - pitch) * sizeof(half);
						DataCopyPad(yg[(row + first) * n + owned * TN], out, op);
						oq.FreeTensor(out);
					} else {
						for (int32_t panel = 0; panel < panels; ++panel) {
							CrossCoreWaitFlag(5);
							CrossCoreSetFlag<2, PIPE_MTE2>(3);
							++seq;
						}
					}
					row = stop;
				}
			}
		}
	}
}

}
template <int P>
__global__ __mix__(1, 2)
		__attribute__((aligned(64))) void RgR3StagedExactSlabs(GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR g,
																													 GM_ADDR y, GM_ADDR c, int32_t m, int32_t e,
																													 int32_t metaElements) {
	rg_r3_staged_slabs::Compute<P>(x, w, s, g, y, c, m, e, metaElements);
}
template <int P>
__global__ __mix__(1, 2)
		__attribute__((aligned(64))) void RgR2StagedTasks(GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR g, GM_ADDR y,
																											GM_ADDR c, int32_t m, int32_t e, int32_t metaElements) {
	rg_r2_staged_tasks::Compute<P, true>(x, w, s, g, y, c, m, e, metaElements);
}
namespace c1_joint_raw_y_consumer {
using namespace AscendC;
constexpr int COLS = 256;
constexpr int READER_ROWS = 64;
constexpr int C_ELEMS = READER_ROWS * COLS;
constexpr int MATH_ROWS = 16;
constexpr int MATH_ELEMS = MATH_ROWS * COLS;

struct Lifetimes {
	bool c0VectorReader = false;
	bool heldMte3Reader = false;
	bool c1Mte3Reader = false;
};

__aicore__ inline void StagePanel(int panel, int row, int first, int rows, int expert, int ownedN, int n,
																	GlobalTensor<int32_t> &raw, GlobalTensor<float> &scales,
																	LocalTensor<int32_t> value, LocalTensor<float> scale, Lifetimes &live) {
	if (panel == 0 && live.c0VectorReader) {
		// Only CQ0 and scale0 wait for their own previous Vector readers.
		WaitFlag<HardEvent::V_MTE2>(6);
		live.c0VectorReader = false;
	}
	if (panel == 1 && live.c1Mte3Reader) {
		// CQ1 contains the preceding final half output. CQ0 did not wait for it.
		WaitFlag<HardEvent::MTE3_MTE2>(7);
		live.c1Mte3Reader = false;
	}
	DataCopy(scale, scales[expert * n + (ownedN + panel) * COLS], COLS);
	CrossCoreWaitFlag(5);
	if (rows > 0) {
		DataCopyExtParams cp{};
		cp.blockCount = rows;
		cp.blockLen = COLS * sizeof(int32_t);
		cp.srcStride = (n / 2 - COLS) * sizeof(int32_t);
		DataCopyPadExtParams<int32_t> pad{true, 0, 0, 0};
		DataCopyPad(value, raw[((row + first) * n + ownedN * COLS) / 2], cp, pad);
	}
	// Both AIV readers acknowledge the original complete N256 GM generation.
	CrossCoreSetFlag<2, PIPE_MTE2>(3);
	if (panel == 0) {
		SetFlag<HardEvent::MTE2_V>(6);
	} else {
		SetFlag<HardEvent::MTE2_V>(7);
		// This reader's raw Y rows become writable after the actual final C read.
		SetFlag<HardEvent::MTE2_MTE3>(6);
	}
}

template <bool FIRST>
__aicore__ inline void IssueMath(LocalTensor<int32_t> value, LocalTensor<float> scale,
																 LocalTensor<float> scratch, LocalTensor<half> held, int rows,
																 Lifetimes &live) {
	WaitFlag<HardEvent::MTE2_V>(FIRST ? 6 : 7);
	if (rows > 0) {
		auto z = value.ReinterpretCast<float>();
		Cast(z, value, RoundMode::CAST_NONE, rows * COLS);
		PipeBarrier<PIPE_V>();
		RgC1FP32ScaleRows(z, scale, rows, COLS);
		for (int row = 0; row < rows; row += MATH_ROWS) {
			const int count = (rows - row < MATH_ROWS ? rows - row : MATH_ROWS) * COLS;
			RgC1FP32GeluInplace(z[row * COLS], scratch, count);
			PipeBarrier<PIPE_V>();
			if constexpr (FIRST) {
				if (row == 0 && live.heldMte3Reader) {
					// Current CQ arithmetic can run before the previous held output retires.
					WaitFlag<HardEvent::MTE3_V>(6);
					live.heldMte3Reader = false;
				}
				if (row + MATH_ROWS >= rows) {
					// Div is the final CQ0/scale0 reader. The following Cast reads scratch.
					SetFlag<HardEvent::V_MTE2>(6);
					live.c0VectorReader = true;
				}
				Cast(held[row * COLS], scratch, RoundMode::CAST_NONE, count);
			} else {
				// The compact half destination overwrites only already-consumed z rows.
				Cast(value.ReinterpretCast<half>()[row * COLS], scratch, RoundMode::CAST_NONE, count);
			}
			// Scratch is one independent 16-row FP32 allocation, reused per chunk.
			PipeBarrier<PIPE_V>();
		}
	} else if constexpr (FIRST) {
		// A zero-row reader still consumes every generation before issuing the next.
		if (live.heldMte3Reader) {
			WaitFlag<HardEvent::MTE3_V>(6);
			live.heldMte3Reader = false;
		}
		SetFlag<HardEvent::V_MTE2>(6);
		live.c0VectorReader = true;
	}
	SetFlag<HardEvent::V_MTE3>(FIRST ? 6 : 7);
}

__aicore__ inline void StoreHeld(GlobalTensor<half> &y, LocalTensor<half> held, int row, int first, int rows,
																 int ownedN, int n, Lifetimes &live) {
	WaitFlag<HardEvent::V_MTE3>(6);
	WaitFlag<HardEvent::MTE2_MTE3>(6);
	if (rows > 0) {
		DataCopyExtParams out{};
		out.blockCount = rows;
		out.blockLen = COLS * sizeof(half);
		out.dstStride = (n - COLS) * sizeof(half);
		DataCopyPad(y[(row + first) * n + ownedN * COLS], held, out);
	}
	SetFlag<HardEvent::MTE3_V>(6);
	live.heldMte3Reader = true;
}

__aicore__ inline void StoreLast(GlobalTensor<half> &y, LocalTensor<int32_t> value, int row, int first,
																 int rows, int ownedN, int n, Lifetimes &live) {
	WaitFlag<HardEvent::V_MTE3>(7);
	if (rows > 0) {
		DataCopyExtParams out{};
		out.blockCount = rows;
		out.blockLen = COLS * sizeof(half);
		out.dstStride = (n - COLS) * sizeof(half);
		DataCopyPad(y[(row + first) * n + (ownedN + 1) * COLS], value.ReinterpretCast<half>(), out);
	}
	SetFlag<HardEvent::MTE3_MTE2>(7);
	live.c1Mte3Reader = true;
}

__aicore__ inline void VectorPrefetch(TPipe &pipe, GlobalTensor<int64_t> &gl, GlobalTensor<int32_t> &raw,
																			GlobalTensor<float> &scales, GlobalTensor<half> &y, int m, int n, int e,
																			int core, int sub, int cores) {
	constexpr int UB_BYTES = 2 * C_ELEMS * sizeof(int32_t) + 2 * COLS * sizeof(float) +
													 MATH_ELEMS * sizeof(float) + C_ELEMS * sizeof(half);
	static_assert(UB_BYTES == 178 * 1024 && UB_BYTES <= 192 * 1024,
								"Independent double C, double scale, FP32 scratch and held half");
	TBuf<TPosition::VECCALC> cBuffer, scaleBuffer, mathBuffer, heldBuffer;
	pipe.InitBuffer(cBuffer, 2 * C_ELEMS * sizeof(int32_t));
	pipe.InitBuffer(scaleBuffer, 2 * COLS * sizeof(float));
	pipe.InitBuffer(mathBuffer, MATH_ELEMS * sizeof(float));
	pipe.InitBuffer(heldBuffer, C_ELEMS * sizeof(half));
	auto c0 = cBuffer.Get<int32_t>();
	auto c1 = c0[C_ELEMS];
	auto s0 = scaleBuffer.Get<float>();
	auto s1 = s0[COLS];
	auto scratch = mathBuffer.Get<float>();
	auto held = heldBuffer.Get<half>();
	Lifetimes live;
	const int groups = n / 512;
	const int tasks = ((m + 127) / 128) * groups;
	for (int task = core; task < tasks; task += cores) {
		const int slab = task / groups;
		const int ownedN = (task % groups) * 2;
		int start = slab * 128;
		const int slabEnd = start + 128 < m ? start + 128 : m;
		int lo = 0, hi = e;
		while (lo < hi) {
			const int mid = (lo + hi) / 2;
			if (gl.GetValue(mid) <= start)
				lo = mid + 1;
			else
				hi = mid;
		}
		int expert = lo;
		int groupEnd = gl.GetValue(expert);
		while (start < slabEnd) {
			const int end = groupEnd < slabEnd ? groupEnd : slabEnd;
			const int workRows = end - start;
			const int rowsPerSub = (workRows + 1) / 2;
			const int first = sub * rowsPerSub;
			const int rows = first < workRows ? (workRows - first < rowsPerSub ? workRows - first : rowsPerSub) : 0;
			// CQ0 is independent of the previous Work's CQ1 MTE3 reader.
			StagePanel(0, start, first, rows, expert, ownedN, n, raw, scales, c0, s0, live);
			IssueMath<true>(c0, s0, scratch, held, rows, live);
			// The real current FP32 chain exists before the S-side next-ready wait.
			// This copy uses CQ1 while current Vector operations read CQ0/scratch.
			StagePanel(1, start, first, rows, expert, ownedN, n, raw, scales, c1, s1, live);
			// Raw Y's last reader has retired; held can flush during C1 arithmetic.
			StoreHeld(y, held, start, first, rows, ownedN, n, live);
			IssueMath<false>(c1, s1, scratch, held, rows, live);
			StoreLast(y, c1, start, first, rows, ownedN, n, live);
			start = end;
			while (start < slabEnd && groupEnd <= start) {
				++expert;
				groupEnd = gl.GetValue(expert);
			}
		}
	}
	if (live.c0VectorReader)
		WaitFlag<HardEvent::V_MTE2>(6);
	if (live.heldMte3Reader)
		WaitFlag<HardEvent::MTE3_V>(6);
	if (live.c1Mte3Reader)
		WaitFlag<HardEvent::MTE3_MTE2>(7);
	PipeBarrier<PIPE_MTE3>();
}
}
namespace rg_c1_B_granularity128 {
template <int DEPTH, int NB, int BK>
__aicore__ inline void StageB(int stage, int firstN, bool recycled, int n, int expert,
															AscendC::GlobalTensor<int8_t> &w, AscendC::LocalTensor<int8_t> b1) {
	using namespace AscendC;
	constexpr int K_STAGES = DEPTH / BK;
	const int bank = stage % NB;
	if (recycled)
		WaitFlag<HardEvent::MTE1_MTE2>(bank);
	const int panel = firstN + stage / K_STAGES;
	const int ks = stage % K_STAGES;
	Nd2NzParams p;
	p.ndNum = 1;
	p.nValue = BK;
	p.dValue = 256;
	p.srcNdMatrixStride = 0;
	p.srcDValue = n;
	p.dstNzC0Stride = BK;
	p.dstNzNStride = 1;
	p.dstNzMatrixStride = 0;
	DataCopy(b1[bank * BK * 256], w[expert * DEPTH * n + ks * BK * n + panel * 256], p);
	SetFlag<HardEvent::MTE2_MTE1>(bank);
}

template <int DEPTH, int NB, int BK>
__aicore__ inline void StageL0(int op, int firstN, int panelCount, int n, int expert, int paddedM,
															 AscendC::GlobalTensor<int8_t> &w, AscendC::LocalTensor<int8_t> a1,
															 AscendC::LocalTensor<int8_t> b1, AscendC::LocalTensor<int8_t> a2,
															 AscendC::LocalTensor<int8_t> b2) {
	using namespace AscendC;
	constexpr int K_MICROS = DEPTH / 128, K_STAGES = DEPTH / BK;
	const int local = op & 1, stage = op / (BK / 128), l1bank = stage % NB, q = op % (BK / 128);
	const int micro = op % K_MICROS;
	if (op >= 2)
		WaitFlag<HardEvent::M_MTE1>(local + 6);
	if (q == 0)
		WaitFlag<HardEvent::MTE2_MTE1>(l1bank);
	LoadData3DParamsV2Pro lda;
	lda.channelSize = 128;
	lda.extConfig = (uint64_t(paddedM) << 16) | 128;
	lda.enTranspose = false;
	LoadData(a2[local * 128 * 128], a1[micro * 128 * 128], lda);
	LoadData2dTransposeParams ldb;
	ldb.startIndex = 0;
	ldb.repeatTimes = 256 / 32;
	ldb.srcStride = BK / 32;
	ldb.dstGap = 1;
	ldb.dstFracGap = 0;
	ldb.addrMode = 0;
	for (int ki = 0; ki < 4; ++ki)
		LoadDataWithTranspose(b2[local * 128 * 256 + ki * 32 * 256], b1[l1bank * BK * 256 + (q * 4 + ki) * 1024],
													ldb);
	SetFlag<HardEvent::MTE1_M>(local + 6);
	if (q + 1 == BK / 128) {
		SetFlag<HardEvent::MTE1_MTE2>(l1bank);
		if (stage + NB < panelCount * K_STAGES)
			StageB<DEPTH, NB, BK>(stage + NB, firstN, true, n, expert, w, b1);
	}
}

__aicore__ inline int32_t DivUp32(int32_t a, int32_t b) {
	return (a + b - 1) / b;
}

template <int NB, int BK, int TM, int TN, int ROW_STEP, int PANELS, int GROUPS = 0, int DEPTH = 0,
					int VC = 32, bool RAW_Y = true, bool ANY_GL = false, bool PREFETCH = false,
					bool EARLY_CREDIT = false>
__aicore__ inline void Compute(GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR group_list, GM_ADDR y,
															 GM_ADDR workspace, int32_t runtimeM, int32_t runtimeK, int32_t runtimeN,
															 int32_t runtimeE) {
	constexpr bool C1_SINGLE_SLOT =
			(TM == 128 && TN == 256 && ROW_STEP == 128 && DEPTH > 0 && DEPTH <= 1024 && PANELS >= 2);
	constexpr int32_t tightC = C1_SINGLE_SLOT ? 1 : 0, cSlots = C1_SINGLE_SLOT ? 1 : 2,
										earlyCredit = C1_SINGLE_SLOT ? 1 : 0, afterComputeWait = C1_SINGLE_SLOT ? 1 : 0;
	static_assert(ANY_GL && RAW_Y && DEPTH == 1024 && PANELS >= 2 && PANELS <= 4,
								"This production family has no runtime fallback or separate C allocation");
	const int32_t m = GROUPS > 0 ? GROUPS * ROW_STEP : runtimeM;
	const int32_t e = GROUPS > 0 ? GROUPS : runtimeE;
	const int32_t k = DEPTH > 0 ? DEPTH : runtimeK;
	const int32_t n = PANELS > 0 ? PANELS * TN : runtimeN;
	using Cfg = rg_c1_fp32_config::Config<TM, TN>;
	using MM = typename Cfg::MM;
	constexpr int TILE_M = TM, TILE_N = TN, VEC_CHUNK_M = VC;
	static_assert(10 * VC * TN + 4 * TN <= 192 * 1024, "Compact UB capacity");
	constexpr uint16_t GMM_SYNC_AIV_AIC = 3, GMM_SYNC_AIC_AIV = 5;
	constexpr uint32_t SYNC_MODE2 = 2;
	using namespace gmm_common;
	using namespace AscendC;
	const uint32_t coreNum = static_cast<uint32_t>(GetBlockNum());
	const uint32_t coreIdx = CoreGroupIndex();
	const uint32_t subIdx = SubCoreIndex();
	const int32_t nPad = n;
	const int32_t cPitch = nPad / 2;
	GlobalTensor<int8_t> xGm;
	GlobalTensor<int8_t> wGm;
	GlobalTensor<float> scaleGm;
	GlobalTensor<int64_t> glGm;
	GlobalTensor<int32_t> cGm;
	GlobalTensor<int32_t> rawYGm;
	GlobalTensor<half> yGm;
	xGm.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t *>(x), m * k);
	wGm.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t *>(weight), e * k * n);
	scaleGm.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(scale), e * n);
	glGm.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t *>(group_list), e);
	if constexpr (!RAW_Y)
		cGm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t *>(workspace),
												static_cast<int32_t>(coreNum) * TILE_M * cPitch);
	if constexpr (RAW_Y)
		rawYGm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t *>(y), m * n / 2);
	yGm.SetGlobalBuffer(reinterpret_cast<__gm__ half *>(y), m * n);
	TPipe pipe;
	if ASCEND_IS_AIC {
		constexpr int CM = 128, CN = 256, QK = 128;
		static_assert(NB >= 2 && NB <= 8 && (BK == 128 || BK == 256 || BK == 512), "Native B bank shape");
		static_assert(CM * DEPTH + NB * BK * CN <= 512 * 1024, "Full actual A plus B lookahead fits L1");
		TBuf<TPosition::A1> a1buf;
		TBuf<TPosition::B1> b1buf;
		TBuf<TPosition::A2> a2buf;
		TBuf<TPosition::B2> b2buf;
		TBuf<TPosition::CO1> cbuf;
		pipe.InitBuffer(a1buf, CM * DEPTH);
		pipe.InitBuffer(b1buf, NB * BK * CN);
		pipe.InitBuffer(a2buf, 2 * CM * QK);
		pipe.InitBuffer(b2buf, 2 * QK * CN);
		pipe.InitBuffer(cbuf, CM * CN * sizeof(int32_t));
		auto a1 = a1buf.Get<int8_t>(), b1 = b1buf.Get<int8_t>();
		auto a2 = a2buf.Get<int8_t>(), b2 = b2buf.Get<int8_t>();
		auto acc = cbuf.Get<int32_t>();
		const uint8_t pads[4] = {0, 0, 0, 0};
		SetFmatrix(1, CM, pads, FmatrixMode::FMATRIX_LEFT);
		int32_t iter = 0;
		const int32_t N_TILES = (n + TILE_N - 1) / TILE_N;
		const int32_t GROUP_TILES = N_TILES <= 3 ? N_TILES : 2;
		const int32_t N_GROUPS = (N_TILES + GROUP_TILES - 1) / GROUP_TILES;
		const int32_t TASKS = ((m + ROW_STEP - 1) / ROW_STEP) * N_GROUPS;
		for (int32_t task = coreIdx; task < TASKS; task += coreNum) {
			const int32_t slab = task / N_GROUPS;
			const int32_t ownedN = (task % N_GROUPS) * GROUP_TILES;
			int32_t start = slab * ROW_STEP;
			const int32_t slabEnd = start + ROW_STEP < m ? start + ROW_STEP : m;
			int32_t ei = slab;
			if (ei >= e)
				ei = e - 1;
			int32_t groupStart = ei == 0 ? 0 : glGm.GetValue(ei - 1);
			int32_t groupEnd = glGm.GetValue(ei);
			if (!(groupStart <= start && start < groupEnd)) {
				int32_t lo = 0, hi = e;
				while (lo < hi) {
					const int32_t mid = (lo + hi) / 2;
					if (glGm.GetValue(mid) <= start)
						lo = mid + 1;
					else
						hi = mid;
				}
				ei = lo;
				groupEnd = glGm.GetValue(ei);
			}
			while (start < slabEnd) {
				const int32_t end = groupEnd < slabEnd ? groupEnd : slabEnd;
				const int32_t me = end - start;
				const int32_t mTiles = DivUp32(me, TILE_M);
				const int32_t nTiles = DivUp32(nPad, TILE_N);
				for (int32_t mi = 0; mi < mTiles; ++mi) {
					const int32_t rowBase = start + mi * TILE_M;
					const int32_t curM = (mi == mTiles - 1) ? (me - mi * TILE_M) : TILE_M;
					const int32_t colBase = ownedN * TILE_N;
					const int32_t groupN =
							nPad - colBase < GROUP_TILES * TILE_N ? nPad - colBase : GROUP_TILES * TILE_N;
					const int paddedM = (curM + 15) / 16 * 16;
					Nd2NzParams pa{};
					pa.ndNum = 1;
					pa.nValue = curM;
					pa.dValue = DEPTH;
					pa.srcDValue = DEPTH;
					pa.dstNzC0Stride = CM;
					pa.dstNzNStride = 1;
					DataCopy(a1, xGm[rowBase * DEPTH], pa);
					const int panelCount = groupN / CN;
					constexpr int K_MICROS = DEPTH / QK;
					for (int bank = 0; bank < NB; ++bank)
						StageB<DEPTH, NB, BK>(bank, ownedN, false, n, ei, wGm, b1);
					StageL0<DEPTH, NB, BK>(0, ownedN, panelCount, n, ei, paddedM, wGm, a1, b1, a2, b2);
					StageL0<DEPTH, NB, BK>(1, ownedN, panelCount, n, ei, paddedM, wGm, a1, b1, a2, b2);
					for (int ni = 0; ni < panelCount; ++ni) {
						for (int micro = 0; micro < K_MICROS; ++micro) {
							const int op = ni * K_MICROS + micro, bank = op & 1;
							WaitFlag<HardEvent::MTE1_M>(bank + 6);
							MmadParams mm;
							mm.m = paddedM;
							mm.n = CN;
							mm.k = QK;
							mm.cmatrixInitVal = micro == 0;
							mm.unitFlag = (micro + 1 == K_MICROS) ? 3 : 2;
							Mmad(acc, a2[bank * CM * QK], b2[bank * QK * CN], mm);
							SetFlag<HardEvent::M_MTE1>(bank + 6);
							if (op + 2 < panelCount * K_MICROS)
								StageL0<DEPTH, NB, BK>(op + 2, ownedN, panelCount, n, ei, paddedM, wGm, a1, b1, a2, b2);
						}
						if (iter >= 1)
							CrossCoreWaitFlag(GMM_SYNC_AIV_AIC);
						FixpipeParamsV220 fp;
						fp.nSize = CN;
						fp.mSize = curM;
						fp.srcStride = paddedM;
						fp.dstStride = n / 2;
						fp.reluEn = false;
						fp.quantPre = QuantMode_t::NoQuant;
						fp.deqScalar = 0;
						fp.unitFlag = 3;
						Fixpipe<int32_t, int32_t, CFG_ROW_MAJOR>(rawYGm[(rowBase * n + colBase) / 2], acc, fp);
						CrossCoreSetFlag<SYNC_MODE2, PIPE_FIX>(GMM_SYNC_AIC_AIV);
						if (ni + 1 == panelCount) {
							WaitFlag<HardEvent::M_MTE1>(6);
							WaitFlag<HardEvent::M_MTE1>(7);
							for (int bank = 0; bank < NB; ++bank)
								WaitFlag<HardEvent::MTE1_MTE2>(bank);
						}
						++iter;
					}
				}
				start = end;
				while (start < slabEnd && groupEnd <= start) {
					++ei;
					groupEnd = glGm.GetValue(ei);
				}
			}
		}
		if (iter > 0) {
			SetFlag<HardEvent::FIX_M>(6);
			WaitFlag<HardEvent::FIX_M>(6);
		}
	} else {
		static_assert(PANELS == 2 || PANELS == 4, "Natural two-panel output owners");
		static_assert(VC == 64 && TM == 128 && TN == 256 && ROW_STEP == 128 && DEPTH == 1024,
									"Original469 resource family");
		c1_joint_raw_y_consumer::VectorPrefetch(pipe, glGm, rawYGm, scaleGm, yGm, m, n, e, coreIdx, subIdx,
																						coreNum);
	}
}

}
template <int P>
__global__ __mix__(1, 2) __attribute__((aligned(64))) void RgC1B8K128(GM_ADDR x, GM_ADDR w, GM_ADDR s,
																																			GM_ADDR g, GM_ADDR y, int m, int e) {
	rg_c1_B_granularity128::Compute<8, 128, 128, 256, 128, P, 0, 1024, 64, true, true, false, true>(
			x, w, s, g, y, nullptr, m, 1024, P * 256, e);
}
namespace gmm_streamedB_plan {
using namespace AscendC;

using namespace gmm_common;

struct Work {
	int32_t row, rows, expert, ownedN, panels;
};

struct Cursor {
	int32_t task, expert, begin, end, base, limit, rangeEnd;
	int32_t start, slabEnd, panel, plannedN;
	bool initialized;
};

template <int CM = 128>
__aicore__ inline bool NextReal(AscendC::GlobalTensor<int64_t> &gl, int e, int cores, int nTiles, Cursor &c,
																Work &w) {
	if (!c.initialized) {
		int tiles = 0, begin = 0;
		for (int ei = 0; ei < e; ++ei) {
			const int end = gl.GetValue(ei);
			tiles += (end - begin + CM - 1) / CM;
			begin = end;
		}
		const int rowOwnerPanels = ((tiles + cores - 1) / cores) * nTiles;
		const int splitOwnerPanels = (tiles * nTiles + cores - 1) / cores;
		c.plannedN = splitOwnerPanels < rowOwnerPanels ? nTiles : 1;
		nTiles = c.plannedN;
		const int core = c.task, total = tiles * nTiles, each = total / cores, extra = total % cores;
		c.task = core * each + (core < extra ? core : extra);
		c.rangeEnd = c.task + each + (core < extra ? 1 : 0);
		c.expert = 0;
		c.begin = 0;
		c.end = gl.GetValue(0);
		c.base = 0;
		c.limit = ((c.end + CM - 1) / CM) * nTiles;
		c.initialized = true;
	}
	nTiles = c.plannedN;
	if (c.task >= c.rangeEnd)
		return false;
	while (c.task >= c.limit) {
		if (++c.expert >= e)
			return false;
		c.begin = c.end;
		c.end = gl.GetValue(c.expert);
		c.base = c.limit;
		c.limit += ((c.end - c.begin + CM - 1) / CM) * nTiles;
	}
	const int local = c.task - c.base;
	w.row = c.begin + (local / nTiles) * CM;
	w.rows = c.end - w.row < CM ? c.end - w.row : CM;
	w.expert = c.expert;
	w.ownedN = local % nTiles;
	w.panels = nTiles - w.ownedN < c.rangeEnd - c.task ? nTiles - w.ownedN : c.rangeEnd - c.task;
	c.task += w.panels;
	return true;
}

template <int DEPTH, int CM, int NB, int BK, int ASLICE>
__aicore__ inline void StageB(int stage, int firstN, bool recycled, int n, int expert,
															AscendC::GlobalTensor<int8_t> &w, AscendC::LocalTensor<int8_t> b1,
															AscendC::GlobalTensor<int8_t> &x, AscendC::LocalTensor<int8_t> a1, int rowBase,
															int validM, int depth = DEPTH) {
	using namespace AscendC;
	const int K_STAGES = depth / BK;
	const int bank = stage % NB, panel = firstN + stage / K_STAGES, ks = stage % K_STAGES;
	if (recycled)
		WaitFlag<HardEvent::MTE1_MTE2>(bank);
	if constexpr (ASLICE > 0) {
		if (stage < K_STAGES && (ks * BK) % ASLICE == 0) {
			Nd2NzParams a;
			a.ndNum = 1;
			a.nValue = validM;
			a.dValue = ASLICE;
			a.srcNdMatrixStride = 0;
			a.srcDValue = depth;
			a.dstNzC0Stride = CM;
			a.dstNzNStride = 1;
			a.dstNzMatrixStride = 0;
			DataCopy(a1[ks * BK * CM], x[rowBase * depth + ks * BK], a);
		}
	}
	Nd2NzParams p;
	p.ndNum = 1;
	p.nValue = BK;
	p.dValue = 256;
	p.srcNdMatrixStride = 0;
	p.srcDValue = n;
	p.dstNzC0Stride = BK;
	p.dstNzNStride = 1;
	p.dstNzMatrixStride = 0;
	DataCopy(b1[bank * BK * 256], w[expert * depth * n + ks * BK * n + panel * 256], p);
	SetFlag<HardEvent::MTE2_MTE1>(bank);
}

template <int DEPTH, int CM, int NB, int BK, int ASLICE>
__aicore__ inline void StageL0(int op, int firstN, int panelCount, int n, int expert, int paddedM,
															 AscendC::GlobalTensor<int8_t> &w, AscendC::LocalTensor<int8_t> a1,
															 AscendC::LocalTensor<int8_t> b1, AscendC::LocalTensor<int8_t> a2,
															 AscendC::LocalTensor<int8_t> b2, AscendC::GlobalTensor<int8_t> &x, int rowBase,
															 int validM, int depth = DEPTH) {
	using namespace AscendC;
	const int K_MICROS = depth / 128, K_STAGES = depth / BK;
	const int local = op & 1, stage = op / (BK / 128), l1bank = stage % NB, q = op % (BK / 128);
	const int micro = op % K_MICROS;
	if (op >= 2)
		WaitFlag<HardEvent::M_MTE1>(local + 6);
	if (q == 0)
		WaitFlag<HardEvent::MTE2_MTE1>(l1bank);
	LoadData3DParamsV2Pro lda;
	lda.channelSize = 128;
	lda.extConfig = (uint64_t(paddedM) << 16) | 128;
	lda.enTranspose = false;
	LoadData(a2[local * CM * 128], a1[micro * CM * 128], lda);
	LoadData2dTransposeParams ldb;
	ldb.startIndex = 0;
	ldb.repeatTimes = 256 / 32;
	ldb.srcStride = BK / 32;
	ldb.dstGap = 1;
	ldb.dstFracGap = 0;
	ldb.addrMode = 0;
	for (int ki = 0; ki < 4; ++ki)
		LoadDataWithTranspose(b2[local * 128 * 256 + ki * 32 * 256], b1[l1bank * BK * 256 + (q * 4 + ki) * 1024],
													ldb);
	SetFlag<HardEvent::MTE1_M>(local + 6);
	if (q + 1 == BK / 128) {
		SetFlag<HardEvent::MTE1_MTE2>(l1bank);
		if (stage + NB < panelCount * K_STAGES)
			StageB<DEPTH, CM, NB, BK, ASLICE>(stage + NB, firstN, true, n, expert, w, b1, x, a1, rowBase, validM,
																				depth);
	}
}

__aicore__ inline void DrainC(int slots, int iter) {
	for (int s = 0; s < (iter < slots ? iter : slots); ++s) {
		CrossCoreWaitFlag(3 + s);
		WaitFlag<HardEvent::FIX_M>(6 + s);
	}
}

template <int DEPTH, int CM, int SLOTS>
__aicore__ inline void Produce(const Work &work, int n, int core, uint32_t arenaBase, GlobalTensor<int8_t> &x,
															 GlobalTensor<int8_t> &w, GlobalTensor<int32_t> &c, LocalTensor<int8_t> &a2,
															 LocalTensor<int8_t> &b2, LocalTensor<int32_t> &all, int &iter,
															 int depth = DEPTH) {
	constexpr int CN = 256, QK = 128, BK = 256, NB = 4, ASLICE = 512;
	const int KM = depth / QK;
	static_assert(CM * DEPTH + NB * BK * CN <= 512 * 1024, "L1 views");
	static_assert(SLOTS * CM * CN * 4 <= 128 * 1024, "disjoint INT32 CO1 slots");
	LocalTensor<int8_t> a1(TPosition::A1, arenaBase, CM * depth);
	LocalTensor<int8_t> b1(TPosition::B1, arenaBase + CM * depth, NB * BK * CN);
	const uint8_t pads[4] = {0, 0, 0, 0};
	SetFmatrix(1, CM, pads, FmatrixMode::FMATRIX_LEFT);
	const int row = work.row, rows = work.rows, ei = work.expert, padded = (rows + 15) / 16 * 16;
	const int owned = work.ownedN, count = work.panels;
	for (int initial = 0; initial < NB && initial < count * (depth / BK); ++initial)
		StageB<DEPTH, CM, NB, BK, ASLICE>(initial, owned, false, n, ei, w, b1, x, a1, row, rows, depth);
	StageL0<DEPTH, CM, NB, BK, ASLICE>(0, owned, count, n, ei, padded, w, a1, b1, a2, b2, x, row, rows, depth);
	StageL0<DEPTH, CM, NB, BK, ASLICE>(1, owned, count, n, ei, padded, w, a1, b1, a2, b2, x, row, rows, depth);
	for (int panel = 0; panel < count; ++panel) {
		const int slot = SLOTS == 2 ? (iter & 1) : 0;
		auto acc = all[slot * CM * CN];
		for (int micro = 0; micro < KM; ++micro) {
			const int op = panel * KM + micro, bank = op & 1;
			WaitFlag<HardEvent::MTE1_M>(bank + 6);
			if (micro == 0 && iter >= SLOTS)
				WaitFlag<HardEvent::FIX_M>(slot + 6);
			MmadParams mm;
			mm.m = padded;
			mm.n = CN;
			mm.k = QK;
			mm.cmatrixInitVal = micro == 0;
			mm.unitFlag = 0;
			Mmad(acc, a2[bank * CM * QK], b2[bank * QK * CN], mm);
			SetFlag<HardEvent::M_MTE1>(bank + 6);
			if (op + 2 < count * KM)
				StageL0<DEPTH, CM, NB, BK, ASLICE>(op + 2, owned, count, n, ei, padded, w, a1, b1, a2, b2, x, row,
																					 rows, depth);
		}
		if (panel + 1 == count) {
			WaitFlag<HardEvent::M_MTE1>(6);
			WaitFlag<HardEvent::M_MTE1>(7);
			for (int tail = 0; tail < NB && tail < count * (depth / BK); ++tail)
				WaitFlag<HardEvent::MTE1_MTE2>(tail);
		}
		SetFlag<HardEvent::M_FIX>(7);
		WaitFlag<HardEvent::M_FIX>(7);
		if (iter >= SLOTS)
			CrossCoreWaitFlag(3 + slot);
		FixpipeParamsV220 fp;
		fp.nSize = CN;
		fp.mSize = rows;
		fp.srcStride = padded;
		fp.dstStride = CN;
		fp.reluEn = false;
		fp.quantPre = QuantMode_t::NoQuant;
		fp.unitFlag = 0;
		Fixpipe<int32_t, int32_t, CFG_ROW_MAJOR>(c[core * 128 * CN + slot * CM * CN], acc, fp);
		CrossCoreSetFlag<2, PIPE_FIX>(5 + slot);
		SetFlag<HardEvent::FIX_M>(6 + slot);
		++iter;
	}
}

template <int DEPTH>
__aicore__ inline void PairStageB(int stage, int owned, int count, bool reuse, int n, const Work &work,
																	GlobalTensor<int8_t> &x, GlobalTensor<int8_t> &w, LocalTensor<int8_t> &a1,
																	LocalTensor<int8_t> &b1) {
	constexpr int CM = 64, BK = 256, CN = 512, NB = 3, KS = DEPTH / BK;
	const int bank = stage % NB, pair = stage / KS, ks = stage % KS;
	if (reuse)
		WaitFlag<HardEvent::MTE1_MTE2>(bank);
	if (stage < KS && (ks * BK) % 512 == 0) {
		Nd2NzParams a;
		a.ndNum = 1;
		a.nValue = work.rows;
		a.dValue = 512;
		a.srcNdMatrixStride = 0;
		a.srcDValue = DEPTH;
		a.dstNzC0Stride = CM;
		a.dstNzNStride = 1;
		a.dstNzMatrixStride = 0;
		DataCopy(a1[ks * BK * CM], x[work.row * DEPTH + ks * BK], a);
	}
	Nd2NzParams b;
	b.ndNum = 1;
	b.nValue = BK;
	b.dValue = CN;
	b.srcNdMatrixStride = 0;
	b.srcDValue = n;
	b.dstNzC0Stride = BK;
	b.dstNzNStride = 1;
	b.dstNzMatrixStride = 0;
	DataCopy(b1[bank * BK * CN], w[work.expert * DEPTH * n + ks * BK * n + (owned + 2 * pair) * 256], b);
	SetFlag<HardEvent::MTE2_MTE1>(bank);
}

template <int DEPTH>
__aicore__ inline void PairStageL0(int op, int owned, int count, int n, const Work &work, int padded,
																	 GlobalTensor<int8_t> &x, GlobalTensor<int8_t> &w, LocalTensor<int8_t> &a1,
																	 LocalTensor<int8_t> &b1, LocalTensor<int8_t> &a2,
																	 LocalTensor<int8_t> &b2) {
	constexpr int CM = 64, CN = 256, BK = 256, NB = 3, KM = DEPTH / 128, KS = DEPTH / BK;
	const int half = op & 1, micro = (op / 2) % KM, abank = micro & 1, stage = op / 4, bank = stage % NB,
						q = (op / 2) & 1;
	if (op >= 2)
		WaitFlag<HardEvent::M_MTE1>(6 + half);
	if (q == 0 && half == 0)
		WaitFlag<HardEvent::MTE2_MTE1>(bank);
	if (half == 0) {
		LoadData3DParamsV2Pro a;
		a.channelSize = 128;
		a.extConfig = (uint64_t(padded) << 16) | 128;
		a.enTranspose = false;
		LoadData(a2[abank * CM * 128], a1[micro * CM * 128], a);
	}
	LoadData2dTransposeParams b;
	b.startIndex = 0;
	b.repeatTimes = 8;
	b.srcStride = BK / 32;
	b.dstGap = 1;
	b.dstFracGap = 0;
	b.addrMode = 0;
	for (int ki = 0; ki < 4; ++ki)
		LoadDataWithTranspose(b2[half * 128 * CN + ki * 32 * CN],
													b1[bank * BK * 512 + half * BK * CN + (q * 4 + ki) * 1024], b);
	SetFlag<HardEvent::MTE1_M>(6 + half);
	if (q == 1 && half == 1) {
		SetFlag<HardEvent::MTE1_MTE2>(bank);
		if (stage + NB < count * KS)
			PairStageB<DEPTH>(stage + NB, owned, count, true, n, work, x, w, a1, b1);
	}
}

template <int DEPTH>
__aicore__ inline void ProducePairs(const Work &work, int n, int core, uint32_t arena,
																		GlobalTensor<int8_t> &x, GlobalTensor<int8_t> &w,
																		GlobalTensor<int32_t> &c, LocalTensor<int8_t> &a2,
																		LocalTensor<int8_t> &b2, LocalTensor<int32_t> &all, int &iter) {
	constexpr int CM = 64, CN = 256, NB = 3, BK = 256, KM = DEPTH / 128, KS = DEPTH / BK;
	static_assert(CM * DEPTH + NB * BK * 512 <= 512 * 1024, "wide B supply arena");
	LocalTensor<int8_t> a1(TPosition::A1, arena, CM * DEPTH);
	LocalTensor<int8_t> b1(TPosition::B1, arena + CM * DEPTH, NB * BK * 512);
	const uint8_t pads[4] = {0, 0, 0, 0};
	SetFmatrix(1, CM, pads, FmatrixMode::FMATRIX_LEFT);
	const int count = work.panels / 2, padded = (work.rows + 15) / 16 * 16, owned = work.ownedN;
	for (int s = 0; s < NB && s < count * KS; ++s)
		PairStageB<DEPTH>(s, owned, count, false, n, work, x, w, a1, b1);
	PairStageL0<DEPTH>(0, owned, count, n, work, padded, x, w, a1, b1, a2, b2);
	PairStageL0<DEPTH>(1, owned, count, n, work, padded, x, w, a1, b1, a2, b2);
	for (int pair = 0; pair < count; ++pair) {
		const int baseIter = iter;
		for (int micro = 0; micro < KM; ++micro) {
			for (int half = 0; half < 2; ++half) {
				const int op = (pair * KM + micro) * 2 + half, slot = (baseIter + half) & 1;
				WaitFlag<HardEvent::MTE1_M>(6 + half);
				if (micro == 0 && baseIter + half >= 2)
					WaitFlag<HardEvent::FIX_M>(6 + slot);
				MmadParams mm;
				mm.m = padded;
				mm.n = CN;
				mm.k = 128;
				mm.cmatrixInitVal = micro == 0;
				mm.unitFlag = 0;
				Mmad(all[slot * CM * CN], a2[(micro & 1) * CM * 128], b2[half * 128 * CN], mm);
				SetFlag<HardEvent::M_MTE1>(6 + half);
				if (op + 2 < count * KM * 2)
					PairStageL0<DEPTH>(op + 2, owned, count, n, work, padded, x, w, a1, b1, a2, b2);
			}
		}
		if (pair + 1 == count) {
			WaitFlag<HardEvent::M_MTE1>(6);
			WaitFlag<HardEvent::M_MTE1>(7);
			for (int s = 0; s < NB && s < count * KS; ++s)
				WaitFlag<HardEvent::MTE1_MTE2>(s);
		}
		SetFlag<HardEvent::M_FIX>(7);
		WaitFlag<HardEvent::M_FIX>(7);
		for (int half = 0; half < 2; ++half) {
			const int slot = iter & 1;
			if (iter >= 2)
				CrossCoreWaitFlag(3 + slot);
			FixpipeParamsV220 f;
			f.nSize = CN;
			f.mSize = work.rows;
			f.srcStride = padded;
			f.dstStride = CN;
			f.reluEn = false;
			f.quantPre = QuantMode_t::NoQuant;
			f.unitFlag = 0;
			Fixpipe<int32_t, int32_t, CFG_ROW_MAJOR>(c[core * 128 * CN + slot * CM * CN], all[slot * CM * CN], f);
			CrossCoreSetFlag<2, PIPE_FIX>(5 + slot);
			SetFlag<HardEvent::FIX_M>(6 + slot);
			++iter;
		}
	}
}

template <int DEPTH, int CM = 128>
__aicore__ inline void
Compute(__attribute__((cce_global)) uint8_t *x, __attribute__((cce_global)) uint8_t *weight,
				__attribute__((cce_global)) uint8_t *scale, __attribute__((cce_global)) uint8_t *group_list,
				__attribute__((cce_global)) uint8_t *y, __attribute__((cce_global)) uint8_t *workspace, int32_t m,
				int32_t n, int32_t e, int32_t depth = DEPTH) {
	static_assert(DEPTH > 0 && DEPTH % 512 == 0 && CM * DEPTH + 4 * 256 * 256 <= 512 * 1024,
								"Resident A plus four B256 banks must fit L1");
	constexpr uint16_t GMM_SYNC_AIV_AIC = 3, GMM_SYNC_AIC_AIV = 5, GMM_SYNC_FINALIZE = 7;
	constexpr uint32_t SYNC_MODE2 = 2;
	const int coreNum = GetBlockNum(), coreIdx = CoreGroupIndex(), subIdx = SubCoreIndex();
	GlobalTensor<int8_t> xGm, wGm;
	GlobalTensor<float> scaleGm;
	GlobalTensor<int64_t> glGm;
	GlobalTensor<int32_t> cGm;
	GlobalTensor<half> yGm;
	xGm.SetGlobalBuffer(reinterpret_cast<__attribute__((cce_global)) int8_t *>(x), m * depth);
	wGm.SetGlobalBuffer(reinterpret_cast<__attribute__((cce_global)) int8_t *>(weight), e * depth * n);
	scaleGm.SetGlobalBuffer(reinterpret_cast<__attribute__((cce_global)) float *>(scale), e * n);
	glGm.SetGlobalBuffer(reinterpret_cast<__attribute__((cce_global)) int64_t *>(group_list), e);
	cGm.SetGlobalBuffer(reinterpret_cast<__attribute__((cce_global)) int32_t *>(workspace),
											coreNum * 128 * 256);
	yGm.SetGlobalBuffer(reinterpret_cast<__attribute__((cce_global)) half *>(y), m * n);
	TPipe pipe;
	if constexpr (g_coreType == AscendC::AIC) {
		TBuf<TPosition::A1> arena;
		TBuf<TPosition::A2> a2buf;
		TBuf<TPosition::B2> b2buf;
		TBuf<TPosition::CO1> cbuf;
		pipe.InitBuffer(arena, 512 * 1024);
		pipe.InitBuffer(a2buf, 2 * 128 * 128);
		pipe.InitBuffer(b2buf, 2 * 128 * 256);
		pipe.InitBuffer(cbuf, 128 * 256 * 4);
		const uint32_t base = static_cast<uint32_t>(arena.Get<int8_t>().GetPhyAddr());
		auto a2 = a2buf.Get<int8_t>();
		auto b2 = b2buf.Get<int8_t>();
		auto acc = cbuf.Get<int32_t>();
		Cursor cursor{};
		cursor.task = coreIdx;
		Work work;
		int iter = 0, slots = 0;
		while (NextReal<CM>(glGm, e, coreNum, n / 256, cursor, work)) {
			if (cursor.plannedN == 1) {
				work.ownedN = 0;
				work.panels = n / 256;
			}
			const int nextSlots = work.rows <= 64 ? 2 : 1;
			if (slots != nextSlots) {
				if (slots)
					DrainC(slots, iter);
				iter = 0;
				slots = nextSlots;
			}
			if constexpr (CM == 64) {
				Produce<DEPTH, 64, 2>(work, n, coreIdx, base, xGm, wGm, cGm, a2, b2, acc, iter, depth);
			} else if (nextSlots == 2) {
				Work piece = work;
				piece.panels = work.panels / 2 * 2;
				if (piece.panels)
					ProducePairs<DEPTH>(piece, n, coreIdx, base, xGm, wGm, cGm, a2, b2, acc, iter);
				if (work.panels & 1) {
					piece.ownedN = work.ownedN + piece.panels;
					piece.panels = 1;
					Produce<DEPTH, 64, 2>(piece, n, coreIdx, base, xGm, wGm, cGm, a2, b2, acc, iter);
				}
			} else
				Produce<DEPTH, 128, 1>(work, n, coreIdx, base, xGm, wGm, cGm, a2, b2, acc, iter);
		}
		DrainC(slots, iter);
	} else {
		constexpr int CN = 256, MATH_ROWS = 32;
		TQue<TPosition::VECIN, 1> cQue;
		TBuf<TPosition::VECCALC> uBuf, outBuf, sBuf;
		pipe.InitBuffer(cQue, 1, 64 * CN * sizeof(int32_t));
		pipe.InitBuffer(uBuf, MATH_ROWS * CN * sizeof(float));
		pipe.InitBuffer(outBuf, 64 * CN * sizeof(half));
		pipe.InitBuffer(sBuf, CN * sizeof(float));
		auto u = uBuf.Get<float>();
		auto result = outBuf.Get<half>();
		auto s = sBuf.Get<float>();
		Cursor cursor{};
		cursor.task = coreIdx;
		Work work;
		int iter = 0, slots = 0;
		while (NextReal<CM>(glGm, e, coreNum, n / CN, cursor, work)) {
			if (cursor.plannedN == 1) {
				work.ownedN = 0;
				work.panels = n / CN;
			}
			const int nextSlots = work.rows <= 64 ? 2 : 1;
			if (nextSlots != slots) {
				slots = nextSlots;
				iter = 0;
			}
			const int rowsPerSub = (work.rows + 1) / 2;
			const int first = subIdx * rowsPerSub;
			const int last =
					first < work.rows ? (first + rowsPerSub < work.rows ? first + rowsPerSub : work.rows) : first;
			const int outRows = last - first;
			for (int panel = work.ownedN; panel < work.ownedN + work.panels; ++panel) {
				const int slot = slots == 2 ? (iter & 1) : 0;
				DataCopyExtParams sp;
				sp.blockCount = 1;
				sp.blockLen = CN * sizeof(float);
				sp.srcStride = 0;
				sp.dstStride = 0;
				DataCopyPadExtParams<float> spad;
				spad.isPad = true;
				spad.leftPadding = 0;
				spad.rightPadding = 0;
				spad.paddingValue = 0;
				DataCopyPad(s, scaleGm[work.expert * n + panel * CN], sp, spad);
				SetFlag<HardEvent::MTE2_V>(EVENT_ID4);
				CrossCoreWaitFlag(GMM_SYNC_AIC_AIV + slot);
				WaitFlag<HardEvent::MTE2_V>(EVENT_ID4);
				if (outRows > 0) {
					auto c = cQue.AllocTensor<int32_t>();
					DataCopyExtParams cp;
					cp.blockCount = 1;
					cp.blockLen = outRows * CN * sizeof(int32_t);
					cp.srcStride = 0;
					cp.dstStride = 0;
					DataCopyPadExtParams<int32_t> cpad;
					cpad.isPad = true;
					cpad.leftPadding = 0;
					cpad.rightPadding = 0;
					cpad.paddingValue = 0;
					DataCopyPad(c, cGm[(coreIdx * 128 + slot * 64 + first) * CN], cp, cpad);
					cQue.EnQue(c);
					c = cQue.DeQue<int32_t>();
					CrossCoreSetFlag<SYNC_MODE2, PIPE_MTE2>(GMM_SYNC_AIV_AIC + slot);
					auto z = c.ReinterpretCast<float>();
					Cast(z, c, RoundMode::CAST_NONE, outRows * CN);
					PipeBarrier<PIPE_V>();
					for (int row = 0; row < outRows; row += MATH_ROWS) {
						const int rows = row + MATH_ROWS < outRows ? MATH_ROWS : outRows - row;
						auto part = z[row * CN];
						RgScaleRows(part, s, rows, CN);
						RgGeluInplace(part, u, rows * CN);
						PipeBarrier<PIPE_V>();
						Cast(result[row * CN], u, RoundMode::CAST_RINT, rows * CN);
					}
					cQue.FreeTensor(c);
					SetFlag<HardEvent::V_MTE2>(EVENT_ID4);
					WaitFlag<HardEvent::V_MTE2>(EVENT_ID4);
					SetFlag<HardEvent::V_MTE3>(EVENT_ID4);
					WaitFlag<HardEvent::V_MTE3>(EVENT_ID4);
					DataCopyExtParams op;
					op.blockCount = outRows;
					op.blockLen = CN * sizeof(half);
					op.srcStride = 0;
					op.dstStride = (n - CN) * sizeof(half);
					DataCopyPad(yGm[(work.row + first) * n + panel * CN], result, op);
					SetFlag<HardEvent::MTE3_V>(EVENT_ID4);
					WaitFlag<HardEvent::MTE3_V>(EVENT_ID4);
				} else {
					CrossCoreSetFlag<SYNC_MODE2, PIPE_MTE2>(GMM_SYNC_AIV_AIC + slot);
				}
				++iter;
			}
		}
	}
}

}
template <int DEPTH>
__global__ __mix__(1, 2) void gmm_rg494_streamedB(GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR g, GM_ADDR y,
																									GM_ADDR c, int32_t m, int32_t n, int32_t e) {
	gmm_streamedB_plan::Compute<DEPTH>(x, w, s, g, y, c, m, n, e);
}
__global__ __mix__(1, 2) void new5_large_k_streamed_b(GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR g, GM_ADDR y,
																											GM_ADDR c, int32_t m, int32_t k, int32_t n, int32_t e) {
	gmm_streamedB_plan::Compute<4096, 64>(x, w, s, g, y, c, m, n, e, k);
}
using namespace AscendC;
namespace short_gemv {
constexpr int KT = 256, NT = 64;

__aicore__ inline void Gelu(const LocalTensor<float> &z, const LocalTensor<float> &u,
														const LocalTensor<float> &t, const LocalTensor<float> &one) {
	Mul(u, z, z, NT);
	PipeBarrier<PIPE_V>();
	Mul(u, u, z, NT);
	PipeBarrier<PIPE_V>();
	Muls(u, u, 0.044715f, NT);
	PipeBarrier<PIPE_V>();
	Add(u, u, z, NT);
	PipeBarrier<PIPE_V>();
	Muls(t, u, -1.5957691216057308f, NT);
	PipeBarrier<PIPE_V>();
	Exp(t, t, NT);
	PipeBarrier<PIPE_V>();
	Adds(t, t, 1.0f, NT);
	PipeBarrier<PIPE_V>();
	Div(t, one, t, NT);
	PipeBarrier<PIPE_V>();
	Mul(u, z, t, NT);
	PipeBarrier<PIPE_V>();
}

}
__global__ __aicore__ void short_gemv_i32_ub_tile(GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR g, GM_ADDR y,
																									int32_t m, int32_t k, int32_t n, int32_t e, int32_t kt) {
	KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
	using namespace short_gemv;
	TPipe pipe;
	TBuf<TPosition::VECCALC> wb, hb, pb, xb, xhb, xib, bb, ab, zb, sb, ub, tb, ob, db;
	pipe.InitBuffer(wb, KT * NT);
	pipe.InitBuffer(hb, KT * NT * 2);
	pipe.InitBuffer(pb, KT * NT * 4);
	pipe.InitBuffer(xb, KT);
	pipe.InitBuffer(xhb, KT * 2);
	pipe.InitBuffer(xib, KT * 4);
	pipe.InitBuffer(bb, KT * 8 * 4);
	pipe.InitBuffer(ab, NT * 4);
	pipe.InitBuffer(zb, NT * 4);
	pipe.InitBuffer(sb, NT * 4);
	pipe.InitBuffer(ub, NT * 4);
	pipe.InitBuffer(tb, NT * 4);
	pipe.InitBuffer(ob, NT * 2);
	pipe.InitBuffer(db, NT * 4);
	auto wi = wb.Get<int8_t>();
	auto wh = hb.Get<half>();
	auto prod = pb.Get<int32_t>();
	auto xi = xb.Get<int8_t>();
	auto xh = xhb.Get<half>();
	auto xv = xib.Get<int32_t>();
	auto broadcast = bb.Get<int32_t>();
	auto acc = ab.Get<int32_t>();
	auto z = zb.Get<float>();
	auto scale = sb.Get<float>();
	auto u = ub.Get<float>();
	auto t = tb.Get<float>();
	auto out = ob.Get<half>();
	auto one = db.Get<float>();
	Duplicate(one, 1.0f, NT);
	GlobalTensor<int8_t> xg, wg;
	GlobalTensor<float> sg;
	GlobalTensor<int64_t> gg;
	GlobalTensor<half> yg;
	xg.SetGlobalBuffer((__gm__ int8_t *)x, m * k);
	wg.SetGlobalBuffer((__gm__ int8_t *)w, e * k * n);
	sg.SetGlobalBuffer((__gm__ float *)s, e * n);
	gg.SetGlobalBuffer((__gm__ int64_t *)g, e);
	yg.SetGlobalBuffer((__gm__ half *)y, m * n);
	const int nt = (n + NT - 1) / NT;
	for (int task = GetBlockIdx(); task < m * nt; task += GetBlockNum()) {
		const int row = task / nt, col = (task % nt) * NT, valid = n - col < NT ? n - col : NT;
		int lo = 0, hi = e;
		while (lo < hi) {
			int mid = (lo + hi) / 2;
			if (gg.GetValue(mid) <= row)
				lo = mid + 1;
			else
				hi = mid;
		}
		const int expert = lo;
		Duplicate(acc, int32_t(0), NT);
		PipeBarrier<PIPE_V>();
		for (int kk = 0; kk < k; kk += kt) {
			const int actual = k - kk < kt ? k - kk : kt;
			Duplicate(wi.ReinterpretCast<int16_t>(), int16_t(0), kt * NT / 2);
			Duplicate(xi.ReinterpretCast<int16_t>(), int16_t(0), kt / 2);
			SetFlag<HardEvent::V_MTE2>(0);
			WaitFlag<HardEvent::V_MTE2>(0);
			DataCopyExtParams wp{};
			wp.blockCount = actual;
			wp.blockLen = valid;
			wp.srcStride = n - valid;
			wp.dstStride = (NT - ((valid + 31) / 32) * 32) / 32;
			DataCopyPadExtParams<int8_t> pad{true, 0, 0, 0};
			DataCopyPad(wi, wg[(expert * k + kk) * n + col], wp, pad);
			DataCopyExtParams xp{};
			xp.blockCount = 1;
			xp.blockLen = actual;
			DataCopyPad(xi, xg[row * k + kk], xp, pad);
			SetFlag<HardEvent::MTE2_V>(0);
			WaitFlag<HardEvent::MTE2_V>(0);
			Cast(wh, wi, RoundMode::CAST_NONE, kt * NT);
			Cast(xh, xi, RoundMode::CAST_NONE, kt);
			PipeBarrier<PIPE_V>();
			Cast(prod, wh, RoundMode::CAST_RINT, kt * NT);
			Cast(xv, xh, RoundMode::CAST_RINT, kt);
			PipeBarrier<PIPE_V>();
			Brcb(broadcast, xv, kt / 8, BrcbRepeatParams{1, 8});
			PipeBarrier<PIPE_V>();
			for (int kr = 0; kr < kt; kr += 128) {
				const int rc = kt - kr < 128 ? kt - kr : 128;
				Mul(prod[kr * NT], prod[kr * NT], broadcast[kr * 8], uint64_t(NT), uint8_t(rc),
						BinaryRepeatParams{1, 1, 0, NT / 8, NT / 8, 1});
			}
			PipeBarrier<PIPE_V>();
			for (int span = kt / 2; span; span /= 2) {
				Add(prod, prod, prod[span * NT], span * NT);
				PipeBarrier<PIPE_V>();
			}
			Add(acc, acc, prod, NT);
			PipeBarrier<PIPE_V>();
		}
		SetFlag<HardEvent::V_MTE2>(0);
		WaitFlag<HardEvent::V_MTE2>(0);
		DataCopyExtParams sp{};
		sp.blockCount = 1;
		sp.blockLen = valid * 4;
		DataCopyPadExtParams<float> spad{true, 0, 0, 0};
		DataCopyPad(scale, sg[expert * n + col], sp, spad);
		SetFlag<HardEvent::MTE2_V>(0);
		WaitFlag<HardEvent::MTE2_V>(0);
		Cast(z, acc, RoundMode::CAST_NONE, NT);
		PipeBarrier<PIPE_V>();
		Mul(z, z, scale, NT);
		PipeBarrier<PIPE_V>();
		Gelu(z, u, t, one);
		Cast(out, u, RoundMode::CAST_NONE, NT);
		SetFlag<HardEvent::V_MTE3>(1);
		WaitFlag<HardEvent::V_MTE3>(1);
		DataCopyExtParams op{};
		op.blockCount = 1;
		op.blockLen = valid * 2;
		DataCopyPad(yg[row * n + col], out, op);
		SetFlag<HardEvent::MTE3_V>(1);
		WaitFlag<HardEvent::MTE3_V>(1);
	}
	PipeBarrier<PIPE_ALL>();
}

namespace new5_short_k_unified {

__aicore__ inline void Gelu(const AscendC::LocalTensor<float> &z, const AscendC::LocalTensor<float> &u,
														const AscendC::LocalTensor<float> &t, int count) {
	using namespace AscendC;
	Mul(u, z, z, count);
	PipeBarrier<PIPE_V>();
	Mul(u, u, z, count);
	PipeBarrier<PIPE_V>();
	Muls(u, u, 0.044715f, count);
	PipeBarrier<PIPE_V>();
	Add(u, u, z, count);
	PipeBarrier<PIPE_V>();
	Muls(t, u, -1.5957691216057308f, count);
	PipeBarrier<PIPE_V>();
	Exp(t, t, count);
	PipeBarrier<PIPE_V>();
	Adds(t, t, 1.0f, count);
	PipeBarrier<PIPE_V>();
	Div(u, z, t, count);
	PipeBarrier<PIPE_V>();
}
template <int ROWS, int MAX_K, int COLS = 256>
__aicore__ inline void Compute(GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR g, GM_ADDR y, int32_t m, int32_t k,
															 int32_t n, int32_t e) {
	using namespace AscendC;
	constexpr int X_COUNT = ROWS * MAX_K;
	constexpr int Y_COUNT = ROWS * COLS;
	constexpr int VECTOR_COLS = COLS < 64 ? COLS : 64;
	constexpr int CAST_COUNT = MAX_K * COLS > X_COUNT ? MAX_K * COLS : X_COUNT;

	TPipe pipe;
	TBuf<TPosition::VECCALC> weightBytes, castScratch, weightInts;
	TBuf<TPosition::VECCALC> xBytes, xInts, xBroadcast;
	TBuf<TPosition::VECCALC> productAndU, accumulatorAndZ, tBuffer;
	TBuf<TPosition::VECCALC> scaleBuffer, outputBuffer, groupBuffer;
	pipe.InitBuffer(weightBytes, MAX_K * COLS);
	pipe.InitBuffer(castScratch, CAST_COUNT * sizeof(half));
	pipe.InitBuffer(weightInts, MAX_K * COLS * sizeof(int32_t));
	pipe.InitBuffer(xBytes, X_COUNT);
	pipe.InitBuffer(xInts, X_COUNT * sizeof(int32_t));
	pipe.InitBuffer(xBroadcast, X_COUNT * 8 * sizeof(int32_t));
	pipe.InitBuffer(productAndU, Y_COUNT * sizeof(int32_t));
	pipe.InitBuffer(accumulatorAndZ, Y_COUNT * sizeof(int32_t));
	pipe.InitBuffer(tBuffer, Y_COUNT * sizeof(float));
	pipe.InitBuffer(scaleBuffer, COLS * sizeof(float));
	pipe.InitBuffer(outputBuffer, Y_COUNT * sizeof(half));
	pipe.InitBuffer(groupBuffer, 128 * sizeof(int64_t));

	const auto weightI8 = weightBytes.Get<int8_t>();
	const auto halfScratch = castScratch.Get<half>();
	const auto weightI32 = weightInts.Get<int32_t>();
	const auto xI8 = xBytes.Get<int8_t>();
	const auto xI32 = xInts.Get<int32_t>();
	const auto broadcast = xBroadcast.Get<int32_t>();
	const auto product = productAndU.Get<int32_t>();
	const auto u = productAndU.Get<float>();
	const auto acc = accumulatorAndZ.Get<int32_t>();
	const auto z = accumulatorAndZ.Get<float>();
	const auto t = tBuffer.Get<float>();
	const auto scale = scaleBuffer.Get<float>();
	const auto output = outputBuffer.Get<half>();
	const auto groups = groupBuffer.Get<int64_t>();

	GlobalTensor<int8_t> xGlobal, weightGlobal;
	GlobalTensor<float> scaleGlobal;
	GlobalTensor<int64_t> groupGlobal;
	GlobalTensor<half> yGlobal;
	xGlobal.SetGlobalBuffer((__gm__ int8_t *)x, m * k);
	weightGlobal.SetGlobalBuffer((__gm__ int8_t *)w, e * k * n);
	scaleGlobal.SetGlobalBuffer((__gm__ float *)s, e * n);
	groupGlobal.SetGlobalBuffer((__gm__ int64_t *)g, e);
	yGlobal.SetGlobalBuffer((__gm__ half *)y, m * n);

	DataCopyExtParams groupCopy{};
	groupCopy.blockCount = 1;
	groupCopy.blockLen = e * sizeof(int64_t);
	DataCopyPadExtParams<int64_t> groupPad{false, 0, 0, 0};
	DataCopyPad(groups, groupGlobal, groupCopy, groupPad);
	SetFlag<HardEvent::MTE2_S>(0);
	WaitFlag<HardEvent::MTE2_S>(0);

	const int block = GetBlockIdx();
	const int blockCount = GetBlockNum();
	const int columnPanels = (n + COLS - 1) / COLS;
	int rowBegin = 0;
	int taskBase = 0;
	bool outputInFlight = false;
	for (int expert = 0; expert < e; ++expert) {

		const int rowEnd = static_cast<int>(groups.GetValue(expert));
		const int rowCount = rowEnd - rowBegin;
		const int slabs = (rowCount + ROWS - 1) / ROWS;
		const int expertTasks = slabs * columnPanels;
		const int firstTask = (block + blockCount - taskBase % blockCount) % blockCount;
		int cachedPanel = -1;
		for (int task = firstTask; task < expertTasks; task += blockCount) {

			const int panel = task / slabs;
			const int row = rowBegin + (task % slabs) * ROWS;
			const int rows = rowEnd - row < ROWS ? rowEnd - row : ROWS;
			const int col = panel * COLS;
			const int cols = n - col < COLS ? n - col : COLS;
			const int count = rows * COLS;

			if (panel != cachedPanel) {
				Duplicate(weightI8.ReinterpretCast<int16_t>(), int16_t(0), MAX_K * COLS / 2);
				Duplicate(scale, 0.0f, COLS);
				SetFlag<HardEvent::V_MTE2>(0);
				WaitFlag<HardEvent::V_MTE2>(0);
				DataCopyExtParams weightCopy{};
				weightCopy.blockCount = k;
				weightCopy.blockLen = cols;
				weightCopy.srcStride = n - cols;
				weightCopy.dstStride = (COLS - ((cols + 31) / 32) * 32) / 32;
				DataCopyPadExtParams<int8_t> int8Pad{true, 0, 0, 0};
				DataCopyPad(weightI8, weightGlobal[expert * k * n + col], weightCopy, int8Pad);
				DataCopyExtParams scaleCopy{};
				scaleCopy.blockCount = 1;
				scaleCopy.blockLen = cols * sizeof(float);
				DataCopyPadExtParams<float> scalePad{true, 0, 0, 0};
				DataCopyPad(scale, scaleGlobal[expert * n + col], scaleCopy, scalePad);
				SetFlag<HardEvent::MTE2_V>(0);
				WaitFlag<HardEvent::MTE2_V>(0);

				Cast(halfScratch, weightI8, RoundMode::CAST_NONE, k * COLS);
				PipeBarrier<PIPE_V>();
				Cast(weightI32, halfScratch, RoundMode::CAST_RINT, k * COLS);
				PipeBarrier<PIPE_V>();
				cachedPanel = panel;
			}

			Duplicate(xI8.ReinterpretCast<int16_t>(), int16_t(0), X_COUNT / 2);
			SetFlag<HardEvent::V_MTE2>(0);
			WaitFlag<HardEvent::V_MTE2>(0);
			DataCopyExtParams xCopy{};
			xCopy.blockCount = 1;
			xCopy.blockLen = rows * k;
			DataCopyPadExtParams<int8_t> xPad{true, 0, 0, 0};
			DataCopyPad(xI8, xGlobal[row * k], xCopy, xPad);
			SetFlag<HardEvent::MTE2_V>(0);
			WaitFlag<HardEvent::MTE2_V>(0);
			Cast(halfScratch, xI8, RoundMode::CAST_NONE, X_COUNT);
			PipeBarrier<PIPE_V>();
			Cast(xI32, halfScratch, RoundMode::CAST_RINT, X_COUNT);
			PipeBarrier<PIPE_V>();

			for (int first = 0; first < X_COUNT; first += 1536) {
				const int size = X_COUNT - first < 1536 ? X_COUNT - first : 1536;
				Brcb(broadcast[first * 8], xI32[first], static_cast<uint8_t>(size / 8), BrcbRepeatParams{1, 8});
			}
			PipeBarrier<PIPE_V>();

			const BinaryRepeatParams multiplyStrides{1, 1, 0, COLS / 8, 0, static_cast<uint8_t>(k)};
			for (int kk = 0; kk < k; ++kk) {
				for (int chunk = 0; chunk < COLS; chunk += VECTOR_COLS) {
					if (kk == 0) {
						Mul(acc[chunk], weightI32[kk * COLS + chunk], broadcast[kk * 8], uint64_t(VECTOR_COLS),
								static_cast<uint8_t>(rows), multiplyStrides);
					} else {
						Mul(product[chunk], weightI32[kk * COLS + chunk], broadcast[kk * 8], uint64_t(VECTOR_COLS),
								static_cast<uint8_t>(rows), multiplyStrides);
					}
				}
				PipeBarrier<PIPE_V>();
				if (kk != 0) {
					Add(acc, acc, product, count);
					PipeBarrier<PIPE_V>();
				}
			}

			Cast(z, acc, RoundMode::CAST_NONE, count);
			PipeBarrier<PIPE_V>();

			for (int chunk = 0; chunk < COLS; chunk += VECTOR_COLS) {
				Mul(z[chunk], z[chunk], scale[chunk], uint64_t(VECTOR_COLS), static_cast<uint8_t>(rows),
						BinaryRepeatParams{1, 1, 1, COLS / 8, COLS / 8, 0});
			}
			PipeBarrier<PIPE_V>();

			Gelu(z, u, t, count);
			if (outputInFlight)
				WaitFlag<HardEvent::MTE3_V>(1);
			Cast(output, u, RoundMode::CAST_NONE, count);
			SetFlag<HardEvent::V_MTE3>(1);
			WaitFlag<HardEvent::V_MTE3>(1);
			DataCopyExtParams outputCopy{};
			outputCopy.blockCount = rows;
			outputCopy.blockLen = cols * sizeof(half);
			outputCopy.srcStride = (COLS - ((cols + 15) / 16) * 16) / 16;
			outputCopy.dstStride = (n - cols) * sizeof(half);
			DataCopyPad(yGlobal[row * n + col], output, outputCopy);
			SetFlag<HardEvent::MTE3_V>(1);

			if (COLS < 64)
				WaitFlag<HardEvent::MTE3_V>(1);
			else
				outputInFlight = true;
		}
		taskBase += expertTasks;
		rowBegin = rowEnd;
	}
	if (outputInFlight)
		WaitFlag<HardEvent::MTE3_V>(1);
}
}

