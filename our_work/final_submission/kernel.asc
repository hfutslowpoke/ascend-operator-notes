__aicore__ inline void RgGeluInplace(const AscendC::LocalTensor<float> &z,
																		 const AscendC::LocalTensor<float> &u, int32_t cnt) {
	using namespace AscendC;
	Mul(u, z, z, cnt);
	Muls(u, u, -0.07135481627260026f, cnt);
	Adds(u, u, -1.5957691216057308f, cnt);
	Mul(u, u, z, cnt);
	Exp(u, u, cnt);
	Adds(u, u, 1.0f, cnt);
	Div(u, z, u, cnt);
}
__aicore__ inline void RgScaleRows(const AscendC::LocalTensor<float> &z, const AscendC::LocalTensor<float> &s,
																	 int32_t rows, int32_t pitch) {
	using namespace AscendC;
	if (pitch % 64 == 0 && rows >= pitch / 64) {
		BinaryRepeatParams rp;
		rp.dstBlkStride = 1;
		rp.src0BlkStride = 1;
		rp.src1BlkStride = 1;
		rp.dstRepStride = pitch / 8;
		rp.src0RepStride = pitch / 8;
		rp.src1RepStride = 0;
		for (int col = 0; col < pitch; col += 64)
			Mul(z[col], z[col], s[col], uint64_t(64), rows, rp);
	} else {
		for (int row = 0; row < rows; ++row)
			Mul(z[row * pitch], z[row * pitch], s, pitch);
	}
}
namespace gmm_small {
using namespace AscendC;

constexpr int32_t CAP_M = 64;

constexpr int32_t CAP_K = 128;

constexpr int32_t CAP_N = 128;

constexpr int32_t CAP_C0 = 32;

constexpr int32_t CAP_CHUNK = 16 * CAP_N;

__global__ __mix__(1, 2)
		__attribute__((aligned(64))) void bk485(GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR group_list,
																						GM_ADDR y, GM_ADDR workspace, int64_t runtimeM, int64_t k,
																						int64_t n, int64_t e) {
	const int64_t m = runtimeM / GetBlockNum();
	const int64_t rowStart = gmm_common::CoreGroupIndex() * m;
	const uint32_t subIdx = static_cast<uint32_t>(GetSubBlockIdx());
	TPipe pipe;
	GlobalTensor<int8_t> xGm;
	GlobalTensor<int8_t> wGm;
	GlobalTensor<float> scaleGm;
	GlobalTensor<int32_t> cGm;
	GlobalTensor<half> yGm;
	xGm.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t *>(x), runtimeM * k);
	wGm.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t *>(weight), k * n);
	scaleGm.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(scale), n);
	cGm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t *>(workspace), runtimeM * n);
	yGm.SetGlobalBuffer(reinterpret_cast<__gm__ half *>(y), runtimeM * n);
	if ASCEND_IS_AIC {
		TBuf<TPosition::A1> a1Buf;
		TBuf<TPosition::B1> b1Buf;
		TBuf<TPosition::A2> a2Buf;
		TBuf<TPosition::B2> b2Buf;
		TBuf<TPosition::CO1> c1Buf;
		pipe.InitBuffer(a1Buf, CAP_M * CAP_K);
		pipe.InitBuffer(b1Buf, CAP_K * CAP_N);
		pipe.InitBuffer(a2Buf, CAP_M * CAP_K);
		pipe.InitBuffer(b2Buf, CAP_K * CAP_N);
		pipe.InitBuffer(c1Buf, CAP_M * CAP_N * sizeof(int32_t));
		LocalTensor<int8_t> a1 = a1Buf.Get<int8_t>();
		LocalTensor<int8_t> b1 = b1Buf.Get<int8_t>();
		LocalTensor<int8_t> a2 = a2Buf.Get<int8_t>();
		LocalTensor<int8_t> b2 = b2Buf.Get<int8_t>();
		LocalTensor<int32_t> c1 = c1Buf.Get<int32_t>();
		Nd2NzParams pa;
		pa.ndNum = 1;
		pa.nValue = m;
		pa.dValue = k;
		pa.srcNdMatrixStride = 0;
		pa.srcDValue = k;
		pa.dstNzC0Stride = m;
		pa.dstNzNStride = 1;
		pa.dstNzMatrixStride = 0;
		DataCopy(a1, xGm[rowStart * k], pa);
		Nd2NzParams pb;
		pb.ndNum = 1;
		pb.nValue = k;
		pb.dValue = n;
		pb.srcNdMatrixStride = 0;
		pb.srcDValue = n;
		pb.dstNzC0Stride = k;
		pb.dstNzNStride = 1;
		pb.dstNzMatrixStride = 0;
		DataCopy(b1, wGm, pb);
		SetFlag<HardEvent::MTE2_MTE1>(0);
		WaitFlag<HardEvent::MTE2_MTE1>(0);
		const uint8_t padList[4] = {0, 0, 0, 0};
		SetFmatrix(1, m, padList, FmatrixMode::FMATRIX_LEFT);
		LoadData3DParamsV2Pro lda;
		lda.channelSize = static_cast<uint16_t>(k);
		lda.extConfig = (static_cast<uint64_t>(m) << 16) | static_cast<uint64_t>(k);
		lda.enTranspose = false;
		LoadData(a2, a1, lda);
		LoadData2dTransposeParams ldb;
		ldb.startIndex = 0;
		ldb.repeatTimes = static_cast<uint8_t>(n / CAP_C0);
		ldb.srcStride = k / CAP_C0;
		ldb.dstGap = 1;
		ldb.dstFracGap = 0;
		ldb.addrMode = 0;
		for (int32_t i = 0; i < k / CAP_C0; ++i) {
			LoadDataWithTranspose(b2[i * 32 * n], b1[i * 1024], ldb);
		}
		SetFlag<HardEvent::MTE1_M>(0);
		WaitFlag<HardEvent::MTE1_M>(0);
		MmadParams mp;
		mp.m = m;
		mp.n = n;
		mp.k = k;
		mp.unitFlag = 3;
		mp.cmatrixInitVal = true;
		Mmad(c1, a2, b2, mp);
		SetFlag<HardEvent::M_FIX>(0);
		WaitFlag<HardEvent::M_FIX>(0);
		FixpipeParamsV220 fp;
		fp.nSize = n;
		fp.mSize = m;
		fp.srcStride = m;
		fp.dstStride = n;
		fp.reluEn = false;
		fp.quantPre = QuantMode_t::NoQuant;
		fp.unitFlag = 3;
		Fixpipe<int32_t, int32_t, CFG_ROW_MAJOR>(cGm[rowStart * n], c1, fp);
		CrossCoreSetFlag<2, PIPE_FIX>(5);
	} else {
		TQue<TPosition::VECIN, 1> cQue;
		TQue<TPosition::VECIN, 1> sQue;
		TQue<TPosition::VECOUT, 1> oQue;
		TBuf<TPosition::VECCALC> zBuf;
		TBuf<TPosition::VECCALC> uBuf;
		TBuf<TPosition::VECCALC> tBuf;
		TBuf<TPosition::VECCALC> dBuf;
		TBuf<TPosition::VECCALC> sMulBuf;
		pipe.InitBuffer(cQue, 1, CAP_CHUNK * sizeof(int32_t));
		pipe.InitBuffer(sQue, 1, CAP_N * sizeof(float));
		pipe.InitBuffer(oQue, 1, CAP_CHUNK * sizeof(half));
		pipe.InitBuffer(zBuf, CAP_CHUNK * sizeof(float));
		pipe.InitBuffer(uBuf, CAP_CHUNK * sizeof(float));
		pipe.InitBuffer(tBuf, CAP_CHUNK * sizeof(float));
		pipe.InitBuffer(dBuf, CAP_CHUNK * sizeof(float));
		pipe.InitBuffer(sMulBuf, CAP_CHUNK * sizeof(float));
		LocalTensor<float> z = zBuf.Get<float>();
		LocalTensor<float> u = uBuf.Get<float>();
		LocalTensor<float> t = tBuf.Get<float>();
		LocalTensor<float> d = dBuf.Get<float>();
		LocalTensor<float> sMul = sMulBuf.Get<float>();
		LocalTensor<float> s = sQue.AllocTensor<float>();
		DataCopyExtParams sp;
		sp.blockCount = 1;
		sp.blockLen = n * sizeof(float);
		sp.srcStride = 0;
		sp.dstStride = 0;
		DataCopyPadExtParams<float> spad;
		spad.isPad = true;
		spad.leftPadding = 0;
		spad.rightPadding = 0;
		spad.paddingValue = 0;
		DataCopyPad(s, scaleGm, sp, spad);
		sQue.EnQue(s);
		CrossCoreWaitFlag(5);
		s = sQue.DeQue<float>();
		for (int32_t rr = 0; rr < 16; ++rr) {
			Adds(sMul[rr * n], s, 0.0f, n);
		}
		Duplicate(d, 1.0f, CAP_CHUNK);
		const int32_t rowsPerSub = (m + 1) / 2;
		const int32_t subBegin = subIdx * rowsPerSub;
		const int32_t subEnd = subBegin + rowsPerSub < m ? subBegin + rowsPerSub : m;
		for (int32_t row = subBegin; row < subEnd; row += 16) {
			const int32_t rows = subEnd - row < 16 ? subEnd - row : 16;
			const int32_t count = rows * n;
			LocalTensor<int32_t> c = cQue.AllocTensor<int32_t>();
			DataCopyExtParams cp;
			cp.blockCount = rows;
			cp.blockLen = n * sizeof(int32_t);
			cp.srcStride = 0;
			cp.dstStride = 0;
			DataCopyPadExtParams<int32_t> cpad;
			cpad.isPad = true;
			cpad.leftPadding = 0;
			cpad.rightPadding = 0;
			cpad.paddingValue = 0;
			DataCopyPad(c, cGm[(rowStart + row) * n], cp, cpad);
			cQue.EnQue(c);
			c = cQue.DeQue<int32_t>();
			Cast(z, c, RoundMode::CAST_NONE, count);
			cQue.FreeTensor(c);
			PipeBarrier<PIPE_V>();
			Mul(z, z, sMul, count);
			gmm_common::GeluComputeSigmoid(z, u, t, d, count);
			PipeBarrier<PIPE_V>();
			LocalTensor<half> o = oQue.AllocTensor<half>();
			Cast(o, u, RoundMode::CAST_NONE, count);
			oQue.EnQue(o);
			o = oQue.DeQue<half>();
			DataCopyExtParams op;
			op.blockCount = rows;
			op.blockLen = n * sizeof(half);
			op.srcStride = 0;
			op.dstStride = 0;
			DataCopyPad(yGm[(rowStart + row) * n], o, op);
			oQue.FreeTensor(o);
		}
		sQue.FreeTensor(s);
		CrossCoreSetFlag<2, PIPE_MTE2>(3);
	}
}

}
namespace main_small_compact {
using namespace AscendC;

constexpr int32_t CAP_C0 = 32;

template <int REDUCE_K, int COLS>
__global__ __mix__(1, 2)
		__attribute__((aligned(64))) void bk0(GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR group_list,
																					GM_ADDR y, GM_ADDR workspace, int64_t runtimeM, int64_t runtimeK,
																					int64_t runtimeN, int64_t e) {
	constexpr int64_t m = 16, k = REDUCE_K, n = COLS;
	constexpr int32_t CAP_M = 16, CAP_K = REDUCE_K, CAP_N = COLS;
	constexpr int32_t CAP_CHUNK = 8 * COLS;
	const int64_t rowStart = gmm_common::CoreGroupIndex() * m;
	const uint32_t subIdx = static_cast<uint32_t>(GetSubBlockIdx());
	TPipe pipe;
	GlobalTensor<int8_t> xGm;
	GlobalTensor<int8_t> wGm;
	GlobalTensor<float> scaleGm;
	GlobalTensor<int32_t> cGm;
	GlobalTensor<half> yGm;
	xGm.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t *>(x), runtimeM * k);
	wGm.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t *>(weight), k * n);
	scaleGm.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(scale), n);
	cGm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t *>(workspace), runtimeM * n);
	yGm.SetGlobalBuffer(reinterpret_cast<__gm__ half *>(y), runtimeM * n);
	if ASCEND_IS_AIC {
		TBuf<TPosition::A1> a1Buf;
		TBuf<TPosition::B1> b1Buf;
		TBuf<TPosition::A2> a2Buf;
		TBuf<TPosition::B2> b2Buf;
		TBuf<TPosition::CO1> c1Buf;
		pipe.InitBuffer(a1Buf, CAP_M * CAP_K);
		pipe.InitBuffer(b1Buf, CAP_K * CAP_N);
		pipe.InitBuffer(a2Buf, CAP_M * CAP_K);
		pipe.InitBuffer(b2Buf, CAP_K * CAP_N);
		pipe.InitBuffer(c1Buf, CAP_M * CAP_N * sizeof(int32_t));
		LocalTensor<int8_t> a1 = a1Buf.Get<int8_t>();
		LocalTensor<int8_t> b1 = b1Buf.Get<int8_t>();
		LocalTensor<int8_t> a2 = a2Buf.Get<int8_t>();
		LocalTensor<int8_t> b2 = b2Buf.Get<int8_t>();
		LocalTensor<int32_t> c1 = c1Buf.Get<int32_t>();
		Nd2NzParams pa;
		pa.ndNum = 1;
		pa.nValue = m;
		pa.dValue = k;
		pa.srcNdMatrixStride = 0;
		pa.srcDValue = k;
		pa.dstNzC0Stride = m;
		pa.dstNzNStride = 1;
		pa.dstNzMatrixStride = 0;
		DataCopy(a1, xGm[rowStart * k], pa);
		Nd2NzParams pb;
		pb.ndNum = 1;
		pb.nValue = k;
		pb.dValue = n;
		pb.srcNdMatrixStride = 0;
		pb.srcDValue = n;
		pb.dstNzC0Stride = k;
		pb.dstNzNStride = 1;
		pb.dstNzMatrixStride = 0;
		DataCopy(b1, wGm, pb);
		SetFlag<HardEvent::MTE2_MTE1>(0);
		WaitFlag<HardEvent::MTE2_MTE1>(0);
		const uint8_t padList[4] = {0, 0, 0, 0};
		SetFmatrix(1, m, padList, FmatrixMode::FMATRIX_LEFT);
		LoadData3DParamsV2Pro lda;
		lda.channelSize = static_cast<uint16_t>(k);
		lda.extConfig = (static_cast<uint64_t>(m) << 16) | static_cast<uint64_t>(k);
		lda.enTranspose = false;
		LoadData(a2, a1, lda);
		LoadData2dTransposeParams ldb;
		ldb.startIndex = 0;
		ldb.repeatTimes = static_cast<uint8_t>(n / CAP_C0);
		ldb.srcStride = k / CAP_C0;
		ldb.dstGap = 1;
		ldb.dstFracGap = 0;
		ldb.addrMode = 0;
		for (int32_t i = 0; i < k / CAP_C0; ++i) {
			LoadDataWithTranspose(b2[i * 32 * n], b1[i * 1024], ldb);
		}
		SetFlag<HardEvent::MTE1_M>(0);
		WaitFlag<HardEvent::MTE1_M>(0);
		MmadParams mp;
		mp.m = m;
		mp.n = n;
		mp.k = k;
		mp.unitFlag = 3;
		mp.cmatrixInitVal = true;
		Mmad(c1, a2, b2, mp);
		SetFlag<HardEvent::M_FIX>(0);
		WaitFlag<HardEvent::M_FIX>(0);
		FixpipeParamsV220 fp;
		fp.nSize = n;
		fp.mSize = m;
		fp.srcStride = m;
		fp.dstStride = n;
		fp.reluEn = false;
		fp.quantPre = QuantMode_t::NoQuant;
		fp.unitFlag = 3;
		Fixpipe<int32_t, int32_t, CFG_ROW_MAJOR>(cGm[rowStart * n], c1, fp);
		CrossCoreSetFlag<2, PIPE_FIX>(5);
	} else {
		constexpr uint32_t C_BYTES = CAP_CHUNK * sizeof(int32_t);
		constexpr uint32_t S_OFF = C_BYTES;
		constexpr uint32_t Z_OFF = S_OFF + CAP_N * sizeof(float);
		constexpr uint32_t U_OFF = Z_OFF + C_BYTES;
		constexpr uint32_t O_OFF = U_OFF + C_BYTES;
		TBuf<TPosition::VECCALC> ub;
		pipe.InitBuffer(ub, O_OFF + CAP_CHUNK * sizeof(half));
		LocalTensor<int32_t> c = ub.Get<int32_t>();
		LocalTensor<float> s = ub.Get<float>()[S_OFF / 4];
		LocalTensor<float> z = ub.Get<float>()[Z_OFF / 4];
		LocalTensor<float> u = ub.Get<float>()[U_OFF / 4];
		LocalTensor<half> o = ub.Get<half>()[O_OFF / 2];
		const int32_t rowsPerSub = (m + 1) / 2;
		const int32_t subBegin = subIdx * rowsPerSub;
		const int32_t subEnd = subBegin + rowsPerSub < m ? subBegin + rowsPerSub : m;
		const int32_t activeRows = subEnd - subBegin < 16 ? subEnd - subBegin : 16;
		DataCopyExtParams sp;
		sp.blockCount = 1;
		sp.blockLen = n * sizeof(float);
		sp.srcStride = 0;
		sp.dstStride = 0;
		DataCopyPadExtParams<float> spad{false, 0, 0, 0};
		DataCopyPad(s, scaleGm, sp, spad);
		CrossCoreWaitFlag(5);
		const uint8_t rowStride = static_cast<uint8_t>(n / 8);
		const BinaryRepeatParams broadcast(1, 1, 1, rowStride, rowStride, 0);
		for (int32_t row = subBegin; row < subEnd; row += 16) {
			const int32_t rows = subEnd - row < 16 ? subEnd - row : 16;
			const int32_t count = rows * n;
			if (row > subBegin) {
				SetFlag<HardEvent::V_MTE2>(0);
				WaitFlag<HardEvent::V_MTE2>(0);
			}
			DataCopyExtParams cp;
			cp.blockCount = rows;
			cp.blockLen = n * sizeof(int32_t);
			cp.srcStride = 0;
			cp.dstStride = 0;
			DataCopyPadExtParams<int32_t> cpad{false, 0, 0, 0};
			DataCopyPad(c, cGm[(rowStart + row) * n], cp, cpad);
			SetFlag<HardEvent::MTE2_V>(0);
			WaitFlag<HardEvent::MTE2_V>(0);
			Cast(z, c, RoundMode::CAST_NONE, count);
			PipeBarrier<PIPE_V>();
			for (int32_t col = 0; col < n; col += 64) {
				const uint64_t width = n - col < 64 ? n - col : 64;
				Mul(z[col], z[col], s[col], width, static_cast<uint8_t>(rows), broadcast);
			}
			Mul(u, z, z, count);
			Muls(u, u, -0.07135481627260026f, count);
			Adds(u, u, -1.5957691216057308f, count);
			Mul(u, u, z, count);
			Exp(u, u, count);
			Adds(u, u, 1.0f, count);
			Div(u, z, u, count);
			PipeBarrier<PIPE_V>();
			Cast(o, u, RoundMode::CAST_NONE, count);
			SetFlag<HardEvent::V_MTE3>(0);
			WaitFlag<HardEvent::V_MTE3>(0);
			DataCopyExtParams op;
			op.blockCount = rows;
			op.blockLen = n * sizeof(half);
			op.srcStride = 0;
			op.dstStride = 0;
			DataCopyPad(yGm[(rowStart + row) * n], o, op);
			SetFlag<HardEvent::MTE3_V>(0);
			WaitFlag<HardEvent::MTE3_V>(0);
		}
		CrossCoreSetFlag<2, PIPE_MTE2>(3);
	}
}

}
#include "kernel_operator.h"

#include "adv_api/matmul/matmul.h"

namespace os_runtime {
using namespace AscendC;

__aicore__ inline uint32_t CoreGroupIndex() {
	if ASCEND_IS_AIC {
		return static_cast<uint32_t>(AscendC::GetBlockIdx());
	}
	return static_cast<uint32_t>(AscendC::GetBlockIdx() / AscendC::GetTaskRation());
}

__aicore__ inline uint32_t SubCoreIndex() {
	if ASCEND_IS_AIV {
		return static_cast<uint32_t>(AscendC::GetSubBlockIdx());
	}
	return 0;
}

__aicore__ inline int64_t CeilDiv(int64_t a, int64_t b) {
	return (a + b - 1) / b;
}

__aicore__ inline void GeluComputeSigmoid(const AscendC::LocalTensor<float> &z,
																					const AscendC::LocalTensor<float> &u, int32_t cnt) {
	using namespace AscendC;
	Mul(u, z, z, cnt);
	Mul(u, u, z, cnt);
	Muls(u, u, 0.044715f, cnt);
	Add(u, u, z, cnt);
	Muls(u, u, -1.5957691216057308f, cnt);
	Exp(u, u, cnt);
	Adds(u, u, 1.0f, cnt);
	Div(u, z, u, cnt);
}

template <int TM, int TN> struct Config {
	static_assert(TM % 16 == 0 && TN % 32 == 0, "Cube tile alignment");
	static_assert(TM * TN * 4 <= 128 * 1024, "L0C budget");
	using AType = AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, int8_t, false>;
	using BType = AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, int8_t, false>;
	using CType = AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, int32_t>;
	using BiasType = AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, int32_t>;
	static constexpr int32_t TILE_M = TM;
	static constexpr int32_t TILE_N = TN;
	static constexpr int32_t VEC_CHUNK_M = 16;
	static constexpr uint16_t GMM_SYNC_AIV_AIC = 3;
	static constexpr uint16_t GMM_SYNC_AIC_AIV = 5;
	static constexpr uint64_t SYNC_MODE2 = 2;
	static __aicore__ constexpr MatmulConfig MakeMatmulConfig() {
		MatmulConfig cfg{};
		cfg.doNorm = false;
		cfg.doBasicBlock = false;
		cfg.doMultiDataLoad = true;
		cfg.basicM = TILE_M;
		cfg.basicN = TILE_N;
		cfg.basicK = TN > 256 ? 64 : 128;
		cfg.intrinsicsCheck = false;
		cfg.isNBatch = false;
		cfg.enVecND2NZ = false;
		cfg.doSpecialBasicBlock = false;
		cfg.doMTE2Preload = 0;
		cfg.singleCoreM = TILE_M;
		cfg.singleCoreN = 1024;
		cfg.singleCoreK = 8192;
		cfg.stepM = 0;
		cfg.stepN = 0;
		cfg.baseMN = 0;
		cfg.singleCoreMN = 0;
		cfg.enUnitFlag = true;
		cfg.isPerTensor = false;
		cfg.hasAntiQuantOffset = false;
		cfg.doIBShareNorm = false;
		cfg.doSpecialMDL = false;
		cfg.enableInit = false;
		cfg.batchMode = BatchMode::NONE;
		cfg.enableEnd = true;
		cfg.enableGetTensorC = true;
		cfg.enableSetOrgShape = true;
		cfg.enableSetBias = false;
		cfg.enableSetTail = true;
		cfg.enableQuantVector = false;
		cfg.enableSetDefineData = false;
		cfg.iterateMode = IterateMode::ITERATE_MODE_DEFAULT;
		cfg.enableReuse = true;
		cfg.enableUBReuse = true;
		cfg.enableL1CacheUB = false;
		cfg.intraBlockPartSum = false;
		cfg.iterateOrder = IterateOrder::UNDEF;
		cfg.scheduleType = ScheduleType::INNER_PRODUCT;
		cfg.enableDoubleCache = false;
		cfg.isBiasBatch = true;
		cfg.enableStaticPadZeros = false;
		cfg.isA2B2Shared = false;
		cfg.enableKdimReorderLoad = false;
		cfg.isCO1Shared = false;
		return cfg;
	}
	static __aicore__ constexpr MatmulApiStaticTiling MakeStaticTiling() {
		MatmulApiStaticTiling tiling =
				AscendC::GetMatmulApiTiling<AType, BType, CType, BiasType>(MakeMatmulConfig());
		tiling.depthA1 = 8;
		tiling.depthB1 = 8;
		tiling.stepM = 1;
		tiling.stepN = 1;
		tiling.stepKa = 4;
		tiling.stepKb = 4;
		tiling.dbL0A = 2;
		tiling.dbL0B = 2;
		tiling.dbL0C = 1;
		return tiling;
	}
	constexpr static MatmulApiStaticTiling STATIC_TILING = MakeStaticTiling();
	using MM = AscendC::MatmulImpl<AType, BType, CType, BiasType, STATIC_TILING>;
};

template <int TM, int TN, int VC = 16, int STATIC_PARTS = 0>
__aicore__ inline void SplitRun(GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR group_list, GM_ADDR y,
																GM_ADDR workspace, int64_t m, int64_t k, int64_t n, int64_t e,
																int64_t requestedParts, const int32_t *cachedEnds = nullptr) {
	static_assert(STATIC_PARTS >= 0 && STATIC_PARTS <= 4, "split degree");
	const int64_t SK = STATIC_PARTS ? STATIC_PARTS : requestedParts;
	constexpr int TILE_M = TM, TILE_N = TN, VEC_CHUNK_M = VC;
	constexpr uint16_t GMM_SYNC_AIV_AIC = 3, GMM_SYNC_AIC_AIV = 5;
	constexpr uint64_t SYNC_MODE2 = 2;
	const uint32_t coreNum = GetBlockNum(), coreIdx = CoreGroupIndex(), subIdx = SubCoreIndex();
	GlobalTensor<int8_t> xGm, wGm;
	GlobalTensor<float> scaleGm;
	GlobalTensor<int64_t> glGm;
	GlobalTensor<int32_t> cGm;
	GlobalTensor<half> yGm;
	xGm.SetGlobalBuffer((__gm__ int8_t *)x, m * k);
	wGm.SetGlobalBuffer((__gm__ int8_t *)weight, e * k * n);
	scaleGm.SetGlobalBuffer((__gm__ float *)scale, e * n);
	glGm.SetGlobalBuffer((__gm__ int64_t *)group_list, e);
	cGm.SetGlobalBuffer((__gm__ int32_t *)workspace,
											(((m + TM - 1) / TM + e - 1) * ((n + TN - 1) / TN) * SK * TM * TN));
	yGm.SetGlobalBuffer((__gm__ half *)y, m * n);
	int32_t gl[128], prefix[128];
	int64_t totalMTiles = 0, prev = 0;
	for (int ei = 0; ei < e; ++ei) {
		const int64_t end = cachedEnds ? cachedEnds[ei] : glGm.GetValue(ei);
		gl[ei] = end;
		totalMTiles += CeilDiv(end - prev, TILE_M);
		prefix[ei] = totalMTiles;
		prev = end;
	}
	const int64_t NT = (n + TN - 1) / TN;
	const bool workAssign = false;
	const int64_t tasks = workAssign ? totalMTiles : totalMTiles * NT;
	TPipe pipe;
	int64_t iter = 0, slot = 0;
	if ASCEND_IS_AIC {
		typename Config<TM, TN>::MM mm;
		mm.SetSubBlockIdx(0);
		mm.Init(static_cast<TCubeTiling *>(nullptr), &pipe);
		for (int64_t task = coreIdx; task < tasks * SK; task += coreNum) {
			const int64_t tile = task / SK, part = task % SK;
			const int64_t mt = tile / NT;
			int lo = 0, hi = e;
			while (lo < hi) {
				int mid = (lo + hi) / 2;
				if (prefix[mid] <= mt)
					lo = mid + 1;
				else
					hi = mid;
			}
			const int ei = lo;
			const int64_t start = ei ? gl[ei - 1] : 0, me = gl[ei] - start;
			const int64_t mi = mt - (ei ? prefix[ei - 1] : 0), rowBase = start + mi * TM;
			const int64_t curM = me - mi * TM < TM ? me - mi * TM : TM;
			const int64_t nb = tile % NT, ne = nb + 1;
			for (int64_t ni = nb; ni < ne; ++ni) {
				const int64_t colBase = ni * TN, curN = n - colBase < TN ? n - colBase : TN;
				const bool seqC = false;
				const int64_t KS = ((k + SK - 1) / SK + 127) / 128 * 128;
				const int64_t kstart = part * KS, klen = k - kstart < KS ? k - kstart : KS;
				mm.SetOrgShape(me, n, k, k, TN);
				mm.SetSingleShape(curM, curN, klen);
				mm.SetTensorA(xGm[rowBase * k + kstart], false);
				mm.SetTensorB(wGm[ei * k * n + kstart * n + colBase], false);
				while (mm.Iterate())
					mm.GetTensorC(cGm[task * TM * TN], 0, seqC);
				slot ^= 1;
				++iter;
			}
		}
		PipeBarrier<PIPE_ALL>();
		SyncAll<false>();
	} else {
		SyncAll<false>();
		TQue<TPosition::VECIN, 1> cQue, sQue, partQue;
		TQue<TPosition::VECOUT, 1> oQue;
		TBuf<TPosition::VECCALC> zBuf, uBuf, sMulBuf;
		constexpr uint32_t CHUNK_ELEMS = VC * TN;
		pipe.InitBuffer(cQue, 1, CHUNK_ELEMS * 4);
		pipe.InitBuffer(partQue, 1, CHUNK_ELEMS * 4);
		pipe.InitBuffer(sQue, 1, TN * 4);
		pipe.InitBuffer(oQue, 1, CHUNK_ELEMS * 2);
		pipe.InitBuffer(zBuf, CHUNK_ELEMS * 4);
		pipe.InitBuffer(uBuf, CHUNK_ELEMS * 4);
		pipe.InitBuffer(sMulBuf, CHUNK_ELEMS * 4);
		LocalTensor<float> z = zBuf.Get<float>(), u = uBuf.Get<float>(), sMul = sMulBuf.Get<float>();
		for (int64_t task = coreIdx; task < tasks; task += coreNum) {
			const int64_t mt = workAssign ? task : task / NT;
			int lo = 0, hi = e;
			while (lo < hi) {
				int mid = (lo + hi) / 2;
				if (prefix[mid] <= mt)
					lo = mid + 1;
				else
					hi = mid;
			}
			const int ei = lo;
			const int64_t start = ei ? gl[ei - 1] : 0, me = gl[ei] - start;
			const int64_t mi = mt - (ei ? prefix[ei - 1] : 0), rowBase = start + mi * TM;
			const int64_t curM = me - mi * TM < TM ? me - mi * TM : TM;
			const int64_t rowsPerSub = (curM + 1) / 2, subRowBegin = subIdx * rowsPerSub;
			const int64_t subRowEnd = subRowBegin < curM
																		? (subRowBegin + rowsPerSub < curM ? subRowBegin + rowsPerSub : curM)
																		: subRowBegin;
			const int64_t nb = workAssign ? 0 : task % NT, ne = workAssign ? NT : nb + 1;
			for (int64_t ni = nb; ni < ne; ++ni) {
				const int64_t colBase = ni * TN, curN = n - colBase < TN ? n - colBase : TN;
				const bool seqC = false;
				LocalTensor<float> s = sQue.AllocTensor<float>();
				DataCopyExtParams sp{1, static_cast<uint32_t>(curN * 4), 0, 0, 0};
				DataCopyPadExtParams<float> spad{true, 0, 0, 0};
				DataCopyPad(s, scaleGm[ei * n + colBase], sp, spad);
				sQue.EnQue(s);
				s = sQue.DeQue<float>();
				if (subRowBegin < subRowEnd) {
					const int64_t azN = ((curN + 15) / 16) * 16, alignedN = ((curN + 7) / 8) * 8;
					const int64_t smRows = subRowEnd - subRowBegin < VC ? subRowEnd - subRowBegin : VC;
					for (int64_t rr = 0; rr < smRows; ++rr)
						Adds(sMul[rr * azN], s, 0.0f, azN);
					for (int64_t row = subRowBegin; row < subRowEnd; row += VC) {
						const int64_t rc = subRowEnd - row < VC ? subRowEnd - row : VC;
						LocalTensor<int32_t> c = cQue.AllocTensor<int32_t>();
						DataCopyExtParams cp{static_cast<uint16_t>(rc), static_cast<uint32_t>(curN * 4),
																 static_cast<uint32_t>((TN - curN) * 4),
																 static_cast<uint32_t>((azN - alignedN) / 8), 0};
						DataCopyPadExtParams<int32_t> cpad{true, 0, 0, 0};
						const int64_t cb = task * SK * TM * TN + row * TN;
						DataCopyPad(c, cGm[cb], cp, cpad);
						cQue.EnQue(c);
						c = cQue.DeQue<int32_t>();
						for (int part = 1; part < SK; ++part) {
							LocalTensor<int32_t> partial = partQue.AllocTensor<int32_t>();
							DataCopyPad(partial, cGm[cb + part * TM * TN], cp, cpad);
							partQue.EnQue(partial);
							partial = partQue.DeQue<int32_t>();
							Add(c, c, partial, rc * azN);
							PipeBarrier<PIPE_V>();
							partQue.FreeTensor(partial);
						}
						Cast(z, c, RoundMode::CAST_NONE, rc * azN);
						cQue.FreeTensor(c);
						PipeBarrier<PIPE_V>();
						Mul(z, z, sMul, rc * azN);
						GeluComputeSigmoid(z, u, rc * azN);
						PipeBarrier<PIPE_V>();
						LocalTensor<half> o = oQue.AllocTensor<half>();
						Cast(o, u, RoundMode::CAST_NONE, rc * azN);
						oQue.EnQue(o);
						o = oQue.DeQue<half>();
						DataCopyExtParams op{static_cast<uint16_t>(rc), static_cast<uint32_t>(curN * 2), 0,
																 static_cast<uint32_t>((n - curN) * 2), 0};
						DataCopyPad(yGm[(rowBase + row) * n + colBase], o, op);
						oQue.FreeTensor(o);
					}
				}
				sQue.FreeTensor(s);
				slot ^= 1;
				++iter;
			}
		}
	}
}

}
template <int PARTS>
__global__ __mix__(1, 2)
		__attribute__((aligned(64))) void bk493(GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR g, GM_ADDR y, GM_ADDR ws,
																						int64_t m, int64_t k, int64_t n, int64_t e, int64_t parts) {
	os_runtime::SplitRun<256, 128, 16, PARTS>(x, w, s, g, y, ws, m, k, n, e, parts);
}
#include "kernel_operator.h"

#include "adv_api/matmul/matmul.h"

#include "kernel_operator.h"

#include "adv_api/matmul/matmul.h"

#include "kernel_operator.h"

#include "adv_api/matmul/matmul.h"

namespace main_rank1_common {
using namespace AscendC;

__aicore__ inline uint32_t CoreGroupIndex() {
	if ASCEND_IS_AIC {
		return static_cast<uint32_t>(AscendC::GetBlockIdx());
	}
	return static_cast<uint32_t>(AscendC::GetBlockIdx() / AscendC::GetTaskRation());
}

__aicore__ inline uint32_t SubCoreIndex() {
	if ASCEND_IS_AIV {
		return static_cast<uint32_t>(AscendC::GetSubBlockIdx());
	}
	return 0;
}

__aicore__ inline int64_t CeilDiv(int64_t a, int64_t b) {
	return (a + b - 1) / b;
}

__aicore__ inline void GeluComputeSigmoid(const AscendC::LocalTensor<float> &z,
																					const AscendC::LocalTensor<float> &u, int32_t cnt) {
	using namespace AscendC;
	Mul(u, z, z, cnt);
	Mul(u, u, z, cnt);
	Muls(u, u, 0.044715f, cnt);
	Add(u, u, z, cnt);
	Muls(u, u, -1.5957691216057308f, cnt);
	Exp(u, u, cnt);
	Adds(u, u, 1.0f, cnt);
	Div(u, z, u, cnt);
}

template <int TM, int TN> struct Config {
	static_assert(TM % 16 == 0 && TN % 32 == 0, "Cube tile alignment");
	static_assert(TM * TN * 4 <= 128 * 1024, "L0C budget");
	using AType = AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, int8_t, false>;
	using BType = AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, int8_t, false>;
	using CType = AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, int32_t>;
	using BiasType = AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, int32_t>;
	static constexpr int32_t TILE_M = TM;
	static constexpr int32_t TILE_N = TN;
	static constexpr int32_t VEC_CHUNK_M = 16;
	static constexpr uint16_t GMM_SYNC_AIV_AIC = 3;
	static constexpr uint16_t GMM_SYNC_AIC_AIV = 5;
	static constexpr uint64_t SYNC_MODE2 = 2;
	static __aicore__ constexpr MatmulConfig MakeMatmulConfig() {
		MatmulConfig cfg{};
		cfg.doNorm = false;
		cfg.doBasicBlock = false;
		cfg.doMultiDataLoad = true;
		cfg.basicM = TILE_M;
		cfg.basicN = TILE_N;
		cfg.basicK = TN > 256 ? 64 : 128;
		cfg.intrinsicsCheck = false;
		cfg.isNBatch = false;
		cfg.enVecND2NZ = false;
		cfg.doSpecialBasicBlock = false;
		cfg.doMTE2Preload = 0;
		cfg.singleCoreM = TILE_M;
		cfg.singleCoreN = 1024;
		cfg.singleCoreK = 8192;
		cfg.stepM = 0;
		cfg.stepN = 0;
		cfg.baseMN = 0;
		cfg.singleCoreMN = 0;
		cfg.enUnitFlag = true;
		cfg.isPerTensor = false;
		cfg.hasAntiQuantOffset = false;
		cfg.doIBShareNorm = false;
		cfg.doSpecialMDL = false;
		cfg.enableInit = false;
		cfg.batchMode = BatchMode::NONE;
		cfg.enableEnd = true;
		cfg.enableGetTensorC = true;
		cfg.enableSetOrgShape = true;
		cfg.enableSetBias = false;
		cfg.enableSetTail = true;
		cfg.enableQuantVector = false;
		cfg.enableSetDefineData = false;
		cfg.iterateMode = IterateMode::ITERATE_MODE_DEFAULT;
		cfg.enableReuse = true;
		cfg.enableUBReuse = true;
		cfg.enableL1CacheUB = false;
		cfg.intraBlockPartSum = false;
		cfg.iterateOrder = IterateOrder::UNDEF;
		cfg.scheduleType = ScheduleType::INNER_PRODUCT;
		cfg.enableDoubleCache = false;
		cfg.isBiasBatch = true;
		cfg.enableStaticPadZeros = false;
		cfg.isA2B2Shared = false;
		cfg.enableKdimReorderLoad = false;
		cfg.isCO1Shared = false;
		return cfg;
	}
	static __aicore__ constexpr MatmulApiStaticTiling MakeStaticTiling() {
		MatmulApiStaticTiling tiling =
				AscendC::GetMatmulApiTiling<AType, BType, CType, BiasType>(MakeMatmulConfig());
		tiling.depthA1 = 8;
		tiling.depthB1 = 8;
		tiling.stepM = 1;
		tiling.stepN = 1;
		tiling.stepKa = 4;
		tiling.stepKb = 4;
		tiling.dbL0A = 2;
		tiling.dbL0B = 2;
		tiling.dbL0C = 1;
		return tiling;
	}
	constexpr static MatmulApiStaticTiling STATIC_TILING = MakeStaticTiling();
	using MM = AscendC::MatmulImpl<AType, BType, CType, BiasType, STATIC_TILING>;
};

}
namespace main_rank1_v32 {
using namespace main_rank1_common;

template <int TM, int TN, int VC = 16>
__aicore__ inline void TailRun(GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR group_list, GM_ADDR y,
															 GM_ADDR workspace, int64_t m, int64_t k, int64_t n, int64_t e,
															 const int32_t *cachedEnds = nullptr) {
	constexpr int TILE_M = TM, TILE_N = TN, VEC_CHUNK_M = VC;
	const int64_t mainK = (k / 128) * 128, KT = k - mainK;
	constexpr int MAX_TAIL = 1;
	constexpr uint16_t GMM_SYNC_AIV_AIC = 3, GMM_SYNC_AIC_AIV = 5;
	constexpr uint64_t SYNC_MODE2 = 2;
	const uint32_t coreNum = GetBlockNum(), coreIdx = CoreGroupIndex(), subIdx = SubCoreIndex();
	GlobalTensor<int8_t> xGm, wGm;
	GlobalTensor<float> scaleGm;
	GlobalTensor<int64_t> glGm;
	GlobalTensor<int32_t> cGm;
	GlobalTensor<half> yGm;
	xGm.SetGlobalBuffer((__gm__ int8_t *)x, m * k);
	wGm.SetGlobalBuffer((__gm__ int8_t *)weight, e * k * n);
	scaleGm.SetGlobalBuffer((__gm__ float *)scale, e * n);
	glGm.SetGlobalBuffer((__gm__ int64_t *)group_list, e);
	cGm.SetGlobalBuffer((__gm__ int32_t *)workspace, coreNum * 2 * TILE_M * TILE_N);
	yGm.SetGlobalBuffer((__gm__ half *)y, m * n);
	int32_t gl[128], prefix[128];
	int64_t totalMTiles = 0, prev = 0;
	for (int ei = 0; ei < e; ++ei) {
		const int64_t end = cachedEnds ? cachedEnds[ei] : glGm.GetValue(ei);
		gl[ei] = end;
		totalMTiles += CeilDiv(end - prev, TILE_M);
		prefix[ei] = totalMTiles;
		prev = end;
	}
	const int64_t NT = (n + TN - 1) / TN;
	const bool workAssign =
			(NT <= 4) && CeilDiv(totalMTiles, coreNum) * NT <= CeilDiv(totalMTiles * NT, coreNum);
	const int64_t tasks = workAssign ? totalMTiles : totalMTiles * NT;
	TPipe pipe;
	int64_t iter = 0, slot = 0;
	if ASCEND_IS_AIC {
		typename Config<TM, TN>::MM mm;
		mm.SetSubBlockIdx(0);
		mm.Init(static_cast<TCubeTiling *>(nullptr), &pipe);
		for (int64_t task = coreIdx; task < tasks; task += coreNum) {
			const int64_t mt = workAssign ? task : task / NT;
			int lo = 0, hi = e;
			while (lo < hi) {
				int mid = (lo + hi) / 2;
				if (prefix[mid] <= mt)
					lo = mid + 1;
				else
					hi = mid;
			}
			const int ei = lo;
			const int64_t start = ei ? gl[ei - 1] : 0, me = gl[ei] - start;
			const int64_t mi = mt - (ei ? prefix[ei - 1] : 0), rowBase = start + mi * TM;
			const int64_t curM = me - mi * TM < TM ? me - mi * TM : TM;
			const bool useTail = mainK >= 512 && KT > 0 && KT <= MAX_TAIL && curM <= 256 && curM * KT <= 1280;
			const int64_t nb = workAssign ? 0 : task % NT, ne = workAssign ? NT : nb + 1;
			for (int64_t ni = nb; ni < ne; ++ni) {
				const int64_t colBase = ni * TN, curN = n - colBase < TN ? n - colBase : TN;
				const bool seqC = false;
				if (iter >= 2)
					CrossCoreWaitFlag(GMM_SYNC_AIV_AIC);
				mm.SetOrgShape(me, n, k, k, TN);
				mm.SetSingleShape(curM, curN, useTail ? mainK : k);
				mm.SetTensorA(xGm[rowBase * k], false);
				mm.SetTensorB(wGm[ei * k * n + colBase], false);
				while (mm.Iterate())
					mm.GetTensorC(cGm[(coreIdx * 2 + slot) * TM * TN], 0, seqC);
				CrossCoreSetFlag<SYNC_MODE2, PIPE_FIX>(GMM_SYNC_AIC_AIV);
				slot ^= 1;
				++iter;
			}
		}
	} else {
		TQue<TPosition::VECIN, 1> cQue, sQue, aQue, bQue;
		TQue<TPosition::VECOUT, 1> oQue;
		TBuf<TPosition::VECCALC> zBuf, uBuf, bHalfBuf, bIntBuf, tailBuf, aGatherBuf, aRepeatBuf, aIndexBuf;
		constexpr uint32_t CHUNK_ELEMS = VC * TN;
		pipe.InitBuffer(cQue, 1, CHUNK_ELEMS * 4);
		pipe.InitBuffer(sQue, 1, TN * 4);
		pipe.InitBuffer(oQue, 1, CHUNK_ELEMS * 2);
		pipe.InitBuffer(zBuf, CHUNK_ELEMS * 4);
		pipe.InitBuffer(uBuf, CHUNK_ELEMS * 4);
		pipe.InitBuffer(aQue, 1, (TM / 2) * 32);
		pipe.InitBuffer(bQue, 1, MAX_TAIL * TN);
		pipe.InitBuffer(bHalfBuf, MAX_TAIL * TN * 2);
		pipe.InitBuffer(bIntBuf, MAX_TAIL * TN * 4);
		pipe.InitBuffer(tailBuf, (TM / 2) * TN * 4);
		pipe.InitBuffer(aGatherBuf, (TM / 2) * 4);
		pipe.InitBuffer(aRepeatBuf, (TM / 2) * 8 * 4);
		pipe.InitBuffer(aIndexBuf, (TM / 2) * 4);
		LocalTensor<half> ah = zBuf.Get<half>();
		LocalTensor<int32_t> ai = uBuf.Get<int32_t>();
		LocalTensor<int32_t> ag = aGatherBuf.Get<int32_t>(), ar = aRepeatBuf.Get<int32_t>();
		LocalTensor<int32_t> index = aIndexBuf.Get<int32_t>();
		CreateVecIndex(index, static_cast<int32_t>(0), TM / 2);
		PipeBarrier<PIPE_V>();
		Muls(index, index, static_cast<int32_t>(128), TM / 2);
		PipeBarrier<PIPE_V>();
		LocalTensor<half> bh = bHalfBuf.Get<half>();
		LocalTensor<int32_t> bi = bIntBuf.Get<int32_t>(), tail = tailBuf.Get<int32_t>();
		LocalTensor<float> z = zBuf.Get<float>(), u = uBuf.Get<float>();
		for (int64_t task = coreIdx; task < tasks; task += coreNum) {
			const int64_t mt = workAssign ? task : task / NT;
			int lo = 0, hi = e;
			while (lo < hi) {
				int mid = (lo + hi) / 2;
				if (prefix[mid] <= mt)
					lo = mid + 1;
				else
					hi = mid;
			}
			const int ei = lo;
			const int64_t start = ei ? gl[ei - 1] : 0, me = gl[ei] - start;
			const int64_t mi = mt - (ei ? prefix[ei - 1] : 0), rowBase = start + mi * TM;
			const int64_t curM = me - mi * TM < TM ? me - mi * TM : TM;
			const bool useTail = mainK >= 512 && KT > 0 && KT <= MAX_TAIL && curM <= 256 && curM * KT <= 1280;
			const int64_t rowsPerSub = (curM + 1) / 2, subRowBegin = subIdx * rowsPerSub;
			const int64_t subRowEnd = subRowBegin < curM
																		? (subRowBegin + rowsPerSub < curM ? subRowBegin + rowsPerSub : curM)
																		: subRowBegin;
			const int64_t nb = workAssign ? 0 : task % NT, ne = workAssign ? NT : nb + 1;
			for (int64_t ni = nb; ni < ne; ++ni) {
				const int64_t colBase = ni * TN, curN = n - colBase < TN ? n - colBase : TN;
				const bool seqC = false;
				LocalTensor<float> s = sQue.AllocTensor<float>();
				DataCopyExtParams sp{1, static_cast<uint32_t>(curN * 4), 0, 0, 0};
				DataCopyPadExtParams<float> spad{true, 0, 0, 0};
				DataCopyPad(s, scaleGm[ei * n + colBase], sp, spad);
				sQue.EnQue(s);
				const int64_t azTail = ((curN + 15) / 16) * 16;
				const int64_t nrows = subRowEnd - subRowBegin;
				if (nrows > 0 && useTail) {
					LocalTensor<int8_t> bt = bQue.AllocTensor<int8_t>();
					DataCopyExtParams bp{static_cast<uint16_t>(KT), static_cast<uint32_t>(curN),
															 static_cast<uint32_t>(n - curN),
															 static_cast<uint32_t>((TN - ((curN + 31) / 32) * 32) / 32), 0};
					DataCopyPadExtParams<int8_t> pad{true, 0, 0, 0};
					DataCopyPad(bt, wGm[ei * k * n + mainK * n + colBase], bp, pad);
					bQue.EnQue(bt);
					bt = bQue.DeQue<int8_t>();
					Cast(bh, bt, RoundMode::CAST_NONE, KT * TN);
					PipeBarrier<PIPE_V>();
					Cast(bi, bh, RoundMode::CAST_RINT, KT * TN);
					bQue.FreeTensor(bt);
					LocalTensor<int8_t> at = aQue.AllocTensor<int8_t>();
					DataCopyExtParams ap{static_cast<uint16_t>(nrows), static_cast<uint32_t>(KT),
															 static_cast<uint32_t>(k - KT), 0, 0};
					DataCopyPad(at, xGm[(rowBase + subRowBegin) * k + mainK], ap, pad);
					aQue.EnQue(at);
					at = aQue.DeQue<int8_t>();
					Cast(ah, at, RoundMode::CAST_NONE, nrows * 32);
					PipeBarrier<PIPE_V>();
					Cast(ai, ah, RoundMode::CAST_RINT, nrows * 32);
					PipeBarrier<PIPE_V>();
					LocalTensor<int32_t> tmp = zBuf.Get<int32_t>();
					const int64_t roundedRows = ((nrows + 7) / 8) * 8;
					BinaryRepeatParams outer{1, 0, 1, static_cast<uint8_t>(azTail / 8), 1, 0};
					for (int64_t kk = 0; kk < KT; ++kk) {
						Gather(ag, ai, index.ReinterpretCast<uint32_t>(), kk * 4, roundedRows);
						PipeBarrier<PIPE_V>();
						Brcb(ar, ag, static_cast<uint8_t>(roundedRows / 8), BrcbRepeatParams{1, 8});
						PipeBarrier<PIPE_V>();
						for (int64_t rr = 0; rr < nrows; rr += VC) {
							const int64_t rc = nrows - rr < VC ? nrows - rr : VC;
							LocalTensor<int32_t> dest = kk == 0 ? tail[rr * azTail] : tmp;
							for (int64_t col = 0; col < azTail; col += 64) {
								const uint64_t mask = azTail - col < 64 ? azTail - col : 64;
								Mul(dest[col], ar[rr * 8], bi[kk * TN + col], mask, static_cast<uint8_t>(rc), outer);
							}
							if (kk > 0) {
								PipeBarrier<PIPE_V>();
								Add(tail[rr * azTail], tail[rr * azTail], tmp, rc * azTail);
								PipeBarrier<PIPE_V>();
							}
						}
						PipeBarrier<PIPE_V>();
					}
					aQue.FreeTensor(at);
				}
				CrossCoreWaitFlag(GMM_SYNC_AIC_AIV);
				s = sQue.DeQue<float>();
				if (subRowBegin < subRowEnd) {
					const int64_t azN = ((curN + 15) / 16) * 16, alignedN = ((curN + 7) / 8) * 8;
					const int64_t smRows = subRowEnd - subRowBegin < VC ? subRowEnd - subRowBegin : VC;
					for (int64_t row = subRowBegin; row < subRowEnd; row += VC) {
						const int64_t rc = subRowEnd - row < VC ? subRowEnd - row : VC;
						LocalTensor<int32_t> c = cQue.AllocTensor<int32_t>();
						DataCopyExtParams cp{static_cast<uint16_t>(rc), static_cast<uint32_t>(curN * 4),
																 static_cast<uint32_t>((TN - curN) * 4),
																 static_cast<uint32_t>((azN - alignedN) / 8), 0};
						DataCopyPadExtParams<int32_t> cpad{true, 0, 0, 0};
						const int64_t cb = (coreIdx * 2 + slot) * TM * TN + row * TN;
						DataCopyPad(c, cGm[cb], cp, cpad);
						cQue.EnQue(c);
						c = cQue.DeQue<int32_t>();
						if (useTail) {
							Add(c, c, tail[(row - subRowBegin) * azN], rc * azN);
							PipeBarrier<PIPE_V>();
						}
						Cast(z, c, RoundMode::CAST_NONE, rc * azN);
						cQue.FreeTensor(c);
						PipeBarrier<PIPE_V>();
						BinaryRepeatParams bp{1, 1, 1, static_cast<uint8_t>(azN / 8), static_cast<uint8_t>(azN / 8), 0};
						for (int64_t col = 0; col < azN; col += 64) {
							uint64_t mask = azN - col < 64 ? azN - col : 64;
							Mul(z[col], z[col], s[col], mask, static_cast<uint8_t>(rc), bp);
						}
						PipeBarrier<PIPE_V>();
						GeluComputeSigmoid(z, u, rc * azN);
						PipeBarrier<PIPE_V>();
						LocalTensor<half> o = oQue.AllocTensor<half>();
						Cast(o, u, RoundMode::CAST_NONE, rc * azN);
						oQue.EnQue(o);
						o = oQue.DeQue<half>();
						DataCopyExtParams op{static_cast<uint16_t>(rc), static_cast<uint32_t>(curN * 2), 0,
																 static_cast<uint32_t>((n - curN) * 2), 0};
						DataCopyPad(yGm[(rowBase + row) * n + colBase], o, op);
						oQue.FreeTensor(o);
					}
				}
				sQue.FreeTensor(s);
				CrossCoreSetFlag<SYNC_MODE2, PIPE_MTE2>(GMM_SYNC_AIV_AIC);
				slot ^= 1;
				++iter;
			}
		}
	}
}

}
#include "kernel_operator.h"

#include "adv_api/matmul/matmul.h"

namespace os_tile320_runtime {
using namespace AscendC;

__aicore__ inline uint32_t CoreGroupIndex() {
	if ASCEND_IS_AIC {
		return static_cast<uint32_t>(AscendC::GetBlockIdx());
	}
	return static_cast<uint32_t>(AscendC::GetBlockIdx() / AscendC::GetTaskRation());
}

__aicore__ inline uint32_t SubCoreIndex() {
	if ASCEND_IS_AIV {
		return static_cast<uint32_t>(AscendC::GetSubBlockIdx());
	}
	return 0;
}

__aicore__ inline int64_t CeilDiv(int64_t a, int64_t b) {
	return (a + b - 1) / b;
}

__aicore__ inline void GeluComputeSigmoid(const AscendC::LocalTensor<float> &z,
																					const AscendC::LocalTensor<float> &u, int32_t cnt) {
	using namespace AscendC;
	Mul(u, z, z, cnt);
	Mul(u, u, z, cnt);
	Muls(u, u, 0.044715f, cnt);
	Add(u, u, z, cnt);
	Muls(u, u, -1.5957691216057308f, cnt);
	Exp(u, u, cnt);
	Adds(u, u, 1.0f, cnt);
	Div(u, z, u, cnt);
}

template <int TM, int TN> struct Config {
	static_assert(TM % 16 == 0 && TN % 32 == 0, "Cube tile alignment");
	static_assert(TM * TN * 4 <= 128 * 1024, "L0C budget");
	using AType = AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, int8_t, false>;
	using BType = AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, int8_t, false>;
	using CType = AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, int32_t>;
	using BiasType = AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, int32_t>;
	static constexpr int32_t TILE_M = TM;
	static constexpr int32_t TILE_N = TN;
	static constexpr int32_t VEC_CHUNK_M = 16;
	static constexpr uint16_t GMM_SYNC_AIV_AIC = 3;
	static constexpr uint16_t GMM_SYNC_AIC_AIV = 5;
	static constexpr uint64_t SYNC_MODE2 = 2;
	static __aicore__ constexpr MatmulConfig MakeMatmulConfig() {
		MatmulConfig cfg{};
		cfg.doNorm = false;
		cfg.doBasicBlock = false;
		cfg.doMultiDataLoad = true;
		cfg.basicM = TILE_M;
		cfg.basicN = TILE_N;
		cfg.basicK = 128;
		cfg.intrinsicsCheck = false;
		cfg.isNBatch = false;
		cfg.enVecND2NZ = false;
		cfg.doSpecialBasicBlock = false;
		cfg.doMTE2Preload = 0;
		cfg.singleCoreM = TILE_M;
		cfg.singleCoreN = 1024;
		cfg.singleCoreK = 8192;
		cfg.stepM = 0;
		cfg.stepN = 0;
		cfg.baseMN = 0;
		cfg.singleCoreMN = 0;
		cfg.enUnitFlag = true;
		cfg.isPerTensor = false;
		cfg.hasAntiQuantOffset = false;
		cfg.doIBShareNorm = false;
		cfg.doSpecialMDL = false;
		cfg.enableInit = false;
		cfg.batchMode = BatchMode::NONE;
		cfg.enableEnd = true;
		cfg.enableGetTensorC = true;
		cfg.enableSetOrgShape = true;
		cfg.enableSetBias = false;
		cfg.enableSetTail = true;
		cfg.enableQuantVector = false;
		cfg.enableSetDefineData = false;
		cfg.iterateMode = IterateMode::ITERATE_MODE_DEFAULT;
		cfg.enableReuse = true;
		cfg.enableUBReuse = true;
		cfg.enableL1CacheUB = false;
		cfg.intraBlockPartSum = false;
		cfg.iterateOrder = IterateOrder::UNDEF;
		cfg.scheduleType = ScheduleType::INNER_PRODUCT;
		cfg.enableDoubleCache = false;
		cfg.isBiasBatch = true;
		cfg.enableStaticPadZeros = false;
		cfg.isA2B2Shared = false;
		cfg.enableKdimReorderLoad = false;
		cfg.isCO1Shared = false;
		return cfg;
	}
	static __aicore__ constexpr MatmulApiStaticTiling MakeStaticTiling() {
		MatmulApiStaticTiling tiling =
				AscendC::GetMatmulApiTiling<AType, BType, CType, BiasType>(MakeMatmulConfig());
		tiling.depthA1 = 8;
		tiling.depthB1 = 8;
		tiling.stepM = 1;
		tiling.stepN = 1;
		tiling.stepKa = 4;
		tiling.stepKb = 4;
		tiling.dbL0A = 2;
		tiling.dbL0B = TN * 128 * 2 > 64 * 1024 ? 1 : 2;
		tiling.dbL0C = 1;
		return tiling;
	}
	constexpr static MatmulApiStaticTiling STATIC_TILING = MakeStaticTiling();
	using MM = AscendC::MatmulImpl<AType, BType, CType, BiasType, STATIC_TILING>;
};

template <int TM, int TN, int VC = 16, bool ROTATE = false>
__aicore__ inline void Run(GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR group_list, GM_ADDR y,
													 GM_ADDR workspace, int64_t m, int64_t k, int64_t n, int64_t e,
													 const int32_t *cachedEnds = nullptr) {
	constexpr int TILE_M = TM, TILE_N = TN, VEC_CHUNK_M = VC;
	constexpr uint16_t GMM_SYNC_AIV_AIC = 3, GMM_SYNC_AIC_AIV = 5;
	constexpr uint64_t SYNC_MODE2 = 2;
	const uint32_t coreNum = GetBlockNum(), coreIdx = CoreGroupIndex(), subIdx = SubCoreIndex();
	GlobalTensor<int8_t> xGm, wGm;
	GlobalTensor<float> scaleGm;
	GlobalTensor<int64_t> glGm;
	GlobalTensor<int32_t> cGm;
	GlobalTensor<half> yGm;
	xGm.SetGlobalBuffer((__gm__ int8_t *)x, m * k);
	wGm.SetGlobalBuffer((__gm__ int8_t *)weight, e * k * n);
	scaleGm.SetGlobalBuffer((__gm__ float *)scale, e * n);
	glGm.SetGlobalBuffer((__gm__ int64_t *)group_list, e);
	cGm.SetGlobalBuffer((__gm__ int32_t *)workspace, coreNum * 2 * TILE_M * TILE_N);
	yGm.SetGlobalBuffer((__gm__ half *)y, m * n);
	int32_t gl[128], prefix[128];
	int64_t totalMTiles = 0, prev = 0;
	for (int ei = 0; ei < e; ++ei) {
		const int64_t end = cachedEnds ? cachedEnds[ei] : glGm.GetValue(ei);
		gl[ei] = end;
		totalMTiles += CeilDiv(end - prev, TILE_M);
		prefix[ei] = totalMTiles;
		prev = end;
	}
	const int64_t NT = (n + TN - 1) / TN;
	const bool workAssign =
			(NT <= 4) && CeilDiv(totalMTiles, coreNum) * NT <= CeilDiv(totalMTiles * NT, coreNum);
	const int64_t tasks = workAssign ? totalMTiles : totalMTiles * NT;
	TPipe pipe;
	int64_t iter = 0, slot = 0;
	if ASCEND_IS_AIC {
		typename Config<TM, TN>::MM mm;
		mm.SetSubBlockIdx(0);
		mm.Init(static_cast<TCubeTiling *>(nullptr), &pipe);
		for (int64_t cursor = ROTATE ? 0 : coreIdx; cursor < tasks; cursor += coreNum) {
			const int64_t lane =
					ROTATE && !workAssign ? (coreIdx + coreNum - (cursor / coreNum) % coreNum) % coreNum : coreIdx;
			const int64_t task = ROTATE ? cursor + lane : cursor;
			if (task >= tasks)
				continue;
			const int64_t mt = workAssign ? task : task / NT;
			int lo = 0, hi = e;
			while (lo < hi) {
				int mid = (lo + hi) / 2;
				if (prefix[mid] <= mt)
					lo = mid + 1;
				else
					hi = mid;
			}
			const int ei = lo;
			const int64_t start = ei ? gl[ei - 1] : 0, me = gl[ei] - start;
			const int64_t mi = mt - (ei ? prefix[ei - 1] : 0), rowBase = start + mi * TM;
			const int64_t curM = me - mi * TM < TM ? me - mi * TM : TM;
			const int64_t nb = workAssign ? 0 : task % NT, ne = workAssign ? NT : nb + 1;
			for (int64_t ni = nb; ni < ne; ++ni) {
				const int64_t colBase = ni * TN, curN = n - colBase < TN ? n - colBase : TN;
				const bool seqC = false;
				if (iter >= 2)
					CrossCoreWaitFlag(GMM_SYNC_AIV_AIC);
				mm.SetOrgShape(me, n, k, k, TN);
				mm.SetSingleShape(curM, curN, k);
				mm.SetTensorA(xGm[rowBase * k], false);
				mm.SetTensorB(wGm[ei * k * n + colBase], false);
				while (mm.Iterate())
					mm.GetTensorC(cGm[(coreIdx * 2 + slot) * TM * TN], 0, seqC);
				CrossCoreSetFlag<SYNC_MODE2, PIPE_FIX>(GMM_SYNC_AIC_AIV);
				slot ^= 1;
				++iter;
			}
		}
	} else {
		TQue<TPosition::VECIN, 1> cQue, sQue;
		TQue<TPosition::VECOUT, 1> oQue;
		TBuf<TPosition::VECCALC> zBuf, uBuf;
		constexpr uint32_t CHUNK_ELEMS = VC * TN;
		pipe.InitBuffer(cQue, 1, CHUNK_ELEMS * 4);
		pipe.InitBuffer(sQue, 1, TN * 4);
		pipe.InitBuffer(oQue, 1, CHUNK_ELEMS * 2);
		pipe.InitBuffer(zBuf, CHUNK_ELEMS * 4);
		pipe.InitBuffer(uBuf, CHUNK_ELEMS * 4);
		LocalTensor<float> z = zBuf.Get<float>(), u = uBuf.Get<float>();
		for (int64_t cursor = ROTATE ? 0 : coreIdx; cursor < tasks; cursor += coreNum) {
			const int64_t lane =
					ROTATE && !workAssign ? (coreIdx + coreNum - (cursor / coreNum) % coreNum) % coreNum : coreIdx;
			const int64_t task = ROTATE ? cursor + lane : cursor;
			if (task >= tasks)
				continue;
			const int64_t mt = workAssign ? task : task / NT;
			int lo = 0, hi = e;
			while (lo < hi) {
				int mid = (lo + hi) / 2;
				if (prefix[mid] <= mt)
					lo = mid + 1;
				else
					hi = mid;
			}
			const int ei = lo;
			const int64_t start = ei ? gl[ei - 1] : 0, me = gl[ei] - start;
			const int64_t mi = mt - (ei ? prefix[ei - 1] : 0), rowBase = start + mi * TM;
			const int64_t curM = me - mi * TM < TM ? me - mi * TM : TM;
			const int64_t rowsPerSub = (curM + 1) / 2, subRowBegin = subIdx * rowsPerSub;
			const int64_t subRowEnd = subRowBegin < curM
																		? (subRowBegin + rowsPerSub < curM ? subRowBegin + rowsPerSub : curM)
																		: subRowBegin;
			const int64_t nb = workAssign ? 0 : task % NT, ne = workAssign ? NT : nb + 1;
			for (int64_t ni = nb; ni < ne; ++ni) {
				const int64_t colBase = ni * TN, curN = n - colBase < TN ? n - colBase : TN;
				const bool seqC = false;
				LocalTensor<float> s = sQue.AllocTensor<float>();
				DataCopyExtParams sp{1, static_cast<uint32_t>(curN * 4), 0, 0, 0};
				DataCopyPadExtParams<float> spad{true, 0, 0, 0};
				DataCopyPad(s, scaleGm[ei * n + colBase], sp, spad);
				sQue.EnQue(s);
				CrossCoreWaitFlag(GMM_SYNC_AIC_AIV);
				s = sQue.DeQue<float>();
				if (subRowBegin < subRowEnd) {
					const int64_t azN = ((curN + 15) / 16) * 16, alignedN = ((curN + 7) / 8) * 8;
					const int64_t smRows = subRowEnd - subRowBegin < VC ? subRowEnd - subRowBegin : VC;
					for (int64_t row = subRowBegin; row < subRowEnd; row += VC) {
						const int64_t rc = subRowEnd - row < VC ? subRowEnd - row : VC;
						LocalTensor<int32_t> c = cQue.AllocTensor<int32_t>();
						DataCopyExtParams cp{static_cast<uint16_t>(rc), static_cast<uint32_t>(curN * 4),
																 static_cast<uint32_t>((TN - curN) * 4),
																 static_cast<uint32_t>((azN - alignedN) / 8), 0};
						DataCopyPadExtParams<int32_t> cpad{true, 0, 0, 0};
						const int64_t cb = (coreIdx * 2 + slot) * TM * TN + row * TN;
						DataCopyPad(c, cGm[cb], cp, cpad);
						cQue.EnQue(c);
						c = cQue.DeQue<int32_t>();
						Cast(z, c, RoundMode::CAST_NONE, rc * azN);
						cQue.FreeTensor(c);
						PipeBarrier<PIPE_V>();
						BinaryRepeatParams bp{1, 1, 1, static_cast<uint8_t>(azN / 8), static_cast<uint8_t>(azN / 8), 0};
						for (int64_t col = 0; col < azN; col += 64) {
							uint64_t mask = azN - col < 64 ? azN - col : 64;
							Mul(z[col], z[col], s[col], mask, static_cast<uint8_t>(rc), bp);
						}
						PipeBarrier<PIPE_V>();
						GeluComputeSigmoid(z, u, rc * azN);
						PipeBarrier<PIPE_V>();
						LocalTensor<half> o = oQue.AllocTensor<half>();
						Cast(o, u, RoundMode::CAST_NONE, rc * azN);
						oQue.EnQue(o);
						o = oQue.DeQue<half>();
						DataCopyExtParams op{static_cast<uint16_t>(rc), static_cast<uint32_t>(curN * 2), 0,
																 static_cast<uint32_t>((n - curN) * 2), 0};
						DataCopyPad(yGm[(rowBase + row) * n + colBase], o, op);
						oQue.FreeTensor(o);
					}
				}
				sQue.FreeTensor(s);
				CrossCoreSetFlag<SYNC_MODE2, PIPE_MTE2>(GMM_SYNC_AIV_AIC);
				slot ^= 1;
				++iter;
			}
		}
	}
}

template <int TM, int TN, int VC = 16>
__aicore__ inline void TailRun(GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR group_list, GM_ADDR y,
															 GM_ADDR workspace, int64_t m, int64_t k, int64_t n, int64_t e,
															 const int32_t *cachedEnds = nullptr) {
	constexpr int TILE_M = TM, TILE_N = TN, VEC_CHUNK_M = VC;
	const int64_t mainK = (k / 128) * 128, KT = k - mainK;
	constexpr int MAX_TAIL = 8;
	constexpr uint16_t GMM_SYNC_AIV_AIC = 3, GMM_SYNC_AIC_AIV = 5;
	constexpr uint64_t SYNC_MODE2 = 2;
	const uint32_t coreNum = GetBlockNum(), coreIdx = CoreGroupIndex(), subIdx = SubCoreIndex();
	GlobalTensor<int8_t> xGm, wGm;
	GlobalTensor<float> scaleGm;
	GlobalTensor<int64_t> glGm;
	GlobalTensor<int32_t> cGm;
	GlobalTensor<half> yGm;
	xGm.SetGlobalBuffer((__gm__ int8_t *)x, m * k);
	wGm.SetGlobalBuffer((__gm__ int8_t *)weight, e * k * n);
	scaleGm.SetGlobalBuffer((__gm__ float *)scale, e * n);
	glGm.SetGlobalBuffer((__gm__ int64_t *)group_list, e);
	cGm.SetGlobalBuffer((__gm__ int32_t *)workspace, coreNum * 2 * TILE_M * TILE_N);
	yGm.SetGlobalBuffer((__gm__ half *)y, m * n);
	int32_t gl[128], prefix[128];
	int64_t totalMTiles = 0, prev = 0;
	for (int ei = 0; ei < e; ++ei) {
		const int64_t end = cachedEnds ? cachedEnds[ei] : glGm.GetValue(ei);
		gl[ei] = end;
		totalMTiles += CeilDiv(end - prev, TILE_M);
		prefix[ei] = totalMTiles;
		prev = end;
	}
	const int64_t NT = (n + TN - 1) / TN;
	const bool workAssign =
			(NT <= 4) && CeilDiv(totalMTiles, coreNum) * NT <= CeilDiv(totalMTiles * NT, coreNum);
	const int64_t tasks = workAssign ? totalMTiles : totalMTiles * NT;
	TPipe pipe;
	int64_t iter = 0, slot = 0;
	if ASCEND_IS_AIC {
		typename Config<TM, TN>::MM mm;
		mm.SetSubBlockIdx(0);
		mm.Init(static_cast<TCubeTiling *>(nullptr), &pipe);
		for (int64_t task = coreIdx; task < tasks; task += coreNum) {
			const int64_t mt = workAssign ? task : task / NT;
			int lo = 0, hi = e;
			while (lo < hi) {
				int mid = (lo + hi) / 2;
				if (prefix[mid] <= mt)
					lo = mid + 1;
				else
					hi = mid;
			}
			const int ei = lo;
			const int64_t start = ei ? gl[ei - 1] : 0, me = gl[ei] - start;
			const int64_t mi = mt - (ei ? prefix[ei - 1] : 0), rowBase = start + mi * TM;
			const int64_t curM = me - mi * TM < TM ? me - mi * TM : TM;
			const bool useTail = mainK >= 1024 && KT > 0 && KT <= MAX_TAIL && curM <= 256 && curM * KT <= 1280;
			const int64_t nb = workAssign ? 0 : task % NT, ne = workAssign ? NT : nb + 1;
			for (int64_t ni = nb; ni < ne; ++ni) {
				const int64_t colBase = ni * TN, curN = n - colBase < TN ? n - colBase : TN;
				const bool seqC = false;
				if (iter >= 2)
					CrossCoreWaitFlag(GMM_SYNC_AIV_AIC);
				mm.SetOrgShape(me, n, k, k, TN);
				mm.SetSingleShape(curM, curN, useTail ? mainK : k);
				mm.SetTensorA(xGm[rowBase * k], false);
				mm.SetTensorB(wGm[ei * k * n + colBase], false);
				while (mm.Iterate())
					mm.GetTensorC(cGm[(coreIdx * 2 + slot) * TM * TN], 0, seqC);
				CrossCoreSetFlag<SYNC_MODE2, PIPE_FIX>(GMM_SYNC_AIC_AIV);
				slot ^= 1;
				++iter;
			}
		}
	} else {
		TQue<TPosition::VECIN, 1> cQue, sQue, aQue, bQue;
		TQue<TPosition::VECOUT, 1> oQue;
		TBuf<TPosition::VECCALC> zBuf, uBuf, bHalfBuf, bIntBuf, tailBuf, aHalfBuf, aIntBuf, aGatherBuf,
				aRepeatBuf, aIndexBuf;
		constexpr uint32_t CHUNK_ELEMS = VC * TN;
		pipe.InitBuffer(cQue, 1, CHUNK_ELEMS * 4);
		pipe.InitBuffer(sQue, 1, TN * 4);
		pipe.InitBuffer(oQue, 1, CHUNK_ELEMS * 2);
		pipe.InitBuffer(zBuf, CHUNK_ELEMS * 4);
		pipe.InitBuffer(uBuf, CHUNK_ELEMS * 4);
		pipe.InitBuffer(aQue, 1, (TM / 2) * 32);
		pipe.InitBuffer(bQue, 1, MAX_TAIL * TN);
		pipe.InitBuffer(bHalfBuf, MAX_TAIL * TN * 2);
		pipe.InitBuffer(bIntBuf, MAX_TAIL * TN * 4);
		pipe.InitBuffer(tailBuf, (TM / 2) * TN * 4);
		pipe.InitBuffer(aHalfBuf, (TM / 2) * 32 * 2);
		pipe.InitBuffer(aIntBuf, (TM / 2) * 32 * 4);
		pipe.InitBuffer(aGatherBuf, (TM / 2) * 4);
		pipe.InitBuffer(aRepeatBuf, (TM / 2) * 8 * 4);
		pipe.InitBuffer(aIndexBuf, (TM / 2) * 4);
		LocalTensor<half> ah = aHalfBuf.Get<half>();
		LocalTensor<int32_t> ai = aIntBuf.Get<int32_t>();
		LocalTensor<int32_t> ag = aGatherBuf.Get<int32_t>(), ar = aRepeatBuf.Get<int32_t>();
		LocalTensor<int32_t> index = aIndexBuf.Get<int32_t>();
		CreateVecIndex(index, static_cast<int32_t>(0), TM / 2);
		PipeBarrier<PIPE_V>();
		Muls(index, index, static_cast<int32_t>(128), TM / 2);
		PipeBarrier<PIPE_V>();
		LocalTensor<half> bh = bHalfBuf.Get<half>();
		LocalTensor<int32_t> bi = bIntBuf.Get<int32_t>(), tail = tailBuf.Get<int32_t>();
		LocalTensor<float> z = zBuf.Get<float>(), u = uBuf.Get<float>();
		for (int64_t task = coreIdx; task < tasks; task += coreNum) {
			const int64_t mt = workAssign ? task : task / NT;
			int lo = 0, hi = e;
			while (lo < hi) {
				int mid = (lo + hi) / 2;
				if (prefix[mid] <= mt)
					lo = mid + 1;
				else
					hi = mid;
			}
			const int ei = lo;
			const int64_t start = ei ? gl[ei - 1] : 0, me = gl[ei] - start;
			const int64_t mi = mt - (ei ? prefix[ei - 1] : 0), rowBase = start + mi * TM;
			const int64_t curM = me - mi * TM < TM ? me - mi * TM : TM;
			const bool useTail = mainK >= 1024 && KT > 0 && KT <= MAX_TAIL && curM <= 256 && curM * KT <= 1280;
			const int64_t rowsPerSub = (curM + 1) / 2, subRowBegin = subIdx * rowsPerSub;
			const int64_t subRowEnd = subRowBegin < curM
																		? (subRowBegin + rowsPerSub < curM ? subRowBegin + rowsPerSub : curM)
																		: subRowBegin;
			const int64_t nb = workAssign ? 0 : task % NT, ne = workAssign ? NT : nb + 1;
			for (int64_t ni = nb; ni < ne; ++ni) {
				const int64_t colBase = ni * TN, curN = n - colBase < TN ? n - colBase : TN;
				const bool seqC = false;
				LocalTensor<float> s = sQue.AllocTensor<float>();
				DataCopyExtParams sp{1, static_cast<uint32_t>(curN * 4), 0, 0, 0};
				DataCopyPadExtParams<float> spad{true, 0, 0, 0};
				DataCopyPad(s, scaleGm[ei * n + colBase], sp, spad);
				sQue.EnQue(s);
				const int64_t azTail = ((curN + 15) / 16) * 16;
				const int64_t nrows = subRowEnd - subRowBegin;
				if (nrows > 0 && useTail) {
					LocalTensor<int8_t> bt = bQue.AllocTensor<int8_t>();
					DataCopyExtParams bp{static_cast<uint16_t>(KT), static_cast<uint32_t>(curN),
															 static_cast<uint32_t>(n - curN),
															 static_cast<uint32_t>((TN - ((curN + 31) / 32) * 32) / 32), 0};
					DataCopyPadExtParams<int8_t> pad{true, 0, 0, 0};
					DataCopyPad(bt, wGm[ei * k * n + mainK * n + colBase], bp, pad);
					bQue.EnQue(bt);
					bt = bQue.DeQue<int8_t>();
					Cast(bh, bt, RoundMode::CAST_NONE, KT * TN);
					PipeBarrier<PIPE_V>();
					Cast(bi, bh, RoundMode::CAST_RINT, KT * TN);
					bQue.FreeTensor(bt);
					LocalTensor<int8_t> at = aQue.AllocTensor<int8_t>();
					DataCopyExtParams ap{static_cast<uint16_t>(nrows), static_cast<uint32_t>(KT),
															 static_cast<uint32_t>(k - KT), 0, 0};
					DataCopyPad(at, xGm[(rowBase + subRowBegin) * k + mainK], ap, pad);
					aQue.EnQue(at);
					at = aQue.DeQue<int8_t>();
					Cast(ah, at, RoundMode::CAST_NONE, nrows * 32);
					PipeBarrier<PIPE_V>();
					Cast(ai, ah, RoundMode::CAST_RINT, nrows * 32);
					PipeBarrier<PIPE_V>();
					LocalTensor<int32_t> tmp = zBuf.Get<int32_t>();
					const int64_t roundedRows = ((nrows + 7) / 8) * 8;
					BinaryRepeatParams outer{1, 0, 1, static_cast<uint8_t>(azTail / 8), 1, 0};
					for (int64_t kk = 0; kk < KT; ++kk) {
						Gather(ag, ai, index.ReinterpretCast<uint32_t>(), kk * 4, roundedRows);
						PipeBarrier<PIPE_V>();
						Brcb(ar, ag, static_cast<uint8_t>(roundedRows / 8), BrcbRepeatParams{1, 8});
						PipeBarrier<PIPE_V>();
						for (int64_t rr = 0; rr < nrows; rr += VC) {
							const int64_t rc = nrows - rr < VC ? nrows - rr : VC;
							LocalTensor<int32_t> dest = kk == 0 ? tail[rr * azTail] : tmp;
							for (int64_t col = 0; col < azTail; col += 64) {
								const uint64_t mask = azTail - col < 64 ? azTail - col : 64;
								Mul(dest[col], ar[rr * 8], bi[kk * TN + col], mask, static_cast<uint8_t>(rc), outer);
							}
							if (kk > 0) {
								PipeBarrier<PIPE_V>();
								Add(tail[rr * azTail], tail[rr * azTail], tmp, rc * azTail);
								PipeBarrier<PIPE_V>();
							}
						}
						PipeBarrier<PIPE_V>();
					}
					aQue.FreeTensor(at);
				}
				CrossCoreWaitFlag(GMM_SYNC_AIC_AIV);
				s = sQue.DeQue<float>();
				if (subRowBegin < subRowEnd) {
					const int64_t azN = ((curN + 15) / 16) * 16, alignedN = ((curN + 7) / 8) * 8;
					const int64_t smRows = subRowEnd - subRowBegin < VC ? subRowEnd - subRowBegin : VC;
					for (int64_t row = subRowBegin; row < subRowEnd; row += VC) {
						const int64_t rc = subRowEnd - row < VC ? subRowEnd - row : VC;
						LocalTensor<int32_t> c = cQue.AllocTensor<int32_t>();
						DataCopyExtParams cp{static_cast<uint16_t>(rc), static_cast<uint32_t>(curN * 4),
																 static_cast<uint32_t>((TN - curN) * 4),
																 static_cast<uint32_t>((azN - alignedN) / 8), 0};
						DataCopyPadExtParams<int32_t> cpad{true, 0, 0, 0};
						const int64_t cb = (coreIdx * 2 + slot) * TM * TN + row * TN;
						DataCopyPad(c, cGm[cb], cp, cpad);
						cQue.EnQue(c);
						c = cQue.DeQue<int32_t>();
						if (useTail) {
							Add(c, c, tail[(row - subRowBegin) * azN], rc * azN);
							PipeBarrier<PIPE_V>();
						}
						Cast(z, c, RoundMode::CAST_NONE, rc * azN);
						cQue.FreeTensor(c);
						PipeBarrier<PIPE_V>();
						BinaryRepeatParams bp{1, 1, 1, static_cast<uint8_t>(azN / 8), static_cast<uint8_t>(azN / 8), 0};
						for (int64_t col = 0; col < azN; col += 64) {
							uint64_t mask = azN - col < 64 ? azN - col : 64;
							Mul(z[col], z[col], s[col], mask, static_cast<uint8_t>(rc), bp);
						}
						PipeBarrier<PIPE_V>();
						GeluComputeSigmoid(z, u, rc * azN);
						PipeBarrier<PIPE_V>();
						LocalTensor<half> o = oQue.AllocTensor<half>();
						Cast(o, u, RoundMode::CAST_NONE, rc * azN);
						oQue.EnQue(o);
						o = oQue.DeQue<half>();
						DataCopyExtParams op{static_cast<uint16_t>(rc), static_cast<uint32_t>(curN * 2), 0,
																 static_cast<uint32_t>((n - curN) * 2), 0};
						DataCopyPad(yGm[(rowBase + row) * n + colBase], o, op);
						oQue.FreeTensor(o);
					}
				}
				sQue.FreeTensor(s);
				CrossCoreSetFlag<SYNC_MODE2, PIPE_MTE2>(GMM_SYNC_AIV_AIC);
				slot ^= 1;
				++iter;
			}
		}
	}
}

}
namespace os_tile320_runtime {
__aicore__ inline bool SingleActive(GM_ADDR groups, int64_t m, int64_t e) {
	if (e == 1)
		return true;
	GlobalTensor<int64_t> g;
	g.SetGlobalBuffer((__gm__ int64_t *)groups, e);
	const int64_t beforeLast = g.GetValue(e - 2);
	if (beforeLast == 0)
		return true;
	if (beforeLast < m)
		return false;
	const int64_t first = g.GetValue(0);
	if (first == m)
		return true;
	if (first > 0)
		return false;
	int lo = 1, hi = e - 1;
	while (lo < hi) {
		int mid = (lo + hi) / 2;
		if (g.GetValue(mid) == 0)
			lo = mid + 1;
		else
			hi = mid;
	}
	return g.GetValue(lo) == m;
}

}
__global__ __mix__(1, 2)
		__attribute__((aligned(64))) void bk499(GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR g, GM_ADDR y, GM_ADDR ws,
																						int64_t m, int64_t k, int64_t n, int64_t e) {
	os_tile320_runtime::TailRun<256, 128, 16>(x, w, s, g, y, ws, m, k, n, e);
}

namespace main_pad_ab {
__aicore__ inline void GeluInplace(const AscendC::LocalTensor<float> &z, const AscendC::LocalTensor<float> &u,
																	 int32_t count) {
	using namespace AscendC;
	Mul(u, z, z, count);
	Muls(u, u, -0.07135481627260026f, count);
	Adds(u, u, -1.5957691216057308f, count);
	Mul(u, u, z, count);
	Exp(u, u, count);
	Adds(u, u, 1.0f, count);
	Div(u, z, u, count);
}

template <int TM, int TN>
__aicore__ inline void Compute(GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR group_list, GM_ADDR y,
															 GM_ADDR workspace, int64_t m, int64_t runtimeK, int64_t n, int64_t e,
															 int64_t fixedSlabs, int64_t bPitch) {
	const int64_t k = ((runtimeK + 31) / 32) * 32;
	using Cfg = gmm_tiles::Config<TM, TN>;
	using MM = typename Cfg::MM;
	constexpr int TILE_M = TM, TILE_N = TN;
	constexpr int VEC_CHUNK_M = 32;
	static_assert(18 * 32 * TN + 4 * TN <= 192 * 1024, "UBbudget");
	constexpr uint16_t GMM_SYNC_AIV_AIC = 3, GMM_SYNC_AIC_AIV = 5;
	constexpr uint64_t SYNC_MODE2 = 2;
	using namespace gmm_common;
	using namespace AscendC;
	const uint32_t coreNum = static_cast<uint32_t>(GetBlockNum());
	const uint32_t coreIdx = CoreGroupIndex();
	const uint32_t subIdx = SubCoreIndex();
	GlobalTensor<int8_t> xGm;
	GlobalTensor<int8_t> wGm;
	GlobalTensor<float> scaleGm;
	GlobalTensor<int64_t> glGm;
	GlobalTensor<int32_t> cGm;
	GlobalTensor<half> yGm;
	const int64_t cWorkspaceBytes = static_cast<int64_t>(coreNum) * 4 * TILE_M * TILE_N * 4;
	GlobalTensor<int8_t> xOriginal;
	xOriginal.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t *>(x), m * runtimeK);
	xGm.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t *>(workspace) + cWorkspaceBytes + e * k * bPitch, m * k);
	wGm.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t *>(weight), e * runtimeK * n);
	scaleGm.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(scale), e * n);
	glGm.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t *>(group_list), e);
	cGm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t *>(workspace),
											static_cast<int64_t>(coreNum) * 4 * TILE_M * TILE_N);
	yGm.SetGlobalBuffer(reinterpret_cast<__gm__ half *>(y), m * n);
	GlobalTensor<int8_t> wPadGm;
	const int64_t cBytes = static_cast<int64_t>(coreNum) * 4 * TILE_M * TILE_N * 4;
	wPadGm.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t *>(workspace) + cBytes, e * k * bPitch);
	int64_t activeExperts[128], activeCount = 0;
	int64_t groupEnds[128];
	int64_t tileEnds[128];
	int64_t totalMTiles = 0;
	int64_t previousEnd = 0;
	if (fixedSlabs && bPitch == n) {
		totalMTiles = CeilDiv(m, fixedSlabs);
	} else {
		for (int64_t expert = 0; expert < e; ++expert) {
			const int64_t end = glGm.GetValue(expert);
			if (end > previousEnd)
				activeExperts[activeCount++] = expert;
			if (expert < 128)
				groupEnds[expert] = end;
			totalMTiles += CeilDiv(end - previousEnd, TILE_M);
			if (expert < 128)
				tileEnds[expert] = totalMTiles;
			previousEnd = end;
		}
	}
	if (fixedSlabs)
		totalMTiles = CeilDiv(m, fixedSlabs);
	const int64_t N_TILES = (n + TILE_N - 1) / TILE_N;
	const bool useWorkAssign = CeilDiv(totalMTiles, static_cast<int64_t>(coreNum)) * N_TILES <=
														 CeilDiv(totalMTiles * N_TILES, static_cast<int64_t>(coreNum));
	const int64_t totalTasks = useWorkAssign ? totalMTiles : totalMTiles * N_TILES;
	TPipe pipe;
	if ASCEND_IS_AIC {
		MM mm;
		mm.SetSubBlockIdx(0);
		mm.Init(static_cast<TCubeTiling *>(nullptr), &pipe);
		if (bPitch != n)
			SyncAll<false>();
		int64_t iter = 0;
		int64_t slot = 0;
		for (int64_t wave = 0; wave < CeilDiv(totalTasks, static_cast<int64_t>(coreNum)); ++wave) {
			const int64_t lane = (useWorkAssign || bPitch % TILE_N == 0)
															 ? static_cast<int64_t>(coreIdx)
															 : (static_cast<int64_t>(coreIdx) + coreNum - wave % coreNum) % coreNum;
			const int64_t task = wave * coreNum + lane;
			if (task >= totalTasks)
				continue;
			const int64_t work = useWorkAssign ? task : task / N_TILES;
			const int64_t ownedN = useWorkAssign ? 0 : task % N_TILES;
			int64_t ei = 0, groupStart = 0, firstTile = 0;
			int64_t start = 0, workEnd = 0;
			if (fixedSlabs) {
				start = work * fixedSlabs;
				workEnd = start + fixedSlabs < m ? start + fixedSlabs : m;
				const int64_t hint = start * e / m;
				const int64_t hintBegin = hint == 0 ? 0 : glGm.GetValue(hint - 1);
				const int64_t hintEnd = glGm.GetValue(hint);
				if (hintBegin <= start && start < hintEnd)
					ei = hint;
				else {
					int64_t lo = 0, hi = e;
					while (lo < hi) {
						const int64_t mid = (lo + hi) / 2;
						if (glGm.GetValue(mid) <= start)
							lo = mid + 1;
						else
							hi = mid;
					}
					ei = lo;
				}
			} else {
				if (e <= 128) {
					int64_t lo = 0, hi = e;
					while (lo < hi) {
						const int64_t mid = (lo + hi) / 2;
						if (tileEnds[mid] <= work)
							lo = mid + 1;
						else
							hi = mid;
					}
					ei = lo;
					groupStart = ei == 0 ? 0 : groupEnds[ei - 1];
					firstTile = ei == 0 ? 0 : tileEnds[ei - 1];
				} else {
					for (; ei < e; ++ei) {
						const int64_t groupEnd = glGm.GetValue(ei);
						const int64_t tiles = CeilDiv(groupEnd - groupStart, TILE_M);
						if (work < firstTile + tiles)
							break;
						firstTile += tiles;
						groupStart = groupEnd;
					}
				}
				start = groupStart + (work - firstTile) * TILE_M;
				const int64_t groupEnd = e <= 128 ? groupEnds[ei] : glGm.GetValue(ei);
				workEnd = start + TILE_M < groupEnd ? start + TILE_M : groupEnd;
			}
			while (start < workEnd) {
				const int64_t groupEnd = !fixedSlabs && e <= 128 ? groupEnds[ei] : glGm.GetValue(ei);
				const int64_t segmentEnd = groupEnd < workEnd ? groupEnd : workEnd;
				const int64_t me = segmentEnd - start;
				const int64_t rowBase = start;
				const int64_t curM = me;
				for (int64_t ni = ownedN; ni < (useWorkAssign ? N_TILES : ownedN + 1); ++ni) {
					const int64_t colBase = ni * TILE_N;
					const int64_t curN = bPitch - colBase < TILE_N ? bPitch - colBase : TILE_N;
					const bool seqC = false;
					if (iter >= 4) {
						CrossCoreWaitFlag(GMM_SYNC_AIV_AIC);
					}
					mm.SetOrgShape(me, bPitch, k, k, TILE_N);
					mm.SetSingleShape(curM, curN, k);
					mm.SetTensorA(xGm[rowBase * k], false);
					if (bPitch != n)
						mm.SetTensorB(wPadGm[ei * k * bPitch + colBase], false);
					else
						mm.SetTensorB(wGm[ei * k * n + colBase], false);
					while (mm.Iterate()) {
						mm.GetTensorC(cGm[(static_cast<int64_t>(coreIdx) * 4 + slot) * TILE_M * TILE_N], 0, seqC);
					}
					CrossCoreSetFlag<SYNC_MODE2, PIPE_FIX>(GMM_SYNC_AIC_AIV);
					slot = (slot + 1) & 3;
					++iter;
				}
				start = segmentEnd;
				if (start < workEnd) {
					do {
						++ei;
					} while (ei < e && glGm.GetValue(ei) <= start);
				}
			}
		}
	} else {
		if (bPitch != n) {
			const int64_t batchRows = 65536 / bPitch;
			const int64_t stageBytes = batchRows * bPitch;
			TBuf<TPosition::VECCALC> copyBuffer;
			pipe.InitBuffer(copyBuffer, 2 * stageBytes);
			LocalTensor<int8_t> copy = copyBuffer.Get<int8_t>();
			const event_t loadEvents[2] = {static_cast<event_t>(pipe.AllocEventID<HardEvent::MTE2_MTE3>()),
																		 static_cast<event_t>(pipe.AllocEventID<HardEvent::MTE2_MTE3>())};
			const event_t storeEvents[2] = {static_cast<event_t>(pipe.AllocEventID<HardEvent::MTE3_MTE2>()),
																			static_cast<event_t>(pipe.AllocEventID<HardEvent::MTE3_MTE2>())};
			SetFlag<HardEvent::MTE3_MTE2>(storeEvents[0]);
			SetFlag<HardEvent::MTE3_MTE2>(storeEvents[1]);
			const int64_t aivNum = coreNum * GetTaskRation();
			const int64_t aivIdx = GetBlockIdx();
			const int64_t perCore = CeilDiv(activeCount * runtimeK, aivNum);
			int64_t row = aivIdx * perCore;
			const int64_t rowEnd =
					(row + perCore < activeCount * runtimeK) ? row + perCore : activeCount * runtimeK;
			int stage = 0;
			while (row < rowEnd) {
				const int64_t active = row / runtimeK, localRow = row % runtimeK;
				const int64_t expert = activeExperts[active];
				int64_t rows = rowEnd - row;
				if (rows > runtimeK - localRow)
					rows = runtimeK - localRow;
				if (rows > batchRows)
					rows = batchRows;
				LocalTensor<int8_t> buffer = copy[stage * stageBytes];
				WaitFlag<HardEvent::MTE3_MTE2>(storeEvents[stage]);
				DataCopyExtParams load{static_cast<uint16_t>(rows), static_cast<uint32_t>(n), 0, 0, 0};
				DataCopyPadExtParams<int8_t> pad{true, 0, 0, 0};
				DataCopyPad(buffer, wGm[(expert * runtimeK + localRow) * n], load, pad);
				SetFlag<HardEvent::MTE2_MTE3>(loadEvents[stage]);
				WaitFlag<HardEvent::MTE2_MTE3>(loadEvents[stage]);
				DataCopyExtParams store{1, static_cast<uint32_t>(rows * bPitch), 0, 0, 0};
				DataCopyPad(wPadGm[(expert * k + localRow) * bPitch], buffer, store);
				SetFlag<HardEvent::MTE3_MTE2>(storeEvents[stage]);
				row += rows;
				stage ^= 1;
			}
			WaitFlag<HardEvent::MTE3_MTE2>(storeEvents[0]);
			WaitFlag<HardEvent::MTE3_MTE2>(storeEvents[1]);
			const int64_t zeroBytes = (k - runtimeK) * bPitch;
			const event_t reuseForVector = static_cast<event_t>(pipe.AllocEventID<HardEvent::MTE3_V>());
			SetFlag<HardEvent::MTE3_V>(reuseForVector);
			WaitFlag<HardEvent::MTE3_V>(reuseForVector);
			pipe.ReleaseEventID<HardEvent::MTE3_V>(reuseForVector);
			Duplicate(copy.ReinterpretCast<int16_t>(), static_cast<int16_t>(0), zeroBytes / 2);
			SetFlag<HardEvent::V_MTE3>(0);
			WaitFlag<HardEvent::V_MTE3>(0);
			for (int64_t active = aivIdx; active < activeCount; active += aivNum) {
				const int64_t expert = activeExperts[active];
				DataCopyExtParams zp{1, static_cast<uint32_t>(zeroBytes), 0, 0, 0};
				DataCopyPad(wPadGm[(expert * k + runtimeK) * bPitch], copy, zp);
			}
			SetFlag<HardEvent::MTE3_MTE2>(storeEvents[0]);
			WaitFlag<HardEvent::MTE3_MTE2>(storeEvents[0]);
			const int64_t aBatchRows = stageBytes / k;
			const int64_t aPerCore = CeilDiv(m, aivNum);
			int64_t aRow = aivIdx * aPerCore;
			const int64_t aEnd = aRow + aPerCore < m ? aRow + aPerCore : m;
			SetFlag<HardEvent::MTE3_MTE2>(storeEvents[0]);
			SetFlag<HardEvent::MTE3_MTE2>(storeEvents[1]);
			stage = 0;
			while (aRow < aEnd) {
				const int64_t rows = aEnd - aRow < aBatchRows ? aEnd - aRow : aBatchRows;
				LocalTensor<int8_t> buffer = copy[stage * stageBytes];
				WaitFlag<HardEvent::MTE3_MTE2>(storeEvents[stage]);
				DataCopyExtParams ap{static_cast<uint16_t>(rows), static_cast<uint32_t>(runtimeK), 0, 0, 0};
				DataCopyPadExtParams<int8_t> pad{true, 0, 0, 0};
				DataCopyPad(buffer, xOriginal[aRow * runtimeK], ap, pad);
				SetFlag<HardEvent::MTE2_MTE3>(loadEvents[stage]);
				WaitFlag<HardEvent::MTE2_MTE3>(loadEvents[stage]);
				DataCopyExtParams op{1, static_cast<uint32_t>(rows * k), 0, 0, 0};
				DataCopyPad(xGm[aRow * k], buffer, op);
				SetFlag<HardEvent::MTE3_MTE2>(storeEvents[stage]);
				aRow += rows;
				stage ^= 1;
			}
			WaitFlag<HardEvent::MTE3_MTE2>(storeEvents[0]);
			WaitFlag<HardEvent::MTE3_MTE2>(storeEvents[1]);
			pipe.ReleaseEventID<HardEvent::MTE2_MTE3>(loadEvents[0]);
			pipe.ReleaseEventID<HardEvent::MTE2_MTE3>(loadEvents[1]);
			pipe.ReleaseEventID<HardEvent::MTE3_MTE2>(storeEvents[0]);
			pipe.ReleaseEventID<HardEvent::MTE3_MTE2>(storeEvents[1]);
			pipe.Reset();
			SyncAll<false>();
		}
		TQue<TPosition::VECIN, 2> cQue;
		TQue<TPosition::VECIN, 1> sQue;
		TQue<TPosition::VECOUT, 1> oQue;
		TBuf<TPosition::VECCALC> zBuf;
		TBuf<TPosition::VECCALC> uBuf;
		constexpr uint32_t CHUNK_ELEMS = VEC_CHUNK_M * TILE_N;
		pipe.InitBuffer(cQue, 2, CHUNK_ELEMS * sizeof(int32_t));
		pipe.InitBuffer(sQue, 1, TILE_N * sizeof(float));
		pipe.InitBuffer(oQue, 1, CHUNK_ELEMS * sizeof(half));
		pipe.InitBuffer(zBuf, CHUNK_ELEMS * sizeof(float));
		pipe.InitBuffer(uBuf, CHUNK_ELEMS * sizeof(float));
		LocalTensor<float> z = zBuf.Get<float>();
		LocalTensor<float> u = uBuf.Get<float>();
		int64_t iter = 0;
		int64_t slot = 0;
		for (int64_t wave = 0; wave < CeilDiv(totalTasks, static_cast<int64_t>(coreNum)); ++wave) {
			const int64_t lane = (useWorkAssign || bPitch % TILE_N == 0)
															 ? static_cast<int64_t>(coreIdx)
															 : (static_cast<int64_t>(coreIdx) + coreNum - wave % coreNum) % coreNum;
			const int64_t task = wave * coreNum + lane;
			if (task >= totalTasks)
				continue;
			const int64_t work = useWorkAssign ? task : task / N_TILES;
			const int64_t ownedN = useWorkAssign ? 0 : task % N_TILES;
			int64_t ei = 0, groupStart = 0, firstTile = 0;
			int64_t start = 0, workEnd = 0;
			if (fixedSlabs) {
				start = work * fixedSlabs;
				workEnd = start + fixedSlabs < m ? start + fixedSlabs : m;
				const int64_t hint = start * e / m;
				const int64_t hintBegin = hint == 0 ? 0 : glGm.GetValue(hint - 1);
				const int64_t hintEnd = glGm.GetValue(hint);
				if (hintBegin <= start && start < hintEnd)
					ei = hint;
				else {
					int64_t lo = 0, hi = e;
					while (lo < hi) {
						const int64_t mid = (lo + hi) / 2;
						if (glGm.GetValue(mid) <= start)
							lo = mid + 1;
						else
							hi = mid;
					}
					ei = lo;
				}
			} else {
				if (e <= 128) {
					int64_t lo = 0, hi = e;
					while (lo < hi) {
						const int64_t mid = (lo + hi) / 2;
						if (tileEnds[mid] <= work)
							lo = mid + 1;
						else
							hi = mid;
					}
					ei = lo;
					groupStart = ei == 0 ? 0 : groupEnds[ei - 1];
					firstTile = ei == 0 ? 0 : tileEnds[ei - 1];
				} else {
					for (; ei < e; ++ei) {
						const int64_t groupEnd = glGm.GetValue(ei);
						const int64_t tiles = CeilDiv(groupEnd - groupStart, TILE_M);
						if (work < firstTile + tiles)
							break;
						firstTile += tiles;
						groupStart = groupEnd;
					}
				}
				start = groupStart + (work - firstTile) * TILE_M;
				const int64_t groupEnd = e <= 128 ? groupEnds[ei] : glGm.GetValue(ei);
				workEnd = start + TILE_M < groupEnd ? start + TILE_M : groupEnd;
			}
			while (start < workEnd) {
				const int64_t groupEnd = !fixedSlabs && e <= 128 ? groupEnds[ei] : glGm.GetValue(ei);
				const int64_t segmentEnd = groupEnd < workEnd ? groupEnd : workEnd;
				const int64_t me = segmentEnd - start;
				const int64_t tileRowBase = 0;
				const int64_t curM = me;
				const int64_t rowsPerSub = CeilDiv(curM, 2);
				const int64_t subRowBegin = subIdx * rowsPerSub;
				const int64_t subRowEnd = (subRowBegin < curM)
																			? ((subRowBegin + rowsPerSub < curM) ? subRowBegin + rowsPerSub : curM)
																			: subRowBegin;
				for (int64_t ni = ownedN; ni < (useWorkAssign ? N_TILES : ownedN + 1); ++ni) {
					const int64_t colBase = ni * TILE_N;
					const int64_t curN = bPitch - colBase < TILE_N ? bPitch - colBase : TILE_N;
					const int64_t validN = ((colBase + curN) <= n) ? curN : (n - colBase);
					const bool seqC = false;
					LocalTensor<float> s = sQue.AllocTensor<float>();
					DataCopyExtParams sp;
					sp.blockCount = 1;
					sp.blockLen = validN * sizeof(float);
					sp.srcStride = 0;
					sp.dstStride = 0;
					DataCopyPadExtParams<float> spad;
					spad.isPad = true;
					spad.leftPadding = 0;
					spad.rightPadding = 0;
					spad.paddingValue = 0;
					DataCopyPad(s, scaleGm[ei * n + colBase], sp, spad);
					sQue.EnQue(s);
					CrossCoreWaitFlag(GMM_SYNC_AIC_AIV);
					const int64_t cSlotBase = (static_cast<int64_t>(coreIdx) * 4 + slot) * TILE_M * TILE_N;
					if (subRowBegin < subRowEnd) {
						s = sQue.DeQue<float>();
						const int64_t alignedN = ((validN + 7) / 8) * 8;
						const int64_t alignedHalfN = ((validN + 15) / 16) * 16;
						const int64_t smStride = ((validN % 16) == 0) ? validN : alignedHalfN;
						const int64_t smRows =
								((subRowEnd - subRowBegin) < VEC_CHUNK_M) ? (subRowEnd - subRowBegin) : VEC_CHUNK_M;
						for (int64_t row = subRowBegin; row < subRowEnd; row += VEC_CHUNK_M) {
							const int64_t rc = (row + VEC_CHUNK_M < subRowEnd) ? VEC_CHUNK_M : (subRowEnd - row);
							const int64_t total = rc * validN;
							const int64_t globalRow = start + tileRowBase + row;
							if ((validN % 16) == 0) {
								LocalTensor<int32_t> c = cQue.AllocTensor<int32_t>();
								DataCopyExtParams cp;
								cp.blockCount = static_cast<uint32_t>(rc);
								cp.blockLen = validN * sizeof(int32_t);
								cp.srcStride = (TILE_N - validN) * sizeof(int32_t);
								cp.dstStride = 0;
								DataCopyPadExtParams<int32_t> cpad;
								cpad.isPad = true;
								cpad.leftPadding = 0;
								cpad.rightPadding = 0;
								cpad.paddingValue = 0;
								DataCopyPad(c, cGm[cSlotBase + (row * TILE_N)], cp, cpad);
								cQue.EnQue(c);
								c = cQue.DeQue<int32_t>();
								Cast(z, c, RoundMode::CAST_NONE, static_cast<int32_t>(total));
								PipeBarrier<PIPE_V>();
								cQue.FreeTensor(c);
								PipeBarrier<PIPE_V>();
								BinaryRepeatParams bc(1, 1, 1, static_cast<uint8_t>(smStride / 8),
																			static_cast<uint8_t>(smStride / 8), 0);
								for (int64_t col = 0; col < smStride; col += 64) {
									const uint64_t mask = smStride - col < 64 ? smStride - col : 64;
									Mul(z[col], z[col], s[col], mask, static_cast<uint8_t>(rc), bc);
								}
								GeluInplace(z, u, static_cast<int32_t>(total));
								PipeBarrier<PIPE_V>();
								PipeBarrier<PIPE_V>();
								LocalTensor<half> o = oQue.AllocTensor<half>();
								Cast(o, u, RoundMode::CAST_NONE, static_cast<int32_t>(total));
								oQue.EnQue(o);
								o = oQue.DeQue<half>();
								DataCopyExtParams op;
								op.blockCount = static_cast<uint32_t>(rc);
								op.blockLen = validN * sizeof(half);
								op.srcStride = 0;
								op.dstStride = (n - validN) * sizeof(half);
								DataCopyPad(yGm[globalRow * n + colBase], o, op);
								oQue.FreeTensor(o);
							} else {
								const int64_t azN = alignedHalfN;
								LocalTensor<int32_t> c = cQue.AllocTensor<int32_t>();
								DataCopyExtParams cp;
								cp.blockCount = static_cast<uint16_t>(rc);
								cp.blockLen = validN * sizeof(int32_t);
								cp.srcStride = (TILE_N - validN) * sizeof(int32_t);
								cp.dstStride = static_cast<uint32_t>((azN - alignedN) / 8);
								DataCopyPadExtParams<int32_t> cpad;
								cpad.isPad = true;
								cpad.leftPadding = 0;
								cpad.rightPadding = 0;
								cpad.paddingValue = 0;
								DataCopyPad(c, cGm[cSlotBase + (row * TILE_N)], cp, cpad);
								cQue.EnQue(c);
								c = cQue.DeQue<int32_t>();
								Cast(z, c, RoundMode::CAST_NONE, static_cast<int32_t>(rc * azN));
								PipeBarrier<PIPE_V>();
								cQue.FreeTensor(c);
								PipeBarrier<PIPE_V>();
								BinaryRepeatParams bc(1, 1, 1, static_cast<uint8_t>(smStride / 8),
																			static_cast<uint8_t>(smStride / 8), 0);
								for (int64_t col = 0; col < smStride; col += 64) {
									const uint64_t mask = smStride - col < 64 ? smStride - col : 64;
									Mul(z[col], z[col], s[col], mask, static_cast<uint8_t>(rc), bc);
								}
								GeluInplace(z, u, static_cast<int32_t>(rc * azN));
								PipeBarrier<PIPE_V>();
								PipeBarrier<PIPE_V>();
								LocalTensor<half> o = oQue.AllocTensor<half>();
								Cast(o, u, RoundMode::CAST_NONE, static_cast<int32_t>(rc * azN));
								oQue.EnQue(o);
								o = oQue.DeQue<half>();
								DataCopyExtParams op;
								op.blockCount = static_cast<uint16_t>(rc);
								op.blockLen = validN * sizeof(half);
								op.srcStride = 0;
								op.dstStride = (n - validN) * sizeof(half);
								DataCopyPad(yGm[globalRow * n + colBase], o, op);
								oQue.FreeTensor(o);
							}
						}
						sQue.FreeTensor(s);
					} else {
						s = sQue.DeQue<float>();
						sQue.FreeTensor(s);
					}
					CrossCoreSetFlag<SYNC_MODE2, PIPE_MTE2>(GMM_SYNC_AIV_AIC);
					slot = (slot + 1) & 3;
					++iter;
				}
				start = segmentEnd;
				if (start < workEnd) {
					do {
						++ei;
					} while (ei < e && glGm.GetValue(ei) <= start);
				}
			}
		}
	}
}

}
#include "kernel_operator.h"

#include "adv_api/matmul/matmul.h"

namespace os_stage5_runtime {
using namespace AscendC;

__aicore__ inline uint32_t CoreGroupIndex() {
	if ASCEND_IS_AIC {
		return static_cast<uint32_t>(AscendC::GetBlockIdx());
	}
	return static_cast<uint32_t>(AscendC::GetBlockIdx() / AscendC::GetTaskRation());
}

__aicore__ inline uint32_t SubCoreIndex() {
	if ASCEND_IS_AIV {
		return static_cast<uint32_t>(AscendC::GetSubBlockIdx());
	}
	return 0;
}

__aicore__ inline int64_t CeilDiv(int64_t a, int64_t b) {
	return (a + b - 1) / b;
}

__aicore__ inline void GeluComputeSigmoid(const AscendC::LocalTensor<float> &z,
																					const AscendC::LocalTensor<float> &u, int32_t cnt) {
	using namespace AscendC;
	Mul(u, z, z, cnt);
	Mul(u, u, z, cnt);
	Muls(u, u, 0.044715f, cnt);
	Add(u, u, z, cnt);
	Muls(u, u, -1.5957691216057308f, cnt);
	Exp(u, u, cnt);
	Adds(u, u, 1.0f, cnt);
	Div(u, z, u, cnt);
}

}
namespace os_i6_head_bank {
using namespace AscendC;

using os_stage5_runtime::CoreGroupIndex;

using os_stage5_runtime::SubCoreIndex;

using os_stage5_runtime::CeilDiv;

using os_stage5_runtime::GeluComputeSigmoid;

template <int TM, int TN, int MAX_K = 1152, bool L1_BARRIER = true, bool SHAPE_BARRIER = true,
					bool COMPACT_B = false, bool COMPACT_A = false, bool EARLY_PREFETCH = false, int K_STEP = 128,
					int B_DEPTH = 2, int B_HEAD = 0, bool NEXT_A = false, bool EXTRA_HEAD = false,
					bool HEAD_EARLY = false>
struct FullBResidentMmad {
	static_assert(TM % 16 == 0 && TN % 32 == 0, "INT8 tile alignment");
	static_assert(MAX_K * (TM + B_DEPTH * TN) + (EXTRA_HEAD ? B_HEAD * TN : 0) <= 512 * 1024,
								"Resident A plus two full B L1 panels");
	static_assert(K_STEP % 32 == 0 && TM * K_STEP <= 32 * 1024 && TN * K_STEP <= 32 * 1024, "Two L0 slots fit");
	static_assert(TM * TN * 4 <= 128 * 1024, "L0C fits");
	TBuf<TPosition::A1> a1b;
	TBuf<TPosition::B1> b1b, headb;
	static_assert(!EXTRA_HEAD || (B_DEPTH == 1 && B_HEAD > 0 && B_HEAD % K_STEP == 0),
								"IndependentHeadContract");
	TBuf<TPosition::A2> a0b;
	TBuf<TPosition::B2> b0b;
	TBuf<TPosition::CO1> cb;
	bool pendingFix = false, pendingA = false;
	int64_t ma = 0, curM = 0, curN = 0, layoutM = TM;
	__aicore__ inline void Init(TPipe &pipe) {
		pipe.InitBuffer(a1b, TM * MAX_K);
		pipe.InitBuffer(b1b, B_DEPTH * TN * MAX_K);
		if constexpr (EXTRA_HEAD)
			pipe.InitBuffer(headb, B_HEAD * TN);
		pipe.InitBuffer(a0b, 64 * 1024);
		pipe.InitBuffer(b0b, 64 * 1024);
		pipe.InitBuffer(cb, TM * TN * 4);
		const uint8_t pad[4] = {0, 0, 0, 0};
		SetFmatrix(1, TM, pad, FmatrixMode::FMATRIX_LEFT);
		SetFlag<HardEvent::MTE1_MTE2>(2);
		if constexpr (B_DEPTH == 2 || B_HEAD > 0)
			SetFlag<HardEvent::MTE1_MTE2>(3);
		SetFlag<HardEvent::MTE1_MTE2>(4);
		if constexpr (EXTRA_HEAD)
			SetFlag<HardEvent::MTE1_MTE2>(5);
	}
	__aicore__ inline void QueueB(GlobalTensor<int8_t> w, int64_t k, int64_t n, int64_t physicalN,
																int64_t sequence) {
		const int64_t bPitch = COMPACT_B ? CeilDiv(k, 32) * 32 : MAX_K;
		const auto event = static_cast<event_t>(2 + (B_DEPTH == 1 ? 0 : (sequence & 1)));
		WaitFlag<HardEvent::MTE1_MTE2>(event);
		if constexpr (B_HEAD > 0)
			WaitFlag<HardEvent::MTE1_MTE2>(3);
		Nd2NzParams bp{1,
									 static_cast<uint16_t>(k),
									 static_cast<uint16_t>(n),
									 0,
									 static_cast<uint16_t>(physicalN),
									 static_cast<uint16_t>(bPitch),
									 1,
									 0};
		DataCopy(b1b.Get<int8_t>()[(B_DEPTH == 1 ? 0 : (sequence & 1)) * bPitch * TN], w, bp);
		SetFlag<HardEvent::MTE2_MTE1>(event);
		if constexpr (B_HEAD > 0)
			SetFlag<HardEvent::MTE2_MTE1>(3);
	}
	__aicore__ inline void QueueBHead(GlobalTensor<int8_t> w, int64_t k, int64_t n, int64_t physicalN,
																		int64_t sequence) {
		const bool alternate = EXTRA_HEAD && (sequence & 1);
		const auto ev = static_cast<event_t>(alternate ? 5 : 2);
		WaitFlag<HardEvent::MTE1_MTE2>(ev);
		const int64_t bPitch = alternate ? B_HEAD : (COMPACT_B ? CeilDiv(k, 32) * 32 : MAX_K),
									head = k < B_HEAD ? k : B_HEAD;
		Nd2NzParams bp{1,
									 static_cast<uint16_t>(head),
									 static_cast<uint16_t>(n),
									 0,
									 static_cast<uint16_t>(physicalN),
									 static_cast<uint16_t>(bPitch),
									 1,
									 0};
		auto dst = b1b.Get<int8_t>();
		if constexpr (EXTRA_HEAD)
			if (alternate)
				dst = headb.Get<int8_t>();
		DataCopy(dst, w, bp);
		SetFlag<HardEvent::MTE2_MTE1>(ev);
	}
	__aicore__ inline void QueueBTail(GlobalTensor<int8_t> w, int64_t k, int64_t n, int64_t physicalN) {
		WaitFlag<HardEvent::MTE1_MTE2>(3);
		if (k > B_HEAD) {
			const int64_t bPitch = COMPACT_B ? CeilDiv(k, 32) * 32 : MAX_K;
			Nd2NzParams bp{1,
										 static_cast<uint16_t>(k - B_HEAD),
										 static_cast<uint16_t>(n),
										 0,
										 static_cast<uint16_t>(physicalN),
										 static_cast<uint16_t>(bPitch),
										 1,
										 0};
			DataCopy(b1b.Get<int8_t>()[B_HEAD * 32], w[B_HEAD * physicalN], bp);
		}
		SetFlag<HardEvent::MTE2_MTE1>(3);
	}
	__aicore__ inline void QueueNextA(GlobalTensor<int8_t> x, int64_t m, int64_t k, int64_t aPitch) {
		WaitFlag<HardEvent::MTE1_MTE2>(4);
		const int64_t nextMa = (m + 15) / 16 * 16;
		if constexpr (COMPACT_A)
			if (layoutM != nextMa) {
				PipeBarrier<PIPE_MTE1>();
				const uint8_t pad[4] = {0, 0, 0, 0};
				SetFmatrix(1, static_cast<uint16_t>(nextMa), pad, FmatrixMode::FMATRIX_LEFT);
				layoutM = nextMa;
			}
		Nd2NzParams ap{1,
									 static_cast<uint16_t>(m),
									 static_cast<uint16_t>(k),
									 0,
									 static_cast<uint16_t>(aPitch),
									 static_cast<uint16_t>(COMPACT_A ? nextMa : TM),
									 1,
									 0};
		DataCopy(a1b.Get<int8_t>(), x, ap);
		SetFlag<HardEvent::MTE2_MTE1>(4);
		pendingA = true;
	}
	__aicore__ inline void Prepare(GlobalTensor<int8_t> x, int64_t m, int64_t k, int64_t n, int64_t aPitch,
																 bool reuseA, int64_t sequence, bool reuseB = false) {
		if (pendingFix) {
			WaitFlag<HardEvent::FIX_M>(6);
			pendingFix = false;
		}
		if constexpr (SHAPE_BARRIER) {
			if (ma != ((m + 15) / 16 * 16) || curN != n)
				PipeBarrier<PIPE_ALL>();
		}
		ma = (m + 15) / 16 * 16;
		curM = m;
		curN = n;
		bool needsA = true;
		if constexpr (NEXT_A)
			if (pendingA) {
				WaitFlag<HardEvent::MTE2_MTE1>(4);
				pendingA = false;
				needsA = false;
			}
		if (needsA) {
			WaitFlag<HardEvent::MTE1_MTE2>(4);
			if (!reuseA) {
				if constexpr (COMPACT_A) {
					if (layoutM != ma) {
						PipeBarrier<PIPE_MTE1>();
						const uint8_t pad[4] = {0, 0, 0, 0};
						SetFmatrix(1, static_cast<uint16_t>(ma), pad, FmatrixMode::FMATRIX_LEFT);
						layoutM = ma;
					}
				}
				Nd2NzParams ap{1,
											 static_cast<uint16_t>(m),
											 static_cast<uint16_t>(k),
											 0,
											 static_cast<uint16_t>(aPitch),
											 static_cast<uint16_t>(COMPACT_A ? ma : TM),
											 1,
											 0};
				DataCopy(a1b.Get<int8_t>(), x, ap);
				SetFlag<HardEvent::MTE2_MTE1>(4);
				WaitFlag<HardEvent::MTE2_MTE1>(4);
			}
		}
		const int64_t bPitch = COMPACT_B ? CeilDiv(k, 32) * 32 : MAX_K;
		const auto bevent = static_cast<event_t>(EXTRA_HEAD ? ((sequence & 1) ? 5 : 2)
																												: (2 + (B_DEPTH == 1 ? 0 : (sequence & 1))));
		if (!reuseB)
			WaitFlag<HardEvent::MTE2_MTE1>(bevent);
	}
	__aicore__ inline void RunMmad(int64_t k, int64_t n, int64_t sequence,
																 GlobalTensor<int8_t> nextB = GlobalTensor<int8_t>(), int64_t nextCols = 0,
																 int64_t nextPitch = 0, bool hasNext = false, bool reuseB = false,
																 bool keepB = false) {
		const int64_t bPitch = COMPACT_B ? CeilDiv(k, 32) * 32 : MAX_K;
		const auto bevent = static_cast<event_t>(2 + (B_DEPTH == 1 ? 0 : (sequence & 1)));
		auto a1 = a1b.Get<int8_t>();
		auto b1 = b1b.Get<int8_t>()[(B_DEPTH == 1 ? 0 : (sequence & 1)) * bPitch * TN];
		auto a0 = a0b.Get<int8_t>(), b0 = b0b.Get<int8_t>();
		auto c = cb.Get<int32_t>();
		const int64_t na = ((n + 31) / 32) * 32;
		int64_t step = 0;
		bool headRetired = false, tailReady = B_HEAD == 0 || reuseB;
		const auto headEvent = static_cast<event_t>(EXTRA_HEAD && ((sequence & 1) != 0) ? 5 : 2);
		if constexpr (EXTRA_HEAD && HEAD_EARLY)
			if (hasNext && !keepB)
				QueueBHead(nextB, k, nextCols, nextPitch, sequence + 1);
		if constexpr (B_HEAD > 0)
			if (!reuseB && k <= B_HEAD) {
				WaitFlag<HardEvent::MTE2_MTE1>(3);
				tailReady = true;
			}
		for (int64_t kk = 0; kk < k; kk += K_STEP, ++step) {
			if constexpr (B_HEAD > 0)
				if (!tailReady && kk >= B_HEAD) {
					WaitFlag<HardEvent::MTE2_MTE1>(3);
					tailReady = true;
				}
			const int64_t remaining = ((k - kk + 31) / 32) * 32;
			const int64_t madK = remaining < K_STEP ? remaining : K_STEP;
			const auto event = static_cast<event_t>(step & 1);
			WaitFlag<HardEvent::M_MTE1>(event);
			auto av = a0[(step & 1) * 32 * 1024], bv = b0[(step & 1) * 32 * 1024];
			LoadData3DParamsV2Pro la;
			la.channelSize = MAX_K;
			la.extConfig = (uint64_t(kk) << 32) | (uint64_t(ma) << 16) | uint64_t(madK);
			la.enTranspose = false;
			LoadData(av, a1, la);
			if constexpr (L1_BARRIER)
				PipeBarrier<PIPE_MTE1>();
			LoadData2dTransposeParams lb;
			lb.startIndex = 0;
			lb.repeatTimes = na / 32;
			const bool alternateHead = EXTRA_HEAD && ((sequence & 1) != 0) && kk < B_HEAD;
			const int64_t readPitch = alternateHead ? B_HEAD : bPitch;
			auto readB = b1;
			if constexpr (EXTRA_HEAD)
				if (alternateHead)
					readB = headb.Get<int8_t>();
			lb.srcStride = readPitch / 32;
			lb.dstGap = 1;
			lb.dstFracGap = 0;
			lb.addrMode = 0;
			for (int ki = 0; ki < madK / 32; ++ki) {
				LoadDataWithTranspose(bv[ki * 32 * na], readB[(kk + ki * 32) * 32], lb);
				if constexpr (L1_BARRIER)
					PipeBarrier<PIPE_MTE1>();
			}
			if constexpr (B_HEAD > 0) {
				if (!keepB && !headRetired && (kk + madK >= B_HEAD || kk + madK >= k)) {
					SetFlag<HardEvent::MTE1_MTE2>(headEvent);
					headRetired = true;
					if constexpr (!EXTRA_HEAD || !HEAD_EARLY)
						if (hasNext)
							QueueBHead(nextB, k, nextCols, nextPitch, sequence + 1);
				}
			}
			SetFlag<HardEvent::MTE1_M>(event);
			WaitFlag<HardEvent::MTE1_M>(event);
			MmadParams mp;
			mp.m = ma;
			mp.n = na;
			mp.k = madK;
			mp.unitFlag = 0;
			mp.cmatrixInitVal = step == 0;
			Mmad(c, av, bv, mp);
			if ((ma / 16) * (na / 16) < 10)
				PipeBarrier<PIPE_M>();
			SetFlag<HardEvent::M_MTE1>(event);
		}
		SetFlag<HardEvent::MTE1_MTE2>(4);
		if (!keepB) {
			if constexpr (B_HEAD > 0)
				SetFlag<HardEvent::MTE1_MTE2>(3);
			else
				SetFlag<HardEvent::MTE1_MTE2>(bevent);
		}
		SetFlag<HardEvent::M_FIX>(6);
		if constexpr (B_DEPTH == 2)
			WaitFlag<HardEvent::M_FIX>(6);
	}
	__aicore__ inline void Compute(GlobalTensor<int8_t> x, int64_t m, int64_t k, int64_t n, int64_t aPitch,
																 bool reuseA, int64_t sequence) {
		Prepare(x, m, k, n, aPitch, reuseA, sequence);
		RunMmad(k, n, sequence);
	}
	__aicore__ inline void Store(GlobalTensor<int32_t> dst) {
		if constexpr (B_DEPTH == 1)
			WaitFlag<HardEvent::M_FIX>(6);
		FixpipeParamsV220 fp;
		fp.nSize = curN;
		fp.mSize = curM;
		fp.srcStride = ma;
		fp.dstStride = TN;
		fp.reluEn = false;
		fp.quantPre = QuantMode_t::NoQuant;
		fp.unitFlag = 0;
		Fixpipe<int32_t, int32_t, CFG_ROW_MAJOR>(dst, cb.Get<int32_t>(), fp);
		SetFlag<HardEvent::FIX_M>(6);
		pendingFix = true;
	}
	__aicore__ inline void End() {
		if (pendingFix)
			WaitFlag<HardEvent::FIX_M>(6);
		WaitFlag<HardEvent::MTE1_MTE2>(2);
		if constexpr (B_DEPTH == 2 || B_HEAD > 0)
			WaitFlag<HardEvent::MTE1_MTE2>(3);
		WaitFlag<HardEvent::MTE1_MTE2>(4);
		if constexpr (EXTRA_HEAD)
			WaitFlag<HardEvent::MTE1_MTE2>(5);
	}
};

struct FullBPanel {
	int64_t mt, expert, row, col, rows, cols;
};

template <int TM, int TN, int B_FACTOR = 0>
__aicore__ inline FullBPanel DecodeFullBPanel(int64_t panel, int64_t nt, int64_t n, int64_t e,
																							const int32_t *gl, const int32_t *prefix, bool allowB) {
	FullBPanel p;
	p.mt = panel / nt;
	p.col = (panel % nt) * TN;
	int lo = 0, hi = e;
	while (lo < hi) {
		int mid = (lo + hi) / 2;
		if (prefix[mid] <= p.mt)
			lo = mid + 1;
		else
			hi = mid;
	}
	p.expert = lo;
	const int64_t start = lo ? gl[lo - 1] : 0;
	const int64_t base = lo ? prefix[lo - 1] : 0, mtCount = prefix[lo] - base, expertRows = gl[lo] - start;
	const bool bOuter = allowB && B_FACTOR > 0 && int64_t(B_FACTOR) * n * (mtCount - 1) > (nt - 1) * expertRows;
	int64_t mi = p.mt - base;
	if (bOuter) {
		const int64_t local = panel - base * nt;
		mi = local % mtCount;
		p.col = (local / mtCount) * TN;
		p.mt = base + mi;
	}
	const int64_t remaining = gl[lo] - start - mi * TM;
	p.row = start + mi * TM;
	p.rows = remaining < TM ? remaining : TM;
	p.cols = n - p.col < TN ? n - p.col : TN;
	return p;
}

template <int TM, int TN, int VC = 32, bool PREFETCH = true, int MAX_K = 1152, bool L1_BARRIER = true,
					bool SHAPE_BARRIER = true, bool COMPACT_B = false, bool COMPACT_A = false,
					bool EARLY_PREFETCH = false, int K_STEP = 128, bool INPLACE_C = false, int B_DEPTH = 2,
					int B_HEAD = 0, bool NEXT_A = false, bool ADAPTIVE_M_OWNER = false, bool EXTRA_HEAD = false,
					bool HEAD_EARLY = false, int B_FACTOR = 0>
__aicore__ inline void NativeFullBRun(GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR group_list, GM_ADDR y,
																			GM_ADDR workspace, int64_t m, int64_t k, int64_t n, int64_t e) {
	static_assert(B_HEAD == 0 || (B_DEPTH == 1 && B_HEAD % K_STEP == 0 && B_HEAD < MAX_K), "DisjointKStripes");
	static_assert(!NEXT_A || (B_DEPTH == 1 && B_HEAD > 0), "NextARequiresStripedB");
	static_assert(B_DEPTH == 1 || B_DEPTH == 2, "OneOrTwoBSlots");
	static_assert(B_DEPTH == 2 || !PREFETCH, "SingleBPrefetchAfterLastReader");
	constexpr uint16_t READY = 5, CREDIT = 3;
	constexpr uint64_t SYNC_MODE2 = 2;
	const int64_t cores = GetBlockNum(), core = CoreGroupIndex(), sub = SubCoreIndex();
	GlobalTensor<int8_t> xGm, wGm;
	GlobalTensor<float> scaleGm;
	GlobalTensor<int64_t> glGm;
	GlobalTensor<int32_t> cGm;
	GlobalTensor<half> yGm;
	xGm.SetGlobalBuffer((__gm__ int8_t *)x, m * k);
	wGm.SetGlobalBuffer((__gm__ int8_t *)weight, e * k * n);
	scaleGm.SetGlobalBuffer((__gm__ float *)scale, e * n);
	glGm.SetGlobalBuffer((__gm__ int64_t *)group_list, e);
	yGm.SetGlobalBuffer((__gm__ half *)y, m * n);
	int32_t gl[128], prefix[128];
	int64_t totalMTiles = 0, previous = 0, maxRows = 0;
	for (int ei = 0; ei < e; ++ei) {
		const int64_t end = glGm.GetValue(ei);
		gl[ei] = end;
		const int64_t rows = end - previous;
		if (rows > maxRows)
			maxRows = rows;
		totalMTiles += CeilDiv(rows, TM);
		prefix[ei] = totalMTiles;
		previous = end;
	}
	const int64_t capacity = CeilDiv(maxRows < TM ? maxRows : TM, 16) * 16;
	const int64_t nt = CeilDiv(n, TN), panels = totalMTiles * nt, ringPrefix = nt * TN;
	const bool alignM = ADAPTIVE_M_OWNER && totalMTiles <= cores && totalMTiles * nt > (nt - 1) * cores;
	const int64_t first = alignM ? (totalMTiles * core / cores) * nt : panels * core / cores;
	const int64_t last = alignM ? (totalMTiles * (core + 1) / cores) * nt : panels * (core + 1) / cores;
	cGm.SetGlobalBuffer((__gm__ int32_t *)workspace, ringPrefix + cores * 2 * capacity * TN);
	TPipe pipe;
	if ASCEND_IS_AIC {
		FullBResidentMmad<TM, TN, MAX_K, L1_BARRIER, SHAPE_BARRIER, COMPACT_B, COMPACT_A, EARLY_PREFETCH, K_STEP,
											B_DEPTH, B_HEAD, NEXT_A, EXTRA_HEAD, HEAD_EARLY>
				mm;
		mm.Init(pipe);
		if (first < last) {
			auto p = DecodeFullBPanel<TM, TN, B_FACTOR>(first, nt, n, e, gl, prefix, !alignM);
			mm.QueueB(wGm[p.expert * k * n + p.col], k, p.cols, n, 0);
		}
		static_assert(B_DEPTH == 1 && B_HEAD > 0 && !PREFETCH, "HeadTailLeaseContract");
		int64_t previousMT = -1, previousExpert = -1, previousCol = -1, iter = 0, bEpoch = 0;
		for (int64_t panel = first; panel < last; ++panel, ++iter) {
			const auto p = DecodeFullBPanel<TM, TN, B_FACTOR>(panel, nt, n, e, gl, prefix, !alignM);
			const bool reuseB = iter > 0 && p.expert == previousExpert && p.col == previousCol;
			if (iter > 0 && !reuseB)
				++bEpoch;
			const bool hasNext = panel + 1 < last;
			const auto next =
					DecodeFullBPanel<TM, TN, B_FACTOR>(hasNext ? panel + 1 : panel, nt, n, e, gl, prefix, !alignM);
			const bool keepB = hasNext && next.expert == p.expert && next.col == p.col;
			mm.Prepare(xGm[p.row * k], p.rows, k, p.cols, k, previousMT == p.mt, bEpoch, reuseB);
			mm.RunMmad(k, p.cols, bEpoch, wGm[next.expert * k * n + next.col], next.cols, n, hasNext && !keepB,
								 reuseB, keepB);
			if (hasNext) {
				if constexpr (NEXT_A)
					if (next.mt != p.mt)
						mm.QueueNextA(xGm[next.row * k], next.rows, k, k);
				if (!keepB)
					mm.QueueBTail(wGm[next.expert * k * n + next.col], k, next.cols, n);
			}
			previousMT = p.mt;
			previousExpert = p.expert;
			previousCol = p.col;
			if (iter >= 2)
				CrossCoreWaitFlag(CREDIT);
			mm.Store(cGm[ringPrefix + (core * 2 + (iter & 1)) * capacity * TN]);
			CrossCoreSetFlag<SYNC_MODE2, PIPE_FIX>(READY);
		}
		for (int64_t i = 0; i < (last - first < 2 ? last - first : 2); ++i)
			CrossCoreWaitFlag(CREDIT);
		mm.End();
	} else {
		TQue<TPosition::VECIN, 1> cQue, sQue;
		TQue<TPosition::VECOUT, 1> oQue;
		TBuf<TPosition::VECCALC> zBuf, uBuf;
		constexpr int CHUNK_ELEMS = VC * TN;
		pipe.InitBuffer(cQue, 1, CHUNK_ELEMS * 4);
		pipe.InitBuffer(sQue, 1, TN * 4);
		pipe.InitBuffer(oQue, 1, CHUNK_ELEMS * 2);
		if constexpr (!INPLACE_C)
			pipe.InitBuffer(zBuf, CHUNK_ELEMS * 4);
		pipe.InitBuffer(uBuf, CHUNK_ELEMS * 4);
		auto z = INPLACE_C ? LocalTensor<float>() : zBuf.Get<float>(), u = uBuf.Get<float>();
		int64_t iter = 0;
		for (int64_t panel = first; panel < last; ++panel, ++iter) {
			const auto p = DecodeFullBPanel<TM, TN, B_FACTOR>(panel, nt, n, e, gl, prefix, !alignM);
			const int64_t perSub = (p.rows + 1) / 2, begin = sub * perSub;
			const int64_t end = begin < p.rows ? (begin + perSub < p.rows ? begin + perSub : p.rows) : begin;
			const int64_t azN = CeilDiv(p.cols, 16) * 16, alignedN = CeilDiv(p.cols, 8) * 8;
			auto scales = sQue.AllocTensor<float>();
			DataCopyExtParams sp{1, static_cast<uint32_t>(p.cols * 4), 0, 0, 0};
			DataCopyPadExtParams<float> spad{true, 0, 0, 0};
			DataCopyPad(scales, scaleGm[p.expert * n + p.col], sp, spad);
			sQue.EnQue(scales);
			CrossCoreWaitFlag(READY);
			scales = sQue.DeQue<float>();
			for (int64_t row = begin; row < end; row += VC) {
				const int64_t rc = end - row < VC ? end - row : VC;
				auto c = cQue.AllocTensor<int32_t>();
				DataCopyExtParams cp{static_cast<uint16_t>(rc), static_cast<uint32_t>(p.cols * 4),
														 static_cast<uint32_t>((TN - p.cols) * 4),
														 static_cast<uint32_t>((azN - alignedN) / 8), 0};
				DataCopyPadExtParams<int32_t> cpad{true, 0, 0, 0};
				const int64_t cb = ringPrefix + (core * 2 + (iter & 1)) * capacity * TN + row * TN;
				DataCopyPad(c, cGm[cb], cp, cpad);
				cQue.EnQue(c);
				c = cQue.DeQue<int32_t>();
				if constexpr (INPLACE_C)
					z = c.ReinterpretCast<float>();
				Cast(z, c, RoundMode::CAST_NONE, rc * azN);
				if constexpr (!INPLACE_C)
					cQue.FreeTensor(c);
				PipeBarrier<PIPE_V>();
				BinaryRepeatParams bp{1, 1, 1, static_cast<uint8_t>(azN / 8), static_cast<uint8_t>(azN / 8), 0};
				for (int64_t col = 0; col < azN; col += 64) {
					const uint64_t mask = azN - col < 64 ? azN - col : 64;
					Mul(z[col], z[col], scales[col], mask, static_cast<uint8_t>(rc), bp);
				}
				PipeBarrier<PIPE_V>();
				GeluComputeSigmoid(z, u, rc * azN);
				PipeBarrier<PIPE_V>();
				if constexpr (INPLACE_C)
					cQue.FreeTensor(c);
				auto o = oQue.AllocTensor<half>();
				Cast(o, u, RoundMode::CAST_NONE, rc * azN);
				oQue.EnQue(o);
				o = oQue.DeQue<half>();
				DataCopyExtParams op{static_cast<uint16_t>(rc), static_cast<uint32_t>(p.cols * 2), 0,
														 static_cast<uint32_t>((n - p.cols) * 2), 0};
				DataCopyPad(yGm[(p.row + row) * n + p.col], o, op);
				oQue.FreeTensor(o);
			}
			sQue.FreeTensor(scales);
			CrossCoreSetFlag<SYNC_MODE2, PIPE_MTE2>(CREDIT);
		}
	}
}

}
__global__ __mix__(1, 2)
		__attribute__((aligned(64))) void bk494(GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR g, GM_ADDR y, GM_ADDR ws,
																						int64_t m, int64_t k, int64_t n, int64_t e) {
	os_i6_head_bank::NativeFullBRun<160, 192, 80, false, 1056, false, false, true, true, true, 160, true, 1,
																	320, true, true, true, true, 4>(x, w, s, g, y, ws, m, k, n, e);
}
namespace os_i3_resident {
using namespace AscendC;

__aicore__ inline uint32_t CoreGroupIndex() {
	if ASCEND_IS_AIC {
		return static_cast<uint32_t>(AscendC::GetBlockIdx());
	}
	return static_cast<uint32_t>(AscendC::GetBlockIdx() / AscendC::GetTaskRation());
}

__aicore__ inline uint32_t SubCoreIndex() {
	if ASCEND_IS_AIV {
		return static_cast<uint32_t>(AscendC::GetSubBlockIdx());
	}
	return 0;
}

__aicore__ inline int64_t CeilDiv(int64_t a, int64_t b) {
	return (a + b - 1) / b;
}

__aicore__ inline void GeluComputeSigmoid(const AscendC::LocalTensor<float> &z,
																					const AscendC::LocalTensor<float> &u, int32_t cnt) {
	using namespace AscendC;
	Mul(u, z, z, cnt);
	Mul(u, u, z, cnt);
	Muls(u, u, 0.044715f, cnt);
	Add(u, u, z, cnt);
	Muls(u, u, -1.5957691216057308f, cnt);
	Exp(u, u, cnt);
	Adds(u, u, 1.0f, cnt);
	Div(u, z, u, cnt);
}

}
namespace os_i3_full_double_wide {
using namespace AscendC;

using os_i3_resident::CoreGroupIndex;

using os_i3_resident::SubCoreIndex;

using os_i3_resident::CeilDiv;

using os_i3_resident::GeluComputeSigmoid;

}
namespace os_i3_full_double_wide {
template <int TM, int TN, int MAX_K = 1152, bool L1_BARRIER = true, bool SHAPE_BARRIER = true,
					bool COMPACT_B = false, bool COMPACT_A = false, bool EARLY_PREFETCH = false, int K_STEP = 128,
					int B_DEPTH = 2, int B_HEAD = 0, bool NEXT_A = false>
struct FullBResidentMmad {
	static_assert(TM % 16 == 0 && TN % 32 == 0, "INT8 tile alignment");
	static_assert(MAX_K * (TM + B_DEPTH * TN) <= 512 * 1024, "Resident A plus two full B L1 panels");
	static_assert(K_STEP % 32 == 0 && TM * K_STEP <= 32 * 1024 && TN * K_STEP <= 32 * 1024, "Two L0 slots fit");
	static_assert(TM * TN * 4 <= 128 * 1024, "L0C fits");
	TBuf<TPosition::A1> a1b;
	TBuf<TPosition::B1> b1b;
	TBuf<TPosition::A2> a0b;
	TBuf<TPosition::B2> b0b;
	TBuf<TPosition::CO1> cb;
	bool pendingFix = false, pendingA = false;
	int64_t ma = 0, curM = 0, curN = 0, layoutM = TM;
	__aicore__ inline void Init(TPipe &pipe) {
		pipe.InitBuffer(a1b, TM * MAX_K);
		pipe.InitBuffer(b1b, B_DEPTH * TN * MAX_K);
		pipe.InitBuffer(a0b, 64 * 1024);
		pipe.InitBuffer(b0b, 64 * 1024);
		pipe.InitBuffer(cb, TM * TN * 4);
		const uint8_t pad[4] = {0, 0, 0, 0};
		SetFmatrix(1, TM, pad, FmatrixMode::FMATRIX_LEFT);
		SetFlag<HardEvent::MTE1_MTE2>(2);
		if constexpr (B_DEPTH == 2 || B_HEAD > 0)
			SetFlag<HardEvent::MTE1_MTE2>(3);
		SetFlag<HardEvent::MTE1_MTE2>(4);
	}
	__aicore__ inline void QueueB(GlobalTensor<int8_t> w, int64_t k, int64_t n, int64_t physicalN,
																int64_t sequence) {
		const int64_t bPitch = COMPACT_B ? CeilDiv(k, 32) * 32 : MAX_K;
		const auto event = static_cast<event_t>(2 + (B_DEPTH == 1 ? 0 : (sequence & 1)));
		WaitFlag<HardEvent::MTE1_MTE2>(event);
		if constexpr (B_HEAD > 0)
			WaitFlag<HardEvent::MTE1_MTE2>(3);
		Nd2NzParams bp{1,
									 static_cast<uint16_t>(k),
									 static_cast<uint16_t>(n),
									 0,
									 static_cast<uint16_t>(physicalN),
									 static_cast<uint16_t>(bPitch),
									 1,
									 0};
		DataCopy(b1b.Get<int8_t>()[(B_DEPTH == 1 ? 0 : (sequence & 1)) * bPitch * TN], w, bp);
		SetFlag<HardEvent::MTE2_MTE1>(event);
		if constexpr (B_HEAD > 0)
			SetFlag<HardEvent::MTE2_MTE1>(3);
	}
	__aicore__ inline void QueueBHead(GlobalTensor<int8_t> w, int64_t k, int64_t n, int64_t physicalN) {
		WaitFlag<HardEvent::MTE1_MTE2>(2);
		const int64_t bPitch = COMPACT_B ? CeilDiv(k, 32) * 32 : MAX_K, head = k < B_HEAD ? k : B_HEAD;
		Nd2NzParams bp{1,
									 static_cast<uint16_t>(head),
									 static_cast<uint16_t>(n),
									 0,
									 static_cast<uint16_t>(physicalN),
									 static_cast<uint16_t>(bPitch),
									 1,
									 0};
		DataCopy(b1b.Get<int8_t>(), w, bp);
		SetFlag<HardEvent::MTE2_MTE1>(2);
	}
	__aicore__ inline void QueueBTail(GlobalTensor<int8_t> w, int64_t k, int64_t n, int64_t physicalN) {
		WaitFlag<HardEvent::MTE1_MTE2>(3);
		if (k > B_HEAD) {
			const int64_t bPitch = COMPACT_B ? CeilDiv(k, 32) * 32 : MAX_K;
			Nd2NzParams bp{1,
										 static_cast<uint16_t>(k - B_HEAD),
										 static_cast<uint16_t>(n),
										 0,
										 static_cast<uint16_t>(physicalN),
										 static_cast<uint16_t>(bPitch),
										 1,
										 0};
			DataCopy(b1b.Get<int8_t>()[B_HEAD * 32], w[B_HEAD * physicalN], bp);
		}
		SetFlag<HardEvent::MTE2_MTE1>(3);
	}
	__aicore__ inline void QueueNextA(GlobalTensor<int8_t> x, int64_t m, int64_t k, int64_t aPitch) {
		WaitFlag<HardEvent::MTE1_MTE2>(4);
		const int64_t nextMa = (m + 15) / 16 * 16;
		if constexpr (COMPACT_A)
			if (layoutM != nextMa) {
				PipeBarrier<PIPE_MTE1>();
				const uint8_t pad[4] = {0, 0, 0, 0};
				SetFmatrix(1, static_cast<uint16_t>(nextMa), pad, FmatrixMode::FMATRIX_LEFT);
				layoutM = nextMa;
			}
		Nd2NzParams ap{1,
									 static_cast<uint16_t>(m),
									 static_cast<uint16_t>(k),
									 0,
									 static_cast<uint16_t>(aPitch),
									 static_cast<uint16_t>(COMPACT_A ? nextMa : TM),
									 1,
									 0};
		DataCopy(a1b.Get<int8_t>(), x, ap);
		SetFlag<HardEvent::MTE2_MTE1>(4);
		pendingA = true;
	}
	__aicore__ inline void Prepare(GlobalTensor<int8_t> x, int64_t m, int64_t k, int64_t n, int64_t aPitch,
																 bool reuseA, int64_t sequence) {
		if (pendingFix) {
			WaitFlag<HardEvent::FIX_M>(6);
			pendingFix = false;
		}
		if constexpr (SHAPE_BARRIER) {
			if (ma != ((m + 15) / 16 * 16) || curN != n)
				PipeBarrier<PIPE_ALL>();
		}
		ma = (m + 15) / 16 * 16;
		curM = m;
		curN = n;
		bool needsA = true;
		if constexpr (NEXT_A)
			if (pendingA) {
				WaitFlag<HardEvent::MTE2_MTE1>(4);
				pendingA = false;
				needsA = false;
			}
		if (needsA) {
			WaitFlag<HardEvent::MTE1_MTE2>(4);
			if (!reuseA) {
				if constexpr (COMPACT_A) {
					if (layoutM != ma) {
						PipeBarrier<PIPE_MTE1>();
						const uint8_t pad[4] = {0, 0, 0, 0};
						SetFmatrix(1, static_cast<uint16_t>(ma), pad, FmatrixMode::FMATRIX_LEFT);
						layoutM = ma;
					}
				}
				Nd2NzParams ap{1,
											 static_cast<uint16_t>(m),
											 static_cast<uint16_t>(k),
											 0,
											 static_cast<uint16_t>(aPitch),
											 static_cast<uint16_t>(COMPACT_A ? ma : TM),
											 1,
											 0};
				DataCopy(a1b.Get<int8_t>(), x, ap);
				SetFlag<HardEvent::MTE2_MTE1>(4);
				WaitFlag<HardEvent::MTE2_MTE1>(4);
			}
		}
		const int64_t bPitch = COMPACT_B ? CeilDiv(k, 32) * 32 : MAX_K;
		const auto bevent = static_cast<event_t>(2 + (B_DEPTH == 1 ? 0 : (sequence & 1)));
		WaitFlag<HardEvent::MTE2_MTE1>(bevent);
	}
	__aicore__ inline void RunMmad(int64_t k, int64_t n, int64_t sequence,
																 GlobalTensor<int8_t> nextB = GlobalTensor<int8_t>(), int64_t nextCols = 0,
																 int64_t nextPitch = 0, bool hasNext = false) {
		const int64_t bPitch = COMPACT_B ? CeilDiv(k, 32) * 32 : MAX_K;
		const auto bevent = static_cast<event_t>(2 + (B_DEPTH == 1 ? 0 : (sequence & 1)));
		auto a1 = a1b.Get<int8_t>();
		auto b1 = b1b.Get<int8_t>()[(B_DEPTH == 1 ? 0 : (sequence & 1)) * bPitch * TN];
		auto a0 = a0b.Get<int8_t>(), b0 = b0b.Get<int8_t>();
		auto c = cb.Get<int32_t>();
		const int64_t na = ((n + 31) / 32) * 32;
		int64_t step = 0;
		bool headRetired = false, tailReady = B_HEAD == 0;
		if constexpr (B_HEAD > 0)
			if (k <= B_HEAD) {
				WaitFlag<HardEvent::MTE2_MTE1>(3);
				tailReady = true;
			}
		for (int64_t kk = 0; kk < k; kk += K_STEP, ++step) {
			if constexpr (B_HEAD > 0)
				if (!tailReady && kk >= B_HEAD) {
					WaitFlag<HardEvent::MTE2_MTE1>(3);
					tailReady = true;
				}
			const int64_t remaining = ((k - kk + 31) / 32) * 32;
			const int64_t madK = remaining < K_STEP ? remaining : K_STEP;
			const auto event = static_cast<event_t>(step & 1);
			WaitFlag<HardEvent::M_MTE1>(event);
			auto av = a0[(step & 1) * 32 * 1024], bv = b0[(step & 1) * 32 * 1024];
			LoadData3DParamsV2Pro la;
			la.channelSize = MAX_K;
			la.extConfig = (uint64_t(kk) << 32) | (uint64_t(ma) << 16) | uint64_t(madK);
			la.enTranspose = false;
			LoadData(av, a1, la);
			if constexpr (L1_BARRIER)
				PipeBarrier<PIPE_MTE1>();
			LoadData2dTransposeParams lb;
			lb.startIndex = 0;
			lb.repeatTimes = na / 32;
			lb.srcStride = bPitch / 32;
			lb.dstGap = 1;
			lb.dstFracGap = 0;
			lb.addrMode = 0;
			for (int ki = 0; ki < madK / 32; ++ki) {
				LoadDataWithTranspose(bv[ki * 32 * na], b1[(kk + ki * 32) * 32], lb);
				if constexpr (L1_BARRIER)
					PipeBarrier<PIPE_MTE1>();
			}
			if constexpr (B_HEAD > 0) {
				if (!headRetired && (kk + madK >= B_HEAD || kk + madK >= k)) {
					SetFlag<HardEvent::MTE1_MTE2>(2);
					headRetired = true;
					if (hasNext)
						QueueBHead(nextB, k, nextCols, nextPitch);
				}
			}
			SetFlag<HardEvent::MTE1_M>(event);
			WaitFlag<HardEvent::MTE1_M>(event);
			MmadParams mp;
			mp.m = ma;
			mp.n = na;
			mp.k = madK;
			mp.unitFlag = 0;
			mp.cmatrixInitVal = step == 0;
			Mmad(c, av, bv, mp);
			if ((ma / 16) * (na / 16) < 10)
				PipeBarrier<PIPE_M>();
			SetFlag<HardEvent::M_MTE1>(event);
		}
		SetFlag<HardEvent::MTE1_MTE2>(4);
		if constexpr (B_HEAD > 0)
			SetFlag<HardEvent::MTE1_MTE2>(3);
		else
			SetFlag<HardEvent::MTE1_MTE2>(bevent);
		SetFlag<HardEvent::M_FIX>(6);
		if constexpr (B_DEPTH == 2)
			WaitFlag<HardEvent::M_FIX>(6);
	}
	__aicore__ inline void Compute(GlobalTensor<int8_t> x, int64_t m, int64_t k, int64_t n, int64_t aPitch,
																 bool reuseA, int64_t sequence) {
		Prepare(x, m, k, n, aPitch, reuseA, sequence);
		RunMmad(k, n, sequence);
	}
	__aicore__ inline void Store(GlobalTensor<int32_t> dst) {
		if constexpr (B_DEPTH == 1)
			WaitFlag<HardEvent::M_FIX>(6);
		FixpipeParamsV220 fp;
		fp.nSize = curN;
		fp.mSize = curM;
		fp.srcStride = ma;
		fp.dstStride = TN;
		fp.reluEn = false;
		fp.quantPre = QuantMode_t::NoQuant;
		fp.unitFlag = 0;
		Fixpipe<int32_t, int32_t, CFG_ROW_MAJOR>(dst, cb.Get<int32_t>(), fp);
		SetFlag<HardEvent::FIX_M>(6);
		pendingFix = true;
	}
	__aicore__ inline void End() {
		if (pendingFix)
			WaitFlag<HardEvent::FIX_M>(6);
		WaitFlag<HardEvent::MTE1_MTE2>(2);
		if constexpr (B_DEPTH == 2 || B_HEAD > 0)
			WaitFlag<HardEvent::MTE1_MTE2>(3);
		WaitFlag<HardEvent::MTE1_MTE2>(4);
	}
};

struct NPanelPlan {
	int64_t nt, small, q;
};

template <int TN, bool BALANCED> __aicore__ inline NPanelPlan MakeNPlan(int64_t n) {
	NPanelPlan p;
	p.nt = CeilDiv(n, TN);
	p.q = 0;
	p.small = 0;
	if constexpr (BALANCED) {
		const int64_t blocks = CeilDiv(n, 32);
		p.q = blocks / p.nt;
		p.small = p.nt - blocks % p.nt;
	}
	return p;
}

struct FullBPanel {
	int64_t mt, expert, row, col, rows, cols;
};

template <int TM, int TN, bool BALANCED = false>
__aicore__ inline FullBPanel DecodeFullBPanel(int64_t panel, int64_t nt, int64_t n, int64_t e,
																							const int32_t *gl, const int32_t *prefix,
																							const NPanelPlan &nplan) {
	FullBPanel p;
	p.mt = panel / nt;
	const int64_t ni = panel % nt;
	if constexpr (BALANCED) {
		p.col = (ni * nplan.q + (ni > nplan.small ? ni - nplan.small : 0)) * 32;
		const int64_t padded = (nplan.q + (ni >= nplan.small)) * 32;
		p.cols = n - p.col < padded ? n - p.col : padded;
	} else {
		p.col = ni * TN;
		p.cols = n - p.col < TN ? n - p.col : TN;
	}
	int lo = 0, hi = e;
	while (lo < hi) {
		int mid = (lo + hi) / 2;
		if (prefix[mid] <= p.mt)
			lo = mid + 1;
		else
			hi = mid;
	}
	p.expert = lo;
	const int64_t start = lo ? gl[lo - 1] : 0;
	const int64_t mi = p.mt - (lo ? prefix[lo - 1] : 0), remaining = gl[lo] - start - mi * TM;
	p.row = start + mi * TM;
	p.rows = remaining < TM ? remaining : TM;
	return p;
}

template <int TM, int TN, int VC = 32, bool PREFETCH = true, int MAX_K = 1152, bool L1_BARRIER = true,
					bool SHAPE_BARRIER = true, bool COMPACT_B = false, bool COMPACT_A = false,
					bool EARLY_PREFETCH = false, int K_STEP = 128, bool INPLACE_C = false, int B_DEPTH = 2,
					int B_HEAD = 0, bool NEXT_A = false, bool BALANCED = false>
__aicore__ inline void NativeFullBRun(GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR group_list, GM_ADDR y,
																			GM_ADDR workspace, int64_t m, int64_t k, int64_t n, int64_t e) {
	static_assert(B_HEAD == 0 || (B_DEPTH == 1 && B_HEAD % K_STEP == 0 && B_HEAD < MAX_K), "DisjointKStripes");
	static_assert(!NEXT_A || (B_DEPTH == 1 && B_HEAD > 0), "NextARequiresStripedB");
	static_assert(B_DEPTH == 1 || B_DEPTH == 2, "OneOrTwoBSlots");
	static_assert(B_DEPTH == 2 || !PREFETCH, "SingleBPrefetchAfterLastReader");
	constexpr uint16_t READY = 5, CREDIT = 3;
	constexpr uint64_t SYNC_MODE2 = 2;
	const int64_t cores = GetBlockNum(), core = CoreGroupIndex(), sub = SubCoreIndex();
	GlobalTensor<int8_t> xGm, wGm;
	GlobalTensor<float> scaleGm;
	GlobalTensor<int64_t> glGm;
	GlobalTensor<int32_t> cGm;
	GlobalTensor<half> yGm;
	xGm.SetGlobalBuffer((__gm__ int8_t *)x, m * k);
	wGm.SetGlobalBuffer((__gm__ int8_t *)weight, e * k * n);
	scaleGm.SetGlobalBuffer((__gm__ float *)scale, e * n);
	glGm.SetGlobalBuffer((__gm__ int64_t *)group_list, e);
	yGm.SetGlobalBuffer((__gm__ half *)y, m * n);
	int32_t gl[128], prefix[128];
	int64_t totalMTiles = 0, previous = 0, maxRows = 0;
	for (int ei = 0; ei < e; ++ei) {
		const int64_t end = glGm.GetValue(ei);
		gl[ei] = end;
		const int64_t rows = end - previous;
		if (rows > maxRows)
			maxRows = rows;
		totalMTiles += CeilDiv(rows, TM);
		prefix[ei] = totalMTiles;
		previous = end;
	}
	const int64_t capacity = CeilDiv(maxRows < TM ? maxRows : TM, 16) * 16;
	const auto nplan = MakeNPlan<TN, BALANCED>(n);
	const int64_t nt = nplan.nt, panels = totalMTiles * nt, ringPrefix = nt * TN;
	const int64_t first = panels * core / cores, last = panels * (core + 1) / cores;
	cGm.SetGlobalBuffer((__gm__ int32_t *)workspace, ringPrefix + cores * 2 * capacity * TN);
	TPipe pipe;
	if ASCEND_IS_AIC {
		FullBResidentMmad<TM, TN, MAX_K, L1_BARRIER, SHAPE_BARRIER, COMPACT_B, COMPACT_A, EARLY_PREFETCH, K_STEP,
											B_DEPTH, B_HEAD, NEXT_A>
				mm;
		mm.Init(pipe);
		if (first < last) {
			auto p = DecodeFullBPanel<TM, TN, BALANCED>(first, nt, n, e, gl, prefix, nplan);
			mm.QueueB(wGm[p.expert * k * n + p.col], k, p.cols, n, 0);
		}
		int64_t previousMT = -1, iter = 0;
		for (int64_t panel = first; panel < last; ++panel, ++iter) {
			const auto p = DecodeFullBPanel<TM, TN, BALANCED>(panel, nt, n, e, gl, prefix, nplan);
			if constexpr (B_HEAD > 0) {
				const auto next = DecodeFullBPanel<TM, TN, BALANCED>(panel + 1 < last ? panel + 1 : panel, nt, n, e,
																														 gl, prefix, nplan);
				mm.Prepare(xGm[p.row * k], p.rows, k, p.cols, k, previousMT == p.mt, iter);
				mm.RunMmad(k, p.cols, iter, wGm[next.expert * k * n + next.col], next.cols, n, panel + 1 < last);
			} else if constexpr (EARLY_PREFETCH && PREFETCH) {
				mm.Prepare(xGm[p.row * k], p.rows, k, p.cols, k, previousMT == p.mt, iter);
				if (panel + 1 < last) {
					const auto next = DecodeFullBPanel<TM, TN, BALANCED>(panel + 1, nt, n, e, gl, prefix, nplan);
					mm.QueueB(wGm[next.expert * k * n + next.col], k, next.cols, n, iter + 1);
				}
				mm.RunMmad(k, p.cols, iter);
			} else {
				mm.Compute(xGm[p.row * k], p.rows, k, p.cols, k, previousMT == p.mt, iter);
				if constexpr (PREFETCH) {
					if (panel + 1 < last) {
						const auto next = DecodeFullBPanel<TM, TN, BALANCED>(panel + 1, nt, n, e, gl, prefix, nplan);
						mm.QueueB(wGm[next.expert * k * n + next.col], k, next.cols, n, iter + 1);
					}
				}
			}
			previousMT = p.mt;
			if constexpr (B_DEPTH == 1 && !PREFETCH) {
				if (panel + 1 < last) {
					const auto next = DecodeFullBPanel<TM, TN, BALANCED>(panel + 1, nt, n, e, gl, prefix, nplan);
					if constexpr (NEXT_A)
						if (next.mt != p.mt)
							mm.QueueNextA(xGm[next.row * k], next.rows, k, k);
					if constexpr (B_HEAD > 0)
						mm.QueueBTail(wGm[next.expert * k * n + next.col], k, next.cols, n);
					else
						mm.QueueB(wGm[next.expert * k * n + next.col], k, next.cols, n, iter + 1);
				}
			}
			if (iter >= 2)
				CrossCoreWaitFlag(CREDIT);
			mm.Store(cGm[ringPrefix + (core * 2 + (iter & 1)) * capacity * TN]);
			CrossCoreSetFlag<SYNC_MODE2, PIPE_FIX>(READY);
			if constexpr (!PREFETCH && B_DEPTH != 1) {
				if (panel + 1 < last) {
					const auto next = DecodeFullBPanel<TM, TN, BALANCED>(panel + 1, nt, n, e, gl, prefix, nplan);
					mm.QueueB(wGm[next.expert * k * n + next.col], k, next.cols, n, iter + 1);
				}
			}
		}
		for (int64_t i = 0; i < (last - first < 2 ? last - first : 2); ++i)
			CrossCoreWaitFlag(CREDIT);
		mm.End();
	} else {
		TQue<TPosition::VECIN, 1> cQue, sQue;
		TQue<TPosition::VECOUT, 1> oQue;
		TBuf<TPosition::VECCALC> zBuf, uBuf;
		constexpr int CHUNK_ELEMS = VC * TN;
		pipe.InitBuffer(cQue, 1, CHUNK_ELEMS * 4);
		pipe.InitBuffer(sQue, 1, TN * 4);
		pipe.InitBuffer(oQue, 1, CHUNK_ELEMS * 2);
		if constexpr (!INPLACE_C)
			pipe.InitBuffer(zBuf, CHUNK_ELEMS * 4);
		pipe.InitBuffer(uBuf, CHUNK_ELEMS * 4);
		auto z = INPLACE_C ? LocalTensor<float>() : zBuf.Get<float>(), u = uBuf.Get<float>();
		int64_t iter = 0;
		for (int64_t panel = first; panel < last; ++panel, ++iter) {
			const auto p = DecodeFullBPanel<TM, TN, BALANCED>(panel, nt, n, e, gl, prefix, nplan);
			const int64_t perSub = (p.rows + 1) / 2, begin = sub * perSub;
			const int64_t end = begin < p.rows ? (begin + perSub < p.rows ? begin + perSub : p.rows) : begin;
			const int64_t azN = CeilDiv(p.cols, 16) * 16, alignedN = CeilDiv(p.cols, 8) * 8;
			auto scales = sQue.AllocTensor<float>();
			DataCopyExtParams sp{1, static_cast<uint32_t>(p.cols * 4), 0, 0, 0};
			DataCopyPadExtParams<float> spad{true, 0, 0, 0};
			DataCopyPad(scales, scaleGm[p.expert * n + p.col], sp, spad);
			sQue.EnQue(scales);
			CrossCoreWaitFlag(READY);
			scales = sQue.DeQue<float>();
			for (int64_t row = begin; row < end; row += VC) {
				const int64_t rc = end - row < VC ? end - row : VC;
				auto c = cQue.AllocTensor<int32_t>();
				DataCopyExtParams cp{static_cast<uint16_t>(rc), static_cast<uint32_t>(p.cols * 4),
														 static_cast<uint32_t>((TN - p.cols) * 4),
														 static_cast<uint32_t>((azN - alignedN) / 8), 0};
				DataCopyPadExtParams<int32_t> cpad{true, 0, 0, 0};
				const int64_t cb = ringPrefix + (core * 2 + (iter & 1)) * capacity * TN + row * TN;
				DataCopyPad(c, cGm[cb], cp, cpad);
				cQue.EnQue(c);
				c = cQue.DeQue<int32_t>();
				if constexpr (INPLACE_C)
					z = c.ReinterpretCast<float>();
				Cast(z, c, RoundMode::CAST_NONE, rc * azN);
				if constexpr (!INPLACE_C)
					cQue.FreeTensor(c);
				PipeBarrier<PIPE_V>();
				BinaryRepeatParams bp{1, 1, 1, static_cast<uint8_t>(azN / 8), static_cast<uint8_t>(azN / 8), 0};
				for (int64_t col = 0; col < azN; col += 64) {
					const uint64_t mask = azN - col < 64 ? azN - col : 64;
					Mul(z[col], z[col], scales[col], mask, static_cast<uint8_t>(rc), bp);
				}
				PipeBarrier<PIPE_V>();
				GeluComputeSigmoid(z, u, rc * azN);
				PipeBarrier<PIPE_V>();
				if constexpr (INPLACE_C)
					cQue.FreeTensor(c);
				auto o = oQue.AllocTensor<half>();
				Cast(o, u, RoundMode::CAST_NONE, rc * azN);
				oQue.EnQue(o);
				o = oQue.DeQue<half>();
				DataCopyExtParams op{static_cast<uint16_t>(rc), static_cast<uint32_t>(p.cols * 2), 0,
														 static_cast<uint32_t>((n - p.cols) * 2), 0};
				DataCopyPad(yGm[(p.row + row) * n + p.col], o, op);
				oQue.FreeTensor(o);
			}
			sQue.FreeTensor(scales);
			CrossCoreSetFlag<SYNC_MODE2, PIPE_MTE2>(CREDIT);
		}
	}
}

}
__global__ __mix__(1, 2)
		__attribute__((aligned(64))) void bk490(GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR g, GM_ADDR y, GM_ADDR ws,
																						int64_t m, int64_t k, int64_t n, int64_t e) {
	os_i3_full_double_wide::NativeFullBRun<192, 128, 32, true, 1056, false, false, true, true, true, 160, false,
																				 2, 0, false, false>(x, w, s, g, y, ws, m, k, n, e);
}
namespace main_rank1_adaptive_cap2 {
using namespace os_runtime;

template <bool CACHE_B, int TM = 128, int TN = 256, int VC = 32>
__aicore__ inline void Run(GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR group_list, GM_ADDR y,
													 GM_ADDR workspace, int64_t m, int64_t k, int64_t n, int64_t e, int64_t mBundleSpan,
													 bool rememberBPanel, bool earlyAPrefetch) {
	constexpr int TILE_M = TM, TILE_N = TN, VEC_CHUNK_M = VC;
	constexpr int MAX_TAIL = 1;
	constexpr uint16_t GMM_SYNC_AIV_AIC = 3, GMM_SYNC_AIC_AIV = 5;
	constexpr uint64_t SYNC_MODE2 = 2;
	const int64_t mainK = (k / 128) * 128, KT = k - mainK;
	const uint32_t coreNum = GetBlockNum(), coreIdx = CoreGroupIndex(), subIdx = SubCoreIndex();
	GlobalTensor<int8_t> xGm, wGm;
	GlobalTensor<float> scaleGm;
	GlobalTensor<int64_t> glGm;
	GlobalTensor<int32_t> cGm;
	GlobalTensor<half> yGm;
	xGm.SetGlobalBuffer((__gm__ int8_t *)x, m * k);
	wGm.SetGlobalBuffer((__gm__ int8_t *)weight, e * k * n);
	scaleGm.SetGlobalBuffer((__gm__ float *)scale, e * n);
	glGm.SetGlobalBuffer((__gm__ int64_t *)group_list, e);
	cGm.SetGlobalBuffer((__gm__ int32_t *)workspace, coreNum * 2 * TM * TN);
	yGm.SetGlobalBuffer((__gm__ half *)y, m * n);
	int32_t gl[128], active[128];
	int64_t totalMTiles = 0, maxMTiles = 0, activeCount = 0, prev = 0;
	for (int ei = 0; ei < e; ++ei) {
		const int64_t groupEnd = glGm.GetValue(ei);
		gl[ei] = groupEnd;
		const int64_t tiles = CeilDiv(groupEnd - prev, TM);
		if (tiles > 0)
			active[activeCount++] = ei;
		totalMTiles += tiles;
		if (tiles > maxMTiles)
			maxMTiles = tiles;
		prev = groupEnd;
	}
	const int64_t NT = CeilDiv(n, TN);
	const int64_t wholeTasks = activeCount * NT;
	const bool wholeBalanced =
			totalMTiles >= 3 * activeCount && wholeTasks >= coreNum &&
			2 * CeilDiv(wholeTasks, coreNum) * maxMTiles <= 3 * CeilDiv(totalMTiles * NT, coreNum);
	const int64_t span = mBundleSpan < 0 ? (wholeBalanced ? maxMTiles : -mBundleSpan)
																			 : (mBundleSpan > 0 ? mBundleSpan : maxMTiles);
	int64_t tasks = activeCount * NT;
	if (span < maxMTiles) {
		tasks = 0;
		for (int ai = 0; ai < activeCount; ++ai) {
			const int ei = active[ai];
			const int64_t start = ei ? gl[ei - 1] : 0, tiles = CeilDiv(gl[ei] - start, TM);
			tasks += CeilDiv(tiles, span) * NT;
		}
	}
	const int64_t maxTaskM = maxMTiles < span ? maxMTiles : span;
	const bool eligible = mainK >= 512 && mainK < 1024 && KT == 1 && totalMTiles >= 3 * activeCount &&
												tasks >= coreNum &&
												2 * CeilDiv(tasks, coreNum) * maxTaskM <= 3 * CeilDiv(totalMTiles * NT, coreNum);
	if (!eligible) {
		main_rank1_v32::TailRun<TM, TN, VC>(x, weight, scale, group_list, y, workspace, m, k, n, e, gl);
		return;
	}
	int64_t iter = 0, slot = 0;
	if ASCEND_IS_AIC {
		LocalTensor<int8_t> a1(TPosition::A1, 0, 128 * 1024);
		LocalTensor<int8_t> b1(TPosition::B1, 128 * 1024, 256 * 1024);
		LocalTensor<int8_t> a2(TPosition::A2, 0, 2 * TM * 128);
		LocalTensor<int8_t> b2(TPosition::B2, 0, 2 * 128 * TN);
		LocalTensor<int32_t> c1(TPosition::CO1, 0, TM * TN);
		int64_t mmaIndex = 0;
		int64_t cachedExpert = -1, cachedNPanel = -1;
		bool l1ReadersPending = false, cReaderPending = false;
		bool aPrefetched = false;
		int64_t globalTaskBase = 0;
		for (int64_t part = 0; part < CeilDiv(maxMTiles, span); ++part) {
			const int64_t miBegin = part * span;
			int stillActive = 0;
			for (int ai = 0; ai < activeCount; ++ai) {
				const int ei = active[ai];
				const int64_t start = ei ? gl[ei - 1] : 0;
				if (CeilDiv(gl[ei] - start, TM) > miBegin)
					active[stillActive++] = ei;
			}
			activeCount = stillActive;
			const int64_t stageTasks = activeCount * NT;
			const int64_t firstTask = (coreIdx + coreNum - globalTaskBase % coreNum) % coreNum;
			for (int64_t task = firstTask; task < stageTasks; task += coreNum) {
				const int ei = active[task / NT];
				const int64_t ni = task % NT, start = ei ? gl[ei - 1] : 0, me = gl[ei] - start;
				const int64_t groupTiles = CeilDiv(me, TM);
				const int64_t miEnd = groupTiles < miBegin + span ? groupTiles : miBegin + span;
				const int64_t colBase = ni * TN, curN = n - colBase < TN ? n - colBase : TN;
				for (int64_t mi = miBegin; mi < miEnd; ++mi) {
					const int64_t rowBase = start + mi * TM, curM = me - mi * TM < TM ? me - mi * TM : TM;
					if (l1ReadersPending) {
						WaitFlag<HardEvent::MTE1_MTE2>(0);
						l1ReadersPending = false;
					}
					if (!CACHE_B || (mi == miBegin && (!rememberBPanel || ei != cachedExpert || ni != cachedNPanel))) {
						Nd2NzParams bp;
						bp.ndNum = 1;
						bp.nValue = mainK;
						bp.dValue = curN;
						bp.srcNdMatrixStride = 0;
						bp.srcDValue = n;
						bp.dstNzC0Stride = mainK;
						bp.dstNzNStride = 1;
						bp.dstNzMatrixStride = 0;
						DataCopy(b1, wGm[ei * k * n + colBase], bp);
						cachedExpert = ei;
						cachedNPanel = ni;
					}
					if (!aPrefetched) {
						Nd2NzParams ap;
						ap.ndNum = 1;
						ap.nValue = curM;
						ap.dValue = mainK;
						ap.srcNdMatrixStride = 0;
						ap.srcDValue = k;
						ap.dstNzC0Stride = TM;
						ap.dstNzNStride = 1;
						ap.dstNzMatrixStride = 0;
						DataCopy(a1, xGm[rowBase * k], ap);
						SetFlag<HardEvent::MTE2_MTE1>(0);
					}
					WaitFlag<HardEvent::MTE2_MTE1>(0);
					aPrefetched = false;
					for (int64_t kb = 0; kb < mainK; kb += 128) {
						const int bank = mmaIndex & 1;
						const event_t freeEvent = static_cast<event_t>(bank);
						if (mmaIndex >= 2)
							WaitFlag<HardEvent::M_MTE1>(freeEvent);
						LocalTensor<int8_t> aa2 = a2[bank * TM * 128], bb2 = b2[bank * 128 * TN];
						LoadData2DParams lda;
						lda.startIndex = 0;
						lda.repeatTimes = 4;
						lda.srcStride = TM / 16;
						lda.dstGap = 0;
						lda.ifTranspose = false;
						lda.addrMode = 0;
						for (int mi16 = 0; mi16 < TM / 16; ++mi16)
							LoadData(aa2[mi16 * 16 * 128], a1[kb * TM + mi16 * 512], lda);
						LoadData2dTransposeParams ldb;
						ldb.startIndex = 0;
						ldb.repeatTimes = TN / 32;
						ldb.srcStride = mainK / 32;
						ldb.dstGap = 1;
						ldb.dstFracGap = 0;
						ldb.addrMode = 0;
						for (int ki32 = 0; ki32 < 4; ++ki32)
							LoadDataWithTranspose(bb2[ki32 * 32 * TN], b1[(kb / 32 + ki32) * 1024], ldb);
						if (kb + 128 == mainK) {
							SetFlag<HardEvent::MTE1_MTE2>(0);
							l1ReadersPending = true;
						}
						SetFlag<HardEvent::MTE1_M>(0);
						WaitFlag<HardEvent::MTE1_M>(0);
						if (kb == 0 && cReaderPending) {
							WaitFlag<HardEvent::FIX_M>(0);
							cReaderPending = false;
						}
						MmadParams mm;
						mm.m = TM;
						mm.n = TN;
						mm.k = 128;
						mm.cmatrixSource = false;
						mm.cmatrixInitVal = kb == 0;
						mm.unitFlag = 0;
						Mmad(c1, aa2, bb2, mm);
						SetFlag<HardEvent::M_MTE1>(freeEvent);
						++mmaIndex;
					}
					if (CACHE_B && earlyAPrefetch && mi + 1 < miEnd) {
						WaitFlag<HardEvent::MTE1_MTE2>(0);
						l1ReadersPending = false;
						const int64_t nextRow = start + (mi + 1) * TM;
						const int64_t nextM = me - (mi + 1) * TM < TM ? me - (mi + 1) * TM : TM;
						Nd2NzParams ap;
						ap.ndNum = 1;
						ap.nValue = nextM;
						ap.dValue = mainK;
						ap.srcNdMatrixStride = 0;
						ap.srcDValue = k;
						ap.dstNzC0Stride = TM;
						ap.dstNzNStride = 1;
						ap.dstNzMatrixStride = 0;
						DataCopy(a1, xGm[nextRow * k], ap);
						SetFlag<HardEvent::MTE2_MTE1>(0);
						aPrefetched = true;
					}
					SetFlag<HardEvent::M_FIX>(0);
					WaitFlag<HardEvent::M_FIX>(0);
					if (iter >= 2)
						CrossCoreWaitFlag(GMM_SYNC_AIV_AIC);
					FixpipeParamsV220 fp;
					fp.nSize = TN;
					fp.mSize = curM;
					fp.srcStride = TM;
					fp.dstStride = TN;
					fp.reluEn = false;
					fp.quantPre = QuantMode_t::NoQuant;
					fp.unitFlag = 0;
					Fixpipe<int32_t, int32_t, CFG_ROW_MAJOR>(cGm[(coreIdx * 2 + slot) * TM * TN], c1, fp);
					SetFlag<HardEvent::FIX_M>(0);
					cReaderPending = true;
					CrossCoreSetFlag<SYNC_MODE2, PIPE_FIX>(GMM_SYNC_AIC_AIV);
					slot ^= 1;
					++iter;
				}
			}
			globalTaskBase += stageTasks;
		}
		if (mmaIndex > 0) {
			WaitFlag<HardEvent::M_MTE1>(0);
			if (mmaIndex > 1)
				WaitFlag<HardEvent::M_MTE1>(1);
		}
		if (aPrefetched)
			WaitFlag<HardEvent::MTE2_MTE1>(0);
		if (l1ReadersPending)
			WaitFlag<HardEvent::MTE1_MTE2>(0);
		if (cReaderPending)
			WaitFlag<HardEvent::FIX_M>(0);
	} else {
		TPipe pipe;
		TQue<TPosition::VECIN, 1> cQue, sQue, aQue, bQue;
		TQue<TPosition::VECOUT, 1> oQue;
		TBuf<TPosition::VECCALC> zBuf, uBuf, bHalfBuf, bIntBuf, tailBuf, aGatherBuf, aRepeatBuf, aIndexBuf;
		constexpr uint32_t CHUNK_ELEMS = VC * TN;
		pipe.InitBuffer(cQue, 1, CHUNK_ELEMS * 4);
		pipe.InitBuffer(sQue, 1, TN * 4);
		pipe.InitBuffer(oQue, 1, CHUNK_ELEMS * 2);
		pipe.InitBuffer(zBuf, CHUNK_ELEMS * 4);
		pipe.InitBuffer(uBuf, CHUNK_ELEMS * 4);
		pipe.InitBuffer(aQue, 1, (TM / 2) * 32);
		pipe.InitBuffer(bQue, 1, MAX_TAIL * TN);
		pipe.InitBuffer(bHalfBuf, MAX_TAIL * TN * 2);
		pipe.InitBuffer(bIntBuf, MAX_TAIL * TN * 4);
		pipe.InitBuffer(tailBuf, (TM / 2) * TN * 4);
		pipe.InitBuffer(aGatherBuf, (TM / 2) * 4);
		pipe.InitBuffer(aRepeatBuf, (TM / 2) * 8 * 4);
		pipe.InitBuffer(aIndexBuf, (TM / 2) * 4);
		LocalTensor<half> ah = zBuf.Get<half>();
		LocalTensor<int32_t> ai = uBuf.Get<int32_t>();
		LocalTensor<int32_t> ag = aGatherBuf.Get<int32_t>(), ar = aRepeatBuf.Get<int32_t>();
		LocalTensor<int32_t> index = aIndexBuf.Get<int32_t>();
		CreateVecIndex(index, static_cast<int32_t>(0), TM / 2);
		PipeBarrier<PIPE_V>();
		Muls(index, index, static_cast<int32_t>(128), TM / 2);
		PipeBarrier<PIPE_V>();
		LocalTensor<half> bh = bHalfBuf.Get<half>();
		LocalTensor<int32_t> bi = bIntBuf.Get<int32_t>(), tail = tailBuf.Get<int32_t>();
		LocalTensor<float> z = zBuf.Get<float>(), u = uBuf.Get<float>();
		int64_t globalTaskBase = 0;
		for (int64_t part = 0; part < CeilDiv(maxMTiles, span); ++part) {
			const int64_t miBegin = part * span;
			int stillActive = 0;
			for (int ai = 0; ai < activeCount; ++ai) {
				const int ei = active[ai];
				const int64_t start = ei ? gl[ei - 1] : 0;
				if (CeilDiv(gl[ei] - start, TM) > miBegin)
					active[stillActive++] = ei;
			}
			activeCount = stillActive;
			const int64_t stageTasks = activeCount * NT;
			const int64_t firstTask = (coreIdx + coreNum - globalTaskBase % coreNum) % coreNum;
			for (int64_t task = firstTask; task < stageTasks; task += coreNum) {
				const int ei = active[task / NT];
				const int64_t ni = task % NT, start = ei ? gl[ei - 1] : 0, me = gl[ei] - start;
				const int64_t groupTiles = CeilDiv(me, TM);
				const int64_t miEnd = groupTiles < miBegin + span ? groupTiles : miBegin + span;
				for (int64_t mi = miBegin; mi < miEnd; ++mi) {
					const int64_t rowBase = start + mi * TM, curM = me - mi * TM < TM ? me - mi * TM : TM;
					const bool useTail = true;
					const int64_t rowsPerSub = (curM + 1) / 2, subRowBegin = subIdx * rowsPerSub;
					const int64_t subRowEnd = subRowBegin < curM
																				? (subRowBegin + rowsPerSub < curM ? subRowBegin + rowsPerSub : curM)
																				: subRowBegin;
					const int64_t colBase = ni * TN, curN = n - colBase < TN ? n - colBase : TN;
					const bool seqC = false;
					LocalTensor<float> s = sQue.AllocTensor<float>();
					DataCopyExtParams sp{1, static_cast<uint32_t>(curN * 4), 0, 0, 0};
					DataCopyPadExtParams<float> spad{true, 0, 0, 0};
					DataCopyPad(s, scaleGm[ei * n + colBase], sp, spad);
					sQue.EnQue(s);
					const int64_t azTail = ((curN + 15) / 16) * 16;
					const int64_t nrows = subRowEnd - subRowBegin;
					if (nrows > 0 && useTail) {
						LocalTensor<int8_t> bt = bQue.AllocTensor<int8_t>();
						DataCopyExtParams bp{static_cast<uint16_t>(KT), static_cast<uint32_t>(curN),
																 static_cast<uint32_t>(n - curN),
																 static_cast<uint32_t>((TN - ((curN + 31) / 32) * 32) / 32), 0};
						DataCopyPadExtParams<int8_t> pad{true, 0, 0, 0};
						DataCopyPad(bt, wGm[ei * k * n + mainK * n + colBase], bp, pad);
						bQue.EnQue(bt);
						bt = bQue.DeQue<int8_t>();
						Cast(bh, bt, RoundMode::CAST_NONE, KT * TN);
						PipeBarrier<PIPE_V>();
						Cast(bi, bh, RoundMode::CAST_RINT, KT * TN);
						bQue.FreeTensor(bt);
						LocalTensor<int8_t> at = aQue.AllocTensor<int8_t>();
						DataCopyExtParams ap{static_cast<uint16_t>(nrows), static_cast<uint32_t>(KT),
																 static_cast<uint32_t>(k - KT), 0, 0};
						DataCopyPad(at, xGm[(rowBase + subRowBegin) * k + mainK], ap, pad);
						aQue.EnQue(at);
						at = aQue.DeQue<int8_t>();
						Cast(ah, at, RoundMode::CAST_NONE, nrows * 32);
						PipeBarrier<PIPE_V>();
						Cast(ai, ah, RoundMode::CAST_RINT, nrows * 32);
						PipeBarrier<PIPE_V>();
						LocalTensor<int32_t> tmp = zBuf.Get<int32_t>();
						const int64_t roundedRows = ((nrows + 7) / 8) * 8;
						BinaryRepeatParams outer{1, 0, 1, static_cast<uint8_t>(azTail / 8), 1, 0};
						for (int64_t kk = 0; kk < KT; ++kk) {
							Gather(ag, ai, index.ReinterpretCast<uint32_t>(), kk * 4, roundedRows);
							PipeBarrier<PIPE_V>();
							Brcb(ar, ag, static_cast<uint8_t>(roundedRows / 8), BrcbRepeatParams{1, 8});
							PipeBarrier<PIPE_V>();
							for (int64_t rr = 0; rr < nrows; rr += VC) {
								const int64_t rc = nrows - rr < VC ? nrows - rr : VC;
								LocalTensor<int32_t> dest = kk == 0 ? tail[rr * azTail] : tmp;
								for (int64_t col = 0; col < azTail; col += 64) {
									const uint64_t mask = azTail - col < 64 ? azTail - col : 64;
									Mul(dest[col], ar[rr * 8], bi[kk * TN + col], mask, static_cast<uint8_t>(rc), outer);
								}
								if (kk > 0) {
									PipeBarrier<PIPE_V>();
									Add(tail[rr * azTail], tail[rr * azTail], tmp, rc * azTail);
									PipeBarrier<PIPE_V>();
								}
							}
							PipeBarrier<PIPE_V>();
						}
						aQue.FreeTensor(at);
					}
					CrossCoreWaitFlag(GMM_SYNC_AIC_AIV);
					s = sQue.DeQue<float>();
					if (subRowBegin < subRowEnd) {
						const int64_t azN = ((curN + 15) / 16) * 16, alignedN = ((curN + 7) / 8) * 8;
						const int64_t smRows = subRowEnd - subRowBegin < VC ? subRowEnd - subRowBegin : VC;
						for (int64_t row = subRowBegin; row < subRowEnd; row += VC) {
							const int64_t rc = subRowEnd - row < VC ? subRowEnd - row : VC;
							LocalTensor<int32_t> c = cQue.AllocTensor<int32_t>();
							DataCopyExtParams cp{static_cast<uint16_t>(rc), static_cast<uint32_t>(curN * 4),
																	 static_cast<uint32_t>((TN - curN) * 4),
																	 static_cast<uint32_t>((azN - alignedN) / 8), 0};
							DataCopyPadExtParams<int32_t> cpad{true, 0, 0, 0};
							const int64_t cb = (coreIdx * 2 + slot) * TM * TN + row * TN;
							DataCopyPad(c, cGm[cb], cp, cpad);
							cQue.EnQue(c);
							c = cQue.DeQue<int32_t>();
							if (useTail) {
								Add(c, c, tail[(row - subRowBegin) * azN], rc * azN);
								PipeBarrier<PIPE_V>();
							}
							Cast(z, c, RoundMode::CAST_NONE, rc * azN);
							cQue.FreeTensor(c);
							PipeBarrier<PIPE_V>();
							BinaryRepeatParams bp{1, 1, 1, static_cast<uint8_t>(azN / 8), static_cast<uint8_t>(azN / 8), 0};
							for (int64_t col = 0; col < azN; col += 64) {
								uint64_t mask = azN - col < 64 ? azN - col : 64;
								Mul(z[col], z[col], s[col], mask, static_cast<uint8_t>(rc), bp);
							}
							PipeBarrier<PIPE_V>();
							GeluComputeSigmoid(z, u, rc * azN);
							PipeBarrier<PIPE_V>();
							LocalTensor<half> o = oQue.AllocTensor<half>();
							Cast(o, u, RoundMode::CAST_NONE, rc * azN);
							oQue.EnQue(o);
							o = oQue.DeQue<half>();
							DataCopyExtParams op{static_cast<uint16_t>(rc), static_cast<uint32_t>(curN * 2), 0,
																	 static_cast<uint32_t>((n - curN) * 2), 0};
							DataCopyPad(yGm[(rowBase + row) * n + colBase], o, op);
							oQue.FreeTensor(o);
						}
					}
					sQue.FreeTensor(s);
					CrossCoreSetFlag<SYNC_MODE2, PIPE_MTE2>(GMM_SYNC_AIV_AIC);
					slot ^= 1;
					++iter;
				}
			}
			globalTaskBase += stageTasks;
		}
	}
}

}
namespace main_rank1_range_b {
namespace registered_fp32 {
using namespace os_runtime;

template <bool CACHE_B, int TM = 128, int TN = 256, int VC = 32>
__aicore__ inline void Run(GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR group_list, GM_ADDR y,
													 GM_ADDR workspace, int64_t m, int64_t k, int64_t n, int64_t e,
													 int64_t rangeScheduleMode) {
	constexpr int TILE_M = TM, TILE_N = TN, VEC_CHUNK_M = VC;
	constexpr int MAX_TAIL = 1;
	constexpr uint16_t GMM_SYNC_AIV_AIC = 3, GMM_SYNC_AIC_AIV = 5;
	constexpr uint64_t SYNC_MODE2 = 2;
	const int64_t mainK = (k / 128) * 128, KT = k - mainK;
	const uint32_t coreNum = GetBlockNum(), coreIdx = CoreGroupIndex(), subIdx = SubCoreIndex();
	GlobalTensor<int8_t> xGm, wGm;
	GlobalTensor<float> scaleGm;
	GlobalTensor<int64_t> glGm;
	GlobalTensor<int32_t> cGm;
	GlobalTensor<half> yGm;
	xGm.SetGlobalBuffer((__gm__ int8_t *)x, m * k);
	wGm.SetGlobalBuffer((__gm__ int8_t *)weight, e * k * n);
	scaleGm.SetGlobalBuffer((__gm__ float *)scale, e * n);
	glGm.SetGlobalBuffer((__gm__ int64_t *)group_list, e);
	cGm.SetGlobalBuffer((__gm__ int32_t *)workspace, coreNum * 2 * TM * TN);
	yGm.SetGlobalBuffer((__gm__ half *)y, m * n);
	int32_t gl[128], active[128];
	int64_t totalMTiles = 0, maxMTiles = 0, activeCount = 0, prev = 0;
	int64_t minMTiles = 1LL << 60;
	for (int ei = 0; ei < e; ++ei) {
		const int64_t groupEnd = glGm.GetValue(ei);
		gl[ei] = groupEnd;
		const int64_t tiles = CeilDiv(groupEnd - prev, TM);
		if (tiles > 0) {
			active[activeCount++] = ei;
			if (tiles < minMTiles)
				minMTiles = tiles;
		}
		totalMTiles += tiles;
		if (tiles > maxMTiles)
			maxMTiles = tiles;
		prev = groupEnd;
	}
	const int64_t NT = CeilDiv(n, TN), totalCTiles = totalMTiles * NT;
	const bool lengthsBalanced = activeCount > 0 && maxMTiles - minMTiles <= 1;
	const bool eligible = mainK >= 512 && mainK < 1024 && KT == 1 && totalMTiles >= 3 * activeCount &&
												totalCTiles >= 2 * coreNum && (rangeScheduleMode != 2 || lengthsBalanced);
	if (!eligible) {
		main_rank1_adaptive_cap2::Run<CACHE_B, TM, TN, VC>(x, weight, scale, group_list, y, workspace, m, k, n, e,
																											 -2, true, false);
		return;
	}
	int64_t iter = 0, slot = 0;
	if ASCEND_IS_AIC {
		LocalTensor<int8_t> a1(TPosition::A1, 0, 128 * 1024);
		LocalTensor<int8_t> b1(TPosition::B1, 128 * 1024, 256 * 1024);
		LocalTensor<int8_t> a2(TPosition::A2, 0, 2 * TM * 128);
		LocalTensor<int8_t> b2(TPosition::B2, 0, 2 * 128 * TN);
		LocalTensor<int32_t> c1(TPosition::CO1, 0, TM * TN);
		int64_t mmaIndex = 0;
		bool l1ReadersPending = false, cReaderPending = false;
		const int64_t coreTileBegin = totalCTiles * coreIdx / coreNum;
		const int64_t coreTileEnd = totalCTiles * (coreIdx + 1) / coreNum;
		int64_t bundleTileBase = 0;
		for (int activeIndex = 0; activeIndex < activeCount; ++activeIndex) {
			const int ei = active[activeIndex];
			const int64_t start = ei ? gl[ei - 1] : 0, me = gl[ei] - start;
			const int64_t groupTiles = CeilDiv(me, TM);
			for (int64_t ni = 0; ni < NT; ++ni) {
				const int64_t miBegin = coreTileBegin > bundleTileBase ? coreTileBegin - bundleTileBase : 0;
				const int64_t endLimit = coreTileEnd - bundleTileBase;
				const int64_t miEnd = endLimit < groupTiles ? endLimit : groupTiles;
				bundleTileBase += groupTiles;
				if (miEnd <= 0 || miBegin >= miEnd)
					continue;
				const int64_t colBase = ni * TN, curN = n - colBase < TN ? n - colBase : TN;
				for (int64_t mi = miBegin; mi < miEnd; ++mi) {
					const int64_t rowBase = start + mi * TM, curM = me - mi * TM < TM ? me - mi * TM : TM;
					if (l1ReadersPending) {
						WaitFlag<HardEvent::MTE1_MTE2>(0);
						l1ReadersPending = false;
					}
					if (!CACHE_B || mi == miBegin) {
						Nd2NzParams bp;
						bp.ndNum = 1;
						bp.nValue = mainK;
						bp.dValue = curN;
						bp.srcNdMatrixStride = 0;
						bp.srcDValue = n;
						bp.dstNzC0Stride = mainK;
						bp.dstNzNStride = 1;
						bp.dstNzMatrixStride = 0;
						DataCopy(b1, wGm[ei * k * n + colBase], bp);
					}
					Nd2NzParams ap;
					ap.ndNum = 1;
					ap.nValue = curM;
					ap.dValue = mainK;
					ap.srcNdMatrixStride = 0;
					ap.srcDValue = k;
					ap.dstNzC0Stride = TM;
					ap.dstNzNStride = 1;
					ap.dstNzMatrixStride = 0;
					DataCopy(a1, xGm[rowBase * k], ap);
					SetFlag<HardEvent::MTE2_MTE1>(0);
					WaitFlag<HardEvent::MTE2_MTE1>(0);
					for (int64_t kb = 0; kb < mainK; kb += 128) {
						const int bank = mmaIndex & 1;
						const event_t freeEvent = static_cast<event_t>(bank);
						if (mmaIndex >= 2)
							WaitFlag<HardEvent::M_MTE1>(freeEvent);
						LocalTensor<int8_t> aa2 = a2[bank * TM * 128], bb2 = b2[bank * 128 * TN];
						LoadData2DParams lda;
						lda.startIndex = 0;
						lda.repeatTimes = 4;
						lda.srcStride = TM / 16;
						lda.dstGap = 0;
						lda.ifTranspose = false;
						lda.addrMode = 0;
						for (int mi16 = 0; mi16 < TM / 16; ++mi16)
							LoadData(aa2[mi16 * 16 * 128], a1[kb * TM + mi16 * 512], lda);
						LoadData2dTransposeParams ldb;
						ldb.startIndex = 0;
						ldb.repeatTimes = TN / 32;
						ldb.srcStride = mainK / 32;
						ldb.dstGap = 1;
						ldb.dstFracGap = 0;
						ldb.addrMode = 0;
						for (int ki32 = 0; ki32 < 4; ++ki32)
							LoadDataWithTranspose(bb2[ki32 * 32 * TN], b1[(kb / 32 + ki32) * 1024], ldb);
						if (kb + 128 == mainK) {
							SetFlag<HardEvent::MTE1_MTE2>(0);
							l1ReadersPending = true;
						}
						SetFlag<HardEvent::MTE1_M>(0);
						WaitFlag<HardEvent::MTE1_M>(0);
						if (kb == 0 && cReaderPending) {
							WaitFlag<HardEvent::FIX_M>(0);
							cReaderPending = false;
						}
						MmadParams mm;
						mm.m = TM;
						mm.n = TN;
						mm.k = 128;
						mm.cmatrixSource = false;
						mm.cmatrixInitVal = kb == 0;
						mm.unitFlag = 0;
						Mmad(c1, aa2, bb2, mm);
						SetFlag<HardEvent::M_MTE1>(freeEvent);
						++mmaIndex;
					}
					SetFlag<HardEvent::M_FIX>(0);
					WaitFlag<HardEvent::M_FIX>(0);
					if (iter >= 2)
						CrossCoreWaitFlag(GMM_SYNC_AIV_AIC);
					FixpipeParamsV220 fp;
					fp.nSize = TN;
					fp.mSize = curM;
					fp.srcStride = TM;
					fp.dstStride = TN;
					fp.reluEn = false;
					fp.quantPre = QuantMode_t::NoQuant;
					fp.unitFlag = 0;
					Fixpipe<int32_t, int32_t, CFG_ROW_MAJOR>(cGm[(coreIdx * 2 + slot) * TM * TN], c1, fp);
					SetFlag<HardEvent::FIX_M>(0);
					cReaderPending = true;
					CrossCoreSetFlag<SYNC_MODE2, PIPE_FIX>(GMM_SYNC_AIC_AIV);
					slot ^= 1;
					++iter;
				}
			}
		}
		if (mmaIndex > 0) {
			WaitFlag<HardEvent::M_MTE1>(0);
			if (mmaIndex > 1)
				WaitFlag<HardEvent::M_MTE1>(1);
		}
		if (l1ReadersPending)
			WaitFlag<HardEvent::MTE1_MTE2>(0);
		if (cReaderPending)
			WaitFlag<HardEvent::FIX_M>(0);
	} else {
		TPipe pipe;
		TQue<TPosition::VECIN, 1> cQue, sQue, aQue, bQue;
		TQue<TPosition::VECOUT, 1> oQue;
		TBuf<TPosition::VECCALC> zBuf, uBuf, bHalfBuf, bIntBuf, tailBuf, aGatherBuf, aRepeatBuf, aIndexBuf;
		constexpr uint32_t CHUNK_ELEMS = VC * TN;
		pipe.InitBuffer(cQue, 1, CHUNK_ELEMS * 4);
		pipe.InitBuffer(sQue, 1, TN * 4);
		pipe.InitBuffer(oQue, 1, CHUNK_ELEMS * 2);
		pipe.InitBuffer(zBuf, CHUNK_ELEMS * 4);
		pipe.InitBuffer(uBuf, CHUNK_ELEMS * 4);
		pipe.InitBuffer(aQue, 1, (TM / 2) * 32);
		pipe.InitBuffer(bQue, 1, MAX_TAIL * TN);
		pipe.InitBuffer(bHalfBuf, MAX_TAIL * TN * 2);
		pipe.InitBuffer(bIntBuf, MAX_TAIL * TN * 4);
		pipe.InitBuffer(tailBuf, (TM / 2) * TN * 4);
		pipe.InitBuffer(aGatherBuf, (TM / 2) * 4);
		pipe.InitBuffer(aRepeatBuf, (TM / 2) * 8 * 4);
		pipe.InitBuffer(aIndexBuf, (TM / 2) * 4);
		LocalTensor<half> ah = zBuf.Get<half>();
		LocalTensor<int32_t> ai = uBuf.Get<int32_t>();
		LocalTensor<int32_t> ag = aGatherBuf.Get<int32_t>(), ar = aRepeatBuf.Get<int32_t>();
		LocalTensor<int32_t> index = aIndexBuf.Get<int32_t>();
		CreateVecIndex(index, static_cast<int32_t>(0), TM / 2);
		PipeBarrier<PIPE_V>();
		Muls(index, index, static_cast<int32_t>(128), TM / 2);
		PipeBarrier<PIPE_V>();
		LocalTensor<half> bh = bHalfBuf.Get<half>();
		LocalTensor<int32_t> bi = bIntBuf.Get<int32_t>(), tail = tailBuf.Get<int32_t>();
		LocalTensor<float> z = zBuf.Get<float>(), u = uBuf.Get<float>();
		const int64_t coreTileBegin = totalCTiles * coreIdx / coreNum;
		const int64_t coreTileEnd = totalCTiles * (coreIdx + 1) / coreNum;
		int64_t bundleTileBase = 0;
		for (int activeIndex = 0; activeIndex < activeCount; ++activeIndex) {
			const int ei = active[activeIndex];
			const int64_t start = ei ? gl[ei - 1] : 0, me = gl[ei] - start;
			const int64_t groupTiles = CeilDiv(me, TM);
			for (int64_t ni = 0; ni < NT; ++ni) {
				const int64_t miBegin = coreTileBegin > bundleTileBase ? coreTileBegin - bundleTileBase : 0;
				const int64_t endLimit = coreTileEnd - bundleTileBase;
				const int64_t miEnd = endLimit < groupTiles ? endLimit : groupTiles;
				bundleTileBase += groupTiles;
				if (miEnd <= 0 || miBegin >= miEnd)
					continue;
				for (int64_t mi = miBegin; mi < miEnd; ++mi) {
					const int64_t rowBase = start + mi * TM, curM = me - mi * TM < TM ? me - mi * TM : TM;
					const bool useTail = true;
					const int64_t rowsPerSub = (curM + 1) / 2, subRowBegin = subIdx * rowsPerSub;
					const int64_t subRowEnd = subRowBegin < curM
																				? (subRowBegin + rowsPerSub < curM ? subRowBegin + rowsPerSub : curM)
																				: subRowBegin;
					const int64_t colBase = ni * TN, curN = n - colBase < TN ? n - colBase : TN;
					const bool seqC = false;
					LocalTensor<float> s = sQue.AllocTensor<float>();
					DataCopyExtParams sp{1, static_cast<uint32_t>(curN * 4), 0, 0, 0};
					DataCopyPadExtParams<float> spad{true, 0, 0, 0};
					DataCopyPad(s, scaleGm[ei * n + colBase], sp, spad);
					sQue.EnQue(s);
					const int64_t azTail = ((curN + 15) / 16) * 16;
					const int64_t nrows = subRowEnd - subRowBegin;
					if (nrows > 0 && useTail) {
						LocalTensor<int8_t> bt = bQue.AllocTensor<int8_t>();
						DataCopyExtParams bp{static_cast<uint16_t>(KT), static_cast<uint32_t>(curN),
																 static_cast<uint32_t>(n - curN),
																 static_cast<uint32_t>((TN - ((curN + 31) / 32) * 32) / 32), 0};
						DataCopyPadExtParams<int8_t> pad{true, 0, 0, 0};
						DataCopyPad(bt, wGm[ei * k * n + mainK * n + colBase], bp, pad);
						bQue.EnQue(bt);
						bt = bQue.DeQue<int8_t>();
						Cast(bh, bt, RoundMode::CAST_NONE, KT * TN);
						PipeBarrier<PIPE_V>();
						Cast(bi, bh, RoundMode::CAST_RINT, KT * TN);
						bQue.FreeTensor(bt);
						LocalTensor<int8_t> at = aQue.AllocTensor<int8_t>();
						DataCopyExtParams ap{static_cast<uint16_t>(nrows), static_cast<uint32_t>(KT),
																 static_cast<uint32_t>(k - KT), 0, 0};
						DataCopyPad(at, xGm[(rowBase + subRowBegin) * k + mainK], ap, pad);
						aQue.EnQue(at);
						at = aQue.DeQue<int8_t>();
						Cast(ah, at, RoundMode::CAST_NONE, nrows * 32);
						PipeBarrier<PIPE_V>();
						Cast(ai, ah, RoundMode::CAST_RINT, nrows * 32);
						PipeBarrier<PIPE_V>();
						LocalTensor<int32_t> tmp = zBuf.Get<int32_t>();
						const int64_t roundedRows = ((nrows + 7) / 8) * 8;
						BinaryRepeatParams outer{1, 0, 1, static_cast<uint8_t>(azTail / 8), 1, 0};
						for (int64_t kk = 0; kk < KT; ++kk) {
							Gather(ag, ai, index.ReinterpretCast<uint32_t>(), kk * 4, roundedRows);
							PipeBarrier<PIPE_V>();
							Brcb(ar, ag, static_cast<uint8_t>(roundedRows / 8), BrcbRepeatParams{1, 8});
							PipeBarrier<PIPE_V>();
							for (int64_t rr = 0; rr < nrows; rr += VC) {
								const int64_t rc = nrows - rr < VC ? nrows - rr : VC;
								LocalTensor<int32_t> dest = kk == 0 ? tail[rr * azTail] : tmp;
								for (int64_t col = 0; col < azTail; col += 64) {
									const uint64_t mask = azTail - col < 64 ? azTail - col : 64;
									Mul(dest[col], ar[rr * 8], bi[kk * TN + col], mask, static_cast<uint8_t>(rc), outer);
								}
								if (kk > 0) {
									PipeBarrier<PIPE_V>();
									Add(tail[rr * azTail], tail[rr * azTail], tmp, rc * azTail);
									PipeBarrier<PIPE_V>();
								}
							}
							PipeBarrier<PIPE_V>();
						}
						aQue.FreeTensor(at);
					}
					CrossCoreWaitFlag(GMM_SYNC_AIC_AIV);
					s = sQue.DeQue<float>();
					if (subRowBegin < subRowEnd) {
						const int64_t azN = ((curN + 15) / 16) * 16, alignedN = ((curN + 7) / 8) * 8;
						const int64_t smRows = subRowEnd - subRowBegin < VC ? subRowEnd - subRowBegin : VC;
						for (int64_t row = subRowBegin; row < subRowEnd; row += VC) {
							const int64_t rc = subRowEnd - row < VC ? subRowEnd - row : VC;
							LocalTensor<int32_t> c = cQue.AllocTensor<int32_t>();
							DataCopyExtParams cp{static_cast<uint16_t>(rc), static_cast<uint32_t>(curN * 4),
																	 static_cast<uint32_t>((TN - curN) * 4),
																	 static_cast<uint32_t>((azN - alignedN) / 8), 0};
							DataCopyPadExtParams<int32_t> cpad{true, 0, 0, 0};
							const int64_t cb = (coreIdx * 2 + slot) * TM * TN + row * TN;
							DataCopyPad(c, cGm[cb], cp, cpad);
							cQue.EnQue(c);
							c = cQue.DeQue<int32_t>();
							if (useTail) {
								Add(c, c, tail[(row - subRowBegin) * azN], rc * azN);
								PipeBarrier<PIPE_V>();
							}
							Cast(z, c, RoundMode::CAST_NONE, rc * azN);
							cQue.FreeTensor(c);
							PipeBarrier<PIPE_V>();
							BinaryRepeatParams bp{1, 1, 1, static_cast<uint8_t>(azN / 8), static_cast<uint8_t>(azN / 8), 0};
							for (int64_t col = 0; col < azN; col += 64) {
								uint64_t mask = azN - col < 64 ? azN - col : 64;
								Mul(z[col], z[col], s[col], mask, static_cast<uint8_t>(rc), bp);
							}
							PipeBarrier<PIPE_V>();
							GeluComputeSigmoid(z, u, rc * azN);
							PipeBarrier<PIPE_V>();
							LocalTensor<half> o = oQue.AllocTensor<half>();
							Cast(o, u, RoundMode::CAST_NONE, rc * azN);
							oQue.EnQue(o);
							o = oQue.DeQue<half>();
							DataCopyExtParams op{static_cast<uint16_t>(rc), static_cast<uint32_t>(curN * 2), 0,
																	 static_cast<uint32_t>((n - curN) * 2), 0};
							DataCopyPad(yGm[(rowBase + row) * n + colBase], o, op);
							oQue.FreeTensor(o);
						}
					}
					sQue.FreeTensor(s);
					CrossCoreSetFlag<SYNC_MODE2, PIPE_MTE2>(GMM_SYNC_AIV_AIC);
					slot ^= 1;
					++iter;
				}
			}
		}
	}
}

}

namespace helpers {
using namespace os_runtime;

template <int TM, bool M_MAJOR, bool ONE_INIT>
__aicore__ inline void ClearATail(const LocalTensor<int8_t> &a, int64_t mainK) {
	const int64_t pitch = mainK + 32;
	if constexpr (M_MAJOR) {
		if constexpr (ONE_INIT) {
			LocalTensor<int8_t> tail = a[mainK * 16];
			InitConstValue(tail.ReinterpretCast<uint16_t>(),
										 InitConstValueParams<uint16_t>{static_cast<uint16_t>(TM / 16), 16,
																										static_cast<uint16_t>((16 * pitch - 512) / 32), 0});
		} else {
			for (int mi16 = 0; mi16 < TM / 16; ++mi16) {
				LocalTensor<int8_t> tail = a[mi16 * 16 * pitch + mainK * 16];
				InitConstValue(tail.ReinterpretCast<uint16_t>(), InitConstValueParams<uint16_t>{1, 16, 0, 0});
			}
		}
	} else {
		LocalTensor<int8_t> tail = a[TM * mainK];
		InitConstValue(tail.ReinterpretCast<uint16_t>(), InitConstValueParams<uint16_t>{1, TM, 0, 0});
	}
}

template <int TM, bool M_MAJOR>
__aicore__ inline void CopyAData(const GlobalTensor<int8_t> &x, const LocalTensor<int8_t> &a, int64_t rowBase,
																 int64_t rows, int64_t k, int64_t mainK) {
	if constexpr (M_MAJOR) {
		const int64_t pitch = mainK + 32;
		Nd2NzParams ap;
		ap.ndNum = rows / 16;
		ap.nValue = 16;
		ap.dValue = k;
		ap.srcNdMatrixStride = 16 * k;
		ap.srcDValue = k;
		ap.dstNzC0Stride = 16;
		ap.dstNzNStride = 1;
		ap.dstNzMatrixStride = 16 * pitch;
		if (rows >= 16)
			DataCopy(a, x[rowBase * k], ap);
		if (rows % 16) {
			ap.ndNum = 1;
			ap.nValue = rows % 16;
			ap.srcNdMatrixStride = 0;
			ap.dstNzMatrixStride = 0;
			DataCopy(a[(rows / 16) * 16 * pitch], x[(rowBase + (rows / 16) * 16) * k], ap);
		}
	} else {
		Nd2NzParams ap;
		ap.ndNum = 1;
		ap.nValue = rows;
		ap.dValue = k;
		ap.srcNdMatrixStride = 0;
		ap.srcDValue = k;
		ap.dstNzC0Stride = TM;
		ap.dstNzNStride = 1;
		ap.dstNzMatrixStride = 0;
		DataCopy(a, x[rowBase * k], ap);
	}
}

template <int TM, bool M_MAJOR, bool ONE_INIT>
__aicore__ inline void CopyA(const GlobalTensor<int8_t> &x, const LocalTensor<int8_t> &a, int64_t rowBase,
														 int64_t rows, int64_t k, int64_t mainK) {
	ClearATail<TM, M_MAJOR, ONE_INIT>(a, mainK);
	PipeBarrier<PIPE_MTE2>();
	CopyAData<TM, M_MAJOR>(x, a, rowBase, rows, k, mainK);
}

__aicore__ inline void GeluHorner(const LocalTensor<float> &z, const LocalTensor<float> &u, int32_t count) {
	Mul(u, z, z, count);
	Muls(u, u, -0.071354816f, count);
	Adds(u, u, -1.5957691216057308f, count);
	Mul(u, u, z, count);
	Exp(u, u, count);
	Adds(u, u, 1.0f, count);
	Div(u, z, u, count);
}

}

using namespace os_runtime;

using helpers::ClearATail;

using helpers::CopyAData;

using helpers::CopyA;

using helpers::GeluHorner;

template <int MM, int TN>
__aicore__ inline void StageCChunk(GlobalTensor<int32_t> &gm, TQue<TPosition::VECIN, 2> &queue, int64_t core,
																	 int64_t slot, int64_t row, int64_t rows, int64_t validN, bool last) {
	const int64_t azN = (validN + 15) / 16 * 16, alignedN = (validN + 7) / 8 * 8;
	auto c = queue.AllocTensor<int32_t>();
	DataCopyExtParams cp{static_cast<uint16_t>(rows), static_cast<uint32_t>(validN * 4),
											 static_cast<uint32_t>((TN - validN) * 4), static_cast<uint32_t>((azN - alignedN) / 8),
											 0};
	DataCopyPadExtParams<int32_t> pad{true, 0, 0, 0};
	DataCopyPad(c, gm[(core * 2 + slot) * MM * TN + row * TN], cp, pad);
	queue.EnQue(c);
	if (last)
		CrossCoreSetFlag<2, PIPE_MTE2>(3);
}

template <bool CACHE_B, int MM = 128, int TN = 256, int VC = 32, int CM = 64, bool HALF_C = false,
					bool WHOLE_M_OWNER = true, bool COST_OWNER = true, int ZERO_MODE = 2, bool SPLIT_B = true>
__aicore__ inline void Run(GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR group_list, GM_ADDR y,
													 GM_ADDR workspace, int64_t m, int64_t k, int64_t n, int64_t e,
													 int64_t rangeScheduleMode) {
	static_assert(!HALF_C, "GELU input must remain FP32; C must remain INT32");
	constexpr int KK = 128;
	constexpr int B_MODE = 4;
	using CType = typename std::conditional<HALF_C, half, int32_t>::type;
	static_assert(MM % CM == 0 && TN % 32 == 0, "Fractal macro geometry");
	static_assert(2 * KK * TN <= 64 * 1024, "Two L0B banks fit physical L0B");
	static_assert((MM / CM) * CM * TN * 4 <= 128 * 1024, "Two independent L0C planes");
	static_assert(MM <= 2 * CM, "INT32 main partials must all fit L0C");
	static_assert(MM * TN <= 2 * 128 * 256, "Original full-carrier workspace capacity");
	constexpr uint16_t GMM_SYNC_AIV_AIC = 3, GMM_SYNC_AIC_AIV = 5;
	constexpr uint64_t SYNC_MODE2 = 2;
	const int64_t mainK = (k / 128) * 128, KT = k - mainK, bKPitch = ((k + 31) / 32) * 32;
	const int64_t paddedN = ((n + 31) / 32) * 32;
	const uint32_t coreNum = GetBlockNum(), coreIdx = CoreGroupIndex(), subIdx = SubCoreIndex();
	if (mainK < 512 || mainK >= 1024 || KT != 1 || KK * TN > 64 * 1024 ||
			(MM + paddedN) * bKPitch > 512 * 1024) {
		registered_fp32::Run<CACHE_B, 128, 256, 32>(x, weight, scale, group_list, y, workspace, m, k, n, e,
																								rangeScheduleMode);
		return;
	}
	GlobalTensor<int8_t> xGm, wGm;
	GlobalTensor<float> scaleGm;
	GlobalTensor<int64_t> glGm;
	GlobalTensor<CType> cGm;
	GlobalTensor<half> yGm;
	xGm.SetGlobalBuffer((__gm__ int8_t *)x, m * k);
	wGm.SetGlobalBuffer((__gm__ int8_t *)weight, e * k * n);
	scaleGm.SetGlobalBuffer((__gm__ float *)scale, e * n);
	glGm.SetGlobalBuffer((__gm__ int64_t *)group_list, e);
	cGm.SetGlobalBuffer((__gm__ CType *)workspace, coreNum * 2 * MM * TN);
	yGm.SetGlobalBuffer((__gm__ half *)y, m * n);
	int32_t gl[128], active[128];
	int64_t activeCount = 0, prev = 0, totalMTiles = 0, oldMTiles = 0, oldMin = 1LL << 60, oldMax = 0;
	for (int ei = 0; ei < e; ++ei) {
		const int64_t end = glGm.GetValue(ei), rows = end - prev, oldTiles = CeilDiv(rows, 64);
		gl[ei] = end;
		prev = end;
		if (oldTiles > 0) {
			active[activeCount++] = ei;
			if (oldTiles < oldMin)
				oldMin = oldTiles;
		}
		if (oldTiles > oldMax)
			oldMax = oldTiles;
		oldMTiles += oldTiles;
		totalMTiles += CeilDiv(rows, MM);
	}
	const bool oldEligible = oldMTiles >= 3 * activeCount && oldMTiles * CeilDiv(n, 256) >= 2 * coreNum &&
													 (rangeScheduleMode != 2 || oldMax - oldMin <= 1);
	if (!oldEligible) {
		registered_fp32::Run<CACHE_B, 128, 256, 32>(x, weight, scale, group_list, y, workspace, m, k, n, e,
																								rangeScheduleMode);
		return;
	}
	const int64_t NT = CeilDiv(n, TN), totalCTiles = totalMTiles * NT;
	int64_t iter = 0, slot = 0;
	if ASCEND_IS_AIC {
		const bool useWholeM =
				WHOLE_M_OWNER && (COST_OWNER ? CeilDiv(totalMTiles, coreNum) * MM * paddedN * bKPitch <=
																					 CeilDiv(totalCTiles, coreNum) * MM * TN * mainK
																		 : CeilDiv(totalMTiles, coreNum) * NT <= CeilDiv(totalCTiles, coreNum));
		const int64_t coreTileBegin =
				useWholeM ? (totalMTiles * coreIdx / coreNum) * NT : totalCTiles * coreIdx / coreNum;
		const int64_t coreTileEnd =
				useWholeM ? (totalMTiles * (coreIdx + 1) / coreNum) * NT : totalCTiles * (coreIdx + 1) / coreNum;
		const bool segmented = SPLIT_B && (2 * MM * bKPitch + paddedN * (bKPitch + 256) <= 512 * 1024);
		const int64_t prefixRows = segmented ? 256 : k, prefixPitch = segmented ? 256 : bKPitch;
		const int64_t suffixPitch = segmented ? bKPitch - 256 : 0;
		bool doubleB = B_MODE != 0 && (segmented || (MM + 2 * paddedN) * bKPitch <= 512 * 1024);
		{
			if (doubleB) {
				doubleB = false;
				if (coreTileBegin < coreTileEnd) {
					int64_t firstSpanEnd = 0;
					for (int ai = 0; ai < activeCount; ++ai) {
						const int ei = active[ai];
						const int64_t start = ei ? gl[ei - 1] : 0;
						firstSpanEnd += CeilDiv(gl[ei] - start, MM) * NT;
						if (firstSpanEnd > coreTileBegin) {
							doubleB = coreTileEnd > firstSpanEnd;
							break;
						}
					}
				}
			}
		}
		const int64_t aBanks =
				segmented ? 2 : (doubleB ? 1 : ((2 * MM + paddedN) * bKPitch <= 512 * 1024 ? 2 : 1));
		const int64_t aBankElems = MM * bKPitch;
		LocalTensor<int8_t> aAll(TPosition::A1, 0, aBanks * aBankElems);
		const int64_t prefixBankElems = paddedN * prefixPitch;
		const int64_t suffixOffset = (doubleB ? 2 : 1) * prefixBankElems;
		LocalTensor<int8_t> bAll(TPosition::B1, aBanks * aBankElems,
														 suffixOffset + (segmented ? paddedN * suffixPitch : 0));
		int suffixOwner = -1;
		LocalTensor<int8_t> a2(TPosition::A2, 0, 2 * CM * KK);
		LocalTensor<int8_t> b2(TPosition::B2, 0, 64 * 1024);
		LocalTensor<int32_t> cAll(TPosition::CO1, 0, (MM / CM) * CM * TN);
		bool aReadersPending[2] = {false, false}, bReaderPending[2] = {false, false};
		bool b2ReadersPending[2] = {false, false};
		int64_t b2Ordinal = 0;
		bool bPrefetched[2] = {false, false};
		int64_t ownedBundle = 0;
		bool cReadersPending[2] = {false, false};
		int64_t mmaIndex = 0, aIter = 0;
		uint32_t initializedATails = 0;
		if constexpr (ZERO_MODE == 3) {
			for (int bank = 0; bank < aBanks; ++bank) {
				ClearATail<MM, true, true>(aAll[bank * aBankElems], mainK);
				initializedATails |= 1U << bank;
			}
			PipeBarrier<PIPE_MTE2>();
		}
		int64_t expertTileBase = 0;
		for (int ai = 0; ai < activeCount; ++ai) {
			const int ei = active[ai];
			const int64_t start = ei ? gl[ei - 1] : 0, me = gl[ei] - start;
			const int64_t groupTiles = CeilDiv(me, MM), expertSpan = groupTiles * NT;
			const int64_t localBegin = coreTileBegin > expertTileBase ? coreTileBegin - expertTileBase : 0;
			const int64_t endLimit = coreTileEnd - expertTileBase;
			const int64_t localEnd = endLimit < expertSpan ? endLimit : expertSpan;
			expertTileBase += expertSpan;
			if (localEnd <= 0 || localBegin >= localEnd)
				continue;
			const int bBank = doubleB ? (ownedBundle & 1) : 0;
			++ownedBundle;
			LocalTensor<int8_t> b1 = bAll[bBank * prefixBankElems];
			const int nextExpert = (ai + 1 < activeCount && coreTileEnd > expertTileBase) ? active[ai + 1] : -1;
			const int64_t miBegin = localBegin / NT, miEnd = (localEnd + NT - 1) / NT;
			int64_t nextBOffset = 0, nextBScore = miEnd - miBegin - 1;
			for (int64_t mi = miBegin; mi < miEnd; ++mi) {
				const int64_t rowBase = start + mi * MM, curM = me - mi * MM < MM ? me - mi * MM : MM;
				const int64_t niBegin = localBegin > mi * NT ? localBegin - mi * NT : 0;
				const int64_t niEnd = localEnd - mi * NT < NT ? localEnd - mi * NT : NT;
				const int aBank = aIter % aBanks;
				LocalTensor<int8_t> a1 = aAll[aBank * aBankElems];
				if (mi == miBegin || aBanks == 1) {
					if (aReadersPending[aBank]) {
						WaitFlag<HardEvent::MTE1_MTE2>(static_cast<event_t>(aBank));
						aReadersPending[aBank] = false;
					}
					if (mi == miBegin && !bPrefetched[bBank] && bReaderPending[bBank]) {
						WaitFlag<HardEvent::MTE1_MTE2>(static_cast<event_t>(2 + bBank));
						bReaderPending[bBank] = false;
					}
					if constexpr (ZERO_MODE == 0) {
						ClearATail<MM, true, true>(a1, mainK);
						PipeBarrier<PIPE_MTE2>();
					} else if constexpr (ZERO_MODE == 1 || ZERO_MODE == 2) {
						const bool firstTail = (initializedATails & (1U << aBank)) == 0;
						if (firstTail) {
							ClearATail<MM, true, true>(a1, mainK);
							initializedATails |= 1U << aBank;
						}
						if constexpr (ZERO_MODE == 1)
							PipeBarrier<PIPE_MTE2>();
						else if (firstTail)
							PipeBarrier<PIPE_MTE2>();
					}
					if (segmented && mi == miBegin && suffixOwner >= 0 && bReaderPending[suffixOwner]) {
						WaitFlag<HardEvent::MTE1_MTE2>(static_cast<event_t>(2 + suffixOwner));
						bReaderPending[suffixOwner] = false;
					}
					if (mi == miBegin && !bPrefetched[bBank]) {
						Nd2NzParams bp;
						bp.ndNum = 1;
						bp.nValue = prefixRows;
						bp.dValue = n;
						bp.srcNdMatrixStride = 0;
						bp.srcDValue = n;
						bp.dstNzC0Stride = prefixPitch;
						bp.dstNzNStride = 1;
						bp.dstNzMatrixStride = 0;
						DataCopy(b1, wGm[ei * k * n], bp);
						if (doubleB)
							SetFlag<HardEvent::MTE2_MTE1>(static_cast<event_t>(2 + bBank));
					}
					CopyAData<MM, true>(xGm, a1, rowBase, curM, k, mainK);
					SetFlag<HardEvent::MTE2_MTE1>(static_cast<event_t>(aBank));
					if (segmented && mi == miBegin) {
						Nd2NzParams suffix;
						suffix.ndNum = 1;
						suffix.nValue = k - 256;
						suffix.dValue = n;
						suffix.srcNdMatrixStride = 0;
						suffix.srcDValue = n;
						suffix.dstNzC0Stride = suffixPitch;
						suffix.dstNzNStride = 1;
						suffix.dstNzMatrixStride = 0;
						DataCopy(bAll[suffixOffset], wGm[ei * k * n + 256 * n], suffix);
						suffixOwner = bBank;
						SetFlag<HardEvent::MTE2_MTE1>(4);
					}
					if (!segmented) {
						{
							if (doubleB && nextExpert >= 0) {
								const int nextBank = bBank ^ 1;
								if (!bPrefetched[nextBank]) {
									if (nextBOffset == 0 && bReaderPending[nextBank]) {
										WaitFlag<HardEvent::MTE1_MTE2>(static_cast<event_t>(2 + nextBank));
										bReaderPending[nextBank] = false;
									}
									constexpr int PREFETCH_K = B_MODE == 4 ? 128 : 256;
									const int64_t parts = (prefixRows + PREFETCH_K - 1) / PREFETCH_K;
									const int64_t steps = miEnd - miBegin;
									nextBScore += parts;
									while (nextBScore >= steps && nextBOffset < prefixRows) {
										nextBScore -= steps;
										const int64_t curPrefetchK =
												prefixRows - nextBOffset < PREFETCH_K ? prefixRows - nextBOffset : PREFETCH_K;
										Nd2NzParams piece;
										piece.ndNum = 1;
										piece.nValue = curPrefetchK;
										piece.dValue = n;
										piece.srcNdMatrixStride = 0;
										piece.srcDValue = n;
										piece.dstNzC0Stride = prefixPitch;
										piece.dstNzNStride = 1;
										piece.dstNzMatrixStride = 0;
										DataCopy(bAll[nextBank * prefixBankElems + nextBOffset * 32],
														 wGm[static_cast<int64_t>(nextExpert) * k * n + nextBOffset * n], piece);
										nextBOffset += curPrefetchK;
									}
									if (nextBOffset == prefixRows) {
										SetFlag<HardEvent::MTE2_MTE1>(static_cast<event_t>(2 + nextBank));
										bPrefetched[nextBank] = true;
									}
								}
							}
						}
					}
				}
				if (segmented) {
					{
						if (doubleB && nextExpert >= 0) {
							const int nextBank = bBank ^ 1;
							if (!bPrefetched[nextBank]) {
								if (nextBOffset == 0 && bReaderPending[nextBank]) {
									WaitFlag<HardEvent::MTE1_MTE2>(static_cast<event_t>(2 + nextBank));
									bReaderPending[nextBank] = false;
								}
								constexpr int PREFETCH_K = B_MODE == 4 ? 128 : 256;
								const int64_t parts = (prefixRows + PREFETCH_K - 1) / PREFETCH_K;
								const int64_t steps = miEnd - miBegin;
								nextBScore += parts;
								while (nextBScore >= steps && nextBOffset < prefixRows) {
									nextBScore -= steps;
									const int64_t curPrefetchK =
											prefixRows - nextBOffset < PREFETCH_K ? prefixRows - nextBOffset : PREFETCH_K;
									Nd2NzParams piece;
									piece.ndNum = 1;
									piece.nValue = curPrefetchK;
									piece.dValue = n;
									piece.srcNdMatrixStride = 0;
									piece.srcDValue = n;
									piece.dstNzC0Stride = prefixPitch;
									piece.dstNzNStride = 1;
									piece.dstNzMatrixStride = 0;
									DataCopy(bAll[nextBank * prefixBankElems + nextBOffset * 32],
													 wGm[static_cast<int64_t>(nextExpert) * k * n + nextBOffset * n], piece);
									nextBOffset += curPrefetchK;
								}
								if (nextBOffset == prefixRows) {
									SetFlag<HardEvent::MTE2_MTE1>(static_cast<event_t>(2 + nextBank));
									bPrefetched[nextBank] = true;
								}
							}
						}
					}
				}
				WaitFlag<HardEvent::MTE2_MTE1>(static_cast<event_t>(aBank));
				if (doubleB && mi == miBegin) {
					WaitFlag<HardEvent::MTE2_MTE1>(static_cast<event_t>(2 + bBank));
					bPrefetched[bBank] = false;
				}
				if (aBanks == 2 && mi + 1 < miEnd) {
					const int nextBank = aBank ^ 1;
					if (aReadersPending[nextBank]) {
						WaitFlag<HardEvent::MTE1_MTE2>(static_cast<event_t>(nextBank));
						aReadersPending[nextBank] = false;
					}
					const int64_t nextRow = start + (mi + 1) * MM;
					const int64_t nextM = me - (mi + 1) * MM < MM ? me - (mi + 1) * MM : MM;
					if constexpr (ZERO_MODE == 0) {
						CopyA<MM, true, true>(xGm, aAll[nextBank * aBankElems], nextRow, nextM, k, mainK);
					} else {
						LocalTensor<int8_t> nextA = aAll[nextBank * aBankElems];
						if constexpr (ZERO_MODE == 1 || ZERO_MODE == 2) {
							const bool firstTail = (initializedATails & (1U << nextBank)) == 0;
							if (firstTail) {
								ClearATail<MM, true, true>(nextA, mainK);
								initializedATails |= 1U << nextBank;
							}
							if constexpr (ZERO_MODE == 1)
								PipeBarrier<PIPE_MTE2>();
							else if (firstTail)
								PipeBarrier<PIPE_MTE2>();
						}
						CopyAData<MM, true>(xGm, nextA, nextRow, nextM, k, mainK);
					}
					SetFlag<HardEvent::MTE2_MTE1>(static_cast<event_t>(nextBank));
				}
				for (int64_t ni = niBegin; ni < niEnd; ++ni) {
					const int64_t colBase = ni * TN, curN = n - colBase < TN ? n - colBase : TN;
					const int64_t tileN = ((curN + 31) / 32) * 32;
					const int64_t subTiles = CeilDiv(curM, CM);
					for (int64_t kb = 0; kb < mainK; kb += KK) {
						const int64_t curK = mainK - kb < KK ? mainK - kb : KK;
						if (segmented && mi == miBegin && ni == niBegin && kb == 256)
							WaitFlag<HardEvent::MTE2_MTE1>(4);
						const int b2Bank = b2Ordinal++ & 1;
						if (b2ReadersPending[b2Bank]) {
							WaitFlag<HardEvent::M_MTE1>(static_cast<event_t>(2 + b2Bank));
							b2ReadersPending[b2Bank] = false;
						}
						LocalTensor<int8_t> b2Now = b2[b2Bank * KK * TN];
						LoadData2dTransposeParams resident;
						resident.startIndex = 0;
						resident.repeatTimes = curK / 32;
						resident.srcStride = 1;
						resident.dstGap = tileN / 16 - 1;
						resident.dstFracGap = 0;
						resident.addrMode = 0;
						for (int64_t nb = 0; nb < tileN / 32; ++nb)
							LoadDataWithTranspose(
									b2Now[nb * 1024],
									bAll[(segmented && kb >= 256 ? suffixOffset : bBank * prefixBankElems) +
											 (colBase + nb * 32) * (segmented && kb >= 256 ? suffixPitch : prefixPitch) +
											 (segmented && kb >= 256 ? kb - 256 : kb) * 32],
									resident);
						for (int64_t sm = 0; sm < subTiles; ++sm) {
							const int plane = sm & 1;
							LocalTensor<int8_t> aSub = a1[sm * CM * bKPitch];
							LocalTensor<int32_t> c1 = cAll[plane * CM * TN];
							const int bank = mmaIndex & 1;
							const event_t freeEvent = static_cast<event_t>(bank);
							if (mmaIndex >= 2)
								WaitFlag<HardEvent::M_MTE1>(freeEvent);
							LocalTensor<int8_t> aa2 = a2[bank * CM * KK];
							LoadData2DParams lda;
							lda.startIndex = 0;
							lda.repeatTimes = CM / 16;
							lda.srcStride = bKPitch / 32;
							lda.dstGap = curK / 32 - 1;
							lda.ifTranspose = false;
							lda.addrMode = 0;
							for (int ki32 = 0; ki32 < curK / 32; ++ki32)
								LoadData(aa2[ki32 * 512], aSub[kb * 16 + ki32 * 512], lda);
							SetFlag<HardEvent::MTE1_M>(0);
							WaitFlag<HardEvent::MTE1_M>(0);
							if (kb == 0 && cReadersPending[plane]) {
								WaitFlag<HardEvent::FIX_M>(static_cast<event_t>(plane));
								cReadersPending[plane] = false;
							}
							MmadParams mm;
							mm.m = CM;
							mm.n = tileN;
							mm.k = curK;
							mm.cmatrixSource = false;
							mm.cmatrixInitVal = kb == 0;
							mm.unitFlag = 0;
							Mmad(c1, aa2, b2Now, mm);
							SetFlag<HardEvent::M_MTE1>(freeEvent);
							++mmaIndex;
						}
						SetFlag<HardEvent::M_MTE1>(static_cast<event_t>(2 + b2Bank));
						b2ReadersPending[b2Bank] = true;
					}
					const int tailB2Bank = b2Ordinal++ & 1;
					if (b2ReadersPending[tailB2Bank]) {
						WaitFlag<HardEvent::M_MTE1>(static_cast<event_t>(2 + tailB2Bank));
						b2ReadersPending[tailB2Bank] = false;
					}
					LocalTensor<int8_t> tailB2 = b2[tailB2Bank * KK * TN];
					LoadData2dTransposeParams tailB;
					tailB.startIndex = 0;
					tailB.repeatTimes = tileN / 32;
					tailB.srcStride = (segmented ? suffixPitch : bKPitch) / 32;
					tailB.dstGap = 1;
					tailB.dstFracGap = 0;
					tailB.addrMode = 0;
					LoadDataWithTranspose(
							tailB2,
							bAll[(segmented ? suffixOffset : bBank * prefixBankElems) +
									 colBase * (segmented ? suffixPitch : bKPitch) + (segmented ? mainK - 256 : mainK) * 32],
							tailB);
					if (mi + 1 == miEnd && ni + 1 == niEnd) {
						SetFlag<HardEvent::MTE1_MTE2>(static_cast<event_t>(2 + bBank));
						bReaderPending[bBank] = true;
					}
					for (int64_t sm = 0; sm < subTiles; ++sm) {
						const int plane = sm & 1;
						const int64_t curRows = curM - sm * CM < CM ? curM - sm * CM : CM;
						LocalTensor<int8_t> aSub = a1[sm * CM * bKPitch];
						LocalTensor<int32_t> c1 = cAll[plane * CM * TN];
						{
							const int bank = mmaIndex & 1;
							const event_t freeEvent = static_cast<event_t>(bank);
							if (mmaIndex >= 2)
								WaitFlag<HardEvent::M_MTE1>(freeEvent);
							LocalTensor<int8_t> aa2 = a2[bank * CM * KK], bb2 = tailB2;
							LoadData2DParams lda;
							lda.startIndex = 0;
							lda.repeatTimes = CM / 16;
							lda.srcStride = bKPitch / 32;
							lda.dstGap = 0;
							lda.ifTranspose = false;
							lda.addrMode = 0;
							LoadData(aa2, aSub[mainK * 16], lda);
							if (ni + 1 == niEnd && sm + 1 == subTiles) {
								SetFlag<HardEvent::MTE1_MTE2>(static_cast<event_t>(aBank));
								aReadersPending[aBank] = true;
							}
							SetFlag<HardEvent::MTE1_M>(0);
							WaitFlag<HardEvent::MTE1_M>(0);
							MmadParams mm;
							mm.m = CM;
							mm.n = tileN;
							mm.k = 32;
							mm.cmatrixSource = false;
							mm.cmatrixInitVal = false;
							mm.unitFlag = 0;
							Mmad(c1, aa2, bb2, mm);
							if (sm + 1 == subTiles) {
								SetFlag<HardEvent::M_MTE1>(static_cast<event_t>(2 + tailB2Bank));
								b2ReadersPending[tailB2Bank] = true;
							}
							SetFlag<HardEvent::M_MTE1>(freeEvent);
							++mmaIndex;
						}
						SetFlag<HardEvent::M_FIX>(0);
						WaitFlag<HardEvent::M_FIX>(0);
						if (sm == 0 && iter >= 2)
							CrossCoreWaitFlag(GMM_SYNC_AIV_AIC);
						FixpipeParamsV220 fp;
						fp.nSize = tileN;
						fp.mSize = curRows;
						fp.srcStride = CM;
						fp.dstStride = TN;
						fp.reluEn = false;
						fp.unitFlag = 0;
						if constexpr (HALF_C) {
							fp.quantPre = QuantMode_t::DEQF16;
							fp.deqScalar = 0x3B000000ULL;
						} else
							fp.quantPre = QuantMode_t::NoQuant;
						Fixpipe<CType, int32_t, CFG_ROW_MAJOR>(cGm[(coreIdx * 2 + slot) * MM * TN + sm * CM * TN], c1,
																									 fp);
						SetFlag<HardEvent::FIX_M>(static_cast<event_t>(plane));
						cReadersPending[plane] = true;
					}
					CrossCoreSetFlag<SYNC_MODE2, PIPE_FIX>(GMM_SYNC_AIC_AIV);
					slot ^= 1;
					++iter;
				}
				++aIter;
			}
		}
		if (mmaIndex > 0) {
			WaitFlag<HardEvent::M_MTE1>(0);
			if (mmaIndex > 1)
				WaitFlag<HardEvent::M_MTE1>(1);
		}
		for (int bank = 0; bank < 2; ++bank)
			if (b2ReadersPending[bank])
				WaitFlag<HardEvent::M_MTE1>(static_cast<event_t>(2 + bank));
		if (aReadersPending[0])
			WaitFlag<HardEvent::MTE1_MTE2>(0);
		if (aReadersPending[1])
			WaitFlag<HardEvent::MTE1_MTE2>(1);
		for (int bank = 0; bank < (doubleB ? 2 : 1); ++bank)
			if (bReaderPending[bank])
				WaitFlag<HardEvent::MTE1_MTE2>(static_cast<event_t>(2 + bank));
		if (cReadersPending[0])
			WaitFlag<HardEvent::FIX_M>(0);
		if (cReadersPending[1])
			WaitFlag<HardEvent::FIX_M>(1);
	} else {
		TPipe pipe;
		TQue<TPosition::VECIN, 2> cQue;
		TQue<TPosition::VECIN, 1> sQue;
		TQue<TPosition::VECOUT, 1> oQue;
		TBuf<TPosition::VECCALC> uBuf;
		constexpr uint32_t CHUNK_ELEMS = VC * TN;
		pipe.InitBuffer(cQue, 2, CHUNK_ELEMS * sizeof(CType));
		pipe.InitBuffer(sQue, 1, TN * 4);
		pipe.InitBuffer(oQue, 2, CHUNK_ELEMS * 2);
		pipe.InitBuffer(uBuf, CHUNK_ELEMS * 4);
		LocalTensor<float> u = uBuf.Get<float>();
		const bool useWholeM =
				WHOLE_M_OWNER && (COST_OWNER ? CeilDiv(totalMTiles, coreNum) * MM * paddedN * bKPitch <=
																					 CeilDiv(totalCTiles, coreNum) * MM * TN * mainK
																		 : CeilDiv(totalMTiles, coreNum) * NT <= CeilDiv(totalCTiles, coreNum));
		const int64_t coreTileBegin =
				useWholeM ? (totalMTiles * coreIdx / coreNum) * NT : totalCTiles * coreIdx / coreNum;
		const int64_t coreTileEnd =
				useWholeM ? (totalMTiles * (coreIdx + 1) / coreNum) * NT : totalCTiles * (coreIdx + 1) / coreNum;
		int64_t expertTileBase = 0;
		for (int ai = 0; ai < activeCount; ++ai) {
			const int ei = active[ai];
			const int64_t start = ei ? gl[ei - 1] : 0, me = gl[ei] - start;
			const int64_t groupTiles = CeilDiv(me, MM), expertSpan = groupTiles * NT;
			const int64_t localBegin = coreTileBegin > expertTileBase ? coreTileBegin - expertTileBase : 0;
			const int64_t endLimit = coreTileEnd - expertTileBase;
			const int64_t localEnd = endLimit < expertSpan ? endLimit : expertSpan;
			expertTileBase += expertSpan;
			if (localEnd <= 0 || localBegin >= localEnd)
				continue;
			const int64_t miBegin = localBegin / NT, miEnd = (localEnd + NT - 1) / NT;
			for (int64_t mi = miBegin; mi < miEnd; ++mi) {
				const int64_t rowBase = start + mi * MM, curM = me - mi * MM < MM ? me - mi * MM : MM;
				const int64_t niBegin = localBegin > mi * NT ? localBegin - mi * NT : 0;
				const int64_t niEnd = localEnd - mi * NT < NT ? localEnd - mi * NT : NT;
				for (int64_t ni = niBegin; ni < niEnd; ++ni) {
					const int64_t rowsPerSub = (curM + 1) / 2, subRowBegin = subIdx * rowsPerSub;
					const int64_t subRowEnd = subRowBegin < curM
																				? (subRowBegin + rowsPerSub < curM ? subRowBegin + rowsPerSub : curM)
																				: subRowBegin;
					const int64_t colBase = ni * TN, curN = n - colBase < TN ? n - colBase : TN;
					const bool seqC = false;
					LocalTensor<float> s = sQue.AllocTensor<float>();
					DataCopyExtParams sp{1, static_cast<uint32_t>(curN * 4), 0, 0, 0};
					DataCopyPadExtParams<float> spad{true, 0, 0, 0};
					DataCopyPad(s, scaleGm[ei * n + colBase], sp, spad);
					sQue.EnQue(s);
					const int64_t azTail = ((curN + 15) / 16) * 16;
					const int64_t nrows = subRowEnd - subRowBegin;
					CrossCoreWaitFlag(GMM_SYNC_AIC_AIV);
					s = sQue.DeQue<float>();
					if constexpr (HALF_C) {
						Muls(s, s, 512.0f, TN);
						PipeBarrier<PIPE_V>();
					}
					if (subRowBegin < subRowEnd) {
						const int64_t azN = ((curN + 15) / 16) * 16, alignedN = ((curN + 7) / 8) * 8;
						const int64_t smRows = subRowEnd - subRowBegin < VC ? subRowEnd - subRowBegin : VC;
						StageCChunk<MM, TN>(cGm, cQue, coreIdx, slot, subRowBegin, smRows, curN,
																subRowBegin + smRows == subRowEnd);
						for (int64_t row = subRowBegin; row < subRowEnd; row += VC) {
							const int64_t rc = subRowEnd - row < VC ? subRowEnd - row : VC;
							LocalTensor<CType> c = cQue.DeQue<CType>();
							LocalTensor<float> z = c.template ReinterpretCast<float>();
							if (row + VC < subRowEnd) {
								const int64_t nr = row + VC, nc = subRowEnd - nr < VC ? subRowEnd - nr : VC;
								StageCChunk<MM, TN>(cGm, cQue, coreIdx, slot, nr, nc, curN, nr + nc == subRowEnd);
							}
							Cast(z, c, RoundMode::CAST_NONE, rc * azN);
							PipeBarrier<PIPE_V>();
							BinaryRepeatParams bp{1, 1, 1, static_cast<uint8_t>(azN / 8), static_cast<uint8_t>(azN / 8), 0};
							for (int64_t col = 0; col < azN; col += 64) {
								uint64_t mask = azN - col < 64 ? azN - col : 64;
								Mul(z[col], z[col], s[col], mask, static_cast<uint8_t>(rc), bp);
							}
							PipeBarrier<PIPE_V>();
							if constexpr (HALF_C)
								GeluHorner(z, u, rc * azN);
							else
								GeluComputeSigmoid(z, u, rc * azN);
							PipeBarrier<PIPE_V>();
							LocalTensor<half> o = oQue.AllocTensor<half>();
							Cast(o, u, RoundMode::CAST_NONE, rc * azN);
							cQue.FreeTensor(c);
							oQue.EnQue(o);
							o = oQue.DeQue<half>();
							DataCopyExtParams op{static_cast<uint16_t>(rc), static_cast<uint32_t>(curN * 2), 0,
																	 static_cast<uint32_t>((n - curN) * 2), 0};
							DataCopyPad(yGm[(rowBase + row) * n + colBase], o, op);
							oQue.FreeTensor(o);
						}
					}
					sQue.FreeTensor(s);
					if (subRowBegin >= subRowEnd)
						CrossCoreSetFlag<SYNC_MODE2, PIPE_MTE2>(GMM_SYNC_AIV_AIC);
					slot ^= 1;
					++iter;
				}
			}
		}
	}
}

}
__global__ __mix__(1, 2)
		__attribute__((aligned(64))) void bk129(GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR g, GM_ADDR y, GM_ADDR ws,
																						int64_t m, int64_t k, int64_t n, int64_t e,
																						int64_t rangeScheduleMode) {
	main_rank1_range_b::Run<true, 128, 256, 32, 128, false, true, true, 2, true>(x, w, s, g, y, ws, m, k, n, e,
																																							 rangeScheduleMode);
}
#include "kernel_operator.h"

#include "adv_api/matmul/matmul.h"

namespace os_i2_wave_runtime {
using namespace AscendC;

__aicore__ inline uint32_t CoreGroupIndex() {
	if ASCEND_IS_AIC {
		return static_cast<uint32_t>(AscendC::GetBlockIdx());
	}
	return static_cast<uint32_t>(AscendC::GetBlockIdx() / AscendC::GetTaskRation());
}

__aicore__ inline uint32_t SubCoreIndex() {
	if ASCEND_IS_AIV {
		return static_cast<uint32_t>(AscendC::GetSubBlockIdx());
	}
	return 0;
}

__aicore__ inline int64_t CeilDiv(int64_t a, int64_t b) {
	return (a + b - 1) / b;
}

__aicore__ inline void GeluComputeSigmoid(const AscendC::LocalTensor<float> &z,
																					const AscendC::LocalTensor<float> &u, int32_t cnt) {
	using namespace AscendC;
	Mul(u, z, z, cnt);
	Mul(u, u, z, cnt);
	Muls(u, u, 0.044715f, cnt);
	Add(u, u, z, cnt);
	Muls(u, u, -1.5957691216057308f, cnt);
	Exp(u, u, cnt);
	Adds(u, u, 1.0f, cnt);
	Div(u, z, u, cnt);
}

__aicore__ inline void CollectGroups(GM_ADDR groups, int64_t e, int32_t *ends, int32_t &active,
																		 int32_t &maxRows) {
	GlobalTensor<int64_t> g;
	g.SetGlobalBuffer((__gm__ int64_t *)groups, e);
	int32_t prev = 0;
	active = 0;
	maxRows = 0;
	for (int64_t ei = 0; ei < e; ++ei) {
		const int32_t end = static_cast<int32_t>(g.GetValue(ei)), rows = end - prev;
		ends[ei] = end;
		prev = end;
		if (rows > 0)
			++active;
		if (rows > maxRows)
			maxRows = rows;
	}
}

template <int TM, int TN> struct Config {
	static_assert(TM % 16 == 0 && TN % 32 == 0, "Cube tile alignment");
	static_assert(TM * TN * 4 <= 128 * 1024, "L0C budget");
	using AType = AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, int8_t, false>;
	using BType = AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, int8_t, false>;
	using CType = AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, int32_t>;
	using BiasType = AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, int32_t>;
	static constexpr int32_t TILE_M = TM;
	static constexpr int32_t TILE_N = TN;
	static constexpr int32_t VEC_CHUNK_M = 16;
	static constexpr uint16_t GMM_SYNC_AIV_AIC = 3;
	static constexpr uint16_t GMM_SYNC_AIC_AIV = 5;
	static constexpr uint64_t SYNC_MODE2 = 2;
	static __aicore__ constexpr MatmulConfig MakeMatmulConfig() {
		MatmulConfig cfg{};
		cfg.doNorm = false;
		cfg.doBasicBlock = false;
		cfg.doMultiDataLoad = true;
		cfg.basicM = TILE_M;
		cfg.basicN = TILE_N;
		cfg.basicK = TN > 256 ? 64 : 128;
		cfg.intrinsicsCheck = false;
		cfg.isNBatch = false;
		cfg.enVecND2NZ = false;
		cfg.doSpecialBasicBlock = false;
		cfg.doMTE2Preload = 0;
		cfg.singleCoreM = TILE_M;
		cfg.singleCoreN = 1024;
		cfg.singleCoreK = 8192;
		cfg.stepM = 0;
		cfg.stepN = 0;
		cfg.baseMN = 0;
		cfg.singleCoreMN = 0;
		cfg.enUnitFlag = true;
		cfg.isPerTensor = false;
		cfg.hasAntiQuantOffset = false;
		cfg.doIBShareNorm = false;
		cfg.doSpecialMDL = false;
		cfg.enableInit = false;
		cfg.batchMode = BatchMode::NONE;
		cfg.enableEnd = true;
		cfg.enableGetTensorC = true;
		cfg.enableSetOrgShape = true;
		cfg.enableSetBias = false;
		cfg.enableSetTail = true;
		cfg.enableQuantVector = false;
		cfg.enableSetDefineData = false;
		cfg.iterateMode = IterateMode::ITERATE_MODE_DEFAULT;
		cfg.enableReuse = true;
		cfg.enableUBReuse = true;
		cfg.enableL1CacheUB = false;
		cfg.intraBlockPartSum = false;
		cfg.iterateOrder = IterateOrder::UNDEF;
		cfg.scheduleType = ScheduleType::INNER_PRODUCT;
		cfg.enableDoubleCache = false;
		cfg.isBiasBatch = true;
		cfg.enableStaticPadZeros = false;
		cfg.isA2B2Shared = false;
		cfg.enableKdimReorderLoad = false;
		cfg.isCO1Shared = false;
		return cfg;
	}
	static __aicore__ constexpr MatmulApiStaticTiling MakeStaticTiling() {
		MatmulApiStaticTiling tiling =
				AscendC::GetMatmulApiTiling<AType, BType, CType, BiasType>(MakeMatmulConfig());
		tiling.depthA1 = 8;
		tiling.depthB1 = 8;
		tiling.stepM = 1;
		tiling.stepN = 1;
		tiling.stepKa = 4;
		tiling.stepKb = 4;
		tiling.dbL0A = 2;
		tiling.dbL0B = 2;
		tiling.dbL0C = 1;
		return tiling;
	}
	constexpr static MatmulApiStaticTiling STATIC_TILING = MakeStaticTiling();
	using MM = AscendC::MatmulImpl<AType, BType, CType, BiasType, STATIC_TILING>;
};

template <int TM, int TN, int VC = 16, int STATIC_PARTS = 0>
__aicore__ inline void SplitRunGlobalBarrier(GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR group_list,
																						 GM_ADDR y, GM_ADDR workspace, int64_t m, int64_t k, int64_t n,
																						 int64_t e, int64_t requestedParts,
																						 const int32_t *cachedEnds = nullptr, int64_t aPitch = 0) {
	const int64_t ak = aPitch > 0 ? aPitch : k;
	static_assert(STATIC_PARTS >= 0 && STATIC_PARTS <= 4, "split degree");
	const int64_t SK = STATIC_PARTS ? STATIC_PARTS : requestedParts;
	constexpr int TILE_M = TM, TILE_N = TN, VEC_CHUNK_M = VC;
	constexpr uint16_t GMM_SYNC_AIV_AIC = 3, GMM_SYNC_AIC_AIV = 5;
	constexpr uint64_t SYNC_MODE2 = 2;
	const uint32_t coreNum = GetBlockNum(), coreIdx = CoreGroupIndex(), subIdx = SubCoreIndex();
	GlobalTensor<int8_t> xGm, wGm;
	GlobalTensor<float> scaleGm;
	GlobalTensor<int64_t> glGm;
	GlobalTensor<int32_t> cGm;
	GlobalTensor<half> yGm;
	xGm.SetGlobalBuffer((__gm__ int8_t *)x, m * ak);
	wGm.SetGlobalBuffer((__gm__ int8_t *)weight, e * k * n);
	scaleGm.SetGlobalBuffer((__gm__ float *)scale, e * n);
	glGm.SetGlobalBuffer((__gm__ int64_t *)group_list, e);
	cGm.SetGlobalBuffer((__gm__ int32_t *)workspace,
											(((m + TM - 1) / TM + e - 1) * ((n + TN - 1) / TN) * SK * TM * TN));
	yGm.SetGlobalBuffer((__gm__ half *)y, m * n);
	int32_t gl[128], prefix[128];
	int64_t totalMTiles = 0, prev = 0;
	for (int ei = 0; ei < e; ++ei) {
		const int64_t end = cachedEnds ? cachedEnds[ei] : glGm.GetValue(ei);
		gl[ei] = end;
		totalMTiles += CeilDiv(end - prev, TILE_M);
		prefix[ei] = totalMTiles;
		prev = end;
	}
	const int64_t NT = (n + TN - 1) / TN;
	const bool workAssign = false;
	const int64_t tasks = workAssign ? totalMTiles : totalMTiles * NT;
	TPipe pipe;
	int64_t iter = 0, slot = 0;
	if ASCEND_IS_AIC {
		typename Config<TM, TN>::MM mm;
		mm.SetSubBlockIdx(0);
		mm.Init(static_cast<TCubeTiling *>(nullptr), &pipe);
		for (int64_t task = coreIdx; task < tasks * SK; task += coreNum) {
			const int64_t tile = task / SK, part = task % SK;
			const int64_t mt = tile / NT;
			int lo = 0, hi = e;
			while (lo < hi) {
				int mid = (lo + hi) / 2;
				if (prefix[mid] <= mt)
					lo = mid + 1;
				else
					hi = mid;
			}
			const int ei = lo;
			const int64_t start = ei ? gl[ei - 1] : 0, me = gl[ei] - start;
			const int64_t mi = mt - (ei ? prefix[ei - 1] : 0), rowBase = start + mi * TM;
			const int64_t curM = me - mi * TM < TM ? me - mi * TM : TM;
			const int64_t nb = tile % NT, ne = nb + 1;
			for (int64_t ni = nb; ni < ne; ++ni) {
				const int64_t colBase = ni * TN, curN = n - colBase < TN ? n - colBase : TN;
				const bool seqC = false;
				const int64_t KS = ((k + SK - 1) / SK + 127) / 128 * 128;
				const int64_t kstart = part * KS, klen = k - kstart < KS ? k - kstart : KS;
				mm.SetOrgShape(me, n, ak, k, TN);
				mm.SetSingleShape(curM, curN, klen);
				mm.SetTensorA(xGm[rowBase * ak + kstart], false);
				mm.SetTensorB(wGm[ei * k * n + kstart * n + colBase], false);
				while (mm.Iterate())
					mm.GetTensorC(cGm[task * TM * TN], 0, seqC);
				slot ^= 1;
				++iter;
			}
		}
		PipeBarrier<PIPE_ALL>();
		SyncAll<false>();
	} else {
		SyncAll<false>();
		TQue<TPosition::VECIN, 1> cQue, sQue, partQue;
		TQue<TPosition::VECOUT, 1> oQue;
		TBuf<TPosition::VECCALC> zBuf, uBuf, sMulBuf;
		constexpr uint32_t CHUNK_ELEMS = VC * TN;
		pipe.InitBuffer(cQue, 1, CHUNK_ELEMS * 4);
		pipe.InitBuffer(partQue, 1, CHUNK_ELEMS * 4);
		pipe.InitBuffer(sQue, 1, TN * 4);
		pipe.InitBuffer(oQue, 1, CHUNK_ELEMS * 2);
		pipe.InitBuffer(zBuf, CHUNK_ELEMS * 4);
		pipe.InitBuffer(uBuf, CHUNK_ELEMS * 4);
		pipe.InitBuffer(sMulBuf, CHUNK_ELEMS * 4);
		LocalTensor<float> z = zBuf.Get<float>(), u = uBuf.Get<float>(), sMul = sMulBuf.Get<float>();
		for (int64_t task = coreIdx; task < tasks; task += coreNum) {
			const int64_t mt = workAssign ? task : task / NT;
			int lo = 0, hi = e;
			while (lo < hi) {
				int mid = (lo + hi) / 2;
				if (prefix[mid] <= mt)
					lo = mid + 1;
				else
					hi = mid;
			}
			const int ei = lo;
			const int64_t start = ei ? gl[ei - 1] : 0, me = gl[ei] - start;
			const int64_t mi = mt - (ei ? prefix[ei - 1] : 0), rowBase = start + mi * TM;
			const int64_t curM = me - mi * TM < TM ? me - mi * TM : TM;
			const int64_t rowsPerSub = (curM + 1) / 2, subRowBegin = subIdx * rowsPerSub;
			const int64_t subRowEnd = subRowBegin < curM
																		? (subRowBegin + rowsPerSub < curM ? subRowBegin + rowsPerSub : curM)
																		: subRowBegin;
			const int64_t nb = workAssign ? 0 : task % NT, ne = workAssign ? NT : nb + 1;
			for (int64_t ni = nb; ni < ne; ++ni) {
				const int64_t colBase = ni * TN, curN = n - colBase < TN ? n - colBase : TN;
				const bool seqC = false;
				LocalTensor<float> s = sQue.AllocTensor<float>();
				DataCopyExtParams sp{1, static_cast<uint32_t>(curN * 4), 0, 0, 0};
				DataCopyPadExtParams<float> spad{true, 0, 0, 0};
				DataCopyPad(s, scaleGm[ei * n + colBase], sp, spad);
				sQue.EnQue(s);
				s = sQue.DeQue<float>();
				if (subRowBegin < subRowEnd) {
					const int64_t azN = ((curN + 15) / 16) * 16, alignedN = ((curN + 7) / 8) * 8;
					const int64_t smRows = subRowEnd - subRowBegin < VC ? subRowEnd - subRowBegin : VC;
					for (int64_t rr = 0; rr < smRows; ++rr)
						Adds(sMul[rr * azN], s, 0.0f, azN);
					for (int64_t row = subRowBegin; row < subRowEnd; row += VC) {
						const int64_t rc = subRowEnd - row < VC ? subRowEnd - row : VC;
						LocalTensor<int32_t> c = cQue.AllocTensor<int32_t>();
						DataCopyExtParams cp{static_cast<uint16_t>(rc), static_cast<uint32_t>(curN * 4),
																 static_cast<uint32_t>((TN - curN) * 4),
																 static_cast<uint32_t>((azN - alignedN) / 8), 0};
						DataCopyPadExtParams<int32_t> cpad{true, 0, 0, 0};
						const int64_t cb = task * SK * TM * TN + row * TN;
						DataCopyPad(c, cGm[cb], cp, cpad);
						cQue.EnQue(c);
						c = cQue.DeQue<int32_t>();
						for (int part = 1; part < SK; ++part) {
							LocalTensor<int32_t> partial = partQue.AllocTensor<int32_t>();
							DataCopyPad(partial, cGm[cb + part * TM * TN], cp, cpad);
							partQue.EnQue(partial);
							partial = partQue.DeQue<int32_t>();
							Add(c, c, partial, rc * azN);
							PipeBarrier<PIPE_V>();
							partQue.FreeTensor(partial);
						}
						Cast(z, c, RoundMode::CAST_NONE, rc * azN);
						cQue.FreeTensor(c);
						PipeBarrier<PIPE_V>();
						Mul(z, z, sMul, rc * azN);
						GeluComputeSigmoid(z, u, rc * azN);
						PipeBarrier<PIPE_V>();
						LocalTensor<half> o = oQue.AllocTensor<half>();
						Cast(o, u, RoundMode::CAST_NONE, rc * azN);
						oQue.EnQue(o);
						o = oQue.DeQue<half>();
						DataCopyExtParams op{static_cast<uint16_t>(rc), static_cast<uint32_t>(curN * 2), 0,
																 static_cast<uint32_t>((n - curN) * 2), 0};
						DataCopyPad(yGm[(rowBase + row) * n + colBase], o, op);
						oQue.FreeTensor(o);
					}
				}
				sQue.FreeTensor(s);
				slot ^= 1;
				++iter;
			}
		}
	}
}

template <int TM, int TN, int VC = 16, int STATIC_PARTS = 4>
__aicore__ inline void WaveSplitRun(GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR group_list, GM_ADDR y,
																		GM_ADDR workspace, int64_t m, int64_t k, int64_t n, int64_t e,
																		int64_t requestedParts, const int32_t *cachedEnds = nullptr,
																		int64_t aPitch = 0) {
	static_assert(STATIC_PARTS == 4, "Wave resource uses four complete INT32 partitions");
	constexpr int SK = STATIC_PARTS;
	constexpr uint16_t READY = 5, CREDIT = 3;
	constexpr uint64_t SYNC_MODE2 = 2;
	const int64_t ak = aPitch > 0 ? aPitch : k;
	const int64_t coreNum = GetBlockNum(), coreIdx = CoreGroupIndex(), subIdx = SubCoreIndex();
	GlobalTensor<int8_t> xGm, wGm;
	GlobalTensor<float> scaleGm;
	GlobalTensor<int64_t> glGm;
	GlobalTensor<int32_t> cGm;
	GlobalTensor<half> yGm;
	xGm.SetGlobalBuffer((__gm__ int8_t *)x, m * ak);
	wGm.SetGlobalBuffer((__gm__ int8_t *)weight, e * k * n);
	scaleGm.SetGlobalBuffer((__gm__ float *)scale, e * n);
	glGm.SetGlobalBuffer((__gm__ int64_t *)group_list, e);
	cGm.SetGlobalBuffer((__gm__ int32_t *)workspace);
	yGm.SetGlobalBuffer((__gm__ half *)y, m * n);
	int32_t gl[128], prefix[128];
	int64_t totalMTiles = 0, prev = 0;
	for (int ei = 0; ei < e; ++ei) {
		const int64_t end = cachedEnds ? cachedEnds[ei] : glGm.GetValue(ei);
		gl[ei] = end;
		totalMTiles += CeilDiv(end - prev, TM);
		prefix[ei] = totalMTiles;
		prev = end;
	}
	const int64_t NT = CeilDiv(n, TN), tasks = totalMTiles * NT;
	const int64_t groupsPerWave = coreNum / SK, waves = CeilDiv(tasks, groupsPerWave);
	TPipe pipe;
	if ASCEND_IS_AIC {
		typename Config<TM, TN>::MM mm;
		mm.SetSubBlockIdx(0);
		mm.Init(static_cast<TCubeTiling *>(nullptr), &pipe);
		for (int64_t wave = 0; wave < waves; ++wave) {
			const int64_t tile = wave * groupsPerWave + coreIdx / SK, part = coreIdx % SK;
			if (tile < tasks) {
				const int64_t mt = tile / NT, ni = tile % NT;
				int lo = 0, hi = e;
				while (lo < hi) {
					int mid = (lo + hi) / 2;
					if (prefix[mid] <= mt)
						lo = mid + 1;
					else
						hi = mid;
				}
				const int ei = lo;
				const int64_t start = ei ? gl[ei - 1] : 0, me = gl[ei] - start;
				const int64_t mi = mt - (ei ? prefix[ei - 1] : 0), rowBase = start + mi * TM;
				const int64_t curM = me - mi * TM < TM ? me - mi * TM : TM;
				const int64_t colBase = ni * TN, curN = n - colBase < TN ? n - colBase : TN;
				const int64_t KS = CeilDiv(CeilDiv(k, SK), 128) * 128, kstart = part * KS;
				const int64_t klen = k - kstart < KS ? k - kstart : KS;
				mm.SetOrgShape(me, n, ak, k, TN);
				mm.SetSingleShape(curM, curN, klen);
				mm.SetTensorA(xGm[rowBase * ak + kstart], false);
				mm.SetTensorB(wGm[ei * k * n + kstart * n + colBase], false);
				while (mm.Iterate()) {
					if (wave >= 2)
						CrossCoreWaitFlag(CREDIT);
					mm.GetTensorC(cGm[((wave & 1) * coreNum + coreIdx) * TM * TN], 0, false);
				}
			} else if (wave >= 2)
				CrossCoreWaitFlag(CREDIT);
			CrossCoreSetFlag<SYNC_MODE2, PIPE_FIX>(READY);
		}
		for (int64_t i = 0; i < (waves < 2 ? waves : 2); ++i)
			CrossCoreWaitFlag(CREDIT);
	} else {
		TQue<TPosition::VECIN, 1> cQue, sQue;
		TQue<TPosition::VECOUT, 1> oQue;
		TBuf<TPosition::VECCALC> zBuf, uBuf;
		constexpr uint32_t CHUNK_ELEMS = VC * TN;
		pipe.InitBuffer(cQue, 1, SK * CHUNK_ELEMS * 4);
		pipe.InitBuffer(sQue, 1, TN * 4);
		pipe.InitBuffer(oQue, 1, CHUNK_ELEMS * 2);
		pipe.InitBuffer(zBuf, CHUNK_ELEMS * 4);
		pipe.InitBuffer(uBuf, CHUNK_ELEMS * 4);
		LocalTensor<float> z = zBuf.Get<float>(), u = uBuf.Get<float>();
		const int64_t lane = (coreIdx % SK) * GetTaskRation() + subIdx;
		for (int64_t wave = 0; wave < waves; ++wave) {
			CrossCoreWaitFlag(READY);
			SyncAll<true>();
			if (wave > 0)
				CrossCoreSetFlag<SYNC_MODE2, PIPE_MTE2>(CREDIT);
			const int64_t tile = wave * groupsPerWave + coreIdx / SK;
			if (tile < tasks) {
				const int64_t mt = tile / NT, ni = tile % NT;
				int lo = 0, hi = e;
				while (lo < hi) {
					int mid = (lo + hi) / 2;
					if (prefix[mid] <= mt)
						lo = mid + 1;
					else
						hi = mid;
				}
				const int ei = lo;
				const int64_t start = ei ? gl[ei - 1] : 0, me = gl[ei] - start;
				const int64_t mi = mt - (ei ? prefix[ei - 1] : 0), rowBase = start + mi * TM;
				const int64_t curM = me - mi * TM < TM ? me - mi * TM : TM;
				const int64_t rowsPerSub = CeilDiv(curM, SK * GetTaskRation());
				const int64_t subRowBegin = lane * rowsPerSub;
				const int64_t subRowEnd = subRowBegin < curM
																			? (subRowBegin + rowsPerSub < curM ? subRowBegin + rowsPerSub : curM)
																			: subRowBegin;
				const int64_t colBase = ni * TN, curN = n - colBase < TN ? n - colBase : TN;
				LocalTensor<float> s = sQue.AllocTensor<float>();
				DataCopyExtParams sp{1, static_cast<uint32_t>(curN * 4), 0, 0, 0};
				DataCopyPadExtParams<float> spad{true, 0, 0, 0};
				DataCopyPad(s, scaleGm[ei * n + colBase], sp, spad);
				sQue.EnQue(s);
				s = sQue.DeQue<float>();
				if (subRowBegin < subRowEnd) {
					const int64_t azN = CeilDiv(curN, 16) * 16, alignedN = CeilDiv(curN, 8) * 8;
					for (int64_t row = subRowBegin; row < subRowEnd; row += VC) {
						const int64_t rc = subRowEnd - row < VC ? subRowEnd - row : VC;
						LocalTensor<int32_t> c = cQue.AllocTensor<int32_t>();
						DataCopyExtParams cp{static_cast<uint16_t>(rc), static_cast<uint32_t>(curN * 4),
																 static_cast<uint32_t>((TN - curN) * 4),
																 static_cast<uint32_t>((azN - alignedN) / 8), 0};
						DataCopyPadExtParams<int32_t> cpad{true, 0, 0, 0};
						const int64_t cb = ((wave & 1) * coreNum + (coreIdx / SK) * SK) * TM * TN + row * TN;
						for (int part = 0; part < SK; ++part)
							DataCopyPad(c[part * CHUNK_ELEMS], cGm[cb + part * TM * TN], cp, cpad);
						cQue.EnQue(c);
						c = cQue.DeQue<int32_t>();
						for (int part = 1; part < SK; ++part) {
							Add(c, c, c[part * CHUNK_ELEMS], rc * azN);
							PipeBarrier<PIPE_V>();
						}
						Cast(z, c, RoundMode::CAST_NONE, rc * azN);
						cQue.FreeTensor(c);
						PipeBarrier<PIPE_V>();
						BinaryRepeatParams scaleRepeat{
								1, 1, 1, static_cast<uint8_t>(azN / 8), static_cast<uint8_t>(azN / 8), 0};
						for (int64_t column = 0; column < azN; column += 64) {
							const uint64_t mask = azN - column < 64 ? azN - column : 64;
							Mul(z[column], z[column], s[column], mask, static_cast<uint8_t>(rc), scaleRepeat);
						}
						PipeBarrier<PIPE_V>();
						GeluComputeSigmoid(z, u, rc * azN);
						PipeBarrier<PIPE_V>();
						LocalTensor<half> output = oQue.AllocTensor<half>();
						Cast(output, u, RoundMode::CAST_NONE, rc * azN);
						oQue.EnQue(output);
						output = oQue.DeQue<half>();
						DataCopyExtParams op{static_cast<uint16_t>(rc), static_cast<uint32_t>(curN * 2), 0,
																 static_cast<uint32_t>((n - curN) * 2), 0};
						DataCopyPad(yGm[(rowBase + row) * n + colBase], output, op);
						oQue.FreeTensor(output);
					}
				}
				sQue.FreeTensor(s);
			}
		}
		SyncAll<true>();
		CrossCoreSetFlag<SYNC_MODE2, PIPE_MTE2>(CREDIT);
	}
}

template <int TM, int TN, int VC = 16, int STATIC_PARTS = 0>
__aicore__ inline void SplitRun(GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR g, GM_ADDR y, GM_ADDR ws, int64_t m,
																int64_t k, int64_t n, int64_t e, int64_t parts,
																const int32_t *cachedEnds = nullptr, int64_t aPitch = 0) {
	if constexpr (STATIC_PARTS == 4) {
		if (GetBlockNum() % 4 == 0) {
			WaveSplitRun<TM, TN, VC, 4>(x, w, s, g, y, ws, m, k, n, e, parts, cachedEnds, aPitch);
			return;
		}
	}
	SplitRunGlobalBarrier<TM, TN, VC, STATIC_PARTS>(x, w, s, g, y, ws, m, k, n, e, parts, cachedEnds, aPitch);
}

}
namespace os_i2_wave_runtime {
template <int TM, int TN, int VC = 16, int PARTS = 4>
__aicore__ inline void WidePaddedASplitRun(GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR g, GM_ADDR y, GM_ADDR ws,
																					 int64_t m, int64_t k, int64_t n, int64_t e, int64_t parts) {
	const int64_t ak = CeilDiv(k, 32) * 32;
	const bool pack = k != ak && ak <= 65536;
	int32_t ends[128], active, maxRows;
	bool endsReady = false;
	if ASCEND_IS_AIC {
		CollectGroups(g, e, ends, active, maxRows);
		endsReady = true;
	}
	const int64_t tiles = (CeilDiv(m, TM) + e - 1) * CeilDiv(n, TN);
	GM_ADDR packed = ws + tiles * parts * TM * TN * 4;
	if (pack) {
		if ASCEND_IS_AIV {
			TPipe pipe;
			const int64_t shardRows = CeilDiv(m, GetBlockNum() * GetTaskRation());
			const int64_t capacityRows = (160 * 1024) / ak;
			const int64_t batchRows = shardRows < capacityRows ? shardRows : capacityRows;
			const int64_t stageBytes = batchRows * ak;
			TBuf<TPosition::VECCALC> copyBuffer;
			pipe.InitBuffer(copyBuffer, stageBytes);
			LocalTensor<int8_t> copy = copyBuffer.Get<int8_t>();
			GlobalTensor<int8_t> in, out;
			in.SetGlobalBuffer((__gm__ int8_t *)x, m * k);
			out.SetGlobalBuffer((__gm__ int8_t *)packed, m * ak);
			const int64_t perCore = CeilDiv(m, GetBlockNum() * GetTaskRation());
			const int64_t begin = GetBlockIdx() * perCore, end = begin + perCore < m ? begin + perCore : m;
			for (int64_t row = begin; row < end; row += batchRows) {
				const int64_t rows = end - row < batchRows ? end - row : batchRows;
				DataCopyExtParams load{static_cast<uint16_t>(rows), static_cast<uint32_t>(k), 0, 0, 0};
				DataCopyPadExtParams<int8_t> pad{true, 0, 0, 0};
				DataCopyPad(copy, in[row * k], load, pad);
				if (!endsReady) {
					CollectGroups(g, e, ends, active, maxRows);
					endsReady = true;
				}
				SetFlag<HardEvent::MTE2_MTE3>(EVENT_ID0);
				WaitFlag<HardEvent::MTE2_MTE3>(EVENT_ID0);
				DataCopyExtParams store{1, static_cast<uint32_t>(rows * ak), 0, 0, 0};
				DataCopyPad(out[row * ak], copy, store);
				SetFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);
				WaitFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);
			}
			if (!endsReady) {
				CollectGroups(g, e, ends, active, maxRows);
				endsReady = true;
			}
			pipe.Reset();
		}
		SyncAll<false>();
	}
	if (!endsReady)
		CollectGroups(g, e, ends, active, maxRows);
	SplitRun<TM, TN, VC, PARTS>(pack ? packed : x, w, s, g, y, ws, m, k, n, e, parts, ends, pack ? ak : k);
}

}
namespace os_i2_nz176 {
using namespace AscendC;
using os_i2_wave_runtime::CoreGroupIndex;
using os_i2_wave_runtime::SubCoreIndex;
using os_i2_wave_runtime::CeilDiv;
using os_i2_wave_runtime::GeluComputeSigmoid;
using os_i2_wave_runtime::CollectGroups;
using os_i2_wave_runtime::WidePaddedASplitRun;

// Each producer has a separate 32B DMA-written epoch line. No scalar GM read
// or assumed DCache freshness participates in readiness.
struct ProducerEpoch {
	TBuf<TPosition::VECCALC> storage;
	GlobalTensor<float> flags;
	TEventID vectorToStore, storeToVector, loadToScalar, scalarToLoad;
	int64_t core = 0;
	int64_t owner = 0;
	bool publicationPending = false;

	__aicore__ inline void Publish(int32_t epoch) {
		if (publicationPending) {
			WaitFlag<HardEvent::MTE3_V>(storeToVector);
		}
		auto local = storage.Get<float>();
		// Publisher [224,256) never aliases poll input [0,128).
		Duplicate(local[56], float(epoch), 8);
		SetFlag<HardEvent::V_MTE3>(vectorToStore);
		WaitFlag<HardEvent::V_MTE3>(vectorToStore);
		DataCopy(flags[core * 8], local[56], uint32_t(8));
		SetFlag<HardEvent::MTE3_V>(storeToVector);
		publicationPending = true;
	}

	__aicore__ inline void Init(TPipe &pipe, GM_ADDR workspace, int64_t n, int64_t physicalCore, int64_t sub) {
		pipe.InitBuffer(storage, 256);
		flags.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(workspace) + CeilDiv(n, 128) * 128,
													GetBlockNum() * 8);
		core = physicalCore;
		owner = core / 4;
		vectorToStore = pipe.AllocEventID<HardEvent::V_MTE3>();
		storeToVector = pipe.AllocEventID<HardEvent::MTE3_V>();
		loadToScalar = pipe.AllocEventID<HardEvent::MTE2_S>();
		scalarToLoad = pipe.AllocEventID<HardEvent::S_MTE2>();
		if (sub == 0) {
			Publish(0);
		}
	}

	__aicore__ inline void WaitAllFour(int32_t epoch) {
		auto local = storage.Get<float>();
		bool ready = false;
		while (!ready) {
			DataCopy(local, flags[owner * 32], uint32_t(32));
			SetFlag<HardEvent::MTE2_S>(loadToScalar);
			WaitFlag<HardEvent::MTE2_S>(loadToScalar);
			ready = local.GetValue(0) >= float(epoch) && local.GetValue(8) >= float(epoch) &&
							local.GetValue(16) >= float(epoch) && local.GetValue(24) >= float(epoch);
			SetFlag<HardEvent::S_MTE2>(scalarToLoad);
			WaitFlag<HardEvent::S_MTE2>(scalarToLoad);
		}
	}

	__aicore__ inline void End(int64_t sub) {
		if (sub == 0 && publicationPending) {
			WaitFlag<HardEvent::MTE3_V>(storeToVector);
			publicationPending = false;
		}
	}
};

template <int TN, int MCAP, int ST, int BK, bool N16, bool PADDED_BARRIER, bool FULL_SLOT, bool NZ = false,
					bool FULL_A_ONCE = false, bool EARLY_PRIME = false, bool BATCH_MTE1 = true>
struct ResourcePanelMmad {
	static constexpr int TM = 192, NCAP = (TN + 31) / 32 * 32;
	static constexpr bool RETAIN_A = true;
	static_assert(MCAP % 16 == 0 && TN % 16 == 0 && ST % 32 == 0 && BK % 32 == 0, "fractal alignment");
	static_assert(MCAP * 2048 + 2 * ST * NCAP <= 512 * 1024, "A residency and B stages fit L1");
	static_assert(MCAP * TN * 4 <= 128 * 1024, "actual M/N capacity fits L0C");
	static_assert(MCAP * BK <= 32768 && BK * TN + 512 <= 32768, "two independent L0 slots");
	static constexpr int MAX_K = 2048;
	TBuf<TPosition::A1> a1b;
	TBuf<TPosition::B1> b1b;
	TBuf<TPosition::A2> a0b;
	TBuf<TPosition::B2> b0b;
	TBuf<TPosition::CO1> cb;
	bool pendingFix = false, nextBReady = false;
	int64_t ma = 0, curM = 0, curN = 0;
	__aicore__ inline void Init(TPipe &pipe) {
		pipe.InitBuffer(a1b, MCAP * MAX_K);
		pipe.InitBuffer(b1b, 2 * ST * NCAP);
		pipe.InitBuffer(a0b, 64 * 1024);
		pipe.InitBuffer(b0b, 64 * 1024);
		pipe.InitBuffer(cb, MCAP * TN * 4);
		const uint8_t pad[4] = {0, 0, 0, 0};
		SetFmatrix(1, MCAP, pad, FmatrixMode::FMATRIX_LEFT);
		SetFlag<HardEvent::MTE1_MTE2>(2);
		SetFlag<HardEvent::MTE1_MTE2>(3);
	}
	__aicore__ inline void QueueStage(GlobalTensor<int8_t> x, GlobalTensor<int8_t> w, int64_t start, int64_t m,
																		int64_t k, int64_t n, int64_t ak, int64_t physicalN, bool reuseA,
																		bool preowned = false) {
		const int64_t rows = k - start < ST ? k - start : ST, slot = (start / ST) & 1;
		const event_t event = static_cast<event_t>(slot + 2);
		if (!preowned)
			WaitFlag<HardEvent::MTE1_MTE2>(event);
		auto aa = a1b.Get<int8_t>()[start * MCAP];
		auto bb = b1b.Get<int8_t>()[slot * ST * NCAP];
		Nd2NzParams bp{
				1, static_cast<uint16_t>(rows), static_cast<uint16_t>(n), 0, static_cast<uint16_t>(physicalN), ST, 1,
				0};
		if constexpr (!FULL_A_ONCE)
			if (!RETAIN_A || !reuseA) {
				if constexpr (NZ)
					DataCopy(aa, x[start * MCAP], static_cast<uint32_t>(CeilDiv(rows, 32) * 32 * MCAP));
				else {
					Nd2NzParams ap{
							1, static_cast<uint16_t>(m), static_cast<uint16_t>(rows), 0, static_cast<uint16_t>(ak), MCAP, 1,
							0};
					DataCopy(aa, x[start], ap);
				}
			}
		DataCopy(bb, w[start * physicalN], bp);
		SetFlag<HardEvent::MTE2_MTE1>(event);
	}
	__aicore__ inline void Compute(GlobalTensor<int8_t> x, GlobalTensor<int8_t> w, int64_t m, int64_t k,
																 int64_t n, int64_t ak, int64_t physicalN, bool reuseA, bool prepareNext,
																 int64_t nextN) {
		// Carried readiness is valid only for the immediately next owned same-M N.
		const bool useNext = nextBReady;
		nextBReady = false;
		const bool canPrefetch = prepareNext && FULL_A_ONCE && RETAIN_A && !NZ && n == TN && nextN > 0 &&
														 nextN <= TN && k > ST && CeilDiv(k, ST) % 2 == 0;
		if constexpr (!EARLY_PRIME) {
			if (pendingFix) {
				WaitFlag<HardEvent::FIX_M>(4);
				pendingFix = false;
			}
		}
		const int64_t newN = (n + (N16 ? 15 : 31)) / (N16 ? 16 : 32) * (N16 ? 16 : 32);
		const int64_t oldN = (curN + (N16 ? 15 : 31)) / (N16 ? 16 : 32) * (N16 ? 16 : 32);
		if (ma != ((m + 15) / 16 * 16) || (PADDED_BARRIER ? oldN != newN : curN != n))
			PipeBarrier<PIPE_ALL>();
		auto a1 = a1b.Get<int8_t>(), b1 = b1b.Get<int8_t>();
		auto a0 = a0b.Get<int8_t>(), b0 = b0b.Get<int8_t>();
		auto c = cb.Get<int32_t>();
		ma = (m + 15) / 16 * 16;
		curM = m;
		curN = n;
		const int64_t na = newN;
		int64_t sequence = 0;
		if constexpr (FULL_A_ONCE) {
			static_assert(!NZ, "Full A is copied from actual ND input");
			if (!useNext) {
				WaitFlag<HardEvent::MTE1_MTE2>(2);
				WaitFlag<HardEvent::MTE1_MTE2>(3);
				if (!reuseA) {
					Nd2NzParams ap{
							1, static_cast<uint16_t>(m), static_cast<uint16_t>(k), 0, static_cast<uint16_t>(ak), MCAP, 1,
							0};
					DataCopy(a1, x, ap);
				}
			}
		}
		if (!useNext) {
			QueueStage(x, w, 0, m, k, n, ak, physicalN, reuseA, FULL_A_ONCE);
			if (k > ST)
				QueueStage(x, w, ST, m, k, n, ak, physicalN, reuseA, FULL_A_ONCE);
			else if constexpr (FULL_A_ONCE)
				SetFlag<HardEvent::MTE1_MTE2>(3);
		}
		if constexpr (EARLY_PRIME) {
			if (pendingFix) {
				WaitFlag<HardEvent::FIX_M>(4);
				pendingFix = false;
			}
		}
		for (int64_t start = 0; start < k; start += ST) {
			const int64_t rows = k - start < ST ? k - start : ST, slot = (start / ST) & 1;
			auto aa = a1;
			auto bb = b1[slot * ST * NCAP];
			const event_t l1event = static_cast<event_t>(slot + 2);
			WaitFlag<HardEvent::MTE2_MTE1>(l1event);
			for (int64_t kk = 0; kk < rows; kk += BK) {
				const int64_t remainingK = ((rows - kk + 31) / 32) * 32;
				const int64_t madK = remainingK < BK ? remainingK : BK, ls = sequence & 1;
				const event_t l0event = static_cast<event_t>(ls);
				WaitFlag<HardEvent::M_MTE1>(l0event);
				auto av = a0[ls * (32 * 1024)];
				auto bv = b0[ls * (32 * 1024)];
				LoadData3DParamsV2Pro la;
				la.channelSize = MAX_K;
				la.extConfig = (uint64_t(start + kk) << 32) | (uint64_t(ma) << 16) | uint64_t(madK);
				la.enTranspose = false;
				LoadData(av, aa, la);
				if constexpr (!BATCH_MTE1)
					PipeBarrier<PIPE_MTE1>();
				LoadData2dTransposeParams lb;
				lb.startIndex = 0;
				lb.repeatTimes = (na + 31) / 32;
				lb.srcStride = ST / 32;
				lb.dstGap = 1;
				lb.dstFracGap = 0;
				lb.addrMode = 0;
				for (int ki = 0; ki < madK / 32; ++ki) {
					LoadDataWithTranspose(bv[ki * 32 * na], bb[(kk + ki * 32) * 32], lb);
					if constexpr (!BATCH_MTE1)
						PipeBarrier<PIPE_MTE1>();
				}
				SetFlag<HardEvent::MTE1_M>(l0event);
				WaitFlag<HardEvent::MTE1_M>(l0event);
				MmadParams mp;
				mp.m = ma;
				mp.n = na;
				mp.k = madK;
				mp.unitFlag = 0;
				mp.cmatrixInitVal = sequence == 0;
				Mmad(c, av, bv, mp);
				if ((ma / 16) * (na / 16) < 10)
					PipeBarrier<PIPE_M>();
				SetFlag<HardEvent::M_MTE1>(l0event);
				++sequence;
			}
			SetFlag<HardEvent::MTE1_MTE2>(l1event);
			if (start + 2 * ST < k)
				QueueStage(x, w, start + 2 * ST, m, k, n, ak, physicalN, reuseA);
			// All B requests of this panel are already ahead in the same MTE2 FIFO.
			// Even stage count makes penultimate/final retired slots exactly B0/B1.
			// QueueStage consumes that slot's last-reader credit and publishes its
			// unchanged MTE2_MTE1 ready; no next-Compute duplicate copy is issued.
			if (canPrefetch && start + 2 * ST >= k) {
				const int64_t headStart = start + ST < k ? 0 : ST;
				QueueStage(x, w[TN], headStart, m, k, nextN, ak, physicalN, true);
				if (start + ST >= k)
					nextBReady = true;
			}
		}
		SetFlag<HardEvent::M_FIX>(4);
		WaitFlag<HardEvent::M_FIX>(4);
	}

	__aicore__ inline void Store(GlobalTensor<int32_t> dst) {
		FixpipeParamsV220 fp;
		fp.nSize = FULL_SLOT ? TN : curN;
		fp.mSize = curM;
		fp.srcStride = ma;
		fp.dstStride = TN;
		fp.reluEn = false;
		fp.quantPre = QuantMode_t::NoQuant;
		fp.unitFlag = 0;
		Fixpipe<int32_t, int32_t, CFG_ROW_MAJOR>(dst, cb.Get<int32_t>(), fp);
		SetFlag<HardEvent::FIX_M>(4);
		pendingFix = true;
	}
	__aicore__ inline void End() {
		if (pendingFix)
			WaitFlag<HardEvent::FIX_M>(4);
		WaitFlag<HardEvent::MTE1_MTE2>(2);
		WaitFlag<HardEvent::MTE1_MTE2>(3);
	}
};
template <int TN, int MCAP, int ST, int BK, bool N16, bool PADDED_BARRIER, bool FULL_SLOT, int VC = 16,
					int STATIC_PARTS = 4, bool NZ = false, bool FULL_A_ONCE = false, bool EARLY_PRIME = false,
					bool BATCH_MTE1 = true, bool LAST_CLEAR = true>
__aicore__ inline void NZWaveRun(GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR group_list, GM_ADDR y,
																 GM_ADDR workspace, int64_t m, int64_t k, int64_t n, int64_t e,
																 int64_t requestedParts, const int32_t *cachedEnds = nullptr,
																 int64_t aPitch = 0) {
	static_assert(STATIC_PARTS == 4, "Wave resource uses four complete INT32 partitions");
	constexpr int TM = MCAP, SK = STATIC_PARTS;
	constexpr uint16_t READY = 5, ACK = 3, INITIALIZED = 7;
	constexpr uint16_t LEADER_PAIR_READY = 8;
	constexpr uint64_t SYNC_MODE2 = 2;
	const int64_t ak = aPitch > 0 ? aPitch : k;
	const int64_t coreNum = GetBlockNum(), coreIdx = CoreGroupIndex(), subIdx = SubCoreIndex();
	GlobalTensor<int8_t> xGm, wGm;
	GlobalTensor<float> scaleGm;
	GlobalTensor<int64_t> glGm;
	GlobalTensor<int32_t> cGm;
	GlobalTensor<half> yGm;
	xGm.SetGlobalBuffer((__gm__ int8_t *)x);
	wGm.SetGlobalBuffer((__gm__ int8_t *)weight, e * k * n);
	scaleGm.SetGlobalBuffer((__gm__ float *)scale, e * n);
	glGm.SetGlobalBuffer((__gm__ int64_t *)group_list, e);
	cGm.SetGlobalBuffer((__gm__ int32_t *)workspace + CeilDiv(n, TN) * TN + coreNum * 8);
	yGm.SetGlobalBuffer((__gm__ half *)y, m * n);
	int32_t gl[128], prefix[128];
	int64_t totalMTiles = 0, prev = 0;
	for (int ei = 0; ei < e; ++ei) {
		const int64_t end = cachedEnds ? cachedEnds[ei] : glGm.GetValue(ei);
		gl[ei] = end;
		totalMTiles += CeilDiv(end - prev, TM);
		prefix[ei] = totalMTiles;
		prev = end;
	}
	const int64_t NT = CeilDiv(n, TN), tasks = totalMTiles * NT;
	const int64_t groupsPerWave = coreNum / SK, waves = CeilDiv(tasks, groupsPerWave);
	const int64_t owner = coreIdx / SK, baseTasks = tasks / groupsPerWave, extras = tasks % groupsPerWave;
	const int64_t firstTask = owner * baseTasks + (owner < extras ? owner : extras);
	const int64_t ownedTasks = baseTasks + (owner < extras ? 1 : 0);
	TPipe pipe;
	if ASCEND_IS_AIC {
		ResourcePanelMmad<TN, MCAP, ST, BK, N16, PADDED_BARRIER, FULL_SLOT, NZ, FULL_A_ONCE, EARLY_PRIME,
											BATCH_MTE1>
				mm;
		mm.Init(pipe);

		CrossCoreWaitFlag(INITIALIZED);
		int64_t lastMTile = -1;
		bool ackPending = false;
		for (int64_t wave = 0; wave < ownedTasks; ++wave) {
			const int64_t tile = (wave < ownedTasks ? firstTask + wave : tasks), part = coreIdx % SK;
			if (tile < tasks) {
				const int64_t mt = tile / NT, ni = tile % NT;
				int lo = 0, hi = e;
				while (lo < hi) {
					int mid = (lo + hi) / 2;
					if (prefix[mid] <= mt)
						lo = mid + 1;
					else
						hi = mid;
				}
				const int ei = lo;
				const int64_t start = ei ? gl[ei - 1] : 0, me = gl[ei] - start;
				const int64_t mi = mt - (ei ? prefix[ei - 1] : 0), rowBase = start + mi * TM;
				const int64_t curM = me - mi * TM < TM ? me - mi * TM : TM;
				const int64_t colBase = ni * TN, curN = n - colBase < TN ? n - colBase : TN;
				const int64_t KS = CeilDiv(CeilDiv(k, SK), 128) * 128, kstart = part * KS;
				const int64_t klen = k - kstart < KS ? k - kstart : KS;

				// Flat owned tasks are contiguous. The next task stays in this M lease
				// exactly when the next N exists and the owner actually owns that task.
				const bool prepareNext = wave + 1 < ownedTasks && ni + 1 < NT;
				const int64_t nextRemaining = n - (ni + 1) * TN, nextN = nextRemaining < TN ? nextRemaining : TN;
				mm.Compute(xGm[NZ ? mt * TM * ak + kstart * TM : rowBase * ak + kstart],
									 wGm[ei * k * n + kstart * n + colBase], curM, klen, curN, ak, n, mt == lastMTile,
									 prepareNext, nextN);
				lastMTile = mt;
				if (ackPending) {
					CrossCoreWaitFlag(ACK);
					ackPending = false;
				}
				PipeBarrier<PIPE_FIX>();
				SetAtomicAdd<int32_t>();
				mm.Store(cGm[tile * TM * TN]);
				PipeBarrier<PIPE_FIX>();
				SetAtomicNone();
			}
			CrossCoreSetFlag<SYNC_MODE2, PIPE_FIX>(READY);
			ackPending = true;
		}
		if (ackPending) {
			CrossCoreWaitFlag(ACK);
		}
		mm.End();
	} else {
		TQue<TPosition::VECIN, 1> cQue, sQue;
		TQue<TPosition::VECOUT, 1> oQue;
		TBuf<TPosition::VECCALC> zBuf, uBuf, zeroBuf;
		constexpr uint32_t CHUNK_ELEMS = VC * TN;
		pipe.InitBuffer(cQue, 1, CHUNK_ELEMS * 4);
		pipe.InitBuffer(sQue, 1, TN * 4);
		pipe.InitBuffer(oQue, 1, CHUNK_ELEMS * 2);
		pipe.InitBuffer(zBuf, CHUNK_ELEMS * 4);
		pipe.InitBuffer(uBuf, CHUNK_ELEMS * 4);
		LocalTensor<float> z = zBuf.Get<float>(), u = uBuf.Get<float>();
		pipe.InitBuffer(zeroBuf, CHUNK_ELEMS * 4);
		auto zero = zeroBuf.Get<int32_t>();
		Duplicate(zero, int32_t(0), CHUNK_ELEMS);
		const auto zeroReady = static_cast<event_t>(pipe.AllocEventID<HardEvent::V_MTE3>());
		// Unique task C is never rewritten after its four atomic contributions.

		SetFlag<HardEvent::V_MTE3>(zeroReady);
		WaitFlag<HardEvent::V_MTE3>(zeroReady);
		ProducerEpoch epochs;
		epochs.Init(pipe, workspace, n, coreIdx, subIdx);
		// Initialize the entire actual task-C domain once, in aligned chunks.
		const int64_t rank = coreIdx * GetTaskRation() + subIdx, lanes = coreNum * GetTaskRation();
		const int64_t cElems = tasks * TM * TN;
		for (int64_t at = rank * CHUNK_ELEMS; at < cElems; at += lanes * CHUNK_ELEMS) {
			const int64_t count = cElems - at < CHUNK_ELEMS ? cElems - at : CHUNK_ELEMS;
			DataCopy(cGm[at], zero, uint32_t(count));
		}
		SyncAll<true>();
		CrossCoreSetFlag<SYNC_MODE2, PIPE_MTE3>(INITIALIZED);

		const bool leaderPair = coreIdx % SK == 0;
		const int64_t lane = subIdx;
		for (int64_t wave = 0; wave < ownedTasks; ++wave) {
			CrossCoreWaitFlag(READY);
			if (subIdx == 0) {
				// Local READY covers this producer's complete atomic FIX. The other
				// local subcore has no C read/reset that publication must cover.
				epochs.Publish(static_cast<int32_t>(wave + 1));
			}
			// ACK bounds local READY accumulation; it is not the SK4 completion join.
			// Unique task C permits next Compute before ACK and removes C reuse edges.
			CrossCoreSetFlag<SYNC_MODE2, PIPE_MTE3>(ACK);
			if (!leaderPair) {
				continue;
			}
			if (subIdx == 0) {
				epochs.WaitAllFour(static_cast<int32_t>(wave + 1));
			}
			// Exactly the two consumer subcores rendezvous. Only sub0 polls GM.
			CrossCoreSetFlag<1, PIPE_MTE2>(LEADER_PAIR_READY);
			CrossCoreWaitFlag(LEADER_PAIR_READY);
			const int64_t tile = (wave < ownedTasks ? firstTask + wave : tasks);
			if (tile < tasks) {
				const int64_t mt = tile / NT, ni = tile % NT;
				int lo = 0, hi = e;
				while (lo < hi) {
					int mid = (lo + hi) / 2;
					if (prefix[mid] <= mt)
						lo = mid + 1;
					else
						hi = mid;
				}
				const int ei = lo;
				const int64_t start = ei ? gl[ei - 1] : 0, me = gl[ei] - start;
				const int64_t mi = mt - (ei ? prefix[ei - 1] : 0), rowBase = start + mi * TM;
				const int64_t curM = me - mi * TM < TM ? me - mi * TM : TM;
				const int64_t rowsPerSub = CeilDiv(curM, GetTaskRation());
				const int64_t subRowBegin = lane * rowsPerSub;
				const int64_t subRowEnd = subRowBegin < curM
																			? (subRowBegin + rowsPerSub < curM ? subRowBegin + rowsPerSub : curM)
																			: subRowBegin;
				const int64_t colBase = ni * TN, curN = n - colBase < TN ? n - colBase : TN;
				LocalTensor<float> s;

				s = sQue.AllocTensor<float>();
				DataCopyExtParams sp{1, static_cast<uint32_t>(curN * 4), 0, 0, 0};
				DataCopyPadExtParams<float> spad{true, 0, 0, 0};
				DataCopyPad(s, scaleGm[ei * n + colBase], sp, spad);
				sQue.EnQue(s);
				s = sQue.DeQue<float>();

				if (subRowBegin < subRowEnd) {
					const int64_t azN = CeilDiv(curN, 16) * 16, alignedN = CeilDiv(curN, 8) * 8;
					for (int64_t row = subRowBegin; row < subRowEnd; row += VC) {
						const int64_t rc = subRowEnd - row < VC ? subRowEnd - row : VC;
						LocalTensor<int32_t> c = cQue.AllocTensor<int32_t>();
						DataCopyExtParams cp{static_cast<uint16_t>(rc), static_cast<uint32_t>(curN * 4),
																 static_cast<uint32_t>((TN - curN) * 4),
																 static_cast<uint32_t>((azN - alignedN) / 8), 0};
						DataCopyPadExtParams<int32_t> cpad{true, 0, 0, 0};
						const int64_t cb = tile * TM * TN + row * TN;
						DataCopyPad(c, cGm[cb], cp, cpad);
						cQue.EnQue(c);
						c = cQue.DeQue<int32_t>();
						// No C reset: no producer ever stores another task to this address.

						Cast(z, c, RoundMode::CAST_NONE, rc * azN);
						cQue.FreeTensor(c);
						PipeBarrier<PIPE_V>();
						BinaryRepeatParams scaleRepeat{
								1, 1, 1, static_cast<uint8_t>(azN / 8), static_cast<uint8_t>(azN / 8), 0};
						for (int64_t column = 0; column < azN; column += 64) {
							const uint64_t mask = azN - column < 64 ? azN - column : 64;
							Mul(z[column], z[column], s[column], mask, static_cast<uint8_t>(rc), scaleRepeat);
						}
						PipeBarrier<PIPE_V>();
						GeluComputeSigmoid(z, u, rc * azN);
						PipeBarrier<PIPE_V>();
						LocalTensor<half> output = oQue.AllocTensor<half>();
						Cast(output, u, RoundMode::CAST_NONE, rc * azN);
						oQue.EnQue(output);
						output = oQue.DeQue<half>();
						DataCopyExtParams op{static_cast<uint16_t>(rc), static_cast<uint32_t>(curN * 2), 0,
																 static_cast<uint32_t>((n - curN) * 2), 0};
						DataCopyPad(yGm[(rowBase + row) * n + colBase], output, op);
						oQue.FreeTensor(output);
					}
				}
				sQue.FreeTensor(s);
			}
		}
		epochs.End(subIdx);
	}
}
template <bool FULL_A_ONCE = true, bool EARLY_PRIME = false, bool BATCH_MTE1 = true, bool LAST_CLEAR = true>
__aicore__ inline void ExpertRun(GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR g, GM_ADDR y, GM_ADDR ws, int64_t m,
																 int64_t k, int64_t n, int64_t e, int64_t capacity) {
	constexpr int TM = 176, TN = 128;
	const int64_t partK = CeilDiv(CeilDiv(k, 4), 128) * 128;
	// Shape-only conservative capacity: actual GL may use fewer tiles.
	const int64_t maxTasks = (CeilDiv(m, TM) + e - 1) * CeilDiv(n, TN);
	const int64_t cBytes = (CeilDiv(n, TN) * TN + GetBlockNum() * 8) * 4 + maxTasks * TM * TN * 4;
	// Eligibility depends only on shape and hardware/storage capacity, not GL.
	const bool eligible = m > 0 && n > 0 && e > 0 && e <= 128 && n <= 2048 && GetBlockNum() % 4 == 0 &&
												partK <= 2048 && k > 3 * partK && k <= 65535 && cBytes <= capacity &&
												maxTasks < 16777216;
	if (!eligible) {
		WidePaddedASplitRun<256, 128, 16, 4>(x, w, s, g, y, ws, m, k, n, e, 4);
		return;
	}
	int32_t ends[128], active, maxRows;
	CollectGroups(g, e, ends, active, maxRows);
	NZWaveRun<TN, TM, 608, 160, false, false, false, 16, 4, false, FULL_A_ONCE, EARLY_PRIME, BATCH_MTE1,
						LAST_CLEAR>(x, w, s, g, y, ws, m, k, n, e, 4, ends, k);
}

} // namespace os_i2_nz176
__global__ __mix__(1, 2)
		__attribute__((aligned(64))) void bk500(GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR g, GM_ADDR y, GM_ADDR ws,
																						int64_t m, int64_t k, int64_t n, int64_t e) {
	os_i2_nz176::ExpertRun<true, false, true>(
			x, w, s, g, y, ws, m, k, n, e,
			((m + 255) / 256 + e - 1) * ((n + 127) / 128) * 4 * 256 * 128 * 4 + m * ((k + 31) / 32 * 32));
}
namespace main_pad_ab_scale_cache {
using namespace AscendC;

__aicore__ inline void GeluInplace(const AscendC::LocalTensor<float> &z, const AscendC::LocalTensor<float> &u,
																	 int32_t count) {
	using namespace AscendC;
	Mul(u, z, z, count);
	Muls(u, u, -0.07135481627260026f, count);
	Adds(u, u, -1.5957691216057308f, count);
	Mul(u, u, z, count);
	Exp(u, u, count);
	Adds(u, u, 1.0f, count);
	Div(u, z, u, count);
}

template <int TM, int TN, bool CHUNKED, bool M_MAJOR, bool ONE_INIT, int READY_SPAN, int B_LAYOUT>
__aicore__ inline void CopyAB(const LocalTensor<int8_t> &a, const LocalTensor<int8_t> &b,
															const GlobalTensor<int8_t> &x, const GlobalTensor<int8_t> &w, int64_t row,
															int64_t rows, int64_t rawK, int64_t k, int64_t pitch, int64_t ei, int64_t col,
															int64_t cols, bool copyB, int bank, bool RAW_B) {
	if (rawK % 32 != 0) {
		if constexpr (M_MAJOR) {
			if constexpr (ONE_INIT) {
				LocalTensor<int8_t> tail = a[(rawK / 32) * 512];
				InitConstValue(tail.ReinterpretCast<uint16_t>(),
											 InitConstValueParams<uint16_t>{static_cast<uint16_t>(TM / 16), 16,
																											static_cast<uint16_t>((16 * k - 512) / 32), 0});
			} else {
				for (int mi16 = 0; mi16 < TM / 16; ++mi16) {
					LocalTensor<int8_t> tail = a[mi16 * 16 * k + (rawK / 32) * 512];
					InitConstValue(tail.ReinterpretCast<uint16_t>(), InitConstValueParams<uint16_t>{1, 16, 0, 0});
				}
			}
		} else {
			LocalTensor<int8_t> tail = a[(rawK / 32) * 32 * TM];
			InitConstValue(tail.ReinterpretCast<uint16_t>(), InitConstValueParams<uint16_t>{1, TM, 0, 0});
		}
		PipeBarrier<PIPE_MTE2>();
	}
	const int64_t span = CHUNKED ? READY_SPAN : k;
	for (int64_t copyK = 0; copyK < k; copyK += span) {
		const int64_t ck = rawK - copyK < span ? rawK - copyK : span;
		if (copyB) {
			if (B_LAYOUT == 4 && !RAW_B) {
				const int64_t np = (cols + 31) / 32 * 32;
				DataCopyParams p;
				p.blockCount = static_cast<uint16_t>((ck + 31) / 32);
				p.blockLen = static_cast<uint16_t>(np);
				p.srcStride = static_cast<uint16_t>(pitch - np);
				p.dstStride = static_cast<uint16_t>(TN - np);
				DataCopy(b[copyK * TN], w[ei * k * pitch + copyK * pitch + col * 32], p);
			} else if (B_LAYOUT != 0 && !RAW_B) {
				DataCopyParams p;
				p.blockCount = static_cast<uint16_t>((cols + 31) / 32);
				p.blockLen = static_cast<uint16_t>(ck);
				p.srcStride = static_cast<uint16_t>(k - ck);
				p.dstStride = static_cast<uint16_t>(k - ck);
				DataCopy(b[copyK * 32], w[(ei * pitch + col) * k + copyK * 32], p);
			} else {
				Nd2NzParams bp;
				bp.ndNum = 1;
				bp.nValue = ck;
				bp.dValue = cols;
				bp.srcNdMatrixStride = 0;
				bp.srcDValue = pitch;
				bp.dstNzC0Stride = k;
				bp.dstNzNStride = 1;
				bp.dstNzMatrixStride = 0;
				DataCopy(b[copyK * 32], w[(ei * (RAW_B ? rawK : k) + copyK) * pitch + col], bp);
			}
		}
		if constexpr (M_MAJOR) {
			Nd2NzParams ap;
			ap.ndNum = rows / 16;
			ap.nValue = 16;
			ap.dValue = ck;
			ap.srcNdMatrixStride = 16 * rawK;
			ap.srcDValue = rawK;
			ap.dstNzC0Stride = 16;
			ap.dstNzNStride = 1;
			ap.dstNzMatrixStride = 16 * k;
			if (rows >= 16)
				DataCopy(a[copyK * 16], x[row * rawK + copyK], ap);
			if (rows % 16) {
				ap.ndNum = 1;
				ap.nValue = rows % 16;
				ap.srcNdMatrixStride = 0;
				ap.dstNzMatrixStride = 0;
				DataCopy(a[(rows / 16) * 16 * k + copyK * 16], x[(row + (rows / 16) * 16) * rawK + copyK], ap);
			}
		} else {
			Nd2NzParams ap;
			ap.ndNum = 1;
			ap.nValue = rows;
			ap.dValue = ck;
			ap.srcNdMatrixStride = 0;
			ap.srcDValue = rawK;
			ap.dstNzC0Stride = TM;
			ap.dstNzNStride = 1;
			ap.dstNzMatrixStride = 0;
			DataCopy(a[copyK * TM], x[row * rawK + copyK], ap);
		}
		SetFlag<HardEvent::MTE2_MTE1>(static_cast<event_t>(bank + 2 * (copyK / span)));
	}
}

template <bool CACHE_B, int TM, int TN, int COPY_K, bool CACHE_SCALE>
__aicore__ inline void ComputeTile(GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR group_list, GM_ADDR y,
																	 GM_ADDR workspace, int64_t m, int64_t runtimeK, int64_t n, int64_t e,
																	 int64_t fixedSlabs, int64_t bPitch) {
	constexpr int READY_SPAN = 256;
	constexpr bool PREFETCH_C = true;
	constexpr int C_SLOTS = 1;
	constexpr int B_MODE = 2, B_LAYOUT = 4, N_PACK = 2;
	static_assert(TM % 16 == 0 && TN % 32 == 0 && CACHE_B && CACHE_SCALE, "native I4 launcher resources");
	constexpr int KC = (TN > 256 ? 64 : 128), ABANKS = 2, SLOTS = C_SLOTS;
	constexpr bool PREFETCH_A = true, CHUNKED = true, EARLY_CREDIT = false;
	constexpr bool M_MAJOR = false, K_LOOP = false, ONE_INIT = false, LOAD3D = true, MANUAL_CONFIG = true;
	static_assert(SLOTS == 1 || SLOTS == 2 || SLOTS == 4, "power-of-two C ring");
	constexpr bool STAGE_A = false;
	bool STAGE_B = true;
	static_assert(ABANKS == 1 || ABANKS == 2, "A bank count");
	static_assert(2 * TM * KC <= 64 * 1024 && 2 * KC * TN <= 64 * 1024, "L0A/B capacity");
	static_assert(TM * TN * 4 <= 128 * 1024, "L0C capacity");
	const int64_t k = ((runtimeK + 31) / 32) * 32;
	using Cfg = gmm_tiles::Config<TM, TN>;
	using MM = typename Cfg::MM;
	constexpr int TILE_M = TM, TILE_N = TN;
	constexpr int VEC_CHUNK_M = TM / 4;
	static_assert(!PREFETCH_C || TM / 2 <= 2 * VEC_CHUNK_M, "two C input banks cover one subcore tile");
	static_assert(18 * VEC_CHUNK_M * TN + 4 * TN <= 192 * 1024, "UBbudget");
	constexpr uint16_t GMM_SYNC_AIV_AIC = 3, GMM_SYNC_AIC_AIV = 5;
	constexpr uint64_t SYNC_MODE2 = 2;
	using namespace gmm_common;
	using namespace AscendC;
	const uint32_t coreNum = static_cast<uint32_t>(GetBlockNum());
	const uint32_t coreIdx = CoreGroupIndex();
	const uint32_t subIdx = SubCoreIndex();
	GlobalTensor<int8_t> xGm;
	GlobalTensor<int8_t> wGm;
	GlobalTensor<float> scaleGm;
	GlobalTensor<int64_t> glGm;
	GlobalTensor<int32_t> cGm;
	GlobalTensor<half> yGm;
	const int64_t cWorkspaceBytes = static_cast<int64_t>(coreNum) * SLOTS * TILE_M * TILE_N * 4;
	GlobalTensor<int8_t> xOriginal;
	xOriginal.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t *>(x), m * runtimeK);
	{
		xGm.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t *>(x), m * runtimeK);
	}
	wGm.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t *>(weight), e * runtimeK * n);
	GlobalTensor<int8_t> wStagedGm;
	scaleGm.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(scale), e * n);
	glGm.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t *>(group_list), e);
	cGm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t *>(workspace),
											static_cast<int64_t>(coreNum) * SLOTS * TILE_M * TILE_N);
	yGm.SetGlobalBuffer(reinterpret_cast<__gm__ half *>(y), m * n);
	int64_t activeExperts[128], activeCount = 0;
	int64_t groupEnds[128];
	int64_t tileEnds[128];
	int64_t totalMTiles = 0, arithmeticMTiles = 0;
	int64_t previousEnd = 0;
	uint64_t rowSquareSum = 0;
	if (fixedSlabs && bPitch == n) {
		totalMTiles = CeilDiv(m, fixedSlabs);
	} else {
		for (int64_t expert = 0; expert < e; ++expert) {
			const int64_t end = glGm.GetValue(expert);
			if (end > previousEnd)
				activeExperts[activeCount++] = expert;
			if (expert < 128)
				groupEnds[expert] = end;
			rowSquareSum += static_cast<uint64_t>(end - previousEnd) * static_cast<uint64_t>(end - previousEnd);
			totalMTiles += CeilDiv(end - previousEnd, TILE_M);
			arithmeticMTiles += CeilDiv(end - previousEnd, 128);
			if (expert < 128)
				tileEnds[expert] = totalMTiles;
			previousEnd = end;
		}
	}
	if (fixedSlabs)
		totalMTiles = CeilDiv(m, fixedSlabs);
	const int64_t N_TILES = (n + TILE_N - 1) / TILE_N;
	const bool enoughRawPanels = static_cast<uint64_t>(m) * static_cast<uint64_t>(m) * N_TILES >=
															 static_cast<uint64_t>(coreNum) * rowSquareSum;
	STAGE_B = B_MODE == 0 || (B_MODE == 2 && !enoughRawPanels);
	if (STAGE_B)
		wStagedGm.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t *>(workspace) + cWorkspaceBytes, e * k * bPitch);
	else
		wStagedGm.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t *>(weight), e * runtimeK * n);
	const bool useWorkAssign = CeilDiv(totalMTiles, static_cast<int64_t>(coreNum)) * N_TILES <=
														 CeilDiv(totalMTiles * N_TILES, static_cast<int64_t>(coreNum));
	const int64_t totalTasks = useWorkAssign ? totalMTiles : totalMTiles * N_TILES;
	const int64_t totalCTiles = totalMTiles * N_TILES;
	if (fixedSlabs || k % 128 != 0 || k > 1024 || arithmeticMTiles < 2 * activeCount ||
			arithmeticMTiles * CeilDiv(n, 256) < 2 * coreNum || (ABANKS * TM + TN) * k > 512 * 1024) {
		main_pad_ab::Compute<128, 256>(x, weight, scale, group_list, y, workspace, m, runtimeK, n, e, fixedSlabs,
																	 bPitch);
		return;
	}
	if ASCEND_IS_AIC {
		if (STAGE_A || STAGE_B)
			SyncAll<false>();
		static_assert(!LOAD3D || !M_MAJOR, "Load3D NC1HWC0 aliases K32-major NZ only");
		{
			const uint8_t pads[4] = {0, 0, 0, 0};
			SetFmatrix(1, TM, pads, FmatrixMode::FMATRIX_LEFT);
		}
		LocalTensor<int8_t> aAll(TPosition::A1, 0, ABANKS * TM * k), b1(TPosition::B1, ABANKS * TM * k, TN * k);
		LocalTensor<int8_t> a2(TPosition::A2, 0, 2 * TM * KC), b2(TPosition::B2, 0, 2 * KC * TN);
		LocalTensor<int32_t> c1(TPosition::CO1, 0, TM * TN);
		int64_t iter = 0, slot = 0, mmaOrdinal = 0, rowOrdinal = 0, bundleBase = 0;
		bool aPending[2] = {false, false}, bPending = false, cPending = false;
		const int64_t coreBegin = totalCTiles * coreIdx / coreNum,
									coreEnd = totalCTiles * (coreIdx + 1) / coreNum;
		for (int active = 0; active < activeCount; ++active) {
			const int ei = activeExperts[active];
			const int64_t start = ei ? groupEnds[ei - 1] : 0, me = groupEnds[ei] - start, MT = CeilDiv(me, TM);
			for (int64_t ni = 0; ni < N_TILES; ++ni) {
				const int64_t miBegin = coreBegin > bundleBase ? coreBegin - bundleBase : 0;
				const int64_t endLimit = coreEnd - bundleBase, miEnd = endLimit < MT ? endLimit : MT;
				bundleBase += MT;
				if (miEnd <= 0 || miBegin >= miEnd)
					continue;
				const int64_t colBase = ni * TN, curN = n - colBase < TN ? n - colBase : TN;
				for (int64_t mi = miBegin; mi < miEnd; ++mi) {
					const int64_t rowBase = start + mi * TM, curM = me - mi * TM < TM ? me - mi * TM : TM;
					const int aBank = rowOrdinal % ABANKS;
					LocalTensor<int8_t> a1 = aAll[aBank * TM * k];
					if (mi == miBegin || !PREFETCH_A) {
						if (aPending[aBank]) {
							WaitFlag<HardEvent::MTE1_MTE2>(static_cast<event_t>(aBank));
							aPending[aBank] = false;
						}
						if (mi == miBegin && bPending) {
							WaitFlag<HardEvent::MTE1_MTE2>(2);
							bPending = false;
						}
						CopyAB<TM, TN, CHUNKED, M_MAJOR, ONE_INIT, READY_SPAN, B_LAYOUT>(
								a1, b1, xGm, wStagedGm, rowBase, curM, runtimeK, k, (STAGE_B ? bPitch : n), ei, colBase, curN,
								mi == miBegin, aBank, !STAGE_B);
					}
					WaitFlag<HardEvent::MTE2_MTE1>(static_cast<event_t>(aBank));
					{
						if (mi + 1 < miEnd) {
							const int nextBank = aBank ^ 1;
							if (aPending[nextBank]) {
								WaitFlag<HardEvent::MTE1_MTE2>(static_cast<event_t>(nextBank));
								aPending[nextBank] = false;
							}
							const int64_t nextRow = start + (mi + 1) * TM,
														nextM = me - (mi + 1) * TM < TM ? me - (mi + 1) * TM : TM;
							CopyAB<TM, TN, CHUNKED, M_MAJOR, ONE_INIT, READY_SPAN, B_LAYOUT>(
									aAll[nextBank * TM * k], b1, xGm, wStagedGm, nextRow, nextM, runtimeK, k,
									(STAGE_B ? bPitch : n), ei, colBase, curN, false, nextBank, !STAGE_B);
						}
					}
					for (int64_t kb = 0; kb < k; kb += KC) {
						{
							if (kb > 0 && kb % READY_SPAN == 0)
								WaitFlag<HardEvent::MTE2_MTE1>(static_cast<event_t>(aBank + 2 * (kb / READY_SPAN)));
						}
						const int64_t ck = k - kb < KC ? k - kb : KC;
						const int bank = mmaOrdinal & 1;
						const event_t freeEvent = static_cast<event_t>(bank);
						if (mmaOrdinal >= 2)
							WaitFlag<HardEvent::M_MTE1>(freeEvent);
						LocalTensor<int8_t> aa2 = a2[bank * TM * KC], bb2 = b2[bank * KC * TN];
						{
							{
								LoadData3DParamsV2Pro lda;
								lda.channelSize = k;
								lda.extConfig = (static_cast<uint64_t>(kb) << 32) | (static_cast<uint64_t>(TM) << 16) |
																static_cast<uint64_t>(ck);
								LoadData(aa2, a1, lda);
							}
						}
						if (B_LAYOUT == 4 && STAGE_B) {
							LoadData2DParams p;
							p.startIndex = 0;
							p.repeatTimes = static_cast<uint8_t>(ck * TN / 512);
							p.srcStride = 1;
							p.dstGap = 0;
							p.ifTranspose = false;
							p.addrMode = 0;
							LoadData(bb2, b1[kb * TN], p);
						} else {
							LoadData2dTransposeParams ldb;
							ldb.startIndex = 0;
							ldb.repeatTimes = TN / 32;
							ldb.srcStride = k / 32;
							ldb.dstGap = 1;
							ldb.dstFracGap = 0;
							ldb.addrMode = 0;
							for (int ki32 = 0; ki32 < ck / 32; ++ki32)
								LoadDataWithTranspose(bb2[ki32 * 32 * TN], b1[(kb / 32 + ki32) * 1024], ldb);
						}
						if (kb + ck == k) {
							SetFlag<HardEvent::MTE1_MTE2>(static_cast<event_t>(aBank));
							aPending[aBank] = true;
							if (mi + 1 == miEnd) {
								SetFlag<HardEvent::MTE1_MTE2>(2);
								bPending = true;
							}
							{
							}
						}
						SetFlag<HardEvent::MTE1_M>(0);
						WaitFlag<HardEvent::MTE1_M>(0);
						if (kb == 0 && cPending) {
							WaitFlag<HardEvent::FIX_M>(0);
							cPending = false;
						}
						MmadParams mm;
						mm.m = TM;
						mm.n = TN;
						mm.k = ck;
						mm.cmatrixSource = false;
						mm.cmatrixInitVal = kb == 0;
						mm.unitFlag = 0;
						Mmad(c1, aa2, bb2, mm);
						SetFlag<HardEvent::M_MTE1>(freeEvent);
						++mmaOrdinal;
					}
					SetFlag<HardEvent::M_FIX>(0);
					WaitFlag<HardEvent::M_FIX>(0);
					if (iter >= SLOTS)
						CrossCoreWaitFlag(GMM_SYNC_AIV_AIC);
					FixpipeParamsV220 fp;
					fp.nSize = TN;
					fp.mSize = curM;
					fp.srcStride = TM;
					fp.dstStride = TN;
					fp.reluEn = false;
					fp.quantPre = QuantMode_t::NoQuant;
					fp.unitFlag = 0;
					Fixpipe<int32_t, int32_t, CFG_ROW_MAJOR>(cGm[(coreIdx * SLOTS + slot) * TM * TN], c1, fp);
					SetFlag<HardEvent::FIX_M>(0);
					cPending = true;
					CrossCoreSetFlag<SYNC_MODE2, PIPE_FIX>(GMM_SYNC_AIC_AIV);
					slot = (slot + 1) & (SLOTS - 1);
					++iter;
					++rowOrdinal;
				}
			}
		}
		if (mmaOrdinal > 0) {
			WaitFlag<HardEvent::M_MTE1>(0);
			if (mmaOrdinal > 1)
				WaitFlag<HardEvent::M_MTE1>(1);
		}
		for (int bank = 0; bank < ABANKS; ++bank)
			if (aPending[bank])
				WaitFlag<HardEvent::MTE1_MTE2>(static_cast<event_t>(bank));
		if (bPending)
			WaitFlag<HardEvent::MTE1_MTE2>(2);
		if (cPending)
			WaitFlag<HardEvent::FIX_M>(0);
	} else {
		TPipe pipe;
		if (STAGE_A || STAGE_B) {
			constexpr int64_t STAGE_BYTES = B_LAYOUT == 4 ? 32 * TN * N_PACK : (B_LAYOUT == 3 ? 32768 : 65536);
			static_assert(B_LAYOUT != 4 || 4 * STAGE_BYTES <= 128 * 1024, "B producer UB capacity");
			TBuf<TPosition::VECCALC> stageBuf;
			pipe.InitBuffer(stageBuf, (B_LAYOUT >= 3 ? 4 : 2) * STAGE_BYTES);
			LocalTensor<int8_t> copy = stageBuf.Get<int8_t>();
			const event_t loads[2] = {
					static_cast<event_t>(B_LAYOUT >= 3 ? pipe.AllocEventID<HardEvent::MTE2_V>()
																						 : pipe.AllocEventID<HardEvent::MTE2_MTE3>()),
					static_cast<event_t>(B_LAYOUT >= 3 ? pipe.AllocEventID<HardEvent::MTE2_V>()
																						 : pipe.AllocEventID<HardEvent::MTE2_MTE3>())};
			const event_t stores[2] = {static_cast<event_t>(pipe.AllocEventID<HardEvent::MTE3_MTE2>()),
																 static_cast<event_t>(pipe.AllocEventID<HardEvent::MTE3_MTE2>())};
			event_t packedReady[2] = {static_cast<event_t>(0), static_cast<event_t>(0)};
			{
				packedReady[0] = static_cast<event_t>(pipe.AllocEventID<HardEvent::V_MTE3>());
				packedReady[1] = static_cast<event_t>(pipe.AllocEventID<HardEvent::V_MTE3>());
			}
			event_t zeroReady[2] = {static_cast<event_t>(0), static_cast<event_t>(0)};
			{
				zeroReady[0] = static_cast<event_t>(pipe.AllocEventID<HardEvent::V_MTE2>());
				zeroReady[1] = static_cast<event_t>(pipe.AllocEventID<HardEvent::V_MTE2>());
			}
			SetFlag<HardEvent::MTE3_MTE2>(stores[0]);
			SetFlag<HardEvent::MTE3_MTE2>(stores[1]);
			const int64_t aivNum = coreNum * GetTaskRation(), aivIdx = GetBlockIdx();
			int stage = 0;
			if (STAGE_B) {
				{
					const int64_t kBlocks = k / 32, nBlocks = CeilDiv(n, TN * N_PACK);
					const int64_t tasks = activeCount * kBlocks * nBlocks;
					for (int64_t task = aivIdx; task < tasks; task += aivNum) {
						const int64_t active = task / (kBlocks * nBlocks);
						const int64_t kb = (task / nBlocks) % kBlocks * 32, nb = task % nBlocks;
						const int64_t expert = activeExperts[active], col = nb * TN * N_PACK;
						const int64_t rows = runtimeK - kb < 32 ? runtimeK - kb : 32;
						const int64_t cols = n - col < TN * N_PACK ? n - col : TN * N_PACK, np = (cols + 31) / 32 * 32;
						LocalTensor<int8_t> buffer = copy[stage * STAGE_BYTES];
						LocalTensor<int8_t> packed = copy[(2 + stage) * STAGE_BYTES];
						WaitFlag<HardEvent::MTE3_MTE2>(stores[stage]);
						if (rows < 32) {
							Duplicate(buffer.ReinterpretCast<int16_t>(), static_cast<int16_t>(0), STAGE_BYTES / 2);
							SetFlag<HardEvent::V_MTE2>(zeroReady[stage]);
							WaitFlag<HardEvent::V_MTE2>(zeroReady[stage]);
						}
						DataCopyExtParams load{static_cast<uint16_t>(rows), static_cast<uint32_t>(cols),
																	 static_cast<uint32_t>(n - cols),
																	 static_cast<uint32_t>((TN * N_PACK - np) / 32), 0};
						DataCopyPadExtParams<int8_t> pad{true, 0, 0, 0};
						DataCopyPad(buffer, wGm[(expert * runtimeK + kb) * n + col], load, pad);
						SetFlag<HardEvent::MTE2_V>(loads[stage]);
						WaitFlag<HardEvent::MTE2_V>(loads[stage]);
#pragma unroll
						for (int kh = 0; kh < 2; ++kh) {
#pragma unroll
							for (int nh = 0; nh < 2; ++nh) {
								uint64_t src[16], dst[16];
#pragma unroll
								for (int i = 0; i < 16; ++i) {
									src[i] = reinterpret_cast<uint64_t>(buffer[(kh * 16 + i) * TN * N_PACK].GetPhyAddr());
									dst[i] = reinterpret_cast<uint64_t>(packed[(nh * 16 + i) * 32].GetPhyAddr());
								}
								TransDataTo5HDParams p;
								p.dstHighHalf = kh != 0;
								p.srcHighHalf = nh != 0;
								p.repeatTimes = static_cast<uint8_t>(np / 32);
								p.dstRepStride = np == 32 ? 0 : 32;
								p.srcRepStride = np == 32 ? 0 : 1;
								TransDataTo5HD<int8_t>(dst, src, p);
								PipeBarrier<PIPE_V>();
							}
						}
						SetFlag<HardEvent::V_MTE3>(packedReady[stage]);
						WaitFlag<HardEvent::V_MTE3>(packedReady[stage]);
						DataCopyExtParams store{1, static_cast<uint32_t>(np * 32), 0, 0, 0};
						DataCopyPad(wStagedGm[expert * k * bPitch + kb * bPitch + col * 32], packed, store);
						SetFlag<HardEvent::MTE3_MTE2>(stores[stage]);
						stage ^= 1;
					}
					WaitFlag<HardEvent::MTE3_MTE2>(stores[0]);
					WaitFlag<HardEvent::MTE3_MTE2>(stores[1]);
				}
			}
			{
			}
			{
				pipe.ReleaseEventID<HardEvent::MTE2_V>(loads[0]);
				pipe.ReleaseEventID<HardEvent::MTE2_V>(loads[1]);
				pipe.ReleaseEventID<HardEvent::V_MTE3>(packedReady[0]);
				pipe.ReleaseEventID<HardEvent::V_MTE3>(packedReady[1]);
			}
			{
				pipe.ReleaseEventID<HardEvent::V_MTE2>(zeroReady[0]);
				pipe.ReleaseEventID<HardEvent::V_MTE2>(zeroReady[1]);
			}
			pipe.ReleaseEventID<HardEvent::MTE3_MTE2>(stores[0]);
			pipe.ReleaseEventID<HardEvent::MTE3_MTE2>(stores[1]);
			pipe.Reset();
			SyncAll<false>();
		}
		TQue<TPosition::VECIN, 2> cQue;
		TQue<TPosition::VECIN, 1> sQue;
		TBuf<TPosition::VECCALC> uBuf;
		constexpr uint32_t CHUNK_ELEMS = VEC_CHUNK_M * TILE_N;
		pipe.InitBuffer(cQue, 2, CHUNK_ELEMS * sizeof(int32_t));
		pipe.InitBuffer(sQue, 1, TILE_N * sizeof(float));
		pipe.InitBuffer(uBuf, CHUNK_ELEMS * sizeof(float));
		LocalTensor<float> u = uBuf.Get<float>();
		const event_t outReady = static_cast<event_t>(pipe.AllocEventID<HardEvent::V_MTE3>());
		const event_t outRetired = static_cast<event_t>(pipe.AllocEventID<HardEvent::MTE3_V>());
		bool hasPendingOutput = false;
		LocalTensor<int32_t> pendingOutputC;
		int64_t iter = 0;
		int64_t slot = 0;
		const int64_t coreTileBegin = totalCTiles * coreIdx / coreNum;
		const int64_t coreTileEnd = totalCTiles * (coreIdx + 1) / coreNum;
		int64_t bundleTileBase = 0;
		for (int activeIndex = 0; activeIndex < activeCount; ++activeIndex) {
			const int ei = activeExperts[activeIndex];
			const int64_t start = ei ? groupEnds[ei - 1] : 0, me = groupEnds[ei] - start;
			const int64_t groupTiles = CeilDiv(me, TM);
			for (int64_t ni = 0; ni < N_TILES; ++ni) {
				const int64_t miBegin = coreTileBegin > bundleTileBase ? coreTileBegin - bundleTileBase : 0;
				const int64_t endLimit = coreTileEnd - bundleTileBase;
				const int64_t miEnd = endLimit < groupTiles ? endLimit : groupTiles;
				bundleTileBase += groupTiles;
				if (miEnd <= 0 || miBegin >= miEnd)
					continue;
				const int64_t colBase = ni * TN, curN = n - colBase < TN ? n - colBase : TN;
				LocalTensor<float> s;
				for (int64_t mi = miBegin; mi < miEnd; ++mi) {
					const int64_t rowBase = start + mi * TM, curM = me - mi * TM < TM ? me - mi * TM : TM;
					const int64_t tileRowBase = 0;
					const int64_t rowsPerSub = CeilDiv(curM, 2);
					const int64_t subRowBegin = subIdx * rowsPerSub;
					const int64_t subRowEnd =
							(subRowBegin < curM) ? ((subRowBegin + rowsPerSub < curM) ? subRowBegin + rowsPerSub : curM)
																	 : subRowBegin;
					const int64_t validN = ((colBase + curN) <= n) ? curN : (n - colBase);
					const bool seqC = false;
					if (!CACHE_SCALE || mi == miBegin) {
						s = sQue.AllocTensor<float>();
						DataCopyExtParams sp;
						sp.blockCount = 1;
						sp.blockLen = validN * sizeof(float);
						sp.srcStride = 0;
						sp.dstStride = 0;
						DataCopyPadExtParams<float> spad;
						spad.isPad = true;
						spad.leftPadding = 0;
						spad.rightPadding = 0;
						spad.paddingValue = 0;
						DataCopyPad(s, scaleGm[ei * n + colBase], sp, spad);
						sQue.EnQue(s);
					}
					bool creditSent = false;
					CrossCoreWaitFlag(GMM_SYNC_AIC_AIV);
					const int64_t cSlotBase = (static_cast<int64_t>(coreIdx) * SLOTS + slot) * TILE_M * TILE_N;
					if (subRowBegin < subRowEnd) {
						if (!CACHE_SCALE || mi == miBegin) {
							s = sQue.DeQue<float>();
							PipeBarrier<PIPE_V>();
						}
						const int64_t alignedN = ((validN + 7) / 8) * 8;
						const int64_t alignedHalfN = ((validN + 15) / 16) * 16;
						const int64_t smStride = ((validN % 16) == 0) ? validN : alignedHalfN;
						const int64_t smRows =
								((subRowEnd - subRowBegin) < VEC_CHUNK_M) ? (subRowEnd - subRowBegin) : VEC_CHUNK_M;
						{
							if (hasPendingOutput) {
								WaitFlag<HardEvent::MTE3_V>(outRetired);
								cQue.FreeTensor(pendingOutputC);
								hasPendingOutput = false;
							}
							for (int64_t preRow = subRowBegin; preRow < subRowEnd; preRow += VEC_CHUNK_M) {
								const int64_t preRows = subRowEnd - preRow < VEC_CHUNK_M ? subRowEnd - preRow : VEC_CHUNK_M;
								LocalTensor<int32_t> prefetched = cQue.AllocTensor<int32_t>();
								DataCopyExtParams cp{static_cast<uint16_t>(preRows),
																		 static_cast<uint32_t>(validN * sizeof(int32_t)),
																		 static_cast<uint32_t>((TILE_N - validN) * sizeof(int32_t)), 0, 0};
								DataCopyPadExtParams<int32_t> cpad{true, 0, 0, 0};
								DataCopyPad(prefetched, cGm[cSlotBase + preRow * TILE_N], cp, cpad);
								cQue.EnQue(prefetched);
							}
							CrossCoreSetFlag<SYNC_MODE2, PIPE_MTE2>(GMM_SYNC_AIV_AIC);
							creditSent = true;
						}
						for (int64_t row = subRowBegin; row < subRowEnd; row += VEC_CHUNK_M) {
							const int64_t rc = (row + VEC_CHUNK_M < subRowEnd) ? VEC_CHUNK_M : (subRowEnd - row);
							const int64_t total = rc * validN;
							const int64_t globalRow = rowBase + tileRowBase + row;
							if ((validN % 16) == 0) {
								LocalTensor<int32_t> c;
								{
								}
								c = cQue.DeQue<int32_t>();
								LocalTensor<float> z = c.ReinterpretCast<float>();
								{
								}
								Cast(z, c, RoundMode::CAST_NONE, static_cast<int32_t>(total));
								PipeBarrier<PIPE_V>();
								PipeBarrier<PIPE_V>();
								BinaryRepeatParams bc(1, 1, 1, static_cast<uint8_t>(smStride / 8),
																			static_cast<uint8_t>(smStride / 8), 0);
								for (int64_t col = 0; col < smStride; col += 64) {
									const uint64_t mask = smStride - col < 64 ? smStride - col : 64;
									Mul(z[col], z[col], s[col], mask, static_cast<uint8_t>(rc), bc);
								}
								GeluInplace(z, u, static_cast<int32_t>(total));
								PipeBarrier<PIPE_V>();
								PipeBarrier<PIPE_V>();
								if (hasPendingOutput) {
									WaitFlag<HardEvent::MTE3_V>(outRetired);
									cQue.FreeTensor(pendingOutputC);
									hasPendingOutput = false;
								}
								LocalTensor<half> o = c.ReinterpretCast<half>();
								Cast(o, u, RoundMode::CAST_NONE, static_cast<int32_t>(total));
								DataCopyExtParams op;
								op.blockCount = static_cast<uint32_t>(rc);
								op.blockLen = validN * sizeof(half);
								op.srcStride = 0;
								op.dstStride = (n - validN) * sizeof(half);
								SetFlag<HardEvent::V_MTE3>(outReady);
								WaitFlag<HardEvent::V_MTE3>(outReady);
								DataCopyPad(yGm[globalRow * n + colBase], o, op);
								SetFlag<HardEvent::MTE3_V>(outRetired);
								pendingOutputC = c;
								hasPendingOutput = true;
							} else {
								const int64_t azN = alignedHalfN;
								LocalTensor<int32_t> c;
								{
								}
								c = cQue.DeQue<int32_t>();
								LocalTensor<float> z = c.ReinterpretCast<float>();
								{
								}
								Cast(z, c, RoundMode::CAST_NONE, static_cast<int32_t>(rc * azN));
								PipeBarrier<PIPE_V>();
								PipeBarrier<PIPE_V>();
								BinaryRepeatParams bc(1, 1, 1, static_cast<uint8_t>(smStride / 8),
																			static_cast<uint8_t>(smStride / 8), 0);
								for (int64_t col = 0; col < smStride; col += 64) {
									const uint64_t mask = smStride - col < 64 ? smStride - col : 64;
									Mul(z[col], z[col], s[col], mask, static_cast<uint8_t>(rc), bc);
								}
								GeluInplace(z, u, static_cast<int32_t>(rc * azN));
								PipeBarrier<PIPE_V>();
								PipeBarrier<PIPE_V>();
								if (hasPendingOutput) {
									WaitFlag<HardEvent::MTE3_V>(outRetired);
									cQue.FreeTensor(pendingOutputC);
									hasPendingOutput = false;
								}
								LocalTensor<half> o = c.ReinterpretCast<half>();
								Cast(o, u, RoundMode::CAST_NONE, static_cast<int32_t>(rc * azN));
								DataCopyExtParams op;
								op.blockCount = static_cast<uint16_t>(rc);
								op.blockLen = validN * sizeof(half);
								op.srcStride = 0;
								op.dstStride = (n - validN) * sizeof(half);
								SetFlag<HardEvent::V_MTE3>(outReady);
								WaitFlag<HardEvent::V_MTE3>(outReady);
								DataCopyPad(yGm[globalRow * n + colBase], o, op);
								SetFlag<HardEvent::MTE3_V>(outRetired);
								pendingOutputC = c;
								hasPendingOutput = true;
							}
						}
						if (!CACHE_SCALE || mi + 1 == miEnd)
							sQue.FreeTensor(s);
					} else {
						if (!CACHE_SCALE || mi == miBegin)
							s = sQue.DeQue<float>();
						if (!CACHE_SCALE || mi + 1 == miEnd)
							sQue.FreeTensor(s);
					}
					if (!creditSent)
						CrossCoreSetFlag<SYNC_MODE2, PIPE_MTE2>(GMM_SYNC_AIV_AIC);
					slot = (slot + 1) & (SLOTS - 1);
					++iter;
				}
			}
		}
		if (hasPendingOutput) {
			WaitFlag<HardEvent::MTE3_V>(outRetired);
			cQue.FreeTensor(pendingOutputC);
			hasPendingOutput = false;
		}
		pipe.ReleaseEventID<HardEvent::V_MTE3>(outReady);
		pipe.ReleaseEventID<HardEvent::MTE3_V>(outRetired);
	}
}

template <bool CACHE_B, int TM, int TN, int COPY_K, bool CACHE_SCALE>
__aicore__ inline void Compute(GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR group_list, GM_ADDR y,
															 GM_ADDR workspace, int64_t m, int64_t runtimeK, int64_t n, int64_t e,
															 int64_t fixedSlabs, int64_t bPitch) {
	static_assert(TM == 128 && TN == 256 && CACHE_B && CACHE_SCALE, "existing I4 launcher resources");
	ComputeTile<CACHE_B, 64, 384, COPY_K, CACHE_SCALE>(x, weight, scale, group_list, y, workspace, m, runtimeK,
																										 n, e, fixedSlabs, bPitch);
}

} // namespace main_pad_ab_scale_cache
__global__ __mix__(1, 2)
		__attribute__((aligned(64))) void bk128(GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR g, GM_ADDR y, GM_ADDR ws,
																						int64_t m, int64_t k, int64_t n, int64_t e, int64_t bPitch) {
	main_pad_ab_scale_cache::Compute<true, 128, 256, 256, true>(x, w, s, g, y, ws, m, k, n, e, 0, bPitch);
}
namespace main_small_compact_rows32 {
using namespace AscendC;

constexpr int32_t CAP_C0 = 32;

__aicore__ inline void GeluCount(const LocalTensor<float> &z, const LocalTensor<float> &u, int32_t count) {
	SetMaskCount();
	SetVectorMask<float, MaskMode::COUNTER>(0, static_cast<uint64_t>(count));
	const BinaryRepeatParams bp{1, 1, 1, 8, 8, 8};
	const UnaryRepeatParams up{1, 1, 8, 8};
	Mul<float, false>(u, z, z, uint64_t(64), 1, bp);
	Muls<float, false>(u, u, -0.07135481627260026f, uint64_t(64), 1, up);
	Adds<float, false>(u, u, -1.5957691216057308f, uint64_t(64), 1, up);
	Mul<float, false>(u, u, z, uint64_t(64), 1, bp);
	Exp<float, false>(u, u, uint64_t(64), 1, up);
	Adds<float, false>(u, u, 1.0f, uint64_t(64), 1, up);
	Div<float, false>(u, z, u, uint64_t(64), 1, bp);
	SetMaskNorm();
	ResetMask();
}

template <int REDUCE_K, int COLS, int ROWS, bool K_MAJOR, bool MERGE_B, bool HALF_C, bool OUTPUT_C, int MAX_N,
					bool CLEAN>
__aicore__ inline void RunStatic(GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR group_list, GM_ADDR y,
																 GM_ADDR workspace, int64_t runtimeM, int64_t runtimeK, int64_t runtimeN,
																 int64_t e) {
	constexpr int64_t m = ROWS, k = REDUCE_K, n = (COLS > MAX_N && COLS % MAX_N == 0 ? MAX_N : COLS);
	constexpr int32_t CAP_M = ROWS, CAP_K = REDUCE_K, CAP_N = n;
	constexpr int32_t CAP_CHUNK = (ROWS / 2) * n;
	static_assert(!HALF_C && !OUTPUT_C, "strict FP32 order: INT32 C in workspace");
	using CT = std::conditional_t<HALF_C, half, int32_t>;
	static_assert(!HALF_C || ROWS <= 32, "one scale compensation per subcore");
	static_assert(!OUTPUT_C || HALF_C, "output holds one half per result");
	constexpr int64_t NT = COLS / n;
	const int64_t core = gmm_common::CoreGroupIndex();
	const int64_t rowStart = (core / NT) * m, nStart = (core % NT) * n;
	const uint32_t subIdx = static_cast<uint32_t>(GetSubBlockIdx());
	GlobalTensor<int8_t> xGm;
	GlobalTensor<int8_t> wGm;
	GlobalTensor<float> scaleGm;
	GlobalTensor<CT> cGm;
	GlobalTensor<half> yGm;
	xGm.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t *>(x), runtimeM * k);
	wGm.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t *>(weight), k * COLS);
	scaleGm.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(scale), COLS);
	if constexpr (OUTPUT_C)
		cGm.SetGlobalBuffer(reinterpret_cast<__gm__ CT *>(y), runtimeM * COLS);
	else
		cGm.SetGlobalBuffer(reinterpret_cast<__gm__ CT *>(workspace), runtimeM * COLS);
	yGm.SetGlobalBuffer(reinterpret_cast<__gm__ half *>(y), runtimeM * COLS);
	if ASCEND_IS_AIC {
		LocalTensor<int8_t> a1(TPosition::A1, 0, CAP_M * CAP_K);
		LocalTensor<int8_t> b1(TPosition::B1, CAP_M * CAP_K, CAP_K * CAP_N);
		LocalTensor<int8_t> a2(TPosition::A2, 0, CAP_M * CAP_K);
		LocalTensor<int8_t> b2(TPosition::B2, 0, CAP_K * CAP_N);
		LocalTensor<int32_t> c1(TPosition::CO1, 0, CAP_M * CAP_N);
		Nd2NzParams pa;
		pa.ndNum = m / 16;
		pa.nValue = 16;
		pa.dValue = k;
		pa.srcNdMatrixStride = 16 * k;
		pa.srcDValue = k;
		pa.dstNzC0Stride = 16;
		pa.dstNzNStride = 1;
		pa.dstNzMatrixStride = 16 * k;
		DataCopy(a1, xGm[rowStart * k], pa);
		Nd2NzParams pb;
		pb.ndNum = 1;
		pb.nValue = k;
		pb.dValue = n;
		pb.srcNdMatrixStride = 0;
		pb.srcDValue = COLS;
		pb.dstNzC0Stride = k;
		pb.dstNzNStride = 1;
		pb.dstNzMatrixStride = 0;
		if constexpr (K_MAJOR) {
			pb.ndNum = k / CAP_C0;
			pb.nValue = CAP_C0;
			pb.srcNdMatrixStride = CAP_C0 * COLS;
			pb.dstNzC0Stride = CAP_C0;
			pb.dstNzMatrixStride = CAP_C0 * n;
		}
		DataCopy(b1, wGm[nStart], pb);
		SetFlag<HardEvent::MTE2_MTE1>(0);
		WaitFlag<HardEvent::MTE2_MTE1>(0);
		LoadData2DParams lda;
		lda.startIndex = 0;
		lda.repeatTimes = static_cast<uint8_t>((m / 16) * (k / 32));
		lda.srcStride = 1;
		lda.dstGap = 0;
		lda.ifTranspose = false;
		lda.addrMode = 0;
		LoadData(a2, a1, lda);
		LoadData2dTransposeParams ldb;
		ldb.startIndex = 0;
		ldb.repeatTimes = static_cast<uint8_t>(n / CAP_C0);
		ldb.srcStride = k / CAP_C0;
		ldb.dstGap = 1;
		ldb.dstFracGap = 0;
		ldb.addrMode = 0;
		if constexpr (K_MAJOR) {
			ldb.srcStride = 1;
			if constexpr (MERGE_B) {
				ldb.repeatTimes = static_cast<uint8_t>((k / CAP_C0) * (n / CAP_C0));
				LoadDataWithTranspose(b2, b1, ldb);
			} else {
				for (int32_t i = 0; i < k / CAP_C0; ++i)
					LoadDataWithTranspose(b2[i * 32 * n], b1[i * 32 * n], ldb);
			}
		} else {
			for (int32_t i = 0; i < k / CAP_C0; ++i) {
				LoadDataWithTranspose(b2[i * 32 * n], b1[i * 1024], ldb);
			}
		}
		SetFlag<HardEvent::MTE1_M>(0);
		WaitFlag<HardEvent::MTE1_M>(0);
		MmadParams mp;
		mp.m = m;
		mp.n = n;
		mp.k = k;
		mp.unitFlag = 3;
		mp.cmatrixInitVal = true;
		Mmad(c1, a2, b2, mp);
		SetFlag<HardEvent::M_FIX>(0);
		WaitFlag<HardEvent::M_FIX>(0);
		FixpipeParamsV220 fp;
		fp.nSize = n;
		fp.mSize = m;
		fp.srcStride = m;
		fp.dstStride = COLS;
		fp.reluEn = false;
		if constexpr (HALF_C) {
			fp.quantPre = QuantMode_t::DEQF16;
			fp.deqScalar = 0x3C800000ULL;
		} else
			fp.quantPre = QuantMode_t::NoQuant;
		fp.unitFlag = 3;
		Fixpipe<CT, int32_t, CFG_ROW_MAJOR>(cGm[rowStart * COLS + nStart], c1, fp);
		CrossCoreSetFlag<2, PIPE_FIX>(5);
	} else {
		constexpr uint32_t FLOAT_BYTES = CAP_CHUNK * sizeof(float);
		constexpr uint32_t C_BYTES = CAP_CHUNK * sizeof(CT);
		constexpr uint32_t S_OFF = 4 >= 4 ? FLOAT_BYTES : C_BYTES;
		constexpr uint32_t Z_OFF = S_OFF + CAP_N * sizeof(float);
		constexpr uint32_t U_OFF = 4 >= 4 ? 0 : Z_OFF + FLOAT_BYTES;
		constexpr uint32_t O_OFF = 4 >= 4 ? Z_OFF : U_OFF + FLOAT_BYTES;
		constexpr uint32_t UB_BYTES = 4 >= 4 ? Z_OFF + FLOAT_BYTES : O_OFF + CAP_CHUNK * sizeof(half);
		LocalTensor<uint8_t> ub(TPosition::VECCALC, 0, UB_BYTES);
		LocalTensor<CT> c = ub.ReinterpretCast<CT>();
		LocalTensor<float> s = ub.ReinterpretCast<float>()[S_OFF / 4];
		LocalTensor<float> z = ub.ReinterpretCast<float>()[Z_OFF / 4];
		LocalTensor<float> u = ub.ReinterpretCast<float>()[U_OFF / 4];
		LocalTensor<half> o = ub.ReinterpretCast<half>()[O_OFF / 2];
		const int32_t rowsPerSub = (m + 1) / 2;
		const int32_t subBegin = subIdx * rowsPerSub;
		const int32_t subEnd = subBegin + rowsPerSub < m ? subBegin + rowsPerSub : m;
		const int32_t activeRows = subEnd - subBegin < 16 ? subEnd - subBegin : 16;
		DataCopyExtParams sp;
		sp.blockCount = 1;
		sp.blockLen = n * sizeof(float);
		sp.srcStride = 0;
		sp.dstStride = 0;
		DataCopyPadExtParams<float> spad{false, 0, 0, 0};
		{
			DataCopy(s, scaleGm[nStart], n);
		}
		CrossCoreWaitFlag(5);
		const uint8_t rowStride = static_cast<uint8_t>(n / 8);
		const BinaryRepeatParams broadcast(1, 1, 1, rowStride, rowStride, 0);
		for (int32_t row = subBegin; row < subEnd; row += 16) {
			const int32_t rows = subEnd - row < 16 ? subEnd - row : 16;
			const int32_t count = rows * n;
			if (row > subBegin) {
				SetFlag<HardEvent::V_MTE2>(0);
				WaitFlag<HardEvent::V_MTE2>(0);
			}
			DataCopyExtParams cp;
			cp.blockCount = rows;
			cp.blockLen = n * sizeof(CT);
			cp.srcStride = (COLS - n) * sizeof(CT);
			cp.dstStride = 0;
			DataCopyPadExtParams<CT> cpad{false, 0, 0, 0};
			if constexpr (n == COLS)
				DataCopy(c, cGm[(rowStart + row) * COLS + nStart], count);
			else
				DataCopyPad(c, cGm[(rowStart + row) * COLS + nStart], cp, cpad);
			SetFlag<HardEvent::MTE2_V>(0);
			WaitFlag<HardEvent::MTE2_V>(0);
			Cast(z, c, RoundMode::CAST_NONE, count);
			PipeBarrier<PIPE_V>();
			if constexpr (HALF_C) {
				Muls(s, s, 64.0f, n);
				PipeBarrier<PIPE_V>();
			}
			for (int32_t col = 0; col < n; col += 64) {
				const uint64_t width = n - col < 64 ? n - col : 64;
				Mul(z[col], z[col], s[col], width, static_cast<uint8_t>(rows), broadcast);
			}
			{
				GeluCount(z, u, count);
			}
			PipeBarrier<PIPE_V>();
			Cast(o, u, RoundMode::CAST_NONE, count);
			SetFlag<HardEvent::V_MTE3>(0);
			WaitFlag<HardEvent::V_MTE3>(0);
			DataCopyExtParams op;
			op.blockCount = rows;
			op.blockLen = n * sizeof(half);
			op.srcStride = 0;
			op.dstStride = (COLS - n) * sizeof(half);
			if constexpr (n == COLS)
				DataCopy(yGm[(rowStart + row) * COLS + nStart], o, count);
			else
				DataCopyPad(yGm[(rowStart + row) * COLS + nStart], o, op);
			if constexpr (!CLEAN) {
				SetFlag<HardEvent::MTE3_V>(0);
				WaitFlag<HardEvent::MTE3_V>(0);
			}
		}
		if constexpr (!CLEAN)
			CrossCoreSetFlag<2, PIPE_MTE2>(3);
	}
	PipeBarrier<PIPE_ALL>();
}

template <int REDUCE_K, int COLS, int ROWS>
__global__ __mix__(1, 2)
		__attribute__((aligned(64))) void bk0(GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR group_list,
																					GM_ADDR y, GM_ADDR workspace, int64_t runtimeM, int64_t runtimeK,
																					int64_t runtimeN, int64_t e) {
	RunStatic<REDUCE_K, COLS, ROWS, true, true, false, false, 128, true>(
			x, weight, scale, group_list, y, workspace, runtimeM, runtimeK, runtimeN, e);
}

}
namespace os_pipeline_843 {
using namespace AscendC;

using os_i3_resident::CoreGroupIndex;

using os_i3_resident::SubCoreIndex;

using os_i3_resident::CeilDiv;

using os_i3_resident::GeluComputeSigmoid;

__aicore__ inline bool PackedAdmit(int64_t k, int64_t n, int64_t e) {
	return k > 0 && k <= 1056 && n > 0 && n <= 1056 && e > 0 && e <= 128;
}

template <int TM, int MIN_TILES>
__aicore__ inline int Select(GM_ADDR groups, int64_t e, int64_t k, int64_t n, int32_t *selected,
														 int32_t *slots) {
	static_assert(MIN_TILES >= 2, "ReuseAmortizesPacking");
	GlobalTensor<int64_t> gl;
	gl.SetGlobalBuffer((__gm__ int64_t *)groups, e);
	const int64_t bytes = CeilDiv(k, 32) * 32 * CeilDiv(n, 32) * 32;
	const int cap = bytes > 0 ? (2097152 / bytes < e ? 2097152 / bytes : e) : 0;
	int32_t weights[128];
	int count = 0;
	int64_t previous = 0;
	for (int ei = 0; ei < e; ++ei) {
		slots[ei] = -1;
		const int64_t end = gl.GetValue(ei), tiles = CeilDiv(end - previous, TM);
		previous = end;
		if (tiles < MIN_TILES || cap == 0)
			continue;
		int pos = count;
		while (pos > 0 && weights[pos - 1] < tiles)
			--pos;
		if (pos >= cap)
			continue;
		const int stop = count < cap ? count : cap - 1;
		for (int j = stop; j > pos; --j) {
			weights[j] = weights[j - 1];
			selected[j] = selected[j - 1];
		}
		weights[pos] = tiles;
		selected[pos] = ei;
		if (count < cap)
			++count;
	}
	for (int rank = 0; rank < count; ++rank)
		slots[selected[rank]] = rank;
	return count;
}

__aicore__ inline GlobalTensor<int8_t> BView(GlobalTensor<int8_t> original, GlobalTensor<int8_t> packed,
																						 int slot, int64_t expert, int64_t col, int64_t k, int64_t n,
																						 int64_t kp, int64_t np) {
	return slot >= 0 ? packed[int64_t(slot) * kp * np + col * kp] : original[expert * k * n + col];
}

template <int TM, int TN, int MAX_K = 1152, bool L1_BARRIER = true, bool SHAPE_BARRIER = true,
					bool COMPACT_B = false, bool COMPACT_A = false, bool EARLY_PREFETCH = false, int K_STEP = 128,
					int B_DEPTH = 2, int B_HEAD = 0, bool NEXT_A = false, bool SELECTIVE_B = false>
struct FullBResidentMmad {
	static_assert(TM % 16 == 0 && TN % 32 == 0, "INT8 tile alignment");
	static_assert(MAX_K * (TM + B_DEPTH * TN) <= 512 * 1024, "Resident A plus two full B L1 panels");
	static_assert(K_STEP % 32 == 0 && TM * K_STEP <= 32 * 1024 && TN * K_STEP <= 32 * 1024, "Two L0 slots fit");
	static_assert(TM * TN * 4 <= 128 * 1024, "L0C fits");
	TBuf<TPosition::A1> a1b;
	TBuf<TPosition::B1> b1b;
	TBuf<TPosition::A2> a0b;
	TBuf<TPosition::B2> b0b;
	TBuf<TPosition::CO1> cb;
	bool pendingFix = false, pendingA = false, packedReady = false;
	__aicore__ inline void EnsurePacked() {
		if constexpr (SELECTIVE_B) {
			if (!packedReady) {
				CrossCoreWaitFlag(7);
				packedReady = true;
			}
		}
	}
	int64_t ma = 0, curM = 0, curN = 0, layoutM = TM;
	__aicore__ inline void Init(TPipe &pipe) {
		pipe.InitBuffer(a1b, TM * MAX_K);
		pipe.InitBuffer(b1b, B_DEPTH * TN * MAX_K);
		pipe.InitBuffer(a0b, 64 * 1024);
		pipe.InitBuffer(b0b, 64 * 1024);
		pipe.InitBuffer(cb, TM * TN * 4);
		const uint8_t pad[4] = {0, 0, 0, 0};
		SetFmatrix(1, TM, pad, FmatrixMode::FMATRIX_LEFT);
		SetFlag<HardEvent::MTE1_MTE2>(2);
		if constexpr (B_DEPTH == 2 || B_HEAD > 0)
			SetFlag<HardEvent::MTE1_MTE2>(3);
		SetFlag<HardEvent::MTE1_MTE2>(4);
	}
	__aicore__ inline void QueueB(GlobalTensor<int8_t> w, int64_t k, int64_t n, int64_t physicalN,
																int64_t sequence) {
		const int64_t bPitch = COMPACT_B ? CeilDiv(k, 32) * 32 : MAX_K;
		const auto event = static_cast<event_t>(2 + (B_DEPTH == 1 ? 0 : (sequence & 1)));
		WaitFlag<HardEvent::MTE1_MTE2>(event);
		if constexpr (B_HEAD > 0)
			WaitFlag<HardEvent::MTE1_MTE2>(3);
		Nd2NzParams bp{1,
									 static_cast<uint16_t>(k),
									 static_cast<uint16_t>(n),
									 0,
									 static_cast<uint16_t>(physicalN),
									 static_cast<uint16_t>(bPitch),
									 1,
									 0};
		if (SELECTIVE_B && physicalN < 0) {
			EnsurePacked();
			DataCopy(b1b.Get<int8_t>()[(B_DEPTH == 1 ? 0 : (sequence & 1)) * bPitch * TN], w,
							 CeilDiv(k, 32) * 32 * CeilDiv(n, 32) * 32);
		} else {
			DataCopy(b1b.Get<int8_t>()[(B_DEPTH == 1 ? 0 : (sequence & 1)) * bPitch * TN], w, bp);
		}
		SetFlag<HardEvent::MTE2_MTE1>(event);
		if constexpr (B_HEAD > 0)
			SetFlag<HardEvent::MTE2_MTE1>(3);
	}
	__aicore__ inline void QueueBHead(GlobalTensor<int8_t> w, int64_t k, int64_t n, int64_t physicalN) {
		WaitFlag<HardEvent::MTE1_MTE2>(2);
		const int64_t bPitch = COMPACT_B ? CeilDiv(k, 32) * 32 : MAX_K, head = k < B_HEAD ? k : B_HEAD;
		Nd2NzParams bp{1,
									 static_cast<uint16_t>(head),
									 static_cast<uint16_t>(n),
									 0,
									 static_cast<uint16_t>(physicalN),
									 static_cast<uint16_t>(bPitch),
									 1,
									 0};
		if (SELECTIVE_B && physicalN < 0) {
			EnsurePacked();
			const int64_t kp = CeilDiv(k, 32) * 32, hp = CeilDiv(head, 32) * 32;
			DataCopyParams nz{static_cast<uint16_t>(CeilDiv(n, 32)), static_cast<uint16_t>(hp),
												static_cast<uint16_t>(kp - hp), static_cast<uint16_t>(bPitch - hp)};
			DataCopy(b1b.Get<int8_t>(), w, nz);
		} else {
			DataCopy(b1b.Get<int8_t>(), w, bp);
		}
		SetFlag<HardEvent::MTE2_MTE1>(2);
	}
	__aicore__ inline void QueueBTail(GlobalTensor<int8_t> w, int64_t k, int64_t n, int64_t physicalN) {
		WaitFlag<HardEvent::MTE1_MTE2>(3);
		if (k > B_HEAD) {
			const int64_t bPitch = COMPACT_B ? CeilDiv(k, 32) * 32 : MAX_K;
			Nd2NzParams bp{1,
										 static_cast<uint16_t>(k - B_HEAD),
										 static_cast<uint16_t>(n),
										 0,
										 static_cast<uint16_t>(physicalN),
										 static_cast<uint16_t>(bPitch),
										 1,
										 0};
			if (SELECTIVE_B && physicalN < 0) {
				EnsurePacked();
				const int64_t kp = CeilDiv(k, 32) * 32, tail = kp - B_HEAD;
				DataCopyParams nz{static_cast<uint16_t>(CeilDiv(n, 32)), static_cast<uint16_t>(tail),
													static_cast<uint16_t>(B_HEAD), static_cast<uint16_t>(bPitch - tail)};
				DataCopy(b1b.Get<int8_t>()[B_HEAD * 32], w[B_HEAD * 32], nz);
			} else {
				DataCopy(b1b.Get<int8_t>()[B_HEAD * 32], w[B_HEAD * physicalN], bp);
			}
		}
		SetFlag<HardEvent::MTE2_MTE1>(3);
	}
	__aicore__ inline void QueueNextA(GlobalTensor<int8_t> x, int64_t m, int64_t k, int64_t aPitch) {
		WaitFlag<HardEvent::MTE1_MTE2>(4);
		const int64_t nextMa = (m + 15) / 16 * 16;
		if constexpr (COMPACT_A)
			if (layoutM != nextMa) {
				PipeBarrier<PIPE_MTE1>();
				const uint8_t pad[4] = {0, 0, 0, 0};
				SetFmatrix(1, static_cast<uint16_t>(nextMa), pad, FmatrixMode::FMATRIX_LEFT);
				layoutM = nextMa;
			}
		Nd2NzParams ap{1,
									 static_cast<uint16_t>(m),
									 static_cast<uint16_t>(k),
									 0,
									 static_cast<uint16_t>(aPitch),
									 static_cast<uint16_t>(COMPACT_A ? nextMa : TM),
									 1,
									 0};
		DataCopy(a1b.Get<int8_t>(), x, ap);
		SetFlag<HardEvent::MTE2_MTE1>(4);
		pendingA = true;
	}
	__aicore__ inline void Prepare(GlobalTensor<int8_t> x, int64_t m, int64_t k, int64_t n, int64_t aPitch,
																 bool reuseA, int64_t sequence, bool reuseB = false) {
		if (pendingFix) {
			WaitFlag<HardEvent::FIX_M>(6);
			pendingFix = false;
		}
		if constexpr (SHAPE_BARRIER) {
			if (ma != ((m + 15) / 16 * 16) || curN != n)
				PipeBarrier<PIPE_ALL>();
		}
		ma = (m + 15) / 16 * 16;
		curM = m;
		curN = n;
		bool needsA = true;
		if constexpr (NEXT_A)
			if (pendingA) {
				WaitFlag<HardEvent::MTE2_MTE1>(4);
				pendingA = false;
				needsA = false;
			}
		if (needsA) {
			WaitFlag<HardEvent::MTE1_MTE2>(4);
			if (!reuseA) {
				if constexpr (COMPACT_A) {
					if (layoutM != ma) {
						PipeBarrier<PIPE_MTE1>();
						const uint8_t pad[4] = {0, 0, 0, 0};
						SetFmatrix(1, static_cast<uint16_t>(ma), pad, FmatrixMode::FMATRIX_LEFT);
						layoutM = ma;
					}
				}
				Nd2NzParams ap{1,
											 static_cast<uint16_t>(m),
											 static_cast<uint16_t>(k),
											 0,
											 static_cast<uint16_t>(aPitch),
											 static_cast<uint16_t>(COMPACT_A ? ma : TM),
											 1,
											 0};
				DataCopy(a1b.Get<int8_t>(), x, ap);
				SetFlag<HardEvent::MTE2_MTE1>(4);
				WaitFlag<HardEvent::MTE2_MTE1>(4);
			}
		}
		const int64_t bPitch = COMPACT_B ? CeilDiv(k, 32) * 32 : MAX_K;
		const auto bevent = static_cast<event_t>(2 + (B_DEPTH == 1 ? 0 : (sequence & 1)));
		if (!reuseB)
			WaitFlag<HardEvent::MTE2_MTE1>(bevent);
	}
	__aicore__ inline void RunMmad(int64_t k, int64_t n, int64_t sequence,
																 GlobalTensor<int8_t> nextB = GlobalTensor<int8_t>(), int64_t nextCols = 0,
																 int64_t nextPitch = 0, bool hasNext = false, bool reuseB = false,
																 bool keepB = false) {
		const int64_t bPitch = COMPACT_B ? CeilDiv(k, 32) * 32 : MAX_K;
		const auto bevent = static_cast<event_t>(2 + (B_DEPTH == 1 ? 0 : (sequence & 1)));
		auto a1 = a1b.Get<int8_t>();
		auto b1 = b1b.Get<int8_t>()[(B_DEPTH == 1 ? 0 : (sequence & 1)) * bPitch * TN];
		auto a0 = a0b.Get<int8_t>(), b0 = b0b.Get<int8_t>();
		auto c = cb.Get<int32_t>();
		const int64_t na = ((n + 31) / 32) * 32;
		int64_t step = 0;
		bool headRetired = false, tailReady = B_HEAD == 0 || reuseB;
		if constexpr (B_HEAD > 0)
			if (!reuseB && k <= B_HEAD) {
				WaitFlag<HardEvent::MTE2_MTE1>(3);
				tailReady = true;
			}
		for (int64_t kk = 0; kk < k; kk += K_STEP, ++step) {
			if constexpr (B_HEAD > 0)
				if (!tailReady && kk >= B_HEAD) {
					WaitFlag<HardEvent::MTE2_MTE1>(3);
					tailReady = true;
				}
			const int64_t remaining = ((k - kk + 31) / 32) * 32;
			const int64_t madK = remaining < K_STEP ? remaining : K_STEP;
			const auto event = static_cast<event_t>(step & 1);
			WaitFlag<HardEvent::M_MTE1>(event);
			auto av = a0[(step & 1) * 32 * 1024], bv = b0[(step & 1) * 32 * 1024];
			LoadData3DParamsV2Pro la;
			la.channelSize = MAX_K;
			la.extConfig = (uint64_t(kk) << 32) | (uint64_t(ma) << 16) | uint64_t(madK);
			la.enTranspose = false;
			LoadData(av, a1, la);
			if constexpr (L1_BARRIER)
				PipeBarrier<PIPE_MTE1>();
			LoadData2dTransposeParams lb;
			lb.startIndex = 0;
			lb.repeatTimes = na / 32;
			lb.srcStride = bPitch / 32;
			lb.dstGap = 1;
			lb.dstFracGap = 0;
			lb.addrMode = 0;
			for (int ki = 0; ki < madK / 32; ++ki) {
				LoadDataWithTranspose(bv[ki * 32 * na], b1[(kk + ki * 32) * 32], lb);
				if constexpr (L1_BARRIER)
					PipeBarrier<PIPE_MTE1>();
			}
			if constexpr (B_HEAD > 0) {
				if (!keepB && !headRetired && (kk + madK >= B_HEAD || kk + madK >= k)) {
					SetFlag<HardEvent::MTE1_MTE2>(2);
					headRetired = true;
					if (hasNext)
						QueueBHead(nextB, k, nextCols, nextPitch);
				}
			}
			SetFlag<HardEvent::MTE1_M>(event);
			WaitFlag<HardEvent::MTE1_M>(event);
			MmadParams mp;
			mp.m = ma;
			mp.n = na;
			mp.k = madK;
			mp.unitFlag = 0;
			mp.cmatrixInitVal = step == 0;
			Mmad(c, av, bv, mp);
			if ((ma / 16) * (na / 16) < 10)
				PipeBarrier<PIPE_M>();
			SetFlag<HardEvent::M_MTE1>(event);
		}
		SetFlag<HardEvent::MTE1_MTE2>(4);
		if (!keepB) {
			if constexpr (B_HEAD > 0)
				SetFlag<HardEvent::MTE1_MTE2>(3);
			else
				SetFlag<HardEvent::MTE1_MTE2>(bevent);
		}
		SetFlag<HardEvent::M_FIX>(6);
		if constexpr (B_DEPTH == 2)
			WaitFlag<HardEvent::M_FIX>(6);
	}
	__aicore__ inline void Compute(GlobalTensor<int8_t> x, int64_t m, int64_t k, int64_t n, int64_t aPitch,
																 bool reuseA, int64_t sequence) {
		Prepare(x, m, k, n, aPitch, reuseA, sequence);
		RunMmad(k, n, sequence);
	}
	__aicore__ inline void Store(GlobalTensor<int32_t> dst) {
		if constexpr (B_DEPTH == 1)
			WaitFlag<HardEvent::M_FIX>(6);
		FixpipeParamsV220 fp;
		fp.nSize = curN;
		fp.mSize = curM;
		fp.srcStride = ma;
		fp.dstStride = TN;
		fp.reluEn = false;
		fp.quantPre = QuantMode_t::NoQuant;
		fp.unitFlag = 0;
		Fixpipe<int32_t, int32_t, CFG_ROW_MAJOR>(dst, cb.Get<int32_t>(), fp);
		SetFlag<HardEvent::FIX_M>(6);
		pendingFix = true;
	}
	__aicore__ inline void End() {
		EnsurePacked();
		if (pendingFix)
			WaitFlag<HardEvent::FIX_M>(6);
		WaitFlag<HardEvent::MTE1_MTE2>(2);
		if constexpr (B_DEPTH == 2 || B_HEAD > 0)
			WaitFlag<HardEvent::MTE1_MTE2>(3);
		WaitFlag<HardEvent::MTE1_MTE2>(4);
	}
};

struct FullBPanel {
	int64_t mt, expert, row, col, rows, cols;
};

template <int TM, int TN>
__aicore__ inline FullBPanel DecodeFullBPanel(int64_t panel, int64_t nt, int64_t n, int64_t e,
																							const int32_t *gl, const int32_t *prefix) {
	FullBPanel p;
	p.mt = panel / nt;
	p.col = (panel % nt) * TN;
	int lo = 0, hi = e;
	while (lo < hi) {
		int mid = (lo + hi) / 2;
		if (prefix[mid] <= p.mt)
			lo = mid + 1;
		else
			hi = mid;
	}
	p.expert = lo;
	const int64_t start = lo ? gl[lo - 1] : 0;
	const int64_t mi = p.mt - (lo ? prefix[lo - 1] : 0), remaining = gl[lo] - start - mi * TM;
	p.row = start + mi * TM;
	p.rows = remaining < TM ? remaining : TM;
	p.cols = n - p.col < TN ? n - p.col : TN;
	return p;
}

template <int TM, int TN, int ORDER> __aicore__ inline bool NOuter(int64_t rows, int64_t n, bool packed) {
	const int64_t mt = CeilDiv(rows, TM), nt = CeilDiv(n, TN);
	if constexpr (ORDER == 0)
		return false;
	if constexpr (ORDER == 2)
		return mt > 1;
	return int64_t(packed ? 1 : 4) * n * (mt - 1) > (nt - 1) * rows;
}

template <int TM, int TN, int ORDER>
__aicore__ inline auto LeaseDecode(int64_t panel, int64_t nt, int64_t n, int64_t e, const int32_t *gl,
																	 const int32_t *prefix, const int32_t *slots) {
	auto p = DecodeFullBPanel<TM, TN>(panel, nt, n, e, gl, prefix);
	const int ei = p.expert;
	const int64_t base = ei ? prefix[ei - 1] : 0, start = ei ? gl[ei - 1] : 0;
	const int64_t rows = gl[ei] - start, mt = prefix[ei] - base, offset = panel - base * nt;
	if (NOuter<TM, TN, ORDER>(rows, n, slots[ei] >= 0)) {
		const int64_t mi = offset % mt;
		p.mt = base + mi;
		p.row = start + mi * TM;
		p.rows = rows - mi * TM < TM ? rows - mi * TM : TM;
		p.col = (offset / mt) * TN;
		p.cols = n - p.col < TN ? n - p.col : TN;
	}
	return p;
}

template <int TM, int TN, int ORDER>
__aicore__ inline int64_t LeasePrefix(int64_t t, int64_t rows, int64_t n, bool packed, int factor) {
	const int64_t mt = CeilDiv(rows, TM), nt = CeilDiv(n, TN), np = CeilDiv(n, 32) * 32;
	const int64_t base = 64 * (packed ? 1 : factor);
	if (t == mt * nt)
		return np * (mt * base + CeilDiv(rows, 16) * 16);
	if (NOuter<TM, TN, ORDER>(rows, n, packed)) {
		const int64_t ni = t / mt, mi = t % mt, na = np - ni * TN < TN ? np - ni * TN : TN;
		return ni * TN * (mt * base + CeilDiv(rows, 16) * 16) + na * mi * (base + TM);
	}
	const int64_t mi = t / nt, ni = t % nt, ma = rows - mi * TM < TM ? CeilDiv(rows - mi * TM, 16) * 16 : TM;
	return mi * (base + TM) * np + ni * TN * (base + ma);
}

template <int TM, int TN, int ORDER>
__aicore__ inline int64_t LeaseCut(const int32_t *gl, const int32_t *prefix, const int32_t *slots,
																	 const int64_t *costs, int64_t e, int64_t n, int64_t target, int factor) {
	const int64_t nt = CeilDiv(n, TN);
	if (target <= 0)
		return 0;
	if (target >= costs[e - 1])
		return int64_t(prefix[e - 1]) * nt;
	int lo = 0, hi = e;
	while (lo < hi) {
		int mid = (lo + hi) / 2;
		if (costs[mid] < target)
			lo = mid + 1;
		else
			hi = mid;
	}
	const int ei = lo;
	const int64_t first = ei ? prefix[ei - 1] : 0, rows = gl[ei] - (ei ? gl[ei - 1] : 0);
	const int64_t wanted = target - (ei ? costs[ei - 1] : 0);
	int64_t l = 0, r = (prefix[ei] - first) * nt;
	while (l < r) {
		int64_t mid = (l + r) / 2;
		if (LeasePrefix<TM, TN, ORDER>(mid, rows, n, slots[ei] >= 0, factor) < wanted)
			l = mid + 1;
		else
			r = mid;
	}
	return first * nt + l;
}

template <int TM, int TN, int VC = 32, bool PREFETCH = true, int MAX_K = 1152, bool L1_BARRIER = true,
					bool SHAPE_BARRIER = true, bool COMPACT_B = false, bool COMPACT_A = false,
					bool EARLY_PREFETCH = false, int K_STEP = 128, bool INPLACE_C = false, int B_DEPTH = 2,
					int B_HEAD = 0, bool NEXT_A = false, bool SELECTIVE_B = false>
__aicore__ inline void NativeFullBRun(GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR group_list, GM_ADDR y,
																			GM_ADDR workspace, int64_t m, int64_t k, int64_t n, int64_t e,
																			GM_ADDR packed = nullptr, const int32_t *slots = nullptr,
																			int count = 0) {
	static_assert(!PREFETCH && B_DEPTH == 1 && B_HEAD > 0 && NEXT_A, "StripedNextABackend");
	constexpr int ND_FACTOR = 4;
	static_assert(B_HEAD == 0 || (B_DEPTH == 1 && B_HEAD % K_STEP == 0 && B_HEAD < MAX_K), "DisjointKStripes");
	static_assert(!NEXT_A || (B_DEPTH == 1 && B_HEAD > 0), "NextARequiresStripedB");
	static_assert(B_DEPTH == 1 || B_DEPTH == 2, "OneOrTwoBSlots");
	static_assert(B_DEPTH == 2 || !PREFETCH, "SingleBPrefetchAfterLastReader");
	constexpr uint16_t READY = 5, CREDIT = 3;
	constexpr uint64_t SYNC_MODE2 = 2;
	const int64_t cores = GetBlockNum(), core = CoreGroupIndex(), sub = SubCoreIndex();
	GlobalTensor<int8_t> xGm, wGm, pGm;
	GlobalTensor<float> scaleGm;
	GlobalTensor<int64_t> glGm;
	GlobalTensor<int32_t> cGm;
	GlobalTensor<half> yGm;
	xGm.SetGlobalBuffer((__gm__ int8_t *)x, m * k);
	wGm.SetGlobalBuffer((__gm__ int8_t *)weight, e * k * n);
	const int64_t kp = CeilDiv(k, 32) * 32, np = CeilDiv(n, 32) * 32;
	if constexpr (SELECTIVE_B) {
		pGm.SetGlobalBuffer((__gm__ int8_t *)packed, int64_t(count) * kp * np);
	}
	scaleGm.SetGlobalBuffer((__gm__ float *)scale, e * n);
	glGm.SetGlobalBuffer((__gm__ int64_t *)group_list, e);
	yGm.SetGlobalBuffer((__gm__ half *)y, m * n);
	int32_t gl[128], prefix[128];
	int64_t costs[128];
	int64_t totalCost = 0, totalMTiles = 0, previous = 0, maxRows = 0;
	for (int ei = 0; ei < e; ++ei) {
		const int64_t end = glGm.GetValue(ei);
		gl[ei] = end;
		const int64_t rows = end - previous;
		if (rows > maxRows)
			maxRows = rows;
		if constexpr (SELECTIVE_B) {
			const int64_t base = 64 * (slots[ei] >= 0 ? 1 : ND_FACTOR), full = rows / TM, tail = rows % TM;
			totalCost += (full * (base + TM) + (tail ? base + CeilDiv(tail, 16) * 16 : 0)) * np;
			costs[ei] = totalCost;
		}
		totalMTiles += CeilDiv(rows, TM);
		prefix[ei] = totalMTiles;
		previous = end;
	}
	const int64_t capacity = CeilDiv(maxRows < TM ? maxRows : TM, 16) * 16;
	const int64_t nt = CeilDiv(n, TN), panels = totalMTiles * nt, ringPrefix = nt * TN;
	const int64_t first = (SELECTIVE_B ? LeaseCut<TM, TN, 2>(gl, prefix, slots, costs, e, n,
																													 totalCost * core / cores, ND_FACTOR)
																		 : panels * core / cores),
								last = (SELECTIVE_B ? LeaseCut<TM, TN, 2>(gl, prefix, slots, costs, e, n,
																													totalCost * (core + 1) / cores, ND_FACTOR)
																		: panels * (core + 1) / cores);
	cGm.SetGlobalBuffer((__gm__ int32_t *)workspace, ringPrefix + cores * 2 * capacity * TN);
	TPipe pipe;
	if ASCEND_IS_AIC {
		FullBResidentMmad<TM, TN, MAX_K, L1_BARRIER, SHAPE_BARRIER, COMPACT_B, COMPACT_A, EARLY_PREFETCH, K_STEP,
											B_DEPTH, B_HEAD, NEXT_A, SELECTIVE_B>
				mm;
		mm.Init(pipe);
		if constexpr (SELECTIVE_B) {
			if (first < last) {
				const auto initial = (SELECTIVE_B ? LeaseDecode<TM, TN, 2>(first, nt, n, e, gl, prefix, slots)
																					: DecodeFullBPanel<TM, TN>(first, nt, n, e, gl, prefix));
				mm.QueueNextA(xGm[initial.row * k], initial.rows, k, k);
			}
		}
		if (first < last) {
			auto p = (SELECTIVE_B ? LeaseDecode<TM, TN, 2>(first, nt, n, e, gl, prefix, slots)
														: DecodeFullBPanel<TM, TN>(first, nt, n, e, gl, prefix));
			mm.QueueB((SELECTIVE_B ? BView(wGm, pGm, slots[p.expert], p.expert, p.col, k, n, kp, np)
														 : wGm[p.expert * k * n + p.col]),
								k, p.cols, (SELECTIVE_B && slots[p.expert] >= 0) ? -n : n, 0);
		}
		int64_t previousMT = -1, previousExpert = -1, previousCol = -1, iter = 0, bEpoch = 0;
		for (int64_t panel = first; panel < last; ++panel, ++iter) {
			const auto p = SELECTIVE_B ? LeaseDecode<TM, TN, 2>(panel, nt, n, e, gl, prefix, slots)
																 : DecodeFullBPanel<TM, TN>(panel, nt, n, e, gl, prefix);
			const bool hasNext = panel + 1 < last;
			const auto next = SELECTIVE_B
														? LeaseDecode<TM, TN, 2>(hasNext ? panel + 1 : panel, nt, n, e, gl, prefix, slots)
														: DecodeFullBPanel<TM, TN>(hasNext ? panel + 1 : panel, nt, n, e, gl, prefix);
			const bool reuseB = SELECTIVE_B && iter > 0 && p.expert == previousExpert && p.col == previousCol;
			if (iter > 0 && !reuseB)
				++bEpoch;
			const bool keepB = SELECTIVE_B && hasNext && next.expert == p.expert && next.col == p.col;
			mm.Prepare(xGm[p.row * k], p.rows, k, p.cols, k, previousMT == p.mt, bEpoch, reuseB);
			mm.RunMmad(k, p.cols, bEpoch,
								 (SELECTIVE_B ? BView(wGm, pGm, slots[next.expert], next.expert, next.col, k, n, kp, np)
															: wGm[next.expert * k * n + next.col]),
								 next.cols, (SELECTIVE_B && slots[next.expert] >= 0) ? -n : n, hasNext && !keepB, reuseB,
								 keepB);
			if (hasNext) {
				if (next.mt != p.mt)
					mm.QueueNextA(xGm[next.row * k], next.rows, k, k);
				if (!keepB)
					mm.QueueBTail((SELECTIVE_B
														 ? BView(wGm, pGm, slots[next.expert], next.expert, next.col, k, n, kp, np)
														 : wGm[next.expert * k * n + next.col]),
												k, next.cols, (SELECTIVE_B && slots[next.expert] >= 0) ? -n : n);
			}
			previousMT = p.mt;
			previousExpert = p.expert;
			previousCol = p.col;
			if (iter >= 2)
				CrossCoreWaitFlag(CREDIT);
			mm.Store(cGm[ringPrefix + (core * 2 + (iter & 1)) * capacity * TN]);
			CrossCoreSetFlag<SYNC_MODE2, PIPE_FIX>(READY);
		}
		for (int64_t i = 0; i < (last - first < 2 ? last - first : 2); ++i)
			CrossCoreWaitFlag(CREDIT);
		mm.End();
	} else {
		TQue<TPosition::VECIN, 1> cQue, sQue;
		TQue<TPosition::VECOUT, 1> oQue;
		TBuf<TPosition::VECCALC> zBuf, uBuf;
		constexpr int CHUNK_ELEMS = VC * TN;
		pipe.InitBuffer(cQue, 1, CHUNK_ELEMS * 4);
		pipe.InitBuffer(sQue, 1, TN * 4);
		pipe.InitBuffer(oQue, 1, CHUNK_ELEMS * 2);
		if constexpr (!INPLACE_C)
			pipe.InitBuffer(zBuf, CHUNK_ELEMS * 4);
		pipe.InitBuffer(uBuf, CHUNK_ELEMS * 4);
		auto z = INPLACE_C ? LocalTensor<float>() : zBuf.Get<float>(), u = uBuf.Get<float>();
		int64_t iter = 0;
		for (int64_t panel = first; panel < last; ++panel, ++iter) {
			const auto p = (SELECTIVE_B ? LeaseDecode<TM, TN, 2>(panel, nt, n, e, gl, prefix, slots)
																	: DecodeFullBPanel<TM, TN>(panel, nt, n, e, gl, prefix));
			const int64_t perSub = (p.rows + 1) / 2, begin = sub * perSub;
			const int64_t end = begin < p.rows ? (begin + perSub < p.rows ? begin + perSub : p.rows) : begin;
			const int64_t azN = CeilDiv(p.cols, 16) * 16, alignedN = CeilDiv(p.cols, 8) * 8;
			auto scales = sQue.AllocTensor<float>();
			DataCopyExtParams sp{1, static_cast<uint32_t>(p.cols * 4), 0, 0, 0};
			DataCopyPadExtParams<float> spad{true, 0, 0, 0};
			DataCopyPad(scales, scaleGm[p.expert * n + p.col], sp, spad);
			sQue.EnQue(scales);
			CrossCoreWaitFlag(READY);
			scales = sQue.DeQue<float>();
			for (int64_t row = begin; row < end; row += VC) {
				const int64_t rc = end - row < VC ? end - row : VC;
				auto c = cQue.AllocTensor<int32_t>();
				DataCopyExtParams cp{static_cast<uint16_t>(rc), static_cast<uint32_t>(p.cols * 4),
														 static_cast<uint32_t>((TN - p.cols) * 4),
														 static_cast<uint32_t>((azN - alignedN) / 8), 0};
				DataCopyPadExtParams<int32_t> cpad{true, 0, 0, 0};
				const int64_t cb = ringPrefix + (core * 2 + (iter & 1)) * capacity * TN + row * TN;
				DataCopyPad(c, cGm[cb], cp, cpad);
				cQue.EnQue(c);
				c = cQue.DeQue<int32_t>();
				if constexpr (INPLACE_C)
					z = c.ReinterpretCast<float>();
				Cast(z, c, RoundMode::CAST_NONE, rc * azN);
				if constexpr (!INPLACE_C)
					cQue.FreeTensor(c);
				PipeBarrier<PIPE_V>();
				BinaryRepeatParams bp{1, 1, 1, static_cast<uint8_t>(azN / 8), static_cast<uint8_t>(azN / 8), 0};
				for (int64_t col = 0; col < azN; col += 64) {
					const uint64_t mask = azN - col < 64 ? azN - col : 64;
					Mul(z[col], z[col], scales[col], mask, static_cast<uint8_t>(rc), bp);
				}
				PipeBarrier<PIPE_V>();
				GeluComputeSigmoid(z, u, rc * azN);
				PipeBarrier<PIPE_V>();
				if constexpr (INPLACE_C)
					cQue.FreeTensor(c);
				auto o = oQue.AllocTensor<half>();
				Cast(o, u, RoundMode::CAST_NONE, rc * azN);
				oQue.EnQue(o);
				o = oQue.DeQue<half>();
				DataCopyExtParams op{static_cast<uint16_t>(rc), static_cast<uint32_t>(p.cols * 2), 0,
														 static_cast<uint32_t>((n - p.cols) * 2), 0};
				DataCopyPad(yGm[(p.row + row) * n + p.col], o, op);
				oQue.FreeTensor(o);
			}
			sQue.FreeTensor(scales);
			CrossCoreSetFlag<SYNC_MODE2, PIPE_MTE2>(CREDIT);
		}
	}
}

template <int PACK_K, int DEPTH, int MAX_N = 1056, bool MIXED = false>
__aicore__ inline void FullRowPack(GM_ADDR weight, GM_ADDR groups, GM_ADDR packed, const int32_t *active,
																	 int64_t count, int64_t m, int64_t k, int64_t n, int64_t e) {
	static_assert(PACK_K % 32 == 0 && PACK_K <= 64, "WholeK32");
	static_assert(2 * DEPTH * PACK_K * MAX_N <= 192 * 1024, "PackUBBudget");
	if (!PackedAdmit(k, n, e))
		return;
	GlobalTensor<int8_t> src, dst;
	src.SetGlobalBuffer((__gm__ int8_t *)weight, e * k * n);
	const int64_t kp = CeilDiv(k, 32) * 32, np = CeilDiv(n, 32) * 32;
	dst.SetGlobalBuffer((__gm__ int8_t *)packed, count * kp * np);
	const int64_t nk = CeilDiv(k, PACK_K), total = count * nk;
	const int64_t packCores = GetBlockNum() * (MIXED ? GetTaskRation() : 1);
	const int64_t first = total * GetBlockIdx() / packCores;
	const int64_t last = total * (GetBlockIdx() + 1) / packCores;
	if (first == last)
		return;
	TPipe pipe;
	TQue<TPosition::VECIN, DEPTH> input;
	TQue<TPosition::VECOUT, 1> output;
	pipe.InitBuffer(input, DEPTH, PACK_K * MAX_N);
	pipe.InitBuffer(output, DEPTH, PACK_K * MAX_N);
	int64_t issued = first;
	for (; issued < last && issued < first + DEPTH; ++issued) {
		const int64_t ei = active[issued / nk], kk = (issued % nk) * PACK_K;
		const int64_t rc = k - kk < PACK_K ? k - kk : PACK_K;
		auto nd = input.template AllocTensor<int8_t>();
		DataCopyExtParams p{static_cast<uint16_t>(rc), static_cast<uint32_t>(n), 0, 0, 0};
		DataCopyPadExtParams<int8_t> pad{true, 0, static_cast<uint8_t>(np - n), 0};
		DataCopyPad(nd, src[ei * k * n + kk * n], p, pad);
		input.EnQue(nd);
	}
	for (int64_t tile = first; tile < last; ++tile) {
		const int64_t ei = active[tile / nk], kk = (tile % nk) * PACK_K;
		const int64_t rc = k - kk < PACK_K ? k - kk : PACK_K, rows = CeilDiv(rc, 32) * 32;
		auto nd = input.template DeQue<int8_t>();
		auto nz = output.AllocTensor<int8_t>();
		if (rows != rc) {
			Duplicate(nz.ReinterpretCast<uint16_t>(), uint16_t(0), rows * np / 2);
			PipeBarrier<PIPE_V>();
		}
		auto in = nd.template ReinterpretCast<uint16_t>(), out = nz.ReinterpretCast<uint16_t>();
		CopyRepeatParams cp{1, static_cast<uint16_t>(np / 32), 8, static_cast<uint16_t>(8 * np / 32)};
		for (int64_t nb = 0; nb < np / 32; ++nb) {
			if (rc >= 8)
				Copy(out[nb * rows * 16], in[nb * 16], uint64_t(128), static_cast<uint8_t>(rc / 8), cp);
			if (rc % 8)
				Copy(out[nb * rows * 16 + (rc / 8) * 128], in[nb * 16 + (rc / 8) * 8 * np / 2],
						 uint64_t((rc % 8) * 16), uint8_t(1), cp);
		}
		input.FreeTensor(nd);
		output.EnQue(nz);
		nz = output.DeQue<int8_t>();
		DataCopyParams p{static_cast<uint16_t>(np / 32), static_cast<uint16_t>(rows), 0,
										 static_cast<uint16_t>(kp - rows)};
		DataCopy(dst[(tile / nk) * kp * np + kk * 32], nz, p);
		output.FreeTensor(nz);
		if (issued < last) {
			const int64_t nextExpert = active[issued / nk], nextK = (issued % nk) * PACK_K;
			const int64_t nextRows = k - nextK < PACK_K ? k - nextK : PACK_K;
			auto next = input.template AllocTensor<int8_t>();
			DataCopyExtParams ip{static_cast<uint16_t>(nextRows), static_cast<uint32_t>(n), 0, 0, 0};
			DataCopyPadExtParams<int8_t> pad{true, 0, static_cast<uint8_t>(np - n), 0};
			DataCopyPad(next, src[nextExpert * k * n + nextK * n], ip, pad);
			input.EnQue(next);
			++issued;
		}
	}
}

}
__global__ __mix__(1, 2)
		__attribute__((aligned(64))) void bk498(GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR g, GM_ADDR y, GM_ADDR ws,
																						int64_t m, int64_t k, int64_t n, int64_t e) {
	if (os_pipeline_843::PackedAdmit(k, n, e) && !(m > 128 && os_tile320_runtime::SingleActive(g, m, e))) {
		int32_t selected[128], slots[128];
		const int count = os_pipeline_843::Select<96, 3>(g, e, k, n, selected, slots);
		if (count) {
			GM_ADDR packed = ws + AscendC::GetBlockNum() * 262144;
			if ASCEND_IS_AIV {
				os_pipeline_843::FullRowPack<32, 2, 1056, true>(w, g, packed, selected, count, m, k, n, e);
				AscendC::SyncAll<true>();
				AscendC::CrossCoreSetFlag<2, PIPE_MTE3>(7);
			}
			os_pipeline_843::NativeFullBRun<96, 320, 32, false, 1056, false, false, true, true, true, 96, true, 1,
																			576, true, true>(x, w, s, g, y, ws, m, k, n, e, packed, slots, count);
			return;
		}
	}
	if (m > 128 && os_tile320_runtime::SingleActive(g, m, e))
		os_tile320_runtime::Run<128, 256, 16>(x, w, s, g, y, ws, m, k, n, e);
	else {
		int64_t p = (n + 319) / 320 * 320, b = AscendC::GetBlockNum();
		if (k > 0 && k <= 1056 && n > 0 && n <= 65535 && e > 0 && e <= 128 && (p + b * 61440) * 4 <= b * 262144)
			os_pipeline_843::NativeFullBRun<96, 320, 32, false, 1056, false, false, true, true, true, 96, true, 1,
																			576, true>(x, w, s, g, y, ws, m, k, n, e);
		else
			os_tile320_runtime::TailRun<96, 320, 16>(x, w, s, g, y, ws, m, k, n, e);
	}
}
#pragma clang diagnostic pop

namespace rg_c1_fp32_config {
template <int TM, int TN> struct Config {
	static_assert(TM * 2048 + TN * (TN > 256 ? 64 : 128) * 8 <= 512 * 1024, "Full A and streaming B fit L1");
	static_assert(TM % 16 == 0 && TN % 32 == 0, "Cube tile alignment");
	static_assert(TM * TN * 4 <= 128 * 1024, "L0C capacity");
	static_assert((TM + TN) * (TN > 256 ? 64 : 128) * 8 <= 512 * 1024, "L1 capacity");
	static_assert(26 * (TN == 512 ? 8 : 16) * TN + 4 * TN <= 192 * 1024, "UB capacity");
	using AType = AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, int8_t, false>;
	using BType = AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, int8_t, false>;
	using CType = AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, int32_t>;
	using BiasType = AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, int32_t>;
	static constexpr int32_t TILE_M = TM;
	static constexpr int32_t TILE_N = TN;
	static constexpr int32_t VEC_CHUNK_M = TN == 512 ? 8 : 16;
	static constexpr uint16_t GMM_SYNC_AIV_AIC = 3;
	static constexpr uint16_t GMM_SYNC_AIC_AIV = 5;
	static constexpr uint64_t SYNC_MODE2 = 2;
	static __aicore__ constexpr MatmulConfig MakeMatmulConfig() {
		MatmulConfig cfg{};
		cfg.doNorm = false;
		cfg.doBasicBlock = false;
		cfg.doMultiDataLoad = true;
		cfg.basicM = TILE_M;
		cfg.basicN = TILE_N;
		cfg.basicK = TN > 256 ? 64 : 128;
		cfg.intrinsicsCheck = false;
		cfg.isNBatch = false;
		cfg.enVecND2NZ = false;
		cfg.doSpecialBasicBlock = false;
		cfg.doMTE2Preload = 0;
		cfg.singleCoreM = TILE_M;
		cfg.singleCoreN = 1024;
		cfg.singleCoreK = 2048;
		cfg.stepM = 0;
		cfg.stepN = 0;
		cfg.baseMN = 0;
		cfg.singleCoreMN = 0;
		cfg.enUnitFlag = true;
		cfg.isPerTensor = false;
		cfg.hasAntiQuantOffset = false;
		cfg.doIBShareNorm = false;
		cfg.doSpecialMDL = false;
		cfg.enableInit = false;
		cfg.batchMode = BatchMode::NONE;
		cfg.enableEnd = true;
		cfg.enableGetTensorC = true;
		cfg.enableSetOrgShape = true;
		cfg.enableSetBias = false;
		cfg.enableSetTail = true;
		cfg.enableQuantVector = false;
		cfg.enableSetDefineData = false;
		cfg.iterateMode = IterateMode::ITERATE_MODE_DEFAULT;
		cfg.enableReuse = true;
		cfg.enableUBReuse = true;
		cfg.enableL1CacheUB = false;
		cfg.intraBlockPartSum = false;
		cfg.iterateOrder = IterateOrder::UNDEF;
		cfg.scheduleType = ScheduleType::INNER_PRODUCT;
		cfg.enableDoubleCache = false;
		cfg.isBiasBatch = true;
		cfg.enableStaticPadZeros = false;
		cfg.isA2B2Shared = false;
		cfg.enableKdimReorderLoad = false;
		cfg.isCO1Shared = false;
		return cfg;
	}
	static __aicore__ constexpr MatmulApiStaticTiling MakeStaticTiling() {
		MatmulApiStaticTiling tiling =
				AscendC::GetMatmulApiTiling<AType, BType, CType, BiasType>(MakeMatmulConfig());
		tiling.depthA1 = 2048 / (TN > 256 ? 64 : 128);
		tiling.depthB1 = 8;
		tiling.stepM = 1;
		tiling.stepN = 1;
		tiling.stepKa = 2048 / (TN > 256 ? 64 : 128);
		tiling.stepKb = 4;
		tiling.dbL0A = 2;
		tiling.dbL0B = 2;
		tiling.dbL0C = 1;
		return tiling;
	}
	constexpr static MatmulApiStaticTiling STATIC_TILING = MakeStaticTiling();
	using MM = AscendC::MatmulImpl<AType, BType, CType, BiasType, STATIC_TILING>;
};

}
__aicore__ inline void RgC1FP32ScaleRows(const AscendC::LocalTensor<float> &z,
																				 const AscendC::LocalTensor<float> &s, int32_t rows, int32_t pitch) {
	using namespace AscendC;
	if (pitch % 64 == 0 && rows >= pitch / 64) {
		BinaryRepeatParams rp;
		rp.dstBlkStride = 1;
		rp.src0BlkStride = 1;
		rp.src1BlkStride = 1;
		rp.dstRepStride = pitch / 8;
		rp.src0RepStride = pitch / 8;
		rp.src1RepStride = 0;
		for (int col = 0; col < pitch; col += 64)
			Mul(z[col], z[col], s[col], uint64_t(64), rows, rp);
	} else {
		for (int row = 0; row < rows; ++row)
			Mul(z[row * pitch], z[row * pitch], s, pitch);
	}
}
__aicore__ inline void RgC1FP32GeluInplace(const AscendC::LocalTensor<float> &z,
																					 const AscendC::LocalTensor<float> &u, int32_t cnt) {
	using namespace AscendC;
	Mul(u, z, z, cnt);
	Muls(u, u, -0.07135481627260026f, cnt);
	Adds(u, u, -1.5957691216057308f, cnt);
	Mul(u, u, z, cnt);
	Exp(u, u, cnt);
	Adds(u, u, 1.0f, cnt);
	Div(u, z, u, cnt);
}
namespace rg_c1_fp32_prefetch {
__aicore__ inline int32_t DivUp32(int32_t a, int32_t b) {
	return (a + b - 1) / b;
}

template <int TM, int TN, int ROW_STEP, int PANELS, int GROUPS = 0, int DEPTH = 0, int VC = 32,
					bool RAW_Y = true, bool ANY_GL = false, bool PREFETCH = false, bool EARLY_CREDIT = false>
__aicore__ inline void Compute(GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR group_list, GM_ADDR y,
															 GM_ADDR workspace, int32_t runtimeM, int32_t runtimeK, int32_t runtimeN,
															 int32_t runtimeE) {
	constexpr bool C1_SINGLE_SLOT =
			(TM == 128 && TN == 256 && ROW_STEP == 128 && DEPTH > 0 && DEPTH <= 1024 && PANELS >= 2);
	constexpr int32_t tightC = C1_SINGLE_SLOT ? 1 : 0, cSlots = C1_SINGLE_SLOT ? 1 : 2,
										earlyCredit = C1_SINGLE_SLOT ? 1 : 0, afterComputeWait = C1_SINGLE_SLOT ? 1 : 0;
	static_assert(ANY_GL && RAW_Y && DEPTH == 1024 && PANELS >= 2 && PANELS <= 4,
								"This production family has no runtime fallback or separate C allocation");
	const int32_t m = GROUPS > 0 ? GROUPS * ROW_STEP : runtimeM;
	const int32_t e = GROUPS > 0 ? GROUPS : runtimeE;
	const int32_t k = DEPTH > 0 ? DEPTH : runtimeK;
	const int32_t n = PANELS > 0 ? PANELS * TN : runtimeN;
	using Cfg = rg_c1_fp32_config::Config<TM, TN>;
	using MM = typename Cfg::MM;
	constexpr int TILE_M = TM, TILE_N = TN, VEC_CHUNK_M = VC;
	static_assert(10 * VC * TN + 4 * TN <= 192 * 1024, "Compact UB capacity");
	constexpr uint16_t GMM_SYNC_AIV_AIC = 3, GMM_SYNC_AIC_AIV = 5;
	constexpr uint32_t SYNC_MODE2 = 2;
	using namespace gmm_common;
	using namespace AscendC;
	const uint32_t coreNum = static_cast<uint32_t>(GetBlockNum());
	const uint32_t coreIdx = CoreGroupIndex();
	const uint32_t subIdx = SubCoreIndex();
	const int32_t nPad = n;
	const int32_t cPitch = nPad / 2;
	GlobalTensor<int8_t> xGm;
	GlobalTensor<int8_t> wGm;
	GlobalTensor<float> scaleGm;
	GlobalTensor<int64_t> glGm;
	GlobalTensor<int32_t> cGm;
	GlobalTensor<int32_t> rawYGm;
	GlobalTensor<half> yGm;
	xGm.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t *>(x), m * k);
	wGm.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t *>(weight), e * k * n);
	scaleGm.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(scale), e * n);
	glGm.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t *>(group_list), e);
	if constexpr (!RAW_Y)
		cGm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t *>(workspace),
												static_cast<int32_t>(coreNum) * TILE_M * cPitch);
	if constexpr (RAW_Y)
		rawYGm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t *>(y), m * n / 2);
	yGm.SetGlobalBuffer(reinterpret_cast<__gm__ half *>(y), m * n);
	TPipe pipe;
	if ASCEND_IS_AIC {
		MM mm;
		mm.SetSubBlockIdx(0);
		mm.Init(static_cast<TCubeTiling *>(nullptr), &pipe);
		int32_t iter = 0;
		int32_t slot = 0;
		const int32_t N_TILES = (n + TILE_N - 1) / TILE_N;
		const int32_t GROUP_TILES = N_TILES <= 3 ? N_TILES : 2;
		const int32_t N_GROUPS = (N_TILES + GROUP_TILES - 1) / GROUP_TILES;
		const int32_t TASKS = ((m + ROW_STEP - 1) / ROW_STEP) * N_GROUPS;
		for (int32_t task = coreIdx; task < TASKS; task += coreNum) {
			const int32_t slab = task / N_GROUPS;
			const int32_t ownedN = (task % N_GROUPS) * GROUP_TILES;
			int32_t start = slab * ROW_STEP;
			const int32_t slabEnd = start + ROW_STEP < m ? start + ROW_STEP : m;
			int32_t ei = slab;
			if (ei >= e)
				ei = e - 1;
			int32_t groupStart = ei == 0 ? 0 : glGm.GetValue(ei - 1);
			int32_t groupEnd = glGm.GetValue(ei);
			if (!(groupStart <= start && start < groupEnd)) {
				int32_t lo = 0, hi = e;
				while (lo < hi) {
					const int32_t mid = (lo + hi) / 2;
					if (glGm.GetValue(mid) <= start)
						lo = mid + 1;
					else
						hi = mid;
				}
				ei = lo;
				groupEnd = glGm.GetValue(ei);
			}
			while (start < slabEnd) {
				const int32_t end = groupEnd < slabEnd ? groupEnd : slabEnd;
				const int32_t me = end - start;
				const int32_t mTiles = DivUp32(me, TILE_M);
				const int32_t nTiles = DivUp32(nPad, TILE_N);
				for (int32_t mi = 0; mi < mTiles; ++mi) {
					const int32_t rowBase = start + mi * TILE_M;
					const int32_t curM = (mi == mTiles - 1) ? (me - mi * TILE_M) : TILE_M;
					const int32_t colBase = ownedN * TILE_N;
					const int32_t groupN =
							nPad - colBase < GROUP_TILES * TILE_N ? nPad - colBase : GROUP_TILES * TILE_N;
					mm.SetOrgShape(me, nPad, k, k, nPad / 2);
					mm.SetSingleShape(curM, groupN, k);
					mm.SetTensorA(xGm[rowBase * k], false);
					mm.SetTensorB(wGm[ei * k * n + colBase], false);
					int32_t rawPanel = 0;
					while (mm.Iterate()) {
						if (iter >= cSlots)
							CrossCoreWaitFlag(GMM_SYNC_AIV_AIC);
						const uint64_t rawOffset = RAW_Y ? static_cast<uint64_t>(rowBase * n + colBase) / 2
																						 : static_cast<uint64_t>(coreIdx) * TILE_M * (n / 2);
						const uint64_t rawBase =
								reinterpret_cast<uint64_t>(RAW_Y ? y : workspace) + rawOffset * sizeof(int32_t);
						const uint64_t compensatedBase =
								rawBase - static_cast<uint64_t>(rawPanel) * TILE_N * sizeof(int32_t);
						GlobalTensor<int32_t> compensated;
						compensated.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t *>(compensatedBase),
																				TILE_M * (n / 2));
						mm.GetTensorC(compensated, 0, false);
						CrossCoreSetFlag<SYNC_MODE2, PIPE_FIX>(GMM_SYNC_AIC_AIV);
						++iter;
						++rawPanel;
					}
				}
				start = end;
				while (start < slabEnd && groupEnd <= start) {
					++ei;
					groupEnd = glGm.GetValue(ei);
				}
			}
		}
	} else {
		static_assert(TM == 128 && TN == 256 && ROW_STEP == 128 && DEPTH == 1024 && VC == (PANELS == 3 ? 16 : 32),
									"Private-Y SDK fixed tile family");
		static_assert(PANELS >= 2 && PANELS <= 4, "Private-Y SDK N family");
		constexpr int32_t MAX_GROUP_TILES = PANELS <= 3 ? PANELS : 2;
		constexpr int32_t CHUNK_ELEMS = VEC_CHUNK_M * TILE_N;
		constexpr int32_t HELD_ELEMS = (TILE_M / 2) * MAX_GROUP_TILES * TILE_N;
		static_assert((PREFETCH ? 3 : 2) * CHUNK_ELEMS * sizeof(float) + HELD_ELEMS * sizeof(half) +
													TILE_N * sizeof(float) <=
											192 * 1024,
									"C input, FP32 work, scale and full private output must fit UB");
		TQue<TPosition::VECIN, (PREFETCH ? 2 : 1)> cQue;
		TQue<TPosition::VECIN, 1> sQue;
		TQue<TPosition::VECOUT, 1> oQue;
		TBuf<TPosition::VECCALC> uBuf;
		pipe.InitBuffer(cQue, (PREFETCH ? 2 : 1), CHUNK_ELEMS * sizeof(int32_t));
		{
			pipe.InitBuffer(sQue, 1, TILE_N * sizeof(float));
		}
		pipe.InitBuffer(oQue, 1, HELD_ELEMS * sizeof(half));
		pipe.InitBuffer(uBuf, CHUNK_ELEMS * sizeof(float));
		LocalTensor<float> u = uBuf.Get<float>();
		int32_t iter = 0;
		int32_t slot = 0;
		const int32_t N_TILES = (n + TILE_N - 1) / TILE_N;
		const int32_t GROUP_TILES = N_TILES <= 3 ? N_TILES : 2;
		const int32_t N_GROUPS = (N_TILES + GROUP_TILES - 1) / GROUP_TILES;
		const int32_t TASKS = ((m + ROW_STEP - 1) / ROW_STEP) * N_GROUPS;
		for (int32_t task = coreIdx; task < TASKS; task += coreNum) {
			const int32_t slab = task / N_GROUPS;
			const int32_t ownedN = (task % N_GROUPS) * GROUP_TILES;
			int32_t start = slab * ROW_STEP;
			const int32_t slabEnd = start + ROW_STEP < m ? start + ROW_STEP : m;
			int32_t ei = slab;
			if (ei >= e)
				ei = e - 1;
			int32_t groupStart = ei == 0 ? 0 : glGm.GetValue(ei - 1);
			int32_t groupEnd = glGm.GetValue(ei);
			if (!(groupStart <= start && start < groupEnd)) {
				int32_t lo = 0, hi = e;
				while (lo < hi) {
					const int32_t mid = (lo + hi) / 2;
					if (glGm.GetValue(mid) <= start)
						lo = mid + 1;
					else
						hi = mid;
				}
				ei = lo;
				groupEnd = glGm.GetValue(ei);
			}
			while (start < slabEnd) {
				const int32_t end = groupEnd < slabEnd ? groupEnd : slabEnd;
				const int32_t me = end - start;
				const int32_t mTiles = DivUp32(me, TILE_M);
				const int32_t nTiles = DivUp32(nPad, TILE_N);
				for (int32_t mi = 0; mi < mTiles; ++mi) {
					const int32_t tileRowBase = mi * TILE_M;
					const int32_t curM = (mi == mTiles - 1) ? (me - mi * TILE_M) : TILE_M;
					const int32_t rowsPerSub = DivUp32(curM, 2);
					const int32_t subRowBegin = subIdx * rowsPerSub;
					const int32_t subRowEnd =
							(subRowBegin < curM) ? ((subRowBegin + rowsPerSub < curM) ? subRowBegin + rowsPerSub : curM)
																	 : subRowBegin;
					LocalTensor<half> aggregate = oQue.AllocTensor<half>();
					for (int32_t ni = ownedN; ni < nTiles && ni < ownedN + GROUP_TILES; ++ni) {
						const int32_t colBase = ni * TILE_N;
						const int32_t validN = TILE_N;
						LocalTensor<float> s;
						{
							s = sQue.AllocTensor<float>();
						}
						DataCopyExtParams sp{};
						sp.blockCount = 1;
						sp.blockLen = validN * sizeof(float);
						DataCopyPadExtParams<float> spad{true, 0, 0, 0};
						DataCopyPad(s, scaleGm[ei * n + colBase], sp, spad);
						{
							sQue.EnQue(s);
						}
						CrossCoreWaitFlag(GMM_SYNC_AIC_AIV);
						{
							s = sQue.DeQue<float>();
						}
						if constexpr (PREFETCH) {
							if (subRowBegin < subRowEnd) {
								const int32_t firstRC =
										subRowBegin + VEC_CHUNK_M < subRowEnd ? VEC_CHUNK_M : subRowEnd - subRowBegin;
								LocalTensor<int32_t> first = cQue.template AllocTensor<int32_t>();
								DataCopyExtParams cp{};
								cp.blockCount = firstRC;
								cp.blockLen = validN * sizeof(int32_t);
								cp.srcStride = (n / 2 - validN) * sizeof(int32_t);
								DataCopyPadExtParams<int32_t> cpad{true, 0, 0, 0};
								if constexpr (RAW_Y) {
									const int32_t rawRow = start + tileRowBase + subRowBegin;
									DataCopyPad(first, rawYGm[(rawRow * n + ownedN * TILE_N) / 2], cp, cpad);
								} else
									DataCopyPad(first,
															cGm[static_cast<int32_t>(coreIdx) * TILE_M * (n / 2) + (subRowBegin) * (n / 2)],
															cp, cpad);
								cQue.EnQue(first);
								if constexpr (EARLY_CREDIT) {
									if ((subRowBegin) + (firstRC) >= subRowEnd)
										CrossCoreSetFlag<SYNC_MODE2, PIPE_MTE2>(GMM_SYNC_AIV_AIC);
								}
							}
						}
						for (int32_t row = subRowBegin; row < subRowEnd; row += VEC_CHUNK_M) {
							const int32_t rc = row + VEC_CHUNK_M < subRowEnd ? VEC_CHUNK_M : subRowEnd - row;
							const int32_t total = rc * validN;
							LocalTensor<int32_t> c;
							if constexpr (PREFETCH) {
								c = cQue.template DeQue<int32_t>();
								const int32_t nextRow = row + rc;
								if (nextRow < subRowEnd) {
									const int32_t nextRC =
											nextRow + VEC_CHUNK_M < subRowEnd ? VEC_CHUNK_M : subRowEnd - nextRow;
									LocalTensor<int32_t> next = cQue.template AllocTensor<int32_t>();
									DataCopyExtParams cp{};
									cp.blockCount = nextRC;
									cp.blockLen = validN * sizeof(int32_t);
									cp.srcStride = (n / 2 - validN) * sizeof(int32_t);
									DataCopyPadExtParams<int32_t> cpad{true, 0, 0, 0};
									if constexpr (RAW_Y) {
										const int32_t rawRow = start + tileRowBase + nextRow;
										DataCopyPad(next, rawYGm[(rawRow * n + ownedN * TILE_N) / 2], cp, cpad);
									} else
										DataCopyPad(next,
																cGm[static_cast<int32_t>(coreIdx) * TILE_M * (n / 2) + (nextRow) * (n / 2)],
																cp, cpad);
									cQue.EnQue(next);
									if constexpr (EARLY_CREDIT) {
										if ((nextRow) + (nextRC) >= subRowEnd)
											CrossCoreSetFlag<SYNC_MODE2, PIPE_MTE2>(GMM_SYNC_AIV_AIC);
									}
								}
							} else {
								c = cQue.template AllocTensor<int32_t>();
								DataCopyExtParams cp{};
								cp.blockCount = rc;
								cp.blockLen = validN * sizeof(int32_t);
								cp.srcStride = (n / 2 - validN) * sizeof(int32_t);
								DataCopyPadExtParams<int32_t> cpad{true, 0, 0, 0};
								if constexpr (RAW_Y) {
									const int32_t rawRow = start + tileRowBase + row;
									DataCopyPad(c, rawYGm[(rawRow * n + ownedN * TILE_N) / 2], cp, cpad);
								} else
									DataCopyPad(c, cGm[static_cast<int32_t>(coreIdx) * TILE_M * (n / 2) + row * (n / 2)], cp,
															cpad);
								cQue.EnQue(c);
								c = cQue.template DeQue<int32_t>();
							}
							if constexpr (!EARLY_CREDIT) {
								if (row + rc >= subRowEnd)
									CrossCoreSetFlag<SYNC_MODE2, PIPE_MTE2>(GMM_SYNC_AIV_AIC);
							}
							LocalTensor<float> z = c.ReinterpretCast<float>();
							Cast(z, c, RoundMode::CAST_NONE, total);
							PipeBarrier<PIPE_V>();
							RgC1FP32ScaleRows(z, s, rc, validN);
							RgC1FP32GeluInplace(z, u, total);
							PipeBarrier<PIPE_V>();
							const int32_t outOffset = (ni - ownedN) * (TILE_M / 2) * TILE_N + (row - subRowBegin) * TILE_N;
							Cast(aggregate[outOffset], u, RoundMode::CAST_NONE, total);
							cQue.FreeTensor(c);
						}
						{
							sQue.FreeTensor(s);
						}
						if (subRowBegin >= subRowEnd)
							CrossCoreSetFlag<SYNC_MODE2, PIPE_MTE2>(GMM_SYNC_AIV_AIC);
						++iter;
					}
					oQue.EnQue(aggregate);
					aggregate = oQue.DeQue<half>();
					if (subRowBegin < subRowEnd) {
						for (int32_t ni = ownedN; ni < nTiles && ni < ownedN + GROUP_TILES; ++ni) {
							DataCopyExtParams op{};
							op.blockCount = subRowEnd - subRowBegin;
							op.blockLen = TILE_N * sizeof(half);
							op.dstStride = (n - TILE_N) * sizeof(half);
							const int32_t outOffset = (ni - ownedN) * (TILE_M / 2) * TILE_N;
							DataCopyPad(yGm[(start + tileRowBase + subRowBegin) * n + ni * TILE_N], aggregate[outOffset],
													op);
						}
					}
					oQue.FreeTensor(aggregate);
				}
				start = end;
				while (start < slabEnd && groupEnd <= start) {
					++ei;
					groupEnd = glGm.GetValue(ei);
				}
			}
		}
	}
}

}
template <int P>
__global__ __mix__(1, 2) void RgC1FP32Prefetch(GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR g, GM_ADDR y,
																							 int32_t m, int32_t e) {
	rg_c1_fp32_prefetch::Compute<128, 256, 128, P, 0, 1024, (P == 3 ? 16 : 32), true, true, true, true>(
			x, w, s, g, y, nullptr, m, 1024, P * 256, e);
}
__aicore__ inline void RgC3FP32ScaleRows(const AscendC::LocalTensor<float> &z,
																				 const AscendC::LocalTensor<float> &s, int32_t rows, int32_t pitch) {
	using namespace AscendC;
	if (pitch % 64 == 0 && rows >= pitch / 64) {
		BinaryRepeatParams rp;
		rp.dstBlkStride = 1;
		rp.src0BlkStride = 1;
		rp.src1BlkStride = 1;
		rp.dstRepStride = pitch / 8;
		rp.src0RepStride = pitch / 8;
		rp.src1RepStride = 0;
		for (int col = 0; col < pitch; col += 64)
			Mul(z[col], z[col], s[col], uint64_t(64), rows, rp);
	} else {
		for (int row = 0; row < rows; ++row)
			Mul(z[row * pitch], z[row * pitch], s, pitch);
	}
}
__aicore__ inline void RgC3FP32GeluInplace(const AscendC::LocalTensor<float> &z,
																					 const AscendC::LocalTensor<float> &u, int32_t cnt) {
	using namespace AscendC;
	Mul(u, z, z, cnt);
	Muls(u, u, -0.07135481627260026f, cnt);
	Adds(u, u, -1.5957691216057308f, cnt);
	Mul(u, u, z, cnt);
	Exp(u, u, cnt);
	Adds(u, u, 1.0f, cnt);
	Div(u, z, u, cnt);
}
namespace rg_c3_lifetime_pipeline {
struct Tile {
	int32_t row, expert, col, rows;
};

__aicore__ inline bool NextTile(AscendC::GlobalTensor<int64_t> &gl, int32_t m, int32_t e, int32_t panels,
																int32_t cores, int32_t &task, int32_t &start, int32_t &slabEnd,
																int32_t &expert, int32_t &groupEnd, bool &initialized, Tile &tile) {
	const int32_t tasks = ((m + 63) / 64) * panels;
	while (task < tasks) {
		if (!initialized) {
			const int32_t slab = task / panels;
			start = slab * 64;
			slabEnd = start + 64 < m ? start + 64 : m;
			expert = slab < e ? slab : e - 1;
			const int32_t groupStart = expert == 0 ? 0 : gl.GetValue(expert - 1);
			groupEnd = gl.GetValue(expert);
			if (!(groupStart <= start && start < groupEnd)) {
				int32_t lo = 0, hi = e;
				while (lo < hi) {
					const int32_t mid = (lo + hi) / 2;
					if (gl.GetValue(mid) <= start)
						lo = mid + 1;
					else
						hi = mid;
				}
				expert = lo;
				groupEnd = gl.GetValue(expert);
			}
			initialized = true;
		}
		if (start >= slabEnd) {
			task += cores;
			initialized = false;
			continue;
		}
		const int32_t end = groupEnd < slabEnd ? groupEnd : slabEnd;
		tile.row = start;
		tile.expert = expert;
		tile.col = (task % panels) * 256;
		tile.rows = end - start;
		start = end;
		while (start < slabEnd && groupEnd <= start) {
			++expert;
			groupEnd = gl.GetValue(expert);
		}
		return true;
	}
	return false;
}

__aicore__ inline void StageRead(const Tile &tile, int32_t bank, bool recycled, int32_t k, int32_t n,
																 AscendC::GlobalTensor<int8_t> &x, AscendC::GlobalTensor<int8_t> &w,
																 AscendC::LocalTensor<int8_t> a1, AscendC::LocalTensor<int8_t> b1) {
	using namespace AscendC;
	if (recycled)
		WaitFlag<HardEvent::MTE1_MTE2>(bank);
	Nd2NzParams pa;
	pa.ndNum = 1;
	pa.nValue = tile.rows;
	pa.dValue = k;
	pa.srcNdMatrixStride = 0;
	pa.srcDValue = k;
	pa.dstNzC0Stride = 64;
	pa.dstNzNStride = 1;
	pa.dstNzMatrixStride = 0;
	DataCopy(a1[bank * 64 * 256], x[tile.row * k], pa);
	Nd2NzParams pb;
	pb.ndNum = 1;
	pb.nValue = k;
	pb.dValue = 256;
	pb.srcNdMatrixStride = 0;
	pb.srcDValue = n;
	pb.dstNzC0Stride = k;
	pb.dstNzNStride = 1;
	pb.dstNzMatrixStride = 0;
	DataCopy(b1[bank * 256 * 256], w[tile.expert * k * n + tile.col], pb);
	SetFlag<HardEvent::MTE2_MTE1>(bank);
}

__aicore__ inline int32_t RowsForReader(const Tile &tile, int32_t sub, int32_t &first) {
	const int32_t per = (tile.rows + 1) / 2;
	first = sub * per;
	return first < tile.rows ? (tile.rows - first < per ? tile.rows - first : per) : 0;
}

__aicore__ inline void StageC(const Tile &tile, int32_t seq, int32_t core, int32_t sub, int32_t slotElems,
															int32_t n, AscendC::GlobalTensor<int32_t> &cg, AscendC::GlobalTensor<float> &sg,
															AscendC::TQue<AscendC::TPosition::VECIN, 2> &cq,
															AscendC::TQue<AscendC::TPosition::VECIN, 2> &sq) {
	using namespace AscendC;
	int32_t first;
	const int32_t rows = RowsForReader(tile, sub, first);
	if (rows) {
		auto s = sq.AllocTensor<float>();
		DataCopy(s, sg[tile.expert * n + tile.col], 256);
		sq.EnQue(s);
	}
	CrossCoreWaitFlag(5 + (seq & 1));
	if (rows) {
		auto c = cq.AllocTensor<int32_t>();
		DataCopy(c, cg[(core * 2 + (seq & 1)) * slotElems + first * 256], rows * 256);
		cq.EnQue(c);
	}
	CrossCoreSetFlag<2, PIPE_MTE2>(3 + (seq & 1));
}

__aicore__ inline void VectorPrefetch(AscendC::TPipe &pipe, AscendC::GlobalTensor<int64_t> &gl,
																			AscendC::GlobalTensor<int32_t> &cg, AscendC::GlobalTensor<float> &sg,
																			AscendC::GlobalTensor<half> &yg, int32_t m, int32_t n, int32_t e,
																			int32_t slotElems, int32_t core, int32_t sub, int32_t cores) {
	using namespace AscendC;
	constexpr int ELEMS = 32 * 256;
	constexpr int OUT_DEPTH = 2;
	static_assert(2 * ELEMS * sizeof(int32_t) + 2 * 256 * sizeof(float) + OUT_DEPTH * ELEMS * sizeof(half) +
												ELEMS * sizeof(float) <=
										192 * 1024,
								"C/S double queues, two half output slots and FP32 GELU scratch fit UB");
	TQue<TPosition::VECIN, 2> cq, sq;
	TQue<TPosition::VECOUT, OUT_DEPTH> oq;
	TBuf<TPosition::VECCALC> ub;
	pipe.InitBuffer(cq, 2, ELEMS * sizeof(int32_t));
	pipe.InitBuffer(sq, 2, 256 * sizeof(float));
	pipe.InitBuffer(oq, OUT_DEPTH, ELEMS * sizeof(half));
	pipe.InitBuffer(ub, ELEMS * sizeof(float));
	auto u = ub.Get<float>();
	int32_t task = core, start = 0, slabEnd = 0, expert = 0, groupEnd = 0, seq = 0;
	bool initialized = false;
	Tile cur{}, next{};
	bool hasCur = NextTile(gl, m, e, n / 256, cores, task, start, slabEnd, expert, groupEnd, initialized, cur);
	if (hasCur)
		StageC(cur, seq, core, sub, slotElems, n, cg, sg, cq, sq);
	while (hasCur) {
		int32_t first;
		const int32_t rows = RowsForReader(cur, sub, first);
		LocalTensor<int32_t> value;
		LocalTensor<float> s;
		if (rows) {
			value = cq.DeQue<int32_t>();
			s = sq.DeQue<float>();
		}
		const bool hasNext =
				NextTile(gl, m, e, n / 256, cores, task, start, slabEnd, expert, groupEnd, initialized, next);
		if (rows) {
			auto z = value.ReinterpretCast<float>();
			const int32_t count = rows * 256;
			Cast(z, value, RoundMode::CAST_NONE, count);
			PipeBarrier<PIPE_V>();
			RgC3FP32ScaleRows(z, s, rows, 256);
			PipeBarrier<PIPE_V>();
			sq.FreeTensor(s);

			RgC3FP32GeluInplace(z, u, count);
		}

		if (hasNext)
			StageC(next, seq + 1, core, sub, slotElems, n, cg, sg, cq, sq);
		if (rows) {
			const int32_t count = rows * 256;
			PipeBarrier<PIPE_V>();
			auto out = oq.AllocTensor<half>();
			Cast(out, u, RoundMode::CAST_NONE, count);
			cq.FreeTensor(value);
			oq.EnQue(out);
			out = oq.DeQue<half>();
			DataCopyExtParams op{};
			op.blockCount = rows;
			op.blockLen = 256 * sizeof(half);
			op.dstStride = (n - 256) * sizeof(half);
			DataCopyPad(yg[(cur.row + first) * n + cur.col], out, op);

			oq.FreeTensor(out);
		}
		cur = next;
		hasCur = hasNext;
		++seq;
	}
}

template <int TM, int TN, int ROW_STEP, int PANELS, int GROUPS = 0, int DEPTH = 0>
__aicore__ inline void Compute(GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR group_list, GM_ADDR y,
															 GM_ADDR workspace, int32_t runtimeM, int32_t runtimeK, int32_t runtimeN,
															 int32_t runtimeE) {
	const int32_t m = GROUPS > 0 ? GROUPS * ROW_STEP : runtimeM;
	const int32_t e = GROUPS > 0 ? GROUPS : runtimeE;
	const int32_t k = DEPTH > 0 ? DEPTH : runtimeK;
	const int32_t n = PANELS > 0 ? PANELS * TN : runtimeN;
	using Cfg = gmm_tiles::Config<TM, TN>;
	using MM = typename Cfg::MM;
	constexpr int TILE_M = TM, TILE_N = TN, VEC_CHUNK_M = TN == 256 ? 64 : 32;
	static_assert(10 * VEC_CHUNK_M * TILE_N + 4 * TILE_N <= 192 * 1024, "UB live set");
	constexpr uint16_t GMM_SYNC_AIV_AIC = 3, GMM_SYNC_AIC_AIV = 5;
	constexpr uint32_t SYNC_MODE2 = 2;
	using namespace gmm_common;
	using namespace AscendC;
	const uint32_t coreNum = static_cast<uint32_t>(GetBlockNum());
	const uint32_t coreIdx = CoreGroupIndex();
	const uint32_t subIdx = SubCoreIndex();
	const int32_t nPad = n;
	GlobalTensor<int8_t> xGm;
	GlobalTensor<int8_t> wGm;
	GlobalTensor<float> scaleGm;
	GlobalTensor<int64_t> glGm;
	GlobalTensor<int32_t> cGm;
	GlobalTensor<half> yGm;
	xGm.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t *>(x), m * k);
	wGm.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t *>(weight), e * k * n);
	scaleGm.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(scale), e * n);
	glGm.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t *>(group_list), e);
	cGm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t *>(workspace),
											static_cast<int32_t>(coreNum) * 2 * TILE_M * nPad);
	yGm.SetGlobalBuffer(reinterpret_cast<__gm__ half *>(y), m * n);
	TPipe pipe;
	if ASCEND_IS_AIC {
		static_assert(ROW_STEP == 64 && TN == 256, "prefetch resource family");
		static_assert(DEPTH >= 32 && DEPTH <= 256 && DEPTH % 32 == 0, "complete short K");
		constexpr int CAP_M = 64, CAP_K = 256, CAP_N = 256;
		TBuf<TPosition::A1> a1Buf;
		TBuf<TPosition::B1> b1Buf;
		TBuf<TPosition::A2> a2Buf;
		TBuf<TPosition::B2> b2Buf;
		TBuf<TPosition::CO1> c1Buf;
		pipe.InitBuffer(a1Buf, 2 * CAP_M * CAP_K);
		pipe.InitBuffer(b1Buf, 2 * CAP_K * CAP_N);
		pipe.InitBuffer(a2Buf, CAP_M * CAP_K);
		pipe.InitBuffer(b2Buf, CAP_K * CAP_N);
		pipe.InitBuffer(c1Buf, 2 * CAP_M * CAP_N * sizeof(int32_t));
		LocalTensor<int8_t> a1 = a1Buf.Get<int8_t>(), b1 = b1Buf.Get<int8_t>();
		LocalTensor<int8_t> a2 = a2Buf.Get<int8_t>(), b2 = b2Buf.Get<int8_t>();
		LocalTensor<int32_t> c1All = c1Buf.Get<int32_t>();
		const uint8_t pads[4] = {0, 0, 0, 0};
		SetFmatrix(1, CAP_M, pads, FmatrixMode::FMATRIX_LEFT);
		int32_t task = coreIdx, start = 0, slabEnd = 0, expert = 0, groupEnd = 0;
		bool initialized = false;
		const int32_t panels = n / 256;
		Tile cur{}, next{}, future{};
		bool hasCur =
				NextTile(glGm, m, e, panels, coreNum, task, start, slabEnd, expert, groupEnd, initialized, cur);
		bool hasNext = false;
		if (hasCur) {
			StageRead(cur, 0, false, k, n, xGm, wGm, a1, b1);
			hasNext =
					NextTile(glGm, m, e, panels, coreNum, task, start, slabEnd, expert, groupEnd, initialized, next);
			if (hasNext)
				StageRead(next, 1, false, k, n, xGm, wGm, a1, b1);
		}
		int32_t iter = 0;
		while (hasCur) {
			const int32_t bank = iter & 1, mp = (cur.rows + 15) / 16 * 16;
			WaitFlag<HardEvent::MTE2_MTE1>(bank);
			if (iter > 0)
				WaitFlag<HardEvent::M_MTE1>(EVENT_ID0);
			LoadData3DParamsV2Pro lda;
			lda.channelSize = static_cast<uint16_t>(k);
			lda.extConfig = (static_cast<uint64_t>(mp) << 16) | static_cast<uint64_t>(k);
			lda.enTranspose = false;
			LoadData(a2, a1[bank * CAP_M * CAP_K], lda);
			LoadData2dTransposeParams ldb;
			ldb.startIndex = 0;
			ldb.repeatTimes = CAP_N / 32;
			ldb.srcStride = k / 32;
			ldb.dstGap = 1;
			ldb.dstFracGap = 0;
			ldb.addrMode = 0;
			for (int32_t ki = 0; ki < k / 32; ++ki)
				LoadDataWithTranspose(b2[ki * 32 * CAP_N], b1[bank * CAP_K * CAP_N + ki * 1024], ldb);
			SetFlag<HardEvent::MTE1_MTE2>(bank);
			SetFlag<HardEvent::MTE1_M>(EVENT_ID0);
			WaitFlag<HardEvent::MTE1_M>(EVENT_ID0);
			if (iter >= 2)
				WaitFlag<HardEvent::FIX_M>(bank);
			LocalTensor<int32_t> c1 = c1All[bank * CAP_M * CAP_N];
			MmadParams mm;
			mm.m = mp;
			mm.n = CAP_N;
			mm.k = k;
			mm.unitFlag = 0;
			mm.cmatrixInitVal = true;
			Mmad(c1, a2, b2, mm);
			SetFlag<HardEvent::M_MTE1>(EVENT_ID0);
			SetFlag<HardEvent::M_FIX>(EVENT_ID0);
			const bool hasFuture =
					NextTile(glGm, m, e, panels, coreNum, task, start, slabEnd, expert, groupEnd, initialized, future);
			PipeBarrier<PIPE_ALL>();
			if (hasFuture)
				StageRead(future, bank, true, k, n, xGm, wGm, a1, b1);
			WaitFlag<HardEvent::M_FIX>(EVENT_ID0);
			if (iter >= 2)
				CrossCoreWaitFlag(GMM_SYNC_AIV_AIC + bank);
			FixpipeParamsV220 fp;
			fp.nSize = CAP_N;
			fp.mSize = cur.rows;
			fp.srcStride = mp;
			fp.dstStride = CAP_N;
			fp.reluEn = false;
			fp.quantPre = QuantMode_t::NoQuant;
			fp.unitFlag = 0;
			Fixpipe<int32_t, int32_t, CFG_ROW_MAJOR>(
					cGm[(static_cast<int32_t>(coreIdx) * 2 + bank) * TILE_M * nPad], c1, fp);
			CrossCoreSetFlag<SYNC_MODE2, PIPE_FIX>(GMM_SYNC_AIC_AIV + bank);
			SetFlag<HardEvent::FIX_M>(bank);
			++iter;
			cur = next;
			hasCur = hasNext;
			next = future;
			hasNext = hasFuture;
		}
		if (iter > 0) {
			for (int bank = 0; bank < (iter < 2 ? iter : 2); ++bank)
				WaitFlag<HardEvent::MTE1_MTE2>(bank);
			WaitFlag<HardEvent::M_MTE1>(EVENT_ID0);
			for (int bank = 0; bank < (iter < 2 ? iter : 2); ++bank)
				WaitFlag<HardEvent::FIX_M>(bank);
			for (int32_t pending = iter > 2 ? iter - 2 : 0; pending < iter; ++pending)
				CrossCoreWaitFlag(3 + (pending & 1));
		}
	} else {
		VectorPrefetch(pipe, glGm, cGm, scaleGm, yGm, m, n, e, TILE_M * nPad, coreIdx, subIdx, coreNum);
	}
}

}
__global__ __mix__(1, 2)
		__attribute__((aligned(64))) void RgC3PrefetchALL_p1_e1_k256(GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR g,
																																 GM_ADDR y, GM_ADDR c, int32_t m) {
