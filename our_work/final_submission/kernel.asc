#pragma clang diagnostic push

#pragma clang diagnostic ignored "-Wignored-attributes"

#include <cmath>

#include <stdexcept>

#include "kernel_operator.h"

#include "adv_api/matmul/matmul.h"

namespace gmm_common {
__aicore__ inline float ScalarGelu(float zz) {
	const float uu = 0.7978845608028654f * (zz + 0.044715f * zz * zz * zz);
	const float absu = (uu < 0.0f) ? -uu : uu;
	const float x = -2.0f * absu;
	float tail;
	if (x < -87.0f) {
		tail = 0.0f;
	} else {
		const float t = x * 1.4426950408889634f;
		int32_t nn = static_cast<int32_t>(t);
		if (t < static_cast<float>(nn)) {
			--nn;
		}
		const float f = x - static_cast<float>(nn) * 0.6931471805599453f;
		const float y =
				1.0f + f * (1.0f + f * (0.5f + f * (0.16666667f +
																						f * (0.041666668f + f * (0.008333334f + f * 0.0013888889f)))));
		union {
			float value;
			uint32_t bits;
		} scale;
		scale.bits = static_cast<uint32_t>(nn + 127) << 23;
		tail = y * scale.value;
	}
	const float factor = (uu >= 0.0f) ? (1.0f / (1.0f + tail)) : (tail / (1.0f + tail));
	return zz * factor;
}

__aicore__ inline uint32_t CoreGroupIndex() {
	if ASCEND_IS_AIC {
		return static_cast<uint32_t>(AscendC::GetBlockIdx());
	}
	return static_cast<uint32_t>(AscendC::GetBlockIdx() / AscendC::GetTaskRation());
}

__aicore__ inline uint32_t SubCoreIndex() {
	if ASCEND_IS_AIV {
		return static_cast<uint32_t>(AscendC::GetSubBlockIdx());
	}
	return 0;
}

__aicore__ inline int64_t CeilDiv(int64_t a, int64_t b) {
	return (a + b - 1) / b;
}

__aicore__ inline void GeluComputeSigmoid(const AscendC::LocalTensor<float> &z,
																					const AscendC::LocalTensor<float> &u,
																					const AscendC::LocalTensor<float> &t,
																					const AscendC::LocalTensor<float> &d, int32_t cnt) {
	using namespace AscendC;
	Mul(u, z, z, cnt);
	Mul(u, u, z, cnt);
	Muls(u, u, 0.044715f, cnt);
	Add(u, u, z, cnt);
	Muls(t, u, -1.5957691216057308f, cnt);
	Exp(t, t, cnt);
	Adds(t, t, 1.0f, cnt);
	Div(t, d, t, cnt);
	Mul(u, z, t, cnt);
}

}
extern "C" __global__ __aicore__ __attribute__((aligned(64))) void
gmm_tiny_scalar(GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR group_list, GM_ADDR y, int64_t m, int64_t k,
								int64_t n, int64_t e) {
	KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
	using namespace gmm_common;
	using namespace AscendC;
	GlobalTensor<int8_t> xGm;
	GlobalTensor<int8_t> wGm;
	GlobalTensor<float> scaleGm;
	GlobalTensor<int64_t> glGm;
	GlobalTensor<half> yGm;
	xGm.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t *>(x), m * k);
	wGm.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t *>(weight), e * k * n);
	scaleGm.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(scale), e * n);
	glGm.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t *>(group_list), e);
	yGm.SetGlobalBuffer(reinterpret_cast<__gm__ half *>(y), m * n);
	const int64_t experts = e;
	int64_t prev = 0;
	for (int64_t ei = 0; ei < experts; ++ei) {
		const int64_t start = prev;
		const int64_t end = glGm.GetValue(ei);
		prev = end;
		const int64_t me = end - start;
		if (me <= 0) {
			continue;
		}
		for (int64_t row = 0; row < me; ++row) {
			const int64_t globalRow = start + row;
			for (int64_t col = 0; col < n; ++col) {
				int32_t acc = 0;
				for (int64_t kk = 0; kk < k; ++kk) {
					const int32_t xv = static_cast<int32_t>(xGm.GetValue(static_cast<uint64_t>(globalRow * k + kk)));
					const int32_t wv =
							static_cast<int32_t>(wGm.GetValue(static_cast<uint64_t>(ei * k * n + kk * n + col)));
					acc += xv * wv;
				}
				const float z = static_cast<float>(acc) * scaleGm.GetValue(static_cast<uint64_t>(ei * n + col));
				yGm.SetValue(static_cast<uint64_t>(globalRow * n + col), static_cast<half>(ScalarGelu(z)));
			}
		}
	}
}
namespace gmm_tiny_count {
using namespace AscendC;

__aicore__ inline void GeluCount(const LocalTensor<float> &z, const LocalTensor<float> &u, int32_t count) {
	SetMaskCount();
	SetVectorMask<float, MaskMode::COUNTER>(0, static_cast<uint64_t>(count));
	const BinaryRepeatParams bp{1, 1, 1, 8, 8, 8};
	const UnaryRepeatParams up{1, 1, 8, 8};
	Mul<float, false>(u, z, z, uint64_t(64), 1, bp);
	Muls<float, false>(u, u, -0.07135481627260026f, uint64_t(64), 1, up);
	Adds<float, false>(u, u, -1.5957691216057308f, uint64_t(64), 1, up);
	Mul<float, false>(u, u, z, uint64_t(64), 1, bp);
	Exp<float, false>(u, u, uint64_t(64), 1, up);
	Adds<float, false>(u, u, 1.0f, uint64_t(64), 1, up);
	Div<float, false>(u, z, u, uint64_t(64), 1, bp);
	SetMaskNorm();
	ResetMask();
}

}
template <int STATIC_K = 0, int STATIC_N = 0>
__global__ __aicore__ __attribute__((aligned(64))) __attribute__((aligned(512))) void
gmm_tiny_vector(GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR group_list, GM_ADDR y, int64_t m, int64_t k,
								int64_t n, int64_t e) {
	KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
	if (AscendC::GetBlockIdx() == 0) {
		using namespace gmm_common;
		using namespace AscendC;
		{
			if (m * k <= 64 && e * k * n <= 64 && e * n <= 16) {
				GlobalTensor<uint64_t> cacheW, cacheS;
				cacheW.SetGlobalBuffer(reinterpret_cast<__gm__ uint64_t *>(weight));
				cacheS.SetGlobalBuffer(reinterpret_cast<__gm__ uint64_t *>(scale));
				DataCachePreload(cacheW, static_cast<int64_t>(0));
				DataCachePreload(cacheS, static_cast<int64_t>(0));
				{
					GlobalTensor<uint64_t> cacheX;
					cacheX.SetGlobalBuffer(reinterpret_cast<__gm__ uint64_t *>(x));
					DataCachePreload(cacheX, static_cast<int64_t>(0));
				}
			}
		}
		const uint32_t zBytes =
				static_cast<uint32_t>(((m * n * static_cast<int64_t>(sizeof(float)) + 31) / 32) * 32);
		LocalTensor<float> zL(TPosition::VECCALC, 0, zBytes / 4);
		LocalTensor<float> uL(TPosition::VECCALC, zBytes, zBytes / 4);
		LocalTensor<float> tL = zL, dL = zL, rL = zL, qL = zL;
		GlobalTensor<int8_t> xGm;
		GlobalTensor<int8_t> wGm;
		GlobalTensor<float> scaleGm;
		GlobalTensor<int64_t> glGm;
		GlobalTensor<half> yGm;
		xGm.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t *>(x), m * k);
		wGm.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t *>(weight), e * k * n);
		scaleGm.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(scale), e * n);
		glGm.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t *>(group_list), e);
		yGm.SetGlobalBuffer(reinterpret_cast<__gm__ half *>(y), m * n);
		const __gm__ int64_t *groupGmPtr = glGm.GetPhyAddr();
		const __gm__ int8_t *xp = xGm.GetPhyAddr();
		const __gm__ int8_t *wp = wGm.GetPhyAddr();
		const __gm__ float *sp = scaleGm.GetPhyAddr();
		__ubuf__ float *zp = reinterpret_cast<__ubuf__ float *>(zL.GetPhyAddr());
		const int64_t experts = e;
		const int32_t k32 = STATIC_K > 0 ? STATIC_K : static_cast<int32_t>(k);
		const int32_t n32 = STATIC_N > 0 ? STATIC_N : static_cast<int32_t>(n);
		const int32_t experts32 = static_cast<int32_t>(experts);
		int32_t prev = 0;
		if (experts32 <= 4) {
#pragma unroll
			for (int32_t ei = 0; ei < 4; ++ei) {
				if (ei < experts32) {
					const int32_t start = prev;
					const int32_t end = static_cast<int32_t>(groupGmPtr[ei]);
					prev = end;
					const int32_t me = end - start;
					if (me <= 0) {
						continue;
					}
					const int32_t wBase = ei * k32 * n32;
					const int32_t sBase = ei * n32;
					for (int32_t row = 0; row < me; ++row) {
						const int32_t globalRow = start + row;
						const int32_t xBase = globalRow * k32;
						const int32_t outBase = globalRow * n32;
#pragma unroll
						for (int32_t col = 0; col < n32; ++col) {
							int32_t acc = 0;
							if (STATIC_K > 0) {
#pragma unroll
								for (int32_t kk = 0; kk < STATIC_K; ++kk) {
									acc +=
											static_cast<int32_t>(xp[xBase + kk]) * static_cast<int32_t>(wp[wBase + kk * n32 + col]);
								}
							} else {
								for (int32_t kk = 0; kk < k32; ++kk) {
									acc +=
											static_cast<int32_t>(xp[xBase + kk]) * static_cast<int32_t>(wp[wBase + kk * n32 + col]);
								}
							}
							zp[outBase + col] = static_cast<float>(acc) * sp[sBase + col];
						}
					}
				}
			}
		} else {
			for (int32_t ei = 0; ei < experts32; ++ei) {
				const int32_t start = prev;
				const int32_t end = static_cast<int32_t>(groupGmPtr[ei]);
				prev = end;
				const int32_t me = end - start;
				if (me <= 0) {
					continue;
				}
				const int32_t wBase = ei * k32 * n32;
				const int32_t sBase = ei * n32;
				for (int32_t row = 0; row < me; ++row) {
					const int32_t globalRow = start + row;
					const int32_t xBase = globalRow * k32;
					const int32_t outBase = globalRow * n32;
#pragma unroll
					for (int32_t col = 0; col < n32; ++col) {
						int32_t acc = 0;
						if (STATIC_K > 0) {
#pragma unroll
							for (int32_t kk = 0; kk < STATIC_K; ++kk) {
								acc +=
										static_cast<int32_t>(xp[xBase + kk]) * static_cast<int32_t>(wp[wBase + kk * n32 + col]);
							}
						} else {
							for (int32_t kk = 0; kk < k32; ++kk) {
								acc +=
										static_cast<int32_t>(xp[xBase + kk]) * static_cast<int32_t>(wp[wBase + kk * n32 + col]);
							}
						}
						zp[outBase + col] = static_cast<float>(acc) * sp[sBase + col];
					}
				}
			}
		}
		const event_t evtSV = static_cast<event_t>(0);
		SetFlag<HardEvent::S_V>(evtSV);
		WaitFlag<HardEvent::S_V>(evtSV);
		const int32_t total = static_cast<int32_t>(m * n);
		gmm_tiny_count::GeluCount(zL, uL, total);
		LocalTensor<half> outputL = zL.ReinterpretCast<half>();
		PipeBarrier<PIPE_V>();
		Cast(outputL, uL, RoundMode::CAST_NONE, total);
		const event_t evtStore = static_cast<event_t>(0);
		SetFlag<HardEvent::V_MTE3>(evtStore);
		WaitFlag<HardEvent::V_MTE3>(evtStore);
		DataCopyExtParams op;
		op.blockCount = 1;
		op.blockLen = total * sizeof(half);
		op.srcStride = 0;
		op.dstStride = 0;
		DataCopyPad(yGm, outputL, op);
		PipeBarrier<PIPE_ALL>();
	}
}
__aicore__ inline float ScalarGeluPade(float z) {
	const float u = 0.7978845608028654f * (z + 0.044715f * z * z * z);
	const float v = u * u;
	const float numerator = u * (135135.0f + v * (17325.0f + v * (378.0f + v)));
	const float denominator = 135135.0f + v * (62370.0f + v * (3150.0f + 28.0f * v));
	float t = numerator / denominator;
	t = t > 1.0f ? 1.0f : (t < -1.0f ? -1.0f : t);
	return (0.5f * z) * (1.0f + t);
}

template <int STATIC_K = 0>
__global__ __aicore__ __attribute__((aligned(64))) __attribute__((aligned(512))) void
bk484(GM_ADDR x, GM_ADDR w, GM_ADDR sc, GM_ADDR groups, GM_ADDR y, int64_t runtimeK, int64_t e) {
	KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
	if (AscendC::GetBlockIdx() != 0)
		return;
	const __gm__ int8_t *xp = reinterpret_cast<const __gm__ int8_t *>(x);
	const __gm__ int8_t *wp = reinterpret_cast<const __gm__ int8_t *>(w);
	const __gm__ float *sp = reinterpret_cast<const __gm__ float *>(sc);
	const __gm__ int64_t *gp = reinterpret_cast<const __gm__ int64_t *>(groups);
	if constexpr (STATIC_K > 0 && STATIC_K <= 8) {
		if (e <= 8) {
			AscendC::GlobalTensor<uint64_t> cache0;
			cache0.SetGlobalBuffer(reinterpret_cast<__gm__ uint64_t *>(groups));
			AscendC::DataCachePreload(cache0, static_cast<int64_t>(0));
			AscendC::GlobalTensor<uint64_t> cache1;
			cache1.SetGlobalBuffer(reinterpret_cast<__gm__ uint64_t *>(x));
			AscendC::DataCachePreload(cache1, static_cast<int64_t>(0));
			AscendC::GlobalTensor<uint64_t> cache2;
			cache2.SetGlobalBuffer(reinterpret_cast<__gm__ uint64_t *>(w));
			AscendC::DataCachePreload(cache2, static_cast<int64_t>(0));
			AscendC::GlobalTensor<uint64_t> cache3;
			cache3.SetGlobalBuffer(reinterpret_cast<__gm__ uint64_t *>(sc));
			AscendC::DataCachePreload(cache3, static_cast<int64_t>(0));
		}
	}
	int64_t expert = 0;
	if (e > 1 && gp[0] == 0) {
		if (gp[e - 2] == 0)
			expert = e - 1;
		else {
			int64_t lo = 1, hi = e - 1;
			while (lo < hi) {
				const int64_t mid = (lo + hi) / 2;
				if (gp[mid] == 0)
					lo = mid + 1;
				else
					hi = mid;
			}
			expert = lo;
		}
	}
	const int64_t k = STATIC_K > 0 ? STATIC_K : runtimeK;
	int32_t acc = 0;
	if (STATIC_K > 0) {
#pragma unroll
		for (int kk = 0; kk < STATIC_K; ++kk)
			acc += int32_t(xp[kk]) * int32_t(wp[expert * k + kk]);
	} else {
		for (int64_t kk = 0; kk < k; ++kk)
			acc += int32_t(xp[kk]) * int32_t(wp[expert * k + kk]);
	}
	const float z = static_cast<float>(acc) * sp[expert];
	const float value = z >= 6.0f ? z : (z <= -6.0f ? z * 0.0f : ScalarGeluPade(z));
	*reinterpret_cast<__gm__ half *>(y) = static_cast<half>(value);
}
namespace gmm_tiles {
template <int TM, int TN> struct Config {
	static_assert(TM % 16 == 0 && TN % 32 == 0, "Cube tile alignment");
	static_assert(TM * TN * 4 <= 128 * 1024, "L0C capacity");
	static_assert((TM + TN) * (TN > 256 ? 64 : 128) * 8 <= 512 * 1024, "L1 capacity");
	static_assert(26 * (TN == 512 ? 8 : 16) * TN + 4 * TN <= 192 * 1024, "UB capacity");
	using AType = AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, int8_t, false>;
	using BType = AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, int8_t, false>;
	using CType = AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, int32_t>;
	using BiasType = AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, int32_t>;
	static constexpr int32_t TILE_M = TM;
	static constexpr int32_t TILE_N = TN;
	static constexpr int32_t VEC_CHUNK_M = TN == 512 ? 8 : 16;
	static constexpr uint16_t GMM_SYNC_AIV_AIC = 3;
	static constexpr uint16_t GMM_SYNC_AIC_AIV = 5;
	static constexpr uint64_t SYNC_MODE2 = 2;
	static __aicore__ constexpr MatmulConfig MakeMatmulConfig() {
		MatmulConfig cfg{};
		cfg.doNorm = false;
		cfg.doBasicBlock = false;
		cfg.doMultiDataLoad = true;
		cfg.basicM = TILE_M;
		cfg.basicN = TILE_N;
		cfg.basicK = TN > 256 ? 64 : 128;
		cfg.intrinsicsCheck = false;
		cfg.isNBatch = false;
		cfg.enVecND2NZ = false;
		cfg.doSpecialBasicBlock = false;
		cfg.doMTE2Preload = 0;
		cfg.singleCoreM = TILE_M;
		cfg.singleCoreN = 1024;
		cfg.singleCoreK = 8192;
		cfg.stepM = 0;
		cfg.stepN = 0;
		cfg.baseMN = 0;
		cfg.singleCoreMN = 0;
		cfg.enUnitFlag = true;
		cfg.isPerTensor = false;
		cfg.hasAntiQuantOffset = false;
		cfg.doIBShareNorm = false;
		cfg.doSpecialMDL = false;
		cfg.enableInit = false;
		cfg.batchMode = BatchMode::NONE;
		cfg.enableEnd = true;
		cfg.enableGetTensorC = true;
		cfg.enableSetOrgShape = true;
		cfg.enableSetBias = false;
		cfg.enableSetTail = true;
		cfg.enableQuantVector = false;
		cfg.enableSetDefineData = false;
		cfg.iterateMode = IterateMode::ITERATE_MODE_DEFAULT;
		cfg.enableReuse = true;
		cfg.enableUBReuse = true;
		cfg.enableL1CacheUB = false;
		cfg.intraBlockPartSum = false;
		cfg.iterateOrder = IterateOrder::UNDEF;
		cfg.scheduleType = ScheduleType::INNER_PRODUCT;
		cfg.enableDoubleCache = false;
		cfg.isBiasBatch = true;
		cfg.enableStaticPadZeros = false;
		cfg.isA2B2Shared = false;
		cfg.enableKdimReorderLoad = false;
		cfg.isCO1Shared = false;
		return cfg;
	}
	static __aicore__ constexpr MatmulApiStaticTiling MakeStaticTiling() {
		MatmulApiStaticTiling tiling =
				AscendC::GetMatmulApiTiling<AType, BType, CType, BiasType>(MakeMatmulConfig());
		tiling.depthA1 = 8;
		tiling.depthB1 = 8;
		tiling.stepM = 1;
		tiling.stepN = 1;
		tiling.stepKa = 4;
		tiling.stepKb = 4;
		tiling.dbL0A = 2;
		tiling.dbL0B = 2;
		tiling.dbL0C = 1;
		return tiling;
	}
	constexpr static MatmulApiStaticTiling STATIC_TILING = MakeStaticTiling();
	using MM = AscendC::MatmulImpl<AType, BType, CType, BiasType, STATIC_TILING>;
};

__aicore__ inline bool KeepWholeRowOwnership(const int64_t *groupEnds, int64_t experts, int64_t tileM,
																						 int64_t tileN, int64_t columns, int64_t cores) {
	if (cores <= 1 || cores > 20 || columns <= tileN || columns % tileN != 0)
		return true;

	const int64_t panels = columns / tileN;
	const int64_t fullQuanta = tileM / 16;
	int64_t minimumQuanta = fullQuanta;
	int64_t maximumQuanta = 0;
	int64_t totalQuanta = 0;
	int64_t totalWorks = 0;
	int64_t previousEnd = 0;
	for (int64_t expert = 0; expert < experts; ++expert) {
		const int64_t length = groupEnds[expert] - previousEnd;
		previousEnd = groupEnds[expert];
		if (length <= 0)
			continue;
		const int64_t full = length / tileM;
		const int64_t tail = length % tileM;
		const int64_t largest = full ? fullQuanta : (tail + 15) / 16;
		const int64_t smallest = tail ? (tail + 15) / 16 : fullQuanta;
		totalQuanta += full * fullQuanta + (tail + 15) / 16;
		totalWorks += full + (tail != 0);
		if (largest > maximumQuanta)
			maximumQuanta = largest;
		if (smallest < minimumQuanta)
			minimumQuanta = smallest;
	}
	if (maximumQuanta < 2 * minimumQuanta)
		return true;

	const int64_t maximumOwnedWorks = (totalWorks + cores - 1) / cores;
	int64_t wholeUpperBound = maximumOwnedWorks * maximumQuanta;
	const int64_t remainingMinimum = (totalWorks - maximumOwnedWorks) * minimumQuanta;
	if (wholeUpperBound > totalQuanta - remainingMinimum)
		wholeUpperBound = totalQuanta - remainingMinimum;
	const int64_t separateLowerBound = (totalQuanta * panels + cores - 1) / cores;
	if (wholeUpperBound * panels < 2 * separateLowerBound)
		return true;

	int32_t wholeRows[20] = {};
	int32_t separatePanels[20] = {};
	int64_t commonWholeRows = 0;
	int64_t commonSeparatePanels = 0;
	int64_t firstWork = 0;
	previousEnd = 0;
	for (int64_t expert = 0; expert < experts; ++expert) {
		const int64_t length = groupEnds[expert] - previousEnd;
		previousEnd = groupEnds[expert];
		const int64_t full = length / tileM;
		const int64_t tail = length % tileM;
		const int64_t tailQuanta = (tail + 15) / 16;

		commonWholeRows += (full / cores) * fullQuanta;
		const int64_t wholeRemainder = full % cores;
		for (int64_t extra = 0; extra < wholeRemainder; ++extra)
			wholeRows[(firstWork + extra) % cores] += fullQuanta;
		if (tail)
			wholeRows[(firstWork + full) % cores] += tailQuanta;

		const int64_t fullPanelTasks = full * panels;
		commonSeparatePanels += (fullPanelTasks / cores) * fullQuanta;
		const int64_t panelRemainder = fullPanelTasks % cores;
		for (int64_t extra = 0; extra < panelRemainder; ++extra)
			separatePanels[(firstWork * panels + extra) % cores] += fullQuanta;
		if (tail) {
			commonSeparatePanels += (panels / cores) * tailQuanta;
			for (int64_t extra = 0; extra < panels % cores; ++extra)
				separatePanels[((firstWork + full) * panels + extra) % cores] += tailQuanta;
		}
		firstWork += full + (tail != 0);
	}

	int64_t worstWholeRows = 0;
	int64_t worstSeparatePanels = 0;
	for (int64_t core = 0; core < cores; ++core) {
		const int64_t whole = (commonWholeRows + wholeRows[core]) * panels;
		const int64_t separate = commonSeparatePanels + separatePanels[core];
		if (whole > worstWholeRows)
			worstWholeRows = whole;
		if (separate > worstSeparatePanels)
			worstSeparatePanels = separate;
	}
	return worstWholeRows < 2 * worstSeparatePanels;
}

template <int TM, int TN>
__aicore__ inline void Compute(GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR group_list, GM_ADDR y,
															 GM_ADDR workspace, int64_t m, int64_t k, int64_t n, int64_t e,
															 int64_t fixedSlabs, int64_t bPitch) {
	const int64_t inputK = k;
	const bool padA = k % 32 != 0;
	if (padA)
		k = (k + 31) / 32 * 32;
	const bool packB = bPitch != n || padA;
	using Cfg = Config<TM, TN>;
	using MM = typename Cfg::MM;
	constexpr int TILE_M = TM, TILE_N = TN;
	constexpr int VEC_CHUNK_M = Cfg::VEC_CHUNK_M;
	constexpr uint16_t GMM_SYNC_AIV_AIC = 3, GMM_SYNC_AIC_AIV = 5;
	constexpr uint64_t SYNC_MODE2 = 2;
	using namespace gmm_common;
	using namespace AscendC;
	const uint32_t coreNum = static_cast<uint32_t>(GetBlockNum());
	const uint32_t coreIdx = CoreGroupIndex();
	const uint32_t subIdx = SubCoreIndex();
	GlobalTensor<int8_t> xGm;
	GlobalTensor<int8_t> wGm;
	GlobalTensor<float> scaleGm;
	GlobalTensor<int64_t> glGm;
	GlobalTensor<int32_t> cGm;
	GlobalTensor<half> yGm;
	const int64_t cWorkspaceBytes = static_cast<int64_t>(coreNum) * 4 * TILE_M * TILE_N * 4;
	__gm__ int8_t *packedBase = reinterpret_cast<__gm__ int8_t *>(workspace) + cWorkspaceBytes;
	xGm.SetGlobalBuffer(padA ? packedBase + e * k * bPitch : reinterpret_cast<__gm__ int8_t *>(x), m * k);
	wGm.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t *>(weight), e * inputK * n);
	scaleGm.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(scale), e * n);
	glGm.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t *>(group_list), e);
	cGm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t *>(workspace),
											static_cast<int64_t>(coreNum) * 4 * TILE_M * TILE_N);
	yGm.SetGlobalBuffer(reinterpret_cast<__gm__ half *>(y), m * n);
	GlobalTensor<int8_t> wPadGm;
	const int64_t cBytes = static_cast<int64_t>(coreNum) * 4 * TILE_M * TILE_N * 4;
	wPadGm.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t *>(workspace) + cBytes, e * k * bPitch);
	int64_t activeExperts[128], activeCount = 0;
	int64_t groupEnds[128];
	int64_t tileEnds[128];
	int64_t totalMTiles = 0;
	int64_t previousEnd = 0;
	if (fixedSlabs && !packB) {
		totalMTiles = CeilDiv(m, fixedSlabs);
	} else {
		for (int64_t expert = 0; expert < e; ++expert) {
			const int64_t end = glGm.GetValue(expert);
			if (end > previousEnd)
				activeExperts[activeCount++] = expert;
			if (expert < 128)
				groupEnds[expert] = end;
			totalMTiles += CeilDiv(end - previousEnd, TILE_M);
			if (expert < 128)
				tileEnds[expert] = totalMTiles;
			previousEnd = end;
		}
	}
	if (fixedSlabs)
		totalMTiles = CeilDiv(m, fixedSlabs);
	const int64_t N_TILES = (n + TILE_N - 1) / TILE_N;
	const bool equalApiWaves = CeilDiv(totalMTiles, static_cast<int64_t>(coreNum)) * N_TILES <=
														 CeilDiv(totalMTiles * N_TILES, static_cast<int64_t>(coreNum));

	const bool useWorkAssign =
			equalApiWaves && (fixedSlabs != 0 || KeepWholeRowOwnership(groupEnds, e, TILE_M, TILE_N, n, coreNum));
	const int64_t totalTasks = useWorkAssign ? totalMTiles : totalMTiles * N_TILES;
	TPipe pipe;
	if ASCEND_IS_AIC {
		MM mm;
		mm.SetSubBlockIdx(0);
		mm.Init(static_cast<TCubeTiling *>(nullptr), &pipe);
		if (packB)
			SyncAll<false>();
		int64_t iter = 0;
		int64_t slot = 0;
		for (int64_t wave = 0; wave < CeilDiv(totalTasks, static_cast<int64_t>(coreNum)); ++wave) {
			const int64_t lane = (useWorkAssign || bPitch % TILE_N == 0)
															 ? static_cast<int64_t>(coreIdx)
															 : (static_cast<int64_t>(coreIdx) + coreNum - wave % coreNum) % coreNum;
			const int64_t task = wave * coreNum + lane;
			if (task >= totalTasks)
				continue;
			const int64_t work = useWorkAssign ? task : task / N_TILES;
			const int64_t ownedN = useWorkAssign ? 0 : task % N_TILES;
			int64_t ei = 0, groupStart = 0, firstTile = 0;
			int64_t start = 0, workEnd = 0;
			if (fixedSlabs) {
				start = work * fixedSlabs;
				workEnd = start + fixedSlabs < m ? start + fixedSlabs : m;
				const int64_t hint = start * e / m;
				const int64_t hintBegin = hint == 0 ? 0 : glGm.GetValue(hint - 1);
				const int64_t hintEnd = glGm.GetValue(hint);
				if (hintBegin <= start && start < hintEnd)
					ei = hint;
				else {
					int64_t lo = 0, hi = e;
					while (lo < hi) {
						const int64_t mid = (lo + hi) / 2;
						if (glGm.GetValue(mid) <= start)
							lo = mid + 1;
						else
							hi = mid;
					}
					ei = lo;
				}
			} else {
				if (e <= 128) {
					int64_t lo = 0, hi = e;
					while (lo < hi) {
						const int64_t mid = (lo + hi) / 2;
						if (tileEnds[mid] <= work)
							lo = mid + 1;
						else
							hi = mid;
					}
					ei = lo;
					groupStart = ei == 0 ? 0 : groupEnds[ei - 1];
					firstTile = ei == 0 ? 0 : tileEnds[ei - 1];
				} else {
					for (; ei < e; ++ei) {
						const int64_t groupEnd = glGm.GetValue(ei);
						const int64_t tiles = CeilDiv(groupEnd - groupStart, TILE_M);
						if (work < firstTile + tiles)
							break;
						firstTile += tiles;
						groupStart = groupEnd;
					}
				}
				start = groupStart + (work - firstTile) * TILE_M;
				const int64_t groupEnd = e <= 128 ? groupEnds[ei] : glGm.GetValue(ei);
				workEnd = start + TILE_M < groupEnd ? start + TILE_M : groupEnd;
			}
			while (start < workEnd) {
				const int64_t groupEnd = !fixedSlabs && e <= 128 ? groupEnds[ei] : glGm.GetValue(ei);
				const int64_t segmentEnd = groupEnd < workEnd ? groupEnd : workEnd;
				const int64_t me = segmentEnd - start;
				const int64_t rowBase = start;
				const int64_t curM = me;
				for (int64_t ni = ownedN; ni < (useWorkAssign ? N_TILES : ownedN + 1); ++ni) {
					const int64_t colBase = ni * TILE_N;
					const int64_t curN = bPitch - colBase < TILE_N ? bPitch - colBase : TILE_N;
					const bool seqC = false;
					if (iter >= 4) {
						CrossCoreWaitFlag(GMM_SYNC_AIV_AIC);
					}
					mm.SetOrgShape(me, bPitch, k, k, TILE_N);
					mm.SetSingleShape(curM, curN, k);
					mm.SetTensorA(xGm[rowBase * k], false);
					if (packB)
						mm.SetTensorB(wPadGm[ei * k * bPitch + colBase], false);
					else
						mm.SetTensorB(wGm[ei * k * n + colBase], false);
					while (mm.Iterate()) {
						mm.GetTensorC(cGm[(static_cast<int64_t>(coreIdx) * 4 + slot) * TILE_M * TILE_N], 0, seqC);
					}
					CrossCoreSetFlag<SYNC_MODE2, PIPE_FIX>(GMM_SYNC_AIC_AIV);
					slot = (slot + 1) & 3;
					++iter;
				}
				start = segmentEnd;
				if (start < workEnd) {
					do {
						++ei;
					} while (ei < e && glGm.GetValue(ei) <= start);
				}
			}
		}
	} else {
		if (packB) {

			constexpr int64_t stageBytes = 65536;
			TBuf<TPosition::VECCALC> copyBuffer;
			pipe.InitBuffer(copyBuffer, 2 * stageBytes);
			LocalTensor<int8_t> copy = copyBuffer.Get<int8_t>();
			GlobalTensor<int8_t> originalX;
			originalX.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t *>(x), m * inputK);
			const event_t loadEvents[2] = {static_cast<event_t>(pipe.AllocEventID<HardEvent::MTE2_MTE3>()),
																		 static_cast<event_t>(pipe.AllocEventID<HardEvent::MTE2_MTE3>())};
			const event_t storeEvents[2] = {static_cast<event_t>(pipe.AllocEventID<HardEvent::MTE3_MTE2>()),
																			static_cast<event_t>(pipe.AllocEventID<HardEvent::MTE3_MTE2>())};
			SetFlag<HardEvent::MTE3_MTE2>(storeEvents[0]);
			SetFlag<HardEvent::MTE3_MTE2>(storeEvents[1]);
			const int64_t aivNum = coreNum * GetTaskRation();
			const int64_t aivIdx = GetBlockIdx();
			int stage = 0;
			for (int matrix = 0; matrix < (padA ? 2 : 1); ++matrix) {
				const int64_t width = matrix == 0 ? n : inputK;
				const int64_t pitch = matrix == 0 ? bPitch : k;
				const int64_t totalRows = matrix == 0 ? activeCount * inputK : m;
				const int64_t perCore = CeilDiv(totalRows, aivNum);
				int64_t row = aivIdx * perCore;
				const int64_t rowEnd = row + perCore < totalRows ? row + perCore : totalRows;
				const int64_t batchRows = stageBytes / pitch;
				while (row < rowEnd) {
					const int64_t localRow = matrix == 0 ? row % inputK : row;
					const int64_t expert = matrix == 0 ? activeExperts[row / inputK] : 0;
					int64_t rows = rowEnd - row;
					if (matrix == 0 && rows > inputK - localRow)
						rows = inputK - localRow;
					if (rows > batchRows)
						rows = batchRows;
					LocalTensor<int8_t> buffer = copy[stage * stageBytes];
					WaitFlag<HardEvent::MTE3_MTE2>(storeEvents[stage]);
					DataCopyExtParams load{static_cast<uint16_t>(rows), static_cast<uint32_t>(width), 0, 0, 0};
					DataCopyPadExtParams<int8_t> pad{true, 0, 0, 0};
					if (matrix == 0)
						DataCopyPad(buffer, wGm[(expert * inputK + localRow) * n], load, pad);
					else
						DataCopyPad(buffer, originalX[row * inputK], load, pad);
					SetFlag<HardEvent::MTE2_MTE3>(loadEvents[stage]);
					WaitFlag<HardEvent::MTE2_MTE3>(loadEvents[stage]);
					DataCopyExtParams store{1, static_cast<uint32_t>(rows * pitch), 0, 0, 0};
					if (matrix == 0)
						DataCopyPad(wPadGm[(expert * k + localRow) * bPitch], buffer, store);
					else
						DataCopyPad(xGm[row * k], buffer, store);
					SetFlag<HardEvent::MTE3_MTE2>(storeEvents[stage]);
					row += rows;
					stage ^= 1;
				}
			}
			WaitFlag<HardEvent::MTE3_MTE2>(storeEvents[0]);
			WaitFlag<HardEvent::MTE3_MTE2>(storeEvents[1]);
			pipe.ReleaseEventID<HardEvent::MTE2_MTE3>(loadEvents[0]);
			pipe.ReleaseEventID<HardEvent::MTE2_MTE3>(loadEvents[1]);
			pipe.ReleaseEventID<HardEvent::MTE3_MTE2>(storeEvents[0]);
			pipe.ReleaseEventID<HardEvent::MTE3_MTE2>(storeEvents[1]);
			if (padA) {

				SetFlag<HardEvent::MTE2_V>(0);
				WaitFlag<HardEvent::MTE2_V>(0);
				Duplicate(copy.ReinterpretCast<int16_t>(), static_cast<int16_t>(0), stageBytes / 2);
				SetFlag<HardEvent::V_MTE3>(0);
				WaitFlag<HardEvent::V_MTE3>(0);
				for (int64_t active = aivIdx; active < activeCount; active += aivNum) {
					const int64_t expert = activeExperts[active];
					for (int64_t row = inputK; row < k;) {
						const int64_t rows = k - row < stageBytes / bPitch ? k - row : stageBytes / bPitch;
						DataCopyExtParams zero{1, static_cast<uint32_t>(rows * bPitch), 0, 0, 0};
						DataCopyPad(wPadGm[(expert * k + row) * bPitch], copy, zero);
						row += rows;
					}
				}
				SetFlag<HardEvent::MTE3_S>(0);
				WaitFlag<HardEvent::MTE3_S>(0);
			}
			pipe.Reset();
			SyncAll<false>();
		}
		TQue<TPosition::VECIN, 1> cQue;
		TQue<TPosition::VECIN, 1> sQue;
		TQue<TPosition::VECOUT, 1> oQue;
		TBuf<TPosition::VECCALC> zBuf;
		TBuf<TPosition::VECCALC> uBuf;
		TBuf<TPosition::VECCALC> tBuf;
		TBuf<TPosition::VECCALC> dBuf;
		TBuf<TPosition::VECCALC> sMulBuf;
		constexpr uint32_t CHUNK_ELEMS = VEC_CHUNK_M * TILE_N;
		pipe.InitBuffer(cQue, 1, CHUNK_ELEMS * sizeof(int32_t));
		pipe.InitBuffer(sQue, 1, TILE_N * sizeof(float));
		pipe.InitBuffer(oQue, 1, CHUNK_ELEMS * sizeof(half));
		pipe.InitBuffer(zBuf, CHUNK_ELEMS * sizeof(float));
		pipe.InitBuffer(uBuf, CHUNK_ELEMS * sizeof(float));
		pipe.InitBuffer(tBuf, CHUNK_ELEMS * sizeof(float));
		pipe.InitBuffer(dBuf, CHUNK_ELEMS * sizeof(float));
		pipe.InitBuffer(sMulBuf, CHUNK_ELEMS * sizeof(float));
		LocalTensor<float> z = zBuf.Get<float>();
		LocalTensor<float> u = uBuf.Get<float>();
		LocalTensor<float> t = tBuf.Get<float>();
		LocalTensor<float> d = dBuf.Get<float>();
		LocalTensor<float> sMul = sMulBuf.Get<float>();
		Duplicate(d, 1.0f, static_cast<int32_t>(CHUNK_ELEMS));
		int64_t iter = 0;
		int64_t slot = 0;
		for (int64_t wave = 0; wave < CeilDiv(totalTasks, static_cast<int64_t>(coreNum)); ++wave) {
			const int64_t lane = (useWorkAssign || bPitch % TILE_N == 0)
															 ? static_cast<int64_t>(coreIdx)
															 : (static_cast<int64_t>(coreIdx) + coreNum - wave % coreNum) % coreNum;
			const int64_t task = wave * coreNum + lane;
			if (task >= totalTasks)
				continue;
			const int64_t work = useWorkAssign ? task : task / N_TILES;
			const int64_t ownedN = useWorkAssign ? 0 : task % N_TILES;
			int64_t ei = 0, groupStart = 0, firstTile = 0;
			int64_t start = 0, workEnd = 0;
			if (fixedSlabs) {
				start = work * fixedSlabs;
				workEnd = start + fixedSlabs < m ? start + fixedSlabs : m;
				const int64_t hint = start * e / m;
				const int64_t hintBegin = hint == 0 ? 0 : glGm.GetValue(hint - 1);
				const int64_t hintEnd = glGm.GetValue(hint);
				if (hintBegin <= start && start < hintEnd)
					ei = hint;
				else {
					int64_t lo = 0, hi = e;
					while (lo < hi) {
						const int64_t mid = (lo + hi) / 2;
						if (glGm.GetValue(mid) <= start)
							lo = mid + 1;
						else
							hi = mid;
					}
					ei = lo;
				}
			} else {
				if (e <= 128) {
					int64_t lo = 0, hi = e;
					while (lo < hi) {
						const int64_t mid = (lo + hi) / 2;
						if (tileEnds[mid] <= work)
							lo = mid + 1;
						else
							hi = mid;
					}
					ei = lo;
					groupStart = ei == 0 ? 0 : groupEnds[ei - 1];
					firstTile = ei == 0 ? 0 : tileEnds[ei - 1];
				} else {
					for (; ei < e; ++ei) {
						const int64_t groupEnd = glGm.GetValue(ei);
						const int64_t tiles = CeilDiv(groupEnd - groupStart, TILE_M);
						if (work < firstTile + tiles)
							break;
						firstTile += tiles;
						groupStart = groupEnd;
					}
				}
				start = groupStart + (work - firstTile) * TILE_M;
				const int64_t groupEnd = e <= 128 ? groupEnds[ei] : glGm.GetValue(ei);
				workEnd = start + TILE_M < groupEnd ? start + TILE_M : groupEnd;
			}
			while (start < workEnd) {
				const int64_t groupEnd = !fixedSlabs && e <= 128 ? groupEnds[ei] : glGm.GetValue(ei);
				const int64_t segmentEnd = groupEnd < workEnd ? groupEnd : workEnd;
				const int64_t me = segmentEnd - start;
				const int64_t tileRowBase = 0;
				const int64_t curM = me;
				const int64_t rowsPerSub = CeilDiv(curM, 2);
				const int64_t subRowBegin = subIdx * rowsPerSub;
				const int64_t subRowEnd = (subRowBegin < curM)
																			? ((subRowBegin + rowsPerSub < curM) ? subRowBegin + rowsPerSub : curM)
																			: subRowBegin;
				for (int64_t ni = ownedN; ni < (useWorkAssign ? N_TILES : ownedN + 1); ++ni) {
					const int64_t colBase = ni * TILE_N;
					const int64_t curN = bPitch - colBase < TILE_N ? bPitch - colBase : TILE_N;
					const int64_t validN = ((colBase + curN) <= n) ? curN : (n - colBase);
					const bool seqC = false;
					LocalTensor<float> s = sQue.AllocTensor<float>();
					DataCopyExtParams sp;
					sp.blockCount = 1;
					sp.blockLen = validN * sizeof(float);
					sp.srcStride = 0;
					sp.dstStride = 0;
					DataCopyPadExtParams<float> spad;
					spad.isPad = true;
					spad.leftPadding = 0;
					spad.rightPadding = 0;
					spad.paddingValue = 0;
					DataCopyPad(s, scaleGm[ei * n + colBase], sp, spad);
					sQue.EnQue(s);
					CrossCoreWaitFlag(GMM_SYNC_AIC_AIV);
					const int64_t cSlotBase = (static_cast<int64_t>(coreIdx) * 4 + slot) * TILE_M * TILE_N;
					if (subRowBegin < subRowEnd) {
						s = sQue.DeQue<float>();
						const int64_t alignedN = ((validN + 7) / 8) * 8;
						const int64_t alignedHalfN = ((validN + 15) / 16) * 16;
						const int64_t smStride = ((validN % 16) == 0) ? validN : alignedHalfN;
						const int64_t smRows =
								((subRowEnd - subRowBegin) < VEC_CHUNK_M) ? (subRowEnd - subRowBegin) : VEC_CHUNK_M;
						for (int64_t rr = 0; rr < smRows; ++rr) {
							Adds(sMul[rr * smStride], s, 0.0f, static_cast<int32_t>(smStride));
						}
						for (int64_t row = subRowBegin; row < subRowEnd; row += VEC_CHUNK_M) {
							const int64_t rc = (row + VEC_CHUNK_M < subRowEnd) ? VEC_CHUNK_M : (subRowEnd - row);
							const int64_t total = rc * validN;
							const int64_t globalRow = start + tileRowBase + row;
							if ((validN % 16) == 0) {
								LocalTensor<int32_t> c = cQue.AllocTensor<int32_t>();
								DataCopyExtParams cp;
								cp.blockCount = static_cast<uint32_t>(rc);
								cp.blockLen = validN * sizeof(int32_t);
								cp.srcStride = (TILE_N - validN) * sizeof(int32_t);
								cp.dstStride = 0;
								DataCopyPadExtParams<int32_t> cpad;
								cpad.isPad = true;
								cpad.leftPadding = 0;
								cpad.rightPadding = 0;
								cpad.paddingValue = 0;
								DataCopyPad(c, cGm[cSlotBase + (row * TILE_N)], cp, cpad);
								cQue.EnQue(c);
								c = cQue.DeQue<int32_t>();
								Cast(z, c, RoundMode::CAST_NONE, static_cast<int32_t>(total));
								cQue.FreeTensor(c);
								PipeBarrier<PIPE_V>();
								Mul(z, z, sMul, static_cast<int32_t>(total));
								GeluComputeSigmoid(z, u, t, d, static_cast<int32_t>(total));
								PipeBarrier<PIPE_V>();
								LocalTensor<half> o = oQue.AllocTensor<half>();
								Cast(o, u, RoundMode::CAST_NONE, static_cast<int32_t>(total));
								oQue.EnQue(o);
								o = oQue.DeQue<half>();
								DataCopyExtParams op;
								op.blockCount = static_cast<uint32_t>(rc);
								op.blockLen = validN * sizeof(half);
								op.srcStride = 0;
								op.dstStride = (n - validN) * sizeof(half);
								DataCopyPad(yGm[globalRow * n + colBase], o, op);
								oQue.FreeTensor(o);
							} else {
								const int64_t azN = alignedHalfN;
								LocalTensor<int32_t> c = cQue.AllocTensor<int32_t>();
								DataCopyExtParams cp;
								cp.blockCount = static_cast<uint16_t>(rc);
								cp.blockLen = validN * sizeof(int32_t);
								cp.srcStride = (TILE_N - validN) * sizeof(int32_t);
								cp.dstStride = static_cast<uint32_t>((azN - alignedN) / 8);
								DataCopyPadExtParams<int32_t> cpad;
								cpad.isPad = true;
								cpad.leftPadding = 0;
								cpad.rightPadding = 0;
								cpad.paddingValue = 0;
								DataCopyPad(c, cGm[cSlotBase + (row * TILE_N)], cp, cpad);
								cQue.EnQue(c);
								c = cQue.DeQue<int32_t>();
								Cast(z, c, RoundMode::CAST_NONE, static_cast<int32_t>(rc * azN));
								cQue.FreeTensor(c);
								PipeBarrier<PIPE_V>();
								Mul(z, z, sMul, static_cast<int32_t>(rc * azN));
								GeluComputeSigmoid(z, u, t, d, static_cast<int32_t>(rc * azN));
								PipeBarrier<PIPE_V>();
								LocalTensor<half> o = oQue.AllocTensor<half>();
								Cast(o, u, RoundMode::CAST_NONE, static_cast<int32_t>(rc * azN));
								oQue.EnQue(o);
								o = oQue.DeQue<half>();
								DataCopyExtParams op;
								op.blockCount = static_cast<uint16_t>(rc);
								op.blockLen = validN * sizeof(half);
								op.srcStride = 0;
								op.dstStride = (n - validN) * sizeof(half);
								DataCopyPad(yGm[globalRow * n + colBase], o, op);
								oQue.FreeTensor(o);
							}
						}
						sQue.FreeTensor(s);
					} else {
						s = sQue.DeQue<float>();
						sQue.FreeTensor(s);
					}
					CrossCoreSetFlag<SYNC_MODE2, PIPE_MTE2>(GMM_SYNC_AIV_AIC);
					slot = (slot + 1) & 3;
					++iter;
				}
				start = segmentEnd;
				if (start < workEnd) {
					do {
						++ei;
					} while (ei < e && glGm.GetValue(ei) <= start);
				}
			}
		}
	}
}

}
