__global__ __mix__(1, 2) void gmm_generic_narrow32(GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR g, GM_ADDR y,
																									 GM_ADDR workspace, int64_t m, int64_t k, int64_t n,
																									 int64_t e, int64_t fixedSlabs, int64_t bPitch) {
	gmm_tiles::Compute<128, 32>(x, w, s, g, y, workspace, m, k, n, e, fixedSlabs, bPitch);
}

__global__ __mix__(1, 2) void gmm_generic_narrow64(GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR g, GM_ADDR y,
																									 GM_ADDR workspace, int64_t m, int64_t k, int64_t n,
																									 int64_t e, int64_t fixedSlabs, int64_t bPitch) {
	gmm_tiles::Compute<128, 64>(x, w, s, g, y, workspace, m, k, n, e, fixedSlabs, bPitch);
}

inline double TerminalGenericNarrowCost(int64_t m, int64_t k, int64_t n, int64_t e, int64_t tileM,
																				int64_t tileN, int64_t tileK, int64_t coreBudget, int64_t &active,
																				int64_t &waves) {
	const int64_t q = m / e, r = m % e;
	const int64_t rowTiles = (e - r) * ((q + tileM - 1) / tileM) + r * ((q + tileM) / tileM);
	const int64_t colTiles = (n + tileN - 1) / tileN;
	const int64_t tasks = rowTiles * colTiles;
	active = tasks < coreBudget ? tasks : coreBudget;
	waves = (tasks + active - 1) / active;
	const double roundedRows = (e - r) * ((q + 15) / 16) * 16.0 + r * ((q + 16) / 16) * 16.0;
	const double roundedCols = ((n + 15) / 16) * 16.0;
	const double roundedK = ((k + 31) / 32) * 32.0;
	const double imbalance = static_cast<double>(waves * active) / tasks;
	const double compute = 2.0 * roundedRows * roundedCols * roundedK * imbalance / (active * 12.5e6);
	const double traffic =
			(static_cast<double>(rowTiles) * k * n + static_cast<double>(m) * k * colTiles) / 1e6;
	const double setup = waves * (0.35 + 0.05 * ((k + tileK - 1) / tileK));
	const int64_t vectorRows = tileN == 512 ? 8 : 16;
	const double epilogue = static_cast<double>(m) * colTiles / (2 * vectorRows * active) * 0.04;

	return compute + traffic + setup + epilogue;
}

inline bool TryLaunchTerminalGenericNarrow(GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR g, GM_ADDR y, int64_t m,
																					 int64_t k, int64_t n, int64_t e, int64_t originalTileM,
																					 int64_t originalTileN, int64_t originalTileK, int64_t coreBudget,
																					 aclrtStream stream) {
	if (k < 32 || n < 1 || n > 64)
		return false;
	constexpr int64_t tileM = 128;
	const int64_t tileN = n <= 32 ? 32 : 64;
	int64_t originalActive = 0, originalWaves = 0, narrowActive = 0, narrowWaves = 0;
	const double originalCost = TerminalGenericNarrowCost(
			m, k, n, e, originalTileM, originalTileN, originalTileK, coreBudget, originalActive, originalWaves);
	const double narrowCost =
			TerminalGenericNarrowCost(m, k, n, e, tileM, tileN, 128, coreBudget, narrowActive, narrowWaves);
	if (narrowActive < originalActive || narrowWaves > originalWaves || narrowCost > originalCost + 1e-4)
		return false;
	const int64_t maxNonempty = m < e ? m : e;
	const int64_t upperTasks = maxNonempty + (m - maxNonempty) / tileM;
	const int64_t cores = coreBudget < upperTasks ? coreBudget : upperTasks;
	const int64_t alignedN = (n + 31) / 32 * 32;
	const int64_t alignedK = (k + 31) / 32 * 32;
	const int64_t q = m / e, r = m % e;
	const int64_t estimatedRowTiles = (e - r) * ((q + tileM - 1) / tileM) + r * ((q + tileM) / tileM);
	const bool padA = k % 32 != 0;
	const bool padB = padA || n != alignedN;
	const int64_t bPitch = padB ? alignedN : n;
	const size_t cBytes = static_cast<size_t>(cores) * 4 * tileM * tileN * sizeof(int32_t);
	const size_t bytes = cBytes + (padB ? static_cast<size_t>(e) * alignedK * bPitch : 0) +
											 (padA ? static_cast<size_t>(m) * alignedK : 0);
	void *workspace = nullptr;
	if (aclrtMalloc(&workspace, bytes, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS)
		return false;

	constexpr int64_t fixedSlabs = 0;
	if (tileN == 32)
		gmm_generic_narrow32<<<cores, nullptr, stream>>>(x, w, s, g, y, (GM_ADDR)workspace, m, k, n, e,
																										 fixedSlabs, bPitch);
	else
		gmm_generic_narrow64<<<cores, nullptr, stream>>>(x, w, s, g, y, (GM_ADDR)workspace, m, k, n, e,
																										 fixedSlabs, bPitch);
	aclrtSynchronizeStream(stream);
	aclrtFree(workspace);
	return true;
}

namespace new5_short_k_v2 {
__aicore__ inline void Gelu(const AscendC::LocalTensor<float> &z, const AscendC::LocalTensor<float> &u,
														const AscendC::LocalTensor<float> &t, int count) {
	using namespace AscendC;
	Mul(u, z, z, count);
	PipeBarrier<PIPE_V>();
	Mul(u, u, z, count);
	PipeBarrier<PIPE_V>();
	Muls(u, u, 0.044715f, count);
	PipeBarrier<PIPE_V>();
	Add(u, u, z, count);
	PipeBarrier<PIPE_V>();
	Muls(t, u, -1.5957691216057308f, count);
	PipeBarrier<PIPE_V>();
	Exp(t, t, count);
	PipeBarrier<PIPE_V>();
	Adds(t, t, 1.0f, count);
	PipeBarrier<PIPE_V>();
	Div(u, z, t, count);
	PipeBarrier<PIPE_V>();
}
}

namespace new5_single_column_long_k_v3 {
__aicore__ inline void ReduceInt32(AscendC::LocalTensor<int32_t> values,
																	 AscendC::LocalTensor<int32_t> temporary,
																	 AscendC::LocalTensor<uint32_t> permutation, int width, int tree) {
	using namespace AscendC;
	if (width > tree) {
		Add(values, values, values[tree], width - tree);
		PipeBarrier<PIPE_V>();
	}
	for (int span = tree / 2; span >= 8; span /= 2) {
		Add(values, values, values[span], span);
		PipeBarrier<PIPE_V>();
	}
	for (int stage = 0; stage < 3; ++stage) {
		Gather(temporary, values, permutation[stage * 8], 0, 8);
		PipeBarrier<PIPE_V>();
		Add(values, values, temporary, 8);
		PipeBarrier<PIPE_V>();
	}
}
template <int ROWS, bool PREFETCH>
__aicore__ inline void Compute(GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR g, GM_ADDR y, int32_t m, int32_t k,
															 int32_t e) {
	using namespace AscendC;
	TPipe pipe;
	TBuf<TPosition::VECCALC> weights, data, tail, nextInput;
	pipe.InitBuffer(weights, 40960);
	pipe.InitBuffer(data, 114688);
	pipe.InitBuffer(nextInput, PREFETCH ? 16384 : 32);
	pipe.InitBuffer(tail, 58 * ROWS + 1184);
	auto wb = weights.Get<int8_t>();
	auto wi = weights.Get<int32_t>()[2048];
	auto xb = data.Get<int8_t>();
	auto nextXb = nextInput.Get<int8_t>();
	auto scratch = data.Get<half>()[8192];
	auto xi = data.Get<int32_t>()[12288];
	auto slots = tail.Get<int32_t>();
	auto z = tail.Get<float>()[8 * ROWS];
	auto u = tail.Get<float>()[9 * ROWS];
	auto t = tail.Get<float>()[10 * ROWS];
	auto out = tail.Get<half>()[22 * ROWS];
	auto groups = tail.Get<int64_t>()[(46 * ROWS) / 8];
	auto permutation = tail.Get<uint32_t>()[(46 * ROWS + 1024) / 4];
	auto temporary = tail.Get<int32_t>()[(46 * ROWS + 1120) / 4];
	auto index = tail.Get<int32_t>()[(46 * ROWS + 1152) / 4];
	auto zeros = tail.Get<uint32_t>()[(50 * ROWS + 1152) / 4];
	auto scaleInput = tail.Get<float>()[(54 * ROWS + 1152) / 4];
	auto scale = tail.Get<float>()[(54 * ROWS + 1184) / 4];
	for (int stage = 0; stage < 3; ++stage)
		for (int lane = 0; lane < 8; ++lane)
			permutation.SetValue(stage * 8 + lane, (lane ^ (4 >> stage)) * 4);
	SetFlag<HardEvent::S_V>(0);
	WaitFlag<HardEvent::S_V>(0);
	CreateVecIndex(index, int32_t(0), ROWS);
	PipeBarrier<PIPE_V>();
	Muls(index, index, int32_t(32), ROWS);
	Duplicate(zeros, uint32_t(0), ROWS);
	PipeBarrier<PIPE_V>();
	GlobalTensor<int8_t> xg, wg;
	GlobalTensor<float> sg;
	GlobalTensor<int64_t> gg;
	GlobalTensor<half> yg;
	xg.SetGlobalBuffer((__gm__ int8_t *)x, m * k);
	wg.SetGlobalBuffer((__gm__ int8_t *)w, e * k);
	sg.SetGlobalBuffer((__gm__ float *)s, e);
	gg.SetGlobalBuffer((__gm__ int64_t *)g, e);
	yg.SetGlobalBuffer((__gm__ half *)y, m);
	DataCopyExtParams copy{};
	copy.blockCount = 1;
	copy.blockLen = e * sizeof(int64_t);
	DataCopyPadExtParams<int64_t> gp{false, 0, 0, 0};
	DataCopyPad(groups, gg, copy, gp);
	SetFlag<HardEvent::MTE2_S>(0);
	WaitFlag<HardEvent::MTE2_S>(0);
	const int width = (k + 31) / 32 * 32;
	int tree = 256;
	while (tree * 2 <= width)
		tree *= 2;
	const int block = GetBlockIdx(), cores = GetBlockNum();
	int begin = 0, taskBase = 0;
	for (int expert = 0; expert < e; ++expert) {
		const int end = static_cast<int>(groups.GetValue(expert));
		const int tasks = (end - begin + ROWS - 1) / ROWS;
		const int first = (block + cores - taskBase % cores) % cores;
		if (first < tasks) {
			SetFlag<HardEvent::V_MTE2>(0);
			WaitFlag<HardEvent::V_MTE2>(0);
			copy.blockCount = 1;
			copy.blockLen = k;
			DataCopyPadExtParams<int8_t> ip{true, 0, static_cast<uint8_t>((32 - k % 32) % 32), 0};
			DataCopyPad(wb, wg[expert * k], copy, ip);
			copy.blockLen = sizeof(float);
			DataCopyPadExtParams<float> fp{true, 0, 0, 0};
			DataCopyPad(scaleInput, sg[expert], copy, fp);
			SetFlag<HardEvent::MTE2_V>(0);
			WaitFlag<HardEvent::MTE2_V>(0);
			Cast(scratch, wb, RoundMode::CAST_NONE, width);
			PipeBarrier<PIPE_V>();
			Cast(wi, scratch, RoundMode::CAST_RINT, width);
			Gather(scale, scaleInput, zeros, 0, ROWS);
			PipeBarrier<PIPE_V>();
		}
		for (int task = first; task < tasks; task += cores) {
			const int row = begin + task * ROWS;
			const int rows = end - row < ROWS ? end - row : ROWS;
			copy.blockCount = rows < 2 ? rows : 2;
			copy.blockLen = k;
			copy.srcStride = 0;
			copy.dstStride = 0;
			DataCopyPadExtParams<int8_t> ip{true, 0, static_cast<uint8_t>((32 - k % 32) % 32), 0};
			if (PREFETCH) {
				SetFlag<HardEvent::V_MTE2>(0);
				WaitFlag<HardEvent::V_MTE2>(0);
				DataCopyPad(xb, xg[row * k], copy, ip);
				SetFlag<HardEvent::MTE2_V>(0);
				WaitFlag<HardEvent::MTE2_V>(0);
			}
			for (int r = 0; r < rows; r += 2) {
				const int active = rows - r < 2 ? rows - r : 2;
				const int buffer = (r / 2) % 2;
				auto input = xb;
				if (PREFETCH) {
					input = buffer == 0 ? xb : nextXb;
					if (r > 0)
						WaitFlag<HardEvent::MTE2_V>(buffer);
				} else {
					copy.blockCount = active;
					SetFlag<HardEvent::V_MTE2>(0);
					WaitFlag<HardEvent::V_MTE2>(0);
					DataCopyPad(xb, xg[(row + r) * k], copy, ip);
					SetFlag<HardEvent::MTE2_V>(0);
					WaitFlag<HardEvent::MTE2_V>(0);
				}
				Cast(scratch, input, RoundMode::CAST_NONE, active * width);
				PipeBarrier<PIPE_V>();
				Cast(xi, scratch, RoundMode::CAST_RINT, active * width);
				PipeBarrier<PIPE_V>();
				if (PREFETCH && r + 2 < rows) {
					const int nextBuffer = 1 - buffer;
					auto destination = nextBuffer == 0 ? xb : nextXb;
					copy.blockCount = rows - r - 2 < 2 ? rows - r - 2 : 2;
					SetFlag<HardEvent::V_MTE2>(nextBuffer);
					WaitFlag<HardEvent::V_MTE2>(nextBuffer);
					DataCopyPad(destination, xg[(row + r + 2) * k], copy, ip);
					SetFlag<HardEvent::MTE2_V>(nextBuffer);
				}
				for (int rr = 0; rr < active; ++rr) {
					auto values = xi[rr * width];
					Mul(values, values, wi, width);
					PipeBarrier<PIPE_V>();
					ReduceInt32(values, temporary, permutation, width, tree);
					Adds(slots[(r + rr) * 8], values, int32_t(0), 8);
				}
			}
			PipeBarrier<PIPE_V>();
			Gather(z.ReinterpretCast<int32_t>(), slots, index.ReinterpretCast<uint32_t>(), 0, rows);
			PipeBarrier<PIPE_V>();
			Cast(z, z.ReinterpretCast<int32_t>(), RoundMode::CAST_NONE, rows);
			PipeBarrier<PIPE_V>();
			Mul(z, z, scale, rows);
			PipeBarrier<PIPE_V>();
			new5_short_k_v2::Gelu(z, u, t, rows);
			Cast(out, u, RoundMode::CAST_NONE, rows);
			SetFlag<HardEvent::V_MTE3>(0);
			WaitFlag<HardEvent::V_MTE3>(0);
			copy.blockCount = 1;
			copy.blockLen = rows * sizeof(half);
			copy.srcStride = 0;
			copy.dstStride = 0;
			DataCopyPad(yg[row], out, copy);
			SetFlag<HardEvent::MTE3_V>(0);
			WaitFlag<HardEvent::MTE3_V>(0);
		}
		begin = end;
		taskBase += tasks;
	}
}
} // namespace new5_single_column_long_k_v3
__global__ __aicore__ void new5_single_column_long_k_gmm(GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR g,
																												 GM_ADDR y, int32_t m, int32_t k, int32_t e) {
	KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
	if (m >= 2560)
		new5_single_column_long_k_v3::Compute<64, true>(x, w, s, g, y, m, k, e);
	else
		new5_single_column_long_k_v3::Compute<16, false>(x, w, s, g, y, m, k, e);
}

namespace gmm_host {
struct Tile {
	int64_t m, n, k;
};
static constexpr Tile tiles[] = {{32, 256, 128},	{64, 128, 128},	 {64, 256, 128},
																 {64, 384, 64},		{64, 512, 64},	 {96, 288, 64},
																 {128, 256, 128}, {160, 192, 128}, {256, 128, 128}};
inline int64_t DivUp(int64_t a, int64_t b) {
	return (a + b - 1) / b;
}
inline int Choose(int64_t m, int64_t k, int64_t n, int64_t e, int64_t cores) {
	const int64_t smallGroup = m / e, largerGroups = m % e;
	const double roundedRows =
			(e - largerGroups) * DivUp(smallGroup, 16) * 16.0 + largerGroups * DivUp(smallGroup + 1, 16) * 16.0;
	const double roundedCols = DivUp(n, 16) * 16.0;
	const double roundedK = DivUp(k, 32) * 32.0;
	int best = 0;
	double bestCost = 1e300;
	for (int index = 0; index < sizeof(tiles) / sizeof(tiles[0]); ++index) {
		const Tile t = tiles[index];
		const int64_t rowTiles =
				(e - largerGroups) * DivUp(smallGroup, t.m) + largerGroups * DivUp(smallGroup + 1, t.m);
		const int64_t colTiles = DivUp(n, t.n);
		const int64_t tasks = rowTiles * colTiles;
		const int64_t active = tasks < cores ? tasks : cores;
		const int64_t waves = DivUp(tasks, active);
		const double imbalance = static_cast<double>(waves * active) / tasks;
		const double compute = 2.0 * roundedRows * roundedCols * roundedK * imbalance / (active * 12.5e6);
		const double traffic =
				(static_cast<double>(rowTiles) * k * n + static_cast<double>(m) * k * colTiles) / 1e6;
		const double setup = waves * (0.35 + 0.05 * DivUp(k, t.k));
		const int64_t vectorRows = t.n == 512 ? 8 : 16;
		const double epilogue = static_cast<double>(m) * colTiles / (2 * vectorRows * active) * 0.04;
		const double footprintTieBreak = -t.m * t.n * 1e-10;
		const double cost = compute + traffic + setup + epilogue + footprintTieBreak;
		if (cost < bestCost) {
			bestCost = cost;
			best = index;
		}
	}
	return best;
}
}
struct Rg494ResidentResources {
	static constexpr int64_t M = 128, N = 256, B_K = 256, B_BANKS = 4, A_K_SLICE = 512, L1 = 512 * 1024;
};
enum class Rg494Algorithm { ApiFallback, ResidentStreamedB };
inline Rg494Algorithm Rg494SelectAlgorithm(int64_t m, int64_t k, int64_t n, int64_t e) {
	using R = Rg494ResidentResources;
	constexpr int64_t INDEX_MAX = 2147483647;
	if (m <= 0 || e <= 0 || k <= 0 || n <= 0 || k % R::A_K_SLICE != 0 || n % R::N != 0)
		return Rg494Algorithm::ApiFallback;
	const int64_t maxResidentK = (R::L1 - R::B_BANKS * R::B_K * R::N) / R::M;
	if (k > maxResidentK || n > INDEX_MAX || m > INDEX_MAX / k || m > INDEX_MAX / n || e > INDEX_MAX / (k * n))
		return Rg494Algorithm::ApiFallback;
	if (k / R::B_K <= R::B_BANKS)
		return Rg494Algorithm::ApiFallback;
	return Rg494Algorithm::ResidentStreamedB;
}
static bool admitted(int64_t m, int64_t k, int64_t n, int64_t e, int64_t available) {
	if (m < 1 || m > 8 || k < 1 || k > 32 || n < 1 || n > 128 || e < 1 || e > 128 || m >= e ||
			((n - 1) % 64 + 1) < 32)
		return false;
	int bits = 0;
	for (int64_t v = e; v; v >>= 1)
		++bits;
	const int64_t tasks = m * ((n + 63) / 64),
								budget = 2 * (available > 0 ? (available < 20 ? available : 20) : 1);
	return e > m * (bits + 2) && tasks >= 1 && tasks <= budget;
}
template <int SHORT_K>
inline void LaunchTinyShortDot(GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR g, GM_ADDR y, int64_t m, int64_t k,
															 int64_t n, int64_t e, aclrtStream stream) {
	switch (n) {
	case 1:
		gmm_tiny_vector<SHORT_K, 1><<<4, nullptr, stream>>>(x, w, s, g, y, m, k, n, e);
		break;
	case 2:
		gmm_tiny_vector<SHORT_K, 2><<<4, nullptr, stream>>>(x, w, s, g, y, m, k, n, e);
		break;
	case 3:
		gmm_tiny_vector<SHORT_K, 3><<<4, nullptr, stream>>>(x, w, s, g, y, m, k, n, e);
		break;
	case 4:
		gmm_tiny_vector<SHORT_K, 4><<<4, nullptr, stream>>>(x, w, s, g, y, m, k, n, e);
		break;
	case 5:
		gmm_tiny_vector<SHORT_K, 5><<<4, nullptr, stream>>>(x, w, s, g, y, m, k, n, e);
		break;
	case 6:
		gmm_tiny_vector<SHORT_K, 6><<<4, nullptr, stream>>>(x, w, s, g, y, m, k, n, e);
		break;
	case 7:
		gmm_tiny_vector<SHORT_K, 7><<<4, nullptr, stream>>>(x, w, s, g, y, m, k, n, e);
		break;
	case 8:
		gmm_tiny_vector<SHORT_K, 8><<<4, nullptr, stream>>>(x, w, s, g, y, m, k, n, e);
		break;
	default:
		gmm_tiny_vector<SHORT_K, 0><<<4, nullptr, stream>>>(x, w, s, g, y, m, k, n, e);
		break;
	}
}
template <int REDUCE_K>
