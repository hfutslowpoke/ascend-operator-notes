# CannJudge 环境变量示例。复制为 cannjudge/cann.env 后 source。
# 本文件不含 Cookie/Token。
export CANNJUDGE_API="${CANNJUDGE_API:-https://cannjudge.cn/api}"
export CANNJUDGE_ACCOUNT_FILE="${CANNJUDGE_ACCOUNT_FILE:-$HOME/.config/cannjudge/accounts.json}"
export CANNJUDGE_USE_PROXY="${CANNJUDGE_USE_PROXY:-0}"
export ACW_ALLOW_SUBMIT="${ACW_ALLOW_SUBMIT:-0}"
