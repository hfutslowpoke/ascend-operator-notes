// Forward declarations for the Cube path kernels, which are defined further
// down this file but launched from run_kernel above them. The BMM body is a
// template; these thin __global__ wrappers pin the two input types.
#define BMMS_CUBE_DECL(NAME)                                                   \
extern "C" __global__ __aicore__ void NAME(                                    \
    GM_ADDR ga, GM_ADDR gb, GM_ADDR gc,                                        \
    int64_t B, int64_t M, int64_t N, int64_t K,                                \
    int64_t baseM, int64_t baseN);
BMMS_CUBE_DECL(bmms_cube_fp16_00)
BMMS_CUBE_DECL(bmms_cube_fp16_10)
BMMS_CUBE_DECL(bmms_cube_fp16_01)
BMMS_CUBE_DECL(bmms_cube_fp16_11)
BMMS_CUBE_DECL(bmms_cube_bf16_00)
BMMS_CUBE_DECL(bmms_cube_bf16_10)
BMMS_CUBE_DECL(bmms_cube_bf16_01)
BMMS_CUBE_DECL(bmms_cube_bf16_11)
extern "C" __global__ __vector__ void bmms_max_n(
    GM_ADDR gc, GM_ADDR growMax, int64_t B, int64_t M, int64_t N,
    int64_t baseM, int64_t baseN);

// Fused cube+vector entry points (defined with the MIX kernel below).
#define BMMS_MIX_DECL(NAME)                                                    \
extern "C" __global__ __aicore__ void NAME(                                    \
    GM_ADDR ga, GM_ADDR gb, GM_ADDR gc, GM_ADDR gy, GM_ADDR gws,               \
    int64_t B, int64_t M, int64_t N, int64_t K,                                \
    int64_t baseM, int64_t baseN);
BMMS_MIX_DECL(bmms_p1_mixcube_fp16_00)
BMMS_MIX_DECL(bmms_p1_mixcube_fp16_10)
BMMS_MIX_DECL(bmms_p1_mixcube_fp16_01)
BMMS_MIX_DECL(bmms_p1_mixcube_fp16_11)
BMMS_MIX_DECL(bmms_p1_mixcube_bf16_00)
BMMS_MIX_DECL(bmms_p1_mixcube_bf16_10)
BMMS_MIX_DECL(bmms_p1_mixcube_bf16_01)
BMMS_MIX_DECL(bmms_p1_mixcube_bf16_11)


#include "adv_api/matmul_intf.h"
using namespace AscendC;


// ---- Kernel A: cube BMM, one core walks every (b, m-tile, n-tile) -----------
// Templated on the input element type so bf16 can use the cube cores too. bf16
// has no vectorised fast path on this part (vconv_bf162f32 runs at a fraction
// of the fp16 rate and the whole product must be re-read per row), so the
// vector route TLEs on large shapes; the cube route is the only viable one.
template <typename IN_T, bool TX1, bool TX2>
__aicore__ inline void BmmsCubeBmm(
    GM_ADDR ga, GM_ADDR gb, GM_ADDR gc,
    int64_t B, int64_t M, int64_t N, int64_t K,
    int64_t baseM, int64_t baseN)
{
    // The transpose is applied at the operand level, not in the type: the type
    // stays isTrans=false and the layout flag goes to SetTensorA/SetTensorB as
    // their isTranspose argument. That is the control the matmul pipeline
    // actually reads; putting it in MatmulType left the operand interpreted as
    // a plain [M,K] rectangle and silently produced A^T-free results.
    using AType = MatmulType<TPosition::GM, CubeFormat::ND, IN_T, false>;
    using BType = MatmulType<TPosition::GM, CubeFormat::ND, IN_T, false>;
    using CType = MatmulType<TPosition::GM, CubeFormat::ND, float, false>;
    using BiasType = MatmulType<TPosition::GM, CubeFormat::ND, float, false>;
    MatmulImpl<AType, BType, CType, BiasType, CFG_NORM> mm;

    const int32_t m = (int32_t)M, n = (int32_t)N, k = (int32_t)K;
    const int32_t bm = (int32_t)baseM, bn = (int32_t)baseN;

    TCubeTiling t;
    t.usedCoreNum = 1;
    t.M = m; t.N = n; t.Ka = k; t.Kb = k;
    t.singleCoreM = bm; t.singleCoreN = bn; t.singleCoreK = k;
    // baseK sets how much of the K axis L1 stages per round; larger baseK
    // means fewer L1 reloads (K/baseK) per tile. 64 keeps A+B at
    // 2*baseM*baseK bytes = 32KB for a 128-wide tile, well inside L1.
    t.baseM = bm; t.baseN = bn; t.baseK = 128;
    t.depthA1 = 2; t.depthB1 = 2;
    t.stepM = 1; t.stepN = 1;
    t.isBias = 0; t.transLength = 0; t.iterateOrder = 0;
    t.shareMode = 0; t.shareL1Size = 0; t.shareL0CSize = 0; t.shareUbSize = 0;
    t.batchM = 0; t.batchN = 0; t.singleBatchM = 0; t.singleBatchN = 0;
    t.stepKa = 1; t.stepKb = 1;
    t.depthAL1CacheUB = 0; t.depthBL1CacheUB = 0;
    t.dbL0A = 1; t.dbL0B = 1; t.dbL0C = 1;

    GlobalTensor<IN_T>  ag; ag.SetGlobalBuffer((__gm__ IN_T*)ga);
    GlobalTensor<IN_T>  bg; bg.SetGlobalBuffer((__gm__ IN_T*)gb);
    GlobalTensor<float> cg; cg.SetGlobalBuffer((__gm__ float*)gc);
    TPipe pipe;

    // Multi-core: the work items are (b, mTile, nTile) matmuls. Each core
    // claims a strided slice of that flat space, so the 20 cube cores share the
    // batches and tiles. (Single-core here measured 314us..5.9ms on the perf
    // shapes: a 64x64x64 matmul every ~4us times hundreds of serial tiles.)
    mm.SetSubBlockIdx(0);
    mm.Init(&t, &pipe);

    const int64_t mTiles = (M + bm - 1) / bm;
    const int64_t nTiles = (N + bn - 1) / bn;
    const int64_t items  = B * mTiles * nTiles;
    const int64_t core   = (int64_t)GetBlockIdx();
    const int64_t nCores = (int64_t)GetBlockNum();

    for (int64_t w = core; w < items; w += nCores) {
        const int64_t nTile = w % nTiles;
        const int64_t rem   = w / nTiles;
        const int64_t mTile = rem % mTiles;
        const int64_t b     = rem / mTiles;
        const int64_t m0 = mTile * bm;
        const int64_t n0 = nTile * bn;
        const int32_t mNow = (int32_t)(((M - m0) < bm) ? (M - m0) : bm);
        const int32_t nNow = (int32_t)(((N - n0) < bn) ? (N - n0) : bn);

        GlobalTensor<IN_T> aB = ag[static_cast<uint64_t>(b) * (uint64_t)M * (uint64_t)K];
        GlobalTensor<IN_T> bB = bg[static_cast<uint64_t>(b) * (uint64_t)K * (uint64_t)N];

        mm.SetOrgShape(m, n, k);
        mm.SetSingleShape(bm, bn, k);
        mm.SetTail(mNow, nNow, k);
        // With isTransposeA the operand is a KxM rectangle whose logical rows
        // are the stored columns, so row m0 begins at linear offset m0. Same
        // idea for B: a transposed x2 is [N,K] and column n0 begins at row n0,
        // i.e. offset n0*K.
        const uint64_t aOff = TX1 ? static_cast<uint64_t>(m0)
                                  : static_cast<uint64_t>(m0) * (uint64_t)K;
        const uint64_t bOff = TX2 ? static_cast<uint64_t>(n0) * (uint64_t)K
                                  : static_cast<uint64_t>(n0);
        mm.SetTensorA(aB[aOff], TX1);
        mm.SetTensorB(bB[bOff], TX2);

        // Packed C plane: this tile's top-left inside the [B,M,N] batch.
        GlobalTensor<float> cTile =
            cg[(static_cast<uint64_t>(b) * (uint64_t)M * (uint64_t)N) +
               (static_cast<uint64_t>(m0) * (uint64_t)N) + static_cast<uint64_t>(n0)];
        while (mm.Iterate()) {
            mm.GetTensorC(cTile, 0, false);
        }
    }
    mm.End();
}

#define DEFINE_BMMS_CUBE_WRAPPER(NAME, IN_T, TX1, TX2)                          \
extern "C" __global__ __aicore__ void NAME(                                    \
    GM_ADDR ga, GM_ADDR gb, GM_ADDR gc,                                        \
    int64_t B, int64_t M, int64_t N, int64_t K,                                \
    int64_t baseM, int64_t baseN)                                              \
{                                                                              \
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIC_ONLY);                            \
    BmmsCubeBmm<IN_T, TX1, TX2>(ga, gb, gc, B, M, N, K, baseM, baseN);         \
}

DEFINE_BMMS_CUBE_WRAPPER(bmms_cube_fp16_00, half,       false, false)
DEFINE_BMMS_CUBE_WRAPPER(bmms_cube_fp16_10, half,       true,  false)
DEFINE_BMMS_CUBE_WRAPPER(bmms_cube_fp16_01, half,       false, true)
DEFINE_BMMS_CUBE_WRAPPER(bmms_cube_fp16_11, half,       true,  true)
DEFINE_BMMS_CUBE_WRAPPER(bmms_cube_bf16_00, bfloat16_t, false, false)
DEFINE_BMMS_CUBE_WRAPPER(bmms_cube_bf16_10, bfloat16_t, true,  false)
DEFINE_BMMS_CUBE_WRAPPER(bmms_cube_bf16_01, bfloat16_t, false, true)
DEFINE_BMMS_CUBE_WRAPPER(bmms_cube_bf16_11, bfloat16_t, true,  true)

// ---- Kernel B: rowMax[b,m] = max_n C[b,m,n] --------------------------------
// C is fp32 [B,M,N], already exactly the real rectangle (no padding), so this
// is a plain row-wise max. One core owns whole rows; no atomics needed.
//
// The body is factored into an inline function so the MIX kernel below can run
// it on the AIV half of a fused launch. nCoresOverride=0 means "derive the core
// count from the hardware" (the standalone-vector case); a non-zero value lets
// the caller pin the count, which the MIX path needs because there the vector
// cores are twice the AIC count while GetBlockNum() reports the AIC count.
__aicore__ inline void BmmsMaxNBody(
    GM_ADDR gc, GM_ADDR growMax, int64_t B, int64_t M, int64_t N,
    int64_t baseM, int64_t baseN, int64_t nCoresOverride)
{
    (void)baseM; (void)baseN;
    GlobalTensor<float> cg;
    GlobalTensor<float> yGm;
    cg.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(gc));
    yGm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(growMax));

    // The cube kernel writes a PACKED [B,M,N] fp32 plane, so row r occupies N
    // contiguous floats at r*N. This kernel reads back groups of rows, takes
    // the max over n in each row, and folds the m-axis sum into y with one
    // atomic-add per (core, batch) pair.
    //
    // Reduction is per row via the count form of ReduceMax. A batched
    // WholeReduceMax was tried three ways and rejected: dstRepStride is a
    // 32-byte-block stride (packing per-row results collides), the default
    // mask is only a 64-bit bitmask (N>64 silently mis-reduces), and the
    // COUNT mask mode that lifts that limit faults this core (507035).
    //
    // UB budget. The vector local memory is a few hundred KB at most, so the
    // row tile cannot be sized for the widest possible N: ROWS is chosen so
    // ROWS * N stays inside ~64KB of floats. A row wider than MAXN takes the
    // chunked path below.
    constexpr int32_t MAXN = 8192;
    // DataCopyPad blockLen is capped at 8192 bytes (2048 fp32 elements) on
    // this part; larger single copies fault the vector unit (507035). This is
    // the staging width for both the row path and the wide-row fallback.
    constexpr int32_t MAXCHUNK = 2048;
    int32_t ROWS = 16;
    {
        // Fit ROWS*N into ~64KB of floats (16384 floats) when N is large.
        const int32_t budget = 16384;
        int32_t fit = budget / (int32_t)((N < 1) ? 1 : N);
        if (fit > ROWS) fit = ROWS;
        if (fit < 1) fit = 1;
        ROWS = fit;
    }
    // rowPitch is N rounded up to 8: every DataCopyPad block target is then a
    // whole number of 32-byte blocks and the -inf padding is harmless to the
    // max. The per-row reduce output and its scratch live in their own
    // buffers below, so ROWS itself need not be aligned.
    const int32_t rowPitchMax = (int32_t)((((N < MAXN) ? N : MAXN) + 7) & ~7);
    const int32_t tileFloats = ROWS * rowPitchMax;

    TPipe pipe;
    // The row tile and the small reduction buffers are separate allocations so
    // each gets its own 32-byte-aligned base. Sharing one buffer tied the
    // alignment of rowMaxT/outT/redT to tileFloats, which forced ROWS to be a
    // multiple of 8 and overflowed UB at N >= 6144.
    TBuf<TPosition::VECCALC> ubTile;
    pipe.InitBuffer(ubTile, (uint32_t)(((size_t)tileFloats * sizeof(float) + 31u) & ~(size_t)31u));
    TBuf<TPosition::VECCALC> ubAux;
    pipe.InitBuffer(ubAux, (uint32_t)((3u * 64u) * sizeof(float)));
    LocalTensor<float> tile = ubTile.Get<float>();
    LocalTensor<float> rowMaxT = ubAux.Get<float>();
    LocalTensor<float> outT = rowMaxT[64];
    LocalTensor<float> redT = outT[64];

    const int64_t core   = (int64_t)GetBlockIdx();
    const int64_t nCores = (nCoresOverride > 0) ? nCoresOverride
                                                : (int64_t)GetBlockNum();

    DataCopyExtParams cp;
    cp.blockCount = 1;
    cp.srcStride = 0;
    cp.dstStride = 0;
    cp.rsv = 0;
    DataCopyPadExtParams<float> pad;
    pad.isPad = false; pad.leftPadding = 0; pad.rightPadding = 0; pad.paddingValue = 0.0f;

    const int64_t rowTotal = B * M;

    if (N <= MAXN) {
        for (int64_t r0 = core * ROWS; r0 < rowTotal; r0 += nCores * ROWS) {
            int32_t rows = ROWS;
            const int64_t owned = rowTotal - r0;
            if (owned < (int64_t)rows) rows = (int32_t)owned;

            // DataCopyPad must not read past the row end, so blockLen stays
            // the true N*4 bytes; the ragged tail up to rowPitch is written by
            // the pad's rightPadding with -inf. rowPitch is N rounded up to 8
            // so every row base is 32B aligned and the reduce's count is a
            // whole number of 32-byte blocks.
            const int32_t rowPitch = (int32_t)((N + 7) & ~7);
            const int32_t padRight = rowPitch - (int32_t)N;
            const int64_t rowBase = (uint64_t)r0 * (uint64_t)N;
            pad.isPad = (padRight != 0);
            pad.leftPadding = 0;
            pad.rightPadding = (uint8_t)padRight;
            pad.paddingValue = -3.402823466e+38F;
            cp.blockLen = (uint32_t)((int64_t)N * (int64_t)sizeof(float));
            for (int32_t ri = 0; ri < rows; ++ri) {
                DataCopyPad(tile[ri * rowPitch],
                            cg[rowBase + (uint64_t)ri * (uint64_t)N], cp, pad);
            }
            SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
            WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);

            // Reduce each row separately with the count form of ReduceMax,
            // which is already proven on this device. WholeReduceMax with one
            // repeat per row was tried here and mis-reduced the rows (its
            // dstRepStride is a 32-byte-block stride, so packing per-row
            // results collided); the per-row form costs a little more but is
            // correct.
            // Reduce per row with the count form of ReduceMax. A batched
            // WholeReduceMax (one repeat per row) was tried twice here: its
            // dstRepStride is a 32-byte-block stride, the default mask is only
            // a 64-bit bitmask (so N>64 silently mis-reduces), and the COUNT
            // mask mode used to lift that limit faults this core (507035).
            // Per-row is slower per element but correct for every N.
            // Reduce per row with the count form of ReduceMax. The barrier is
            // hoisted out of the loop: each row reduces into its own
            // rowMaxT[ri] slot, so the rows are independent and only the
            // group's final values need to be visible to the scalar reads
            // below. A per-row PipeBarrier<PIPE_V> serialised 205 rows per
            // core. (A batched WholeReduceMax was tried and rejected: its
            // dstRepStride is a 32-byte-block stride, its default mask is a
            // 64-bit bitmask that silently mis-reduces N>64, and the COUNT
            // mask mode that lifts that limit faults this core, 507035.)
            // One reduce per row over the padded rowPitch extent. The -inf
            // padding lanes do not change the max. count=rowPitch is always a
            // multiple of 8 (and <= MAXCHUNK) so no chunking is needed.
            for (int32_t ri = 0; ri < rows; ++ri) {
                ReduceMax(rowMaxT[ri], tile[ri * rowPitch], redT, rowPitch, false);
            }
            PipeBarrier<PIPE_V>();
            SetFlag<HardEvent::V_S>(EVENT_ID0);
            WaitFlag<HardEvent::V_S>(EVENT_ID0);

            // Fold the m-axis sum in: accumulate each batch's row maxima on
            // the scalar side, then one atomic-add of that batch partial into
            // y. A row group can straddle a batch boundary (M is not generally
            // a multiple of ROWS), so flush whenever the batch index changes.
            int32_t gi = 0;
            while (gi < rows) {
                const int64_t rowGlobal = r0 + gi;
                const int64_t bIdx = rowGlobal / M;
                const int64_t rowsLeft = M - (rowGlobal % M);
                const int32_t seg = (int32_t)(((int64_t)(rows - gi) < rowsLeft) ? (rows - gi) : rowsLeft);
                float bsum = 0.0f;
                for (int32_t t = 0; t < seg; ++t) bsum += rowMaxT.GetValue(gi + t);
                outT.SetValue(0, bsum);
                SetFlag<HardEvent::S_MTE3>(EVENT_ID0);
                WaitFlag<HardEvent::S_MTE3>(EVENT_ID0);
                SetAtomicAdd<float>();
                DataCopyExtParams oCp;
                oCp.blockCount = 1;
                oCp.blockLen = (uint32_t)sizeof(float);
                oCp.srcStride = 0;
                oCp.dstStride = 0;
                oCp.rsv = 0;
                DataCopyPad(yGm[(uint64_t)bIdx], outT, oCp);
                SetAtomicNone();
                SetFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);
                WaitFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);
                gi += seg;
            }
        }
        return;
    }

    // Wide-row fallback (N > MAXN): chunk within a row.
    for (int64_t r = core; r < rowTotal; r += nCores) {
        const uint64_t rowBase = (uint64_t)r * (uint64_t)N;
        float acc = -3.402823466e+38F;
        int64_t done = 0;
        while (done < N) {
            const int32_t chunk = (int32_t)(((N - done) < MAXCHUNK) ? (N - done) : MAXCHUNK);
            cp.blockLen = (uint32_t)((int64_t)chunk * (int64_t)sizeof(float));
            DataCopyPad(tile, cg[rowBase + (uint64_t)done], cp, pad);
            SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
            WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
            WholeReduceMax(rowMaxT, tile, chunk, 1, 1, 1, (int32_t)((chunk + 7) / 8));
            SetFlag<HardEvent::V_S>(EVENT_ID0);
            WaitFlag<HardEvent::V_S>(EVENT_ID0);
            const float v = rowMaxT.GetValue(0);
            if (v > acc) acc = v;
            done += chunk;
        }
        outT.SetValue(0, acc);
        SetFlag<HardEvent::S_MTE3>(EVENT_ID0);
        WaitFlag<HardEvent::S_MTE3>(EVENT_ID0);
        DataCopyExtParams oCp;
        oCp.blockCount = 1;
        oCp.blockLen = (uint32_t)sizeof(float);
        oCp.srcStride = 0;
        oCp.dstStride = 0;
        oCp.rsv = 0;
        SetAtomicAdd<float>();
        DataCopyPad(yGm[(uint64_t)(r / M)], outT, oCp);
        SetAtomicNone();
        SetFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);
        WaitFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);
    }
}

// ---- Fused MIX kernel: cube matmul + row-max reduction in ONE launch --------
//
// The platform profiler requires each run_kernel call to launch exactly one
// kernel, so the two-kernel cube path (bmms_cube_* then bmms_max_n) trips the
// "expected 1, got 2" rule and scores zero. This kernel fuses both halves onto
// one MIX core block: the AIC half runs the existing cube matmul, a global
// barrier retires it, then the AIV half runs the existing row-max reduction.
//
// MIX mechanics that had to be established by probe before this worked:
//   * KERNEL_TYPE_MIX_AIC_1_2 gives 1 AIC : 2 AIV per block, so the AIV half
//     sees 2 * GetBlockNum() cores while the AIC half sees GetBlockNum().
//     That is why BmmsMaxNBody takes an explicit core count.
//   * A hand-written __global__ has no implicit workspace parameter, so the
//     KFC base address is never programmed and SyncAll deadlocks with
//     ACL_ERROR_RT_STREAM_SYNC_TIMEOUT (507046). The caller allocates the
//     workspace and the entry point force-sets it, which clears the deadlock.
//   * MatmulImpl used directly (not via REGIST_MATMUL_OBJ) does NOT start the
//     KFC server, so no cube/vector KFC handshake is needed here.
template <typename IN_T, bool TX1, bool TX2>
__aicore__ inline void BmmsMixKernel(
    GM_ADDR ga, GM_ADDR gb, GM_ADDR gc, GM_ADDR gy, GM_ADDR gws,
    int64_t B, int64_t M, int64_t N, int64_t K,
    int64_t baseM, int64_t baseN)
{
    if ASCEND_IS_AIC {
        BmmsCubeBmm<IN_T, TX1, TX2>(ga, gb, gc, B, M, N, K, baseM, baseN);
    }

    // Retire the whole AIC half before any vector core reads C. SyncAll<false>
    // is the AIC+AIV barrier; it is safe here only because the caller supplied
    // the KFC workspace above.
    AscendC::SyncAll<false>();

    if ASCEND_IS_AIV {
        // 1 AIC : 2 AIV, so the vector half must stride over twice the block
        // count that GetBlockNum() reports.
        BmmsMaxNBody(gc, gy, B, M, N, baseM, baseN,
                     (int64_t)GetBlockNum() * 2);
    }
}

template <typename IN_T, bool TX1, bool TX2>
__aicore__ inline void BmmsCubeBmmH(
    GM_ADDR ga, GM_ADDR gb, GM_ADDR gc,
    int64_t B, int64_t M, int64_t N, int64_t K,
    int64_t baseM, int64_t baseN)
{
    // The transpose is applied at the operand level, not in the type: the type
    // stays isTrans=false and the layout flag goes to SetTensorA/SetTensorB as
    // their isTranspose argument. That is the control the matmul pipeline
    // actually reads; putting it in MatmulType left the operand interpreted as
    // a plain [M,K] rectangle and silently produced A^T-free results.
    using AType = MatmulType<TPosition::GM, CubeFormat::ND, IN_T, false>;
    using BType = MatmulType<TPosition::GM, CubeFormat::ND, IN_T, false>;
    // P1: the C plane is an INTERMEDIATE (only y is fp32 output), so store it
    // in fp16. C write (fixpipe) + C read (AIV) are 80% of all traffic; fp16
    // halves both. The L0C accumulator is still fp32 internally.
    using CType = MatmulType<TPosition::GM, CubeFormat::ND, half, false>;
    using BiasType = MatmulType<TPosition::GM, CubeFormat::ND, float, false>;
    MatmulImpl<AType, BType, CType, BiasType, CFG_NORM> mm;

    const int32_t m = (int32_t)M, n = (int32_t)N, k = (int32_t)K;
    const int32_t bm = (int32_t)baseM, bn = (int32_t)baseN;

    TCubeTiling t;
    t.usedCoreNum = 1;
    t.M = m; t.N = n; t.Ka = k; t.Kb = k;
    t.singleCoreM = bm; t.singleCoreN = bn; t.singleCoreK = k;
    // baseK sets how much of the K axis L1 stages per round; larger baseK
    // means fewer L1 reloads (K/baseK) per tile. 64 keeps A+B at
    // 2*baseM*baseK bytes = 32KB for a 128-wide tile, well inside L1.
    t.baseM = bm; t.baseN = bn; t.baseK = 128;
    t.depthA1 = 2; t.depthB1 = 2;
    t.stepM = 1; t.stepN = 1;
    t.isBias = 0; t.transLength = 0; t.iterateOrder = 0;
    t.shareMode = 0; t.shareL1Size = 0; t.shareL0CSize = 0; t.shareUbSize = 0;
    t.batchM = 0; t.batchN = 0; t.singleBatchM = 0; t.singleBatchN = 0;
    t.stepKa = 1; t.stepKb = 1;
    t.depthAL1CacheUB = 0; t.depthBL1CacheUB = 0;
    t.dbL0A = 1; t.dbL0B = 1; t.dbL0C = 1;

    GlobalTensor<IN_T>  ag; ag.SetGlobalBuffer((__gm__ IN_T*)ga);
    GlobalTensor<IN_T>  bg; bg.SetGlobalBuffer((__gm__ IN_T*)gb);
    GlobalTensor<half>  cg; cg.SetGlobalBuffer((__gm__ half*)gc);
    TPipe pipe;

    // Multi-core: the work items are (b, mTile, nTile) matmuls. Each core
    // claims a strided slice of that flat space, so the 20 cube cores share the
    // batches and tiles. (Single-core here measured 314us..5.9ms on the perf
    // shapes: a 64x64x64 matmul every ~4us times hundreds of serial tiles.)
    mm.SetSubBlockIdx(0);
    mm.Init(&t, &pipe);

    const int64_t mTiles = (M + bm - 1) / bm;
    const int64_t nTiles = (N + bn - 1) / bn;
    const int64_t items  = B * mTiles * nTiles;
    const int64_t core   = (int64_t)GetBlockIdx();
    const int64_t nCores = (int64_t)GetBlockNum();

    for (int64_t w = core; w < items; w += nCores) {
        const int64_t nTile = w % nTiles;
        const int64_t rem   = w / nTiles;
        const int64_t mTile = rem % mTiles;
        const int64_t b     = rem / mTiles;
        const int64_t m0 = mTile * bm;
        const int64_t n0 = nTile * bn;
        const int32_t mNow = (int32_t)(((M - m0) < bm) ? (M - m0) : bm);
        const int32_t nNow = (int32_t)(((N - n0) < bn) ? (N - n0) : bn);

        GlobalTensor<IN_T> aB = ag[static_cast<uint64_t>(b) * (uint64_t)M * (uint64_t)K];
        GlobalTensor<IN_T> bB = bg[static_cast<uint64_t>(b) * (uint64_t)K * (uint64_t)N];

        mm.SetOrgShape(m, n, k);
        mm.SetSingleShape(bm, bn, k);
        mm.SetTail(mNow, nNow, k);
        // With isTransposeA the operand is a KxM rectangle whose logical rows
        // are the stored columns, so row m0 begins at linear offset m0. Same
        // idea for B: a transposed x2 is [N,K] and column n0 begins at row n0,
        // i.e. offset n0*K.
        const uint64_t aOff = TX1 ? static_cast<uint64_t>(m0)
                                  : static_cast<uint64_t>(m0) * (uint64_t)K;
        const uint64_t bOff = TX2 ? static_cast<uint64_t>(n0) * (uint64_t)K
                                  : static_cast<uint64_t>(n0);
        mm.SetTensorA(aB[aOff], TX1);
        mm.SetTensorB(bB[bOff], TX2);

        // Packed C plane: this tile's top-left inside the [B,M,N] batch.
        GlobalTensor<half> cTile =
            cg[(static_cast<uint64_t>(b) * (uint64_t)M * (uint64_t)N) +
               (static_cast<uint64_t>(m0) * (uint64_t)N) + static_cast<uint64_t>(n0)];
        while (mm.Iterate()) {
            mm.GetTensorC(cTile, 0, false);
        }
    }
    mm.End();
}

__aicore__ inline void BmmsMaxNBodyH(
    GM_ADDR gc, GM_ADDR growMax, int64_t B, int64_t M, int64_t N,
    int64_t baseM, int64_t baseN, int64_t nCoresOverride)
{
    (void)baseM; (void)baseN;
    GlobalTensor<half>  cg;
    GlobalTensor<float> yGm;
    cg.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(gc));
    yGm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(growMax));

    // The cube kernel writes a PACKED [B,M,N] fp32 plane, so row r occupies N
    // contiguous floats at r*N. This kernel reads back groups of rows, takes
    // the max over n in each row, and folds the m-axis sum into y with one
    // atomic-add per (core, batch) pair.
    //
    // Reduction is per row via the count form of ReduceMax. A batched
    // WholeReduceMax was tried three ways and rejected: dstRepStride is a
    // 32-byte-block stride (packing per-row results collides), the default
    // mask is only a 64-bit bitmask (N>64 silently mis-reduces), and the
    // COUNT mask mode that lifts that limit faults this core (507035).
    //
    // UB budget. The vector local memory is a few hundred KB at most, so the
    // row tile cannot be sized for the widest possible N: ROWS is chosen so
    // ROWS * N stays inside ~64KB of floats. A row wider than MAXN takes the
    // chunked path below.
    constexpr int32_t MAXN = 8192;
    // DataCopyPad blockLen is capped at 8192 bytes (2048 fp32 elements) on
    // this part; larger single copies fault the vector unit (507035). This is
    // the staging width for both the row path and the wide-row fallback.
    constexpr int32_t MAXCHUNK = 2048;
    int32_t ROWS = 16;
    {
        // Fit ROWS*N into ~64KB of floats (16384 floats) when N is large.
        const int32_t budget = 16384;
        int32_t fit = budget / (int32_t)((N < 1) ? 1 : N);
        if (fit > ROWS) fit = ROWS;
        if (fit < 1) fit = 1;
        ROWS = fit;
    }
    // rowPitch is N rounded up to 8: every DataCopyPad block target is then a
    // whole number of 32-byte blocks and the -inf padding is harmless to the
    // max. The per-row reduce output and its scratch live in their own
    // buffers below, so ROWS itself need not be aligned.
    // 16 halves = 32B, same block alignment the float path relied on.
    const int32_t rowPitchMax = (int32_t)((((N < MAXN) ? N : MAXN) + 15) & ~15);
    const int32_t tileFloats = ROWS * rowPitchMax;

    TPipe pipe;
    // The row tile and the small reduction buffers are separate allocations so
    // each gets its own 32-byte-aligned base. Sharing one buffer tied the
    // alignment of rowMaxT/outT/redT to tileFloats, which forced ROWS to be a
    // multiple of 8 and overflowed UB at N >= 6144.
    TBuf<TPosition::VECCALC> ubTile;
    pipe.InitBuffer(ubTile, (uint32_t)(((size_t)tileFloats * sizeof(float) + 31u) & ~(size_t)31u));
    // Staging for the fp16 plane; rows land here then Cast into the fp32 tile
    // so the whole proven reduction path below stays untouched.
    TBuf<TPosition::VECCALC> ubTileH;
    pipe.InitBuffer(ubTileH, (uint32_t)(((size_t)tileFloats * 2u + 31u) & ~(size_t)31u));
    LocalTensor<half> tileH = ubTileH.Get<half>();
    TBuf<TPosition::VECCALC> ubAux;
    pipe.InitBuffer(ubAux, (uint32_t)((3u * 64u) * sizeof(float)));
    LocalTensor<float> tile = ubTile.Get<float>();
    LocalTensor<float> rowMaxT = ubAux.Get<float>();
    LocalTensor<float> outT = rowMaxT[64];
    LocalTensor<float> redT = outT[64];

    const int64_t core   = (int64_t)GetBlockIdx();
    const int64_t nCores = (nCoresOverride > 0) ? nCoresOverride
                                                : (int64_t)GetBlockNum();

    DataCopyExtParams cp;
    cp.blockCount = 1;
    cp.srcStride = 0;
    cp.dstStride = 0;
    cp.rsv = 0;
    DataCopyPadExtParams<float> pad;
    pad.isPad = false; pad.leftPadding = 0; pad.rightPadding = 0; pad.paddingValue = 0.0f;
    // fp16 descriptors live at function scope: the chunked fallback below the
    // early return needs them too.
    DataCopyPadExtParams<half> padH;
    padH.isPad = false; padH.leftPadding = 0; padH.rightPadding = 0; padH.paddingValue = 0;
    DataCopyExtParams cpH;
    cpH.blockCount = 1; cpH.blockLen = 0; cpH.srcStride = 0; cpH.dstStride = 0; cpH.rsv = 0;

    const int64_t rowTotal = B * M;

    if (N <= MAXN) {
        for (int64_t r0 = core * ROWS; r0 < rowTotal; r0 += nCores * ROWS) {
            int32_t rows = ROWS;
            const int64_t owned = rowTotal - r0;
            if (owned < (int64_t)rows) rows = (int32_t)owned;

            // DataCopyPad must not read past the row end, so blockLen stays
            // the true N*4 bytes; the ragged tail up to rowPitch is written by
            // the pad's rightPadding with -inf. rowPitch is N rounded up to 8
            // so every row base is 32B aligned and the reduce's count is a
            // whole number of 32-byte blocks.
            const int32_t rowPitch = (int32_t)((N + 15) & ~15);
            const int64_t rowBase = (uint64_t)r0 * (uint64_t)N;
            // half paddingValue is a uint8_t, so it cannot carry -inf; instead
            // pre-fill the fp32 tile with -inf and Cast only the true N lanes,
            // leaving the tail at -inf for the count-form reduce.
            cpH.blockLen = (uint32_t)((int64_t)N * (int64_t)sizeof(half));
            Duplicate(tile, -3.402823466e+38F, (uint32_t)(rows * rowPitch));
            for (int32_t ri = 0; ri < rows; ++ri) {
                DataCopyPad(tileH[ri * rowPitch],
                            cg[rowBase + (uint64_t)ri * (uint64_t)N], cpH, padH);
            }
            SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
            WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
            for (int32_t ri = 0; ri < rows; ++ri) {
                Cast(tile[ri * rowPitch], tileH[ri * rowPitch],
                     RoundMode::CAST_NONE, (uint32_t)N);
            }
            SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
            WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);

            // Reduce each row separately with the count form of ReduceMax,
            // which is already proven on this device. WholeReduceMax with one
            // repeat per row was tried here and mis-reduced the rows (its
            // dstRepStride is a 32-byte-block stride, so packing per-row
            // results collided); the per-row form costs a little more but is
            // correct.
            // Reduce per row with the count form of ReduceMax. A batched
            // WholeReduceMax (one repeat per row) was tried twice here: its
            // dstRepStride is a 32-byte-block stride, the default mask is only
            // a 64-bit bitmask (so N>64 silently mis-reduces), and the COUNT
            // mask mode used to lift that limit faults this core (507035).
            // Per-row is slower per element but correct for every N.
            // Reduce per row with the count form of ReduceMax. The barrier is
            // hoisted out of the loop: each row reduces into its own
            // rowMaxT[ri] slot, so the rows are independent and only the
            // group's final values need to be visible to the scalar reads
            // below. A per-row PipeBarrier<PIPE_V> serialised 205 rows per
            // core. (A batched WholeReduceMax was tried and rejected: its
            // dstRepStride is a 32-byte-block stride, its default mask is a
            // 64-bit bitmask that silently mis-reduces N>64, and the COUNT
            // mask mode that lifts that limit faults this core, 507035.)
            // One reduce per row over the padded rowPitch extent. The -inf
            // padding lanes do not change the max. count=rowPitch is always a
            // multiple of 8 (and <= MAXCHUNK) so no chunking is needed.
            for (int32_t ri = 0; ri < rows; ++ri) {
                ReduceMax(rowMaxT[ri], tile[ri * rowPitch], redT, rowPitch, false);
            }
            PipeBarrier<PIPE_V>();
            SetFlag<HardEvent::V_S>(EVENT_ID0);
            WaitFlag<HardEvent::V_S>(EVENT_ID0);

            // Fold the m-axis sum in: accumulate each batch's row maxima on
            // the scalar side, then one atomic-add of that batch partial into
            // y. A row group can straddle a batch boundary (M is not generally
            // a multiple of ROWS), so flush whenever the batch index changes.
            int32_t gi = 0;
            while (gi < rows) {
                const int64_t rowGlobal = r0 + gi;
                const int64_t bIdx = rowGlobal / M;
                const int64_t rowsLeft = M - (rowGlobal % M);
                const int32_t seg = (int32_t)(((int64_t)(rows - gi) < rowsLeft) ? (rows - gi) : rowsLeft);
                float bsum = 0.0f;
                for (int32_t t = 0; t < seg; ++t) bsum += rowMaxT.GetValue(gi + t);
                outT.SetValue(0, bsum);
                SetFlag<HardEvent::S_MTE3>(EVENT_ID0);
                WaitFlag<HardEvent::S_MTE3>(EVENT_ID0);
                SetAtomicAdd<float>();
                DataCopyExtParams oCp;
                oCp.blockCount = 1;
                oCp.blockLen = (uint32_t)sizeof(float);
                oCp.srcStride = 0;
                oCp.dstStride = 0;
                oCp.rsv = 0;
                DataCopyPad(yGm[(uint64_t)bIdx], outT, oCp);
                SetAtomicNone();
                SetFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);
                WaitFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);
                gi += seg;
            }
        }
        return;
    }

    // Wide-row fallback (N > MAXN): chunk within a row.
    for (int64_t r = core; r < rowTotal; r += nCores) {
        const uint64_t rowBase = (uint64_t)r * (uint64_t)N;
        float acc = -3.402823466e+38F;
        int64_t done = 0;
        while (done < N) {
            const int32_t chunk = (int32_t)(((N - done) < MAXCHUNK) ? (N - done) : MAXCHUNK);
            cpH.blockLen = (uint32_t)((int64_t)chunk * (int64_t)sizeof(half));
            DataCopyPad(tileH, cg[rowBase + (uint64_t)done], cpH, padH);
            SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
            WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
            Cast(tile, tileH, RoundMode::CAST_NONE, (uint32_t)chunk);
            WholeReduceMax(rowMaxT, tile, chunk, 1, 1, 1, (int32_t)((chunk + 7) / 8));
            SetFlag<HardEvent::V_S>(EVENT_ID0);
            WaitFlag<HardEvent::V_S>(EVENT_ID0);
            const float v = rowMaxT.GetValue(0);
            if (v > acc) acc = v;
            done += chunk;
        }
        outT.SetValue(0, acc);
        SetFlag<HardEvent::S_MTE3>(EVENT_ID0);
        WaitFlag<HardEvent::S_MTE3>(EVENT_ID0);
        DataCopyExtParams oCp;
        oCp.blockCount = 1;
        oCp.blockLen = (uint32_t)sizeof(float);
        oCp.srcStride = 0;
        oCp.dstStride = 0;
        oCp.rsv = 0;
        SetAtomicAdd<float>();
        DataCopyPad(yGm[(uint64_t)(r / M)], outT, oCp);
        SetAtomicNone();
        SetFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);
        WaitFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);
    }
}

template <typename IN_T, bool TX1, bool TX2>
__aicore__ inline void BmmsMixKernelH(
    GM_ADDR ga, GM_ADDR gb, GM_ADDR gc, GM_ADDR gy, GM_ADDR gws,
    int64_t B, int64_t M, int64_t N, int64_t K,
    int64_t baseM, int64_t baseN)
{
    if ASCEND_IS_AIC {
        BmmsCubeBmmH<IN_T, TX1, TX2>(ga, gb, gc, B, M, N, K, baseM, baseN);
    }

    // Retire the whole AIC half before any vector core reads C. SyncAll<false>
    // is the AIC+AIV barrier; it is safe here only because the caller supplied
    // the KFC workspace above.
    AscendC::SyncAll<false>();

    if ASCEND_IS_AIV {
        // 1 AIC : 2 AIV, so the vector half must stride over twice the block
        // count that GetBlockNum() reports.
        BmmsMaxNBodyH(gc, gy, B, M, N, baseM, baseN,
                     (int64_t)GetBlockNum() * 2);
    }
}


// ---- P1c: fp16 C plane variants -------------------------------------------
// Same pipeline, C stored as fp16. Only chosen by the host when the C plane is
// large and K is small (see useFp16C in run_kernel): the regime where C traffic
// dominates and halving it pays. The fp32 originals above stay the default, so
// no shape regresses. A/B measured: -6.8%..-38.8% on the fp16 side of the rule,
// +0.9%..+7.6% on the fp32 side.
#define DEFINE_BMMS_MIX_WRAPPER_H(NAME, IN_T, TX1, TX2)                         \
extern "C" __global__ __aicore__ void NAME(                                    \
    GM_ADDR ga, GM_ADDR gb, GM_ADDR gc, GM_ADDR gy, GM_ADDR gws,               \
    int64_t B, int64_t M, int64_t N, int64_t K,                                \
    int64_t baseM, int64_t baseN)                                              \
{                                                                              \
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);                         \
    AscendC::SetSysWorkspaceForce(gws);                                        \
    BmmsMixKernelH<IN_T, TX1, TX2>(ga, gb, gc, gy, gws, B, M, N, K, baseM, baseN); \
}

DEFINE_BMMS_MIX_WRAPPER_H(bmms_p1f_mixcube_fp16_00, half,       false, false)
DEFINE_BMMS_MIX_WRAPPER_H(bmms_p1f_mixcube_fp16_10, half,       true,  false)
DEFINE_BMMS_MIX_WRAPPER_H(bmms_p1f_mixcube_fp16_01, half,       false, true)
DEFINE_BMMS_MIX_WRAPPER_H(bmms_p1f_mixcube_fp16_11, half,       true,  true)
DEFINE_BMMS_MIX_WRAPPER_H(bmms_p1f_mixcube_bf16_00, bfloat16_t, false, false)
DEFINE_BMMS_MIX_WRAPPER_H(bmms_p1f_mixcube_bf16_10, bfloat16_t, true,  false)
DEFINE_BMMS_MIX_WRAPPER_H(bmms_p1f_mixcube_bf16_01, bfloat16_t, false, true)
DEFINE_BMMS_MIX_WRAPPER_H(bmms_p1f_mixcube_bf16_11, bfloat16_t, true,  true)

#define DEFINE_BMMS_MIX_WRAPPER(NAME, IN_T, TX1, TX2)                          \
extern "C" __global__ __aicore__ void NAME(                                    \
    GM_ADDR ga, GM_ADDR gb, GM_ADDR gc, GM_ADDR gy, GM_ADDR gws,               \
    int64_t B, int64_t M, int64_t N, int64_t K,                                \
    int64_t baseM, int64_t baseN)                                              \
{                                                                              \
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);                         \
    AscendC::SetSysWorkspaceForce(gws);                                        \
    BmmsMixKernel<IN_T, TX1, TX2>(ga, gb, gc, gy, gws, B, M, N, K, baseM, baseN); \
}

DEFINE_BMMS_MIX_WRAPPER(bmms_p1_mixcube_fp16_00, half,       false, false)
DEFINE_BMMS_MIX_WRAPPER(bmms_p1_mixcube_fp16_10, half,       true,  false)
DEFINE_BMMS_MIX_WRAPPER(bmms_p1_mixcube_fp16_01, half,       false, true)
DEFINE_BMMS_MIX_WRAPPER(bmms_p1_mixcube_fp16_11, half,       true,  true)
DEFINE_BMMS_MIX_WRAPPER(bmms_p1_mixcube_bf16_00, bfloat16_t, false, false)
DEFINE_BMMS_MIX_WRAPPER(bmms_p1_mixcube_bf16_10, bfloat16_t, true,  false)
DEFINE_BMMS_MIX_WRAPPER(bmms_p1_mixcube_bf16_01, bfloat16_t, false, true)
DEFINE_BMMS_MIX_WRAPPER(bmms_p1_mixcube_bf16_11, bfloat16_t, true,  true)

// ---- Fused N-split kernel: seed + (row,nblock) max + m-sum, ONE launch ------
//
// The N-split vector path used to be three launches (seed rowMax to -inf,
// atomicMax per (row,n-block), then sum the row maxima into y). The profiler
// rule allows exactly one launch per run_kernel call, so the three stages are
// fused here behind two AIV-only global barriers. The barriers are required
// because stage 2 writes rowMax from many (row,n-block) workers and stage 3
// must observe every one of those writes.
//
// SyncAll<true> is the vector-only barrier. It reaches __sync_all_stub with
// usedCores=0, which the runtime resolves from the launch width; the AIC half
// is untouched because this kernel never declares MIX.
template <typename IN_T>
__aicore__ inline void BmmsSplitFused(
    GM_ADDR x1, GM_ADDR x2, GM_ADDR rowMax, GM_ADDR y,
    int64_t B, int64_t M, int64_t N, int64_t K)
{
    GlobalTensor<float> rmGm;
    rmGm.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(rowMax));

    // Stage 1: seed rowMax to -inf. B*M is below the core budget on this path,
    // so this is a handful of writes per core.
    {
        const int64_t blockIdx = static_cast<int64_t>(GetBlockIdx());
        const int64_t blockNum = static_cast<int64_t>(GetBlockNum());
        const int64_t rowCount = B * M;
        TPipe pipe;
        TBuf<TPosition::VECCALC> ub;
        pipe.InitBuffer(ub, 64);
        LocalTensor<float> v = ub.Get<float>();
        v.SetValue(0, -3.402823466e+38F);
        PipeBarrier<PIPE_ALL>();
        DataCopyExtParams sCp;
        sCp.blockCount = 1;
        sCp.blockLen = static_cast<uint32_t>(sizeof(float));
        sCp.srcStride = 0;
        sCp.dstStride = 0;
        sCp.rsv = 0;
        for (int64_t r = blockIdx; r < rowCount; r += blockNum) {
            DataCopyPad(rmGm[static_cast<uint64_t>(r)], v, sCp);
        }
        PipeBarrier<PIPE_ALL>();
        SetFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);
        WaitFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);
    }

    AscendC::SyncAll<true>();

    // Stage 2: rowMax[b,m] = max over n-blocks of the row's maxima.
    BmmsVecNN2D<IN_T>(x1, x2, rowMax, B, M, N, K);

    AscendC::SyncAll<true>();

    // Stage 3: y[b] = sum_m rowMax[b*M + m].
    BmmsReduceM(rowMax, y, B, M);
}

#define DEFINE_BMMS_SPLIT_WRAPPER(NAME, IN_T)                                  \
extern "C" __global__ __vector__ void NAME(                                    \
    GM_ADDR x1, GM_ADDR x2, GM_ADDR rowMax, GM_ADDR y,                        \
    int64_t B, int64_t M, int64_t N, int64_t K)                               \
{                                                                              \
    BmmsSplitFused<IN_T>(x1, x2, rowMax, y, B, M, N, K);                       \
}

DEFINE_BMMS_SPLIT_WRAPPER(bmms_p5_split_fp16, half)
DEFINE_BMMS_SPLIT_WRAPPER(bmms_p5_split_bf16, bfloat16_t)

// Standalone vector entry point: same body, core count from the hardware.
extern "C" __global__ __vector__ void bmms_max_n(
    GM_ADDR gc, GM_ADDR growMax, int64_t B, int64_t M, int64_t N,
    int64_t baseM, int64_t baseN)
{
    BmmsMaxNBody(gc, growMax, B, M, N, baseM, baseN, 0);
}

extern "C" void run_kernel(
    GM_ADDR x1, const TensorGroupInfo& info_x1,
    GM_ADDR x2, const TensorGroupInfo& info_x2,
    GM_ADDR y, const TensorGroupInfo& info_y,
    int64_t availableCoreNum, aclrtStream stream,
    bool transposeX1,
    bool transposeX2)
{
    (void)info_y;
    if (info_x1.numTensors < 1 || info_x2.numTensors < 1 || availableCoreNum <= 0) return;

    const TensorInfo &sx1 = info_x1.tensors[0];
    const TensorInfo &sx2 = info_x2.tensors[0];
    if (sx1.numDims != 3 || sx2.numDims != 3) return;

    const int64_t B = sx1.shape[0];
    const int64_t M = transposeX1 ? sx1.shape[2] : sx1.shape[1];
    const int64_t K = transposeX1 ? sx1.shape[1] : sx1.shape[2];
    const int64_t B2 = sx2.shape[0];
    const int64_t K2 = transposeX2 ? sx2.shape[2] : sx2.shape[1];
    const int64_t N = transposeX2 ? sx2.shape[1] : sx2.shape[2];

    if (B <= 0 || M <= 0 || N <= 0 || K <= 0 || B != B2 || K != K2) return;
    if (sx1.dtype != sx2.dtype) return;

    // Launch over the flattened (b,m) row space.
    //
    // availableCoreNum is ACL_DEV_ATTR_CUBE_CORE_NUM (20 on this part), but this
    // kernel is __vector__ and the device actually exposes 40 vector cores. Using
    // the cube count left half of them idle and doubled the wall time. The
    // profiler confirmed it: Block Num = 20 while aiv_vec/mte2/scalar were all
    // under a quarter busy. Scale the launch width by 2 to reach the vector core
    // count; the kernel's own row loop still self-distributes, so an overshoot
    // only costs an idle wave, never correctness.
    int64_t rowTotal = B * M;
    int64_t vecCoreBudget = availableCoreNum * 2;
    int64_t blockNum64 = (rowTotal < vecCoreBudget) ? rowTotal : vecCoreBudget;
    if (blockNum64 < 1) blockNum64 = 1;
    const uint32_t blockNum = static_cast<uint32_t>(blockNum64);

    // y accumulates the M-dim sum of per-row maxima, and every core atomic-adds
    // its contribution, so y must start at zero. Use the ASYNC variant on the
    // operator stream: a synchronous aclrtMemset would block the host inside the
    // operator entry point, which is what the platform penalised.
    {
        const size_t yBytes = static_cast<size_t>(B) * sizeof(float);
        aclrtMemsetAsync(y, yBytes, 0, yBytes, stream);
    }

    // ========================================================================
    // CUBE PATH (primary). Verified 6/6 on the local shape sweep, exact match
    // against a host fp32 reference for B=1..4, M/N in 17..200, K in 16..128.
    //
    // Three independent kernels on the caller's stream -- no MIX core, no
    // cross-core events. (A MIX handshake via CrossCoreSetFlag/WaitFlag was
    // measured to deadlock this stream with ACL_ERROR_RT_STREAM_SYNC_TIMEOUT,
    // 507046; three plain launches sidestep it entirely and cost one extra
    // kernel boundary.)
    //   bmms_cube_bmm : C[B,M,N] fp32 = A[B,M,K] x B[B,K,N]   (AIC_ONLY)
    //   bmms_max_n    : rowMax[B,M]   = max_n C                (VEC)
    //   reduce_m      : y[B]          = sum_m rowMax           (VEC)
    //
    // Only the non-transposed fp16 layout takes this route; everything else
    // falls through to the vector reference below, which stays correct.
    // ========================================================================
    // The cube route materialises the FULL [B,M,N] fp32 product in GM before
    // reducing it, so its scratch is B*M*N*4 bytes. That is fine for the sweep
    // shapes but explodes on a large 3-D batch (B=64, M=N=8192 asks for 17 GB
    // and would fail the malloc, or worse, succeed and thrash). Refuse the cube
    // route past a conservative cap and let the vector paths -- which stream the
    // product through UB and never materialise it -- handle those shapes.
    constexpr int64_t kCubeScratchCapBytes = int64_t(2) << 30;   // 2 GiB
    // Divide before multiplying so an absurd shape cannot overflow int64.
    const int64_t capElems = kCubeScratchCapBytes / 4;           // fp32 elements in the cap
    const bool cubeFits = (M <= capElems) && (N <= capElems / M) &&
                          (B <= capElems / (M * N));
    // Every storage layout can use the cube cores now: the layout flag is
    // handed to SetTensorA/SetTensorB, which is what the matmul pipeline reads.
    const bool cubeOk = (sx1.dtype == 1 || sx1.dtype == 2) &&
                        M >= 1 && N >= 1 && K >= 1 && cubeFits;
    // P4: tiny shapes have ~7us of OUR OWN fixed cost inside the cube path
    // (measured: empty MIX kernel = 2.50us, +AIC 4.12us, +AIV/barrier 3.72us
    // on 1x1x1x32, where the arithmetic itself is nothing). The scalar kernel
    // below sets up one 32-float UB buffer and nothing else, and it already
    // handles all four layouts. Send tiny shapes there instead.
    {
        // Threshold from the crossover sweep (scalar vs cube, same session):
        //   MACs   32 -> -52.3% | 128 -> -48.7% | 512 -> -26.7%
        //   MACs 2048 -> +79.6% | 8192 -> +379%
        // Crossover ~975. Stay well inside the measured win so no shape can
        // regress: anything above the line keeps the cube path unchanged.
        // Threshold from the row-parallel crossover sweep (same-session A/B):
        //   MACs    32 -> -53.6% | 512 -> -39.7% | 2048 -> -20.5%
        //   MACs  4096 -> +14.7% | 8192 -> +56.3% | 16384 -> +84.6%
        // Crossover sits between 2048 and 4096; stay on the measured win side so
        // nothing above the line can regress (they keep the cube path).
        // Two reasons to bypass the cube:
        //  (a) MACs <= 2048 -- the arithmetic itself is nothing and the cube's
        //      init/arm cost dominates (measured -20.5%..-53.6%).
        //  (b) DEGENERATE TILE + LONG K. The cube pays its ~4.9us arm cost once
        //      per (tile x K-step). With a tiny M*N the tile count collapses to
        //      one while K/128 steps remain, so cost grows ~40ns per K element
        //      and nothing amortises it. Measured on the shipped build:
        //        1 1 1 2048  = 78us (this is test point 13)   1 1 1 8192  = 321us
        //        1 1 1 16384 = 639us                          1 1 1 32768 = 1253us
        //      The row-parallel tiny kernel has no K-step arming at all.
        const bool macTiny = ((int64_t)B * M * N * (int64_t)K <= 2048);
        // Kept deliberately tight: the tiny kernel is a scalar GetValue loop
        // (~9-19ns per MAC), so anything wider REGRESSES. Measured with M*N<=64:
        //   1 1 1 4096 156.9 -> 39.3  (-75%)   tiny wins
        //   1 1 1 8192 321.3 -> 74.0  (-77%)   tiny wins
        //   1 2 2 8192 334.5 -> 187.3 (-44%)   tiny wins
        //   1 4 4 4096 147.2 -> 313.7 (+113%)  tiny LOSES  <- why the bound is 4
        const bool degenerate = ((int64_t)M * N <= 4) && (K >= 256);
        const bool tinyShape = macTiny || degenerate;
        // row-parallel tiny kernel: width = rows, not batches
        int64_t tinyBlocks = (B * M < (int64_t)availableCoreNum) ? (B * M) : (int64_t)availableCoreNum;
        if (tinyBlocks < 1) tinyBlocks = 1;
        if (tinyShape && (sx1.dtype == 1 || sx1.dtype == 2)) {
            if (sx1.dtype == 1) {
                bmms_ptiny_fp16<<<static_cast<uint32_t>(tinyBlocks), nullptr, stream>>>(
                    x1, x2, y, B, M, N, K, transposeX1, transposeX2);
            } else {
                bmms_ptiny_bf16<<<static_cast<uint32_t>(tinyBlocks), nullptr, stream>>>(
                    x1, x2, y, B, M, N, K, transposeX1, transposeX2);
            }
            return;
        }
    }
    if (cubeOk) {
        // Tile size 64x64 is what the local sweep was validated at; the cube
        // kernel itself tiles the real [M,N] so non-multiples are fine.
        // Larger tiles mean fewer MatmulImpl re-arms: each tile costs one
        // SetOrgShape/SetSingleShape/SetTail plus an L1 restage, measured at
        // ~4.4us for a 64x64x64 tile. Pick the largest power-of-two-aligned
        // tile that still divides the shape, so big shapes get a single tile
        // per batch while small ones keep enough tiles to fill the 20 cube
        // cores. A fixed 256 faults (507015) once M or N is below the tile.
        int64_t bmBase = 64, bnBase = 64;
        {
            // EXPERIMENT A: the fused MIX route faulted with 507015 (L0C
            // overflow) on the first profiled shape while the identical tile
            // rule is known-good for the standalone AIC_ONLY cube kernel. The
            // AIV half of a MIX block shares the physical local memory with the
            // AIC half, so the accumulator room left for a 64/128-wide tile is
            // smaller here than it is for a pure cube kernel. Cap the tile at
            // 16x16 (L0C cost 1KB) to test whether the fault is tile pressure
            // rather than something structural about MIX. Only the cap and the
            // starting size change; the shape logic is untouched.
            // P5: cube tile shape. The old rule was a "grow while it fits"
            // heuristic that had never been swept. Same-session A/B, delta vs
            // the shipped 64x256 on (2048^3, 8192x2048x256, 4096x2048x512):
            //   64x256 (old)  -2.3% / -2.0%
            //   128x128      -12.1% / -4.3%
            //   128x256      -19.8% / -12.9% / -20.6%
            //   256x128      -21.6% / -17.6% / -21.8%   <- chosen, best overall
            //   32x256       +45%   / +38%
            //   64x128       +10.4%
            // 256x128 is 128KB of L0C and still fits.
            // P5 applies ONLY to shapes big enough for a 256x128 tile. Small
            // shapes keep the original "start at 32, double while it fits"
            // rule verbatim. That rule deliberately leaves bmBase > M for tiny
            // M (M=4 -> bmBase=32) and the kernel handles the tail; clamping
            // bm down to M instead silently produced wrong results on
            // 1x4x4x512, 1x1x2048x64, 1x1x1024x256 and 1x1x512x128, all of
            // which the shipped build passes. Do not widen this condition
            // without re-running those four.
            if (M >= 128 && N >= 128) {
                // NIGHT D2c: the wide-N win (measured -27%..-55%) lives at
                // M <= 768; at M >= 1024 the same tile read +0.58% and +2.11%
                // (both inside the overlap, but the sign repeats), so keep the
                // shipped 256x128 there instead of risking a small loss.
                if (N > 1024 && M <= 768) { bmBase = 128; bnBase = 256; }
                else                      { bmBase = 256; bnBase = 128; }
            } else {
                bmBase = 32;
                for (int64_t t = 32; t <= 256; t *= 2) { if (t <= M) bmBase = t; }
                bnBase = 32;
                for (int64_t t = 32; t <= 256; t *= 2) { if (t <= N) bnBase = t; }
            }
            // EXPERIMENT C: widen bn independently of bm. The N=512 cube
            // blow-up (115us, fix=84%) is arm overhead: bn=32 gives 16 tiles
            // for 20 cores, so each core arms the matmul pipeline for a 1x32
            // sliver. bn=256 collapses that to 2 tiles per row. bm stays
            // small when M is small -- a 1-row tile needs no M width.
            // EXPERIMENT 2C: K=32 on large M,N measured fix=95.3%, sca=55.2%.
            // The scalar cost is matmul arm overhead: bm=64/bn=128 tiling of an
            // 8192x8192 plane is 8192 tiles, each re-arming the pipeline. Widen
            // the tile so big shapes get far fewer, larger matmuls.
            // (tile-sweep: the shape overrides are disabled)
        }

        // P1c: fp16 C pays only when the C plane is large AND K is small -- the
        // regime where C traffic dominates. A/B measured: -6.8%..-38.8% there,
        // but +0.9%..+7.6% when the plane is small (staging + Cast not repaid).
        const bool useFp16C = (K <= 256) &&
            ((int64_t)B * (int64_t)M * (int64_t)N >= ((int64_t)1 << 23));
        const size_t cBytes  = (size_t)B * (size_t)M * (size_t)N * (useFp16C ? 2u : 4u);
        const size_t rmBytes = (size_t)B * (size_t)M * sizeof(float);

        // Scratch is cached across calls. aclrtMalloc/aclrtFree are not free:
        // profiling showed ~38us of kernel work behind a ~104us wall clock, and
        // the gap is host-side (two mallocs, two frees, three launches). The
        // platform calls run_kernel repeatedly with the same shape, so allocate
        // on first use and only grow when a bigger shape arrives. Never free
        // here: the allocations belong to the process, not to one invocation.
        static void *cBufCache = nullptr;
        static size_t cBytesCache = 0;
        static void *rmBufCache = nullptr;
        static size_t rmBytesCache = 0;
        // KFC/system workspace for the fused MIX launch. A hand-written
        // __global__ never receives the implicit workspace argument the
        // opbuild wrapper would pass, so the KFC base address stays zero and
        // the MIX entry point's SyncAll deadlocks (507046). Allocate and zero
        // it here, hand it to the kernel, and set it inside the entry point.
        // 64 MiB covers the 16 MiB system reserve plus the KFC descriptor.
        static void *wsBufCache = nullptr;
        if (wsBufCache == nullptr) {
            const size_t wsBytes = (size_t)64 << 20;
            if (aclrtMalloc(&wsBufCache, wsBytes, ACL_MEM_MALLOC_HUGE_FIRST) == 0) {
                if (aclrtMemset(wsBufCache, wsBytes, 0, wsBytes) != 0) {
                    aclrtFree(wsBufCache); wsBufCache = nullptr;
                }
            }
        }
        void *wsBuf = wsBufCache;
        if (cBufCache == nullptr || cBytesCache < cBytes) {
            if (cBufCache != nullptr) { aclrtFree(cBufCache); cBufCache = nullptr; cBytesCache = 0; }
            if (aclrtMalloc(&cBufCache, cBytes, ACL_MEM_MALLOC_HUGE_FIRST) == 0) cBytesCache = cBytes;
        }
        if (rmBufCache == nullptr || rmBytesCache < rmBytes) {
            if (rmBufCache != nullptr) { aclrtFree(rmBufCache); rmBufCache = nullptr; rmBytesCache = 0; }
            if (aclrtMalloc(&rmBufCache, rmBytes, ACL_MEM_MALLOC_HUGE_FIRST) == 0) rmBytesCache = rmBytes;
        }
        void *cBuf = cBufCache;
        void *rmBuf = rmBufCache;

        if (cBuf != nullptr && rmBuf != nullptr && wsBuf != nullptr) {
            // Launch widths: the cube kernel scales over (b,mTile,nTile) so it
            // gets the full cube-core count; the two vector kernels scale over
            // rows/batches so they get the full vector-core count.
            const int64_t mTilesL = (M + bmBase - 1) / bmBase;
            const int64_t nTilesL = (N + bnBase - 1) / bnBase;
            const int64_t itemsL  = B * mTilesL * nTilesL;
            int64_t cubeBlocks = (itemsL < availableCoreNum) ? itemsL : availableCoreNum;
            if (cubeBlocks < 1) cubeBlocks = 1;
            int64_t vecBlocks = (B * M < availableCoreNum * 2) ? (B * M) : availableCoreNum * 2;
            if (vecBlocks < 1) vecBlocks = 1;
            int64_t redBlocks = (B < availableCoreNum * 2) ? B : availableCoreNum * 2;
            if (redBlocks < 1) redBlocks = 1;

            // ONE launch per run_kernel call, as the profiler demands. The
            // cube matmul and the row-max reduction run as the AIC and AIV
            // halves of the same MIX block, so the whole cube path costs a
            // single kernel boundary instead of two.
            {
                const uint32_t cb = static_cast<uint32_t>(cubeBlocks);
                if (useFp16C) {
                const int idx = (sx1.dtype == 2 ? 4 : 0) |
                                (transposeX1 ? 2 : 0) | (transposeX2 ? 1 : 0);
                switch (idx) {
                    case 0:  bmms_p1f_mixcube_fp16_00<<<cb, nullptr, stream>>>(x1, x2, (GM_ADDR)cBuf, y, (GM_ADDR)wsBuf, B, M, N, K, bmBase, bnBase); break;
                    case 1:  bmms_p1f_mixcube_fp16_01<<<cb, nullptr, stream>>>(x1, x2, (GM_ADDR)cBuf, y, (GM_ADDR)wsBuf, B, M, N, K, bmBase, bnBase); break;
                    case 2:  bmms_p1f_mixcube_fp16_10<<<cb, nullptr, stream>>>(x1, x2, (GM_ADDR)cBuf, y, (GM_ADDR)wsBuf, B, M, N, K, bmBase, bnBase); break;
                    case 3:  bmms_p1f_mixcube_fp16_11<<<cb, nullptr, stream>>>(x1, x2, (GM_ADDR)cBuf, y, (GM_ADDR)wsBuf, B, M, N, K, bmBase, bnBase); break;
                    case 4:  bmms_p1f_mixcube_bf16_00<<<cb, nullptr, stream>>>(x1, x2, (GM_ADDR)cBuf, y, (GM_ADDR)wsBuf, B, M, N, K, bmBase, bnBase); break;
                    case 5:  bmms_p1f_mixcube_bf16_01<<<cb, nullptr, stream>>>(x1, x2, (GM_ADDR)cBuf, y, (GM_ADDR)wsBuf, B, M, N, K, bmBase, bnBase); break;
                    case 6:  bmms_p1f_mixcube_bf16_10<<<cb, nullptr, stream>>>(x1, x2, (GM_ADDR)cBuf, y, (GM_ADDR)wsBuf, B, M, N, K, bmBase, bnBase); break;
                    default: bmms_p1f_mixcube_bf16_11<<<cb, nullptr, stream>>>(x1, x2, (GM_ADDR)cBuf, y, (GM_ADDR)wsBuf, B, M, N, K, bmBase, bnBase); break;
                }
                } else {
                const int idx = (sx1.dtype == 2 ? 4 : 0) |
                                (transposeX1 ? 2 : 0) | (transposeX2 ? 1 : 0);
                switch (idx) {
                    case 0:  bmms_p1_mixcube_fp16_00<<<cb, nullptr, stream>>>(x1, x2, (GM_ADDR)cBuf, y, (GM_ADDR)wsBuf, B, M, N, K, bmBase, bnBase); break;
                    case 1:  bmms_p1_mixcube_fp16_01<<<cb, nullptr, stream>>>(x1, x2, (GM_ADDR)cBuf, y, (GM_ADDR)wsBuf, B, M, N, K, bmBase, bnBase); break;
                    case 2:  bmms_p1_mixcube_fp16_10<<<cb, nullptr, stream>>>(x1, x2, (GM_ADDR)cBuf, y, (GM_ADDR)wsBuf, B, M, N, K, bmBase, bnBase); break;
                    case 3:  bmms_p1_mixcube_fp16_11<<<cb, nullptr, stream>>>(x1, x2, (GM_ADDR)cBuf, y, (GM_ADDR)wsBuf, B, M, N, K, bmBase, bnBase); break;
                    case 4:  bmms_p1_mixcube_bf16_00<<<cb, nullptr, stream>>>(x1, x2, (GM_ADDR)cBuf, y, (GM_ADDR)wsBuf, B, M, N, K, bmBase, bnBase); break;
                    case 5:  bmms_p1_mixcube_bf16_01<<<cb, nullptr, stream>>>(x1, x2, (GM_ADDR)cBuf, y, (GM_ADDR)wsBuf, B, M, N, K, bmBase, bnBase); break;
                    case 6:  bmms_p1_mixcube_bf16_10<<<cb, nullptr, stream>>>(x1, x2, (GM_ADDR)cBuf, y, (GM_ADDR)wsBuf, B, M, N, K, bmBase, bnBase); break;
                    default: bmms_p1_mixcube_bf16_11<<<cb, nullptr, stream>>>(x1, x2, (GM_ADDR)cBuf, y, (GM_ADDR)wsBuf, B, M, N, K, bmBase, bnBase); break;
                }
                }
            }
            // The old two-launch form, kept reachable if the MIX route ever
            // regresses. It is NOT taken while the fused wrappers above are
            // dispatched: two launches per call violate the profiler rule.
            //   bmms_cube_<dtype>_<tx>  -> C[B,M,N]
            //   bmms_max_n              -> y[B] (row max + m-sum)
            (void)redBlocks; (void)rmBuf; (void)vecBlocks;
            return;
        }
        // Allocation failed: fall through to the vector path rather than fail.
    }

    // The Vector kernel handles the two natural layouts for any N (including
    // N > NB, i.e. several n-blocks per row) and any M/K. The transposed layouts
    // are still served by the scalar reference.
    //
    // NOTE on DataCopyPad stride units (measured on this bisheng / dav-2201
    // toolchain, and NOT what the public docs imply):
    //   * srcStride  is a raw BYTE count.
    //   * dstStride  is a count of 32-byte BLOCKS.
    // Using block units for srcStride made the x2 tile rows land 32x too close
    // for every shape with more than one n-block (N > 128), which silently
    // corrupted y. Single-n-block shapes had srcStride == 0 and were unaffected,
    // which is why the small local cases never caught it.
    const bool vecOk = (!transposeX1 && !transposeX2);

    // Two shapes of parallelism:
    //   * B*M >= cores  -> the one-stage kernel below already fills every core by
    //                      giving each one whole rows; keep it (it is the faster
    //                      path: no scratch, no second launch).
    //   * B*M <  cores  -> not enough rows to go round. This is the large-N case
    //                      (B=1, M=1, N=8192 leaves 19 of 20 cores idle). Use the
    //                      N-split variant, which also parallelises over n-blocks.
    // Pick the path by shape, not by a fixed switch. The two parallelisms have
    // opposite cost profiles, measured locally:
    //   * BmmsVecNN   loads x1 ONCE per (m,k-block) and reuses it for every
    //                 n-block, and needs no scratch/atomics/second launch. It is
    //                 the cheaper path WHENEVER there are enough rows to fill the
    //                 cores -- but with B*M < cores most cores sit idle and a
    //                 single core eats all of the K*N x2 traffic. Measured:
    //                 B=1 M=1 N=8192 K=8192 took 20.11ms, ~40x off the 40-core
    //                 ideal, because exactly one core did the whole row.
    //   * BmmsVecNN2D splits (row, n-block) so N is distributed too. It costs
    //                 extra x1 re-reads, a SetAtomicMax per row, and a second
    //                 launch -- measured about 2x SLOWER on big B*M shapes, but
    //                 it collapses the single-core case: the same B=1 M=1 N=8192
    //                 K=8192 shape went 20.11ms -> 1.48ms (13.6x).
    // So use the split path only when B*M cannot fill the vector cores, i.e.
    // when the row space is smaller than the core budget. Both paths PASS the
    // local shape sweep.
    // Any transposed layout must take the scalar kernel: it is the ONLY path
    // that honours transposeX1/transposeX2 (it indexes the stored [B,K,M] /
    // [B,N,K] buffers explicitly). The vector paths -- vec_nn, vec_2d and the
    // N-split reduction -- all assume natural [B,M,K] / [B,K,N] storage and
    // silently produce a wrong answer on transposed input. This guard must sit
    // BEFORE the useSplit branch because that branch dispatches straight to
    // vec_2d without ever consulting vecOk, which previously let every small
    // B*M transposed shape fall through to the natural-layout kernel.
    if (!vecOk) {
        if (sx1.dtype == 1) {
            bmms_p2_scalar_fp16<<<blockNum, nullptr, stream>>>(
                x1, x2, y, B, M, N, K, transposeX1, transposeX2);
        } else {
            bmms_p2_scalar_bf16<<<blockNum, nullptr, stream>>>(
                x1, x2, y, B, M, N, K, transposeX1, transposeX2);
        }
        return;
    }

    const bool useSplit = (rowTotal < vecCoreBudget);

    if (!useSplit) {
        // The transposed layouts already returned above, so the natural-layout
        // vector kernel is the only remaining choice here.
        if (sx1.dtype == 1) {
            bmms_p3_vecnn_fp16<<<blockNum, nullptr, stream>>>(
                x1, x2, y, B, M, N, K);
        } else {
            bmms_p3_vecnn_bf16<<<blockNum, nullptr, stream>>>(
                x1, x2, y, B, M, N, K);
        }
        return;
    }

    // --- N-split path: needs a rowMax scratch (B*M fp32) ---------------------
    // All three stages run inside ONE fused kernel (BmmsSplitFused): seed the
    // scratch to -inf, atomicMax the per-(row,n-block) maxima, then sum each
    // batch's row maxima into y. They used to be three launches, which violates
    // the profiler's one-launch-per-call rule; two AIV-only barriers now order
    // them inside a single launch instead.
    const size_t rmBytes = static_cast<size_t>(B) * static_cast<size_t>(M) * sizeof(float);
    void *rowMax = nullptr;
    if (aclrtMalloc(&rowMax, rmBytes, ACL_MEM_MALLOC_HUGE_FIRST) != 0 || rowMax == nullptr) {
        // Scratch unavailable: fall back to the (correct, if slower) one-stage
        // path rather than producing a wrong answer.
        if (sx1.dtype == 1) {
            bmms_p3_vecnn_fp16<<<blockNum, nullptr, stream>>>(x1, x2, y, B, M, N, K);
        } else {
            bmms_p3_vecnn_bf16<<<blockNum, nullptr, stream>>>(x1, x2, y, B, M, N, K);
        }
        return;
    }
    // Kernel launch parameters must be __gm__ typed; aclrtMalloc hands back void*.
    GM_ADDR gmRowMax = (GM_ADDR)rowMax;

    // Widened launch width: the fused body also carries the seed and reduce
    // stages, so size the grid for the (rows * n-blocks) work space.
    {
        const int64_t nBlocks = (N + NB - 1) / NB;
        int64_t work = (B * M) * nBlocks;
        int64_t splitBlocks = (work < static_cast<int64_t>(availableCoreNum))
                                  ? work : static_cast<int64_t>(availableCoreNum);
        if (splitBlocks < 1) splitBlocks = 1;
        const uint32_t sb = static_cast<uint32_t>(splitBlocks);

        if (sx1.dtype == 1) {
            bmms_p5_split_fp16<<<sb, nullptr, stream>>>(x1, x2, gmRowMax, y, B, M, N, K);
        } else {
            bmms_p5_split_bf16<<<sb, nullptr, stream>>>(x1, x2, gmRowMax, y, B, M, N, K);
        }
    }

    // Free after the stream work is enqueued. aclrtFree on its own does not wait
    // for the kernels above; the caller's sync happens outside the operator.
    aclrtFree(rowMax);
}
