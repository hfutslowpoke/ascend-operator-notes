#include <cmath>
#include <vector>
#include "kernel_operator.h"
#include "c_api/sys_var/sys_var.h"
/*
 * BatchMatmulMaxSum Kernel — Ascend C Direct Invocation
 * This file is #included — do NOT add main(), #pragma once, or include guards.
 *
 * TensorGroupInfo / TensorInfo (predefined):
 *   struct TensorInfo { const int64_t* shape; int64_t numDims; int32_t dtype; };
 *   struct TensorGroupInfo { const TensorInfo* tensors; int64_t numTensors; };
 *   dtype: 0=fp32 1=fp16 2=bf16 3=int8 4=int16 5=int32 6=int64 7=uint8 8=uint16 9=uint32 10=uint64 11=bool
 *
 * Computation, order fixed and never reordered:
 *   A[b,m,n] = sum_k x1[b,m,k] * x2[b,k,n]     (fp32 accumulate)
 *   R[b,m]   = max_n A[b,m,n]                  (init -inf; never 0)
 *   y[b]     = sum_m R[b,m]                    (fp32)
 *
 * transposeX1 / transposeX2 are storage-layout flags only. They change
 * addressing and never perform an explicit transpose.
 *
 * Implementation: pure Vector. No Nd2Nz / Mmad / Fixpipe.
 *
 * All global->UB loads use DataCopyPad with a BYTE blockLen, because plain
 * DataCopy requires the element count to be 32B aligned and silently drops the
 * tail otherwise (e.g. an fp16 row of N == 1 is only 2 bytes).
 */

using namespace AscendC;

namespace {

constexpr int32_t KB = 128;  // K block (elements)
constexpr int32_t NB = 128;  // N block (elements)

// UB element budget (fp32 units), non-overlapping:
//   x2t [KB*NB]  x2 tile staging in INPUT precision (raw fp16/bf16)
//   bF  [KB*NB]  x2 tile cast to fp32
//   aF  [KB]     x1 K-block, fp32
//   cF  [NB]     accumulator over K, fp32
//   maxF[NB]     reduce scratch, fp32
//   rF  [64]     misc
constexpr int32_t UB_FLOATS = KB * NB * 4 + KB + NB + NB + 64;

// DataCopyPad pads every UB row up to a 32-byte boundary, so the in-UB row
// pitch of a KM x KN tile is NOT KN elements — it is KN rounded up to the
// 32-byte block. Index the tile with this pitch.
template <typename IN_T>
__aicore__ inline constexpr int32_t BmmsPitch()
{
    // elements per 32-byte block
    constexpr int32_t ePerBlk = 32 / static_cast<int32_t>(sizeof(IN_T));
    return ((NB + ePerBlk - 1) / ePerBlk) * ePerBlk;
}

// Maximum N the resident-accumulator design supports (spec: N <= 8192).
constexpr int32_t NMAX = 8192;

// UB bytes:
//   x1t [KB]       IN_T   x1 K-block staging (reused across all n-blocks)
//   x2t [KB*pitch] IN_T   x2 tile staging
//   bF  [KB*pitch] fp32   x2 tile cast
//   aF  [KB] + cF[NMAX] + maxF[8] + redTmp[NB] + rF[64]  (fp32)
template <typename IN_T>
__aicore__ inline constexpr int32_t BmmsUbBytes()
{
    constexpr int32_t pitch = BmmsPitch<IN_T>();
    // cF is sized NMAX so every n-block accumulator stays resident while x1 is
    // loaded only once per (m, k-block).
    return (KB + KB * pitch) * static_cast<int32_t>(sizeof(IN_T))
         + (KB * pitch + KB + NMAX + 8 + NB + 64) * 4;
}

// bfloat16_t has no implicit/static conversion to float on the AI core; use the
// dedicated ToFloat path. half converts directly.
template <typename T>
__aicore__ inline float BmmsToFImpl(T v)
{
    return static_cast<float>(v);
}

__aicore__ inline float BmmsToFImpl(bfloat16_t v)
{
    return ToFloat(v);
}

template <typename T>
__aicore__ inline float BmmsToF(T v)
{
    return BmmsToFImpl(v);
}

}  // namespace

/*
 * Scalar reference kernel: correct for every shape, every tail, and all four
 * layouts.
 */

// ---- P4b: row-parallel tiny kernel -----------------------------------------
// The scalar reference below parallelises over BATCHES only, so for B=1 it runs
// one block and its per-element GetValue cost lands entirely on one core. That
// is why it fell off a cliff past ~975 MACs. This version strides over (b,m)
// ROWS instead, so every row of a small shape gets its own block, and it folds
// each row's max into y with one atomic add (y is already zeroed upstream).
#define DEFINE_BMMS_TINY_KERNEL(KERNEL_NAME, DATA_T)                               \
extern "C" __global__ __vector__ void KERNEL_NAME(                                 \
    GM_ADDR x1, GM_ADDR x2, GM_ADDR y,                                             \
    int64_t B, int64_t M, int64_t N, int64_t K,                                    \
    bool transposeX1, bool transposeX2)                                            \
{                                                                                  \
    GlobalTensor<DATA_T> x1Gm;                                                     \
    GlobalTensor<DATA_T> x2Gm;                                                     \
    GlobalTensor<float> yGm;                                                       \
    x1Gm.SetGlobalBuffer(reinterpret_cast<__gm__ DATA_T *>(x1));                   \
    x2Gm.SetGlobalBuffer(reinterpret_cast<__gm__ DATA_T *>(x2));                   \
    yGm.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(y));                      \
    TPipe _tpipe;                                                                  \
    TBuf<TPosition::VECCALC> _tb;                                                  \
    _tpipe.InitBuffer(_tb, 32 * sizeof(float));                                    \
    LocalTensor<float> _out = _tb.Get<float>();                                    \
    const int64_t rowTotal = B * M;                                                \
    const int64_t blk = static_cast<int64_t>(GetBlockIdx());                       \
    const int64_t nBlk = static_cast<int64_t>(GetBlockNum());                      \
    for (int64_t r = blk; r < rowTotal; r += nBlk) {                               \
        const int64_t b = r / M;                                                   \
        const int64_t m = r % M;                                                   \
        float rowMax = -3.402823466e+38F;                                          \
        for (int64_t n = 0; n < N; ++n) {                                          \
            float dot = 0.0f;                                                      \
            for (int64_t k = 0; k < K; ++k) {                                      \
                uint64_t o1 = !transposeX1                                         \
                    ? static_cast<uint64_t>((b * M + m) * K + k)                   \
                    : static_cast<uint64_t>((b * K + k) * M + m);                  \
                uint64_t o2 = !transposeX2                                         \
                    ? static_cast<uint64_t>((b * K + k) * N + n)                   \
                    : static_cast<uint64_t>((b * N + n) * K + k);                  \
                dot += BmmsToF<DATA_T>(x1Gm.GetValue(o1)) *                        \
                       BmmsToF<DATA_T>(x2Gm.GetValue(o2));                         \
            }                                                                      \
            if (dot > rowMax) rowMax = dot;                                        \
        }                                                                          \
        _out.SetValue(0, rowMax);                                                  \
        PipeBarrier<PIPE_ALL>();                                                   \
        {                                                                          \
            DataCopyExtParams _o;                                                  \
            _o.blockCount = 1;                                                     \
            _o.blockLen = static_cast<uint32_t>(sizeof(float));                    \
            _o.srcStride = 0;                                                      \
            _o.dstStride = 0;                                                      \
            _o.rsv = 0;                                                            \
            SetAtomicAdd<float>();                                                 \
            DataCopyPad(yGm[static_cast<uint64_t>(b)], _out, _o);                  \
            SetAtomicNone();                                                       \
            PipeBarrier<PIPE_ALL>();                                               \
        }                                                                          \
    }                                                                              \
}

DEFINE_BMMS_TINY_KERNEL(bmms_ptiny_fp16, half)
DEFINE_BMMS_TINY_KERNEL(bmms_ptiny_bf16, bfloat16_t)

#define DEFINE_BMMS_SCALAR_KERNEL(KERNEL_NAME, DATA_T)                              \
extern "C" __global__ __vector__ void KERNEL_NAME(                                    \
    GM_ADDR x1, GM_ADDR x2, GM_ADDR y,                                              \
    int64_t B, int64_t M, int64_t N, int64_t K,                                     \
    bool transposeX1, bool transposeX2)                                             \
{                                                                                   \
    GlobalTensor<DATA_T> x1Gm;                                                      \
    GlobalTensor<DATA_T> x2Gm;                                                      \
    GlobalTensor<float> yGm;                                                        \
    x1Gm.SetGlobalBuffer(reinterpret_cast<__gm__ DATA_T *>(x1));                    \
    x2Gm.SetGlobalBuffer(reinterpret_cast<__gm__ DATA_T *>(x2));                    \
    yGm.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(y));                       \
    TPipe _spipe;                                                                   \
    TBuf<TPosition::VECCALC> _sub;                                                  \
    _spipe.InitBuffer(_sub, 32 * sizeof(float));                                    \
    LocalTensor<float> _outF = _sub.Get<float>();                                   \
    const int64_t blockIdx = static_cast<int64_t>(GetBlockIdx());                   \
    const int64_t blockNum = static_cast<int64_t>(GetBlockNum());                   \
    for (int64_t b = blockIdx; b < B; b += blockNum) {                              \
        float batchSum = 0.0f;                                                      \
        for (int64_t m = 0; m < M; ++m) {                                           \
            float rowMax = -3.402823466e+38F;                                       \
            for (int64_t n = 0; n < N; ++n) {                                       \
                float dot = 0.0f;                                                   \
                for (int64_t k = 0; k < K; ++k) {                                   \
                    uint64_t x1Offset = !transposeX1                                \
                        ? static_cast<uint64_t>((b * M + m) * K + k)                \
                        : static_cast<uint64_t>((b * K + k) * M + m);               \
                    uint64_t x2Offset = !transposeX2                                \
                        ? static_cast<uint64_t>((b * K + k) * N + n)                \
                        : static_cast<uint64_t>((b * N + n) * K + k);               \
                    dot += BmmsToF<DATA_T>(x1Gm.GetValue(x1Offset)) *               \
                           BmmsToF<DATA_T>(x2Gm.GetValue(x2Offset));                \
                }                                                                   \
                if (dot > rowMax) rowMax = dot;                                     \
            }                                                                       \
            batchSum += rowMax;                                                     \
        }                                                                           \
        _outF.SetValue(0, batchSum);                                                \
        PipeBarrier<PIPE_ALL>();                                                    \
        {                                                                           \
            DataCopyExtParams _o;                                                   \
            _o.blockCount = 1;                                                      \
            _o.blockLen = static_cast<uint32_t>(sizeof(float));                     \
            _o.srcStride = 0;                                                       \
            _o.dstStride = 0;                                                       \
            _o.rsv = 0;                                                             \
            DataCopyPad(yGm[static_cast<uint64_t>(b)], _outF, _o);                  \
            PipeBarrier<PIPE_ALL>();                                                \
        }                                                                           \
    }                                                                               \
}

DEFINE_BMMS_SCALAR_KERNEL(bmms_p2_scalar_fp16, half)
DEFINE_BMMS_SCALAR_KERNEL(bmms_p2_scalar_bf16, bfloat16_t)

/*
 * Vector kernel, natural layouts only: x1 [B,M,K], x2 [B,K,N].
 *
 * Per (b, m):
 *   rowMax = -inf
 *   for n-block:
 *     cF[0..nNow) = 0
 *     for k-block:
 *       aF[0..kNow) <- x1[b, m, k0..]      (fp16 -> fp32)
 *       for kk in [0, kNow):
 *         bF[0..nNow) <- x2[b, k0+kk, n0..] (fp16 -> fp32)
 *         cF[j] += aF[kk] * bF[j]
 *     rowMax = max(rowMax, max(cF[0..nNow)))
 *   batchSum += rowMax
 */
template <typename IN_T>
__aicore__ inline void BmmsVecNN(
    GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
    int64_t B, int64_t M, int64_t N, int64_t K)
{
    GlobalTensor<IN_T> x1Gm;
    GlobalTensor<IN_T> x2Gm;
    GlobalTensor<float> yGm;
    x1Gm.SetGlobalBuffer(reinterpret_cast<__gm__ IN_T *>(x1));
    x2Gm.SetGlobalBuffer(reinterpret_cast<__gm__ IN_T *>(x2));
    yGm.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(y));

    constexpr int32_t PITCH = BmmsPitch<IN_T>();

    TPipe pipe;
    TBuf<TPosition::VECCALC> ubBuf;
    pipe.InitBuffer(ubBuf, BmmsUbBytes<IN_T>());

    // Layout: x1t[KB] | x2t[KB*PITCH] (IN_T) |
    //         bF[KB*PITCH] | aF[KB] | cF[NMAX] | maxF[8] | redTmp[NB] | rF[64]  (fp32)
    // cF holds one NB-wide accumulator per n-block (resident across k-blocks).
    // redTmp is the ReduceMax workspace; it must not alias dst (maxF).
    LocalTensor<IN_T>  x1t = ubBuf.Get<IN_T>();
    LocalTensor<IN_T>  x2t = x1t[KB];
    LocalTensor<float> bF  = x2t[KB * PITCH].template ReinterpretCast<float>();
    LocalTensor<float> aF  = bF[KB * PITCH];
    LocalTensor<float> cF  = aF[KB];
    LocalTensor<float> maxF = cF[NMAX];
    LocalTensor<float> redTmp = maxF[8];
    LocalTensor<float> rF  = redTmp[NB];

    DataCopyPadExtParams<IN_T> padParams;
    padParams.isPad = false;
    padParams.leftPadding = 0;
    padParams.rightPadding = 0;
    padParams.paddingValue = static_cast<IN_T>(0);

    const int64_t blockIdx = static_cast<int64_t>(GetBlockIdx());
    const int64_t blockNum = static_cast<int64_t>(GetBlockNum());

    // Flatten (b, m) into one row space so cores spread over B*M instead of B
    // alone. Previously only B was split, so a small-batch / large-M workload
    // (B=1, M=8192) put a single core on the whole problem and left every other
    // core idle — the likely cause of the long-tail timeout. Rows are handed out
    // in contiguous chunks and each core always owns WHOLE rows, so the only
    // cross-core merge is the M-dim sum (y[b] += row max): no N splitting, and
    // therefore no max-vs-add ambiguity at the batch boundary.
    const int64_t rowTotal = B * M;
    const int64_t perCore = (rowTotal + blockNum - 1) / blockNum;
    int64_t rowBegin = blockIdx * perCore;
    int64_t rowEnd = rowBegin + perCore;
    if (rowBegin > rowTotal) rowBegin = rowTotal;
    if (rowEnd > rowTotal) rowEnd = rowTotal;

    // Running M-dim sum for the batch currently open. Rows of one batch must be
    // added, not overwritten, so the sum is held across rows and committed once
    // per (core, batch). y is pre-zeroed by the host and every commit is an
    // atomic add, because a core's row chunk can share a batch with another
    // core's chunk.
    float batchSum = 0.0f;

    for (int64_t rowIdx = rowBegin; rowIdx < rowEnd; ++rowIdx) {
        const int64_t b = rowIdx / M;
        const int64_t m = rowIdx - b * M;
        float rowMax = -3.402823466e+38F;

            // Zero every n-block's accumulator up front. x1 is then loaded ONCE
            // per (m, k-block) and reused for all n-blocks: x1 traffic per row is
            // O(K) instead of O(nBlocks * K).
            {
                const int64_t nBlk = (N + NB - 1) / NB;
                Duplicate(cF, 0.0f, static_cast<int32_t>(nBlk * NB));
            }
            PipeBarrier<PIPE_ALL>();

            for (int64_t k0 = 0; k0 < K; k0 += KB) {
                const int32_t kNow = static_cast<int32_t>(
                    ((K - k0) < static_cast<int64_t>(KB)) ? (K - k0) : KB);

                // --- x1 K-block -> aF (fp32), loaded once ---
                {
                    DataCopyExtParams aCp;
                    aCp.blockCount = 1;
                    aCp.blockLen = static_cast<uint32_t>(kNow) * sizeof(IN_T);
                    aCp.srcStride = 0;
                    aCp.dstStride = 0;
                    aCp.rsv = 0;
                    DataCopyPad(x1t, x1Gm[static_cast<uint64_t>((b * M + m) * K + k0)], aCp, padParams);
                    PipeBarrier<PIPE_ALL>();
                    Cast(aF, x1t, RoundMode::CAST_NONE, kNow);
                    PipeBarrier<PIPE_ALL>();
                }

                for (int64_t n0 = 0; n0 < N; n0 += NB) {
                    const int32_t nNow = static_cast<int32_t>(
                        ((N - n0) < static_cast<int64_t>(NB)) ? (N - n0) : NB);
                    const int32_t cOff = static_cast<int32_t>(n0);

                    // --- x2 tile [kNow x nNow] -> bF (fp32) ---
                    // Natural: rows are k, columns are n  -> blockCount=kNow, blockLen=nNow
                    {
                        DataCopyExtParams bCp;
                        bCp.blockCount = static_cast<uint16_t>(kNow);
                        bCp.blockLen = static_cast<uint32_t>(nNow) * sizeof(IN_T);
                        // GM gap between rows, in 32-byte blocks.
                        bCp.srcStride = static_cast<uint32_t>((N - nNow) * sizeof(IN_T));
                        // UB gap between rows: padded pitch minus the row length.
                        // dstStride is measured in 32-byte blocks on this
                        // toolchain (probe: ds=7 with blockLen=16B gave a 240B
                        // row pitch). srcStride below is measured in raw bytes.
                        // nNow is always a multiple of 16 here, so the block
                        // rounding below collapses to the plain difference.
                        bCp.dstStride = static_cast<uint32_t>(
                            ((PITCH - nNow) * static_cast<int32_t>(sizeof(IN_T))) / 32);
                        bCp.rsv = 0;
                        DataCopyPad(x2t, x2Gm[static_cast<uint64_t>((b * K + k0) * N + n0)], bCp, padParams);
                        PipeBarrier<PIPE_ALL>();
                        // Cast the whole tile, then fix the row pitch: rows are
                        // PITCH apart in UB but the Cast output is dense.
                        Cast(bF, x2t, RoundMode::CAST_NONE, kNow * PITCH);
                        PipeBarrier<PIPE_ALL>();
                    }

                    // --- accumulate into this n-block's resident accumulator ---
                    // Use explicit Muls + Add instead of Axpy: the Adv-API Axpy has
                    // overloads that take a sharedTmpBuffer, and passing our (dst,
                    // src, scalar, count) call can mis-bind, giving a silently
                    // wrong (but deterministic) result.
                    //
                    // The unambiguous Level-2 overload takes an
                    // int32_t count as the last argument; passing the count
                    // explicitly (here via a named int32_t lvalue) pins that
                    // overload and avoids the Adv-API mis-bind.
                    //
                    // cF += aF[kk] * bF[kk]  -- Axpy folds the Muls+Add pair
                    // into one vector instruction, halving the inner-loop
                    // instruction count (the profiler showed aiv_vec under
                    // 2% busy while aiv_scalar and idle dominated).
                    for (int32_t kk = 0; kk < kNow; ++kk) {
                        const int32_t cCount = static_cast<int32_t>(nNow);
                        Axpy(cF[cOff], bF[kk * PITCH], aF.GetValue(kk), cCount);
                    }
                    PipeBarrier<PIPE_ALL>();
                }
            }

            // Reduce each n-block's accumulator and fold into the row max.
            for (int64_t n0 = 0; n0 < N; n0 += NB) {
                const int32_t nNow = static_cast<int32_t>(
                    ((N - n0) < static_cast<int64_t>(NB)) ? (N - n0) : NB);
                ReduceMax(maxF, cF[static_cast<int32_t>(n0)], redTmp, nNow, false);
                PipeBarrier<PIPE_ALL>();
                const float blockMax = maxF.GetValue(0);
                if (blockMax > rowMax) rowMax = blockMax;
            }

            // y[b] is the SUM over m of the per-row max, so fold this row's max
            // into the open batch rather than storing it straight out.
            batchSum += rowMax;

            // Commit the batch when the next row belongs to a different one (or
            // when this core is about to run out of rows but still owes a
            // commit). Atomic add because a core's row chunk can share a batch
            // with another core's chunk; the host pre-zeroes y.
            const int64_t nextB = (rowIdx + 1 < rowEnd) ? ((rowIdx + 1) / M) : -1;
            if (nextB != b) {
                rF.SetValue(0, batchSum);
                PipeBarrier<PIPE_ALL>();
                DataCopyExtParams oCp;
                oCp.blockCount = 1;
                oCp.blockLen = static_cast<uint32_t>(sizeof(float));
                oCp.srcStride = 0;
                oCp.dstStride = 0;
                oCp.rsv = 0;
                SetAtomicAdd<float>();
                DataCopyPad(yGm[static_cast<uint64_t>(b)], rF, oCp);
                SetAtomicNone();
                PipeBarrier<PIPE_ALL>();
                batchSum = 0.0f;
            }
        }
    }


/*
 * Two-stage Vector kernel: N-split parallel variant.
 *
 * BmmsVecNN (above) hands each core WHOLE rows and splits only over (b, m).
 * That leaves most cores idle whenever B*M is smaller than the core budget --
 * and the worst case is exactly the large-N one: B=1, M=1, N=8192 gives a
 * SINGLE core doing all of the x2 traffic (K*N elements).
 *
 * This variant splits over (row, n-block) pairs instead, so N itself is
 * distributed across cores. The two reduction dimensions have DIFFERENT
 * semantics and are therefore handled in two SEPARATE stages:
 *
 *   stage 1 (main kernel):    rowMax[r] = max over n of dot(x1[r,:], x2[:,n])
 *                             -> cross-core merge is a MAX
 *                                (SetAtomicMax<float>, each core contributes
 *                                 its own n-block's partial row max)
 *   stage 2 (reduce kernel):  y[b] = sum over m of rowMax[b*M + m]
 *                             -> cross-core merge is a SUM
 *
 * Keeping them separate is essential: merging the n-blocks of one row with an
 * ADD (or merging the m rows with a MAX) silently produces a plausible but
 * wrong number. A previous N-split attempt did exactly that and broke shapes
 * whose n-blocks were added instead of max-merged.
 *
 * Host side (run_kernel) allocates the rowMax scratch, pre-fills it with -inf,
 * and pre-zeroes y.
 */

// stage 1: per-(row, n-block) partial row max, merged with an atomic MAX.
template <typename IN_T>
__aicore__ inline void BmmsVecNN2D(
    GM_ADDR x1, GM_ADDR x2, GM_ADDR rowMaxGm,
    int64_t B, int64_t M, int64_t N, int64_t K)
{
    GlobalTensor<IN_T> x1Gm;
    GlobalTensor<IN_T> x2Gm;
    GlobalTensor<float> rmGm;
    x1Gm.SetGlobalBuffer(reinterpret_cast<__gm__ IN_T *>(x1));
    x2Gm.SetGlobalBuffer(reinterpret_cast<__gm__ IN_T *>(x2));
    rmGm.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(rowMaxGm));

    constexpr int32_t PITCH = BmmsPitch<IN_T>();

    TPipe pipe;
    TBuf<TPosition::VECCALC> ubBuf;
    pipe.InitBuffer(ubBuf, BmmsUbBytes<IN_T>());

    LocalTensor<IN_T>  x1t = ubBuf.Get<IN_T>();
    LocalTensor<IN_T>  x2t = x1t[KB];
    LocalTensor<float> bF  = x2t[KB * PITCH].template ReinterpretCast<float>();
    LocalTensor<float> aF  = bF[KB * PITCH];
    LocalTensor<float> cF  = aF[KB];
    LocalTensor<float> maxF = cF[NMAX];
    LocalTensor<float> redTmp = maxF[8];
    LocalTensor<float> rF  = redTmp[NB];

    DataCopyPadExtParams<IN_T> padParams;
    padParams.isPad = false;
    padParams.leftPadding = 0;
    padParams.rightPadding = 0;
    padParams.paddingValue = static_cast<IN_T>(0);

    const int64_t blockIdx = static_cast<int64_t>(GetBlockIdx());
    const int64_t blockNum = static_cast<int64_t>(GetBlockNum());

    const int64_t rowTotal = B * M;
    const int64_t nBlocks = (N + NB - 1) / NB;
    const int64_t workTotal = rowTotal * nBlocks;
    const int64_t perCore = (workTotal + blockNum - 1) / blockNum;
    int64_t wBegin = blockIdx * perCore;
    int64_t wEnd = wBegin + perCore;
    if (wBegin > workTotal) wBegin = workTotal;
    if (wEnd > workTotal) wEnd = workTotal;

    // Walk this core's (row, n-block) work items. Cores hand out CONTIGUOUS
    // ranges, so a run of work items usually covers a whole row's n-blocks (and
    // often several whole rows). We must therefore accumulate the running max
    // across all n-blocks of the same row before committing it, otherwise a row
    // would be committed once per n-block.
    int64_t curRow = -1;
    float rowAcc = -3.402823466e+38F;

    for (int64_t w = wBegin; w < wEnd; ++w) {
        const int64_t rowIdx = w / nBlocks;
        const int64_t nBlkIdx = w - rowIdx * nBlocks;
        const int64_t b = rowIdx / M;
        const int64_t m = rowIdx - b * M;
        const int64_t n0 = nBlkIdx * NB;
        const int32_t nNow = static_cast<int32_t>(
            ((N - n0) < static_cast<int64_t>(NB)) ? (N - n0) : NB);
        const int32_t cOff = static_cast<int32_t>(n0);

        // A new row starts: flush the accumulated max of the previous row.
        if (rowIdx != curRow) {
            if (curRow >= 0) {
                rF.SetValue(0, rowAcc);
                PipeBarrier<PIPE_ALL>();
                DataCopyExtParams oCp;
                oCp.blockCount = 1;
                oCp.blockLen = static_cast<uint32_t>(sizeof(float));
                oCp.srcStride = 0;
                oCp.dstStride = 0;
                oCp.rsv = 0;
                // N-dim merge is a MAX, not a sum.
                SetAtomicMax<float>();
                DataCopyPad(rmGm[static_cast<uint64_t>(curRow)], rF, oCp);
                DisableDmaAtomic();
                PipeBarrier<PIPE_ALL>();
            }
            curRow = rowIdx;
            rowAcc = -3.402823466e+38F;
        }

        // Zero THIS work item's accumulator slice. The accumulator lives at
        // cF[cOff .. cOff+nNow); zeroing from cF[0] would leave every n-block
        // past the first with the previous item's residue in place.
        Duplicate(cF[cOff], 0.0f, NB);
        PipeBarrier<PIPE_ALL>();

        for (int64_t k0 = 0; k0 < K; k0 += KB) {
            const int32_t kNow = static_cast<int32_t>(
                ((K - k0) < static_cast<int64_t>(KB)) ? (K - k0) : KB);

            {
                DataCopyExtParams aCp;
                aCp.blockCount = 1;
                aCp.blockLen = static_cast<uint32_t>(kNow) * sizeof(IN_T);
                aCp.srcStride = 0;
                aCp.dstStride = 0;
                aCp.rsv = 0;
                DataCopyPad(x1t, x1Gm[static_cast<uint64_t>((b * M + m) * K + k0)], aCp, padParams);
                PipeBarrier<PIPE_ALL>();
                Cast(aF, x1t, RoundMode::CAST_NONE, kNow);
                PipeBarrier<PIPE_ALL>();
            }

            {
                DataCopyExtParams bCp;
                bCp.blockCount = static_cast<uint16_t>(kNow);
                bCp.blockLen = static_cast<uint32_t>(nNow) * sizeof(IN_T);
                // srcStride is a raw BYTE count on this toolchain; dstStride is
                // a count of 32-byte BLOCKS. See the note in run_kernel.
                bCp.srcStride = static_cast<uint32_t>((N - nNow) * sizeof(IN_T));
                bCp.dstStride = static_cast<uint32_t>(
                    ((PITCH - nNow) * static_cast<int32_t>(sizeof(IN_T))) / 32);
                bCp.rsv = 0;
                DataCopyPad(x2t, x2Gm[static_cast<uint64_t>((b * K + k0) * N + n0)], bCp, padParams);
                PipeBarrier<PIPE_ALL>();
                Cast(bF, x2t, RoundMode::CAST_NONE, kNow * PITCH);
                PipeBarrier<PIPE_ALL>();
            }

            // cF += aF[kk] * bF[kk] via the unambiguous Level-2 Axpy
            // (int32_t count pins this overload). Halves the inner-loop
            // instruction count versus a separate Muls+Add pair.
            for (int32_t kk = 0; kk < kNow; ++kk) {
                const int32_t cCount = static_cast<int32_t>(nNow);
                Axpy(cF[cOff], bF[kk * PITCH], aF.GetValue(kk), cCount);
            }
            PipeBarrier<PIPE_ALL>();
        }

        ReduceMax(maxF, cF[cOff], redTmp, nNow, false);
        PipeBarrier<PIPE_ALL>();
        const float blockMax = maxF.GetValue(0);
        if (blockMax > rowAcc) rowAcc = blockMax;
    }

    // Flush the final open row.
    if (curRow >= 0) {
        rF.SetValue(0, rowAcc);
        PipeBarrier<PIPE_ALL>();
        DataCopyExtParams oCp;
        oCp.blockCount = 1;
        oCp.blockLen = static_cast<uint32_t>(sizeof(float));
        oCp.srcStride = 0;
        oCp.dstStride = 0;
        oCp.rsv = 0;
        SetAtomicMax<float>();
        DataCopyPad(rmGm[static_cast<uint64_t>(curRow)], rF, oCp);
        DisableDmaAtomic();
        PipeBarrier<PIPE_ALL>();
    }
}

// stage 2: y[b] = sum over m of rowMax[b*M + m]. A plain SUM, so this is done
// once per batch by a single core (no atomics needed).
__aicore__ inline void BmmsReduceM(
    GM_ADDR rowMaxGm, GM_ADDR y,
    int64_t B, int64_t M)
{
    GlobalTensor<float> rmGm;
    GlobalTensor<float> yGm;
    rmGm.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(rowMaxGm));
    yGm.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(y));

    const int64_t blockIdx = static_cast<int64_t>(GetBlockIdx());
    const int64_t blockNum = static_cast<int64_t>(GetBlockNum());

    TPipe pipe;
    TBuf<TPosition::VECCALC> ub;
    pipe.InitBuffer(ub, 4096);
    LocalTensor<float> acc = ub.Get<float>();

    // Each core takes a strided subset of batches; M is small in the shapes that
    // use this path, so the inner loop does not need vectorising.
    for (int64_t b = blockIdx; b < B; b += blockNum) {
        float sum = 0.0f;
        for (int64_t m = 0; m < M; ++m) {
            sum += rmGm.GetValue(static_cast<uint64_t>(b * M + m));
        }
        acc.SetValue(0, sum);
        PipeBarrier<PIPE_ALL>();
        DataCopyExtParams oCp;
        oCp.blockCount = 1;
        oCp.blockLen = static_cast<uint32_t>(sizeof(float));
        oCp.srcStride = 0;
        oCp.dstStride = 0;
        oCp.rsv = 0;
        DataCopyPad(yGm[static_cast<uint64_t>(b)], acc, oCp);
        PipeBarrier<PIPE_ALL>();
    }
}


/*
 * Device-side seeding of the rowMax scratch to -inf, run as its own launch on
 * the operator stream before stage 1. It exists so the host never has to do a
 * synchronous host->device copy inside run_kernel: that copy was the host block
 * that caused the timeout. -inf is not a repeated byte, so aclrtMemset cannot
 * produce it; one DataCopyPad of a single float per row is enough, and this path
 * only runs when B*M < the core budget (so the count is tiny).
 */
extern "C" __global__ __vector__ void bmms_seed_neg_inf(
    GM_ADDR dst, int64_t count)
{
    GlobalTensor<float> dGm;
    dGm.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(dst));

    const int64_t blockIdx = static_cast<int64_t>(GetBlockIdx());
    const int64_t blockNum = static_cast<int64_t>(GetBlockNum());

    TPipe pipe;
    TBuf<TPosition::VECCALC> ub;
    pipe.InitBuffer(ub, 64);
    LocalTensor<float> v = ub.Get<float>();
    v.SetValue(0, -3.402823466e+38F);
    PipeBarrier<PIPE_ALL>();

    DataCopyExtParams cp;
    cp.blockCount = 1;
    cp.blockLen = static_cast<uint32_t>(sizeof(float));
    cp.srcStride = 0;
    cp.dstStride = 0;
    cp.rsv = 0;
    for (int64_t i = blockIdx; i < count; i += blockNum) {
        DataCopyPad(dGm[static_cast<uint64_t>(i)], v, cp);
    }
    PipeBarrier<PIPE_ALL>();
}

extern "C" __global__ __vector__ void batch_matmul_max_sum_fp16_vec_2d(
    GM_ADDR x1, GM_ADDR x2, GM_ADDR rowMax, int64_t B, int64_t M, int64_t N, int64_t K)
{
    BmmsVecNN2D<half>(x1, x2, rowMax, B, M, N, K);
