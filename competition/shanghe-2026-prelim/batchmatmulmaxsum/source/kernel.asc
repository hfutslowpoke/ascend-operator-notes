// Dense record planes allow a single DMA publication wait per batch.
// Missing records are -FLT_MAX, matching the original row-merge initializer.
__aicore__ inline void DenseFinalRowMaxSum(
 GM_ADDR gp,GM_ADDR gy,int64_t B,int64_t M,int64_t N,int64_t bm,int maxPlanes,
 LocalTensor<float> planes,LocalTensor<float> maxima,LocalTensor<float> scratch,LocalTensor<float> out){
 GlobalTensor<float> pg,yg;pg.SetGlobalBuffer((__gm__ float*)gp);yg.SetGlobalBuffer((__gm__ float*)gy);
 const int64_t mt=M/bm,nt=(N+127)/128,nc=GetBlockNum(),items=B*mt*nt,q=items/nc,rr=items%nc,prefix=(q+1)*rr;
 for(int64_t batch=GetBlockIdx();batch<B;batch+=nc*2){
  Duplicate(planes,-3.402823466e+38F,(int32_t)(maxPlanes*M));
  Duplicate(maxima,-3.402823466e+38F,(int32_t)M);
  SetFlag<HardEvent::V_MTE2>(EVENT_ID0);WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
  for(int64_t mi=0;mi<mt;mi++){
   int64_t w=(batch*mt+mi)*nt,rowEnd=w+nt;int count=0;
   while(w<rowEnd){
    const int64_t co=w<prefix?w/(q+1):rr+(w-prefix)/q;
    int64_t end=co*q+(co<rr?co:rr)+q+(co<rr);if(end>rowEnd)end=rowEnd;
    const int blocks=(int)((end-w+3)/4);
    DataCopyExtParams cp{(uint16_t)blocks,(uint32_t)(bm*4),(uint32_t)(3*bm*4),(uint32_t)((M-bm)/8),0};
    DataCopyPadExtParams<float> pad{false,0,0,0};
    DataCopyPad(planes[(int64_t)count*M+mi*bm],pg[w*bm],cp,pad);
    count+=blocks;w=end;
   }
  }
  SetFlag<HardEvent::MTE2_V>(EVENT_ID0);WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
  for(int p=0;p<maxPlanes;p++){
   Max(maxima,maxima,planes[(int64_t)p*M],(int32_t)M);PipeBarrier<PIPE_V>();
  }
  ReduceSum(out,maxima,scratch,(int32_t)M);
  SetFlag<HardEvent::V_MTE3>(EVENT_ID0);WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
  DataCopyExtParams cp{1,4,0,0,0};DataCopyPad(yg[batch],out,cp);
  SetFlag<HardEvent::MTE3_V>(EVENT_ID0);WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
 }
}

__aicore__ inline void IsolatedDenseVectorRows(GM_ADDR gc,GM_ADDR gy,GM_ADDR gp,GM_ADDR gr,int64_t B,int64_t M,int64_t N,int64_t Cp,int64_t bm) {
 GlobalTensor<float> cg,yg,pg,rg;cg.SetGlobalBuffer((__gm__ float*)gc);yg.SetGlobalBuffer((__gm__ float*)gy);pg.SetGlobalBuffer((__gm__ float*)gp);rg.SetGlobalBuffer((__gm__ float*)gr);
 TPipe pipe;TBuf<TPosition::VECCALC> tb;pipe.InitBuffer(tb,192512);
 auto tile=tb.Get<float>();auto comp=tile[40960];auto row=comp[5120];auto row2=row[128];auto acc=row2[128];auto scratch=acc[128];auto out=scratch[1024];
 const int64_t core=GetBlockIdx()/2,sub=GetSubBlockIdx(),nc=GetBlockNum();
 const int64_t mt=(M+bm-1)/bm,nt=(N+127)/128,items=B*mt*nt,q=items/nc,rr=items%nc;
 const int64_t first=core*q+(core<rr?core:rr),limit=first+q+(core<rr);
 const bool streamRows=nt>4 && nt<=32 && items/nc>4;
 for(int64_t w=first;w<limit;) {
  int64_t mi=(w/nt)%mt,ni=w%nt,batch=w/(mt*nt),m0=mi*bm+sub*(bm/2),n0=ni*128,run=nt-ni;
  if(run>limit-w)run=limit-w;
  if(streamRows && run>4)run=4;
  int nNow=N-n0<run*128?N-n0:run*128,rows=M-m0<bm/2?M-m0:bm/2;
  CrossCoreWaitFlag<2,PIPE_MTE2>(8);if(streamRows)CrossCoreSetFlag<2,PIPE_MTE2>(7);
  if(rows>0) {
   const int allRows=rows;
   int np=(nNow+63)&~63,al=(nNow+7)&~7,capacity=40960/np;if(capacity>64)capacity=64;
   for(int r=0;r<allRows;r+=capacity){rows=allRows-r<capacity?allRows-r:capacity;int count=rows*np;
   if(np!=nNow)Duplicate(tile,-3.402823466e+38F,count);
   SetFlag<HardEvent::V_MTE2>(EVENT_ID0);WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
   DataCopyExtParams cp{(uint16_t)rows,(uint32_t)(nNow*4),(uint32_t)((Cp-nNow)*4),(uint32_t)((np-al)/8),0};DataCopyPadExtParams<float> pad{true,0,(uint8_t)(al-nNow),-3.402823466e+38F};
   DataCopyPad(tile,cg[(batch*M+m0+r)*Cp+n0],cp,pad);
   SetFlag<HardEvent::MTE2_V>(EVENT_ID0);WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
   for(int off=0;off<count;off+=16320){int len=count-off<16320?count-off:16320;BlockReduceMax(comp[off/8],tile[off],len/64,64,1,1,8);}
   PipeBarrier<PIPE_V>();
   int width=np/8;WholeReduceMax(row,comp,width<64?width:64,rows,1,1,np/64,ReduceOrder::ORDER_ONLY_VALUE);
   for(int off=64;off<width;off+=64){WholeReduceMax(row2,comp[off],width-off<64?width-off:64,rows,1,1,np/64,ReduceOrder::ORDER_ONLY_VALUE);Max(row,row,row2,rows);}
   SetFlag<HardEvent::V_MTE3>(EVENT_ID0);WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
   DataCopyExtParams co{1,(uint32_t)(rows*4),0,0,0};DataCopyPad(pg[w*bm+sub*(bm/2)+r],row,co);
   SetFlag<HardEvent::MTE3_V>(EVENT_ID0);WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
   }
  }
  w+=run;
 }
 CrossCoreSetFlag<0,PIPE_MTE3>(9);CrossCoreWaitFlag<0,PIPE_MTE2>(9);
 // A row spans at most ceil((nt-1)/q) core boundaries; each can add one record.
 if(bm==128 && streamRows && M%128==0 && M<=5120){
  const int bound=(int)((nt+3)/4+(nt+q-2)/q);
  if((int64_t)bound*M<=40960){DenseFinalRowMaxSum(gp,gy,B,M,N,bm,bound,tile,comp,scratch,out);return;}
 }

 for(int64_t vi=GetBlockIdx();vi<B*mt*2;vi+=nc*2) {
 int64_t mi=(vi/2)%mt,part=vi%2,batch=vi/(mt*2);
 int rows=M-mi*bm-part*(bm/2)<bm/2?M-mi*bm-part*(bm/2):bm/2;if(rows<=0)continue;
 Duplicate(acc,-3.402823466e+38F,128);
 // DataCopyPad rounds each UB block to 32B; keep tail planes aligned.
 const int planePitch=(rows+7)&~7;
 const int64_t maxPlanes=streamRows?nt:(nt<nc?nt:nc);
 if(maxPlanes*planePitch<=40960){
  const int64_t rowEnd=(batch*mt+mi+1)*nt;int planeCount=0;
  SetFlag<HardEvent::V_MTE2>(EVENT_ID0);WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
  for(int64_t w=(batch*mt+mi)*nt;w<rowEnd;){
   const int64_t co=(w<(q+1)*rr)?w/(q+1):rr+(w-(q+1)*rr)/q;
   int64_t end=co*q+(co<rr?co:rr)+q+(co<rr);if(end>rowEnd)end=rowEnd;
   const int blocks=streamRows?(int)((end-w+3)/4):1;
   DataCopyExtParams cp{(uint16_t)blocks,(uint32_t)(rows*4),(uint32_t)(streamRows?(4*bm-rows)*4:0),0,0};
   DataCopyPadExtParams<float> pad{false,0,0,0};
   DataCopyPad(tile[planeCount*planePitch],pg[w*bm+part*(bm/2)],cp,pad);
   planeCount+=blocks;w=end;
  }
  SetFlag<HardEvent::MTE2_V>(EVENT_ID0);WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
  // Preserve the original increasing-w Max order and each dependent V access.
  for(int p=0;p<planeCount;p++){
   Max(acc,acc,tile[p*planePitch],rows);if(p+1<planeCount)PipeBarrier<PIPE_V>();
  }
 }else{
 for(int64_t w=(batch*mt+mi)*nt;w<(batch*mt+mi+1)*nt;) {
  int64_t co=(w<(q+1)*rr)?w/(q+1):rr+(w-(q+1)*rr)/q;
  int64_t end=co*q+(co<rr?co:rr)+q+(co<rr);
  DataCopyExtParams cp{1,(uint32_t)(rows*4),0,0,0};DataCopyPadExtParams<float> pad{false,0,0,0};
  SetFlag<HardEvent::V_MTE2>(EVENT_ID0);WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);DataCopyPad(row,pg[w*bm+part*(bm/2)],cp,pad);
  SetFlag<HardEvent::MTE2_V>(EVENT_ID0);WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);Max(acc,acc,row,rows);
  if(streamRows && end>w+4)end=w+4;
  w=end<(batch*mt+mi+1)*nt?end:(batch*mt+mi+1)*nt;
 }
 }
 SetFlag<HardEvent::V_MTE3>(EVENT_ID0);WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
 DataCopyExtParams cp{1,(uint32_t)(rows*4),0,0,0};DataCopyPad(rg[batch*M+mi*bm+part*(bm/2)],acc,cp);
 SetFlag<HardEvent::MTE3_V>(EVENT_ID0);WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
 }
 CrossCoreSetFlag<0,PIPE_MTE3>(10);CrossCoreWaitFlag<0,PIPE_MTE2>(10);
 for(int64_t batch=GetBlockIdx();batch<B;batch+=nc*2){
  DataCopyExtParams cp{1,(uint32_t)(M*4),0,0,0};DataCopyPadExtParams<float> pad{false,0,0,0};DataCopyPad(tile,rg[batch*M],cp,pad);SetFlag<HardEvent::MTE2_V>(EVENT_ID0);WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
  ReduceSum(out,tile,scratch,(int32_t)M);SetFlag<HardEvent::V_MTE3>(EVENT_ID0);WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);DataCopyExtParams cpout{1,4,0,0,0};DataCopyPad(yg[batch],out,cpout);SetFlag<HardEvent::MTE3_V>(EVENT_ID0);WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
 }
}



// Append separate entry points; original pipe_* entries and helpers stay verbatim.
#define ISOLATED_DENSE_ENTRY(NAME,T,TB) \
extern "C" __global__ __aicore__ void NAME(GM_ADDR a,GM_ADDR b,GM_ADDR c,GM_ADDR p,GM_ADDR r,GM_ADDR y,int64_t B,int64_t M,int64_t N,int64_t K,int64_t bm){KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);if ASCEND_IS_AIC {PipelinedCube<T,false,TB>(a,b,c,B,M,N,K,bm,128);}if ASCEND_IS_AIV {IsolatedDenseVectorRows(c,y,p,r,B,M,N,N,bm);}}
ISOLATED_DENSE_ENTRY(zzdense_h00,half,false)
ISOLATED_DENSE_ENTRY(zzdense_h01,half,true)
ISOLATED_DENSE_ENTRY(zzdense_b00,bfloat16_t,false)
ISOLATED_DENSE_ENTRY(zzdense_b01,bfloat16_t,true)
#undef ISOLATED_DENSE_ENTRY


// Isolated optimized entries; original device prefix above is verbatim.
template<typename T,bool TA,bool TB>
__aicore__ inline void IsolatedDirectTailSmall(GM_ADDR ga,GM_ADDR gb,GM_ADDR gy,int64_t B,int64_t M,int64_t N,int64_t K){
 const int64_t owner=GetBlockIdx();if(owner>=B)return;
 GlobalTensor<T> ag,bg;GlobalTensor<float> yg;ag.SetGlobalBuffer((__gm__ T*)ga);bg.SetGlobalBuffer((__gm__ T*)gb);yg.SetGlobalBuffer((__gm__ float*)gy);
 TPipe pipe;TBuf<TPosition::VECCALC> storage;pipe.InitBuffer(storage,196608);auto raw=storage.Get<T>();auto cast=raw[4096].template ReinterpretCast<float>();auto av=cast[4096];auto bv=av[2048];auto product=bv[2048];auto dot=product[32768];auto dot1=dot[256];auto maxima=dot1[256];auto result=maxima[32];auto idx=result[8].template ReinterpretCast<int32_t>();
 const int ap=((int)(M*K)+15)&~15,bp=((int)(N*K)+15)&~15,np=((int)N+7)&~7;
 {const int64_t batch=owner;
  DataCopyExtParams ac{1,(uint32_t)(M*K*2),0,0,0},bc{1,(uint32_t)(N*K*2),0,0,0};DataCopyPadExtParams<T> pa{true,0,(uint8_t)(ap-M*K),(T)0},pb{true,0,(uint8_t)(bp-N*K),(T)0};DataCopyPad(raw,ag[batch*M*K],ac,pa);DataCopyPad(raw[ap],bg[batch*N*K],bc,pb);SetFlag<HardEvent::MTE2_V>(EVENT_ID0);WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);Cast(cast,raw,RoundMode::CAST_NONE,ap+bp);
  auto af=cast;auto bf=cast[ap];
  if constexpr(TA){CreateVecIndex(idx,(int32_t)0,(uint32_t)K);Muls(idx,idx,(int32_t)(M*4),(int32_t)K);for(int m=0;m<M;m++)Gather(av[m*K],cast,idx.template ReinterpretCast<uint32_t>(),m*4,(int32_t)K);af=av;}
  const bool directTailB=TB && K<=64 && K%8==0;
  if(N!=np && !directTailB)Duplicate(bv,0.0f,np*K);
  if constexpr(TB){if(N!=np){if(directTailB){Duplicate(cast[ap+N*K],0.0f,(np-N)*K);}else{Adds(bv,cast[ap],0.0f,(int32_t)(N*K));bf=bv;}}}
  if constexpr(!TB){CreateVecIndex(idx,(int32_t)0,(uint32_t)K);Muls(idx,idx,(int32_t)(N*4),(int32_t)K);for(int n=0;n<N;n++)Gather(bv[n*K],cast[ap],idx.template ReinterpretCast<uint32_t>(),n*4,(int32_t)K);bf=bv;}
  BinaryRepeatParams rp(1,1,1,K/8,K/8,0);
  for(int m=0;m<M;m++){Mul(product[m*np*K],bf,af[m*K],(uint64_t)(K<64?K:64),(uint8_t)np,rp);if(K>64)MulAddDst(product[m*np*K],bf[64],af[m*K+64],(uint64_t)(K-64),(uint8_t)np,rp);}
  for(int off=0;off<M*np;off+=128){int nr=M*np-off<128?M*np-off:128;WholeReduceSum(dot[off],product[off*K],(uint64_t)(K<64?K:64),(uint8_t)nr,1,1,K/8);}
  WholeReduceMax(maxima,dot,(uint64_t)N,(uint8_t)M,1,1,np/8,ReduceOrder::ORDER_ONLY_VALUE);WholeReduceSum(result,maxima,(uint64_t)M,1,1,1,1);
  SetFlag<HardEvent::V_MTE3>(EVENT_ID0);WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);DataCopyExtParams cp{1,4,0,0,0};DataCopyPad(yg[batch],result,cp);
 }
}

template<class T,bool TX1,bool TX2>
__aicore__ inline void IsolatedResidentColumnCube(GM_ADDR ga,GM_ADDR gb,GM_ADDR gc,int64_t B,int64_t S,int64_t L,int64_t K){
 GlobalTensor<T> ag,bg;GlobalTensor<float> cg;ag.SetGlobalBuffer((__gm__ T*)ga);bg.SetGlobalBuffer((__gm__ T*)gb);cg.SetGlobalBuffer((__gm__ float*)gc);
 TPipe pipe;TBuf<TPosition::A1> a1b;TBuf<TPosition::A2> a2b;TBuf<TPosition::B1> b1b;TBuf<TPosition::B2> b2b;TBuf<TPosition::CO1> cb;
 pipe.InitBuffer(a1b,64*128*2);pipe.InitBuffer(a2b,64*128*2);pipe.InitBuffer(b1b,2*256*128*2);pipe.InitBuffer(b2b,256*128*2);pipe.InitBuffer(cb,64*256*4);
 auto a1=a1b.template Get<T>();auto a2=a2b.template Get<T>();auto b1=b1b.template Get<T>();auto b2=b2b.template Get<T>();auto c=cb.template Get<float>();
 const int mp=(S+15)&~15,kp=K;const int64_t mt=(L+255)/256;int64_t previous=-1;
 bool prefetched=false;int bank=0;
 for(int64_t w=GetBlockIdx();w<B*mt;w+=GetBlockNum()){
  auto longL1=b1[bank*32768];
  const int64_t batch=w/mt,n0=(w%mt)*256;const int now=L-n0<256?L-n0:256,np=(now+15)&~15;
  if(previous!=batch){
   Nd2NzParams acp{1,(uint16_t)(TX1?K:S),(uint16_t)(TX1?S:K),0,(uint16_t)(TX1?S:K),(uint16_t)(TX1?kp:mp),1,0};
   DataCopy(a1,ag[batch*S*K],acp);SetFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);WaitFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);
   if constexpr(TX1){LoadData2dTransposeParams p{0,(uint8_t)(kp/16),1,0,(uint16_t)(kp/16-1),0};for(int mi=0;mi<mp/16;mi++)LoadDataWithTranspose(a2[mi*kp*16],a1[mi*kp*16],p);}
   else{LoadData2DParams p{0,(uint8_t)(kp/16),(uint16_t)(mp/16),0,0,false,0};for(int mi=0;mi<mp/16;mi++)LoadData(a2[mi*kp*16],a1[mi*256],p);}
   previous=batch;
  }
  Nd2NzParams bcp{1,(uint16_t)(TX2?now:K),(uint16_t)(TX2?K:now),0,(uint16_t)(TX2?K:L),(uint16_t)(TX2?np:kp),1,0};
  if(!prefetched)DataCopy(longL1,bg[batch*K*L+(TX2?n0*K:n0)],bcp);SetFlag<HardEvent::MTE2_MTE1>(EVENT_ID1);WaitFlag<HardEvent::MTE2_MTE1>(EVENT_ID1);
  if constexpr(TX2){LoadData2DParams p{0,(uint8_t)(kp*np/256),1,0,0,false,0};LoadData(b2,longL1,p);}
  else{
   if(np<kp && np>=64){LoadData2dTransposeParams p{0,(uint8_t)(kp/16),1,(uint16_t)(np/16-1),0,0};for(int ni=0;ni<np/16;ni++)LoadDataWithTranspose(b2[ni*256],longL1[ni*kp*16],p);}
   else{LoadData2dTransposeParams p{0,(uint8_t)(np/16),(uint16_t)(kp/16),0,0,0};for(int ki=0;ki<kp/16;ki++)LoadDataWithTranspose(b2[ki*np*16],longL1[ki*256],p);}
  }

  // The opposite L1 bank was last read in the preceding iteration. Its
  // MTE1_M wait and retained final FIX_MTE2 wait completed that read.
  // L0B/L0C reuse remains protected by the original end-of-tile fence.
  const int64_t nextW=w+(int64_t)GetBlockNum();prefetched=nextW<(batch+1)*mt;
  if(prefetched){
   const int64_t nextBatch=batch,nextN0=n0+(int64_t)GetBlockNum()*256;
   const int nextNow=L-nextN0<256?L-nextN0:256,nextNP=(nextNow+15)&~15;
   Nd2NzParams nextCP{1,(uint16_t)(TX2?nextNow:K),(uint16_t)(TX2?K:nextNow),0,(uint16_t)(TX2?K:L),(uint16_t)(TX2?nextNP:kp),1,0};
   DataCopy(b1[(1-bank)*32768],bg[nextBatch*K*L+(TX2?nextN0*K:nextN0)],nextCP);
  }
  SetFlag<HardEvent::MTE1_M>(EVENT_ID0);WaitFlag<HardEvent::MTE1_M>(EVENT_ID0);
  MmadParams mm;mm.m=mp;mm.n=np;mm.k=kp;mm.cmatrixInitVal=true;mm.cmatrixSource=false;Mmad(c,a2,b2,mm);
  if((mp/16)*(np/16)<10)PipeBarrier<PIPE_M>();
  SetFlag<HardEvent::M_FIX>(EVENT_ID0);WaitFlag<HardEvent::M_FIX>(EVENT_ID0);
  FixpipeParamsV220 fp;fp.mSize=S;fp.nSize=np;fp.srcStride=mp;fp.dstStride=256;fp.ndNum=1;fp.srcNdStride=0;fp.dstNdStride=0;fp.reluEn=false;
  Fixpipe<float,float,CFG_ROW_MAJOR>(cg[w*mp*256],c,fp);CrossCoreSetFlag<2,PIPE_FIX>(8);
  SetFlag<HardEvent::FIX_MTE2>(EVENT_ID0);WaitFlag<HardEvent::FIX_MTE2>(EVENT_ID0);
  bank=1-bank;
 }
}

template<class T,bool TX1,bool TX2>
__aicore__ inline void IsolatedResidentTallCube(GM_ADDR ga,GM_ADDR gb,GM_ADDR gc,int64_t B,int64_t M,int64_t N,int64_t K) {
 GlobalTensor<T> ag,bg;GlobalTensor<float> cg;ag.SetGlobalBuffer((__gm__ T*)ga);bg.SetGlobalBuffer((__gm__ T*)gb);cg.SetGlobalBuffer((__gm__ float*)gc);
 TPipe pipe;TBuf<TPosition::A1> a1b;TBuf<TPosition::A2> a2b;TBuf<TPosition::B1> b1b;TBuf<TPosition::B2> b2b;TBuf<TPosition::CO1> cb;
 pipe.InitBuffer(a1b,2*256*128*2);pipe.InitBuffer(a2b,256*128*2);pipe.InitBuffer(b1b,64*128*2);pipe.InitBuffer(b2b,64*128*2);pipe.InitBuffer(cb,256*64*4);
 auto a1=a1b.template Get<T>();auto a2=a2b.template Get<T>();auto b1=b1b.template Get<T>();auto b2=b2b.template Get<T>();auto c=cb.template Get<float>();
 int np=((int)N+15)&~15,kp=(int)K,cs=np;const int64_t mt=(M+255)/256;int64_t previous=-1;
 bool prefetched=false;int bank=0;
 for(int64_t w=GetBlockIdx();w<B*mt;w+=GetBlockNum()){
  auto longL1=a1[bank*32768];int64_t batch=w/mt,m0=(w%mt)*256;int now=M-m0<256?M-m0:256,mp=(now+15)&~15;
  Nd2NzParams acp{1,(uint16_t)(TX1?K:now),(uint16_t)(TX1?now:K),0,(uint16_t)(TX1?M:K),(uint16_t)(TX1?kp:mp),1,0};
  Nd2NzParams bcp{1,(uint16_t)(TX2?N:K),(uint16_t)(TX2?K:N),0,(uint16_t)(TX2?K:N),(uint16_t)(TX2?np:kp),1,0};
  if(!prefetched)DataCopy(longL1,ag[batch*M*K+(TX1?m0:m0*K)],acp);if(previous!=batch)DataCopy(b1,bg[batch*K*N],bcp);
  SetFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);WaitFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);
  if constexpr(TX1) {
   LoadData2dTransposeParams p{0,(uint8_t)(kp/16),1,0,(uint16_t)(kp/16-1),0};
   for(int mi=0;mi<mp/16;mi++)LoadDataWithTranspose(a2[mi*kp*16],longL1[mi*kp*16],p);
  } else {
   uint8_t padding[4]={0,0,0,0};SetFmatrix(1,mp,padding,FmatrixMode::FMATRIX_LEFT);LoadData3DParamsV2Pro p;p.channelSize=kp;p.extConfig=((uint64_t)mp<<16)|kp;LoadData(a2,longL1,p);
  }
  if(previous!=batch){
  if constexpr(TX2) {LoadData2DParams p{0,(uint8_t)(kp*np/256),1,0,0,false,0};LoadData(b2,b1,p);}
  else {
   if (np < kp && np >= 64) {
    LoadData2dTransposeParams p{0,(uint8_t)(kp/16),1,(uint16_t)(np/16-1),0,0};
    for(int ni=0;ni<np/16;ni++)LoadDataWithTranspose(b2[ni*256],b1[ni*kp*16],p);
   } else {
    LoadData2dTransposeParams p{0,(uint8_t)(np/16),(uint16_t)(kp/16),0,0,0};
    for(int ki=0;ki<kp/16;ki++)LoadDataWithTranspose(b2[ki*np*16],b1[ki*256],p);
   }
  }
  previous=batch;}

  // Only the long-input L1 bank is prefetched. Resident short-input L0,
  // MMAD, FIX, output publication and their original reuse fences remain.
  const int64_t nextW=w+(int64_t)GetBlockNum();prefetched=nextW<(batch+1)*mt;
  if(prefetched){
   const int64_t nextBatch=batch,nextM0=m0+(int64_t)GetBlockNum()*256;
   const int nextNow=M-nextM0<256?M-nextM0:256,nextMP=(nextNow+15)&~15;
   Nd2NzParams nextCP{1,(uint16_t)(TX1?K:nextNow),(uint16_t)(TX1?nextNow:K),0,(uint16_t)(TX1?M:K),(uint16_t)(TX1?kp:nextMP),1,0};
   DataCopy(a1[(1-bank)*32768],ag[nextBatch*M*K+(TX1?nextM0:nextM0*K)],nextCP);
  }
  SetFlag<HardEvent::MTE1_M>(EVENT_ID0);WaitFlag<HardEvent::MTE1_M>(EVENT_ID0);
  MmadParams mm;mm.m=mp;mm.n=np;mm.k=kp;mm.cmatrixInitVal=true;mm.cmatrixSource=false;Mmad(c,a2,b2,mm);
  SetFlag<HardEvent::M_FIX>(EVENT_ID0);WaitFlag<HardEvent::M_FIX>(EVENT_ID0);
  FixpipeParamsV220 fp;fp.mSize=now;fp.nSize=np;fp.srcStride=mp;fp.dstStride=cs;fp.ndNum=1;fp.srcNdStride=0;fp.dstNdStride=0;fp.reluEn=false;
  Fixpipe<float,float,CFG_ROW_MAJOR>(cg[(batch*M+m0)*cs],c,fp);
  CrossCoreSetFlag<2,PIPE_FIX>(8);
  SetFlag<HardEvent::FIX_MTE2>(EVENT_ID0);WaitFlag<HardEvent::FIX_MTE2>(EVENT_ID0);
  bank=1-bank;
 }
}

