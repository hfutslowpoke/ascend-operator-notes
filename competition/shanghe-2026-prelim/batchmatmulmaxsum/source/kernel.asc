__aicore__ inline void ExplicitL1Pad_small(GM_ADDR a,GM_ADDR b,GM_ADDR ap,GM_ADDR bp,GM_ADDR c,GM_ADDR r,GM_ADDR y,int64_t B,int64_t M,int64_t N,int64_t K,int64_t mp,int64_t kp,int64_t cp){
 if ASCEND_IS_AIV {
  BmmsPadInputs(a,b,ap,bp,B,M,N,K,mp,kp);
