extern "C" __global__ __vector__ void NAME(GM_ADDR a,GM_ADDR b,GM_ADDR y,int64_t B,int64_t M,int64_t N,int64_t K){FlatSmall<T,TA,TB>(a,b,y,B,M,N,K);}
