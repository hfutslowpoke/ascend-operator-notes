  switch(route){PCASE(0,pipe_h00) PCASE(1,pipe_h01) PCASE(2,pipe_h10) PCASE(3,pipe_h11) PCASE(4,pipe_b00) PCASE(5,pipe_b01) PCASE(6,pipe_b10) PCASE(7,pipe_b11)}
