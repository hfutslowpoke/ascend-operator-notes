template<typename T>
__aicore__ inline void DirectDot(GM_ADDR ga,GM_ADDR gb,GM_ADDR gy,int64_t B,int64_t K){
 GlobalTensor<T> ag,bg;GlobalTensor<float> yg;ag.SetGlobalBuffer((__gm__ T*)ga);bg.SetGlobalBuffer((__gm__ T*)gb);yg.SetGlobalBuffer((__gm__ float*)gy);
 TPipe pipe;TBuf<TPosition::VECCALC> storage;pipe.InitBuffer(storage,8192);auto ah=storage.Get<T>();auto bh=ah[256];auto af=bh[256].template ReinterpretCast<float>();auto bf=af[256];auto prod=bf[256];auto result=prod[256];auto scratch=result[8];
 for(int64_t b=GetBlockIdx();b<B;b+=GetBlockNum()){
  DataCopyExtParams cp{1,(uint32_t)(K*2),0,0,0};DataCopyPadExtParams<T> pad{false,0,0,(T)0};DataCopyPad(ah,ag[b*K],cp,pad);DataCopyPad(bh,bg[b*K],cp,pad);
  SetFlag<HardEvent::MTE2_V>(EVENT_ID0);WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);Cast(af,ah,RoundMode::CAST_NONE,(int32_t)K);Cast(bf,bh,RoundMode::CAST_NONE,(int32_t)K);Mul(prod,af,bf,(int32_t)K);if(K<=64)WholeReduceSum(result,prod,(uint64_t)K,1,1,1,1);else ReduceSum(result,prod,scratch,(int32_t)K);
  SetFlag<HardEvent::V_MTE3>(EVENT_ID0);WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);DataCopyExtParams out{1,4,0,0,0};DataCopyPad(yg[b],result,out);SetFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);WaitFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);
 }
}
