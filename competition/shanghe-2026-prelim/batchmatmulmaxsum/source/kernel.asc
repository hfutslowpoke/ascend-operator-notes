template<class T,int AS,int BS>
__aicore__ inline void RawGroupedCube(GM_ADDR ga,GM_ADDR gb,GM_ADDR gc,int64_t B,int64_t M,int64_t N,int64_t K){
 GlobalTensor<T> ag,bg;GlobalTensor<float> cg;ag.SetGlobalBuffer((__gm__ T*)ga);bg.SetGlobalBuffer((__gm__ T*)gb);cg.SetGlobalBuffer((__gm__ float*)gc);
 TPipe pipe;TBuf<TPosition::A1> ab;TBuf<TPosition::B1> bb;TBuf<TPosition::A2> a0b;TBuf<TPosition::B2> b0b;TBuf<TPosition::CO1> cb;
 pipe.InitBuffer(ab,2*256*AS*2);pipe.InitBuffer(bb,2*128*BS*2);pipe.InitBuffer(a0b,65536);pipe.InitBuffer(b0b,32768);pipe.InitBuffer(cb,131072);
 auto a1=ab.template Get<T>();auto b1=bb.template Get<T>();auto a2=a0b.template Get<T>();auto b2=b0b.template Get<T>();auto c=cb.template Get<float>();
 const event_t ar0=static_cast<event_t>(pipe.AllocEventID<HardEvent::MTE2_MTE1>()),ar1=static_cast<event_t>(pipe.AllocEventID<HardEvent::MTE2_MTE1>()),br0=static_cast<event_t>(pipe.AllocEventID<HardEvent::MTE2_MTE1>()),br1=static_cast<event_t>(pipe.AllocEventID<HardEvent::MTE2_MTE1>());
 const event_t af0=static_cast<event_t>(pipe.AllocEventID<HardEvent::MTE1_MTE2>()),af1=static_cast<event_t>(pipe.AllocEventID<HardEvent::MTE1_MTE2>()),bf0=static_cast<event_t>(pipe.AllocEventID<HardEvent::MTE1_MTE2>()),bf1=static_cast<event_t>(pipe.AllocEventID<HardEvent::MTE1_MTE2>()),l1end=static_cast<event_t>(pipe.AllocEventID<HardEvent::MTE1_MTE2>());
 // C220 owns pre-signalled M_MTE1 0/1/2; allocate private IDs for reuse.
 const event_t lf0=static_cast<event_t>(pipe.AllocEventID<HardEvent::M_MTE1>()),lf1=static_cast<event_t>(pipe.AllocEventID<HardEvent::M_MTE1>()),lend=static_cast<event_t>(pipe.AllocEventID<HardEvent::M_MTE1>());
 const event_t loaded=static_cast<event_t>(pipe.AllocEventID<HardEvent::MTE1_M>()),computed=static_cast<event_t>(pipe.AllocEventID<HardEvent::M_FIX>()),cfree=static_cast<event_t>(pipe.AllocEventID<HardEvent::FIX_M>());
 const int64_t mt=(M+255)/256,nt=(N+127)/128,total=B*mt*nt,nc=GetBlockNum(),core=GetBlockIdx(),q=total/nc,first=core*q,limit=first+q;
 const int panels=static_cast<int>(K/64),na=static_cast<int>(K/384),nb=static_cast<int>(K/192);
 int64_t groups=0;int rowProduced=0;bool previousC=false;int aStart=0,aPhase=0;
 const int64_t batch=first/(mt*nt),m0=((first/nt)%mt)*256,startN=(first%nt)*128;
 const int mp=M-m0<256?M-m0:256,np=128;
 Nd2NzParams acp{1,384,(uint16_t)mp,0,(uint16_t)M,(uint16_t)AS,1,0};
 Nd2NzParams bcp{1,192,128,0,(uint16_t)N,(uint16_t)BS,1,0};
 // Uniform q divides nt. Every owned output is in this same batch/M row.
 for(int tile=0;tile<q;tile++){
  const int64_t w=first+tile,n0=startN+(int64_t)tile*128,nextN0=n0+128;
  const bool nextTile=tile+1<q;
  const int nextStart=aStart>=2?aStart-2:aStart+na-2,nextPhase=aPhase^(na&1);
  if(w==first){
   // First-needed groups before distant groups; later outputs are prefetched
   // as each bank finishes its last read in the preceding output's tail K.
   for(int i=0;i<2;i++){
    DataCopy(a1[i*256*AS],ag[batch*M*K+(int64_t)i*384*M+m0],acp);SetFlag<HardEvent::MTE2_MTE1>(i?ar1:ar0);
    DataCopy(b1[i*128*BS],bg[batch*K*N+(int64_t)i*192*N+n0],bcp);SetFlag<HardEvent::MTE2_MTE1>(i?br1:br0);
   }
  }
  for(int group=0;group<na;group++){
   #pragma unroll
   for(int ki=0;ki<6;ki++){
   const int p=group*6+ki;
   const int ai=ki,bi=ki%3,aa=(group+aPhase)&1,ba=(ki/3)&1,lo=ki&1;
   if(ai==0)WaitFlag<HardEvent::MTE2_MTE1>(aa?ar1:ar0);
   if(bi==0)WaitFlag<HardEvent::MTE2_MTE1>(ba?br1:br0);
   if(p>=2)WaitFlag<HardEvent::M_MTE1>(lo?lf1:lf0);
   auto ax=a2[lo*16384];auto bx=b2[lo*8192];
   LoadData3DParamsV2<T> ap;ap.l1H=1;ap.l1W=AS;ap.channelSize=mp;ap.kExtension=mp;ap.mExtension=64;ap.kStartPt=0;ap.mStartPt=ai*64;ap.enTranspose=true;
   LoadData(ax,a1[aa*256*AS],ap);
   LoadData2dTransposeParams bp{0,4,1,7,0,0};
   for(int n=0;n<8;n++)LoadDataWithTranspose(bx[n*256],b1[ba*128*BS+n*BS*16+bi*1024],bp);
   SetFlag<HardEvent::MTE1_M>(loaded);WaitFlag<HardEvent::MTE1_M>(loaded);
   if(p==0 && previousC)WaitFlag<HardEvent::FIX_M>(cfree);
   MmadParams mm;mm.m=mp;mm.n=np;mm.k=64;mm.cmatrixInitVal=p==0;mm.cmatrixSource=false;Mmad(c,ax,bx,mm);
   if(p+2<panels)SetFlag<HardEvent::M_MTE1>(lo?lf1:lf0);
   // M starts first. Prefetch setup executes while the current MAC runs.
   // B's next use is nearer than A's when both groups finish together.
   if(bi==2 && ((2*group+ki/3)+2<nb || nextTile)){
    const event_t free=ba?bf1:bf0;SetFlag<HardEvent::MTE1_MTE2>(free);WaitFlag<HardEvent::MTE1_MTE2>(free);
    if((2*group+ki/3)+2<nb){int actualB=2*aStart+(2*group+ki/3)+2;if(actualB>=nb)actualB-=nb;DataCopy(b1[ba*128*BS],bg[batch*K*N+(int64_t)actualB*192*N+n0],bcp);}
    else{int actualB=2*nextStart+ba;if(actualB>=nb)actualB-=nb;DataCopy(b1[ba*128*BS],bg[batch*K*N+(int64_t)actualB*192*N+nextN0],bcp);}
    SetFlag<HardEvent::MTE2_MTE1>(ba?br1:br0);
   }
   if(ai==5 && (group+2<na || nextTile)){
    const event_t free=aa?af1:af0;SetFlag<HardEvent::MTE1_MTE2>(free);WaitFlag<HardEvent::MTE1_MTE2>(free);
    if(group+2<na){int actualA=aStart+group+2;if(actualA>=na)actualA-=na;DataCopy(a1[aa*256*AS],ag[batch*M*K+(int64_t)actualA*384*M+m0],acp);}
    // At the two final A groups, retain their actual data. The next N output
    // starts from these two groups and cycles all logical K groups once.
    // Re-publish readiness after the retained read fence; no new A DMA here.
    SetFlag<HardEvent::MTE2_MTE1>(aa?ar1:ar0);
   }
  }
  } // close the complete six-panel group
  // Final L1 and L0 reads must also complete before the next output tile.
  SetFlag<HardEvent::MTE1_MTE2>(l1end);WaitFlag<HardEvent::MTE1_MTE2>(l1end);
  SetFlag<HardEvent::M_MTE1>(lend);WaitFlag<HardEvent::M_MTE1>(lend);
  SetFlag<HardEvent::M_FIX>(computed);WaitFlag<HardEvent::M_FIX>(computed);
  FixpipeParamsV220 fp;fp.mSize=mp;fp.nSize=np;fp.srcStride=mp;fp.dstStride=N;fp.ndNum=1;fp.srcNdStride=0;fp.dstNdStride=0;fp.reluEn=false;
  Fixpipe<float,float,CFG_ROW_MAJOR>(cg[(batch*M+m0)*N+n0],c,fp);SetFlag<HardEvent::FIX_M>(cfree);previousC=true;
  ++rowProduced;
  if(rowProduced==2 || w+1==limit){
   if(groups>0)CrossCoreWaitFlag<2,PIPE_S>(7);
   CrossCoreSetFlag<2,PIPE_FIX>(8);++groups;rowProduced=0;
  }
  aStart=nextStart;aPhase=nextPhase;
 }
 if(groups>0)CrossCoreWaitFlag<2,PIPE_S>(7);
 if(previousC)WaitFlag<HardEvent::FIX_M>(cfree);
 pipe.ReleaseEventID<HardEvent::MTE2_MTE1>(ar0);pipe.ReleaseEventID<HardEvent::MTE2_MTE1>(ar1);pipe.ReleaseEventID<HardEvent::MTE2_MTE1>(br0);pipe.ReleaseEventID<HardEvent::MTE2_MTE1>(br1);
 pipe.ReleaseEventID<HardEvent::MTE1_MTE2>(af0);pipe.ReleaseEventID<HardEvent::MTE1_MTE2>(af1);pipe.ReleaseEventID<HardEvent::MTE1_MTE2>(bf0);pipe.ReleaseEventID<HardEvent::MTE1_MTE2>(bf1);pipe.ReleaseEventID<HardEvent::MTE1_MTE2>(l1end);
 pipe.ReleaseEventID<HardEvent::M_MTE1>(lf0);pipe.ReleaseEventID<HardEvent::M_MTE1>(lf1);pipe.ReleaseEventID<HardEvent::M_MTE1>(lend);
 pipe.ReleaseEventID<HardEvent::MTE1_M>(loaded);pipe.ReleaseEventID<HardEvent::M_FIX>(computed);pipe.ReleaseEventID<HardEvent::FIX_M>(cfree);
}

extern "C" __global__ __aicore__ void zzrawgroup_h10(GM_ADDR a,GM_ADDR b,GM_ADDR c,GM_ADDR p,GM_ADDR r,GM_ADDR y,int64_t B,int64_t M,int64_t N,int64_t K,int64_t bm){KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);if ASCEND_IS_AIC {RawGroupedCube<half,384,192>(a,b,c,B,M,N,K);}if ASCEND_IS_AIV {PipelinedRunningMax(c,y,p,r,B,M,N,N,bm,true);}}

extern "C" __global__ __aicore__ void zzrawgroup_b10(GM_ADDR a,GM_ADDR b,GM_ADDR c,GM_ADDR p,GM_ADDR r,GM_ADDR y,int64_t B,int64_t M,int64_t N,int64_t K,int64_t bm){KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);if ASCEND_IS_AIC {RawGroupedCube<bfloat16_t,384,192>(a,b,c,B,M,N,K);}if ASCEND_IS_AIV {PipelinedRunningMax(c,y,p,r,B,M,N,N,bm,true);}}


// Isolated actual logical K; original device prefix and fallback retained.
constexpr auto CFG_PAD_ACTUAL_K234 = CFG_MDL;
template <typename IN_T, bool TX1, bool TX2>
__aicore__ inline void IsolatedPadActualKCube(
    GM_ADDR ga, GM_ADDR gb, GM_ADDR gc,
    int64_t B, int64_t M, int64_t N, int64_t K,
    int64_t baseM, int64_t baseN, int64_t aPitch, int64_t cPitch, int64_t realK)
{
    using AType = MatmulType<TPosition::GM, CubeFormat::ND, IN_T, false>;
    using BType = MatmulType<TPosition::GM, CubeFormat::ND, IN_T, false>;
    using CType = MatmulType<TPosition::GM, CubeFormat::ND, float, false>;
    using BiasType = MatmulType<TPosition::GM, CubeFormat::ND, float, false>;
    MatmulImpl<AType, BType, CType, BiasType, CFG_PAD_ACTUAL_K234> mm;
    const int32_t m = (int32_t)M, n = (int32_t)N, k = (int32_t)K;
    const int32_t computeK16 = ((int32_t)realK+15)&~15;
    const int32_t bm = 128, bn = 128, sn = (int32_t)N;
    TCubeTiling t;
    t.usedCoreNum = 1;
    t.M = m; t.N = n; t.Ka = k; t.Kb = k;
    t.singleCoreM = bm; t.singleCoreN = sn; t.singleCoreK = computeK16;
    t.baseM = bm; t.baseN = bn;
    { const bool tallKSmall = (M <= 64 && N <= 64 && K >= 2048 && (K % 256) == 0);
      t.baseK = tallKSmall ? 256 : 128; }
    t.depthA1 = 2; t.depthB1 = 2;
    t.stepM = 1; t.stepN = 1;
    t.isBias = 0; t.transLength = 0; t.iterateOrder = 0;
    t.shareMode = 0; t.shareL1Size = 0; t.shareL0CSize = 0; t.shareUbSize = 0;
    t.batchM = 0; t.batchN = 0; t.singleBatchM = 0; t.singleBatchN = 0;
    t.stepKa = 1; t.stepKb = 1;
    t.depthAL1CacheUB = 0; t.depthBL1CacheUB = 0;
    t.dbL0A = 1; t.dbL0B = 1; t.dbL0C = 1;
    if (TX1 && M >= 128 && N >= 128 && K >= 512 && M % 128 == 0 && K % 128 == 0) { t.baseK = 64; t.dbL0A = 2; t.dbL0B = 2; }
    t.baseK=128; t.stepKa=k/128; t.stepKb=1; t.depthA1=t.stepKa; t.depthB1=2;
    t.dbL0A=2; t.dbL0B=2; t.dbL0C=2;
    GlobalTensor<IN_T>  ag; ag.SetGlobalBuffer((__gm__ IN_T*)ga);
    GlobalTensor<IN_T>  bg; bg.SetGlobalBuffer((__gm__ IN_T*)gb);
    GlobalTensor<float> cg; cg.SetGlobalBuffer((__gm__ float*)gc);
    TPipe pipe;
    mm.SetSubBlockIdx(0);
    mm.Init(&t, &pipe);
    CrossCoreWaitFlag<2,PIPE_MTE2>(7);
    const int64_t mTiles = (M + bm - 1) / bm;
    const int64_t nTiles = (N + bn - 1) / bn;
    const int64_t items  = B * mTiles * nTiles;
    const int64_t core   = (int64_t)GetBlockIdx();
    const int64_t nCores = (int64_t)GetBlockNum();
    const bool mapExp = true;
    int64_t wFirst = core;
    int64_t wLimit = items;
    int64_t wStep  = nCores;
    bool rotateTail=false;
    if (mapExp) {
        const int64_t q  = items / nCores;
        const int64_t rr = items - q * nCores;
        // All higher-count cores fit in one small partial-M row.
        rotateTail=(M%128)>0 && (M%128)<=16 && rr>0 && rr*(q+1)<=nTiles;
        const int64_t lead = (core < rr) ? core : rr;
        wFirst = core * q + lead;
        wLimit = wFirst + q + ((core < rr) ? 1 : 0);
        wStep  = 1;
    }
    for (int64_t w = wFirst; w < wLimit;) {
        // Put the partial M row at the start of the unchanged equal-count map.
        const int64_t mappedW = rotateTail ? (w+(mTiles-1)*nTiles)%items : w;
        const int64_t nTile = mappedW % nTiles;
        const int64_t rem   = mappedW / nTiles;
        const int64_t mTile = rem % mTiles;
        const int64_t b     = rem / mTiles;
        const int64_t m0 = mTile * bm;
        const int64_t n0 = nTile * bn;
        int64_t run = nTiles-nTile;
        if (run>wLimit-w) run=wLimit-w;
        const int32_t groupN=(int32_t)(run*bn);
        const int32_t mNow = (int32_t)(((M - m0) < bm) ? (M - m0) : bm);
        const int32_t nNow = (int32_t)(((N - n0) < groupN) ? (N - n0) : groupN);
        GlobalTensor<IN_T> aB = ag[static_cast<uint64_t>(b) * (uint64_t)aPitch * (uint64_t)K];
        GlobalTensor<IN_T> bB = bg[static_cast<uint64_t>(b) * (uint64_t)K * (uint64_t)N];
        mm.SetOrgShape((int32_t)aPitch,n,k,k,(int32_t)cPitch);
        mm.SetSingleShape(bm, groupN, computeK16);
        mm.SetTail(mNow, nNow, computeK16);
        const uint64_t aOff = TX1 ? static_cast<uint64_t>(m0)
                                  : static_cast<uint64_t>(m0) * (uint64_t)K;
        const uint64_t bOff = TX2 ? static_cast<uint64_t>(n0) * (uint64_t)K
                                  : static_cast<uint64_t>(n0);
        mm.SetTensorA(aB[aOff], TX1);
        mm.SetTensorB(bB[bOff], TX2);
        GlobalTensor<float> cTile =
            cg[(static_cast<uint64_t>(b) * (uint64_t)M * (uint64_t)cPitch) +
               (static_cast<uint64_t>(m0) * (uint64_t)cPitch) + static_cast<uint64_t>(n0)];
        while (mm.Iterate()) {
            mm.GetTensorC(cTile, 0, false);
        }
        w += run;
    }
    mm.End();
}

template<typename T>
__aicore__ inline void IsolatedPadActualK(GM_ADDR ga,GM_ADDR gb,GM_ADDR ap,GM_ADDR bp,GM_ADDR c,GM_ADDR r,GM_ADDR y,int64_t B,int64_t M,int64_t N,int64_t K,int64_t mp,int64_t kp,int64_t cp){
 if ASCEND_IS_AIV {
  BmmsPadInputs(ga,gb,ap,bp,B,M,N,K,mp,kp);
  CrossCoreSetFlag<0,PIPE_MTE3>(6);CrossCoreWaitFlag<0,PIPE_MTE2>(6);CrossCoreSetFlag<2,PIPE_MTE3>(7);
 }
 if ASCEND_IS_AIC {
  IsolatedPadActualKCube<T,true,true>(ap,bp,c,B,M,N,kp,128,128,mp,cp,K);PipeBarrier<PIPE_ALL>();CrossCoreSetFlag<2,PIPE_FIX>(8);
 }
 if ASCEND_IS_AIV {
  CrossCoreWaitFlag<2,PIPE_MTE2>(8);CrossCoreSetFlag<0,PIPE_MTE3>(9);CrossCoreWaitFlag<0,PIPE_MTE2>(9);PadBatchedMaxRows255(c,y,r,B,M,N,(int64_t)GetBlockNum()*2,cp);
 }
}
extern "C" __global__ __aicore__ void zzpad_actual_h(GM_ADDR a,GM_ADDR b,GM_ADDR ap,GM_ADDR bp,GM_ADDR c,GM_ADDR r,GM_ADDR y,int64_t B,int64_t M,int64_t N,int64_t K,int64_t mp,int64_t kp,int64_t cp){KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);IsolatedPadActualK<half>(a,b,ap,bp,c,r,y,B,M,N,K,mp,kp,cp);}
extern "C" __global__ __aicore__ void zzpad_actual_b(GM_ADDR a,GM_ADDR b,GM_ADDR ap,GM_ADDR bp,GM_ADDR c,GM_ADDR r,GM_ADDR y,int64_t B,int64_t M,int64_t N,int64_t K,int64_t mp,int64_t kp,int64_t cp){KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);IsolatedPadActualK<bfloat16_t>(a,b,ap,bp,c,r,y,B,M,N,K,mp,kp,cp);}

// Larger UB banks only when peak per-core padding job count decreases.
__aicore__ inline void WideBankPadInputs(GM_ADDR ga,GM_ADDR gb,GM_ADDR gap,GM_ADDR gbp,int64_t B,int64_t M,int64_t N,int64_t K,int64_t mp,int64_t kp){
 GlobalTensor<uint16_t> ag,bg,apg,bpg;ag.SetGlobalBuffer((__gm__ uint16_t*)ga);bg.SetGlobalBuffer((__gm__ uint16_t*)gb);apg.SetGlobalBuffer((__gm__ uint16_t*)gap);bpg.SetGlobalBuffer((__gm__ uint16_t*)gbp);
 TPipe pipe;TBuf<TPosition::VECCALC> tb;pipe.InitBuffer(tb,196608);auto first=tb.Get<uint16_t>();auto second=first[49152];
 const int64_t core=GetBlockIdx(),nc=(int64_t)GetBlockNum()*2;int64_t jobs=0;
 for(int64_t batch=0;batch<B;batch++)for(int which=0;which<2;which++){
  const int64_t rows=which?N:K,cols=which?K:M,pr=which?N:kp,pc=which?kp:mp;
  auto src=which?bg[batch*N*K]:ag[batch*K*M];auto dst=which?bpg[batch*N*kp]:apg[batch*kp*mp];
  int64_t per=(pr+nc-1)/nc,end=(core+1)*per<pr?(core+1)*per:pr;
  int chunk=49152/pc;if(chunk>32)chunk=32;
  for(int64_t r0=core*per;r0<end;r0+=chunk,jobs++){
   const bool bank=jobs&1;auto tmp=bank?second:first;
   if(jobs>=2){
    if(bank){WaitFlag<HardEvent::MTE3_V>(EVENT_ID1);WaitFlag<HardEvent::MTE3_MTE2>(EVENT_ID1);}
    else{WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);WaitFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);}
   }
   int rn=end-r0<chunk?end-r0:chunk,valid=rows-r0<rn?rows-r0:rn;if(valid<0)valid=0;
   int aligned=((int)cols+15)&~15,gap=pc-aligned;
   if(gap>0 && valid>0){if(pc/16<=255)Duplicate(tmp[aligned],(uint16_t)0,(uint64_t)gap,(uint8_t)valid,1,(uint8_t)(pc/16));else for(int r=0;r<valid;r++)Duplicate(tmp[r*pc+aligned],(uint16_t)0,gap);}
   if(valid<rn)Duplicate(tmp[valid*pc],(uint16_t)0,(int32_t)((rn-valid)*pc));
   if(valid>0){
    DataCopyExtParams cp{(uint16_t)valid,(uint32_t)(cols*2),0,(uint32_t)((pc-aligned)/16),0};DataCopyPadExtParams<uint16_t> pad{true,0,(uint8_t)(aligned-cols),0};DataCopyPad(tmp,src[r0*cols],cp,pad);
    if(bank){SetFlag<HardEvent::MTE2_MTE3>(EVENT_ID1);WaitFlag<HardEvent::MTE2_MTE3>(EVENT_ID1);}else{SetFlag<HardEvent::MTE2_MTE3>(EVENT_ID0);WaitFlag<HardEvent::MTE2_MTE3>(EVENT_ID0);}
   }
   if(bank){SetFlag<HardEvent::V_MTE3>(EVENT_ID1);WaitFlag<HardEvent::V_MTE3>(EVENT_ID1);}else{SetFlag<HardEvent::V_MTE3>(EVENT_ID0);WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);}
   DataCopy(dst[r0*pc],tmp,(uint32_t)(rn*pc));
   if(bank){SetFlag<HardEvent::MTE3_V>(EVENT_ID1);SetFlag<HardEvent::MTE3_MTE2>(EVENT_ID1);}else{SetFlag<HardEvent::MTE3_V>(EVENT_ID0);SetFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);}
  }
 }
 if(jobs>0){WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);WaitFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);}
 if(jobs>1){WaitFlag<HardEvent::MTE3_V>(EVENT_ID1);WaitFlag<HardEvent::MTE3_MTE2>(EVENT_ID1);}
}

template<typename T>
__aicore__ inline void WideBankPadActualK(GM_ADDR ga,GM_ADDR gb,GM_ADDR ap,GM_ADDR bp,GM_ADDR c,GM_ADDR r,GM_ADDR y,int64_t B,int64_t M,int64_t N,int64_t K,int64_t mp,int64_t kp,int64_t cp){
 if ASCEND_IS_AIV {
  WideBankPadInputs(ga,gb,ap,bp,B,M,N,K,mp,kp);
  CrossCoreSetFlag<0,PIPE_MTE3>(6);CrossCoreWaitFlag<0,PIPE_MTE2>(6);CrossCoreSetFlag<2,PIPE_MTE3>(7);
 }
 if ASCEND_IS_AIC {
  IsolatedPadActualKCube<T,true,true>(ap,bp,c,B,M,N,kp,128,128,mp,cp,K);PipeBarrier<PIPE_ALL>();CrossCoreSetFlag<2,PIPE_FIX>(8);
 }
 if ASCEND_IS_AIV {
  CrossCoreWaitFlag<2,PIPE_MTE2>(8);CrossCoreSetFlag<0,PIPE_MTE3>(9);CrossCoreWaitFlag<0,PIPE_MTE2>(9);PadBatchedMaxRows255(c,y,r,B,M,N,(int64_t)GetBlockNum()*2,cp);
 }
}
extern "C" __global__ __aicore__ void zzpad_widebank_h(GM_ADDR a,GM_ADDR b,GM_ADDR ap,GM_ADDR bp,GM_ADDR c,GM_ADDR r,GM_ADDR y,int64_t B,int64_t M,int64_t N,int64_t K,int64_t mp,int64_t kp,int64_t cp){KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);WideBankPadActualK<half>(a,b,ap,bp,c,r,y,B,M,N,K,mp,kp,cp);}
extern "C" __global__ __aicore__ void zzpad_widebank_b(GM_ADDR a,GM_ADDR b,GM_ADDR ap,GM_ADDR bp,GM_ADDR c,GM_ADDR r,GM_ADDR y,int64_t B,int64_t M,int64_t N,int64_t K,int64_t mp,int64_t kp,int64_t cp){KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);WideBankPadActualK<bfloat16_t>(a,b,ap,bp,c,r,y,B,M,N,K,mp,kp,cp);}

// Local-only feasibility: public explicit L1 A, original readiness barrier.
template <typename IN_T, bool TX1, bool TX2>
__aicore__ inline void ExplicitL1PadCube(
    GM_ADDR ga, GM_ADDR gb, GM_ADDR gc,
    int64_t B, int64_t M, int64_t N, int64_t K,
    int64_t baseM, int64_t baseN, int64_t aPitch, int64_t cPitch, int64_t realK)
{
    using AType = MatmulType<TPosition::A1, CubeFormat::NZ, IN_T, false>;
    using BType = MatmulType<TPosition::GM, CubeFormat::ND, IN_T, false>;
    using CType = MatmulType<TPosition::GM, CubeFormat::ND, float, false>;
    using BiasType = MatmulType<TPosition::GM, CubeFormat::ND, float, false>;
    MatmulImpl<AType, BType, CType, BiasType, CFG_PAD_ACTUAL_K234> mm;
    const int32_t m = (int32_t)M, n = (int32_t)N, k = (int32_t)K;
    const int32_t computeK16 = ((int32_t)realK+15)&~15;
    const int32_t bm = 128, bn = 128, sn = (int32_t)N;
    TCubeTiling t;
    t.usedCoreNum = 1;
    t.M = m; t.N = n; t.Ka = k; t.Kb = k;
    t.singleCoreM = bm; t.singleCoreN = sn; t.singleCoreK = computeK16;
    t.baseM = bm; t.baseN = bn;
    { const bool tallKSmall = (M <= 64 && N <= 64 && K >= 2048 && (K % 256) == 0);
      t.baseK = tallKSmall ? 256 : 128; }
    t.depthA1 = 2; t.depthB1 = 2;
    t.stepM = 1; t.stepN = 1;
    t.isBias = 0; t.transLength = 0; t.iterateOrder = 0;
    t.shareMode = 0; t.shareL1Size = 0; t.shareL0CSize = 0; t.shareUbSize = 0;
    t.batchM = 0; t.batchN = 0; t.singleBatchM = 0; t.singleBatchN = 0;
    t.stepKa = 1; t.stepKb = 1;
    t.depthAL1CacheUB = 0; t.depthBL1CacheUB = 0;
    t.dbL0A = 1; t.dbL0B = 1; t.dbL0C = 1;
    if (TX1 && M >= 128 && N >= 128 && K >= 512 && M % 128 == 0 && K % 128 == 0) { t.baseK = 64; t.dbL0A = 2; t.dbL0B = 2; }
    t.baseK=128; t.stepKa=k/128; t.stepKb=1; t.depthA1=t.stepKa; t.depthB1=2;
    t.dbL0A=2; t.dbL0B=2; t.dbL0C=2;
    GlobalTensor<IN_T>  ag; ag.SetGlobalBuffer((__gm__ IN_T*)ga);
    GlobalTensor<IN_T>  bg; bg.SetGlobalBuffer((__gm__ IN_T*)gb);
    GlobalTensor<float> cg; cg.SetGlobalBuffer((__gm__ float*)gc);
    TPipe pipe;
    TBuf<TPosition::A1> explicitABuffer;
    pipe.InitBuffer(explicitABuffer,128*computeK16*2);
    auto explicitA=explicitABuffer.template Get<IN_T>();
    mm.SetSubBlockIdx(0);
    mm.Init(&t, &pipe);
    const event_t aReady=static_cast<event_t>(pipe.AllocEventID<HardEvent::MTE2_MTE1>());
    const event_t aFree=static_cast<event_t>(pipe.AllocEventID<HardEvent::MTE1_MTE2>());
    CrossCoreWaitFlag<2,PIPE_MTE2>(7);
    const int64_t mTiles = (M + bm - 1) / bm;
    const int64_t nTiles = (N + bn - 1) / bn;
    const int64_t items  = B * mTiles * nTiles;
    const int64_t core   = (int64_t)GetBlockIdx();
    const int64_t nCores = (int64_t)GetBlockNum();
    const bool mapExp = true;
    int64_t wFirst = core;
    int64_t wLimit = items;
    int64_t wStep  = nCores;
    bool rotateTail=false;
    if (mapExp) {
        const int64_t q  = items / nCores;
        const int64_t rr = items - q * nCores;
        // All higher-count cores fit in one small partial-M row.
        rotateTail=(M%128)>0 && (M%128)<=16 && rr>0 && rr*(q+1)<=nTiles;
        const int64_t lead = (core < rr) ? core : rr;
        wFirst = core * q + lead;
        wLimit = wFirst + q + ((core < rr) ? 1 : 0);
        wStep  = 1;
    }
    for (int64_t w = wFirst; w < wLimit;) {
        // Put the partial M row at the start of the unchanged equal-count map.
        const int64_t mappedW = rotateTail ? (w+(mTiles-1)*nTiles)%items : w;
        const int64_t nTile = mappedW % nTiles;
        const int64_t rem   = mappedW / nTiles;
        const int64_t mTile = rem % mTiles;
        const int64_t b     = rem / mTiles;
        const int64_t m0 = mTile * bm;
        const int64_t n0 = nTile * bn;
        int64_t run = nTiles-nTile;
        if (run>wLimit-w) run=wLimit-w;
        const int32_t groupN=(int32_t)(run*bn);
        const int32_t mNow = (int32_t)(((M - m0) < bm) ? (M - m0) : bm);
        const int32_t nNow = (int32_t)(((N - n0) < groupN) ? (N - n0) : groupN);
        GlobalTensor<IN_T> aB = ag[static_cast<uint64_t>(b) * (uint64_t)aPitch * (uint64_t)K];
        GlobalTensor<IN_T> bB = bg[static_cast<uint64_t>(b) * (uint64_t)K * (uint64_t)N];
        mm.SetOrgShape(128,n,computeK16,k,(int32_t)cPitch);
        mm.SetSingleShape(bm, groupN, computeK16);
        mm.SetTail(mNow, nNow, computeK16);
        const uint64_t aOff = TX1 ? static_cast<uint64_t>(m0)
                                  : static_cast<uint64_t>(m0) * (uint64_t)K;
        const uint64_t bOff = TX2 ? static_cast<uint64_t>(n0) * (uint64_t)K
                                  : static_cast<uint64_t>(n0);
        // Source is padded GM [Kp,Mp]; SDK dynamic MDL local A uses singleCoreK.
        // Pack a complete 128-column tile at ceil16(realK) stride, including current-call zeros.
        Nd2NzParams aCopy{1,(uint16_t)computeK16,128,0,(uint16_t)aPitch,(uint16_t)computeK16,1,0};
        DataCopy(explicitA,aB[aOff],aCopy);
        SetFlag<HardEvent::MTE2_MTE1>(aReady);WaitFlag<HardEvent::MTE2_MTE1>(aReady);
        mm.SetTensorA(explicitA, TX1);
        mm.SetTensorB(bB[bOff], TX2);
        GlobalTensor<float> cTile =
            cg[(static_cast<uint64_t>(b) * (uint64_t)M * (uint64_t)cPitch) +
               (static_cast<uint64_t>(m0) * (uint64_t)cPitch) + static_cast<uint64_t>(n0)];
        while (mm.Iterate()) {
            mm.GetTensorC(cTile, 0, false);
        }
        // Protect explicit L1 A until every issued MTE1 reader has finished.
        SetFlag<HardEvent::MTE1_MTE2>(aFree);WaitFlag<HardEvent::MTE1_MTE2>(aFree);
        w += run;
    }
    mm.End();
    pipe.ReleaseEventID<HardEvent::MTE2_MTE1>(aReady);
    pipe.ReleaseEventID<HardEvent::MTE1_MTE2>(aFree);
}
template<typename T>
__aicore__ inline void ExplicitL1Pad_wide(GM_ADDR a,GM_ADDR b,GM_ADDR ap,GM_ADDR bp,GM_ADDR c,GM_ADDR r,GM_ADDR y,int64_t B,int64_t M,int64_t N,int64_t K,int64_t mp,int64_t kp,int64_t cp){
 if ASCEND_IS_AIV {
  WideBankPadInputs(a,b,ap,bp,B,M,N,K,mp,kp);
  CrossCoreSetFlag<0,PIPE_MTE3>(6);CrossCoreWaitFlag<0,PIPE_MTE2>(6);CrossCoreSetFlag<2,PIPE_MTE3>(7);
 }
 if ASCEND_IS_AIC {
  ExplicitL1PadCube<T,true,true>(ap,bp,c,B,M,N,kp,128,128,mp,cp,K);
  PipeBarrier<PIPE_ALL>();CrossCoreSetFlag<2,PIPE_FIX>(8);
 }
 if ASCEND_IS_AIV {
  CrossCoreWaitFlag<2,PIPE_MTE2>(8);CrossCoreSetFlag<0,PIPE_MTE3>(9);CrossCoreWaitFlag<0,PIPE_MTE2>(9);
  PadBatchedMaxRows255(c,y,r,B,M,N,(int64_t)GetBlockNum()*2,cp);
 }
}
extern "C" __global__ __aicore__ void zzl1_wide_h(GM_ADDR a,GM_ADDR b,GM_ADDR ap,GM_ADDR bp,GM_ADDR c,GM_ADDR r,GM_ADDR y,int64_t B,int64_t M,int64_t N,int64_t K,int64_t mp,int64_t kp,int64_t cp){KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);ExplicitL1Pad_wide<half>(a,b,ap,bp,c,r,y,B,M,N,K,mp,kp,cp);}
extern "C" __global__ __aicore__ void zzl1_wide_b(GM_ADDR a,GM_ADDR b,GM_ADDR ap,GM_ADDR bp,GM_ADDR c,GM_ADDR r,GM_ADDR y,int64_t B,int64_t M,int64_t N,int64_t K,int64_t mp,int64_t kp,int64_t cp){KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);ExplicitL1Pad_wide<bfloat16_t>(a,b,ap,bp,c,r,y,B,M,N,K,mp,kp,cp);}
