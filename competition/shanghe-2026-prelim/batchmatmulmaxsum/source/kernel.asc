 if(slices>1 && M*N<=8192){
  #define KCASE(I,NAME) case I:NAME<<<(uint32_t)width,nullptr,stream>>>(x1,x2,c,y,B,M,N,K,bm,bn,slices);break;
  switch(route){KCASE(0,split_h00) KCASE(1,split_h01) KCASE(2,split_h10) KCASE(3,split_h11) KCASE(4,split_b00) KCASE(5,split_b01) KCASE(6,split_b10) KCASE(7,split_b11)}
  #undef KCASE
  aclrtSynchronizeStream(stream);aclrtFree(scratch);return;
 }
 #define CCASE(I,NAME) case I:NAME<<<(uint32_t)width,nullptr,stream>>>(x1,x2,c,r,y,B,M,N,K,bm,bn,slices,serialBatch);break;
 switch(route){CCASE(0,cube_h00) CCASE(1,cube_h01) CCASE(2,cube_h10) CCASE(3,cube_h11) CCASE(4,cube_b00) CCASE(5,cube_b01) CCASE(6,cube_b10) CCASE(7,cube_b11)}
 #undef CCASE
 // Scratch is freed only after its single launch has finished on this stream.
 aclrtSynchronizeStream(stream);aclrtFree(scratch);
}
