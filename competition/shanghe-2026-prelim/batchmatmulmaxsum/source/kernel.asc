  bool wide=N>M;int64_t rows=wide?N:M,columns=wide?M:N,mt=(rows+255)/256,items=B*mt,width=items<availableCoreNum?items:availableCoreNum,pitch=(columns+15)&~15;
  if(items>availableCoreNum && items<2*availableCoreNum && items%2==0)width=items/2;
  const bool columnReduction=!wide && (!transposeX1 || M<=65535);
  size_t cb=columnReduction?(size_t)B*mt*256*pitch*4:(size_t)B*rows*pitch*4,pb=wide?(size_t)B*width*2*pitch*4:((size_t)B*width*2*4+511)/512*512;void* memory=nullptr;if(aclrtMalloc(&memory,cb+pb,ACL_MEM_MALLOC_HUGE_FIRST)!=ACL_SUCCESS)return;
