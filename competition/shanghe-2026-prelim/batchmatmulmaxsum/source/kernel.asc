   if(columnReduction){
    #define ZCASE(I,NAME) case I:NAME<<<(uint32_t)width,nullptr,stream>>>(x1,x2,c,r,y,B,M,N,K);break;
    switch(route){ZCASE(0,zzpfcol_h00) ZCASE(1,zzpfcol_h01) ZCASE(2,zzpfcol_h10) ZCASE(3,zzpfcol_h11) ZCASE(4,zzpfcol_b00) ZCASE(5,zzpfcol_b01) ZCASE(6,zzpfcol_b10) ZCASE(7,zzpfcol_b11)}
