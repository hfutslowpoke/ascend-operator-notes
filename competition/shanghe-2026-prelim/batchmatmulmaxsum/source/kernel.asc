extern "C" __global__ __vector__ void aligned_once_b11(GM_ADDR a,GM_ADDR b,GM_ADDR y,int64_t B,int64_t M,int64_t N,int64_t K){AlignedSmallOnce<bfloat16_t,true,true>(a,b,y,B,M,N,K);}
template<class T,bool TX1,bool TX2>
__aicore__ inline void SmallStaticOnceCube(GM_ADDR ga,GM_ADDR gb,GM_ADDR gc,int64_t B,int64_t M,int64_t N,int64_t K) {
 GlobalTensor<T> ag,bg;GlobalTensor<float> cg;ag.SetGlobalBuffer((__gm__ T*)ga);bg.SetGlobalBuffer((__gm__ T*)gb);cg.SetGlobalBuffer((__gm__ float*)gc);
 TPipe pipe;
 // Start each independent DMA as soon as its own L1 storage exists.
 // Later L0A/L0B/L0C setup overlaps the first GM-to-L1 transfers.
 int mp=((int)M+15)&~15,np=((int)N+15)&~15,kp=(int)K;int cs=np;
 const int64_t firstBatch=GetBlockIdx();
 LocalTensor<T> a1(TPosition::A1,0,128*256);
 Nd2NzParams acp{1,(uint16_t)(TX1?K:M),(uint16_t)(TX1?M:K),0,(uint16_t)(TX1?M:K),(uint16_t)(TX1?kp:mp),1,0};
 DataCopy(a1,ag[firstBatch*M*K],acp);SetFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);
 LocalTensor<T> b1(TPosition::B1,128*256*2,32*256);
 Nd2NzParams bcp{1,(uint16_t)(TX2?N:K),(uint16_t)(TX2?K:N),0,(uint16_t)(TX2?K:N),(uint16_t)(TX2?np:kp),1,0};
 DataCopy(b1,bg[firstBatch*K*N],bcp);SetFlag<HardEvent::MTE2_MTE1>(EVENT_ID1);
 LocalTensor<T> a2(TPosition::A2,0,128*256);LocalTensor<T> b2(TPosition::B2,0,32*256);LocalTensor<float> c(TPosition::CO1,0,128*32);
 {const int64_t batch=firstBatch;
  WaitFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);
  if constexpr(TX1) {
   LoadData2dTransposeParams p{0,(uint8_t)(kp/16),1,0,(uint16_t)(kp/16-1),0};
   for(int mi=0;mi<mp/16;mi++)LoadDataWithTranspose(a2[mi*kp*16],a1[mi*kp*16],p);
  } else {
   LoadData2DParams p{0,(uint8_t)(kp/16),(uint16_t)(mp/16),0,0,false,0};
   for(int mi=0;mi<mp/16;mi++)LoadData(a2[mi*kp*16],a1[mi*256],p);
  }
  WaitFlag<HardEvent::MTE2_MTE1>(EVENT_ID1);
  if constexpr(TX2) {LoadData2DParams p{0,(uint8_t)(kp*np/256),1,0,0,false,0};LoadData(b2,b1,p);}
  else {
   if (np < kp && np >= 64) {
    LoadData2dTransposeParams p{0,(uint8_t)(kp/16),1,(uint16_t)(np/16-1),0,0};
    for(int ni=0;ni<np/16;ni++)LoadDataWithTranspose(b2[ni*256],b1[ni*kp*16],p);
   } else {
    LoadData2dTransposeParams p{0,(uint8_t)(np/16),(uint16_t)(kp/16),0,0,0};
    for(int ki=0;ki<kp/16;ki++)LoadDataWithTranspose(b2[ki*np*16],b1[ki*256],p);
   }
  }
  SetFlag<HardEvent::MTE1_M>(EVENT_ID0);WaitFlag<HardEvent::MTE1_M>(EVENT_ID0);
  MmadParams mm;mm.m=mp;mm.n=np;mm.k=kp;mm.cmatrixInitVal=true;mm.cmatrixSource=false;Mmad(c,a2,b2,mm);
  SetFlag<HardEvent::M_FIX>(EVENT_ID0);WaitFlag<HardEvent::M_FIX>(EVENT_ID0);
  FixpipeParamsV220 fp;fp.mSize=M;fp.nSize=np;fp.srcStride=mp;fp.dstStride=cs;fp.ndNum=1;fp.srcNdStride=0;fp.dstNdStride=0;fp.reluEn=false;
  Fixpipe<float,float,CFG_ROW_MAJOR>(cg[batch*M*cs],c,fp);
  CrossCoreSetFlag<2,PIPE_FIX>(8);
  SetFlag<HardEvent::FIX_MTE2>(EVENT_ID0);WaitFlag<HardEvent::FIX_MTE2>(EVENT_ID0);
 }
}


extern "C" __global__ __aicore__ void earlyonce_h00(GM_ADDR a,GM_ADDR b,GM_ADDR c,GM_ADDR y,int64_t B,int64_t M,int64_t N,int64_t K){KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_1);if ASCEND_IS_AIC {SmallStaticOnceCube<half,true,true>(b,a,c,B,N,M,K);}if ASCEND_IS_AIV {SmallTransposedVector(c,y,B,M,N);}}

extern "C" __global__ __aicore__ void earlyonce_b00(GM_ADDR a,GM_ADDR b,GM_ADDR c,GM_ADDR y,int64_t B,int64_t M,int64_t N,int64_t K){KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_1);if ASCEND_IS_AIC {SmallStaticOnceCube<bfloat16_t,true,true>(b,a,c,B,N,M,K);}if ASCEND_IS_AIV {SmallTransposedVector(c,y,B,M,N);}}

// Swap operands for C^T: short original N becomes the Cube M dimension.
// The short operand remains resident in L1/L0A; each long tile fills L0B.
template<class T,bool TX1,bool TX2>
__aicore__ inline void ResidentColumnCube(GM_ADDR ga,GM_ADDR gb,GM_ADDR gc,int64_t B,int64_t S,int64_t L,int64_t K){
 GlobalTensor<T> ag,bg;GlobalTensor<float> cg;ag.SetGlobalBuffer((__gm__ T*)ga);bg.SetGlobalBuffer((__gm__ T*)gb);cg.SetGlobalBuffer((__gm__ float*)gc);
 TPipe pipe;TBuf<TPosition::A1> a1b;TBuf<TPosition::A2> a2b;TBuf<TPosition::B1> b1b;TBuf<TPosition::B2> b2b;TBuf<TPosition::CO1> cb;
 pipe.InitBuffer(a1b,64*128*2);pipe.InitBuffer(a2b,64*128*2);pipe.InitBuffer(b1b,256*128*2);pipe.InitBuffer(b2b,256*128*2);pipe.InitBuffer(cb,64*256*4);
 auto a1=a1b.template Get<T>();auto a2=a2b.template Get<T>();auto b1=b1b.template Get<T>();auto b2=b2b.template Get<T>();auto c=cb.template Get<float>();
 const int mp=(S+15)&~15,kp=K;const int64_t mt=(L+255)/256;int64_t previous=-1;
 for(int64_t w=GetBlockIdx();w<B*mt;w+=GetBlockNum()){
  const int64_t batch=w/mt,n0=(w%mt)*256;const int now=L-n0<256?L-n0:256,np=(now+15)&~15;
  if(previous!=batch){
   Nd2NzParams acp{1,(uint16_t)(TX1?K:S),(uint16_t)(TX1?S:K),0,(uint16_t)(TX1?S:K),(uint16_t)(TX1?kp:mp),1,0};
   DataCopy(a1,ag[batch*S*K],acp);SetFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);WaitFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);
   if constexpr(TX1){LoadData2dTransposeParams p{0,(uint8_t)(kp/16),1,0,(uint16_t)(kp/16-1),0};for(int mi=0;mi<mp/16;mi++)LoadDataWithTranspose(a2[mi*kp*16],a1[mi*kp*16],p);}
   else{LoadData2DParams p{0,(uint8_t)(kp/16),(uint16_t)(mp/16),0,0,false,0};for(int mi=0;mi<mp/16;mi++)LoadData(a2[mi*kp*16],a1[mi*256],p);}
   previous=batch;
  }
  Nd2NzParams bcp{1,(uint16_t)(TX2?now:K),(uint16_t)(TX2?K:now),0,(uint16_t)(TX2?K:L),(uint16_t)(TX2?np:kp),1,0};
  DataCopy(b1,bg[batch*K*L+(TX2?n0*K:n0)],bcp);SetFlag<HardEvent::MTE2_MTE1>(EVENT_ID1);WaitFlag<HardEvent::MTE2_MTE1>(EVENT_ID1);
  if constexpr(TX2){LoadData2DParams p{0,(uint8_t)(kp*np/256),1,0,0,false,0};LoadData(b2,b1,p);}
  else{
   if(np<kp && np>=64){LoadData2dTransposeParams p{0,(uint8_t)(kp/16),1,(uint16_t)(np/16-1),0,0};for(int ni=0;ni<np/16;ni++)LoadDataWithTranspose(b2[ni*256],b1[ni*kp*16],p);}
   else{LoadData2dTransposeParams p{0,(uint8_t)(np/16),(uint16_t)(kp/16),0,0,0};for(int ki=0;ki<kp/16;ki++)LoadDataWithTranspose(b2[ki*np*16],b1[ki*256],p);}
  }
  SetFlag<HardEvent::MTE1_M>(EVENT_ID0);WaitFlag<HardEvent::MTE1_M>(EVENT_ID0);
  MmadParams mm;mm.m=mp;mm.n=np;mm.k=kp;mm.cmatrixInitVal=true;mm.cmatrixSource=false;Mmad(c,a2,b2,mm);
  if((mp/16)*(np/16)<10)PipeBarrier<PIPE_M>();
  SetFlag<HardEvent::M_FIX>(EVENT_ID0);WaitFlag<HardEvent::M_FIX>(EVENT_ID0);
  FixpipeParamsV220 fp;fp.mSize=S;fp.nSize=np;fp.srcStride=mp;fp.dstStride=256;fp.ndNum=1;fp.srcNdStride=0;fp.dstNdStride=0;fp.reluEn=false;
  Fixpipe<float,float,CFG_ROW_MAJOR>(cg[w*mp*256],c,fp);CrossCoreSetFlag<2,PIPE_FIX>(8);
  SetFlag<HardEvent::FIX_MTE2>(EVENT_ID0);WaitFlag<HardEvent::FIX_MTE2>(EVENT_ID0);
 }
}
__aicore__ inline void ResidentColumnVector(GM_ADDR gc,GM_ADDR gr,GM_ADDR gy,int64_t B,int64_t M,int64_t N){
 GlobalTensor<float> cg,rg,yg;cg.SetGlobalBuffer((__gm__ float*)gc);rg.SetGlobalBuffer((__gm__ float*)gr);yg.SetGlobalBuffer((__gm__ float*)gy);
 TPipe pipe;TBuf<TPosition::VECCALC> storage;pipe.InitBuffer(storage,81920);auto tile=storage.Get<float>();auto row=tile[16384];auto scratch=row[256];auto out=scratch[1024];auto acc=out[8];
 const int nc=GetBlockNum(),core=GetBlockIdx(),pitch=(N+15)&~15;const int64_t mt=(M+255)/256;int power=1;while(power*2<=N)power*=2;
 for(int64_t batch=0;batch<B;batch++){
  Duplicate(acc,0.0f,8);int64_t first=batch*mt;first+=(core-first%nc+nc)%nc;
  for(int64_t w=first;w<(batch+1)*mt;w+=nc){
   const int64_t m0=(w%mt)*256;const int now=M-m0<256?M-m0:256;CrossCoreWaitFlag<2,PIPE_MTE2>(8);
   if(now<256)Duplicate(tile,0.0f,N*256);
   SetFlag<HardEvent::V_MTE2>(EVENT_ID0);WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
   if(now==256)DataCopy(tile,cg[w*pitch*256],N*256);
   else{const int aligned=(now+7)&~7;DataCopyExtParams cp{(uint16_t)N,(uint32_t)(now*4),(uint32_t)((256-now)*4),(uint32_t)((256-aligned)/8),0};DataCopyPadExtParams<float> pad{true,0,(uint8_t)(aligned-now),0.0f};DataCopyPad(tile,cg[w*pitch*256],cp,pad);}
   SetFlag<HardEvent::MTE2_V>(EVENT_ID0);WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
   if(N>power)Max(tile,tile,tile[power*256],(N-power)*256);PipeBarrier<PIPE_V>();
   for(int r=power/2;r>0;r/=2){Max(tile,tile,tile[r*256],r*256);PipeBarrier<PIPE_V>();}
   ReduceSum(out,tile,scratch,now);Add(acc,acc,out,1);
  }
  SetFlag<HardEvent::V_MTE3>(EVENT_ID0);WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);DataCopyExtParams cp{1,4,0,0,0};DataCopyPad(rg[batch*nc+core],acc,cp);SetFlag<HardEvent::MTE3_V>(EVENT_ID0);WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
 }
 CrossCoreSetFlag<0,PIPE_MTE3>(10);CrossCoreWaitFlag<0,PIPE_MTE2>(10);
 for(int64_t batch=core;batch<B;batch+=nc){DataCopyExtParams cp{1,(uint32_t)(nc*4),0,0,0};DataCopyPadExtParams<float> pad{false,0,0,0};DataCopyPad(tile,rg[batch*nc],cp,pad);SetFlag<HardEvent::MTE2_V>(EVENT_ID0);WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);ReduceSum(out,tile,scratch,nc);SetFlag<HardEvent::V_MTE3>(EVENT_ID0);WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);DataCopyExtParams op{1,4,0,0,0};DataCopyPad(yg[batch],out,op);SetFlag<HardEvent::MTE3_V>(EVENT_ID0);WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);}
}

