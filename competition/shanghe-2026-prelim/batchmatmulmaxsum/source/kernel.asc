#define WIDE_ENTRY(NAME,T,TA,TB) \
extern "C" __global__ __aicore__ void NAME(GM_ADDR a,GM_ADDR b,GM_ADDR c,GM_ADDR r,GM_ADDR y,int64_t B,int64_t M,int64_t N,int64_t K,bool wide){KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_1);if ASCEND_IS_AIC {ResidentTallCube<T,!TB,!TA>(b,a,c,B,N,M,K);}if ASCEND_IS_AIV {ResidentWideVector(c,r,y,B,M,N,1);}}
