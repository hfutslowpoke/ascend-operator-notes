  switch(route){RSCASE(0,rawsplit_h00) RSCASE(1,rawsplit_h01) RSCASE(2,rawsplit_h10) RSCASE(3,rawsplit_h11) RSCASE(4,rawsplit_b00) RSCASE(5,rawsplit_b01) RSCASE(6,rawsplit_b10) RSCASE(7,rawsplit_b11)}
