   aclrtSynchronizeStream(stream);aclrtFree(memory);return;
  }
  #define XCASE(I,NAME) case I:NAME<<<(uint32_t)width,nullptr,stream>>>(x1,x2,(GM_ADDR)memory,y,B,M,N,K);break;
  switch(route){XCASE(0,transsmall_h00) XCASE(1,transsmall_h01) XCASE(2,transsmall_h10) XCASE(3,transsmall_h11) XCASE(4,transsmall_b00) XCASE(5,transsmall_b01) XCASE(6,transsmall_b10) XCASE(7,transsmall_b11)}
  #undef XCASE
  aclrtSynchronizeStream(stream);aclrtFree(memory);return;
 }
 if(M<=32 && N<=128 && K<=256 && K%16==0){
  int64_t width=B<availableCoreNum?B:availableCoreNum;void* memory=nullptr;size_t bytes=(size_t)B*M*((N+15)&~15)*4;
  if(aclrtMalloc(&memory,bytes,ACL_MEM_MALLOC_HUGE_FIRST)!=ACL_SUCCESS)return;
  #define NCASE(I,NAME) case I:NAME<<<(uint32_t)width,nullptr,stream>>>(x1,x2,(GM_ADDR)memory,y,B,M,N,K);break;
  switch(route){NCASE(0,native_h00) NCASE(1,native_h01) NCASE(2,native_h10) NCASE(3,native_h11) NCASE(4,native_b00) NCASE(5,native_b01) NCASE(6,native_b10) NCASE(7,native_b11)}
