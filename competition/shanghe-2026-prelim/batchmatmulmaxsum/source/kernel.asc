  switch(route){TCASE(0,tall_h00,wide_h00) TCASE(1,tall_h01,wide_h01) TCASE(2,tall_h10,wide_h10) TCASE(3,tall_h11,wide_h11) TCASE(4,tall_b00,wide_b00) TCASE(5,tall_b01,wide_b01) TCASE(6,tall_b10,wide_b10) TCASE(7,tall_b11,wide_b11)}
  #undef TCASE
  aclrtSynchronizeStream(stream);aclrtFree(memory);return;
 }

 // Alignment is paid once per call for transpose layouts with tail pitches.
 if(transposeX1 && transposeX2 && M>=128 && N>=128 && K>=128 && (M%128!=0 || K%128!=0) && 128*((K+127)/128*128)*2+128*128*4<=512*1024 && (size_t)B*M*((N+127)/128*128)*4<=((size_t)256<<20)){
  int64_t mp=(M+127)/128*128,kp=(K+127)/128*128,cp=(N+127)/128*128;
  const size_t abytes=(size_t)B*kp*mp*2,bbytes=(size_t)B*N*kp*2,cbytes=(size_t)B*M*cp*4,rbytes=((size_t)B*M*4+511)/512*512;
  void* memory=nullptr;if(aclrtMalloc(&memory,abytes+bbytes+cbytes+rbytes,ACL_MEM_MALLOC_HUGE_FIRST)!=ACL_SUCCESS)return;
  GM_ADDR ap=(GM_ADDR)memory;GM_ADDR bp=ap+abytes;GM_ADDR c=bp+bbytes;GM_ADDR r=c+cbytes;
  int64_t items=B*((M+127)/128)*((N+127)/128),width=items<availableCoreNum?items:availableCoreNum;
  if(K%128>0 && K%128<=64){
   const int64_t padCores=width*2,perA=(kp+padCores-1)/padCores,perB=(N+padCores-1)/padCores;
   const int64_t oa=32768/mp<32?32768/mp:32,ob=32768/kp<32?32768/kp:32,na=49152/mp<32?49152/mp:32,nb=49152/kp<32?49152/kp:32;
   if((perA+oa-1)/oa+(perB+ob-1)/ob > (perA+na-1)/na+(perB+nb-1)/nb){
    if(a.dtype==1)zzbounded_wide_h<<<(uint32_t)width,nullptr,stream>>>(x1,x2,ap,bp,c,r,y,B,M,N,K,mp,kp,cp);
    else zzbounded_wide_b<<<(uint32_t)width,nullptr,stream>>>(x1,x2,ap,bp,c,r,y,B,M,N,K,mp,kp,cp);
    aclrtSynchronizeStream(stream);aclrtFree(memory);return;
   }
   if(a.dtype==1)zzbounded_small_h<<<(uint32_t)width,nullptr,stream>>>(x1,x2,ap,bp,c,r,y,B,M,N,K,mp,kp,cp);
   else zzbounded_small_b<<<(uint32_t)width,nullptr,stream>>>(x1,x2,ap,bp,c,r,y,B,M,N,K,mp,kp,cp);
   aclrtSynchronizeStream(stream);aclrtFree(memory);return;
  }
  if(a.dtype==1)pad_h<<<(uint32_t)width,nullptr,stream>>>(x1,x2,ap,bp,c,r,y,B,M,N,K,mp,kp,cp);else pad_b<<<(uint32_t)width,nullptr,stream>>>(x1,x2,ap,bp,c,r,y,B,M,N,K,mp,kp,cp);
  aclrtSynchronizeStream(stream);aclrtFree(memory);return;
 }
 if(M>=128 && N>=128 && M%128==0 && N%128==0 && K>=512 && K%128==0 && (transposeX1 || 128*K*2+128*128*4<=512*1024) && (size_t)B*M*N*4<=((size_t)256<<20)) {
  const int64_t tileM=transposeX1?256:128,items=B*((M+tileM-1)/tileM)*((N+127)/128),width=items<availableCoreNum?items:availableCoreNum;
  size_t cbytes=(size_t)B*M*N*4,pbytes=(size_t)items*tileM*4,rbytes=((size_t)B*M*4+511)/512*512;void* memory=nullptr;if(aclrtMalloc(&memory,cbytes+pbytes+rbytes,ACL_MEM_MALLOC_HUGE_FIRST)!=ACL_SUCCESS)return;
  GM_ADDR c=(GM_ADDR)memory;GM_ADDR p=c+cbytes;GM_ADDR r=p+pbytes;

  // Existing aligned pipeline parent; select a full metadata/capacity class.
