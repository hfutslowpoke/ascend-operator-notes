 }
 if ASCEND_IS_AIC {
  ExplicitL1PadCube<T,true,true>(ap,bp,c,B,M,N,kp,128,128,mp,cp,K);
  PipeBarrier<PIPE_ALL>();CrossCoreSetFlag<2,PIPE_FIX>(8);
 }
 if ASCEND_IS_AIV {
