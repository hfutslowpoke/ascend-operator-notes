__aicore__ inline void NativeSmallReduce(GM_ADDR gc,GM_ADDR gy,int64_t B,int64_t M,int64_t N){
 GlobalTensor<float> cg,yg;cg.SetGlobalBuffer((__gm__ float*)gc);yg.SetGlobalBuffer((__gm__ float*)gy);
 TPipe pipe;TBuf<TPosition::VECCALC> storage;pipe.InitBuffer(storage,20480);auto tile=storage.Get<float>();auto row=tile[4096];auto row2=row[32];auto scratch=row2[32];auto result=scratch[128];
 const int pitch=((int)N+15)&~15,cs=((int)N+15)&~15,al=((int)N+7)&~7;
 for(int64_t b=GetBlockIdx();b<B;b+=GetBlockNum()){
  CrossCoreWaitFlag<2,PIPE_MTE2>(8);
  SetFlag<HardEvent::V_MTE2>(EVENT_ID0);WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
  if(pitch==N && cs==N)DataCopy(tile,cg[b*M*cs],M*N);
  else{  DataCopyExtParams cp{(uint16_t)M,(uint32_t)(N*4),(uint32_t)((cs-N)*4),(uint32_t)((pitch-al)/8),0};DataCopyPadExtParams<float> pad{true,0,(uint8_t)(al-N),-3.402823466e+38F};DataCopyPad(tile,cg[b*M*cs],cp,pad);
  }
  SetFlag<HardEvent::MTE2_V>(EVENT_ID0);WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
  int capacity=2048/pitch;for(int j=0;j<M;j+=capacity){int rows=M-j<capacity?M-j:capacity;WholeReduceMax(row[j],tile[j*pitch],(uint64_t)(N<64?N:64),(uint8_t)rows,1,1,pitch/8,ReduceOrder::ORDER_ONLY_VALUE);if(N>64)WholeReduceMax(row2[j],tile[j*pitch+64],(uint64_t)(N-64),(uint8_t)rows,1,1,pitch/8,ReduceOrder::ORDER_ONLY_VALUE);}
  if(N>64)Max(row,row,row2,(int32_t)M);ReduceSum(result,row,scratch,(int32_t)M);SetFlag<HardEvent::V_MTE3>(EVENT_ID0);WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);DataCopyExtParams out{1,4,0,0,0};DataCopyPad(yg[b],result,out);SetFlag<HardEvent::MTE3_V>(EVENT_ID0);WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
 }
}
