TRANS_SMALL_ENTRY(transsmall_b01,bfloat16_t,false,true)
TRANS_SMALL_ENTRY(transsmall_b10,bfloat16_t,true,false)
TRANS_SMALL_ENTRY(transsmall_b11,bfloat16_t,true,true)

template<typename T>
__aicore__ inline void ShortDot(GM_ADDR ga,GM_ADDR gb,GM_ADDR gy,int64_t B,int64_t K){
 GlobalTensor<T> ag,bg;GlobalTensor<float> yg;ag.SetGlobalBuffer((__gm__ T*)ga);bg.SetGlobalBuffer((__gm__ T*)gb);yg.SetGlobalBuffer((__gm__ float*)gy);TPipe pipe;TBuf<TPosition::VECCALC> storage;pipe.InitBuffer(storage,2048);auto raw=storage.Get<T>();auto cast=raw[128].template ReinterpretCast<float>();auto product=cast[128];auto out=product[64];
 const int ap=(K+15)&~15;
 for(int64_t batch=GetBlockIdx();batch<B;batch+=GetBlockNum()){
  DataCopyExtParams cp{1,(uint32_t)(K*2),0,0,0};DataCopyPadExtParams<T> pad{true,0,(uint8_t)(ap-K),(T)0};DataCopyPad(raw,ag[batch*K],cp,pad);DataCopyPad(raw[ap],bg[batch*K],cp,pad);SetFlag<HardEvent::MTE2_V>(EVENT_ID0);WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);Cast(cast,raw,RoundMode::CAST_NONE,2*ap);Mul(product,cast,cast[ap],(int32_t)K);WholeReduceSum(out,product,(uint64_t)K,1,1,1,1);SetFlag<HardEvent::V_MTE3>(EVENT_ID0);WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);DataCopyExtParams op{1,4,0,0,0};DataCopyPad(yg[batch],out,op);SetFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);WaitFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);
 }
}
extern "C" __global__ __vector__ void short_h(GM_ADDR a,GM_ADDR b,GM_ADDR y,int64_t B,int64_t K){ShortDot<half>(a,b,y,B,K);}
extern "C" __global__ __vector__ void short_b(GM_ADDR a,GM_ADDR b,GM_ADDR y,int64_t B,int64_t K){ShortDot<bfloat16_t>(a,b,y,B,K);}

template<typename T,bool TA,bool TB>
__aicore__ inline void FlatSmallOnce(GM_ADDR ga,GM_ADDR gb,GM_ADDR gy,int64_t B,int64_t M,int64_t N,int64_t K){
 const int64_t owner=GetBlockIdx();if(owner>=B)return;
 GlobalTensor<T> ag,bg;GlobalTensor<float> yg;ag.SetGlobalBuffer((__gm__ T*)ga);bg.SetGlobalBuffer((__gm__ T*)gb);yg.SetGlobalBuffer((__gm__ float*)gy);
 TPipe pipe;TBuf<TPosition::VECCALC> storage;pipe.InitBuffer(storage,24576);auto raw=storage.Get<T>();auto cast=raw[768].template ReinterpretCast<float>();auto av=cast[768];auto bv=av[256];auto product=bv[512];auto dot=product[2048];auto row=dot[64];auto result=row[8];auto idx=result[8].template ReinterpretCast<int32_t>();auto base=idx[64];
 const int ap=((int)(M*K)+15)&~15,bp=((int)(N*K)+15)&~15,np=8;
 {const int64_t batch=owner;
  DataCopyExtParams ac{1,(uint32_t)(M*K*2),0,0,0},bc{1,(uint32_t)(N*K*2),0,0,0};DataCopyPadExtParams<T> pa{true,0,(uint8_t)(ap-M*K),(T)0},pb{true,0,(uint8_t)(bp-N*K),(T)0};DataCopyPad(raw,ag[batch*M*K],ac,pa);DataCopyPad(raw[ap],bg[batch*N*K],bc,pb);
  SetFlag<HardEvent::MTE2_V>(EVENT_ID0);WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);Cast(cast,raw,RoundMode::CAST_NONE,ap+bp);

  constexpr int kp=64;auto af=av;auto bf=bv;CreateVecIndex(base,(int32_t)0,(uint32_t)K);
  if constexpr(TA){Muls(idx,base,(int32_t)(M*4),(int32_t)K);
#pragma unroll
   for(int m=0;m<4;m++)if(m<M)Gather(av[m*kp],cast,idx.template ReinterpretCast<uint32_t>(),m*4,(int32_t)K);
  }else{
#pragma unroll
   for(int m=0;m<4;m++)if(m<M)Adds(av[m*kp],cast[m*K],0.0f,(int32_t)K);
  }
  if(N!=np)Duplicate(bv,0.0f,np*kp);
  if constexpr(TB){
#pragma unroll
   for(int n=0;n<8;n++)if(n<N)Adds(bv[n*kp],cast[ap+n*K],0.0f,(int32_t)K);
  }else{Muls(idx,base,(int32_t)(N*4),(int32_t)K);
#pragma unroll
   for(int n=0;n<8;n++)if(n<N)Gather(bv[n*kp],cast[ap],idx.template ReinterpretCast<uint32_t>(),n*4,(int32_t)K);
  }
  BinaryRepeatParams rp(1,1,1,kp/8,kp/8,0);

#pragma unroll
  for(int m=0;m<4;m++)if(m<M)Mul(product[m*np*kp],bf,af[m*kp],(uint64_t)K,(uint8_t)np,rp);
  WholeReduceSum(dot,product,(uint64_t)K,(uint8_t)(M*np),1,1,kp/8);WholeReduceMax(row,dot,(uint64_t)N,(uint8_t)M,1,1,np/8,ReduceOrder::ORDER_ONLY_VALUE);WholeReduceSum(result,row,(uint64_t)M,1,1,1,1);
  SetFlag<HardEvent::V_MTE3>(EVENT_ID0);WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);DataCopyExtParams out{1,4,0,0,0};DataCopyPad(yg[batch],result,out);
 }
}
template<typename T,bool TA,bool TB>
__aicore__ inline void AlignedSmallOnce(GM_ADDR ga,GM_ADDR gb,GM_ADDR gy,int64_t B,int64_t M,int64_t N,int64_t K){
 const int64_t owner=GetBlockIdx();if(owner>=B)return;
 GlobalTensor<T> ag,bg;GlobalTensor<float> yg;ag.SetGlobalBuffer((__gm__ T*)ga);bg.SetGlobalBuffer((__gm__ T*)gb);yg.SetGlobalBuffer((__gm__ float*)gy);
 TPipe pipe;TBuf<TPosition::VECCALC> storage;pipe.InitBuffer(storage,196608);auto raw=storage.Get<T>();auto cast=raw[4096].template ReinterpretCast<float>();auto av=cast[4096];auto bv=av[2048];auto product=bv[2048];auto dot=product[32768];auto dot1=dot[256];auto maxima=dot1[256];auto result=maxima[32];auto idx=result[8].template ReinterpretCast<int32_t>();
 const int ap=((int)(M*K)+15)&~15,bp=((int)(N*K)+15)&~15,np=((int)N+7)&~7;
 {const int64_t batch=owner;
  DataCopyExtParams ac{1,(uint32_t)(M*K*2),0,0,0},bc{1,(uint32_t)(N*K*2),0,0,0};DataCopyPadExtParams<T> pa{true,0,(uint8_t)(ap-M*K),(T)0},pb{true,0,(uint8_t)(bp-N*K),(T)0};DataCopyPad(raw,ag[batch*M*K],ac,pa);DataCopyPad(raw[ap],bg[batch*N*K],bc,pb);SetFlag<HardEvent::MTE2_V>(EVENT_ID0);WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);Cast(cast,raw,RoundMode::CAST_NONE,ap+bp);
  auto af=cast;auto bf=cast[ap];
  if constexpr(TA){CreateVecIndex(idx,(int32_t)0,(uint32_t)K);Muls(idx,idx,(int32_t)(M*4),(int32_t)K);for(int m=0;m<M;m++)Gather(av[m*K],cast,idx.template ReinterpretCast<uint32_t>(),m*4,(int32_t)K);af=av;}
  if(N!=np)Duplicate(bv,0.0f,np*K);
  if constexpr(TB){if(N!=np){Adds(bv,cast[ap],0.0f,(int32_t)(N*K));bf=bv;}}
  if constexpr(!TB){CreateVecIndex(idx,(int32_t)0,(uint32_t)K);Muls(idx,idx,(int32_t)(N*4),(int32_t)K);for(int n=0;n<N;n++)Gather(bv[n*K],cast[ap],idx.template ReinterpretCast<uint32_t>(),n*4,(int32_t)K);bf=bv;}
  BinaryRepeatParams rp(1,1,1,K/8,K/8,0);
  for(int m=0;m<M;m++){Mul(product[m*np*K],bf,af[m*K],(uint64_t)(K<64?K:64),(uint8_t)np,rp);if(K>64)MulAddDst(product[m*np*K],bf[64],af[m*K+64],(uint64_t)(K-64),(uint8_t)np,rp);}
  for(int off=0;off<M*np;off+=128){int nr=M*np-off<128?M*np-off:128;WholeReduceSum(dot[off],product[off*K],(uint64_t)(K<64?K:64),(uint8_t)nr,1,1,K/8);}
  WholeReduceMax(maxima,dot,(uint64_t)N,(uint8_t)M,1,1,np/8,ReduceOrder::ORDER_ONLY_VALUE);WholeReduceSum(result,maxima,(uint64_t)M,1,1,1,1);
  SetFlag<HardEvent::V_MTE3>(EVENT_ID0);WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);DataCopyExtParams cp{1,4,0,0,0};DataCopyPad(yg[batch],result,cp);
 }
}

