template<typename T,bool TA,bool TB>
__aicore__ inline void FlatSmall(GM_ADDR ga,GM_ADDR gb,GM_ADDR gy,int64_t B,int64_t M,int64_t N,int64_t K){
 GlobalTensor<T> ag,bg;GlobalTensor<float> yg;ag.SetGlobalBuffer((__gm__ T*)ga);bg.SetGlobalBuffer((__gm__ T*)gb);yg.SetGlobalBuffer((__gm__ float*)gy);
 TPipe pipe;TBuf<TPosition::VECCALC> storage;pipe.InitBuffer(storage,24576);auto raw=storage.Get<T>();auto cast=raw[768].template ReinterpretCast<float>();auto av=cast[768];auto bv=av[256];auto product=bv[512];auto dot=product[2048];auto row=dot[64];auto result=row[8];auto idx=result[8].template ReinterpretCast<int32_t>();auto base=idx[64];
 const int ap=((int)(M*K)+15)&~15,bp=((int)(N*K)+15)&~15,np=8;
 for(int64_t batch=GetBlockIdx();batch<B;batch+=GetBlockNum()){
  DataCopyExtParams ac{1,(uint32_t)(M*K*2),0,0,0},bc{1,(uint32_t)(N*K*2),0,0,0};DataCopyPadExtParams<T> pa{true,0,(uint8_t)(ap-M*K),(T)0},pb{true,0,(uint8_t)(bp-N*K),(T)0};DataCopyPad(raw,ag[batch*M*K],ac,pa);DataCopyPad(raw[ap],bg[batch*N*K],bc,pb);
  SetFlag<HardEvent::MTE2_V>(EVENT_ID0);WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);Cast(cast,raw,RoundMode::CAST_NONE,ap+bp);

  constexpr int kp=64;auto af=av;auto bf=bv;CreateVecIndex(base,(int32_t)0,(uint32_t)K);
  if constexpr(TA){Muls(idx,base,(int32_t)(M*4),(int32_t)K);
#pragma unroll
   for(int m=0;m<4;m++)if(m<M)Gather(av[m*kp],cast,idx.template ReinterpretCast<uint32_t>(),m*4,(int32_t)K);
  }else{
#pragma unroll
   for(int m=0;m<4;m++)if(m<M)Adds(av[m*kp],cast[m*K],0.0f,(int32_t)K);
  }
  if(N!=np)Duplicate(bv,0.0f,np*kp);
  if constexpr(TB){
#pragma unroll
   for(int n=0;n<8;n++)if(n<N)Adds(bv[n*kp],cast[ap+n*K],0.0f,(int32_t)K);
  }else{Muls(idx,base,(int32_t)(N*4),(int32_t)K);
#pragma unroll
   for(int n=0;n<8;n++)if(n<N)Gather(bv[n*kp],cast[ap],idx.template ReinterpretCast<uint32_t>(),n*4,(int32_t)K);
  }
  BinaryRepeatParams rp(1,1,1,kp/8,kp/8,0);

#pragma unroll
  for(int m=0;m<4;m++)if(m<M)Mul(product[m*np*kp],bf,af[m*kp],(uint64_t)K,(uint8_t)np,rp);
  WholeReduceSum(dot,product,(uint64_t)K,(uint8_t)(M*np),1,1,kp/8);WholeReduceMax(row,dot,(uint64_t)N,(uint8_t)M,1,1,np/8,ReduceOrder::ORDER_ONLY_VALUE);WholeReduceSum(result,row,(uint64_t)M,1,1,1,1);
  SetFlag<HardEvent::V_MTE3>(EVENT_ID0);WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);DataCopyExtParams out{1,4,0,0,0};DataCopyPad(yg[batch],result,out);SetFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);WaitFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);
 }
}
