   switch(route){CCASE(0,tallcolumn_h00) CCASE(1,tallcolumn_h01) CCASE(2,tallcolumn_h10) CCASE(3,tallcolumn_h11) CCASE(4,tallcolumn_b00) CCASE(5,tallcolumn_b01) CCASE(6,tallcolumn_b10) CCASE(7,tallcolumn_b11)}
