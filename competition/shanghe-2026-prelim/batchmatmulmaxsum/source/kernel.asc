template<class T,bool TX1,bool TX2>
__aicore__ inline void ResidentTallCube(GM_ADDR ga,GM_ADDR gb,GM_ADDR gc,int64_t B,int64_t M,int64_t N,int64_t K) {
 GlobalTensor<T> ag,bg;GlobalTensor<float> cg;ag.SetGlobalBuffer((__gm__ T*)ga);bg.SetGlobalBuffer((__gm__ T*)gb);cg.SetGlobalBuffer((__gm__ float*)gc);
 TPipe pipe;TBuf<TPosition::A1> a1b;TBuf<TPosition::A2> a2b;TBuf<TPosition::B1> b1b;TBuf<TPosition::B2> b2b;TBuf<TPosition::CO1> cb;
 pipe.InitBuffer(a1b,256*128*2);pipe.InitBuffer(a2b,256*128*2);pipe.InitBuffer(b1b,64*128*2);pipe.InitBuffer(b2b,64*128*2);pipe.InitBuffer(cb,256*64*4);
 auto a1=a1b.template Get<T>();auto a2=a2b.template Get<T>();auto b1=b1b.template Get<T>();auto b2=b2b.template Get<T>();auto c=cb.template Get<float>();
 int np=((int)N+15)&~15,kp=(int)K,cs=np;const int64_t mt=(M+255)/256;int64_t previous=-1;
 for(int64_t w=GetBlockIdx();w<B*mt;w+=GetBlockNum()){int64_t batch=w/mt,m0=(w%mt)*256;int now=M-m0<256?M-m0:256,mp=(now+15)&~15;
  Nd2NzParams acp{1,(uint16_t)(TX1?K:now),(uint16_t)(TX1?now:K),0,(uint16_t)(TX1?M:K),(uint16_t)(TX1?kp:mp),1,0};
  Nd2NzParams bcp{1,(uint16_t)(TX2?N:K),(uint16_t)(TX2?K:N),0,(uint16_t)(TX2?K:N),(uint16_t)(TX2?np:kp),1,0};
  DataCopy(a1,ag[batch*M*K+(TX1?m0:m0*K)],acp);if(previous!=batch)DataCopy(b1,bg[batch*K*N],bcp);
  SetFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);WaitFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);
  if constexpr(TX1) {
   LoadData2dTransposeParams p{0,(uint8_t)(kp/16),1,0,(uint16_t)(kp/16-1),0};
   for(int mi=0;mi<mp/16;mi++)LoadDataWithTranspose(a2[mi*kp*16],a1[mi*kp*16],p);
  } else {
   uint8_t padding[4]={0,0,0,0};SetFmatrix(1,mp,padding,FmatrixMode::FMATRIX_LEFT);LoadData3DParamsV2Pro p;p.channelSize=kp;p.extConfig=((uint64_t)mp<<16)|kp;LoadData(a2,a1,p);
  }
  if(previous!=batch){
  if constexpr(TX2) {LoadData2DParams p{0,(uint8_t)(kp*np/256),1,0,0,false,0};LoadData(b2,b1,p);}
  else {
   if (np < kp && np >= 64) {
    LoadData2dTransposeParams p{0,(uint8_t)(kp/16),1,(uint16_t)(np/16-1),0,0};
    for(int ni=0;ni<np/16;ni++)LoadDataWithTranspose(b2[ni*256],b1[ni*kp*16],p);
   } else {
    LoadData2dTransposeParams p{0,(uint8_t)(np/16),(uint16_t)(kp/16),0,0,0};
    for(int ki=0;ki<kp/16;ki++)LoadDataWithTranspose(b2[ki*np*16],b1[ki*256],p);
   }
  }
  previous=batch;}
  SetFlag<HardEvent::MTE1_M>(EVENT_ID0);WaitFlag<HardEvent::MTE1_M>(EVENT_ID0);
  MmadParams mm;mm.m=mp;mm.n=np;mm.k=kp;mm.cmatrixInitVal=true;mm.cmatrixSource=false;Mmad(c,a2,b2,mm);
  SetFlag<HardEvent::M_FIX>(EVENT_ID0);WaitFlag<HardEvent::M_FIX>(EVENT_ID0);
  FixpipeParamsV220 fp;fp.mSize=now;fp.nSize=np;fp.srcStride=mp;fp.dstStride=cs;fp.ndNum=1;fp.srcNdStride=0;fp.dstNdStride=0;fp.reluEn=false;
  Fixpipe<float,float,CFG_ROW_MAJOR>(cg[(batch*M+m0)*cs],c,fp);
  CrossCoreSetFlag<2,PIPE_FIX>(8);
  SetFlag<HardEvent::FIX_MTE2>(EVENT_ID0);WaitFlag<HardEvent::FIX_MTE2>(EVENT_ID0);
 }
}
__aicore__ inline void ResidentTallVector(GM_ADDR gc,GM_ADDR gr,GM_ADDR gy,int64_t B,int64_t M,int64_t N,int ratio){
 GlobalTensor<float> cg,rg,yg;cg.SetGlobalBuffer((__gm__ float*)gc);rg.SetGlobalBuffer((__gm__ float*)gr);yg.SetGlobalBuffer((__gm__ float*)gy);
 TPipe pipe;TBuf<TPosition::VECCALC> storage;pipe.InitBuffer(storage,81920);auto tile=storage.Get<float>();auto row=tile[16384];auto scratch=row[256];auto out=scratch[1024];auto acc=out[8];
 const int pitch=(N+15)&~15,core=GetBlockIdx()/ratio,sub=ratio==2?GetSubBlockIdx():0,nc=GetBlockNum(),vcores=nc*ratio;const int64_t mt=(M+255)/256;
 for(int64_t batch=0;batch<B;batch++){
  Duplicate(acc,0.0f,8);int64_t first=batch*mt;first+=(core-first%nc+nc)%nc;
  for(int64_t w=first;w<(batch+1)*mt;w+=nc){
   const int64_t m0=(w%mt)*256+sub*(256/ratio);const int rows=M-m0<256/ratio?M-m0:256/ratio;CrossCoreWaitFlag<2,PIPE_MTE2>(8);
   if(rows>0){SetFlag<HardEvent::V_MTE2>(EVENT_ID0);WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);DataCopy(tile,cg[(batch*M+m0)*pitch],rows*pitch);SetFlag<HardEvent::MTE2_V>(EVENT_ID0);WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);int capacity=128;for(int r=0;r<rows;r+=capacity){int count=rows-r<capacity?rows-r:capacity;WholeReduceMax(row[r],tile[r*pitch],(uint64_t)N,(uint8_t)count,1,1,pitch/8,ReduceOrder::ORDER_ONLY_VALUE);}ReduceSum(out,row,scratch,rows);Add(acc,acc,out,1);}
  }
  SetFlag<HardEvent::V_MTE3>(EVENT_ID0);WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);DataCopyExtParams cp{1,4,0,0,0};DataCopyPad(rg[batch*vcores+GetBlockIdx()],acc,cp);SetFlag<HardEvent::MTE3_V>(EVENT_ID0);WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
 }
 CrossCoreSetFlag<0,PIPE_MTE3>(10);CrossCoreWaitFlag<0,PIPE_MTE2>(10);
 for(int64_t batch=GetBlockIdx();batch<B;batch+=vcores){DataCopyExtParams cp{1,(uint32_t)(vcores*4),0,0,0};DataCopyPadExtParams<float> pad{false,0,0,0};DataCopyPad(tile,rg[batch*vcores],cp,pad);SetFlag<HardEvent::MTE2_V>(EVENT_ID0);WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);ReduceSum(out,tile,scratch,vcores);SetFlag<HardEvent::V_MTE3>(EVENT_ID0);WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);DataCopyExtParams op{1,4,0,0,0};DataCopyPad(yg[batch],out,op);SetFlag<HardEvent::MTE3_V>(EVENT_ID0);WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);}
}

__aicore__ inline void ResidentWideVector(GM_ADDR gc,GM_ADDR gp,GM_ADDR gy,int64_t B,int64_t M,int64_t N,int ratio){
 GlobalTensor<float> cg,pg,yg;cg.SetGlobalBuffer((__gm__ float*)gc);pg.SetGlobalBuffer((__gm__ float*)gp);yg.SetGlobalBuffer((__gm__ float*)gy);
 TPipe pipe;TBuf<TPosition::VECCALC> storage;pipe.InitBuffer(storage,81920);auto tile=storage.Get<float>();auto accum=tile[16384];auto scratch=accum[64];auto out=scratch[1024];
 const int pitch=(M+15)&~15,core=GetBlockIdx()/ratio,sub=ratio==2?GetSubBlockIdx():0,nc=GetBlockNum(),vcores=nc*ratio;const int64_t mt=(N+255)/256;
 for(int64_t batch=0;batch<B;batch++){
  Duplicate(accum,-3.402823466e+38F,64);int64_t first=batch*mt;first+=(core-first%nc+nc)%nc;
  for(int64_t w=first;w<(batch+1)*mt;w+=nc){
   const int64_t n0=(w%mt)*256+sub*(256/ratio);const int rows=N-n0<256/ratio?N-n0:256/ratio;CrossCoreWaitFlag<2,PIPE_MTE2>(8);
   if(rows>0){SetFlag<HardEvent::V_MTE2>(EVENT_ID0);WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);DataCopy(tile,cg[(batch*N+n0)*pitch],rows*pitch);SetFlag<HardEvent::MTE2_V>(EVENT_ID0);WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
    int power=1;while(power*2<=rows)power*=2;if(rows>power)Max(tile,tile,tile[power*pitch],(rows-power)*pitch);PipeBarrier<PIPE_V>();for(int r=power/2;r>0;r/=2){Max(tile,tile,tile[r*pitch],r*pitch);PipeBarrier<PIPE_V>();}Max(accum,accum,tile,(int32_t)M);
   }
  }
  SetFlag<HardEvent::V_MTE3>(EVENT_ID0);WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);DataCopy(pg[(batch*vcores+GetBlockIdx())*pitch],accum,pitch);SetFlag<HardEvent::MTE3_V>(EVENT_ID0);WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
 }
 CrossCoreSetFlag<0,PIPE_MTE3>(10);CrossCoreWaitFlag<0,PIPE_MTE2>(10);
 for(int64_t batch=GetBlockIdx();batch<B;batch+=vcores){DataCopy(tile,pg[batch*vcores*pitch],vcores*pitch);SetFlag<HardEvent::MTE2_V>(EVENT_ID0);WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);int power=1;while(power*2<=vcores)power*=2;if(vcores>power)Max(tile,tile,tile[power*pitch],(vcores-power)*pitch);PipeBarrier<PIPE_V>();for(int r=power/2;r>0;r/=2){Max(tile,tile,tile[r*pitch],r*pitch);PipeBarrier<PIPE_V>();}ReduceSum(out,tile,scratch,(int32_t)M);SetFlag<HardEvent::V_MTE3>(EVENT_ID0);WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);DataCopyExtParams op{1,4,0,0,0};DataCopyPad(yg[batch],out,op);SetFlag<HardEvent::MTE3_V>(EVENT_ID0);WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);}
}
template<typename T,bool TA,bool TB>
__aicore__ inline void AlignedSmall(GM_ADDR ga,GM_ADDR gb,GM_ADDR gy,int64_t B,int64_t M,int64_t N,int64_t K){
 GlobalTensor<T> ag,bg;GlobalTensor<float> yg;ag.SetGlobalBuffer((__gm__ T*)ga);bg.SetGlobalBuffer((__gm__ T*)gb);yg.SetGlobalBuffer((__gm__ float*)gy);
 TPipe pipe;TBuf<TPosition::VECCALC> storage;pipe.InitBuffer(storage,196608);auto raw=storage.Get<T>();auto cast=raw[4096].template ReinterpretCast<float>();auto av=cast[4096];auto bv=av[2048];auto product=bv[2048];auto dot=product[32768];auto dot1=dot[256];auto maxima=dot1[256];auto result=maxima[32];auto idx=result[8].template ReinterpretCast<int32_t>();
 const int ap=((int)(M*K)+15)&~15,bp=((int)(N*K)+15)&~15,np=((int)N+7)&~7;
 for(int64_t batch=GetBlockIdx();batch<B;batch+=GetBlockNum()){
  DataCopyExtParams ac{1,(uint32_t)(M*K*2),0,0,0},bc{1,(uint32_t)(N*K*2),0,0,0};DataCopyPadExtParams<T> pa{true,0,(uint8_t)(ap-M*K),(T)0},pb{true,0,(uint8_t)(bp-N*K),(T)0};DataCopyPad(raw,ag[batch*M*K],ac,pa);DataCopyPad(raw[ap],bg[batch*N*K],bc,pb);SetFlag<HardEvent::MTE2_V>(EVENT_ID0);WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);Cast(cast,raw,RoundMode::CAST_NONE,ap+bp);
  auto af=cast;auto bf=cast[ap];
  if constexpr(TA){CreateVecIndex(idx,(int32_t)0,(uint32_t)K);Muls(idx,idx,(int32_t)(M*4),(int32_t)K);for(int m=0;m<M;m++)Gather(av[m*K],cast,idx.template ReinterpretCast<uint32_t>(),m*4,(int32_t)K);af=av;}
  if(N!=np)Duplicate(bv,0.0f,np*K);
  if constexpr(TB){if(N!=np){Adds(bv,cast[ap],0.0f,(int32_t)(N*K));bf=bv;}}
  if constexpr(!TB){CreateVecIndex(idx,(int32_t)0,(uint32_t)K);Muls(idx,idx,(int32_t)(N*4),(int32_t)K);for(int n=0;n<N;n++)Gather(bv[n*K],cast[ap],idx.template ReinterpretCast<uint32_t>(),n*4,(int32_t)K);bf=bv;}
  BinaryRepeatParams rp(1,1,1,K/8,K/8,0);
  for(int m=0;m<M;m++){Mul(product[m*np*K],bf,af[m*K],(uint64_t)(K<64?K:64),(uint8_t)np,rp);if(K>64)MulAddDst(product[m*np*K],bf[64],af[m*K+64],(uint64_t)(K-64),(uint8_t)np,rp);}
  for(int off=0;off<M*np;off+=128){int nr=M*np-off<128?M*np-off:128;WholeReduceSum(dot[off],product[off*K],(uint64_t)(K<64?K:64),(uint8_t)nr,1,1,K/8);}
  WholeReduceMax(maxima,dot,(uint64_t)N,(uint8_t)M,1,1,np/8,ReduceOrder::ORDER_ONLY_VALUE);WholeReduceSum(result,maxima,(uint64_t)M,1,1,1,1);
  SetFlag<HardEvent::V_MTE3>(EVENT_ID0);WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);DataCopyExtParams cp{1,4,0,0,0};DataCopyPad(yg[batch],result,cp);SetFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);WaitFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);
 }
}
#define ALIGNED_ENTRY(NAME,T,TA,TB) \
extern "C" __global__ __vector__ void NAME(GM_ADDR a,GM_ADDR b,GM_ADDR y,int64_t B,int64_t M,int64_t N,int64_t K){AlignedSmall<T,TA,TB>(a,b,y,B,M,N,K);}
