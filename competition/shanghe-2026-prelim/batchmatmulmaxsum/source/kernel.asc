// Non-TA aligned dense only; complete current-call A and original producer protocol.
template <typename IN_T, bool TX1, bool TX2, bool PRELOAD>
__aicore__ inline void DenseManualACube(
    GM_ADDR ga, GM_ADDR gb, GM_ADDR gc,
    int64_t B, int64_t M, int64_t N, int64_t K,
    int64_t baseM, int64_t baseN)
{
    using AType = MatmulType<TPosition::A1, CubeFormat::NZ, IN_T, false>;
    using BType = MatmulType<TPosition::GM, CubeFormat::ND, IN_T, false>;
    using CType = MatmulType<TPosition::GM, CubeFormat::ND, float, false>;
    using BiasType = MatmulType<TPosition::GM, CubeFormat::ND, float, false>;
    MatmulImpl<AType, BType, CType, BiasType, CFG_MDL> mm;
    const int32_t m = (int32_t)M, n = (int32_t)N, k = (int32_t)K;
    const int32_t bm = TX1?256:128, bn = 128, sn = (int32_t)N;
    TCubeTiling t;
    t.usedCoreNum = 1;
    t.M = m; t.N = n; t.Ka = k; t.Kb = k;
    t.singleCoreM = bm; t.singleCoreN = sn; t.singleCoreK = k;
    t.baseM = bm; t.baseN = bn;
    { const bool tallKSmall = (M <= 64 && N <= 64 && K >= 2048 && (K % 256) == 0);
      t.baseK = tallKSmall ? 256 : 128; }
    t.depthA1 = 2; t.depthB1 = 2;
    t.stepM = 1; t.stepN = 1;
    t.isBias = 0; t.transLength = 0; t.iterateOrder = 0;
    t.shareMode = 0; t.shareL1Size = 0; t.shareL0CSize = 0; t.shareUbSize = 0;
    t.batchM = 0; t.batchN = 0; t.singleBatchM = 0; t.singleBatchN = 0;
    t.stepKa = 1; t.stepKb = 1;
    t.depthAL1CacheUB = 0; t.depthBL1CacheUB = 0;
    t.dbL0A = 1; t.dbL0B = 1; t.dbL0C = 1;
    if (TX1 && M >= 128 && N >= 128 && K >= 512 && M % 128 == 0 && K % 128 == 0) { t.baseK = 64; t.dbL0A = 2; t.dbL0B = 2; }
    t.baseK=TX1?64:128;t.stepKa=TX1?4:k/128;t.stepKb=TX1?4:1;t.depthA1=TX1?8:t.stepKa;t.depthB1=TX1?8:2;
    t.dbL0A=2;t.dbL0B=2;t.dbL0C=TX1?1:2;
    // Double A groups of 6*K64 panels and B groups of 3*K64 panels
    // use 480 KiB of L1: 384 KiB A + 96 KiB B.
    // Keep the M256/N128/K64 arithmetic tiles and all C/consumer scheduling.
    // K%384 guarantees kaStepIter=K/384 and kbStepIter=K/192,
    // so the MDL iteration counts are exact integer multiples (1:2).
    // Double A384 and B192 panels use 480 KiB of L1.
    // Use the larger A groups when each Cube core has at least four
    // output tiles. Smaller schedules retain the original A256/B256 groups.
    const int64_t groupTiles = B * ((M + bm - 1) / bm) * ((N + bn - 1) / bn);
    if(TX1 && !TX2 && k%384==0 && groupTiles >= 4*(int64_t)GetBlockNum()){
        t.stepKa=6;t.depthA1=12;t.stepKb=3;t.depthB1=6;
    }

    GlobalTensor<IN_T>  ag; ag.SetGlobalBuffer((__gm__ IN_T*)ga);
    GlobalTensor<IN_T>  bg; bg.SetGlobalBuffer((__gm__ IN_T*)gb);
    GlobalTensor<float> cg; cg.SetGlobalBuffer((__gm__ float*)gc);
    TPipe pipe;TBuf<TPosition::A1> aBuffer;pipe.InitBuffer(aBuffer,128*k*2);auto aLocal=aBuffer.template Get<IN_T>();
    mm.SetSubBlockIdx(0);
    mm.Init(&t, &pipe);
    const event_t aReady=static_cast<event_t>(pipe.AllocEventID<HardEvent::MTE2_MTE1>());
    const event_t aFree=static_cast<event_t>(pipe.AllocEventID<HardEvent::MTE1_MTE2>());
    bool hasPrefetched=false;
    const int64_t mTiles = (M + bm - 1) / bm;
    const int64_t nTiles = (N + bn - 1) / bn;
    const int64_t items  = B * mTiles * nTiles;
    const int64_t core   = (int64_t)GetBlockIdx();
    const int64_t nCores = (int64_t)GetBlockNum();
    const bool mapExp = true;
    int64_t wFirst = core;
    int64_t wLimit = items;
    int64_t wStep  = nCores;
    if (mapExp) {
        const int64_t q  = items / nCores;
        const int64_t rr = items - q * nCores;
        const int64_t lead = (core < rr) ? core : rr;
        wFirst = core * q + lead;
        wLimit = wFirst + q + ((core < rr) ? 1 : 0);
        wStep  = 1;
    }
    const bool streamRows = (!TX1 && nTiles>4 && nTiles<=32 && items/nCores>4) || (TX1 && !TX2);
    const int64_t notifySpan=TX1&&!TX2?2:4;
    int64_t groupsDone=0;
    for (int64_t w = wFirst; w < wLimit;) {
        const int64_t nTile = w % nTiles;
        const int64_t rem   = w / nTiles;
        const int64_t mTile = rem % mTiles;
        const int64_t b     = rem / mTiles;
        const int64_t m0 = mTile * bm;
        const int64_t n0 = nTile * bn;
        int64_t run = nTiles-nTile;
        if (run>wLimit-w) run=wLimit-w;
        if(TX1 && !TX2 && run>4)run=4;
        const int32_t groupN=(int32_t)(run*bn);
        const int32_t mNow = (int32_t)(((M - m0) < bm) ? (M - m0) : bm);
        const int32_t nNow = (int32_t)(((N - n0) < groupN) ? (N - n0) : groupN);
        GlobalTensor<IN_T> aB = ag[static_cast<uint64_t>(b) * (uint64_t)M * (uint64_t)K];
        GlobalTensor<IN_T> bB = bg[static_cast<uint64_t>(b) * (uint64_t)K * (uint64_t)N];
        mm.SetOrgShape(128, n, k);
        mm.SetSingleShape(bm, groupN, k);
        mm.SetTail(mNow, nNow, k);
        const uint64_t aOff = TX1 ? static_cast<uint64_t>(m0)
                                  : static_cast<uint64_t>(m0) * (uint64_t)K;
        const uint64_t bOff = TX2 ? static_cast<uint64_t>(n0) * (uint64_t)K
                                  : static_cast<uint64_t>(n0);
        // Local NZ A is [K/16,128,16], all real K copied from this call.
        Nd2NzParams aCopy{1,128,(uint16_t)k,0,(uint16_t)k,128,1,0};
        if(!hasPrefetched)DataCopy(aLocal,aB[aOff],aCopy);
        hasPrefetched=false;
        SetFlag<HardEvent::MTE2_MTE1>(aReady);WaitFlag<HardEvent::MTE2_MTE1>(aReady);
        mm.SetTensorA(aLocal, false);
        mm.SetTensorB(bB[bOff], TX2);
        GlobalTensor<float> cTile =
            cg[(static_cast<uint64_t>(b) * (uint64_t)M * (uint64_t)N) +
               (static_cast<uint64_t>(m0) * (uint64_t)N) + static_cast<uint64_t>(n0)];
        int64_t produced=0;
        while (mm.Iterate()) {
            mm.GetTensorC(cTile, 0, false);
            ++produced;
            if constexpr(PRELOAD){
                if(produced==run && w+run<wLimit){
                    // Final N tile has consumed every A panel. MTE1 fence protects reuse.
                    SetFlag<HardEvent::MTE1_MTE2>(aFree);WaitFlag<HardEvent::MTE1_MTE2>(aFree);
                    const int64_t nextW=w+run,nextRem=nextW/nTiles,nextM=nextRem%mTiles,nextB=nextRem/mTiles;
                    DataCopy(aLocal,ag[(nextB*M+nextM*128)*K],aCopy);
                    hasPrefetched=true;
                }
            }

            if(streamRows && (produced%notifySpan==0 || produced==run)){
                if(groupsDone>0)CrossCoreWaitFlag<2,PIPE_S>(7);
                CrossCoreSetFlag<2,PIPE_FIX>(8);++groupsDone;
            }
        }
        if(!streamRows){
            if(TX1 && !TX2 && groupsDone>0)CrossCoreWaitFlag<2,PIPE_S>(7);
            CrossCoreSetFlag<2,PIPE_FIX>(8);++groupsDone;
        }
        if(!hasPrefetched){SetFlag<HardEvent::MTE1_MTE2>(aFree);WaitFlag<HardEvent::MTE1_MTE2>(aFree);}
        w += run;
    }
    if(((TX1 && !TX2)||streamRows) && groupsDone>0)CrossCoreWaitFlag<2,PIPE_S>(7);
    mm.End();
    pipe.ReleaseEventID<HardEvent::MTE2_MTE1>(aReady);pipe.ReleaseEventID<HardEvent::MTE1_MTE2>(aFree);
}
extern "C" __global__ __aicore__ void zzeadense_h00(GM_ADDR a,GM_ADDR b,GM_ADDR c,GM_ADDR p,GM_ADDR r,GM_ADDR y,int64_t B,int64_t M,int64_t N,int64_t K,int64_t bm){KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);if ASCEND_IS_AIC {DenseManualACube<half,false,false,true>(a,b,c,B,M,N,K,bm,128);}if ASCEND_IS_AIV {IsolatedDenseVectorRows(c,y,p,r,B,M,N,N,bm);}}
extern "C" __global__ __aicore__ void zzeadense_h01(GM_ADDR a,GM_ADDR b,GM_ADDR c,GM_ADDR p,GM_ADDR r,GM_ADDR y,int64_t B,int64_t M,int64_t N,int64_t K,int64_t bm){KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);if ASCEND_IS_AIC {DenseManualACube<half,false,true,true>(a,b,c,B,M,N,K,bm,128);}if ASCEND_IS_AIV {IsolatedDenseVectorRows(c,y,p,r,B,M,N,N,bm);}}
extern "C" __global__ __aicore__ void zzeadense_b00(GM_ADDR a,GM_ADDR b,GM_ADDR c,GM_ADDR p,GM_ADDR r,GM_ADDR y,int64_t B,int64_t M,int64_t N,int64_t K,int64_t bm){KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);if ASCEND_IS_AIC {DenseManualACube<bfloat16_t,false,false,true>(a,b,c,B,M,N,K,bm,128);}if ASCEND_IS_AIV {IsolatedDenseVectorRows(c,y,p,r,B,M,N,N,bm);}}
extern "C" __global__ __aicore__ void zzeadense_b01(GM_ADDR a,GM_ADDR b,GM_ADDR c,GM_ADDR p,GM_ADDR r,GM_ADDR y,int64_t B,int64_t M,int64_t N,int64_t K,int64_t bm){KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);if ASCEND_IS_AIC {DenseManualACube<bfloat16_t,false,true,true>(a,b,c,B,M,N,K,bm,128);}if ASCEND_IS_AIV {IsolatedDenseVectorRows(c,y,p,r,B,M,N,N,bm);}}

// K<=128, short<=64. Two logical 128 panels per unchanged outer 256 task.
template<class T,bool ROW_MAJOR>
__aicore__ inline void Sub128CopyPanel(LocalTensor<T> dst,GlobalTensor<T> src,int64_t batch,int64_t L,int K,int64_t start,int len){
 const int padded=(len+15)&~15;
 Nd2NzParams p{1,(uint16_t)(ROW_MAJOR?len:K),(uint16_t)(ROW_MAJOR?K:len),0,(uint16_t)(ROW_MAJOR?K:L),(uint16_t)(ROW_MAJOR?padded:K),1,0};
 DataCopy(dst,src[batch*L*K+(ROW_MAJOR?start*K:start)],p);
}
template<class T,bool ROW_MAJOR>
__aicore__ inline void Sub128CopyGroup(LocalTensor<T> dst,GlobalTensor<T> src,int64_t batch,int64_t L,int K,int64_t start,int len){
 Sub128CopyPanel<T,ROW_MAJOR>(dst,src,batch,L,K,start,len<128?len:128);
 if(len>128)Sub128CopyPanel<T,ROW_MAJOR>(dst[16384],src,batch,L,K,start+128,len-128);
}
template<class T,bool TA>
__aicore__ inline void Sub128LoadA(LocalTensor<T> dst,LocalTensor<T> src,int mp,int kp){
 if constexpr(TA){LoadData2dTransposeParams p{0,(uint8_t)(kp/16),1,0,(uint16_t)(kp/16-1),0};for(int mi=0;mi<mp/16;mi++)LoadDataWithTranspose(dst[mi*kp*16],src[mi*kp*16],p);}
 else{uint8_t padding[4]={0,0,0,0};SetFmatrix(1,mp,padding,FmatrixMode::FMATRIX_LEFT);LoadData3DParamsV2Pro p;p.channelSize=kp;p.extConfig=((uint64_t)mp<<16)|kp;LoadData(dst,src,p);}
}
template<class T,bool TB>
__aicore__ inline void Sub128LoadB(LocalTensor<T> dst,LocalTensor<T> src,int np,int kp){
 if constexpr(TB){LoadData2DParams p{0,(uint8_t)(kp*np/256),1,0,0,false,0};LoadData(dst,src,p);}
 else{
  if(np<kp && np>=64){LoadData2dTransposeParams p{0,(uint8_t)(kp/16),1,(uint16_t)(np/16-1),0,0};for(int ni=0;ni<np/16;ni++)LoadDataWithTranspose(dst[ni*256],src[ni*kp*16],p);}
  else{LoadData2dTransposeParams p{0,(uint8_t)(np/16),(uint16_t)(kp/16),0,0,0};for(int ki=0;ki<kp/16;ki++)LoadDataWithTranspose(dst[ki*np*16],src[ki*256],p);}
 }
}
template<class T,bool TX1,bool TX2>
__aicore__ inline void Sub128ColumnCube(GM_ADDR ga,GM_ADDR gb,GM_ADDR gc,int64_t B,int64_t S,int64_t L,int64_t K){
 GlobalTensor<T> ag,bg;GlobalTensor<float> cg;ag.SetGlobalBuffer((__gm__ T*)ga);bg.SetGlobalBuffer((__gm__ T*)gb);cg.SetGlobalBuffer((__gm__ float*)gc);
 TPipe pipe;TBuf<TPosition::A1> a1b;TBuf<TPosition::A2> a2b;TBuf<TPosition::B1> b1b;TBuf<TPosition::B2> b2b;TBuf<TPosition::CO1> cb;
 pipe.InitBuffer(a1b,64*128*2);pipe.InitBuffer(a2b,64*128*2);pipe.InitBuffer(b1b,2*256*128*2);pipe.InitBuffer(b2b,2*128*128*2);pipe.InitBuffer(cb,2*16384*4);
 auto a1=a1b.template Get<T>();auto a2=a2b.template Get<T>();auto b1=b1b.template Get<T>();auto b2=b2b.template Get<T>();auto c=cb.template Get<float>();
 const event_t input=static_cast<event_t>(pipe.AllocEventID<HardEvent::MTE2_MTE1>());
 const event_t l0ready0=static_cast<event_t>(pipe.AllocEventID<HardEvent::MTE1_M>()),l0ready1=static_cast<event_t>(pipe.AllocEventID<HardEvent::MTE1_M>());
 const event_t fixready0=static_cast<event_t>(pipe.AllocEventID<HardEvent::M_FIX>()),fixready1=static_cast<event_t>(pipe.AllocEventID<HardEvent::M_FIX>());
 const event_t drain=static_cast<event_t>(pipe.AllocEventID<HardEvent::FIX_MTE2>());
 const int mp=(S+15)&~15,kp=K;const int64_t mt=(L+255)/256;int64_t previous=-1;bool prefetched=false;int bank=0;
 for(int64_t w=GetBlockIdx();w<B*mt;w+=GetBlockNum()){
  auto longL1=b1[bank*32768];const int64_t batch=w/mt,n0=(w%mt)*256;const int now=L-n0<256?L-n0:256;
  if(!prefetched)Sub128CopyGroup<T,TX2>(longL1,bg,batch,L,kp,n0,now);
  if(previous!=batch){Nd2NzParams acp{1,(uint16_t)(TX1?K:S),(uint16_t)(TX1?S:K),0,(uint16_t)(TX1?S:K),(uint16_t)(TX1?kp:mp),1,0};DataCopy(a1,ag[batch*S*K],acp);}
  SetFlag<HardEvent::MTE2_MTE1>(input);WaitFlag<HardEvent::MTE2_MTE1>(input);
  if(previous!=batch){
   if constexpr(TX1){LoadData2dTransposeParams p{0,(uint8_t)(kp/16),1,0,(uint16_t)(kp/16-1),0};for(int mi=0;mi<mp/16;mi++)LoadDataWithTranspose(a2[mi*kp*16],a1[mi*kp*16],p);}
   else{LoadData2DParams p{0,(uint8_t)(kp/16),(uint16_t)(mp/16),0,0,false,0};for(int mi=0;mi<mp/16;mi++)LoadData(a2[mi*kp*16],a1[mi*256],p);}
   previous=batch;
  }
  const int len0=now<128?now:128,len1=now-len0,np0=(len0+15)&~15,np1=(len1+15)&~15;
  Sub128LoadB<T,TX2>(b2,longL1,np0,kp);SetFlag<HardEvent::MTE1_M>(l0ready0);WaitFlag<HardEvent::MTE1_M>(l0ready0);
  MmadParams mm;mm.m=mp;mm.n=np0;mm.k=kp;mm.cmatrixInitVal=true;mm.cmatrixSource=false;Mmad(c,a2,b2,mm);SetFlag<HardEvent::M_FIX>(fixready0);
  if(len1){Sub128LoadB<T,TX2>(b2[16384],longL1[16384],np1,kp);SetFlag<HardEvent::MTE1_M>(l0ready1);}
  const int64_t nextW=w+(int64_t)GetBlockNum();prefetched=nextW<(batch+1)*mt;
  if(prefetched){const int64_t next0=n0+(int64_t)GetBlockNum()*256;const int nextNow=L-next0<256?L-next0:256;Sub128CopyGroup<T,TX2>(b1[(1-bank)*32768],bg,batch,L,kp,next0,nextNow);}
  if(len1){WaitFlag<HardEvent::MTE1_M>(l0ready1);mm.n=np1;Mmad(c[16384],a2,b2[16384],mm);SetFlag<HardEvent::M_FIX>(fixready1);}
  WaitFlag<HardEvent::M_FIX>(fixready0);FixpipeParamsV220 fp;fp.mSize=S;fp.nSize=len0;fp.srcStride=mp;fp.dstStride=256;fp.ndNum=1;fp.srcNdStride=0;fp.dstNdStride=0;fp.reluEn=false;Fixpipe<float,float,CFG_ROW_MAJOR>(cg[w*mp*256],c,fp);
  if(len1){WaitFlag<HardEvent::M_FIX>(fixready1);fp.nSize=len1;Fixpipe<float,float,CFG_ROW_MAJOR>(cg[w*mp*256+128],c[16384],fp);}
  CrossCoreSetFlag<2,PIPE_FIX>(8);SetFlag<HardEvent::FIX_MTE2>(drain);WaitFlag<HardEvent::FIX_MTE2>(drain);bank=1-bank;
 }
 pipe.ReleaseEventID<HardEvent::MTE2_MTE1>(input);pipe.ReleaseEventID<HardEvent::MTE1_M>(l0ready0);pipe.ReleaseEventID<HardEvent::MTE1_M>(l0ready1);pipe.ReleaseEventID<HardEvent::M_FIX>(fixready0);pipe.ReleaseEventID<HardEvent::M_FIX>(fixready1);pipe.ReleaseEventID<HardEvent::FIX_MTE2>(drain);
}
template<class T,bool TX1,bool TX2>
__aicore__ inline void Sub128TallCube(GM_ADDR ga,GM_ADDR gb,GM_ADDR gc,int64_t B,int64_t M,int64_t N,int64_t K){
 GlobalTensor<T> ag,bg;GlobalTensor<float> cg;ag.SetGlobalBuffer((__gm__ T*)ga);bg.SetGlobalBuffer((__gm__ T*)gb);cg.SetGlobalBuffer((__gm__ float*)gc);
 TPipe pipe;TBuf<TPosition::A1> a1b;TBuf<TPosition::A2> a2b;TBuf<TPosition::B1> b1b;TBuf<TPosition::B2> b2b;TBuf<TPosition::CO1> cb;
 pipe.InitBuffer(a1b,2*256*128*2);pipe.InitBuffer(a2b,2*128*128*2);pipe.InitBuffer(b1b,64*128*2);pipe.InitBuffer(b2b,64*128*2);pipe.InitBuffer(cb,2*16384*4);
 auto a1=a1b.template Get<T>();auto a2=a2b.template Get<T>();auto b1=b1b.template Get<T>();auto b2=b2b.template Get<T>();auto c=cb.template Get<float>();
 const event_t input=static_cast<event_t>(pipe.AllocEventID<HardEvent::MTE2_MTE1>());
 const event_t l0ready0=static_cast<event_t>(pipe.AllocEventID<HardEvent::MTE1_M>()),l0ready1=static_cast<event_t>(pipe.AllocEventID<HardEvent::MTE1_M>());
 const event_t fixready0=static_cast<event_t>(pipe.AllocEventID<HardEvent::M_FIX>()),fixready1=static_cast<event_t>(pipe.AllocEventID<HardEvent::M_FIX>());
 const event_t drain=static_cast<event_t>(pipe.AllocEventID<HardEvent::FIX_MTE2>());
 const int np=(N+15)&~15,kp=K,cs=np;const int64_t mt=(M+255)/256;int64_t previous=-1;bool prefetched=false;int bank=0;
 for(int64_t w=GetBlockIdx();w<B*mt;w+=GetBlockNum()){
  auto longL1=a1[bank*32768];const int64_t batch=w/mt,m0=(w%mt)*256;const int now=M-m0<256?M-m0:256;
  if(!prefetched)Sub128CopyGroup<T,!TX1>(longL1,ag,batch,M,kp,m0,now);
  if(previous!=batch){Nd2NzParams bcp{1,(uint16_t)(TX2?N:K),(uint16_t)(TX2?K:N),0,(uint16_t)(TX2?K:N),(uint16_t)(TX2?np:kp),1,0};DataCopy(b1,bg[batch*N*K],bcp);}
  SetFlag<HardEvent::MTE2_MTE1>(input);WaitFlag<HardEvent::MTE2_MTE1>(input);
  if(previous!=batch){Sub128LoadB<T,TX2>(b2,b1,np,kp);previous=batch;}
  const int len0=now<128?now:128,len1=now-len0,mp0=(len0+15)&~15,mp1=(len1+15)&~15;
  Sub128LoadA<T,TX1>(a2,longL1,mp0,kp);SetFlag<HardEvent::MTE1_M>(l0ready0);WaitFlag<HardEvent::MTE1_M>(l0ready0);
  MmadParams mm;mm.m=mp0;mm.n=np;mm.k=kp;mm.cmatrixInitVal=true;mm.cmatrixSource=false;Mmad(c,a2,b2,mm);SetFlag<HardEvent::M_FIX>(fixready0);
  if(len1){Sub128LoadA<T,TX1>(a2[16384],longL1[16384],mp1,kp);SetFlag<HardEvent::MTE1_M>(l0ready1);}
  const int64_t nextW=w+(int64_t)GetBlockNum();prefetched=nextW<(batch+1)*mt;
  if(prefetched){const int64_t next0=m0+(int64_t)GetBlockNum()*256;const int nextNow=M-next0<256?M-next0:256;Sub128CopyGroup<T,!TX1>(a1[(1-bank)*32768],ag,batch,M,kp,next0,nextNow);}
  if(len1){WaitFlag<HardEvent::MTE1_M>(l0ready1);mm.m=mp1;Mmad(c[16384],a2[16384],b2,mm);SetFlag<HardEvent::M_FIX>(fixready1);}
  WaitFlag<HardEvent::M_FIX>(fixready0);FixpipeParamsV220 fp;fp.mSize=len0;fp.nSize=np;fp.srcStride=mp0;fp.dstStride=cs;fp.ndNum=1;fp.srcNdStride=0;fp.dstNdStride=0;fp.reluEn=false;Fixpipe<float,float,CFG_ROW_MAJOR>(cg[(batch*M+m0)*cs],c,fp);
  if(len1){WaitFlag<HardEvent::M_FIX>(fixready1);fp.mSize=len1;fp.srcStride=mp1;Fixpipe<float,float,CFG_ROW_MAJOR>(cg[(batch*M+m0+128)*cs],c[16384],fp);}
  CrossCoreSetFlag<2,PIPE_FIX>(8);SetFlag<HardEvent::FIX_MTE2>(drain);WaitFlag<HardEvent::FIX_MTE2>(drain);bank=1-bank;
 }
 pipe.ReleaseEventID<HardEvent::MTE2_MTE1>(input);pipe.ReleaseEventID<HardEvent::MTE1_M>(l0ready0);pipe.ReleaseEventID<HardEvent::MTE1_M>(l0ready1);pipe.ReleaseEventID<HardEvent::M_FIX>(fixready0);pipe.ReleaseEventID<HardEvent::M_FIX>(fixready1);pipe.ReleaseEventID<HardEvent::FIX_MTE2>(drain);
}
extern "C" __global__ __aicore__ void zzsubcol_h00(GM_ADDR a,GM_ADDR b,GM_ADDR c,GM_ADDR r,GM_ADDR y,int64_t B,int64_t M,int64_t N,int64_t K){KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_1);if ASCEND_IS_AIC {Sub128ColumnCube<half,true,true>(b,a,c,B,N,M,K);}if ASCEND_IS_AIV {ResidentColumnVector(c,r,y,B,M,N);}}
