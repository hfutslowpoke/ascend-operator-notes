 }
 SetFlag<HardEvent::V_MTE3>(EVENT_ID0);WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
 DataCopyExtParams cp{1,(uint32_t)(rows*4),0,0,0};DataCopyPad(rg[batch*M+mi*bm+part*(bm/2)],acc,cp);
