   if(a.dtype==1){if(transposeX2)zzeadense_h01<<<(uint32_t)width,nullptr,stream>>>(x1,x2,c,p,r,y,B,M,N,K,tileM);else zzeadense_h00<<<(uint32_t)width,nullptr,stream>>>(x1,x2,c,p,r,y,B,M,N,K,tileM);}
   else{if(transposeX2)zzeadense_b01<<<(uint32_t)width,nullptr,stream>>>(x1,x2,c,p,r,y,B,M,N,K,tileM);else zzeadense_b00<<<(uint32_t)width,nullptr,stream>>>(x1,x2,c,p,r,y,B,M,N,K,tileM);}
