  int64_t width=B<availableCoreNum?B:availableCoreNum;void* memory=nullptr;size_t bytes=(size_t)B*N*((M+15)&~15)*4;if(aclrtMalloc(&memory,bytes,ACL_MEM_MALLOC_HUGE_FIRST)!=ACL_SUCCESS)return;
