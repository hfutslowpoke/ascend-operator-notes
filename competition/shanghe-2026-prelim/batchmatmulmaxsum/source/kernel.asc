WIDE_ENTRY(wide_b11,bfloat16_t,true,true)
__aicore__ inline void ParallelSplitReduce(GM_ADDR gc,GM_ADDR gp,GM_ADDR gy,int64_t B,int64_t M,int64_t N,int64_t slices){
 GlobalTensor<float> cg,pg,yg;cg.SetGlobalBuffer((__gm__ float*)gc);pg.SetGlobalBuffer((__gm__ float*)gp);yg.SetGlobalBuffer((__gm__ float*)gy);
 TPipe pipe;TBuf<TPosition::VECCALC> storage;pipe.InitBuffer(storage,32768);auto tile=storage.Get<float>();auto second=tile[2048];auto third=second[2048];auto rows=third[2048];auto rows2=rows[32];auto scratch=rows2[32];auto out=scratch[512];const int pitch=(N+63)&~63,al=(N+7)&~7;const int64_t mt=(M+15)/16,nc=GetBlockNum();
 for(int64_t job=GetBlockIdx();job<B*mt;job+=nc){
  int64_t batch=job/mt,m0=(job%mt)*16;int countRows=M-m0<16?M-m0:16,count=countRows*pitch;Duplicate(tile,0.0f,count);
  DataCopyExtParams cp{(uint16_t)countRows,(uint32_t)(N*4),0,(uint32_t)((pitch-al)/8),0};DataCopyPadExtParams<float> pad{true,0,(uint8_t)(al-N),0.0f};
  // Two independent DMA buffers; vector additions retain increasing slice order.
  Duplicate(second,0.0f,count);Duplicate(third,0.0f,count);
  SetFlag<HardEvent::V_MTE2>(EVENT_ID2);WaitFlag<HardEvent::V_MTE2>(EVENT_ID2);
  DataCopyPad(second,cg[batch*M*N+m0*N],cp,pad);SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
  for(int64_t slice=0;slice<slices;slice++){
   if(slice&1)WaitFlag<HardEvent::MTE2_V>(EVENT_ID1);else WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
   if(slice+1<slices){
    if(slice&1){
     if(slice>0)WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
     DataCopyPad(second,cg[((slice+1)*B+batch)*M*N+m0*N],cp,pad);SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
    }else{
     if(slice>0)WaitFlag<HardEvent::V_MTE2>(EVENT_ID1);
     DataCopyPad(third,cg[((slice+1)*B+batch)*M*N+m0*N],cp,pad);SetFlag<HardEvent::MTE2_V>(EVENT_ID1);
    }
   }
   if(slice&1)Add(tile,tile,third,count);else Add(tile,tile,second,count);
   if(slice+2<slices){if(slice&1)SetFlag<HardEvent::V_MTE2>(EVENT_ID1);else SetFlag<HardEvent::V_MTE2>(EVENT_ID0);}
  }
  WholeReduceMax(rows,tile,(uint64_t)(N<64?N:64),(uint8_t)countRows,1,1,pitch/8,ReduceOrder::ORDER_ONLY_VALUE);if(N>64){WholeReduceMax(rows2,tile[64],(uint64_t)(N-64),(uint8_t)countRows,1,1,pitch/8,ReduceOrder::ORDER_ONLY_VALUE);Max(rows,rows,rows2,countRows);}ReduceSum(out,rows,scratch,countRows);
  SetFlag<HardEvent::V_MTE3>(EVENT_ID0);WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);DataCopyExtParams cpout{1,4,0,0,0};DataCopyPad(pg[job],out,cpout);SetFlag<HardEvent::MTE3_V>(EVENT_ID0);WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
 }
 CrossCoreSetFlag<0,PIPE_MTE3>(7);CrossCoreWaitFlag<0,PIPE_MTE2>(7);
 for(int64_t batch=GetBlockIdx();batch<B;batch+=nc){
  DataCopyExtParams cp{1,(uint32_t)(mt*4),0,0,0};DataCopyPadExtParams<float> pad{false,0,0,0};DataCopyPad(tile,pg[batch*mt],cp,pad);SetFlag<HardEvent::MTE2_V>(EVENT_ID0);WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);ReduceSum(out,tile,scratch,(int32_t)mt);SetFlag<HardEvent::V_MTE3>(EVENT_ID0);WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);DataCopyExtParams cpout{1,4,0,0,0};DataCopyPad(yg[batch],out,cpout);SetFlag<HardEvent::MTE3_V>(EVENT_ID0);WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
 }
}
__aicore__ inline void ParallelSplitReducePacked(GM_ADDR gc,GM_ADDR gp,GM_ADDR gy,int64_t B,int64_t M,int64_t N,int64_t slices){
 GlobalTensor<float> cg,pg,yg;cg.SetGlobalBuffer((__gm__ float*)gc);pg.SetGlobalBuffer((__gm__ float*)gp);yg.SetGlobalBuffer((__gm__ float*)gy);
 TPipe pipe;TBuf<TPosition::VECCALC> storage;pipe.InitBuffer(storage,81920);
 auto planes=storage.Get<float>();auto tile=planes[16384];auto rows=tile[2048];auto rows2=rows[32];auto scratch=rows2[32];auto out=scratch[512];
 const int pitch=N;const int64_t mt=(M+15)/16,nc=GetBlockNum();
 for(int64_t job=GetBlockIdx();job<B*mt;job+=nc){
  const int64_t batch=job/mt,m0=(job%mt)*16;
  const int countRows=M-m0<16?M-m0:16,count=countRows*pitch;
  // Up to eight complete FP32 slice tiles fit in 64KiB. N%8==0 makes
  // each row and plane transfer 32-byte aligned without numerical padding.
  Duplicate(tile,0.0f,count);
  DataCopyExtParams all{(uint16_t)slices,(uint32_t)(count*4),(uint32_t)((B*M*N-count)*4),0,0};
  DataCopyPadExtParams<float> pad{false,0,0,0.0f};
  SetFlag<HardEvent::V_MTE2>(EVENT_ID1);WaitFlag<HardEvent::V_MTE2>(EVENT_ID1);
  DataCopyPad(planes,cg[batch*M*N+m0*N],all,pad);
  SetFlag<HardEvent::MTE2_V>(EVENT_ID0);WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
  for(int64_t slice=0;slice<slices;slice++)Add(tile,tile,planes[slice*count],count);
  WholeReduceMax(rows,tile,(uint64_t)(N<64?N:64),(uint8_t)countRows,1,1,pitch/8,ReduceOrder::ORDER_ONLY_VALUE);if(N>64){WholeReduceMax(rows2,tile[64],(uint64_t)(N-64),(uint8_t)countRows,1,1,pitch/8,ReduceOrder::ORDER_ONLY_VALUE);Max(rows,rows,rows2,countRows);}ReduceSum(out,rows,scratch,countRows);
  SetFlag<HardEvent::V_MTE3>(EVENT_ID0);WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);DataCopyExtParams cpout{1,4,0,0,0};DataCopyPad(pg[job],out,cpout);SetFlag<HardEvent::MTE3_V>(EVENT_ID0);WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
 }
 CrossCoreSetFlag<0,PIPE_MTE3>(7);CrossCoreWaitFlag<0,PIPE_MTE2>(7);
 for(int64_t batch=GetBlockIdx();batch<B;batch+=nc){
  DataCopyExtParams cp{1,(uint32_t)(mt*4),0,0,0};DataCopyPadExtParams<float> pad{false,0,0,0};DataCopyPad(tile,pg[batch*mt],cp,pad);SetFlag<HardEvent::MTE2_V>(EVENT_ID0);WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);ReduceSum(out,tile,scratch,(int32_t)mt);SetFlag<HardEvent::V_MTE3>(EVENT_ID0);WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);DataCopyExtParams cpout{1,4,0,0,0};DataCopyPad(yg[batch],out,cpout);SetFlag<HardEvent::MTE3_V>(EVENT_ID0);WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
 }
}
