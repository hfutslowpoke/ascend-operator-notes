template<typename T,bool TA,bool TB>
__aicore__ inline void Transpose32SmallOnce(GM_ADDR ga,GM_ADDR gb,GM_ADDR gy,int64_t B,int64_t M,int64_t N,int64_t K){
 const int64_t owner=GetBlockIdx();if(owner>=B)return;
 GlobalTensor<T> ag,bg;GlobalTensor<float> yg;ag.SetGlobalBuffer((__gm__ T*)ga);bg.SetGlobalBuffer((__gm__ T*)gb);yg.SetGlobalBuffer((__gm__ float*)gy);
 TPipe pipe;TBuf<TPosition::VECCALC> storage;pipe.InitBuffer(storage,196608);auto raw=storage.Get<T>();auto cast=raw[4096].template ReinterpretCast<float>();auto av=cast[4096];auto bv=av[2048];auto product=bv[2048];auto dot=product[32768];auto dot1=dot[256];auto maxima=dot1[256];auto result=maxima[32];auto idx=result[8].template ReinterpretCast<int32_t>();
 const int ap=((int)(M*K)+15)&~15,bp=((int)(N*K)+15)&~15,np=((int)N+7)&~7;
 {const int64_t batch=owner;
  DataCopyExtParams ac{1,(uint32_t)(M*K*2),0,0,0},bc{1,(uint32_t)(N*K*2),0,0,0};DataCopyPadExtParams<T> pa{true,0,(uint8_t)(ap-M*K),(T)0},pb{true,0,(uint8_t)(bp-N*K),(T)0};DataCopyPad(raw,ag[batch*M*K],ac,pa);DataCopyPad(raw[ap],bg[batch*N*K],bc,pb);SetFlag<HardEvent::MTE2_V>(EVENT_ID0);WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);Cast(cast,raw,RoundMode::CAST_NONE,ap+bp);
  auto af=cast;auto bf=cast[ap];
  if constexpr(TA){
   PipeBarrier<PIPE_V>();uint64_t src[16],dst[16];
   for(int mg=0;mg<M;mg+=8){
#pragma unroll
    for(int i=0;i<16;i++){src[i]=(uint64_t)cast[i*M+mg].GetPhyAddr();dst[i]=(uint64_t)av[(mg+i/2)*K+(i%2)*8].GetPhyAddr();}
    TransDataTo5HDParams p{false,false,(uint8_t)(K/16),(uint16_t)(K==16?0:2),(uint16_t)(K==16?0:M*2)};TransDataTo5HD<float>(dst,src,p);
   }
   PipeBarrier<PIPE_V>();af=av;
  }
  if(N!=np)Duplicate(bv,0.0f,np*K);
  if constexpr(TB){if(N!=np){Adds(bv,cast[ap],0.0f,(int32_t)(N*K));bf=bv;}}
  if constexpr(!TB){CreateVecIndex(idx,(int32_t)0,(uint32_t)K);Muls(idx,idx,(int32_t)(N*4),(int32_t)K);for(int n=0;n<N;n++)Gather(bv[n*K],cast[ap],idx.template ReinterpretCast<uint32_t>(),n*4,(int32_t)K);bf=bv;}
  BinaryRepeatParams rp(1,1,1,K/8,K/8,0);
  for(int m=0;m<M;m++){Mul(product[m*np*K],bf,af[m*K],(uint64_t)(K<64?K:64),(uint8_t)np,rp);if(K>64)MulAddDst(product[m*np*K],bf[64],af[m*K+64],(uint64_t)(K-64),(uint8_t)np,rp);}
  for(int off=0;off<M*np;off+=128){int nr=M*np-off<128?M*np-off:128;WholeReduceSum(dot[off],product[off*K],(uint64_t)(K<64?K:64),(uint8_t)nr,1,1,K/8);}
  WholeReduceMax(maxima,dot,(uint64_t)N,(uint8_t)M,1,1,np/8,ReduceOrder::ORDER_ONLY_VALUE);WholeReduceSum(result,maxima,(uint64_t)M,1,1,1,1);
  SetFlag<HardEvent::V_MTE3>(EVENT_ID0);WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);DataCopyExtParams cp{1,4,0,0,0};DataCopyPad(yg[batch],result,cp);
 }
}

