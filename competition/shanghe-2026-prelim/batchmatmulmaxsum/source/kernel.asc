// Two L1/L0 banks; each complete K slice accumulates into one FP32 L0C.
// Consumer and host K-slice partition/order remain unchanged.
template<class T,bool TA,bool TB>
__aicore__ inline void RawSplitCube(GM_ADDR ga,GM_ADDR gb,GM_ADDR gc,int64_t B,int64_t M,int64_t N,int64_t K,int64_t slices){
 GlobalTensor<T> ag,bg;GlobalTensor<float> cg;ag.SetGlobalBuffer((__gm__ T*)ga);bg.SetGlobalBuffer((__gm__ T*)gb);cg.SetGlobalBuffer((__gm__ float*)gc);
 TPipe pipe;TBuf<TPosition::A1> a1b;TBuf<TPosition::B1> b1b;TBuf<TPosition::A2> a2b;TBuf<TPosition::B2> b2b;TBuf<TPosition::CO1> cb;
 pipe.InitBuffer(a1b,65536);pipe.InitBuffer(b1b,65536);pipe.InitBuffer(a2b,65536);pipe.InitBuffer(b2b,65536);pipe.InitBuffer(cb,16384);
 auto a1=a1b.template Get<T>();auto b1=b1b.template Get<T>();auto a2=a2b.template Get<T>();auto b2=b2b.template Get<T>();auto c=cb.template Get<float>();
 // C220 TPipe reserves/pre-signals M_MTE1 0/1/2; own completion events.
 const event_t l0Free0=static_cast<event_t>(pipe.AllocEventID<HardEvent::M_MTE1>());
 const event_t l0Free1=static_cast<event_t>(pipe.AllocEventID<HardEvent::M_MTE1>());
 const int kp=256;const int64_t kl=K/slices,panels=kl/kp;
 for(int64_t w=GetBlockIdx();w<B*slices;w+=GetBlockNum()){
  const int64_t slice=w/B,batch=w%B,k0=slice*kl;
  Nd2NzParams ap{1,(uint16_t)(TA?kp:M),(uint16_t)(TA?M:kp),0,(uint16_t)(TA?M:K),(uint16_t)(TA?kp:M),1,0};
  Nd2NzParams bp{1,(uint16_t)(TB?N:kp),(uint16_t)(TB?kp:N),0,(uint16_t)(TB?K:N),(uint16_t)(TB?N:kp),1,0};
  for(int i=0;i<2 && i<panels;i++){
   const int64_t k=k0+i*kp;DataCopy(a1[i*16384],ag[batch*M*K+(TA?k*M:k)],ap);DataCopy(b1[i*16384],bg[batch*N*K+(TB?k:k*N)],bp);
   if(i){SetFlag<HardEvent::MTE2_MTE1>(EVENT_ID1);}else{SetFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);}
  }
  for(int64_t p=0;p<panels;p++){
   const bool bank=p&1;const int offset=bank?16384:0;auto aa1=a1[offset];auto bb1=b1[offset];auto aa2=a2[offset];auto bb2=b2[offset];
   if(bank){WaitFlag<HardEvent::MTE2_MTE1>(EVENT_ID1);if(p>=2)WaitFlag<HardEvent::M_MTE1>(l0Free1);}else{WaitFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);if(p>=2)WaitFlag<HardEvent::M_MTE1>(l0Free0);}
   if constexpr(TA){LoadData2dTransposeParams q{0,16,1,0,15,0};for(int mi=0;mi<M/16;mi++)LoadDataWithTranspose(aa2[mi*kp*16],aa1[mi*kp*16],q);}
   else{LoadData2DParams q{0,16,(uint16_t)(M/16),0,0,false,0};for(int mi=0;mi<M/16;mi++)LoadData(aa2[mi*kp*16],aa1[mi*256],q);}
   if constexpr(TB){LoadData2DParams q{0,(uint8_t)N,1,0,0,false,0};LoadData(bb2,bb1,q);}
   else{
    if(N>=64){LoadData2dTransposeParams q{0,16,1,(uint16_t)(N/16-1),0,0};for(int ni=0;ni<N/16;ni++)LoadDataWithTranspose(bb2[ni*256],bb1[ni*kp*16],q);}
    else{LoadData2dTransposeParams q{0,(uint8_t)(N/16),16,0,0,0};for(int ki=0;ki<kp/16;ki++)LoadDataWithTranspose(bb2[ki*N*16],bb1[ki*256],q);}
   }
   SetFlag<HardEvent::MTE1_M>(EVENT_ID2);WaitFlag<HardEvent::MTE1_M>(EVENT_ID2);
   if(p+2<panels){
    if(bank){SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID1);WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID1);}else{SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);}
    const int64_t k=k0+(p+2)*kp;DataCopy(aa1,ag[batch*M*K+(TA?k*M:k)],ap);DataCopy(bb1,bg[batch*N*K+(TB?k:k*N)],bp);
    if(bank){SetFlag<HardEvent::MTE2_MTE1>(EVENT_ID1);}else{SetFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);}
   }
   MmadParams mm;mm.m=M;mm.n=N;mm.k=kp;mm.cmatrixInitVal=p==0;mm.cmatrixSource=false;Mmad(c,aa2,bb2,mm);
   if((M/16)*(N/16)<10)PipeBarrier<PIPE_M>();
   if(p+2<panels){if(bank)SetFlag<HardEvent::M_MTE1>(l0Free1);else SetFlag<HardEvent::M_MTE1>(l0Free0);}
  }
  SetFlag<HardEvent::M_FIX>(EVENT_ID0);WaitFlag<HardEvent::M_FIX>(EVENT_ID0);FixpipeParamsV220 fp;fp.mSize=M;fp.nSize=N;fp.srcStride=M;fp.dstStride=N;fp.ndNum=1;fp.srcNdStride=0;fp.dstNdStride=0;fp.reluEn=false;Fixpipe<float,float,CFG_ROW_MAJOR>(cg[(slice*B+batch)*M*N],c,fp);
  SetFlag<HardEvent::FIX_MTE2>(EVENT_ID0);WaitFlag<HardEvent::FIX_MTE2>(EVENT_ID0);
 }
 // Only reusable panels set flags; p+2 consumes each token before the job ends.
 pipe.ReleaseEventID<HardEvent::M_MTE1>(l0Free0);
 pipe.ReleaseEventID<HardEvent::M_MTE1>(l0Free1);
}

