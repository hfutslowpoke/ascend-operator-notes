  switch(route){ACASE(0,aligned_h00,aligned_once_h00) ACASE(1,aligned_h01,aligned_once_h01) ACASE(2,aligned_h10,aligned_once_h10) ACASE(3,aligned_h11,aligned_once_h11) ACASE(4,aligned_b00,aligned_once_b00) ACASE(5,aligned_b01,aligned_once_b01) ACASE(6,aligned_b10,aligned_once_b10) ACASE(7,aligned_b11,aligned_once_b11)}
