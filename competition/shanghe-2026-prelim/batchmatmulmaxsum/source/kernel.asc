#include "kernel_operator.h"
#include "adv_api/matmul_intf.h"
using namespace AscendC;
// BMM(FP32) -> Max(N) -> Sum(M). All input-dependent work is in one launch.
// Tiling depends on layout, workload ranges and hardware core budget.
// Each invocation owns its scratch; no data or allocation survives the call.
template <typename IN_T, bool TX1, bool TX2>
__aicore__ inline void BmmsCubeBmm(
    GM_ADDR ga, GM_ADDR gb, GM_ADDR gc,
    int64_t B, int64_t M, int64_t N, int64_t K,
    int64_t baseM, int64_t baseN)
{
    using AType = MatmulType<TPosition::GM, CubeFormat::ND, IN_T, false>;
    using BType = MatmulType<TPosition::GM, CubeFormat::ND, IN_T, false>;
    using CType = MatmulType<TPosition::GM, CubeFormat::ND, float, false>;
    using BiasType = MatmulType<TPosition::GM, CubeFormat::ND, float, false>;
    MatmulImpl<AType, BType, CType, BiasType, CFG_NORM> mm;
    const int32_t m = (int32_t)M, n = (int32_t)N, k = (int32_t)K;
    const int32_t bm = (int32_t)baseM, bn = (int32_t)baseN;
    TCubeTiling t;
    t.usedCoreNum = 1;
    t.M = m; t.N = n; t.Ka = k; t.Kb = k;
    t.singleCoreM = bm; t.singleCoreN = bn; t.singleCoreK = k;
    t.baseM = bm; t.baseN = bn;
    { const bool tallKSmall = (M <= 64 && N <= 64 && K >= 2048 && (K % 256) == 0);
      t.baseK = tallKSmall ? 256 : 128; }
    t.depthA1 = 2; t.depthB1 = 2;
    t.stepM = 1; t.stepN = 1;
    t.isBias = 0; t.transLength = 0; t.iterateOrder = 0;
    t.shareMode = 0; t.shareL1Size = 0; t.shareL0CSize = 0; t.shareUbSize = 0;
    t.batchM = 0; t.batchN = 0; t.singleBatchM = 0; t.singleBatchN = 0;
    t.stepKa = 1; t.stepKb = 1;
    t.depthAL1CacheUB = 0; t.depthBL1CacheUB = 0;
    t.dbL0A = 1; t.dbL0B = 1; t.dbL0C = 1;
    if (TX1 && M >= 128 && N >= 128 && K >= 512 && M % 128 == 0 && K % 128 == 0) { t.baseK = 64; t.dbL0A = 2; t.dbL0B = 2; }
    GlobalTensor<IN_T>  ag; ag.SetGlobalBuffer((__gm__ IN_T*)ga);
    GlobalTensor<IN_T>  bg; bg.SetGlobalBuffer((__gm__ IN_T*)gb);
    GlobalTensor<float> cg; cg.SetGlobalBuffer((__gm__ float*)gc);
    TPipe pipe;
    mm.SetSubBlockIdx(0);
    mm.Init(&t, &pipe);
    const int64_t mTiles = (M + bm - 1) / bm;
    const int64_t nTiles = (N + bn - 1) / bn;
    const int64_t items  = B * mTiles * nTiles;
    const int64_t core   = (int64_t)GetBlockIdx();
    const int64_t nCores = (int64_t)GetBlockNum();
    const bool mapExp = (!TX1) && (M >= 1024) && (N >= 1024) && (K >= 512);
    int64_t wFirst = core;
    int64_t wLimit = items;
    int64_t wStep  = nCores;
    if (mapExp) {
        const int64_t q  = items / nCores;
        const int64_t rr = items - q * nCores;
        const int64_t lead = (core < rr) ? core : rr;
        wFirst = core * q + lead;
        wLimit = wFirst + q + ((core < rr) ? 1 : 0);
        wStep  = 1;
    }
    for (int64_t w = wFirst; w < wLimit; w += wStep) {
        const int64_t nTile = w % nTiles;
        const int64_t rem   = w / nTiles;
        const int64_t mTile = rem % mTiles;
        const int64_t b     = rem / mTiles;
        const int64_t m0 = mTile * bm;
        const int64_t n0 = nTile * bn;
        const int32_t mNow = (int32_t)(((M - m0) < bm) ? (M - m0) : bm);
        const int32_t nNow = (int32_t)(((N - n0) < bn) ? (N - n0) : bn);
        GlobalTensor<IN_T> aB = ag[static_cast<uint64_t>(b) * (uint64_t)M * (uint64_t)K];
        GlobalTensor<IN_T> bB = bg[static_cast<uint64_t>(b) * (uint64_t)K * (uint64_t)N];
        mm.SetOrgShape(m, n, k);
        mm.SetSingleShape(bm, bn, k);
        mm.SetTail(mNow, nNow, k);
        const uint64_t aOff = TX1 ? static_cast<uint64_t>(m0)
                                  : static_cast<uint64_t>(m0) * (uint64_t)K;
        const uint64_t bOff = TX2 ? static_cast<uint64_t>(n0) * (uint64_t)K
                                  : static_cast<uint64_t>(n0);
        mm.SetTensorA(aB[aOff], TX1);
        mm.SetTensorB(bB[bOff], TX2);
        GlobalTensor<float> cTile =
            cg[(static_cast<uint64_t>(b) * (uint64_t)M * (uint64_t)N) +
               (static_cast<uint64_t>(m0) * (uint64_t)N) + static_cast<uint64_t>(n0)];
        while (mm.Iterate()) {
            mm.GetTensorC(cTile, 0, false);
        }
    }
    mm.End();
}
template <typename IN_T, bool TX1, bool TX2>
__aicore__ inline void BmmsCubeBmmSplit(
    GM_ADDR ga, GM_ADDR gb, GM_ADDR gc,
    int64_t B, int64_t M, int64_t N, int64_t K,
    int64_t baseM, int64_t baseN, int64_t kSplit)
{
    using AType = MatmulType<TPosition::GM, CubeFormat::ND, IN_T, false>;
    using BType = MatmulType<TPosition::GM, CubeFormat::ND, IN_T, false>;
    using CType = MatmulType<TPosition::GM, CubeFormat::ND, float, false>;
    using BiasType = MatmulType<TPosition::GM, CubeFormat::ND, float, false>;
    MatmulImpl<AType, BType, CType, BiasType, CFG_NORM> mm;
    const int32_t m = (int32_t)M, n = (int32_t)N, k = (int32_t)K;
    const int32_t bm = (int32_t)baseM, bn = (int32_t)baseN;
    TCubeTiling t;
    t.usedCoreNum = 1;
    t.M = m; t.N = n; t.Ka = k; t.Kb = k;
    t.singleCoreM = bm; t.singleCoreN = bn; t.singleCoreK = k;
    t.baseM = bm; t.baseN = bn;
    { const bool tallKSmall = (M <= 64 && N <= 64 && K >= 2048 && (K % 256) == 0);
      t.baseK = tallKSmall ? 256 : 128; }
    t.depthA1 = 2; t.depthB1 = 2;
    t.stepM = 1; t.stepN = 1;
    t.isBias = 0; t.transLength = 0; t.iterateOrder = 0;
    t.shareMode = 0; t.shareL1Size = 0; t.shareL0CSize = 0; t.shareUbSize = 0;
    t.batchM = 0; t.batchN = 0; t.singleBatchM = 0; t.singleBatchN = 0;
    t.stepKa = 1; t.stepKb = 1;
    t.depthAL1CacheUB = 0; t.depthBL1CacheUB = 0;
    t.dbL0A = 1; t.dbL0B = 1; t.dbL0C = 1;
    GlobalTensor<IN_T>  ag; ag.SetGlobalBuffer((__gm__ IN_T*)ga);
    GlobalTensor<IN_T>  bg; bg.SetGlobalBuffer((__gm__ IN_T*)gb);
    GlobalTensor<float> cg; cg.SetGlobalBuffer((__gm__ float*)gc);
    TPipe pipe;
    mm.SetSubBlockIdx(0);
    mm.Init(&t, &pipe);
    const int64_t mTiles = (M + bm - 1) / bm;
    const int64_t nTiles = (N + bn - 1) / bn;
    const int64_t items  = B * mTiles * nTiles;
    const int64_t core   = (int64_t)GetBlockIdx();
    const int64_t nCores = (int64_t)GetBlockNum();
    const int64_t total  = items * kSplit;
    const int32_t kl     = (int32_t)((int64_t)k / kSplit);
    for (int64_t w = core; w < total; w += nCores) {
        const int64_t kIdx  = w / items;
        const int64_t it    = w % items;
        const int64_t nTile = it % nTiles;
        const int64_t rem   = it / nTiles;
        const int64_t mTile = rem % mTiles;
        const int64_t b     = rem / mTiles;
        const int64_t m0 = mTile * bm;
        const int64_t n0 = nTile * bn;
        const int64_t k0 = static_cast<int64_t>(kIdx) * static_cast<int64_t>(kl);
        const int32_t mNow = (int32_t)(((M - m0) < bm) ? (M - m0) : bm);
        const int32_t nNow = (int32_t)(((N - n0) < bn) ? (N - n0) : bn);
        GlobalTensor<IN_T> aB = ag[static_cast<uint64_t>(b) * (uint64_t)M * (uint64_t)K];
        GlobalTensor<IN_T> bB = bg[static_cast<uint64_t>(b) * (uint64_t)K * (uint64_t)N];
        mm.SetOrgShape(m, n, k);
        mm.SetSingleShape(bm, bn, kl);
        mm.SetTail(mNow, nNow, kl);
        const uint64_t aOff = (TX1 ? static_cast<uint64_t>(m0)
                                   : static_cast<uint64_t>(m0) * (uint64_t)K)
                            + (TX1 ? static_cast<uint64_t>(k0) * (uint64_t)M
                                   : static_cast<uint64_t>(k0));
        const uint64_t bOff = (TX2 ? static_cast<uint64_t>(n0) * (uint64_t)K
                                   : static_cast<uint64_t>(n0))
                            + (TX2 ? static_cast<uint64_t>(k0)
                                   : static_cast<uint64_t>(k0) * (uint64_t)N);
        mm.SetTensorA(aB[aOff], TX1);
        mm.SetTensorB(bB[bOff], TX2);
        GlobalTensor<float> cTile =
            cg[((static_cast<uint64_t>(kIdx)*B+b) * (uint64_t)M * (uint64_t)N) +
               (static_cast<uint64_t>(m0) * (uint64_t)N) + static_cast<uint64_t>(n0)];
        while (mm.Iterate()) {
            mm.GetTensorC(cTile, 0, false);
        }
    }
    mm.End();
}
template <typename IN_T, bool TX1, bool TX2>
__aicore__ inline void BmmsTransBulk(
    GM_ADDR ga, GM_ADDR gb, GM_ADDR gc,
    int64_t B, int64_t M, int64_t N, int64_t K,
    int64_t baseM, int64_t baseN)
{
    using AType = MatmulType<TPosition::GM, CubeFormat::ND, IN_T, false>;
    using BType = MatmulType<TPosition::GM, CubeFormat::ND, IN_T, false>;
    using CType = MatmulType<TPosition::GM, CubeFormat::ND, float, false>;
    using BiasType = MatmulType<TPosition::GM, CubeFormat::ND, float, false>;
    MatmulImpl<AType, BType, CType, BiasType, CFG_MDL> mm;
    const int32_t m = (int32_t)M, n = (int32_t)N, k = (int32_t)K;
    const int32_t bm = (int32_t)baseM, bn = (int32_t)baseN;
    TCubeTiling t;
    t.usedCoreNum = 1;
    t.M = m; t.N = n; t.Ka = k; t.Kb = k;
    t.singleCoreM = bm; t.singleCoreN = bn; t.singleCoreK = k;
    t.baseM = bm; t.baseN = bn;
    { const bool tallKSmall = (M <= 64 && N <= 64 && K >= 2048 && (K % 256) == 0);
      t.baseK = tallKSmall ? 256 : 128; }
    t.depthA1 = 2; t.depthB1 = 2;
    t.stepM = 1; t.stepN = 1;
    t.isBias = 0; t.transLength = 0; t.iterateOrder = 0;
    t.shareMode = 0; t.shareL1Size = 0; t.shareL0CSize = 0; t.shareUbSize = 0;
    t.batchM = 0; t.batchN = 0; t.singleBatchM = 0; t.singleBatchN = 0;
    t.stepKa = 1; t.stepKb = 1;
    t.depthAL1CacheUB = 0; t.depthBL1CacheUB = 0;
    t.dbL0A = 1; t.dbL0B = 1; t.dbL0C = 1;
    if (TX1 && M >= 128 && N >= 128 && K >= 512 && M % 128 == 0 && K % 128 == 0) { t.baseK = 64; t.dbL0A = 2; t.dbL0B = 2; }
    t.stepKa=4;t.stepKb=4;t.depthA1=8;t.depthB1=8;
    GlobalTensor<IN_T>  ag; ag.SetGlobalBuffer((__gm__ IN_T*)ga);
    GlobalTensor<IN_T>  bg; bg.SetGlobalBuffer((__gm__ IN_T*)gb);
    GlobalTensor<float> cg; cg.SetGlobalBuffer((__gm__ float*)gc);
    TPipe pipe;
    mm.SetSubBlockIdx(0);
    mm.Init(&t, &pipe);
    const int64_t mTiles = (M + bm - 1) / bm;
    const int64_t nTiles = (N + bn - 1) / bn;
    const int64_t items  = B * mTiles * nTiles;
    const int64_t core   = (int64_t)GetBlockIdx();
    const int64_t nCores = (int64_t)GetBlockNum();
    const bool mapExp = (!TX1) && (M >= 1024) && (N >= 1024) && (K >= 512);
    int64_t wFirst = core;
    int64_t wLimit = items;
    int64_t wStep  = nCores;
    if (mapExp) {
        const int64_t q  = items / nCores;
        const int64_t rr = items - q * nCores;
        const int64_t lead = (core < rr) ? core : rr;
        wFirst = core * q + lead;
        wLimit = wFirst + q + ((core < rr) ? 1 : 0);
        wStep  = 1;
    }
    for (int64_t w = wFirst; w < wLimit; w += wStep) {
        const int64_t nTile = w % nTiles;
        const int64_t rem   = w / nTiles;
        const int64_t mTile = rem % mTiles;
        const int64_t b     = rem / mTiles;
        const int64_t m0 = mTile * bm;
        const int64_t n0 = nTile * bn;
        const int32_t mNow = (int32_t)(((M - m0) < bm) ? (M - m0) : bm);
        const int32_t nNow = (int32_t)(((N - n0) < bn) ? (N - n0) : bn);
        GlobalTensor<IN_T> aB = ag[static_cast<uint64_t>(b) * (uint64_t)M * (uint64_t)K];
        GlobalTensor<IN_T> bB = bg[static_cast<uint64_t>(b) * (uint64_t)K * (uint64_t)N];
        mm.SetOrgShape(m, n, k);
        mm.SetSingleShape(bm, bn, k);
        mm.SetTail(mNow, nNow, k);
        const uint64_t aOff = TX1 ? static_cast<uint64_t>(m0)
                                  : static_cast<uint64_t>(m0) * (uint64_t)K;
        const uint64_t bOff = TX2 ? static_cast<uint64_t>(n0) * (uint64_t)K
                                  : static_cast<uint64_t>(n0);
        mm.SetTensorA(aB[aOff], TX1);
        mm.SetTensorB(bB[bOff], TX2);
        GlobalTensor<float> cTile =
            cg[(static_cast<uint64_t>(b) * (uint64_t)M * (uint64_t)N) +
               (static_cast<uint64_t>(m0) * (uint64_t)N) + static_cast<uint64_t>(n0)];
        while (mm.Iterate()) {
            mm.GetTensorC(cTile, 0, false);
        }
    }
    mm.End();
}
template <typename IN_T, bool TX1, bool TX2>
__aicore__ inline void BmmsCubeCachedN(
    GM_ADDR ga, GM_ADDR gb, GM_ADDR gc,
    int64_t B, int64_t M, int64_t N, int64_t K,
    int64_t baseM, int64_t baseN)
{
    using AType = MatmulType<TPosition::GM, CubeFormat::ND, IN_T, false>;
    using BType = MatmulType<TPosition::GM, CubeFormat::ND, IN_T, false>;
    using CType = MatmulType<TPosition::GM, CubeFormat::ND, float, false>;
    using BiasType = MatmulType<TPosition::GM, CubeFormat::ND, float, false>;
    MatmulImpl<AType, BType, CType, BiasType, CFG_MDL> mm;
    const int32_t m = (int32_t)M, n = (int32_t)N, k = (int32_t)K;
    const int32_t bm = 128, bn = 128, sn = (int32_t)N;
    TCubeTiling t;
    t.usedCoreNum = 1;
    t.M = m; t.N = n; t.Ka = k; t.Kb = k;
    t.singleCoreM = bm; t.singleCoreN = sn; t.singleCoreK = k;
    t.baseM = bm; t.baseN = bn;
    { const bool tallKSmall = (M <= 64 && N <= 64 && K >= 2048 && (K % 256) == 0);
      t.baseK = tallKSmall ? 256 : 128; }
    t.depthA1 = 2; t.depthB1 = 2;
    t.stepM = 1; t.stepN = 1;
    t.isBias = 0; t.transLength = 0; t.iterateOrder = 0;
    t.shareMode = 0; t.shareL1Size = 0; t.shareL0CSize = 0; t.shareUbSize = 0;
    t.batchM = 0; t.batchN = 0; t.singleBatchM = 0; t.singleBatchN = 0;
    t.stepKa = 1; t.stepKb = 1;
    t.depthAL1CacheUB = 0; t.depthBL1CacheUB = 0;
    t.dbL0A = 1; t.dbL0B = 1; t.dbL0C = 1;
    if (TX1 && M >= 128 && N >= 128 && K >= 512 && M % 128 == 0 && K % 128 == 0) { t.baseK = 64; t.dbL0A = 2; t.dbL0B = 2; }
    t.baseK=128; t.stepKa=k/128; t.stepKb=1; t.depthA1=t.stepKa; t.depthB1=2;
    t.dbL0A=2; t.dbL0B=2; t.dbL0C=2;
    GlobalTensor<IN_T>  ag; ag.SetGlobalBuffer((__gm__ IN_T*)ga);
    GlobalTensor<IN_T>  bg; bg.SetGlobalBuffer((__gm__ IN_T*)gb);
    GlobalTensor<float> cg; cg.SetGlobalBuffer((__gm__ float*)gc);
    TPipe pipe;
    mm.SetSubBlockIdx(0);
    mm.Init(&t, &pipe);
    const int64_t mTiles = (M + bm - 1) / bm;
    const int64_t nTiles = (N + bn - 1) / bn;
    const int64_t items  = B * mTiles * nTiles;
    const int64_t core   = (int64_t)GetBlockIdx();
    const int64_t nCores = (int64_t)GetBlockNum();
    const bool mapExp = (!TX1) && (M >= 1024) && (N >= 1024) && (K >= 512);
    int64_t wFirst = core;
    int64_t wLimit = items;
    int64_t wStep  = nCores;
    if (mapExp) {
        const int64_t q  = items / nCores;
        const int64_t rr = items - q * nCores;
        const int64_t lead = (core < rr) ? core : rr;
        wFirst = core * q + lead;
        wLimit = wFirst + q + ((core < rr) ? 1 : 0);
        wStep  = 1;
    }
    for (int64_t w = wFirst; w < wLimit;) {
        const int64_t nTile = w % nTiles;
        const int64_t rem   = w / nTiles;
        const int64_t mTile = rem % mTiles;
        const int64_t b     = rem / mTiles;
        const int64_t m0 = mTile * bm;
        const int64_t n0 = nTile * bn;
        int64_t run = nTiles-nTile;
        if (run>wLimit-w) run=wLimit-w;
        const int32_t groupN=(int32_t)(run*bn);
        const int32_t mNow = (int32_t)(((M - m0) < bm) ? (M - m0) : bm);
        const int32_t nNow = (int32_t)(((N - n0) < groupN) ? (N - n0) : groupN);
        GlobalTensor<IN_T> aB = ag[static_cast<uint64_t>(b) * (uint64_t)M * (uint64_t)K];
        GlobalTensor<IN_T> bB = bg[static_cast<uint64_t>(b) * (uint64_t)K * (uint64_t)N];
        mm.SetOrgShape(m, n, k);
        mm.SetSingleShape(bm, groupN, k);
        mm.SetTail(mNow, nNow, k);
        const uint64_t aOff = TX1 ? static_cast<uint64_t>(m0)
                                  : static_cast<uint64_t>(m0) * (uint64_t)K;
        const uint64_t bOff = TX2 ? static_cast<uint64_t>(n0) * (uint64_t)K
                                  : static_cast<uint64_t>(n0);
        mm.SetTensorA(aB[aOff], TX1);
        mm.SetTensorB(bB[bOff], TX2);
        GlobalTensor<float> cTile =
            cg[(static_cast<uint64_t>(b) * (uint64_t)M * (uint64_t)N) +
               (static_cast<uint64_t>(m0) * (uint64_t)N) + static_cast<uint64_t>(n0)];
        while (mm.Iterate()) {
            mm.GetTensorC(cTile, 0, false);
        }
        w += run;
    }
    mm.End();
}
template<class T,bool TX1,bool TX2>
__aicore__ inline void BmmsPairedSmall(GM_ADDR ga,GM_ADDR gb,GM_ADDR gc,int64_t B,int64_t M,int64_t N,int64_t K) {
 GlobalTensor<T> ag,bg;GlobalTensor<float> cg;ag.SetGlobalBuffer((__gm__ T*)ga);bg.SetGlobalBuffer((__gm__ T*)gb);cg.SetGlobalBuffer((__gm__ float*)gc);
 TPipe pipe;TBuf<TPosition::A1> a1b;TBuf<TPosition::A2> a2b;TBuf<TPosition::B1> b1b;TBuf<TPosition::B2> b2b;TBuf<TPosition::CO1> cb;
 pipe.InitBuffer(a1b,32*256*2);pipe.InitBuffer(a2b,32*256*2);pipe.InitBuffer(b1b,128*256*2);pipe.InitBuffer(b2b,128*256*2);pipe.InitBuffer(cb,32*128*4);
 auto a1=a1b.template Get<T>();auto a2=a2b.template Get<T>();auto b1=b1b.template Get<T>();auto b2=b2b.template Get<T>();auto c=cb.template Get<float>();
 int mp=((int)M+15)&~15,np=((int)N+15)&~15,kp=(int)K; int cs=np;
 for(int64_t batch=GetBlockIdx();batch<B;batch+=GetBlockNum()) {
  Nd2NzParams acp{1,(uint16_t)(TX1?K:M),(uint16_t)(TX1?M:K),0,(uint16_t)(TX1?M:K),(uint16_t)(TX1?kp:mp),1,0};
  Nd2NzParams bcp{1,(uint16_t)(TX2?N:K),(uint16_t)(TX2?K:N),0,(uint16_t)(TX2?K:N),(uint16_t)(TX2?np:kp),1,0};
  DataCopy(a1,ag[batch*M*K],acp);DataCopy(b1,bg[batch*K*N],bcp);
  SetFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);WaitFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);
  if constexpr(TX1) {
   LoadData2dTransposeParams p{0,(uint8_t)(kp/16),1,0,(uint16_t)(kp/16-1),0};
   for(int mi=0;mi<mp/16;mi++)LoadDataWithTranspose(a2[mi*kp*16],a1[mi*kp*16],p);
  } else {
   LoadData2DParams p{0,(uint8_t)(kp/16),(uint16_t)(mp/16),0,0,false,0};
   for(int mi=0;mi<mp/16;mi++)LoadData(a2[mi*kp*16],a1[mi*256],p);
  }
  if constexpr(TX2) {LoadData2DParams p{0,(uint8_t)(kp*np/256),1,0,0,false,0};LoadData(b2,b1,p);}
  else {
   if (np < kp && np >= 64) {
    LoadData2dTransposeParams p{0,(uint8_t)(kp/16),1,(uint16_t)(np/16-1),0,0};
    for(int ni=0;ni<np/16;ni++)LoadDataWithTranspose(b2[ni*256],b1[ni*kp*16],p);
   } else {
    LoadData2dTransposeParams p{0,(uint8_t)(np/16),(uint16_t)(kp/16),0,0,0};
    for(int ki=0;ki<kp/16;ki++)LoadDataWithTranspose(b2[ki*np*16],b1[ki*256],p);
   }
  }
  SetFlag<HardEvent::MTE1_M>(EVENT_ID0);WaitFlag<HardEvent::MTE1_M>(EVENT_ID0);
  MmadParams mm;mm.m=mp;mm.n=np;mm.k=kp;mm.cmatrixInitVal=true;mm.cmatrixSource=false;Mmad(c,a2,b2,mm);
  SetFlag<HardEvent::M_FIX>(EVENT_ID0);WaitFlag<HardEvent::M_FIX>(EVENT_ID0);
  FixpipeParamsV220 fp;fp.mSize=M;fp.nSize=np;fp.srcStride=mp;fp.dstStride=cs;fp.ndNum=1;fp.srcNdStride=0;fp.dstNdStride=0;fp.reluEn=false;
  Fixpipe<float,float,CFG_ROW_MAJOR>(cg[batch*M*cs],c,fp);
  CrossCoreSetFlag<2,PIPE_FIX>(8);
  SetFlag<HardEvent::FIX_MTE2>(EVENT_ID0);WaitFlag<HardEvent::FIX_MTE2>(EVENT_ID0);
 }
}
__aicore__ inline void BatchedMaxRows(GM_ADDR gc,GM_ADDR gy,GM_ADDR gpartial,int64_t B,int64_t M,int64_t N,int64_t ncores,int64_t cPitch=0) {
 if(cPitch==0)cPitch=N;
 GlobalTensor<float> cg,yg,pg;cg.SetGlobalBuffer((__gm__ float*)gc);yg.SetGlobalBuffer((__gm__ float*)gy);pg.SetGlobalBuffer((__gm__ float*)gpartial);
 constexpr int BUDGET=32768;
 TPipe pipe;TBuf<TPosition::VECCALC> tb;pipe.InitBuffer(tb,196608);
 auto tile=tb.Get<float>();auto compressed=tile[BUDGET];auto rowmax=compressed[BUDGET/8];auto rowmax2=rowmax[256];auto scratch=rowmax2[256];auto group=scratch[8192];auto accum=group[8];auto final=accum[8];
 int np=((int)N+63)&~63;int capacity=BUDGET/np;if(capacity>256)capacity=256;
 int64_t core=GetBlockIdx();
 int64_t total=B*M;int64_t per=(total+ncores-1)/ncores;
 int64_t rounds=1;
 for(int64_t iter=0;iter<rounds;iter++) {
  int64_t begin=core*per;
  int64_t end=begin+per<total?begin+per:total;
  Duplicate(accum,0.0f,8);
  for(int64_t r0=begin;r0<end;r0+=capacity) {
   int rows=(int)((end-r0<capacity)?end-r0:capacity);int count=rows*np;
   if(np!=N) Duplicate(tile,-3.402823466e+38F,count);
   SetFlag<HardEvent::V_MTE2>(EVENT_ID0);WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
   if(np==N && cPitch==N) DataCopy(tile,cg[r0*cPitch],count);
   else {
    int aligned=((int)N+7)&~7;
    DataCopyExtParams cp{(uint16_t)rows,(uint32_t)(N*4),(uint32_t)((cPitch-N)*4),(uint32_t)((np-aligned)/8),0};
    DataCopyPadExtParams<float> pad{true,0,(uint8_t)(aligned-N),-3.402823466e+38F};
    DataCopyPad(tile,cg[r0*cPitch],cp,pad);
   }
   SetFlag<HardEvent::MTE2_V>(EVENT_ID0);WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
   if(N<=128) {
    int rc=2048/np;
    for(int j=0;j<rows;j+=rc) {
     int nr=(rows-j<rc)?rows-j:rc;
     WholeReduceMax(rowmax[j],tile[j*np],(uint64_t)(N<64?N:64),(uint8_t)nr,1,1,np/8,ReduceOrder::ORDER_ONLY_VALUE);
     if(N>64) {
      WholeReduceMax(rowmax2[j],tile[j*np+64],(uint64_t)(N-64),(uint8_t)nr,1,1,np/8,ReduceOrder::ORDER_ONLY_VALUE);
     }
    }
    if(N>64)Max(rowmax,rowmax,rowmax2,rows);
   } else {
    for(int off=0;off<count;off+=2048) {
     int len=(count-off<2048)?count-off:2048;
     BlockReduceMax(compressed[off/8],tile[off],(uint8_t)(len/64),64,1,1,8);
    }
    PipeBarrier<PIPE_V>();
    const int width=np/8;
    WholeReduceMax(rowmax,compressed,(uint64_t)(width<64?width:64),(uint8_t)rows,1,1,np/64,ReduceOrder::ORDER_ONLY_VALUE);
    for(int off=64;off<width;off+=64) {
     const int mask=width-off<64?width-off:64;
     WholeReduceMax(rowmax2,compressed[off],(uint64_t)mask,(uint8_t)rows,1,1,np/64,ReduceOrder::ORDER_ONLY_VALUE);
     Max(rowmax,rowmax,rowmax2,rows);
    }
   }
   SetFlag<HardEvent::V_MTE3>(EVENT_ID0);WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);DataCopyExtParams rc{1,(uint32_t)(rows*4),0,0,0};DataCopyPad(pg[r0],rowmax,rc);SetFlag<HardEvent::MTE3_V>(EVENT_ID0);WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
  }
 }
 CrossCoreSetFlag<0,PIPE_MTE3>(10);CrossCoreWaitFlag<0,PIPE_MTE2>(10);
 for(int64_t b=core;b<B;b+=ncores) {
  DataCopyExtParams cp{1,(uint32_t)(M*4),0,0,0};DataCopyPadExtParams<float> pad{false,0,0,0};DataCopyPad(tile,pg[b*M],cp,pad);
  SetFlag<HardEvent::MTE2_V>(EVENT_ID0);WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);ReduceSum(final,tile,scratch,(int32_t)M);
  SetFlag<HardEvent::V_MTE3>(EVENT_ID0);WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);DataCopyExtParams out{1,4,0,0,0};DataCopyPad(yg[b],final,out);
  SetFlag<HardEvent::MTE3_V>(EVENT_ID0);WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
 }
}

__aicore__ inline void SplitBatchReduce(GM_ADDR gc,GM_ADDR gy,int64_t B,int64_t M,int64_t N,int64_t slices,int64_t vcores){
 GlobalTensor<float> cg,yg;cg.SetGlobalBuffer((__gm__ float*)gc);yg.SetGlobalBuffer((__gm__ float*)gy);
 TPipe pipe;TBuf<TPosition::VECCALC> storage;pipe.InitBuffer(storage,147456);auto tile=storage.Get<float>();auto second=tile[16384];auto rows=second[16384];auto rows2=rows[128];auto scratch=rows2[128];auto out=scratch[2048];
 const int pitch=(N+63)&~63,aligned=(N+7)&~7,count=M*pitch;
 for(int64_t batch=GetBlockIdx();batch<B;batch+=vcores){
  Duplicate(tile,0.0f,count);
  DataCopyExtParams cp{(uint16_t)M,(uint32_t)(N*4),0,(uint32_t)((pitch-aligned)/8),0};DataCopyPadExtParams<float> pad{true,0,(uint8_t)(aligned-N),0.0f};
  for(int64_t s=0;s<slices;s++){
   Duplicate(second,0.0f,count);SetFlag<HardEvent::V_MTE2>(EVENT_ID0);WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);DataCopyPad(second,cg[(s*B+batch)*M*N],cp,pad);SetFlag<HardEvent::MTE2_V>(EVENT_ID0);WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);Add(tile,tile,second,count);
  }
  int capacity=2048/pitch;for(int j=0;j<M;j+=capacity){int r=M-j<capacity?M-j:capacity;WholeReduceMax(rows[j],tile[j*pitch],(uint64_t)(N<64?N:64),(uint8_t)r,1,1,pitch/8,ReduceOrder::ORDER_ONLY_VALUE);if(N>64)WholeReduceMax(rows2[j],tile[j*pitch+64],(uint64_t)(N-64),(uint8_t)r,1,1,pitch/8,ReduceOrder::ORDER_ONLY_VALUE);}
  if(N>64)Max(rows,rows,rows2,(int32_t)M);ReduceSum(out,rows,scratch,(int32_t)M);SetFlag<HardEvent::V_MTE3>(EVENT_ID0);WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);DataCopyExtParams cpout{1,4,0,0,0};DataCopyPad(yg[batch],out,cpout);SetFlag<HardEvent::MTE3_V>(EVENT_ID0);WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
 }
}

// FP32 row maxima are written once by their owner. K slices are added in
// increasing slice order before max, and rows are summed in a fixed order.
__aicore__ inline void ReduceBmm(GM_ADDR gc,GM_ADDR gr,GM_ADDR gy,int64_t B,int64_t M,int64_t N,int64_t slices) {
 GlobalTensor<float> cg,rg,yg;cg.SetGlobalBuffer((__gm__ float*)gc);rg.SetGlobalBuffer((__gm__ float*)gr);yg.SetGlobalBuffer((__gm__ float*)gy);
 TPipe pipe;TBuf<TPosition::VECCALC> storage;pipe.InitBuffer(storage,102400);
 auto values=storage.Get<float>();auto partial=values[8192];auto scratch=partial[8192];auto maximum=scratch[8192];auto result=maximum[8];
 const int64_t cores=GetBlockNum()*2,core=GetBlockIdx();
 DataCopyExtParams cp{1,(uint32_t)(N*4),0,0,0};DataCopyPadExtParams<float> pad{false,0,0,0.0f};
 for(int64_t r=core;r<B*M;r+=cores) {
  DataCopyPad(values,cg[r*N],cp,pad);
  SetFlag<HardEvent::MTE2_V>(EVENT_ID0);WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
  for(int64_t s=1;s<slices;s++) {
   DataCopyPad(partial,cg[(s*B*M+r)*N],cp,pad);
   SetFlag<HardEvent::MTE2_V>(EVENT_ID0);WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
   Add(values,values,partial,(int32_t)N);
   SetFlag<HardEvent::V_MTE2>(EVENT_ID0);WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
  }
  ReduceMax(maximum,values,scratch,(int32_t)N);
  SetFlag<HardEvent::V_MTE3>(EVENT_ID0);WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
  DataCopyExtParams out{1,4,0,0,0};DataCopyPad(rg[r],maximum,out);
  SetFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);WaitFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);
 }
 // Public hardware flags avoid a custom runtime/system-workspace override.
 CrossCoreSetFlag<0,PIPE_MTE3>(10);CrossCoreWaitFlag<0,PIPE_MTE2>(10);
 for(int64_t batch=core;batch<B;batch+=cores) {
  DataCopyExtParams rows{1,(uint32_t)(M*4),0,0,0};DataCopyPad(values,rg[batch*M],rows,pad);
  SetFlag<HardEvent::MTE2_V>(EVENT_ID0);WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
  ReduceSum(result,values,scratch,(int32_t)M);
  SetFlag<HardEvent::V_MTE3>(EVENT_ID0);WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
  DataCopyExtParams out{1,4,0,0,0};DataCopyPad(yg[batch],result,out);
  SetFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);WaitFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);
 }
}
template<typename T,bool TA,bool TB>
__aicore__ inline void FusedBmm(GM_ADDR ga,GM_ADDR gb,GM_ADDR gc,GM_ADDR gr,GM_ADDR gy,int64_t B,int64_t M,int64_t N,int64_t K,int64_t bm,int64_t bn,int64_t slices,bool serialBatch) {
 const int64_t count=serialBatch?B:1;
 for(int64_t iteration=0;iteration<count;iteration++) {
  const int64_t localB=serialBatch?1:B;
  const int64_t ab=serialBatch?iteration*M*K*2:0,bb=serialBatch?iteration*N*K*2:0,yb=serialBatch?iteration*4:0;
  if ASCEND_IS_AIC {
   if(slices>1)BmmsCubeBmmSplit<T,TA,TB>(ga+ab,gb+bb,gc,localB,M,N,K,bm,bn,slices);
   else if(TA && M>=128 && N>=128 && K>=512 && M%128==0 && N%128==0 && K%128==0)BmmsTransBulk<T,TA,TB>(ga+ab,gb+bb,gc,localB,M,N,K,bm,bn);else if(!TA && M>=1024 && N>=1024 && K>=512 && K%128==0 && 128*K*2+128*128*4<=512*1024)BmmsCubeCachedN<T,TA,TB>(ga+ab,gb+bb,gc,localB,M,N,K,bm,bn);else BmmsCubeBmm<T,TA,TB>(ga+ab,gb+bb,gc,localB,M,N,K,bm,bn);
   PipeBarrier<PIPE_ALL>();CrossCoreSetFlag<2,PIPE_FIX>(8);
   if(serialBatch)CrossCoreWaitFlag<2,PIPE_MTE2>(11);
  }
  if ASCEND_IS_AIV {
   CrossCoreWaitFlag<2,PIPE_MTE2>(8);
   CrossCoreSetFlag<0,PIPE_MTE3>(9);CrossCoreWaitFlag<0,PIPE_MTE2>(9);
   if(slices>1 && M*N<=8192)SplitBatchReduce(gc,gy+yb,localB,M,N,slices,(int64_t)GetBlockNum()*2);else if(slices>1)ReduceBmm(gc,gr,gy+yb,localB,M,N,slices);else BatchedMaxRows(gc,gy+yb,gr,localB,M,N,(int64_t)GetBlockNum()*2);
   if(serialBatch){CrossCoreSetFlag<0,PIPE_MTE3>(12);CrossCoreWaitFlag<0,PIPE_MTE2>(12);CrossCoreSetFlag<2,PIPE_MTE3>(11);}
  }
 }
}
