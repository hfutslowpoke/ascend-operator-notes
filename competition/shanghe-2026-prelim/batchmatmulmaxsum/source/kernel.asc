  CrossCoreWaitFlag<2,PIPE_MTE2>(8);if(grouped)CrossCoreSetFlag<2,PIPE_MTE2>(7);
  if(rows>0) {
   const int allRows=rows;
   int np=(nNow+63)&~63,al=(nNow+7)&~7,capacity=40960/np;if(capacity>(grouped?128:64))capacity=grouped?128:64;
   for(int r=0;r<allRows;r+=capacity){rows=allRows-r<capacity?allRows-r:capacity;int count=rows*np;
   if(np!=nNow)Duplicate(tile,-3.402823466e+38F,count);
   SetFlag<HardEvent::V_MTE2>(EVENT_ID0);WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
   DataCopyExtParams cp{(uint16_t)rows,(uint32_t)(nNow*4),(uint32_t)((Cp-nNow)*4),(uint32_t)((np-al)/8),0};DataCopyPadExtParams<float> pad{true,0,(uint8_t)(al-nNow),-3.402823466e+38F};
   DataCopyPad(tile,cg[(batch*M+m0+r)*Cp+n0],cp,pad);
   SetFlag<HardEvent::MTE2_V>(EVENT_ID0);WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
   const int reduceChunk=grouped?2048:16320;for(int off=0;off<count;off+=reduceChunk){int len=count-off<reduceChunk?count-off:reduceChunk;BlockReduceMax(comp[off/8],tile[off],len/64,64,1,1,8);}
   PipeBarrier<PIPE_V>();
   int width=np/8;WholeReduceMax(row,comp,width<64?width:64,rows,1,1,np/64,ReduceOrder::ORDER_ONLY_VALUE);
   for(int off=64;off<width;off+=64){WholeReduceMax(row2,comp[off],width-off<64?width-off:64,rows,1,1,np/64,ReduceOrder::ORDER_ONLY_VALUE);Max(row,row,row2,rows);}
   SetFlag<HardEvent::V_MTE3>(EVENT_ID0);WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
   DataCopyExtParams co{1,(uint32_t)(rows*4),0,0,0};DataCopyPad(pg[w*bm+sub*(bm/2)+r],row,co);
   SetFlag<HardEvent::MTE3_V>(EVENT_ID0);WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
   }
  }
  w+=run;
 }
 CrossCoreSetFlag<0,PIPE_MTE3>(9);CrossCoreWaitFlag<0,PIPE_MTE2>(9);
 if(!grouped && bm==256 && M<=2048 && nt>=8){BulkFinalRowMaxSum(gp,gy,B,M,N,bm,tile,comp,scratch,out);return;}


 const int64_t vcores=nc*2;
 for(int64_t vi=GetBlockIdx();vi<B*mt*2;vi+=vcores){
  int64_t mi=(vi/2)%mt,part=vi%2,batch=vi/(mt*2);int rows=M-mi*bm-part*(bm/2)<bm/2?M-mi*bm-part*(bm/2):bm/2;Duplicate(out,0.0f,8);
  if(rows>0){
   Duplicate(acc,-3.402823466e+38F,128);
   for(int64_t w=(batch*mt+mi)*nt;w<(batch*mt+mi+1)*nt;){
    int64_t co=(w<(q+1)*rr)?w/(q+1):rr+(w-(q+1)*rr)/q,end=co*q+(co<rr?co:rr)+q+(co<rr);
    DataCopyExtParams cp{1,(uint32_t)(rows*4),0,0,0};DataCopyPadExtParams<float> pad{false,0,0,0};SetFlag<HardEvent::V_MTE2>(EVENT_ID0);WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);DataCopyPad(row,pg[w*bm+part*(bm/2)],cp,pad);SetFlag<HardEvent::MTE2_V>(EVENT_ID0);WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);Max(acc,acc,row,rows);
    if(grouped && end>w+2)end=w+2;w=end<(batch*mt+mi+1)*nt?end:(batch*mt+mi+1)*nt;
   }
   ReduceSum(out,acc,scratch,rows);
  }
  SetFlag<HardEvent::V_MTE3>(EVENT_ID0);WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);DataCopyExtParams cp{1,4,0,0,0};DataCopyPad(rg[vi],out,cp);SetFlag<HardEvent::MTE3_V>(EVENT_ID0);WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
 }
 CrossCoreSetFlag<0,PIPE_MTE3>(10);CrossCoreWaitFlag<0,PIPE_MTE2>(10);
 for(int64_t batch=GetBlockIdx();batch<B;batch+=nc*2){
  DataCopyExtParams cp{1,(uint32_t)(mt*2*4),0,0,0};DataCopyPadExtParams<float> pad{false,0,0,0};DataCopyPad(tile,rg[batch*mt*2],cp,pad);SetFlag<HardEvent::MTE2_V>(EVENT_ID0);WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
  ReduceSum(out,tile,scratch,(int32_t)(mt*2));SetFlag<HardEvent::V_MTE3>(EVENT_ID0);WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);DataCopyExtParams cpout{1,4,0,0,0};DataCopyPad(yg[batch],out,cpout);SetFlag<HardEvent::MTE3_V>(EVENT_ID0);WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
