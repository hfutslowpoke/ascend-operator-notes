 for(int64_t batch=GetBlockIdx();batch<B;batch+=nc*2){
  DataCopyExtParams cp{1,(uint32_t)(M*4),0,0,0};DataCopyPadExtParams<float> pad{false,0,0,0};DataCopyPad(tile,rg[batch*M],cp,pad);SetFlag<HardEvent::MTE2_V>(EVENT_ID0);WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
  ReduceSum(out,tile,scratch,(int32_t)M);SetFlag<HardEvent::V_MTE3>(EVENT_ID0);WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);DataCopyExtParams cpout{1,4,0,0,0};DataCopyPad(yg[batch],out,cpout);SetFlag<HardEvent::MTE3_V>(EVENT_ID0);WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
 }
}


#define PIPE_ENTRY(NAME,T,TA,TB) \
extern "C" __global__ __aicore__ void NAME(GM_ADDR a,GM_ADDR b,GM_ADDR c,GM_ADDR p,GM_ADDR r,GM_ADDR y,int64_t B,int64_t M,int64_t N,int64_t K,int64_t bm){KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);if ASCEND_IS_AIC {PipelinedCube<T,TA,TB>(a,b,c,B,M,N,K,bm,128);}if ASCEND_IS_AIV {if constexpr(TA){const int64_t nt=(N+127)/128,items=B*((M+bm-1)/bm)*nt;if(!TB && nt>4 && items/(int64_t)GetBlockNum()>4)PipelinedRunningMax(c,y,p,r,B,M,N,N,bm,true);else PipelinedVector(c,y,p,r,B,M,N,N,bm,TA&&!TB);}else PipelinedVectorRows(c,y,p,r,B,M,N,N,bm);}}
PIPE_ENTRY(pipe_h00,half,false,false)
PIPE_ENTRY(pipe_h01,half,false,true)
PIPE_ENTRY(pipe_h10,half,true,false)
PIPE_ENTRY(pipe_h11,half,true,true)
PIPE_ENTRY(pipe_b00,bfloat16_t,false,false)
PIPE_ENTRY(pipe_b01,bfloat16_t,false,true)
PIPE_ENTRY(pipe_b10,bfloat16_t,true,false)
PIPE_ENTRY(pipe_b11,bfloat16_t,true,true)

// Reuse a single pipe across both matrices and overlap DMA using disjoint banks.
__aicore__ inline void BmmsPadInputs(GM_ADDR ga,GM_ADDR gb,GM_ADDR gap,GM_ADDR gbp,int64_t B,int64_t M,int64_t N,int64_t K,int64_t mp,int64_t kp){
 GlobalTensor<uint16_t> ag,bg,apg,bpg;ag.SetGlobalBuffer((__gm__ uint16_t*)ga);bg.SetGlobalBuffer((__gm__ uint16_t*)gb);apg.SetGlobalBuffer((__gm__ uint16_t*)gap);bpg.SetGlobalBuffer((__gm__ uint16_t*)gbp);
 TPipe pipe;TBuf<TPosition::VECCALC> tb;pipe.InitBuffer(tb,131072);auto first=tb.Get<uint16_t>();auto second=first[32768];
 const int64_t core=GetBlockIdx(),nc=(int64_t)GetBlockNum()*2;int64_t jobs=0;
 for(int64_t batch=0;batch<B;batch++)for(int which=0;which<2;which++){
  const int64_t rows=which?N:K,cols=which?K:M,pr=which?N:kp,pc=which?kp:mp;
  auto src=which?bg[batch*N*K]:ag[batch*K*M];auto dst=which?bpg[batch*N*kp]:apg[batch*kp*mp];
  int64_t per=(pr+nc-1)/nc,end=(core+1)*per<pr?(core+1)*per:pr;
  int chunk=32768/pc;if(chunk>32)chunk=32;
  for(int64_t r0=core*per;r0<end;r0+=chunk,jobs++){
   const bool bank=jobs&1;auto tmp=bank?second:first;
   if(jobs>=2){
    if(bank){WaitFlag<HardEvent::MTE3_V>(EVENT_ID1);WaitFlag<HardEvent::MTE3_MTE2>(EVENT_ID1);}
    else{WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);WaitFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);}
   }
   int rn=end-r0<chunk?end-r0:chunk,valid=rows-r0<rn?rows-r0:rn;if(valid<0)valid=0;
   int aligned=((int)cols+15)&~15,gap=pc-aligned;
   if(gap>0 && valid>0){if(pc/16<=255)Duplicate(tmp[aligned],(uint16_t)0,(uint64_t)gap,(uint8_t)valid,1,(uint8_t)(pc/16));else for(int r=0;r<valid;r++)Duplicate(tmp[r*pc+aligned],(uint16_t)0,gap);}
   if(valid<rn)Duplicate(tmp[valid*pc],(uint16_t)0,(int32_t)((rn-valid)*pc));
   if(valid>0){
    DataCopyExtParams cp{(uint16_t)valid,(uint32_t)(cols*2),0,(uint32_t)((pc-aligned)/16),0};DataCopyPadExtParams<uint16_t> pad{true,0,(uint8_t)(aligned-cols),0};DataCopyPad(tmp,src[r0*cols],cp,pad);
    if(bank){SetFlag<HardEvent::MTE2_MTE3>(EVENT_ID1);WaitFlag<HardEvent::MTE2_MTE3>(EVENT_ID1);}else{SetFlag<HardEvent::MTE2_MTE3>(EVENT_ID0);WaitFlag<HardEvent::MTE2_MTE3>(EVENT_ID0);}
   }
   if(bank){SetFlag<HardEvent::V_MTE3>(EVENT_ID1);WaitFlag<HardEvent::V_MTE3>(EVENT_ID1);}else{SetFlag<HardEvent::V_MTE3>(EVENT_ID0);WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);}
   DataCopy(dst[r0*pc],tmp,(uint32_t)(rn*pc));
   if(bank){SetFlag<HardEvent::MTE3_V>(EVENT_ID1);SetFlag<HardEvent::MTE3_MTE2>(EVENT_ID1);}else{SetFlag<HardEvent::MTE3_V>(EVENT_ID0);SetFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);}
  }
 }
 if(jobs>0){WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);WaitFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);}
 if(jobs>1){WaitFlag<HardEvent::MTE3_V>(EVENT_ID1);WaitFlag<HardEvent::MTE3_MTE2>(EVENT_ID1);}
}
__aicore__ inline void BmmsPadMatrix(GM_ADDR input,GM_ADDR output,int64_t rows,int64_t cols,int64_t paddedRows,int64_t paddedCols) {
 GlobalTensor<uint16_t> src,dst;src.SetGlobalBuffer((__gm__ uint16_t*)input);dst.SetGlobalBuffer((__gm__ uint16_t*)output);
 TPipe pipe;TBuf<TPosition::VECCALC> tb;pipe.InitBuffer(tb,32*2048*2);
 auto tmp=tb.Get<uint16_t>();int64_t core=GetBlockIdx(),nc=(int64_t)GetBlockNum()*2;
 int64_t per=(paddedRows+nc-1)/nc,end=((core+1)*per<paddedRows)?(core+1)*per:paddedRows;
 int chunk=32768/paddedCols;if(chunk>32)chunk=32;
 for(int64_t r0=core*per;r0<end;r0+=chunk){
  int rn=end-r0<chunk?end-r0:chunk;
  Duplicate(tmp,(uint16_t)0,(int32_t)(rn*paddedCols));
  SetFlag<HardEvent::V_MTE2>(EVENT_ID0);WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
  int valid=(rows-r0<rn)?rows-r0:rn;
  if(valid>0) {
   int aligned=((int)cols+15)&~15;
   DataCopyExtParams cp{(uint16_t)valid,(uint32_t)(cols*2),0,(uint32_t)((paddedCols-aligned)/16),0};
   DataCopyPadExtParams<uint16_t> pad{true,0,(uint8_t)(aligned-cols),0};
   DataCopyPad(tmp,src[r0*cols],cp,pad);
   SetFlag<HardEvent::MTE2_MTE3>(EVENT_ID0);WaitFlag<HardEvent::MTE2_MTE3>(EVENT_ID0);
  } else {SetFlag<HardEvent::V_MTE3>(EVENT_ID0);WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);}
  DataCopy(dst[r0*paddedCols],tmp,(uint32_t)(rn*paddedCols));
  SetFlag<HardEvent::MTE3_V>(EVENT_ID0);WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
 }
}
template <typename IN_T, bool TX1, bool TX2>
__aicore__ inline void BmmsCubePadCachedN(
    GM_ADDR ga, GM_ADDR gb, GM_ADDR gc,
    int64_t B, int64_t M, int64_t N, int64_t K,
    int64_t baseM, int64_t baseN, int64_t aPitch, int64_t cPitch)
{
    using AType = MatmulType<TPosition::GM, CubeFormat::ND, IN_T, false>;
    using BType = MatmulType<TPosition::GM, CubeFormat::ND, IN_T, false>;
    using CType = MatmulType<TPosition::GM, CubeFormat::ND, float, false>;
    using BiasType = MatmulType<TPosition::GM, CubeFormat::ND, float, false>;
    MatmulImpl<AType, BType, CType, BiasType, CFG_MDL> mm;
    const int32_t m = (int32_t)M, n = (int32_t)N, k = (int32_t)K;
    const int32_t bm = 128, bn = 128, sn = (int32_t)N;
    TCubeTiling t;
    t.usedCoreNum = 1;
    t.M = m; t.N = n; t.Ka = k; t.Kb = k;
    t.singleCoreM = bm; t.singleCoreN = sn; t.singleCoreK = k;
    t.baseM = bm; t.baseN = bn;
    { const bool tallKSmall = (M <= 64 && N <= 64 && K >= 2048 && (K % 256) == 0);
      t.baseK = tallKSmall ? 256 : 128; }
    t.depthA1 = 2; t.depthB1 = 2;
    t.stepM = 1; t.stepN = 1;
    t.isBias = 0; t.transLength = 0; t.iterateOrder = 0;
    t.shareMode = 0; t.shareL1Size = 0; t.shareL0CSize = 0; t.shareUbSize = 0;
    t.batchM = 0; t.batchN = 0; t.singleBatchM = 0; t.singleBatchN = 0;
    t.stepKa = 1; t.stepKb = 1;
    t.depthAL1CacheUB = 0; t.depthBL1CacheUB = 0;
    t.dbL0A = 1; t.dbL0B = 1; t.dbL0C = 1;
    if (TX1 && M >= 128 && N >= 128 && K >= 512 && M % 128 == 0 && K % 128 == 0) { t.baseK = 64; t.dbL0A = 2; t.dbL0B = 2; }
    t.baseK=128; t.stepKa=k/128; t.stepKb=1; t.depthA1=t.stepKa; t.depthB1=2;
    t.dbL0A=2; t.dbL0B=2; t.dbL0C=2;
    GlobalTensor<IN_T>  ag; ag.SetGlobalBuffer((__gm__ IN_T*)ga);
    GlobalTensor<IN_T>  bg; bg.SetGlobalBuffer((__gm__ IN_T*)gb);
    GlobalTensor<float> cg; cg.SetGlobalBuffer((__gm__ float*)gc);
    TPipe pipe;
    mm.SetSubBlockIdx(0);
    mm.Init(&t, &pipe);
    CrossCoreWaitFlag<2,PIPE_MTE2>(7);
    const int64_t mTiles = (M + bm - 1) / bm;
    const int64_t nTiles = (N + bn - 1) / bn;
    const int64_t items  = B * mTiles * nTiles;
    const int64_t core   = (int64_t)GetBlockIdx();
    const int64_t nCores = (int64_t)GetBlockNum();
    const bool mapExp = true;
    int64_t wFirst = core;
    int64_t wLimit = items;
    int64_t wStep  = nCores;
    bool rotateTail=false;
    if (mapExp) {
        const int64_t q  = items / nCores;
        const int64_t rr = items - q * nCores;
        // All higher-count cores fit in one small partial-M row.
        rotateTail=(M%128)>0 && (M%128)<=16 && rr>0 && rr*(q+1)<=nTiles;
        const int64_t lead = (core < rr) ? core : rr;
        wFirst = core * q + lead;
        wLimit = wFirst + q + ((core < rr) ? 1 : 0);
        wStep  = 1;
    }
    for (int64_t w = wFirst; w < wLimit;) {
        // Put the partial M row at the start of the unchanged equal-count map.
        const int64_t mappedW = rotateTail ? (w+(mTiles-1)*nTiles)%items : w;
        const int64_t nTile = mappedW % nTiles;
        const int64_t rem   = mappedW / nTiles;
        const int64_t mTile = rem % mTiles;
        const int64_t b     = rem / mTiles;
        const int64_t m0 = mTile * bm;
        const int64_t n0 = nTile * bn;
        int64_t run = nTiles-nTile;
        if (run>wLimit-w) run=wLimit-w;
        const int32_t groupN=(int32_t)(run*bn);
        const int32_t mNow = (int32_t)(((M - m0) < bm) ? (M - m0) : bm);
        const int32_t nNow = (int32_t)(((N - n0) < groupN) ? (N - n0) : groupN);
        GlobalTensor<IN_T> aB = ag[static_cast<uint64_t>(b) * (uint64_t)aPitch * (uint64_t)K];
        GlobalTensor<IN_T> bB = bg[static_cast<uint64_t>(b) * (uint64_t)K * (uint64_t)N];
        mm.SetOrgShape((int32_t)aPitch,n,k,k,(int32_t)cPitch);
        mm.SetSingleShape(bm, groupN, k);
        mm.SetTail(mNow, nNow, k);
        const uint64_t aOff = TX1 ? static_cast<uint64_t>(m0)
                                  : static_cast<uint64_t>(m0) * (uint64_t)K;
        const uint64_t bOff = TX2 ? static_cast<uint64_t>(n0) * (uint64_t)K
                                  : static_cast<uint64_t>(n0);
        mm.SetTensorA(aB[aOff], TX1);
        mm.SetTensorB(bB[bOff], TX2);
        GlobalTensor<float> cTile =
            cg[(static_cast<uint64_t>(b) * (uint64_t)M * (uint64_t)cPitch) +
               (static_cast<uint64_t>(m0) * (uint64_t)cPitch) + static_cast<uint64_t>(n0)];
        while (mm.Iterate()) {
            mm.GetTensorC(cTile, 0, false);
        }
        w += run;
    }
    mm.End();
}
__aicore__ inline void PadBatchedMaxRows255(GM_ADDR gc,GM_ADDR gy,GM_ADDR gpartial,int64_t B,int64_t M,int64_t N,int64_t ncores,int64_t cPitch=0) {
 if(cPitch==0)cPitch=N;
 GlobalTensor<float> cg,yg,pg;cg.SetGlobalBuffer((__gm__ float*)gc);yg.SetGlobalBuffer((__gm__ float*)gy);pg.SetGlobalBuffer((__gm__ float*)gpartial);
 constexpr int BUDGET=32768;
 TPipe pipe;TBuf<TPosition::VECCALC> tb;pipe.InitBuffer(tb,196608);
 auto tile=tb.Get<float>();auto compressed=tile[BUDGET];auto rowmax=compressed[BUDGET/8];auto rowmax2=rowmax[256];auto scratch=rowmax2[256];auto group=scratch[8192];auto accum=group[8];auto final=accum[8];
 int np=((int)N+63)&~63;int capacity=BUDGET/np;if(capacity>256)capacity=256;
 int64_t core=GetBlockIdx();
 int64_t total=B*M;int64_t per=(total+ncores-1)/ncores;
 int64_t rounds=1;
 for(int64_t iter=0;iter<rounds;iter++) {
  int64_t begin=core*per;
  int64_t end=begin+per<total?begin+per:total;
  Duplicate(accum,0.0f,8);
  for(int64_t r0=begin;r0<end;r0+=capacity) {
   int rows=(int)((end-r0<capacity)?end-r0:capacity);int count=rows*np;
   if(np!=N) Duplicate(tile,-3.402823466e+38F,count);
   SetFlag<HardEvent::V_MTE2>(EVENT_ID0);WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
   if(np==N && cPitch==N) DataCopy(tile,cg[r0*cPitch],count);
   else {
    int aligned=((int)N+7)&~7;
    DataCopyExtParams cp{(uint16_t)rows,(uint32_t)(N*4),(uint32_t)((cPitch-N)*4),(uint32_t)((np-aligned)/8),0};
    DataCopyPadExtParams<float> pad{true,0,(uint8_t)(aligned-N),-3.402823466e+38F};
    DataCopyPad(tile,cg[r0*cPitch],cp,pad);
   }
   SetFlag<HardEvent::MTE2_V>(EVENT_ID0);WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
   if(N<=128) {
    int rc=2048/np;
    for(int j=0;j<rows;j+=rc) {
     int nr=(rows-j<rc)?rows-j:rc;
     WholeReduceMax(rowmax[j],tile[j*np],(uint64_t)(N<64?N:64),(uint8_t)nr,1,1,np/8,ReduceOrder::ORDER_ONLY_VALUE);
     if(N>64) {
      WholeReduceMax(rowmax2[j],tile[j*np+64],(uint64_t)(N-64),(uint8_t)nr,1,1,np/8,ReduceOrder::ORDER_ONLY_VALUE);
     }
    }
    if(N>64)Max(rowmax,rowmax,rowmax2,rows);
   } else {
    for(int off=0;off<count;off+=16320) {
     int len=(count-off<16320)?count-off:16320;
     BlockReduceMax(compressed[off/8],tile[off],(uint8_t)(len/64),64,1,1,8);
    }
    PipeBarrier<PIPE_V>();
    const int width=np/8;
    WholeReduceMax(rowmax,compressed,(uint64_t)(width<64?width:64),(uint8_t)rows,1,1,np/64,ReduceOrder::ORDER_ONLY_VALUE);
    for(int off=64;off<width;off+=64) {
     const int mask=width-off<64?width-off:64;
     WholeReduceMax(rowmax2,compressed[off],(uint64_t)mask,(uint8_t)rows,1,1,np/64,ReduceOrder::ORDER_ONLY_VALUE);
     Max(rowmax,rowmax,rowmax2,rows);
    }
   }
   SetFlag<HardEvent::V_MTE3>(EVENT_ID0);WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);DataCopyExtParams rc{1,(uint32_t)(rows*4),0,0,0};DataCopyPad(pg[r0],rowmax,rc);SetFlag<HardEvent::MTE3_V>(EVENT_ID0);WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
  }
 }
 CrossCoreSetFlag<0,PIPE_MTE3>(10);CrossCoreWaitFlag<0,PIPE_MTE2>(10);
 for(int64_t b=core;b<B;b+=ncores) {
  DataCopyExtParams cp{1,(uint32_t)(M*4),0,0,0};DataCopyPadExtParams<float> pad{false,0,0,0};DataCopyPad(tile,pg[b*M],cp,pad);
  SetFlag<HardEvent::MTE2_V>(EVENT_ID0);WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);ReduceSum(final,tile,scratch,(int32_t)M);
  SetFlag<HardEvent::V_MTE3>(EVENT_ID0);WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);DataCopyExtParams out{1,4,0,0,0};DataCopyPad(yg[b],final,out);
  SetFlag<HardEvent::MTE3_V>(EVENT_ID0);WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
 }
}

template<typename T>
__aicore__ inline void PaddedBmm(GM_ADDR ga,GM_ADDR gb,GM_ADDR ap,GM_ADDR bp,GM_ADDR c,GM_ADDR r,GM_ADDR y,int64_t B,int64_t M,int64_t N,int64_t K,int64_t mp,int64_t kp,int64_t cp){
 if ASCEND_IS_AIV {
  BmmsPadInputs(ga,gb,ap,bp,B,M,N,K,mp,kp);
  CrossCoreSetFlag<0,PIPE_MTE3>(6);CrossCoreWaitFlag<0,PIPE_MTE2>(6);CrossCoreSetFlag<2,PIPE_MTE3>(7);
 }
 if ASCEND_IS_AIC {
  BmmsCubePadCachedN<T,true,true>(ap,bp,c,B,M,N,kp,128,128,mp,cp);PipeBarrier<PIPE_ALL>();CrossCoreSetFlag<2,PIPE_FIX>(8);
 }
 if ASCEND_IS_AIV {
  CrossCoreWaitFlag<2,PIPE_MTE2>(8);CrossCoreSetFlag<0,PIPE_MTE3>(9);CrossCoreWaitFlag<0,PIPE_MTE2>(9);PadBatchedMaxRows255(c,y,r,B,M,N,(int64_t)GetBlockNum()*2,cp);
 }
}
#define PAD_ENTRY(NAME,T) \
extern "C" __global__ __aicore__ void NAME(GM_ADDR a,GM_ADDR b,GM_ADDR ap,GM_ADDR bp,GM_ADDR c,GM_ADDR r,GM_ADDR y,int64_t B,int64_t M,int64_t N,int64_t K,int64_t mp,int64_t kp,int64_t cp){KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);PaddedBmm<T>(a,b,ap,bp,c,r,y,B,M,N,K,mp,kp,cp);}
