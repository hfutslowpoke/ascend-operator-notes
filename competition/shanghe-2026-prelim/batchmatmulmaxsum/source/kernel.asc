__aicore__ inline void PipelinedRunningMax(GM_ADDR gc,GM_ADDR gy,GM_ADDR gp,GM_ADDR gr,int64_t B,int64_t M,int64_t N,int64_t Cp,int64_t bm,bool grouped) {
 GlobalTensor<float> cg,yg,pg,rg;cg.SetGlobalBuffer((__gm__ float*)gc);yg.SetGlobalBuffer((__gm__ float*)gy);pg.SetGlobalBuffer((__gm__ float*)gp);rg.SetGlobalBuffer((__gm__ float*)gr);
 TPipe pipe;TBuf<TPosition::VECCALC> tb;pipe.InitBuffer(tb,192512);
 auto tile=tb.Get<float>();auto comp=tile[40960];auto row=comp[5120];auto row2=row[128];auto acc=row2[128];auto scratch=acc[128];auto out=scratch[1024];
 const int64_t core=GetBlockIdx()/2,sub=GetSubBlockIdx(),nc=GetBlockNum();
 const int64_t mt=(M+bm-1)/bm,nt=(N+127)/128,items=B*mt*nt,q=items/nc,rr=items%nc;
 const int64_t first=core*q+(core<rr?core:rr),limit=first+q+(core<rr);
 // Accumulate all N groups owned by this core for a row tile in UB.
 // Each (batch,row-tile,core,subcore) writes exactly one partial maximum.
 for(int64_t segment=first;segment<limit;){
  const int64_t segmentEnd=((segment/nt+1)*nt<limit)?(segment/nt+1)*nt:limit;
  const int64_t mi=(segment/nt)%mt,batch=segment/(mt*nt),m0=mi*bm+sub*(bm/2);
  const int allRows=M-m0<bm/2?M-m0:bm/2;
  Duplicate(acc,-3.402823466e+38F,128);
  for(int64_t w=segment;w<segmentEnd;){
   const int64_t ni=w%nt,n0=ni*128;
   int64_t run=segmentEnd-w;if(grouped && run>2)run=2;
   const int nNow=N-n0<run*128?N-n0:run*128;
   CrossCoreWaitFlag<2,PIPE_MTE2>(8);if(grouped)CrossCoreSetFlag<2,PIPE_MTE2>(7);
   if(allRows>0){
    const int np=(nNow+63)&~63,al=(nNow+7)&~7;
    int capacity=40960/np;if(capacity>(grouped?128:64))capacity=grouped?128:64;
    for(int r=0;r<allRows;r+=capacity){
     const int rows=allRows-r<capacity?allRows-r:capacity,count=rows*np;
     if(np!=nNow)Duplicate(tile,-3.402823466e+38F,count);
     SetFlag<HardEvent::V_MTE2>(EVENT_ID0);WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
     DataCopyExtParams cp{(uint16_t)rows,(uint32_t)(nNow*4),(uint32_t)((Cp-nNow)*4),(uint32_t)((np-al)/8),0};DataCopyPadExtParams<float> pad{true,0,(uint8_t)(al-nNow),-3.402823466e+38F};
     DataCopyPad(tile,cg[(batch*M+m0+r)*Cp+n0],cp,pad);
     SetFlag<HardEvent::MTE2_V>(EVENT_ID0);WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
     for(int off=0;off<count;off+=2048){const int len=count-off<2048?count-off:2048;BlockReduceMax(comp[off/8],tile[off],len/64,64,1,1,8);}
     PipeBarrier<PIPE_V>();
