extern "C" void run_kernel(GM_ADDR x1,const TensorGroupInfo& info_x1,GM_ADDR x2,const TensorGroupInfo& info_x2,GM_ADDR y,const TensorGroupInfo& info_y,int64_t availableCoreNum,aclrtStream stream,bool transposeX1,bool transposeX2) {
 (void)info_y;
 const TensorInfo& a=info_x1.tensors[0];const TensorInfo& b=info_x2.tensors[0];
 const int64_t B=a.shape[0],M=a.shape[transposeX1?2:1],K=a.shape[transposeX1?1:2],N=b.shape[transposeX2?1:2];
 const int route=(a.dtype==2?4:0)|(transposeX1?2:0)|(transposeX2?1:0);
 if(M*N<=1 && K<=64){int64_t width=B<8?8:B;if(width>availableCoreNum*2)width=availableCoreNum*2;if(a.dtype==1)short_h<<<(uint32_t)width,nullptr,stream>>>(x1,x2,y,B,K);else short_b<<<(uint32_t)width,nullptr,stream>>>(x1,x2,y,B,K);return;}
 if(M*N<=1 && K<=256){int64_t width=B<8?8:B;if(width>availableCoreNum*2)width=availableCoreNum*2;if(a.dtype==1)direct_h<<<(uint32_t)width,nullptr,stream>>>(x1,x2,y,B,K);else direct_b<<<(uint32_t)width,nullptr,stream>>>(x1,x2,y,B,K);return;}
 if(M<=4 && N<=8 && K<=64){int64_t width=B<8?8:B;if(width>availableCoreNum*2)width=availableCoreNum*2;
 #define FCASE(I,NAME,ONCE) case I:if(B<=width)ONCE<<<(uint32_t)width,nullptr,stream>>>(x1,x2,y,B,M,N,K);else NAME<<<(uint32_t)width,nullptr,stream>>>(x1,x2,y,B,M,N,K);break;
 switch(route){FCASE(0,flat_h00,flat_once_h00) FCASE(1,flat_h01,flat_once_h01) FCASE(2,flat_h10,flat_once_h10) FCASE(3,flat_h11,flat_once_h11) FCASE(4,flat_b00,flat_once_b00) FCASE(5,flat_b01,flat_once_b01) FCASE(6,flat_b10,flat_once_b10) FCASE(7,flat_b11,flat_once_b11)}
