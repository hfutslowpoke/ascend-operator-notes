template<class T,bool TX1,bool TX2>
__aicore__ inline void SmallTransposedCube(GM_ADDR ga,GM_ADDR gb,GM_ADDR gc,int64_t B,int64_t M,int64_t N,int64_t K) {
 GlobalTensor<T> ag,bg;GlobalTensor<float> cg;ag.SetGlobalBuffer((__gm__ T*)ga);bg.SetGlobalBuffer((__gm__ T*)gb);cg.SetGlobalBuffer((__gm__ float*)gc);
 TPipe pipe;TBuf<TPosition::A1> a1b;TBuf<TPosition::A2> a2b;TBuf<TPosition::B1> b1b;TBuf<TPosition::B2> b2b;TBuf<TPosition::CO1> cb;
 pipe.InitBuffer(a1b,128*256*2);pipe.InitBuffer(a2b,128*256*2);pipe.InitBuffer(b1b,32*256*2);pipe.InitBuffer(b2b,32*256*2);pipe.InitBuffer(cb,128*32*4);
 auto a1=a1b.template Get<T>();auto a2=a2b.template Get<T>();auto b1=b1b.template Get<T>();auto b2=b2b.template Get<T>();auto c=cb.template Get<float>();
 int mp=((int)M+15)&~15,np=((int)N+15)&~15,kp=(int)K; int cs=np;
 for(int64_t batch=GetBlockIdx();batch<B;batch+=GetBlockNum()) {
  Nd2NzParams acp{1,(uint16_t)(TX1?K:M),(uint16_t)(TX1?M:K),0,(uint16_t)(TX1?M:K),(uint16_t)(TX1?kp:mp),1,0};
  Nd2NzParams bcp{1,(uint16_t)(TX2?N:K),(uint16_t)(TX2?K:N),0,(uint16_t)(TX2?K:N),(uint16_t)(TX2?np:kp),1,0};
  // A's MTE1 load may overlap B's GM-to-L1 DMA. A/B storage is disjoint.
  // Original FIX-to-MTE2 fence still protects every cross-batch reuse.
  DataCopy(a1,ag[batch*M*K],acp);
  SetFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);
  DataCopy(b1,bg[batch*K*N],bcp);
  SetFlag<HardEvent::MTE2_MTE1>(EVENT_ID1);
  WaitFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);
  if constexpr(TX1) {
   LoadData2dTransposeParams p{0,(uint8_t)(kp/16),1,0,(uint16_t)(kp/16-1),0};
   for(int mi=0;mi<mp/16;mi++)LoadDataWithTranspose(a2[mi*kp*16],a1[mi*kp*16],p);
  } else {
   LoadData2DParams p{0,(uint8_t)(kp/16),(uint16_t)(mp/16),0,0,false,0};
   for(int mi=0;mi<mp/16;mi++)LoadData(a2[mi*kp*16],a1[mi*256],p);
  }
  WaitFlag<HardEvent::MTE2_MTE1>(EVENT_ID1);
  if constexpr(TX2) {LoadData2DParams p{0,(uint8_t)(kp*np/256),1,0,0,false,0};LoadData(b2,b1,p);}
  else {
   if (np < kp && np >= 64) {
    LoadData2dTransposeParams p{0,(uint8_t)(kp/16),1,(uint16_t)(np/16-1),0,0};
    for(int ni=0;ni<np/16;ni++)LoadDataWithTranspose(b2[ni*256],b1[ni*kp*16],p);
   } else {
    LoadData2dTransposeParams p{0,(uint8_t)(np/16),(uint16_t)(kp/16),0,0,0};
    for(int ki=0;ki<kp/16;ki++)LoadDataWithTranspose(b2[ki*np*16],b1[ki*256],p);
   }
  }
  SetFlag<HardEvent::MTE1_M>(EVENT_ID0);WaitFlag<HardEvent::MTE1_M>(EVENT_ID0);
  MmadParams mm;mm.m=mp;mm.n=np;mm.k=kp;mm.cmatrixInitVal=true;mm.cmatrixSource=false;Mmad(c,a2,b2,mm);
  SetFlag<HardEvent::M_FIX>(EVENT_ID0);WaitFlag<HardEvent::M_FIX>(EVENT_ID0);
  FixpipeParamsV220 fp;fp.mSize=M;fp.nSize=np;fp.srcStride=mp;fp.dstStride=cs;fp.ndNum=1;fp.srcNdStride=0;fp.dstNdStride=0;fp.reluEn=false;
  Fixpipe<float,float,CFG_ROW_MAJOR>(cg[batch*M*cs],c,fp);
  CrossCoreSetFlag<2,PIPE_FIX>(8);
  SetFlag<HardEvent::FIX_MTE2>(EVENT_ID0);WaitFlag<HardEvent::FIX_MTE2>(EVENT_ID0);
 }
}

__aicore__ inline void SmallTransposedVector(GM_ADDR gc,GM_ADDR gy,int64_t B,int64_t M,int64_t N){
 GlobalTensor<float> cg,yg;cg.SetGlobalBuffer((__gm__ float*)gc);yg.SetGlobalBuffer((__gm__ float*)gy);
 TPipe pipe;TBuf<TPosition::VECCALC> storage;pipe.InitBuffer(storage,20480);auto tile=storage.Get<float>();auto scratch=tile[4096];auto out=scratch[512];const int pitch=(M+15)&~15;
 for(int64_t b=GetBlockIdx();b<B;b+=GetBlockNum()){
  CrossCoreWaitFlag<2,PIPE_MTE2>(8);SetFlag<HardEvent::V_MTE2>(EVENT_ID0);WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);DataCopy(tile,cg[b*N*pitch],N*pitch);SetFlag<HardEvent::MTE2_V>(EVENT_ID0);WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
  int power=1;while(power*2<=N)power*=2;if(N>power)Max(tile,tile,tile[power*pitch],(N-power)*pitch);PipeBarrier<PIPE_V>();for(int r=power/2;r>0;r/=2){Max(tile,tile,tile[r*pitch],r*pitch);PipeBarrier<PIPE_V>();}ReduceSum(out,tile,scratch,(int32_t)M);
  SetFlag<HardEvent::V_MTE3>(EVENT_ID0);WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);DataCopyExtParams cp{1,4,0,0,0};DataCopyPad(yg[b],out,cp);SetFlag<HardEvent::MTE3_V>(EVENT_ID0);WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
 }
}
