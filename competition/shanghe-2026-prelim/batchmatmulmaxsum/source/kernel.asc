extern "C" __global__ __aicore__ void NAME(GM_ADDR a,GM_ADDR b,GM_ADDR c,GM_ADDR y,int64_t B,int64_t M,int64_t N,int64_t K){KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_1);if ASCEND_IS_AIC {SmallTransposedCube<T,!TB,!TA>(b,a,c,B,N,M,K);}if ASCEND_IS_AIV {SmallTransposedVector(c,y,B,M,N);}}
