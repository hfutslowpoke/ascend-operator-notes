 int64_t bm=32,bn=32;
 if(M>=128&&N>=128){bm=256;bn=128;}
 else {for(int64_t t=32;t<=256;t*=2){if(t<=M)bm=t;if(t<=N)bn=t;}if(M<128&&N>=4096)bn=128;}
