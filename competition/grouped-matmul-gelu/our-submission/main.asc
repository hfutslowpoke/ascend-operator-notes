#include <array>
#include <fstream>
#include <iostream>
#include <stdexcept>
#include <string>
#include <vector>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <ctime>
#include <cmath>
#include "acl/acl.h"
#ifndef GM_ADDR
#define GM_ADDR __gm__ uint8_t*
#endif
#ifndef TENSOR_GROUP_INFO_DEFINED
#define TENSOR_GROUP_INFO_DEFINED
struct TensorInfo {
    const int64_t* shape;
    int64_t numDims;
    int32_t dtype;
};
struct TensorGroupInfo {
    const TensorInfo* tensors;
    int64_t numTensors;
};
#endif
#include "kernel.asc"

static void check(aclError code) {
    if (code != ACL_SUCCESS)
        throw std::runtime_error("ACL call failed: " + std::to_string(code));
}

struct DeviceMemory {
    std::vector<void*> pointers;
    void* allocate(size_t bytes) {
        void* ptr = nullptr;
        check(aclrtMalloc(&ptr, bytes ? bytes : 1, ACL_MEM_MALLOC_HUGE_FIRST));
        pointers.push_back(ptr);
        return ptr;
    }
    ~DeviceMemory() {
        for (auto ptr : pointers)
            aclrtFree(ptr);
    }
};

struct Session {
    int device;
    aclrtStream stream = nullptr;
    bool initialized = false, selected = false;
    explicit Session(int number) : device(number) {}
    void start() {
        check(aclInit(nullptr));
        initialized = true;
        check(aclrtSetDevice(device));
        selected = true;
        check(aclrtCreateStream(&stream));
    }
    ~Session() {
        if (stream)
            aclrtDestroyStream(stream);
        if (selected)
            aclrtResetDevice(device);
        if (initialized)
            aclFinalize();
    }
};

static void load(const std::string& path, void* dst, size_t bytes) {
    std::ifstream file(path, std::ios::binary | std::ios::ate);
    if (!file || file.tellg() != static_cast<std::streamoff>(bytes))
        throw std::runtime_error("input size mismatch: " + path);
    std::vector<char> host(bytes);
    file.seekg(0);
    if (bytes && !file.read(host.data(), bytes))
        throw std::runtime_error("input read failed: " + path);
    if (bytes)
        check(aclrtMemcpy(dst, bytes, host.data(), bytes, ACL_MEMCPY_HOST_TO_DEVICE));
}

static void save(const std::string& path, void* src, size_t bytes) {
    std::vector<char> host(bytes);
    if (bytes)
        check(aclrtMemcpy(host.data(), bytes, src, bytes, ACL_MEMCPY_DEVICE_TO_HOST));
    std::ofstream file(path, std::ios::binary | std::ios::trunc);
    if (!file || (bytes && !file.write(host.data(), bytes)))
        throw std::runtime_error("output write failed: " + path);
}

int main(int argc, char** argv) {
    try {
        if (argc != 7)
            throw std::runtime_error("usage: ./sample <device> <M> <K> <N> <E> <dir>");
        int device = std::stoi(argv[1]);
        const int64_t m = std::stoll(argv[2]);
        const int64_t k = std::stoll(argv[3]);
        const int64_t n = std::stoll(argv[4]);
        const int64_t e = std::stoll(argv[5]);
        const std::string dir = argv[6];

        Session session(device);
        session.start();
#ifdef ASCENDC_CPU_DEBUG
        int64_t cores = 1;
#else
        int64_t cores = 0;
        check(aclrtGetDeviceInfo(device, ACL_DEV_ATTR_AICORE_CORE_NUM, &cores));
#endif

        const size_t xBytes = static_cast<size_t>(m) * k;
        const size_t wBytes = static_cast<size_t>(e) * k * n;
        const size_t sBytes = static_cast<size_t>(e) * n * sizeof(float);
        const size_t gBytes = static_cast<size_t>(e) * sizeof(int64_t);
        const size_t yBytes = static_cast<size_t>(m) * n * sizeof(uint16_t);

        DeviceMemory memory;
        void* x = memory.allocate(xBytes);
        void* w = memory.allocate(wBytes);
        void* s = memory.allocate(sBytes);
        void* g = memory.allocate(gBytes);
        void* y = memory.allocate(yBytes);

        load(dir + "/input/x.bin", x, xBytes);
        load(dir + "/input/weight.bin", w, wBytes);
        load(dir + "/input/scale.bin", s, sBytes);
        load(dir + "/input/group_list.bin", g, gBytes);
        check(aclrtMemset(y, yBytes, 0x5A, yBytes));

        int64_t xShape[2] = {m, k};
        int64_t wShape[3] = {e, k, n};
        int64_t sShape[2] = {e, n};
        int64_t gShape[1] = {e};
        int64_t yShape[2] = {m, n};
        TensorInfo xInfo{xShape, 2, 3};
        TensorInfo wInfo{wShape, 3, 3};
        TensorInfo sInfo{sShape, 2, 0};
        TensorInfo gInfo{gShape, 1, 6};
        TensorInfo yInfo{yShape, 2, 1};
        TensorGroupInfo xGroup{&xInfo, 1};
        TensorGroupInfo wGroup{&wInfo, 1};
        TensorGroupInfo sGroup{&sInfo, 1};
        TensorGroupInfo gGroup{&gInfo, 1};
        TensorGroupInfo yGroup{&yInfo, 1};

        run_kernel((GM_ADDR)x, xGroup, (GM_ADDR)w, wGroup, (GM_ADDR)s, sGroup,
                   (GM_ADDR)g, gGroup, (GM_ADDR)y, yGroup, cores, session.stream);
        check(aclrtSynchronizeStream(session.stream));
        save(dir + "/output/y.bin", y, yBytes);
        std::cout << "Kernel completed: M=" << m << " K=" << k << " N=" << n
                  << " E=" << e << " cores=" << cores << "\n";
        return 0;
    } catch (const std::exception& error) {
        std::cerr << "RUN ERROR: " << error.what() << '\n';
        return 2;
    }
}
