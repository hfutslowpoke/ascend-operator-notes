#include <algorithm>
#include <array>
#include <chrono>
#include <cmath>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <fstream>
#include <iomanip>
#include <iostream>
#include <stdexcept>
#include <string>
#include <vector>
#include "acl/acl.h"
#ifndef GM_ADDR
#define GM_ADDR __gm__ uint8_t*
#endif
#ifndef TENSOR_GROUP_INFO_DEFINED
#define TENSOR_GROUP_INFO_DEFINED
struct TensorInfo {
    const int64_t* shape;
    int64_t numDims;
    int32_t dtype;
};
struct TensorGroupInfo {
    const TensorInfo* tensors;
    int64_t numTensors;
};
#endif
#include "kernel.asc"

static void check(aclError code) {
    if (code != ACL_SUCCESS)
        throw std::runtime_error("ACL call failed: " + std::to_string(code));
}

struct DeviceMemory {
    std::vector<void*> pointers;
    void* allocate(size_t bytes) {
        void* ptr = nullptr;
        check(aclrtMalloc(&ptr, bytes ? bytes : 1, ACL_MEM_MALLOC_HUGE_FIRST));
        pointers.push_back(ptr);
        return ptr;
    }
    ~DeviceMemory() {
        for (auto ptr : pointers)
            aclrtFree(ptr);
    }
};

struct Session {
    int device;
    aclrtStream stream = nullptr;
    bool initialized = false, selected = false;
    explicit Session(int number) : device(number) {}
    void start() {
        check(aclInit(nullptr));
        initialized = true;
        check(aclrtSetDevice(device));
        selected = true;
        check(aclrtCreateStream(&stream));
    }
    ~Session() {
        if (stream)
            aclrtDestroyStream(stream);
        if (selected)
            aclrtResetDevice(device);
        if (initialized)
            aclFinalize();
    }
};

static void load(const std::string& path, void* dst, size_t bytes) {
    std::ifstream file(path, std::ios::binary | std::ios::ate);
    if (!file || file.tellg() != static_cast<std::streamoff>(bytes))
        throw std::runtime_error("input size mismatch: " + path);
    std::vector<char> host(bytes);
    file.seekg(0);
    if (bytes && !file.read(host.data(), bytes))
        throw std::runtime_error("input read failed: " + path);
    if (bytes)
        check(aclrtMemcpy(dst, bytes, host.data(), bytes, ACL_MEMCPY_HOST_TO_DEVICE));
}

struct TimedCall {
    float device_us = 0.0f;
    double host_us = 0.0;
};

static TimedCall run_once(
    void* x, const TensorGroupInfo& xGroup,
    void* w, const TensorGroupInfo& wGroup,
    void* s, const TensorGroupInfo& sGroup,
    void* g, const TensorGroupInfo& gGroup,
    void* y, const TensorGroupInfo& yGroup,
    int64_t cores, aclrtStream stream,
    aclrtEvent startEvent, aclrtEvent endEvent)
{
    check(aclrtRecordEvent(startEvent, stream));
    const auto hostStart = std::chrono::steady_clock::now();
    run_kernel(
        (GM_ADDR)x, xGroup, (GM_ADDR)w, wGroup, (GM_ADDR)s, sGroup,
        (GM_ADDR)g, gGroup, (GM_ADDR)y, yGroup, cores, stream);
    const auto hostEnd = std::chrono::steady_clock::now();
    check(aclrtRecordEvent(endEvent, stream));
    check(aclrtSynchronizeEvent(endEvent));

    float elapsedMs = 0.0f;
    check(aclrtEventElapsedTime(&elapsedMs, startEvent, endEvent));
    TimedCall result;
    result.device_us = elapsedMs * 1000.0f;
    result.host_us =
        std::chrono::duration<double, std::micro>(hostEnd - hostStart).count();
    return result;
}

static double median(std::vector<double> values) {
    if (values.empty())
        return 0.0;
    std::sort(values.begin(), values.end());
    const size_t mid = values.size() / 2;
    if (values.size() % 2 == 1)
        return values[mid];
    return 0.5 * (values[mid - 1] + values[mid]);
}

static void print_array(const std::vector<double>& values) {
    std::cout << "[";
    for (size_t i = 0; i < values.size(); ++i) {
        if (i)
            std::cout << ",";
        std::cout << std::fixed << std::setprecision(6) << values[i];
    }
    std::cout << "]";
}

int main(int argc, char** argv) {
    try {
        if (argc != 9 && argc != 10)
            throw std::runtime_error(
                "usage: ./bench <device> <M> <K> <N> <E> <dir> <warmup> <iters> [name]");
        const int device = std::stoi(argv[1]);
        const int64_t m = std::stoll(argv[2]);
        const int64_t k = std::stoll(argv[3]);
        const int64_t n = std::stoll(argv[4]);
        const int64_t e = std::stoll(argv[5]);
        const std::string dir = argv[6];
        const int warmup = std::stoi(argv[7]);
        const int iters = std::stoi(argv[8]);
        const std::string name = argc == 10 ? argv[9] : dir;
        if (warmup < 0 || iters < 1)
            throw std::runtime_error("warmup must be >= 0 and iters >= 1");

        Session session(device);
        session.start();
        int64_t cores = 0;
        check(aclrtGetDeviceInfo(device, ACL_DEV_ATTR_AICORE_CORE_NUM, &cores));

        const size_t xBytes = static_cast<size_t>(m) * k;
        const size_t wBytes = static_cast<size_t>(e) * k * n;
        const size_t sBytes = static_cast<size_t>(e) * n * sizeof(float);
        const size_t gBytes = static_cast<size_t>(e) * sizeof(int64_t);
        const size_t yBytes = static_cast<size_t>(m) * n * sizeof(uint16_t);

        DeviceMemory memory;
        void* x = memory.allocate(xBytes);
        void* w = memory.allocate(wBytes);
        void* s = memory.allocate(sBytes);
        void* g = memory.allocate(gBytes);
        void* y = memory.allocate(yBytes);

        load(dir + "/input/x.bin", x, xBytes);
        load(dir + "/input/weight.bin", w, wBytes);
        load(dir + "/input/scale.bin", s, sBytes);
        load(dir + "/input/group_list.bin", g, gBytes);
        check(aclrtMemset(y, yBytes, 0x5A, yBytes));

        int64_t xShape[2] = {m, k};
        int64_t wShape[3] = {e, k, n};
        int64_t sShape[2] = {e, n};
        int64_t gShape[1] = {e};
        int64_t yShape[2] = {m, n};
        TensorInfo xInfo{xShape, 2, 3};
        TensorInfo wInfo{wShape, 3, 3};
        TensorInfo sInfo{sShape, 2, 0};
        TensorInfo gInfo{gShape, 1, 6};
        TensorInfo yInfo{yShape, 2, 1};
        TensorGroupInfo xGroup{&xInfo, 1};
        TensorGroupInfo wGroup{&wInfo, 1};
        TensorGroupInfo sGroup{&sInfo, 1};
        TensorGroupInfo gGroup{&gInfo, 1};
        TensorGroupInfo yGroup{&yInfo, 1};

        aclrtEvent startEvent = nullptr;
        aclrtEvent endEvent = nullptr;
        check(aclrtCreateEvent(&startEvent));
        check(aclrtCreateEvent(&endEvent));

        const TimedCall cold = run_once(
            x, xGroup, w, wGroup, s, sGroup, g, gGroup, y, yGroup,
            cores, session.stream, startEvent, endEvent);

        for (int i = 0; i < warmup; ++i) {
            (void)run_once(
                x, xGroup, w, wGroup, s, sGroup, g, gGroup, y, yGroup,
                cores, session.stream, startEvent, endEvent);
        }

        std::vector<double> deviceSamples;
        std::vector<double> hostSamples;
        deviceSamples.reserve(iters);
        hostSamples.reserve(iters);
        for (int i = 0; i < iters; ++i) {
            const TimedCall sample = run_once(
                x, xGroup, w, wGroup, s, sGroup, g, gGroup, y, yGroup,
                cores, session.stream, startEvent, endEvent);
            deviceSamples.push_back(sample.device_us);
            hostSamples.push_back(sample.host_us);
        }

        const double deviceMedian = median(deviceSamples);
        const double hostMedian = median(hostSamples);
        std::cout << std::fixed << std::setprecision(6);
        std::cout << "{"
                  << "\"name\":\"" << name << "\","
                  << "\"M\":" << m << ","
                  << "\"K\":" << k << ","
                  << "\"N\":" << n << ","
                  << "\"E\":" << e << ","
                  << "\"cores\":" << cores << ","
                  << "\"warmup\":" << warmup << ","
                  << "\"iters\":" << iters << ","
                  << "\"cold_device_us\":" << cold.device_us << ","
                  << "\"cold_host_us\":" << cold.host_us << ","
                  << "\"device_median_us\":" << deviceMedian << ","
                  << "\"host_median_us\":" << hostMedian << ","
                  << "\"device_samples_us\":";
        print_array(deviceSamples);
        std::cout << ",\"host_samples_us\":";
        print_array(hostSamples);
        std::cout << "}\n";

        check(aclrtDestroyEvent(startEvent));
        check(aclrtDestroyEvent(endEvent));
        return 0;
    } catch (const std::exception& error) {
        std::cerr << "BENCH ERROR: " << error.what() << '\n';
        return 2;
    }
}
