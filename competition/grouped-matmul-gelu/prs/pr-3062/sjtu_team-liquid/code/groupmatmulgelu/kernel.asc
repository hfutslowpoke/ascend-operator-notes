/*
文件名 - kernel_32.asc
思路介绍：按片上容量、行列任务量和对齐条件组合矩阵流水。
设备读取实际分组，使用完整 INT32 累加与 FP32 激活后写出 FP16。
每次调用只启动一个设备入口，所有工作区在当前调用完成后释放。
*/
#include <algorithm>
#include <cstdint>
#include "kernel_operator.h"

namespace grouped_gelu
{
using namespace AscendC;

__aicore__ inline int Min(int a, int b)
{
    return a < b ? a : b;
}
__aicore__ inline int Up(int a, int b)
{
    return (a + b - 1) / b * b;
}

__aicore__ inline void Gelu(const LocalTensor<float> &z, const LocalTensor<float> &temporary,
                            const LocalTensor<half> &out, int count)
{
    Mul(temporary, z, z, count);
    PipeBarrier<PIPE_V>();
    Muls(temporary, temporary, -0.07135481627260025f, count);
    PipeBarrier<PIPE_V>();
    Adds(temporary, temporary, -1.5957691216057308f, count);
    PipeBarrier<PIPE_V>();
    Mul(temporary, temporary, z, count);
    PipeBarrier<PIPE_V>();
    Mins(temporary, temporary, 88.0f, count);
    PipeBarrier<PIPE_V>();
    Exp(temporary, temporary, count);
    PipeBarrier<PIPE_V>();
    Adds(temporary, temporary, 1.0f, count);
    PipeBarrier<PIPE_V>();
    Div(z, z, temporary, count);
    PipeBarrier<PIPE_V>();
    Cast(out, z, RoundMode::CAST_RINT, count);
}

__aicore__ inline void LoadInt32Rows(const LocalTensor<int32_t> &dst,
                                     const GlobalTensor<int32_t> &src, int rows, int cols,
                                     int sourcePitch, int destinationPitch)
{
    if (sourcePitch == destinationPitch)
        DataCopy(dst, src, rows * sourcePitch);
    else
        DataCopyPad(dst, src,
                    DataCopyExtParams(rows, cols * 4, (sourcePitch - cols) * 4,
                                      (destinationPitch - Up(cols, 8)) / 8, 0),
                    DataCopyPadExtParams<int32_t>{false, 0, 0, 0});
}

template <bool SCALAR>
__global__ __vector__ __attribute__((aligned(4096))) void
Small(GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groups, GM_ADDR y, int M, int K, int N,
      int E, int workers)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    TPipe pipe;
    SetMaskNorm();
    SetVectorMask<uint8_t>(~uint64_t(0), ~uint64_t(0));
    GlobalTensor<int8_t> a, b;
    GlobalTensor<float> s;
    GlobalTensor<int64_t> g;
    GlobalTensor<half> result;
    a.SetGlobalBuffer((__gm__ int8_t *)x);
    b.SetGlobalBuffer((__gm__ int8_t *)weight);
    s.SetGlobalBuffer((__gm__ float *)scale);
    g.SetGlobalBuffer((__gm__ int64_t *)groups);
    result.SetGlobalBuffer((__gm__ half *)y);
    LocalTensor<int8_t> ua(TPosition::VECCALC, 0, 256);
    LocalTensor<int8_t> ub(TPosition::VECCALC, 512, 2048);
    LocalTensor<half> wh(TPosition::VECCALC, 4096, 2048);
    LocalTensor<float> wf(TPosition::VECCALC, 8192, 2048);
    LocalTensor<float> us(TPosition::VECCALC, 16384, 64);
    LocalTensor<float> t(TPosition::VECCALC, 20480, 64);
    LocalTensor<half> out(TPosition::VECCALC, 24576, 64);
    const int count = SCALAR ? Up(N, 8) : (N % 8 == 0 ? N : 32);
    for (int row = GetBlockIdx(); row < M; row += workers)
    {
        int expert = 0;
        while (expert < E && row >= g.GetValue(expert))
            ++expert;
        Duplicate(us, 0.0f, count);
        if constexpr (SCALAR)
            Duplicate(wf, 0.0f, count);
        SetFlag<HardEvent::V_MTE2>(EVENT_ID1);
        WaitFlag<HardEvent::V_MTE2>(EVENT_ID1);
        DataCopyPad(ua, a[int64_t(row) * K], DataCopyExtParams(1, K, 0, 0, 0),
                    DataCopyPadExtParams<int8_t>{false, 0, 0, 0});
        if (SCALAR || N % 8 == 0)
            DataCopyPad(ub, b[int64_t(expert) * K * N], DataCopyExtParams(1, K * N, 0, 0, 0),
                        DataCopyPadExtParams<int8_t>{false, 0, 0, 0});
        else
            DataCopyPad(ub, b[int64_t(expert) * K * N], DataCopyExtParams(K, N, 0, 0, 0),
                        DataCopyPadExtParams<int8_t>{true, 0, uint8_t(count - N), 0});
        DataCopyPad(us, s[expert * N], DataCopyExtParams(1, N * 4, 0, 0, 0),
                    DataCopyPadExtParams<float>{true, 0, uint8_t(Up(N, 8) - N), 0.0f});
        SetFlag<HardEvent::MTE2_S>(EVENT_ID0);
        WaitFlag<HardEvent::MTE2_S>(EVENT_ID0);
        if constexpr (SCALAR)
        {
            for (int col = 0; col < N; ++col)
            {
                int32_t sum = 0;
                for (int k = 0; k < K; ++k)
                    sum += int32_t(ua.GetValue(k)) * int32_t(ub.GetValue(k * N + col));
                wf.SetValue(col, float(sum));
            }
            SetFlag<HardEvent::S_V>(EVENT_ID0);
            WaitFlag<HardEvent::S_V>(EVENT_ID0);
        }
        else
        {
            SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
            WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
            Cast(wh, ub, RoundMode::CAST_NONE, K * count);
            PipeBarrier<PIPE_V>();
            auto sums = wf.ReinterpretCast<int32_t>();
            Cast(sums, wh, RoundMode::CAST_RINT, K * count);
            PipeBarrier<PIPE_V>();
            // INT8 -> FP16 is exact; products and the tree reduction use INT32.
            for (int k = 0; k < K; ++k)
                Muls(sums[k * count], sums[k * count], int32_t(ua.GetValue(k)), count);
            PipeBarrier<PIPE_V>();
            for (int span = K; span > 1; span = (span + 1) / 2)
            {
                Add(sums, sums, sums[(span + 1) / 2 * count], span / 2 * count);
                PipeBarrier<PIPE_V>();
            }
            Cast(wf, sums, RoundMode::CAST_RINT, count);
            PipeBarrier<PIPE_V>();
        }
        auto z = wf;
        Mul(z, z, us, count);
        PipeBarrier<PIPE_V>();
        Gelu(z, t, out, count);
        SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
        WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
        DataCopyPad(result[int64_t(row) * N], out, DataCopyExtParams(1, N * 2, 0, 0, 0));
        SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
        WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
        SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
        WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
    }
}

__aicore__ inline void CopyNdShared(const LocalTensor<int8_t> &dst, const GlobalTensor<int8_t> &src,
                                    int rows, int cols, int stride, int paddedRows)
{
    Nd2NzParams p;
    p.ndNum = 1;
    p.nValue = rows;
    p.dValue = cols;
    p.srcNdMatrixStride = 0;
    p.srcDValue = stride;
    p.dstNzC0Stride = paddedRows;
    p.dstNzNStride = 1;
    p.dstNzMatrixStride = 0;
    if (stride % 4 == 0)
    {
        GlobalTensor<float> wide;
        wide.SetGlobalBuffer((__gm__ float *)src.GetPhyAddr());
        p.dValue = (cols + 3) / 4;
        p.srcDValue /= 4;
        DataCopy(dst.template ReinterpretCast<float>(), wide, p);
    }
    else
        DataCopy(dst, src, p);
}

template <int MT, int NT, bool SPLIT, int LK = 256, int NSTAGES = 3, bool NZ = false> class Cube
{
    static constexpr int FK = MT >= 256 || NT > 256 ? 64 : 128;
    static constexpr int STAGES = NSTAGES;
    static constexpr int PANEL = (MT + NT) * LK;
    static constexpr int CSLOTS = MT * NT * 4 <= 65536 ? 2 : 1;
    static_assert(STAGES * PANEL <= 524288, "L1 capacity exceeded");
    static_assert(2 * MT * FK <= 65536 && 2 * NT * FK <= 65536, "L0A/B capacity exceeded");
    static_assert(CSLOTS * MT * NT * 4 <= 131072, "L0C capacity exceeded");
    LocalTensor<int8_t> l1{TPosition::A1, 0, STAGES * PANEL};
    LocalTensor<int8_t> a0{TPosition::A2, 0, 2 * MT * FK};
    LocalTensor<int8_t> b0{TPosition::B2, 0, 2 * NT * FK};
    LocalTensor<int32_t> c0{TPosition::CO1, 0, CSLOTS * MT * NT};
    int fragmentSlot = 0;
    struct Pending
    {
        int slot, count, rows, cols, outputSlot;
        GM_ADDR output;
        bool first, last;
    };
    Pending pending[2];
    int head = 0, pendingCount = 0, producer = 0;

    __aicore__ inline void CopyNd(const LocalTensor<int8_t> &dst, const GlobalTensor<int8_t> &src,
                                  int rows, int cols, int stride, int paddedRows)
    {
        Nd2NzParams p;
        p.ndNum = 1;
        p.nValue = rows;
        p.dValue = cols;
        p.srcNdMatrixStride = 0;
        p.srcDValue = stride;
        p.dstNzC0Stride = paddedRows;
        p.dstNzNStride = 1;
        p.dstNzMatrixStride = 0;
        if (stride % 4 == 0)
        {
            GlobalTensor<float> wide;
            wide.SetGlobalBuffer((__gm__ float *)src.GetPhyAddr());
            p.dValue = (cols + 3) / 4;
            p.srcDValue /= 4;
            DataCopy(dst.template ReinterpretCast<float>(), wide, p);
        }
        else
            DataCopy(dst, src, p);
    }

    template <bool FULL> __aicore__ inline void ConsumeTile(const Pending &p)
    {
        const int cslot = p.outputSlot % CSLOTS;
        if (p.first)
            WaitFlag<HardEvent::FIX_M>(cslot);
        auto c = c0[cslot * MT * NT];
        WaitFlag<HardEvent::MTE2_MTE1>(p.slot);
        const int actualM = FULL || MT >= 256 ? MT : Up(p.rows, 16);
        const int activeN = FULL || MT >= 256 || actualM < 32 ? NT : Up(p.cols, 32);
        const int physicalK = FULL ? LK : p.count;
#pragma unroll
        for (int f = 0; f < physicalK; f += FK)
        {
            const int fk = Up(Min(FK, physicalK - f), 32);
            const int fs = fragmentSlot;
            WaitFlag<HardEvent::M_MTE1>(fs);
            auto aa = a0[fs * MT * FK];
            auto bb = b0[fs * NT * FK];
            auto la = l1[p.slot * PANEL + f * MT];
            auto lb = l1[p.slot * PANEL + MT * LK + f * 32];
            LoadData2DParams pa;
            pa.startIndex = 0;
            pa.repeatTimes = fk / 32;
            pa.srcStride = MT / 16;
            pa.dstGap = 0;
            pa.ifTranspose = false;
            pa.sid = 0;
            pa.addrMode = 0;
            for (int mi = 0; mi < (FULL ? MT / 16 : (p.rows + 15) / 16); ++mi)
                LoadData(aa[mi * fk * 16], la[mi * 512], pa);
            LoadData2dTransposeParams pb;
            pb.startIndex = 0;
            pb.repeatTimes = FULL ? NT / 32 : (p.cols + 31) / 32;
            pb.srcStride = LK / 32;
            pb.dstGap = 1;
            pb.dstFracGap = 0;
            for (int ki = 0; ki < fk / 32; ++ki)
                LoadDataWithTranspose(bb[ki * activeN * 32], lb[ki * 1024], pb);
            SetFlag<HardEvent::MTE1_M>(fs);
            WaitFlag<HardEvent::MTE1_M>(fs);
            MmadParams mm;
            mm.m = actualM;
            mm.n = activeN;
            mm.k = fk;
            mm.cmatrixInitVal = p.first && f == 0;
            mm.unitFlag = p.last && f + FK >= physicalK ? 3 : 2;
            Mmad(c, aa, bb, mm);
            if (actualM * activeN < 2560)
                PipeBarrier<PIPE_M>();
            SetFlag<HardEvent::M_MTE1>(fs);
            fragmentSlot ^= 1;
        }
        SetFlag<HardEvent::MTE1_MTE2>(p.slot);
        if (p.last)
        {
            GlobalTensor<int32_t> dst;
            dst.SetGlobalBuffer((__gm__ int32_t *)p.output);
            if constexpr (!SPLIT)
                CrossCoreWaitFlag(2 + p.outputSlot);
            FixpipeParamsV220 fp;
            fp.nSize = activeN;
            fp.mSize = MT >= 256 ? MT : p.rows;
            fp.srcStride = actualM;
            fp.dstStride = activeN;
            fp.quantPre = QuantMode_t::NoQuant;
            fp.reluEn = false;
            fp.unitFlag = 3;
            Fixpipe<int32_t, int32_t, CFG_ROW_MAJOR>(dst, c, fp);
            SetFlag<HardEvent::FIX_M>(cslot);
            if constexpr (!SPLIT)
                CrossCoreSetFlag<2, PIPE_FIX>(p.outputSlot);
        }
    }

    __aicore__ inline void Consume(const Pending &p)
    {
        if (p.rows == MT && p.cols == NT && p.count == LK)
            ConsumeTile<true>(p);
        else
            ConsumeTile<false>(p);
    }

  public:
    __aicore__ inline void Init()
    {
        SetLoadDataPaddingValue<uint64_t>(0);
        SetFixpipeNz2ndFlag(1, 0, 0);
        for (int i = 0; i < STAGES; ++i)
            SetFlag<HardEvent::MTE1_MTE2>(i);
        for (int i = 0; i < 2; ++i)
        {
            SetFlag<HardEvent::M_MTE1>(i);
        }
        for (int i = 0; i < CSLOTS; ++i)
            SetFlag<HardEvent::FIX_M>(i);
    }

    __aicore__ inline void Compute(const GlobalTensor<int8_t> &a, const GlobalTensor<int8_t> &b,
                                   const GlobalTensor<int32_t> &dst, int rows, int cols, int K,
                                   int N, int start, int depth, int outputSlot, int bKPad = 0)
    {
        const int panels = (depth + LK - 1) / LK;
        for (int p = 0; p < panels; ++p)
        {
            const int slot = producer;
            int ki = p;
            if constexpr (MT >= 64 && NT >= 128)
                ki = (p + GetBlockIdx()) % panels;
            const int count = Min(LK, depth - ki * LK);
            WaitFlag<HardEvent::MTE1_MTE2>(slot);
            CopyNd(l1[slot * PANEL], a[start + ki * LK], rows, count, K, MT);
            if constexpr (NZ)
                DataCopy(l1[slot * PANEL + MT * LK], b[int64_t(start + ki * LK) * 32],
                         DataCopyParams((cols + 31) / 32, Up(count, 32), bKPad - Up(count, 32),
                                        LK - Up(count, 32)));
            else
                CopyNd(l1[slot * PANEL + MT * LK], b[int64_t(start + ki * LK) * N], count, cols, N,
                       LK);
            SetFlag<HardEvent::MTE2_MTE1>(slot);
            // Keep two pending panels across output tiles, so the next tile's
            // input transfer overlaps the current tile's final MMAD/Fixpipe.
            if (pendingCount == (STAGES < 3 ? 1 : 2))
            {
                Consume(pending[head]);
                pending[head] = {slot,   count,          rows,
                                 cols,   outputSlot,     (GM_ADDR)dst.GetPhyAddr(),
                                 p == 0, p + 1 == panels};
                if constexpr (STAGES >= 3)
                    head ^= 1;
            }
            else
            {
                pending[(head + pendingCount) & 1] = {
                    slot,   count,          rows, cols, outputSlot, (GM_ADDR)dst.GetPhyAddr(),
                    p == 0, p + 1 == panels};
                ++pendingCount;
            }
            producer = producer + 1 < STAGES ? producer + 1 : 0;
        }
    }

    __aicore__ inline void Finish()
    {
        while (pendingCount)
        {
            Consume(pending[head]);
            if constexpr (STAGES >= 3)
                head ^= 1;
            --pendingCount;
        }
        for (int i = 0; i < STAGES; ++i)
            WaitFlag<HardEvent::MTE1_MTE2>(i);
        for (int i = 0; i < 2; ++i)
        {
            WaitFlag<HardEvent::M_MTE1>(i);
        }
        for (int i = 0; i < CSLOTS; ++i)
            WaitFlag<HardEvent::FIX_M>(i);
    }
};

template <int MT, int NT> class Epilogue
{
    static constexpr int ROWS = (MT + 1) / 2;
    static constexpr int SIZE = ROWS * NT;
    static_assert(SIZE * 10 + NT * 4 + 256 <= 196608, "UB capacity exceeded");
    LocalTensor<int32_t> accum{TPosition::VECCALC, 0, SIZE};
    LocalTensor<float> temporary{TPosition::VECCALC, SIZE * 4 + 256, SIZE};
    LocalTensor<half> output{TPosition::VECCALC, SIZE * 8 + 256, SIZE};
    LocalTensor<float> scales{TPosition::VECCALC, SIZE * 10 + 256, NT};

  public:
    __aicore__ inline void Run(const GlobalTensor<int32_t> &src, const GlobalTensor<float> &scale,
                               const GlobalTensor<half> &y, int row, int col, int rows, int cols,
                               int N, int expert, int shards = 1, int slot = 0)
    {
        const int pitch = MT >= 256 || Up(rows, 16) < 32 ? NT : Up(cols, 32);
        const int first = GetSubBlockIdx() * ((rows + 1) / 2);
        const int valid = GetSubBlockIdx() ? rows / 2 : (rows + 1) / 2;
        if (valid <= 0)
        {
            if (shards == 1)
                CrossCoreSetFlag<2, PIPE_MTE2>(2 + slot);
            return;
        }
        DataCopy(accum, src[first * pitch], valid * pitch);
        DataCopyPad(scales, scale[expert * N + col], DataCopyExtParams(1, cols * 4, 0, 0, 0),
                    DataCopyPadExtParams<float>{false, 0, 0, 0.0f});
        SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
        WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
        for (int s = 1; s < shards; ++s)
        {
            auto part = temporary.template ReinterpretCast<int32_t>();
            DataCopy(part, src[s * MT * NT + first * pitch], valid * pitch);
            SetFlag<HardEvent::MTE2_V>(EVENT_ID1);
            WaitFlag<HardEvent::MTE2_V>(EVENT_ID1);
            Add(accum, accum, part, valid * pitch);
            SetFlag<HardEvent::V_MTE2>(EVENT_ID1);
            WaitFlag<HardEvent::V_MTE2>(EVENT_ID1);
        }
        if (shards == 1)
            CrossCoreSetFlag<2, PIPE_MTE2>(2 + slot);
        auto z = accum.template ReinterpretCast<float>();
        Cast(z, accum, RoundMode::CAST_RINT, valid * pitch);
        PipeBarrier<PIPE_V>();
        // Repeat a channel vector across rows without materializing a broadcast.
        for (int r = 0; r < valid; r += 128)
            for (int c = 0; c < pitch; c += 64)
            {
                const int width = Min(64, pitch - c);
                Mul(z[r * pitch + c], z[r * pitch + c], scales[c], width, Min(128, valid - r),
                    {1, 1, 1, uint8_t(pitch / 8), uint8_t(pitch / 8), 0});
            }
        PipeBarrier<PIPE_V>();
        Gelu(z, temporary, output, valid * pitch);
        const bool compact =
            N == cols && col == 0 && N < NT && N <= 256 && N % 16 != 0 && valid >= 16;
        auto packed = temporary.template ReinterpretCast<half>();
        if (compact)
        {
            // Gather each narrow row into a contiguous UB stream. A single
            // MTE3 transfer avoids hundreds of short, unaligned row writes.
            const int count = valid * N;
            PipeBarrier<PIPE_V>();
            CreateVecIndex(accum, int32_t(0), count);
            PipeBarrier<PIPE_V>();
            Cast(temporary, accum, RoundMode::CAST_RINT, count);
            PipeBarrier<PIPE_V>();
            Muls(temporary, temporary, 1.0f / N, count);
            PipeBarrier<PIPE_V>();
            // i < 256*64: this bias dominates reciprocal rounding but is
            // smaller than the distance 1/N to the next integer boundary.
            Adds(temporary, temporary, 0.0001f, count);
            PipeBarrier<PIPE_V>();
            auto rows = temporary.template ReinterpretCast<int32_t>();
            Cast(rows, temporary, RoundMode::CAST_FLOOR, count);
            PipeBarrier<PIPE_V>();
            Muls(rows, rows, int32_t(2 * (pitch - N)), count);
            Muls(accum, accum, int32_t(2), count);
            PipeBarrier<PIPE_V>();
            Add(accum, accum, rows, count);
            PipeBarrier<PIPE_V>();
            Gather(packed, output, accum.template ReinterpretCast<uint32_t>(), 0, count);
        }
        SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
        WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
        if (compact)
            DataCopyPad(y[int64_t(row + first) * N], packed,
                        DataCopyExtParams(1, valid * N * 2, 0, 0, 0));
        else
            DataCopyPad(
                y[int64_t(row + first) * N + col], output,
                DataCopyExtParams(valid, cols * 2, (pitch - Up(cols, 16)) / 16, (N - cols) * 2, 0));
        SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
        WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
        SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
        WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
    }
};

__aicore__ inline void PackRows(const GlobalTensor<int8_t> &src, const GlobalTensor<int8_t> &dst,
                                int rows, int cols, int pitch, int workers)
{
    if (cols == pitch)
        return;
    LocalTensor<uint8_t> scratch(TPosition::VECCALC, 0, 65536);
    auto ub = scratch.ReinterpretCast<int8_t>();
    auto zero = scratch.ReinterpretCast<uint16_t>();
    const int rowsPerTile = Min(128, Min(65536 / pitch, Up((rows + workers - 1) / workers, 16)));
    const int tiles = (rows + rowsPerTile - 1) / rowsPerTile;
    SetFlag<HardEvent::MTE3_V>(EVENT_ID4);
    for (int tile = GetBlockIdx(); tile < tiles; tile += workers)
    {
        const int row = tile * rowsPerTile;
        const int count = Min(rowsPerTile, rows - row);
        WaitFlag<HardEvent::MTE3_V>(EVENT_ID4);
        Duplicate(zero, uint16_t(0), count * pitch / 2);
        SetFlag<HardEvent::V_MTE2>(EVENT_ID4);
        WaitFlag<HardEvent::V_MTE2>(EVENT_ID4);
        DataCopyPad(ub, src[int64_t(row) * cols],
                    DataCopyExtParams(count, cols, 0, (pitch - Up(cols, 32)) / 32, 0),
                    DataCopyPadExtParams<int8_t>{true, 0, uint8_t(Up(cols, 32) - cols), 0});
        SetFlag<HardEvent::MTE2_MTE3>(EVENT_ID4);
        WaitFlag<HardEvent::MTE2_MTE3>(EVENT_ID4);
        DataCopy(dst[int64_t(row) * pitch], ub, count * pitch);
        SetFlag<HardEvent::MTE3_V>(EVENT_ID4);
    }
    WaitFlag<HardEvent::MTE3_V>(EVENT_ID4);
}

template <int MT, int NT>
__aicore__ inline void Coordinates(int tile, int length, int nTiles, int &row, int &col)
{
    if constexpr (MT >= 64 && NT >= 128)
    {
        const int mTiles = (length + MT - 1) / MT;
        const int first = tile / (8 * nTiles) * 8;
        const int height = Min(8, mTiles - first);
        const int local = tile % (8 * nTiles);
        row = (first + local % height) * MT;
        col = local / height * NT;
    }
    else
    {
        row = tile / nTiles * MT;
        col = tile % nTiles * NT;
    }
}

template <int MT, int NT, bool SPLIT, int LK = 256, int ST = 3>
__global__ __mix__(1, 2)
    __attribute__((aligned(4096))) void Grouped(GM_ADDR x, GM_ADDR weight, GM_ADDR scale,
                                                GM_ADDR groups, GM_ADDR y, GM_ADDR workspace, int M,
                                                int K, int N, int E, int workers, int shards,
                                                int shardDepth, GM_ADDR packedA, GM_ADDR packedB,
                                                int aPitch, int bPitch)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
    SetAtomicNone();
    int core = GetBlockIdx();
    if ASCEND_IS_AIV
    {
        core /= GetSubBlockNum();
    }
    GlobalTensor<int8_t> a, b;
    GlobalTensor<float> s;
    GlobalTensor<int64_t> g;
    GlobalTensor<int32_t> buffer;
    GlobalTensor<half> result;
    a.SetGlobalBuffer((__gm__ int8_t *)x);
    b.SetGlobalBuffer((__gm__ int8_t *)weight);
    s.SetGlobalBuffer((__gm__ float *)scale);
    g.SetGlobalBuffer((__gm__ int64_t *)groups);
    buffer.SetGlobalBuffer((__gm__ int32_t *)workspace);
    result.SetGlobalBuffer((__gm__ half *)y);
    const int nTiles = (N + NT - 1) / NT;
    if (packedA != nullptr || packedB != nullptr)
    {
        if ASCEND_IS_AIV
        {
            TPipe packPipe;
            SetMaskNorm();
            SetVectorMask<uint8_t>(~uint64_t(0), ~uint64_t(0));
            if (packedA != nullptr)
            {
                GlobalTensor<int8_t> pa;
                pa.SetGlobalBuffer((__gm__ int8_t *)packedA);
                PackRows(a, pa, M, K, aPitch, workers * 2);
            }
            if (packedB != nullptr)
            {
                GlobalTensor<int8_t> pb;
                pb.SetGlobalBuffer((__gm__ int8_t *)packedB);
                PackRows(b, pb, E * K, N, bPitch, workers * 2);
            }
            CrossCoreSetFlag<0, PIPE_MTE3>(10);
            CrossCoreWaitFlag(10);
            CrossCoreSetFlag<2, PIPE_MTE3>(8);
        }
        if ASCEND_IS_AIC
        {
            CrossCoreWaitFlag(8);
        }
        if (packedA != nullptr)
            a.SetGlobalBuffer((__gm__ int8_t *)packedA);
        if (packedB != nullptr)
            b.SetGlobalBuffer((__gm__ int8_t *)packedB);
    }
    if ASCEND_IS_AIC
    {
        Cube<MT, NT, SPLIT, LK, ST> cube;
        cube.Init();
        int base = 0, start = 0, next = core, sequence = 0;
        for (int expert = 0; expert < E; ++expert)
        {
            const int end = g.GetValue(expert);
            const int length = end - start;
            const int tiles = (length + MT - 1) / MT * nTiles;
            const int jobs = tiles * shards;
            while (next < base + jobs)
            {
                const int local = next - base;
                const int shard = SPLIT ? local % shards : 0;
                const int tile = SPLIT ? local / shards : local;
                int row, col;
                Coordinates<MT, NT>(tile, length, nTiles, row, col);
                const int slot = sequence & 1;
                const int64_t offset =
                    SPLIT ? int64_t(next) * MT * NT : int64_t(core * 2 + slot) * MT * NT;
                cube.Compute(a[int64_t(start + row) * aPitch],
                             b[int64_t(expert) * K * bPitch + col], buffer[offset],
                             Min(MT, length - row), Min(NT, N - col), aPitch, bPitch,
                             shard * shardDepth, Min(shardDepth, K - shard * shardDepth), slot);
                next += workers;
                ++sequence;
            }
            base += jobs;
            start = end;
        }
        cube.Finish();
        if constexpr (SPLIT)
            CrossCoreSetFlag<2, PIPE_FIX>(6);
    }
    if ASCEND_IS_AIV
    {
        TPipe pipe;
        SetMaskNorm();
        SetVectorMask<uint8_t>(~uint64_t(0), ~uint64_t(0));
        Epilogue<MT, NT> epilogue;
        if constexpr (SPLIT)
        {
            // Every Vector first waits for its own Cube.  The subsequent
            // all-Vector barrier makes all other producers visible as well.
            CrossCoreWaitFlag(6);
            CrossCoreSetFlag<0, PIPE_MTE2>(9);
            CrossCoreWaitFlag(9);
        }
        else
        {
            CrossCoreSetFlag<2, PIPE_MTE2>(2);
            CrossCoreSetFlag<2, PIPE_MTE2>(3);
        }
        int base = 0, start = 0, next = core, sequence = 0;
        for (int expert = 0; expert < E; ++expert)
        {
            const int end = g.GetValue(expert);
            const int length = end - start;
            const int tiles = (length + MT - 1) / MT * nTiles;
            while (next < base + tiles)
            {
                const int tile = next - base;
                int row, col;
                Coordinates<MT, NT>(tile, length, nTiles, row, col);
                const int slot = sequence & 1;
                const int64_t offset =
                    SPLIT ? int64_t(next) * shards * MT * NT : int64_t(core * 2 + slot) * MT * NT;
                if constexpr (!SPLIT)
                    CrossCoreWaitFlag(slot);
                epilogue.Run(buffer[offset], s, result, start + row, col, Min(MT, length - row),
                             Min(NT, N - col), N, expert, shards, slot);
                next += workers;
                ++sequence;
            }
            base += tiles;
            start = end;
        }
    }
}

// Each invocation owns its workspace; no state survives an evaluation round.
// Complete before returning because the asynchronous device kernel uses it.
class Workspace
{
    void *pointer = nullptr;
    aclrtStream stream;

  public:
    Workspace(size_t bytes, aclrtStream executionStream) : stream(executionStream)
    {
        aclrtMalloc(&pointer, bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    }
    Workspace(const Workspace &) = delete;
    Workspace &operator=(const Workspace &) = delete;
    ~Workspace()
    {
        if (pointer)
        {
            aclrtSynchronizeStream(stream);
            aclrtFree(pointer);
        }
    }
    GM_ADDR Data() const
    {
        return (GM_ADDR)pointer;
    }
    void Complete()
    {
        const aclError synchronized = aclrtSynchronizeStream(stream);
        const aclError released = aclrtFree(pointer);
        if (released == ACL_SUCCESS)
            pointer = nullptr;
        (void)synchronized;
    }
};

template <int MT, int NT, int LK = 256, int ST = 3>
inline void Launch(GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR g, GM_ADDR y, int M, int K, int N,
                   int E, int cores, aclrtStream stream)
{
    // ceil(M/MT)+E-1 bounds sum_e ceil(M_e/MT), including arbitrary empties.
    const int maxTiles = ((M + MT - 1) / MT + E - 1) * ((N + NT - 1) / NT);
    const int workers = std::min(cores, maxTiles);
    int shards = 1;
    if (K >= 1024 && maxTiles < cores)
        shards = std::min(cores / maxTiles, (K + 255) / 256);
    const int shardDepth = (K + shards * 32 - 1) / (shards * 32) * 32;
    shards = (K + shardDepth - 1) / shardDepth;
    const bool pack = M >= 512 && M >= E * 64 && K >= 64 && (K % 64 || N % 64);
    const int aPitch = pack && K % 64 ? (K + 255) / 256 * 256 : K;
    const int bPitch = pack && N % 64 ? (N + 255) / 256 * 256 : N;
    const size_t aBytes = aPitch != K ? size_t(M) * aPitch : 0;
    const size_t bBytes = bPitch != N ? size_t(E) * K * bPitch : 0;
    if (shards > 1)
    {
        const int splitWorkers = std::min(cores, maxTiles * shards);
        const size_t bytes = size_t(maxTiles) * shards * MT * NT * sizeof(int32_t);
        Workspace workspace(bytes + aBytes + bBytes, stream);
        GM_ADDR memory = workspace.Data();
        if (!memory)
            return;
        Grouped<MT, NT, true, LK, ST><<<splitWorkers, nullptr, stream>>>(
            x, w, s, g, y, memory, M, K, N, E, splitWorkers, shards, shardDepth,
            aBytes ? memory + bytes : nullptr, bBytes ? memory + bytes + aBytes : nullptr, aPitch,
            bPitch);
        workspace.Complete();
    }
    else
    {
        const size_t bytes = size_t(workers) * 2 * MT * NT * sizeof(int32_t);
        Workspace workspace(bytes + aBytes + bBytes, stream);
        GM_ADDR memory = workspace.Data();
        if (!memory)
            return;
        Grouped<MT, NT, false, LK, ST><<<workers, nullptr, stream>>>(
            x, w, s, g, y, memory, M, K, N, E, workers, 1, K, aBytes ? memory + bytes : nullptr,
            bBytes ? memory + bytes + aBytes : nullptr, aPitch, bPitch);
        workspace.Complete();
    }
}
}

namespace preloaded_small
{
using namespace AscendC;

__aicore__ inline uint16_t HalfBits(float value)
{
    union
    {
        float value;
        uint32_t bits;
    } input;
    input.value = value;
    const uint32_t sign = (input.bits >> 16) & 0x8000u;
    const uint32_t magnitude = input.bits & 0x7fffffffu;
    if (magnitude < 0x33000000u)
        return uint16_t(sign);
    if (magnitude < 0x38800000u)
    {
        const uint32_t shift = 126u - (magnitude >> 23);
        const uint32_t mantissa = (magnitude & 0x7fffffu) | 0x800000u;
        const uint32_t bias = (1u << (shift - 1u)) - 1u + ((mantissa >> shift) & 1u);
        return uint16_t(sign | ((mantissa + bias) >> shift));
    }
    const uint32_t rounded = magnitude + 0xfffu + ((magnitude >> 13) & 1u);
    return uint16_t(sign | ((rounded >> 13) - 0x1c000u));
}

__aicore__ inline float GeluScalar(float value)
{
#pragma clang fp contract(on)
    if (value >= 4.0f)
        return value;
    if (value <= -4.0f)
        return 0.0f;
    const float t = value < 0.0f ? -value : value;
    const float t2 = t * t;
    const float t4 = t2 * t2;
    const float p0 = -0.38792046904563904f * t + 0.49933210015296936f;
    const float p1 = 0.13936932384967804f * t - 0.04414942115545273f;
    const float p2 = 0.00977316964417696f * t - 0.05697789043188095f;
    const float p = (p0 + p1 * t2) + (p2 - 0.0006304466514848173f * t2) * t4;
    const float correction = p * t;
    return (value > 0.0f ? value : 0.0f) - (correction > 0.0f ? correction : 0.0f);
}

template <int K, int N, int SHIFT>
__aicore__ inline void PackedDot(const int32_t *activation, const GlobalTensor<int8_t> &b,
                                 const GlobalTensor<float> &s, const LocalTensor<half> &out,
                                 int expert, int E)
{
#pragma clang fp contract(off)
    constexpr int WORDS = (SHIFT + K * N + 3) / 4;
    uint32_t packed[WORDS];
    GlobalTensor<uint32_t> wide;
    wide.SetGlobalBuffer((__gm__ uint32_t *)b.GetPhyAddr());
    const int base = expert * K * N / 4;
#pragma unroll
    for (int i = 0; i < WORDS; ++i)
    {
        const int offset = 4 * (base + i);
        uint32_t value = 0;
        if (offset + 4 <= E * K * N)
            value = wide.GetValue(base + i);
        else
        {
#pragma unroll
            for (int byte = 0; byte < 4; ++byte)
                if (offset + byte < E * K * N)
                    value |= uint32_t(uint8_t(b.GetValue(offset + byte))) << (byte * 8);
        }
        packed[i] = value;
    }
#pragma unroll
    for (int n = 0; n < N; ++n)
    {
        int32_t dot = 0;
#pragma unroll
        for (int k = 0; k < K; ++k)
        {
            const int index = SHIFT + k * N + n;
            const int32_t value = int32_t(int8_t(packed[index / 4] >> (index % 4 * 8)));
            dot += activation[k] * value;
        }
        const float value = float(dot) * s.GetValue(expert * N + n);
        out.template ReinterpretCast<uint16_t>().SetValue(n, HalfBits(GeluScalar(value)));
    }
}

template <int K, int N>
__global__ __vector__ __attribute__((aligned(4096))) void
Preloaded(GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groups, GM_ADDR y, int M, int E,
          int workers)
{
#pragma clang fp contract(off)
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    InitSocState();
    ICachePreLoad(int64_t(2));
    GlobalTensor<int8_t> a, b;
    GlobalTensor<float> s;
    GlobalTensor<int64_t> g;
    GlobalTensor<half> result;
    a.SetGlobalBuffer((__gm__ int8_t *)x);
    b.SetGlobalBuffer((__gm__ int8_t *)weight);
    s.SetGlobalBuffer((__gm__ float *)scale);
    g.SetGlobalBuffer((__gm__ int64_t *)groups);
    result.SetGlobalBuffer((__gm__ half *)y);
    GlobalTensor<uint64_t> pa, pb, ps, pg;
    pa.SetGlobalBuffer((__gm__ uint64_t *)x);
    pb.SetGlobalBuffer((__gm__ uint64_t *)weight);
    ps.SetGlobalBuffer((__gm__ uint64_t *)scale);
    pg.SetGlobalBuffer((__gm__ uint64_t *)groups);
    DataCachePreload(pg, int16_t(0));
    DataCachePreload(pa, int16_t(0));
    DataCachePreload(pb, int16_t(0));
    DataCachePreload(ps, int16_t(0));
    LocalTensor<half> out(TPosition::VECOUT, 128, 16);
    const int row = GetBlockIdx();
    int expert = 0;
    if (E <= 4)
    {
        if (E > 1)
            expert += int(row >= g.GetValue(0));
        if (E > 2)
            expert += int(row >= g.GetValue(1));
        if (E > 3)
            expert += int(row >= g.GetValue(2));
    }
    else
    {
        int low = 0, high = E - 1;
        while (low < high)
        {
            const int mid = (low + high) / 2;
            if (g.GetValue(mid) <= row)
                low = mid + 1;
            else
                high = mid;
        }
        expert = low;
    }
    int32_t activation[K];
#pragma unroll
    for (int k = 0; k < K; ++k)
        activation[k] = int32_t(a.GetValue(row * K + k));
    if constexpr (K * N % 4 == 0)
        PackedDot<K, N, 0>(activation, b, s, out, expert, E);
    else
    {
        const int shift = expert * K * N % 4;
        if (shift == 0)
            PackedDot<K, N, 0>(activation, b, s, out, expert, E);
        else if (shift == 1)
            PackedDot<K, N, 1>(activation, b, s, out, expert, E);
        else if (shift == 2)
            PackedDot<K, N, 2>(activation, b, s, out, expert, E);
        else
            PackedDot<K, N, 3>(activation, b, s, out, expert, E);
    }
    SetFlag<HardEvent::S_MTE3>(EVENT_ID0);
    WaitFlag<HardEvent::S_MTE3>(EVENT_ID0);
    DataCopyPad(result[int64_t(row) * N], out, DataCopyExtParams(1, N * 2, 0, 0, 0));
    SetFlag<HardEvent::MTE3_S>(EVENT_ID0);
    WaitFlag<HardEvent::MTE3_S>(EVENT_ID0);
}

template <int K>
inline void LaunchWidth(GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR g, GM_ADDR y, int M, int N, int E,
                        int workers, aclrtStream stream)
{
    if (N == 1)
    {
        Preloaded<K, 1><<<workers, nullptr, stream>>>(x, w, s, g, y, M, E, workers);
        return;
    }
    if (N == 2)
    {
        Preloaded<K, 2><<<workers, nullptr, stream>>>(x, w, s, g, y, M, E, workers);
        return;
    }
    if (N == 3)
    {
        Preloaded<K, 3><<<workers, nullptr, stream>>>(x, w, s, g, y, M, E, workers);
        return;
    }
    if (N == 4)
    {
        Preloaded<K, 4><<<workers, nullptr, stream>>>(x, w, s, g, y, M, E, workers);
        return;
    }
    if (N == 5)
    {
        Preloaded<K, 5><<<workers, nullptr, stream>>>(x, w, s, g, y, M, E, workers);
        return;
    }
    if (N == 6)
    {
        Preloaded<K, 6><<<workers, nullptr, stream>>>(x, w, s, g, y, M, E, workers);
        return;
    }
    if (N == 7)
    {
        Preloaded<K, 7><<<workers, nullptr, stream>>>(x, w, s, g, y, M, E, workers);
        return;
    }
    if (N == 8)
    {
        Preloaded<K, 8><<<workers, nullptr, stream>>>(x, w, s, g, y, M, E, workers);
        return;
    }
}

inline void Launch(GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR g, GM_ADDR y, int M, int K, int N,
                   int E, int workers, aclrtStream stream)
{
    if (workers < M)
    {
        grouped_gelu::Small<true><<<workers, nullptr, stream>>>(x, w, s, g, y, M, K, N, E, workers);
        return;
    }

    if (K <= 1)
        LaunchWidth<1>(x, w, s, g, y, M, N, E, workers, stream);
    else if (K <= 2)
        LaunchWidth<2>(x, w, s, g, y, M, N, E, workers, stream);
    else if (K <= 3)
        LaunchWidth<3>(x, w, s, g, y, M, N, E, workers, stream);
    else
        LaunchWidth<4>(x, w, s, g, y, M, N, E, workers, stream);
}
}

namespace product
{
using namespace AscendC;
__global__ __vector__ __attribute__((aligned(4096))) void
Product(GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groups, GM_ADDR y, int E, int workers)
{
#pragma clang fp contract(off)
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    InitSocState();
    GlobalTensor<int8_t> a, b;
    GlobalTensor<float> scales;
    GlobalTensor<half> out;
    a.SetGlobalBuffer((__gm__ int8_t *)x);
    b.SetGlobalBuffer((__gm__ int8_t *)weight);
    scales.SetGlobalBuffer((__gm__ float *)scale);
    out.SetGlobalBuffer((__gm__ half *)y);
    GlobalTensor<int64_t> ends;
    ends.SetGlobalBuffer((__gm__ int64_t *)groups);
    GlobalTensor<uint64_t> preGroups, preA, preB, preScale;
    preGroups.SetGlobalBuffer((__gm__ uint64_t *)groups);
    preA.SetGlobalBuffer((__gm__ uint64_t *)x);
    preB.SetGlobalBuffer((__gm__ uint64_t *)weight);
    preScale.SetGlobalBuffer((__gm__ uint64_t *)scale);
    DataCachePreload(preGroups[0], int16_t(0));
    DataCachePreload(preA[0], int16_t(0));
    DataCachePreload(preB[0], int16_t(0));
    DataCachePreload(preScale[0], int16_t(0));
    const int expert = GetBlockIdx();
    if (ends.GetValue(expert) == (expert ? ends.GetValue(expert - 1) : 0))
        return;
    const int32_t dot = int32_t(a.GetValue(0)) * int32_t(b.GetValue(expert));
    const float value = float(dot) * scales.GetValue(expert);
    if (value <= -8.0f || value == 0.0f)
    {
        LocalTensor<uint16_t> zero(TPosition::VECOUT, 128, 16);
        zero.SetValue(0, uint16_t(0));
        SetFlag<HardEvent::S_MTE3>(EVENT_ID1);
        WaitFlag<HardEvent::S_MTE3>(EVENT_ID1);
        DataCopyPad(out, zero.ReinterpretCast<half>(), DataCopyExtParams(1, 2, 0, 0, 0));
        SetFlag<HardEvent::MTE3_S>(EVENT_ID1);
        WaitFlag<HardEvent::MTE3_S>(EVENT_ID1);
        return;
    }
    if (value >= 8.0f)
    {
        LocalTensor<float> direct(TPosition::VECCALC, 0, 8);
        LocalTensor<half> rounded(TPosition::VECOUT, 128, 16);
        direct.SetValue(0, value);
        SetFlag<HardEvent::S_V>(EVENT_ID0);
        WaitFlag<HardEvent::S_V>(EVENT_ID0);
        Cast(rounded, direct, RoundMode::CAST_RINT, 1);
        SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
        WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
        DataCopyPad(out, rounded, DataCopyExtParams(1, 2, 0, 0, 0));
        SetFlag<HardEvent::MTE3_S>(EVENT_ID0);
        WaitFlag<HardEvent::MTE3_S>(EVENT_ID0);
        return;
    }
    float exponent = value * value;
    exponent = exponent * 0.044715f;
    exponent = exponent + 1.0f;
    exponent = exponent * value;
    exponent = exponent * -1.5957691216057308f;
    if (exponent > 80.0f)
        exponent = 80.0f;
    if (exponent < -80.0f)
        exponent = -80.0f;
    LocalTensor<float> z{TPosition::VECCALC, 0, 8};
    LocalTensor<float> u{TPosition::VECCALC, 32, 8};
    LocalTensor<float> t{TPosition::VECCALC, 64, 8};
    LocalTensor<float> f{TPosition::VECCALC, 96, 8};
    LocalTensor<half> o{TPosition::VECOUT, 128, 16};
    z.SetValue(0, value);
    u.SetValue(0, exponent);
    SetFlag<HardEvent::S_V>(EVENT_ID0);
    WaitFlag<HardEvent::S_V>(EVENT_ID0);
    Exp(t, u, 1);
    PipeBarrier<PIPE_V>();
    Adds(t, t, 1.0f, 1);
    PipeBarrier<PIPE_V>();
    Div(f, z, t, 1);
    PipeBarrier<PIPE_V>();
    Cast(o, f, RoundMode::CAST_RINT, 1);
    SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
    WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
    DataCopyPad(out, o, DataCopyExtParams(1, 2, 0, 0, 0));
    SetFlag<HardEvent::MTE3_S>(EVENT_ID0);
    WaitFlag<HardEvent::MTE3_S>(EVENT_ID0);
}

}

namespace short_dense
{
using namespace AscendC;
using grouped_gelu::Min;
using grouped_gelu::Up;
using grouped_gelu::Workspace;

template <int MT, int NT, int DK, bool WIDE, bool EARLY_SCALE, bool PIPE_OBJECT, int ACTIVATION,
          bool UNROLL, bool LOAD_B_FIRST, bool FULL = false>
__global__ __mix__(1, 2)
    __attribute__((aligned(4096))) void Dense(GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR y,
                                              GM_ADDR workspace, int M, int inputK, int inputN)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
    SetAtomicNone();
    const int K = FULL ? DK : inputK, N = FULL ? NT : inputN;
    int core = GetBlockIdx();
    if ASCEND_IS_AIV
    {
        core /= GetSubBlockNum();
    }
    const int columns = (N + NT - 1) / NT;
    const int row = core / columns * MT, col = core % columns * NT;
    const int rows = FULL ? MT : Min(MT, M - row), cols = FULL ? NT : Min(NT, N - col);
    const int actualM = Up(rows, 16), actualN = cols;
    GlobalTensor<int8_t> a, b;
    GlobalTensor<int32_t> buffer;
    GlobalTensor<float> scales;
    GlobalTensor<half> output;
    a.SetGlobalBuffer((__gm__ int8_t *)x);
    b.SetGlobalBuffer((__gm__ int8_t *)weight);
    scales.SetGlobalBuffer((__gm__ float *)scale);
    output.SetGlobalBuffer((__gm__ half *)y);
    buffer.SetGlobalBuffer((__gm__ int32_t *)workspace + core * (MT * NT + 2048));
    if ASCEND_IS_AIC
    {
        LocalTensor<int8_t> l1{TPosition::A1, 0, (MT + NT) * DK};
        LocalTensor<int8_t> a0{TPosition::A2, 0, MT * DK};
        LocalTensor<int8_t> b0{TPosition::B2, 0, NT * DK};
        LocalTensor<int32_t> c0{TPosition::CO1, 0, MT * NT};
        SetLoadDataPaddingValue<uint64_t>(0);
        SetFixpipeNz2ndFlag(1, 0, 0);
        Nd2NzParams pa;
        pa.ndNum = 1;
        pa.nValue = rows;
        pa.dValue = K;
        pa.srcNdMatrixStride = 0;
        pa.srcDValue = K;
        pa.dstNzC0Stride = MT;
        pa.dstNzNStride = 1;
        pa.dstNzMatrixStride = 0;
        Nd2NzParams pb = pa;
        pb.nValue = K;
        pb.dValue = cols;
        pb.srcDValue = N;
        pb.ndNum = K / 32;
        pb.nValue = 32;
        pb.srcNdMatrixStride = 32 * N;
        pb.dstNzC0Stride = 32;
        pb.dstNzMatrixStride = NT * 32;
        if constexpr (WIDE)
        {
            GlobalTensor<float> aw, bw;
            aw.SetGlobalBuffer((__gm__ float *)x + row * K / 4);
            bw.SetGlobalBuffer((__gm__ float *)weight + col / 4);
            pa.dValue /= 4;
            pa.srcDValue /= 4;
            pb.dValue /= 4;
            pb.srcDValue /= 4;
            pb.srcNdMatrixStride /= 4;
            pb.dstNzMatrixStride /= 4;
            if constexpr (LOAD_B_FIRST)
            {
                DataCopy(l1[MT * DK].template ReinterpretCast<float>(), bw, pb);
                DataCopy(l1.template ReinterpretCast<float>(), aw, pa);
            }
            else
            {
                DataCopy(l1.template ReinterpretCast<float>(), aw, pa);
                DataCopy(l1[MT * DK].template ReinterpretCast<float>(), bw, pb);
            }
        }
        else
        {
            if constexpr (LOAD_B_FIRST)
            {
                DataCopy(l1[MT * DK], b[col], pb);
                DataCopy(l1, a[row * K], pa);
            }
            else
            {
                DataCopy(l1, a[row * K], pa);
                DataCopy(l1[MT * DK], b[col], pb);
            }
        }
        SetFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);
        WaitFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);
        LoadData2DParams la;
        la.startIndex = 0;
        la.repeatTimes = K / 32;
        la.srcStride = MT / 16;
        la.dstGap = 0;
        la.ifTranspose = false;
        la.sid = 0;
        la.addrMode = 0;
        if constexpr (UNROLL)
        {
#pragma unroll
            for (int mi = 0; mi < MT / 16; ++mi)
                if (mi * 16 < rows)
                    LoadData(a0[mi * K * 16], l1[mi * 512], la);
        }
        else
        {
            for (int mi = 0; mi < (rows + 15) / 16; ++mi)
                LoadData(a0[mi * K * 16], l1[mi * 512], la);
        }
        LoadData2dTransposeParams lb;
        lb.startIndex = 0;
        lb.repeatTimes = actualN / 32;
        lb.srcStride = DK / 32;
        lb.dstGap = 1;
        lb.dstFracGap = 0;
        lb.repeatTimes = K / 32 * (actualN / 32);
        lb.srcStride = 1;
        LoadDataWithTranspose(b0, l1[MT * DK], lb);
        SetFlag<HardEvent::MTE1_M>(EVENT_ID0);
        WaitFlag<HardEvent::MTE1_M>(EVENT_ID0);
        MmadParams mm;
        mm.m = actualM;
        mm.n = actualN;
        mm.k = K;
        mm.cmatrixInitVal = true;
        mm.unitFlag = 3;
        Mmad(c0, a0, b0, mm);
        FixpipeParamsV220 fp;
        fp.nSize = actualN;
        fp.mSize = rows;
        fp.srcStride = actualM;
        fp.dstStride = NT;
        fp.quantPre = QuantMode_t::NoQuant;
        fp.reluEn = false;
        fp.unitFlag = 3;
        Fixpipe<int32_t, int32_t, CFG_ROW_MAJOR>(buffer, c0, fp);
        CrossCoreSetFlag<2, PIPE_FIX>(0);
    }
    if ASCEND_IS_AIV
    {
        if constexpr (PIPE_OBJECT)
        {
            TPipe pipe;
        }
        SetMaskNorm();
        SetVectorMask<uint8_t>(~uint64_t(0), ~uint64_t(0));
        constexpr int SIZE = (MT + 1) / 2 * NT;
        LocalTensor<int32_t> accum{TPosition::VECCALC, 0, SIZE};
        LocalTensor<float> t{TPosition::VECCALC, SIZE * 4 + 256, SIZE};
        LocalTensor<half> out{TPosition::VECCALC, SIZE * 8 + 256, SIZE};
        LocalTensor<float> s{TPosition::VECCALC, SIZE * 10 + 256, NT};
        const int first = GetSubBlockIdx() * ((rows + 1) / 2);
        const int valid = GetSubBlockIdx() ? rows / 2 : (rows + 1) / 2;
        LocalTensor<float> fullScale{TPosition::VECCALC, SIZE * 10 + NT * 4 + 256, SIZE};
        DataCopy(s, scales[col], cols);
        SetFlag<HardEvent::MTE2_V>(EVENT_ID1);
        WaitFlag<HardEvent::MTE2_V>(EVENT_ID1);
        if (valid > 0)
            for (int c = 0; c < cols; c += 64)
                Copy(fullScale[c], s[c], Min(64, cols - c), valid, {1, 1, uint8_t(NT / 8), 0});
        PipeBarrier<PIPE_V>();
        LocalTensor<float> square{TPosition::VECCALC, SIZE * 14 + NT * 4 + 256, SIZE};
        if (valid > 0)
            Duplicate(t, -1.5957691216057308f, valid * NT);
        CrossCoreWaitFlag(0);
        if (valid > 0)
        {
            DataCopy(accum, buffer[first * NT], valid * NT);

            SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
            WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
            auto z = accum.template ReinterpretCast<float>();
            Cast(z, accum, RoundMode::CAST_RINT, valid * NT);
            PipeBarrier<PIPE_V>();
            Mul(z, z, fullScale, valid * NT);
            PipeBarrier<PIPE_V>();
            Mul(square, z, z, valid * NT);
            PipeBarrier<PIPE_V>();
            Axpy(t, square, -0.07135481627260025f, valid * NT);
            PipeBarrier<PIPE_V>();
            Mul(t, t, z, valid * NT);
            PipeBarrier<PIPE_V>();
            Mins(t, t, 88.0f, valid * NT);
            PipeBarrier<PIPE_V>();
            Exp(t, t, valid * NT);
            PipeBarrier<PIPE_V>();
            Adds(t, t, 1.0f, valid * NT);
            PipeBarrier<PIPE_V>();
            if constexpr (ACTIVATION == 1)
            {
                Reciprocal(t, t, valid * NT);
                PipeBarrier<PIPE_V>();
                Mul(z, z, t, valid * NT);
                PipeBarrier<PIPE_V>();
            }
            else
            {
                Div(z, z, t, valid * NT);
                PipeBarrier<PIPE_V>();
            }
            Cast(out, z, RoundMode::CAST_RINT, valid * NT);
            SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
            WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
            if (cols == NT && N == NT)
                DataCopy(output[(row + first) * N + col], out, valid * NT);
            else
                DataCopyPad(
                    output[(row + first) * N + col], out,
                    DataCopyExtParams(valid, cols * 2, (NT - cols) / 16, (N - cols) * 2, 0));
        }
    }
}

template <int MT, int NT, int DK, bool WIDE, bool EARLY_SCALE, bool PIPE_OBJECT, int ACTIVATION,
          bool UNROLL, bool LOAD_B_FIRST>
inline bool Launch(GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR y, int M, int K, int N, int E,
                   int cores, aclrtStream stream)
{
    const int tasks = (M + MT - 1) / MT * ((N + NT - 1) / NT);
    if (E != 1 || N % NT || K % 32 || K > DK || N > NT * 4 || tasks > cores)
        return false;
    Workspace memory(size_t(tasks) * (MT * NT + 2048) * 4, stream);
    if (!memory.Data())
        return false;
    if (K == DK && N == NT && M % MT == 0)
        Dense<MT, NT, DK, WIDE, EARLY_SCALE, PIPE_OBJECT, ACTIVATION, UNROLL, LOAD_B_FIRST, true>
            <<<tasks, nullptr, stream>>>(x, w, s, y, memory.Data(), M, K, N);
    else
        Dense<MT, NT, DK, WIDE, EARLY_SCALE, PIPE_OBJECT, ACTIVATION, UNROLL, LOAD_B_FIRST>
            <<<tasks, nullptr, stream>>>(x, w, s, y, memory.Data(), M, K, N);
    memory.Complete();
    return true;
}
}

namespace resident_wide_prefetch
{
using grouped_gelu::Workspace;
constexpr int CACHE_K = 2048;
using namespace AscendC;
using grouped_gelu::Min;
using grouped_gelu::Up;

using grouped_gelu::Gelu;

template <int MT, int NT, int NSTAGES = 3, int LK = 256> class CachedACube
{
    static constexpr int FK = (NT > 512 || MT > 512) ? 32 : ((NT > 256 || MT >= 256) ? 64 : 128);
    static constexpr int STAGES = NSTAGES;
    static constexpr int AK = 2048;
    static constexpr int APANEL = MT * AK;
    static constexpr int BPANEL = NT * LK;
    static_assert(APANEL + STAGES * BPANEL <= 524288, "cached A/L1 capacity exceeded");
    static_assert(2 * MT * FK <= 65536 && 2 * NT * FK <= 65536, "L0A/B capacity exceeded");
    static_assert(MT * NT * 4 <= 131072, "L0C capacity exceeded");
    LocalTensor<int8_t> aCache{TPosition::A1, 0, APANEL};
    LocalTensor<int8_t> bL1{TPosition::A1, APANEL, STAGES * BPANEL};
    LocalTensor<int8_t> a0{TPosition::A2, 0, 2 * MT * FK};
    LocalTensor<int8_t> b0{TPosition::B2, 0, 2 * NT * FK};
    LocalTensor<int32_t> c0{TPosition::CO1, 0, MT * NT};
    int fragmentSlot = 0;
    struct Pending
    {
        int slot, count, rows, cols, outputSlot, kStart;
        GM_ADDR output;
        bool first, last;
    };

    static constexpr int QUEUE = STAGES;
    Pending pending[QUEUE];
    int head = 0, pendingCount = 0, producer = 0;

    __aicore__ inline void CopyNd(const LocalTensor<int8_t> &dst, const GlobalTensor<int8_t> &src,
                                  int rows, int cols, int stride, int paddedRows)
    {
        Nd2NzParams p;
        p.ndNum = 1;
        p.nValue = rows;
        p.dValue = cols;
        p.srcNdMatrixStride = 0;
        p.srcDValue = stride;
        p.dstNzC0Stride = paddedRows;
        p.dstNzNStride = 1;
        p.dstNzMatrixStride = 0;
        if constexpr (MT == 64 && NT == 512)
        {
            if (false)
            {
                p.ndNum = rows / 16;
                p.nValue = 16;
                p.srcNdMatrixStride = 16 * stride;
                p.dstNzMatrixStride = 16 * 32;
            }
        }
        if (rows % 32 == 0 && cols % 32 == 0 && stride % 4 == 0)
        {
            GlobalTensor<float> wide;
            wide.SetGlobalBuffer((__gm__ float *)src.GetPhyAddr());
            p.dValue = cols / 4;
            p.srcDValue = stride / 4;
            p.srcNdMatrixStride /= 4;
            DataCopy(dst.template ReinterpretCast<float>(), wide, p);
        }
        else
            DataCopy(dst, src, p);
    }

  public:
    __aicore__ inline void Init()
    {
        SetLoadDataPaddingValue<uint64_t>(0);
        SetFixpipeNz2ndFlag(1, 0, 0);
        for (int i = 0; i < STAGES; ++i)
            SetFlag<HardEvent::MTE1_MTE2>(i);
        for (int i = 0; i < 2; ++i)
            SetFlag<HardEvent::M_MTE1>(i);
        SetFlag<HardEvent::FIX_M>(0);
    }

    __aicore__ inline void LoadA(const GlobalTensor<int8_t> &src, int rows, int K, int stride)
    {
        CopyNd(aCache, src, rows, K, stride, MT);
    }

    __aicore__ inline void Consume(const Pending &p)
    {
        const int cslot = 0;
        if (p.first)
            WaitFlag<HardEvent::FIX_M>(cslot);
        WaitFlag<HardEvent::MTE2_MTE1>(p.slot);
        auto c = c0;
        const int actualM = Up(p.rows, 16);
        for (int f = 0; f < p.count; f += FK)
        {
            const int fk = Up(Min(FK, p.count - f), 32);
            const int fs = fragmentSlot;
            WaitFlag<HardEvent::M_MTE1>(fs);
            auto aa = a0[fs * MT * FK];
            auto bb = b0[fs * NT * FK];
            auto la = aCache[(p.kStart + f) * MT];
            auto lb = bL1[p.slot * BPANEL + f * 32];
            LoadData2DParams pa;
            pa.startIndex = 0;
            pa.repeatTimes = fk / 32;
            pa.srcStride = MT / 16;
            pa.dstGap = 0;
            pa.ifTranspose = false;
            pa.sid = 0;
            pa.addrMode = 0;
            for (int mi = 0; mi < (p.rows + 15) / 16; ++mi)
                LoadData(aa[mi * fk * 16], la[mi * 512], pa);
            LoadData2dTransposeParams pb;
            pb.startIndex = 0;
            pb.repeatTimes = (p.cols + 31) / 32;
            pb.srcStride = LK / 32;
            pb.dstGap = 1;
            pb.dstFracGap = 0;
            for (int ki = 0; ki < fk / 32; ++ki)
                LoadDataWithTranspose(bb[ki * NT * 32], lb[ki * 1024], pb);
            SetFlag<HardEvent::MTE1_M>(fs);
            WaitFlag<HardEvent::MTE1_M>(fs);
            MmadParams mm;
            mm.m = actualM;
            mm.n = NT;
            mm.k = fk;
            mm.cmatrixInitVal = p.first && f == 0;
            mm.unitFlag = p.last && f + FK >= p.count ? 3 : 2;
            Mmad(c, aa, bb, mm);
            if constexpr (MT * NT < 2560)
                PipeBarrier<PIPE_M>();
            SetFlag<HardEvent::M_MTE1>(fs);
            fragmentSlot ^= 1;
        }
        SetFlag<HardEvent::MTE1_MTE2>(p.slot);
        if (p.last)
        {
            GlobalTensor<int32_t> dst;
            dst.SetGlobalBuffer((__gm__ int32_t *)p.output);
            CrossCoreWaitFlag(2 + p.outputSlot);
            FixpipeParamsV220 fp;
            fp.nSize = NT;
            fp.mSize = p.rows;
            fp.srcStride = actualM;
            fp.dstStride = NT;
            fp.quantPre = QuantMode_t::NoQuant;
            fp.reluEn = false;
            fp.unitFlag = 3;
            Fixpipe<int32_t, int32_t, CFG_ROW_MAJOR>(dst, c, fp);
            SetFlag<HardEvent::FIX_M>(0);
            CrossCoreSetFlag<2, PIPE_FIX>(p.outputSlot);
        }
    }

    __aicore__ inline void Compute(const GlobalTensor<int8_t> &b, const GlobalTensor<int32_t> &dst,
                                   int rows, int cols, int K, int N, int start, int depth,
                                   int outputSlot)
    {
        const int panels = (depth + LK - 1) / LK;
        for (int p = 0; p < panels; ++p)
        {
            const int slot = producer;
            int ki = p;
            if constexpr (MT >= 64 && NT >= 128)
                ki = (p + GetBlockIdx()) % panels;
            const int count = Min(LK, depth - ki * LK);

            if (pendingCount == QUEUE)
            {
                Consume(pending[head]);
                head = head + 1 < QUEUE ? head + 1 : 0;
                --pendingCount;
            }
            WaitFlag<HardEvent::MTE1_MTE2>(slot);
            CopyNd(bL1[slot * BPANEL], b[int64_t(start + ki * LK) * N], count, cols, N, LK);
            SetFlag<HardEvent::MTE2_MTE1>(slot);
            const int tail =
                head + pendingCount < QUEUE ? head + pendingCount : head + pendingCount - QUEUE;
            pending[tail] = {
                slot,   count,          rows, cols, outputSlot, ki * LK, (GM_ADDR)dst.GetPhyAddr(),
                p == 0, p + 1 == panels};
            ++pendingCount;
            producer = producer + 1 < STAGES ? producer + 1 : 0;
        }
    }

    __aicore__ inline void Finish()
    {
        while (pendingCount)
        {
            Consume(pending[head]);
            head = head + 1 < QUEUE ? head + 1 : 0;
            --pendingCount;
        }
        for (int i = 0; i < STAGES; ++i)
            WaitFlag<HardEvent::MTE1_MTE2>(i);
        for (int i = 0; i < 2; ++i)
            WaitFlag<HardEvent::M_MTE1>(i);
        WaitFlag<HardEvent::FIX_M>(0);
    }
};

template <int MT, int NT, bool KEEP_LAYOUT = false> class EpilogueSequential
{
    static constexpr int ROWS = (MT + 1) / 2;
    static constexpr int SIZE = ROWS * NT;
    static constexpr int UB_SHIFT = KEEP_LAYOUT ? 0 : 256;
    static_assert(SIZE * 10 + NT * 4 + UB_SHIFT <= 196608, "UB capacity exceeded");
    LocalTensor<int32_t> accum{TPosition::VECCALC, 0, SIZE};
    LocalTensor<float> temporary{TPosition::VECCALC, SIZE * 4 + UB_SHIFT, SIZE};
    LocalTensor<half> output{TPosition::VECCALC, SIZE * 8 + UB_SHIFT, SIZE};
    LocalTensor<float> scales{TPosition::VECCALC, SIZE * 10 + UB_SHIFT, NT};

  public:
    __aicore__ inline void Run(const GlobalTensor<int32_t> &src, const GlobalTensor<float> &scale,
                               const GlobalTensor<half> &y, int row, int col, int rows, int cols,
                               int N, int expert, int shards = 1, int slot = 0)
    {
        const int first = GetSubBlockIdx() * ((rows + 1) / 2);
        const int valid = GetSubBlockIdx() ? rows / 2 : (rows + 1) / 2;
        if (valid <= 0)
        {
            if (shards == 1)
                CrossCoreSetFlag<2, PIPE_MTE2>(2 + slot);
            return;
        }
        DataCopy(accum, src[first * NT], valid * NT);
        if (cols == NT && (N == NT || cols % 16 == 0))
            DataCopy(scales, scale[expert * N + col], cols);
        else
            DataCopyPad(scales, scale[expert * N + col], DataCopyExtParams(1, cols * 4, 0, 0, 0),
                        DataCopyPadExtParams<float>{false, 0, 0, 0.0f});
        SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
        WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
        for (int s = 1; s < shards; ++s)
        {
            auto part = temporary.template ReinterpretCast<int32_t>();
            DataCopy(part, src[s * MT * NT + first * NT], valid * NT);
            SetFlag<HardEvent::MTE2_V>(EVENT_ID1);
            WaitFlag<HardEvent::MTE2_V>(EVENT_ID1);
            Add(accum, accum, part, valid * NT);
            SetFlag<HardEvent::V_MTE2>(EVENT_ID1);
            WaitFlag<HardEvent::V_MTE2>(EVENT_ID1);
        }
        if (shards == 1)
            CrossCoreSetFlag<2, PIPE_MTE2>(2 + slot);
        auto z = accum.template ReinterpretCast<float>();
        Cast(z, accum, RoundMode::CAST_RINT, valid * NT);
        PipeBarrier<PIPE_V>();

        for (int r = 0; r < valid; r += 128)
            for (int c = 0; c < NT; c += 64)
            {
                const int width = Min(64, NT - c);
                Mul(z[r * NT + c], z[r * NT + c], scales[c], width, Min(128, valid - r),
                    {1, 1, 1, uint8_t(NT / 8), uint8_t(NT / 8), 0});
            }
        PipeBarrier<PIPE_V>();
        Gelu(z, temporary, output, valid * NT);
        const bool compact =
            N == cols && col == 0 && N < NT && N <= 64 && N % 16 != 0 && valid >= 16;
        auto packed = temporary.template ReinterpretCast<half>();
        if (compact)
        {

            const int count = valid * N;
            PipeBarrier<PIPE_V>();
            CreateVecIndex(accum, int32_t(0), count);
            PipeBarrier<PIPE_V>();
            Cast(temporary, accum, RoundMode::CAST_RINT, count);
            PipeBarrier<PIPE_V>();
            Muls(temporary, temporary, 1.0f / N, count);
            PipeBarrier<PIPE_V>();

            Adds(temporary, temporary, 0.0001f, count);
            PipeBarrier<PIPE_V>();
            auto rows = temporary.template ReinterpretCast<int32_t>();
            Cast(rows, temporary, RoundMode::CAST_FLOOR, count);
            PipeBarrier<PIPE_V>();
            Muls(rows, rows, int32_t(2 * (NT - N)), count);
            Muls(accum, accum, int32_t(2), count);
            PipeBarrier<PIPE_V>();
            Add(accum, accum, rows, count);
            PipeBarrier<PIPE_V>();
            Gather(packed, output, accum.template ReinterpretCast<uint32_t>(), 0, count);
        }
        SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
        WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
        if (compact)
            DataCopyPad(y[int64_t(row + first) * N], packed,
                        DataCopyExtParams(1, valid * N * 2, 0, 0, 0));
        else if (valid == ROWS && cols == NT && N == NT)
            DataCopy(y[int64_t(row + first) * N + col], output, valid * NT);
        else
            DataCopyPad(
                y[int64_t(row + first) * N + col], output,
                DataCopyExtParams(valid, cols * 2, (NT - Up(cols, 16)) / 16, (N - cols) * 2, 0));
        SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
        WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
        SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
        WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
    }
};

template <int MT, int NT, int ST, int LK, int LANES, int FULL_K>
__global__ __mix__(1, 2)
    __attribute__((aligned(4096))) void Resident(GM_ADDR x, GM_ADDR weight, GM_ADDR scale,
                                                 GM_ADDR groups, GM_ADDR y, GM_ADDR workspace,
                                                 int inputK, int N, int E, int workers)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
    SetAtomicNone();
    int core = GetBlockIdx();
    if ASCEND_IS_AIV
    {
        core /= GetSubBlockNum();
    }
    GlobalTensor<int8_t> a, b;
    GlobalTensor<int64_t> g;
    GlobalTensor<float> s;
    GlobalTensor<int32_t> buffer;
    GlobalTensor<half> result;
    a.SetGlobalBuffer((__gm__ int8_t *)x);
    b.SetGlobalBuffer((__gm__ int8_t *)weight);
    g.SetGlobalBuffer((__gm__ int64_t *)groups);
    s.SetGlobalBuffer((__gm__ float *)scale);
    buffer.SetGlobalBuffer((__gm__ int32_t *)workspace);
    result.SetGlobalBuffer((__gm__ half *)y);
    const int K = FULL_K ? FULL_K : inputK;
    const int nTiles = (N + NT - 1) / NT;
    const int metadata = workers * 2 * MT * NT + core * 8;
    if ASCEND_IS_AIC
    {
        CachedACube<MT, NT, ST, LK> cube;
        cube.Init();
        cube.LoadA(a[int64_t(core) * MT * K], MT, K, K);
        cube.Compute(b[int64_t(core) * K * N], buffer[int64_t(core * 2) * MT * NT], MT, NT, K, N, 0,
                     K, 0);
        CrossCoreWaitFlag(4);
        const bool uniform = buffer.GetValue(metadata + 2) != 0;
        if (uniform)
        {
            for (int nc = 1; nc < nTiles; ++nc)
            {
                const int slot = nc & 1;
                cube.Compute(b[int64_t(core) * K * N + nc * NT],
                             buffer[int64_t(core * 2 + slot) * MT * NT], MT, NT, K, N, 0, K, slot);
            }
        }
        cube.Finish();
        if (!uniform)
        {
            int previous = 0, base = 0, next = core, sequence = 0;
            for (int expert = 0; expert < E; ++expert)
            {
                const int end = int(g.GetValue(expert)), length = end - previous;
                const int tiles = (length + MT - 1) / MT;
                while (next < base + tiles)
                {
                    const int first = (next - base) * MT;
                    const int rows = Min(MT, length - first);
                    CachedACube<MT, NT, ST, LK> rowCube;
                    rowCube.Init();
                    rowCube.LoadA(a[int64_t(previous + first) * K], rows, K, K);
                    for (int nc = 0; nc < nTiles; ++nc)
                    {
                        const int slot = sequence++ & 1;
                        rowCube.Compute(b[int64_t(expert) * K * N + nc * NT],
                                        buffer[int64_t(core * 2 + slot) * MT * NT], rows, NT, K, N,
                                        0, K, slot);
                    }
                    rowCube.Finish();
                    next += workers;
                }
                previous = end;
                base += tiles;
            }
        }
    }
    if ASCEND_IS_AIV
    {
        TPipe pipe;
        SetMaskNorm();
        SetVectorMask<uint8_t>(~uint64_t(0), ~uint64_t(0));
        CrossCoreSetFlag<2, PIPE_MTE2>(2);
        CrossCoreSetFlag<2, PIPE_MTE2>(3);
        LocalTensor<int64_t> ends(TPosition::VECCALC, 172032, 128);
        DataCopyPad(ends, g, DataCopyExtParams(1, E * 8, 0, 0, 0),
                    DataCopyPadExtParams<int64_t>{false, 0, 0, 0});
        SetFlag<HardEvent::MTE2_S>(EVENT_ID4);
        WaitFlag<HardEvent::MTE2_S>(EVENT_ID4);
        const int start = core ? int(ends.GetValue(core - 1)) : 0;
        const int length = int(ends.GetValue(core)) - start;
        bool uniform = true;
        for (int expert = 0; expert < E; ++expert)
            if (ends.GetValue(expert) != int64_t(expert + 1) * MT)
                uniform = false;
        if (GetSubBlockIdx() == 0)
        {
            LocalTensor<int32_t> decision(TPosition::VECCALC, 173056, 8);
            decision.SetValue(0, start);
            decision.SetValue(1, length);
            decision.SetValue(2, int32_t(uniform));
            SetFlag<HardEvent::S_MTE3>(EVENT_ID4);
            WaitFlag<HardEvent::S_MTE3>(EVENT_ID4);
            DataCopyPad(buffer[metadata], decision, DataCopyExtParams(1, 12, 0, 0, 0));
        }
        CrossCoreSetFlag<2, PIPE_MTE3>(4);
        GlobalTensor<uint64_t> raw;
        raw.SetGlobalBuffer((__gm__ uint64_t *)(weight + int64_t(core) * K * N +
                                                int64_t(GetSubBlockIdx()) * K * N / 2));
        for (int64_t offset = 0; offset < int64_t(K) * N / 2; offset += 8192)
            DataCachePreload(raw, offset);
        EpilogueSequential<MT, NT> epilogue;
        if (!uniform)
        {
            CrossCoreWaitFlag(0);
            CrossCoreSetFlag<2, PIPE_MTE2>(2);
        }
        int previous = 0, base = 0, next = core, sequence = 0;
        for (int group = 0; group < (uniform ? 1 : E); ++group)
        {
            const int expert = uniform ? core : group;
            const int end = uniform ? 0 : int(ends.GetValue(expert));
            const int length = uniform ? MT : end - previous;
            const int tiles = (length + MT - 1) / MT;
            int first = uniform ? 0 : (next - base) * MT;
            while (uniform ? first < MT : next < base + tiles)
            {
                const int rows = uniform ? MT : Min(MT, length - first);
                const int row = uniform ? start : previous + first;
                for (int nc = 0; nc < nTiles; ++nc)
                {
                    const int slot = sequence++ & 1;
                    CrossCoreWaitFlag(slot);
                    epilogue.Run(buffer[int64_t(core * 2 + slot) * MT * NT], s, result, row,
                                 nc * NT, rows, NT, N, expert, 1, slot);
                }
                if (uniform)
                    first += MT;
                else
                {
                    next += workers;
                    first = (next - base) * MT;
                }
            }
            if (!uniform)
            {
                previous = end;
                base += tiles;
            }
        }
    }
}

template <int MT, int NT, int ST, int LK>
inline void Launch(GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR g, GM_ADDR y, int K, int N, int E,
                   int cores, aclrtStream stream)
{
    const bool dual = E * 2 <= cores && N > NT;
    const int workers = E * (dual ? 2 : 1);
    Workspace memory((size_t(workers) * 2 * MT * NT + workers * 8) * 4, stream);
    if (!memory.Data())
        return;
    if (dual && K == CACHE_K)
        Resident<MT, NT, ST, LK, 2, CACHE_K>
            <<<workers, nullptr, stream>>>(x, w, s, g, y, memory.Data(), K, N, E, workers);
    else if (dual)
        Resident<MT, NT, ST, LK, 2, 0>
            <<<workers, nullptr, stream>>>(x, w, s, g, y, memory.Data(), K, N, E, workers);
    else if (K == CACHE_K)
        Resident<MT, NT, ST, LK, 1, CACHE_K>
            <<<workers, nullptr, stream>>>(x, w, s, g, y, memory.Data(), K, N, E, workers);
    else
        Resident<MT, NT, ST, LK, 1, 0>
            <<<workers, nullptr, stream>>>(x, w, s, g, y, memory.Data(), K, N, E, workers);
    memory.Complete();
}

}

namespace resident_packed_prefetch
{
constexpr int CACHE_K = 1024;
using namespace AscendC;
using grouped_gelu::Min;
using grouped_gelu::Up;

__aicore__ inline void Gelu(const LocalTensor<float> &z, const LocalTensor<float> &temporary,
                            const LocalTensor<half> &out, int count)
{
    Mul(temporary, z, z, count);
    PipeBarrier<PIPE_V>();
    Muls(temporary, temporary, -0.07135481627260025f, count);
    PipeBarrier<PIPE_V>();
    Adds(temporary, temporary, -1.5957691216057308f, count);
    PipeBarrier<PIPE_V>();
    Mul(temporary, temporary, z, count);
    PipeBarrier<PIPE_V>();
    Exp(temporary, temporary, count);
    PipeBarrier<PIPE_V>();
    Adds(temporary, temporary, 1.0f, count);
    PipeBarrier<PIPE_V>();
    Div(z, z, temporary, count);
    PipeBarrier<PIPE_V>();
    Cast(out, z, RoundMode::CAST_RINT, count);
}

template <int MT, int NT, int NSTAGES = 3, int LK = 256> class CachedACube
{
    static constexpr int FK = (NT > 512 || MT > 512) ? 32 : ((NT > 256 || MT >= 256) ? 64 : 128);
    static constexpr int STAGES = NSTAGES;
    static constexpr int AK = 1024;
    static constexpr int APANEL = MT * AK;
    static constexpr int BPANEL = NT * LK;
    static_assert(APANEL + STAGES * BPANEL <= 524288, "cached A/L1 capacity exceeded");
    static_assert(2 * MT * FK <= 65536 && 2 * NT * FK <= 65536, "L0A/B capacity exceeded");
    static_assert(MT * NT * 4 <= 131072, "L0C capacity exceeded");
    LocalTensor<int8_t> aCache{TPosition::A1, 0, APANEL};
    LocalTensor<int8_t> bL1{TPosition::A1, APANEL, STAGES * BPANEL};
    LocalTensor<int8_t> a0{TPosition::A2, 0, 2 * MT * FK};
    LocalTensor<int8_t> b0{TPosition::B2, 0, 2 * NT * FK};
    LocalTensor<int32_t> c0{TPosition::CO1, 0, MT * NT};
    int fragmentSlot = 0;
    bool aPending = false;
    bool prefetched = false;
    struct Pending
    {
        int slot, count, rows, cols, outputSlot, kStart;
        GM_ADDR output;
        bool first, last;
    };

    static constexpr int QUEUE = STAGES;
    Pending pending[QUEUE];
    int head = 0, pendingCount = 0, producer = 0;

    __aicore__ inline void CopyNd(const LocalTensor<int8_t> &dst, const GlobalTensor<int8_t> &src,
                                  int rows, int cols, int stride, int paddedRows, bool isB = false)
    {
        Nd2NzParams p;
        p.ndNum = 1;
        p.nValue = rows;
        p.dValue = cols;
        p.srcNdMatrixStride = 0;
        p.srcDValue = stride;
        p.dstNzC0Stride = paddedRows;
        p.dstNzNStride = 1;
        p.dstNzMatrixStride = 0;

        if (true)
        {
            GlobalTensor<float> wide;
            wide.SetGlobalBuffer((__gm__ float *)src.GetPhyAddr());
            p.dValue = cols / 4;
            p.srcDValue = stride / 4;
            p.srcNdMatrixStride /= 4;
            DataCopy(dst.template ReinterpretCast<float>(), wide, p);
        }
        else
        {
            DataCopy(dst, src, p);
        }
    }

  public:
    __aicore__ inline void Init()
    {
        SetLoadDataPaddingValue<uint64_t>(0);
        SetFixpipeNz2ndFlag(1, 0, 0);
        for (int i = 0; i < STAGES; ++i)
            SetFlag<HardEvent::MTE1_MTE2>(i);
        for (int i = 0; i < 2; ++i)
            SetFlag<HardEvent::M_MTE1>(i);
        SetFlag<HardEvent::FIX_M>(0);
    }

    __aicore__ inline void Preload(const GlobalTensor<int8_t> &b, int K, int N, int cols)
    {
        const int panels = (K + LK - 1) / LK;
        const int ki = (MT >= 64 && NT >= 128) ? GetBlockIdx() % panels : 0;
        WaitFlag<HardEvent::MTE1_MTE2>(producer);
        CopyNd(bL1[producer * BPANEL], b[int64_t(ki * LK) * N], Min(LK, K - ki * LK), cols, N, LK,
               true);
        SetFlag<HardEvent::MTE2_MTE1>(producer);
        prefetched = true;
    }
    __aicore__ inline void CancelPreload()
    {
        WaitFlag<HardEvent::MTE2_MTE1>(producer);
        SetFlag<HardEvent::MTE1_MTE2>(producer);
        prefetched = false;
    }
    __aicore__ inline void LoadA(const GlobalTensor<int8_t> &src, int rows, int K, int stride)
    {
        CopyNd(aCache, src, rows, K, stride, MT);
        SetFlag<HardEvent::MTE2_MTE1>(EVENT_ID4);
        aPending = true;
    }

    __aicore__ inline void Consume(const Pending &p)
    {
        const int cslot = 0;
        if (p.first)
            WaitFlag<HardEvent::FIX_M>(cslot);
        WaitFlag<HardEvent::MTE2_MTE1>(p.slot);
        if (aPending)
        {
            WaitFlag<HardEvent::MTE2_MTE1>(EVENT_ID4);
            aPending = false;
        }
        auto c = c0;
        const int actualM = Up(p.rows, 16);
        for (int f = 0; f < p.count; f += FK)
        {
            const int fk = Up(Min(FK, p.count - f), 32);
            const int fs = fragmentSlot;
            WaitFlag<HardEvent::M_MTE1>(fs);
            auto aa = a0[fs * MT * FK];
            auto bb = b0[fs * NT * FK];
            auto la = aCache[(p.kStart + f) * MT];
            auto lb = bL1[p.slot * BPANEL + f * 32];
            LoadData2DParams pa;
            pa.startIndex = 0;
            pa.repeatTimes = fk / 32;
            pa.srcStride = MT / 16;
            pa.dstGap = 0;
            pa.ifTranspose = false;
            pa.sid = 0;
            pa.addrMode = 0;
            for (int mi = 0; mi < (p.rows + 15) / 16; ++mi)
                LoadData(aa[mi * fk * 16], la[mi * 512], pa);
            LoadData2dTransposeParams pb;
            pb.startIndex = 0;
            pb.repeatTimes = (p.cols + 31) / 32;
            pb.srcStride = LK / 32;
            pb.dstGap = 1;
            pb.dstFracGap = 0;
            for (int ki = 0; ki < fk / 32; ++ki)
                LoadDataWithTranspose(bb[ki * NT * 32], lb[ki * 1024], pb);
            SetFlag<HardEvent::MTE1_M>(fs);
            WaitFlag<HardEvent::MTE1_M>(fs);
            MmadParams mm;
            mm.m = actualM;
            mm.n = NT;
            mm.k = fk;
            mm.cmatrixInitVal = p.first && f == 0;
            mm.unitFlag = p.last && f + FK >= p.count ? 3 : 2;
            Mmad(c, aa, bb, mm);
            if constexpr (MT * NT < 2560)
                PipeBarrier<PIPE_M>();
            SetFlag<HardEvent::M_MTE1>(fs);
            fragmentSlot ^= 1;
        }
        SetFlag<HardEvent::MTE1_MTE2>(p.slot);
        if (p.last)
        {
            GlobalTensor<int32_t> dst;
            dst.SetGlobalBuffer((__gm__ int32_t *)p.output);
            CrossCoreWaitFlag(2 + p.outputSlot);
            for (int part = 0; part < MT / 64; ++part)
            {
                const int rows = Min(64, p.rows > part * 64 ? p.rows - part * 64 : 0);
                if (rows)
                {
                    FixpipeParamsV220 fp;
                    fp.nSize = NT;
                    fp.mSize = rows;
                    fp.srcStride = actualM;
                    fp.dstStride = NT;
                    fp.quantPre = QuantMode_t::NoQuant;
                    fp.reluEn = false;
                    fp.unitFlag = 3;
                    Fixpipe<int32_t, int32_t, CFG_ROW_MAJOR>(dst[part * 64 * NT], c[part * 64 * 16],
                                                             fp);
                }
                CrossCoreSetFlag<2, PIPE_FIX>(part * 4 + p.outputSlot);
            }
            SetFlag<HardEvent::FIX_M>(0);
        }
    }

    __aicore__ inline void Compute(const GlobalTensor<int8_t> &b, const GlobalTensor<int32_t> &dst,
                                   int rows, int cols, int K, int N, int start, int depth,
                                   int outputSlot)
    {
        const int panels = (depth + LK - 1) / LK;
        for (int p = 0; p < panels; ++p)
        {
            const int slot = producer;
            int ki = p;
            if constexpr (MT >= 64 && NT >= 128)
                ki = (p + GetBlockIdx()) % panels;
            const int count = Min(LK, depth - ki * LK);

            if (pendingCount == QUEUE)
            {
                Consume(pending[head]);
                head = head + 1 < QUEUE ? head + 1 : 0;
                --pendingCount;
            }
            if (!prefetched)
            {
                WaitFlag<HardEvent::MTE1_MTE2>(slot);
                CopyNd(bL1[slot * BPANEL], b[int64_t(start + ki * LK) * N], count, cols, N, LK,
                       true);
                SetFlag<HardEvent::MTE2_MTE1>(slot);
            }
            else
                prefetched = false;
            const int tail =
                head + pendingCount < QUEUE ? head + pendingCount : head + pendingCount - QUEUE;
            pending[tail] = {
                slot,   count,          rows, cols, outputSlot, ki * LK, (GM_ADDR)dst.GetPhyAddr(),
                p == 0, p + 1 == panels};
            ++pendingCount;
            producer = producer + 1 < STAGES ? producer + 1 : 0;
        }
    }

    __aicore__ inline void Finish()
    {
        while (pendingCount)
        {
            Consume(pending[head]);
            head = head + 1 < QUEUE ? head + 1 : 0;
            --pendingCount;
        }
        for (int i = 0; i < STAGES; ++i)
            WaitFlag<HardEvent::MTE1_MTE2>(i);
        for (int i = 0; i < 2; ++i)
            WaitFlag<HardEvent::M_MTE1>(i);
        WaitFlag<HardEvent::FIX_M>(0);
    }
};

template <int MT, int NT, bool KEEP_LAYOUT = false> class EpilogueSequential
{
    static constexpr int ROWS = (MT + 1) / 2;
    static constexpr int SIZE = ROWS * NT;
    static constexpr int UB_SHIFT = KEEP_LAYOUT ? 0 : 256;
    static_assert(SIZE * 16 + NT * 8 + UB_SHIFT <= 196608, "UB capacity exceeded");
    LocalTensor<int32_t> inputs{TPosition::VECCALC, 0, SIZE * 2};
    LocalTensor<float> temporary{TPosition::VECCALC, SIZE * 8 + UB_SHIFT, SIZE};
    LocalTensor<half> outputs{TPosition::VECCALC, SIZE * 12 + UB_SHIFT, SIZE * 2};
    LocalTensor<float> scaleSlots{TPosition::VECCALC, SIZE * 16 + UB_SHIFT, NT * 2};

    bool initialized = false;
    int producer = 0;

  public:
    __aicore__ inline ~EpilogueSequential()
    {
        if (initialized)
        {
            for (int i = 0; i < 2; ++i)
            {
                WaitFlag<HardEvent::V_MTE2>(i);
                WaitFlag<HardEvent::MTE3_V>(i);
            }
        }
    }
    __aicore__ inline void Run(const GlobalTensor<int32_t> &src, const GlobalTensor<float> &scale,
                               const GlobalTensor<half> &y, int row, int col, int rows, int cols,
                               int N, int expert, int shards = 1, int slot = 0, bool release = true)
    {
        const int first = GetSubBlockIdx() * ((rows + 1) / 2);
        const int valid = GetSubBlockIdx() ? rows / 2 : (rows + 1) / 2;
        if (valid <= 0)
        {
            if (shards == 1 && release)
                CrossCoreSetFlag<2, PIPE_MTE2>(2 + slot);
            return;
        }
        if (!initialized)
        {
            for (int i = 0; i < 2; ++i)
            {
                SetFlag<HardEvent::V_MTE2>(i);
                SetFlag<HardEvent::MTE3_V>(i);
            }
            initialized = true;
        }
        const int index = producer;
        producer ^= 1;
        const event_t event = index ? EVENT_ID1 : EVENT_ID0;
        auto accum = inputs[index * SIZE];
        auto scales = scaleSlots[index * NT];
        auto output = outputs[index * SIZE];
        WaitFlag<HardEvent::V_MTE2>(event);
        DataCopy(accum, src[first * NT], valid * NT);
        if (cols == NT && (N == NT || cols % 16 == 0))
            DataCopy(scales, scale[expert * N + col], cols);
        else
            DataCopyPad(scales, scale[expert * N + col], DataCopyExtParams(1, cols * 4, 0, 0, 0),
                        DataCopyPadExtParams<float>{false, 0, 0, 0.0f});
        SetFlag<HardEvent::MTE2_V>(event);
        WaitFlag<HardEvent::MTE2_V>(event);
        if (shards == 1 && release)
            CrossCoreSetFlag<2, PIPE_MTE2>(2 + slot);
        auto z = accum.template ReinterpretCast<float>();
        Cast(z, accum, RoundMode::CAST_RINT, valid * NT);
        PipeBarrier<PIPE_V>();

        for (int r = 0; r < valid; r += 128)
            for (int c = 0; c < NT; c += 64)
            {
                const int width = Min(64, NT - c);
                Mul(z[r * NT + c], z[r * NT + c], scales[c], width, Min(128, valid - r),
                    {1, 1, 1, uint8_t(NT / 8), uint8_t(NT / 8), 0});
            }
        PipeBarrier<PIPE_V>();
        WaitFlag<HardEvent::MTE3_V>(event);
        Gelu(z, temporary, output, valid * NT);
        const bool compact =
            N == cols && col == 0 && N < NT && N <= 64 && N % 16 != 0 && valid >= 16;
        auto packed = temporary.template ReinterpretCast<half>();
        if (compact)
        {

            const int count = valid * N;
            PipeBarrier<PIPE_V>();
            CreateVecIndex(accum, int32_t(0), count);
            PipeBarrier<PIPE_V>();
            Cast(temporary, accum, RoundMode::CAST_RINT, count);
            PipeBarrier<PIPE_V>();
            Muls(temporary, temporary, 1.0f / N, count);
            PipeBarrier<PIPE_V>();

            Adds(temporary, temporary, 0.0001f, count);
            PipeBarrier<PIPE_V>();
            auto rows = temporary.template ReinterpretCast<int32_t>();
            Cast(rows, temporary, RoundMode::CAST_FLOOR, count);
            PipeBarrier<PIPE_V>();
            Muls(rows, rows, int32_t(2 * (NT - N)), count);
            Muls(accum, accum, int32_t(2), count);
            PipeBarrier<PIPE_V>();
            Add(accum, accum, rows, count);
            PipeBarrier<PIPE_V>();
            Gather(packed, output, accum.template ReinterpretCast<uint32_t>(), 0, count);
        }
        SetFlag<HardEvent::V_MTE3>(event);
        WaitFlag<HardEvent::V_MTE3>(event);
        if (compact)
            DataCopyPad(y[int64_t(row + first) * N], packed,
                        DataCopyExtParams(1, valid * N * 2, 0, 0, 0));
        else if (valid == ROWS && cols == NT && N == NT)
            DataCopy(y[int64_t(row + first) * N + col], output, valid * NT);
        else
            DataCopyPad(
                y[int64_t(row + first) * N + col], output,
                DataCopyExtParams(valid, cols * 2, (NT - Up(cols, 16)) / 16, (N - cols) * 2, 0));
        SetFlag<HardEvent::MTE3_V>(event);
        if (compact)
        {
            SetFlag<HardEvent::MTE3_S>(EVENT_ID7);
            WaitFlag<HardEvent::MTE3_S>(EVENT_ID7);
        }
        SetFlag<HardEvent::V_MTE2>(event);
    }
};

template <int MT, int NT, int ST, int LK, int LANES, int FULL_K>
__global__ __mix__(1, 2)
    __attribute__((aligned(4096))) void Resident(GM_ADDR x, GM_ADDR weight, GM_ADDR scale,
                                                 GM_ADDR groups, GM_ADDR y, GM_ADDR workspace,
                                                 int inputK, int N, int E, int workers)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
    SetAtomicNone();
    int core = GetBlockIdx();
    if ASCEND_IS_AIV
    {
        core /= GetSubBlockNum();
    }
    GlobalTensor<int8_t> a, b;
    GlobalTensor<int64_t> g;
    GlobalTensor<float> s;
    GlobalTensor<int32_t> buffer;
    GlobalTensor<half> result;
    a.SetGlobalBuffer((__gm__ int8_t *)x);
    b.SetGlobalBuffer((__gm__ int8_t *)weight);
    g.SetGlobalBuffer((__gm__ int64_t *)groups);
    s.SetGlobalBuffer((__gm__ float *)scale);
    buffer.SetGlobalBuffer((__gm__ int32_t *)workspace);
    result.SetGlobalBuffer((__gm__ half *)y);
    const int K = FULL_K ? FULL_K : inputK;
    const int nTiles = (N + NT - 1) / NT;
    int sequence = 0;
    if ASCEND_IS_AIC
    {
        CachedACube<MT, NT, ST, LK> cube;
        for (int expert = core / LANES; expert < E; expert += workers / LANES)
        {
            cube.Init();
            const int count = (nTiles + LANES - 1) / LANES;
            int firstTile = core % LANES + (expert % count) * LANES;
            if (firstTile >= nTiles)
                firstTile = core % LANES;
            const int firstCol = firstTile * NT;
            cube.Preload(b[int64_t(expert) * K * N + firstCol], K, N, Min(NT, N - firstCol));
            const int start = expert ? int(g.GetValue(expert - 1)) : 0;
            const int length = int(g.GetValue(expert)) - start;
            for (int row = 0; row < length; row += MT)
            {
                const int rows = Min(MT, length - row);
                if (row)
                    cube.Init();
                cube.LoadA(a[int64_t(start + row) * K], rows, K, K);
                const int visits = (nTiles + LANES - 1) / LANES;
                for (int ni = 0; ni < visits; ++ni)
                {
                    const int nc = core % LANES + ((ni + (expert)) % visits) * LANES;
                    if (nc >= nTiles)
                        continue;
                    const int slot = sequence++ & 1;
                    cube.Compute(b[int64_t(expert) * K * N + nc * NT],
                                 buffer[int64_t(core * 2 + slot) * MT * NT], rows,
                                 Min(NT, N - nc * NT), K, N, 0, K, slot);
                }
                cube.Finish();
            }
            if (length == 0)
            {
                cube.CancelPreload();
                cube.Finish();
            }
        }
    }
    if ASCEND_IS_AIV
    {
        TPipe pipe;
        SetMaskNorm();
        SetVectorMask<uint8_t>(~uint64_t(0), ~uint64_t(0));
        EpilogueSequential<64, NT> epilogue;
        CrossCoreSetFlag<2, PIPE_MTE2>(2);
        CrossCoreSetFlag<2, PIPE_MTE2>(3);
        for (int expert = core / LANES; expert < E; expert += workers / LANES)
        {
            const int start = expert ? int(g.GetValue(expert - 1)) : 0;
            const int length = int(g.GetValue(expert)) - start;
            for (int row = 0; row < length; row += MT)
            {
                const int rows = Min(MT, length - row);
                const int visits = (nTiles + LANES - 1) / LANES;
                for (int ni = 0; ni < visits; ++ni)
                {
                    const int nc = core % LANES + ((ni + (expert)) % visits) * LANES;
                    if (nc >= nTiles)
                        continue;
                    const int slot = sequence++ & 1;
                    for (int part = 0; part < MT / 64; ++part)
                    {
                        const int count = Min(64, rows > part * 64 ? rows - part * 64 : 0);
                        CrossCoreWaitFlag(part * 4 + slot);
                        epilogue.Run(buffer[int64_t(core * 2 + slot) * MT * NT + part * 64 * NT], s,
                                     result, start + row + part * 64, nc * NT, count,
                                     Min(NT, N - nc * NT), N, expert, 1, slot, part + 1 == MT / 64);
                    }
                }
            }
        }
    }
}

template <int MT, int NT, int ST, int LK>
inline void Launch(GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR g, GM_ADDR y, int K, int N, int E,
                   int cores, aclrtStream stream)
{
    const bool dual = E * 2 <= cores && N > NT;
    const int workers = E * (dual ? 2 : 1);
    grouped_gelu::Workspace memory(size_t(workers) * 2 * MT * NT * 4, stream);
    if (!memory.Data())
        return;
    if (dual && K == CACHE_K)
        Resident<MT, NT, ST, LK, 2, CACHE_K>
            <<<workers, nullptr, stream>>>(x, w, s, g, y, memory.Data(), K, N, E, workers);
    else if (dual)
        Resident<MT, NT, ST, LK, 2, 0>
            <<<workers, nullptr, stream>>>(x, w, s, g, y, memory.Data(), K, N, E, workers);
    else if (K == CACHE_K)
        Resident<MT, NT, ST, LK, 1, CACHE_K>
            <<<workers, nullptr, stream>>>(x, w, s, g, y, memory.Data(), K, N, E, workers);
    else
        Resident<MT, NT, ST, LK, 1, 0>
            <<<workers, nullptr, stream>>>(x, w, s, g, y, memory.Data(), K, N, E, workers);
    memory.Complete();
}

}

namespace resident_scaled
{
using grouped_gelu::Workspace;

constexpr int CACHE_K = 2048;
using namespace AscendC;
using grouped_gelu::Min;
using grouped_gelu::Up;

using grouped_gelu::Gelu;

template <int MT, int NT, int NSTAGES = 3, int LK = 256> class CachedACube
{
    static constexpr int FK = (NT > 512 || MT > 512) ? 32 : ((NT > 256 || MT >= 256) ? 64 : 128);
    static constexpr int STAGES = NSTAGES;
    static constexpr int AK = 2048;
    static constexpr int APANEL = MT * AK;
    static constexpr int BPANEL = NT * LK;
    static_assert(APANEL + STAGES * BPANEL <= 524288, "cached A/L1 capacity exceeded");
    static_assert(2 * MT * FK <= 65536 && 2 * NT * FK <= 65536, "L0A/B capacity exceeded");
    static_assert(MT * NT * 4 <= 131072, "L0C capacity exceeded");
    LocalTensor<int8_t> aCache{TPosition::A1, 0, APANEL};
    LocalTensor<int8_t> bL1{TPosition::A1, APANEL, STAGES * BPANEL};
    LocalTensor<int8_t> a0{TPosition::A2, 0, 2 * MT * FK};
    LocalTensor<int8_t> b0{TPosition::B2, 0, 2 * NT * FK};
    LocalTensor<int32_t> c0{TPosition::CO1, 0, MT * NT};
    int fragmentSlot = 0;
    struct Pending
    {
        int slot, count, rows, cols, outputSlot, kStart;
        GM_ADDR output;
        bool first, last;
    };

    static constexpr int QUEUE = 2;
    Pending pending[QUEUE];
    int head = 0, pendingCount = 0, producer = 0;

    __aicore__ inline void CopyNd(const LocalTensor<int8_t> &dst, const GlobalTensor<int8_t> &src,
                                  int rows, int cols, int stride, int paddedRows)
    {
        Nd2NzParams p;
        p.ndNum = 1;
        p.nValue = rows;
        p.dValue = cols;
        p.srcNdMatrixStride = 0;
        p.srcDValue = stride;
        p.dstNzC0Stride = paddedRows;
        p.dstNzNStride = 1;
        p.dstNzMatrixStride = 0;
        if constexpr (MT == 64 && NT == 512)
        {
            if (rows > 16 && rows % 16 == 0 && 16 * stride <= 65535)
            {
                p.ndNum = rows / 16;
                p.nValue = 16;
                p.srcNdMatrixStride = 16 * stride;
                p.dstNzMatrixStride = 16 * 32;
            }
        }
        DataCopy(dst, src, p);
    }

  public:
    __aicore__ inline void Init()
    {
        SetLoadDataPaddingValue<uint64_t>(0);
        SetFixpipeNz2ndFlag(1, 0, 0);
        for (int i = 0; i < STAGES; ++i)
            SetFlag<HardEvent::MTE1_MTE2>(i);
        for (int i = 0; i < 2; ++i)
            SetFlag<HardEvent::M_MTE1>(i);
        SetFlag<HardEvent::FIX_M>(0);
    }

    __aicore__ inline void LoadA(const GlobalTensor<int8_t> &src, int rows, int K, int stride)
    {
        CopyNd(aCache, src, rows, K, stride, MT);
    }

    __aicore__ inline void Consume(const Pending &p)
    {
        const int cslot = 0;
        if (p.first)
            WaitFlag<HardEvent::FIX_M>(cslot);
        WaitFlag<HardEvent::MTE2_MTE1>(p.slot);
        auto c = c0;
        const int actualM = Up(p.rows, 16);
        for (int f = 0; f < p.count; f += FK)
        {
            const int fk = Up(Min(FK, p.count - f), 32);
            const int fs = fragmentSlot;
            WaitFlag<HardEvent::M_MTE1>(fs);
            auto aa = a0[fs * MT * FK];
            auto bb = b0[fs * NT * FK];
            auto la = aCache[(p.kStart + f) * MT];
            auto lb = bL1[p.slot * BPANEL + f * 32];
            LoadData2DParams pa;
            pa.startIndex = 0;
            pa.repeatTimes = fk / 32;
            pa.srcStride = MT / 16;
            pa.dstGap = 0;
            pa.ifTranspose = false;
            pa.sid = 0;
            pa.addrMode = 0;
            for (int mi = 0; mi < (p.rows + 15) / 16; ++mi)
                LoadData(aa[mi * fk * 16], la[mi * 512], pa);
            LoadData2dTransposeParams pb;
            pb.startIndex = 0;
            pb.repeatTimes = (p.cols + 31) / 32;
            pb.srcStride = LK / 32;
            pb.dstGap = 1;
            pb.dstFracGap = 0;
            for (int ki = 0; ki < fk / 32; ++ki)
                LoadDataWithTranspose(bb[ki * NT * 32], lb[ki * 1024], pb);
            SetFlag<HardEvent::MTE1_M>(fs);
            WaitFlag<HardEvent::MTE1_M>(fs);
            MmadParams mm;
            mm.m = actualM;
            mm.n = NT;
            mm.k = fk;
            mm.cmatrixInitVal = p.first && f == 0;
            mm.unitFlag = p.last && f + FK >= p.count ? 3 : 2;
            Mmad(c, aa, bb, mm);
            if constexpr (MT * NT < 2560)
                PipeBarrier<PIPE_M>();
            SetFlag<HardEvent::M_MTE1>(fs);
            fragmentSlot ^= 1;
        }
        SetFlag<HardEvent::MTE1_MTE2>(p.slot);
        if (p.last)
        {
            GlobalTensor<int32_t> dst;
            dst.SetGlobalBuffer((__gm__ int32_t *)p.output);
            CrossCoreWaitFlag(2 + p.outputSlot);
            FixpipeParamsV220 fp;
            fp.nSize = NT;
            fp.mSize = p.rows;
            fp.srcStride = actualM;
            fp.dstStride = NT;
            fp.quantPre = QuantMode_t::NoQuant;
            fp.reluEn = false;
            fp.unitFlag = 3;
            Fixpipe<int32_t, int32_t, CFG_ROW_MAJOR>(dst, c, fp);
            SetFlag<HardEvent::FIX_M>(0);
            CrossCoreSetFlag<2, PIPE_FIX>(p.outputSlot);
        }
    }

    __aicore__ inline void Compute(const GlobalTensor<int8_t> &b, const GlobalTensor<int32_t> &dst,
                                   int rows, int cols, int K, int N, int start, int depth,
                                   int outputSlot)
    {
        const int panels = (depth + LK - 1) / LK;
        for (int p = 0; p < panels; ++p)
        {
            const int slot = producer;
            int ki = p;
            if constexpr (MT >= 64 && NT >= 128)
                ki = (p + GetBlockIdx()) % panels;
            const int count = Min(LK, depth - ki * LK);

            WaitFlag<HardEvent::MTE1_MTE2>(slot);
            CopyNd(bL1[slot * BPANEL], b[int64_t(start + ki * LK) * N], count, cols, N, LK);
            SetFlag<HardEvent::MTE2_MTE1>(slot);
            if (pendingCount == QUEUE)
            {
                Consume(pending[head]);
                head = head + 1 < QUEUE ? head + 1 : 0;
                --pendingCount;
            }
            const int tail =
                head + pendingCount < QUEUE ? head + pendingCount : head + pendingCount - QUEUE;
            pending[tail] = {
                slot,   count,          rows, cols, outputSlot, ki * LK, (GM_ADDR)dst.GetPhyAddr(),
                p == 0, p + 1 == panels};
            ++pendingCount;
            producer = producer + 1 < STAGES ? producer + 1 : 0;
        }
    }

    __aicore__ inline void Finish()
    {
        while (pendingCount)
        {
            Consume(pending[head]);
            head = head + 1 < QUEUE ? head + 1 : 0;
            --pendingCount;
        }
        for (int i = 0; i < STAGES; ++i)
            WaitFlag<HardEvent::MTE1_MTE2>(i);
        for (int i = 0; i < 2; ++i)
            WaitFlag<HardEvent::M_MTE1>(i);
        WaitFlag<HardEvent::FIX_M>(0);
    }
};

template <int MT, int NT, bool KEEP_LAYOUT = false, bool CACHED_SCALE = false>
class EpilogueSequential
{
    static constexpr int ROWS = (MT + 1) / 2;
    static constexpr int SIZE = ROWS * NT;
    static constexpr int UB_SHIFT = KEEP_LAYOUT ? 0 : 256;
    static_assert(SIZE * 10 + NT * 4 + UB_SHIFT <= 196608, "UB capacity exceeded");
    LocalTensor<int32_t> accum{TPosition::VECCALC, 0, SIZE};
    LocalTensor<float> temporary{TPosition::VECCALC, SIZE * 4 + UB_SHIFT, SIZE};
    LocalTensor<half> output{TPosition::VECCALC, SIZE * 8 + UB_SHIFT, SIZE};
    LocalTensor<float> scales{TPosition::VECCALC, SIZE * 10 + UB_SHIFT, NT};

    LocalTensor<float> cachedScales{TPosition::VECCALC, 172288, 4096};

  public:
    __aicore__ inline void PreloadScales(const GlobalTensor<float> &source, int expert, int N)
    {
        DataCopyPad(cachedScales, source[expert * N], DataCopyExtParams(1, N * 4, 0, 0, 0),
                    DataCopyPadExtParams<float>{false, 0, 0, 0.0f});
    }
    __aicore__ inline void Run(const GlobalTensor<int32_t> &src, const GlobalTensor<float> &scale,
                               const GlobalTensor<half> &y, int row, int col, int rows, int cols,
                               int N, int expert, int shards = 1, int slot = 0)
    {
        const int first = GetSubBlockIdx() * ((rows + 1) / 2);
        const int valid = GetSubBlockIdx() ? rows / 2 : (rows + 1) / 2;
        if (valid <= 0)
        {
            if (shards == 1)
                CrossCoreSetFlag<2, PIPE_MTE2>(2 + slot);
            return;
        }
        DataCopy(accum, src[first * NT], valid * NT);
        if constexpr (!CACHED_SCALE)
        {
            if (cols == NT && (N == NT || cols % 16 == 0))
                DataCopy(scales, scale[expert * N + col], cols);
            else
                DataCopyPad(scales, scale[expert * N + col],
                            DataCopyExtParams(1, cols * 4, 0, 0, 0),
                            DataCopyPadExtParams<float>{false, 0, 0, 0.0f});
        }
        SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
        WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
        for (int s = 1; s < shards; ++s)
        {
            auto part = temporary.template ReinterpretCast<int32_t>();
            DataCopy(part, src[s * MT * NT + first * NT], valid * NT);
            SetFlag<HardEvent::MTE2_V>(EVENT_ID1);
            WaitFlag<HardEvent::MTE2_V>(EVENT_ID1);
            Add(accum, accum, part, valid * NT);
            SetFlag<HardEvent::V_MTE2>(EVENT_ID1);
            WaitFlag<HardEvent::V_MTE2>(EVENT_ID1);
        }
        if (shards == 1)
            CrossCoreSetFlag<2, PIPE_MTE2>(2 + slot);
        auto channelScales = scales;
        if constexpr (CACHED_SCALE)
            channelScales = cachedScales[col];
        auto z = accum.template ReinterpretCast<float>();
        Cast(z, accum, RoundMode::CAST_RINT, valid * NT);
        PipeBarrier<PIPE_V>();

        for (int r = 0; r < valid; r += 128)
            for (int c = 0; c < NT; c += 64)
            {
                const int width = Min(64, NT - c);
                Mul(z[r * NT + c], z[r * NT + c], channelScales[c], width, Min(128, valid - r),
                    {1, 1, 1, uint8_t(NT / 8), uint8_t(NT / 8), 0});
            }
        PipeBarrier<PIPE_V>();
        Gelu(z, temporary, output, valid * NT);
        const bool compact =
            N == cols && col == 0 && N < NT && N <= 64 && N % 16 != 0 && valid >= 16;
        auto packed = temporary.template ReinterpretCast<half>();
        if (compact)
        {

            const int count = valid * N;
            PipeBarrier<PIPE_V>();
            CreateVecIndex(accum, int32_t(0), count);
            PipeBarrier<PIPE_V>();
            Cast(temporary, accum, RoundMode::CAST_RINT, count);
            PipeBarrier<PIPE_V>();
            Muls(temporary, temporary, 1.0f / N, count);
            PipeBarrier<PIPE_V>();

            Adds(temporary, temporary, 0.0001f, count);
            PipeBarrier<PIPE_V>();
            auto rows = temporary.template ReinterpretCast<int32_t>();
            Cast(rows, temporary, RoundMode::CAST_FLOOR, count);
            PipeBarrier<PIPE_V>();
            Muls(rows, rows, int32_t(2 * (NT - N)), count);
            Muls(accum, accum, int32_t(2), count);
            PipeBarrier<PIPE_V>();
            Add(accum, accum, rows, count);
            PipeBarrier<PIPE_V>();
            Gather(packed, output, accum.template ReinterpretCast<uint32_t>(), 0, count);
        }
        SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
        WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
        if (compact)
            DataCopyPad(y[int64_t(row + first) * N], packed,
                        DataCopyExtParams(1, valid * N * 2, 0, 0, 0));
        else if (valid == ROWS && cols == NT && N == NT)
            DataCopy(y[int64_t(row + first) * N + col], output, valid * NT);
        else
            DataCopyPad(
                y[int64_t(row + first) * N + col], output,
                DataCopyExtParams(valid, cols * 2, (NT - Up(cols, 16)) / 16, (N - cols) * 2, 0));
        SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
        WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
        SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
        WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
    }
};

template <int MT, int NT, int ST, int LK, int LANES, int FULL_K>
__global__ __mix__(1, 2)
    __attribute__((aligned(4096))) void Resident(GM_ADDR x, GM_ADDR weight, GM_ADDR scale,
                                                 GM_ADDR groups, GM_ADDR y, GM_ADDR workspace,
                                                 int inputK, int N, int E, int workers)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
    SetAtomicNone();
    int core = GetBlockIdx();
    if ASCEND_IS_AIV
    {
        core /= GetSubBlockNum();
    }
    GlobalTensor<int8_t> a, b;
    GlobalTensor<int64_t> g;
    GlobalTensor<float> s;
    GlobalTensor<int32_t> buffer;
    GlobalTensor<half> result;
    a.SetGlobalBuffer((__gm__ int8_t *)x);
    b.SetGlobalBuffer((__gm__ int8_t *)weight);
    g.SetGlobalBuffer((__gm__ int64_t *)groups);
    s.SetGlobalBuffer((__gm__ float *)scale);
    buffer.SetGlobalBuffer((__gm__ int32_t *)workspace);
    result.SetGlobalBuffer((__gm__ half *)y);
    const int K = FULL_K ? FULL_K : inputK;
    const int nTiles = (N + NT - 1) / NT;
    int sequence = 0;
    if ASCEND_IS_AIC
    {
        CachedACube<MT, NT, ST, LK> cube;
        for (int expert = core / LANES; expert < E; expert += workers / LANES)
        {
            const int start = expert ? int(g.GetValue(expert - 1)) : 0;
            const int length = int(g.GetValue(expert)) - start;
            for (int row = 0; row < length; row += MT)
            {
                const int rows = Min(MT, length - row);
                cube.Init();
                cube.LoadA(a[int64_t(start + row) * K], rows, K, K);
                for (int nc = core % LANES; nc < nTiles; nc += LANES)
                {
                    const int slot = sequence++ & 1;
                    cube.Compute(b[int64_t(expert) * K * N + nc * NT],
                                 buffer[int64_t(core * 2 + slot) * MT * NT], rows,
                                 Min(NT, N - nc * NT), K, N, 0, K, slot);
                }
                cube.Finish();
            }
        }
    }
    if ASCEND_IS_AIV
    {
        TPipe pipe;
        SetMaskNorm();
        SetVectorMask<uint8_t>(~uint64_t(0), ~uint64_t(0));
        EpilogueSequential<MT, NT, false, true> epilogue;
        CrossCoreSetFlag<2, PIPE_MTE2>(2);
        CrossCoreSetFlag<2, PIPE_MTE2>(3);
        for (int expert = core / LANES; expert < E; expert += workers / LANES)
        {
            const int start = expert ? int(g.GetValue(expert - 1)) : 0;
            const int length = int(g.GetValue(expert)) - start;
            epilogue.PreloadScales(s, expert, N);
            for (int row = 0; row < length; row += MT)
            {
                const int rows = Min(MT, length - row);
                for (int nc = core % LANES; nc < nTiles; nc += LANES)
                {
                    const int slot = sequence++ & 1;
                    CrossCoreWaitFlag(slot);
                    epilogue.Run(buffer[int64_t(core * 2 + slot) * MT * NT], s, result, start + row,
                                 nc * NT, rows, Min(NT, N - nc * NT), N, expert, 1, slot);
                }
            }
        }
    }
}

template <int MT, int NT, int ST, int LK>
inline void Launch(GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR g, GM_ADDR y, int K, int N, int E,
                   int cores, aclrtStream stream)
{
    const bool dual = E * 2 <= cores && N > NT;
    const int workers = std::min(E * (dual ? 2 : 1), cores);
    Workspace memory(size_t(workers) * 2 * MT * NT * 4, stream);
    if (!memory.Data())
        return;
    if (dual && K == CACHE_K)
        Resident<MT, NT, ST, LK, 2, CACHE_K>
            <<<workers, nullptr, stream>>>(x, w, s, g, y, memory.Data(), K, N, E, workers);
    else if (dual)
        Resident<MT, NT, ST, LK, 2, 0>
            <<<workers, nullptr, stream>>>(x, w, s, g, y, memory.Data(), K, N, E, workers);
    else if (K == CACHE_K)
        Resident<MT, NT, ST, LK, 1, CACHE_K>
            <<<workers, nullptr, stream>>>(x, w, s, g, y, memory.Data(), K, N, E, workers);
    else
        Resident<MT, NT, ST, LK, 1, 0>
            <<<workers, nullptr, stream>>>(x, w, s, g, y, memory.Data(), K, N, E, workers);
    memory.Complete();
}

}

namespace streaming_padded
{
using namespace AscendC;
__aicore__ inline int Min(int a, int b)
{
    return a < b ? a : b;
}
__aicore__ inline int Up(int a, int b)
{
    return (a + b - 1) / b * b;
}

using resident_packed_prefetch::Gelu;

template <int MT, int NT, bool SPLIT, int LK = 256, int NSTAGES = 3> class Cube
{

    static constexpr int FK = (NT > 512 || MT > 512) ? 32 : ((NT > 256 || MT >= 256) ? 64 : 128);
    static constexpr int STAGES = NSTAGES;
    static constexpr int PANEL = (MT + NT) * LK + 512;
    static constexpr int CSLOTS = MT * NT * 4 <= 65536 ? 2 : 1;
    static_assert(STAGES * PANEL <= 524288, "L1 capacity exceeded");
    static_assert(2 * MT * FK <= 65536 && 2 * NT * FK <= 65536, "L0A/B capacity exceeded");
    static_assert(CSLOTS * MT * NT * 4 <= 131072, "L0C capacity exceeded");
    LocalTensor<int8_t> l1{TPosition::A1, 0, STAGES * PANEL};
    LocalTensor<int8_t> a0{TPosition::A2, 0, 2 * MT * FK};
    LocalTensor<int8_t> b0{TPosition::B2, 0, 2 * NT * FK};
    LocalTensor<int32_t> c0{TPosition::CO1, 0, CSLOTS * MT * NT};
    int fragmentSlot = 0;
    struct Pending
    {
        int slot, count, rows, cols, outputSlot;
        GM_ADDR output;
        bool first, last;
    };
    Pending pending[2];
    int head = 0, pendingCount = 0, producer = 0;

    __aicore__ inline void CopyNd(const LocalTensor<int8_t> &dst, const GlobalTensor<int8_t> &src,
                                  int rows, int cols, int stride, int paddedRows)
    {
        Nd2NzParams p;
        p.ndNum = 1;
        p.nValue = rows;
        p.dValue = cols;
        p.srcNdMatrixStride = 0;
        p.srcDValue = stride;
        p.dstNzC0Stride = paddedRows;
        p.dstNzNStride = 1;
        p.dstNzMatrixStride = 0;
        if constexpr (MT == 64 && NT == 512)
        {
            if (rows > 16 && rows % 16 == 0 && 16 * stride <= 65535)
            {
                p.ndNum = rows / 16;
                p.nValue = 16;
                p.srcNdMatrixStride = 16 * stride;
                p.dstNzMatrixStride = 16 * 32;
            }
        }
        if (rows % 32 == 0 && cols % 32 == 0 && stride % 4 == 0)
        {
            GlobalTensor<float> wide;
            wide.SetGlobalBuffer((__gm__ float *)src.GetPhyAddr());
            p.dValue = cols / 4;
            p.srcDValue = stride / 4;
            p.srcNdMatrixStride /= 4;
            DataCopy(dst.template ReinterpretCast<float>(), wide, p);
        }
        else
            DataCopy(dst, src, p);
    }

    __aicore__ inline void Consume(const Pending &p)
    {
        const int cslot = p.outputSlot % CSLOTS;
        if (p.first)
            WaitFlag<HardEvent::FIX_M>(cslot);
        auto c = c0[cslot * MT * NT];
        WaitFlag<HardEvent::MTE2_MTE1>(p.slot);

        const int actualM = MT >= 256 ? MT : Up(p.rows, 16);
        for (int f = 0; f < p.count; f += FK)
        {
            const int fk = Up(Min(FK, p.count - f), 32);
            const int fs = fragmentSlot;
            WaitFlag<HardEvent::M_MTE1>(fs);
            auto aa = a0[fs * MT * FK];
            auto bb = b0[fs * NT * FK];
            auto la = l1[p.slot * PANEL + f * MT];
            auto lb = l1[p.slot * PANEL + MT * LK + f * 32];
            LoadData2DParams pa;
            pa.startIndex = 0;
            pa.repeatTimes = fk / 32;
            pa.srcStride = MT / 16;
            pa.dstGap = 0;
            pa.ifTranspose = false;
            pa.sid = 0;
            pa.addrMode = 0;
            for (int mi = 0; mi < (p.rows + 15) / 16; ++mi)
                LoadData(aa[mi * fk * 16], la[mi * 512], pa);
            LoadData2dTransposeParams pb;
            pb.startIndex = 0;
            pb.repeatTimes = (p.cols + 31) / 32;
            pb.srcStride = LK / 32;
            pb.dstGap = 1;
            pb.dstFracGap = 0;
            for (int ki = 0; ki < fk / 32; ++ki)
                LoadDataWithTranspose(bb[ki * NT * 32], lb[ki * 1024], pb);
            SetFlag<HardEvent::MTE1_M>(fs);
            WaitFlag<HardEvent::MTE1_M>(fs);
            MmadParams mm;
            mm.m = actualM;
            mm.n = NT;
            mm.k = fk;
            mm.cmatrixInitVal = p.first && f == 0;
            mm.unitFlag = p.last && f + FK >= p.count ? 3 : 2;
            Mmad(c, aa, bb, mm);
            if constexpr (MT * NT < 2560)
                PipeBarrier<PIPE_M>();
            SetFlag<HardEvent::M_MTE1>(fs);
            fragmentSlot ^= 1;
        }
        SetFlag<HardEvent::MTE1_MTE2>(p.slot);
        if (p.last)
        {
            GlobalTensor<int32_t> dst;
            dst.SetGlobalBuffer((__gm__ int32_t *)p.output);
            if constexpr (!SPLIT)
                CrossCoreWaitFlag(2 + p.outputSlot);
            FixpipeParamsV220 fp;

            fp.nSize = NT;
            fp.mSize = MT >= 256 ? actualM : p.rows;
            fp.srcStride = actualM;
            fp.dstStride = NT;
            fp.quantPre = QuantMode_t::NoQuant;
            fp.reluEn = false;
            fp.unitFlag = 3;
            Fixpipe<int32_t, int32_t, CFG_ROW_MAJOR>(dst, c, fp);
            SetFlag<HardEvent::FIX_M>(cslot);
            if constexpr (!SPLIT)
                CrossCoreSetFlag<2, PIPE_FIX>(p.outputSlot);
        }
    }

  public:
    __aicore__ inline void Init()
    {
        fragmentSlot = 0;
        head = 0;
        pendingCount = 0;
        producer = 0;
        SetLoadDataPaddingValue<uint64_t>(0);
        SetFixpipeNz2ndFlag(1, 0, 0);
        for (int i = 0; i < STAGES; ++i)
            SetFlag<HardEvent::MTE1_MTE2>(i);
        for (int i = 0; i < 2; ++i)
        {
            SetFlag<HardEvent::M_MTE1>(i);
        }
        for (int i = 0; i < CSLOTS; ++i)
            SetFlag<HardEvent::FIX_M>(i);
    }

    __aicore__ inline void Compute(const GlobalTensor<int8_t> &a, const GlobalTensor<int8_t> &b,
                                   const GlobalTensor<int32_t> &dst, int rows, int cols, int K,
                                   int N, int start, int depth, int outputSlot)
    {
        const int panels = (depth + LK - 1) / LK;
        for (int p = 0; p < panels; ++p)
        {
            const int slot = producer;
            int ki = p;
            if constexpr (MT >= 64 && NT >= 128)
                ki = (p + GetBlockIdx()) % panels;
            const int count = Min(LK, depth - ki * LK);
            WaitFlag<HardEvent::MTE1_MTE2>(slot);
            CopyNd(l1[slot * PANEL], a[start + ki * LK], rows, count, K, MT);
            CopyNd(l1[slot * PANEL + MT * LK], b[int64_t(start + ki * LK) * N], count, cols, N, LK);
            SetFlag<HardEvent::MTE2_MTE1>(slot);

            if (pendingCount == (STAGES < 3 ? 1 : 2))
            {
                Consume(pending[head]);
                pending[head] = {slot,   count,          rows,
                                 cols,   outputSlot,     (GM_ADDR)dst.GetPhyAddr(),
                                 p == 0, p + 1 == panels};
                head ^= 1;
            }
            else
            {
                pending[(head + pendingCount) & 1] = {
                    slot,   count,          rows, cols, outputSlot, (GM_ADDR)dst.GetPhyAddr(),
                    p == 0, p + 1 == panels};
                ++pendingCount;
            }
            producer = producer + 1 < STAGES ? producer + 1 : 0;
        }
    }

    __aicore__ inline void Discard()
    {
        while (pendingCount)
        {
            WaitFlag<HardEvent::MTE2_MTE1>(pending[head].slot);
            SetFlag<HardEvent::MTE1_MTE2>(pending[head].slot);
            head ^= 1;
            --pendingCount;
        }
    }

    __aicore__ inline void Finish()
    {
        while (pendingCount)
        {
            Consume(pending[head]);
            head ^= 1;
            --pendingCount;
        }
        for (int i = 0; i < STAGES; ++i)
            WaitFlag<HardEvent::MTE1_MTE2>(i);
        for (int i = 0; i < 2; ++i)
        {
            WaitFlag<HardEvent::M_MTE1>(i);
        }
        for (int i = 0; i < CSLOTS; ++i)
            WaitFlag<HardEvent::FIX_M>(i);
    }
};

template <int MT, int NT, bool KEEP_LAYOUT = false> class Epilogue
{
    static constexpr int ROWS = (MT + 1) / 2;
    static constexpr int CHUNK_ROWS = ROWS < 8192 / NT ? ROWS : 8192 / NT;
    static constexpr int SIZE = CHUNK_ROWS * NT;
    static_assert(CHUNK_ROWS >= 1 && SIZE * 16 + NT * 8 + 256 <= 172032,
                  "pipelined epilogue overlaps group cache");
    LocalTensor<int32_t> accum{TPosition::VECCALC, 0, SIZE * 2};
    LocalTensor<float> temporary{TPosition::VECCALC, SIZE * 8 + 256, SIZE};
    LocalTensor<half> output{TPosition::VECCALC, SIZE * 12 + 256, SIZE * 2};
    LocalTensor<float> scales{TPosition::VECCALC, SIZE * 16 + 256, NT * 2};

    struct Pending
    {
        int index, rows, cols, row, col, N, gmSlot;
        GM_ADDR destination;
        bool lastChunk;
    };
    Pending pending;
    bool initialized = false, hasPending = false;
    int producer = 0;

    __aicore__ inline void Init()
    {

        SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
        SetFlag<HardEvent::V_MTE2>(EVENT_ID1);
        SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
        SetFlag<HardEvent::MTE3_V>(EVENT_ID1);
        initialized = true;
    }

    __aicore__ inline void Consume(const Pending &p)
    {
        const event_t event = p.index ? EVENT_ID1 : EVENT_ID0;
        WaitFlag<HardEvent::MTE2_V>(event);

        auto input = accum[p.index * SIZE];
        auto z = input.template ReinterpretCast<float>();
        auto localScale = scales[p.index * NT];
        auto out = output[p.index * SIZE];
        Cast(z, input, RoundMode::CAST_RINT, p.rows * NT);
        PipeBarrier<PIPE_V>();
        for (int r = 0; r < p.rows; r += 128)
            for (int c = 0; c < NT; c += 64)
            {
                const int width = Min(64, NT - c);
                Mul(z[r * NT + c], z[r * NT + c], localScale[c], width, Min(128, p.rows - r),
                    {1, 1, 1, uint8_t(NT / 8), uint8_t(NT / 8), 0});
            }
        PipeBarrier<PIPE_V>();
        WaitFlag<HardEvent::MTE3_V>(event);
        Gelu(z, temporary, out, p.rows * NT);
        SetFlag<HardEvent::V_MTE3>(event);
        WaitFlag<HardEvent::V_MTE3>(event);
        GlobalTensor<half> destination;
        destination.SetGlobalBuffer((__gm__ half *)p.destination);
        if (p.rows == CHUNK_ROWS && p.cols == NT && p.N == NT)
            DataCopy(destination[int64_t(p.row) * p.N + p.col], out, p.rows * NT);
        else
            DataCopyPad(destination[int64_t(p.row) * p.N + p.col], out,
                        DataCopyExtParams(p.rows, p.cols * 2, (NT - Up(p.cols, 16)) / 16,
                                          (p.N - p.cols) * 2, 0));
        SetFlag<HardEvent::MTE3_V>(event);
        SetFlag<HardEvent::V_MTE2>(event);
    }

    __aicore__ inline void Flush()
    {
        if (hasPending)
        {
            Consume(pending);
            hasPending = false;
        }
    }

  public:
    __aicore__ inline ~Epilogue()
    {
        if (initialized)
        {
            Flush();
            WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
            WaitFlag<HardEvent::V_MTE2>(EVENT_ID1);
            WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
            WaitFlag<HardEvent::MTE3_V>(EVENT_ID1);
        }
    }

    __aicore__ inline void Run(const GlobalTensor<int32_t> &src, const GlobalTensor<float> &scale,
                               const GlobalTensor<half> &y, int row, int col, int rows, int cols,
                               int N, int expert, int shards = 1, int slot = 0)
    {
        const int first = GetSubBlockIdx() * ((rows + 1) / 2);
        const int valid = GetSubBlockIdx() ? rows / 2 : (rows + 1) / 2;
        if (valid <= 0)
        {

            Flush();
            CrossCoreSetFlag<2, PIPE_MTE2>(2 + slot);
            return;
        }
        if (!initialized)
            Init();
        for (int offset = 0; offset < valid; offset += CHUNK_ROWS)
        {
            const int index = producer;
            const event_t event = index ? EVENT_ID1 : EVENT_ID0;
            const int count = Min(CHUNK_ROWS, valid - offset);
            WaitFlag<HardEvent::V_MTE2>(event);
            DataCopy(accum[index * SIZE], src[(first + offset) * NT], count * NT);
            if (offset + count == valid)
                CrossCoreSetFlag<2, PIPE_MTE2>(2 + slot);
            if (cols == NT && (N == NT || cols % 16 == 0))
                DataCopy(scales[index * NT], scale[expert * N + col], cols);
            else
                DataCopyPad(scales[index * NT], scale[expert * N + col],
                            DataCopyExtParams(1, cols * 4, 0, 0, 0),
                            DataCopyPadExtParams<float>{false, 0, 0, 0.0f});
            SetFlag<HardEvent::MTE2_V>(event);
            Flush();
            pending = {index,
                       count,
                       cols,
                       row + first + offset,
                       col,
                       N,
                       slot,
                       (GM_ADDR)y.GetPhyAddr(),
                       offset + count == valid};
            hasPending = true;
            producer ^= 1;
        }
    }
};

template <int MT, int NT, int ST, int LK, bool FULL_PANEL>
__global__ __mix__(1, 2)
    __attribute__((aligned(4096))) void Streamed(GM_ADDR x, GM_ADDR weight, GM_ADDR scale,
                                                 GM_ADDR groups, GM_ADDR y, GM_ADDR workspace,
                                                 int inputK, int inputN, int E, int workers)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
    SetAtomicNone();
    int core = GetBlockIdx();
    if ASCEND_IS_AIV
    {
        core /= GetSubBlockNum();
    }
    GlobalTensor<int8_t> a, b;
    GlobalTensor<int64_t> g;
    GlobalTensor<float> s;
    GlobalTensor<int32_t> buffer;
    GlobalTensor<half> result;
    a.SetGlobalBuffer((__gm__ int8_t *)x);
    b.SetGlobalBuffer((__gm__ int8_t *)weight);
    g.SetGlobalBuffer((__gm__ int64_t *)groups);
    s.SetGlobalBuffer((__gm__ float *)scale);
    buffer.SetGlobalBuffer((__gm__ int32_t *)workspace);
    result.SetGlobalBuffer((__gm__ half *)y);
    const int K = FULL_PANEL ? LK : inputK;
    const int N = FULL_PANEL ? NT : inputN;
    int sequence = 0;
    const int expertBegin = core * E / workers;
    const int expertEnd = (core + 1) * E / workers;
    if ASCEND_IS_AIC
    {
        Cube<MT, NT, false, LK, ST> cube;
        cube.Init();
        bool aligned = false;
        int prefetched = 0;
        if constexpr (FULL_PANEL)
        {

            for (int e = expertBegin; e < expertEnd && prefetched < 4; ++e)
            {
                const int slot = sequence++ & 1;
                cube.Compute(a[int64_t(e) * MT * K], b[int64_t(e) * K * N],
                             buffer[int64_t(core * 2 + slot) * MT * NT], MT, NT, K, N, 0, K, slot);
                ++prefetched;
            }
            CrossCoreWaitFlag(4);
            aligned = buffer[int64_t(workers) * 2 * MT * NT + core * 8].GetValue(0) != 0;
            if (!aligned)
            {
                cube.Discard();
                sequence = 0;
            }
        }
        if (aligned)
        {
            for (int expert = expertBegin + prefetched; expert < expertEnd; ++expert)
            {
                const int slot = sequence++ & 1;
                cube.Compute(a[int64_t(expert) * MT * K], b[int64_t(expert) * K * N],
                             buffer[int64_t(core * 2 + slot) * MT * NT], MT, NT, K, N, 0, K, slot);
            }
        }
        else
        {
            for (int expert = expertBegin; expert < expertEnd; ++expert)
            {
                const int start = expert ? int(g.GetValue(expert - 1)) : 0;
                const int length = int(g.GetValue(expert)) - start;
                if (length == MT)
                {
                    for (int col = 0; col < N; col += NT)
                    {
                        const int slot = sequence++ & 1;
                        cube.Compute(a[int64_t(start) * K], b[int64_t(expert) * K * N + col],
                                     buffer[int64_t(core * 2 + slot) * MT * NT], MT,
                                     Min(NT, N - col), K, N, 0, K, slot);
                    }
                    continue;
                }
                for (int row = 0; row < length; row += MT)
                {
                    for (int col = 0; col < N; col += NT)
                    {
                        const int slot = sequence++ & 1;
                        cube.Compute(a[int64_t(start + row) * K], b[int64_t(expert) * K * N + col],
                                     buffer[int64_t(core * 2 + slot) * MT * NT],
                                     Min(MT, length - row), Min(NT, N - col), K, N, 0, K, slot);
                    }
                }
            }
        }
        cube.Finish();
    }
    if ASCEND_IS_AIV
    {
        TPipe pipe;
        SetMaskNorm();
        SetVectorMask<uint8_t>(~uint64_t(0), ~uint64_t(0));
        LocalTensor<int64_t> ends(TPosition::VECCALC, 172032, 128);
        DataCopyPad(ends, g, DataCopyExtParams(1, E * 8, 0, 0, 0),
                    DataCopyPadExtParams<int64_t>{false, 0, 0, 0});
        SetFlag<HardEvent::MTE2_S>(EVENT_ID4);
        Epilogue<MT, NT> epilogue;
        CrossCoreSetFlag<2, PIPE_MTE2>(2);
        CrossCoreSetFlag<2, PIPE_MTE2>(3);
        WaitFlag<HardEvent::MTE2_S>(EVENT_ID4);
        bool aligned = FULL_PANEL;
        if constexpr (FULL_PANEL)
        {
            for (int e = expertBegin; e < expertEnd; ++e)
            {
                if (ends.GetValue(e) != int64_t(e + 1) * MT ||
                    (e && ends.GetValue(e - 1) != int64_t(e) * MT))
                    aligned = false;
            }
        }
        if constexpr (FULL_PANEL)
        {
            if (GetSubBlockIdx() == 0)
            {
                LocalTensor<int32_t> decision(TPosition::VECCALC, 173056, 8);
                decision.SetValue(0, int32_t(aligned));
                SetFlag<HardEvent::S_MTE3>(EVENT_ID4);
                WaitFlag<HardEvent::S_MTE3>(EVENT_ID4);
                DataCopyPad(buffer[int64_t(workers) * 2 * MT * NT + core * 8], decision,
                            DataCopyExtParams(1, 4, 0, 0, 0));
            }
            CrossCoreSetFlag<2, PIPE_MTE3>(4);
        }
        if constexpr (FULL_PANEL)
        {
            if (!aligned)
            {
                const int staged = Min(4, expertEnd - expertBegin);

                for (int discarded = 0; discarded < staged - 2; ++discarded)
                {
                    CrossCoreWaitFlag(discarded);
                    CrossCoreSetFlag<2, PIPE_MTE2>(2 + discarded);
                }
            }
        }
        if (aligned)
        {
            for (int expert = expertBegin; expert < expertEnd; ++expert)
            {
                const int slot = sequence++ & 1;
                CrossCoreWaitFlag(slot);
                epilogue.Run(buffer[int64_t(core * 2 + slot) * MT * NT], s, result, expert * MT, 0,
                             MT, NT, N, expert, 1, slot);
            }
        }
        else
        {
            for (int expert = expertBegin; expert < expertEnd; ++expert)
            {
                const int start = expert ? int(ends.GetValue(expert - 1)) : 0;
                const int length = int(ends.GetValue(expert)) - start;
                if (length == MT)
                {
                    for (int col = 0; col < N; col += NT)
                    {
                        const int slot = sequence++ & 1;
                        CrossCoreWaitFlag(slot);
                        epilogue.Run(buffer[int64_t(core * 2 + slot) * MT * NT], s, result, start,
                                     col, MT, Min(NT, N - col), N, expert, 1, slot);
                    }
                    continue;
                }
                for (int row = 0; row < length; row += MT)
                {
                    for (int col = 0; col < N; col += NT)
                    {
                        const int slot = sequence++ & 1;
                        CrossCoreWaitFlag(slot);
                        epilogue.Run(buffer[int64_t(core * 2 + slot) * MT * NT], s, result,
                                     start + row, col, Min(MT, length - row), Min(NT, N - col), N,
                                     expert, 1, slot);
                    }
                }
            }
        }
    }
}

template <int MT>
__aicore__ inline bool DistantBoundary(const LocalTensor<int64_t> &ends, int boundary, int E,
                                       int workers)
{
    if (boundary == 0 || boundary == workers)
        return false;
    const int expert = boundary * E / workers;
    const int actual = int(ends.GetValue(expert - 1));
    return actual < (expert - 2) * MT || actual > (expert + 2) * MT;
}

template <int MT>
__aicore__ inline void RegionalPlan(const LocalTensor<int64_t> &ends, int core, int E, int workers,
                                    int &rowBegin, int &rowEnd, int &firstExpert)
{
    LocalTensor<int32_t> cohort(TPosition::VECCALC, 173056, 8);
    const int packed = int(cohort.GetValue(2));
    const int eBegin = packed & 255, eEnd = (packed >> 8) & 255;
    const int left = (packed >> 16) & 255, right = packed >> 24;
    const int begin = eBegin ? int(ends.GetValue(eBegin - 1)) : 0;
    const int end = int(ends.GetValue(eEnd - 1));
    int tasks = 0, previous = begin;
    for (int expert = eBegin; expert < eEnd; ++expert)
    {
        const int next = int(ends.GetValue(expert));
        tasks += (next - previous + MT - 1) / MT;
        previous = next;
    }
    const int first = tasks * (core - left) / (right - left);
    const int last = tasks * (core + 1 - left) / (right - left);
    rowBegin = end;
    rowEnd = end;
    firstExpert = eEnd;
    int base = 0;
    previous = begin;
    for (int expert = eBegin; expert < eEnd; ++expert)
    {
        const int next = int(ends.GetValue(expert));
        const int count = (next - previous + MT - 1) / MT;
        if (first >= base && first < base + count)
        {
            rowBegin = previous + (first - base) * MT;
            firstExpert = expert;
        }
        if (last > base && last <= base + count)
            rowEnd = Min(previous + (last - base) * MT, next);
        base += count;
        previous = next;
    }
    if (first == last)
        rowEnd = rowBegin;
}

template <int MT>
__aicore__ __attribute__((noinline)) bool DenseFragments(const LocalTensor<int64_t> &ends, int core,
                                                         int E, int workers)
{
    int left = core, right = core + 1;
    while (DistantBoundary<MT>(ends, left, E, workers))
        --left;
    while (DistantBoundary<MT>(ends, right, E, workers))
        ++right;
    const int eBegin = left * E / workers, eEnd = right * E / workers;
    const int window = Min(MT / 2, eEnd - eBegin);
    for (int side = 0; side < 2; ++side)
    {
        const int begin = side ? eEnd - window : eBegin;
        const int first = begin ? int(ends.GetValue(begin - 1)) : 0;
        const int span = int(ends.GetValue(begin + window - 1)) - first;
        if (span <= 0 || span > window * (MT / 8))
            continue;
        int nonempty = 0, previous = first;
        for (int expert = begin; expert < begin + window; ++expert)
        {
            const int next = int(ends.GetValue(expert));
            nonempty += next > previous;
            previous = next;
        }
        if (2 * nonempty >= window)
        {
            LocalTensor<int32_t> cohort(TPosition::VECCALC, 173056, 8);
            cohort.SetValue(2, eBegin | (eEnd << 8) | (left << 16) | (right << 24));
            return true;
        }
    }
    return false;
}

template <int MT, int NT, int ST, int LK>
__aicore__ __attribute__((noinline)) void RegionalCube(GM_ADDR x, GM_ADDR weight, GM_ADDR groups,
                                                       GM_ADDR workspace, int core, int E,
                                                       int workers)
{
    if ASCEND_IS_AIC
    {
        GlobalTensor<int8_t> a, b;
        GlobalTensor<int64_t> g;
        GlobalTensor<int32_t> buffer;
        a.SetGlobalBuffer((__gm__ int8_t *)x);
        b.SetGlobalBuffer((__gm__ int8_t *)weight);
        g.SetGlobalBuffer((__gm__ int64_t *)groups);
        buffer.SetGlobalBuffer((__gm__ int32_t *)workspace);
        const int K = LK, N = NT;
        const int expertBegin = core * E / workers;
        const int expertEnd = (core + 1) * E / workers;
        int sequence = 0;
        Cube<MT, NT, false, LK, ST> cube;
        cube.Init();
        const int actualBegin = expertBegin ? int(g.GetValue(expertBegin - 1)) : 0;
        const int actualEnd = int(g.GetValue(expertEnd - 1));
        const int nominalBegin = expertBegin * MT;
        const int nominalEnd = expertEnd * MT;
        const int regionBegin = actualBegin < nominalBegin - 2 * MT
                                    ? nominalBegin - 2 * MT
                                    : Min(actualBegin, nominalBegin + 2 * MT);
        const int regionEnd = actualEnd < nominalEnd - 2 * MT ? nominalEnd - 2 * MT
                                                              : Min(actualEnd, nominalEnd + 2 * MT);
        int low = expertBegin;
        if (actualBegin != regionBegin)
        {
            low = 0;
            int high = E;
            while (low < high)
            {
                const int middle = (low + high) / 2;
                if (int(g.GetValue(middle)) <= regionBegin)
                    low = middle + 1;
                else
                    high = middle;
            }
        }
        int position = regionBegin;
        for (int expert = low; expert < E && position < regionEnd; ++expert)
        {
            const int start = position;
            const int groupEnd = int(g.GetValue(expert));
            position = Min(groupEnd, regionEnd);
            const int length = position - start;
            if (length == MT)
            {
                for (int col = 0; col < N; col += NT)
                {
                    const int slot = sequence++ & 1;
                    cube.Compute(a[int64_t(start) * K], b[int64_t(expert) * K * N + col],
                                 buffer[int64_t(core * 2 + slot) * (MT * NT + 128)], MT,
                                 Min(NT, N - col), K, N, 0, K, slot);
                }
                continue;
            }
            for (int row = 0; row < length; row += MT)
            {
                for (int col = 0; col < N; col += NT)
                {
                    const int slot = sequence++ & 1;
                    cube.Compute(a[int64_t(start + row) * K], b[int64_t(expert) * K * N + col],
                                 buffer[int64_t(core * 2 + slot) * (MT * NT + 128)],
                                 Min(MT, length - row), Min(NT, N - col), K, N, 0, K, slot);
                }
            }
        }
        cube.Finish();
    }
}

template <int MT, int NT>
__aicore__ __attribute__((noinline)) void
RegionalVector(GM_ADDR scale, GM_ADDR y, GM_ADDR workspace, int core, int E, int workers)
{
    if ASCEND_IS_AIV
    {
        GlobalTensor<float> s;
        GlobalTensor<int32_t> buffer;
        GlobalTensor<half> result;
        s.SetGlobalBuffer((__gm__ float *)scale);
        buffer.SetGlobalBuffer((__gm__ int32_t *)workspace);
        result.SetGlobalBuffer((__gm__ half *)y);
        LocalTensor<int64_t> ends(TPosition::VECCALC, 172032, 128);
        const int N = NT;
        const int expertBegin = core * E / workers;
        const int expertEnd = (core + 1) * E / workers;
        int sequence = 0;
        Epilogue<MT, NT> epilogue;
        const int actualBegin = expertBegin ? int(ends.GetValue(expertBegin - 1)) : 0;
        const int actualEnd = int(ends.GetValue(expertEnd - 1));
        const int nominalBegin = expertBegin * MT;
        const int nominalEnd = expertEnd * MT;
        const int regionBegin = actualBegin < nominalBegin - 2 * MT
                                    ? nominalBegin - 2 * MT
                                    : Min(actualBegin, nominalBegin + 2 * MT);
        const int regionEnd = actualEnd < nominalEnd - 2 * MT ? nominalEnd - 2 * MT
                                                              : Min(actualEnd, nominalEnd + 2 * MT);
        int low = expertBegin;
        if (actualBegin != regionBegin)
        {
            low = 0;
            int high = E;
            while (low < high)
            {
                const int middle = (low + high) / 2;
                if (int(ends.GetValue(middle)) <= regionBegin)
                    low = middle + 1;
                else
                    high = middle;
            }
        }
        int position = regionBegin;
        for (int expert = low; expert < E && position < regionEnd; ++expert)
        {
            const int start = position;
            const int groupEnd = int(ends.GetValue(expert));
            position = Min(groupEnd, regionEnd);
            const int length = position - start;
            if (length == MT)
            {
                for (int col = 0; col < N; col += NT)
                {
                    const int slot = sequence++ & 1;
                    CrossCoreWaitFlag(slot);
                    epilogue.Run(buffer[int64_t(core * 2 + slot) * (MT * NT + 128)], s, result,
                                 start, col, MT, Min(NT, N - col), N, expert, 1, slot);
                }
                continue;
            }
            for (int row = 0; row < length; row += MT)
            {
                for (int col = 0; col < N; col += NT)
                {
                    const int slot = sequence++ & 1;
                    CrossCoreWaitFlag(slot);
                    epilogue.Run(buffer[int64_t(core * 2 + slot) * (MT * NT + 128)], s, result,
                                 start + row, col, Min(MT, length - row), Min(NT, N - col), N,
                                 expert, 1, slot);
                }
            }
        }
    }
}

template <int MT, int NT, int ST, int LK>
__aicore__ __attribute__((noinline)) void FragmentCube(GM_ADDR x, GM_ADDR weight, GM_ADDR groups,
                                                       GM_ADDR workspace, int core, int E,
                                                       int workers)
{
    if ASCEND_IS_AIC
    {
        GlobalTensor<int8_t> a, b;
        GlobalTensor<int64_t> g;
        GlobalTensor<int32_t> buffer;
        a.SetGlobalBuffer((__gm__ int8_t *)x);
        b.SetGlobalBuffer((__gm__ int8_t *)weight);
        g.SetGlobalBuffer((__gm__ int64_t *)groups);
        buffer.SetGlobalBuffer((__gm__ int32_t *)workspace);
        const int K = LK, N = NT;
        const int expertBegin = core * E / workers;
        const int expertEnd = (core + 1) * E / workers;
        int sequence = 0;
        Cube<MT, NT, false, LK, ST> cube;
        cube.Init();
        CrossCoreWaitFlag(5);
        GlobalTensor<uint64_t> plan;
        plan.SetGlobalBuffer((__gm__ uint64_t *)workspace);
        DataCacheCleanAndInvalid<uint64_t, CacheLine::SINGLE_CACHE_LINE>(
            plan[int64_t(workers) * (MT * NT + 128) + (core / 2) * 8]);
        const uint64_t descriptor =
            plan.GetValue(int64_t(workers) * (MT * NT + 128) + core * 4 + 1);
        const int regionBegin = int(descriptor & 65535);
        const int regionEnd = int((descriptor >> 16) & 65535);
        const int low = int((descriptor >> 32) & 255);
        int position = regionBegin;
        for (int expert = low; expert < E && position < regionEnd; ++expert)
        {
            const int start = position;
            const int groupEnd = int(g.GetValue(expert));
            position = Min(groupEnd, regionEnd);
            const int length = position - start;
            if (length == MT)
            {
                for (int col = 0; col < N; col += NT)
                {
                    const int slot = sequence++ & 1;
                    cube.Compute(a[int64_t(start) * K], b[int64_t(expert) * K * N + col],
                                 buffer[int64_t(core * 2 + slot) * (MT * NT + 128)], MT,
                                 Min(NT, N - col), K, N, 0, K, slot);
                }
                continue;
            }
            for (int row = 0; row < length; row += MT)
            {
                for (int col = 0; col < N; col += NT)
                {
                    const int slot = sequence++ & 1;
                    cube.Compute(a[int64_t(start + row) * K], b[int64_t(expert) * K * N + col],
                                 buffer[int64_t(core * 2 + slot) * (MT * NT + 128)],
                                 Min(MT, length - row), Min(NT, N - col), K, N, 0, K, slot);
                }
            }
        }
        cube.Finish();
    }
}

template <int MT, int NT>
__aicore__ __attribute__((noinline)) void
FragmentVector(GM_ADDR scale, GM_ADDR y, GM_ADDR workspace, int core, int E, int workers)
{
    if ASCEND_IS_AIV
    {
        GlobalTensor<float> s;
        GlobalTensor<int32_t> buffer;
        GlobalTensor<half> result;
        s.SetGlobalBuffer((__gm__ float *)scale);
        buffer.SetGlobalBuffer((__gm__ int32_t *)workspace);
        result.SetGlobalBuffer((__gm__ half *)y);
        LocalTensor<int64_t> ends(TPosition::VECCALC, 172032, 128);
        const int N = NT;
        const int expertBegin = core * E / workers;
        const int expertEnd = (core + 1) * E / workers;
        int sequence = 0;
        Epilogue<MT, NT> epilogue;
        int regionBegin, regionEnd, low;
        RegionalPlan<MT>(ends, core, E, workers, regionBegin, regionEnd, low);
        if (GetSubBlockIdx() == 0)
        {
            LocalTensor<uint64_t> decision(TPosition::VECCALC, 173056, 4);
            decision.SetValue(0, uint64_t(4));
            decision.SetValue(1, uint64_t(regionBegin) | (uint64_t(regionEnd) << 16) |
                                     (uint64_t(low) << 32));
            decision.SetValue(2, uint64_t(0));
            decision.SetValue(3, uint64_t(0));
            SetFlag<HardEvent::S_MTE3>(EVENT_ID4);
            WaitFlag<HardEvent::S_MTE3>(EVENT_ID4);
            DataCopy(buffer[int64_t(workers) * 2 * (MT * NT + 128) + core * 8],
                     decision.ReinterpretCast<int32_t>(), 8);
        }
        CrossCoreSetFlag<2, PIPE_MTE3>(5);
        int position = regionBegin;
        for (int expert = low; expert < E && position < regionEnd; ++expert)
        {
            const int start = position;
            const int groupEnd = int(ends.GetValue(expert));
            position = Min(groupEnd, regionEnd);
            const int length = position - start;
            if (length == MT)
            {
                for (int col = 0; col < N; col += NT)
                {
                    const int slot = sequence++ & 1;
                    CrossCoreWaitFlag(slot);
                    epilogue.Run(buffer[int64_t(core * 2 + slot) * (MT * NT + 128)], s, result,
                                 start, col, MT, Min(NT, N - col), N, expert, 1, slot);
                }
                continue;
            }
            for (int row = 0; row < length; row += MT)
            {
                for (int col = 0; col < N; col += NT)
                {
                    const int slot = sequence++ & 1;
                    CrossCoreWaitFlag(slot);
                    epilogue.Run(buffer[int64_t(core * 2 + slot) * (MT * NT + 128)], s, result,
                                 start + row, col, Min(MT, length - row), Min(NT, N - col), N,
                                 expert, 1, slot);
                }
            }
        }
    }
}

template <int MT> __aicore__ inline bool CompactWindow(const LocalTensor<int64_t> &ends, int E)
{
    int previous = 0;
    for (int first = 0; first < E; first += MT / 2)
    {
        const int count = Min(MT / 2, E - first);
        const int next = int(ends.GetValue(first + count - 1));
        const int span = next - previous;
        if (span > 0 && span <= count * (MT / 8))
            return true;
        previous = next;
    }
    return false;
}

template <int MT>
__aicore__ __attribute__((noinline)) void SaveRegionalChoice(const LocalTensor<int64_t> &ends,
                                                             int core, int E, int workers)
{
    if ASCEND_IS_AIV
    {
        LocalTensor<int32_t> decision(TPosition::VECCALC, 173056, 8);
        decision.SetValue(0, DenseFragments<MT>(ends, core, E, workers) ? 4 : 2);
    }
}

template <int MT, int NT, int ST, int LK, bool FULL_PANEL>
__global__ __mix__(1, 2)
    __attribute__((aligned(4096))) void Balanced(GM_ADDR x, GM_ADDR weight, GM_ADDR scale,
                                                 GM_ADDR groups, GM_ADDR y, GM_ADDR workspace,
                                                 int inputK, int inputN, int E, int workers)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
    SetAtomicNone();
    int core = GetBlockIdx();
    if ASCEND_IS_AIV
    {
        core /= GetSubBlockNum();
    }
    GlobalTensor<int8_t> a, b;
    GlobalTensor<int64_t> g;
    GlobalTensor<float> s;
    GlobalTensor<int32_t> buffer;
    GlobalTensor<half> result;
    a.SetGlobalBuffer((__gm__ int8_t *)x);
    b.SetGlobalBuffer((__gm__ int8_t *)weight);
    g.SetGlobalBuffer((__gm__ int64_t *)groups);
    s.SetGlobalBuffer((__gm__ float *)scale);
    buffer.SetGlobalBuffer((__gm__ int32_t *)workspace);
    result.SetGlobalBuffer((__gm__ half *)y);
    const int K = FULL_PANEL ? LK : inputK;
    const int N = FULL_PANEL ? NT : inputN;
    int sequence = 0;
    const int expertBegin = core * E / workers;
    const int expertEnd = (core + 1) * E / workers;
    if ASCEND_IS_AIC
    {
        Cube<MT, NT, false, LK, ST> cube;
        cube.Init();
        int layout = 0;
        int prefetched = 0;
        if constexpr (FULL_PANEL)
        {

            for (int e = expertBegin; e < expertEnd && prefetched < 4; ++e)
            {
                const int slot = sequence++ & 1;
                cube.Compute(a[int64_t(e) * MT * K], b[int64_t(e) * K * N],
                             buffer[int64_t(core * 2 + slot) * (MT * NT + 128)], MT, NT, K, N, 0, K,
                             slot);
                ++prefetched;
            }
            CrossCoreWaitFlag(4);
            layout = int(buffer[int64_t(workers) * 2 * (MT * NT + 128) + core * 8].GetValue(0));
            if ((layout & 1) == 0)
            {
                cube.Discard();
                sequence = 0;
            }
        }
        if (layout == 1)
        {
            for (int expert = expertBegin + prefetched; expert < expertEnd; ++expert)
            {
                const int slot = sequence++ & 1;
                cube.Compute(a[int64_t(expert) * MT * K], b[int64_t(expert) * K * N],
                             buffer[int64_t(core * 2 + slot) * (MT * NT + 128)], MT, NT, K, N, 0, K,
                             slot);
            }
        }
        else
        {
            if (layout == 0 || layout == 3)
            {
                for (int expert = expertBegin + (layout == 3 ? prefetched : 0); expert < expertEnd;
                     ++expert)
                {
                    const int start = expert ? int(g.GetValue(expert - 1)) : 0;
                    const int length = int(g.GetValue(expert)) - start;
                    if (length == MT)
                    {
                        for (int col = 0; col < N; col += NT)
                        {
                            const int slot = sequence++ & 1;
                            cube.Compute(a[int64_t(start) * K], b[int64_t(expert) * K * N + col],
                                         buffer[int64_t(core * 2 + slot) * (MT * NT + 128)], MT,
                                         Min(NT, N - col), K, N, 0, K, slot);
                        }
                        continue;
                    }
                    for (int row = 0; row < length; row += MT)
                    {
                        for (int col = 0; col < N; col += NT)
                        {
                            const int slot = sequence++ & 1;
                            cube.Compute(a[int64_t(start + row) * K],
                                         b[int64_t(expert) * K * N + col],
                                         buffer[int64_t(core * 2 + slot) * (MT * NT + 128)],
                                         Min(MT, length - row), Min(NT, N - col), K, N, 0, K, slot);
                        }
                    }
                }
            }
            else
            {
                cube.Finish();
                if (layout == 4)
                    FragmentCube<MT, NT, ST, LK>(x, weight, groups, workspace, core, E, workers);
                else
                    RegionalCube<MT, NT, ST, LK>(x, weight, groups, workspace, core, E, workers);
                return;
            }
        }
        cube.Finish();
    }
    if ASCEND_IS_AIV
    {
        TPipe pipe;
        SetMaskNorm();
        SetVectorMask<uint8_t>(~uint64_t(0), ~uint64_t(0));
        LocalTensor<int64_t> ends(TPosition::VECCALC, 172032, 128);
        DataCopyPad(ends, g, DataCopyExtParams(1, E * 8, 0, 0, 0),
                    DataCopyPadExtParams<int64_t>{false, 0, 0, 0});
        SetFlag<HardEvent::MTE2_S>(EVENT_ID4);
        Epilogue<MT, NT> epilogue;
        CrossCoreSetFlag<2, PIPE_MTE2>(2);
        CrossCoreSetFlag<2, PIPE_MTE2>(3);
        WaitFlag<HardEvent::MTE2_S>(EVENT_ID4);
        int intervalBegin = 0, intervalEnd = 0, prefix = 0;
        bool aligned = FULL_PANEL;
        if constexpr (FULL_PANEL)
        {
            intervalBegin = expertBegin ? int(ends.GetValue(expertBegin - 1)) : 0;
            if (intervalBegin == expertBegin * MT)
            {
                int expert = expertBegin;
                for (; expert < expertEnd; ++expert)
                {
                    if (int(ends.GetValue(expert)) != (expert + 1) * MT)
                        break;
                }
                prefix = expert - expertBegin;
            }
            aligned = prefix == expertEnd - expertBegin;
            intervalEnd = aligned ? expertEnd * MT : int(ends.GetValue(expertEnd - 1));
        }
        bool regional = false;
        if constexpr (FULL_PANEL)
        {
            if (!aligned)
            {
                const int actualBegin = intervalBegin;
                const int actualEnd = intervalEnd;
                regional = actualBegin < expertBegin * MT - 2 * MT ||
                           actualBegin > expertBegin * MT + 2 * MT ||
                           actualEnd < expertEnd * MT - 2 * MT ||
                           actualEnd > expertEnd * MT + 2 * MT;
            }
        }
        if (regional)
        {
            if (CompactWindow<MT>(ends, E))
            {
                SaveRegionalChoice<MT>(ends, core, E, workers);
            }
            else
            {
                LocalTensor<int32_t> decision(TPosition::VECCALC, 173056, 8);
                decision.SetValue(0, 2);
            }
        }
        const bool reusePrefix = !aligned && !regional && prefix >= 4;
        if constexpr (FULL_PANEL)
        {
            if (GetSubBlockIdx() == 0)
            {
                LocalTensor<int32_t> decision(TPosition::VECCALC, 173056, 8);
                if (!regional)
                    decision.SetValue(0, int32_t(aligned ? 1 : (reusePrefix ? 3 : 0)));
                SetFlag<HardEvent::S_MTE3>(EVENT_ID4);
                WaitFlag<HardEvent::S_MTE3>(EVENT_ID4);
                DataCopyPad(buffer[int64_t(workers) * 2 * (MT * NT + 128) + core * 8], decision,
                            DataCopyExtParams(1, 4, 0, 0, 0));
            }
            CrossCoreSetFlag<2, PIPE_MTE3>(4);
        }
        if constexpr (FULL_PANEL)
        {
            if (!aligned && !reusePrefix)
            {
                const int staged = Min(4, expertEnd - expertBegin);

                for (int discarded = 0; discarded < staged - 2; ++discarded)
                {
                    CrossCoreWaitFlag(discarded);
                    CrossCoreSetFlag<2, PIPE_MTE2>(2 + discarded);
                }
            }
        }
        if (regional)
        {
            LocalTensor<int32_t> decision(TPosition::VECCALC, 173056, 8);
            if (decision.GetValue(0) == 4)
                FragmentVector<MT, NT>(scale, y, workspace, core, E, workers);
            else
                RegionalVector<MT, NT>(scale, y, workspace, core, E, workers);
            return;
        }
        const int fastEnd = aligned ? expertEnd : (reusePrefix ? expertBegin + 4 : expertBegin);
        for (int expert = expertBegin; expert < fastEnd; ++expert)
        {
            const int slot = sequence++ & 1;
            CrossCoreWaitFlag(slot);
            epilogue.Run(buffer[int64_t(core * 2 + slot) * (MT * NT + 128)], s, result, expert * MT,
                         0, MT, NT, N, expert, 1, slot);
        }
        for (int expert = fastEnd; expert < expertEnd; ++expert)
        {
            const int start = expert ? int(ends.GetValue(expert - 1)) : 0;
            const int length = int(ends.GetValue(expert)) - start;
            if (length == MT)
            {
                for (int col = 0; col < N; col += NT)
                {
                    const int slot = sequence++ & 1;
                    CrossCoreWaitFlag(slot);
                    epilogue.Run(buffer[int64_t(core * 2 + slot) * (MT * NT + 128)], s, result,
                                 start, col, MT, Min(NT, N - col), N, expert, 1, slot);
                }
                continue;
            }
            for (int row = 0; row < length; row += MT)
            {
                for (int col = 0; col < N; col += NT)
                {
                    const int slot = sequence++ & 1;
                    CrossCoreWaitFlag(slot);
                    epilogue.Run(buffer[int64_t(core * 2 + slot) * (MT * NT + 128)], s, result,
                                 start + row, col, Min(MT, length - row), Min(NT, N - col), N,
                                 expert, 1, slot);
                }
            }
        }
    }
}

template <int MT, int NT, int ST, int LK>
inline void Launch(GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR g, GM_ADDR y, int K, int N, int E,
                   int cores, aclrtStream stream)
{
    const bool balanced = K == LK && N == NT && E > 6 * cores;
    const int slotPitch = MT * NT + (balanced ? 128 : 0);
    grouped_gelu::Workspace memory(size_t(cores) * (2 * slotPitch * 4 + 32), stream);
    if (!memory.Data())
        return;
    if (balanced)
        Balanced<MT, NT, ST, LK, true>
            <<<cores, nullptr, stream>>>(x, w, s, g, y, memory.Data(), K, N, E, cores);
    else if (K == LK && N == NT)
        Streamed<MT, NT, ST, LK, true>
            <<<cores, nullptr, stream>>>(x, w, s, g, y, memory.Data(), K, N, E, cores);
    else
        Streamed<MT, NT, ST, LK, false>
            <<<cores, nullptr, stream>>>(x, w, s, g, y, memory.Data(), K, N, E, cores);
    memory.Complete();
}

}

namespace shallow_wide
{

using namespace AscendC;

using grouped_gelu::Min;
using grouped_gelu::Up;

__aicore__ inline void Gelu(const LocalTensor<float> &z, const LocalTensor<float> &temporary,
                            const LocalTensor<half> &out, int count)
{
    Mul(temporary, z, z, count);
    PipeBarrier<PIPE_V>();
    Muls(temporary, temporary, -0.07135481627260025f, count);
    PipeBarrier<PIPE_V>();
    Adds(temporary, temporary, -1.5957691216057308f, count);
    PipeBarrier<PIPE_V>();
    Mul(temporary, temporary, z, count);
    PipeBarrier<PIPE_V>();
    Exp(temporary, temporary, count);
    PipeBarrier<PIPE_V>();
    Adds(temporary, temporary, 1.0f, count);
    PipeBarrier<PIPE_V>();
    Div(z, z, temporary, count);
    PipeBarrier<PIPE_V>();
    WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
    Cast(out, z, RoundMode::CAST_RINT, count);
}

template <int MT, int NT, bool SPLIT, int LK = 256, int NSTAGES = 3> class Cube
{
    static constexpr int FK = 128, STAGES = NSTAGES, ASTAGES = 2;
    static constexpr int APANEL = MT * LK, BPANEL = NT * LK, QUEUE = STAGES - 1;
    static constexpr int CSLOTS = MT * NT * 4 <= 65536 ? 2 : 1;
    static_assert(!SPLIT && STAGES >= 2 && STAGES <= 3, "complete shallow reduction required");
    static_assert(ASTAGES * APANEL + STAGES * BPANEL <= 524288, "L1 capacity exceeded");
    static_assert(2 * MT * FK <= 65536 && 2 * NT * FK <= 65536, "L0A/B capacity exceeded");
    static_assert(CSLOTS * MT * NT * 4 <= 131072, "L0C capacity exceeded");
    LocalTensor<int8_t> aCache{TPosition::A1, 0, ASTAGES * APANEL};
    LocalTensor<int8_t> bL1{TPosition::A1, ASTAGES * APANEL, STAGES * BPANEL};
    LocalTensor<int8_t> a0{TPosition::A2, 0, 2 * MT * FK};
    LocalTensor<int8_t> b0{TPosition::B2, 0, 2 * NT * FK};
    LocalTensor<int32_t> c0{TPosition::CO1, 0, CSLOTS * MT * NT};
    struct Pending
    {
        int slot, rows, cols, outputSlot, aSlot, K;
        bool lastColumn;
        GM_ADDR output;
    };
    Pending pending[QUEUE];
    int fragmentSlot = 0, producer = 0, head = 0, pendingCount = 0;

    __aicore__ inline void Consume(const Pending &p)
    {
        const int cslot = p.outputSlot % CSLOTS;
        WaitFlag<HardEvent::FIX_M>(cslot);
        WaitFlag<HardEvent::MTE2_MTE1>(event_t(p.slot));
        auto c = c0[cslot * MT * NT];
        const int actualM = Up(p.rows, 16), activeN = actualM < 32 ? NT : Up(p.cols, 32);
        for (int f = 0; f < p.K; f += FK)
        {
            const int fk = Up(Min(FK, p.K - f), 32), fs = fragmentSlot;
            WaitFlag<HardEvent::M_MTE1>(event_t(fs));
            auto aa = a0[fs * MT * FK];
            auto bb = b0[fs * NT * FK];
            auto la = aCache[p.aSlot * APANEL + f * MT];
            auto lb = bL1[p.slot * BPANEL + f * 32];
            LoadData2DParams pa;
            pa.startIndex = 0;
            pa.repeatTimes = fk / 32;
            pa.srcStride = MT / 16;
            pa.dstGap = 0;
            pa.ifTranspose = false;
            pa.sid = 0;
            pa.addrMode = 0;
            for (int mi = 0; mi < (p.rows + 15) / 16; ++mi)
                LoadData(aa[mi * fk * 16], la[mi * 512], pa);
            LoadData2dTransposeParams pb;
            pb.startIndex = 0;
            pb.repeatTimes = (p.cols + 31) / 32;
            pb.srcStride = LK / 32;
            pb.dstGap = 1;
            pb.dstFracGap = 0;
            for (int ki = 0; ki < fk / 32; ++ki)
                LoadDataWithTranspose(bb[ki * activeN * 32], lb[ki * 1024], pb);
            SetFlag<HardEvent::MTE1_M>(event_t(fs));
            WaitFlag<HardEvent::MTE1_M>(event_t(fs));
            MmadParams mm;
            mm.m = actualM;
            mm.n = activeN;
            mm.k = fk;
            mm.cmatrixInitVal = f == 0;
            mm.unitFlag = f + FK >= p.K ? 3 : 2;
            Mmad(c, aa, bb, mm);
            if (actualM * activeN < 2560)
                PipeBarrier<PIPE_M>();
            SetFlag<HardEvent::M_MTE1>(event_t(fs));
            fragmentSlot ^= 1;
        }
        SetFlag<HardEvent::MTE1_MTE2>(event_t(p.slot));
        if (p.lastColumn)
            SetFlag<HardEvent::MTE1_MTE2>(event_t(STAGES + p.aSlot));
        GlobalTensor<int32_t> dst;
        dst.SetGlobalBuffer((__gm__ int32_t *)p.output);
        CrossCoreWaitFlag(2 + p.outputSlot);
        FixpipeParamsV220 fp;
        fp.nSize = activeN;
        fp.mSize = p.rows;
        fp.srcStride = actualM;
        fp.dstStride = activeN;
        fp.quantPre = QuantMode_t::NoQuant;
        fp.reluEn = false;
        fp.unitFlag = 3;
        Fixpipe<int32_t, int32_t, CFG_ROW_MAJOR>(dst, c, fp);
        SetFlag<HardEvent::FIX_M>(event_t(cslot));
        CrossCoreSetFlag<2, PIPE_FIX>(p.outputSlot);
    }

  public:
    __aicore__ inline void Init()
    {
        SetLoadDataPaddingValue<uint64_t>(0);
        SetFixpipeNz2ndFlag(1, 0, 0);
        for (int i = 0; i < STAGES + ASTAGES; ++i)
            SetFlag<HardEvent::MTE1_MTE2>(event_t(i));
        for (int i = 0; i < 2; ++i)
            SetFlag<HardEvent::M_MTE1>(event_t(i));
        for (int i = 0; i < CSLOTS; ++i)
            SetFlag<HardEvent::FIX_M>(event_t(i));
    }
    __aicore__ inline void LoadA(const GlobalTensor<int8_t> &src, int rows, int K, int aSlot)
    {
        WaitFlag<HardEvent::MTE1_MTE2>(event_t(STAGES + aSlot));
        Nd2NzParams p;
        p.ndNum = 1;
        p.nValue = rows;
        p.dValue = K;
        p.srcNdMatrixStride = 0;
        p.srcDValue = K;
        p.dstNzC0Stride = MT;
        p.dstNzNStride = 1;
        p.dstNzMatrixStride = 0;
        if (K % 4 == 0)
        {
            GlobalTensor<float> wide;
            wide.SetGlobalBuffer((__gm__ float *)src.GetPhyAddr());
            p.dValue = K / 4;
            p.srcDValue = K / 4;
            DataCopy(aCache[aSlot * APANEL].template ReinterpretCast<float>(), wide, p);
        }
        else
            DataCopy(aCache[aSlot * APANEL], src, p);
    }
    __aicore__ inline void Compute(const GlobalTensor<int8_t> &b, const GlobalTensor<int32_t> &dst,
                                   int rows, int cols, int K, int KP, int outputSlot, int aSlot,
                                   bool lastColumn)
    {
        const int slot = producer;
        WaitFlag<HardEvent::MTE1_MTE2>(event_t(slot));
        DataCopy(bL1[slot * BPANEL], b,
                 DataCopyParams((cols + 31) / 32, Up(K, 32), KP - Up(K, 32), LK - Up(K, 32)));
        SetFlag<HardEvent::MTE2_MTE1>(event_t(slot));
        const Pending value = {slot,  rows, cols,       outputSlot,
                               aSlot, K,    lastColumn, (GM_ADDR)dst.GetPhyAddr()};
        if (pendingCount == QUEUE)
        {
            Consume(pending[head]);
            pending[head] = value;
            head = head + 1 < QUEUE ? head + 1 : 0;
        }
        else
        {
            const int tail =
                head + pendingCount < QUEUE ? head + pendingCount : head + pendingCount - QUEUE;
            pending[tail] = value;
            ++pendingCount;
        }
        producer = producer + 1 < STAGES ? producer + 1 : 0;
    }
    __aicore__ inline void Finish()
    {
        while (pendingCount)
        {
            Consume(pending[head]);
            head = head + 1 < QUEUE ? head + 1 : 0;
            --pendingCount;
        }
        for (int i = 0; i < STAGES + ASTAGES; ++i)
            WaitFlag<HardEvent::MTE1_MTE2>(event_t(i));
        for (int i = 0; i < 2; ++i)
            WaitFlag<HardEvent::M_MTE1>(event_t(i));
        for (int i = 0; i < CSLOTS; ++i)
            WaitFlag<HardEvent::FIX_M>(event_t(i));
    }
};

template <int MT, int NT, bool KEEP_LAYOUT = false, int RESERVE_NT = NT> class EpilogueSequential
{
    static constexpr int ROWS = (MT + 1) / 2;
    static constexpr int SIZE = ROWS * RESERVE_NT;
    static constexpr int UB_SHIFT = KEEP_LAYOUT ? 0 : 256;
    static_assert(SIZE * 10 + NT * 4 + UB_SHIFT <= 196608, "UB capacity exceeded");
    LocalTensor<int32_t> accum{TPosition::VECCALC, 0, SIZE};
    LocalTensor<float> temporary{TPosition::VECCALC, SIZE * 4 + UB_SHIFT, SIZE};
    LocalTensor<half> output{TPosition::VECCALC, SIZE * 8 + UB_SHIFT, SIZE};

  public:
    __aicore__ inline void Run(const GlobalTensor<int32_t> &src, const GlobalTensor<float> &scale,
                               const GlobalTensor<half> &y, int row, int col, int rows, int cols,
                               int N, int expert, int pitch, int shards = 1, int slot = 0)
    {
        LocalTensor<float> scales(TPosition::VECCALC, SIZE * 10 + UB_SHIFT, pitch);
        const int first = GetSubBlockIdx() * ((rows + 1) / 2);
        const int valid = GetSubBlockIdx() ? rows / 2 : (rows + 1) / 2;
        if (valid <= 0)
        {
            if (shards == 1)
                CrossCoreSetFlag<2, PIPE_MTE2>(2 + slot);
            return;
        }
        DataCopy(accum, src[first * pitch], valid * pitch);
        if (cols == pitch && (N == pitch || cols % 16 == 0))
            DataCopy(scales, scale[expert * N + col], cols);
        else
            DataCopyPad(scales, scale[expert * N + col], DataCopyExtParams(1, cols * 4, 0, 0, 0),
                        DataCopyPadExtParams<float>{false, 0, 0, 0.0f});
        SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
        WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
        for (int s = 1; s < shards; ++s)
        {
            auto part = temporary.template ReinterpretCast<int32_t>();
            DataCopy(part, src[s * MT * pitch + first * pitch], valid * pitch);
            SetFlag<HardEvent::MTE2_V>(EVENT_ID1);
            WaitFlag<HardEvent::MTE2_V>(EVENT_ID1);
            Add(accum, accum, part, valid * pitch);
            SetFlag<HardEvent::V_MTE2>(EVENT_ID1);
            WaitFlag<HardEvent::V_MTE2>(EVENT_ID1);
        }
        if (shards == 1)
            CrossCoreSetFlag<2, PIPE_MTE2>(2 + slot);
        auto z = accum.template ReinterpretCast<float>();
        Cast(z, accum, RoundMode::CAST_RINT, valid * pitch);
        PipeBarrier<PIPE_V>();

        for (int r = 0; r < valid; r += 128)
            for (int c = 0; c < pitch; c += 64)
            {
                const int width = Min(64, pitch - c);
                Mul(z[r * pitch + c], z[r * pitch + c], scales[c], width, Min(128, valid - r),
                    {1, 1, 1, uint8_t(pitch / 8), uint8_t(pitch / 8), 0});
            }
        PipeBarrier<PIPE_V>();
        Gelu(z, temporary, output, valid * pitch);
        const bool compact =
            N == cols && col == 0 && N < pitch && N <= 64 && N % 16 != 0 && valid >= 16;
        auto packed = temporary.template ReinterpretCast<half>();
        if (compact)
        {

            const int count = valid * N;
            PipeBarrier<PIPE_V>();
            CreateVecIndex(accum, int32_t(0), count);
            PipeBarrier<PIPE_V>();
            Cast(temporary, accum, RoundMode::CAST_RINT, count);
            PipeBarrier<PIPE_V>();
            Muls(temporary, temporary, 1.0f / N, count);
            PipeBarrier<PIPE_V>();

            Adds(temporary, temporary, 0.0001f, count);
            PipeBarrier<PIPE_V>();
            auto rows = temporary.template ReinterpretCast<int32_t>();
            Cast(rows, temporary, RoundMode::CAST_FLOOR, count);
            PipeBarrier<PIPE_V>();
            Muls(rows, rows, int32_t(2 * (pitch - N)), count);
            Muls(accum, accum, int32_t(2), count);
            PipeBarrier<PIPE_V>();
            Add(accum, accum, rows, count);
            PipeBarrier<PIPE_V>();
            Gather(packed, output, accum.template ReinterpretCast<uint32_t>(), 0, count);
        }
        SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
        WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
        if (compact)
            DataCopyPad(y[int64_t(row + first) * N], packed,
                        DataCopyExtParams(1, valid * N * 2, 0, 0, 0));
        else if (valid == ROWS && cols == pitch && N == pitch)
            DataCopy(y[int64_t(row + first) * N + col], output, valid * pitch);
        else
            DataCopyPad(
                y[int64_t(row + first) * N + col], output,
                DataCopyExtParams(valid, cols * 2, (pitch - Up(cols, 16)) / 16, (N - cols) * 2, 0));
        SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
        SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
        WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
    }
};

using grouped_gelu::Workspace;

constexpr int MT = 64, NT = 256, LK = 544, ST = 3, KR = 64;
constexpr int PREP = 1, ORDER = 0, ROTATE = 1;

__aicore__ inline void PackCube(const GlobalTensor<int8_t> &src, const GlobalTensor<int8_t> &dst,
                                const int *ends, int K, int N, int E, int KP, int NP, int workers)
{
    const int batches = (K + KR - 1) / KR, span = KR * NP, blocks = NP / 32;
    LocalTensor<int8_t> tile(TPosition::A1, 0, 2 * span);
    SetLoadDataPaddingValue<uint64_t>(0);
    SetFlag<HardEvent::MTE3_MTE2>(EVENT_ID4);
    SetFlag<HardEvent::MTE3_MTE2>(EVENT_ID5);
    int sequence = 0;
    for (int task = GetBlockIdx(); task < E * batches; task += workers)
    {
        const int e = task / batches;
        if (ends[e] == (e ? ends[e - 1] : 0))
            continue;
        const int first = task % batches * KR, count = Min(KR, K - first), slot = sequence++ & 1;
        const event_t event = slot ? EVENT_ID5 : EVENT_ID4;
        WaitFlag<HardEvent::MTE3_MTE2>(event);
        Nd2NzParams p;
        p.ndNum = 1;
        p.nValue = count;
        p.dValue = N;
        p.srcDValue = N;
        p.srcNdMatrixStride = 0;
        p.dstNzC0Stride = KR;
        p.dstNzNStride = 1;
        p.dstNzMatrixStride = 0;
        DataCopy(tile[slot * span], src[int64_t(e) * K * N + int64_t(first) * N], p);
        SetFlag<HardEvent::MTE2_MTE3>(event);
        WaitFlag<HardEvent::MTE2_MTE3>(event);
        DataCopy(dst[int64_t(e) * KP * NP + first * 32], tile[slot * span],
                 DataCopyParams(blocks, count, KR - count, KP - count));
        SetFlag<HardEvent::MTE3_MTE2>(event);
    }
    WaitFlag<HardEvent::MTE3_MTE2>(EVENT_ID4);
    WaitFlag<HardEvent::MTE3_MTE2>(EVENT_ID5);
    SetFlag<HardEvent::MTE3_S>(EVENT_ID4);
    WaitFlag<HardEvent::MTE3_S>(EVENT_ID4);
    CrossCoreSetFlag<0, PIPE_MTE3>(9);
    CrossCoreWaitFlag(9);
}

__aicore__ inline void Prefetch(const GlobalTensor<int8_t> &src, const LocalTensor<int64_t> &ends,
                                int K, int N, int E, int workers)
{
    constexpr int CHUNK = 16384, STEP = 512;
    LocalTensor<int8_t> scratch(TPosition::VECCALC, 131072, CHUNK * 2);
    int experts[64], active = 0, previous = 0;
    for (int e = 0; e < E; ++e)
    {
        const int end = int(ends.GetValue(e));
        if (end > previous)
        {
            ++active;
            if (active * 2 >= E)
                break;
            experts[active - 1] = e;
        }
        previous = end;
    }
    if (active * 2 < E)
    {
        const int64_t bytes = int64_t(K) * N;
        const int chunks = int((bytes + CHUNK - 1) / CHUNK);
        int slot = 0;
        for (int task = GetBlockIdx(); task < active * chunks; task += workers * 2)
        {
            const int e = experts[task / chunks];
            const int64_t within = int64_t(task % chunks) * CHUNK;
            const int64_t off = (int64_t(e) * bytes + within) / 512 * 512;
            const int blocks = Min(CHUNK, int(bytes - within)) / STEP;
            if (blocks)
                DataCopy(scratch[slot * CHUNK], src[off],
                         DataCopyParams(blocks, 1, STEP / 32 - 1, 0));
            slot ^= 1;
        }
        return;
    }
    const int64_t total = int64_t(E) * K * N;
    int slot = 0;
    for (int64_t off = int64_t(GetBlockIdx()) * CHUNK; off < total; off += workers * 2 * CHUNK)
    {
        const int span = Min(CHUNK, int(total - off)), blocks = span / STEP;
        if (blocks)
            DataCopy(scratch[slot * CHUNK], src[off], DataCopyParams(blocks, 1, STEP / 32 - 1, 0));
        if (span % STEP >= 32)
            DataCopy(scratch[slot * CHUNK + blocks * 32], src[off + blocks * STEP], 32);
        slot ^= 1;
    }
}

__aicore__ inline void Activate(const GlobalTensor<int32_t> &src, const GlobalTensor<float> &scales,
                                const GlobalTensor<half> &out, int row, int col, int rows, int cols,
                                int N, int e, int slot)
{
    const int width = Up(rows, 16) < 32 ? NT : Up(cols, 32);
    EpilogueSequential<MT, NT, false, NT> epilogue;
    epilogue.Run(src, scales, out, row, col, rows, cols, N, e, width, 1, slot);
}

template <int STATIC_WORKERS = 0>
__global__ __mix__(1, 2)
    __attribute__((aligned(4096))) void Runtime(GM_ADDR x, GM_ADDR weight, GM_ADDR scale,
                                                GM_ADDR groups, GM_ADDR y, GM_ADDR workspace,
                                                GM_ADDR packedB, int M, int K, int N, int E,
                                                int inputWorkers, int KP, int NP)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
    SetAtomicNone();
    const int workers = STATIC_WORKERS ? STATIC_WORKERS : inputWorkers;
    int core = GetBlockIdx();
    if ASCEND_IS_AIV
    {
        core /= GetSubBlockNum();
    }
    GlobalTensor<int8_t> a, b, pb;
    GlobalTensor<int64_t> g;
    GlobalTensor<int32_t> buffer;
    GlobalTensor<float> s;
    GlobalTensor<half> out;
    a.SetGlobalBuffer((__gm__ int8_t *)x);
    b.SetGlobalBuffer((__gm__ int8_t *)weight);
    pb.SetGlobalBuffer((__gm__ int8_t *)packedB);
    g.SetGlobalBuffer((__gm__ int64_t *)groups);
    buffer.SetGlobalBuffer((__gm__ int32_t *)workspace);
    s.SetGlobalBuffer((__gm__ float *)scale);
    out.SetGlobalBuffer((__gm__ half *)y);
    if ASCEND_IS_AIV
    {
        TPipe pipe;
        SetMaskNorm();
        SetVectorMask<uint8_t>(~uint64_t(0), ~uint64_t(0));
        LocalTensor<int64_t> ends(TPosition::VECCALC, 172032, 128);
        DataCopyPad(ends, g, DataCopyExtParams(1, E * 8, 0, 0, 0),
                    DataCopyPadExtParams<int64_t>{false, 0, 0, 0});
        SetFlag<HardEvent::MTE2_S>(EVENT_ID6);
        WaitFlag<HardEvent::MTE2_S>(EVENT_ID6);

        if constexpr (PREP == 1)
        {
            const int pad = KP - K, blocks = NP / 32;
            if (pad)
            {
                LocalTensor<uint16_t> zero(TPosition::VECCALC, 0, blocks * pad * 16);
                Duplicate(zero, uint16_t(0), blocks * pad * 16);
                SetFlag<HardEvent::V_MTE3>(EVENT_ID4);
                WaitFlag<HardEvent::V_MTE3>(EVENT_ID4);
                for (int e = GetBlockIdx(); e < E; e += workers * 2)
                    DataCopy(pb[int64_t(e) * KP * NP + K * 32], zero.ReinterpretCast<int8_t>(),
                             DataCopyParams(blocks, pad, 0, K));
            }
            Prefetch(b, ends, K, N, E, workers);
            SetFlag<HardEvent::MTE2_S>(EVENT_ID4);
            WaitFlag<HardEvent::MTE2_S>(EVENT_ID4);
            CrossCoreSetFlag<0, PIPE_MTE3>(10);
            CrossCoreWaitFlag(10);
            CrossCoreSetFlag<2, PIPE_MTE3>(8);
        }
    }
    if ASCEND_IS_AIC
    {
        int ends[128];
        for (int e = 0; e < E; ++e)
            ends[e] = int(g.GetValue(e));

        if constexpr (PREP == 1)
        {
            PackCube(b, pb, ends, K, N, E, KP, NP, workers);
            CrossCoreWaitFlag(8);
        }
        Cube<MT, NT, false, LK, ST> cube;
        cube.Init();
        const int columns = (N + NT - 1) / NT;
        int previous = 0, base = 0, next = core, sequence = 0, aSequence = 0;
        for (int e = 0; e < E; ++e)
        {
            const int end = ends[e], length = end - previous, tiles = (length + MT - 1) / MT;
            while (next < base + tiles)
            {
                const int ri = next - base, row = previous + ri * MT,
                          rows = Min(MT, length - ri * MT);
                const int aSlot = aSequence++ & 1;
                cube.LoadA(a[int64_t(row) * K], rows, K, aSlot);
                for (int nc = 0; nc < columns; ++nc)
                {
                    const int col = ((nc + core) % columns) * NT, cols = Min(NT, N - col),
                              slot = sequence++ & 1;
                    cube.Compute(pb[int64_t(e) * KP * NP + int64_t(col / 32) * KP * 32],
                                 buffer[int64_t(core * 2 + slot) * MT * NT], rows, cols, K, KP,
                                 slot, aSlot, nc + 1 == columns);
                }
                next += workers;
            }
            previous = end;
            base += tiles;
        }
        cube.Finish();
    }
    if ASCEND_IS_AIV
    {
        TPipe pipe;
        SetMaskNorm();
        SetVectorMask<uint8_t>(~uint64_t(0), ~uint64_t(0));
        LocalTensor<int64_t> ends(TPosition::VECCALC, 172032, 128);
        SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
        CrossCoreSetFlag<2, PIPE_MTE2>(2);
        CrossCoreSetFlag<2, PIPE_MTE2>(3);
        const int columns = (N + NT - 1) / NT;
        int previous = 0, base = 0, next = core, sequence = 0;
        for (int e = 0; e < E; ++e)
        {
            const int end = int(ends.GetValue(e)), length = end - previous,
                      tiles = (length + MT - 1) / MT;
            while (next < base + tiles)
            {
                const int ri = next - base, row = previous + ri * MT,
                          rows = Min(MT, length - ri * MT);
                for (int nc = 0; nc < columns; ++nc)
                {
                    const int col = ((nc + core) % columns) * NT, cols = Min(NT, N - col),
                              slot = sequence++ & 1;
                    CrossCoreWaitFlag(slot);
                    Activate(buffer[int64_t(core * 2 + slot) * MT * NT], s, out, row, col, rows,
                             cols, N, e, slot);
                }
                next += workers;
            }
            previous = end;
            base += tiles;
        }
        WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
    }
}

inline void Launch(GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR g, GM_ADDR y, int M, int K, int N,
                   int E, int workers, aclrtStream stream)
{
    const int KP = (K + 31) / 32 * 32, NP = (N + 31) / 32 * 32;
    const size_t outputBytes = size_t(workers) * 2 * MT * NT * 4;
    const size_t bBytes = PREP == 2 ? 0 : size_t(E) * KP * NP;
    Workspace memory(outputBytes + bBytes, stream);
    if (!memory.Data())
        return;
    if (workers == 20)
        Runtime<20><<<workers, nullptr, stream>>>(
            x, w, s, g, y, memory.Data(), memory.Data() + outputBytes, M, K, N, E, workers, KP, NP);
    else
        Runtime<0><<<workers, nullptr, stream>>>(
            x, w, s, g, y, memory.Data(), memory.Data() + outputBytes, M, K, N, E, workers, KP, NP);
    memory.Complete();
}

}

namespace scheduled
{
using namespace AscendC;
using grouped_gelu::Min;
using grouped_gelu::Up;
using grouped_gelu::Gelu;
using grouped_gelu::Workspace;
template <int MT, int NT, bool SPLIT, int LK = 256, int NSTAGES = 3, bool NZ = true,
          bool WIDE = true>
class Cube
{

    static constexpr int FK = (NT > 512 || MT > 512) ? 32 : ((NT > 256 || MT >= 256) ? 64 : 128);
    static constexpr int STAGES = NSTAGES;
    static constexpr int PANEL = (MT + NT) * LK;
    static constexpr int CSLOTS = MT * NT * 4 <= 65536 ? 2 : 1;
    static_assert(STAGES * PANEL <= 524288, "L1 capacity exceeded");
    static_assert(2 * MT * FK <= 65536 && 2 * NT * FK <= 65536, "L0A/B capacity exceeded");
    static_assert(CSLOTS * MT * NT * 4 <= 131072, "L0C capacity exceeded");
    LocalTensor<int8_t> l1{TPosition::A1, 0, STAGES * PANEL};
    LocalTensor<int8_t> a0{TPosition::A2, 0, 2 * MT * FK};
    LocalTensor<int8_t> b0{TPosition::B2, 0, 2 * NT * FK};
    LocalTensor<int32_t> c0{TPosition::CO1, 0, CSLOTS * MT * NT};
    int fragmentSlot = 0;
    int cachedPanels = 0, cachedStart = 0;
    struct Pending
    {
        int slot, count, rows, cols, outputSlot;
        GM_ADDR output;
        bool first, last;
    };
    Pending pending[2];
    int head = 0, pendingCount = 0, producer = 0;

    __aicore__ inline void CopyNd(const LocalTensor<int8_t> &dst, const GlobalTensor<int8_t> &src,
                                  int rows, int cols, int stride, int paddedRows)
    {
        Nd2NzParams p;
        p.ndNum = 1;
        p.nValue = rows;
        p.dValue = cols;
        p.srcNdMatrixStride = 0;
        p.srcDValue = stride;
        p.dstNzC0Stride = paddedRows;
        p.dstNzNStride = 1;
        p.dstNzMatrixStride = 0;
        if constexpr (MT == 64 && NT == 512)
        {
            if (rows > 16 && rows % 16 == 0 && 16 * stride <= 65535)
            {
                p.ndNum = rows / 16;
                p.nValue = 16;
                p.srcNdMatrixStride = 16 * stride;
                p.dstNzMatrixStride = 16 * 32;
            }
        }
        if (WIDE && stride % 4 == 0)
        {
            GlobalTensor<float> wide;
            wide.SetGlobalBuffer((__gm__ float *)src.GetPhyAddr());
            p.dValue = (cols + 3) / 4;
            p.srcDValue = stride / 4;
            p.srcNdMatrixStride /= 4;
            DataCopy(dst.template ReinterpretCast<float>(), wide, p);
        }
        else
            DataCopy(dst, src, p);
    }

    __aicore__ inline void Consume(const Pending &p)
    {
        const int cslot = p.outputSlot % CSLOTS;
        if (p.first)
            WaitFlag<HardEvent::FIX_M>(cslot);
        auto c = c0[cslot * MT * NT];
        WaitFlag<HardEvent::MTE2_MTE1>(p.slot);

        const int actualM = MT >= 256 ? MT : Up(p.rows, 16);
        const int activeN = actualM < 32 ? NT : Up(p.cols, 32);
        for (int f = 0; f < p.count; f += FK)
        {
            const int fk = Up(Min(FK, p.count - f), 32);
            const int fs = fragmentSlot;
            WaitFlag<HardEvent::M_MTE1>(fs);
            auto aa = a0[fs * MT * FK];
            auto bb = b0[fs * NT * FK];
            auto la = l1[p.slot * PANEL + f * MT];
            auto lb = l1[p.slot * PANEL + MT * LK + f * 32];
            LoadData2DParams pa;
            pa.startIndex = 0;
            pa.repeatTimes = fk / 32;
            pa.srcStride = MT / 16;
            pa.dstGap = 0;
            pa.ifTranspose = false;
            pa.sid = 0;
            pa.addrMode = 0;
            for (int mi = 0; mi < (p.rows + 15) / 16; ++mi)
                LoadData(aa[mi * fk * 16], la[mi * 512], pa);
            LoadData2dTransposeParams pb;
            pb.startIndex = 0;
            pb.repeatTimes = (p.cols + 31) / 32;
            pb.srcStride = LK / 32;
            pb.dstGap = 1;
            pb.dstFracGap = 0;
            for (int ki = 0; ki < fk / 32; ++ki)
                LoadDataWithTranspose(bb[ki * activeN * 32], lb[ki * 1024], pb);
            SetFlag<HardEvent::MTE1_M>(fs);
            WaitFlag<HardEvent::MTE1_M>(fs);
            MmadParams mm;
            mm.m = actualM;
            mm.n = activeN;
            mm.k = fk;
            mm.cmatrixInitVal = p.first && f == 0;
            mm.unitFlag = p.last && f + FK >= p.count ? 3 : 2;
            Mmad(c, aa, bb, mm);
            if (actualM * activeN < 2560)
                PipeBarrier<PIPE_M>();
            SetFlag<HardEvent::M_MTE1>(fs);
            fragmentSlot ^= 1;
        }
        SetFlag<HardEvent::MTE1_MTE2>(p.slot);
        if (p.last)
        {
            GlobalTensor<int32_t> dst;
            dst.SetGlobalBuffer((__gm__ int32_t *)p.output);
            if constexpr (!SPLIT)
                CrossCoreWaitFlag(2 + p.outputSlot);
            FixpipeParamsV220 fp;

            fp.nSize = activeN;
            fp.mSize = MT >= 256 ? actualM : p.rows;
            fp.srcStride = actualM;
            fp.dstStride = activeN;
            fp.quantPre = QuantMode_t::NoQuant;
            fp.reluEn = false;
            fp.unitFlag = 3;
            Fixpipe<int32_t, int32_t, CFG_ROW_MAJOR>(dst, c, fp);
            SetFlag<HardEvent::FIX_M>(cslot);
            if constexpr (!SPLIT)
                CrossCoreSetFlag<2, PIPE_FIX>(p.outputSlot);
        }
    }

  public:
    __aicore__ inline void Init()
    {
        fragmentSlot = 0;
        head = 0;
        pendingCount = 0;
        producer = 0;
        SetLoadDataPaddingValue<uint64_t>(0);
        SetFixpipeNz2ndFlag(1, 0, 0);
        for (int i = 0; i < STAGES; ++i)
            SetFlag<HardEvent::MTE1_MTE2>(i);
        for (int i = 0; i < 2; ++i)
        {
            SetFlag<HardEvent::M_MTE1>(i);
        }
        for (int i = 0; i < CSLOTS; ++i)
            SetFlag<HardEvent::FIX_M>(i);
    }

    __aicore__ inline void Compute(const GlobalTensor<int8_t> &a, const GlobalTensor<int8_t> &b,
                                   const GlobalTensor<int32_t> &dst, int rows, int cols, int K,
                                   int N, int start, int depth, int outputSlot, int bKPad = 0)
    {
        const int panels = (depth + LK - 1) / LK;
        int ki = 0;
        if constexpr (MT >= 64 && NT >= 128)
        {
            if (cachedPanels != panels)
            {
                cachedPanels = panels;
                cachedStart = panels > 1 ? GetBlockIdx() % panels : 0;
            }
            ki = cachedStart;
        }
#pragma unroll(1)
        for (int p = 0; p < panels; ++p)
        {
            const int slot = producer;
            const int count = Min(LK, depth - ki * LK);
            WaitFlag<HardEvent::MTE1_MTE2>(slot);
            CopyNd(l1[slot * PANEL], a[start + ki * LK], rows, count, K, MT);
            if constexpr (NZ)
                DataCopy(l1[slot * PANEL + MT * LK], b[int64_t(start + ki * LK) * 32],
                         DataCopyParams((cols + 31) / 32, Up(count, 32), bKPad - Up(count, 32),
                                        LK - Up(count, 32)));
            else
                CopyNd(l1[slot * PANEL + MT * LK], b[int64_t(start + ki * LK) * N], count, cols, N,
                       LK);
            SetFlag<HardEvent::MTE2_MTE1>(slot);

            if (pendingCount == (STAGES < 3 ? 1 : 2))
            {
                Consume(pending[head]);
                pending[head] = {slot,   count,          rows,
                                 cols,   outputSlot,     (GM_ADDR)dst.GetPhyAddr(),
                                 p == 0, p + 1 == panels};
                if constexpr (STAGES >= 3)
                    head ^= 1;
            }
            else
            {
                pending[(head + pendingCount) & 1] = {
                    slot,   count,          rows, cols, outputSlot, (GM_ADDR)dst.GetPhyAddr(),
                    p == 0, p + 1 == panels};
                ++pendingCount;
            }
            producer = producer + 1 < STAGES ? producer + 1 : 0;
            if (++ki == panels)
                ki = 0;
        }
    }

    __aicore__ inline void Flush()
    {
        while (pendingCount)
        {
            Consume(pending[head]);
            if constexpr (STAGES >= 3)
                head ^= 1;
            --pendingCount;
        }
    }

    __aicore__ inline void Finish()
    {
        while (pendingCount)
        {
            Consume(pending[head]);
            if constexpr (STAGES >= 3)
                head ^= 1;
            --pendingCount;
        }
        for (int i = 0; i < STAGES; ++i)
            WaitFlag<HardEvent::MTE1_MTE2>(i);
        for (int i = 0; i < 2; ++i)
        {
            WaitFlag<HardEvent::M_MTE1>(i);
        }
        for (int i = 0; i < CSLOTS; ++i)
            WaitFlag<HardEvent::FIX_M>(i);
    }
};

template <int MT, int NT, bool KEEP_LAYOUT = false> class EpilogueSequential
{
    static constexpr int ROWS = (MT + 1) / 2;
    static constexpr int SIZE = ROWS * NT;
    static constexpr int UB_SHIFT = KEEP_LAYOUT ? 0 : 256;
    static_assert(SIZE * 10 + NT * 4 + UB_SHIFT <= 196608, "UB capacity exceeded");
    LocalTensor<int32_t> accum{TPosition::VECCALC, 0, SIZE};
    LocalTensor<float> temporary{TPosition::VECCALC, SIZE * 4 + UB_SHIFT, SIZE};
    LocalTensor<half> output{TPosition::VECCALC, SIZE * 8 + UB_SHIFT, SIZE};
    LocalTensor<float> scales{TPosition::VECCALC, SIZE * 10 + UB_SHIFT, NT};

  public:
    __aicore__ inline void Run(const GlobalTensor<int32_t> &src, const GlobalTensor<float> &scale,
                               const GlobalTensor<half> &y, int row, int col, int rows, int cols,
                               int N, int expert, int shards = 1, int slot = 0,
                               int partialStride = MT * NT)
    {
        const int first = GetSubBlockIdx() * ((rows + 1) / 2);
        const int valid = GetSubBlockIdx() ? rows / 2 : (rows + 1) / 2;
        if (valid <= 0)
        {
            if (shards == 1)
                CrossCoreSetFlag<2, PIPE_MTE2>(2 + slot);
            return;
        }
        DataCopy(accum, src[first * NT], valid * NT);
        if (cols == NT && (N == NT || cols % 16 == 0))
            DataCopy(scales, scale[expert * N + col], cols);
        else
            DataCopyPad(scales, scale[expert * N + col], DataCopyExtParams(1, cols * 4, 0, 0, 0),
                        DataCopyPadExtParams<float>{false, 0, 0, 0.0f});
        SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
        WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
        for (int s = 1; s < shards; ++s)
        {
            auto part = temporary.template ReinterpretCast<int32_t>();
            DataCopy(part, src[s * partialStride + first * NT], valid * NT);
            SetFlag<HardEvent::MTE2_V>(EVENT_ID1);
            WaitFlag<HardEvent::MTE2_V>(EVENT_ID1);
            Add(accum, accum, part, valid * NT);
            SetFlag<HardEvent::V_MTE2>(EVENT_ID1);
            WaitFlag<HardEvent::V_MTE2>(EVENT_ID1);
        }
        if (shards == 1)
            CrossCoreSetFlag<2, PIPE_MTE2>(2 + slot);
        auto z = accum.template ReinterpretCast<float>();
        Cast(z, accum, RoundMode::CAST_RINT, valid * NT);
        PipeBarrier<PIPE_V>();

        for (int r = 0; r < valid; r += 128)
            for (int c = 0; c < NT; c += 64)
            {
                const int width = Min(64, NT - c);
                Mul(z[r * NT + c], z[r * NT + c], scales[c], width, Min(128, valid - r),
                    {1, 1, 1, uint8_t(NT / 8), uint8_t(NT / 8), 0});
            }
        PipeBarrier<PIPE_V>();
        Gelu(z, temporary, output, valid * NT);
        const bool compact =
            N == cols && col == 0 && N < NT && N <= 64 && N % 16 != 0 && valid >= 16;
        auto packed = temporary.template ReinterpretCast<half>();
        if (compact)
        {

            const int count = valid * N;
            PipeBarrier<PIPE_V>();
            CreateVecIndex(accum, int32_t(0), count);
            PipeBarrier<PIPE_V>();
            Cast(temporary, accum, RoundMode::CAST_RINT, count);
            PipeBarrier<PIPE_V>();
            Muls(temporary, temporary, 1.0f / N, count);
            PipeBarrier<PIPE_V>();

            Adds(temporary, temporary, 0.0001f, count);
            PipeBarrier<PIPE_V>();
            auto rows = temporary.template ReinterpretCast<int32_t>();
            Cast(rows, temporary, RoundMode::CAST_FLOOR, count);
            PipeBarrier<PIPE_V>();
            Muls(rows, rows, int32_t(2 * (NT - N)), count);
            Muls(accum, accum, int32_t(2), count);
            PipeBarrier<PIPE_V>();
            Add(accum, accum, rows, count);
            PipeBarrier<PIPE_V>();
            Gather(packed, output, accum.template ReinterpretCast<uint32_t>(), 0, count);
        }
        SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
        WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
        if (compact)
            DataCopyPad(y[int64_t(row + first) * N], packed,
                        DataCopyExtParams(1, valid * N * 2, 0, 0, 0));
        else if (valid == ROWS && cols == NT && N == NT)
            DataCopy(y[int64_t(row + first) * N + col], output, valid * NT);
        else
            DataCopyPad(
                y[int64_t(row + first) * N + col], output,
                DataCopyExtParams(valid, cols * 2, (NT - Up(cols, 16)) / 16, (N - cols) * 2, 0));
        SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
        WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
        SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
        WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
    }
};

__aicore__ inline void PackRows(const GlobalTensor<int8_t> &src, const GlobalTensor<int8_t> &dst,
                                int rows, int cols, int pitch, int workers, int worker)
{
    if (cols == pitch)
        return;
    constexpr int SPAN = 32768;
    LocalTensor<uint8_t> scratch(TPosition::VECCALC, 0, SPAN * 2);
    auto ub = scratch.ReinterpretCast<int8_t>();
    auto zero = scratch.ReinterpretCast<uint16_t>();
    Duplicate(zero, uint16_t(0), SPAN);
    SetFlag<HardEvent::V_MTE2>(EVENT_ID4);
    WaitFlag<HardEvent::V_MTE2>(EVENT_ID4);
    const int rowsPerTile = SPAN / pitch;
    const int tiles = (rows + rowsPerTile - 1) / rowsPerTile;
    SetFlag<HardEvent::MTE3_MTE2>(EVENT_ID4);
    SetFlag<HardEvent::MTE3_MTE2>(EVENT_ID5);
    int sequence = 0;
    for (int tile = worker; tile < tiles; tile += workers)
    {
        const int slot = sequence++ & 1;
        const event_t event = slot ? EVENT_ID5 : EVENT_ID4;
        const int row = tile * rowsPerTile;
        const int count = Min(rowsPerTile, rows - row);
        WaitFlag<HardEvent::MTE3_MTE2>(event);
        DataCopyPad(ub[slot * SPAN], src[int64_t(row) * cols],
                    DataCopyExtParams(count, cols, 0, (pitch - Up(cols, 32)) / 32, 0),
                    DataCopyPadExtParams<int8_t>{true, 0, uint8_t(Up(cols, 32) - cols), 0});
        SetFlag<HardEvent::MTE2_MTE3>(event);
        WaitFlag<HardEvent::MTE2_MTE3>(event);
        DataCopy(dst[int64_t(row) * pitch], ub[slot * SPAN], count * pitch);
        SetFlag<HardEvent::MTE3_MTE2>(event);
    }
    WaitFlag<HardEvent::MTE3_MTE2>(EVENT_ID4);
    WaitFlag<HardEvent::MTE3_MTE2>(EVENT_ID5);
    SetFlag<HardEvent::MTE3_V>(EVENT_ID4);
    WaitFlag<HardEvent::MTE3_V>(EVENT_ID4);
}

constexpr int TASK_LIMIT = 512;
constexpr int TABLE_HEAD = 32;
constexpr int OUTPUT_BASE = TABLE_HEAD + TASK_LIMIT;
constexpr int END_LINK = 1023;

__aicore__ inline uint64_t Encode(int expert, int row, int column, int rows, int job, int shard)
{
    return uint64_t(row) | (uint64_t(column) << 16) | (uint64_t(rows) << 21) |
           (uint64_t(expert) << 29) | (uint64_t(job) << 36) | (uint64_t(shard) << 45) |
           (uint64_t(END_LINK) << 48);
}

__aicore__ inline void Decode(uint64_t value, int &expert, int &row, int &column, int &rows,
                              int &job, int &shard)
{
    row = value & 65535;
    column = (value >> 16) & 31;
    rows = (value >> 21) & 255;
    expert = (value >> 29) & 127;
    job = (value >> 36) & 511;
    shard = (value >> 45) & 7;
}

template <int MT, int NT, int LK, int SHARDS, bool BOUNDED>
__aicore__ inline void BuildSchedule(const LocalTensor<int64_t> &ends,
                                     const GlobalTensor<uint64_t> &destination, int K, int N, int E,
                                     int workers, int depth)
{
    LocalTensor<uint64_t> table(TPosition::VECCALC, 135168, OUTPUT_BASE + TASK_LIMIT);
    uint64_t quota[(2 * (MT / 16) + 2) * 20];
    Duplicate(table.template ReinterpretCast<uint32_t>(), uint32_t(0),
              2 * (OUTPUT_BASE + TASK_LIMIT));
    SetFlag<HardEvent::V_S>(EVENT_ID6);
    WaitFlag<HardEvent::V_S>(EVENT_ID6);
    int groupStart[128], lengths[128], prefix[129], rowCounts[MT + 1] = {};
    const int columns = (N + NT - 1) / NT, fullColumns = N / NT, tailColumns = N % NT,
              kp = Up(depth, 32);
    int previous = 0;
    prefix[0] = 0;
    for (int e = 0; e < E; ++e)
    {
        const int end = int(ends.GetValue(e)), length = end - previous;
        groupStart[e] = previous;
        lengths[e] = length;
        rowCounts[MT] += length / MT;
        if (length % MT)
            ++rowCounts[Up(length % MT, 16)];
        prefix[e + 1] = prefix[e] + (length + MT - 1) / MT * columns;
        previous = end;
    }
    if constexpr (BOUNDED)
        workers = Min(workers, prefix[E] * SHARDS);
    int categoryRows[2 * MT + 2], categoryTail[2 * MT + 2], costs[2 * MT + 2], amounts[2 * MT + 2];
    int categories = 0;
    for (int r = 16; r <= MT; r += 16)
    {
        if (!rowCounts[r])
            continue;
        for (int tail = 0; tail < 2; ++tail)
        {
            if ((tail && !tailColumns) || (!tail && !fullColumns))
                continue;
            const int cols = tail ? tailColumns : NT, mp = Up(r, 16),
                      np = mp < 32 ? NT : Up(cols, 32);
            const int cube = 2 * mp * np, mte1 = mp * 64 + np * 161, mte2 = (r + cols) * 152,
                      vector = r * np * 2395 / kp;
            int value = cube > mte1 ? cube : mte1;
            value = value > mte2 ? value : mte2;
            value = value > vector ? value : vector;
            value += (((depth + LK - 1) / LK) * 4852314 + 9435055) / kp;
            const int amount = rowCounts[r] * (tail ? 1 : fullColumns) * SHARDS;
            int index = categories++;
            while (index > 0 && costs[index - 1] < value)
            {
                costs[index] = costs[index - 1];
                categoryRows[index] = categoryRows[index - 1];
                categoryTail[index] = categoryTail[index - 1];
                amounts[index] = amounts[index - 1];
                --index;
            }
            costs[index] = value;
            categoryRows[index] = r;
            categoryTail[index] = tail;
            amounts[index] = amount;
        }
    }
    int loads[20] = {}, totals[20] = {};
    for (int category = 0; category < categories; ++category)
    {
        const int count = amounts[category], cost = costs[category], work = count * cost;
        int sum = work;
        for (int i = 0; i < workers; ++i)
            sum += loads[i];
        int level = sum / workers;
        for (int iteration = 0; iteration < workers; ++iteration)
        {
            int active = 0, subtotal = work;
            for (int i = 0; i < workers; ++i)
                if (loads[i] <= level)
                {
                    ++active;
                    subtotal += loads[i];
                }
            const int next = subtotal / active;
            if (next == level)
                break;
            level = next;
        }
        int counts[20], remaining = count;
        for (int i = 0; i < workers; ++i)
        {
            counts[i] = loads[i] < level ? (level - loads[i]) / cost : 0;
            remaining -= counts[i];
            loads[i] += counts[i] * cost;
        }
        for (int j = 0; j < remaining; ++j)
        {
            int owner = 0;
            for (int i = 1; i < workers; ++i)
                if (loads[i] < loads[owner])
                    owner = i;
            ++counts[owner];
            loads[owner] += cost;
        }
        for (int i = 0; i < workers; ++i)
        {
            quota[category * workers + i] = uint64_t(counts[i]);
            totals[i] += counts[i];
        }
    }
    int cursor[20], base = 0;
    for (int i = 0; i < workers; ++i)
    {
        cursor[i] = base;
        table.SetValue(i, uint64_t(base) | (uint64_t(totals[i]) << 32));
        base += totals[i];
    }
    for (int category = 0; category < categories; ++category)
    {
        for (int i = 0; i < workers; ++i)
        {
            const int count = int(quota[category * workers + i]);
            quota[category * workers + i] = uint64_t(count) | (uint64_t(cursor[i]) << 32);
            cursor[i] += count;
        }
    }
    int written = 0;
    for (int category = 0; category < categories; ++category)
    {
        const int r = categoryRows[category], tail = categoryTail[category];
        int owner = 0;
        uint64_t current = quota[category * workers];
        int remaining = uint32_t(current), position = int(current >> 32);
        for (int e = 0; e < E; ++e)
        {
            const int length = lengths[e], fullRows = length / MT, tailRows = length % MT;
            const int first = r == MT ? 0 : fullRows;
            const int stop = fullRows + int(tailRows && Up(tailRows, 16) == r);
            for (int ri = first; ri < stop; ++ri)
            {
                const int beginColumn = tail ? fullColumns : 0,
                          endColumn = tail ? fullColumns + 1 : fullColumns;
                for (int column = beginColumn; column < endColumn; ++column)
                {
                    const int job = prefix[e] + ri * columns + column;
                    for (int shard = 0; shard < SHARDS; ++shard)
                    {
                        while (!remaining)
                        {
                            current = quota[category * workers + (++owner)];
                            remaining = uint32_t(current);
                            position = int(current >> 32);
                        }
                        const uint64_t value = Encode(e, groupStart[e] + ri * MT, column,
                                                      Min(MT, length - ri * MT), job, shard);
                        table.SetValue(TABLE_HEAD + position++, value);
                        --remaining;
                        ++written;
                        if constexpr (SHARDS > 1)
                            if (shard == 0)
                                table.SetValue(OUTPUT_BASE + job, value);
                    }
                }
            }
        }
    }
    table.SetValue(20, uint64_t(prefix[E]));
    table.SetValue(21, uint64_t(written));
    const int words = SHARDS > 1 ? OUTPUT_BASE + prefix[E] : TABLE_HEAD + written;
    SetFlag<HardEvent::S_MTE3>(EVENT_ID6);
    WaitFlag<HardEvent::S_MTE3>(EVENT_ID6);
    DataCopyPad(destination, table, DataCopyExtParams(1, Up(words * 8, 32), 0, 0, 0));
    SetFlag<HardEvent::MTE3_S>(EVENT_ID6);
    WaitFlag<HardEvent::MTE3_S>(EVENT_ID6);
}

template <int MT, int NT, int PITCH>
__aicore__ inline void ActivateWithPitch(const GlobalTensor<int32_t> &src,
                                         const GlobalTensor<float> &scale,
                                         const GlobalTensor<half> &y, int row, int col, int rows,
                                         int cols, int N, int expert, int shards, int slot)
{
    EpilogueSequential<MT, PITCH> epilogue;
    epilogue.Run(src, scale, y, row, col, rows, cols, N, expert, shards, slot, MT * NT);
}

template <int MT, int NT>
__aicore__ inline void Activate(const GlobalTensor<int32_t> &src, const GlobalTensor<float> &scale,
                                const GlobalTensor<half> &y, int row, int col, int rows, int cols,
                                int N, int expert, int shards, int slot)
{
    const int width = Up(rows, 16) < 32 ? NT : Up(cols, 32);
    if (width == 128)
        ActivateWithPitch<MT, NT, 128>(src, scale, y, row, col, rows, cols, N, expert, shards,
                                       slot);
    else if (width == 32)
        ActivateWithPitch<MT, NT, 32>(src, scale, y, row, col, rows, cols, N, expert, shards, slot);
    else if (width == 64)
        ActivateWithPitch<MT, NT, 64>(src, scale, y, row, col, rows, cols, N, expert, shards, slot);
    else if (width == 96)
        ActivateWithPitch<MT, NT, 96>(src, scale, y, row, col, rows, cols, N, expert, shards, slot);
}

constexpr int KR = 256;
__aicore__ inline void ZeroWeightTail(const GlobalTensor<int8_t> &packed, int K, int E, int KP,
                                      int NP, int workers)
{
    const int pad = KP - K;
    if (!pad)
        return;
    const int blocks = NP / 32, count = blocks * pad * 32;
    LocalTensor<uint16_t> zero(TPosition::VECCALC, 0, count / 2);
    Duplicate(zero, uint16_t(0), count / 2);
    SetFlag<HardEvent::V_MTE3>(EVENT_ID4);
    WaitFlag<HardEvent::V_MTE3>(EVENT_ID4);
    for (int e = GetBlockIdx(); e < E; e += workers * 2)
        DataCopy(packed[int64_t(e) * KP * NP + K * 32], zero.ReinterpretCast<int8_t>(),
                 DataCopyParams(blocks, pad, 0, K));
    SetFlag<HardEvent::MTE3_S>(EVENT_ID4);
    WaitFlag<HardEvent::MTE3_S>(EVENT_ID4);
}

__aicore__ inline void ZeroWeightTailDedicated(const GlobalTensor<int8_t> &packed, int K, int E,
                                               int KP, int NP, int lanes, int worker)
{
    const int pad = KP - K;
    if (!pad)
        return;
    const int blocks = NP / 32, count = blocks * pad * 32;
    LocalTensor<uint16_t> zero(TPosition::VECCALC, 0, count / 2);
    Duplicate(zero, uint16_t(0), count / 2);
    SetFlag<HardEvent::V_MTE3>(EVENT_ID4);
    WaitFlag<HardEvent::V_MTE3>(EVENT_ID4);
    for (int e = worker; e < E; e += lanes)
        DataCopy(packed[int64_t(e) * KP * NP + K * 32], zero.ReinterpretCast<int8_t>(),
                 DataCopyParams(blocks, pad, 0, K));
    SetFlag<HardEvent::MTE3_S>(EVENT_ID4);
    WaitFlag<HardEvent::MTE3_S>(EVENT_ID4);
}

__aicore__ inline void IssuePrefetchOriginal(const GlobalTensor<int8_t> &b, int K, int N, int E,
                                             int workers)
{
    constexpr int CHUNK = 16384, STEP = 32;
    const int64_t total = int64_t(E) * K * N;
    LocalTensor<int8_t> scratch(TPosition::VECCALC, 98304, 2 * CHUNK);
    int slot = 0;
    for (int64_t off = int64_t(GetBlockIdx()) * CHUNK; off < total; off += workers * 2 * CHUNK)
    {
        const int span = Min(CHUNK, int(total - off)), blocks = span / STEP;
        if (blocks)
            DataCopy(scratch[slot * CHUNK], b[off], DataCopyParams(blocks, 1, STEP / 32 - 1, 0));
        if (span % STEP >= 32)
            DataCopy(scratch[slot * CHUNK + blocks * 32], b[off + blocks * STEP], 32);
        slot ^= 1;
    }
}

__aicore__ inline void CubePackBOriginal(const GlobalTensor<int8_t> &src,
                                         const GlobalTensor<int8_t> &dst, int K, int N, int E,
                                         int KP, int NP, int workers)
{
    const int span = KR * NP, batches = (K + KR - 1) / KR, blocks = NP / 32;
    LocalTensor<int8_t> tile(TPosition::A1, 0, 2 * span);
    SetLoadDataPaddingValue<uint64_t>(0);
    SetFlag<HardEvent::MTE3_MTE2>(EVENT_ID4);
    SetFlag<HardEvent::MTE3_MTE2>(EVENT_ID5);
    int sequence = 0;
#pragma unroll(1)
    for (int task = GetBlockIdx(); task < E * batches; task += workers)
    {
        const int e = task / batches, first = task % batches * KR, count = Min(KR, K - first),
                  slot = sequence++ & 1;
        const event_t event = slot ? EVENT_ID5 : EVENT_ID4;
        WaitFlag<HardEvent::MTE3_MTE2>(event);
        Nd2NzParams p;
        p.ndNum = 1;
        p.nValue = count;
        p.dValue = N;
        p.srcDValue = N;
        p.srcNdMatrixStride = 0;
        p.dstNzC0Stride = KR;
        p.dstNzNStride = 1;
        p.dstNzMatrixStride = 0;
        DataCopy(tile[slot * span], src[int64_t(e) * K * N + int64_t(first) * N], p);
        SetFlag<HardEvent::MTE2_MTE3>(event);
        WaitFlag<HardEvent::MTE2_MTE3>(event);
        DataCopy(dst[int64_t(e) * KP * NP + first * 32], tile[slot * span],
                 DataCopyParams(blocks, count, KR - count, KP - count));
        SetFlag<HardEvent::MTE3_MTE2>(event);
    }
    WaitFlag<HardEvent::MTE3_MTE2>(EVENT_ID4);
    WaitFlag<HardEvent::MTE3_MTE2>(EVENT_ID5);
    SetFlag<HardEvent::MTE3_S>(EVENT_ID4);
    WaitFlag<HardEvent::MTE3_S>(EVENT_ID4);
    CrossCoreSetFlag<0, PIPE_MTE3>(9);
    CrossCoreWaitFlag(9);
}

__aicore__ inline void IssuePrefetch(const GlobalTensor<int8_t> &b,
                                     const LocalTensor<int64_t> &ends,
                                     const GlobalTensor<int64_t> &groups, int K, int N, int E,
                                     int workers)
{
    constexpr int CHUNK = 16384;
    if (GetBlockIdx() == 0)
        return;
    if (E > 8)
    {
        DataCopyPad(ends, groups, DataCopyExtParams(1, E * 8, 0, 0, 0),
                    DataCopyPadExtParams<int64_t>{false, 0, 0, 0});
        SetFlag<HardEvent::MTE2_S>(EVENT_ID5);
        WaitFlag<HardEvent::MTE2_S>(EVENT_ID5);
    }
    int experts[128], active = 0, previous = 0;
    for (int e = 0; e < E; ++e)
    {
        const int finish = E <= 8 ? int(groups.GetValue(e)) : int(ends.GetValue(e));
        if (finish > previous)
            experts[active++] = e;
        previous = finish;
    }
    const int64_t expertBytes = int64_t(K) * N, total = int64_t(active) * expertBytes;
    LocalTensor<int8_t> scratch(TPosition::VECCALC, 98304, 2 * CHUNK);
    int slot = 0;
    if (active == E)
    {
        const int64_t bytes = int64_t(E) * K * N;
        for (int64_t off = int64_t(GetBlockIdx() - 1) * CHUNK; off < bytes;
             off += int64_t(workers * 2 - 1) * CHUNK)
        {
            const int count = Min(CHUNK, int(bytes - off));
            if (count >= 32)
                DataCopy(scratch[slot * CHUNK], b[off], DataCopyParams(count / 32, 1, 0, 0));
            slot ^= 1;
        }
        return;
    }
    for (int64_t off = int64_t(GetBlockIdx() - 1) * CHUNK; off < total;
         off += int64_t(workers * 2 - 1) * CHUNK)
    {
        int left = Min(CHUNK, int(total - off));
        int64_t position = off;
        while (left > 0)
        {
            const int e = experts[position / expertBytes];
            const int64_t within = position % expertBytes,
                          source = int64_t(e) * expertBytes + within;
            const int span = Min(left, int(expertBytes - within));
            if (source % 32 == 0 && span % 32 == 0)
                DataCopy(scratch[slot * CHUNK], b[source], DataCopyParams(span / 32, 1, 0, 0));
            else
                DataCopyPad(scratch[slot * CHUNK], b[source], DataCopyExtParams(1, span, 0, 0, 0),
                            DataCopyPadExtParams<int8_t>{false, 0, 0, 0});
            slot ^= 1;
            position += span;
            left -= span;
        }
    }
}

__aicore__ inline void CubePackB(const GlobalTensor<int8_t> &src, const GlobalTensor<int8_t> &dst,
                                 const GlobalTensor<int64_t> &groups, int K, int N, int E, int KP,
                                 int NP, int workers)
{
    const int kr = Min(384, (262016 / NP / 32) * 32), span = kr * NP, blocks = NP / 32;
    int experts[128], active = 0, previous = 0;
    for (int e = 0; e < E; ++e)
    {
        const int finish = int(groups.GetValue(e));
        if (finish > previous)
            experts[active++] = e;
        previous = finish;
    }
    const int totalRows = active * KP, share = Up((totalRows + workers - 1) / workers, 32);
    const int begin = GetBlockIdx() * share, end = Min(totalRows, begin + share);
    LocalTensor<int8_t> tile(TPosition::A1, 0, 2 * span);
    SetLoadDataPaddingValue<uint64_t>(0);
    SetFlag<HardEvent::MTE3_MTE2>(EVENT_ID4);
    SetFlag<HardEvent::MTE3_MTE2>(EVENT_ID5);
    int sequence = 0;
#pragma unroll(1)
    for (int linear = begin; linear < end;)
    {
        const int e = experts[linear / KP], first = linear % KP,
                  spanRows = Min(kr, Min(KP - first, end - linear));
        linear += spanRows;
        const int count = Min(spanRows, K - first);
        if (count <= 0)
            continue;
        const int slot = sequence++ & 1;
        const event_t event = slot ? EVENT_ID5 : EVENT_ID4;
        WaitFlag<HardEvent::MTE3_MTE2>(event);
        Nd2NzParams p;
        p.ndNum = 1;
        p.nValue = count;
        p.dValue = N;
        p.srcDValue = N;
        p.srcNdMatrixStride = 0;
        p.dstNzC0Stride = kr;
        p.dstNzNStride = 1;
        p.dstNzMatrixStride = 0;
        DataCopy(tile[slot * span], src[int64_t(e) * K * N + int64_t(first) * N], p);
        SetFlag<HardEvent::MTE2_MTE3>(event);
        WaitFlag<HardEvent::MTE2_MTE3>(event);
        DataCopy(dst[int64_t(e) * KP * NP + first * 32], tile[slot * span],
                 DataCopyParams(blocks, count, kr - count, KP - count));
        SetFlag<HardEvent::MTE3_MTE2>(event);
    }
    WaitFlag<HardEvent::MTE3_MTE2>(EVENT_ID4);
    WaitFlag<HardEvent::MTE3_MTE2>(EVENT_ID5);
    SetFlag<HardEvent::MTE3_S>(EVENT_ID4);
    WaitFlag<HardEvent::MTE3_S>(EVENT_ID4);
    CrossCoreSetFlag<0, PIPE_MTE3>(9);
}

template <int MT, int NT, int LK, bool NZ, int SHARDS, int KR, bool ORIGINAL, bool DEDICATED>
__global__ __mix__(1, 2)
    __attribute__((aligned(4096))) void Adaptive(GM_ADDR x, GM_ADDR weight, GM_ADDR scale,
                                                 GM_ADDR groups, GM_ADDR y, GM_ADDR workspace,
                                                 GM_ADDR metadata, GM_ADDR packedA, GM_ADDR packedB,
                                                 int M, int K, int N, int E, int workers,
                                                 int aPitch, int bPitch, int KP, int depth)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
    SetAtomicNone();
    int core = GetBlockIdx();
    if ASCEND_IS_AIV
    {
        core /= GetSubBlockNum();
    }
    GlobalTensor<int8_t> a, b, pa, pb;
    GlobalTensor<int64_t> g;
    GlobalTensor<uint64_t> schedule;
    GlobalTensor<int32_t> buffer;
    GlobalTensor<float> scales;
    GlobalTensor<half> output;
    a.SetGlobalBuffer((__gm__ int8_t *)x);
    b.SetGlobalBuffer((__gm__ int8_t *)weight);
    g.SetGlobalBuffer((__gm__ int64_t *)groups);
    schedule.SetGlobalBuffer((__gm__ uint64_t *)metadata);
    buffer.SetGlobalBuffer((__gm__ int32_t *)workspace);
    scales.SetGlobalBuffer((__gm__ float *)scale);
    output.SetGlobalBuffer((__gm__ half *)y);
    pa.SetGlobalBuffer((__gm__ int8_t *)packedA);
    pb.SetGlobalBuffer((__gm__ int8_t *)packedB);
    if ASCEND_IS_AIV
    {
        TPipe pipe;
        SetMaskNorm();
        SetVectorMask<uint8_t>(~uint64_t(0), ~uint64_t(0));
        LocalTensor<int64_t> ends(TPosition::VECCALC, 172032, 128);
        if (GetBlockIdx() == 0)
        {
            DataCopyPad(ends, g, DataCopyExtParams(1, E * 8, 0, 0, 0),
                        DataCopyPadExtParams<int64_t>{false, 0, 0, 0});
            SetFlag<HardEvent::MTE2_S>(EVENT_ID6);
        }
        if constexpr (ORIGINAL)
            IssuePrefetchOriginal(b, K, N, E, workers);
        else
            IssuePrefetch(b, ends, g, K, N, E, workers);
        if constexpr (DEDICATED)
        {
            if (GetBlockIdx() != 0)
            {
                if (aPitch != K)
                    PackRows(a, pa, M, K, aPitch, workers * 2 - 1, GetBlockIdx() - 1);
                ZeroWeightTailDedicated(pb, K, E, KP, bPitch, workers * 2 - 1, GetBlockIdx() - 1);
            }
        }
        else
        {
            if (aPitch != K)
                PackRows(a, pa, M, K, aPitch, workers * 2, GetBlockIdx());
            ZeroWeightTail(pb, K, E, KP, bPitch, workers);
        }
        if (GetBlockIdx() == 0)
        {
            WaitFlag<HardEvent::MTE2_S>(EVENT_ID6);
            BuildSchedule<MT, NT, LK, SHARDS, DEDICATED>(ends, schedule, K, N, E, workers, depth);
        }
        SetFlag<HardEvent::MTE2_S>(EVENT_ID4);
        WaitFlag<HardEvent::MTE2_S>(EVENT_ID4);
        CrossCoreSetFlag<0, PIPE_MTE3>(7);
        CrossCoreWaitFlag(7);
        CrossCoreSetFlag<2, PIPE_MTE3>(4);
    }
    if (aPitch != K)
        a.SetGlobalBuffer((__gm__ int8_t *)packedA);

    if ASCEND_IS_AIC
    {
        Cube<MT, NT, (SHARDS > 1), LK, 3, NZ> cube;
        if constexpr (ORIGINAL)
            CubePackBOriginal(b, pb, K, N, E, KP, bPitch, workers);
        else
            CubePackB(b, pb, g, K, N, E, KP, bPitch, workers);
        CrossCoreWaitFlag(4);
        cube.Init();
        const uint64_t header = schedule.GetValue(core);
        const int firstIndex = uint32_t(header), endIndex = firstIndex + int(header >> 32);
        for (int i = firstIndex; i < endIndex; i += 8)
            DataCachePreload(schedule[TABLE_HEAD + i], int16_t(0));
        if constexpr (!ORIGINAL)
            CrossCoreWaitFlag(9);
        int sequence = 0;
        for (int index = firstIndex; index < endIndex; ++index)
        {
            const uint64_t value = schedule.GetValue(TABLE_HEAD + index);
            int expert, row, column, rows, job, shard;
            Decode(value, expert, row, column, rows, job, shard);
            const int col = column * NT, cols = Min(NT, N - col), slot = sequence++ & 1;
            const int first = shard * depth, count = Min(depth, K - first);
            const int64_t offset = SHARDS > 1 ? (int64_t(job) * SHARDS + shard) * MT * NT
                                              : int64_t(core * 2 + slot) * MT * NT;
            const int64_t bOffset = NZ ? int64_t(expert) * KP * bPitch + int64_t(col / 32) * KP * 32
                                       : int64_t(expert) * K * bPitch + col;
            cube.Compute(a[int64_t(row) * aPitch], pb[bOffset], buffer[offset], rows, cols, aPitch,
                         bPitch, first, count, slot, KP);
        }
        cube.Finish();
        if constexpr (SHARDS > 1)
            CrossCoreSetFlag<2, PIPE_FIX>(6);
    }
    if ASCEND_IS_AIV
    {
        TPipe pipe;
        SetMaskNorm();
        SetVectorMask<uint8_t>(~uint64_t(0), ~uint64_t(0));
        LocalTensor<uint64_t> table(TPosition::VECCALC, 172032, TASK_LIMIT);
        if constexpr (SHARDS > 1)
        {
            DataCopyPad(table, schedule[20], DataCopyExtParams(1, 8, 0, 0, 0),
                        DataCopyPadExtParams<uint64_t>{false, 0, 0, 0});
            SetFlag<HardEvent::MTE2_S>(EVENT_ID6);
            WaitFlag<HardEvent::MTE2_S>(EVENT_ID6);
            const int jobs = int(table.GetValue(0));
            DataCopyPad(table, schedule[OUTPUT_BASE], DataCopyExtParams(1, jobs * 8, 0, 0, 0),
                        DataCopyPadExtParams<uint64_t>{false, 0, 0, 0});
            SetFlag<HardEvent::MTE2_S>(EVENT_ID6);
            WaitFlag<HardEvent::MTE2_S>(EVENT_ID6);
            CrossCoreWaitFlag(6);
            CrossCoreSetFlag<0, PIPE_MTE2>(9);
            CrossCoreWaitFlag(9);
            for (int job = core; job < jobs; job += workers)
            {
                int expert, row, column, rows, decodedJob, shard;
                Decode(table.GetValue(job), expert, row, column, rows, decodedJob, shard);
                const int col = column * NT;
                Activate<MT, NT>(buffer[int64_t(job) * SHARDS * MT * NT], scales, output, row, col,
                                 rows, Min(NT, N - col), N, expert, SHARDS, 0);
            }
        }
        else
        {
            DataCopyPad(table, schedule[core], DataCopyExtParams(1, 8, 0, 0, 0),
                        DataCopyPadExtParams<uint64_t>{false, 0, 0, 0});
            SetFlag<HardEvent::MTE2_S>(EVENT_ID6);
            WaitFlag<HardEvent::MTE2_S>(EVENT_ID6);
            const uint64_t header = table.GetValue(0);
            const int begin = uint32_t(header), count = int(header >> 32);
            if (count)
            {
                DataCopyPad(table, schedule[TABLE_HEAD + begin],
                            DataCopyExtParams(1, count * 8, 0, 0, 0),
                            DataCopyPadExtParams<uint64_t>{false, 0, 0, 0});
                SetFlag<HardEvent::MTE2_S>(EVENT_ID6);
                WaitFlag<HardEvent::MTE2_S>(EVENT_ID6);
            }
            CrossCoreSetFlag<2, PIPE_MTE2>(2);
            CrossCoreSetFlag<2, PIPE_MTE2>(3);
            for (int i = 0; i < count; ++i)
            {
                int expert, row, column, rows, job, shard;
                Decode(table.GetValue(i), expert, row, column, rows, job, shard);
                const int col = column * NT, slot = i & 1;
                CrossCoreWaitFlag(slot);
                Activate<MT, NT>(buffer[int64_t(core * 2 + slot) * MT * NT], scales, output, row,
                                 col, rows, Min(NT, N - col), N, expert, 1, slot);
            }
        }
    }
}

template <int MT, int NT, int LK, bool NZ, int SHARDS = 1, int KR = 32>
inline bool LaunchAdaptive(GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR g, GM_ADDR y, int M, int K,
                           int N, int E, int cores, aclrtStream stream)
{
    const int maxJobs = ((M + MT - 1) / MT + E - 1) * ((N + NT - 1) / NT);
    if (maxJobs * SHARDS > TASK_LIMIT)
        return false;
    const int workers = std::min(cores, maxJobs * SHARDS);
    const int KP = (K + 31) / 32 * 32;
    const int aPitch = K <= 544 ? K : (K + 255) / 256 * 256;
    const int bPitch = NZ ? (N + 31) / 32 * 32 : (N + 255) / 256 * 256;
    const int depth = (K + SHARDS * 32 - 1) / (SHARDS * 32) * 32;
    const size_t outputBytes =
        SHARDS > 1 ? size_t(maxJobs) * SHARDS * MT * NT * 4 : size_t(workers) * 2 * MT * NT * 4;
    const size_t tableBytes = size_t(OUTPUT_BASE + TASK_LIMIT) * 8;
    const size_t aBytes = aPitch != K ? size_t(M) * aPitch : 0;
    const size_t bBytes = size_t(E) * (NZ ? KP : K) * bPitch;
    Workspace workspace(outputBytes + tableBytes + aBytes + bBytes, stream);
    GM_ADDR memory = workspace.Data();
    if (!memory)
        return true;
    if (workers < 8)
    {
        Adaptive<MT, NT, LK, NZ, SHARDS, KR, true, false>
            <<<workers, nullptr, stream>>>(x, w, s, g, y, memory, memory + outputBytes,
                                           aBytes ? memory + outputBytes + tableBytes : nullptr,
                                           memory + outputBytes + tableBytes + aBytes, M, K, N, E,
                                           workers, aPitch, bPitch, KP, depth);
    }
    else
    {
        const int rowsPerTile = 32768 / aPitch;
        const int packingTiles = (M + rowsPerTile - 1) / rowsPerTile;
        if (E > 8 && aBytes && packingTiles <= workers * 2 - 1)
        {
            Adaptive<MT, NT, LK, NZ, SHARDS, KR, false, true>
                <<<workers, nullptr, stream>>>(x, w, s, g, y, memory, memory + outputBytes,
                                               aBytes ? memory + outputBytes + tableBytes : nullptr,
                                               memory + outputBytes + tableBytes + aBytes, M, K, N,
                                               E, workers, aPitch, bPitch, KP, depth);
        }
        else
        {
            Adaptive<MT, NT, LK, NZ, SHARDS, KR, false, false>
                <<<workers, nullptr, stream>>>(x, w, s, g, y, memory, memory + outputBytes,
                                               aBytes ? memory + outputBytes + tableBytes : nullptr,
                                               memory + outputBytes + tableBytes + aBytes, M, K, N,
                                               E, workers, aPitch, bPitch, KP, depth);
        }
    }
    workspace.Complete();
    return true;
}

}

namespace aligned_compact
{
using namespace AscendC;
using grouped_gelu::Min;
using grouped_gelu::Up;
using grouped_gelu::Gelu;
using grouped_gelu::Workspace;
using scheduled::Cube;

using scheduled::EpilogueSequential;

template <int MT, int NT, int LK>
__global__ __mix__(1, 2)
    __attribute__((aligned(4096))) void Uniform(GM_ADDR x, GM_ADDR weight, GM_ADDR scale,
                                                GM_ADDR groups, GM_ADDR y, GM_ADDR workspace, int K,
                                                int N, int E, int workers)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
    SetAtomicNone();
    int core = GetBlockIdx();
    if ASCEND_IS_AIV
    {
        core /= GetSubBlockNum();
    }
    GlobalTensor<int8_t> a, b;
    GlobalTensor<int64_t> g;
    GlobalTensor<int32_t> buffer;
    GlobalTensor<float> s;
    GlobalTensor<half> output;
    a.SetGlobalBuffer((__gm__ int8_t *)x);
    b.SetGlobalBuffer((__gm__ int8_t *)weight);
    g.SetGlobalBuffer((__gm__ int64_t *)groups);
    buffer.SetGlobalBuffer((__gm__ int32_t *)workspace);
    s.SetGlobalBuffer((__gm__ float *)scale);
    output.SetGlobalBuffer((__gm__ half *)y);
    const int columns = N / NT, total = E * columns;
    const int decisionOffset = workers * 2 * MT * NT + core * 8;
    if ASCEND_IS_AIC
    {
        Cube<MT, NT, false, LK, 3, false, true> cube;
        cube.Init();
        int expert = core / columns, col = core % columns * NT;
        cube.Compute(a[int64_t(expert) * MT * K], b[int64_t(expert) * K * N + col],
                     buffer[int64_t(core * 2) * MT * NT], MT, NT, K, N, 0, K, 0);
        CrossCoreWaitFlag(4);
        const bool uniform = buffer[decisionOffset].GetValue(0) != 0;
        int sequence = 1;
        if (uniform)
        {
            for (int job = core + workers; job < total; job += workers)
            {
                expert = job / columns;
                col = job % columns * NT;
                const int slot = sequence++ & 1;
                cube.Compute(a[int64_t(expert) * MT * K], b[int64_t(expert) * K * N + col],
                             buffer[int64_t(core * 2 + slot) * MT * NT], MT, NT, K, N, 0, K, slot);
            }
        }
        else
        {
            cube.Flush();
            sequence = 0;
            int start = 0, base = 0, next = core;
            for (int e = 0; e < E; ++e)
            {
                const int end = int(g.GetValue(e)), length = end - start;
                const int tiles = (length + MT - 1) / MT * columns;
                while (next < base + tiles)
                {
                    const int local = next - base, row = local / columns * MT;
                    col = local % columns * NT;
                    const int slot = sequence++ & 1;
                    cube.Compute(a[int64_t(start + row) * K], b[int64_t(e) * K * N + col],
                                 buffer[int64_t(core * 2 + slot) * MT * NT], Min(MT, length - row),
                                 NT, K, N, 0, K, slot);
                    next += workers;
                }
                start = end;
                base += tiles;
            }
        }
        cube.Finish();
    }
    if ASCEND_IS_AIV
    {
        TPipe pipe;
        SetMaskNorm();
        SetVectorMask<uint8_t>(~uint64_t(0), ~uint64_t(0));
        LocalTensor<int64_t> ends(TPosition::VECCALC, 172032, 128);
        DataCopyPad(ends, g, DataCopyExtParams(1, E * 8, 0, 0, 0),
                    DataCopyPadExtParams<int64_t>{false, 0, 0, 0});
        SetFlag<HardEvent::MTE2_S>(EVENT_ID4);
        CrossCoreSetFlag<2, PIPE_MTE2>(2);
        CrossCoreSetFlag<2, PIPE_MTE2>(3);
        WaitFlag<HardEvent::MTE2_S>(EVENT_ID4);
        bool uniform = true;
        for (int e = 0; e < E; ++e)
            if (ends.GetValue(e) != int64_t(e + 1) * MT)
                uniform = false;
        if (GetSubBlockIdx() == 0)
        {
            LocalTensor<int32_t> decision(TPosition::VECCALC, 173056, 8);
            decision.SetValue(0, int32_t(uniform));
            SetFlag<HardEvent::S_MTE3>(EVENT_ID4);
            WaitFlag<HardEvent::S_MTE3>(EVENT_ID4);
            DataCopyPad(buffer[decisionOffset], decision, DataCopyExtParams(1, 4, 0, 0, 0));
        }
        CrossCoreSetFlag<2, PIPE_MTE3>(4);
        EpilogueSequential<MT, NT> epilogue;
        int sequence = 0;
        if (uniform)
        {
            for (int job = core; job < total; job += workers)
            {
                const int e = job / columns, col = job % columns * NT, slot = sequence++ & 1;
                CrossCoreWaitFlag(slot);
                epilogue.Run(buffer[int64_t(core * 2 + slot) * MT * NT], s, output, e * MT, col, MT,
                             NT, N, e, 1, slot);
            }
        }
        else
        {
            CrossCoreWaitFlag(0);
            CrossCoreSetFlag<2, PIPE_MTE2>(2);
            int start = 0, base = 0, next = core;
            for (int e = 0; e < E; ++e)
            {
                const int end = int(ends.GetValue(e)), length = end - start;
                const int tiles = (length + MT - 1) / MT * columns;
                while (next < base + tiles)
                {
                    const int local = next - base, row = local / columns * MT;
                    const int col = local % columns * NT, slot = sequence++ & 1;
                    CrossCoreWaitFlag(slot);
                    epilogue.Run(buffer[int64_t(core * 2 + slot) * MT * NT], s, output, start + row,
                                 col, Min(MT, length - row), NT, N, e, 1, slot);
                    next += workers;
                }
                start = end;
                base += tiles;
            }
        }
    }
}

inline void LaunchUniform(GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR g, GM_ADDR y, int K, int N,
                          int E, int cores, aclrtStream stream)
{
    const int workers = std::min(cores, E * (N / 256));
    Workspace workspace((size_t(workers) * 2 * 64 * 256 + workers * 8) * 4, stream);
    if (!workspace.Data())
        return;
    Uniform<64, 256, 256>
        <<<workers, nullptr, stream>>>(x, w, s, g, y, workspace.Data(), K, N, E, workers);
    workspace.Complete();
}

}

namespace aligned_padded
{
using namespace AscendC;
using grouped_gelu::Min;
using grouped_gelu::Up;
using resident_packed_prefetch::Gelu;
using grouped_gelu::Workspace;
using scheduled::Cube;

template <int MT, int NT, bool KEEP_LAYOUT = false, bool EARLY_INPUT = false>
class EpilogueSequential
{
    static constexpr int ROWS = (MT + 1) / 2;
    static constexpr int SIZE = ROWS * NT;
    static constexpr int UB_SHIFT = KEEP_LAYOUT ? 0 : 256;
    static_assert(SIZE * 10 + NT * 4 + UB_SHIFT <= 196608, "UB capacity exceeded");
    LocalTensor<int32_t> accum{TPosition::VECCALC, 0, SIZE};
    LocalTensor<float> temporary{TPosition::VECCALC, SIZE * 4 + UB_SHIFT, SIZE};
    LocalTensor<half> output{TPosition::VECCALC, SIZE * 8 + UB_SHIFT, SIZE};
    LocalTensor<float> scales{TPosition::VECCALC, SIZE * 10 + UB_SHIFT, NT};

  public:
    __aicore__ inline void Run(const GlobalTensor<int32_t> &src, const GlobalTensor<float> &scale,
                               const GlobalTensor<half> &y, int row, int col, int rows, int cols,
                               int N, int expert, int shards = 1, int slot = 0,
                               int partialStride = MT * NT)
    {
        const int first = GetSubBlockIdx() * ((rows + 1) / 2);
        const int valid = GetSubBlockIdx() ? rows / 2 : (rows + 1) / 2;
        if (valid <= 0)
        {
            if (shards == 1)
                CrossCoreSetFlag<2, PIPE_MTE2>(2 + slot);
            return;
        }
        DataCopy(accum, src[first * NT], valid * NT);
        if (cols == NT && (N == NT || cols % 16 == 0))
            DataCopy(scales, scale[expert * N + col], cols);
        else
            DataCopyPad(scales, scale[expert * N + col], DataCopyExtParams(1, cols * 4, 0, 0, 0),
                        DataCopyPadExtParams<float>{false, 0, 0, 0.0f});
        SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
        WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
        for (int s = 1; s < shards; ++s)
        {
            auto part = temporary.template ReinterpretCast<int32_t>();
            DataCopy(part, src[s * partialStride + first * NT], valid * NT);
            SetFlag<HardEvent::MTE2_V>(EVENT_ID1);
            WaitFlag<HardEvent::MTE2_V>(EVENT_ID1);
            Add(accum, accum, part, valid * NT);
            SetFlag<HardEvent::V_MTE2>(EVENT_ID1);
            WaitFlag<HardEvent::V_MTE2>(EVENT_ID1);
        }
        if (shards == 1)
            CrossCoreSetFlag<2, PIPE_MTE2>(2 + slot);
        auto z = accum.template ReinterpretCast<float>();
        Cast(z, accum, RoundMode::CAST_RINT, valid * NT);
        PipeBarrier<PIPE_V>();

        for (int r = 0; r < valid; r += 128)
            for (int c = 0; c < NT; c += 64)
            {
                const int width = Min(64, NT - c);
                Mul(z[r * NT + c], z[r * NT + c], scales[c], width, Min(128, valid - r),
                    {1, 1, 1, uint8_t(NT / 8), uint8_t(NT / 8), 0});
            }
        PipeBarrier<PIPE_V>();
        Gelu(z, temporary, output, valid * NT);
        const bool compact =
            N == cols && col == 0 && N < NT && N <= 64 && N % 16 != 0 && valid >= 16;
        auto packed = temporary.template ReinterpretCast<half>();
        if (compact)
        {

            const int count = valid * N;
            PipeBarrier<PIPE_V>();
            CreateVecIndex(accum, int32_t(0), count);
            PipeBarrier<PIPE_V>();
            Cast(temporary, accum, RoundMode::CAST_RINT, count);
            PipeBarrier<PIPE_V>();
            Muls(temporary, temporary, 1.0f / N, count);
            PipeBarrier<PIPE_V>();

            Adds(temporary, temporary, 0.0001f, count);
            PipeBarrier<PIPE_V>();
            auto rows = temporary.template ReinterpretCast<int32_t>();
            Cast(rows, temporary, RoundMode::CAST_FLOOR, count);
            PipeBarrier<PIPE_V>();
            Muls(rows, rows, int32_t(2 * (NT - N)), count);
            Muls(accum, accum, int32_t(2), count);
            PipeBarrier<PIPE_V>();
            Add(accum, accum, rows, count);
            PipeBarrier<PIPE_V>();
            Gather(packed, output, accum.template ReinterpretCast<uint32_t>(), 0, count);
        }
        if constexpr (EARLY_INPUT)
            SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
        SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
        WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
        if (compact)
            DataCopyPad(y[int64_t(row + first) * N], packed,
                        DataCopyExtParams(1, valid * N * 2, 0, 0, 0));
        else if (valid == ROWS && cols == NT && N == NT)
            DataCopy(y[int64_t(row + first) * N + col], output, valid * NT);
        else
            DataCopyPad(
                y[int64_t(row + first) * N + col], output,
                DataCopyExtParams(valid, cols * 2, (NT - Up(cols, 16)) / 16, (N - cols) * 2, 0));
        SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
        WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
        if constexpr (!EARLY_INPUT)
            SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
        WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
    }
};

template <int MT, int NT, int LK>
__global__ __mix__(1, 2)
    __attribute__((aligned(4096))) void Uniform(GM_ADDR x, GM_ADDR weight, GM_ADDR scale,
                                                GM_ADDR groups, GM_ADDR y, GM_ADDR workspace, int K,
                                                int N, int E, int workers)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
    SetAtomicNone();
    int core = GetBlockIdx();
    if ASCEND_IS_AIV
    {
        core /= GetSubBlockNum();
    }
    GlobalTensor<int8_t> a, b;
    GlobalTensor<int64_t> g;
    GlobalTensor<int32_t> buffer;
    GlobalTensor<float> s;
    GlobalTensor<half> output;
    a.SetGlobalBuffer((__gm__ int8_t *)x);
    b.SetGlobalBuffer((__gm__ int8_t *)weight);
    g.SetGlobalBuffer((__gm__ int64_t *)groups);
    buffer.SetGlobalBuffer((__gm__ int32_t *)workspace);
    s.SetGlobalBuffer((__gm__ float *)scale);
    output.SetGlobalBuffer((__gm__ half *)y);
    const int columns = N / NT, total = E * columns;
    const int decisionOffset = workers * (2 * MT * NT + 1024) + core * 8;
    if ASCEND_IS_AIC
    {
        Cube<MT, NT, false, LK, 3, false, true> cube;
        cube.Init();
        int expert = core / columns, col = core % columns * NT;
        cube.Compute(a[int64_t(expert) * MT * K], b[int64_t(expert) * K * N + col],
                     buffer[int64_t(core) * (2 * MT * NT + 1024)], MT, NT, K, N, 0, K, 0);
        CrossCoreWaitFlag(4);
        const bool uniform = buffer[decisionOffset].GetValue(0) != 0;
        int sequence = 1;
        if (uniform)
        {
            for (int job = core + workers; job < total; job += workers)
            {
                expert = job / columns;
                col = job % columns * NT;
                const int slot = sequence++ & 1;
                cube.Compute(a[int64_t(expert) * MT * K], b[int64_t(expert) * K * N + col],
                             buffer[int64_t(core) * (2 * MT * NT + 1024) + slot * MT * NT], MT, NT,
                             K, N, 0, K, slot);
            }
        }
        else
        {
            cube.Flush();
            sequence = 0;
            int start = 0, base = 0, next = core;
            for (int e = 0; e < E; ++e)
            {
                const int end = int(g.GetValue(e)), length = end - start;
                const int tiles = (length + MT - 1) / MT * columns;
                while (next < base + tiles)
                {
                    const int local = next - base, row = local / columns * MT;
                    col = local % columns * NT;
                    const int slot = sequence++ & 1;
                    cube.Compute(a[int64_t(start + row) * K], b[int64_t(e) * K * N + col],
                                 buffer[int64_t(core) * (2 * MT * NT + 1024) + slot * MT * NT],
                                 Min(MT, length - row), NT, K, N, 0, K, slot);
                    next += workers;
                }
                start = end;
                base += tiles;
            }
        }
        cube.Finish();
    }
    if ASCEND_IS_AIV
    {
        TPipe pipe;
        SetMaskNorm();
        SetVectorMask<uint8_t>(~uint64_t(0), ~uint64_t(0));
        LocalTensor<int64_t> ends(TPosition::VECCALC, 172032, 128);
        DataCopyPad(ends, g, DataCopyExtParams(1, E * 8, 0, 0, 0),
                    DataCopyPadExtParams<int64_t>{false, 0, 0, 0});
        SetFlag<HardEvent::MTE2_S>(EVENT_ID4);
        CrossCoreSetFlag<2, PIPE_MTE2>(2);
        CrossCoreSetFlag<2, PIPE_MTE2>(3);
        WaitFlag<HardEvent::MTE2_S>(EVENT_ID4);
        bool uniform = true;
        for (int e = 0; e < E; ++e)
            if (ends.GetValue(e) != int64_t(e + 1) * MT)
            {
                uniform = false;
                break;
            }
        if (GetSubBlockIdx() == 0)
        {
            LocalTensor<int32_t> decision(TPosition::VECCALC, 173056, 8);
            decision.SetValue(0, int32_t(uniform));
            SetFlag<HardEvent::S_MTE3>(EVENT_ID4);
            WaitFlag<HardEvent::S_MTE3>(EVENT_ID4);
            DataCopyPad(buffer[decisionOffset], decision, DataCopyExtParams(1, 4, 0, 0, 0));
        }
        CrossCoreSetFlag<2, PIPE_MTE3>(4);
        EpilogueSequential<MT, NT> epilogue;
        int sequence = 0;
        if (uniform)
        {
            for (int job = core; job < total; job += workers)
            {
                const int e = job / columns, col = job % columns * NT, slot = sequence++ & 1;
                CrossCoreWaitFlag(slot);
                epilogue.Run(buffer[int64_t(core) * (2 * MT * NT + 1024) + slot * MT * NT], s,
                             output, e * MT, col, MT, NT, N, e, 1, slot);
            }
        }
        else
        {
            CrossCoreWaitFlag(0);
            CrossCoreSetFlag<2, PIPE_MTE2>(2);
            EpilogueSequential<MT, NT, false, true> consumer;
            int start = 0, base = 0, next = core;
            for (int e = 0; e < E; ++e)
            {
                const int end = int(ends.GetValue(e)), length = end - start;
                const int tiles = (length + MT - 1) / MT * columns;
                while (next < base + tiles)
                {
                    const int local = next - base, row = local / columns * MT;
                    const int col = local % columns * NT, slot = sequence++ & 1;
                    CrossCoreWaitFlag(slot);
                    consumer.Run(buffer[int64_t(core) * (2 * MT * NT + 1024) + slot * MT * NT], s,
                                 output, start + row, col, Min(MT, length - row), NT, N, e, 1,
                                 slot);
                    next += workers;
                }
                start = end;
                base += tiles;
            }
        }
    }
}

inline void LaunchUniform(GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR g, GM_ADDR y, int K, int N,
                          int E, int cores, aclrtStream stream)
{
    const int workers = std::min(cores, E * (N / 256));
    Workspace workspace((size_t(workers) * (2 * 64 * 256 + 1024) + workers * 8) * 4, stream);
    if (!workspace.Data())
        return;
    Uniform<64, 256, 256>
        <<<workers, nullptr, stream>>>(x, w, s, g, y, workspace.Data(), K, N, E, workers);
    workspace.Complete();
}

}

namespace full_a_prepare
{
using namespace AscendC;
using grouped_gelu::Min;
using grouped_gelu::Up;
using shallow_wide::Gelu;
using grouped_gelu::Workspace;
template <int MT, int NT, bool SPLIT, int LK = 256, int NSTAGES = 3, bool MULTI_ND = false>
class Cube
{
    static constexpr int FK = 128, STAGES = NSTAGES, ASTAGES = 2, AK = 1280;
    static constexpr int APANEL = MT * AK, BPANEL = NT * LK, QUEUE = STAGES - 1;
    static constexpr int CSLOTS = MT * NT * 4 <= 65536 ? 2 : 1;
    static_assert(!SPLIT && ASTAGES * APANEL + STAGES * BPANEL <= 524288, "L1 capacity exceeded");
    static_assert(2 * MT * FK <= 65536 && 2 * NT * FK <= 65536, "L0A/B capacity exceeded");
    static_assert(CSLOTS * MT * NT * 4 <= 131072, "L0C capacity exceeded");
    LocalTensor<int8_t> aCache{TPosition::A1, 0, ASTAGES * APANEL};
    LocalTensor<int8_t> bL1{TPosition::A1, ASTAGES * APANEL, STAGES * BPANEL};
    LocalTensor<int8_t> a0{TPosition::A2, 0, 2 * MT * FK};
    LocalTensor<int8_t> b0{TPosition::B2, 0, 2 * NT * FK};
    LocalTensor<int32_t> c0{TPosition::CO1, 0, CSLOTS * MT * NT};
    struct Pending
    {
        int slot, rows, cols, outputSlot, aSlot, offset, count;
        bool first, last, releaseA;
        GM_ADDR output;
    };
    Pending pending[QUEUE];
    int fragmentSlot = 0, producer = 0, head = 0, pendingCount = 0;
    __aicore__ inline void Consume(const Pending &p)
    {
        const int cslot = p.outputSlot % CSLOTS;
        if (p.first)
            WaitFlag<HardEvent::FIX_M>(cslot);
        WaitFlag<HardEvent::MTE2_MTE1>(event_t(p.slot));
        auto c = c0[cslot * MT * NT];
        const int actualM = Up(p.rows, 16), activeN = Up(p.cols, 32);
        for (int f = 0; f < p.count; f += FK)
        {
            const int fk = Up(Min(FK, p.count - f), 32), fs = fragmentSlot;
            WaitFlag<HardEvent::M_MTE1>(event_t(fs));
            auto aa = a0[fs * MT * FK];
            auto bb = b0[fs * NT * FK];
            auto la = aCache[p.aSlot * APANEL + (p.offset + f) * MT];
            auto lb = bL1[p.slot * BPANEL + f * activeN];
            LoadData2DParams pa;
            pa.startIndex = 0;
            pa.repeatTimes = fk / 32;
            pa.srcStride = MT / 16;
            pa.dstGap = 0;
            pa.ifTranspose = false;
            pa.sid = 0;
            pa.addrMode = 0;
            for (int mi = 0; mi < (p.rows + 15) / 16; ++mi)
                LoadData(aa[mi * fk * 16], la[mi * 512], pa);
            LoadData2dTransposeParams pb;
            pb.startIndex = 0;
            pb.repeatTimes = fk / 32 * (activeN / 32);
            pb.srcStride = 1;
            pb.dstGap = 1;
            pb.dstFracGap = 0;
            LoadDataWithTranspose(bb, lb, pb);
            SetFlag<HardEvent::MTE1_M>(event_t(fs));
            WaitFlag<HardEvent::MTE1_M>(event_t(fs));
            MmadParams mm;
            mm.m = actualM;
            mm.n = activeN;
            mm.k = fk;
            mm.cmatrixInitVal = p.first && f == 0;
            mm.unitFlag = p.last && f + FK >= p.count ? 3 : 2;
            Mmad(c, aa, bb, mm);
            if (actualM * activeN < 2560)
                PipeBarrier<PIPE_M>();
            SetFlag<HardEvent::M_MTE1>(event_t(fs));
            fragmentSlot ^= 1;
        }
        SetFlag<HardEvent::MTE1_MTE2>(event_t(p.slot));
        if (p.releaseA)
            SetFlag<HardEvent::MTE1_MTE2>(event_t(STAGES + p.aSlot));
        if (p.last)
        {
            GlobalTensor<int32_t> dst;
            dst.SetGlobalBuffer((__gm__ int32_t *)p.output);
            CrossCoreWaitFlag(2 + p.outputSlot);
            FixpipeParamsV220 fp;
            fp.nSize = activeN;
            fp.mSize = p.rows;
            fp.srcStride = actualM;
            fp.dstStride = activeN;
            fp.quantPre = QuantMode_t::NoQuant;
            fp.reluEn = false;
            fp.unitFlag = 3;
            Fixpipe<int32_t, int32_t, CFG_ROW_MAJOR>(dst, c, fp);
            SetFlag<HardEvent::FIX_M>(event_t(cslot));
            CrossCoreSetFlag<2, PIPE_FIX>(p.outputSlot);
        }
    }
    __aicore__ inline void Drain()
    {
        while (pendingCount)
        {
            Consume(pending[head]);
            head = head + 1 < QUEUE ? head + 1 : 0;
            --pendingCount;
        }
    }

  public:
    __aicore__ inline void Init()
    {
        SetLoadDataPaddingValue<uint64_t>(0);
        SetFixpipeNz2ndFlag(1, 0, 0);
        for (int i = 0; i < STAGES + ASTAGES; ++i)
            SetFlag<HardEvent::MTE1_MTE2>(event_t(i));
        for (int i = 0; i < 2; ++i)
            SetFlag<HardEvent::M_MTE1>(event_t(i));
        for (int i = 0; i < CSLOTS; ++i)
            SetFlag<HardEvent::FIX_M>(event_t(i));
    }
    __aicore__ inline void LoadA(const GlobalTensor<int8_t> &src, int rows, int K, int aSlot)
    {
        if constexpr (ASTAGES == 1)
            Drain();
        WaitFlag<HardEvent::MTE1_MTE2>(event_t(STAGES + aSlot));
        Nd2NzParams p;
        p.ndNum = 1;
        p.nValue = rows;
        p.dValue = K;
        p.srcNdMatrixStride = 0;
        p.srcDValue = K;
        p.dstNzC0Stride = MT;
        p.dstNzNStride = 1;
        p.dstNzMatrixStride = 0;
        if constexpr (MULTI_ND)
        {
            if (rows > 16 && rows % 16 == 0 && int64_t(16) * p.srcDValue <= 65535)
            {
                p.ndNum = rows / 16;
                p.nValue = 16;
                p.srcNdMatrixStride = 16 * p.srcDValue;
                p.dstNzMatrixStride = 16 * 32;
            }
        }
        if (K % 4 == 0)
        {
            GlobalTensor<float> wide;
            wide.SetGlobalBuffer((__gm__ float *)src.GetPhyAddr());
            p.dValue = K / 4;
            p.srcDValue = K / 4;
            if constexpr (MULTI_ND)
            {
                p.srcNdMatrixStride /= 4;
                p.dstNzMatrixStride /= 4;
            }
            DataCopy(aCache[aSlot * APANEL].template ReinterpretCast<float>(), wide, p);
        }
        else
            DataCopy(aCache[aSlot * APANEL], src, p);
    }
    __aicore__ inline void Compute(const GlobalTensor<int8_t> &b, const GlobalTensor<int32_t> &dst,
                                   int rows, int cols, int K, int NP, int outputSlot, int aSlot,
                                   bool lastColumn)
    {
        const int panels = (K + LK - 1) / LK;
        for (int p = 0; p < panels; ++p)
        {
            const int ki = (p + GetBlockIdx()) % panels, count = Min(LK, K - ki * LK),
                      slot = producer;
            WaitFlag<HardEvent::MTE1_MTE2>(event_t(slot));
            const int physicalN = Up(cols, 32);
            DataCopy(bL1[slot * BPANEL], b[int64_t(ki * LK) * NP],
                     DataCopyParams(Up(count, 32) / 32, physicalN, NP - physicalN, 0));
            SetFlag<HardEvent::MTE2_MTE1>(event_t(slot));
            const Pending value = {slot,
                                   rows,
                                   cols,
                                   outputSlot,
                                   aSlot,
                                   ki * LK,
                                   count,
                                   p == 0,
                                   p + 1 == panels,
                                   lastColumn && p + 1 == panels,
                                   (GM_ADDR)dst.GetPhyAddr()};
            if (pendingCount == QUEUE)
            {
                Consume(pending[head]);
                pending[head] = value;
                head = head + 1 < QUEUE ? head + 1 : 0;
            }
            else
            {
                const int tail =
                    head + pendingCount < QUEUE ? head + pendingCount : head + pendingCount - QUEUE;
                pending[tail] = value;
                ++pendingCount;
            }
            producer = producer + 1 < STAGES ? producer + 1 : 0;
        }
    }
    __aicore__ inline void Finish()
    {
        Drain();
        for (int i = 0; i < STAGES + ASTAGES; ++i)
            WaitFlag<HardEvent::MTE1_MTE2>(event_t(i));
        for (int i = 0; i < 2; ++i)
            WaitFlag<HardEvent::M_MTE1>(event_t(i));
        for (int i = 0; i < CSLOTS; ++i)
            WaitFlag<HardEvent::FIX_M>(event_t(i));
    }
};

template <int MT, int NT, bool KEEP_LAYOUT = false> class EpilogueSequential
{
    static constexpr int ROWS = (MT + 1) / 2;
    static constexpr int SIZE = ROWS * NT;
    static constexpr int UB_SHIFT = KEEP_LAYOUT ? 0 : 256;
    static_assert(SIZE * 10 + 2048 * 4 + UB_SHIFT <= 172032, "UB capacity exceeded");
    LocalTensor<int32_t> accum{TPosition::VECCALC, 0, SIZE};
    LocalTensor<float> temporary{TPosition::VECCALC, SIZE * 4 + UB_SHIFT, SIZE};
    LocalTensor<half> output{TPosition::VECCALC, SIZE * 8 + UB_SHIFT, SIZE};

  public:
    __aicore__ inline void Run(const GlobalTensor<int32_t> &src, const GlobalTensor<float> &scale,
                               const GlobalTensor<half> &y, int row, int col, int rows, int cols,
                               int N, int expert, int pitch, int shards = 1, int slot = 0,
                               bool reuseScale = false)
    {
        LocalTensor<float> scales(TPosition::VECCALC,
                                  SIZE * 10 + UB_SHIFT + (reuseScale ? col * 4 : 0), pitch);
        const int first = GetSubBlockIdx() * ((rows + 1) / 2);
        const int valid = GetSubBlockIdx() ? rows / 2 : (rows + 1) / 2;
        if (valid <= 0)
        {
            if (shards == 1)
                CrossCoreSetFlag<2, PIPE_MTE2>(2 + slot);
            return;
        }
        DataCopy(accum, src[first * pitch], valid * pitch);
        if (!reuseScale)
        {
            if (cols == pitch && (N == pitch || cols % 16 == 0))
                DataCopy(scales, scale[expert * N + col], cols);
            else
                DataCopyPad(scales, scale[expert * N + col],
                            DataCopyExtParams(1, cols * 4, 0, 0, 0),
                            DataCopyPadExtParams<float>{false, 0, 0, 0.0f});
        }
        SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
        WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
        for (int s = 1; s < shards; ++s)
        {
            auto part = temporary.template ReinterpretCast<int32_t>();
            DataCopy(part, src[s * MT * pitch + first * pitch], valid * pitch);
            SetFlag<HardEvent::MTE2_V>(EVENT_ID1);
            WaitFlag<HardEvent::MTE2_V>(EVENT_ID1);
            Add(accum, accum, part, valid * pitch);
            SetFlag<HardEvent::V_MTE2>(EVENT_ID1);
            WaitFlag<HardEvent::V_MTE2>(EVENT_ID1);
        }
        if (shards == 1)
            CrossCoreSetFlag<2, PIPE_MTE2>(2 + slot);
        auto z = accum.template ReinterpretCast<float>();
        Cast(z, accum, RoundMode::CAST_RINT, valid * pitch);
        PipeBarrier<PIPE_V>();

        for (int r = 0; r < valid; r += 128)
            for (int c = 0; c < pitch; c += 64)
            {
                const int width = Min(64, pitch - c);
                Mul(z[r * pitch + c], z[r * pitch + c], scales[c], width, Min(128, valid - r),
                    {1, 1, 1, uint8_t(pitch / 8), uint8_t(pitch / 8), 0});
            }
        PipeBarrier<PIPE_V>();
        Gelu(z, temporary, output, valid * pitch);
        const bool compact =
            N == cols && col == 0 && N < pitch && N <= 64 && N % 16 != 0 && valid >= 16;
        auto packed = temporary.template ReinterpretCast<half>();
        if (compact)
        {

            const int count = valid * N;
            PipeBarrier<PIPE_V>();
            CreateVecIndex(accum, int32_t(0), count);
            PipeBarrier<PIPE_V>();
            Cast(temporary, accum, RoundMode::CAST_RINT, count);
            PipeBarrier<PIPE_V>();
            Muls(temporary, temporary, 1.0f / N, count);
            PipeBarrier<PIPE_V>();

            Adds(temporary, temporary, 0.0001f, count);
            PipeBarrier<PIPE_V>();
            auto rows = temporary.template ReinterpretCast<int32_t>();
            Cast(rows, temporary, RoundMode::CAST_FLOOR, count);
            PipeBarrier<PIPE_V>();
            Muls(rows, rows, int32_t(2 * (pitch - N)), count);
            Muls(accum, accum, int32_t(2), count);
            PipeBarrier<PIPE_V>();
            Add(accum, accum, rows, count);
            PipeBarrier<PIPE_V>();
            Gather(packed, output, accum.template ReinterpretCast<uint32_t>(), 0, count);
        }
        SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
        WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
        if (compact)
            DataCopyPad(y[int64_t(row + first) * N], packed,
                        DataCopyExtParams(1, valid * N * 2, 0, 0, 0));
        else if (valid == ROWS && cols == pitch && N == pitch)
            DataCopy(y[int64_t(row + first) * N + col], output, valid * pitch);
        else
            DataCopyPad(
                y[int64_t(row + first) * N + col], output,
                DataCopyExtParams(valid, cols * 2, (pitch - Up(cols, 16)) / 16, (N - cols) * 2, 0));
        SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
        SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
        WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
    }
};

template <int MT, int NT>
__aicore__ inline void Activate(const GlobalTensor<int32_t> &src, const GlobalTensor<float> &scale,
                                const GlobalTensor<half> &y, int row, int col, int rows, int cols,
                                int N, int expert, int shards, int slot, bool reuseScale)
{
    const int width = Up(cols, 32);
    EpilogueSequential<MT, NT> epilogue;
    epilogue.Run(src, scale, y, row, col, rows, cols, N, expert, width, shards, slot, reuseScale);
}

constexpr int MT = 64, NT = 256, LK = 384, ST = 3, KR = 64;

__aicore__ inline void PrefetchFromGroups(const GlobalTensor<int8_t> &b,
                                          const LocalTensor<int64_t> &groups, int K, int N, int E,
                                          int workers)
{
    constexpr int CHUNK = 16384, STEP = 512;
    const int64_t bytes = int64_t(K) * N, total = int64_t(E) * bytes;
    LocalTensor<int8_t> scratch(TPosition::VECCALC, 0, 2 * CHUNK);
    int slot = 0;
    for (int64_t off = int64_t(GetBlockIdx()) * CHUNK; off < total; off += workers * 2 * CHUNK)
    {
        const int span = Min(CHUNK, int(total - off));
        const int first = int(off / bytes), last = int((off + span - 1) / bytes);
        bool needed = false;
        for (int e = first; e <= last; ++e)
            if (groups.GetValue(e) > (e ? groups.GetValue(e - 1) : 0))
                needed = true;
        if (!needed)
            continue;
        const int blocks = span / STEP;
        if (blocks)
            DataCopy(scratch[slot * CHUNK], b[off], DataCopyParams(blocks, 1, STEP / 32 - 1, 0));
        if (span % STEP >= 32)
            DataCopy(scratch[slot * CHUNK + blocks * 32], b[off + blocks * STEP], 32);
        slot ^= 1;
    }
}

template <int KR>
__aicore__ inline void KMajorPackB(const GlobalTensor<int8_t> &src, const GlobalTensor<int8_t> &dst,
                                   const GlobalTensor<int64_t> &groups, int K, int N, int E, int KP,
                                   int NP, int workers)
{
    constexpr int STAGES = 4;
    const int batches = (K + KR - 1) / KR, span = KR * NP, blocks = NP / 32;
    int active[128], amount = 0, previous = 0;
    for (int e = 0; e < E; ++e)
    {
        const int end = int(groups.GetValue(e));
        if (end > previous)
            active[amount++] = e;
        previous = end;
    }
    LocalTensor<int8_t> tile(TPosition::A1, 0, STAGES * span);
    SetLoadDataPaddingValue<uint64_t>(0);
    for (int i = 0; i < STAGES; ++i)
        SetFlag<HardEvent::MTE3_MTE2>(event_t(i));
    struct Pending
    {
        int expert, first, count, slot;
    };
    Pending pending[STAGES - 1];
    int head = 0, queued = 0, producer = 0;
    for (int task = GetBlockIdx(); task < amount * batches; task += workers)
    {
        const int e = active[task / batches], first = task % batches * KR;
        const int count = Min(KR, K - first), slot = producer;
        WaitFlag<HardEvent::MTE3_MTE2>(event_t(slot));
        const int whole = count / 32, tail = count % 32;
        Nd2NzParams p;
        p.ndNum = whole;
        p.nValue = 32;
        p.dValue = N;
        p.srcDValue = N;
        p.srcNdMatrixStride = 32 * N;
        p.dstNzC0Stride = 32;
        p.dstNzNStride = 1;
        p.dstNzMatrixStride = NP * 32;
        if (whole)
            DataCopy(tile[slot * span], src[int64_t(e) * K * N + int64_t(first) * N], p);
        if (tail)
        {
            p.ndNum = 1;
            p.nValue = tail;
            p.dstNzMatrixStride = 0;
            DataCopy(tile[slot * span + whole * NP * 32],
                     src[int64_t(e) * K * N + int64_t(first + whole * 32) * N], p);
            InitConstValueParams<uint16_t> zero(blocks, 32 - tail, tail, uint16_t(0));
            InitConstValue(tile[slot * span + whole * NP * 32 + tail * 32]
                               .template ReinterpretCast<uint16_t>(),
                           zero);
        }
        SetFlag<HardEvent::MTE2_MTE3>(event_t(slot));
        if (queued == STAGES - 1)
        {
            const Pending old = pending[head];
            WaitFlag<HardEvent::MTE2_MTE3>(event_t(old.slot));
            DataCopy(dst[int64_t(old.expert) * KP * NP + int64_t(old.first) * NP],
                     tile[old.slot * span], Up(old.count, 32) * NP);
            SetFlag<HardEvent::MTE3_MTE2>(event_t(old.slot));
            pending[head] = {e, first, count, slot};
            head = (head + 1) % (STAGES - 1);
        }
        else
            pending[(head + queued++) % (STAGES - 1)] = {e, first, count, slot};
        producer = (producer + 1) % STAGES;
    }
    while (queued)
    {
        const Pending old = pending[head];
        WaitFlag<HardEvent::MTE2_MTE3>(event_t(old.slot));
        DataCopy(dst[int64_t(old.expert) * KP * NP + int64_t(old.first) * NP],
                 tile[old.slot * span], Up(old.count, 32) * NP);
        SetFlag<HardEvent::MTE3_MTE2>(event_t(old.slot));
        head = (head + 1) % (STAGES - 1);
        --queued;
    }
    for (int i = 0; i < STAGES; ++i)
        WaitFlag<HardEvent::MTE3_MTE2>(event_t(i));
    CrossCoreSetFlag<0, PIPE_MTE3>(9);
    CrossCoreWaitFlag(9);
}

template <int STATIC_WORKERS = 0>
__global__ __mix__(1, 2)
    __attribute__((aligned(4096))) void Prepared(GM_ADDR x, GM_ADDR weight, GM_ADDR scale,
                                                 GM_ADDR groups, GM_ADDR y, GM_ADDR workspace,
                                                 GM_ADDR packedB, int M, int K, int N, int E,
                                                 int inputWorkers, int KP, int NP)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
    SetAtomicNone();
    const int workers = STATIC_WORKERS ? STATIC_WORKERS : inputWorkers;
    int core = GetBlockIdx();
    if ASCEND_IS_AIV
    {
        core /= GetSubBlockNum();
    }
    GlobalTensor<int8_t> a, b, pb;
    GlobalTensor<int64_t> g;
    GlobalTensor<int32_t> buffer;
    GlobalTensor<float> s;
    GlobalTensor<half> result;
    a.SetGlobalBuffer((__gm__ int8_t *)x);
    b.SetGlobalBuffer((__gm__ int8_t *)weight);
    pb.SetGlobalBuffer((__gm__ int8_t *)packedB);
    g.SetGlobalBuffer((__gm__ int64_t *)groups);
    buffer.SetGlobalBuffer((__gm__ int32_t *)workspace);
    s.SetGlobalBuffer((__gm__ float *)scale);
    result.SetGlobalBuffer((__gm__ half *)y);
    if ASCEND_IS_AIV
    {
        TPipe pipe;
        SetMaskNorm();
        SetVectorMask<uint8_t>(~uint64_t(0), ~uint64_t(0));
        LocalTensor<int64_t> ends(TPosition::VECCALC, 172032, 128);
        DataCopyPad(ends, g, DataCopyExtParams(1, E * 8, 0, 0, 0),
                    DataCopyPadExtParams<int64_t>{false, 0, 0, 0});
        SetFlag<HardEvent::MTE2_S>(EVENT_ID6);
        WaitFlag<HardEvent::MTE2_S>(EVENT_ID6);

        PrefetchFromGroups(b, ends, K, N, E, workers);
        SetFlag<HardEvent::MTE2_S>(EVENT_ID4);
        WaitFlag<HardEvent::MTE2_S>(EVENT_ID4);
        CrossCoreSetFlag<0, PIPE_MTE3>(7);
        CrossCoreWaitFlag(7);
        CrossCoreSetFlag<2, PIPE_MTE3>(4);
        CrossCoreSetFlag<2, PIPE_MTE2>(2);
        CrossCoreSetFlag<2, PIPE_MTE2>(3);
    }
    if ASCEND_IS_AIC
    {
        KMajorPackB<KR>(b, pb, g, K, N, E, KP, NP, workers);
        CrossCoreWaitFlag(4);
        Cube<MT, NT, false, LK, ST> cube;
        cube.Init();
        const int columns = (N + NT - 1) / NT;
        int previous = 0, base = 0, next = core, sequence = 0, aSequence = 0;
        for (int e = 0; e < E; ++e)
        {
            const int end = int(g.GetValue(e)), length = end - previous,
                      tiles = (length + MT - 1) / MT;
            while (next < base + tiles)
            {
                const int ri = next - base, row = previous + ri * MT,
                          rows = Min(MT, length - ri * MT);
                const int aSlot = aSequence++ % 2;
                cube.LoadA(a[int64_t(row) * K], rows, K, aSlot);
                for (int nc = 0; nc < columns; ++nc)
                {
                    const int col = ((nc + core) % columns) * NT, cols = Min(NT, N - col),
                              slot = sequence++ & 1;
                    cube.Compute(pb[int64_t(e) * KP * NP + int64_t(col) * 32],
                                 buffer[int64_t(core * 2 + slot) * MT * NT], rows, cols, K, NP,
                                 slot, aSlot, nc + 1 == columns);
                }
                next += workers;
            }
            previous = end;
            base += tiles;
        }
        cube.Finish();
    }
    if ASCEND_IS_AIV
    {
        TPipe pipe;
        SetMaskNorm();
        SetVectorMask<uint8_t>(~uint64_t(0), ~uint64_t(0));
        LocalTensor<int64_t> ends(TPosition::VECCALC, 172032, 128);
        DataCopyPad(ends, g, DataCopyExtParams(1, E * 8, 0, 0, 0),
                    DataCopyPadExtParams<int64_t>{false, 0, 0, 0});
        SetFlag<HardEvent::MTE2_S>(EVENT_ID6);
        WaitFlag<HardEvent::MTE2_S>(EVENT_ID6);
        SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
        LocalTensor<float> cachedScale(TPosition::VECCALC, ((MT + 1) / 2) * NT * 10 + 256, 2048);
        const int columns = (N + NT - 1) / NT;
        int previous = 0, base = 0, next = core, sequence = 0;
        for (int e = 0; e < E; ++e)
        {
            const int end = int(ends.GetValue(e)), length = end - previous,
                      tiles = (length + MT - 1) / MT;
            const bool reuseScale = next + workers < base + tiles;
            if (reuseScale)
                DataCopyPad(cachedScale, s[int64_t(e) * N], DataCopyExtParams(1, N * 4, 0, 0, 0),
                            DataCopyPadExtParams<float>{false, 0, 0, 0.0f});
            while (next < base + tiles)
            {
                const int ri = next - base, row = previous + ri * MT,
                          rows = Min(MT, length - ri * MT);
                for (int nc = 0; nc < columns; ++nc)
                {
                    const int col = ((nc + core) % columns) * NT, cols = Min(NT, N - col),
                              slot = sequence++ & 1;
                    CrossCoreWaitFlag(slot);
                    Activate<MT, NT>(buffer[int64_t(core * 2 + slot) * MT * NT], s, result, row,
                                     col, rows, cols, N, e, 1, slot, reuseScale);
                }
                next += workers;
            }
            previous = end;
            base += tiles;
        }
        WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
    }
}
inline bool Launch(GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR g, GM_ADDR y, int M, int K, int N,
                   int E, int cores, aclrtStream stream)
{
    const int KP = (K + 31) / 32 * 32, NP = (N + 31) / 32 * 32;
    if (K < 545 || K > 1280 || N <= NT || N > 2048 || 32 * N > 65535 || 32 * NP > 65535 ||
        M < cores * MT || M < E * 128 || 4 * KR * NP > 524032 ||
        size_t(E) * K * N + size_t(E) * KP * NP > (size_t(80) << 20))
        return false;
    const int workers = cores;
    const size_t cBytes = size_t(workers) * 2 * MT * NT * 4, bBytes = size_t(E) * KP * NP;
    Workspace memory(cBytes + bBytes, stream);
    if (!memory.Data())
        return true;
    if (workers == 20)
        Prepared<20><<<workers, nullptr, stream>>>(
            x, w, s, g, y, memory.Data(), memory.Data() + cBytes, M, K, N, E, workers, KP, NP);
    else
        Prepared<0><<<workers, nullptr, stream>>>(
            x, w, s, g, y, memory.Data(), memory.Data() + cBytes, M, K, N, E, workers, KP, NP);
    memory.Complete();
    return true;
}
}

namespace aggregate_lpt_prepare
{
using namespace AscendC;
using grouped_gelu::Min;
template <int KR>
__aicore__ inline void PackB(const GlobalTensor<int8_t> &src, const GlobalTensor<int8_t> &dst,
                             const GlobalTensor<int64_t> &groups, int K, int N, int E, int KP,
                             int NP, int workers)
{
    constexpr int STAGES = 4;
    const int batches = (K + KR - 1) / KR, span = KR * NP, blocks = NP / 32;
    int active[128], amount = 0, previous = 0;
    for (int e = 0; e < E; ++e)
    {
        const int end = int(groups.GetValue(e));
        if (end > previous)
            active[amount++] = e;
        previous = end;
    }
    LocalTensor<int8_t> tile(TPosition::A1, 0, STAGES * span);
    SetLoadDataPaddingValue<uint64_t>(0);
    for (int i = 0; i < STAGES; ++i)
        SetFlag<HardEvent::MTE3_MTE2>(event_t(i));
    struct Pending
    {
        int expert, first, count, slot;
    };
    Pending pending[STAGES - 1];
    int head = 0, queued = 0, producer = 0;
    for (int task = GetBlockIdx(); task < amount * batches; task += workers)
    {
        const int e = active[task / batches], first = task % batches * KR;
        const int count = Min(KR, K - first), slot = producer;
        WaitFlag<HardEvent::MTE3_MTE2>(event_t(slot));
        Nd2NzParams p;
        p.ndNum = 1;
        p.nValue = count;
        p.dValue = N;
        p.srcDValue = N;
        p.srcNdMatrixStride = 0;
        p.dstNzC0Stride = KR;
        p.dstNzNStride = 1;
        p.dstNzMatrixStride = 0;
        DataCopy(tile[slot * span], src[int64_t(e) * K * N + int64_t(first) * N], p);
        SetFlag<HardEvent::MTE2_MTE3>(event_t(slot));
        if (queued == STAGES - 1)
        {
            const Pending old = pending[head];
            WaitFlag<HardEvent::MTE2_MTE3>(event_t(old.slot));
            DataCopy(dst[int64_t(old.expert) * KP * NP + old.first * 32], tile[old.slot * span],
                     DataCopyParams(blocks, old.count, KR - old.count, KP - old.count));
            SetFlag<HardEvent::MTE3_MTE2>(event_t(old.slot));
            pending[head] = {e, first, count, slot};
            head = (head + 1) % (STAGES - 1);
        }
        else
            pending[(head + queued++) % (STAGES - 1)] = {e, first, count, slot};
        producer = (producer + 1) % STAGES;
    }
    while (queued)
    {
        const Pending old = pending[head];
        WaitFlag<HardEvent::MTE2_MTE3>(event_t(old.slot));
        DataCopy(dst[int64_t(old.expert) * KP * NP + old.first * 32], tile[old.slot * span],
                 DataCopyParams(blocks, old.count, KR - old.count, KP - old.count));
        SetFlag<HardEvent::MTE3_MTE2>(event_t(old.slot));
        head = (head + 1) % (STAGES - 1);
        --queued;
    }
    for (int i = 0; i < STAGES; ++i)
        WaitFlag<HardEvent::MTE3_MTE2>(event_t(i));
    CrossCoreSetFlag<0, PIPE_MTE3>(9);
    CrossCoreWaitFlag(9);
}

__aicore__ inline void PrepareVector(const GlobalTensor<int8_t> &a, const GlobalTensor<int8_t> &b,
                                     const GlobalTensor<int8_t> &pa, const GlobalTensor<int8_t> &pb,
                                     const LocalTensor<int64_t> &ends, int M, int K, int N, int E,
                                     int AP, int KP, int NP, int workers)
{
    // Prefetch scratch and tail zeros have distinct, bounded UB lifetimes.
    constexpr int CHUNK = 16384, STEP = 512;
    LocalTensor<int8_t> scratch(TPosition::VECCALC, 0, CHUNK * 2);
    int experts[128], active = 0, previous = 0;
    for (int e = 0; e < E; ++e)
    {
        const int end = int(ends.GetValue(e));
        if (end > previous)
            experts[active++] = e;
        previous = end;
    }
    if (active * 2 < E)
    {
        const int64_t expertBytes = int64_t(K) * N;
        const int chunks = int((expertBytes + CHUNK - 1) / CHUNK);
        int slot = 0;
        for (int task = GetBlockIdx(); task < active * chunks; task += workers * 2)
        {
            const int e = experts[task / chunks];
            const int64_t within = int64_t(task % chunks) * CHUNK,
                          off = (int64_t(e) * expertBytes + within) / 512 * 512;
            const int span = Min(CHUNK, int(expertBytes - within));
            const int blocks = span / 512;
            if (blocks)
                DataCopy(scratch[slot * CHUNK], b[off], DataCopyParams(blocks, 1, 512 / 32 - 1, 0));
            slot ^= 1;
        }
    }
    else
    {
        const int64_t total = int64_t(E) * K * N;
        int slot = 0;
        for (int64_t off = int64_t(GetBlockIdx()) * CHUNK; off < total; off += workers * 2 * CHUNK)
        {
            const int span = Min(CHUNK, int(total - off)), blocks = span / STEP;
            if (blocks)
                DataCopy(scratch[slot * CHUNK], b[off],
                         DataCopyParams(blocks, 1, STEP / 32 - 1, 0));
            slot ^= 1;
        }
    }
    SetFlag<HardEvent::MTE2_S>(EVENT_ID4);
    WaitFlag<HardEvent::MTE2_S>(EVENT_ID4);
    if (AP != K)
        grouped_gelu::PackRows(a, pa, M, K, AP, workers * 2);
    const int pad = KP - K, blocks = NP / 32;
    if (pad)
    {
        LocalTensor<uint16_t> zero(TPosition::VECCALC, 65536, pad * NP / 2);
        Duplicate(zero, uint16_t(0), pad * NP / 2);
        SetFlag<HardEvent::V_MTE3>(EVENT_ID4);
        WaitFlag<HardEvent::V_MTE3>(EVENT_ID4);
        for (int e = GetBlockIdx(); e < E; e += workers * 2)
            DataCopy(pb[int64_t(e) * KP * NP + K * 32], zero.ReinterpretCast<int8_t>(),
                     DataCopyParams(blocks, pad, 0, K));
    }
}

}

namespace aggregate_lpt_epilogue
{
using namespace AscendC;
using grouped_gelu::Min;
using grouped_gelu::Up;
using grouped_gelu::Gelu;
template <int MT, int NT, bool FULL_ROW = false, bool DYNAMIC = false> class PitchedEpilogue
{
    static constexpr int ROWS = (MT + 1) / 2;
    static constexpr int CHUNK_ROWS = ROWS < 8192 / NT ? ROWS : 8192 / NT;
    static constexpr int SIZE = CHUNK_ROWS * NT;
    static_assert(CHUNK_ROWS >= 1 && SIZE * 16 + NT * 8 + 256 <= 172032,
                  "pipelined epilogue overlaps group cache");
    LocalTensor<int32_t> accum{TPosition::VECCALC, 0, SIZE * 2};
    LocalTensor<float> temporary{TPosition::VECCALC, SIZE * 8 + 256, SIZE};
    LocalTensor<half> output{TPosition::VECCALC, SIZE * 12 + 256, SIZE * 2};
    LocalTensor<float> scales{TPosition::VECCALC, SIZE * 16 + 256, NT * 2};

    struct Pending
    {
        int index, rows, cols, row, col, N, gmSlot, pitch;
        GM_ADDR destination;
        bool lastChunk;
    };
    Pending pending;
    bool initialized = false, hasPending = false;
    int producer = 0;

    __aicore__ inline void Init()
    {

        SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
        SetFlag<HardEvent::V_MTE2>(EVENT_ID1);
        SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
        SetFlag<HardEvent::MTE3_V>(EVENT_ID1);
        initialized = true;
    }

    __aicore__ inline void Consume(const Pending &p)
    {
        const event_t event = p.index ? EVENT_ID1 : EVENT_ID0;
        WaitFlag<HardEvent::MTE2_V>(event);

        auto input = accum[p.index * SIZE];
        auto z = input.template ReinterpretCast<float>();
        auto localScale = scales[p.index * NT];
        auto out = output[p.index * SIZE];
        Cast(z, input, RoundMode::CAST_RINT, p.rows * p.pitch);
        PipeBarrier<PIPE_V>();
        for (int r = 0; r < p.rows; r += 128)
            for (int c = 0; c < p.pitch; c += 64)
            {
                const int width = Min(64, p.pitch - c);
                Mul(z[r * p.pitch + c], z[r * p.pitch + c], localScale[c], width,
                    Min(128, p.rows - r), {1, 1, 1, uint8_t(p.pitch / 8), uint8_t(p.pitch / 8), 0});
            }
        PipeBarrier<PIPE_V>();
        WaitFlag<HardEvent::MTE3_V>(event);
        Gelu(z, temporary, out, p.rows * p.pitch);
        SetFlag<HardEvent::V_MTE3>(event);
        WaitFlag<HardEvent::V_MTE3>(event);
        GlobalTensor<half> destination;
        destination.SetGlobalBuffer((__gm__ half *)p.destination);
        if (p.cols == p.pitch && p.N == p.pitch)
            DataCopy(destination[int64_t(p.row) * p.N + p.col], out, p.rows * p.pitch);
        else
            DataCopyPad(destination[int64_t(p.row) * p.N + p.col], out,
                        DataCopyExtParams(p.rows, p.cols * 2, (p.pitch - Up(p.cols, 16)) / 16,
                                          (p.N - p.cols) * 2, 0));
        SetFlag<HardEvent::MTE3_V>(event);
        SetFlag<HardEvent::V_MTE2>(event);
    }

    __aicore__ inline void Flush()
    {
        if (hasPending)
        {
            Consume(pending);
            hasPending = false;
        }
    }

  public:
    __aicore__ inline ~PitchedEpilogue()
    {
        if (initialized)
        {
            Flush();
            WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
            WaitFlag<HardEvent::V_MTE2>(EVENT_ID1);
            WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
            WaitFlag<HardEvent::MTE3_V>(EVENT_ID1);
        }
    }

    __aicore__ inline void Run(const GlobalTensor<int32_t> &src, const GlobalTensor<float> &scale,
                               const GlobalTensor<half> &y, int row, int col, int rows, int cols,
                               int N, int expert, int shards = 1, int slot = 0)
    {
        const int pitch = FULL_ROW
                              ? Up(N, 32)
                              : (DYNAMIC ? Up(cols, 32) : (Up(rows, 16) < 32 ? NT : Up(cols, 32)));
        const int first = GetSubBlockIdx() * ((rows + 1) / 2);
        const int valid = GetSubBlockIdx() ? rows / 2 : (rows + 1) / 2;
        if (valid <= 0)
        {

            Flush();
            CrossCoreSetFlag<2, PIPE_MTE2>(2 + slot);
            return;
        }
        if (!initialized)
            Init();
        const int chunkRows = FULL_ROW ? SIZE / pitch : CHUNK_ROWS;
        for (int offset = 0; offset < valid; offset += chunkRows)
        {
            const int index = producer;
            const event_t event = index ? EVENT_ID1 : EVENT_ID0;
            const int count = Min(chunkRows, valid - offset);
            WaitFlag<HardEvent::V_MTE2>(event);
            DataCopy(accum[index * SIZE], src[(first + offset) * pitch], count * pitch);
            if (offset + count == valid)
                CrossCoreSetFlag<2, PIPE_MTE2>(2 + slot);
            if (cols == NT && (N == NT || cols % 16 == 0))
                DataCopy(scales[index * NT], scale[expert * N + col], cols);
            else
                DataCopyPad(scales[index * NT], scale[expert * N + col],
                            DataCopyExtParams(1, cols * 4, 0, 0, 0),
                            DataCopyPadExtParams<float>{false, 0, 0, 0.0f});
            SetFlag<HardEvent::MTE2_V>(event);
            Flush();
            pending = {index, count, cols,  row + first + offset,    col,
                       N,     slot,  pitch, (GM_ADDR)y.GetPhyAddr(), offset + count == valid};
            hasPending = true;
            producer ^= 1;
        }
    }
};
}

namespace aggregate_lpt
{
using namespace AscendC;
using grouped_gelu::Min;
using grouped_gelu::Up;
using grouped_gelu::Workspace;

template <int MT, int NT, int OT, int AK, int BK> class Cube
{
    static constexpr int FK = 256, STAGES = 3, APANEL = MT * AK, BPANEL = NT * FK, CPANEL = MT * OT;
    static constexpr int CSLOTS = 131072 / (CPANEL * 4);
    static_assert(MT * BK <= 65536 && 2 * NT * FK <= 65536, "L0 capacity exceeded");
    static_assert(APANEL + STAGES * BPANEL <= 524288, "L1 capacity exceeded");
    static_assert(CSLOTS >= 1 && CSLOTS <= 4, "L0C capacity exceeded");
    LocalTensor<int8_t> aL1{TPosition::A1, 0, APANEL};
    LocalTensor<int8_t> bL1{TPosition::A1, APANEL, STAGES * BPANEL};
    LocalTensor<int8_t> a0{TPosition::A2, 0, MT * BK};
    LocalTensor<int8_t> b0{TPosition::B2, 0, 2 * NT * FK};
    LocalTensor<int32_t> c0{TPosition::CO1, 0, CSLOTS * CPANEL};
    struct Pending
    {
        int slot, rows, cols, depth, nsub, wideCols, outputSlot, cslot, aFragment;
        GM_ADDR output;
        bool initialize, finish;
    };
    Pending pending[2];
    int head = 0, amount = 0, producer = 0, bFragment = 0;
    bool aReady = false;

    __aicore__ inline void Consume(const Pending &p)
    {
        const int m = Up(p.rows, 16), n = m < 32 ? NT : Up(p.cols, 32), k = p.depth;
        if (p.initialize && p.nsub == 0)
            WaitFlag<HardEvent::FIX_M>(p.cslot);
        WaitFlag<HardEvent::MTE2_MTE1>(p.slot);
        const int bs = bFragment;
        WaitFlag<HardEvent::M_MTE1>(bs);
        auto lb = bL1[p.slot * BPANEL], bb = b0[bs * NT * FK];
        LoadData2dTransposeParams pb;
        pb.startIndex = 0;
        pb.dstFracGap = 0;
        if (k > Up(p.cols, 32))
        {
            pb.repeatTimes = k / 32;
            pb.srcStride = 1;
            pb.dstGap = 2 * (n / 32) - 1;
            for (int ni = 0; ni < (p.cols + 31) / 32; ++ni)
                LoadDataWithTranspose(bb[ni * 1024], lb[ni * FK * 32], pb);
        }
        else
        {
            pb.repeatTimes = (p.cols + 31) / 32;
            pb.srcStride = FK / 32;
            pb.dstGap = 1;
            for (int ki = 0; ki < k / 32; ++ki)
                LoadDataWithTranspose(bb[ki * n * 32], lb[ki * 1024], pb);
        }
        SetFlag<HardEvent::MTE1_M>(bs);
        WaitFlag<HardEvent::MTE1_M>(bs);
        auto c = c0[p.cslot * CPANEL];
        MmadParams mm;
        mm.m = m;
        mm.n = n;
        mm.k = k;
        mm.cmatrixInitVal = p.initialize;
        mm.unitFlag = 0;
        Mmad(c[p.nsub * m], a0[p.aFragment * MT * FK], bb, mm);
        if (m * n < 2560)
            PipeBarrier<PIPE_M>();
        SetFlag<HardEvent::M_MTE1>(bs);
        bFragment ^= 1;
        SetFlag<HardEvent::MTE1_MTE2>(p.slot);
        if (p.finish)
        {
            SetFlag<HardEvent::M_FIX>(p.cslot);
            WaitFlag<HardEvent::M_FIX>(p.cslot);
            CrossCoreWaitFlag(2 + p.outputSlot);
            GlobalTensor<int32_t> dst;
            dst.SetGlobalBuffer((__gm__ int32_t *)p.output);
            FixpipeParamsV220 fp;
            fp.nSize = Up(p.wideCols, 32);
            fp.mSize = p.rows;
            fp.srcStride = m;
            fp.dstStride = Up(p.wideCols, 32);
            fp.quantPre = QuantMode_t::NoQuant;
            fp.reluEn = false;
            fp.unitFlag = 0;
            Fixpipe<int32_t, int32_t, CFG_ROW_MAJOR>(dst, c, fp);
            SetFlag<HardEvent::FIX_M>(p.cslot);
            CrossCoreSetFlag<2, PIPE_FIX>(p.outputSlot);
        }
    }

  public:
    __aicore__ inline void Init()
    {
        SetLoadDataPaddingValue<uint64_t>(0);
        SetFixpipeNz2ndFlag(1, 0, 0);
        for (int i = 0; i < STAGES; ++i)
            SetFlag<HardEvent::MTE1_MTE2>(i);
        SetFlag<HardEvent::M_MTE1>(EVENT_ID0);
        SetFlag<HardEvent::M_MTE1>(EVENT_ID1);
        SetFlag<HardEvent::M_MTE1>(EVENT_ID2);
        SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID3);
        for (int i = 0; i < CSLOTS; ++i)
            SetFlag<HardEvent::FIX_M>(i);
    }
    __aicore__ inline void LoadA(const GlobalTensor<int8_t> &src, int rows, int K, int AP)
    {
        WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID3);
        Nd2NzParams p;
        p.ndNum = 1;
        p.nValue = rows;
        p.dValue = K;
        p.srcNdMatrixStride = 0;
        p.srcDValue = AP;
        p.dstNzC0Stride = MT;
        p.dstNzNStride = 1;
        p.dstNzMatrixStride = 0;
        if (AP % 4 == 0)
        {
            GlobalTensor<float> wide;
            wide.SetGlobalBuffer((__gm__ float *)src.GetPhyAddr());
            p.dValue = (K + 3) / 4;
            p.srcDValue = AP / 4;
            DataCopy(aL1.template ReinterpretCast<float>(), wide, p);
        }
        else
            DataCopy(aL1, src, p);
        SetFlag<HardEvent::MTE2_MTE1>(EVENT_ID3);
        aReady = false;
    }
    __aicore__ inline void LoadA0(int rows, int start, int depth)
    {
        WaitFlag<HardEvent::M_MTE1>(EVENT_ID2);
        if (!aReady)
        {
            WaitFlag<HardEvent::MTE2_MTE1>(EVENT_ID3);
            aReady = true;
        }
        LoadData2DParams pa;
        pa.startIndex = 0;
        pa.srcStride = MT / 16;
        pa.dstGap = 0;
        pa.ifTranspose = false;
        pa.sid = 0;
        pa.addrMode = 0;
        for (int f = 0; f < depth; f += FK)
        {
            const int fk = Min(FK, depth - f);
            pa.repeatTimes = fk / 32;
            for (int mi = 0; mi < (rows + 15) / 16; ++mi)
                LoadData(a0[(f / FK) * MT * FK + mi * fk * 16], aL1[(start + f) * MT + mi * 512],
                         pa);
        }
        SetFlag<HardEvent::MTE1_M>(EVENT_ID2);
        WaitFlag<HardEvent::MTE1_M>(EVENT_ID2);
    }
    __aicore__ inline void Compute(const GlobalTensor<int8_t> &b, const GlobalTensor<int32_t> &dst,
                                   int rows, int cols, int depth, int KP, int nsub, int wideCols,
                                   int outputSlot, int cslot, bool initialize, bool finish)
    {
        for (int f = 0; f < depth; f += FK)
        {
            const int slot = producer, fk = Min(FK, depth - f);
            WaitFlag<HardEvent::MTE1_MTE2>(slot);
            DataCopy(bL1[slot * BPANEL], b[f * 32],
                     DataCopyParams((cols + 31) / 32, fk, KP - fk, FK - fk));
            SetFlag<HardEvent::MTE2_MTE1>(slot);
            if (amount == 2)
            {
                Consume(pending[head]);
                head ^= 1;
                --amount;
            }
            pending[(head + amount) & 1] = {slot,
                                            rows,
                                            cols,
                                            fk,
                                            nsub,
                                            wideCols,
                                            outputSlot,
                                            cslot,
                                            f / FK,
                                            (GM_ADDR)dst.GetPhyAddr(),
                                            initialize && f == 0,
                                            finish && f + FK >= depth};
            ++amount;
            producer = producer + 1 < STAGES ? producer + 1 : 0;
        }
    }
    __aicore__ inline void EndPhase()
    {
        while (amount)
        {
            Consume(pending[head]);
            head ^= 1;
            --amount;
        }
        SetFlag<HardEvent::M_MTE1>(EVENT_ID2);
    }
    __aicore__ inline void EndRow()
    {
        SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID3);
    }
    __aicore__ inline void Finish()
    {
        for (int i = 0; i < STAGES; ++i)
            WaitFlag<HardEvent::MTE1_MTE2>(i);
        WaitFlag<HardEvent::M_MTE1>(EVENT_ID0);
        WaitFlag<HardEvent::M_MTE1>(EVENT_ID1);
        WaitFlag<HardEvent::M_MTE1>(EVENT_ID2);
        WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID3);
        for (int i = 0; i < CSLOTS; ++i)
            WaitFlag<HardEvent::FIX_M>(i);
    }
};

constexpr int ROW_LIMIT = 1152, ROW_HEAD = 64;
template <int MT, bool FIXED>
__aicore__ inline void BuildRows(const LocalTensor<int64_t> &ends,
                                 const GlobalTensor<uint64_t> &destination, int E, int workers)
{
    LocalTensor<uint64_t> table(TPosition::VECCALC, 135168, ROW_HEAD + 2 * ROW_LIMIT);
    int starts[128], lengths[128], counts[64] = {}, offsets[64], heap[64], loads[64] = {};
    int previous = 0, total = 0;
    for (int e = 0; e < E; ++e)
    {
        const int end = int(ends.GetValue(e));
        starts[e] = previous;
        lengths[e] = end - previous;
        total += (lengths[e] + MT - 1) / MT;
        previous = end;
    }
    for (int i = 0; i < workers; ++i)
        heap[i] = i;
    int written = 0;
    for (int r = MT; r >= 16; r -= 16)
    {
        const int cost = r + (FIXED ? 64 : 0);
        for (int e = 0; e < E; ++e)
        {
            const int full = lengths[e] / MT, tail = lengths[e] % MT;
            const int first = r == MT ? 0 : full, stop = full + int(tail && Up(tail, 16) == r);
            for (int ri = first; ri < stop; ++ri)
            {
                const int owner = heap[0], row = starts[e] + ri * MT,
                          rows = Min(MT, lengths[e] - ri * MT);
                const uint64_t value = uint64_t(row) | (uint64_t(rows) << 16) |
                                       (uint64_t(e) << 24) | (uint64_t(owner) << 56);
                table.SetValue(ROW_HEAD + ROW_LIMIT + written++, value);
                ++counts[owner];
                loads[owner] += cost;
                int node = 0;
                while (2 * node + 1 < workers)
                {
                    int child = 2 * node + 1;
                    if (child + 1 < workers && (loads[heap[child + 1]] < loads[heap[child]] ||
                                                (loads[heap[child + 1]] == loads[heap[child]] &&
                                                 heap[child + 1] < heap[child])))
                        ++child;
                    if (loads[owner] < loads[heap[child]] ||
                        (loads[owner] == loads[heap[child]] && owner < heap[child]))
                        break;
                    heap[node] = heap[child];
                    node = child;
                }
                heap[node] = owner;
            }
        }
    }
    int prefix = 0;
    for (int i = 0; i < workers; ++i)
    {
        offsets[i] = prefix;
        table.SetValue(i, uint64_t(prefix) | (uint64_t(counts[i]) << 32));
        prefix += counts[i];
    }
    for (int i = workers; i < ROW_HEAD; ++i)
        table.SetValue(i, uint64_t(0));
    for (int i = 0; i < total; ++i)
    {
        const uint64_t value = table.GetValue(ROW_HEAD + ROW_LIMIT + i);
        const int owner = value >> 56;
        table.SetValue(ROW_HEAD + offsets[owner]++, value & 0x00ffffffffffffffULL);
    }
    for (int i = ROW_HEAD + total; i < Up(ROW_HEAD + total, 4); ++i)
        table.SetValue(i, uint64_t(0));
    SetFlag<HardEvent::S_MTE3>(EVENT_ID5);
    WaitFlag<HardEvent::S_MTE3>(EVENT_ID5);
    DataCopy(destination, table, Up(ROW_HEAD + total, 4));
    SetFlag<HardEvent::MTE3_S>(EVENT_ID5);
    WaitFlag<HardEvent::MTE3_S>(EVENT_ID5);
}

template <int MT, int NT, int OT, int AK, int BK, int KR, int ALIGN_A>
__global__ __mix__(1, 2)
    __attribute__((aligned(4096))) void Run(GM_ADDR x, GM_ADDR weight, GM_ADDR scale,
                                            GM_ADDR groups, GM_ADDR y, GM_ADDR workspace,
                                            GM_ADDR metadata, GM_ADDR packedA, GM_ADDR packedB,
                                            int M, int K, int N, int E, int workers, int AP, int KP,
                                            int NP)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
    SetAtomicNone();
    int core = GetBlockIdx();
    if ASCEND_IS_AIV
    {
        core /= GetSubBlockNum();
    }
    GlobalTensor<int8_t> a, b, pa, pb;
    GlobalTensor<int64_t> g;
    GlobalTensor<float> s;
    GlobalTensor<int32_t> buffer;
    GlobalTensor<half> out;
    GlobalTensor<uint64_t> tasks;
    tasks.SetGlobalBuffer((__gm__ uint64_t *)metadata);
    a.SetGlobalBuffer((__gm__ int8_t *)x);
    b.SetGlobalBuffer((__gm__ int8_t *)weight);
    pa.SetGlobalBuffer((__gm__ int8_t *)packedA);
    pb.SetGlobalBuffer((__gm__ int8_t *)packedB);
    g.SetGlobalBuffer((__gm__ int64_t *)groups);
    s.SetGlobalBuffer((__gm__ float *)scale);
    buffer.SetGlobalBuffer((__gm__ int32_t *)workspace);
    out.SetGlobalBuffer((__gm__ half *)y);
    if ASCEND_IS_AIV
    {
        TPipe pipe;
        SetMaskNorm();
        SetVectorMask<uint8_t>(~uint64_t(0), ~uint64_t(0));
        if (GetBlockIdx() == 0)
        {
            LocalTensor<int64_t> ends(TPosition::VECCALC, 192512, 128);
            DataCopyPad(ends, g, DataCopyExtParams(1, E * 8, 0, 0, 0),
                        DataCopyPadExtParams<int64_t>{false, 0, 0, 0});
            SetFlag<HardEvent::MTE2_S>(EVENT_ID6);
            WaitFlag<HardEvent::MTE2_S>(EVENT_ID6);
            BuildRows<MT, false>(ends, tasks, E, workers);
        }
        LocalTensor<int64_t> ends(TPosition::VECCALC, 192512, 128);
        DataCopyPad(ends, g, DataCopyExtParams(1, E * 8, 0, 0, 0),
                    DataCopyPadExtParams<int64_t>{false, 0, 0, 0});
        SetFlag<HardEvent::MTE2_S>(EVENT_ID6);
        WaitFlag<HardEvent::MTE2_S>(EVENT_ID6);
        aggregate_lpt_prepare::PrepareVector(a, b, pa, pb, ends, M, K, N, E, AP, KP, NP, workers);
        CrossCoreSetFlag<0, PIPE_MTE3>(10);
        CrossCoreWaitFlag(10);
        CrossCoreSetFlag<2, PIPE_MTE3>(8);
        CrossCoreSetFlag<2, PIPE_MTE2>(2);
        CrossCoreSetFlag<2, PIPE_MTE2>(3);
    }
    if (AP != K)
        a.SetGlobalBuffer((__gm__ int8_t *)packedA);
    constexpr int CSLOTS = 131072 / (MT * OT * 4);
    const int columns = (N + OT - 1) / OT, mainK = Min(BK, KP), tailK = KP - mainK;
    int next = core, base = 0, previous = 0, sequence = 0;
    if ASCEND_IS_AIC
    {
        aggregate_lpt_prepare::PackB<KR>(b, pb, g, K, N, E, KP, NP, workers);
        CrossCoreWaitFlag(8);
        Cube<MT, NT, OT, AK, BK> cube;
        cube.Init();
        const uint64_t header = tasks.GetValue(core);
        const int first = uint32_t(header), count = int(header >> 32);
        for (int task = 0; task < count; ++task)
        {
            const uint64_t descriptor = tasks.GetValue(ROW_HEAD + first + task);
            const int row = descriptor & 65535, rows = (descriptor >> 16) & 255,
                      e = (descriptor >> 24) & 127;
            cube.LoadA(a[int64_t(row) * AP], rows, K, AP);
            if (tailK == 0)
            {
                cube.LoadA0(rows, 0, mainK);
                for (int group = 0; group < columns; ++group)
                {
                    const int col = group * OT, wideCols = Min(OT, N - col),
                              cslot = sequence % CSLOTS, slot = sequence++ & 1;
                    for (int ns = 0; ns < wideCols; ns += NT)
                    {
                        const int cols = Min(NT, wideCols - ns);
                        cube.Compute(pb[int64_t(e) * KP * NP + int64_t((col + ns) / 32) * KP * 32],
                                     buffer[int64_t(core * 2 + slot) * MT * OT], rows, cols, mainK,
                                     KP, ns, wideCols, slot, cslot, true, ns + NT >= wideCols);
                    }
                }
                cube.EndPhase();
            }
            else
            {
                for (int first = 0; first < columns; first += CSLOTS)
                {
                    const int batch = Min(CSLOTS, columns - first);
                    cube.LoadA0(rows, 0, mainK);
                    for (int i = 0; i < batch; ++i)
                    {
                        const int col = (first + i) * OT, wideCols = Min(OT, N - col),
                                  slot = (sequence + i) & 1;
                        for (int ns = 0; ns < wideCols; ns += NT)
                            cube.Compute(
                                pb[int64_t(e) * KP * NP + int64_t((col + ns) / 32) * KP * 32],
                                buffer[int64_t(core * 2 + slot) * MT * OT], rows,
                                Min(NT, wideCols - ns), mainK, KP, ns, wideCols, slot,
                                (sequence + i) % CSLOTS, true, false);
                    }
                    cube.EndPhase();
                    cube.LoadA0(rows, mainK, tailK);
                    for (int i = 0; i < batch; ++i)
                    {
                        const int col = (first + i) * OT, wideCols = Min(OT, N - col),
                                  slot = (sequence + i) & 1;
                        for (int ns = 0; ns < wideCols; ns += NT)
                            cube.Compute(pb[int64_t(e) * KP * NP +
                                            int64_t((col + ns) / 32) * KP * 32 + mainK * 32],
                                         buffer[int64_t(core * 2 + slot) * MT * OT], rows,
                                         Min(NT, wideCols - ns), tailK, KP, ns, wideCols, slot,
                                         (sequence + i) % CSLOTS, false, ns + NT >= wideCols);
                    }
                    cube.EndPhase();
                    sequence += batch;
                }
            }
            cube.EndRow();
        }
        cube.Finish();
    }
    if ASCEND_IS_AIV
    {
        TPipe pipe;
        SetMaskNorm();
        SetVectorMask<uint8_t>(~uint64_t(0), ~uint64_t(0));
        aggregate_lpt_epilogue::PitchedEpilogue<MT, OT, false, true> epilogue;
        LocalTensor<uint64_t> table(TPosition::VECCALC, 172032, ROW_LIMIT);
        DataCopyPad(table, tasks[core], DataCopyExtParams(1, 8, 0, 0, 0),
                    DataCopyPadExtParams<uint64_t>{false, 0, 0, 0});
        SetFlag<HardEvent::MTE2_S>(EVENT_ID6);
        WaitFlag<HardEvent::MTE2_S>(EVENT_ID6);
        const uint64_t header = table.GetValue(0);
        const int first = uint32_t(header), count = int(header >> 32);
        if (count)
        {
            DataCopyPad(table, tasks[ROW_HEAD + first], DataCopyExtParams(1, count * 8, 0, 0, 0),
                        DataCopyPadExtParams<uint64_t>{false, 0, 0, 0});
            SetFlag<HardEvent::MTE2_S>(EVENT_ID6);
            WaitFlag<HardEvent::MTE2_S>(EVENT_ID6);
        }
        for (int task = 0; task < count; ++task)
        {
            const uint64_t descriptor = table.GetValue(task);
            const int row = descriptor & 65535, rows = (descriptor >> 16) & 255,
                      e = (descriptor >> 24) & 127;
            for (int group = 0; group < columns; ++group)
            {
                const int col = group * OT, slot = sequence++ & 1;
                CrossCoreWaitFlag(slot);
                epilogue.Run(buffer[int64_t(core * 2 + slot) * MT * OT], s, out, row, col, rows,
                             Min(OT, N - col), N, e, 1, slot);
            }
        }
    }
}

template <int MT, int NT, int OT, int AK, int BK, int KR, int ALIGN_A = 0>
inline bool Launch(GM_ADDR x, GM_ADDR b, GM_ADDR s, GM_ADDR g, GM_ADDR y, int M, int K, int N,
                   int E, int cores, aclrtStream stream)
{
    const int workers = std::min(cores, (M + MT - 1) / MT + E - 1);
    const int KP = (K + 31) / 32 * 32, NP = (N + 31) / 32 * 32;
    int AP = K;
    if constexpr (ALIGN_A > 0)
        AP = (K + ALIGN_A - 1) / ALIGN_A * ALIGN_A;
    if (cores > ROW_HEAD || (M + MT - 1) / MT + E - 1 > ROW_LIMIT || KP > AK || KP > 2 * BK ||
        4 * KR * NP > 524288)
        return false;
    const size_t cBytes = size_t(workers) * 2 * MT * OT * 4, aBytes = AP == K ? 0 : size_t(M) * AP;
    const size_t bBytes = size_t(E) * KP * NP;
    if (aBytes + bBytes > (size_t(96) << 20))
        return false;
    const size_t tableBytes = ((ROW_HEAD + ROW_LIMIT) * 8 + 511) / 512 * 512;
    Workspace memory(cBytes + tableBytes + aBytes + bBytes, stream);
    if (!memory.Data())
        return false;
    GM_ADDR base = memory.Data();
    Run<MT, NT, OT, AK, BK, KR, ALIGN_A><<<workers, nullptr, stream>>>(
        x, b, s, g, y, base, base + cBytes, base + cBytes + tableBytes,
        base + cBytes + tableBytes + aBytes, M, K, N, E, workers, AP, KP, NP);
    memory.Complete();
    return true;
}
}

namespace balanced_full_a
{
using namespace AscendC;
using grouped_gelu::Min;
using grouped_gelu::Up;
using grouped_gelu::LoadInt32Rows;
using shallow_wide::Gelu;
using grouped_gelu::Workspace;
template <int MT, int NT, bool SPLIT, int LK = 256, int NSTAGES = 3>
using Cube = full_a_prepare::Cube<MT, NT, SPLIT, LK, NSTAGES, true>;

template <int MT, int NT, bool KEEP_LAYOUT = false> class EpilogueSequential
{
    static constexpr int ROWS = (MT + 1) / 2;
    static constexpr int SIZE = ROWS * NT;
    static constexpr int UB_SHIFT = KEEP_LAYOUT ? 0 : 256;
    static_assert(SIZE * 10 + 2048 * 4 + UB_SHIFT <= 172032, "UB capacity exceeded");
    LocalTensor<int32_t> accum{TPosition::VECCALC, 0, SIZE};
    LocalTensor<float> temporary{TPosition::VECCALC, SIZE * 4 + UB_SHIFT, SIZE};
    LocalTensor<half> output{TPosition::VECCALC, SIZE * 8 + UB_SHIFT, SIZE};

    LocalTensor<float> expandedScales{TPosition::VECCALC, SIZE * 10 + UB_SHIFT + 2048 * 4, SIZE};
    static_assert(SIZE * 14 + UB_SHIFT + 2048 * 4 <= 172032, "UB capacity exceeded");

  public:
    __aicore__ inline void PreloadScales(const GlobalTensor<float> &scale, int N, int expert,
                                         int col, int cols, bool reuseScale)
    {
        const int pitch = Up(cols, 16);
        LocalTensor<float> scales(TPosition::VECCALC,
                                  SIZE * 10 + UB_SHIFT + (reuseScale ? col * 4 : 0), pitch);
        SetFlag<HardEvent::V_MTE2>(EVENT_ID3);
        WaitFlag<HardEvent::V_MTE2>(EVENT_ID3);
        if (!reuseScale)
            DataCopyPad(scales, scale[expert * N + col], DataCopyExtParams(1, cols * 4, 0, 0, 0),
                        DataCopyPadExtParams<float>{false, 0, 0, 0.0f});
        SetFlag<HardEvent::MTE2_V>(EVENT_ID3);
        WaitFlag<HardEvent::MTE2_V>(EVENT_ID3);
        for (int c = 0; c < pitch; c += 64)
            Copy(expandedScales[c], scales[c], Min(64, pitch - c), ROWS,
                 {1, 1, uint8_t(pitch / 8), 0});
        PipeBarrier<PIPE_V>();
    }
    __aicore__ inline void Run(const GlobalTensor<int32_t> &src, const GlobalTensor<float> &scale,
                               const GlobalTensor<half> &y, int row, int col, int rows, int cols,
                               int N, int expert, int inputPitch, int shards = 1, int slot = 0,
                               bool reuseScale = false)
    {
        const int pitch = Up(cols, 16);
        LocalTensor<float> scales(TPosition::VECCALC,
                                  SIZE * 10 + UB_SHIFT + (reuseScale ? col * 4 : 0), pitch);
        const int first = GetSubBlockIdx() * ((rows + 1) / 2);
        const int valid = GetSubBlockIdx() ? rows / 2 : (rows + 1) / 2;
        if (valid <= 0)
        {
            if (shards == 1)
                CrossCoreSetFlag<2, PIPE_MTE2>(2 + slot);
            return;
        }
        LoadInt32Rows(accum, src[first * inputPitch], valid, cols, inputPitch, pitch);
        SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
        WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
        for (int s = 1; s < shards; ++s)
        {
            auto part = temporary.template ReinterpretCast<int32_t>();
            LoadInt32Rows(part, src[s * MT * inputPitch + first * inputPitch], valid, cols,
                          inputPitch, pitch);
            SetFlag<HardEvent::MTE2_V>(EVENT_ID1);
            WaitFlag<HardEvent::MTE2_V>(EVENT_ID1);
            Add(accum, accum, part, valid * pitch);
            SetFlag<HardEvent::V_MTE2>(EVENT_ID1);
            WaitFlag<HardEvent::V_MTE2>(EVENT_ID1);
        }
        if (shards == 1)
            CrossCoreSetFlag<2, PIPE_MTE2>(2 + slot);
        auto z = accum.template ReinterpretCast<float>();
        Cast(z, accum, RoundMode::CAST_RINT, valid * pitch);
        PipeBarrier<PIPE_V>();

        Mul(z, z, expandedScales, valid * pitch);
        PipeBarrier<PIPE_V>();
        Gelu(z, temporary, output, valid * pitch);
        const bool compact =
            N == cols && col == 0 && N < pitch && N <= 64 && N % 16 != 0 && valid >= 16;
        auto packed = temporary.template ReinterpretCast<half>();
        if (compact)
        {

            const int count = valid * N;
            PipeBarrier<PIPE_V>();
            CreateVecIndex(accum, int32_t(0), count);
            PipeBarrier<PIPE_V>();
            Cast(temporary, accum, RoundMode::CAST_RINT, count);
            PipeBarrier<PIPE_V>();
            Muls(temporary, temporary, 1.0f / N, count);
            PipeBarrier<PIPE_V>();

            Adds(temporary, temporary, 0.0001f, count);
            PipeBarrier<PIPE_V>();
            auto rows = temporary.template ReinterpretCast<int32_t>();
            Cast(rows, temporary, RoundMode::CAST_FLOOR, count);
            PipeBarrier<PIPE_V>();
            Muls(rows, rows, int32_t(2 * (pitch - N)), count);
            Muls(accum, accum, int32_t(2), count);
            PipeBarrier<PIPE_V>();
            Add(accum, accum, rows, count);
            PipeBarrier<PIPE_V>();
            Gather(packed, output, accum.template ReinterpretCast<uint32_t>(), 0, count);
        }
        SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
        WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
        if (compact)
            DataCopyPad(y[int64_t(row + first) * N], packed,
                        DataCopyExtParams(1, valid * N * 2, 0, 0, 0));
        else if (valid == ROWS && cols == pitch && N == pitch)
            DataCopy(y[int64_t(row + first) * N + col], output, valid * pitch);
        else
            DataCopyPad(
                y[int64_t(row + first) * N + col], output,
                DataCopyExtParams(valid, cols * 2, (pitch - Up(cols, 16)) / 16, (N - cols) * 2, 0));
        SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
        SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
        WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
    }
};

template <int MT, int NT>
__aicore__ inline void Activate(const GlobalTensor<int32_t> &src, const GlobalTensor<float> &scale,
                                const GlobalTensor<half> &y, int row, int col, int rows, int cols,
                                int N, int expert, int shards, int slot, bool reuseScale)
{
    const int width = Up(cols, 32);
    EpilogueSequential<MT, NT> epilogue;
    epilogue.Run(src, scale, y, row, col, rows, cols, N, expert, width, shards, slot, reuseScale);
}

constexpr int MT = 64, NT = 256, LK = 384, ST = 3, KR = 64;

__aicore__ inline void PrefetchFromGroups(const GlobalTensor<int8_t> &b,
                                          const LocalTensor<int64_t> &groups, int K, int N, int E,
                                          int workers)
{
    constexpr int CHUNK = 16384, STEP = 512;
    const int64_t bytes = int64_t(K) * N, total = int64_t(E) * bytes;
    LocalTensor<int8_t> scratch(TPosition::VECCALC, 0, 2 * CHUNK);
    int slot = 0;
    for (int64_t off = int64_t(GetBlockIdx()) * CHUNK; off < total; off += workers * 2 * CHUNK)
    {
        const int span = Min(CHUNK, int(total - off));
        const int first = int(off / bytes), last = int((off + span - 1) / bytes);
        bool needed = false;
        for (int e = first; e <= last; ++e)
            if (groups.GetValue(e) > (e ? groups.GetValue(e - 1) : 0))
                needed = true;
        if (!needed)
            continue;
        const int blocks = span / STEP;
        if (blocks)
            DataCopy(scratch[slot * CHUNK], b[off], DataCopyParams(blocks, 1, STEP / 32 - 1, 0));
        if (span % STEP >= 32)
            DataCopy(scratch[slot * CHUNK + blocks * 32], b[off + blocks * STEP], 32);
        slot ^= 1;
    }
}

template <int KR>
__aicore__ inline void KMajorPackB(const GlobalTensor<int8_t> &src, const GlobalTensor<int8_t> &dst,
                                   const GlobalTensor<int64_t> &groups, int K, int N, int E, int KP,
                                   int NP, int workers)
{
    constexpr int STAGES = 4;
    const int batches = (K + KR - 1) / KR, span = KR * NP, blocks = NP / 32;
    int active[128], amount = 0, previous = 0;
    for (int e = 0; e < E; ++e)
    {
        const int end = int(groups.GetValue(e));
        if (end > previous)
            active[amount++] = e;
        previous = end;
    }
    LocalTensor<int8_t> tile(TPosition::A1, 0, STAGES * span);
    SetLoadDataPaddingValue<uint64_t>(0);
    for (int i = 0; i < STAGES; ++i)
        SetFlag<HardEvent::MTE3_MTE2>(event_t(i));
    struct Pending
    {
        int expert, first, count, slot;
    };
    Pending pending[STAGES - 1];
    int head = 0, queued = 0, producer = 0;
    for (int task = GetBlockIdx(); task < amount * batches; task += workers)
    {
        const int e = active[task / batches], first = task % batches * KR;
        const int count = Min(KR, K - first), slot = producer;
        WaitFlag<HardEvent::MTE3_MTE2>(event_t(slot));
        const int whole = count / 32, tail = count % 32;
        Nd2NzParams p;
        p.ndNum = whole;
        p.nValue = 32;
        p.dValue = N;
        p.srcDValue = N;
        p.srcNdMatrixStride = 32 * N;
        p.dstNzC0Stride = 32;
        p.dstNzNStride = 1;
        p.dstNzMatrixStride = NP * 32;
        if (whole)
            DataCopy(tile[slot * span], src[int64_t(e) * K * N + int64_t(first) * N], p);
        if (tail)
        {
            p.ndNum = 1;
            p.nValue = tail;
            p.dstNzMatrixStride = 0;
            DataCopy(tile[slot * span + whole * NP * 32],
                     src[int64_t(e) * K * N + int64_t(first + whole * 32) * N], p);
            InitConstValueParams<uint16_t> zero(blocks, 32 - tail, tail, uint16_t(0));
            InitConstValue(tile[slot * span + whole * NP * 32 + tail * 32]
                               .template ReinterpretCast<uint16_t>(),
                           zero);
        }
        SetFlag<HardEvent::MTE2_MTE3>(event_t(slot));
        if (queued == STAGES - 1)
        {
            const Pending old = pending[head];
            WaitFlag<HardEvent::MTE2_MTE3>(event_t(old.slot));
            DataCopy(dst[int64_t(old.expert) * KP * NP + int64_t(old.first) * NP],
                     tile[old.slot * span], Up(old.count, 32) * NP);
            SetFlag<HardEvent::MTE3_MTE2>(event_t(old.slot));
            pending[head] = {e, first, count, slot};
            head = (head + 1) % (STAGES - 1);
        }
        else
            pending[(head + queued++) % (STAGES - 1)] = {e, first, count, slot};
        producer = (producer + 1) % STAGES;
    }
    while (queued)
    {
        const Pending old = pending[head];
        WaitFlag<HardEvent::MTE2_MTE3>(event_t(old.slot));
        DataCopy(dst[int64_t(old.expert) * KP * NP + int64_t(old.first) * NP],
                 tile[old.slot * span], Up(old.count, 32) * NP);
        SetFlag<HardEvent::MTE3_MTE2>(event_t(old.slot));
        head = (head + 1) % (STAGES - 1);
        --queued;
    }
    for (int i = 0; i < STAGES; ++i)
        WaitFlag<HardEvent::MTE3_MTE2>(event_t(i));
    CrossCoreSetFlag<0, PIPE_MTE3>(9);
    CrossCoreWaitFlag(9);
}

template <int STATIC_WORKERS = 0>
__global__ __mix__(1, 2)
    __attribute__((aligned(4096))) void Prepared(GM_ADDR x, GM_ADDR weight, GM_ADDR scale,
                                                 GM_ADDR groups, GM_ADDR y, GM_ADDR workspace,
                                                 GM_ADDR packedB, int M, int K, int N, int E,
                                                 int inputWorkers, int KP, int NP)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
    SetAtomicNone();
    const int workers = STATIC_WORKERS ? STATIC_WORKERS : inputWorkers;
    int core = GetBlockIdx();
    if ASCEND_IS_AIV
    {
        core /= GetSubBlockNum();
    }
    GlobalTensor<int8_t> a, b, pb;
    GlobalTensor<int64_t> g;
    GlobalTensor<int32_t> buffer;
    GlobalTensor<float> s;
    GlobalTensor<half> result;
    a.SetGlobalBuffer((__gm__ int8_t *)x);
    b.SetGlobalBuffer((__gm__ int8_t *)weight);
    pb.SetGlobalBuffer((__gm__ int8_t *)packedB);
    g.SetGlobalBuffer((__gm__ int64_t *)groups);
    buffer.SetGlobalBuffer((__gm__ int32_t *)workspace);
    s.SetGlobalBuffer((__gm__ float *)scale);
    result.SetGlobalBuffer((__gm__ half *)y);
    if ASCEND_IS_AIV
    {
        TPipe pipe;
        SetMaskNorm();
        SetVectorMask<uint8_t>(~uint64_t(0), ~uint64_t(0));
        LocalTensor<int64_t> ends(TPosition::VECCALC, 172032, 128);
        DataCopyPad(ends, g, DataCopyExtParams(1, E * 8, 0, 0, 0),
                    DataCopyPadExtParams<int64_t>{false, 0, 0, 0});
        SetFlag<HardEvent::MTE2_S>(EVENT_ID6);
        WaitFlag<HardEvent::MTE2_S>(EVENT_ID6);

        PrefetchFromGroups(b, ends, K, N, E, workers);
        SetFlag<HardEvent::MTE2_S>(EVENT_ID4);
        WaitFlag<HardEvent::MTE2_S>(EVENT_ID4);
        CrossCoreSetFlag<0, PIPE_MTE3>(7);
        CrossCoreWaitFlag(7);
        CrossCoreSetFlag<2, PIPE_MTE3>(4);
        CrossCoreSetFlag<2, PIPE_MTE2>(2);
        CrossCoreSetFlag<2, PIPE_MTE2>(3);
    }
    if ASCEND_IS_AIC
    {
        KMajorPackB<KR>(b, pb, g, K, N, E, KP, NP, workers);
        CrossCoreWaitFlag(4);
        Cube<MT, NT, false, LK, ST> cube;
        cube.Init();
        const int columns = (N + NT - 1) / NT;
        int previous = 0, base = 0, next = core, sequence = 0, aSequence = 0;
        for (int height = MT; height >= 16; height -= 16)
        {
            previous = 0;
            for (int e = 0; e < E; ++e)
            {
                const int end = int(g.GetValue(e)), length = end - previous;
                const int full = length / MT, tail = length % MT;
                const int first = height == MT ? 0 : full;
                const int stop = full + int(tail && Up(tail, 16) == height);
                const int tiles = stop - first;
                while (next < base + tiles)
                {
                    const int ri = first + next - base, row = previous + ri * MT,
                              rows = Min(MT, length - ri * MT);
                    const int aSlot = aSequence++ % 2;
                    cube.LoadA(a[int64_t(row) * K], rows, K, aSlot);
                    for (int nc = 0; nc < columns; ++nc)
                    {
                        const int col = ((nc + core) % columns) * NT, cols = Min(NT, N - col),
                                  slot = sequence++ & 1;
                        cube.Compute(pb[int64_t(e) * KP * NP + int64_t(col) * 32],
                                     buffer[int64_t(core * 2 + slot) * MT * NT], rows, cols, K, NP,
                                     slot, aSlot, nc + 1 == columns);
                    }
                    next += (aSequence & 1) ? (2 * workers - 1 - 2 * core) : (2 * core + 1);
                }
                previous = end;
                base += tiles;
            }
        }
        cube.Finish();
    }
    if ASCEND_IS_AIV
    {
        TPipe pipe;
        SetMaskNorm();
        SetVectorMask<uint8_t>(~uint64_t(0), ~uint64_t(0));
        LocalTensor<int64_t> ends(TPosition::VECCALC, 172032, 128);
        DataCopyPad(ends, g, DataCopyExtParams(1, E * 8, 0, 0, 0),
                    DataCopyPadExtParams<int64_t>{false, 0, 0, 0});
        SetFlag<HardEvent::MTE2_S>(EVENT_ID6);
        WaitFlag<HardEvent::MTE2_S>(EVENT_ID6);
        SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
        LocalTensor<float> cachedScale(TPosition::VECCALC, ((MT + 1) / 2) * NT * 10 + 256, 2048);
        const int columns = (N + NT - 1) / NT;
        int previous = 0, base = 0, next = core, sequence = 0, rowSequence = 0;
        for (int height = MT; height >= 16; height -= 16)
        {
            previous = 0;
            for (int e = 0; e < E; ++e)
            {
                const int end = int(ends.GetValue(e)), length = end - previous;
                const int full = length / MT, tail = length % MT;
                const int first = height == MT ? 0 : full;
                const int stop = full + int(tail && Up(tail, 16) == height);
                const int tiles = stop - first;
                const int gap = (rowSequence & 1) ? (2 * core + 1) : (2 * workers - 1 - 2 * core);
                const bool reuseScale = next + gap < base + tiles;
                if (reuseScale)
                    DataCopyPad(cachedScale, s[int64_t(e) * N],
                                DataCopyExtParams(1, N * 4, 0, 0, 0),
                                DataCopyPadExtParams<float>{false, 0, 0, 0.0f});
                while (next < base + tiles)
                {
                    const int ri = first + next - base, row = previous + ri * MT,
                              rows = Min(MT, length - ri * MT);
                    for (int nc = 0; nc < columns; ++nc)
                    {
                        const int col = ((nc + core) % columns) * NT, cols = Min(NT, N - col),
                                  slot = sequence++ & 1;
                        EpilogueSequential<MT, NT> preload;
                        preload.PreloadScales(s, N, e, col, cols, reuseScale);
                        CrossCoreWaitFlag(slot);
                        Activate<MT, NT>(buffer[int64_t(core * 2 + slot) * MT * NT], s, result, row,
                                         col, rows, cols, N, e, 1, slot, reuseScale);
                    }
                    next += (rowSequence++ & 1) ? (2 * core + 1) : (2 * workers - 1 - 2 * core);
                }
                previous = end;
                base += tiles;
            }
        }
        WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
    }
}
inline bool Launch(GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR g, GM_ADDR y, int M, int K, int N,
                   int E, int cores, aclrtStream stream)
{
    const int KP = (K + 31) / 32 * 32, NP = (N + 31) / 32 * 32;
    if (K < 545 || K > 1280 || N <= NT || N > 2048 || 32 * N > 65535 || 32 * NP > 65535 ||
        M < cores * 64 || M < E * 128 || 4 * KR * NP > 524032 ||
        size_t(E) * K * N + size_t(E) * KP * NP > (size_t(80) << 20))
        return false;
    const int workers = cores;
    const size_t cBytes = size_t(workers) * 2 * MT * NT * 4, bBytes = size_t(E) * KP * NP;
    Workspace memory(cBytes + bBytes, stream);
    if (!memory.Data())
        return true;
    if (workers == 20)
        Prepared<20><<<workers, nullptr, stream>>>(
            x, w, s, g, y, memory.Data(), memory.Data() + cBytes, M, K, N, E, workers, KP, NP);
    else
        Prepared<0><<<workers, nullptr, stream>>>(
            x, w, s, g, y, memory.Data(), memory.Data() + cBytes, M, K, N, E, workers, KP, NP);
    memory.Complete();
    return true;
}
}

namespace generalized_stream
{
using namespace AscendC;
using grouped_gelu::Min;
using grouped_gelu::Up;
using grouped_gelu::Gelu;
template <int MT, int NT, bool KEEP_LAYOUT = false> class Epilogue
{
    static constexpr int ROWS = (MT + 1) / 2;
    static constexpr int CHUNK_ROWS = ROWS < 8192 / NT ? ROWS : 8192 / NT;
    static constexpr int SIZE = CHUNK_ROWS * NT;
    static_assert(CHUNK_ROWS >= 1 && SIZE * 16 + NT * 8 + 256 <= 172032,
                  "pipelined epilogue overlaps group cache");
    LocalTensor<int32_t> accum{TPosition::VECCALC, 0, SIZE * 2};
    LocalTensor<float> temporary{TPosition::VECCALC, SIZE * 8 + 256, SIZE};
    LocalTensor<half> output{TPosition::VECCALC, SIZE * 12 + 256, SIZE * 2};
    LocalTensor<float> scales{TPosition::VECCALC, SIZE * 16 + 256, NT * 2};

    struct Pending
    {
        int index, rows, cols, row, col, N, gmSlot;
        GM_ADDR destination;
        bool lastChunk;
    };
    Pending pending;
    bool initialized = false, hasPending = false;
    int producer = 0;

    __aicore__ inline void Init()
    {

        SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
        SetFlag<HardEvent::V_MTE2>(EVENT_ID1);
        SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
        SetFlag<HardEvent::MTE3_V>(EVENT_ID1);
        initialized = true;
    }

    __aicore__ inline void Consume(const Pending &p)
    {
        const event_t event = p.index ? EVENT_ID1 : EVENT_ID0;
        WaitFlag<HardEvent::MTE2_V>(event);

        auto input = accum[p.index * SIZE];
        auto z = input.template ReinterpretCast<float>();
        auto localScale = scales[p.index * NT];
        auto out = output[p.index * SIZE];
        Cast(z, input, RoundMode::CAST_RINT, p.rows * NT);
        PipeBarrier<PIPE_V>();
        for (int r = 0; r < p.rows; r += 128)
            for (int c = 0; c < NT; c += 64)
            {
                const int width = Min(64, NT - c);
                Mul(z[r * NT + c], z[r * NT + c], localScale[c], width, Min(128, p.rows - r),
                    {1, 1, 1, uint8_t(NT / 8), uint8_t(NT / 8), 0});
            }
        PipeBarrier<PIPE_V>();
        WaitFlag<HardEvent::MTE3_V>(event);
        Gelu(z, temporary, out, p.rows * NT);
        SetFlag<HardEvent::V_MTE3>(event);
        WaitFlag<HardEvent::V_MTE3>(event);
        GlobalTensor<half> destination;
        destination.SetGlobalBuffer((__gm__ half *)p.destination);
        if (p.rows == CHUNK_ROWS && p.cols == NT && p.N == NT)
            DataCopy(destination[int64_t(p.row) * p.N + p.col], out, p.rows * NT);
        else
            DataCopyPad(destination[int64_t(p.row) * p.N + p.col], out,
                        DataCopyExtParams(p.rows, p.cols * 2, (NT - Up(p.cols, 16)) / 16,
                                          (p.N - p.cols) * 2, 0));
        SetFlag<HardEvent::MTE3_V>(event);
        SetFlag<HardEvent::V_MTE2>(event);
    }

    __aicore__ inline void Flush()
    {
        if (hasPending)
        {
            Consume(pending);
            hasPending = false;
        }
    }

  public:
    __aicore__ inline ~Epilogue()
    {
        if (initialized)
        {
            Flush();
            WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
            WaitFlag<HardEvent::V_MTE2>(EVENT_ID1);
            WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
            WaitFlag<HardEvent::MTE3_V>(EVENT_ID1);
        }
    }

    __aicore__ inline void Run(const GlobalTensor<int32_t> &src, const GlobalTensor<float> &scale,
                               const GlobalTensor<half> &y, int row, int col, int rows, int cols,
                               int N, int expert, int shards = 1, int slot = 0)
    {
        const int first = GetSubBlockIdx() * ((rows + 1) / 2);
        const int valid = GetSubBlockIdx() ? rows / 2 : (rows + 1) / 2;
        if (valid <= 0)
        {

            Flush();
            CrossCoreSetFlag<2, PIPE_MTE2>(2 + slot);
            return;
        }
        if (!initialized)
            Init();
        for (int offset = 0; offset < valid; offset += CHUNK_ROWS)
        {
            const int index = producer;
            const event_t event = index ? EVENT_ID1 : EVENT_ID0;
            const int count = Min(CHUNK_ROWS, valid - offset);
            WaitFlag<HardEvent::V_MTE2>(event);
            DataCopy(accum[index * SIZE], src[(first + offset) * NT], count * NT);
            if (offset + count == valid)
                CrossCoreSetFlag<2, PIPE_MTE2>(2 + slot);
            if (cols == NT && (N == NT || cols % 16 == 0))
                DataCopy(scales[index * NT], scale[expert * N + col], cols);
            else
                DataCopyPad(scales[index * NT], scale[expert * N + col],
                            DataCopyExtParams(1, cols * 4, 0, 0, 0),
                            DataCopyPadExtParams<float>{false, 0, 0, 0.0f});
            SetFlag<HardEvent::MTE2_V>(event);
            Flush();
            pending = {index,
                       count,
                       cols,
                       row + first + offset,
                       col,
                       N,
                       slot,
                       (GM_ADDR)y.GetPhyAddr(),
                       offset + count == valid};
            hasPending = true;
            producer ^= 1;
        }
    }
};

}

namespace generalized_resident
{
using namespace AscendC;
using grouped_gelu::Min;
using grouped_gelu::Up;
using grouped_gelu::Workspace;

template <int MT, int NT, int NSTAGES = 3, int LK = 256> class CachedACube
{
    static constexpr int FK = (NT > 512 || MT > 512) ? 32 : ((NT > 256 || MT >= 256) ? 64 : 128);
    static constexpr int STAGES = NSTAGES;
    static constexpr int AK = 2048;
    static constexpr int APANEL = MT * AK;
    static constexpr int BPANEL = NT * LK;
    static_assert(APANEL + STAGES * BPANEL <= 524288, "cached A/L1 capacity exceeded");
    static_assert(2 * MT * FK <= 65536 && 2 * NT * FK <= 65536, "L0A/B capacity exceeded");
    static_assert(MT * NT * 4 <= 131072, "L0C capacity exceeded");
    LocalTensor<int8_t> aCache{TPosition::A1, 0, APANEL};
    LocalTensor<int8_t> bL1{TPosition::A1, APANEL, STAGES * BPANEL};
    LocalTensor<int8_t> a0{TPosition::A2, 0, 2 * MT * FK};
    LocalTensor<int8_t> b0{TPosition::B2, 0, 2 * NT * FK};
    LocalTensor<int32_t> c0{TPosition::CO1, 0, MT * NT};
    int fragmentSlot = 0;
    struct Pending
    {
        int slot, count, rows, cols, outputSlot, kStart;
        GM_ADDR output;
        bool first, last;
    };

    static constexpr int QUEUE = 1;
    Pending pending[QUEUE];
    int head = 0, pendingCount = 0, producer = 0;

    __aicore__ inline void CopyNd(const LocalTensor<int8_t> &dst, const GlobalTensor<int8_t> &src,
                                  int rows, int cols, int stride, int paddedRows)
    {
        Nd2NzParams p;
        p.ndNum = 1;
        p.nValue = rows;
        p.dValue = cols;
        p.srcNdMatrixStride = 0;
        p.srcDValue = stride;
        p.dstNzC0Stride = paddedRows;
        p.dstNzNStride = 1;
        p.dstNzMatrixStride = 0;
        if constexpr (MT == 64 && NT == 512)
        {
            if (rows > 16 && rows % 16 == 0 && 16 * stride <= 65535)
            {
                p.ndNum = rows / 16;
                p.nValue = 16;
                p.srcNdMatrixStride = 16 * stride;
                p.dstNzMatrixStride = 16 * 32;
            }
        }
        if constexpr (NT == 256)
        {
            if (stride % 4 == 0 && rows % 32 == 0)
            {
                GlobalTensor<float> wide;
                wide.SetGlobalBuffer((__gm__ float *)src.GetPhyAddr());
                p.dValue = (cols + 3) / 4;
                p.srcDValue /= 4;
                DataCopy(dst.template ReinterpretCast<float>(), wide, p);
                return;
            }
        }
        DataCopy(dst, src, p);
    }

  public:
    __aicore__ inline void Init()
    {
        SetLoadDataPaddingValue<uint64_t>(0);
        SetFixpipeNz2ndFlag(1, 0, 0);
        for (int i = 0; i < STAGES; ++i)
            SetFlag<HardEvent::MTE1_MTE2>(i);
        for (int i = 0; i < 2; ++i)
            SetFlag<HardEvent::M_MTE1>(i);
        SetFlag<HardEvent::FIX_M>(0);
    }

    __aicore__ inline void LoadA(const GlobalTensor<int8_t> &src, int rows, int K, int stride)
    {
        CopyNd(aCache, src, rows, K, stride, MT);
    }

    __aicore__ inline void Consume(const Pending &p)
    {
        const int cslot = 0;
        if (p.first)
            WaitFlag<HardEvent::FIX_M>(cslot);
        WaitFlag<HardEvent::MTE2_MTE1>(p.slot);
        auto c = c0;
        const int actualM = Up(p.rows, 16);
        const int activeN = actualM < 32 ? NT : Up(p.cols, 32);
        for (int f = 0; f < p.count; f += FK)
        {
            const int fk = Up(Min(FK, p.count - f), 32);
            const int fs = fragmentSlot;
            WaitFlag<HardEvent::M_MTE1>(fs);
            auto aa = a0[fs * MT * FK];
            auto bb = b0[fs * NT * FK];
            auto la = aCache[(p.kStart + f) * MT];
            auto lb = bL1[p.slot * BPANEL + f * 32];
            LoadData2DParams pa;
            pa.startIndex = 0;
            pa.repeatTimes = fk / 32;
            pa.srcStride = MT / 16;
            pa.dstGap = 0;
            pa.ifTranspose = false;
            pa.sid = 0;
            pa.addrMode = 0;
            for (int mi = 0; mi < (p.rows + 15) / 16; ++mi)
                LoadData(aa[mi * fk * 16], la[mi * 512], pa);
            LoadData2dTransposeParams pb;
            pb.startIndex = 0;
            pb.repeatTimes = (p.cols + 31) / 32;
            pb.srcStride = LK / 32;
            pb.dstGap = 1;
            pb.dstFracGap = 0;
            for (int ki = 0; ki < fk / 32; ++ki)
                LoadDataWithTranspose(bb[ki * activeN * 32], lb[ki * 1024], pb);
            SetFlag<HardEvent::MTE1_M>(fs);
            WaitFlag<HardEvent::MTE1_M>(fs);
            MmadParams mm;
            mm.m = actualM;
            mm.n = activeN;
            mm.k = fk;
            mm.cmatrixInitVal = p.first && f == 0;
            mm.unitFlag = p.last && f + FK >= p.count ? 3 : 2;
            Mmad(c, aa, bb, mm);
            if (actualM * activeN < 2560)
                PipeBarrier<PIPE_M>();
            SetFlag<HardEvent::M_MTE1>(fs);
            fragmentSlot ^= 1;
        }
        SetFlag<HardEvent::MTE1_MTE2>(p.slot);
        if (p.last)
        {
            GlobalTensor<int32_t> dst;
            dst.SetGlobalBuffer((__gm__ int32_t *)p.output);
            CrossCoreWaitFlag(2 + p.outputSlot);
            FixpipeParamsV220 fp;
            fp.nSize = activeN;
            fp.mSize = p.rows;
            fp.srcStride = actualM;
            fp.dstStride = activeN;
            fp.quantPre = QuantMode_t::NoQuant;
            fp.reluEn = false;
            fp.unitFlag = 3;
            Fixpipe<int32_t, int32_t, CFG_ROW_MAJOR>(dst, c, fp);
            SetFlag<HardEvent::FIX_M>(0);
            CrossCoreSetFlag<2, PIPE_FIX>(p.outputSlot);
        }
    }

    __aicore__ inline void Compute(const GlobalTensor<int8_t> &b, const GlobalTensor<int32_t> &dst,
                                   int rows, int cols, int K, int N, int start, int depth,
                                   int outputSlot)
    {
        const int panels = (depth + LK - 1) / LK;
        for (int p = 0; p < panels; ++p)
        {
            const int slot = producer;
            int ki = p;
            if constexpr (MT >= 64 && NT >= 128)
                ki = (p + GetBlockIdx()) % panels;
            const int count = Min(LK, depth - ki * LK);

            WaitFlag<HardEvent::MTE1_MTE2>(slot);
            CopyNd(bL1[slot * BPANEL], b[int64_t(start + ki * LK) * N], count, cols, N, LK);
            SetFlag<HardEvent::MTE2_MTE1>(slot);
            if (pendingCount == QUEUE)
            {
                Consume(pending[head]);
                head = head + 1 < QUEUE ? head + 1 : 0;
                --pendingCount;
            }
            const int tail =
                head + pendingCount < QUEUE ? head + pendingCount : head + pendingCount - QUEUE;
            pending[tail] = {
                slot,   count,          rows, cols, outputSlot, ki * LK, (GM_ADDR)dst.GetPhyAddr(),
                p == 0, p + 1 == panels};
            ++pendingCount;
            producer = producer + 1 < STAGES ? producer + 1 : 0;
        }
    }

    __aicore__ inline void Finish()
    {
        while (pendingCount)
        {
            Consume(pending[head]);
            head = head + 1 < QUEUE ? head + 1 : 0;
            --pendingCount;
        }
        for (int i = 0; i < STAGES; ++i)
            WaitFlag<HardEvent::MTE1_MTE2>(i);
        for (int i = 0; i < 2; ++i)
            WaitFlag<HardEvent::M_MTE1>(i);
        WaitFlag<HardEvent::FIX_M>(0);
    }
};

template <int MT, int NT, int LK, int LANES, int DK>
__global__ __mix__(1, 2)
    __attribute__((aligned(4096))) void Resident(GM_ADDR x, GM_ADDR weight, GM_ADDR scale,
                                                 GM_ADDR groups, GM_ADDR y, GM_ADDR workspace,
                                                 int inputK, int N, int E, int workers)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
    SetAtomicNone();
    const int K = DK ? DK : inputK;
    int core = GetBlockIdx();
    if ASCEND_IS_AIV
    {
        core /= GetSubBlockNum();
    }
    GlobalTensor<int8_t> a, b;
    GlobalTensor<int64_t> g;
    GlobalTensor<float> s;
    GlobalTensor<half> out;
    GlobalTensor<int32_t> buffer;
    a.SetGlobalBuffer((__gm__ int8_t *)x);
    b.SetGlobalBuffer((__gm__ int8_t *)weight);
    g.SetGlobalBuffer((__gm__ int64_t *)groups);
    s.SetGlobalBuffer((__gm__ float *)scale);
    out.SetGlobalBuffer((__gm__ half *)y);
    buffer.SetGlobalBuffer((__gm__ int32_t *)workspace);
    const int columns = (N + NT - 1) / NT;
    const int rowWorkers = workers / LANES;
    int next = core / LANES, base = 0, previous = 0, sequence = 0;
    if ASCEND_IS_AIC
    {
        CachedACube<MT, NT, 3, LK> cube;
        for (int e = 0; e < E; ++e)
        {
            const int end = int(g.GetValue(e)), length = end - previous;
            const int count = (length + MT - 1) / MT;
            while (next < base + count)
            {
                const int row = (next - base) * MT, rows = Min(MT, length - row);
                cube.Init();
                cube.LoadA(a[int64_t(previous + row) * K], rows, K, K);
                for (int c = core % LANES; c < columns; c += LANES)
                {
                    const int slot = sequence++ & 1;
                    cube.Compute(b[int64_t(e) * K * N + c * NT],
                                 buffer[int64_t(core * 2 + slot) * MT * NT], rows,
                                 Min(NT, N - c * NT), K, N, 0, K, slot);
                }
                cube.Finish();
                next += rowWorkers;
            }
            base += count;
            previous = end;
        }
    }
    if ASCEND_IS_AIV
    {
        TPipe pipe;
        SetMaskNorm();
        SetVectorMask<uint8_t>(~uint64_t(0), ~uint64_t(0));
        grouped_gelu::Epilogue<MT, NT> epilogue;
        CrossCoreSetFlag<2, PIPE_MTE2>(2);
        CrossCoreSetFlag<2, PIPE_MTE2>(3);
        for (int e = 0; e < E; ++e)
        {
            const int end = int(g.GetValue(e)), length = end - previous;
            const int count = (length + MT - 1) / MT;
            while (next < base + count)
            {
                const int row = (next - base) * MT, rows = Min(MT, length - row);
                for (int c = core % LANES; c < columns; c += LANES)
                {
                    const int slot = sequence++ & 1;
                    CrossCoreWaitFlag(slot);
                    epilogue.Run(buffer[int64_t(core * 2 + slot) * MT * NT], s, out, previous + row,
                                 c * NT, rows, Min(NT, N - c * NT), N, e, 1, slot);
                }
                next += rowWorkers;
            }
            base += count;
            previous = end;
        }
    }
}

template <int MT, int NT, int LK, int LANES, int DK>
inline void Start(GM_ADDR x, GM_ADDR b, GM_ADDR s, GM_ADDR g, GM_ADDR y, int M, int K, int N, int E,
                  int cores, aclrtStream stream)
{
    const int nominal = std::max(E, (M + MT - 1) / MT);
    const int workers = std::min(cores / LANES, nominal) * LANES;
    Workspace memory(size_t(workers) * 2 * MT * NT * 4, stream);
    if (!memory.Data())
        return;
    Resident<MT, NT, LK, LANES, DK>
        <<<workers, nullptr, stream>>>(x, b, s, g, y, memory.Data(), K, N, E, workers);
    memory.Complete();
}

template <int MT, int NT, int LK>
inline void Launch(GM_ADDR x, GM_ADDR b, GM_ADDR s, GM_ADDR g, GM_ADDR y, int M, int K, int N,
                   int E, int cores, aclrtStream stream)
{
    const int nominal = std::max(E, (M + MT - 1) / MT);
    const int columns = (N + NT - 1) / NT;
    int lanes = 1, cost = (nominal + cores - 1) / cores * columns;
    for (int candidate = 2; candidate <= std::min(5, std::min(cores, columns)); ++candidate)
    {
        const int rows = cores / candidate;
        const int trial = (nominal + rows - 1) / rows * ((columns + candidate - 1) / candidate);
        if (trial < cost)
        {
            cost = trial;
            lanes = candidate;
        }
    }
    if (lanes == 3)
    {
        Start<MT, NT, LK, 3, 0>(x, b, s, g, y, M, K, N, E, cores, stream);
        return;
    }
    if (lanes == 4)
    {
        Start<MT, NT, LK, 4, 0>(x, b, s, g, y, M, K, N, E, cores, stream);
        return;
    }
    if (lanes == 5)
    {
        Start<MT, NT, LK, 5, 0>(x, b, s, g, y, M, K, N, E, cores, stream);
        return;
    }
    const bool dual = lanes == 2;
    if (dual)
    {
        if (K == 2048)
            Start<MT, NT, LK, 2, 2048>(x, b, s, g, y, M, K, N, E, cores, stream);
        else if (K == 1024)
            Start<MT, NT, LK, 2, 1024>(x, b, s, g, y, M, K, N, E, cores, stream);
        else
            Start<MT, NT, LK, 2, 0>(x, b, s, g, y, M, K, N, E, cores, stream);
    }
    else
    {
        if (K == 2048)
            Start<MT, NT, LK, 1, 2048>(x, b, s, g, y, M, K, N, E, cores, stream);
        else if (K == 1024)
            Start<MT, NT, LK, 1, 1024>(x, b, s, g, y, M, K, N, E, cores, stream);
        else
            Start<MT, NT, LK, 1, 0>(x, b, s, g, y, M, K, N, E, cores, stream);
    }
}
}

namespace generalized_stream
{
using grouped_gelu::Workspace;

template <int DK>
__global__ __mix__(1, 2)
    __attribute__((aligned(4096))) void Stream(GM_ADDR x, GM_ADDR weight, GM_ADDR scale,
                                               GM_ADDR groups, GM_ADDR y, GM_ADDR workspace, int M,
                                               int inputK, int N, int E, int workers)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
    SetAtomicNone();
    constexpr int MT = 64, NT = 256;
    const int K = DK ? DK : inputK;
    int core = GetBlockIdx();
    if ASCEND_IS_AIV
    {
        core /= GetSubBlockNum();
    }
    GlobalTensor<int8_t> a, b;
    GlobalTensor<int64_t> g;
    GlobalTensor<float> s;
    GlobalTensor<half> out;
    GlobalTensor<int32_t> buffer;
    a.SetGlobalBuffer((__gm__ int8_t *)x);
    b.SetGlobalBuffer((__gm__ int8_t *)weight);
    g.SetGlobalBuffer((__gm__ int64_t *)groups);
    s.SetGlobalBuffer((__gm__ float *)scale);
    out.SetGlobalBuffer((__gm__ half *)y);
    buffer.SetGlobalBuffer((__gm__ int32_t *)workspace);
    const int columns = N / NT;
    const int rowTiles = (M + MT - 1) / MT;
    const int begin = core * rowTiles / workers * MT;
    const int limit = Min(M, (core + 1) * rowTiles / workers * MT);
    if ASCEND_IS_AIC
    {
        grouped_gelu::Cube<MT, NT, false> cube;
        cube.Init();
        int lo = 0, hi = E - 1;
        while (lo < hi)
        {
            const int mid = (lo + hi) / 2;
            if (g.GetValue(mid) <= begin)
                lo = mid + 1;
            else
                hi = mid;
        }
        int row = begin, sequence = 0;
        for (int e = lo; e < E && row < limit; ++e)
        {
            const int end = Min(limit, int(g.GetValue(e)));
            while (row < end)
            {
                const int rows = Min(MT, end - row);
                for (int nc = 0; nc < columns; ++nc)
                {
                    const int col = nc * NT, slot = sequence++ & 1;
                    cube.Compute(a[int64_t(row) * K], b[int64_t(e) * K * N + col],
                                 buffer[int64_t(core * 2 + slot) * MT * NT], rows, NT, K, N, 0, K,
                                 slot);
                }
                row += rows;
            }
        }
        cube.Finish();
    }
    if ASCEND_IS_AIV
    {
        TPipe pipe;
        SetMaskNorm();
        SetVectorMask<uint8_t>(~uint64_t(0), ~uint64_t(0));
        LocalTensor<int64_t> ends(TPosition::VECCALC, 172032, 128);
        DataCopyPad(ends, g, DataCopyExtParams(1, E * 8, 0, 0, 0),
                    DataCopyPadExtParams<int64_t>{false, 0, 0, 0});
        SetFlag<HardEvent::MTE2_S>(EVENT_ID4);
        WaitFlag<HardEvent::MTE2_S>(EVENT_ID4);
        CrossCoreSetFlag<2, PIPE_MTE2>(2);
        CrossCoreSetFlag<2, PIPE_MTE2>(3);
        int lo = 0, hi = E - 1;
        while (lo < hi)
        {
            const int mid = (lo + hi) / 2;
            if (ends.GetValue(mid) <= begin)
                lo = mid + 1;
            else
                hi = mid;
        }
        int row = begin, sequence = 0;
        Epilogue<MT, NT> epilogue;
        for (int e = lo; e < E && row < limit; ++e)
        {
            const int end = Min(limit, int(ends.GetValue(e)));
            while (row < end)
            {
                const int rows = Min(MT, end - row);
                for (int nc = 0; nc < columns; ++nc)
                {
                    const int col = nc * NT, slot = sequence++ & 1;
                    CrossCoreWaitFlag(slot);
                    epilogue.Run(buffer[int64_t(core * 2 + slot) * MT * NT], s, out, row, col, rows,
                                 NT, N, e, 1, slot);
                }
                row += rows;
            }
        }
    }
}

inline void Launch(GM_ADDR x, GM_ADDR b, GM_ADDR s, GM_ADDR g, GM_ADDR y, int M, int K, int N,
                   int E, int cores, aclrtStream stream)
{
    const int workers = std::min(cores, ((M + 63) / 64 + E - 1) * (N / 256));
    Workspace memory(size_t(workers) * 2 * 64 * 256 * 4, stream);
    if (!memory.Data())
        return;
    if (K == 256)
        Stream<256>
            <<<workers, nullptr, stream>>>(x, b, s, g, y, memory.Data(), M, K, N, E, workers);
    else
        Stream<0><<<workers, nullptr, stream>>>(x, b, s, g, y, memory.Data(), M, K, N, E, workers);
    memory.Complete();
}
}

namespace generalized_prepared
{
using namespace AscendC;
using grouped_gelu::Min;
using grouped_gelu::Up;
using grouped_gelu::Workspace;
constexpr int LIMIT = 2048;
constexpr int HEADER = 4;

__aicore__ inline uint64_t Encode(int expert, int row, int column, int rows, int job, int shard)
{
    return uint64_t(expert) | (uint64_t(row) << 7) | (uint64_t(column) << 23) |
           (uint64_t(rows) << 30) | (uint64_t(job) << 38) | (uint64_t(shard) << 58);
}

template <int MT, int NT, int SHARDS>
__aicore__ inline void BuildDense(const LocalTensor<int64_t> &ends,
                                  const GlobalTensor<uint64_t> &destination, int N, int E)
{
    LocalTensor<uint64_t> table(TPosition::VECCALC, 172032, LIMIT + HEADER);
    Duplicate(table.ReinterpretCast<uint32_t>(), uint32_t(0), (LIMIT + HEADER) * 2);
    SetFlag<HardEvent::V_S>(EVENT_ID6);
    WaitFlag<HardEvent::V_S>(EVENT_ID6);
    const int columns = (N + NT - 1) / NT;
    int count = 0, job = 0;
    // Large physical row tiles first; alternate ownership on successive waves.
    // The same descriptor defines Cube, Fixpipe and Vector tail geometry.
    for (int bucket = MT; bucket >= 16; bucket -= 16)
    {
        int previous = 0;
        for (int e = 0; e < E; ++e)
        {
            const int end = int(ends.GetValue(e)), length = end - previous;
            const int first = bucket == MT ? 0 : length / MT;
            const int stop = length / MT + int(length % MT && Up(length % MT, 16) == bucket);
            for (int ri = first; ri < stop; ++ri)
            {
                const int rows = Min(MT, length - ri * MT);
                for (int col = 0; col < columns; ++col)
                {
                    for (int shard = 0; shard < SHARDS; ++shard)
                        table.SetValue(HEADER + count++,
                                       Encode(e, previous + ri * MT, col, rows, job, shard));
                    ++job;
                }
            }
            previous = end;
        }
    }
    table.SetValue(0, uint64_t(count));
    table.SetValue(1, uint64_t(job));
    SetFlag<HardEvent::S_MTE3>(EVENT_ID6);
    WaitFlag<HardEvent::S_MTE3>(EVENT_ID6);
    DataCopy(destination, table, (LIMIT + HEADER));
    SetFlag<HardEvent::MTE3_S>(EVENT_ID6);
    WaitFlag<HardEvent::MTE3_S>(EVENT_ID6);
}

template <int MT, int NT, int SHARDS>
__aicore__ inline void BuildSparse(const LocalTensor<int64_t> &ends,
                                   const GlobalTensor<uint64_t> &destination, int N, int E)
{
    LocalTensor<uint64_t> table(TPosition::VECCALC, 172032, LIMIT + HEADER);
    Duplicate(table.ReinterpretCast<uint32_t>(), uint32_t(0), (LIMIT + HEADER) * 2);
    SetFlag<HardEvent::V_S>(EVENT_ID6);
    WaitFlag<HardEvent::V_S>(EVENT_ID6);
    const int columns = (N + NT - 1) / NT;
    int count = 0, job = 0, previous = 0, active = 0;
    for (int e = 0; e < E; ++e)
    {
        const int end = int(ends.GetValue(e)), length = end - previous;

        for (int ri = 0; ri < (length + MT - 1) / MT; ++ri)
        {
            const int row = previous + ri * MT, rows = Min(MT, length - ri * MT);
            for (int col = 0; col < columns; ++col)
            {
                for (int shard = 0; shard < SHARDS; ++shard)
                    table.SetValue(HEADER + count++, Encode(e, row, col, rows, job, shard));
                ++job;
            }
        }
        previous = end;
    }
    table.SetValue(0, uint64_t(count));
    table.SetValue(1, uint64_t(job));

    SetFlag<HardEvent::S_MTE3>(EVENT_ID6);
    WaitFlag<HardEvent::S_MTE3>(EVENT_ID6);
    DataCopy(destination, table, LIMIT + HEADER);
    SetFlag<HardEvent::MTE3_S>(EVENT_ID6);
    WaitFlag<HardEvent::MTE3_S>(EVENT_ID6);
}

template <int MT, int NT, int SHARDS>
__aicore__ inline void Build(const LocalTensor<int64_t> &ends,
                             const GlobalTensor<uint64_t> &destination, int N, int E)
{
    int active = 0, previous = 0;
    for (int e = 0; e < E; ++e)
    {
        const int end = int(ends.GetValue(e));
        if (end > previous)
            ++active;
        previous = end;
    }
    if (active * 2 < E)
        BuildSparse<MT, NT, SHARDS>(ends, destination, N, E);
    else
        BuildDense<MT, NT, SHARDS>(ends, destination, N, E);
}

using aggregate_lpt_prepare::PackB;

using aggregate_lpt_prepare::PrepareVector;

template <int MT, int NT, int LK, int ST, int KR, int SHARDS, int STATIC_WORKERS = 0>
__global__ __mix__(1, 2)
    __attribute__((aligned(4096))) void Prepared(GM_ADDR x, GM_ADDR weight, GM_ADDR scale,
                                                 GM_ADDR groups, GM_ADDR y, GM_ADDR workspace,
                                                 GM_ADDR metadata, GM_ADDR packedA, GM_ADDR packedB,
                                                 int M, int K, int N, int E, int inputWorkers,
                                                 int AP, int KP, int NP, int depth)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
    SetAtomicNone();
    const int workers = STATIC_WORKERS ? STATIC_WORKERS : inputWorkers;
    int core = GetBlockIdx();
    if ASCEND_IS_AIV
    {
        core /= GetSubBlockNum();
    }
    GlobalTensor<int8_t> a, b, pa, pb;
    GlobalTensor<int64_t> g;
    GlobalTensor<uint64_t> schedule;
    GlobalTensor<int32_t> buffer;
    GlobalTensor<float> scales;
    GlobalTensor<half> out;
    a.SetGlobalBuffer((__gm__ int8_t *)x);
    b.SetGlobalBuffer((__gm__ int8_t *)weight);
    pa.SetGlobalBuffer((__gm__ int8_t *)packedA);
    pb.SetGlobalBuffer((__gm__ int8_t *)packedB);
    g.SetGlobalBuffer((__gm__ int64_t *)groups);
    schedule.SetGlobalBuffer((__gm__ uint64_t *)metadata);
    buffer.SetGlobalBuffer((__gm__ int32_t *)workspace);
    scales.SetGlobalBuffer((__gm__ float *)scale);
    out.SetGlobalBuffer((__gm__ half *)y);
    if ASCEND_IS_AIV
    {
        TPipe pipe;
        SetMaskNorm();
        SetVectorMask<uint8_t>(~uint64_t(0), ~uint64_t(0));
        LocalTensor<int64_t> ends(TPosition::VECCALC, 192512, 128);
        DataCopyPad(ends, g, DataCopyExtParams(1, E * 8, 0, 0, 0),
                    DataCopyPadExtParams<int64_t>{false, 0, 0, 0});
        SetFlag<HardEvent::MTE2_S>(EVENT_ID6);
        WaitFlag<HardEvent::MTE2_S>(EVENT_ID6);
        if (GetBlockIdx() == 0)
            Build<MT, NT, SHARDS>(ends, schedule, N, E);
        PrepareVector(a, b, pa, pb, ends, M, K, N, E, AP, KP, NP, workers);
        CrossCoreSetFlag<0, PIPE_MTE3>(10);
        CrossCoreWaitFlag(10);
        CrossCoreSetFlag<2, PIPE_MTE3>(8);
        if constexpr (SHARDS == 1)
        {
            CrossCoreSetFlag<2, PIPE_MTE2>(2);
            CrossCoreSetFlag<2, PIPE_MTE2>(3);
        }
    }
    if (AP != K)
        a.SetGlobalBuffer((__gm__ int8_t *)packedA);
    if ASCEND_IS_AIC
    {
        PackB<KR>(b, pb, g, K, N, E, KP, NP, workers);
        CrossCoreWaitFlag(8);
        grouped_gelu::Cube<MT, NT, (SHARDS > 1), LK, ST, true> cube;
        cube.Init();
        const int count = int(schedule.GetValue(0));
        int sequence = 0;
        for (int wave = 0; wave * workers < count; ++wave)
        {
            const int index = wave * workers + (wave & 1 ? workers - 1 - core : core);
            if (index >= count)
                continue;
            const uint64_t v = schedule.GetValue(HEADER + index);
            const int e = v & 127, row = (v >> 7) & 65535;
            const int col = int((v >> 23) & 127) * NT, rows = (v >> 30) & 255;
            const int job = (v >> 38) & 1048575, shard = (v >> 58) & 3;
            const int slot = sequence++ & 1;
            const int64_t offset = SHARDS > 1 ? int64_t(job * SHARDS + shard) * MT * NT
                                              : int64_t(core * 2 + slot) * MT * NT;
            cube.Compute(a[int64_t(row) * AP],
                         pb[int64_t(e) * KP * NP + int64_t(col / 32) * KP * 32], buffer[offset],
                         rows, Min(NT, N - col), AP, NP, shard * depth,
                         Min(depth, K - shard * depth), slot, KP);
        }
        cube.Finish();
        if constexpr (SHARDS > 1)
            CrossCoreSetFlag<2, PIPE_FIX>(6);
    }
    if ASCEND_IS_AIV
    {
        TPipe pipe;
        SetMaskNorm();
        SetVectorMask<uint8_t>(~uint64_t(0), ~uint64_t(0));
        LocalTensor<uint64_t> table(TPosition::VECCALC, 172032, LIMIT + HEADER);
        DataCopy(table, schedule, LIMIT + HEADER);
        SetFlag<HardEvent::MTE2_S>(EVENT_ID6);
        WaitFlag<HardEvent::MTE2_S>(EVENT_ID6);
        if constexpr (SHARDS > 1)
        {
            CrossCoreWaitFlag(6);
            CrossCoreSetFlag<0, PIPE_MTE2>(11);
            CrossCoreWaitFlag(11);
        }
        const int count = int(table.GetValue(0)), jobs = int(table.GetValue(1));
        grouped_gelu::Epilogue<MT, NT> epilogue;
        int sequence = 0;
        for (int wave = 0; wave * workers < (SHARDS > 1 ? jobs : count); ++wave)
        {
            const int index = wave * workers + (wave & 1 ? workers - 1 - core : core);
            if (index >= (SHARDS > 1 ? jobs : count))
                continue;
            const uint64_t v = table.GetValue(HEADER + index * SHARDS);
            const int e = v & 127, row = (v >> 7) & 65535;
            const int col = int((v >> 23) & 127) * NT, rows = (v >> 30) & 255;
            const int job = (v >> 38) & 1048575, slot = sequence++ & 1;
            const int64_t offset =
                SHARDS > 1 ? int64_t(job) * SHARDS * MT * NT : int64_t(core * 2 + slot) * MT * NT;
            if constexpr (SHARDS == 1)
                CrossCoreWaitFlag(slot);
            epilogue.Run(buffer[offset], scales, out, row, col, rows, Min(NT, N - col), N, e,
                         SHARDS, slot);
        }
    }
}

template <int MT, int NT, int LK, int ST, int KR, int SHARDS = 1, bool ALIGN_A = false>
inline bool Launch(GM_ADDR x, GM_ADDR b, GM_ADDR s, GM_ADDR g, GM_ADDR y, int M, int K, int N,
                   int E, int cores, aclrtStream stream)
{
    const int tiles = ((M + MT - 1) / MT + E - 1) * ((N + NT - 1) / NT);
    const int KP = (K + 31) / 32 * 32, NP = (N + 31) / 32 * 32;
    if (tiles * SHARDS > LIMIT || 4 * KR * NP > 524288 || N > 4096)
        return false;
    const int workers = std::min(cores, tiles * SHARDS);
    const int AP = ALIGN_A ? (K + 31) / 32 * 32 : (K <= 544 ? K : (K + 255) / 256 * 256);
    const int depth = (K + SHARDS * 32 - 1) / (SHARDS * 32) * 32;
    if (depth * (SHARDS - 1) >= K)
        return false;
    const size_t cBytes =
        SHARDS > 1 ? size_t(tiles) * SHARDS * MT * NT * 4 : size_t(workers) * 2 * MT * NT * 4;
    const size_t tBytes = ((LIMIT + HEADER) * 8 + 511) / 512 * 512,
                 aBytes = AP == K ? 0 : size_t(M) * AP;
    const size_t bBytes = size_t(E) * KP * NP;
    if (aBytes + bBytes > (size_t(SHARDS > 1 ? 384 : 96) << 20))
        return false;
    Workspace memory(cBytes + tBytes + aBytes + bBytes, stream);
    if (!memory.Data())
        return false;
    GM_ADDR base = memory.Data();
    if (workers == 20)
        Prepared<MT, NT, LK, ST, KR, SHARDS, 20><<<workers, nullptr, stream>>>(
            x, b, s, g, y, base, base + cBytes, base + cBytes + tBytes,
            base + cBytes + tBytes + aBytes, M, K, N, E, workers, AP, KP, NP, depth);
    else
        Prepared<MT, NT, LK, ST, KR, SHARDS><<<workers, nullptr, stream>>>(
            x, b, s, g, y, base, base + cBytes, base + cBytes + tBytes,
            base + cBytes + tBytes + aBytes, M, K, N, E, workers, AP, KP, NP, depth);
    memory.Complete();
    return true;
}
}

namespace balanced_rows
{
using namespace AscendC;
using grouped_gelu::Min;
using grouped_gelu::Up;
using grouped_gelu::Workspace;
using grouped_gelu::Gelu;
template <int MT, int NT, bool SPLIT, int LK = 256, int NSTAGES = 3, bool NZ = false> class Cube
{
    static constexpr int FK = MT >= 256 || NT > 256 ? 64 : 128;
    static constexpr int STAGES = NSTAGES;
    static constexpr int PANEL = (MT + NT) * LK;
    static constexpr int CSLOTS = MT * NT * 4 <= 65536 ? 2 : 1;
    static_assert(STAGES * PANEL <= 524288, "L1 capacity exceeded");
    static_assert(2 * MT * FK <= 65536 && 2 * NT * FK <= 65536, "L0A/B capacity exceeded");
    static_assert(CSLOTS * MT * NT * 4 <= 131072, "L0C capacity exceeded");
    LocalTensor<int8_t> l1{TPosition::A1, 0, STAGES * PANEL};
    LocalTensor<int8_t> a0{TPosition::A2, 0, 2 * MT * FK};
    LocalTensor<int8_t> b0{TPosition::B2, 0, 2 * NT * FK};
    LocalTensor<int32_t> c0{TPosition::CO1, 0, CSLOTS * MT * NT};
    int fragmentSlot = 0;
    struct Pending
    {
        int slot, count, rows, cols, outputSlot;
        GM_ADDR output;
        bool first, last;
    };
    Pending pending[2];
    int head = 0, pendingCount = 0, producer = 0;

    __aicore__ inline void CopyNd(const LocalTensor<int8_t> &dst, const GlobalTensor<int8_t> &src,
                                  int rows, int cols, int stride, int paddedRows)
    {
        Nd2NzParams p;
        p.ndNum = 1;
        p.nValue = rows;
        p.dValue = cols;
        p.srcNdMatrixStride = 0;
        p.srcDValue = stride;
        p.dstNzC0Stride = paddedRows;
        p.dstNzNStride = 1;
        p.dstNzMatrixStride = 0;
        if (stride % 4 == 0 && rows % 32 == 0)
        {
            GlobalTensor<float> wide;
            wide.SetGlobalBuffer((__gm__ float *)src.GetPhyAddr());
            p.dValue = (cols + 3) / 4;
            p.srcDValue /= 4;
            DataCopy(dst.template ReinterpretCast<float>(), wide, p);
        }
        else
            DataCopy(dst, src, p);
    }

    template <bool FULL> __aicore__ inline void ConsumeTile(const Pending &p)
    {
        const int cslot = p.outputSlot % CSLOTS;
        if (p.first)
            WaitFlag<HardEvent::FIX_M>(cslot);
        auto c = c0[cslot * MT * NT];
        WaitFlag<HardEvent::MTE2_MTE1>(p.slot);
        const int actualM = FULL || MT >= 256 ? MT : Up(p.rows, 16);
        const int activeN = FULL || MT >= 256 || actualM < 32 ? NT : Up(p.cols, 32);
        const int physicalK = FULL ? LK : p.count;
#pragma unroll
        for (int f = 0; f < physicalK; f += FK)
        {
            const int fk = Up(Min(FK, physicalK - f), 32);
            const int fs = fragmentSlot;
            WaitFlag<HardEvent::M_MTE1>(fs);
            auto aa = a0[fs * MT * FK];
            auto bb = b0[fs * NT * FK];
            auto la = l1[p.slot * PANEL + f * MT];
            auto lb = l1[p.slot * PANEL + MT * LK + f * 32];
            LoadData2DParams pa;
            pa.startIndex = 0;
            pa.repeatTimes = fk / 32;
            pa.srcStride = MT / 16;
            pa.dstGap = 0;
            pa.ifTranspose = false;
            pa.sid = 0;
            pa.addrMode = 0;
            for (int mi = 0; mi < (FULL ? MT / 16 : (p.rows + 15) / 16); ++mi)
                LoadData(aa[mi * fk * 16], la[mi * 512], pa);
            LoadData2dTransposeParams pb;
            pb.startIndex = 0;
            pb.repeatTimes = FULL ? NT / 32 : (p.cols + 31) / 32;
            pb.srcStride = LK / 32;
            pb.dstGap = 1;
            pb.dstFracGap = 0;
            for (int ki = 0; ki < fk / 32; ++ki)
                LoadDataWithTranspose(bb[ki * activeN * 32], lb[ki * 1024], pb);
            SetFlag<HardEvent::MTE1_M>(fs);
            WaitFlag<HardEvent::MTE1_M>(fs);
            MmadParams mm;
            mm.m = actualM;
            mm.n = activeN;
            mm.k = fk;
            mm.cmatrixInitVal = p.first && f == 0;
            mm.unitFlag = p.last && f + FK >= physicalK ? 3 : 2;
            Mmad(c, aa, bb, mm);
            if (actualM * activeN < 2560)
                PipeBarrier<PIPE_M>();
            SetFlag<HardEvent::M_MTE1>(fs);
            fragmentSlot ^= 1;
        }
        SetFlag<HardEvent::MTE1_MTE2>(p.slot);
        if (p.last)
        {
            GlobalTensor<int32_t> dst;
            dst.SetGlobalBuffer((__gm__ int32_t *)p.output);
            if constexpr (!SPLIT)
                CrossCoreWaitFlag(2 + p.outputSlot);
            FixpipeParamsV220 fp;
            fp.nSize = activeN;
            fp.mSize = MT >= 256 ? MT : p.rows;
            fp.srcStride = actualM;
            fp.dstStride = activeN;
            fp.quantPre = QuantMode_t::NoQuant;
            fp.reluEn = false;
            fp.unitFlag = 3;
            Fixpipe<int32_t, int32_t, CFG_ROW_MAJOR>(dst, c, fp);
            SetFlag<HardEvent::FIX_M>(cslot);
            if constexpr (!SPLIT)
                CrossCoreSetFlag<2, PIPE_FIX>(p.outputSlot);
        }
    }

    __aicore__ inline void Consume(const Pending &p)
    {
        if (p.rows == MT && p.cols == NT && p.count == LK)
            ConsumeTile<true>(p);
        else
            ConsumeTile<false>(p);
    }

  public:
    __aicore__ inline void Init()
    {
        SetLoadDataPaddingValue<uint64_t>(0);
        SetFixpipeNz2ndFlag(1, 0, 0);
        for (int i = 0; i < STAGES; ++i)
            SetFlag<HardEvent::MTE1_MTE2>(i);
        for (int i = 0; i < 2; ++i)
        {
            SetFlag<HardEvent::M_MTE1>(i);
        }
        for (int i = 0; i < CSLOTS; ++i)
            SetFlag<HardEvent::FIX_M>(i);
    }

    __aicore__ inline void Compute(const GlobalTensor<int8_t> &a, const GlobalTensor<int8_t> &b,
                                   const GlobalTensor<int32_t> &dst, int rows, int cols, int K,
                                   int N, int start, int depth, int outputSlot, int bKPad = 0)
    {
        const int panels = (depth + LK - 1) / LK;
        for (int p = 0; p < panels; ++p)
        {
            const int slot = producer;
            int ki = p;
            if constexpr (MT >= 64 && NT >= 128)
                ki = (p + GetBlockIdx()) % panels;
            const int count = Min(LK, depth - ki * LK);
            WaitFlag<HardEvent::MTE1_MTE2>(slot);
            CopyNd(l1[slot * PANEL], a[start + ki * LK], rows, count, K, MT);
            if constexpr (NZ)
                DataCopy(l1[slot * PANEL + MT * LK], b[int64_t(start + ki * LK) * 32],
                         DataCopyParams((cols + 31) / 32, Up(count, 32), bKPad - Up(count, 32),
                                        LK - Up(count, 32)));
            else
                CopyNd(l1[slot * PANEL + MT * LK], b[int64_t(start + ki * LK) * N], count, cols, N,
                       LK);
            SetFlag<HardEvent::MTE2_MTE1>(slot);
            // Keep two pending panels across output tiles, so the next tile's
            // input transfer overlaps the current tile's final MMAD/Fixpipe.
            if (pendingCount == (STAGES < 3 ? 1 : 2))
            {
                Consume(pending[head]);
                pending[head] = {slot,   count,          rows,
                                 cols,   outputSlot,     (GM_ADDR)dst.GetPhyAddr(),
                                 p == 0, p + 1 == panels};
                if constexpr (STAGES >= 3)
                    head ^= 1;
            }
            else
            {
                pending[(head + pendingCount) & 1] = {
                    slot,   count,          rows, cols, outputSlot, (GM_ADDR)dst.GetPhyAddr(),
                    p == 0, p + 1 == panels};
                ++pendingCount;
            }
            producer = producer + 1 < STAGES ? producer + 1 : 0;
        }
    }

    __aicore__ inline void Finish()
    {
        while (pendingCount)
        {
            Consume(pending[head]);
            if constexpr (STAGES >= 3)
                head ^= 1;
            --pendingCount;
        }
        for (int i = 0; i < STAGES; ++i)
            WaitFlag<HardEvent::MTE1_MTE2>(i);
        for (int i = 0; i < 2; ++i)
        {
            WaitFlag<HardEvent::M_MTE1>(i);
        }
        for (int i = 0; i < CSLOTS; ++i)
            WaitFlag<HardEvent::FIX_M>(i);
    }
};

template <int MT, int NT, int LK, int ST, int RM>
__global__ __mix__(1, 2)
    __attribute__((aligned(4096))) void Stream(GM_ADDR x, GM_ADDR weight, GM_ADDR scale,
                                               GM_ADDR groups, GM_ADDR y, GM_ADDR workspace,
                                               GM_ADDR packedA, GM_ADDR packedB, int M, int K,
                                               int N, int E, int workers, int AP, int NP)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
    SetAtomicNone();
    int core = GetBlockIdx();
    if ASCEND_IS_AIV
    {
        core /= GetSubBlockNum();
    }
    GlobalTensor<int8_t> a, b;
    GlobalTensor<int64_t> g;
    GlobalTensor<float> s;
    GlobalTensor<half> out;
    GlobalTensor<int32_t> buffer;
    a.SetGlobalBuffer((__gm__ int8_t *)x);
    b.SetGlobalBuffer((__gm__ int8_t *)weight);
    g.SetGlobalBuffer((__gm__ int64_t *)groups);
    s.SetGlobalBuffer((__gm__ float *)scale);
    out.SetGlobalBuffer((__gm__ half *)y);
    buffer.SetGlobalBuffer((__gm__ int32_t *)workspace);
    if (AP != K || NP != N)
    {
        if ASCEND_IS_AIV
        {
            TPipe pipe;
            SetMaskNorm();
            SetVectorMask<uint8_t>(~uint64_t(0), ~uint64_t(0));
            if (AP != K)
            {
                GlobalTensor<int8_t> pa;
                pa.SetGlobalBuffer((__gm__ int8_t *)packedA);
                grouped_gelu::PackRows(a, pa, M, K, AP, workers * 2);
            }
            if (NP != N)
            {
                GlobalTensor<int8_t> pb;
                pb.SetGlobalBuffer((__gm__ int8_t *)packedB);
                grouped_gelu::PackRows(b, pb, E * K, N, NP, workers * 2);
            }
            CrossCoreSetFlag<0, PIPE_MTE3>(10);
            CrossCoreWaitFlag(10);
            CrossCoreSetFlag<2, PIPE_MTE3>(8);
        }
        if ASCEND_IS_AIC
        {
            CrossCoreWaitFlag(8);
        }
        if (AP != K)
            a.SetGlobalBuffer((__gm__ int8_t *)packedA);
        if (NP != N)
            b.SetGlobalBuffer((__gm__ int8_t *)packedB);
    }
    const int columns = (N + NT - 1) / NT;
    const int rowTiles = (M + RM - 1) / RM;
    const int begin = core * rowTiles / workers * RM;
    const int limit = Min(M, (core + 1) * rowTiles / workers * RM);
    if ASCEND_IS_AIC
    {
        Cube<MT, NT, false, LK, ST> cube;
        cube.Init();
        int lo = 0, hi = E - 1;
        while (lo < hi)
        {
            const int mid = (lo + hi) / 2;
            if (g.GetValue(mid) <= begin)
                lo = mid + 1;
            else
                hi = mid;
        }
        int row = begin, sequence = 0;
        for (int e = lo; e < E && row < limit; ++e)
        {
            const int end = Min(limit, int(g.GetValue(e)));
            while (row < end)
            {
                const int rows = Min(MT, end - row);
                for (int nc = 0; nc < columns; ++nc)
                {
                    const int col = nc * NT, slot = sequence++ & 1;
                    cube.Compute(a[int64_t(row) * AP], b[int64_t(e) * K * NP + col],
                                 buffer[int64_t(core * 2 + slot) * MT * NT], rows, Min(NT, N - col),
                                 AP, NP, 0, K, slot);
                }
                row += rows;
            }
        }
        cube.Finish();
    }
    if ASCEND_IS_AIV
    {
        TPipe pipe;
        SetMaskNorm();
        SetVectorMask<uint8_t>(~uint64_t(0), ~uint64_t(0));
        LocalTensor<int64_t> ends(TPosition::VECCALC, 172032, 128);
        DataCopyPad(ends, g, DataCopyExtParams(1, E * 8, 0, 0, 0),
                    DataCopyPadExtParams<int64_t>{false, 0, 0, 0});
        SetFlag<HardEvent::MTE2_S>(EVENT_ID4);
        WaitFlag<HardEvent::MTE2_S>(EVENT_ID4);
        CrossCoreSetFlag<2, PIPE_MTE2>(2);
        CrossCoreSetFlag<2, PIPE_MTE2>(3);
        int lo = 0, hi = E - 1;
        while (lo < hi)
        {
            const int mid = (lo + hi) / 2;
            if (ends.GetValue(mid) <= begin)
                lo = mid + 1;
            else
                hi = mid;
        }
        int row = begin, sequence = 0;
        grouped_gelu::Epilogue<MT, NT> epilogue;
        for (int e = lo; e < E && row < limit; ++e)
        {
            const int end = Min(limit, int(ends.GetValue(e)));
            while (row < end)
            {
                const int rows = Min(MT, end - row);
                for (int nc = 0; nc < columns; ++nc)
                {
                    const int col = nc * NT, slot = sequence++ & 1;
                    CrossCoreWaitFlag(slot);
                    epilogue.Run(buffer[int64_t(core * 2 + slot) * MT * NT], s, out, row, col, rows,
                                 Min(NT, N - col), N, e, 1, slot);
                }
                row += rows;
            }
        }
    }
}

template <int MT, int NT, int LK = 256, int ST = 3, int RM = MT, bool PACK = true>
inline void Launch(GM_ADDR x, GM_ADDR b, GM_ADDR s, GM_ADDR g, GM_ADDR y, int M, int K, int N,
                   int E, int cores, aclrtStream stream)
{
    const int workers = std::min(cores, (M + RM - 1) / RM);
    const int AP = PACK && K % 4 ? (K + 31) / 32 * 32 : K;
    const int NP = PACK && N % 4 ? (N + 31) / 32 * 32 : N;
    const size_t cBytes = size_t(workers) * 2 * MT * NT * 4;
    const size_t aBytes = AP == K ? 0 : size_t(M) * AP;
    const size_t bBytes = NP == N ? 0 : size_t(E) * K * NP;
    Workspace memory(cBytes + aBytes + bBytes, stream);
    if (!memory.Data())
        return;
    Stream<MT, NT, LK, ST, RM><<<workers, nullptr, stream>>>(
        x, b, s, g, y, memory.Data(), memory.Data() + cBytes, memory.Data() + cBytes + aBytes, M, K,
        N, E, workers, AP, NP);
    memory.Complete();
}

}

namespace shallow_vector
{
using namespace AscendC;
using grouped_gelu::Min;
using grouped_gelu::Up;

template <int NT>
__global__ __vector__ __attribute__((aligned(4096))) void
Run(GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groups, GM_ADDR y, int M, int K, int N, int E,
    int workers)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    TPipe pipe;
    SetMaskNorm();
    SetVectorMask<uint8_t>(~uint64_t(0), ~uint64_t(0));
    constexpr int ROWS = 4096 / NT, SIZE = 4096;
    GlobalTensor<int8_t> a, b;
    GlobalTensor<float> s;
    GlobalTensor<int64_t> g;
    GlobalTensor<half> result;
    a.SetGlobalBuffer((__gm__ int8_t *)x);
    b.SetGlobalBuffer((__gm__ int8_t *)weight);
    s.SetGlobalBuffer((__gm__ float *)scale);
    g.SetGlobalBuffer((__gm__ int64_t *)groups);
    result.SetGlobalBuffer((__gm__ half *)y);
    LocalTensor<int32_t> accum(TPosition::VECCALC, 0, SIZE);
    LocalTensor<float> temporary(TPosition::VECCALC, 16384, SIZE);
    LocalTensor<int32_t> expanded(TPosition::VECCALC, 32768, SIZE);
    LocalTensor<int32_t> indices(TPosition::VECCALC, 49152, SIZE);
    LocalTensor<half> output(TPosition::VECCALC, 65536, SIZE);
    LocalTensor<int32_t> av(TPosition::VECCALC, 73728, ROWS * 16);
    LocalTensor<int32_t> bv(TPosition::VECCALC, 81920, 16 * NT);
    LocalTensor<float> sv(TPosition::VECCALC, 86016, NT);
    LocalTensor<int64_t> ends(TPosition::VECCALC, 87040, 128);
    LocalTensor<int8_t> ar(TPosition::VECCALC, 90112, ROWS * 16);
    LocalTensor<int8_t> br(TPosition::VECCALC, 94208, 16 * NT);
    LocalTensor<half> ah(TPosition::VECCALC, 96256, ROWS * 16);
    LocalTensor<half> bh(TPosition::VECCALC, 102400, 16 * NT);
    LocalTensor<int32_t> column(TPosition::VECCALC, 106496, ROWS);
    LocalTensor<int32_t> rowValues(TPosition::VECCALC, 110592, ROWS * 8);
    DataCopyPad(ends, g, DataCopyExtParams(1, E * 8, 0, 0, 0),
                DataCopyPadExtParams<int64_t>{false, 0, 0, 0});
    SetFlag<HardEvent::MTE2_S>(EVENT_ID4);
    WaitFlag<HardEvent::MTE2_S>(EVENT_ID4);
    const int tiles = (M + 15) / 16, begin = GetBlockIdx() * tiles / workers * 16;
    const int limit = Min(M, (GetBlockIdx() + 1) * tiles / workers * 16);
    int lo = 0, hi = E - 1;
    while (lo < hi)
    {
        const int mid = (lo + hi) / 2;
        if (ends.GetValue(mid) <= begin)
            lo = mid + 1;
        else
            hi = mid;
    }
    int row = begin;
    for (int e = lo; e < E && row < limit; ++e)
    {
        const int end = Min(limit, int(ends.GetValue(e)));
        if (row == end)
            continue;
        Duplicate(br.ReinterpretCast<uint16_t>(), uint16_t(0), K * NT / 2);
        Duplicate(sv, 0.0f, NT);
        SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
        WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
        DataCopyPad(br, b[int64_t(e) * K * N], DataCopyExtParams(K, N, 0, (NT - Up(N, 32)) / 32, 0),
                    DataCopyPadExtParams<int8_t>{true, 0, uint8_t(Up(N, 32) - N), 0});
        DataCopyPad(sv, s[e * N], DataCopyExtParams(1, N * 4, 0, 0, 0),
                    DataCopyPadExtParams<float>{false, 0, 0, 0});
        SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
        WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
        Cast(bh, br, RoundMode::CAST_NONE, K * NT);
        PipeBarrier<PIPE_V>();
        Cast(bv, bh, RoundMode::CAST_RINT, K * NT);
        PipeBarrier<PIPE_V>();
        while (row < end)
        {
            const int rows = Min(ROWS, end - row), count = rows * NT, rounded = Up(rows, 8);
            DataCopyPad(ar, a[int64_t(row) * K], DataCopyExtParams(1, rows * K, 0, 0, 0),
                        DataCopyPadExtParams<int8_t>{false, 0, 0, 0});
            SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
            WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
            Cast(ah, ar, RoundMode::CAST_NONE, rows * K);
            PipeBarrier<PIPE_V>();
            Cast(av, ah, RoundMode::CAST_RINT, rows * K);
            PipeBarrier<PIPE_V>();
            CreateVecIndex(indices, int32_t(0), rounded);
            PipeBarrier<PIPE_V>();
            Muls(indices, indices, int32_t(K * 4), rounded);
            Duplicate(accum, int32_t(0), count);
            Duplicate(column, int32_t(0), rounded);
            PipeBarrier<PIPE_V>();
            for (int k = 0; k < K; ++k)
            {
                Gather(column, av, indices.ReinterpretCast<uint32_t>(), k * 4, rows);
                PipeBarrier<PIPE_V>();
                Brcb(rowValues, column, rounded / 8, {1, 8});
                PipeBarrier<PIPE_V>();
                Mul(expanded, rowValues, bv[k * NT], NT, rows, {1, 0, 1, uint8_t(NT / 8), 1, 0});
                PipeBarrier<PIPE_V>();
                Add(accum, accum, expanded, count);
                PipeBarrier<PIPE_V>();
            }
            auto z = accum.ReinterpretCast<float>();
            Cast(z, accum, RoundMode::CAST_RINT, count);
            PipeBarrier<PIPE_V>();
            Mul(z, z, sv, NT, rows, {1, 1, 1, uint8_t(NT / 8), uint8_t(NT / 8), 0});
            PipeBarrier<PIPE_V>();
            grouped_gelu::Gelu(z, temporary, output, count);
            const bool compact = N != NT;
            auto packed = temporary.ReinterpretCast<half>();
            if (compact)
            {
                const int length = rows * N;
                PipeBarrier<PIPE_V>();
                CreateVecIndex(accum, int32_t(0), length);
                PipeBarrier<PIPE_V>();
                Cast(temporary, accum, RoundMode::CAST_RINT, length);
                PipeBarrier<PIPE_V>();
                Muls(temporary, temporary, 1.0f / N, length);
                PipeBarrier<PIPE_V>();
                Adds(temporary, temporary, 0.0001f, length);
                PipeBarrier<PIPE_V>();
                auto ri = temporary.ReinterpretCast<int32_t>();
                Cast(ri, temporary, RoundMode::CAST_FLOOR, length);
                PipeBarrier<PIPE_V>();
                Muls(ri, ri, int32_t(2 * (NT - N)), length);
                Muls(accum, accum, int32_t(2), length);
                PipeBarrier<PIPE_V>();
                Add(accum, accum, ri, length);
                PipeBarrier<PIPE_V>();
                Gather(packed, output, accum.ReinterpretCast<uint32_t>(), 0, length);
            }
            SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
            WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
            DataCopyPad(result[int64_t(row) * N], compact ? packed : output,
                        DataCopyExtParams(1, rows * N * 2, 0, 0, 0));
            SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
            WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
            row += rows;
        }
    }
}

inline void Launch(GM_ADDR x, GM_ADDR b, GM_ADDR s, GM_ADDR g, GM_ADDR y, int M, int K, int N,
                   int E, int cores, aclrtStream stream)
{
    const int workers = std::min(cores * 2, (M + 15) / 16);
    if (N <= 32)
        Run<32><<<workers, nullptr, stream>>>(x, b, s, g, y, M, K, N, E, workers);
    else
        Run<64><<<workers, nullptr, stream>>>(x, b, s, g, y, M, K, N, E, workers);
}
}

namespace padded_rows
{
using namespace AscendC;
using grouped_gelu::Min;
using grouped_gelu::Up;
using grouped_gelu::Workspace;
using grouped_gelu::Gelu;
template <int MT, int NT, bool SPLIT, int LK = 256, int NSTAGES = 3, bool NZ = false> class Cube
{
    static constexpr int FK = MT >= 256 || NT > 256 ? 64 : 128;
    static constexpr int STAGES = NSTAGES;
    static constexpr int PANEL = (MT + NT) * LK;
    static constexpr int CSLOTS = MT * NT * 4 <= 65536 ? 2 : 1;
    static_assert(STAGES * PANEL <= 524288, "L1 capacity exceeded");
    static_assert(2 * MT * FK <= 65536 && 2 * NT * FK <= 65536, "L0A/B capacity exceeded");
    static_assert(CSLOTS * MT * NT * 4 <= 131072, "L0C capacity exceeded");
    LocalTensor<int8_t> l1{TPosition::A1, 0, STAGES * PANEL};
    LocalTensor<int8_t> a0{TPosition::A2, 0, 2 * MT * FK};
    LocalTensor<int8_t> b0{TPosition::B2, 0, 2 * NT * FK};
    LocalTensor<int32_t> c0{TPosition::CO1, 0, CSLOTS * MT * NT};
    int fragmentSlot = 0;
    struct Pending
    {
        int slot, count, rows, cols, outputSlot;
        GM_ADDR output;
        bool first, last;
    };
    Pending pending[2];
    int head = 0, pendingCount = 0, producer = 0;

    __aicore__ inline void CopyNd(const LocalTensor<int8_t> &dst, const GlobalTensor<int8_t> &src,
                                  int rows, int cols, int stride, int paddedRows)
    {
        grouped_gelu::CopyNdShared(dst, src, rows, cols, stride, paddedRows);
    }

    template <bool FULL> __aicore__ inline void ConsumeTile(const Pending &p)
    {
        const int cslot = p.outputSlot % CSLOTS;
        if (p.first)
            WaitFlag<HardEvent::FIX_M>(cslot);
        auto c = c0[cslot * MT * NT];
        WaitFlag<HardEvent::MTE2_MTE1>(p.slot);
        const int actualM = FULL || MT >= 256 ? MT : Up(p.rows, 16);
        const int activeN = FULL || MT >= 256 || actualM < 32 ? NT : Up(p.cols, 32);
        const int physicalK = FULL ? LK : p.count;
#pragma unroll
        for (int f = 0; f < physicalK; f += FK)
        {
            const int fk = Up(Min(FK, physicalK - f), 32);
            const int fs = fragmentSlot;
            WaitFlag<HardEvent::M_MTE1>(fs);
            auto aa = a0[fs * MT * FK];
            auto bb = b0[fs * NT * FK];
            auto la = l1[p.slot * PANEL + f * MT];
            auto lb = l1[p.slot * PANEL + MT * LK + f * 32];
            LoadData2DParams pa;
            pa.startIndex = 0;
            pa.repeatTimes = fk / 32;
            pa.srcStride = MT / 16;
            pa.dstGap = 0;
            pa.ifTranspose = false;
            pa.sid = 0;
            pa.addrMode = 0;
            for (int mi = 0; mi < (FULL ? MT / 16 : (p.rows + 15) / 16); ++mi)
                LoadData(aa[mi * fk * 16], la[mi * 512], pa);
            LoadData2dTransposeParams pb;
            pb.startIndex = 0;
            pb.repeatTimes = FULL ? NT / 32 : (p.cols + 31) / 32;
            pb.srcStride = LK / 32;
            pb.dstGap = 1;
            pb.dstFracGap = 0;
            for (int ki = 0; ki < fk / 32; ++ki)
                LoadDataWithTranspose(bb[ki * activeN * 32], lb[ki * 1024], pb);
            SetFlag<HardEvent::MTE1_M>(fs);
            WaitFlag<HardEvent::MTE1_M>(fs);
            MmadParams mm;
            mm.m = actualM;
            mm.n = activeN;
            mm.k = fk;
            mm.cmatrixInitVal = p.first && f == 0;
            mm.unitFlag = p.last && f + FK >= physicalK ? 3 : 2;
            Mmad(c, aa, bb, mm);
            if (actualM * activeN < 2560)
                PipeBarrier<PIPE_M>();
            SetFlag<HardEvent::M_MTE1>(fs);
            fragmentSlot ^= 1;
        }
        SetFlag<HardEvent::MTE1_MTE2>(p.slot);
        if (p.last)
        {
            GlobalTensor<int32_t> dst;
            dst.SetGlobalBuffer((__gm__ int32_t *)p.output);
            if constexpr (!SPLIT)
                CrossCoreWaitFlag(2 + p.outputSlot);
            FixpipeParamsV220 fp;
            fp.nSize = activeN;
            fp.mSize = MT >= 256 ? MT : p.rows;
            fp.srcStride = actualM;
            fp.dstStride = activeN;
            fp.quantPre = QuantMode_t::NoQuant;
            fp.reluEn = false;
            fp.unitFlag = 3;
            Fixpipe<int32_t, int32_t, CFG_ROW_MAJOR>(dst, c, fp);
            SetFlag<HardEvent::FIX_M>(cslot);
            if constexpr (!SPLIT)
                CrossCoreSetFlag<2, PIPE_FIX>(p.outputSlot);
        }
    }

    __aicore__ inline void Consume(const Pending &p)
    {
        ConsumeTile<true>(p);
    }

  public:
    __aicore__ inline void Init()
    {
        SetLoadDataPaddingValue<uint64_t>(0);
        SetFixpipeNz2ndFlag(1, 0, 0);
        for (int i = 0; i < STAGES; ++i)
            SetFlag<HardEvent::MTE1_MTE2>(i);
        for (int i = 0; i < 2; ++i)
        {
            SetFlag<HardEvent::M_MTE1>(i);
        }
        for (int i = 0; i < CSLOTS; ++i)
            SetFlag<HardEvent::FIX_M>(i);
    }

    __aicore__ inline void Compute(const GlobalTensor<int8_t> &a, const GlobalTensor<int8_t> &b,
                                   const GlobalTensor<int32_t> &dst, int rows, int cols, int K,
                                   int N, int start, int depth, int outputSlot, int bKPad = 0)
    {
        const int panels = depth / LK;
        for (int p = 0; p < panels; ++p)
        {
            const int slot = producer;
            int ki = p;
            if constexpr (MT >= 64 && NT >= 128)
                ki = (p + GetBlockIdx()) % panels;
            const int count = LK;
            WaitFlag<HardEvent::MTE1_MTE2>(slot);
            CopyNd(l1[slot * PANEL], a[start + ki * LK], rows, count, K, MT);
            if constexpr (NZ)
                DataCopy(l1[slot * PANEL + MT * LK], b[int64_t(start + ki * LK) * 32],
                         DataCopyParams((cols + 31) / 32, Up(count, 32), bKPad - Up(count, 32),
                                        LK - Up(count, 32)));
            else
                CopyNd(l1[slot * PANEL + MT * LK], b[int64_t(start + ki * LK) * N], count, cols, N,
                       LK);
            SetFlag<HardEvent::MTE2_MTE1>(slot);
            // Keep two pending panels across output tiles, so the next tile's
            // input transfer overlaps the current tile's final MMAD/Fixpipe.
            if (pendingCount == (STAGES < 3 ? 1 : 2))
            {
                Consume(pending[head]);
                pending[head] = {slot,   count,          rows,
                                 cols,   outputSlot,     (GM_ADDR)dst.GetPhyAddr(),
                                 p == 0, p + 1 == panels};
                if constexpr (STAGES >= 3)
                    head ^= 1;
            }
            else
            {
                pending[(head + pendingCount) & 1] = {
                    slot,   count,          rows, cols, outputSlot, (GM_ADDR)dst.GetPhyAddr(),
                    p == 0, p + 1 == panels};
                ++pendingCount;
            }
            producer = producer + 1 < STAGES ? producer + 1 : 0;
        }
    }

    __aicore__ inline void Finish()
    {
        while (pendingCount)
        {
            Consume(pending[head]);
            if constexpr (STAGES >= 3)
                head ^= 1;
            --pendingCount;
        }
        for (int i = 0; i < STAGES; ++i)
            WaitFlag<HardEvent::MTE1_MTE2>(i);
        for (int i = 0; i < 2; ++i)
        {
            WaitFlag<HardEvent::M_MTE1>(i);
        }
        for (int i = 0; i < CSLOTS; ++i)
            WaitFlag<HardEvent::FIX_M>(i);
    }
};

template <int MT, int NT> class Epilogue
{
    static constexpr int ROWS = (MT + 1) / 2;
    static constexpr int SIZE = ROWS * NT;
    static_assert(SIZE * 10 + NT * 4 + 256 <= 196608, "UB capacity exceeded");
    LocalTensor<int32_t> accum{TPosition::VECCALC, 0, SIZE};
    LocalTensor<float> temporary{TPosition::VECCALC, SIZE * 4 + 256, SIZE};
    LocalTensor<half> output{TPosition::VECCALC, SIZE * 8 + 256, SIZE};
    LocalTensor<float> scales{TPosition::VECCALC, SIZE * 10 + 256, NT};

  public:
    __aicore__ inline void Run(const GlobalTensor<int32_t> &src, const GlobalTensor<float> &scale,
                               const GlobalTensor<half> &y, int row, int col, int rows, int cols,
                               int N, int expert, int shards = 1, int slot = 0)
    {
        const int pitch = NT;
        const int first = GetSubBlockIdx() * ((rows + 1) / 2);
        const int valid = GetSubBlockIdx() ? rows / 2 : (rows + 1) / 2;
        if (valid <= 0)
        {
            if (shards == 1)
                CrossCoreSetFlag<2, PIPE_MTE2>(2 + slot);
            return;
        }
        DataCopy(accum, src[first * pitch], valid * pitch);
        Duplicate(scales, 0.0f, NT);
        SetFlag<HardEvent::V_MTE2>(EVENT_ID1);
        WaitFlag<HardEvent::V_MTE2>(EVENT_ID1);
        DataCopyPad(scales, scale[expert * N + col], DataCopyExtParams(1, cols * 4, 0, 0, 0),
                    DataCopyPadExtParams<float>{false, 0, 0, 0.0f});
        SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
        WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
        for (int s = 1; s < shards; ++s)
        {
            auto part = temporary.template ReinterpretCast<int32_t>();
            DataCopy(part, src[s * MT * NT + first * pitch], valid * pitch);
            SetFlag<HardEvent::MTE2_V>(EVENT_ID1);
            WaitFlag<HardEvent::MTE2_V>(EVENT_ID1);
            Add(accum, accum, part, valid * pitch);
            SetFlag<HardEvent::V_MTE2>(EVENT_ID1);
            WaitFlag<HardEvent::V_MTE2>(EVENT_ID1);
        }
        if (shards == 1)
            CrossCoreSetFlag<2, PIPE_MTE2>(2 + slot);
        auto z = accum.template ReinterpretCast<float>();
        Cast(z, accum, RoundMode::CAST_RINT, valid * pitch);
        PipeBarrier<PIPE_V>();
        // Repeat a channel vector across rows without materializing a broadcast.
        for (int r = 0; r < valid; r += 128)
            for (int c = 0; c < pitch; c += 64)
            {
                const int width = Min(64, pitch - c);
                Mul(z[r * pitch + c], z[r * pitch + c], scales[c], width, Min(128, valid - r),
                    {1, 1, 1, uint8_t(pitch / 8), uint8_t(pitch / 8), 0});
            }
        PipeBarrier<PIPE_V>();
        Gelu(z, temporary, output, valid * pitch);
        const bool compact =
            N == cols && col == 0 && N < NT && N <= 256 && N % 16 != 0 && valid >= 16;
        auto packed = temporary.template ReinterpretCast<half>();
        if (compact)
        {
            // Gather each narrow row into a contiguous UB stream. A single
            // MTE3 transfer avoids hundreds of short, unaligned row writes.
            const int count = valid * N;
            PipeBarrier<PIPE_V>();
            CreateVecIndex(accum, int32_t(0), count);
            PipeBarrier<PIPE_V>();
            Cast(temporary, accum, RoundMode::CAST_RINT, count);
            PipeBarrier<PIPE_V>();
            Muls(temporary, temporary, 1.0f / N, count);
            PipeBarrier<PIPE_V>();
            // i < 256*64: this bias dominates reciprocal rounding but is
            // smaller than the distance 1/N to the next integer boundary.
            Adds(temporary, temporary, 0.0001f, count);
            PipeBarrier<PIPE_V>();
            auto rows = temporary.template ReinterpretCast<int32_t>();
            Cast(rows, temporary, RoundMode::CAST_FLOOR, count);
            PipeBarrier<PIPE_V>();
            Muls(rows, rows, int32_t(2 * (pitch - N)), count);
            Muls(accum, accum, int32_t(2), count);
            PipeBarrier<PIPE_V>();
            Add(accum, accum, rows, count);
            PipeBarrier<PIPE_V>();
            Gather(packed, output, accum.template ReinterpretCast<uint32_t>(), 0, count);
        }
        SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
        WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
        if (compact)
            DataCopyPad(y[int64_t(row + first) * N], packed,
                        DataCopyExtParams(1, valid * N * 2, 0, 0, 0));
        else
            DataCopyPad(
                y[int64_t(row + first) * N + col], output,
                DataCopyExtParams(valid, cols * 2, (pitch - Up(cols, 16)) / 16, (N - cols) * 2, 0));
        SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
        WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
        SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
        WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
    }
};

__aicore__ inline void PadA(const GlobalTensor<int8_t> &a, const GlobalTensor<int8_t> &pa, int M,
                            int K, int AP, int extra, int workers)
{
    LocalTensor<int8_t> work(TPosition::VECCALC, 0, 65536);
    auto zero = work.ReinterpretCast<uint16_t>();
    const int batch = Min(128, Min(65536 / AP, Up((M + workers - 1) / workers, 16)));
    const int tiles = (M + batch - 1) / batch;
    SetFlag<HardEvent::MTE3_V>(EVENT_ID4);
    for (int tile = GetBlockIdx(); tile < tiles; tile += workers)
    {
        const int row = tile * batch, count = Min(batch, M - row);
        WaitFlag<HardEvent::MTE3_V>(EVENT_ID4);
        if (AP != K)
            Duplicate(zero, uint16_t(0), count * AP / 2);
        SetFlag<HardEvent::V_MTE2>(EVENT_ID4);
        WaitFlag<HardEvent::V_MTE2>(EVENT_ID4);
        if (AP == K)
            DataCopy(work, a[int64_t(row) * K], count * K);
        else
        {
            DataCopyPad(work, a[int64_t(row) * K],
                        DataCopyExtParams(count, K, 0, (AP - Up(K, 32)) / 32, 0),
                        DataCopyPadExtParams<int8_t>{true, 0, uint8_t(Up(K, 32) - K), 0});
        }
        SetFlag<HardEvent::MTE2_MTE3>(EVENT_ID4);
        WaitFlag<HardEvent::MTE2_MTE3>(EVENT_ID4);
        DataCopy(pa[int64_t(row) * AP], work, count * AP);
        SetFlag<HardEvent::MTE3_V>(EVENT_ID4);
    }
    WaitFlag<HardEvent::MTE3_V>(EVENT_ID4);
    Duplicate(zero, uint16_t(0), 32768);
    SetFlag<HardEvent::V_MTE3>(EVENT_ID4);
    WaitFlag<HardEvent::V_MTE3>(EVENT_ID4);
    for (int64_t off = int64_t(GetBlockIdx()) * 65536; off < int64_t(extra) * AP;
         off += int64_t(workers) * 65536)
        DataCopy(pa[int64_t(M) * AP + off], work, Min(65536, int(int64_t(extra) * AP - off)));
    SetFlag<HardEvent::MTE3_V>(EVENT_ID4);
    WaitFlag<HardEvent::MTE3_V>(EVENT_ID4);
}

__aicore__ inline void PadB(const GlobalTensor<int8_t> &b, const GlobalTensor<int8_t> &pb,
                            const GlobalTensor<int64_t> &g, int K, int N, int E, int AP, int NP,
                            int workers)
{
    LocalTensor<int8_t> work(TPosition::VECCALC, 0, 65536);
    LocalTensor<int64_t> ends(TPosition::VECCALC, 172032, 128);
    DataCopyPad(ends, g, DataCopyExtParams(1, E * 8, 0, 0, 0),
                DataCopyPadExtParams<int64_t>{false, 0, 0, 0});
    SetFlag<HardEvent::MTE2_S>(EVENT_ID6);
    WaitFlag<HardEvent::MTE2_S>(EVENT_ID6);
    int active[128], amount = 0, previous = 0;
    for (int e = 0; e < E; ++e)
    {
        const int end = int(ends.GetValue(e));
        if (end > previous)
            active[amount++] = e;
        previous = end;
    }
    const int batches = AP / 128;
    SetFlag<HardEvent::MTE3_V>(EVENT_ID5);
    for (int task = GetBlockIdx(); task < amount * batches; task += workers)
    {
        const int expert = active[task / batches], first = task % batches * 128;
        const int count = first < K ? Min(128, K - first) : 0;
        WaitFlag<HardEvent::MTE3_V>(EVENT_ID5);
        Duplicate(work.ReinterpretCast<uint16_t>(), uint16_t(0), 128 * NP / 2);
        SetFlag<HardEvent::V_MTE2>(EVENT_ID5);
        WaitFlag<HardEvent::V_MTE2>(EVENT_ID5);
        if (count)
            DataCopyPad(work, b[int64_t(expert) * K * N + int64_t(first) * N],
                        DataCopyExtParams(count, N, 0, (NP - Up(N, 32)) / 32, 0),
                        DataCopyPadExtParams<int8_t>{true, 0, uint8_t(Up(N, 32) - N), 0});
        SetFlag<HardEvent::MTE2_MTE3>(EVENT_ID5);
        WaitFlag<HardEvent::MTE2_MTE3>(EVENT_ID5);
        DataCopy(pb[int64_t(expert) * AP * NP + int64_t(first) * NP], work, 128 * NP);
        SetFlag<HardEvent::MTE3_V>(EVENT_ID5);
    }
    WaitFlag<HardEvent::MTE3_V>(EVENT_ID5);
}

template <int MT, int NT>
__global__ __mix__(1, 2)
    __attribute__((aligned(4096))) void Run(GM_ADDR x, GM_ADDR weight, GM_ADDR scale,
                                            GM_ADDR groups, GM_ADDR y, GM_ADDR workspace,
                                            GM_ADDR packedA, GM_ADDR packedB, int M, int K, int N,
                                            int E, int AP, int workers)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
    SetAtomicNone();
    int core = GetBlockIdx();
    if ASCEND_IS_AIV
    {
        core /= GetSubBlockNum();
    }
    GlobalTensor<int8_t> a, b, pa, pb;
    GlobalTensor<int64_t> g;
    GlobalTensor<float> s;
    GlobalTensor<int32_t> buffer;
    GlobalTensor<half> out;
    a.SetGlobalBuffer((__gm__ int8_t *)x);
    b.SetGlobalBuffer((__gm__ int8_t *)weight);
    pa.SetGlobalBuffer((__gm__ int8_t *)packedA);
    pb.SetGlobalBuffer((__gm__ int8_t *)packedB);
    g.SetGlobalBuffer((__gm__ int64_t *)groups);
    s.SetGlobalBuffer((__gm__ float *)scale);
    buffer.SetGlobalBuffer((__gm__ int32_t *)workspace);
    out.SetGlobalBuffer((__gm__ half *)y);
    if ASCEND_IS_AIV
    {
        TPipe pipe;
        SetMaskNorm();
        SetVectorMask<uint8_t>(~uint64_t(0), ~uint64_t(0));
        PadA(a, pa, M, K, AP, MT - 1, workers * 2);
        PadB(b, pb, g, K, N, E, AP, NT, workers * 2);
        CrossCoreSetFlag<0, PIPE_MTE3>(10);
        CrossCoreWaitFlag(10);
        CrossCoreSetFlag<2, PIPE_MTE3>(8);
    }
    constexpr int RM = MT < 128 ? MT : 128;
    const int tiles = (M + RM - 1) / RM, begin = core * tiles / workers * RM;
    const int limit = Min(M, (core + 1) * tiles / workers * RM);
    if ASCEND_IS_AIC
    {
        CrossCoreWaitFlag(8);
        Cube<MT, NT, false, 256, 3> cube;
        cube.Init();
        int lo = 0, hi = E - 1;
        while (lo < hi)
        {
            const int mid = (lo + hi) / 2;
            if (g.GetValue(mid) <= begin)
                lo = mid + 1;
            else
                hi = mid;
        }
        int row = begin, sequence = 0;
        for (int e = lo; e < E && row < limit; ++e)
        {
            const int end = Min(limit, int(g.GetValue(e)));
            while (row < end)
            {
                const int rows = Min(MT, end - row), slot = sequence++ & 1;
                cube.Compute(pa[int64_t(row) * AP], pb[int64_t(e) * AP * NT],
                             buffer[int64_t(core * 2 + slot) * MT * NT], MT, NT, AP, NT, 0, AP,
                             slot);
                row += rows;
            }
        }
        cube.Finish();
    }
    if ASCEND_IS_AIV
    {
        TPipe pipe;
        SetMaskNorm();
        SetVectorMask<uint8_t>(~uint64_t(0), ~uint64_t(0));
        LocalTensor<int64_t> ends(TPosition::VECCALC, 172032, 128);
        DataCopyPad(ends, g, DataCopyExtParams(1, E * 8, 0, 0, 0),
                    DataCopyPadExtParams<int64_t>{false, 0, 0, 0});
        SetFlag<HardEvent::MTE2_S>(EVENT_ID6);
        WaitFlag<HardEvent::MTE2_S>(EVENT_ID6);
        CrossCoreSetFlag<2, PIPE_MTE2>(2);
        CrossCoreSetFlag<2, PIPE_MTE2>(3);
        Epilogue<MT, NT> epilogue;
        int lo = 0, hi = E - 1;
        while (lo < hi)
        {
            const int mid = (lo + hi) / 2;
            if (ends.GetValue(mid) <= begin)
                lo = mid + 1;
            else
                hi = mid;
        }
        int row = begin, sequence = 0;
        for (int e = lo; e < E && row < limit; ++e)
        {
            const int end = Min(limit, int(ends.GetValue(e)));
            while (row < end)
            {
                const int rows = Min(MT, end - row), slot = sequence++ & 1;
                CrossCoreWaitFlag(slot);
                epilogue.Run(buffer[int64_t(core * 2 + slot) * MT * NT], s, out, row, 0, rows, N, N,
                             e, 1, slot);
                row += rows;
            }
        }
    }
}

template <int MT, int NT>
inline bool Launch(GM_ADDR x, GM_ADDR b, GM_ADDR s, GM_ADDR g, GM_ADDR y, int M, int K, int N,
                   int E, int cores, aclrtStream stream)
{
    constexpr int RM = MT < 128 ? MT : 128;
    const int workers = std::min(cores, (M + RM - 1) / RM), AP = (K + 255) / 256 * 256;
    const size_t aBytes = size_t(M + MT - 1) * AP, bBytes = size_t(E) * AP * NT;
    if (aBytes + bBytes > (size_t(96) << 20))
        return false;
    const size_t cBytes = size_t(workers) * 2 * MT * NT * 4;
    Workspace memory(cBytes + aBytes + bBytes, stream);
    if (!memory.Data())
        return false;
    Run<MT, NT><<<workers, nullptr, stream>>>(x, b, s, g, y, memory.Data(), memory.Data() + cBytes,
                                              memory.Data() + cBytes + aBytes, M, K, N, E, AP,
                                              workers);
    memory.Complete();
    return true;
}

}

namespace raw_range
{
using namespace AscendC;
using grouped_gelu::Min;
using grouped_gelu::Up;
using grouped_gelu::Workspace;
template <int MT, int NT, bool SPLIT, int LK = 256, int NSTAGES = 3, bool NZ = false> class Cube
{
    static constexpr int FK = 256;
    static constexpr int STAGES = NSTAGES;
    static constexpr int PANEL = (MT + NT) * LK;
    static constexpr int CSLOTS = MT * NT * 4 <= 65536 ? 2 : 1;
    static_assert(STAGES * PANEL <= 524288, "L1 capacity exceeded");
    static_assert(2 * MT * FK <= 65536 && 2 * NT * FK <= 65536, "L0A/B capacity exceeded");
    static_assert(CSLOTS * MT * NT * 4 <= 131072, "L0C capacity exceeded");
    LocalTensor<int8_t> l1{TPosition::A1, 0, STAGES * PANEL};
    LocalTensor<int8_t> a0{TPosition::A2, 0, 2 * MT * FK};
    LocalTensor<int8_t> b0{TPosition::B2, 0, 2 * NT * FK};
    LocalTensor<int32_t> c0{TPosition::CO1, 0, CSLOTS * MT * NT};
    int fragmentSlot = 0;
    struct Pending
    {
        int slot, count, rows, cols, outputSlot;
        GM_ADDR output;
        bool first, last;
    };
    Pending pending[2];
    int head = 0, pendingCount = 0, producer = 0;

    __aicore__ inline void CopyNd(const LocalTensor<int8_t> &dst, const GlobalTensor<int8_t> &src,
                                  int rows, int cols, int stride, int paddedRows)
    {
        grouped_gelu::CopyNdShared(dst, src, rows, cols, stride, paddedRows);
    }

    template <bool FULL> __aicore__ inline void ConsumeTile(const Pending &p)
    {
        const int cslot = p.outputSlot % CSLOTS;
        if (p.first)
            WaitFlag<HardEvent::FIX_M>(cslot);
        auto c = c0[cslot * MT * NT];
        WaitFlag<HardEvent::MTE2_MTE1>(p.slot);
        const int actualM = FULL || MT >= 256 ? MT : Up(p.rows, 16);
        const int activeN = FULL || MT >= 256 || actualM < 32 ? NT : Up(p.cols, 32);
        const int physicalK = FULL ? LK : p.count;
#pragma unroll
        for (int f = 0; f < physicalK; f += FK)
        {
            const int fk = Up(Min(FK, physicalK - f), 32);
            const int fs = fragmentSlot;
            WaitFlag<HardEvent::M_MTE1>(fs);
            auto aa = a0[fs * MT * FK];
            auto bb = b0[fs * NT * FK];
            auto la = l1[p.slot * PANEL + f * MT];
            auto lb = l1[p.slot * PANEL + MT * LK + f * 32];
            LoadData2DParams pa;
            pa.startIndex = 0;
            pa.repeatTimes = fk / 32;
            pa.srcStride = MT / 16;
            pa.dstGap = 0;
            pa.ifTranspose = false;
            pa.sid = 0;
            pa.addrMode = 0;
            for (int mi = 0; mi < (FULL ? MT / 16 : (p.rows + 15) / 16); ++mi)
                LoadData(aa[mi * fk * 16], la[mi * 512], pa);
            LoadData2dTransposeParams pb;
            pb.startIndex = 0;
            pb.repeatTimes = fk / 32;
            pb.srcStride = 1;
            pb.dstGap = 1;
            pb.dstFracGap = 0;
            LoadDataWithTranspose(bb, lb, pb);
            SetFlag<HardEvent::MTE1_M>(fs);
            WaitFlag<HardEvent::MTE1_M>(fs);
            MmadParams mm;
            mm.m = actualM;
            mm.n = activeN;
            mm.k = fk;
            mm.cmatrixInitVal = p.first && f == 0;
            mm.unitFlag = p.last && f + FK >= physicalK ? 3 : 2;
            Mmad(c, aa, bb, mm);
            if (actualM * activeN < 2560)
                PipeBarrier<PIPE_M>();
            SetFlag<HardEvent::M_MTE1>(fs);
            fragmentSlot ^= 1;
        }
        SetFlag<HardEvent::MTE1_MTE2>(p.slot);
        if (p.last)
        {
            GlobalTensor<int32_t> dst;
            dst.SetGlobalBuffer((__gm__ int32_t *)p.output);
            if constexpr (!SPLIT)
                CrossCoreWaitFlag(2 + p.outputSlot);
            FixpipeParamsV220 fp;
            fp.nSize = activeN;
            fp.mSize = MT >= 256 ? MT : p.rows;
            fp.srcStride = actualM;
            fp.dstStride = activeN;
            fp.quantPre = QuantMode_t::NoQuant;
            fp.reluEn = false;
            fp.unitFlag = 3;
            Fixpipe<int32_t, int32_t, CFG_ROW_MAJOR>(dst, c, fp);
            SetFlag<HardEvent::FIX_M>(cslot);
            if constexpr (!SPLIT)
                CrossCoreSetFlag<2, PIPE_FIX>(p.outputSlot);
        }
    }

    __aicore__ inline void Consume(const Pending &p)
    {
        if (p.rows == MT && p.cols == NT && p.count == LK)
            ConsumeTile<true>(p);
        else
            ConsumeTile<false>(p);
    }

  public:
    __aicore__ inline void Init()
    {
        SetLoadDataPaddingValue<uint64_t>(0);
        SetFixpipeNz2ndFlag(1, 0, 0);
        for (int i = 0; i < STAGES; ++i)
            SetFlag<HardEvent::MTE1_MTE2>(i);
        for (int i = 0; i < 2; ++i)
        {
            SetFlag<HardEvent::M_MTE1>(i);
        }
        for (int i = 0; i < CSLOTS; ++i)
            SetFlag<HardEvent::FIX_M>(i);
    }

    __aicore__ inline void Compute(const GlobalTensor<int8_t> &a, const GlobalTensor<int8_t> &b,
                                   const GlobalTensor<int8_t> &tail,
                                   const GlobalTensor<int32_t> &dst, int rows, int cols, int K,
                                   int N, int start, int depth, int outputSlot, int bKPad = 0)
    {
        const int panels = (depth + LK - 1) / LK;
        for (int p = 0; p < panels; ++p)
        {
            const int slot = producer;
            int ki = p;
            if constexpr (MT >= 64 && NT >= 128)
                ki = (p + GetBlockIdx()) % panels;
            const int count = Min(LK, depth - ki * LK);
            WaitFlag<HardEvent::MTE1_MTE2>(slot);
            CopyNd(l1[slot * PANEL], a[start + ki * LK], rows, count, K, MT);
            if constexpr (NZ)
            {
                const int complete = count / 32 * 32;
                if (complete)
                    DataCopy(l1[slot * PANEL + MT * LK], b[int64_t(start + ki * LK) * 32],
                             DataCopyParams(1, complete, 0, 0));
                if (complete != count)
                    DataCopy(l1[slot * PANEL + MT * LK + complete * 32], tail, 1024);
            }
            else
                CopyNd(l1[slot * PANEL + MT * LK], b[int64_t(start + ki * LK) * N], count, cols, N,
                       LK);
            SetFlag<HardEvent::MTE2_MTE1>(slot);
            // Keep two pending panels across output tiles, so the next tile's
            // input transfer overlaps the current tile's final MMAD/Fixpipe.
            if (pendingCount == (STAGES < 3 ? 1 : 2))
            {
                Consume(pending[head]);
                pending[head] = {slot,   count,          rows,
                                 cols,   outputSlot,     (GM_ADDR)dst.GetPhyAddr(),
                                 p == 0, p + 1 == panels};
                if constexpr (STAGES >= 3)
                    head ^= 1;
            }
            else
            {
                pending[(head + pendingCount) & 1] = {
                    slot,   count,          rows, cols, outputSlot, (GM_ADDR)dst.GetPhyAddr(),
                    p == 0, p + 1 == panels};
                ++pendingCount;
            }
            producer = producer + 1 < STAGES ? producer + 1 : 0;
        }
    }

    __aicore__ inline void Finish()
    {
        while (pendingCount)
        {
            Consume(pending[head]);
            if constexpr (STAGES >= 3)
                head ^= 1;
            --pendingCount;
        }
        for (int i = 0; i < STAGES; ++i)
            WaitFlag<HardEvent::MTE1_MTE2>(i);
        for (int i = 0; i < 2; ++i)
        {
            WaitFlag<HardEvent::M_MTE1>(i);
        }
        for (int i = 0; i < CSLOTS; ++i)
            WaitFlag<HardEvent::FIX_M>(i);
    }
};

__aicore__ inline void PackRawTail(const GlobalTensor<int8_t> &source,
                                   const GlobalTensor<int8_t> &destination, int K, int E,
                                   int workers)
{
    const int tail = K % 32;
    if (!tail)
        return;
    LocalTensor<int8_t> tile(TPosition::VECCALC, 0, 1024);
    for (int expert = GetBlockIdx(); expert < E; expert += workers)
    {
        Duplicate(tile.ReinterpretCast<uint16_t>(), uint16_t(0), 512);
        SetFlag<HardEvent::V_MTE2>(EVENT_ID5);
        WaitFlag<HardEvent::V_MTE2>(EVENT_ID5);
        DataCopy(tile, source[(int64_t(expert) * K + K - tail) * 32], tail * 32);
        SetFlag<HardEvent::MTE2_MTE3>(EVENT_ID5);
        WaitFlag<HardEvent::MTE2_MTE3>(EVENT_ID5);
        DataCopy(destination[int64_t(expert) * 1024], tile, 1024);
        SetFlag<HardEvent::MTE3_V>(EVENT_ID5);
        WaitFlag<HardEvent::MTE3_V>(EVENT_ID5);
    }
    SetFlag<HardEvent::V_MTE2>(EVENT_ID5);
    WaitFlag<HardEvent::V_MTE2>(EVENT_ID5);
}

template <int MT, int LK, int RM, bool FULLROWS>
__global__ __mix__(1, 2)
    __attribute__((aligned(4096))) void RangeRaw(GM_ADDR x, GM_ADDR weight, GM_ADDR scale,
                                                 GM_ADDR groups, GM_ADDR y, GM_ADDR workspace,
                                                 GM_ADDR packedA, GM_ADDR packedTail, int M, int K,
                                                 int E, int workers, int AP)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
    SetAtomicNone();
    int core = GetBlockIdx();
    if ASCEND_IS_AIV
    {
        core /= GetSubBlockNum();
    }
    GlobalTensor<int8_t> a, b, tb;
    GlobalTensor<int64_t> g;
    GlobalTensor<float> s;
    GlobalTensor<int32_t> buffer;
    GlobalTensor<half> out;
    a.SetGlobalBuffer((__gm__ int8_t *)x);
    b.SetGlobalBuffer((__gm__ int8_t *)weight);
    tb.SetGlobalBuffer((__gm__ int8_t *)packedTail);
    g.SetGlobalBuffer((__gm__ int64_t *)groups);
    s.SetGlobalBuffer((__gm__ float *)scale);
    buffer.SetGlobalBuffer((__gm__ int32_t *)workspace);
    out.SetGlobalBuffer((__gm__ half *)y);
    if (FULLROWS || AP != K || K % 32)
    {
        if ASCEND_IS_AIV
        {
            TPipe pipe;
            SetMaskNorm();
            SetVectorMask<uint8_t>(~uint64_t(0), ~uint64_t(0));
            GlobalTensor<int8_t> pa;
            pa.SetGlobalBuffer((__gm__ int8_t *)packedA);
            PackRawTail(b, tb, K, E, workers * 2);
            if constexpr (FULLROWS)
                padded_rows::PadA(a, pa, M, K, AP, MT - 1, workers * 2);
            else if (AP != K)
                grouped_gelu::PackRows(a, pa, M, K, AP, workers * 2);
            CrossCoreSetFlag<0, PIPE_MTE3>(10);
            CrossCoreWaitFlag(10);
            CrossCoreSetFlag<2, PIPE_MTE3>(8);
        }
        if ASCEND_IS_AIC
        {
            CrossCoreWaitFlag(8);
        }
        if (FULLROWS || AP != K)
            a.SetGlobalBuffer((__gm__ int8_t *)packedA);
    }
    const int rowTiles = (M + RM - 1) / RM, begin = core * rowTiles / workers * RM;
    const int limit = Min(M, (core + 1) * rowTiles / workers * RM);
    if ASCEND_IS_AIC
    {
        Cube<MT, 32, false, LK, 3, true> cube;
        cube.Init();
        int lo = 0, hi = E - 1;
        while (lo < hi)
        {
            const int mid = (lo + hi) / 2;
            if (g.GetValue(mid) <= begin)
                lo = mid + 1;
            else
                hi = mid;
        }
        int row = begin, sequence = 0;
        for (int e = lo; e < E && row < limit; ++e)
        {
            const int end = Min(limit, int(g.GetValue(e)));
            while (row < end)
            {
                const int rows = Min(MT, end - row), slot = sequence++ & 1;
                cube.Compute(a[int64_t(row) * AP], b[int64_t(e) * K * 32], tb[int64_t(e) * 1024],
                             buffer[int64_t(core * 2 + slot) * MT * 32], rows, 32, AP, 32, 0, K,
                             slot, K);
                row += rows;
            }
        }
        cube.Finish();
    }
    if ASCEND_IS_AIV
    {
        TPipe pipe;
        SetMaskNorm();
        SetVectorMask<uint8_t>(~uint64_t(0), ~uint64_t(0));
        LocalTensor<int64_t> ends(TPosition::VECCALC, 172032, 128);
        DataCopyPad(ends, g, DataCopyExtParams(1, E * 8, 0, 0, 0),
                    DataCopyPadExtParams<int64_t>{false, 0, 0, 0});
        SetFlag<HardEvent::MTE2_S>(EVENT_ID4);
        WaitFlag<HardEvent::MTE2_S>(EVENT_ID4);
        CrossCoreSetFlag<2, PIPE_MTE2>(2);
        CrossCoreSetFlag<2, PIPE_MTE2>(3);
        grouped_gelu::Epilogue<MT, 32> epilogue;
        int lo = 0, hi = E - 1;
        while (lo < hi)
        {
            const int mid = (lo + hi) / 2;
            if (ends.GetValue(mid) <= begin)
                lo = mid + 1;
            else
                hi = mid;
        }
        int row = begin, sequence = 0;
        for (int e = lo; e < E && row < limit; ++e)
        {
            const int end = Min(limit, int(ends.GetValue(e)));
            while (row < end)
            {
                const int rows = Min(MT, end - row), slot = sequence++ & 1;
                CrossCoreWaitFlag(slot);
                epilogue.Run(buffer[int64_t(core * 2 + slot) * MT * 32], s, out, row, 0, rows, 32,
                             32, e, 1, slot);
                row += rows;
            }
        }
    }
}
template <int MT, int LK, int RM, bool FULLROWS>
inline void LaunchRaw(GM_ADDR x, GM_ADDR b, GM_ADDR s, GM_ADDR g, GM_ADDR y, int M, int K, int E,
                      int cores, aclrtStream stream)
{
    const int workers = std::min(cores, (M + RM - 1) / RM), AP = K;
    const size_t cBytes = size_t(workers) * 2 * MT * 32 * 4;
    const size_t aBytes = FULLROWS ? size_t(M + MT - 1) * AP : (AP == K ? 0 : size_t(M) * AP);
    const size_t tailBytes = K % 32 ? size_t(E) * 1024 : 0;
    Workspace memory(cBytes + aBytes + tailBytes, stream);
    if (!memory.Data())
        return;
    RangeRaw<MT, LK, RM, FULLROWS>
        <<<workers, nullptr, stream>>>(x, b, s, g, y, memory.Data(), memory.Data() + cBytes,
                                       memory.Data() + cBytes + aBytes, M, K, E, workers, AP);
    memory.Complete();
}

}

namespace short_l0_resident
{
using namespace AscendC;
using grouped_gelu::Min;
using grouped_gelu::Up;
using grouped_gelu::Workspace;

template <int MT, int NT, int AK, bool FIXED> class Cube
{
    static constexpr int STAGES = 3;
    static constexpr int APANEL = MT * AK;
    static constexpr int BPANEL = NT * AK;
    static constexpr int BSLOTS = 2 * BPANEL <= 65536 ? 2 : 1;
    static constexpr int CSLOTS = MT * NT * 4 <= 65536 ? 2 : 1;
    static_assert(APANEL <= 65536 && BSLOTS * BPANEL <= 65536, "L0 capacity exceeded");
    static_assert(APANEL + STAGES * BPANEL <= 524288, "L1 capacity exceeded");
    static_assert(CSLOTS * MT * NT * 4 <= 131072, "L0C capacity exceeded");
    LocalTensor<int8_t> aL1{TPosition::A1, 0, APANEL};
    LocalTensor<int8_t> bL1{TPosition::A1, APANEL, STAGES * BPANEL};
    LocalTensor<int8_t> a0{TPosition::A2, 0, APANEL};
    LocalTensor<int8_t> b0{TPosition::B2, 0, BSLOTS * BPANEL};
    LocalTensor<int32_t> c0{TPosition::CO1, 0, CSLOTS * MT * NT};
    struct Pending
    {
        int slot, rows, cols, K, outputSlot;
        GM_ADDR output;
    };
    Pending pending[2];
    int head = 0, amount = 0, producer = 0, fragment = 0;
    bool aLoaded = false, aContiguous = false;

    __aicore__ inline void CopyNd(const LocalTensor<int8_t> &dst, const GlobalTensor<int8_t> &src,
                                  int rows, int cols, int stride, int paddedRows)
    {
        Nd2NzParams p;
        p.ndNum = 1;
        p.nValue = rows;
        p.dValue = cols;
        p.srcNdMatrixStride = 0;
        p.srcDValue = stride;
        p.dstNzC0Stride = paddedRows;
        p.dstNzNStride = 1;
        p.dstNzMatrixStride = 0;
        if (stride % 4 == 0 && rows % 32 == 0)
        {
            GlobalTensor<float> wide;
            wide.SetGlobalBuffer((__gm__ float *)src.GetPhyAddr());
            p.dValue = (cols + 3) / 4;
            p.srcDValue /= 4;
            DataCopy(dst.template ReinterpretCast<float>(), wide, p);
        }
        else
            DataCopy(dst, src, p);
    }

    __aicore__ inline void Consume(const Pending &p)
    {
        const int cslot = p.outputSlot % CSLOTS;
        const int m = Up(p.rows, 16), n = FIXED || MT >= 256 || m < 32 ? NT : Up(p.cols, 32),
                  k = Up(p.K, 32);
        WaitFlag<HardEvent::FIX_M>(cslot);
        WaitFlag<HardEvent::MTE2_MTE1>(p.slot);
        const int fs = fragment;
        WaitFlag<HardEvent::M_MTE1>(fs);
        if (!aLoaded)
        {
            WaitFlag<HardEvent::M_MTE1>(EVENT_ID2);
            LoadData2DParams pa;
            pa.startIndex = 0;
            pa.repeatTimes = k / 32;
            pa.srcStride = MT / 16;
            pa.dstGap = 0;
            pa.ifTranspose = false;
            pa.sid = 0;
            pa.addrMode = 0;
            if (aContiguous)
            {
                pa.repeatTimes = p.rows / 16 * (k / 32);
                pa.srcStride = 1;
                LoadData(a0, aL1, pa);
            }
            else
            {
                for (int mi = 0; mi < (p.rows + 15) / 16; ++mi)
                    LoadData(a0[mi * k * 16], aL1[mi * 512], pa);
            }
            SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID3);
            aLoaded = true;
        }
        auto bb = b0[fs * BPANEL];
        auto lb = bL1[p.slot * BPANEL];
        LoadData2dTransposeParams pb;
        pb.startIndex = 0;
        pb.repeatTimes = (p.cols + 31) / 32;
        pb.srcStride = AK / 32;
        pb.dstGap = 1;
        pb.dstFracGap = 0;
        for (int ki = 0; ki < k / 32; ++ki)
            LoadDataWithTranspose(bb[ki * n * 32], lb[ki * 1024], pb);
        SetFlag<HardEvent::MTE1_M>(fs);
        WaitFlag<HardEvent::MTE1_M>(fs);
        MmadParams mm;
        mm.m = m;
        mm.n = n;
        mm.k = k;
        mm.cmatrixInitVal = true;
        mm.unitFlag = 3;
        auto c = c0[cslot * MT * NT];
        Mmad(c, a0, bb, mm);
        if (m * n < 2560)
            PipeBarrier<PIPE_M>();
        SetFlag<HardEvent::M_MTE1>(fs);
        SetFlag<HardEvent::MTE1_MTE2>(p.slot);
        if constexpr (BSLOTS == 2)
            fragment ^= 1;
        CrossCoreWaitFlag(2 + p.outputSlot);
        GlobalTensor<int32_t> dst;
        dst.SetGlobalBuffer((__gm__ int32_t *)p.output);
        FixpipeParamsV220 fp;
        fp.nSize = n;
        fp.mSize = p.rows;
        fp.srcStride = m;
        fp.dstStride = n;
        fp.quantPre = QuantMode_t::NoQuant;
        fp.reluEn = false;
        fp.unitFlag = 3;
        Fixpipe<int32_t, int32_t, CFG_ROW_MAJOR>(dst, c, fp);
        SetFlag<HardEvent::FIX_M>(cslot);
        CrossCoreSetFlag<2, PIPE_FIX>(p.outputSlot);
    }

  public:
    __aicore__ inline void Init()
    {
        SetLoadDataPaddingValue<uint64_t>(0);
        SetFixpipeNz2ndFlag(1, 0, 0);
        for (int i = 0; i < STAGES; ++i)
            SetFlag<HardEvent::MTE1_MTE2>(i);
        for (int i = 0; i < BSLOTS; ++i)
            SetFlag<HardEvent::M_MTE1>(i);
        for (int i = 0; i < CSLOTS; ++i)
            SetFlag<HardEvent::FIX_M>(i);
        SetFlag<HardEvent::M_MTE1>(EVENT_ID2);
        SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID3);
        aLoaded = false;
    }
    __aicore__ inline void LoadA(const GlobalTensor<int8_t> &src, int rows, int K)
    {
        WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID3);
        aContiguous = rows % 16 == 0;
        if (aContiguous)
        {
            Nd2NzParams p;
            p.ndNum = rows / 16;
            p.nValue = 16;
            p.dValue = K;
            p.srcNdMatrixStride = 16 * K;
            p.srcDValue = K;
            p.dstNzC0Stride = 16;
            p.dstNzNStride = 1;
            p.dstNzMatrixStride = 16 * K;
            DataCopy(aL1, src, p);
        }
        else
            CopyNd(aL1, src, rows, K, K, MT);
    }
    __aicore__ inline void Compute(const GlobalTensor<int8_t> &b, const GlobalTensor<int32_t> &dst,
                                   int rows, int cols, int K, int N, int outputSlot)
    {
        const int slot = producer;
        WaitFlag<HardEvent::MTE1_MTE2>(slot);
        CopyNd(bL1[slot * BPANEL], b, K, cols, N, AK);
        SetFlag<HardEvent::MTE2_MTE1>(slot);
        if (amount == 2)
        {
            Consume(pending[head]);
            head ^= 1;
            --amount;
        }
        pending[(head + amount) & 1] = {slot, rows, cols, K, outputSlot, (GM_ADDR)dst.GetPhyAddr()};
        ++amount;
        producer = producer + 1 < STAGES ? producer + 1 : 0;
    }
    __aicore__ inline void Finish()
    {
        while (amount)
        {
            Consume(pending[head]);
            head ^= 1;
            --amount;
        }
        for (int i = 0; i < STAGES; ++i)
            WaitFlag<HardEvent::MTE1_MTE2>(i);
        for (int i = 0; i < BSLOTS; ++i)
            WaitFlag<HardEvent::M_MTE1>(i);
        for (int i = 0; i < CSLOTS; ++i)
            WaitFlag<HardEvent::FIX_M>(i);
        WaitFlag<HardEvent::M_MTE1>(EVENT_ID2);
        WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID3);
    }
    __aicore__ inline void EndRow()
    {
        while (amount)
        {
            Consume(pending[head]);
            head ^= 1;
            --amount;
        }
        SetFlag<HardEvent::M_MTE1>(EVENT_ID2);
        aLoaded = false;
    }
};

template <bool STREAM, int MT, int NT> struct EpilogueType;
template <int MT, int NT> struct EpilogueType<false, MT, NT>
{
    using Type = grouped_gelu::Epilogue<MT, NT>;
};
template <int MT, int NT> struct EpilogueType<true, MT, NT>
{
    using Type = generalized_stream::Epilogue<MT, NT>;
};

template <int MT, int NT, int AK, int LANES, bool STREAM>
__global__ __mix__(1, 2)
    __attribute__((aligned(4096))) void Run(GM_ADDR x, GM_ADDR weight, GM_ADDR scale,
                                            GM_ADDR groups, GM_ADDR y, GM_ADDR workspace, int M,
                                            int K, int N, int E, int workers)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
    SetAtomicNone();
    int core = GetBlockIdx();
    if ASCEND_IS_AIV
    {
        core /= GetSubBlockNum();
    }
    GlobalTensor<int8_t> a, b;
    GlobalTensor<int64_t> g;
    GlobalTensor<float> s;
    GlobalTensor<half> out;
    GlobalTensor<int32_t> buffer;
    a.SetGlobalBuffer((__gm__ int8_t *)x);
    b.SetGlobalBuffer((__gm__ int8_t *)weight);
    g.SetGlobalBuffer((__gm__ int64_t *)groups);
    s.SetGlobalBuffer((__gm__ float *)scale);
    out.SetGlobalBuffer((__gm__ half *)y);
    buffer.SetGlobalBuffer((__gm__ int32_t *)workspace);
    const int columns = (N + NT - 1) / NT, rowWorkers = workers / LANES;
    constexpr int RM = 32;
    const int ranges = (M + RM - 1) / RM, rank = core / LANES;
    const int begin = rank * ranges / rowWorkers * RM;
    const int limit = Min(M, (rank + 1) * ranges / rowWorkers * RM);
    if ASCEND_IS_AIC
    {
        Cube<MT, NT, AK, STREAM> cube;
        cube.Init();
        int lo = 0, hi = E - 1;
        while (lo < hi)
        {
            const int mid = (lo + hi) / 2;
            if (g.GetValue(mid) <= begin)
                lo = mid + 1;
            else
                hi = mid;
        }
        int row = begin, sequence = 0;
        for (int e = lo; e < E && row < limit; ++e)
        {
            const int end = Min(limit, int(g.GetValue(e)));
            while (row < end)
            {
                const int rows = Min(MT, end - row);
                cube.LoadA(a[int64_t(row) * K], rows, K);
                for (int c = core % LANES; c < columns; c += LANES)
                {
                    const int slot = sequence++ & 1;
                    cube.Compute(b[int64_t(e) * K * N + c * NT],
                                 buffer[int64_t(core * 2 + slot) * MT * NT], rows,
                                 Min(NT, N - c * NT), K, N, slot);
                }
                cube.EndRow();
                row += rows;
            }
        }
        cube.Finish();
    }
    if ASCEND_IS_AIV
    {
        TPipe pipe;
        SetMaskNorm();
        SetVectorMask<uint8_t>(~uint64_t(0), ~uint64_t(0));
        LocalTensor<int64_t> ends(TPosition::VECCALC, 172032, 128);
        DataCopyPad(ends, g, DataCopyExtParams(1, E * 8, 0, 0, 0),
                    DataCopyPadExtParams<int64_t>{false, 0, 0, 0});
        SetFlag<HardEvent::MTE2_S>(EVENT_ID4);
        WaitFlag<HardEvent::MTE2_S>(EVENT_ID4);
        typename EpilogueType<STREAM, MT, NT>::Type epilogue;
        CrossCoreSetFlag<2, PIPE_MTE2>(2);
        CrossCoreSetFlag<2, PIPE_MTE2>(3);
        int lo = 0, hi = E - 1;
        while (lo < hi)
        {
            const int mid = (lo + hi) / 2;
            if (ends.GetValue(mid) <= begin)
                lo = mid + 1;
            else
                hi = mid;
        }
        int row = begin, sequence = 0;
        for (int e = lo; e < E && row < limit; ++e)
        {
            const int end = Min(limit, int(ends.GetValue(e)));
            while (row < end)
            {
                const int rows = Min(MT, end - row);
                for (int c = core % LANES; c < columns; c += LANES)
                {
                    const int slot = sequence++ & 1;
                    CrossCoreWaitFlag(slot);
                    epilogue.Run(buffer[int64_t(core * 2 + slot) * MT * NT], s, out, row, c * NT,
                                 rows, Min(NT, N - c * NT), N, e, 1, slot);
                }
                row += rows;
            }
        }
    }
}

template <int MT, int NT, int AK, int LANES, bool STREAM = false>
inline void Start(GM_ADDR x, GM_ADDR b, GM_ADDR s, GM_ADDR g, GM_ADDR y, int M, int K, int N, int E,
                  int cores, aclrtStream stream)
{
    const int nominal = std::max(E, (M + MT - 1) / MT);
    const int workers = std::min(cores / LANES, nominal) * LANES;
    Workspace memory(size_t(workers) * 2 * MT * NT * 4, stream);
    if (!memory.Data())
        return;
    Run<MT, NT, AK, LANES, STREAM>
        <<<workers, nullptr, stream>>>(x, b, s, g, y, memory.Data(), M, K, N, E, workers);
    memory.Complete();
}

template <int MT, int NT, int AK, bool STREAM = false>
inline void Launch(GM_ADDR x, GM_ADDR b, GM_ADDR s, GM_ADDR g, GM_ADDR y, int M, int K, int N,
                   int E, int cores, aclrtStream stream)
{
    const int nominal = std::max(E, (M + MT - 1) / MT), columns = (N + NT - 1) / NT;
    int lanes = 1, cost = (nominal + cores - 1) / cores * columns;
    for (int candidate = 2; candidate <= std::min(5, std::min(cores, columns)); ++candidate)
    {
        const int rows = cores / candidate;
        const int trial = (nominal + rows - 1) / rows * ((columns + candidate - 1) / candidate);
        if (trial < cost)
        {
            cost = trial;
            lanes = candidate;
        }
    }
    if (lanes == 2)
        Start<MT, NT, AK, 2, STREAM>(x, b, s, g, y, M, K, N, E, cores, stream);
    else if (lanes == 3)
        Start<MT, NT, AK, 3, STREAM>(x, b, s, g, y, M, K, N, E, cores, stream);
    else if (lanes == 4)
        Start<MT, NT, AK, 4, STREAM>(x, b, s, g, y, M, K, N, E, cores, stream);
    else if (lanes == 5)
        Start<MT, NT, AK, 5, STREAM>(x, b, s, g, y, M, K, N, E, cores, stream);
    else
        Start<MT, NT, AK, 1, STREAM>(x, b, s, g, y, M, K, N, E, cores, stream);
}
}

namespace direct_range
{
using namespace AscendC;
using grouped_gelu::Min;
using grouped_gelu::Up;
using grouped_gelu::Workspace;
template <int MT, int NT, bool SPLIT, int LK = 256, int NSTAGES = 3, bool NZ = false> class Cube
{
    static constexpr int FK = 256;
    static constexpr int STAGES = NSTAGES;
    static constexpr int PANEL = (MT + NT) * LK;
    static constexpr int CSLOTS = MT * NT * 4 <= 65536 ? 2 : 1;
    static_assert(STAGES * PANEL <= 524288, "L1 capacity exceeded");
    static_assert(2 * MT * FK <= 65536 && 2 * NT * FK <= 65536, "L0A/B capacity exceeded");
    static_assert(CSLOTS * MT * NT * 4 <= 131072, "L0C capacity exceeded");
    LocalTensor<int8_t> l1{TPosition::A1, 0, STAGES * PANEL};
    LocalTensor<int8_t> a0{TPosition::A2, 0, 2 * MT * FK};
    LocalTensor<int8_t> b0{TPosition::B2, 0, 2 * NT * FK};
    LocalTensor<int32_t> c0{TPosition::CO1, 0, CSLOTS * MT * NT};
    int fragmentSlot = 0;
    struct Pending
    {
        int slot, count, rows, cols, outputSlot;
        GM_ADDR output;
        bool first, last;
    };
    Pending pending[2];
    int head = 0, pendingCount = 0, producer = 0;

    __aicore__ inline void CopyNd(const LocalTensor<int8_t> &dst, const GlobalTensor<int8_t> &src,
                                  int rows, int cols, int stride, int paddedRows)
    {
        grouped_gelu::CopyNdShared(dst, src, rows, cols, stride, paddedRows);
    }

    template <bool FULL> __aicore__ inline void ConsumeTile(const Pending &p)
    {
        const int cslot = p.outputSlot % CSLOTS;
        if (p.first)
            WaitFlag<HardEvent::FIX_M>(cslot);
        auto c = c0[cslot * MT * NT];
        WaitFlag<HardEvent::MTE2_MTE1>(p.slot);
        const int actualM = FULL || MT >= 256 ? MT : Up(p.rows, 16);
        const int activeN = FULL || MT >= 256 || actualM < 32 ? NT : Up(p.cols, 32);
        const int physicalK = FULL ? LK : p.count;
#pragma unroll
        for (int f = 0; f < physicalK; f += FK)
        {
            const int fk = Up(Min(FK, physicalK - f), 32);
            const int fs = fragmentSlot;
            WaitFlag<HardEvent::M_MTE1>(fs);
            auto aa = a0[fs * MT * FK];
            auto bb = b0[fs * NT * FK];
            auto la = l1[p.slot * PANEL + f * MT];
            auto lb = l1[p.slot * PANEL + MT * LK + f * 32];
            LoadData2DParams pa;
            pa.startIndex = 0;
            pa.repeatTimes = fk / 32;
            pa.srcStride = MT / 16;
            pa.dstGap = 0;
            pa.ifTranspose = false;
            pa.sid = 0;
            pa.addrMode = 0;
            for (int mi = 0; mi < (FULL ? MT / 16 : (p.rows + 15) / 16); ++mi)
                LoadData(aa[mi * fk * 16], la[mi * 512], pa);
            LoadData2dTransposeParams pb;
            pb.startIndex = 0;
            pb.repeatTimes = fk / 32;
            pb.srcStride = 1;
            pb.dstGap = 2 * (activeN / 32) - 1;
            pb.dstFracGap = 0;
            for (int ni = 0; ni < (FULL ? NT / 32 : (p.cols + 31) / 32); ++ni)
                LoadDataWithTranspose(bb[ni * 1024], lb[ni * LK * 32], pb);
            SetFlag<HardEvent::MTE1_M>(fs);
            WaitFlag<HardEvent::MTE1_M>(fs);
            MmadParams mm;
            mm.m = actualM;
            mm.n = activeN;
            mm.k = fk;
            mm.cmatrixInitVal = p.first && f == 0;
            mm.unitFlag = p.last && f + FK >= physicalK ? 3 : 2;
            Mmad(c, aa, bb, mm);
            if (actualM * activeN < 2560)
                PipeBarrier<PIPE_M>();
            SetFlag<HardEvent::M_MTE1>(fs);
            fragmentSlot ^= 1;
        }
        SetFlag<HardEvent::MTE1_MTE2>(p.slot);
        if (p.last)
        {
            GlobalTensor<int32_t> dst;
            dst.SetGlobalBuffer((__gm__ int32_t *)p.output);
            if constexpr (!SPLIT)
                CrossCoreWaitFlag(2 + p.outputSlot);
            FixpipeParamsV220 fp;
            fp.nSize = activeN;
            fp.mSize = MT >= 256 ? MT : p.rows;
            fp.srcStride = actualM;
            fp.dstStride = activeN;
            fp.quantPre = QuantMode_t::NoQuant;
            fp.reluEn = false;
            fp.unitFlag = 3;
            Fixpipe<int32_t, int32_t, CFG_ROW_MAJOR>(dst, c, fp);
            SetFlag<HardEvent::FIX_M>(cslot);
            if constexpr (!SPLIT)
                CrossCoreSetFlag<2, PIPE_FIX>(p.outputSlot);
        }
    }

    __aicore__ inline void Consume(const Pending &p)
    {
        if (p.rows == MT && p.cols == NT && p.count == LK)
            ConsumeTile<true>(p);
        else
            ConsumeTile<false>(p);
    }

  public:
    __aicore__ inline void Init()
    {
        SetLoadDataPaddingValue<uint64_t>(0);
        SetFixpipeNz2ndFlag(1, 0, 0);
        for (int i = 0; i < STAGES; ++i)
            SetFlag<HardEvent::MTE1_MTE2>(i);
        for (int i = 0; i < 2; ++i)
        {
            SetFlag<HardEvent::M_MTE1>(i);
        }
        for (int i = 0; i < CSLOTS; ++i)
            SetFlag<HardEvent::FIX_M>(i);
    }

    __aicore__ inline void Compute(const GlobalTensor<int8_t> &a, const GlobalTensor<int8_t> &b,
                                   const GlobalTensor<int32_t> &dst, int rows, int cols, int K,
                                   int N, int start, int depth, int outputSlot, int bKPad = 0)
    {
        const int panels = (depth + LK - 1) / LK;
        for (int p = 0; p < panels; ++p)
        {
            const int slot = producer;
            int ki = p;
            if constexpr (MT >= 64 && NT >= 128)
                ki = (p + GetBlockIdx()) % panels;
            const int count = Min(LK, depth - ki * LK);
            WaitFlag<HardEvent::MTE1_MTE2>(slot);
            CopyNd(l1[slot * PANEL], a[start + ki * LK], rows, count, K, MT);
            CopyNd(l1[slot * PANEL + MT * LK], b[int64_t(start + ki * LK) * N], count, cols, N, LK);
            SetFlag<HardEvent::MTE2_MTE1>(slot);
            // Keep two pending panels across output tiles, so the next tile's
            // input transfer overlaps the current tile's final MMAD/Fixpipe.
            if (pendingCount == (STAGES < 3 ? 1 : 2))
            {
                Consume(pending[head]);
                pending[head] = {slot,   count,          rows,
                                 cols,   outputSlot,     (GM_ADDR)dst.GetPhyAddr(),
                                 p == 0, p + 1 == panels};
                if constexpr (STAGES >= 3)
                    head ^= 1;
            }
            else
            {
                pending[(head + pendingCount) & 1] = {
                    slot,   count,          rows, cols, outputSlot, (GM_ADDR)dst.GetPhyAddr(),
                    p == 0, p + 1 == panels};
                ++pendingCount;
            }
            producer = producer + 1 < STAGES ? producer + 1 : 0;
        }
    }

    __aicore__ inline void Finish()
    {
        while (pendingCount)
        {
            Consume(pending[head]);
            if constexpr (STAGES >= 3)
                head ^= 1;
            --pendingCount;
        }
        for (int i = 0; i < STAGES; ++i)
            WaitFlag<HardEvent::MTE1_MTE2>(i);
        for (int i = 0; i < 2; ++i)
        {
            WaitFlag<HardEvent::M_MTE1>(i);
        }
        for (int i = 0; i < CSLOTS; ++i)
            WaitFlag<HardEvent::FIX_M>(i);
    }
};

template <int MT, int NT, int LK, int RM, bool FULLROWS>
__global__ __mix__(1, 2)
    __attribute__((aligned(4096))) void RangeRaw(GM_ADDR x, GM_ADDR weight, GM_ADDR scale,
                                                 GM_ADDR groups, GM_ADDR y, GM_ADDR workspace,
                                                 GM_ADDR packedA, int M, int K, int N, int E,
                                                 int workers, int AP)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
    SetAtomicNone();
    int core = GetBlockIdx();
    if ASCEND_IS_AIV
    {
        core /= GetSubBlockNum();
    }
    GlobalTensor<int8_t> a, b;
    GlobalTensor<int64_t> g;
    GlobalTensor<float> s;
    GlobalTensor<int32_t> buffer;
    GlobalTensor<half> out;
    a.SetGlobalBuffer((__gm__ int8_t *)x);
    b.SetGlobalBuffer((__gm__ int8_t *)weight);
    g.SetGlobalBuffer((__gm__ int64_t *)groups);
    s.SetGlobalBuffer((__gm__ float *)scale);
    buffer.SetGlobalBuffer((__gm__ int32_t *)workspace);
    out.SetGlobalBuffer((__gm__ half *)y);
    if (FULLROWS || AP != K)
    {
        if ASCEND_IS_AIV
        {
            TPipe pipe;
            SetMaskNorm();
            SetVectorMask<uint8_t>(~uint64_t(0), ~uint64_t(0));
            GlobalTensor<int8_t> pa;
            pa.SetGlobalBuffer((__gm__ int8_t *)packedA);
            if constexpr (FULLROWS)
                padded_rows::PadA(a, pa, M, K, AP, MT - 1, workers * 2);
            else
                grouped_gelu::PackRows(a, pa, M, K, AP, workers * 2);
            CrossCoreSetFlag<0, PIPE_MTE3>(10);
            CrossCoreWaitFlag(10);
            CrossCoreSetFlag<2, PIPE_MTE3>(8);
        }
        if ASCEND_IS_AIC
        {
            CrossCoreWaitFlag(8);
        }
        a.SetGlobalBuffer((__gm__ int8_t *)packedA);
    }
    const int rowTiles = (M + RM - 1) / RM, begin = core * rowTiles / workers * RM;
    const int limit = Min(M, (core + 1) * rowTiles / workers * RM);
    if ASCEND_IS_AIC
    {
        Cube<MT, NT, false, LK, 3, false> cube;
        cube.Init();
        int lo = 0, hi = E - 1;
        while (lo < hi)
        {
            const int mid = (lo + hi) / 2;
            if (g.GetValue(mid) <= begin)
                lo = mid + 1;
            else
                hi = mid;
        }
        int row = begin, sequence = 0;
        for (int e = lo; e < E && row < limit; ++e)
        {
            const int end = Min(limit, int(g.GetValue(e)));
            while (row < end)
            {
                const int rows = Min(MT, end - row), slot = sequence++ & 1;
                cube.Compute(a[int64_t(row) * AP], b[int64_t(e) * K * N],
                             buffer[int64_t(core * 2 + slot) * MT * NT], rows, N, AP, N, 0, K, slot,
                             K);
                row += rows;
            }
        }
        cube.Finish();
    }
    if ASCEND_IS_AIV
    {
        TPipe pipe;
        SetMaskNorm();
        SetVectorMask<uint8_t>(~uint64_t(0), ~uint64_t(0));
        LocalTensor<int64_t> ends(TPosition::VECCALC, 172032, 128);
        DataCopyPad(ends, g, DataCopyExtParams(1, E * 8, 0, 0, 0),
                    DataCopyPadExtParams<int64_t>{false, 0, 0, 0});
        SetFlag<HardEvent::MTE2_S>(EVENT_ID4);
        WaitFlag<HardEvent::MTE2_S>(EVENT_ID4);
        CrossCoreSetFlag<2, PIPE_MTE2>(2);
        CrossCoreSetFlag<2, PIPE_MTE2>(3);
        grouped_gelu::Epilogue<MT, NT> epilogue;
        int lo = 0, hi = E - 1;
        while (lo < hi)
        {
            const int mid = (lo + hi) / 2;
            if (ends.GetValue(mid) <= begin)
                lo = mid + 1;
            else
                hi = mid;
        }
        int row = begin, sequence = 0;
        for (int e = lo; e < E && row < limit; ++e)
        {
            const int end = Min(limit, int(ends.GetValue(e)));
            while (row < end)
            {
                const int rows = Min(MT, end - row), slot = sequence++ & 1;
                CrossCoreWaitFlag(slot);
                epilogue.Run(buffer[int64_t(core * 2 + slot) * MT * NT], s, out, row, 0, rows, N, N,
                             e, 1, slot);
                row += rows;
            }
        }
    }
}
template <int MT, int NT, int LK, int RM, bool FULLROWS>
inline void LaunchRaw(GM_ADDR x, GM_ADDR b, GM_ADDR s, GM_ADDR g, GM_ADDR y, int M, int K, int N,
                      int E, int cores, aclrtStream stream)
{
    const int workers = std::min(cores, (M + RM - 1) / RM), AP = K;
    const size_t cBytes = size_t(workers) * 2 * MT * NT * 4;
    const size_t aBytes = FULLROWS ? size_t(M + MT - 1) * AP : (AP == K ? 0 : size_t(M) * AP);
    Workspace memory(cBytes + aBytes, stream);
    if (!memory.Data())
        return;
    RangeRaw<MT, NT, LK, RM, FULLROWS><<<workers, nullptr, stream>>>(
        x, b, s, g, y, memory.Data(), memory.Data() + cBytes, M, K, N, E, workers, AP);
    memory.Complete();
}

}

namespace ultra_aggregate_prepare
{
using namespace AscendC;
using grouped_gelu::Min;
using aggregate_lpt_prepare::PackB;

__aicore__ inline void PrepareVector(const GlobalTensor<int8_t> &a, const GlobalTensor<int8_t> &b,
                                     const GlobalTensor<int8_t> &pa, const GlobalTensor<int8_t> &pb,
                                     int M, int K, int N, int E, int AP, int KP, int NP,
                                     int workers)
{
    // Prefetch scratch and tail zeros have distinct, bounded UB lifetimes.
    constexpr int CHUNK = 16384, STEP = 512;
    LocalTensor<int8_t> scratch(TPosition::VECCALC, 0, CHUNK * 2);
    const int64_t total = int64_t(E) * K * N;
    int slot = 0;
    for (int64_t off = int64_t(GetBlockIdx()) * CHUNK; off < total; off += workers * 2 * CHUNK)
    {
        const int span = Min(CHUNK, int(total - off)), blocks = span / STEP;
        if (blocks)
            DataCopy(scratch[slot * CHUNK], b[off], DataCopyParams(blocks, 1, STEP / 32 - 1, 0));
        slot ^= 1;
    }
    SetFlag<HardEvent::MTE2_S>(EVENT_ID4);
    WaitFlag<HardEvent::MTE2_S>(EVENT_ID4);
    if (AP != K)
        grouped_gelu::PackRows(a, pa, M, K, AP, workers * 2);
    const int pad = KP - K, blocks = NP / 32;
    if (pad)
    {
        LocalTensor<uint16_t> zero(TPosition::VECCALC, 65536, pad * NP / 2);
        Duplicate(zero, uint16_t(0), pad * NP / 2);
        SetFlag<HardEvent::V_MTE3>(EVENT_ID4);
        WaitFlag<HardEvent::V_MTE3>(EVENT_ID4);
        for (int e = GetBlockIdx(); e < E; e += workers * 2)
            DataCopy(pb[int64_t(e) * KP * NP + K * 32], zero.ReinterpretCast<int8_t>(),
                     DataCopyParams(blocks, pad, 0, K));
    }
}

}

namespace ultra_aggregate_epilogue
{
using aggregate_lpt_epilogue::PitchedEpilogue;
}

namespace ultra_aggregate
{
using namespace AscendC;
using grouped_gelu::Min;
using grouped_gelu::Up;
using grouped_gelu::Workspace;

using aggregate_lpt::Cube;

template <int MT, int NT, int OT, int AK, int BK, int KR, int ALIGN_A>
__global__ __mix__(1, 2)
    __attribute__((aligned(4096))) void Run(GM_ADDR x, GM_ADDR weight, GM_ADDR scale,
                                            GM_ADDR groups, GM_ADDR y, GM_ADDR workspace,
                                            GM_ADDR packedA, GM_ADDR packedB, int M, int K, int N,
                                            int E, int workers, int AP, int KP, int NP)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
    SetAtomicNone();
    int core = GetBlockIdx();
    if ASCEND_IS_AIV
    {
        core /= GetSubBlockNum();
    }
    GlobalTensor<int8_t> a, b, pa, pb;
    GlobalTensor<int64_t> g;
    GlobalTensor<float> s;
    GlobalTensor<int32_t> buffer;
    GlobalTensor<half> out;
    a.SetGlobalBuffer((__gm__ int8_t *)x);
    b.SetGlobalBuffer((__gm__ int8_t *)weight);
    pa.SetGlobalBuffer((__gm__ int8_t *)packedA);
    pb.SetGlobalBuffer((__gm__ int8_t *)packedB);
    g.SetGlobalBuffer((__gm__ int64_t *)groups);
    s.SetGlobalBuffer((__gm__ float *)scale);
    buffer.SetGlobalBuffer((__gm__ int32_t *)workspace);
    out.SetGlobalBuffer((__gm__ half *)y);
    if ASCEND_IS_AIV
    {
        TPipe pipe;
        SetMaskNorm();
        SetVectorMask<uint8_t>(~uint64_t(0), ~uint64_t(0));
        LocalTensor<int64_t> ends(TPosition::VECCALC, 192512, 128);
        DataCopyPad(ends, g, DataCopyExtParams(1, E * 8, 0, 0, 0),
                    DataCopyPadExtParams<int64_t>{false, 0, 0, 0});
        SetFlag<HardEvent::MTE2_S>(EVENT_ID6);
        WaitFlag<HardEvent::MTE2_S>(EVENT_ID6);
        generalized_prepared::PrepareVector(a, b, pa, pb, ends, M, K, N, E, AP, KP, NP, workers);
        CrossCoreSetFlag<0, PIPE_MTE3>(10);
        CrossCoreWaitFlag(10);
        CrossCoreSetFlag<2, PIPE_MTE3>(8);
        CrossCoreSetFlag<2, PIPE_MTE2>(2);
        CrossCoreSetFlag<2, PIPE_MTE2>(3);
    }
    if (AP != K)
        a.SetGlobalBuffer((__gm__ int8_t *)packedA);
    constexpr int CSLOTS = 131072 / (MT * OT * 4);
    const int columns = (N + OT - 1) / OT, mainK = Min(BK, KP), tailK = KP - mainK;
    int next = core, base = 0, previous = 0, sequence = 0;
    if ASCEND_IS_AIC
    {
        ultra_aggregate_prepare::PackB<KR>(b, pb, g, K, N, E, KP, NP, workers);
        CrossCoreWaitFlag(8);
        Cube<MT, NT, OT, AK, BK> cube;
        cube.Init();
        for (int e = 0; e < E; ++e)
        {
            const int end = int(g.GetValue(e)), length = end - previous,
                      count = (length + MT - 1) / MT;
            while (next < base + count)
            {
                const int row = (next - base) * MT, rows = Min(MT, length - row);
                cube.LoadA(a[int64_t(previous + row) * AP], rows, K, AP);
                if (tailK == 0)
                {
                    cube.LoadA0(rows, 0, mainK);
                    for (int group = 0; group < columns; ++group)
                    {
                        const int col = group * OT, wideCols = Min(OT, N - col),
                                  cslot = sequence % CSLOTS, slot = sequence++ & 1;
                        for (int ns = 0; ns < wideCols; ns += NT)
                        {
                            const int cols = Min(NT, wideCols - ns);
                            cube.Compute(
                                pb[int64_t(e) * KP * NP + int64_t((col + ns) / 32) * KP * 32],
                                buffer[int64_t(core * 2 + slot) * MT * OT], rows, cols, mainK, KP,
                                ns, wideCols, slot, cslot, true, ns + NT >= wideCols);
                        }
                    }
                    cube.EndPhase();
                }
                else
                {
                    for (int first = 0; first < columns; first += CSLOTS)
                    {
                        const int batch = Min(CSLOTS, columns - first);
                        cube.LoadA0(rows, 0, mainK);
                        for (int i = 0; i < batch; ++i)
                        {
                            const int col = (first + i) * OT, wideCols = Min(OT, N - col),
                                      slot = (sequence + i) & 1;
                            for (int ns = 0; ns < wideCols; ns += NT)
                                cube.Compute(
                                    pb[int64_t(e) * KP * NP + int64_t((col + ns) / 32) * KP * 32],
                                    buffer[int64_t(core * 2 + slot) * MT * OT], rows,
                                    Min(NT, wideCols - ns), mainK, KP, ns, wideCols, slot,
                                    (sequence + i) % CSLOTS, true, false);
                        }
                        cube.EndPhase();
                        cube.LoadA0(rows, mainK, tailK);
                        for (int i = 0; i < batch; ++i)
                        {
                            const int col = (first + i) * OT, wideCols = Min(OT, N - col),
                                      slot = (sequence + i) & 1;
                            for (int ns = 0; ns < wideCols; ns += NT)
                                cube.Compute(pb[int64_t(e) * KP * NP +
                                                int64_t((col + ns) / 32) * KP * 32 + mainK * 32],
                                             buffer[int64_t(core * 2 + slot) * MT * OT], rows,
                                             Min(NT, wideCols - ns), tailK, KP, ns, wideCols, slot,
                                             (sequence + i) % CSLOTS, false, ns + NT >= wideCols);
                        }
                        cube.EndPhase();
                        sequence += batch;
                    }
                }
                cube.EndRow();
                next += workers;
            }
            base += count;
            previous = end;
        }
        cube.Finish();
    }
    if ASCEND_IS_AIV
    {
        TPipe pipe;
        SetMaskNorm();
        SetVectorMask<uint8_t>(~uint64_t(0), ~uint64_t(0));
        ultra_aggregate_epilogue::PitchedEpilogue<MT, OT, false, true> epilogue;
        for (int e = 0; e < E; ++e)
        {
            const int end = int(g.GetValue(e)), length = end - previous,
                      count = (length + MT - 1) / MT;
            while (next < base + count)
            {
                const int row = (next - base) * MT, rows = Min(MT, length - row);
                for (int group = 0; group < columns; ++group)
                {
                    const int col = group * OT, slot = sequence++ & 1;
                    CrossCoreWaitFlag(slot);
                    epilogue.Run(buffer[int64_t(core * 2 + slot) * MT * OT], s, out, previous + row,
                                 col, rows, Min(OT, N - col), N, e, 1, slot);
                }
                next += workers;
            }
            base += count;
            previous = end;
        }
    }
}

template <int MT, int NT, int OT, int AK, int BK, int KR, int ALIGN_A = 0>
inline bool Launch(GM_ADDR x, GM_ADDR b, GM_ADDR s, GM_ADDR g, GM_ADDR y, int M, int K, int N,
                   int E, int cores, aclrtStream stream)
{
    static_assert(131072 / (MT * OT * 4) >= 2, "L0C capacity exceeded");
    const int workers = std::min(cores, std::max(E, (M + MT - 1) / MT));
    const int KP = (K + 31) / 32 * 32, NP = (N + 31) / 32 * 32;
    int AP = K;
    if constexpr (ALIGN_A > 0)
        AP = (K + ALIGN_A - 1) / ALIGN_A * ALIGN_A;
    if (KP > AK || KP > 2 * BK || 4 * KR * NP > 524288)
        return false;
    const size_t cBytes = size_t(workers) * 2 * MT * OT * 4, aBytes = AP == K ? 0 : size_t(M) * AP;
    const size_t bBytes = size_t(E) * KP * NP;
    if (aBytes + bBytes > (size_t(96) << 20))
        return false;
    Workspace memory(cBytes + aBytes + bBytes, stream);
    if (!memory.Data())
        return false;
    GM_ADDR base = memory.Data();
    Run<MT, NT, OT, AK, BK, KR, ALIGN_A>
        <<<workers, nullptr, stream>>>(x, b, s, g, y, base, base + cBytes, base + cBytes + aBytes,
                                       M, K, N, E, workers, AP, KP, NP);
    memory.Complete();
    return true;
}
}

namespace padded_narrow
{
using namespace AscendC;
using grouped_gelu::Min;
using grouped_gelu::Up;
using grouped_gelu::Workspace;
template <int SPAN>
__aicore__ inline void StartNarrowLoad(const GlobalTensor<int8_t> &source,
                                       const LocalTensor<int8_t> &input, int expert, int first,
                                       int count, int K, int N)
{
    Duplicate(input.ReinterpretCast<uint16_t>(), uint16_t(0), SPAN / 2);
    SetFlag<HardEvent::V_MTE2>(EVENT_ID4);
    WaitFlag<HardEvent::V_MTE2>(EVENT_ID4);
    if (count)
        DataCopyPad(
            input, source[(int64_t(expert) * K + first) * N],
            DataCopyExtParams(1, count * N, 0, 0, 0),
            DataCopyPadExtParams<int8_t>{true, 0, uint8_t(Up(count * N, 32) - count * N), 0});
    SetFlag<HardEvent::MTE2_V>(EVENT_ID4);
}
template <int NP, int ROWS>
__aicore__ inline void PackAdaptiveRows(const GlobalTensor<int8_t> &source,
                                        const GlobalTensor<int8_t> &destination,
                                        const GlobalTensor<int64_t> &groups, int K, int N, int E,
                                        int KP, int workers, const int *experts, int active)
{
    static_assert(NP == 32, "single C0 producer required");
    constexpr int SPAN = ROWS * 32, SIZE = ROWS * 16;
    const int rowTiles = (KP + ROWS - 1) / ROWS, tasks = active * rowTiles;
    if (GetBlockIdx() >= tasks)
        return;
    LocalTensor<int8_t> raw(TPosition::VECCALC, 0, SPAN * 2);
    LocalTensor<uint16_t> lo(TPosition::VECCALC, 32768, SIZE);
    LocalTensor<uint16_t> hi(TPosition::VECCALC, 49152, SIZE);
    LocalTensor<uint16_t> merged(TPosition::VECCALC, 65536, SIZE);
    LocalTensor<uint16_t> output(TPosition::VECCALC, 81920, SIZE);
    LocalTensor<uint16_t> tailMask(TPosition::VECCALC, 98304, SIZE);
    LocalTensor<int32_t> indices(TPosition::VECCALC, 114688, SIZE);
    LocalTensor<int32_t> temporary(TPosition::VECCALC, 147456, SIZE);
    LocalTensor<uint32_t> phases(TPosition::VECCALC, 180224, SIZE / 32);
    auto rows = raw.ReinterpretCast<uint32_t>();
    auto words = temporary.ReinterpretCast<uint32_t>();
    CreateVecIndex(indices, int32_t(0), SIZE);
    PipeBarrier<PIPE_V>();
    ShiftLeft(words, indices.ReinterpretCast<uint32_t>(), uint32_t(28), SIZE);
    PipeBarrier<PIPE_V>();
    ShiftRight(words, words, uint32_t(27), SIZE);
    PipeBarrier<PIPE_V>();
    for (int word = 0; word < 16; ++word)
    {
        const int remaining = N - word * 2, valid = remaining >= 2 ? 2 : (remaining > 0 ? 1 : 0);
        output.SetValue(word,
                        valid == 2 ? uint16_t(65535) : (valid == 1 ? uint16_t(255) : uint16_t(0)));
    }
    SetFlag<HardEvent::S_V>(EVENT_ID6);
    WaitFlag<HardEvent::S_V>(EVENT_ID6);
    Gather(tailMask.ReinterpretCast<half>(), output.ReinterpretCast<half>(), words, 0, SIZE);
    CreateVecIndex(rows.ReinterpretCast<int32_t>(), int32_t(0), ROWS);
    PipeBarrier<PIPE_V>();
    Muls(rows.ReinterpretCast<int32_t>(), rows.ReinterpretCast<int32_t>(), int32_t(N), ROWS);
    PipeBarrier<PIPE_V>();
    ShiftRight(rows, rows, uint32_t(1), ROWS);
    PipeBarrier<PIPE_V>();
    ShiftLeft(rows, rows, uint32_t(1), ROWS);
    PipeBarrier<PIPE_V>();
    Brcb(indices, rows.ReinterpretCast<int32_t>(), ROWS / 8, {uint16_t(2), uint16_t(16)});
    Brcb(indices[8], rows.ReinterpretCast<int32_t>(), ROWS / 8, {uint16_t(2), uint16_t(16)});
    PipeBarrier<PIPE_V>();
    Add(indices, indices, temporary, SIZE);
    PipeBarrier<PIPE_V>();
    Adds(temporary, indices, int32_t(2), SIZE);
    Duplicate(phases, uint32_t(0x0000ffff), SIZE / 32);
    SetFlag<HardEvent::V_MTE2>(EVENT_ID4);
    WaitFlag<HardEvent::V_MTE2>(EVENT_ID4);
    SetFlag<HardEvent::MTE3_V>(EVENT_ID4);
    const int initialTask = GetBlockIdx(), initialExpert = experts[initialTask / rowTiles];
    const int initialFirst = initialTask % rowTiles * ROWS,
              initialSpan = Min(ROWS, KP - initialFirst);
    const int initialCount = initialFirst < K ? Min(initialSpan, K - initialFirst) : 0;
    StartNarrowLoad<SPAN>(source, raw, initialExpert, initialFirst, initialCount, K, N);
    int sequence = 0;
    for (int task = GetBlockIdx(); task < tasks; task += workers)
    {
        const int expert = experts[task / rowTiles], first = task % rowTiles * ROWS;
        const int spanRows = Min(ROWS, KP - first);
        auto input = raw[(sequence++ & 1) * SPAN];
        WaitFlag<HardEvent::MTE2_V>(EVENT_ID4);
        const int next = task + workers;
        if (next < tasks)
        {
            const int nextExpert = experts[next / rowTiles], nextFirst = next % rowTiles * ROWS;
            const int nextSpan = Min(ROWS, KP - nextFirst),
                      nextCount = nextFirst < K ? Min(nextSpan, K - nextFirst) : 0;
            StartNarrowLoad<SPAN>(source, raw[(sequence & 1) * SPAN], nextExpert, nextFirst,
                                  nextCount, K, N);
        }
        Gather(lo.ReinterpretCast<half>(), input.ReinterpretCast<half>(),
               indices.ReinterpretCast<uint32_t>(), 0, SIZE);
        if (N % 2)
        {
            Gather(hi.ReinterpretCast<half>(), input.ReinterpretCast<half>(),
                   temporary.ReinterpretCast<uint32_t>(), 0, SIZE);
            PipeBarrier<PIPE_V>();
            ShiftRight(merged, lo, uint16_t(8), SIZE);
            ShiftLeft(hi, hi, uint16_t(8), SIZE);
            PipeBarrier<PIPE_V>();
            Or(merged, merged, hi, SIZE);
            PipeBarrier<PIPE_V>();
        }
        WaitFlag<HardEvent::MTE3_V>(EVENT_ID4);
        if (N % 2)
        {
            Select(output.ReinterpretCast<half>(), phases.ReinterpretCast<uint8_t>(),
                   lo.ReinterpretCast<half>(), merged.ReinterpretCast<half>(),
                   SELMODE::VSEL_TENSOR_TENSOR_MODE, SIZE);
        }
        else
        {
            PipeBarrier<PIPE_V>();
            Or(output, lo, lo, SIZE);
        }
        PipeBarrier<PIPE_V>();
        And(output, output, tailMask, SIZE);
        SetFlag<HardEvent::V_MTE3>(EVENT_ID4);
        WaitFlag<HardEvent::V_MTE3>(EVENT_ID4);
        DataCopy(destination[(int64_t(expert) * KP + first) * NP], output.ReinterpretCast<int8_t>(),
                 spanRows * NP);
        SetFlag<HardEvent::MTE3_V>(EVENT_ID4);
    }
    WaitFlag<HardEvent::MTE3_V>(EVENT_ID4);
    SetFlag<HardEvent::V_MTE2>(EVENT_ID4);
    WaitFlag<HardEvent::V_MTE2>(EVENT_ID4);
}

template <int NP>
__aicore__ inline void
PackPaddedB(const GlobalTensor<int8_t> &source, const GlobalTensor<int8_t> &destination,
            const GlobalTensor<int64_t> &groups, int K, int N, int E, int KP, int workers)
{
    LocalTensor<int64_t> ends(TPosition::VECCALC, 192512, 128);
    DataCopyPad(ends, groups, DataCopyExtParams(1, E * 8, 0, 0, 0),
                DataCopyPadExtParams<int64_t>{false, 0, 0, 0});
    SetFlag<HardEvent::MTE2_S>(EVENT_ID6);
    WaitFlag<HardEvent::MTE2_S>(EVENT_ID6);
    int experts[128], active = 0, previous = 0;
    for (int expert = 0; expert < E; ++expert)
    {
        const int end = int(ends.GetValue(expert));
        if (end > previous)
            experts[active++] = expert;
        previous = end;
    }
    if (int64_t(active) * KP <= int64_t(workers) * 1024)
        PackAdaptiveRows<NP, 128>(source, destination, groups, K, N, E, KP, workers, experts,
                                  active);
    else
        PackAdaptiveRows<NP, 512>(source, destination, groups, K, N, E, KP, workers, experts,
                                  active);
}
template <int MT, int NT, bool SPLIT, int LK = 256, int NSTAGES = 3, bool NZ = false> class Cube
{
    static constexpr int FK = 256;
    static constexpr int STAGES = NSTAGES;
    static constexpr int PANEL = (MT + NT) * LK;
    static constexpr int CSLOTS = MT * NT * 4 <= 65536 ? 2 : 1;
    static_assert(STAGES * PANEL <= 524288, "L1 capacity exceeded");
    static_assert(2 * MT * FK <= 65536 && 2 * NT * FK <= 65536, "L0A/B capacity exceeded");
    static_assert(CSLOTS * MT * NT * 4 <= 131072, "L0C capacity exceeded");
    LocalTensor<int8_t> l1{TPosition::A1, 0, STAGES * PANEL};
    LocalTensor<int8_t> a0{TPosition::A2, 0, 2 * MT * FK};
    LocalTensor<int8_t> b0{TPosition::B2, 0, 2 * NT * FK};
    LocalTensor<int32_t> c0{TPosition::CO1, 0, CSLOTS * MT * NT};
    int fragmentSlot = 0;
    struct Pending
    {
        int slot, count, rows, cols, outputSlot;
        GM_ADDR output;
        bool first, last;
    };
    Pending pending[2];
    int head = 0, pendingCount = 0, producer = 0;

    __aicore__ inline void CopyNd(const LocalTensor<int8_t> &dst, const GlobalTensor<int8_t> &src,
                                  int rows, int cols, int stride, int paddedRows)
    {
        grouped_gelu::CopyNdShared(dst, src, rows, cols, stride, paddedRows);
    }

    template <bool FULL> __aicore__ inline void ConsumeTile(const Pending &p)
    {
        const int cslot = p.outputSlot % CSLOTS;
        if (p.first)
            WaitFlag<HardEvent::FIX_M>(cslot);
        auto c = c0[cslot * MT * NT];
        WaitFlag<HardEvent::MTE2_MTE1>(p.slot);
        const int actualM = FULL || MT >= 256 ? MT : Up(p.rows, 16);
        const int activeN = FULL || MT >= 256 || actualM < 32 ? NT : Up(p.cols, 32);
        const int physicalK = FULL ? LK : p.count;
#pragma unroll
        for (int f = 0; f < physicalK; f += FK)
        {
            const int fk = Up(Min(FK, physicalK - f), 32);
            const int fs = fragmentSlot;
            WaitFlag<HardEvent::M_MTE1>(fs);
            auto aa = a0[fs * MT * FK];
            auto bb = b0[fs * NT * FK];
            auto la = l1[p.slot * PANEL + f * MT];
            auto lb = l1[p.slot * PANEL + MT * LK + f * 32];
            LoadData2DParams pa;
            pa.startIndex = 0;
            pa.repeatTimes = fk / 32;
            pa.srcStride = MT / 16;
            pa.dstGap = 0;
            pa.ifTranspose = false;
            pa.sid = 0;
            pa.addrMode = 0;
            for (int mi = 0; mi < (FULL ? MT / 16 : (p.rows + 15) / 16); ++mi)
                LoadData(aa[mi * fk * 16], la[mi * 512], pa);
            LoadData2dTransposeParams pb;
            pb.startIndex = 0;
            pb.repeatTimes = fk / 32;
            pb.srcStride = 1;
            pb.dstGap = 2 * (activeN / 32) - 1;
            pb.dstFracGap = 0;
            for (int ni = 0; ni < (FULL ? NT / 32 : (p.cols + 31) / 32); ++ni)
                LoadDataWithTranspose(bb[ni * 1024], lb[ni * LK * 32], pb);
            SetFlag<HardEvent::MTE1_M>(fs);
            WaitFlag<HardEvent::MTE1_M>(fs);
            MmadParams mm;
            mm.m = actualM;
            mm.n = activeN;
            mm.k = fk;
            mm.cmatrixInitVal = p.first && f == 0;
            mm.unitFlag = p.last && f + FK >= physicalK ? 3 : 2;
            Mmad(c, aa, bb, mm);
            if (actualM * activeN < 2560)
                PipeBarrier<PIPE_M>();
            SetFlag<HardEvent::M_MTE1>(fs);
            fragmentSlot ^= 1;
        }
        SetFlag<HardEvent::MTE1_MTE2>(p.slot);
        if (p.last)
        {
            GlobalTensor<int32_t> dst;
            dst.SetGlobalBuffer((__gm__ int32_t *)p.output);
            if constexpr (!SPLIT)
                CrossCoreWaitFlag(2 + p.outputSlot);
            FixpipeParamsV220 fp;
            fp.nSize = activeN;
            fp.mSize = MT >= 256 ? MT : p.rows;
            fp.srcStride = actualM;
            fp.dstStride = activeN;
            fp.quantPre = QuantMode_t::NoQuant;
            fp.reluEn = false;
            fp.unitFlag = 3;
            Fixpipe<int32_t, int32_t, CFG_ROW_MAJOR>(dst, c, fp);
            SetFlag<HardEvent::FIX_M>(cslot);
            if constexpr (!SPLIT)
                CrossCoreSetFlag<2, PIPE_FIX>(p.outputSlot);
        }
    }

    __aicore__ inline void Consume(const Pending &p)
    {
        if (p.rows == MT && p.cols == NT && p.count == LK)
            ConsumeTile<true>(p);
        else
            ConsumeTile<false>(p);
    }

  public:
    __aicore__ inline void Init()
    {
        SetLoadDataPaddingValue<uint64_t>(0);
        SetFixpipeNz2ndFlag(1, 0, 0);
        for (int i = 0; i < STAGES; ++i)
            SetFlag<HardEvent::MTE1_MTE2>(i);
        for (int i = 0; i < 2; ++i)
        {
            SetFlag<HardEvent::M_MTE1>(i);
        }
        for (int i = 0; i < CSLOTS; ++i)
            SetFlag<HardEvent::FIX_M>(i);
    }

    __aicore__ inline void Compute(const GlobalTensor<int8_t> &a, const GlobalTensor<int8_t> &b,
                                   const GlobalTensor<int32_t> &dst, int rows, int cols, int K,
                                   int N, int start, int depth, int outputSlot, int bKPad = 0)
    {
        const int panels = (depth + LK - 1) / LK;
        for (int p = 0; p < panels; ++p)
        {
            const int slot = producer;
            int ki = p;
            if constexpr (MT >= 64 && NT >= 128)
                ki = (p + GetBlockIdx()) % panels;
            const int count = Min(LK, depth - ki * LK);
            WaitFlag<HardEvent::MTE1_MTE2>(slot);
            CopyNd(l1[slot * PANEL], a[start + ki * LK], rows, count, K, MT);
            if constexpr (NT == 32)
                DataCopy(l1[slot * PANEL + MT * LK], b[int64_t(start + ki * LK) * N],
                         Up(count, 32) * 32);
            else
                for (int column = 0; column < cols; column += 32)
                    DataCopy(l1[slot * PANEL + MT * LK + column * LK],
                             b[int64_t(start + ki * LK) * N + column],
                             DataCopyParams(Up(count, 32), 1, N / 32 - 1, 0));
            SetFlag<HardEvent::MTE2_MTE1>(slot);
            // Keep two pending panels across output tiles, so the next tile's
            // input transfer overlaps the current tile's final MMAD/Fixpipe.
            if (pendingCount == (STAGES < 3 ? 1 : 2))
            {
                Consume(pending[head]);
                pending[head] = {slot,   count,          rows,
                                 cols,   outputSlot,     (GM_ADDR)dst.GetPhyAddr(),
                                 p == 0, p + 1 == panels};
                if constexpr (STAGES >= 3)
                    head ^= 1;
            }
            else
            {
                pending[(head + pendingCount) & 1] = {
                    slot,   count,          rows, cols, outputSlot, (GM_ADDR)dst.GetPhyAddr(),
                    p == 0, p + 1 == panels};
                ++pendingCount;
            }
            producer = producer + 1 < STAGES ? producer + 1 : 0;
        }
    }

    __aicore__ inline void Finish()
    {
        while (pendingCount)
        {
            Consume(pending[head]);
            if constexpr (STAGES >= 3)
                head ^= 1;
            --pendingCount;
        }
        for (int i = 0; i < STAGES; ++i)
            WaitFlag<HardEvent::MTE1_MTE2>(i);
        for (int i = 0; i < 2; ++i)
        {
            WaitFlag<HardEvent::M_MTE1>(i);
        }
        for (int i = 0; i < CSLOTS; ++i)
            WaitFlag<HardEvent::FIX_M>(i);
    }
};

template <int MT, int NT, int LK, int RM, bool FULLROWS>
__global__ __mix__(1, 2)
    __attribute__((aligned(4096))) void RangeRaw(GM_ADDR x, GM_ADDR weight, GM_ADDR scale,
                                                 GM_ADDR groups, GM_ADDR y, GM_ADDR workspace,
                                                 GM_ADDR packedA, GM_ADDR packedB, int M, int K,
                                                 int N, int E, int workers, int AP, int KP, int NP)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
    SetAtomicNone();
    int core = GetBlockIdx();
    if ASCEND_IS_AIV
    {
        core /= GetSubBlockNum();
    }
    GlobalTensor<int8_t> a, b;
    GlobalTensor<int64_t> g;
    GlobalTensor<float> s;
    GlobalTensor<int32_t> buffer;
    GlobalTensor<half> out;
    a.SetGlobalBuffer((__gm__ int8_t *)x);
    b.SetGlobalBuffer((__gm__ int8_t *)weight);
    g.SetGlobalBuffer((__gm__ int64_t *)groups);
    s.SetGlobalBuffer((__gm__ float *)scale);
    buffer.SetGlobalBuffer((__gm__ int32_t *)workspace);
    out.SetGlobalBuffer((__gm__ half *)y);
    if ASCEND_IS_AIV
    {
        TPipe pipe;
        SetMaskNorm();
        SetVectorMask<uint8_t>(~uint64_t(0), ~uint64_t(0));
        GlobalTensor<int8_t> pa, pb;
        pa.SetGlobalBuffer((__gm__ int8_t *)packedA);
        pb.SetGlobalBuffer((__gm__ int8_t *)packedB);
        PackPaddedB<NT>(b, pb, g, K, N, E, KP, workers * 2);
        if constexpr (FULLROWS)
            padded_rows::PadA(a, pa, M, K, AP, MT - 1, workers * 2);
        else if (AP != K)
            grouped_gelu::PackRows(a, pa, M, K, AP, workers * 2);
        CrossCoreSetFlag<0, PIPE_MTE3>(10);
        CrossCoreWaitFlag(10);
        CrossCoreSetFlag<2, PIPE_MTE3>(8);
    }
    if ASCEND_IS_AIC
    {
        CrossCoreWaitFlag(8);
    }
    if (FULLROWS || AP != K)
        a.SetGlobalBuffer((__gm__ int8_t *)packedA);
    b.SetGlobalBuffer((__gm__ int8_t *)packedB);
    const int rowTiles = (M + RM - 1) / RM, begin = core * rowTiles / workers * RM;
    const int limit = Min(M, (core + 1) * rowTiles / workers * RM);
    if ASCEND_IS_AIC
    {
        Cube<MT, NT, false, LK, 3, false> cube;
        cube.Init();
        int lo = 0, hi = E - 1;
        while (lo < hi)
        {
            const int mid = (lo + hi) / 2;
            if (g.GetValue(mid) <= begin)
                lo = mid + 1;
            else
                hi = mid;
        }
        int row = begin, sequence = 0;
        for (int e = lo; e < E && row < limit; ++e)
        {
            const int end = Min(limit, int(g.GetValue(e)));
            while (row < end)
            {
                const int rows = Min(MT, end - row), slot = sequence++ & 1;
                cube.Compute(a[int64_t(row) * AP], b[int64_t(e) * KP * NP],
                             buffer[int64_t(core * 2 + slot) * MT * NT], rows, N, AP, NP, 0, K,
                             slot, KP);
                row += rows;
            }
        }
        cube.Finish();
    }
    if ASCEND_IS_AIV
    {
        TPipe pipe;
        SetMaskNorm();
        SetVectorMask<uint8_t>(~uint64_t(0), ~uint64_t(0));
        LocalTensor<int64_t> ends(TPosition::VECCALC, 172032, 128);
        DataCopyPad(ends, g, DataCopyExtParams(1, E * 8, 0, 0, 0),
                    DataCopyPadExtParams<int64_t>{false, 0, 0, 0});
        SetFlag<HardEvent::MTE2_S>(EVENT_ID4);
        WaitFlag<HardEvent::MTE2_S>(EVENT_ID4);
        CrossCoreSetFlag<2, PIPE_MTE2>(2);
        CrossCoreSetFlag<2, PIPE_MTE2>(3);
        grouped_gelu::Epilogue<MT, NT> epilogue;
        int lo = 0, hi = E - 1;
        while (lo < hi)
        {
            const int mid = (lo + hi) / 2;
            if (ends.GetValue(mid) <= begin)
                lo = mid + 1;
            else
                hi = mid;
        }
        int row = begin, sequence = 0;
        for (int e = lo; e < E && row < limit; ++e)
        {
            const int end = Min(limit, int(ends.GetValue(e)));
            while (row < end)
            {
                const int rows = Min(MT, end - row), slot = sequence++ & 1;
                CrossCoreWaitFlag(slot);
                epilogue.Run(buffer[int64_t(core * 2 + slot) * MT * NT], s, out, row, 0, rows, N, N,
                             e, 1, slot);
                row += rows;
            }
        }
    }
}
template <int MT, int NT, int LK, int RM, bool FULLROWS>
inline bool LaunchRaw(GM_ADDR x, GM_ADDR b, GM_ADDR s, GM_ADDR g, GM_ADDR y, int M, int K, int N,
                      int E, int cores, aclrtStream stream)
{
    const int workers = (M < 64 ? cores : std::min(cores, (M + RM - 1) / RM)), AP = K,
              KP = (K + 31) / 32 * 32, NP = (N + 31) / 32 * 32;
    const size_t cBytes = size_t(workers) * 2 * MT * NT * 4;
    const size_t aBytes = FULLROWS ? size_t(M + MT - 1) * AP : (AP == K ? 0 : size_t(M) * AP);
    const size_t bBytes = size_t(E) * KP * NP;
    if (aBytes + bBytes > (size_t(96) << 20))
        return false;
    Workspace memory(cBytes + aBytes + bBytes, stream);
    if (!memory.Data())
        return false;
    RangeRaw<MT, NT, LK, RM, FULLROWS><<<workers, nullptr, stream>>>(
        x, b, s, g, y, memory.Data(), memory.Data() + cBytes, memory.Data() + cBytes + aBytes, M, K,
        N, E, workers, AP, KP, NP);
    memory.Complete();
    return true;
}

}

namespace direct_wide
{
using namespace AscendC;
using grouped_gelu::Min;
using grouped_gelu::Up;
using grouped_gelu::Workspace;
template <int MT, int NT, bool SPLIT, int LK = 256, int NSTAGES = 3, bool NZ = false> class Cube
{
    static constexpr int FK = 128;
    static constexpr int STAGES = NSTAGES;
    static constexpr int PANEL = (MT + NT) * LK;
    static constexpr int CSLOTS = MT * NT * 4 <= 65536 ? 2 : 1;
    static_assert(STAGES * PANEL <= 524288, "L1 capacity exceeded");
    static_assert(2 * MT * FK <= 65536 && 2 * NT * FK <= 65536, "L0A/B capacity exceeded");
    static_assert(CSLOTS * MT * NT * 4 <= 131072, "L0C capacity exceeded");
    LocalTensor<int8_t> l1{TPosition::A1, 0, STAGES * PANEL};
    LocalTensor<int8_t> a0{TPosition::A2, 0, 2 * MT * FK};
    LocalTensor<int8_t> b0{TPosition::B2, 0, 2 * NT * FK};
    LocalTensor<int32_t> c0{TPosition::CO1, 0, CSLOTS * MT * NT};
    int fragmentSlot = 0;
    struct Pending
    {
        int slot, count, rows, cols, outputSlot;
        GM_ADDR output;
        bool first, last;
    };
    Pending pending[2];
    int head = 0, pendingCount = 0, producer = 0;

    __aicore__ inline void CopyNd(const LocalTensor<int8_t> &dst, const GlobalTensor<int8_t> &src,
                                  int rows, int cols, int stride, int paddedRows)
    {
        grouped_gelu::CopyNdShared(dst, src, rows, cols, stride, paddedRows);
    }

    template <bool FULL> __aicore__ inline void ConsumeTile(const Pending &p)
    {
        const int cslot = p.outputSlot % CSLOTS;
        if (p.first)
            WaitFlag<HardEvent::FIX_M>(cslot);
        auto c = c0[cslot * MT * NT];
        WaitFlag<HardEvent::MTE2_MTE1>(p.slot);
        const int actualM = FULL || MT >= 256 ? MT : Up(p.rows, 16);
        const int activeN = FULL || MT >= 256 || actualM < 32 ? NT : Up(p.cols, 32);
        const int physicalK = FULL ? LK : p.count;
#pragma unroll
        for (int f = 0; f < physicalK; f += FK)
        {
            const int fk = Up(Min(FK, physicalK - f), 32);
            const int fs = fragmentSlot;
            WaitFlag<HardEvent::M_MTE1>(fs);
            auto aa = a0[fs * MT * FK];
            auto bb = b0[fs * NT * FK];
            auto la = l1[p.slot * PANEL + f * MT];
            auto lb = l1[p.slot * PANEL + MT * LK + f * 32];
            LoadData2DParams pa;
            pa.startIndex = 0;
            pa.repeatTimes = fk / 32;
            pa.srcStride = MT / 16;
            pa.dstGap = 0;
            pa.ifTranspose = false;
            pa.sid = 0;
            pa.addrMode = 0;
            for (int mi = 0; mi < (FULL ? MT / 16 : (p.rows + 15) / 16); ++mi)
                LoadData(aa[mi * fk * 16], la[mi * 512], pa);
            LoadData2dTransposeParams pb;
            pb.startIndex = 0;
            pb.repeatTimes = fk / 32;
            pb.srcStride = 1;
            pb.dstGap = 2 * (activeN / 32) - 1;
            pb.dstFracGap = 0;
            for (int ni = 0; ni < (FULL ? NT / 32 : (p.cols + 31) / 32); ++ni)
                LoadDataWithTranspose(bb[ni * 1024], lb[ni * LK * 32], pb);
            SetFlag<HardEvent::MTE1_M>(fs);
            WaitFlag<HardEvent::MTE1_M>(fs);
            MmadParams mm;
            mm.m = actualM;
            mm.n = activeN;
            mm.k = fk;
            mm.cmatrixInitVal = p.first && f == 0;
            mm.unitFlag = p.last && f + FK >= physicalK ? 3 : 2;
            Mmad(c, aa, bb, mm);
            if (actualM * activeN < 2560)
                PipeBarrier<PIPE_M>();
            SetFlag<HardEvent::M_MTE1>(fs);
            fragmentSlot ^= 1;
        }
        SetFlag<HardEvent::MTE1_MTE2>(p.slot);
        if (p.last)
        {
            GlobalTensor<int32_t> dst;
            dst.SetGlobalBuffer((__gm__ int32_t *)p.output);
            if constexpr (!SPLIT)
                CrossCoreWaitFlag(2 + p.outputSlot);
            FixpipeParamsV220 fp;
            fp.nSize = activeN;
            fp.mSize = MT >= 256 ? MT : p.rows;
            fp.srcStride = actualM;
            fp.dstStride = activeN;
            fp.quantPre = QuantMode_t::NoQuant;
            fp.reluEn = false;
            fp.unitFlag = 3;
            Fixpipe<int32_t, int32_t, CFG_ROW_MAJOR>(dst, c, fp);
            SetFlag<HardEvent::FIX_M>(cslot);
            if constexpr (!SPLIT)
                CrossCoreSetFlag<2, PIPE_FIX>(p.outputSlot);
        }
    }

    __aicore__ inline void Consume(const Pending &p)
    {
        if (p.rows == MT && p.cols == NT && p.count == LK)
            ConsumeTile<true>(p);
        else
            ConsumeTile<false>(p);
    }

  public:
    __aicore__ inline void Init()
    {
        SetLoadDataPaddingValue<uint64_t>(0);
        SetFixpipeNz2ndFlag(1, 0, 0);
        for (int i = 0; i < STAGES; ++i)
            SetFlag<HardEvent::MTE1_MTE2>(i);
        for (int i = 0; i < 2; ++i)
        {
            SetFlag<HardEvent::M_MTE1>(i);
        }
        for (int i = 0; i < CSLOTS; ++i)
            SetFlag<HardEvent::FIX_M>(i);
    }

    __aicore__ inline void Compute(const GlobalTensor<int8_t> &a, const GlobalTensor<int8_t> &b,
                                   const GlobalTensor<int32_t> &dst, int rows, int cols, int K,
                                   int N, int start, int depth, int outputSlot, int bKPad = 0)
    {
        const int panels = (depth + LK - 1) / LK;
        for (int p = 0; p < panels; ++p)
        {
            const int slot = producer;
            int ki = p;
            if constexpr (MT >= 64 && NT >= 128)
                ki = (p + GetBlockIdx()) % panels;
            const int count = Min(LK, depth - ki * LK);
            WaitFlag<HardEvent::MTE1_MTE2>(slot);
            CopyNd(l1[slot * PANEL], a[start + ki * LK], rows, count, K, MT);
            CopyNd(l1[slot * PANEL + MT * LK], b[int64_t(start + ki * LK) * N], count, cols, N, LK);
            SetFlag<HardEvent::MTE2_MTE1>(slot);
            // Keep two pending panels across output tiles, so the next tile's
            // input transfer overlaps the current tile's final MMAD/Fixpipe.
            if (pendingCount == (STAGES < 3 ? 1 : 2))
            {
                Consume(pending[head]);
                pending[head] = {slot,   count,          rows,
                                 cols,   outputSlot,     (GM_ADDR)dst.GetPhyAddr(),
                                 p == 0, p + 1 == panels};
                if constexpr (STAGES >= 3)
                    head ^= 1;
            }
            else
            {
                pending[(head + pendingCount) & 1] = {
                    slot,   count,          rows, cols, outputSlot, (GM_ADDR)dst.GetPhyAddr(),
                    p == 0, p + 1 == panels};
                ++pendingCount;
            }
            producer = producer + 1 < STAGES ? producer + 1 : 0;
        }
    }

    __aicore__ inline void Finish()
    {
        while (pendingCount)
        {
            Consume(pending[head]);
            if constexpr (STAGES >= 3)
                head ^= 1;
            --pendingCount;
        }
        for (int i = 0; i < STAGES; ++i)
            WaitFlag<HardEvent::MTE1_MTE2>(i);
        for (int i = 0; i < 2; ++i)
        {
            WaitFlag<HardEvent::M_MTE1>(i);
        }
        for (int i = 0; i < CSLOTS; ++i)
            WaitFlag<HardEvent::FIX_M>(i);
    }
};

template <int MT, int NT, int LK, int RM, bool FULLROWS>
__global__ __mix__(1, 2)
    __attribute__((aligned(4096))) void RangeRaw(GM_ADDR x, GM_ADDR weight, GM_ADDR scale,
                                                 GM_ADDR groups, GM_ADDR y, GM_ADDR workspace,
                                                 GM_ADDR packedA, int M, int K, int N, int E,
                                                 int workers, int AP)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
    SetAtomicNone();
    int core = GetBlockIdx();
    if ASCEND_IS_AIV
    {
        core /= GetSubBlockNum();
    }
    GlobalTensor<int8_t> a, b;
    GlobalTensor<int64_t> g;
    GlobalTensor<float> s;
    GlobalTensor<int32_t> buffer;
    GlobalTensor<half> out;
    a.SetGlobalBuffer((__gm__ int8_t *)x);
    b.SetGlobalBuffer((__gm__ int8_t *)weight);
    g.SetGlobalBuffer((__gm__ int64_t *)groups);
    s.SetGlobalBuffer((__gm__ float *)scale);
    buffer.SetGlobalBuffer((__gm__ int32_t *)workspace);
    out.SetGlobalBuffer((__gm__ half *)y);
    if (FULLROWS || AP != K)
    {
        if ASCEND_IS_AIV
        {
            TPipe pipe;
            SetMaskNorm();
            SetVectorMask<uint8_t>(~uint64_t(0), ~uint64_t(0));
            GlobalTensor<int8_t> pa;
            pa.SetGlobalBuffer((__gm__ int8_t *)packedA);
            if constexpr (FULLROWS)
                padded_rows::PadA(a, pa, M, K, AP, MT - 1, workers * 2);
            else
                grouped_gelu::PackRows(a, pa, M, K, AP, workers * 2);
            CrossCoreSetFlag<0, PIPE_MTE3>(10);
            CrossCoreWaitFlag(10);
            CrossCoreSetFlag<2, PIPE_MTE3>(8);
        }
        if ASCEND_IS_AIC
        {
            CrossCoreWaitFlag(8);
        }
        a.SetGlobalBuffer((__gm__ int8_t *)packedA);
    }
    const int rowTiles = (M + RM - 1) / RM, begin = core * rowTiles / workers * RM;
    const int limit = Min(M, (core + 1) * rowTiles / workers * RM);
    if ASCEND_IS_AIC
    {
        Cube<MT, NT, false, LK, 3, false> cube;
        cube.Init();
        int lo = 0, hi = E - 1;
        while (lo < hi)
        {
            const int mid = (lo + hi) / 2;
            if (g.GetValue(mid) <= begin)
                lo = mid + 1;
            else
                hi = mid;
        }
        int row = begin, sequence = 0;
        for (int e = lo; e < E && row < limit; ++e)
        {
            const int end = Min(limit, int(g.GetValue(e)));
            while (row < end)
            {
                const int rows = Min(MT, end - row), slot = sequence++ & 1;
                cube.Compute(a[int64_t(row) * AP], b[int64_t(e) * K * N],
                             buffer[int64_t(core * 2 + slot) * MT * NT], rows, N, AP, N, 0, K, slot,
                             K);
                row += rows;
            }
        }
        cube.Finish();
    }
    if ASCEND_IS_AIV
    {
        TPipe pipe;
        SetMaskNorm();
        SetVectorMask<uint8_t>(~uint64_t(0), ~uint64_t(0));
        LocalTensor<int64_t> ends(TPosition::VECCALC, 172032, 128);
        DataCopyPad(ends, g, DataCopyExtParams(1, E * 8, 0, 0, 0),
                    DataCopyPadExtParams<int64_t>{false, 0, 0, 0});
        SetFlag<HardEvent::MTE2_S>(EVENT_ID4);
        WaitFlag<HardEvent::MTE2_S>(EVENT_ID4);
        CrossCoreSetFlag<2, PIPE_MTE2>(2);
        CrossCoreSetFlag<2, PIPE_MTE2>(3);
        grouped_gelu::Epilogue<MT, NT> epilogue;
        int lo = 0, hi = E - 1;
        while (lo < hi)
        {
            const int mid = (lo + hi) / 2;
            if (ends.GetValue(mid) <= begin)
                lo = mid + 1;
            else
                hi = mid;
        }
        int row = begin, sequence = 0;
        for (int e = lo; e < E && row < limit; ++e)
        {
            const int end = Min(limit, int(ends.GetValue(e)));
            while (row < end)
            {
                const int rows = Min(MT, end - row), slot = sequence++ & 1;
                CrossCoreWaitFlag(slot);
                epilogue.Run(buffer[int64_t(core * 2 + slot) * MT * NT], s, out, row, 0, rows, N, N,
                             e, 1, slot);
                row += rows;
            }
        }
    }
}
template <int MT, int NT, int LK, int RM, bool FULLROWS>
inline void LaunchRaw(GM_ADDR x, GM_ADDR b, GM_ADDR s, GM_ADDR g, GM_ADDR y, int M, int K, int N,
                      int E, int cores, aclrtStream stream)
{
    const int workers = std::min(cores, (M + RM - 1) / RM), AP = K;
    const size_t cBytes = size_t(workers) * 2 * MT * NT * 4;
    const size_t aBytes = FULLROWS ? size_t(M + MT - 1) * AP : (AP == K ? 0 : size_t(M) * AP);
    Workspace memory(cBytes + aBytes, stream);
    if (!memory.Data())
        return;
    RangeRaw<MT, NT, LK, RM, FULLROWS><<<workers, nullptr, stream>>>(
        x, b, s, g, y, memory.Data(), memory.Data() + cBytes, M, K, N, E, workers, AP);
    memory.Complete();
}

}

namespace vector_dot
{
using namespace AscendC;
__global__ __vector__ __attribute__((aligned(4096))) void Run(GM_ADDR x, GM_ADDR weight,
                                                              GM_ADDR scale, GM_ADDR groups,
                                                              GM_ADDR y, int M, int K, int E,
                                                              int workers)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    TPipe pipe;
    SetMaskNorm();
    SetVectorMask<uint8_t>(~uint64_t(0), ~uint64_t(0));
    GlobalTensor<int8_t> a, b;
    GlobalTensor<float> s;
    GlobalTensor<int64_t> g;
    GlobalTensor<half> out;
    a.SetGlobalBuffer((__gm__ int8_t *)x);
    b.SetGlobalBuffer((__gm__ int8_t *)weight);
    s.SetGlobalBuffer((__gm__ float *)scale);
    g.SetGlobalBuffer((__gm__ int64_t *)groups);
    out.SetGlobalBuffer((__gm__ half *)y);
    LocalTensor<int8_t> ua(TPosition::VECCALC, 0, 8192), ub(TPosition::VECCALC, 8192, 8192);
    LocalTensor<half> h(TPosition::VECCALC, 16384, 8192);
    LocalTensor<float> fa(TPosition::VECCALC, 32768, 8192), fb(TPosition::VECCALC, 65536, 8192);
    LocalTensor<float> temporary(TPosition::VECCALC, 98304, 8), us(TPosition::VECCALC, 98400, 8);
    LocalTensor<half> result(TPosition::VECCALC, 98368, 16);
    LocalTensor<int64_t> ends(TPosition::VECCALC, 192512, 128);
    DataCopyPad(ends, g, DataCopyExtParams(1, E * 8, 0, 0, 0),
                DataCopyPadExtParams<int64_t>{false, 0, 0, 0});
    SetFlag<HardEvent::MTE2_S>(EVENT_ID6);
    WaitFlag<HardEvent::MTE2_S>(EVENT_ID6);
    int padded = 64;
    while (padded < K)
        padded *= 2;
    for (int row = GetBlockIdx(); row < M; row += workers)
    {
        int lo = 0, hi = E - 1;
        while (lo < hi)
        {
            const int mid = (lo + hi) / 2;
            if (ends.GetValue(mid) <= row)
                lo = mid + 1;
            else
                hi = mid;
        }
        Duplicate(ua.ReinterpretCast<uint16_t>(), uint16_t(0), padded / 2);
        Duplicate(ub.ReinterpretCast<uint16_t>(), uint16_t(0), padded / 2);
        SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
        WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
        DataCopyPad(ua, a[int64_t(row) * K], DataCopyExtParams(1, K, 0, 0, 0),
                    DataCopyPadExtParams<int8_t>{true, 0, uint8_t((K + 31) / 32 * 32 - K), 0});
        DataCopyPad(ub, b[int64_t(lo) * K], DataCopyExtParams(1, K, 0, 0, 0),
                    DataCopyPadExtParams<int8_t>{true, 0, uint8_t((K + 31) / 32 * 32 - K), 0});
        DataCopyPad(us, s[lo], DataCopyExtParams(1, 4, 0, 0, 0),
                    DataCopyPadExtParams<float>{false, 0, 0, 0});
        SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
        WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
        Cast(h, ua, RoundMode::CAST_NONE, padded);
        PipeBarrier<PIPE_V>();
        Cast(fa, h, RoundMode::CAST_NONE, padded);
        PipeBarrier<PIPE_V>();
        Cast(h, ub, RoundMode::CAST_NONE, padded);
        PipeBarrier<PIPE_V>();
        Cast(fb, h, RoundMode::CAST_NONE, padded);
        PipeBarrier<PIPE_V>();
        // Every INT8 product is an exactly representable FP32 integer.
        Mul(fa, fa, fb, padded);
        PipeBarrier<PIPE_V>();
        auto sums = fa.ReinterpretCast<int32_t>();
        Cast(sums, fa, RoundMode::CAST_RINT, padded);
        PipeBarrier<PIPE_V>();
        for (int span = padded; span > 8; span /= 2)
        {
            Add(sums, sums, sums[span / 2], span / 2);
            PipeBarrier<PIPE_V>();
        }
        SetFlag<HardEvent::V_S>(EVENT_ID0);
        WaitFlag<HardEvent::V_S>(EVENT_ID0);
        int32_t dot = 0;
        for (int i = 0; i < 8; ++i)
            dot += sums.GetValue(i);
        fa.SetValue(0, float(dot));
        SetFlag<HardEvent::S_V>(EVENT_ID0);
        WaitFlag<HardEvent::S_V>(EVENT_ID0);
        Mul(fa, fa, us, 1);
        PipeBarrier<PIPE_V>();
        grouped_gelu::Gelu(fa, temporary, result, 1);
        SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
        WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
        DataCopyPad(out[row], result, DataCopyExtParams(1, 2, 0, 0, 0));
        SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
        WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
        SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
        WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
    }
}
inline void Launch(GM_ADDR x, GM_ADDR b, GM_ADDR s, GM_ADDR g, GM_ADDR y, int M, int K, int E,
                   int cores, aclrtStream stream)
{
    const int workers = std::min(cores * 2, M);
    Run<<<workers, nullptr, stream>>>(x, b, s, g, y, M, K, E, workers);
}
}

namespace outer_table_gm
{
using namespace AscendC;
using grouped_gelu::Min;
using grouped_gelu::Workspace;
constexpr int ROWS = 16, COLS = 512, SIZE = ROWS * COLS;

__global__ __vector__ __attribute__((aligned(4096))) void Run(GM_ADDR x, GM_ADDR weight,
                                                              GM_ADDR scale, GM_ADDR groups,
                                                              GM_ADDR y, GM_ADDR workspace, int M,
                                                              int N, int E, int NP, int workers)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    TPipe pipe;
    SetMaskNorm();
    SetVectorMask<uint8_t>(~uint64_t(0), ~uint64_t(0));
    GlobalTensor<int8_t> a, b;
    GlobalTensor<float> s;
    GlobalTensor<int64_t> g;
    GlobalTensor<half> out, table;
    a.SetGlobalBuffer((__gm__ int8_t *)x);
    b.SetGlobalBuffer((__gm__ int8_t *)weight);
    s.SetGlobalBuffer((__gm__ float *)scale);
    g.SetGlobalBuffer((__gm__ int64_t *)groups);
    out.SetGlobalBuffer((__gm__ half *)y);
    table.SetGlobalBuffer((__gm__ half *)workspace);
    LocalTensor<int32_t> products(TPosition::VECCALC, 0, SIZE);
    auto z = products.ReinterpretCast<float>();
    LocalTensor<float> temporary(TPosition::VECCALC, SIZE * 4, SIZE);
    LocalTensor<half> result(TPosition::VECCALC, SIZE * 8, SIZE);
    LocalTensor<int32_t> wb(TPosition::VECCALC, SIZE * 10, COLS);
    LocalTensor<float> scales(TPosition::VECCALC, SIZE * 10 + COLS * 4, COLS);
    LocalTensor<int8_t> raw(TPosition::VECCALC, SIZE * 10 + COLS * 8, COLS);
    LocalTensor<half> wh(TPosition::VECCALC, SIZE * 10 + COLS * 9, COLS);
    LocalTensor<int64_t> ends(TPosition::VECCALC, 192512, 128);
    DataCopyPad(ends, g, DataCopyExtParams(1, E * 8, 0, 0, 0),
                DataCopyPadExtParams<int64_t>{false, 0, 0, 0});
    SetFlag<HardEvent::MTE2_S>(EVENT_ID6);
    WaitFlag<HardEvent::MTE2_S>(EVENT_ID6);
    const int columns = (N + COLS - 1) / COLS;
    for (int task = GetBlockIdx(); task < E * 256 / ROWS * columns; task += workers)
    {
        const int expert = task / (256 / ROWS * columns);
        const int first = expert ? int(ends.GetValue(expert - 1)) : 0;
        if (int(ends.GetValue(expert)) == first)
            continue;
        const int value = task / columns % (256 / ROWS) * ROWS;
        const int col = task % columns * COLS, cols = Min(COLS, N - col);
        const int pitch = (cols + 31) / 32 * 32;
        Duplicate(scales, 0.0f, COLS);
        Duplicate(raw.ReinterpretCast<uint16_t>(), uint16_t(0), COLS / 2);
        SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
        WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
        DataCopyPad(raw, b[int64_t(expert) * N + col], DataCopyExtParams(1, cols, 0, 0, 0),
                    DataCopyPadExtParams<int8_t>{false, 0, 0, 0});
        DataCopyPad(scales, s[int64_t(expert) * N + col], DataCopyExtParams(1, cols * 4, 0, 0, 0),
                    DataCopyPadExtParams<float>{false, 0, 0, 0.0f});
        SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
        WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
        Cast(wh, raw, RoundMode::CAST_NONE, pitch);
        PipeBarrier<PIPE_V>();
        Cast(wb, wh, RoundMode::CAST_RINT, pitch);
        PipeBarrier<PIPE_V>();
        for (int row = 0; row < ROWS; ++row)
            Muls(products[row * pitch], wb, int32_t(value + row - 128), pitch);
        PipeBarrier<PIPE_V>();
        Cast(z, products, RoundMode::CAST_RINT, ROWS * pitch);
        PipeBarrier<PIPE_V>();
        for (int col = 0; col < pitch; col += 64)
            Mul(z[col], z[col], scales[col], uint64_t(64), ROWS,
                {1, 1, 1, uint8_t(pitch / 8), uint8_t(pitch / 8), 0});
        PipeBarrier<PIPE_V>();
        grouped_gelu::Gelu(z, temporary, result, ROWS * pitch);
        SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
        WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
        DataCopyPad(table[(int64_t(expert) * 256 + value) * NP + col], result,
                    DataCopyExtParams(ROWS, pitch * 2, 0, (NP - pitch) * 2, 0));
        SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
        WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
    }
    CrossCoreSetFlag<0, PIPE_MTE3>(10);
    CrossCoreWaitFlag(10);
    LocalTensor<int8_t> xa(TPosition::VECCALC, 180224, 128);
    LocalTensor<half> rows(TPosition::VECCALC, 0, NP * 2);
    const int begin = int(int64_t(M) * GetBlockIdx() / workers);
    const int limit = int(int64_t(M) * (GetBlockIdx() + 1) / workers);
    int expert = 0, sequence = 0;
    while (expert + 1 < E && int(ends.GetValue(expert)) <= begin)
        ++expert;
    SetFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);
    SetFlag<HardEvent::MTE3_MTE2>(EVENT_ID1);
    for (int first = begin; first < limit; first += 128)
    {
        const int count = Min(128, limit - first);
        SetFlag<HardEvent::S_MTE2>(EVENT_ID6);
        WaitFlag<HardEvent::S_MTE2>(EVENT_ID6);
        DataCopyPad(xa, a[first], DataCopyExtParams(1, count, 0, 0, 0),
                    DataCopyPadExtParams<int8_t>{false, 0, 0, 0});
        SetFlag<HardEvent::MTE2_S>(EVENT_ID6);
        WaitFlag<HardEvent::MTE2_S>(EVENT_ID6);
        for (int row = 0; row < count; ++row)
        {
            const int position = first + row;
            while (int(ends.GetValue(expert)) <= position)
                ++expert;
            const int value = int(xa.GetValue(row)) + 128, slot = sequence++ & 1;
            const event_t event = slot ? EVENT_ID1 : EVENT_ID0;
            WaitFlag<HardEvent::MTE3_MTE2>(event);
            DataCopy(rows[slot * NP], table[(int64_t(expert) * 256 + value) * NP], NP);
            SetFlag<HardEvent::MTE2_MTE3>(event);
            WaitFlag<HardEvent::MTE2_MTE3>(event);
            DataCopyPad(out[int64_t(position) * N], rows[slot * NP],
                        DataCopyExtParams(1, N * 2, 0, 0, 0));
            SetFlag<HardEvent::MTE3_MTE2>(event);
        }
    }
    WaitFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);
    WaitFlag<HardEvent::MTE3_MTE2>(EVENT_ID1);
}

inline bool Launch(GM_ADDR x, GM_ADDR b, GM_ADDR s, GM_ADDR g, GM_ADDR y, int M, int N, int E,
                   int cores, aclrtStream stream)
{
    const int NP = (N + 31) / 32 * 32, workers = cores * 2;
    const size_t bytes = size_t(E) * 256 * NP * 2;
    if (bytes > (size_t(96) << 20))
        return false;
    Workspace memory(bytes, stream);
    if (!memory.Data())
        return false;
    Run<<<workers, nullptr, stream>>>(x, b, s, g, y, memory.Data(), M, N, E, NP, workers);
    memory.Complete();
    return true;
}
}

namespace single_depth
{
using namespace AscendC;
__global__ __vector__ __attribute__((aligned(4096))) void Run(GM_ADDR x, GM_ADDR weight,
                                                              GM_ADDR scale, GM_ADDR groups,
                                                              GM_ADDR y, int M, int N, int E,
                                                              int workers)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    TPipe pipe;
    SetMaskNorm();
    SetVectorMask<uint8_t>(~uint64_t(0), ~uint64_t(0));
    GlobalTensor<int8_t> a, b;
    GlobalTensor<float> s;
    GlobalTensor<int64_t> g;
    GlobalTensor<half> result;
    a.SetGlobalBuffer((__gm__ int8_t *)x);
    b.SetGlobalBuffer((__gm__ int8_t *)weight);
    s.SetGlobalBuffer((__gm__ float *)scale);
    g.SetGlobalBuffer((__gm__ int64_t *)groups);
    result.SetGlobalBuffer((__gm__ half *)y);
    LocalTensor<float> w(TPosition::VECCALC, 0, 4096);
    LocalTensor<float> scales(TPosition::VECCALC, 16640, 4096);
    LocalTensor<float> z(TPosition::VECCALC, 33280, 8192);
    LocalTensor<float> temporary(TPosition::VECCALC, 66304, 8192);
    LocalTensor<half> out(TPosition::VECCALC, 99328, 8192);
    LocalTensor<int8_t> rawWeight(TPosition::VECCALC, 115968, 4096);
    LocalTensor<half> halfWeight(TPosition::VECCALC, 120320, 4096);
    LocalTensor<int8_t> rows(TPosition::VECCALC, 128768, 65536);
    LocalTensor<int64_t> ends(TPosition::VECCALC, 194304, 128);
    const int NP = (N + 31) / 32 * 32;
    Duplicate(scales, 0.0f, 4096);
    SetFlag<HardEvent::V_MTE2>(EVENT_ID1);
    DataCopyPad(rows, a, DataCopyExtParams(1, M, 0, 0, 0),
                DataCopyPadExtParams<int8_t>{false, 0, 0, 0});
    DataCopyPad(ends, g, DataCopyExtParams(1, E * 8, 0, 0, 0),
                DataCopyPadExtParams<int64_t>{false, 0, 0, 0});
    SetFlag<HardEvent::MTE2_S>(EVENT_ID6);
    WaitFlag<HardEvent::MTE2_S>(EVENT_ID6);
    SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
    const int segments = (M + 15) / 16;
    const int begin = grouped_gelu::Min(M, segments * GetBlockIdx() / workers * 16);
    const int limit = grouped_gelu::Min(M, segments * (GetBlockIdx() + 1) / workers * 16);
    int lo = 0, hi = E;
    while (lo < hi)
    {
        const int mid = (lo + hi) / 2;
        if (ends.GetValue(mid) <= begin)
            lo = mid + 1;
        else
            hi = mid;
    }
    for (int expert = lo; expert < E; ++expert)
    {
        const int first = expert ? int(ends.GetValue(expert - 1)) : 0;
        const int end = grouped_gelu::Min(limit, int(ends.GetValue(expert)));
        int row = first > begin ? first : begin;
        if (row >= limit)
            break;
        if (row >= end)
            continue;
        WaitFlag<HardEvent::V_MTE2>(EVENT_ID1);
        DataCopyPad(rawWeight, b[int64_t(expert) * N], DataCopyExtParams(1, N, 0, 0, 0),
                    DataCopyPadExtParams<int8_t>{true, 0, uint8_t(NP - N), 0});
        DataCopyPad(scales, s[int64_t(expert) * N], DataCopyExtParams(1, N * 4, 0, 0, 0),
                    DataCopyPadExtParams<float>{true, 0, uint8_t((N + 7) / 8 * 8 - N), 0.0f});
        SetFlag<HardEvent::MTE2_V>(EVENT_ID1);
        WaitFlag<HardEvent::MTE2_V>(EVENT_ID1);
        Cast(halfWeight, rawWeight, RoundMode::CAST_NONE, NP);
        PipeBarrier<PIPE_V>();
        Cast(w, halfWeight, RoundMode::CAST_NONE, NP);
        PipeBarrier<PIPE_V>();
        for (; row < end; row += 2)
        {
            const int count = grouped_gelu::Min(2, end - row);
            for (int i = 0; i < count; ++i)
                Muls(z[i * NP], w, float(rows.GetValue(row + i)), NP);
            PipeBarrier<PIPE_V>();
            auto integers = z.ReinterpretCast<int32_t>();
            Cast(integers, z, RoundMode::CAST_RINT, count * NP);
            PipeBarrier<PIPE_V>();
            Cast(z, integers, RoundMode::CAST_RINT, count * NP);
            PipeBarrier<PIPE_V>();
            for (int i = 0; i < count; ++i)
                Mul(z[i * NP], z[i * NP], scales, NP);
            PipeBarrier<PIPE_V>();
            WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
            grouped_gelu::Gelu(z, temporary, out, count * NP);
            SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
            WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
            DataCopyPad(result[int64_t(row) * N], out,
                        DataCopyExtParams(count, N * 2, (NP - (N + 15) / 16 * 16) / 16, 0, 0));
            SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
        }
        SetFlag<HardEvent::V_MTE2>(EVENT_ID1);
        if (end == limit)
            break;
    }
    WaitFlag<HardEvent::V_MTE2>(EVENT_ID1);
    WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
}
}

namespace wide_prepared
{
using namespace AscendC;
using grouped_gelu::Min;
using grouped_gelu::Workspace;

template <int MT, int NT, int LK, int ST>
__global__ __mix__(1, 2)
    __attribute__((aligned(4096))) void Run(GM_ADDR x, GM_ADDR weight, GM_ADDR scale,
                                            GM_ADDR groups, GM_ADDR y, GM_ADDR workspace,
                                            GM_ADDR packedA, GM_ADDR packedB, int M, int K, int N,
                                            int E, int workers, int AP, int KP, int NP)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
    SetAtomicNone();
    int core = GetBlockIdx();
    if ASCEND_IS_AIV
        core /= GetSubBlockNum();
    GlobalTensor<int8_t> a, b, pa, pb;
    GlobalTensor<float> s;
    GlobalTensor<int64_t> g;
    GlobalTensor<int32_t> buffer;
    GlobalTensor<half> out;
    a.SetGlobalBuffer((__gm__ int8_t *)x);
    b.SetGlobalBuffer((__gm__ int8_t *)weight);
    pa.SetGlobalBuffer((__gm__ int8_t *)packedA);
    pb.SetGlobalBuffer((__gm__ int8_t *)packedB);
    s.SetGlobalBuffer((__gm__ float *)scale);
    g.SetGlobalBuffer((__gm__ int64_t *)groups);
    buffer.SetGlobalBuffer((__gm__ int32_t *)workspace);
    out.SetGlobalBuffer((__gm__ half *)y);
    if ASCEND_IS_AIV
    {
        TPipe pipe;
        SetMaskNorm();
        SetVectorMask<uint8_t>(~uint64_t(0), ~uint64_t(0));
        LocalTensor<int64_t> ends(TPosition::VECCALC, 192512, 128);
        DataCopyPad(ends, g, DataCopyExtParams(1, E * 8, 0, 0, 0),
                    DataCopyPadExtParams<int64_t>{false, 0, 0, 0});
        SetFlag<HardEvent::MTE2_S>(EVENT_ID6);
        WaitFlag<HardEvent::MTE2_S>(EVENT_ID6);
        aggregate_lpt_prepare::PrepareVector(a, b, pa, pb, ends, M, K, N, E, AP, KP, NP, workers);
        CrossCoreSetFlag<0, PIPE_MTE3>(10);
        CrossCoreWaitFlag(10);
        CrossCoreSetFlag<2, PIPE_MTE3>(8);
    }
    if ASCEND_IS_AIC
    {
        aggregate_lpt_prepare::PackB<32>(b, pb, g, K, N, E, KP, NP, workers);
        CrossCoreWaitFlag(8);
    }
    if (AP != K)
        a.SetGlobalBuffer((__gm__ int8_t *)packedA);
    const int columns = (N + NT - 1) / NT;
    if ASCEND_IS_AIC
    {
        grouped_gelu::Cube<MT, NT, false, LK, ST, true> cube;
        cube.Init();
        int base = 0, start = 0, next = core, sequence = 0;
        for (int expert = 0; expert < E; ++expert)
        {
            const int end = int(g.GetValue(expert)), length = end - start;
            const int jobs = (length + MT - 1) / MT * columns;
            while (next < base + jobs)
            {
                int row, col;
                grouped_gelu::Coordinates<MT, NT>(next - base, length, columns, row, col);
                const int slot = sequence++ & 1;
                cube.Compute(a[int64_t(start + row) * AP],
                             pb[int64_t(expert) * KP * NP + int64_t(col / 32) * KP * 32],
                             buffer[int64_t(core * 2 + slot) * MT * NT], Min(MT, length - row),
                             Min(NT, N - col), AP, NP, 0, K, slot, KP);
                next += workers;
            }
            base += jobs;
            start = end;
        }
        cube.Finish();
    }
    if ASCEND_IS_AIV
    {
        TPipe pipe;
        SetMaskNorm();
        SetVectorMask<uint8_t>(~uint64_t(0), ~uint64_t(0));
        grouped_gelu::Epilogue<MT, NT> epilogue;
        CrossCoreSetFlag<2, PIPE_MTE2>(2);
        CrossCoreSetFlag<2, PIPE_MTE2>(3);
        int base = 0, start = 0, next = core, sequence = 0;
        for (int expert = 0; expert < E; ++expert)
        {
            const int end = int(g.GetValue(expert)), length = end - start;
            const int jobs = (length + MT - 1) / MT * columns;
            while (next < base + jobs)
            {
                int row, col;
                grouped_gelu::Coordinates<MT, NT>(next - base, length, columns, row, col);
                const int slot = sequence++ & 1;
                CrossCoreWaitFlag(slot);
                epilogue.Run(buffer[int64_t(core * 2 + slot) * MT * NT], s, out, start + row, col,
                             Min(MT, length - row), Min(NT, N - col), N, expert, 1, slot);
                next += workers;
            }
            base += jobs;
            start = end;
        }
    }
}

template <int MT, int NT, int LK, int ST>
inline bool Launch(GM_ADDR x, GM_ADDR b, GM_ADDR s, GM_ADDR g, GM_ADDR y, int M, int K, int N,
                   int E, int cores, aclrtStream stream)
{
    const int AP = (K + 31) / 32 * 32, KP = AP, NP = (N + 31) / 32 * 32;
    const int tiles = ((M + MT - 1) / MT + E - 1) * ((N + NT - 1) / NT);
    const int workers = std::min(cores, tiles);
    const size_t cBytes = size_t(workers) * 2 * MT * NT * 4;
    const size_t aBytes = AP == K ? 0 : size_t(M) * AP, bBytes = size_t(E) * KP * NP;
    if (aBytes + bBytes > (size_t(384) << 20) || 4 * 32 * NP > 524288)
        return false;
    Workspace memory(cBytes + aBytes + bBytes, stream);
    if (!memory.Data())
        return false;
    Run<MT, NT, LK, ST><<<workers, nullptr, stream>>>(
        x, b, s, g, y, memory.Data(), memory.Data() + cBytes, memory.Data() + cBytes + aBytes, M, K,
        N, E, workers, AP, KP, NP);
    memory.Complete();
    return true;
}
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo &info_x, GM_ADDR weight,
                           const TensorGroupInfo &info_weight, GM_ADDR scale,
                           const TensorGroupInfo &info_scale, GM_ADDR groups,
                           const TensorGroupInfo &info_groups, GM_ADDR y,
                           const TensorGroupInfo &info_y, int64_t availableCoreNum,
                           aclrtStream stream)
{
    if (info_x.numTensors != 1 || info_weight.numTensors != 1 || info_scale.numTensors != 1 ||
        info_groups.numTensors != 1 || info_y.numTensors != 1)
        return;
    const auto &a = info_x.tensors[0];
    const auto &b = info_weight.tensors[0];
    const auto &s = info_scale.tensors[0];
    const auto &g = info_groups.tensors[0];
    const auto &o = info_y.tensors[0];
    if (a.numDims != 2 || b.numDims != 3 || s.numDims != 2 || g.numDims != 1 || o.numDims != 2 ||
        a.dtype != 3 || b.dtype != 3 || s.dtype != 0 || g.dtype != 6 || o.dtype != 1)
        return;
    const int64_t M = a.shape[0], K = a.shape[1], N = b.shape[2], E = b.shape[0];
    if (M < 1 || M > 65536 || K < 1 || K > 8192 || N < 1 || N > 4096 || E < 1 || E > 128 ||
        b.shape[1] != K || s.shape[0] != E || s.shape[1] != N || g.shape[0] != E ||
        o.shape[0] != M || o.shape[1] != N || availableCoreNum < 1 ||
        E * K * N > (int64_t(256) << 20) ||
        M * K + E * K * N + 4 * E * N + 8 * E + 2 * M * N > (int64_t(512) << 20))
        return;
    const int cores = std::min<int64_t>(20, availableCoreNum);
    const int vectorCores = cores * 2;
    using namespace grouped_gelu;

    if (M * K * N == 1 && E <= vectorCores)
    {
        product::Product<<<E, nullptr, stream>>>(x, weight, scale, groups, y, E, E);
        return;
    }
    if (M <= 32 && M <= vectorCores && K <= 4 && N <= 8 && E <= 8 && M * K <= 64 &&
        E * K * N <= 64 && E * N <= 16)
    {
        preloaded_small::Launch(x, weight, scale, groups, y, M, K, N, E,
                                std::min<int64_t>(vectorCores, M), stream);
        return;
    }
    if (M <= 32 && K <= 32 && N <= 16)
    {
        const int workers = std::min<int64_t>(vectorCores, M);
        if (K * N <= 128)
            Small<true>
                <<<workers, nullptr, stream>>>(x, weight, scale, groups, y, M, K, N, E, workers);
        else
            Small<false>
                <<<workers, nullptr, stream>>>(x, weight, scale, groups, y, M, K, N, E, workers);
        return;
    }
    if (((M + 15) / 16) * ((N + 127) / 128) <= cores / 2 &&
        short_dense::Launch<16, 128, 128, true, true, false, 0, true, false>(
            x, weight, scale, y, M, K, N, E, cores, stream))
        return;
    if (short_dense::Launch<32, 128, 128, true, true, false, 0, true, false>(
            x, weight, scale, y, M, K, N, E, cores, stream))
        return;

    const bool aligned = K % 32 == 0 && N % 32 == 0;
    const bool l0Reuse =
        aligned && K >= 96 && K <= 256 && N >= 512 && M >= cores * 32 && M >= E * 16;
    const bool shallowCache = !l0Reuse && (!aligned || M >= 256 * E) && K >= 64 && K <= 544 &&
                              N > 256 && N <= 1024 && M >= 256 && M >= 128 * E && M >= 64 * cores;
    if (shallowCache)
    {
        shallow_wide::Launch(x, weight, scale, groups, y, M, K, N, E, cores, stream);
        return;
    }
    if (aligned && E <= cores && M == E * 64 && K >= 1024 && K <= 2048 && K % 512 == 0 &&
        N >= 512 && N <= 1024 && N % 512 == 0)
    {
        resident_wide_prefetch::Launch<64, 512, 3, 256>(x, weight, scale, groups, y, K, N, E,
                                                        int(E), stream);
        return;
    }
    if (aligned && E <= cores && M >= E * 64 && M <= E * 256 && K >= 544 && K <= 1024 && N >= 256)
    {
        resident_packed_prefetch::Launch<128, 256, 3, 512>(x, weight, scale, groups, y, K, N, E,
                                                           cores, stream);
        return;
    }
    if (aligned && E <= cores && M >= E * 64 && M <= E * 256 && K > 1024 && K <= 2048 && N >= 512 &&
        N <= 1024 && N % 256 == 0)
    {
        resident_scaled::Launch<128, 256, 3, 256>(x, weight, scale, groups, y, K, N, E, cores,
                                                  stream);
        return;
    }
    if (aligned && E >= cores && M == E * 64 && K <= 256 && N >= 128 && N <= 256 && N % 64 == 0)
    {
        streaming_padded::Launch<64, 256, 3, 256>(x, weight, scale, groups, y, K, N, E, cores,
                                                  stream);
        return;
    }
    if (aligned && !l0Reuse && M == E * 64 && K >= 256 && K <= 2048 && K % 256 == 0 && N >= 256 &&
        N % 256 == 0)
    {
        if (K <= 512)
            aligned_padded::LaunchUniform(x, weight, scale, groups, y, K, N, E, cores, stream);
        else
            aligned_compact::LaunchUniform(x, weight, scale, groups, y, K, N, E, cores, stream);
        return;
    }
    const int64_t KP = (K + 31) / 32 * 32, NP = (N + 31) / 32 * 32;
    const int64_t deepJobs = ((M + 127) / 128 + E - 1) * ((N + 127) / 128);
    if (K >= 2048 && N >= 128 && N <= 1024 && M <= 128 * cores &&
        E * KP * NP < (int64_t(64) << 20) && deepJobs * 2 <= 512 && 2 * 256 * NP <= 524032)
    {
        if (scheduled::LaunchAdaptive<128, 128, 512, true, 2, 256>(x, weight, scale, groups, y, M,
                                                                   K, N, E, cores, stream))
            return;
    }
    const bool aggregate = !aligned && M >= cores * 64 && M >= 32 * E && M <= 256 * E && K > 1024 &&
                           K <= 1152 && N >= 512 && N <= 1024 && E * KP * NP <= (int64_t(96) << 20);
    if (aggregate && M < 128 * E)
    {
        if (aggregate_lpt::Launch<64, 128, 256, 1152, 1024, 64, 0>(x, weight, scale, groups, y, M,
                                                                   K, N, E, cores, stream))
            return;
    }
    if (!aligned && (N + 255) / 256 >= 5 &&
        balanced_full_a::Launch(x, weight, scale, groups, y, M, K, N, E, cores, stream))
        return;
    if (!aligned && full_a_prepare::Launch(x, weight, scale, groups, y, M, K, N, E, cores, stream))
        return;

    if (N == 1 && K >= 64 && M <= cores * 2 * 16)
    {
        vector_dot::Launch(x, weight, scale, groups, y, M, K, E, cores, stream);
        return;
    }

    if (K <= 16 && N <= 64 && M >= 256 && M >= E * 32)
    {
        shallow_vector::Launch(x, weight, scale, groups, y, M, K, N, E, cores, stream);
        return;
    }
    if (N > 64 && N <= 256 && N % 32 && (K % 32 || N <= 128) && M >= cores * 128 && M >= E * 128)
    {
        bool launched;
        if (N <= 32)
            launched = padded_rows::Launch<512, 32>(x, weight, scale, groups, y, M, K, N, E, cores,
                                                    stream);
        else if (N <= 64)
            launched = padded_rows::Launch<512, 64>(x, weight, scale, groups, y, M, K, N, E, cores,
                                                    stream);
        else if (N <= 128)
            launched = padded_rows::Launch<256, 128>(x, weight, scale, groups, y, M, K, N, E, cores,
                                                     stream);
        else
            launched = padded_rows::Launch<128, 256>(x, weight, scale, groups, y, M, K, N, E, cores,
                                                     stream);
        if (launched)
            return;
    }
    if (N <= 31 && K >= 2048 && M >= cores * 128)
    {
        if (padded_narrow::LaunchRaw<128, 32, 1024, 4, false>(x, weight, scale, groups, y, M, K, N,
                                                              E, cores, stream))
            return;
    }
    if (M >= 1 && (K >= 128 || (K >= 64 && E >= cores)) && N >= 1 && N <= 31)
    {
        if (padded_narrow::LaunchRaw<128, 32, 512, 4, false>(x, weight, scale, groups, y, M, K, N,
                                                             E, cores, stream))
            return;
    }
    if (M >= 64 && K >= 1024 && N == 32)
    {
        raw_range::LaunchRaw<128, 512, 4, false>(x, weight, scale, groups, y, M, K, E, cores,
                                                 stream);
        return;
    }
    if (M >= 64 && K >= 1024 && K % 32 == 0 && N > 32 && N <= 128 && N % 32 == 0)
    {
        if (N == 64)
            direct_range::LaunchRaw<128, 64, 768, 4, false>(x, weight, scale, groups, y, M, K, N, E,
                                                            cores, stream);
        else if (N == 96)
            direct_range::LaunchRaw<128, 96, 768, 4, false>(x, weight, scale, groups, y, M, K, N, E,
                                                            cores, stream);
        else
            direct_range::LaunchRaw<128, 128, 512, 4, false>(x, weight, scale, groups, y, M, K, N,
                                                             E, cores, stream);
        return;
    }
    if (M >= 64 && K >= 1024 && K % 32 == 0 && N > 128 && N <= 256 && N % 32 == 0)
    {
        if (N <= 160)
            direct_wide::LaunchRaw<64, 160, 512, 4, false>(x, weight, scale, groups, y, M, K, N, E,
                                                           cores, stream);
        else if (N <= 192)
            direct_wide::LaunchRaw<64, 192, 512, 4, false>(x, weight, scale, groups, y, M, K, N, E,
                                                           cores, stream);
        else if (N <= 224)
            direct_wide::LaunchRaw<64, 224, 512, 4, false>(x, weight, scale, groups, y, M, K, N, E,
                                                           cores, stream);
        else
            direct_wide::LaunchRaw<64, 256, 512, 4, false>(x, weight, scale, groups, y, M, K, N, E,
                                                           cores, stream);
        return;
    }
    if (M >= 64 && K >= 1024 && N <= 128)
    {
        if (N <= 32)
        {
            if (generalized_prepared::Launch<128, 32, 1024, 3, 128, 1>(x, weight, scale, groups, y,
                                                                       M, K, N, E, cores, stream))
                return;
        }
        else if (N <= 64)
        {
            if (generalized_prepared::Launch<128, 64, 768, 3, 128, 1>(x, weight, scale, groups, y,
                                                                      M, K, N, E, cores, stream))
                return;
        }
        else
        {
            if (generalized_prepared::Launch<128, 128, 512, 3, 128, 1>(x, weight, scale, groups, y,
                                                                       M, K, N, E, cores, stream))
                return;
        }
    }
    if (M >= 64 && K >= 2048 && N > 128 && N <= 1024 && K % 32 == 0 && N % 32 == 0)
    {
        if (generalized_prepared::Launch<128, 256, 256, 3, 128, 1>(x, weight, scale, groups, y, M,
                                                                   K, N, E, cores, stream))
            return;
    }
    if (((M + 15) / 16) * ((N + 127) / 128) <= cores / 2)
    {
        if (short_dense::Launch<16, 128, 128, true, true, false, 0, true, false>(
                x, weight, scale, y, M, K, N, E, cores, stream))
            return;
    }
    if (short_dense::Launch<32, 128, 128, true, true, false, 0, true, false>(
            x, weight, scale, y, M, K, N, E, cores, stream))
        return;
    if (E >= cores && M <= 256 && M <= E * 8 && K >= 256 && K <= 2048 && N >= 64 && N <= 256)
    {
        bool launched;
        if (N <= 128)
            launched = generalized_prepared::Launch<16, 128, 512, 3, 64, 1, true>(
                x, weight, scale, groups, y, M, K, N, E, cores, stream);
        else
            launched = generalized_prepared::Launch<16, 256, 512, 3, 64, 1, true>(
                x, weight, scale, groups, y, M, K, N, E, cores, stream);
        if (launched)
            return;
    }
    if (E >= cores && M <= 256 && M <= E * 8 && K <= 256 && N <= 256)
    {
        if (N <= 128)
            balanced_rows::Launch<16, 128, 256, 3, 1, false>(x, weight, scale, groups, y, M, K, N,
                                                             E, cores, stream);
        else
            balanced_rows::Launch<16, 256, 256, 3, 1, false>(x, weight, scale, groups, y, M, K, N,
                                                             E, cores, stream);
        return;
    }
    if (N <= 256 && (N > 64 || (N <= 32 && K < 256 && K % 32 == 0)) && M >= cores * 128 &&
        M >= E * 128)
    {
        if (N <= 32)
            balanced_rows::Launch<512, 32>(x, weight, scale, groups, y, M, K, N, E, cores, stream);
        else if (N <= 64)
            balanced_rows::Launch<512, 64>(x, weight, scale, groups, y, M, K, N, E, cores, stream);
        else if (N <= 128)
            balanced_rows::Launch<256, 128>(x, weight, scale, groups, y, M, K, N, E, cores, stream);
        else if (N <= 192)
            balanced_rows::Launch<160, 192>(x, weight, scale, groups, y, M, K, N, E, cores, stream);
        else
            balanced_rows::Launch<128, 256>(x, weight, scale, groups, y, M, K, N, E, cores, stream);
        return;
    }
    if (K >= 96 && K <= 256 && K % 32 == 0 && N >= 512 && N % 32 == 0 && M >= cores * 32 &&
        M >= E * 16)
    {
        if (K <= 128)
            short_l0_resident::Launch<128, 256, 128, true>(x, weight, scale, groups, y, M, K, N, E,
                                                           cores, stream);
        else
            short_l0_resident::Launch<128, 256, 256, true>(x, weight, scale, groups, y, M, K, N, E,
                                                           cores, stream);
        return;
    }
    if (K >= 64 && K <= 544 && N > 256 && N <= 1024 && M >= 256 && M >= 128 * E &&
        M >= 64 * cores && ((K % 32 || N % 32) || M >= 256 * E))
    {
        shallow_wide::Launch(x, weight, scale, groups, y, M, K, N, E, cores, stream);
        return;
    }
    if (M >= cores * 64 && M >= E * 96 && K >= 64 && K <= 256 && K % 32 == 0 && N >= 512 &&
        N % 256 == 0)
    {
        generalized_resident::Launch<128, 256, 256>(x, weight, scale, groups, y, M, K, N, E, cores,
                                                    stream);
        return;
    }
    if (M >= cores * 64 && K <= 256 && K % 32 == 0 && N >= 256 && N % 256 == 0)
    {
        generalized_stream::Launch(x, weight, scale, groups, y, M, K, N, E, cores, stream);
        return;
    }
    if ((E <= cores && M >= E * 32 && M <= E * 256 && K >= 512 && K <= 2048 && K % 32 == 0 &&
         N >= 256 && N % 256 == 0) ||
        (M >= E * 96 && M <= E * 256 && K >= 256 && K <= 2048 && K % 128 == 0 && N >= 256 &&
         N <= 2048 && N % 128 == 0) ||
        (M > E * 256 && K >= 256 && K <= 768 && K % 32 == 0 && N >= 256 && N <= 2048 &&
         N % 32 == 0))
    {
        if (M < E * 96 && N >= 512 && K >= 1024)
            generalized_resident::Launch<64, 512, 256>(x, weight, scale, groups, y, M, K, N, E,
                                                       cores, stream);
        else
            generalized_resident::Launch<128, 256, 256>(x, weight, scale, groups, y, M, K, N, E,
                                                        cores, stream);
        return;
    }
    if (M >= cores * 64 && M >= 32 * E && M <= 256 * E && K > 1024 && K <= 1152 && N >= 512 &&
        N <= 1024 && (K % 32 || N % 32))
    {
        if (M < 128 * E)
        {
            if (aggregate_lpt::Launch<64, 128, 256, 1152, 1024, 64, 0>(x, weight, scale, groups, y,
                                                                       M, K, N, E, cores, stream))
                return;
        }
        if (ultra_aggregate::Launch<64, 128, 256, 1152, 1024, 64, 0>(x, weight, scale, groups, y, M,
                                                                     K, N, E, cores, stream))
            return;
    }
    if (K == 1 && N >= 256 && M >= E * 256)
    {
        if (outer_table_gm::Launch(x, weight, scale, groups, y, M, N, E, cores, stream))
            return;
    }

    if (K == 1 && N >= 64 && M >= 128 && M * N >= 65536)
    {
        const int workers = std::min<int64_t>(vectorCores, (M + 15) / 16);
        single_depth::Run<<<workers, nullptr, stream>>>(x, weight, scale, groups, y, M, N, E,
                                                        workers);
        return;
    }

    if (K >= 1536 && N >= 512 && M >= cores * 128 && (K % 32 || N % 32))
    {
        if (wide_prepared::Launch<128, 256, 512, 2>(x, weight, scale, groups, y, M, K, N, E, cores,
                                                    stream))
            return;
    }

    if (M >= 256 && N > 2048 && K <= 256)
    {
        if (generalized_prepared::Launch<128, 256, 256, 3, 32, 1, true>(x, weight, scale, groups, y,
                                                                        M, K, N, E, cores, stream))
            return;
    }
    if (M >= 64 && N >= 128 && N <= 2048 && K >= 64 && (K % 32 || N % 32 || K >= 2048))
    {
        if (K >= 2048 && M <= cores * 128 && N <= 1024)
        {
            if (generalized_prepared::Launch<128, 128, 512, 3, 128, 2>(x, weight, scale, groups, y,
                                                                       M, K, N, E, cores, stream))
                return;
        }
        else if (K >= 2048 && N <= 1024)
        {
            if (generalized_prepared::Launch<128, 128, 512, 3, 128>(x, weight, scale, groups, y, M,
                                                                    K, N, E, cores, stream))
                return;
        }
        else if (K >= 2048)
        {
            if (generalized_prepared::Launch<64, 256, 256, 3, 32>(x, weight, scale, groups, y, M, K,
                                                                  N, E, cores, stream))
                return;
        }
        else if (K <= 544)
        {
            if (generalized_prepared::Launch<64, 256, 544, 3, 64>(x, weight, scale, groups, y, M, K,
                                                                  N, E, cores, stream))
                return;
        }
        else if (M >= E * 256 && K <= 2048)
        {
            if (generalized_prepared::Launch<128, 256, 256, 3, 64>(x, weight, scale, groups, y, M,
                                                                   K, N, E, cores, stream))
                return;
        }
        else if (K <= 2048 && N > 1024)
        {
            if (generalized_prepared::Launch<64, 256, 544, 3, 32>(x, weight, scale, groups, y, M, K,
                                                                  N, E, cores, stream))
                return;
        }
        else if (K <= 2048)
        {
            if (generalized_prepared::Launch<64, 256, 768, 2, 64>(x, weight, scale, groups, y, M, K,
                                                                  N, E, cores, stream))
                return;
        }
    }
    if (M >= E * 32 && K >= 1024 && N >= 128 && (M < 256 || N < 256))
    {
        Launch<64, 128>(x, weight, scale, groups, y, M, K, N, E, cores, stream);
        return;
    }
    if (N <= 64 && M >= 512 && M >= E * 128)
    {
        if (N <= 32)
            Launch<512, 32>(x, weight, scale, groups, y, M, K, N, E, cores, stream);
        else
            Launch<512, 64>(x, weight, scale, groups, y, M, K, N, E, cores, stream);
    }
    else if (N >= 512 && M <= E * 32)
    {
        if (M >= E * 16)
            Launch<32, 256>(x, weight, scale, groups, y, M, K, N, E, cores, stream);
        else
            Launch<16, 256>(x, weight, scale, groups, y, M, K, N, E, cores, stream);
    }
    else if (M >= 256 && N >= 256)
    {
        if (M < E * 128)
            Launch<64, 256>(x, weight, scale, groups, y, M, K, N, E, cores, stream);
        else
            Launch<128, 256>(x, weight, scale, groups, y, M, K, N, E, cores, stream);
    }
    else if (M <= 128 && N <= 128 && K <= 256)
    {
        Launch<32, 128>(x, weight, scale, groups, y, M, K, N, E, cores, stream);
    }
    else
    {
        Launch<16, 64>(x, weight, scale, groups, y, M, K, N, E, cores, stream);
    }
}
