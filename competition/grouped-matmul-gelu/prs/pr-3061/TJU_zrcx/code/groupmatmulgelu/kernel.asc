#include "kernel_operator.h"
#include "c_api/asc_simd.h"
#include "acl/acl.h"
#include <cstdint>

namespace independent_gmg {
using namespace AscendC;
constexpr IsResetLoad3dConfig A_LOAD_CONFIG={false,false};
enum Route : uint32_t {
    Scalar, Tiny, Compact, LongReduction, TailStrip, PersistentExpert,
    ShortGroupWave, WideTail, TailPanel, ShallowResident, PanelStriped,
    WideDouble, Interleaved, ColumnResident, RowResident, Streamed
};
struct ExecutionShape {
    uint32_t rows, depth, cols, experts, cores;
    uint32_t route, tm, tn, ck, ring, resident, uniformRows, rowExperts, rowMapValid, tailStripe;
    uint32_t heavyExpert,heavyCores;
};
struct LaunchDescriptor {uint64_t extentBits,scheduleBits;uint32_t equalGroupRows;};
static_assert(sizeof(LaunchDescriptor)==24);
struct SmallInvocation {uint32_t rows;uint16_t depth,cols;uint32_t groups;uint16_t workers,flags;};
static_assert(sizeof(SmallInvocation)==16);


__aicore__ inline uint32_t Up(uint32_t x, uint32_t a) { return (x+a-1)/a*a; }
__aicore__ inline uint32_t Min(uint32_t a, uint32_t b) { return a < b ? a : b; }
template<HardEvent E> __aicore__ inline void Fence(uint32_t id=0) {
    SetFlag<E>(id); WaitFlag<E>(id);
}
struct WorkChunk { uint32_t expert, row, col, rows, cols; };

template<uint32_t Mode>
class CubeExecutor {
    ExecutionShape p;
    GlobalTensor<int8_t> x,w,originalWeights;
    TBuf<TPosition::A1> l1;
    TQue<TPosition::A2,2> l0a;
    TQue<TPosition::B2,2> l0b;
    TBuf<TPosition::CO1> l0c;
    LocalTensor<int8_t> a1,b1,a0,b0;
    LocalTensor<int32_t> c0;
    uint32_t aBytes,bBytes,apitch,bpitch,bSlots,bFactor,kPhase=0,featureRows=0,aFirst=0,aLast=0,aOffsets[2],aSliceFirst=0;
    bool keepA,keepB,validA=false,validB=false,fullB=false,twoA=false;uint64_t savedMatrixCtrl=0;bool tileUnits=false;
    static constexpr bool packed=Mode==LongReduction;
    static constexpr bool units=Mode==PersistentExpert || Mode==TailPanel || Mode==LongReduction;
    uint32_t packedSequence=0,packedRows=0,packedDepth=0;bool pendingResidentA=false,pendingScratch=false;WorkChunk residentA{},scratchTile{};uint32_t scratchBase=0;
    bool panelPack=false,pendingB=false,pendingShallow=false;uint32_t shallowSlot=0;WorkChunk pendingTile{};
    uint32_t rowStageOffset=0,headStageGroup=0xffffffffu;bool rowStageQueued=false,groupHeadQueued=false;WorkChunk rowStageTile{},groupHeadTile{};
    WorkChunk cachedA[2]{};bool aValid[2]={false,false};uint32_t aAge[2]={0,0},age=0;
    WorkChunk oldA{},oldB{},stagedPanel{};bool panelPrefixQueued=false;uint32_t panelPrefixChunks=0;
public:
    __aicore__ inline CubeExecutor(TPipe &pipe, ExecutionShape config, GM_ADDR xs, GM_ADDR ws, GM_ADDR workspace,uint32_t sliceFirst=0,uint32_t sliceEnd=0) : p(config) {
        x.SetGlobalBuffer((__gm__ int8_t*)xs); w.SetGlobalBuffer((__gm__ int8_t*)ws);originalWeights.SetGlobalBuffer((__gm__ int8_t*)ws);
        aSliceFirst=sliceFirst;uint32_t kp=Up(sliceEnd?sliceEnd-sliceFirst:p.depth,packed?64:32);
        if(packed) {
            uint64_t exchange=(uint64_t)p.cores*p.ring*p.tm*p.tn*4;
            if(p.resident==3 && !p.tailStripe)w.SetGlobalBuffer((__gm__ int8_t*)workspace+exchange);
            else{x.SetGlobalBuffer((__gm__ int8_t*)workspace+exchange);w.SetGlobalBuffer((__gm__ int8_t*)workspace+exchange+(uint64_t)Up(p.rows+31,64)*kp);}
        }
        bSlots=(Mode==PanelStriped || Mode==Interleaved)?4:
               ((Mode==WideDouble || Mode==RowResident || Mode==ColumnResident)?3:2);
        bFactor=(Mode==WideDouble || Mode==RowResident)?3:1;
        if(bFactor>1)bSlots=2;
        keepA=p.resident==1 && (uint64_t)p.tm*kp+bSlots*bFactor*p.tn*p.ck<=496*1024;
        keepB=p.resident==2 && (uint64_t)p.tn*kp+2*p.tm*p.ck<=496*1024;
        uint32_t fullWidth=Up(p.cols,32);
        if((Mode==TailStrip || (Mode==Streamed && (p.rowMapValid==1 || p.rowMapValid==5))) && (uint64_t)(fullWidth+p.tm)*kp<=496*1024) {
            fullB=true;keepB=true;keepA=true;
        }
        if(keepB && Mode!=WideTail && (uint64_t)(p.tn+p.tm)*kp<=496*1024)keepA=true;
        if(Mode==ShortGroupWave && (uint64_t)(p.tn+2*p.tm)*kp<=496*1024){keepA=true;twoA=true;}
        apitch=keepA?kp:p.ck; bpitch=keepB?kp:p.ck*bFactor;
        aBytes=Up(p.tm*apitch*(keepA?(twoA?2:1):2),512);
        bBytes=Up((fullB?fullWidth:p.tn)*bpitch*(keepB?1:bSlots),512);
        if(bFactor>1 && keepA && aBytes+bBytes+p.tn*bpitch<=496*1024)bBytes+=p.tn*bpitch;
        panelPack=(Mode==ShallowResident || Mode==PanelStriped) && p.depth%p.ck==0 && p.cols%p.tn==0 && p.ck%32==0 && p.tn*32<=16384;
        if(Mode==PersistentExpert && keepA && keepB && aBytes+bBytes+p.tn*p.ck<=496*1024){scratchBase=bBytes;bBytes+=p.tn*p.ck;}
        if constexpr(Mode==TailStrip){
            uint32_t rightSpan=Up(fullWidth*p.ck,512),leftSpan=Up(p.tm*kp,512);
            if(fullB && keepA && (uint64_t)aBytes+bBytes+rightSpan+leftSpan<=496*1024){scratchBase=bBytes;rowStageOffset=aBytes+bBytes+rightSpan;bBytes+=rightSpan+leftSpan;}
        }
        if(Mode==LongReduction){aBytes=5*p.tm*2*p.ck;bBytes=5*p.tn*2*p.ck;}
        uint32_t bBase=aBytes,l1Bytes=aBytes+bBytes;aOffsets[0]=0;aOffsets[1]=p.tm*apitch;
        if(twoA){
            uint32_t shiftedB=Up(p.tm*apitch,512)+128,secondA=Up(shiftedB+bBytes+512,512);
            if(secondA+Up(p.tm*apitch,512)<=496*1024){bBase=shiftedB;aOffsets[1]=secondA;l1Bytes=secondA+Up(p.tm*apitch,512);}
        }
        pipe.InitBuffer(l1,l1Bytes);
        if constexpr(Mode==Streamed)pipe.InitBuffer(l0a,p.tm*p.ck>32768?1:2,Up(p.tm*p.ck,512));
        else pipe.InitBuffer(l0a,2,Up(p.tm*p.ck,512));
        uint32_t rightBytes=Mode==LongReduction || Mode==ShortGroupWave || Mode==WideTail?32768:Min(32768,p.tn*p.ck);
        if(Mode==TailStrip)rightBytes=(p.tailStripe?p.tailStripe:Min(p.tn,(32768/p.ck)/32*32))*p.ck;
        if constexpr(Mode==Streamed){
            bool single=p.tm*p.ck>32768 && p.tn*p.ck>32768;
            pipe.InitBuffer(l0b,single?1:2,single?65536:Up(rightBytes,512));
        }else pipe.InitBuffer(l0b,Mode==ShallowResident?1:2,Mode==ShallowResident?65536:Up(rightBytes,512));
        pipe.InitBuffer(l0c,p.tm*p.tn*4);
        a1=l1.Get<int8_t>(); b1=a1[bBase];
        c0=l0c.Get<int32_t>();
        if(units || Mode==TailStrip){savedMatrixCtrl=get_ctrl();SetMMRowMajor();LocalTensor<uint64_t> reset(TPosition::C2PIPE2GM,0,1);SetFixPipeConfig(reset,true);PipeBarrier<PIPE_ALL>();}
        if constexpr(Mode!=WideDouble && Mode!=ColumnResident){SetLoadDataRepeat({0,1,0});SetLoadDataPaddingValue<int8_t>(0);}
    }
    __aicore__ inline void ReadA(const WorkChunk &t,uint32_t k,uint32_t count,uint32_t slot,uint32_t ma) {
        if(packed) {
            uint32_t mp=Up(p.rows+31,64);
            DataCopyParams d{};d.blockCount=Up(count,32)/32;d.blockLen=ma;d.srcStride=mp-ma;
            DataCopy(a1[slot*p.tm*p.ck],x[(uint64_t)k*mp+t.row*32],d);return;
        }
        Nd2NzParams d{}; d.ndNum=1; d.nValue=t.rows; d.dValue=count;
        d.srcDValue=p.depth; d.dstNzC0Stride=ma; d.dstNzNStride=1;
        DataCopy(a1[(keepA?aOffsets[slot]+(k-aSliceFirst)*ma:slot*p.tm*apitch)],x[(uint64_t)t.row*p.depth+k],d);
        if constexpr(Mode!=ShallowResident)SetFlag<HardEvent::MTE2_MTE1>(keepA?6:slot);
    }
    __aicore__ inline void ReadB(const WorkChunk &t,uint32_t k,uint32_t count,uint32_t slot,bool cold=false) {
        if(packed) {
            uint32_t kp=Up(p.depth,64),ka=Up(count,32);
            DataCopyParams d{};d.blockCount=Up(t.cols,32)/32;d.blockLen=ka;d.srcStride=kp-ka;d.dstStride=bpitch-ka;
            DataCopy(b1[slot*p.tn*bpitch],w[(uint64_t)t.expert*kp*Up(p.cols,32)+(uint64_t)t.col*kp+k*32],d);return;
        }
        if(cold){
            uint32_t first=Min(p.ck,count);Nd2NzParams h{};h.ndNum=1;h.nValue=first;h.dValue=t.cols;
            h.srcDValue=p.cols;h.dstNzC0Stride=bpitch;h.dstNzNStride=1;
            uint64_t source=((uint64_t)t.expert*p.depth+k)*p.cols+t.col;
            DataCopy(b1[slot*p.tn*bpitch],w[source],h);SetFlag<HardEvent::MTE2_MTE1>(5);
            h.nValue=count-first;
            DataCopy(b1[slot*p.tn*bpitch+first*32],w[source+(uint64_t)first*p.cols],h);
            SetFlag<HardEvent::MTE2_MTE1>(2+slot);return;
        }
        Nd2NzParams d{}; d.ndNum=1; d.nValue=count; d.dValue=fullB?p.cols:t.cols;
        d.srcDValue=p.cols; d.dstNzC0Stride=bpitch; d.dstNzNStride=1;
        if(panelPack){d.ndNum=count/32;d.nValue=32;d.srcNdMatrixStride=32*p.cols;d.dstNzC0Stride=32;d.dstNzMatrixStride=p.tn*32;}
        DataCopy(b1[slot*p.tn*bpitch],w[((uint64_t)t.expert*p.depth+k)*p.cols+(fullB?0:t.col)],d);
        if constexpr(Mode!=ShallowResident)SetFlag<HardEvent::MTE2_MTE1>(keepB?7:2+slot);
    }
    __aicore__ inline void PrimeGroupHead(const WorkChunk &target){
        Nd2NzParams transfer{};transfer.ndNum=1;transfer.nValue=target.rows;transfer.dValue=p.depth;transfer.srcDValue=p.depth;
        transfer.dstNzC0Stride=Up(target.rows,16);transfer.dstNzNStride=1;
        DataCopy(a1,x[(uint64_t)target.row*p.depth],transfer);
        SetFlag<HardEvent::MTE2_MTE1>(5);groupHeadTile=target;groupHeadQueued=true;
    }
    __aicore__ inline void PrefetchScratch(const WorkChunk &t){
        Nd2NzParams d{};d.ndNum=1;d.nValue=Min(p.ck,p.depth);d.dValue=fullB?p.cols:t.cols;d.srcDValue=p.cols;d.dstNzC0Stride=p.ck;d.dstNzNStride=1;
        DataCopy(b1[scratchBase],w[(uint64_t)t.expert*p.depth*p.cols+(fullB?0:t.col)],d);SetFlag<HardEvent::MTE2_MTE1>(4);scratchTile=t;pendingScratch=true;if constexpr(Mode==TailStrip)headStageGroup=0xffffffffu;
    }
    __aicore__ inline void FillResidentB(const WorkChunk &t,uint32_t k,uint32_t count,uint32_t slot) {
        Nd2NzParams d{};d.ndNum=1;d.nValue=count;d.dValue=fullB?p.cols:t.cols;
        d.srcDValue=p.cols;d.dstNzC0Stride=bpitch;d.dstNzNStride=1;
        DataCopy(b1[k*32],w[((uint64_t)t.expert*p.depth+k)*p.cols+(fullB?0:t.col)],d);
        SetFlag<HardEvent::MTE2_MTE1>(2+slot);
    }
    __aicore__ inline uint32_t KAt(uint32_t step,uint32_t chunks,uint32_t first) {
        return first+(Mode==LongReduction?chunks-1-step:(step+kPhase)%chunks)*p.ck;
    }
    __aicore__ inline void LoadA(LocalTensor<int8_t> aa,uint32_t ao,uint32_t ma,uint32_t ka) {
        if constexpr(Mode==TailPanel || Mode==LongReduction){
            uint32_t rows=ma/16,reduction=ka/32;LoadData2DParams move{};
            if(reduction<rows){
                move.repeatTimes=rows;move.srcStride=1;move.dstGap=reduction-1;
                for(uint32_t k=0;k<reduction;++k){move.startIndex=k*rows;LoadData(aa[k*512],a1[ao],move);}
            }else{
                move.repeatTimes=reduction;move.srcStride=rows;
                for(uint32_t r=0;r<rows;++r){move.startIndex=r;LoadData(aa[r*ka*16],a1[ao],move);}
            }
            return;
        }
        if constexpr(Mode==WideDouble || Mode==ColumnResident) {
            LoadData2DParams la{};la.repeatTimes=ka/32;la.srcStride=ma/16;
            for(uint32_t r=0;r<ma/16;++r)LoadData(aa[r*ka*16],a1[ao+r*512],la);
            return;
        }
        if(featureRows!=ma){uint8_t pads[4]={0,0,0,0};SetFmatrix(1,ma,pads,FmatrixMode::FMATRIX_LEFT);featureRows=ma;}
        LoadData3DParamsV2<int8_t> la{};
        la.l1H=1;la.l1W=ma;la.channelSize=ka;la.kExtension=ka;la.mExtension=ma;
        la.strideW=1;la.strideH=1;la.filterW=1;la.filterH=1;la.dilationFilterW=1;la.dilationFilterH=1;
        LoadData<int8_t,A_LOAD_CONFIG>(aa,a1[ao],la);
    }
    __aicore__ inline void LoadB(LocalTensor<int8_t> dst,LocalTensor<int8_t> src,uint32_t columns,uint32_t reduction,uint32_t pitch) {
        LoadData2dTransposeParams q{};
        if(reduction<columns){
            q.repeatTimes=columns/32;q.srcStride=pitch/32;q.dstGap=1;
            for(uint32_t k=0;k<reduction/32;++k)LoadDataWithTranspose(dst[k*columns*32],src[k*1024],q);
        }else{
            q.repeatTimes=reduction/32;q.srcStride=1;q.dstGap=columns/16-1;
            for(uint32_t n=0;n<columns/32;++n)LoadDataWithTranspose(dst[n*1024],src[n*pitch*32],q);
        }
    }
    __aicore__ inline void Shallow(const WorkChunk &t,const WorkChunk *future) {
        uint32_t ma=Up(t.rows,16),na=Up(t.cols,32);
        if(!pendingShallow){ReadA(t,0,p.depth,shallowSlot,ma);ReadB(t,0,p.depth,shallowSlot);}
        pendingShallow=false;
        auto aa=l0a.AllocTensor<int8_t>();auto bb=l0b.AllocTensor<int8_t>();
        Fence<HardEvent::MTE2_MTE1>();LoadA(aa,shallowSlot*p.tm*p.ck,ma,p.ck);
        LoadData2dTransposeParams lb{};lb.repeatTimes=p.ck*na/1024;lb.srcStride=1;lb.dstGap=1;
        if(panelPack)LoadDataWithTranspose(bb,b1[shallowSlot*p.tn*bpitch],lb);
        else {
            lb.repeatTimes=na/32;lb.srcStride=bpitch/32;
            for(uint32_t kk=0;kk<p.ck/32;++kk)LoadDataWithTranspose(bb[kk*na*32],b1[shallowSlot*p.tn*bpitch+kk*1024],lb);
        }
        l0a.EnQue(aa);aa=l0a.DeQue<int8_t>();l0b.EnQue(bb);bb=l0b.DeQue<int8_t>();
        MmadParams mm{};mm.m=ma;mm.n=na;mm.k=p.depth;mm.cmatrixInitVal=true;Mmad(c0,aa,bb,mm);
        if(future){shallowSlot^=1;Fence<HardEvent::MTE1_MTE2>(3);ReadA(*future,0,p.depth,shallowSlot,Up(future->rows,16));ReadB(*future,0,p.depth,shallowSlot);pendingShallow=true;}
        l0a.FreeTensor(aa);l0b.FreeTensor(bb);Fence<HardEvent::MTE1_MTE2>();
    }
    __aicore__ inline void ReadPacked(const WorkChunk &t,uint32_t stage,uint32_t slot,uint32_t ma,uint32_t stageK) {
        uint32_t kp=Up(p.depth,64),mp=Up(p.rows+31,64),pos=stage*stageK,ka=Up(Min(stageK,p.depth-pos),32);
        if(p.resident==3 && !p.tailStripe){Nd2NzParams da{};da.ndNum=1;da.nValue=t.rows;da.dValue=Min(stageK,p.depth-pos);da.srcDValue=p.depth;da.dstNzC0Stride=ma;da.dstNzNStride=1;DataCopy(a1[slot*p.tm*stageK],x[(uint64_t)t.row*p.depth+pos],da);}
        else{DataCopyParams da{};da.blockCount=ka/32;da.blockLen=ma;da.srcStride=mp-ma;DataCopy(a1[slot*p.tm*stageK],x[(uint64_t)pos*mp+t.row*32],da);}
        if(t.rows<=32){
            Nd2NzParams db{};db.ndNum=1;db.nValue=Min(stageK,p.depth-pos);db.dValue=t.cols;db.srcDValue=p.cols;db.dstNzC0Stride=stageK;db.dstNzNStride=1;
            DataCopy(b1[slot*p.tn*stageK],originalWeights[((uint64_t)t.expert*p.depth+pos)*p.cols+t.col],db);
        }else{
            DataCopyParams db{};db.blockCount=Up(t.cols,32)/32;db.blockLen=ka;db.srcStride=kp-ka;db.dstStride=stageK-ka;
            DataCopy(b1[slot*p.tn*stageK],w[(uint64_t)t.expert*kp*Up(p.cols,32)+(uint64_t)t.col*kp+pos*32],db);
        }
        SetFlag<HardEvent::MTE2_MTE1>(slot);
    }
    __aicore__ inline void Packed(const WorkChunk &t) {
        if(p.resident!=3){p.tm=t.rows<=32?32:176;p.ck=t.rows<=32?256:160;}
        if(packedRows!=p.tm || packedDepth!=p.ck){if(packedRows)Fence<HardEvent::FIX_M>(4);Fence<HardEvent::M_MTE1>(4);packedRows=p.tm;packedDepth=p.ck;}
        uint32_t ma=t.rows<=32?32:Up(t.rows,16),na=Up(t.cols,32),stageK=2*p.ck,stages=(p.depth+stageK-1)/stageK;
        b1=a1[5*p.tm*stageK];uint32_t completed=0,phase=(t.col/p.tn+t.row/p.tm)%stages;
        for(uint32_t i=0;i<Min(5,stages);++i)ReadPacked(t,(stages-1-i+phase)%stages,i,ma,stageK);
        for(uint32_t si=0;si<stages;++si) {
            uint32_t slot=si%5,stage=(stages-1-si+phase)%stages,start=stage*stageK,count=Min(stageK,p.depth-start),inner=(count+p.ck-1)/p.ck;
            WaitFlag<HardEvent::MTE2_MTE1>(slot);
            for(uint32_t ci=0;ci<inner;++ci,++completed) {
                uint32_t local=(inner-1-ci)*p.ck,vk=Min(p.ck,count-local),ka=Up(vk,32);
                uint32_t parity=packedSequence++&1;
                auto aa=l0a.AllocTensor<int8_t>();LocalTensor<int8_t> left(TPosition::A2,parity*p.tm*p.ck,p.tm*p.ck);
                LoadA(left,slot*p.tm*stageK+local*ma,ma,ka);
                l0a.EnQue(aa);aa=l0a.DeQue<int8_t>();
                auto bb=l0b.AllocTensor<int8_t>();LocalTensor<int8_t> right(TPosition::B2,parity*p.tn*p.ck,p.tn*p.ck);
                LoadB(right,b1[slot*p.tn*stageK+local*32],na,ka,stageK);
                l0b.EnQue(bb);bb=l0b.DeQue<int8_t>();
                MmadParams mm{};mm.m=ma;mm.n=na;mm.k=vk;mm.cmatrixInitVal=completed==0;if(units)mm.unitFlag=completed+1==(p.depth+p.ck-1)/p.ck?3:2;Mmad(c0,left,right,mm);
                l0a.FreeTensor(aa);l0b.FreeTensor(bb);
            }
            Fence<HardEvent::MTE1_MTE2>();
            if(si+5<stages)ReadPacked(t,(stages-1-si-5+phase)%stages,slot,ma,stageK);
        }
    }
    __aicore__ inline void StagePanelPrefix(const WorkChunk &tile){
        Nd2NzParams q{};q.ndNum=1;q.nValue=Min(p.ck,p.depth);q.dValue=tile.cols;q.srcDValue=p.cols;q.dstNzC0Stride=bpitch;q.dstNzNStride=1;
        DataCopy(b1,w[(uint64_t)tile.expert*p.depth*p.cols+tile.col],q);
        SetFlag<HardEvent::MTE2_MTE1>(4);stagedPanel=tile;panelPrefixQueued=true;
    }
    __aicore__ inline void ResidentStripes(LocalTensor<int8_t> aa,uint32_t k,uint32_t vk,uint32_t ka,uint32_t ma,uint32_t na,uint32_t stripe,bool initialize){
        auto first=l0b.AllocTensor<int8_t>();auto second=l0b.AllocTensor<int8_t>();uint32_t spacing=Up(stripe*p.ck,1024);
        for(uint32_t n=0;n<na;n+=stripe){
            LocalTensor<int8_t> panel(TPosition::B2,n/stripe*spacing,spacing);
            LoadB(panel,b1[n*bpitch+k*32],Min(stripe,na-n),ka,bpitch);
        }
        l0b.EnQue(first);l0b.EnQue(second);first=l0b.DeQue<int8_t>();second=l0b.DeQue<int8_t>();
        for(uint32_t n=0;n<na;n+=stripe){
            uint32_t width=Min(stripe,na-n);LocalTensor<int8_t> panel(TPosition::B2,n/stripe*spacing,spacing);
            MmadParams mm{};mm.m=ma;mm.n=width;mm.k=vk;mm.cmatrixInitVal=initialize;Mmad(c0[n*ma],aa,panel,mm);
            if((ma/16)*(width/16)<10)PipeBarrier<PIPE_M>();
        }
        l0b.FreeTensor(first);l0b.FreeTensor(second);
    }
    __aicore__ inline void Compute(const WorkChunk &t,uint32_t firstK=0,uint32_t lastK=0,const WorkChunk *future=nullptr,const WorkChunk *followingRow=nullptr,const WorkChunk *lookaheadGroupRow=nullptr) {
        if(Mode==ShallowResident){Shallow(t,future);return;}
        if(Mode==LongReduction){Packed(t);return;}
        if(!lastK)lastK=p.depth;
        tileUnits=Mode==TailStrip && t.rows==Up(t.rows,16);
        uint32_t ma=(Mode==LongReduction && t.rows<=32)?32:Up(t.rows,16), na=Up(t.cols,32);
        bool hitA=validA && oldA.expert==t.expert && oldA.row==t.row && oldA.rows==t.rows && firstK>=aFirst && lastK<=aLast;
        bool hitB=validB && oldB.expert==t.expert && (fullB || (oldB.col==t.col && oldB.cols==t.cols));
        uint32_t aIndex=0;
        if(twoA) {
            bool found=false;for(uint32_t i=0;i<2;++i)if(aValid[i] && cachedA[i].expert==t.expert && cachedA[i].row==t.row && cachedA[i].rows==t.rows){aIndex=i;found=true;}
            if(!found)aIndex=!aValid[0]?0:(!aValid[1]?1:(aAge[0]<=aAge[1]?0:1));
            hitA=found;
        }
        bool useResidentA=false,useScratch=false,takeQueuedGroupHead=false;
        if constexpr(Mode==PersistentExpert){
            useResidentA=pendingResidentA && residentA.expert==t.expert && residentA.row==t.row && residentA.rows==t.rows;
            if(pendingResidentA && !useResidentA)WaitFlag<HardEvent::MTE2_MTE1>(6);pendingResidentA=false;
            useScratch=pendingScratch && scratchTile.expert==t.expert && scratchTile.col==t.col && scratchTile.cols==t.cols;
            if(pendingScratch)WaitFlag<HardEvent::MTE2_MTE1>(4);pendingScratch=false;
        }
        if constexpr(Mode==TailStrip){
            if(rowStageOffset){
                useResidentA=rowStageQueued && rowStageTile.expert==t.expert && rowStageTile.row==t.row && rowStageTile.rows==t.rows;
                if(rowStageQueued && !useResidentA){WaitFlag<HardEvent::MTE2_MTE1>(6);Fence<HardEvent::MTE1_MTE2>(5);}
                rowStageQueued=false;
                takeQueuedGroupHead=groupHeadQueued && groupHeadTile.expert==t.expert && groupHeadTile.row==t.row && groupHeadTile.rows==t.rows;
                if(takeQueuedGroupHead){groupHeadQueued=false;useResidentA=true;aOffsets[0]=0;}
                else if(useResidentA)aOffsets[0]=rowStageOffset;else if(!hitA)aOffsets[0]=0;
                if(pendingScratch && scratchTile.expert==t.expert){WaitFlag<HardEvent::MTE2_MTE1>(4);headStageGroup=scratchTile.expert;pendingScratch=false;}
                useScratch=headStageGroup==t.expert;
            }
        }
        panelPrefixChunks=0;
        if constexpr(Mode==ShortGroupWave){if(panelPrefixQueued){
            WaitFlag<HardEvent::MTE2_MTE1>(4);
            if(stagedPanel.expert==t.expert && stagedPanel.col==t.col && stagedPanel.cols==t.cols)panelPrefixChunks=1;
            panelPrefixQueued=false;
        }}
        bool waitA=keepA&&(!hitA || useResidentA),waitB=keepB&&!hitB;
        bool fillB=waitB && (Mode==TailStrip || Mode==ShortGroupWave || Mode==TailPanel || Mode==PersistentExpert);
        if constexpr(Mode==RowResident){if(!validA && !pendingB && bFactor>1 && keepA && bBytes>bSlots*p.tn*bpitch){ReadB(t,0,Min(p.ck*bFactor,p.depth),bSlots);pendingTile=t;pendingB=true;}}
        if(waitA && !useResidentA){ReadA(t,firstK,lastK-firstK,aIndex,ma);aFirst=firstK;aLast=lastK;}
        if (waitB && !fillB) ReadB(t,0,p.depth,0);
        uint32_t chunks=(lastK-firstK+p.ck-1)/p.ck;
        kPhase=0;
        if(Mode==TailPanel)kPhase=((t.col/p.tn)*chunks/((p.cols+p.tn-1)/p.tn)+1)%chunks;
        if(Mode==Interleaved)kPhase=t.expert*chunks/p.experts;
        uint32_t budget=Mode==ShallowResident?65536:32768;
        if constexpr(Mode==Streamed){if(p.tm*p.ck>32768 && p.tn*p.ck>32768)budget=65536;}
        uint32_t stripe=Mode==TailStrip && p.tailStripe?Min(na,p.tailStripe):Min(na,(budget/p.ck)/32*32);
        if(Mode==ShortGroupWave && na*p.ck>budget)stripe=Up((na+2)/3,32);
        
        if(!keepA)for(uint32_t i=0;i<Min(chunks,2);++i){uint32_t pos=KAt(i,chunks,firstK);ReadA(t,pos,Min(p.ck,lastK-pos),i,ma);}
        if(fillB)for(uint32_t i=0;i<Min(chunks,2);++i){if((!i && useScratch) || i<panelPrefixChunks)continue;uint32_t pos=KAt(i,chunks,firstK);FillResidentB(t,pos,Min(p.ck,lastK-pos),i);}
        uint32_t bStages=(chunks+bFactor-1)/bFactor;
        bool usePending=pendingB && pendingTile.expert==t.expert && pendingTile.col==t.col && pendingTile.cols==t.cols;
        bool coldHead=!usePending && bFactor>1 && chunks>bFactor;
        if(pendingB && !usePending)WaitFlag<HardEvent::MTE2_MTE1>(2+bSlots);
        pendingB=false;
        if(!keepB)for(uint32_t i=0;i<Min(bStages,bSlots);++i) {
            if(usePending && (panelPack || i==0))continue;
            uint32_t pos=KAt(i*bFactor,chunks,firstK);
            ReadB(t,pos,Min(p.ck*bFactor,lastK-pos),i,coldHead && !i);
        }
        const WorkChunk *upcomingGroup=nullptr;
        if constexpr(Mode==TailStrip){
            if(followingRow && followingRow->expert!=t.expert)upcomingGroup=followingRow;else if(future && future->expert!=t.expert)upcomingGroup=future;
            if(rowStageOffset && upcomingGroup && !pendingScratch && !t.col && !useScratch)PrefetchScratch(*upcomingGroup);
        }
        if constexpr(Mode==TailStrip){if(rowStageOffset && lookaheadGroupRow && !groupHeadQueued && !t.col && aOffsets[0]!=0){
            PrimeGroupHead(*lookaheadGroupRow);
        }}
        for (uint32_t chunk=0; chunk<chunks; ++chunk) {
            uint32_t k=KAt(chunk,chunks,firstK), vk=Min(p.ck,lastK-k), ka=Up(vk,32), slot=chunk&1;
            
            auto aa=l0a.AllocTensor<int8_t>();
            
            if(keepA){if(waitA && !chunk)WaitFlag<HardEvent::MTE2_MTE1>(takeQueuedGroupHead?5:6);}
            else WaitFlag<HardEvent::MTE2_MTE1>(slot);
            uint32_t ao=keepA?aOffsets[aIndex]+(k-aSliceFirst)*ma:slot*p.tm*p.ck;
            LoadA(aa,ao,ma,ka);
            l0a.EnQue(aa);aa=l0a.DeQue<int8_t>();
            if(Mode==ShortGroupWave && keepA && keepB && na*p.ck>32768){
                if(fillB && chunk>=panelPrefixChunks)WaitFlag<HardEvent::MTE2_MTE1>(2+slot);else if(!fillB && waitB && !chunk)WaitFlag<HardEvent::MTE2_MTE1>(7);
                ResidentStripes(aa,k,vk,ka,ma,na,stripe,chunk==0);
            }else for (uint32_t col=0; col<na; col+=stripe) {
                uint32_t ns=Min(stripe,na-col);
                
                auto bb=l0b.AllocTensor<int8_t>();
                LoadData2dTransposeParams lb{}; lb.repeatTimes=ns/32;
                lb.srcStride=bpitch/32; lb.dstGap=1; lb.dstFracGap=0;
                uint32_t stageSlot=usePending && bFactor>1 && chunk<bFactor?bSlots:chunk/bFactor%bSlots;
                if(!col){
                    if(keepB){if(fillB){if(!(useScratch && !chunk) && chunk>=panelPrefixChunks)WaitFlag<HardEvent::MTE2_MTE1>(2+slot);}else if(waitB && !chunk)WaitFlag<HardEvent::MTE2_MTE1>(7);}
                    else if(coldHead && !chunk)WaitFlag<HardEvent::MTE2_MTE1>(5);
                    else if(coldHead && chunk==1)WaitFlag<HardEvent::MTE2_MTE1>(2);
                    else if(chunk%bFactor==0)WaitFlag<HardEvent::MTE2_MTE1>(2+stageSlot);
                }
                uint32_t bo=keepB?(col+(fullB?t.col:0))*bpitch+k*32:stageSlot*p.tn*bpitch+col*bpitch+(chunk%bFactor)*p.ck*32;
                if(panelPack){lb.repeatTimes=ka*ns/1024;lb.srcStride=1;LoadDataWithTranspose(bb,b1[bo],lb);}
                else if(useScratch && !chunk)LoadB(bb,b1[scratchBase+(col+(fullB?t.col:0))*p.ck],ns,ka,p.ck);
                else LoadB(bb,b1[bo],ns,ka,bpitch);
                l0b.EnQue(bb);bb=l0b.DeQue<int8_t>();
                MmadParams mm{}; mm.m=ma; mm.n=ns; mm.k=vk;
                mm.cmatrixInitVal=chunk==0;if(units || tileUnits)mm.unitFlag=chunk+1==chunks?3:2;
                Mmad(c0[col*ma],aa,bb,mm);
                if constexpr(Mode==Streamed){if((ma/16)*(ns/16)<10)PipeBarrier<PIPE_M>();}
                if constexpr(Mode==TailStrip){if((ma/16)*(ns/16)<10)PipeBarrier<PIPE_M>();}
                if(col==0 && !keepA && chunk+2<chunks) {
                    Fence<HardEvent::MTE1_MTE2>(1);
                    uint32_t next=KAt(chunk+2,chunks,firstK);ReadA(t,next,Min(p.ck,lastK-next),slot,ma);
                }
                if(col+ns==na && !keepB && (chunk+1)%bFactor==0 && chunk/bFactor+bSlots<bStages) {
                    Fence<HardEvent::MTE1_MTE2>(2);
                    uint32_t next=KAt((chunk/bFactor+bSlots)*bFactor,chunks,firstK);ReadB(t,next,Min(p.ck*bFactor,lastK-next),chunk/bFactor%bSlots);
                }
                if(future && col+ns==na && panelPack && chunks==bSlots) {
                    Fence<HardEvent::MTE1_MTE2>(3);ReadB(*future,k,vk,chunk%bSlots);pendingTile=*future;pendingB=true;
                }
                if(future && bFactor>1 && keepA && bBytes>(bSlots*p.tn*bpitch) && chunk/bFactor+1==bStages && chunk%bFactor==0 && col+ns==na) {
                    Fence<HardEvent::MTE1_MTE2>(3);ReadB(*future,0,Min(p.ck*bFactor,p.depth),bSlots);pendingTile=*future;pendingB=true;
                }
                l0b.FreeTensor(bb);
            }
            l0a.FreeTensor(aa);
            Fence<HardEvent::MTE1_MTE2>();
            if(fillB && chunk+2<chunks){uint32_t next=KAt(chunk+2,chunks,firstK);FillResidentB(t,next,Min(p.ck,lastK-next),slot);}
            if constexpr(Mode==ShortGroupWave){if(keepB && chunks>=3 && chunk+3==chunks && future && (future->expert!=t.expert || future->col!=t.col))StagePanelPrefix(*future);}
            if constexpr(Mode==TailStrip){if(rowStageOffset && upcomingGroup && !pendingScratch && t.col+t.cols>=p.cols && !chunk)PrefetchScratch(*upcomingGroup);}
            if constexpr(Mode==PersistentExpert){
                uint32_t marker=(hitA || useResidentA) && hitB?0:Min(2,chunks-1);
                if(scratchBase && future && chunk==marker && (future->expert!=t.expert || future->col!=t.col || future->cols!=t.cols))PrefetchScratch(*future);
            }
        }
        oldA=t; oldB=t; validA=keepA; validB=keepB && (!useScratch || Mode==TailStrip) && !panelPrefixQueued;
        if constexpr(Mode==PersistentExpert){if(keepA && future && (future->expert!=t.expert || future->row!=t.row || future->rows!=t.rows)){
            ReadA(*future,0,p.depth,0,Up(future->rows,16));residentA=*future;pendingResidentA=true;validA=false;aFirst=0;aLast=p.depth;
        }}
        if constexpr(Mode==TailStrip){if(rowStageOffset && lookaheadGroupRow && !groupHeadQueued && t.col+t.cols>=p.cols){
            PrimeGroupHead(*lookaheadGroupRow);
        }}
        if constexpr(Mode==TailStrip){
            if(rowStageOffset && future && future->expert==t.expert && (future->row!=t.row || future->rows!=t.rows)){
                Nd2NzParams d{};d.ndNum=1;d.nValue=future->rows;d.dValue=p.depth;d.srcDValue=p.depth;d.dstNzC0Stride=Up(future->rows,16);d.dstNzNStride=1;
                DataCopy(a1[rowStageOffset],x[(uint64_t)future->row*p.depth],d);SetFlag<HardEvent::MTE2_MTE1>(6);rowStageTile=*future;rowStageQueued=true;aFirst=0;aLast=p.depth;
            }
        }
        if(twoA){cachedA[aIndex]=t;aValid[aIndex]=true;aAge[aIndex]=++age;}
    }
    __aicore__ inline void Publish(const WorkChunk &t,GlobalTensor<int32_t> scratch,uint64_t offset,bool atomic=false) {
        if(!units && !tileUnits)Fence<HardEvent::M_FIX>();
        FixpipeParamsV220 fp{}; fp.mSize=units?(Mode==LongReduction && t.rows<=32?32:Up(t.rows,16)):t.rows;if(units || tileUnits)fp.unitFlag=3; fp.nSize=Up(t.cols,32);
        fp.srcStride=(Mode==LongReduction && t.rows<=32)?32:Up(t.rows,16); fp.dstStride=(Mode==TailStrip || Mode==TailPanel)?Up(t.cols,32):p.tn;
        if(atomic)SetAtomicAdd<int32_t>();
        Fixpipe<int32_t,int32_t,CFG_ROW_MAJOR>(scratch[offset],c0,fp);
        if(atomic)SetAtomicNone();
        if(!units)Fence<HardEvent::FIX_M>();
    }
    __aicore__ inline void Finish(){if(units || Mode==TailStrip){Fence<HardEvent::FIX_M>();PipeBarrier<PIPE_ALL>();set_ctrl(savedMatrixCtrl);}}
};

class ShallowMatrix {
    ExecutionShape p;GlobalTensor<int8_t> x,w;GlobalTensor<int32_t> exchange;
    TBuf<TPosition::A1> memory;TBuf<TPosition::A2> left;TBuf<TPosition::B2> right;TBuf<TPosition::CO1> result;
    LocalTensor<int8_t> a1,b1,a0,b0;LocalTensor<int32_t> c0;
    Nd2NzParams fixedA{},fixedB{};MmadParams fixedMmad{};FixpipeParamsV220 fixedFix{};
    uint32_t reduction,slot=0,featureRows=0;uint64_t savedCtrl;bool primed=false,published=false;
    __aicore__ inline void Issue(const WorkChunk &t,uint32_t at){
        WaitFlag<HardEvent::MTE1_MTE2>(at);
        Nd2NzParams a=fixedA;
        if(t.rows!=p.tm){a.nValue=t.rows;a.dstNzC0Stride=Up(t.rows,16);}
        DataCopy(a1[at*p.tm*reduction],x[(uint64_t)t.row*p.depth],a);SetFlag<HardEvent::MTE2_MTE1>(at);
        WaitFlag<HardEvent::MTE1_MTE2>(2+at);
        Nd2NzParams b=fixedB;b.dValue=t.cols;
        DataCopy(b1[at*p.tn*reduction],w[(uint64_t)t.expert*p.depth*p.cols+t.col],b);SetFlag<HardEvent::MTE2_MTE1>(2+at);
    }
public:
    __aicore__ inline ShallowMatrix(TPipe &pipe,ExecutionShape plan,GM_ADDR xs,GM_ADDR ws,GM_ADDR workspace):p(plan){
        x.SetGlobalBuffer((__gm__ int8_t*)xs);w.SetGlobalBuffer((__gm__ int8_t*)ws);exchange.SetGlobalBuffer((__gm__ int32_t*)workspace);
        reduction=Up(p.depth,32);savedCtrl=get_ctrl();
        pipe.InitBuffer(memory,2*(p.tm+p.tn)*reduction);pipe.InitBuffer(left,p.tm*reduction);
        pipe.InitBuffer(right,p.tn*reduction);pipe.InitBuffer(result,p.tm*p.tn*4);
        a1=memory.Get<int8_t>();b1=a1[2*p.tm*reduction];a0=left.Get<int8_t>();b0=right.Get<int8_t>();c0=result.Get<int32_t>();
        fixedA.ndNum=1;fixedA.nValue=p.tm;fixedA.dValue=p.depth;fixedA.srcDValue=p.depth;fixedA.dstNzC0Stride=p.tm;fixedA.dstNzNStride=1;
        fixedB.ndNum=1;fixedB.nValue=p.depth;fixedB.dValue=p.tn;fixedB.srcDValue=p.cols;fixedB.dstNzC0Stride=reduction;fixedB.dstNzNStride=1;
        fixedMmad.m=p.tm;fixedMmad.n=p.tn;fixedMmad.k=p.depth;fixedMmad.cmatrixInitVal=true;fixedMmad.unitFlag=3;
        fixedFix.mSize=p.tm;fixedFix.nSize=p.tn;fixedFix.srcStride=p.tm;fixedFix.dstStride=p.tn;fixedFix.unitFlag=3;
        SetLoadDataRepeat({0,1,0});SetLoadDataPaddingValue<int8_t>(0);
        SetMMRowMajor();LocalTensor<uint64_t> reset(TPosition::C2PIPE2GM,0,1);SetFixPipeConfig(reset,true);PipeBarrier<PIPE_ALL>();
        for(uint32_t i=0;i<2;++i){SetFlag<HardEvent::MTE1_MTE2>(i);SetFlag<HardEvent::MTE1_MTE2>(2+i);}
        SetFlag<HardEvent::M_MTE1>(4);
    }
    __aicore__ inline void Compute(const WorkChunk &t,uint32_t firstK=0,uint32_t lastK=0,const WorkChunk *future=nullptr){
        if(!primed){slot=0;Issue(t,slot);primed=true;}
        uint32_t ma=Up(t.rows,16),na=Up(t.cols,32);
        WaitFlag<HardEvent::MTE2_MTE1>(slot);WaitFlag<HardEvent::MTE2_MTE1>(2+slot);WaitFlag<HardEvent::M_MTE1>(4);
        if(featureRows!=ma){uint8_t pads[4]={0,0,0,0};SetFmatrix(1,ma,pads,FmatrixMode::FMATRIX_LEFT);featureRows=ma;}
        LoadData3DParamsV2<int8_t> a{};a.l1H=1;a.l1W=ma;a.channelSize=reduction;a.kExtension=reduction;a.mExtension=ma;
        a.strideW=1;a.strideH=1;a.filterW=1;a.filterH=1;a.dilationFilterW=1;a.dilationFilterH=1;
        LoadData<int8_t,A_LOAD_CONFIG>(a0,a1[slot*p.tm*reduction],a);
        LoadData2dTransposeParams b{};b.repeatTimes=reduction/32;b.srcStride=1;b.dstGap=na/16-1;
        for(uint32_t n=0;n<na/32;++n)LoadDataWithTranspose(b0[n*1024],b1[slot*p.tn*reduction+n*reduction*32],b);
        Fence<HardEvent::MTE1_M>();
        MmadParams mm=fixedMmad;mm.m=ma;mm.n=na;Mmad(c0,a0,b0,mm);
        if((ma/16)*(na/16)<10)PipeBarrier<PIPE_M>();
        SetFlag<HardEvent::M_MTE1>(4);SetFlag<HardEvent::MTE1_MTE2>(slot);SetFlag<HardEvent::MTE1_MTE2>(2+slot);
        if(future){slot^=1;Issue(*future,slot);}else primed=false;
    }
    __aicore__ inline void Publish(const WorkChunk &t,GlobalTensor<int32_t> scratch,uint64_t offset){
        FixpipeParamsV220 fp=fixedFix;fp.mSize=Up(t.rows,16);fp.nSize=Up(t.cols,32);fp.srcStride=Up(t.rows,16);
        Fixpipe<int32_t,int32_t,CFG_ROW_MAJOR>(exchange[offset],c0,fp);published=true;
    }
    __aicore__ inline void Finish(){
        if(published)Fence<HardEvent::FIX_M>();
        WaitFlag<HardEvent::M_MTE1>(4);
        for(uint32_t i=0;i<2;++i){WaitFlag<HardEvent::MTE1_MTE2>(i);WaitFlag<HardEvent::MTE1_MTE2>(2+i);}
        PipeBarrier<PIPE_ALL>();set_ctrl(savedCtrl);
    }
};

class ShallowActivation {
    ExecutionShape p;GlobalTensor<float> scales;GlobalTensor<half> y;GlobalTensor<int32_t> exchange;
    TBuf<TPosition::VECCALC> memory;LocalTensor<float> z,raw,gain;LocalTensor<half> output;
    uint32_t capacity,event,rows=0,pitch=0;WorkChunk held{},scaleTile{};bool inputBusy=false,outputBusy=false,scaleReady=false;
public:
    __aicore__ inline ShallowActivation(TPipe &pipe,ExecutionShape plan,GM_ADDR ss,GM_ADDR ys,GM_ADDR workspace,uint32_t id):p(plan),event(id){
        scales.SetGlobalBuffer((__gm__ float*)ss);y.SetGlobalBuffer((__gm__ half*)ys);exchange.SetGlobalBuffer((__gm__ int32_t*)workspace);
        capacity=Min(8192,Up((p.tm+1)/2*p.tn,512));uint32_t bitmap=Up(capacity/8,256);
        uint32_t bytes=Up(capacity*10+3*bitmap+Up(p.tn,8)*4+32+768,256);pipe.InitBuffer(memory,bytes);
        z=memory.Get<float>();raw=z[capacity+64];output=raw[capacity+64].ReinterpretCast<half>();
        gain=output[capacity+(3*bitmap+256)/2].ReinterpretCast<float>();
    }
    __aicore__ inline uint32_t Rows(uint32_t width){return Min(capacity/Up(width,32),255u);}
    __aicore__ inline void Begin(const WorkChunk &t){
        if(inputBusy){WaitFlag<HardEvent::V_MTE2>(event);inputBusy=false;}
        if(!scaleReady || scaleTile.expert!=t.expert || scaleTile.col!=t.col || scaleTile.cols!=t.cols){
            DataCopyPad(gain,scales[(uint64_t)t.expert*p.cols+t.col],DataCopyExtParams{1,t.cols*4,0,0,0},DataCopyPadExtParams<float>{false,0,0,0});scaleTile=t;scaleReady=true;
        }
    }
    __aicore__ inline void Read(const WorkChunk &t,uint64_t offset,uint32_t first,uint32_t count,uint32_t release){
        held=t;held.row+=first;held.rows=count;rows=count;pitch=Up(t.cols,32);
        DataCopyExtParams read{(uint16_t)count,pitch*4,(p.tn-pitch)*4,0,0};
        DataCopyPad(raw.ReinterpretCast<int32_t>(),exchange[offset+first*p.tn],read,DataCopyPadExtParams<int32_t>{false,0,0,0});
        SetFlag<HardEvent::MTE2_V>(event);if(release!=0xffffffffu)CrossCoreSetFlag<2,PIPE_MTE2>(release);
    }
    __aicore__ inline void Prepare(){
        WaitFlag<HardEvent::MTE2_V>(event);uint32_t count=rows*pitch;
        Cast(z,raw.ReinterpretCast<int32_t>(),RoundMode::CAST_NONE,count);PipeBarrier<PIPE_V>();
        for(uint32_t n=0;n<pitch;n+=64)Mul(z[n],z[n],gain[n],(uint64_t)Min(64,pitch-n),(uint8_t)rows,{1,1,1,(uint8_t)(pitch/8),(uint8_t)(pitch/8),0});
        PipeBarrier<PIPE_V>();SetMaskCount();SetVectorMask<float,MaskMode::COUNTER>(count);
        Mul<float,false>(raw,z,z,MASK_PLACEHOLDER,1,{1,1,1,8,8,8});PipeBarrier<PIPE_V>();
        Muls<float,false>(raw,raw,-0.07135481387376785f,MASK_PLACEHOLDER,1,{1,1,8,8});PipeBarrier<PIPE_V>();
        Adds<float,false>(raw,raw,-1.5957691669464111f,MASK_PLACEHOLDER,1,{1,1,8,8});PipeBarrier<PIPE_V>();
        Mul<float,false>(raw,raw,z,MASK_PLACEHOLDER,1,{1,1,1,8,8,8});PipeBarrier<PIPE_V>();
        Exp<float,false>(raw,raw,MASK_PLACEHOLDER,1,{1,1,8,8});PipeBarrier<PIPE_V>();
        Adds<float,false>(raw,raw,1.0f,MASK_PLACEHOLDER,1,{1,1,8,8});PipeBarrier<PIPE_V>();
        Div<float,false>(raw,z,raw,MASK_PLACEHOLDER,1,{1,1,1,8,8,8});PipeBarrier<PIPE_V>();SetMaskNorm();ResetMask();
        if(outputBusy){WaitFlag<HardEvent::MTE3_V>(event);outputBusy=false;}
        Cast(output,raw,RoundMode::CAST_RINT,count);SetFlag<HardEvent::V_MTE3>(event);
        SetFlag<HardEvent::V_MTE2>(event);inputBusy=true;
    }
    __aicore__ inline void Store(){
        WaitFlag<HardEvent::V_MTE3>(event);
        DataCopyExtParams write{(uint16_t)rows,held.cols*2,(pitch*2-Up(held.cols*2,32))/32,(p.cols-held.cols)*2,0};
        DataCopyPad(y[(uint64_t)held.row*p.cols+held.col],output,write);SetFlag<HardEvent::MTE3_V>(event);outputBusy=true;
    }
    __aicore__ inline void Drain(){if(inputBusy)WaitFlag<HardEvent::V_MTE2>(event);if(outputBusy)WaitFlag<HardEvent::MTE3_V>(event);}
};

template<uint32_t Mode>struct MatrixSelection{using Type=CubeExecutor<Mode>;};
template<>struct MatrixSelection<ShallowResident>{using Type=ShallowMatrix;};

class VectorEpilogue {
    uint32_t Capacity;
    bool outputBusy=false,scaleReady=false,inputPending=false;
    WorkChunk scaleTile{};
    uint32_t bankId;
    ExecutionShape p;
    GlobalTensor<float> scale;
    GlobalTensor<half> y;
    TBuf<TPosition::VECCALC> buf;
    LocalTensor<int32_t> raw;
    LocalTensor<float> z,u,f,s,tail;
    LocalTensor<half> out;
public:
    __aicore__ inline VectorEpilogue(TPipe &pipe,ExecutionShape config,GM_ADDR ss,GM_ADDR ys,uint32_t bank=0):p(config),bankId(bank) {
        scale.SetGlobalBuffer((__gm__ float*)ss); y.SetGlobalBuffer((__gm__ half*)ys);
        Capacity=8192;
        if(p.route==WideDouble)Capacity=1024;
        if(p.route==Compact || p.route==PersistentExpert)Capacity=2048;
        if(p.route==TailStrip)Capacity=16384;
        if(p.route==Interleaved)Capacity=15360;
        if(p.route==LongReduction)Capacity=8448;
        if(p.route==WideTail)Capacity=15360;
        if(p.route==ShortGroupWave){
            Capacity=(p.tm+1)/2*p.tn;uint32_t limit=(192*1024-256-8192-256)/2;
            while(Capacity>2048 && Up(Capacity*8+Up(p.tn,8)*4+32,256)>limit)Capacity-=256;
        }
        
        bool alias=p.route==ShortGroupWave;
        uint32_t bytes=Capacity*(alias?8:10)+(alias?Up(p.tn*4,256):2048);
        if(p.route==PanelStriped || p.route==TailPanel || p.route==TailStrip || p.route==LongReduction || p.route==PersistentExpert || p.route==ShortGroupWave){
            uint32_t size=Up(Capacity,p.route==LongReduction || p.route==PersistentExpert?512:(p.route==ShortGroupWave?256:64));
            uint32_t pad=p.route==PanelStriped || p.route==TailPanel?256:0;
            uint32_t bitmap=p.route==LongReduction || p.route==PersistentExpert?3*Up(size/8,256):(p.route==TailPanel?3*Up(size/8,512):0);
