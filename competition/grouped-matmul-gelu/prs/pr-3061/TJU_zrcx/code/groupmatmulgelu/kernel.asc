            Fence<HardEvent::MTE2_V>(2);Cast(converted,input,RoundMode::CAST_NONE,pitch);PipeBarrier<PIPE_V>();Cast(weights,converted,RoundMode::CAST_NONE,pitch);PipeBarrier<PIPE_V>();Fence<HardEvent::V_MTE2>(2);
            float factor=scale.GetValue(expert);uint32_t batches=(hi-lo+batch-1)/batch;
            for(uint32_t i=0;i<Min(2,batches);++i)QueueDotRows(input[i*capacity],x,lo+i*batch,Min(batch,hi-lo-i*batch),packet.depth,pitch,i);
            uint32_t ordinal=0;
            for(uint32_t row=lo;row<hi;row+=batch,++ordinal){
                uint32_t nr=Min(batch,hi-row),count=nr*pitch,slot=ordinal&1;
                WaitFlag<HardEvent::MTE2_V>(slot);Cast(converted,input[slot*capacity],RoundMode::CAST_NONE,count);PipeBarrier<PIPE_V>();Fence<HardEvent::V_MTE2>(slot);
                if(row+2*batch<hi)QueueDotRows(input[slot*capacity],x,row+2*batch,Min(batch,hi-row-2*batch),packet.depth,pitch,slot);
                for(uint32_t at=0;at<count;at+=8192)Cast(product[at],converted[at],RoundMode::CAST_NONE,Min(8192,count-at));PipeBarrier<PIPE_V>();
                for(uint32_t i=0;i<nr;++i)Mul(product[i*pitch],product[i*pitch],weights,pitch);PipeBarrier<PIPE_V>();
                uint32_t shape[2]={nr*segments,1024};ReduceSum<float,Pattern::Reduce::AR,true>(sums,product,temporary,shape,true);PipeBarrier<PIPE_V>();
                Cast(partials,sums,RoundMode::CAST_RINT,nr*segments);PipeBarrier<PIPE_V>();
                Gather(accum,partials,indices,0,nr);PipeBarrier<PIPE_V>();
                for(uint32_t part=1;part<segments;++part){Gather(picked,partials,indices,part*4,nr);PipeBarrier<PIPE_V>();Add(accum,accum,picked,nr);PipeBarrier<PIPE_V>();}
                Cast(z,accum,RoundMode::CAST_NONE,nr);PipeBarrier<PIPE_V>();Muls(z,z,factor,nr);PipeBarrier<PIPE_V>();SetMaskCount();SetVectorMask<float,MaskMode::COUNTER>(nr);
                Mul<float,false>(u,z,z,MASK_PLACEHOLDER,1,{1,1,1,8,8,8});PipeBarrier<PIPE_V>();
                Muls<float,false>(u,u,-0.07135481387376785f,MASK_PLACEHOLDER,1,{1,1,8,8});PipeBarrier<PIPE_V>();
                Adds<float,false>(u,u,-1.5957691669464111f,MASK_PLACEHOLDER,1,{1,1,8,8});PipeBarrier<PIPE_V>();
                Mul<float,false>(u,u,z,MASK_PLACEHOLDER,1,{1,1,1,8,8,8});PipeBarrier<PIPE_V>();
                Mins<float,false>(u,u,80.0f,MASK_PLACEHOLDER,1,{1,1,8,8});PipeBarrier<PIPE_V>();
                Exp<float,false>(u,u,MASK_PLACEHOLDER,1,{1,1,8,8});PipeBarrier<PIPE_V>();
                Adds<float,false>(u,u,1.0f,MASK_PLACEHOLDER,1,{1,1,8,8});PipeBarrier<PIPE_V>();
                Div<float,false>(u,z,u,MASK_PLACEHOLDER,1,{1,1,1,8,8,8});PipeBarrier<PIPE_V>();SetMaskNorm();ResetMask();
                if(outputBusy){Fence<HardEvent::MTE3_V>(0);outputBusy=false;}
                Cast(output,u,RoundMode::CAST_RINT,nr);Fence<HardEvent::V_MTE3>(0);
                DataCopyPad(y[row],output,DataCopyExtParams{1,nr*2,0,0,0});outputBusy=true;
            }
        }
        if(previous>=last)break;
    }
    if(outputBusy)Fence<HardEvent::MTE3_V>(0);
}
__global__ __aicore__ void OuterVectorKernel(GM_ADDR xs,GM_ADDR ws,GM_ADDR ss,GM_ADDR gs,GM_ADDR ys,SmallInvocation packet){
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    InitSocState();constexpr uint32_t capacity=4096;TPipe pipe;TBuf<TPosition::VECCALC> memory;pipe.InitBuffer(memory,capacity*21);
    auto bytes=memory.Get<uint8_t>();auto input=bytes.ReinterpretCast<int8_t>();auto converted=bytes[capacity].ReinterpretCast<half>();
    auto weights=bytes[3*capacity].ReinterpretCast<float>(),gains=bytes[7*capacity].ReinterpretCast<float>();
    auto z=bytes[11*capacity].ReinterpretCast<float>(),u=bytes[15*capacity].ReinterpretCast<float>();auto output=bytes[19*capacity].ReinterpretCast<half>();
    GlobalTensor<int8_t> x,w;GlobalTensor<float> scale;GlobalTensor<int64_t> ends;GlobalTensor<half> y;
    x.SetGlobalBuffer((__gm__ int8_t*)xs);w.SetGlobalBuffer((__gm__ int8_t*)ws);scale.SetGlobalBuffer((__gm__ float*)ss);
    ends.SetGlobalBuffer((__gm__ int64_t*)gs);y.SetGlobalBuffer((__gm__ half*)ys);
    DataCacheCleanAndInvalid<int64_t,CacheLine::ENTIRE_DATA_CACHE,DcciDst::CACHELINE_OUT>(ends);
    uint32_t first=(uint64_t)packet.rows*GetBlockIdx()/packet.workers,last=(uint64_t)packet.rows*(GetBlockIdx()+1)/packet.workers,previous=0;
    bool inputsBusy=false,outputBusy=false;uint32_t count=packet.cols;
    for(uint32_t expert=0;expert<packet.groups;++expert){
        uint32_t end=ends.GetValue(expert),lo=first>previous?first:previous,hi=Min(last,end);previous=end;
        if(lo<hi){
            if(inputsBusy){Fence<HardEvent::V_MTE2>(0);inputsBusy=false;}
            DataCopyPad(input,w[(uint64_t)expert*count],DataCopyExtParams{1,count,0,0,0},DataCopyPadExtParams<int8_t>{false,0,0,0});
            DataCopyPad(gains,scale[(uint64_t)expert*count],DataCopyExtParams{1,count*4,0,0,0},DataCopyPadExtParams<float>{false,0,0,0});
            Fence<HardEvent::MTE2_V>(0);Cast(converted,input,RoundMode::CAST_NONE,count);PipeBarrier<PIPE_V>();Cast(weights,converted,RoundMode::CAST_NONE,count);PipeBarrier<PIPE_V>();
            for(uint32_t row=lo;row<hi;++row){
                float left=(float)x.GetValue(row);Muls(z,weights,left,count);PipeBarrier<PIPE_V>();Mul(z,z,gains,count);PipeBarrier<PIPE_V>();
                SetMaskCount();SetVectorMask<float,MaskMode::COUNTER>(count);
                Mul<float,false>(u,z,z,MASK_PLACEHOLDER,1,{1,1,1,8,8,8});PipeBarrier<PIPE_V>();
                Muls<float,false>(u,u,-0.07135481387376785f,MASK_PLACEHOLDER,1,{1,1,8,8});PipeBarrier<PIPE_V>();
                Adds<float,false>(u,u,-1.5957691669464111f,MASK_PLACEHOLDER,1,{1,1,8,8});PipeBarrier<PIPE_V>();
                Mul<float,false>(u,u,z,MASK_PLACEHOLDER,1,{1,1,1,8,8,8});PipeBarrier<PIPE_V>();
                Mins<float,false>(u,u,80.0f,MASK_PLACEHOLDER,1,{1,1,8,8});PipeBarrier<PIPE_V>();
                Exp<float,false>(u,u,MASK_PLACEHOLDER,1,{1,1,8,8});PipeBarrier<PIPE_V>();
                Adds<float,false>(u,u,1.0f,MASK_PLACEHOLDER,1,{1,1,8,8});PipeBarrier<PIPE_V>();
                Div<float,false>(u,z,u,MASK_PLACEHOLDER,1,{1,1,1,8,8,8});PipeBarrier<PIPE_V>();SetMaskNorm();ResetMask();
                if(outputBusy){Fence<HardEvent::MTE3_V>(0);outputBusy=false;}
                Cast(output,u,RoundMode::CAST_RINT,count);Fence<HardEvent::V_MTE3>(0);
                DataCopyPad(y[(uint64_t)row*count],output,DataCopyExtParams{1,count*2,0,0,0});outputBusy=true;inputsBusy=true;
            }
        }
        if(previous>=last)break;
    }
    if(inputsBusy)Fence<HardEvent::V_MTE2>(0);if(outputBusy)Fence<HardEvent::MTE3_V>(0);
}
__aicore__ inline void ApplyOuterActivation(const LocalTensor<float> &z,const LocalTensor<float> &u,uint32_t count){
    SetMaskCount();SetVectorMask<float,MaskMode::COUNTER>(count);
    Mul<float,false>(u,z,z,MASK_PLACEHOLDER,1,{1,1,1,8,8,8});PipeBarrier<PIPE_V>();
    Muls<float,false>(u,u,-0.07135481387376785f,MASK_PLACEHOLDER,1,{1,1,8,8});PipeBarrier<PIPE_V>();
    Adds<float,false>(u,u,-1.5957691669464111f,MASK_PLACEHOLDER,1,{1,1,8,8});PipeBarrier<PIPE_V>();
    Mul<float,false>(u,u,z,MASK_PLACEHOLDER,1,{1,1,1,8,8,8});PipeBarrier<PIPE_V>();
    Mins<float,false>(u,u,80.0f,MASK_PLACEHOLDER,1,{1,1,8,8});PipeBarrier<PIPE_V>();
    Exp<float,false>(u,u,MASK_PLACEHOLDER,1,{1,1,8,8});PipeBarrier<PIPE_V>();
    Adds<float,false>(u,u,1.0f,MASK_PLACEHOLDER,1,{1,1,8,8});PipeBarrier<PIPE_V>();
    Div<float,false>(z,z,u,MASK_PLACEHOLDER,1,{1,1,1,8,8,8});PipeBarrier<PIPE_V>();
    SetMaskNorm();ResetMask();
}
__global__ __aicore__ void ValuePartitionKernel(GM_ADDR xs,GM_ADDR ws,GM_ADDR ss,GM_ADDR gs,GM_ADDR ys,SmallInvocation packet){
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    InitSocState();
    constexpr uint32_t pitch=4096,smallGate=256;
    TPipe pipe;TBuf<TPosition::VECCALC> memory;pipe.InitBuffer(memory,184*1024);
    auto bytes=memory.Get<uint8_t>();
    auto xbuf=bytes.ReinterpretCast<int8_t>();
    auto w8=bytes[8192].ReinterpretCast<int8_t>();
    auto wh=bytes[12288].ReinterpretCast<half>();
    auto wf=bytes[20480].ReinterpretCast<float>();
    auto gain=bytes[36864].ReinterpretCast<float>();
    auto z=bytes[53248].ReinterpretCast<float>();
    auto u=bytes[69632].ReinterpretCast<float>();
    auto output=bytes[86016].ReinterpretCast<half>();
    GlobalTensor<int8_t> x,w;GlobalTensor<float> scale;GlobalTensor<int64_t> ends;GlobalTensor<half> y;
    x.SetGlobalBuffer((__gm__ int8_t*)xs);w.SetGlobalBuffer((__gm__ int8_t*)ws);scale.SetGlobalBuffer((__gm__ float*)ss);
    ends.SetGlobalBuffer((__gm__ int64_t*)gs);y.SetGlobalBuffer((__gm__ half*)ys);
    DataCacheCleanAndInvalid<int64_t,CacheLine::ENTIRE_DATA_CACHE,DcciDst::CACHELINE_OUT>(ends);
    uint32_t worker=GetBlockIdx(),workers=packet.workers,previous=0,largeCount=0,largeExpert=packet.groups,smallTotal=0;
    for(uint32_t expert=0;expert<packet.groups;++expert){uint32_t end=ends.GetValue(expert),rows=end-previous;previous=end;if(rows>=smallGate){++largeCount;largeExpert=expert;}else smallTotal+=rows;}
    uint32_t spare=Min(workers/4,(smallTotal+31)/32),largeWorkers=workers-spare;
    bool split=largeCount==1 && spare>0 && largeWorkers>=32;
    uint32_t lanes=split?largeWorkers:workers,vfirst=worker*256u/lanes,vlast=(worker+1u)*256u/lanes;
    uint32_t smallFirst=split && worker>=largeWorkers?(uint64_t)smallTotal*(worker-largeWorkers)/spare:0;
    uint32_t smallLast=split && worker>=largeWorkers?(uint64_t)smallTotal*(worker-largeWorkers+1)/spare:0,smallOrdinal=0;
    uint32_t scanRows=Up(packet.rows,128);Duplicate(xbuf.ReinterpretCast<int32_t>(),0,scanRows/4);Fence<HardEvent::V_MTE2>(0);
    DataCopyPad(xbuf,x,DataCopyExtParams{1,packet.rows,0,0,0},DataCopyPadExtParams<int8_t>{false,0,0,0});Fence<HardEvent::MTE2_S>(1);
    previous=0;
    bool busy[2]={false,false};
    for(uint32_t expert=0;expert<packet.groups;++expert){
        uint32_t end=ends.GetValue(expert),rows=end-previous;
        if(rows){
            uint32_t first=0,last=rows;
            bool reuse=rows>=smallGate;
            bool selected=true;
            if(split){
                if(expert==largeExpert)selected=worker<largeWorkers;
                else{
                    selected=worker>=largeWorkers;
                    uint32_t lo=smallFirst>smallOrdinal?smallFirst:smallOrdinal,hi=Min(smallLast,smallOrdinal+rows);
                    if(lo>=hi)selected=false;else{first=lo-smallOrdinal;last=hi-smallOrdinal;}
                    smallOrdinal+=rows;
                }
            }else if(!reuse){first=(uint64_t)rows*worker/workers;last=(uint64_t)rows*(worker+1)/workers;}
            if(selected && (reuse || first<last)){
                Duplicate(w8.ReinterpretCast<int32_t>(),0,pitch/4);Duplicate(gain,0.0f,pitch);Fence<HardEvent::V_MTE2>(0);
                DataCopyPad(w8,w[(uint64_t)expert*packet.depth*packet.cols],DataCopyExtParams{1,packet.cols,0,0,0},DataCopyPadExtParams<int8_t>{false,0,0,0});
                DataCopyPad(gain,scale[(uint64_t)expert*packet.cols],DataCopyExtParams{1,(uint32_t)packet.cols*4u,0,0,0},DataCopyPadExtParams<float>{false,0,0,0});
                SetFlag<HardEvent::MTE2_V>(0);WaitFlag<HardEvent::MTE2_V>(0);
                Cast(wh,w8,RoundMode::CAST_NONE,pitch);PipeBarrier<PIPE_V>();
                Cast(wf,wh,RoundMode::CAST_NONE,pitch);PipeBarrier<PIPE_V>();
                if(reuse){
                    uint32_t slots=vlast-vfirst,slot=0;
                    for(uint32_t value=vfirst;value<vlast;++value,++slot){
                        float left=(float)((int32_t)value-128);
                        Muls(z,wf,left,pitch);PipeBarrier<PIPE_V>();
                        Mul(z,z,gain,pitch);PipeBarrier<PIPE_V>();
                        ApplyOuterActivation(z,u,pitch);
                        Cast(output[slot*pitch],z,RoundMode::CAST_RINT,pitch);PipeBarrier<PIPE_V>();
                    }
                    Fence<HardEvent::V_MTE3>(0);
                    auto leftMask=w8.ReinterpretCast<uint8_t>(),rightMask=leftMask[1024],selection=leftMask[2048];
                    auto halves=z.ReinterpretCast<half>();Cast(halves,xbuf,RoundMode::CAST_NONE,scanRows);PipeBarrier<PIPE_V>();
                    Compares<half,uint8_t>(leftMask,halves,(half)((int32_t)vfirst-128),CMPMODE::GE,scanRows);
                    Compares<half,uint8_t>(rightMask,halves,(half)((int32_t)vlast-128),CMPMODE::LT,scanRows);PipeBarrier<PIPE_V>();
                    And<uint16_t>(selection.ReinterpretCast<uint16_t>(),leftMask.ReinterpretCast<uint16_t>(),rightMask.ReinterpretCast<uint16_t>(),Up(scanRows/8,32)/2);PipeBarrier<PIPE_V>();Fence<HardEvent::V_S>(0);
                    auto words=selection.ReinterpretCast<uint32_t>();
                    for(uint32_t word=previous/32;word<(end+31)/32;++word){
                        uint32_t bits=words.GetValue(word),base=word*32;
                        if(base<previous)bits&=0xffffffffu<<(previous-base);
                        if(end-base<32)bits&=(1u<<(end-base))-1u;
                        while(bits){
                            uint32_t bit=63-CountLeadingZero((uint64_t)bits),row=base+bit;bits&=~(1u<<bit);
                            uint32_t value=(uint32_t)((int32_t)xbuf.GetValue(row)+128);
                            DataCopyPad(y[(uint64_t)row*packet.cols],output[(value-vfirst)*pitch],DataCopyExtParams{1,(uint32_t)packet.cols*2u,0,0,0});
                        }
                    }
                    Fence<HardEvent::MTE3_V>(0);
                }else{
                    for(uint32_t row=first;row<last;++row){
                        uint32_t buffer=(row-first)&1;if(busy[buffer]){WaitFlag<HardEvent::MTE3_V>(2+buffer);busy[buffer]=false;}
                        float left=(float)xbuf.GetValue(previous+row);
                        Muls(z,wf,left,pitch);PipeBarrier<PIPE_V>();
                        Mul(z,z,gain,pitch);PipeBarrier<PIPE_V>();
                        ApplyOuterActivation(z,u,pitch);
                        Cast(output[buffer*pitch],z,RoundMode::CAST_RINT,pitch);
                        Fence<HardEvent::V_MTE3>(0);
                        DataCopyPad(y[(uint64_t)(previous+row)*packet.cols],output[buffer*pitch],DataCopyExtParams{1,(uint32_t)packet.cols*2u,0,0,0});
                        SetFlag<HardEvent::MTE3_V>(2+buffer);busy[buffer]=true;
                    }
                    for(uint32_t i=0;i<2;++i)if(busy[i]){WaitFlag<HardEvent::MTE3_V>(2+i);busy[i]=false;}
                }
                Fence<HardEvent::V_MTE2>(0);Fence<HardEvent::S_V>(1);
            }
        }
        previous=end;
    }
}
class SlimVectorEpilogue {
    static constexpr uint32_t capacity=4096;
    ExecutionShape p;GlobalTensor<float> scales;GlobalTensor<half> y;
    TBuf<TPosition::VECCALC> memory;LocalTensor<int32_t> raw;
    LocalTensor<float> z,u,gain;LocalTensor<half> output;LocalTensor<uint32_t> pattern;
    bool inputPending=false,outputBusy=false;uint32_t cachedExpert=0xffffffffu;
    __aicore__ inline void AwaitInput(){if(inputPending){WaitFlag<HardEvent::V_MTE2>(0);inputPending=false;}}
public:
    __aicore__ inline SlimVectorEpilogue(TPipe &pipe,ExecutionShape plan,GM_ADDR ss,GM_ADDR ys):p(plan){
        scales.SetGlobalBuffer((__gm__ float*)ss);y.SetGlobalBuffer((__gm__ half*)ys);
        pipe.InitBuffer(memory,capacity*10+512);raw=memory.Get<int32_t>();z=raw[capacity].ReinterpretCast<float>();
        u=raw.ReinterpretCast<float>();output=z[capacity].ReinterpretCast<half>();gain=output[capacity].ReinterpretCast<float>();pattern=gain[64].ReinterpretCast<uint32_t>();
        if(p.cols<=32){uint32_t bits=0xffffffffu>>(32-p.cols);pattern.SetValue(0,bits);pattern.SetValue(1,bits);}
        else{pattern.SetValue(0,0xffffffffu);pattern.SetValue(1,0xffffffffu>>(64-p.cols));}
        Fence<HardEvent::S_V>(7);
    }
    __aicore__ inline void Consume(const WorkChunk &tile,GlobalTensor<int32_t> scratch,uint64_t offset,uint32_t lane,uint32_t,uint32_t,uint32_t release){
        uint32_t halfRows=(tile.rows+1)/2,first=Min(tile.rows,halfRows*lane),last=Min(tile.rows,halfRows*(lane+1));
        if(first>=last){CrossCoreSetFlag<2,PIPE_MTE2>(release);return;}
        AwaitInput();uint32_t pitch=Up(p.cols,32),step=Min(capacity/pitch,255u);
        if(cachedExpert!=tile.expert){
            DataCopyPad(gain,scales[(uint64_t)tile.expert*p.cols],DataCopyExtParams{1,p.cols*4,0,0,0},DataCopyPadExtParams<float>{false,0,0,0});
            Fence<HardEvent::MTE2_V>(2);cachedExpert=tile.expert;
        }
        for(uint32_t r=first;r<last;r+=step){
            if(r>first)AwaitInput();uint32_t nr=Min(step,last-r),count=nr*pitch;
            DataCopyPad(raw,scratch[offset+(uint64_t)r*p.tn],DataCopyExtParams{(uint16_t)nr,pitch*4,(p.tn-pitch)*4,0,0},DataCopyPadExtParams<int32_t>{false,0,0,0});
            if(r+nr==last)CrossCoreSetFlag<2,PIPE_MTE2>(release);
            Fence<HardEvent::MTE2_V>(0);Cast(z,raw,RoundMode::CAST_NONE,count);PipeBarrier<PIPE_V>();
            Mul(z,z,gain,(uint64_t)p.cols,(uint8_t)nr,{1,1,1,(uint8_t)(pitch/8),(uint8_t)(pitch/8),0});PipeBarrier<PIPE_V>();
            if(count%64){Duplicate(z[count],0.0f,64-count%64);PipeBarrier<PIPE_V>();}
            uint64_t kept=0;GatherMask(u,z,pattern,false,0,{1,(uint8_t)((count+63)/64),8,0},kept);PipeBarrier<PIPE_V>();
            uint32_t valid=nr*p.cols;SetMaskCount();SetVectorMask<float,MaskMode::COUNTER>(valid);
            Mul<float,false>(z,u,u,MASK_PLACEHOLDER,1,{1,1,1,8,8,8});PipeBarrier<PIPE_V>();
            Muls<float,false>(z,z,-0.07135481387376785f,MASK_PLACEHOLDER,1,{1,1,8,8});PipeBarrier<PIPE_V>();
            Adds<float,false>(z,z,-1.5957691669464111f,MASK_PLACEHOLDER,1,{1,1,8,8});PipeBarrier<PIPE_V>();
            Mul<float,false>(z,z,u,MASK_PLACEHOLDER,1,{1,1,1,8,8,8});PipeBarrier<PIPE_V>();
            Mins<float,false>(z,z,80.0f,MASK_PLACEHOLDER,1,{1,1,8,8});PipeBarrier<PIPE_V>();
            Exp<float,false>(z,z,MASK_PLACEHOLDER,1,{1,1,8,8});PipeBarrier<PIPE_V>();
            Adds<float,false>(z,z,1.0f,MASK_PLACEHOLDER,1,{1,1,8,8});PipeBarrier<PIPE_V>();
            Div<float,false>(z,u,z,MASK_PLACEHOLDER,1,{1,1,1,8,8,8});PipeBarrier<PIPE_V>();SetMaskNorm();ResetMask();
            if(outputBusy){Fence<HardEvent::MTE3_V>(0);outputBusy=false;}
            Cast(output,z,RoundMode::CAST_RINT,nr*p.cols);Fence<HardEvent::V_MTE3>(0);
            DataCopyPad(y[(uint64_t)(tile.row+r)*p.cols],output,DataCopyExtParams{1,nr*p.cols*2,0,0,0});outputBusy=true;
            SetFlag<HardEvent::V_MTE2>(0);inputPending=true;
        }
    }
    __aicore__ inline void Drain(){AwaitInput();if(outputBusy){Fence<HardEvent::MTE3_V>(0);outputBusy=false;}}
};
inline ExecutionShape MakeLaunchPlan(uint32_t e,uint32_t m,uint32_t k,uint32_t n,uint32_t cores){
    if(e<=1 && m<=128 && k<=256 && n<=256){uint32_t jobs=((m+31)/32)*((n+127)/128);if(cores>jobs)cores=jobs;}
    ExecutionShape p{m,k,n,e,cores,Streamed,128,256,128,2,0};
    uint32_t kp=(k+31)/32*32;
    if(k<=256 && n<=256 && m<=128ull*e && k%32==0 && n%32==0 && (uint64_t)k*n<=65536){
        p.tm=64;p.tn=n<256?n:256;p.ck=k;p.ring=4;p.rowMapValid=2;
    }else if(k%32==0 && n%32==0 && n>=512 && m<=64ull*e && e>cores/2 && e<=cores && k>=2ull*n && (uint64_t)64*kp+6ull*512*64<=496*1024){
        p.tm=64;p.tn=512;p.ck=64;p.resident=1;p.cores=e;p.rowMapValid=7;
    }else if(k%32==0 && n%32==0 && n>=256 && m>64ull*e && m<=128ull*e && e>cores/4 && e<=cores/2 && (uint64_t)128*kp+6ull*256*128<=496*1024){
        p.tm=128;p.tn=256;p.ck=128;p.resident=1;p.cores=cores/e*e;p.rowMapValid=8;
    }
    if(p.rowMapValid==0 && k>=256 && k<=1024 && k%128==0 && n>=256 && n%256==0 && e>cores && m<=64ull*e && (uint64_t)64*kp+4ull*256*128<=496*1024){
        p.tm=64;p.tn=256;p.ck=128;p.ring=3;p.resident=1;p.rowMapValid=11;
    }
    if(p.rowMapValid==0 && k>=512 && k<2048 && n>256 && n<=1024 && m>256ull*e && e>cores/4 && e<=cores/2)p.rowMapValid=9;
    return p;
}

__aicore__ inline ExecutionShape MakeStreamingPlan(ExecutionShape shape,GM_ADDR groups){
    uint32_t e=shape.experts,m=shape.rows,k=shape.depth,n=shape.cols,cores=shape.cores;
    GlobalTensor<int64_t> ends;ends.SetGlobalBuffer((__gm__ int64_t*)groups);
    DataCacheCleanAndInvalid<int64_t,CacheLine::ENTIRE_DATA_CACHE,DcciDst::CACHELINE_OUT>(ends);
    ExecutionShape p{m,k,n,e,cores,Streamed,64,128,128,2,0};
    if(n<=64){p.tm=128;p.tn=64;}
    else if(n>256){p.tm=32;p.tn=256;}
    if(k>=2048){p.tm=32;p.tn=128;p.ck=256;}
    uint32_t active=0,maxRows=0,previous=0,heavyExpert=0,paddedRows=0;
    for(uint32_t expert=0;expert<e;++expert){uint32_t end=ends.GetValue(expert),count=end-previous;previous=end;active+=count>0;paddedRows+=Up(count,16);if(count>maxRows){maxRows=count;heavyExpert=expert;}}
    p.rowExperts=active;
    if(n>=128 && k>=1024 && (uint64_t)m>=64ull*active){
        p.tm=128;p.tn=256;p.ck=k>=4096?512:256;
        p.resident=(uint64_t)p.tm*((k+31)/32*32)+2ull*p.tn*p.ck<=480*1024?1:0;
    }
    if(n>=128 && k<1024 && (uint64_t)m>=32ull*active){
        p.tm=128;p.tn=256;p.ck=128;p.resident=1;
    }
    if(m<16*active){
        p.tm=16;p.tn=n>128?128:64;p.ck=k>=4096?1024:(k>=2048?512:128);
        if((uint64_t)p.tm*((k+31)/32*32)+2ull*p.tn*p.ck<=480*1024)p.resident=1;
    }
    if(n<=64 && k<=128 && m>=256*active){
        p.tn=n<=32?32:64;p.ck=(k+31)/32*32;
        p.tm=32768/p.ck;uint32_t capacity=32768/p.tn;if(p.tm>capacity)p.tm=capacity;
        if(p.tm>1024)p.tm=1024;p.tm=p.tm/16*16;p.resident=2;
    }
    if(n<=64 && k>128 && m>=256*active){
        uint32_t width=n<=32?32:64,rows=32768/p.ck;if(rows>256)rows=256;
        if((uint64_t)width*((k+31)/32*32)+2ull*rows*p.ck<=480*1024){p.tm=rows/16*16;p.tn=width;p.resident=2;}
    }
    if(n<=64 && m>=256*active){uint32_t fill=((m+cores-1)/cores+15)/16*16;if(p.tm>fill)p.tm=fill;}
    if(k<=256 && k%32==0 && n%32==0 && (uint64_t)k*n<=65536){
        p.tm=64;p.tn=n<256?n:256;p.ck=k;p.resident=0;p.ring=4;p.rowMapValid=2;
    }
    uint32_t panels=(n+255)/256;
    if(k>=512 && k<2048 && n>256 && active>1 && 4ull*maxRows>=3ull*m && cores>=2*panels+2 && maxRows>=128*(cores/panels) && (uint64_t)256*Up(k,32)+2*128*128<=496*1024){
        uint32_t share=(uint64_t)cores*Up(maxRows,16)/paddedRows;
        p.heavyCores=Min(share,cores-2)/panels*panels;
        if(p.heavyCores){p.tm=128;p.tn=256;p.ck=128;p.resident=2;p.rowMapValid=3;p.heavyExpert=heavyExpert;}
    }
    if(p.rowMapValid==0 && active>cores/2 && active<=cores && m>=128ull*active && m<=256ull*active && maxRows<=4ull*m/active && k>=512 && k<2048 && n>512 && n<=1024 && (k%32 || n%32) && (uint64_t)(320+96)*Up(k,32)<=496*1024){
        p.tm=96;p.tn=320;p.ck=96;p.resident=2;p.rowMapValid=12;
    }
    uint32_t rowTasks=0;previous=0;
    for(uint32_t expert=0;expert<e;++expert){uint32_t count=(uint32_t)ends.GetValue(expert)-previous;previous=(uint32_t)ends.GetValue(expert);rowTasks+=(count+p.tm-1)/p.tm;}
    if(rowTasks*((n+p.tn-1)/p.tn)<cores && n>256 && k>=2048 && maxRows<=32 && p.tm>16){
        p.tm=16;rowTasks=0;previous=0;
        for(uint32_t expert=0;expert<e;++expert){uint32_t count=(uint32_t)ends.GetValue(expert)-previous;previous=(uint32_t)ends.GetValue(expert);rowTasks+=(count+p.tm-1)/p.tm;}
    }
    if(rowTasks*((n+p.tn-1)/p.tn)<cores && n>256 && k>=2048){
        uint32_t columns=(cores+rowTasks-1)/rowTasks,width=((n+columns-1)/columns+31)/32*32;
        if(width<p.tn)p.tn=width;
    }
    if(p.rowMapValid<2 && n>p.tn && rowTasks>=cores && (uint64_t)(((n+31)/32*32)+p.tm)*((k+31)/32*32)<=496*1024){
        p.rowMapValid=maxRows>p.tm?5:1;p.resident=2;
    }
    uint32_t tasks=p.rowMapValid==1?rowTasks:rowTasks*((n+p.tn-1)/p.tn);
    if(p.rowMapValid!=3)p.cores=p.cores<tasks?p.cores:tasks;return p;
}
__aicore__ inline ExecutionShape SelectInvocationPlan(ExecutionShape p,GM_ADDR groups){
    if(p.rowMapValid==2)return p;
    if((p.rowMapValid==7 || p.rowMapValid==8 || p.rowMapValid==11) && p.rows%p.experts==0){
        GlobalTensor<int64_t> ends;ends.SetGlobalBuffer((__gm__ int64_t*)groups);
        DataCacheCleanAndInvalid<int64_t,CacheLine::ENTIRE_DATA_CACHE,DcciDst::CACHELINE_OUT>(ends);
        uint32_t rows=p.rows/p.experts;bool uniform=true;
        for(uint32_t expert=0;expert<p.experts;++expert)if(ends.GetValue(expert)!=(uint64_t)(expert+1)*rows){uniform=false;break;}
        if(uniform){p.uniformRows=rows;return p;}
    }
    return MakeStreamingPlan(p,groups);
}

class StreamingTileCursor {
    ExecutionShape p;GlobalTensor<int64_t> ends;uint32_t ordinal,expert=0,begin=0,columns,panel=0,owner,heavyStep=0;
    uint32_t sliceFirst,sliceLast,stripeRow=0,stripeEnd=0,panelBlocks,widePanels,fastRow=0,fastPanel=0,fastEnd=0;bool stripeLoaded=false,heavyDone=false,lightDone=false;
public:
    __aicore__ inline StreamingTileCursor(ExecutionShape shape,GM_ADDR groups,uint32_t core):p(shape),ordinal(core){
        owner=core;sliceFirst=(uint64_t)p.rows*core/p.cores;sliceLast=(uint64_t)p.rows*(core+1)/p.cores;
        ends.SetGlobalBuffer((__gm__ int64_t*)groups);columns=(p.cols+p.tn-1)/p.tn;
        uint32_t blocks=(p.cols+31)/32;panelBlocks=blocks/columns;widePanels=blocks%columns;
        if(p.rowMapValid==7 || p.rowMapValid==8){
            expert=core%p.experts;
            uint32_t lanes=p.cores/p.experts;
            fastPanel=p.rowMapValid==7?0:(core/p.experts)*columns/lanes;
            fastEnd=p.rowMapValid==7?columns:(core/p.experts+1)*columns/lanes;
        }
        if(p.rowMapValid==11){ordinal=(uint64_t)p.experts*columns*core/p.cores;sliceLast=(uint64_t)p.experts*columns*(core+1)/p.cores;}
        DataCacheCleanAndInvalid<int64_t,CacheLine::ENTIRE_DATA_CACHE,DcciDst::CACHELINE_OUT>(ends);
    }
    __aicore__ inline uint32_t ColumnStart(uint32_t at){return p.depth>=4096?(at*panelBlocks+Min(at,widePanels))*32:at*p.tn;}
    __aicore__ inline uint32_t ColumnWidth(uint32_t at){return Min(p.depth>=4096?(panelBlocks+(at<widePanels))*32:p.tn,p.cols-ColumnStart(at));}
    __aicore__ inline bool Next(WorkChunk &t){
        if(p.rowMapValid==11){
            if(ordinal>=sliceLast)return false;
            uint32_t group=ordinal/columns,column=ordinal%columns*p.tn,first=group*p.uniformRows;
            t={group,first+fastRow,column,Min(p.tm,p.uniformRows-fastRow),Min(p.tn,p.cols-column)};
            fastRow+=p.tm;if(fastRow>=p.uniformRows){fastRow=0;++ordinal;}return true;
        }
        if(p.rowMapValid==7 || p.rowMapValid==8){
            if(expert>=p.experts || fastPanel>=fastEnd)return false;
            uint32_t first=expert*p.uniformRows,last=first+p.uniformRows,row=first+fastRow,col=ColumnStart(fastPanel);
            if(row>=last)return false;
            t={expert,row,col,Min(p.tm,last-row),ColumnWidth(fastPanel)};
            if(++fastPanel==fastEnd){
                fastPanel=p.rowMapValid==7?0:(owner/p.experts)*columns/(p.cores/p.experts);fastRow+=p.tm;
            }
            return true;
        }
        if(p.rowMapValid==12){
            while(ordinal<p.experts*columns){
                uint32_t group=ordinal%p.experts,column=ordinal/p.experts*p.tn;
                uint32_t first=group?ends.GetValue(group-1):0,last=ends.GetValue(group);
                if(first+fastRow<last){t={group,first+fastRow,column,Min(p.tm,last-first-fastRow),Min(p.tn,p.cols-column)};fastRow+=p.tm;return true;}
                ordinal+=p.cores;fastRow=0;
            }
            return false;
        }
        if(p.rowMapValid==3 && lightDone)return false;
        if(p.rowMapValid==5){
            while(expert<p.experts){
                uint32_t end=ends.GetValue(expert);
                if(!stripeLoaded){stripeRow=begin>sliceFirst?begin:sliceFirst;stripeEnd=Min(end,sliceLast);panel=0;stripeLoaded=true;}
                if(stripeRow>=stripeEnd){begin=end;++expert;stripeLoaded=false;continue;}
                uint32_t col=ColumnStart(panel);
                t={expert,stripeRow,col,Min(p.tm,stripeEnd-stripeRow),ColumnWidth(panel)};
                if(++panel==columns){panel=0;stripeRow+=p.tm;}return true;
            }
            return false;
        }
        if(p.rowMapValid==3 && owner<p.heavyCores && !heavyDone){
            uint32_t first=p.heavyExpert?(uint32_t)ends.GetValue(p.heavyExpert-1):0,last=ends.GetValue(p.heavyExpert);
            uint32_t row=first+(owner/columns+heavyStep*(p.heavyCores/columns))*p.tm,col=ColumnStart(owner%columns);
            if(row<last){++heavyStep;t={p.heavyExpert,row,col,Min(p.tm,last-row),ColumnWidth(owner%columns)};return true;}
            heavyDone=true;
        }
        while(expert<p.experts){
            uint32_t end=ends.GetValue(expert),waves=(end-begin+p.tm-1)/p.tm,jobs=waves*columns;
            if(p.rowMapValid==3 && expert==p.heavyExpert){begin=end;++expert;continue;}
            if(p.rowMapValid==1){
                if(ordinal<waves){
                    uint32_t row=begin+ordinal*p.tm,col=ColumnStart(panel),width=ColumnWidth(panel);
                    if(++panel==columns){panel=0;ordinal+=p.cores;}
                    t={expert,row,col,Min(p.tm,end-row),width};return true;
                }
                ordinal-=waves;begin=end;++expert;continue;
            }
            if(ordinal<jobs){
                uint32_t row=begin+ordinal/columns*p.tm,col=ColumnStart(ordinal%columns),width=ColumnWidth(ordinal%columns);if(p.rowMapValid==3 && owner<p.heavyCores)lightDone=true;
                else ordinal+=p.rowMapValid==3?p.cores-p.heavyCores:p.cores;
                t={expert,row,col,Min(p.tm,end-row),width};return true;
            }
            ordinal-=jobs;begin=end;++expert;
        }
        return false;
    }
};
__aicore__ inline void StageDominantInputs(TPipe &pipe,ExecutionShape p,GM_ADDR xs,GM_ADDR ws){
    GlobalTensor<int8_t> x,w;x.SetGlobalBuffer((__gm__ int8_t*)xs);w.SetGlobalBuffer((__gm__ int8_t*)ws);
    uint64_t boundary=(uint64_t)p.rows*p.depth,total=boundary+(uint64_t)p.depth*p.cols;
    uint64_t first=total*GetBlockIdx()/(2*p.cores),last=total*(GetBlockIdx()+1)/(2*p.cores);
    TBuf<TPosition::VECCALC> buffer;pipe.InitBuffer(buffer,32768);auto local=buffer.Get<int8_t>();
    while(first<last){
        uint32_t count=last-first>32768?32768:last-first;if(first<boundary && first+count>boundary)count=boundary-first;
        if(first<boundary)DataCopyPad(local,x[first],DataCopyExtParams{1,count,0,0,0},DataCopyPadExtParams<int8_t>{false,0,0,0});
        else DataCopyPad(local,w[(uint64_t)p.heavyExpert*p.depth*p.cols+first-boundary],DataCopyExtParams{1,count,0,0,0},DataCopyPadExtParams<int8_t>{false,0,0,0});
        first+=count;
    }
    Fence<HardEvent::MTE2_V>(7);
}
__aicore__ inline void ConsumeShallow(TPipe &pipe,StreamingTileCursor &cursor,ExecutionShape p,GM_ADDR ss,GM_ADDR ys,GM_ADDR workspace,uint32_t core){
    WorkChunk tile{};uint32_t serial=0;
        ShallowActivation first(pipe,p,ss,ys,workspace,0),second(pipe,p,ss,ys,workspace,1);
        ShallowActivation *held=nullptr;uint32_t packet=0;
        while(cursor.Next(tile)){
            uint32_t slot=serial%p.ring,halfRows=(tile.rows+1)/2,begin=Min(tile.rows,halfRows*(GetBlockIdx()%2)),end=Min(tile.rows,begin+halfRows);
            if(begin>=end){CrossCoreWaitFlag<2>(slot);CrossCoreSetFlag<2,PIPE_MTE2>(p.ring+slot);++serial;continue;}
            uint32_t step=first.Rows(tile.cols);
            for(uint32_t row=begin;row<end;row+=step,++packet){
                ShallowActivation &current=packet&1?second:first;current.Begin(tile);if(row==begin)CrossCoreWaitFlag<2>(slot);
                uint32_t nr=Min(step,end-row);current.Read(tile,((uint64_t)core*p.ring+slot)*p.tm*p.tn,row,nr,row+nr==end?p.ring+slot:0xffffffffu);current.Prepare();
                if(held)held->Store();held=&current;
            }
            ++serial;
        }
        if(held)held->Store();first.Drain();second.Drain();
}

template<uint32_t MatrixMode>
__aicore__ inline void TiledFlow(ExecutionShape p,GM_ADDR xs,GM_ADDR ws,GM_ADDR ss,GM_ADDR gs,GM_ADDR ys,GM_ADDR workspace){
    ExecutionShape transport=p;transport.route=MatrixMode==LongReduction?LongReduction:Interleaved;
    uint32_t core=GetBlockIdx();if ASCEND_IS_AIV{core/=2;}
    if(core>=p.cores)return;
    StreamingTileCursor cursor(p,gs,core);WorkChunk tile{};uint32_t sequence=0;
    GlobalTensor<int32_t> exchange;exchange.SetGlobalBuffer((__gm__ int32_t*)workspace);TPipe pipe;
    if ASCEND_IS_AIC{
        typename MatrixSelection<MatrixMode>::Type matrix(pipe,transport,xs,ws,workspace);
        bool available=cursor.Next(tile);
        while(available){
            WorkChunk next{};bool more=cursor.Next(next);
            uint32_t slot=sequence%p.ring;matrix.Compute(tile,0,0,more?&next:nullptr);
            if(sequence>=p.ring)CrossCoreWaitFlag<2>(p.ring+slot);
            matrix.Publish(tile,exchange,((uint64_t)core*p.ring+slot)*p.tm*p.tn);CrossCoreSetFlag<2,PIPE_FIX>(slot);++sequence;
            tile=next;available=more;
        }
        for(uint32_t i=sequence-Min(sequence,p.ring);i<sequence;++i)CrossCoreWaitFlag<2>(p.ring+i%p.ring);
        matrix.Finish();
    }
    if ASCEND_IS_AIV{
        if constexpr(MatrixMode==ShallowResident){ConsumeShallow(pipe,cursor,p,ss,ys,workspace,core);return;}
        if(p.cols>=128 && (p.depth>=4096 || (p.depth%32==0 && p.cols%32==0))){ConsumeShallow(pipe,cursor,p,ss,ys,workspace,core);return;}
        if(p.cols<=64 && p.tn>=p.cols && p.cols%32 && (uint64_t)p.rows>=64ull*p.rowExperts){
            SlimVectorEpilogue activation(pipe,transport,ss,ys);
            while(cursor.Next(tile)){
                uint32_t slot=sequence%p.ring;CrossCoreWaitFlag<2>(slot);
                activation.Consume(tile,exchange,((uint64_t)core*p.ring+slot)*p.tm*p.tn,GetBlockIdx()%2,0,0,p.ring+slot);++sequence;
            }
            activation.Drain();
        }else{
            VectorEpilogue activation(pipe,transport,ss,ys);
            while(cursor.Next(tile)){
                uint32_t slot=sequence%p.ring;CrossCoreWaitFlag<2>(slot);
                activation.Consume(tile,exchange,((uint64_t)core*p.ring+slot)*p.tm*p.tn,GetBlockIdx()%2,0,0,p.ring+slot);++sequence;
            }
            activation.Drain();
        }
    }
}
__aicore__ inline void ReorderActivationBlocks(ExecutionShape p,GM_ADDR xs,GM_ADDR workspace){
    if ASCEND_IS_AIC{
        if(!p.tailStripe)return;
        GlobalTensor<int8_t> source,destination;source.SetGlobalBuffer((__gm__ int8_t*)xs);
        destination.SetGlobalBuffer((__gm__ int8_t*)workspace+(uint64_t)p.cores*p.ring*p.tm*p.tn*4);
        TPipe pipe;TBuf<TPosition::A1> buffer;pipe.InitBuffer(buffer,262144);auto local=buffer.Get<int8_t>();
        uint32_t columns=(p.depth+4095)/4096,total=(p.rows+31)/32*columns,core=GetBlockIdx(),owned=total>core?(total-1-core)/p.cores+1:0,pitch=Up(p.rows+31,64);
        for(uint32_t iteration=0;iteration<owned+2;++iteration){
            if(iteration>=2){
                uint32_t ordinal=iteration-2,slot=ordinal%2,task=core+ordinal*p.cores,row=task/columns*32,k=task%columns*4096,width=Min(4096,p.depth-k);
                WaitFlag<HardEvent::MTE2_MTE3>(slot);DataCopyParams move{};move.blockCount=Up(width,32)/32;move.blockLen=32;move.dstStride=pitch-32;
                DataCopy(destination[(uint64_t)k*pitch+row*32],local[slot*131072],move);Fence<HardEvent::MTE3_MTE2>(slot);
            }
            if(iteration<owned){
                uint32_t slot=iteration%2,task=core+iteration*p.cores,row=task/columns*32,k=task%columns*4096;
                Nd2NzParams move{};move.ndNum=1;move.nValue=Min(32,p.rows-row);move.dValue=Min(4096,p.depth-k);move.srcDValue=p.depth;move.dstNzC0Stride=32;move.dstNzNStride=1;
                DataCopy(local[slot*131072],source[(uint64_t)row*p.depth+k],move);SetFlag<HardEvent::MTE2_MTE3>(slot);
            }
        }
    }
}
__aicore__ inline void ReorderWeightBlocks(ExecutionShape p,GM_ADDR ws,GM_ADDR gs,GM_ADDR workspace){
    if ASCEND_IS_AIC{
        GlobalTensor<int8_t> weights,packed;GlobalTensor<int64_t> ends;
        weights.SetGlobalBuffer((__gm__ int8_t*)ws);ends.SetGlobalBuffer((__gm__ int64_t*)gs);
        DataCacheCleanAndInvalid<int64_t,CacheLine::ENTIRE_DATA_CACHE,DcciDst::CACHELINE_OUT>(ends);
        packed.SetGlobalBuffer((__gm__ int8_t*)workspace+(uint64_t)p.cores*p.ring*p.tm*p.tn*4+(p.tailStripe?(uint64_t)Up(p.rows+31,64)*Up(p.depth,64):0));
        uint32_t active[128],count=0,previous=0;
        for(uint32_t expert=0;expert<p.experts;++expert){uint32_t end=ends.GetValue(expert);if(end-previous>32)active[count++]=expert;previous=end;}
        uint32_t columns=(p.cols+1023)/1024,depthBlocks=Up(p.depth,64)/64,perExpert=columns*depthBlocks,total=count*perExpert;
        uint32_t core=GetBlockIdx(),owned=total>core?(total-1-core)/p.cores+1:0;
        TPipe pipe;TBuf<TPosition::A1> buffer;pipe.InitBuffer(buffer,262144);auto local=buffer.Get<int8_t>();
        for(uint32_t iteration=0;iteration<owned+4;++iteration){
            if(iteration>=4){
                uint32_t ordinal=iteration-4,slot=ordinal%4,task=core+ordinal*p.cores;
                uint32_t expert=active[task/perExpert],within=task%perExpert,k=within/columns*64,n=within%columns*1024,width=Min(1024,p.cols-n);
                WaitFlag<HardEvent::MTE2_MTE3>(slot);DataCopyParams move{};move.blockCount=Up(width,32)/32;move.blockLen=64;move.dstStride=Up(p.depth,64)-64;
                DataCopy(packed[(uint64_t)expert*Up(p.depth,64)*Up(p.cols,32)+(uint64_t)n*Up(p.depth,64)+k*32],local[slot*65536],move);
                Fence<HardEvent::MTE3_MTE2>(slot);
            }
            if(iteration<owned){
                uint32_t slot=iteration%4,task=core+iteration*p.cores,expert=active[task/perExpert],within=task%perExpert,k=within/columns*64,n=within%columns*1024;
                Nd2NzParams move{};move.ndNum=1;move.nValue=Min(64,p.depth-k);move.dValue=Min(1024,p.cols-n);move.srcDValue=p.cols;move.dstNzC0Stride=64;move.dstNzNStride=1;
                DataCopy(local[slot*65536],weights[((uint64_t)expert*p.depth+k)*p.cols+n],move);SetFlag<HardEvent::MTE2_MTE3>(slot);
            }
        }
    }
    SyncAll<false>();
}
__schedmode__(1) __global__ __aicore__ void ReorderedReductionKernel(LaunchDescriptor packet,GM_ADDR xs,GM_ADDR ws,GM_ADDR ss,GM_ADDR gs,GM_ADDR ys,GM_ADDR workspace){
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
    InitSocState();ExecutionShape p=DecodeLaunchDescriptor(packet,LongReduction);if ASCEND_IS_AIC{ICachePreLoad(8);}if ASCEND_IS_AIV{ICachePreLoad(6);}
    ReorderActivationBlocks(p,xs,workspace);ReorderWeightBlocks(p,ws,gs,workspace);
    TiledFlow<LongReduction>(p,xs,ws,ss,gs,ys,workspace);
}
template<uint32_t MatrixMode>
__schedmode__(1) __global__ __aicore__ void PlannedKernel(LaunchDescriptor packet,GM_ADDR xs,GM_ADDR ws,GM_ADDR ss,GM_ADDR gs,GM_ADDR ys,GM_ADDR workspace){
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
    InitSocState();ExecutionShape p=SelectInvocationPlan(DecodeLaunchDescriptor(packet,Streamed),gs);
    if ASCEND_IS_AIC{ICachePreLoad(4);}if ASCEND_IS_AIV{ICachePreLoad(4);}
    if constexpr(MatrixMode==ShallowResident){TiledFlow<ShallowResident>(p,xs,ws,ss,gs,ys,workspace);}
    else{
        bool selected=MatrixMode==PanelStriped?p.rowMapValid==11:(MatrixMode==WideDouble?p.rowMapValid==7:(MatrixMode==RowResident?p.rowMapValid==8:p.rowMapValid==3));
        if(selected)TiledFlow<MatrixMode>(p,xs,ws,ss,gs,ys,workspace);
        else TiledFlow<Streamed>(p,xs,ws,ss,gs,ys,workspace);
    }
}
__schedmode__(1) __global__ __aicore__ void StreamingKernel(LaunchDescriptor packet,GM_ADDR xs,GM_ADDR ws,GM_ADDR ss,GM_ADDR gs,GM_ADDR ys,GM_ADDR workspace){
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
    InitSocState();ExecutionShape p=SelectInvocationPlan(DecodeLaunchDescriptor(packet,Streamed),gs);
    if(p.rowMapValid==2)TiledFlow<ShallowResident>(p,xs,ws,ss,gs,ys,workspace);
    else TiledFlow<Streamed>(p,xs,ws,ss,gs,ys,workspace);
}

}

inline void run_kernel(GM_ADDR x,const TensorGroupInfo &xi,
                       GM_ADDR w,const TensorGroupInfo &wi,
                       GM_ADDR scale,const TensorGroupInfo &si,
                       GM_ADDR group,const TensorGroupInfo &gi,
                       GM_ADDR y,const TensorGroupInfo &yi,
                       int64_t availableCoreNum,aclrtStream stream) {
    using namespace independent_gmg;
    if(xi.numTensors!=1 || wi.numTensors!=1 || si.numTensors!=1 || gi.numTensors!=1 || yi.numTensors!=1)
        return;
    const auto &a=xi.tensors[0], &b=wi.tensors[0], &s=si.tensors[0], &g=gi.tensors[0], &o=yi.tensors[0];
    if(a.numDims!=2 || b.numDims!=3 || s.numDims!=2 || g.numDims!=1 || o.numDims!=2 ||
       a.dtype!=3 || b.dtype!=3 || s.dtype!=0 || g.dtype!=6 || o.dtype!=1)
        return;
    int64_t m=a.shape[0], k=a.shape[1], e=b.shape[0], n=b.shape[2];
    if(m<1 || m>65536 || k<1 || k>8192 || e<1 || e>128 || n<1 || n>4096 ||
       b.shape[1]!=k || s.shape[0]!=e || s.shape[1]!=n || g.shape[0]!=e || o.shape[0]!=m || o.shape[1]!=n || availableCoreNum<1)
        return;
    uint32_t cores=availableCoreNum>63?63:(uint32_t)availableCoreNum;
    if((uint64_t)m*n<=64 && (uint64_t)m*n*k<=4096){
        SmallInvocation packet{(uint32_t)m,(uint16_t)k,(uint16_t)n,(uint32_t)e,1,0};
        SmallAccurateKernel<<<1,nullptr,stream>>>(x,w,scale,group,y,packet);return;
    }
    uint32_t workers=2*cores;if(workers>(uint32_t)m)workers=m;
    SmallInvocation vectorPacket{(uint32_t)m,(uint16_t)k,(uint16_t)n,(uint32_t)e,(uint16_t)workers,0};
    if((uint64_t)k*n<=1){
        ScalarStreamingKernel<<<workers,nullptr,stream>>>(x,w,scale,group,y,vectorPacket);return;
    }
    if(k<=1 && n>=32){
        if(m<=8192 && 86016ull+((256ull+workers-1)/workers)*8192<=184ull*1024)ValuePartitionKernel<<<workers,nullptr,stream>>>(x,w,scale,group,y,vectorPacket);
        else OuterVectorKernel<<<workers,nullptr,stream>>>(x,w,scale,group,y,vectorPacket);return;
    }
    if(n<=1 && k>=32){
        DotVectorKernel<<<workers,nullptr,stream>>>(x,w,scale,group,y,vectorPacket);return;
    }
    if(n>=512 && ((k>=4096 && k%64==0 && (uint64_t)m>=128ull*e) || (k>=512 && k<4096 && (uint64_t)m>=256ull*e))){
        uint32_t tileN=k>=4096 && n>=1024?192:256,tileM=k>=4096 && n>=1024?160:128;
        ExecutionShape packedShape{(uint32_t)m,(uint32_t)k,(uint32_t)n,(uint32_t)e,cores,LongReduction,tileM,tileN,128,2,3};packedShape.tailStripe=k<4096;
        uint64_t required=(uint64_t)cores*2*tileM*tileN*4+(uint64_t)e*((k+63)/64*64)*((n+31)/32*32)+(packedShape.tailStripe?(uint64_t)((m+31+63)/64*64)*((k+63)/64*64):0);void *packedSpace=nullptr;
        if(required<=512ull*1024*1024 && aclrtMalloc(&packedSpace,required,ACL_MEM_MALLOC_HUGE_FIRST)==ACL_SUCCESS){
            LaunchDescriptor packedPacket=EncodeLaunchDescriptor(packedShape);ReorderedReductionKernel<<<cores,nullptr,stream>>>(packedPacket,x,w,scale,group,y,(GM_ADDR)packedSpace);
            aclrtSynchronizeStream(stream);aclrtFree(packedSpace);return;
        }
    }
    ExecutionShape shape=MakeLaunchPlan(e,m,k,n,cores);cores=shape.cores;
    void *workspace=nullptr;
    size_t bytes=(uint64_t)cores*65536*sizeof(int32_t);
    if(aclrtMalloc(&workspace,bytes,ACL_MEM_MALLOC_HUGE_FIRST)!=ACL_SUCCESS)return;
    LaunchDescriptor packet=EncodeLaunchDescriptor(shape);
    switch(shape.rowMapValid){
        case 2:PlannedKernel<ShallowResident><<<cores,nullptr,stream>>>(packet,x,w,scale,group,y,(GM_ADDR)workspace);break;
        case 7:PlannedKernel<WideDouble><<<cores,nullptr,stream>>>(packet,x,w,scale,group,y,(GM_ADDR)workspace);break;
        case 8:PlannedKernel<RowResident><<<cores,nullptr,stream>>>(packet,x,w,scale,group,y,(GM_ADDR)workspace);break;
        case 11:PlannedKernel<PanelStriped><<<cores,nullptr,stream>>>(packet,x,w,scale,group,y,(GM_ADDR)workspace);break;
        case 9:PlannedKernel<PersistentExpert><<<cores,nullptr,stream>>>(packet,x,w,scale,group,y,(GM_ADDR)workspace);break;
        default:StreamingKernel<<<cores,nullptr,stream>>>(packet,x,w,scale,group,y,(GM_ADDR)workspace);break;
    }
    aclrtSynchronizeStream(stream);aclrtFree(workspace);
}
