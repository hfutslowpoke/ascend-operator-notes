        }
    }
    __aicore__ inline void AwaitInputReuse(){if(inputPending){WaitFlag<HardEvent::V_MTE2>(bankId);inputPending=false;}}
    __aicore__ inline void Gelu(uint32_t count) {
        SetMaskCount();SetVectorMask<float,MaskMode::COUNTER>(count);
