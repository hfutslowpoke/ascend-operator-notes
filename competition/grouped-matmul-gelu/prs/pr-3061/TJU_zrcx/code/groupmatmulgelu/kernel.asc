__global__ __aicore__ void ScalarStreamingKernel(GM_ADDR xs,GM_ADDR ws,GM_ADDR ss,GM_ADDR gs,GM_ADDR ys,SmallInvocation packet){
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
