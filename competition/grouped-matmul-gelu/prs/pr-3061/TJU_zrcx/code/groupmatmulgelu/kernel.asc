        raw=buf.Get<int32_t>(); z=raw[Capacity].ReinterpretCast<float>();
        u=raw.ReinterpretCast<float>(); f=u;out=(alias?z:z[Capacity]).ReinterpretCast<half>();
        s=alias?z[Capacity]:out[Capacity].ReinterpretCast<float>();
        if(p.route==PanelStriped || p.route==TailPanel || p.route==TailStrip || p.route==LongReduction || p.route==PersistentExpert || p.route==ShortGroupWave){
            uint32_t size=Up(Capacity,p.route==LongReduction || p.route==PersistentExpert?512:(p.route==ShortGroupWave?256:64));
            uint32_t pad=p.route==PanelStriped || p.route==TailPanel?64:0;
            uint32_t bitmap=p.route==LongReduction || p.route==PersistentExpert?3*Up(size/8,256):(p.route==TailPanel?3*Up(size/8,512):0);
            z=buf.Get<float>();
            raw=z[size+pad].ReinterpretCast<int32_t>();u=raw.ReinterpretCast<float>();f=u;
            out=raw[size+pad].ReinterpretCast<half>();
            s=out[size+bitmap/2].ReinterpretCast<float>();
            if(p.route==PanelStriped){s=raw[size+pad].ReinterpretCast<float>();out=s[Up(p.tn,8)].ReinterpretCast<half>();}
