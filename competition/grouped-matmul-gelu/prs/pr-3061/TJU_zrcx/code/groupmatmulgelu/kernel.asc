            if(p.route==ShortGroupWave && outputBusy){Fence<HardEvent::MTE3_V>(bankId);outputBusy=false;}
            DataCopyExtParams rd{(uint16_t)nr,pitch*4,(cpitch-pitch)*4,0,0};
            DataCopyPad(raw,scratch[offset+r*cpitch+colOffset],rd,DataCopyPadExtParams<int32_t>{false,0,0,0});
