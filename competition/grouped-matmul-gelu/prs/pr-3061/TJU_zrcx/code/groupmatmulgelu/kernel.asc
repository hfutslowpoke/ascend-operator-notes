    Mul(u,z,z,count);PipeBarrier<PIPE_V>();Muls(u,u,-0.07135481387376785f,count);PipeBarrier<PIPE_V>();
    Adds(u,u,-1.5957691669464111f,count);PipeBarrier<PIPE_V>();Mul(u,u,z,count);PipeBarrier<PIPE_V>();
    Mins(u,u,80.0f,count);PipeBarrier<PIPE_V>();Exp(u,u,count);PipeBarrier<PIPE_V>();
    Adds(u,u,1.0f,count);PipeBarrier<PIPE_V>();Div(u,z,u,count);PipeBarrier<PIPE_V>();
