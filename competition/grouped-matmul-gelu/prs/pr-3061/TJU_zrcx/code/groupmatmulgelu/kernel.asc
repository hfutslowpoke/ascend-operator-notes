    GlobalTensor<int8_t> x,w;GlobalTensor<float> scales;GlobalTensor<int64_t> ends;GlobalTensor<half> y;
    x.SetGlobalBuffer((__gm__ int8_t*)xs);w.SetGlobalBuffer((__gm__ int8_t*)ws);scales.SetGlobalBuffer((__gm__ float*)ss);
    ends.SetGlobalBuffer((__gm__ int64_t*)gs);y.SetGlobalBuffer((__gm__ half*)ys);
    DataCacheCleanAndInvalid<int64_t,CacheLine::ENTIRE_DATA_CACHE,DcciDst::CACHELINE_OUT>(ends);
