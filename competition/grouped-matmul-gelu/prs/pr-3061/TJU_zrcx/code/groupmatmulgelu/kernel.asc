        Exp<float,false>(u,u,MASK_PLACEHOLDER,1,{1,1,8,8});PipeBarrier<PIPE_V>();
        Adds<float,false>(u,u,1.0f,MASK_PLACEHOLDER,1,{1,1,8,8});PipeBarrier<PIPE_V>();
        Div<float,false>(f,z,u,MASK_PLACEHOLDER,1,{1,1,1,8,8,8});PipeBarrier<PIPE_V>();SetMaskNorm();ResetMask();
        if(outputBusy){Fence<HardEvent::MTE3_V>(bankId);outputBusy=false;}
        if(p.route==TailStrip){uint32_t first=Min(count,8192);Cast(out,f,RoundMode::CAST_RINT,first);if(count>first)Cast(out[first],f[first],RoundMode::CAST_RINT,count-first);}
        else Cast(out,f,RoundMode::CAST_RINT,count);PipeBarrier<PIPE_V>();
    }
    __aicore__ inline uint32_t PacketRows(uint32_t pitch) {return Capacity/pitch;}
    __aicore__ inline void Consume(const WorkChunk &input,GlobalTensor<int32_t> scratch,uint64_t offset,uint32_t lane,uint32_t packetFirst=0,uint32_t packetLast=0,uint32_t freeFlag=0xffffffffu) {
        WorkChunk t=input;
        uint32_t halfRows=(t.rows+1)/2,first=Min(t.rows,halfRows*lane),last=Min(t.rows,halfRows*(lane+1)),colOffset=0;
        if(p.route==WideDouble) {
            uint32_t col=t.cols*lane/2,end=t.cols*(lane+1)/2;
            t.col+=col;t.cols=end-col;colOffset=col;first=0;last=t.rows;
        }
        if(!t.cols || first>=last){if(freeFlag!=0xffffffffu)CrossCoreSetFlag<2,PIPE_MTE2>(freeFlag);return;}
        AwaitInputReuse();
        uint32_t pitch=Up(t.cols,32),step=Min(Capacity/pitch,255u),cpitch=(p.route==TailStrip || p.route==TailPanel)?Up(input.cols,32):p.tn;
        if(packetLast){first=packetFirst;last=packetLast;}
        if(!scaleReady || scaleTile.expert!=t.expert || scaleTile.col!=t.col || scaleTile.cols!=t.cols) {
            DataCopyExtParams sc{1,t.cols*4,0,0,0};
            DataCopyPad(s,scale[(uint64_t)t.expert*p.cols+t.col],sc,DataCopyPadExtParams<float>{false,0,0,0});
            Fence<HardEvent::MTE2_V>(bankId+2);
            scaleTile=t;scaleReady=true;
        }
        for (uint32_t r=first;r<last;r+=step) {
            if(r>first)AwaitInputReuse();
