    }
    BinaryRepeatParams scalePair{1,1,1,1,1,0};Mul(z,z,scales,8,static_cast<uint8_t>(pairRows),scalePair);Mul(z[pairRows*8],z[pairRows*8],scales[8],8,static_cast<uint8_t>(pairRows),scalePair);PipeBarrier<PIPE_V>();
    Mul(u,z,z,32);PipeBarrier<PIPE_V>();Axpy(tail,u,-0.07135481387376785f,32);PipeBarrier<PIPE_V>();
    Mul(tail,tail,z,32);PipeBarrier<PIPE_V>();Exp(tail,tail,32);PipeBarrier<PIPE_V>();
