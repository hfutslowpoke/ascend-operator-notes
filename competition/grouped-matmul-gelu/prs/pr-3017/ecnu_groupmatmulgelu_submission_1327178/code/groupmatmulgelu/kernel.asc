namespace path_small_aligned {
using namespace AscendC;
using gmg_common::WaitFor;
__aicore__ __attribute__((section(".gmg_small_aligned_actual"))) inline void GeluNormalBatch(LocalTensor<float>z,LocalTensor<float>t,uint8_t repeats){
 Muls<float,false>(t,z,-0.07135481627260025f,uint64_t{0},repeats,UnaryRepeatParams{1,1,8,8});PipeBarrier<PIPE_V>();
 Mul<float,false>(t,t,z,uint64_t{0},repeats,BinaryRepeatParams{1,1,1,8,8,8});PipeBarrier<PIPE_V>();
 Adds<float,false>(t,t,-1.5957691216057308f,uint64_t{0},repeats,UnaryRepeatParams{1,1,8,8});PipeBarrier<PIPE_V>();
 Mul<float,false>(t,t,z,uint64_t{0},repeats,BinaryRepeatParams{1,1,1,8,8,8});PipeBarrier<PIPE_V>();
 Mins<float,false>(t,t,80.0f,uint64_t{0},repeats,UnaryRepeatParams{1,1,8,8});PipeBarrier<PIPE_V>();
 Exp<float,false>(t,t,uint64_t{0},repeats,UnaryRepeatParams{1,1,8,8});PipeBarrier<PIPE_V>();
 Adds<float,false>(t,t,1.0f,uint64_t{0},repeats,UnaryRepeatParams{1,1,8,8});PipeBarrier<PIPE_V>();
 Div<float,false>(z,z,t,uint64_t{0},repeats,BinaryRepeatParams{1,1,1,8,8,8});PipeBarrier<PIPE_V>();
}
__aicore__ __attribute__((section(".gmg_small_aligned_actual"))) inline void GeluNormalMask(LocalTensor<float>z,LocalTensor<float>t,int count){
 SetMaskNorm();SetVectorMask<float>(0,~uint64_t{0});
 int done=0,full=count/64;
 while(full>0){const int reps=gmg_common::Min(full,255);GeluNormalBatch(z[done],t[done],static_cast<uint8_t>(reps));done+=reps*64;full-=reps;}
 const int tail=count-done;
 if(tail){SetVectorMask<float>(0,(uint64_t{1}<<tail)-1);GeluNormalBatch(z[done],t[done],uint8_t{1});}
 SetVectorMask<float>(0,~uint64_t{0});
}





template<int TileRows,int TileCols,int Panel>
__global__ GMG_ENTRY_ALIGN(2048,2048) __attribute__((section(".gmg_small_aligned_actual"))) __mix__(1,1) void grouped_matmul_gelu_custom(
 GM_ADDR x,GM_ADDR weight,GM_ADDR scale,GM_ADDR groupList,GM_ADDR y,GM_ADDR workspace,int m,int n){
 const int core=GetBlockIdx(),nt=n/TileCols,jobs=m/TileRows*nt;if(core>=jobs)return;InitSocState();
 // The host guarantees only one or two full N panels and complete M16 rows.
 const int row=(nt==1?core:core>>1)*TileRows,col=nt==1?0:(core&1)*TileCols;
 GlobalTensor<int32_t>parts;parts.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(workspace)+core*TileRows*TileCols);
 if ASCEND_IS_AIC {
  GlobalTensor<int8_t>a,b;a.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));b.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(weight));
  LocalTensor<int8_t>a1(TPosition::A1,0,TileRows*Panel),b1(TPosition::B1,8192,TileCols*Panel),a2(TPosition::A2,0,65536),b2(TPosition::B2,0,65536);LocalTensor<int32_t>c(TPosition::CO1,0,TileRows*TileCols);
  Nd2NzParams ap{};ap.ndNum=1;ap.nValue=TileRows;ap.dValue=Panel;ap.srcDValue=Panel;ap.dstNzC0Stride=TileRows;ap.dstNzNStride=1;DataCopy(a1,a[row*Panel],ap);
  Nd2NzParams bp{};bp.ndNum=Panel/32;bp.nValue=32;bp.dValue=TileCols;bp.srcNdMatrixStride=32*n;bp.srcDValue=n;bp.dstNzC0Stride=32;bp.dstNzNStride=1;bp.dstNzMatrixStride=32*TileCols;DataCopy(b1,b[col],bp);
  WaitFor<HardEvent::MTE2_MTE1>();LoadData2DParams lp{};lp.repeatTimes=Panel/32;lp.srcStride=1;LoadData(a2,a1,lp);
  LoadData2dTransposeParams tp{};tp.repeatTimes=(Panel/32)*(TileCols/32);tp.srcStride=1;tp.dstGap=1;LoadDataWithTranspose(b2,b1,tp);WaitFor<HardEvent::MTE1_M>();
  MmadParams mm{};mm.m=TileRows;mm.n=TileCols;mm.k=Panel;mm.cmatrixInitVal=true;Mmad(c,a2,b2,mm);WaitFor<HardEvent::M_FIX>();
  FixpipeParamsV220 fp{};fp.mSize=TileRows;fp.nSize=TileCols;fp.srcStride=TileRows;fp.dstStride=TileCols;fp.ndNum=1;Fixpipe<int32_t,int32_t,CFG_ROW_MAJOR>(parts,c,fp);CrossCoreSetFlag<0x2,PIPE_FIX>(0);
 }
 if ASCEND_IS_AIV {
  constexpr int count=TileRows*TileCols;
  GlobalTensor<float>s;s.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scale));GlobalTensor<half>o;o.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y));
  LocalTensor<int32_t>acc(TPosition::VECCALC,0,count);LocalTensor<float>sv(TPosition::VECCALC,8448,TileCols),t(TPosition::VECCALC,8960,count);LocalTensor<half>out(TPosition::VECCALC,17152,count);
  DataCopy(sv,s[col],TileCols);CrossCoreWaitFlag<0x2>(0);DataCopy(acc,parts,count);WaitFor<HardEvent::MTE2_V>();auto z=acc.ReinterpretCast<float>();Cast(z,acc,RoundMode::CAST_NONE,count);PipeBarrier<PIPE_V>();
  Mul(z,z,sv,uint64_t{64},TileRows,BinaryRepeatParams{1,1,1,TileCols/8,TileCols/8,0});
  Mul(z[64],z[64],sv[64],uint64_t{64},TileRows,BinaryRepeatParams{1,1,1,TileCols/8,TileCols/8,0});PipeBarrier<PIPE_V>();
  GeluNormalMask(z,t,count);Cast(out,z,RoundMode::CAST_RINT,count);WaitFor<HardEvent::V_MTE3>();
  if(nt==1)DataCopy(o[row*n],out,count);
  else DataCopyPad(o[row*n+col],out,DataCopyExtParams{TileRows,TileCols*2,0,static_cast<uint32_t>((n-TileCols)*2),0});
  PipeBarrier<PIPE_ALL>();
 }
}
}
static void LaunchSmallAligned(GM_ADDR x,GM_ADDR w,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,int m,int k,int n,aclrtStream stream){
 const int jobs=m/16*(n/128),launch=jobs;void*workspace=nullptr;
 if(aclrtMalloc(&workspace,static_cast<size_t>(jobs)*16*128*sizeof(int32_t),ACL_MEM_MALLOC_HUGE_FIRST)!=ACL_SUCCESS)return;
 if(k<=128){path_small_aligned::grouped_matmul_gelu_custom<16,128,128><<<launch,nullptr,stream>>>(x,w,scale,groups,y,(GM_ADDR)workspace,m,n);}
 else{path_small_aligned::grouped_matmul_gelu_custom<16,128,256><<<launch,nullptr,stream>>>(x,w,scale,groups,y,(GM_ADDR)workspace,m,n);}
 aclrtSynchronizeStream(stream);aclrtFree(workspace);
}
