// Single-file integration of r703: cached Tiny implementation is defined in this file; no private header or separate device implementation is required.
// Retained baseline paths use current device-function extents: minimum 2 KiB,
// then the next power of two covering all instantiations of this path/core.
// No historical entry address or measured case timing enters this rule.
// TinyCached uses the exact entry and launch declarations selected from submission 1322658.
#if defined(__DAV_VEC__)
#define GMG_ENTRY_ALIGN(CubeAlign,VectorAlign) __attribute__((aligned(VectorAlign)))
#elif defined(__DAV_CUBE__)
#define GMG_ENTRY_ALIGN(CubeAlign,VectorAlign) __attribute__((aligned(CubeAlign)))
#else
#define GMG_ENTRY_ALIGN(CubeAlign,VectorAlign)
#endif
#include "acl/acl.h"
#include "kernel_operator.h"

// Shared arithmetic and transfer primitives. Per-path aliases below keep
// every launch entry, resource budget and specialized Cube pipeline explicit.
namespace gmg_common {
using namespace AscendC;
constexpr int kReady = 0;
constexpr int kConsumed = 2;
constexpr int kL0SlotBytes = 65536;
__aicore__ inline int Min(int a, int b)
{
    return a < b ? a : b;
}

template <HardEvent Event>
__aicore__ inline void WaitFor()
{
    SetFlag<Event>(EVENT_ID0);
    WaitFlag<Event>(EVENT_ID0);
}

__aicore__ inline void Clear(LocalTensor<int8_t> data, int repeats, int blocks, int gap)
    {
        InitConstValueParams<half> params{};
        params.repeatTimes = repeats;
        params.blockNum = blocks;
        params.dstGap = gap;
        params.initValue = static_cast<half>(0.0f);
        InitConstValue(data.ReinterpretCast<half>(), params);
    }

__aicore__ inline void GeluTanh(LocalTensor<float> z, LocalTensor<float> t, int count)
{
    // z / (1 + exp(-2*u)). At exponent 80 the negative result is
    // already below the smallest magnitude that can round to FP16.
    Muls(t, z, -0.07135481627260025f, count);
    PipeBarrier<PIPE_V>();
    Mul(t, t, z, count);
    PipeBarrier<PIPE_V>();
    Adds(t, t, -1.5957691216057308f, count);
    PipeBarrier<PIPE_V>();
    Mul(t, t, z, count);
    PipeBarrier<PIPE_V>();
    Mins(t, t, 80.0f, count);
    PipeBarrier<PIPE_V>();
    Exp(t, t, count);
    PipeBarrier<PIPE_V>();
    Adds(t, t, 1.0f, count);
    PipeBarrier<PIPE_V>();
    Div(z, z, t, count);
    PipeBarrier<PIPE_V>();
}

template <class CopyT>
    __aicore__ inline void LoadPackedWeight(LocalTensor<int8_t> b1, GM_ADDR weightBase, int rowStride, int offset,
                                           int depth, int cols, int alignedCols)
    {
        // Each batch contains 32 K rows. In L1, keep K blocks before N
        // blocks so a single transpose instruction can fill an L0B slice.
        constexpr int bytes = sizeof(CopyT);
        GlobalTensor<CopyT> source;
        source.SetGlobalBuffer(reinterpret_cast<__gm__ CopyT*>(weightBase) + offset / bytes);
        Nd2NzParams copy{};
        copy.ndNum = depth / 32;
        copy.nValue = 32;
        copy.dValue = cols / bytes;
        copy.srcNdMatrixStride = 32 * rowStride / bytes;
        copy.srcDValue = rowStride / bytes;
        copy.dstNzC0Stride = 32;
        copy.dstNzNStride = 1;
        copy.dstNzMatrixStride = 32 * alignedCols / bytes;
        if (copy.ndNum > 0) {
            DataCopy(b1.ReinterpretCast<CopyT>(), source, copy);
        }
        const int rem = depth % 32;
        if (rem != 0) {
            const int done = depth - rem;
            auto tail = b1[done * alignedCols];
            Clear(tail[rem * 32], alignedCols / 32, 32 - rem, rem);
            copy.ndNum = 1;
            copy.nValue = rem;
            copy.srcNdMatrixStride = 0;
            copy.dstNzMatrixStride = 0;
            DataCopy(tail.ReinterpretCast<CopyT>(), source[done * rowStride / bytes], copy);
        }
    }

template <int TileCols, int kVectorElements, int TmpPadding,
          bool CompactAny = false, bool SingleVector = false, bool SpecializeFullTile = false>
class VectorTile {
public:
    __aicore__ inline void SetGroup(int, int) {}
    __aicore__ inline void SetRowEnd(int) {}
    __aicore__ inline void Init(GM_ADDR scale, GM_ADDR y, int n)
    {
        scale_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scale));
        y_.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y));
        n_ = n;
    }

    __aicore__ inline void Compute(const GlobalTensor<int32_t>& result, int expert,
                                   int row, int col, int rows, int cols, int bank)
    {
        if constexpr (SpecializeFullTile) {
            if (rows == 64 && cols == 256) {
                ComputeImpl<64, 256>(result, expert, row, col, 64, 256, bank);
            } else {
                ComputeImpl<0, 0>(result, expert, row, col, rows, cols, bank);
            }
        } else {
            ComputeImpl<0, 0>(result, expert, row, col, rows, cols, bank);
        }
    }

    template <int KnownRows, int KnownCols>
    __aicore__ inline void ComputeImpl(const GlobalTensor<int32_t>& result, int expert,
                                   int row, int col, int rows, int cols, int bank)
    {
        if constexpr (KnownRows) { rows = KnownRows; cols = KnownCols; }
        const int split = SingleVector ? rows : (rows + 1) / 2;
        const int rowOffset = SingleVector ? 0 : GetSubBlockIdx() * split;
        const int ownRows = Min(split, rows - rowOffset);
        if (ownRows > 0) {
            const int pitch = (cols + 31) / 32 * 32;
            const int count = ownRows * pitch;
            constexpr int accBytes = kVectorElements * sizeof(int32_t);
            constexpr int scaleBytes = TileCols * sizeof(float);
            constexpr int outBytes = kVectorElements * sizeof(half);
            const int buffer = scaleSlot_++ & 1;
            const bool compact = count <= kVectorElements / 2 &&
                                 (CompactAny || (cols == TileCols && n_ % TileCols == 0 && rows % 16 == 0));
            const bool overlap = compact && previousCompact_;
            LocalTensor<int32_t> acc(TPosition::VECCALC,
                                     compact ? buffer * accBytes / 2 : 0,
                                     compact ? kVectorElements / 2 : kVectorElements);
            LocalTensor<float> scales(TPosition::VECCALC, accBytes + buffer * scaleBytes, TileCols);
            const int outOffset = accBytes + 2 * scaleBytes + (compact ? buffer * outBytes / 2 : 0);
            LocalTensor<half> out(TPosition::VECCALC, outOffset,
                                  compact ? kVectorElements / 2 : kVectorElements);
            auto z = acc.ReinterpretCast<float>();
            LocalTensor<float> t(TPosition::VECCALC, accBytes + 2 * scaleBytes + outBytes + TmpPadding + (((accBytes + 2 * scaleBytes + outBytes + TmpPadding) % 512 == 0) ? 256 : 0), kVectorElements);

            if ((cols & 7) == 0 && (n_ & 7) == 0) {
                DataCopy(scales, scale_[expert * n_ + col], cols);
            } else {
                DataCopyExtParams scaleCopy{1, static_cast<uint32_t>(cols * sizeof(float)), 0, 0, 0};
                DataCopyPad(scales, scale_[expert * n_ + col], scaleCopy, DataCopyPadExtParams<float>{});
            }
            if (outputPending_ && !overlap) {
                WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
            }
            CrossCoreWaitFlag<0x2>(kReady + bank);
            DataCopy(acc, result[rowOffset * pitch], count);
            // Release the Cube's slot once the last read finishes.
            CrossCoreSetFlag<0x2, PIPE_MTE2>(kConsumed + bank);
            if (overlap) {
                WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
            }
            SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
            WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);

            Cast(z, acc, RoundMode::CAST_NONE, count);
            PipeBarrier<PIPE_V>();
            // Each repeat handles 64 channels and shares the scale across rows.
            for (int c = 0; c < cols; c += 64) {
                Mul(z[c], z[c], scales[c], static_cast<uint64_t>(Min(64, cols - c)),
                    ownRows, BinaryRepeatParams{1, 1, 1, static_cast<uint8_t>(pitch / 8), static_cast<uint8_t>(pitch / 8), 0});
            }
            PipeBarrier<PIPE_V>();

            GeluTanh(z, t, count);
            if (outputPending_ && !overlap) {
                WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
            }
            Cast(out, z, RoundMode::CAST_RINT, count);
            if (overlap) {
                WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
            }
            SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
            SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
            WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);

            DataCopyExtParams outCopy{
                static_cast<uint16_t>(ownRows),
                static_cast<uint32_t>(cols * sizeof(half)),
                static_cast<uint32_t>((pitch - (cols + 15) / 16 * 16) * sizeof(half) / 32),
                static_cast<uint32_t>((n_ - cols) * sizeof(half)),
                0};
            DataCopyPad(y_[(row + rowOffset) * n_ + col], out, outCopy);
            SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
            outputPending_ = true;
            previousCompact_ = compact;
        } else {
            CrossCoreWaitFlag<0x2>(kReady + bank);
            CrossCoreSetFlag<0x2, PIPE_MTE2>(kConsumed + bank);
        }
    }

    __aicore__ inline void Finish()
    {
        if (outputPending_) {
            WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
            WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
        }
    }

private:
    int scaleSlot_ = 0;
    bool previousCompact_ = false;
    bool outputPending_ = false;
    GlobalTensor<float> scale_;
    GlobalTensor<half> y_;
    int n_;
};

template <int TileRows, int TileCols, int Panel, int kTileElements, bool Prefetch = false, int L0Buffers = 2>
class DenseCube {
public:
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR weight, int k, int n)
    {
        x_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
        weight_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(weight));
        weightBase_ = weight;
        k_ = k;
        n_ = n;
        panelStart_ = GetBlockIdx() % ((k + Panel - 1) / Panel) * Panel;
        packBytes_ = n <= 2047 ? 1 : n % 4 == 0 ? 4 : n % 2 == 0 ? 2 : 0;
        SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);
        SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID1);
        SetFlag<HardEvent::M_MTE1>(EVENT_ID0);
        SetFlag<HardEvent::M_MTE1>(EVENT_ID1);
    }
    __aicore__ inline void OverrideWeightCopy(int bytes){packBytes_=bytes;}


    __aicore__ inline void Compute(const GlobalTensor<int32_t>& result, int expert,
                                   int row, int col, int rows, int cols, int bank)
    {
        const int alignedRows = (rows + 15) / 16 * 16;
        const bool gemv = rows == 1;
        const int alignedCols = (cols + 31) / 32 * 32;
        const int area = alignedRows * alignedCols;
        const bool large = area > kTileElements / 2;
        const int offset = large ? 0 : bank * kTileElements / 2;
        const auto matrixEvent = static_cast<TEventID>(bank);
        LocalTensor<int32_t> c(TPosition::CO1, offset * sizeof(int32_t), area);
        const int sliceLimit = Min(kL0SlotBytes / L0Buffers / alignedRows, kL0SlotBytes / L0Buffers / alignedCols) / 32 * 32;
        int kk = panelStart_;
        if constexpr(Prefetch){Preload(panelIndex_&1,expert,row,col,rows,cols,kk,alignedRows,alignedCols);}
        for (int done = 0; done < k_; done += Panel) {
            const int depth = Min(k_ - kk, Panel);
            const int alignedDepth = (depth + 31) / 32 * 32;
            const int panelSlot = panelIndex_++ & 1;
            LocalTensor<int8_t> a1(TPosition::A1, panelSlot * TileRows * Panel, TileRows * Panel);
            LocalTensor<int8_t> b1(TPosition::B1, 2 * TileRows * Panel + panelSlot * Panel * TileCols,
                                  Panel * TileCols);

            if constexpr(Prefetch){
                if(done+Panel<k_){Preload(panelSlot^1,expert,row,col,rows,cols,kk+Panel<k_?kk+Panel:0,alignedRows,alignedCols);}
            }else{
            WaitFlag<HardEvent::MTE1_MTE2>(static_cast<TEventID>(panelSlot));
            LoadPanel(a1, b1, expert, row, col, rows, cols, kk, depth, alignedRows, alignedCols, alignedDepth);
            SetFlag<HardEvent::MTE2_MTE1>(static_cast<TEventID>(panelSlot));
            }
            WaitFlag<HardEvent::MTE2_MTE1>(static_cast<TEventID>(panelSlot));

            for (int off = 0; off < alignedDepth; off += sliceLimit) {
                const int slice = Min(alignedDepth - off, sliceLimit);
                const auto l0slot = static_cast<TEventID>(l0Index_++ % L0Buffers);
                LocalTensor<int8_t> a2(TPosition::A2, static_cast<int>(l0slot) * kL0SlotBytes / L0Buffers, kL0SlotBytes / L0Buffers);
                LocalTensor<int8_t> b2(TPosition::B2, static_cast<int>(l0slot) * kL0SlotBytes / L0Buffers, kL0SlotBytes / L0Buffers);
                WaitFlag<HardEvent::M_MTE1>(l0slot);
                LoadSlice(a2, b2, a1, b1, off, slice, alignedRows, alignedCols, alignedDepth, gemv);
                if (off + slice == alignedDepth) {
                    SetFlag<HardEvent::MTE1_MTE2>(static_cast<TEventID>(panelSlot));
                }
                SetFlag<HardEvent::MTE1_M>(l0slot);
                WaitFlag<HardEvent::MTE1_M>(l0slot);

                const bool first = done == 0 && off == 0;
                if (first) {
                    WaitForMatrix(large || lastLarge_ ? 3 : 1 << bank);
                }
                MmadParams mm{};
                mm.m = gemv ? 1 : alignedRows;
                mm.n = alignedCols;
                mm.k = slice;
                mm.cmatrixInitVal = first;
                Mmad(c, a2, b2, mm);
                if ((mm.m / 16) * (mm.n / 16) < 10) { PipeBarrier<PIPE_M>(); }
                SetFlag<HardEvent::M_MTE1>(l0slot);
            }
            // Start each core at a different K panel to spread GM requests.
            kk = kk + Panel < k_ ? kk + Panel : 0;
        }

        SetFlag<HardEvent::M_FIX>(matrixEvent);
        WaitFlag<HardEvent::M_FIX>(matrixEvent);
        if ((produced_ & (1 << bank)) != 0) {
            CrossCoreWaitFlag<0x2>(kConsumed + bank);
        }
        FixpipeParamsV220 store{};
        store.mSize = rows;
        store.nSize = alignedCols;
        store.srcStride = alignedRows;
        store.dstStride = alignedCols;
        store.ndNum = 1;
        Fixpipe<int32_t, int32_t, CFG_ROW_MAJOR>(result, c, store);
        SetFlag<HardEvent::FIX_M>(matrixEvent);
        matrixPending_ |= 1 << bank;
        lastLarge_ = large;
        CrossCoreSetFlag<0x2, PIPE_FIX>(kReady + bank);
        produced_ |= 1 << bank;
    }

    __aicore__ inline void Finish()
    {
        for (int slot = 0; slot < 2; ++slot) {
            if ((produced_ & (1 << slot)) != 0) {
                CrossCoreWaitFlag<0x2>(kConsumed + slot);
            }
            WaitFlag<HardEvent::MTE1_MTE2>(static_cast<TEventID>(slot));
        }
        WaitFlag<HardEvent::M_MTE1>(EVENT_ID0);
        WaitFlag<HardEvent::M_MTE1>(EVENT_ID1);
        WaitForMatrix(3);
    }

private:
    __aicore__ inline void WaitForMatrix(int overlap)
    {
        const int ready = matrixPending_ & overlap;
        if ((ready & 1) != 0) {
            WaitFlag<HardEvent::FIX_M>(EVENT_ID0);
        }
        if ((ready & 2) != 0) {
            WaitFlag<HardEvent::FIX_M>(EVENT_ID1);
        }
        matrixPending_ &= ~overlap;
    }

    __aicore__ inline void Preload(int slot,int expert,int row,int col,int rows,int cols,int kk,int ar,int ac){
        const int depth=Min(k_-kk,Panel),ad=(depth+31)/32*32;
        LocalTensor<int8_t>a1(TPosition::A1,slot*TileRows*Panel,TileRows*Panel);
        LocalTensor<int8_t>b1(TPosition::B1,2*TileRows*Panel+slot*Panel*TileCols,Panel*TileCols);
        const auto ev=static_cast<TEventID>(slot);WaitFlag<HardEvent::MTE1_MTE2>(ev);
        LoadPanel(a1,b1,expert,row,col,rows,cols,kk,depth,ar,ac,ad);SetFlag<HardEvent::MTE2_MTE1>(ev);
    }
    __aicore__ inline void LoadPanel(LocalTensor<int8_t> a1, LocalTensor<int8_t> b1,
                                     int expert, int row, int col, int rows, int cols,
                                     int kk, int depth, int alignedRows, int alignedCols, int alignedDepth)
    {
        // ND2NZ pads each K chunk of A and each N chunk of B. Fill only
        // the remaining row gaps in the destination fractals.
        if (rows != 1 && rows != alignedRows) {
            Clear(a1[rows * 32], alignedDepth / 32, alignedRows - rows, rows);
        }
        Nd2NzParams aCopy{};
        aCopy.ndNum = 1;
        aCopy.nValue = rows;
        aCopy.dValue = depth;
        aCopy.srcDValue = k_;
        aCopy.dstNzC0Stride = rows == 1 ? 1 : alignedRows;
        aCopy.dstNzNStride = 1;
        DataCopy(a1, x_[row * k_ + kk], aCopy);

        const int offset = (expert * k_ + kk) * n_ + col;
        switch (packBytes_) {
            case 1:
                LoadPackedWeight<int8_t>(b1, offset, depth, cols, alignedCols);
                break;
            case 2:
                LoadPackedWeight<int16_t>(b1, offset, depth, cols, alignedCols);
                break;
            case 4:
                LoadPackedWeight<int32_t>(b1, offset, depth, cols, alignedCols);
                break;
            default: {
                if (depth != alignedDepth) {
                    Clear(b1[depth * 32], alignedCols / 32, alignedDepth - depth, depth);
                }
                Nd2NzParams bCopy{};
                bCopy.ndNum = 1;
                bCopy.nValue = depth;
                bCopy.dValue = cols;
                bCopy.srcDValue = n_;
                bCopy.dstNzC0Stride = alignedDepth;
                bCopy.dstNzNStride = 1;
                DataCopy(b1, weight_[offset], bCopy);
                break;
            }
        }
    }

    template <class CopyT>
    __aicore__ inline void LoadPackedWeight(LocalTensor<int8_t> b1, int offset,
                                           int depth, int cols, int alignedCols)
    {
        gmg_common::LoadPackedWeight<CopyT>(b1, weightBase_, n_,
                                               offset, depth, cols, alignedCols);
    }

    __aicore__ inline void LoadSlice(LocalTensor<int8_t> a2, LocalTensor<int8_t> b2,
                                     LocalTensor<int8_t> a1, LocalTensor<int8_t> b1,
                                     int off, int slice, int alignedRows, int alignedCols, int alignedDepth, bool gemv)
    {
        if (alignedRows == 16) {
            LoadData2DParams loadA{};
            loadA.repeatTimes = gemv ? (slice + 511) / 512 : slice / 32;
            loadA.srcStride = 1;
            // GEMV reads its one row contiguously from L0A.
            LoadData(a2, a1[gemv ? off : off * alignedRows], loadA);
        } else {
            LoadData3DParamsV2<int8_t> loadA{};
            loadA.l1H = 1;
            loadA.l1W = alignedRows;
            loadA.channelSize = alignedDepth;
            loadA.kExtension = slice;
            loadA.mExtension = alignedRows;
            loadA.kStartPt = off;
            LoadData(a2, a1, loadA);
        }

        LoadData2dTransposeParams loadB{};
        if (packBytes_ != 0) {
            loadB.repeatTimes = (slice / 32) * (alignedCols / 32);
            loadB.srcStride = 1;
            loadB.dstGap = 1;
            LoadDataWithTranspose(b2, b1[off * alignedCols], loadB);
        } else if (alignedCols <= slice) {
            loadB.repeatTimes = slice / 32;
            loadB.srcStride = 1;
            loadB.dstGap = alignedCols / 16 - 1;
            for (int c = 0; c < alignedCols; c += 32) {
                LoadDataWithTranspose(b2[c * 32], b1[c * alignedDepth + off * 32], loadB);
            }
        } else {
            loadB.repeatTimes = alignedCols / 32;
            loadB.srcStride = alignedDepth / 32;
            loadB.dstGap = 1;
            for (int kk = 0; kk < slice; kk += 32) {
                LoadDataWithTranspose(b2[kk * alignedCols], b1[(off + kk) * 32], loadB);
            }
        }
    }


    GlobalTensor<int8_t> x_, weight_;
    GM_ADDR weightBase_;
    int k_, n_, packBytes_, panelStart_;
    int produced_ = 0;
    int matrixPending_ = 0;
    bool lastLarge_ = false;
    int panelIndex_ = 0;
    int l0Index_ = 0;
};

template <int TileRows, int TileCols, int Panel, int kTileElements>
class StandardCube {
public:
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR weight, int k, int n)
    {
        x_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
        weight_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(weight));
        weightBase_ = weight;
        k_ = k;
        n_ = n;
        panelStart_ = GetBlockIdx() % ((k + Panel - 1) / Panel) * Panel;
        packBytes_ = n <= 2047 ? 1 : n % 4 == 0 ? 4 : n % 2 == 0 ? 2 : 0;
        SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);
        SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID1);
        SetFlag<HardEvent::M_MTE1>(EVENT_ID0);
    }

    __aicore__ inline void Compute(const GlobalTensor<int32_t>& result, int expert,
                                   int row, int col, int rows, int cols, int bank)
    {
        const int alignedRows = (rows + 15) / 16 * 16;
        const bool gemv = rows == 1;
        const int alignedCols = (cols + 31) / 32 * 32;
        const int area = alignedRows * alignedCols;
        const bool large = area > kTileElements / 2;
        const int offset = large ? 0 : bank * kTileElements / 2;
        const auto matrixEvent = static_cast<TEventID>(bank);
        LocalTensor<int32_t> c(TPosition::CO1, offset * sizeof(int32_t), area);
        const int sliceLimit = Min(kL0SlotBytes / alignedRows, kL0SlotBytes / alignedCols) / 32 * 32;
        int kk = panelStart_;
        for (int done = 0; done < k_; done += Panel) {
            const int depth = Min(k_ - kk, Panel);
            const int alignedDepth = (depth + 31) / 32 * 32;
            const int panelSlot = panelIndex_++ & 1;
            LocalTensor<int8_t> a1(TPosition::A1, panelSlot * TileRows * Panel, TileRows * Panel);
            LocalTensor<int8_t> b1(TPosition::B1, 2 * TileRows * Panel + panelSlot * Panel * TileCols,
                                  Panel * TileCols);

            WaitFlag<HardEvent::MTE1_MTE2>(static_cast<TEventID>(panelSlot));
            LoadPanel(a1, b1, expert, row, col, rows, cols, kk, depth, alignedRows, alignedCols, alignedDepth);
            SetFlag<HardEvent::MTE2_MTE1>(static_cast<TEventID>(panelSlot));
            WaitFlag<HardEvent::MTE2_MTE1>(static_cast<TEventID>(panelSlot));

            for (int off = 0; off < alignedDepth; off += sliceLimit) {
                const int slice = Min(alignedDepth - off, sliceLimit);
                LocalTensor<int8_t> a2(TPosition::A2, 0, kL0SlotBytes);
                LocalTensor<int8_t> b2(TPosition::B2, 0, kL0SlotBytes);
                WaitFlag<HardEvent::M_MTE1>(EVENT_ID0);
                LoadSlice(a2, b2, a1, b1, off, slice, alignedRows, alignedCols, alignedDepth, gemv);
                if (off + slice == alignedDepth) {
                    SetFlag<HardEvent::MTE1_MTE2>(static_cast<TEventID>(panelSlot));
                }
                SetFlag<HardEvent::MTE1_M>(EVENT_ID0);
                WaitFlag<HardEvent::MTE1_M>(EVENT_ID0);

                const bool first = done == 0 && off == 0;
                if (first) {
                    WaitForMatrix(large || lastLarge_ ? 3 : 1 << bank);
                }
                MmadParams mm{};
                mm.m = gemv ? 1 : alignedRows;
                mm.n = alignedCols;
                mm.k = slice;
                mm.cmatrixInitVal = first;
                Mmad(c, a2, b2, mm);
                SetFlag<HardEvent::M_MTE1>(EVENT_ID0);
            }
            // Start each core at a different K panel to spread GM requests.
            kk = kk + Panel < k_ ? kk + Panel : 0;
        }

        SetFlag<HardEvent::M_FIX>(matrixEvent);
        WaitFlag<HardEvent::M_FIX>(matrixEvent);
        if ((produced_ & (1 << bank)) != 0) {
            CrossCoreWaitFlag<0x2>(kConsumed + bank);
        }
        FixpipeParamsV220 store{};
        store.mSize = rows;
        store.nSize = alignedCols;
        store.srcStride = alignedRows;
        store.dstStride = alignedCols;
        store.ndNum = 1;
        Fixpipe<int32_t, int32_t, CFG_ROW_MAJOR>(result, c, store);
        SetFlag<HardEvent::FIX_M>(matrixEvent);
        matrixPending_ |= 1 << bank;
        lastLarge_ = large;
        CrossCoreSetFlag<0x2, PIPE_FIX>(kReady + bank);
        produced_ |= 1 << bank;
    }

    __aicore__ inline void Finish()
    {
        for (int slot = 0; slot < 2; ++slot) {
            if ((produced_ & (1 << slot)) != 0) {
                CrossCoreWaitFlag<0x2>(kConsumed + slot);
            }
            WaitFlag<HardEvent::MTE1_MTE2>(static_cast<TEventID>(slot));
        }
        WaitFlag<HardEvent::M_MTE1>(EVENT_ID0);
        WaitForMatrix(3);
    }

private:
    __aicore__ inline void WaitForMatrix(int overlap)
    {
        const int ready = matrixPending_ & overlap;
        if ((ready & 1) != 0) {
            WaitFlag<HardEvent::FIX_M>(EVENT_ID0);
        }
        if ((ready & 2) != 0) {
            WaitFlag<HardEvent::FIX_M>(EVENT_ID1);
        }
        matrixPending_ &= ~overlap;
    }

    __aicore__ inline void LoadPanel(LocalTensor<int8_t> a1, LocalTensor<int8_t> b1,
                                     int expert, int row, int col, int rows, int cols,
                                     int kk, int depth, int alignedRows, int alignedCols, int alignedDepth)
    {
        // ND2NZ pads each K chunk of A and each N chunk of B. Fill only
        // the remaining row gaps in the destination fractals.
        if (rows != 1 && rows != alignedRows) {
            Clear(a1[rows * 32], alignedDepth / 32, alignedRows - rows, rows);
        }
        Nd2NzParams aCopy{};
        aCopy.ndNum = 1;
        aCopy.nValue = rows;
        aCopy.dValue = depth;
        aCopy.srcDValue = k_;
        aCopy.dstNzC0Stride = rows == 1 ? 1 : alignedRows;
        aCopy.dstNzNStride = 1;
        DataCopy(a1, x_[row * k_ + kk], aCopy);

        const int offset = (expert * k_ + kk) * n_ + col;
        switch (packBytes_) {
            case 1:
                LoadPackedWeight<int8_t>(b1, offset, depth, cols, alignedCols);
                break;
            case 2:
                LoadPackedWeight<int16_t>(b1, offset, depth, cols, alignedCols);
                break;
            case 4:
                LoadPackedWeight<int32_t>(b1, offset, depth, cols, alignedCols);
                break;
            default: {
                if (depth != alignedDepth) {
                    Clear(b1[depth * 32], alignedCols / 32, alignedDepth - depth, depth);
                }
                Nd2NzParams bCopy{};
                bCopy.ndNum = 1;
                bCopy.nValue = depth;
                bCopy.dValue = cols;
                bCopy.srcDValue = n_;
                bCopy.dstNzC0Stride = alignedDepth;
                bCopy.dstNzNStride = 1;
                DataCopy(b1, weight_[offset], bCopy);
                break;
            }
        }
    }

    template <class CopyT>
    __aicore__ inline void LoadPackedWeight(LocalTensor<int8_t> b1, int offset,
                                           int depth, int cols, int alignedCols)
    {
        gmg_common::LoadPackedWeight<CopyT>(b1, weightBase_, n_,
                                               offset, depth, cols, alignedCols);
    }

    __aicore__ inline void LoadSlice(LocalTensor<int8_t> a2, LocalTensor<int8_t> b2,
                                     LocalTensor<int8_t> a1, LocalTensor<int8_t> b1,
                                     int off, int slice, int alignedRows, int alignedCols, int alignedDepth, bool gemv)
    {
        if (alignedRows == 16) {
            LoadData2DParams loadA{};
            loadA.repeatTimes = gemv ? (slice + 511) / 512 : slice / 32;
            loadA.srcStride = 1;
            // GEMV reads its one row contiguously from L0A.
            LoadData(a2, a1[gemv ? off : off * alignedRows], loadA);
        } else {
            LoadData3DParamsV2<int8_t> loadA{};
            loadA.l1H = 1;
            loadA.l1W = alignedRows;
            loadA.channelSize = alignedDepth;
            loadA.kExtension = slice;
            loadA.mExtension = alignedRows;
            loadA.kStartPt = off;
            LoadData(a2, a1, loadA);
        }

        LoadData2dTransposeParams loadB{};
        if (packBytes_ != 0) {
            loadB.repeatTimes = (slice / 32) * (alignedCols / 32);
            loadB.srcStride = 1;
            loadB.dstGap = 1;
            LoadDataWithTranspose(b2, b1[off * alignedCols], loadB);
        } else if (alignedCols <= slice) {
            loadB.repeatTimes = slice / 32;
            loadB.srcStride = 1;
            loadB.dstGap = alignedCols / 16 - 1;
            for (int c = 0; c < alignedCols; c += 32) {
                LoadDataWithTranspose(b2[c * 32], b1[c * alignedDepth + off * 32], loadB);
            }
        } else {
            loadB.repeatTimes = alignedCols / 32;
            loadB.srcStride = alignedDepth / 32;
            loadB.dstGap = 1;
            for (int kk = 0; kk < slice; kk += 32) {
                LoadDataWithTranspose(b2[kk * alignedCols], b1[(off + kk) * 32], loadB);
            }
        }
    }


    GlobalTensor<int8_t> x_, weight_;
    GM_ADDR weightBase_;
    int k_, n_, packBytes_, panelStart_;
    int produced_ = 0;
    int matrixPending_ = 0;
    bool lastLarge_ = false;
    int panelIndex_ = 0;
};
}  // namespace gmg_common

namespace { using namespace AscendC;
template <HardEvent Event> __aicore__ inline void WaitFor() { SetFlag<Event>(EVENT_ID0); WaitFlag<Event>(EVENT_ID0); }
__aicore__ inline void TinyGroupRow(GM_ADDR x, GM_ADDR weight, GM_ADDR scale,
                                     GM_ADDR groupList, GM_ADDR y, int m, int k, int n)
{
    const int row = GetBlockIdx();
    if (row >= m) {
        return;
    }
    GlobalTensor<int64_t> groups;
    groups.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groupList));
    int expert = 0;
    while (groups.GetValue(expert) <= row) {
        ++expert;
    }
    GlobalTensor<int8_t> input, weights;
    GlobalTensor<float> scales;
    GlobalTensor<half> output;
    input.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
    weights.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(weight));
    scales.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scale));
    output.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y));

    LocalTensor<int8_t> storage(TPosition::VECCALC, 0, 608);
    auto a = storage;
    auto b = storage[32];
    auto s = storage[160].ReinterpretCast<float>();
    auto z = storage[288].ReinterpretCast<float>();
    auto t = storage[416].ReinterpretCast<float>();
    auto out = storage[544].ReinterpretCast<half>();

    DataCopyPad(a, input[row * k], DataCopyExtParams{1, static_cast<uint32_t>(k), 0, 0, 0},
                DataCopyPadExtParams<int8_t>{});
    DataCopyPad(b, weights[expert * k * n], DataCopyExtParams{1, static_cast<uint32_t>(k * n), 0, 0, 0},
                DataCopyPadExtParams<int8_t>{});
    DataCopyPad(s, scales[expert * n], DataCopyExtParams{1, static_cast<uint32_t>(n * sizeof(float)), 0, 0, 0},
                DataCopyPadExtParams<float>{});
    WaitFor<HardEvent::MTE2_S>();
    for (int c = 0; c < n; ++c) {
        int32_t sum = 0;
        for (int d = 0; d < k; ++d) {
            sum += static_cast<int32_t>(a.GetValue(d)) * static_cast<int32_t>(b.GetValue(d * n + c));
        }
        const float value = static_cast<float>(sum) * s.GetValue(c);
        const float exponent = value * (-1.5957691216057308f - 0.07135481627260025f * value * value);
        z.SetValue(c, value);
        t.SetValue(c, exponent < 80.0f ? exponent : 80.0f);
    }
    WaitFor<HardEvent::S_V>();
    Exp(t, t, n);
    PipeBarrier<PIPE_V>();
    Adds(t, t, 1.0f, n);
    PipeBarrier<PIPE_V>();
    Div(z, z, t, n);
    PipeBarrier<PIPE_V>();
    Cast(out, z, RoundMode::CAST_RINT, n);
    WaitFor<HardEvent::V_MTE3>();
    DataCopyPad(output[row * n], out, DataCopyExtParams{1, static_cast<uint32_t>(n * sizeof(half)), 0, 0, 0});
    PipeBarrier<PIPE_ALL>();
}

__aicore__ inline void TinyStoreScaled(LocalTensor<float> z, LocalTensor<float> t,
                                          LocalTensor<float> scale, int col, int32_t sum)
{
    const float value = static_cast<float>(sum) * scale.GetValue(col);
    const float exponent = value * (-1.5957691216057308f - 0.07135481627260025f * value * value);
    z.SetValue(col, value);
    t.SetValue(col, exponent < 80.0f ? exponent : 80.0f);
}
template <int KnownK, int KnownN>
__aicore__ inline void TinyGroupRowChannels(GM_ADDR x, GM_ADDR weight, GM_ADDR scale,
                                     GM_ADDR groupList, GM_ADDR y, int m, int k, int n, int experts)
{
    if constexpr (KnownK > 0) { k = KnownK; }
    if constexpr (KnownN > 0) { n = KnownN; }
    const int row = GetBlockIdx();
    if (row >= m) {
        return;
    }
    GlobalTensor<int64_t> groups;
    groups.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groupList));
    int expert = 0;
    GlobalTensor<int8_t> input, weights;
    GlobalTensor<float> scales;
    GlobalTensor<half> output;
    input.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
    weights.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(weight));
    scales.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scale));
    output.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y));

    LocalTensor<int8_t> storage(TPosition::VECCALC, 0, 608);
    auto a = storage;
    auto b = storage[32];
    auto s = storage[160].ReinterpretCast<float>();
    auto z = storage[288].ReinterpretCast<float>();
    auto t = storage[416].ReinterpretCast<float>();
    auto out = storage[544].ReinterpretCast<half>();

    DataCopyPad(a, input[row * k], DataCopyExtParams{1, static_cast<uint32_t>(k), 0, 0, 0},
                DataCopyPadExtParams<int8_t>{});
    if (experts > 8) {
        int upper = experts;
        while (expert < upper) {
            const int middle = expert + (upper - expert) / 2;
            if (groups.GetValue(middle) <= row) { expert = middle + 1; }
            else { upper = middle; }
        }
    } else {
        while (groups.GetValue(expert) <= row) { ++expert; }
    }
    DataCopyPad(b, weights[expert * k * n], DataCopyExtParams{1, static_cast<uint32_t>(k * n), 0, 0, 0},
                DataCopyPadExtParams<int8_t>{});
    DataCopyPad(s, scales[expert * n], DataCopyExtParams{1, static_cast<uint32_t>(n * sizeof(float)), 0, 0, 0},
                DataCopyPadExtParams<float>{});
    WaitFor<HardEvent::MTE2_S>();
    // Reuse one input load across adjacent output channels. Tail channels
    // follow the same exact INT32 accumulation as complete channel groups.
    int c = 0;
    for (; c + 3 < n; c += 4) {
        int32_t sum0 = 0, sum1 = 0, sum2 = 0, sum3 = 0;
        for (int d = 0; d < k; ++d) {
            const int32_t value = static_cast<int32_t>(a.GetValue(d));
            const int offset = d * n + c;
            sum0 += value * static_cast<int32_t>(b.GetValue(offset));
            sum1 += value * static_cast<int32_t>(b.GetValue(offset + 1));
            sum2 += value * static_cast<int32_t>(b.GetValue(offset + 2));
            sum3 += value * static_cast<int32_t>(b.GetValue(offset + 3));
        }
        TinyStoreScaled(z, t, s, c, sum0);
        TinyStoreScaled(z, t, s, c + 1, sum1);
        TinyStoreScaled(z, t, s, c + 2, sum2);
        TinyStoreScaled(z, t, s, c + 3, sum3);
    }
    for (; c + 1 < n; c += 2) {
        int32_t sum0 = 0, sum1 = 0;
        for (int d = 0; d < k; ++d) {
            const int32_t value = static_cast<int32_t>(a.GetValue(d));
            const int offset = d * n + c;
            sum0 += value * static_cast<int32_t>(b.GetValue(offset));
            sum1 += value * static_cast<int32_t>(b.GetValue(offset + 1));
        }
        TinyStoreScaled(z, t, s, c, sum0);
        TinyStoreScaled(z, t, s, c + 1, sum1);
    }
    if (c < n) {
        int32_t sum = 0;
        for (int d = 0; d < k; ++d) {
            sum += static_cast<int32_t>(a.GetValue(d)) * static_cast<int32_t>(b.GetValue(d * n + c));
        }
        TinyStoreScaled(z, t, s, c, sum);
    }
    WaitFor<HardEvent::S_V>();
    SetVectorMask<float>(0, (uint64_t{1} << n) - 1);
    Exp<float, false>(t, t, uint64_t{0}, uint8_t{1}, UnaryRepeatParams{1, 1, 8, 8});
    PipeBarrier<PIPE_V>();
    Adds<float, false>(t, t, 1.0f, uint64_t{0}, uint8_t{1}, UnaryRepeatParams{1, 1, 8, 8});
    PipeBarrier<PIPE_V>();
    Div<float, false>(z, z, t, uint64_t{0}, uint8_t{1}, BinaryRepeatParams{1, 1, 1, 8, 8, 8});
    PipeBarrier<PIPE_V>();
    Cast<half, float, false>(out, z, RoundMode::CAST_RINT, uint64_t{0}, uint8_t{1}, UnaryRepeatParams{1, 1, 4, 8});
    WaitFor<HardEvent::V_MTE3>();
    DataCopyPad(output[row * n], out, DataCopyExtParams{1, static_cast<uint32_t>(n * sizeof(half)), 0, 0, 0});
    WaitFor<HardEvent::MTE3_S>();
}


}
template <int KnownK, int KnownN>
__global__ GMG_ENTRY_ALIGN(2048,2048) __vector__ void grouped_matmul_gelu_tiny_static(
    GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groupList, GM_ADDR y, int m, int k, int n, int experts)
{
    AscendC::InitSocState();
    TinyGroupRowChannels<KnownK, KnownN>(x, weight, scale, groupList, y, m, k, n, experts);
}

template <int Low, int High, int KnownK>
static void LaunchTinyN(GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR g, GM_ADDR y,
                       int m, int k, int n, int experts, aclrtStream stream)
{
    if constexpr (Low == High) {
        grouped_matmul_gelu_tiny_static<KnownK, Low><<<m,nullptr,stream>>>(x,w,s,g,y,m,k,n,experts);
    } else {
        constexpr int Middle = (Low + High) / 2;
        if (n <= Middle) { LaunchTinyN<Low, Middle, KnownK>(x,w,s,g,y,m,k,n,experts,stream); }
        else { LaunchTinyN<Middle + 1, High, KnownK>(x,w,s,g,y,m,k,n,experts,stream); }
    }
}


__global__ GMG_ENTRY_ALIGN(2048,2048) __vector__ void grouped_matmul_gelu_scalar(
        GM_ADDR x,GM_ADDR weight,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,int m)
    {
        if (AscendC::GetBlockIdx() >= m) { return; }
        AscendC::InitSocState();
        TinyGroupRow(x,weight,scale,groups,y,m,1,1);
    }
    
namespace path_general {
using gmg_common::Min;
using gmg_common::Clear;
using gmg_common::WaitFor;
using gmg_common::GeluTanh;


namespace {
using namespace AscendC;

constexpr int kRows = 128;
constexpr int kCols = 256;
constexpr int kL0SlotBytes = 65536;
constexpr int kPanel = 512;
constexpr int kTileElements = kRows * kCols;
constexpr int kVectorRows = kRows / 2;
constexpr int kVectorElements = kVectorRows * kCols;
constexpr int kReady = 0;
constexpr int kConsumed = 2;
constexpr int kOutputSlots = 2;


template <int TileRows, int TileCols, int Panel, bool Prefetch = false, int L0Buffers = 2>
using CubeTile = gmg_common::DenseCube<TileRows, TileCols, Panel, kTileElements, Prefetch, L0Buffers>;


template <int TileCols>
using VectorTile = gmg_common::VectorTile<TileCols, kVectorElements, 256, false, false, false>;

template <int TileRows, int TileCols, class Worker>
__aicore__ inline void ProcessTiles(Worker& worker, GM_ADDR groupList, GM_ADDR workspace,
                                    int experts, int n, int core)
{
    GlobalTensor<int64_t> groups;
    groups.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groupList), experts);
    GlobalTensor<int32_t> slot;
    slot.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(workspace) + core * kOutputSlots * kTileElements,
                         kOutputSlots * kTileElements);

    const int cores = GetBlockNum();
    const int colTiles = (n + TileCols - 1) / TileCols;
    int start = 0;
    int next = core;
    int bank = 0;
    for (int expert = 0; expert < experts; ++expert) {
        const int end = static_cast<int>(groups.GetValue(expert));
        const int tiles = ((end - start + TileRows - 1) / TileRows) * colTiles;
        for (; next < tiles; next += cores) {
            const int row = start + next / colTiles * TileRows;
            const int col = next % colTiles * TileCols;
            worker.Compute(slot[bank * kTileElements], expert, row, col,
                           Min(end - row, TileRows), Min(n - col, TileCols), bank);
            bank ^= 1;
        }
        next -= tiles;
        start = end;
    }
}
}  // namespace

template <int TileRows, int TileCols, int Panel>
__global__ GMG_ENTRY_ALIGN(4096,2048) __attribute__((aligned(16))) __mix__(1, 2) void grouped_matmul_gelu_custom(
    GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groupList, GM_ADDR y,
    GM_ADDR workspace, int experts, int k, int n)
{
    AscendC::InitSocState();
    if ASCEND_IS_AIC {
        CubeTile<TileRows, TileCols, Panel,false,1> worker;
        worker.Init(x, weight, k, n);
        ProcessTiles<TileRows, TileCols>(worker, groupList, workspace, experts, n, AscendC::GetBlockIdx());
        worker.Finish();
    }
    if ASCEND_IS_AIV {
        VectorTile<TileCols> worker;
        worker.Init(scale, y, n);
        ProcessTiles<TileRows, TileCols>(worker, groupList, workspace, experts, n, AscendC::GetBlockIdx() / 2);
        worker.Finish();
    }
}

}
namespace gmg_dense_stream {
using namespace gmg_common;
__aicore__ __attribute__((section(".gmg_dense_stream"))) inline void GeluNormalBatch(LocalTensor<float>z,LocalTensor<float>t,uint8_t repeats){
 Muls<float,false>(t,z,-0.07135481627260025f,uint64_t{0},repeats,UnaryRepeatParams{1,1,8,8});PipeBarrier<PIPE_V>();
 Mul<float,false>(t,t,z,uint64_t{0},repeats,BinaryRepeatParams{1,1,1,8,8,8});PipeBarrier<PIPE_V>();
 Adds<float,false>(t,t,-1.5957691216057308f,uint64_t{0},repeats,UnaryRepeatParams{1,1,8,8});PipeBarrier<PIPE_V>();
 Mul<float,false>(t,t,z,uint64_t{0},repeats,BinaryRepeatParams{1,1,1,8,8,8});PipeBarrier<PIPE_V>();
 Mins<float,false>(t,t,80.0f,uint64_t{0},repeats,UnaryRepeatParams{1,1,8,8});PipeBarrier<PIPE_V>();
 Exp<float,false>(t,t,uint64_t{0},repeats,UnaryRepeatParams{1,1,8,8});PipeBarrier<PIPE_V>();
 Adds<float,false>(t,t,1.0f,uint64_t{0},repeats,UnaryRepeatParams{1,1,8,8});PipeBarrier<PIPE_V>();
 Div<float,false>(z,z,t,uint64_t{0},repeats,BinaryRepeatParams{1,1,1,8,8,8});PipeBarrier<PIPE_V>();
}
__aicore__ __attribute__((section(".gmg_dense_stream"))) inline void GeluNormalMask(LocalTensor<float>z,LocalTensor<float>t,int count){
 SetMaskNorm();SetVectorMask<float>(0,~uint64_t{0});
 int done=0,full=count/64;
 while(full>0){const int reps=gmg_common::Min(full,255);GeluNormalBatch(z[done],t[done],static_cast<uint8_t>(reps));done+=reps*64;full-=reps;}
 const int tail=count-done;
 if(tail){SetVectorMask<float>(0,(uint64_t{1}<<tail)-1);GeluNormalBatch(z[done],t[done],uint8_t{1});}
 SetVectorMask<float>(0,~uint64_t{0});
}
template <int TileCols, int kVectorElements, int TmpPadding,
          bool CompactAny = false, bool SingleVector = false, bool SpecializeFullTile = false>
class VectorTile {
public:
    __aicore__ __attribute__((section(".gmg_dense_stream"))) inline void SetGroup(int, int) {}
    __aicore__ __attribute__((section(".gmg_dense_stream"))) inline void SetRowEnd(int) {}
    __aicore__ __attribute__((section(".gmg_dense_stream"))) inline void Init(GM_ADDR scale, GM_ADDR y, int n)
    {
        scale_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scale));
        y_.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y));
        n_ = n;
    }

    __aicore__ __attribute__((section(".gmg_dense_stream"))) inline void Compute(const GlobalTensor<int32_t>& result, int expert,
                                   int row, int col, int rows, int cols, int bank)
    {
        if constexpr (SpecializeFullTile) {
            if (rows == 64 && cols == 256) {
                ComputeImpl<64, 256>(result, expert, row, col, 64, 256, bank);
            } else {
                ComputeImpl<0, 0>(result, expert, row, col, rows, cols, bank);
            }
        } else {
            ComputeImpl<0, 0>(result, expert, row, col, rows, cols, bank);
        }
    }

    template <int KnownRows, int KnownCols>
    __aicore__ __attribute__((section(".gmg_dense_stream"))) inline void ComputeImpl(const GlobalTensor<int32_t>& result, int expert,
                                   int row, int col, int rows, int cols, int bank)
    {
        if constexpr (KnownRows) { rows = KnownRows; cols = KnownCols; }
        const int split = SingleVector ? rows : (rows + 1) / 2;
        const int rowOffset = SingleVector ? 0 : GetSubBlockIdx() * split;
        const int ownRows = Min(split, rows - rowOffset);
        if (ownRows > 0) {
            const int pitch = (cols + 31) / 32 * 32;
            const int count = ownRows * pitch;
            // Resource-based streaming for full aligned dense vector slabs.
            // Cross-core ownership still covers the complete Cube output.
            if(!SingleVector && ownRows>=64 && count>kVectorElements/2 && cols==TileCols && n_%TileCols==0 && rows%16==0 && kVectorElements/2/pitch>=32){
                ComputeStreaming(result,expert,row,col,rowOffset,ownRows,cols,bank);
                return;
            }
            constexpr int accBytes = kVectorElements * sizeof(int32_t);
            constexpr int scaleBytes = TileCols * sizeof(float);
            constexpr int outBytes = kVectorElements * sizeof(half);
            const int buffer = scaleSlot_++ & 1;
            const bool compact = count <= kVectorElements / 2 &&
                                 (CompactAny || (cols == TileCols && n_ % TileCols == 0 && rows % 16 == 0));
            const bool overlap = compact && previousCompact_;
            LocalTensor<int32_t> acc(TPosition::VECCALC,
                                     compact ? buffer * accBytes / 2 : 0,
                                     compact ? kVectorElements / 2 : kVectorElements);
            LocalTensor<float> scales(TPosition::VECCALC, accBytes + buffer * scaleBytes, TileCols);
            const int outOffset = accBytes + 2 * scaleBytes + (compact ? buffer * outBytes / 2 : 0);
            LocalTensor<half> out(TPosition::VECCALC, outOffset,
                                  compact ? kVectorElements / 2 : kVectorElements);
            auto z = acc.ReinterpretCast<float>();
            LocalTensor<float> t(TPosition::VECCALC, accBytes + 2 * scaleBytes + outBytes + TmpPadding + (((accBytes + 2 * scaleBytes + outBytes + TmpPadding) % 512 == 0) ? 256 : 0), kVectorElements);

            if ((cols & 7) == 0 && (n_ & 7) == 0) {
                DataCopy(scales, scale_[expert * n_ + col], cols);
            } else {
                DataCopyExtParams scaleCopy{1, static_cast<uint32_t>(cols * sizeof(float)), 0, 0, 0};
                DataCopyPad(scales, scale_[expert * n_ + col], scaleCopy, DataCopyPadExtParams<float>{});
            }
            if (outputPending_ && !overlap) {
                WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
            }
            CrossCoreWaitFlag<0x2>(kReady + bank);
            DataCopy(acc, result[rowOffset * pitch], count);
            // Release the Cube's slot once the last read finishes.
            CrossCoreSetFlag<0x2, PIPE_MTE2>(kConsumed + bank);
            if (overlap) {
                WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
            }
            SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
            WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);

            Cast(z, acc, RoundMode::CAST_NONE, count);
            PipeBarrier<PIPE_V>();
            // Each repeat handles 64 channels and shares the scale across rows.
            for (int c = 0; c < cols; c += 64) {
                Mul(z[c], z[c], scales[c], static_cast<uint64_t>(Min(64, cols - c)),
                    ownRows, BinaryRepeatParams{1, 1, 1, static_cast<uint8_t>(pitch / 8), static_cast<uint8_t>(pitch / 8), 0});
            }
            PipeBarrier<PIPE_V>();

            GeluTanh(z, t, count);
            if (outputPending_ && !overlap) {
                WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
            }
            Cast(out, z, RoundMode::CAST_RINT, count);
            if (overlap) {
                WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
            }
            SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
            SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
            WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);

            DataCopyExtParams outCopy{
                static_cast<uint16_t>(ownRows),
                static_cast<uint32_t>(cols * sizeof(half)),
                static_cast<uint32_t>((pitch - (cols + 15) / 16 * 16) * sizeof(half) / 32),
                static_cast<uint32_t>((n_ - cols) * sizeof(half)),
                0};
            DataCopyPad(y_[(row + rowOffset) * n_ + col], out, outCopy);
            SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
            outputPending_ = true;
            previousCompact_ = compact;
        } else {
            CrossCoreWaitFlag<0x2>(kReady + bank);
            CrossCoreSetFlag<0x2, PIPE_MTE2>(kConsumed + bank);
        }
    }

    __aicore__ __attribute__((section(".gmg_dense_stream"))) inline void ComputeStreaming(const GlobalTensor<int32_t>& result,int expert,int row,int col,
                                            int rowOffset,int ownRows,int cols,int bank)
    {
        const int pitch=(cols+31)/32*32;
        const int maxRows=kVectorElements/2/pitch;
        constexpr int accBytes=kVectorElements*sizeof(int32_t),scaleBytes=TileCols*sizeof(float),outBytes=kVectorElements*sizeof(half);
        for(int done=0;done<ownRows;done+=maxRows){
            const int take=Min(maxRows,ownRows-done),count=take*pitch;
            const int buffer=scaleSlot_++&1;
            const bool overlap=previousCompact_;
            LocalTensor<int32_t>acc(TPosition::VECCALC,buffer*accBytes/2,kVectorElements/2);
            LocalTensor<float>scales(TPosition::VECCALC,accBytes+buffer*scaleBytes,TileCols);
            LocalTensor<half>out(TPosition::VECCALC,accBytes+2*scaleBytes+buffer*outBytes/2,kVectorElements/2);
            LocalTensor<float>t(TPosition::VECCALC,accBytes+2*scaleBytes+outBytes+TmpPadding+(((accBytes+2*scaleBytes+outBytes+TmpPadding)%512==0)?256:0),kVectorElements);
            auto z=acc.ReinterpretCast<float>();
            if((cols&7)==0 && (n_&7)==0)DataCopy(scales,scale_[expert*n_+col],cols);
            else DataCopyPad(scales,scale_[expert*n_+col],DataCopyExtParams{1,static_cast<uint32_t>(cols*sizeof(float)),0,0,0},DataCopyPadExtParams<float>{});
            if(outputPending_ && !overlap)WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
            if(done==0)CrossCoreWaitFlag<0x2>(kReady+bank);
            DataCopy(acc,result[(rowOffset+done)*pitch],count);
            // One Consumed acknowledgement per original Cube tile, only after
            // its final GM fragment read; never release on the first fragment.
            if(done+take==ownRows)CrossCoreSetFlag<0x2,PIPE_MTE2>(kConsumed+bank);
            if(overlap)WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
            SetFlag<HardEvent::MTE2_V>(EVENT_ID0);WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
            Cast(z,acc,RoundMode::CAST_NONE,count);PipeBarrier<PIPE_V>();
            for(int c=0;c<cols;c+=64)Mul(z[c],z[c],scales[c],static_cast<uint64_t>(Min(64,cols-c)),take,
                BinaryRepeatParams{1,1,1,static_cast<uint8_t>(pitch/8),static_cast<uint8_t>(pitch/8),0});
            PipeBarrier<PIPE_V>();GeluNormalMask(z,t,count);
            if(outputPending_ && !overlap)WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
            Cast(out,z,RoundMode::CAST_RINT,count);
            if(overlap)WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
            SetFlag<HardEvent::V_MTE2>(EVENT_ID0);SetFlag<HardEvent::V_MTE3>(EVENT_ID0);WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
            DataCopyExtParams cp{static_cast<uint16_t>(take),static_cast<uint32_t>(cols*sizeof(half)),
                static_cast<uint32_t>((pitch-(cols+15)/16*16)*sizeof(half)/32),static_cast<uint32_t>((n_-cols)*sizeof(half)),0};
            DataCopyPad(y_[(row+rowOffset+done)*n_+col],out,cp);
            SetFlag<HardEvent::MTE3_V>(EVENT_ID0);outputPending_=true;previousCompact_=true;
        }
    }

    __aicore__ __attribute__((section(".gmg_dense_stream"))) inline void Finish()
    {
        if (outputPending_) {
            WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
            WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
        }
    }

private:
    int scaleSlot_ = 0;
    bool previousCompact_ = false;
    bool outputPending_ = false;
    GlobalTensor<float> scale_;
    GlobalTensor<half> y_;
    int n_;
};

}

// Independent launch entries for the dense geometry classes. The device workers
// are shared with the general implementation; each entry can be tuned separately.
namespace path_general {
using gmg_common::Min;
using gmg_common::Clear;
using gmg_common::WaitFor;
using gmg_common::GeluTanh;

template <int TileRows, int TileCols, int Panel,int CopyBytes=0,bool PrefetchK=false,int L0Buffers=2>
__aicore__ inline void RunDensePath(
    GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groupList, GM_ADDR y,
    GM_ADDR workspace, int experts, int k, int n)
{
    if ASCEND_IS_AIC {
        CubeTile<TileRows, TileCols, Panel,PrefetchK,L0Buffers> worker;
        worker.Init(x, weight, k, n);
        if constexpr(CopyBytes){worker.OverrideWeightCopy(CopyBytes);}
        ProcessTiles<TileRows, TileCols>(worker, groupList, workspace, experts, n, AscendC::GetBlockIdx());
        worker.Finish();
    }
    if ASCEND_IS_AIV {
        VectorTile<TileCols> worker;
        worker.Init(scale, y, n);
        ProcessTiles<TileRows, TileCols>(worker, groupList, workspace, experts, n, AscendC::GetBlockIdx() / 2);
        worker.Finish();
    }
}
}

#define GMG_DEFINE_DENSE_PATH(PathName,CopyBytes,PrefetchK,CubeAlign,VectorAlign,L0Buffers) \
namespace PathName { \
template <int TileRows, int TileCols, int Panel> \
__global__ GMG_ENTRY_ALIGN(CubeAlign,VectorAlign) __attribute__((aligned(256))) __mix__(1, 2) void grouped_matmul_gelu_custom( \
    GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groupList, GM_ADDR y, \
    GM_ADDR workspace, int experts, int k, int n) \
{ \
    AscendC::InitSocState(); \
    path_general::RunDensePath<TileRows, TileCols, Panel,CopyBytes,PrefetchK,L0Buffers>( \
        x, weight, scale, groupList, y, workspace, experts, k, n); \
} \
}
GMG_DEFINE_DENSE_PATH(path_general_deep,0,false,4096,2048,2)

GMG_DEFINE_DENSE_PATH(path_general_tall,0,false,16384,16384,2)
GMG_DEFINE_DENSE_PATH(path_general_shortk,0,false,16384,16384,2)
GMG_DEFINE_DENSE_PATH(path_general_grouped,4,true,16384,16384,2)
#undef GMG_DEFINE_DENSE_PATH

// Aligned expert groups choose their tile geometry from device group boundaries.
namespace path_general_aligned {
using gmg_common::Min;
using gmg_common::Clear;
using gmg_common::WaitFor;
using gmg_common::GeluTanh;


namespace {
using namespace AscendC;

constexpr int kRows = 128;
constexpr int kCols = 256;
constexpr int kL0SlotBytes = 65536;
constexpr int kPanel = 512;
constexpr int kTileElements = kRows * kCols;
constexpr int kVectorRows = kRows / 2;
constexpr int kVectorElements = kVectorRows * kCols;
constexpr int kReady = 0;
constexpr int kConsumed = 2;
constexpr int kOutputSlots = 2;


template <int TileRows, int TileCols, int Panel>
class CubeTile {
public:
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR weight, int k, int n)
    {
        x_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
        weight_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(weight));
        weightBase_ = weight;
        k_ = k;
        n_ = n;
        panelStart_ = GetBlockIdx() % ((k + Panel - 1) / Panel) * Panel;
        packBytes_ = n <= 2047 ? 1 : n % 4 == 0 ? 4 : n % 2 == 0 ? 2 : 0;
        SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);
        SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID1);
        SetFlag<HardEvent::M_MTE1>(EVENT_ID0);
        SetFlag<HardEvent::M_MTE1>(EVENT_ID1);
    }

    __aicore__ inline void Compute(const GlobalTensor<int32_t>& result, int expert,
                                   int row, int col, int rows, int cols, int bank)
    {
        const int alignedRows = (rows + 15) / 16 * 16;
        const bool gemv = rows == 1;
        const int alignedCols = (cols + 31) / 32 * 32;
        const int area = alignedRows * alignedCols;
        const bool large = area > kTileElements / 2;
        const int offset = large ? 0 : bank * kTileElements / 2;
        const auto matrixEvent = static_cast<TEventID>(bank);
        LocalTensor<int32_t> c(TPosition::CO1, offset * sizeof(int32_t), area);
        const int sliceLimit = Min(kL0SlotBytes / 2 / alignedRows, kL0SlotBytes / 2 / alignedCols) / 32 * 32;
        const int panelDepth=cols<=256?512:384;
        int kk=GetBlockIdx()%((k_+panelDepth-1)/panelDepth)*panelDepth;
        int panelSlot = panelIndex_ & 1;
        PrefetchPanel(panelSlot, expert, row, col, rows, cols, kk, alignedRows, alignedCols);
        for (int done = 0; done < k_; done += panelDepth) {
            const int depth = Min(k_ - kk, panelDepth);
            const int alignedDepth = (depth + 31) / 32 * 32;
            const int nextK = kk + panelDepth < k_ ? kk + panelDepth : 0;
            if (done + panelDepth < k_) {
                PrefetchPanel(panelSlot ^ 1, expert, row, col, rows, cols, nextK, alignedRows, alignedCols);
            }
            LocalTensor<int8_t> a1(TPosition::A1, panelSlot * 65536, 65536);
            LocalTensor<int8_t> b1(TPosition::B1, 131072 + panelSlot * 196608,
                                  196608);
            WaitFlag<HardEvent::MTE2_MTE1>(static_cast<TEventID>(panelSlot));

            for (int off = 0; off < alignedDepth; off += sliceLimit) {
                const int slice = Min(alignedDepth - off, sliceLimit);
                const auto l0slot=static_cast<TEventID>(l0Index_++ & 1);
                LocalTensor<int8_t> a2(TPosition::A2, static_cast<int>(l0slot)*kL0SlotBytes/2, kL0SlotBytes/2);
                LocalTensor<int8_t> b2(TPosition::B2, static_cast<int>(l0slot)*kL0SlotBytes/2, kL0SlotBytes/2);
                WaitFlag<HardEvent::M_MTE1>(l0slot);
                LoadSlice(a2, b2, a1, b1, off, slice, alignedRows, alignedCols, alignedDepth, gemv);
                if (off + slice == alignedDepth) {
                    SetFlag<HardEvent::MTE1_MTE2>(static_cast<TEventID>(panelSlot));
                }
                SetFlag<HardEvent::MTE1_M>(l0slot);
                WaitFlag<HardEvent::MTE1_M>(l0slot);

                const bool first = done == 0 && off == 0;
                if (first) {
                    WaitForMatrix(large || lastLarge_ ? 3 : 1 << bank);
                }
                MmadParams mm{};
                mm.m = gemv ? 1 : alignedRows;
                mm.n = alignedCols;
                mm.k = slice;
                mm.cmatrixInitVal = first;
                Mmad(c, a2, b2, mm);
                SetFlag<HardEvent::M_MTE1>(l0slot);
            }
            // Start each core at a different K panel to spread GM requests.
            kk = nextK;
            panelSlot ^= 1;
            ++panelIndex_;
        }

        SetFlag<HardEvent::M_FIX>(matrixEvent);
        WaitFlag<HardEvent::M_FIX>(matrixEvent);
        if ((produced_ & (1 << bank)) != 0) {
            CrossCoreWaitFlag<0x2>(kConsumed + bank);
        }
        FixpipeParamsV220 store{};
        store.mSize = rows;
        store.nSize = alignedCols;
        store.srcStride = alignedRows;
        store.dstStride = alignedCols;
        store.ndNum = 1;
        Fixpipe<int32_t, int32_t, CFG_ROW_MAJOR>(result, c, store);
        SetFlag<HardEvent::FIX_M>(matrixEvent);
        matrixPending_ |= 1 << bank;
        lastLarge_ = large;
        CrossCoreSetFlag<0x2, PIPE_FIX>(kReady + bank);
        produced_ |= 1 << bank;
    }

    __aicore__ inline void Finish()
    {
        for (int slot = 0; slot < 2; ++slot) {
            if ((produced_ & (1 << slot)) != 0) {
                CrossCoreWaitFlag<0x2>(kConsumed + slot);
            }
            WaitFlag<HardEvent::MTE1_MTE2>(static_cast<TEventID>(slot));
        }
        WaitFlag<HardEvent::M_MTE1>(EVENT_ID0);
        WaitFlag<HardEvent::M_MTE1>(EVENT_ID1);
        WaitForMatrix(3);
    }

private:
    __aicore__ inline void WaitForMatrix(int overlap)
    {
        const int ready = matrixPending_ & overlap;
        if ((ready & 1) != 0) {
            WaitFlag<HardEvent::FIX_M>(EVENT_ID0);
        }
        if ((ready & 2) != 0) {
            WaitFlag<HardEvent::FIX_M>(EVENT_ID1);
        }
        matrixPending_ &= ~overlap;
    }

__aicore__ inline void PrefetchPanel(int slot, int expert, int row, int col,
                                        int rows, int cols, int kk, int alignedRows, int alignedCols)
    {
        LocalTensor<int8_t> a1(TPosition::A1, slot * 65536, 65536);
        LocalTensor<int8_t> b1(TPosition::B1, 131072 + slot * 196608, 196608);
        const int panelDepth=cols<=256?512:384;
        const int depth = Min(k_ - kk, panelDepth);
        const int alignedDepth = (depth + 31) / 32 * 32;
        const auto event = static_cast<TEventID>(slot);
        WaitFlag<HardEvent::MTE1_MTE2>(event);
        LoadPanel(a1, b1, expert, row, col, rows, cols, kk, depth, alignedRows, alignedCols, alignedDepth);
        SetFlag<HardEvent::MTE2_MTE1>(event);
    }

    __aicore__ inline void LoadPanel(LocalTensor<int8_t> a1, LocalTensor<int8_t> b1,
                                     int expert, int row, int col, int rows, int cols,
                                     int kk, int depth, int alignedRows, int alignedCols, int alignedDepth)
    {
        // ND2NZ pads each K chunk of A and each N chunk of B. Fill only
        // the remaining row gaps in the destination fractals.
        if (rows != 1 && rows != alignedRows) {
            Clear(a1[rows * 32], alignedDepth / 32, alignedRows - rows, rows);
        }
        Nd2NzParams aCopy{};
        aCopy.ndNum = 1;
        aCopy.nValue = rows;
        aCopy.dValue = depth;
        aCopy.srcDValue = k_;
        aCopy.dstNzC0Stride = rows == 1 ? 1 : alignedRows;
        aCopy.dstNzNStride = 1;
        DataCopy(a1, x_[row * k_ + kk], aCopy);

        const int offset = (expert * k_ + kk) * n_ + col;
        switch (packBytes_) {
            case 1:
                LoadPackedWeight<int8_t>(b1, offset, depth, cols, alignedCols);
                break;
            case 2:
                LoadPackedWeight<int16_t>(b1, offset, depth, cols, alignedCols);
                break;
            case 4:
                LoadPackedWeight<int32_t>(b1, offset, depth, cols, alignedCols);
                break;
            default: {
                if (depth != alignedDepth) {
                    Clear(b1[depth * 32], alignedCols / 32, alignedDepth - depth, depth);
                }
                Nd2NzParams bCopy{};
                bCopy.ndNum = 1;
                bCopy.nValue = depth;
                bCopy.dValue = cols;
                bCopy.srcDValue = n_;
                bCopy.dstNzC0Stride = alignedDepth;
                bCopy.dstNzNStride = 1;
                DataCopy(b1, weight_[offset], bCopy);
                break;
            }
        }
    }

    template <class CopyT>
    __aicore__ inline void LoadPackedWeight(LocalTensor<int8_t> b1, int offset,
                                           int depth, int cols, int alignedCols)
    {
        gmg_common::LoadPackedWeight<CopyT>(b1, weightBase_, n_,
                                               offset, depth, cols, alignedCols);
    }

    __aicore__ inline void LoadSlice(LocalTensor<int8_t> a2, LocalTensor<int8_t> b2,
                                     LocalTensor<int8_t> a1, LocalTensor<int8_t> b1,
                                     int off, int slice, int alignedRows, int alignedCols, int alignedDepth, bool gemv)
    {
        if (alignedRows == 16) {
            LoadData2DParams loadA{};
            loadA.repeatTimes = gemv ? (slice + 511) / 512 : slice / 32;
            loadA.srcStride = 1;
            // GEMV reads its one row contiguously from L0A.
            LoadData(a2, a1[gemv ? off : off * alignedRows], loadA);
        } else {
            LoadData3DParamsV2<int8_t> loadA{};
            loadA.l1H = 1;
            loadA.l1W = alignedRows;
            loadA.channelSize = alignedDepth;
            loadA.kExtension = slice;
            loadA.mExtension = alignedRows;
            loadA.kStartPt = off;
            LoadData(a2, a1, loadA);
        }

        LoadData2dTransposeParams loadB{};
        if (packBytes_ != 0) {
            loadB.repeatTimes = (slice / 32) * (alignedCols / 32);
            loadB.srcStride = 1;
            loadB.dstGap = 1;
            LoadDataWithTranspose(b2, b1[off * alignedCols], loadB);
        } else if (alignedCols <= slice) {
            loadB.repeatTimes = slice / 32;
            loadB.srcStride = 1;
            loadB.dstGap = alignedCols / 16 - 1;
            for (int c = 0; c < alignedCols; c += 32) {
                LoadDataWithTranspose(b2[c * 32], b1[c * alignedDepth + off * 32], loadB);
            }
        } else {
            loadB.repeatTimes = alignedCols / 32;
            loadB.srcStride = alignedDepth / 32;
            loadB.dstGap = 1;
            for (int kk = 0; kk < slice; kk += 32) {
                LoadDataWithTranspose(b2[kk * alignedCols], b1[(off + kk) * 32], loadB);
            }
        }
    }


    GlobalTensor<int8_t> x_, weight_;
    GM_ADDR weightBase_;
    int k_, n_, packBytes_, panelStart_;
    int produced_ = 0;
    int matrixPending_ = 0;
    bool lastLarge_ = false;
    int panelIndex_ = 0;
    int l0Index_ = 0;
};


template <int TileCols>
using VectorTile = gmg_common::VectorTile<TileCols, kVectorElements, 256, false, false, false>;

template <int TileRows, int TileCols, class Worker>
__aicore__ inline void ProcessTiles(Worker& worker, GM_ADDR groupList, GM_ADDR workspace,
                                    int experts, int n, int core)
{
    GlobalTensor<int64_t> groups;
    groups.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groupList),experts);
    GlobalTensor<int32_t> slot;
    slot.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(workspace)+core*kOutputSlots*kTileElements,kOutputSlots*kTileElements);
    const int cores=GetBlockNum();
    int start=0,next=core,bank=0;
    for(int expert=0;expert<experts;++expert) {
        const int end=static_cast<int>(groups.GetValue(expert));
        const int rowTile=end-start<=32?64:128;
        const int colTile=end-start<=32?512:256;
        const int colTiles=(n+colTile-1)/colTile;
        const int tasks=((end-start+rowTile-1)/rowTile)*colTiles;
        for(;next<tasks;next+=cores) {
            const int row=start+next/colTiles*rowTile,col=next%colTiles*colTile;
            worker.Compute(slot[bank*kTileElements],expert,row,col,Min(end-row,rowTile),Min(n-col,colTile),bank);
            bank^=1;
        }
        next-=tasks;start=end;
    }
}

}  // namespace

template <int TileRows, int TileCols, int Panel>
__global__ GMG_ENTRY_ALIGN(8192,2048) __mix__(1, 2) void grouped_matmul_gelu_custom(
    GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groupList, GM_ADDR y,
    GM_ADDR workspace, int experts, int k, int n)
{
    AscendC::InitSocState();
    if constexpr (TileCols == 256) {
        path_general::RunDensePath<TileRows, TileCols, Panel>(
            x, weight, scale, groupList, y, workspace, experts, k, n);
    } else {
    if ASCEND_IS_AIC {
        CubeTile<TileRows, TileCols, Panel> worker;
        worker.Init(x, weight, k, n);
        ProcessTiles<TileRows, TileCols>(worker, groupList, workspace, experts, n, AscendC::GetBlockIdx());
        worker.Finish();
    }
    if ASCEND_IS_AIV {
        VectorTile<TileCols> worker;
        worker.Init(scale, y, n);
        ProcessTiles<TileRows, TileCols>(worker, groupList, workspace, experts, n, AscendC::GetBlockIdx() / 2);
        worker.Finish();
    }
    }
}


}

namespace path_many_small {
using gmg_common::Min;
using gmg_common::Clear;
using gmg_common::WaitFor;
using gmg_common::GeluTanh;


namespace {
using namespace AscendC;

constexpr int kRows = 128;
constexpr int kCols = 256;
constexpr int kL0SlotBytes = 65536;
constexpr int kPanel = 1088;
constexpr int kTileElements = kRows * kCols;
constexpr int kVectorRows = kRows / 2;
constexpr int kVectorElements = kVectorRows * kCols;
constexpr int kReady = 0;
constexpr int kConsumed = 2;
constexpr int kOutputSlots = 2;


template <int TileRows, int TileCols, int Panel>
class CubeTile {
public:
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR weight, int k, int n)
    {
        x_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
        weight_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(weight));
        weightBase_ = weight;
        k_ = k;
        n_ = n;
        panelStart_ = GetBlockIdx() % ((k + Panel - 1) / Panel) * Panel;
        packBytes_ = n <= 2047 ? 1 : n % 4 == 0 ? 4 : n % 2 == 0 ? 2 : 0;
        SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);
        SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID1);
        SetFlag<HardEvent::M_MTE1>(EVENT_ID0);
    }

    __aicore__ inline void Compute(const GlobalTensor<int32_t>& result, int expert,
                                   int row, int col, int rows, int cols, int bank)
    {
        const int alignedRows = (rows + 15) / 16 * 16;
        const bool gemv = rows == 1;
        const int alignedCols = (cols + 31) / 32 * 32;
        const int area = alignedRows * alignedCols;
        const bool large = area > kTileElements / 2;
        const int offset = large ? 0 : bank * kTileElements / 2;
        const auto matrixEvent = static_cast<TEventID>(bank);
        LocalTensor<int32_t> c(TPosition::CO1, offset * sizeof(int32_t), area);
        const int sliceLimit = Min(kL0SlotBytes / alignedRows, kL0SlotBytes / alignedCols) / 32 * 32;
        int kk = panelStart_;
        for (int done = 0; done < k_; done += Panel) {
            const int depth = Min(k_ - kk, Panel);
            const int alignedDepth = (depth + 31) / 32 * 32;
            const int panelSlot = 0;
            LocalTensor<int8_t> a1(TPosition::A1, panelSlot * TileRows * Panel, TileRows * Panel);
            LocalTensor<int8_t> b1(TPosition::B1, TileRows * Panel,
                                  Panel * TileCols);

            WaitFlag<HardEvent::MTE1_MTE2>(static_cast<TEventID>(panelSlot));
            LoadPanel(a1, b1, expert, row, col, rows, cols, kk, depth, alignedRows, alignedCols, alignedDepth,
                      expert == lastExpert_ && col == lastCol_);
            lastExpert_ = expert; lastCol_ = col;
            SetFlag<HardEvent::MTE2_MTE1>(static_cast<TEventID>(panelSlot));
            WaitFlag<HardEvent::MTE2_MTE1>(static_cast<TEventID>(panelSlot));

            for (int off = 0; off < alignedDepth; off += sliceLimit) {
                const int slice = Min(alignedDepth - off, sliceLimit);
                LocalTensor<int8_t> a2(TPosition::A2, 0, kL0SlotBytes);
                LocalTensor<int8_t> b2(TPosition::B2, 0, kL0SlotBytes);
                WaitFlag<HardEvent::M_MTE1>(EVENT_ID0);
                LoadSlice(a2, b2, a1, b1, off, slice, alignedRows, alignedCols, alignedDepth, gemv);
                if (off + slice == alignedDepth) {
                    SetFlag<HardEvent::MTE1_MTE2>(static_cast<TEventID>(panelSlot));
                }
                SetFlag<HardEvent::MTE1_M>(EVENT_ID0);
                WaitFlag<HardEvent::MTE1_M>(EVENT_ID0);

                const bool first = done == 0 && off == 0;
                if (first) {
                    WaitForMatrix(large || lastLarge_ ? 3 : 1 << bank);
                }
                MmadParams mm{};
                mm.m = gemv ? 1 : alignedRows;
                mm.n = alignedCols;
                mm.k = slice;
                mm.cmatrixInitVal = first;
                Mmad(c, a2, b2, mm);
                SetFlag<HardEvent::M_MTE1>(EVENT_ID0);
            }
            // Start each core at a different K panel to spread GM requests.
            kk = kk + Panel < k_ ? kk + Panel : 0;
        }

        SetFlag<HardEvent::M_FIX>(matrixEvent);
        WaitFlag<HardEvent::M_FIX>(matrixEvent);
        if ((produced_ & (1 << bank)) != 0) {
            CrossCoreWaitFlag<0x2>(kConsumed + bank);
        }
        FixpipeParamsV220 store{};
        store.mSize = rows;
        store.nSize = alignedCols;
        store.srcStride = alignedRows;
        store.dstStride = alignedCols;
        store.ndNum = 1;
        Fixpipe<int32_t, int32_t, CFG_ROW_MAJOR>(result, c, store);
        SetFlag<HardEvent::FIX_M>(matrixEvent);
        matrixPending_ |= 1 << bank;
        lastLarge_ = large;
        CrossCoreSetFlag<0x2, PIPE_FIX>(kReady + bank);
        produced_ |= 1 << bank;
    }

    __aicore__ inline void Finish()
    {
        for (int slot = 0; slot < 2; ++slot) {
            if ((produced_ & (1 << slot)) != 0) {
                CrossCoreWaitFlag<0x2>(kConsumed + slot);
            }
            WaitFlag<HardEvent::MTE1_MTE2>(static_cast<TEventID>(slot));
        }
        WaitFlag<HardEvent::M_MTE1>(EVENT_ID0);
        WaitForMatrix(3);
    }

private:
    __aicore__ inline void WaitForMatrix(int overlap)
    {
        const int ready = matrixPending_ & overlap;
        if ((ready & 1) != 0) {
            WaitFlag<HardEvent::FIX_M>(EVENT_ID0);
        }
        if ((ready & 2) != 0) {
            WaitFlag<HardEvent::FIX_M>(EVENT_ID1);
        }
        matrixPending_ &= ~overlap;
    }

    __aicore__ inline void LoadPanel(LocalTensor<int8_t> a1, LocalTensor<int8_t> b1,
                                     int expert, int row, int col, int rows, int cols,
                                     int kk, int depth, int alignedRows, int alignedCols, int alignedDepth, bool reuse)
    {
        // ND2NZ pads each K chunk of A and each N chunk of B. Fill only
        // the remaining row gaps in the destination fractals.
        if (rows != 1 && rows != alignedRows) {
            Clear(a1[rows * 32], alignedDepth / 32, alignedRows - rows, rows);
        }
        Nd2NzParams aCopy{};
        aCopy.ndNum = 1;
        aCopy.nValue = rows;
        aCopy.dValue = depth;
        aCopy.srcDValue = k_;
        aCopy.dstNzC0Stride = rows == 1 ? 1 : alignedRows;
        aCopy.dstNzNStride = 1;
        DataCopy(a1, x_[row * k_ + kk], aCopy);

        if (reuse) { return; }
        const int offset = (expert * k_ + kk) * n_ + col;
        switch (packBytes_) {
            case 1:
                LoadPackedWeight<int8_t>(b1, offset, depth, cols, alignedCols);
                break;
            case 2:
                LoadPackedWeight<int16_t>(b1, offset, depth, cols, alignedCols);
                break;
            case 4:
                LoadPackedWeight<int32_t>(b1, offset, depth, cols, alignedCols);
                break;
            default: {
                if (depth != alignedDepth) {
                    Clear(b1[depth * 32], alignedCols / 32, alignedDepth - depth, depth);
                }
                Nd2NzParams bCopy{};
                bCopy.ndNum = 1;
                bCopy.nValue = depth;
                bCopy.dValue = cols;
                bCopy.srcDValue = n_;
                bCopy.dstNzC0Stride = alignedDepth;
                bCopy.dstNzNStride = 1;
                DataCopy(b1, weight_[offset], bCopy);
                break;
            }
        }
    }

    template <class CopyT>
    __aicore__ inline void LoadPackedWeight(LocalTensor<int8_t> b1, int offset,
                                           int depth, int cols, int alignedCols)
    {
        gmg_common::LoadPackedWeight<CopyT>(b1, weightBase_, n_,
                                               offset, depth, cols, alignedCols);
    }

    __aicore__ inline void LoadSlice(LocalTensor<int8_t> a2, LocalTensor<int8_t> b2,
                                     LocalTensor<int8_t> a1, LocalTensor<int8_t> b1,
                                     int off, int slice, int alignedRows, int alignedCols, int alignedDepth, bool gemv)
    {
        if (alignedRows == 16) {
            LoadData2DParams loadA{};
            loadA.repeatTimes = gemv ? (slice + 511) / 512 : slice / 32;
            loadA.srcStride = 1;
            // GEMV reads its one row contiguously from L0A.
            LoadData(a2, a1[gemv ? off : off * alignedRows], loadA);
        } else {
            LoadData3DParamsV2<int8_t> loadA{};
            loadA.l1H = 1;
            loadA.l1W = alignedRows;
            loadA.channelSize = alignedDepth;
            loadA.kExtension = slice;
            loadA.mExtension = alignedRows;
            loadA.kStartPt = off;
            LoadData(a2, a1, loadA);
        }

        LoadData2dTransposeParams loadB{};
        if (packBytes_ != 0) {
            loadB.repeatTimes = (slice / 32) * (alignedCols / 32);
            loadB.srcStride = 1;
            loadB.dstGap = 1;
            LoadDataWithTranspose(b2, b1[off * alignedCols], loadB);
        } else if (alignedCols <= slice) {
            loadB.repeatTimes = slice / 32;
            loadB.srcStride = 1;
            loadB.dstGap = alignedCols / 16 - 1;
            for (int c = 0; c < alignedCols; c += 32) {
                LoadDataWithTranspose(b2[c * 32], b1[c * alignedDepth + off * 32], loadB);
            }
        } else {
            loadB.repeatTimes = alignedCols / 32;
            loadB.srcStride = alignedDepth / 32;
            loadB.dstGap = 1;
            for (int kk = 0; kk < slice; kk += 32) {
                LoadDataWithTranspose(b2[kk * alignedCols], b1[(off + kk) * 32], loadB);
            }
        }
    }


    GlobalTensor<int8_t> x_, weight_;
    GM_ADDR weightBase_;
    int k_, n_, packBytes_, panelStart_;
    int produced_ = 0;
    int matrixPending_ = 0;
    bool lastLarge_ = false;
    int panelIndex_ = 0;
    int lastExpert_ = -1, lastCol_ = -1;
};


template <int TileCols>
using VectorTile = gmg_common::VectorTile<TileCols, kVectorElements, 0, false, false, false>;

template <int TileRows, int TileCols, class Worker>
__aicore__ inline void ProcessTiles(Worker& worker, GM_ADDR groupList, GM_ADDR workspace,
                                    int experts, int n, int core)
{
    GlobalTensor<int64_t> groups;
    groups.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groupList), experts);
    GlobalTensor<int32_t> slot;
    slot.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(workspace) + core * kOutputSlots * kTileElements,
                         kOutputSlots * kTileElements);

    const int cores = GetBlockNum();
    const int colTiles = (n + TileCols - 1) / TileCols;
    int bank = 0;
    for (int job = core; job < experts * colTiles; job += cores) {
        const int expert = job / colTiles;
        const int col = job % colTiles * TileCols;
        const int start = expert == 0 ? 0 : static_cast<int>(groups.GetValue(expert - 1));
        const int end = static_cast<int>(groups.GetValue(expert));
        for (int row = start; row < end; row += TileRows) {
            worker.Compute(slot[bank * kTileElements], expert, row, col,
                           Min(end - row, TileRows), Min(n - col, TileCols), bank);
            bank ^= 1;
        }
    }
}
}  // namespace

template <int TileRows, int TileCols, int Panel>
__global__ GMG_ENTRY_ALIGN(4096,2048) __mix__(1, 2) void grouped_matmul_gelu_custom(
    GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groupList, GM_ADDR y,
    GM_ADDR workspace, int experts, int k, int n)
{
    AscendC::InitSocState();
    if ASCEND_IS_AIC {
        CubeTile<TileRows, TileCols, Panel> worker;
        worker.Init(x, weight, k, n);
        ProcessTiles<TileRows, TileCols>(worker, groupList, workspace, experts, n, AscendC::GetBlockIdx());
        worker.Finish();
    }
    if ASCEND_IS_AIV {
        VectorTile<TileCols> worker;
        worker.Init(scale, y, n);
        ProcessTiles<TileRows, TileCols>(worker, groupList, workspace, experts, n, AscendC::GetBlockIdx() / 2);
        worker.Finish();
    }
}

}
namespace path_packed_rows {
using gmg_common::Min;
using gmg_common::Clear;
using gmg_common::WaitFor;
using gmg_common::GeluTanh;


namespace {
using namespace AscendC;

constexpr int kRows = 128;
constexpr int kCols = 256;
constexpr int kL0SlotBytes = 65536;
constexpr int kPanel = 512;
constexpr int kTileElements = kRows * kCols;
constexpr int kVectorRows = kRows / 2;
constexpr int kVectorElements = kVectorRows * kCols;
constexpr int kReady = 0;
constexpr int kConsumed = 2;
constexpr int kOutputSlots = 2;


template <int TileRows, int TileCols, int Panel>
class CubeResident {
public:
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR weight, int k, int n, bool padded)
    {
        x_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
        weight_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(weight));
        weightBase_ = weight;
        k_ = k;
        n_ = padded ? (n+31)/32*32 : n;
        panelStart_ = GetBlockIdx() % ((k + Panel - 1) / Panel) * Panel;
        packBytes_ = padded ? 4 : n <= 2047 ? 1 : n % 4 == 0 ? 4 : n % 2 == 0 ? 2 : 0;
        SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID2);
        SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);
        SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID1);
        SetFlag<HardEvent::M_MTE1>(EVENT_ID0);
        SetFlag<HardEvent::M_MTE1>(EVENT_ID1);
    }

    __aicore__ inline void SetRowEnd(int e){rowEnd_=e;}
    __aicore__ inline void Compute(const GlobalTensor<int32_t>& result, int expert,
                                   int row, int col, int rows, int cols, int bank)
    {
        const int alignedRows = (rows + 15) / 16 * 16;
        const bool gemv = false;
        const int alignedCols = (cols + 31) / 32 * 32;
        const int area = alignedRows * alignedCols;
        const bool large = area > kTileElements / 2;
        const int offset = large ? 0 : bank * kTileElements / 2;
        const auto matrixEvent = static_cast<TEventID>(bank);
        LocalTensor<int32_t> c(TPosition::CO1, offset * sizeof(int32_t), area);
        const int sliceLimit = Min(kL0SlotBytes / 2 / alignedRows, kL0SlotBytes / 2 / alignedCols) / 32 * 32;
        int kk = panelStart_;
        for (int done = 0; done < k_; done += Panel) {
            const int depth = Min(k_ - kk, Panel);
            const int alignedDepth = (depth + 31) / 32 * 32;
            const int panelSlot=aIndex_++&1;
            LocalTensor<int8_t> a1(TPosition::A1, panelSlot * TileRows * Panel, TileRows * Panel);
            LocalTensor<int8_t> b1(TPosition::B1, 2 * TileRows * Panel,
                                  Panel * TileCols);

            if(!prepared_){
                WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID2);
                WaitFlag<HardEvent::MTE1_MTE2>(static_cast<TEventID>(panelSlot));
                LoadPanel(a1,b1,expert,row,col,rows,cols,kk,depth,alignedRows,alignedCols,alignedDepth,expert==lastExpert_ && col==lastCol_);
                SetFlag<HardEvent::MTE2_MTE1>(static_cast<TEventID>(panelSlot));
            }
            prepared_=false;lastExpert_=expert;lastCol_=col;
            if(row+TileRows<rowEnd_){
                const int other=panelSlot^1,nr=Min(TileRows,rowEnd_-row-TileRows),ar=(nr+15)/16*16;
                LocalTensor<int8_t>next(TPosition::A1,other*TileRows*Panel,TileRows*Panel);
                WaitFlag<HardEvent::MTE1_MTE2>(static_cast<TEventID>(other));
                LoadPanel(next,b1,expert,row+TileRows,col,nr,cols,kk,depth,ar,alignedCols,alignedDepth,true);
                SetFlag<HardEvent::MTE2_MTE1>(static_cast<TEventID>(other));prepared_=true;
            }
            WaitFlag<HardEvent::MTE2_MTE1>(static_cast<TEventID>(panelSlot));

            for (int off = 0; off < alignedDepth; off += sliceLimit) {
                const int slice = Min(alignedDepth - off, sliceLimit);
                const auto l0slot=static_cast<TEventID>(l0Index_++ & 1);
                LocalTensor<int8_t> a2(TPosition::A2, static_cast<int>(l0slot)*kL0SlotBytes/2, kL0SlotBytes/2);
                LocalTensor<int8_t> b2(TPosition::B2, static_cast<int>(l0slot)*kL0SlotBytes/2, kL0SlotBytes/2);
                WaitFlag<HardEvent::M_MTE1>(l0slot);
                LoadSlice(a2, b2, a1, b1, off, slice, alignedRows, alignedCols, alignedDepth, gemv);
                if (off + slice == alignedDepth) {
                    SetFlag<HardEvent::MTE1_MTE2>(static_cast<TEventID>(panelSlot));
                    if(row+TileRows>=rowEnd_)SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID2);
                }
                SetFlag<HardEvent::MTE1_M>(l0slot);
                WaitFlag<HardEvent::MTE1_M>(l0slot);

                const bool first = done == 0 && off == 0;
                if (first) {
                    WaitForMatrix(large || lastLarge_ ? 3 : 1 << bank);
                }
                MmadParams mm{};
                mm.m = gemv ? 1 : alignedRows;
                mm.n = alignedCols;
                mm.k = slice;
                mm.cmatrixInitVal = first;
                Mmad(c, a2, b2, mm);
                if((mm.m/16)*(mm.n/16)<10)PipeBarrier<PIPE_M>();
                SetFlag<HardEvent::M_MTE1>(l0slot);
            }
            // Start each core at a different K panel to spread GM requests.
            kk = kk + Panel < k_ ? kk + Panel : 0;
        }

        SetFlag<HardEvent::M_FIX>(matrixEvent);
        WaitFlag<HardEvent::M_FIX>(matrixEvent);
        if ((produced_ & (1 << bank)) != 0) {
            CrossCoreWaitFlag<0x2>(kConsumed + bank);
        }
        FixpipeParamsV220 store{};
        store.mSize = rows;
        store.nSize = alignedCols;
        store.srcStride = alignedRows;
        store.dstStride = alignedCols;
        store.ndNum = 1;
        Fixpipe<int32_t, int32_t, CFG_ROW_MAJOR>(result, c, store);
        SetFlag<HardEvent::FIX_M>(matrixEvent);
        matrixPending_ |= 1 << bank;
        lastLarge_ = large;
        CrossCoreSetFlag<0x2, PIPE_FIX>(kReady + bank);
        produced_ |= 1 << bank;
    }

    __aicore__ inline void Finish()
    {
        for (int slot = 0; slot < 2; ++slot) {
            if ((produced_ & (1 << slot)) != 0) {
                CrossCoreWaitFlag<0x2>(kConsumed + slot);
            }
            WaitFlag<HardEvent::MTE1_MTE2>(static_cast<TEventID>(slot));
        }
        WaitFlag<HardEvent::M_MTE1>(EVENT_ID0);
        WaitFlag<HardEvent::M_MTE1>(EVENT_ID1);
        WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID2);
        WaitForMatrix(3);
    }

private:
    __aicore__ inline void WaitForMatrix(int overlap)
    {
        const int ready = matrixPending_ & overlap;
        if ((ready & 1) != 0) {
            WaitFlag<HardEvent::FIX_M>(EVENT_ID0);
        }
        if ((ready & 2) != 0) {
            WaitFlag<HardEvent::FIX_M>(EVENT_ID1);
        }
        matrixPending_ &= ~overlap;
    }

    __aicore__ inline void LoadPanel(LocalTensor<int8_t> a1, LocalTensor<int8_t> b1,
                                     int expert, int row, int col, int rows, int cols,
                                     int kk, int depth, int alignedRows, int alignedCols, int alignedDepth, bool reuse)
    {
        // ND2NZ pads each K chunk of A and each N chunk of B. Fill only
        // the remaining row gaps in the destination fractals.
        if (rows != alignedRows) {
            Clear(a1[rows * 32], alignedDepth / 32, alignedRows - rows, rows);
        }
        Nd2NzParams aCopy{};
        aCopy.ndNum = 1;
        aCopy.nValue = rows;
        aCopy.dValue = depth;
        aCopy.srcDValue = k_;
        aCopy.dstNzC0Stride = alignedRows;
        aCopy.dstNzNStride = 1;
        DataCopy(a1, x_[row * k_ + kk], aCopy);

        if (reuse) { return; }
        const int offset = (expert * k_ + kk) * n_ + col;
        switch (packBytes_) {
            case 1:
                LoadPackedWeight<int8_t>(b1, offset, depth, cols, alignedCols);
                break;
            case 2:
                LoadPackedWeight<int16_t>(b1, offset, depth, cols, alignedCols);
                break;
            case 4:
                LoadPackedWeight<int32_t>(b1, offset, depth, alignedCols, alignedCols);
                break;
            default: {
                if (depth != alignedDepth) {
                    Clear(b1[depth * 32], alignedCols / 32, alignedDepth - depth, depth);
                }
                Nd2NzParams bCopy{};
                bCopy.ndNum = 1;
                bCopy.nValue = depth;
                bCopy.dValue = cols;
                bCopy.srcDValue = n_;
                bCopy.dstNzC0Stride = alignedDepth;
                bCopy.dstNzNStride = 1;
                DataCopy(b1, weight_[offset], bCopy);
                break;
            }
        }
    }

    template <class CopyT>
    __aicore__ inline void LoadPackedWeight(LocalTensor<int8_t> b1, int offset,
                                           int depth, int cols, int alignedCols)
    {
        gmg_common::LoadPackedWeight<CopyT>(b1, weightBase_, n_,
                                               offset, depth, cols, alignedCols);
    }

    __aicore__ inline void LoadSlice(LocalTensor<int8_t> a2, LocalTensor<int8_t> b2,
                                     LocalTensor<int8_t> a1, LocalTensor<int8_t> b1,
                                     int off, int slice, int alignedRows, int alignedCols, int alignedDepth, bool gemv)
    {
        if (alignedRows == 16) {
            LoadData2DParams loadA{};
            loadA.repeatTimes = gemv ? (slice + 511) / 512 : slice / 32;
            loadA.srcStride = 1;
            // GEMV reads its one row contiguously from L0A.
            LoadData(a2, a1[gemv ? off : off * alignedRows], loadA);
        } else {
            LoadData3DParamsV2<int8_t> loadA{};
            loadA.l1H = 1;
            loadA.l1W = alignedRows;
            loadA.channelSize = alignedDepth;
            loadA.kExtension = slice;
            loadA.mExtension = alignedRows;
            loadA.kStartPt = off;
            LoadData(a2, a1, loadA);
        }

        LoadData2dTransposeParams loadB{};
        if (packBytes_ != 0) {
            loadB.repeatTimes = (slice / 32) * (alignedCols / 32);
            loadB.srcStride = 1;
            loadB.dstGap = 1;
            LoadDataWithTranspose(b2, b1[off * alignedCols], loadB);
        } else if (alignedCols <= slice) {
            loadB.repeatTimes = slice / 32;
            loadB.srcStride = 1;
            loadB.dstGap = alignedCols / 16 - 1;
            for (int c = 0; c < alignedCols; c += 32) {
                LoadDataWithTranspose(b2[c * 32], b1[c * alignedDepth + off * 32], loadB);
            }
        } else {
            loadB.repeatTimes = alignedCols / 32;
            loadB.srcStride = alignedDepth / 32;
            loadB.dstGap = 1;
            for (int kk = 0; kk < slice; kk += 32) {
                LoadDataWithTranspose(b2[kk * alignedCols], b1[(off + kk) * 32], loadB);
            }
        }
    }


    GlobalTensor<int8_t> x_, weight_;
    GM_ADDR weightBase_;
    int k_, n_, packBytes_, panelStart_;
    int produced_ = 0;
    int matrixPending_ = 0;
    bool lastLarge_ = false;
    int panelIndex_ = 0;
    int l0Index_ = 0;
    int rowEnd_=0,aIndex_=0;bool prepared_=false;
    int lastExpert_ = -1, lastCol_ = -1;
};

template <int TileRows, int TileCols, int Panel>
class CubeTile {
public:
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR weight, int k, int n, bool padded)
    {
        x_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
        weight_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(weight));
        weightBase_ = weight;
        k_ = k;
        n_ = n;
        xStride_ = k;
        nStride_ = padded ? (n + 31) / 32 * 32 : n;
        panelStart_ = GetBlockIdx() % ((k + Panel - 1) / Panel) * Panel;
        packBytes_ = nStride_ <= 2047 ? 1 : nStride_ % 4 == 0 ? 4 : nStride_ % 2 == 0 ? 2 : 0;
        SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);
        SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID1);
        SetFlag<HardEvent::M_MTE1>(EVENT_ID0);
    }

    __aicore__ inline void Compute(const GlobalTensor<int32_t>& result, int expert,
                                   int row, int col, int rows, int cols, int bank)
    {
        const int alignedRows = (rows + 15) / 16 * 16;
        const bool gemv = rows == 1;
        const int alignedCols = (cols + 31) / 32 * 32;
        const int area = alignedRows * alignedCols;
        const bool large = area > kTileElements / 2;
        const int offset = large ? 0 : bank * kTileElements / 2;
        const auto matrixEvent = static_cast<TEventID>(bank);
        LocalTensor<int32_t> c(TPosition::CO1, offset * sizeof(int32_t), area);
        const int sliceLimit = Min(kL0SlotBytes / alignedRows, kL0SlotBytes / alignedCols) / 32 * 32;
        int kk = panelStart_;
        for (int done = 0; done < k_; done += Panel) {
            const int depth = Min(k_ - kk, Panel);
            const int alignedDepth = (depth + 31) / 32 * 32;
            const int panelSlot = panelIndex_++ & 1;
            LocalTensor<int8_t> a1(TPosition::A1, panelSlot * TileRows * Panel, TileRows * Panel);
            LocalTensor<int8_t> b1(TPosition::B1, 2 * TileRows * Panel + panelSlot * Panel * TileCols,
                                  Panel * TileCols);

            WaitFlag<HardEvent::MTE1_MTE2>(static_cast<TEventID>(panelSlot));
            LoadPanel(a1, b1, expert, row, col, rows, cols, kk, depth, alignedRows, alignedCols, alignedDepth);
            SetFlag<HardEvent::MTE2_MTE1>(static_cast<TEventID>(panelSlot));
            WaitFlag<HardEvent::MTE2_MTE1>(static_cast<TEventID>(panelSlot));

            for (int off = 0; off < alignedDepth; off += sliceLimit) {
                const int slice = Min(alignedDepth - off, sliceLimit);
                LocalTensor<int8_t> a2(TPosition::A2, 0, kL0SlotBytes);
                LocalTensor<int8_t> b2(TPosition::B2, 0, kL0SlotBytes);
                WaitFlag<HardEvent::M_MTE1>(EVENT_ID0);
                LoadSlice(a2, b2, a1, b1, off, slice, alignedRows, alignedCols, alignedDepth, gemv);
                if (off + slice == alignedDepth) {
                    SetFlag<HardEvent::MTE1_MTE2>(static_cast<TEventID>(panelSlot));
                }
                SetFlag<HardEvent::MTE1_M>(EVENT_ID0);
                WaitFlag<HardEvent::MTE1_M>(EVENT_ID0);

                const bool first = done == 0 && off == 0;
                if (first) {
                    WaitForMatrix(large || lastLarge_ ? 3 : 1 << bank);
                }
                MmadParams mm{};
                mm.m = gemv ? 1 : alignedRows;
                mm.n = alignedCols;
                mm.k = slice;
                mm.cmatrixInitVal = first;
                Mmad(c, a2, b2, mm);
                if ((mm.m / 16) * (mm.n / 16) < 10) {
                    PipeBarrier<PIPE_M>();
                }
                SetFlag<HardEvent::M_MTE1>(EVENT_ID0);
            }
            // Start each core at a different K panel to spread GM requests.
            kk = kk + Panel < k_ ? kk + Panel : 0;
        }

        SetFlag<HardEvent::M_FIX>(matrixEvent);
        WaitFlag<HardEvent::M_FIX>(matrixEvent);
        if ((produced_ & (1 << bank)) != 0) {
            CrossCoreWaitFlag<0x2>(kConsumed + bank);
        }
        FixpipeParamsV220 store{};
        store.mSize = rows;
        store.nSize = alignedCols;
        store.srcStride = alignedRows;
        store.dstStride = alignedCols;
        store.ndNum = 1;
        Fixpipe<int32_t, int32_t, CFG_ROW_MAJOR>(result, c, store);
        SetFlag<HardEvent::FIX_M>(matrixEvent);
        matrixPending_ |= 1 << bank;
        lastLarge_ = large;
        CrossCoreSetFlag<0x2, PIPE_FIX>(kReady + bank);
        produced_ |= 1 << bank;
    }

    __aicore__ inline void Finish()
    {
        for (int slot = 0; slot < 2; ++slot) {
            if ((produced_ & (1 << slot)) != 0) {
                CrossCoreWaitFlag<0x2>(kConsumed + slot);
            }
            WaitFlag<HardEvent::MTE1_MTE2>(static_cast<TEventID>(slot));
        }
        WaitFlag<HardEvent::M_MTE1>(EVENT_ID0);
        WaitForMatrix(3);
    }

private:
    __aicore__ inline void WaitForMatrix(int overlap)
    {
        const int ready = matrixPending_ & overlap;
        if ((ready & 1) != 0) {
            WaitFlag<HardEvent::FIX_M>(EVENT_ID0);
        }
        if ((ready & 2) != 0) {
            WaitFlag<HardEvent::FIX_M>(EVENT_ID1);
        }
        matrixPending_ &= ~overlap;
    }

    __aicore__ inline void LoadPanel(LocalTensor<int8_t> a1, LocalTensor<int8_t> b1,
                                     int expert, int row, int col, int rows, int cols,
                                     int kk, int depth, int alignedRows, int alignedCols, int alignedDepth)
    {
        // ND2NZ pads each K chunk of A and each N chunk of B. Fill only
        // the remaining row gaps in the destination fractals.
        if (rows != 1 && rows != alignedRows) {
            Clear(a1[rows * 32], alignedDepth / 32, alignedRows - rows, rows);
        }
        Nd2NzParams aCopy{};
        aCopy.ndNum = 1;
        aCopy.nValue = rows;
        aCopy.dValue = depth;
        aCopy.srcDValue = xStride_;
        aCopy.dstNzC0Stride = rows == 1 ? 1 : alignedRows;
        aCopy.dstNzNStride = 1;
        DataCopy(a1, x_[row * xStride_ + kk], aCopy);

        const int offset = (expert * k_ + kk) * nStride_ + col;
        switch (packBytes_) {
            case 1:
                LoadPackedWeight<int8_t>(b1, offset, depth, cols, alignedCols);
                break;
            case 2:
                LoadPackedWeight<int16_t>(b1, offset, depth, cols, alignedCols);
                break;
            case 4:
                LoadPackedWeight<int32_t>(b1, offset, depth, cols, alignedCols);
                break;
            default: {
                if (depth != alignedDepth) {
                    Clear(b1[depth * 32], alignedCols / 32, alignedDepth - depth, depth);
                }
                Nd2NzParams bCopy{};
                bCopy.ndNum = 1;
                bCopy.nValue = depth;
                bCopy.dValue = cols;
                bCopy.srcDValue = nStride_;
                bCopy.dstNzC0Stride = alignedDepth;
                bCopy.dstNzNStride = 1;
                DataCopy(b1, weight_[offset], bCopy);
                break;
            }
        }
    }

    template <class CopyT>
    __aicore__ inline void LoadPackedWeight(LocalTensor<int8_t> b1, int offset,
                                           int depth, int cols, int alignedCols)
    {
        gmg_common::LoadPackedWeight<CopyT>(b1, weightBase_, nStride_,
                                               offset, depth, cols, alignedCols);
    }

    __aicore__ inline void LoadSlice(LocalTensor<int8_t> a2, LocalTensor<int8_t> b2,
                                     LocalTensor<int8_t> a1, LocalTensor<int8_t> b1,
                                     int off, int slice, int alignedRows, int alignedCols, int alignedDepth, bool gemv)
    {
        if (alignedRows == 16) {
            LoadData2DParams loadA{};
            loadA.repeatTimes = gemv ? (slice + 511) / 512 : slice / 32;
            loadA.srcStride = 1;
            // GEMV reads its one row contiguously from L0A.
            LoadData(a2, a1[gemv ? off : off * alignedRows], loadA);
        } else {
            LoadData3DParamsV2<int8_t> loadA{};
            loadA.l1H = 1;
            loadA.l1W = alignedRows;
            loadA.channelSize = alignedDepth;
            loadA.kExtension = slice;
            loadA.mExtension = alignedRows;
            loadA.kStartPt = off;
            LoadData(a2, a1, loadA);
        }

        LoadData2dTransposeParams loadB{};
        if (packBytes_ != 0) {
            loadB.repeatTimes = (slice / 32) * (alignedCols / 32);
            loadB.srcStride = 1;
            loadB.dstGap = 1;
            LoadDataWithTranspose(b2, b1[off * alignedCols], loadB);
        } else if (alignedCols <= slice) {
            loadB.repeatTimes = slice / 32;
            loadB.srcStride = 1;
            loadB.dstGap = alignedCols / 16 - 1;
            for (int c = 0; c < alignedCols; c += 32) {
                LoadDataWithTranspose(b2[c * 32], b1[c * alignedDepth + off * 32], loadB);
            }
        } else {
            loadB.repeatTimes = alignedCols / 32;
            loadB.srcStride = alignedDepth / 32;
            loadB.dstGap = 1;
            for (int kk = 0; kk < slice; kk += 32) {
                LoadDataWithTranspose(b2[kk * alignedCols], b1[(off + kk) * 32], loadB);
            }
        }
    }


    GlobalTensor<int8_t> x_, weight_;
    GM_ADDR weightBase_;
    int k_, n_, xStride_, nStride_, packBytes_, panelStart_;
    int produced_ = 0;
    int matrixPending_ = 0;
    bool lastLarge_ = false;
    int panelIndex_ = 0;
};


template <int TileCols>
using VectorTile = gmg_common::VectorTile<TileCols, kVectorElements, 0, true, false, false>;

template <int TileRows, int TileCols, class Worker>
__aicore__ inline void ProcessTiles(Worker& worker, GM_ADDR groupList, GM_ADDR workspace,
                                    int experts, int n, int core)
{
    GlobalTensor<int64_t> groups;
    groups.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groupList), experts);
    GlobalTensor<int32_t> slot;
    slot.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(workspace) + core * kOutputSlots * kTileElements,
                         kOutputSlots * kTileElements);

    const int cores = GetBlockNum();
    const int colTiles = (n + TileCols - 1) / TileCols;
    int start = 0;
    int next = core;
    int bank = 0;
    for (int expert = 0; expert < experts; ++expert) {
        const int end = static_cast<int>(groups.GetValue(expert));
        const int tiles = ((end - start + TileRows - 1) / TileRows) * colTiles;
        for (; next < tiles; next += cores) {
            const int row = start + next / colTiles * TileRows;
            const int col = next % colTiles * TileCols;
            worker.Compute(slot[bank * kTileElements], expert, row, col,
                           Min(end - row, TileRows), Min(n - col, TileCols), bank);
            bank ^= 1;
        }
        next -= tiles;
        start = end;
    }
}
template<int TileRows,int TileCols,class Worker>
__aicore__ inline void ProcessResident(Worker&worker,GM_ADDR groupList,GM_ADDR workspace,int experts,int n,int core){
 GlobalTensor<int64_t> groups;groups.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groupList));
 const int colTiles=(n+TileCols-1)/TileCols;int prev=0,total=0;
 for(int e=0;e<experts;++e){const int end=static_cast<int>(groups.GetValue(e));total+=(end-prev+TileRows-1)/TileRows*colTiles;prev=end;}
 const int lo=total*core/GetBlockNum(),hi=total*(core+1)/GetBlockNum();int base=0,start=0,bank=0;
 GlobalTensor<int32_t> slot;slot.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(workspace)+core*kOutputSlots*kTileElements,kOutputSlots*kTileElements);
 for(int e=0;e<experts;++e){const int end=static_cast<int>(groups.GetValue(e)),tasks=(end-start+TileRows-1)/TileRows;
  for(int col=0;col<n;col+=TileCols){
   const int left=lo>base?lo-base:0,right=Min(tasks,hi-base);
   if(left<right){const int stop=Min(end,start+right*TileRows);worker.SetRowEnd(stop);
    for(int row=start+left*TileRows;row<stop;row+=TileRows){worker.Compute(slot[bank*kTileElements],e,row,col,Min(TileRows,stop-row),Min(TileCols,n-col),bank);bank^=1;}
   }base+=tasks;
  }start=end;
 }
}

__aicore__ inline void PadRows(GM_ADDR src, GM_ADDR dst, int totalRows, int width)
{
    const int pitch = (width + 31) / 32 * 32;
    const int chunk = Min(16, 32768 / pitch);
    const int cores = GetBlockNum() * 2;
    GlobalTensor<int8_t> source, target;
    source.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(src));
    target.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(dst));
    LocalTensor<int8_t> buf(TPosition::VECCALC, 0, 32768);
    for (int r = GetBlockIdx() * chunk; r < totalRows; r += cores * chunk) {
        const int rows = Min(chunk, totalRows - r);
        DataCopyPad(buf, source[r * width],
                    DataCopyExtParams{static_cast<uint16_t>(rows), static_cast<uint32_t>(width), 0, 0, 0},
                    DataCopyPadExtParams<int8_t>{true, 0, static_cast<uint8_t>(pitch-width), 0});
        WaitFor<HardEvent::MTE2_MTE3>();
        DataCopy(target[r * pitch], buf, rows * pitch);
        WaitFor<HardEvent::MTE3_MTE2>();
    }
}

}  // namespace

template <int TileRows, int TileCols, int Panel>
__global__ GMG_ENTRY_ALIGN(16384,4096) __mix__(1, 2) void grouped_matmul_gelu_custom(
    GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groupList, GM_ADDR y,
    GM_ADDR workspace, int experts, int k, int n)
{
    AscendC::InitSocState();
    const bool padded = (n % 32 != 0 || k % 32 != 0) && n >= 128 && k >= 256;
    GM_ADDR packedX = x;
    GM_ADDR packedW = weight;
    if (padded) {
        GlobalTensor<int64_t> groups;
        groups.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groupList));
        const int m = static_cast<int>(groups.GetValue(experts - 1));
        packedX = x;
        packedW = workspace + GetBlockNum() * kOutputSlots * kTileElements * sizeof(int32_t);
        if ASCEND_IS_AIV {

            PadRows(weight, packedW, experts * k, n);
            CrossCoreSetFlag<0x0, PIPE_MTE3>(8);
            CrossCoreWaitFlag<0x0>(8);
            CrossCoreSetFlag<0x2, PIPE_MTE3>(6);
        }
        if ASCEND_IS_AIC {
            CrossCoreWaitFlag<0x2>(6);
        }
    }
    if(k<=1088){
        if ASCEND_IS_AIC {
            CubeResident<64,256,1088> worker;worker.Init(packedX,packedW,k,n,padded);
            ProcessResident<64,256>(worker,groupList,workspace,experts,n,AscendC::GetBlockIdx());worker.Finish();
        }
        if ASCEND_IS_AIV {
            VectorTile<256> worker;worker.Init(scale,y,n);
            ProcessResident<64,256>(worker,groupList,workspace,experts,n,AscendC::GetBlockIdx()/2);worker.Finish();
        }
        return;
    }
    if ASCEND_IS_AIC {
        CubeTile<TileRows, TileCols, Panel> worker;
        worker.Init(packedX, packedW, k, n, padded);
        ProcessTiles<TileRows, TileCols>(worker, groupList, workspace, experts, n, AscendC::GetBlockIdx());
        worker.Finish();
    }
    if ASCEND_IS_AIV {
        VectorTile<TileCols> worker;
        worker.Init(scale, y, n);
        ProcessTiles<TileRows, TileCols>(worker, groupList, workspace, experts, n, AscendC::GetBlockIdx() / 2);
        worker.Finish();
    }
}

}
namespace path_odd_medium {
using gmg_common::Min;
using gmg_common::Clear;
using gmg_common::WaitFor;
using gmg_common::GeluTanh;


namespace {
using namespace AscendC;

constexpr int kRows = 128;
constexpr int kCols = 256;
constexpr int kL0SlotBytes = 65536;
constexpr int kPanel = 512;
constexpr int kTileElements = kRows * kCols;
constexpr int kVectorRows = kRows / 2;
constexpr int kVectorElements = kVectorRows * kCols;
constexpr int kReady = 0;
constexpr int kConsumed = 2;
constexpr int kOutputSlots = 2;


template <int TileRows, int TileCols, int Panel>
using CubeTile = gmg_common::StandardCube<TileRows, TileCols, Panel, kTileElements>;


template <int TileCols>
using VectorTile = gmg_common::VectorTile<TileCols, kVectorElements, 0, false, false, false>;

template <int TileRows, int TileCols, class Worker>
__aicore__ inline void ProcessTiles(Worker& worker, GM_ADDR groupList, GM_ADDR workspace,
                                    int experts, int n, int core)
{
    GlobalTensor<int64_t> groups;
    groups.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groupList), experts);
    GlobalTensor<int32_t> slot;
    slot.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(workspace) + core * kOutputSlots * kTileElements,
                         kOutputSlots * kTileElements);

    const int cores = GetBlockNum();
    const int colTiles = (n + TileCols - 1) / TileCols;
    int start = 0;
    int next = core;
    int bank = 0;
    for (int expert = 0; expert < experts; ++expert) {
        const int end = static_cast<int>(groups.GetValue(expert));
        const int tiles = ((end - start + TileRows - 1) / TileRows) * colTiles;
        for (; next < tiles; next += cores) {
            const int row = start + next / colTiles * TileRows;
            const int col = next % colTiles * TileCols;
            worker.Compute(slot[bank * kTileElements], expert, row, col,
                           Min(end - row, TileRows), Min(n - col, TileCols), bank);
            bank ^= 1;
        }
        next -= tiles;
        start = end;
    }
}
}  // namespace

template <int TileRows, int TileCols, int Panel>
__global__ GMG_ENTRY_ALIGN(4096,2048) __mix__(1, 2) void grouped_matmul_gelu_custom(
    GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groupList, GM_ADDR y,
    GM_ADDR workspace, int experts, int k, int n)
{
    AscendC::InitSocState();
    if ASCEND_IS_AIC {
        CubeTile<TileRows, TileCols, Panel> worker;
        worker.Init(x, weight, k, n);
        ProcessTiles<TileRows, TileCols>(worker, groupList, workspace, experts, n, AscendC::GetBlockIdx());
        worker.Finish();
    }
    if ASCEND_IS_AIV {
        VectorTile<TileCols> worker;
        worker.Init(scale, y, n);
        ProcessTiles<TileRows, TileCols>(worker, groupList, workspace, experts, n, AscendC::GetBlockIdx() / 2);
        worker.Finish();
    }
}

}
namespace path_odd_larger {
using gmg_common::Min;
using gmg_common::Clear;
using gmg_common::WaitFor;
using gmg_common::GeluTanh;


namespace {
using namespace AscendC;

constexpr int kRows = 128;
constexpr int kCols = 256;
constexpr int kL0SlotBytes = 65536;
constexpr int kPanel = 512;
constexpr int kTileElements = kRows * kCols;
constexpr int kVectorRows = kRows / 2;
constexpr int kVectorElements = kVectorRows * kCols;
constexpr int kReady = 0;
constexpr int kConsumed = 2;
constexpr int kOutputSlots = 2;


template <int TileRows, int TileCols, int Panel>
class CubeTile {
public:
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR weight, int k, int n)
    {
        x_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
        weight_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(weight));
        weightBase_ = weight;
        k_ = k;
        n_ = n;
        panelStart_ = GetBlockIdx() % ((k + Panel - 1) / Panel) * Panel;
        packBytes_ = n <= 2047 ? 1 : n % 4 == 0 ? 4 : n % 2 == 0 ? 2 : 0;
        SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);
        SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID1);
        SetFlag<HardEvent::M_MTE1>(EVENT_ID0);
    }

    __aicore__ inline void SetGroup(int expert, int start)
    {
        packedBase_ = (start + 15) / 16 * 16 + 16 * expert;
        groupStart_ = start;
    }

    __aicore__ inline void PackInputs(GM_ADDR groupList, int experts, GM_ADDR packed)
    {
        packedX_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(packed));
        GlobalTensor<int64_t> groups;
        groups.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groupList));
        LocalTensor<int8_t> local(TPosition::A1, 0, TileRows * Panel);
        const int panels = (k_ + Panel - 1) / Panel;
        const int pitchK = (k_ + 31) / 32 * 32;
        const int cores = GetBlockNum();
        int next = GetBlockIdx();
        int start = 0;
        for (int expert = 0; expert < experts; ++expert) {
            const int end = static_cast<int>(groups.GetValue(expert));
            const int tasks = ((end - start + TileRows - 1) / TileRows) * panels;
            const int packedStart = (start + 15) / 16 * 16 + 16 * expert;
            for (; next < tasks; next += cores) {
                const int rowTile = next / panels;
                const int row = start + rowTile * TileRows;
                const int rows = Min(end - row, TileRows);
                const int alignedRows = (rows + 15) / 16 * 16;
                const int kk = next % panels * Panel;
                const int depth = Min(k_ - kk, Panel);
                const int alignedDepth = (depth + 31) / 32 * 32;
                if (rows != 1 && rows != alignedRows) {
                    Clear(local[rows * 32], alignedDepth / 32, alignedRows - rows, rows);
                }
                Nd2NzParams copy{};
                copy.ndNum = 1; copy.nValue = rows; copy.dValue = depth;
                copy.srcDValue = k_;
                copy.dstNzC0Stride = rows == 1 ? 1 : alignedRows;
                copy.dstNzNStride = 1;
                DataCopy(local, x_[row * k_ + kk], copy);
                PipeBarrier<PIPE_ALL>();
                const int packedRow = packedStart + rowTile * TileRows;
                DataCopy(packedX_[packedRow * pitchK + kk * alignedRows], local, alignedRows * alignedDepth);
                PipeBarrier<PIPE_ALL>();
            }
            next -= tasks;
            start = end;
        }
        CrossCoreSetFlag<0x0, PIPE_MTE2>(8);
        CrossCoreWaitFlag<0x0>(8);
    }

    __aicore__ inline void Compute(const GlobalTensor<int32_t>& result, int expert,
                                   int row, int col, int rows, int cols, int bank)
    {
        const int alignedRows = (rows + 15) / 16 * 16;
        const bool gemv = rows == 1;
        const int alignedCols = (cols + 31) / 32 * 32;
        const int area = alignedRows * alignedCols;
        const bool large = area > kTileElements / 2;
        const int offset = large ? 0 : bank * kTileElements / 2;
        const auto matrixEvent = static_cast<TEventID>(bank);
        LocalTensor<int32_t> c(TPosition::CO1, offset * sizeof(int32_t), area);
        const int sliceLimit = Min(kL0SlotBytes / alignedRows, kL0SlotBytes / alignedCols) / 32 * 32;
        int kk = panelStart_;
        int panelSlot = panelIndex_++ & 1;
        PrefetchPanel(expert,row,col,rows,cols,kk,panelSlot,alignedRows,alignedCols);
        for (int done = 0; done < k_; done += Panel) {
            const int depth = Min(k_ - kk, Panel);
            const int alignedDepth = (depth + 31) / 32 * 32;
            const int nextK=kk+Panel<k_?kk+Panel:0;
            const int nextSlot=panelSlot^1;
            if (done+Panel<k_) {
                ++panelIndex_;
                PrefetchPanel(expert,row,col,rows,cols,nextK,nextSlot,alignedRows,alignedCols);
            }
            LocalTensor<int8_t> a1(TPosition::A1, panelSlot * TileRows * Panel, TileRows * Panel);
            LocalTensor<int8_t> b1(TPosition::B1, 2 * TileRows * Panel + panelSlot * Panel * TileCols,
                                  Panel * TileCols);

            WaitFlag<HardEvent::MTE2_MTE1>(static_cast<TEventID>(panelSlot));

            for (int off = 0; off < alignedDepth; off += sliceLimit) {
                const int slice = Min(alignedDepth - off, sliceLimit);
                LocalTensor<int8_t> a2(TPosition::A2, 0, kL0SlotBytes);
                LocalTensor<int8_t> b2(TPosition::B2, 0, kL0SlotBytes);
                WaitFlag<HardEvent::M_MTE1>(EVENT_ID0);
                LoadSlice(a2, b2, a1, b1, off, slice, alignedRows, alignedCols, alignedDepth, gemv);
                if (off + slice == alignedDepth) {
                    SetFlag<HardEvent::MTE1_MTE2>(static_cast<TEventID>(panelSlot));
                }
                SetFlag<HardEvent::MTE1_M>(EVENT_ID0);
                WaitFlag<HardEvent::MTE1_M>(EVENT_ID0);

                const bool first = done == 0 && off == 0;
                if (first) {
                    WaitForMatrix(large || lastLarge_ ? 3 : 1 << bank);
                }
                MmadParams mm{};
                mm.m = gemv ? 1 : alignedRows;
                mm.n = alignedCols;
                mm.k = slice;
                mm.cmatrixInitVal = first;
                Mmad(c, a2, b2, mm);
                if ((mm.m / 16) * (mm.n / 16) < 10) {
                    PipeBarrier<PIPE_M>();
                }
                SetFlag<HardEvent::M_MTE1>(EVENT_ID0);
            }
            // Start each core at a different K panel to spread GM requests.
            kk=nextK;
            panelSlot=nextSlot;
        }

        SetFlag<HardEvent::M_FIX>(matrixEvent);
        WaitFlag<HardEvent::M_FIX>(matrixEvent);
        if ((produced_ & (1 << bank)) != 0) {
            CrossCoreWaitFlag<0x2>(kConsumed + bank);
        }
        FixpipeParamsV220 store{};
        store.mSize = rows;
        store.nSize = alignedCols;
        store.srcStride = alignedRows;
        store.dstStride = alignedCols;
        store.ndNum = 1;
        Fixpipe<int32_t, int32_t, CFG_ROW_MAJOR>(result, c, store);
        SetFlag<HardEvent::FIX_M>(matrixEvent);
        matrixPending_ |= 1 << bank;
        lastLarge_ = large;
        CrossCoreSetFlag<0x2, PIPE_FIX>(kReady + bank);
        produced_ |= 1 << bank;
    }

    __aicore__ inline void Finish()
    {
        for (int slot = 0; slot < 2; ++slot) {
            if ((produced_ & (1 << slot)) != 0) {
                CrossCoreWaitFlag<0x2>(kConsumed + slot);
            }
            WaitFlag<HardEvent::MTE1_MTE2>(static_cast<TEventID>(slot));
        }
        WaitFlag<HardEvent::M_MTE1>(EVENT_ID0);
        WaitForMatrix(3);
    }

private:
    __aicore__ inline void WaitForMatrix(int overlap)
    {
        const int ready = matrixPending_ & overlap;
        if ((ready & 1) != 0) {
            WaitFlag<HardEvent::FIX_M>(EVENT_ID0);
        }
        if ((ready & 2) != 0) {
            WaitFlag<HardEvent::FIX_M>(EVENT_ID1);
        }
        matrixPending_ &= ~overlap;
    }

    __aicore__ inline void PrefetchPanel(int expert,int row,int col,int rows,int cols,int kk,int slot,int ar,int ac)
    {
        const int depth=Min(k_-kk,Panel), ad=(depth+31)/32*32;
        LocalTensor<int8_t> a(TPosition::A1,slot*TileRows*Panel,TileRows*Panel);
        LocalTensor<int8_t> b(TPosition::B1,2*TileRows*Panel+slot*Panel*TileCols,Panel*TileCols);
        WaitFlag<HardEvent::MTE1_MTE2>(static_cast<TEventID>(slot));
        LoadPanel(a,b,expert,row,col,rows,cols,kk,depth,ar,ac,ad);
        SetFlag<HardEvent::MTE2_MTE1>(static_cast<TEventID>(slot));
    }

    __aicore__ inline void LoadPanel(LocalTensor<int8_t> a1, LocalTensor<int8_t> b1,
                                     int expert, int row, int col, int rows, int cols,
                                     int kk, int depth, int alignedRows, int alignedCols, int alignedDepth)
    {
        const int packedRow = packedBase_ + row - groupStart_;
        const int pitchK = (k_ + 31) / 32 * 32;
        DataCopy(a1, packedX_[packedRow * pitchK + kk * alignedRows], alignedRows * alignedDepth);

        const int offset = (expert * k_ + kk) * n_ + col;
        switch (packBytes_) {
            case 1:
                LoadPackedWeight<int8_t>(b1, offset, depth, cols, alignedCols);
                break;
            case 2:
                LoadPackedWeight<int16_t>(b1, offset, depth, cols, alignedCols);
                break;
            case 4:
                LoadPackedWeight<int32_t>(b1, offset, depth, cols, alignedCols);
                break;
            default: {
                if (depth != alignedDepth) {
                    Clear(b1[depth * 32], alignedCols / 32, alignedDepth - depth, depth);
                }
                Nd2NzParams bCopy{};
                bCopy.ndNum = 1;
                bCopy.nValue = depth;
                bCopy.dValue = cols;
                bCopy.srcDValue = n_;
                bCopy.dstNzC0Stride = alignedDepth;
                bCopy.dstNzNStride = 1;
                DataCopy(b1, weight_[offset], bCopy);
                break;
            }
        }
    }

    template <class CopyT>
    __aicore__ inline void LoadPackedWeight(LocalTensor<int8_t> b1, int offset,
                                           int depth, int cols, int alignedCols)
    {
        gmg_common::LoadPackedWeight<CopyT>(b1, weightBase_, n_,
                                               offset, depth, cols, alignedCols);
    }

    __aicore__ inline void LoadSlice(LocalTensor<int8_t> a2, LocalTensor<int8_t> b2,
                                     LocalTensor<int8_t> a1, LocalTensor<int8_t> b1,
                                     int off, int slice, int alignedRows, int alignedCols, int alignedDepth, bool gemv)
    {
        if (alignedRows == 16) {
            LoadData2DParams loadA{};
            loadA.repeatTimes = gemv ? (slice + 511) / 512 : slice / 32;
            loadA.srcStride = 1;
            // GEMV reads its one row contiguously from L0A.
            LoadData(a2, a1[gemv ? off : off * alignedRows], loadA);
        } else {
            LoadData3DParamsV2<int8_t> loadA{};
            loadA.l1H = 1;
            loadA.l1W = alignedRows;
            loadA.channelSize = alignedDepth;
            loadA.kExtension = slice;
            loadA.mExtension = alignedRows;
            loadA.kStartPt = off;
            LoadData(a2, a1, loadA);
        }

        LoadData2dTransposeParams loadB{};
        if (packBytes_ != 0) {
            loadB.repeatTimes = (slice / 32) * (alignedCols / 32);
            loadB.srcStride = 1;
            loadB.dstGap = 1;
            LoadDataWithTranspose(b2, b1[off * alignedCols], loadB);
        } else if (alignedCols <= slice) {
            loadB.repeatTimes = slice / 32;
            loadB.srcStride = 1;
            loadB.dstGap = alignedCols / 16 - 1;
            for (int c = 0; c < alignedCols; c += 32) {
                LoadDataWithTranspose(b2[c * 32], b1[c * alignedDepth + off * 32], loadB);
            }
        } else {
            loadB.repeatTimes = alignedCols / 32;
            loadB.srcStride = alignedDepth / 32;
            loadB.dstGap = 1;
            for (int kk = 0; kk < slice; kk += 32) {
                LoadDataWithTranspose(b2[kk * alignedCols], b1[(off + kk) * 32], loadB);
            }
        }
    }


    GlobalTensor<int8_t> x_, weight_, packedX_;
    int packedBase_ = 0, groupStart_ = 0;
    GM_ADDR weightBase_;
    int k_, n_, packBytes_, panelStart_;
    int produced_ = 0;
    int matrixPending_ = 0;
    bool lastLarge_ = false;
    int panelIndex_ = 0;
};


template <int TileCols>
using VectorTile = gmg_common::VectorTile<TileCols, kVectorElements, 0, false, false, false>;

template <int TileRows, int TileCols, class Worker>
__aicore__ inline void ProcessTiles(Worker& worker, GM_ADDR groupList, GM_ADDR workspace,
                                    int experts, int n, int core)
{
    GlobalTensor<int64_t> groups;
    groups.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groupList), experts);
    GlobalTensor<int32_t> slot;
    slot.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(workspace) + core * kOutputSlots * kTileElements,
                         kOutputSlots * kTileElements);

    const int cores = GetBlockNum();
    const int colTiles = (n + TileCols - 1) / TileCols;
    int start = 0;
    int next = core;
    int bank = 0;
    for (int expert = 0; expert < experts; ++expert) {
        const int end = static_cast<int>(groups.GetValue(expert));
        worker.SetGroup(expert, start);
        const int tiles = ((end - start + TileRows - 1) / TileRows) * colTiles;
        for (; next < tiles; next += cores) {
            const int row = start + next / colTiles * TileRows;
            const int col = next % colTiles * TileCols;
            worker.Compute(slot[bank * kTileElements], expert, row, col,
                           Min(end - row, TileRows), Min(n - col, TileCols), bank);
            bank ^= 1;
        }
        next -= tiles;
        start = end;
    }
}
}  // namespace

template <int TileRows, int TileCols, int Panel>
__global__ GMG_ENTRY_ALIGN(8192,2048) __mix__(1, 2) void grouped_matmul_gelu_custom(
    GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groupList, GM_ADDR y,
    GM_ADDR workspace, int experts, int k, int n)
{
    AscendC::InitSocState();
    if ASCEND_IS_AIC {
        CubeTile<TileRows, TileCols, Panel> worker;
        worker.Init(x, weight, k, n);
        worker.PackInputs(groupList, experts, workspace + GetBlockNum() * kOutputSlots * kTileElements * sizeof(int32_t));
        ProcessTiles<TileRows, TileCols>(worker, groupList, workspace, experts, n, AscendC::GetBlockIdx());
        worker.Finish();
    }
    if ASCEND_IS_AIV {
        VectorTile<TileCols> worker;
        worker.Init(scale, y, n);
        ProcessTiles<TileRows, TileCols>(worker, groupList, workspace, experts, n, AscendC::GetBlockIdx() / 2);
        worker.Finish();
    }
}

}
namespace path_long_reduction {
using gmg_common::Min;
using gmg_common::Clear;
using gmg_common::WaitFor;
using gmg_common::GeluTanh;


namespace {
using namespace AscendC;

constexpr int kRows = 128;
constexpr int kCols = 256;
constexpr int kL0SlotBytes = 65536;
constexpr int kPanel = 512;
constexpr int kTileElements = kRows * kCols;
constexpr int kVectorRows = kRows / 2;
constexpr int kVectorElements = kVectorRows * kCols;
constexpr int kReady = 0;
constexpr int kConsumed = 2;
constexpr int kOutputSlots = 2;


template <int TileRows, int TileCols, int Panel>
class CubeTile {
public:
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR weight, int k, int n)
    {
        x_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
        weight_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(weight));
        weightBase_ = weight;
        k_ = k;
        n_ = n;
        panelStart_ = GetBlockIdx() % ((k + Panel - 1) / Panel) * Panel;
        packBytes_ = n <= 2047 ? 1 : n % 4 == 0 ? 4 : n % 2 == 0 ? 2 : 0;
        SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);
        SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID1);
        SetFlag<HardEvent::M_MTE1>(EVENT_ID0);
        SetFlag<HardEvent::M_MTE1>(EVENT_ID1);
    }

    __aicore__ inline void SetGroup(int expert, int start)
    {
        packedBase_ = (start + 15) / 16 * 16 + 16 * expert;
        groupStart_ = start;
    }

    __aicore__ inline void PackInputs(GM_ADDR groupList, int experts, GM_ADDR packed)
    {
        packedX_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(packed));
        GlobalTensor<int64_t> groups;
        groups.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groupList));
        LocalTensor<int8_t> local(TPosition::A1, 0, TileRows * 1376);
        const int panels = (k_ + 1376 - 1) / 1376;
        const int pitchK = (k_ + 31) / 32 * 32;
        const int cores = GetBlockNum();
        int next = GetBlockIdx();
        int start = 0;
        for (int expert = 0; expert < experts; ++expert) {
            const int end = static_cast<int>(groups.GetValue(expert));
            const int tasks = ((end - start + TileRows - 1) / TileRows) * panels;
            const int packedStart = (start + 15) / 16 * 16 + 16 * expert;
            for (; next < tasks; next += cores) {
                const int rowTile = next / panels;
                const int row = start + rowTile * TileRows;
                const int rows = Min(end - row, TileRows);
                const int alignedRows = (rows + 15) / 16 * 16;
                const int kk = next % panels * 1376;
                const int depth = Min(k_ - kk, 1376);
                const int alignedDepth = (depth + 31) / 32 * 32;
                if (rows != alignedRows) {
                    Clear(local[rows * 32], alignedDepth / 32, alignedRows - rows, rows);
                }
                Nd2NzParams copy{};
                copy.ndNum = 1; copy.nValue = rows; copy.dValue = depth;
                copy.srcDValue = k_;
                copy.dstNzC0Stride = alignedRows;
                copy.dstNzNStride = 1;
                DataCopy(local, x_[row * k_ + kk], copy);
                PipeBarrier<PIPE_ALL>();
                const int packedRow = packedStart + rowTile * TileRows;
                DataCopy(packedX_[packedRow * pitchK + kk * alignedRows], local, alignedRows * alignedDepth);
                PipeBarrier<PIPE_ALL>();
            }
            next -= tasks;
            start = end;
        }
        CrossCoreSetFlag<0x0, PIPE_MTE2>(8);
        CrossCoreWaitFlag<0x0>(8);
    }

    __aicore__ inline void Compute(const GlobalTensor<int32_t>& result, int expert,
                                   int row, int col, int rows, int cols, int bank)
    {
        const int alignedRows = (rows + 15) / 16 * 16;
        const bool gemv = false;
        const int alignedCols = (cols + 31) / 32 * 32;
        const int area = alignedRows * alignedCols;
        const bool large = area > kTileElements / 2;
        const int offset = large ? 0 : bank * kTileElements / 2;
        const auto matrixEvent = static_cast<TEventID>(bank);
        LocalTensor<int32_t> c(TPosition::CO1, offset * sizeof(int32_t), area);
        const int sliceLimit = Min(kL0SlotBytes / 2 / alignedRows, kL0SlotBytes / 2 / alignedCols) / 32 * 32;
        int kk = panelStart_;
        for (int done = 0; done < k_; done += Panel) {
            const int depth = Min(k_ - kk, Panel);
            const int alignedDepth = (depth + 31) / 32 * 32;
            const int panelSlot = panelIndex_++ & 1;
            LocalTensor<int8_t> a1(TPosition::A1, panelSlot * TileRows * Panel, TileRows * Panel);
            LocalTensor<int8_t> b1(TPosition::B1, 2 * TileRows * Panel + panelSlot * Panel * TileCols,
                                  Panel * TileCols);

            WaitFlag<HardEvent::MTE1_MTE2>(static_cast<TEventID>(panelSlot));
            LoadPanel(a1, b1, expert, row, col, rows, cols, kk, depth, alignedRows, alignedCols, alignedDepth);
            SetFlag<HardEvent::MTE2_MTE1>(static_cast<TEventID>(panelSlot));
            WaitFlag<HardEvent::MTE2_MTE1>(static_cast<TEventID>(panelSlot));

            for (int off = 0; off < alignedDepth; off += sliceLimit) {
                const int slice = Min(alignedDepth - off, sliceLimit);
                const auto l0slot=static_cast<TEventID>(l0Index_++ & 1);
                LocalTensor<int8_t> a2(TPosition::A2, static_cast<int>(l0slot)*kL0SlotBytes/2, kL0SlotBytes/2);
                LocalTensor<int8_t> b2(TPosition::B2, static_cast<int>(l0slot)*kL0SlotBytes/2, kL0SlotBytes/2);
                WaitFlag<HardEvent::M_MTE1>(l0slot);
                LoadSlice(a2, b2, a1, b1, off, slice, alignedRows, alignedCols, alignedDepth, gemv);
                if (off + slice == alignedDepth) {
                    SetFlag<HardEvent::MTE1_MTE2>(static_cast<TEventID>(panelSlot));
                }
                SetFlag<HardEvent::MTE1_M>(l0slot);
                WaitFlag<HardEvent::MTE1_M>(l0slot);

                const bool first = done == 0 && off == 0;
                if (first) {
                    WaitForMatrix(large || lastLarge_ ? 3 : 1 << bank);
                }
                MmadParams mm{};
                mm.m = gemv ? 1 : alignedRows;
                mm.n = alignedCols;
                mm.k = slice;
                mm.cmatrixInitVal = first;
                Mmad(c, a2, b2, mm);
                if ((mm.m / 16) * (mm.n / 16) < 10) {
                    PipeBarrier<PIPE_M>();
                }
                SetFlag<HardEvent::M_MTE1>(l0slot);
            }
            // Start each core at a different K panel to spread GM requests.
            kk = kk + Panel < k_ ? kk + Panel : 0;
        }

        SetFlag<HardEvent::M_FIX>(matrixEvent);
        WaitFlag<HardEvent::M_FIX>(matrixEvent);
        if ((produced_ & (1 << bank)) != 0) {
            CrossCoreWaitFlag<0x2>(kConsumed + bank);
        }
        FixpipeParamsV220 store{};
        store.mSize = rows;
        store.nSize = alignedCols;
        store.srcStride = alignedRows;
        store.dstStride = alignedCols;
        store.ndNum = 1;
        Fixpipe<int32_t, int32_t, CFG_ROW_MAJOR>(result, c, store);
        SetFlag<HardEvent::FIX_M>(matrixEvent);
        matrixPending_ |= 1 << bank;
        lastLarge_ = large;
        CrossCoreSetFlag<0x2, PIPE_FIX>(kReady + bank);
        produced_ |= 1 << bank;
    }

    __aicore__ inline void Finish()
    {
        for (int slot = 0; slot < 2; ++slot) {
            if ((produced_ & (1 << slot)) != 0) {
                CrossCoreWaitFlag<0x2>(kConsumed + slot);
            }
            WaitFlag<HardEvent::MTE1_MTE2>(static_cast<TEventID>(slot));
        }
        WaitFlag<HardEvent::M_MTE1>(EVENT_ID0);
        WaitFlag<HardEvent::M_MTE1>(EVENT_ID1);
        WaitForMatrix(3);
    }

private:
    __aicore__ inline void WaitForMatrix(int overlap)
    {
        const int ready = matrixPending_ & overlap;
        if ((ready & 1) != 0) {
            WaitFlag<HardEvent::FIX_M>(EVENT_ID0);
        }
        if ((ready & 2) != 0) {
            WaitFlag<HardEvent::FIX_M>(EVENT_ID1);
        }
        matrixPending_ &= ~overlap;
    }

    __aicore__ inline void LoadPanel(LocalTensor<int8_t> a1, LocalTensor<int8_t> b1,
                                     int expert, int row, int col, int rows, int cols,
                                     int kk, int depth, int alignedRows, int alignedCols, int alignedDepth)
    {
        const int packedRow = packedBase_ + row - groupStart_;
        const int pitchK = (k_ + 31) / 32 * 32;
        DataCopy(a1, packedX_[packedRow * pitchK + kk * alignedRows], alignedRows * alignedDepth);

        const int offset = (expert * k_ + kk) * n_ + col;
        switch (packBytes_) {
            case 1:
                LoadPackedWeight<int8_t>(b1, offset, depth, cols, alignedCols);
                break;
            case 2:
                LoadPackedWeight<int16_t>(b1, offset, depth, cols, alignedCols);
                break;
            case 4:
                LoadPackedWeight<int32_t>(b1, offset, depth, cols, alignedCols);
                break;
            default: {
                if (depth != alignedDepth) {
                    Clear(b1[depth * 32], alignedCols / 32, alignedDepth - depth, depth);
                }
                Nd2NzParams bCopy{};
                bCopy.ndNum = 1;
                bCopy.nValue = depth;
                bCopy.dValue = cols;
                bCopy.srcDValue = n_;
                bCopy.dstNzC0Stride = alignedDepth;
                bCopy.dstNzNStride = 1;
                DataCopy(b1, weight_[offset], bCopy);
                break;
            }
        }
    }

    template <class CopyT>
    __aicore__ inline void LoadPackedWeight(LocalTensor<int8_t> b1, int offset,
                                           int depth, int cols, int alignedCols)
    {
        gmg_common::LoadPackedWeight<CopyT>(b1, weightBase_, n_,
                                               offset, depth, cols, alignedCols);
    }

    __aicore__ inline void LoadSlice(LocalTensor<int8_t> a2, LocalTensor<int8_t> b2,
                                     LocalTensor<int8_t> a1, LocalTensor<int8_t> b1,
                                     int off, int slice, int alignedRows, int alignedCols, int alignedDepth, bool gemv)
    {
        if (alignedRows == 16) {
            LoadData2DParams loadA{};
            loadA.repeatTimes = gemv ? (slice + 511) / 512 : slice / 32;
            loadA.srcStride = 1;
            // GEMV reads its one row contiguously from L0A.
            LoadData(a2, a1[gemv ? off : off * alignedRows], loadA);
        } else {
            LoadData3DParamsV2<int8_t> loadA{};
            loadA.l1H = 1;
            loadA.l1W = alignedRows;
            loadA.channelSize = alignedDepth;
            loadA.kExtension = slice;
            loadA.mExtension = alignedRows;
            loadA.kStartPt = off;
            LoadData(a2, a1, loadA);
        }

        LoadData2dTransposeParams loadB{};
        if (packBytes_ != 0) {
            loadB.repeatTimes = (slice / 32) * (alignedCols / 32);
            loadB.srcStride = 1;
            loadB.dstGap = 1;
            LoadDataWithTranspose(b2, b1[off * alignedCols], loadB);
        } else if (alignedCols <= slice) {
            loadB.repeatTimes = slice / 32;
            loadB.srcStride = 1;
            loadB.dstGap = alignedCols / 16 - 1;
            for (int c = 0; c < alignedCols; c += 32) {
                LoadDataWithTranspose(b2[c * 32], b1[c * alignedDepth + off * 32], loadB);
            }
        } else {
            loadB.repeatTimes = alignedCols / 32;
            loadB.srcStride = alignedDepth / 32;
            loadB.dstGap = 1;
            for (int kk = 0; kk < slice; kk += 32) {
                LoadDataWithTranspose(b2[kk * alignedCols], b1[(off + kk) * 32], loadB);
            }
        }
    }


    GlobalTensor<int8_t> x_, weight_, packedX_;
    int packedBase_ = 0, groupStart_ = 0;
    GM_ADDR weightBase_;
    int k_, n_, packBytes_, panelStart_;
    int produced_ = 0;
    int matrixPending_ = 0;
    bool lastLarge_ = false;
    int panelIndex_ = 0;
    int l0Index_ = 0;
};


template <int TileCols>
using VectorTile = gmg_common::VectorTile<TileCols, kVectorElements, 0, false, false, false>;

template <int TileRows, int TileCols, class Worker>
__aicore__ inline void ProcessTiles(Worker& worker, GM_ADDR groupList, GM_ADDR workspace,
                                    int experts, int n, int core)
{
    GlobalTensor<int64_t> groups;
    groups.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groupList), experts);
    GlobalTensor<int32_t> slot;
    slot.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(workspace) + core * kOutputSlots * kTileElements,
                         kOutputSlots * kTileElements);

    const int cores = GetBlockNum();
    const int colTiles = (n + TileCols - 1) / TileCols;
    int start = 0;
    int next = core;
    int bank = 0;
    for (int expert = 0; expert < experts; ++expert) {
        const int end = static_cast<int>(groups.GetValue(expert));
        worker.SetGroup(expert, start);
        const int tiles = ((end - start + TileRows - 1) / TileRows) * colTiles;
        for (; next < tiles; next += cores) {
            const int row = start + next / colTiles * TileRows;
            const int col = next % colTiles * TileCols;
            worker.Compute(slot[bank * kTileElements], expert, row, col,
                           Min(end - row, TileRows), Min(n - col, TileCols), bank);
            bank ^= 1;
        }
        next -= tiles;
        start = end;
    }
}
}  // namespace

template <int TileRows, int TileCols, int Panel>
__global__ GMG_ENTRY_ALIGN(8192,2048) __mix__(1, 2) void grouped_matmul_gelu_custom(
    GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groupList, GM_ADDR y,
    GM_ADDR workspace, int experts, int k, int n)
{
    AscendC::InitSocState();
    if ASCEND_IS_AIC {
        CubeTile<TileRows, TileCols, Panel> worker;
        worker.Init(x, weight, k, n);
        worker.PackInputs(groupList, experts, workspace + GetBlockNum() * kOutputSlots * kTileElements * sizeof(int32_t));
        ProcessTiles<TileRows, TileCols>(worker, groupList, workspace, experts, n, AscendC::GetBlockIdx());
        worker.Finish();
    }
    if ASCEND_IS_AIV {
        VectorTile<TileCols> worker;
        worker.Init(scale, y, n);
        ProcessTiles<TileRows, TileCols>(worker, groupList, workspace, experts, n, AscendC::GetBlockIdx() / 2);
        worker.Finish();
    }
}


}
namespace path_odd_short {
using gmg_common::Min;
using gmg_common::Clear;
using gmg_common::WaitFor;
using gmg_common::GeluTanh;


namespace {
using namespace AscendC;

constexpr int kRows = 128;
constexpr int kCols = 256;
constexpr int kL0SlotBytes = 65536;
constexpr int kPanel = 512;
constexpr int kTileElements = kRows * kCols;
constexpr int kVectorRows = kRows / 2;
constexpr int kVectorElements = kVectorRows * kCols;
constexpr int kReady = 0;
constexpr int kConsumed = 2;
constexpr int kOutputSlots = 2;


template <int TileRows, int TileCols, int Panel>
class TripleCube {
public:
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR weight, int k, int n)
    {
        x_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
        weight_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(weight));
        weightBase_ = weight;
        pitchK_=(k+31)/32*32;
        k_ = k;
        n_ = n;
        panelStart_ = GetBlockIdx() % ((k + Panel - 1) / Panel) * Panel;
        packBytes_=n<=2047?1:n%4==0?4:n%2==0?2:0;
        SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID3);
        SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);
        SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID1);
        SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID2);
        SetFlag<HardEvent::M_MTE1>(EVENT_ID0);
    }

    __aicore__ inline void Compute(const GlobalTensor<int32_t>& result, int expert,
                                   int row, int col, int rows, int cols, int bank)
    {
        const int alignedRows = (rows + 15) / 16 * 16;
        WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID3);
        const bool loadedA=expert!=cachedExpert_ || row!=cachedRow_ || rows!=cachedRows_;
        if(loadedA){
            LocalTensor<int8_t> resident(TPosition::A1,0,TileRows*1088);
            if(rows!=alignedRows)Clear(resident[rows*32],pitchK_/32,alignedRows-rows,rows);
            Nd2NzParams cp{};cp.ndNum=1;cp.nValue=rows;cp.dValue=k_;cp.srcDValue=k_;cp.dstNzC0Stride=alignedRows;cp.dstNzNStride=1;
            DataCopy(resident,x_[row*k_],cp);
            SetFlag<HardEvent::MTE2_MTE1>(EVENT_ID3);
            cachedExpert_=expert;cachedRow_=row;cachedRows_=rows;
        }

        const bool gemv = false;
        const int alignedCols = (cols + 31) / 32 * 32;
        const int area = alignedRows * alignedCols;
        const bool large = area > kTileElements / 2;
        const int offset = large ? 0 : bank * kTileElements / 2;
        const auto matrixEvent = static_cast<TEventID>(bank);
        LocalTensor<int32_t> c(TPosition::CO1, offset * sizeof(int32_t), area);
        const int sliceLimit = Min(kL0SlotBytes / alignedRows, kL0SlotBytes / alignedCols) / 32 * 32;
        const int panelDepth=Panel;
        const int parts=(k_+panelDepth-1)/panelDepth;
        int kk=GetBlockIdx()%parts*panelDepth;
        int preloadK=kk;
        for(int p=0;p<parts;++p){
            PrefetchPanel(p,expert,row,col,rows,cols,preloadK,alignedRows,alignedCols);
            preloadK=preloadK+panelDepth<k_?preloadK+panelDepth:0;
        }
        int panelSlot=0;
        for (int done = 0; done < k_; done += panelDepth) {
            const int depth = Min(k_ - kk, panelDepth);
            const int alignedDepth = (depth + 31) / 32 * 32;
            const int nextK = kk + panelDepth < k_ ? kk + panelDepth : 0;
            LocalTensor<int8_t> a1(TPosition::A1, 0, TileRows*1088);
            LocalTensor<int8_t> b1(TPosition::B1, TileRows*1088 + panelSlot*Panel*TileCols,Panel*TileCols);
            WaitFlag<HardEvent::MTE2_MTE1>(static_cast<TEventID>(panelSlot));
            if(loadedA && done==0)WaitFlag<HardEvent::MTE2_MTE1>(EVENT_ID3);

            for (int off = 0; off < alignedDepth; off += sliceLimit) {
                const int slice = Min(alignedDepth - off, sliceLimit);
                const auto l0slot=EVENT_ID0;
                LocalTensor<int8_t> a2(TPosition::A2, static_cast<int>(l0slot)*kL0SlotBytes, kL0SlotBytes);
                LocalTensor<int8_t> b2(TPosition::B2, static_cast<int>(l0slot)*kL0SlotBytes, kL0SlotBytes);
                WaitFlag<HardEvent::M_MTE1>(l0slot);
                currentK_=kk;
                LoadSlice(a2, b2, a1, b1, off, slice, alignedRows, alignedCols, alignedDepth, gemv);
                if (off + slice == alignedDepth) {
                    SetFlag<HardEvent::MTE1_MTE2>(static_cast<TEventID>(panelSlot));
                    if(done+panelDepth>=k_)SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID3);
                }
                SetFlag<HardEvent::MTE1_M>(l0slot);
                WaitFlag<HardEvent::MTE1_M>(l0slot);

                const bool first = done == 0 && off == 0;
                if (first) {
                    WaitForMatrix(large || lastLarge_ ? 3 : 1 << bank);
                }
                MmadParams mm{};
                mm.m = gemv ? 1 : alignedRows;
                mm.n = alignedCols;
                mm.k = slice;
                mm.cmatrixInitVal = first;
                Mmad(c, a2, b2, mm);
                if((mm.m/16)*(mm.n/16)<10)PipeBarrier<PIPE_M>();
                SetFlag<HardEvent::M_MTE1>(l0slot);
            }
            // Start each core at a different K panel to spread GM requests.
            kk = nextK;
            ++panelSlot;
        }

        SetFlag<HardEvent::M_FIX>(matrixEvent);
        WaitFlag<HardEvent::M_FIX>(matrixEvent);
        if ((produced_ & (1 << bank)) != 0) {
            CrossCoreWaitFlag<0x2>(kConsumed + bank);
        }
        FixpipeParamsV220 store{};
        store.mSize = rows;
        store.nSize = alignedCols;
        store.srcStride = alignedRows;
        store.dstStride = alignedCols;
        store.ndNum = 1;
        Fixpipe<int32_t, int32_t, CFG_ROW_MAJOR>(result, c, store);
        SetFlag<HardEvent::FIX_M>(matrixEvent);
        matrixPending_ |= 1 << bank;
        lastLarge_ = large;
        CrossCoreSetFlag<0x2, PIPE_FIX>(kReady + bank);
        produced_ |= 1 << bank;
    }

    __aicore__ inline void Finish()
    {
        for (int slot = 0; slot < 3; ++slot) {
            if (slot<2 && (produced_ & (1 << slot)) != 0) {
                CrossCoreWaitFlag<0x2>(kConsumed + slot);
            }
            WaitFlag<HardEvent::MTE1_MTE2>(static_cast<TEventID>(slot));
        }
        WaitFlag<HardEvent::M_MTE1>(EVENT_ID0);
        WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID3);
        WaitForMatrix(3);
    }

private:
    __aicore__ inline void WaitForMatrix(int overlap)
    {
        const int ready = matrixPending_ & overlap;
        if ((ready & 1) != 0) {
            WaitFlag<HardEvent::FIX_M>(EVENT_ID0);
        }
        if ((ready & 2) != 0) {
            WaitFlag<HardEvent::FIX_M>(EVENT_ID1);
        }
        matrixPending_ &= ~overlap;
    }

__aicore__ inline void PrefetchPanel(int slot, int expert, int row, int col,
                                        int rows, int cols, int kk, int alignedRows, int alignedCols)
    {
        LocalTensor<int8_t> a1(TPosition::A1,0,TileRows*1088);
        LocalTensor<int8_t> b1(TPosition::B1, TileRows*1088+slot*Panel*TileCols,Panel*TileCols);
        const int panelDepth=Panel;
        const int depth = Min(k_ - kk, panelDepth);
        const int alignedDepth = (depth + 31) / 32 * 32;
        const auto event = static_cast<TEventID>(slot);
        WaitFlag<HardEvent::MTE1_MTE2>(event);
        LoadPanel(a1, b1, expert, row, col, rows, cols, kk, depth, alignedRows, alignedCols, alignedDepth);
        SetFlag<HardEvent::MTE2_MTE1>(event);
    }

    __aicore__ inline void LoadPanel(LocalTensor<int8_t> a1, LocalTensor<int8_t> b1,
                                     int expert, int row, int col, int rows, int cols,
                                     int kk, int depth, int alignedRows, int alignedCols, int alignedDepth)
    {
        const int offset = (expert * k_ + kk) * n_ + col;
        switch (packBytes_) {
            case 1:
                LoadPackedWeight<int8_t>(b1, offset, depth, cols, alignedCols);
                break;
            case 2:
                LoadPackedWeight<int16_t>(b1, offset, depth, cols, alignedCols);
                break;
            case 4:
                LoadPackedWeight<int32_t>(b1, offset, depth, cols, alignedCols);
                break;
            default: {
                if (depth != alignedDepth) {
                    Clear(b1[depth * 32], alignedCols / 32, alignedDepth - depth, depth);
                }
                Nd2NzParams bCopy{};
                bCopy.ndNum = 1;
                bCopy.nValue = depth;
                bCopy.dValue = cols;
                bCopy.srcDValue = n_;
                bCopy.dstNzC0Stride = alignedDepth;
                bCopy.dstNzNStride = 1;
                DataCopy(b1, weight_[offset], bCopy);
                break;
            }
        }
    }

    template <class CopyT>
    __aicore__ inline void LoadPackedWeight(LocalTensor<int8_t> b1, int offset,
                                           int depth, int cols, int alignedCols)
    {
        gmg_common::LoadPackedWeight<CopyT>(b1, weightBase_, n_,
                                               offset, depth, cols, alignedCols);
    }

    __aicore__ inline void LoadSlice(LocalTensor<int8_t> a2, LocalTensor<int8_t> b2,
                                     LocalTensor<int8_t> a1, LocalTensor<int8_t> b1,
                                     int off, int slice, int alignedRows, int alignedCols, int alignedDepth, bool gemv)
    {
        if (alignedRows == 16) {
            LoadData2DParams loadA{};
            loadA.repeatTimes = gemv ? (slice + 511) / 512 : slice / 32;
            loadA.srcStride = 1;
            // GEMV reads its one row contiguously from L0A.
            LoadData(a2, a1[gemv ? currentK_+off : (currentK_+off)*alignedRows], loadA);
        } else {
            LoadData3DParamsV2<int8_t> loadA{};
            loadA.l1H = 1;
            loadA.l1W = alignedRows;
            loadA.channelSize = pitchK_;
            loadA.kExtension = slice;
            loadA.mExtension = alignedRows;
            loadA.kStartPt = currentK_+off;
            LoadData(a2, a1, loadA);
        }

        LoadData2dTransposeParams loadB{};
        if (packBytes_ != 0) {
            loadB.repeatTimes = (slice / 32) * (alignedCols / 32);
            loadB.srcStride = 1;
            loadB.dstGap = 1;
            LoadDataWithTranspose(b2, b1[off * alignedCols], loadB);
        } else if (alignedCols <= slice) {
            loadB.repeatTimes = slice / 32;
            loadB.srcStride = 1;
            loadB.dstGap = alignedCols / 16 - 1;
            for (int c = 0; c < alignedCols; c += 32) {
                LoadDataWithTranspose(b2[c * 32], b1[c * alignedDepth + off * 32], loadB);
            }
        } else {
            loadB.repeatTimes = alignedCols / 32;
            loadB.srcStride = alignedDepth / 32;
            loadB.dstGap = 1;
            for (int kk = 0; kk < slice; kk += 32) {
                LoadDataWithTranspose(b2[kk * alignedCols], b1[(off + kk) * 32], loadB);
            }
        }
    }


    GlobalTensor<int8_t> x_, weight_;
    GM_ADDR weightBase_;
    int pitchK_;
    int cachedExpert_=-1,cachedRow_=-1,cachedRows_=-1;
    int currentK_=0;
    int k_, n_, packBytes_, panelStart_;
    int produced_ = 0;
    int matrixPending_ = 0;
    bool lastLarge_ = false;
    int panelIndex_ = 0;
    int l0Index_ = 0;
};

template <int TileRows,int TileCols,class Worker>
__aicore__ inline void ProcessResidentTiles(Worker&worker,GM_ADDR groupList,GM_ADDR workspace,int experts,int n,int core){
 GlobalTensor<int64_t> groups;groups.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groupList),experts);
 GlobalTensor<int32_t> slot;slot.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(workspace)+core*kOutputSlots*kTileElements,kOutputSlots*kTileElements);
 const int cols=(n+TileCols-1)/TileCols;int start=0,total=0;
 for(int e=0;e<experts;++e){const int end=static_cast<int>(groups.GetValue(e));total+=(end-start+TileRows-1)/TileRows*cols;start=end;}
 const int lo=total*core/GetBlockNum(),hi=total*(core+1)/GetBlockNum();int base=0,bank=0;start=0;
 for(int e=0;e<experts && base<hi;++e){
  const int end=static_cast<int>(groups.GetValue(e)),tasks=(end-start+TileRows-1)/TileRows*cols;
  const int left=lo>base?lo-base:0,right=Min(tasks,hi-base);
  for(int task=left;task<right;++task){
   const int row=start+(task/cols)*TileRows,col=(task%cols)*TileCols;
   worker.Compute(slot[bank*kTileElements],e,row,col,Min(TileRows,end-row),Min(TileCols,n-col),bank);bank^=1;
  }base+=tasks;start=end;
 }
}

template <int TileRows, int TileCols, int Panel>
using CubeTile = gmg_common::StandardCube<TileRows, TileCols, Panel, kTileElements>;


template <int TileCols>
using VectorTile = gmg_common::VectorTile<TileCols, kVectorElements, 0, false, false, false>;

template <int TileRows, int TileCols, class Worker>
__aicore__ inline void ProcessTiles(Worker& worker, GM_ADDR groupList, GM_ADDR workspace,
                                    int experts, int n, int core)
{
    GlobalTensor<int64_t> groups;
    groups.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groupList), experts);
    GlobalTensor<int32_t> slot;
    slot.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(workspace) + core * kOutputSlots * kTileElements,
                         kOutputSlots * kTileElements);

    const int cores = GetBlockNum();
    const int colTiles = (n + TileCols - 1) / TileCols;
    int bank = 0;
    for (int job = core; job < experts * colTiles; job += cores) {
        const int expert = job / colTiles;
        const int col = job % colTiles * TileCols;
        const int start = expert == 0 ? 0 : static_cast<int>(groups.GetValue(expert - 1));
        const int end = static_cast<int>(groups.GetValue(expert));
        for (int row = start; row < end; row += TileRows) {
            worker.Compute(slot[bank * kTileElements], expert, row, col,
                           Min(end - row, TileRows), Min(n - col, TileCols), bank);
            bank ^= 1;
        }
    }
}
}  // namespace

template <int TileRows, int TileCols, int Panel>
__global__ GMG_ENTRY_ALIGN(8192,4096) __mix__(1, 2) void grouped_matmul_gelu_custom(
    GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groupList, GM_ADDR y,
    GM_ADDR workspace, int experts, int k, int n)
{
    AscendC::InitSocState();
    if ASCEND_IS_AIC {
        if((k+31)/32*32<=1088){
            TripleCube<TileRows,TileCols,448> worker;
            worker.Init(x,weight,k,n);
            ProcessResidentTiles<TileRows,TileCols>(worker,groupList,workspace,experts,n,AscendC::GetBlockIdx());
            worker.Finish();
        }else{
        CubeTile<TileRows, TileCols, Panel> worker;
        worker.Init(x, weight, k, n);
        ProcessTiles<TileRows, TileCols>(worker, groupList, workspace, experts, n, AscendC::GetBlockIdx());
        worker.Finish();
        }
    }
    if ASCEND_IS_AIV {
        VectorTile<TileCols> worker;
        worker.Init(scale, y, n);
        if((k+31)/32*32<=1088){
            ProcessResidentTiles<TileRows,TileCols>(worker,groupList,workspace,experts,n,AscendC::GetBlockIdx()/2);
        }else{
        ProcessTiles<TileRows, TileCols>(worker, groupList, workspace, experts, n, AscendC::GetBlockIdx() / 2);
        }
        worker.Finish();
    }
}

}
namespace path_mid_width {
using gmg_common::Min;
using gmg_common::Clear;
using gmg_common::WaitFor;
using gmg_common::GeluTanh;


namespace {
using namespace AscendC;

constexpr int kRows = 128;
constexpr int kCols = 256;
constexpr int kL0SlotBytes = 65536;
constexpr int kPanel = 1088;
constexpr int kTileElements = kRows * kCols;
constexpr int kVectorRows = kRows / 2;
constexpr int kVectorElements = kVectorRows * kCols;
constexpr int kReady = 0;
constexpr int kConsumed = 2;
constexpr int kOutputSlots = 2;


template <int TileRows, int TileCols, int Panel>
class CubeTile {
public:
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR weight, int k, int n)
    {
        x_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
        weight_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(weight));
        weightBase_ = weight;
        k_ = k;
        n_ = n;
        panelStart_ = GetBlockIdx() % ((k + Panel - 1) / Panel) * Panel;
        packBytes_ = n <= 2047 ? 1 : n % 4 == 0 ? 4 : n % 2 == 0 ? 2 : 0;
        SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);
        SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID1);
        SetFlag<HardEvent::M_MTE1>(EVENT_ID0);
        SetFlag<HardEvent::M_MTE1>(EVENT_ID1);
    }

    __aicore__ inline void Compute(const GlobalTensor<int32_t>& result, int expert,
                                   int row, int col, int rows, int cols, int bank)
    {
        const int alignedRows = (rows + 15) / 16 * 16;
        const bool gemv = rows == 1;
        const int alignedCols = (cols + 31) / 32 * 32;
        const int area = alignedRows * alignedCols;
        const bool large = area > kTileElements / 2;
        const int offset = large ? 0 : bank * kTileElements / 2;
        const auto matrixEvent = static_cast<TEventID>(bank);
        LocalTensor<int32_t> c(TPosition::CO1, offset * sizeof(int32_t), area);
        const int sliceLimit = Min(kL0SlotBytes / 2 / alignedRows, kL0SlotBytes / 2 / alignedCols) / 32 * 32;
        int kk = panelStart_;
        for (int done = 0; done < k_; done += Panel) {
            const int depth = Min(k_ - kk, Panel);
            const int alignedDepth = (depth + 31) / 32 * 32;
            const int panelSlot = 0;
            LocalTensor<int8_t> a1(TPosition::A1, panelSlot * TileRows * Panel, TileRows * Panel);
            LocalTensor<int8_t> b1(TPosition::B1, TileRows * Panel,
                                  Panel * TileCols);

            WaitFlag<HardEvent::MTE1_MTE2>(static_cast<TEventID>(panelSlot));
            LoadPanel(a1, b1, expert, row, col, rows, cols, kk, depth, alignedRows, alignedCols, alignedDepth,
                      expert == lastExpert_ && col == lastCol_);
            lastExpert_ = expert; lastCol_ = col;
            SetFlag<HardEvent::MTE2_MTE1>(static_cast<TEventID>(panelSlot));
            WaitFlag<HardEvent::MTE2_MTE1>(static_cast<TEventID>(panelSlot));

            for (int off = 0; off < alignedDepth; off += sliceLimit) {
                const int slice = Min(alignedDepth - off, sliceLimit);
                const auto l0slot=static_cast<TEventID>(l0Index_++ & 1);
                LocalTensor<int8_t> a2(TPosition::A2, static_cast<int>(l0slot)*kL0SlotBytes/2, kL0SlotBytes/2);
                LocalTensor<int8_t> b2(TPosition::B2, static_cast<int>(l0slot)*kL0SlotBytes/2, kL0SlotBytes/2);
                WaitFlag<HardEvent::M_MTE1>(l0slot);
                LoadSlice(a2, b2, a1, b1, off, slice, alignedRows, alignedCols, alignedDepth, gemv);
                if (off + slice == alignedDepth) {
                    SetFlag<HardEvent::MTE1_MTE2>(static_cast<TEventID>(panelSlot));
                }
                SetFlag<HardEvent::MTE1_M>(l0slot);
                WaitFlag<HardEvent::MTE1_M>(l0slot);

                const bool first = done == 0 && off == 0;
                if (first) {
                    WaitForMatrix(large || lastLarge_ ? 3 : 1 << bank);
                }
                MmadParams mm{};
                mm.m = gemv ? 1 : alignedRows;
                mm.n = alignedCols;
                mm.k = slice;
                mm.cmatrixInitVal = first;
                Mmad(c, a2, b2, mm);
                SetFlag<HardEvent::M_MTE1>(l0slot);
            }
            // Start each core at a different K panel to spread GM requests.
            kk = kk + Panel < k_ ? kk + Panel : 0;
        }

        SetFlag<HardEvent::M_FIX>(matrixEvent);
        WaitFlag<HardEvent::M_FIX>(matrixEvent);
        if ((produced_ & (1 << bank)) != 0) {
            CrossCoreWaitFlag<0x2>(kConsumed + bank);
        }
        FixpipeParamsV220 store{};
        store.mSize = rows;
        store.nSize = alignedCols;
        store.srcStride = alignedRows;
        store.dstStride = alignedCols;
        store.ndNum = 1;
        Fixpipe<int32_t, int32_t, CFG_ROW_MAJOR>(result, c, store);
        SetFlag<HardEvent::FIX_M>(matrixEvent);
        matrixPending_ |= 1 << bank;
        lastLarge_ = large;
        CrossCoreSetFlag<0x2, PIPE_FIX>(kReady + bank);
        produced_ |= 1 << bank;
    }

    __aicore__ inline void Finish()
    {
        for (int slot = 0; slot < 2; ++slot) {
            if ((produced_ & (1 << slot)) != 0) {
                CrossCoreWaitFlag<0x2>(kConsumed + slot);
            }
            WaitFlag<HardEvent::MTE1_MTE2>(static_cast<TEventID>(slot));
        }
        WaitFlag<HardEvent::M_MTE1>(EVENT_ID0);
        WaitFlag<HardEvent::M_MTE1>(EVENT_ID1);
        WaitForMatrix(3);
    }

private:
    __aicore__ inline void WaitForMatrix(int overlap)
    {
        const int ready = matrixPending_ & overlap;
        if ((ready & 1) != 0) {
            WaitFlag<HardEvent::FIX_M>(EVENT_ID0);
        }
        if ((ready & 2) != 0) {
            WaitFlag<HardEvent::FIX_M>(EVENT_ID1);
        }
        matrixPending_ &= ~overlap;
    }

    __aicore__ inline void LoadPanel(LocalTensor<int8_t> a1, LocalTensor<int8_t> b1,
                                     int expert, int row, int col, int rows, int cols,
                                     int kk, int depth, int alignedRows, int alignedCols, int alignedDepth, bool reuse)
    {
        // ND2NZ pads each K chunk of A and each N chunk of B. Fill only
        // the remaining row gaps in the destination fractals.
        if (rows != 1 && rows != alignedRows) {
            Clear(a1[rows * 32], alignedDepth / 32, alignedRows - rows, rows);
        }
        Nd2NzParams aCopy{};
        aCopy.ndNum = 1;
        aCopy.nValue = rows;
        aCopy.dValue = depth;
        aCopy.srcDValue = k_;
        aCopy.dstNzC0Stride = rows == 1 ? 1 : alignedRows;
        aCopy.dstNzNStride = 1;
        DataCopy(a1, x_[row * k_ + kk], aCopy);

        if (reuse) { return; }
        const int offset = (expert * k_ + kk) * n_ + col;
        switch (packBytes_) {
            case 1:
                LoadPackedWeight<int8_t>(b1, offset, depth, cols, alignedCols);
                break;
            case 2:
                LoadPackedWeight<int16_t>(b1, offset, depth, cols, alignedCols);
                break;
            case 4:
                LoadPackedWeight<int32_t>(b1, offset, depth, cols, alignedCols);
                break;
            default: {
                if (depth != alignedDepth) {
                    Clear(b1[depth * 32], alignedCols / 32, alignedDepth - depth, depth);
                }
                Nd2NzParams bCopy{};
                bCopy.ndNum = 1;
                bCopy.nValue = depth;
                bCopy.dValue = cols;
                bCopy.srcDValue = n_;
                bCopy.dstNzC0Stride = alignedDepth;
                bCopy.dstNzNStride = 1;
                DataCopy(b1, weight_[offset], bCopy);
                break;
            }
        }
    }

    template <class CopyT>
    __aicore__ inline void LoadPackedWeight(LocalTensor<int8_t> b1, int offset,
                                           int depth, int cols, int alignedCols)
    {
        gmg_common::LoadPackedWeight<CopyT>(b1, weightBase_, n_,
                                               offset, depth, cols, alignedCols);
    }

    __aicore__ inline void LoadSlice(LocalTensor<int8_t> a2, LocalTensor<int8_t> b2,
                                     LocalTensor<int8_t> a1, LocalTensor<int8_t> b1,
                                     int off, int slice, int alignedRows, int alignedCols, int alignedDepth, bool gemv)
    {
        if (alignedRows == 16) {
            LoadData2DParams loadA{};
            loadA.repeatTimes = gemv ? (slice + 511) / 512 : slice / 32;
            loadA.srcStride = 1;
            // GEMV reads its one row contiguously from L0A.
            LoadData(a2, a1[gemv ? off : off * alignedRows], loadA);
        } else {
            LoadData3DParamsV2<int8_t> loadA{};
            loadA.l1H = 1;
            loadA.l1W = alignedRows;
            loadA.channelSize = alignedDepth;
            loadA.kExtension = slice;
            loadA.mExtension = alignedRows;
            loadA.kStartPt = off;
            LoadData(a2, a1, loadA);
        }

        LoadData2dTransposeParams loadB{};
        if (packBytes_ != 0) {
            loadB.repeatTimes = (slice / 32) * (alignedCols / 32);
            loadB.srcStride = 1;
            loadB.dstGap = 1;
            LoadDataWithTranspose(b2, b1[off * alignedCols], loadB);
        } else if (alignedCols <= slice) {
            loadB.repeatTimes = slice / 32;
            loadB.srcStride = 1;
            loadB.dstGap = alignedCols / 16 - 1;
            for (int c = 0; c < alignedCols; c += 32) {
                LoadDataWithTranspose(b2[c * 32], b1[c * alignedDepth + off * 32], loadB);
            }
        } else {
            loadB.repeatTimes = alignedCols / 32;
            loadB.srcStride = alignedDepth / 32;
            loadB.dstGap = 1;
            for (int kk = 0; kk < slice; kk += 32) {
                LoadDataWithTranspose(b2[kk * alignedCols], b1[(off + kk) * 32], loadB);
            }
        }
    }


    GlobalTensor<int8_t> x_, weight_;
    GM_ADDR weightBase_;
    int k_, n_, packBytes_, panelStart_;
    int produced_ = 0;
    int matrixPending_ = 0;
    bool lastLarge_ = false;
    int panelIndex_ = 0;
    int l0Index_ = 0;
    int lastExpert_ = -1, lastCol_ = -1;
};


template <int TileCols>
using VectorTile = gmg_common::VectorTile<TileCols, kVectorElements, 0, false, false, false>;

template <int TileRows, int TileCols, class Worker>
__aicore__ inline void ProcessTiles(Worker& worker, GM_ADDR groupList, GM_ADDR workspace,
                                    int experts, int n, int core)
{
    GlobalTensor<int64_t> groups;
    groups.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groupList), experts);
    GlobalTensor<int32_t> slot;
    slot.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(workspace) + core * kOutputSlots * kTileElements,
                         kOutputSlots * kTileElements);
    const int cores=GetBlockNum();
    const int colTiles=(n+TileCols-1)/TileCols;
    constexpr int rowsPerJob=TileRows*3;
    int start=0,next=core,bank=0;
    for(int expert=0;expert<experts;++expert) {
        const int end=static_cast<int>(groups.GetValue(expert));
        const int jobs=((end-start+rowsPerJob-1)/rowsPerJob)*colTiles;
        for(;next<jobs;next+=cores) {
            const int rowStart=start+(next/colTiles)*rowsPerJob;
            const int rowEnd=Min(end,rowStart+rowsPerJob);
            const int col=next%colTiles*TileCols;
            for(int row=rowStart;row<rowEnd;row+=TileRows) {
                worker.Compute(slot[bank*kTileElements],expert,row,col,
                               Min(rowEnd-row,TileRows),Min(n-col,TileCols),bank);
                bank^=1;
            }
        }
        next-=jobs;start=end;
    }
}

}  // namespace

template <int TileRows, int TileCols, int Panel>
__global__ GMG_ENTRY_ALIGN(8192,2048) __mix__(1, 2) void grouped_matmul_gelu_custom(
    GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groupList, GM_ADDR y,
    GM_ADDR workspace, int experts, int k, int n)
{
    AscendC::InitSocState();
    if ASCEND_IS_AIC {
        CubeTile<TileRows, TileCols, Panel> worker;
        worker.Init(x, weight, k, n);
        ProcessTiles<TileRows, TileCols>(worker, groupList, workspace, experts, n, AscendC::GetBlockIdx());
        worker.Finish();
    }
    if ASCEND_IS_AIV {
        VectorTile<TileCols> worker;
        worker.Init(scale, y, n);
        ProcessTiles<TileRows, TileCols>(worker, groupList, workspace, experts, n, AscendC::GetBlockIdx() / 2);
        worker.Finish();
    }
}


}
namespace path_small_matrix {
using gmg_common::Min;
using gmg_common::Clear;
using gmg_common::WaitFor;
using gmg_common::GeluTanh;


namespace {
using namespace AscendC;

constexpr int kRows = 128;
constexpr int kCols = 256;
constexpr int kL0SlotBytes = 65536;
constexpr int kPanel = 512;
constexpr int kTileElements = kRows * kCols;
constexpr int kVectorRows = kRows / 2;
constexpr int kVectorElements = kVectorRows * kCols;
constexpr int kReady = 0;
constexpr int kConsumed = 2;
constexpr int kOutputSlots = 2;


template <int TileRows, int TileCols, int Panel>
using CubeTile = gmg_common::StandardCube<TileRows, TileCols, Panel, kTileElements>;


template <int TileCols>
using VectorTile = gmg_common::VectorTile<TileCols, kVectorElements, 0, false, false, false>;

template <int TileRows, int TileCols, class Worker>
__aicore__ inline void ProcessTiles(Worker& worker, GM_ADDR groupList, GM_ADDR workspace,
                                    int experts, int n, int core)
{
    GlobalTensor<int64_t> groups;
    groups.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groupList), experts);
    GlobalTensor<int32_t> slot;
    slot.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(workspace) + core * kOutputSlots * kTileElements,
                         kOutputSlots * kTileElements);

    const int cores = GetBlockNum();
    const int colTiles = (n + TileCols - 1) / TileCols;
    int start = 0;
    int next = core;
    int bank = 0;
    for (int expert = 0; expert < experts; ++expert) {
        const int end = static_cast<int>(groups.GetValue(expert));
        const int tiles = ((end - start + TileRows - 1) / TileRows) * colTiles;
        for (; next < tiles; next += cores) {
            const int row = start + next / colTiles * TileRows;
            const int col = next % colTiles * TileCols;
            worker.Compute(slot[bank * kTileElements], expert, row, col,
                           Min(end - row, TileRows), Min(n - col, TileCols), bank);
            bank ^= 1;
        }
        next -= tiles;
        start = end;
    }
}
}  // namespace

template <int TileRows, int TileCols, int Panel>
__global__ GMG_ENTRY_ALIGN(4096,2048) __mix__(1, 2) void grouped_matmul_gelu_custom(
    GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groupList, GM_ADDR y,
    GM_ADDR workspace, int experts, int k, int n)
{
    // This geometry fits one tile: one Cube and its two Vector subcores work.
    // Extra launch groups return before touching workspace or event flags.
    static_assert(TileRows >= 128 && TileCols >= 256, "single-tile small matrix");
    if ASCEND_IS_AIC { if (AscendC::GetBlockIdx() != 0) { return; } }
    if ASCEND_IS_AIV { if (AscendC::GetBlockIdx() / 2 != 0) { return; } }
    AscendC::InitSocState();
    if ASCEND_IS_AIC {
        CubeTile<TileRows, TileCols, Panel> worker;
        worker.Init(x, weight, k, n);
        ProcessTiles<TileRows, TileCols>(worker, groupList, workspace, experts, n, AscendC::GetBlockIdx());
        worker.Finish();
    }
    if ASCEND_IS_AIV {
        VectorTile<TileCols> worker;
        worker.Init(scale, y, n);
        ProcessTiles<TileRows, TileCols>(worker, groupList, workspace, experts, n, AscendC::GetBlockIdx() / 2);
        worker.Finish();
    }
}

}

namespace path_aligned_resident_a {
using gmg_common::Min;
using gmg_common::Clear;
using gmg_common::WaitFor;
using gmg_common::GeluTanh;


namespace {
using namespace AscendC;

constexpr int kRows = 128;
constexpr int kCols = 256;
constexpr int kL0SlotBytes = 65536;
constexpr int kPanel = 512;
constexpr int kTileElements = kRows * kCols;
constexpr int kVectorRows = kRows / 2;
constexpr int kVectorElements = kVectorRows * kCols;
constexpr int kReady = 0;
constexpr int kConsumed = 2;
constexpr int kOutputSlots = 2;


template <int TileRows, int TileCols, int Panel>
class CubeTile {
public:
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR weight, int k, int n)
    {
        x_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
        weight_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(weight));
        weightBase_ = weight;
        k_ = k;
        n_ = n;
        panelStart_ = GetBlockIdx() % ((k + Panel - 1) / Panel) * Panel;
        packBytes_=4;
        SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID2);
        SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);
        SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID1);
        SetFlag<HardEvent::M_MTE1>(EVENT_ID0);
    }

    __aicore__ inline void Compute(const GlobalTensor<int32_t>& result, int expert,
                                   int row, int col, int rows, int cols, int bank)
    {
        const int alignedRows = (rows + 15) / 16 * 16;
        if(col==0){
            WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID2);
            LocalTensor<int8_t> resident(TPosition::A1,0,131072);
            if(rows!=1 && rows!=alignedRows)Clear(resident[rows*32],k_/32,alignedRows-rows,rows);
            Nd2NzParams cp{};cp.ndNum=1;cp.nValue=rows;cp.dValue=k_;cp.srcDValue=k_;cp.dstNzC0Stride=rows==1?1:alignedRows;cp.dstNzNStride=1;
            DataCopy(resident,x_[row*k_],cp);
            SetFlag<HardEvent::MTE2_MTE1>(EVENT_ID2);WaitFlag<HardEvent::MTE2_MTE1>(EVENT_ID2);
        }

        const bool gemv = rows == 1;
        const int alignedCols = (cols + 31) / 32 * 32;
        const int area = alignedRows * alignedCols;
        const bool large = area > kTileElements / 2;
        const int offset = large ? 0 : bank * kTileElements / 2;
        const auto matrixEvent = static_cast<TEventID>(bank);
        LocalTensor<int32_t> c(TPosition::CO1, offset * sizeof(int32_t), area);
        const int sliceLimit = Min(kL0SlotBytes / alignedRows, kL0SlotBytes / alignedCols) / 32 * 32;
        const int panelDepth=128;
        int kk=(GetBlockIdx()*3)%((k_+panelDepth-1)/panelDepth)*panelDepth;
        int panelSlot = panelIndex_ & 1;
        PrefetchPanel(panelSlot, expert, row, col, rows, cols, kk, alignedRows, alignedCols);
        for (int done = 0; done < k_; done += panelDepth) {
            const int depth = Min(k_ - kk, panelDepth);
            const int alignedDepth = (depth + 31) / 32 * 32;
            const int nextK = kk + panelDepth < k_ ? kk + panelDepth : 0;
            if (done + panelDepth < k_) {
                PrefetchPanel(panelSlot ^ 1, expert, row, col, rows, cols, nextK, alignedRows, alignedCols);
            }
            LocalTensor<int8_t> a1(TPosition::A1, 0, 131072);
            LocalTensor<int8_t> b1(TPosition::B1, 131072 + panelSlot * 196608,
                                  196608);
            WaitFlag<HardEvent::MTE2_MTE1>(static_cast<TEventID>(panelSlot));

            for (int off = 0; off < alignedDepth; off += sliceLimit) {
                const int slice = Min(alignedDepth - off, sliceLimit);
                const auto l0slot=EVENT_ID0;
                LocalTensor<int8_t> a2(TPosition::A2, static_cast<int>(l0slot)*kL0SlotBytes, kL0SlotBytes);
                LocalTensor<int8_t> b2(TPosition::B2, static_cast<int>(l0slot)*kL0SlotBytes, kL0SlotBytes);
                WaitFlag<HardEvent::M_MTE1>(l0slot);
                currentK_=kk;
                LoadSlice(a2, b2, a1, b1, off, slice, alignedRows, alignedCols, alignedDepth, gemv);
                if (off + slice == alignedDepth) {
                    SetFlag<HardEvent::MTE1_MTE2>(static_cast<TEventID>(panelSlot));
                    if(done+panelDepth>=k_ && col+cols==n_)SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID2);
                }
                SetFlag<HardEvent::MTE1_M>(l0slot);
                WaitFlag<HardEvent::MTE1_M>(l0slot);

                const bool first = done == 0 && off == 0;
                if (first) {
                    WaitForMatrix(large || lastLarge_ ? 3 : 1 << bank);
                }
                MmadParams mm{};
                mm.m = gemv ? 1 : alignedRows;
                mm.n = alignedCols;
                mm.k = slice;
                mm.cmatrixInitVal = first;
                Mmad(c, a2, b2, mm);
                SetFlag<HardEvent::M_MTE1>(l0slot);
            }
            // Start each core at a different K panel to spread GM requests.
            kk = nextK;
            panelSlot ^= 1;
            ++panelIndex_;
        }

        SetFlag<HardEvent::M_FIX>(matrixEvent);
        WaitFlag<HardEvent::M_FIX>(matrixEvent);
        if ((produced_ & (1 << bank)) != 0) {
            CrossCoreWaitFlag<0x2>(kConsumed + bank);
        }
        FixpipeParamsV220 store{};
        store.mSize = rows;
        store.nSize = alignedCols;
        store.srcStride = alignedRows;
        store.dstStride = alignedCols;
        store.ndNum = 1;
        Fixpipe<int32_t, int32_t, CFG_ROW_MAJOR>(result, c, store);
        SetFlag<HardEvent::FIX_M>(matrixEvent);
        matrixPending_ |= 1 << bank;
        lastLarge_ = large;
        CrossCoreSetFlag<0x2, PIPE_FIX>(kReady + bank);
        produced_ |= 1 << bank;
    }

    __aicore__ inline void Finish()
    {
        for (int slot = 0; slot < 2; ++slot) {
            if ((produced_ & (1 << slot)) != 0) {
                CrossCoreWaitFlag<0x2>(kConsumed + slot);
            }
            WaitFlag<HardEvent::MTE1_MTE2>(static_cast<TEventID>(slot));
        }
        WaitFlag<HardEvent::M_MTE1>(EVENT_ID0);
        WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID2);
        WaitForMatrix(3);
    }

private:
    __aicore__ inline void WaitForMatrix(int overlap)
    {
        const int ready = matrixPending_ & overlap;
        if ((ready & 1) != 0) {
            WaitFlag<HardEvent::FIX_M>(EVENT_ID0);
        }
        if ((ready & 2) != 0) {
            WaitFlag<HardEvent::FIX_M>(EVENT_ID1);
        }
        matrixPending_ &= ~overlap;
    }

__aicore__ inline void PrefetchPanel(int slot, int expert, int row, int col,
                                        int rows, int cols, int kk, int alignedRows, int alignedCols)
    {
        LocalTensor<int8_t> a1(TPosition::A1, slot * 65536, 65536);
        LocalTensor<int8_t> b1(TPosition::B1, 131072 + slot * 196608, 196608);
        const int panelDepth=128;
        const int depth = Min(k_ - kk, panelDepth);
        const int alignedDepth = (depth + 31) / 32 * 32;
        const auto event = static_cast<TEventID>(slot);
        WaitFlag<HardEvent::MTE1_MTE2>(event);
        LoadPanel(a1, b1, expert, row, col, rows, cols, kk, depth, alignedRows, alignedCols, alignedDepth);
        SetFlag<HardEvent::MTE2_MTE1>(event);
    }

    __aicore__ inline void LoadPanel(LocalTensor<int8_t> a1, LocalTensor<int8_t> b1,
                                     int expert, int row, int col, int rows, int cols,
                                     int kk, int depth, int alignedRows, int alignedCols, int alignedDepth)
    {
        const int offset = (expert * k_ + kk) * n_ + col;
        switch (packBytes_) {
            case 1:
                LoadPackedWeight<int8_t>(b1, offset, depth, cols, alignedCols);
                break;
            case 2:
                LoadPackedWeight<int16_t>(b1, offset, depth, cols, alignedCols);
                break;
            case 4:
                LoadPackedWeight<int32_t>(b1, offset, depth, cols, alignedCols);
                break;
            default: {
                if (depth != alignedDepth) {
                    Clear(b1[depth * 32], alignedCols / 32, alignedDepth - depth, depth);
                }
                Nd2NzParams bCopy{};
                bCopy.ndNum = 1;
                bCopy.nValue = depth;
                bCopy.dValue = cols;
                bCopy.srcDValue = n_;
                bCopy.dstNzC0Stride = alignedDepth;
                bCopy.dstNzNStride = 1;
                DataCopy(b1, weight_[offset], bCopy);
                break;
            }
        }
    }

    template <class CopyT>
    __aicore__ inline void LoadPackedWeight(LocalTensor<int8_t> b1, int offset,
                                           int depth, int cols, int alignedCols)
    {
        gmg_common::LoadPackedWeight<CopyT>(b1, weightBase_, n_,
                                               offset, depth, cols, alignedCols);
    }

    __aicore__ inline void LoadSlice(LocalTensor<int8_t> a2, LocalTensor<int8_t> b2,
                                     LocalTensor<int8_t> a1, LocalTensor<int8_t> b1,
                                     int off, int slice, int alignedRows, int alignedCols, int alignedDepth, bool gemv)
    {
        if (alignedRows == 16) {
            LoadData2DParams loadA{};
            loadA.repeatTimes = gemv ? (slice + 511) / 512 : slice / 32;
            loadA.srcStride = 1;
            // GEMV reads its one row contiguously from L0A.
            LoadData(a2, a1[gemv ? currentK_+off : (currentK_+off)*alignedRows], loadA);
        } else {
            LoadData3DParamsV2<int8_t> loadA{};
            loadA.l1H = 1;
            loadA.l1W = alignedRows;
            loadA.channelSize = k_;
            loadA.kExtension = slice;
            loadA.mExtension = alignedRows;
            loadA.kStartPt = currentK_+off;
            LoadData(a2, a1, loadA);
        }

        LoadData2dTransposeParams loadB{};
        if (packBytes_ != 0) {
            loadB.repeatTimes = (slice / 32) * (alignedCols / 32);
            loadB.srcStride = 1;
            loadB.dstGap = 1;
            LoadDataWithTranspose(b2, b1[off * alignedCols], loadB);
        } else if (alignedCols <= slice) {
            loadB.repeatTimes = slice / 32;
            loadB.srcStride = 1;
            loadB.dstGap = alignedCols / 16 - 1;
            for (int c = 0; c < alignedCols; c += 32) {
                LoadDataWithTranspose(b2[c * 32], b1[c * alignedDepth + off * 32], loadB);
            }
        } else {
            loadB.repeatTimes = alignedCols / 32;
            loadB.srcStride = alignedDepth / 32;
            loadB.dstGap = 1;
            for (int kk = 0; kk < slice; kk += 32) {
                LoadDataWithTranspose(b2[kk * alignedCols], b1[(off + kk) * 32], loadB);
            }
        }
    }


    GlobalTensor<int8_t> x_, weight_;
    GM_ADDR weightBase_;
    int currentK_=0;
    int k_, n_, packBytes_, panelStart_;
    int produced_ = 0;
    int matrixPending_ = 0;
    bool lastLarge_ = false;
    int panelIndex_ = 0;
    int l0Index_ = 0;
};


template <int TileCols>
using VectorTile = gmg_common::VectorTile<TileCols, kVectorElements, 256, false, false, false>;

template <int TileRows,int TileCols,class Worker>
__aicore__ inline void ProcessTiles(Worker&worker,GM_ADDR groupList,GM_ADDR workspace,int experts,int n,int core){
 GlobalTensor<int64_t>groups;groups.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groupList),experts);
 GlobalTensor<int32_t>slot;slot.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(workspace)+core*kOutputSlots*kTileElements,kOutputSlots*kTileElements);
 const int cores=GetBlockNum();int bank=0;
const int m=static_cast<int>(groups.GetValue(experts-1));
 for(int begin=core*TileRows;begin<m;begin+=cores*TileRows){const int limit=Min(m,begin+TileRows);int e=begin*experts/m;int end=static_cast<int>(groups.GetValue(e));
  while(end<=begin){++e;end=static_cast<int>(groups.GetValue(e));}
  while(e>0){const int previous=static_cast<int>(groups.GetValue(e-1));if(previous<=begin)break;--e;end=previous;}
  int row=begin;
  while(row<limit){
   if(end>row){const int rows=Min(end,limit)-row;
    for(int col=0;col<n;col+=TileCols){worker.Compute(slot[bank*kTileElements],e,row,col,rows,Min(TileCols,n-col),bank);bank^=1;}
    row+=rows;
   }if(row<limit){++e;end=static_cast<int>(groups.GetValue(e));}
  }
 }
}

}  // namespace

template <int TileRows, int TileCols, int Panel>
__global__ GMG_ENTRY_ALIGN(4096,4096) __mix__(1, 2) void grouped_matmul_gelu_custom(
    GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groupList, GM_ADDR y,
    GM_ADDR workspace, int experts, int k, int n)
{
    AscendC::InitSocState();
    if ASCEND_IS_AIC {
        CubeTile<TileRows, TileCols, Panel> worker;
        worker.Init(x, weight, k, n);
        ProcessTiles<TileRows, TileCols>(worker, groupList, workspace, experts, n, AscendC::GetBlockIdx());
        worker.Finish();
    }
    if ASCEND_IS_AIV {
        VectorTile<TileCols> worker;
        worker.Init(scale, y, n);
        ProcessTiles<TileRows, TileCols>(worker, groupList, workspace, experts, n, AscendC::GetBlockIdx() / 2);
        worker.Finish();
    }
}


}
namespace path_mid_prefetch {
using gmg_common::Min;
using gmg_common::Clear;
using gmg_common::WaitFor;
using gmg_common::GeluTanh;


namespace {
using namespace AscendC;

constexpr int kRows = 128;
constexpr int kCols = 256;
constexpr int kL0SlotBytes = 65536;
constexpr int kPanel = 1088;
constexpr int kTileElements = kRows * kCols;
constexpr int kVectorRows = kRows / 2;
constexpr int kVectorElements = kVectorRows * kCols;
constexpr int kReady = 0;
constexpr int kConsumed = 2;
constexpr int kOutputSlots = 2;


template <int TileRows, int TileCols, int Panel>
class CubeTile {
public:
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR weight, int k, int n)
    {
        x_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
        weight_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(weight));
        weightBase_ = weight;
        k_ = k;
        n_ = n;
        panelStart_ = GetBlockIdx() % ((k + Panel - 1) / Panel) * Panel;
        packBytes_ = n <= 2047 ? 1 : n % 4 == 0 ? 4 : n % 2 == 0 ? 2 : 0;
        SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID2);
        SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);
        SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID1);
        SetFlag<HardEvent::M_MTE1>(EVENT_ID0);
        SetFlag<HardEvent::M_MTE1>(EVENT_ID1);
    }

    __aicore__ inline void SetRowEnd(int e){rowEnd_=e;}
    __aicore__ inline void Compute(const GlobalTensor<int32_t>& result, int expert,
                                   int row, int col, int rows, int cols, int bank)
    {
        const int alignedRows = (rows + 15) / 16 * 16;
        const bool gemv = false;
        const int alignedCols = (cols + 31) / 32 * 32;
        const int area = alignedRows * alignedCols;
        const bool large = area > kTileElements / 2;
        const int offset = large ? 0 : bank * kTileElements / 2;
        const auto matrixEvent = static_cast<TEventID>(bank);
        LocalTensor<int32_t> c(TPosition::CO1, offset * sizeof(int32_t), area);
        const int sliceLimit = Min(kL0SlotBytes / 2 / alignedRows, kL0SlotBytes / 2 / alignedCols) / 32 * 32;
        int kk = panelStart_;
        for (int done = 0; done < k_; done += Panel) {
            const int depth = Min(k_ - kk, Panel);
            const int alignedDepth = (depth + 31) / 32 * 32;
            const int panelSlot=aIndex_++&1;
            LocalTensor<int8_t> a1(TPosition::A1, panelSlot * TileRows * Panel, TileRows * Panel);
            LocalTensor<int8_t> b1(TPosition::B1, 2 * TileRows * Panel,
                                  Panel * TileCols);

            if(!prepared_){
                WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID2);
                WaitFlag<HardEvent::MTE1_MTE2>(static_cast<TEventID>(panelSlot));
                LoadPanel(a1,b1,expert,row,col,rows,cols,kk,depth,alignedRows,alignedCols,alignedDepth,expert==lastExpert_ && col==lastCol_);
                SetFlag<HardEvent::MTE2_MTE1>(static_cast<TEventID>(panelSlot));
            }
            prepared_=false;lastExpert_=expert;lastCol_=col;
            if(row+TileRows<rowEnd_){
                const int other=panelSlot^1,nr=Min(TileRows,rowEnd_-row-TileRows),ar=(nr+15)/16*16;
                LocalTensor<int8_t>next(TPosition::A1,other*TileRows*Panel,TileRows*Panel);
                WaitFlag<HardEvent::MTE1_MTE2>(static_cast<TEventID>(other));
                LoadPanel(next,b1,expert,row+TileRows,col,nr,cols,kk,depth,ar,alignedCols,alignedDepth,true);
                SetFlag<HardEvent::MTE2_MTE1>(static_cast<TEventID>(other));prepared_=true;
            }
            WaitFlag<HardEvent::MTE2_MTE1>(static_cast<TEventID>(panelSlot));

            for (int off = 0; off < alignedDepth; off += sliceLimit) {
                const int slice = Min(alignedDepth - off, sliceLimit);
                const auto l0slot=static_cast<TEventID>(l0Index_++ & 1);
                LocalTensor<int8_t> a2(TPosition::A2, static_cast<int>(l0slot)*kL0SlotBytes/2, kL0SlotBytes/2);
                LocalTensor<int8_t> b2(TPosition::B2, static_cast<int>(l0slot)*kL0SlotBytes/2, kL0SlotBytes/2);
                WaitFlag<HardEvent::M_MTE1>(l0slot);
                LoadSlice(a2, b2, a1, b1, off, slice, alignedRows, alignedCols, alignedDepth, gemv);
                if (off + slice == alignedDepth) {
                    SetFlag<HardEvent::MTE1_MTE2>(static_cast<TEventID>(panelSlot));
                    if(row+TileRows>=rowEnd_)SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID2);
                }
                SetFlag<HardEvent::MTE1_M>(l0slot);
                WaitFlag<HardEvent::MTE1_M>(l0slot);

                const bool first = done == 0 && off == 0;
                if (first) {
                    WaitForMatrix(large || lastLarge_ ? 3 : 1 << bank);
                }
                MmadParams mm{};
                mm.m = gemv ? 1 : alignedRows;
                mm.n = alignedCols;
                mm.k = slice;
                mm.cmatrixInitVal = first;
                Mmad(c, a2, b2, mm);
                if ((mm.m / 16) * (mm.n / 16) < 10) { PipeBarrier<PIPE_M>(); }
                SetFlag<HardEvent::M_MTE1>(l0slot);
            }
            // Start each core at a different K panel to spread GM requests.
            kk = kk + Panel < k_ ? kk + Panel : 0;
        }

        SetFlag<HardEvent::M_FIX>(matrixEvent);
        WaitFlag<HardEvent::M_FIX>(matrixEvent);
        if ((produced_ & (1 << bank)) != 0) {
            CrossCoreWaitFlag<0x2>(kConsumed + bank);
        }
        FixpipeParamsV220 store{};
        store.mSize = rows;
        store.nSize = alignedCols;
        store.srcStride = alignedRows;
        store.dstStride = alignedCols;
        store.ndNum = 1;
        Fixpipe<int32_t, int32_t, CFG_ROW_MAJOR>(result, c, store);
        SetFlag<HardEvent::FIX_M>(matrixEvent);
        matrixPending_ |= 1 << bank;
        lastLarge_ = large;
        CrossCoreSetFlag<0x2, PIPE_FIX>(kReady + bank);
        produced_ |= 1 << bank;
    }

    __aicore__ inline void Finish()
    {
        for (int slot = 0; slot < 2; ++slot) {
            if ((produced_ & (1 << slot)) != 0) {
                CrossCoreWaitFlag<0x2>(kConsumed + slot);
            }
            WaitFlag<HardEvent::MTE1_MTE2>(static_cast<TEventID>(slot));
        }
        WaitFlag<HardEvent::M_MTE1>(EVENT_ID0);
        WaitFlag<HardEvent::M_MTE1>(EVENT_ID1);
        WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID2);
        WaitForMatrix(3);
    }

private:
    __aicore__ inline void WaitForMatrix(int overlap)
    {
        const int ready = matrixPending_ & overlap;
        if ((ready & 1) != 0) {
            WaitFlag<HardEvent::FIX_M>(EVENT_ID0);
        }
        if ((ready & 2) != 0) {
            WaitFlag<HardEvent::FIX_M>(EVENT_ID1);
        }
        matrixPending_ &= ~overlap;
    }

    __aicore__ inline void LoadPanel(LocalTensor<int8_t> a1, LocalTensor<int8_t> b1,
                                     int expert, int row, int col, int rows, int cols,
                                     int kk, int depth, int alignedRows, int alignedCols, int alignedDepth, bool reuse)
    {
        // ND2NZ pads each K chunk of A and each N chunk of B. Fill only
        // the remaining row gaps in the destination fractals.
        if (rows != alignedRows) {
            Clear(a1[rows * 32], alignedDepth / 32, alignedRows - rows, rows);
        }
        Nd2NzParams aCopy{};
        aCopy.ndNum = 1;
        aCopy.nValue = rows;
        aCopy.dValue = depth;
        aCopy.srcDValue = k_;
        aCopy.dstNzC0Stride = alignedRows;
        aCopy.dstNzNStride = 1;
        DataCopy(a1, x_[row * k_ + kk], aCopy);

        if (reuse) { return; }
        const int offset = (expert * k_ + kk) * n_ + col;
        switch (packBytes_) {
            case 1:
                LoadPackedWeight<int8_t>(b1, offset, depth, cols, alignedCols);
                break;
            case 2:
                LoadPackedWeight<int16_t>(b1, offset, depth, cols, alignedCols);
                break;
            case 4:
                LoadPackedWeight<int32_t>(b1, offset, depth, cols, alignedCols);
                break;
            default: {
                if (depth != alignedDepth) {
                    Clear(b1[depth * 32], alignedCols / 32, alignedDepth - depth, depth);
                }
                Nd2NzParams bCopy{};
                bCopy.ndNum = 1;
                bCopy.nValue = depth;
                bCopy.dValue = cols;
                bCopy.srcDValue = n_;
                bCopy.dstNzC0Stride = alignedDepth;
                bCopy.dstNzNStride = 1;
                DataCopy(b1, weight_[offset], bCopy);
                break;
            }
        }
    }

    template <class CopyT>
    __aicore__ inline void LoadPackedWeight(LocalTensor<int8_t> b1, int offset,
                                           int depth, int cols, int alignedCols)
    {
        gmg_common::LoadPackedWeight<CopyT>(b1, weightBase_, n_,
                                               offset, depth, cols, alignedCols);
    }

    __aicore__ inline void LoadSlice(LocalTensor<int8_t> a2, LocalTensor<int8_t> b2,
                                     LocalTensor<int8_t> a1, LocalTensor<int8_t> b1,
                                     int off, int slice, int alignedRows, int alignedCols, int alignedDepth, bool gemv)
    {
        if (alignedRows == 16) {
            LoadData2DParams loadA{};
            loadA.repeatTimes = gemv ? (slice + 511) / 512 : slice / 32;
            loadA.srcStride = 1;
            // GEMV reads its one row contiguously from L0A.
            LoadData(a2, a1[gemv ? off : off * alignedRows], loadA);
        } else {
            LoadData3DParamsV2<int8_t> loadA{};
            loadA.l1H = 1;
            loadA.l1W = alignedRows;
            loadA.channelSize = alignedDepth;
            loadA.kExtension = slice;
            loadA.mExtension = alignedRows;
            loadA.kStartPt = off;
            LoadData(a2, a1, loadA);
        }

        LoadData2dTransposeParams loadB{};
        if (packBytes_ != 0) {
            loadB.repeatTimes = (slice / 32) * (alignedCols / 32);
            loadB.srcStride = 1;
            loadB.dstGap = 1;
            LoadDataWithTranspose(b2, b1[off * alignedCols], loadB);
        } else if (alignedCols <= slice) {
            loadB.repeatTimes = slice / 32;
            loadB.srcStride = 1;
            loadB.dstGap = alignedCols / 16 - 1;
            for (int c = 0; c < alignedCols; c += 32) {
                LoadDataWithTranspose(b2[c * 32], b1[c * alignedDepth + off * 32], loadB);
            }
        } else {
            loadB.repeatTimes = alignedCols / 32;
            loadB.srcStride = alignedDepth / 32;
            loadB.dstGap = 1;
            for (int kk = 0; kk < slice; kk += 32) {
                LoadDataWithTranspose(b2[kk * alignedCols], b1[(off + kk) * 32], loadB);
            }
        }
    }


    GlobalTensor<int8_t> x_, weight_;
    GM_ADDR weightBase_;
    int k_, n_, packBytes_, panelStart_;
    int produced_ = 0;
    int matrixPending_ = 0;
    bool lastLarge_ = false;
    int panelIndex_ = 0;
    int l0Index_ = 0;
    int rowEnd_=0,aIndex_=0;bool prepared_=false;
    int lastExpert_ = -1, lastCol_ = -1;
};


__aicore__ inline void GeluNormalBatch(LocalTensor<float>z,LocalTensor<float>t,uint8_t repeats){
 Muls<float,false>(t,z,-0.07135481627260025f,uint64_t{0},repeats,UnaryRepeatParams{1,1,8,8});PipeBarrier<PIPE_V>();
 Mul<float,false>(t,t,z,uint64_t{0},repeats,BinaryRepeatParams{1,1,1,8,8,8});PipeBarrier<PIPE_V>();
 Adds<float,false>(t,t,-1.5957691216057308f,uint64_t{0},repeats,UnaryRepeatParams{1,1,8,8});PipeBarrier<PIPE_V>();
 Mul<float,false>(t,t,z,uint64_t{0},repeats,BinaryRepeatParams{1,1,1,8,8,8});PipeBarrier<PIPE_V>();
 Mins<float,false>(t,t,80.0f,uint64_t{0},repeats,UnaryRepeatParams{1,1,8,8});PipeBarrier<PIPE_V>();
 Exp<float,false>(t,t,uint64_t{0},repeats,UnaryRepeatParams{1,1,8,8});PipeBarrier<PIPE_V>();
 Adds<float,false>(t,t,1.0f,uint64_t{0},repeats,UnaryRepeatParams{1,1,8,8});PipeBarrier<PIPE_V>();
 Div<float,false>(z,z,t,uint64_t{0},repeats,BinaryRepeatParams{1,1,1,8,8,8});PipeBarrier<PIPE_V>();
}
__aicore__ inline void GeluNormalMask(LocalTensor<float>z,LocalTensor<float>t,int count){
 SetMaskNorm();SetVectorMask<float>(0,~uint64_t{0});
 int done=0,full=count/64;
 while(full>0){const int reps=gmg_common::Min(full,255);GeluNormalBatch(z[done],t[done],static_cast<uint8_t>(reps));done+=reps*64;full-=reps;}
 const int tail=count-done;
 if(tail){SetVectorMask<float>(0,(uint64_t{1}<<tail)-1);GeluNormalBatch(z[done],t[done],uint8_t{1});}
 SetVectorMask<float>(0,~uint64_t{0});
}
template <int TileCols, int kVectorElements, int TmpPadding,
          bool CompactAny = false, bool SingleVector = false, bool SpecializeFullTile = false>
class MidNormalVector {
public:
    __aicore__ inline void SetGroup(int, int) {}
    __aicore__ inline void SetRowEnd(int) {}
    __aicore__ inline void Init(GM_ADDR scale, GM_ADDR y, int n)
    {
        scale_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scale));
        y_.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y));
        n_ = n;
    }

    __aicore__ inline void Compute(const GlobalTensor<int32_t>& result, int expert,
                                   int row, int col, int rows, int cols, int bank)
    {
        if constexpr (SpecializeFullTile) {
            if (rows == 64 && cols == 256) {
                ComputeImpl<64, 256>(result, expert, row, col, 64, 256, bank);
            } else {
                ComputeImpl<0, 0>(result, expert, row, col, rows, cols, bank);
            }
        } else {
            ComputeImpl<0, 0>(result, expert, row, col, rows, cols, bank);
        }
    }

    template <int KnownRows, int KnownCols>
    __aicore__ inline void ComputeImpl(const GlobalTensor<int32_t>& result, int expert,
                                   int row, int col, int rows, int cols, int bank)
    {
        if constexpr (KnownRows) { rows = KnownRows; cols = KnownCols; }
        const int split = SingleVector ? rows : (rows + 1) / 2;
        const int rowOffset = SingleVector ? 0 : GetSubBlockIdx() * split;
        const int ownRows = Min(split, rows - rowOffset);
        if (ownRows > 0) {
            const int pitch = (cols + 31) / 32 * 32;
            const int count = ownRows * pitch;
            constexpr int accBytes = kVectorElements * sizeof(int32_t);
            constexpr int scaleBytes = TileCols * sizeof(float);
            constexpr int outBytes = kVectorElements * sizeof(half);
            const int buffer = scaleSlot_++ & 1;
            const bool compact = count <= kVectorElements / 2 &&
                                 (CompactAny || (cols == TileCols && n_ % TileCols == 0 && rows % 16 == 0));
            const bool overlap = compact && previousCompact_;
            LocalTensor<int32_t> acc(TPosition::VECCALC,
                                     compact ? buffer * accBytes / 2 : 0,
                                     compact ? kVectorElements / 2 : kVectorElements);
            LocalTensor<float> scales(TPosition::VECCALC, accBytes + buffer * scaleBytes, TileCols);
            const int outOffset = accBytes + 2 * scaleBytes + (compact ? buffer * outBytes / 2 : 0);
            LocalTensor<half> out(TPosition::VECCALC, outOffset,
                                  compact ? kVectorElements / 2 : kVectorElements);
            auto z = acc.ReinterpretCast<float>();
            LocalTensor<float> t(TPosition::VECCALC, accBytes + 2 * scaleBytes + outBytes + TmpPadding + (((accBytes + 2 * scaleBytes + outBytes + TmpPadding) % 512 == 0) ? 256 : 0), kVectorElements);

            if ((cols & 7) == 0 && (n_ & 7) == 0) {
                DataCopy(scales, scale_[expert * n_ + col], cols);
            } else {
                DataCopyExtParams scaleCopy{1, static_cast<uint32_t>(cols * sizeof(float)), 0, 0, 0};
                DataCopyPad(scales, scale_[expert * n_ + col], scaleCopy, DataCopyPadExtParams<float>{});
            }
            if (outputPending_ && !overlap) {
                WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
            }
            CrossCoreWaitFlag<0x2>(kReady + bank);
            DataCopy(acc, result[rowOffset * pitch], count);
            // Release the Cube's slot once the last read finishes.
            CrossCoreSetFlag<0x2, PIPE_MTE2>(kConsumed + bank);
            if (overlap) {
                WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
            }
            SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
            WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);

            Cast(z, acc, RoundMode::CAST_NONE, count);
            PipeBarrier<PIPE_V>();
            // Each repeat handles 64 channels and shares the scale across rows.
            for (int c = 0; c < cols; c += 64) {
                Mul(z[c], z[c], scales[c], static_cast<uint64_t>(Min(64, cols - c)),
                    ownRows, BinaryRepeatParams{1, 1, 1, static_cast<uint8_t>(pitch / 8), static_cast<uint8_t>(pitch / 8), 0});
            }
            PipeBarrier<PIPE_V>();

            GeluNormalMask(z, t, count);
            if (outputPending_ && !overlap) {
                WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
            }
            Cast(out, z, RoundMode::CAST_RINT, count);
            if (overlap) {
                WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
            }
            SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
            SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
            WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);

            DataCopyExtParams outCopy{
                static_cast<uint16_t>(ownRows),
                static_cast<uint32_t>(cols * sizeof(half)),
                static_cast<uint32_t>((pitch - (cols + 15) / 16 * 16) * sizeof(half) / 32),
                static_cast<uint32_t>((n_ - cols) * sizeof(half)),
                0};
            DataCopyPad(y_[(row + rowOffset) * n_ + col], out, outCopy);
            SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
            outputPending_ = true;
            previousCompact_ = compact;
        } else {
            CrossCoreWaitFlag<0x2>(kReady + bank);
            CrossCoreSetFlag<0x2, PIPE_MTE2>(kConsumed + bank);
        }
    }

    __aicore__ inline void Finish()
    {
        if (outputPending_) {
            WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
            WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
        }
    }

private:
    int scaleSlot_ = 0;
    bool previousCompact_ = false;
    bool outputPending_ = false;
    GlobalTensor<float> scale_;
    GlobalTensor<half> y_;
    int n_;
};

template <int TileCols>
using VectorTile = MidNormalVector<TileCols,kVectorElements,0,true,false,false>;

template <int TileRows, int TileCols, class Worker>
__aicore__ inline void ProcessTiles(Worker& worker, GM_ADDR groupList, GM_ADDR workspace,
                                    int experts, int n, int core)
{
    GlobalTensor<int64_t> groups;
    groups.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groupList),experts);
    GlobalTensor<int32_t> slot;
    slot.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(workspace)+core*kOutputSlots*kTileElements,kOutputSlots*kTileElements);
    const int cores=GetBlockNum(),colTiles=(n+TileCols-1)/TileCols;
    constexpr int rowsPerJob=384,tilesPerJob=rowsPerJob/TileRows;
    int totalJobs=0,start=0;
    for(int e=0;e<experts;++e){const int end=static_cast<int>(groups.GetValue(e));totalJobs+=((end-start+rowsPerJob-1)/rowsPerJob)*colTiles;start=end;}
    const int fullJobs=totalJobs/cores*cores;
    // Count only the incomplete final wave. All complete waves keep their
    // original B-resident job boundaries and ownership.
    int histogram[tilesPerJob+1]={0};int baseJob=0,tailTiles=0;start=0;
    if(fullJobs<totalJobs){
        for(int e=0;e<experts;++e){
            const int end=static_cast<int>(groups.GetValue(e));
            const int jobs=((end-start+rowsPerJob-1)/rowsPerJob)*colTiles;
            const int first=fullJobs>baseJob?fullJobs-baseJob:0;
            for(int j=first;j<jobs;++j){
                const int r=start+(j/colTiles)*rowsPerJob;
                const int tiles=(Min(end-r,rowsPerJob)+TileRows-1)/TileRows;
                ++histogram[tiles];tailTiles+=tiles;
            }
            baseJob+=jobs;start=end;
        }
    }
    int shardTiles=(tailTiles+cores-1)/cores;if(shardTiles<1)shardTiles=1;
    for(;shardTiles<tilesPerJob;++shardTiles){
        int shards=0;for(int t=1;t<=tilesPerJob;++t)shards+=histogram[t]*((t+shardTiles-1)/shardTiles);
        if(shards<=cores)break;
    }
    // Keep the sparse full-wave walk, sharing its generated pipeline with tail shards.
    int next=core,bank=0,tailShard=0;start=0;baseJob=0;
    for(int expert=0;expert<experts;++expert){
        const int end=static_cast<int>(groups.GetValue(expert));
        const int jobs=((end-start+rowsPerJob-1)/rowsPerJob)*colTiles;
        int tailNext=fullJobs>baseJob?fullJobs-baseJob:0;
        while((next<jobs && baseJob+next<fullJobs) || tailNext<jobs){
            const bool complete=next<jobs && baseJob+next<fullJobs;
            const int j=complete?next:tailNext;
            if(complete)next+=cores;else ++tailNext;
            const int jobStart=start+(j/colTiles)*rowsPerJob,jobEnd=Min(end,jobStart+rowsPerJob);
            int rowStart=jobStart,rowEnd=jobEnd;
            if(!complete){
                const int tiles=(jobEnd-jobStart+TileRows-1)/TileRows;
                const int shards=(tiles+shardTiles-1)/shardTiles;
                const int ownerBegin=tailShard;tailShard+=shards;
                if(core<ownerBegin || core>=ownerBegin+shards)continue;
                rowStart=jobStart+(core-ownerBegin)*shardTiles*TileRows;
                rowEnd=Min(jobEnd,rowStart+shardTiles*TileRows);
            }
            const int shift=cores%colTiles==0?((baseJob+j)/cores)%colTiles:0;
            const int col=(j%colTiles+shift)%colTiles*TileCols;
            worker.SetRowEnd(rowEnd);
            for(int row=rowStart;row<rowEnd;row+=TileRows){
                worker.Compute(slot[bank*kTileElements],expert,row,col,Min(rowEnd-row,TileRows),Min(n-col,TileCols),bank);bank^=1;
            }
        }
        next-=jobs;baseJob+=jobs;start=end;
    }
}

}  // namespace

template <int TileRows, int TileCols, int Panel>
__global__ GMG_ENTRY_ALIGN(8192,4096) __mix__(1, 2) void grouped_matmul_gelu_custom(
    GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groupList, GM_ADDR y,
    GM_ADDR workspace, int experts, int k, int n)
{
    AscendC::InitSocState();
    if ASCEND_IS_AIC {
        CubeTile<TileRows, TileCols, Panel> worker;
        worker.Init(x, weight, k, n);
        ProcessTiles<TileRows, TileCols>(worker, groupList, workspace, experts, n, AscendC::GetBlockIdx());
        worker.Finish();
    }
    if ASCEND_IS_AIV {
        VectorTile<TileCols> worker;
        worker.Init(scale, y, n);
        ProcessTiles<TileRows, TileCols>(worker, groupList, workspace, experts, n, AscendC::GetBlockIdx() / 2);
        worker.Finish();
    }
}


}
namespace path_odd_medium_resident {
using gmg_common::Min;
using gmg_common::Clear;
using gmg_common::WaitFor;
using gmg_common::GeluTanh;


namespace {
using namespace AscendC;

constexpr int kRows = 128;
constexpr int kCols = 256;
constexpr int kL0SlotBytes = 65536;
constexpr int kPanel = 512;
constexpr int kTileElements = kRows * kCols;
constexpr int kVectorRows = kRows / 2;
constexpr int kVectorElements = kVectorRows * kCols;
constexpr int kReady = 0;
constexpr int kConsumed = 2;
constexpr int kOutputSlots = 2;


template <int TileRows, int TileCols, int Panel>
class CubeTile {
public:
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR weight, int k, int n)
    {
        x_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
        weight_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(weight));
        weightBase_ = weight;
        pitchK_=(k+31)/32*32;
        k_ = k;
        n_ = n;
        panelStart_ = GetBlockIdx() % ((k + Panel - 1) / Panel) * Panel;
        packBytes_=1;
        SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID2);
        SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);
        SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID1);
        SetFlag<HardEvent::M_MTE1>(EVENT_ID0);
    }

    __aicore__ inline void Compute(const GlobalTensor<int32_t>& result, int expert,
                                   int row, int col, int rows, int cols, int bank)
    {
        const int alignedRows = (rows + 15) / 16 * 16;
        if(col==0){
            WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID2);
            LocalTensor<int8_t> resident(TPosition::A1,0,TileRows*1056);
            if(rows!=alignedRows)Clear(resident[rows*32],pitchK_/32,alignedRows-rows,rows);
            Nd2NzParams cp{};cp.ndNum=1;cp.nValue=rows;cp.dValue=k_;cp.srcDValue=k_;cp.dstNzC0Stride=alignedRows;cp.dstNzNStride=1;
            DataCopy(resident,x_[row*k_],cp);
            SetFlag<HardEvent::MTE2_MTE1>(EVENT_ID2);WaitFlag<HardEvent::MTE2_MTE1>(EVENT_ID2);
        }

        const bool gemv = false;
        const int alignedCols = (cols + 31) / 32 * 32;
        const int area = alignedRows * alignedCols;
        const bool large = area > kTileElements / 2;
        const int offset = large ? 0 : bank * kTileElements / 2;
        const auto matrixEvent = static_cast<TEventID>(bank);
        LocalTensor<int32_t> c(TPosition::CO1, offset * sizeof(int32_t), area);
        const int sliceLimit = Min(kL0SlotBytes / alignedRows, kL0SlotBytes / alignedCols) / 32 * 32;
        const int panelDepth=Panel;
        int kk=(GetBlockIdx()*3)%((k_+panelDepth-1)/panelDepth)*panelDepth;
        int panelSlot = panelIndex_ & 1;
        PrefetchPanel(panelSlot, expert, row, col, rows, cols, kk, alignedRows, alignedCols);
        for (int done = 0; done < k_; done += panelDepth) {
            const int depth = Min(k_ - kk, panelDepth);
            const int alignedDepth = (depth + 31) / 32 * 32;
            const int nextK = kk + panelDepth < k_ ? kk + panelDepth : 0;
            if (done + panelDepth < k_) {
                PrefetchPanel(panelSlot ^ 1, expert, row, col, rows, cols, nextK, alignedRows, alignedCols);
            }
            LocalTensor<int8_t> a1(TPosition::A1, 0, TileRows*1056);
            LocalTensor<int8_t> b1(TPosition::B1, TileRows*1056 + panelSlot*Panel*TileCols,Panel*TileCols);
            WaitFlag<HardEvent::MTE2_MTE1>(static_cast<TEventID>(panelSlot));

            for (int off = 0; off < alignedDepth; off += sliceLimit) {
                const int slice = Min(alignedDepth - off, sliceLimit);
                const auto l0slot=EVENT_ID0;
                LocalTensor<int8_t> a2(TPosition::A2, static_cast<int>(l0slot)*kL0SlotBytes, kL0SlotBytes);
                LocalTensor<int8_t> b2(TPosition::B2, static_cast<int>(l0slot)*kL0SlotBytes, kL0SlotBytes);
                WaitFlag<HardEvent::M_MTE1>(l0slot);
                currentK_=kk;
                LoadSlice(a2, b2, a1, b1, off, slice, alignedRows, alignedCols, alignedDepth, gemv);
                if (off + slice == alignedDepth) {
                    SetFlag<HardEvent::MTE1_MTE2>(static_cast<TEventID>(panelSlot));
                    if(done+panelDepth>=k_ && col+cols==n_)SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID2);
                }
                SetFlag<HardEvent::MTE1_M>(l0slot);
                WaitFlag<HardEvent::MTE1_M>(l0slot);

                const bool first = done == 0 && off == 0;
                if (first) {
                    WaitForMatrix(large || lastLarge_ ? 3 : 1 << bank);
                }
                MmadParams mm{};
                mm.m = gemv ? 1 : alignedRows;
                mm.n = alignedCols;
                mm.k = slice;
                mm.cmatrixInitVal = first;
                Mmad(c, a2, b2, mm);
                SetFlag<HardEvent::M_MTE1>(l0slot);
            }
            // Start each core at a different K panel to spread GM requests.
            kk = nextK;
            panelSlot ^= 1;
            ++panelIndex_;
        }

        SetFlag<HardEvent::M_FIX>(matrixEvent);
        WaitFlag<HardEvent::M_FIX>(matrixEvent);
        if ((produced_ & (1 << bank)) != 0) {
            CrossCoreWaitFlag<0x2>(kConsumed + bank);
        }
        FixpipeParamsV220 store{};
        store.mSize = rows;
        store.nSize = alignedCols;
        store.srcStride = alignedRows;
        store.dstStride = alignedCols;
        store.ndNum = 1;
        Fixpipe<int32_t, int32_t, CFG_ROW_MAJOR>(result, c, store);
        SetFlag<HardEvent::FIX_M>(matrixEvent);
        matrixPending_ |= 1 << bank;
        lastLarge_ = large;
        CrossCoreSetFlag<0x2, PIPE_FIX>(kReady + bank);
        produced_ |= 1 << bank;
    }

    __aicore__ inline void Finish()
    {
        for (int slot = 0; slot < 2; ++slot) {
            if ((produced_ & (1 << slot)) != 0) {
                CrossCoreWaitFlag<0x2>(kConsumed + slot);
            }
            WaitFlag<HardEvent::MTE1_MTE2>(static_cast<TEventID>(slot));
        }
        WaitFlag<HardEvent::M_MTE1>(EVENT_ID0);
        WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID2);
        WaitForMatrix(3);
    }

private:
    __aicore__ inline void WaitForMatrix(int overlap)
    {
        const int ready = matrixPending_ & overlap;
        if ((ready & 1) != 0) {
            WaitFlag<HardEvent::FIX_M>(EVENT_ID0);
        }
        if ((ready & 2) != 0) {
            WaitFlag<HardEvent::FIX_M>(EVENT_ID1);
        }
        matrixPending_ &= ~overlap;
    }

__aicore__ inline void PrefetchPanel(int slot, int expert, int row, int col,
                                        int rows, int cols, int kk, int alignedRows, int alignedCols)
    {
        LocalTensor<int8_t> a1(TPosition::A1,0,TileRows*1056);
        LocalTensor<int8_t> b1(TPosition::B1, TileRows*1056+slot*Panel*TileCols,Panel*TileCols);
        const int panelDepth=Panel;
        const int depth = Min(k_ - kk, panelDepth);
        const int alignedDepth = (depth + 31) / 32 * 32;
        const auto event = static_cast<TEventID>(slot);
        WaitFlag<HardEvent::MTE1_MTE2>(event);
        LoadPanel(a1, b1, expert, row, col, rows, cols, kk, depth, alignedRows, alignedCols, alignedDepth);
        SetFlag<HardEvent::MTE2_MTE1>(event);
    }

    __aicore__ inline void LoadPanel(LocalTensor<int8_t> a1, LocalTensor<int8_t> b1,
                                     int expert, int row, int col, int rows, int cols,
                                     int kk, int depth, int alignedRows, int alignedCols, int alignedDepth)
    {
        const int offset = (expert * k_ + kk) * n_ + col;
        switch (packBytes_) {
            case 1:
                LoadPackedWeight<int8_t>(b1, offset, depth, cols, alignedCols);
                break;
            case 2:
                LoadPackedWeight<int16_t>(b1, offset, depth, cols, alignedCols);
                break;
            case 4:
                LoadPackedWeight<int32_t>(b1, offset, depth, cols, alignedCols);
                break;
            default: {
                if (depth != alignedDepth) {
                    Clear(b1[depth * 32], alignedCols / 32, alignedDepth - depth, depth);
                }
                Nd2NzParams bCopy{};
                bCopy.ndNum = 1;
                bCopy.nValue = depth;
                bCopy.dValue = cols;
                bCopy.srcDValue = n_;
                bCopy.dstNzC0Stride = alignedDepth;
                bCopy.dstNzNStride = 1;
                DataCopy(b1, weight_[offset], bCopy);
                break;
            }
        }
    }

    template <class CopyT>
    __aicore__ inline void LoadPackedWeight(LocalTensor<int8_t> b1, int offset,
                                           int depth, int cols, int alignedCols)
    {
        gmg_common::LoadPackedWeight<CopyT>(b1, weightBase_, n_,
                                               offset, depth, cols, alignedCols);
    }

    __aicore__ inline void LoadSlice(LocalTensor<int8_t> a2, LocalTensor<int8_t> b2,
                                     LocalTensor<int8_t> a1, LocalTensor<int8_t> b1,
                                     int off, int slice, int alignedRows, int alignedCols, int alignedDepth, bool gemv)
    {
        if (alignedRows == 16) {
            LoadData2DParams loadA{};
            loadA.repeatTimes = gemv ? (slice + 511) / 512 : slice / 32;
            loadA.srcStride = 1;
            // GEMV reads its one row contiguously from L0A.
            LoadData(a2, a1[gemv ? currentK_+off : (currentK_+off)*alignedRows], loadA);
        } else {
            LoadData3DParamsV2<int8_t> loadA{};
            loadA.l1H = 1;
            loadA.l1W = alignedRows;
            loadA.channelSize = pitchK_;
            loadA.kExtension = slice;
            loadA.mExtension = alignedRows;
            loadA.kStartPt = currentK_+off;
            LoadData(a2, a1, loadA);
        }

        LoadData2dTransposeParams loadB{};
        if (packBytes_ != 0) {
            loadB.repeatTimes = (slice / 32) * (alignedCols / 32);
            loadB.srcStride = 1;
            loadB.dstGap = 1;
            LoadDataWithTranspose(b2, b1[off * alignedCols], loadB);
        } else if (alignedCols <= slice) {
            loadB.repeatTimes = slice / 32;
            loadB.srcStride = 1;
            loadB.dstGap = alignedCols / 16 - 1;
            for (int c = 0; c < alignedCols; c += 32) {
                LoadDataWithTranspose(b2[c * 32], b1[c * alignedDepth + off * 32], loadB);
            }
        } else {
            loadB.repeatTimes = alignedCols / 32;
            loadB.srcStride = alignedDepth / 32;
            loadB.dstGap = 1;
            for (int kk = 0; kk < slice; kk += 32) {
                LoadDataWithTranspose(b2[kk * alignedCols], b1[(off + kk) * 32], loadB);
            }
        }
    }


    GlobalTensor<int8_t> x_, weight_;
    GM_ADDR weightBase_;
    int pitchK_;
    int currentK_=0;
    int k_, n_, packBytes_, panelStart_;
    int produced_ = 0;
    int matrixPending_ = 0;
    bool lastLarge_ = false;
    int panelIndex_ = 0;
    int l0Index_ = 0;
};


template <int TileCols>
using VectorTile = gmg_common::VectorTile<TileCols, kVectorElements, 256, false, false, false>;

template <int TileRows,int TileCols,class Worker>
__aicore__ inline void ProcessTiles(Worker&worker,GM_ADDR groupList,GM_ADDR workspace,int experts,int n,int core){
 GlobalTensor<int64_t>groups;groups.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groupList),experts);
 GlobalTensor<int32_t>slot;slot.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(workspace)+core*kOutputSlots*kTileElements,kOutputSlots*kTileElements);
 const int cores=GetBlockNum();int bank=0;
const int m=static_cast<int>(groups.GetValue(experts-1));
 for(int begin=core*TileRows;begin<m;begin+=cores*TileRows){const int limit=Min(m,begin+TileRows);int e=begin*experts/m;int end=static_cast<int>(groups.GetValue(e));
  while(end<=begin){++e;end=static_cast<int>(groups.GetValue(e));}
  while(e>0){const int previous=static_cast<int>(groups.GetValue(e-1));if(previous<=begin)break;--e;end=previous;}
  int row=begin;
  while(row<limit){
   if(end>row){const int rows=Min(end,limit)-row;
    for(int col=0;col<n;col+=TileCols){worker.Compute(slot[bank*kTileElements],e,row,col,rows,Min(TileCols,n-col),bank);bank^=1;}
    row+=rows;
   }if(row<limit){++e;end=static_cast<int>(groups.GetValue(e));}
  }
 }
}

}  // namespace

template <int TileRows, int TileCols, int Panel>
__global__ GMG_ENTRY_ALIGN(4096,4096) __mix__(1, 2) void grouped_matmul_gelu_custom(
    GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groupList, GM_ADDR y,
    GM_ADDR workspace, int experts, int k, int n)
{
    AscendC::InitSocState();
    if ASCEND_IS_AIC {
        CubeTile<TileRows, TileCols, Panel> worker;
        worker.Init(x, weight, k, n);
        ProcessTiles<TileRows, TileCols>(worker, groupList, workspace, experts, n, AscendC::GetBlockIdx());
        worker.Finish();
    }
    if ASCEND_IS_AIV {
        VectorTile<TileCols> worker;
        worker.Init(scale, y, n);
        ProcessTiles<TileRows, TileCols>(worker, groupList, workspace, experts, n, AscendC::GetBlockIdx() / 2);
        worker.Finish();
    }
}


}
namespace path_long_splitk {
using gmg_common::Min;
using gmg_common::Clear;
using gmg_common::WaitFor;
using gmg_common::GeluTanh;


namespace {
using namespace AscendC;

constexpr int kRows = 128;
constexpr int kCols = 256;
constexpr int kL0SlotBytes = 65536;
constexpr int kPanel = 512;
constexpr int kTileElements = kRows * kCols;
constexpr int kVectorRows = kRows / 2;
constexpr int kVectorElements = kVectorRows * kCols;
constexpr int kReady = 0;
constexpr int kConsumed = 2;
constexpr int kOutputSlots = 2;


template <int TileRows, int TileCols, int Panel>
class CubeTile {
public:
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR weight, int k, int n)
    {
        x_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
        weight_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(weight));
        weightBase_ = weight;
        pitchK_=(k+31)/32*32;
        k_ = k;
        n_ = n;
        panelStart_ = GetBlockIdx() % ((k + Panel - 1) / Panel) * Panel;
        packBytes_=1;
        SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID2);
        SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);
        SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID1);
        SetFlag<HardEvent::M_MTE1>(EVENT_ID0);
    }

    __aicore__ inline void SetStrides(int x,int y){rowStride_=x;outStride_=y;}
    __aicore__ inline void Compute(const GlobalTensor<int32_t>& result, int expert,
                                   int row, int col, int rows, int cols, int bank)
    {
        const int alignedRows = (rows + 15) / 16 * 16;
        if(col==0){
            WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID2);
            LocalTensor<int8_t> resident(TPosition::A1,0,TileRows*(2*Panel));
            if(rows!=alignedRows)Clear(resident[rows*32],pitchK_/32,alignedRows-rows,rows);
            Nd2NzParams cp{};cp.ndNum=1;cp.nValue=rows;cp.dValue=k_;cp.srcDValue=rowStride_;cp.dstNzC0Stride=alignedRows;cp.dstNzNStride=1;
            DataCopy(resident,x_[row*rowStride_],cp);
            SetFlag<HardEvent::MTE2_MTE1>(EVENT_ID2);WaitFlag<HardEvent::MTE2_MTE1>(EVENT_ID2);
        }

        const bool gemv = false;
        const int alignedCols = (cols + 31) / 32 * 32;
        const int area = alignedRows * alignedCols;
        const bool large = area > kTileElements / 2;
        const int offset = large ? 0 : bank * kTileElements / 2;
        const auto matrixEvent = static_cast<TEventID>(bank);
        LocalTensor<int32_t> c(TPosition::CO1, offset * sizeof(int32_t), area);
        const int sliceLimit = Min(kL0SlotBytes / alignedRows, kL0SlotBytes / alignedCols) / 32 * 32;
        const int panelDepth=Panel;
        int kk=(GetBlockIdx()*3)%((k_+panelDepth-1)/panelDepth)*panelDepth;
        int panelSlot = panelIndex_ & 1;
        PrefetchPanel(panelSlot, expert, row, col, rows, cols, kk, alignedRows, alignedCols);
        for (int done = 0; done < k_; done += panelDepth) {
            const int depth = Min(k_ - kk, panelDepth);
            const int alignedDepth = (depth + 31) / 32 * 32;
            const int nextK = kk + panelDepth < k_ ? kk + panelDepth : 0;
            if (done + panelDepth < k_) {
                PrefetchPanel(panelSlot ^ 1, expert, row, col, rows, cols, nextK, alignedRows, alignedCols);
            }
            LocalTensor<int8_t> a1(TPosition::A1, 0, TileRows*(2*Panel));
            LocalTensor<int8_t> b1(TPosition::B1, TileRows*(2*Panel) + panelSlot*Panel*TileCols,Panel*TileCols);
            WaitFlag<HardEvent::MTE2_MTE1>(static_cast<TEventID>(panelSlot));

            for (int off = 0; off < alignedDepth; off += sliceLimit) {
                const int slice = Min(alignedDepth - off, sliceLimit);
                const auto l0slot=EVENT_ID0;
                LocalTensor<int8_t> a2(TPosition::A2, static_cast<int>(l0slot)*kL0SlotBytes, kL0SlotBytes);
                LocalTensor<int8_t> b2(TPosition::B2, static_cast<int>(l0slot)*kL0SlotBytes, kL0SlotBytes);
                WaitFlag<HardEvent::M_MTE1>(l0slot);
                currentK_=kk;
                LoadSlice(a2, b2, a1, b1, off, slice, alignedRows, alignedCols, alignedDepth, gemv);
                if (off + slice == alignedDepth) {
                    SetFlag<HardEvent::MTE1_MTE2>(static_cast<TEventID>(panelSlot));
                    if(done+panelDepth>=k_ && col+cols==n_)SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID2);
                }
                SetFlag<HardEvent::MTE1_M>(l0slot);
                WaitFlag<HardEvent::MTE1_M>(l0slot);

                const bool first = done == 0 && off == 0;
                if (first) {
                    WaitForMatrix(large || lastLarge_ ? 3 : 1 << bank);
                }
                MmadParams mm{};
                mm.m = gemv ? 1 : alignedRows;
                mm.n = alignedCols;
                mm.k = slice;
                mm.cmatrixInitVal = first;
                Mmad(c, a2, b2, mm);
                SetFlag<HardEvent::M_MTE1>(l0slot);
            }
            // Start each core at a different K panel to spread GM requests.
            kk = nextK;
            panelSlot ^= 1;
            ++panelIndex_;
        }

        SetFlag<HardEvent::M_FIX>(matrixEvent);
        WaitFlag<HardEvent::M_FIX>(matrixEvent);
        FixpipeParamsV220 store{};
        store.mSize = rows;
        store.nSize = alignedCols;
        store.srcStride = alignedRows;
        store.dstStride = outStride_;
        store.ndNum = 1;
        Fixpipe<int32_t, int32_t, CFG_ROW_MAJOR>(result, c, store);
        SetFlag<HardEvent::FIX_M>(matrixEvent);
        matrixPending_ |= 1 << bank;
        lastLarge_ = large;

        produced_ |= 1 << bank;
    }

    __aicore__ inline void Finish()
    {
        for (int slot = 0; slot < 2; ++slot) {
            WaitFlag<HardEvent::MTE1_MTE2>(static_cast<TEventID>(slot));
        }
        WaitFlag<HardEvent::M_MTE1>(EVENT_ID0);
        WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID2);
        WaitForMatrix(3);
    }

private:
    __aicore__ inline void WaitForMatrix(int overlap)
    {
        const int ready = matrixPending_ & overlap;
        if ((ready & 1) != 0) {
            WaitFlag<HardEvent::FIX_M>(EVENT_ID0);
        }
        if ((ready & 2) != 0) {
            WaitFlag<HardEvent::FIX_M>(EVENT_ID1);
        }
        matrixPending_ &= ~overlap;
    }

__aicore__ inline void PrefetchPanel(int slot, int expert, int row, int col,
                                        int rows, int cols, int kk, int alignedRows, int alignedCols)
    {
        LocalTensor<int8_t> a1(TPosition::A1,0,TileRows*(2*Panel));
        LocalTensor<int8_t> b1(TPosition::B1, TileRows*(2*Panel)+slot*Panel*TileCols,Panel*TileCols);
        const int panelDepth=Panel;
        const int depth = Min(k_ - kk, panelDepth);
        const int alignedDepth = (depth + 31) / 32 * 32;
        const auto event = static_cast<TEventID>(slot);
        WaitFlag<HardEvent::MTE1_MTE2>(event);
        LoadPanel(a1, b1, expert, row, col, rows, cols, kk, depth, alignedRows, alignedCols, alignedDepth);
        SetFlag<HardEvent::MTE2_MTE1>(event);
    }

    __aicore__ inline void LoadPanel(LocalTensor<int8_t> a1, LocalTensor<int8_t> b1,
                                     int expert, int row, int col, int rows, int cols,
                                     int kk, int depth, int alignedRows, int alignedCols, int alignedDepth)
    {
        const int offset = (expert * k_ + kk) * n_ + col;
        switch (packBytes_) {
            case 1:
                LoadPackedWeight<int8_t>(b1, offset, depth, cols, alignedCols);
                break;
            case 2:
                LoadPackedWeight<int16_t>(b1, offset, depth, cols, alignedCols);
                break;
            case 4:
                LoadPackedWeight<int32_t>(b1, offset, depth, cols, alignedCols);
                break;
            default: {
                if (depth != alignedDepth) {
                    Clear(b1[depth * 32], alignedCols / 32, alignedDepth - depth, depth);
                }
                Nd2NzParams bCopy{};
                bCopy.ndNum = 1;
                bCopy.nValue = depth;
                bCopy.dValue = cols;
                bCopy.srcDValue = n_;
                bCopy.dstNzC0Stride = alignedDepth;
                bCopy.dstNzNStride = 1;
                DataCopy(b1, weight_[offset], bCopy);
                break;
            }
        }
    }

    template <class CopyT>
    __aicore__ inline void LoadPackedWeight(LocalTensor<int8_t> b1, int offset,
                                           int depth, int cols, int alignedCols)
    {
        gmg_common::LoadPackedWeight<CopyT>(b1, weightBase_, n_,
                                               offset, depth, cols, alignedCols);
    }

    __aicore__ inline void LoadSlice(LocalTensor<int8_t> a2, LocalTensor<int8_t> b2,
                                     LocalTensor<int8_t> a1, LocalTensor<int8_t> b1,
                                     int off, int slice, int alignedRows, int alignedCols, int alignedDepth, bool gemv)
    {
        if (alignedRows == 16) {
            LoadData2DParams loadA{};
            loadA.repeatTimes = gemv ? (slice + 511) / 512 : slice / 32;
            loadA.srcStride = 1;
            // GEMV reads its one row contiguously from L0A.
            LoadData(a2, a1[gemv ? currentK_+off : (currentK_+off)*alignedRows], loadA);
        } else {
            LoadData3DParamsV2<int8_t> loadA{};
            loadA.l1H = 1;
            loadA.l1W = alignedRows;
            loadA.channelSize = pitchK_;
            loadA.kExtension = slice;
            loadA.mExtension = alignedRows;
            loadA.kStartPt = currentK_+off;
            LoadData(a2, a1, loadA);
        }

        LoadData2dTransposeParams loadB{};
        if (packBytes_ != 0) {
            loadB.repeatTimes = (slice / 32) * (alignedCols / 32);
            loadB.srcStride = 1;
            loadB.dstGap = 1;
            LoadDataWithTranspose(b2, b1[off * alignedCols], loadB);
        } else if (alignedCols <= slice) {
            loadB.repeatTimes = slice / 32;
            loadB.srcStride = 1;
            loadB.dstGap = alignedCols / 16 - 1;
            for (int c = 0; c < alignedCols; c += 32) {
                LoadDataWithTranspose(b2[c * 32], b1[c * alignedDepth + off * 32], loadB);
            }
        } else {
            loadB.repeatTimes = alignedCols / 32;
            loadB.srcStride = alignedDepth / 32;
            loadB.dstGap = 1;
            for (int kk = 0; kk < slice; kk += 32) {
                LoadDataWithTranspose(b2[kk * alignedCols], b1[(off + kk) * 32], loadB);
            }
        }
    }


    GlobalTensor<int8_t> x_, weight_;
    GM_ADDR weightBase_;
    int rowStride_=0,outStride_=0;
    int pitchK_;
    int currentK_=0;
    int k_, n_, packBytes_, panelStart_;
    int produced_ = 0;
    int matrixPending_ = 0;
    bool lastLarge_ = false;
    int panelIndex_ = 0;
    int l0Index_ = 0;
};


// Derive the split from the runtime group list. All AIC/AIV participants
// obtain the same plan; spare AICs consume residual row jobs before the
// existing global completion barrier. No partial plane is read before FIX.
struct SplitPlan { int parts; int mainDepth; int tailDepth; int rowJobs; int helpers; bool enabled; };
template<int TileRows,int TileCols,int Panel>
__aicore__ inline SplitPlan MakeSplitPlan(const GlobalTensor<int64_t>& groups,int experts,int m,int k,int n){
 constexpr int maxDepth=2*Panel-32;
 SplitPlan plan{(k+maxDepth-1)/maxDepth,maxDepth,0,0,0,false};
 int start=0;
 for(int e=0;e<experts;++e){const int end=static_cast<int>(groups.GetValue(e));plan.rowJobs+=(end-start+TileRows-1)/TileRows;start=end;}
 const int cores=GetBlockNum(),mainCores=plan.rowJobs*plan.parts;
 const int helpers=cores-mainCores;
 if(helpers<=0 || helpers>=plan.rowJobs)return plan;
 const int q=(plan.rowJobs+helpers-1)/helpers;
 const int64_t denominator=static_cast<int64_t>(q)*plan.parts+1;
 int depth=static_cast<int>((((static_cast<int64_t>(q)*k+denominator-1)/denominator)+31)/32*32);
 // A helper with multiple row jobs pays FIX/init once per job. Bound each
 // residual job to one legal L0 K slice before balancing its byte count.
 if(q>1){
  const int maxCols=(Min(n,TileCols)+31)/32*32;
  const int oneSlice=Min(kL0SlotBytes/TileRows,kL0SlotBytes/maxCols)/32*32;
  const int proposed=((k-oneSlice+plan.parts-1)/plan.parts+31)/32*32;
  if(proposed>depth && proposed<=maxDepth && k-plan.parts*proposed>0)depth=proposed;
 }
 const int tail=k-plan.parts*depth;
 const int64_t bytes=static_cast<int64_t>(plan.parts+1)*m*((n+31)/32*32)*4;
 if(depth<=0 || depth>maxDepth || tail<=0 || tail>maxDepth || static_cast<int64_t>(q)*tail>depth || bytes>64*1024*1024)return plan;
 plan.mainDepth=depth;plan.tailDepth=tail;plan.helpers=helpers;plan.enabled=true;return plan;
}

template<int KSplitDepth>
__aicore__ inline void ReduceParts(GM_ADDR workspace,GM_ADDR scale,GM_ADDR y,GM_ADDR groupList,int experts,int m,int k,int n,int actualParts){
 GlobalTensor<int64_t>groups;groups.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groupList));
 GlobalTensor<int32_t>parts;parts.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(workspace));
 GlobalTensor<float>scales;scales.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scale));GlobalTensor<half>out;out.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y));
 const int pitch=(n+31)/32*32,kparts=actualParts,rank=GetBlockIdx(),cores=2*GetBlockNum();int next=rank,start=0;
 LocalTensor<int32_t>acc(TPosition::VECCALC,0,9216),tmp(TPosition::VECCALC,36864,9216);LocalTensor<half>halfout(TPosition::VECCALC,73728,9216);LocalTensor<float>sv(TPosition::VECCALC,92160,1024);
 for(int e=0;e<experts;++e){const int rowTile=Min(16,9216/pitch);const int end=static_cast<int>(groups.GetValue(e)),tasks=(end-start+rowTile-1)/rowTile;
  for(;next<tasks;next+=cores){const int row=start+next*rowTile,rows=Min(rowTile,end-row),valid=rows*pitch,count=(valid+63)/64*64;
   DataCopy(acc,parts[row*pitch],valid);DataCopyPad(sv,scales[e*n],DataCopyExtParams{1,static_cast<uint32_t>(n*4),0,0,0},DataCopyPadExtParams<float>{});WaitFor<HardEvent::MTE2_V>();
   for(int i=valid;i<count;++i){acc.SetValue(i,0);tmp.SetValue(i,0);}WaitFor<HardEvent::S_V>();
   for(int p=1;p<kparts;++p){DataCopy(tmp,parts[(p*m+row)*pitch],valid);WaitFor<HardEvent::MTE2_V>();const int reps=count/64,tail=count%64;if(reps)Add(acc,acc,tmp,static_cast<uint64_t>(64),static_cast<uint8_t>(reps),BinaryRepeatParams{1,1,1,8,8,8});if(tail)Add(acc[reps*64],acc[reps*64],tmp[reps*64],static_cast<uint64_t>(tail),1,BinaryRepeatParams{1,1,1,8,8,8});WaitFor<HardEvent::V_MTE2>();}
   auto z=acc.ReinterpretCast<float>();Cast(z,acc,RoundMode::CAST_NONE,count);PipeBarrier<PIPE_V>();
   for(int c=0;c<n;c+=64)Mul(z[c],z[c],sv[c],static_cast<uint64_t>(Min(64,n-c)),rows,BinaryRepeatParams{1,1,1,static_cast<uint8_t>(pitch/8),static_cast<uint8_t>(pitch/8),0});
   PipeBarrier<PIPE_V>();GeluTanh(z,tmp.ReinterpretCast<float>(),count);Cast(halfout,z,RoundMode::CAST_RINT,count);WaitFor<HardEvent::V_MTE3>();
   DataCopyPad(out[row*n],halfout,DataCopyExtParams{static_cast<uint16_t>(rows),static_cast<uint32_t>(n*2),static_cast<uint32_t>((pitch-(n+15)/16*16)*2/32),0,0});PipeBarrier<PIPE_ALL>();
  }next-=tasks;start=end;
 }
}

} // anonymous

template <int TileRows, int TileCols, int Panel>
__global__ GMG_ENTRY_ALIGN(8192,4096) __mix__(1, 2) void grouped_matmul_gelu_custom(GM_ADDR x,GM_ADDR weight,GM_ADDR scale,GM_ADDR groupList,GM_ADDR y,GM_ADDR workspace,int experts,int k,int n){
 InitSocState();GlobalTensor<int64_t>groups;groups.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groupList));const int m=static_cast<int>(groups.GetValue(experts-1)),pitch=(n+31)/32*32;
 const auto plan=MakeSplitPlan<TileRows,TileCols,Panel>(groups,experts,m,k,n);
 if ASCEND_IS_AIC {
        AscendC::ICachePreLoad(4);
  GlobalTensor<int32_t>partial;partial.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(workspace));constexpr int splitDepth=2*Panel-32;const int panels=(k+splitDepth-1)/splitDepth;int next=GetBlockIdx(),start=0;
  if(plan.enabled){
   const int core=GetBlockIdx(),mainCores=plan.rowJobs*plan.parts;
   const bool primary=core<mainCores;
   const int part=primary?core%plan.parts:plan.parts;
   const int kk=primary?part*plan.mainDepth:plan.parts*plan.mainDepth;
   const int depth=primary?plan.mainDepth:plan.tailDepth;
   const int stride=primary?plan.rowJobs:plan.helpers;
   next=primary?core/plan.parts:core-mainCores;
   for(int e=0;e<experts;++e){const int end=static_cast<int>(groups.GetValue(e)),tasks=(end-start+TileRows-1)/TileRows;
    for(;next<tasks;next+=stride){
     const int row=start+next*TileRows,rows=Min(TileRows,end-row);
     CubeTile<TileRows,TileCols,Panel>worker;worker.Init(x+kk,weight+(static_cast<size_t>(e)*k+kk)*n,depth,n);worker.SetStrides(k,pitch);
     int bank=0;for(int col=0;col<n;col+=TileCols){worker.Compute(partial[(part*m+row)*pitch+col],0,row,col,rows,Min(TileCols,n-col),bank);bank^=1;}worker.Finish();
    }next-=tasks;start=end;
   }
  }else{
  for(int e=0;e<experts;++e){const int end=static_cast<int>(groups.GetValue(e)),tasks=((end-start+TileRows-1)/TileRows)*panels;
   for(;next<tasks;next+=GetBlockNum()){
    const int row=start+next/panels*TileRows,part=next%panels,kk=part*splitDepth,depth=Min(splitDepth,k-kk),rows=Min(TileRows,end-row);
    CubeTile<TileRows,TileCols,Panel>worker;worker.Init(x+kk,weight+(static_cast<size_t>(e)*k+kk)*n,depth,n);worker.SetStrides(k,pitch);
    int bank=0;for(int col=0;col<n;col+=TileCols){worker.Compute(partial[(part*m+row)*pitch+col],0,row,col,rows,Min(TileCols,n-col),bank);bank^=1;}worker.Finish();
   }next-=tasks;start=end;
  }
  }
  CrossCoreSetFlag<0x0,PIPE_FIX>(10);CrossCoreWaitFlag<0x0>(10);CrossCoreSetFlag<0x2,PIPE_FIX>(4);
 }
 if ASCEND_IS_AIV {
        AscendC::ICachePreLoad(2);CrossCoreWaitFlag<0x2>(4);ReduceParts<2*Panel-32>(workspace,scale,y,groupList,experts,m,k,n,plan.parts+(plan.enabled?1:0));}
}

}


namespace path_small_compact {
using gmg_common::Min;
using gmg_common::Clear;
using gmg_common::WaitFor;
using gmg_common::GeluTanh;

using namespace AscendC;


template<int TileRows,int TileCols,int Panel>
__global__ GMG_ENTRY_ALIGN(2048,2048) __mix__(1,1) void grouped_matmul_gelu_custom(
 GM_ADDR x,GM_ADDR weight,GM_ADDR scale,GM_ADDR groupList,GM_ADDR y,GM_ADDR workspace,int experts,int k,int n,int m){
 const int core=GetBlockIdx(),nt=(n+TileCols-1)/TileCols,jobs=((m+TileRows-1)/TileRows)*nt;
 if(core>=jobs)return;InitSocState();
 const int row=core/nt*TileRows,col=core%nt*TileCols,rows=Min(TileRows,m-row),cols=Min(TileCols,n-col),ac=(cols+31)/32*32,ak=(k+31)/32*32;
 GlobalTensor<int32_t>parts;parts.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(workspace)+core*TileRows*TileCols);
 if ASCEND_IS_AIC {
  GlobalTensor<int8_t>a,b;a.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));b.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(weight));
  LocalTensor<int8_t>a1(TPosition::A1,0,16*Panel),b1(TPosition::B1,8192,TileCols*Panel),a2(TPosition::A2,0,65536),b2(TPosition::B2,0,65536);LocalTensor<int32_t>c(TPosition::CO1,0,16*TileCols);
  if(rows!=16)Clear(a1[rows*32],ak/32,16-rows,rows);
  Nd2NzParams cp{};cp.ndNum=1;cp.nValue=rows;cp.dValue=k;cp.srcDValue=k;cp.dstNzC0Stride=16;cp.dstNzNStride=1;DataCopy(a1,a[row*k],cp);
  Nd2NzParams bp{};bp.ndNum=k/32;bp.nValue=32;bp.dValue=cols;bp.srcNdMatrixStride=32*n;bp.srcDValue=n;bp.dstNzC0Stride=32;bp.dstNzNStride=1;bp.dstNzMatrixStride=32*ac;
  if(bp.ndNum)DataCopy(b1,b[col],bp);
  const int rem=k%32;
  if(rem){const int done=k-rem;Clear(b1[done*ac+rem*32],ac/32,32-rem,rem);bp.ndNum=1;bp.nValue=rem;bp.srcNdMatrixStride=0;bp.dstNzMatrixStride=0;DataCopy(b1[done*ac],b[done*n+col],bp);}
  path_general::WaitFor<HardEvent::MTE2_MTE1>();LoadData2DParams ap{};ap.repeatTimes=ak/32;ap.srcStride=1;LoadData(a2,a1,ap);
  LoadData2dTransposeParams lp{};lp.repeatTimes=(ak/32)*(ac/32);lp.srcStride=1;lp.dstGap=1;LoadDataWithTranspose(b2,b1,lp);path_general::WaitFor<HardEvent::MTE1_M>();
  MmadParams mm{};mm.m=16;mm.n=ac;mm.k=ak;mm.cmatrixInitVal=true;Mmad(c,a2,b2,mm);path_general::WaitFor<HardEvent::M_FIX>();
  FixpipeParamsV220 fp{};fp.mSize=rows;fp.nSize=ac;fp.srcStride=16;fp.dstStride=ac;fp.ndNum=1;Fixpipe<int32_t,int32_t,CFG_ROW_MAJOR>(parts,c,fp);CrossCoreSetFlag<0x2,PIPE_FIX>(0);
 }
 if ASCEND_IS_AIV {
  const int count=rows*ac;GlobalTensor<float>s;s.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scale));GlobalTensor<half>o;o.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y));
  LocalTensor<int32_t>acc(TPosition::VECCALC,0,TileRows*TileCols);LocalTensor<float>sv(TPosition::VECCALC,33024,TileCols),t(TPosition::VECCALC,34048,TileRows*TileCols);LocalTensor<half>out(TPosition::VECCALC,98560,TileRows*TileCols);
  if(cols%8==0)DataCopy(sv,s[col],cols);else DataCopyPad(sv,s[col],DataCopyExtParams{1,static_cast<uint32_t>(cols*4),0,0,0},DataCopyPadExtParams<float>{});
  CrossCoreWaitFlag<0x2>(0);DataCopy(acc,parts,count);path_general::WaitFor<HardEvent::MTE2_V>();auto z=acc.ReinterpretCast<float>();Cast(z,acc,RoundMode::CAST_NONE,count);PipeBarrier<PIPE_V>();
  for(int ch=0;ch<cols;ch+=64)Mul(z[ch],z[ch],sv[ch],static_cast<uint64_t>(Min(64,cols-ch)),rows,BinaryRepeatParams{1,1,1,static_cast<uint8_t>(ac/8),static_cast<uint8_t>(ac/8),0});PipeBarrier<PIPE_V>();
  path_general::GeluTanh(z,t,count);Cast(out,z,RoundMode::CAST_RINT,count);path_general::WaitFor<HardEvent::V_MTE3>();
  if(cols==n && ac==cols)DataCopy(o[row*n],out,count);
  else DataCopyPad(o[row*n+col],out,DataCopyExtParams{static_cast<uint16_t>(rows),static_cast<uint32_t>(cols*2),static_cast<uint32_t>((ac-(cols+15)/16*16)*2/32),static_cast<uint32_t>((n-cols)*2),0});
  PipeBarrier<PIPE_ALL>();
 }
}
}

namespace path_short_panels {
using gmg_common::Min;
using gmg_common::Clear;
using gmg_common::WaitFor;
using gmg_common::GeluTanh;


namespace {
using namespace AscendC;

constexpr int kRows = 128;
constexpr int kCols = 256;
constexpr int kL0SlotBytes = 65536;
constexpr int kPanel = 512;
constexpr int kTileElements = kRows * kCols;
constexpr int kVectorRows = kRows / 2;
constexpr int kVectorElements = kVectorRows * kCols;
constexpr int kReady = 0;
constexpr int kConsumed = 2;
constexpr int kOutputSlots = 2;


template <int TileRows, int TileCols, int Panel>
class CubeTile {
public:
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR weight, int k, int n)
    {
        x_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
        weight_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(weight));
        weightBase_ = weight;xBase_=x;
        k_ = k;
        n_ = n;
        panelStart_ = GetBlockIdx() % ((k + Panel - 1) / Panel) * Panel;
        packBytes_=n%4==0?4:n%2==0?2:1;
        SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);
        SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID1);
        SetFlag<HardEvent::M_MTE1>(EVENT_ID0);
        SetFlag<HardEvent::M_MTE1>(EVENT_ID1);
    }

    __aicore__ inline void Compute(const GlobalTensor<int32_t>& result, int expert,
                                   int row, int col, int rows, int cols, int bank)
    {if(rows==64 && cols==256)ComputeImpl<64,256>(result,expert,row,col,64,256,bank);else ComputeImpl<0,0>(result,expert,row,col,rows,cols,bank);}

    template<int KnownRows,int KnownCols>
    __aicore__ inline void ComputeImpl(const GlobalTensor<int32_t>& result, int expert,
                                   int row, int col, int rows, int cols, int bank)
    {
        if constexpr(KnownRows){rows=KnownRows;cols=KnownCols;}

        const int alignedRows = (rows + 15) / 16 * 16;
        const bool gemv = false;
        const int alignedCols = (cols + 31) / 32 * 32;
        const int area = alignedRows * alignedCols;
        const bool large = area > kTileElements / 2;
        const int offset = large ? 0 : bank * kTileElements / 2;
        const auto matrixEvent = static_cast<TEventID>(bank);
        LocalTensor<int32_t> c(TPosition::CO1, offset * sizeof(int32_t), area);
        const int sliceLimit = Min(kL0SlotBytes / 2 / alignedRows, kL0SlotBytes / 2 / alignedCols) / 32 * 32;
        int kk = panelStart_;
        PreloadPanel(panelIndex_ & 1, expert, row, col, rows, cols, kk, alignedRows, alignedCols);
        for (int done = 0; done < k_; done += Panel) {
            const int depth = Min(k_ - kk, Panel);
            const int alignedDepth = (depth + 31) / 32 * 32;
            const int panelSlot = panelIndex_++ & 1;
            LocalTensor<int8_t> a1(TPosition::A1, panelSlot * TileRows * Panel, TileRows * Panel);
            LocalTensor<int8_t> b1(TPosition::B1, 2 * TileRows * Panel + panelSlot * Panel * TileCols,
                                  Panel * TileCols);

            if (done + Panel < k_) {
                const int nextK = kk + Panel < k_ ? kk + Panel : 0;
                PreloadPanel(panelSlot ^ 1, expert, row, col, rows, cols, nextK, alignedRows, alignedCols);
            }
            WaitFlag<HardEvent::MTE2_MTE1>(static_cast<TEventID>(panelSlot));

            for (int off = 0; off < alignedDepth; off += sliceLimit) {
                const int slice = Min(alignedDepth - off, sliceLimit);
                const auto l0slot = static_cast<TEventID>(l0Index_++ & 1);
                LocalTensor<int8_t> a2(TPosition::A2, static_cast<int>(l0slot) * kL0SlotBytes / 2, kL0SlotBytes / 2);
                LocalTensor<int8_t> b2(TPosition::B2, static_cast<int>(l0slot) * kL0SlotBytes / 2, kL0SlotBytes / 2);
                WaitFlag<HardEvent::M_MTE1>(l0slot);
                LoadSlice(a2, b2, a1, b1, off, slice, alignedRows, alignedCols, alignedDepth, gemv);
                if (off + slice == alignedDepth) {
                    SetFlag<HardEvent::MTE1_MTE2>(static_cast<TEventID>(panelSlot));
                }
                SetFlag<HardEvent::MTE1_M>(l0slot);
                WaitFlag<HardEvent::MTE1_M>(l0slot);

                const bool first = done == 0 && off == 0;
                if (first) {
                    WaitForMatrix(large || lastLarge_ ? 3 : 1 << bank);
                }
                MmadParams mm{};
                mm.m = gemv ? 1 : alignedRows;
                mm.n = alignedCols;
                mm.k = slice;
                mm.cmatrixInitVal = first;
                Mmad(c, a2, b2, mm);
                if ((mm.m / 16) * (mm.n / 16) < 10) { PipeBarrier<PIPE_M>(); }
                SetFlag<HardEvent::M_MTE1>(l0slot);
            }
            // Start each core at a different K panel to spread GM requests.
            kk = kk + Panel < k_ ? kk + Panel : 0;
        }

        SetFlag<HardEvent::M_FIX>(matrixEvent);
        WaitFlag<HardEvent::M_FIX>(matrixEvent);
        if ((produced_ & (1 << bank)) != 0) {
            CrossCoreWaitFlag<0x2>(kConsumed + bank);
        }
        FixpipeParamsV220 store{};
        store.mSize = rows;
        store.nSize = alignedCols;
        store.srcStride = alignedRows;
        store.dstStride = alignedCols;
        store.ndNum = 1;
        Fixpipe<int32_t, int32_t, CFG_ROW_MAJOR>(result, c, store);
        SetFlag<HardEvent::FIX_M>(matrixEvent);
        matrixPending_ |= 1 << bank;
        lastLarge_ = large;
        CrossCoreSetFlag<0x2, PIPE_FIX>(kReady + bank);
        produced_ |= 1 << bank;
    }

    __aicore__ inline void Finish()
    {
        for (int slot = 0; slot < 2; ++slot) {
            if ((produced_ & (1 << slot)) != 0) {
                CrossCoreWaitFlag<0x2>(kConsumed + slot);
            }
            WaitFlag<HardEvent::MTE1_MTE2>(static_cast<TEventID>(slot));
        }
        WaitFlag<HardEvent::M_MTE1>(EVENT_ID0);
        WaitFlag<HardEvent::M_MTE1>(EVENT_ID1);
        WaitForMatrix(3);
    }

private:
    __aicore__ inline void WaitForMatrix(int overlap)
    {
        const int ready = matrixPending_ & overlap;
        if ((ready & 1) != 0) {
            WaitFlag<HardEvent::FIX_M>(EVENT_ID0);
        }
        if ((ready & 2) != 0) {
            WaitFlag<HardEvent::FIX_M>(EVENT_ID1);
        }
        matrixPending_ &= ~overlap;
    }

    // Prepare the next existing L1 bank before consuming the current bank.
    __aicore__ inline void PreloadPanel(int slot, int expert, int row, int col,
                                      int rows, int cols, int kk, int ar, int ac)
    {
        const int depth = Min(k_ - kk, Panel), ad = (depth + 31) / 32 * 32;
        LocalTensor<int8_t> a1(TPosition::A1, slot * TileRows * Panel, TileRows * Panel);
        LocalTensor<int8_t> b1(TPosition::B1, 2 * TileRows * Panel + slot * Panel * TileCols, Panel * TileCols);
        const auto event = static_cast<TEventID>(slot);
        WaitFlag<HardEvent::MTE1_MTE2>(event);
        LoadPanel(a1, b1, expert, row, col, rows, cols, kk, depth, ar, ac, ad);
        SetFlag<HardEvent::MTE2_MTE1>(event);
    }

    __aicore__ inline void LoadPanel(LocalTensor<int8_t> a1, LocalTensor<int8_t> b1,
                                     int expert, int row, int col, int rows, int cols,
                                     int kk, int depth, int alignedRows, int alignedCols, int alignedDepth)
    {
        // ND2NZ pads each K chunk of A and each N chunk of B. Fill only
        // the remaining row gaps in the destination fractals.
        if (rows != alignedRows) {
            Clear(a1[rows * 32], alignedDepth / 32, alignedRows - rows, rows);
        }
        Nd2NzParams aCopy{};aCopy.ndNum=1;aCopy.nValue=rows;aCopy.dstNzC0Stride=alignedRows;aCopy.dstNzNStride=1;
        if(k_%4==0 && depth%4==0){GlobalTensor<int32_t>ga;ga.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(xBase_));aCopy.dValue=depth/4;aCopy.srcDValue=k_/4;DataCopy(a1.ReinterpretCast<int32_t>(),ga[(row*k_+kk)/4],aCopy);}
        else {aCopy.dValue=depth;aCopy.srcDValue=k_;DataCopy(a1,x_[row*k_+kk],aCopy);}

        const int offset = (expert * k_ + kk) * n_ + col;
        switch (packBytes_) {
            case 1:
                LoadPackedWeight<int8_t>(b1, offset, depth, cols, alignedCols);
                break;
            case 2:
                LoadPackedWeight<int16_t>(b1, offset, depth, cols, alignedCols);
                break;
            case 4:
                LoadPackedWeight<int32_t>(b1, offset, depth, cols, alignedCols);
                break;
            default: {
                if (depth != alignedDepth) {
                    Clear(b1[depth * 32], alignedCols / 32, alignedDepth - depth, depth);
                }
                Nd2NzParams bCopy{};
                bCopy.ndNum = 1;
                bCopy.nValue = depth;
                bCopy.dValue = cols;
                bCopy.srcDValue = n_;
                bCopy.dstNzC0Stride = alignedDepth;
                bCopy.dstNzNStride = 1;
                DataCopy(b1, weight_[offset], bCopy);
                break;
            }
        }
    }

    template <class CopyT>
    __aicore__ inline void LoadPackedWeight(LocalTensor<int8_t> b1, int offset,
                                           int depth, int cols, int alignedCols)
    {
        gmg_common::LoadPackedWeight<CopyT>(b1, weightBase_, n_,
                                               offset, depth, cols, alignedCols);
    }

    __aicore__ inline void LoadSlice(LocalTensor<int8_t> a2, LocalTensor<int8_t> b2,
                                     LocalTensor<int8_t> a1, LocalTensor<int8_t> b1,
                                     int off, int slice, int alignedRows, int alignedCols, int alignedDepth, bool gemv)
    {
        if (alignedRows == 16) {
            LoadData2DParams loadA{};
            loadA.repeatTimes = gemv ? (slice + 511) / 512 : slice / 32;
            loadA.srcStride = 1;
            // GEMV reads its one row contiguously from L0A.
            LoadData(a2, a1[gemv ? off : off * alignedRows], loadA);
        } else {
            LoadData3DParamsV2<int8_t> loadA{};
            loadA.l1H = 1;
            loadA.l1W = alignedRows;
            loadA.channelSize = alignedDepth;
            loadA.kExtension = slice;
            loadA.mExtension = alignedRows;
            loadA.kStartPt = off;
            LoadData(a2, a1, loadA);
        }

        LoadData2dTransposeParams loadB{};
        if (packBytes_ != 0) {
            loadB.repeatTimes = (slice / 32) * (alignedCols / 32);
            loadB.srcStride = 1;
            loadB.dstGap = 1;
            LoadDataWithTranspose(b2, b1[off * alignedCols], loadB);
        } else if (alignedCols <= slice) {
            loadB.repeatTimes = slice / 32;
            loadB.srcStride = 1;
            loadB.dstGap = alignedCols / 16 - 1;
            for (int c = 0; c < alignedCols; c += 32) {
                LoadDataWithTranspose(b2[c * 32], b1[c * alignedDepth + off * 32], loadB);
            }
        } else {
            loadB.repeatTimes = alignedCols / 32;
            loadB.srcStride = alignedDepth / 32;
            loadB.dstGap = 1;
            for (int kk = 0; kk < slice; kk += 32) {
                LoadDataWithTranspose(b2[kk * alignedCols], b1[(off + kk) * 32], loadB);
            }
        }
    }


    GlobalTensor<int8_t> x_, weight_;
    GM_ADDR weightBase_;GM_ADDR xBase_;
    int k_, n_, packBytes_, panelStart_;
    int produced_ = 0;
    int matrixPending_ = 0;
    bool lastLarge_ = false;
    int panelIndex_ = 0;
    int l0Index_ = 0;
};


template <int TileCols>
using VectorTile = gmg_common::VectorTile<TileCols, kVectorElements, 256, false, false, true>;

template <int TileRows, int TileCols, class Worker>
__aicore__ inline void ProcessTiles(Worker& worker, GM_ADDR groupList, GM_ADDR workspace,
                                    int experts, int n, int core)
{
    GlobalTensor<int64_t> groups;
    groups.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groupList), experts);
    GlobalTensor<int32_t> slot;
    slot.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(workspace) + core * kOutputSlots * kTileElements,
                         kOutputSlots * kTileElements);

    const int cores = GetBlockNum();
    const int colTiles = (n + TileCols - 1) / TileCols;
    int start = 0;
    int next = core;
    int bank = 0;
    for (int expert = 0; expert < experts; ++expert) {
        const int end = static_cast<int>(groups.GetValue(expert));
        const int tiles = ((end - start + TileRows - 1) / TileRows) * colTiles;
        for (; next < tiles; next += cores) {
            const int row = start + next / colTiles * TileRows;
            const int col = next % colTiles * TileCols;
            worker.Compute(slot[bank * kTileElements], expert, row, col,
                           Min(end - row, TileRows), Min(n - col, TileCols), bank);
            bank ^= 1;
        }
        next -= tiles;
        start = end;
    }
}
}  // namespace

template <int TileRows, int TileCols, int Panel>
__global__ GMG_ENTRY_ALIGN(8192,4096) __mix__(1, 2) void grouped_matmul_gelu_custom(
    GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groupList, GM_ADDR y,
    GM_ADDR workspace, int experts, int k, int n)
{
    AscendC::InitSocState();
    if ASCEND_IS_AIC {
        CubeTile<TileRows, TileCols, Panel> worker;
        worker.Init(x, weight, k, n);
        ProcessTiles<TileRows, TileCols>(worker, groupList, workspace, experts, n, AscendC::GetBlockIdx());
        worker.Finish();
    }
    if ASCEND_IS_AIV {
        VectorTile<TileCols> worker;
        worker.Init(scale, y, n);
        ProcessTiles<TileRows, TileCols>(worker, groupList, workspace, experts, n, AscendC::GetBlockIdx() / 2);
        worker.Finish();
    }
}


}
namespace path_tall_resident_a {
using gmg_common::Min;
using gmg_common::Clear;
using gmg_common::WaitFor;
using gmg_common::GeluTanh;


namespace {
using namespace AscendC;

constexpr int kRows = 128;
constexpr int kCols = 256;
constexpr int kL0SlotBytes = 65536;
constexpr int kPanel = 512;
constexpr int kTileElements = kRows * kCols;
constexpr int kVectorRows = kRows / 2;
constexpr int kVectorElements = kVectorRows * kCols;
constexpr int kReady = 0;
constexpr int kConsumed = 2;
constexpr int kOutputSlots = 2;


template <int TileRows, int TileCols, int Panel>
class CubeTile {
public:
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR weight, int k, int n)
    {
        x_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
        weight_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(weight));
        weightBase_ = weight;
        k_ = k;
        n_ = n;
        panelStart_ = GetBlockIdx() % ((k + Panel - 1) / Panel) * Panel;
        packBytes_=4;
        SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID2);
        SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);
        SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID1);
        SetFlag<HardEvent::M_MTE1>(EVENT_ID0);
    }

    __aicore__ inline void Compute(const GlobalTensor<int32_t>& result, int expert,
                                   int row, int col, int rows, int cols, int bank)
    {
        const int alignedRows = (rows + 15) / 16 * 16;
        if(col%(2*TileCols)==0){
            WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID2);
            LocalTensor<int8_t> resident(TPosition::A1,0,131072);
            if(rows!=alignedRows)Clear(resident[rows*32],k_/32,alignedRows-rows,rows);
            Nd2NzParams cp{};cp.ndNum=1;cp.nValue=rows;cp.dValue=k_;cp.srcDValue=k_;cp.dstNzC0Stride=alignedRows;cp.dstNzNStride=1;
            DataCopy(resident,x_[row*k_],cp);
            SetFlag<HardEvent::MTE2_MTE1>(EVENT_ID2);WaitFlag<HardEvent::MTE2_MTE1>(EVENT_ID2);
        }

        const bool gemv = false;
        const int alignedCols = (cols + 31) / 32 * 32;
        const int area = alignedRows * alignedCols;
        const bool large = area > kTileElements / 2;
        const int offset = large ? 0 : bank * kTileElements / 2;
        const auto matrixEvent = static_cast<TEventID>(bank);
        LocalTensor<int32_t> c(TPosition::CO1, offset * sizeof(int32_t), area);
        const int sliceLimit = Min(kL0SlotBytes / alignedRows, kL0SlotBytes / alignedCols) / 32 * 32;
        const int panelDepth=Panel;
        int kk=(GetBlockIdx()*3)%((k_+panelDepth-1)/panelDepth)*panelDepth;
        int panelSlot = panelIndex_ & 1;
        PrefetchPanel(panelSlot, expert, row, col, rows, cols, kk, alignedRows, alignedCols);
        for (int done = 0; done < k_; done += panelDepth) {
            const int depth = Min(k_ - kk, panelDepth);
            const int alignedDepth = (depth + 31) / 32 * 32;
            const int nextK = kk + panelDepth < k_ ? kk + panelDepth : 0;
            if (done + panelDepth < k_) {
                PrefetchPanel(panelSlot ^ 1, expert, row, col, rows, cols, nextK, alignedRows, alignedCols);
            }
            LocalTensor<int8_t> a1(TPosition::A1, 0, 131072);
            LocalTensor<int8_t> b1(TPosition::B1, 131072 + panelSlot * 196608,
                                  196608);
            WaitFlag<HardEvent::MTE2_MTE1>(static_cast<TEventID>(panelSlot));

            for (int off = 0; off < alignedDepth; off += sliceLimit) {
                const int slice = Min(alignedDepth - off, sliceLimit);
                const auto l0slot=EVENT_ID0;
                LocalTensor<int8_t> a2(TPosition::A2, static_cast<int>(l0slot)*kL0SlotBytes, kL0SlotBytes);
                LocalTensor<int8_t> b2(TPosition::B2, static_cast<int>(l0slot)*kL0SlotBytes, kL0SlotBytes);
                WaitFlag<HardEvent::M_MTE1>(l0slot);
                currentK_=kk;
                LoadSlice(a2, b2, a1, b1, off, slice, alignedRows, alignedCols, alignedDepth, gemv);
                if (off + slice == alignedDepth) {
                    SetFlag<HardEvent::MTE1_MTE2>(static_cast<TEventID>(panelSlot));
                    if(done+panelDepth>=k_ && (col+cols==n_ || (col+cols)%(2*TileCols)==0))SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID2);
                }
                SetFlag<HardEvent::MTE1_M>(l0slot);
                WaitFlag<HardEvent::MTE1_M>(l0slot);

                const bool first = done == 0 && off == 0;
                if (first) {
                    WaitForMatrix(large || lastLarge_ ? 3 : 1 << bank);
                }
                MmadParams mm{};
                mm.m = gemv ? 1 : alignedRows;
                mm.n = alignedCols;
                mm.k = slice;
                mm.cmatrixInitVal = first;
                Mmad(c, a2, b2, mm);
                SetFlag<HardEvent::M_MTE1>(l0slot);
            }
            // Start each core at a different K panel to spread GM requests.
            kk = nextK;
            panelSlot ^= 1;
            ++panelIndex_;
        }

        SetFlag<HardEvent::M_FIX>(matrixEvent);
        WaitFlag<HardEvent::M_FIX>(matrixEvent);
        if ((produced_ & (1 << bank)) != 0) {
            CrossCoreWaitFlag<0x2>(kConsumed + bank);
        }
        FixpipeParamsV220 store{};
        store.mSize = rows;
        store.nSize = alignedCols;
        store.srcStride = alignedRows;
        store.dstStride = alignedCols;
        store.ndNum = 1;
        Fixpipe<int32_t, int32_t, CFG_ROW_MAJOR>(result, c, store);
        SetFlag<HardEvent::FIX_M>(matrixEvent);
        matrixPending_ |= 1 << bank;
        lastLarge_ = large;
        CrossCoreSetFlag<0x2, PIPE_FIX>(kReady + bank);
        produced_ |= 1 << bank;
    }

    __aicore__ inline void Finish()
    {
        for (int slot = 0; slot < 2; ++slot) {
            if ((produced_ & (1 << slot)) != 0) {
                CrossCoreWaitFlag<0x2>(kConsumed + slot);
            }
            WaitFlag<HardEvent::MTE1_MTE2>(static_cast<TEventID>(slot));
        }
        WaitFlag<HardEvent::M_MTE1>(EVENT_ID0);
        WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID2);
        WaitForMatrix(3);
    }

private:
    __aicore__ inline void WaitForMatrix(int overlap)
    {
        const int ready = matrixPending_ & overlap;
        if ((ready & 1) != 0) {
            WaitFlag<HardEvent::FIX_M>(EVENT_ID0);
        }
        if ((ready & 2) != 0) {
            WaitFlag<HardEvent::FIX_M>(EVENT_ID1);
        }
        matrixPending_ &= ~overlap;
    }

__aicore__ inline void PrefetchPanel(int slot, int expert, int row, int col,
                                        int rows, int cols, int kk, int alignedRows, int alignedCols)
    {
        LocalTensor<int8_t> a1(TPosition::A1, slot * 65536, 65536);
        LocalTensor<int8_t> b1(TPosition::B1, 131072 + slot * 196608, 196608);
        const int panelDepth=Panel;
        const int depth = Min(k_ - kk, panelDepth);
        const int alignedDepth = (depth + 31) / 32 * 32;
        const auto event = static_cast<TEventID>(slot);
        WaitFlag<HardEvent::MTE1_MTE2>(event);
        LoadPanel(a1, b1, expert, row, col, rows, cols, kk, depth, alignedRows, alignedCols, alignedDepth);
        SetFlag<HardEvent::MTE2_MTE1>(event);
    }

    __aicore__ inline void LoadPanel(LocalTensor<int8_t> a1, LocalTensor<int8_t> b1,
                                     int expert, int row, int col, int rows, int cols,
                                     int kk, int depth, int alignedRows, int alignedCols, int alignedDepth)
    {
        const int offset = (expert * k_ + kk) * n_ + col;
        switch (packBytes_) {
            case 1:
                LoadPackedWeight<int8_t>(b1, offset, depth, cols, alignedCols);
                break;
            case 2:
                LoadPackedWeight<int16_t>(b1, offset, depth, cols, alignedCols);
                break;
            case 4:
                LoadPackedWeight<int32_t>(b1, offset, depth, cols, alignedCols);
                break;
            default: {
                if (depth != alignedDepth) {
                    Clear(b1[depth * 32], alignedCols / 32, alignedDepth - depth, depth);
                }
                Nd2NzParams bCopy{};
                bCopy.ndNum = 1;
                bCopy.nValue = depth;
                bCopy.dValue = cols;
                bCopy.srcDValue = n_;
                bCopy.dstNzC0Stride = alignedDepth;
                bCopy.dstNzNStride = 1;
                DataCopy(b1, weight_[offset], bCopy);
                break;
            }
        }
    }

    template <class CopyT>
    __aicore__ inline void LoadPackedWeight(LocalTensor<int8_t> b1, int offset,
                                           int depth, int cols, int alignedCols)
    {
        gmg_common::LoadPackedWeight<CopyT>(b1, weightBase_, n_,
                                               offset, depth, cols, alignedCols);
    }

    __aicore__ inline void LoadSlice(LocalTensor<int8_t> a2, LocalTensor<int8_t> b2,
                                     LocalTensor<int8_t> a1, LocalTensor<int8_t> b1,
                                     int off, int slice, int alignedRows, int alignedCols, int alignedDepth, bool gemv)
    {
        if (alignedRows == 16) {
            LoadData2DParams loadA{};
            loadA.repeatTimes = gemv ? (slice + 511) / 512 : slice / 32;
            loadA.srcStride = 1;
            // GEMV reads its one row contiguously from L0A.
            LoadData(a2, a1[gemv ? currentK_+off : (currentK_+off)*alignedRows], loadA);
        } else {
            LoadData3DParamsV2<int8_t> loadA{};
            loadA.l1H = 1;
            loadA.l1W = alignedRows;
            loadA.channelSize = k_;
            loadA.kExtension = slice;
            loadA.mExtension = alignedRows;
            loadA.kStartPt = currentK_+off;
            LoadData(a2, a1, loadA);
        }

        LoadData2dTransposeParams loadB{};
        if (packBytes_ != 0) {
            loadB.repeatTimes = (slice / 32) * (alignedCols / 32);
            loadB.srcStride = 1;
            loadB.dstGap = 1;
            LoadDataWithTranspose(b2, b1[off * alignedCols], loadB);
        } else if (alignedCols <= slice) {
            loadB.repeatTimes = slice / 32;
            loadB.srcStride = 1;
            loadB.dstGap = alignedCols / 16 - 1;
            for (int c = 0; c < alignedCols; c += 32) {
                LoadDataWithTranspose(b2[c * 32], b1[c * alignedDepth + off * 32], loadB);
            }
        } else {
            loadB.repeatTimes = alignedCols / 32;
            loadB.srcStride = alignedDepth / 32;
            loadB.dstGap = 1;
            for (int kk = 0; kk < slice; kk += 32) {
                LoadDataWithTranspose(b2[kk * alignedCols], b1[(off + kk) * 32], loadB);
            }
        }
    }


    GlobalTensor<int8_t> x_, weight_;
    GM_ADDR weightBase_;
    int currentK_=0;
    int k_, n_, packBytes_, panelStart_;
    int produced_ = 0;
    int matrixPending_ = 0;
    bool lastLarge_ = false;
    int panelIndex_ = 0;
    int l0Index_ = 0;
};


template <int TileCols>
using VectorTile = gmg_common::VectorTile<TileCols, kVectorElements, 256, false, false, false>;

template <int TileRows,int TileCols,class Worker>
__aicore__ inline void ProcessTiles(Worker&worker,GM_ADDR groupList,GM_ADDR workspace,int experts,int n,int core){
 GlobalTensor<int64_t>groups;groups.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groupList),experts);
 GlobalTensor<int32_t>slot;slot.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(workspace)+core*kOutputSlots*kTileElements,kOutputSlots*kTileElements);
 constexpr int width=2*TileCols;
 const int windows=(n+width-1)/width;int start=0,next=core,bank=0;
 for(int expert=0;expert<experts;++expert){
  const int end=static_cast<int>(groups.GetValue(expert)),jobs=((end-start+TileRows-1)/TileRows)*windows;
  for(;next<jobs;next+=GetBlockNum()){
   const int row=start+next/windows*TileRows,rows=Min(TileRows,end-row);
   const int firstCol=next%windows*width,lastCol=Min(n,firstCol+width);
   for(int col=firstCol;col<lastCol;col+=TileCols){
    worker.Compute(slot[bank*kTileElements],expert,row,col,rows,Min(TileCols,lastCol-col),bank);bank^=1;
   }
  }
  next-=jobs;start=end;
 }
}

}  // namespace

template <int TileRows, int TileCols, int Panel>
__global__ GMG_ENTRY_ALIGN(16384,16384) __mix__(1, 2) void grouped_matmul_gelu_custom(
    GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groupList, GM_ADDR y,
    GM_ADDR workspace, int experts, int k, int n)
{
    AscendC::InitSocState();
    if ASCEND_IS_AIC {
        CubeTile<TileRows, TileCols, Panel> worker;
        worker.Init(x, weight, k, n);
        ProcessTiles<TileRows, TileCols>(worker, groupList, workspace, experts, n, AscendC::GetBlockIdx());
        worker.Finish();
    }
    if ASCEND_IS_AIV {
        VectorTile<TileCols> worker;
        worker.Init(scale, y, n);
        ProcessTiles<TileRows, TileCols>(worker, groupList, workspace, experts, n, AscendC::GetBlockIdx() / 2);
        worker.Finish();
    }
}


}
namespace path_history_tall {
using gmg_common::Min;
using gmg_common::Clear;
using gmg_common::WaitFor;
using gmg_common::GeluTanh;


namespace {
using namespace AscendC;

constexpr int kRows = 128;
constexpr int kCols = 256;
constexpr int kL0SlotBytes = 65536;
constexpr int kPanel = 512;
constexpr int kTileElements = kRows * kCols;
constexpr int kVectorRows = kRows / 2;
constexpr int kVectorElements = kVectorRows * kCols;
constexpr int kReady = 0;
constexpr int kConsumed = 2;
constexpr int kOutputSlots = 2;


template <int TileRows, int TileCols, int Panel>
class CubeTile {
public:
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR weight, int k, int n)
    {
        x_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
        weight_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(weight));
        weightBase_ = weight;
        k_ = k;
        n_ = n;
        panelStart_ = GetBlockIdx() % ((k + Panel - 1) / Panel) * Panel;
        packBytes_ = n <= 2047 ? 1 : n % 4 == 0 ? 4 : n % 2 == 0 ? 2 : 0;
        SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);
        SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID1);
        SetFlag<HardEvent::M_MTE1>(EVENT_ID0);
        SetFlag<HardEvent::M_MTE1>(EVENT_ID1);
    }

    __aicore__ inline void Compute(const GlobalTensor<int32_t>& result, int expert,
                                   int row, int col, int rows, int cols, int bank)
    {
        const int alignedRows = (rows + 15) / 16 * 16;
        const bool gemv = rows == 1;
        const int alignedCols = (cols + 31) / 32 * 32;
        const int area = alignedRows * alignedCols;
        const bool large = area > kTileElements / 2;
        const int offset = large ? 0 : bank * kTileElements / 2;
        const auto matrixEvent = static_cast<TEventID>(bank);
        LocalTensor<int32_t> c(TPosition::CO1, offset * sizeof(int32_t), area);
        const int sliceLimit = Min(kL0SlotBytes / 2 / alignedRows, kL0SlotBytes / 2 / alignedCols) / 32 * 32;
        int kk = panelStart_;
        for (int done = 0; done < k_; done += Panel) {
            const int depth = Min(k_ - kk, Panel);
            const int alignedDepth = (depth + 31) / 32 * 32;
            const int panelSlot = panelIndex_++ & 1;
            LocalTensor<int8_t> a1(TPosition::A1, panelSlot * TileRows * Panel, TileRows * Panel);
            LocalTensor<int8_t> b1(TPosition::B1, 2 * TileRows * Panel + panelSlot * Panel * TileCols,
                                  Panel * TileCols);

            WaitFlag<HardEvent::MTE1_MTE2>(static_cast<TEventID>(panelSlot));
            LoadPanel(a1, b1, expert, row, col, rows, cols, kk, depth, alignedRows, alignedCols, alignedDepth);
            SetFlag<HardEvent::MTE2_MTE1>(static_cast<TEventID>(panelSlot));
            WaitFlag<HardEvent::MTE2_MTE1>(static_cast<TEventID>(panelSlot));

            for (int off = 0; off < alignedDepth; off += sliceLimit) {
                const int slice = Min(alignedDepth - off, sliceLimit);
                const auto l0slot = static_cast<TEventID>(l0Index_++ & 1);
                LocalTensor<int8_t> a2(TPosition::A2, static_cast<int>(l0slot) * kL0SlotBytes / 2, kL0SlotBytes / 2);
                LocalTensor<int8_t> b2(TPosition::B2, static_cast<int>(l0slot) * kL0SlotBytes / 2, kL0SlotBytes / 2);
                WaitFlag<HardEvent::M_MTE1>(l0slot);
                LoadSlice(a2, b2, a1, b1, off, slice, alignedRows, alignedCols, alignedDepth, gemv);
                if (off + slice == alignedDepth) {
                    SetFlag<HardEvent::MTE1_MTE2>(static_cast<TEventID>(panelSlot));
                }
                SetFlag<HardEvent::MTE1_M>(l0slot);
                WaitFlag<HardEvent::MTE1_M>(l0slot);

                const bool first = done == 0 && off == 0;
                if (first) {
                    WaitForMatrix(large || lastLarge_ ? 3 : 1 << bank);
                }
                MmadParams mm{};
                mm.m = gemv ? 1 : alignedRows;
                mm.n = alignedCols;
                mm.k = slice;
                mm.cmatrixInitVal = first;
                Mmad(c, a2, b2, mm);
                if ((mm.m / 16) * (mm.n / 16) < 10) { PipeBarrier<PIPE_M>(); }
                SetFlag<HardEvent::M_MTE1>(l0slot);
            }
            // Start each core at a different K panel to spread GM requests.
            kk = kk + Panel < k_ ? kk + Panel : 0;
        }

        SetFlag<HardEvent::M_FIX>(matrixEvent);
        WaitFlag<HardEvent::M_FIX>(matrixEvent);
        if ((produced_ & (1 << bank)) != 0) {
            CrossCoreWaitFlag<0x2>(kConsumed + bank);
        }
        FixpipeParamsV220 store{};
        store.mSize = rows;
        store.nSize = alignedCols;
        store.srcStride = alignedRows;
        store.dstStride = alignedCols;
        store.ndNum = 1;
        Fixpipe<int32_t, int32_t, CFG_ROW_MAJOR>(result, c, store);
        SetFlag<HardEvent::FIX_M>(matrixEvent);
        matrixPending_ |= 1 << bank;
        lastLarge_ = large;
        CrossCoreSetFlag<0x2, PIPE_FIX>(kReady + bank);
        produced_ |= 1 << bank;
    }

    __aicore__ inline void Finish()
    {
        for (int slot = 0; slot < 2; ++slot) {
            if ((produced_ & (1 << slot)) != 0) {
                CrossCoreWaitFlag<0x2>(kConsumed + slot);
            }
            WaitFlag<HardEvent::MTE1_MTE2>(static_cast<TEventID>(slot));
        }
        WaitFlag<HardEvent::M_MTE1>(EVENT_ID0);
        WaitFlag<HardEvent::M_MTE1>(EVENT_ID1);
        WaitForMatrix(3);
    }

private:
    __aicore__ inline void WaitForMatrix(int overlap)
    {
        const int ready = matrixPending_ & overlap;
        if ((ready & 1) != 0) {
            WaitFlag<HardEvent::FIX_M>(EVENT_ID0);
        }
        if ((ready & 2) != 0) {
            WaitFlag<HardEvent::FIX_M>(EVENT_ID1);
        }
        matrixPending_ &= ~overlap;
    }

    __aicore__ inline void LoadPanel(LocalTensor<int8_t> a1, LocalTensor<int8_t> b1,
                                     int expert, int row, int col, int rows, int cols,
                                     int kk, int depth, int alignedRows, int alignedCols, int alignedDepth)
    {
        // ND2NZ pads each K chunk of A and each N chunk of B. Fill only
        // the remaining row gaps in the destination fractals.
        if (rows != 1 && rows != alignedRows) {
            Clear(a1[rows * 32], alignedDepth / 32, alignedRows - rows, rows);
        }
        Nd2NzParams aCopy{};
        aCopy.ndNum = 1;
        aCopy.nValue = rows;
        aCopy.dValue = depth;
        aCopy.srcDValue = k_;
        aCopy.dstNzC0Stride = rows == 1 ? 1 : alignedRows;
        aCopy.dstNzNStride = 1;
        DataCopy(a1, x_[row * k_ + kk], aCopy);

        const int offset = (expert * k_ + kk) * n_ + col;
        switch (packBytes_) {
            case 1:
                LoadPackedWeight<int8_t>(b1, offset, depth, cols, alignedCols);
                break;
            case 2:
                LoadPackedWeight<int16_t>(b1, offset, depth, cols, alignedCols);
                break;
            case 4:
                LoadPackedWeight<int32_t>(b1, offset, depth, cols, alignedCols);
                break;
            default: {
                if (depth != alignedDepth) {
                    Clear(b1[depth * 32], alignedCols / 32, alignedDepth - depth, depth);
                }
                Nd2NzParams bCopy{};
                bCopy.ndNum = 1;
                bCopy.nValue = depth;
                bCopy.dValue = cols;
                bCopy.srcDValue = n_;
                bCopy.dstNzC0Stride = alignedDepth;
                bCopy.dstNzNStride = 1;
                DataCopy(b1, weight_[offset], bCopy);
                break;
            }
        }
    }

    template <class CopyT>
    __aicore__ inline void LoadPackedWeight(LocalTensor<int8_t> b1, int offset,
                                           int depth, int cols, int alignedCols)
    {
        gmg_common::LoadPackedWeight<CopyT>(b1, weightBase_, n_,
                                               offset, depth, cols, alignedCols);
    }

    __aicore__ inline void LoadSlice(LocalTensor<int8_t> a2, LocalTensor<int8_t> b2,
                                     LocalTensor<int8_t> a1, LocalTensor<int8_t> b1,
                                     int off, int slice, int alignedRows, int alignedCols, int alignedDepth, bool gemv)
    {
        if (alignedRows == 16) {
            LoadData2DParams loadA{};
            loadA.repeatTimes = gemv ? (slice + 511) / 512 : slice / 32;
            loadA.srcStride = 1;
            // GEMV reads its one row contiguously from L0A.
            LoadData(a2, a1[gemv ? off : off * alignedRows], loadA);
        } else {
            LoadData3DParamsV2<int8_t> loadA{};
            loadA.l1H = 1;
            loadA.l1W = alignedRows;
            loadA.channelSize = alignedDepth;
            loadA.kExtension = slice;
            loadA.mExtension = alignedRows;
            loadA.kStartPt = off;
            LoadData(a2, a1, loadA);
        }

        LoadData2dTransposeParams loadB{};
        if (packBytes_ != 0) {
            loadB.repeatTimes = (slice / 32) * (alignedCols / 32);
            loadB.srcStride = 1;
            loadB.dstGap = 1;
            LoadDataWithTranspose(b2, b1[off * alignedCols], loadB);
        } else if (alignedCols <= slice) {
            loadB.repeatTimes = slice / 32;
            loadB.srcStride = 1;
            loadB.dstGap = alignedCols / 16 - 1;
            for (int c = 0; c < alignedCols; c += 32) {
                LoadDataWithTranspose(b2[c * 32], b1[c * alignedDepth + off * 32], loadB);
            }
        } else {
            loadB.repeatTimes = alignedCols / 32;
            loadB.srcStride = alignedDepth / 32;
            loadB.dstGap = 1;
            for (int kk = 0; kk < slice; kk += 32) {
                LoadDataWithTranspose(b2[kk * alignedCols], b1[(off + kk) * 32], loadB);
            }
        }
    }


    GlobalTensor<int8_t> x_, weight_;
    GM_ADDR weightBase_;
    int k_, n_, packBytes_, panelStart_;
    int produced_ = 0;
    int matrixPending_ = 0;
    bool lastLarge_ = false;
    int panelIndex_ = 0;
    int l0Index_ = 0;
};


template <int TileCols>
using VectorTile = gmg_dense_stream::VectorTile<TileCols, kVectorElements, 256, false, false, false>;

template <int TileRows, int TileCols, class Worker>
__aicore__ inline void ProcessTiles(Worker& worker, GM_ADDR groupList, GM_ADDR workspace,
                                    int experts, int n, int core)
{
    GlobalTensor<int64_t> groups;
    groups.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groupList), experts);
    GlobalTensor<int32_t> slot;
    slot.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(workspace) + core * kOutputSlots * kTileElements,
                         kOutputSlots * kTileElements);

    const int cores = GetBlockNum();
    const int colTiles = (n + TileCols - 1) / TileCols;
    int start = 0;
    int next = core;
    int bank = 0;
    for (int expert = 0; expert < experts; ++expert) {
        const int end = static_cast<int>(groups.GetValue(expert));
        const int tiles = ((end - start + TileRows - 1) / TileRows) * colTiles;
        for (; next < tiles; next += cores) {
            const int row = start + next / colTiles * TileRows;
            const int col = next % colTiles * TileCols;
            worker.Compute(slot[bank * kTileElements], expert, row, col,
                           Min(end - row, TileRows), Min(n - col, TileCols), bank);
            bank ^= 1;
        }
        next -= tiles;
        start = end;
    }
}
}  // namespace

template <int TileRows, int TileCols, int Panel>
__global__ GMG_ENTRY_ALIGN(4096,4096) __mix__(1, 2) void grouped_matmul_gelu_custom(
    GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groupList, GM_ADDR y,
    GM_ADDR workspace, int experts, int k, int n)
{
    AscendC::InitSocState();
    if ASCEND_IS_AIC {
        CubeTile<TileRows, TileCols, Panel> worker;
        worker.Init(x, weight, k, n);
        ProcessTiles<TileRows, TileCols>(worker, groupList, workspace, experts, n, AscendC::GetBlockIdx());
        worker.Finish();
    }
    if ASCEND_IS_AIV {
        VectorTile<TileCols> worker;
        worker.Init(scale, y, n);
        ProcessTiles<TileRows, TileCols>(worker, groupList, workspace, experts, n, AscendC::GetBlockIdx() / 2);
        worker.Finish();
    }
}

}

namespace path_grouped_mix1 {
using gmg_common::Min;
using gmg_common::Clear;
using gmg_common::WaitFor;
using gmg_common::GeluTanh;


namespace {
using namespace AscendC;

constexpr int kRows = 128;
constexpr int kCols = 256;
constexpr int kL0SlotBytes = 65536;
constexpr int kPanel = 512;
constexpr int kTileElements = kRows * kCols;
constexpr int kVectorRows = kRows / 2;
constexpr int kVectorElements = kVectorRows * kCols;
constexpr int kReady = 0;
constexpr int kConsumed = 2;
constexpr int kOutputSlots = 2;


template <int TileRows, int TileCols, int Panel, bool Prefetch = false>
using CubeTile = gmg_common::DenseCube<TileRows, TileCols, Panel, kTileElements, Prefetch>;


template <int TileCols>
using VectorTile = gmg_common::VectorTile<TileCols, kVectorElements, 256, false, true, false>;

template <int TileRows, int TileCols, class Worker>
__aicore__ inline void ProcessTiles(Worker& worker, GM_ADDR groupList, GM_ADDR workspace,
                                    int experts, int n, int core)
{
    GlobalTensor<int64_t> groups;
    groups.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groupList), experts);
    GlobalTensor<int32_t> slot;
    slot.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(workspace) + core * kOutputSlots * kTileElements,
                         kOutputSlots * kTileElements);

    const int cores = GetBlockNum();
    const int colTiles = (n + TileCols - 1) / TileCols;
    int start = 0;
    int next = core;
    int bank = 0;
    for (int expert = 0; expert < experts; ++expert) {
        const int end = static_cast<int>(groups.GetValue(expert));
        const int tiles = ((end - start + TileRows - 1) / TileRows) * colTiles;
        for (; next < tiles; next += cores) {
            const int row = start + next / colTiles * TileRows;
            const int col = next % colTiles * TileCols;
            worker.Compute(slot[bank * kTileElements], expert, row, col,
                           Min(end - row, TileRows), Min(n - col, TileCols), bank);
            bank ^= 1;
        }
        next -= tiles;
        start = end;
    }
}
}  // namespace

template <int TileRows, int TileCols, int Panel>
__global__ GMG_ENTRY_ALIGN(4096,2048) __attribute__((aligned(16))) __mix__(1, 1) void grouped_matmul_gelu_custom(
    GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groupList, GM_ADDR y,
    GM_ADDR workspace, int experts, int k, int n)
{
    AscendC::InitSocState();
    if ASCEND_IS_AIC {
        CubeTile<TileRows, TileCols, Panel> worker;
        worker.Init(x, weight, k, n);worker.OverrideWeightCopy(4);
        ProcessTiles<TileRows, TileCols>(worker, groupList, workspace, experts, n, AscendC::GetBlockIdx());
        worker.Finish();
    }
    if ASCEND_IS_AIV {
        VectorTile<TileCols> worker;
        worker.Init(scale, y, n);
        ProcessTiles<TileRows, TileCols>(worker, groupList, workspace, experts, n, AscendC::GetBlockIdx());
        worker.Finish();
    }
}

}




namespace path_larger_resident {
using gmg_common::Min;
using gmg_common::Clear;
using gmg_common::WaitFor;
using gmg_common::GeluTanh;


namespace {
using namespace AscendC;

constexpr int kRows = 128;
constexpr int kCols = 256;
constexpr int kL0SlotBytes = 65536;
constexpr int kPanel = 512;
constexpr int kTileElements = kRows * kCols;
constexpr int kVectorRows = kRows / 2;
constexpr int kVectorElements = kVectorRows * kCols;
constexpr int kReady = 0;
constexpr int kConsumed = 2;
constexpr int kOutputSlots = 2;





template <int TileRows, int TileCols, int Panel>
class ResidentCube {
public:
    __aicore__ __attribute__((section(".gmg_1_larger_resident"))) inline void Init(GM_ADDR x, GM_ADDR weight, int k, int n)
    {
        x_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
        weight_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(weight));
        weightBase_ = weight;
        pitchK_=(k+31)/32*32;
        aReserve_=TileRows*pitchK_;rowStride_=k;
        k_ = k;
        n_ = n;
        panelStart_ = GetBlockIdx() % ((k + Panel - 1) / Panel) * Panel;
        packBytes_=n<=2047?1:n%4==0?4:n%2==0?2:0;
        SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID2);
        SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);
        SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID1);
        SetFlag<HardEvent::M_MTE1>(EVENT_ID0);
    }

    __aicore__ __attribute__((section(".gmg_1_larger_resident"))) inline void SetGroup(int,int){}
    __aicore__ __attribute__((section(".gmg_1_larger_resident"))) inline void Compute(const GlobalTensor<int32_t>& result, int expert,
                                   int row, int col, int rows, int cols, int bank)
    {
        const int alignedRows = (rows + 15) / 16 * 16;
        WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID2);
        if(expert!=cachedExpert_ || row!=cachedRow_){
            LocalTensor<int8_t> resident(TPosition::A1,0,aReserve_);
            if(rows!=alignedRows)Clear(resident[rows*32],pitchK_/32,alignedRows-rows,rows);
            Nd2NzParams cp{};cp.ndNum=1;cp.nValue=rows;cp.dValue=k_;cp.srcDValue=rowStride_;cp.dstNzC0Stride=alignedRows;cp.dstNzNStride=1;
            DataCopy(resident,x_[row*rowStride_],cp);
            SetFlag<HardEvent::MTE2_MTE1>(EVENT_ID2);WaitFlag<HardEvent::MTE2_MTE1>(EVENT_ID2);
            cachedExpert_=expert;cachedRow_=row;
        }

        const bool gemv = false;
        const int alignedCols = (cols + 31) / 32 * 32;
        const int area = alignedRows * alignedCols;
        const bool large = area > kTileElements / 2;
        const int offset = large ? 0 : bank * kTileElements / 2;
        const auto matrixEvent = static_cast<TEventID>(bank);
        LocalTensor<int32_t> c(TPosition::CO1, offset * sizeof(int32_t), area);
        const int sliceLimit = Min(kL0SlotBytes / alignedRows, kL0SlotBytes / alignedCols) / 32 * 32;
        const int panelDepth=Panel;
        int kk=panelStart_;
        int panelSlot = panelIndex_ & 1;
        PrefetchPanel(panelSlot, expert, row, col, rows, cols, kk, alignedRows, alignedCols);
        for (int done = 0; done < k_; done += panelDepth) {
            const int depth = Min(k_ - kk, panelDepth);
            const int alignedDepth = (depth + 31) / 32 * 32;
            const int nextK = kk + panelDepth < k_ ? kk + panelDepth : 0;
            if (done + panelDepth < k_) {
                PrefetchPanel(panelSlot ^ 1, expert, row, col, rows, cols, nextK, alignedRows, alignedCols);
            }
            LocalTensor<int8_t> a1(TPosition::A1, 0, aReserve_);
            LocalTensor<int8_t> b1(TPosition::B1, aReserve_ + panelSlot*Panel*TileCols,Panel*TileCols);
            WaitFlag<HardEvent::MTE2_MTE1>(static_cast<TEventID>(panelSlot));

            for (int off = 0; off < alignedDepth; off += sliceLimit) {
                const int slice = Min(alignedDepth - off, sliceLimit);
                const auto l0slot=EVENT_ID0;
                LocalTensor<int8_t> a2(TPosition::A2, static_cast<int>(l0slot)*kL0SlotBytes, kL0SlotBytes);
                LocalTensor<int8_t> b2(TPosition::B2, static_cast<int>(l0slot)*kL0SlotBytes, kL0SlotBytes);
                WaitFlag<HardEvent::M_MTE1>(l0slot);
                currentK_=kk;
                LoadSlice(a2, b2, a1, b1, off, slice, alignedRows, alignedCols, alignedDepth, gemv);
                if (off + slice == alignedDepth) {
                    SetFlag<HardEvent::MTE1_MTE2>(static_cast<TEventID>(panelSlot));
                    if(done+panelDepth>=k_)SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID2);
                }
                SetFlag<HardEvent::MTE1_M>(l0slot);
                WaitFlag<HardEvent::MTE1_M>(l0slot);

                const bool first = done == 0 && off == 0;
                if (first) {
                    WaitForMatrix(large || lastLarge_ ? 3 : 1 << bank);
                }
                MmadParams mm{};
                mm.m = gemv ? 1 : alignedRows;
                mm.n = alignedCols;
                mm.k = slice;
                mm.cmatrixInitVal = first;
                Mmad(c, a2, b2, mm);
                if((mm.m/16)*(mm.n/16)<10)PipeBarrier<PIPE_M>();
                SetFlag<HardEvent::M_MTE1>(l0slot);
            }
            // Start each core at a different K panel to spread GM requests.
            kk = nextK;
            panelSlot ^= 1;
            ++panelIndex_;
        }

        SetFlag<HardEvent::M_FIX>(matrixEvent);
        WaitFlag<HardEvent::M_FIX>(matrixEvent);
        if(produced_&(1<<bank))CrossCoreWaitFlag<0x2>(kConsumed+bank);
        FixpipeParamsV220 store{};
        store.mSize = rows;
        store.nSize = alignedCols;
        store.srcStride = alignedRows;
        store.dstStride = alignedCols;
        store.ndNum = 1;
        Fixpipe<int32_t, int32_t, CFG_ROW_MAJOR>(result, c, store);
        SetFlag<HardEvent::FIX_M>(matrixEvent);
        matrixPending_ |= 1 << bank;
        lastLarge_ = large;

        CrossCoreSetFlag<0x2,PIPE_FIX>(kReady+bank);
        produced_ |= 1 << bank;
    }

    __aicore__ __attribute__((section(".gmg_1_larger_resident"))) inline void Finish()
    {
        for (int slot = 0; slot < 2; ++slot) {
            if(produced_&(1<<slot))CrossCoreWaitFlag<0x2>(kConsumed+slot);
            WaitFlag<HardEvent::MTE1_MTE2>(static_cast<TEventID>(slot));
        }
        WaitFlag<HardEvent::M_MTE1>(EVENT_ID0);
        WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID2);
        WaitForMatrix(3);
    }

private:
    __aicore__ __attribute__((section(".gmg_1_larger_resident"))) inline void WaitForMatrix(int overlap)
    {
        const int ready = matrixPending_ & overlap;
        if ((ready & 1) != 0) {
            WaitFlag<HardEvent::FIX_M>(EVENT_ID0);
        }
        if ((ready & 2) != 0) {
            WaitFlag<HardEvent::FIX_M>(EVENT_ID1);
        }
        matrixPending_ &= ~overlap;
    }

__aicore__ __attribute__((section(".gmg_1_larger_resident"))) inline void PrefetchPanel(int slot, int expert, int row, int col,
                                        int rows, int cols, int kk, int alignedRows, int alignedCols)
    {
        LocalTensor<int8_t> a1(TPosition::A1,0,aReserve_);
        LocalTensor<int8_t> b1(TPosition::B1, aReserve_+slot*Panel*TileCols,Panel*TileCols);
        const int panelDepth=Panel;
        const int depth = Min(k_ - kk, panelDepth);
        const int alignedDepth = (depth + 31) / 32 * 32;
        const auto event = static_cast<TEventID>(slot);
        WaitFlag<HardEvent::MTE1_MTE2>(event);
        LoadPanel(a1, b1, expert, row, col, rows, cols, kk, depth, alignedRows, alignedCols, alignedDepth);
        SetFlag<HardEvent::MTE2_MTE1>(event);
    }

    __aicore__ __attribute__((section(".gmg_1_larger_resident"))) inline void LoadPanel(LocalTensor<int8_t> a1, LocalTensor<int8_t> b1,
                                     int expert, int row, int col, int rows, int cols,
                                     int kk, int depth, int alignedRows, int alignedCols, int alignedDepth)
    {
        const int offset = (expert * k_ + kk) * n_ + col;
        switch (packBytes_) {
            case 1:
                LoadPackedWeight<int8_t>(b1, offset, depth, cols, alignedCols);
                break;
            case 2:
                LoadPackedWeight<int16_t>(b1, offset, depth, cols, alignedCols);
                break;
            case 4:
                LoadPackedWeight<int32_t>(b1, offset, depth, cols, alignedCols);
                break;
            default: {
                if (depth != alignedDepth) {
                    Clear(b1[depth * 32], alignedCols / 32, alignedDepth - depth, depth);
                }
                Nd2NzParams bCopy{};
                bCopy.ndNum = 1;
                bCopy.nValue = depth;
                bCopy.dValue = cols;
                bCopy.srcDValue = n_;
                bCopy.dstNzC0Stride = alignedDepth;
                bCopy.dstNzNStride = 1;
                DataCopy(b1, weight_[offset], bCopy);
                break;
            }
        }
    }

    template <class CopyT>
    __aicore__ __attribute__((section(".gmg_1_larger_resident"))) inline void LoadPackedWeight(LocalTensor<int8_t> b1, int offset,
                                           int depth, int cols, int alignedCols)
    {
        gmg_common::LoadPackedWeight<CopyT>(b1, weightBase_, n_,
                                               offset, depth, cols, alignedCols);
    }

    __aicore__ __attribute__((section(".gmg_1_larger_resident"))) inline void LoadSlice(LocalTensor<int8_t> a2, LocalTensor<int8_t> b2,
                                     LocalTensor<int8_t> a1, LocalTensor<int8_t> b1,
                                     int off, int slice, int alignedRows, int alignedCols, int alignedDepth, bool gemv)
    {
        if (alignedRows == 16) {
            LoadData2DParams loadA{};
            loadA.repeatTimes = gemv ? (slice + 511) / 512 : slice / 32;
            loadA.srcStride = 1;
            // GEMV reads its one row contiguously from L0A.
            LoadData(a2, a1[gemv ? currentK_+off : (currentK_+off)*alignedRows], loadA);
        } else {
            LoadData3DParamsV2<int8_t> loadA{};
            loadA.l1H = 1;
            loadA.l1W = alignedRows;
            loadA.channelSize = pitchK_;
            loadA.kExtension = slice;
            loadA.mExtension = alignedRows;
            loadA.kStartPt = currentK_+off;
            LoadData(a2, a1, loadA);
        }

        LoadData2dTransposeParams loadB{};
        if (packBytes_ != 0) {
            loadB.repeatTimes = (slice / 32) * (alignedCols / 32);
            loadB.srcStride = 1;
            loadB.dstGap = 1;
            LoadDataWithTranspose(b2, b1[off * alignedCols], loadB);
        } else if (alignedCols <= slice) {
            loadB.repeatTimes = slice / 32;
            loadB.srcStride = 1;
            loadB.dstGap = alignedCols / 16 - 1;
            for (int c = 0; c < alignedCols; c += 32) {
                LoadDataWithTranspose(b2[c * 32], b1[c * alignedDepth + off * 32], loadB);
            }
        } else {
            loadB.repeatTimes = alignedCols / 32;
            loadB.srcStride = alignedDepth / 32;
            loadB.dstGap = 1;
            for (int kk = 0; kk < slice; kk += 32) {
                LoadDataWithTranspose(b2[kk * alignedCols], b1[(off + kk) * 32], loadB);
            }
        }
    }


    GlobalTensor<int8_t> x_, weight_;
    GM_ADDR weightBase_;
    int rowStride_=0,aReserve_=0;
    int cachedExpert_=-1,cachedRow_=-1;
    int pitchK_;
    int currentK_=0;
    int k_, n_, packBytes_, panelStart_;
    int produced_ = 0;
    int matrixPending_ = 0;
    bool lastLarge_ = false;
    int panelIndex_ = 0;
    int l0Index_ = 0;
};

__aicore__ __attribute__((section(".gmg_1_larger_resident"))) inline void GeluNormalBatch(LocalTensor<float>z,LocalTensor<float>t,uint8_t repeats){
 Muls<float,false>(t,z,-0.07135481627260025f,uint64_t{0},repeats,UnaryRepeatParams{1,1,8,8});PipeBarrier<PIPE_V>();
 Mul<float,false>(t,t,z,uint64_t{0},repeats,BinaryRepeatParams{1,1,1,8,8,8});PipeBarrier<PIPE_V>();
 Adds<float,false>(t,t,-1.5957691216057308f,uint64_t{0},repeats,UnaryRepeatParams{1,1,8,8});PipeBarrier<PIPE_V>();
 Mul<float,false>(t,t,z,uint64_t{0},repeats,BinaryRepeatParams{1,1,1,8,8,8});PipeBarrier<PIPE_V>();
 Mins<float,false>(t,t,80.0f,uint64_t{0},repeats,UnaryRepeatParams{1,1,8,8});PipeBarrier<PIPE_V>();
 Exp<float,false>(t,t,uint64_t{0},repeats,UnaryRepeatParams{1,1,8,8});PipeBarrier<PIPE_V>();
 Adds<float,false>(t,t,1.0f,uint64_t{0},repeats,UnaryRepeatParams{1,1,8,8});PipeBarrier<PIPE_V>();
 Div<float,false>(z,z,t,uint64_t{0},repeats,BinaryRepeatParams{1,1,1,8,8,8});PipeBarrier<PIPE_V>();
}
__aicore__ __attribute__((section(".gmg_1_larger_resident"))) inline void GeluNormalMask(LocalTensor<float>z,LocalTensor<float>t,int count){
 SetMaskNorm();SetVectorMask<float>(0,~uint64_t{0});
 int done=0,full=count/64;
 while(full>0){const int reps=Min(full,255);GeluNormalBatch(z[done],t[done],static_cast<uint8_t>(reps));done+=reps*64;full-=reps;}
 const int tail=count-done;
 if(tail){SetVectorMask<float>(0,(uint64_t{1}<<tail)-1);GeluNormalBatch(z[done],t[done],uint8_t{1});}
 SetVectorMask<float>(0,~uint64_t{0});
}

template <int TileCols, int kVectorElements, int TmpPadding,
          bool CompactAny = false, bool SingleVector = false, bool SpecializeFullTile = false>
class NormalMaskVectorTile {
public:
    __aicore__ __attribute__((section(".gmg_1_larger_resident"))) inline void SetGroup(int, int) {}
    __aicore__ __attribute__((section(".gmg_1_larger_resident"))) inline void SetRowEnd(int) {}
    __aicore__ __attribute__((section(".gmg_1_larger_resident"))) inline void Init(GM_ADDR scale, GM_ADDR y, int n)
    {
        scale_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scale));
        y_.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y));
        n_ = n;
    }

    __aicore__ __attribute__((section(".gmg_1_larger_resident"))) inline void Compute(const GlobalTensor<int32_t>& result, int expert,
                                   int row, int col, int rows, int cols, int bank)
    {
        if constexpr (SpecializeFullTile) {
            if (rows == 64 && cols == 256) {
                ComputeImpl<64, 256>(result, expert, row, col, 64, 256, bank);
            } else {
                ComputeImpl<0, 0>(result, expert, row, col, rows, cols, bank);
            }
        } else {
            ComputeImpl<0, 0>(result, expert, row, col, rows, cols, bank);
        }
    }

    template <int KnownRows, int KnownCols>
    __aicore__ __attribute__((section(".gmg_1_larger_resident"))) inline void ComputeImpl(const GlobalTensor<int32_t>& result, int expert,
                                   int row, int col, int rows, int cols, int bank)
    {
        if constexpr (KnownRows) { rows = KnownRows; cols = KnownCols; }
        const int split = SingleVector ? rows : (rows + 1) / 2;
        const int rowOffset = SingleVector ? 0 : GetSubBlockIdx() * split;
        const int ownRows = Min(split, rows - rowOffset);
        if (ownRows > 0) {
            const int pitch = (cols + 31) / 32 * 32;
            const int count = ownRows * pitch;
            constexpr int accBytes = kVectorElements * sizeof(int32_t);
            constexpr int scaleBytes = TileCols * sizeof(float);
            constexpr int outBytes = kVectorElements * sizeof(half);
            const int buffer = scaleSlot_++ & 1;
            const bool compact = count <= kVectorElements / 2 &&
                                 (CompactAny || (cols == TileCols && n_ % TileCols == 0 && rows % 16 == 0));
            const bool overlap = compact && previousCompact_;
            LocalTensor<int32_t> acc(TPosition::VECCALC,
                                     compact ? buffer * accBytes / 2 : 0,
                                     compact ? kVectorElements / 2 : kVectorElements);
            LocalTensor<float> scales(TPosition::VECCALC, accBytes + buffer * scaleBytes, TileCols);
            const int outOffset = accBytes + 2 * scaleBytes + (compact ? buffer * outBytes / 2 : 0);
            LocalTensor<half> out(TPosition::VECCALC, outOffset,
                                  compact ? kVectorElements / 2 : kVectorElements);
            auto z = acc.ReinterpretCast<float>();
            LocalTensor<float> t(TPosition::VECCALC, accBytes + 2 * scaleBytes + outBytes + TmpPadding + (((accBytes + 2 * scaleBytes + outBytes + TmpPadding) % 512 == 0) ? 256 : 0), kVectorElements);

            if ((cols & 7) == 0 && (n_ & 7) == 0) {
                DataCopy(scales, scale_[expert * n_ + col], cols);
            } else {
                DataCopyExtParams scaleCopy{1, static_cast<uint32_t>(cols * sizeof(float)), 0, 0, 0};
                DataCopyPad(scales, scale_[expert * n_ + col], scaleCopy, DataCopyPadExtParams<float>{});
            }
            if (outputPending_ && !overlap) {
                WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
            }
            CrossCoreWaitFlag<0x2>(kReady + bank);
            DataCopy(acc, result[rowOffset * pitch], count);
            // Release the Cube's slot once the last read finishes.
            CrossCoreSetFlag<0x2, PIPE_MTE2>(kConsumed + bank);
            if (overlap) {
                WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
            }
            SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
            WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);

            Cast(z, acc, RoundMode::CAST_NONE, count);
            PipeBarrier<PIPE_V>();
            // Each repeat handles 64 channels and shares the scale across rows.
            for (int c = 0; c < cols; c += 64) {
                Mul(z[c], z[c], scales[c], static_cast<uint64_t>(Min(64, cols - c)),
                    ownRows, BinaryRepeatParams{1, 1, 1, static_cast<uint8_t>(pitch / 8), static_cast<uint8_t>(pitch / 8), 0});
            }
            PipeBarrier<PIPE_V>();

            GeluNormalMask(z, t, count);
            if (outputPending_ && !overlap) {
                WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
            }
            Cast(out, z, RoundMode::CAST_RINT, count);
            if (overlap) {
                WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
            }
            SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
            SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
            WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);

            DataCopyExtParams outCopy{
                static_cast<uint16_t>(ownRows),
                static_cast<uint32_t>(cols * sizeof(half)),
                static_cast<uint32_t>((pitch - (cols + 15) / 16 * 16) * sizeof(half) / 32),
                static_cast<uint32_t>((n_ - cols) * sizeof(half)),
                0};
            DataCopyPad(y_[(row + rowOffset) * n_ + col], out, outCopy);
            SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
            outputPending_ = true;
            previousCompact_ = compact;
        } else {
            CrossCoreWaitFlag<0x2>(kReady + bank);
            CrossCoreSetFlag<0x2, PIPE_MTE2>(kConsumed + bank);
        }
    }

    __aicore__ __attribute__((section(".gmg_1_larger_resident"))) inline void Finish()
    {
        if (outputPending_) {
            WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
            WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
        }
    }

private:
    int scaleSlot_ = 0;
    bool previousCompact_ = false;
    bool outputPending_ = false;
    GlobalTensor<float> scale_;
    GlobalTensor<half> y_;
    int n_;
};

template <int TileCols>
using VectorTile = NormalMaskVectorTile<TileCols, kVectorElements, 0, false, false, false>;

template <int TileRows,int TileCols,class Worker>
__aicore__ __attribute__((section(".gmg_1_larger_resident"))) inline void ProcessTiles(Worker&worker,GM_ADDR groupList,GM_ADDR workspace,int experts,int n,int core){
 GlobalTensor<int64_t>groups;groups.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groupList));
 const int colTiles=(n+TileCols-1)/TileCols;int total=0,start=0;
 for(int e=0;e<experts;++e){const int end=static_cast<int>(groups.GetValue(e));total+=(end-start+TileRows-1)/TileRows*colTiles;start=end;}
 const int lo=total*core/GetBlockNum(),hi=total*(core+1)/GetBlockNum();
 GlobalTensor<int32_t>slot;slot.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(workspace)+core*kOutputSlots*kTileElements,kOutputSlots*kTileElements);
 int base=0,bank=0;start=0;
 for(int e=0;e<experts;++e){
  const int end=static_cast<int>(groups.GetValue(e)),tasks=(end-start+TileRows-1)/TileRows*colTiles;
  worker.SetGroup(e,start);
  const int left=lo>base?lo-base:0,right=Min(tasks,hi-base);
  for(int job=left;job<right;++job){
   const int row=start+job/colTiles*TileRows,col=job%colTiles*TileCols;
   worker.Compute(slot[bank*kTileElements],e,row,col,Min(TileRows,end-row),Min(TileCols,n-col),bank);bank^=1;
  }
  base+=tasks;start=end;
 }
}
}  // namespace

template <int TileRows, int TileCols, int Panel>
__global__ GMG_ENTRY_ALIGN(8192,4096) __attribute__((section(".gmg_1_larger_resident"))) __mix__(1, 2) void grouped_matmul_gelu_custom(
    GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groupList, GM_ADDR y,
    GM_ADDR workspace, int experts, int k, int n)
{
    InitSocState();
    if ASCEND_IS_AIC {
        ResidentCube<TileRows,TileCols,Panel>worker;worker.Init(x,weight,k,n);
        ProcessTiles<TileRows,TileCols>(worker,groupList,workspace,experts,n,GetBlockIdx());worker.Finish();
    }
    if ASCEND_IS_AIV {
        VectorTile<TileCols>worker;worker.Init(scale,y,n);
        ProcessTiles<TileRows,TileCols>(worker,groupList,workspace,experts,n,GetBlockIdx()/2);worker.Finish();
    }
}

}

namespace path_medium_partitioned {
using gmg_common::Min;
using gmg_common::Clear;
using gmg_common::WaitFor;
using gmg_common::GeluTanh;


namespace {
using namespace AscendC;

constexpr int kRows = 128;
constexpr int kCols = 256;
constexpr int kL0SlotBytes = 65536;
constexpr int kPanel = 512;
constexpr int kTileElements = 16384; // Maximum live half is80*192=15360 INT32 elements.
constexpr int kVectorRows = kRows / 2;
constexpr int kVectorElements = kVectorRows * kCols;
constexpr int kReady = 0;
constexpr int kConsumed = 2;
constexpr int kOutputSlots = 2;


__aicore__ __attribute__((section(".gmg_2_medium_partitioned"))) inline void GeluNormalBatch(LocalTensor<float>z,LocalTensor<float>t,uint8_t repeats){
 Muls<float,false>(t,z,-0.07135481627260025f,uint64_t{0},repeats,UnaryRepeatParams{1,1,8,8});PipeBarrier<PIPE_V>();
 Mul<float,false>(t,t,z,uint64_t{0},repeats,BinaryRepeatParams{1,1,1,8,8,8});PipeBarrier<PIPE_V>();
 Adds<float,false>(t,t,-1.5957691216057308f,uint64_t{0},repeats,UnaryRepeatParams{1,1,8,8});PipeBarrier<PIPE_V>();
 Mul<float,false>(t,t,z,uint64_t{0},repeats,BinaryRepeatParams{1,1,1,8,8,8});PipeBarrier<PIPE_V>();
 Mins<float,false>(t,t,80.0f,uint64_t{0},repeats,UnaryRepeatParams{1,1,8,8});PipeBarrier<PIPE_V>();
 Exp<float,false>(t,t,uint64_t{0},repeats,UnaryRepeatParams{1,1,8,8});PipeBarrier<PIPE_V>();
 Adds<float,false>(t,t,1.0f,uint64_t{0},repeats,UnaryRepeatParams{1,1,8,8});PipeBarrier<PIPE_V>();
 Div<float,false>(z,z,t,uint64_t{0},repeats,BinaryRepeatParams{1,1,1,8,8,8});PipeBarrier<PIPE_V>();
}
__aicore__ __attribute__((section(".gmg_2_medium_partitioned"))) inline void GeluNormalMask(LocalTensor<float>z,LocalTensor<float>t,int count){
 SetMaskNorm();SetVectorMask<float>(0,~uint64_t{0});
 int done=0,full=count/64;
 while(full>0){const int reps=gmg_common::Min(full,255);GeluNormalBatch(z[done],t[done],static_cast<uint8_t>(reps));done+=reps*64;full-=reps;}
 const int tail=count-done;
 if(tail){SetVectorMask<float>(0,(uint64_t{1}<<tail)-1);GeluNormalBatch(z[done],t[done],uint8_t{1});}
 SetVectorMask<float>(0,~uint64_t{0});
}

template <int TileRows, int TileCols, int Panel>
class CubeTile {
public:
    __aicore__ __attribute__((section(".gmg_2_medium_partitioned"))) inline void Init(GM_ADDR x, GM_ADDR weight, int k, int n)
    {
        x_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
        weight_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(weight));
        weightBase_ = weight;
        pitchK_=(k+31)/32*32;
        k_ = k;
        n_ = n;
        panelStart_ = GetBlockIdx() % ((k + Panel - 1) / Panel) * Panel;
        packBytes_=1;
        SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID2);
        SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);
        SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID1);
        SetFlag<HardEvent::M_MTE1>(EVENT_ID0);
        SetFlag<HardEvent::M_MTE1>(EVENT_ID1);
    }

    __aicore__ __attribute__((section(".gmg_2_medium_partitioned"))) inline void SetColumnRange(int begin,int end){columnBegin_=begin;columnEnd_=end;}

    __aicore__ __attribute__((section(".gmg_2_medium_partitioned"))) inline void Compute(const GlobalTensor<int32_t>& result,int expert,
                                   int row,int col,int rows,int cols,int)
    {
        const int alignedRows=(rows+15)/16*16;
        if(col==columnBegin_){
            WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID2);
            LocalTensor<int8_t> a1(TPosition::A1,0,TileRows*1056);
            if(rows!=alignedRows)Clear(a1[rows*32],pitchK_/32,alignedRows-rows,rows);
            Nd2NzParams cp{};cp.ndNum=1;cp.nValue=rows;cp.dValue=k_;cp.srcDValue=k_;
            cp.dstNzC0Stride=alignedRows;cp.dstNzNStride=1;
            DataCopy(a1,x_[row*k_],cp);
            SetFlag<HardEvent::MTE2_MTE1>(EVENT_ID2);WaitFlag<HardEvent::MTE2_MTE1>(EVENT_ID2);
        }
        constexpr int halfRows=TileRows/2;
        const int parts=rows>halfRows?2:1,alignedCols=(cols+31)/32*32;
        const int maxPartRows=(Min(halfRows,rows)+15)/16*16;
        const int sliceLimit=Min(16384/maxPartRows,32768/alignedCols)/32*32;
        int kk=0;
        int panelSlot=panelIndex_&1;
        PrefetchPanel(panelSlot,expert,row,col,rows,cols,kk,alignedRows,alignedCols);
        for(int done=0;done<k_;done+=Panel){
            const int depth=Min(k_-kk,Panel),alignedDepth=(depth+31)/32*32;
            const int nextK=kk+Panel<k_?kk+Panel:0;
            if(done+Panel<k_)PrefetchPanel(panelSlot^1,expert,row,col,rows,cols,nextK,alignedRows,alignedCols);
            LocalTensor<int8_t> a1(TPosition::A1,0,TileRows*1056);
            LocalTensor<int8_t> b1(TPosition::B1,BStart()+panelSlot*BStride(),Panel*TileCols);
            WaitFlag<HardEvent::MTE2_MTE1>(static_cast<TEventID>(panelSlot));
            for(int off=0;off<alignedDepth;off+=sliceLimit){
                const int slice=Min(alignedDepth-off,sliceLimit);
                const int lo=l0Index_++&1;
                const auto freeEvent=static_cast<TEventID>(lo);
                // Each K slot owns one32KiB B2 and two16KiB A2 half buffers.
                // Release that K slot only after both MMAD readers complete.
                WaitFlag<HardEvent::M_MTE1>(freeEvent);
                LocalTensor<int8_t> b2(TPosition::B2,lo*32768,32768);
                LoadData2dTransposeParams bp{};bp.repeatTimes=(slice/32)*(alignedCols/32);
                bp.srcStride=1;bp.dstGap=1;
                LoadDataWithTranspose(b2,b1[off*alignedCols],bp);
                for(int part=0;part<parts;++part){
                    const int partRows=Min(halfRows,rows-part*halfRows),partAr=(partRows+15)/16*16;
                    const auto event=static_cast<TEventID>(part);
                    LocalTensor<int8_t> a2(TPosition::A2,lo*32768+part*16384,16384);
                    LocalTensor<int32_t> c(TPosition::CO1,part*65536,partAr*alignedCols);
                    LoadHalfA(a2,a1,kk+off,slice,alignedRows,part*halfRows,partAr);
                    if(part+1==parts && off+slice==alignedDepth){
                        SetFlag<HardEvent::MTE1_MTE2>(static_cast<TEventID>(panelSlot));
                        if(done+Panel>=k_ && col+cols==columnEnd_)SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID2);
                    }
                    SetFlag<HardEvent::MTE1_M>(event);WaitFlag<HardEvent::MTE1_M>(event);
                    const bool first=done==0 && off==0;
                    if(first)WaitForMatrix(1<<part);
                    MmadParams mm{};mm.m=partAr;mm.n=alignedCols;mm.k=slice;mm.cmatrixInitVal=first;
                    Mmad(c,a2,b2,mm);
                    if(partAr/16*(alignedCols/16)<10)PipeBarrier<PIPE_M>();
                    if(part+1==parts)SetFlag<HardEvent::M_MTE1>(freeEvent);
                    if(done+Panel>=k_ && off+slice==alignedDepth)
                        StoreHalf(result[part*kTileElements],c,partRows,partAr,alignedCols,part);
                }
            }
            kk=nextK;panelSlot^=1;++panelIndex_;
        }
    }

    __aicore__ __attribute__((section(".gmg_2_medium_partitioned"))) inline void StoreHalf(const GlobalTensor<int32_t>& result,
        const LocalTensor<int32_t>& c,int rows,int alignedRows,int alignedCols,int bank)
    {
        const auto event=static_cast<TEventID>(bank);
        SetFlag<HardEvent::M_FIX>(event);WaitFlag<HardEvent::M_FIX>(event);
        if(produced_&(1<<bank))CrossCoreWaitFlag<0x2>(kConsumed+bank);
        FixpipeParamsV220 fp{};fp.mSize=rows;fp.nSize=alignedCols;fp.srcStride=alignedRows;
        fp.dstStride=alignedCols;fp.ndNum=1;
        Fixpipe<int32_t,int32_t,CFG_ROW_MAJOR>(result,c,fp);
        SetFlag<HardEvent::FIX_M>(event);matrixPending_|=1<<bank;
        CrossCoreSetFlag<0x2,PIPE_FIX>(kReady+bank);produced_|=1<<bank;
    }


    __aicore__ __attribute__((section(".gmg_2_medium_partitioned"))) inline void Finish()
    {
        for (int slot = 0; slot < 2; ++slot) {
            if ((produced_ & (1 << slot)) != 0) {
                CrossCoreWaitFlag<0x2>(kConsumed + slot);
            }
            WaitFlag<HardEvent::MTE1_MTE2>(static_cast<TEventID>(slot));
        }
        WaitFlag<HardEvent::M_MTE1>(EVENT_ID0);
        WaitFlag<HardEvent::M_MTE1>(EVENT_ID1);
        WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID2);
        WaitForMatrix(3);
    }

private:
    __aicore__ __attribute__((section(".gmg_2_medium_partitioned"))) inline int BStart() { return (TileRows*1056+65535)/65536*65536; }
    __aicore__ __attribute__((section(".gmg_2_medium_partitioned"))) inline int BStride() { return (Panel*TileCols+65535)/65536*65536; }
    __aicore__ __attribute__((section(".gmg_2_medium_partitioned"))) inline void WaitForMatrix(int overlap)
    {
        const int ready = matrixPending_ & overlap;
        if ((ready & 1) != 0) {
            WaitFlag<HardEvent::FIX_M>(EVENT_ID0);
        }
        if ((ready & 2) != 0) {
            WaitFlag<HardEvent::FIX_M>(EVENT_ID1);
        }
        matrixPending_ &= ~overlap;
    }

__aicore__ __attribute__((section(".gmg_2_medium_partitioned"))) inline void PrefetchPanel(int slot, int expert, int row, int col,
                                        int rows, int cols, int kk, int alignedRows, int alignedCols)
    {
        LocalTensor<int8_t> a1(TPosition::A1,0,TileRows*1056);
        LocalTensor<int8_t> b1(TPosition::B1, BStart()+slot*BStride(),Panel*TileCols);
        const int panelDepth=Panel;
        const int depth = Min(k_ - kk, panelDepth);
        const int alignedDepth = (depth + 31) / 32 * 32;
        const auto event = static_cast<TEventID>(slot);
        WaitFlag<HardEvent::MTE1_MTE2>(event);
        LoadPanel(a1, b1, expert, row, col, rows, cols, kk, depth, alignedRows, alignedCols, alignedDepth);
        SetFlag<HardEvent::MTE2_MTE1>(event);
    }

    __aicore__ __attribute__((section(".gmg_2_medium_partitioned"))) inline void LoadPanel(LocalTensor<int8_t> a1, LocalTensor<int8_t> b1,
                                     int expert, int row, int col, int rows, int cols,
                                     int kk, int depth, int alignedRows, int alignedCols, int alignedDepth)
    {
        const int offset = (expert * k_ + kk) * n_ + col;
        switch (packBytes_) {
            case 1:
                LoadPackedWeight<int8_t>(b1, offset, depth, cols, alignedCols);
                break;
            case 2:
                LoadPackedWeight<int16_t>(b1, offset, depth, cols, alignedCols);
                break;
            case 4:
                LoadPackedWeight<int32_t>(b1, offset, depth, cols, alignedCols);
                break;
            default: {
                if (depth != alignedDepth) {
                    Clear(b1[depth * 32], alignedCols / 32, alignedDepth - depth, depth);
                }
                Nd2NzParams bCopy{};
                bCopy.ndNum = 1;
                bCopy.nValue = depth;
                bCopy.dValue = cols;
                bCopy.srcDValue = n_;
                bCopy.dstNzC0Stride = alignedDepth;
                bCopy.dstNzNStride = 1;
                DataCopy(b1, weight_[offset], bCopy);
                break;
            }
        }
    }

    template <class CopyT>
    __aicore__ __attribute__((section(".gmg_2_medium_partitioned"))) inline void LoadPackedWeight(LocalTensor<int8_t> b1, int offset,
                                           int depth, int cols, int alignedCols)
    {
        gmg_common::LoadPackedWeight<CopyT>(b1, weightBase_, n_,
                                               offset, depth, cols, alignedCols);
    }

    __aicore__ __attribute__((section(".gmg_2_medium_partitioned"))) inline void LoadHalfA(LocalTensor<int8_t> a2,LocalTensor<int8_t> a1,
        int kk,int slice,int fullRows,int rowOffset,int partRows)
    {
        if(fullRows==16){
            LoadData2DParams p{};p.repeatTimes=slice/32;p.srcStride=1;
            LoadData(a2,a1[kk*fullRows],p);
        }else{
            LoadData3DParamsV2<int8_t> p{};p.l1H=1;p.l1W=fullRows;p.channelSize=pitchK_;
            p.kExtension=slice;p.kStartPt=kk;p.mExtension=partRows;p.mStartPt=rowOffset;
            LoadData(a2,a1,p);
        }
    }



    GlobalTensor<int8_t> x_, weight_;
    GM_ADDR weightBase_;
    int pitchK_;
    int columnBegin_=0,columnEnd_=0;
    int currentK_=0;
    int k_, n_, packBytes_, panelStart_;
    int produced_ = 0;
    int matrixPending_ = 0;
    bool lastLarge_ = false;
    int panelIndex_ = 0;
    int l0Index_ = 0;
};


template <int TileCols, int kVectorElements, int TmpPadding,
          bool CompactAny = false, bool SingleVector = false, bool SpecializeFullTile = false>
class IsolatedVectorBase {
public:
    __aicore__ __attribute__((section(".gmg_2_medium_partitioned"))) inline void SetGroup(int, int) {}
    __aicore__ __attribute__((section(".gmg_2_medium_partitioned"))) inline void SetRowEnd(int) {}
    __aicore__ __attribute__((section(".gmg_2_medium_partitioned"))) inline void Init(GM_ADDR scale, GM_ADDR y, int n)
    {
        scale_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scale));
        y_.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y));
        n_ = n;
    }

    __aicore__ __attribute__((section(".gmg_2_medium_partitioned"))) inline void Compute(const GlobalTensor<int32_t>& result, int expert,
                                   int row, int col, int rows, int cols, int bank)
    {
        if constexpr (SpecializeFullTile) {
            if (rows == 64 && cols == 256) {
                ComputeImpl<64, 256>(result, expert, row, col, 64, 256, bank);
            } else {
                ComputeImpl<0, 0>(result, expert, row, col, rows, cols, bank);
            }
        } else {
            ComputeImpl<0, 0>(result, expert, row, col, rows, cols, bank);
        }
    }

    template <int KnownRows, int KnownCols>
    __aicore__ __attribute__((section(".gmg_2_medium_partitioned"))) inline void ComputeImpl(const GlobalTensor<int32_t>& result, int expert,
                                   int row, int col, int rows, int cols, int bank)
    {
        if constexpr (KnownRows) { rows = KnownRows; cols = KnownCols; }
        const int split = SingleVector ? rows : (rows + 1) / 2;
        const int rowOffset = SingleVector ? 0 : GetSubBlockIdx() * split;
        const int ownRows = Min(split, rows - rowOffset);
        if (ownRows > 0) {
            const int pitch = (cols + 31) / 32 * 32;
            const int count = ownRows * pitch;
            constexpr int accBytes = kVectorElements * sizeof(int32_t);
            constexpr int scaleBytes = TileCols * sizeof(float);
            constexpr int outBytes = kVectorElements * sizeof(half);
            const int buffer = scaleSlot_++ & 1;
            const bool compact = count <= kVectorElements / 2 &&
                                 (CompactAny || (cols == TileCols && n_ % TileCols == 0 && rows % 16 == 0));
            const bool overlap = compact && previousCompact_;
            LocalTensor<int32_t> acc(TPosition::VECCALC,
                                     compact ? buffer * accBytes / 2 : 0,
                                     compact ? kVectorElements / 2 : kVectorElements);
            LocalTensor<float> scales(TPosition::VECCALC, accBytes + buffer * scaleBytes, TileCols);
            const int outOffset = accBytes + 2 * scaleBytes + (compact ? buffer * outBytes / 2 : 0);
            LocalTensor<half> out(TPosition::VECCALC, outOffset,
                                  compact ? kVectorElements / 2 : kVectorElements);
            auto z = acc.ReinterpretCast<float>();
            LocalTensor<float> t(TPosition::VECCALC, accBytes + 2 * scaleBytes + outBytes + TmpPadding + (((accBytes + 2 * scaleBytes + outBytes + TmpPadding) % 512 == 0) ? 256 : 0), kVectorElements);

            if ((cols & 7) == 0 && (n_ & 7) == 0) {
                DataCopy(scales, scale_[expert * n_ + col], cols);
            } else {
                DataCopyExtParams scaleCopy{1, static_cast<uint32_t>(cols * sizeof(float)), 0, 0, 0};
                DataCopyPad(scales, scale_[expert * n_ + col], scaleCopy, DataCopyPadExtParams<float>{});
            }
            if (outputPending_ && !overlap) {
                WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
            }
            CrossCoreWaitFlag<0x2>(kReady + bank);
            DataCopy(acc, result[rowOffset * pitch], count);
            // Release the Cube's slot once the last read finishes.
            CrossCoreSetFlag<0x2, PIPE_MTE2>(kConsumed + bank);
            if (overlap) {
                WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
            }
            SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
            WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);

            Cast(z, acc, RoundMode::CAST_NONE, count);
            PipeBarrier<PIPE_V>();
            // Each repeat handles 64 channels and shares the scale across rows.
            for (int c = 0; c < cols; c += 64) {
                Mul(z[c], z[c], scales[c], static_cast<uint64_t>(Min(64, cols - c)),
                    ownRows, BinaryRepeatParams{1, 1, 1, static_cast<uint8_t>(pitch / 8), static_cast<uint8_t>(pitch / 8), 0});
            }
            PipeBarrier<PIPE_V>();

            GeluNormalMask(z, t, count);
            if (outputPending_ && !overlap) {
                WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
            }
            Cast(out, z, RoundMode::CAST_RINT, count);
            if (overlap) {
                WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
            }
            SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
            SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
            WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);

            DataCopyExtParams outCopy{
                static_cast<uint16_t>(ownRows),
                static_cast<uint32_t>(cols * sizeof(half)),
                static_cast<uint32_t>((pitch - (cols + 15) / 16 * 16) * sizeof(half) / 32),
                static_cast<uint32_t>((n_ - cols) * sizeof(half)),
                0};
            DataCopyPad(y_[(row + rowOffset) * n_ + col], out, outCopy);
            SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
            outputPending_ = true;
            previousCompact_ = compact;
        } else {
            CrossCoreWaitFlag<0x2>(kReady + bank);
            CrossCoreSetFlag<0x2, PIPE_MTE2>(kConsumed + bank);
        }
    }

    __aicore__ __attribute__((section(".gmg_2_medium_partitioned"))) inline void Finish()
    {
        if (outputPending_) {
            WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
            WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
        }
    }

private:
    int scaleSlot_ = 0;
    bool previousCompact_ = false;
    bool outputPending_ = false;
    GlobalTensor<float> scale_;
    GlobalTensor<half> y_;
    int n_;
};

template<int TileCols>
class VectorTile {
    using Base=IsolatedVectorBase<TileCols,kVectorElements,256,true,false,false>;
public:
    __aicore__ __attribute__((section(".gmg_2_medium_partitioned"))) inline void SetColumnRange(int,int) {}
    __aicore__ __attribute__((section(".gmg_2_medium_partitioned"))) inline void Init(GM_ADDR scale,GM_ADDR y,int n){base_.Init(scale,y,n);}
    __aicore__ __attribute__((section(".gmg_2_medium_partitioned"))) inline void Compute(const GlobalTensor<int32_t>& frames,int e,
        int row,int col,int rows,int cols,int){
        const int parts=rows>80?2:1;
        for(int part=0;part<parts;++part)
            base_.Compute(frames[part*kTileElements],e,row+part*80,col,Min(80,rows-part*80),cols,part);
    }
    __aicore__ __attribute__((section(".gmg_2_medium_partitioned"))) inline void Finish(){base_.Finish();}
private:Base base_;
};

template <int TileRows,int TileCols,class Worker>
__aicore__ __attribute__((section(".gmg_2_medium_partitioned"))) inline void ProcessTiles(Worker&worker,GM_ADDR groupList,GM_ADDR workspace,int experts,int n,int core){
 GlobalTensor<int64_t>groups;groups.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groupList),experts);
 GlobalTensor<int32_t>slot;slot.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(workspace)+core*kOutputSlots*kTileElements,kOutputSlots*kTileElements);
 const int cores=GetBlockNum(),mains=cores>=5?cores*4/5:cores,helpers=cores-mains;
 const bool main=core<mains;
 const int cut=helpers?Min(n,n*28/1024*32):n;
 const int firstCol=main?0:cut,lastCol=main?cut:n;
 const int firstRegion=main?core:core-mains,step=main?mains:helpers;
 const int m=static_cast<int>(groups.GetValue(experts-1));int bank=0;
 worker.SetColumnRange(firstCol,lastCol);
 for(int begin=firstRegion*TileRows;begin<m && firstCol<lastCol;begin+=step*TileRows){
  const int limit=Min(m,begin+TileRows);int e=static_cast<int>(static_cast<int64_t>(begin)*experts/m),end=static_cast<int>(groups.GetValue(e));
  while(end<=begin){++e;end=static_cast<int>(groups.GetValue(e));}
  while(e>0){const int previous=static_cast<int>(groups.GetValue(e-1));if(previous<=begin)break;--e;end=previous;}
  int row=begin;
  while(row<limit){
   if(end>row){const int rows=Min(end,limit)-row;
    for(int col=firstCol;col<lastCol;col+=TileCols){worker.Compute(slot[bank*kTileElements],e,row,col,rows,Min(TileCols,lastCol-col),bank);}
    row+=rows;
   }
   if(row<limit){++e;end=static_cast<int>(groups.GetValue(e));}
  }
 }
}

}  // namespace

template <int TileRows, int TileCols, int Panel>
__global__ GMG_ENTRY_ALIGN(4096,4096) __attribute__((section(".gmg_2_medium_partitioned"))) __mix__(1, 2) void grouped_matmul_gelu_custom(
    GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groupList, GM_ADDR y,
    GM_ADDR workspace, int experts, int k, int n)
{
    AscendC::InitSocState();
    if ASCEND_IS_AIC {
        CubeTile<TileRows, TileCols, Panel> worker;
        worker.Init(x, weight, k, n);
        ProcessTiles<TileRows, TileCols>(worker, groupList, workspace, experts, n, AscendC::GetBlockIdx());
        worker.Finish();
    }
    if ASCEND_IS_AIV {
        VectorTile<TileCols> worker;
        worker.Init(scale, y, n);
        ProcessTiles<TileRows, TileCols>(worker, groupList, workspace, experts, n, AscendC::GetBlockIdx() / 2);
        worker.Finish();
    }
}


}

namespace {
enum class Algorithm { General, ManySmall, PackedRows, OddMedium, OddLarger,
                       LongReduction, OddShort, MidWidth, SmallMatrix,
                       AlignedGroups, DeepPanels, TallGroups, ShortPanels, GroupedPanels };

static Algorithm SelectAlgorithm(int64_t m, int64_t k, int64_t n, int64_t experts, int64_t cores)
{
    if (cores <= 0 || experts <= 0) { return Algorithm::General; }
    if (m <= 16 && n <= 32 && k <= 32 && k*n <= 128 && m <= 2*cores) {
        return Algorithm::General;
    }
    // These are resource and geometry classes. Group boundaries remain device inputs.
    if (experts >= 4*cores && k <= 512 && n <= 256 && m <= 128*experts) {
        return Algorithm::ManySmall;
    }
    const int64_t paddedWeightBytes=experts*k*((n+31)/32*32);
    if (n%32 != 0 && n >= 512 && k >= 256 && m >= 384*experts &&
        paddedWeightBytes <= 32*1024*1024) {
        return Algorithm::PackedRows;
    }
    if (k > 4096 && n > 256 && n <= 1024 && m > 128*experts && m <= 256*experts) {
        return Algorithm::LongReduction;
    }
    if (n%32 != 0 && n >= 512 && k <= 2048) {
        if (m > 128*experts && m <= 160*experts) { return Algorithm::OddMedium; }
        if (m > 160*experts && m <= 192*experts) { return Algorithm::OddLarger; }
        if (m <= 128*experts && experts >= cores) { return Algorithm::OddShort; }
    }
    if (n%32 != 0 && n >= 256 && n < 512 && k <= 1088 &&
        m >= 256*experts && experts >= cores) {
        return Algorithm::MidWidth;
    }
    if (experts == 1 && m <= 128 && n <= 256 && k <= 256) {
        return Algorithm::SmallMatrix;
    }
    // Split remaining dense geometries without reading tensor data or matching
    // particular shape tuples. Keep General as a fallback for other layouts.
    if (n >= 512 && n%512 == 0 && k >= 512 && k%128 == 0 &&
        m >= 32*experts && m <= 64*experts) {
        return Algorithm::AlignedGroups;
    }
    if (n >= 512 && n%32 == 0 && k >= 256) {
        if (k > 1024) { return Algorithm::DeepPanels; }
        if (m > 64*experts) { return Algorithm::TallGroups; }
        if (k <= 512) { return Algorithm::ShortPanels; }
        return Algorithm::GroupedPanels;
    }
    return Algorithm::General;
}

static bool UseWide(int64_t m, int64_t k, int64_t n, int64_t experts, int64_t cores)
{
    const int64_t total=((m+63)/64)*((n+511)/512);
    const int64_t estimate=(m<experts?m:experts)*(n/512);
    return n>=512 && n%512==0 && k>=512 && k%128==0 && m>=32*experts &&
           m<=64*experts && total>=cores && estimate>=cores &&
           2*((estimate+cores-1)/cores)<=(2*estimate+cores-1)/cores;
}

// Capacity and geometry predicates; group boundaries remain runtime device inputs.
static bool UseResidentA(int64_t m,int64_t k,int64_t n,int64_t experts,int64_t cores){
 return SelectAlgorithm(m,k,n,experts,cores)==Algorithm::AlignedGroups && 64*((k+31)/32*32)<=128*1024;
}
static int64_t SplitDepth(){return 2*704-32;}
static int64_t SplitParts(int64_t k){return (k+SplitDepth()-1)/SplitDepth();}
static bool UseLongSplit(int64_t m,int64_t k,int64_t n,int64_t e,int64_t cores){
    if (cores <= 0 || e <= 0) { return false; }
    const int64_t parts = SplitParts(k);
    const int64_t bytes = parts * m * ((n + 31) / 32 * 32) * sizeof(int32_t);
    const int64_t rowTiles = e * ((m + e * 176 - 1) / (e * 176));
    const int64_t splitColumnTiles = (n + 159) / 160;
    // Keep the original capacity and underfilled-grid gates. This policy
    // only rejects previously selected splits; it enables no new region.
    if (parts <= 1 || bytes > 64 * 1024 * 1024 || rowTiles * splitColumnTiles >= cores) {
        return false;
    }
    // The alternatives use different N tiles: 96 without splitting and
    // 160 with splitting. Compare their longest full-tile work estimates
    // after accounting for the actual number of scheduling waves.
    const int64_t directJobs = rowTiles * ((n + 95) / 96);
    const int64_t splitJobs = rowTiles * splitColumnTiles * parts;
    const int64_t directWaves = (directJobs + cores - 1) / cores;
    const int64_t splitWaves = (splitJobs + cores - 1) / cores;
    const int64_t directWork = directWaves * 96 * ((k + 31) / 32 * 32);
    const int64_t splitWork = splitWaves * 160 * SplitDepth();
    return splitWork < directWork;
}
static bool UseCompactSmall(int64_t m,int64_t k,int64_t n,int64_t e,int64_t cores){
 return e==1 && m>0 && m<=128 && n>0 && n<=256 && k>0 && k<=256 && ((m+15)/16)*((n+127)/128)<=cores;
}

static bool UseTallResidentA(int64_t m,int64_t k,int64_t n,int64_t e,int64_t cores){
 const int64_t rowWindows=((m+127)/128)*((n+511)/512);
 return SelectAlgorithm(m,k,n,e,cores)==Algorithm::TallGroups && n%512==0 && k%128==0 &&
        128*((k+31)/32*32)<=128*1024 && 4*rowWindows>=3*cores;
}

static bool UseLargerResidentA(int64_t m,int64_t k,int64_t n,int64_t experts,int64_t cores){
 if(cores<=0 || experts<=0)return false;
 const int64_t nonempty=m<experts?m:experts;
 const int64_t rowBound=(m-nonempty)/176+nonempty;
 return 176*((k+31)/32*32)+2LL*352*160<=524032 && rowBound*((n+159)/160)>=2*cores;
}

static bool UseMediumPartition(int64_t m,int64_t cores){
 return cores>=5 && (m+159)/160>=cores*4/5;
}

}


static bool UseSmallAligned(int64_t m,int64_t k,int64_t n,int64_t e,int64_t cores){
 return UseCompactSmall(m,k,n,e,cores) && m%16==0 && n%128==0 && k%128==0;
}
static void LaunchSmallAligned(GM_ADDR x,GM_ADDR w,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,int m,int k,int n,aclrtStream stream);
using gmg_common::WaitFor;
namespace { using namespace AscendC;
__aicore__ inline void TinyStoreGlobalScaled(LocalTensor<float> z,LocalTensor<float> t,
                                           GlobalTensor<float> scales,int col,int32_t sum){
 const float value=static_cast<float>(sum)*scales.GetValue(col);
 const float exponent=value*(-1.5957691216057308f-0.07135481627260025f*value*value);
 z.SetValue(col,value);t.SetValue(col,exponent<80.0f?exponent:80.0f);
}
template<int KnownK,int KnownN,int KnownExperts=0>
__aicore__ inline void TinyGroupRowChannelsCached(GM_ADDR x, GM_ADDR weight, GM_ADDR scale,
                                     GM_ADDR groupList, GM_ADDR y, int m, int k, int n, int experts)
{
    if constexpr (KnownK > 0) { k = KnownK; }
    if constexpr (KnownN > 0) { n = KnownN; }
    if constexpr (KnownExperts > 0) { experts = KnownExperts; }
    const int row = GetBlockIdx();
    if (row >= m) {
        return;
    }
    GlobalTensor<int64_t> groups;
    groups.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groupList));
    int expert = 0;
    GlobalTensor<int8_t> input, weights;
    GlobalTensor<float> scales;
    GlobalTensor<half> output;
    input.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
    weights.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(weight));
    scales.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scale));
    output.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y));

    LocalTensor<int8_t> storage(TPosition::VECCALC, 0, 608);
    auto a = input[row*k];
    auto b = weights;
    auto s = scales;
    auto z = storage[288].ReinterpretCast<float>();
    auto t = storage[416].ReinterpretCast<float>();
    auto out = storage[544].ReinterpretCast<half>();

    if (experts > 8) {
        int upper = experts;
        while (expert < upper) {
            const int middle = expert + (upper - expert) / 2;
            if (groups.GetValue(middle) <= row) { expert = middle + 1; }
            else { upper = middle; }
        }
    } else {
        while (groups.GetValue(expert) <= row) { ++expert; }
    }

    b=b[expert*k*n];s=s[expert*n];
    int32_t inputRegisters[KnownK>0 ? KnownK : 1];
    if constexpr(KnownK>0){
        #pragma unroll
        for(int d=0;d<KnownK;++d)inputRegisters[d]=static_cast<int32_t>(a.GetValue(d));
    }

    // Reuse one input load across adjacent output channels. Tail channels
    // follow the same exact INT32 accumulation as complete channel groups.
    int c = 0;
    for (; c + 3 < n; c += 4) {
        int32_t sum0 = 0, sum1 = 0, sum2 = 0, sum3 = 0;
        for (int d = 0; d < k; ++d) {
            int32_t value;
            if constexpr(KnownK>0)value=inputRegisters[d];
            else value=static_cast<int32_t>(a.GetValue(d));
            const int offset = d * n + c;
            sum0 += value * static_cast<int32_t>(b.GetValue(offset));
            sum1 += value * static_cast<int32_t>(b.GetValue(offset + 1));
            sum2 += value * static_cast<int32_t>(b.GetValue(offset + 2));
            sum3 += value * static_cast<int32_t>(b.GetValue(offset + 3));
        }
        TinyStoreGlobalScaled(z, t, s, c, sum0);
        TinyStoreGlobalScaled(z, t, s, c + 1, sum1);
        TinyStoreGlobalScaled(z, t, s, c + 2, sum2);
        TinyStoreGlobalScaled(z, t, s, c + 3, sum3);
    }
    for (; c + 1 < n; c += 2) {
        int32_t sum0 = 0, sum1 = 0;
        for (int d = 0; d < k; ++d) {
            int32_t value;
            if constexpr(KnownK>0)value=inputRegisters[d];
            else value=static_cast<int32_t>(a.GetValue(d));
            const int offset = d * n + c;
            sum0 += value * static_cast<int32_t>(b.GetValue(offset));
            sum1 += value * static_cast<int32_t>(b.GetValue(offset + 1));
        }
        TinyStoreGlobalScaled(z, t, s, c, sum0);
        TinyStoreGlobalScaled(z, t, s, c + 1, sum1);
    }
    if (c < n) {
        int32_t sum = 0;
        for (int d = 0; d < k; ++d) {
            int32_t value;
            if constexpr(KnownK>0)value=inputRegisters[d];
            else value=static_cast<int32_t>(a.GetValue(d));
            sum += value * static_cast<int32_t>(b.GetValue(d * n + c));
        }
        TinyStoreGlobalScaled(z, t, s, c, sum);
    }
    WaitFor<HardEvent::S_V>();
    SetVectorMask<float>(0, (uint64_t{1} << n) - 1);
    Exp<float, false>(t, t, uint64_t{0}, uint8_t{1}, UnaryRepeatParams{1, 1, 8, 8});
    PipeBarrier<PIPE_V>();
    Adds<float, false>(t, t, 1.0f, uint64_t{0}, uint8_t{1}, UnaryRepeatParams{1, 1, 8, 8});
    PipeBarrier<PIPE_V>();
    Div<float, false>(z, z, t, uint64_t{0}, uint8_t{1}, BinaryRepeatParams{1, 1, 1, 8, 8, 8});
    PipeBarrier<PIPE_V>();
    Cast<half, float, false>(out, z, RoundMode::CAST_RINT, uint64_t{0}, uint8_t{1}, UnaryRepeatParams{1, 1, 4, 8});
    WaitFor<HardEvent::V_MTE3>();
    DataCopyPad(output[row * n], out, DataCopyExtParams{1, static_cast<uint32_t>(n * sizeof(half)), 0, 0, 0});
    WaitFor<HardEvent::MTE3_S>();
}
}

template<int KnownK,int KnownN,int KnownExperts=0>
__global__ __attribute__((aligned(128),section(".gmg_0_tiny_cached"))) __vector__ void grouped_matmul_gelu_tiny_cached(
 GM_ADDR x,GM_ADDR w,GM_ADDR s,GM_ADDR g,GM_ADDR y,int m,int k,int n,int experts){
 AscendC::InitSocState();
 AscendC::GlobalTensor<uint64_t> prefetch;
 prefetch.SetGlobalBuffer(reinterpret_cast<__gm__ uint64_t*>(g));AscendC::DataCachePreload(prefetch,int64_t{0});
 prefetch.SetGlobalBuffer(reinterpret_cast<__gm__ uint64_t*>(x));AscendC::DataCachePreload(prefetch,int64_t{0});
 prefetch.SetGlobalBuffer(reinterpret_cast<__gm__ uint64_t*>(w));AscendC::DataCachePreload(prefetch,int64_t{0});
 prefetch.SetGlobalBuffer(reinterpret_cast<__gm__ uint64_t*>(s));AscendC::DataCachePreload(prefetch,int64_t{0});
 TinyGroupRowChannelsCached<KnownK,KnownN,KnownExperts>(x,w,s,g,y,m,k,n,experts);
}

template<int Low,int High,int KnownK,int KnownExperts=0>
static void LaunchTinyCachedN(GM_ADDR x,GM_ADDR w,GM_ADDR s,GM_ADDR g,GM_ADDR y,
 int m,int k,int n,int experts,aclrtStream stream){
 if constexpr(Low==High)grouped_matmul_gelu_tiny_cached<KnownK,Low,KnownExperts><<<m,nullptr,stream>>>(x,w,s,g,y,m,k,n,experts);
 else{constexpr int Middle=(Low+High)/2;
  if(n<=Middle)LaunchTinyCachedN<Low,Middle,KnownK,KnownExperts>(x,w,s,g,y,m,k,n,experts,stream);
  else LaunchTinyCachedN<Middle+1,High,KnownK,KnownExperts>(x,w,s,g,y,m,k,n,experts,stream);
 }
}

// Uniform dispatch across the entire cached-table capacity class, without
// assuming any group boundary or input value.
template<int Low,int High,int KnownK>
static void LaunchTinyCachedE(GM_ADDR x,GM_ADDR w,GM_ADDR s,GM_ADDR g,GM_ADDR y,
 int m,int k,int n,int experts,aclrtStream stream){
 if constexpr(Low==High)LaunchTinyCachedN<1,32/Low,KnownK,Low>(x,w,s,g,y,m,k,n,experts,stream);
 else{constexpr int Middle=(Low+High)/2;
  if(experts<=Middle)LaunchTinyCachedE<Low,Middle,KnownK>(x,w,s,g,y,m,k,n,experts,stream);
  else LaunchTinyCachedE<Middle+1,High,KnownK>(x,w,s,g,y,m,k,n,experts,stream);
 }
}
template<int Low,int High,bool KnownE>
static void LaunchTinyCachedK(GM_ADDR x,GM_ADDR w,GM_ADDR s,GM_ADDR g,GM_ADDR y,
 int m,int k,int n,int experts,aclrtStream stream){
 if constexpr(Low==High){
  if constexpr(KnownE)LaunchTinyCachedE<1,32,Low>(x,w,s,g,y,m,k,n,experts,stream);
  else LaunchTinyCachedN<1,32,Low>(x,w,s,g,y,m,k,n,experts,stream);
 }else{constexpr int Middle=(Low+High)/2;
  if(k<=Middle)LaunchTinyCachedK<Low,Middle,KnownE>(x,w,s,g,y,m,k,n,experts,stream);
  else LaunchTinyCachedK<Middle+1,High,KnownE>(x,w,s,g,y,m,k,n,experts,stream);
 }
}
extern "C" void gmg_launch_cached(GM_ADDR x,GM_ADDR w,GM_ADDR s,GM_ADDR g,GM_ADDR y,
 int m,int k,int n,int experts,aclrtStream stream){
 if(k<=4)LaunchTinyCachedK<1,4,false>(x,w,s,g,y,m,k,n,experts,stream);
 else LaunchTinyCachedN<1,32,0>(x,w,s,g,y,m,k,n,experts,stream);
}

namespace gmg_outer_product {
using namespace AscendC;
using gmg_common::Min;
using gmg_common::WaitFor;
// K=1 is an outer product for every legal expert partition. This path
// preserves the exact integer product before FP32 per-channel scaling.
template<int Rows,int Cols>
__global__ __vector__ void Compute(GM_ADDR x,GM_ADDR w,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,
                                  int m,int n,int experts){
 InitSocState();
 GlobalTensor<int8_t> gx,gw;GlobalTensor<float> gs;GlobalTensor<int64_t> ge;GlobalTensor<half> gy;
 gx.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));gw.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(w));
 gs.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scale));ge.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups));
 gy.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y));
 constexpr int W8=(Rows+31)/32*32,W16=W8+Cols+32,WF=W16+2*Cols+32,SF=WF+4*Cols+32;
 constexpr int Z=SF+4*Cols+32,T=Z+4*Rows*Cols+256,O=T+4*Rows*Cols+128,Bytes=O+2*Rows*Cols;
 LocalTensor<int8_t> mem(TPosition::VECCALC,0,Bytes);
 auto a=mem;auto wb=mem[W8];auto wh=mem[W16].ReinterpretCast<half>();auto wf=mem[WF].ReinterpretCast<float>();
 auto sf=mem[SF].ReinterpretCast<float>();auto z=mem[Z].ReinterpretCast<float>();auto t=mem[T].ReinterpretCast<float>();auto out=mem[O].ReinterpretCast<half>();
 const int colTiles=(n+Cols-1)/Cols;int next=GetBlockIdx(),start=0;
 for(int e=0;e<experts;++e){
  const int end=static_cast<int>(ge.GetValue(e)),jobs=((end-start+Rows-1)/Rows)*colTiles;
  for(;next<jobs;next+=GetBlockNum()){
   const int row=start+(next/colTiles)*Rows,col=(next%colTiles)*Cols;
   const int rows=Min(Rows,end-row),cols=Min(Cols,n-col),pitch=(cols+31)/32*32,count=rows*pitch;
   DataCopyPad(a,gx[row],DataCopyExtParams{1,static_cast<uint32_t>(rows),0,0,0},DataCopyPadExtParams<int8_t>{});
   DataCopyPad(wb,gw[e*n+col],DataCopyExtParams{1,static_cast<uint32_t>(cols),0,0,0},DataCopyPadExtParams<int8_t>{});
   DataCopyPad(sf,gs[e*n+col],DataCopyExtParams{1,static_cast<uint32_t>(cols*4),0,0,0},DataCopyPadExtParams<float>{});
   WaitFor<HardEvent::MTE2_S>();WaitFor<HardEvent::MTE2_V>();
   Cast(wh,wb,RoundMode::CAST_NONE,cols);PipeBarrier<PIPE_V>();
   Cast(wf,wh,RoundMode::CAST_NONE,cols);PipeBarrier<PIPE_V>();
   if(cols!=pitch){Duplicate(z,0.0f,count);PipeBarrier<PIPE_V>();}
   for(int r=0;r<rows;++r)Muls(z[r*pitch],wf,static_cast<float>(a.GetValue(r)),cols);
   PipeBarrier<PIPE_V>();
   for(int c=0;c<cols;c+=64)Mul(z[c],z[c],sf[c],static_cast<uint64_t>(Min(64,cols-c)),rows,
      BinaryRepeatParams{1,1,1,static_cast<uint8_t>(pitch/8),static_cast<uint8_t>(pitch/8),0});
   PipeBarrier<PIPE_V>();gmg_common::GeluTanh(z,t,count);
   Cast(out,z,RoundMode::CAST_RINT,count);WaitFor<HardEvent::V_MTE3>();
   DataCopyPad(gy[row*n+col],out,DataCopyExtParams{static_cast<uint16_t>(rows),static_cast<uint32_t>(cols*2),
      static_cast<uint32_t>((pitch-(cols+15)/16*16)*2/32),static_cast<uint32_t>((n-cols)*2),0});
   WaitFor<HardEvent::MTE3_S>();
  }
  next-=jobs;start=end;
 }
}
}

namespace gmg_single_column {
using namespace AscendC;using gmg_common::Min;using gmg_common::WaitFor;
// Each FP32 reduction covers <=1024 exact INT8 products, hence its absolute
// integer partial is <=2^24. Only INT32 combines the partials across K.
template<int BatchRows>
__global__ __vector__ void Compute(GM_ADDR x,GM_ADDR w,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,
                                  int m,int k,int experts){
 InitSocState();
 GlobalTensor<int8_t> gx,gw;GlobalTensor<float> gs;GlobalTensor<int64_t> ge;GlobalTensor<half> gy;
 gx.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));gw.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(w));
 gs.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scale));ge.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups));
 gy.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y));
 constexpr int MaxX=16384,MaxK=8192,XB=0,WB=MaxX+32,XH=WB+MaxK+32,WH=XH+2*MaxX+32;
 constexpr int XF=WH+2*MaxK+32,WF=XF+4*MaxX+256,Z=WF+4*MaxK+32,T=Z+192,O=T+192,Bytes=O+64;
 LocalTensor<int8_t> mem(TPosition::VECCALC,0,Bytes);
 auto xb=mem[XB],wb=mem[WB];auto xh=mem[XH].ReinterpretCast<half>(),wh=mem[WH].ReinterpretCast<half>();
 auto xf=mem[XF].ReinterpretCast<float>(),wf=mem[WF].ReinterpretCast<float>();
 auto partials=mem[WH].ReinterpretCast<float>(),merged=mem[XH].ReinterpretCast<float>();
 auto partialInts=partials.ReinterpretCast<int32_t>(),mergedInts=merged.ReinterpretCast<int32_t>();
 auto z=mem[Z].ReinterpretCast<float>(),t=mem[T].ReinterpretCast<float>();auto out=mem[O].ReinterpretCast<half>();
 int padded=32;while(padded<k)padded*=2;
 const int microRows=Min(8,MaxX/padded),perRowPartials=padded<64?1:padded/64;
 const int sourceStep=padded<64?padded:64;
 const int finalParts=perRowPartials>=16?perRowPartials/16:1;
 Duplicate(xb.ReinterpretCast<half>(),static_cast<half>(0.0f),MaxX/2);
 Duplicate(wb.ReinterpretCast<half>(),static_cast<half>(0.0f),MaxK/2);
 WaitFor<HardEvent::V_MTE2>();
 int next=GetBlockIdx(),start=0;
 for(int e=0;e<experts;++e){
  const int end=static_cast<int>(ge.GetValue(e)),jobs=(end-start+BatchRows-1)/BatchRows;
  if(next<jobs){
   DataCopyPad(wb,gw[e*k],DataCopyExtParams{1,static_cast<uint32_t>(k),0,0,0},
       DataCopyPadExtParams<int8_t>{true,0,static_cast<uint8_t>((k+31)/32*32-k),0});
   WaitFor<HardEvent::MTE2_V>();Cast(wh,wb,RoundMode::CAST_NONE,padded);PipeBarrier<PIPE_V>();
   Cast(wf,wh,RoundMode::CAST_NONE,padded);PipeBarrier<PIPE_V>();
   const float coefficient=gs.GetValue(e);
   for(;next<jobs;next+=GetBlockNum()){
    const int row=start+next*BatchRows,rows=Min(BatchRows,end-row);
    for(int done=0;done<rows;done+=microRows){
     const int take=Min(microRows,rows-done),count=take*padded;
     DataCopyPad(xb,gx[(row+done)*k],DataCopyExtParams{static_cast<uint16_t>(take),static_cast<uint32_t>(k),0,
         static_cast<uint32_t>((padded-(k+31)/32*32)/32),0},
         DataCopyPadExtParams<int8_t>{true,0,static_cast<uint8_t>((k+31)/32*32-k),0});
     WaitFor<HardEvent::MTE2_V>();Cast(xh,xb,RoundMode::CAST_NONE,count);PipeBarrier<PIPE_V>();
     Cast(xf,xh,RoundMode::CAST_NONE,count);PipeBarrier<PIPE_V>();
     for(int r=0;r<take;++r)Mul(xf[r*padded],xf[r*padded],wf,padded);
     PipeBarrier<PIPE_V>();
     const int repeats=take*perRowPartials;
     for(int first=0;first<repeats;first+=128){
      WholeReduceSum(partials[first],xf[first*sourceStep],sourceStep,Min(128,repeats-first),1,1,sourceStep/8);
     }
     PipeBarrier<PIPE_V>();
     auto reduced=partialInts;int parts=perRowPartials;
     if(perRowPartials>=8){
      WholeReduceSum(merged,partials,Min(16,perRowPartials),take*finalParts,1,1,
          perRowPartials<16?perRowPartials/8:2);
      PipeBarrier<PIPE_V>();Cast(mergedInts,merged,RoundMode::CAST_RINT,take*finalParts);
      reduced=mergedInts;parts=finalParts;
     }else Cast(partialInts,partials,RoundMode::CAST_RINT,repeats);
     WaitFor<HardEvent::V_S>();
     for(int r=0;r<take;++r){
      int32_t total=0;for(int j=0;j<parts;++j)total+=reduced.GetValue(r*parts+j);
      const float value=static_cast<float>(total)*coefficient;
      const float exponent=value*(-1.5957691216057308f-0.07135481627260025f*value*value);
      z.SetValue(done+r,value);t.SetValue(done+r,exponent<80.0f?exponent:80.0f);
     }
    }
    WaitFor<HardEvent::S_V>();SetVectorMask<float>(0,(uint64_t{1}<<rows)-1);
    Exp<float,false>(t,t,uint64_t{0},uint8_t{1},UnaryRepeatParams{1,1,8,8});PipeBarrier<PIPE_V>();
    Adds<float,false>(t,t,1.0f,uint64_t{0},uint8_t{1},UnaryRepeatParams{1,1,8,8});PipeBarrier<PIPE_V>();
    Div<float,false>(z,z,t,uint64_t{0},uint8_t{1},BinaryRepeatParams{1,1,1,8,8,8});PipeBarrier<PIPE_V>();
    Cast<half,float,false>(out,z,RoundMode::CAST_RINT,uint64_t{0},uint8_t{1},UnaryRepeatParams{1,1,4,8});
    WaitFor<HardEvent::V_MTE3>();DataCopyPad(gy[row],out,DataCopyExtParams{1,static_cast<uint32_t>(rows*2),0,0,0});
    WaitFor<HardEvent::MTE3_S>();
   }
  }
  next-=jobs;start=end;
 }
}
}

extern "C" void run_kernel(
    GM_ADDR x,const TensorGroupInfo& info_x,GM_ADDR weight,const TensorGroupInfo& info_weight,
    GM_ADDR scale,const TensorGroupInfo&,GM_ADDR groupList,const TensorGroupInfo&,
    GM_ADDR y,const TensorGroupInfo&,int64_t cores,aclrtStream stream)
{
    const int m=info_x.tensors[0].shape[0], k=info_x.tensors[0].shape[1];
    const int experts=info_weight.tensors[0].shape[0], n=info_weight.tensors[0].shape[2];
    if (m<=16 && n<=32 && k<=32 && k*n<=128 && m<=2*cores) {
        const int launchBlocks=m;
        if (k==1 && n==1) {
            grouped_matmul_gelu_scalar<<<launchBlocks,nullptr,stream>>>(x,weight,scale,groupList,y,m);
        } else if(static_cast<int64_t>(experts)*k*n<=128 && static_cast<int64_t>(experts)*n<=32){
            gmg_launch_cached(x,weight,scale,groupList,y,m,k,n,experts,stream);
        } else {
            LaunchTinyN<1,32,0>(x,weight,scale,groupList,y,m,k,n,experts,stream);
        }
        return;
    }
    if (cores<=0) { return; }
    if(n==1 && m>=8*cores){
        const int64_t tasks=(m+31)/32+experts;
        const int blocks=static_cast<int>(2*cores<tasks?2*cores:tasks);
        gmg_single_column::Compute<32><<<blocks,nullptr,stream>>>(x,weight,scale,groupList,y,m,k,experts);
        return;
    }
    if(k==1){
        const int64_t tasks=((m+63)/64+experts)*((n+255)/256);
        const int blocks=static_cast<int>(2*cores<tasks?2*cores:tasks);
        gmg_outer_product::Compute<64,256><<<blocks,nullptr,stream>>>(x,weight,scale,groupList,y,m,n,experts);
        return;
    }
    const auto algorithm=SelectAlgorithm(m,k,n,experts,cores);
    if(algorithm==Algorithm::SmallMatrix && UseSmallAligned(m,k,n,experts,cores)){LaunchSmallAligned(x,weight,scale,groupList,y,m,k,n,stream);return;}
    const bool residentA=UseResidentA(m,k,n,experts,cores);
    const bool tallResidentA=UseTallResidentA(m,k,n,experts,cores);
    const bool residentOdd=algorithm==Algorithm::OddMedium && k<=1056 && n<=2047;
    const bool partitionOdd=residentOdd && UseMediumPartition(m,cores);
    const bool largerResident=algorithm==Algorithm::OddLarger && UseLargerResidentA(m,k,n,experts,cores);
    if(residentOdd && !partitionOdd && cores>(m+159)/160)cores=(m+159)/160;
    if(residentA && cores>(m+63)/64)cores=(m+63)/64;
    const bool splitLong=algorithm==Algorithm::LongReduction && UseLongSplit(m,k,n,experts,cores);
    const bool compactSmall=algorithm==Algorithm::SmallMatrix && UseCompactSmall(m,k,n,experts,cores);
    const int64_t smallJobs=((m+15)/16)*((n+127)/128);
    int rows=128,cols=256;
    switch (algorithm) {
        case Algorithm::GroupedPanels: rows=64;break;
        case Algorithm::PackedRows: if(k<=1088)rows=64;break;
        case Algorithm::MidWidth: if(k<=768)rows=64;break;
        case Algorithm::OddMedium: rows=160;cols=192;break;
        case Algorithm::OddLarger: rows=176;cols=160;break;
        case Algorithm::LongReduction: rows=176;cols=splitLong?160:96;break;
        case Algorithm::TallGroups: if(tallResidentA){rows=128;cols=256;}break;
        case Algorithm::ShortPanels: rows=64;cols=256;break;
        case Algorithm::OddShort: rows=96;cols=288;break;
        case Algorithm::AlignedGroups: if(residentA){rows=64;cols=512;}else if (UseWide(m,k,n,experts,cores)) {rows=128;cols=512;} break;
        case Algorithm::General: if (UseWide(m,k,n,experts,cores)) {rows=64;cols=512;} else {rows=192;cols=160;} break;
        default: break;
    }
    const int nonempty=m<experts?m:experts;
    const int64_t rowBound=static_cast<int64_t>((m-nonempty)/rows)+nonempty;
    const int64_t bound=compactSmall?smallJobs:splitLong?rowBound*SplitParts(k):rowBound*((n+cols-1)/cols);
    const int blocks=static_cast<int>(cores<bound?cores:bound);
    if (blocks<=0) { return; }
    // Workspace follows active groups, not the padded launch count.
    const int launchBlocks=algorithm==Algorithm::SmallMatrix && !compactSmall && blocks<8?8:blocks;
    const size_t accumulation=static_cast<size_t>(blocks)*2*32768*sizeof(int32_t);
    size_t extra=0;
    if (algorithm==Algorithm::PackedRows) { extra=static_cast<size_t>(experts)*k*((n+31)/32*32); }
    if (algorithm==Algorithm::LongReduction || (algorithm==Algorithm::OddLarger && !largerResident)) {
        extra=static_cast<size_t>((m+15)/16*16+16*experts)*((k+31)/32*32);
    }
    void* scratch=nullptr;
    size_t workspaceBytes=accumulation+extra;
    if(partitionOdd)workspaceBytes=static_cast<size_t>(blocks)*(2*16384+0)*sizeof(int32_t);
    if(compactSmall)workspaceBytes=static_cast<size_t>(smallJobs)*16*128*sizeof(int32_t);
    if(splitLong){
        const size_t planeBytes=static_cast<size_t>(m)*((n+31)/32*32)*sizeof(int32_t);
        const size_t extraPlanes=static_cast<size_t>(SplitParts(k)+1)*planeBytes;
        workspaceBytes=extraPlanes<=64*1024*1024?extraPlanes:static_cast<size_t>(SplitParts(k))*planeBytes;
    }
    if (aclrtMalloc(&scratch,workspaceBytes,ACL_MEM_MALLOC_HUGE_FIRST)!=ACL_SUCCESS) { return; }
    GM_ADDR workspace=(GM_ADDR)scratch;
#define GMG_CALL(NS,R,C,K) NS::grouped_matmul_gelu_custom<R,C,K><<<launchBlocks,nullptr,stream>>>(x,weight,scale,groupList,y,workspace,experts,k,n)
    switch (algorithm) {
        case Algorithm::AlignedGroups:
            if (residentA) { GMG_CALL(path_aligned_resident_a,64,512,128); }
            else if (cols==512) { GMG_CALL(path_general_aligned,128,512,512); }
            else { GMG_CALL(path_general_aligned,128,256,512); }
            break;
        case Algorithm::DeepPanels: GMG_CALL(path_general_deep,128,256,512);break;
        case Algorithm::TallGroups: GMG_CALL(path_history_tall,128,256,512);break;
        case Algorithm::ShortPanels: GMG_CALL(path_short_panels,64,256,256);break;
        case Algorithm::GroupedPanels: GMG_CALL(path_grouped_mix1,64,256,512);break;
        case Algorithm::ManySmall: GMG_CALL(path_many_small,128,256,1088);break;
        case Algorithm::PackedRows: GMG_CALL(path_packed_rows,128,256,512);break;
        case Algorithm::OddMedium:
            if(partitionOdd){ GMG_CALL(path_medium_partitioned,160,192,320); }
            else if(residentOdd){ GMG_CALL(path_odd_medium_resident,160,192,640); }
            else { GMG_CALL(path_odd_medium,160,192,704); }
            break;
        case Algorithm::OddLarger:
            if(largerResident){GMG_CALL(path_larger_resident,176,160,352);}
            else {GMG_CALL(path_odd_larger,176,160,352);}
            break;
        case Algorithm::LongReduction:
            if(splitLong){GMG_CALL(path_long_splitk,176,160,704);}
            else {GMG_CALL(path_long_reduction,176,96,960);}
            break;
        case Algorithm::OddShort: GMG_CALL(path_odd_short,96,288,640);break;
        case Algorithm::MidWidth:
            // Keep all K panels resident so cached weights always cover K.
            if (k<=768) { GMG_CALL(path_mid_prefetch,64,256,768); }
            else { GMG_CALL(path_mid_width,128,256,1088); }
            break;
        case Algorithm::SmallMatrix:
            if(compactSmall){
                if(k<=128){path_small_compact::grouped_matmul_gelu_custom<16,128,128><<<launchBlocks,nullptr,stream>>>(x,weight,scale,groupList,y,workspace,experts,k,n,m);}
                else {path_small_compact::grouped_matmul_gelu_custom<16,128,256><<<launchBlocks,nullptr,stream>>>(x,weight,scale,groupList,y,workspace,experts,k,n,m);}
            } else {GMG_CALL(path_small_matrix,128,256,512);}
            break;
        default:
            if (cols==512) { GMG_CALL(path_general,64,512,384); }
            else { GMG_CALL(path_general,192,160,704); }
            break;
    }
#undef GMG_CALL
    aclrtSynchronizeStream(stream);
    aclrtFree(scratch);
}

#ifdef GMG_BENCH_METADATA
// Host-only benchmark metadata: same selection as run_kernel, with no tensor reads.
extern "C" const char* gmg_bench_selection(int64_t m,int64_t k,int64_t n,int64_t experts,int64_t cores)
{
    switch (SelectAlgorithm(m,k,n,experts,cores)) {
        case Algorithm::AlignedGroups:
            if(UseResidentA(m,k,n,experts,cores))return "path_aligned_resident_a:64:512:128";
            return UseWide(m,k,n,experts,cores)?"path_general_aligned:128:512:512":"path_general_aligned:128:256:512";
        case Algorithm::DeepPanels: return "path_general_deep:128:256:512";
        case Algorithm::TallGroups: return "path_history_tall:128:256:512";
        case Algorithm::ShortPanels: return "path_short_panels:64:256:256";
        case Algorithm::GroupedPanels: return "path_grouped_mix1:64:256:512";
        case Algorithm::ManySmall: return "path_many_small:128:256:1088";
        case Algorithm::PackedRows: return "path_packed_rows:128:256:512";
        case Algorithm::OddMedium:
            if(k<=1056 && n<=2047)return UseMediumPartition(m,cores)?"path_medium_partitioned:160:192:320":"path_odd_medium_resident:160:192:640";
            return "path_odd_medium:160:192:704";
        case Algorithm::OddLarger: return UseLargerResidentA(m,k,n,experts,cores)?"path_larger_resident:176:160:352":"path_odd_larger:176:160:352";
        case Algorithm::LongReduction: return UseLongSplit(m,k,n,experts,cores)?"path_long_splitk:176:160:704":"path_long_reduction:176:96:960";
        case Algorithm::OddShort: return "path_odd_short:96:288:640";
        case Algorithm::MidWidth: return k<=768?"path_mid_prefetch:64:256:768":"path_mid_width:128:256:1088";
        case Algorithm::SmallMatrix: if(UseSmallAligned(m,k,n,experts,cores))return k<=128?"path_small_aligned:16:128:128":"path_small_aligned:16:128:256"; return UseCompactSmall(m,k,n,experts,cores)?(k<=128?"path_small_compact:16:128:128":"path_small_compact:16:128:256"):"path_small_matrix:128:256:512";
        default:
            if (m<=16 && n<=32 && k<=32 && k*n<=128 && m<=2*cores) {
                if(k==1 && n==1)return "global:scalar";
                if(experts*k*n<=128 && experts*n<=32){
                    static const char* names[]={"entry:_Z31grouped_matmul_gelu_tiny_cachedILi0ELi1ELi0EEvPhS0_S0_S0_S0_iiii","entry:_Z31grouped_matmul_gelu_tiny_cachedILi0ELi2ELi0EEvPhS0_S0_S0_S0_iiii","entry:_Z31grouped_matmul_gelu_tiny_cachedILi0ELi3ELi0EEvPhS0_S0_S0_S0_iiii","entry:_Z31grouped_matmul_gelu_tiny_cachedILi0ELi4ELi0EEvPhS0_S0_S0_S0_iiii","entry:_Z31grouped_matmul_gelu_tiny_cachedILi0ELi5ELi0EEvPhS0_S0_S0_S0_iiii","entry:_Z31grouped_matmul_gelu_tiny_cachedILi0ELi6ELi0EEvPhS0_S0_S0_S0_iiii","entry:_Z31grouped_matmul_gelu_tiny_cachedILi0ELi7ELi0EEvPhS0_S0_S0_S0_iiii","entry:_Z31grouped_matmul_gelu_tiny_cachedILi0ELi8ELi0EEvPhS0_S0_S0_S0_iiii","entry:_Z31grouped_matmul_gelu_tiny_cachedILi0ELi9ELi0EEvPhS0_S0_S0_S0_iiii","entry:_Z31grouped_matmul_gelu_tiny_cachedILi0ELi10ELi0EEvPhS0_S0_S0_S0_iiii","entry:_Z31grouped_matmul_gelu_tiny_cachedILi0ELi11ELi0EEvPhS0_S0_S0_S0_iiii","entry:_Z31grouped_matmul_gelu_tiny_cachedILi0ELi12ELi0EEvPhS0_S0_S0_S0_iiii","entry:_Z31grouped_matmul_gelu_tiny_cachedILi0ELi13ELi0EEvPhS0_S0_S0_S0_iiii","entry:_Z31grouped_matmul_gelu_tiny_cachedILi0ELi14ELi0EEvPhS0_S0_S0_S0_iiii","entry:_Z31grouped_matmul_gelu_tiny_cachedILi0ELi15ELi0EEvPhS0_S0_S0_S0_iiii","entry:_Z31grouped_matmul_gelu_tiny_cachedILi0ELi16ELi0EEvPhS0_S0_S0_S0_iiii","entry:_Z31grouped_matmul_gelu_tiny_cachedILi0ELi17ELi0EEvPhS0_S0_S0_S0_iiii","entry:_Z31grouped_matmul_gelu_tiny_cachedILi0ELi18ELi0EEvPhS0_S0_S0_S0_iiii","entry:_Z31grouped_matmul_gelu_tiny_cachedILi0ELi19ELi0EEvPhS0_S0_S0_S0_iiii","entry:_Z31grouped_matmul_gelu_tiny_cachedILi0ELi20ELi0EEvPhS0_S0_S0_S0_iiii","entry:_Z31grouped_matmul_gelu_tiny_cachedILi0ELi21ELi0EEvPhS0_S0_S0_S0_iiii","entry:_Z31grouped_matmul_gelu_tiny_cachedILi0ELi22ELi0EEvPhS0_S0_S0_S0_iiii","entry:_Z31grouped_matmul_gelu_tiny_cachedILi0ELi23ELi0EEvPhS0_S0_S0_S0_iiii","entry:_Z31grouped_matmul_gelu_tiny_cachedILi0ELi24ELi0EEvPhS0_S0_S0_S0_iiii","entry:_Z31grouped_matmul_gelu_tiny_cachedILi0ELi25ELi0EEvPhS0_S0_S0_S0_iiii","entry:_Z31