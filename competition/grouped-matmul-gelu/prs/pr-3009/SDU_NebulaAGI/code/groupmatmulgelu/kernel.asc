using namespace AscendC;


struct GmgTiling {
    AscendC::tiling::TCubeTiling mm;    
    int32_t M;
    int32_t K;
    int32_t N;
    int32_t E;
    int32_t baseM;
    int32_t baseN;
    int32_t coreNum;                     
    int32_t aivTotal;                    
    int32_t rsv0;                        
    int32_t gchunk;                      
    int32_t rsv1;
    int32_t rsv2;
};

constexpr int32_t GMG_MAX_E = 128;
constexpr float GMG_GELU_BETA = 0.044715f;
constexpr float GMG_GELU_ALPHA = -1.5957691216057308f;    
constexpr float GMG_GELU_ALPHA_BETA = GMG_GELU_ALPHA * GMG_GELU_BETA;    
constexpr int32_t GMG_UB_BUDGET = 165888;                 

#define GMG_USE_MDL_CFG 1           


constexpr MatmulApiStaticTiling GmgStaticTiling()
{
    MatmulApiStaticTiling tt{};
    {    
        
        
        
        
        MatmulConfig c = CFG_MDL;
        c.enUnitFlag = true;
        tt.cfg = c;
    }
    tt.isBias = 0;
    tt.shareMode = 0;
    tt.shareL1Size = 0;
    tt.shareL0CSize = 0;
    tt.shareUbSize = 0;
    tt.ALayoutInfoB = 0; tt.ALayoutInfoS = 0; tt.ALayoutInfoN = 0;
    tt.ALayoutInfoG = 0; tt.ALayoutInfoD = 0;
    tt.BLayoutInfoB = 0; tt.BLayoutInfoS = 0; tt.BLayoutInfoN = 0;
    tt.BLayoutInfoG = 0; tt.BLayoutInfoD = 0;
    tt.CLayoutInfoB = 0; tt.CLayoutInfoS1 = 0; tt.CLayoutInfoN = 0;
    tt.CLayoutInfoG = 0; tt.CLayoutInfoS2 = 0;
    tt.BatchNum = 0;
    tt.mxTypePara = 0;
    return tt;
}
constexpr MatmulApiStaticTiling GMG_MM_CFG = GmgStaticTiling();
constexpr int32_t GMG_NUM_SLOTS = 4;                       
constexpr int32_t GMG_BATCH_ROWS = 32;                     
constexpr int64_t GMG_MICRO_MACS = 512;                    
                                                          
                                                          
                                                          
                                                          
constexpr int32_t GMG_MICRO_SAFE_N = 16;                   
                                                          
                                                          
                                                          
                                                          
constexpr int64_t GMG_MICRO_WBYTES = 4096;                 
constexpr uint16_t GMG_FLAG_C2V = 8;                       
constexpr uint16_t GMG_FLAG_V2C = 9;



constexpr uint16_t GMG_FLAG_C2VH = 10;

__aicore__ inline int32_t GmgAlignUp(int32_t v, int32_t a)
{
    return (v + a - 1) / a * a;
}

__aicore__ inline void GmgCopyTiling(GmgTiling* t, GM_ADDR tilingGm)
{
    uint32_t* dst = reinterpret_cast<uint32_t*>(t);
    auto src = reinterpret_cast<__gm__ uint32_t*>(tilingGm);
    for (uint32_t i = 0; i < sizeof(GmgTiling) / sizeof(uint32_t); ++i) {
        dst[i] = src[i];
    }
}


struct GmgTileCoord {
    int32_t e;
    int32_t realM;
    int32_t realN;
    int64_t aOff;     
    int64_t bOff;     
    int64_t sOff;     
    int64_t yOff;     
};



struct GmgGroups {
    int64_t ends[GMG_MAX_E];       
    int64_t rowBase[GMG_MAX_E];    
    int64_t tileCum[GMG_MAX_E + 1];
    int64_t nTiles;                
    int64_t total;                 
};

__aicore__ inline void GmgBuildGroups(const GmgTiling& t, GM_ADDR groupList, GmgGroups& g)
{
    
    
    
    
    
    
    
    
    auto gl = reinterpret_cast<__gm__ int64_t*>(groupList);
    g.nTiles = ((int64_t)t.N + t.baseN - 1) / t.baseN;
    int64_t prevEnd = 0;
    int64_t total = 0;
    for (int32_t e = 0; e < t.E; ++e) {
        const volatile __gm__ int64_t* glv = gl;        
        const int64_t end = glv[e];                     
        g.ends[e] = end;
        g.rowBase[e] = prevEnd;
        g.tileCum[e] = total;
        const int64_t rows = end - prevEnd;       
        if (rows > 0) {
            total += ((rows + t.baseM - 1) / t.baseM) * g.nTiles;
        }
        prevEnd = end;
    }
    g.tileCum[t.E] = total;
    g.total = total;
}





__aicore__ inline int32_t GmgPadWidth(int32_t w)
{
    const int32_t r = w % 16;
    if (r == 0) { return w; }
    if (r <= 12) { return w - r + 12; }
    if (r <= 14) { return w - r + 14; }
    return w + 1;
}





__aicore__ inline int32_t GmgCStride(int32_t N, int32_t baseN)
{
    const int32_t p = GmgPadWidth(baseN);
    const int32_t w = N > p ? N : p;
    return (w >= 256) ? ((w + 15) / 16 * 16) : w;
}


__aicore__ inline int32_t GmgCStrideG(int32_t N, int32_t baseN, int32_t gchunk)
{
    const int32_t p = GmgPadWidth((int64_t)gchunk * baseN);
    const int32_t w = N > p ? N : p;
    return (w >= 256) ? ((w + 15) / 16 * 16) : w;
}





template <bool GCHUNK>
__aicore__ inline void GmgDecode(const GmgTiling& t, const GmgGroups& g,
                                                    int64_t blk, GmgTileCoord* c)
{
    
    
    int32_t eLo = 0, eHi = t.E - 1;
    while (eLo < eHi) {
        const int32_t eMid = (eLo + eHi + 1) >> 1;
        if (g.tileCum[eMid] <= blk) { eLo = eMid; } else { eHi = eMid - 1; }
    }
    const int32_t e = eLo;
    const int64_t local = blk - g.tileCum[e];
    
    
    const int64_t mTile = local / g.nTiles;
    const int64_t nTile = local % g.nTiles;
    const int64_t me = g.ends[e] - g.rowBase[e];
    const int64_t m0 = mTile * t.baseM;
    
    const int64_t n0 = GCHUNK ? nTile * (int64_t)t.gchunk * t.baseN : nTile * t.baseN;

    c->e = e;
    c->realM = (int32_t)(t.baseM < me - m0 ? t.baseM : me - m0);    
    if (GCHUNK && t.gchunk > 1) {
        const int64_t gN = (int64_t)t.gchunk * t.baseN;
        c->realN = (int32_t)(gN < t.N - n0 ? gN : t.N - n0);
        c->aOff = (g.rowBase[e] + m0) * t.K;
        c->sOff = (int64_t)e * t.N + n0;
        c->yOff = (g.rowBase[e] + m0) * t.N + n0;
    } else {
        c->realN = (int32_t)(t.baseN < t.N - n0 ? t.baseN : t.N - n0);
        c->aOff = (g.rowBase[e] + m0) * t.K;
        c->sOff = (int64_t)e * t.N + n0;
        c->yOff = (g.rowBase[e] + m0) * t.N + n0;
    }
    c->bOff = (int64_t)e * t.K * t.N + n0;
}



__aicore__ inline void GmgSliceN(const GmgTiling& t, const GmgTileCoord& c, int32_t nb,
                                 GmgTileCoord* out)
{
    *out = c;
    if (t.gchunk <= 1) { return; }
    const int64_t off = (int64_t)nb * t.baseN;
    const int64_t w = (int64_t)c.realN - off;
    out->realN = (int32_t)(t.baseN < w ? t.baseN : w);
    out->bOff = c.bOff + off;
    out->sOff = c.sOff + off;
    out->yOff = c.yOff + off;
}




constexpr int32_t GMG_PF_BYTES = 32768;

__aicore__ inline bool GmgPfGate(const GmgTiling& t, int64_t coreNum)
{
    
    
    
    
    
    
    (void)t; (void)coreNum;
    return false;
}


__aicore__ inline void GmgPrefetchB(GlobalTensor<int8_t>& wGm, GmgTiling const& t,
                                    const GmgTileCoord& cp, int64_t sub,
                                    LocalTensor<int8_t>& pfUb)
{
    const int32_t wN = cp.realN;
    if (wN <= 0 || wN > t.N) { return; }
    const int64_t kHalf = ((int64_t)t.K + 1) / 2;
    int64_t kBeg = (sub == 0) ? 0 : kHalf;
    const int64_t kEnd = (sub == 0) ? kHalf : (int64_t)t.K;
    if (kEnd <= kBeg) { return; }
    const int64_t rowBytes = ((int64_t)wN + 31) / 32 * 32;
    int64_t rowsPer = (int64_t)GMG_PF_BYTES / rowBytes;
    if (rowsPer < 1) { rowsPer = 1; }
    if (rowsPer > 4095) { rowsPer = 4095; }
    for (int64_t k0 = kBeg; k0 < kEnd; k0 += rowsPer) {
        const int64_t left = kEnd - k0;
        const int32_t R = (int32_t)(left < rowsPer ? left : rowsPer);
        DataCopyExtParams extP{(uint16_t)R, (uint32_t)wN, (uint32_t)(t.N - wN), 0, 0};
        DataCopyPadExtParams<int8_t> padP{false, 0, 0, 0};
        DataCopyPad(pfUb, wGm[cp.bOff + k0 * (int64_t)t.N], extP, padP);
    }
}


struct GmgVecCtx {
    TQue<QuePosition::VECIN, 1>* accQue;     
    TQue<QuePosition::VECIN, 1>* scQue;      
    TQue<QuePosition::VECOUT, 1>* outQue;    
    LocalTensor<float> zf;                    
    LocalTensor<float> tmp;                   
    int32_t aN8w;
    int32_t cStride;                          
    
    TQue<QuePosition::VECIN, 2>* bAccQue;    
    TQue<QuePosition::VECOUT, 1>* bOutQue;    
    LocalTensor<float> bZf;                   
    LocalTensor<float> bTmp;                  
    int32_t chRows;                           
};






__aicore__ inline void GmgEpilogueBatch(GmgVecCtx& vc, const GmgTiling& t,
                                        GlobalTensor<int32_t>& cGm,
                                        GlobalTensor<half>& yGm, LocalTensor<float>& scUb,
                                        int64_t slotBase, const GmgTileCoord& c,
                                        int32_t rBeg, int32_t rEnd)
{
    const int32_t aN8 = vc.aN8w;              
    
    int32_t r0 = rBeg;
    while (r0 < rEnd) {
        int32_t nFly = 0;
        int32_t flyR[2];
        int64_t flyR0[2];
        while (nFly < 2 && r0 < rEnd) {           
            const int32_t rem = rEnd - r0;
            const int32_t R = rem < vc.chRows ? rem : vc.chRows;
            LocalTensor<int32_t> pre = vc.bAccQue->AllocTensor<int32_t>();
            DataCopyExtParams extC{static_cast<uint16_t>(R), static_cast<uint16_t>(aN8 * 4),
                                   static_cast<uint16_t>((vc.cStride - aN8) * 4), 0, 0};
            DataCopyPadExtParams<int32_t> padC{false, 0, 0, 0};
            DataCopyPad(pre, cGm[slotBase + (int64_t)r0 * vc.cStride], extC, padC);
            vc.bAccQue->EnQue(pre);
            flyR[nFly] = R;
            flyR0[nFly] = r0;
            r0 += R;
            ++nFly;
        }
        for (int32_t k = 0; k < nFly; ++k) {
            const int32_t R = flyR[k];
            const int64_t cr0 = flyR0[k];
            const int32_t nEl = R * aN8;
            LocalTensor<int32_t> acc = vc.bAccQue->DeQue<int32_t>();    

            Cast<float>(vc.bZf, acc, RoundMode::CAST_RINT, nEl);    
            PipeBarrier<PIPE_V>();
            vc.bAccQue->FreeTensor(acc);

            for (int32_t b = 0; b < aN8; b += 64) {   
                
                
                
                
                const int32_t w = (aN8 - b) < 64 ? (aN8 - b) : 64;
                BinaryRepeatParams bp(1, 1, 1, (uint8_t)(aN8 / 8), (uint8_t)(aN8 / 8), 0);
                Mul(vc.bZf[b], vc.bZf[b], scUb[b], (uint64_t)w, (uint8_t)R, bp);
            }
            PipeBarrier<PIPE_V>();

            
            Mul(vc.bTmp, vc.bZf, vc.bZf, nEl);        
            Muls(vc.bTmp, vc.bTmp, GMG_GELU_ALPHA_BETA, nEl);    
            Adds(vc.bTmp, vc.bTmp, GMG_GELU_ALPHA, nEl);         
            Mul(vc.bTmp, vc.bZf, vc.bTmp, nEl);        
            Exp(vc.bTmp, vc.bTmp, nEl);               
            PipeBarrier<PIPE_V>();
            Adds(vc.bTmp, vc.bTmp, 1.0f, nEl);
            PipeBarrier<PIPE_V>();
            Div(vc.bZf, vc.bZf, vc.bTmp, nEl);        
            PipeBarrier<PIPE_V>();

            LocalTensor<half> out = vc.bOutQue->AllocTensor<half>();
            Cast<half>(out, vc.bZf, RoundMode::CAST_RINT, nEl);     
            vc.bOutQue->EnQue(out);
            out = vc.bOutQue->DeQue<half>();          
            DataCopyExtParams extY{static_cast<uint16_t>(R), static_cast<uint16_t>(c.realN * 2), 0,
                                   static_cast<uint16_t>((t.N - c.realN) * 2), 0};
            DataCopyPad(yGm[c.yOff + cr0 * t.N], out, extY);
            vc.bOutQue->FreeTensor(out);
        }
    }
}

__aicore__ inline void GmgEpilogueTail(GmgVecCtx& vc, const GmgTiling& t,
                                        GlobalTensor<int32_t>& cGm,
                                        GlobalTensor<half>& yGm, LocalTensor<float>& scUb,
                                        int64_t slotBase, const GmgTileCoord& c,
                                        int32_t rBeg, int32_t rEnd)
{
    
    
    
    
    
    
    
    
    
    
    
    
    
    const int32_t aN8  = GmgAlignUp(c.realN, 8);
    const int32_t aN16 = GmgAlignUp(c.realN, 16);
    
    
    
    const bool fast2D  = (aN16 <= vc.aN8w) && (aN16 <= vc.cStride) && (aN16 <= 2040);
    const int32_t pit  = fast2D ? aN16 : aN8;    
    
    
    if (pit > aN8) { Duplicate<float>(scUb[aN8], 0.0f, pit - aN8); PipeBarrier<PIPE_V>(); }
    
    int32_t r0 = rBeg;
    while (r0 < rEnd) {
        int32_t nFly = 0;
        int32_t flyR[2];
        int64_t flyR0[2];
        while (nFly < 2 && r0 < rEnd) {           
            const int32_t rem = rEnd - r0;
            const int32_t R = rem < vc.chRows ? rem : vc.chRows;
            LocalTensor<int32_t> pre = vc.bAccQue->AllocTensor<int32_t>();
            
            
            DataCopyExtParams extC{static_cast<uint16_t>(R), static_cast<uint16_t>(pit * 4),
                                   static_cast<uint16_t>((vc.cStride - pit) * 4), 0, 0};
            DataCopyPadExtParams<int32_t> padC{false, 0, 0, 0};
            DataCopyPad(pre, cGm[slotBase + (int64_t)r0 * vc.cStride], extC, padC);
            vc.bAccQue->EnQue(pre);
            flyR[nFly] = R;
            flyR0[nFly] = r0;
            r0 += R;
            ++nFly;
        }
        for (int32_t k = 0; k < nFly; ++k) {
            const int32_t R = flyR[k];
            const int64_t cr0 = flyR0[k];
            const int32_t nEl = R * pit;
            LocalTensor<int32_t> acc = vc.bAccQue->DeQue<int32_t>();    

            Cast<float>(vc.bZf, acc, RoundMode::CAST_RINT, nEl);    
            PipeBarrier<PIPE_V>();
            vc.bAccQue->FreeTensor(acc);

            for (int32_t rr = 0; rr < R; ++rr) {    
                Mul(vc.bZf[rr * pit], vc.bZf[rr * pit], scUb, pit);    
            }                                                         
            PipeBarrier<PIPE_V>();

            Mul(vc.bTmp, vc.bZf, vc.bZf, nEl);        
            PipeBarrier<PIPE_V>();
            Mul(vc.bTmp, vc.bZf, vc.bTmp, nEl);       
            PipeBarrier<PIPE_V>();
            Muls(vc.bTmp, vc.bTmp, GMG_GELU_BETA, nEl);
            PipeBarrier<PIPE_V>();
            Add(vc.bTmp, vc.bZf, vc.bTmp, nEl);       
            PipeBarrier<PIPE_V>();
            Muls(vc.bTmp, vc.bTmp, GMG_GELU_ALPHA, nEl);
            PipeBarrier<PIPE_V>();
            Exp(vc.bTmp, vc.bTmp, nEl);               
            PipeBarrier<PIPE_V>();
            Adds(vc.bTmp, vc.bTmp, 1.0f, nEl);
            PipeBarrier<PIPE_V>();
            Div(vc.bZf, vc.bZf, vc.bTmp, nEl);        
            PipeBarrier<PIPE_V>();

            
            
            
            
            
            if (fast2D) {
                
                
                
                LocalTensor<half> out = vc.bOutQue->AllocTensor<half>();
                Cast<half>(out, vc.bZf, RoundMode::CAST_RINT, nEl);    
                vc.bOutQue->EnQue(out);
                out = vc.bOutQue->DeQue<half>();
                DataCopyExtParams extY{(uint16_t)R, (uint32_t)(c.realN * 2), 0,
                                       (uint32_t)((t.N - c.realN) * 2), 0};
                DataCopyPad(yGm[c.yOff + cr0 * t.N], out, extY);
                vc.bOutQue->FreeTensor(out);
            } else {
            for (int32_t rr = 0; rr < R; ++rr) {
                LocalTensor<half> out = vc.bOutQue->AllocTensor<half>();
                Cast<half>(out, vc.bZf[rr * aN8], RoundMode::CAST_RINT, aN8);    
                vc.bOutQue->EnQue(out);
                out = vc.bOutQue->DeQue<half>();
                DataCopyExtParams extY{1, (uint16_t)(c.realN * 2), 0, 0, 0};
                DataCopyPad(yGm[c.yOff + (cr0 + rr) * t.N], out, extY);
                vc.bOutQue->FreeTensor(out);
            }
            }
        }
    }
}




template <typename GMGVC>
__aicore__ inline void GmgEpilogueGather(GMGVC& vc, const GmgTiling& t,
                                         GlobalTensor<int32_t>& cGm,
                                         GlobalTensor<half>& yGm, LocalTensor<float>& scUb,
                                         int64_t slotBase, const GmgTileCoord& c,
                                         int32_t rBeg, int32_t rEnd)
{
    const int32_t w16 = vc.cStride;                     
    
    
    const int32_t aN8 = (GmgAlignUp(c.realN, 8) < vc.aN8w) ? GmgAlignUp(c.realN, 8) : vc.aN8w;
    const int32_t Rg = (vc.chRows * aN8) / w16;         
    int32_t r0 = rBeg;
    while (r0 < rEnd) {
        int32_t nFly = 0;
        int32_t flyR[2];
        int64_t flyR0[2];
        while (nFly < 2 && r0 < rEnd) {           
            const int32_t rem = rEnd - r0;
            const int32_t R = rem < Rg ? rem : Rg;
            LocalTensor<int32_t> pre = vc.bAccQue->template AllocTensor<int32_t>();
            DataCopyExtParams extC{1, (uint16_t)(R * w16 * 4), 0, 0, 0};
            DataCopyPadExtParams<int32_t> padC{false, 0, 0, 0};
            DataCopyPad(pre, cGm[slotBase + (int64_t)r0 * w16], extC, padC);
            vc.bAccQue->EnQue(pre);
            flyR[nFly] = R;
            flyR0[nFly] = r0;
            r0 += R;
            ++nFly;
        }
        for (int32_t k = 0; k < nFly; ++k) {
            const int32_t R = flyR[k];
            const int64_t cr0 = flyR0[k];
            const int32_t nEl = R * w16;
            LocalTensor<int32_t> acc = vc.bAccQue->template DeQue<int32_t>();    

            Cast<float>(vc.bZf, acc, RoundMode::CAST_RINT, nEl);    
            PipeBarrier<PIPE_V>();
            vc.bAccQue->FreeTensor(acc);

            for (int32_t b = 0; b < aN8; b += 64) {   
                const int32_t w = (aN8 - b) < 64 ? (aN8 - b) : 64;
                BinaryRepeatParams bp(1, 1, 1, (uint8_t)(w16 / 8), (uint8_t)(w16 / 8), 0);
                Mul(vc.bZf[b], vc.bZf[b], scUb[b], (uint64_t)w, (uint8_t)R, bp);
            }
            PipeBarrier<PIPE_V>();

            Mul(vc.bTmp, vc.bZf, vc.bZf, nEl);        
            PipeBarrier<PIPE_V>();
            Mul(vc.bTmp, vc.bZf, vc.bTmp, nEl);       
            PipeBarrier<PIPE_V>();
            Muls(vc.bTmp, vc.bTmp, GMG_GELU_BETA, nEl);
            PipeBarrier<PIPE_V>();
            Add(vc.bTmp, vc.bZf, vc.bTmp, nEl);       
            PipeBarrier<PIPE_V>();
            Muls(vc.bTmp, vc.bTmp, GMG_GELU_ALPHA, nEl);
            PipeBarrier<PIPE_V>();
            Exp(vc.bTmp, vc.bTmp, nEl);               
            PipeBarrier<PIPE_V>();
            Adds(vc.bTmp, vc.bTmp, 1.0f, nEl);
            PipeBarrier<PIPE_V>();
            Div(vc.bZf, vc.bZf, vc.bTmp, nEl);        
            PipeBarrier<PIPE_V>();

            LocalTensor<half> out = vc.bOutQue->template AllocTensor<half>();
            Cast<half>(out, vc.bZf, RoundMode::CAST_RINT, nEl);     
            PipeBarrier<PIPE_V>();
            
            GatherMaskParams gp;
            gp.src0BlockStride = 1;
            gp.src0RepeatStride = (uint16_t)(w16 / 16);
            gp.src1RepeatStride = 0;
            gp.repeatTimes = (uint16_t)R;
            uint64_t rsvdCnt = 0;
            GatherMask(out, out, 7, true, (uint64_t)c.realN, gp, rsvdCnt);
            vc.bOutQue->EnQue(out);
            out = vc.bOutQue->template DeQue<half>();          
            DataCopyExtParams extY{1, (uint16_t)(R * c.realN * 2), 0, 0, 0};
            DataCopyPad(yGm[c.yOff + cr0 * t.N], out, extY);
            vc.bOutQue->FreeTensor(out);
        }
    }
}












__aicore__ inline void GmgEpilogue(GmgVecCtx& vc, const GmgTiling& t,
                                   GlobalTensor<int32_t>& cGm, GlobalTensor<float>& scaleGm,
                                   GlobalTensor<half>& yGm,
                                   int64_t slotBase, const GmgTileCoord& c,
                                   int32_t rBeg, int32_t rEnd)
{
    const int32_t aN8 = GmgAlignUp(c.realN, 8);    

    
    {
        LocalTensor<float> sc = vc.scQue->AllocTensor<float>();
        DataCopyExtParams extS{1, (uint32_t)(c.realN * 4), 0, 0, 0};
        DataCopyPadExtParams<float> padS{true, 0, (uint8_t)(aN8 - c.realN), 0.0f};
        DataCopyPad(sc, scaleGm[c.sOff], extS, padS);
        vc.scQue->EnQue(sc);
    }
    LocalTensor<float> scUb = vc.scQue->DeQue<float>();

    if (vc.chRows > 0 && c.realN == t.N && t.N < t.baseN && (vc.cStride % 16) == 0 &&
        c.realN >= 16 && t.gchunk <= 1 && ((vc.chRows * vc.aN8w) / vc.cStride) >= 8) {
        
        
        
        GmgEpilogueGather(vc, t, cGm, yGm, scUb, slotBase, c, rBeg, rEnd);
        vc.scQue->FreeTensor(scUb);
        return;
    }

    if (vc.chRows > 0 && c.realN == t.baseN && aN8 >= 8) {    
        
        
        GmgEpilogueBatch(vc, t, cGm, yGm, scUb, slotBase, c, rBeg, rEnd);
        vc.scQue->FreeTensor(scUb);
        return;
    }
    if (vc.chRows > 0 && aN8 >= 8) {
        
        
        
        
        
        
        
        
        
        
        GmgEpilogueTail(vc, t, cGm, yGm, scUb, slotBase, c, rBeg, rEnd);
        vc.scQue->FreeTensor(scUb);
        return;
    }

    
    for (int32_t r = rBeg; r < rEnd; ++r) {
        LocalTensor<int32_t> acc = vc.accQue->AllocTensor<int32_t>();
        DataCopyExtParams extC{1, (uint32_t)(c.realN * 4), 0, 0, 0};
        DataCopyPadExtParams<int32_t> padC{true, 0, (uint8_t)(aN8 - c.realN), 0};
        DataCopyPad(acc, cGm[slotBase + (int64_t)r * vc.cStride], extC, padC);   
        vc.accQue->EnQue(acc);
        acc = vc.accQue->DeQue<int32_t>();        

        Cast<float>(vc.zf, acc, RoundMode::CAST_RINT, aN8);    
        PipeBarrier<PIPE_V>();
        vc.accQue->FreeTensor(acc);

        Mul(vc.zf, vc.zf, scUb, aN8);             
        PipeBarrier<PIPE_V>();

        Mul(vc.tmp, vc.zf, vc.zf, aN8);           
        PipeBarrier<PIPE_V>();
        Mul(vc.tmp, vc.zf, vc.tmp, aN8);          
        PipeBarrier<PIPE_V>();
        Muls(vc.tmp, vc.tmp, GMG_GELU_BETA, aN8);
        PipeBarrier<PIPE_V>();
        Add(vc.tmp, vc.zf, vc.tmp, aN8);          
        PipeBarrier<PIPE_V>();
        Muls(vc.tmp, vc.tmp, GMG_GELU_ALPHA, aN8);
        PipeBarrier<PIPE_V>();
        Exp(vc.tmp, vc.tmp, aN8);                 
        PipeBarrier<PIPE_V>();
        Adds(vc.tmp, vc.tmp, 1.0f, aN8);
        PipeBarrier<PIPE_V>();
        Div(vc.zf, vc.zf, vc.tmp, aN8);           
        PipeBarrier<PIPE_V>();

        LocalTensor<half> out = vc.outQue->AllocTensor<half>();
        Cast<half>(out, vc.zf, RoundMode::CAST_RINT, aN8);     
        vc.outQue->EnQue(out);
        out = vc.outQue->DeQue<half>();           
        DataCopyExtParams extY{1, (uint32_t)(c.realN * 2), 0, 0, 0};
        DataCopyPad(yGm[c.yOff + (int64_t)r * t.N], out, extY);
        vc.outQue->FreeTensor(out);
    }
    vc.scQue->FreeTensor(scUb);
}













__global__ __aicore__ __mix__(1, 2) void gmg_mix_kernel(
    GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groupList, GM_ADDR y,
    GM_ADDR workspace, GM_ADDR cWs, GM_ADDR tilingGm,
    int64_t argA, int64_t argB)    
{
    (void)workspace;
    GmgTiling t;
    t.M = (int32_t)((uint64_t)argA >> 40);
    t.K = (int32_t)((uint64_t)argA >> 26) & 0x3FFF;
    t.N = (int32_t)((uint64_t)argA) & 0x3FFFFFF;
    t.E = (int32_t)((uint64_t)argB >> 48);
    t.baseM = (int32_t)((uint64_t)argB >> 32) & 0xFFFF;
    t.baseN = (int32_t)((uint64_t)argB >> 16) & 0xFFFF;
    t.coreNum = 0;
    t.aivTotal = 0;
    t.rsv0 = (int32_t)((uint64_t)argB & 0xFFFF);
    
    
    
    const bool hpfxMix = ((t.rsv0 & 0x0080) != 0);
    const int32_t gsel = t.rsv0 & 0x000F;
    t.gchunk = (gsel >= 1 && gsel <= 4) ? gsel : 1;    
    t.rsv1 = 0; t.rsv2 = 0;    

    GlobalTensor<int8_t> xGm;
    GlobalTensor<int8_t> wGm;
    GlobalTensor<float> scaleGm;
    GlobalTensor<half> yGm;
    GlobalTensor<int32_t> cGm;
    xGm.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x), (int64_t)t.M * t.K);
    wGm.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(weight), (int64_t)t.E * t.K * t.N);
    scaleGm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scale), (int64_t)t.E * t.N);
    yGm.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y), (int64_t)t.M * t.N);

    using AType = MatmulType<TPosition::GM, CubeFormat::ND, int8_t>;
    using BType = MatmulType<TPosition::GM, CubeFormat::ND, int8_t>;
    using CType = MatmulType<TPosition::GM, CubeFormat::ND, int32_t>;

    const int64_t coreNum = GetBlockNum();
    const int32_t cStride = GmgCStrideG(t.N, t.baseN, t.gchunk);
    const int64_t slotStride = (int64_t)t.baseM * cStride;    


    if ASCEND_IS_AIC {
        cGm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(cWs),
                            coreNum * GMG_NUM_SLOTS * slotStride);
        TPipe pipe;
        
        
        GmgGroups g;
        if (!hpfxMix) {    
            
            
            
            
            
            
            const volatile __gm__ int64_t* glv =
                reinterpret_cast<__gm__ int64_t*>(groupList);
            int64_t prevEnd = 0;
            int64_t total = 0;
            g.nTiles = ((int64_t)t.N + (int64_t)t.gchunk * t.baseN - 1) / ((int64_t)t.gchunk * t.baseN);
            for (int32_t e = 0; e < t.E; ++e) {
                const int64_t end = glv[e];
                g.ends[e] = end;
                g.rowBase[e] = prevEnd;
                g.tileCum[e] = total;
                const int64_t rows = end - prevEnd;
                if (rows > 0) {
                    total += ((rows + t.baseM - 1) / t.baseM) * g.nTiles;
                }
                prevEnd = end;
            }
            g.tileCum[t.E] = total;
            g.total = total;
        }
        Matmul<AType, BType, CType, CType, GMG_MM_CFG> mm;
        REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), mm,
                          reinterpret_cast<__gm__ AscendC::tiling::TCubeTiling*>(tilingGm));
        
        
        
        if (cStride != t.N) { mm.SetOrgShape(t.M, t.N, t.K, t.K, cStride); }

        const int64_t aicIdx = GetBlockIdx();               
        const int64_t slotBase0 = aicIdx * GMG_NUM_SLOTS * slotStride;
        int64_t seq = 0;
        int32_t lastM = -1;                       
        int32_t lastN = -1;
        
        
        
        
        
        
        
        const int64_t nt = hpfxMix ? 0 : g.nTiles;
        const int64_t wEnd = hpfxMix ? 0 : g.total;
        const int64_t wStep = coreNum;
        
        
        
        
        const __gm__ int64_t* hpfxTb = reinterpret_cast<const __gm__ int64_t*>(
            tilingGm + ((sizeof(GmgTiling) + 511) / 512) * 512);
        const int64_t hpfxEnd = hpfxMix ? hpfxTb[aicIdx + 1] : 0;
        int64_t hpfxCur = hpfxMix ? hpfxTb[aicIdx] : 0;
        for (int64_t it = 0; ; ++it, ++seq) {
            GmgTileCoord c;
            bool lastTile;
            if (hpfxMix) {
                if (hpfxCur >= hpfxEnd) { break; }
                const __gm__ int64_t* en = hpfxTb + hpfxCur;
                const int64_t mr = en[0];            
                c.realM = (int32_t)((uint64_t)mr >> 32);
                c.realN = (int32_t)(mr & 0xFFFFFFFF);
                c.aOff = en[1];
                c.bOff = en[2];
                lastTile = (hpfxCur + 3 >= hpfxEnd);
                hpfxCur += 3;
            } else {
                const int64_t blk0 = aicIdx + it * wStep;
                if (blk0 >= wEnd) { break; }
                
                int32_t eR = 0;
                while (eR + 1 < t.E && blk0 >= g.tileCum[eR + 1]) { ++eR; }
                const int64_t eBeg = g.tileCum[eR];
                const int64_t eEnd = (eR + 1 < t.E) ? g.tileCum[eR + 1] : g.total;
                const int64_t mT = (eEnd - eBeg) / nt;
                const int64_t mTR = (blk0 - eBeg) / nt;
                const int64_t nTR = (blk0 - eBeg) % nt;
                const int64_t blk = eBeg + nTR * mT + mTR;
                GmgDecode<true>(t, g, blk, &c);
                lastTile = (blk0 + wStep >= wEnd);
            }
            if (seq >= GMG_NUM_SLOTS) {
                CrossCoreWaitFlag<0x2>(GMG_FLAG_V2C);       
            }
            
            
            
            int32_t shapeN;
            if (t.gchunk > 1) {
                shapeN = GmgPadWidth(c.realN);
                
                const int32_t gN = t.gchunk * t.baseN;
                if (shapeN > gN) { shapeN = gN; }
            } else {
                shapeN = GmgPadWidth(c.realN);
                if (shapeN > t.baseN) { shapeN = t.baseN; }
            }
            if (c.realM != lastM || shapeN != lastN) {    
                mm.SetSingleShape(c.realM, shapeN, t.K);
                lastM = c.realM;
                lastN = shapeN;
            }
            mm.SetTensorA(xGm[c.aOff]);
            mm.SetTensorB(wGm[c.bOff]);
            
            
            
            
            
            
            
            
            
            
            
            if (lastTile && t.gchunk > 1) {
                
                
                
                
                for (int32_t nb = 0; nb < t.gchunk; ++nb) {
                    const int64_t off = (int64_t)nb * t.baseN;
                    const int32_t wN = (c.realN - (int32_t)off < t.baseN)
                                       ? (c.realN - (int32_t)off) : t.baseN;
                    if (wN <= 0) { break; }
                    const int32_t shN = GmgPadWidth(wN);
                    mm.SetSingleShape(c.realM, shN, t.K);
                    mm.SetTensorA(xGm[c.aOff]);
                    mm.SetTensorB(wGm[c.bOff + off]);
                    while (mm.Iterate()) {
                        mm.GetTensorC(cGm[slotBase0 + (seq % GMG_NUM_SLOTS) * slotStride + off]);
                    }
                    if (nb == 0) {
                        CrossCoreSetFlag<0x2, PIPE_FIX>(GMG_FLAG_C2VH);   
                    }
                }
                lastM = -1; lastN = -1;    
            } else {
                
                
                
                
                while (mm.Iterate()) { mm.GetTensorC(cGm[slotBase0 + (seq % GMG_NUM_SLOTS) * slotStride]); }    
            }
            CrossCoreSetFlag<0x2, PIPE_FIX>(GMG_FLAG_C2V);  
        }
        mm.End();
        return;
    }

    if ASCEND_IS_AIV {
        cGm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(cWs),
                            coreNum * GMG_NUM_SLOTS * slotStride);
        TPipe pipe;
        
        
        const int64_t gid = GetBlockIdx();
        const int64_t aicIdx = gid / 2;
        const int64_t sub = gid % 2;
        const int64_t slotBase0 = aicIdx * GMG_NUM_SLOTS * slotStride;

        
        GmgGroups g;
        {
            
            
            
            
            
            
            TQue<QuePosition::VECIN, 1> glQue;
            pipe.InitBuffer(glQue, 1, (uint32_t)t.E * 8 + 64);
            LocalTensor<int64_t> gl = glQue.AllocTensor<int64_t>();
            DataCopyExtParams extG{1, (uint32_t)(t.E * 8), 0, 0, 0};
            DataCopyPadExtParams<int64_t> padG{true, 0, 0, 0};
            GlobalTensor<int64_t> glGm;
            glGm.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groupList), t.E);
            DataCopyPad(gl, glGm, extG, padG);
            glQue.EnQue(gl);
            gl = glQue.DeQue<int64_t>();
            int64_t prevEnd = 0;
            int64_t total = 0;
            g.nTiles = ((int64_t)t.N + (int64_t)t.gchunk * t.baseN - 1) / ((int64_t)t.gchunk * t.baseN);
            for (int32_t e = 0; e < t.E; ++e) {
                const int64_t end = gl.GetValue(e);
                g.ends[e] = end;
                g.rowBase[e] = prevEnd;
                g.tileCum[e] = total;
                const int64_t rows = end - prevEnd;
                if (rows > 0) {
                    total += ((rows + t.baseM - 1) / t.baseM) * g.nTiles;
                }
                prevEnd = end;
            }
            g.tileCum[t.E] = total;
            g.total = total;
            glQue.FreeTensor(gl);
        }

        
        
        
        
        
        
        
        
        
        
        const int32_t aN8w = GmgAlignUp(t.baseN < t.N ? t.baseN : t.N, 16);

        TQue<QuePosition::VECIN, 1> accQue;
        TQue<QuePosition::VECIN, 1> scQue;
        TQue<QuePosition::VECOUT, 1> outQue;
        TBuf<TPosition::VECCALC> zfBuf;
        TBuf<TPosition::VECCALC> tmpBuf;
        pipe.InitBuffer(accQue, 1, (uint32_t)aN8w * 4);
        pipe.InitBuffer(outQue, 1, (uint32_t)aN8w * 2);
        pipe.InitBuffer(scQue, 1, (uint32_t)aN8w * 4);
        pipe.InitBuffer(zfBuf, (uint32_t)aN8w * 4);
        pipe.InitBuffer(tmpBuf, (uint32_t)aN8w * 4);

        TQue<QuePosition::VECIN, 2> bAccQue;
        TQue<QuePosition::VECOUT, 1> bOutQue;
        TBuf<TPosition::VECCALC> bZfBuf;
        TBuf<TPosition::VECCALC> bTmpBuf;
        int32_t chRows = 0;
        
        
        
        
        
        
        
        
        const int32_t perRow = (aN8w >= 512) ? 18 : 14;
        if (aN8w >= 8 && aN8w <= 2040) {    
            const int32_t budget = GMG_UB_BUDGET - aN8w * 18 - t.E * 8 - 256;
            chRows = budget / (aN8w * perRow);
            if (chRows > GMG_BATCH_ROWS) { chRows = GMG_BATCH_ROWS; }
            if (chRows < 8) { chRows = 0; }
        }
        if (chRows > 0) {
            pipe.InitBuffer(bAccQue, 2, (uint32_t)chRows * aN8w * 4);    
            pipe.InitBuffer(bOutQue, 1, (uint32_t)chRows * aN8w * 2);
            pipe.InitBuffer(bZfBuf, (uint32_t)chRows * aN8w * 4);
            pipe.InitBuffer(bTmpBuf, (uint32_t)chRows * aN8w * 4);
        }
        
        
        
        const bool pfRoom =
            GmgPfGate(t, coreNum) &&
            ((GMG_UB_BUDGET - aN8w * 18 - t.E * 8 - 256) - (t.E * 8 + 64)
             - chRows * aN8w * perRow) >= GMG_PF_BYTES;
        
        int32_t pfD = 0;
        if (pfRoom) {
            const int32_t pfSel = (t.rsv0 >> 8) & 0xF;
            pfD = (pfSel == 0) ? 2 : ((pfSel == 0xF) ? 0 : pfSel);
        }
        
        TBuf<TPosition::VECCALC> pfBuf;
        LocalTensor<int8_t> pfUb;
        if (pfD > 0) {    
            pipe.InitBuffer(pfBuf, GMG_PF_BYTES);
            pfUb = pfBuf.Get<int8_t>();
        }

        GmgVecCtx vc;
        vc.accQue = &accQue;
        vc.scQue = &scQue;
        vc.outQue = &outQue;
        vc.zf = zfBuf.Get<float>();
        vc.tmp = tmpBuf.Get<float>();
        vc.aN8w = aN8w;
        vc.cStride = cStride;
        vc.bAccQue = &bAccQue;
        vc.bOutQue = &bOutQue;
        if (chRows > 0) {    
            vc.bZf = bZfBuf.Get<float>();    
            vc.bTmp = bTmpBuf.Get<float>();
        }
        vc.chRows = chRows;

        int64_t seq = 0;
        const int64_t nt = g.nTiles;
        const int64_t wBeg = aicIdx;           
        const int64_t wEnd = g.total;
        const int64_t wStep = coreNum;
        
        const int32_t nBlocks = (t.gchunk > 1) ? t.gchunk : 1;
        const int32_t nStepN = (t.gchunk > 1) ? t.baseN : 0;
        for (int64_t blk0 = wBeg; blk0 < wEnd; blk0 += wStep, ++seq) {
            
            int32_t eR = 0;
            while (eR + 1 < t.E && blk0 >= g.tileCum[eR + 1]) { ++eR; }
            const int64_t eBeg = g.tileCum[eR];
            const int64_t eEnd = (eR + 1 < t.E) ? g.tileCum[eR + 1] : g.total;
            const int64_t mT = (eEnd - eBeg) / nt;
            const int64_t mTR = (blk0 - eBeg) / nt;
            const int64_t nTR = (blk0 - eBeg) % nt;
            const int64_t blk = eBeg + nTR * mT + mTR;
            GmgTileCoord c;
            GmgDecode<true>(t, g, blk, &c);
            
            if (pfD > 0 && (blk0 + (int64_t)pfD * wStep) < wEnd) {
                const int64_t blk0p = blk0 + (int64_t)pfD * wStep;
                int32_t eRp = 0;
                while (eRp + 1 < t.E && blk0p >= g.tileCum[eRp + 1]) { ++eRp; }
                const int64_t eBegp = g.tileCum[eRp];
                const int64_t eEndp = (eRp + 1 < t.E) ? g.tileCum[eRp + 1] : g.total;
                const int64_t mTp = (eEndp - eBegp) / nt;
                const int64_t mTRp = (blk0p - eBegp) / nt;
                const int64_t nTRp = (blk0p - eBegp) % nt;
                GmgTileCoord cp;
                GmgDecode<true>(t, g, eBegp + nTRp * mTp + mTRp, &cp);
                GmgPrefetchB(wGm, t, cp, sub, pfUb);
            }
            
            
            
            const bool lastTile = (blk0 + wStep >= wEnd);
            const bool splitLast = lastTile && nBlocks > 1;
            if (splitLast) { CrossCoreWaitFlag<0x2>(GMG_FLAG_C2VH); }    
            else { CrossCoreWaitFlag<0x2>(GMG_FLAG_C2V); }               
            const int32_t half = (c.realM + 1) / 2;
            const int32_t rBeg = (sub == 0) ? 0 : half;     
            const int32_t rEnd = (sub == 0) ? half : c.realM;
            
            const int64_t tSlot = slotBase0 + (seq % GMG_NUM_SLOTS) * slotStride;
            for (int32_t nb = 0; nb < nBlocks; ++nb) {
                if (splitLast && nb == 1) { CrossCoreWaitFlag<0x2>(GMG_FLAG_C2V); }
                GmgTileCoord cs;
                GmgSliceN(t, c, nb, &cs);
                if (cs.realN <= 0) { break; }
                GmgEpilogue(vc, t, cGm, scaleGm, yGm, tSlot + (int64_t)nb * nStepN, cs, rBeg, rEnd);
            }
            CrossCoreSetFlag<0x2, PIPE_MTE2>(GMG_FLAG_V2C);  
        }
        return;
    }
}







__global__ __aicore__ __mix__(1, 2) void gmg_small_kernel(
    GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groupList, GM_ADDR y,
    GM_ADDR workspace, GM_ADDR cWs, GM_ADDR tilingGm,
    int64_t argA, int64_t argB)    
{
    (void)workspace;
    GmgTiling t;
    t.M = (int32_t)((uint64_t)argA >> 40);
    t.K = (int32_t)((uint64_t)argA >> 26) & 0x3FFF;
    t.N = (int32_t)((uint64_t)argA) & 0x3FFFFFF;
    t.E = (int32_t)((uint64_t)argB >> 48);
    t.baseM = (int32_t)((uint64_t)argB >> 32) & 0xFFFF;
    t.baseN = (int32_t)((uint64_t)argB >> 16) & 0xFFFF;
    t.coreNum = 0; t.aivTotal = 0;
    t.rsv0 = (int32_t)((uint64_t)argB & 0xFFFF);
    t.gchunk = 1;                        
    t.rsv1 = 0; t.rsv2 = 0;

    GlobalTensor<int8_t> xGm;
    GlobalTensor<int8_t> wGm;
    GlobalTensor<float> scaleGm;
    GlobalTensor<half> yGm;
    GlobalTensor<int32_t> cGm;
    xGm.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x), (int64_t)t.M * t.K);
    wGm.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(weight), (int64_t)t.E * t.K * t.N);
    scaleGm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scale), (int64_t)t.E * t.N);
    yGm.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y), (int64_t)t.M * t.N);

    using AType = MatmulType<TPosition::GM, CubeFormat::ND, int8_t>;
    using BType = MatmulType<TPosition::GM, CubeFormat::ND, int8_t>;
    using CType = MatmulType<TPosition::GM, CubeFormat::ND, int32_t>;

    const int64_t coreNum = GetBlockNum();
    const int32_t cStride = GmgCStride(t.N, t.baseN);
    const int64_t slotStride = (int64_t)t.baseM * cStride;

    if ASCEND_IS_AIC {
        cGm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(cWs),
                            coreNum * GMG_NUM_SLOTS * slotStride);    
        TPipe pipe;
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        Matmul<AType, BType, CType, CType, GMG_MM_CFG> mm;
        REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), mm,
                          reinterpret_cast<__gm__ AscendC::tiling::TCubeTiling*>(tilingGm));
        
        
        
        if (cStride != t.N) { mm.SetOrgShape(t.M, t.N, t.K, t.K, cStride); }
        const int64_t aicIdx = GetBlockIdx();
        
        const int64_t slotBase0 = aicIdx * GMG_NUM_SLOTS * slotStride;
        const __gm__ int64_t* hpfxTb = reinterpret_cast<const __gm__ int64_t*>(
            tilingGm + ((sizeof(GmgTiling) + 511) / 512) * 512);    
        const int64_t hpfxBeg = hpfxTb[aicIdx];
        const int64_t hpfxEnd = hpfxTb[aicIdx + 1];
        int32_t lastM = -1;                       
        int32_t lastN = -1;                       
        int64_t seq = 0;
        for (int64_t j = hpfxBeg; j < hpfxEnd; j += 5, ++seq) {    
            const __gm__ int64_t* en = hpfxTb + j;
            GmgTileCoord c;
            const int64_t mr = en[0];             
            c.realM = (int32_t)((uint64_t)mr >> 32);
            c.realN = (int32_t)mr;
            c.aOff = en[1];
            c.bOff = en[2];
            if (seq >= GMG_NUM_SLOTS) {
                CrossCoreWaitFlag<0x2>(GMG_FLAG_V2C);    
            }
            int32_t shapeN = GmgPadWidth(c.realN);
            if (shapeN > t.baseN) { shapeN = t.baseN; }
            if (c.realM != lastM || shapeN != lastN) {    
                mm.SetSingleShape(c.realM, shapeN, t.K);
                lastM = c.realM;
                lastN = shapeN;
            }
            mm.SetTensorA(xGm[c.aOff]);
            mm.SetTensorB(wGm[c.bOff]);
            while (mm.Iterate()) { mm.GetTensorC(cGm[slotBase0 + (seq % GMG_NUM_SLOTS) * slotStride]); }    
            CrossCoreSetFlag<0x2, PIPE_FIX>(GMG_FLAG_C2V);
        }
        mm.End();
        return;
    }

    if ASCEND_IS_AIV {
        cGm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(cWs),
                            coreNum * GMG_NUM_SLOTS * slotStride);    
        TPipe pipe;
        const int64_t gid = GetBlockIdx();
        const int64_t aicIdx = gid / 2;
        const int64_t sub = gid % 2;
        const int64_t slotBase0 = aicIdx * GMG_NUM_SLOTS * slotStride;    

        
        
        const __gm__ int64_t* hpfxTbA = reinterpret_cast<const __gm__ int64_t*>(
            tilingGm + ((sizeof(GmgTiling) + 511) / 512) * 512);
        const int64_t hBegA = hpfxTbA[aicIdx];
        const int64_t hEndA = hpfxTbA[aicIdx + 1];

        
        
        
        
        
        
        
        
        const int32_t aN8w = GmgAlignUp(t.baseN < t.N ? t.baseN : t.N, 16);
        TQue<QuePosition::VECIN, 1> accQue;
        TQue<QuePosition::VECIN, 1> scQue;
        TQue<QuePosition::VECOUT, 1> outQue;
        TBuf<TPosition::VECCALC> zfBuf;
        TBuf<TPosition::VECCALC> tmpBuf;
        pipe.InitBuffer(accQue, 1, (uint32_t)aN8w * 4);
        pipe.InitBuffer(outQue, 1, (uint32_t)aN8w * 2);
        pipe.InitBuffer(scQue, 1, (uint32_t)aN8w * 4);
        pipe.InitBuffer(zfBuf, (uint32_t)aN8w * 4);
        pipe.InitBuffer(tmpBuf, (uint32_t)aN8w * 4);

        
        TQue<QuePosition::VECIN, 2> bAccQue;
        TQue<QuePosition::VECOUT, 1> bOutQue;
        TBuf<TPosition::VECCALC> bZfBuf;
        TBuf<TPosition::VECCALC> bTmpBuf;
        int32_t chRows = 0;
        
        
        
        
        
        
        
        
        const int32_t perRow = (aN8w >= 512) ? 18 : 14;
        if (aN8w >= 8 && aN8w <= 2040) {    
            const int32_t budget = GMG_UB_BUDGET - aN8w * 18 - t.E * 8 - 256;
            chRows = budget / (aN8w * perRow);
            if (chRows > GMG_BATCH_ROWS) { chRows = GMG_BATCH_ROWS; }
            if (chRows < 8) { chRows = 0; }
        }
        if (chRows > 0) {
            pipe.InitBuffer(bAccQue, 2, (uint32_t)chRows * aN8w * 4);    
            pipe.InitBuffer(bOutQue, 1, (uint32_t)chRows * aN8w * 2);
            pipe.InitBuffer(bZfBuf, (uint32_t)chRows * aN8w * 4);
            pipe.InitBuffer(bTmpBuf, (uint32_t)chRows * aN8w * 4);
        }

        GmgVecCtx vc;
        vc.accQue = &accQue;
        vc.scQue = &scQue;
        vc.outQue = &outQue;
        vc.zf = zfBuf.Get<float>();
        vc.tmp = tmpBuf.Get<float>();
        vc.aN8w = aN8w;
        vc.cStride = cStride;
        vc.bAccQue = &bAccQue;
        vc.bOutQue = &bOutQue;
        if (chRows > 0) {    
            vc.bZf = bZfBuf.Get<float>();    
            vc.bTmp = bTmpBuf.Get<float>();
        }
        vc.chRows = chRows;

        int64_t seq = 0;                                                   
        for (int64_t j = hBegA; j < hEndA; j += 5, ++seq) {                
            const __gm__ int64_t* en = hpfxTbA + j;
            const int64_t mr = en[0];
            GmgTileCoord c;
            c.realM = (int32_t)((uint64_t)mr >> 32);
            c.realN = (int32_t)mr;
            c.aOff = en[1];
            c.bOff = en[2];
            c.sOff = en[3];
            c.yOff = en[4];
            CrossCoreWaitFlag<0x2>(GMG_FLAG_C2V);
            const int32_t half = (c.realM + 1) / 2;
            const int32_t rBeg = (sub == 0) ? 0 : half;
            const int32_t rEnd = (sub == 0) ? half : c.realM;
            GmgEpilogue(vc, t, cGm, scaleGm, yGm,
                        slotBase0 + (seq % GMG_NUM_SLOTS) * slotStride, c, rBeg, rEnd);
            CrossCoreSetFlag<0x2, PIPE_MTE2>(GMG_FLAG_V2C);
        }
        return;
    }
}









__global__ __aicore__ __mix__(1, 2) void gmg_micro_kernel(
    GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groupList, GM_ADDR y,
    GM_ADDR workspace, GM_ADDR cWs, GM_ADDR tilingGm,
    int64_t argA, int64_t argB)
{
    (void)workspace; (void)cWs; (void)tilingGm;
    if ASCEND_IS_AIC { return; }                

    if ASCEND_IS_AIV {
        if (GetBlockIdx() != 0) { return; }     

        GmgTiling t;
        t.M = (int32_t)((uint64_t)argA >> 40);
        t.K = (int32_t)((uint64_t)argA >> 26) & 0x3FFF;
        t.N = (int32_t)((uint64_t)argA) & 0x3FFFFFF;
        t.E = (int32_t)((uint64_t)argB >> 48);

        GlobalTensor<int8_t> xGm;
        GlobalTensor<int8_t> wGm;
        GlobalTensor<float> scaleGm;
        GlobalTensor<half> yGm;
        xGm.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x), (int64_t)t.M * t.K);
        wGm.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(weight), (int64_t)t.E * t.K * t.N);
        scaleGm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scale), (int64_t)t.E * t.N);
        yGm.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y), (int64_t)t.M * t.N);

        TPipe pipe;
        
        TQue<QuePosition::VECIN, 1> glQue;
        TQue<QuePosition::VECIN, 1> xQue;
        TQue<QuePosition::VECIN, 1> wQue;
        TQue<QuePosition::VECIN, 1> sQue;
        TQue<QuePosition::VECOUT, 1> outQue;
        TBuf<TPosition::VECCALC> accBuf;
        TBuf<TPosition::VECCALC> scBuf;
        TBuf<TPosition::VECCALC> zfBuf;
        TBuf<TPosition::VECCALC> tmpBuf;
        pipe.InitBuffer(glQue, 1, (uint32_t)t.E * 8 + 64);
        pipe.InitBuffer(xQue, 1, (uint32_t)(t.M * t.K + 31) / 32 * 32);
        pipe.InitBuffer(wQue, 1, (uint32_t)(((int64_t)t.E * t.K * t.N + 31) / 32 * 32));
        pipe.InitBuffer(sQue, 1, (uint32_t)(((int64_t)t.E * t.N * 4 + 31) / 32 * 32));
        const int32_t cnt = t.M * t.N;
        pipe.InitBuffer(outQue, 1, (uint32_t)(cnt * 2));
        pipe.InitBuffer(accBuf, (uint32_t)(cnt * 4));
        pipe.InitBuffer(scBuf, (uint32_t)(cnt * 4));
        pipe.InitBuffer(zfBuf, (uint32_t)(cnt * 4));
        pipe.InitBuffer(tmpBuf, (uint32_t)(cnt * 4));

        LocalTensor<int64_t> gl = glQue.AllocTensor<int64_t>();
        {
            GlobalTensor<int64_t> glGm;
            glGm.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groupList), t.E);
            DataCopyExtParams extG{1, (uint16_t)(t.E * 8), 0, 0, 0};
            DataCopyPadExtParams<int64_t> padG{true, 0, 0, 0};
            DataCopyPad(gl, glGm, extG, padG);
        }
        glQue.EnQue(gl);
        gl = glQue.DeQue<int64_t>();

        LocalTensor<int8_t> xT = xQue.AllocTensor<int8_t>();
        LocalTensor<int8_t> wT = wQue.AllocTensor<int8_t>();
        LocalTensor<float> sT = sQue.AllocTensor<float>();
        {
            DataCopyExtParams extX{1, (uint16_t)(t.M * t.K), 0, 0, 0};
            DataCopyPadExtParams<int8_t> padX{false, 0, 0, 0};
            DataCopyPad(xT, xGm, extX, padX);
            DataCopyExtParams extW{1, (uint16_t)((int64_t)t.E * t.K * t.N), 0, 0, 0};
            DataCopyPadExtParams<int8_t> padW{false, 0, 0, 0};
            DataCopyPad(wT, wGm, extW, padW);
            DataCopyExtParams extS{1, (uint16_t)((int64_t)t.E * t.N * 4), 0, 0, 0};
            DataCopyPadExtParams<float> padS{false, 0, 0, 0};
            DataCopyPad(sT, scaleGm, extS, padS);
        }
        xQue.EnQue(xT); wQue.EnQue(wT); sQue.EnQue(sT);
        xT = xQue.DeQue<int8_t>();
        wT = wQue.DeQue<int8_t>();
        sT = sQue.DeQue<float>();

        
        LocalTensor<int32_t> accT = accBuf.Get<int32_t>();
        LocalTensor<float> scT = scBuf.Get<float>();
        {
            int64_t prevEnd = 0;
            for (int32_t e = 0; e < t.E; ++e) {
                const int64_t end = gl.GetValue(e);
                const int64_t rowBase = prevEnd;
                prevEnd = end;
                for (int64_t m = rowBase; m < end; ++m) {
                    const int64_t xRow = m * t.K;
                    for (int32_t n = 0; n < t.N; ++n) {
                        int32_t s = 0;
                        for (int32_t k = 0; k < t.K; ++k) {
                            s += (int32_t)xT.GetValue(xRow + k) *
                                 (int32_t)wT.GetValue(((int64_t)e * t.K + k) * t.N + n);
                        }
                        accT.SetValue(m * t.N + n, s);
                        scT.SetValue(m * t.N + n, sT.GetValue((int64_t)e * t.N + n));
                    }
                }
            }
        }
        glQue.FreeTensor(gl);

        
        {
            event_t svEvt = static_cast<event_t>(GetTPipePtr()->FetchEventID(HardEvent::S_V));
            SetFlag<HardEvent::S_V>(svEvt);
            WaitFlag<HardEvent::S_V>(svEvt);
        }

        
        LocalTensor<float> zf = zfBuf.Get<float>();
        LocalTensor<float> tmp = tmpBuf.Get<float>();
        Cast<float>(zf, accT, RoundMode::CAST_RINT, cnt);       
        PipeBarrier<PIPE_V>();
        Mul(zf, zf, scT, cnt);
        PipeBarrier<PIPE_V>();
        Mul(tmp, zf, zf, cnt);                                   
        PipeBarrier<PIPE_V>();
        Mul(tmp, zf, tmp, cnt);                                  
        PipeBarrier<PIPE_V>();
        Muls(tmp, tmp, GMG_GELU_BETA, cnt);
        PipeBarrier<PIPE_V>();
        Add(tmp, zf, tmp, cnt);                                  
        PipeBarrier<PIPE_V>();
        Muls(tmp, tmp, GMG_GELU_ALPHA, cnt);
        PipeBarrier<PIPE_V>();
        Exp(tmp, tmp, cnt);
        PipeBarrier<PIPE_V>();
        Adds(tmp, tmp, 1.0f, cnt);
        PipeBarrier<PIPE_V>();
        Div(zf, zf, tmp, cnt);                                   
        PipeBarrier<PIPE_V>();

        LocalTensor<half> out = outQue.AllocTensor<half>();
        Cast<half>(out, zf, RoundMode::CAST_RINT, cnt);          
        outQue.EnQue(out);
        out = outQue.DeQue<half>();
        DataCopyExtParams extY{1, (uint16_t)(cnt * 2), 0, 0, 0};
        DataCopyPad(yGm[0], out, extY);
        outQue.FreeTensor(out);
        xQue.FreeTensor(xT); wQue.FreeTensor(wT); sQue.FreeTensor(sT);
        return;
    }
}















constexpr int32_t GMG_SMK_UB = 165888;

__global__ __aicore__ void gmg_smk_kernel(
    GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groupList, GM_ADDR y,
    GM_ADDR workspace, GM_ADDR cWs, GM_ADDR tilingGm,
    int64_t argA, int64_t argB)
{
    (void)workspace; (void)cWs; (void)tilingGm;

    if ASCEND_IS_AIV {
        const int32_t M = (int32_t)((uint64_t)argA >> 40);
        const int32_t K = (int32_t)((uint64_t)argA >> 26) & 0x3FFF;
        const int32_t N = (int32_t)((uint32_t)argA & 0x3FFFFFFu);
        const int32_t E = (int32_t)((uint64_t)argB >> 48);
        if (M < 1 || K < 1 || K > 16 || N < 1 || N > 128 || E < 1 || E > 128) { return; }

        const int32_t bd = (int32_t)GetBlockNum();
        const int32_t bi = (int32_t)GetBlockIdx();
        if (bd < 1 || bi >= bd) { return; }
        const int64_t rowLo = (int64_t)M * bi / bd;
        const int64_t rowHi = (int64_t)M * (bi + 1) / bd;
        if (rowHi <= rowLo) { return; }

        const int32_t R = (int32_t)(rowHi - rowLo);
        const int32_t Np = ((N + 31) / 32) * 32;
        const int32_t KN = K * Np;
        const int32_t XN = ((R * K + 63) / 64) * 64;
        const int32_t CN = R * Np;

        __gm__ int8_t* xp = reinterpret_cast<__gm__ int8_t*>(x);
        __gm__ int8_t* wp = reinterpret_cast<__gm__ int8_t*>(weight);
        __gm__ float* sp = reinterpret_cast<__gm__ float*>(scale);
        GlobalTensor<half> yGm;
        yGm.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y), (int64_t)M * N);

        TPipe pipe;
        TBuf<TPosition::VECCALC> wIB, whB, wFB, xbB, xhB, xfB, acB, tpB, obB, scB, glB;
        pipe.InitBuffer(wIB, (uint32_t)KN);
        pipe.InitBuffer(whB, (uint32_t)(KN * 2));
        pipe.InitBuffer(wFB, (uint32_t)(KN * 4));
        pipe.InitBuffer(xbB, (uint32_t)XN);
        pipe.InitBuffer(xhB, (uint32_t)(XN * 2));
        pipe.InitBuffer(xfB, (uint32_t)(XN * 4));
        pipe.InitBuffer(acB, (uint32_t)(CN * 4 + 256));
        pipe.InitBuffer(tpB, (uint32_t)(CN * 4 + 256));
        pipe.InitBuffer(obB, (uint32_t)(CN * 2 + 256));
        pipe.InitBuffer(scB, (uint32_t)(N * 4 + 256));
        pipe.InitBuffer(glB, 1024u);
        auto wI = wIB.Get<int8_t>();
        auto wh = whB.Get<half>();
        auto wF = wFB.Get<float>();
        auto xb = xbB.Get<int8_t>();
        auto xh = xhB.Get<half>();
        auto xf = xfB.Get<float>();
        auto ac = acB.Get<float>();
        auto tp = tpB.Get<float>();
        auto ob = obB.Get<half>();
        auto sc = scB.Get<float>();
        auto gl8 = glB.Get<int8_t>();

        event_t mvEvt = static_cast<event_t>(GetTPipePtr()->FetchEventID(HardEvent::MTE2_V));
        event_t msEvt = static_cast<event_t>(GetTPipePtr()->FetchEventID(HardEvent::MTE2_S));
        event_t vsEvt = static_cast<event_t>(GetTPipePtr()->FetchEventID(HardEvent::V_S));
        event_t vm2Evt = static_cast<event_t>(GetTPipePtr()->FetchEventID(HardEvent::V_MTE2));
        event_t v3Evt = static_cast<event_t>(GetTPipePtr()->FetchEventID(HardEvent::V_MTE3));
        event_t m3vEvt = static_cast<event_t>(GetTPipePtr()->FetchEventID(HardEvent::MTE3_V));

        {
            GlobalTensor<int8_t> gGm;
            gGm.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(groupList), (int64_t)E * 8);
            DataCopyExtParams exG{1, (uint32_t)(E * 8), 0, 0, 0};
            DataCopyPadExtParams<int8_t> pdG{false, 0, 0, 0};
            DataCopyPad(gl8, gGm, exG, pdG);
            SetFlag<HardEvent::MTE2_S>(msEvt);
            WaitFlag<HardEvent::MTE2_S>(msEvt);
        }
        auto gl64 = gl8.ReinterpretCast<int64_t>();

        const BinaryRepeatParams bpS(1, 1, 1, (uint8_t)(Np / 8), (uint8_t)(Np / 8), 0);
        int64_t prev = 0;
        for (int32_t e = 0; e < E; ++e) {
            const int64_t eEnd = gl64.GetValue(e);
            const int64_t lo = (rowLo > prev) ? rowLo : prev;
            const int64_t hi = (rowHi < eEnd) ? rowHi : eEnd;
            prev = eEnd;
            if (hi <= lo) { continue; }

            const int32_t Gc = (int32_t)(hi - lo);
            const int32_t gOff = (int32_t)(lo - rowLo);

            SetFlag<HardEvent::V_MTE2>(vm2Evt);
            WaitFlag<HardEvent::V_MTE2>(vm2Evt);
            {
                GlobalTensor<int8_t> wGm;
                wGm.SetGlobalBuffer(wp + (int64_t)e * K * N, (int64_t)K * N);
                DataCopyExtParams exW{(uint16_t)K, (uint32_t)N, 0, 0, 0};
                DataCopyPadExtParams<int8_t> pdW{true, 0, (uint8_t)(Np - N), 0};
                DataCopyPad(wI, wGm, exW, pdW);

                GlobalTensor<float> sGm;
                sGm.SetGlobalBuffer(sp + (int64_t)e * N, (int64_t)N);
                DataCopyExtParams exS{1, (uint32_t)(N * 4), 0, 0, 0};
                DataCopyPadExtParams<float> pdS{false, 0, 0, 0.0f};
                DataCopyPad(sc, sGm, exS, pdS);

                GlobalTensor<int8_t> xGm;
                xGm.SetGlobalBuffer(xp + lo * K, (int64_t)Gc * K);
                DataCopyExtParams exX{1, (uint32_t)(Gc * K), 0, 0, 0};
                DataCopyPadExtParams<int8_t> pdX{false, 0, 0, 0};
                DataCopyPad(xb, xGm, exX, pdX);
            }
            SetFlag<HardEvent::MTE2_V>(mvEvt);
            WaitFlag<HardEvent::MTE2_V>(mvEvt);

            Cast<half>(wh, wI, RoundMode::CAST_NONE, K * Np);
            Cast<float>(wF, wh, RoundMode::CAST_NONE, K * Np);
            SetFlag<HardEvent::MTE2_S>(msEvt);
            WaitFlag<HardEvent::MTE2_S>(msEvt);
            SetFlag<HardEvent::V_S>(vsEvt);
            WaitFlag<HardEvent::V_S>(vsEvt);

            Duplicate(ac[gOff * Np], 0.0f, Gc * Np);

            for (int32_t g = 0; g < Gc; ++g) {
                const int32_t gi = gOff + g;
                for (int32_t kk = 0; kk < K; ++kk) {
                    const float xv = (float)xb.GetValue(g * K + kk);
                    Axpy(ac[gi * Np], wF[kk * Np], xv, (uint64_t)N);
                }
            }

            const int32_t gc = Gc * Np;
            for (int32_t c0 = 0; c0 < N; c0 += 64) {
                const uint64_t w = (uint64_t)((N - c0 < 64) ? (N - c0) : 64);
                Mul(ac[gOff * Np + c0], ac[gOff * Np + c0], sc[c0], w, (uint8_t)Gc, bpS);
            }

            Mul(tp[gOff * Np], ac[gOff * Np], ac[gOff * Np], gc);
            Mul(tp[gOff * Np], ac[gOff * Np], tp[gOff * Np], gc);
            Muls(tp[gOff * Np], tp[gOff * Np], GMG_GELU_BETA, gc);
            Add(tp[gOff * Np], ac[gOff * Np], tp[gOff * Np], gc);
            Muls(tp[gOff * Np], tp[gOff * Np], GMG_GELU_ALPHA, gc);
            Exp(tp[gOff * Np], tp[gOff * Np], gc);
            Adds(tp[gOff * Np], tp[gOff * Np], 1.0f, gc);
            Div(ac[gOff * Np], ac[gOff * Np], tp[gOff * Np], gc);

            Cast<half>(ob[gOff * Np], ac[gOff * Np], RoundMode::CAST_RINT, Gc * Np);
            SetFlag<HardEvent::V_MTE3>(v3Evt);
            WaitFlag<HardEvent::V_MTE3>(v3Evt);
            for (int32_t g = 0; g < Gc; ++g) {
                DataCopyExtParams exY{1, (uint32_t)(N * 2), 0, 0, 0};
                DataCopyPad(yGm[(lo + g) * N], ob[(gOff + g) * Np], exY);
            }
            SetFlag<HardEvent::MTE3_V>(m3vEvt);
            WaitFlag<HardEvent::MTE3_V>(m3vEvt);
        }
        return;
    }
}


__global__ __aicore__ void gmg_microv2_kernel(
    GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groupList, GM_ADDR y,
    GM_ADDR workspace, GM_ADDR cWs, GM_ADDR tilingGm,
    int64_t argA, int64_t argB)    
{
    (void)workspace; (void)cWs; (void)tilingGm;

    if ASCEND_IS_AIV {
        const int32_t M = (int32_t)((uint64_t)argA >> 40);
        const int32_t K = (int32_t)((uint64_t)argA >> 26) & 0x3FFF;
        const int32_t N = (int32_t)((uint64_t)argA) & 0x3FFFFFF;
        const int32_t E = (int32_t)((uint64_t)argB >> 48);
        if (M < 1 || K < 1 || N < 1 || E < 1) { return; }

        const int32_t cnt2 = M * N;

        GlobalTensor<half> yGm;
        yGm.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y), (int64_t)M * N);

        const bool single = (cnt2 <= 64);
        const int32_t bd0 = (int32_t)GetBlockNum();
        const int32_t bi0 = (int32_t)GetBlockIdx();
        if (bd0 < 1) { return; }
        if (single && bi0 != 0) { return; }

        const int32_t bd = single ? 1 : bd0;
        const int32_t bi = single ? 0 : bi0;
        const int64_t rowLo = (int64_t)M * bi / bd;
        const int64_t rowHi = (int64_t)M * (bi + 1) / bd;
        if (rowHi <= rowLo) { return; }

        const int32_t rRows = (int32_t)(rowHi - rowLo);
        const int32_t rElems = rRows * N;

        set_atomic_none();
        const int32_t castCnt2 = (rElems + 63) / 64 * 64;
        const int32_t offB = ((rElems * 4 + 31) / 32) * 32;
        const int32_t zfLen = (offB + castCnt2 * 4 + 31) / 32 * 32;

        LocalMemAllocator<AscendC::Hardware::UB> ubAlloc;
        LocalTensor<float> zf2 = ubAlloc.Alloc<float>((uint32_t)(zfLen / 4));
        LocalTensor<float> tmp2 = ubAlloc.Alloc<float>((uint32_t)rElems);
        auto out2 = zf2[offB / 4].ReinterpretCast<half>();
        {
            auto glp = reinterpret_cast<__gm__ int64_t*>(groupList);
            auto xp = reinterpret_cast<__gm__ int8_t*>(x);
            auto wp = reinterpret_cast<__gm__ int8_t*>(weight);
            auto sp = reinterpret_cast<__gm__ float*>(scale);
            const int32_t nDim = N;
            const int32_t kDim = K;
            int64_t prevEnd = 0;
            if (kDim == 3 && nDim == 5) {
                for (int32_t e = 0; e < E; ++e) {
                    const int64_t end = glp[e];
                    const int64_t lo = (rowLo > prevEnd) ? rowLo : prevEnd;
                    const int64_t hi = (rowHi < end) ? rowHi : end;
                    prevEnd = end;
                    if (hi <= lo) { continue; }
                    const __gm__ int8_t* we = wp + (int64_t)e * 15;
                    const __gm__ float* se = sp + (int64_t)e * 5;
                    const float s0 = se[0], s1 = se[1], s2 = se[2], s3 = se[3], s4 = se[4];
                    for (int64_t m = lo; m < hi; ++m) {
                        const __gm__ int8_t* xr = xp + m * 3;
                        const int32_t x0 = (int32_t)xr[0], x1 = (int32_t)xr[1], x2 = (int32_t)xr[2];
                        const int32_t w00 = (int32_t)we[0],  w01 = (int32_t)we[1],
                                      w02 = (int32_t)we[2],  w03 = (int32_t)we[3],
                                      w04 = (int32_t)we[4];
                        const int32_t w10 = (int32_t)we[5],  w11 = (int32_t)we[6],
                                      w12 = (int32_t)we[7],  w13 = (int32_t)we[8],
                                      w14 = (int32_t)we[9];
                        const int32_t w20 = (int32_t)we[10], w21 = (int32_t)we[11],
                                      w22 = (int32_t)we[12], w23 = (int32_t)we[13],
                                      w24 = (int32_t)we[14];
                        const int32_t off = (int32_t)((m - rowLo) * 5);
                        zf2.SetValue(off + 0, (float)(x0*w00 + x1*w10 + x2*w20) * s0);
                        zf2.SetValue(off + 1, (float)(x0*w01 + x1*w11 + x2*w21) * s1);
                        zf2.SetValue(off + 2, (float)(x0*w02 + x1*w12 + x2*w22) * s2);
                        zf2.SetValue(off + 3, (float)(x0*w03 + x1*w13 + x2*w23) * s3);
                        zf2.SetValue(off + 4, (float)(x0*w04 + x1*w14 + x2*w24) * s4);
                    }
                }
            } else {
                for (int32_t e = 0; e < E; ++e) {
                    const int64_t end = glp[e];
                    const int64_t lo = (rowLo > prevEnd) ? rowLo : prevEnd;
                    const int64_t hi = (rowHi < end) ? rowHi : end;
                    prevEnd = end;
                    if (hi <= lo) { continue; }
                    const __gm__ int8_t* we = wp + (int64_t)e * kDim * nDim;
                    const __gm__ float* se = sp + (int64_t)e * nDim;
                    for (int64_t m = lo; m < hi; ++m) {
                        const __gm__ int8_t* xr = xp + m * kDim;
                        int32_t off = (int32_t)((m - rowLo) * nDim);
                        for (int32_t n = 0; n < nDim; ++n, ++off) {
                            const __gm__ int8_t* wk = we + n;
                            int32_t sv = 0;
                            for (int32_t k = 0; k < kDim; ++k, wk += nDim) {
                                sv += (int32_t)xr[k] * (int32_t)*wk;
                            }
                            zf2.SetValue(off, (float)sv * se[n]);
                        }
                    }
                }
            }
        }

        {
            event_t svEvt = static_cast<event_t>(0);
            SetFlag<HardEvent::S_V>(svEvt);
            WaitFlag<HardEvent::S_V>(svEvt);
        }

        Mul(tmp2, zf2, zf2, rElems);
        Mul(tmp2, zf2, tmp2, rElems);
        Muls(tmp2, tmp2, GMG_GELU_BETA, rElems);
        Add(tmp2, zf2, tmp2, rElems);
        Muls(tmp2, tmp2, GMG_GELU_ALPHA, rElems);
        Exp(tmp2, tmp2, rElems);
        Adds(tmp2, tmp2, 1.0f, rElems);
        Div(zf2, zf2, tmp2, rElems);

        Cast<half>(out2, zf2, RoundMode::CAST_RINT, castCnt2);
        {
            event_t vmEvt = static_cast<event_t>(1);
            SetFlag<HardEvent::V_MTE3>(vmEvt);
            WaitFlag<HardEvent::V_MTE3>(vmEvt);
        }
        DataCopyExtParams extY2{1, (uint16_t)(rElems * 2), 0, 0, 0};
        DataCopyPad(yGm[(int64_t)rowLo * N], out2, extY2);
        return;
    }
}





















constexpr int32_t GMG_SB_UB = 150000;


__global__ __aicore__ void gmg_superband_kernel(
    GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groupList, GM_ADDR y,
    GM_ADDR workspace, GM_ADDR cWs, GM_ADDR tilingGm,
    int64_t argA, int64_t argB)
{
    (void)workspace; (void)cWs; (void)tilingGm;

    if ASCEND_IS_AIV {
        const int32_t M = (int32_t)((uint64_t)argA >> 40);
        const int32_t K = (int32_t)((uint64_t)argA >> 26) & 0x3FFF;
        const int32_t N = (int32_t)((uint32_t)argA & 0x3FFFFFFu);
        const int32_t E = (int32_t)((uint64_t)argB >> 48);
        if (M < 1 || K < 1 || K > 128 || N < 1 || N > 64 || E < 1 || E > 128) { return; }

        const int32_t bd = (int32_t)GetBlockNum();
        const int32_t bi = (int32_t)GetBlockIdx();
        if (bd < 1) { return; }
        const int64_t rowLo = (int64_t)M * bi / bd;
        const int64_t rowHi = (int64_t)M * (bi + 1) / bd;
        if (rowHi <= rowLo) { return; }

        const int32_t Pf = ((N + 15) / 16) * 16;
        const int32_t Np = ((N + 31) / 32) * 32;

        int32_t Gc = (GMG_SB_UB - K * Np * 7 - Pf * 4 - 8192) / (7 * K + 10 * Pf);
        if (Gc > 248) { Gc = 248; }
        Gc = (Gc / 8) * 8;
        if (Gc < 8) { return; }
        const int32_t G8 = ((Gc + 7) / 8) * 8;

        __gm__ int8_t* xp = reinterpret_cast<__gm__ int8_t*>(x);
        __gm__ int8_t* wp = reinterpret_cast<__gm__ int8_t*>(weight);
        __gm__ float* sp = reinterpret_cast<__gm__ float*>(scale);
        GlobalTensor<half> yGm;
        yGm.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y), (int64_t)M * N);

        TPipe pipe;
        TBuf<TPosition::VECCALC> wIB, whB, wFB, xbB, xhB, xfB, tlB, tpB, obB, scB,
                                 xcB, xrB, ofB, glB;
        pipe.InitBuffer(wIB, (uint32_t)(K * Np));
        pipe.InitBuffer(whB, (uint32_t)(K * Np * 2));
        pipe.InitBuffer(wFB, (uint32_t)(K * Np * 4));
        pipe.InitBuffer(xbB, (uint32_t)(Gc * K));
        pipe.InitBuffer(xhB, (uint32_t)(Gc * K * 2));
        pipe.InitBuffer(xfB, (uint32_t)(Gc * K * 4));
        pipe.InitBuffer(tlB, (uint32_t)(Gc * Pf * 4));
        pipe.InitBuffer(tpB, (uint32_t)(Gc * Pf * 4));
        pipe.InitBuffer(obB, (uint32_t)(Gc * Pf * 2));
        pipe.InitBuffer(scB, (uint32_t)(Pf * 4));
        pipe.InitBuffer(xcB, (uint32_t)(G8 * 4));
        pipe.InitBuffer(xrB, (uint32_t)(G8 * 32));
        pipe.InitBuffer(ofB, (uint32_t)(G8 * 4));
        pipe.InitBuffer(glB, 1024u);
        auto wI = wIB.Get<int8_t>();
        auto wh = whB.Get<half>();
        auto wF = wFB.Get<float>();
        auto xb = xbB.Get<int8_t>();
        auto xh = xhB.Get<half>();
        auto xf = xfB.Get<float>();
        auto tl = tlB.Get<float>();
        auto tp = tpB.Get<float>();
        auto ob = obB.Get<half>();
        auto sc = scB.Get<float>();
        auto xc = xcB.Get<float>();
        auto xr = xrB.Get<float>();
        auto of = ofB.Get<uint32_t>();
        auto gl8 = glB.Get<int8_t>();

        event_t mvEvt = static_cast<event_t>(GetTPipePtr()->FetchEventID(HardEvent::MTE2_V));
        event_t msEvt = static_cast<event_t>(GetTPipePtr()->FetchEventID(HardEvent::MTE2_S));
        event_t smEvt = static_cast<event_t>(GetTPipePtr()->FetchEventID(HardEvent::S_MTE2));
        event_t vm2Evt = static_cast<event_t>(GetTPipePtr()->FetchEventID(HardEvent::V_MTE2));
        event_t v3Evt = static_cast<event_t>(GetTPipePtr()->FetchEventID(HardEvent::V_MTE3));
        event_t m3vEvt = static_cast<event_t>(GetTPipePtr()->FetchEventID(HardEvent::MTE3_V));
        event_t vsEvt = static_cast<event_t>(GetTPipePtr()->FetchEventID(HardEvent::V_S));
        event_t svEvt = static_cast<event_t>(GetTPipePtr()->FetchEventID(HardEvent::S_V));

        {
            GlobalTensor<int8_t> gGm;
            gGm.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(groupList), (int64_t)E * 8);
            DataCopyExtParams exG{1, (uint32_t)(E * 8), 0, 0, 0};
            DataCopyPadExtParams<int8_t> pdG{false, 0, 0, 0};
            DataCopyPad(gl8, gGm, exG, pdG);
            SetFlag<HardEvent::MTE2_S>(msEvt);
            WaitFlag<HardEvent::MTE2_S>(msEvt);
        }
        auto gl64 = gl8.ReinterpretCast<int64_t>();


        for (int32_t g = 0; g < G8; ++g) { of.SetValue(g, (uint32_t)(g * K * 4)); }
        SetFlag<HardEvent::S_V>(svEvt);
        WaitFlag<HardEvent::S_V>(svEvt);

        Duplicate(sc, 0.0f, Pf);
        Duplicate(tl, 0.0f, Gc * Pf);
        Duplicate(tp, 0.0f, Gc * Pf);
        Duplicate(xr, 0.0f, G8 * 8);

        const BinaryRepeatParams bpS(1, 1, 1, (uint8_t)(Pf / 8), (uint8_t)(Pf / 8), 0);
        const BinaryRepeatParams bpA(1, 1, 0, (uint8_t)(Pf / 8), 0, 1);

        Duplicate(sc, 0.0f, Pf);
        int64_t prev = 0;
        for (int32_t e = 0; e < E; ++e) {
            const int64_t eEnd = gl64.GetValue(e);
            const int64_t lo = (rowLo > prev) ? rowLo : prev;
            const int64_t hi = (rowHi < eEnd) ? rowHi : eEnd;
            prev = eEnd;
            if (hi <= lo) { continue; }

            SetFlag<HardEvent::V_MTE2>(vm2Evt);
            WaitFlag<HardEvent::V_MTE2>(vm2Evt);
            {
                GlobalTensor<int8_t> wGm;
                wGm.SetGlobalBuffer(wp + (int64_t)e * K * N, (int64_t)K * N);
                DataCopyExtParams exW{(uint16_t)K, (uint32_t)N, 0, 0, 0};
                DataCopyPadExtParams<int8_t> pdW{true, 0, (uint8_t)(Np - N), 0};
                DataCopyPad(wI, wGm, exW, pdW);
                GlobalTensor<float> sGm;
                sGm.SetGlobalBuffer(sp + (int64_t)e * N, (int64_t)N);
                DataCopyExtParams exS{1, (uint32_t)(N * 4), 0, 0, 0};
                DataCopyPadExtParams<float> pdS{false, 0, 0, 0.0f};
                DataCopyPad(sc, sGm, exS, pdS);
            }
            SetFlag<HardEvent::MTE2_V>(mvEvt);
            WaitFlag<HardEvent::MTE2_V>(mvEvt);
            Cast<half>(wh, wI, RoundMode::CAST_NONE, K * Np);
            Cast<float>(wF, wh, RoundMode::CAST_NONE, K * Np);

            for (int64_t b0 = lo; b0 < hi; b0 += Gc) {
                const int32_t Gcur = (int32_t)((hi - b0 < (int64_t)Gc) ? (hi - b0) : (int64_t)Gc);
                {
                    SetFlag<HardEvent::S_MTE2>(smEvt);
                    WaitFlag<HardEvent::S_MTE2>(smEvt);
                    SetFlag<HardEvent::V_MTE2>(vm2Evt);
                    WaitFlag<HardEvent::V_MTE2>(vm2Evt);
                    GlobalTensor<int8_t> xGm;
                    xGm.SetGlobalBuffer(xp + b0 * K, (int64_t)Gcur * K);
                    DataCopyExtParams exX{1, (uint32_t)(Gcur * K), 0, 0, 0};
                    DataCopyPadExtParams<int8_t> pdX{false, 0, 0, 0};
                    DataCopyPad(xb, xGm, exX, pdX);
                }
                SetFlag<HardEvent::MTE2_V>(mvEvt);
                WaitFlag<HardEvent::MTE2_V>(mvEvt);
                Cast<half>(xh, xb, RoundMode::CAST_NONE, Gcur * K);
                Cast<float>(xf, xh, RoundMode::CAST_NONE, Gcur * K);

                for (int32_t k = 0; k < K; ++k) {
                    Gather(xc, xf, of, (uint32_t)(k * 4), (uint32_t)Gcur);
                    Brcb(xr, xc, (uint8_t)((Gcur + 7) / 8), {1, 8});
                    if (k == 0) {
                        Mul(tl, wF, xr, (uint64_t)Pf, (uint8_t)Gcur, bpA);
                    } else {
                        MulAddDst(tl, wF[k * Np], xr, (uint64_t)Pf, (uint8_t)Gcur, bpA);
                    }
                }

                const int32_t cnt = Gcur * Pf;
                Adds(tl, tl, 0.0f, cnt);
                Mul(tl, tl, sc, (uint64_t)Pf, (uint8_t)Gcur, bpS);
                Mul(tp, tl, tl, cnt);
                Mul(tp, tl, tp, cnt);
                Muls(tp, tp, GMG_GELU_BETA, cnt);
                Add(tp, tl, tp, cnt);
                Muls(tp, tp, GMG_GELU_ALPHA, cnt);
                Exp(tp, tp, cnt);
                Adds(tp, tp, 1.0f, cnt);
                Div(tl, tl, tp, cnt);
                Cast<half>(ob, tl, RoundMode::CAST_RINT, cnt);
                SetFlag<HardEvent::V_MTE3>(v3Evt);
                WaitFlag<HardEvent::V_MTE3>(v3Evt);
                {
                    DataCopyExtParams exY{(uint16_t)Gcur, (uint32_t)(N * 2), 0, 0, 0};
                    DataCopyPad(yGm[b0 * N], ob, exY);
                }
                SetFlag<HardEvent::MTE3_V>(m3vEvt);
                WaitFlag<HardEvent::MTE3_V>(m3vEvt);
            }
        }
        return;
    }
}
constexpr int32_t GMG_MIDM_UB = 165888;

__global__ __aicore__ void gmg_midm_kernel(
    GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groupList, GM_ADDR y,
    GM_ADDR workspace, GM_ADDR cWs, GM_ADDR tilingGm,
    int64_t argA, int64_t argB)
{
    (void)workspace; (void)cWs; (void)tilingGm;

    if ASCEND_IS_AIV {
        const int32_t M = (int32_t)((uint64_t)argA >> 40);
        const int32_t K = (int32_t)((uint64_t)argA >> 26) & 0x3FFF;
        const int32_t N = (int32_t)((uint32_t)argA & 0x3FFFFFFu);
        const int32_t E = (int32_t)((uint64_t)argB >> 48);
        if (M < 1 || K < 1 || K > 512 || N < 1 || N > 2048 || E < 1 || E > 128) { return; }

        const int32_t bd = (int32_t)GetBlockNum();
        const int32_t bi = (int32_t)GetBlockIdx();
        if (bd < 1 || bi >= bd) { return; }
        const int64_t rowLo = (int64_t)M * bi / bd;
        const int64_t rowHi = (int64_t)M * (bi + 1) / bd;
        if (rowHi <= rowLo) { return; }

        const int32_t Np = ((N + 31) / 32) * 32;
        const int32_t Kb = K;

        int32_t Gb = (int32_t)(rowHi - rowLo);
        if (Gb > 8) { Gb = 8; }
        for (;;) {
            const int32_t b = Kb * Np * 7 + Gb * (Kb + Np * 10) + Np * 10 + 2048;
            if (b <= GMG_MIDM_UB) { break; }
            if (Gb <= 1) { return; }
            Gb = Gb / 2;
            if (Gb < 1) { Gb = 1; }
        }

        __gm__ int8_t* xp = reinterpret_cast<__gm__ int8_t*>(x);
        __gm__ int8_t* wp = reinterpret_cast<__gm__ int8_t*>(weight);
        __gm__ float* sp = reinterpret_cast<__gm__ float*>(scale);
        GlobalTensor<half> yGm;
        yGm.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y), (int64_t)M * N);

        TPipe pipe;
        TBuf<TPosition::VECCALC> wIB, whB, wFB, xbB, acB, tpB, obB, scB, glB;
        pipe.InitBuffer(wIB, (uint32_t)(Kb * Np));
        pipe.InitBuffer(whB, (uint32_t)(Kb * Np * 2));
        pipe.InitBuffer(wFB, (uint32_t)(Kb * Np * 4));
        pipe.InitBuffer(xbB, (uint32_t)(Gb * Kb));
        pipe.InitBuffer(acB, (uint32_t)(Gb * Np * 4));
        pipe.InitBuffer(tpB, (uint32_t)(Gb * Np * 4));
        pipe.InitBuffer(obB, (uint32_t)(Gb * Np * 2));
        pipe.InitBuffer(scB, (uint32_t)(Np * 4));
        pipe.InitBuffer(glB, 1024u);
        auto wI = wIB.Get<int8_t>();
        auto wh = whB.Get<half>();
        auto wF = wFB.Get<float>();
        auto xb = xbB.Get<int8_t>();
        auto ac = acB.Get<float>();
        auto tp = tpB.Get<float>();
        auto ob = obB.Get<half>();
        auto sc = scB.Get<float>();
        auto gl8 = glB.Get<int8_t>();

        event_t mvEvt = static_cast<event_t>(GetTPipePtr()->FetchEventID(HardEvent::MTE2_V));
        event_t msEvt = static_cast<event_t>(GetTPipePtr()->FetchEventID(HardEvent::MTE2_S));
        event_t vm2Evt = static_cast<event_t>(GetTPipePtr()->FetchEventID(HardEvent::V_MTE2));
        event_t sm2Evt = static_cast<event_t>(GetTPipePtr()->FetchEventID(HardEvent::S_MTE2));
        event_t v3Evt = static_cast<event_t>(GetTPipePtr()->FetchEventID(HardEvent::V_MTE3));
        event_t m3vEvt = static_cast<event_t>(GetTPipePtr()->FetchEventID(HardEvent::MTE3_V));

        {
            GlobalTensor<int8_t> gGm;
            gGm.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(groupList), (int64_t)E * 8);
            DataCopyExtParams exG{1, (uint32_t)(E * 8), 0, 0, 0};
            DataCopyPadExtParams<int8_t> pdG{false, 0, 0, 0};
            DataCopyPad(gl8, gGm, exG, pdG);
            SetFlag<HardEvent::MTE2_S>(msEvt);
            WaitFlag<HardEvent::MTE2_S>(msEvt);
        }
        auto gl64 = gl8.ReinterpretCast<int64_t>();

        const BinaryRepeatParams bpS(1, 1, 1, (uint8_t)(Np / 8), (uint8_t)(Np / 8), 0);
        int64_t prev = 0;
        for (int32_t e = 0; e < E; ++e) {
            const int64_t eEnd = gl64.GetValue(e);
            const int64_t lo = (rowLo > prev) ? rowLo : prev;
            const int64_t hi = (rowHi < eEnd) ? rowHi : eEnd;
            prev = eEnd;
            if (hi <= lo) { continue; }

            SetFlag<HardEvent::V_MTE2>(vm2Evt);
            WaitFlag<HardEvent::V_MTE2>(vm2Evt);
            Duplicate(sc, 0.0f, Np);
            {
                GlobalTensor<int8_t> wGm;
                wGm.SetGlobalBuffer(wp + (int64_t)e * K * N, (int64_t)K * N);
                DataCopyExtParams exW{(uint16_t)Kb, (uint32_t)N, 0, 0, 0};
                DataCopyPadExtParams<int8_t> pdW{true, 0, (uint8_t)(Np - N), 0};
                DataCopyPad(wI, wGm, exW, pdW);
                GlobalTensor<float> sGm;
                sGm.SetGlobalBuffer(sp + (int64_t)e * N, (int64_t)N);
                DataCopyExtParams exS{1, (uint32_t)(N * 4), 0, 0, 0};
                DataCopyPadExtParams<float> pdS{false, 0, 0, 0.0f};
                DataCopyPad(sc, sGm, exS, pdS);
            }
            SetFlag<HardEvent::MTE2_V>(mvEvt);
            WaitFlag<HardEvent::MTE2_V>(mvEvt);
            Cast<half>(wh, wI, RoundMode::CAST_NONE, Kb * Np);
            PipeBarrier<PIPE_V>();
            Cast<float>(wF, wh, RoundMode::CAST_NONE, Kb * Np);
            PipeBarrier<PIPE_V>();

            for (int64_t b0 = lo; b0 < hi; b0 += Gb) {
                const int32_t Gc = (int32_t)((hi - b0 < (int64_t)Gb) ? (hi - b0) : (int64_t)Gb);
                const int32_t cnt = Gc * Np;
                SetFlag<HardEvent::S_MTE2>(sm2Evt);
                WaitFlag<HardEvent::S_MTE2>(sm2Evt);
                {
                    GlobalTensor<int8_t> xGm;
                    xGm.SetGlobalBuffer(xp + b0 * K, (int64_t)Gc * K);
                    DataCopyExtParams exX{1, (uint32_t)(Gc * K), 0, 0, 0};
                    DataCopyPadExtParams<int8_t> pdX{false, 0, 0, 0};
                    DataCopyPad(xb, xGm, exX, pdX);
                }
                SetFlag<HardEvent::MTE2_S>(msEvt);
                WaitFlag<HardEvent::MTE2_S>(msEvt);

                for (int32_t g = 0; g < Gc; ++g) {
                    const int32_t xo = g * K;
                    const float x0 = (float)((int32_t)xb.GetValue(xo));
                    for (int32_t c0 = 0; c0 < Np; c0 += 64) {
                        const uint64_t w = (uint64_t)((Np - c0 < 64) ? (Np - c0) : 64);
                        Muls(ac[g * Np + c0], wF[c0], x0, w);
                    }
                    for (int32_t kk = 1; kk < Kb; ++kk) {
                        const float xv = (float)((int32_t)xb.GetValue(xo + kk));
                        for (int32_t c0 = 0; c0 < Np; c0 += 64) {
                            const uint64_t w = (uint64_t)((Np - c0 < 64) ? (Np - c0) : 64);
                            Axpy(ac[g * Np + c0], wF[kk * Np + c0], xv, w);
                        }
                    }
                }
                PipeBarrier<PIPE_V>();
                for (int32_t c0 = 0; c0 < Np; c0 += 64) {
                    const uint64_t w = (uint64_t)((Np - c0 < 64) ? (Np - c0) : 64);
                    Mul(ac[c0], ac[c0], sc[c0], w, (uint8_t)Gc, bpS);
                }
                PipeBarrier<PIPE_V>();
                Adds(ac, ac, 0.0f, cnt);
                PipeBarrier<PIPE_V>();
                Mul(tp, ac, ac, cnt);
                PipeBarrier<PIPE_V>();
                Mul(tp, ac, tp, cnt);
                PipeBarrier<PIPE_V>();
                Muls(tp, tp, GMG_GELU_BETA, cnt);
                PipeBarrier<PIPE_V>();
                Add(tp, ac, tp, cnt);
                PipeBarrier<PIPE_V>();
                Muls(tp, tp, GMG_GELU_ALPHA, cnt);
                PipeBarrier<PIPE_V>();
                Exp(tp, tp, cnt);
                PipeBarrier<PIPE_V>();
                Adds(tp, tp, 1.0f, cnt);
                PipeBarrier<PIPE_V>();
                Div(ac, ac, tp, cnt);
                PipeBarrier<PIPE_V>();

                for (int32_t g = 0; g < Gc; ++g) {
                    Cast<half>(ob[g * Np], ac[g * Np], RoundMode::CAST_RINT, Np);
                }
                SetFlag<HardEvent::V_MTE3>(v3Evt);
                WaitFlag<HardEvent::V_MTE3>(v3Evt);
                for (int32_t g = 0; g < Gc; ++g) {
                    DataCopyExtParams exY{1, (uint32_t)(N * 2), 0, 0, 0};
                    DataCopyPad(yGm[(b0 + g) * N], ob[g * Np], exY);
                }
                SetFlag<HardEvent::MTE3_V>(m3vEvt);
                WaitFlag<HardEvent::MTE3_V>(m3vEvt);
            }
        }
        return;
    }
}
constexpr int32_t GMG_TS_UB = 165888;

__global__ __aicore__ void gmg_tallskin_kernel(
    GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groupList, GM_ADDR y,
    GM_ADDR workspace, GM_ADDR cWs, GM_ADDR tilingGm,
    int64_t argA, int64_t argB)
{
    (void)workspace; (void)cWs; (void)tilingGm;

    if ASCEND_IS_AIV {
        const int32_t M = (int32_t)((uint64_t)argA >> 40);
        const int32_t K = (int32_t)((uint64_t)argA >> 26) & 0x3FFF;
        const int32_t N = (int32_t)((uint32_t)argA & 0x3FFFFFFu);
        const int32_t E = (int32_t)((uint64_t)argB >> 48);
        if (M < 1 || K < 1 || K > 16 || N < 1 || N > 64 || E < 1 || E > 128) { return; }

        const int32_t bd = (int32_t)GetBlockNum();
        const int32_t bi = (int32_t)GetBlockIdx();
        if (bd < 1) { return; }
        const int64_t rowLo = (int64_t)M * bi / bd;
        const int64_t rowHi = (int64_t)M * (bi + 1) / bd;
        if (rowHi <= rowLo) { return; }

        const int32_t Pf = ((N + 15) / 16) * 16;
        const int32_t Ph = Pf;
        const int32_t Np = ((N + 31) / 32) * 32;

        int32_t G = (GMG_TS_UB - K * Np - K * Pf * 4 - Pf * 4 - 16384) / (16 + 12 * Pf);
        if (G > 248) { G = 248; }
        G = (G / 8) * 8;
        if (G < 8) { return; }
        const int32_t tileF = G * Pf;
        const int32_t tileH = G * Ph;

        __gm__ int8_t* xp = reinterpret_cast<__gm__ int8_t*>(x);
        __gm__ int8_t* wp = reinterpret_cast<__gm__ int8_t*>(weight);
        __gm__ float* sp = reinterpret_cast<__gm__ float*>(scale);
        GlobalTensor<half> yGm;
        yGm.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y), (int64_t)M * N);

        TPipe pipe;
        TBuf<TPosition::VECCALC> wIB, wFB, scB, whB, xbB, tlB, tpB, obB, glB;
        pipe.InitBuffer(wIB, (uint32_t)(K * Np));
        pipe.InitBuffer(wFB, (uint32_t)(K * Pf * 4));
        pipe.InitBuffer(scB, (uint32_t)(Pf * 4));
        pipe.InitBuffer(whB, (uint32_t)(Pf * 2));
        pipe.InitBuffer(xbB, (uint32_t)(G * 16));
        pipe.InitBuffer(tlB, (uint32_t)(tileF * 4));
        pipe.InitBuffer(tpB, (uint32_t)(tileF * 4));
        pipe.InitBuffer(obB, (uint32_t)(tileH * 2));
        pipe.InitBuffer(glB, 1024u);
        auto wI = wIB.Get<int8_t>();
        auto wF = wFB.Get<float>();
        auto sc = scB.Get<float>();
        auto wh = whB.Get<half>();
        auto xb = xbB.Get<int8_t>();
        auto tl = tlB.Get<float>();
        auto tp = tpB.Get<float>();
        auto ob = obB.Get<half>();
        auto gl8 = glB.Get<int8_t>();

        event_t mvEvt = static_cast<event_t>(GetTPipePtr()->FetchEventID(HardEvent::MTE2_V));
        event_t msEvt = static_cast<event_t>(GetTPipePtr()->FetchEventID(HardEvent::MTE2_S));
        event_t smEvt = static_cast<event_t>(GetTPipePtr()->FetchEventID(HardEvent::S_MTE2));
        event_t vm2Evt = static_cast<event_t>(GetTPipePtr()->FetchEventID(HardEvent::V_MTE2));
        event_t v3Evt = static_cast<event_t>(GetTPipePtr()->FetchEventID(HardEvent::V_MTE3));
        event_t m3vEvt = static_cast<event_t>(GetTPipePtr()->FetchEventID(HardEvent::MTE3_V));

        {
            GlobalTensor<int8_t> gGm;
            gGm.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(groupList), (int64_t)E * 8);
            DataCopyExtParams exG{1, (uint32_t)(E * 8), 0, 0, 0};
            DataCopyPadExtParams<int8_t> pdG{false, 0, 0, 0};
            DataCopyPad(gl8, gGm, exG, pdG);
            SetFlag<HardEvent::MTE2_S>(msEvt);
            WaitFlag<HardEvent::MTE2_S>(msEvt);
        }
        auto gl64 = gl8.ReinterpretCast<int64_t>();

        Duplicate(sc, 0.0f, Pf);

        const BinaryRepeatParams bpS(1, 1, 1, (uint8_t)(Pf / 8), (uint8_t)(Pf / 8), 0);
        int64_t prev = 0;
        for (int32_t e = 0; e < E; ++e) {
            const int64_t eEnd = gl64.GetValue(e);
            const int64_t lo = (rowLo > prev) ? rowLo : prev;
            const int64_t hi = (rowHi < eEnd) ? rowHi : eEnd;
            prev = eEnd;
            if (hi <= lo) { continue; }

            SetFlag<HardEvent::V_MTE2>(vm2Evt);
            WaitFlag<HardEvent::V_MTE2>(vm2Evt);
            {
                GlobalTensor<int8_t> wGm;
                wGm.SetGlobalBuffer(wp + (int64_t)e * K * N, (int64_t)K * N);
                DataCopyExtParams exW{(uint16_t)K, (uint32_t)N, 0, 0, 0};
                DataCopyPadExtParams<int8_t> pdW{true, 0, (uint8_t)(Np - N), 0};
                DataCopyPad(wI, wGm, exW, pdW);
                GlobalTensor<float> sGm;
                sGm.SetGlobalBuffer(sp + (int64_t)e * N, (int64_t)N);
                DataCopyExtParams exS{1, (uint32_t)(N * 4), 0, 0, 0};
                DataCopyPadExtParams<float> pdS{false, 0, 0, 0.0f};
                DataCopyPad(sc, sGm, exS, pdS);
            }
            SetFlag<HardEvent::MTE2_V>(mvEvt);
            WaitFlag<HardEvent::MTE2_V>(mvEvt);
            for (int32_t k = 0; k < K; ++k) {
                Cast<half>(wh, wI[k * Np], RoundMode::CAST_NONE, Pf);
                PipeBarrier<PIPE_V>();
                Cast<float>(wF[k * Pf], wh, RoundMode::CAST_NONE, Pf);
                PipeBarrier<PIPE_V>();
            }

            for (int64_t b0 = lo; b0 < hi; b0 += G) {
                const int32_t Gc = (int32_t)((hi - b0 < (int64_t)G) ? (hi - b0) : (int64_t)G);
                {
                    SetFlag<HardEvent::S_MTE2>(smEvt);
                    WaitFlag<HardEvent::S_MTE2>(smEvt);
                    GlobalTensor<int8_t> xGm;
                    xGm.SetGlobalBuffer(xp + b0 * K, (int64_t)Gc * K);
                    DataCopyExtParams exX{1, (uint32_t)(Gc * K), 0, 0, 0};
                    DataCopyPadExtParams<int8_t> pdX{false, 0, 0, 0};
                    DataCopyPad(xb, xGm, exX, pdX);
                    SetFlag<HardEvent::MTE2_S>(msEvt);
                    WaitFlag<HardEvent::MTE2_S>(msEvt);
                }
                for (int32_t g = 0; g < Gc; ++g) {
                    const int32_t xo = g * K;
                    const float x0 = (float)((int32_t)xb.GetValue(xo));
                    Muls(tl[g * Pf], wF, x0, Pf);
                    for (int32_t k = 1; k < K; ++k) {
                        const float xv = (float)((int32_t)xb.GetValue(xo + k));
                        Axpy(tl[g * Pf], wF[k * Pf], xv, Pf);
                    }
                }
                const int32_t cnt = Gc * Pf;
                Mul(tl, tl, sc, (uint64_t)Pf, (uint8_t)Gc, bpS);
                Adds(tl, tl, 0.0f, cnt);
                Mul(tp, tl, tl, cnt);
                Mul(tp, tl, tp, cnt);
                Muls(tp, tp, GMG_GELU_BETA, cnt);
                Add(tp, tl, tp, cnt);
                Muls(tp, tp, GMG_GELU_ALPHA, cnt);
                Exp(tp, tp, cnt);
                Adds(tp, tp, 1.0f, cnt);
                Div(tl, tl, tp, cnt);
                Cast<half>(ob, tl, RoundMode::CAST_RINT, Gc * Pf);
                SetFlag<HardEvent::V_MTE3>(v3Evt);
                WaitFlag<HardEvent::V_MTE3>(v3Evt);
                {
                    DataCopyExtParams exY{(uint16_t)Gc, (uint32_t)(N * 2), 0, 0, 0};
                    DataCopyPad(yGm[b0 * N], ob, exY);
                }
                SetFlag<HardEvent::MTE3_V>(m3vEvt);
                WaitFlag<HardEvent::MTE3_V>(m3vEvt);
            }
        }
        return;
    }
}


constexpr int32_t GMG_NK_UB = 165888;

__global__ __aicore__ void gmg_narrowk_kernel(
    GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groupList, GM_ADDR y,
    GM_ADDR workspace, GM_ADDR cWs, GM_ADDR tilingGm,
    int64_t argA, int64_t argB)
{
    (void)workspace; (void)cWs; (void)tilingGm;

    if ASCEND_IS_AIV {
        const int32_t M = (int32_t)((uint64_t)argA >> 40);
        const int32_t K = (int32_t)((uint64_t)argA >> 26) & 0x3FFF;
        const int32_t N = (int32_t)((uint32_t)argA & 0x3FFFFFFu);
        const int32_t E = (int32_t)((uint64_t)argB >> 48);
        if (M < 1 || K < 1 || K > 512 || N < 1 || N > 128 || E < 1 || E > 128) { return; }

        const int32_t bd = (int32_t)GetBlockNum();
        const int32_t bi = (int32_t)GetBlockIdx();
        if (bd < 1 || bi >= bd) { return; }
        const int64_t rowLo = (int64_t)M * bi / bd;
        const int64_t rowHi = (int64_t)M * (bi + 1) / bd;
        if (rowHi <= rowLo) { return; }

        const int32_t Np = ((N + 31) / 32) * 32;

        int32_t Gb = (int32_t)((rowHi - rowLo > 256) ? 256 : (rowHi - rowLo));
        for (;;) {
            const int32_t b = 32 * Np * 7 + Gb * (32 * 7 + Np * 10) + Np * 4 + 2048;
            if (b <= GMG_NK_UB) { break; }
            if (Gb <= 1) { return; }
            Gb = Gb / 2;
            if (Gb < 1) { Gb = 1; }
        }
        int32_t Kb = ((K + 31) / 32) * 32;
        for (;;) {
            const int32_t b = Kb * Np * 7 + Gb * (Kb * 7 + Np * 10) + Np * 4 + 2048;
            if (b <= GMG_NK_UB) { break; }
            if (Kb <= 32) { return; }
            Kb -= 32;
        }
        __gm__ int8_t* xp = reinterpret_cast<__gm__ int8_t*>(x);
        __gm__ int8_t* wp = reinterpret_cast<__gm__ int8_t*>(weight);
        __gm__ float* sp = reinterpret_cast<__gm__ float*>(scale);
        GlobalTensor<half> yGm;
        yGm.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y), (int64_t)M * N);

        TPipe pipe;
        TBuf<TPosition::VECCALC> wIB, whB, wFB, xbB, xhB, xfB, acB, tpB, obB, scB, glB;
        pipe.InitBuffer(wIB, (uint32_t)(Kb * Np));
        pipe.InitBuffer(whB, (uint32_t)(Kb * Np * 2));
        pipe.InitBuffer(wFB, (uint32_t)(Kb * Np * 4));
        pipe.InitBuffer(xbB, (uint32_t)(Gb * Kb));
        pipe.InitBuffer(xhB, (uint32_t)(Gb * Kb * 2));
        pipe.InitBuffer(xfB, (uint32_t)(Gb * Kb * 4));
        pipe.InitBuffer(acB, (uint32_t)(Gb * Np * 4));
        pipe.InitBuffer(tpB, (uint32_t)(Gb * Np * 4));
        pipe.InitBuffer(obB, (uint32_t)(Gb * Np * 2));
        pipe.InitBuffer(scB, (uint32_t)(Np * 4));
        pipe.InitBuffer(glB, 1024u);
        auto wI = wIB.Get<int8_t>();
        auto wh = whB.Get<half>();
        auto wF = wFB.Get<float>();
        auto xb = xbB.Get<int8_t>();
        auto xh = xhB.Get<half>();
        auto xf = xfB.Get<float>();
        auto ac = acB.Get<float>();
        auto tp = tpB.Get<float>();
        auto ob = obB.Get<half>();
        auto sc = scB.Get<float>();
        auto gl8 = glB.Get<int8_t>();

        event_t mvEvt = static_cast<event_t>(GetTPipePtr()->FetchEventID(HardEvent::MTE2_V));
        event_t msEvt = static_cast<event_t>(GetTPipePtr()->FetchEventID(HardEvent::MTE2_S));
        event_t vm2Evt = static_cast<event_t>(GetTPipePtr()->FetchEventID(HardEvent::V_MTE2));
        event_t v3Evt = static_cast<event_t>(GetTPipePtr()->FetchEventID(HardEvent::V_MTE3));
        event_t m3vEvt = static_cast<event_t>(GetTPipePtr()->FetchEventID(HardEvent::MTE3_V));

        {
            GlobalTensor<int8_t> gGm;
            gGm.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(groupList), (int64_t)E * 8);
            DataCopyExtParams exG{1, (uint32_t)(E * 8), 0, 0, 0};
            DataCopyPadExtParams<int8_t> pdG{false, 0, 0, 0};
            DataCopyPad(gl8, gGm, exG, pdG);
            SetFlag<HardEvent::MTE2_S>(msEvt);
            WaitFlag<HardEvent::MTE2_S>(msEvt);
        }
        auto gl64 = gl8.ReinterpretCast<int64_t>();

        const BinaryRepeatParams bpS(1, 1, 1, (uint8_t)(Np / 8), (uint8_t)(Np / 8), 0);
        int64_t prev = 0;
        for (int32_t e = 0; e < E; ++e) {
            const int64_t eEnd = gl64.GetValue(e);
            const int64_t lo = (rowLo > prev) ? rowLo : prev;
            const int64_t hi = (rowHi < eEnd) ? rowHi : eEnd;
            prev = eEnd;
            if (hi <= lo) { continue; }

            SetFlag<HardEvent::V_MTE2>(vm2Evt);
            WaitFlag<HardEvent::V_MTE2>(vm2Evt);
            Duplicate(sc, 0.0f, Np);
            {
                GlobalTensor<float> sGm;
                sGm.SetGlobalBuffer(sp + (int64_t)e * N, (int64_t)N);
                DataCopyExtParams exS{1, (uint32_t)(N * 4), 0, 0, 0};
                DataCopyPadExtParams<float> pdS{false, 0, 0, 0.0f};
                DataCopyPad(sc, sGm, exS, pdS);
            }

            for (int64_t b0 = lo; b0 < hi; b0 += Gb) {
                const int32_t Gc = (int32_t)((hi - b0 < (int64_t)Gb) ? (hi - b0) : (int64_t)Gb);
                const int32_t cnt = Gc * Np;
                Duplicate(ac, 0.0f, cnt);
                PipeBarrier<PIPE_V>();

                for (int32_t k0 = 0; k0 < K; k0 += Kb) {
                    const int32_t kc = (K - k0 < Kb) ? (K - k0) : Kb;

                    SetFlag<HardEvent::V_MTE2>(vm2Evt);
                    WaitFlag<HardEvent::V_MTE2>(vm2Evt);
                    {
                        GlobalTensor<int8_t> wGm;
                        wGm.SetGlobalBuffer(wp + ((int64_t)e * K + k0) * N, (int64_t)kc * N);
                        DataCopyExtParams exW{(uint16_t)kc, (uint32_t)N, 0, 0, 0};
                        DataCopyPadExtParams<int8_t> pdW{true, 0, (uint8_t)(Np - N), 0};
                        DataCopyPad(wI, wGm, exW, pdW);
                        DataCopyPadExtParams<int8_t> pdX{false, 0, 0, 0};
                        if (kc == Kb) {
                            GlobalTensor<int8_t> xGm;
                            xGm.SetGlobalBuffer(xp + (b0 * K + k0), (int64_t)Gc * Kb);
                            DataCopyExtParams exX{(uint16_t)Gc, (uint32_t)Kb,
                                                  (uint32_t)(K - Kb), 0, 0};
                            DataCopyPad(xb, xGm, exX, pdX);
                        } else {
                            for (int32_t g = 0; g < Gc; ++g) {
                                GlobalTensor<int8_t> xr;
                                xr.SetGlobalBuffer(xp + ((b0 + g) * K + k0), (int64_t)kc);
                                DataCopyExtParams ex1{1, (uint32_t)kc, 0, 0, 0};
                                DataCopyPad(xb[g * Kb], xr, ex1, pdX);
                            }
                        }
                    }
                    SetFlag<HardEvent::MTE2_V>(mvEvt);
                    WaitFlag<HardEvent::MTE2_V>(mvEvt);
                    Cast<half>(wh, wI, RoundMode::CAST_NONE, Kb * Np);
                    PipeBarrier<PIPE_V>();
                    Cast<float>(wF, wh, RoundMode::CAST_NONE, Kb * Np);
                    PipeBarrier<PIPE_V>();
                    Cast<half>(xh, xb, RoundMode::CAST_NONE, Gc * Kb);
                    PipeBarrier<PIPE_V>();
                    Cast<float>(xf, xh, RoundMode::CAST_NONE, Gc * Kb);
                    PipeBarrier<PIPE_V>();

                    for (int32_t kk = 0; kk < kc; ++kk) {
                        for (int32_t g = 0; g < Gc; ++g) {
                            const float xv = xf.GetValue(g * Kb + kk);
                            for (int32_t c0 = 0; c0 < Np; c0 += 64) {
                                const uint64_t w = (uint64_t)((Np - c0 < 64) ? (Np - c0) : 64);
                                Axpy(ac[g * Np + c0], wF[kk * Np + c0], xv, w);
                            }
                        }
                    }
                    PipeBarrier<PIPE_V>();
                }

                for (int32_t c0 = 0; c0 < Np; c0 += 64) {
                    const uint64_t w = (uint64_t)((Np - c0 < 64) ? (Np - c0) : 64);
                    Mul(ac[c0], ac[c0], sc[c0], w, (uint8_t)Gc, bpS);
                }
                PipeBarrier<PIPE_V>();
                Adds(ac, ac, 0.0f, cnt);
                PipeBarrier<PIPE_V>();
                Mul(tp, ac, ac, cnt);
                PipeBarrier<PIPE_V>();
                Mul(tp, ac, tp, cnt);
                PipeBarrier<PIPE_V>();
                Muls(tp, tp, GMG_GELU_BETA, cnt);
                PipeBarrier<PIPE_V>();
                Add(tp, ac, tp, cnt);
                PipeBarrier<PIPE_V>();
                Muls(tp, tp, GMG_GELU_ALPHA, cnt);
                PipeBarrier<PIPE_V>();
                Exp(tp, tp, cnt);
                PipeBarrier<PIPE_V>();
                Adds(tp, tp, 1.0f, cnt);
                PipeBarrier<PIPE_V>();
                Div(ac, ac, tp, cnt);
                PipeBarrier<PIPE_V>();

                for (int32_t g = 0; g < Gc; ++g) {
                    Cast<half>(ob[g * Np], ac[g * Np], RoundMode::CAST_RINT, Np);
                }
                SetFlag<HardEvent::V_MTE3>(v3Evt);
                WaitFlag<HardEvent::V_MTE3>(v3Evt);
                for (int32_t g = 0; g < Gc; ++g) {
                    DataCopyExtParams exY{1, (uint32_t)(N * 2), 0, 0, 0};
                    DataCopyPad(yGm[(b0 + g) * N], ob[g * Np], exY);
                }
                SetFlag<HardEvent::MTE3_V>(m3vEvt);
                WaitFlag<HardEvent::MTE3_V>(m3vEvt);
            }
        }
        return;
    }
}


__global__ __aicore__ void gmg_skinny_kernel(
    GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groupList, GM_ADDR y,
    GM_ADDR workspace, GM_ADDR cWs, GM_ADDR tilingGm,
    int64_t argA, int64_t argB)
{
    (void)workspace; (void)cWs; (void)tilingGm;
    if ASCEND_IS_AIV {
        const int32_t M = (int32_t)((uint64_t)argA >> 40);
        const int32_t K = (int32_t)((uint64_t)argA >> 26) & 0x3FFF;
        const int32_t N = (int32_t)((uint64_t)argA) & 0x3FFFFFF;
        const int32_t E = (int32_t)((uint64_t)argB >> 48);
        if (N != 1 || K < 1 || M < 1 || E < 1) { return; }    
        const int32_t bd = (int32_t)GetBlockNum();
        const int32_t bi = (int32_t)GetBlockIdx();
        if (bd < 1) { return; }
        const int64_t rowLo = (int64_t)M * bi / bd;
        const int64_t rowHi = (int64_t)M * (bi + 1) / bd;
        if (rowHi <= rowLo) { return; }

        const int32_t Kp = ((K + 127) / 128) * 128;        
        const int32_t Reff = (K + 63) / 64;                 
        int32_t G = 12288 / Kp;                             
        if (G > 48) { G = 48; }                             
        G = (G / 8) * 8;
        if (G < 8) { G = 8; }
        const int32_t Gp64 = ((G + 63) / 64) * 64;
        const bool pitchEq = (Kp == K);                     

        __gm__ int8_t* xp = reinterpret_cast<__gm__ int8_t*>(x);
        __gm__ int8_t* wp = reinterpret_cast<__gm__ int8_t*>(weight);
        __gm__ float* sp = reinterpret_cast<__gm__ float*>(scale);
        __gm__ int64_t* gl = reinterpret_cast<__gm__ int64_t*>(groupList);
        GlobalTensor<half> yGm;
        yGm.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y), (int64_t)M);

        TPipe pipe;
        TQue<QuePosition::VECOUT, 2> oq;
        TBuf<TPosition::VECCALC> wbB, xbB, whB, wFB, xhB, xfB, kTB, dsB, d2B, zfB, tB;
        pipe.InitBuffer(oq, 2, (uint32_t)(Gp64 * 2));
        pipe.InitBuffer(wbB, (uint32_t)Kp);
        pipe.InitBuffer(xbB, (uint32_t)G * Kp);
        pipe.InitBuffer(whB, (uint32_t)Kp * 2);
        pipe.InitBuffer(wFB, (uint32_t)Kp * 4);
        pipe.InitBuffer(xhB, (uint32_t)G * Kp * 2);
        pipe.InitBuffer(xfB, (uint32_t)G * Kp * 4);
        pipe.InitBuffer(kTB, (uint32_t)G * 64 * 4);
        pipe.InitBuffer(dsB, (uint32_t)G * 4);
        pipe.InitBuffer(d2B, (uint32_t)G * 4);
        pipe.InitBuffer(zfB, (uint32_t)(Gp64 * 4));
        pipe.InitBuffer(tB, (uint32_t)Gp64 * 4);
        auto wh = whB.Get<half>();
        auto wF = wFB.Get<float>();
        auto xh = xhB.Get<half>();
        auto xf = xfB.Get<float>();
        auto kT = kTB.Get<float>();
        auto ds = dsB.Get<float>();
        auto d2 = d2B.Get<float>();
        auto zf = zfB.Get<float>();
        auto tmp = tB.Get<float>();
        const BinaryRepeatParams bpMul(1, 1, 1, 8, (uint8_t)(Kp / 8), 0);
        event_t vmEvt = static_cast<event_t>(GetTPipePtr()->FetchEventID(HardEvent::V_MTE3));
        event_t mvEvt = static_cast<event_t>(GetTPipePtr()->FetchEventID(HardEvent::MTE2_V));
        event_t vm2Evt = static_cast<event_t>(GetTPipePtr()->FetchEventID(HardEvent::V_MTE2));

        int64_t prev = 0;
        for (int32_t e = 0; e < E; ++e) {
            const int64_t end = gl[e];
            const int64_t lo = (rowLo > prev) ? rowLo : prev;
            const int64_t hi = (rowHi < end) ? rowHi : end;
            prev = end;
            if (hi <= lo) { continue; }
            
            {
                const int32_t Kp32 = ((K + 31) / 32) * 32;
                auto wb = wbB.Get<int8_t>();
                GlobalTensor<int8_t> wg;
                wg.SetGlobalBuffer(wp + (int64_t)e * K, (int64_t)Kp32);
                DataCopyExtParams exW{1, (uint32_t)K, 0, 0, 0};
                DataCopyPadExtParams<int8_t> pdW{true, 0, (uint8_t)(Kp32 - K), 0};
                DataCopyPad(wb, wg, exW, pdW);
                SetFlag<HardEvent::MTE2_V>(mvEvt);
                WaitFlag<HardEvent::MTE2_V>(mvEvt);
                Cast<half>(wh, wb, RoundMode::CAST_NONE, Kp);
                PipeBarrier<PIPE_V>();
                Cast<float>(wF, wh, RoundMode::CAST_NONE, Kp);
                PipeBarrier<PIPE_V>();
                SetFlag<HardEvent::V_MTE2>(vm2Evt);
                WaitFlag<HardEvent::V_MTE2>(vm2Evt);
                if (Kp > Kp32) {
                    Duplicate(wF[Kp32], 0.0f, Kp - Kp32);
                    PipeBarrier<PIPE_V>();
                }
            }
            const float se0 = sp[e];
            
            for (int64_t b0 = lo; b0 < hi; b0 += G) {
                const int32_t Gc = (int32_t)((hi - b0 < (int64_t)G) ? (hi - b0) : (int64_t)G);
                auto xb = xbB.Get<int8_t>();
                DataCopyPadExtParams<int8_t> pdX{false, 0, 0, 0};
                SetFlag<HardEvent::V_MTE2>(vm2Evt);
                WaitFlag<HardEvent::V_MTE2>(vm2Evt);
                if (pitchEq) {
                    GlobalTensor<int8_t> xg;
                    xg.SetGlobalBuffer(xp + b0 * K, (int64_t)Gc * K);
                    DataCopyExtParams exX{(uint16_t)Gc, (uint32_t)K, 0, 0, 0};
                    DataCopyPad(xb, xg, exX, pdX);
                } else {
                    const int32_t Lrow = (K < 8) ? 8 : K;    
                    for (int32_t g = 0; g < Gc; ++g) {
                        GlobalTensor<int8_t> xr;
                        xr.SetGlobalBuffer(xp + (b0 + g) * K, (int64_t)Lrow);
                        DataCopyExtParams ex1{1, (uint32_t)Lrow, 0, 0, 0};
                        DataCopyPad(xb[g * Kp], xr, ex1, pdX);
                    }
                }
                SetFlag<HardEvent::MTE2_V>(mvEvt);
                WaitFlag<HardEvent::MTE2_V>(mvEvt);
                Cast<half>(xh, xb, RoundMode::CAST_NONE, Gc * Kp);
                PipeBarrier<PIPE_V>();
                Cast<float>(xf, xh, RoundMode::CAST_NONE, Gc * Kp);
                PipeBarrier<PIPE_V>();
                Duplicate(d2, 0.0f, G);
                PipeBarrier<PIPE_V>();
                for (int32_t c = 0; c < Reff; ++c) {
                    Mul(kT, xf[c * 64], wF[c * 64], (uint64_t)64, (uint8_t)Gc, bpMul);
                    PipeBarrier<PIPE_V>();
                    for (int32_t g = 0; g < Gc; ++g) {
                        WholeReduceSum(ds[g], kT[g * 64], 64, 1, 8, 1, 8);
                    }
                    PipeBarrier<PIPE_V>();
                    Add(d2, d2, ds, Gc);
                    PipeBarrier<PIPE_V>();
                }
                
                Muls(zf, d2, se0, Gc);
                Mul(tmp, zf, zf, Gc);
                Mul(tmp, zf, tmp, Gc);
                Muls(tmp, tmp, 0.044715f, Gc);
                Add(tmp, zf, tmp, Gc);
                Muls(tmp, tmp, -1.5957691216057308f, Gc);
                Exp(tmp, tmp, Gc);
                Adds(tmp, tmp, 1.0f, Gc);
                Div(zf, zf, tmp, Gc);
                LocalTensor<half> ob = oq.AllocTensor<half>();
                Cast<half>(ob, zf, RoundMode::CAST_RINT, Gp64);
                oq.EnQue(ob);
                ob = oq.DeQue<half>();
                DataCopyExtParams exY{1, (uint16_t)(Gc * 2), 0, 0, 0};
                DataCopyPad(yGm[b0], ob, exY);
                oq.FreeTensor(ob);
            }
        }
        return;
    }
}


__global__ __aicore__ void gmg_skinny_bigk_kernel(
    GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groupList, GM_ADDR y,
    GM_ADDR workspace, GM_ADDR cWs, GM_ADDR tilingGm,
    int64_t argA, int64_t argB)
{
    (void)workspace; (void)cWs; (void)tilingGm;
    if ASCEND_IS_AIV {
        const int32_t M = (int32_t)((uint64_t)argA >> 40);
        const int32_t K = (int32_t)((uint64_t)argA >> 26) & 0x3FFF;
        const int32_t N = (int32_t)((uint64_t)argA) & 0x3FFFFFF;
        const int32_t E = (int32_t)((uint64_t)argB >> 48);
        if (N != 1 || K < 1 || M < 1 || E < 1) { return; }    
        const int32_t bd = (int32_t)GetBlockNum();
        const int32_t bi = (int32_t)GetBlockIdx();
        if (bd < 1) { return; }
        const int64_t rowLo = (int64_t)M * bi / bd;
        const int64_t rowHi = (int64_t)M * (bi + 1) / bd;
        if (rowHi <= rowLo) { return; }

        const int32_t G   = 20;                               
        const int32_t Wb  = 1024;                            
        const int32_t Wc  = Wb / 64;                         
        const int32_t WbU = Wb;                              
        const int32_t S   = (K + Wb - 1) / Wb;               
        const int32_t Kp  = ((K + 127) / 128) * 128;         
        const int32_t Kp32 = ((K + 31) / 32) * 32;           
        const int32_t Kpc = ((K + 63) / 64) * 64;            
        const int32_t KpcF = Kpc + 64;                       
        const int32_t KpW = S * Wb;                          
        const int32_t Reff = (K + 63) / 64;                  
        const int32_t Gp64 = ((G + 63) / 64) * 64;

        __gm__ int8_t* xp = reinterpret_cast<__gm__ int8_t*>(x);
        __gm__ int8_t* wp = reinterpret_cast<__gm__ int8_t*>(weight);
        __gm__ float* sp = reinterpret_cast<__gm__ float*>(scale);
        __gm__ int64_t* gl = reinterpret_cast<__gm__ int64_t*>(groupList);
        GlobalTensor<half> yGm;
        yGm.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y), (int64_t)M);

        TPipe pipe;
        TQue<QuePosition::VECOUT, 2> oq;
        TBuf<TPosition::VECCALC> wbB, whB, wfB, xbB, xhB, xfB, kTB, dsB, diB, d2B, f2B, zfB, tB;
        pipe.InitBuffer(oq, 2, (uint32_t)(Gp64 * 2));
        pipe.InitBuffer(wbB, (uint32_t)Kpc);           
        pipe.InitBuffer(whB, (uint32_t)(KpcF * 2));
        pipe.InitBuffer(wfB, (uint32_t)(Wb * 4));         
        pipe.InitBuffer(xbB, (uint32_t)(G * WbU));
        pipe.InitBuffer(xhB, (uint32_t)(G * WbU * 2));
        pipe.InitBuffer(xfB, (uint32_t)(G * WbU * 4));
        pipe.InitBuffer(kTB, (uint32_t)(G * 64 * 4));    
        pipe.InitBuffer(dsB, (uint32_t)(G * 4));
        pipe.InitBuffer(diB, (uint32_t)(G * 4));
        pipe.InitBuffer(d2B, (uint32_t)(G * 4));        
        pipe.InitBuffer(f2B, (uint32_t)(G * 64 * 4));    
        pipe.InitBuffer(zfB, (uint32_t)(Gp64 * 4));
        pipe.InitBuffer(tB, (uint32_t)(Gp64 * 4));
        auto wb  = wbB.Get<int8_t>();
        auto wh  = whB.Get<half>();
        auto wf = wfB.Get<float>();
        auto xb  = xbB.Get<int8_t>();
        auto xh  = xhB.Get<half>();
        auto xf  = xfB.Get<float>();
        auto kT  = kTB.Get<float>();
        auto ds  = dsB.Get<float>();
        auto di  = diB.Get<int32_t>();
        auto d2i = d2B.Get<int32_t>();
        auto d2f = f2B.Get<float>();
        auto zf  = zfB.Get<float>();
        auto tmp = tB.Get<float>();
        const BinaryRepeatParams bpMul(1, 1, 1, 8, (uint8_t)(WbU / 8), 0);    
        event_t vmEvt  = static_cast<event_t>(GetTPipePtr()->FetchEventID(HardEvent::V_MTE3));
        event_t mvEvt  = static_cast<event_t>(GetTPipePtr()->FetchEventID(HardEvent::MTE2_V));
        event_t vm2Evt = static_cast<event_t>(GetTPipePtr()->FetchEventID(HardEvent::V_MTE2));

        
        
        
        
        
        
        
        
        
        
        
        const int32_t wLast  = (S - 1) * Wb;
        const int32_t lenLast = K - wLast;
        const bool shortTail = (lenLast < 8);
        
        
        
        
        const int32_t tailSt = shortTail ? (wLast - 64) : wLast;

        int64_t prev = 0;
        for (int32_t e = 0; e < E; ++e) {
            const int64_t end = gl[e];
            const int64_t lo = (rowLo > prev) ? rowLo : prev;
            const int64_t hi = (rowHi < end) ? rowHi : end;
            prev = end;
            if (hi <= lo) { continue; }
            
            
            
            
            {
                for (int32_t c0 = 0; c0 < K; c0 += 512) {
                    const bool last = ((K - c0) <= 512);
                    const int32_t len = last ? (Kp32 - c0) : 512;
                    const uint8_t pr = last ? (uint8_t)(Kp32 - K) : (uint8_t)0;
                    GlobalTensor<int8_t> wg;
                    wg.SetGlobalBuffer(wp + (int64_t)e * K + c0, (int64_t)len);
                    DataCopyExtParams exW{1, (uint32_t)len, 0, 0, 0};
                    DataCopyPadExtParams<int8_t> pdW{last, 0, pr, 0};
                    DataCopyPad(wb[c0], wg, exW, pdW);
                }
                SetFlag<HardEvent::MTE2_V>(mvEvt);
                WaitFlag<HardEvent::MTE2_V>(mvEvt);
                Cast<half>(wh, wb, RoundMode::CAST_NONE, Kpc);
                PipeBarrier<PIPE_V>();
                
                
                Duplicate(wh[Kp32], (half)0, KpcF - Kp32);
                PipeBarrier<PIPE_V>();
                SetFlag<HardEvent::V_MTE2>(vm2Evt);
                WaitFlag<HardEvent::V_MTE2>(vm2Evt);
            }
            const float se0 = sp[e];
            
            for (int64_t b0 = lo; b0 < hi; b0 += G) {
                const int32_t Gc = (int32_t)((hi - b0 < (int64_t)G) ? (hi - b0) : (int64_t)G);
                Duplicate(d2i, (int32_t)0, G);                     
                PipeBarrier<PIPE_V>();
                for (int32_t w = 0; w < S; ++w) {
                    int32_t st = w * Wb;
                    int32_t en = ((w + 1) * Wb < K) ? ((w + 1) * Wb) : K;
                    if (shortTail) {
                        if (w == S - 1) { st = tailSt; en = K; }
                        else if (w == S - 2) { en = tailSt; }
                    }
                    const int32_t len = en - st;
                    const int32_t cc = (len + 63) / 64;
                    const int32_t rTail = len - (cc - 1) * 64;     
                    
                    
                    
                    
                    
                    
                    
                    {
                        SetFlag<HardEvent::V_MTE2>(vm2Evt);
                        WaitFlag<HardEvent::V_MTE2>(vm2Evt);
                        DataCopyPadExtParams<int8_t> pdX{false, 0, 0, 0};
                        if (len == Wb) {
                            GlobalTensor<int8_t> xg;
                            xg.SetGlobalBuffer(xp + b0 * K + st, (int64_t)Gc * Wb);
                            DataCopyExtParams exX{(uint16_t)Gc, (uint32_t)Wb,
                                                  (uint32_t)(K - Wb), 0, 0};
                            DataCopyPad(xb, xg, exX, pdX);
                        } else {
                            for (int32_t g = 0; g < Gc; ++g) {
                                const int64_t base = (b0 + g) * (int64_t)K + st;
                                for (int32_t s = 0; s < len; s += 512) {
                                    int32_t l = len - s;
                                    if (l > 512) { l = 512; }
                                    GlobalTensor<int8_t> xr;
                                    xr.SetGlobalBuffer(xp + base + s, (int64_t)l);
                                    DataCopyExtParams ex1{1, (uint32_t)l, 0, 0, 0};
                                    DataCopyPad(xb[g * Wb + s], xr, ex1, pdX);
                                }
                            }
                        }
                        SetFlag<HardEvent::MTE2_V>(mvEvt);
                        WaitFlag<HardEvent::MTE2_V>(mvEvt);
                    }
                    Cast<half>(xh, xb, RoundMode::CAST_NONE, Gc * Wb);
                    Cast<float>(xf, xh, RoundMode::CAST_NONE, Gc * Wb);
                    Cast<float>(wf, wh[st], RoundMode::CAST_NONE, Wb);    
                    PipeBarrier<PIPE_V>();
                    Duplicate(d2f, 0.0f, G * 64);                  
                    
                    
                    
                    
                    
                    
                    
                    
                    for (int32_t c = 0; c < cc; ++c) {
                        const uint64_t mask = (c == cc - 1) ? (uint64_t)rTail : (uint64_t)64;
                        MulAddDst(d2f, xf[c * 64], wf[c * 64], mask, (uint8_t)Gc, bpMul);
                    }
                    
                    for (int32_t g = 0; g < Gc; ++g) {
                        WholeReduceSum(ds[g], d2f[g * 64], 64, 1, 8, 1, 8);
                    }
                    PipeBarrier<PIPE_V>();
                    Cast<int32_t>(di, ds, RoundMode::CAST_RINT, Gc);
                    PipeBarrier<PIPE_V>();
                    Add(d2i, d2i, di, Gc);
                    PipeBarrier<PIPE_V>();
                }
                
                Cast<float>(zf, d2i, RoundMode::CAST_RINT, Gc);
                PipeBarrier<PIPE_V>();
                Muls(zf, zf, se0, Gc);
                PipeBarrier<PIPE_V>();
                Mul(tmp, zf, zf, Gc);
                PipeBarrier<PIPE_V>();
                Mul(tmp, zf, tmp, Gc);
                PipeBarrier<PIPE_V>();
                Muls(tmp, tmp, 0.044715f, Gc);
                PipeBarrier<PIPE_V>();
                Add(tmp, zf, tmp, Gc);
                PipeBarrier<PIPE_V>();
                Muls(tmp, tmp, -1.5957691216057308f, Gc);
                PipeBarrier<PIPE_V>();
                Exp(tmp, tmp, Gc);
                PipeBarrier<PIPE_V>();
                Adds(tmp, tmp, 1.0f, Gc);
                PipeBarrier<PIPE_V>();
                Div(zf, zf, tmp, Gc);
                PipeBarrier<PIPE_V>();
                LocalTensor<half> ob = oq.AllocTensor<half>();
                Cast<half>(ob, zf, RoundMode::CAST_RINT, Gp64);
                oq.EnQue(ob);
                ob = oq.DeQue<half>();
                DataCopyExtParams exY{1, (uint16_t)(Gc * 2), 0, 0, 0};
                DataCopyPad(yGm[b0], ob, exY);
                oq.FreeTensor(ob);
            }
        }
        return;
    }
}




































__global__ __aicore__ void gmg_narrowV_kernel(
    GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groupList, GM_ADDR y,
    GM_ADDR workspace, GM_ADDR cWs, GM_ADDR tilingGm,
    int64_t argA, int64_t argB)
{
    (void)workspace; (void)cWs; (void)tilingGm;
    if ASCEND_IS_AIV {
        const int32_t M = (int32_t)((uint64_t)argA >> 40);
        const int32_t K = (int32_t)((uint64_t)argA >> 26) & 0x3FFF;
        const int32_t N = (int32_t)((uint64_t)argA) & 0x3FFFFFF;
        const int32_t E = (int32_t)((uint64_t)argB >> 48);
        
        
        if (N < 2 || N > 4 || K < 257 || K > 8192 ||
            M < 1 || M > 65536 || E < 1 || E > 128) { return; }
        if ((int64_t)K * (int64_t)N > 16384) { return; }
        const int32_t bd = (int32_t)GetBlockNum();
        const int32_t bi = (int32_t)GetBlockIdx();
        if (bd < 1) { return; }

        
        
        
        
        const int32_t Kp32 = ((K + 63) / 64) * 64 + 64;  
        const int32_t panelB = K * N;                    
        const int32_t wcolB = N * Kp32;                  
        if ((int64_t)panelB > 65536 || (int64_t)wcolB > 65536) { return; }

        __gm__ int8_t* xp = reinterpret_cast<__gm__ int8_t*>(x);
        __gm__ int8_t* wp = reinterpret_cast<__gm__ int8_t*>(weight);
        __gm__ float* sp = reinterpret_cast<__gm__ float*>(scale);
        __gm__ int64_t* gl = reinterpret_cast<__gm__ int64_t*>(groupList);
        GlobalTensor<half> yGm;
        yGm.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y), (int64_t)M * N);

        const int32_t Wb = 1024;
        
        
        int32_t G = 16;
        if ((int64_t)panelB + wcolB + (int64_t)Wb * 6 + (int64_t)7 * 16 * Wb +
            (int64_t)16 * 256 + (int64_t)8 * 16 + (int64_t)4 * N * 16 +
            (int64_t)8 * 64 + (int64_t)4 * N * 64 > (int64_t)GMG_UB_BUDGET) { G = 8; }
        if ((int64_t)panelB + wcolB + (int64_t)Wb * 6 + (int64_t)7 * 8 * Wb +
            (int64_t)8 * 256 + (int64_t)8 * 8 + (int64_t)4 * N * 8 +
            (int64_t)8 * 64 + (int64_t)4 * N * 64 > (int64_t)GMG_UB_BUDGET) { return; }
        const int32_t Gp64 = ((G + 63) / 64) * 64;
        const int32_t Nd2 = N * G;                       

        TPipe pipe;
        TBuf<TPosition::VECCALC> pnB, wcB, whB, wfB, xbB, xhB, xfB, kTB, dsB, diB, d2B, zfB, tB, cHB, outB;
        pipe.InitBuffer(pnB, (uint32_t)panelB);
        pipe.InitBuffer(wcB, (uint32_t)wcolB);
        pipe.InitBuffer(whB, (uint32_t)(Wb * 2));
        pipe.InitBuffer(wfB, (uint32_t)(Wb * 4));
        pipe.InitBuffer(xbB, (uint32_t)(G * Wb));
        pipe.InitBuffer(xhB, (uint32_t)(G * Wb * 2));
        pipe.InitBuffer(xfB, (uint32_t)(G * Wb * 4));
        pipe.InitBuffer(kTB, (uint32_t)(G * 64 * 4));
        pipe.InitBuffer(dsB, (uint32_t)(G * 4));
        pipe.InitBuffer(diB, (uint32_t)(G * 4));
        pipe.InitBuffer(d2B, (uint32_t)(Nd2 * 4));
        pipe.InitBuffer(zfB, (uint32_t)(Gp64 * 4));
        pipe.InitBuffer(tB, (uint32_t)(Gp64 * 4));
        pipe.InitBuffer(cHB, (uint32_t)(N * Gp64 * 2));
        pipe.InitBuffer(outB, (uint32_t)(Gp64 * N * 2));

        auto pn   = pnB.Get<int8_t>();
        auto wc   = wcB.Get<int8_t>();
        auto whW  = whB.Get<half>();
        auto wf   = wfB.Get<float>();
        auto xb   = xbB.Get<int8_t>();
        auto xh   = xhB.Get<half>();
        auto xf   = xfB.Get<float>();
        auto kT   = kTB.Get<float>();
        auto ds   = dsB.Get<float>();
        auto di   = diB.Get<int32_t>();
        auto d2i  = d2B.Get<int32_t>();
        auto zf   = zfB.Get<float>();
        auto tmp  = tB.Get<float>();
        auto colH = cHB.Get<half>();
        auto out  = outB.Get<half>();

        
        const BinaryRepeatParams bpMul(1, 1, 1, 8, (uint8_t)(Wb / 8), 0);
        event_t mvEvt  = static_cast<event_t>(GetTPipePtr()->FetchEventID(HardEvent::MTE2_V));
        event_t vm2Evt = static_cast<event_t>(GetTPipePtr()->FetchEventID(HardEvent::V_MTE2));
        event_t ms2Evt = static_cast<event_t>(GetTPipePtr()->FetchEventID(HardEvent::MTE2_S));
        event_t sm2Evt = static_cast<event_t>(GetTPipePtr()->FetchEventID(HardEvent::S_MTE2));
        event_t svEvt  = static_cast<event_t>(GetTPipePtr()->FetchEventID(HardEvent::S_V));
        event_t vsEvt  = static_cast<event_t>(GetTPipePtr()->FetchEventID(HardEvent::V_S));
        event_t s3Evt  = static_cast<event_t>(GetTPipePtr()->FetchEventID(HardEvent::S_MTE3));
        event_t e3sEvt = static_cast<event_t>(GetTPipePtr()->FetchEventID(HardEvent::MTE3_S));
        bool mte3SPending = false;

        
        
        const int32_t S = (K + Wb - 1) / Wb;
        const int32_t wLast = (S - 1) * Wb;
        const bool shortTail = (S >= 2) && ((K - wLast) < 8);    
        const int32_t tailSt = shortTail ? (wLast - 64) : wLast;

        
        
        
        
        
        
        
        
        const int32_t P = (E >= bd) ? 1 : (bd / E);
        const int64_t U = (int64_t)E * (int64_t)P;
        const int64_t uLo = U * bi / bd;
        const int64_t uHi = U * (bi + 1) / bd;
        const int32_t eLo = (int32_t)(uLo / P);
        const int64_t eHiQ = (uHi + P - 1) / P;
        const int32_t eHi = (int32_t)((eHiQ < (int64_t)E) ? eHiQ : (int64_t)E);
        int64_t prev = (eLo > 0) ? gl[eLo - 1] : 0;    
        for (int32_t e = eLo; e < eHi; ++e) {
            const int64_t end = gl[e];
            const int64_t rowsE = end - prev;
            const int64_t baseE = prev;
            prev = end;
            if (rowsE <= 0) { continue; }
            int64_t p0 = uLo - (int64_t)e * P;
            if (p0 < 0) { p0 = 0; }
            int64_t p1 = uHi - (int64_t)e * P;
            if (p1 > (int64_t)P) { p1 = P; }
            for (int64_t pp = p0; pp < p1; ++pp) {
            const int64_t lo = baseE + rowsE * pp / P;
            const int64_t hi = baseE + rowsE * (pp + 1) / P;
            if (hi <= lo) { continue; }
            if (mte3SPending) { WaitFlag<HardEvent::MTE3_S>(e3sEvt); mte3SPending = false; }

            
            {
                SetFlag<HardEvent::S_MTE2>(sm2Evt);      
                WaitFlag<HardEvent::S_MTE2>(sm2Evt);
                for (int32_t c0 = 0; c0 < panelB; c0 += 512) {
                    const int32_t len = (panelB - c0 < 512) ? (panelB - c0) : 512;
                    GlobalTensor<int8_t> wg;
                    wg.SetGlobalBuffer(wp + (int64_t)e * K * N + c0, (int64_t)len);
                    DataCopyExtParams exW{1, (uint32_t)len, 0, 0, 0};
                    DataCopyPadExtParams<int8_t> pdW{false, 0, 0, 0};
                    DataCopyPad(pn[c0], wg, exW, pdW);
                }
                SetFlag<HardEvent::MTE2_S>(ms2Evt);
                WaitFlag<HardEvent::MTE2_S>(ms2Evt);
            }
            
            
            SetFlag<HardEvent::V_S>(vsEvt);              
            WaitFlag<HardEvent::V_S>(vsEvt);
            for (int32_t n = 0; n < N; ++n) {
                for (int32_t k = 0; k < K; ++k) {
                    wc.SetValue((uint32_t)(n * Kp32 + k), (int8_t)pn.GetValue((uint32_t)(k * N + n)));
                }
                for (int32_t k = K; k < Kp32; ++k) {
                    wc.SetValue((uint32_t)(n * Kp32 + k), (int8_t)0);
                }
            }
            SetFlag<HardEvent::S_V>(svEvt);              
            WaitFlag<HardEvent::S_V>(svEvt);

            
            for (int64_t b0 = lo; b0 < hi; b0 += G) {
                const int32_t Gc = (int32_t)((hi - b0 < (int64_t)G) ? (hi - b0) : (int64_t)G);
                
                if (mte3SPending) { WaitFlag<HardEvent::MTE3_S>(e3sEvt); mte3SPending = false; }
                Duplicate(d2i, (int32_t)0, Nd2);         
                PipeBarrier<PIPE_V>();
                for (int32_t w = 0; w < S; ++w) {
                    int32_t st = w * Wb;
                    int32_t en = ((w + 1) * Wb < K) ? ((w + 1) * Wb) : K;
                    if (shortTail) {
                        if (w == S - 1) { st = tailSt; en = K; }
                        else if (w == S - 2) { en = tailSt; }
                    }
                    const int32_t len = en - st;
                    const int32_t cc = (len + 63) / 64;
                    const int32_t rTail = len - (cc - 1) * 64;
                    
                    
                    SetFlag<HardEvent::V_MTE2>(vm2Evt);    
                    WaitFlag<HardEvent::V_MTE2>(vm2Evt);
                    {
                        DataCopyPadExtParams<int8_t> pdX{false, 0, 0, 0};
                        if (len == Wb) {
                            GlobalTensor<int8_t> xg;
                            xg.SetGlobalBuffer(xp + b0 * (int64_t)K + st, (int64_t)Gc * Wb);
                            DataCopyExtParams exX{(uint16_t)Gc, (uint32_t)Wb,
                                                  (uint32_t)(K - Wb), 0, 0};
                            DataCopyPad(xb, xg, exX, pdX);
                        } else {
                            for (int32_t g = 0; g < Gc; ++g) {
                                GlobalTensor<int8_t> xr;
                                xr.SetGlobalBuffer(xp + (b0 + g) * (int64_t)K + st, (int64_t)len);
                                DataCopyExtParams ex1{1, (uint32_t)len, 0, 0, 0};
                                DataCopyPad(xb[g * Wb], xr, ex1, pdX);
                            }
                        }
                    }
                    SetFlag<HardEvent::MTE2_V>(mvEvt);
                    WaitFlag<HardEvent::MTE2_V>(mvEvt);
                    Cast<half>(xh, xb, RoundMode::CAST_NONE, Gc * Wb);
                    PipeBarrier<PIPE_V>();
                    Cast<float>(xf, xh, RoundMode::CAST_NONE, Gc * Wb);
                    PipeBarrier<PIPE_V>();
                    
                    
                    
                    const int32_t ccn = cc * 64;
                    for (int32_t n = 0; n < N; ++n) {
                        Cast<half>(whW, wc[n * Kp32 + st], RoundMode::CAST_NONE, ccn);
                        PipeBarrier<PIPE_V>();
                        Cast<float>(wf, whW, RoundMode::CAST_NONE, ccn);
                        PipeBarrier<PIPE_V>();
                        Duplicate(kT, 0.0f, G * 64);
                        PipeBarrier<PIPE_V>();
                        for (int32_t c = 0; c < cc; ++c) {
                            const uint64_t mask = (c == cc - 1) ? (uint64_t)rTail : (uint64_t)64;
                            MulAddDst(kT, xf[c * 64], wf[c * 64], mask, (uint8_t)Gc, bpMul);
                        }
                        for (int32_t g = 0; g < Gc; ++g) {
                            WholeReduceSum(ds[g], kT[g * 64], 64, 1, 8, 1, 8);
                        }
                        PipeBarrier<PIPE_V>();
                        Cast<int32_t>(di, ds, RoundMode::CAST_RINT, Gc);
                        PipeBarrier<PIPE_V>();
                        Add(d2i[n * G], d2i[n * G], di, Gc);
                        PipeBarrier<PIPE_V>();
                    }
                }
                
                for (int32_t n = 0; n < N; ++n) {
                    const float se = sp[(int64_t)e * N + n];
                    Cast<float>(zf, d2i[n * G], RoundMode::CAST_RINT, Gc);
                    PipeBarrier<PIPE_V>();
                    Muls(zf, zf, se, Gc);
                    Mul(tmp, zf, zf, Gc);
                    Mul(tmp, zf, tmp, Gc);
                    Muls(tmp, tmp, GMG_GELU_BETA, Gc);
                    Add(tmp, zf, tmp, Gc);
                    Muls(tmp, tmp, GMG_GELU_ALPHA, Gc);
                    Exp(tmp, tmp, Gc);
                    Adds(tmp, tmp, 1.0f, Gc);
                    Div(zf, zf, tmp, Gc);
                    Cast<half>(colH[n * Gp64], zf, RoundMode::CAST_RINT, Gp64);
                    PipeBarrier<PIPE_V>();
                }
                
                SetFlag<HardEvent::V_S>(vsEvt);
                WaitFlag<HardEvent::V_S>(vsEvt);
                for (int32_t g = 0; g < Gc; ++g) {
                    for (int32_t n = 0; n < N; ++n) {
                        out.SetValue((uint32_t)(g * N + n), colH.GetValue((uint32_t)(n * Gp64 + g)));
                    }
                }
                SetFlag<HardEvent::S_V>(svEvt);          
                WaitFlag<HardEvent::S_V>(svEvt);
                SetFlag<HardEvent::S_MTE3>(s3Evt);       
                WaitFlag<HardEvent::S_MTE3>(s3Evt);
                DataCopyExtParams exY{1, (uint32_t)(Gc * N * 2), 0, 0, 0};
                DataCopyPad(yGm[b0 * N], out, exY);      
                SetFlag<HardEvent::MTE3_S>(e3sEvt);
                mte3SPending = true;
            }
            }    
        }        
        
        
        if (mte3SPending) {
            WaitFlag<HardEvent::MTE3_S>(e3sEvt);
            mte3SPending = false;
        }
        return;
    }
}


























constexpr int32_t GMG_SKV_UB = 165888;
constexpr int32_t GMG_SKV_XB = 8192;

__global__ __aicore__ void gmg_skv_kernel(
    GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groupList, GM_ADDR y,
    GM_ADDR workspace, GM_ADDR cWs, GM_ADDR tilingGm,
    int64_t argA, int64_t argB)
{
    (void)workspace; (void)cWs; (void)tilingGm;
    if ASCEND_IS_AIV {
        const int32_t M = (int32_t)((uint64_t)argA >> 40);
        const int32_t K = (int32_t)((uint64_t)argA >> 26) & 0x3FFF;
        const int32_t N = (int32_t)((uint64_t)argA) & 0x3FFFFFF;
        const int32_t E = (int32_t)((uint64_t)argB >> 48);
        if (K < 1 || K > 16 || N < 32 || M < 1 || E < 1) { return; }    
        const int32_t bd = (int32_t)GetBlockNum();
        const int32_t bi = (int32_t)GetBlockIdx();
        if (bd < 1) { return; }
        const int64_t rowLo = (int64_t)M * bi / bd;
        const int64_t rowHi = (int64_t)M * (bi + 1) / bd;
        if (rowHi <= rowLo) { return; }

        
        int32_t nbCap = (GMG_SKV_UB - (GMG_SKV_XB + 1056)) / (5 * K + 18);
        nbCap = (nbCap / 32) * 32;
        if (nbCap < 32) { nbCap = 32; }
        const int32_t NB = (nbCap < N) ? nbCap : N;       
        const int32_t Np = ((NB + 31) / 32) * 32;         
        int32_t R = GMG_SKV_XB / K;                       
        if (R > 512) { R = 512; }
        if (R < 1) { R = 1; }

        __gm__ int8_t* xp = reinterpret_cast<__gm__ int8_t*>(x);
        __gm__ int8_t* wp = reinterpret_cast<__gm__ int8_t*>(weight);
        __gm__ float* sp = reinterpret_cast<__gm__ float*>(scale);
        GlobalTensor<half> yGm;
        yGm.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y), (int64_t)M * N);

        TPipe pipe;
        TQue<QuePosition::VECOUT, 2> oq;
        TBuf<TPosition::VECCALC> wIB, wFB, whB, zfB, tmB, scB, xB, glB;
        pipe.InitBuffer(oq, 2, (uint32_t)(Np * 2));
        pipe.InitBuffer(wIB, (uint32_t)(K * Np));
        pipe.InitBuffer(wFB, (uint32_t)(K * Np * 4));
        pipe.InitBuffer(whB, (uint32_t)(Np * 2));
        pipe.InitBuffer(zfB, (uint32_t)(Np * 4));
        pipe.InitBuffer(tmB, (uint32_t)(Np * 4));
        pipe.InitBuffer(scB, (uint32_t)(Np * 4));
        pipe.InitBuffer(xB, (uint32_t)GMG_SKV_XB);
        pipe.InitBuffer(glB, 1056u);
        auto wI = wIB.Get<int8_t>();
        auto wF = wFB.Get<float>();
        auto wh = whB.Get<half>();
        auto zf = zfB.Get<float>();
        auto tmp = tmB.Get<float>();
        auto sc = scB.Get<float>();
        auto xb = xB.Get<int8_t>();
        auto gl8 = glB.Get<int8_t>();

        event_t mvEvt = static_cast<event_t>(GetTPipePtr()->FetchEventID(HardEvent::MTE2_V));
        event_t msEvt = static_cast<event_t>(GetTPipePtr()->FetchEventID(HardEvent::MTE2_S));
        event_t smEvt = static_cast<event_t>(GetTPipePtr()->FetchEventID(HardEvent::S_MTE2));
        event_t vm2Evt = static_cast<event_t>(GetTPipePtr()->FetchEventID(HardEvent::V_MTE2));

        
        {
            GlobalTensor<int8_t> gGm;
            gGm.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(groupList), (int64_t)E * 8);
            DataCopyExtParams exG{1, (uint32_t)(E * 8), 0, 0, 0};
            DataCopyPadExtParams<int8_t> pdG{false, 0, 0, 0};
            DataCopyPad(gl8, gGm, exG, pdG);
            SetFlag<HardEvent::MTE2_S>(msEvt);
            WaitFlag<HardEvent::MTE2_S>(msEvt);
        }
        auto gl64 = gl8.ReinterpretCast<int64_t>();

        int64_t prev = 0;
        for (int32_t e = 0; e < E; ++e) {
            const int64_t eEnd = gl64.GetValue(e);
            const int64_t lo = (rowLo > prev) ? rowLo : prev;
            const int64_t hi = (rowHi < eEnd) ? rowHi : eEnd;
            prev = eEnd;
            if (hi <= lo) { continue; }
            for (int32_t n0 = 0; n0 < N; n0 += NB) {
                const int32_t nb = (N - n0 < NB) ? (N - n0) : NB;
                const int32_t nc = ((nb + 31) / 32) * 32;         
                
                SetFlag<HardEvent::V_MTE2>(vm2Evt);
                WaitFlag<HardEvent::V_MTE2>(vm2Evt);
                
                
                
                
                
                {
                    GlobalTensor<int8_t> wGm;
                    wGm.SetGlobalBuffer(wp + (int64_t)e * K * N + n0, (int64_t)K * N);
                    DataCopyPadExtParams<int8_t> pdW{false, 0, 0, 0};
                    if (nb == nc) {
                        DataCopyExtParams exW{(uint16_t)K, (uint32_t)nb, (uint32_t)(N - nb), 0, 0};
                        DataCopyPad(wI, wGm, exW, pdW);
                    } else {
                        
                        for (int32_t k = 0; k < K; ++k) {
                            GlobalTensor<int8_t> wr;
                            wr.SetGlobalBuffer(wp + (int64_t)(e * K + k) * N + n0, (int64_t)nb);
                            DataCopyExtParams ex1{1, (uint32_t)nb, 0, 0, 0};
                            DataCopyPad(wI[k * nc], wr, ex1, pdW);
                        }
                    }
                }
                
                {
                    GlobalTensor<float> sGm;
                    sGm.SetGlobalBuffer(sp + (int64_t)e * N + n0, (int64_t)nb);
                    DataCopyExtParams exS{1, (uint32_t)(nb * 4), 0, 0, 0};
                    DataCopyPadExtParams<float> pdS{false, 0, 0, 0.0f};
                    DataCopyPad(sc, sGm, exS, pdS);
                }
                
                SetFlag<HardEvent::MTE2_V>(mvEvt);
                WaitFlag<HardEvent::MTE2_V>(mvEvt);
                for (int32_t k = 0; k < K; ++k) {
                    Cast<half>(wh, wI[k * nc], RoundMode::CAST_NONE, nc);
                    PipeBarrier<PIPE_V>();
                    Cast<float>(wF[k * nc], wh, RoundMode::CAST_NONE, nc);
                    PipeBarrier<PIPE_V>();
                }

                
                for (int64_t b0 = lo; b0 < hi; b0 += R) {
                    const int32_t Rc = (int32_t)((hi - b0 < (int64_t)R) ? (hi - b0) : (int64_t)R);
                    
                    {
                        SetFlag<HardEvent::S_MTE2>(smEvt);       
                        WaitFlag<HardEvent::S_MTE2>(smEvt);
                        GlobalTensor<int8_t> xGm;
                        xGm.SetGlobalBuffer(xp + b0 * K, (int64_t)Rc * K);
                        DataCopyExtParams exX{1, (uint32_t)(Rc * K), 0, 0, 0};
                        DataCopyPadExtParams<int8_t> pdX{false, 0, 0, 0};
                        DataCopyPad(xb, xGm, exX, pdX);
                        SetFlag<HardEvent::MTE2_S>(msEvt);
                        WaitFlag<HardEvent::MTE2_S>(msEvt);
                    }
                    for (int32_t r = 0; r < Rc; ++r) {
                        const int32_t xo = r * K;
                        const float x0 = (float)((int32_t)xb.GetValue(xo));
                        Muls(zf, wF, x0, (int32_t)nc);
                        for (int32_t k = 1; k < K; ++k) {
                            const float xv = (float)((int32_t)xb.GetValue(xo + k));
                            Axpy(zf, wF[k * nc], xv, (int32_t)nc);
                        }
                        PipeBarrier<PIPE_V>();
                        
                        
                        
                        
                        Adds(zf, zf, 0.0f, (int32_t)nc);
                        PipeBarrier<PIPE_V>();
                        Mul(zf, zf, sc, (int32_t)nc);        
                        PipeBarrier<PIPE_V>();
                        
                        Mul(tmp, zf, zf, (int32_t)nc);
                        PipeBarrier<PIPE_V>();
                        Mul(tmp, zf, tmp, (int32_t)nc);
                        PipeBarrier<PIPE_V>();
                        Muls(tmp, tmp, GMG_GELU_BETA, (int32_t)nc);
                        PipeBarrier<PIPE_V>();
                        Add(tmp, zf, tmp, (int32_t)nc);
                        PipeBarrier<PIPE_V>();
                        Muls(tmp, tmp, GMG_GELU_ALPHA, (int32_t)nc);
                        PipeBarrier<PIPE_V>();
                        Exp(tmp, tmp, (int32_t)nc);
                        PipeBarrier<PIPE_V>();
                        Adds(tmp, tmp, 1.0f, (int32_t)nc);
                        PipeBarrier<PIPE_V>();
                        Div(zf, zf, tmp, (int32_t)nc);
                        PipeBarrier<PIPE_V>();

                        LocalTensor<half> ob = oq.AllocTensor<half>();
                        Cast<half>(ob, zf, RoundMode::CAST_RINT, (int32_t)nc);
                        oq.EnQue(ob);
                        ob = oq.DeQue<half>();
                        DataCopyExtParams exY{1, (uint16_t)(nb * 2), 0, 0, 0};
                        DataCopyPad(yGm[(b0 + r) * N + n0], ob, exY);
                        oq.FreeTensor(ob);
                    }
                }
            }
        }
        return;
    }
}












































constexpr int32_t GMG_NK16_UB = 165888;

__global__ __aicore__ void gmg_nk16_kernel(
    GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groupList, GM_ADDR y,
    GM_ADDR workspace, GM_ADDR cWs, GM_ADDR tilingGm,
    int64_t argA, int64_t argB)
{
    (void)workspace; (void)cWs; (void)tilingGm;
    if ASCEND_IS_AIV {
        const int32_t M = (int32_t)((uint64_t)argA >> 40);
        const int32_t K = (int32_t)((uint64_t)argA >> 26) & 0x3FFF;
        const int32_t N = (int32_t)((uint64_t)argA) & 0x3FFFFFF;
        const int32_t E = (int32_t)((uint64_t)argB >> 48);
        const int32_t baseN = (int32_t)((uint64_t)argB >> 16) & 0xFFFF;
        
        
        if (K < 1 || K > 16 || N < 9 || N > 64 || M < 1 || E < 1) { return; }
        
        
        
        
        
        
        
        
        
        
        
        const bool mixedChain = (baseN > 0) && (baseN < N) && ((N % baseN) != 0);
        const bool foldGelu = (baseN > 0) && ((N % baseN) == 0) && !mixedChain;
        const int32_t bd = (int32_t)GetBlockNum();
        const int32_t bi = (int32_t)GetBlockIdx();
        if (bd < 1) { return; }
        const int64_t rowLo = (int64_t)M * bi / bd;
        const int64_t rowHi = (int64_t)M * (bi + 1) / bd;
        if (rowHi <= rowLo) { return; }

        
        const int32_t nb = N;                             
        const int32_t nc = ((nb + 31) / 32) * 32;         
        const int32_t Np = nc;
        const int32_t pitchH = ((nb * 2 + 31) / 32) * 16;    
        
        
        const int32_t obPad = 8;
        const int32_t fixedB = 5 * K * Np + 14 * Np + 1056 + obPad * 2 * pitchH;
        int32_t R = (GMG_NK16_UB - fixedB - 2048) / (K + 2 * pitchH);
        if (R > 512) { R = 512; }
        if (R < 1) { R = 1; }

        __gm__ int8_t* xp = reinterpret_cast<__gm__ int8_t*>(x);
        __gm__ int8_t* wp = reinterpret_cast<__gm__ int8_t*>(weight);
        __gm__ float* sp = reinterpret_cast<__gm__ float*>(scale);
        GlobalTensor<half> yGm;
        yGm.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y), (int64_t)M * N);

        TPipe pipe;
        TBuf<TPosition::VECCALC> wIB, wFB, whB, zfB, tmB, scB, xB, glB, obB;
        pipe.InitBuffer(wIB, (uint32_t)(K * Np));
        pipe.InitBuffer(wFB, (uint32_t)(K * Np * 4));
        pipe.InitBuffer(whB, (uint32_t)(Np * 2));
        pipe.InitBuffer(zfB, (uint32_t)(Np * 4));
        pipe.InitBuffer(tmB, (uint32_t)(Np * 4));
        pipe.InitBuffer(scB, (uint32_t)(Np * 4));
        pipe.InitBuffer(xB, (uint32_t)(R * K));
        pipe.InitBuffer(obB, (uint32_t)((R + obPad) * pitchH * 2));
        pipe.InitBuffer(glB, 1056u);
        auto wI = wIB.Get<int8_t>();
        auto wF = wFB.Get<float>();
        auto wh = whB.Get<half>();
        auto zf = zfB.Get<float>();
        auto tmp = tmB.Get<float>();
        auto sc = scB.Get<float>();
        auto xb = xB.Get<int8_t>();
        auto ob = obB.Get<half>();
        auto gl8 = glB.Get<int8_t>();

        event_t mvEvt = static_cast<event_t>(GetTPipePtr()->FetchEventID(HardEvent::MTE2_V));
        event_t msEvt = static_cast<event_t>(GetTPipePtr()->FetchEventID(HardEvent::MTE2_S));
        event_t smEvt = static_cast<event_t>(GetTPipePtr()->FetchEventID(HardEvent::S_MTE2));
        event_t vm2Evt = static_cast<event_t>(GetTPipePtr()->FetchEventID(HardEvent::V_MTE2));
        event_t v3Evt = static_cast<event_t>(GetTPipePtr()->FetchEventID(HardEvent::V_MTE3));
        event_t m3vEvt = static_cast<event_t>(GetTPipePtr()->FetchEventID(HardEvent::MTE3_V));

        
        {
            GlobalTensor<int8_t> gGm;
            gGm.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(groupList), (int64_t)E * 8);
            DataCopyExtParams exG{1, (uint32_t)(E * 8), 0, 0, 0};
            DataCopyPadExtParams<int8_t> pdG{false, 0, 0, 0};
            DataCopyPad(gl8, gGm, exG, pdG);
            SetFlag<HardEvent::MTE2_S>(msEvt);
            WaitFlag<HardEvent::MTE2_S>(msEvt);
        }
        auto gl64 = gl8.ReinterpretCast<int64_t>();

        int64_t prev = 0;
        for (int32_t e = 0; e < E; ++e) {
            const int64_t eEnd = gl64.GetValue(e);
            const int64_t lo = (rowLo > prev) ? rowLo : prev;
            const int64_t hi = (rowHi < eEnd) ? rowHi : eEnd;
            prev = eEnd;
            if (hi <= lo) { continue; }

            
            SetFlag<HardEvent::V_MTE2>(vm2Evt);
            WaitFlag<HardEvent::V_MTE2>(vm2Evt);
            
            
            
            
            
            {
                GlobalTensor<int8_t> wGm;
                wGm.SetGlobalBuffer(wp + (int64_t)e * K * N, (int64_t)K * N);
                DataCopyPadExtParams<int8_t> pdW{false, 0, 0, 0};
                if (nb == nc) {
                    DataCopyExtParams exW{(uint16_t)K, (uint32_t)nb, 0, 0, 0};
                    DataCopyPad(wI, wGm, exW, pdW);
                } else {
                    for (int32_t k = 0; k < K; ++k) {
                        GlobalTensor<int8_t> wr;
                        wr.SetGlobalBuffer(wp + (int64_t)(e * K + k) * N, (int64_t)nb);
                        DataCopyExtParams ex1{1, (uint32_t)nb, 0, 0, 0};
                        DataCopyPad(wI[k * nc], wr, ex1, pdW);
                    }
                }
            }
            
            {
                GlobalTensor<float> sGm;
                sGm.SetGlobalBuffer(sp + (int64_t)e * N, (int64_t)nb);
                DataCopyExtParams exS{1, (uint32_t)(nb * 4), 0, 0, 0};
                DataCopyPadExtParams<float> pdS{false, 0, 0, 0.0f};
                DataCopyPad(sc, sGm, exS, pdS);
            }
            
            SetFlag<HardEvent::MTE2_V>(mvEvt);
            WaitFlag<HardEvent::MTE2_V>(mvEvt);
            for (int32_t k = 0; k < K; ++k) {
                Cast<half>(wh, wI[k * nc], RoundMode::CAST_NONE, nc);
                PipeBarrier<PIPE_V>();
                Cast<float>(wF[k * nc], wh, RoundMode::CAST_NONE, nc);
                PipeBarrier<PIPE_V>();
            }

            
            for (int64_t b0 = lo; b0 < hi; b0 += R) {
                const int32_t Rc = (int32_t)((hi - b0 < (int64_t)R) ? (hi - b0) : (int64_t)R);
                
                {
                    SetFlag<HardEvent::S_MTE2>(smEvt);       
                    WaitFlag<HardEvent::S_MTE2>(smEvt);
                    GlobalTensor<int8_t> xGm;
                    xGm.SetGlobalBuffer(xp + b0 * K, (int64_t)Rc * K);
                    DataCopyExtParams exX{1, (uint32_t)(Rc * K), 0, 0, 0};
                    DataCopyPadExtParams<int8_t> pdX{false, 0, 0, 0};
                    DataCopyPad(xb, xGm, exX, pdX);
                    SetFlag<HardEvent::MTE2_S>(msEvt);
                    WaitFlag<HardEvent::MTE2_S>(msEvt);
                }
                for (int32_t r = 0; r < Rc; ++r) {
                    const int32_t xo = r * K;
                    const float x0 = (float)((int32_t)xb.GetValue(xo));
                    Muls(zf, wF, x0, (int32_t)nc);
                    for (int32_t k = 1; k < K; ++k) {
                        const float xv = (float)((int32_t)xb.GetValue(xo + k));
                        Axpy(zf, wF[k * nc], xv, (int32_t)nc);
                    }
                    PipeBarrier<PIPE_V>();
                    
                    
                    
                    
                    Adds(zf, zf, 0.0f, (int32_t)nc);
                    PipeBarrier<PIPE_V>();
                    Mul(zf, zf, sc, (int32_t)nc);        
                    PipeBarrier<PIPE_V>();
                    if (foldGelu) {
                        
                        
                        Mul(tmp, zf, zf, (int32_t)nc);
                        PipeBarrier<PIPE_V>();
                        Muls(tmp, tmp, GMG_GELU_ALPHA_BETA, (int32_t)nc);
                        PipeBarrier<PIPE_V>();
                        Adds(tmp, tmp, GMG_GELU_ALPHA, (int32_t)nc);
                        PipeBarrier<PIPE_V>();
                        Mul(tmp, zf, tmp, (int32_t)nc);
                        PipeBarrier<PIPE_V>();
                        Exp(tmp, tmp, (int32_t)nc);
                        PipeBarrier<PIPE_V>();
                        Adds(tmp, tmp, 1.0f, (int32_t)nc);
                        PipeBarrier<PIPE_V>();
                        Div(zf, zf, tmp, (int32_t)nc);
                        PipeBarrier<PIPE_V>();
                    } else {
                        
                        Mul(tmp, zf, zf, (int32_t)nc);
                        PipeBarrier<PIPE_V>();
                        Mul(tmp, zf, tmp, (int32_t)nc);
                        PipeBarrier<PIPE_V>();
                        Muls(tmp, tmp, GMG_GELU_BETA, (int32_t)nc);
                        PipeBarrier<PIPE_V>();
                        Add(tmp, zf, tmp, (int32_t)nc);
                        PipeBarrier<PIPE_V>();
                        Muls(tmp, tmp, GMG_GELU_ALPHA, (int32_t)nc);
                        PipeBarrier<PIPE_V>();
                        Exp(tmp, tmp, (int32_t)nc);
                        PipeBarrier<PIPE_V>();
                        Adds(tmp, tmp, 1.0f, (int32_t)nc);
                        PipeBarrier<PIPE_V>();
                        Div(zf, zf, tmp, (int32_t)nc);
                        PipeBarrier<PIPE_V>();
                    }
                    
                    Cast<half>(ob[r * pitchH], zf, RoundMode::CAST_RINT, (int32_t)nc);
                    PipeBarrier<PIPE_V>();
                }
                
                
                
                SetFlag<HardEvent::V_MTE3>(v3Evt);
                WaitFlag<HardEvent::V_MTE3>(v3Evt);
                {
                    DataCopyExtParams exY{(uint16_t)Rc, (uint32_t)(nb * 2), 0, 0, 0};
                    DataCopyPad(yGm[b0 * N], ob, exY);
                }
                SetFlag<HardEvent::MTE3_V>(m3vEvt);
                WaitFlag<HardEvent::MTE3_V>(m3vEvt);
            }
        }
        return;
    }
}



















struct GmgTGroups {
    int64_t ends[GMG_MAX_E];       
    int64_t rowBase[GMG_MAX_E];    
    int64_t tileCum[GMG_MAX_E + 1];
    int64_t nTiles;                
    int64_t total;                 
};

template <bool GCHUNK>
__aicore__ inline void GmgTDecode(const GmgTiling& t, const GmgTGroups& g,
                                                    int64_t blk, GmgTileCoord* c)
{
    
    
    int32_t eLo = 0, eHi = t.E - 1;
    while (eLo < eHi) {
        const int32_t eMid = (eLo + eHi + 1) >> 1;
        if (g.tileCum[eMid] <= blk) { eLo = eMid; } else { eHi = eMid - 1; }
    }
    const int32_t e = eLo;
    const int64_t local = blk - g.tileCum[e];
    
    
    const int64_t mTile = local / g.nTiles;
    const int64_t nTile = local % g.nTiles;
    const int64_t me = g.ends[e] - g.rowBase[e];
    const int64_t m0 = mTile * t.baseM;
    
    const int64_t n0 = GCHUNK ? nTile * (int64_t)t.gchunk * t.baseN : nTile * t.baseN;

    c->e = e;
    c->realM = (int32_t)(t.baseM < me - m0 ? t.baseM : me - m0);    
    if (GCHUNK && t.gchunk > 1) {
        const int64_t gN = (int64_t)t.gchunk * t.baseN;
        c->realN = (int32_t)(gN < t.N - n0 ? gN : t.N - n0);
        c->aOff = (g.rowBase[e] + m0) * t.K;
        c->sOff = (int64_t)e * t.N + n0;
        c->yOff = (g.rowBase[e] + m0) * t.N + n0;
    } else {
        c->realN = (int32_t)(t.baseN < t.N - n0 ? t.baseN : t.N - n0);
        c->aOff = (g.rowBase[e] + m0) * t.K;
        c->sOff = (int64_t)e * t.N + n0;
        c->yOff = (g.rowBase[e] + m0) * t.N + n0;
    }
    c->bOff = (int64_t)e * t.K * t.N + n0;
}


struct GmgTVecCtx {
    TQue<QuePosition::VECIN, 1>* accQue;     
    TQue<QuePosition::VECIN, 1>* scQue;      
    TQue<QuePosition::VECOUT, 1>* outQue;    
    LocalTensor<float> zf;                    
    LocalTensor<float> tmp;                   
    int32_t aN8w;
    int32_t cStride;                          
    
    TQue<QuePosition::VECIN, 2>* bAccQue;    
    TQue<QuePosition::VECOUT, 1>* bOutQue;    
    LocalTensor<float> bZf;                   
    LocalTensor<float> bTmp;                  
    int32_t chRows;                           
};






__aicore__ inline void GmgTEpilogueBatch(GmgTVecCtx& vc, const GmgTiling& t,
                                        GlobalTensor<int32_t>& cGm,
                                        GlobalTensor<half>& yGm, LocalTensor<float>& scUb,
                                        int64_t slotBase, const GmgTileCoord& c,
                                        int32_t rBeg, int32_t rEnd)
{
    const int32_t aN8 = vc.aN8w;              
    
    int32_t r0 = rBeg;
    while (r0 < rEnd) {
        int32_t nFly = 0;
        int32_t flyR[2];
        int64_t flyR0[2];
        while (nFly < 2 && r0 < rEnd) {           
            const int32_t rem = rEnd - r0;
            const int32_t R = rem < vc.chRows ? rem : vc.chRows;
            LocalTensor<int32_t> pre = vc.bAccQue->AllocTensor<int32_t>();
            DataCopyExtParams extC{static_cast<uint16_t>(R), static_cast<uint16_t>(aN8 * 4),
                                   static_cast<uint16_t>((vc.cStride - aN8) * 4), 0, 0};
            DataCopyPadExtParams<int32_t> padC{false, 0, 0, 0};
            DataCopyPad(pre, cGm[slotBase + (int64_t)r0 * vc.cStride], extC, padC);
            vc.bAccQue->EnQue(pre);
            flyR[nFly] = R;
            flyR0[nFly] = r0;
            r0 += R;
            ++nFly;
        }
        for (int32_t k = 0; k < nFly; ++k) {
            const int32_t R = flyR[k];
            const int64_t cr0 = flyR0[k];
            const int32_t nEl = R * aN8;
            LocalTensor<int32_t> acc = vc.bAccQue->DeQue<int32_t>();    

            Cast<float>(vc.bZf, acc, RoundMode::CAST_RINT, nEl);    
            PipeBarrier<PIPE_V>();
            vc.bAccQue->FreeTensor(acc);

            for (int32_t b = 0; b < aN8; b += 64) {   
                
                
                
                
                const int32_t w = (aN8 - b) < 64 ? (aN8 - b) : 64;
                BinaryRepeatParams bp(1, 1, 1, (uint8_t)(aN8 / 8), (uint8_t)(aN8 / 8), 0);
                Mul(vc.bZf[b], vc.bZf[b], scUb[b], (uint64_t)w, (uint8_t)R, bp);
            }
            PipeBarrier<PIPE_V>();

            Mul(vc.bTmp, vc.bZf, vc.bZf, nEl);        
            PipeBarrier<PIPE_V>();
            Mul(vc.bTmp, vc.bZf, vc.bTmp, nEl);       
            PipeBarrier<PIPE_V>();
            Muls(vc.bTmp, vc.bTmp, GMG_GELU_BETA, nEl);
            PipeBarrier<PIPE_V>();
            Add(vc.bTmp, vc.bZf, vc.bTmp, nEl);       
            PipeBarrier<PIPE_V>();
            Muls(vc.bTmp, vc.bTmp, GMG_GELU_ALPHA, nEl);
            PipeBarrier<PIPE_V>();
            Exp(vc.bTmp, vc.bTmp, nEl);               
            PipeBarrier<PIPE_V>();
            Adds(vc.bTmp, vc.bTmp, 1.0f, nEl);
            PipeBarrier<PIPE_V>();
            Div(vc.bZf, vc.bZf, vc.bTmp, nEl);        
            PipeBarrier<PIPE_V>();

            LocalTensor<half> out = vc.bOutQue->AllocTensor<half>();
            Cast<half>(out, vc.bZf, RoundMode::CAST_RINT, nEl);     
            vc.bOutQue->EnQue(out);
            out = vc.bOutQue->DeQue<half>();          
            DataCopyExtParams extY{static_cast<uint16_t>(R), static_cast<uint16_t>(c.realN * 2), 0,
                                   static_cast<uint16_t>((t.N - c.realN) * 2), 0};
            DataCopyPad(yGm[c.yOff + cr0 * t.N], out, extY);
            vc.bOutQue->FreeTensor(out);
        }
    }
}

__aicore__ inline void GmgTEpilogueTail(GmgTVecCtx& vc, const GmgTiling& t,
                                        GlobalTensor<int32_t>& cGm,
                                        GlobalTensor<half>& yGm, LocalTensor<float>& scUb,
                                        int64_t slotBase, const GmgTileCoord& c,
                                        int32_t rBeg, int32_t rEnd)
{
    
    
    
    
    
    
    
    
    
    
    
    
    
    const int32_t aN8  = GmgAlignUp(c.realN, 8);
    const int32_t aN16 = GmgAlignUp(c.realN, 16);
    
    
    
    const bool fast2D  = (aN16 <= vc.aN8w) && (aN16 <= vc.cStride) && (aN16 <= 2040);
    const int32_t pit  = fast2D ? aN16 : aN8;    
    
    
    if (pit > aN8) { Duplicate<float>(scUb[aN8], 0.0f, pit - aN8); PipeBarrier<PIPE_V>(); }
    
    int32_t r0 = rBeg;
    while (r0 < rEnd) {
        int32_t nFly = 0;
        int32_t flyR[2];
        int64_t flyR0[2];
        while (nFly < 2 && r0 < rEnd) {           
            const int32_t rem = rEnd - r0;
            const int32_t R = rem < vc.chRows ? rem : vc.chRows;
            LocalTensor<int32_t> pre = vc.bAccQue->AllocTensor<int32_t>();
            
            
            DataCopyExtParams extC{static_cast<uint16_t>(R), static_cast<uint16_t>(pit * 4),
                                   static_cast<uint16_t>((vc.cStride - pit) * 4), 0, 0};
            DataCopyPadExtParams<int32_t> padC{false, 0, 0, 0};
            DataCopyPad(pre, cGm[slotBase + (int64_t)r0 * vc.cStride], extC, padC);
            vc.bAccQue->EnQue(pre);
            flyR[nFly] = R;
            flyR0[nFly] = r0;
            r0 += R;
            ++nFly;
        }
        for (int32_t k = 0; k < nFly; ++k) {
            const int32_t R = flyR[k];
            const int64_t cr0 = flyR0[k];
            const int32_t nEl = R * pit;
            LocalTensor<int32_t> acc = vc.bAccQue->DeQue<int32_t>();    

            Cast<float>(vc.bZf, acc, RoundMode::CAST_RINT, nEl);    
            PipeBarrier<PIPE_V>();
            vc.bAccQue->FreeTensor(acc);

            for (int32_t rr = 0; rr < R; ++rr) {    
                Mul(vc.bZf[rr * pit], vc.bZf[rr * pit], scUb, pit);    
            }                                                         
            PipeBarrier<PIPE_V>();

            Mul(vc.bTmp, vc.bZf, vc.bZf, nEl);        
            PipeBarrier<PIPE_V>();
            Mul(vc.bTmp, vc.bZf, vc.bTmp, nEl);       
            PipeBarrier<PIPE_V>();
            Muls(vc.bTmp, vc.bTmp, GMG_GELU_BETA, nEl);
            PipeBarrier<PIPE_V>();
            Add(vc.bTmp, vc.bZf, vc.bTmp, nEl);       
            PipeBarrier<PIPE_V>();
            Muls(vc.bTmp, vc.bTmp, GMG_GELU_ALPHA, nEl);
            PipeBarrier<PIPE_V>();
            Exp(vc.bTmp, vc.bTmp, nEl);               
            PipeBarrier<PIPE_V>();
            Adds(vc.bTmp, vc.bTmp, 1.0f, nEl);
            PipeBarrier<PIPE_V>();
            Div(vc.bZf, vc.bZf, vc.bTmp, nEl);        
            PipeBarrier<PIPE_V>();

            
            
            
            
            
            if (fast2D) {
                
                
                
                LocalTensor<half> out = vc.bOutQue->AllocTensor<half>();
                Cast<half>(out, vc.bZf, RoundMode::CAST_RINT, nEl);    
                vc.bOutQue->EnQue(out);
                out = vc.bOutQue->DeQue<half>();
                DataCopyExtParams extY{(uint16_t)R, (uint32_t)(c.realN * 2), 0,
                                       (uint32_t)((t.N - c.realN) * 2), 0};
                DataCopyPad(yGm[c.yOff + cr0 * t.N], out, extY);
                vc.bOutQue->FreeTensor(out);
            } else {
            for (int32_t rr = 0; rr < R; ++rr) {
                LocalTensor<half> out = vc.bOutQue->AllocTensor<half>();
                Cast<half>(out, vc.bZf[rr * aN8], RoundMode::CAST_RINT, aN8);    
                vc.bOutQue->EnQue(out);
                out = vc.bOutQue->DeQue<half>();
                DataCopyExtParams extY{1, (uint16_t)(c.realN * 2), 0, 0, 0};
                DataCopyPad(yGm[c.yOff + (cr0 + rr) * t.N], out, extY);
                vc.bOutQue->FreeTensor(out);
            }
            }
        }
    }
}




__aicore__ inline void GmgTEpilogue(GmgTVecCtx& vc, const GmgTiling& t,
                                   GlobalTensor<int32_t>& cGm, GlobalTensor<float>& scaleGm,
                                   GlobalTensor<half>& yGm,
                                   int64_t slotBase, const GmgTileCoord& c,
                                   int32_t rBeg, int32_t rEnd)
{
    const int32_t aN8 = GmgAlignUp(c.realN, 8);    

    
    {
        LocalTensor<float> sc = vc.scQue->AllocTensor<float>();
        DataCopyExtParams extS{1, (uint32_t)(c.realN * 4), 0, 0, 0};
        DataCopyPadExtParams<float> padS{true, 0, (uint8_t)(aN8 - c.realN), 0.0f};
        DataCopyPad(sc, scaleGm[c.sOff], extS, padS);
        vc.scQue->EnQue(sc);
    }
    LocalTensor<float> scUb = vc.scQue->DeQue<float>();

    
    if (vc.chRows > 0 && c.realN == t.baseN && aN8 >= 8) {    
        
        
        GmgTEpilogueBatch(vc, t, cGm, yGm, scUb, slotBase, c, rBeg, rEnd);
        vc.scQue->FreeTensor(scUb);
        return;
    }
    if (vc.chRows > 0 && aN8 >= 8) {
        
        
        
        
        
        
        
        
        
        
        GmgTEpilogueTail(vc, t, cGm, yGm, scUb, slotBase, c, rBeg, rEnd);
        vc.scQue->FreeTensor(scUb);
        return;
    }

    
    for (int32_t r = rBeg; r < rEnd; ++r) {
        LocalTensor<int32_t> acc = vc.accQue->AllocTensor<int32_t>();
        DataCopyExtParams extC{1, (uint32_t)(c.realN * 4), 0, 0, 0};
        DataCopyPadExtParams<int32_t> padC{true, 0, (uint8_t)(aN8 - c.realN), 0};
        DataCopyPad(acc, cGm[slotBase + (int64_t)r * vc.cStride], extC, padC);   
        vc.accQue->EnQue(acc);
        acc = vc.accQue->DeQue<int32_t>();        

        Cast<float>(vc.zf, acc, RoundMode::CAST_RINT, aN8);    
        PipeBarrier<PIPE_V>();
        vc.accQue->FreeTensor(acc);

        Mul(vc.zf, vc.zf, scUb, aN8);             
        PipeBarrier<PIPE_V>();

        Mul(vc.tmp, vc.zf, vc.zf, aN8);           
        PipeBarrier<PIPE_V>();
        Mul(vc.tmp, vc.zf, vc.tmp, aN8);          
        PipeBarrier<PIPE_V>();
        Muls(vc.tmp, vc.tmp, GMG_GELU_BETA, aN8);
        PipeBarrier<PIPE_V>();
        Add(vc.tmp, vc.zf, vc.tmp, aN8);          
        PipeBarrier<PIPE_V>();
        Muls(vc.tmp, vc.tmp, GMG_GELU_ALPHA, aN8);
        PipeBarrier<PIPE_V>();
        Exp(vc.tmp, vc.tmp, aN8);                 
        PipeBarrier<PIPE_V>();
        Adds(vc.tmp, vc.tmp, 1.0f, aN8);
        PipeBarrier<PIPE_V>();
        Div(vc.zf, vc.zf, vc.tmp, aN8);           
        PipeBarrier<PIPE_V>();

        LocalTensor<half> out = vc.outQue->AllocTensor<half>();
        Cast<half>(out, vc.zf, RoundMode::CAST_RINT, aN8);     
        vc.outQue->EnQue(out);
        out = vc.outQue->DeQue<half>();           
        DataCopyExtParams extY{1, (uint32_t)(c.realN * 2), 0, 0, 0};
        DataCopyPad(yGm[c.yOff + (int64_t)r * t.N], out, extY);
        vc.outQue->FreeTensor(out);
    }
    vc.scQue->FreeTensor(scUb);
}

__global__ __aicore__ __mix__(1, 2) void gmg_smalltail_kernel(
    GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groupList, GM_ADDR y,
    GM_ADDR workspace, GM_ADDR cWs, GM_ADDR tilingGm,
    int64_t argA, int64_t argB)    
{
    (void)workspace;
    GmgTiling t;
    t.M = (int32_t)((uint64_t)argA >> 40);
    t.K = (int32_t)((uint64_t)argA >> 26) & 0x3FFF;
    t.N = (int32_t)((uint64_t)argA) & 0x3FFFFFF;
    t.E = (int32_t)((uint64_t)argB >> 48);
    t.baseM = (int32_t)((uint64_t)argB >> 32) & 0xFFFF;
    t.baseN = (int32_t)((uint64_t)argB >> 16) & 0xFFFF;
    t.coreNum = 0; t.aivTotal = 0;
    t.rsv0 = (int32_t)((uint64_t)argB & 0xFFFF);
    t.gchunk = 1;                        
    t.rsv1 = 0; t.rsv2 = 0;

    GlobalTensor<int8_t> xGm;
    GlobalTensor<int8_t> wGm;
    GlobalTensor<float> scaleGm;
    GlobalTensor<half> yGm;
    GlobalTensor<int32_t> cGm;
    xGm.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x), (int64_t)t.M * t.K);
    wGm.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(weight), (int64_t)t.E * t.K * t.N);
    scaleGm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scale), (int64_t)t.E * t.N);
    yGm.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y), (int64_t)t.M * t.N);

    using AType = MatmulType<TPosition::GM, CubeFormat::ND, int8_t>;
    using BType = MatmulType<TPosition::GM, CubeFormat::ND, int8_t>;
    using CType = MatmulType<TPosition::GM, CubeFormat::ND, int32_t>;

    const int64_t coreNum = GetBlockNum();
    const int32_t cStride = GmgCStride(t.N, t.baseN);
    const int64_t slotStride = (int64_t)t.baseM * cStride;

    if ASCEND_IS_AIC {
        cGm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(cWs),
                            coreNum * GMG_NUM_SLOTS * slotStride);    
        TPipe pipe;
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        Matmul<AType, BType, CType, CType, GMG_MM_CFG> mm;
        REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), mm,
                          reinterpret_cast<__gm__ AscendC::tiling::TCubeTiling*>(tilingGm));
        
        
        
        if (cStride != t.N) { mm.SetOrgShape(t.M, t.N, t.K, t.K, cStride); }
        const int64_t aicIdx = GetBlockIdx();
        
        const int64_t slotBase0 = aicIdx * GMG_NUM_SLOTS * slotStride;
        const __gm__ int64_t* hpfxTb = reinterpret_cast<const __gm__ int64_t*>(
            tilingGm + ((sizeof(GmgTiling) + 511) / 512) * 512);    
        const int64_t hpfxBeg = hpfxTb[aicIdx];
        const int64_t hpfxEnd = hpfxTb[aicIdx + 1];
        int32_t lastM = -1;                       
        int32_t lastN = -1;                       
        int64_t seq = 0;
        for (int64_t j = hpfxBeg; j < hpfxEnd; j += 5, ++seq) {    
            const __gm__ int64_t* en = hpfxTb + j;
            GmgTileCoord c;
            const int64_t mr = en[0];             
            c.realM = (int32_t)((uint64_t)mr >> 32);
            c.realN = (int32_t)mr;
            c.aOff = en[1];
            c.bOff = en[2];
            if (seq >= GMG_NUM_SLOTS) {
                CrossCoreWaitFlag<0x2>(GMG_FLAG_V2C);    
            }
            int32_t shapeN = GmgPadWidth(c.realN);
            if (shapeN > t.baseN) { shapeN = t.baseN; }
            if (c.realM != lastM || shapeN != lastN) {    
                mm.SetSingleShape(c.realM, shapeN, t.K);
                lastM = c.realM;
                lastN = shapeN;
            }
            mm.SetTensorA(xGm[c.aOff]);
            mm.SetTensorB(wGm[c.bOff]);
            while (mm.Iterate()) { mm.GetTensorC(cGm[slotBase0 + (seq % GMG_NUM_SLOTS) * slotStride]); }    
            CrossCoreSetFlag<0x2, PIPE_FIX>(GMG_FLAG_C2V);
        }
        mm.End();
        return;
    }

    if ASCEND_IS_AIV {
        cGm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(cWs),
                            coreNum * GMG_NUM_SLOTS * slotStride);    
        TPipe pipe;
        const int64_t gid = GetBlockIdx();
        const int64_t aicIdx = gid / 2;
        const int64_t sub = gid % 2;
        const int64_t slotBase0 = aicIdx * GMG_NUM_SLOTS * slotStride;    

        GmgTGroups g;
        {
            
            
            TQue<QuePosition::VECIN, 1> glQue;
            pipe.InitBuffer(glQue, 1, (uint32_t)t.E * 8 + 64);
            LocalTensor<int64_t> gl = glQue.AllocTensor<int64_t>();
            DataCopyExtParams extG{1, (uint32_t)(t.E * 8), 0, 0, 0};
            DataCopyPadExtParams<int64_t> padG{true, 0, 0, 0};
            GlobalTensor<int64_t> glGm;
            glGm.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groupList), t.E);
            DataCopyPad(gl, glGm, extG, padG);
            glQue.EnQue(gl);
            gl = glQue.DeQue<int64_t>();
            int64_t prevEnd = 0;
            int64_t total = 0;
            g.nTiles = ((int64_t)t.N + t.baseN - 1) / t.baseN;
            for (int32_t e = 0; e < t.E; ++e) {
                const int64_t end = gl.GetValue(e);
                g.ends[e] = end;
                g.rowBase[e] = prevEnd;
                g.tileCum[e] = total;
                const int64_t rows = end - prevEnd;
                if (rows > 0) {
                    total += ((rows + t.baseM - 1) / t.baseM) * g.nTiles;
                }
                prevEnd = end;
            }
            g.tileCum[t.E] = total;
            g.total = total;
            glQue.FreeTensor(gl);
        }

        
        
        
        
        
        
        
        
        const int32_t aN8w = GmgAlignUp(t.baseN < t.N ? t.baseN : t.N, 16);
        TQue<QuePosition::VECIN, 1> accQue;
        TQue<QuePosition::VECIN, 1> scQue;
        TQue<QuePosition::VECOUT, 1> outQue;
        TBuf<TPosition::VECCALC> zfBuf;
        TBuf<TPosition::VECCALC> tmpBuf;
        pipe.InitBuffer(accQue, 1, (uint32_t)aN8w * 4);
        pipe.InitBuffer(outQue, 1, (uint32_t)aN8w * 2);
        pipe.InitBuffer(scQue, 1, (uint32_t)aN8w * 4);
        pipe.InitBuffer(zfBuf, (uint32_t)aN8w * 4);
        pipe.InitBuffer(tmpBuf, (uint32_t)aN8w * 4);

        
        TQue<QuePosition::VECIN, 2> bAccQue;
        TQue<QuePosition::VECOUT, 1> bOutQue;
        TBuf<TPosition::VECCALC> bZfBuf;
        TBuf<TPosition::VECCALC> bTmpBuf;
        int32_t chRows = 0;
        
        
        
        
        
        
        
        
        const int32_t perRow = (aN8w >= 512) ? 18 : 14;
        if (aN8w >= 8 && aN8w <= 2040) {    
            const int32_t budget = GMG_UB_BUDGET - aN8w * 18 - t.E * 8 - 256;
            chRows = budget / (aN8w * perRow);
            if (chRows > GMG_BATCH_ROWS) { chRows = GMG_BATCH_ROWS; }
            if (chRows < 8) { chRows = 0; }
        }
        if (chRows > 0) {
            pipe.InitBuffer(bAccQue, 2, (uint32_t)chRows * aN8w * 4);    
            pipe.InitBuffer(bOutQue, 1, (uint32_t)chRows * aN8w * 2);
            pipe.InitBuffer(bZfBuf, (uint32_t)chRows * aN8w * 4);
            pipe.InitBuffer(bTmpBuf, (uint32_t)chRows * aN8w * 4);
        }

        GmgTVecCtx vc;
        vc.accQue = &accQue;
        vc.scQue = &scQue;
        vc.outQue = &outQue;
        vc.zf = zfBuf.Get<float>();
        vc.tmp = tmpBuf.Get<float>();
        vc.aN8w = aN8w;
        vc.cStride = cStride;
        vc.bAccQue = &bAccQue;
        vc.bOutQue = &bOutQue;
        if (chRows > 0) {    
            vc.bZf = bZfBuf.Get<float>();    
            vc.bTmp = bTmpBuf.Get<float>();
        }
        vc.chRows = chRows;

        int64_t seq = 0;
        
        
        
        const __gm__ int64_t* hpfxTbA = reinterpret_cast<const __gm__ int64_t*>(
            tilingGm + ((sizeof(GmgTiling) + 511) / 512) * 512);    
        const int64_t hBegA = hpfxTbA[aicIdx];
        const int64_t hEndA = hpfxTbA[aicIdx + 1];
        for (int64_t j = hBegA; j < hEndA; j += 5, ++seq) {
            const __gm__ int64_t* en = hpfxTbA + j;
            const int64_t mr = en[0];
            GmgTileCoord c;
            c.realM = (int32_t)((uint64_t)mr >> 32);
            c.realN = (int32_t)mr;
            c.aOff = en[1];
            c.bOff = en[2];
            c.sOff = en[3];
            c.yOff = en[4];
            CrossCoreWaitFlag<0x2>(GMG_FLAG_C2V);
            const int32_t half = (c.realM + 1) / 2;
            const int32_t rBeg = (sub == 0) ? 0 : half;
            const int32_t rEnd = (sub == 0) ? half : c.realM;
            GmgTEpilogue(vc, t, cGm, scaleGm, yGm,
                        slotBase0 + (seq % GMG_NUM_SLOTS) * slotStride, c, rBeg, rEnd);
            CrossCoreSetFlag<0x2, PIPE_MTE2>(GMG_FLAG_V2C);
        }
        return;
    }
}













__global__ __aicore__ __mix__(1, 2) void gmg_lpt6_kernel(
    GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groupList, GM_ADDR y,
    GM_ADDR workspace, GM_ADDR cWs, GM_ADDR tilingGm,
    int64_t argA, int64_t argB)
{
    (void)workspace; (void)groupList;    
    GmgTiling t;
    t.M = (int32_t)((uint64_t)argA >> 40);
    t.K = (int32_t)((uint64_t)argA >> 26) & 0x3FFF;
    t.N = (int32_t)((uint64_t)argA) & 0x3FFFFFF;
    t.E = (int32_t)((uint64_t)argB >> 48);
    t.baseM = (int32_t)((uint64_t)argB >> 32) & 0xFFFF;
    t.baseN = (int32_t)((uint64_t)argB >> 16) & 0xFFFF;
    t.coreNum = 0; t.aivTotal = 0;
    t.rsv0 = (int32_t)((uint64_t)argB & 0xFFFF);
    t.gchunk = (t.rsv0 >= 1 && t.rsv0 <= 4) ? t.rsv0 : 1;
    t.rsv1 = 0; t.rsv2 = 0;

    GlobalTensor<int8_t> xGm;
    GlobalTensor<int8_t> wGm;
    GlobalTensor<float> scaleGm;
    GlobalTensor<half> yGm;
    GlobalTensor<int32_t> cGm;
    xGm.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x), (int64_t)t.M * t.K);
    wGm.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(weight), (int64_t)t.E * t.K * t.N);
    scaleGm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scale), (int64_t)t.E * t.N);
    yGm.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y), (int64_t)t.M * t.N);

    using AType = MatmulType<TPosition::GM, CubeFormat::ND, int8_t>;
    using BType = MatmulType<TPosition::GM, CubeFormat::ND, int8_t>;
    using CType = MatmulType<TPosition::GM, CubeFormat::ND, int32_t>;

    const int64_t coreNum = GetBlockNum();
    const int32_t cStride = GmgCStrideG(t.N, t.baseN, t.gchunk);
    const int64_t slotStride = (int64_t)t.baseM * cStride;
    const __gm__ int64_t* tb = reinterpret_cast<const __gm__ int64_t*>(
        tilingGm + ((sizeof(GmgTiling) + 511) / 512) * 512);

    if ASCEND_IS_AIC {
        cGm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(cWs),
                            coreNum * GMG_NUM_SLOTS * slotStride);
        TPipe pipe;
        Matmul<AType, BType, CType, CType, GMG_MM_CFG> mm;
        REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), mm,
                          reinterpret_cast<__gm__ AscendC::tiling::TCubeTiling*>(tilingGm));
        if (cStride != t.N) { mm.SetOrgShape(t.M, t.N, t.K, t.K, cStride); }
        const int64_t aicIdx = GetBlockIdx();
        const int64_t slotBase0 = aicIdx * GMG_NUM_SLOTS * slotStride;
        const int64_t beg = tb[aicIdx];
        const int64_t end = tb[aicIdx + 1];
        int32_t lastM = -1, lastN = -1;
        int64_t seq = 0;
        for (int64_t j = beg; j < end; j += 3, ++seq) {
            GmgTileCoord c;
            const int64_t mr = tb[j];
            c.realM = (int32_t)((uint64_t)mr >> 32);
            c.realN = (int32_t)mr;
            c.aOff = tb[j + 1];
            c.bOff = tb[j + 2];
            if (seq >= GMG_NUM_SLOTS) { CrossCoreWaitFlag<0x2>(GMG_FLAG_V2C); }
            int32_t shapeN = GmgPadWidth(c.realN);
            if (c.realM != lastM || shapeN != lastN) {
                mm.SetSingleShape(c.realM, shapeN, t.K);
                lastM = c.realM; lastN = shapeN;
            }
            mm.SetTensorA(xGm[c.aOff]);
            mm.SetTensorB(wGm[c.bOff]);
            while (mm.Iterate()) { mm.GetTensorC(cGm[slotBase0 + (seq % GMG_NUM_SLOTS) * slotStride]); }
            CrossCoreSetFlag<0x2, PIPE_FIX>(GMG_FLAG_C2V);
        }
        mm.End();
        return;
    }

    if ASCEND_IS_AIV {
        cGm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(cWs),
                            coreNum * GMG_NUM_SLOTS * slotStride);
        TPipe pipe;
        const int64_t gid = GetBlockIdx();
        const int64_t aicIdx = gid / 2;
        const int64_t sub = gid % 2;
        const int64_t slotBase0 = aicIdx * GMG_NUM_SLOTS * slotStride;

        
        
        
        
        
        
        
        
        const int32_t aN8w = GmgAlignUp(t.baseN < t.N ? t.baseN : t.N, 16);
        TQue<QuePosition::VECIN, 1> accQue;
        TQue<QuePosition::VECIN, 1> scQue;
        TQue<QuePosition::VECOUT, 1> outQue;
        TBuf<TPosition::VECCALC> zfBuf;
        TBuf<TPosition::VECCALC> tmpBuf;
        pipe.InitBuffer(accQue, 1, (uint32_t)aN8w * 4);
        pipe.InitBuffer(outQue, 1, (uint32_t)aN8w * 2);
        pipe.InitBuffer(scQue, 1, (uint32_t)aN8w * 4);
        pipe.InitBuffer(zfBuf, (uint32_t)aN8w * 4);
        pipe.InitBuffer(tmpBuf, (uint32_t)aN8w * 4);

        TQue<QuePosition::VECIN, 2> bAccQue;
        TQue<QuePosition::VECOUT, 1> bOutQue;
        TBuf<TPosition::VECCALC> bZfBuf;
        TBuf<TPosition::VECCALC> bTmpBuf;
        int32_t chRows = 0;
        if (aN8w >= 8 && aN8w <= 2040) {
            const int32_t budget = GMG_UB_BUDGET - aN8w * 18 - t.E * 8 - 256;
            chRows = budget / (aN8w * 14);
            if (chRows > GMG_BATCH_ROWS) { chRows = GMG_BATCH_ROWS; }
            if (chRows < 8) { chRows = 0; }
        }
        if (chRows > 0) {
            pipe.InitBuffer(bAccQue, 2, (uint32_t)chRows * aN8w * 4);
            pipe.InitBuffer(bOutQue, 1, (uint32_t)chRows * aN8w * 2);
            pipe.InitBuffer(bZfBuf, (uint32_t)chRows * aN8w * 4);
            pipe.InitBuffer(bTmpBuf, (uint32_t)chRows * aN8w * 4);
        }

        GmgVecCtx vc;
        vc.accQue = &accQue;
        vc.scQue = &scQue;
        vc.outQue = &outQue;
        vc.zf = zfBuf.Get<float>();
        vc.tmp = tmpBuf.Get<float>();
        vc.aN8w = aN8w;
        vc.cStride = cStride;
        vc.bAccQue = &bAccQue;
        vc.bOutQue = &bOutQue;
        if (chRows > 0) {
            vc.bZf = bZfBuf.Get<float>();
            vc.bTmp = bTmpBuf.Get<float>();
        }
        vc.chRows = chRows;

        const int64_t beg = tb[aicIdx];
        const int64_t end = tb[aicIdx + 1];
        int64_t seq = 0;
        for (int64_t j = beg; j < end; j += 3, ++seq) {
            GmgTileCoord c;
            const int64_t mr = tb[j];
            c.realM = (int32_t)((uint64_t)mr >> 32);
            c.realN = (int32_t)mr;
            c.aOff = tb[j + 1];
            c.bOff = tb[j + 2];
            const int64_t rowBase = c.aOff / t.K;
            const int64_t kn = (int64_t)t.K * t.N;
            const int64_t eIdx = c.bOff / kn;
            const int64_t n0Base = c.bOff - eIdx * kn;
            c.e = (int32_t)eIdx;
            c.sOff = eIdx * t.N + n0Base;
            c.yOff = rowBase * t.N + n0Base;
            CrossCoreWaitFlag<0x2>(GMG_FLAG_C2V);
            const int32_t half = (c.realM + 1) / 2;
            const int32_t rBeg = (sub == 0) ? 0 : half;
            const int32_t rEnd = (sub == 0) ? half : c.realM;
            const int64_t tSlot = slotBase0 + (seq % GMG_NUM_SLOTS) * slotStride;
            const int32_t nB = (c.realN + t.baseN - 1) / t.baseN;
            for (int32_t nb = 0; nb < nB; ++nb) {
                GmgTileCoord cs = c;
                const int64_t off = (int64_t)nb * t.baseN;
                const int64_t w = (int64_t)c.realN - off;
                cs.realN = (int32_t)(t.baseN < w ? t.baseN : w);
                cs.sOff = c.sOff + off;
                cs.yOff = c.yOff + off;
                cs.bOff = c.bOff + off;
                if (cs.realN <= 0) { break; }
                GmgEpilogue(vc, t, cGm, scaleGm, yGm, tSlot + off, cs, rBeg, rEnd);
            }
            CrossCoreSetFlag<0x2, PIPE_MTE2>(GMG_FLAG_V2C);
        }
        return;
    }
}





























static inline int64_t GmgHostDim(const TensorGroupInfo& grp, int i)
{
    return grp.tensors[0].shape[i];
}


static inline int64_t GmgHostCStrideG(int64_t N, int64_t baseN, int64_t gchunk)
{
    const int64_t b = baseN * gchunk;
    const int64_t r = b % 16;
    int64_t p;
    if (r == 0)       { p = b; }
    else if (r <= 12) { p = b - r + 12; }
    else if (r <= 14) { p = b - r + 14; }
    else              { p = b + 1; }
    const int64_t w = N > p ? N : p;
    return (w >= 256) ? ((w + 15) / 16 * 16) : w;
}

static inline int64_t GmgHostCStride(int64_t N, int64_t baseN)
{
    const int64_t r = baseN % 16;
    int64_t p;
    if (r == 0)       { p = baseN; }
    else if (r <= 12) { p = baseN - r + 12; }
    else if (r <= 14) { p = baseN - r + 14; }
    else              { p = baseN + 1; }
    const int64_t w = N > p ? N : p;
    return (w >= 256) ? ((w + 15) / 16 * 16) : w;
}

static inline int64_t GmgHostAlignUp(int64_t v, int64_t a)
{
    return (v + a - 1) / a * a;
}










static inline bool GmgHostCBm256Route(int64_t M, int64_t K, int64_t N, int64_t E,
                                      int64_t baseN, int64_t coreNum,
                                      bool bn512Route)
{
    const int64_t rowsPE = (M + E - 1) / E;
    const int64_t mtOld = (rowsPE + 127) / 128;
    const int64_t mtNew = (rowsPE + 255) / 256;
    const int64_t nTileN = (N + baseN - 1) / baseN;
    const int64_t tilesNew = E * mtNew * nTileN;
    return !bn512Route && (E >= 2) && (K > 256) && (baseN <= 128) &&
           (N >= 1) && (N <= 64) &&
           (mtOld >= 2) && (tilesNew >= coreNum);
}

extern "C" int gmg_bench_prep(uint8_t* outWs, size_t cap,
                              int64_t M, int64_t K, int64_t N, int64_t E,
                              int64_t coreNum, int64_t* outArgA, int64_t* outArgB,
                              size_t* outSysWs, size_t* outCWs)
{
    auto platform = platform_ascendc::PlatformAscendCManager::GetInstance();
    if (platform == nullptr) { return -2; }
    
    const bool bn512Route = (N >= 512) && (N % 512 == 0) && (K >= 1024) &&
                            (M <= 64 * E);
    int64_t baseN;
    if (bn512Route) { baseN = 512; }
    else if (N >= 256) { baseN = 256; } else { baseN = N / 32 * 32; }
    if (baseN < 32) { baseN = 16; }
    
    
    
    if (!bn512Route && ((((M + 127) / 128 + E - 1) * ((N + 255) / 256)) > 160)) {
    if (N > 16 && N < 128 && (N % 32) != 0) {
        baseN = (N <= 32) ? 32 : ((N <= 64) ? 64 : ((N <= 96) ? 96 : 128));
    }
    
    
    
    
    
    
    {
        const int64_t estME = (M + 127) / 128 + E - 1;
        const bool flipGuard = estME > 40 && estME <= 80;
        int64_t nBaseN = 0;
        if (N >= 128 && N < 256 && (N % 32) != 0) { nBaseN = (N + 31) / 32 * 32; }
        else if (N > 256 && N <= 320) { nBaseN = (N <= 272) ? 272 : ((N <= 288) ? 288 : 320); }
        if (nBaseN > 0 && !flipGuard) { baseN = nBaseN; }
        }
    }
    
    
    const bool cBm256Route = GmgHostCBm256Route(M, K, N, E, baseN, coreNum, bn512Route);
    int64_t bmCap = bn512Route ? 64 :
                    (cBm256Route ? 256 : ((K <= 256 && baseN <= 128) ? 256 : 128));
    if (baseN > 256 && baseN <= 320) {
        const int64_t bmFit = (int64_t)(131072 / 4 / baseN / 16) * 16;
        if (bmCap > bmFit) { bmCap = bmFit; }
    }
    if (!bn512Route && baseN > 320) { if (bmCap > 96) { bmCap = 96; } }
    int32_t baseM = (int32_t)GmgHostAlignUp(M < bmCap ? M : bmCap, 16);
    GmgTiling t;
    memset(&t, 0, sizeof(t));
    t.M = (int32_t)M; t.K = (int32_t)K; t.N = (int32_t)N; t.E = (int32_t)E;
    t.baseM = baseM; t.baseN = (int32_t)baseN;
    t.coreNum = (int32_t)coreNum; t.aivTotal = (int32_t)(coreNum * 2);
    size_t sysWs = 16 * 1024 * 1024;
    if (platform != nullptr) {
        const uint32_t lw = platform->GetLibApiWorkSpaceSize();
        if (lw >= 1024 * 1024) { sysWs = (size_t)lw; }
    }
    size_t cWs = (size_t)coreNum * GMG_NUM_SLOTS * t.baseM * (size_t)GmgHostCStride(N, t.baseN) * 4;
    size_t tilBytes = ((sizeof(GmgTiling) + 511) / 512) * 512;
    if (sysWs + cWs + tilBytes > cap) { return -1; }
    
    {
        matmul_tiling::MultiCoreMatmulTiling tilingApi(*platform);
        tilingApi.SetDim(1);
        tilingApi.SetAType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
                           matmul_tiling::DataType::DT_INT8, false);
        tilingApi.SetBType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
                           matmul_tiling::DataType::DT_INT8, false);
        tilingApi.SetCType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
                           matmul_tiling::DataType::DT_INT32);
        tilingApi.SetBias(false);
        tilingApi.SetShape(t.baseM, (int32_t)N, (int32_t)K);
        tilingApi.SetOrgShape((int32_t)M, (int32_t)N, (int32_t)K);
        tilingApi.SetFixSplit(t.baseM, t.baseN, -1);
        tilingApi.SetBufferSpace(-1, -1, -1);
        optiling::TCubeTiling ht;
        if (tilingApi.GetTiling(ht) == 0 && ht.get_baseM() > 0 && ht.get_baseN() > 0) {
            t.baseM = ht.get_baseM();
            t.baseN = ht.get_baseN();
        }
        
        
        
        {
            const int64_t bKv = (int64_t)ht.get_baseK();
            const bool kSafeB = bKv <= (int64_t)K;
            
            
            
            const bool dOkB = (8 % (ht.get_stepN() * 4)) == 0;
            
            
            
            const int64_t kIterOkB = ((int64_t)K + bKv - 1) / bKv;
            if (kSafeB && dOkB && kIterOkB >= 2 &&
                ht.get_stepKa() <= 2 && ht.get_stepKb() <= 2 &&
                t.baseM > 0 && t.baseN > 0 && bKv > 0) {
                const int64_t bMv = (int64_t)t.baseM;
                const int64_t bNv = (int64_t)t.baseN;
                int64_t sa = (512 * 1024 - 8 * bNv * bKv) / (bMv * bKv);
                const int64_t kIter = ((int64_t)K + bKv - 1) / bKv;
                int64_t capK = ((kIter + 3) / 4) * 4;
                if (capK < 4) { capK = 4; }
                if (sa > 16) { sa = 16; }
                if (sa > capK) { sa = capK; }
                sa = (sa / 4) * 4;
                if (sa >= 4) {
                    ht.set_stepKa((int32_t)sa);
                    ht.set_depthA1((int32_t)sa);
                    ht.set_stepKb(4);
                    ht.set_depthB1(8);
                }
            }
        }
        
        
        static uint8_t ser[4096];
        memset(ser, 0, sizeof(ser));
        uint32_t ss = ht.GetDataSize();
        if (ss > sizeof(ser)) { ss = sizeof(ser); }
        ht.SaveToBuffer(ser, ss);
        memcpy(&t.mm, ser, sizeof(t.mm));
    }
    if (aclrtMemcpy(outWs + sysWs + cWs, tilBytes, &t, sizeof(t),
                    ACL_MEMCPY_HOST_TO_DEVICE) != ACL_SUCCESS) {
        return -3;
    }
    if (outArgA) {
        *outArgA = ((int64_t)t.M << 40) | ((int64_t)t.K << 26) | (int64_t)t.N;
    }
    if (outArgB) {
        
        
        int64_t gb = 1;
        {
            
            const int64_t estM = (M + t.baseM - 1) / t.baseM;
            if (K >= 1024 && t.baseN > 0) {
                const int64_t gN = 2 * t.baseN;
                if (N % gN == 0 && (estM + E - 1) * (N / gN) >= coreNum) { gb = 2; }
            }
            if (cWs > 0) {
                
                const int64_t b = (int64_t)t.baseN * gb;
                const int64_t r = b % 16;
                int64_t p2 = (r == 0) ? b : (r <= 12 ? b - r + 12 : (r <= 14 ? b - r + 14 : b + 1));
                const int64_t stride = (N > p2 ? N : p2);
                cWs = (size_t)coreNum * GMG_NUM_SLOTS * t.baseM * (size_t)stride * 4;
            }
        }
        *outArgB = ((int64_t)t.E << 48) | ((int64_t)t.baseM << 32) | ((int64_t)t.baseN << 16) | gb;
    }
    if (outSysWs) { *outSysWs = sysWs; }
    if (outCWs) { *outCWs = cWs; }
    return 0;
}










































extern "C" void run_kernel(
    GM_ADDR x,          const TensorGroupInfo& info_x,
    GM_ADDR weight,     const TensorGroupInfo& info_weight,
    GM_ADDR scale,      const TensorGroupInfo& info_scale,
    GM_ADDR group_list, const TensorGroupInfo& info_group_list,
    GM_ADDR y,          const TensorGroupInfo& info_y,
    int64_t availableCoreNum, aclrtStream stream)
{
    (void)info_scale; (void)info_group_list; (void)info_y;
    const int64_t M = GmgHostDim(info_x, 0);
    const int64_t K = GmgHostDim(info_x, 1);
    const int64_t E = GmgHostDim(info_weight, 0);
    const int64_t N = GmgHostDim(info_weight, 2);
    
    

    GmgTiling t;
    memset(&t, 0, sizeof(t));
    t.M = (int32_t)M;
    t.K = (int32_t)K;
    t.N = (int32_t)N;
    t.E = (int32_t)E;

    
    
    
    
    
    
    
    
    
    
    
    
    
    const bool bn512Route = (N >= 512) && (N % 512 == 0) && (K >= 1024) &&
                            (M <= 64 * E);
    int64_t baseN;
    if (bn512Route) {
        baseN = 512;
    } else if (N >= 256) {
        baseN = 256;
    } else {
        baseN = N / 32 * 32;    
    }
    if (baseN < 32) { baseN = 16; }
    
    
    
    if (!bn512Route && ((((M + 127) / 128 + E - 1) * ((N + 255) / 256)) > 160)) {
    if (N > 16 && N < 128 && (N % 32) != 0) {
        baseN = (N <= 32) ? 32 : ((N <= 64) ? 64 : ((N <= 96) ? 96 : 128));
    }
    
    
    
    
    
    
    {
        const int64_t estME = (M + 127) / 128 + E - 1;
        const bool flipGuard = estME > 40 && estME <= 80;
        int64_t nBaseN = 0;
        if (N >= 128 && N < 256 && (N % 32) != 0) { nBaseN = (N + 31) / 32 * 32; }
        else if (N > 256 && N <= 320) { nBaseN = (N <= 272) ? 272 : ((N <= 288) ? 288 : 320); }
        if (nBaseN > 0 && !flipGuard) { baseN = nBaseN; }
    }
    }
    
    
    
    t.baseN = (int32_t)baseN;
    
    
    
    
    
    const int64_t safeCoreNum = availableCoreNum > 0 ? availableCoreNum : 1;
    const bool cBm256Route = GmgHostCBm256Route(M, K, N, E, baseN, safeCoreNum,
                                                bn512Route);
    int64_t bmCap = bn512Route
                    ? 64
                    : (cBm256Route ? 256
                       : (((int64_t)K <= 256 && baseN <= 128) ? 256 : 128));
    
    
    if (baseN > 256 && baseN <= 320) {
        const int64_t bmFit = (int64_t)(131072 / 4 / baseN / 16) * 16;
        if (bmCap > bmFit) { bmCap = bmFit; }
    }
    
    
    
    
    
    
    
    
    if (N > 320 && (((M + 127) / 128 + E - 1) * ((N + 255) / 256)) > 160) {
        const int64_t rowsPE = (M + E - 1) / E;
        const int64_t mTOld = (rowsPE + 127) / 128;
        const int64_t mTNew = (rowsPE + 95) / 96;
        const int64_t estOldT = E * mTOld * ((N + 255) / 256);
        const int64_t estNewT = E * mTNew * ((N + 319) / 320);
        const int64_t routeNew = ((M + 95) / 96 + E - 1) * ((N + 319) / 320);
        const int64_t routeOld = ((M + 127) / 128 + E - 1) * ((N + 255) / 256);
        if (estNewT < estOldT && !(routeNew <= 80 && routeOld > 80)) {
            if (bmCap > 96) { bmCap = 96; }
        }
    }
    t.baseM = (int32_t)GmgHostAlignUp(M < bmCap ? M : bmCap, 16);

    int32_t coreNum = (int32_t)availableCoreNum;
    if (coreNum < 1) { coreNum = 1; }
    if (coreNum > 65535) { coreNum = 65535; }
    t.coreNum = coreNum;
    t.aivTotal = coreNum * 2;

    
    
    
    
    
    
    

    
    
    
    
    
    
    
    
    const bool microTiny =
        (M * K * N <= GMG_MICRO_MACS || (N <= GMG_MICRO_SAFE_N && M * K * N <= 1024)) &&
        E * K * N <= GMG_MICRO_WBYTES;
    
    
    const bool microDotG =
        (N <= 2) && (E * K * N <= 65536) &&
        (((K >= 1024) && (M * N <= 4) && (M * K * N <= 16384)) ||
         (M * K * N <= 2048));
    
    
    
    
    
    
    
    
    
    
    
    const bool microRowOk = ((int64_t)N != 1) ||
        ((int64_t)M * (int64_t)N <=
         512 + (int64_t)M * (((int64_t)K + 63) / 64) / 16 + (((int64_t)K == 1) ? 512 : 0));
    const bool microRoute = (microTiny || microDotG) && microRowOk &&
        E * N * 4 <= 8192 && M * N * 2 <= 8192;

    
    
    
    bool basen32Gated = false;
    {
        const int64_t bn2 = ((int64_t)N + 31) / 32 * 32;
        const int64_t coreNumT = (availableCoreNum > 0) ? availableCoreNum : 1;
        const int64_t rowsPEH = (E > 0) ? ((M + E - 1) / E) : M;
        const int64_t mTH = (t.baseM > 0) ? ((rowsPEH + t.baseM - 1) / t.baseM) : 0;
        const int64_t nT2 = (bn2 > 0) ? ((int64_t)N + bn2 - 1) / bn2 : 1;
        const int64_t tilesNew = (int64_t)E * mTH * nT2;
        const bool aPanelDom = ((int64_t)M > (int64_t)E * (int64_t)N);
        basen32Gated = !microRoute && aPanelDom && N > 16 && N <= 256 &&
                       (N % 32) != 0 && bn2 > (int64_t)t.baseN &&
                       tilesNew >= coreNumT;
        if (basen32Gated) { baseN = bn2; t.baseN = (int32_t)bn2; }
    }

    
    
    
    
    const int32_t reqBaseM0 = t.baseM;
    const int32_t reqBaseN0 = t.baseN;
    auto estOf = [&](int32_t bm, int32_t bn) -> int64_t {
        return ((M + bm - 1) / bm + E - 1) * ((N + bn - 1) / bn);
    };
    int64_t totalTilesEst = estOf(t.baseM, t.baseN);
    
    
    
    const bool pocketTiny = (K <= 128 && M < 16 * E);
    
    
    
    
    
    
    
    
    bool smallRoute = !pocketTiny && (totalTilesEst <= 160 || totalTilesEst * (K + 750) <= 1200000);
    

    
    
    
    auto platform = platform_ascendc::PlatformAscendCManager::GetInstance();
    optiling::TCubeTiling hostTiling;
    bool tilingOk = false;
    for (int attempt = 0; attempt < 4 && !tilingOk; ++attempt) {
        matmul_tiling::MultiCoreMatmulTiling tilingApi(*platform);
        tilingApi.SetDim(1);
        tilingApi.SetAType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
                           matmul_tiling::DataType::DT_INT8, false);
        tilingApi.SetBType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
                           matmul_tiling::DataType::DT_INT8, false);
        tilingApi.SetCType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
                           matmul_tiling::DataType::DT_INT32);
        tilingApi.SetBias(false);
        
        
        
        
        
        
        
        if (attempt == 3) {
            tilingApi.SetShape(64, 64, 64);
        } else {
            tilingApi.SetShape(t.baseM, (int32_t)N, (int32_t)K);
        }
        tilingApi.SetOrgShape((int32_t)M, (int32_t)N, (int32_t)K);
        if (attempt != 1) {
            
            
            
            tilingApi.SetFixSplit(attempt == 0 ? t.baseM : 64, attempt == 0 ? t.baseN : 64, -1);
        }
        tilingApi.SetBufferSpace(-1, -1, -1);
        if (tilingApi.GetTiling(hostTiling) == 0 &&
            hostTiling.get_baseM() > 0 && hostTiling.get_baseN() > 0) {
            tilingOk = true;
        }
    }
    
    
    
    
    if (tilingOk && hostTiling.get_baseM() > 0 && hostTiling.get_baseN() > 0) {
        t.baseM = hostTiling.get_baseM();
        t.baseN = hostTiling.get_baseN();
    } else {
        
        
        t.baseM = (t.baseM > 64) ? t.baseM : 64;
        t.baseN = (t.baseN > 64) ? t.baseN : 64;
    }

    
    
    
    if (t.baseM != reqBaseM0 || t.baseN != reqBaseN0) {
        totalTilesEst = estOf(t.baseM, t.baseN);
        smallRoute = !pocketTiny && (totalTilesEst <= 160 || totalTilesEst * (K + 750) <= 1200000);
    }

    
    
    
    
    
    
    
    
    
    
    
    
    
    if ((int64_t)K >= 1024 && (int64_t)N >= 512 && (int64_t)E >= 8 && t.baseN > 0 &&
        ((int64_t)N % (2 * (int64_t)t.baseN)) == 0 && !bn512Route) {
        smallRoute = false;
    }

    
    
    
    
    
    
    const bool skinnyRoute = !microRoute && smallRoute &&
        (N == 1) && (E * 4 <= 8192) && (M >= 2) && (K <= 1024);
    const bool bigKRoute = !microRoute && smallRoute &&
        (N == 1) && (E * 4 <= 8192) && (K > 1024) && (K <= 8192);
    
    
    
    
    
    
    
    
    
    
    
    const bool skvRoute = !microRoute && !skinnyRoute &&
        (K >= 1) && (K <= 16) && (N >= 512) && (N <= 4096) &&
        ((int64_t)M * (int64_t)N >= 2000000);
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    const bool nk16Route = !microRoute && !skinnyRoute &&
        (K >= 1) && (K <= 16) && (N >= 9) && (N <= 64) && ((N % 32) == 0) &&
        (M >= 64) && (((int64_t)M + (int64_t)E - 1) / (int64_t)E >= 2) &&
        ((int64_t)M * (int64_t)K <= 4096) && ((int64_t)M * (int64_t)N >= 8192) &&
        
        
        ((t.baseN <= 0) || ((int32_t)t.baseN >= N) || (N % (int32_t)t.baseN == 0));
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    const bool tallSkinRoute = !microRoute && !nk16Route && smallRoute &&
        (K >= 1) && (K <= 16) && (N >= 1) && (N <= 64) &&
        (M >= 512) && (M <= 4096) &&
        (((int64_t)M + (int64_t)E - 1) / (int64_t)E >= 2) &&
        ((int64_t)E <= 64) && ((int64_t)E * (int64_t)N * 4 <= 8192) &&
        ((int64_t)M * (int64_t)N <= 240000) &&
        ((int64_t)N % (int64_t)t.baseN != 0) &&
        ((int64_t)M * (int64_t)K * (int64_t)N <= 65536);

    const bool tallSkinVecRoute = !microRoute && !nk16Route &&
        (K >= 1) && (K <= 16) && (N >= 7) && (N <= 64) && (M >= 512) &&
        (((int64_t)M + (int64_t)E - 1) / (int64_t)E >= 128) &&
        ((int64_t)E <= 64) && ((int64_t)E * (int64_t)N * 4 <= 8192) &&
        ((int64_t)M * (int64_t)K <= 12288);

    const bool nvBand = (N >= 2) && (N <= 4) && (K > 256);
    const bool nvSize = ((int64_t)K * (int64_t)N <= 16384);
    const bool nvStream = ((int64_t)M * (int64_t)K >= 4000000);
    const bool nvBMix = ((int64_t)E * (int64_t)K * (int64_t)N * 4 <= (int64_t)M * (int64_t)K);
    const bool narrowVRoute = !microRoute && !skinnyRoute && !skvRoute && !bn512Route &&
                              !cBm256Route && nvBand && nvSize && nvStream && nvBMix &&
                              (K <= 8192) && (E <= 128) && (M >= 1) && (M <= 65536) &&
                              ((int64_t)M * (int64_t)N <= 0x7FFFFFFF);
    const bool smKVecRoute = (M >= 1) && (M <= 64) && (K >= 1) && (K <= 16) &&
        (N >= 8) && (N <= 128) && ((int64_t)E >= 1) && ((int64_t)E <= 128) &&
        ((int64_t)M * (int64_t)N <= 8192) && ((int64_t)K * (int64_t)N <= 4096) &&
        ((((int64_t)N + 31) / 32) >= 2 || ((int64_t)M * (int64_t)K <= 100)) &&
        ((int64_t)N >= 16 || (int64_t)M >= 4) &&
        ((int64_t)E * ((((int64_t)N + 31) / 32) * 32) <= 2048);
    const bool narrowKVecRoute = !microRoute && !nk16Route && !tallSkinVecRoute &&
        !narrowVRoute && !skvRoute && !skinnyRoute &&
        (M >= 1) && (M <= 32) && (K >= 17) && (K <= 127) && (N >= 4) && (N <= 128) &&
        ((int64_t)E >= 1) && ((int64_t)E <= 128) &&
        ((int64_t)M <= 2 * (int64_t)E) &&
        (((((int64_t)K + 31) / 32) * 32) * ((((int64_t)N + 31) / 32) * 32) <= 8192) &&
        ((int64_t)E * ((((int64_t)K + 31) / 32) * 32) * ((((int64_t)N + 31) / 32) * 32) <= 131072);
    const bool midMVecRoute = !microRoute && !nk16Route && !tallSkinVecRoute &&
        !narrowKVecRoute &&
        (M >= 65) && (M <= 512) &&
        (K >= 1) && (K <= 12) &&
        (N >= 1) && (N <= 2048) &&
        (E >= 1) && (E <= 128) &&
        ((((int64_t)K * ((((int64_t)N + 31) / 32) * 32)) * 7) +
         ((((int64_t)N + 31) / 32) * 32) * 16 + 4096 <= 165888) &&
        ((int64_t)E * (int64_t)K * (int64_t)N <= 4194304);

    const bool superbRoute = !microRoute && !nk16Route && !narrowVRoute && !skvRoute &&
        !tallSkinVecRoute && !narrowKVecRoute && !skinnyRoute && !bigKRoute &&
        ((int64_t)M >= 512) && ((int64_t)M <= 4096) && ((int64_t)K >= 4) && ((int64_t)K <= 16) &&
        ((int64_t)N >= 7) && ((int64_t)N <= 64) &&
        ((int64_t)E >= 1) && ((int64_t)E <= 128) &&
        ((int64_t)M >= (int64_t)48 * (int64_t)E) &&
        ((int64_t)M * (int64_t)K * (int64_t)N * 4 <= 3000000000LL) &&
        ((int64_t)E * (int64_t)K * (int64_t)N * 4 <= 3000000000LL) &&
        (2 * ((int64_t)M * (int64_t)K +
              ((int64_t)((E < M) ? E : M)) * (int64_t)K * (int64_t)N +
              2 * (int64_t)M * (int64_t)N) <= 800000LL);

    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    int32_t gchunk = 1;
    {
        const int64_t estM = (M + t.baseM - 1) / t.baseM;
        
        
        
        
        
        
        const int64_t rowsPerE = (M + E - 1) / E;
        
        
        
        
        
        const bool longKRegime = (K >= 1024);
        
        
        
        
        
        const bool regime = longKRegime;
        
        
        
        const int32_t gCand[1] = {2};
        for (int32_t ci = 0; ci < 1 && regime; ++ci) {
            const int32_t gg = gCand[ci];
            const int64_t gN = (int64_t)gg * t.baseN;
            
            if (t.baseN <= 0 || N % gN != 0) { continue; }
            
            const int64_t est = (estM + E - 1) * (N / gN);
            if (est >= (int64_t)coreNum) { gchunk = gg; break; }
        }
        
        if (microRoute) { gchunk = 1; }    
    }
    t.rsv0 = (int32_t)gchunk;

    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    const int64_t kargA = ((int64_t)t.M << 40) | ((int64_t)t.K << 26) | (int64_t)t.N;
    int64_t kargB = 0;                               
    auto repackArgB = [&]() {
        kargB = (((int64_t)t.E << 48) | ((int64_t)t.baseM << 32) |
                 ((int64_t)t.baseN << 16) | (int64_t)t.rsv0);
    };
    repackArgB();
    uint8_t serBuf[1024];               
    memset(serBuf, 0, sizeof(serBuf));
    uint32_t serSize = hostTiling.GetDataSize();
    if (serSize > sizeof(serBuf)) { serSize = sizeof(serBuf); }
    if (tilingOk && serSize > 0) {
        
        
        
        
        
        
        
        
        
        
        
        
        
        const bool kSafe = (int64_t)hostTiling.get_baseK() <= (int64_t)K;
        const bool nativeCollapsed = kSafe &&
            hostTiling.get_stepKa() <= 2 && hostTiling.get_stepKb() <= 2;
        
        
        
        
        
        
        
        
        
        const bool depthOk = (8 % (hostTiling.get_stepN() * 4)) == 0;
        
        
        
        
        
        const int64_t kIterG = ((int64_t)K + hostTiling.get_baseK() - 1) / hostTiling.get_baseK();
        const bool kIterOk = kIterG >= 2;
        if (nativeCollapsed && depthOk && kIterOk) {
            const int64_t bMv = (int64_t)t.baseM;
            const int64_t bNv = (int64_t)t.baseN;
            const int64_t bKv = (int64_t)hostTiling.get_baseK();
            if (bMv > 0 && bKv > 0) {
                int64_t sa = (512 * 1024 - 8 * bNv * bKv) / (bMv * bKv);
                const int64_t kIter = ((int64_t)K + bKv - 1) / bKv;
                int64_t capK = ((kIter + 3) / 4) * 4;
                if (capK < 4) { capK = 4; }
                if (sa > 16) { sa = 16; }
                if (sa > capK) { sa = capK; }
                sa = (sa / 4) * 4;
                if (sa >= 4) {
                    hostTiling.set_stepKa((int32_t)sa);
                    hostTiling.set_depthA1((int32_t)sa);
                    hostTiling.set_stepKb(4);
                    hostTiling.set_depthB1(8);
                }
            }
        }
        hostTiling.SaveToBuffer(serBuf, serSize);
    }
    memcpy(&t.mm, serBuf, sizeof(t.mm));    

    
    size_t sysWs = 16 * 1024 * 1024;    
    if (platform != nullptr) {
        const uint32_t libWs = platform->GetLibApiWorkSpaceSize();
        if (libWs >= 1024 * 1024) { sysWs = (size_t)libWs; }
    }
    
    
    
    
    
    
    const int64_t wsCoreNum = coreNum;
    const size_t cWs = (size_t)wsCoreNum * GMG_NUM_SLOTS * t.baseM *
                       (size_t)GmgHostCStrideG(N, t.baseN, (int64_t)gchunk) * 4;
    const size_t tilBytes = ((sizeof(GmgTiling) + 511) / 512) * 512;
    uint8_t* ws = nullptr;
    if (aclrtMalloc(reinterpret_cast<void**>(&ws), sysWs + cWs + tilBytes,
                    ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) {
        
        if (aclrtMalloc(reinterpret_cast<void**>(&ws), sysWs + cWs + tilBytes,
                        ACL_MEM_MALLOC_NORMAL_ONLY) != ACL_SUCCESS) {
            return;
        }
    }
    
    (void)aclrtMemcpy(ws + sysWs + cWs, tilBytes, &t, sizeof(t), ACL_MEMCPY_HOST_TO_DEVICE);
    
    

    
    
    
    if (smKVecRoute) {
        gmg_smk_kernel<<<(uint32_t)([] (int64_t m, int64_t av) {
            int64_t b = (m <= 7) ? m : ((m + 2 - 1) / 2);
            if (b > av) { b = av; }
            if (b < 1) { b = 1; }
            return b; }((int64_t)M, (int64_t)t.aivTotal)), nullptr, stream>>>(
            x, weight, scale, group_list, y,
            (GM_ADDR)ws, (GM_ADDR)(ws + sysWs), (GM_ADDR)(ws + sysWs + cWs),
            kargA, kargB);
    } else if (superbRoute) {
        gmg_superband_kernel<<<(uint32_t)(8), nullptr, stream>>>(
            x, weight, scale, group_list, y,
            (GM_ADDR)ws, (GM_ADDR)(ws + sysWs), (GM_ADDR)(ws + sysWs + cWs),
            kargA, kargB);
    } else if (microRoute) {
        
        
        gmg_microv2_kernel<<<(uint32_t)([] (int64_t m, int64_t n, int64_t av) {
            if (m * n <= 64) { return (int64_t)1; }
            int64_t b = (m * n) / 16;
            if (b > m) { b = m; } if (b > av) { b = av; }
            if (b < 1) { b = 1; }
            return b; }((int64_t)M, (int64_t)N, (int64_t)t.aivTotal)), nullptr, stream>>>(
            x, weight, scale, group_list, y,
            (GM_ADDR)ws, (GM_ADDR)(ws + sysWs), (GM_ADDR)(ws + sysWs + cWs),
            kargA, kargB);
    } else if (nk16Route) {
        
        
        gmg_nk16_kernel<<<(uint32_t)t.aivTotal, nullptr, stream>>>(
            x, weight, scale, group_list, y,
            (GM_ADDR)ws, (GM_ADDR)(ws + sysWs), (GM_ADDR)(ws + sysWs + cWs),
            kargA, kargB);
    } else if (narrowVRoute) {
        
        
        
        
        
        gmg_narrowV_kernel<<<(uint32_t)t.aivTotal, nullptr, stream>>>(
            x, weight, scale, group_list, y,
            (GM_ADDR)ws, (GM_ADDR)(ws + sysWs), (GM_ADDR)(ws + sysWs + cWs),
            kargA, kargB);
    } else if (skvRoute) {
        
        
        gmg_skv_kernel<<<(uint32_t)t.aivTotal, nullptr, stream>>>(
            x, weight, scale, group_list, y,
            (GM_ADDR)ws, (GM_ADDR)(ws + sysWs), (GM_ADDR)(ws + sysWs + cWs),
            kargA, kargB);
    } else if (tallSkinVecRoute) {
        gmg_tallskin_kernel<<<(uint32_t)([] (int64_t m, int64_t n, int64_t av) {
            if (m * n <= 64) { return (int64_t)1; }
            int64_t b = (m * n) / 16;
            if (b > m) { b = m; } if (b > av) { b = av; }
            if (b < 1) { b = 1; }
            return b; }((int64_t)M, (int64_t)N, (int64_t)t.aivTotal)), nullptr, stream>>>(
            x, weight, scale, group_list, y,
            (GM_ADDR)ws, (GM_ADDR)(ws + sysWs), (GM_ADDR)(ws + sysWs + cWs),
            kargA, kargB);
    } else if (narrowKVecRoute) {
        gmg_narrowk_kernel<<<(uint32_t)(((int64_t)M < (int64_t)t.aivTotal)
                                        ? (int64_t)M : (int64_t)t.aivTotal), nullptr, stream>>>(
            x, weight, scale, group_list, y,
            (GM_ADDR)ws, (GM_ADDR)(ws + sysWs), (GM_ADDR)(ws + sysWs + cWs),
            kargA, kargB);
    } else if (midMVecRoute) {
        gmg_midm_kernel<<<(uint32_t)([] (int64_t m, int64_t av) {
            int64_t b = m / 8;
            if ((m % 8) != 0) { b += 1; }
            if (b > av) { b = av; }
            if (b < 1) { b = 1; }
            return b; }((int64_t)M, (int64_t)t.aivTotal)), nullptr, stream>>>(
            x, weight, scale, group_list, y,
            (GM_ADDR)ws, (GM_ADDR)(ws + sysWs), (GM_ADDR)(ws + sysWs + cWs),
            kargA, kargB);
    } else if (tallSkinRoute) {
        gmg_microv2_kernel<<<(uint32_t)([] (int64_t m, int64_t n, int64_t av) {
            if (m * n <= 64) { return (int64_t)1; }
            int64_t b = (m * n) / 16;
            if (b > m) { b = m; } if (b > av) { b = av; }
            if (b < 1) { b = 1; }
            return b; }((int64_t)M, (int64_t)N, (int64_t)t.aivTotal)), nullptr, stream>>>(
            x, weight, scale, group_list, y,
            (GM_ADDR)ws, (GM_ADDR)(ws + sysWs), (GM_ADDR)(ws + sysWs + cWs),
            kargA, kargB);
    } else if (smallRoute) {
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        if (skinnyRoute) {
            
            gmg_skinny_kernel<<<(uint32_t)t.aivTotal, nullptr, stream>>>(
                x, weight, scale, group_list, y,
                (GM_ADDR)ws, (GM_ADDR)(ws + sysWs), (GM_ADDR)(ws + sysWs + cWs),
                kargA, kargB);
        } else if (bigKRoute) {
            
            gmg_skinny_bigk_kernel<<<(uint32_t)t.aivTotal, nullptr, stream>>>(
                x, weight, scale, group_list, y,
                (GM_ADDR)ws, (GM_ADDR)(ws + sysWs), (GM_ADDR)(ws + sysWs + cWs),
                kargA, kargB);
        } else {
            gmg_mix_kernel<<<(uint32_t)(((totalTilesEst > 0) ? ((totalTilesEst < coreNum) ? totalTilesEst : coreNum) : 1)), nullptr, stream>>>(
                x, weight, scale, group_list, y,
                (GM_ADDR)ws, (GM_ADDR)(ws + sysWs), (GM_ADDR)(ws + sysWs + cWs),
                kargA, kargB);
        }
    } else {
        gmg_mix_kernel<<<(uint32_t)(((totalTilesEst > 0) ? ((totalTilesEst < coreNum) ? totalTilesEst : coreNum) : 1)), nullptr, stream>>>(
            x, weight, scale, group_list, y,
            (GM_ADDR)ws, (GM_ADDR)(ws + sysWs), (GM_ADDR)(ws + sysWs + cWs),
            kargA, kargB);
    }

    
    aclrtSynchronizeStream(stream);
    aclrtFree(ws);
}
