#include <algorithm>
#include <cstdint>
#include <stdexcept>
#include <string>
#include <cstdlib>
#include "kernel_operator.h"
#include "adv_api/matmul/matmul_intf.h"
#include "tiling/tiling_api.h"
#include "tiling/platform/platform_ascendc.h"

// This file is the complete submission. It is included by the official main.asc.
namespace grouped_matmul_gelu {
using namespace AscendC;
constexpr uint32_t BM = 128;
constexpr uint32_t L0C_INT32_ELEMS = 128U * 1024U / 4U;  // CUBE_L0C_BYTES of int32
constexpr uint32_t BN = 128;      // vector column block
constexpr uint32_t NBC = 256;      // default Cube task column width: one task covers
                                  // ceil(NBC/BN) vector column blocks, so the A tile
                                  // is fetched once for all of them.
constexpr uint32_t NBC_WIDE = 512; // widest single-task row before the split returns
constexpr uint32_t ROWS = 32;
constexpr uint32_t VEC_SIZE = ROWS * BN;
// Flat epilogue: when one Cube task covers the whole output row, a vector block
// is a run of whole rows instead of 32 rows x 128 columns.  Both the C load and
// the y store then cover one contiguous span, i.e. one DMA burst per block
// instead of one per row, and a whole task fits a single block.
constexpr uint32_t WIDE_VEC = 2 * VEC_SIZE;
// A tile that is 256 columns wide needs only half as many epilogue blocks as
// two 128-wide ones for the same elements, and every queue/sync round trip in
// a block is fixed cost.  The task width must be a multiple of 256.
constexpr uint32_t WIDE_COLS = 2 * BN;
constexpr uint32_t WIDE_ELEMS = ROWS * WIDE_COLS;
// Cross-core handshake between one AIC and its two AIVs.  The hardware encodes
// the flag id in 4 bits, and ids 11..14 are reserved by the runtime.
// sqrt(2/pi) and sqrt(2/pi)*0.044715, folded for the GELU cubic term.
constexpr float C1 = 0.7978845608028654f;
constexpr float C1C2 = 0.035677408136361406f;
// The tanh argument is scaled by -2.  Folding that factor into both constants
// removes one vector instruction per block without changing a bit: -2 is a power
// of two, so fl(x * -2c) == -2 * fl(x * c) exactly for every finite x, and the
// same holds for the add (both operands scale exactly).
constexpr float C1N = -2.0f * C1;
constexpr float C1C2N = -2.0f * C1C2;
constexpr uint16_t FLAG_READY = 8;     // 8, 9: ping-pong slots
constexpr uint16_t FLAG_DONE = 15;     // set by both AIV subcores of the group
constexpr uint32_t READY_RING = 8;
constexpr auto MM_CONFIG = GetMDLConfig(false, false, 0, false, false, false, true);

// The scalar header comes first so a core that only needs shapes (every AIV)
// does not have to pull the ~50-word Cube tiling out of GM.
constexpr uint32_t CFG_HEADER_WORDS = 13;  // + packOvl

struct Config {
    uint32_t m;
    uint32_t e;
    uint32_t k;
    uint32_t n;
    uint32_t nReal;  // the output N; `n` is the padded Cube N when padN fired
    uint32_t cores;
    uint32_t nbc;    // Cube task column width (multiple of BN, >= BN)
    uint32_t tiny;   // 1: the product is accumulated on the vector unit
    uint32_t bm;     // Cube row-tile height (128, or smaller when M cannot fill the machine)
    uint32_t manual; // 1: drive the Cube with the hand-written instruction sequence
    uint32_t flat;   // 1: every task covers the whole output row (flat epilogue blocks)
    // Row stride of B in GM.  Equal to `n` whenever B is repacked (or the
    // shape is not padded), but a padded-N shape that reads the original B
    // declares the real stride here and lets the Cube compute the padded
    // width: the surplus columns read the next B row and land in the C
    // padding, where the epilogue drops them.  The last expert is the only
    // one whose surplus read would leave the tensor, so its last column
    // task is slid back to end exactly at nReal (Tasks::Decode).
    uint32_t bStride;
    // 1: the Cube may do its first task's decode and A staging before waiting
    // for the repack flag (the AIVs' packed B), i.e. the pack runs under that
    // prologue instead of in front of it.
    uint32_t packOvl;
    AscendC::tiling::TCubeTiling cube;
};

__aicore__ inline uint32_t MinU32(uint32_t a, uint32_t b) { return a < b ? a : b; }

// Columns of B that a task actually has to stage.  A shape that reads the
// original B at its real row stride carries no data past the real N, and the
// surplus used to be fetched and dropped (251 bytes of B per row on
// 2559/32/1027/773, 33.6 MB against 25.4 MB).  Narrowing the *task* to save
// those bytes is not safe -- the Cube then traps with an L0C read/write
// conflict, deterministically at 128 columns and intermittently at 32/64 -- so
// the task keeps its full width and only the staged slice shrinks; the surplus
// columns then hold stale L1 bytes and land in the C padding, which the
// epilogue never reads.
__aicore__ inline uint32_t StagedCols(const Config& cfg, uint32_t col, uint32_t cols)
{
    uint32_t r = cols;
    if (cfg.bStride != cfg.n && col + cols > cfg.nReal) {
        uint32_t real = (cfg.nReal - col + 31U) & ~31U;
        if (real < r) r = real;
    }
    return r < 32U ? 32U : r;
}

__aicore__ inline uint32_t RoundUp32(uint32_t bytes) { return (bytes + 31U) & ~31U; }

// Vector block width: a residual column block only needs `cols` real columns,
// but the vector math must run on whole 32B rows, so it is packed to a
// multiple of 16 elements (64B for int32, 32B for half) instead of a full BN.
// cat06's last block is one real column out of 128 and used to burn a whole
// block of GELU on 32 x 128 elements.
__aicore__ inline uint32_t CwOf(uint32_t colsLeft, uint32_t bc)
{
    if (colsLeft >= bc) return bc;
    return (colsLeft + 15U) & ~15U;
}
__aicore__ inline uint32_t RoundUp8(uint32_t elements) { return (elements + 7U) & ~7U; }

// C row stride in the workspace.  Same as the 32B-aligned value unless N leaves
// a partial vector block, in which case the row is padded out to a block
// boundary and the Cube computes that last block at full width: a partial
// baseN block costs the Fixpipe one column write per row and MTE2 one B column
// per K step (measured: +38 us mte2 and +42 us fixpipe for a single extra
// column, where a whole extra block costs 4-5 us).  Every C reader - the API
// Cube path, the hand-written path and both epilogues - must use this stride.
__aicore__ inline uint32_t CStride(uint32_t n, uint32_t k)
{
    uint32_t s = (n + 15U) & ~15U;
    uint32_t tail = n % BN;
    if (n > BN && tail != 0 && tail <= BN / 2 && k < 4096) {
        s = ((n + BN - 1U) / BN) * BN;
    }
    return s;
}

// A tiny problem is computed by the vector unit of one core group instead of the
// Cube pipeline (two staged copies plus a cross-core handshake).  Measured with an
// interleaved A/B on a 10-shape grid (reports/experiments/p23_tinygate): it wins
// for M <= 2 with M*K <= 8 (-6% to -13%) and loses from M >= 4, where the Cube's
// 16-row MMA granularity stops wasting work.  The buffer limits are hardware.
constexpr uint32_t TINY_MAX_MN = 2048;
constexpr uint32_t TINY_MAX_KROW = 8192;

inline bool IsTinyShape(uint32_t m, uint32_t e, uint32_t k, uint32_t n)
{
    uint64_t rowBytes = (static_cast<uint64_t>(n) + 31U) & ~31ULL;
    // The row stride is RoundUp16(n) halfs so every per-row y store is 32B
    // aligned; the C buffer must hold m rows at that stride.
    uint64_t rowStride = (static_cast<uint64_t>(n) + 15U) & ~15ULL;
    return m <= 16 && static_cast<uint64_t>(m) * k <= 32 && n <= 256 &&
           static_cast<uint64_t>(m) * rowStride <= TINY_MAX_MN &&
           static_cast<uint64_t>(e) * k * rowBytes <= TINY_MAX_KROW;
}

__aicore__ inline void LoadHeader(GM_ADDR source, Config& destination)
{
    auto src = reinterpret_cast<__gm__ const uint32_t*>(source);
    auto dst = reinterpret_cast<uint32_t*>(&destination);
    // Every word is known to be independent, so all ten loads are issued
    // before the first store: one memory latency instead of ten.  On a small
    // shape this header+init chain is most of the AIC's time.
    // The whole header must be here, `flat` included: Tasks::BuildPrefix uses
    // it to pick the row tile, and a decision that differs between the AIC and
    // the AIVs would leave the two ends of the ready/done handshake disagreeing
    // about how many tasks exist.  It used to stop at `manual` because nothing
    // on this side read `flat`.
    uint32_t v0 = src[0], v1 = src[1], v2 = src[2], v3 = src[3];
    uint32_t v4 = src[4], v5 = src[5], v6 = src[6], v7 = src[7];
    uint32_t v8 = src[8], v9 = src[9], v10 = src[10], v11 = src[11];
    uint32_t v12 = src[12];
    dst[0] = v0; dst[1] = v1; dst[2] = v2; dst[3] = v3;
    dst[4] = v4; dst[5] = v5; dst[6] = v6; dst[7] = v7;
    dst[8] = v8; dst[9] = v9; dst[10] = v10; dst[11] = v11;
    dst[12] = v12;
}

// Only the AIC needs the tiling.  Four loads are issued before the first store so
// their latency overlaps instead of being paid one word at a time.
__aicore__ inline void LoadTiling(GM_ADDR source, Config& destination)
{
    auto src = reinterpret_cast<__gm__ const uint32_t*>(source);
    auto dst = reinterpret_cast<uint32_t*>(&destination);
    constexpr uint32_t n = sizeof(Config) / sizeof(uint32_t);
    uint32_t i = CFG_HEADER_WORDS;
    for (; i + 4 <= n; i += 4) {
        uint32_t a = src[i], b = src[i + 1], c = src[i + 2], d = src[i + 3];
        dst[i] = a;
        dst[i + 1] = b;
        dst[i + 2] = c;
        dst[i + 3] = d;
    }
    for (; i < n; ++i) dst[i] = src[i];
}

// Each participant reads these short, data-dependent boundaries on the device.
// AIC cannot allocate Vector UB, so this metadata stays in scalar/stack storage.
struct Tasks {
    int64_t ends[128];
    uint32_t prefix[129];
    uint32_t nTiles;
    TBuf<TPosition::VECCALC> endsBuf;
    // Lazy scan.  On a flat shape (one Cube task per expert) the task index
    // advances monotonically on every core, so the boundary array can be
    // consumed in order as the tiles go: an expert's read then hides behind the
    // tile that came before it instead of all of them delaying the first one.
    // Measured: the full scan is 4.0 us on the point-4 prologue and it sits at
    // the head of the whole kernel's critical path.
    __gm__ const int32_t* endGm = nullptr;   // AIC: the group_list in GM
    LocalTensor<int32_t> endUb;              // AIV: the DMA'd copy
    uint32_t scE = 0, scAcc = 0, scPrev = 0, scMax = 0;
    uint32_t scRow = 0, scRows = 0, scBase = 0;   // the expert currently covering q
    uint32_t scSh = 0;                       // log2(bm) when bm is a power of two
    uint8_t lazy = 0;
    uint8_t scPow2 = 0;

    // The row-tile rule (bm 128 -> 64 for a short, splittable deal) needs the
    // whole boundary array before the first tile, which is exactly what the lazy
    // scan exists to avoid.  Keep the rule only where a host-side lower bound
    // says the deal cannot be short: ceil(m/bm) >= 4*cores means even the most
    // tightly packed group_list needs four tiles per core, so the rule's own
    // gate (acc <= 4*cores) can only hold on the razor case acc == 4*cores.
    // 8192/128/256/256 is exactly on that boundary (acc >= 64 == 4*cores) and
    // takes the lazy path; 8192/32/256/256 (acc >= 64 < 4*20) keeps the rule.
    __aicore__ inline void StartLazy(const Config& cfg)
    {
        lazy = 1;
        nTiles = (cfg.n + cfg.nbc - 1) / cfg.nbc;
        prefix[0] = 0;
        scPow2 = ((cfg.bm & (cfg.bm - 1U)) == 0) ? 1U : 0U;
        scSh = scPow2 ? static_cast<uint32_t>(__builtin_ctz(cfg.bm)) : 0U;
    }

    __aicore__ inline uint32_t FetchEnd(uint32_t e) const
    {
        if (endGm != nullptr) return static_cast<uint32_t>(endGm[2 * e]);
        return static_cast<uint32_t>(endUb.GetValue(2 * e));
    }

    // Advances the frontier until it covers task q.  Idempotent, so a decode
    // may be repeated for the same q.  False means q is past the last task.
    // The frontier keeps only the expert that currently covers q, so the scan
    // writes nothing: the old version stored every boundary into ends[] and every
    // running count into prefix[], which is what the eager path needs for its
    // binary search but the lazy path never reads.
    __aicore__ inline bool Advance(uint32_t q, const Config& cfg)
    {
        while (scAcc <= q) {
            if (scE >= cfg.e) return false;
            uint32_t cur = FetchEnd(scE);
            uint32_t rows = cur - scPrev;
            scRow = scPrev;
            scRows = rows;
            scBase = scAcc;
            scAcc += scPow2 ? (((rows + cfg.bm - 1U) >> scSh) * nTiles)
                            : RowTiles(rows, cfg.bm);
            scPrev = cur;
            ++scE;
        }
        return true;
    }

    // Compile-time split: the lazy frontier is a template argument so a shape
    // that does not use it does not carry the code.  Merely *containing* it cost
    // 1.8 us on 8192/32/256/256 (the same effect the PACK split was made for).
    template <bool LAZY>
    __aicore__ inline bool TaskOk(uint32_t q, const Config& cfg, uint32_t total)
    {
        if constexpr (LAZY) return Advance(q, cfg);
        return q < total;
    }

    __aicore__ inline void BuildPrefix(Config& cfg)
    {
        if (lazy != 0) return;   // StartLazy already fixed nTiles/prefix[0]
        nTiles = (cfg.n + cfg.nbc - 1) / cfg.nbc;
        prefix[0] = 0;
        uint32_t rowsMax = 0;
        uint32_t acc = FillPrefix(cfg, cfg.bm, rowsMax);
        // A 128-row tile is only worth halving when the resulting grid is both
        // short and splittable.  "Splittable" is exactly one expert with more
        // than 64 rows: below that every expert is one tile either way and the
        // switch is pure overhead (+0.26 measured).  "Short" is 2..4 tasks per
        // core: at 4 tasks per core the ragged tail costs up to a quarter of the
        // epilogue; from 8 tasks per core the doubled B traffic is the bigger
        // term and the 128-row grid wins.
        // Measured against the 128-row grid, paired, 16 rounds, over 30
        // group_lists on four shapes: every input inside this window gains
        // 0.9-1.7 us (8192/128/256/256: -0.94 -1.27 -1.11; 8192/64/256/256:
        // -1.73 -1.45) and every input outside it moves by 0.0 +- 0.4 us.  A
        // uniform group_list of 64-row experts has rowsMax 64, so the visible
        // point-4 case keeps its 128-row grid untouched.
        // The N == 256 gate is load-bearing: the same rule at N=128 measured
        // +2.79 us in 10 of 10 rounds, the only reproducible loss in the set.
        if (cfg.flat != 0 && cfg.n == 256U && cfg.bm == 128U && rowsMax > 64U &&
            acc >= 2U * cfg.cores && acc <= 4U * cfg.cores) {
            cfg.bm = 64U;
            FillPrefix(cfg, cfg.bm, rowsMax);
        }
        // A padded shape that reads the original B fetches each row in `nTasks`
        // pieces, and every piece drags in the one 128B sector its neighbour
        // also needs.  On 2559/32/1027/773 four 256-wide pieces take 10.0
        // sectors per row while three 384-wide ones take 9.2 for the same real
        // bytes: AIC MTE2 43.8 -> 38.9 us, kernel -4.4.  A task holds
        // bm x nbc int32 accumulators in L0C, so the wider task has to shrink
        // the row tile, and that is only free when the widest expert still fits
        // in one tile - otherwise the expert's B slice is read once per tile.
        // n == 1024 is the only padded width measured (four 256-column tasks
        // against three of 384, the last of each row landing inside the real
        // columns); AIC and both AIVs read the same group_list, so the decision
        // needs no communication.
        // Dual accumulator half-regions (see RunCubeStream).  They need
        // bm*nbc*4*2 <= L0C, i.e. bm 64 at a 256-wide column task.  Halving bm
        // costs nothing when every expert already fits one 64-row tile - then
        // the row-tile count, the K chunk and the B read width are all
        // unchanged and the only difference is that the fixpipe of task i
        // overlaps the MMA of task i+1.  Measured on 1024/16/2048/1024 in the
        // main line: -1.10 us (4%), y bit-identical; the same rule reaches
        // 2048/32/1024/768 and 4096/64/512/768, whose experts are 64 rows too.
        if (cfg.manual == 2U && cfg.nbc == 256U && cfg.bm == 128U && rowsMax <= 64U &&
            2U * static_cast<uint64_t>(64U) * cfg.nbc <= L0C_INT32_ELEMS) {
            cfg.bm = 64U;
            FillPrefix(cfg, cfg.bm, rowsMax);
        }
        if (cfg.manual == 2U && cfg.n == 1024U && cfg.nReal != cfg.n &&
            cfg.bStride == cfg.nReal && rowsMax != 0U && rowsMax <= 128U) {
            uint32_t bLim = (rowsMax + 15U) / 16U * 16U;
            if (bLim > 80U) {
                // An 81..128-row expert does not fit one 80-row tile, so the
                // wide grid pays an extra B pass for every tile it spills.
                // Measured over the verified point-15 class: one extra row tile
                // across the whole grid is worth -5.8..-6.5 us (three
                // distributions), two extra tiles cost +5.5..+6.1 us.  Count
                // both grids on the real boundaries (no prefix writes, no
                // extra FillPrefix pass: three of those cost 2.4 us here) and
                // keep the wide task only when the spill is that single tile.
                uint32_t t80 = 0, t128 = 0;
                int64_t prev2 = 0;
#pragma unroll 8
                for (uint32_t e = 0; e < cfg.e; ++e) {
                    uint32_t r = static_cast<uint32_t>(ends[e] - prev2);
                    prev2 = ends[e];
                    t80 += (r + 79U) / 80U;
                    t128 += (r + 127U) >> 7;
                }
                if (t80 > t128 + 1U) return;
                bLim = 80U;
            }
            if ((L0C_INT32_ELEMS / bLim) / 32U * 32U >= 384U) {
                // The extra sector per task is only paid back when the task
                // grid still fills the machine: with few experts the wide task
                // leaves cores empty and each of the remaining ones carries
                // more of the row.  Measured on the catalog shape (96 tasks,
                // 4.8 per core); shapes with fewer than four tasks per core
                // keep the 256-wide grid.
                uint32_t saved = nTiles;
                nTiles = (cfg.n + 383U) / 384U;
                uint32_t acc3 = FillPrefix(cfg, bLim, rowsMax);
                if (acc3 >= 4U * cfg.cores) {
                    cfg.bm = bLim;
                    cfg.nbc = 384U;
                } else {
                    nTiles = saved;
                    FillPrefix(cfg, cfg.bm, rowsMax);
                }
            }
        }
    }

    // Fills prefix[] for one row tile and returns the total tile count.  The
    // running maximum of the per-expert row count costs one compare and one
    // select per expert on a loop that is already there; it is what tells
    // BuildPrefix whether halving the tile can split any expert at all.
    __aicore__ inline uint32_t FillPrefix(const Config& cfg, uint32_t bm, uint32_t& rowsMax)
    {
        int64_t prev = 0;
        uint32_t acc = 0;
        rowsMax = 0;
        // cfg.bm is 128 or one of 16/32/64, i.e. always a power of two, so the
        // per-expert ceil division is a shift.  E=128 runtime integer divisions
        // measured ~2.6 us of prologue on every core (AIC and both AIVs), which
        // delays the first Cube tile of the whole kernel.
        if ((bm & (bm - 1U)) == 0) {
            uint32_t sh = static_cast<uint32_t>(__builtin_ctz(bm));
#pragma unroll 8
            for (uint32_t e = 0; e < cfg.e; ++e) {
                uint32_t rows = static_cast<uint32_t>(ends[e] - prev);
                rowsMax = rows > rowsMax ? rows : rowsMax;
                acc += ((rows + bm - 1U) >> sh) * nTiles;
                prefix[e + 1] = acc;
                prev = ends[e];
            }
            return acc;
        }
        for (uint32_t e = 0; e < cfg.e; ++e) {
            uint32_t rows = static_cast<uint32_t>(ends[e] - prev);
            rowsMax = rows > rowsMax ? rows : rowsMax;
            acc += RowTiles(ends[e] - prev, bm);
            prefix[e + 1] = acc;
            prev = ends[e];
        }
        return acc;
    }

    // Vector path: one bulk copy replaces E scalar global loads per AIV.  Every
    // core reads the same boundaries, so the global memory system - not the loop
    // - is the limit; halving the request count is what pays.
    // The AIV needs the whole header, so it arrives by one DMA together with the
    // group_list and shares a single MTE2->Scalar wait.  One scalar read of `e`
    // sizes the group_list copy; seven serialized scalar loads cost ~1.1 us on
    // this path, which is a seventh of the whole tiny kernel.
    template <bool LAZY>
    __aicore__ inline void InitUb(GM_ADDR groups, Config& cfg, TPipe& pipe, GM_ADDR configAddr)
    {
        auto hsrc = reinterpret_cast<__gm__ const uint32_t*>(configAddr);
        uint32_t e = hsrc[1];
        TBuf<TPosition::VECCALC> hdrBuf;
        pipe.InitBuffer(hdrBuf, 64);
        pipe.InitBuffer(endsBuf, 1024);
        auto hdr = hdrBuf.Get<uint32_t>();
        GlobalTensor<uint32_t> ht;
        ht.SetGlobalBuffer(reinterpret_cast<__gm__ uint32_t*>(configAddr));
        DataCopyExtParams hp{1, static_cast<uint32_t>(CFG_HEADER_WORDS * sizeof(uint32_t)), 0, 0, 0};
        DataCopyPad(hdr, ht, hp, DataCopyPadExtParams<uint32_t>{false, 0, 0, 0});
        auto ub = endsBuf.Get<int32_t>();
        GlobalTensor<int32_t> src;
        src.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(groups));
        DataCopyExtParams gp{1, static_cast<uint32_t>(e * 2 * sizeof(int32_t)), 0, 0, 0};
        DataCopyPad(ub, src, gp, DataCopyPadExtParams<int32_t>{false, 0, 0, 0});
        event_t mte2ToScalar =
            static_cast<event_t>(GetTPipePtr()->FetchEventID(HardEvent::MTE2_S));
        SetFlag<HardEvent::MTE2_S>(mte2ToScalar);
        WaitFlag<HardEvent::MTE2_S>(mte2ToScalar);
        auto words = reinterpret_cast<uint32_t*>(&cfg);
        for (uint32_t i = 0; i < CFG_HEADER_WORDS; ++i) words[i] = hdr.GetValue(i);
        if constexpr (LAZY) {
            StartLazy(cfg);
            endUb = ub;
            return;
        }
        // An entry is a cumulative row count, so M <= 65536 means the low 32-bit
        // word of each little-endian int64 already holds the value.
#pragma unroll 8
        for (uint32_t g = 0; g < cfg.e; ++g) {
            ends[g] = static_cast<int64_t>(ub.GetValue(2 * g));
        }
        BuildPrefix(cfg);
    }

    // The group boundaries are independent loads, so sixteen are issued before
    // the first is consumed.  Reading one boundary per iteration costs ~0.12 us
    // per expert (15.6 us for E=128); at eight in flight it is 3.2 us, which
    // sits at the head of the whole kernel's critical path because no Cube tile
    // can start until the boundaries are known.  The entries are little-endian
    // int64 and M fits in the low word, so each request is 4 bytes: the same
    // address stream with half the register pressure, which is what lets the
    // wider window fit.
    template <bool LAZY>
    __aicore__ inline void InitScalar(GM_ADDR groups, Config& cfg)
    {
        if constexpr (LAZY) {
            StartLazy(cfg);
            endGm = reinterpret_cast<__gm__ const int32_t*>(groups);
            return;
        }
        auto p = reinterpret_cast<__gm__ const int32_t*>(groups);
        uint32_t e = 0;
        // The boundary array is 1 KB, i.e. eight 128B lines, and each 16-entry
        // batch below covers exactly one line: read serially that is eight cold
        // fetches, which measured 3.7 us of the point-4 prologue.  Touch one
        // entry per line first so the eight fetches overlap; the loop that
        // follows then hits L2.
        if (cfg.e >= 128U) {
            uint32_t t0 = static_cast<uint32_t>(p[0]);
            uint32_t t1 = static_cast<uint32_t>(p[32]);
            uint32_t t2 = static_cast<uint32_t>(p[64]);
            uint32_t t3 = static_cast<uint32_t>(p[96]);
            uint32_t t4 = static_cast<uint32_t>(p[128]);
            uint32_t t5 = static_cast<uint32_t>(p[160]);
            uint32_t t6 = static_cast<uint32_t>(p[192]);
            uint32_t t7 = static_cast<uint32_t>(p[224]);
            ends[0] = t0;  ends[16] = t1;  ends[32] = t2;  ends[48] = t3;
            ends[64] = t4; ends[80] = t5;  ends[96] = t6;  ends[112] = t7;
        }
        for (; e + 16 <= cfg.e; e += 16) {
            uint32_t v0 = static_cast<uint32_t>(p[2 * e]);
            uint32_t v1 = static_cast<uint32_t>(p[2 * (e + 1)]);
            uint32_t v2 = static_cast<uint32_t>(p[2 * (e + 2)]);
            uint32_t v3 = static_cast<uint32_t>(p[2 * (e + 3)]);
            uint32_t v4 = static_cast<uint32_t>(p[2 * (e + 4)]);
            uint32_t v5 = static_cast<uint32_t>(p[2 * (e + 5)]);
            uint32_t v6 = static_cast<uint32_t>(p[2 * (e + 6)]);
            uint32_t v7 = static_cast<uint32_t>(p[2 * (e + 7)]);
            uint32_t v8 = static_cast<uint32_t>(p[2 * (e + 8)]);
            uint32_t v9 = static_cast<uint32_t>(p[2 * (e + 9)]);
            uint32_t v10 = static_cast<uint32_t>(p[2 * (e + 10)]);
            uint32_t v11 = static_cast<uint32_t>(p[2 * (e + 11)]);
            uint32_t v12 = static_cast<uint32_t>(p[2 * (e + 12)]);
            uint32_t v13 = static_cast<uint32_t>(p[2 * (e + 13)]);
            uint32_t v14 = static_cast<uint32_t>(p[2 * (e + 14)]);
            uint32_t v15 = static_cast<uint32_t>(p[2 * (e + 15)]);
            ends[e] = v0;  ends[e + 1] = v1;   ends[e + 2] = v2;   ends[e + 3] = v3;
            ends[e + 4] = v4;  ends[e + 5] = v5;   ends[e + 6] = v6;   ends[e + 7] = v7;
            ends[e + 8] = v8;  ends[e + 9] = v9;   ends[e + 10] = v10; ends[e + 11] = v11;
            ends[e + 12] = v12; ends[e + 13] = v13; ends[e + 14] = v14; ends[e + 15] = v15;
        }
        for (; e < cfg.e; ++e) ends[e] = static_cast<int64_t>(p[2 * e]);
        BuildPrefix(cfg);
    }

    __aicore__ inline uint32_t Rows(uint32_t e) const
    {
        int64_t start = e == 0 ? 0 : ends[e - 1];
        return static_cast<uint32_t>(ends[e] - start);
    }

    __aicore__ inline uint32_t RowTiles(int64_t rows, uint32_t bm) const
    {
        return ((static_cast<uint32_t>(rows) + bm - 1) / bm) * nTiles;
    }

    template <bool LAZY>
    __aicore__ inline void Decode(uint32_t q, uint32_t& e, uint32_t& row,
                                  uint32_t& col, uint32_t& rows, uint32_t& cols,
                                  const Config& cfg) const
    {
        if constexpr (LAZY) {
            // Advance has already placed the frontier on the expert covering q,
            // and the host only selects this path for nTiles == 1, so a task is
            // one row tile of that expert with the whole row as its columns.
            uint32_t local = q - scBase;
            e = scE - 1U;
            row = scRow + local * cfg.bm;
            col = 0;
            rows = MinU32(cfg.bm, scRows - local * cfg.bm);
            cols = MinU32(cfg.nbc, cfg.n);
            return;
        }
        uint32_t lo = 0, hi = cfg.e;
        while (lo < hi) {
            uint32_t mid = (lo + hi) / 2;
            if (prefix[mid + 1] <= q) lo = mid + 1;
            else hi = mid;
        }
        e = lo;
        uint32_t local = q - prefix[e];
        uint32_t start = e == 0 ? 0 : static_cast<uint32_t>(ends[e - 1]);
        // nTiles == 1 on every task whose width is the whole row, which is the
        // common case; skipping the division there keeps two 32-bit divisions
        // out of the per-task decode.
        if (nTiles == 1) {
            row = start + local * cfg.bm;
            col = 0;
        } else {
            row = start + (local / nTiles) * cfg.bm;
            col = (local % nTiles) * cfg.nbc;
        }
        // A padded task computes past the real width.  Every expert but the
        // last reads its surplus columns out of the next expert's rows (in
        // bounds); the last expert would run off the end of the tensor, so its
        // last column task is slid back to end exactly at nReal.  The columns it
        // now shares with the previous task hold the same values either way.
        if (cfg.bStride != cfg.n && cfg.nbc <= cfg.nReal && e + 1U == cfg.e &&
            col + cfg.nbc > cfg.nReal) {
            col = cfg.nReal - cfg.nbc;
        }
        rows = MinU32(cfg.bm, static_cast<uint32_t>(ends[e]) - row);
        cols = MinU32(cfg.nbc, cfg.n - col);
    }
};

// R1: task sequence with the unique multi-tile expert's tasks spread over all
// cores and the single-fractal experts' tasks filling the remainder.  Both the
// AIC and the AIVs build the same sequence from the same group_list, so the
// ready/done handshake stays keyed by the local execution index.
struct TaskSequence {
    uint32_t bigQ0 = 0, bigN = 0;     // original tasks of the big expert's slice
    uint32_t smallQ0 = 0, smallN = 0; // small-expert sequence range
    uint32_t B = 0, H = 0;            // big expert's first task and task count
    __aicore__ inline uint32_t Count() const { return bigN + smallN; }
    __aicore__ inline uint32_t OriginalTask(uint32_t i) const {
        if (i < bigN) return bigQ0 + i;
        const uint32_t s = smallQ0 + (i - bigN);
        return s < B ? s : s + H;
    }
};

// Enable only when the actual group_list is the cat13-class multiset expressed
// generically: exactly one expert larger than one 16-row fractal, every other
// active expert within it, the big expert's task count at least the core count
// and the per-core task count within the ready ring.
__aicore__ inline bool MakeTaskSequence(const Config& cfg, const Tasks& tasks, uint32_t core,
                                        TaskSequence& seq)
{
    const uint32_t T = tasks.prefix[cfg.e];
    const uint32_t C = cfg.cores;
    if (T == 0U || C == 0U) return false;
    const uint32_t P = (T + C - 1U) / C;
    if (P > READY_RING) return false;
    uint32_t h = cfg.e, bigs = 0;
    for (uint32_t e = 0; e < cfg.e; ++e) {
        if (tasks.Rows(e) > 16U) { ++bigs; h = e; }
    }
    if (bigs != 1U) return false;
    const uint32_t B = tasks.prefix[h];
    const uint32_t H = tasks.prefix[h + 1U] - B;
    const uint32_t S = T - H;
    if (H < C) return false;
#ifdef R1_IDENTITY
    seq.bigQ0 = core * P;
    seq.bigN = MinU32(T, (core + 1U) * P) - seq.bigQ0;
    seq.smallN = 0U;
    seq.B = 0U; seq.H = T;
    return seq.bigN != 0U;
#else
    const uint32_t h0 = static_cast<uint32_t>(static_cast<uint64_t>(H) * core / C);
    const uint32_t h1 = static_cast<uint32_t>(static_cast<uint64_t>(H) * (core + 1U) / C);
    const uint32_t s0 = MinU32(S, core * P - h0);
    const uint32_t s1 = MinU32(S, (core + 1U) * P - h1);
    seq.bigQ0 = B + h0; seq.bigN = h1 - h0;
    seq.smallQ0 = s0; seq.smallN = s1 - s0;
    seq.B = B; seq.H = H;
    return true;
#endif
}

using AType = matmul::MatmulType<TPosition::GM, CubeFormat::ND, int8_t, false>;
using BType = matmul::MatmulType<TPosition::GM, CubeFormat::ND, int8_t, false>;
using CType = matmul::MatmulType<TPosition::GM, CubeFormat::ND, int32_t>;
using BiasType = matmul::MatmulType<TPosition::GM, CubeFormat::ND, int32_t>;

template <bool LAZY>
__aicore__ inline void RunCube(GM_ADDR x, GM_ADDR weight, GM_ADDR workspace,
                              Config& cfg, Tasks& tasks, TPipe& pipe)
{
    GlobalTensor<int8_t> a, b;
    GlobalTensor<int32_t> c;
    a.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
    b.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(weight));
    c.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(workspace));
    matmul::MatmulImpl<AType, BType, CType, BiasType, MM_CONFIG> mm;
    mm.SetSubBlockIdx(0);
    mm.Init(&cfg.cube, &pipe);
    // orgN is the row stride of B, which equals the compute N only when B was
    // repacked.  A padded-N shape that reads the original tensor declares its
    // real stride here and computes the padded width.
    mm.SetOrgShape(cfg.m, cfg.bStride, cfg.k, cfg.k, CStride(cfg.n, cfg.k));
    uint32_t total = tasks.prefix[cfg.e];
    uint32_t iter = 0;
    for (uint32_t q = GetBlockIdx(); tasks.template TaskOk<LAZY>(q, cfg, total);
         q += cfg.cores, ++iter) {
        // Keep at most READY_RING tiles in flight: before reusing a ready slot,
        // both AIVs of this group must have consumed the tile that used it.
        if (iter >= READY_RING) {
            CrossCoreWaitFlag(FLAG_DONE);
        }
        uint32_t e, row, col, rows, cols;
        tasks.template Decode<LAZY>(q, e, row, col, rows, cols, cfg);
        // Pad a partial baseN block up to the block boundary and let the surplus
        // land in the C row padding.  The padded B read runs into the next
        // expert's weights, which is in bounds for every expert but the last, so
        // the last expert keeps the narrow shape.  Single expression instead of a
        // mutable local: fewer instructions and a different scheduling window.
        uint32_t tailCols = cols % BN;
        mm.SetSingleShape(rows, cols + ((tailCols != 0 && tailCols <= BN / 2 &&
                                         cfg.k < 4096 && cfg.n > BN && e + 1U < cfg.e)
                                            ? (BN - tailCols) : 0U), cfg.k);
        mm.SetTensorA(a[static_cast<uint64_t>(row) * cfg.k], false);
        mm.SetTensorB(b[static_cast<uint64_t>(e) * cfg.k * cfg.bStride + col], false);
        mm.IterateAll(c[static_cast<uint64_t>(row) * CStride(cfg.n, cfg.k) + col], 0);
        // PIPE_FIX ordering puts the notify after this tile's Fixpipe write.
        CrossCoreSetFlag<2, PIPE_FIX>(static_cast<uint16_t>((FLAG_READY + iter) % 11));
    }
    mm.End();
}

// ---------------------------------------------------------------------------
// Hand-written Cube path.
//
// On the many-expert shapes the AIC is almost all Matmul-API overhead: the
// measured AIC time is 26.3 us of which 22.3 us is scalar (the KFC message
// round trip, L1 buffer bookkeeping and the K/M/N loop).  The data movement and
// the MMA themselves are a few microseconds.  This path issues the same
// instructions directly, one base block at a time.
//
// Parameters are the ones the AscendC matmul implementation uses on dav-2201
// (impl/adv_api/detail/matmul/stage/split/...).  The trap that cost a day: on
// this architecture LoadData2DParamsV2 is accepted but does nothing, so L0A/L0B
// stay empty and the Mmad result is stale.  A therefore loads with the V1
// LoadData2D, and B - whose (K,N) ND layout must become the (N,K) L0B fractal
// layout - uses LoadDataWithTranspose, which is exactly the int8 path the API
// takes (load_to_l0b_loadInstr.h).
//
// L1 layout is chosen so the A side is a flat copy: [m1][k1][16][32], the same
// order L0A wants.  B stays in the Nd2Nz natural order [n1][k1][16][32].
constexpr uint32_t CB16 = 16;              // fractal rows/cols
constexpr uint32_t C0_B8 = 32;             // int8 C0 (K direction)
constexpr uint32_t CUBE_L1_BYTES = 512 * 1024 - 4096;
constexpr uint32_t CUBE_L0A_BYTES = 64 * 1024;
constexpr uint32_t CUBE_L0B_BYTES = 64 * 1024;
constexpr uint32_t CUBE_L0C_BYTES = 128 * 1024;

__aicore__ inline uint32_t AlignUp16(uint32_t v) { return (v + 15U) & ~15U; }
__aicore__ inline uint32_t AlignUp32(uint32_t v) { return (v + 31U) & ~31U; }

struct CubeCtx {
    LocalTensor<int8_t> a1;
    LocalTensor<int8_t> b1;
    LocalTensor<int8_t> a2;
    LocalTensor<int8_t> b2;
    LocalTensor<int32_t> c1;
    uint32_t baseK;
    event_t mte2mte1;
    event_t mte1m;
    event_t mte1mte2;
    event_t mmte1;
    event_t fixm;
};

// A: `rows` x `ck` ND tile -> L1 NZ staging, one 16-row fractal block at a time
// so the tail keeps only the valid rows inside the source tensor.
__aicore__ inline void CubeStageA(const LocalTensor<int8_t>& a1, const GlobalTensor<int8_t>& src,
                                  uint32_t rows, uint32_t ck, uint32_t rowStride)
{
    uint32_t full = rows / CB16 * CB16;
    if (full != 0) {
        Nd2NzParams p;
        p.ndNum = static_cast<uint16_t>(full / CB16);
        p.nValue = CB16;
        p.dValue = static_cast<uint16_t>(ck);
        p.srcNdMatrixStride = static_cast<uint16_t>(CB16 * rowStride);
        p.srcDValue = static_cast<uint16_t>(rowStride);
        p.dstNzC0Stride = CB16;   // one 16x32 int8 fractal
        p.dstNzNStride = 1;
        p.dstNzMatrixStride = static_cast<uint16_t>(CB16 * AlignUp32(ck));
        DataCopy(a1, src, p);
    }
    if (full != rows) {
        Nd2NzParams p;
        p.ndNum = 1;
        p.nValue = static_cast<uint16_t>(rows - full);
        p.dValue = static_cast<uint16_t>(ck);
        p.srcNdMatrixStride = 0;
        p.srcDValue = static_cast<uint16_t>(rowStride);
        p.dstNzC0Stride = CB16;
        p.dstNzNStride = 1;
        p.dstNzMatrixStride = 0;
        DataCopy(a1[static_cast<uint64_t>(full) * AlignUp32(ck)], src[full * rowStride], p);
    }
}

// B: `ck` x `cols` ND tile -> L1 NZ staging [n1][k1][16][32].
__aicore__ inline void CubeStageB(const LocalTensor<int8_t>& b1, const GlobalTensor<int8_t>& src,
                                  uint32_t ck, uint32_t cols, uint32_t rowStride)
{
    // A task narrower than one C0 block leaves the rest of the B fractal
    // untouched, and an AIC exception was measured on exactly that; zeroing the
    // tile first is what makes it legal.  Wider tasks cover their own staging,
    // so they must not pay for the fill.
    if ((ck % C0_B8) != 0 || cols < C0_B8) {
        // A task narrower than C0 reads ceil(cols/32) = 1 n-group per k-block, so
        // the fill has to cover C0 columns at least; AlignUp16(cols) is 16 for a
        // task narrower than 32 and left the rest of the last fractal unwritten
        // (an AIC exception was measured on exactly that).
        uint32_t zbytes = AlignUp32(AlignUp32(ck) * AlignUp32(cols < C0_B8 ? C0_B8 : cols));
        InitConstValueParams<uint32_t> zp{
            1, static_cast<uint16_t>(zbytes / 512U), 0, 0};
        Fill(b1.template ReinterpretCast<uint32_t>(), zp);
        // The fill and the Nd2Nz below are both MTE2 traffic into the same L1
        // slot, so an MTE2 queue barrier orders them; PIPE_ALL also drained the
        // MMA and fixpipe, which cost 1.8 us per task measured on the 2559/32/
        // 1027/773 shape (K tail chunk: ck = 3).
        PipeBarrier<PIPE_MTE2>();
    }
    Nd2NzParams p;
    p.ndNum = 1;
    p.nValue = static_cast<uint16_t>(ck);
    p.dValue = static_cast<uint16_t>(cols);
    p.srcNdMatrixStride = 0;
    p.srcDValue = static_cast<uint16_t>(rowStride);
    p.dstNzC0Stride = static_cast<uint16_t>(AlignUp32(ck));
    p.dstNzNStride = 1;
    p.dstNzMatrixStride = 0;
    DataCopy(b1, src, p);
}

// L1 -> L0A: the [m1][k1] fractal order is already L0A's, so each 16-row block
// is a run of `ck/32` consecutive fractals.
__aicore__ inline void CubeTensorA(const LocalTensor<int8_t>& a2, const LocalTensor<int8_t>& a1,
                                   uint32_t rows, uint32_t ck)
{
    LoadData2dParams p;
    p.startIndex = 0;
    p.repeatTimes = static_cast<uint8_t>(AlignUp32(ck) / C0_B8);
    p.srcStride = 1;
    p.sid = 0;
    p.dstGap = 0;
    p.ifTranspose = false;
    p.addrMode = 0;
    uint32_t per = (AlignUp32(ck) / C0_B8) * 512;
    uint32_t m1 = (rows + CB16 - 1) / CB16;
    for (uint32_t i = 0; i < m1; ++i) LoadData(a2[i * per], a1[i * per], p);
}

// Same, but the L1 tile holds the whole K range (`kFull`), so a K sub-block
// starts `k0/32` fractals into each 16-row block instead of at its beginning.
__aicore__ inline void CubeTensorAAt(const LocalTensor<int8_t>& a2, const LocalTensor<int8_t>& a1,
                                     uint32_t rows, uint32_t ck, uint32_t k0, uint32_t kFull)
{
    LoadData2dParams p;
    p.startIndex = 0;
    p.repeatTimes = static_cast<uint8_t>(AlignUp32(ck) / C0_B8);
    p.srcStride = 1;
    p.sid = 0;
    p.dstGap = 0;
    p.ifTranspose = false;
    p.addrMode = 0;
    uint32_t per = (AlignUp32(ck) / C0_B8) * 512;
    uint32_t perFull = (AlignUp32(kFull) / C0_B8) * 512;
    uint32_t off = (k0 / C0_B8) * 512;
    uint32_t m1 = (rows + CB16 - 1) / CB16;
    for (uint32_t i = 0; i < m1; ++i) LoadData(a2[i * per], a1[i * perFull + off], p);
}

// L1 -> L0B: one k-block (32 k values) of every n group at a time, transposed.
__aicore__ inline void CubeTensorB(const LocalTensor<int8_t>& b2, const LocalTensor<int8_t>& b1,
                                   uint32_t cols, uint32_t ck)
{
    uint32_t kc0 = AlignUp32(ck) / C0_B8;
    uint32_t nFra = (cols + C0_B8 - 1) / C0_B8;
    uint32_t nAlign = AlignUp16(cols);
    LoadData2dTransposeParams p;
    p.startIndex = 0;
    p.repeatTimes = static_cast<uint8_t>(nFra);
    p.srcStride = static_cast<uint16_t>(kc0);
    p.dstGap = 1;
    p.dstFracGap = 0;
    p.addrMode = 0;
    for (uint32_t i = 0; i < kc0; ++i) {
        LoadDataWithTranspose(b2[i * nAlign * C0_B8], b1[i * C0_B8 * C0_B8], p);
    }
}

struct CubeBlock {
    uint64_t aOff, bOff, cOff;
    uint32_t rows, cols, ck;
    uint32_t rcols;   // columns actually staged from B (<= cols)
    uint32_t k0;
};

template <bool LAZY>
__aicore__ inline void CubeMakeBlock(CubeBlock& blk, const Tasks& tasks, const Config& cfg,
                                     uint32_t q, uint32_t k0, uint32_t baseK, uint32_t cStride,
                                     uint32_t bStride, uint32_t kCube)
{
    uint32_t e, row, col, rows, cols;
    tasks.template Decode<LAZY>(q, e, row, col, rows, cols, cfg);
    blk.aOff = static_cast<uint64_t>(row) * cfg.k + k0;
    blk.bOff = static_cast<uint64_t>(e) * kCube * bStride + col + static_cast<uint64_t>(k0) * bStride;
    blk.cOff = static_cast<uint64_t>(row) * cStride + col;
    blk.rows = rows;
    blk.cols = cols;
    blk.rcols = StagedCols(cfg, col, cols);
    blk.ck = MinU32(baseK, kCube - k0);
    blk.k0 = k0;
}

__aicore__ inline void CubeFixpipe(const CubeCtx& t, const GlobalTensor<int32_t>& cGm, uint64_t cOff,
                                   uint32_t rows, uint32_t cols, uint32_t cRowStride,
                                   uint64_t cRegOff = 0)
{
    DataCopyCO12DstParams fp;
    fp.nSize = static_cast<uint16_t>(cols);
    fp.mSize = static_cast<uint16_t>(rows);
    fp.quantPre = QuantMode_t::NoQuant;
    fp.dstStride = cRowStride;
    fp.srcStride = static_cast<uint16_t>(AlignUp16(rows));
    fp.nz2ndEn = true;
    fp.unitFlag = 3;   // couples the fixpipe to the final MMA, as the API does
    SetFixpipeNz2ndFlag(1, 1, 1);
    DataCopy(cGm[cOff], t.c1[cRegOff], fp);
}

// One Cube task stream, software pipelined: the Nd2Nz of the next K block is
// issued before the current block's MMA, so the MTE2 staging of the next task
// overlaps the fixpipe of the current one.  Two L1 staging slots make that
// legal; L0A/L0B/L0C stay single-buffered, which costs only the (short) MMA
// time because both sides of that wait are microseconds apart.
template <bool LAZY>
__aicore__ inline void RunCubeManual(GM_ADDR x, GM_ADDR weight, GM_ADDR workspace,
                                     Config& cfg, Tasks& tasks, TPipe& pipe,
                                     uint32_t kpack = 0)
{
    const uint32_t bStride = kpack != 0 ? kpack : cfg.bStride;
    // K as the Cube sees it.  With the repack, B carries `AlignUp32(k)` rows per
    // expert (zero padding), so the Cube can run whole K blocks; A keeps its
    // real row stride, and the bytes it reads past its own K are masked by
    // those zero rows.
    const uint32_t kCube = kpack != 0 ? AlignUp32(cfg.k) : cfg.k;
    GlobalTensor<int8_t> a, b;
    GlobalTensor<int32_t> c;
    a.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
    b.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(weight));
    c.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(workspace));

    uint32_t rowsMax = cfg.bm;
    // Two L0 buffers per operand: baseK is halved so both fit, which lets the MMA of
    // K block i run while block i+1 is loaded into the other buffer.
    uint32_t baseK = MinU32(MinU32(CUBE_L0B_BYTES / (2U * cfg.nbc), CUBE_L0A_BYTES / (2U * rowsMax)),
                            CUBE_L1_BYTES / (2U * (rowsMax + cfg.nbc)));
    baseK = baseK / C0_B8 * C0_B8;
    if (baseK > kCube) baseK = kCube;
    if (baseK < C0_B8) baseK = C0_B8;

    uint32_t aBytes = AlignUp32(rowsMax * AlignUp32(baseK));
    uint32_t bBytes = AlignUp32(AlignUp32(baseK) * AlignUp32(cfg.nbc));

    // Column tasks of one row tile are consecutive in q and share their A tile.
    // Handing each core a contiguous run (instead of every cores-th task) lets
    // the A tile stay in L1 for the whole run; with the round-robin order the
    // same core never sees the same row tile twice.  Shapes with a single column
    // task keep the round-robin order, which spreads the ragged last row tiles.
    uint32_t total = tasks.prefix[cfg.e];
    uint32_t qStart = GetBlockIdx(), qEnd = total, qStep = cfg.cores;
    bool aContig = tasks.nTiles > 1U;
    bool aRes = aContig;
    if (aContig) {
        uint32_t chunk = (total + cfg.cores - 1U) / cfg.cores;
        qStart = GetBlockIdx() * chunk;
        qEnd = MinU32(total, qStart + chunk);
        qStep = 1;
    }
    // The resident A region holds a whole row tile (rows x K); the two pipeline
    // slots then carry only B.  It must still fit beside them in L1.
    uint32_t aFullBytes = 0;
    if (aRes) {
        aFullBytes = AlignUp32(rowsMax * kCube);
        if (2U * bBytes + aFullBytes > CUBE_L1_BYTES) { aRes = false; aFullBytes = 0; }
    }
    uint32_t slotBytes = aRes ? bBytes : (aBytes + bBytes);

    CubeCtx t;
    TBuf<TPosition::A1> l1;
    pipe.InitBuffer(l1, 2 * slotBytes + aFullBytes);
    auto l1t = l1.Get<int8_t>();
    TBuf<TPosition::A2> l0a;
    pipe.InitBuffer(l0a, CUBE_L0A_BYTES);
    t.a2 = l0a.Get<int8_t>();
    TBuf<TPosition::B2> l0b;
    pipe.InitBuffer(l0b, CUBE_L0B_BYTES);
    t.b2 = l0b.Get<int8_t>();
    TBuf<TPosition::CO1> l0c;
    pipe.InitBuffer(l0c, CUBE_L0C_BYTES);
    t.c1 = l0c.Get<int32_t>();

    uint32_t cStride = CStride(cfg.n, cfg.k);
    if (aContig ? (qStart >= qEnd) : !tasks.template TaskOk<LAZY>(qStart, cfg, total)) return;

    // AllocEventID, not FetchEventID: the latter only peeks at the first free id
    // and hands the same one out again, which silently aliases the two slots.
    event_t m2m1[2] = {static_cast<event_t>(GetTPipePtr()->AllocEventID<HardEvent::MTE2_MTE1>()),
                       static_cast<event_t>(GetTPipePtr()->AllocEventID<HardEvent::MTE2_MTE1>())};
    event_t l1free[2] = {static_cast<event_t>(GetTPipePtr()->AllocEventID<HardEvent::MTE1_MTE2>()),
                         static_cast<event_t>(GetTPipePtr()->AllocEventID<HardEvent::MTE1_MTE2>())};
    // One event id per L0 buffer pair, so the MMA and the next L0 load overlap.
    event_t mte1m[2] = {static_cast<event_t>(GetTPipePtr()->AllocEventID<HardEvent::MTE1_M>()),
                        static_cast<event_t>(GetTPipePtr()->AllocEventID<HardEvent::MTE1_M>())};
    event_t mmte1[2] = {static_cast<event_t>(GetTPipePtr()->AllocEventID<HardEvent::M_MTE1>()),
                        static_cast<event_t>(GetTPipePtr()->AllocEventID<HardEvent::M_MTE1>())};
    event_t fixm = static_cast<event_t>(GetTPipePtr()->AllocEventID<HardEvent::FIX_M>());
    event_t aready = static_cast<event_t>(GetTPipePtr()->AllocEventID<HardEvent::MTE2_MTE1>());
    event_t afree = static_cast<event_t>(GetTPipePtr()->AllocEventID<HardEvent::MTE1_MTE2>());
    LocalTensor<int8_t> aFull = l1t[static_cast<uint64_t>(2) * slotBytes];
    uint32_t aKey = 0xffffffffU;   // row tile currently staged in the A region
    bool aFresh = false;           // A region staged but its flag not yet waited

    CubeBlock cur, nxt;
    uint32_t q = qStart, k0 = 0, iter = 0, bidx = 0;
    uint32_t pend[2] = {0, 0};   // L1-slot "free" events set but not yet waited
    CubeMakeBlock<LAZY>(cur, tasks, cfg, q, k0, baseK, cStride, bStride, kCube);
    // Stage the first block into slot 0.
    if (aRes) {
        CubeStageA(aFull, a[cur.aOff], cur.rows, cfg.k, cfg.k);
        SetFlag<HardEvent::MTE2_MTE1>(aready);
        aKey = cur.aOff;
        aFresh = true;
        CubeStageB(l1t, b[cur.bOff], cur.ck, cur.rcols, bStride);
    } else {
        CubeStageA(l1t, a[cur.aOff], cur.rows, cur.ck, cfg.k);
        CubeStageB(l1t[aBytes], b[cur.bOff], cur.ck, cur.rcols, bStride);
    }
    SetFlag<HardEvent::MTE2_MTE1>(m2m1[0]);
    SetFlag<HardEvent::M_MTE1>(mmte1[0]);
    SetFlag<HardEvent::M_MTE1>(mmte1[1]);
    SetFlag<HardEvent::FIX_M>(fixm);

    for (;;) {
        uint32_t s = bidx & 1;
        const LocalTensor<int8_t> a1 = l1t[static_cast<uint64_t>(s) * slotBytes];
        const LocalTensor<int8_t> b1 =
            l1t[static_cast<uint64_t>(s) * slotBytes + (aRes ? 0U : aBytes)];
        bool first = cur.k0 == 0;
        bool last = (cur.k0 + cur.ck == kCube);

        WaitFlag<HardEvent::MTE2_MTE1>(m2m1[s]);
        if (aRes && aFresh) {
            WaitFlag<HardEvent::MTE2_MTE1>(aready);
            aFresh = false;
        }
        const uint32_t s2 = bidx & 1;   // L0 buffer pair index
        WaitFlag<HardEvent::M_MTE1>(mmte1[s2]);
        auto a2 = t.a2[static_cast<uint64_t>(s2) * aBytes];
        auto b2 = t.b2[static_cast<uint64_t>(s2) * bBytes];
        if (aRes) {
            CubeTensorAAt(a2, aFull, cur.rows, cur.ck, cur.k0, kCube);
        } else {
            CubeTensorA(a2, a1, cur.rows, cur.ck);
        }
        CubeTensorB(b2, b1, cur.cols, cur.ck);
        SetFlag<HardEvent::MTE1_M>(mte1m[s2]);
        SetFlag<HardEvent::MTE1_MTE2>(l1free[s]);
        ++pend[s];
        if (first) WaitFlag<HardEvent::FIX_M>(fixm);
        WaitFlag<HardEvent::MTE1_M>(mte1m[s2]);

        MmadParams mp;
        // The MMA has no single-row mode here: madM == 1 has to be widened to one
        // fractal (matmul's GetFixedMadM does the same); the fixpipe still writes
        // the single real row.
        mp.m = static_cast<uint16_t>(cur.rows == 1 ? CB16 : cur.rows);
        mp.n = static_cast<uint16_t>(cur.cols);
        mp.k = static_cast<uint16_t>(AlignUp32(cur.ck));
        mp.cmatrixInitVal = first;
        mp.cmatrixSource = false;
        mp.unitFlag = last ? 3 : 2;   // 3 = final accumulation
        Mmad(t.c1, a2, b2, mp);
        SetFlag<HardEvent::M_MTE1>(mmte1[s2]);
        if (last) {
            CubeFixpipe(t, c, cur.cOff, cur.rows, cur.cols, cStride);
            SetFlag<HardEvent::FIX_M>(fixm);
            CrossCoreSetFlag<2, PIPE_FIX>(static_cast<uint16_t>((FLAG_READY + iter) % 11));
            ++iter;
        }

        // Advance to the next K block, then stage it into the other slot so the
        // copy runs while the fixpipe above drains.
        k0 += cur.ck;
        if (k0 >= kCube) {
            k0 = 0;
            q += qStep;
            if (aContig ? (q >= qEnd) : !tasks.template TaskOk<LAZY>(q, cfg, total)) break;
            if (iter >= READY_RING) CrossCoreWaitFlag(FLAG_DONE);
        }
        CubeMakeBlock<LAZY>(nxt, tasks, cfg, q, k0, baseK, cStride, bStride, kCube);
        uint32_t ns = (bidx + 1) & 1;
        if (pend[ns] != 0) {
            WaitFlag<HardEvent::MTE1_MTE2>(l1free[ns]);
            --pend[ns];
        }
        if (aRes) {
            // aOff - k0 is the row-tile base, i.e. the identity of the A tile.
            uint32_t rowKey = nxt.aOff - nxt.k0;
            if (rowKey != aKey) {
                // One set/wait pair, not a count: an AscendC event id is a single
                // semaphore, so it must never have more than one outstanding set.
                // This drains the MTE1 readers of the old A before overwriting it.
                SetFlag<HardEvent::MTE1_MTE2>(afree);
                WaitFlag<HardEvent::MTE1_MTE2>(afree);
                CubeStageA(aFull, a[rowKey], nxt.rows, cfg.k, cfg.k);
                SetFlag<HardEvent::MTE2_MTE1>(aready);
                aKey = rowKey;
                aFresh = true;
            }
        } else {
            // The last block must not read past the tensor's K end: stage only
            // the real remainder (the fractal layout is the same, because the
            // stride is built from AlignUp32(K) either way) and let the zero
            // rows of the repacked B mask the stale fractal tail.
            uint32_t ack = MinU32(nxt.ck, cfg.k - nxt.k0);
            CubeStageA(l1t[static_cast<uint64_t>(ns) * slotBytes], a[nxt.aOff], nxt.rows, ack, cfg.k);
        }
        CubeStageB(l1t[static_cast<uint64_t>(ns) * slotBytes + (aRes ? 0U : aBytes)],
                   b[nxt.bOff], nxt.ck, nxt.rcols, bStride);
        SetFlag<HardEvent::MTE2_MTE1>(m2m1[ns]);
        cur = nxt;
        ++bidx;
    }
    // Drain the last outstanding producer events so the pipe state is balanced.
    for (uint32_t i = 0; i < 2; ++i) {
        for (uint32_t j = 0; j < pend[i]; ++j) WaitFlag<HardEvent::MTE1_MTE2>(l1free[i]);
        pend[i] = 0;
    }
    WaitFlag<HardEvent::M_MTE1>(mmte1[0]);
    WaitFlag<HardEvent::M_MTE1>(mmte1[1]);
    WaitFlag<HardEvent::FIX_M>(fixm);
}

// Load one L0 reduction block (ck x cols) from a B chunk staged as exactly ck
// rows, so the L1 -> L0 transpose reads a packed tile.
__aicore__ inline void CubeTensorBChunk(const LocalTensor<int8_t>& b2,
                                       const LocalTensor<int8_t>& b1,
                                       uint32_t cols, uint32_t ck)
{
    LoadData2dTransposeParams p;
    p.startIndex = 0;
    uint32_t kc0 = AlignUp32(ck) / C0_B8;
    p.repeatTimes = static_cast<uint8_t>((cols + C0_B8 - 1) / C0_B8);
    p.srcStride = static_cast<uint16_t>(kc0);
    p.dstGap = 1;
    p.dstFracGap = 0;
    p.addrMode = 0;
    uint32_t nAlign = AlignUp16(cols);
    for (uint32_t i = 0; i < kc0; ++i) {
        LoadDataWithTranspose(b2[i * nAlign * C0_B8], b1[i * C0_B8 * C0_B8], p);
    }
}

// One output tile as a contiguous stream of K chunks.  The tile geometry is
// decoded once per task, not once per K chunk.
struct StreamTask {
    uint64_t aOff, bOff, cOff;
    uint32_t rows, cols, rcols;
};

template <bool LAZY>
__aicore__ inline void MakeStreamTask(StreamTask& t, const Tasks& tasks, const Config& cfg,
                                      uint32_t q, uint32_t cStride, uint32_t bStride,
                                      uint32_t kCube)
{
    uint32_t e, row, col, rows, cols;
    tasks.template Decode<LAZY>(q, e, row, col, rows, cols, cfg);
    t.aOff = static_cast<uint64_t>(row) * cfg.k;
    t.bOff = static_cast<uint64_t>(e) * kCube * bStride + col;
    t.cOff = static_cast<uint64_t>(row) * cStride + col;
    t.rows = rows;
    t.cols = cols;
    t.rcols = StagedCols(cfg, col, cols);
}

// Slab-pipelined Cube stream.
//
// The wall on the large shapes is the AIC's GM->L1 engine: every other pipe
// (L1->L0, MMA, fixpipe) must hide behind it, otherwise the AIC time is the
// sum of the stages instead of the maximum.  B is therefore staged in a ring
// of per-chunk L1 slots that always stays `depth` chunks ahead of the MMA, and
// the next slot's copy is issued before the current chunk's MMA, so MTE2 never
// idles waiting for an L0 buffer.  A stays resident for the whole run of
// column tasks that share a row tile.
template <bool LAZY, bool SEQ = false>
__aicore__ inline void RunCubeStream(GM_ADDR x, GM_ADDR weight, GM_ADDR workspace,
                                    Config& cfg, Tasks& tasks, TPipe& pipe,
                                    uint32_t kpack = 0)
{
    const uint32_t bStride = kpack != 0 ? kpack : cfg.bStride;
    uint32_t total = tasks.prefix[cfg.e];
    TaskSequence seq;
    const bool seqOk = SEQ && MakeTaskSequence(cfg, tasks, GetBlockIdx(), seq);
    uint32_t firstTask = 0;
    uint32_t nTasks = 0;
    if (seqOk) {
        nTasks = seq.Count();
    } else {
        uint32_t chunk = (total + cfg.cores - 1U) / cfg.cores;
        firstTask = GetBlockIdx() * chunk;
        uint32_t endTask = MinU32(total, firstTask + chunk);
        if (firstTask >= endTask) return;
        nTasks = endTask - firstTask;
    }
    if (nTasks == 0U) return;

    GlobalTensor<int8_t> a, b;
    GlobalTensor<int32_t> c;
    a.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
    b.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(weight));
    c.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(workspace));
    const uint32_t kCube = kpack != 0 ? AlignUp32(cfg.k) : cfg.k;

    uint32_t l0K = MinU32(CUBE_L0A_BYTES / (2U * cfg.bm),
                          CUBE_L0B_BYTES / (2U * cfg.nbc));
    l0K = MinU32(kCube, l0K / C0_B8 * C0_B8);
    if (l0K < C0_B8) l0K = C0_B8;
    // A last K chunk narrower than one 32-byte block traps the MMA on this
    // hardware when it meets a row tile of one fractal or less (measured:
    // rows<=16 && tail<32 -> 507015; either side alone is fine).  Only the
    // 256-row tile geometry hits it, so the guard is scoped to bm >= 256 and
    // the other shapes keep their measured chunking.  The accumulator is
    // int32, so re-chunking the K sweep changes no value.
    if (cfg.bm >= 256U) {
        for (uint32_t tries = 0; tries < 8U && l0K > 2U * C0_B8; ++tries) {
            uint32_t tail = kCube % l0K;
            if (tail == 0U || tail >= C0_B8) break;
            l0K -= C0_B8;
        }
    }
    uint32_t nChunks = (kCube + l0K - 1U) / l0K;
    // The A staging lays each 16-row block out with a stride of AlignUp32(k), so
    // the region it writes is bm/16 blocks of that size - not bm*kCube, which is
    // 29 bytes per row smaller for a K that is not 32-aligned (3,712 bytes on
    // cat15).  That overrun was benign only because this buffer is the last L1
    // allocation and the pipe leaves ~240 KB of L1 unused.
    uint32_t aFullBytes = AlignUp32(static_cast<uint64_t>(cfg.bm) * AlignUp32(kCube));
    uint32_t bSlotBytes = AlignUp32(l0K * cfg.nbc);
    // Four in-flight B chunks keep MTE2 ahead of the MMA at every K-block
    // boundary; fall back to two when L1 cannot hold four.
    uint32_t depth = 4;
    while (depth > 2U && aFullBytes + depth * bSlotBytes > CUBE_L1_BYTES) depth >>= 1U;
    // The prefetch peeks at most one task ahead, so the ring can never be
    // deeper than one task's chunk count.
    while (depth > 1U && depth > nChunks) depth >>= 1U;
    uint32_t aL0Bytes = cfg.bm * l0K;
    uint32_t bL0Bytes = cfg.nbc * l0K;

    TBuf<TPosition::A1> l1;
    pipe.InitBuffer(l1, depth * bSlotBytes + aFullBytes);
    auto storage = l1.Get<int8_t>();
    auto aFull = storage[depth * bSlotBytes];
    TBuf<TPosition::A2> l0a;
    TBuf<TPosition::B2> l0b;
    TBuf<TPosition::CO1> l0c;
    pipe.InitBuffer(l0a, CUBE_L0A_BYTES);
    pipe.InitBuffer(l0b, CUBE_L0B_BYTES);
    pipe.InitBuffer(l0c, CUBE_L0C_BYTES);
    CubeCtx t;
    t.a2 = l0a.Get<int8_t>();
    t.b2 = l0b.Get<int8_t>();
    t.c1 = l0c.Get<int32_t>();

    event_t bReady[4];
    event_t bFree[4];
    for (uint32_t slot = 0; slot < 4; ++slot) {
        bReady[slot] = static_cast<event_t>(pipe.AllocEventID<HardEvent::MTE2_MTE1>());
        bFree[slot] = static_cast<event_t>(pipe.AllocEventID<HardEvent::MTE1_MTE2>());
    }
    event_t l0Ready[2] = {
        static_cast<event_t>(pipe.AllocEventID<HardEvent::MTE1_M>()),
        static_cast<event_t>(pipe.AllocEventID<HardEvent::MTE1_M>())};
    event_t l0Free[2] = {
        static_cast<event_t>(pipe.AllocEventID<HardEvent::M_MTE1>()),
        static_cast<event_t>(pipe.AllocEventID<HardEvent::M_MTE1>())};
    event_t aReady = static_cast<event_t>(pipe.AllocEventID<HardEvent::MTE2_MTE1>());
    event_t aFree = static_cast<event_t>(pipe.AllocEventID<HardEvent::MTE1_MTE2>());
    event_t cFree = static_cast<event_t>(pipe.AllocEventID<HardEvent::FIX_M>());
    // Two accumulator half-regions when one task's tile leaves the other half of
    // L0C free: the fixpipe of task i then drains while task i+1's MMA runs,
    // instead of the next task's first MMA waiting for it.  The AIC's chain is
    // mac -> fixpipe serial per task, so this turns `mac + fix` into
    // `max(mac, fix)`; it is free only when halving bm does not add row tiles
    // (BuildPrefix picks that case), otherwise the extra B passes cost more.
    const bool dualC = (static_cast<uint64_t>(cfg.bm) * cfg.nbc * sizeof(int32_t) * 2U <= CUBE_L0C_BYTES);
    const uint64_t cRegElems = static_cast<uint64_t>(cfg.bm) * cfg.nbc;
    event_t cFreeB = dualC ? static_cast<event_t>(pipe.AllocEventID<HardEvent::FIX_M>()) : cFree;
    bool usedB = false;   // an odd task count may never touch region B
    for (uint32_t slot = 0; slot < 4; ++slot) SetFlag<HardEvent::MTE1_MTE2>(bFree[slot]);
    for (uint32_t slot = 0; slot < 2; ++slot) SetFlag<HardEvent::M_MTE1>(l0Free[slot]);
    // No initial FIX_M flag: the first task has no preceding fixpipe to wait
    // for, and raising it here would leave two sets outstanding on one id.

    uint32_t cStride = CStride(cfg.n, cfg.k);
    uint32_t totalChunks = nTasks * nChunks;
    uint32_t l0Index = 0;
    uint32_t iter = 0;

    StreamTask cur, nxt;
    MakeStreamTask<LAZY>(cur, tasks, cfg, seqOk ? seq.OriginalTask(0U) : firstTask, cStride, bStride, kCube);
    bool haveNxt = nTasks > 1U;
    if (haveNxt) MakeStreamTask<LAZY>(nxt, tasks, cfg, seqOk ? seq.OriginalTask(1U) : firstTask + 1U, cStride, bStride, kCube);

    uint64_t residentA = ~uint64_t(0);
    bool aFresh = false;
    // PACKOVL: the first task's A staging does not read the packed B, so it can
    // run while the AIVs are still repacking.  The wait for their flag happens
    // here, after the task decode, and BEFORE the B ring priming (the first
    // reader of the packed buffer) - placing it after the priming made the
    // first B chunks read stale data (non-deterministic output).
    if (cfg.packOvl != 0U) {
        CrossCoreWaitFlag(6);
        CubeStageA(aFull, a[cur.aOff], cur.rows, cfg.k, cfg.k);
        SetFlag<HardEvent::MTE2_MTE1>(aReady);
        residentA = cur.aOff;
        aFresh = true;
    }

    // Prime the B ring: chunks 0 .. min(depth, totalChunks)-1.
    uint32_t primed = MinU32(depth, totalChunks);
    for (uint32_t g = 0; g < primed; ++g) {
        WaitFlag<HardEvent::MTE1_MTE2>(bFree[g]);
        uint32_t ti = g / nChunks;
        const StreamTask& T = ti == 0 ? cur : nxt;
        uint32_t k0 = (g - ti * nChunks) * l0K;
        uint32_t ck = MinU32(l0K, kCube - k0);
        CubeStageB(storage[g * bSlotBytes],
                   b[T.bOff + static_cast<uint64_t>(k0) * bStride], ck, T.rcols, bStride);
        SetFlag<HardEvent::MTE2_MTE1>(bReady[g]);
    }
    // Slots the ring never primed would otherwise keep their initial "free"
    // flag raised past the end of the kernel, which aliases the next set.
    for (uint32_t slot = primed; slot < 4U; ++slot) {
        WaitFlag<HardEvent::MTE1_MTE2>(bFree[slot]);
    }

    uint32_t curTi = 0;
    for (uint32_t g = 0; g < totalChunks; ++g) {
        uint32_t cIn = g - curTi * nChunks;
        uint32_t slot = g & (depth - 1U);
        uint32_t k0 = cIn * l0K;
        uint32_t ck = MinU32(l0K, kCube - k0);
        bool lastChunk = cIn + 1U == nChunks;

        if (cIn == 0) {
            // A new output tile starts: handshake, and re-stage A only when the
            // row tile changed.  The copy overlaps the B chunks already in the
            // MTE2 queue and the first L0 load.
            if (iter >= READY_RING) CrossCoreWaitFlag(FLAG_DONE);
            if (cur.aOff != residentA) {
                if (residentA != ~uint64_t(0)) WaitFlag<HardEvent::MTE1_MTE2>(aFree);
                CubeStageA(aFull, a[cur.aOff], cur.rows, cfg.k, cfg.k);
                SetFlag<HardEvent::MTE2_MTE1>(aReady);
                residentA = cur.aOff;
                aFresh = true;
            }
        }

        uint32_t l0Slot = l0Index & 1U;
        ++l0Index;
        auto a2 = t.a2[static_cast<uint64_t>(l0Slot) * aL0Bytes];
        auto b2 = t.b2[static_cast<uint64_t>(l0Slot) * bL0Bytes];

        WaitFlag<HardEvent::MTE2_MTE1>(bReady[slot]);
        WaitFlag<HardEvent::M_MTE1>(l0Free[l0Slot]);
        if (aFresh) {
            WaitFlag<HardEvent::MTE2_MTE1>(aReady);
            aFresh = false;
        }
        CubeTensorAAt(a2, aFull, cur.rows, ck, k0, kCube);
        CubeTensorBChunk(b2, storage[slot * bSlotBytes], cur.cols, ck);
        // The flag is raised on the MTE1 pipe after the B read, so waiting it
        // here costs nothing (the MMA below waits this load anyway) and it makes
        // the slot reusable for the copy `depth` chunks ahead.
        SetFlag<HardEvent::MTE1_MTE2>(bFree[slot]);
        SetFlag<HardEvent::MTE1_M>(l0Ready[l0Slot]);
        WaitFlag<HardEvent::MTE1_MTE2>(bFree[slot]);
        uint32_t gNext = g + depth;
        if (gNext < totalChunks) {
            uint32_t ti2 = gNext / nChunks;
            const StreamTask& T2 = ti2 == curTi ? cur : nxt;
            uint32_t k2 = (gNext - ti2 * nChunks) * l0K;
            uint32_t ck2 = MinU32(l0K, kCube - k2);
            CubeStageB(storage[slot * bSlotBytes],
                       b[T2.bOff + static_cast<uint64_t>(k2) * bStride], ck2, T2.rcols, bStride);
            SetFlag<HardEvent::MTE2_MTE1>(bReady[slot]);
        }
        // The A L1 region may be overwritten once the last task that shares
        // this row tile has issued its final L0 read.
        if (lastChunk && haveNxt && nxt.aOff != cur.aOff) {
            SetFlag<HardEvent::MTE1_MTE2>(aFree);
        }
        const uint32_t cReg = dualC ? (iter & 1U) : 0U;
        const event_t cEv = cReg ? cFreeB : cFree;
        // With two regions the wait is for the same region's fixpipe two tasks
        // back, not for the previous task's.
        if (cIn == 0 && (dualC ? (iter >= 2U) : (iter != 0))) WaitFlag<HardEvent::FIX_M>(cEv);
        WaitFlag<HardEvent::MTE1_M>(l0Ready[l0Slot]);

        MmadParams mp;
        mp.m = static_cast<uint16_t>(cur.rows == 1 ? CB16 : cur.rows);
        mp.n = static_cast<uint16_t>(cur.cols);
        mp.k = static_cast<uint16_t>(ck);
        mp.cmatrixInitVal = cIn == 0;
        mp.cmatrixSource = false;
        mp.unitFlag = lastChunk ? 3 : 2;
        Mmad(dualC ? t.c1[static_cast<uint64_t>(cReg) * cRegElems] : t.c1, a2, b2, mp);
        SetFlag<HardEvent::M_MTE1>(l0Free[l0Slot]);

        if (lastChunk) {
            CubeFixpipe(t, c, cur.cOff, cur.rows, cur.cols, cStride,
                        dualC ? static_cast<uint64_t>(cReg) * cRegElems : 0U);
            SetFlag<HardEvent::FIX_M>(cEv);
            if (cReg) usedB = true;
            CrossCoreSetFlag<2, PIPE_FIX>(static_cast<uint16_t>((FLAG_READY + iter) % 11));
            ++iter;
            if (curTi + 1U < nTasks) {
                cur = nxt;
                ++curTi;
                haveNxt = curTi + 1U < nTasks;
                if (haveNxt) MakeStreamTask<LAZY>(nxt, tasks, cfg, seqOk ? seq.OriginalTask(curTi + 1U) : firstTask + curTi + 1U, cStride, bStride, kCube);
            }
        }
    }
    for (uint32_t slot = 0; slot < 2; ++slot) {
        WaitFlag<HardEvent::M_MTE1>(l0Free[slot]);
    }
    WaitFlag<HardEvent::FIX_M>(cFree);
    if (usedB) WaitFlag<HardEvent::FIX_M>(cFreeB);
}

// QD = number of C blocks / y blocks the epilogue keeps in flight.  The ablations
// show each block's C read and y store are latency bound (one DMA op each,
// ~0.7-0.9 us), so two slots only hide one block and the rest stays exposed;
// four is worth ~3.4% on the narrow-block shapes.  The 8192-element block paths
// cannot afford four slots in UB and keep two.
// PAIR is the host-selected instance flag for the narrow-task merge (two
// adjacent 128-wide Cube tasks into one 16x256 epilogue block).  It is a
// template argument, not a runtime predicate: a candidate that only touches
// the pair path must not be able to shift the block-epilogue code of every
// other shape (the same lesson as Kernel<PACK>: an *unexecuted* pair block
// cost 3.5% on a shape whose executed path was identical).
template <uint32_t QD, bool PAIR>
class Epilogue {
public:
    __aicore__ inline void Init(GM_ADDR workspace, GM_ADDR scale, GM_ADDR y, TPipe& pipe,
                                const Config& cfg)
    {
        c_.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(workspace));
        scale_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scale));
        y_.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y));
        // Depth 2 on both queues lets the next C block load and the previous y
        // block store overlap the vector math of the current block.
        // Wide blocks on the block path: a task that is exactly 256 columns wide
        // everywhere lets a vector block cover two BN blocks of one row chunk.
        // The whole-row gate is not needed for the padded shapes that do NOT
        // repack (bStride != n): a partial-wide block already has a per-row path,
        // and those shapes have no repack buffer, so the 256-wide slot (173 KB)
        // fits.  The repacking shapes keep the old gate - they measure neutral
        // with it and their repack buffer pushes the UB budget.
        bool wide = cfg.flat == 0 && cfg.nbc == WIDE_COLS &&
                    ((cfg.nReal % WIDE_COLS) == 0 ||
                     (cfg.nReal != cfg.n && cfg.bStride == cfg.nReal));
        // One block per row chunk whenever the alternative is a *narrower* block
        // than the task: a 384-wide task, and a 256-wide one that is not `wide`
        // (its real width is not a multiple of 256, which is every repacked
        // shape whose rows y are misaligned).  A narrower block splits each row
        // of y into several bursts that each drag in the 128B sector at both
        // ends; one block per row chunk writes the whole row in one burst.
        bool wideRow = cfg.flat == 0 && (cfg.nbc == 384U || (cfg.nbc == WIDE_COLS && !wide));
        uint32_t slot = cfg.flat != 0 ? WIDE_VEC : (wideRow ? 16U * cfg.nbc : (wide ? WIDE_ELEMS : VEC_SIZE));
        // 256B of padding rotates a buffer by 8 of the 16 UB bank groups.  With
        // everything allocated back to back all 32B rows land in groups 0..7, so
        // every two-operand vector op reads both sources from the same group
        // (an arch22 read-read conflict).  One pad in front of the staged
        // inputs and one in front of the scratch block leave z alone in 0..7
        // while C, the scale, y and u sit in 8..15.
        uOfs_ = slot + 64;
        rowsPerBlock_ = cfg.flat != 0 ? (WIDE_VEC / cfg.n) : ROWS;
        rowsPerTile_ = wideRow ? 16U : ROWS;
        blockCols_ = cfg.flat != 0 ? cfg.n : (wideRow ? cfg.nbc : (wide ? WIDE_COLS : BN));
        pipe.InitBuffer(padBuf_, 256);
        pipe.InitBuffer(in_, QD, slot * sizeof(int32_t));
        pipe.InitBuffer(out_, QD, slot * sizeof(half));
        // The block path stages the scale of a WHOLE Cube task in one transfer
        // (`cols` floats), so this queue must hold the widest task the host can
        // pick, not a fixed 1024.  Tasks wider than 1024 columns only appear on
        // the large-N shapes the 15-point catalog never covers (the column-split
        // rule caps nbc at 384 or 256 there); on 4096/8192/16384 x 1024 x 4095 a
        // 1408-wide task overran this buffer by 384 floats and produced wrong
        // values in 8% of the output.
        uint32_t scaleCols = ((cfg.n + BN - 1U) / BN) * BN;
        if (scaleCols < 1024U) scaleCols = 1024U;   // keep the 15-point UB layout
        pipe.InitBuffer(scaleQ_, 2, scaleCols * sizeof(float));
        pipe.InitBuffer(padBuf2_, 256);
        // The block path keeps two live FP32 scratch blocks (the GELU value and
        // the reciprocal argument); every other temporary aliases them.
        pipe.InitBuffer(tmpBuf_, 2U * (slot + 64U) * sizeof(float));
    }

    __aicore__ inline void LoadC(const LocalTensor<int32_t>& c, uint32_t row, uint32_t nr,
                                 uint32_t col, uint32_t cols, uint32_t bc, const Config& cfg)
    {
        uint32_t CS = CStride(cfg.n, cfg.k);
        if (cols < bc) {
            // Partial N tile: the padding columns must be zeroed so no garbage
            // reaches the vector math.  One 2D copy replaces the per-row loop:
            // the UB-side stride unit is 32 bytes and the hardware advances by
            // roundUp32(burst) + stride*32, so the gap is expressible whenever
            // the packed row width is 32B aligned (CwOf makes it so).  cat06's
            // tail is 129 ints of 144: a 516B burst advancing 544B.
            Duplicate(c, int32_t(0), nr * bc);
            PipeBarrier<PIPE_ALL>();
            uint32_t burst = cols * static_cast<uint32_t>(sizeof(int32_t));
            uint32_t adv = (burst + 31U) & ~31U;
            DataCopyExtParams cp{static_cast<uint16_t>(nr), burst,
                                 (CS - cols) * static_cast<uint32_t>(sizeof(int32_t)),
                                 (bc * 4U - adv) / 32U, 0};
            DataCopyPad(c, c_[static_cast<uint64_t>(row) * CS + col], cp,
                        DataCopyPadExtParams<int32_t>{false, 0, 0, 0});
            return;
        }
        DataCopyExtParams cp{static_cast<uint16_t>(nr),
                             cols * static_cast<uint32_t>(sizeof(int32_t)),
                             (CS - cols) * static_cast<uint32_t>(sizeof(int32_t)), 0, 0};
        DataCopyPad(c, c_[static_cast<uint64_t>(row) * CS + col], cp,
                    DataCopyPadExtParams<int32_t>{false, 0, 0, 0});
    }

    // Flat path: the y block lives in the out_ queue until the next block has
    // been cast, so its V_MTE3 flag is already satisfied when it is dequeued.
    __aicore__ inline void StoreFlatY(const Config& cfg, uint32_t row, uint32_t count)
    {
        auto y = out_.template DeQue<half>();
        DataCopyExtParams yp{1, count * static_cast<uint32_t>(sizeof(half)), 0, 0, 0};
        DataCopyPad(y_[static_cast<uint64_t>(row) * cfg.n], y, yp);
        out_.FreeTensor(y);
    }

    __aicore__ inline void StoreY(const LocalTensor<half>& y, uint32_t row, uint32_t nr,
                                  uint32_t col, uint32_t cols, uint32_t bc, const Config& cfg)
    {
        if (cols < bc) {
            // Same rule on the store side: the UB source advances by
            // roundUp32(burst) + stride*32.  cat06's y tail is 129 halfs of a
            // 144-wide row, i.e. a 258B burst advancing 288B, so the UB stride
            // is zero and only the GM side needs a gap.
            uint32_t burst = cols * static_cast<uint32_t>(sizeof(half));
            uint32_t adv = (burst + 31U) & ~31U;
            DataCopyExtParams yp{static_cast<uint16_t>(nr), burst,
                                 (bc * 2U - adv) / 32U,
                                 (cfg.nReal - cols) * static_cast<uint32_t>(sizeof(half)), 0};
            DataCopyPad(y_[static_cast<uint64_t>(row) * cfg.nReal + col], y, yp);
            return;
        }
        DataCopyExtParams yp{static_cast<uint16_t>(nr),
                             cols * static_cast<uint32_t>(sizeof(half)), 0,
                             (cfg.nReal - cols) * static_cast<uint32_t>(sizeof(half)), 0};
        DataCopyPad(y_[static_cast<uint64_t>(row) * cfg.nReal + col], y, yp);
    }

    // GELU in place over one block: z holds C * scale on entry and the FP32 GELU
    // value on exit, laid out as `rows` rows of `blockCols` columns.
    // u = z * (C1 + C2*z^2) with sqrt(2/pi) and its 0.044715 factor folded into
    // the constants, and the -2 of the tanh argument folded into C1N/C1C2N.
    // Stable signed form: y = z / (1 + exp(-2u)), the same real value as the
    // reference's |u|/branch form (for u < 0, z*e^{-2|u|}/(1+e^{-2|u|}) ==
    // z/(1+e^{-2u})); no sign select is needed and for z >= 8 the denominator is
    // exactly 1.0 in FP32, so no z >= 8 override is needed either.
    __aicore__ inline void Gelu(const LocalTensor<float>& z, const LocalTensor<int32_t>& c,
                                const LocalTensor<float>& scale, uint32_t count, uint32_t rows,
                                uint32_t blockCols)
    {
        auto tmp = tmpBuf_.Get<float>();
        auto u = tmp[uOfs_];
        Cast(z, c, RoundMode::CAST_NONE, count);
        // One source repeat holds 64 fp32 values, so a row of `blockCols`
        // columns takes blockCols/64 calls; the scale keeps its per-column
        // values (src1 repeat stride 0) while z advances one row.
        uint8_t rep = static_cast<uint8_t>(blockCols * static_cast<uint32_t>(sizeof(float)) / 32U);
        for (uint32_t off = 0; off < blockCols; off += 64U) {
            uint32_t m = MinU32(64U, blockCols - off);
            Mul(z[off], z[off], scale[off], static_cast<uint64_t>(m),
                static_cast<uint8_t>(rows), {1, 1, 1, rep, rep, 0});
        }
        Mul(u, z, z, count);
        Muls(u, u, C1C2N, count);
        Adds(u, u, C1N, count);
        Mul(u, z, u, count);
        Exp(u, u, count);
        Adds(u, u, 1.0f, count);
        Div(z, z, u, count);
    }

    // `cols` may span several BN blocks.  Linearising the task's (column block,
    // row chunk) pairs into one loop lets the C prefetch carry across a column
    // block boundary; with one chunk per block a per-call Tile could never
    // prefetch and every C load was fully exposed.
    // `bc` / `rowsPer` are the block geometry for this call.  The narrow-task
    // shapes (one 128-wide Cube task) can merge two adjacent tasks into one
    // 16x256 block, which writes 512B per y row instead of 256B; a task that
    // cannot be merged keeps the 32x128 geometry.
    __aicore__ inline uint32_t BlockCols() const { return blockCols_; }
    __aicore__ inline uint32_t RowsPer() const { return rowsPerTile_; }

    __aicore__ inline void Tile(uint32_t e, uint32_t row, uint32_t col,
                               uint32_t rows, uint32_t cols, const Config& cfg,
                               uint32_t bc, uint32_t rowsPer)
    {
        uint32_t rowChunks = (rows + rowsPer - 1) / rowsPer;
        uint32_t colBlocks = (cols + bc - 1) / bc;
        uint32_t nBlocks = rowChunks * colBlocks;
        if (nBlocks == 0) return;
        for (uint32_t p = 0; p + 1U < QD && p < nBlocks; ++p) {
            uint32_t pcb = p / rowChunks, prb = p % rowChunks;
            auto pre = in_.template AllocTensor<int32_t>();
            uint32_t pcol = MinU32(bc, cols - pcb * bc);
            LoadC(pre, row + prb * rowsPer,
                  MinU32(rowsPer, rows - prb * rowsPer),
                  col + pcb * bc, pcol, CwOf(pcol, bc), cfg);
            in_.EnQue(pre);
        }
        // One scale transfer covers the whole task: a per-column-block transfer
        // had to wait for the previous block's vector math (V->MTE2) every time.
        auto scaleAll = scaleQ_.template AllocTensor<float>();
        if (cols < bc * colBlocks) {
            Duplicate(scaleAll, 0.0f, bc * colBlocks);
            PipeBarrier<PIPE_ALL>();
        }
        DataCopyExtParams sp{1, cols * static_cast<uint32_t>(sizeof(float)), 0, 0, 0};
        DataCopyPad(scaleAll, scale_[static_cast<uint64_t>(e) * cfg.nReal + col], sp,
                    DataCopyPadExtParams<float>{false, 0, 0, 0.0f});
        scaleQ_.EnQue(scaleAll);
        scaleAll = scaleQ_.template DeQue<float>();
        for (uint32_t cb = 0; cb < colBlocks; ++cb) {
            uint32_t ccol = col + cb * bc;
            uint32_t ccols = MinU32(bc, cols - cb * bc);
            auto scale = scaleAll[cb * bc];
        for (uint32_t rb = 0; rb < rowChunks; ++rb) {
            uint32_t r = rb * rowsPer;
            uint32_t nr = MinU32(rowsPer, rows - r);
            uint32_t cw = CwOf(ccols, bc);
            uint32_t count = nr * cw;
            auto c = in_.template DeQue<int32_t>();
            uint32_t blk = cb * rowChunks + rb;
            if (blk + (QD - 1U) < nBlocks) {
                // Keep QD-1 loads in flight so a block's C read never has to
                // complete before the previous block's math is done.
                uint32_t nblk = blk + (QD - 1U);
                uint32_t ncb = nblk / rowChunks;
                uint32_t nrb = nblk % rowChunks;
                auto next = in_.template AllocTensor<int32_t>();
                uint32_t nc = MinU32(bc, cols - ncb * bc);
                LoadC(next, row + nrb * rowsPer, MinU32(rowsPer, rows - nrb * rowsPer),
                      col + ncb * bc, nc, CwOf(nc, bc), cfg);
                in_.EnQue(next);
            }
            auto z = tmpBuf_.Get<float>();
            Gelu(z, c, scale, count, nr, cw);
            // FP32 result -> FP16.  A one-ULP deviation stays inside both bounds
            // while 2^-14 <= |y| < 2 (the FP16 spacing is a normal quantum there,
            // so ULP/|y| <= 2^-10 and ULP < 1e-3 both hold); outside that range an
            // exact ties-to-even repair would be needed, and this path does not
            // carry one.
            auto y = out_.template AllocTensor<half>();
            Cast(y, z, RoundMode::CAST_ROUND, count);
            out_.EnQue(y);
            y = out_.template DeQue<half>();
            StoreY(y, row + r, nr, ccol, ccols, cw, cfg);
            out_.FreeTensor(y);
            in_.FreeTensor(c);
        }
        }
        scaleQ_.FreeTensor(scaleAll);
    }

    // Flat epilogue for tasks that cover the whole output row.
    //
    // Every block is `rowsPerBlock_` whole rows, contiguous in C and in y, so
    // each side is one DMA burst instead of one per row, and one task is a
    // single block.  With one block per task the in-queue has a free slot, so
    // the next task's C load is issued while this task's vector math runs: the
    // AIC produces one tile ahead, so the handshake wait is already satisfied
    // and the C read stops being exposed.
    struct Job {
        uint32_t e, row, rows, nblk, per;
    };

    // `per` is the rows in one block.  The last task of a core group has no
    // successor to prefetch, so it is handed half-size blocks: the second
    // block's C load then hides behind the first block's vector math, and that
    // task is the only AIV work that lands after the AIC's last tile.
    template <bool LAZY>
    __aicore__ inline void MakeJob(Job& j, Tasks& tasks, const Config& cfg, uint32_t q,
                                   uint32_t sub, bool last)
    {
        uint32_t e, row, col, rows, cols;
        uint32_t per = last ? (rowsPerBlock_ > 1 ? rowsPerBlock_ / 2 : 1) : rowsPerBlock_;
        tasks.template Decode<LAZY>(q, e, row, col, rows, cols, cfg);
        // Same split as the block path: half the rows each, and a sub that has no
        // row to take stays idle.  The column split cannot happen here because
        // the host only selects this path for n <= 256, where a one-row task is
        // already below the 512-element single-AIV threshold.
        uint32_t r0 = 0, rn = rows;
        if (rows * cols < 512) {
            if (sub != 0) rn = 0;
        } else {
            uint32_t halfRows = (rows + 1) / 2;
            r0 = sub * halfRows;
            rn = r0 < rows ? MinU32(halfRows, rows - r0) : 0;
        }
        j.e = e;
        j.row = row + r0;
        j.rows = rn;
        j.per = per;
        j.nblk = (rn + per - 1) / per;
    }

    // The "last task of this core" flag halves the block size so the tail tile
    // still has something to prefetch against.  It is decided *after* the job is
    // decoded: in the lazy build the look-ahead moves the frontier, and a decode
    // issued after it would land on the wrong expert.
    __aicore__ inline void MarkLast(Job& j) const
    {
        j.per = rowsPerBlock_ > 1 ? rowsPerBlock_ / 2 : 1;
        j.nblk = (j.rows + j.per - 1) / j.per;
    }

    __aicore__ inline uint32_t BlockRows(const Job& j, uint32_t b) const
    {
        return MinU32(j.per, j.rows - b * j.per);
    }

    __aicore__ inline void LoadFlat(const Job& j, uint32_t b, const Config& cfg)
    {
        uint32_t count = BlockRows(j, b) * cfg.n;
        auto c = in_.template AllocTensor<int32_t>();
        // Same 512B pieces the block path reads: one long burst over the whole
        // task measures 1.5x slower than many 512B bursts on this chip
        // (cat04 aiv_mte2 10.1 us with 512B bursts, 15.2 us as one burst).
        // A short last block (n=64 with an odd row count) does not divide into
        // 512B pieces, so it goes as one burst of its own length.
        uint32_t bytes = count * static_cast<uint32_t>(sizeof(int32_t));
        uint32_t burst = (bytes % 512U == 0) ? 512U : bytes;
        DataCopyExtParams cp{static_cast<uint16_t>(bytes / burst), burst, 0, 0, 0};
        DataCopyPad(c, c_[static_cast<uint64_t>(j.row + b * j.per) *
                              CStride(cfg.n, cfg.k)], cp,
                    DataCopyPadExtParams<int32_t>{false, 0, 0, 0});
        in_.EnQue(c);
    }

    __aicore__ inline void LoadScale(Job& j, const Config& cfg)
    {
        auto s = scaleQ_.template AllocTensor<float>();
        DataCopyExtParams sp{1, cfg.n * static_cast<uint32_t>(sizeof(float)), 0, 0, 0};
        DataCopyPad(s, scale_[static_cast<uint64_t>(j.e) * cfg.n], sp,
                    DataCopyPadExtParams<float>{false, 0, 0, 0.0f});
        scaleQ_.EnQue(s);
    }

    template <bool LAZY>
    __aicore__ inline void FlatRun(Tasks& tasks, const Config& cfg, uint32_t core,
                                   uint32_t sub, uint32_t total)
    {
        uint32_t q = core;
        if (!tasks.template TaskOk<LAZY>(q, cfg, total)) return;
        uint32_t iter = 0;
        Job cur, nxt;
        // The y store is issued one block late: the V_MTE3 flag is then already
        // set, so the scalar never waits on its own Cast and the MTE3 copy runs
        // against the next block's vector math.  Same idiom the C prefetch uses.
        bool pendY = false;
        uint32_t pendRow = 0, pendCount = 0;
        // The job decode and the scale load touch no C data, so they run under
        // the AIC's latency instead of after it: the first READY wait is then
        // followed directly by the C read.
        MakeJob<LAZY>(cur, tasks, cfg, q, sub, false);
        if (!tasks.template TaskOk<LAZY>(q + cfg.cores, cfg, total)) MarkLast(cur);
        LoadScale(cur, cfg);
        CrossCoreWaitFlag(static_cast<uint16_t>((FLAG_READY + iter) % 11));
        if (cur.nblk != 0) LoadFlat(cur, 0, cfg);
        for (;;) {
            auto scale = scaleQ_.template DeQue<float>();
            for (uint32_t b = 0; b < cur.nblk; ++b) {
                uint32_t nr = BlockRows(cur, b);
                uint32_t count = nr * cfg.n;
                auto c = in_.template DeQue<int32_t>();
                if (b + 1 < cur.nblk) LoadFlat(cur, b + 1, cfg);
                if (b + 1 == cur.nblk) {
                    // The tile's C has landed in UB, so the workspace slot may be
                    // reused.  Raised here, before the next task's prefetch is
                    // issued: a PIPE_MTE2 flag drains what was issued before it,
                    // and waiting for the prefetch too stalled the scalar for
                    // most of the next tile's read time.
                    CrossCoreSetFlag<2, PIPE_MTE2>(FLAG_DONE);
                }
                auto z = tmpBuf_.Get<float>();
                Gelu(z, c, scale, count, nr, cfg.n);
                if (b + 1 == cur.nblk && cur.nblk <= 1 &&
                    tasks.template TaskOk<LAZY>(q + cfg.cores, cfg, total)) {
                    // Prefetch the next task only after this block's vector ops
                    // are issued: the handshake wait then overlaps the math, and
                    // the first task is not delayed by a whole AIC tile.
                    MakeJob<LAZY>(nxt, tasks, cfg, q + cfg.cores, sub, false);
                    if (!tasks.template TaskOk<LAZY>(q + 2U * cfg.cores, cfg, total)) MarkLast(nxt);
                    CrossCoreWaitFlag(static_cast<uint16_t>((FLAG_READY + iter + 1) % 11));
                    LoadScale(nxt, cfg);
                    if (nxt.nblk != 0) LoadFlat(nxt, 0, cfg);
                }
                auto y = out_.template AllocTensor<half>();
                Cast(y, z, RoundMode::CAST_ROUND, count);
                out_.EnQue(y);
                in_.FreeTensor(c);
                if (pendY) StoreFlatY(cfg, pendRow, pendCount);
                pendRow = cur.row + b * cur.per;
                pendCount = count;
                pendY = true;
            }
            scaleQ_.FreeTensor(scale);
            // A sub with no rows takes no block, so nothing raised DONE above.
            if (cur.nblk == 0) CrossCoreSetFlag<2, PIPE_MTE2>(FLAG_DONE);
            ++iter;
            q += cfg.cores;
            if (!tasks.template TaskOk<LAZY>(q, cfg, total)) {
                if (pendY) StoreFlatY(cfg, pendRow, pendCount);
                pendY = false;
                break;
            }
            if (cur.nblk > 1 || cur.nblk == 0) {
                // Multi-block and empty tasks did not prefetch: start the next one.
                MakeJob<LAZY>(nxt, tasks, cfg, q, sub, false);
                if (!tasks.template TaskOk<LAZY>(q + cfg.cores, cfg, total)) MarkLast(nxt);
                CrossCoreWaitFlag(static_cast<uint16_t>((FLAG_READY + iter) % 11));
                LoadScale(nxt, cfg);
                if (nxt.nblk != 0) LoadFlat(nxt, 0, cfg);
            }
            if (pendY) StoreFlatY(cfg, pendRow, pendCount);
            pendY = false;
            cur = nxt;
        }
    }

private:
    GlobalTensor<int32_t> c_;
    GlobalTensor<float> scale_;
    GlobalTensor<half> y_;
    TQue<QuePosition::VECIN, QD> in_;
    TQue<QuePosition::VECOUT, QD> out_;
    TQue<QuePosition::VECIN, 2> scaleQ_;
    TBuf<TPosition::VECCALC> tmpBuf_, padBuf_, padBuf2_;
    uint32_t uOfs_ = VEC_SIZE;
    uint32_t rowsPerBlock_ = ROWS;
    uint32_t rowsPerTile_ = ROWS;
    uint32_t blockCols_ = BN;
};

// R0 fast tiny path.  On a tiny shape the product is a handful of rows
// (M <= 16, M*K <= 32) and at most 256 columns, so the generic prologue costs
// more than the arithmetic: every UB scalar read, every queue round trip and
// every per-expert epilogue barrier is latency, not throughput.  This variant
//   1. reads the four shape words and the group boundaries straight from GM
//      with independent loads (no header DMA, no prefix tree, no Tasks object),
//   2. stages x / weight / scale with one MTE2 wait, and keeps C in UB,
//   3. gives each AIV a contiguous row range, and
//   4. runs ONE dense epilogue pass over that range instead of one pass per
//      expert, then stores every row after a single S_MTE3 wait.
// The arithmetic (and therefore the bit pattern of every output element) is the
// same chain the generic tiny path used: same Cast/Mul/Exp/Div, same
// near-half refinement lane set.
__aicore__ inline void RunTinyFast(GM_ADDR x, GM_ADDR weight, GM_ADDR scale,
                                   GM_ADDR groups, GM_ADDR y,
                                   uint32_t m, uint32_t e, uint32_t k, uint32_t n,
                                   uint32_t sub)
{
    // The four shape words arrive as kernel arguments: they are host-known and
    // reading them back from the config header costs a GM round trip on the
    // critical path of a kernel that is only a couple of microseconds long.
    uint32_t halfRows = (m + 1U) >> 1;
    uint32_t lo = sub * halfRows;
    if (lo >= m) return;                      // second AIV of a one-row shape
    uint32_t hi = lo + halfRows < m ? lo + halfRows : m;


    constexpr uint32_t CAST_CHUNK = 4096;
    uint32_t pn = (n + 15U) & ~15U;           // half row stride (32B aligned)
    uint32_t stride = RoundUp32(n);           // padded weight row stride
    uint32_t wRows = e * k;
    uint32_t wTotal = wRows * stride;
    uint32_t count = (hi - lo) * pn;

    // One InitBuffer for the whole tiny working set: the slices keep the exact
    // offsets the sequential allocations produced (every size is a multiple of
    // 32 B), so UB placement is unchanged, but the fixed cost of nine
    // bookkeeping calls collapses to one.
    const uint32_t xBytes = 256;
    const uint32_t wpBytes = RoundUp32(wTotal);
    const uint32_t whBytes = CAST_CHUNK * sizeof(half);
    const uint32_t wfBytes = RoundUp32(wTotal * sizeof(float));
    const uint32_t cBytes = RoundUp32(count * sizeof(float));   // FP32 C in place
    const uint32_t scBytes = RoundUp32(e * pn * sizeof(float));
    const uint32_t accBytes = 256 * sizeof(float);
    const uint32_t yBytes = RoundUp32(count * sizeof(half));
    const uint32_t tmpBytes = 4U * RoundUp32(count * sizeof(float));
    // No TPipe: the first InitBuffer would land at UB offset 0 anyway, so the
    // tensors are built directly at the same offsets.  This skips the pipe
    // object, its SOC initialisation and the buffer-pool bookkeeping, which
    // together measured ~0.34 us on this kernel.
    constexpr uint32_t ub0 = 0;
    const uint32_t ub1 = ub0 + xBytes;
    const uint32_t ub2 = ub1 + wpBytes;
    const uint32_t ub3 = ub2 + whBytes;
    const uint32_t ub4 = ub3 + wfBytes;
    const uint32_t ub5 = ub4 + cBytes;
    const uint32_t ub6 = ub5 + scBytes;
    const uint32_t ub7 = ub6 + accBytes;
    const uint32_t ub8 = ub7 + yBytes;

    GlobalTensor<int8_t> xg, wg;
    GlobalTensor<float> sg;
    GlobalTensor<half> yg;
    xg.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
    wg.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(weight));
    sg.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scale));
    yg.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y));

    LocalTensor<int8_t> xb(TPosition::VECCALC, ub0, xBytes);
    LocalTensor<int8_t> wp(TPosition::VECCALC, ub1, wpBytes);
    LocalTensor<half> wh(TPosition::VECCALC, ub2, whBytes / sizeof(half));
    LocalTensor<float> wf(TPosition::VECCALC, ub3, wfBytes / sizeof(float));
    LocalTensor<float> cb(TPosition::VECCALC, ub4, cBytes / sizeof(float));
    LocalTensor<float> sc(TPosition::VECCALC, ub5, scBytes / sizeof(float));
    LocalTensor<float> acc(TPosition::VECCALC, ub6, accBytes / sizeof(float));
    LocalTensor<half> yv(TPosition::VECCALC, ub7, yBytes / sizeof(half));
    LocalTensor<float> tmp(TPosition::VECCALC, ub8, tmpBytes / sizeof(float));
    // z aliases the FP32 C block: the MAC writes it there directly, so the
    // reference's int32 round trip costs vector ops for nothing (the sum is an
    // exact integer-valued float at this size).
    auto z = cb;
    auto u = tmp[count];
    auto t = tmp[2U * count];
    auto result = tmp[3U * count];

    DataCopyExtParams xp{1, static_cast<uint32_t>(m * k), 0, 0, 0};
    DataCopyPad(xb, xg, xp, DataCopyPadExtParams<int8_t>{false, 0, 0, 0});
    DataCopyExtParams wparm{static_cast<uint16_t>(wRows), static_cast<uint32_t>(n), 0, 0, 0};
    DataCopyPad(wp, wg, wparm, DataCopyPadExtParams<int8_t>{false, 0, 0, 0});
    // The padding columns of every staged row are left as they are: they never
    // reach GM (only n columns are stored per row), and the broadcast Mul below
    // keeps each element's result to its own lane.  Zero-filling them would put
    // a PIPE_ALL barrier in front of the three copies for no output change.
    // One copy per expert: the padded row start must be 32B aligned for the
    // broadcast Mul, and the UB-side gap of a strided copy is not a byte count.
    for (uint32_t ex = 0; ex < e; ++ex) {
        DataCopyExtParams sp{1, n * static_cast<uint32_t>(sizeof(float)), 0, 0, 0};
        DataCopyPad(sc[ex * pn], sg[static_cast<uint64_t>(ex) * n], sp,
                    DataCopyPadExtParams<float>{false, 0, 0, 0.0f});
    }
    // The boundaries are only needed by the MAC loop below, so they are read
    // after the three copies are issued: their GM latency then overlaps the
    // DMA instead of sitting in front of it.
    auto gsrc = reinterpret_cast<__gm__ const int64_t*>(groups);
    int64_t ends[128];
    uint32_t g = 0;
    for (; g + 8U <= e; g += 8U) {
        int64_t v0 = gsrc[g], v1 = gsrc[g + 1], v2 = gsrc[g + 2], v3 = gsrc[g + 3];
        int64_t v4 = gsrc[g + 4], v5 = gsrc[g + 5], v6 = gsrc[g + 6], v7 = gsrc[g + 7];
        ends[g] = v0; ends[g + 1] = v1; ends[g + 2] = v2; ends[g + 3] = v3;
        ends[g + 4] = v4; ends[g + 5] = v5; ends[g + 6] = v6; ends[g + 7] = v7;
    }
    for (; g < e; ++g) ends[g] = gsrc[g];

    event_t mte2ToV = static_cast<event_t>(0);
    SetFlag<HardEvent::MTE2_V>(mte2ToV);
    // `x` is also read by the *scalar* unit (xb.GetValue in the MAC loop).  A
    // HardEvent::MTE2_V wait compiles to WaitFlagInternal<PIPE_MTE2, PIPE_V>,
    // i.e. it orders the vector pipe only, so that scalar read used to be gated
    // by nothing but the latency of the group_list loads above it -- a race
    // that only held because the two happened to take comparable time.  The
    // MTE2_S event is the one that blocks the scalar queue; it is set here,
    // next to the copies, and waited just before the first xb.GetValue so the
    // weight Cast below is still issued without waiting for the DMA.
    event_t mte2ToS = static_cast<event_t>(1);
    SetFlag<HardEvent::MTE2_S>(mte2ToS);
    WaitFlag<HardEvent::MTE2_V>(mte2ToV);

    // int8 -> half -> float over the whole padded weight block; the element
    // stride is identical in all three layouts.
    uint32_t total = wRows * stride;
    for (uint32_t off = 0; off < total; off += CAST_CHUNK) {
        uint32_t cnt = MinU32(CAST_CHUNK, total - off);
        Cast(wh, wp[off], RoundMode::CAST_NONE, cnt);
        Cast(wf[off], wh, RoundMode::CAST_NONE, cnt);
    }

    // C = x * W^T, accumulated on the vector unit, one row at a time.
    // The count-form API switches the vector mask mode twice per call, and a
    // mode switch drains the vector pipe.  On this loop the ops are independent
    // (only the destination is shared), so that drain is not hidden behind the
    // previous op's latency the way it is inside the GELU chain: setting the
    // counter once for the whole loop measured 1.59 vs 1.65 us on a tiny shape
    // (vector pipe 0.26 vs 0.28).  Same ops, same operands, same order.
    // Block the scalar pipe on the x tile before its first scalar read.
    WaitFlag<HardEvent::MTE2_S>(mte2ToS);
    UnaryRepeatParams cntUn{1, 1, 8, 8};
    SetMaskCount();
    SetVectorMask<float, MaskMode::COUNTER>(static_cast<int32_t>(n));
    for (uint32_t ex = 0; ex < e; ++ex) {
        uint32_t s = ex == 0 ? 0U : static_cast<uint32_t>(ends[ex - 1]);
        uint32_t rows = static_cast<uint32_t>(ends[ex]) - s;
        uint32_t a = lo > s ? lo : s;
        uint32_t b = hi < s + rows ? hi : s + rows;
        if (a >= b) continue;
        uint32_t eBase = ex * k * stride;
        for (uint32_t r = a; r < b; ++r) {
            // First term initialises the accumulator: one vector op less per row
            // than zero-filling and then adding it.
            auto dst = cb[(static_cast<uint64_t>(r) - lo) * pn];
            float xv = static_cast<float>(xb.GetValue(r * k));
            Muls<float, false>(dst, wf[eBase], xv, MASK_PLACEHOLDER, 1, cntUn);
            for (uint32_t kk = 1; kk < k; ++kk) {
                float xn = static_cast<float>(xb.GetValue(r * k + kk));
                Axpy<float, float, false>(dst, wf[eBase + kk * stride], xn,
                                          MASK_PLACEHOLDER, 1, cntUn);
            }
        }
    }
    SetMaskNorm();

    // One dense epilogue pass over the rows this AIV owns; z already holds C.
    uint32_t rep = pn * static_cast<uint32_t>(sizeof(float)) / 32U;
    for (uint32_t ex = 0; ex < e; ++ex) {
        uint32_t s = ex == 0 ? 0U : static_cast<uint32_t>(ends[ex - 1]);
        uint32_t rows = static_cast<uint32_t>(ends[ex]) - s;
        uint32_t a = lo > s ? lo : s;
        uint32_t b = hi < s + rows ? hi : s + rows;
        if (a >= b) continue;
        for (uint32_t off = 0; off < pn; off += 64U) {
            uint32_t mm = MinU32(64U, pn - off);
            uint32_t base = (a - lo) * pn + off;
            Mul(z[base], z[base], sc[ex * pn + off], static_cast<uint64_t>(mm), b - a,
                {1, 1, 1, static_cast<uint8_t>(rep), static_cast<uint8_t>(rep), 0});
        }
    }
    // -2 folded into both constants (a power of two, so bit-exact): one vector
    // op fewer than scaling the argument afterwards.
    Mul(u, z, z, count);
    Muls(u, u, C1C2N, count);
    Adds(u, u, C1N, count);
    Mul(u, z, u, count);
    Exp(u, u, count);
    Adds(t, u, 1.0f, count);
    Div(result, z, t, count);
    // FP32 -> FP16 for the tiny path.  CAST_ROUND rounds an exact tie up while
    // the reference rounds ties to even, so an element landing exactly on an
    // FP16 midpoint (or within the vector GELU's error of one) can differ by
    // 1 ULP; this epilogue does not carry a near-tie repair.
    Cast(yv, result, RoundMode::CAST_ROUND, count);
    // The refinement block used to carry the V->S drain; the y store needs its
    // own vector->MTE3 ordering or the copy can read yv before the cast lands.
    event_t vToMte3 = static_cast<event_t>(0);
    SetFlag<HardEvent::V_MTE3>(vToMte3);
    WaitFlag<HardEvent::V_MTE3>(vToMte3);
    // One copy per row: a multi-row copy would need a UB-side source gap, whose
    // unit is a 32B block on this path, and pn-n halfs is not one.
    for (uint32_t r = lo; r < hi; ++r) {
        DataCopyExtParams yp{1, n * static_cast<uint32_t>(sizeof(half)), 0, 0, 0};
        DataCopyPad(yg[static_cast<uint64_t>(r) * n], yv[(r - lo) * pn], yp);
    }
}

// Tiny front-end: small shapes where the staging is the cost, not the math.
//
// The staged path above copies x, W and scale into UB and then runs n-lane
// vector MACs; at these sizes the copies and their waits dominate.  This front
// end instead reads the three inputs straight from GM on the scalar pipe, keeps
// the exact int32 dot product of the reference, folds the per-channel dequant
// into the same scalar step, and plants C compactly at the real N.  Two
// consequences follow from that layout: no vector operand ever needs a row base
// of its own (so the 32B row-stride padding disappears), and the whole output
// block is one contiguous run in both UB and GM, so it leaves in a single copy.
//
// The four inputs' first lines are pulled in before anything reads them: the
// kernel is only ~1.5us, so one cold miss on the critical path is a
// double-digit percentage of the total.
//
// The epilogue is the staged path's own chain -- same constants, same
// CAST_ROUND -- so the values are not approximated anywhere.
inline bool IsTinyFrontShape(uint32_t m, uint32_t e, uint32_t k, uint32_t n)
{
    // Small-compute family only: the front end has to win back what the four
    // staged copies used to cost.
    return m >= 1U && m <= 16U && e >= 1U && e <= 128U && k >= 1U && k <= 32U &&
           static_cast<uint64_t>(m) * n <= 64U &&
           static_cast<uint64_t>(m) * n * k <= 256U;
}


__global__ __vector__ void N1Kernel(GM_ADDR x, GM_ADDR weight, GM_ADDR scale,
                                    GM_ADDR groups, GM_ADDR y,
                                    uint32_t m, uint32_t e, uint32_t k,
                                    uint32_t rowsPerBlk, uint32_t extraRows)
{
    const uint32_t blk = static_cast<uint32_t>(GetBlockIdx());
    const int64_t r0 = static_cast<int64_t>(rowsPerBlk) * blk +
                       (blk < extraRows ? blk : extraRows);
    const int64_t r1 = r0 + rowsPerBlk + (blk < extraRows ? 1U : 0U);
    if (r1 <= r0) return;

    GlobalTensor<int8_t> xg, wg;
    GlobalTensor<float> sg;
    GlobalTensor<int64_t> gg;
    GlobalTensor<half> yg;
    xg.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
    wg.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(weight));
    sg.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scale));
    gg.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups));
    yg.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y));

    const uint32_t nb = (k + 127U) & ~127U;
    TPipe pipe;
    TBuf<TPosition::VECCALC> bx, bxh, bxf, bw, bwf, bt, bc, bg, bh, b3;
    pipe.InitBuffer(bx, nb);
    pipe.InitBuffer(bxh, nb * 2U);
    pipe.InitBuffer(b3, nb * 2U);
    pipe.InitBuffer(bxf, nb * 4U);
    pipe.InitBuffer(bw, nb);
    pipe.InitBuffer(bwf, nb * 4U);
    pipe.InitBuffer(bt, nb * 4U);
    pipe.InitBuffer(bc, nb * 4U);
    pipe.InitBuffer(bg, 128U * 4U);
    pipe.InitBuffer(bh, 128U * 2U);
    auto x8 = bx.Get<int8_t>();
    auto xh = b3.Get<half>();
    auto xf = bxf.Get<float>();
    auto w8 = bw.Get<int8_t>();
    auto wh = bxh.Get<half>();
    auto wf = bwf.Get<float>();
    auto t = bt.Get<float>();
    auto c32 = bc.Get<int32_t>();
    auto gz = bg.Get<float>();
    auto gh = bh.Get<half>();

    TEventID eMv = pipe.AllocEventID<HardEvent::MTE2_V>();
    TEventID eVm = pipe.AllocEventID<HardEvent::V_MTE3>();
    TEventID eV3 = pipe.AllocEventID<HardEvent::MTE3_V>();
    TEventID eV2 = pipe.AllocEventID<HardEvent::V_MTE2>();
    DataCopyExtParams oneK{1, static_cast<uint32_t>(k), 0, 0, 0};
    DataCopyExtParams fourK{1, static_cast<uint32_t>(k * 4U), 0, 0, 0};

    const uint32_t R = 64U;                       // rows per GELU batch
    int64_t r = r0;
    for (uint32_t ex = 0; ex < e && r < r1; ++ex) {
        const int64_t eEnd = gg.GetValue(ex);
        const int64_t stop = eEnd < r1 ? eEnd : r1;
        if (stop <= r) continue;
        DataCopyPad(w8, wg[static_cast<int64_t>(ex) * k], oneK,
                    DataCopyPadExtParams<int8_t>{false, 0, 0, 0});
        SetFlag<HardEvent::MTE2_V>(eMv);
        WaitFlag<HardEvent::MTE2_V>(eMv);
        Cast(wh, w8, RoundMode::CAST_NONE, nb);
        Cast(wf, wh, RoundMode::CAST_NONE, nb);
        if (nb > k) wf.SetValue(k, 0.0f);
        const float sc = sg.GetValue(static_cast<int64_t>(ex));
        uint32_t rowsInBatch = 0;
        for (; r < stop; ) {
            const int64_t left = stop - r;
            uint32_t cnt = left > static_cast<int64_t>(R) ? R : static_cast<uint32_t>(left);
            for (uint32_t i = 0; i < cnt; ++i) {
                DataCopyPad(x8, xg[(r + i) * static_cast<int64_t>(k)], oneK,
                            DataCopyPadExtParams<int8_t>{false, 0, 0, 0});
                SetFlag<HardEvent::MTE2_V>(eMv);
                WaitFlag<HardEvent::MTE2_V>(eMv);
                Cast(xh, x8, RoundMode::CAST_NONE, nb);
                Cast(xf, xh, RoundMode::CAST_NONE, nb);
                // nb > k: the staging copy fills only k elements, so the tail
                // must read zero or a stale value joins the dot product.
                if (nb > k) xf.SetValue(k, 0.0f);
                Mul(t, xf, wf, nb);
                Cast(c32, t, RoundMode::CAST_RINT, nb);
                uint32_t len = nb;
                while (len > 8U) {
                    len >>= 1;
                    Add(c32, c32, c32[len], len);
                }
                // The vector unit needs >= 8 lanes, so the last 8 are summed as
                // scalars; int32 addition is associative, so the total is exact.
                int32_t acc = 0;
                for (uint32_t q = 0; q < 8U; ++q) acc += c32.GetValue(q);
                gz.SetValue(i, static_cast<float>(acc));
            }
            Muls(gz, gz, sc, cnt);
            Mul(t, gz, gz, cnt);
            Muls(t, t, C1C2N, cnt);
            Adds(t, t, C1N, cnt);
            Mul(t, gz, t, cnt);
            Exp(t, t, cnt);
            Adds(t, t, 1.0f, cnt);
            Div(gz, gz, t, cnt);
            Cast(gh, gz, RoundMode::CAST_ROUND, cnt);
            SetFlag<HardEvent::V_MTE3>(eVm);
            WaitFlag<HardEvent::V_MTE3>(eVm);
            DataCopyExtParams yo{1, static_cast<uint32_t>(cnt * 2U), 0, 0, 0};
            DataCopyPad(yg[r], gh, yo);
            SetFlag<HardEvent::MTE3_V>(eV3);
            WaitFlag<HardEvent::MTE3_V>(eV3);
            r += cnt;
            rowsInBatch += cnt;
        }
        SetFlag<HardEvent::V_MTE2>(eV2);
        WaitFlag<HardEvent::V_MTE2>(eV2);
    }
}

// K == 1: the grouped matmul degenerates to an outer product, C[m,n] = x[m]*w[e,n]
// is rank one, and the whole Cube -> GM -> AIV round trip (8 B of C traffic per
// output element) buys nothing: measured on 5121/5/1/4095 the C write alone runs
// at 8.2 GB/s/core against a 42 GB/s fixpipe floor, i.e. 5x the hardware cost.
// This paths computes y directly on the vector unit and never materialises C.
// z = float(x[m] * w[e,n]) * scale[e,n] is bit-exact against the reference's
// int32 product (|x*w| <= 16384 < 2^24), and the GELU chain is the epilogue's own.
__global__ __vector__ void K1Kernel(GM_ADDR x, GM_ADDR weight, GM_ADDR scale,
                                    GM_ADDR groups, GM_ADDR y,
                                    uint32_t m, uint32_t e, uint32_t n,
                                    uint32_t rowsPerBlk, uint32_t extraRows)
{
    const uint32_t blk = static_cast<uint32_t>(GetBlockIdx());
    const int64_t r0 = static_cast<int64_t>(rowsPerBlk) * blk +
                       (blk < extraRows ? blk : extraRows);
    const int64_t r1 = r0 + rowsPerBlk + (blk < extraRows ? 1U : 0U);
    if (r1 <= r0) return;

    GlobalTensor<int8_t> xg, wg;
    GlobalTensor<float> sg;
    GlobalTensor<int64_t> gg;
    GlobalTensor<half> yg;
    xg.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
    wg.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(weight));
    sg.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scale));
    gg.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups));
    yg.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y));

    const uint32_t nb = (n + 31U) & ~31U;
    TPipe pipe;
    TBuf<TPosition::VECCALC> b8, bh, bf, bs, bz, bu, by;
    pipe.InitBuffer(b8, nb);
    pipe.InitBuffer(bh, nb * 2U);
    pipe.InitBuffer(bf, nb * 4U);
    pipe.InitBuffer(bs, nb * 8U);
    pipe.InitBuffer(bz, nb * 8U);
    pipe.InitBuffer(bu, nb * 8U);
    pipe.InitBuffer(by, nb * 4U);
    auto w8 = b8.Get<int8_t>();
    auto wH = bh.Get<half>();
    auto wF = bf.Get<float>();
    auto sF = bs.Get<float>();
    auto z = bz.Get<float>();
    auto u = bu.Get<float>();
    auto yb = by.Get<half>();

    TEventID eMv = pipe.AllocEventID<HardEvent::MTE2_V>();
    TEventID eVm = pipe.AllocEventID<HardEvent::V_MTE3>();
    TEventID eV3 = pipe.AllocEventID<HardEvent::MTE3_V>();
    TEventID eV2 = pipe.AllocEventID<HardEvent::V_MTE2>();
    DataCopyExtParams one{1, static_cast<uint32_t>(n), 0, 0, 0};
    int64_t r = r0;
    for (uint32_t ex = 0; ex < e && r < r1; ++ex) {
        const int64_t eEnd = gg.GetValue(ex);
        const int64_t stop = eEnd < r1 ? eEnd : r1;
        if (stop <= r) continue;
        DataCopyPad(w8, wg[static_cast<int64_t>(ex) * n], one,
                    DataCopyPadExtParams<int8_t>{false, 0, 0, 0});
        DataCopyExtParams four{1, static_cast<uint32_t>(n * 4U), 0, 0, 0};
        DataCopyPad(sF, sg[static_cast<int64_t>(ex) * n], four,
                    DataCopyPadExtParams<float>{false, 0, 0, 0.0f});
        DataCopyPad(sF[nb], sg[static_cast<int64_t>(ex) * n], four,
                    DataCopyPadExtParams<float>{false, 0, 0, 0.0f});
        SetFlag<HardEvent::MTE2_V>(eMv);
        WaitFlag<HardEvent::MTE2_V>(eMv);
        Cast(wH, w8, RoundMode::CAST_NONE, n);
        Cast(wF, wH, RoundMode::CAST_NONE, n);
        for (; r < stop; ++r) {
            // Two rows per vector pass: only the row-scalar multiply differs per
            // row, so the other nine elementwise ops cover both rows at once and
            // the instruction count halves on a chain that measures 23% of the
            // vector throughput (latency bound, see the elementwise skill card's
            // "loop unrolling exposes ILP" point).  Rows live at a 32-byte
            // aligned stride nb because n is not one.
            const uint32_t cnt = (r + 1 < stop) ? 2U : 1U;
            const uint32_t span = nb * cnt;
            Muls(z, wF, static_cast<float>(xg.GetValue(r)), nb);
            if (cnt == 2U) {
                Muls(z[nb], wF, static_cast<float>(xg.GetValue(r + 1)), nb);
            }
            Mul(z, z, sF, span);
            Mul(u, z, z, span);
            Muls(u, u, C1C2N, span);
            Adds(u, u, C1N, span);
            Mul(u, z, u, span);
            Exp(u, u, span);
            Adds(u, u, 1.0f, span);
            Div(z, z, u, span);
            Cast(yb, z, RoundMode::CAST_ROUND, span);
            SetFlag<HardEvent::V_MTE3>(eVm);
            WaitFlag<HardEvent::V_MTE3>(eVm);
            DataCopyExtParams yo{1, static_cast<uint32_t>(n * 2U), 0, 0, 0};
            DataCopyPad(yg[r * static_cast<int64_t>(n)], yb, yo);
            if (cnt == 2U) {
                DataCopyPad(yg[(r + 1) * static_cast<int64_t>(n)], yb[nb], yo);
            }
            r += cnt - 1U;
            // yb is reused by the next row's Cast, so the store must land first.
            SetFlag<HardEvent::MTE3_V>(eV3);
            WaitFlag<HardEvent::MTE3_V>(eV3);
        }
        // w8/sF/wF belong to this expert; the next expert's DataCopyPad must not
        // overwrite them while the vector pipe is still reading.
        SetFlag<HardEvent::V_MTE2>(eV2);
        WaitFlag<HardEvent::V_MTE2>(eV2);
    }
}

// One block per row-set; the host splits M as evenly as it can.
__global__ __vector__ void TinyFrontKernel(GM_ADDR x, GM_ADDR weight, GM_ADDR scale,
                                           GM_ADDR groups, GM_ADDR y,
                                           uint32_t k, uint32_t n, uint32_t e,
                                           uint32_t rowsPerBlk, uint32_t extraRows)
{
    const uint32_t blk = static_cast<uint32_t>(GetBlockIdx());
    const int64_t r0 = static_cast<int64_t>(rowsPerBlk) * blk +
                       (blk < extraRows ? blk : extraRows);
    const int64_t r1 = r0 + rowsPerBlk + (blk < extraRows ? 1U : 0U);

    // Warm every input's first line up front, so the four misses resolve against
    // each other instead of one behind the other on the critical path.
    GlobalTensor<uint64_t> warm;
    warm.SetGlobalBuffer(reinterpret_cast<__gm__ uint64_t*>(groups));
    DataCachePreload(warm, static_cast<int16_t>(0));
    warm.SetGlobalBuffer(reinterpret_cast<__gm__ uint64_t*>(x));
    DataCachePreload(warm, static_cast<int16_t>(0));
    warm.SetGlobalBuffer(reinterpret_cast<__gm__ uint64_t*>(weight));
    DataCachePreload(warm, static_cast<int16_t>(0));
    warm.SetGlobalBuffer(reinterpret_cast<__gm__ uint64_t*>(scale));
    DataCachePreload(warm, static_cast<int16_t>(0));

    GlobalTensor<int8_t> xg, wg;
    GlobalTensor<float> sg;
    GlobalTensor<int64_t> gg;
    GlobalTensor<half> yg;
    xg.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
    wg.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(weight));
    sg.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scale));
    gg.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups));
    yg.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y));

    // Four 32B-aligned 64-lane regions.  The epilogue always issues one
    // full-width pass from a region base, which is what keeps the shape's real
    // width out of the alignment requirement.
    const uint32_t lanes = 64U;
    LocalTensor<float> zc(TPosition::VECCALC, 0, lanes);
    LocalTensor<float> t1(TPosition::VECCALC, 256, lanes);
    LocalTensor<float> t2(TPosition::VECCALC, 512, lanes);
    LocalTensor<float> t3(TPosition::VECCALC, 768, lanes);
    LocalTensor<half> yb(TPosition::VECCALC, 1024, lanes);

    // Lanes past the real element count are still read by the full-width
    // epilogue, so they start from zero rather than from stale UB.
    Duplicate(zc, 0.0f, lanes);
    event_t eVs = static_cast<event_t>(0);
    SetFlag<HardEvent::V_S>(eVs);
    WaitFlag<HardEvent::V_S>(eVs);

    int64_t r = r0;
    for (uint32_t ex = 0; ex < e && r < r1; ++ex) {
        const int64_t eEnd = gg.GetValue(ex);
        const int64_t stop = eEnd < r1 ? eEnd : r1;
        for (; r < stop; ++r) {
            for (uint32_t c = 0; c < n; ++c) {
                // Exact int32 dot product, exactly as the reference forms it;
                // one conversion to float at the end.
                int32_t acc = 0;
                if (k <= 4U) {
                    const int64_t xRow = r * k;
                    const int64_t wCol = static_cast<int64_t>(ex) * k * n + c;
                    acc = static_cast<int32_t>(xg.GetValue(xRow)) *
                          static_cast<int32_t>(wg.GetValue(wCol));
                    if (k >= 2U) {
                        acc += static_cast<int32_t>(xg.GetValue(xRow + 1)) *
                               static_cast<int32_t>(wg.GetValue(wCol + n));
                    }
                    if (k >= 3U) {
                        acc += static_cast<int32_t>(xg.GetValue(xRow + 2)) *
                               static_cast<int32_t>(wg.GetValue(wCol + 2 * n));
                    }
                    if (k >= 4U) {
                        acc += static_cast<int32_t>(xg.GetValue(xRow + 3)) *
                               static_cast<int32_t>(wg.GetValue(wCol + 3 * n));
                    }
                } else {
                    for (uint32_t kk = 0; kk < k; ++kk) {
                        acc += static_cast<int32_t>(xg.GetValue(r * k + kk)) *
                               static_cast<int32_t>(
                                   wg.GetValue((static_cast<int64_t>(ex) * k + kk) * n + c));
                    }
                }
                zc.SetValue(static_cast<uint32_t>(r - r0) * n + c,
                            static_cast<float>(acc) *
                                sg.GetValue(static_cast<int64_t>(ex) * n + c));
            }
        }
    }
    event_t eSv = static_cast<event_t>(1);
    SetFlag<HardEvent::S_V>(eSv);
    WaitFlag<HardEvent::S_V>(eSv);

    // The staged path's epilogue chain, unchanged and full width.
    Mul(t1, zc, zc, lanes);
    Muls(t1, t1, C1C2N, lanes);
    Adds(t1, t1, C1N, lanes);
    Mul(t1, zc, t1, lanes);
    Exp(t1, t1, lanes);
    Adds(t2, t1, 1.0f, lanes);
    Div(t3, zc, t2, lanes);
    Cast(yb, t3, RoundMode::CAST_ROUND, lanes);
    event_t eVm = static_cast<event_t>(2);
    SetFlag<HardEvent::V_MTE3>(eVm);
    WaitFlag<HardEvent::V_MTE3>(eVm);
    // One contiguous writeback: rows are packed at the real N in UB and in GM.
    DataCopyExtParams yp{1, static_cast<uint32_t>((r1 - r0) * n) * 2U, 0, 0, 0};
    DataCopyPad(yg[r0 * n], yb, yp);
}

// Tiny shapes run on a vector-only kernel: they never touch the Cube, so there is
// no reason to bring an AIC into the block.  One block per AIV, and the two
// blocks split the rows exactly as the mix kernel did.
__global__ __vector__ void TinyKernel(GM_ADDR x, GM_ADDR weight, GM_ADDR scale,
                                      GM_ADDR groups, GM_ADDR y,
                                      uint32_t m, uint32_t e, uint32_t k, uint32_t n)
{
    RunTinyFast(x, weight, scale, groups, y, m, e, k, n, GetBlockIdx());
}

// Two instantiations: PACK=false contains no repack code at all.  Keeping the
// repack out of the non-repack binary matters -- with the block merely present
// (never executed) the vector kernel measured 9% slower on every other shape,
// purely from code layout and register pressure.
template <bool PACK, bool LAZY, uint32_t QD = 2, bool PAIR = false, bool SEQ = false,
          uint32_t FLAT = 0>
__global__ __mix__(1, 2) void Kernel(GM_ADDR x, GM_ADDR weight, GM_ADDR scale,
                                   GM_ADDR groups, GM_ADDR y, GM_ADDR workspace,
                                   GM_ADDR config, uint32_t km, uint32_t ke,
                                   uint32_t kk, uint32_t kn, uint32_t ktiny,
                                   GM_ADDR packGm, GM_ADDR flagGm, uint32_t kpack)
{
    Config cfg;
    TPipe pipe;
    if ASCEND_IS_AIC {
        // Tiny never reaches the Cube: one shape word settles it, so the ten
        // header words and the whole tiling stay unread.
        if (ktiny == 0) {
            LoadHeader(config, cfg);
            if (cfg.manual == 0) LoadTiling(config, cfg);
            Tasks tasks;
            tasks.template InitScalar<LAZY>(groups, cfg);
            if constexpr (PACK) {
                // The packed B is produced by this block's AIVs, which signal
                // after the global AIV barrier has passed.  Under PACKOVL the
                // wait moves into RunCubeStream, past the first task's decode
                // and A staging.
                if (cfg.packOvl == 0U) CrossCoreWaitFlag(6);
            }
            if (cfg.manual == 2) {
                RunCubeStream<false, SEQ>(x, kpack != 0 ? packGm : weight, workspace, cfg, tasks,
                              pipe, kpack);
            } else if (cfg.manual != 0) {
                RunCubeManual<LAZY>(x, kpack != 0 ? packGm : weight, workspace, cfg, tasks, pipe,
                              kpack);
            } else {
                RunCube<LAZY>(x, kpack != 0 ? packGm : weight, workspace, cfg, tasks, pipe);
            }
        }
    }
    if ASCEND_IS_AIV {
        // Tiny never reaches this kernel: run_kernel launches TinyKernel instead.
        Tasks tasks;
        tasks.template InitUb<LAZY>(groups, cfg, pipe, config);
        if constexpr (PACK) {
          if (ktiny == 0 && kpack != 0) {
            // Repack B into a 32-byte aligned row stride (the whole tensor is a
            // contiguous run of e*k rows; the GM-side dstStride of DataCopyPad is
            // a byte count, so a `kpack - n` byte gap per row is expressible).
            event_t eM2M3[2] = {
                static_cast<event_t>(GetTPipePtr()->AllocEventID<HardEvent::MTE2_MTE3>()),
                static_cast<event_t>(GetTPipePtr()->AllocEventID<HardEvent::MTE2_MTE3>())};
            event_t eM3M2r[2] = {
                static_cast<event_t>(GetTPipePtr()->AllocEventID<HardEvent::MTE3_MTE2>()),
                static_cast<event_t>(GetTPipePtr()->AllocEventID<HardEvent::MTE3_MTE2>())};
            event_t eM3S = static_cast<event_t>(GetTPipePtr()->AllocEventID<HardEvent::MTE3_S>());

            // Two staging buffers, so one block's read (MTE2) runs while the
            // previous block's write (MTE3) drains.  The old single buffer paid
            // a read wait plus a write wait for every 32-row block and moved
            // 34 MB (cat08) at only ~1.8 MB/us - far under the DMA rate, i.e.
            // completely latency bound.  The block size is chosen so both
            // buffers together stay under 40 KB per band.
            const uint32_t kpackStride = (cfg.n + 31U) & ~31U;
            uint32_t RC = (cfg.nReal != cfg.n) ? 32U : 16U;
            if (RC > 1U && RC * kpackStride > 16384U) RC = 16384U / kpackStride;
            if (RC < 8U) RC = 8U;
            TBuf<TPosition::VECCALC> rbuf[2];
            pipe.InitBuffer(rbuf[0], RC * kpackStride);
            pipe.InitBuffer(rbuf[1], RC * kpackStride);
            LocalTensor<int8_t> rt[2] = {rbuf[0].Get<int8_t>(), rbuf[1].Get<int8_t>()};
            GlobalTensor<int8_t> rsrc, rdst;
            rsrc.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(weight));
            rdst.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(packGm));
            // The packed tensor has e * kPad rows: each expert's K range is
            // padded up to a 32-byte multiple with zero rows, so the Cube never
            // has to stage a partial K block (an Nd2Nz with a non-32-aligned
            // dValue is not something this hardware handles well).  The padding
            // rows also make A's K overrun harmless: whatever A reads past its
            // own K is multiplied by these zeros.
            const uint32_t kPad = (cfg.nReal != cfg.n && cfg.manual != 2) ? cfg.k : ((cfg.k + 31U) & ~31U);
            // Empty experts own no rows and no tasks, so their packed-B blocks
            // are never read: skip them instead of copying E*kPad rows.  The
            // packed slots keep the original per-expert offsets (only the work
            // assignment is compacted), and the rows of the active experts are
            // split evenly over every launched AIV.  When every expert is
            // non-empty the original loop runs unchanged.
            uint32_t active = 0;
            for (uint32_t ae = 0; ae < cfg.e; ++ae) {
                if (tasks.Rows(ae) != 0U) ++active;
            }
            const bool compact = active != cfg.e && active != 0U;
            uint64_t rows = (compact ? static_cast<uint64_t>(active)
                                     : static_cast<uint64_t>(cfg.e)) * kPad;
            // Split the rows over the AIVs that were actually launched: the grid
            // shrinks on small shapes, and a hardcoded 40 would leave every row
            // past the real AIV count unpacked (and therefore stale).  Either
            // reading of GetBlockNum() on AIV (per-core or per-subcore) covers
            // every row exactly once, because r1 is clamped to the row count.
            // GetBlockNum() counts blocks, and this kernel is __mix__(1, 2), so
            // the vector cores are twice that many.  Using the block count
            // directly leaves half the AIVs idle and doubles the repack time.
            uint64_t aivs = 2U * static_cast<uint64_t>(GetBlockNum());
            uint64_t per = (rows + aivs - 1U) / aivs;
            uint64_t r0 = static_cast<uint64_t>(GetBlockIdx()) * per;
            uint64_t r1 = r0 + per < rows ? r0 + per : rows;
            GlobalTensor<int8_t> zsrc;
            zsrc.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(flagGm) + 4096U);
            uint64_t r = r0;
            uint64_t blkRow[2] = {0, 0};
            uint32_t blkCnt[2] = {0, 0};
            bool blkZero[2] = {false, false};
            bool blkBusy[2] = {false, false};
            bool blkRead[2] = {false, false};
            // Issue one read into slot `sl` and advance the row cursor.
#define GMM_PACK_READ(sl)                                                              \
            {                                                                          \
                uint64_t ex;                                                           \
                uint32_t kk;                                                           \
                if (compact) {                                                         \
                    uint32_t cb = static_cast<uint32_t>(r / kPad);                     \
                    uint32_t a = 0;                                                    \
                    uint32_t ee = 0;                                                   \
                    for (; ee < cfg.e; ++ee) {                                         \
                        if (tasks.Rows(ee) != 0U) { if (a == cb) break; ++a; }         \
                    }                                                                  \
                    ex = ee;                                                           \
                    kk = static_cast<uint32_t>(r - static_cast<uint64_t>(cb) * kPad);  \
                    blkRow[sl] = ex * kPad + kk;                                       \
                } else {                                                               \
                    ex = r / kPad;                                                     \
                    kk = static_cast<uint32_t>(r - ex * kPad);                         \
                    blkRow[sl] = r;                                                    \
                }                                                                      \
                if (kk < cfg.k) {                                                      \
                    uint32_t cnt = static_cast<uint32_t>(r1 - r < RC ? r1 - r : RC);   \
                    if (cnt > cfg.k - kk) cnt = cfg.k - kk;                            \
                    DataCopyExtParams rp{static_cast<uint16_t>(cnt),                   \
                                         static_cast<uint32_t>(cfg.nReal), 0, 0, 0};   \
                    DataCopyPad(rt[sl], rsrc[(ex * cfg.k + kk) * cfg.nReal], rp,       \
                                DataCopyPadExtParams<int8_t>{false, 0, 0, 0});         \
                    blkCnt[sl] = cnt;                                                  \
                    blkZero[sl] = false;                                               \
                    r += cnt;                                                          \
                } else {                                                               \
                    uint32_t cnt = static_cast<uint32_t>(r1 - r < 16 ? r1 - r : 16);   \
                    if (cnt > kPad - kk) cnt = kPad - kk;                              \
                    DataCopyExtParams zr{static_cast<uint16_t>(cnt),                   \
                                         static_cast<uint32_t>(kpack), 0, 0, 0};       \
                    DataCopyPad(rt[sl], zsrc, zr, DataCopyPadExtParams<int8_t>{false, 0, 0, 0}); \
                    blkCnt[sl] = cnt;                                                  \
                    blkZero[sl] = true;                                                \
                    r += cnt;                                                          \
                }                                                                      \
                blkBusy[sl] = true;                                                    \
                blkRead[sl] = true;                                                    \
                SetFlag<HardEvent::MTE2_MTE3>(eM2M3[sl]);                              \
            }
            // Wait the read, issue the write, and leave the slot to drain.
#define GMM_PACK_WRITE(sl)                                                             \
            {                                                                          \
                WaitFlag<HardEvent::MTE2_MTE3>(eM2M3[sl]);                             \
                if (!blkZero[sl]) {                                                    \
                    DataCopyExtParams wp{static_cast<uint16_t>(blkCnt[sl]),            \
                                         static_cast<uint32_t>(cfg.nReal), 0,          \
                                         static_cast<uint32_t>(kpack - cfg.nReal), 0}; \
                    DataCopyPad(rdst[blkRow[sl] * kpack], rt[sl], wp);                 \
                } else {                                                               \
                    DataCopyExtParams zp{static_cast<uint16_t>(blkCnt[sl]),            \
                                         static_cast<uint32_t>(kpack), 0, 0, 0};       \
                    DataCopyPad(rdst[blkRow[sl] * kpack], rt[sl], zp);                 \
                }                                                                      \
                blkRead[sl] = false;                                                   \
                SetFlag<HardEvent::MTE3_MTE2>(eM3M2r[sl]);                             \
            }
            if (r < r1) GMM_PACK_READ(0)
            if (r < r1) GMM_PACK_READ(1)
            for (uint32_t turn = 0; blkBusy[0] || blkBusy[1]; turn ^= 1U) {
                uint32_t sl = turn;
                if (!blkBusy[sl]) continue;
                if (blkRead[sl]) {
                    if (sl == 0) GMM_PACK_WRITE(0) else GMM_PACK_WRITE(1)
                } else {
                    // The write has drained; the slot is reusable.  Waiting for
                    // the write only here is what lets it overlap the other
                    // slot's read.
                    WaitFlag<HardEvent::MTE3_MTE2>(eM3M2r[sl]);
                    blkBusy[sl] = false;
                    if (r < r1) {
                        if (sl == 0) GMM_PACK_READ(0) else GMM_PACK_READ(1)
                    }
                }
            }
#undef GMM_PACK_READ
#undef GMM_PACK_WRITE
            SetFlag<HardEvent::MTE3_S>(eM3S);
            WaitFlag<HardEvent::MTE3_S>(eM3S);
            // Hardware AIV-only barrier.  SyncAll<true>() emits
            // ffts_cross_core_sync(PIPE_MTE3, SYNC_AIV_ONLY_ALL) and waits on
            // that resource; because the sync rides the MTE3 queue, every
            // repack store issued above is complete before the barrier can
            // pass.  A hand-rolled poll does not work here: neither a scalar GM
            // read nor a DMA read observes another AIV's fresh 4-byte store.
            SyncAll<true>();
            CrossCoreSetFlag<2, PIPE_MTE3>(6);
          }
        }
        Epilogue<QD, PAIR> op;
        op.Init(workspace, scale, y, pipe, cfg);
        uint32_t core = GetBlockIdx() / 2;
        uint32_t sub = GetBlockIdx() % 2;
        // FlatRun ignores this in the lazy instantiation and needs the scanned
        // count in the eager one.
        uint32_t total = tasks.prefix[cfg.e];
        // Compile-time split: 1 = flat half only, 0 = block half only, 2 = the
        // pre-split runtime branch (both instantiated).  The measured gain lives
        // in the pack/seq instances (cat13 -5.7%), so those use 0; the no-pack
        // instances keep 2, i.e. exactly the old code, so they cannot regress.
        if constexpr (FLAT == 1U) {
            op.template FlatRun<LAZY>(tasks, cfg, core, sub, total);
        } else {
        if constexpr (FLAT == 2U) {
            if (cfg.flat != 0) {
                op.template FlatRun<LAZY>(tasks, cfg, core, sub, total);
                PipeBarrier<PIPE_ALL>();
                return;
            }
        }
        uint32_t iter = 0;
        // Must mirror the AIC's task order exactly, or the ready/done handshake
        // desynchronises.  Blocked runs only where the AIC keeps A resident.
        uint32_t qFirst = core, qLast = total, qIncr = cfg.cores;
        TaskSequence seq;
        bool seqOk = false;
        if constexpr (SEQ) {
            if (cfg.manual != 0 && tasks.nTiles > 1U) {
                seqOk = MakeTaskSequence(cfg, tasks, core, seq);
                if (seqOk) { qFirst = 0; qLast = seq.Count(); }
            }
        }
        if (tasks.nTiles > 1U && cfg.manual != 0) {
            if (!seqOk) {
                uint32_t chunk = (total + cfg.cores - 1U) / cfg.cores;
                qFirst = core * chunk;
                qLast = MinU32(total, qFirst + chunk);
            }
            qIncr = 1;
        }
        for (uint32_t ql = qFirst; ql < qLast; ql += qIncr, ++iter) {
            const uint32_t q = seqOk ? seq.OriginalTask(ql) : ql;
            uint32_t e, row, col, rows, cols;
            tasks.template Decode<LAZY>(q, e, row, col, rows, cols, cfg);
            // A padded Cube task carries up to 127 columns past the real N; the
            // vector side must stop at it (the Cube still computes them and
            // lands them in the C row padding).
            if (col + cols > cfg.nReal) cols = cfg.nReal - col;
            // Merge the next task into this epilogue block when it is the
            // adjacent column of the same row tile and still inside the real N.
            // Two 128-wide Cube tasks then become one 16x256 block: the same
            // 4096 elements per block, but 512B per y row instead of 256B.
            // Only the PAIR instance carries this probe at all.
            [[maybe_unused]] bool pair = false;
            if constexpr (PAIR) {
                uint32_t qln = ql + qIncr;
                uint32_t qn = seqOk ? (qln < qLast ? seq.OriginalTask(qln) : 0U) : qln;
                pair = qIncr == 1U && qln < qLast;
                if (pair) {
                    uint32_t e2, row2, col2, rows2, cols2;
                    tasks.template Decode<LAZY>(qn, e2, row2, col2, rows2, cols2, cfg);
                    if (col2 + cols2 > cfg.nReal) cols2 = cfg.nReal - col2;
                    pair = e2 == e && row2 == row && col2 == col + cols &&
                           cols == cfg.nbc && cols2 == cfg.nbc &&
                           col + cols + cols2 <= cfg.nReal;
                }
            }
            CrossCoreWaitFlag(static_cast<uint16_t>((FLAG_READY + iter) % 11));
            if constexpr (PAIR) {
                if (pair) {
                    // The merged block covers both tasks, so it consumes both READY
                    // slots and answers both with a DONE below.
                    ++iter;
                    CrossCoreWaitFlag(static_cast<uint16_t>((FLAG_READY + iter) % 11));
                    cols += cfg.nbc;
                }
            }
            uint32_t bcol = op.BlockCols();
            uint32_t rowsPer = op.RowsPer();
            if constexpr (PAIR) {
                if (pair) {
                    bcol = 2U * BN;
                    rowsPer = 16U;
                }
            }
            // Split the tile evenly between the two AIVs of this group.  A fixed
            // BM/2 row split idles the second AIV whenever the expert has fewer
            // than BM rows (the common many-expert case), so split by rows and
            // fall back to a column split for single-row tiles.  A split costs a
            // second per-tile epilogue setup, so tiny tiles stay with one AIV.
            uint32_t r0 = 0, rn = rows, c0 = 0, cn = cols;
            if (rows * cols < 512) {
                if (sub != 0) rn = 0;
            } else if (rows >= 2) {
                uint32_t halfRows = (rows + 1) / 2;
                r0 = sub * halfRows;
                rn = r0 < rows ? MinU32(halfRows, rows - r0) : 0;
            } else {
                uint32_t halfCols = (cols + 1) / 2;
                c0 = sub * halfCols;
                cn = c0 < cols ? MinU32(halfCols, cols - c0) : 0;
            }
            // A Cube task spans NBC columns; the epilogue consumes it in BN-wide
            // blocks.
            op.Tile(e, row + r0, col + c0, rn, cn, cfg, bcol, rowsPer);
            // Every GM read of this tile half has already been consumed by the
            // vector math, so releasing the slot here is safe.  The workspace
            // slot is protected by the C read (MTE2), not by the y store.
            CrossCoreSetFlag<2, PIPE_MTE2>(FLAG_DONE);
            if constexpr (PAIR) {
                if (pair) {
                    CrossCoreSetFlag<2, PIPE_MTE2>(FLAG_DONE);
                    ql += 1U;
                }
            }
        }
        }
        PipeBarrier<PIPE_ALL>();
    }
}

// Minimal single-task Cube for SmallKernel: one A staging, one B staging, one
// L0 load pair, one MMA and one fixpipe, with fixed L1/L0 addresses and two
// fixed event ids instead of a TPipe (SOC init + buffer pool), six allocated
// event ids and the double-buffered K pipeline the generic manual path carries.
// The host only selects this kernel for k % 32 == 0, so both staging paths are
// the simple full-block ones and the K tail needs no guard.
__aicore__ inline void SmallCube(GM_ADDR x, GM_ADDR weight, GM_ADDR workspace,
                                 uint32_t m, uint32_t k, uint32_t n)
{
    GlobalTensor<int8_t> a, b;
    GlobalTensor<int32_t> c;
    a.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
    b.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(weight));
    c.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(workspace));
    const uint32_t aBytes = AlignUp32(m * k);
    const uint32_t bBytes = AlignUp32(k * n);
    LocalTensor<int8_t> l1a(TPosition::A1, 0U, aBytes);
    LocalTensor<int8_t> l1b(TPosition::A1, aBytes, bBytes);
    LocalTensor<int8_t> l0a(TPosition::A2, 0U, AlignUp32(m * k));
    LocalTensor<int8_t> l0b(TPosition::B2, 0U, AlignUp32(k * n));
    LocalTensor<int32_t> l0c(TPosition::CO1, 0U, m * n);
    CubeStageA(l1a, a, m, k, k);
    CubeStageB(l1b, b, k, n, n);   // B rows are [K][N]: row stride is n, not k
    SetFlag<HardEvent::MTE2_MTE1>(0);
    WaitFlag<HardEvent::MTE2_MTE1>(0);
    CubeTensorA(l0a, l1a, m, k);
    CubeTensorB(l0b, l1b, n, k);
    SetFlag<HardEvent::MTE1_M>(1);
    WaitFlag<HardEvent::MTE1_M>(1);
    MmadParams mp;
    // The MMA has no single-row mode: madM == 1 widens to one fractal.
    mp.m = static_cast<uint16_t>(m == 1U ? CB16 : m);
    mp.n = static_cast<uint16_t>(n);
    mp.k = static_cast<uint16_t>(AlignUp32(k));
    mp.cmatrixInitVal = true;
    mp.cmatrixSource = false;
    mp.unitFlag = 3;
    Mmad(l0c, l0a, l0b, mp);
    CubeCtx t;
    t.c1 = l0c;
    CubeFixpipe(t, c, 0, m, n, CStride(n, k));
    CrossCoreSetFlag<2, PIPE_FIX>(static_cast<uint16_t>(FLAG_READY));
}

__global__ __mix__(1, 2) void SmallKernel(GM_ADDR x, GM_ADDR weight, GM_ADDR scale,
                                          GM_ADDR y, GM_ADDR workspace,
                                          uint32_t m, uint32_t k, uint32_t n, uint32_t cStr)
{
    // Two core groups.  A single-block __mix__ launch pays about 2.35 us of
    // dispatch on this device where a two-block one pays about 0.81 (the same
    // measurement that made the tiny path use two blocks), and halving the rows
    // keeps every stage of the one block's AIC+AIV chain.  Each block owns rows
    // [r0, r0+ml) of x / C / y; B and scale are shared (one expert).
    const uint32_t rm = (m + 1U) / 2U;
    // The AIC sees block index 0..1; the AIVs see 0..3 (two per group), so the
    // group index is idx/2 on the vector side - the same convention the block
    // kernel uses (`core = GetBlockIdx() / 2`).
    if ASCEND_IS_AIC {
        const uint32_t r0 = static_cast<uint32_t>(GetBlockIdx()) * rm;
        if (r0 >= m) return;
        SmallCube(x + static_cast<uint64_t>(r0) * k, weight,
                  workspace + static_cast<uint64_t>(r0) * cStr * sizeof(int32_t),
                  MinU32(rm, m - r0), k, n);
    }
    if ASCEND_IS_AIV {
        const uint32_t g = static_cast<uint32_t>(GetBlockIdx()) / 2U;
        const uint32_t r0 = g * rm;
        if (r0 >= m) return;
        const uint32_t ml = MinU32(rm, m - r0);
        Config cfg{};
        cfg.m = ml; cfg.e = 1U; cfg.k = k; cfg.n = n; cfg.nReal = n;
        cfg.cores = 1U; cfg.nbc = n; cfg.bm = ml; cfg.manual = 1U; cfg.flat = 1U;
        cfg.bStride = n; cfg.tiny = 0U;
        Tasks tasks;
        tasks.ends[0] = static_cast<int64_t>(ml);
        tasks.prefix[0] = 0U;
        tasks.prefix[1] = 1U;
        tasks.nTiles = 1U;
        TPipe pipe;
        Epilogue<2, false> op;
        op.Init(workspace + static_cast<uint64_t>(r0) * cStr * sizeof(int32_t), scale,
                y + static_cast<uint64_t>(r0) * n * sizeof(half), pipe, cfg);
        op.template FlatRun<false>(tasks, cfg, 0U, static_cast<uint32_t>(GetBlockIdx()) % 2U, 1U);
    }
}

inline void CheckAcl(aclError status)
{
    if (status != ACL_SUCCESS) throw std::runtime_error("GroupedMatmulGelu ACL error: " + std::to_string(status));
}

class DeviceAllocation {
public:
    // A zero size allocates nothing; a real aclrtMalloc costs tens of
    // microseconds per call, which is more than the kernel on small shapes.
    explicit DeviceAllocation(size_t bytes) {
        if (bytes != 0) CheckAcl(aclrtMalloc(&ptr, bytes, ACL_MEM_MALLOC_HUGE_FIRST));
    }
    ~DeviceAllocation() { if (ptr) aclrtFree(ptr); }
    void* ptr = nullptr;
    DeviceAllocation(const DeviceAllocation&) = delete;
    DeviceAllocation& operator=(const DeviceAllocation&) = delete;
};
} // namespace grouped_matmul_gelu

extern "C" void run_kernel(
    GM_ADDR x, const TensorGroupInfo& info_x,
    GM_ADDR weight, const TensorGroupInfo& info_weight,
    GM_ADDR scale, const TensorGroupInfo& info_scale,
    GM_ADDR group_list, const TensorGroupInfo& info_group_list,
    GM_ADDR y, const TensorGroupInfo& info_y,
    int64_t availableCoreNum, aclrtStream stream)
{
    using namespace grouped_matmul_gelu;
    Config cfg{};
    cfg.m = static_cast<uint32_t>(info_x.tensors[0].shape[0]);
    cfg.k = static_cast<uint32_t>(info_x.tensors[0].shape[1]);
    cfg.e = static_cast<uint32_t>(info_weight.tensors[0].shape[0]);
    cfg.n = static_cast<uint32_t>(info_weight.tensors[0].shape[2]);
    cfg.nReal = cfg.n;
    const bool padB32 = ((cfg.n % 32U) != 0U && (cfg.k % 32U) == 0U && cfg.k <= 8192U &&
                         cfg.n <= 4096U &&
                         static_cast<uint64_t>(cfg.m) * cfg.k >= 8000000ULL &&
                         static_cast<uint64_t>(cfg.e) * cfg.k * cfg.n <= 160ULL * 1024U * 1024U);
    // Padded-N Cube path.  The Cube's column split only lands on the fast
    // geometry when every task width is a multiple of 128 and B rows are 32B
    // aligned (measured: N=1025 98 us vs N=1024 55 us, and the same pair at
    // 385/384).  For an N that is neither, run the GEMM at the next multiple of
    // 128 over a repacked B and let the epilogue read only the real columns.
    // k % 32 != 0 keeps the hand-written paths out of this (they require
    // k % 32 == 0, so manual stays 0 and the API Cube runs).
    const bool packbShape = (cfg.k <= 4095U && (cfg.n % 32U) != 0U &&
                             cfg.n > 512U && (cfg.n % 256U) >= 32U);
    const bool padN = padB32 || (cfg.n > 256U && cfg.n <= 2048U &&
                       (cfg.n % 128U) != 0U && cfg.k <= 8192U && (cfg.k % 32U) != 0U &&
                       static_cast<uint64_t>(cfg.e) * cfg.k * cfg.n <= 20ULL * 1024U * 1024U);
    // PROBE: pad to 256 when the A-resident slab pipeline would then take it.
    const bool slabShape = (((cfg.k + 31U) & ~31U) >= 512U && cfg.k <= 4095U);
    // The same padded geometry without repacking B.  For an odd-N shape whose B
    // is too large to repack (E*K*N > 20 MB), the Cube computes the padded width
    // while reading the original tensor at its real row stride: the surplus
    // columns of every expert but the last run into the next expert's rows, and
    // the last expert's last column task is slid back (Tasks::Decode).  Only the
    // slab pipeline can afford an unaligned B stride (measured on the 2559/32/
    // 1027/773 shape: 51.8 us mte2 against 102.1 on the Matmul API), so this
    // route is gated on the grid the slab needs.
    const bool padOnly = (!padN && cfg.n > BN && cfg.n <= 2048U &&
                          (cfg.n % 256U) != 0U && cfg.k <= 4095U && slabShape &&
                          ((static_cast<uint64_t>(cfg.m) + 127U) / 128U) *
                              (((static_cast<uint64_t>(cfg.n) + 255U) / 256U)) >= 20ULL);
    // Rounding width for a padded N.  256 keeps every column task uniform when
    // the Cube will run 256-wide tasks, but an expert that fits in one <=256-row
    // tile takes 128-wide tasks (the row-tile rule below), and then 128 is
    // enough: cat08 1025 -> 1152 instead of 1280, cat14 769 -> 896 instead of
    // 1024, i.e. one whole 128-wide column task of padding removed.
    const uint64_t avgRowsPad = (static_cast<uint64_t>(cfg.m) + cfg.e - 1U) / cfg.e;
    const bool narrowPad = avgRowsPad > BM && avgRowsPad <= 256U;
    if (padN || padOnly) {
        // cat07-class: N=513 at a 128-wide pad leaves a 640-wide Cube row (5
        // tasks of 128) where a 768-wide pad gives three whole 256-wide tasks;
        // the epilogue reads only nReal columns either way.
        const bool widePad = cfg.e <= 4U && cfg.k >= 4096U;
        const uint32_t padStep = padB32 ? 512U
            : (((slabShape && !narrowPad) || widePad) ? 256U : 128U);
        cfg.n = (cfg.n + padStep - 1U) & ~(padStep - 1U);
    }
    if (availableCoreNum <= 0) throw std::runtime_error("No available Cube cores");
    // Launch cost grows with the block count (each AIC also brings two AIVs), so
    // never start more core groups than the device can possibly have tiles.
    // sum_e ceil(M_e/BM) <= M/BM + E because each expert contributes at most
    // ceil(M_e/BM) <= M_e/BM + 1 row tiles; group_list is only read on device,
    // so this upper bound is the only shape-only estimate available on the host.
    // sum_e ceil(M_e/BM) <= min(E,M) + floor((M-min(E,M))/BM) for any legal
    // group_list (empty experts cost 0, each non-empty one at most
    // floor((M_e-1)/BM)+1), which is tighter than M/BM + E + 1 and never
    // under-counts.  For an E=1, M=64 shape that is an upper bound of 1.
    // A Cube tile only ever covers `bm` rows.  With M small the 128-row tile
    // leaves the machine nearly empty (one core group does the whole epilogue
    // while the others idle), so the tile is shortened until the row tiles fill
    // it.  This costs no extra A traffic - a column task re-reads the same rows
    // either way - and the extra per-task setup runs in parallel on other cores.
    cfg.bm = BM;
    {
        uint64_t colTiles = (static_cast<uint64_t>(cfg.n) + BN - 1) / BN;
        uint64_t used = std::min<uint64_t>(cfg.m, cfg.e);
        auto rowTilesAt = [&](uint32_t b) {
            return used + (static_cast<uint64_t>(cfg.m) - used) / b;
        };
        if (rowTilesAt(BM) * colTiles < 20) {
            uint64_t maxRows = 20 / colTiles;
            if (maxRows == 0) maxRows = 1;
            if (rowTilesAt(16) <= maxRows) cfg.bm = 16;
            else if (rowTilesAt(32) <= maxRows) cfg.bm = 32;
            else if (rowTilesAt(64) <= maxRows) cfg.bm = 64;
        }
    }
    uint64_t nonempty = std::min<uint64_t>(cfg.m, cfg.e);
    uint64_t nTilesBound = (nonempty + (static_cast<uint64_t>(cfg.m) - nonempty) / cfg.bm) *
                           ((static_cast<uint64_t>(cfg.n) + BN - 1) / BN);
    uint64_t coreCap = std::max<uint64_t>(1, std::min<uint64_t>(20, nTilesBound));
    cfg.cores = static_cast<uint32_t>(std::min<int64_t>(availableCoreNum, static_cast<int64_t>(coreCap)));
    cfg.tiny = IsTinyShape(cfg.m, cfg.e, cfg.k, cfg.n) ? 1U : 0U;
    // 2 = the direct front end above; it is the cheaper form of every shape it
    // admits, so it takes precedence over the staged tiny path (1).
    if (IsTinyFrontShape(cfg.m, cfg.e, cfg.k, cfg.n)) cfg.tiny = 2U;
    if (cfg.tiny != 0) cfg.cores = 1;
    // A product this small does not fill the machine, and every extra core group
    // pays its own prologue, pipeline warm-up and (for the Cube path) its own
    // L1/L0 init.  Measured on 1/64/128/128 (four 16-row tiles, one column task):
    // one group 9.84 us against four 11.43 (-14.1%, 6/6 paired rounds, identical
    // y), and the win is on the fixed cost, so it does not depend on how the
    // group_list splits the rows.  The bound is deliberately far below anything
    // that could use the machine: 4 Mi rows*K*N of product and 1 Mi of B.
    // Narrow the single-group gate to whole rows that fit one task: a wide
    // single-row shape (M=2/E=1/K=1/N=4096) otherwise routes nbc=4096 through
    // the blocks search at need=1, whose single-task API path produces
    // out-of-range outputs (boundary_08: 58 inf, 254 mismatches).
    if (cfg.tiny == 0 && cfg.n <= NBC_WIDE &&
        static_cast<uint64_t>(cfg.m) * cfg.k * cfg.n <= 4ULL * 1024U * 1024U &&
        static_cast<uint64_t>(cfg.e) * cfg.k * cfg.n <= 1024ULL * 1024U) {
        cfg.cores = 1;
    }
    // Cube task column width.  A task costs its own A re-read and setup no matter
    // how many columns it carries, so the split is chosen from the block count:
    if (true) {
        uint64_t rowTiles = std::max<uint64_t>(cfg.e, (static_cast<uint64_t>(cfg.m) + cfg.bm - 1) / cfg.bm);
        uint64_t need = (static_cast<uint64_t>(cfg.cores) + rowTiles - 1) / rowTiles;
        uint64_t maxBlocks = (static_cast<uint64_t>(cfg.n) + BN - 1) / BN;
        uint64_t blocks = 0;
        if (need <= 1 && cfg.n <= NBC_WIDE) {
            // Enough row tiles to fill the machine and the whole row fits one task:
            // the A tile is read once and a narrow tail is not a task of its own.
            // Measured -13..-19% for N in (256, 512]; a single task wider than 512
            // loses 8% instead, so it keeps the split.
            blocks = 1;
        } else {
            // Otherwise the fewest blocks whose width is a multiple of BN: an
            // unaligned width leaves the vector unit a narrow last block and cost
            // 60% on a 1024-wide shape.
            for (uint64_t b = need; b <= maxBlocks; ++b) {
                if ((static_cast<uint64_t>(cfg.n) + b - 1) / b % BN == 0) {
                    blocks = b;
                    break;
                }
            }
        }
        if (blocks != 0) {
            cfg.nbc = static_cast<uint32_t>((static_cast<uint64_t>(cfg.n) + blocks - 1) / blocks);
        } else {
            cfg.nbc = NBC;
            if (cfg.n % 512 == 0 && rowTiles * (cfg.n / 512) >= cfg.cores) cfg.nbc = 512;
            if (cfg.n % 384 == 0 && rowTiles * (cfg.n / 384) >= cfg.cores) cfg.nbc = 384;
        }
        // Column-task count clamp.  Measured on the documented shape set: one
        // column task (C=1) leaves the machine in a 1.6-wave tail and six or
        // more (C>=6) re-reads A without buying parallelism.  C=3 is the
        // optimum once the row tiles alone give >=32 tiles; below that keep the
        // existing choice but bound it to [2,3].  The width is rounded up to a
        // multiple of BN: a non-multiple leaves the vector a partial block and
        // costs up to 67% (measured on a 1024-wide shape).
        if (cfg.n > NBC_WIDE && rowTiles >= 20) {
            // Only the "row tiles alone fill the machine" regime has a stable
            // optimum; below 32 row tiles the best column count depends on the
            // B size and the measured choice already matches it.
            uint64_t c = 3;
            // Pick between the two multiples of BN that bracket the ideal
            // width: a valid (non-tiny) last task first, then the column count
            // closest to the target, then the larger last task.  Rounding up
            // alone produced a 1-column tail on an odd-256 width (measured +12%).
            uint64_t w0 = (static_cast<uint64_t>(cfg.n) + c - 1) / c;
            uint64_t wlo = (w0 / BN) * BN;
            if (wlo < BN) wlo = BN;
            uint64_t whi = ((w0 + BN - 1) / BN) * BN;
            uint64_t w = whi;
            if (wlo != whi) {
                uint64_t cLo = (static_cast<uint64_t>(cfg.n) + wlo - 1) / wlo;
                uint64_t cHi = (static_cast<uint64_t>(cfg.n) + whi - 1) / whi;
                uint64_t lLo = static_cast<uint64_t>(cfg.n) - (cLo - 1) * wlo;
                uint64_t lHi = static_cast<uint64_t>(cfg.n) - (cHi - 1) * whi;
                bool vLo = lLo >= BN, vHi = lHi >= BN;
                bool takeLo = false;
                if (vLo != vHi) {
                    takeLo = vLo;
                } else {
                    uint64_t dLo = cLo > c ? cLo - c : c - cLo;
                    uint64_t dHi = cHi > c ? cHi - c : c - cHi;
                    if (dLo != dHi) takeLo = dLo < dHi;
                    else takeLo = lLo > lHi;
                }
                if (takeLo) w = wlo;
            }
            cfg.nbc = static_cast<uint32_t>(w);
        }
    }
    // Row-tile height for many-expert shapes.  A Cube row tile streams the whole
    // B slice of its expert, so a nearly empty tile costs as much as a full one:
    // an expert with 160 rows pays two full B passes at bm=128.  When the average
    // expert spans at most two 256-row tiles, raise bm so each expert needs only
    // ceil(avg/256) tiles.  Measured: 160 rows -> 160 (-15.3%), 171 -> 176
    // (-13.2%), 512 -> 256 (-10.3%).  A shape with a single column task keeps
    // 128 (bm 192 cost +3.9%, bm 256 +28%) and so does one where raising bm
    // would leave fewer row tiles than cores (15 vs 20 at bm 176, +34%).
    {
        uint64_t colTasks = (static_cast<uint64_t>(cfg.n) + cfg.nbc - 1) / cfg.nbc;
        uint64_t avgRows = (static_cast<uint64_t>(cfg.m) + cfg.e - 1) / cfg.e;
        // A raised bm makes the A-resident slab pipeline unreachable (its gate
        // requires bm <= BM), and on the padded shapes the slab is worth far
        // more than the B-pass saving this rule buys.  Only skip the raise when
        // the lowered bm would actually qualify, so a shape the slab cannot take
        // (cat07: k = 8191 is outside its K range) keeps the raise it needs -
        // dropping it there costs +17.9 us hot / +26.5 us cold.
        uint64_t nbcEff = ((padN || padOnly) && slabShape) ? 256U : cfg.nbc;
        bool slabCand = cfg.tiny == 0 && ((cfg.k + 31U) & ~31U) >= 1024U && cfg.k <= 4095U &&
                        (cfg.k % C0_B8 == 0 || cfg.nReal != cfg.n) && cfg.n >= 512U &&
                        (cfg.n % 256U) == 0U && nbcEff == 256U &&
                        ((static_cast<uint64_t>(cfg.m) + BM - 1U) / BM) * (cfg.n / 256U) >= cfg.cores &&
                        static_cast<uint64_t>(BM) * cfg.k + 2ULL * CUBE_L0B_BYTES <= CUBE_L1_BYTES;
        if (colTasks >= 2 && avgRows >= BM && !slabCand) {
            uint64_t k = (avgRows + 255) / 256;
            uint64_t want = ((avgRows + k - 1) / k + 15) / 16 * 16;
            if (want > 256) want = 256;
            if (want > cfg.bm) {
                uint64_t nonempty3 = std::min<uint64_t>(cfg.m, cfg.e);
                uint64_t bound = (nonempty3 + (static_cast<uint64_t>(cfg.m) - nonempty3) / want) * colTasks;
                if (bound >= 20) cfg.bm = static_cast<uint32_t>(want);
            }
        }
    }
    // The A-resident slab pipeline (cfg.manual == 2, selected below) is worth
    // about 6 us on the deep-K wide-N shapes: A stays in L1 across the K sweep
    // instead of being re-staged from GM for every baseK step.  It is written
    // for a 256-column task, so a shape whose column width would otherwise be
    // chosen as 512 or 384 never reaches it.  Where the pipeline's own
    // preconditions hold, prefer the 256 width and pay the extra A pass.
    // Measured on the public points against the same binary (paired, order
    // reversed every round): n=1024 84.9 -> 80.6 us (5/6 rounds) and n=768
    // 82.5 -> 81.9 us (4/6), y bit-identical; the same shape forced to a
    // 256-wide task without the pipeline is 1.7 us *worse*, so this is a
    // preference for the pipeline, not for the narrow task.  Bounded to
    // n <= 1024 (at most four column tasks) because the price is one extra
    // A pass per column task and nothing above 1024 was measured.
    {
        uint64_t mTasks = (static_cast<uint64_t>(cfg.m) + cfg.bm - 1U) / cfg.bm;
        bool slabWidth = (cfg.tiny == 0 && cfg.k >= 1024U && cfg.k <= 4095U &&
                          cfg.k % C0_B8 == 0 && cfg.n >= 512U && cfg.n <= 1024U &&
                          cfg.n % 256U == 0U && cfg.bm <= BM &&
                          static_cast<uint64_t>(cfg.bm) * cfg.k + 2U * CUBE_L0B_BYTES <= CUBE_L1_BYTES &&
                          mTasks * (cfg.n / 256U) >= cfg.cores);
        if (slabWidth) cfg.nbc = 256U;
    }
    if ((padN || padOnly) && slabShape) cfg.nbc = 256U;  // the slab needs this width

    // One row tile per expert.  A Cube row tile streams that expert's whole B
    // slice, so an expert that spills into a second 128-row tile pays the B pass
    // and the row padding twice (a 171-row expert fills 256 rows of tiles: 33%
    // of the Cube work is padding).  When the average expert fits in a tile of
    // at most 256 rows and L0C can hold it at 128 columns, take bm = the 16-row
    // aligned average and nbc = 128.  Measured paired on the same chip:
    // 2047/12/1025/769 44.18 -> 42.48, 2559/16/1031/1025 58.06 -> 54.52.
    // bm 160 on the first shape measures 48.5: a tile that still does not cover
    // the expert is worse than leaving it at 128.
    if (cfg.tiny == 0 && cfg.n >= 512U && (cfg.n % 128U) == 0U) {
        uint64_t avgRows = (static_cast<uint64_t>(cfg.m) + cfg.e - 1U) / cfg.e;
        const uint32_t want0 = static_cast<uint32_t>((avgRows + 15U) / 16U * 16U);
        // `cfg.bm <= want`: an earlier rule may already have raised bm to the
        // 16-row aligned average of the expert (cat08: bm == want == 160, cat14:
        // bm == want == 176), and the column width still has to come down to 128
        // to match the narrower padded N.  Shapes whose bm is already below the
        // average (cat15: bm 128, want 80) keep their geometry untouched.
        if ((avgRows > cfg.bm || narrowPad) && avgRows <= 256U) {
            uint32_t want = static_cast<uint32_t>((avgRows + 15U) / 16U * 16U);
            if (static_cast<uint64_t>(want) * 128U * sizeof(int32_t) <= CUBE_L0C_BYTES &&
                static_cast<uint64_t>(want) * cfg.k + 2ULL * CUBE_L0B_BYTES <= CUBE_L1_BYTES) {
                cfg.bm = want;
                cfg.nbc = 128U;
            }
        }
    }
    // A few-expert shape has no averaging: the mean-row rule above can size the
    // row tile far below the largest expert, and that expert then pays one B
    // pass per tile.  The hidden H-B input is exactly this case - a group-list
    // probe (reports/experiments/plannew_20261112/glprobe) shows one expert
    // holding more than 2/3 of the 513 rows - so a 256-row tile needs two B
    // passes where the 176-row one needs three.  Measured paired on the cold
    // ALT protocol: front 500/1/12 161.9 -> 128.0 us (-21.2%, 6/6 rounds);
    // uniform 171/171/171 101.0 -> 112.4 (+12.0%), i.e. the sign is a
    // group_list property, and this shape's hidden input is the front regime.
    // y stays bit-identical on all four group_list variants (uniform, front,
    // random 52/293/168, mid 360/150/3).  L0C still holds the tile at this
    // task width, which is why the rule is gated to nbc == 128.
    if (cfg.tiny == 0 && cfg.nbc == 128U && cfg.bm > 128U && cfg.bm < 256U &&
        static_cast<uint64_t>(256U) * cfg.nbc * 4U <= CUBE_L0C_BYTES) {
        // A 256-row tile halves this shape's B passes, but its stream pipeline
        // must be able to leave a last K chunk of at least one 32-byte block:
        // a narrower tail traps the MMA when it meets a row tile of one fractal
        // or less (measured on 2559/16/1031/1025: rows<=16 && tail<32 -> 507015,
        // either side alone is fine).  Only raise bm where such a chunking
        // exists; the device uses the same search.
        uint32_t l0 = std::min<uint32_t>(CUBE_L0A_BYTES / (2U * 256U),
                                         CUBE_L0B_BYTES / (2U * cfg.nbc));
        l0 = std::min<uint32_t>(cfg.k, l0 / C0_B8 * C0_B8);
        bool safe = false;
        for (uint32_t t = 0; t < 8U && l0 >= 2U * C0_B8; ++t) {
            uint32_t tail = cfg.k % l0;
            if (tail == 0U || tail >= C0_B8) { safe = true; break; }
            l0 -= C0_B8;
        }
        if (safe) cfg.bm = 256U;
    }
    if (cfg.tiny == 0 && cfg.e <= 4U && cfg.k >= 4096U && cfg.nbc == 128U &&
        (cfg.n % 256U) == 0U && cfg.nReal < cfg.n &&
        static_cast<uint64_t>(128U) * 256U * 4U <= CUBE_L0C_BYTES) {
        cfg.nbc = 256U;
        cfg.bm = 128U;
        cfg.flat = 0U;
    }
    auto* platform = platform_ascendc::PlatformAscendCManager::GetInstance();
    if (!platform) throw std::runtime_error("CANN platform query failed");
    matmul_tiling::MatmulApiTiling tiler(*platform);
    tiler.SetAType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND, matmul_tiling::DataType::DT_INT8);
    tiler.SetBType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND, matmul_tiling::DataType::DT_INT8);
    tiler.SetCType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND, matmul_tiling::DataType::DT_INT32);
    // The Cube task is `nbc` columns wide, so matching the tiling's baseN to it
    // turns each task into a single base block: one B load and one C write per
    // task instead of two, which halves the AIC's MTE2 time on the many-expert
    // shapes.  baseN is capped at 256 columns because a 128-row x baseN int32 C
    // block must fit L0C (128 KB); wider tasks keep the 128-wide base block.
    // Only when every core group owns at least one expert does the per-task B
    // load dominate: the tasks are then one small expert each and matching baseN
    // to the task width removes a second base block (and its C write) per task.
    // On shapes with fewer experts the 128-wide base block is better measured.
    bool manyExperts = cfg.e >= cfg.cores && cfg.nbc <= 256U;
    // baseN sets how long the contiguous run inside one B row is; a wider block
    // means fewer, longer MTE2 bursts.  L0C holds baseM*baseN*4 <= 128 KB, so a
    // wider baseN has to pay with a shorter baseM.
    uint32_t baseN = manyExperts ? cfg.nbc : BN;
    uint32_t baseM = manyExperts ? 64U : cfg.bm;
    // A task narrower than one 128-column vector block: the Matmul API would
    // otherwise run its baseN = BN blocks for a task only `nbc` columns wide,
    // i.e. 128/nbc times the useful MMA work.  On 65536/7/4096/1 that is 128x
    // (measured 12.85 ms against 0.44 ms at N=64).  Track the task width, in
    // 16-column fractal steps, whenever it is below BN.
    if (!manyExperts && cfg.nbc < BN) {
        baseN = (cfg.nbc + 15U) & ~15U;
        if (baseN < 16U) baseN = 16U;
    }
    if (!manyExperts) {
        if (cfg.nbc >= 512U && cfg.bm >= 64U) { baseN = 512U; baseM = 64U; }
        else if (cfg.nbc >= 256U && cfg.bm >= 128U) { baseN = 256U; baseM = 128U; }
    }
    tiler.SetShape(baseM, baseN, cfg.k);
    tiler.SetBias(false);
    tiler.SetFixSplit(baseM, baseN, 128);
    tiler.SetBufferSpace(512 * 1024, 128 * 1024, 0);
    if (tiler.GetTiling(cfg.cube) < 0) {
        baseN = BN;
        tiler.SetShape(cfg.bm, baseN, cfg.k);
        tiler.SetFixSplit(cfg.bm, baseN, 128);
        if (tiler.GetTiling(cfg.cube) < 0) {
        baseN = BN; baseM = cfg.bm;
        tiler.SetShape(baseM, baseN, cfg.k);
        tiler.SetFixSplit(baseM, baseN, 128);
        if (tiler.GetTiling(cfg.cube) < 0) throw std::runtime_error("INT8 Matmul tiling failed");
    }
    }
    // A GM->L1 packet covers baseK * stepKa K columns, so stepKa is the A row
    // burst length and the divisor of the A row-transaction count; MTE2 here is
    // row bound.  The tiler is conservative when K is long relative to L1.
    // Only deep-K shapes gain: at K ~= 1k the tiler's stepKa already spans most
    // of the sweep and deepening it measured +2 us on cat08/cat14/cat15, while
    // on cat07 (K=8191, 64 base blocks) it is -8 us.
    if (cfg.k >= 2048U) {
        const int64_t baseA = static_cast<int64_t>(cfg.cube.baseM) * cfg.cube.baseK;
        const int64_t baseB = static_cast<int64_t>(cfg.cube.baseK) * cfg.cube.baseN;
        const int32_t kIter = static_cast<int32_t>((cfg.k + cfg.cube.baseK - 1U) / cfg.cube.baseK);
        int32_t sk = cfg.cube.stepKa;
        int32_t db = cfg.cube.depthB1;
        while (sk > 0 && sk * 2 <= kIter) {
            const int32_t skNext = sk * 2;
            const int32_t daNext = 2 * skNext;
            const int32_t dbNext = db < 4 ? 4 : db;
            if (static_cast<int64_t>(daNext) * baseA + static_cast<int64_t>(dbNext) * baseB >
                470LL * 1024LL) {
                break;
            }
            sk = skNext;
            cfg.cube.stepKa = sk;
            cfg.cube.depthA1 = daNext;
            cfg.cube.depthB1 = dbNext;
            db = dbNext;
        }
    }
    cfg.cube.M = cfg.m;
    cfg.cube.N = cfg.n;
    cfg.cube.Ka = cfg.k;
    cfg.cube.Kb = cfg.k;
    cfg.cube.singleCoreM = baseM;
    cfg.cube.singleCoreN = baseN;
    cfg.cube.singleCoreK = cfg.k;
    // The hand-written Cube path issues the Nd2Nz -> LoadData -> Mmad -> fixpipe
    // sequence itself.  It needs K aligned to the int8 C0 so the K tail never has
    // to be zero padded inside L1, K inside the 16-bit Nd2Nz source strides, and
    // one Cube task that fits a single L0C block and a single L0B block.  Every
    // other shape keeps the Matmul-API path unchanged.
    // A row length that is an odd multiple of the Cube base tile (768 = 3 x 256)
    // splits into a width that is not a whole number of base tiles (384 = 1.5 x 256),
    // so the hand-written Cube path cannot take the shape and the Matmul API's
    // per-task scalar work comes back.  Narrowing to 256 gives three uniform tasks
    // and puts this family on the fast path; even multiples (1024) and single-tile
    // rows (256) already split into whole base tiles and keep their measured choice.
    if (cfg.tiny == 0 && (cfg.k % C0_B8) == 0 && cfg.k <= 4095 &&
        cfg.n % 256U == 0 && (cfg.n / 256U) >= 3U && ((cfg.n / 256U) & 1U) != 0U &&
        static_cast<uint64_t>(cfg.bm) * 256U * 4U <= CUBE_L0C_BYTES) {
        cfg.nbc = 256U;
    }
    // A column task narrower than one 64-column block: the row tile is what
    // pays for the per-task fixed cost (A staging, L0 loads, the cross-core
    // handshake), and L0C only constrains the *product* bm*nbc*4.  With a
    // narrow task the row tile can therefore be much taller.  Measured on
    // 65536/7/4096/1: bm 128 12.85 ms -> 512 4.46 -> 1024 2.59 -> 2048
    // 1.49 ms (32 tasks instead of 512); 65536/7/4096/16: 3.20 -> 0.63 ms.
    // Scoped to nbc < 64, i.e. shapes with 0 < n < 64 that are not tiny and
    // not the flat family (n % 64 == 0), so no catalogued point changes.
    if (cfg.tiny == 0 && cfg.nbc < 64U) {
        uint32_t nb = (cfg.nbc + 15U) & ~15U;
        if (nb < 16U) nb = 16U;
        uint64_t cap = CUBE_L0C_BYTES / (static_cast<uint64_t>(nb) * sizeof(int32_t));
        uint32_t want = static_cast<uint32_t>(cap < cfg.m ? cap : cfg.m);
        if (want > cfg.bm) cfg.bm = want;
    }
    // Wide-N large-K shape (official 16: 8193/4/2047/4095): the Matmul API
    // re-reads the whole B slice once per base block, so a taller task is the
    // only lever left.  Measured on the real group_list: bm 240 -> 1514 us,
    // bm 640 -> 1371 us (-9.4%).  Gated to n > 3000 && k <= 4095 so the
    // neighbouring shapes are untouched (official 17 n=897, 18 n=2049 both
    // measure 9-11% WORSE at bm 640).
    if (cfg.tiny == 0U && cfg.n > 3000U && cfg.k <= 4095U && cfg.bm < 640U) {
        cfg.bm = 640U;
    }
    cfg.manual = 0;
    const bool packCols = (cfg.n % 32U) != 0U;
    const bool fits = cfg.k <= 4095 && cfg.nbc <= 256 &&
                      static_cast<uint64_t>(cfg.bm) * cfg.nbc * 4 <= CUBE_L0C_BYTES;
    // The hand-written path stages B with a single Nd2Nz whose dValue is the
    // *staged* task width.  A width that is not a whole number of 32-byte blocks
    // leaves the tail fractal undefined: the same launch then produces a
    // different y on the next call (measured on 1024/16/2048/1025, whose last
    // column task is one column wide).  Such a shape keeps the Matmul API path,
    // which is 2x slower on an odd stride but computes one fixed answer.
    const uint32_t tailW = cfg.n % cfg.nbc;
    const bool alignedTasks = (cfg.nbc % C0_B8) == 0 &&
                              (tailW == 0 || (tailW % C0_B8) == 0);
    if (fits && (cfg.k % C0_B8) == 0 && alignedTasks) {
        cfg.manual = 1;
    }
    // Full-width columns that are not 32-aligned can still take the hand-written
    // path when B is repacked first: the repack pads each expert's K range (and
    // each row) so the Cube always sees whole 32-byte blocks, which a partial
    // Nd2Nz (non-32-aligned dValue) does not survive -- that measured
    // non-deterministic.  Restricted to 128-row tiles: the row-tile rule above
    // is tuned for the API path and produces tiles whose A staging the
    // hand-written path does not handle below 128 rows.
    // A one-column tail task costs a whole task (its own A read and its own B
    // pass) for a single column, and the repack makes that worse: measured
    // +4.7% on the 769-wide shape.  Such shapes keep the API path.
    const uint32_t colTail = cfg.n % cfg.nbc;
    if (cfg.manual == 0 && packCols && cfg.k <= 4095 && cfg.nbc == 256U &&
        cfg.bm >= BM && alignedTasks && (colTail == 0 || colTail >= C0_B8)) {
        cfg.bm = BM;
        cfg.manual = 1;
    }
    // Use the slab pipeline when aligned multi-column tasks expose enough
    // parallelism even if all rows belong to one expert. This lower bound
    // never assumes a uniform group_list.
    uint64_t streamTasks = ((static_cast<uint64_t>(cfg.m) + cfg.bm - 1U) / cfg.bm) *
                           (cfg.n / 256U);
    uint64_t residentBytes = static_cast<uint64_t>(cfg.bm) * cfg.k;
    // Only where the host already chose a 256-wide task: the slab pipeline keeps
    // A resident in L1, so it must not be the reason a wider task width (512) is
    // thrown away.  n=1024 shapes keep their 512-wide API tasks; the n=768
    // family is already 256 from the odd-multiple rule above.
    if (cfg.nbc <= 256U && cfg.tiny == 0 && ((cfg.k + 31U) & ~31U) >= 512U && cfg.k <= 4095U &&
        (cfg.k % C0_B8 == 0 || cfg.nReal != cfg.n) && cfg.n >= 512U && (cfg.n % cfg.nbc) == 0U &&
        cfg.bm <= 256U && streamTasks >= cfg.cores &&
        residentBytes + 2U * CUBE_L0B_BYTES <= CUBE_L1_BYTES) {
        cfg.manual = 2;
    }
    // Flat epilogue: one Cube task covers the whole output row (nbc == n), so a
    // vector block can be a contiguous run of whole rows in both C and y.
    // n must be a multiple of the 64-element vector repeat and below 512, so a
    // one-row task never reaches the column-split branch of the AIV split;
    // with n <= 256 that leaves 64, 128 and 256.
    cfg.flat = (cfg.tiny == 0 && cfg.nbc == cfg.n && cfg.n <= 256 && (cfg.n % 64U) == 0 &&
                (WIDE_VEC % cfg.n) == 0) ? 1U : 0U;
    // Grid shrink.  The blocked deal hands each core `chunk = ceil(total/cores)`
    // consecutive tiles, so a tile count that is not a multiple of the core
    // count leaves the last cores with nothing while still paying their
    // dispatch (0.234 us per block, measured on an empty kernel).  The host
    // knows a lower bound on the tile count from the shape alone - ceil(m/bm)
    // row tiles times the column tasks - and at that bound the deal fills
    // exactly `used` cores.  Shrinking to `used` changes no tiling decision
    // above (all of them were made against the full grid) and no image of the
    // work: the chunk each core keeps is the same run it had before.  The
    // round-robin deal on the flat path is a stride, not a run, so it is left
    // alone.
    // Only trim when every expert fits inside one row tile.  Above that the
    // bound below (ceil(m/bm) row tiles) misses the per-expert tiles: on
    // 2047/12/1025/769 the deal really has ~24 row tiles, not 16, and trimming
    // to 16 cores costs 6 tasks per core instead of 5.  Measured over six
    // group_list partitions (uniform/front/back/one_big/two_hot/random):
    // 48.70->44.76, 43.56->42.72, 45.42->43.70, 45.22->44.88, 43.68->42.38,
    // 47.18->42.12.  Shapes whose experts fit in one tile keep the trim: there
    // the same change is +3..+5% on three of six partitions.
    const bool expertsSpanTiles = (static_cast<uint64_t>(cfg.m) + cfg.e - 1U) / cfg.e > cfg.bm;
    if (cfg.tiny == 0 && cfg.manual != 0 && cfg.nbc < cfg.n && cfg.cores > 1U &&
        !expertsSpanTiles) {
        uint64_t colTiles = (static_cast<uint64_t>(cfg.n) + cfg.nbc - 1U) / cfg.nbc;
        uint64_t minTiles = ((static_cast<uint64_t>(cfg.m) + cfg.bm - 1U) / cfg.bm) * colTiles;
        uint64_t chunk = (minTiles + cfg.cores - 1U) / cfg.cores;
        if (chunk == 0) chunk = 1;
        uint64_t used = (minTiles + chunk - 1U) / chunk;
        if (used >= 1U && used < cfg.cores) cfg.cores = static_cast<uint32_t>(used);
    }
    // Grid width for the flat family (one Cube task per expert, whole output row).
    // Two terms trade against each other.  Cores scale sublinearly: a task costs
    // ~15% more on 20 cores than on 16 (measured at fixed total work, 160 tiles,
    // where both divide exactly and there is no wave tail: 34.10 vs 36.90, 3/3),
    // so the 20 core grid buys 1.25x the cores for 1.15x the throughput.  The
    // wave tail is the other term, and on a short deal it is large enough to
    // flip the sign: 8192/128/256/256 is 128 tiles, i.e. 6.4 waves on 20 cores
    // (7 tasks on the eight cores that get one more) against a full 8 waves on
    // 16, and 16 wins by 2-3% (cold, four input sets rotated, ten paired
    // rounds: 23.88 -> 23.04 median, 8/10; hot 22.00 -> 21.75; three skewed
    // group_lists at 190 tiles: 26.84 -> 26.46, 3/3).  Both terms are what the
    // measurement says and neither is L2: growing the rotated footprint from
    // two to eight input sets leaves the gap at -0.70 / -0.36 / -0.36, and a K
    // sweep 64 / 128 / 256 / 512 keeps it at -0.88 / -0.26 / -0.68 / -0.92, so
    // it is not B's bytes and not L2 residency.  8 cores loses 5 us: the grid
    // still needs the parallelism, 16 is a knee and not a preference.
    // So only take 16 when it is 16 that removes the tail: the task count must
    // divide by 16 and not by the wider grid.  A deal that 20 already divides
    // keeps 20 - that is the 160-tile case above, where 20 wins.  The upper
    // bound keeps the tasks per core inside the READY_RING the handshake is
    // sized for.
    if (cfg.flat != 0 && cfg.cores > 16U) {
        uint64_t tasksMin = std::min<uint64_t>(cfg.m, cfg.e);
        if (tasksMin >= 2U * cfg.cores && tasksMin <= 128U &&
            tasksMin % 16U == 0U && tasksMin % cfg.cores != 0U) {
            cfg.cores = 16U;
        }
    }
    DeviceAllocation config(sizeof(Config));
    uint32_t cPitch = (cfg.n + 15U) & ~15U;
    {
        uint32_t tail = cfg.n % BN;
        if (cfg.n > BN && tail != 0 && tail <= BN / 2 && cfg.k < 4096) {
            cPitch = ((cfg.n + BN - 1U) / BN) * BN;
        }
    }
    if (cfg.tiny == 0U && cfg.m <= 64U && cfg.e == 1U && cfg.k <= 256U &&
        (cfg.k % 32U) == 0U && cfg.nReal <= 256U && (cfg.nReal % 64U) == 0U &&
        (WIDE_VEC % cfg.nReal) == 0U && cfg.nReal == cfg.n) {
        const uint32_t cStr = cPitch;
        DeviceAllocation wsSmall(static_cast<size_t>(cfg.m) * cStr * sizeof(int32_t));
        SmallKernel<<<2, nullptr, stream>>>(x, weight, scale, y, (GM_ADDR)wsSmall.ptr,
                                            cfg.m, cfg.k, cfg.n, cStr);
        return;
    }
    // N == 1: one dot product per output row; the Cube's column-padded staging
    // wastes the whole tile.  See N1Kernel.
    if (cfg.tiny == 0U && cfg.n == 1U && cfg.k >= 512U && cfg.m >= 32U) {
        uint32_t blocks = 40U;
        uint32_t rw = cfg.m / blocks;
        uint32_t extra = cfg.m % blocks;
        N1Kernel<<<blocks, nullptr, stream>>>(x, weight, scale, group_list, y,
                                              cfg.m, cfg.e, cfg.k, rw, extra);
        return;
    }
    // K == 1: outer product, no C materialisation.  See K1Kernel.  Placed before
    // the C workspace is allocated so this route never pays its 4*M*N bytes.
    if (cfg.tiny == 0U && cfg.k == 1U && cfg.n >= 512U && cfg.n <= 4096U &&
        cfg.m >= 32U && static_cast<uint64_t>(cfg.n) * sizeof(half) * 8U <= 192U * 1024U) {
        uint32_t blocks = 40U;
        uint32_t rw = cfg.m / blocks;
        uint32_t extra = cfg.m % blocks;
        K1Kernel<<<blocks, nullptr, stream>>>(x, weight, scale, group_list, y,
                                              cfg.m, cfg.e, cfg.n, rw, extra);
        return;
    }
    DeviceAllocation workspace(static_cast<size_t>(cfg.m) * cPitch * sizeof(int32_t));
    // Repacked B with a 32-byte aligned row stride, used by the hand-written
    // Cube path when N is not 32-aligned (an odd stride costs ~2.5x on MTE2).
    uint32_t bPad = (cfg.n + 31U) & ~31U;
    uint32_t kPad = (padN && cfg.manual != 2) ? cfg.k : ((cfg.k + 31U) & ~31U);
    // A 128-wide column task reads B in 128-byte slices, where the packed and
    // the real row stride cost the same on MTE2, so the repack's 2x B copy buys
    // nothing.  Paired over six rounds on the one-row-tile shapes:
    // 2047/12/1025/769 43.03 -> 41.81 (-2.8%), 2559/16/1031/1025 neutral.
    // Wider tasks keep the repack: the same change is +65% on 9217/24/513/385
    // (API path, 512-wide) and +42% on 4093/8/1019/765.
    bool packB = ((padN && cfg.nbc > 128U) ||
                  (cfg.manual != 0 && (cfg.n % 32U) != 0U && cfg.k <= 4095U));
    // The stride the Cube must use for B: the repacked row width when the repack
    // runs, the real N otherwise.  `padOnly` shapes keep the real stride.
    cfg.bStride = packB ? ((cfg.n + 31U) & ~31U) : cfg.nReal;
    // Both buffers exist only for the repack.  Allocating the packed tensor
    // unconditionally costs more than the kernel itself on the shapes that do
    // not repack (public_1 would allocate 33 MB per call).
    DeviceAllocation packBuf(packB ? static_cast<size_t>(cfg.e) * kPad * bPad + 64 : 0);
    // 4 KB of sync flags, then 16 packed-B rows of zeroes used to pad the
    // repacked K range.  Both are only touched when this launch repacks.
    DeviceAllocation flagBuf(packB ? 4096U + 16U * bPad : 0U);
    if (packB) {
        CheckAcl(aclrtMemsetAsync(flagBuf.ptr, 4096U + 16U * bPad, 0,
                                  4096U + 16U * bPad, stream));
    }
    // PACKOVL: only the hand-written stream pipeline stages A itself, so only
    // it can overlap the first A stage with the pack wait.
    cfg.packOvl = (packB && cfg.manual == 2U) ? 1U : 0U;
    CheckAcl(aclrtMemcpy(config.ptr, sizeof(Config), &cfg, sizeof(Config), ACL_MEMCPY_HOST_TO_DEVICE));
    // Lazy group_list scan, selected here so the eager binary does not carry the
    // frontier code.  A shape takes it only when the deal is long even for the
    // most tightly packed group_list - ceil(m/bm) >= 4*cores - and the experts
    // average at most 64 rows, which is where the row-tile rule (bm 128 -> 64)
    // cannot change the grid.  Measured: 8192/128/256/256 -2.1 us; 8192/64/256/
    // 256 and 8192/32/256/256 keep the eager path (their row-tile rule is worth
    // 0.9-1.7 us and halving bm there really splits experts).
    const bool lazyOk = cfg.flat != 0 &&
                        ((cfg.m + cfg.bm - 1U) / cfg.bm) >= 4U * cfg.cores &&
                        cfg.m <= 64U * cfg.e;
    // Queue depth for the epilogue: four C/y blocks in flight hide the per-DMA
    // latency of the narrow block paths (~3.4% measured), but the 8192-element
    // block paths cannot afford four slots in UB and keep two.  The depth only
    // affects speed, never the values, so this choice cannot cost correctness.
    bool deepQ = false;
    if (cfg.tiny == 0) {
        const bool wideBlk = cfg.flat == 0 && cfg.nbc == WIDE_COLS &&
                             ((cfg.nReal % WIDE_COLS) == 0 ||
                              (cfg.nReal != cfg.n && cfg.bStride == cfg.nReal));
        const bool wideRowBlk = cfg.flat == 0 && (cfg.nbc == 384U || (cfg.nbc == WIDE_COLS && !wideBlk));
        const uint32_t slot = cfg.flat != 0 ? WIDE_VEC
                            : (wideRowBlk ? 16U * cfg.nbc : (wideBlk ? WIDE_ELEMS : VEC_SIZE));
        deepQ = slot <= VEC_SIZE;
    }
    // Narrow-task pair instance: only a one-128-wide-task shape merges two
    // adjacent Cube tasks into one 16x256 epilogue block.  Its slot is
    // VEC_SIZE, so it always lands on the deepQ (QD=4) dispatch; the repack and
    // the lazy scan are mutually exclusive with it by construction (a repacked
    // B implies a task wider than 128, and the lazy scan implies flat, i.e.
    // nbc == n).
    const bool pairMode = cfg.flat == 0 && cfg.nbc == BN;
    // R1 instance: the padded cat13-class stream shape.  The device still gates
    // the reallocation on the actual group_list (MakeTaskSequence), so other
    // group lists on this shape keep the equal-count deal.
    const bool seqShape = packB && cfg.manual == 2U && cfg.n == 3U * 256U &&
                          cfg.nReal != cfg.n;
    if (cfg.tiny == 2U) {
        const uint32_t tiles = static_cast<uint32_t>(
            (static_cast<uint64_t>(cfg.m) * cfg.n * sizeof(half) + 31U) / 32U);
        uint32_t rw = cfg.m < tiles ? cfg.m : tiles;
        if (rw > 40U) rw = 40U;
        // A one-block launch costs ~2.3us more than a two-block one on this
        // device (measured 2/2 on both tiny shapes), so never drop to one even
        // when the shape has a single row: the second worker simply idles.
        if (rw < 2U) rw = 2U;
        TinyFrontKernel<<<rw, nullptr, stream>>>(x, weight, scale, group_list, y,
                                                cfg.k, cfg.n, cfg.e,
                                                cfg.m / rw, cfg.m % rw);
    } else if (cfg.tiny != 0) {
        TinyKernel<<<2, nullptr, stream>>>(x, weight, scale, group_list, y,
                                           cfg.m, cfg.e, cfg.k, cfg.n);
    } else if (deepQ) {
        if (packB) {
            if (seqShape) {
                Kernel<true, false, 4, false, true><<<cfg.cores, nullptr, stream>>>(
                    x, weight, scale, group_list, y,
                    (GM_ADDR)workspace.ptr, (GM_ADDR)config.ptr,
                    cfg.m, cfg.e, cfg.k, cfg.n, cfg.tiny,
                    (GM_ADDR)packBuf.ptr, (GM_ADDR)flagBuf.ptr, bPad);
            } else {
                Kernel<true, false, 4><<<cfg.cores, nullptr, stream>>>(x, weight, scale, group_list, y,
                    (GM_ADDR)workspace.ptr, (GM_ADDR)config.ptr,
                    cfg.m, cfg.e, cfg.k, cfg.n, cfg.tiny,
                    (GM_ADDR)packBuf.ptr, (GM_ADDR)flagBuf.ptr, bPad);
            }
        } else if (lazyOk) {
            Kernel<false, true, 4, false, false, true><<<cfg.cores, nullptr, stream>>>(x, weight, scale, group_list, y,
                (GM_ADDR)workspace.ptr, (GM_ADDR)config.ptr,
                cfg.m, cfg.e, cfg.k, cfg.n, cfg.tiny,
                nullptr, nullptr, 0U);
        } else if (pairMode) {
            Kernel<false, false, 4, true, false, 2U><<<cfg.cores, nullptr, stream>>>(x, weight, scale, group_list, y,
                (GM_ADDR)workspace.ptr, (GM_ADDR)config.ptr,
                cfg.m, cfg.e, cfg.k, cfg.n, cfg.tiny,
                nullptr, nullptr, 0U);
        } else {
            Kernel<false, false, 4, false, false, 2U><<<cfg.cores, nullptr, stream>>>(x, weight, scale, group_list, y,
                (GM_ADDR)workspace.ptr, (GM_ADDR)config.ptr,
                cfg.m, cfg.e, cfg.k, cfg.n, cfg.tiny,
                nullptr, nullptr, 0U);
        }
    } else {
        if (packB) {
            if (seqShape) {
                Kernel<true, false, 2, false, true><<<cfg.cores, nullptr, stream>>>(
                    x, weight, scale, group_list, y,
                    (GM_ADDR)workspace.ptr, (GM_ADDR)config.ptr,
                    cfg.m, cfg.e, cfg.k, cfg.n, cfg.tiny,
                    (GM_ADDR)packBuf.ptr, (GM_ADDR)flagBuf.ptr, bPad);
            } else {
                Kernel<true, false><<<cfg.cores, nullptr, stream>>>(x, weight, scale, group_list, y,
                    (GM_ADDR)workspace.ptr, (GM_ADDR)config.ptr,
                    cfg.m, cfg.e, cfg.k, cfg.n, cfg.tiny,
                    (GM_ADDR)packBuf.ptr, (GM_ADDR)flagBuf.ptr, bPad);
            }
        } else if (lazyOk) {
            Kernel<false, true, 2, false, false, true><<<cfg.cores, nullptr, stream>>>(x, weight, scale, group_list, y,
                (GM_ADDR)workspace.ptr, (GM_ADDR)config.ptr,
                cfg.m, cfg.e, cfg.k, cfg.n, cfg.tiny,
                nullptr, nullptr, 0U);
        } else if (cfg.flat != 0) {
            Kernel<false, false, 2, false, false, true><<<cfg.cores, nullptr, stream>>>(x, weight, scale, group_list, y,
                (GM_ADDR)workspace.ptr, (GM_ADDR)config.ptr,
                cfg.m, cfg.e, cfg.k, cfg.n, cfg.tiny,
                nullptr, nullptr, 0U);
        } else {
            Kernel<false, false, 2, false, false, 2U><<<cfg.cores, nullptr, stream>>>(x, weight, scale, group_list, y,
                (GM_ADDR)workspace.ptr, (GM_ADDR)config.ptr,
                cfg.m, cfg.e, cfg.k, cfg.n, cfg.tiny,
                nullptr, nullptr, 0U);
        }
    }
    // The official entry has no workspace owner. Keep allocations alive until use completes.
    CheckAcl(aclrtSynchronizeStream(stream));
}
