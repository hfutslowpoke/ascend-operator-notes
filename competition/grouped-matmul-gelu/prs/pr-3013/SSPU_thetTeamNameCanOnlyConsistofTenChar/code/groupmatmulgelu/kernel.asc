#include "kernel_operator.h"
#define ASCENDC_CUBE_ONLY
#include "lib/matmul_intf.h"

#include <cstdint>
#include "kernel_tiling/kernel_tiling.h"
constexpr uint32_t BM = 64, BN = 256, ELEMS = BM * BN;
constexpr uint32_t VR = 2, VELEMS = ELEMS / VR;

struct GmgTiling {
  uint32_t e, m, k, n;
  uint32_t bm, bn, blocks, reserved;
  AscendC::tiling::TCubeTiling cube;
};

#include <cstdint>

__aicore__ inline uint64_t GmgMulQ56(uint64_t a, uint64_t b) {
  constexpr uint64_t mask = (1ULL << 28) - 1;
  uint64_t ah = a >> 28, al = a & mask, bh = b >> 28, bl = b & mask;
  uint64_t low = al * bl;
  uint64_t mid = ah * bl + al * bh + (low >> 28);
  return ah * bh + ((mid + (1ULL << 27)) >> 28);
}
__aicore__ inline uint64_t GmgFloatQ56(float value) {
  union {
    float f;
    uint32_t u;
  } v;
  v.f = value;
  uint32_t exp = (v.u >> 23) & 255, mant = (v.u & 0x7fffff) | 0x800000;
  if (exp >= 94) return uint64_t(mant) << (exp - 94);
  if (exp < 31) return 0;
  return uint64_t(mant) >> (94 - exp);
}
__aicore__ inline uint16_t GmgAccurateGelu(float value) {
  union {
    float f;
    uint32_t u;
  } v;
  v.f = value;
  uint16_t sign = uint16_t((v.u >> 16) & 0x8000);
  v.u &= 0x7fffffff;
  if (v.f >= 8.0f) {
    if (sign) return 0x8000;
    return uint16_t(((v.u + 0xfff + ((v.u >> 13) & 1)) >> 13) - (112U << 10));
  }
  if (v.f < 0x1p-26f) return sign;
  constexpr uint64_t one = 1ULL << 56;
  constexpr uint64_t c = 3222055317405948ULL;
  constexpr uint64_t sqrt2pi2 = 114987283542926601ULL;
  constexpr uint64_t ln2 = 49946518145322874ULL;
  uint64_t a = GmgFloatQ56(v.f);
  uint64_t inner = GmgMulQ56(GmgMulQ56(a, one + GmgMulQ56(c, GmgMulQ56(a, a))), sqrt2pi2);
  uint32_t shift = uint32_t(inner / ln2);
  uint64_t r = inner - uint64_t(shift) * ln2;

  uint64_t sum = 11ULL;
  sum = 203ULL - GmgMulQ56(r, sum);
  sum = 3444ULL - GmgMulQ56(r, sum);
  sum = 55104ULL - GmgMulQ56(r, sum);
  sum = 826554ULL - GmgMulQ56(r, sum);
  sum = 11571761ULL - GmgMulQ56(r, sum);
  sum = 150432888ULL - GmgMulQ56(r, sum);
  sum = 1805194656ULL - GmgMulQ56(r, sum);
  sum = 19857141214ULL - GmgMulQ56(r, sum);
  sum = 198571412142ULL - GmgMulQ56(r, sum);
  sum = 1787142709274ULL - GmgMulQ56(r, sum);
  sum = 14297141674192ULL - GmgMulQ56(r, sum);
  sum = 100079991719344ULL - GmgMulQ56(r, sum);
  sum = 600479950316066ULL - GmgMulQ56(r, sum);
  sum = 3002399751580331ULL - GmgMulQ56(r, sum);
  sum = 12009599006321323ULL - GmgMulQ56(r, sum);
  sum = 36028797018963968ULL - GmgMulQ56(r, sum);
  sum = 72057594037927936ULL - GmgMulQ56(r, sum);
  sum = 72057594037927936ULL - GmgMulQ56(r, sum);
  uint64_t tail = shift >= 64 ? 0 : uint64_t(sum) >> shift;

  if (!sign && inner >= 53 * ln2) return uint16_t(((v.u + 0xfff + ((v.u >> 13) & 1)) >> 13) - (112U << 10));
  uint64_t recip = one - tail / 2, denom = one + tail;
  uint32_t iterations = 5;
  if (tail <= one / 32) {
    recip = one - tail;
    iterations = 3;
  } else if (tail >= one - one / 32) {
    recip = (3 * one - tail) / 4;
    iterations = 3;
  }

  for (uint32_t i = 0; i < iterations; ++i) recip = GmgMulQ56(recip, 2 * one - GmgMulQ56(denom, recip));
  uint64_t result = sign ? GmgMulQ56(a, GmgMulQ56(tail, recip)) : GmgMulQ56(a, recip);
  if (!result) return sign;
  uint32_t top = 63 - __builtin_clzll(result);
  uint32_t bits = top > 42 ? top - 10 : 32;
  uint64_t rounded = (result + ((1ULL << (bits - 1)) - 1) + ((result >> bits) & 1)) >> bits;
  if (top < 42) return sign | uint16_t(rounded);
  return sign | uint16_t(((top - 41) << 10) + (rounded - 1024));
}

__aicore__ inline uint16_t GmgAccurateGeluSmall(float value) {
  union {
    float f;
    uint32_t u;
  } v;
  v.f = value;
  uint32_t magnitude = v.u & 0x7fffffffU;
  if (magnitude >= 0x32800000U && magnitude < 0x39800000U) {
    uint16_t sign = uint16_t((v.u >> 16) & 0x8000U);
    v.u = magnitude;
    uint64_t a = GmgFloatQ56(v.f);
    uint64_t q2 = GmgMulQ56(a, a), q4 = GmgMulQ56(q2, q2);
    uint64_t correction = GmgMulQ56(28746820885731652ULL, q2) - GmgMulQ56(4814850760283216ULL, q4);
    uint64_t result = sign ? a / 2 - correction : a / 2 + correction;
    uint32_t top = 63 - __builtin_clzll(result);
    uint32_t bits = top > 42 ? top - 10 : 32;
    uint64_t halfway = 1ULL << (bits - 1);
    uint64_t fraction = result & ((1ULL << bits) - 1);
    uint64_t distance = fraction >= halfway ? fraction - halfway : halfway - fraction;

    if (distance > 8) {
      uint64_t rounded = (result + halfway - 1 + ((result >> bits) & 1)) >> bits;
      if (top < 42) return sign | uint16_t(rounded);
      return sign | uint16_t(((top - 41) << 10) + (rounded - 1024));
    }
  }
  return GmgAccurateGelu(value);
}

class GmgPaddedReuseCube {
public:
  static constexpr uint32_t HEIGHT = 64, WIDTH = 256, MAX_K = 1024, INNER_K = 128;
  __aicore__ inline void Init(const AscendC::tiling::TCubeTiling *, AscendC::TPipe *pipe) {
    pipe->InitBuffer(a1b, 2, HEIGHT * MAX_K);
    pipe->InitBuffer(b1b, 1, MAX_K * WIDTH);
    pipe->InitBuffer(a2b, 2, HEIGHT * INNER_K);
    pipe->InitBuffer(b2b, (INNER_K * WIDTH * 2 <= 65536 ? 2 : 1), INNER_K * WIDTH);
    pipe->InitBuffer(c1b, 1, HEIGHT * WIDTH * 4);
  }
  __aicore__ inline void SetOrgShape(uint32_t, uint32_t n, uint32_t k, uint32_t, uint32_t stride) {
    n_ = n;
    kStride_ = k;
    stride_ = stride;
  }
  __aicore__ inline void SetSingleShape(uint32_t rows, uint32_t cols, uint32_t k) {
    totalRows_ = rows;
    cols_ = cols;
    k_ = k;
    paddedK_ = (k + INNER_K - 1) / INNER_K * INNER_K;
    paddedN_ = (cols + 31) / 32 * 32;
    nextRow_ = 0;
    started_ = false;
  }
  __aicore__ inline void SetTensorA(AscendC::GlobalTensor<int8_t> value) { x_ = value; }
  __aicore__ inline void SetTensorB(AscendC::GlobalTensor<int8_t> value) { w_ = value; }
  __aicore__ inline bool Iterate() {
    using namespace AscendC;
    if (nextRow_ >= totalRows_) return false;
    if (!started_) {
      auto b1 = b1b.AllocTensor<int8_t>();
      if (k_ != paddedK_) {
        InitConstValue(b1.ReinterpretCast<uint32_t>(), InitConstValueParams<uint32_t>{1, uint16_t(paddedK_ * paddedN_ / 32), 0, 0});
        PipeBarrier<PIPE_MTE2>();
      }
      Nd2NzParams bp{};
      bp.ndNum = 1;
      bp.nValue = k_;
      bp.dValue = cols_;
      bp.srcDValue = n_;
      bp.dstNzC0Stride = paddedK_;
      bp.dstNzNStride = 1;
      DataCopy(b1, w_, bp);
      b1b.EnQue(b1);
      CopyRows(0);
      weight_ = b1b.DeQue<int8_t>();
      started_ = true;
    }
    rows_ = totalRows_ - nextRow_ < HEIGHT ? totalRows_ - nextRow_ : HEIGHT;
    paddedM_ = (rows_ + 15) / 16 * 16;
    auto a1 = a1b.DeQue<int8_t>();
    nextRow_ += rows_;
    if (nextRow_ < totalRows_) CopyRows(nextRow_);
    auto c1 = c1b.AllocTensor<int32_t>();
    for (uint32_t inner = 0; inner < paddedK_; inner += INNER_K) {
      auto a2 = a2b.AllocTensor<int8_t>();
      auto b2 = b2b.AllocTensor<int8_t>();
      LoadData2dParams al{};
      al.repeatTimes = INNER_K / 32;
      al.srcStride = paddedM_ / 16;
      for (uint32_t row = 0; row < paddedM_; row += 16) LoadData(a2[row * INNER_K], a1[inner * paddedM_ + row * 32], al);
      LoadData2dTransposeParams bl{};
      bl.repeatTimes = paddedN_ / 32;
      bl.srcStride = paddedK_ / 32;
      bl.dstGap = 1;
      for (uint32_t kk = 0; kk < INNER_K; kk += 32) LoadDataWithTranspose(b2[kk * paddedN_], weight_[(inner + kk) * 32], bl);
      a2b.EnQue(a2);
      b2b.EnQue(b2);
      a2 = a2b.DeQue<int8_t>();
      b2 = b2b.DeQue<int8_t>();
      MmadParams mad{};
      mad.m = paddedM_;
      mad.n = paddedN_;
      mad.k = INNER_K;
      mad.cmatrixInitVal = inner == 0;
      Mmad(c1, a2, b2, mad);
      PipeBarrier<PIPE_M>();
      a2b.FreeTensor(a2);
      b2b.FreeTensor(b2);
    }
    a1b.FreeTensor(a1);
    c1b.EnQue(c1);
    return true;
  }
  __aicore__ inline void GetTensorC(AscendC::GlobalTensor<int32_t> result, uint8_t, bool) {
    using namespace AscendC;
    auto c1 = c1b.DeQue<int32_t>();
    FixpipeParamsV220 fix{};
    fix.nSize = paddedN_;
    fix.mSize = rows_;
    fix.srcStride = paddedM_;
    fix.dstStride = stride_;
    Fixpipe<int32_t, int32_t, CFG_ROW_MAJOR>(result, c1, fix);
    c1b.FreeTensor(c1);
  }
  __aicore__ inline void End() {
    if (started_) {
      b1b.FreeTensor(weight_);
      started_ = false;
    }
  }

private:
  __aicore__ inline void CopyRows(uint32_t start) {
    using namespace AscendC;
    auto a1 = a1b.AllocTensor<int8_t>();
    uint32_t rows = totalRows_ - start < HEIGHT ? totalRows_ - start : HEIGHT;
    uint32_t paddedM = (rows + 15) / 16 * 16;
    if (rows != paddedM || k_ != paddedK_) {
      InitConstValue(a1.ReinterpretCast<uint32_t>(), InitConstValueParams<uint32_t>{1, uint16_t(paddedM * paddedK_ / 32), 0, 0});
      PipeBarrier<PIPE_MTE2>();
    }
    Nd2NzParams ap{};
    ap.ndNum = 1;
    ap.nValue = rows;
    ap.dValue = k_;
    ap.srcDValue = kStride_;
    ap.dstNzC0Stride = paddedM;
    ap.dstNzNStride = 1;
    DataCopy(a1, x_[uint64_t(start) * kStride_], ap);
    a1b.EnQue(a1);
  }
  AscendC::TQue<AscendC::TPosition::A1, 2> a1b;
  AscendC::TQue<AscendC::TPosition::B1, 1> b1b;
  AscendC::TQue<AscendC::TPosition::A2, 2> a2b;
  AscendC::TQue<AscendC::TPosition::B2, 2> b2b;
  AscendC::TQue<AscendC::TPosition::CO1, 1> c1b;
  AscendC::LocalTensor<int8_t> weight_;
  AscendC::GlobalTensor<int8_t> x_, w_;
  uint32_t paddedN_ = 0, stride_ = 0, n_ = 0, kStride_ = 0, k_ = 0, paddedK_ = 0, totalRows_ = 0, nextRow_ = 0, rows_ = 0, cols_ = 0, paddedM_ = 0;
  bool started_ = false;
};

class GmgDirectCube {
public:
  __aicore__ inline void Init(const AscendC::tiling::TCubeTiling *, AscendC::TPipe *pipe) {
    pipe->InitBuffer(a1b, 1, 64 * 2048);
    pipe->InitBuffer(b1b, 2, 512 * 256);
    pipe->InitBuffer(a2b, 2, 64 * 128);
    pipe->InitBuffer(b2b, 2, 128 * 256);
    pipe->InitBuffer(c1b, 1, 64 * 256 * 4);
  }
  __aicore__ inline void SetOrgShape(uint32_t, uint32_t n, uint32_t k, uint32_t, uint32_t stride) {
    n_ = n;
    k_ = k;
    stride_ = stride;
  }
  __aicore__ inline void SetSingleShape(uint32_t rows, uint32_t cols, uint32_t) {
    rows_ = rows;
    cols_ = cols;
  }
  __aicore__ inline void SetTensorA(AscendC::GlobalTensor<int8_t> value) { x_ = value; }
  __aicore__ inline void SetTensorB(AscendC::GlobalTensor<int8_t> value) { w_ = value; }
  __aicore__ inline void IterateAll(AscendC::GlobalTensor<int32_t> result) {
    using namespace AscendC;
    auto a1 = a1b.AllocTensor<int8_t>();
    auto c1 = c1b.AllocTensor<int32_t>();
    uint32_t paddedM = (rows_ + 15) / 16 * 16;
    if (rows_ != paddedM) {
      InitConstValue(a1.ReinterpretCast<uint32_t>(), InitConstValueParams<uint32_t>{1, uint16_t(paddedM * k_ / 32), 0, 0});
      PipeBarrier<PIPE_MTE2>();
    }
    Nd2NzParams ap{};
    ap.ndNum = 1;
    ap.nValue = rows_;
    ap.dValue = k_;
    ap.srcDValue = k_;
    ap.dstNzC0Stride = paddedM;
    ap.dstNzNStride = 1;
    DataCopy(a1, x_, ap);
    a1b.EnQue(a1);
    CopyWeight(0, k_ < 512 ? k_ : 512);
    a1 = a1b.DeQue<int8_t>();
    for (uint32_t base = 0; base < k_; base += 512) {
      uint32_t chunk = k_ - base < 512 ? k_ - base : 512;
      auto b1 = b1b.DeQue<int8_t>();
      if (base + 512 < k_) {
        uint32_t next = k_ - base - 512 < 512 ? k_ - base - 512 : 512;
        CopyWeight(base + 512, next);
      }
      for (uint32_t inner = 0; inner < chunk; inner += 128) {
        auto a2 = a2b.AllocTensor<int8_t>();
        auto b2 = b2b.AllocTensor<int8_t>();
        LoadData2dParams al{};
        al.repeatTimes = 4;
        al.srcStride = paddedM / 16;
        for (uint32_t m = 0; m < paddedM; m += 16) LoadData(a2[m * 128], a1[(base + inner) * paddedM + m * 32], al);
        LoadData2dTransposeParams bl{};
        bl.repeatTimes = cols_ / 32;
        bl.srcStride = chunk / 32;
        bl.dstGap = 1;
        for (uint32_t kk = 0; kk < 128; kk += 32) { LoadDataWithTranspose(b2[kk * cols_], b1[(inner + kk) * 32], bl); }
        a2b.EnQue(a2);
        b2b.EnQue(b2);
        a2 = a2b.DeQue<int8_t>();
        b2 = b2b.DeQue<int8_t>();
        MmadParams mad{};
        mad.m = paddedM;
        mad.n = cols_;
        mad.k = 128;
        mad.cmatrixInitVal = (base == 0 && inner == 0);
        Mmad(c1, a2, b2, mad);

        PipeBarrier<PIPE_M>();
        a2b.FreeTensor(a2);
        b2b.FreeTensor(b2);
      }
      b1b.FreeTensor(b1);
    }
    a1b.FreeTensor(a1);
    c1b.EnQue(c1);
    c1 = c1b.DeQue<int32_t>();
    FixpipeParamsV220 fix{};
    fix.nSize = cols_;
    fix.mSize = rows_;
    fix.srcStride = paddedM;
    fix.dstStride = stride_;
    Fixpipe<int32_t, int32_t, CFG_ROW_MAJOR>(result, c1, fix);
    c1b.FreeTensor(c1);
  }
  __aicore__ inline void End() {}

private:
  __aicore__ inline void CopyWeight(uint32_t base, uint32_t chunk) {
    auto b1 = b1b.AllocTensor<int8_t>();
    AscendC::Nd2NzParams bp{};
    bp.ndNum = 1;
    bp.nValue = chunk;
    bp.dValue = cols_;
    bp.srcDValue = n_;
    bp.dstNzC0Stride = chunk;
    bp.dstNzNStride = 1;
    AscendC::DataCopy(b1, w_[uint64_t(base) * n_], bp);
    b1b.EnQue(b1);
  }
  AscendC::TQue<AscendC::TPosition::A1, 1> a1b;
  AscendC::TQue<AscendC::TPosition::B1, 2> b1b;
  AscendC::TQue<AscendC::TPosition::A2, 2> a2b;
  AscendC::TQue<AscendC::TPosition::B2, 2> b2b;
  AscendC::TQue<AscendC::TPosition::CO1, 1> c1b;
  AscendC::GlobalTensor<int8_t> x_, w_;
  uint32_t rows_ = 0, cols_ = 0, n_ = 0, k_ = 0, stride_ = 0;
};

class GmgTallCube {
public:
  __aicore__ inline void Init(const AscendC::tiling::TCubeTiling *, AscendC::TPipe *pipe) {
    pipe->InitBuffer(a1b, 1, 128 * 2048);
    pipe->InitBuffer(b1b, 2, 512 * 256);
    pipe->InitBuffer(a2b, 2, 128 * 128);
    pipe->InitBuffer(b2b, 2, 128 * 256);
    pipe->InitBuffer(c1b, 1, 128 * 256 * 4);
  }
  __aicore__ inline void SetOrgShape(uint32_t, uint32_t n, uint32_t k, uint32_t, uint32_t stride) {
    n_ = n;
    k_ = k;
    stride_ = stride;
  }
  __aicore__ inline void SetSingleShape(uint32_t rows, uint32_t cols, uint32_t) {
    rows_ = rows;
    cols_ = cols;
  }
  __aicore__ inline void SetTensorA(AscendC::GlobalTensor<int8_t> value) { x_ = value; }
  __aicore__ inline void SetTensorB(AscendC::GlobalTensor<int8_t> value) { w_ = value; }
  __aicore__ inline void IterateAll(AscendC::GlobalTensor<int32_t> result) {
    using namespace AscendC;
    auto a1 = a1b.AllocTensor<int8_t>();
    auto c1 = c1b.AllocTensor<int32_t>();
    uint32_t paddedM = (rows_ + 15) / 16 * 16;
    if (rows_ != paddedM) {
      InitConstValue(a1.ReinterpretCast<uint32_t>(), InitConstValueParams<uint32_t>{1, uint16_t(paddedM * k_ / 32), 0, 0});
      PipeBarrier<PIPE_MTE2>();
    }
    Nd2NzParams ap{};
    ap.ndNum = 1;
    ap.nValue = rows_;
    ap.dValue = k_;
    ap.srcDValue = k_;
    ap.dstNzC0Stride = paddedM;
    ap.dstNzNStride = 1;
    DataCopy(a1, x_, ap);
    a1b.EnQue(a1);
    CopyWeight(0, k_ < 512 ? k_ : 512);
    a1 = a1b.DeQue<int8_t>();
    for (uint32_t base = 0; base < k_; base += 512) {
      uint32_t chunk = k_ - base < 512 ? k_ - base : 512;
      auto b1 = b1b.DeQue<int8_t>();
      if (base + 512 < k_) {
        uint32_t next = k_ - base - 512 < 512 ? k_ - base - 512 : 512;
        CopyWeight(base + 512, next);
      }
      for (uint32_t inner = 0; inner < chunk; inner += 128) {
        auto a2 = a2b.AllocTensor<int8_t>();
        auto b2 = b2b.AllocTensor<int8_t>();
        LoadData2dParams al{};
        al.repeatTimes = 4;
        al.srcStride = paddedM / 16;
        for (uint32_t m = 0; m < paddedM; m += 16) LoadData(a2[m * 128], a1[(base + inner) * paddedM + m * 32], al);
        LoadData2dTransposeParams bl{};
        bl.repeatTimes = cols_ / 32;
        bl.srcStride = chunk / 32;
        bl.dstGap = 1;
        for (uint32_t kk = 0; kk < 128; kk += 32) { LoadDataWithTranspose(b2[kk * cols_], b1[(inner + kk) * 32], bl); }
        a2b.EnQue(a2);
        b2b.EnQue(b2);
        a2 = a2b.DeQue<int8_t>();
        b2 = b2b.DeQue<int8_t>();
        MmadParams mad{};
        mad.m = paddedM;
        mad.n = cols_;
        mad.k = 128;
        mad.cmatrixInitVal = (base == 0 && inner == 0);
        Mmad(c1, a2, b2, mad);

        PipeBarrier<PIPE_M>();
        a2b.FreeTensor(a2);
        b2b.FreeTensor(b2);
      }
      b1b.FreeTensor(b1);
    }
    a1b.FreeTensor(a1);
    c1b.EnQue(c1);
    c1 = c1b.DeQue<int32_t>();
    FixpipeParamsV220 fix{};
    fix.nSize = cols_;
    fix.mSize = rows_;
    fix.srcStride = paddedM;
    fix.dstStride = stride_;
    Fixpipe<int32_t, int32_t, CFG_ROW_MAJOR>(result, c1, fix);
    c1b.FreeTensor(c1);
  }
  __aicore__ inline void End() {}

private:
  __aicore__ inline void CopyWeight(uint32_t base, uint32_t chunk) {
    auto b1 = b1b.AllocTensor<int8_t>();
    AscendC::Nd2NzParams bp{};
    bp.ndNum = 1;
    bp.nValue = chunk;
    bp.dValue = cols_;
    bp.srcDValue = n_;
    bp.dstNzC0Stride = chunk;
    bp.dstNzNStride = 1;
    AscendC::DataCopy(b1, w_[uint64_t(base) * n_], bp);
    b1b.EnQue(b1);
  }
  AscendC::TQue<AscendC::TPosition::A1, 1> a1b;
  AscendC::TQue<AscendC::TPosition::B1, 2> b1b;
  AscendC::TQue<AscendC::TPosition::A2, 2> a2b;
  AscendC::TQue<AscendC::TPosition::B2, 2> b2b;
  AscendC::TQue<AscendC::TPosition::CO1, 1> c1b;
  AscendC::GlobalTensor<int8_t> x_, w_;
  uint32_t rows_ = 0, cols_ = 0, n_ = 0, k_ = 0, stride_ = 0;
};

template <bool PACKED = false, uint32_t WIDTH = 64, uint32_t HEIGHT = 32, uint32_t MAX_K = 8192, uint32_t BAND_K = 512> class GmgNarrowCube {
public:
  static_assert(!PACKED || BAND_K == 512, "packed producer bands remain512");
  static constexpr uint32_t INNER_K = WIDTH <= 64 ? 512 : (WIDTH <= 128 ? 256 : 128);
  __aicore__ inline void Init(const AscendC::tiling::TCubeTiling *, AscendC::TPipe *pipe) {
    pipe->InitBuffer(a1b, 1, HEIGHT * MAX_K);
    pipe->InitBuffer(b1b, 2, BAND_K * WIDTH);
    pipe->InitBuffer(a2b, 2, HEIGHT * INNER_K);
    pipe->InitBuffer(b2b, (INNER_K * WIDTH * 2 <= 65536 ? 2 : 1), INNER_K * WIDTH);
    pipe->InitBuffer(c1b, 1, HEIGHT * WIDTH * 4);
  }
  __aicore__ inline void SetOrgShape(uint32_t, uint32_t n, uint32_t k, uint32_t, uint32_t stride) {
    n_ = n;
    kStride_ = k;
    stride_ = stride;
  }
  __aicore__ inline void SetSingleShape(uint32_t rows, uint32_t cols, uint32_t k) {
    rows_ = rows;
    cols_ = cols;
    k_ = k;
  }
  __aicore__ inline void SetTensorA(AscendC::GlobalTensor<int8_t> value) { x_ = value; }
  __aicore__ inline void SetTensorB(AscendC::GlobalTensor<int8_t> value) { w_ = value; }
  template <bool PER_BAND = false> __aicore__ inline void IterateAll(AscendC::GlobalTensor<int32_t> result, bool firstStream = false) {
    static_assert(!PER_BAND || PACKED);
    static_assert(!PER_BAND || BAND_K == 512, "producer credits remain512");
    using namespace AscendC;
    auto a1 = a1b.AllocTensor<int8_t>();
    auto c1 = c1b.AllocTensor<int32_t>();
    uint32_t paddedM = (rows_ + 15) / 16 * 16, paddedK = (k_ + INNER_K - 1) / INNER_K * INNER_K;
    uint32_t paddedN = (cols_ + 31) / 32 * 32;
    if (rows_ != paddedM || k_ != paddedK) {
      InitConstValue(a1.ReinterpretCast<uint32_t>(), InitConstValueParams<uint32_t>{1, uint16_t(paddedM * paddedK / 32), 0, 0});
      PipeBarrier<PIPE_MTE2>();
    }
    Nd2NzParams ap{};
    ap.ndNum = 1;
    ap.nValue = rows_;
    ap.dValue = k_;
    ap.srcDValue = kStride_;
    ap.dstNzC0Stride = paddedM;
    ap.dstNzNStride = 1;
    DataCopy(a1, x_, ap);
    a1b.EnQue(a1);
    if constexpr (PER_BAND)
      if (firstStream) AwaitPackedBand(0);
    CopyWeight(0, k_ < BAND_K ? k_ : BAND_K, paddedN);
    a1 = a1b.DeQue<int8_t>();
    for (uint32_t base = 0; base < k_; base += BAND_K) {
      uint32_t chunk = k_ - base < BAND_K ? k_ - base : BAND_K;
      uint32_t paddedChunk = (chunk + INNER_K - 1) / INNER_K * INNER_K;
      auto b1 = b1b.DeQue<int8_t>();
      if ((!PER_BAND || !firstStream) && base + BAND_K < k_) {
        uint32_t next = k_ - base - BAND_K < BAND_K ? k_ - base - BAND_K : BAND_K;
        CopyWeight(base + BAND_K, next, paddedN);
      }
      for (uint32_t inner = 0; inner < paddedChunk; inner += INNER_K) {
        auto a2 = a2b.AllocTensor<int8_t>();
        auto b2 = b2b.AllocTensor<int8_t>();
        LoadData2dParams al{};
        al.repeatTimes = INNER_K / 32;
        al.srcStride = paddedM / 16;
        for (uint32_t m = 0; m < paddedM; m += 16) LoadData(a2[m * INNER_K], a1[(base + inner) * paddedM + m * 32], al);
        LoadData2dTransposeParams bl{};
        bl.repeatTimes = paddedN / 32;
        bl.srcStride = PACKED ? 16 : paddedChunk / 32;
        bl.dstGap = 1;
        for (uint32_t kk = 0; kk < INNER_K; kk += 32) LoadDataWithTranspose(b2[kk * paddedN], b1[(inner + kk) * 32], bl);
        a2b.EnQue(a2);
        b2b.EnQue(b2);
        a2 = a2b.DeQue<int8_t>();
        b2 = b2b.DeQue<int8_t>();
        MmadParams mad{};
        mad.m = paddedM;
        mad.n = paddedN;
        mad.k = INNER_K;
        mad.cmatrixInitVal = (base == 0 && inner == 0);
        Mmad(c1, a2, b2, mad);
        if constexpr (PER_BAND) {
          // All current-band MMADs are issued before waiting for the producer.
          if (firstStream && inner + INNER_K == paddedChunk && base + BAND_K < k_) {
            const uint32_t nextBase = base + BAND_K;
            AwaitPackedBand(nextBase);
            CopyWeight(nextBase, k_ - nextBase < BAND_K ? k_ - nextBase : BAND_K, paddedN);
          }
        }
        PipeBarrier<PIPE_M>();
        a2b.FreeTensor(a2);
        b2b.FreeTensor(b2);
      }
      b1b.FreeTensor(b1);
    }
    a1b.FreeTensor(a1);
    c1b.EnQue(c1);
    c1 = c1b.DeQue<int32_t>();
    FixpipeParamsV220 fix{};
    fix.nSize = paddedN;
    fix.mSize = rows_;
    fix.srcStride = paddedM;
    fix.dstStride = stride_;
    Fixpipe<int32_t, int32_t, CFG_ROW_MAJOR>(result, c1, fix);
    c1b.FreeTensor(c1);
  }
  __aicore__ inline void End() {}

private:
  __aicore__ inline void AwaitPackedBand(uint32_t base) {
    AscendC::CrossCoreWaitFlag<2>(4);
    if (base + BAND_K < k_) AscendC::CrossCoreSetFlag<2, PIPE_MTE2>(5);
  }
  __aicore__ inline void CopyWeight(uint32_t base, uint32_t chunk, uint32_t paddedN) {
    using namespace AscendC;
    auto b1 = b1b.AllocTensor<int8_t>();
    if constexpr (PACKED) {

      DataCopy(b1, w_[uint64_t(base) * n_], BAND_K * paddedN);
      b1b.EnQue(b1);
      return;
    }
    uint32_t paddedChunk = (chunk + INNER_K - 1) / INNER_K * INNER_K;

    if (chunk != paddedChunk) {
      InitConstValue(b1.ReinterpretCast<uint32_t>(), InitConstValueParams<uint32_t>{1, uint16_t(paddedChunk * paddedN / 32), 0, 0});
      PipeBarrier<PIPE_MTE2>();
    }
    Nd2NzParams bp{};
    bp.ndNum = 1;
    bp.nValue = chunk;
    bp.dValue = cols_;
    bp.srcDValue = n_;
    bp.dstNzC0Stride = paddedChunk;
    bp.dstNzNStride = 1;
    DataCopy(b1, w_[uint64_t(base) * n_], bp);
    b1b.EnQue(b1);
  }
  AscendC::TQue<AscendC::TPosition::A1, 1> a1b;
  AscendC::TQue<AscendC::TPosition::B1, 2> b1b;
  AscendC::TQue<AscendC::TPosition::A2, 2> a2b;
  AscendC::TQue<AscendC::TPosition::B2, 2> b2b;
  AscendC::TQue<AscendC::TPosition::CO1, 1> c1b;
  AscendC::GlobalTensor<int8_t> x_, w_;
  uint32_t rows_ = 0, cols_ = 0, n_ = 0, k_ = 0, kStride_ = 0, stride_ = 0;
};

template <bool PACKED = false, uint32_t WIDTH = 32, uint32_t HEIGHT = 32, uint32_t MAX_K = 8192, uint32_t C_BANKS = 1> class GmgIdentityStream32Cube {
public:
  static_assert(!PACKED && WIDTH == 32 && (C_BANKS == 1 || C_BANKS == 2), "raw single-C0 layout and bounded C buffers");
  static constexpr uint32_t INNER_K = WIDTH <= 64 ? 512 : (WIDTH <= 128 ? 256 : 128);
  __aicore__ inline void Init(const AscendC::tiling::TCubeTiling *, AscendC::TPipe *pipe) {
    pipe->InitBuffer(a1b, 1, HEIGHT * MAX_K);
    pipe->InitBuffer(b1b, 2, 512 * WIDTH);
    pipe->InitBuffer(a2b, 2, HEIGHT * INNER_K);
    pipe->InitBuffer(b2b, (INNER_K * WIDTH * 2 <= 65536 ? 2 : 1), INNER_K * WIDTH);
    pipe->InitBuffer(c1b, C_BANKS, HEIGHT * WIDTH * 4);
  }
  __aicore__ inline void SetOrgShape(uint32_t, uint32_t n, uint32_t k, uint32_t, uint32_t stride) {
    n_ = n;
    kStride_ = k;
    stride_ = stride;
  }
  __aicore__ inline void SetSingleShape(uint32_t rows, uint32_t cols, uint32_t k) {
    rows_ = rows;
    cols_ = cols;
    k_ = k;
  }
  __aicore__ inline void SetTensorA(AscendC::GlobalTensor<int8_t> value) { x_ = value; }
  __aicore__ inline void SetTensorB(AscendC::GlobalTensor<int8_t> value) { w_ = value; }
  __aicore__ inline void IterateAll(AscendC::GlobalTensor<int32_t> result) {
    using namespace AscendC;
    auto a1 = a1b.AllocTensor<int8_t>();
    auto c1 = c1b.AllocTensor<int32_t>();
    uint32_t paddedM = (rows_ + 15) / 16 * 16, paddedK = (k_ + INNER_K - 1) / INNER_K * INNER_K;
    uint32_t paddedN = (cols_ + 31) / 32 * 32;
    if (rows_ != paddedM || k_ != paddedK) {
      InitConstValue(a1.ReinterpretCast<uint32_t>(), InitConstValueParams<uint32_t>{1, uint16_t(paddedM * paddedK / 32), 0, 0});
      PipeBarrier<PIPE_MTE2>();
    }
    Nd2NzParams ap{};
    ap.ndNum = 1;
    ap.nValue = rows_;
    ap.dValue = k_;
    ap.srcDValue = kStride_;
    ap.dstNzC0Stride = paddedM;
    ap.dstNzNStride = 1;
    DataCopy(a1, x_, ap);
    a1b.EnQue(a1);
    CopyWeight(0, k_ < 512 ? k_ : 512, paddedN);
    a1 = a1b.DeQue<int8_t>();
    for (uint32_t base = 0; base < k_; base += 512) {
      uint32_t chunk = k_ - base < 512 ? k_ - base : 512;
      uint32_t paddedChunk = (chunk + INNER_K - 1) / INNER_K * INNER_K;
      auto b1 = b1b.DeQue<int8_t>();
      if (base + 512 < k_) {
        uint32_t next = k_ - base - 512 < 512 ? k_ - base - 512 : 512;
        CopyWeight(base + 512, next, paddedN);
      }
      for (uint32_t inner = 0; inner < paddedChunk; inner += INNER_K) {
        auto a2 = a2b.AllocTensor<int8_t>();
        auto b2 = b2b.AllocTensor<int8_t>();
        LoadData2dParams al{};
        al.repeatTimes = INNER_K / 32;
        al.srcStride = paddedM / 16;
        for (uint32_t m = 0; m < paddedM; m += 16) LoadData(a2[m * INNER_K], a1[(base + inner) * paddedM + m * 32], al);
        LoadData2dTransposeParams bl{};
        bl.repeatTimes = paddedN / 32;
        bl.srcStride = PACKED ? 16 : paddedChunk / 32;
        bl.dstGap = 1;
        for (uint32_t kk = 0; kk < INNER_K; kk += 32) LoadDataWithTranspose(b2[kk * paddedN], b1[(inner + kk) * 32], bl);
        a2b.EnQue(a2);
        b2b.EnQue(b2);
        a2 = a2b.DeQue<int8_t>();
        b2 = b2b.DeQue<int8_t>();
        MmadParams mad{};
        mad.m = paddedM;
        mad.n = paddedN;
        mad.k = INNER_K;
        mad.cmatrixInitVal = (base == 0 && inner == 0);
        Mmad(c1, a2, b2, mad);
        PipeBarrier<PIPE_M>();
        a2b.FreeTensor(a2);
        b2b.FreeTensor(b2);
      }
      b1b.FreeTensor(b1);
    }
    a1b.FreeTensor(a1);
    c1b.EnQue(c1);
    c1 = c1b.DeQue<int32_t>();
    FixpipeParamsV220 fix{};
    fix.nSize = paddedN;
    fix.mSize = rows_;
    fix.srcStride = paddedM;
    fix.dstStride = stride_;
    Fixpipe<int32_t, int32_t, CFG_ROW_MAJOR>(result, c1, fix);
    c1b.FreeTensor(c1);
  }
  __aicore__ inline void End() {}

private:
  __aicore__ inline void CopyWeight(uint32_t base, uint32_t chunk, uint32_t paddedN) {
    using namespace AscendC;
    auto b1 = b1b.AllocTensor<int8_t>();

    if (chunk != 512) {
      InitConstValue(b1.ReinterpretCast<uint32_t>(), InitConstValueParams<uint32_t>{1, uint16_t(512 * 32 / 32), 0, 0});
      PipeBarrier<PIPE_MTE2>();
    }
    DataCopy(b1, w_[uint64_t(base) * n_], chunk * 32);
    b1b.EnQue(b1);
  }
  AscendC::TQue<AscendC::TPosition::A1, 1> a1b;
  AscendC::TQue<AscendC::TPosition::B1, 2> b1b;
  AscendC::TQue<AscendC::TPosition::A2, 2> a2b;
  AscendC::TQue<AscendC::TPosition::B2, 2> b2b;
  AscendC::TQue<AscendC::TPosition::CO1, 1> c1b;
  AscendC::GlobalTensor<int8_t> x_, w_;
  uint32_t rows_ = 0, cols_ = 0, n_ = 0, k_ = 0, kStride_ = 0, stride_ = 0;
};

template <bool PACKED = false, uint32_t WIDTH = 64, uint32_t HEIGHT = 32, uint32_t MAX_K = 8192, uint32_t BLOCK_K = 512> class GmgWideCube {
public:
  static constexpr uint32_t INNER_K = WIDTH <= 64 ? 512 : (WIDTH <= 128 ? 256 : (WIDTH <= 256 ? 256 : 64));
  __aicore__ inline void Init(const AscendC::tiling::TCubeTiling *, AscendC::TPipe *pipe) {
    pipe->InitBuffer(a1b, 1, HEIGHT * MAX_K);
    pipe->InitBuffer(b1b, 2, BLOCK_K * WIDTH);
    pipe->InitBuffer(a2b, 2, HEIGHT * (WIDTH > 256 ? 256 : INNER_K));
    pipe->InitBuffer(b2b, (INNER_K * WIDTH * 2 <= 65536 ? 2 : 1), INNER_K * WIDTH);
    pipe->InitBuffer(c1b, 1, HEIGHT * WIDTH * 4);
  }
  __aicore__ inline void SetOrgShape(uint32_t, uint32_t n, uint32_t k, uint32_t, uint32_t stride) {
    n_ = n;
    kStride_ = k;
    stride_ = stride;
  }
  __aicore__ inline void SetSingleShape(uint32_t rows, uint32_t cols, uint32_t k) {
    rows_ = rows;
    cols_ = cols;
    k_ = k;
  }
  __aicore__ inline void SetTensorA(AscendC::GlobalTensor<int8_t> value) { x_ = value; }
  __aicore__ inline void SetTensorB(AscendC::GlobalTensor<int8_t> value) { w_ = value; }
  __aicore__ inline void IterateAll(AscendC::GlobalTensor<int32_t> result) {
    using namespace AscendC;
    auto a1 = a1b.AllocTensor<int8_t>();
    auto c1 = c1b.AllocTensor<int32_t>();
    uint32_t paddedM = (rows_ + 15) / 16 * 16, paddedN = (cols_ + 31) / 32 * 32;
    uint32_t innerK = WIDTH > 256 ? (paddedN <= 128 ? 256 : (paddedN <= 256 ? 128 : 64)) : INNER_K;
    uint32_t paddedK = (k_ + innerK - 1) / innerK * innerK;
    if (rows_ != paddedM || k_ != paddedK) {
      InitConstValue(a1.ReinterpretCast<uint32_t>(), InitConstValueParams<uint32_t>{1, uint16_t(paddedM * paddedK / 32), 0, 0});
      PipeBarrier<PIPE_MTE2>();
    }
    Nd2NzParams ap{};
    ap.ndNum = 1;
    ap.nValue = rows_;
    ap.dValue = k_;
    ap.srcDValue = kStride_;
    ap.dstNzC0Stride = paddedM;
    ap.dstNzNStride = 1;
    DataCopy(a1, x_, ap);
    a1b.EnQue(a1);
    CopyWeight(0, k_ < BLOCK_K ? k_ : BLOCK_K, paddedN, innerK);
    a1 = a1b.DeQue<int8_t>();
    for (uint32_t base = 0; base < k_; base += BLOCK_K) {
      uint32_t chunk = k_ - base < BLOCK_K ? k_ - base : BLOCK_K;
      uint32_t paddedChunk = (chunk + innerK - 1) / innerK * innerK;
      auto b1 = b1b.DeQue<int8_t>();
      if (base + BLOCK_K < k_) {
        uint32_t next = k_ - base - BLOCK_K < BLOCK_K ? k_ - base - BLOCK_K : BLOCK_K;
        CopyWeight(base + BLOCK_K, next, paddedN, innerK);
      }
      for (uint32_t inner = 0; inner < paddedChunk; inner += innerK) {
        auto a2 = a2b.AllocTensor<int8_t>();
        auto b2 = b2b.AllocTensor<int8_t>();
        LoadData2dParams al{};
        al.repeatTimes = innerK / 32;
        al.srcStride = paddedM / 16;
        for (uint32_t m = 0; m < paddedM; m += 16) LoadData(a2[m * innerK], a1[(base + inner) * paddedM + m * 32], al);
        LoadData2dTransposeParams bl{};
        bl.repeatTimes = paddedN / 32;
        bl.srcStride = PACKED ? 16 : paddedChunk / 32;
        bl.dstGap = 1;
        for (uint32_t kk = 0; kk < innerK; kk += 32) LoadDataWithTranspose(b2[kk * paddedN], b1[(inner + kk) * 32], bl);
        a2b.EnQue(a2);
        b2b.EnQue(b2);
        a2 = a2b.DeQue<int8_t>();
        b2 = b2b.DeQue<int8_t>();
        MmadParams mad{};
        mad.m = paddedM;
        mad.n = paddedN;
        mad.k = innerK;
        mad.cmatrixInitVal = (base == 0 && inner == 0);
        Mmad(c1, a2, b2, mad);
        PipeBarrier<PIPE_M>();
        a2b.FreeTensor(a2);
        b2b.FreeTensor(b2);
      }
      b1b.FreeTensor(b1);
    }
    a1b.FreeTensor(a1);
    c1b.EnQue(c1);
    c1 = c1b.DeQue<int32_t>();
    FixpipeParamsV220 fix{};
    fix.nSize = paddedN;
    fix.mSize = rows_;
    fix.srcStride = paddedM;
    fix.dstStride = stride_;
    Fixpipe<int32_t, int32_t, CFG_ROW_MAJOR>(result, c1, fix);
    c1b.FreeTensor(c1);
  }
  __aicore__ inline void End() {}

private:
  __aicore__ inline void CopyWeight(uint32_t base, uint32_t chunk, uint32_t paddedN, uint32_t innerK) {
    using namespace AscendC;
    auto b1 = b1b.AllocTensor<int8_t>();
    if constexpr (PACKED) {

      DataCopy(b1, w_[uint64_t(base) * n_], BLOCK_K * paddedN);
      b1b.EnQue(b1);
      return;
    }
    uint32_t paddedChunk = (chunk + innerK - 1) / innerK * innerK;

    if (chunk != paddedChunk) {
      InitConstValue(b1.ReinterpretCast<uint32_t>(), InitConstValueParams<uint32_t>{1, uint16_t(paddedChunk * paddedN / 32), 0, 0});
      PipeBarrier<PIPE_MTE2>();
    }
    Nd2NzParams bp{};
    bp.ndNum = 1;
    bp.nValue = chunk;
    bp.dValue = cols_;
    bp.srcDValue = n_;
    bp.dstNzC0Stride = paddedChunk;
    bp.dstNzNStride = 1;
    DataCopy(b1, w_[uint64_t(base) * n_], bp);
    b1b.EnQue(b1);
  }
  AscendC::TQue<AscendC::TPosition::A1, 1> a1b;
  AscendC::TQue<AscendC::TPosition::B1, 2> b1b;
  AscendC::TQue<AscendC::TPosition::A2, 2> a2b;
  AscendC::TQue<AscendC::TPosition::B2, 2> b2b;
  AscendC::TQue<AscendC::TPosition::CO1, 1> c1b;
  AscendC::GlobalTensor<int8_t> x_, w_;
  uint32_t rows_ = 0, cols_ = 0, n_ = 0, k_ = 0, kStride_ = 0, stride_ = 0;
};

template <bool PACKED = false, uint32_t WIDTH = 64, uint32_t HEIGHT = 32, uint32_t MAX_K = 8192, uint32_t BLOCK_K = 512> class GmgWideLongCube {
public:
  static constexpr uint32_t A_BYTES = 262144;
  static_assert(WIDTH == 512 && HEIGHT == 64 && MAX_K == 8192 && BLOCK_K == 256, "long-wide resource layout");
  static constexpr uint32_t INNER_K = WIDTH <= 64 ? 512 : (WIDTH <= 128 ? 256 : (WIDTH <= 256 ? 256 : 64));
  __aicore__ inline void Init(const AscendC::tiling::TCubeTiling *, AscendC::TPipe *pipe) {
    pipe->InitBuffer(a1b, 1, A_BYTES);
    pipe->InitBuffer(b1b, 2, BLOCK_K * WIDTH);
    pipe->InitBuffer(a2b, 2, HEIGHT * (WIDTH > 256 ? 256 : INNER_K));
    pipe->InitBuffer(b2b, (INNER_K * WIDTH * 2 <= 65536 ? 2 : 1), INNER_K * WIDTH);
    pipe->InitBuffer(c1b, 1, HEIGHT * WIDTH * 4);
  }
  __aicore__ inline void SetOrgShape(uint32_t, uint32_t n, uint32_t k, uint32_t, uint32_t stride) {
    n_ = n;
    kStride_ = k;
    stride_ = stride;
  }
  __aicore__ inline void SetCStride(uint32_t stride) { stride_ = stride; }
  __aicore__ inline void SetSingleShape(uint32_t rows, uint32_t cols, uint32_t k) {
    rows_ = rows;
    cols_ = cols;
    k_ = k;
  }
  __aicore__ inline void SetTensorA(AscendC::GlobalTensor<int8_t> value) { x_ = value; }
  __aicore__ inline void SetTensorB(AscendC::GlobalTensor<int8_t> value) { w_ = value; }
  __aicore__ inline void IterateAll(AscendC::GlobalTensor<int32_t> result) {
    using namespace AscendC;
    auto c1 = c1b.AllocTensor<int32_t>();
    uint32_t paddedM = (rows_ + 15) / 16 * 16, paddedN = (cols_ + 31) / 32 * 32;
    uint32_t innerK = paddedN <= 128 ? 256 : (paddedN <= 256 ? 128 : 64);

    if (paddedM > 64 && innerK > 128) innerK = 128;

    uint32_t blockK = paddedN <= 32 ? 4096 : (paddedN <= 64 ? 2048 : (paddedN <= 128 ? 1024 : (paddedN <= 256 ? 512 : 256)));
    if (paddedM > 64 && blockK > 2048) blockK = 2048;
    uint32_t paddedK = (k_ + innerK - 1) / innerK * innerK;
    const bool wholeA = paddedM * paddedK <= A_BYTES;
    if (wholeA)
      CopyA(0, k_, paddedK, paddedM);
    else
      CopyA(0, k_ < blockK ? k_ : blockK, blockK, paddedM);
    CopyWeight(0, k_ < blockK ? k_ : blockK, paddedN, innerK);
    auto a1 = a1b.DeQue<int8_t>();
    for (uint32_t base = 0; base < k_; base += blockK) {
      if (base && !wholeA) a1 = a1b.DeQue<int8_t>();
      uint32_t chunk = k_ - base < blockK ? k_ - base : blockK;
      uint32_t paddedChunk = (chunk + innerK - 1) / innerK * innerK;
      auto b1 = b1b.DeQue<int8_t>();
      if (base + blockK < k_) {
        uint32_t next = k_ - base - blockK < blockK ? k_ - base - blockK : blockK;
        CopyWeight(base + blockK, next, paddedN, innerK);
      }
      for (uint32_t inner = 0; inner < paddedChunk; inner += innerK) {
        auto a2 = a2b.AllocTensor<int8_t>();
        auto b2 = b2b.AllocTensor<int8_t>();
        LoadData2dParams al{};
        al.repeatTimes = innerK / 32;
        al.srcStride = paddedM / 16;
        for (uint32_t m = 0; m < paddedM; m += 16) LoadData(a2[m * innerK], a1[((wholeA ? base : 0) + inner) * paddedM + m * 32], al);
        LoadData2dTransposeParams bl{};
        bl.repeatTimes = paddedN / 32;
        bl.srcStride = PACKED ? 16 : paddedChunk / 32;
        bl.dstGap = 1;
        for (uint32_t kk = 0; kk < innerK; kk += 32) LoadDataWithTranspose(b2[kk * paddedN], b1[(inner + kk) * 32], bl);

        if (!wholeA && inner + innerK == paddedChunk) {
          a1b.FreeTensor(a1);
          if (base + blockK < k_) {
            uint32_t next = k_ - base - blockK < blockK ? k_ - base - blockK : blockK;
            uint32_t paddedNext = (next + innerK - 1) / innerK * innerK;
            CopyA(base + blockK, next, paddedNext, paddedM);
          }
        }
        a2b.EnQue(a2);
        b2b.EnQue(b2);
        a2 = a2b.DeQue<int8_t>();
        b2 = b2b.DeQue<int8_t>();
        MmadParams mad{};
        mad.m = paddedM;
        mad.n = paddedN;
        mad.k = innerK;
        mad.cmatrixInitVal = (base == 0 && inner == 0);
        Mmad(c1, a2, b2, mad);
        PipeBarrier<PIPE_M>();
        a2b.FreeTensor(a2);
        b2b.FreeTensor(b2);
      }
      b1b.FreeTensor(b1);
    }
    if (wholeA) a1b.FreeTensor(a1);
    c1b.EnQue(c1);
    c1 = c1b.DeQue<int32_t>();
    FixpipeParamsV220 fix{};
    fix.nSize = paddedN;
    fix.mSize = rows_;
    fix.srcStride = paddedM;
    fix.dstStride = stride_;
    Fixpipe<int32_t, int32_t, CFG_ROW_MAJOR>(result, c1, fix);
    c1b.FreeTensor(c1);
  }
  __aicore__ inline void End() {}

private:
  __aicore__ inline void CopyA(uint32_t base, uint32_t chunk, uint32_t paddedK, uint32_t paddedM) {
    using namespace AscendC;
    auto a1 = a1b.AllocTensor<int8_t>();

    PipeBarrier<PIPE_MTE2>();
    if (rows_ != paddedM || chunk != paddedK) {

      const uint32_t fullFragments = chunk / 32;
      if (rows_ != paddedM && fullFragments)
        InitConstValue(
          a1.ReinterpretCast<uint32_t>()[rows_ * 8], InitConstValueParams<uint32_t>{uint16_t(fullFragments), uint16_t(paddedM - rows_), uint16_t(rows_), 0});
      if (fullFragments * 32 < paddedK)
        InitConstValue(a1.ReinterpretCast<uint32_t>()[fullFragments * paddedM * 8],
          InitConstValueParams<uint32_t>{1, uint16_t((paddedK - fullFragments * 32) * paddedM / 32), 0, 0});
      PipeBarrier<PIPE_MTE2>();
    }
    Nd2NzParams ap{};
    ap.ndNum = 1;
    ap.nValue = rows_;
    ap.dValue = chunk;
    ap.srcDValue = kStride_;
    ap.dstNzC0Stride = paddedM;
    ap.dstNzNStride = 1;
    DataCopy(a1, x_[base], ap);
    a1b.EnQue(a1);
  }
  __aicore__ inline void CopyWeight(uint32_t base, uint32_t chunk, uint32_t paddedN, uint32_t innerK) {
    using namespace AscendC;
    auto b1 = b1b.AllocTensor<int8_t>();
    if constexpr (PACKED) {

      DataCopy(b1, w_[uint64_t(base) * n_], BLOCK_K * paddedN);
      b1b.EnQue(b1);
      return;
    }
    uint32_t paddedChunk = (chunk + innerK - 1) / innerK * innerK;

    if (chunk != paddedChunk) {
      InitConstValue(b1.ReinterpretCast<uint32_t>(), InitConstValueParams<uint32_t>{1, uint16_t(paddedChunk * paddedN / 32), 0, 0});
      PipeBarrier<PIPE_MTE2>();
    }
    Nd2NzParams bp{};
    bp.ndNum = 1;
    bp.nValue = chunk;
    bp.dValue = cols_;
    bp.srcDValue = n_;
    bp.dstNzC0Stride = paddedChunk;
    bp.dstNzNStride = 1;
    DataCopy(b1, w_[uint64_t(base) * n_], bp);
    b1b.EnQue(b1);
  }
  AscendC::TQue<AscendC::TPosition::A1, 1> a1b;
  AscendC::TQue<AscendC::TPosition::B1, 2> b1b;
  AscendC::TQue<AscendC::TPosition::A2, 2> a2b;
  AscendC::TQue<AscendC::TPosition::B2, 2> b2b;
  AscendC::TQue<AscendC::TPosition::CO1, 1> c1b;
  AscendC::GlobalTensor<int8_t> x_, w_;
  uint32_t rows_ = 0, cols_ = 0, n_ = 0, k_ = 0, kStride_ = 0, stride_ = 0;
};

template <uint32_t WIDTH, uint32_t HEIGHT> class GmgStreamCube {
public:
  static constexpr uint32_t INNER_K = WIDTH <= 64 ? 512 : (WIDTH <= 128 ? 256 : 128);
  __aicore__ inline void Init(const AscendC::tiling::TCubeTiling *, AscendC::TPipe *pipe) {
    pipe->InitBuffer(a1b, 2, HEIGHT * 512);
    pipe->InitBuffer(b1b, 2, 512 * WIDTH);
    pipe->InitBuffer(a2b, 2, HEIGHT * INNER_K);
    pipe->InitBuffer(b2b, (INNER_K * WIDTH * 2 <= 65536 ? 2 : 1), INNER_K * WIDTH);
    pipe->InitBuffer(c1b, 1, HEIGHT * WIDTH * 4);
  }
  __aicore__ inline void SetOrgShape(uint32_t, uint32_t n, uint32_t k, uint32_t, uint32_t stride) {
    n_ = n;
    kStride_ = k;
    stride_ = stride;
  }
  __aicore__ inline void SetSingleShape(uint32_t rows, uint32_t cols, uint32_t k) {
    rows_ = rows;
    cols_ = cols;
    k_ = k;
  }
  __aicore__ inline void SetTensorA(AscendC::GlobalTensor<int8_t> value) { x_ = value; }
  __aicore__ inline void SetTensorB(AscendC::GlobalTensor<int8_t> value) { w_ = value; }
  __aicore__ inline void IterateAll(AscendC::GlobalTensor<int32_t> result) {
    using namespace AscendC;
    uint32_t pm = (rows_ + 15) / 16 * 16, pn = (cols_ + 31) / 32 * 32;
    auto c1 = c1b.AllocTensor<int32_t>();
    CopyChunk(0, k_ < 512 ? k_ : 512, pm, pn);
    for (uint32_t base = 0; base < k_; base += 512) {
      uint32_t count = k_ - base < 512 ? k_ - base : 512;
      uint32_t pk = (count + INNER_K - 1) / INNER_K * INNER_K;
      auto a1 = a1b.DeQue<int8_t>();
      auto b1 = b1b.DeQue<int8_t>();
      if (base + 512 < k_) CopyChunk(base + 512, k_ - base - 512 < 512 ? k_ - base - 512 : 512, pm, pn);
      for (uint32_t inner = 0; inner < pk; inner += INNER_K) {
        auto a2 = a2b.AllocTensor<int8_t>();
        auto b2 = b2b.AllocTensor<int8_t>();
        LoadData2dParams al{};
        al.repeatTimes = INNER_K / 32;
        al.srcStride = pm / 16;
        for (uint32_t m = 0; m < pm; m += 16) LoadData(a2[m * INNER_K], a1[inner * pm + m * 32], al);
        LoadData2dTransposeParams bl{};
        bl.repeatTimes = pn / 32;
        bl.srcStride = pk / 32;
        bl.dstGap = 1;
        for (uint32_t kk = 0; kk < INNER_K; kk += 32) LoadDataWithTranspose(b2[kk * pn], b1[(inner + kk) * 32], bl);
        a2b.EnQue(a2);
        b2b.EnQue(b2);
        a2 = a2b.DeQue<int8_t>();
        b2 = b2b.DeQue<int8_t>();
        MmadParams mad{};
        mad.m = pm;
        mad.n = pn;
        mad.k = INNER_K;
        mad.cmatrixInitVal = (base == 0 && inner == 0);
        Mmad(c1, a2, b2, mad);
        PipeBarrier<PIPE_M>();
        a2b.FreeTensor(a2);
        b2b.FreeTensor(b2);
      }
      a1b.FreeTensor(a1);
      b1b.FreeTensor(b1);
    }
    c1b.EnQue(c1);
    c1 = c1b.DeQue<int32_t>();
    FixpipeParamsV220 fix{};
    fix.nSize = pn;
    fix.mSize = rows_;
    fix.srcStride = pm;
    fix.dstStride = stride_;
    Fixpipe<int32_t, int32_t, CFG_ROW_MAJOR>(result, c1, fix);
    c1b.FreeTensor(c1);
  }
  __aicore__ inline void End() {}

private:
  __aicore__ inline void CopyChunk(uint32_t base, uint32_t count, uint32_t pm, uint32_t pn) {
    using namespace AscendC;
    auto a1 = a1b.AllocTensor<int8_t>();
    auto b1 = b1b.AllocTensor<int8_t>();
    uint32_t pk = (count + INNER_K - 1) / INNER_K * INNER_K;
    if (rows_ != pm || count != pk) {
      InitConstValue(a1.ReinterpretCast<uint32_t>(), InitConstValueParams<uint32_t>{1, uint16_t(pm * pk / 32), 0, 0});
      PipeBarrier<PIPE_MTE2>();
    }
    if (count != pk) {
      InitConstValue(b1.ReinterpretCast<uint32_t>(), InitConstValueParams<uint32_t>{1, uint16_t(pk * pn / 32), 0, 0});
      PipeBarrier<PIPE_MTE2>();
    }
    Nd2NzParams ap{};
    ap.ndNum = 1;
    ap.nValue = rows_;
    ap.dValue = count;
    ap.srcDValue = kStride_;
    ap.dstNzC0Stride = pm;
    ap.dstNzNStride = 1;
    DataCopy(a1, x_[base], ap);
    a1b.EnQue(a1);
    Nd2NzParams bp{};
    bp.ndNum = 1;
    bp.nValue = count;
    bp.dValue = cols_;
    bp.srcDValue = n_;
    bp.dstNzC0Stride = pk;
    bp.dstNzNStride = 1;
    DataCopy(b1, w_[uint64_t(base) * n_], bp);
    b1b.EnQue(b1);
  }
  AscendC::TQue<AscendC::TPosition::A1, 2> a1b;
  AscendC::TQue<AscendC::TPosition::B1, 2> b1b;
  AscendC::TQue<AscendC::TPosition::A2, 2> a2b;
  AscendC::TQue<AscendC::TPosition::B2, 2> b2b;
  AscendC::TQue<AscendC::TPosition::CO1, 1> c1b;
  AscendC::GlobalTensor<int8_t> x_, w_;
  uint32_t n_ = 0, kStride_ = 0, stride_ = 0, rows_ = 0, cols_ = 0, k_ = 0;
};

class GmgInitializedStreamTallCube {
public:
  static constexpr uint32_t WIDTH = 256, HEIGHT = 128;
  static constexpr uint32_t INNER_K = WIDTH <= 64 ? 512 : (WIDTH <= 128 ? 256 : 128);
  __aicore__ inline void Init(const AscendC::tiling::TCubeTiling *, AscendC::TPipe *pipe) {
    pipe->InitBuffer(a1b, 2, HEIGHT * 512);
    pipe->InitBuffer(b1b, 2, 512 * WIDTH);
    pipe->InitBuffer(a2b, 2, HEIGHT * INNER_K);
    pipe->InitBuffer(b2b, (INNER_K * WIDTH * 2 <= 65536 ? 2 : 1), INNER_K * WIDTH);
    pipe->InitBuffer(c1b, 1, HEIGHT * WIDTH * 4);
  }
  __aicore__ inline void SetOrgShape(uint32_t, uint32_t n, uint32_t k, uint32_t, uint32_t stride) {
    n_ = n;
    kStride_ = k;
    stride_ = stride;
  }
  __aicore__ inline void SetSingleShape(uint32_t rows, uint32_t cols, uint32_t k) {
    rows_ = rows;
    cols_ = cols;
    k_ = k;
  }
  __aicore__ inline void SetTensorA(AscendC::GlobalTensor<int8_t> value) { x_ = value; }
  __aicore__ inline void SetTensorB(AscendC::GlobalTensor<int8_t> value) { w_ = value; }
  __aicore__ inline void IterateAll(AscendC::GlobalTensor<int32_t> result) {
    using namespace AscendC;
    uint32_t pm = (rows_ + 15) / 16 * 16, pn = (cols_ + 31) / 32 * 32;
    auto c1 = c1b.AllocTensor<int32_t>();
    CopyChunk(0, k_ < 512 ? k_ : 512, pm, pn);
    for (uint32_t base = 0; base < k_; base += 512) {
      uint32_t count = k_ - base < 512 ? k_ - base : 512;
      uint32_t pk = (count + INNER_K - 1) / INNER_K * INNER_K;
      auto a1 = a1b.DeQue<int8_t>();
      auto b1 = b1b.DeQue<int8_t>();
      if (base + 512 < k_) CopyChunk(base + 512, k_ - base - 512 < 512 ? k_ - base - 512 : 512, pm, pn);
      for (uint32_t inner = 0; inner < pk; inner += INNER_K) {
        auto a2 = a2b.AllocTensor<int8_t>();
        auto b2 = b2b.AllocTensor<int8_t>();
        LoadData2dParams al{};
        al.repeatTimes = INNER_K / 32;
        al.srcStride = pm / 16;
        for (uint32_t m = 0; m < pm; m += 16) LoadData(a2[m * INNER_K], a1[inner * pm + m * 32], al);
        LoadData2dTransposeParams bl{};
        bl.repeatTimes = pn / 32;
        bl.srcStride = pk / 32;
        bl.dstGap = 1;
        for (uint32_t kk = 0; kk < INNER_K; kk += 32) LoadDataWithTranspose(b2[kk * pn], b1[(inner + kk) * 32], bl);
        a2b.EnQue(a2);
        b2b.EnQue(b2);
        a2 = a2b.DeQue<int8_t>();
        b2 = b2b.DeQue<int8_t>();
        MmadParams mad{};
        mad.m = pm;
        mad.n = pn;
        mad.k = INNER_K;
        mad.cmatrixInitVal = (base == 0 && inner == 0);
        Mmad(c1, a2, b2, mad);
        PipeBarrier<PIPE_M>();
        a2b.FreeTensor(a2);
        b2b.FreeTensor(b2);
      }
      a1b.FreeTensor(a1);
      b1b.FreeTensor(b1);
    }
    c1b.EnQue(c1);
    c1 = c1b.DeQue<int32_t>();
    FixpipeParamsV220 fix{};
    fix.nSize = pn;
    fix.mSize = rows_;
    fix.srcStride = pm;
    fix.dstStride = stride_;
    // Input staging and L0C arithmetic do not touch the initialized GM
    // C banks. Wait only when the first actual C publication is ready.
    if (firstOutput_) {
      CrossCoreWaitFlag<2>(2);
      firstOutput_ = false;
    }
    Fixpipe<int32_t, int32_t, CFG_ROW_MAJOR>(result, c1, fix);
    c1b.FreeTensor(c1);
  }
  __aicore__ inline void End() {}

private:
  bool firstOutput_ = true;
  __aicore__ inline void CopyChunk(uint32_t base, uint32_t count, uint32_t pm, uint32_t pn) {
    using namespace AscendC;
    auto a1 = a1b.AllocTensor<int8_t>();
    auto b1 = b1b.AllocTensor<int8_t>();
    uint32_t pk = (count + INNER_K - 1) / INNER_K * INNER_K;
    if (rows_ != pm || count != pk) {
      InitConstValue(a1.ReinterpretCast<uint32_t>(), InitConstValueParams<uint32_t>{1, uint16_t(pm * pk / 32), 0, 0});
      PipeBarrier<PIPE_MTE2>();
    }
    if (count != pk) {
      InitConstValue(b1.ReinterpretCast<uint32_t>(), InitConstValueParams<uint32_t>{1, uint16_t(pk * pn / 32), 0, 0});
      PipeBarrier<PIPE_MTE2>();
    }
    Nd2NzParams ap{};
    ap.ndNum = 1;
    ap.nValue = rows_;
    ap.dValue = count;
    ap.srcDValue = kStride_;
    ap.dstNzC0Stride = pm;
    ap.dstNzNStride = 1;
    DataCopy(a1, x_[base], ap);
    a1b.EnQue(a1);
    Nd2NzParams bp{};
    bp.ndNum = 1;
    bp.nValue = count;
    bp.dValue = cols_;
    bp.srcDValue = n_;
    bp.dstNzC0Stride = pk;
    bp.dstNzNStride = 1;
    DataCopy(b1, w_[uint64_t(base) * n_], bp);
    b1b.EnQue(b1);
  }
  AscendC::TQue<AscendC::TPosition::A1, 2> a1b;
  AscendC::TQue<AscendC::TPosition::B1, 2> b1b;
  AscendC::TQue<AscendC::TPosition::A2, 2> a2b;
  AscendC::TQue<AscendC::TPosition::B2, 2> b2b;
  AscendC::TQue<AscendC::TPosition::CO1, 1> c1b;
  AscendC::GlobalTensor<int8_t> x_, w_;
  uint32_t n_ = 0, kStride_ = 0, stride_ = 0, rows_ = 0, cols_ = 0, k_ = 0;
};

template <uint32_t WIDTH, uint32_t HEIGHT> class GmgFirstUseCube {
public:
  static constexpr uint32_t INNER_K = WIDTH <= 64 ? 512 : (WIDTH <= 128 ? 256 : 128);
  __aicore__ inline void Init(const AscendC::tiling::TCubeTiling *, AscendC::TPipe *pipe) {
    pipe_ = pipe;
    copyReady_ = pipe->AllocEventID<AscendC::HardEvent::MTE2_MTE3>();
    copyDone_ = pipe->AllocEventID<AscendC::HardEvent::MTE3_MTE2>();
    pipe->InitBuffer(a1b, 2, HEIGHT * 512);
    pipe->InitBuffer(b1b, 2, 512 * WIDTH);
    pipe->InitBuffer(a2b, 2, HEIGHT * INNER_K);
    pipe->InitBuffer(b2b, (INNER_K * WIDTH * 2 <= 65536 ? 2 : 1), INNER_K * WIDTH);
    pipe->InitBuffer(c1b, 1, HEIGHT * WIDTH * 4);
  }
  __aicore__ inline void SetOrgShape(uint32_t, uint32_t n, uint32_t k, uint32_t, uint32_t stride) {
    n_ = n;
    kStride_ = k;
    stride_ = stride;
  }
  __aicore__ inline void SetWeightStage(AscendC::GlobalTensor<int8_t> value, bool packed, bool save) {
    stage_ = value;
    packed_ = packed;
    save_ = save;
  }
  __aicore__ inline void ReleaseEvents() {
    pipe_->ReleaseEventID<AscendC::HardEvent::MTE2_MTE3>(copyReady_);
    pipe_->ReleaseEventID<AscendC::HardEvent::MTE3_MTE2>(copyDone_);
  }
  __aicore__ inline void SetSingleShape(uint32_t rows, uint32_t cols, uint32_t k) {
    rows_ = rows;
    cols_ = cols;
    k_ = k;
  }
  __aicore__ inline void SetTensorA(AscendC::GlobalTensor<int8_t> value) { x_ = value; }
  __aicore__ inline void SetTensorB(AscendC::GlobalTensor<int8_t> value) { w_ = value; }
  __aicore__ inline void IterateAll(AscendC::GlobalTensor<int32_t> result) {
    using namespace AscendC;
    uint32_t pm = (rows_ + 15) / 16 * 16, pn = (cols_ + 31) / 32 * 32;
    auto c1 = c1b.AllocTensor<int32_t>();
    CopyChunk(0, k_ < 512 ? k_ : 512, pm, pn);
    for (uint32_t base = 0; base < k_; base += 512) {
      uint32_t count = k_ - base < 512 ? k_ - base : 512;
      uint32_t pk = (count + INNER_K - 1) / INNER_K * INNER_K;
      auto a1 = a1b.DeQue<int8_t>();
      auto b1 = b1b.DeQue<int8_t>();
      if (save_) {
        // The first useful M tile has already converted this B chunk.
        // Publish that representation while MTE1/M consume it.
        SetFlag<HardEvent::MTE2_MTE3>(copyReady_);
        WaitFlag<HardEvent::MTE2_MTE3>(copyReady_);
        DataCopy(stage_[uint64_t(base) * WIDTH], b1, 512 * pn);
        SetFlag<HardEvent::MTE3_MTE2>(copyDone_);
      }
      if (base + 512 < k_) CopyChunk(base + 512, k_ - base - 512 < 512 ? k_ - base - 512 : 512, pm, pn);
      for (uint32_t inner = 0; inner < pk; inner += INNER_K) {
        auto a2 = a2b.AllocTensor<int8_t>();
        auto b2 = b2b.AllocTensor<int8_t>();
        LoadData2dParams al{};
        al.repeatTimes = INNER_K / 32;
        al.srcStride = pm / 16;
        for (uint32_t m = 0; m < pm; m += 16) LoadData(a2[m * INNER_K], a1[inner * pm + m * 32], al);
        LoadData2dTransposeParams bl{};
        bl.repeatTimes = pn / 32;
        bl.srcStride = (packed_ || save_) ? 16 : pk / 32;
        bl.dstGap = 1;
        for (uint32_t kk = 0; kk < INNER_K; kk += 32) LoadDataWithTranspose(b2[kk * pn], b1[(inner + kk) * 32], bl);
        a2b.EnQue(a2);
        b2b.EnQue(b2);
        a2 = a2b.DeQue<int8_t>();
        b2 = b2b.DeQue<int8_t>();
        MmadParams mad{};
        mad.m = pm;
        mad.n = pn;
        mad.k = INNER_K;
        mad.cmatrixInitVal = (base == 0 && inner == 0);
        Mmad(c1, a2, b2, mad);
        PipeBarrier<PIPE_M>();
        a2b.FreeTensor(a2);
        b2b.FreeTensor(b2);
      }
      // Retire the L1 read before this queue slot can be overwritten.
      if (save_) WaitFlag<HardEvent::MTE3_MTE2>(copyDone_);
      a1b.FreeTensor(a1);
      b1b.FreeTensor(b1);
    }
    c1b.EnQue(c1);
    c1 = c1b.DeQue<int32_t>();
    FixpipeParamsV220 fix{};
    fix.nSize = pn;
    fix.mSize = rows_;
    fix.srcStride = pm;
    fix.dstStride = stride_;
    Fixpipe<int32_t, int32_t, CFG_ROW_MAJOR>(result, c1, fix);
    c1b.FreeTensor(c1);
  }
  __aicore__ inline void End() {}

private:
  __aicore__ inline void CopyChunk(uint32_t base, uint32_t count, uint32_t pm, uint32_t pn) {
    using namespace AscendC;
    auto a1 = a1b.AllocTensor<int8_t>();
    auto b1 = b1b.AllocTensor<int8_t>();
    uint32_t pk = (count + INNER_K - 1) / INNER_K * INNER_K;
    if (rows_ != pm || count != pk) {
      InitConstValue(a1.ReinterpretCast<uint32_t>(), InitConstValueParams<uint32_t>{1, uint16_t(pm * pk / 32), 0, 0});
      PipeBarrier<PIPE_MTE2>();
    }
    const uint32_t bPitch = save_ ? 512 : pk;
    if (!packed_ && count != bPitch) {
      InitConstValue(b1.ReinterpretCast<uint32_t>(), InitConstValueParams<uint32_t>{1, uint16_t(bPitch * pn / 32), 0, 0});
      PipeBarrier<PIPE_MTE2>();
    }
    Nd2NzParams ap{};
    ap.ndNum = 1;
    ap.nValue = rows_;
    ap.dValue = count;
    ap.srcDValue = kStride_;
    ap.dstNzC0Stride = pm;
    ap.dstNzNStride = 1;
    DataCopy(a1, x_[base], ap);
    a1b.EnQue(a1);
    if (packed_)
      DataCopy(b1, w_[uint64_t(base) * n_], 512 * pn);
    else {
      Nd2NzParams bp{};
      bp.ndNum = 1;
      bp.nValue = count;
      bp.dValue = cols_;
      bp.srcDValue = n_;
      bp.dstNzC0Stride = bPitch;
      bp.dstNzNStride = 1;
      DataCopy(b1, w_[uint64_t(base) * n_], bp);
    }
    b1b.EnQue(b1);
  }
  AscendC::TQue<AscendC::TPosition::A1, 2> a1b;
  AscendC::TQue<AscendC::TPosition::B1, 2> b1b;
  AscendC::TQue<AscendC::TPosition::A2, 2> a2b;
  AscendC::TQue<AscendC::TPosition::B2, 2> b2b;
  AscendC::TQue<AscendC::TPosition::CO1, 1> c1b;
  AscendC::GlobalTensor<int8_t> x_, w_, stage_;
  AscendC::TPipe *pipe_ = nullptr;
  AscendC::TEventID copyReady_ = 0, copyDone_ = 0;
  uint32_t n_ = 0, kStride_ = 0, stride_ = 0, rows_ = 0, cols_ = 0, k_ = 0;
  bool packed_ = false, save_ = false;
};

using namespace AscendC;

template <typename GroupTensor> __aicore__ inline uint32_t GmgFindExpert(GroupTensor groups, uint32_t row, uint32_t count) {
  uint32_t lo = 0, hi = count;
  while (lo < hi) {
    uint32_t mid = lo + (hi - lo) / 2;
    if (groups.GetValue(mid) <= row)
      lo = mid + 1;
    else
      hi = mid;
  }
  return lo;
}

__aicore__ inline uint32_t GmgFirstExpert(GlobalTensor<int64_t> groups, uint32_t count) {

  return count >= 16 && groups.GetValue(7) == 0 ? GmgFindExpert(groups, 0, count) : 0;
}

__aicore__ inline uint32_t GmgFirstExpert(LocalTensor<int64_t> groups, uint32_t count) {

  return count >= 16 && groups.GetValue(7) == 0 ? GmgFindExpert(groups, 0, count) : 0;
}

template <bool JOIN_OR = false, bool WHOLE_COUNT = false>
__aicore__ inline void GmgMaskCombine(LocalTensor<uint8_t> dst, LocalTensor<uint8_t> lhs, LocalTensor<uint8_t> rhs, uint32_t elements) {

  auto d = dst.ReinterpretCast<uint16_t>();
  auto a = lhs.ReinterpretCast<uint16_t>();
  auto b = rhs.ReinterpretCast<uint16_t>();
  uint32_t full = elements / 128, tail = elements % 128;

  if constexpr (WHOLE_COUNT)
    if (!tail) {
      if constexpr (JOIN_OR)
        Or(d, a, b, elements);
      else
        And(d, a, b, elements);
      return;
    }
  SetMaskNorm();
  if (full) {
    if constexpr (JOIN_OR)
      Or(d, a, b, uint64_t(128), uint8_t(full), {1, 1, 1, 8, 8, 8});
    else
      And(d, a, b, uint64_t(128), uint8_t(full), {1, 1, 1, 8, 8, 8});
  }
  if (tail) {
    uint32_t start = full * 128;
    if constexpr (JOIN_OR)
      Or(d[start], a[start], b[start], uint64_t(tail), uint8_t(1), {1, 1, 1, 8, 8, 8});
    else
      And(d[start], a[start], b[start], uint64_t(tail), uint8_t(1), {1, 1, 1, 8, 8, 8});
  }
  ResetMask();
}

template <bool WHOLE_COUNT = false>
__aicore__ inline void GmgGelu(LocalTensor<float> z, LocalTensor<half> h, LocalTensor<float> u, LocalTensor<float> v, LocalTensor<float> p,
  LocalTensor<int32_t> a, LocalTensor<uint8_t> mask1, LocalTensor<uint8_t> mask2, uint32_t count) {
  SetMaskCount();
  SetVectorMask<float, MaskMode::COUNTER>(count);
  Mul<float, false>(u, z, z, MASK_PLACEHOLDER, 1, {1, 1, 1, 8, 8, 8});
  Muls<float, false>(u, u, -0.07135481759315014f, MASK_PLACEHOLDER, 1, {1, 1, 8, 8});
  Adds<float, false>(u, u, -1.5957691216057308f, MASK_PLACEHOLDER, 1, {1, 1, 8, 8});
  Mul<float, false>(u, u, z, MASK_PLACEHOLDER, 1, {1, 1, 1, 8, 8, 8});
  Mins<float, false>(u, u, 80.0f, MASK_PLACEHOLDER, 1, {1, 1, 8, 8});
  Exp<float, false>(u, u, MASK_PLACEHOLDER, 1, {1, 1, 8, 8});
  Adds<float, false>(u, u, 1.0f, MASK_PLACEHOLDER, 1, {1, 1, 8, 8});
  Div<float, false>(p, z, u, MASK_PLACEHOLDER, 1, {1, 1, 1, 8, 8, 8});
  Cast<half, float, false>(h, p, RoundMode::CAST_RINT, MASK_PLACEHOLDER, 1, {1, 1, 4, 8});
  SetMaskNorm();
  ResetMask();
  // Preserve the old routine's Vector-to-Scalar completion before caller DMA reuse.
  SetFlag<HardEvent::V_S>(EVENT_ID0);
  WaitFlag<HardEvent::V_S>(EVENT_ID0);
}

template <bool WHOLE_COUNT = false, bool WORD_FLAGS = false, bool ALIAS_RAW = false, bool NO_EXP_CLAMP = false, bool TIGHT_SUBNORMAL = false>
__aicore__ inline void GmgGeluSmall(LocalTensor<float> z, LocalTensor<half> h, LocalTensor<float> u, LocalTensor<float> v, LocalTensor<float> p,
  LocalTensor<int32_t> a, LocalTensor<uint8_t> mask1, LocalTensor<uint8_t> mask2, uint32_t count) {
  SetMaskCount();
  SetVectorMask<float, MaskMode::COUNTER>(count);
  Mul<float, false>(u, z, z, MASK_PLACEHOLDER, 1, {1, 1, 1, 8, 8, 8});
  Muls<float, false>(u, u, -0.07135481759315014f, MASK_PLACEHOLDER, 1, {1, 1, 8, 8});
  Adds<float, false>(u, u, -1.5957691216057308f, MASK_PLACEHOLDER, 1, {1, 1, 8, 8});
  Mul<float, false>(u, u, z, MASK_PLACEHOLDER, 1, {1, 1, 1, 8, 8, 8});
  if constexpr (!NO_EXP_CLAMP) Mins<float, false>(u, u, 80.0f, MASK_PLACEHOLDER, 1, {1, 1, 8, 8});
  Exp<float, false>(u, u, MASK_PLACEHOLDER, 1, {1, 1, 8, 8});
  Adds<float, false>(u, u, 1.0f, MASK_PLACEHOLDER, 1, {1, 1, 8, 8});
  Div<float, false>(p, z, u, MASK_PLACEHOLDER, 1, {1, 1, 1, 8, 8, 8});
  Cast<half, float, false>(h, p, RoundMode::CAST_RINT, MASK_PLACEHOLDER, 1, {1, 1, 4, 8});
  SetMaskNorm();
  ResetMask();
  // Preserve the old routine's Vector-to-Scalar completion before caller DMA reuse.
  SetFlag<HardEvent::V_S>(EVENT_ID0);
  WaitFlag<HardEvent::V_S>(EVENT_ID0);
}

__aicore__ inline void GmgTileDenom(LocalTensor<float> z, LocalTensor<float> u, uint32_t count) {

  SetMaskCount();
  SetVectorMask<float, MaskMode::COUNTER>(count);
  Mul<float, false>(u, z, z, MASK_PLACEHOLDER, 1, {1, 1, 1, 8, 8, 8});
  Muls<float, false>(u, u, -0.07135481759315014f, MASK_PLACEHOLDER, 1, {1, 1, 8, 8});
  Adds<float, false>(u, u, -1.5957691216057308f, MASK_PLACEHOLDER, 1, {1, 1, 8, 8});
  Mul<float, false>(u, u, z, MASK_PLACEHOLDER, 1, {1, 1, 1, 8, 8, 8});
  Mins<float, false>(u, u, 80.0f, MASK_PLACEHOLDER, 1, {1, 1, 8, 8});
  Exp<float, false>(u, u, MASK_PLACEHOLDER, 1, {1, 1, 8, 8});
  Adds<float, false>(u, u, 1.0f, MASK_PLACEHOLDER, 1, {1, 1, 8, 8});
}

template <bool WHOLE_COUNT = true, bool WORD_FLAGS = true>
__aicore__ inline void GmgTileQuotientAndFlags(LocalTensor<float> z, LocalTensor<half> h, LocalTensor<float> u, LocalTensor<float> v, LocalTensor<float> p,
  LocalTensor<int32_t> a, LocalTensor<uint8_t> mask1, LocalTensor<uint8_t> mask2, uint32_t count, bool wrotePrevious) {
  SetMaskCount();
  SetVectorMask<float, MaskMode::COUNTER>(count);
  Div<float, false>(p, z, u, MASK_PLACEHOLDER, 1, {1, 1, 1, 8, 8, 8});

  if (wrotePrevious) WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
  Cast<half, float, false>(h, p, RoundMode::CAST_RINT, MASK_PLACEHOLDER, 1, {1, 1, 4, 8});
  Abs<float, false>(p, p, MASK_PLACEHOLDER, 1, {1, 1, 8, 8});

  Maxs<float, false>(v, p, 0x1p-14f, MASK_PLACEHOLDER, 1, {1, 1, 8, 8});
  Add<float, false>(u, v, p, MASK_PLACEHOLDER, 1, {1, 1, 1, 8, 8, 8});
  ShiftLeft<uint32_t, false>(a.ReinterpretCast<uint32_t>(), u.ReinterpretCast<uint32_t>(), uint32_t(19), MASK_PLACEHOLDER, 1, {1, 1, 8, 8});
  Cast<float, int32_t, false>(u, a, RoundMode::CAST_RINT, MASK_PLACEHOLDER, 1, {1, 1, 8, 8});

  SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
  Abs<float, false>(u, u, MASK_PLACEHOLDER, 1, {1, 1, 8, 8});
  SetMaskNorm();
  ResetMask();

  auto mask3 = v.ReinterpretCast<uint8_t>();
  if constexpr (WORD_FLAGS) {

    const uint32_t words = count / 32;
    if (words % 64) Duplicate(mask1.ReinterpretCast<int32_t>()[(words / 64) * 64], int32_t(0), 64);
  }
  CompareScalar(mask1, p, 2.0f, CMPMODE::GE, count);
  CompareScalar(mask2, u, 0x1p31f - 4.5f * 0x1p19f, CMPMODE::GE, count);
  GmgMaskCombine<false, WHOLE_COUNT>(mask1, mask1, mask2, count / 16);
  CompareScalar(mask2, p, 0x1p-14f, CMPMODE::LT, count);
  CompareScalar(mask3, u, 0x1p31f - 9.0f * 0x1p19f, CMPMODE::GE, count);
  GmgMaskCombine<false, WHOLE_COUNT>(mask2, mask2, mask3, count / 16);
  GmgMaskCombine<true, WHOLE_COUNT>(mask1, mask1, mask2, count / 16);
  CompareScalar(mask2, z, 8.0f, CMPMODE::LT, count);
  GmgMaskCombine<false, WHOLE_COUNT>(mask1, mask1, mask2, count / 16);
  constexpr uint32_t GROUP = WORD_FLAGS ? 32 : 16;
  const uint32_t groupCount = count / GROUP;
  if constexpr (WORD_FLAGS) {
    const uint32_t compareGroups = (groupCount + 63) / 64 * 64;

    CompareScalar(mask2, mask1.ReinterpretCast<int32_t>(), int32_t(0), CMPMODE::EQ, compareGroups);
  } else {
    const uint32_t compareGroups = (groupCount + 127) / 128 * 128;
    if (groupCount % 128) Duplicate(v.ReinterpretCast<half>(), half(0), compareGroups);
    Cast(v.ReinterpretCast<half>(), mask1.ReinterpretCast<int16_t>(), RoundMode::CAST_NONE, groupCount);
    CompareScalar(mask2, v.ReinterpretCast<half>(), half(0), CMPMODE::NE, compareGroups);
  }
  SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
  SetFlag<HardEvent::V_S>(EVENT_ID0);
}

template <bool WORD_FLAGS = true>
__aicore__ inline void GmgTileRepairAndWrite(LocalTensor<float> z, LocalTensor<half> h, LocalTensor<float> p, LocalTensor<uint8_t> mask1,
  LocalTensor<uint8_t> mask2, uint32_t count, GlobalTensor<half> dst, const DataCopyExtParams &copy) {
  WaitFlag<HardEvent::V_S>(EVENT_ID0);
  SetFlag<HardEvent::S_MTE3>(EVENT_ID0);
  WaitFlag<HardEvent::S_MTE3>(EVENT_ID0);
  WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
  DataCopyPad(dst, h, copy);
}

__aicore__ inline void GmgTiny(GM_ADDR x, GM_ADDR w, GM_ADDR scale, GM_ADDR groups, GM_ADDR y, const GmgTiling &t) {
#if defined(SPLIT_CORE_VEC) || defined(__DAV_C220_VEC__)
  constexpr uint32_t NC = 64, KC = 32, WC = NC * KC;
  TPipe pipe;
  TBuf<TPosition::VECCALC> wb, tb, ib, jb, zb, ub, vb, pb, sb, hb, mb1, mb2;
  TBuf<TPosition::VECCALC> xb, xhb, xib, xbb, gb;
  pipe.InitBuffer(wb, WC);
  pipe.InitBuffer(tb, WC * 2);
  pipe.InitBuffer(ib, WC * 4);
  pipe.InitBuffer(jb, WC * 4);
  pipe.InitBuffer(zb, NC * 4);
  pipe.InitBuffer(ub, NC * 4);
  pipe.InitBuffer(vb, NC * 4);
  pipe.InitBuffer(pb, NC * 4);
  pipe.InitBuffer(sb, NC * 4);
  pipe.InitBuffer(hb, NC * 2);
  pipe.InitBuffer(mb1, 32);
  pipe.InitBuffer(mb2, 32);
  pipe.InitBuffer(xb, 32);
  pipe.InitBuffer(xhb, 64);
  pipe.InitBuffer(xib, 128);
  pipe.InitBuffer(xbb, 1024);
  pipe.InitBuffer(gb, 128 * 8);
  auto ww = wb.Get<int8_t>();
  auto wh = tb.Get<half>();
  auto a = ib.Get<int32_t>();
  auto iw = jb.Get<int32_t>();
  auto z = zb.Get<float>();
  auto u = ub.Get<float>();
  auto v = vb.Get<float>();
  auto p = pb.Get<float>();
  auto s = sb.Get<float>();
  auto h = hb.Get<half>();
  auto mask1 = mb1.Get<uint8_t>();
  auto mask2 = mb2.Get<uint8_t>();
  auto xx = xb.Get<int8_t>();
  auto xh = xhb.Get<half>();
  auto xi = xib.Get<int32_t>();
  auto broadcast = xbb.Get<int32_t>();
  GlobalTensor<int8_t> xg, wg;
  GlobalTensor<int64_t> gg;
  GlobalTensor<float> sg;
  GlobalTensor<half> yg;
  xg.SetGlobalBuffer((__gm__ int8_t *)x);
  wg.SetGlobalBuffer((__gm__ int8_t *)w);
  gg.SetGlobalBuffer((__gm__ int64_t *)groups);
  sg.SetGlobalBuffer((__gm__ float *)scale);
  yg.SetGlobalBuffer((__gm__ half *)y);
  uint32_t paddedK = 1;
  while (paddedK < t.k) paddedK *= 2;
  Duplicate(ww.ReinterpretCast<int32_t>(), int32_t(0), paddedK * NC / 4);
  Duplicate(a, int32_t(0), paddedK * NC);
  Duplicate(s, 0.0f, NC);
  SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
  WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
  auto localGroups = gb.Get<int64_t>();
  bool cacheGroups = t.e >= 16 && t.m > 1;
  if (cacheGroups) {
    GlobalTensor<int32_t> groupWords;
    groupWords.SetGlobalBuffer((__gm__ int32_t *)groups);
    DataCopyPad(
      gb.Get<int32_t>(), groupWords, DataCopyExtParams{1, t.e * 8, 0, 0, 0}, DataCopyPadExtParams<int32_t>{true, 0, uint8_t((4 - t.e % 4) % 4 * 2), 0});
    SetFlag<HardEvent::MTE2_S>(EVENT_ID0);
    WaitFlag<HardEvent::MTE2_S>(EVENT_ID0);
  }
  uint32_t expert = 0, end = cacheGroups ? localGroups.GetValue(0) : gg.GetValue(0), loadedExpert = t.e;
  for (uint32_t row = GetBlockIdx(); row < t.m; row += t.blocks) {
    if (row >= end) {
      expert = cacheGroups ? GmgFindExpert(localGroups, row, t.e) : GmgFindExpert(gg, row, t.e);
      end = cacheGroups ? localGroups.GetValue(expert) : gg.GetValue(expert);
    }
    DataCopyPad(xx, xg[uint64_t(row) * t.k], DataCopyExtParams{1, t.k, 0, 0, 0}, DataCopyPadExtParams<int8_t>{true, 0, uint8_t(32 - t.k), 0});
    if (loadedExpert != expert) {
      DataCopyPad(ww, wg[uint64_t(expert) * t.k * t.n], DataCopyExtParams{uint16_t(t.k), t.n, 0, (NC - (t.n + 31) / 32 * 32) / 32, 0},
        DataCopyPadExtParams<int8_t>{true, 0, uint8_t((32 - t.n % 32) % 32), 0});
      DataCopyPad(s, sg[uint64_t(expert) * t.n], DataCopyExtParams{1, t.n * 4, 0, 0, 0}, DataCopyPadExtParams<float>{true, 0, 0, 0});
    }
    SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
    WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
    if (loadedExpert != expert) {
      Cast(wh, ww, RoundMode::CAST_NONE, paddedK * NC);
      Cast(iw, wh, RoundMode::CAST_RINT, paddedK * NC);
      loadedExpert = expert;
    }
    Cast(xh, xx, RoundMode::CAST_NONE, 32);
    Cast(xi, xh, RoundMode::CAST_RINT, 32);
    Brcb(broadcast, xi, 4, {1, 8});

    Mul(a, iw, broadcast, uint64_t(NC), uint8_t(paddedK), {1, 1, 0, 8, 8, 1});
    for (uint32_t halfK = paddedK / 2; halfK; halfK /= 2) Add(a, a, a[halfK * NC], halfK * NC);
    Cast(z, a, RoundMode::CAST_RINT, NC);
    Mul(z, z, s, NC);
    GmgGelu(z, h, u, v, p, a, mask1, mask2, NC);
    SetFlag<HardEvent::S_MTE3>(EVENT_ID0);
    WaitFlag<HardEvent::S_MTE3>(EVENT_ID0);
    SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
    WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
    DataCopyPad(yg[uint64_t(row) * t.n], h, DataCopyExtParams{1, t.n * 2, 0, 0, 0});
    SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
    WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
    SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
    WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
  }
#endif
}

__aicore__ inline void GmgIndex(LocalTensor<int32_t> index, uint32_t count);

template <uint32_t NC> __aicore__ inline void GmgTinyPacked(GM_ADDR x, GM_ADDR w, GM_ADDR scale, GM_ADDR groups, GM_ADDR y, const GmgTiling &t) {
#if defined(SPLIT_CORE_VEC) || defined(__DAV_C220_VEC__)
  constexpr uint32_t KC = 32, WC = NC * KC;
  TPipe pipe;
  TBuf<TPosition::VECCALC> wb, tb, ib, jb, zb, ub, vb, pb, sb, hb, mb1, mb2;
  TBuf<TPosition::VECCALC> xb, xhb, xib, xbb, wpb, offb, gb;
  pipe.InitBuffer(wb, WC);
  pipe.InitBuffer(tb, WC * 2);
  pipe.InitBuffer(ib, WC * 4);
  pipe.InitBuffer(jb, WC * 4);
  pipe.InitBuffer(wpb, WC * 2);
  pipe.InitBuffer(offb, WC * 4);
  pipe.InitBuffer(zb, 64 * 4);
  pipe.InitBuffer(ub, 64 * 4);
  pipe.InitBuffer(vb, 64 * 4);
  pipe.InitBuffer(pb, 64 * 4);
  pipe.InitBuffer(sb, 64 * 4);
  pipe.InitBuffer(hb, 64 * 2);
  pipe.InitBuffer(mb1, 32);
  pipe.InitBuffer(mb2, 32);
  pipe.InitBuffer(xb, 32);
  pipe.InitBuffer(xhb, 64);
  pipe.InitBuffer(xib, 128);
  pipe.InitBuffer(xbb, 1024);
  pipe.InitBuffer(gb, 128 * 8);
  auto ww = wb.Get<int8_t>();
  auto wh = tb.Get<half>();
  auto a = ib.Get<int32_t>();
  auto iw = jb.Get<int32_t>();
  auto padded = wpb.Get<half>();
  auto offsets = offb.Get<int32_t>();
  auto z = zb.Get<float>();
  auto u = ub.Get<float>();
  auto v = vb.Get<float>();
  auto p = pb.Get<float>();
  auto s = sb.Get<float>();
  auto h = hb.Get<half>();
  auto mask1 = mb1.Get<uint8_t>();
  auto mask2 = mb2.Get<uint8_t>();
  auto xx = xb.Get<int8_t>();
  auto xh = xhb.Get<half>();
  auto xi = xib.Get<int32_t>();
  auto broadcast = xbb.Get<int32_t>();
  GlobalTensor<int8_t> xg, wg;
  GlobalTensor<int64_t> gg;
  GlobalTensor<float> sg;
  GlobalTensor<half> yg;
  xg.SetGlobalBuffer((__gm__ int8_t *)x);
  wg.SetGlobalBuffer((__gm__ int8_t *)w);
  gg.SetGlobalBuffer((__gm__ int64_t *)groups);
  sg.SetGlobalBuffer((__gm__ float *)scale);
  yg.SetGlobalBuffer((__gm__ half *)y);
  uint32_t paddedK = 1;
  while (paddedK < t.k) paddedK *= 2;
  Duplicate(wh, half(0), WC);
  Duplicate(s, 0.0f, 64);
  if constexpr (NC == 32) Duplicate(z[32], 0.0f, 32);
  if (t.n < NC) {
    uint32_t count = paddedK * NC;
    GmgIndex(offsets, count);
    ShiftRight(a, offsets, int32_t(NC == 32 ? 5 : 6), count);
    Muls(a, a, int32_t(t.n) - int32_t(NC), count);
    Add(offsets, offsets, a, count);
    ShiftLeft(offsets, offsets, int32_t(1), count);
    GmgIndex(a, count);
    ShiftLeft(a.ReinterpretCast<uint32_t>(), a.ReinterpretCast<uint32_t>(), uint32_t(NC == 32 ? 27 : 26), count);
    ShiftRight(a.ReinterpretCast<uint32_t>(), a.ReinterpretCast<uint32_t>(), uint32_t(NC == 32 ? 27 : 26), count);
    Muls(a, a, int32_t(-1), count);
    Adds(a, a, int32_t(t.n), count);
    Mins(a, a, int32_t(1), count);
    Maxs(a, a, int32_t(0), count);

    Adds(offsets, offsets, -int32_t((WC - 16) * 2), count);
    Mul(offsets, offsets, a, count);
    Adds(offsets, offsets, int32_t((WC - 16) * 2), count);
  }
  SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
  WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
  auto localGroups = gb.Get<int64_t>();
  bool cacheGroups = t.e >= 16 && t.m > 1;
  if (cacheGroups) {
    GlobalTensor<int32_t> groupWords;
    groupWords.SetGlobalBuffer((__gm__ int32_t *)groups);
    DataCopyPad(
      gb.Get<int32_t>(), groupWords, DataCopyExtParams{1, t.e * 8, 0, 0, 0}, DataCopyPadExtParams<int32_t>{true, 0, uint8_t((4 - t.e % 4) % 4 * 2), 0});
    SetFlag<HardEvent::MTE2_S>(EVENT_ID0);
    WaitFlag<HardEvent::MTE2_S>(EVENT_ID0);
  }
  uint32_t expert = 0, end = cacheGroups ? localGroups.GetValue(0) : gg.GetValue(0), loadedExpert = t.e;
  for (uint32_t row = GetBlockIdx(); row < t.m; row += t.blocks) {
    if (row >= end) {
      expert = cacheGroups ? GmgFindExpert(localGroups, row, t.e) : GmgFindExpert(gg, row, t.e);
      end = cacheGroups ? localGroups.GetValue(expert) : gg.GetValue(expert);
    }
    DataCopyPad(xx, xg[uint64_t(row) * t.k], DataCopyExtParams{1, t.k, 0, 0, 0}, DataCopyPadExtParams<int8_t>{true, 0, uint8_t(32 - t.k), 0});
    if (loadedExpert != expert) {
      DataCopyPad(ww, wg[uint64_t(expert) * t.k * t.n], DataCopyExtParams{1, t.k * t.n, 0, 0, 0},
        DataCopyPadExtParams<int8_t>{true, 0, uint8_t((32 - (t.k * t.n) % 32) % 32), 0});
      DataCopyPad(s, sg[uint64_t(expert) * t.n], DataCopyExtParams{1, t.n * 4, 0, 0, 0}, DataCopyPadExtParams<float>{true, 0, 0, 0});
    }
    SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
    WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
    if (loadedExpert != expert) {
      Cast(wh, ww, RoundMode::CAST_NONE, (t.k * t.n + 31) / 32 * 32);
      if (t.n == NC)
        Cast(iw, wh, RoundMode::CAST_RINT, paddedK * NC);
      else {
        Gather(padded, wh, offsets.ReinterpretCast<uint32_t>(), 0, paddedK * NC);
        Cast(iw, padded, RoundMode::CAST_RINT, paddedK * NC);
      }
      loadedExpert = expert;
    }
    Cast(xh, xx, RoundMode::CAST_NONE, 32);
    Cast(xi, xh, RoundMode::CAST_RINT, 32);
    Brcb(broadcast, xi, 4, {1, 8});

    Mul(a, iw, broadcast, uint64_t(NC), uint8_t(paddedK), {1, 1, 0, NC / 8, NC / 8, 1});
    for (uint32_t halfK = paddedK / 2; halfK; halfK /= 2) Add(a, a, a[halfK * NC], halfK * NC);
    Cast(z, a, RoundMode::CAST_RINT, NC);
    Mul(z, z, s, NC);
    GmgGelu(z, h, u, v, p, a, mask1, mask2, 64);
    SetFlag<HardEvent::S_MTE3>(EVENT_ID0);
    WaitFlag<HardEvent::S_MTE3>(EVENT_ID0);
    SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
    WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
    DataCopyPad(yg[uint64_t(row) * t.n], h, DataCopyExtParams{1, t.n * 2, 0, 0, 0});
    SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
    WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
    SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
    WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
  }
#endif
}

template <uint32_t NC> __aicore__ inline void GmgShortVector(GM_ADDR x, GM_ADDR w, GM_ADDR scale, GM_ADDR groups, GM_ADDR y, const GmgTiling &t) {
#if defined(SPLIT_CORE_VEC) || defined(__DAV_C220_VEC__)
  constexpr uint32_t ROWS = 64, OUT = ROWS * NC;
  TPipe pipe;
  TBuf<TPosition::VECCALC> wb, tb, ib, jb, zb, ub, vb, pb, sb, hb, mb1, mb2;
  TBuf<TPosition::VECCALC> xb, xhb, xib, xbb;
  pipe.InitBuffer(wb, NC);
  pipe.InitBuffer(tb, NC * 2);
  pipe.InitBuffer(ib, OUT * 4);
  pipe.InitBuffer(jb, NC * 4);
  pipe.InitBuffer(zb, OUT * 4);
  pipe.InitBuffer(ub, OUT * 4);
  pipe.InitBuffer(vb, OUT * 4);
  pipe.InitBuffer(pb, OUT * 4);
  pipe.InitBuffer(sb, NC * 4);
  pipe.InitBuffer(hb, OUT * 2);
  pipe.InitBuffer(mb1, OUT / 8);
  pipe.InitBuffer(mb2, OUT / 8);
  pipe.InitBuffer(xb, ROWS);
  pipe.InitBuffer(xhb, ROWS * 2);
  pipe.InitBuffer(xib, ROWS * 4);
  pipe.InitBuffer(xbb, ROWS * 8 * 4);
  auto ww = wb.Get<int8_t>();
  auto wh = tb.Get<half>();
  auto a = ib.Get<int32_t>();
  auto iw = jb.Get<int32_t>();
  auto z = zb.Get<float>();
  auto u = ub.Get<float>();
  auto v = vb.Get<float>();
  auto p = pb.Get<float>();
  auto s = sb.Get<float>();
  auto h = hb.Get<half>();
  auto mask1 = mb1.Get<uint8_t>();
  auto mask2 = mb2.Get<uint8_t>();
  auto xx = xb.Get<int8_t>();
  auto xh = xhb.Get<half>();
  auto xi = xib.Get<int32_t>();
  auto broadcast = xbb.Get<int32_t>();
  GlobalTensor<int8_t> xg, wg;
  GlobalTensor<int64_t> gg;
  GlobalTensor<float> sg;
  GlobalTensor<half> yg;
  xg.SetGlobalBuffer((__gm__ int8_t *)x);
  wg.SetGlobalBuffer((__gm__ int8_t *)w);
  gg.SetGlobalBuffer((__gm__ int64_t *)groups);
  sg.SetGlobalBuffer((__gm__ float *)scale);
  yg.SetGlobalBuffer((__gm__ half *)y);
  Duplicate(ww.ReinterpretCast<int32_t>(), int32_t(0), NC / 4);
  Duplicate(s, 0.0f, NC);
  SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
  WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
  uint32_t row = t.m * GetBlockIdx() / t.blocks, last = t.m * (GetBlockIdx() + 1) / t.blocks;
  uint32_t expert = GmgFindExpert(gg, row, t.e), end = gg.GetValue(expert), loadedExpert = t.e;
  while (row < last) {
    if (row >= end) {
      expert = GmgFindExpert(gg, row, t.e);
      end = gg.GetValue(expert);
    }
    uint32_t rows = end - row;
    if (rows > last - row) rows = last - row;
    if (rows > ROWS) rows = ROWS;
    DataCopyPad(xx, xg[row], DataCopyExtParams{1, rows, 0, 0, 0}, DataCopyPadExtParams<int8_t>{true, 0, uint8_t((32 - rows % 32) % 32), 0});
    if (loadedExpert != expert) {
      DataCopyPad(ww, wg[uint64_t(expert) * t.n], DataCopyExtParams{1, t.n, 0, 0, 0}, DataCopyPadExtParams<int8_t>{true, 0, uint8_t((32 - t.n % 32) % 32), 0});
      DataCopyPad(s, sg[uint64_t(expert) * t.n], DataCopyExtParams{1, t.n * 4, 0, 0, 0}, DataCopyPadExtParams<float>{true, 0, 0, 0});
    }
    SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
    WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
    if (loadedExpert != expert) {
      Cast(wh, ww, RoundMode::CAST_NONE, NC);
      Cast(iw, wh, RoundMode::CAST_RINT, NC);
      loadedExpert = expert;
    }
    uint32_t count = rows * NC, copied = (rows + 31) / 32 * 32;
    Cast(xh, xx, RoundMode::CAST_NONE, copied);
    Cast(xi, xh, RoundMode::CAST_RINT, copied);
    Brcb(broadcast, xi, uint8_t((rows + 7) / 8), {1, 8});
    Mul(a, iw, broadcast, uint64_t(NC), uint8_t(rows), {1, 1, 0, NC / 8, 0, 1});
    Cast(z, a, RoundMode::CAST_RINT, count);
    Mul(z, z, s, uint64_t(NC), uint8_t(rows), {1, 1, 1, NC / 8, NC / 8, 0});

    uint32_t geluCount = (count + 63) / 64 * 64;
    if constexpr (NC == 32)
      if (rows % 2) Duplicate(z[count], 0.0f, NC);
    GmgGelu(z, h, u, v, p, a, mask1, mask2, geluCount);
    SetFlag<HardEvent::S_MTE3>(EVENT_ID0);
    WaitFlag<HardEvent::S_MTE3>(EVENT_ID0);
    SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
    WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
    DataCopyPad(yg[uint64_t(row) * t.n], h, DataCopyExtParams{uint16_t(rows), t.n * 2, (NC - (t.n + 15) / 16 * 16) / 16, 0, 0});
    SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
    WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
    SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
    WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
    row += rows;
  }
#endif
}

template <uint32_t OUT = 64> __aicore__ inline void GmgGemv(GM_ADDR x, GM_ADDR w, GM_ADDR scale, GM_ADDR groups, GM_ADDR y, const GmgTiling &t) {
#if defined(SPLIT_CORE_VEC) || defined(__DAV_C220_VEC__)
  uint32_t vid = GetBlockIdx();
  uint32_t first = t.m * vid / t.blocks, last = t.m * (vid + 1) / t.blocks;
  if (first == last) return;
  TPipe pipe;
  constexpr uint32_t KMAX = 8192;
  TBuf<TPosition::VECCALC> xb, wb, tb, ib, jb, ab, zb, ub, vb, pb, sb, hb, mb1, mb2;
  pipe.InitBuffer(xb, KMAX);
  pipe.InitBuffer(wb, KMAX);
  pipe.InitBuffer(tb, KMAX * 2);
  pipe.InitBuffer(ib, KMAX * 4);
  pipe.InitBuffer(jb, KMAX * 4);
  pipe.InitBuffer(ab, OUT * 4);
  pipe.InitBuffer(zb, OUT * 4);
  pipe.InitBuffer(ub, OUT * 4);
  pipe.InitBuffer(vb, OUT * 4);
  pipe.InitBuffer(pb, OUT * 4);
  pipe.InitBuffer(sb, OUT * 4);
  pipe.InitBuffer(hb, OUT * 2);
  pipe.InitBuffer(mb1, 32);
  pipe.InitBuffer(mb2, 32);
  auto xx = xb.Get<int8_t>();
  auto ww = wb.Get<int8_t>();
  auto tmp = tb.Get<half>();
  auto ix = ib.Get<int32_t>();
  auto iw = jb.Get<int32_t>();
  auto a = ab.Get<int32_t>();
  auto z = zb.Get<float>();
  auto u = ub.Get<float>();
  auto v = vb.Get<float>();
  auto p = pb.Get<float>();
  auto s = sb.Get<float>();
  auto h = hb.Get<half>();
  auto mask1 = mb1.Get<uint8_t>();
  auto mask2 = mb2.Get<uint8_t>();
  GlobalTensor<int8_t> xg, wg;
  GlobalTensor<int64_t> gg;
  GlobalTensor<float> sg;
  GlobalTensor<half> yg;
  xg.SetGlobalBuffer((__gm__ int8_t *)x);
  wg.SetGlobalBuffer((__gm__ int8_t *)w);
  gg.SetGlobalBuffer((__gm__ int64_t *)groups);
  sg.SetGlobalBuffer((__gm__ float *)scale);
  yg.SetGlobalBuffer((__gm__ half *)y);
  uint32_t paddedK = 64;
  while (paddedK < t.k) paddedK *= 2;
  uint8_t rightPad = uint8_t((32 - t.k % 32) % 32);
  Duplicate(xx.ReinterpretCast<int32_t>(), int32_t(0), paddedK / 4);
  Duplicate(ww.ReinterpretCast<int32_t>(), int32_t(0), paddedK / 4);
  SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
  WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
  uint32_t expert = 0, end = gg.GetValue(0), loadedExpert = t.e;
  if (first >= end) {
    expert = GmgFindExpert(gg, first, t.e);
    end = gg.GetValue(expert);
  }
  for (uint32_t base = first; base < last;) {
    uint32_t count = last - base < OUT ? last - base : OUT;
    while (base >= end) {
      ++expert;
      end = gg.GetValue(expert);
    }
    Duplicate(a, int32_t(0), OUT);
    Duplicate(s, 0.0f, OUT);
    if (t.k == 1) {

      if (count > end - base) count = end - base;
      Duplicate(xx.ReinterpretCast<int32_t>(), int32_t(0), OUT / 4);
      Duplicate(iw, int32_t(wg.GetValue(expert)), OUT);
      Duplicate(s, sg.GetValue(expert), OUT);
      SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
      WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
      DataCopyPad(xx, xg[base], DataCopyExtParams{1, count, 0, 0, 0}, DataCopyPadExtParams<int8_t>{true, 0, uint8_t((32 - count % 32) % 32), 0});
      SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
      WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
      Cast(tmp, xx, RoundMode::CAST_NONE, OUT);
      Cast(a, tmp, RoundMode::CAST_RINT, OUT);
      Mul(a, a, iw, OUT);
    } else
      for (uint32_t row = 0; row < count; ++row) {
        uint32_t globalRow = base + row;
        while (globalRow >= end) {
          ++expert;
          end = gg.GetValue(expert);
        }
        bool newWeight = loadedExpert != expert;
        if (newWeight) DataCopyPad(ww, wg[uint64_t(expert) * t.k], DataCopyExtParams{1, t.k, 0, 0, 0}, DataCopyPadExtParams<int8_t>{true, 0, rightPad, 0});
        DataCopyPad(xx, xg[uint64_t(globalRow) * t.k], DataCopyExtParams{1, t.k, 0, 0, 0}, DataCopyPadExtParams<int8_t>{true, 0, rightPad, 0});
        SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
        WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
        if (newWeight) {
          Cast(tmp, ww, RoundMode::CAST_NONE, paddedK);
          Cast(iw, tmp, RoundMode::CAST_RINT, paddedK);
          loadedExpert = expert;
        }
        Cast(tmp, xx, RoundMode::CAST_NONE, paddedK);
        Cast(ix, tmp, RoundMode::CAST_RINT, paddedK);
        Mul(ix, ix, iw, paddedK);
        for (uint32_t halfK = paddedK / 2; halfK >= 8; halfK /= 2) Add(ix, ix, ix[halfK], halfK);
        SetFlag<HardEvent::V_S>(EVENT_ID0);
        WaitFlag<HardEvent::V_S>(EVENT_ID0);
        int32_t sum = 0;
        for (uint32_t i = 0; i < 8; ++i) sum += ix.GetValue(i);
        a.SetValue(row, sum);
        s.SetValue(row, sg.GetValue(expert));
        SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
        WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
      }
    SetFlag<HardEvent::S_V>(EVENT_ID0);
    WaitFlag<HardEvent::S_V>(EVENT_ID0);
    Cast(z, a, RoundMode::CAST_RINT, OUT);
    Mul(z, z, s, OUT);
    GmgGelu(z, h, u, v, p, a, mask1, mask2, OUT);
    SetFlag<HardEvent::S_MTE3>(EVENT_ID0);
    WaitFlag<HardEvent::S_MTE3>(EVENT_ID0);
    SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
    WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
    DataCopyPad(yg[base], h, DataCopyExtParams{1, count * 2, 0, 0, 0});
    SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
    WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
    base += count;
  }
#endif
}

__aicore__ inline void GmgPrepareL1(TPipe &pipe, const GmgTiling &t) {
#if defined(SPLIT_CORE_CUBE)
  if (t.e == 1 && t.m % 16 == 0 && t.k % 32 == 0 && t.n % 32 == 0) return;

  uint32_t bytes = (t.cube.shareL1Size + 31) / 32 * 32;
  LocalTensor<uint32_t> init(TPosition::A1, 0, bytes / sizeof(uint32_t));
  InitConstValue(init, InitConstValueParams<uint32_t>{1, uint16_t(bytes / 32), 0, 0});
  PipeBarrier<PIPE_ALL>();
#endif
}

template <bool MDL> constexpr MatmulConfig GmgMatmulConfig() {
  MatmulConfig config = MDL ? CFG_MDL : CFG_NORM;

  config.enableSetBias = false;
  config.enableQuantVector = false;
  config.enableSetDefineData = false;
  return config;
}
template <bool MDL> constexpr MatmulConfig GMG_MATMUL_CONFIG = GmgMatmulConfig<MDL>();

__aicore__ inline void GmgIndex(LocalTensor<int32_t> index, uint32_t count) {
  for (uint32_t i = 0; i < 8; ++i) index.SetValue(i, int32_t(i));
  SetFlag<HardEvent::S_V>(EVENT_ID0);
  WaitFlag<HardEvent::S_V>(EVENT_ID0);
  for (uint32_t length = 8; length < count; length *= 2) {
    Adds(index[length], index, int32_t(length), length);
    PipeBarrier<PIPE_V>();
  }
}

struct GmgNoWeightPacker {};

class GmgWordWeightPacker {
public:
  __aicore__ inline void Init(GM_ADDR w, GM_ADDR padded, const GmgTiling &t, TPipe &pipe) {
#if defined(SPLIT_CORE_VEC)
    pipe.InitBuffer(ib, CAP);
    pipe.InitBuffer(ob, CAP);
    pipe.InitBuffer(tb, CAP);
    pipe.InitBuffer(xb, CAP);
    pipe.InitBuffer(mb, 32);
    n_ = t.n;
    k_ = t.k;
    pn_ = (t.n + 31) / 32 * 32;
    auto offsets = xb.Get<int32_t>();
    auto row = tb.Get<int32_t>();
    one_ = n_ % 4 == 1 ? 0x0000ff000000ff00ULL : (n_ % 4 == 3 ? 0xff000000ff000000ULL : 0);
    two_ = n_ % 2 ? 0x00ff000000ff0000ULL : (n_ % 4 ? 0xff00ff00ff00ff00ULL : 0);
    three_ = n_ % 4 == 1 ? 0xff000000ff000000ULL : (n_ % 4 == 3 ? 0x0000ff000000ff00ULL : 0);
    uint32_t count = KR * pn_ / 4;
    GmgIndex(offsets, count);
    ShiftRight(row, offsets, int32_t(3), count);
    Muls(row, row, int32_t(n_) - 32, count);
    ShiftLeft(offsets, offsets, int32_t(2), count);
    Add(offsets, offsets, row, count);
    for (uint32_t block = 1; block < pn_ / 32; ++block)
      Adds(offsets[block * KR * 8], offsets[block * KR * 8], int32_t(block) * (32 - int32_t(KR * n_)), KR * 8);
    ShiftRight(offsets.ReinterpretCast<uint32_t>(), offsets.ReinterpretCast<uint32_t>(), uint32_t(2), count);
    ShiftLeft(offsets.ReinterpretCast<uint32_t>(), offsets.ReinterpretCast<uint32_t>(), uint32_t(2), count);
    auto valid = mb.Get<uint16_t>();
    for (uint32_t i = 0; i < 16; ++i) {
      uint32_t remaining = n_ % 32;
      valid.SetValue(i, uint16_t(2 * i + 1 < remaining ? 0xffff : (2 * i < remaining ? 0xff : 0)));
    }
    SetFlag<HardEvent::S_V>(EVENT_ID0);
    WaitFlag<HardEvent::S_V>(EVENT_ID0);

    Duplicate(ib.Get<int32_t>()[KR * n_ / 4], int32_t(0), 8);
    Duplicate(tb.Get<int32_t>(), int32_t(0), count);
    wg.SetGlobalBuffer((__gm__ int8_t *)w);
    pg.SetGlobalBuffer((__gm__ int8_t *)padded);
#endif
  }
  template <bool PER_BAND = false> __aicore__ inline void Pack(uint32_t e, uint32_t start, uint32_t length, bool stream = false) {
#if defined(SPLIT_CORE_VEC)
    auto source = ib.Get<int8_t>();
    auto output = ob.Get<int8_t>();
    auto tmp = tb.Get<uint32_t>();
    auto offsets = xb.Get<uint32_t>();
    uint32_t count = KR * pn_ / 4, kpad = (length + 511) / 512 * 512;
    for (uint32_t first = GetSubBlockIdx() * KR; first < kpad; first += 2 * KR) {
      uint32_t rows = first < length ? (length - first < KR ? length - first : KR) : 0;
      if (rows && rows < KR) Duplicate(source.ReinterpretCast<int32_t>(), int32_t(0), KR * pn_ / 4);
      SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
      WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
      if (rows) {
        uint32_t bytes = rows * n_;
        DataCopyPad(source, wg[(uint64_t(e) * k_ + start + first) * n_], DataCopyExtParams{1, bytes, 0, 0, 0},
          DataCopyPadExtParams<int8_t>{true, 0, uint8_t((32 - bytes % 32) % 32), 0});
        SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
        WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
      }
      auto dst = output.ReinterpretCast<uint32_t>();
      auto src = source.ReinterpretCast<uint32_t>();
      if (rows == 0)
        Duplicate(dst, uint32_t(0), count);
      else if (rows < 64) {
        Duplicate(dst, uint32_t(0), count);
        uint32_t activeWords = ((rows + 7) / 8 * 8) * 8;
        for (uint32_t block = 0; block < pn_ / 32; ++block) {
          uint32_t offset = block * KR * 8;
          Permute(dst[offset], src, offsets[offset], tmp[offset], activeWords);
        }
      } else
        Permute(dst, src, offsets, tmp, count);
      uint32_t last = (pn_ / 32 - 1) * KR * 16;
      And(dst.ReinterpretCast<uint16_t>()[last], dst.ReinterpretCast<uint16_t>()[last], mb.Get<uint16_t>(), uint64_t(128), uint8_t(KR / 8),
        BinaryRepeatParams{1, 1, 0, 8, 8, 0});
      SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
      WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
      uint64_t address = uint64_t(first / 512) * 512 * pn_ + (first % 512) * 32;
      DataCopy(pg[address], output, DataCopyParams{uint16_t(pn_ / 32), KR, 0, 512 - KR});
      if constexpr (PER_BAND) {
        if (stream) {
          // The Cube returns one credit after consuming both lanes' preceding ready.
          if (first >= 512) CrossCoreWaitFlag<2>(5);
          CrossCoreSetFlag<2, PIPE_MTE3>(4);
        }
      }
      SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
      WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
    }
    if (!PER_BAND || !stream) CrossCoreSetFlag<2, PIPE_MTE3>(4);
#endif
#if defined(SPLIT_CORE_CUBE)
    if (!PER_BAND || !stream) CrossCoreWaitFlag<2>(4);
#endif
  }

private:
  __aicore__ inline void ShiftWords(LocalTensor<uint32_t> dst, LocalTensor<uint32_t> tmp, uint64_t bits, uint32_t shift, uint8_t repeats) {
#if defined(SPLIT_CORE_VEC)
    if (!bits) return;
    uint64_t mask[2] = {bits, 0};
    ShiftRight(dst, dst, shift, mask, repeats, UnaryRepeatParams{1, 1, 8, 8}, false);
    ShiftLeft(tmp, tmp, uint32_t(32 - shift), mask, repeats, UnaryRepeatParams{1, 1, 8, 8});
#endif
  }
  __aicore__ inline void Permute(
    LocalTensor<uint32_t> dst, LocalTensor<uint32_t> src, LocalTensor<uint32_t> offsets, LocalTensor<uint32_t> tmp, uint32_t count) {
#if defined(SPLIT_CORE_VEC)
    Gather(dst, src, offsets, 0, count);
    if (n_ % 4) {
      uint8_t repeats = count / 64;
      uint64_t shiftedRows[2] = {one_ | two_ | three_, 0};
      SetMaskNorm();
      Gather(tmp, src, offsets, 4, shiftedRows, repeats, uint16_t(8));
      ShiftWords(dst, tmp, one_, 8, repeats);
      ShiftWords(dst, tmp, two_, 16, repeats);
      ShiftWords(dst, tmp, three_, 24, repeats);
      Or(dst.ReinterpretCast<uint16_t>(), dst.ReinterpretCast<uint16_t>(), tmp.ReinterpretCast<uint16_t>(), uint64_t(128), repeats,
        BinaryRepeatParams{1, 1, 1, 8, 8, 8});
      ResetMask();
    }
#endif
  }
  static constexpr uint32_t KR = 256, CAP = KR * 128;
  TBuf<TPosition::VECCALC> ib, ob, tb, xb, mb;
  GlobalTensor<int8_t> wg, pg;
  uint32_t n_ = 0, k_ = 0, pn_ = 0;
  uint64_t one_ = 0, two_ = 0, three_ = 0;
};

template <bool MDL, bool PADDED = false>
__aicore__ inline void GmgSplitK(GM_ADDR x, GM_ADDR w, GM_ADDR scale, GM_ADDR groups, GM_ADDR y, GM_ADDR workspace, const GmgTiling &t) {
  constexpr uint32_t SM = 32, SN = 64, SE = SM * SN, SV = SE / 2;
  TPipe pipe;
  const uint32_t core = GetBlockIdx() / GetTaskRation();
  typename Conditional<PADDED, GmgWordWeightPacker, GmgNoWeightPacker>::type packer;
  if constexpr (PADDED) {
    auto padded = workspace + uint64_t(t.blocks) * SM * SN * 4 + uint64_t(core) * ((t.k + 511) / 512 * 512) * ((t.n + 31) / 32 * 32);
    packer.Init(w, padded, t, pipe);
    w = padded;
  }
  const uint32_t parts = t.reserved, logical = core / parts, part = core % parts;
  constexpr uint32_t KALIGN = 512;
  const uint32_t kBlocks = (t.k + KALIGN - 1) / KALIGN;
  const uint32_t kOffset = (kBlocks * part / parts) * KALIGN;
  const uint32_t kEndAligned = (kBlocks * (part + 1) / parts) * KALIGN;
  const uint32_t innerK = (kEndAligned < t.k ? kEndAligned : t.k) - kOffset;
  GlobalTensor<int8_t> xg, wg;
  GlobalTensor<int64_t> gg;
  GlobalTensor<float> sg;
  GlobalTensor<half> yg;
  GlobalTensor<int32_t> cg;
  xg.SetGlobalBuffer((__gm__ int8_t *)x);
  wg.SetGlobalBuffer((__gm__ int8_t *)w);
  gg.SetGlobalBuffer((__gm__ int64_t *)groups);
  sg.SetGlobalBuffer((__gm__ float *)scale);
  yg.SetGlobalBuffer((__gm__ half *)y);
  cg.SetGlobalBuffer((__gm__ int32_t *)workspace);
  uint32_t prev = 0, taskBase = 0, expert = 0, mr = 0, nc = 0, rows = 0, cols = 0;

  constexpr uint32_t nt = 1;
  bool active = false;
  for (uint32_t e = GmgFirstExpert(gg, t.e); e < t.e; ++e) {
    uint32_t end = gg.GetValue(e), len = end - prev;
    uint32_t tasks = (len + SM - 1) / SM * nt;
    if (logical < taskBase + tasks) {
      uint32_t local = logical - taskBase;
      mr = local / nt * SM;
      nc = local % nt * SN;
      rows = len - mr < SM ? len - mr : SM;
      cols = t.n - nc < SN ? t.n - nc : SN;
      expert = e;
      active = true;
      break;
    }
    taskBase += tasks;
    prev = end;
  }
  if constexpr (PADDED)
    if (active) packer.Pack(expert, kOffset, innerK);
#if defined(SPLIT_CORE_CUBE)
  using CubeOp = GmgNarrowCube<PADDED>;
  CubeOp mm;
  mm.Init(&t.cube, &pipe);
  mm.SetOrgShape(SM, PADDED ? (t.n + 31) / 32 * 32 : t.n, t.k, t.k, SN);
  CrossCoreWaitFlag<2>(2);
  if (active) {
    mm.SetSingleShape(rows, cols, innerK);
    mm.SetTensorA(xg[uint64_t(prev + mr) * t.k + kOffset]);
    mm.SetTensorB(wg[PADDED ? 0 : (uint64_t(expert) * t.k + kOffset) * t.n + nc]);
    mm.IterateAll(cg[core * SE]);
    mm.End();
  }
  CrossCoreSetFlag<0, PIPE_FIX>(6);
  CrossCoreWaitFlag<0>(6);
  CrossCoreSetFlag<2, PIPE_FIX>(0);
#endif
#if defined(SPLIT_CORE_VEC)
  TBuf<TPosition::VECCALC> ab, zb, ub, vb, pb, sb, hb, mb1, mb2;
  pipe.InitBuffer(ab, parts * SV * 4 + 256);
  pipe.InitBuffer(zb, SV * 4 + 256);
  pipe.InitBuffer(ub, SV * 4 + 256);
  pipe.InitBuffer(vb, SV * 4 + 256);
  pipe.InitBuffer(pb, SV * 4 + 256);
  pipe.InitBuffer(sb, SN * 4 + 256);
  pipe.InitBuffer(hb, SV * 2 + 256);
  pipe.InitBuffer(mb1, SV / 8 + 256);
  pipe.InitBuffer(mb2, SV / 8 + 256);
  auto a = ab.Get<int32_t>();
  auto z = zb.Get<float>();
  auto u = ub.Get<float>();
  auto v = vb.Get<float>();
  auto p = pb.Get<float>();
  auto s = sb.Get<float>();
  auto h = hb.Get<half>();
  auto mask1 = mb1.Get<uint8_t>();
  auto mask2 = mb2.Get<uint8_t>();
  Duplicate(a, int32_t(0), part == 0 ? parts * SV : SV);
  SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
  WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);

  if (part == 0) DataCopy(cg[logical * parts * SE + GetSubBlockIdx() * SV], a, DataCopyParams{uint16_t(parts), uint16_t(SV / 8), 0, uint16_t(SV / 8)});
  CrossCoreSetFlag<0, PIPE_MTE3>(7);
  CrossCoreWaitFlag<0>(7);
  CrossCoreSetFlag<2, PIPE_MTE3>(2);
  uint32_t vectorRows = (rows + 1) / 2, rowOffset = GetSubBlockIdx() * vectorRows;
  rows = rows > rowOffset ? (rows - rowOffset < vectorRows ? rows - rowOffset : vectorRows) : 0;
  mr += rowOffset;
  if (active && part == 0 && rows) {
    Duplicate(s, 0.0f, SN);
    SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
    WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
    DataCopyPad(s, sg[uint64_t(expert) * t.n + nc], DataCopyExtParams{1, cols * 4, 0, 0, 0}, DataCopyPadExtParams<float>{true, 0, 0, 0});
  }
  CrossCoreWaitFlag<2>(0);
  if (active && part == 0 && rows) {

    uint32_t offset = logical * parts * SE + rowOffset * SN;
    DataCopy(a, cg[offset], DataCopyParams{uint16_t(parts), uint16_t(rows * SN / 8), uint16_t((SE - rows * SN) / 8), uint16_t((SV - rows * SN) / 8)});
    SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
    WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
    for (uint32_t kPart = 1; kPart < parts; ++kPart) Add(a, a, a[kPart * SV], rows * SN);
    Cast(z, a, RoundMode::CAST_RINT, rows * SN);
    Mul(z, z, s, uint64_t(SN), uint8_t(rows), BinaryRepeatParams{1, 1, 1, SN / 8, SN / 8, 0});
    GmgGelu(z, h, u, v, p, a, mask1, mask2, rows * SN);
    SetFlag<HardEvent::S_MTE3>(EVENT_ID0);
    WaitFlag<HardEvent::S_MTE3>(EVENT_ID0);
    SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
    WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
    DataCopyPad(yg[uint64_t(prev + mr) * t.n + nc], h, DataCopyExtParams{uint16_t(rows), cols * 2, (SN - ((cols + 15) / 16 * 16)) / 16, (t.n - cols) * 2, 0});
  }

#endif
}

template <uint32_t BM, uint32_t BN, bool MDL = false, bool REUSE = false, bool DIRECT = false, bool PADDED = false, bool GENERAL = false, bool STREAM = false,
  uint32_t DIRECT_MAX_K = 2048, bool FORCE_DOUBLE = false>
__aicore__ inline void GmgCompute(GM_ADDR x, GM_ADDR w, GM_ADDR scale, GM_ADDR groups, GM_ADDR y, GM_ADDR workspace, const GmgTiling &t) {
  constexpr uint32_t ELEMS = BM * BN, VR = 2, VELEMS = (BM > 64 ? 64 : BM) * BN / VR;
  constexpr bool DOUBLE_C = (BM == 128 || FORCE_DOUBLE);
  static_assert(
    !FORCE_DOUBLE || (BM == 64 && BN == 256 && DIRECT && !GENERAL && !REUSE && !PADDED && !STREAM), "extra C bank is restricted to direct M64/N256");
  TPipe pipe;
  const uint32_t core = GetBlockIdx() / GetTaskRation();
  typename Conditional<PADDED, GmgWordWeightPacker, GmgNoWeightPacker>::type packer;
  if constexpr (PADDED) {
    auto padded = workspace + uint64_t(t.blocks) * t.bm * t.bn * 4 + uint64_t(core) * ((t.k + 511) / 512 * 512) * ((t.n + 31) / 32 * 32);
    packer.Init(w, padded, t, pipe);
    w = padded;
  }
  GlobalTensor<int8_t> xg, wg;
  GlobalTensor<int64_t> gg;
  GlobalTensor<float> sg;
  GlobalTensor<half> yg;
  GlobalTensor<int32_t> cg;
  xg.SetGlobalBuffer((__gm__ int8_t *)x);
  wg.SetGlobalBuffer((__gm__ int8_t *)w);
  gg.SetGlobalBuffer((__gm__ int64_t *)groups);
  sg.SetGlobalBuffer((__gm__ float *)scale);
  yg.SetGlobalBuffer((__gm__ half *)y);
  cg.SetGlobalBuffer((__gm__ int32_t *)workspace + core * ELEMS * ((DOUBLE_C || (REUSE && GENERAL)) ? 2 : 1));

#if defined(SPLIT_CORE_CUBE)
  if constexpr (!DIRECT && !STREAM) GmgPrepareL1(pipe, t);
  using DirectNarrow = typename Conditional<(BM == 64 && BN == 128 && DIRECT_MAX_K == 6144 && !PADDED), GmgNarrowCube<false, 128, 64, 6144, 512>,
    typename Conditional<(BM == 32 && BN == 128 && DIRECT_MAX_K == 8192 && !PADDED), GmgNarrowCube<false, 128, 32, 8192, 1024>,
      GmgNarrowCube<PADDED, BN>>::type>::type;
  using StandardCube = typename Conditional<DIRECT,
    typename Conditional<(BN <= 128), DirectNarrow, typename Conditional<GENERAL, GmgNarrowCube<false, 256, BM, DIRECT_MAX_K>, GmgDirectCube>::type>::type,
    Matmul<MatmulType<TPosition::GM, CubeFormat::ND, int8_t>, MatmulType<TPosition::GM, CubeFormat::ND, int8_t>,
      MatmulType<TPosition::GM, CubeFormat::ND, int32_t>, MatmulType<TPosition::GM, CubeFormat::ND, int32_t>, GMG_MATMUL_CONFIG<MDL>>>::type;
  using CubeOp = typename Conditional<STREAM, typename Conditional<(BM == 128 && BN == 256), GmgInitializedStreamTallCube, GmgStreamCube<BN, BM>>::type,
    typename Conditional<(BM == 128 && !GENERAL), GmgTallCube, typename Conditional<REUSE && GENERAL, GmgPaddedReuseCube, StandardCube>::type>::type>::type;
  CubeOp mm;
  mm.Init(&t.cube, &pipe);
  mm.SetOrgShape(REUSE ? t.m : BM, PADDED ? (t.n + 31) / 32 * 32 : t.n, t.k, t.k, BN);
  if constexpr (!(STREAM && BM == 128 && BN == 256)) CrossCoreWaitFlag<2>(2);
#endif

#if defined(SPLIT_CORE_VEC)
  TBuf<TPosition::VECCALC> ab, zb, ub, vb, pb, sb, hb, maskb1, maskb2, groupBuffer;
  pipe.InitBuffer(ab, (VELEMS * 4) + 256);
  pipe.InitBuffer(zb, (VELEMS * 4) + 256);
  pipe.InitBuffer(ub, (VELEMS * 4) + 256);
  pipe.InitBuffer(vb, (VELEMS * 4) + 256);
  pipe.InitBuffer(pb, (VELEMS * 4) + 256);
  pipe.InitBuffer(sb, (BN * 4) + 256);
  pipe.InitBuffer(hb, (VELEMS * 2) + 256);
  pipe.InitBuffer(maskb1, (VELEMS / 8) + 256);
  pipe.InitBuffer(maskb2, (VELEMS / 8) + 256);
  auto a = ab.Get<int32_t>();
  auto z = zb.Get<float>();
  auto u = ub.Get<float>();
  auto v = vb.Get<float>();
  auto p = pb.Get<float>();
  auto s = sb.Get<float>();
  auto h = hb.Get<half>();
  auto mask1 = maskb1.Get<uint8_t>();
  auto mask2 = maskb2.Get<uint8_t>();

  LocalTensor<int64_t> localGroups;
  bool useLocalGroups = false;
  if constexpr ((DIRECT && BN == 256 && !GENERAL) || (REUSE && GENERAL)) {
    pipe.InitBuffer(groupBuffer, 128 * 8);
    localGroups = groupBuffer.Get<int64_t>();
    useLocalGroups = t.e >= 16;
    if (useLocalGroups) {
      GlobalTensor<int32_t> groupWords;
      groupWords.SetGlobalBuffer((__gm__ int32_t *)groups);
      DataCopyPad(groupBuffer.Get<int32_t>(), groupWords, DataCopyExtParams{1, t.e * 8, 0, 0, 0},
        DataCopyPadExtParams<int32_t>{true, 0, uint8_t((4 - t.e % 4) % 4 * 2), 0});
      SetFlag<HardEvent::MTE2_S>(EVENT_ID0);
      WaitFlag<HardEvent::MTE2_S>(EVENT_ID0);
    }
  }

  if constexpr ((REUSE && GENERAL && DIRECT && BM == 64 && BN == 256 && !STREAM && !PADDED) || (STREAM && BM == 128 && BN == 256)) {
    // Define both banks before either actor consumes a C rectangle,
    // including padding that can be read for a ragged tile.
    Duplicate(a, int32_t(0), VELEMS);
    SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
    WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
    for (uint32_t bank = 0; bank < 2; ++bank)
      for (uint32_t offset = 0; offset < ELEMS / 2; offset += VELEMS) DataCopy(cg[bank * ELEMS + GetSubBlockIdx() * (ELEMS / 2) + offset], a, VELEMS);
    SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
    WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
  }
  if constexpr (!DIRECT && !STREAM && BM == 32 && BN == 128) {
    Duplicate(a, int32_t(0), VELEMS);
    SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
    WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
    DataCopy(cg[GetSubBlockIdx() * VELEMS], a, VELEMS);
    SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
    WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
  }
  CrossCoreSetFlag<2, PIPE_MTE3>(2);
  if (t.n % BN) {
    Duplicate(s, 0.0f, BN);
    SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
    WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
  }
#endif
  uint32_t taskBase = 0, prev = 0, done = 0, nextTask = core, packedExpert = t.e;

  const uint32_t nt = BN == 64 ? 1 : (t.n + BN - 1) / BN;
  const bool streamPack = PADDED && t.k > 512;
#if defined(SPLIT_CORE_VEC)
  uint32_t firstExpert = useLocalGroups ? GmgFirstExpert(localGroups, t.e) : GmgFirstExpert(gg, t.e);
#else
  uint32_t firstExpert = GmgFirstExpert(gg, t.e);
#endif
  uint32_t stopTask = 0xffffffffU, runRemaining = 0;
  if constexpr (REUSE) {
    uint32_t total = 0, before = 0;
    for (uint32_t e = firstExpert; e < t.e; ++e) {
      uint32_t end =
#if defined(SPLIT_CORE_VEC)
        useLocalGroups ? localGroups.GetValue(e) : gg.GetValue(e);
#else
        gg.GetValue(e);
#endif
      total += (end - before + BM - 1) / BM * nt;
      before = end;
      if (end == t.m) break;
    }
    nextTask = total * core / t.blocks;
    stopTask = total * (core + 1) / t.blocks;
  }
  for (uint32_t e = firstExpert; e < t.e; ++e) {
    uint32_t end =
#if defined(SPLIT_CORE_VEC)
      useLocalGroups ? localGroups.GetValue(e) : gg.GetValue(e);
#else
      gg.GetValue(e);
#endif
    uint32_t len = end - prev, mt = (len + BM - 1) / BM;
    uint32_t tasks = mt * nt;

    for (; nextTask < taskBase + tasks && nextTask < stopTask; nextTask += (REUSE ? 1 : t.blocks)) {
      uint32_t local = nextTask - taskBase;
      uint32_t mr = (BN == 64 ? local : (REUSE ? local % mt : local / nt)) * BM;
      uint32_t nc = BN == 64 ? 0 : (REUSE ? local / mt : local % nt) * BN;
      uint32_t rows = (len - mr < BM ? len - mr : BM), cols = (t.n - nc < BN ? t.n - nc : BN);
      const bool newPack = PADDED && packedExpert != e;
      if constexpr (PADDED)
        if (newPack) {
          packer.template Pack<true>(e, 0, t.k, streamPack);
          packedExpert = e;
        }
#if defined(SPLIT_CORE_CUBE)
      if constexpr (DOUBLE_C) {
        if (done >= 2) {
          if (done & 1)
            CrossCoreWaitFlag<2>(4);
          else
            CrossCoreWaitFlag<2>(1);
        }
      } else if (done)
        CrossCoreWaitFlag<2>(1);
      if constexpr (REUSE) {

        if (!runRemaining) {
          runRemaining = mt - local % mt;
          if (runRemaining > stopTask - nextTask) runRemaining = stopTask - nextTask;
          uint32_t runRows = runRemaining * BM;
          if (runRows > len - mr) runRows = len - mr;
          mm.SetSingleShape(runRows, cols, t.k);
          mm.SetTensorA(xg[(uint64_t)(prev + mr) * t.k]);
          mm.SetTensorB(wg[(uint64_t)e * t.k * t.n + nc]);
        }
        mm.Iterate();
        mm.GetTensorC(cg, 0, true);
        if (!--runRemaining) {
          mm.Iterate();
          mm.End();
        }
      } else {
        mm.SetSingleShape(rows, cols, t.k);
        mm.SetTensorA(xg[(uint64_t)(prev + mr) * t.k]);
        mm.SetTensorB(wg[PADDED ? 0 : (uint64_t)e * t.k * t.n + nc]);
        if constexpr (DOUBLE_C)
          mm.IterateAll(cg[(done & 1) * ELEMS]);
        else if constexpr (PADDED)
          mm.template IterateAll<true>(cg, streamPack && newPack);
        else
          mm.IterateAll(cg);
        mm.End();
      }
      if constexpr (DOUBLE_C) {
        if (done & 1)
          CrossCoreSetFlag<2, PIPE_FIX>(3);
        else
          CrossCoreSetFlag<2, PIPE_FIX>(0);
      } else
        CrossCoreSetFlag<2, PIPE_FIX>(0);
#endif
#if defined(SPLIT_CORE_VEC)
      if constexpr (DOUBLE_C) {
        uint32_t vectorRows = (rows + VR - 1) / VR;
        uint32_t rowOffset = GetSubBlockIdx() * vectorRows;
        rows = rows > rowOffset ? (rows - rowOffset < vectorRows ? rows - rowOffset : vectorRows) : 0;
        if (rows) DataCopyPad(s, sg[(uint64_t)e * t.n + nc], DataCopyExtParams{1, cols * 4, 0, 0, 0}, DataCopyPadExtParams<float>{true, 0, 0, 0});
        if (done & 1)
          CrossCoreWaitFlag<2>(3);
        else
          CrossCoreWaitFlag<2>(0);
        uint32_t chunks = (rows + 31) / 32;
        if (!chunks) chunks = 1;
        const uint32_t cw = cols == BN ? BN : (cols + 63) / 64 * 64;
        for (uint32_t chunk = 0; chunk < chunks; ++chunk) {
          uint32_t first = chunk * 32;
          uint32_t currentRows = rows > first ? (rows - first < 32 ? rows - first : 32) : 0;
          if (currentRows) {
            if (cols == BN)
              DataCopy(a, cg[(done & 1) * ELEMS + (rowOffset + first) * BN], currentRows * BN);
            else
              DataCopyPad(a, cg[(done & 1) * ELEMS + (rowOffset + first) * BN],
                DataCopyExtParams{uint16_t(currentRows), cols * 4, (BN - cols) * 4, (cw - ((cols + 7) / 8 * 8)) / 8, 0},
                DataCopyPadExtParams<int32_t>{true, 0, 0, 0});
          }
          SetFlag<HardEvent::MTE2_S>(EVENT_ID0);
          WaitFlag<HardEvent::MTE2_S>(EVENT_ID0);

          if (chunk + 1 == chunks) {
            if (done & 1)
              CrossCoreSetFlag<2, PIPE_MTE2>(4);
            else
              CrossCoreSetFlag<2, PIPE_MTE2>(1);
          }
          if (currentRows) {
            SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
            WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
            uint32_t count = currentRows * cw;
            Cast(z, a, RoundMode::CAST_RINT, count);
            for (uint32_t c = 0; c < cw; c += 64) Mul(z[c], z[c], s[c], uint64_t(64), uint8_t(currentRows), BinaryRepeatParams{1, 1, 1, cw / 8, cw / 8, 0});
            if constexpr (REUSE || (BM == 128 && !STREAM))
              GmgGeluSmall<true>(z, h, u, v, p, a, mask1, mask2, count);
            else
              GmgGelu<true>(z, h, u, v, p, a, mask1, mask2, count);
            SetFlag<HardEvent::S_MTE3>(EVENT_ID0);
            WaitFlag<HardEvent::S_MTE3>(EVENT_ID0);
            SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
            WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
            DataCopyPad(yg[uint64_t(prev + mr + rowOffset + first) * t.n + nc], h,
              DataCopyExtParams{uint16_t(currentRows), cols * 2, (cw - ((cols + 15) / 16 * 16)) / 16, (t.n - cols) * 2, 0});
            SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
            WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
          }
        }
      } else {
        uint32_t vectorRows = (rows + VR - 1) / VR;
        uint32_t rowOffset = GetSubBlockIdx() * vectorRows;
        rows = rows > rowOffset ? (rows - rowOffset < vectorRows ? rows - rowOffset : vectorRows) : 0;
        mr += rowOffset;

        if (rows) DataCopyPad(s, sg[(uint64_t)e * t.n + nc], DataCopyExtParams{1, cols * 4, 0, 0, 0}, DataCopyPadExtParams<float>{true, 0, 0, 0});
        CrossCoreWaitFlag<2>(0);
        const uint32_t cw = cols == BN ? BN : (cols + 63) / 64 * 64;
        if (rows) {
          if (cols == BN)
            DataCopy(a, cg[(REUSE && GENERAL ? (done & 1) * ELEMS : 0) + rowOffset * BN], rows * BN);
          else
            DataCopyPad(a, cg[(REUSE && GENERAL ? (done & 1) * ELEMS : 0) + rowOffset * ((REUSE && !GENERAL) ? cols : BN)],
              DataCopyExtParams{(uint16_t)rows, cols * 4, ((REUSE && !GENERAL) ? 0 : (BN - cols) * 4), (cw - ((cols + 7) / 8 * 8)) / 8, 0},
              DataCopyPadExtParams<int32_t>{true, 0, 0, 0});
        }
        SetFlag<HardEvent::MTE2_S>(EVENT_ID0);
        WaitFlag<HardEvent::MTE2_S>(EVENT_ID0);
        CrossCoreSetFlag<2, PIPE_MTE2>(1);
        if (rows) {
          SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
          WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
          uint32_t count = rows * cw;
          Cast(z, a, RoundMode::CAST_RINT, count);

          for (uint32_t c = 0; c < cw; c += 64) Mul(z[c], z[c], s[c], uint64_t(64), uint8_t(rows), BinaryRepeatParams{1, 1, 1, cw / 8, cw / 8, 0});
          if constexpr (REUSE && GENERAL && DIRECT && BM == 64 && BN == 256 && !STREAM && !PADDED)
            GmgGeluSmall<true, true, false, true, true>(z, h, u, v, p, a, mask1, mask2, count);
          else if constexpr (REUSE || (BM == 128 && !STREAM))
            GmgGeluSmall<DIRECT && BN == 256>(z, h, u, v, p, a, mask1, mask2, count);
          else
            GmgGelu<DIRECT && BN == 256>(z, h, u, v, p, a, mask1, mask2, count);
          SetFlag<HardEvent::S_MTE3>(EVENT_ID0);
          WaitFlag<HardEvent::S_MTE3>(EVENT_ID0);
          SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
          WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
          DataCopyPad(
            yg[(uint64_t)(prev + mr) * t.n + nc], h, DataCopyExtParams{(uint16_t)rows, cols * 2, (cw - ((cols + 15) / 16 * 16)) / 16, (t.n - cols) * 2, 0});
          SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
          WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
        }
      }
#endif
      ++done;
    }
    taskBase += tasks;
    prev = end;

    if (end == t.m || (REUSE && GENERAL && nextTask >= stopTask)) break;
  }
#if defined(SPLIT_CORE_CUBE)
  if constexpr (STREAM && BM == 128 && BN == 256)
    if (!done) CrossCoreWaitFlag<2>(2);
  if constexpr (DOUBLE_C) {

    if (done > 1) CrossCoreWaitFlag<2>(4);
    if (done) CrossCoreWaitFlag<2>(1);
  } else if (done)
    CrossCoreWaitFlag<2>(1);
#endif
}

template <uint32_t BM, uint32_t BN, bool MDL = false, bool REUSE = false, bool DIRECT = false, bool PADDED = false, bool GENERAL = false, bool STREAM = false,
  uint32_t DIRECT_MAX_K = 2048, bool FORCE_DOUBLE = false>
__aicore__ inline void GmgComputeSmall(GM_ADDR x, GM_ADDR w, GM_ADDR scale, GM_ADDR groups, GM_ADDR y, GM_ADDR workspace, const GmgTiling &t) {
  static_assert(BM == 64 && BN == 256 && DIRECT && FORCE_DOUBLE && !GENERAL && !REUSE && !PADDED && !STREAM,
    "Small-z repair initially uses the existing direct M64/N256 path");
  constexpr uint32_t ELEMS = BM * BN, VR = 2, VELEMS = (BM > 64 ? 64 : BM) * BN / VR;
  constexpr bool DOUBLE_C = (BM == 128 || FORCE_DOUBLE);
  static_assert(
    !FORCE_DOUBLE || (BM == 64 && BN == 256 && DIRECT && !GENERAL && !REUSE && !PADDED && !STREAM), "extra C bank is restricted to direct M64/N256");
  TPipe pipe;
  const uint32_t core = GetBlockIdx() / GetTaskRation();
  typename Conditional<PADDED, GmgWordWeightPacker, GmgNoWeightPacker>::type packer;
  if constexpr (PADDED) {
    auto padded = workspace + uint64_t(t.blocks) * t.bm * t.bn * 4 + uint64_t(core) * ((t.k + 511) / 512 * 512) * ((t.n + 31) / 32 * 32);
    packer.Init(w, padded, t, pipe);
    w = padded;
  }
  GlobalTensor<int8_t> xg, wg;
  GlobalTensor<int64_t> gg;
  GlobalTensor<float> sg;
  GlobalTensor<half> yg;
  GlobalTensor<int32_t> cg;
  xg.SetGlobalBuffer((__gm__ int8_t *)x);
  wg.SetGlobalBuffer((__gm__ int8_t *)w);
  gg.SetGlobalBuffer((__gm__ int64_t *)groups);
  sg.SetGlobalBuffer((__gm__ float *)scale);
  yg.SetGlobalBuffer((__gm__ half *)y);
  cg.SetGlobalBuffer((__gm__ int32_t *)workspace + core * ELEMS * ((DOUBLE_C || (REUSE && GENERAL)) ? 2 : 1));

#if defined(SPLIT_CORE_CUBE)
  if constexpr (!DIRECT && !STREAM) GmgPrepareL1(pipe, t);
  using StandardCube = typename Conditional<DIRECT,
    typename Conditional<(BN <= 128), GmgNarrowCube<PADDED, BN>,
      typename Conditional<GENERAL, GmgNarrowCube<false, 256, BM, DIRECT_MAX_K>, GmgDirectCube>::type>::type,
    Matmul<MatmulType<TPosition::GM, CubeFormat::ND, int8_t>, MatmulType<TPosition::GM, CubeFormat::ND, int8_t>,
      MatmulType<TPosition::GM, CubeFormat::ND, int32_t>, MatmulType<TPosition::GM, CubeFormat::ND, int32_t>, GMG_MATMUL_CONFIG<MDL>>>::type;
  using CubeOp = typename Conditional<STREAM, GmgStreamCube<BN, BM>,
    typename Conditional<(BM == 128 && !GENERAL), GmgTallCube, typename Conditional<REUSE && GENERAL, GmgPaddedReuseCube, StandardCube>::type>::type>::type;
  CubeOp mm;
  mm.Init(&t.cube, &pipe);
  mm.SetOrgShape(REUSE ? t.m : BM, PADDED ? (t.n + 31) / 32 * 32 : t.n, t.k, t.k, BN);
  CrossCoreWaitFlag<2>(2);
#endif

#if defined(SPLIT_CORE_VEC)
  TBuf<TPosition::VECCALC> ab, zb, ub, vb, pb, sb, hb, maskb1, maskb2, groupBuffer;
  pipe.InitBuffer(ab, (VELEMS * 4) + 256);
  pipe.InitBuffer(zb, (VELEMS * 4) + 256);
  pipe.InitBuffer(ub, (VELEMS * 4) + 256);
  pipe.InitBuffer(vb, (VELEMS * 4) + 256);
  pipe.InitBuffer(pb, (VELEMS * 4) + 256);
  pipe.InitBuffer(sb, (BN * 4) + 256);
  pipe.InitBuffer(hb, (VELEMS * 2) + 256);
  pipe.InitBuffer(maskb1, (VELEMS / 8) + 256);
  pipe.InitBuffer(maskb2, (VELEMS / 8) + 256);
  auto a = ab.Get<int32_t>();
  auto z = zb.Get<float>();
  auto u = ub.Get<float>();
  auto v = vb.Get<float>();
  auto p = pb.Get<float>();
  auto s = sb.Get<float>();
  auto h = hb.Get<half>();
  auto mask1 = maskb1.Get<uint8_t>();
  auto mask2 = maskb2.Get<uint8_t>();

  LocalTensor<int64_t> localGroups;
  bool useLocalGroups = false;
  if constexpr ((DIRECT && BN == 256 && !GENERAL) || (REUSE && GENERAL)) {
    pipe.InitBuffer(groupBuffer, 128 * 8);
    localGroups = groupBuffer.Get<int64_t>();
    useLocalGroups = t.e >= 16;
    if (useLocalGroups) {
      GlobalTensor<int32_t> groupWords;
      groupWords.SetGlobalBuffer((__gm__ int32_t *)groups);
      DataCopyPad(groupBuffer.Get<int32_t>(), groupWords, DataCopyExtParams{1, t.e * 8, 0, 0, 0},
        DataCopyPadExtParams<int32_t>{true, 0, uint8_t((4 - t.e % 4) % 4 * 2), 0});
      SetFlag<HardEvent::MTE2_S>(EVENT_ID0);
      WaitFlag<HardEvent::MTE2_S>(EVENT_ID0);
    }
  }

  CrossCoreSetFlag<2, PIPE_MTE3>(2);
  if (t.n % BN) {
    Duplicate(s, 0.0f, BN);
    SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
    WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
  }
#endif
  uint32_t taskBase = 0, prev = 0, done = 0, nextTask = core, packedExpert = t.e;

  const uint32_t nt = BN == 64 ? 1 : (t.n + BN - 1) / BN;
#if defined(SPLIT_CORE_VEC)
  uint32_t firstExpert = useLocalGroups ? GmgFirstExpert(localGroups, t.e) : GmgFirstExpert(gg, t.e);
#else
  uint32_t firstExpert = GmgFirstExpert(gg, t.e);
#endif
  uint32_t stopTask = 0xffffffffU, runRemaining = 0;
  if constexpr (REUSE) {
    uint32_t total = 0, before = 0;
    for (uint32_t e = firstExpert; e < t.e; ++e) {
      uint32_t end =
#if defined(SPLIT_CORE_VEC)
        useLocalGroups ? localGroups.GetValue(e) : gg.GetValue(e);
#else
        gg.GetValue(e);
#endif
      total += (end - before + BM - 1) / BM * nt;
      before = end;
      if (end == t.m) break;
    }
    nextTask = total * core / t.blocks;
    stopTask = total * (core + 1) / t.blocks;
  }
  for (uint32_t e = firstExpert; e < t.e; ++e) {
    uint32_t end =
#if defined(SPLIT_CORE_VEC)
      useLocalGroups ? localGroups.GetValue(e) : gg.GetValue(e);
#else
      gg.GetValue(e);
#endif
    uint32_t len = end - prev, mt = (len + BM - 1) / BM;
    uint32_t tasks = mt * nt;

    for (; nextTask < taskBase + tasks && nextTask < stopTask; nextTask += (REUSE ? 1 : t.blocks)) {
      uint32_t local = nextTask - taskBase;
      uint32_t mr = (BN == 64 ? local : (REUSE ? local % mt : local / nt)) * BM;
      uint32_t nc = BN == 64 ? 0 : (REUSE ? local / mt : local % nt) * BN;
      uint32_t rows = (len - mr < BM ? len - mr : BM), cols = (t.n - nc < BN ? t.n - nc : BN);
      if constexpr (PADDED)
        if (packedExpert != e) {
          packer.Pack(e, 0, t.k);
          packedExpert = e;
        }
#if defined(SPLIT_CORE_CUBE)
      if constexpr (DOUBLE_C) {
        if (done >= 2) {
          if (done & 1)
            CrossCoreWaitFlag<2>(4);
          else
            CrossCoreWaitFlag<2>(1);
        }
      } else if (done)
        CrossCoreWaitFlag<2>(1);
      if constexpr (REUSE) {

        if (!runRemaining) {
          runRemaining = mt - local % mt;
          if (runRemaining > stopTask - nextTask) runRemaining = stopTask - nextTask;
          uint32_t runRows = runRemaining * BM;
          if (runRows > len - mr) runRows = len - mr;
          mm.SetSingleShape(runRows, cols, t.k);
          mm.SetTensorA(xg[(uint64_t)(prev + mr) * t.k]);
          mm.SetTensorB(wg[(uint64_t)e * t.k * t.n + nc]);
        }
        mm.Iterate();
        mm.GetTensorC(cg, 0, true);
        if (!--runRemaining) {
          mm.Iterate();
          mm.End();
        }
      } else {
        mm.SetSingleShape(rows, cols, t.k);
        mm.SetTensorA(xg[(uint64_t)(prev + mr) * t.k]);
        mm.SetTensorB(wg[PADDED ? 0 : (uint64_t)e * t.k * t.n + nc]);
        if constexpr (DOUBLE_C)
          mm.IterateAll(cg[(done & 1) * ELEMS]);
        else
          mm.IterateAll(cg);
        mm.End();
      }
      if constexpr (DOUBLE_C) {
        if (done & 1)
          CrossCoreSetFlag<2, PIPE_FIX>(3);
        else
          CrossCoreSetFlag<2, PIPE_FIX>(0);
      } else
        CrossCoreSetFlag<2, PIPE_FIX>(0);
#endif
#if defined(SPLIT_CORE_VEC)
      if constexpr (DOUBLE_C) {
        uint32_t vectorRows = (rows + VR - 1) / VR;
        uint32_t rowOffset = GetSubBlockIdx() * vectorRows;
        rows = rows > rowOffset ? (rows - rowOffset < vectorRows ? rows - rowOffset : vectorRows) : 0;
        if (rows) DataCopyPad(s, sg[(uint64_t)e * t.n + nc], DataCopyExtParams{1, cols * 4, 0, 0, 0}, DataCopyPadExtParams<float>{true, 0, 0, 0});
        if (done & 1)
          CrossCoreWaitFlag<2>(3);
        else
          CrossCoreWaitFlag<2>(0);
        uint32_t chunks = (rows + 31) / 32;
        if (!chunks) chunks = 1;
        for (uint32_t chunk = 0; chunk < chunks; ++chunk) {
          uint32_t first = chunk * 32;
          uint32_t currentRows = rows > first ? (rows - first < 32 ? rows - first : 32) : 0;
          if (currentRows) {
            if (cols == BN)
              DataCopy(a, cg[(done & 1) * ELEMS + (rowOffset + first) * BN], currentRows * BN);
            else
              DataCopyPad(a, cg[(done & 1) * ELEMS + (rowOffset + first) * BN],
                DataCopyExtParams{uint16_t(currentRows), cols * 4, (BN - cols) * 4, (BN - ((cols + 7) / 8 * 8)) / 8, 0},
                DataCopyPadExtParams<int32_t>{true, 0, 0, 0});
          }
          SetFlag<HardEvent::MTE2_S>(EVENT_ID0);
          WaitFlag<HardEvent::MTE2_S>(EVENT_ID0);

          if (chunk + 1 == chunks) {
            if (done & 1)
              CrossCoreSetFlag<2, PIPE_MTE2>(4);
            else
              CrossCoreSetFlag<2, PIPE_MTE2>(1);
          }
          if (currentRows) {
            SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
            WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
            uint32_t count = currentRows * BN;
            Cast(z, a, RoundMode::CAST_RINT, count);
            for (uint32_t c = 0; c < BN; c += 64) Mul(z[c], z[c], s[c], uint64_t(64), uint8_t(currentRows), BinaryRepeatParams{1, 1, 1, BN / 8, BN / 8, 0});
            GmgGeluSmall<true>(z, h, u, v, p, a, mask1, mask2, count);
            SetFlag<HardEvent::S_MTE3>(EVENT_ID0);
            WaitFlag<HardEvent::S_MTE3>(EVENT_ID0);
            SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
            WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
            DataCopyPad(yg[uint64_t(prev + mr + rowOffset + first) * t.n + nc], h,
              DataCopyExtParams{uint16_t(currentRows), cols * 2, (BN - ((cols + 15) / 16 * 16)) / 16, (t.n - cols) * 2, 0});
            SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
            WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
          }
        }
      } else {
        uint32_t vectorRows = (rows + VR - 1) / VR;
        uint32_t rowOffset = GetSubBlockIdx() * vectorRows;
        rows = rows > rowOffset ? (rows - rowOffset < vectorRows ? rows - rowOffset : vectorRows) : 0;
        mr += rowOffset;

        if (rows) DataCopyPad(s, sg[(uint64_t)e * t.n + nc], DataCopyExtParams{1, cols * 4, 0, 0, 0}, DataCopyPadExtParams<float>{true, 0, 0, 0});
        CrossCoreWaitFlag<2>(0);
        if (rows) {
          if (cols == BN)
            DataCopy(a, cg[(REUSE && GENERAL ? (done & 1) * ELEMS : 0) + rowOffset * BN], rows * BN);
          else
            DataCopyPad(a, cg[(REUSE && GENERAL ? (done & 1) * ELEMS : 0) + rowOffset * ((REUSE && !GENERAL) ? cols : BN)],
              DataCopyExtParams{(uint16_t)rows, cols * 4, ((REUSE && !GENERAL) ? 0 : (BN - cols) * 4), (BN - ((cols + 7) / 8 * 8)) / 8, 0},
              DataCopyPadExtParams<int32_t>{true, 0, 0, 0});
        }
        SetFlag<HardEvent::MTE2_S>(EVENT_ID0);
        WaitFlag<HardEvent::MTE2_S>(EVENT_ID0);
        CrossCoreSetFlag<2, PIPE_MTE2>(1);
        if (rows) {
          SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
          WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
          uint32_t count = rows * BN;
          Cast(z, a, RoundMode::CAST_RINT, count);

          for (uint32_t c = 0; c < BN; c += 64) Mul(z[c], z[c], s[c], uint64_t(64), uint8_t(rows), BinaryRepeatParams{1, 1, 1, BN / 8, BN / 8, 0});
          GmgGeluSmall<DIRECT && BN == 256>(z, h, u, v, p, a, mask1, mask2, count);
          SetFlag<HardEvent::S_MTE3>(EVENT_ID0);
          WaitFlag<HardEvent::S_MTE3>(EVENT_ID0);
          SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
          WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
          DataCopyPad(
            yg[(uint64_t)(prev + mr) * t.n + nc], h, DataCopyExtParams{(uint16_t)rows, cols * 2, (BN - ((cols + 15) / 16 * 16)) / 16, (t.n - cols) * 2, 0});
          SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
          WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
        }
      }
#endif
      ++done;
    }
    taskBase += tasks;
    prev = end;

    if (end == t.m || (REUSE && GENERAL && nextTask >= stopTask)) break;
  }
#if defined(SPLIT_CORE_CUBE)
  if constexpr (DOUBLE_C) {

    if (done > 1) CrossCoreWaitFlag<2>(4);
    if (done) CrossCoreWaitFlag<2>(1);
  } else if (done)
    CrossCoreWaitFlag<2>(1);
#endif
}

template <uint32_t BM, uint32_t BN, bool MDL = false, bool REUSE = false, bool DIRECT = false, bool PADDED = false, bool GENERAL = false, bool STREAM = false,
  uint32_t DIRECT_MAX_K = 2048, bool USE_SMALL_GELU = false>
__aicore__ inline void GmgComputeWide(GM_ADDR x, GM_ADDR w, GM_ADDR scale, GM_ADDR groups, GM_ADDR y, GM_ADDR workspace, const GmgTiling &t) {
  constexpr uint32_t ELEMS = BM * BN, VR = 2, CHUNK_ROWS = 8192 / BN, VELEMS = (BM > 2 * CHUNK_ROWS ? 2 * CHUNK_ROWS : BM) * BN / VR;
  constexpr bool DOUBLE_C = (BM == 128 || BN > 256);
  TPipe pipe;
  const uint32_t core = GetBlockIdx() / GetTaskRation();
  typename Conditional<PADDED, GmgWordWeightPacker, GmgNoWeightPacker>::type packer;
  if constexpr (PADDED) {
    auto padded = workspace + uint64_t(t.blocks) * t.bm * t.bn * 4 + uint64_t(core) * ((t.k + 511) / 512 * 512) * ((t.n + 31) / 32 * 32);
    packer.Init(w, padded, t, pipe);
    w = padded;
  }
  GlobalTensor<int8_t> xg, wg;
  GlobalTensor<int64_t> gg;
  GlobalTensor<float> sg;
  GlobalTensor<half> yg;
  GlobalTensor<int32_t> cg;
  xg.SetGlobalBuffer((__gm__ int8_t *)x);
  wg.SetGlobalBuffer((__gm__ int8_t *)w);
  gg.SetGlobalBuffer((__gm__ int64_t *)groups);
  sg.SetGlobalBuffer((__gm__ float *)scale);
  yg.SetGlobalBuffer((__gm__ half *)y);
  cg.SetGlobalBuffer((__gm__ int32_t *)workspace + core * ELEMS * ((DOUBLE_C || (REUSE && GENERAL)) ? 2 : 1));

#if defined(SPLIT_CORE_CUBE)
  if constexpr (!DIRECT && !STREAM) GmgPrepareL1(pipe, t);
  using StandardCube = typename Conditional<DIRECT,
    typename Conditional<(BN <= 128), GmgWideCube<PADDED, BN>,
      typename Conditional<GENERAL, GmgWideCube<false, BN, BM, DIRECT_MAX_K, (BN > 256 ? 256 : 512)>, GmgDirectCube>::type>::type,
    Matmul<MatmulType<TPosition::GM, CubeFormat::ND, int8_t>, MatmulType<TPosition::GM, CubeFormat::ND, int8_t>,
      MatmulType<TPosition::GM, CubeFormat::ND, int32_t>, MatmulType<TPosition::GM, CubeFormat::ND, int32_t>, GMG_MATMUL_CONFIG<MDL>>>::type;
  using CubeOp = typename Conditional<STREAM, GmgStreamCube<BN, BM>,
    typename Conditional<(BM == 128 && !GENERAL), GmgTallCube, typename Conditional<REUSE && GENERAL, GmgPaddedReuseCube, StandardCube>::type>::type>::type;
  CubeOp mm;
  mm.Init(&t.cube, &pipe);
  mm.SetOrgShape(REUSE ? t.m : BM, PADDED ? (t.n + 31) / 32 * 32 : t.n, t.k, t.k, BN);
  CrossCoreWaitFlag<2>(2);
#endif

#if defined(SPLIT_CORE_VEC)
  TBuf<TPosition::VECCALC> ab, zb, ub, vb, pb, sb, hb, maskb1, maskb2, groupBuffer;
  pipe.InitBuffer(ab, (VELEMS * 4) + 256);
  pipe.InitBuffer(zb, (VELEMS * 4) + 256);
  pipe.InitBuffer(ub, (VELEMS * 4) + 256);
  pipe.InitBuffer(vb, (VELEMS * 4) + 256);
  pipe.InitBuffer(pb, (VELEMS * 4) + 256);
  pipe.InitBuffer(sb, (BN * 4) + 256);
  pipe.InitBuffer(hb, (VELEMS * 2) + 256);
  pipe.InitBuffer(maskb1, (VELEMS / 8) + 256);
  pipe.InitBuffer(maskb2, (VELEMS / 8) + 256);
  auto a = ab.Get<int32_t>();
  auto z = zb.Get<float>();
  auto u = ub.Get<float>();
  auto v = vb.Get<float>();
  auto p = pb.Get<float>();
  auto s = sb.Get<float>();
  auto h = hb.Get<half>();
  auto mask1 = maskb1.Get<uint8_t>();
  auto mask2 = maskb2.Get<uint8_t>();

  LocalTensor<int64_t> localGroups;
  bool useLocalGroups = false;
  if constexpr ((DIRECT && BN == 256 && !GENERAL) || (REUSE && GENERAL)) {
    pipe.InitBuffer(groupBuffer, 128 * 8);
    localGroups = groupBuffer.Get<int64_t>();
    useLocalGroups = t.e >= 16;
    if (useLocalGroups) {
      GlobalTensor<int32_t> groupWords;
      groupWords.SetGlobalBuffer((__gm__ int32_t *)groups);
      DataCopyPad(groupBuffer.Get<int32_t>(), groupWords, DataCopyExtParams{1, t.e * 8, 0, 0, 0},
        DataCopyPadExtParams<int32_t>{true, 0, uint8_t((4 - t.e % 4) % 4 * 2), 0});
      SetFlag<HardEvent::MTE2_S>(EVENT_ID0);
      WaitFlag<HardEvent::MTE2_S>(EVENT_ID0);
    }
  }

  CrossCoreSetFlag<2, PIPE_MTE3>(2);
  if (t.n % BN) {
    Duplicate(s, 0.0f, BN);
    SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
    WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
  }
#endif
  uint32_t taskBase = 0, prev = 0, done = 0, nextTask = core, packedExpert = t.e;

  const uint32_t nt = BN == 64 ? 1 : (t.n + BN - 1) / BN;
#if defined(SPLIT_CORE_VEC)
  uint32_t firstExpert = useLocalGroups ? GmgFirstExpert(localGroups, t.e) : GmgFirstExpert(gg, t.e);
#else
  uint32_t firstExpert = GmgFirstExpert(gg, t.e);
#endif
  uint32_t stopTask = 0xffffffffU, runRemaining = 0;
  if constexpr (REUSE) {
    uint32_t total = 0, before = 0;
    for (uint32_t e = firstExpert; e < t.e; ++e) {
      uint32_t end =
#if defined(SPLIT_CORE_VEC)
        useLocalGroups ? localGroups.GetValue(e) : gg.GetValue(e);
#else
        gg.GetValue(e);
#endif
      total += (end - before + BM - 1) / BM * nt;
      before = end;
      if (end == t.m) break;
    }
    nextTask = total * core / t.blocks;
    stopTask = total * (core + 1) / t.blocks;
  }

  for (uint32_t columnPhase = 0; columnPhase < (BN > 256 && t.n % BN ? 2U : 1U); ++columnPhase) {
    const uint32_t phaseNt = BN > 256 ? (columnPhase ? 1 : t.n / BN) : nt;
    prev = 0;
    for (uint32_t e = firstExpert; e < t.e; ++e) {
      uint32_t end =
#if defined(SPLIT_CORE_VEC)
        useLocalGroups ? localGroups.GetValue(e) : gg.GetValue(e);
#else
        gg.GetValue(e);
#endif
      uint32_t len = end - prev, mt = (len + BM - 1) / BM;
      uint32_t tasks = mt * phaseNt;

      for (; nextTask < taskBase + tasks && nextTask < stopTask; nextTask += (REUSE ? 1 : t.blocks)) {
        uint32_t local = nextTask - taskBase;
        uint32_t mr = (BN == 64 ? local : (REUSE ? local % mt : local / phaseNt)) * BM;
        uint32_t nc = BN == 64 ? 0 : (REUSE ? local / mt : local % phaseNt) * BN;
        if constexpr (BN > 256) {
          if (columnPhase) nc = (t.n / BN) * BN;
        }
        uint32_t rows = (len - mr < BM ? len - mr : BM), cols = (t.n - nc < BN ? t.n - nc : BN);
        if constexpr (PADDED)
          if (packedExpert != e) {
            packer.Pack(e, 0, t.k);
            packedExpert = e;
          }
#if defined(SPLIT_CORE_CUBE)
        if constexpr (DOUBLE_C) {
          if (done >= 2) {
            if (done & 1)
              CrossCoreWaitFlag<2>(4);
            else
              CrossCoreWaitFlag<2>(1);
          }
        } else if (done)
          CrossCoreWaitFlag<2>(1);
        if constexpr (REUSE) {

          if (!runRemaining) {
            runRemaining = mt - local % mt;
            if (runRemaining > stopTask - nextTask) runRemaining = stopTask - nextTask;
            uint32_t runRows = runRemaining * BM;
            if (runRows > len - mr) runRows = len - mr;
            mm.SetSingleShape(runRows, cols, t.k);
            mm.SetTensorA(xg[(uint64_t)(prev + mr) * t.k]);
            mm.SetTensorB(wg[(uint64_t)e * t.k * t.n + nc]);
          }
          mm.Iterate();
          mm.GetTensorC(cg, 0, true);
          if (!--runRemaining) {
            mm.Iterate();
            mm.End();
          }
        } else {
          mm.SetSingleShape(rows, cols, t.k);
          mm.SetTensorA(xg[(uint64_t)(prev + mr) * t.k]);
          mm.SetTensorB(wg[PADDED ? 0 : (uint64_t)e * t.k * t.n + nc]);
          if constexpr (DOUBLE_C)
            mm.IterateAll(cg[(done & 1) * ELEMS]);
          else
            mm.IterateAll(cg);
          mm.End();
        }
        if constexpr (DOUBLE_C) {
          if (done & 1)
            CrossCoreSetFlag<2, PIPE_FIX>(3);
          else
            CrossCoreSetFlag<2, PIPE_FIX>(0);
        } else
          CrossCoreSetFlag<2, PIPE_FIX>(0);
#endif
#if defined(SPLIT_CORE_VEC)
        if constexpr (DOUBLE_C) {
          uint32_t vectorRows = (rows + VR - 1) / VR;
          uint32_t rowOffset = GetSubBlockIdx() * vectorRows;
          rows = rows > rowOffset ? (rows - rowOffset < vectorRows ? rows - rowOffset : vectorRows) : 0;
          if (rows) DataCopyPad(s, sg[(uint64_t)e * t.n + nc], DataCopyExtParams{1, cols * 4, 0, 0, 0}, DataCopyPadExtParams<float>{true, 0, 0, 0});
          if (done & 1)
            CrossCoreWaitFlag<2>(3);
          else
            CrossCoreWaitFlag<2>(0);

          uint32_t vectorStride = BN > 256 ? (cols + 63) / 64 * 64 : BN;
          uint32_t chunkRows = BN > 256 ? 8192 / vectorStride : CHUNK_ROWS;
          uint32_t chunks = (rows + chunkRows - 1) / chunkRows;
          if (!chunks) chunks = 1;
          for (uint32_t chunk = 0; chunk < chunks; ++chunk) {
            uint32_t first = chunk * chunkRows;
            uint32_t currentRows = rows > first ? (rows - first < chunkRows ? rows - first : chunkRows) : 0;
            if (currentRows) {
              if (cols == BN)
                DataCopy(a, cg[(done & 1) * ELEMS + (rowOffset + first) * BN], currentRows * BN);
              else
                DataCopyPad(a, cg[(done & 1) * ELEMS + (rowOffset + first) * BN],
                  DataCopyExtParams{uint16_t(currentRows), cols * 4, (BN - cols) * 4, (vectorStride - ((cols + 7) / 8 * 8)) / 8, 0},
                  DataCopyPadExtParams<int32_t>{true, 0, 0, 0});
            }
            SetFlag<HardEvent::MTE2_S>(EVENT_ID0);
            WaitFlag<HardEvent::MTE2_S>(EVENT_ID0);

            if (chunk + 1 == chunks) {
              if (done & 1)
                CrossCoreSetFlag<2, PIPE_MTE2>(4);
              else
                CrossCoreSetFlag<2, PIPE_MTE2>(1);
            }
            if (currentRows) {
              SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
              WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
              uint32_t count = currentRows * vectorStride;
              Cast(z, a, RoundMode::CAST_RINT, count);
              for (uint32_t c = 0; c < vectorStride; c += 64)
                Mul(z[c], z[c], s[c], uint64_t(64), uint8_t(currentRows), BinaryRepeatParams{1, 1, 1, uint8_t(vectorStride / 8), uint8_t(vectorStride / 8), 0});
              if constexpr (USE_SMALL_GELU)
                GmgGeluSmall<true>(z, h, u, v, p, a, mask1, mask2, count);
              else
                GmgGelu<true>(z, h, u, v, p, a, mask1, mask2, count);
              SetFlag<HardEvent::S_MTE3>(EVENT_ID0);
              WaitFlag<HardEvent::S_MTE3>(EVENT_ID0);
              SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
              WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
              DataCopyPad(yg[uint64_t(prev + mr + rowOffset + first) * t.n + nc], h,
                DataCopyExtParams{uint16_t(currentRows), cols * 2, (vectorStride - ((cols + 15) / 16 * 16)) / 16, (t.n - cols) * 2, 0});
              SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
              WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
            }
          }
        } else {
          uint32_t vectorRows = (rows + VR - 1) / VR;
          uint32_t rowOffset = GetSubBlockIdx() * vectorRows;
          rows = rows > rowOffset ? (rows - rowOffset < vectorRows ? rows - rowOffset : vectorRows) : 0;
          mr += rowOffset;

          if (rows) DataCopyPad(s, sg[(uint64_t)e * t.n + nc], DataCopyExtParams{1, cols * 4, 0, 0, 0}, DataCopyPadExtParams<float>{true, 0, 0, 0});
          CrossCoreWaitFlag<2>(0);
          if (rows) {
            if (cols == BN)
              DataCopy(a, cg[(REUSE && GENERAL ? (done & 1) * ELEMS : 0) + rowOffset * BN], rows * BN);
            else
              DataCopyPad(a, cg[(REUSE && GENERAL ? (done & 1) * ELEMS : 0) + rowOffset * ((REUSE && !GENERAL) ? cols : BN)],
                DataCopyExtParams{(uint16_t)rows, cols * 4, ((REUSE && !GENERAL) ? 0 : (BN - cols) * 4), (BN - ((cols + 7) / 8 * 8)) / 8, 0},
                DataCopyPadExtParams<int32_t>{true, 0, 0, 0});
          }
          SetFlag<HardEvent::MTE2_S>(EVENT_ID0);
          WaitFlag<HardEvent::MTE2_S>(EVENT_ID0);
          CrossCoreSetFlag<2, PIPE_MTE2>(1);
          if (rows) {
            SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
            WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
            uint32_t count = rows * BN;
            Cast(z, a, RoundMode::CAST_RINT, count);

            for (uint32_t c = 0; c < BN; c += 64) Mul(z[c], z[c], s[c], uint64_t(64), uint8_t(rows), BinaryRepeatParams{1, 1, 1, BN / 8, BN / 8, 0});
            GmgGelu<DIRECT && BN == 256>(z, h, u, v, p, a, mask1, mask2, count);
            SetFlag<HardEvent::S_MTE3>(EVENT_ID0);
            WaitFlag<HardEvent::S_MTE3>(EVENT_ID0);
            SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
            WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
            DataCopyPad(
              yg[(uint64_t)(prev + mr) * t.n + nc], h, DataCopyExtParams{(uint16_t)rows, cols * 2, (BN - ((cols + 15) / 16 * 16)) / 16, (t.n - cols) * 2, 0});
            SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
            WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
          }
        }
#endif
        ++done;
      }
      taskBase += tasks;
      prev = end;

      if (end == t.m || (REUSE && GENERAL && nextTask >= stopTask)) break;
    }
  }
#if defined(SPLIT_CORE_CUBE)
  if constexpr (DOUBLE_C) {

    if (done > 1) CrossCoreWaitFlag<2>(4);
    if (done) CrossCoreWaitFlag<2>(1);
  } else if (done)
    CrossCoreWaitFlag<2>(1);
#endif
}

class GmgSingleColumnPacker {
public:
  static constexpr uint32_t CHUNK = 1024, WORDS = CHUNK * 8;
  __aicore__ inline void Init(GM_ADDR raw, GM_ADDR packed, uint32_t k, AscendC::TPipe &pipe) {
    using namespace AscendC;
    k_ = k;
    paddedK_ = (k + 255) / 256 * 256;
    source_.SetGlobalBuffer((__gm__ int8_t *)raw);
    target_.SetGlobalBuffer((__gm__ int32_t *)packed);
    pipe.InitBuffer(inputBuffer, CHUNK);
    pipe.InitBuffer(halfBuffer, CHUNK * 2);
    pipe.InitBuffer(valueBuffer, CHUNK * 4);
    pipe.InitBuffer(outputBuffer, WORDS * 4);
    pipe.InitBuffer(offsetBuffer, WORDS * 4);
    pipe.InitBuffer(maskBuffer, WORDS * 4);
    auto out = outputBuffer.Get<int32_t>();
    auto offsets = offsetBuffer.Get<int32_t>();
    auto mask = maskBuffer.Get<int32_t>();
    GmgIndex(out, WORDS);
    ShiftRight(offsets, out, int32_t(3), WORDS);
    ShiftLeft(offsets.ReinterpretCast<uint32_t>(), offsets.ReinterpretCast<uint32_t>(), uint32_t(2), WORDS);
    ShiftLeft(mask.ReinterpretCast<uint32_t>(), out.ReinterpretCast<uint32_t>(), uint32_t(29), WORDS);
    ShiftRight(mask.ReinterpretCast<uint32_t>(), mask.ReinterpretCast<uint32_t>(), uint32_t(29), WORDS);
    Mins(mask, mask, int32_t(1), WORDS);
    Muls(mask, mask, int32_t(-1), WORDS);
    Adds(mask, mask, int32_t(1), WORDS);
  }
  __aicore__ inline void Pack(uint32_t expert) {
    using namespace AscendC;
    auto input = inputBuffer.Get<int8_t>();
    auto halfs = halfBuffer.Get<half>();
    auto values = valueBuffer.Get<int32_t>();
    auto out = outputBuffer.Get<int32_t>();
    auto offsets = offsetBuffer.Get<uint32_t>();
    auto mask = maskBuffer.Get<int32_t>();
    uint32_t part = paddedK_ / 2, start = GetSubBlockIdx() * part, last = start + part;
    for (uint32_t base = start; base < last; base += CHUNK) {
      uint32_t rows = last - base < CHUNK ? last - base : CHUNK;
      uint32_t valid = base < k_ ? (k_ - base < rows ? k_ - base : rows) : 0;
      Duplicate(input.ReinterpretCast<int32_t>(), int32_t(0), CHUNK / 4);
      SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
      WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
      if (valid)
        DataCopyPad(input, source_[uint64_t(expert) * k_ + base], DataCopyExtParams{1, valid, 0, 0, 0},
          DataCopyPadExtParams<int8_t>{true, 0, uint8_t((32 - valid % 32) % 32), 0});
      SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
      WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
      Cast(halfs, input, RoundMode::CAST_NONE, CHUNK);
      Cast(values, halfs, RoundMode::CAST_RINT, CHUNK);

      ShiftLeft(values.ReinterpretCast<uint32_t>(), values.ReinterpretCast<uint32_t>(), uint32_t(24), CHUNK);
      ShiftRight(values.ReinterpretCast<uint32_t>(), values.ReinterpretCast<uint32_t>(), uint32_t(24), CHUNK);
      Gather(out.ReinterpretCast<uint32_t>(), values.ReinterpretCast<uint32_t>(), offsets, 0, WORDS);
      Mul(out, out, mask, WORDS);
      SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
      WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
      DataCopy(target_[base * 8], out, rows * 8);
      SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
      WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
    }
    CrossCoreSetFlag<2, PIPE_MTE3>(5);
  }

private:
  AscendC::TBuf<AscendC::TPosition::VECCALC> inputBuffer, halfBuffer, valueBuffer, outputBuffer, offsetBuffer, maskBuffer;
  AscendC::GlobalTensor<int8_t> source_;
  AscendC::GlobalTensor<int32_t> target_;
  uint32_t k_ = 0, paddedK_ = 0;
};

class GmgGemvWeightCube {
public:
  static constexpr uint32_t HEIGHT = 64, WIDTH = 32, INNER_K = 256, MAX_K = 8192;
  __aicore__ inline void Init(AscendC::TPipe &pipe, uint32_t k) {
    k_ = k;
    paddedK_ = (k + INNER_K - 1) / INNER_K * INNER_K;
    pipe.InitBuffer(a1b, 2, HEIGHT * INNER_K);
    pipe.InitBuffer(b1b, 1, MAX_K * WIDTH);
    pipe.InitBuffer(a2b, 2, HEIGHT * INNER_K);
    pipe.InitBuffer(b2b, 2, INNER_K * WIDTH);
    pipe.InitBuffer(c1b, 1, HEIGHT * WIDTH * 4);
  }
  __aicore__ inline void SetWeight(AscendC::GlobalTensor<int8_t> w) {
    using namespace AscendC;
    if (loaded_) b1b.FreeTensor(weight_);
    auto b1 = b1b.AllocTensor<int8_t>();

    DataCopy(b1, w, paddedK_ * WIDTH);
    b1b.EnQue(b1);
    weight_ = b1b.DeQue<int8_t>();
    loaded_ = true;
  }
  __aicore__ inline void Tile(AscendC::GlobalTensor<int8_t> x, uint32_t rows, AscendC::GlobalTensor<int32_t> result) {
    using namespace AscendC;
    x_ = x;
    rows_ = rows;
    paddedM_ = (rows + 15) / 16 * 16;
    auto c1 = c1b.AllocTensor<int32_t>();
    CopyA(0);
    for (uint32_t base = 0; base < k_; base += INNER_K) {
      auto a1 = a1b.DeQue<int8_t>();
      if (base + INNER_K < k_) CopyA(base + INNER_K);
      auto a2 = a2b.AllocTensor<int8_t>();
      auto b2 = b2b.AllocTensor<int8_t>();
      LoadData2dParams al{};
      al.repeatTimes = INNER_K / 32;
      al.srcStride = paddedM_ / 16;
      for (uint32_t row = 0; row < paddedM_; row += 16) LoadData(a2[row * INNER_K], a1[row * 32], al);
      LoadData2dTransposeParams bl{};
      bl.repeatTimes = 1;
      bl.srcStride = paddedK_ / 32;
      bl.dstGap = 1;
      for (uint32_t kk = 0; kk < INNER_K; kk += 32) LoadDataWithTranspose(b2[kk * WIDTH], weight_[(base + kk) * 32], bl);
      a2b.EnQue(a2);
      b2b.EnQue(b2);
      a2 = a2b.DeQue<int8_t>();
      b2 = b2b.DeQue<int8_t>();
      MmadParams mad{};
      mad.m = paddedM_;
      mad.n = WIDTH;
      mad.k = INNER_K;
      mad.cmatrixInitVal = base == 0;
      Mmad(c1, a2, b2, mad);
      PipeBarrier<PIPE_M>();
      a2b.FreeTensor(a2);
      b2b.FreeTensor(b2);
      a1b.FreeTensor(a1);
    }
    c1b.EnQue(c1);
    c1 = c1b.DeQue<int32_t>();
    FixpipeParamsV220 fix{};
    fix.nSize = WIDTH;
    fix.mSize = rows_;
    fix.srcStride = paddedM_;
    fix.dstStride = WIDTH;
    Fixpipe<int32_t, int32_t, CFG_ROW_MAJOR>(result, c1, fix);
    c1b.FreeTensor(c1);
  }
  __aicore__ inline void End() {
    if (loaded_) {
      b1b.FreeTensor(weight_);
      loaded_ = false;
    }
  }

private:
  __aicore__ inline void CopyA(uint32_t base) {
    using namespace AscendC;
    uint32_t chunk = k_ - base < INNER_K ? k_ - base : INNER_K;
    auto a1 = a1b.AllocTensor<int8_t>();
    if (rows_ != paddedM_ || chunk != INNER_K) {
      InitConstValue(a1.ReinterpretCast<uint32_t>(), InitConstValueParams<uint32_t>{1, uint16_t(paddedM_ * INNER_K / 32), 0, 0});
      PipeBarrier<PIPE_MTE2>();
    }
    Nd2NzParams ap{};
    ap.ndNum = 1;
    ap.nValue = rows_;
    ap.dValue = chunk;
    ap.srcDValue = k_;
    ap.dstNzC0Stride = paddedM_;
    ap.dstNzNStride = 1;
    DataCopy(a1, x_[base], ap);
    a1b.EnQue(a1);
  }
  AscendC::TQue<AscendC::TPosition::A1, 2> a1b;
  AscendC::TQue<AscendC::TPosition::B1, 1> b1b;
  AscendC::TQue<AscendC::TPosition::A2, 2> a2b;
  AscendC::TQue<AscendC::TPosition::B2, 2> b2b;
  AscendC::TQue<AscendC::TPosition::CO1, 1> c1b;
  AscendC::LocalTensor<int8_t> weight_;
  AscendC::GlobalTensor<int8_t> x_;
  uint32_t k_ = 0, paddedK_ = 0, rows_ = 0, paddedM_ = 0;
  bool loaded_ = false;
};

__aicore__ inline void GmgComputeGemvCube(GM_ADDR x, GM_ADDR w, GM_ADDR scale, GM_ADDR groups, GM_ADDR y, GM_ADDR workspace, const GmgTiling &t) {
  constexpr uint32_t BM = 64, BN = 32, ELEMS = BM * BN, VELEMS = 64;
  TPipe pipe;
  uint32_t core = GetBlockIdx() / GetTaskRation();
  GlobalTensor<int8_t> xg, wg;
  GlobalTensor<int64_t> gg;
  GlobalTensor<int32_t> cg;
  GlobalTensor<float> sg;
  GlobalTensor<half> yg;
  xg.SetGlobalBuffer((__gm__ int8_t *)x);
  wg.SetGlobalBuffer((__gm__ int8_t *)w);
  gg.SetGlobalBuffer((__gm__ int64_t *)groups);
  sg.SetGlobalBuffer((__gm__ float *)scale);
  yg.SetGlobalBuffer((__gm__ half *)y);
  cg.SetGlobalBuffer((__gm__ int32_t *)workspace + core * ELEMS * 2);
  uint32_t paddedK = (t.k + 255) / 256 * 256;
  GM_ADDR packedWeight = workspace + uint64_t(t.blocks) * ELEMS * 2 * 4 + uint64_t(core) * paddedK * 32;
#if defined(SPLIT_CORE_CUBE)
  GlobalTensor<int8_t> packedWeightGm;
  packedWeightGm.SetGlobalBuffer((__gm__ int8_t *)packedWeight);
  GmgGemvWeightCube mm;
  mm.Init(pipe, t.k);
  CrossCoreWaitFlag<2>(2);
#endif
#if defined(SPLIT_CORE_VEC)
  GmgSingleColumnPacker packer;
  packer.Init(w, packedWeight, t.k, pipe);
  TBuf<TPosition::VECCALC> zeroBuffer, sparseBuffer, packedBuffer, indexBuffer, zb, ub, vb, pb, hb, mb1, mb2;
  pipe.InitBuffer(zeroBuffer, ELEMS / 2 * 4);
  pipe.InitBuffer(sparseBuffer, VELEMS * 8 * 4);
  pipe.InitBuffer(packedBuffer, VELEMS * 4);
  pipe.InitBuffer(indexBuffer, VELEMS * 4);
  pipe.InitBuffer(zb, VELEMS * 4);
  pipe.InitBuffer(ub, VELEMS * 4);
  pipe.InitBuffer(vb, VELEMS * 4);
  pipe.InitBuffer(pb, VELEMS * 4);
  pipe.InitBuffer(hb, VELEMS * 2);
  pipe.InitBuffer(mb1, 32);
  pipe.InitBuffer(mb2, 32);
  auto zero = zeroBuffer.Get<int32_t>();
  auto sparse = sparseBuffer.Get<int32_t>();
  auto packed = packedBuffer.Get<int32_t>();
  auto offsets = indexBuffer.Get<int32_t>();
  auto z = zb.Get<float>();
  auto u = ub.Get<float>();
  auto v = vb.Get<float>();
  auto p = pb.Get<float>();
  auto h = hb.Get<half>();
  auto mask1 = mb1.Get<uint8_t>();
  auto mask2 = mb2.Get<uint8_t>();
  GmgIndex(offsets, VELEMS);
  Muls(offsets, offsets, int32_t(32), VELEMS);
  Duplicate(zero, int32_t(0), ELEMS / 2);
  SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
  WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
  for (uint32_t slot = 0; slot < 2; ++slot) DataCopy(cg[slot * ELEMS + GetSubBlockIdx() * (ELEMS / 2)], zero, ELEMS / 2);
  CrossCoreSetFlag<2, PIPE_MTE3>(2);
#endif

  uint32_t firstExpert = GmgFirstExpert(gg, t.e), total = 0, previous = 0;
  for (uint32_t expert = firstExpert; expert < t.e; ++expert) {
    uint32_t end = gg.GetValue(expert);
    total += (end - previous + BM - 1) / BM;
    previous = end;
    if (end == t.m) break;
  }
  uint32_t next = total * core / t.blocks, stop = total * (core + 1) / t.blocks;
  uint32_t taskBase = 0, prev = 0, done = 0, loadedExpert = t.e;
  for (uint32_t expert = firstExpert; expert < t.e && next < stop; ++expert) {
    uint32_t end = gg.GetValue(expert), length = end - prev, tiles = (length + BM - 1) / BM;
    for (; next < taskBase + tiles && next < stop; ++next) {
      uint32_t local = next - taskBase, mr = local * BM;
      uint32_t rows = length - mr < BM ? length - mr : BM;
#if defined(SPLIT_CORE_CUBE)
      if (done >= 2) {
        if (done & 1)
          CrossCoreWaitFlag<2>(4);
        else
          CrossCoreWaitFlag<2>(1);
      }
      if (loadedExpert != expert) {
        CrossCoreWaitFlag<2>(5);
        mm.SetWeight(packedWeightGm);
        loadedExpert = expert;
      }
      mm.Tile(xg[uint64_t(prev + mr) * t.k], rows, cg[(done & 1) * ELEMS]);
      if (done & 1)
        CrossCoreSetFlag<2, PIPE_FIX>(3);
      else
        CrossCoreSetFlag<2, PIPE_FIX>(0);
#endif
#if defined(SPLIT_CORE_VEC)
      if (loadedExpert != expert) {
        packer.Pack(expert);
        loadedExpert = expert;
      }
      uint32_t part = (rows + 1) / 2, rowOffset = GetSubBlockIdx() * part;
      uint32_t count = rows > rowOffset ? (rows - rowOffset < part ? rows - rowOffset : part) : 0;
      Duplicate(sparse, int32_t(0), VELEMS * 8);
      SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
      WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
      if (done & 1)
        CrossCoreWaitFlag<2>(3);
      else
        CrossCoreWaitFlag<2>(0);
      if (count)
        DataCopyPad(sparse, cg[(done & 1) * ELEMS + rowOffset * BN], DataCopyExtParams{uint16_t(count), 4, (BN - 1) * 4, 0, 0},
          DataCopyPadExtParams<int32_t>{true, 0, 7, 0});
      SetFlag<HardEvent::MTE2_S>(EVENT_ID0);
      WaitFlag<HardEvent::MTE2_S>(EVENT_ID0);
      if (done & 1)
        CrossCoreSetFlag<2, PIPE_MTE2>(4);
      else
        CrossCoreSetFlag<2, PIPE_MTE2>(1);
      if (count) {
        SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
        WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
        Gather(packed.ReinterpretCast<uint32_t>(), sparse.ReinterpretCast<uint32_t>(), offsets.ReinterpretCast<uint32_t>(), 0, VELEMS);
        Cast(z, packed, RoundMode::CAST_RINT, VELEMS);
        Muls(z, z, sg.GetValue(expert), VELEMS);
        GmgGelu(z, h, u, v, p, packed, mask1, mask2, VELEMS);
        SetFlag<HardEvent::S_MTE3>(EVENT_ID0);
        WaitFlag<HardEvent::S_MTE3>(EVENT_ID0);
        SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
        WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
        DataCopyPad(yg[prev + mr + rowOffset], h, DataCopyExtParams{1, count * 2, 0, 0, 0});
        SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
        WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
      }
#endif
      ++done;
    }
    taskBase += tiles;
    prev = end;
    if (end == t.m) break;
  }
#if defined(SPLIT_CORE_CUBE)
  if (done > 1) CrossCoreWaitFlag<2>(4);
  if (done) CrossCoreWaitFlag<2>(1);
  mm.End();
#endif
}

class GmgGemvK512Cube {
public:
  static constexpr uint32_t HEIGHT = 64, WIDTH = 32, INNER_K = 512, MAX_K = 8192;
  __aicore__ inline void Init(AscendC::TPipe &pipe, uint32_t k) {
    k_ = k;
    paddedK_ = (k + 255) / 256 * 256;
    pipe.InitBuffer(a1b, 2, HEIGHT * INNER_K);
    pipe.InitBuffer(b1b, 1, MAX_K * WIDTH);
    pipe.InitBuffer(a2b, 2, HEIGHT * INNER_K);
    pipe.InitBuffer(b2b, 2, INNER_K * WIDTH);
    pipe.InitBuffer(c1b, 1, HEIGHT * WIDTH * 4);
  }
  __aicore__ inline void SetWeight(AscendC::GlobalTensor<int8_t> w) {
    using namespace AscendC;
    if (loaded_) b1b.FreeTensor(weight_);
    auto b1 = b1b.AllocTensor<int8_t>();

    DataCopy(b1, w, paddedK_ * WIDTH);
    b1b.EnQue(b1);
    weight_ = b1b.DeQue<int8_t>();
    loaded_ = true;
  }
  __aicore__ inline void Tile(AscendC::GlobalTensor<int8_t> x, uint32_t rows, AscendC::GlobalTensor<int32_t> result) {
    using namespace AscendC;
    x_ = x;
    rows_ = rows;
    paddedM_ = (rows + 15) / 16 * 16;
    auto c1 = c1b.AllocTensor<int32_t>();
    CopyA(0, paddedK_ < INNER_K ? paddedK_ : INNER_K);
    for (uint32_t base = 0; base < paddedK_;) {
      uint32_t step = paddedK_ - base < INNER_K ? paddedK_ - base : INNER_K;
      auto a1 = a1b.DeQue<int8_t>();
      if (base + step < paddedK_) {
        uint32_t rest = paddedK_ - base - step;
        CopyA(base + step, rest < INNER_K ? rest : INNER_K);
      }
      auto a2 = a2b.AllocTensor<int8_t>();
      auto b2 = b2b.AllocTensor<int8_t>();
      LoadData2dParams al{};
      al.repeatTimes = step / 32;
      al.srcStride = paddedM_ / 16;
      for (uint32_t row = 0; row < paddedM_; row += 16) LoadData(a2[row * step], a1[row * 32], al);
      LoadData2dTransposeParams bl{};
      bl.repeatTimes = 1;
      bl.srcStride = paddedK_ / 32;
      bl.dstGap = 1;
      for (uint32_t kk = 0; kk < step; kk += 32) LoadDataWithTranspose(b2[kk * WIDTH], weight_[(base + kk) * 32], bl);
      a2b.EnQue(a2);
      b2b.EnQue(b2);
      a2 = a2b.DeQue<int8_t>();
      b2 = b2b.DeQue<int8_t>();
      MmadParams mad{};
      mad.m = paddedM_;
      mad.n = WIDTH;
      mad.k = step;
      mad.cmatrixInitVal = base == 0;
      Mmad(c1, a2, b2, mad);
      PipeBarrier<PIPE_M>();
      a2b.FreeTensor(a2);
      b2b.FreeTensor(b2);
      a1b.FreeTensor(a1);
      base += step;
    }
    c1b.EnQue(c1);
    c1 = c1b.DeQue<int32_t>();
    FixpipeParamsV220 fix{};
    fix.nSize = WIDTH;
    fix.mSize = rows_;
    fix.srcStride = paddedM_;
    fix.dstStride = WIDTH;
    Fixpipe<int32_t, int32_t, CFG_ROW_MAJOR>(result, c1, fix);
    c1b.FreeTensor(c1);
  }
  __aicore__ inline void End() {
    if (loaded_) {
      b1b.FreeTensor(weight_);
      loaded_ = false;
    }
  }

private:
  __aicore__ inline void CopyA(uint32_t base, uint32_t step) {
    using namespace AscendC;
    uint32_t chunk = k_ - base < step ? k_ - base : step;
    auto a1 = a1b.AllocTensor<int8_t>();
    if (rows_ != paddedM_ || chunk != step) {
      InitConstValue(a1.ReinterpretCast<uint32_t>(), InitConstValueParams<uint32_t>{1, uint16_t(paddedM_ * step / 32), 0, 0});
      PipeBarrier<PIPE_MTE2>();
    }
    Nd2NzParams ap{};
    ap.ndNum = 1;
    ap.nValue = rows_;
    ap.dValue = chunk;
    ap.srcDValue = k_;
    ap.dstNzC0Stride = paddedM_;
    ap.dstNzNStride = 1;
    DataCopy(a1, x_[base], ap);
    a1b.EnQue(a1);
  }
  AscendC::TQue<AscendC::TPosition::A1, 2> a1b;
  AscendC::TQue<AscendC::TPosition::B1, 1> b1b;
  AscendC::TQue<AscendC::TPosition::A2, 2> a2b;
  AscendC::TQue<AscendC::TPosition::B2, 2> b2b;
  AscendC::TQue<AscendC::TPosition::CO1, 1> c1b;
  AscendC::LocalTensor<int8_t> weight_;
  AscendC::GlobalTensor<int8_t> x_;
  uint32_t k_ = 0, paddedK_ = 0, rows_ = 0, paddedM_ = 0;
  bool loaded_ = false;
};

__aicore__ inline void GmgComputeGemvK512(GM_ADDR x, GM_ADDR w, GM_ADDR scale, GM_ADDR groups, GM_ADDR y, GM_ADDR workspace, const GmgTiling &t) {
  constexpr uint32_t BM = 64, BN = 32, ELEMS = BM * BN, VELEMS = 64;
  TPipe pipe;
  uint32_t core = GetBlockIdx() / GetTaskRation();
  GlobalTensor<int8_t> xg, wg;
  GlobalTensor<int64_t> gg;
  GlobalTensor<int32_t> cg;
  GlobalTensor<float> sg;
  GlobalTensor<half> yg;
  xg.SetGlobalBuffer((__gm__ int8_t *)x);
  wg.SetGlobalBuffer((__gm__ int8_t *)w);
  gg.SetGlobalBuffer((__gm__ int64_t *)groups);
  sg.SetGlobalBuffer((__gm__ float *)scale);
  yg.SetGlobalBuffer((__gm__ half *)y);
  cg.SetGlobalBuffer((__gm__ int32_t *)workspace + core * ELEMS * 2);
  uint32_t paddedK = (t.k + 255) / 256 * 256;
  GM_ADDR packedWeight = workspace + uint64_t(t.blocks) * ELEMS * 2 * 4 + uint64_t(core) * paddedK * 32;
#if defined(SPLIT_CORE_CUBE)
  GlobalTensor<int8_t> packedWeightGm;
  packedWeightGm.SetGlobalBuffer((__gm__ int8_t *)packedWeight);
  GmgGemvK512Cube mm;
  mm.Init(pipe, t.k);
  CrossCoreWaitFlag<2>(2);
#endif
#if defined(SPLIT_CORE_VEC)
  GmgSingleColumnPacker packer;
  packer.Init(w, packedWeight, t.k, pipe);
  TBuf<TPosition::VECCALC> zeroBuffer, sparseBuffer, packedBuffer, indexBuffer, zb, ub, vb, pb, hb, mb1, mb2;
  pipe.InitBuffer(zeroBuffer, ELEMS / 2 * 4);
  pipe.InitBuffer(sparseBuffer, VELEMS * 8 * 4);
  pipe.InitBuffer(packedBuffer, VELEMS * 4);
  pipe.InitBuffer(indexBuffer, VELEMS * 4);
  pipe.InitBuffer(zb, VELEMS * 4);
  pipe.InitBuffer(ub, VELEMS * 4);
  pipe.InitBuffer(vb, VELEMS * 4);
  pipe.InitBuffer(pb, VELEMS * 4);
  pipe.InitBuffer(hb, VELEMS * 2);
  pipe.InitBuffer(mb1, 32);
  pipe.InitBuffer(mb2, 32);
  auto zero = zeroBuffer.Get<int32_t>();
  auto sparse = sparseBuffer.Get<int32_t>();
  auto packed = packedBuffer.Get<int32_t>();
  auto offsets = indexBuffer.Get<int32_t>();
  auto z = zb.Get<float>();
  auto u = ub.Get<float>();
  auto v = vb.Get<float>();
  auto p = pb.Get<float>();
  auto h = hb.Get<half>();
  auto mask1 = mb1.Get<uint8_t>();
  auto mask2 = mb2.Get<uint8_t>();
  GmgIndex(offsets, VELEMS);
  Muls(offsets, offsets, int32_t(32), VELEMS);
  Duplicate(zero, int32_t(0), ELEMS / 2);
  SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
  WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
  for (uint32_t slot = 0; slot < 2; ++slot) DataCopy(cg[slot * ELEMS + GetSubBlockIdx() * (ELEMS / 2)], zero, ELEMS / 2);
  CrossCoreSetFlag<2, PIPE_MTE3>(2);
#endif

  uint32_t firstExpert = GmgFirstExpert(gg, t.e), total = 0, previous = 0;
  for (uint32_t expert = firstExpert; expert < t.e; ++expert) {
    uint32_t end = gg.GetValue(expert);
    total += (end - previous + BM - 1) / BM;
    previous = end;
    if (end == t.m) break;
  }
  uint32_t next = total * core / t.blocks, stop = total * (core + 1) / t.blocks;
  uint32_t taskBase = 0, prev = 0, done = 0, loadedExpert = t.e;
  for (uint32_t expert = firstExpert; expert < t.e && next < stop; ++expert) {
    uint32_t end = gg.GetValue(expert), length = end - prev, tiles = (length + BM - 1) / BM;
    for (; next < taskBase + tiles && next < stop; ++next) {
      uint32_t local = next - taskBase, mr = local * BM;
      uint32_t rows = length - mr < BM ? length - mr : BM;
#if defined(SPLIT_CORE_CUBE)
      if (done >= 2) {
        if (done & 1)
          CrossCoreWaitFlag<2>(4);
        else
          CrossCoreWaitFlag<2>(1);
      }
      if (loadedExpert != expert) {
        CrossCoreWaitFlag<2>(5);
        mm.SetWeight(packedWeightGm);
        loadedExpert = expert;
      }
      mm.Tile(xg[uint64_t(prev + mr) * t.k], rows, cg[(done & 1) * ELEMS]);
      if (done & 1)
        CrossCoreSetFlag<2, PIPE_FIX>(3);
      else
        CrossCoreSetFlag<2, PIPE_FIX>(0);
#endif
#if defined(SPLIT_CORE_VEC)
      if (loadedExpert != expert) {
        packer.Pack(expert);
        loadedExpert = expert;
      }
      uint32_t part = (rows + 1) / 2, rowOffset = GetSubBlockIdx() * part;
      uint32_t count = rows > rowOffset ? (rows - rowOffset < part ? rows - rowOffset : part) : 0;
      Duplicate(sparse, int32_t(0), VELEMS * 8);
      SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
      WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
      if (done & 1)
        CrossCoreWaitFlag<2>(3);
      else
        CrossCoreWaitFlag<2>(0);
      if (count)
        DataCopyPad(sparse, cg[(done & 1) * ELEMS + rowOffset * BN], DataCopyExtParams{uint16_t(count), 4, (BN - 1) * 4, 0, 0},
          DataCopyPadExtParams<int32_t>{true, 0, 7, 0});
      SetFlag<HardEvent::MTE2_S>(EVENT_ID0);
      WaitFlag<HardEvent::MTE2_S>(EVENT_ID0);
      if (done & 1)
        CrossCoreSetFlag<2, PIPE_MTE2>(4);
      else
        CrossCoreSetFlag<2, PIPE_MTE2>(1);
      if (count) {
        SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
        WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
        Gather(packed.ReinterpretCast<uint32_t>(), sparse.ReinterpretCast<uint32_t>(), offsets.ReinterpretCast<uint32_t>(), 0, VELEMS);
        Cast(z, packed, RoundMode::CAST_RINT, VELEMS);
        Muls(z, z, sg.GetValue(expert), VELEMS);
        GmgGelu(z, h, u, v, p, packed, mask1, mask2, VELEMS);
        SetFlag<HardEvent::S_MTE3>(EVENT_ID0);
        WaitFlag<HardEvent::S_MTE3>(EVENT_ID0);
        SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
        WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
        DataCopyPad(yg[prev + mr + rowOffset], h, DataCopyExtParams{1, count * 2, 0, 0, 0});
        SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
        WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
      }
#endif
      ++done;
    }
    taskBase += tiles;
    prev = end;
    if (end == t.m) break;
  }
#if defined(SPLIT_CORE_CUBE)
  if (done > 1) CrossCoreWaitFlag<2>(4);
  if (done) CrossCoreWaitFlag<2>(1);
  mm.End();
#endif
}

#if !defined(GMG_SEPARATE_BUILD) || defined(GMG_BUILD_GEMV_K512)
extern "C" __global__ __mix__(1, 2) void groupmatmulgelu_gemv_k512(
  GM_ADDR x, GM_ADDR w, GM_ADDR scale, GM_ADDR groups, GM_ADDR y, GM_ADDR workspace, GmgTiling t) {
  GmgComputeGemvK512(x, w, scale, groups, y, workspace, t);
}
#endif

#if !defined(GMG_SEPARATE_BUILD) || defined(GMG_BUILD_GEMV_CUBE)
extern "C" __global__ __mix__(1, 2) void groupmatmulgelu_gemv_cube(
  GM_ADDR x, GM_ADDR w, GM_ADDR scale, GM_ADDR groups, GM_ADDR y, GM_ADDR workspace, GmgTiling t) {
  GmgComputeGemvCube(x, w, scale, groups, y, workspace, t);
}
#endif

__aicore__ inline bool GmgLongExpertTall(uint32_t rows, uint32_t n, uint32_t oldNt, uint32_t newNt) {
  if (rows <= 64) return false;
  const uint32_t oldMt = (rows + 63) / 64, newMt = (rows + 127) / 128;
  if (uint64_t(newMt) * newNt > uint64_t(oldMt) * oldNt) return false;
  return uint64_t(rows) * newNt + uint64_t(n) * newMt < uint64_t(rows) * oldNt + uint64_t(n) * oldMt;
}

#if !defined(GMG_SEPARATE_BUILD) || defined(GMG_BUILD_DENSE)
extern "C" __global__ __mix__(1, 2) void groupmatmulgelu(GM_ADDR x, GM_ADDR w, GM_ADDR scale, GM_ADDR groups, GM_ADDR y, GM_ADDR workspace, GmgTiling t) {
  if (t.bm == 32 && t.bn == 64) {
    if (t.n >= 16 && t.n % 32 != 0 && t.k >= 1024)
      GmgCompute<32, 64, true>(x, w, scale, groups, y, workspace, t);
    else
      GmgCompute<32, 64>(x, w, scale, groups, y, workspace, t);
  } else if (t.bm == 32 && t.bn == 128)
    GmgCompute<32, 128>(x, w, scale, groups, y, workspace, t);
  else if (t.bm == 64 && t.bn == 128)
    GmgCompute<64, 128>(x, w, scale, groups, y, workspace, t);
  else
    GmgCompute<64, 256>(x, w, scale, groups, y, workspace, t);
}
#endif

__aicore__ inline void GmgRowCompactTiny(GM_ADDR x, GM_ADDR w, GM_ADDR scale, GM_ADDR groups, GM_ADDR y, const GmgTiling &t) {
#if defined(SPLIT_CORE_VEC) || defined(__DAV_C220_VEC__)
  // Small narrow rows use a compact UB arena and batched input copies.
  // Accumulate the complete INT8 dot product in INT32, then apply scale and GELU.
  constexpr uint32_t NLANE = 64, FP = NLANE * 4, HB = NLANE * 2;
  constexpr uint32_t XS = 64, XB = XS, WB = 8192, SB = 8192; // N1 permits a full K64 x row
  constexpr uint32_t AO = XB + WB + SB, ZO = AO + FP, UO = ZO + FP, VO = UO + FP, PO = VO + FP, HO = PO + FP;
  constexpr uint32_t DO = HO + HB + 64, DB = 64;
  AscendC::LocalTensor<uint8_t> arena(TPosition::VECCALC, 0, DO + DB);
  auto b = arena;
  auto lx = b.ReinterpretCast<int8_t>();
  auto wall = b[XB].ReinterpretCast<int8_t>();
  auto sall = b[XB + WB].ReinterpretCast<float>();
  auto a = b[AO].ReinterpretCast<int32_t>();
  auto z = b[ZO].ReinterpretCast<float>();
  auto u = b[UO].ReinterpretCast<float>();
  auto v = b[VO].ReinterpretCast<float>();
  auto p = b[PO].ReinterpretCast<float>();
  auto h = b[HO].ReinterpretCast<half>();
  auto m1 = b[HO + HB];
  auto m2 = b[HO + HB + 32];
  GlobalTensor<int8_t> gx, gw;
  GlobalTensor<int64_t> gg;
  GlobalTensor<float> gs;
  GlobalTensor<half> gy;
  gx.SetGlobalBuffer((__gm__ int8_t *)x);
  gw.SetGlobalBuffer((__gm__ int8_t *)w);
  gg.SetGlobalBuffer((__gm__ int64_t *)groups);
  gs.SetGlobalBuffer((__gm__ float *)scale);
  gy.SetGlobalBuffer((__gm__ half *)y);
  const uint32_t kn = t.k * t.n, nbytes = t.n * 2;
  // The task bounds this class by E<=128 and K*N<=64, so e*kn<=8192 and
  // e*n*4<=8192: the whole weight block and the whole scale block always fit the
  // WB/SB arena slots, i.e. the single block-wide MTE2 batch is always legal.
  const uint32_t wbytes = uint32_t(t.e) * kn, sbytes = uint32_t(t.e) * t.n * 4;
  // ---- per-block expert cursor ----------------------------------------------
  // Rows of a block are t.blocks apart; while a row is still inside the cached
  // group end the expert index cannot change, so the search is skipped.  The
  // first row of every block always resolves (end starts at 0).
  uint32_t expert = 0, end = 0;
  // The unchanged active GmgGelu reads z and writes u/p/h, so the
  // unused z tail lanes only have to be zeroed once per block instead of once per
  // row: the rung loop overwrites z[0,n) for every row and never touches [n,64).
  Duplicate(z, 0.0f, NLANE);
  SetFlag<HardEvent::V_S>(EVENT_ID0);
  WaitFlag<HardEvent::V_S>(EVENT_ID0);
  for (uint32_t row = GetBlockIdx(); row < t.m; row += t.blocks) {
    const uint64_t xoff = uint64_t(row) * t.k, yoff = uint64_t(row) * t.n;
    DataCopyPad(lx, gx[xoff], DataCopyExtParams{1, t.k, 0, 0, 0}, DataCopyPadExtParams<int8_t>{true, 0, 0, 0});
    DataCopyPad(wall, gw, DataCopyExtParams{1, wbytes, 0, 0, 0}, DataCopyPadExtParams<int8_t>{true, 0, 0, 0});
    DataCopyPad(sall, gs, DataCopyExtParams{1, sbytes, 0, 0, 0}, DataCopyPadExtParams<float>{true, 0, 0, 0});
    if (row >= end) {
      expert = GmgFindExpert(gg, row, t.e);
      end = uint32_t(gg.GetValue(expert));
    }
    const uint32_t wof = expert * kn, sof = expert * t.n;
    SetFlag<HardEvent::MTE2_S>(EVENT_ID0);
    WaitFlag<HardEvent::MTE2_S>(EVENT_ID0);
    uint32_t col = 0;
    for (; col + 4 <= t.n; col += 4) {
      int32_t s0 = 0, s1 = 0, s2 = 0, s3 = 0;
      for (uint32_t k = 0, offset = col; k < t.k; ++k, offset += t.n) {
        const int32_t v = int32_t(lx.GetValue(k));
        s0 += v * int32_t(wall.GetValue(wof + offset));
        s1 += v * int32_t(wall.GetValue(wof + offset + 1));
        s2 += v * int32_t(wall.GetValue(wof + offset + 2));
        s3 += v * int32_t(wall.GetValue(wof + offset + 3));
      }
      z.SetValue(col, float(s0) * sall.GetValue(sof + col));
      z.SetValue(col + 1, float(s1) * sall.GetValue(sof + col + 1));
      z.SetValue(col + 2, float(s2) * sall.GetValue(sof + col + 2));
      z.SetValue(col + 3, float(s3) * sall.GetValue(sof + col + 3));
    }
    // 2-column rung: n%4 == 2 or 3 (n = 6,7,10,11,14,15 in this class)
    for (; col + 2 <= t.n; col += 2) {
      int32_t s0 = 0, s1 = 0;
      for (uint32_t k = 0, offset = col; k < t.k; ++k, offset += t.n) {
        const int32_t v = int32_t(lx.GetValue(k));
        s0 += v * int32_t(wall.GetValue(wof + offset));
        s1 += v * int32_t(wall.GetValue(wof + offset + 1));
      }
      z.SetValue(col, float(s0) * sall.GetValue(sof + col));
      z.SetValue(col + 1, float(s1) * sall.GetValue(sof + col + 1));
    }
    if ((t.k & 1U) == 0U) {
      // even k: the 1-column rung takes two k steps per trip, so the single
      // dot chain issues two independent product+add pairs (still exact).
      for (; col < t.n; ++col) {
        int32_t sum = 0;
        for (uint32_t k = 0, offset = col; k < t.k; k += 2, offset += 2 * t.n)
          sum += int32_t(lx.GetValue(k)) * int32_t(wall.GetValue(wof + offset)) + int32_t(lx.GetValue(k + 1)) * int32_t(wall.GetValue(wof + offset + t.n));
        z.SetValue(col, float(sum) * sall.GetValue(sof + col));
      }
    } else {
      for (; col < t.n; ++col) {
        int32_t sum = 0;
        for (uint32_t k = 0, offset = col; k < t.k; ++k, offset += t.n) sum += int32_t(lx.GetValue(k)) * int32_t(wall.GetValue(wof + offset));
        z.SetValue(col, float(sum) * sall.GetValue(sof + col));
      }
    }
    SetFlag<HardEvent::S_V>(EVENT_ID0);
    WaitFlag<HardEvent::S_V>(EVENT_ID0);
    GmgGelu(z, h, u, v, p, a, m1, m2, NLANE);
    SetFlag<HardEvent::S_MTE3>(EVENT_ID0);
    WaitFlag<HardEvent::S_MTE3>(EVENT_ID0);
    SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
    WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
    DataCopyPad(gy[yoff], h, DataCopyExtParams{1, nbytes, 0, 0, 0});
    SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
    WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
  }
#endif
}
#if !defined(GMG_SEPARATE_BUILD) || defined(GMG_BUILD_GEMV)
extern "C" __global__ __vector__ void groupmatmulgelu_gemv(GM_ADDR x, GM_ADDR w, GM_ADDR scale, GM_ADDR groups, GM_ADDR y, GM_ADDR workspace, GmgTiling t) {

  if (t.n <= 16 && t.k * t.n <= 64 && ((t.k > 1 && t.n > 1) || ((t.n == 1 || t.k == 1) && (t.m <= t.e || t.m <= t.blocks)))) {
    GmgRowCompactTiny(x, w, scale, groups, y, t);
  } else if (t.n != 1 && t.m > t.e && t.k > 4) {

    if (t.n <= 32)
      GmgTinyPacked<32>(x, w, scale, groups, y, t);
    else
      GmgTinyPacked<64>(x, w, scale, groups, y, t);
  } else if (t.n != 1)
    GmgTiny(x, w, scale, groups, y, t);
  else if (t.k == 1 && t.m >= t.blocks * 128)
    GmgGemv<256>(x, w, scale, groups, y, t);
  else
    GmgGemv<64>(x, w, scale, groups, y, t);
}
#endif

