#if !defined(GMG_SEPARATE_BUILD) || defined(GMG_BUILD_SAFE)
extern "C" __global__ __mix__(1, 2) void groupmatmulgelu_safe(GM_ADDR x, GM_ADDR w, GM_ADDR scale, GM_ADDR groups, GM_ADDR y, GM_ADDR workspace, GmgTiling t) {
  if (t.bm == 32 && t.bn == 64)
    GmgCompute<32, 64, false, false, false, false, false, true>(x, w, scale, groups, y, workspace, t);
  else if (t.bm == 32 && t.bn == 128)
    GmgCompute<32, 128, false, false, false, false, false, true>(x, w, scale, groups, y, workspace, t);
  else if (t.bm == 64 && t.bn == 128)
    GmgCompute<64, 128, false, false, false, false, false, true>(x, w, scale, groups, y, workspace, t);
  else
    GmgCompute<64, 256, false, false, false, false, false, true>(x, w, scale, groups, y, workspace, t);
}
#endif

