template <uint32_t BM, uint32_t BN, bool MDL = false, bool REUSE = false, bool DIRECT = false, bool PADDED = false, bool GENERAL = false, bool STREAM = false,
  uint32_t DIRECT_MAX_K = 2048, bool FORCE_DOUBLE = false>
__aicore__ inline void GmgIdentity32Full(GM_ADDR x, GM_ADDR w, GM_ADDR scale, GM_ADDR groups, GM_ADDR y, GM_ADDR workspace, const GmgTiling &t) {
  static_assert(BM == 32 && BN == 32 && DIRECT && !MDL && !REUSE && !PADDED && !GENERAL && !STREAM && !FORCE_DOUBLE, "single-C0 full-K path");
  constexpr uint32_t ELEMS = BM * BN, VR = 2, VELEMS = (BM > 64 ? 64 : BM) * BN / VR;
  constexpr bool DOUBLE_C = true;
  static_assert(
    !FORCE_DOUBLE || (BM == 64 && BN == 256 && DIRECT && !GENERAL && !REUSE && !PADDED && !STREAM), "extra C bank is restricted to direct M64/N256");
  TPipe pipe;
  const uint32_t core = GetBlockIdx() / GetTaskRation();
  typename Conditional<PADDED, GmgWordWeightPacker, GmgNoWeightPacker>::type packer;
  if constexpr (PADDED) {
    auto padded = workspace + uint64_t(t.blocks) * t.bm * t.bn * 4 + uint64_t(core) * ((t.k + 511) / 512 * 512) * ((t.n + 31) / 32 * 32);
    packer.Init(w, padded, t, pipe);
    w = padded;
  }
  GlobalTensor<int8_t> xg, wg;
  GlobalTensor<int64_t> gg;
  GlobalTensor<float> sg;
  GlobalTensor<half> yg;
  GlobalTensor<int32_t> cg;
  xg.SetGlobalBuffer((__gm__ int8_t *)x);
  wg.SetGlobalBuffer((__gm__ int8_t *)w);
  gg.SetGlobalBuffer((__gm__ int64_t *)groups);
  sg.SetGlobalBuffer((__gm__ float *)scale);
  yg.SetGlobalBuffer((__gm__ half *)y);
  cg.SetGlobalBuffer((__gm__ int32_t *)workspace + core * ELEMS * ((DOUBLE_C || (REUSE && GENERAL)) ? 2 : 1));

#if defined(SPLIT_CORE_CUBE)
  if constexpr (!DIRECT && !STREAM) GmgPrepareL1(pipe, t);
  using CubeOp = GmgIdentityStream32Cube<false, 32, 32, 8192, 2>;
  CubeOp mm;
  mm.Init(&t.cube, &pipe);
  mm.SetOrgShape(REUSE ? t.m : BM, PADDED ? (t.n + 31) / 32 * 32 : t.n, t.k, t.k, BN);
  CrossCoreWaitFlag<2>(2);
#endif

#if defined(SPLIT_CORE_VEC)
  TBuf<TPosition::VECCALC> ab, zb, ub, vb, pb, sb, hb, maskb1, maskb2, groupBuffer;
  pipe.InitBuffer(ab, (VELEMS * 4) + 256);
  pipe.InitBuffer(zb, (VELEMS * 4) + 256);
  pipe.InitBuffer(ub, (VELEMS * 4) + 256);
  pipe.InitBuffer(vb, (VELEMS * 4) + 256);
  pipe.InitBuffer(pb, (VELEMS * 4) + 256);
  pipe.InitBuffer(sb, (BN * 4) + 256);
  pipe.InitBuffer(hb, (VELEMS * 2) + 256);
  pipe.InitBuffer(maskb1, (VELEMS / 8) + 256);
  pipe.InitBuffer(maskb2, (VELEMS / 8) + 256);
  auto a = ab.Get<int32_t>();
  auto z = zb.Get<float>();
  auto u = ub.Get<float>();
  auto v = vb.Get<float>();
  auto p = pb.Get<float>();
  auto s = sb.Get<float>();
  auto h = hb.Get<half>();
  auto mask1 = maskb1.Get<uint8_t>();
  auto mask2 = maskb2.Get<uint8_t>();

  LocalTensor<int64_t> localGroups;
  bool useLocalGroups = false;
  if constexpr ((DIRECT && BN == 256 && !GENERAL) || (REUSE && GENERAL)) {
    pipe.InitBuffer(groupBuffer, 128 * 8);
    localGroups = groupBuffer.Get<int64_t>();
    useLocalGroups = t.e >= 16;
    if (useLocalGroups) {
      GlobalTensor<int32_t> groupWords;
      groupWords.SetGlobalBuffer((__gm__ int32_t *)groups);
      DataCopyPad(groupBuffer.Get<int32_t>(), groupWords, DataCopyExtParams{1, t.e * 8, 0, 0, 0},
        DataCopyPadExtParams<int32_t>{true, 0, uint8_t((4 - t.e % 4) % 4 * 2), 0});
      SetFlag<HardEvent::MTE2_S>(EVENT_ID0);
      WaitFlag<HardEvent::MTE2_S>(EVENT_ID0);
    }
  }

  Duplicate(a, int32_t(0), VELEMS);
  SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
  WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
  if constexpr (DOUBLE_C) {
    for (uint32_t slot = 0; slot < 2; ++slot)
      for (uint32_t offset = 0; offset < ELEMS / VR; offset += VELEMS) DataCopy(cg[slot * ELEMS + GetSubBlockIdx() * (ELEMS / VR) + offset], a, VELEMS);
  } else
    DataCopy(cg[GetSubBlockIdx() * VELEMS], a, VELEMS);
  CrossCoreSetFlag<2, PIPE_MTE3>(2);
  if (t.n % BN) {
    Duplicate(s, 0.0f, BN);
    SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
    WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
  }
#endif
  uint32_t taskBase = 0, prev = 0, done = 0, nextTask = core, packedExpert = t.e;

  const uint32_t nt = BN == 64 ? 1 : (t.n + BN - 1) / BN;
#if defined(SPLIT_CORE_VEC)
  uint32_t firstExpert = useLocalGroups ? GmgFirstExpert(localGroups, t.e) : GmgFirstExpert(gg, t.e);
#else
  uint32_t firstExpert = GmgFirstExpert(gg, t.e);
#endif
  uint32_t stopTask = 0xffffffffU, runRemaining = 0;
  if constexpr (REUSE) {
    uint32_t total = 0, before = 0;
    for (uint32_t e = firstExpert; e < t.e; ++e) {
      uint32_t end =
#if defined(SPLIT_CORE_VEC)
        useLocalGroups ? localGroups.GetValue(e) : gg.GetValue(e);
#else
        gg.GetValue(e);
#endif
      total += (end - before + BM - 1) / BM * nt;
      before = end;
      if (end == t.m) break;
    }
    nextTask = total * core / t.blocks;
    stopTask = total * (core + 1) / t.blocks;
  }
  for (uint32_t e = firstExpert; e < t.e; ++e) {
    uint32_t end =
#if defined(SPLIT_CORE_VEC)
      useLocalGroups ? localGroups.GetValue(e) : gg.GetValue(e);
#else
      gg.GetValue(e);
#endif
    uint32_t len = end - prev, mt = (len + BM - 1) / BM;
    uint32_t tasks = mt * nt;

    for (; nextTask < taskBase + tasks && nextTask < stopTask; nextTask += (REUSE ? 1 : t.blocks)) {
      uint32_t local = nextTask - taskBase;
      uint32_t mr = (BN == 64 ? local : (REUSE ? local % mt : local / nt)) * BM;
      uint32_t nc = BN == 64 ? 0 : (REUSE ? local / mt : local % nt) * BN;
      uint32_t rows = (len - mr < BM ? len - mr : BM), cols = (t.n - nc < BN ? t.n - nc : BN);
      if constexpr (PADDED)
        if (packedExpert != e) {
          packer.Pack(e, 0, t.k);
          packedExpert = e;
        }
#if defined(SPLIT_CORE_CUBE)
      if constexpr (DOUBLE_C) {
        if (done >= 2) {
          if (done & 1)
            CrossCoreWaitFlag<2>(4);
          else
            CrossCoreWaitFlag<2>(1);
        }
      } else if (done)
        CrossCoreWaitFlag<2>(1);
      {
        mm.SetSingleShape(rows, cols, t.k);
        mm.SetTensorA(xg[(uint64_t)(prev + mr) * t.k]);
        mm.SetTensorB(wg[PADDED ? 0 : (uint64_t)e * t.k * t.n + nc]);
        if constexpr (DOUBLE_C)
          mm.IterateAll(cg[(done & 1) * ELEMS]);
        else
          mm.IterateAll(cg);
        mm.End();
      }
      if constexpr (DOUBLE_C) {
        if (done & 1)
          CrossCoreSetFlag<2, PIPE_FIX>(3);
        else
          CrossCoreSetFlag<2, PIPE_FIX>(0);
      } else
        CrossCoreSetFlag<2, PIPE_FIX>(0);
#endif
#if defined(SPLIT_CORE_VEC)
      if constexpr (DOUBLE_C) {
        uint32_t vectorRows = (rows + VR - 1) / VR;
        uint32_t rowOffset = GetSubBlockIdx() * vectorRows;
        rows = rows > rowOffset ? (rows - rowOffset < vectorRows ? rows - rowOffset : vectorRows) : 0;
        if (rows) DataCopyPad(s, sg[(uint64_t)e * t.n + nc], DataCopyExtParams{1, cols * 4, 0, 0, 0}, DataCopyPadExtParams<float>{true, 0, 0, 0});
        if (done & 1)
          CrossCoreWaitFlag<2>(3);
        else
          CrossCoreWaitFlag<2>(0);
        uint32_t chunks = (rows + 31) / 32;
        if (!chunks) chunks = 1;
        for (uint32_t chunk = 0; chunk < chunks; ++chunk) {
          uint32_t first = chunk * 32;
          uint32_t currentRows = rows > first ? (rows - first < 32 ? rows - first : 32) : 0;
          if (currentRows) {
            if (cols == BN)
              DataCopy(a, cg[(done & 1) * ELEMS + (rowOffset + first) * BN], currentRows * BN);
            else
              DataCopyPad(a, cg[(done & 1) * ELEMS + (rowOffset + first) * BN],
                DataCopyExtParams{uint16_t(currentRows), cols * 4, (BN - cols) * 4, (BN - ((cols + 7) / 8 * 8)) / 8, 0},
                DataCopyPadExtParams<int32_t>{true, 0, 0, 0});
          }
          SetFlag<HardEvent::MTE2_S>(EVENT_ID0);
          WaitFlag<HardEvent::MTE2_S>(EVENT_ID0);

          if (chunk + 1 == chunks) {
            if (done & 1)
              CrossCoreSetFlag<2, PIPE_MTE2>(4);
            else
              CrossCoreSetFlag<2, PIPE_MTE2>(1);
          }
          if (currentRows) {
            SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
            WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
            uint32_t count = currentRows * BN;
            const uint32_t privateCount = (count + 63) / 64 * 64;

            Cast(z, a, RoundMode::CAST_RINT, privateCount);
            Mul(z, z, s, uint64_t(32), uint8_t(currentRows), BinaryRepeatParams{1, 1, 1, 4, 4, 0});
            if (privateCount > count) Duplicate(z[count], 0.0f, privateCount - count);
            GmgGelu(z, h, u, v, p, a, mask1, mask2, privateCount);
            SetFlag<HardEvent::S_MTE3>(EVENT_ID0);
            WaitFlag<HardEvent::S_MTE3>(EVENT_ID0);
            SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
            WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
            DataCopyPad(yg[uint64_t(prev + mr + rowOffset + first) * t.n + nc], h,
              DataCopyExtParams{uint16_t(currentRows), cols * 2, (BN - ((cols + 15) / 16 * 16)) / 16, (t.n - cols) * 2, 0});
            SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
            WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
          }
        }
      } else {
        uint32_t vectorRows = (rows + VR - 1) / VR;
        uint32_t rowOffset = GetSubBlockIdx() * vectorRows;
        rows = rows > rowOffset ? (rows - rowOffset < vectorRows ? rows - rowOffset : vectorRows) : 0;
        mr += rowOffset;

        if (rows) DataCopyPad(s, sg[(uint64_t)e * t.n + nc], DataCopyExtParams{1, cols * 4, 0, 0, 0}, DataCopyPadExtParams<float>{true, 0, 0, 0});
        CrossCoreWaitFlag<2>(0);
        if (rows) {
          if (cols == BN)
            DataCopy(a, cg[(REUSE && GENERAL ? (done & 1) * ELEMS : 0) + rowOffset * BN], rows * BN);
          else
            DataCopyPad(a, cg[(REUSE && GENERAL ? (done & 1) * ELEMS : 0) + rowOffset * ((REUSE && !GENERAL) ? cols : BN)],
              DataCopyExtParams{(uint16_t)rows, cols * 4, ((REUSE && !GENERAL) ? 0 : (BN - cols) * 4), (BN - ((cols + 7) / 8 * 8)) / 8, 0},
              DataCopyPadExtParams<int32_t>{true, 0, 0, 0});
        }
        SetFlag<HardEvent::MTE2_S>(EVENT_ID0);
        WaitFlag<HardEvent::MTE2_S>(EVENT_ID0);
        CrossCoreSetFlag<2, PIPE_MTE2>(1);
        if (rows) {
          SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
          WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
          uint32_t count = rows * BN;
          Cast(z, a, RoundMode::CAST_RINT, count);

          for (uint32_t c = 0; c < BN; c += 64) Mul(z[c], z[c], s[c], uint64_t(64), uint8_t(rows), BinaryRepeatParams{1, 1, 1, BN / 8, BN / 8, 0});
          if constexpr (REUSE || (BM == 128 && !STREAM))
            GmgGeluSmall<DIRECT && BN == 256>(z, h, u, v, p, a, mask1, mask2, count);
          else
            GmgGelu<DIRECT && BN == 256>(z, h, u, v, p, a, mask1, mask2, count);
          SetFlag<HardEvent::S_MTE3>(EVENT_ID0);
          WaitFlag<HardEvent::S_MTE3>(EVENT_ID0);
          SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
          WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
          DataCopyPad(
            yg[(uint64_t)(prev + mr) * t.n + nc], h, DataCopyExtParams{(uint16_t)rows, cols * 2, (BN - ((cols + 15) / 16 * 16)) / 16, (t.n - cols) * 2, 0});
          SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
          WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
        }
      }
#endif
      ++done;
    }
    taskBase += tasks;
    prev = end;

    if (end == t.m || (REUSE && GENERAL && nextTask >= stopTask)) break;
  }
#if defined(SPLIT_CORE_CUBE)
  if constexpr (DOUBLE_C) {

    if (done > 1) CrossCoreWaitFlag<2>(4);
    if (done) CrossCoreWaitFlag<2>(1);
  } else if (done)
    CrossCoreWaitFlag<2>(1);
#endif
}

template <bool MDL, bool PADDED = false, bool DYNAMIC = false, uint32_t PARTIAL_N = 64>
__aicore__ inline void GmgIdentity32Split(GM_ADDR x, GM_ADDR w, GM_ADDR scale, GM_ADDR groups, GM_ADDR y, GM_ADDR workspace, const GmgTiling &t) {
  static_assert(!MDL && !PADDED && DYNAMIC && PARTIAL_N == 32, "compact raw static split");
  static_assert(PARTIAL_N == 32 || PARTIAL_N == 64, "physical INT32 row width");
  static_assert(DYNAMIC || PARTIAL_N == 64, "original static path retained");
  constexpr uint32_t SM = 32, SN = PARTIAL_N, SE = SM * SN, SV = SE / 2;
  TPipe pipe;
  const uint32_t core = GetBlockIdx() / GetTaskRation();
  typename Conditional<PADDED, GmgWordWeightPacker, GmgNoWeightPacker>::type packer;
  if constexpr (PADDED) {
    auto padded = workspace + uint64_t(t.blocks) * SM * 64 * 4 + uint64_t(core) * ((t.k + 511) / 512 * 512) * ((t.n + 31) / 32 * 32);
    packer.Init(w, padded, t, pipe);
    w = padded;
  }
  const uint32_t parts = t.reserved, logical = core / parts, part = core % parts;
  constexpr uint32_t KALIGN = 512;
  const uint32_t kBlocks = (t.k + KALIGN - 1) / KALIGN;
  const uint32_t kOffset = (kBlocks * part / parts) * KALIGN;
  const uint32_t kEndAligned = (kBlocks * (part + 1) / parts) * KALIGN;
  const uint32_t innerK = (kEndAligned < t.k ? kEndAligned : t.k) - kOffset;
  GlobalTensor<int8_t> xg, wg;
  GlobalTensor<int64_t> gg;
  GlobalTensor<float> sg;
  GlobalTensor<half> yg;
  GlobalTensor<int32_t> cg;
  xg.SetGlobalBuffer((__gm__ int8_t *)x);
  wg.SetGlobalBuffer((__gm__ int8_t *)w);
  gg.SetGlobalBuffer((__gm__ int64_t *)groups);
  sg.SetGlobalBuffer((__gm__ float *)scale);
  yg.SetGlobalBuffer((__gm__ half *)y);
  cg.SetGlobalBuffer((__gm__ int32_t *)workspace);
  uint32_t prev = 0, taskBase = 0, expert = 0, mr = 0, nc = 0, rows = 0, cols = 0;

  constexpr uint32_t nt = 1;
  bool active = false;
  for (uint32_t e = GmgFirstExpert(gg, t.e); e < t.e; ++e) {
    uint32_t end = gg.GetValue(e), len = end - prev;
    uint32_t tasks = (len + SM - 1) / SM * nt;
    if (logical < taskBase + tasks) {
      uint32_t local = logical - taskBase;
      mr = local / nt * SM;
      nc = local % nt * SN;
      rows = len - mr < SM ? len - mr : SM;
      cols = t.n - nc < SN ? t.n - nc : SN;
      expert = e;
      active = true;
      break;
    }
    taskBase += tasks;
    prev = end;
  }
  if constexpr (PADDED)
    if (active) {
      if constexpr (DYNAMIC) {

        const uint32_t producerCore = taskBase * parts + part;
        auto sharedPacked = workspace + uint64_t(t.blocks) * SM * 64 * 4 + uint64_t(producerCore) * ((t.k + 511) / 512 * 512) * ((t.n + 31) / 32 * 32);
        wg.SetGlobalBuffer((__gm__ int8_t *)sharedPacked);

        if (logical == taskBase) packer.Pack(expert, kOffset, innerK);
      } else
        packer.Pack(expert, kOffset, innerK);
    }
#if defined(SPLIT_CORE_CUBE)
  using CubeOp = GmgIdentityStream32Cube<>;
  CubeOp mm;
  mm.Init(&t.cube, &pipe);
  mm.SetOrgShape(SM, PADDED ? (t.n + 31) / 32 * 32 : t.n, t.k, t.k, SN);
  CrossCoreWaitFlag<2>(2);
  if (active) {
    mm.SetSingleShape(rows, cols, innerK);
    mm.SetTensorA(xg[uint64_t(prev + mr) * t.k + kOffset]);
    mm.SetTensorB(wg[PADDED ? 0 : (uint64_t(expert) * t.k + kOffset) * t.n + nc]);
    mm.IterateAll(cg[core * SE]);
    mm.End();
  }
  CrossCoreSetFlag<0, PIPE_FIX>(6);
  CrossCoreWaitFlag<0>(6);
  CrossCoreSetFlag<2, PIPE_FIX>(0);
#endif
#if defined(SPLIT_CORE_VEC)
  TBuf<TPosition::VECCALC> ab, zb, ub, vb, pb, sb, hb, mb1, mb2;
  pipe.InitBuffer(ab, parts * SV * 4 + 256);
  pipe.InitBuffer(zb, SV * 4 + 256);
  pipe.InitBuffer(ub, SV * 4 + 256);
  pipe.InitBuffer(vb, SV * 4 + 256);
  pipe.InitBuffer(pb, SV * 4 + 256);
  pipe.InitBuffer(sb, SN * 4 + 256);
  pipe.InitBuffer(hb, SV * 2 + 256);
  pipe.InitBuffer(mb1, SV / 8 + 256);
  pipe.InitBuffer(mb2, SV / 8 + 256);
  auto a = ab.Get<int32_t>();
  auto z = zb.Get<float>();
  auto u = ub.Get<float>();
  auto v = vb.Get<float>();
  auto p = pb.Get<float>();
  auto s = sb.Get<float>();
  auto h = hb.Get<half>();
  auto mask1 = mb1.Get<uint8_t>();
  auto mask2 = mb2.Get<uint8_t>();
  Duplicate(a, int32_t(0), part == 0 ? parts * SV : SV);
  SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
  WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);

  if (part == 0 && (!DYNAMIC || logical < t.blocks / parts))
    DataCopy(cg[logical * parts * SE + GetSubBlockIdx() * SV], a, DataCopyParams{uint16_t(parts), uint16_t(SV / 8), 0, uint16_t(SV / 8)});
  CrossCoreSetFlag<0, PIPE_MTE3>(7);
  CrossCoreWaitFlag<0>(7);
  CrossCoreSetFlag<2, PIPE_MTE3>(2);
  uint32_t vectorRows = (rows + 1) / 2, rowOffset = GetSubBlockIdx() * vectorRows;
  rows = rows > rowOffset ? (rows - rowOffset < vectorRows ? rows - rowOffset : vectorRows) : 0;
  mr += rowOffset;
  if (active && part == 0 && rows) {
    Duplicate(s, 0.0f, SN);
    SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
    WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
    DataCopyPad(s, sg[uint64_t(expert) * t.n + nc], DataCopyExtParams{1, cols * 4, 0, 0, 0}, DataCopyPadExtParams<float>{true, 0, 0, 0});
  }
  CrossCoreWaitFlag<2>(0);
  if (active && part == 0 && rows) {

    uint32_t offset = logical * parts * SE + rowOffset * SN;
    DataCopy(a, cg[offset], DataCopyParams{uint16_t(parts), uint16_t(rows * SN / 8), uint16_t((SE - rows * SN) / 8), uint16_t((SV - rows * SN) / 8)});
    SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
    WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
    if constexpr (PARTIAL_N == 32) {

      const uint32_t reductionCount = (rows * SN + 63) / 64 * 64;
      for (uint32_t kPart = 1; kPart < parts; ++kPart) Add(a, a, a[kPart * SV], reductionCount);
      Cast(z, a, RoundMode::CAST_RINT, reductionCount);
    } else {
      for (uint32_t kPart = 1; kPart < parts; ++kPart) Add(a, a, a[kPart * SV], rows * SN);
      Cast(z, a, RoundMode::CAST_RINT, rows * SN);
    }
    Mul(z, z, s, uint64_t(SN), uint8_t(rows), BinaryRepeatParams{1, 1, 1, SN / 8, SN / 8, 0});
    if constexpr (PARTIAL_N == 32) {

      const uint32_t validCount = rows * SN;
      const uint32_t geluCount = (validCount + 63) / 64 * 64;
      if (geluCount > validCount) Duplicate(z[validCount], 0.0f, geluCount - validCount);
      GmgGelu(z, h, u, v, p, a, mask1, mask2, geluCount);
    } else {
      GmgGelu(z, h, u, v, p, a, mask1, mask2, rows * SN);
    }
    SetFlag<HardEvent::S_MTE3>(EVENT_ID0);
    WaitFlag<HardEvent::S_MTE3>(EVENT_ID0);
    SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
    WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
    DataCopyPad(yg[uint64_t(prev + mr) * t.n + nc], h, DataCopyExtParams{uint16_t(rows), cols * 2, (SN - ((cols + 15) / 16 * 16)) / 16, (t.n - cols) * 2, 0});
  }

#endif
}

#if !defined(GMG_SEPARATE_BUILD) || defined(GMG_BUILD_IDENTITY32_FULL)
extern "C" __global__ __mix__(1, 2) void groupmatmulgelu_identity32_full(
  GM_ADDR x, GM_ADDR w, GM_ADDR scale, GM_ADDR groups, GM_ADDR y, GM_ADDR workspace, GmgTiling t) {
  GmgIdentity32Full<32, 32, false, false, true, false, false, false, 8192, false>(x, w, scale, groups, y, workspace, t);
}
#endif
#if !defined(GMG_SEPARATE_BUILD) || defined(GMG_BUILD_IDENTITY32_SPLIT)
extern "C" __global__ __mix__(1, 2) void groupmatmulgelu_identity32_split(
  GM_ADDR x, GM_ADDR w, GM_ADDR scale, GM_ADDR groups, GM_ADDR y, GM_ADDR workspace, GmgTiling t) {
  GmgIdentity32Split<false, false, true, 32>(x, w, scale, groups, y, workspace, t);
}
#endif

#if !defined(GMG_SEPARATE_BUILD) || defined(GMG_BUILD_PANEL512)
extern "C" __global__ __mix__(1, 2) void groupmatmulgelu_panel512(
  GM_ADDR x, GM_ADDR w, GM_ADDR scale, GM_ADDR groups, GM_ADDR y, GM_ADDR workspace, GmgTiling t) {
  GmgComputeWide<64, 512, false, false, true, false, true, false, 4096, true>(x, w, scale, groups, y, workspace, t);
}
#endif

template <bool PACKED = false, uint32_t WIDTH = 64, uint32_t HEIGHT = 32, uint32_t MAX_K = 8192, uint32_t BLOCK_K = 512> class GmgFlexibleLongCube {
public:
  static constexpr uint32_t A_BYTES = 262144;
  static_assert(WIDTH == 512 && HEIGHT == 64 && MAX_K == 8192 && BLOCK_K == 256, "long-wide resource layout");
  static constexpr uint32_t INNER_K = WIDTH <= 64 ? 512 : (WIDTH <= 128 ? 256 : (WIDTH <= 256 ? 256 : 64));
  __aicore__ inline void Init(const AscendC::tiling::TCubeTiling *, AscendC::TPipe *pipe) {
    pipe->InitBuffer(a1b, 1, A_BYTES);
    pipe->InitBuffer(b1b, 2, BLOCK_K * WIDTH);
    pipe->InitBuffer(a2b, 2, HEIGHT * (WIDTH > 256 ? 256 : INNER_K));
    pipe->InitBuffer(b2b, (INNER_K * WIDTH * 2 <= 65536 ? 2 : 1), INNER_K * WIDTH);
    pipe->InitBuffer(c1b, 1, HEIGHT * WIDTH * 4);
  }
  __aicore__ inline void SetOrgShape(uint32_t, uint32_t n, uint32_t k, uint32_t, uint32_t stride) {
    n_ = n;
    kStride_ = k;
    stride_ = stride;
  }
  __aicore__ inline void SetCStride(uint32_t stride) { stride_ = stride; }
  __aicore__ inline void SetSingleShape(uint32_t rows, uint32_t cols, uint32_t k) {
    rows_ = rows;
    cols_ = cols;
    k_ = k;
  }
  __aicore__ inline void SetTensorA(AscendC::GlobalTensor<int8_t> value) { x_ = value; }
  __aicore__ inline void SetTensorB(AscendC::GlobalTensor<int8_t> value) { w_ = value; }
  __aicore__ inline void IterateAll(AscendC::GlobalTensor<int32_t> result) {
    using namespace AscendC;
    auto c1 = c1b.AllocTensor<int32_t>();
    uint32_t paddedM = (rows_ + 15) / 16 * 16, paddedN = (cols_ + 31) / 32 * 32;
    uint32_t innerK = paddedN <= 128 ? 256 : (paddedN <= 256 ? 128 : (paddedN <= 512 ? 64 : 32));

    if (paddedM > 64 && innerK > 128) innerK = 128;

    uint32_t blockK = paddedN <= 32 ? 4096 : (paddedN <= 64 ? 2048 : (paddedN <= 128 ? 1024 : (paddedN <= 256 ? 512 : (paddedN <= 512 ? 256 : 128))));
    if (paddedM > 64 && blockK > 2048) blockK = 2048;
    uint32_t paddedK = (k_ + innerK - 1) / innerK * innerK;
    const bool wholeA = paddedM * paddedK <= A_BYTES;
    if (wholeA)
      CopyA(0, k_, paddedK, paddedM);
    else
      CopyA(0, k_ < blockK ? k_ : blockK, blockK, paddedM);
    CopyWeight(0, k_ < blockK ? k_ : blockK, paddedN, innerK);
    auto a1 = a1b.DeQue<int8_t>();
    for (uint32_t base = 0; base < k_; base += blockK) {
      if (base && !wholeA) a1 = a1b.DeQue<int8_t>();
      uint32_t chunk = k_ - base < blockK ? k_ - base : blockK;
      uint32_t paddedChunk = (chunk + innerK - 1) / innerK * innerK;
      auto b1 = b1b.DeQue<int8_t>();
      if (base + blockK < k_) {
        uint32_t next = k_ - base - blockK < blockK ? k_ - base - blockK : blockK;
        CopyWeight(base + blockK, next, paddedN, innerK);
      }
      for (uint32_t inner = 0; inner < paddedChunk; inner += innerK) {
        auto a2 = a2b.AllocTensor<int8_t>();
        auto b2 = b2b.AllocTensor<int8_t>();
        LoadData2dParams al{};
        al.repeatTimes = innerK / 32;
        al.srcStride = paddedM / 16;
        for (uint32_t m = 0; m < paddedM; m += 16) LoadData(a2[m * innerK], a1[((wholeA ? base : 0) + inner) * paddedM + m * 32], al);
        LoadData2dTransposeParams bl{};
        bl.repeatTimes = paddedN / 32;
        bl.srcStride = PACKED ? 16 : paddedChunk / 32;
        bl.dstGap = 1;
        for (uint32_t kk = 0; kk < innerK; kk += 32) LoadDataWithTranspose(b2[kk * paddedN], b1[(inner + kk) * 32], bl);

        if (!wholeA && inner + innerK == paddedChunk) {
          a1b.FreeTensor(a1);
          if (base + blockK < k_) {
            uint32_t next = k_ - base - blockK < blockK ? k_ - base - blockK : blockK;
            uint32_t paddedNext = (next + innerK - 1) / innerK * innerK;
            CopyA(base + blockK, next, paddedNext, paddedM);
          }
        }
        a2b.EnQue(a2);
        b2b.EnQue(b2);
        a2 = a2b.DeQue<int8_t>();
        b2 = b2b.DeQue<int8_t>();
        MmadParams mad{};
        mad.m = paddedM;
        mad.n = paddedN;
        mad.k = innerK;
        mad.cmatrixInitVal = (base == 0 && inner == 0);
        Mmad(c1, a2, b2, mad);
        PipeBarrier<PIPE_M>();
        a2b.FreeTensor(a2);
        b2b.FreeTensor(b2);
      }
      b1b.FreeTensor(b1);
    }
    if (wholeA) a1b.FreeTensor(a1);
    c1b.EnQue(c1);
    c1 = c1b.DeQue<int32_t>();
    FixpipeParamsV220 fix{};
    fix.nSize = paddedN;
    fix.mSize = rows_;
    fix.srcStride = paddedM;
    fix.dstStride = stride_;
    Fixpipe<int32_t, int32_t, CFG_ROW_MAJOR>(result, c1, fix);
    c1b.FreeTensor(c1);
  }
  __aicore__ inline void End() {}

private:
  __aicore__ inline void CopyA(uint32_t base, uint32_t chunk, uint32_t paddedK, uint32_t paddedM) {
    using namespace AscendC;
    auto a1 = a1b.AllocTensor<int8_t>();

    PipeBarrier<PIPE_MTE2>();
    if (rows_ != paddedM || chunk != paddedK) {

      const uint32_t fullFragments = chunk / 32;
      if (rows_ != paddedM && fullFragments)
        InitConstValue(
          a1.ReinterpretCast<uint32_t>()[rows_ * 8], InitConstValueParams<uint32_t>{uint16_t(fullFragments), uint16_t(paddedM - rows_), uint16_t(rows_), 0});
      if (fullFragments * 32 < paddedK)
        InitConstValue(a1.ReinterpretCast<uint32_t>()[fullFragments * paddedM * 8],
          InitConstValueParams<uint32_t>{1, uint16_t((paddedK - fullFragments * 32) * paddedM / 32), 0, 0});
      PipeBarrier<PIPE_MTE2>();
    }
    Nd2NzParams ap{};
    ap.ndNum = 1;
    ap.nValue = rows_;
    ap.dValue = chunk;
    ap.srcDValue = kStride_;
    ap.dstNzC0Stride = paddedM;
    ap.dstNzNStride = 1;
    DataCopy(a1, x_[base], ap);
    a1b.EnQue(a1);
  }
  __aicore__ inline void CopyWeight(uint32_t base, uint32_t chunk, uint32_t paddedN, uint32_t innerK) {
    using namespace AscendC;
    auto b1 = b1b.AllocTensor<int8_t>();
    if constexpr (PACKED) {

      DataCopy(b1, w_[uint64_t(base) * n_], BLOCK_K * paddedN);
      b1b.EnQue(b1);
      return;
    }
    uint32_t paddedChunk = (chunk + innerK - 1) / innerK * innerK;

    if (chunk != paddedChunk) {
      InitConstValue(b1.ReinterpretCast<uint32_t>(), InitConstValueParams<uint32_t>{1, uint16_t(paddedChunk * paddedN / 32), 0, 0});
      PipeBarrier<PIPE_MTE2>();
    }
    Nd2NzParams bp{};
    bp.ndNum = 1;
    bp.nValue = chunk;
    bp.dValue = cols_;
    bp.srcDValue = n_;
    bp.dstNzC0Stride = paddedChunk;
    bp.dstNzNStride = 1;
    DataCopy(b1, w_[uint64_t(base) * n_], bp);
    b1b.EnQue(b1);
  }
  AscendC::TQue<AscendC::TPosition::A1, 1> a1b;
  AscendC::TQue<AscendC::TPosition::B1, 2> b1b;
  AscendC::TQue<AscendC::TPosition::A2, 2> a2b;
  AscendC::TQue<AscendC::TPosition::B2, 2> b2b;
  AscendC::TQue<AscendC::TPosition::CO1, 1> c1b;
  AscendC::GlobalTensor<int8_t> x_, w_;
  uint32_t rows_ = 0, cols_ = 0, n_ = 0, k_ = 0, kStride_ = 0, stride_ = 0;
};

template <bool PACKED = false, uint32_t WIDTH = 64, uint32_t HEIGHT = 32, uint32_t MAX_K = 8192, uint32_t BLOCK_K = 512, bool DEFER_RELEASE = false>
class GmgIndependentLongSlabCube {
public:
  static constexpr uint32_t A_BYTES = 131072;
  static_assert(WIDTH == 512 && HEIGHT == 64 && MAX_K == 8192 && BLOCK_K == 256, "long-wide resource layout");
  static constexpr uint32_t INNER_K = WIDTH <= 64 ? 512 : (WIDTH <= 128 ? 256 : (WIDTH <= 256 ? 256 : 64));
  __aicore__ inline void Init(const AscendC::tiling::TCubeTiling *, AscendC::TPipe *pipe) {
    pipe->InitBuffer(a1b, 2, A_BYTES);
    pipe->InitBuffer(b1b, 2, BLOCK_K * WIDTH);
    pipe->InitBuffer(a2b, 2, HEIGHT * (WIDTH > 256 ? 256 : INNER_K));
    pipe->InitBuffer(b2b, (INNER_K * WIDTH * 2 <= 65536 ? 2 : 1), INNER_K * WIDTH);
    pipe->InitBuffer(c1b, 1, HEIGHT * WIDTH * 4);
  }
  __aicore__ inline void SetOrgShape(uint32_t, uint32_t n, uint32_t k, uint32_t, uint32_t stride) {
    n_ = n;
    kStride_ = k;
    stride_ = stride;
  }
  __aicore__ inline void SetCStride(uint32_t stride) { stride_ = stride; }
  __aicore__ inline void SetSingleShape(uint32_t rows, uint32_t cols, uint32_t k) {
    rows_ = rows;
    cols_ = cols;
    k_ = k;
  }
  __aicore__ inline void SetTensorA(AscendC::GlobalTensor<int8_t> value) { x_ = value; }
  __aicore__ inline void SetTensorB(AscendC::GlobalTensor<int8_t> value) { w_ = value; }
  __aicore__ inline void IterateAll(AscendC::GlobalTensor<int32_t> result, uint32_t release = 0) {
    using namespace AscendC;
    auto c1 = c1b.AllocTensor<int32_t>();
    uint32_t paddedM = (rows_ + 15) / 16 * 16, paddedN = (cols_ + 31) / 32 * 32;
    uint32_t innerK = paddedN <= 128 ? 256 : (paddedN <= 256 ? 128 : (paddedN <= 512 ? 64 : 32));

    if (paddedM > 64 && innerK > 128) innerK = 128;

    uint32_t blockK = paddedN <= 32 ? 4096 : (paddedN <= 64 ? 2048 : (paddedN <= 128 ? 1024 : (paddedN <= 256 ? 512 : (paddedN <= 512 ? 256 : 128))));
    if (paddedM > 64 && blockK > 2048) blockK = 2048;
    uint32_t paddedK = (k_ + innerK - 1) / innerK * innerK;

    const uint32_t aBlock = paddedM <= 32 ? 4096 : (paddedM <= 64 ? 2048 : 1024);
    uint32_t aBase = 0;
    CopyASlab(0, aBlock, innerK, paddedM);
    CopyWeight(0, k_ < blockK ? k_ : blockK, paddedN, innerK);
    LocalTensor<int8_t> a1;
    for (uint32_t base = 0; base < k_; base += blockK) {
      uint32_t chunk = k_ - base < blockK ? k_ - base : blockK;
      uint32_t paddedChunk = (chunk + innerK - 1) / innerK * innerK;
      auto b1 = b1b.DeQue<int8_t>();
      if (base + blockK < k_) {
        uint32_t next = k_ - base - blockK < blockK ? k_ - base - blockK : blockK;
        CopyWeight(base + blockK, next, paddedN, innerK);
      }
      for (uint32_t inner = 0; inner < paddedChunk; inner += innerK) {
        const uint32_t globalK = base + inner;
        if (!(globalK & (aBlock - 1))) {
          aBase = globalK;
          a1 = a1b.DeQue<int8_t>();
          if (aBase + aBlock < k_) CopyASlab(aBase + aBlock, aBlock, innerK, paddedM);
        }
        auto a2 = a2b.AllocTensor<int8_t>();
        auto b2 = b2b.AllocTensor<int8_t>();
        LoadData2dParams al{};
        al.repeatTimes = innerK / 32;
        al.srcStride = paddedM / 16;
        for (uint32_t m = 0; m < paddedM; m += 16) LoadData(a2[m * innerK], a1[(globalK - aBase) * paddedM + m * 32], al);
        LoadData2dTransposeParams bl{};
        bl.repeatTimes = paddedN / 32;
        bl.srcStride = PACKED ? 16 : paddedChunk / 32;
        bl.dstGap = 1;
        for (uint32_t kk = 0; kk < innerK; kk += 32) LoadDataWithTranspose(b2[kk * paddedN], b1[(inner + kk) * 32], bl);

        if (globalK + innerK >= aBase + aBlock || globalK + innerK >= paddedK) a1b.FreeTensor(a1);
        a2b.EnQue(a2);
        b2b.EnQue(b2);
        a2 = a2b.DeQue<int8_t>();
        b2 = b2b.DeQue<int8_t>();
        MmadParams mad{};
        mad.m = paddedM;
        mad.n = paddedN;
        mad.k = innerK;
        mad.cmatrixInitVal = (base == 0 && inner == 0);
        Mmad(c1, a2, b2, mad);
        PipeBarrier<PIPE_M>();
        a2b.FreeTensor(a2);
        b2b.FreeTensor(b2);
      }
      b1b.FreeTensor(b1);
    }
    c1b.EnQue(c1);
    c1 = c1b.DeQue<int32_t>();
    FixpipeParamsV220 fix{};
    fix.nSize = paddedN;
    fix.mSize = rows_;
    fix.srcStride = paddedM;
    fix.dstStride = stride_;
    if constexpr (DEFER_RELEASE) {
      if (release == 4)
        CrossCoreWaitFlag<2>(4);
      else if (release == 1)
        CrossCoreWaitFlag<2>(1);
    }
    Fixpipe<int32_t, int32_t, CFG_ROW_MAJOR>(result, c1, fix);
    c1b.FreeTensor(c1);
  }
  __aicore__ inline void End() {}

private:
  __aicore__ inline void CopyASlab(uint32_t base, uint32_t capacity, uint32_t step, uint32_t paddedM) {
    const uint32_t count = k_ - base < capacity ? k_ - base : capacity;
    CopyA(base, count, (count + step - 1) / step * step, paddedM);
  }
  __aicore__ inline void CopyA(uint32_t base, uint32_t chunk, uint32_t paddedK, uint32_t paddedM) {
    using namespace AscendC;
    auto a1 = a1b.AllocTensor<int8_t>();

    PipeBarrier<PIPE_MTE2>();
    if (rows_ != paddedM || chunk != paddedK) {

      const uint32_t fullFragments = chunk / 32;
      if (rows_ != paddedM && fullFragments)
        InitConstValue(
          a1.ReinterpretCast<uint32_t>()[rows_ * 8], InitConstValueParams<uint32_t>{uint16_t(fullFragments), uint16_t(paddedM - rows_), uint16_t(rows_), 0});
      if (fullFragments * 32 < paddedK)
        InitConstValue(a1.ReinterpretCast<uint32_t>()[fullFragments * paddedM * 8],
          InitConstValueParams<uint32_t>{1, uint16_t((paddedK - fullFragments * 32) * paddedM / 32), 0, 0});
      PipeBarrier<PIPE_MTE2>();
    }
    Nd2NzParams ap{};
    ap.ndNum = 1;
    ap.nValue = rows_;
    ap.dValue = chunk;
    ap.srcDValue = kStride_;
    ap.dstNzC0Stride = paddedM;
    ap.dstNzNStride = 1;
    DataCopy(a1, x_[base], ap);
    a1b.EnQue(a1);
  }
  __aicore__ inline void CopyWeight(uint32_t base, uint32_t chunk, uint32_t paddedN, uint32_t innerK) {
    using namespace AscendC;
    auto b1 = b1b.AllocTensor<int8_t>();
    if constexpr (PACKED) {

      DataCopy(b1, w_[uint64_t(base) * n_], BLOCK_K * paddedN);
      b1b.EnQue(b1);
      return;
    }
    uint32_t paddedChunk = (chunk + innerK - 1) / innerK * innerK;

    if (chunk != paddedChunk) {
      InitConstValue(b1.ReinterpretCast<uint32_t>(), InitConstValueParams<uint32_t>{1, uint16_t(paddedChunk * paddedN / 32), 0, 0});
      PipeBarrier<PIPE_MTE2>();
    }
    Nd2NzParams bp{};
    bp.ndNum = 1;
    bp.nValue = chunk;
    bp.dValue = cols_;
    bp.srcDValue = n_;
    bp.dstNzC0Stride = paddedChunk;
    bp.dstNzNStride = 1;
    DataCopy(b1, w_[uint64_t(base) * n_], bp);
    b1b.EnQue(b1);
  }
  AscendC::TQue<AscendC::TPosition::A1, 2> a1b;
  AscendC::TQue<AscendC::TPosition::B1, 2> b1b;
  AscendC::TQue<AscendC::TPosition::A2, 2> a2b;
  AscendC::TQue<AscendC::TPosition::B2, 2> b2b;
  AscendC::TQue<AscendC::TPosition::CO1, 1> c1b;
  AscendC::GlobalTensor<int8_t> x_, w_;
  uint32_t rows_ = 0, cols_ = 0, n_ = 0, k_ = 0, kStride_ = 0, stride_ = 0;
};

template <uint32_t BM, uint32_t BN, bool MDL = false, bool REUSE = false, bool DIRECT = false, bool PADDED = false, bool GENERAL = false, bool STREAM = false,
  uint32_t DIRECT_MAX_K = 2048>
__aicore__ inline void GmgComputeIndependentLongSlab(GM_ADDR x, GM_ADDR w, GM_ADDR scale, GM_ADDR groups, GM_ADDR y, GM_ADDR workspace, const GmgTiling &t) {
  static_assert(BM == 64 && BN == 512 && DIRECT && GENERAL && !REUSE && !PADDED && !STREAM, "long-wide dispatch");
  constexpr uint32_t ELEMS = BM * BN, VR = 2, CHUNK_ROWS = 8192 / BN, VELEMS = (BM > 2 * CHUNK_ROWS ? 2 * CHUNK_ROWS : BM) * BN / VR;
  constexpr bool DOUBLE_C = (BM == 128 || BN > 256);
  constexpr uint32_t SHORT_WIDTH = ELEMS / 32;
  static_assert(SHORT_WIDTH == 1024, "short-row C bank capacity");
  TPipe pipe;
  const uint32_t core = GetBlockIdx() / GetTaskRation();
  typename Conditional<PADDED, GmgWordWeightPacker, GmgNoWeightPacker>::type packer;
  if constexpr (PADDED) {
    auto padded = workspace + uint64_t(t.blocks) * t.bm * t.bn * 4 + uint64_t(core) * ((t.k + 511) / 512 * 512) * ((t.n + 31) / 32 * 32);
    packer.Init(w, padded, t, pipe);
    w = padded;
  }
  GlobalTensor<int8_t> xg, wg;
  GlobalTensor<int64_t> gg;
  GlobalTensor<float> sg;
  GlobalTensor<half> yg;
  GlobalTensor<int32_t> cg;
  xg.SetGlobalBuffer((__gm__ int8_t *)x);
  wg.SetGlobalBuffer((__gm__ int8_t *)w);
  gg.SetGlobalBuffer((__gm__ int64_t *)groups);
  sg.SetGlobalBuffer((__gm__ float *)scale);
  yg.SetGlobalBuffer((__gm__ half *)y);
  cg.SetGlobalBuffer((__gm__ int32_t *)workspace + core * ELEMS * ((DOUBLE_C || (REUSE && GENERAL)) ? 2 : 1));

#if defined(SPLIT_CORE_CUBE)
  if constexpr (!DIRECT && !STREAM) GmgPrepareL1(pipe, t);
  typename Conditional<DIRECT, GmgIndependentLongSlabCube<false, 512, 64, 8192, 256>, GmgDirectCube>::type mm;
  mm.Init(&t.cube, &pipe);
  mm.SetOrgShape(REUSE ? t.m : BM, PADDED ? (t.n + 31) / 32 * 32 : t.n, t.k, t.k, BN);
  CrossCoreWaitFlag<2>(2);
#endif

#if defined(SPLIT_CORE_VEC)
  TBuf<TPosition::VECCALC> ab, zb, ub, vb, pb, sb, hb, maskb1, maskb2, groupBuffer;
  pipe.InitBuffer(ab, (VELEMS * 4) + 256);
  pipe.InitBuffer(zb, (VELEMS * 4) + 256);
  pipe.InitBuffer(ub, (VELEMS * 4) + 256);
  pipe.InitBuffer(vb, (VELEMS * 4) + 256);
  pipe.InitBuffer(pb, (VELEMS * 4) + 256);
  pipe.InitBuffer(sb, (SHORT_WIDTH * 4) + 256);
  pipe.InitBuffer(hb, (VELEMS * 2) + 256);
  pipe.InitBuffer(maskb1, (VELEMS / 8) + 256);
  pipe.InitBuffer(maskb2, (VELEMS / 8) + 256);
  auto a = ab.Get<int32_t>();
  auto z = zb.Get<float>();
  auto u = ub.Get<float>();
  auto v = vb.Get<float>();
  auto p = pb.Get<float>();
  auto s = sb.Get<float>();
  auto h = hb.Get<half>();
  auto mask1 = maskb1.Get<uint8_t>();
  auto mask2 = maskb2.Get<uint8_t>();

  LocalTensor<int64_t> localGroups;
  bool useLocalGroups = false;
  if constexpr ((DIRECT && BN == 256 && !GENERAL) || (REUSE && GENERAL)) {
    pipe.InitBuffer(groupBuffer, 128 * 8);
    localGroups = groupBuffer.Get<int64_t>();
    useLocalGroups = t.e >= 16;
    if (useLocalGroups) {
      GlobalTensor<int32_t> groupWords;
      groupWords.SetGlobalBuffer((__gm__ int32_t *)groups);
      DataCopyPad(groupBuffer.Get<int32_t>(), groupWords, DataCopyExtParams{1, t.e * 8, 0, 0, 0},
        DataCopyPadExtParams<int32_t>{true, 0, uint8_t((4 - t.e % 4) % 4 * 2), 0});
      SetFlag<HardEvent::MTE2_S>(EVENT_ID0);
      WaitFlag<HardEvent::MTE2_S>(EVENT_ID0);
    }
  }

  // Define both actual C staging banks before their initial ready token.
  Duplicate(a, int32_t(0), VELEMS);
  SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
  WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
  for (uint32_t bank = 0; bank < 2; ++bank)
    for (uint32_t offset = 0; offset < ELEMS / VR; offset += VELEMS) DataCopy(cg[bank * ELEMS + GetSubBlockIdx() * (ELEMS / VR) + offset], a, VELEMS);
  SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
  WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
  CrossCoreSetFlag<2, PIPE_MTE3>(2);
  {
    Duplicate(s, 0.0f, SHORT_WIDTH);
    SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
    WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
  }
#endif
  uint32_t taskBase = 0, prev = 0, done = 0, nextTask = core, packedExpert = t.e;

  uint32_t tileM = BM, tileN = BN;
#if defined(SPLIT_CORE_VEC)
  uint32_t firstExpert = useLocalGroups ? GmgFirstExpert(localGroups, t.e) : GmgFirstExpert(gg, t.e);
#else
  uint32_t firstExpert = GmgFirstExpert(gg, t.e);
#endif

  uint32_t actualM64 = 0, lastEnd = 0, maxGroup = 0;
  const uint32_t nt512 = (t.n + 511) / 512, nt256 = (t.n + 255) / 256;
  uint32_t hybridTasks512 = 0, hybridTasks256 = 0, flexTasks = 0;
  bool allNonempty = true;
  for (uint32_t expert = firstExpert; expert < t.e; ++expert) {
    uint32_t end = gg.GetValue(expert), len = end - lastEnd;
    const uint32_t m64 = (len + 63) / 64, m128 = (len + 127) / 128;
    actualM64 += m64;
    lastEnd = end;
    flexTasks +=
      len <= 32 ? ((len + 31) / 32) * ((t.n + SHORT_WIDTH - 1) / SHORT_WIDTH) : (GmgLongExpertTall(len, t.n, nt512, nt256) ? m128 * nt256 : m64 * nt512);
    hybridTasks512 += GmgLongExpertTall(len, t.n, nt512, nt256) ? m128 * nt256 : m64 * nt512;
    hybridTasks256 += GmgLongExpertTall(len, t.n, nt256, nt256) ? m128 * nt256 : m64 * nt256;
    maxGroup = maxGroup > len ? maxGroup : len;
    allNonempty &= (len != 0);
    if (end == t.m) break;
  }
  if (actualM64 * ((t.n + 511) / 512) < t.blocks) {
    tileN = 256;
    if (actualM64 * ((t.n + 255) / 256) < t.blocks) tileM = 32;
  }

  const bool flexEnabled = tileN == 512 && flexTasks >= t.blocks;
  const uint32_t nt = (t.n + tileN - 1) / tileN;

  const bool enableTall = tileM == 64 && (tileN == 512 ? hybridTasks512 : hybridTasks256) >= t.blocks;
  uint32_t stopTask = 0xffffffffU, runRemaining = 0;
  if constexpr (REUSE) {
    uint32_t total = 0, before = 0;
    for (uint32_t e = firstExpert; e < t.e; ++e) {
      uint32_t end =
#if defined(SPLIT_CORE_VEC)
        useLocalGroups ? localGroups.GetValue(e) : gg.GetValue(e);
#else
        gg.GetValue(e);
#endif
      total += (end - before + BM - 1) / BM * nt;
      before = end;
      if (end == t.m) break;
    }
    nextTask = total * core / t.blocks;
    stopTask = total * (core + 1) / t.blocks;
  }

  const uint32_t groupBatch = (!flexEnabled && t.n % tileN && allNonempty && maxGroup <= tileM) ? t.blocks : t.e;
  for (uint32_t groupBase = firstExpert; groupBase < t.e; groupBase += groupBatch) {
    const uint32_t groupEnd = groupBase + groupBatch < t.e ? groupBase + groupBatch : t.e;
    for (uint32_t columnPhase = 0; columnPhase < ((t.n % tileN || (flexEnabled && t.n % SHORT_WIDTH)) ? 2U : 1U); ++columnPhase) {
      prev = groupBase ? gg.GetValue(groupBase - 1) : 0;
      for (uint32_t e = groupBase; e < groupEnd; ++e) {
        uint32_t end =
#if defined(SPLIT_CORE_VEC)
          useLocalGroups ? localGroups.GetValue(e) : gg.GetValue(e);
#else
          gg.GetValue(e);
#endif
        const uint32_t len = end - prev;
        const bool expertTall = enableTall && GmgLongExpertTall(len, t.n, nt, nt256);
        const bool shortWide = flexEnabled && len <= 32;
        const uint32_t expertM = shortWide ? 32 : (expertTall ? 128 : tileM);
        const uint32_t expertN = shortWide ? SHORT_WIDTH : (expertTall ? 256 : tileN);
        const uint32_t cStride = shortWide ? SHORT_WIDTH : (expertTall ? 256 : BN);
        const uint32_t phaseNt = columnPhase ? (t.n % expertN ? 1 : 0) : t.n / expertN;
        uint32_t mt = (len + expertM - 1) / expertM;
        uint32_t tasks = mt * phaseNt;

        for (; nextTask < taskBase + tasks && nextTask < stopTask; nextTask += (REUSE ? 1 : t.blocks)) {
          uint32_t local = nextTask - taskBase;
          uint32_t mr = (local / phaseNt) * expertM;
          uint32_t nc = (local % phaseNt) * expertN;
          if constexpr (BN > 256) {
            if (columnPhase) nc = (t.n / expertN) * expertN;
          }
          uint32_t rows = (len - mr < expertM ? len - mr : expertM), cols = (t.n - nc < expertN ? t.n - nc : expertN);
          if constexpr (PADDED)
            if (packedExpert != e) {
              packer.Pack(e, 0, t.k);
              packedExpert = e;
            }
#if defined(SPLIT_CORE_CUBE)
          if constexpr (DOUBLE_C) {
            if (done >= 2) {
              if (done & 1)
                CrossCoreWaitFlag<2>(4);
              else
                CrossCoreWaitFlag<2>(1);
            }
          } else if (done)
            CrossCoreWaitFlag<2>(1);
          if constexpr (REUSE) {

            if (!runRemaining) {
              runRemaining = mt - local % mt;
              if (runRemaining > stopTask - nextTask) runRemaining = stopTask - nextTask;
              uint32_t runRows = runRemaining * BM;
              if (runRows > len - mr) runRows = len - mr;
              mm.SetSingleShape(runRows, cols, t.k);
              mm.SetTensorA(xg[(uint64_t)(prev + mr) * t.k]);
              mm.SetTensorB(wg[(uint64_t)e * t.k * t.n + nc]);
            }
            mm.Iterate();
            mm.GetTensorC(cg, 0, true);
            if (!--runRemaining) {
              mm.Iterate();
              mm.End();
            }
          } else {
            mm.SetCStride(cStride);
            mm.SetSingleShape(rows, cols, t.k);
            mm.SetTensorA(xg[(uint64_t)(prev + mr) * t.k]);
            mm.SetTensorB(wg[PADDED ? 0 : (uint64_t)e * t.k * t.n + nc]);
            if constexpr (DOUBLE_C)
              mm.IterateAll(cg[(done & 1) * ELEMS]);
            else
              mm.IterateAll(cg);
            mm.End();
          }
          if constexpr (DOUBLE_C) {
            if (done & 1)
              CrossCoreSetFlag<2, PIPE_FIX>(3);
            else
              CrossCoreSetFlag<2, PIPE_FIX>(0);
          } else
            CrossCoreSetFlag<2, PIPE_FIX>(0);
#endif
#if defined(SPLIT_CORE_VEC)
          if constexpr (DOUBLE_C) {
            uint32_t vectorRows = (rows + VR - 1) / VR;
            uint32_t rowOffset = GetSubBlockIdx() * vectorRows;
            rows = rows > rowOffset ? (rows - rowOffset < vectorRows ? rows - rowOffset : vectorRows) : 0;
            if (rows) DataCopyPad(s, sg[(uint64_t)e * t.n + nc], DataCopyExtParams{1, cols * 4, 0, 0, 0}, DataCopyPadExtParams<float>{true, 0, 0, 0});
            if (done & 1)
              CrossCoreWaitFlag<2>(3);
            else
              CrossCoreWaitFlag<2>(0);

            uint32_t vectorStride = BN > 256 ? (cols + 63) / 64 * 64 : BN;
            uint32_t chunkRows = BN > 256 ? 8192 / vectorStride : CHUNK_ROWS;
            uint32_t chunks = (rows + chunkRows - 1) / chunkRows;
            if (!chunks) chunks = 1;
            for (uint32_t chunk = 0; chunk < chunks; ++chunk) {
              uint32_t first = chunk * chunkRows;
              uint32_t currentRows = rows > first ? (rows - first < chunkRows ? rows - first : chunkRows) : 0;
              if (currentRows) {
                if (cols == cStride)
                  DataCopy(a, cg[(done & 1) * ELEMS + (rowOffset + first) * cStride], currentRows * cStride);
                else
                  DataCopyPad(a, cg[(done & 1) * ELEMS + (rowOffset + first) * cStride],
                    DataCopyExtParams{uint16_t(currentRows), cols * 4, (cStride - cols) * 4, (vectorStride - ((cols + 7) / 8 * 8)) / 8, 0},
                    DataCopyPadExtParams<int32_t>{true, 0, 0, 0});
              }
              SetFlag<HardEvent::MTE2_S>(EVENT_ID0);
              WaitFlag<HardEvent::MTE2_S>(EVENT_ID0);

              if (chunk + 1 == chunks) {
                if (done & 1)
                  CrossCoreSetFlag<2, PIPE_MTE2>(4);
                else
                  CrossCoreSetFlag<2, PIPE_MTE2>(1);
              }
              if (currentRows) {
                SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
                WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
                uint32_t count = currentRows * vectorStride;
                Cast(z, a, RoundMode::CAST_RINT, count);
                for (uint32_t c = 0; c < vectorStride; c += 64)
                  Mul(
                    z[c], z[c], s[c], uint64_t(64), uint8_t(currentRows), BinaryRepeatParams{1, 1, 1, uint8_t(vectorStride / 8), uint8_t(vectorStride / 8), 0});
                GmgGelu<true>(z, h, u, v, p, a, mask1, mask2, count);
                SetFlag<HardEvent::S_MTE3>(EVENT_ID0);
                WaitFlag<HardEvent::S_MTE3>(EVENT_ID0);
                SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
                WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
                DataCopyPad(yg[uint64_t(prev + mr + rowOffset + first) * t.n + nc], h,
                  DataCopyExtParams{uint16_t(currentRows), cols * 2, (vectorStride - ((cols + 15) / 16 * 16)) / 16, (t.n - cols) * 2, 0});
                SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
                WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
              }
            }
          } else {
            uint32_t vectorRows = (rows + VR - 1) / VR;
            uint32_t rowOffset = GetSubBlockIdx() * vectorRows;
            rows = rows > rowOffset ? (rows - rowOffset < vectorRows ? rows - rowOffset : vectorRows) : 0;
            mr += rowOffset;

            if (rows) DataCopyPad(s, sg[(uint64_t)e * t.n + nc], DataCopyExtParams{1, cols * 4, 0, 0, 0}, DataCopyPadExtParams<float>{true, 0, 0, 0});
            CrossCoreWaitFlag<2>(0);
            if (rows) {
              if (cols == BN)
                DataCopy(a, cg[(REUSE && GENERAL ? (done & 1) * ELEMS : 0) + rowOffset * BN], rows * BN);
              else
                DataCopyPad(a, cg[(REUSE && GENERAL ? (done & 1) * ELEMS : 0) + rowOffset * ((REUSE && !GENERAL) ? cols : BN)],
                  DataCopyExtParams{(uint16_t)rows, cols * 4, ((REUSE && !GENERAL) ? 0 : (BN - cols) * 4), (BN - ((cols + 7) / 8 * 8)) / 8, 0},
                  DataCopyPadExtParams<int32_t>{true, 0, 0, 0});
            }
            SetFlag<HardEvent::MTE2_S>(EVENT_ID0);
            WaitFlag<HardEvent::MTE2_S>(EVENT_ID0);
            CrossCoreSetFlag<2, PIPE_MTE2>(1);
            if (rows) {
              SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
              WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
              uint32_t count = rows * BN;
              Cast(z, a, RoundMode::CAST_RINT, count);

              for (uint32_t c = 0; c < BN; c += 64) Mul(z[c], z[c], s[c], uint64_t(64), uint8_t(rows), BinaryRepeatParams{1, 1, 1, BN / 8, BN / 8, 0});
              GmgGelu<DIRECT && BN == 256>(z, h, u, v, p, a, mask1, mask2, count);
              SetFlag<HardEvent::S_MTE3>(EVENT_ID0);
              WaitFlag<HardEvent::S_MTE3>(EVENT_ID0);
              SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
              WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
              DataCopyPad(
                yg[(uint64_t)(prev + mr) * t.n + nc], h, DataCopyExtParams{(uint16_t)rows, cols * 2, (BN - ((cols + 15) / 16 * 16)) / 16, (t.n - cols) * 2, 0});
              SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
              WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
            }
          }
#endif
          ++done;
        }
        taskBase += tasks;
        prev = end;

        if (end == t.m || (REUSE && GENERAL && nextTask >= stopTask)) break;
      }
    }
    if (prev == t.m) break;
  }
#if defined(SPLIT_CORE_CUBE)
  if constexpr (DOUBLE_C) {

    if (done > 1) CrossCoreWaitFlag<2>(4);
    if (done) CrossCoreWaitFlag<2>(1);
  } else if (done)
    CrossCoreWaitFlag<2>(1);
#endif
}
template <uint32_t BM, uint32_t BN, bool MDL = false, bool REUSE = false, bool DIRECT = false, bool PADDED = false, bool GENERAL = false, bool STREAM = false,
  uint32_t DIRECT_MAX_K = 2048>
__aicore__ inline void GmgComputeLongWideWithASlabs(GM_ADDR x, GM_ADDR w, GM_ADDR scale, GM_ADDR groups, GM_ADDR y, GM_ADDR workspace, const GmgTiling &t) {
  static_assert(BM == 64 && BN == 512 && DIRECT && GENERAL && !REUSE && !PADDED && !STREAM, "long-wide dispatch");
  constexpr uint32_t ELEMS = BM * BN, VR = 2, CHUNK_ROWS = 8192 / BN, VELEMS = (BM > 2 * CHUNK_ROWS ? 2 * CHUNK_ROWS : BM) * BN / VR;
  constexpr bool DOUBLE_C = (BM == 128 || BN > 256);
  TPipe pipe;
  const uint32_t core = GetBlockIdx() / GetTaskRation();
  typename Conditional<PADDED, GmgWordWeightPacker, GmgNoWeightPacker>::type packer;
  if constexpr (PADDED) {
    auto padded = workspace + uint64_t(t.blocks) * t.bm * t.bn * 4 + uint64_t(core) * ((t.k + 511) / 512 * 512) * ((t.n + 31) / 32 * 32);
    packer.Init(w, padded, t, pipe);
    w = padded;
  }
  GlobalTensor<int8_t> xg, wg;
  GlobalTensor<int64_t> gg;
  GlobalTensor<float> sg;
  GlobalTensor<half> yg;
  GlobalTensor<int32_t> cg;
  xg.SetGlobalBuffer((__gm__ int8_t *)x);
  wg.SetGlobalBuffer((__gm__ int8_t *)w);
  gg.SetGlobalBuffer((__gm__ int64_t *)groups);
  sg.SetGlobalBuffer((__gm__ float *)scale);
  yg.SetGlobalBuffer((__gm__ half *)y);
  cg.SetGlobalBuffer((__gm__ int32_t *)workspace + core * ELEMS * ((DOUBLE_C || (REUSE && GENERAL)) ? 2 : 1));

#if defined(SPLIT_CORE_CUBE)
  if constexpr (!DIRECT && !STREAM) GmgPrepareL1(pipe, t);
  using StandardCube = typename Conditional<DIRECT,
    typename Conditional<(BN <= 128), GmgWideLongCube<PADDED, BN>,
      typename Conditional<GENERAL, GmgIndependentLongSlabCube<false, 512, 64, 8192, 256>, GmgDirectCube>::type>::type,
    Matmul<MatmulType<TPosition::GM, CubeFormat::ND, int8_t>, MatmulType<TPosition::GM, CubeFormat::ND, int8_t>,
      MatmulType<TPosition::GM, CubeFormat::ND, int32_t>, MatmulType<TPosition::GM, CubeFormat::ND, int32_t>, GMG_MATMUL_CONFIG<MDL>>>::type;
  using CubeOp = typename Conditional<STREAM, GmgStreamCube<BN, BM>,
    typename Conditional<(BM == 128 && !GENERAL), GmgTallCube, typename Conditional<REUSE && GENERAL, GmgPaddedReuseCube, StandardCube>::type>::type>::type;
  CubeOp mm;
  mm.Init(&t.cube, &pipe);
  mm.SetOrgShape(REUSE ? t.m : BM, PADDED ? (t.n + 31) / 32 * 32 : t.n, t.k, t.k, BN);
  CrossCoreWaitFlag<2>(2);
#endif

#if defined(SPLIT_CORE_VEC)
  TBuf<TPosition::VECCALC> ab, zb, ub, vb, pb, sb, hb, maskb1, maskb2, groupBuffer;
  pipe.InitBuffer(ab, (VELEMS * 4) + 256);
  pipe.InitBuffer(zb, (VELEMS * 4) + 256);
  pipe.InitBuffer(ub, (VELEMS * 4) + 256);
  pipe.InitBuffer(vb, (VELEMS * 4) + 256);
  pipe.InitBuffer(pb, (VELEMS * 4) + 256);
  pipe.InitBuffer(sb, (BN * 4) + 256);
  pipe.InitBuffer(hb, (VELEMS * 2) + 256);
  pipe.InitBuffer(maskb1, (VELEMS / 8) + 256);
  pipe.InitBuffer(maskb2, (VELEMS / 8) + 256);
  auto a = ab.Get<int32_t>();
  auto z = zb.Get<float>();
  auto u = ub.Get<float>();
  auto v = vb.Get<float>();
  auto p = pb.Get<float>();
  auto s = sb.Get<float>();
  auto h = hb.Get<half>();
  auto mask1 = maskb1.Get<uint8_t>();
  auto mask2 = maskb2.Get<uint8_t>();

  LocalTensor<int64_t> localGroups;
  bool useLocalGroups = false;
  if constexpr ((DIRECT && BN == 256 && !GENERAL) || (REUSE && GENERAL)) {
    pipe.InitBuffer(groupBuffer, 128 * 8);
    localGroups = groupBuffer.Get<int64_t>();
    useLocalGroups = t.e >= 16;
    if (useLocalGroups) {
      GlobalTensor<int32_t> groupWords;
      groupWords.SetGlobalBuffer((__gm__ int32_t *)groups);
      DataCopyPad(groupBuffer.Get<int32_t>(), groupWords, DataCopyExtParams{1, t.e * 8, 0, 0, 0},
        DataCopyPadExtParams<int32_t>{true, 0, uint8_t((4 - t.e % 4) % 4 * 2), 0});
      SetFlag<HardEvent::MTE2_S>(EVENT_ID0);
      WaitFlag<HardEvent::MTE2_S>(EVENT_ID0);
    }
  }

  CrossCoreSetFlag<2, PIPE_MTE3>(2);
  {
    Duplicate(s, 0.0f, BN);
    SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
    WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
  }
#endif
  uint32_t taskBase = 0, prev = 0, done = 0, nextTask = core, packedExpert = t.e;

  uint32_t tileM = BM, tileN = BN;
#if defined(SPLIT_CORE_VEC)
  uint32_t firstExpert = useLocalGroups ? GmgFirstExpert(localGroups, t.e) : GmgFirstExpert(gg, t.e);
#else
  uint32_t firstExpert = GmgFirstExpert(gg, t.e);
#endif

  uint32_t actualM64 = 0, lastEnd = 0, maxGroup = 0;
  const uint32_t nt512 = (t.n + 511) / 512, nt256 = (t.n + 255) / 256;
  uint32_t hybridTasks512 = 0, hybridTasks256 = 0;
  bool allNonempty = true;
  for (uint32_t expert = firstExpert; expert < t.e; ++expert) {
    uint32_t end = gg.GetValue(expert), len = end - lastEnd;
    const uint32_t m64 = (len + 63) / 64, m128 = (len + 127) / 128;
    actualM64 += m64;
    lastEnd = end;
    hybridTasks512 += GmgLongExpertTall(len, t.n, nt512, nt256) ? m128 * nt256 : m64 * nt512;
    hybridTasks256 += GmgLongExpertTall(len, t.n, nt256, nt256) ? m128 * nt256 : m64 * nt256;
    maxGroup = maxGroup > len ? maxGroup : len;
    allNonempty &= (len != 0);
    if (end == t.m) break;
  }
  if (actualM64 * ((t.n + 511) / 512) < t.blocks) {
    tileN = 256;
    if (actualM64 * ((t.n + 255) / 256) < t.blocks) tileM = 32;
  }
  const uint32_t nt = (t.n + tileN - 1) / tileN;

  const bool enableTall = tileM == 64 && (tileN == 512 ? hybridTasks512 : hybridTasks256) >= t.blocks;
  uint32_t stopTask = 0xffffffffU, runRemaining = 0;
  if constexpr (REUSE) {
    uint32_t total = 0, before = 0;
    for (uint32_t e = firstExpert; e < t.e; ++e) {
      uint32_t end =
#if defined(SPLIT_CORE_VEC)
        useLocalGroups ? localGroups.GetValue(e) : gg.GetValue(e);
#else
        gg.GetValue(e);
#endif
      total += (end - before + BM - 1) / BM * nt;
      before = end;
      if (end == t.m) break;
    }
    nextTask = total * core / t.blocks;
    stopTask = total * (core + 1) / t.blocks;
  }

  const uint32_t groupBatch = (t.n % tileN && allNonempty && maxGroup <= tileM) ? t.blocks : t.e;
  for (uint32_t groupBase = firstExpert; groupBase < t.e; groupBase += groupBatch) {
    const uint32_t groupEnd = groupBase + groupBatch < t.e ? groupBase + groupBatch : t.e;
    for (uint32_t columnPhase = 0; columnPhase < (t.n % tileN ? 2U : 1U); ++columnPhase) {
      prev = groupBase ? gg.GetValue(groupBase - 1) : 0;
      for (uint32_t e = groupBase; e < groupEnd; ++e) {
        uint32_t end =
#if defined(SPLIT_CORE_VEC)
          useLocalGroups ? localGroups.GetValue(e) : gg.GetValue(e);
#else
          gg.GetValue(e);
#endif
        const uint32_t len = end - prev;
        const bool expertTall = enableTall && GmgLongExpertTall(len, t.n, nt, nt256);
        const uint32_t expertM = expertTall ? 128 : tileM, expertN = expertTall ? 256 : tileN;
        const uint32_t cStride = expertTall ? 256 : BN;
        const uint32_t phaseNt = columnPhase ? (t.n % expertN ? 1 : 0) : t.n / expertN;
        uint32_t mt = (len + expertM - 1) / expertM;
        uint32_t tasks = mt * phaseNt;

        for (; nextTask < taskBase + tasks && nextTask < stopTask; nextTask += (REUSE ? 1 : t.blocks)) {
          uint32_t local = nextTask - taskBase;
          uint32_t mr = (local / phaseNt) * expertM;
          uint32_t nc = (local % phaseNt) * expertN;
          if constexpr (BN > 256) {
            if (columnPhase) nc = (t.n / expertN) * expertN;
          }
          uint32_t rows = (len - mr < expertM ? len - mr : expertM), cols = (t.n - nc < expertN ? t.n - nc : expertN);
          if constexpr (PADDED)
            if (packedExpert != e) {
              packer.Pack(e, 0, t.k);
              packedExpert = e;
            }
#if defined(SPLIT_CORE_CUBE)
          if constexpr (DOUBLE_C) {
            if (done >= 2) {
              if (done & 1)
                CrossCoreWaitFlag<2>(4);
              else
                CrossCoreWaitFlag<2>(1);
            }
          } else if (done)
            CrossCoreWaitFlag<2>(1);
          if constexpr (REUSE) {

            if (!runRemaining) {
              runRemaining = mt - local % mt;
              if (runRemaining > stopTask - nextTask) runRemaining = stopTask - nextTask;
              uint32_t runRows = runRemaining * BM;
              if (runRows > len - mr) runRows = len - mr;
              mm.SetSingleShape(runRows, cols, t.k);
              mm.SetTensorA(xg[(uint64_t)(prev + mr) * t.k]);
              mm.SetTensorB(wg[(uint64_t)e * t.k * t.n + nc]);
            }
            mm.Iterate();
            mm.GetTensorC(cg, 0, true);
            if (!--runRemaining) {
              mm.Iterate();
              mm.End();
            }
          } else {
            mm.SetCStride(cStride);
            mm.SetSingleShape(rows, cols, t.k);
            mm.SetTensorA(xg[(uint64_t)(prev + mr) * t.k]);
            mm.SetTensorB(wg[PADDED ? 0 : (uint64_t)e * t.k * t.n + nc]);
            if constexpr (DOUBLE_C)
              mm.IterateAll(cg[(done & 1) * ELEMS]);
            else
              mm.IterateAll(cg);
            mm.End();
          }
          if constexpr (DOUBLE_C) {
            if (done & 1)
              CrossCoreSetFlag<2, PIPE_FIX>(3);
            else
              CrossCoreSetFlag<2, PIPE_FIX>(0);
          } else
            CrossCoreSetFlag<2, PIPE_FIX>(0);
#endif
#if defined(SPLIT_CORE_VEC)
          if constexpr (DOUBLE_C) {
            uint32_t vectorRows = (rows + VR - 1) / VR;
            uint32_t rowOffset = GetSubBlockIdx() * vectorRows;
            rows = rows > rowOffset ? (rows - rowOffset < vectorRows ? rows - rowOffset : vectorRows) : 0;
            if (rows) DataCopyPad(s, sg[(uint64_t)e * t.n + nc], DataCopyExtParams{1, cols * 4, 0, 0, 0}, DataCopyPadExtParams<float>{true, 0, 0, 0});
            if (done & 1)
              CrossCoreWaitFlag<2>(3);
            else
              CrossCoreWaitFlag<2>(0);

            uint32_t vectorStride = BN > 256 ? (cols + 63) / 64 * 64 : BN;
            uint32_t chunkRows = BN > 256 ? 8192 / vectorStride : CHUNK_ROWS;
            uint32_t chunks = (rows + chunkRows - 1) / chunkRows;
            if (!chunks) chunks = 1;
            for (uint32_t chunk = 0; chunk < chunks; ++chunk) {
              uint32_t first = chunk * chunkRows;
              uint32_t currentRows = rows > first ? (rows - first < chunkRows ? rows - first : chunkRows) : 0;
              if (currentRows) {
                if (cols == cStride)
                  DataCopy(a, cg[(done & 1) * ELEMS + (rowOffset + first) * cStride], currentRows * cStride);
                else
                  DataCopyPad(a, cg[(done & 1) * ELEMS + (rowOffset + first) * cStride],
                    DataCopyExtParams{uint16_t(currentRows), cols * 4, (cStride - cols) * 4, (vectorStride - ((cols + 7) / 8 * 8)) / 8, 0},
                    DataCopyPadExtParams<int32_t>{true, 0, 0, 0});
              }
              SetFlag<HardEvent::MTE2_S>(EVENT_ID0);
              WaitFlag<HardEvent::MTE2_S>(EVENT_ID0);

              if (chunk + 1 == chunks) {
                if (done & 1)
                  CrossCoreSetFlag<2, PIPE_MTE2>(4);
                else
                  CrossCoreSetFlag<2, PIPE_MTE2>(1);
              }
              if (currentRows) {
                SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
                WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
                uint32_t count = currentRows * vectorStride;
                Cast(z, a, RoundMode::CAST_RINT, count);
                for (uint32_t c = 0; c < vectorStride; c += 64)
                  Mul(
                    z[c], z[c], s[c], uint64_t(64), uint8_t(currentRows), BinaryRepeatParams{1, 1, 1, uint8_t(vectorStride / 8), uint8_t(vectorStride / 8), 0});
                GmgGelu<true>(z, h, u, v, p, a, mask1, mask2, count);
                SetFlag<HardEvent::S_MTE3>(EVENT_ID0);
                WaitFlag<HardEvent::S_MTE3>(EVENT_ID0);
                SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
                WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
                DataCopyPad(yg[uint64_t(prev + mr + rowOffset + first) * t.n + nc], h,
                  DataCopyExtParams{uint16_t(currentRows), cols * 2, (vectorStride - ((cols + 15) / 16 * 16)) / 16, (t.n - cols) * 2, 0});
                SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
                WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
              }
            }
          } else {
            uint32_t vectorRows = (rows + VR - 1) / VR;
            uint32_t rowOffset = GetSubBlockIdx() * vectorRows;
            rows = rows > rowOffset ? (rows - rowOffset < vectorRows ? rows - rowOffset : vectorRows) : 0;
            mr += rowOffset;

            if (rows) DataCopyPad(s, sg[(uint64_t)e * t.n + nc], DataCopyExtParams{1, cols * 4, 0, 0, 0}, DataCopyPadExtParams<float>{true, 0, 0, 0});
            CrossCoreWaitFlag<2>(0);
            if (rows) {
              if (cols == BN)
                DataCopy(a, cg[(REUSE && GENERAL ? (done & 1) * ELEMS : 0) + rowOffset * BN], rows * BN);
              else
                DataCopyPad(a, cg[(REUSE && GENERAL ? (done & 1) * ELEMS : 0) + rowOffset * ((REUSE && !GENERAL) ? cols : BN)],
                  DataCopyExtParams{(uint16_t)rows, cols * 4, ((REUSE && !GENERAL) ? 0 : (BN - cols) * 4), (BN - ((cols + 7) / 8 * 8)) / 8, 0},
                  DataCopyPadExtParams<int32_t>{true, 0, 0, 0});
            }
            SetFlag<HardEvent::MTE2_S>(EVENT_ID0);
            WaitFlag<HardEvent::MTE2_S>(EVENT_ID0);
            CrossCoreSetFlag<2, PIPE_MTE2>(1);
            if (rows) {
              SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
              WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
              uint32_t count = rows * BN;
              Cast(z, a, RoundMode::CAST_RINT, count);

              for (uint32_t c = 0; c < BN; c += 64) Mul(z[c], z[c], s[c], uint64_t(64), uint8_t(rows), BinaryRepeatParams{1, 1, 1, BN / 8, BN / 8, 0});
              GmgGelu<DIRECT && BN == 256>(z, h, u, v, p, a, mask1, mask2, count);
              SetFlag<HardEvent::S_MTE3>(EVENT_ID0);
              WaitFlag<HardEvent::S_MTE3>(EVENT_ID0);
              SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
              WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
              DataCopyPad(
                yg[(uint64_t)(prev + mr) * t.n + nc], h, DataCopyExtParams{(uint16_t)rows, cols * 2, (BN - ((cols + 15) / 16 * 16)) / 16, (t.n - cols) * 2, 0});
              SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
              WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
            }
          }
#endif
          ++done;
        }
        taskBase += tasks;
        prev = end;

        if (end == t.m || (REUSE && GENERAL && nextTask >= stopTask)) break;
      }
    }
    if (prev == t.m) break;
  }
#if defined(SPLIT_CORE_CUBE)
  if constexpr (DOUBLE_C) {

    if (done > 1) CrossCoreWaitFlag<2>(4);
    if (done) CrossCoreWaitFlag<2>(1);
  } else if (done)
    CrossCoreWaitFlag<2>(1);
#endif
}

#if !defined(GMG_SEPARATE_BUILD) || defined(GMG_BUILD_LONGWIDE)
extern "C" __global__ __mix__(1, 2) void groupmatmulgelu_longwide(
  GM_ADDR x, GM_ADDR w, GM_ADDR scale, GM_ADDR groups, GM_ADDR y, GM_ADDR workspace, GmgTiling t) {
  GmgComputeLongWideWithASlabs<64, 512, false, false, true, false, true, false, 8192>(x, w, scale, groups, y, workspace, t);
}
#endif
#if !defined(GMG_SEPARATE_BUILD) || defined(GMG_BUILD_LONGFLEX)
extern "C" __global__ __mix__(1, 2) void groupmatmulgelu_longflex(
  GM_ADDR x, GM_ADDR w, GM_ADDR scale, GM_ADDR groups, GM_ADDR y, GM_ADDR workspace, GmgTiling t) {
  GmgComputeIndependentLongSlab<64, 512, false, false, true, false, true, false, 8192>(x, w, scale, groups, y, workspace, t);
}
#endif

template <uint32_t BM, uint32_t BN, bool MDL = false, bool REUSE = false, bool DIRECT = false, bool PADDED = false, bool GENERAL = false, bool STREAM = false,
  uint32_t DIRECT_MAX_K = 2048>
__aicore__ inline void GmgComputeLongFlexRagged(GM_ADDR x, GM_ADDR w, GM_ADDR scale, GM_ADDR groups, GM_ADDR y, GM_ADDR workspace, const GmgTiling &t) {
  static_assert(BM == 64 && BN == 512 && DIRECT && GENERAL && !REUSE && !PADDED && !STREAM, "long-wide dispatch");
  constexpr uint32_t ELEMS = BM * BN, VR = 2, CHUNK_ROWS = 8192 / BN, VELEMS = (BM > 2 * CHUNK_ROWS ? 2 * CHUNK_ROWS : BM) * BN / VR;
  constexpr bool DOUBLE_C = (BM == 128 || BN > 256);
  TPipe pipe;
  const uint32_t core = GetBlockIdx() / GetTaskRation();
  typename Conditional<PADDED, GmgWordWeightPacker, GmgNoWeightPacker>::type packer;
  if constexpr (PADDED) {
    auto padded = workspace + uint64_t(t.blocks) * t.bm * t.bn * 4 + uint64_t(core) * ((t.k + 511) / 512 * 512) * ((t.n + 31) / 32 * 32);
    packer.Init(w, padded, t, pipe);
    w = padded;
  }
  GlobalTensor<int8_t> xg, wg;
  GlobalTensor<int64_t> gg;
  GlobalTensor<float> sg;
  GlobalTensor<half> yg;
  GlobalTensor<int32_t> cg;
  xg.SetGlobalBuffer((__gm__ int8_t *)x);
  wg.SetGlobalBuffer((__gm__ int8_t *)w);
  gg.SetGlobalBuffer((__gm__ int64_t *)groups);
  sg.SetGlobalBuffer((__gm__ float *)scale);
  yg.SetGlobalBuffer((__gm__ half *)y);
  cg.SetGlobalBuffer((__gm__ int32_t *)workspace + core * ELEMS * ((DOUBLE_C || (REUSE && GENERAL)) ? 2 : 1));

#if defined(SPLIT_CORE_CUBE)
  if constexpr (!DIRECT && !STREAM) GmgPrepareL1(pipe, t);
  typename Conditional<DIRECT, GmgIndependentLongSlabCube<false, 512, 64, 8192, 256>, GmgDirectCube>::type mm;
  mm.Init(&t.cube, &pipe);
  mm.SetOrgShape(REUSE ? t.m : BM, PADDED ? (t.n + 31) / 32 * 32 : t.n, t.k, t.k, BN);
  CrossCoreWaitFlag<2>(2);
#endif

#if defined(SPLIT_CORE_VEC)
  TBuf<TPosition::VECCALC> ab, zb, ub, vb, pb, sb, hb, maskb1, maskb2, groupBuffer;
  pipe.InitBuffer(ab, (VELEMS * 4) + 256);
  pipe.InitBuffer(zb, (VELEMS * 4) + 256);
  pipe.InitBuffer(ub, (VELEMS * 4) + 256);
  pipe.InitBuffer(vb, (VELEMS * 4) + 256);
  pipe.InitBuffer(pb, (VELEMS * 4) + 256);
  pipe.InitBuffer(sb, (768 * 4) + 256);
  pipe.InitBuffer(hb, (VELEMS * 2) + 256);
  pipe.InitBuffer(maskb1, (VELEMS / 8) + 256);
  pipe.InitBuffer(maskb2, (VELEMS / 8) + 256);
  auto a = ab.Get<int32_t>();
  auto z = zb.Get<float>();
  auto u = ub.Get<float>();
  auto v = vb.Get<float>();
  auto p = pb.Get<float>();
  auto s = sb.Get<float>();
  auto h = hb.Get<half>();
  auto mask1 = maskb1.Get<uint8_t>();
  auto mask2 = maskb2.Get<uint8_t>();

  LocalTensor<int64_t> localGroups;
  bool useLocalGroups = false;
  if constexpr ((DIRECT && BN == 256 && !GENERAL) || (REUSE && GENERAL)) {
    pipe.InitBuffer(groupBuffer, 128 * 8);
    localGroups = groupBuffer.Get<int64_t>();
    useLocalGroups = t.e >= 16;
    if (useLocalGroups) {
      GlobalTensor<int32_t> groupWords;
      groupWords.SetGlobalBuffer((__gm__ int32_t *)groups);
      DataCopyPad(groupBuffer.Get<int32_t>(), groupWords, DataCopyExtParams{1, t.e * 8, 0, 0, 0},
        DataCopyPadExtParams<int32_t>{true, 0, uint8_t((4 - t.e % 4) % 4 * 2), 0});
      SetFlag<HardEvent::MTE2_S>(EVENT_ID0);
      WaitFlag<HardEvent::MTE2_S>(EVENT_ID0);
    }
  }

  // Define both actual C banks before allowing the first Cube write/read epoch.
  Duplicate(a, int32_t(0), VELEMS);
  SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
  WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
  for (uint32_t bank = 0; bank < 2; ++bank)
    for (uint32_t offset = 0; offset < ELEMS / VR; offset += VELEMS) DataCopy(cg[bank * ELEMS + GetSubBlockIdx() * (ELEMS / VR) + offset], a, VELEMS);
  SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
  WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
  CrossCoreSetFlag<2, PIPE_MTE3>(2);
  {
    Duplicate(s, 0.0f, 768);
    SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
    WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
  }
#endif
  uint32_t taskBase = 0, prev = 0, done = 0, nextTask = core, packedExpert = t.e;

  uint32_t tileM = BM, tileN = BN;
#if defined(SPLIT_CORE_VEC)
  uint32_t firstExpert = useLocalGroups ? GmgFirstExpert(localGroups, t.e) : GmgFirstExpert(gg, t.e);
#else
  uint32_t firstExpert = GmgFirstExpert(gg, t.e);
#endif

  uint32_t actualM64 = 0, lastEnd = 0, maxGroup = 0;
  const uint32_t nt512 = (t.n + 511) / 512, nt256 = (t.n + 255) / 256;
  uint32_t hybridTasks512 = 0, hybridTasks256 = 0, flexTasks = 0;
  uint32_t shortMt = 0, wideMt = 0, tallMt = 0;
  bool allNonempty = true;
  for (uint32_t expert = firstExpert; expert < t.e; ++expert) {
    uint32_t end = gg.GetValue(expert), len = end - lastEnd;
    const uint32_t m64 = (len + 63) / 64, m128 = (len + 127) / 128;
    actualM64 += m64;
    lastEnd = end;
    const bool tall512 = GmgLongExpertTall(len, t.n, nt512, nt256);
    flexTasks += len <= 32 ? uint32_t(len != 0) * ((t.n + 767) / 768) : (tall512 ? m128 * nt256 : m64 * nt512);
    hybridTasks512 += tall512 ? m128 * nt256 : m64 * nt512;
    shortMt += uint32_t(len != 0 && len <= 32);
    wideMt += len > 32 && !tall512 ? m64 : 0;
    tallMt += tall512 ? m128 : 0;
    hybridTasks256 += GmgLongExpertTall(len, t.n, nt256, nt256) ? m128 * nt256 : m64 * nt256;
    maxGroup = maxGroup > len ? maxGroup : len;
    allNonempty &= (len != 0);
    if (end == t.m) break;
  }
  if (actualM64 * ((t.n + 511) / 512) < t.blocks) {
    tileN = 256;
    if (actualM64 * ((t.n + 255) / 256) < t.blocks) tileM = 32;
  }

  const bool flexEnabled = tileN == 512 && flexTasks >= t.blocks;
  const uint32_t tail768 = t.n % 768, tail512 = t.n % 512, tail256 = t.n % 256;
  const bool balanced = flexEnabled && flexTasks > t.blocks && shortMt && (wideMt || tallMt || tail768);
  uint32_t r0 = 0, r1 = 0, r2 = 0, r3 = 0, r4 = 0, r5 = 0;
  if (balanced) {
    const uint32_t f0 = shortMt * (t.n / 768), f1 = wideMt * (t.n / 512), f2 = tallMt * (t.n / 256);
    const uint32_t t0 = tail768 ? shortMt : 0, t1 = tail512 ? wideMt : 0, t2 = tail256 ? tallMt : 0;

    r1 = f0 + (tail768 > 512 ? t0 : 0);
    r2 = f0 + f1 + (tail768 > 256 ? t0 : 0) + (tail512 > 256 ? t1 : 0);
    r3 = f0 + (512 >= tail768 ? f1 : 0) + (256 >= tail768 ? f2 : 0) + (tail512 > tail768 ? t1 : 0) + (tail256 > tail768 ? t2 : 0);
    r4 = f0 + f1 + (256 >= tail512 ? f2 : 0) + (tail768 >= tail512 ? t0 : 0) + (tail256 > tail512 ? t2 : 0);
    r5 = f0 + f1 + f2 + (tail768 >= tail256 ? t0 : 0) + (tail512 >= tail256 ? t1 : 0);
  }
  const uint32_t nt = (t.n + tileN - 1) / tileN;

  const bool enableTall = tileM == 64 && (tileN == 512 ? hybridTasks512 : hybridTasks256) >= t.blocks;
  uint32_t stopTask = 0xffffffffU, runRemaining = 0;
  if constexpr (REUSE) {
    uint32_t total = 0, before = 0;
    for (uint32_t e = firstExpert; e < t.e; ++e) {
      uint32_t end =
#if defined(SPLIT_CORE_VEC)
        useLocalGroups ? localGroups.GetValue(e) : gg.GetValue(e);
#else
        gg.GetValue(e);
#endif
      total += (end - before + BM - 1) / BM * nt;
      before = end;
      if (end == t.m) break;
    }
    nextTask = total * core / t.blocks;
    stopTask = total * (core + 1) / t.blocks;
  }

  const uint32_t groupBatch = (!flexEnabled && t.n % tileN && allNonempty && maxGroup <= tileM) ? t.blocks : t.e;
  for (uint32_t groupBase = firstExpert; groupBase < t.e; groupBase += groupBatch) {
    const uint32_t groupEnd = groupBase + groupBatch < t.e ? groupBase + groupBatch : t.e;
    for (uint32_t columnPhase = 0; columnPhase < ((t.n % tileN || (flexEnabled && t.n % 768)) ? 2U : 1U); ++columnPhase) {
      prev = groupBase ? gg.GetValue(groupBase - 1) : 0;
      for (uint32_t e = groupBase; e < groupEnd; ++e) {
        uint32_t end =
#if defined(SPLIT_CORE_VEC)
          useLocalGroups ? localGroups.GetValue(e) : gg.GetValue(e);
#else
          gg.GetValue(e);
#endif
        const uint32_t len = end - prev;
        const bool expertTall = enableTall && GmgLongExpertTall(len, t.n, nt, nt256);
        const bool shortWide = flexEnabled && len <= 32;
        const uint32_t expertM = shortWide ? 32 : (expertTall ? 128 : tileM);
        const uint32_t expertN = shortWide ? 768 : (expertTall ? 256 : tileN);
        const uint32_t cStride = shortWide ? 768 : (expertTall ? 256 : BN);
        const uint32_t phaseNt = columnPhase ? (t.n % expertN ? 1 : 0) : t.n / expertN;
        uint32_t mt = (len + expertM - 1) / expertM;
        uint32_t tasks = mt * phaseNt;
        uint32_t first = nextTask, rangeBase = taskBase;
        if (balanced && tasks) {

          if (!columnPhase) {
            if (shortWide) {
              rangeBase = r0;
              r0 += tasks;
            } else if (expertTall) {
              rangeBase = r2;
              r2 += tasks;
            } else {
              rangeBase = r1;
              r1 += tasks;
            }
          } else {
            if (shortWide) {
              rangeBase = r3;
              r3 += tasks;
            } else if (expertTall) {
              rangeBase = r5;
              r5 += tasks;
            } else {
              rangeBase = r4;
              r4 += tasks;
            }
          }
          const uint32_t wave = rangeBase / t.blocks, lane = rangeBase % t.blocks;
          const uint32_t mine = (wave & 1) ? (t.blocks - 1 - core) : core;
          first = mine >= lane ? rangeBase - lane + mine : rangeBase - lane + t.blocks + (t.blocks - 1 - mine);
        }
        for (uint32_t owned = first; tasks && owned < rangeBase + tasks && owned < stopTask;) {
          uint32_t local = owned - rangeBase;
          if (balanced)
            owned += ((owned / t.blocks) & 1) ? (2 * core + 1) : (2 * (t.blocks - core) - 1);
          else
            owned += (REUSE ? 1 : t.blocks);
          if (!balanced) nextTask = owned;
          uint32_t mr = (local / phaseNt) * expertM;
          uint32_t nc = (local % phaseNt) * expertN;
          if constexpr (BN > 256) {
            if (columnPhase) nc = (t.n / expertN) * expertN;
          }
          uint32_t rows = (len - mr < expertM ? len - mr : expertM), cols = (t.n - nc < expertN ? t.n - nc : expertN);
          if constexpr (PADDED)
            if (packedExpert != e) {
              packer.Pack(e, 0, t.k);
              packedExpert = e;
            }
#if defined(SPLIT_CORE_CUBE)
          if constexpr (DOUBLE_C) {
            if (done >= 2) {
              if (done & 1)
                CrossCoreWaitFlag<2>(4);
              else
                CrossCoreWaitFlag<2>(1);
            }
          } else if (done)
            CrossCoreWaitFlag<2>(1);
          if constexpr (REUSE) {

            if (!runRemaining) {
              runRemaining = mt - local % mt;
              if (runRemaining > stopTask - nextTask) runRemaining = stopTask - nextTask;
              uint32_t runRows = runRemaining * BM;
              if (runRows > len - mr) runRows = len - mr;
              mm.SetSingleShape(runRows, cols, t.k);
              mm.SetTensorA(xg[(uint64_t)(prev + mr) * t.k]);
              mm.SetTensorB(wg[(uint64_t)e * t.k * t.n + nc]);
            }
            mm.Iterate();
            mm.GetTensorC(cg, 0, true);
            if (!--runRemaining) {
              mm.Iterate();
              mm.End();
            }
          } else {
            mm.SetCStride(cStride);
            mm.SetSingleShape(rows, cols, t.k);
            mm.SetTensorA(xg[(uint64_t)(prev + mr) * t.k]);
            mm.SetTensorB(wg[PADDED ? 0 : (uint64_t)e * t.k * t.n + nc]);
            if constexpr (DOUBLE_C)
              mm.IterateAll(cg[(done & 1) * ELEMS]);
            else
              mm.IterateAll(cg);
            mm.End();
          }
          if constexpr (DOUBLE_C) {
            if (done & 1)
              CrossCoreSetFlag<2, PIPE_FIX>(3);
            else
              CrossCoreSetFlag<2, PIPE_FIX>(0);
          } else
            CrossCoreSetFlag<2, PIPE_FIX>(0);
#endif
#if defined(SPLIT_CORE_VEC)
          if constexpr (DOUBLE_C) {
            uint32_t vectorRows = (rows + VR - 1) / VR;
            uint32_t rowOffset = GetSubBlockIdx() * vectorRows;
            rows = rows > rowOffset ? (rows - rowOffset < vectorRows ? rows - rowOffset : vectorRows) : 0;
            if (rows) DataCopyPad(s, sg[(uint64_t)e * t.n + nc], DataCopyExtParams{1, cols * 4, 0, 0, 0}, DataCopyPadExtParams<float>{true, 0, 0, 0});
            if (done & 1)
              CrossCoreWaitFlag<2>(3);
            else
              CrossCoreWaitFlag<2>(0);

            uint32_t vectorStride = BN > 256 ? (cols + 63) / 64 * 64 : BN;
            uint32_t chunkRows = BN > 256 ? 8192 / vectorStride : CHUNK_ROWS;
            uint32_t chunks = (rows + chunkRows - 1) / chunkRows;
            if (!chunks) chunks = 1;
            for (uint32_t chunk = 0; chunk < chunks; ++chunk) {
              uint32_t first = chunk * chunkRows;
              uint32_t currentRows = rows > first ? (rows - first < chunkRows ? rows - first : chunkRows) : 0;
              if (currentRows) {
                if (cols == cStride)
                  DataCopy(a, cg[(done & 1) * ELEMS + (rowOffset + first) * cStride], currentRows * cStride);
                else
                  DataCopyPad(a, cg[(done & 1) * ELEMS + (rowOffset + first) * cStride],
                    DataCopyExtParams{uint16_t(currentRows), cols * 4, (cStride - cols) * 4, (vectorStride - ((cols + 7) / 8 * 8)) / 8, 0},
                    DataCopyPadExtParams<int32_t>{true, 0, 0, 0});
              }
              SetFlag<HardEvent::MTE2_S>(EVENT_ID0);
              WaitFlag<HardEvent::MTE2_S>(EVENT_ID0);

              if (chunk + 1 == chunks) {
                if (done & 1)
                  CrossCoreSetFlag<2, PIPE_MTE2>(4);
                else
                  CrossCoreSetFlag<2, PIPE_MTE2>(1);
              }
              if (currentRows) {
                SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
                WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
                uint32_t count = currentRows * vectorStride;
                Cast(z, a, RoundMode::CAST_RINT, count);
                for (uint32_t c = 0; c < vectorStride; c += 64)
                  Mul(
                    z[c], z[c], s[c], uint64_t(64), uint8_t(currentRows), BinaryRepeatParams{1, 1, 1, uint8_t(vectorStride / 8), uint8_t(vectorStride / 8), 0});
                GmgGelu<true>(z, h, u, v, p, a, mask1, mask2, count);
                SetFlag<HardEvent::S_MTE3>(EVENT_ID0);
                WaitFlag<HardEvent::S_MTE3>(EVENT_ID0);
                SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
                WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
                DataCopyPad(yg[uint64_t(prev + mr + rowOffset + first) * t.n + nc], h,
                  DataCopyExtParams{uint16_t(currentRows), cols * 2, (vectorStride - ((cols + 15) / 16 * 16)) / 16, (t.n - cols) * 2, 0});
                SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
                WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
              }
            }
          } else {
            uint32_t vectorRows = (rows + VR - 1) / VR;
            uint32_t rowOffset = GetSubBlockIdx() * vectorRows;
            rows = rows > rowOffset ? (rows - rowOffset < vectorRows ? rows - rowOffset : vectorRows) : 0;
            mr += rowOffset;

            if (rows) DataCopyPad(s, sg[(uint64_t)e * t.n + nc], DataCopyExtParams{1, cols * 4, 0, 0, 0}, DataCopyPadExtParams<float>{true, 0, 0, 0});
            CrossCoreWaitFlag<2>(0);
            if (rows) {
              if (cols == BN)
                DataCopy(a, cg[(REUSE && GENERAL ? (done & 1) * ELEMS : 0) + rowOffset * BN], rows * BN);
              else
                DataCopyPad(a, cg[(REUSE && GENERAL ? (done & 1) * ELEMS : 0) + rowOffset * ((REUSE && !GENERAL) ? cols : BN)],
                  DataCopyExtParams{(uint16_t)rows, cols * 4, ((REUSE && !GENERAL) ? 0 : (BN - cols) * 4), (BN - ((cols + 7) / 8 * 8)) / 8, 0},
                  DataCopyPadExtParams<int32_t>{true, 0, 0, 0});
            }
            SetFlag<HardEvent::MTE2_S>(EVENT_ID0);
            WaitFlag<HardEvent::MTE2_S>(EVENT_ID0);
            CrossCoreSetFlag<2, PIPE_MTE2>(1);
            if (rows) {
              SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
              WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
              uint32_t count = rows * BN;
              Cast(z, a, RoundMode::CAST_RINT, count);

              for (uint32_t c = 0; c < BN; c += 64) Mul(z[c], z[c], s[c], uint64_t(64), uint8_t(rows), BinaryRepeatParams{1, 1, 1, BN / 8, BN / 8, 0});
              GmgGelu<DIRECT && BN == 256>(z, h, u, v, p, a, mask1, mask2, count);
              SetFlag<HardEvent::S_MTE3>(EVENT_ID0);
              WaitFlag<HardEvent::S_MTE3>(EVENT_ID0);
              SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
              WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
              DataCopyPad(
                yg[(uint64_t)(prev + mr) * t.n + nc], h, DataCopyExtParams{(uint16_t)rows, cols * 2, (BN - ((cols + 15) / 16 * 16)) / 16, (t.n - cols) * 2, 0});
              SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
              WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
            }
          }
#endif
          ++done;
        }
        taskBase += tasks;
        prev = end;

        if (end == t.m || (REUSE && GENERAL && nextTask >= stopTask)) break;
      }
    }
    if (prev == t.m) break;
  }
#if defined(SPLIT_CORE_CUBE)
  if constexpr (DOUBLE_C) {

    if (done > 1) CrossCoreWaitFlag<2>(4);
    if (done) CrossCoreWaitFlag<2>(1);
  } else if (done)
    CrossCoreWaitFlag<2>(1);
#endif
}
#if !defined(GMG_SEPARATE_BUILD) || defined(GMG_BUILD_LONGFLEX_RAGGED)
extern "C" __global__ __mix__(1, 2) void groupmatmulgelu_longflex_ragged(
  GM_ADDR x, GM_ADDR w, GM_ADDR scale, GM_ADDR groups, GM_ADDR y, GM_ADDR workspace, GmgTiling t) {
  GmgComputeLongFlexRagged<64, 512, false, false, true, false, true, false, 8192>(x, w, scale, groups, y, workspace, t);
}
#endif
template <uint32_t BM, uint32_t BN, bool MDL = false, bool REUSE = false, bool DIRECT = false, bool PADDED = false, bool GENERAL = false, bool STREAM = false,
  uint32_t DIRECT_MAX_K = 2048>
__aicore__ inline void GmgComputeLongFlexSplitResidual(GM_ADDR x, GM_ADDR w, GM_ADDR scale, GM_ADDR groups, GM_ADDR y, GM_ADDR workspace, const GmgTiling &t) {
  static_assert(BM == 64 && BN == 512 && DIRECT && GENERAL && !REUSE && !PADDED && !STREAM, "long-wide dispatch");
  constexpr uint32_t ELEMS = BM * BN, VR = 2, CHUNK_ROWS = 8192 / BN, VELEMS = (BM > 2 * CHUNK_ROWS ? 2 * CHUNK_ROWS : BM) * BN / VR;
  constexpr bool DOUBLE_C = (BM == 128 || BN > 256);
  TPipe pipe;
  const uint32_t core = GetBlockIdx() / GetTaskRation();
  typename Conditional<PADDED, GmgWordWeightPacker, GmgNoWeightPacker>::type packer;
  if constexpr (PADDED) {
    auto padded = workspace + uint64_t(t.blocks) * t.bm * t.bn * 4 + uint64_t(core) * ((t.k + 511) / 512 * 512) * ((t.n + 31) / 32 * 32);
    packer.Init(w, padded, t, pipe);
    w = padded;
  }
  GlobalTensor<int8_t> xg, wg;
  GlobalTensor<int64_t> gg;
  GlobalTensor<float> sg;
  GlobalTensor<half> yg;
  GlobalTensor<int32_t> cg;
  xg.SetGlobalBuffer((__gm__ int8_t *)x);
  wg.SetGlobalBuffer((__gm__ int8_t *)w);
  gg.SetGlobalBuffer((__gm__ int64_t *)groups);
  sg.SetGlobalBuffer((__gm__ float *)scale);
  yg.SetGlobalBuffer((__gm__ half *)y);
  cg.SetGlobalBuffer((__gm__ int32_t *)workspace + core * ELEMS * ((DOUBLE_C || (REUSE && GENERAL)) ? 2 : 1));
  GlobalTensor<int32_t> lateC;
  lateC.SetGlobalBuffer((__gm__ int32_t *)workspace + uint64_t(t.blocks) * 2 * ELEMS);

#if defined(SPLIT_CORE_CUBE)
  if constexpr (!DIRECT && !STREAM) GmgPrepareL1(pipe, t);
  typename Conditional<DIRECT, GmgIndependentLongSlabCube<false, 512, 64, 8192, 256, true>, GmgDirectCube>::type mm;
  mm.Init(&t.cube, &pipe);
  mm.SetOrgShape(REUSE ? t.m : BM, PADDED ? (t.n + 31) / 32 * 32 : t.n, t.k, t.k, BN);
#endif

#if defined(SPLIT_CORE_VEC)
  TBuf<TPosition::VECCALC> ab, zb, ub, vb, pb, sb, hb, maskb1, maskb2, groupBuffer;
  pipe.InitBuffer(ab, (VELEMS * 4) + 256);
  pipe.InitBuffer(zb, (VELEMS * 4) + 256);
  pipe.InitBuffer(ub, (VELEMS * 4) + 256);
  pipe.InitBuffer(vb, (VELEMS * 4) + 256);
  pipe.InitBuffer(pb, (VELEMS * 4) + 256);
  pipe.InitBuffer(sb, (768 * 4) + 256);
  pipe.InitBuffer(hb, (VELEMS * 2) + 256);
  pipe.InitBuffer(maskb1, (VELEMS / 8) + 256);
  pipe.InitBuffer(maskb2, (VELEMS / 8) + 256);
  auto a = ab.Get<int32_t>();
  auto z = zb.Get<float>();
  auto u = ub.Get<float>();
  auto v = vb.Get<float>();
  auto p = pb.Get<float>();
  auto s = sb.Get<float>();
  auto h = hb.Get<half>();
  auto mask1 = maskb1.Get<uint8_t>();
  auto mask2 = maskb2.Get<uint8_t>();
  GlobalTensor<int32_t> pairC;
  pairC.SetGlobalBuffer((__gm__ int32_t *)workspace + (core & ~1U) * 2 * ELEMS);
  uint32_t tailRows = 0, tailPitch = 0;
  const uint32_t splitLane = (core & 1) * 2 + GetSubBlockIdx();
  const uint32_t splitRank = t.blocks + core / 2;

  LocalTensor<int64_t> localGroups;
  bool useLocalGroups = false;
  if constexpr ((DIRECT && BN == 256 && !GENERAL) || (REUSE && GENERAL)) {
    pipe.InitBuffer(groupBuffer, 128 * 8);
    localGroups = groupBuffer.Get<int64_t>();
    useLocalGroups = t.e >= 16;
    if (useLocalGroups) {
      GlobalTensor<int32_t> groupWords;
      groupWords.SetGlobalBuffer((__gm__ int32_t *)groups);
      DataCopyPad(groupBuffer.Get<int32_t>(), groupWords, DataCopyExtParams{1, t.e * 8, 0, 0, 0},
        DataCopyPadExtParams<int32_t>{true, 0, uint8_t((4 - t.e % 4) % 4 * 2), 0});
      SetFlag<HardEvent::MTE2_S>(EVENT_ID0);
      WaitFlag<HardEvent::MTE2_S>(EVENT_ID0);
    }
  }
#endif
  uint32_t taskBase = 0, prev = 0, done = 0, nextTask = core, packedExpert = t.e;

  uint32_t tileM = BM, tileN = BN;
#if defined(SPLIT_CORE_VEC)
  uint32_t firstExpert = useLocalGroups ? GmgFirstExpert(localGroups, t.e) : GmgFirstExpert(gg, t.e);
#else
  uint32_t firstExpert = GmgFirstExpert(gg, t.e);
#endif

  uint32_t actualM64 = 0, lastEnd = 0, maxGroup = 0;
  const uint32_t nt512 = (t.n + 511) / 512, nt256 = (t.n + 255) / 256;
  uint32_t hybridTasks512 = 0, hybridTasks256 = 0, flexTasks = 0;
  bool allNonempty = true, hasShort = false, hasPair = false;
  for (uint32_t expert = firstExpert; expert < t.e; ++expert) {
    uint32_t end = gg.GetValue(expert), len = end - lastEnd;
    const uint32_t m64 = (len + 63) / 64, m128 = (len + 127) / 128;
    actualM64 += m64;
    lastEnd = end;
    flexTasks += len <= 32 ? ((len + 31) / 32) * ((t.n + 767) / 768) : (GmgLongExpertTall(len, t.n, nt512, nt256) ? m128 * nt256 : m64 * nt512);
    const bool tall512 = GmgLongExpertTall(len, t.n, nt512, nt256);
    hasPair |= !tall512 && len > 128 && (m64 & 1);
    const uint32_t groupTiles = tall512 ? m128 * nt256 : m64 * nt512;
#if defined(SPLIT_CORE_VEC)
    if (splitRank >= hybridTasks512 && splitRank < hybridTasks512 + groupTiles) {
      const uint32_t ht = tall512 ? 128 : 64, ntiles = tall512 ? nt256 : nt512;
      const uint32_t row = ((splitRank - hybridTasks512) / ntiles) * ht;
      tailRows = len - row < ht ? len - row : ht;
      tailPitch = tall512 ? 256 : 512;
    }
#endif
    hybridTasks512 += groupTiles;
    hybridTasks256 += GmgLongExpertTall(len, t.n, nt256, nt256) ? m128 * nt256 : m64 * nt256;
    maxGroup = maxGroup > len ? maxGroup : len;
    allNonempty &= (len != 0);
    hasShort |= (len != 0 && len <= 32);
    if (end == t.m) break;
  }
  if (actualM64 * ((t.n + 511) / 512) < t.blocks) {
    tileN = 256;
    if (actualM64 * ((t.n + 255) / 256) < t.blocks) tileM = 32;
  }

  const bool flexEnabled = tileN == 512 && flexTasks >= t.blocks;
  const uint32_t nt = (t.n + tileN - 1) / tileN;

  const bool enableTall = tileM == 64 && (tileN == 512 ? hybridTasks512 : hybridTasks256) >= t.blocks;

  const uint32_t residual0 = hybridTasks512 > t.blocks ? hybridTasks512 - t.blocks : 0;
  const uint32_t lateWaves = flexTasks / t.blocks, lateResidual = flexTasks % t.blocks;
  const bool splitLate = flexEnabled && t.n % 512 == 0 && (!hasShort || t.n % 768 == 0) && lateWaves >= 2 && lateResidual && lateResidual <= t.blocks / 2;
  const bool splitResidual = splitLate || (flexEnabled && !hasShort && t.n % 512 == 0 && residual0 && residual0 <= t.blocks / 2);
  const uint32_t residual = splitLate ? lateResidual : residual0;
  const uint32_t fullWaves = splitLate ? lateWaves : 1;
  uint32_t helper = core / 2;
  if (splitLate && t.blocks <= 32) {

    volatile uint32_t load[32];
    for (uint32_t lane = 0; lane < 32; ++lane) load[lane] = 0;
    const uint32_t limit = fullWaves * t.blocks;
    uint32_t base = 0, begin = 0;
    for (uint32_t e = firstExpert; e < t.e && base < limit; ++e) {
      const uint32_t end = gg.GetValue(e), len = end - begin;
      const bool shortGroup = len <= 32;
      const bool tall = !shortGroup && GmgLongExpertTall(len, t.n, nt512, nt256);
      const uint32_t mh = shortGroup ? 32 : (tall ? 128 : 64);
      const uint32_t width = shortGroup ? 768 : (tall ? 256 : 512);
      const uint32_t count = ((len + mh - 1) / mh) * (t.n / width);
      const uint32_t prior = count < limit - base ? count : limit - base;
      const uint32_t remain = prior % t.blocks;
      uint32_t lane = base % t.blocks;
      for (uint32_t r = 0; r < remain; ++r) {
        load[lane] += width / 256;
        if (++lane == t.blocks) lane = 0;
      }
      base += count;
      begin = end;
    }
    uint32_t mask = 0;
    for (uint32_t pick = 0; pick < residual; ++pick) {
      uint32_t best = 0xffffffffU, index = 0;
      for (uint32_t p = 0; p < t.blocks / 2; ++p)
        if (!(mask & (1U << p))) {
          const uint32_t a = load[2 * p], b = load[2 * p + 1], score = a > b ? a : b;
          if (score < best) {
            best = score;
            index = p;
          }
        }
      mask |= 1U << index;
    }
    const uint32_t pair = core / 2;
    if (mask & (1U << pair)) {
      helper = 0;
      for (uint32_t p = 0; p < pair; ++p) helper += (mask >> p) & 1U;
    } else
      helper = residual;
  }
  const bool helps = helper < residual;
#if defined(SPLIT_CORE_VEC)
  if (splitLate && helps) {
    const uint32_t ordinal = fullWaves * t.blocks + helper;
    uint32_t base = 0, begin = 0;
    for (uint32_t e = firstExpert; e < t.e; ++e) {
      const uint32_t end = gg.GetValue(e), len = end - begin;
      const bool shortGroup = len <= 32;
      const bool tall = !shortGroup && GmgLongExpertTall(len, t.n, nt512, nt256);
      const uint32_t mh = shortGroup ? 32 : (tall ? 128 : 64);
      const uint32_t width = shortGroup ? 768 : (tall ? 256 : 512), ntiles = t.n / width;
      const uint32_t count = ((len + mh - 1) / mh) * ntiles;
      if (ordinal >= base && ordinal - base < count) {
        const uint32_t row = ((ordinal - base) / ntiles) * mh;
        tailRows = len - row < mh ? len - row : mh;
        tailPitch = width;
        break;
      }
      base += count;
      begin = end;
    }
  }
#endif
  const bool pairFullRows = tileM == 64 && tileN == 512 && t.n % 512 == 0 && hybridTasks512 > t.blocks + t.blocks / 2;
  const bool balance = pairFullRows && flexEnabled && hasPair && flexTasks > t.blocks + t.blocks / 2 && flexTasks <= 2 * t.blocks;
  uint32_t rank768 = 0, rank512 = 0, rank256 = 0;
  if (balance) {
    uint32_t c768 = 0, c512 = 0, begin = 0;
    for (uint32_t e = firstExpert; e < t.e; ++e) {
      const uint32_t end = gg.GetValue(e), len = end - begin, m64 = (len + 63) / 64;
      begin = end;
      if (len <= 32) {
        if (len) {
          c768 += t.n / 768;
          c512 += t.n % 768 == 512;
        }
      } else if (!GmgLongExpertTall(len, t.n, nt512, nt256)) {
        if (len > 128 && (m64 & 1))
          c512 += nt512;
        else
          c512 += m64 * nt512;
      }
      if (end == t.m) break;
    }
    rank512 = c768;
    rank256 = c768 + c512;
  }
  const uint32_t cut = ((t.k + 255) / 256 / 2) * 256;
#if defined(SPLIT_CORE_CUBE)
  CrossCoreWaitFlag<2>(2);
#endif
#if defined(SPLIT_CORE_VEC)

  Duplicate(a, int32_t(0), VELEMS);
  SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
  WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
  if (splitResidual) {
    const bool paired = helps;
    const uint32_t lane = GetSubBlockIdx() * (ELEMS / VR);

    for (uint32_t offset = 0; offset < ELEMS / VR; offset += VELEMS) DataCopy(cg[lane + offset], a, VELEMS);
    if (splitLate) {
      for (uint32_t offset = 0; offset < ELEMS / VR; offset += VELEMS) DataCopy(cg[ELEMS + lane + offset], a, VELEMS);
    }
    CrossCoreSetFlag<2, PIPE_MTE3>(2);
    if (paired) {
      const uint32_t tailBegin = tailRows * splitLane / 4;
      const uint32_t tailEnd = tailRows * (splitLane + 1) / 4;
      const uint32_t limit = VELEMS / tailPitch;
      for (uint32_t row = tailBegin; row < tailEnd; row += limit) {
        const uint32_t count = (tailEnd - row < limit ? tailEnd - row : limit) * tailPitch;
        if (splitLate) {
          DataCopy(lateC[(core & ~1U) * ELEMS + row * tailPitch], a, count);
          DataCopy(lateC[((core & ~1U) + 1) * ELEMS + row * tailPitch], a, count);
        } else {
          DataCopy(pairC[ELEMS + row * tailPitch], a, count);
          DataCopy(pairC[3 * ELEMS + row * tailPitch], a, count);
        }
      }
    }
    CrossCoreSetFlag<0, PIPE_MTE3>(7);
    CrossCoreWaitFlag<0>(7);
    if (paired) CrossCoreSetFlag<2, PIPE_MTE3>(5);
  } else {
    for (uint32_t slot = 0; slot < 2; ++slot)
      for (uint32_t offset = 0; offset < ELEMS / VR; offset += VELEMS) DataCopy(cg[slot * ELEMS + GetSubBlockIdx() * (ELEMS / VR) + offset], a, VELEMS);
    CrossCoreSetFlag<2, PIPE_MTE3>(2);
  }
  {
    Duplicate(s, 0.0f, 768);
    SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
    WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
  }
#endif
  uint32_t stopTask = 0xffffffffU, runRemaining = 0;
  if constexpr (REUSE) {
    uint32_t total = 0, before = 0;
    for (uint32_t e = firstExpert; e < t.e; ++e) {
      uint32_t end =
#if defined(SPLIT_CORE_VEC)
        useLocalGroups ? localGroups.GetValue(e) : gg.GetValue(e);
#else
        gg.GetValue(e);
#endif
      total += (end - before + BM - 1) / BM * nt;
      before = end;
      if (end == t.m) break;
    }
    nextTask = total * core / t.blocks;
    stopTask = total * (core + 1) / t.blocks;
  }

  const uint32_t groupBatch = (!flexEnabled && t.n % tileN && allNonempty && maxGroup <= tileM) ? t.blocks : t.e;
  for (uint32_t groupBase = firstExpert; groupBase < t.e; groupBase += groupBatch) {
    const uint32_t groupEnd = groupBase + groupBatch < t.e ? groupBase + groupBatch : t.e;
    for (uint32_t columnPhase = 0; columnPhase < ((t.n % tileN || (flexEnabled && t.n % 768)) ? 2U : 1U); ++columnPhase) {
      prev = groupBase ? gg.GetValue(groupBase - 1) : 0;
      for (uint32_t e = groupBase; e < groupEnd; ++e) {
        uint32_t end =
#if defined(SPLIT_CORE_VEC)
          useLocalGroups ? localGroups.GetValue(e) : gg.GetValue(e);
#else
          gg.GetValue(e);
#endif
        const uint32_t len = end - prev;
        const bool expertTall = enableTall && GmgLongExpertTall(len, t.n, nt, nt256);
        const bool shortWide = flexEnabled && len <= 32;
        const uint32_t expertM = shortWide ? 32 : (expertTall ? 128 : tileM);
        const uint32_t expertN = shortWide ? 768 : (expertTall ? 256 : tileN);
        const uint32_t originalStride = shortWide ? 768 : (expertTall ? 256 : BN);
        const uint32_t phaseNt = columnPhase ? (t.n % expertN ? 1 : 0) : t.n / expertN;
        uint32_t mt = (len + expertM - 1) / expertM;
        uint32_t tasks = mt * phaseNt;

        const bool mixedPair = balance && !expertTall && !columnPhase && len > 128 && (((len + 63) / 64) & 1);
        const uint32_t pairs = mixedPair ? len / 128 : 0;
        const uint32_t pairTiles = pairs * nt256;
        const uint32_t runs = balance && mixedPair ? 2 : 1;
        for (uint32_t run = 0; run < runs; ++run) {
          const uint32_t localBase = run ? pairTiles : 0;
          const uint32_t count = runs == 1 ? tasks : (run ? tasks - pairTiles : pairTiles);
          uint32_t first = nextTask, rangeBase = taskBase;
          if (balance && count) {
            const uint32_t width = mixedPair ? (run ? 512 : 256) : (columnPhase ? t.n % expertN : expertN);
            if (width == 768) {
              rangeBase = rank768;
              rank768 += count;
            } else if (width == 512) {
              rangeBase = rank512;
              rank512 += count;
            } else {
              rangeBase = rank256;
              rank256 += count;
            }
            const uint32_t wave = rangeBase / t.blocks, lane = rangeBase % t.blocks;
            const uint32_t mine = (wave & 1) ? t.blocks - 1 - core : core;
            first = mine >= lane ? rangeBase - lane + mine : rangeBase - lane + t.blocks + (t.blocks - 1 - mine);
          }
          for (uint32_t owned = first; count && owned < rangeBase + count && owned < stopTask;) {
            const bool isPart = splitResidual && done >= fullWaves;
            const bool latePart = splitLate && isPart;
            const bool secondPart = isPart && (core & 1);
            uint32_t local = owned - rangeBase + localBase;
            uint32_t mr = (local / phaseNt) * expertM;
            uint32_t nc = (local % phaseNt) * expertN;
            if constexpr (BN > 256) {
              if (columnPhase) nc = (t.n / expertN) * expertN;
            }
            uint32_t rows = (len - mr < expertM ? len - mr : expertM), cols = (t.n - nc < expertN ? t.n - nc : expertN);
            uint32_t cStride = originalStride;
            if (mixedPair) {
              if (local < pairTiles) {
                mr = (local / nt256) * 128;
                nc = (local % nt256) * 256;
                rows = 128;
                cols = 256;
                cStride = 256;
              } else {
                mr = pairs * 128;
                nc = (local - pairTiles) * 512;
                rows = len - mr;
                cols = 512;
              }
            }
            if constexpr (PADDED)
              if (packedExpert != e) {
                packer.Pack(e, 0, t.k);
                packedExpert = e;
              }
#if defined(SPLIT_CORE_CUBE)
            if (isPart) CrossCoreWaitFlag<2>(5);
            const uint32_t release = done >= 2 ? ((done & 1) ? 4 : 1) : 0;
            if constexpr (REUSE) {

              if (!runRemaining) {
                runRemaining = mt - local % mt;
                if (runRemaining > stopTask - nextTask) runRemaining = stopTask - nextTask;
                uint32_t runRows = runRemaining * BM;
                if (runRows > len - mr) runRows = len - mr;
                mm.SetSingleShape(runRows, cols, t.k);
                mm.SetTensorA(xg[(uint64_t)(prev + mr) * t.k]);
                mm.SetTensorB(wg[(uint64_t)e * t.k * t.n + nc]);
              }
              mm.Iterate();
              mm.GetTensorC(cg, 0, true);
              if (!--runRemaining) {
                mm.Iterate();
                mm.End();
              }
            } else {
              mm.SetCStride(cStride);
              const uint32_t beginK = secondPart ? cut : 0;
              const uint32_t countK = isPart ? (secondPart ? t.k - cut : cut) : t.k;
              mm.SetSingleShape(rows, cols, countK);
              mm.SetTensorA(xg[(uint64_t)(prev + mr) * t.k + beginK]);
              auto weightTile = wg[PADDED ? 0 : ((uint64_t)e * t.k + beginK) * t.n + nc];
              mm.SetTensorB(weightTile);
              if (latePart)
                mm.IterateAll(lateC[core * ELEMS], release);
              else if constexpr (DOUBLE_C)
                mm.IterateAll(cg[(done & 1) * ELEMS], release);
              else
                mm.IterateAll(cg, release);
              mm.End();
            }
            if constexpr (DOUBLE_C) {
              if (!isPart) {
                if (done & 1)
                  CrossCoreSetFlag<2, PIPE_FIX>(3);
                else
                  CrossCoreSetFlag<2, PIPE_FIX>(0);
              }
            } else
              CrossCoreSetFlag<2, PIPE_FIX>(0);
#endif
#if defined(SPLIT_CORE_VEC)
            if constexpr (DOUBLE_C) {
              uint32_t vectorRows = (rows + VR - 1) / VR;
              uint32_t rowOffset = GetSubBlockIdx() * vectorRows;
              if (isPart) {
                rowOffset = rows * splitLane / 4;
                rows = rows * (splitLane + 1) / 4 - rowOffset;
              } else
                rows = rows > rowOffset ? (rows - rowOffset < vectorRows ? rows - rowOffset : vectorRows) : 0;
              if (rows) DataCopyPad(s, sg[(uint64_t)e * t.n + nc], DataCopyExtParams{1, cols * 4, 0, 0, 0}, DataCopyPadExtParams<float>{true, 0, 0, 0});
              if (done & 1)
                CrossCoreWaitFlag<2>(3);
              else
                CrossCoreWaitFlag<2>(0);

              uint32_t vectorStride = BN > 256 ? (cols + 63) / 64 * 64 : BN;
              uint32_t chunkRows = BN > 256 ? 8192 / vectorStride : CHUNK_ROWS;
              uint32_t chunks = (rows + chunkRows - 1) / chunkRows;
              if (!chunks) chunks = 1;
              for (uint32_t chunk = 0; chunk < chunks; ++chunk) {
                uint32_t first = chunk * chunkRows;
                uint32_t currentRows = rows > first ? (rows - first < chunkRows ? rows - first : chunkRows) : 0;
                if (currentRows) {
                  if (latePart)
                    DataCopy(a, lateC[core * ELEMS + (rowOffset + first) * cStride], currentRows * cStride);
                  else if (cols == cStride)
                    DataCopy(a, cg[(done & 1) * ELEMS + (rowOffset + first) * cStride], currentRows * cStride);
                  else
                    DataCopyPad(a, cg[(done & 1) * ELEMS + (rowOffset + first) * cStride],
                      DataCopyExtParams{uint16_t(currentRows), cols * 4, (cStride - cols) * 4, (vectorStride - ((cols + 7) / 8 * 8)) / 8, 0},
                      DataCopyPadExtParams<int32_t>{true, 0, 0, 0});
                  if (isPart) {

                    if (latePart)
                      DataCopy(z.template ReinterpretCast<int32_t>(), lateC[(core ^ 1U) * ELEMS + (rowOffset + first) * cStride], currentRows * cStride);
                    else
                      DataCopy(
                        z.template ReinterpretCast<int32_t>(), pairC[(secondPart ? 1 : 3) * ELEMS + (rowOffset + first) * cStride], currentRows * cStride);
                  }
                }
                SetFlag<HardEvent::MTE2_S>(EVENT_ID0);
                WaitFlag<HardEvent::MTE2_S>(EVENT_ID0);

                if (chunk + 1 == chunks) {
                  if (done & 1)
                    CrossCoreSetFlag<2, PIPE_MTE2>(4);
                  else
                    CrossCoreSetFlag<2, PIPE_MTE2>(1);
                }
                if (currentRows) {
                  SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
                  WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
                  uint32_t count = currentRows * vectorStride;
                  if (isPart) {
                    Add(a, a, z.template ReinterpretCast<int32_t>(), count);
                    PipeBarrier<PIPE_V>();
                  }
                  Cast(z, a, RoundMode::CAST_RINT, count);
                  for (uint32_t c = 0; c < vectorStride; c += 64)
                    Mul(z[c], z[c], s[c], uint64_t(64), uint8_t(currentRows),
                      BinaryRepeatParams{1, 1, 1, uint8_t(vectorStride / 8), uint8_t(vectorStride / 8), 0});
                  GmgGelu<true>(z, h, u, v, p, a, mask1, mask2, count);
                  SetFlag<HardEvent::S_MTE3>(EVENT_ID0);
                  WaitFlag<HardEvent::S_MTE3>(EVENT_ID0);
                  SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
                  WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
                  DataCopyPad(yg[uint64_t(prev + mr + rowOffset + first) * t.n + nc], h,
                    DataCopyExtParams{uint16_t(currentRows), cols * 2, (vectorStride - ((cols + 15) / 16 * 16)) / 16, (t.n - cols) * 2, 0});
                  SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
                  WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
                }
              }
            } else {
              uint32_t vectorRows = (rows + VR - 1) / VR;
              uint32_t rowOffset = GetSubBlockIdx() * vectorRows;
              rows = rows > rowOffset ? (rows - rowOffset < vectorRows ? rows - rowOffset : vectorRows) : 0;
              mr += rowOffset;

              if (rows) DataCopyPad(s, sg[(uint64_t)e * t.n + nc], DataCopyExtParams{1, cols * 4, 0, 0, 0}, DataCopyPadExtParams<float>{true, 0, 0, 0});
              CrossCoreWaitFlag<2>(0);
              if (rows) {
                if (cols == BN)
                  DataCopy(a, cg[(REUSE && GENERAL ? (done & 1) * ELEMS : 0) + rowOffset * BN], rows * BN);
                else
                  DataCopyPad(a, cg[(REUSE && GENERAL ? (done & 1) * ELEMS : 0) + rowOffset * ((REUSE && !GENERAL) ? cols : BN)],
                    DataCopyExtParams{(uint16_t)rows, cols * 4, ((REUSE && !GENERAL) ? 0 : (BN - cols) * 4), (BN - ((cols + 7) / 8 * 8)) / 8, 0},
                    DataCopyPadExtParams<int32_t>{true, 0, 0, 0});
              }
              SetFlag<HardEvent::MTE2_S>(EVENT_ID0);
              WaitFlag<HardEvent::MTE2_S>(EVENT_ID0);
              CrossCoreSetFlag<2, PIPE_MTE2>(1);
              if (rows) {
                SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
                WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
                uint32_t count = rows * BN;
                Cast(z, a, RoundMode::CAST_RINT, count);

                for (uint32_t c = 0; c < BN; c += 64) Mul(z[c], z[c], s[c], uint64_t(64), uint8_t(rows), BinaryRepeatParams{1, 1, 1, BN / 8, BN / 8, 0});
                GmgGelu<DIRECT && BN == 256>(z, h, u, v, p, a, mask1, mask2, count);
                SetFlag<HardEvent::S_MTE3>(EVENT_ID0);
                WaitFlag<HardEvent::S_MTE3>(EVENT_ID0);
                SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
                WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
                DataCopyPad(yg[(uint64_t)(prev + mr) * t.n + nc], h,
                  DataCopyExtParams{(uint16_t)rows, cols * 2, (BN - ((cols + 15) / 16 * 16)) / 16, (t.n - cols) * 2, 0});
                SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
                WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
              }
            }
#endif
            ++done;
            if (balance)
              owned += ((owned / t.blocks) & 1) ? (2 * core + 1) : (2 * (t.blocks - core) - 1);
            else {
              if (splitResidual && done >= fullWaves)
                nextTask = done == fullWaves && helps ? fullWaves * t.blocks + helper : stopTask;
              else
                nextTask += (REUSE ? 1 : t.blocks);
              owned = nextTask;
            }
          }
        }
        taskBase += tasks;
        prev = end;

        if (end == t.m || (REUSE && GENERAL && nextTask >= stopTask)) break;
      }
    }
    if (prev == t.m) break;
  }
#if defined(SPLIT_CORE_CUBE)
  if (splitResidual) {

    CrossCoreSetFlag<0, PIPE_FIX>(6);
    CrossCoreWaitFlag<0>(6);
    if (done > fullWaves) {
      if (fullWaves & 1)
        CrossCoreSetFlag<2, PIPE_FIX>(3);
      else
        CrossCoreSetFlag<2, PIPE_FIX>(0);
    }
  }
  if constexpr (DOUBLE_C) {

    if (done > 1) CrossCoreWaitFlag<2>(4);
    if (done) CrossCoreWaitFlag<2>(1);
  } else if (done)
    CrossCoreWaitFlag<2>(1);
#endif
}
#if !defined(GMG_SEPARATE_BUILD) || defined(GMG_BUILD_LONGFLEX_RESIDUAL)
extern "C" __global__ __mix__(1, 2) void groupmatmulgelu_longflex_residual(
  GM_ADDR x, GM_ADDR w, GM_ADDR scale, GM_ADDR groups, GM_ADDR y, GM_ADDR workspace, GmgTiling t) {
  GmgComputeLongFlexSplitResidual<64, 512, false, false, true, false, true, false, 8192>(x, w, scale, groups, y, workspace, t);
}
#endif
struct GmgStreamTile {
  GlobalTensor<int8_t> x, w;
  uint32_t rows, cols;
};

template <uint32_t H, uint32_t W, bool HYBRID = false> class GmgTileStreamCube {
  static constexpr uint32_t BK = (W == 512 || HYBRID) ? 256 : 512;
  static constexpr uint32_t BW = HYBRID ? 512 : W;
  static constexpr uint32_t ABK = HYBRID ? 512 : BK;
  __aicore__ inline uint32_t WeightBlock(uint32_t rows) { return HYBRID && rows > 64 ? 512 : BK; }
  static_assert((H == 64 && (W == 256 || W == 512)) || (H == 128 && W == 256), "bounded L0C");
  TQue<TPosition::A1, 2> a1b;
  TQue<TPosition::B1, 2> b1b;
  TQue<TPosition::A2, 2> a2b;
  TQue<TPosition::B2, 2> b2b;
  TQue<TPosition::CO1, 1> c1b;
  GmgStreamTile current;
  uint32_t n_, k_;
  __aicore__ inline uint32_t Inner(uint32_t cols) { return W == 256 && !HYBRID ? 128 : (cols <= 128 ? 256 : (cols <= 256 ? 128 : 64)); }
  __aicore__ inline void LoadPair(const GmgStreamTile &tile, uint32_t base) {
    auto a1 = a1b.AllocTensor<int8_t>();
    auto b1 = b1b.AllocTensor<int8_t>();
    uint32_t pm = (tile.rows + 15) / 16 * 16, pn = (tile.cols + 31) / 32 * 32;
    const uint32_t bk = WeightBlock(tile.rows);
    uint32_t chunk = k_ - base < bk ? k_ - base : bk, ik = Inner(pn), pk = (chunk + ik - 1) / ik * ik;
    if (tile.rows != pm || chunk != pk) {

      uint32_t fragments = chunk / 32;
      if (tile.rows != pm && fragments)
        InitConstValue(
          a1.ReinterpretCast<uint32_t>()[tile.rows * 8], InitConstValueParams<uint32_t>{uint16_t(fragments), uint16_t(pm - tile.rows), uint16_t(tile.rows), 0});
      if (fragments * 32 < pk)
        InitConstValue(a1.ReinterpretCast<uint32_t>()[fragments * pm * 8], InitConstValueParams<uint32_t>{1, uint16_t((pk - fragments * 32) * pm / 32), 0, 0});
      PipeBarrier<PIPE_MTE2>();
    }
    Nd2NzParams ap{};
    ap.ndNum = 1;
    ap.nValue = tile.rows;
    ap.dValue = chunk;
    ap.srcDValue = k_;
    ap.dstNzC0Stride = pm;
    ap.dstNzNStride = 1;
    DataCopy(a1, tile.x[base], ap);
    a1b.EnQue(a1);
    if (chunk != pk) {
      InitConstValue(b1.ReinterpretCast<uint32_t>(), InitConstValueParams<uint32_t>{1, uint16_t(pk * pn / 32), 0, 0});
      PipeBarrier<PIPE_MTE2>();
    }
    Nd2NzParams bp{};
    bp.ndNum = 1;
    bp.nValue = chunk;
    bp.dValue = tile.cols;
    bp.srcDValue = n_;
    bp.dstNzC0Stride = pk;
    bp.dstNzNStride = 1;
    DataCopy(b1, tile.w[uint64_t(base) * n_], bp);
    b1b.EnQue(b1);
  }
  __aicore__ inline void Compute(GlobalTensor<int32_t> result, const GmgStreamTile *next, uint32_t ordinal) {
    auto c = c1b.AllocTensor<int32_t>();
    uint32_t pm = (current.rows + 15) / 16 * 16, pn = (current.cols + 31) / 32 * 32, ik = Inner(pn);
    const uint32_t bk = WeightBlock(current.rows);
    for (uint32_t base = 0; base < k_; base += bk) {
      uint32_t chunk = k_ - base < bk ? k_ - base : bk, pk = (chunk + ik - 1) / ik * ik;
      auto a1 = a1b.DeQue<int8_t>();
      auto b1 = b1b.DeQue<int8_t>();
      if (base + bk < k_)
        LoadPair(current, base + bk);
      else if (next)
        LoadPair(*next, 0);
      for (uint32_t inner = 0; inner < pk; inner += ik) {
        auto a2 = a2b.AllocTensor<int8_t>();
        auto b2 = b2b.AllocTensor<int8_t>();
        LoadData2dParams al{};
        al.repeatTimes = ik / 32;
        al.srcStride = pm / 16;
        for (uint32_t m = 0; m < pm; m += 16) LoadData(a2[m * ik], a1[inner * pm + m * 32], al);
        LoadData2dTransposeParams bl{};
        bl.repeatTimes = pn / 32;
        bl.srcStride = pk / 32;
        bl.dstGap = 1;
        for (uint32_t kk = 0; kk < ik; kk += 32) LoadDataWithTranspose(b2[kk * pn], b1[(inner + kk) * 32], bl);
        a2b.EnQue(a2);
        b2b.EnQue(b2);
        a2 = a2b.DeQue<int8_t>();
        b2 = b2b.DeQue<int8_t>();
        MmadParams mad{};
        mad.m = pm;
        mad.n = pn;
        mad.k = ik;
        mad.cmatrixInitVal = (base == 0 && inner == 0);
        Mmad(c, a2, b2, mad);
        PipeBarrier<PIPE_M>();
        a2b.FreeTensor(a2);
        b2b.FreeTensor(b2);
      }
      a1b.FreeTensor(a1);
      b1b.FreeTensor(b1);
    }
    c1b.EnQue(c);
    c = c1b.DeQue<int32_t>();
    FixpipeParamsV220 fix{};
    fix.nSize = pn;
    fix.mSize = current.rows;
    fix.srcStride = pm;
    fix.dstStride = HYBRID ? (current.rows > 64 ? 256 : 512) : W;

    if (!ordinal)
      CrossCoreWaitFlag<2>(2);
    else if (ordinal >= 2) {
      if (ordinal & 1)
        CrossCoreWaitFlag<2>(4);
      else
        CrossCoreWaitFlag<2>(1);
    }
    Fixpipe<int32_t, int32_t, CFG_ROW_MAJOR>(result, c, fix);
    c1b.FreeTensor(c);
  }

public:
  __aicore__ inline void Init(TPipe &pipe, uint32_t n, uint32_t k) {
    n_ = n;
    k_ = k;
    pipe.InitBuffer(a1b, 2, H * ABK);
    pipe.InitBuffer(b1b, 2, BW * BK);
    pipe.InitBuffer(a2b, 2, H * ((W == 512 || HYBRID) ? 256 : 128));
    pipe.InitBuffer(b2b, 2, 32768);
    pipe.InitBuffer(c1b, 1, H * W * 4);
  }
  __aicore__ inline void Prime(const GmgStreamTile &tile) {
    current = tile;
    LoadPair(current, 0);
  }
  __aicore__ inline void Advance(GlobalTensor<int32_t> dst, const GmgStreamTile &next, uint32_t ordinal) {
    Compute(dst, &next, ordinal);
    current = next;
  }
  __aicore__ inline void Drain(GlobalTensor<int32_t> dst, uint32_t ordinal) { Compute(dst, nullptr, ordinal); }
};

template <uint32_t H, uint32_t W, bool HYBRID = false> class GmgHybridPersistentStreamCube {
  static constexpr uint32_t BK = (W == 512 || HYBRID) ? 256 : 512;
  static constexpr uint32_t BW = HYBRID ? 512 : W;
  static constexpr uint32_t ABK = HYBRID ? 1024 : BK;
  __aicore__ inline uint32_t WeightBlock(uint32_t rows) { return HYBRID && rows > 64 ? 512 : BK; }
  static_assert((H == 64 && (W == 256 || W == 512)) || (H == 128 && W == 256), "bounded L0C");
  TQue<TPosition::A1, 2> a1b;
  TQue<TPosition::B1, 2> b1b;
  TQue<TPosition::A2, 2> a2b;
  TQue<TPosition::B2, 2> b2b;
  TQue<TPosition::CO1, 1> c1b;
  GmgStreamTile current;
  uint32_t n_, k_;
  __aicore__ inline uint32_t Inner(uint32_t cols) { return W == 256 && !HYBRID ? 128 : (cols <= 128 ? 256 : (cols <= 256 ? 128 : 64)); }
  __aicore__ inline void LoadPair(const GmgStreamTile &tile, uint32_t base) {
    const bool keepA = HYBRID && tile.rows <= 64;
    const uint32_t pm = (tile.rows + 15) / 16 * 16, pn = (tile.cols + 31) / 32 * 32;
    const uint32_t bk = WeightBlock(tile.rows);
    const uint32_t chunk = k_ - base < bk ? k_ - base : bk, ik = Inner(pn), pk = (chunk + ik - 1) / ik * ik;
    if (!keepA || !base) {
      auto a1 = a1b.AllocTensor<int8_t>();
      const uint32_t ac = keepA ? k_ : chunk;
      const uint32_t apk = (ac + ik - 1) / ik * ik;
      if (tile.rows != pm || ac != apk) {
        const uint32_t fragments = ac / 32;
        if (tile.rows != pm && fragments)
          InitConstValue(a1.ReinterpretCast<uint32_t>()[tile.rows * 8],
            InitConstValueParams<uint32_t>{uint16_t(fragments), uint16_t(pm - tile.rows), uint16_t(tile.rows), 0});
        if (fragments * 32 < apk)
          InitConstValue(
            a1.ReinterpretCast<uint32_t>()[fragments * pm * 8], InitConstValueParams<uint32_t>{1, uint16_t((apk - fragments * 32) * pm / 32), 0, 0});
        PipeBarrier<PIPE_MTE2>();
      }
      Nd2NzParams ap{};
      ap.ndNum = 1;
      ap.nValue = tile.rows;
      ap.dValue = ac;
      ap.srcDValue = k_;
      ap.dstNzC0Stride = pm;
      ap.dstNzNStride = 1;
      DataCopy(a1, tile.x[base], ap);
      a1b.EnQue(a1);
    }
    auto b1 = b1b.AllocTensor<int8_t>();
    if (chunk != pk) {
      InitConstValue(b1.ReinterpretCast<uint32_t>(), InitConstValueParams<uint32_t>{1, uint16_t(pk * pn / 32), 0, 0});
      PipeBarrier<PIPE_MTE2>();
    }
    Nd2NzParams bp{};
    bp.ndNum = 1;
    bp.nValue = chunk;
    bp.dValue = tile.cols;
    bp.srcDValue = n_;
    bp.dstNzC0Stride = pk;
    bp.dstNzNStride = 1;
    DataCopy(b1, tile.w[uint64_t(base) * n_], bp);
    b1b.EnQue(b1);
  }
  __aicore__ inline void Compute(GlobalTensor<int32_t> result, const GmgStreamTile *next, uint32_t ordinal) {
    auto c = c1b.AllocTensor<int32_t>();
    uint32_t pm = (current.rows + 15) / 16 * 16, pn = (current.cols + 31) / 32 * 32, ik = Inner(pn);
    const uint32_t bk = WeightBlock(current.rows);
    const bool keepA = HYBRID && current.rows <= 64;
    LocalTensor<int8_t> a1;
    for (uint32_t base = 0; base < k_; base += bk) {
      uint32_t chunk = k_ - base < bk ? k_ - base : bk, pk = (chunk + ik - 1) / ik * ik;
      if (!keepA || !base) a1 = a1b.DeQue<int8_t>();
      auto b1 = b1b.DeQue<int8_t>();
      if (base + bk < k_)
        LoadPair(current, base + bk);
      else if (next)
        LoadPair(*next, 0);
      for (uint32_t inner = 0; inner < pk; inner += ik) {
        auto a2 = a2b.AllocTensor<int8_t>();
        auto b2 = b2b.AllocTensor<int8_t>();
        LoadData2dParams al{};
        al.repeatTimes = ik / 32;
        al.srcStride = pm / 16;
        for (uint32_t m = 0; m < pm; m += 16) LoadData(a2[m * ik], a1[((keepA ? base : 0) + inner) * pm + m * 32], al);
        LoadData2dTransposeParams bl{};
        bl.repeatTimes = pn / 32;
        bl.srcStride = pk / 32;
        bl.dstGap = 1;
        for (uint32_t kk = 0; kk < ik; kk += 32) LoadDataWithTranspose(b2[kk * pn], b1[(inner + kk) * 32], bl);
        a2b.EnQue(a2);
        b2b.EnQue(b2);
        a2 = a2b.DeQue<int8_t>();
        b2 = b2b.DeQue<int8_t>();
        MmadParams mad{};
        mad.m = pm;
        mad.n = pn;
        mad.k = ik;
        mad.cmatrixInitVal = (base == 0 && inner == 0);
        Mmad(c, a2, b2, mad);
        PipeBarrier<PIPE_M>();
        a2b.FreeTensor(a2);
        b2b.FreeTensor(b2);
      }
      if (!keepA || base + bk >= k_) a1b.FreeTensor(a1);
      b1b.FreeTensor(b1);
    }
    c1b.EnQue(c);
    c = c1b.DeQue<int32_t>();
    FixpipeParamsV220 fix{};
    fix.nSize = pn;
    fix.mSize = current.rows;
    fix.srcStride = pm;
    fix.dstStride = HYBRID ? (current.rows > 64 ? 256 : 512) : W;

    if (!ordinal)
      CrossCoreWaitFlag<2>(2);
    else if (ordinal >= 2) {
      if (ordinal & 1)
        CrossCoreWaitFlag<2>(4);
      else
        CrossCoreWaitFlag<2>(1);
    }
    Fixpipe<int32_t, int32_t, CFG_ROW_MAJOR>(result, c, fix);
    c1b.FreeTensor(c);
  }

public:
  __aicore__ inline void Init(TPipe &pipe, uint32_t n, uint32_t k) {
    n_ = n;
    k_ = k;
    pipe.InitBuffer(a1b, 2, H * ABK);
    pipe.InitBuffer(b1b, 2, BW * BK);
    pipe.InitBuffer(a2b, 2, H * ((W == 512 || HYBRID) ? 256 : 128));
    pipe.InitBuffer(b2b, 2, 32768);
    pipe.InitBuffer(c1b, 1, H * W * 4);
  }
  __aicore__ inline void Prime(const GmgStreamTile &tile) {
    current = tile;
    LoadPair(current, 0);
  }
  __aicore__ inline void Advance(GlobalTensor<int32_t> dst, const GmgStreamTile &next, uint32_t ordinal) {
    Compute(dst, &next, ordinal);
    current = next;
  }
  __aicore__ inline void Drain(GlobalTensor<int32_t> dst, uint32_t ordinal) { Compute(dst, nullptr, ordinal); }
};

template <uint32_t BM, uint32_t BN, bool MDL = false, bool REUSE = false, bool DIRECT = false, bool PADDED = false, bool GENERAL = false, bool STREAM = false,
  uint32_t DIRECT_MAX_K = 2048, bool FORCE_DOUBLE = false, bool ROTATE_TAIL = false, bool BALANCED_N = false>
__aicore__ inline void GmgComputePipelined(GM_ADDR x, GM_ADDR w, GM_ADDR scale, GM_ADDR groups, GM_ADDR y, GM_ADDR workspace, const GmgTiling &t) {
  constexpr uint32_t ELEMS = BM * BN, VR = 2, VELEMS = (BM > 64 ? 64 : BM) * BN / VR;
  constexpr bool DOUBLE_C = (BM == 128 || FORCE_DOUBLE);
  static_assert(
    !FORCE_DOUBLE || (BM == 64 && BN == 256 && DIRECT && !GENERAL && !REUSE && !PADDED && !STREAM), "extra C bank is restricted to direct M64/N256");
  TPipe pipe;
  const uint32_t core = GetBlockIdx() / GetTaskRation();
  typename Conditional<PADDED, GmgWordWeightPacker, GmgNoWeightPacker>::type packer;
  if constexpr (PADDED) {
    auto padded = workspace + uint64_t(t.blocks) * t.bm * t.bn * 4 + uint64_t(core) * ((t.k + 511) / 512 * 512) * ((t.n + 31) / 32 * 32);
    packer.Init(w, padded, t, pipe);
    w = padded;
  }
  GlobalTensor<int8_t> xg, wg;
  GlobalTensor<int64_t> gg;
  GlobalTensor<float> sg;
  GlobalTensor<half> yg;
  GlobalTensor<int32_t> cg;
  xg.SetGlobalBuffer((__gm__ int8_t *)x);
  wg.SetGlobalBuffer((__gm__ int8_t *)w);
  gg.SetGlobalBuffer((__gm__ int64_t *)groups);
  sg.SetGlobalBuffer((__gm__ float *)scale);
  yg.SetGlobalBuffer((__gm__ half *)y);
  cg.SetGlobalBuffer((__gm__ int32_t *)workspace + core * ELEMS * ((DOUBLE_C || (REUSE && GENERAL)) ? 2 : 1));

#if defined(SPLIT_CORE_CUBE)
  typename Conditional<BALANCED_N, GmgHybridPersistentStreamCube<BM, BN, true>, GmgTileStreamCube<BM, BN>>::type mm;
  mm.Init(pipe, t.n, t.k);
#endif

#if defined(SPLIT_CORE_VEC)
  TBuf<TPosition::VECCALC> ab, zb, ub, vb, pb, sb, hb, maskb1, maskb2, groupBuffer;
  pipe.InitBuffer(ab, (VELEMS * 4) + 256);
  pipe.InitBuffer(zb, (VELEMS * 4) + 256);
  pipe.InitBuffer(ub, (VELEMS * 4) + 256);
  pipe.InitBuffer(vb, (VELEMS * 4) + 256);
  pipe.InitBuffer(pb, (VELEMS * 4) + 256);
  pipe.InitBuffer(sb, ((BALANCED_N ? 512 : BN) * 4) + 256);
  pipe.InitBuffer(hb, (VELEMS * 2) + 256);
  pipe.InitBuffer(maskb1, (VELEMS / 8) + 256);
  pipe.InitBuffer(maskb2, (VELEMS / 8) + 256);
  auto a = ab.Get<int32_t>();
  auto z = zb.Get<float>();
  auto u = ub.Get<float>();
  auto v = vb.Get<float>();
  auto p = pb.Get<float>();
  auto s = sb.Get<float>();
  auto h = hb.Get<half>();
  auto mask1 = maskb1.Get<uint8_t>();
  auto mask2 = maskb2.Get<uint8_t>();

  LocalTensor<int64_t> localGroups;
  bool useLocalGroups = false;
  if constexpr ((DIRECT && BN == 256 && !GENERAL) || (REUSE && GENERAL)) {
    pipe.InitBuffer(groupBuffer, 128 * 8);
    localGroups = groupBuffer.Get<int64_t>();
    useLocalGroups = t.e >= 16;
    if (useLocalGroups) {
      GlobalTensor<int32_t> groupWords;
      groupWords.SetGlobalBuffer((__gm__ int32_t *)groups);
      DataCopyPad(groupBuffer.Get<int32_t>(), groupWords, DataCopyExtParams{1, t.e * 8, 0, 0, 0},
        DataCopyPadExtParams<int32_t>{true, 0, uint8_t((4 - t.e % 4) % 4 * 2), 0});
      SetFlag<HardEvent::MTE2_S>(EVENT_ID0);
      WaitFlag<HardEvent::MTE2_S>(EVENT_ID0);
    }
  }

  Duplicate(a, int32_t(0), VELEMS);
  if (t.n % BN) Duplicate(u, 0.0f, VELEMS);
  SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
  WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
  if constexpr (DOUBLE_C) {
    for (uint32_t slot = 0; slot < 2; ++slot)
      for (uint32_t offset = 0; offset < ELEMS / VR; offset += VELEMS) DataCopy(cg[slot * ELEMS + GetSubBlockIdx() * (ELEMS / VR) + offset], a, VELEMS);
  } else
    DataCopy(cg[GetSubBlockIdx() * VELEMS], a, VELEMS);
  CrossCoreSetFlag<2, PIPE_MTE3>(2);
  if (t.n % BN) {
    Duplicate(s, 0.0f, BALANCED_N ? 512 : BN);
    SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
    WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
  }
#endif
  uint32_t taskBase = 0, prev = 0, done = 0, nextTask = core, packedExpert = t.e;

  const uint32_t nt = BN == 64 ? 1 : (t.n + BN - 1) / BN;
  uint32_t columnPhase = 0;
#if defined(SPLIT_CORE_VEC)
  uint32_t firstExpert = useLocalGroups ? GmgFirstExpert(localGroups, t.e) : GmgFirstExpert(gg, t.e);
#else
  uint32_t firstExpert = GmgFirstExpert(gg, t.e);
#endif
  uint32_t stopTask = 0xffffffffU, runRemaining = 0;
  if constexpr (REUSE) {
    uint32_t total = 0, before = 0;
    for (uint32_t e = firstExpert; e < t.e; ++e) {
      uint32_t end =
#if defined(SPLIT_CORE_VEC)
        useLocalGroups ? localGroups.GetValue(e) : gg.GetValue(e);
#else
        gg.GetValue(e);
#endif
      total += (end - before + BM - 1) / BM * nt;
      before = end;
      if (end == t.m) break;
    }
    nextTask = total * core / t.blocks;
    stopTask = total * (core + 1) / t.blocks;
  }
  for (uint32_t e = firstExpert; e < t.e; ++e) {
    uint32_t end =
#if defined(SPLIT_CORE_VEC)
      useLocalGroups ? localGroups.GetValue(e) : gg.GetValue(e);
#else
      gg.GetValue(e);
#endif
    uint32_t len = end - prev, mt = (len + BM - 1) / BM;
    const uint32_t m64 = (len + 63) / 64;
    const uint32_t pairs = m64 - mt, single = m64 % 2;
    const uint32_t smallPanels = t.n / 512 + 1;
    const uint32_t tasks = BALANCED_N ? pairs * nt + single * smallPanels : mt * nt;

    for (; nextTask < taskBase + tasks && nextTask < stopTask; nextTask += (REUSE ? 1 : t.blocks)) {
      uint32_t local = nextTask - taskBase;
      uint32_t mr = (BN == 64 ? local : (REUSE ? local % mt : local / nt)) * BM;
      uint32_t nc = BN == 64 ? 0 : (REUSE ? local / mt : local % nt) * BN;
      if constexpr (ROTATE_TAIL) {
        uint32_t panel = local % nt + columnPhase;
        nc = (panel < nt ? panel : panel - nt) * BN;
      }
      uint32_t rows = (len - mr < BM ? len - mr : BM), cols = (t.n - nc < BN ? t.n - nc : BN);
      if constexpr (BALANCED_N) {
        if (local < pairs * nt) {
          const uint32_t units = t.n / 32, q = units / nt, r = units % nt, col = local % nt;
          nc = (col * q + (col < r ? col : r)) * 32;
          cols = (q + uint32_t(col < r)) * 32;
        } else {

          mr = pairs * 128;
          nc = (local - pairs * nt) * 512;
          rows = len - mr;
          cols = t.n - nc < 512 ? t.n - nc : 512;
        }
      }
      if constexpr (PADDED)
        if (packedExpert != e) {
          packer.Pack(e, 0, t.k);
          packedExpert = e;
        }
#if defined(SPLIT_CORE_CUBE)
      GmgStreamTile tile{xg[uint64_t(prev + mr) * t.k], wg[uint64_t(e) * t.k * t.n + nc], rows, cols};
      if (!done)
        mm.Prime(tile);
      else {
        uint32_t prior = done - 1;
        mm.Advance(cg[(prior & 1) * ELEMS], tile, prior);
        if (prior & 1)
          CrossCoreSetFlag<2, PIPE_FIX>(3);
        else
          CrossCoreSetFlag<2, PIPE_FIX>(0);
      }
#endif
#if defined(SPLIT_CORE_VEC)
      if constexpr (DOUBLE_C) {
        const uint32_t cPitch = BALANCED_N ? (rows > 64 ? 256 : 512) : BN;
        const uint32_t stride = BALANCED_N ? (cols + 63) / 64 * 64 : BN;
        const uint32_t chunkRows = BALANCED_N ? 8192 / stride : 32;
        uint32_t vectorRows = (rows + VR - 1) / VR;
        uint32_t rowOffset = GetSubBlockIdx() * vectorRows;
        rows = rows > rowOffset ? (rows - rowOffset < vectorRows ? rows - rowOffset : vectorRows) : 0;
        if (rows) DataCopyPad(s, sg[(uint64_t)e * t.n + nc], DataCopyExtParams{1, cols * 4, 0, 0, 0}, DataCopyPadExtParams<float>{true, 0, 0, 0});
        if (done & 1)
          CrossCoreWaitFlag<2>(3);
        else
          CrossCoreWaitFlag<2>(0);

        const bool prefetch = rows > chunkRows;
        if (prefetch) {
          auto nextRaw = u.ReinterpretCast<int32_t>();
          if (cols == cPitch && stride == cPitch) {
            DataCopy(a, cg[(done & 1) * ELEMS + rowOffset * cPitch], chunkRows * stride);
            SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
            DataCopy(nextRaw, cg[(done & 1) * ELEMS + (rowOffset + chunkRows) * cPitch], (rows - chunkRows) * stride);
          } else {
            DataCopyPad(a, cg[(done & 1) * ELEMS + rowOffset * cPitch],
              DataCopyExtParams{uint16_t(chunkRows), cols * 4, (cPitch - cols) * 4, (stride - ((cols + 7) / 8 * 8)) / 8, 0},
              DataCopyPadExtParams<int32_t>{true, 0, 0, 0});
            SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
            DataCopyPad(nextRaw, cg[(done & 1) * ELEMS + (rowOffset + chunkRows) * cPitch],
              DataCopyExtParams{uint16_t(rows - chunkRows), cols * 4, (cPitch - cols) * 4, (stride - ((cols + 7) / 8 * 8)) / 8, 0},
              DataCopyPadExtParams<int32_t>{true, 0, 0, 0});
          }
          SetFlag<HardEvent::MTE2_V>(EVENT_ID1);
          if (done & 1)
            CrossCoreSetFlag<2, PIPE_MTE2>(4);
          else
            CrossCoreSetFlag<2, PIPE_MTE2>(1);
        }
        uint32_t chunks = prefetch ? 2 : 1;
        for (uint32_t chunk = 0; chunk < chunks; ++chunk) {
          uint32_t first = chunk * chunkRows;
          uint32_t currentRows = rows > first ? (rows - first < chunkRows ? rows - first : chunkRows) : 0;
          if (!prefetch && currentRows) {
            if (cols == cPitch && stride == cPitch)
              DataCopy(a, cg[(done & 1) * ELEMS + (rowOffset + first) * cPitch], currentRows * stride);
            else
              DataCopyPad(a, cg[(done & 1) * ELEMS + (rowOffset + first) * cPitch],
                DataCopyExtParams{uint16_t(currentRows), cols * 4, (cPitch - cols) * 4, (stride - ((cols + 7) / 8 * 8)) / 8, 0},
                DataCopyPadExtParams<int32_t>{true, 0, 0, 0});
          }
          if (!prefetch) {
            SetFlag<HardEvent::MTE2_S>(EVENT_ID0);
            WaitFlag<HardEvent::MTE2_S>(EVENT_ID0);
            if (done & 1)
              CrossCoreSetFlag<2, PIPE_MTE2>(4);
            else
              CrossCoreSetFlag<2, PIPE_MTE2>(1);
          }
          if (currentRows) {
            if (!prefetch) SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
            if (chunk == 0)
              WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
            else
              WaitFlag<HardEvent::MTE2_V>(EVENT_ID1);
            uint32_t count = currentRows * stride;
            auto raw = chunk ? u.ReinterpretCast<int32_t>() : a;
            Cast(z, raw, RoundMode::CAST_RINT, count);
            for (uint32_t c = 0; c < stride; c += 64)
              Mul(z[c], z[c], s[c], uint64_t(64), uint8_t(currentRows), BinaryRepeatParams{1, 1, 1, uint8_t(stride / 8), uint8_t(stride / 8), 0});
            if constexpr (REUSE || (BM == 128 && !STREAM)) {
              if (prefetch)
                GmgGeluSmall<true, false, true>(z, h, raw.ReinterpretCast<float>(), v, p, raw, mask1, mask2, count);
              else
                GmgGeluSmall<true>(z, h, u, v, p, a, mask1, mask2, count);
            } else
              GmgGelu<true>(z, h, u, v, p, a, mask1, mask2, count);
            SetFlag<HardEvent::S_MTE3>(EVENT_ID0);
            WaitFlag<HardEvent::S_MTE3>(EVENT_ID0);
            SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
            WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
            DataCopyPad(yg[uint64_t(prev + mr + rowOffset + first) * t.n + nc], h,
              DataCopyExtParams{uint16_t(currentRows), cols * 2, (stride - ((cols + 15) / 16 * 16)) / 16, (t.n - cols) * 2, 0});
            SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
            WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
          }
        }
      } else {
        uint32_t vectorRows = (rows + VR - 1) / VR;
        uint32_t rowOffset = GetSubBlockIdx() * vectorRows;
        rows = rows > rowOffset ? (rows - rowOffset < vectorRows ? rows - rowOffset : vectorRows) : 0;
        mr += rowOffset;

        if (rows) DataCopyPad(s, sg[(uint64_t)e * t.n + nc], DataCopyExtParams{1, cols * 4, 0, 0, 0}, DataCopyPadExtParams<float>{true, 0, 0, 0});
        CrossCoreWaitFlag<2>(0);
        if (rows) {
          if (cols == BN)
            DataCopy(a, cg[(REUSE && GENERAL ? (done & 1) * ELEMS : 0) + rowOffset * BN], rows * BN);
          else
            DataCopyPad(a, cg[(REUSE && GENERAL ? (done & 1) * ELEMS : 0) + rowOffset * ((REUSE && !GENERAL) ? cols : BN)],
              DataCopyExtParams{(uint16_t)rows, cols * 4, ((REUSE && !GENERAL) ? 0 : (BN - cols) * 4), (BN - ((cols + 7) / 8 * 8)) / 8, 0},
              DataCopyPadExtParams<int32_t>{true, 0, 0, 0});
        }
        SetFlag<HardEvent::MTE2_S>(EVENT_ID0);
        WaitFlag<HardEvent::MTE2_S>(EVENT_ID0);
        CrossCoreSetFlag<2, PIPE_MTE2>(1);
        if (rows) {
          SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
          WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
          uint32_t count = rows * BN;
          Cast(z, a, RoundMode::CAST_RINT, count);

          for (uint32_t c = 0; c < BN; c += 64) Mul(z[c], z[c], s[c], uint64_t(64), uint8_t(rows), BinaryRepeatParams{1, 1, 1, BN / 8, BN / 8, 0});
          if constexpr (REUSE || (BM == 128 && !STREAM))
            GmgGeluSmall<DIRECT && BN == 256>(z, h, u, v, p, a, mask1, mask2, count);
          else
            GmgGelu<DIRECT && BN == 256>(z, h, u, v, p, a, mask1, mask2, count);
          SetFlag<HardEvent::S_MTE3>(EVENT_ID0);
          WaitFlag<HardEvent::S_MTE3>(EVENT_ID0);
          SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
          WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
          DataCopyPad(
            yg[(uint64_t)(prev + mr) * t.n + nc], h, DataCopyExtParams{(uint16_t)rows, cols * 2, (BN - ((cols + 15) / 16 * 16)) / 16, (t.n - cols) * 2, 0});
          SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
          WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
        }
      }
#endif
      ++done;
      if constexpr (ROTATE_TAIL)
        if (++columnPhase == nt) columnPhase = 0;
    }
    taskBase += tasks;
    prev = end;

    if (end == t.m || (REUSE && GENERAL && nextTask >= stopTask)) break;
  }
#if defined(SPLIT_CORE_CUBE)
  if (done) {
    uint32_t prior = done - 1;
    mm.Drain(cg[(prior & 1) * ELEMS], prior);
    if (prior & 1)
      CrossCoreSetFlag<2, PIPE_FIX>(3);
    else
      CrossCoreSetFlag<2, PIPE_FIX>(0);
  }
  if (done > 1) CrossCoreWaitFlag<2>(4);
  if (done)
    CrossCoreWaitFlag<2>(1);
  else
    CrossCoreWaitFlag<2>(2);
#endif
}
template <bool WHOLE_COUNT = false, bool WORD_FLAGS = false, bool ALIAS_RAW = false>
__aicore__ inline void GmgGeluSmallTightSubnormal(LocalTensor<float> z, LocalTensor<half> h, LocalTensor<float> u, LocalTensor<float> v, LocalTensor<float> p,
  LocalTensor<int32_t> a, LocalTensor<uint8_t> mask1, LocalTensor<uint8_t> mask2, uint32_t count) {
  SetMaskCount();
  SetVectorMask<float, MaskMode::COUNTER>(count);
  Mul<float, false>(u, z, z, MASK_PLACEHOLDER, 1, {1, 1, 1, 8, 8, 8});
  Muls<float, false>(u, u, -0.07135481759315014f, MASK_PLACEHOLDER, 1, {1, 1, 8, 8});
  Adds<float, false>(u, u, -1.5957691216057308f, MASK_PLACEHOLDER, 1, {1, 1, 8, 8});
  Mul<float, false>(u, u, z, MASK_PLACEHOLDER, 1, {1, 1, 1, 8, 8, 8});
  Mins<float, false>(u, u, 80.0f, MASK_PLACEHOLDER, 1, {1, 1, 8, 8});
  Exp<float, false>(u, u, MASK_PLACEHOLDER, 1, {1, 1, 8, 8});
  Adds<float, false>(u, u, 1.0f, MASK_PLACEHOLDER, 1, {1, 1, 8, 8});
  Div<float, false>(p, z, u, MASK_PLACEHOLDER, 1, {1, 1, 1, 8, 8, 8});
  Cast<half, float, false>(h, p, RoundMode::CAST_RINT, MASK_PLACEHOLDER, 1, {1, 1, 4, 8});
  SetMaskNorm();
  ResetMask();
  // Preserve the old routine's Vector-to-Scalar completion before caller DMA reuse.
  SetFlag<HardEvent::V_S>(EVENT_ID0);
  WaitFlag<HardEvent::V_S>(EVENT_ID0);
}

template <uint32_t BM, uint32_t BN, bool MDL = false, bool REUSE = false, bool DIRECT = false, bool PADDED = false, bool GENERAL = false, bool STREAM = false,
  uint32_t DIRECT_MAX_K = 2048, bool FORCE_DOUBLE = false, bool ROTATE_TAIL = false, bool BALANCED_N = false>
__aicore__ inline void GmgComputeTightSubnormal(GM_ADDR x, GM_ADDR w, GM_ADDR scale, GM_ADDR groups, GM_ADDR y, GM_ADDR workspace, const GmgTiling &t) {
  constexpr uint32_t ELEMS = BM * BN, VR = 2, VELEMS = (BM > 64 ? 64 : BM) * BN / VR;
  constexpr bool DOUBLE_C = (BM == 128 || FORCE_DOUBLE);
  static_assert(
    !FORCE_DOUBLE || (BM == 64 && BN == 256 && DIRECT && !GENERAL && !REUSE && !PADDED && !STREAM), "extra C bank is restricted to direct M64/N256");
  TPipe pipe;
  const uint32_t core = GetBlockIdx() / GetTaskRation();
  typename Conditional<PADDED, GmgWordWeightPacker, GmgNoWeightPacker>::type packer;
  if constexpr (PADDED) {
    auto padded = workspace + uint64_t(t.blocks) * t.bm * t.bn * 4 + uint64_t(core) * ((t.k + 511) / 512 * 512) * ((t.n + 31) / 32 * 32);
    packer.Init(w, padded, t, pipe);
    w = padded;
  }
  GlobalTensor<int8_t> xg, wg;
  GlobalTensor<int64_t> gg;
  GlobalTensor<float> sg;
  GlobalTensor<half> yg;
  GlobalTensor<int32_t> cg;
  xg.SetGlobalBuffer((__gm__ int8_t *)x);
  wg.SetGlobalBuffer((__gm__ int8_t *)w);
  gg.SetGlobalBuffer((__gm__ int64_t *)groups);
  sg.SetGlobalBuffer((__gm__ float *)scale);
  yg.SetGlobalBuffer((__gm__ half *)y);
  cg.SetGlobalBuffer((__gm__ int32_t *)workspace + core * ELEMS * ((DOUBLE_C || (REUSE && GENERAL)) ? 2 : 1));

#if defined(SPLIT_CORE_CUBE)
  typename Conditional<BALANCED_N, GmgHybridPersistentStreamCube<BM, BN, true>, GmgTileStreamCube<BM, BN>>::type mm;
  mm.Init(pipe, t.n, t.k);
#endif

#if defined(SPLIT_CORE_VEC)
  TBuf<TPosition::VECCALC> ab, zb, ub, vb, pb, sb, hb, maskb1, maskb2, groupBuffer;
  pipe.InitBuffer(ab, (VELEMS * 4) + 256);
  pipe.InitBuffer(zb, (VELEMS * 4) + 256);
  pipe.InitBuffer(ub, (VELEMS * 4) + 256);
  pipe.InitBuffer(vb, (VELEMS * 4) + 256);
  pipe.InitBuffer(pb, (VELEMS * 4) + 256);
  pipe.InitBuffer(sb, ((BALANCED_N ? 512 : BN) * 4) + 256);
  pipe.InitBuffer(hb, (VELEMS * 2) + 256);
  pipe.InitBuffer(maskb1, (VELEMS / 8) + 256);
  pipe.InitBuffer(maskb2, (VELEMS / 8) + 256);
  auto a = ab.Get<int32_t>();
  auto z = zb.Get<float>();
  auto u = ub.Get<float>();
  auto v = vb.Get<float>();
  auto p = pb.Get<float>();
  auto s = sb.Get<float>();
  auto h = hb.Get<half>();
  auto mask1 = maskb1.Get<uint8_t>();
  auto mask2 = maskb2.Get<uint8_t>();

  LocalTensor<int64_t> localGroups;
  bool useLocalGroups = false;
  if constexpr ((DIRECT && BN == 256 && !GENERAL) || (REUSE && GENERAL)) {
    pipe.InitBuffer(groupBuffer, 128 * 8);
    localGroups = groupBuffer.Get<int64_t>();
    useLocalGroups = t.e >= 16;
    if (useLocalGroups) {
      GlobalTensor<int32_t> groupWords;
      groupWords.SetGlobalBuffer((__gm__ int32_t *)groups);
      DataCopyPad(groupBuffer.Get<int32_t>(), groupWords, DataCopyExtParams{1, t.e * 8, 0, 0, 0},
        DataCopyPadExtParams<int32_t>{true, 0, uint8_t((4 - t.e % 4) % 4 * 2), 0});
      SetFlag<HardEvent::MTE2_S>(EVENT_ID0);
      WaitFlag<HardEvent::MTE2_S>(EVENT_ID0);
    }
  }

  Duplicate(a, int32_t(0), VELEMS);
  if (t.n % BN) Duplicate(u, 0.0f, VELEMS);
  SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
  WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
  if constexpr (DOUBLE_C) {
    for (uint32_t slot = 0; slot < 2; ++slot)
      for (uint32_t offset = 0; offset < ELEMS / VR; offset += VELEMS) DataCopy(cg[slot * ELEMS + GetSubBlockIdx() * (ELEMS / VR) + offset], a, VELEMS);
  } else
    DataCopy(cg[GetSubBlockIdx() * VELEMS], a, VELEMS);
  CrossCoreSetFlag<2, PIPE_MTE3>(2);
  if (t.n % BN) {
    Duplicate(s, 0.0f, BALANCED_N ? 512 : BN);
    SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
    WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
  }
#endif
  uint32_t taskBase = 0, prev = 0, done = 0, nextTask = core, packedExpert = t.e;

  const uint32_t nt = BN == 64 ? 1 : (t.n + BN - 1) / BN;
  uint32_t columnPhase = 0;
#if defined(SPLIT_CORE_VEC)
  uint32_t firstExpert = useLocalGroups ? GmgFirstExpert(localGroups, t.e) : GmgFirstExpert(gg, t.e);
#else
  uint32_t firstExpert = GmgFirstExpert(gg, t.e);
#endif
  uint32_t stopTask = 0xffffffffU, runRemaining = 0;
  if constexpr (REUSE) {
    uint32_t total = 0, before = 0;
    for (uint32_t e = firstExpert; e < t.e; ++e) {
      uint32_t end =
#if defined(SPLIT_CORE_VEC)
        useLocalGroups ? localGroups.GetValue(e) : gg.GetValue(e);
#else
        gg.GetValue(e);
#endif
      total += (end - before + BM - 1) / BM * nt;
      before = end;
      if (end == t.m) break;
    }
    nextTask = total * core / t.blocks;
    stopTask = total * (core + 1) / t.blocks;
  }
  for (uint32_t e = firstExpert; e < t.e; ++e) {
    uint32_t end =
#if defined(SPLIT_CORE_VEC)
      useLocalGroups ? localGroups.GetValue(e) : gg.GetValue(e);
#else
      gg.GetValue(e);
#endif
    uint32_t len = end - prev, mt = (len + BM - 1) / BM;
    const uint32_t m64 = (len + 63) / 64;
    const uint32_t pairs = m64 - mt, single = m64 % 2;
    const uint32_t smallPanels = t.n / 512 + 1;
    const uint32_t tasks = BALANCED_N ? pairs * nt + single * smallPanels : mt * nt;

    for (; nextTask < taskBase + tasks && nextTask < stopTask; nextTask += (REUSE ? 1 : t.blocks)) {
      uint32_t local = nextTask - taskBase;
      uint32_t mr = (BN == 64 ? local : (REUSE ? local % mt : local / nt)) * BM;
      uint32_t nc = BN == 64 ? 0 : (REUSE ? local / mt : local % nt) * BN;
      if constexpr (ROTATE_TAIL) {
        uint32_t panel = local % nt + columnPhase;
        nc = (panel < nt ? panel : panel - nt) * BN;
      }
      uint32_t rows = (len - mr < BM ? len - mr : BM), cols = (t.n - nc < BN ? t.n - nc : BN);
      if constexpr (BALANCED_N) {
        if (local < pairs * nt) {
          const uint32_t units = t.n / 32, q = units / nt, r = units % nt, col = local % nt;
          nc = (col * q + (col < r ? col : r)) * 32;
          cols = (q + uint32_t(col < r)) * 32;
        } else {

          mr = pairs * 128;
          nc = (local - pairs * nt) * 512;
          rows = len - mr;
          cols = t.n - nc < 512 ? t.n - nc : 512;
        }
      }
      if constexpr (PADDED)
        if (packedExpert != e) {
          packer.Pack(e, 0, t.k);
          packedExpert = e;
        }
#if defined(SPLIT_CORE_CUBE)
      GmgStreamTile tile{xg[uint64_t(prev + mr) * t.k], wg[uint64_t(e) * t.k * t.n + nc], rows, cols};
      if (!done)
        mm.Prime(tile);
      else {
        uint32_t prior = done - 1;
        mm.Advance(cg[(prior & 1) * ELEMS], tile, prior);
        if (prior & 1)
          CrossCoreSetFlag<2, PIPE_FIX>(3);
        else
          CrossCoreSetFlag<2, PIPE_FIX>(0);
      }
#endif
#if defined(SPLIT_CORE_VEC)
      if constexpr (DOUBLE_C) {
        const uint32_t cPitch = BALANCED_N ? (rows > 64 ? 256 : 512) : BN;
        const uint32_t stride = BALANCED_N ? (cols + 63) / 64 * 64 : BN;
        const uint32_t chunkRows = BALANCED_N ? 8192 / stride : 32;
        uint32_t vectorRows = (rows + VR - 1) / VR;
        uint32_t rowOffset = GetSubBlockIdx() * vectorRows;
        rows = rows > rowOffset ? (rows - rowOffset < vectorRows ? rows - rowOffset : vectorRows) : 0;
        if (rows) DataCopyPad(s, sg[(uint64_t)e * t.n + nc], DataCopyExtParams{1, cols * 4, 0, 0, 0}, DataCopyPadExtParams<float>{true, 0, 0, 0});
        if (done & 1)
          CrossCoreWaitFlag<2>(3);
        else
          CrossCoreWaitFlag<2>(0);

        const bool prefetch = rows > chunkRows;
        if (prefetch) {
          auto nextRaw = u.ReinterpretCast<int32_t>();
          if (cols == cPitch && stride == cPitch) {
            DataCopy(a, cg[(done & 1) * ELEMS + rowOffset * cPitch], chunkRows * stride);
            SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
            DataCopy(nextRaw, cg[(done & 1) * ELEMS + (rowOffset + chunkRows) * cPitch], (rows - chunkRows) * stride);
          } else {
            DataCopyPad(a, cg[(done & 1) * ELEMS + rowOffset * cPitch],
              DataCopyExtParams{uint16_t(chunkRows), cols * 4, (cPitch - cols) * 4, (stride - ((cols + 7) / 8 * 8)) / 8, 0},
              DataCopyPadExtParams<int32_t>{true, 0, 0, 0});
            SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
            DataCopyPad(nextRaw, cg[(done & 1) * ELEMS + (rowOffset + chunkRows) * cPitch],
              DataCopyExtParams{uint16_t(rows - chunkRows), cols * 4, (cPitch - cols) * 4, (stride - ((cols + 7) / 8 * 8)) / 8, 0},
              DataCopyPadExtParams<int32_t>{true, 0, 0, 0});
          }
          SetFlag<HardEvent::MTE2_V>(EVENT_ID1);
          if (done & 1)
            CrossCoreSetFlag<2, PIPE_MTE2>(4);
          else
            CrossCoreSetFlag<2, PIPE_MTE2>(1);
        }
        uint32_t chunks = prefetch ? 2 : 1;
        for (uint32_t chunk = 0; chunk < chunks; ++chunk) {
          uint32_t first = chunk * chunkRows;
          uint32_t currentRows = rows > first ? (rows - first < chunkRows ? rows - first : chunkRows) : 0;
          if (!prefetch && currentRows) {
            if (cols == cPitch && stride == cPitch)
              DataCopy(a, cg[(done & 1) * ELEMS + (rowOffset + first) * cPitch], currentRows * stride);
            else
              DataCopyPad(a, cg[(done & 1) * ELEMS + (rowOffset + first) * cPitch],
                DataCopyExtParams{uint16_t(currentRows), cols * 4, (cPitch - cols) * 4, (stride - ((cols + 7) / 8 * 8)) / 8, 0},
                DataCopyPadExtParams<int32_t>{true, 0, 0, 0});
          }
          if (!prefetch) {
            SetFlag<HardEvent::MTE2_S>(EVENT_ID0);
            WaitFlag<HardEvent::MTE2_S>(EVENT_ID0);
            if (done & 1)
              CrossCoreSetFlag<2, PIPE_MTE2>(4);
            else
              CrossCoreSetFlag<2, PIPE_MTE2>(1);
          }
          if (currentRows) {
            if (!prefetch) SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
            if (chunk == 0)
              WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
            else
              WaitFlag<HardEvent::MTE2_V>(EVENT_ID1);
            uint32_t count = currentRows * stride;
            auto raw = chunk ? u.ReinterpretCast<int32_t>() : a;
            Cast(z, raw, RoundMode::CAST_RINT, count);
            for (uint32_t c = 0; c < stride; c += 64)
              Mul(z[c], z[c], s[c], uint64_t(64), uint8_t(currentRows), BinaryRepeatParams{1, 1, 1, uint8_t(stride / 8), uint8_t(stride / 8), 0});
            if constexpr (REUSE || (BM == 128 && !STREAM)) {
              if (prefetch)
                GmgGeluSmallTightSubnormal<true, false, true>(z, h, raw.ReinterpretCast<float>(), v, p, raw, mask1, mask2, count);
              else
                GmgGeluSmallTightSubnormal<true>(z, h, u, v, p, a, mask1, mask2, count);
            } else
              GmgGelu<true>(z, h, u, v, p, a, mask1, mask2, count);
            SetFlag<HardEvent::S_MTE3>(EVENT_ID0);
            WaitFlag<HardEvent::S_MTE3>(EVENT_ID0);
            SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
            WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
            DataCopyPad(yg[uint64_t(prev + mr + rowOffset + first) * t.n + nc], h,
              DataCopyExtParams{uint16_t(currentRows), cols * 2, (stride - ((cols + 15) / 16 * 16)) / 16, (t.n - cols) * 2, 0});
            SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
            WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
          }
        }
      } else {
        uint32_t vectorRows = (rows + VR - 1) / VR;
        uint32_t rowOffset = GetSubBlockIdx() * vectorRows;
        rows = rows > rowOffset ? (rows - rowOffset < vectorRows ? rows - rowOffset : vectorRows) : 0;
        mr += rowOffset;

        if (rows) DataCopyPad(s, sg[(uint64_t)e * t.n + nc], DataCopyExtParams{1, cols * 4, 0, 0, 0}, DataCopyPadExtParams<float>{true, 0, 0, 0});
        CrossCoreWaitFlag<2>(0);
        if (rows) {
          if (cols == BN)
            DataCopy(a, cg[(REUSE && GENERAL ? (done & 1) * ELEMS : 0) + rowOffset * BN], rows * BN);
          else
            DataCopyPad(a, cg[(REUSE && GENERAL ? (done & 1) * ELEMS : 0) + rowOffset * ((REUSE && !GENERAL) ? cols : BN)],
              DataCopyExtParams{(uint16_t)rows, cols * 4, ((REUSE && !GENERAL) ? 0 : (BN - cols) * 4), (BN - ((cols + 7) / 8 * 8)) / 8, 0},
              DataCopyPadExtParams<int32_t>{true, 0, 0, 0});
        }
        SetFlag<HardEvent::MTE2_S>(EVENT_ID0);
        WaitFlag<HardEvent::MTE2_S>(EVENT_ID0);
        CrossCoreSetFlag<2, PIPE_MTE2>(1);
        if (rows) {
          SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
          WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
          uint32_t count = rows * BN;
          Cast(z, a, RoundMode::CAST_RINT, count);

          for (uint32_t c = 0; c < BN; c += 64) Mul(z[c], z[c], s[c], uint64_t(64), uint8_t(rows), BinaryRepeatParams{1, 1, 1, BN / 8, BN / 8, 0});
          if constexpr (REUSE || (BM == 128 && !STREAM))
            GmgGeluSmallTightSubnormal<DIRECT && BN == 256>(z, h, u, v, p, a, mask1, mask2, count);
          else
            GmgGelu<DIRECT && BN == 256>(z, h, u, v, p, a, mask1, mask2, count);
          SetFlag<HardEvent::S_MTE3>(EVENT_ID0);
          WaitFlag<HardEvent::S_MTE3>(EVENT_ID0);
          SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
          WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
          DataCopyPad(
            yg[(uint64_t)(prev + mr) * t.n + nc], h, DataCopyExtParams{(uint16_t)rows, cols * 2, (BN - ((cols + 15) / 16 * 16)) / 16, (t.n - cols) * 2, 0});
          SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
          WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
        }
      }
#endif
      ++done;
      if constexpr (ROTATE_TAIL)
        if (++columnPhase == nt) columnPhase = 0;
    }
    taskBase += tasks;
    prev = end;

    if (end == t.m || (REUSE && GENERAL && nextTask >= stopTask)) break;
  }
#if defined(SPLIT_CORE_CUBE)
  if (done) {
    uint32_t prior = done - 1;
    mm.Drain(cg[(prior & 1) * ELEMS], prior);
    if (prior & 1)
      CrossCoreSetFlag<2, PIPE_FIX>(3);
    else
      CrossCoreSetFlag<2, PIPE_FIX>(0);
  }
  if (done > 1) CrossCoreWaitFlag<2>(4);
  if (done)
    CrossCoreWaitFlag<2>(1);
  else
    CrossCoreWaitFlag<2>(2);
#endif
}
#if !defined(GMG_SEPARATE_BUILD) || defined(GMG_BUILD_EPILOGUE)
extern "C" __global__ __mix__(1, 2) void groupmatmulgelu_ep_balanced_widetail(
  GM_ADDR x, GM_ADDR w, GM_ADDR scale, GM_ADDR groups, GM_ADDR y, GM_ADDR workspace, GmgTiling t) {
  GmgComputePipelined<128, 256, false, false, true, false, false, false, 2048, false, false, true>(x, w, scale, groups, y, workspace, t);
}
extern "C" __global__ __mix__(1, 2) void groupmatmulgelu_ep_tall(
  GM_ADDR x, GM_ADDR w, GM_ADDR scale, GM_ADDR groups, GM_ADDR y, GM_ADDR workspace, GmgTiling t) {
  GmgComputeTightSubnormal<128, 256, false, false, true>(x, w, scale, groups, y, workspace, t);
}
extern "C" __global__ __mix__(1, 2) void groupmatmulgelu_ep_tall_rotated(
  GM_ADDR x, GM_ADDR w, GM_ADDR scale, GM_ADDR groups, GM_ADDR y, GM_ADDR workspace, GmgTiling t) {
  GmgComputeTightSubnormal<128, 256, false, false, true, false, false, false, 2048, false, true>(x, w, scale, groups, y, workspace, t);
}
#endif

class GmgStartupDirectCube {
public:
  __aicore__ inline void Init(const AscendC::tiling::TCubeTiling *, AscendC::TPipe *pipe) {
    pipe->InitBuffer(a1b, 1, 64 * 2048);
    pipe->InitBuffer(b1b, 2, 512 * 256);
    pipe->InitBuffer(a2b, 2, 64 * 128);
    pipe->InitBuffer(b2b, 2, 128 * 256);
    pipe->InitBuffer(c1b, 1, 64 * 256 * 4);
  }
  __aicore__ inline void SetOrgShape(uint32_t, uint32_t n, uint32_t k, uint32_t, uint32_t stride) {
    n_ = n;
    k_ = k;
    stride_ = stride;
  }
  __aicore__ inline void SetSingleShape(uint32_t rows, uint32_t cols, uint32_t) {
    rows_ = rows;
    cols_ = cols;
  }
  __aicore__ inline void SetTensorA(AscendC::GlobalTensor<int8_t> value) { x_ = value; }
  __aicore__ inline void SetTensorB(AscendC::GlobalTensor<int8_t> value) { w_ = value; }
  __aicore__ inline void IterateAll(AscendC::GlobalTensor<int32_t> result, bool first) {
    using namespace AscendC;
    auto a1 = a1b.AllocTensor<int8_t>();
    auto c1 = c1b.AllocTensor<int32_t>();
    uint32_t paddedM = (rows_ + 15) / 16 * 16;
    if (rows_ != paddedM) {
      InitConstValue(a1.ReinterpretCast<uint32_t>(), InitConstValueParams<uint32_t>{1, uint16_t(paddedM * k_ / 32), 0, 0});
      PipeBarrier<PIPE_MTE2>();
    }
    Nd2NzParams ap{};
    ap.ndNum = 1;
    ap.nValue = rows_;
    ap.dValue = k_;
    ap.srcDValue = k_;
    ap.dstNzC0Stride = paddedM;
    ap.dstNzNStride = 1;
    DataCopy(a1, x_, ap);
    a1b.EnQue(a1);
    CopyWeight(0, k_ < 512 ? k_ : 512);
    a1 = a1b.DeQue<int8_t>();
    for (uint32_t base = 0; base < k_; base += 512) {
      uint32_t chunk = k_ - base < 512 ? k_ - base : 512;
      auto b1 = b1b.DeQue<int8_t>();
      if (base + 512 < k_) {
        uint32_t next = k_ - base - 512 < 512 ? k_ - base - 512 : 512;
        CopyWeight(base + 512, next);
      }
      for (uint32_t inner = 0; inner < chunk; inner += 128) {
        auto a2 = a2b.AllocTensor<int8_t>();
        auto b2 = b2b.AllocTensor<int8_t>();
        LoadData2dParams al{};
        al.repeatTimes = 4;
        al.srcStride = paddedM / 16;
        for (uint32_t m = 0; m < paddedM; m += 16) LoadData(a2[m * 128], a1[(base + inner) * paddedM + m * 32], al);
        LoadData2dTransposeParams bl{};
        bl.repeatTimes = cols_ / 32;
        bl.srcStride = chunk / 32;
        bl.dstGap = 1;
        for (uint32_t kk = 0; kk < 128; kk += 32) { LoadDataWithTranspose(b2[kk * cols_], b1[(inner + kk) * 32], bl); }
        a2b.EnQue(a2);
        b2b.EnQue(b2);
        a2 = a2b.DeQue<int8_t>();
        b2 = b2b.DeQue<int8_t>();
        MmadParams mad{};
        mad.m = paddedM;
        mad.n = cols_;
        mad.k = 128;
        mad.cmatrixInitVal = (base == 0 && inner == 0);
        Mmad(c1, a2, b2, mad);

        PipeBarrier<PIPE_M>();
        a2b.FreeTensor(a2);
        b2b.FreeTensor(b2);
      }
      b1b.FreeTensor(b1);
    }
    a1b.FreeTensor(a1);
    c1b.EnQue(c1);
    c1 = c1b.DeQue<int32_t>();
    FixpipeParamsV220 fix{};
    fix.nSize = cols_;
    fix.mSize = rows_;
    fix.srcStride = paddedM;
    fix.dstStride = stride_;

    if (first) CrossCoreWaitFlag<2>(2);
    Fixpipe<int32_t, int32_t, CFG_ROW_MAJOR>(result, c1, fix);
    c1b.FreeTensor(c1);
  }
  __aicore__ inline void End() {}

private:
  __aicore__ inline void CopyWeight(uint32_t base, uint32_t chunk) {
    auto b1 = b1b.AllocTensor<int8_t>();
    AscendC::Nd2NzParams bp{};
    bp.ndNum = 1;
    bp.nValue = chunk;
    bp.dValue = cols_;
    bp.srcDValue = n_;
    bp.dstNzC0Stride = chunk;
    bp.dstNzNStride = 1;
    AscendC::DataCopy(b1, w_[uint64_t(base) * n_], bp);
    b1b.EnQue(b1);
  }
  AscendC::TQue<AscendC::TPosition::A1, 1> a1b;
  AscendC::TQue<AscendC::TPosition::B1, 2> b1b;
  AscendC::TQue<AscendC::TPosition::A2, 2> a2b;
  AscendC::TQue<AscendC::TPosition::B2, 2> b2b;
  AscendC::TQue<AscendC::TPosition::CO1, 1> c1b;
  AscendC::GlobalTensor<int8_t> x_, w_;
  uint32_t rows_ = 0, cols_ = 0, n_ = 0, k_ = 0, stride_ = 0;
};

template <bool PACKED = false, uint32_t WIDTH = 64, uint32_t HEIGHT = 32, uint32_t MAX_K = 8192, uint32_t BLOCK_K = 512> class GmgStartupWideCube {
public:
  static_assert(HEIGHT == 64 && WIDTH == 512 && MAX_K == 2048 && BLOCK_K == 256 && !PACKED);
  static constexpr uint32_t INNER_K = WIDTH <= 64 ? 512 : (WIDTH <= 128 ? 256 : (WIDTH <= 256 ? 256 : 64));
  __aicore__ inline void Init(const AscendC::tiling::TCubeTiling *, AscendC::TPipe *pipe) {
    pipe->InitBuffer(a1b, 1, HEIGHT * MAX_K);
    pipe->InitBuffer(b1b, 3, BLOCK_K * WIDTH);
    pipe->InitBuffer(a2b, 2, HEIGHT * (WIDTH > 256 ? 256 : INNER_K));
    pipe->InitBuffer(b2b, (INNER_K * WIDTH * 2 <= 65536 ? 2 : 1), INNER_K * WIDTH);
    pipe->InitBuffer(c1b, 1, HEIGHT * WIDTH * 4);
  }
  __aicore__ inline void SetOrgShape(uint32_t, uint32_t n, uint32_t k, uint32_t, uint32_t stride) {
    n_ = n;
    kStride_ = k;
    stride_ = stride;
  }
  __aicore__ inline void SetSingleShape(uint32_t rows, uint32_t cols, uint32_t k) {
    rows_ = rows;
    cols_ = cols;
    k_ = k;
  }
  __aicore__ inline void SetTensorA(AscendC::GlobalTensor<int8_t> value) { x_ = value; }
  __aicore__ inline void SetTensorB(AscendC::GlobalTensor<int8_t> value) { w_ = value; }
  __aicore__ inline void IterateAll(AscendC::GlobalTensor<int32_t> result, bool first) {
    using namespace AscendC;
    auto a1 = a1b.AllocTensor<int8_t>();
    auto c1 = c1b.AllocTensor<int32_t>();
    uint32_t paddedM = (rows_ + 15) / 16 * 16, paddedN = (cols_ + 31) / 32 * 32;
    uint32_t innerK = WIDTH > 256 ? (paddedN <= 128 ? 256 : (paddedN <= 256 ? 128 : 64)) : INNER_K;
    uint32_t paddedK = (k_ + innerK - 1) / innerK * innerK;
    if (rows_ != paddedM || k_ != paddedK) {
      InitConstValue(a1.ReinterpretCast<uint32_t>(), InitConstValueParams<uint32_t>{1, uint16_t(paddedM * paddedK / 32), 0, 0});
      PipeBarrier<PIPE_MTE2>();
    }
    Nd2NzParams ap{};
    ap.ndNum = 1;
    ap.nValue = rows_;
    ap.dValue = k_;
    ap.srcDValue = kStride_;
    ap.dstNzC0Stride = paddedM;
    ap.dstNzNStride = 1;
    DataCopy(a1, x_, ap);
    a1b.EnQue(a1);
    CopyWeight(0, k_ < BLOCK_K ? k_ : BLOCK_K, paddedN, innerK);
    if (k_ > BLOCK_K) CopyWeight(BLOCK_K, k_ - BLOCK_K < BLOCK_K ? k_ - BLOCK_K : BLOCK_K, paddedN, innerK);
    a1 = a1b.DeQue<int8_t>();
    for (uint32_t base = 0; base < k_; base += BLOCK_K) {
      uint32_t chunk = k_ - base < BLOCK_K ? k_ - base : BLOCK_K;
      uint32_t paddedChunk = (chunk + innerK - 1) / innerK * innerK;
      auto b1 = b1b.DeQue<int8_t>();

      if (base + 2 * BLOCK_K < k_) {
        uint32_t next = k_ - base - 2 * BLOCK_K < BLOCK_K ? k_ - base - 2 * BLOCK_K : BLOCK_K;
        CopyWeight(base + 2 * BLOCK_K, next, paddedN, innerK);
      }
      for (uint32_t inner = 0; inner < paddedChunk; inner += innerK) {
        auto a2 = a2b.AllocTensor<int8_t>();
        auto b2 = b2b.AllocTensor<int8_t>();
        LoadData2dParams al{};
        al.repeatTimes = innerK / 32;
        al.srcStride = paddedM / 16;
        for (uint32_t m = 0; m < paddedM; m += 16) LoadData(a2[m * innerK], a1[(base + inner) * paddedM + m * 32], al);
        LoadData2dTransposeParams bl{};
        bl.repeatTimes = paddedN / 32;
        bl.srcStride = PACKED ? 16 : paddedChunk / 32;
        bl.dstGap = 1;
        for (uint32_t kk = 0; kk < innerK; kk += 32) LoadDataWithTranspose(b2[kk * paddedN], b1[(inner + kk) * 32], bl);
        a2b.EnQue(a2);
        b2b.EnQue(b2);
        a2 = a2b.DeQue<int8_t>();
        b2 = b2b.DeQue<int8_t>();
        MmadParams mad{};
        mad.m = paddedM;
        mad.n = paddedN;
        mad.k = innerK;
        mad.cmatrixInitVal = (base == 0 && inner == 0);
        Mmad(c1, a2, b2, mad);
        PipeBarrier<PIPE_M>();
        a2b.FreeTensor(a2);
        b2b.FreeTensor(b2);
      }
      b1b.FreeTensor(b1);
    }
    a1b.FreeTensor(a1);
    c1b.EnQue(c1);
    c1 = c1b.DeQue<int32_t>();
    FixpipeParamsV220 fix{};
    fix.nSize = paddedN;
    fix.mSize = rows_;
    fix.srcStride = paddedM;
    fix.dstStride = rows_ > HEIGHT ? WIDTH / 2 : stride_;

    if (first) CrossCoreWaitFlag<2>(2);
    Fixpipe<int32_t, int32_t, CFG_ROW_MAJOR>(result, c1, fix);
    c1b.FreeTensor(c1);
  }
  __aicore__ inline void End() {}

private:
  __aicore__ inline void CopyWeight(uint32_t base, uint32_t chunk, uint32_t paddedN, uint32_t innerK) {
    using namespace AscendC;
    auto b1 = b1b.AllocTensor<int8_t>();
    if constexpr (PACKED) {

      DataCopy(b1, w_[uint64_t(base) * n_], BLOCK_K * paddedN);
      b1b.EnQue(b1);
      return;
    }
    uint32_t paddedChunk = (chunk + innerK - 1) / innerK * innerK;

    if (chunk != paddedChunk) {
      InitConstValue(b1.ReinterpretCast<uint32_t>(), InitConstValueParams<uint32_t>{1, uint16_t(paddedChunk * paddedN / 32), 0, 0});
      PipeBarrier<PIPE_MTE2>();
    }
    Nd2NzParams bp{};
    bp.ndNum = 1;
    bp.nValue = chunk;
    bp.dValue = cols_;
    bp.srcDValue = n_;
    bp.dstNzC0Stride = paddedChunk;
    bp.dstNzNStride = 1;
    DataCopy(b1, w_[uint64_t(base) * n_], bp);
    b1b.EnQue(b1);
  }
  AscendC::TQue<AscendC::TPosition::A1, 1> a1b;
  AscendC::TQue<AscendC::TPosition::B1, 2> b1b;
  AscendC::TQue<AscendC::TPosition::A2, 2> a2b;
  AscendC::TQue<AscendC::TPosition::B2, 2> b2b;
  AscendC::TQue<AscendC::TPosition::CO1, 1> c1b;
  AscendC::GlobalTensor<int8_t> x_, w_;
  uint32_t rows_ = 0, cols_ = 0, n_ = 0, k_ = 0, kStride_ = 0, stride_ = 0;
};

template <bool PACKED = false, uint32_t WIDTH = 64, uint32_t HEIGHT = 32, uint32_t MAX_K = 8192, uint32_t BLOCK_K = 512, bool NARROW_TAIL = false,
  bool LARGER_A1 = false>
class GmgStartupWideLongTailCube {
public:
  static_assert(HEIGHT == 64 && WIDTH == 512 && MAX_K == 2048 && BLOCK_K == 256 && !PACKED);
  static constexpr uint32_t INNER_K = WIDTH <= 64 ? 512 : (WIDTH <= 128 ? 256 : (WIDTH <= 256 ? 256 : 64));
  __aicore__ inline void Init(const AscendC::tiling::TCubeTiling *, AscendC::TPipe *pipe) {
    pipe->InitBuffer(a1b, 1, (LARGER_A1 ? 2 : 1) * HEIGHT * MAX_K);
    pipe->InitBuffer(b1b, LARGER_A1 ? 2 : 3, BLOCK_K * WIDTH);

    pipe->InitBuffer(a2b, 2, NARROW_TAIL ? HEIGHT * 512 : HEIGHT * (WIDTH > 256 ? 256 : INNER_K));
    pipe->InitBuffer(b2b, (INNER_K * WIDTH * 2 <= 65536 ? 2 : 1), INNER_K * WIDTH);
    pipe->InitBuffer(c1b, 1, HEIGHT * WIDTH * 4);
  }
  __aicore__ inline void SetOrgShape(uint32_t, uint32_t n, uint32_t k, uint32_t, uint32_t stride) {
    n_ = n;
    kStride_ = k;
    stride_ = stride;
  }
  __aicore__ inline void SetSingleShape(uint32_t rows, uint32_t cols, uint32_t k) {
    rows_ = rows;
    cols_ = cols;
    k_ = k;
  }
  __aicore__ inline void SetTensorA(AscendC::GlobalTensor<int8_t> value) { x_ = value; }
  __aicore__ inline void SetTensorB(AscendC::GlobalTensor<int8_t> value) { w_ = value; }
  __aicore__ inline void IterateAll(AscendC::GlobalTensor<int32_t> result, bool first) {
    using namespace AscendC;
    auto c1 = c1b.AllocTensor<int32_t>();
    uint32_t paddedM = (rows_ + 15) / 16 * 16, paddedN = (cols_ + 31) / 32 * 32;
    uint32_t innerK = WIDTH > 256 ? (paddedN <= 128 ? 256 : (paddedN <= 256 ? 128 : 64)) : INNER_K;

    constexpr uint32_t SLAB = MAX_K / 2;
    const bool streamA = !LARGER_A1 && rows_ > HEIGHT && k_ > SLAB;
    uint32_t aBase = 0;
    LoadActivation(aBase, streamA ? SLAB : k_, paddedM, innerK);
    CopyWeight(0, k_ < BLOCK_K ? k_ : BLOCK_K, paddedN, innerK);
    if (!LARGER_A1 && k_ > BLOCK_K) CopyWeight(BLOCK_K, k_ - BLOCK_K < BLOCK_K ? k_ - BLOCK_K : BLOCK_K, paddedN, innerK);
    auto a1 = a1b.DeQue<int8_t>();
    for (uint32_t base = 0; base < k_; base += BLOCK_K) {
      uint32_t chunk = k_ - base < BLOCK_K ? k_ - base : BLOCK_K;
      uint32_t paddedChunk = (chunk + innerK - 1) / innerK * innerK;
      if (streamA && base == SLAB) {
        a1b.FreeTensor(a1);
        aBase = base;
        LoadActivation(aBase, k_ - aBase, paddedM, innerK);
        a1 = a1b.DeQue<int8_t>();
      }
      auto b1 = b1b.DeQue<int8_t>();

      constexpr uint32_t DISTANCE = (LARGER_A1 ? 1 : 2) * BLOCK_K;
      if (base + DISTANCE < k_) {
        uint32_t next = k_ - base - DISTANCE < BLOCK_K ? k_ - base - DISTANCE : BLOCK_K;
        CopyWeight(base + DISTANCE, next, paddedN, innerK);
      }
      for (uint32_t inner = 0; inner < paddedChunk; inner += innerK) {
        auto a2 = a2b.AllocTensor<int8_t>();
        auto b2 = b2b.AllocTensor<int8_t>();
        LoadData2dParams al{};
        al.repeatTimes = innerK / 32;
        al.srcStride = paddedM / 16;
        for (uint32_t m = 0; m < paddedM; m += 16) LoadData(a2[m * innerK], a1[(base - aBase + inner) * paddedM + m * 32], al);
        LoadData2dTransposeParams bl{};
        bl.repeatTimes = paddedN / 32;
        bl.srcStride = PACKED ? 16 : paddedChunk / 32;
        bl.dstGap = 1;
        for (uint32_t kk = 0; kk < innerK; kk += 32) LoadDataWithTranspose(b2[kk * paddedN], b1[(inner + kk) * 32], bl);
        a2b.EnQue(a2);
        b2b.EnQue(b2);
        a2 = a2b.DeQue<int8_t>();
        b2 = b2b.DeQue<int8_t>();
        MmadParams mad{};
        mad.m = paddedM;
        mad.n = paddedN;
        mad.k = innerK;
        mad.cmatrixInitVal = (base == 0 && inner == 0);
        Mmad(c1, a2, b2, mad);
        PipeBarrier<PIPE_M>();
        a2b.FreeTensor(a2);
        b2b.FreeTensor(b2);
      }
      b1b.FreeTensor(b1);
    }
    a1b.FreeTensor(a1);
    c1b.EnQue(c1);
    c1 = c1b.DeQue<int32_t>();
    FixpipeParamsV220 fix{};
    fix.nSize = paddedN;
    fix.mSize = rows_;
    fix.srcStride = paddedM;
    fix.dstStride = rows_ > HEIGHT ? (NARROW_TAIL ? WIDTH / 4 : WIDTH / 2) : stride_;

    if (first) CrossCoreWaitFlag<2>(2);
    Fixpipe<int32_t, int32_t, CFG_ROW_MAJOR>(result, c1, fix);
    c1b.FreeTensor(c1);
  }
  __aicore__ inline void End() {}

private:
  __aicore__ inline void LoadActivation(uint32_t begin, uint32_t count, uint32_t paddedM, uint32_t innerK) {
    using namespace AscendC;
    auto a1 = a1b.AllocTensor<int8_t>();
    const uint32_t paddedK = (count + innerK - 1) / innerK * innerK;
    if (rows_ != paddedM || count != paddedK) {
      InitConstValue(a1.ReinterpretCast<uint32_t>(), InitConstValueParams<uint32_t>{1, uint16_t(paddedM * paddedK / 32), 0, 0});
      PipeBarrier<PIPE_MTE2>();
    }
    Nd2NzParams ap{};
    ap.ndNum = 1;
    ap.nValue = rows_;
    ap.dValue = count;
    ap.srcDValue = kStride_;
    ap.dstNzC0Stride = paddedM;
    ap.dstNzNStride = 1;
    DataCopy(a1, x_[begin], ap);
    a1b.EnQue(a1);
  }
  __aicore__ inline void CopyWeight(uint32_t base, uint32_t chunk, uint32_t paddedN, uint32_t innerK) {
    using namespace AscendC;
    auto b1 = b1b.AllocTensor<int8_t>();
    if constexpr (PACKED) {

      DataCopy(b1, w_[uint64_t(base) * n_], BLOCK_K * paddedN);
      b1b.EnQue(b1);
      return;
    }
    uint32_t paddedChunk = (chunk + innerK - 1) / innerK * innerK;

    if (chunk != paddedChunk) {
      InitConstValue(b1.ReinterpretCast<uint32_t>(), InitConstValueParams<uint32_t>{1, uint16_t(paddedChunk * paddedN / 32), 0, 0});
      PipeBarrier<PIPE_MTE2>();
    }
    Nd2NzParams bp{};
    bp.ndNum = 1;
    bp.nValue = chunk;
    bp.dValue = cols_;
    bp.srcDValue = n_;
    bp.dstNzC0Stride = paddedChunk;
    bp.dstNzNStride = 1;
    DataCopy(b1, w_[uint64_t(base) * n_], bp);
    b1b.EnQue(b1);
  }
  AscendC::TQue<AscendC::TPosition::A1, 1> a1b;
  AscendC::TQue<AscendC::TPosition::B1, 2> b1b;
  AscendC::TQue<AscendC::TPosition::A2, 2> a2b;
  AscendC::TQue<AscendC::TPosition::B2, 2> b2b;
  AscendC::TQue<AscendC::TPosition::CO1, 1> c1b;
  AscendC::GlobalTensor<int8_t> x_, w_;
  uint32_t rows_ = 0, cols_ = 0, n_ = 0, k_ = 0, kStride_ = 0, stride_ = 0;
};

template <bool WHOLE_COUNT = true, bool WORD_FLAGS = true>
__aicore__ inline void GmgSmallTightQuotientAndFlags(LocalTensor<float> z, LocalTensor<half> h, LocalTensor<float> u, LocalTensor<float> v,
  LocalTensor<float> p, LocalTensor<int32_t> a, LocalTensor<uint8_t> mask1, LocalTensor<uint8_t> mask2, uint32_t count, bool wrotePrevious) {
  SetMaskCount();
  SetVectorMask<float, MaskMode::COUNTER>(count);
  Div<float, false>(p, z, u, MASK_PLACEHOLDER, 1, {1, 1, 1, 8, 8, 8});
  if (wrotePrevious) WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
  Cast<half, float, false>(h, p, RoundMode::CAST_RINT, MASK_PLACEHOLDER, 1, {1, 1, 4, 8});
  // This completion protects the next raw-C DMA after removal of Scalar refinement.
  SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
  SetMaskNorm();
  ResetMask();
  SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
  SetFlag<HardEvent::V_S>(EVENT_ID0);
}

template <uint32_t BM, uint32_t BN, bool MDL = false, bool REUSE = false, bool DIRECT = false, bool PADDED = false, bool GENERAL = false, bool STREAM = false,
  uint32_t DIRECT_MAX_K = 2048, bool FORCE_DOUBLE = false>
__aicore__ inline void GmgComputeSmallTightLateStart(GM_ADDR x, GM_ADDR w, GM_ADDR scale, GM_ADDR groups, GM_ADDR y, GM_ADDR workspace, const GmgTiling &t) {
  static_assert(BM == 64 && BN == 256 && DIRECT && FORCE_DOUBLE && !GENERAL && !REUSE && !PADDED && !STREAM,
    "Small-z repair initially uses the existing direct M64/N256 path");
  constexpr uint32_t ELEMS = BM * BN, VR = 2, VELEMS = (BM > 64 ? 64 : BM) * BN / VR;
  constexpr bool DOUBLE_C = (BM == 128 || FORCE_DOUBLE);
  static_assert(
    !FORCE_DOUBLE || (BM == 64 && BN == 256 && DIRECT && !GENERAL && !REUSE && !PADDED && !STREAM), "extra C bank is restricted to direct M64/N256");
  TPipe pipe;
  const uint32_t core = GetBlockIdx() / GetTaskRation();
  typename Conditional<PADDED, GmgWordWeightPacker, GmgNoWeightPacker>::type packer;
  if constexpr (PADDED) {
    auto padded = workspace + uint64_t(t.blocks) * t.bm * t.bn * 4 + uint64_t(core) * ((t.k + 511) / 512 * 512) * ((t.n + 31) / 32 * 32);
    packer.Init(w, padded, t, pipe);
    w = padded;
  }
  GlobalTensor<int8_t> xg, wg;
  GlobalTensor<int64_t> gg;
  GlobalTensor<float> sg;
  GlobalTensor<half> yg;
  GlobalTensor<int32_t> cg;
  xg.SetGlobalBuffer((__gm__ int8_t *)x);
  wg.SetGlobalBuffer((__gm__ int8_t *)w);
  gg.SetGlobalBuffer((__gm__ int64_t *)groups);
  sg.SetGlobalBuffer((__gm__ float *)scale);
  yg.SetGlobalBuffer((__gm__ half *)y);
  cg.SetGlobalBuffer((__gm__ int32_t *)workspace + core * ELEMS * ((DOUBLE_C || (REUSE && GENERAL)) ? 2 : 1));

#if defined(SPLIT_CORE_CUBE)
  if constexpr (!DIRECT && !STREAM) GmgPrepareL1(pipe, t);
  using CubeOp = typename Conditional<DIRECT, GmgStartupDirectCube, GmgDirectCube>::type;
  CubeOp mm;
  mm.Init(&t.cube, &pipe);
  mm.SetOrgShape(REUSE ? t.m : BM, PADDED ? (t.n + 31) / 32 * 32 : t.n, t.k, t.k, BN);
#endif

#if defined(SPLIT_CORE_VEC)
  TBuf<TPosition::VECCALC> ab, zb, ub, vb, pb, sb, hb, maskb1, maskb2, groupBuffer;
  pipe.InitBuffer(ab, (VELEMS * 4) + 256);
  pipe.InitBuffer(zb, (VELEMS * 4) + 256);
  pipe.InitBuffer(ub, (VELEMS * 4) + 256);
  pipe.InitBuffer(vb, (VELEMS * 4) + 256);
  pipe.InitBuffer(pb, (VELEMS * 4) + 256);
  pipe.InitBuffer(sb, (BN * 4) + 256);
  pipe.InitBuffer(hb, (VELEMS * 2) + 256);
  pipe.InitBuffer(maskb1, (VELEMS / 8) + 256);
  pipe.InitBuffer(maskb2, (VELEMS / 8) + 256);
  auto a = ab.Get<int32_t>();
  auto z = zb.Get<float>();
  auto u = ub.Get<float>();
  auto v = vb.Get<float>();
  auto p = pb.Get<float>();
  auto s = sb.Get<float>();
  auto h = hb.Get<half>();
  auto mask1 = maskb1.Get<uint8_t>();
  auto mask2 = maskb2.Get<uint8_t>();

  bool pending = false, priorBank = false;
  uint32_t priorRows = 0, priorCols = 0;
  uint64_t priorOffset = 0;

  LocalTensor<int64_t> localGroups;
  bool useLocalGroups = false;
  if constexpr ((DIRECT && BN == 256 && !GENERAL) || (REUSE && GENERAL)) {
    pipe.InitBuffer(groupBuffer, 128 * 8);
    localGroups = groupBuffer.Get<int64_t>();
    useLocalGroups = t.e >= 16;
    if (useLocalGroups) {
      GlobalTensor<int32_t> groupWords;
      groupWords.SetGlobalBuffer((__gm__ int32_t *)groups);
      DataCopyPad(groupBuffer.Get<int32_t>(), groupWords, DataCopyExtParams{1, t.e * 8, 0, 0, 0},
        DataCopyPadExtParams<int32_t>{true, 0, uint8_t((4 - t.e % 4) % 4 * 2), 0});
      SetFlag<HardEvent::MTE2_S>(EVENT_ID0);
      WaitFlag<HardEvent::MTE2_S>(EVENT_ID0);
    }
  }

  // Define both private C staging banks before publishing their readiness.
  // Each AIV owns one disjoint half; all INT32 dot products are still produced by Cube.
  Duplicate(a, int32_t(0), VELEMS);
  SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
  WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
  for (uint32_t bank = 0; bank < 2; ++bank) DataCopy(cg[bank * ELEMS + GetSubBlockIdx() * VELEMS], a, VELEMS);
  SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
  WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
  CrossCoreSetFlag<2, PIPE_MTE3>(2);
  if (t.n % BN) {
    Duplicate(s, 0.0f, BN);
    SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
    WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
  }
#endif
  uint32_t taskBase = 0, prev = 0, done = 0, nextTask = core, packedExpert = t.e;

  const uint32_t nt = BN == 64 ? 1 : (t.n + BN - 1) / BN;
#if defined(SPLIT_CORE_VEC)
  uint32_t firstExpert = useLocalGroups ? GmgFirstExpert(localGroups, t.e) : GmgFirstExpert(gg, t.e);
#else
  uint32_t firstExpert = GmgFirstExpert(gg, t.e);
#endif
  uint32_t stopTask = 0xffffffffU, runRemaining = 0;
  if constexpr (REUSE) {
    uint32_t total = 0, before = 0;
    for (uint32_t e = firstExpert; e < t.e; ++e) {
      uint32_t end =
#if defined(SPLIT_CORE_VEC)
        useLocalGroups ? localGroups.GetValue(e) : gg.GetValue(e);
#else
        gg.GetValue(e);
#endif
      total += (end - before + BM - 1) / BM * nt;
      before = end;
      if (end == t.m) break;
    }
    nextTask = total * core / t.blocks;
    stopTask = total * (core + 1) / t.blocks;
  }
  for (uint32_t e = firstExpert; e < t.e; ++e) {
    uint32_t end =
#if defined(SPLIT_CORE_VEC)
      useLocalGroups ? localGroups.GetValue(e) : gg.GetValue(e);
#else
      gg.GetValue(e);
#endif
    uint32_t len = end - prev, mt = (len + BM - 1) / BM;
    uint32_t tasks = mt * nt;

    for (; nextTask < taskBase + tasks && nextTask < stopTask; nextTask += (REUSE ? 1 : t.blocks)) {
      uint32_t local = nextTask - taskBase;
      uint32_t mr = (BN == 64 ? local : (REUSE ? local % mt : local / nt)) * BM;
      uint32_t nc = BN == 64 ? 0 : (REUSE ? local / mt : local % nt) * BN;
      uint32_t rows = (len - mr < BM ? len - mr : BM), cols = (t.n - nc < BN ? t.n - nc : BN);
      if constexpr (PADDED)
        if (packedExpert != e) {
          packer.Pack(e, 0, t.k);
          packedExpert = e;
        }
#if defined(SPLIT_CORE_CUBE)
      if constexpr (DOUBLE_C) {
        if (done >= 2) {
          if (done & 1)
            CrossCoreWaitFlag<2>(4);
          else
            CrossCoreWaitFlag<2>(1);
        }
      } else if (done)
        CrossCoreWaitFlag<2>(1);
      if constexpr (REUSE) {

        if (!runRemaining) {
          runRemaining = mt - local % mt;
          if (runRemaining > stopTask - nextTask) runRemaining = stopTask - nextTask;
          uint32_t runRows = runRemaining * BM;
          if (runRows > len - mr) runRows = len - mr;
          mm.SetSingleShape(runRows, cols, t.k);
          mm.SetTensorA(xg[(uint64_t)(prev + mr) * t.k]);
          mm.SetTensorB(wg[(uint64_t)e * t.k * t.n + nc]);
        }
        mm.Iterate();
        mm.GetTensorC(cg, 0, true);
        if (!--runRemaining) {
          mm.Iterate();
          mm.End();
        }
      } else {
        mm.SetSingleShape(rows, cols, t.k);
        mm.SetTensorA(xg[(uint64_t)(prev + mr) * t.k]);
        mm.SetTensorB(wg[PADDED ? 0 : (uint64_t)e * t.k * t.n + nc]);
        if constexpr (DOUBLE_C)
          mm.IterateAll(cg[(done & 1) * ELEMS], done == 0);
        else
          mm.IterateAll(cg, done == 0);
        mm.End();
      }
      if constexpr (DOUBLE_C) {
        if (done & 1)
          CrossCoreSetFlag<2, PIPE_FIX>(3);
        else
          CrossCoreSetFlag<2, PIPE_FIX>(0);
      } else
        CrossCoreSetFlag<2, PIPE_FIX>(0);
#endif
#if defined(SPLIT_CORE_VEC)
      const uint32_t vectorRows = (rows + VR - 1) / VR;
      const uint32_t rowOffset = GetSubBlockIdx() * vectorRows;
      const uint32_t currentRows = rows > rowOffset ? (rows - rowOffset < vectorRows ? rows - rowOffset : vectorRows) : 0;
      if (currentRows) {

        if (pending) WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
        DataCopyPad(s, sg[(uint64_t)e * t.n + nc], DataCopyExtParams{1, cols * 4, 0, 0, 0}, DataCopyPadExtParams<float>{true, 0, 0, 0});
        if (pending) {

          auto oldZ = priorBank ? v : z;
          GmgTileRepairAndWrite(oldZ, h, p, mask1, mask2, priorRows * BN, yg[priorOffset],
            DataCopyExtParams{uint16_t(priorRows), priorCols * 2, (BN - ((priorCols + 15) / 16 * 16)) / 16, (t.n - priorCols) * 2, 0});
          SetFlag<HardEvent::MTE3_V>(EVENT_ID0);

          SetFlag<HardEvent::S_V>(EVENT_ID0);
          WaitFlag<HardEvent::S_V>(EVENT_ID0);
        }
      }
      if (done & 1)
        CrossCoreWaitFlag<2>(3);
      else
        CrossCoreWaitFlag<2>(0);
      if (currentRows) {
        if (cols == BN)
          DataCopy(a, cg[(done & 1) * ELEMS + rowOffset * BN], currentRows * BN);
        else
          DataCopyPad(a, cg[(done & 1) * ELEMS + rowOffset * BN],
            DataCopyExtParams{uint16_t(currentRows), cols * 4, (BN - cols) * 4, (BN - ((cols + 7) / 8 * 8)) / 8, 0},
            DataCopyPadExtParams<int32_t>{true, 0, 0, 0});
      }
      SetFlag<HardEvent::MTE2_S>(EVENT_ID0);
      WaitFlag<HardEvent::MTE2_S>(EVENT_ID0);
      if (done & 1)
        CrossCoreSetFlag<2, PIPE_MTE2>(4);
      else
        CrossCoreSetFlag<2, PIPE_MTE2>(1);
      if (currentRows) {
        const bool currentBank = pending ? !priorBank : false;
        auto zn = currentBank ? v : z;
        auto vn = currentBank ? z : v;
        const uint32_t count = currentRows * BN;
        SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
        WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
        if (pending) PipeBarrier<PIPE_V>();
        Cast(zn, a, RoundMode::CAST_RINT, count);
        for (uint32_t c = 0; c < BN; c += 64) Mul(zn[c], zn[c], s[c], uint64_t(64), uint8_t(currentRows), BinaryRepeatParams{1, 1, 1, BN / 8, BN / 8, 0});
        GmgTileDenom(zn, u, count);
        GmgSmallTightQuotientAndFlags(zn, h, u, vn, p, a, mask1, mask2, count, pending);
        priorBank = currentBank;
        priorRows = currentRows;
        priorCols = cols;
        priorOffset = uint64_t(prev + mr + rowOffset) * t.n + nc;
        pending = true;
      }
#endif
      ++done;
    }
    taskBase += tasks;
    prev = end;

    if (end == t.m || (REUSE && GENERAL && nextTask >= stopTask)) break;
  }
#if defined(SPLIT_CORE_CUBE)
  if constexpr (DOUBLE_C) {

    if (done > 1) CrossCoreWaitFlag<2>(4);
    if (done) CrossCoreWaitFlag<2>(1);
  } else if (done)
    CrossCoreWaitFlag<2>(1);
  if (!done) CrossCoreWaitFlag<2>(2);
#endif
#if defined(SPLIT_CORE_VEC)
  if (pending) {
    WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
    auto zp = priorBank ? v : z;
    GmgTileRepairAndWrite(zp, h, p, mask1, mask2, priorRows * BN, yg[priorOffset],
      DataCopyExtParams{uint16_t(priorRows), priorCols * 2, (BN - ((priorCols + 15) / 16 * 16)) / 16, (t.n - priorCols) * 2, 0});
    SetFlag<HardEvent::MTE3_S>(EVENT_ID0);
    WaitFlag<HardEvent::MTE3_S>(EVENT_ID0);
  }
#endif
}
__aicore__ inline void GmgShortDenomWithoutClamp(LocalTensor<float> z, LocalTensor<float> u, uint32_t count) {

  SetMaskCount();
  SetVectorMask<float, MaskMode::COUNTER>(count);
  Mul<float, false>(u, z, z, MASK_PLACEHOLDER, 1, {1, 1, 1, 8, 8, 8});
  Muls<float, false>(u, u, -0.07135481759315014f, MASK_PLACEHOLDER, 1, {1, 1, 8, 8});
  Adds<float, false>(u, u, -1.5957691216057308f, MASK_PLACEHOLDER, 1, {1, 1, 8, 8});
  Mul<float, false>(u, u, z, MASK_PLACEHOLDER, 1, {1, 1, 1, 8, 8, 8});
  Exp<float, false>(u, u, MASK_PLACEHOLDER, 1, {1, 1, 8, 8});
  Adds<float, false>(u, u, 1.0f, MASK_PLACEHOLDER, 1, {1, 1, 8, 8});
}

template <uint32_t WIDTH> struct GmgShortPrefix595 {
  LocalTensor<float> z, u;
  LocalTensor<int32_t> a;
  LocalTensor<float> scale;
  uint32_t rows, count;
  __aicore__ inline void Run() {
    Cast(z, a, RoundMode::CAST_RINT, count);
    for (uint32_t c = 0; c < WIDTH; c += 64) Mul(z[c], z[c], scale[c], uint64_t(64), uint8_t(rows), BinaryRepeatParams{1, 1, 1, WIDTH / 8, WIDTH / 8, 0});
    GmgShortDenomWithoutClamp(z, u, count);
  }
};

template <class Prefix>
__aicore__ inline bool GmgTileRepairStartPrefix595(LocalTensor<float> z, LocalTensor<half> h, LocalTensor<float> p, LocalTensor<uint8_t> mask1,
  LocalTensor<uint8_t> mask2, uint32_t count, GlobalTensor<half> dst, const DataCopyExtParams &copy, Prefix &prefix) {
  constexpr bool WORD_FLAGS = true;
  bool started = false;
  constexpr uint32_t GROUP = WORD_FLAGS ? 32 : 16;
  const uint32_t groupCount = count / GROUP;
  WaitFlag<HardEvent::V_S>(EVENT_ID0);
  for (uint32_t word = 0; word < (groupCount + 63) / 64; ++word) {
    uint64_t groups = mask2.ReinterpretCast<uint64_t>().GetValue(word);
    if constexpr (WORD_FLAGS) groups = ~groups;
    if (groupCount - word * 64 < 64) groups &= (1ULL << (groupCount - word * 64)) - 1;
    while (groups) {
      uint32_t group = word * 64 + __builtin_ctzll(groups);
      uint32_t bits;
      if constexpr (WORD_FLAGS)
        bits = mask1.ReinterpretCast<uint32_t>().GetValue(group);
      else
        bits = mask1.ReinterpretCast<uint16_t>().GetValue(group);
      while (bits) {
        uint32_t index = group * GROUP + __builtin_ctz(bits);

        float magnitude = p.GetValue(index);
        bool ambiguous;
        if (magnitude >= 0x1p-14f) {
          union {
            float f;
            uint32_t u;
          } mb;
          mb.f = magnitude;
          int32_t offset = int32_t(mb.u & 8191) - 4096;
          if (offset < 0) offset = -offset;
          float mantissa = float(int32_t((mb.u & 0x7fffff) | 0x800000));
          ambiguous = float(offset) <= mantissa * 0.0000002505f;
        } else {
          uint16_t hb = h.ReinterpretCast<uint16_t>().GetValue(index) & 0x7fff;
          float delta = magnitude - float(int32_t(hb)) * 0x1p-24f;
          if (delta < 0) delta = -delta;
          ambiguous = delta >= 0x1p-25f - magnitude * 0.000001000f || (delta >= 0x1p-25f - magnitude * 0.000020000f && z.GetValue(index) < -3.0f);
        }
        if (ambiguous) {
          // The genuine old input is loaded before issuing new Vector work.
          const float value = z.GetValue(index);
          if (!started) {
            prefix.Run();
            started = true;
          }
          const uint16_t answer = GmgAccurateGeluSmall(value);
          h.ReinterpretCast<uint16_t>().SetValue(index, answer);
        }
        bits &= bits - 1;
      }
      groups &= groups - 1;
    }
  }
  SetFlag<HardEvent::S_MTE3>(EVENT_ID0);
  WaitFlag<HardEvent::S_MTE3>(EVENT_ID0);
  WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
  DataCopyPad(dst, h, copy);
  return started;
}

template <uint32_t BM, uint32_t BN, bool MDL = false, bool REUSE = false, bool DIRECT = false, bool PADDED = false, bool GENERAL = false, bool STREAM = false,
  uint32_t DIRECT_MAX_K = 2048, bool FORCE_DOUBLE = false>
__aicore__ inline void GmgComputeShortLegacyVec405(GM_ADDR x, GM_ADDR w, GM_ADDR scale, GM_ADDR groups, GM_ADDR y, GM_ADDR workspace, const GmgTiling &t) {
  static_assert(BM == 64 && BN == 256 && DIRECT && FORCE_DOUBLE && !GENERAL && !REUSE && !PADDED && !STREAM,
    "Small-z repair initially uses the existing direct M64/N256 path");
  constexpr uint32_t ELEMS = BM * BN, VR = 2, VELEMS = (BM > 64 ? 64 : BM) * BN / VR;
  constexpr bool DOUBLE_C = (BM == 128 || FORCE_DOUBLE);
  static_assert(
    !FORCE_DOUBLE || (BM == 64 && BN == 256 && DIRECT && !GENERAL && !REUSE && !PADDED && !STREAM), "extra C bank is restricted to direct M64/N256");
  TPipe pipe;
  const uint32_t core = GetBlockIdx() / GetTaskRation();
  GlobalTensor<int8_t> xg, wg;
  GlobalTensor<int64_t> gg;
  GlobalTensor<float> sg;
  GlobalTensor<half> yg;
  GlobalTensor<int32_t> cg;
  xg.SetGlobalBuffer((__gm__ int8_t *)x);
  wg.SetGlobalBuffer((__gm__ int8_t *)w);
  gg.SetGlobalBuffer((__gm__ int64_t *)groups);
  sg.SetGlobalBuffer((__gm__ float *)scale);
  yg.SetGlobalBuffer((__gm__ half *)y);
  cg.SetGlobalBuffer((__gm__ int32_t *)workspace + core * ELEMS * ((DOUBLE_C || (REUSE && GENERAL)) ? 2 : 1));

#if defined(SPLIT_CORE_CUBE)
  using CubeOp = typename Conditional<DIRECT, GmgStartupDirectCube, GmgDirectCube>::type;
  CubeOp mm;
  mm.Init(&t.cube, &pipe);
  mm.SetOrgShape(REUSE ? t.m : BM, PADDED ? (t.n + 31) / 32 * 32 : t.n, t.k, t.k, BN);
#endif

#if defined(SPLIT_CORE_VEC)
  TBuf<TPosition::VECCALC> ab, zb, ub, vb, pb, sb, hb, maskb1, maskb2, groupBuffer;
  pipe.InitBuffer(ab, (VELEMS * 4) + 256);
  pipe.InitBuffer(zb, (VELEMS * 4) + 256);
  pipe.InitBuffer(ub, (VELEMS * 4) + 256);
  pipe.InitBuffer(vb, (VELEMS * 4) + 256);
  pipe.InitBuffer(pb, (VELEMS * 4) + 256);
  pipe.InitBuffer(sb, (BN * 4) + 256);
  pipe.InitBuffer(hb, (VELEMS * 2) + 256);
  pipe.InitBuffer(maskb1, (VELEMS / 8) + 256);
  pipe.InitBuffer(maskb2, (VELEMS / 8) + 256);
  auto a = ab.Get<int32_t>();
  auto z = zb.Get<float>();
  auto u = ub.Get<float>();
  auto v = vb.Get<float>();
  auto p = pb.Get<float>();
  auto s = sb.Get<float>();
  auto h = hb.Get<half>();
  auto mask1 = maskb1.Get<uint8_t>();
  auto mask2 = maskb2.Get<uint8_t>();

  bool pending = false, priorBank = false;
  uint32_t priorRows = 0, priorCols = 0;
  uint64_t priorOffset = 0;

  LocalTensor<int64_t> localGroups;
  bool useLocalGroups = false;
  if constexpr ((DIRECT && BN == 256 && !GENERAL) || (REUSE && GENERAL)) {
    pipe.InitBuffer(groupBuffer, 128 * 8);
    localGroups = groupBuffer.Get<int64_t>();
    useLocalGroups = t.e >= 16;
    if (useLocalGroups) {
      GlobalTensor<int32_t> groupWords;
      groupWords.SetGlobalBuffer((__gm__ int32_t *)groups);
      DataCopyPad(groupBuffer.Get<int32_t>(), groupWords, DataCopyExtParams{1, t.e * 8, 0, 0, 0},
        DataCopyPadExtParams<int32_t>{true, 0, uint8_t((4 - t.e % 4) % 4 * 2), 0});
      SetFlag<HardEvent::MTE2_S>(EVENT_ID0);
      WaitFlag<HardEvent::MTE2_S>(EVENT_ID0);
    }
  }

  CrossCoreSetFlag<2, PIPE_MTE3>(2);
  if (t.n % BN) {
    Duplicate(s, 0.0f, BN);
    SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
    WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
  }
#endif
  uint32_t taskBase = 0, prev = 0, done = 0, nextTask = core;

  const uint32_t nt = BN == 64 ? 1 : (t.n + BN - 1) / BN;
#if defined(SPLIT_CORE_VEC)
  uint32_t firstExpert = useLocalGroups ? GmgFirstExpert(localGroups, t.e) : GmgFirstExpert(gg, t.e);
#else
  uint32_t firstExpert = GmgFirstExpert(gg, t.e);
#endif
  constexpr uint32_t stopTask = 0xffffffffU;
  for (uint32_t e = firstExpert; e < t.e; ++e) {
    uint32_t end =
#if defined(SPLIT_CORE_VEC)
      useLocalGroups ? localGroups.GetValue(e) : gg.GetValue(e);
#else
      gg.GetValue(e);
#endif
    uint32_t len = end - prev, mt = (len + BM - 1) / BM;
    uint32_t tasks = mt * nt;

    for (; nextTask < taskBase + tasks && nextTask < stopTask; nextTask += (REUSE ? 1 : t.blocks)) {
      uint32_t local = nextTask - taskBase;
      uint32_t mr = (BN == 64 ? local : (REUSE ? local % mt : local / nt)) * BM;
      uint32_t nc = BN == 64 ? 0 : (REUSE ? local / mt : local % nt) * BN;
      uint32_t rows = (len - mr < BM ? len - mr : BM), cols = (t.n - nc < BN ? t.n - nc : BN);
#if defined(SPLIT_CORE_CUBE)
      if constexpr (DOUBLE_C) {
        if (done >= 2) {
          if (done & 1)
            CrossCoreWaitFlag<2>(4);
          else
            CrossCoreWaitFlag<2>(1);
        }
      } else if (done)
        CrossCoreWaitFlag<2>(1);
      mm.SetSingleShape(rows, cols, t.k);
      mm.SetTensorA(xg[(uint64_t)(prev + mr) * t.k]);
      mm.SetTensorB(wg[PADDED ? 0 : (uint64_t)e * t.k * t.n + nc]);
      if constexpr (DOUBLE_C)
        mm.IterateAll(cg[(done & 1) * ELEMS], done == 0);
      else
        mm.IterateAll(cg, done == 0);
      mm.End();
      if constexpr (DOUBLE_C) {
        if (done & 1)
          CrossCoreSetFlag<2, PIPE_FIX>(3);
        else
          CrossCoreSetFlag<2, PIPE_FIX>(0);
      } else
        CrossCoreSetFlag<2, PIPE_FIX>(0);
#endif
#if defined(SPLIT_CORE_VEC)
      const uint32_t vectorRows = (rows + VR - 1) / VR;
      const uint32_t rowOffset = GetSubBlockIdx() * vectorRows;
      const uint32_t currentRows = rows > rowOffset ? (rows - rowOffset < vectorRows ? rows - rowOffset : vectorRows) : 0;
      if (currentRows) {

        if (pending) WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
        DataCopyPad(s, sg[(uint64_t)e * t.n + nc], DataCopyExtParams{1, cols * 4, 0, 0, 0}, DataCopyPadExtParams<float>{true, 0, 0, 0});
      }
      if (done & 1)
        CrossCoreWaitFlag<2>(3);
      else
        CrossCoreWaitFlag<2>(0);
      if (currentRows) {
        if (cols == BN)
          DataCopy(a, cg[(done & 1) * ELEMS + rowOffset * BN], currentRows * BN);
        else
          DataCopyPad(a, cg[(done & 1) * ELEMS + rowOffset * BN],
            DataCopyExtParams{uint16_t(currentRows), cols * 4, (BN - cols) * 4, (BN - ((cols + 7) / 8 * 8)) / 8, 0},
            DataCopyPadExtParams<int32_t>{true, 0, 0, 0});
      }
      SetFlag<HardEvent::MTE2_S>(EVENT_ID0);
      WaitFlag<HardEvent::MTE2_S>(EVENT_ID0);
      if (done & 1)
        CrossCoreSetFlag<2, PIPE_MTE2>(4);
      else
        CrossCoreSetFlag<2, PIPE_MTE2>(1);
      if (currentRows) {
        const bool currentBank = pending ? !priorBank : false;
        auto zn = currentBank ? v : z;
        auto vn = currentBank ? z : v;
        const uint32_t count = currentRows * BN;
        SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
        WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
        if (pending) PipeBarrier<PIPE_V>();
        GmgShortPrefix595<BN> prefix{zn, u, a, s, currentRows, count};
        if (pending) {
          const bool started = GmgTileRepairStartPrefix595(vn, h, p, mask1, mask2, priorRows * BN, yg[priorOffset],
            DataCopyExtParams{uint16_t(priorRows), priorCols * 2, (BN - ((priorCols + 15) / 16 * 16)) / 16, (t.n - priorCols) * 2, 0}, prefix);
          if (!started) prefix.Run();
          SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
          SetFlag<HardEvent::S_V>(EVENT_ID0);
          WaitFlag<HardEvent::S_V>(EVENT_ID0);
        } else
          prefix.Run();
        GmgSmallTightQuotientAndFlags(zn, h, u, vn, p, a, mask1, mask2, count, pending);
        priorBank = currentBank;
        priorRows = currentRows;
        priorCols = cols;
        priorOffset = uint64_t(prev + mr + rowOffset) * t.n + nc;
        pending = true;
      }
#endif
      ++done;
    }
    taskBase += tasks;
    prev = end;

    if (end == t.m || (REUSE && GENERAL && nextTask >= stopTask)) break;
  }
#if defined(SPLIT_CORE_CUBE)
  if constexpr (DOUBLE_C) {

    if (done > 1) CrossCoreWaitFlag<2>(4);
    if (done) CrossCoreWaitFlag<2>(1);
  } else if (done)
    CrossCoreWaitFlag<2>(1);
  if (!done) CrossCoreWaitFlag<2>(2);
#endif
#if defined(SPLIT_CORE_VEC)
  if (pending) {
    WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
    auto zp = priorBank ? v : z;
    GmgTileRepairAndWrite(zp, h, p, mask1, mask2, priorRows * BN, yg[priorOffset],
      DataCopyExtParams{uint16_t(priorRows), priorCols * 2, (BN - ((priorCols + 15) / 16 * 16)) / 16, (t.n - priorCols) * 2, 0});
    SetFlag<HardEvent::MTE3_S>(EVENT_ID0);
    WaitFlag<HardEvent::MTE3_S>(EVENT_ID0);
  }
#endif
}

#if (!defined(GMG_SEPARATE_BUILD) || defined(GMG_BUILD_LATE_START)) && defined(SPLIT_CORE_VEC)
__aicore__ inline void GmgScreenSummary782(LocalTensor<uint8_t> mask1, LocalTensor<uint8_t> mask2, uint32_t count) {
  const uint32_t groups = count / 32;
  CompareScalar(mask2, mask1.ReinterpretCast<int32_t>(), int32_t(0), CMPMODE::EQ, ((groups + 63) / 64) * 64);
}

__aicore__ inline void GmgScreenPadding782(LocalTensor<uint8_t> mask1, uint32_t count) {
  const uint32_t groups = count / 32;
  if (groups % 64) Duplicate(mask1.ReinterpretCast<int32_t>()[(groups / 64) * 64], int32_t(0), 64);
}

__aicore__ inline void GmgShortSplitScreen782(LocalTensor<float> z, LocalTensor<half> h, LocalTensor<float> u, LocalTensor<float> p, LocalTensor<float> work,
  LocalTensor<uint16_t> masks, LocalTensor<uint8_t> mask1, LocalTensor<uint8_t> mask2, uint32_t count, bool wrotePrevious) {
  SetMaskCount();
  SetVectorMask<float, MaskMode::COUNTER>(count);
  Div<float, false>(p, z, u, MASK_PLACEHOLDER, 1, {1, 1, 1, 8, 8, 8});
  if (wrotePrevious) WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
  Cast<half, float, false>(h, p, RoundMode::CAST_RINT, MASK_PLACEHOLDER, 1, {1, 1, 4, 8});
  Abs<float, false>(p, p, MASK_PLACEHOLDER, 1, {1, 1, 8, 8});
  auto normal = work.ReinterpretCast<int32_t>();
  Adds<int32_t, false>(normal, p.ReinterpretCast<int32_t>(), int32_t(8), MASK_PLACEHOLDER, 1, {1, 1, 8, 8});
  Adds<float, false>(u, p, 0x1.00002p-14f, MASK_PLACEHOLDER, 1, {1, 1, 8, 8});
  auto normalBits = normal.ReinterpretCast<uint16_t>();
  auto tinyBits = u.ReinterpretCast<uint16_t>();
  SetVectorMask<uint16_t, MaskMode::COUNTER>(2 * count);
  And<uint16_t, false>(normalBits, normalBits, masks, MASK_PLACEHOLDER, 1, {1, 1, 0, 8, 8, 0});
  And<uint16_t, false>(tinyBits, tinyBits, masks[16], MASK_PLACEHOLDER, 1, {1, 1, 0, 8, 8, 0});
  SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
  SetMaskNorm();
  ResetMask();
  GmgScreenPadding782(mask1, count);
  CompareScalar(mask1, normal, int32_t(0x40001000), CMPMODE::EQ, count);
  CompareScalar(mask2, u.ReinterpretCast<int32_t>(), int32_t(0x38801000), CMPMODE::EQ, count);
  GmgMaskCombine<true, true>(mask1, mask1, mask2, count / 16);
  CompareScalar(mask2, z, 8.0f, CMPMODE::LT, count);
  GmgMaskCombine<false, true>(mask1, mask1, mask2, count / 16);
  GmgScreenSummary782(mask1, mask2, count);
  SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
  SetFlag<HardEvent::V_S>(EVENT_ID0);
}

__aicore__ inline void GmgShortOriginalBitmap782(LocalTensor<float> z, LocalTensor<float> p, LocalTensor<float> u, LocalTensor<float> work,
  LocalTensor<uint8_t> mask1, LocalTensor<uint8_t> mask2, uint32_t count) {
  // Use the next free z bank, not the raw-C arena that may already
  // contain the next tile. Previous z, p, h are read-only here.
  SetMaskCount();
  SetVectorMask<float, MaskMode::COUNTER>(count);
  Maxs<float, false>(work, p, 0x1p-14f, MASK_PLACEHOLDER, 1, {1, 1, 8, 8});
  Add<float, false>(u, work, p, MASK_PLACEHOLDER, 1, {1, 1, 1, 8, 8, 8});
  ShiftLeft<uint32_t, false>(work.ReinterpretCast<uint32_t>(), u.ReinterpretCast<uint32_t>(), uint32_t(19), MASK_PLACEHOLDER, 1, {1, 1, 8, 8});
  Cast<float, int32_t, false>(u, work.ReinterpretCast<int32_t>(), RoundMode::CAST_RINT, MASK_PLACEHOLDER, 1, {1, 1, 8, 8});
  Abs<float, false>(u, u, MASK_PLACEHOLDER, 1, {1, 1, 8, 8});
  SetMaskNorm();
  ResetMask();
  auto mask3 = work.ReinterpretCast<uint8_t>();
  GmgScreenPadding782(mask1, count);
  CompareScalar(mask1, p, 2.0f, CMPMODE::GE, count);
  CompareScalar(mask2, u, 0x1p31f - 4.5f * 0x1p19f, CMPMODE::GE, count);
  GmgMaskCombine<false, true>(mask1, mask1, mask2, count / 16);
  Axpy<float, float>(u, p, 0.0000010004f * 0x1p56f, uint64_t(64), uint8_t(count / 64), {1, 1, 8, 8});
  CompareScalar(mask2, u, 0x1p31f - 0x1p18f - 512.0f, CMPMODE::GE, count);
  CompareScalar(mask3, p, 0x1p-14f, CMPMODE::LT, count);
  GmgMaskCombine<false, true>(mask2, mask2, mask3, count / 16);
  GmgMaskCombine<true, true>(mask1, mask1, mask2, count / 16);
  CompareScalar(mask2, z, 8.0f, CMPMODE::LT, count);
  GmgMaskCombine<false, true>(mask1, mask1, mask2, count / 16);
  GmgScreenSummary782(mask1, mask2, count);
}

__aicore__ inline bool GmgRepairNeeded782(LocalTensor<float> z, LocalTensor<float> p, LocalTensor<half> h, uint32_t index) {
  const float magnitude = p.GetValue(index);
  if (magnitude >= 0x1p-14f) {
    union {
      float f;
      uint32_t u;
    } mb;
    mb.f = magnitude;
    int32_t offset = int32_t(mb.u & 8191) - 4096;
    if (offset < 0) offset = -offset;
    const float mantissa = float(int32_t((mb.u & 0x7fffff) | 0x800000));
    return float(offset) <= mantissa * 0.0000002505f;
  }
  const uint16_t hb = h.ReinterpretCast<uint16_t>().GetValue(index) & 0x7fff;
  float delta = magnitude - float(int32_t(hb)) * 0x1p-24f;
  if (delta < 0) delta = -delta;
  return delta >= 0x1p-25f - magnitude * 0.000001000f || (delta >= 0x1p-25f - magnitude * 0.000020000f && z.GetValue(index) < -3.0f);
}

__aicore__ inline uint64_t GmgActiveRepairGroups782(LocalTensor<uint8_t> summary, uint32_t groupCount, uint32_t word) {
  uint64_t active = ~summary.ReinterpretCast<uint64_t>().GetValue(word);
  const uint32_t left = groupCount - word * 64;
  if (left < 64) active &= (1ULL << left) - 1;
  return active;
}

template <class Prefix>
__aicore__ inline bool GmgShortRepair782(LocalTensor<float> z, LocalTensor<half> h, LocalTensor<float> p, LocalTensor<float> u, LocalTensor<float> work,
  LocalTensor<uint8_t> mask1, LocalTensor<uint8_t> mask2, LocalTensor<uint16_t> queue, uint32_t count, GlobalTensor<half> dst, const DataCopyExtParams &copy,
  Prefix &prefix, bool haveNext) {
  constexpr uint32_t LIMIT = 64;
  const uint32_t groups = count / 32, words = (groups + 63) / 64;
  uint32_t seen = 0, queued = 0, frontier = groups;
  WaitFlag<HardEvent::V_S>(EVENT_ID0);
  for (uint32_t word = 0; word < words && frontier == groups; ++word) {
    uint64_t active = GmgActiveRepairGroups782(mask2, groups, word);
    while (active) {
      const uint32_t group = word * 64 + __builtin_ctzll(active);
      uint32_t bits = mask1.ReinterpretCast<uint32_t>().GetValue(group);
      seen += uint32_t(GetBitCount<1>(uint64_t(bits)));
      if (seen > LIMIT) {
        frontier = group;
        break;
      }
      while (bits) {
        const uint32_t index = group * 32 + __builtin_ctz(bits);
        if (GmgRepairNeeded782(z, p, h, index)) queue.SetValue(queued++, uint16_t(index));
        bits &= bits - 1;
      }
      active &= active - 1;
    }
  }

  uint32_t word = words, group = 0, bits = 0;
  uint64_t active = 0;
  if (frontier < groups) {
    // Earlier groups were filtered with the original exact predicate.
    // Regenerate the original mask only for continuing from this frontier.
    SetFlag<HardEvent::S_V>(EVENT_ID0);
    WaitFlag<HardEvent::S_V>(EVENT_ID0);
    GmgShortOriginalBitmap782(z, p, u, work, mask1, mask2, count);
    SetFlag<HardEvent::V_S>(EVENT_ID0);
    WaitFlag<HardEvent::V_S>(EVENT_ID0);
    word = frontier / 64;
    active = GmgActiveRepairGroups782(mask2, groups, word) & (~0ULL << (frontier % 64));
  }
  bool started = false;
  uint32_t consumed = 0;
  while (true) {
    uint32_t index;
    if (consumed < queued)
      index = queue.GetValue(consumed++);
    else {
      while (!bits) {
        while (!active && word < words && ++word < words) active = GmgActiveRepairGroups782(mask2, groups, word);
        if (!active) break;
        group = word * 64 + __builtin_ctzll(active);
        bits = mask1.ReinterpretCast<uint32_t>().GetValue(group);
        active &= active - 1;
      }
      if (!bits) break;
      index = group * 32 + __builtin_ctz(bits);
      bits &= bits - 1;
      if (!GmgRepairNeeded782(z, p, h, index)) continue;
    }
    const float value = z.GetValue(index);
    if (haveNext && !started) {
      prefix.Run();
      started = true;
    }
    h.ReinterpretCast<uint16_t>().SetValue(index, GmgAccurateGeluSmall(value));
  }
  SetFlag<HardEvent::S_MTE3>(EVENT_ID0);
  WaitFlag<HardEvent::S_MTE3>(EVENT_ID0);
  WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
  DataCopyPad(dst, h, copy);
  return started;
}

__aicore__ inline void GmgShortEpilogue782(GM_ADDR scale, GM_ADDR groups, GM_ADDR y, GM_ADDR workspace, const GmgTiling &t) {
  constexpr uint32_t BM = 64, BN = 256, ELEMS = BM * BN, VELEMS = ELEMS / 2;
  const uint32_t core = GetBlockIdx() / GetTaskRation(), sub = GetSubBlockIdx();
  TPipe pipe;
  GlobalTensor<int64_t> gg;
  gg.SetGlobalBuffer((__gm__ int64_t *)groups);
  GlobalTensor<float> sg;
  sg.SetGlobalBuffer((__gm__ float *)scale);
  GlobalTensor<half> yg;
  yg.SetGlobalBuffer((__gm__ half *)y);
  GlobalTensor<int32_t> cg;
  cg.SetGlobalBuffer((__gm__ int32_t *)workspace + core * 2 * ELEMS);
  TBuf<TPosition::VECCALC> ab, zb, ub, pb, sb, hb, groupBuffer;
  pipe.InitBuffer(ab, (VELEMS * 4) + 256);
  pipe.InitBuffer(zb, (VELEMS * 4) + 256);
  pipe.InitBuffer(ub, (VELEMS * 4) + 256);
  pipe.InitBuffer(pb, (VELEMS * 4) + 256);
  pipe.InitBuffer(sb, (BN * 4) + 256);
  pipe.InitBuffer(hb, (VELEMS * 2) + 256);

  auto a = ab.Get<int32_t>();
  auto z = zb.Get<float>();
  auto u = ub.Get<float>();
  auto p = pb.Get<float>();
  auto s = sb.Get<float>();
  auto h = hb.Get<half>();

  pipe.InitBuffer(groupBuffer, 128 * 8);

  auto localGroups = groupBuffer.Get<int64_t>();
  const bool useLocalGroups = t.e >= 16;
  if (useLocalGroups) {
    GlobalTensor<int32_t> words;
    words.SetGlobalBuffer((__gm__ int32_t *)groups);
    DataCopyPad(
      groupBuffer.Get<int32_t>(), words, DataCopyExtParams{1, t.e * 8, 0, 0, 0}, DataCopyPadExtParams<int32_t>{true, 0, uint8_t((4 - t.e % 4) % 4 * 2), 0});
    SetFlag<HardEvent::MTE2_S>(EVENT_ID0);
    WaitFlag<HardEvent::MTE2_S>(EVENT_ID0);
  }
  Duplicate(a, int32_t(0), VELEMS);
  SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
  WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
  DataCopy(cg[sub * VELEMS], a, VELEMS);
  DataCopy(cg[ELEMS + sub * VELEMS], a, VELEMS);
  CrossCoreSetFlag<2, PIPE_MTE3>(2);
  const uint32_t nt = t.n / BN;
  uint32_t expert = useLocalGroups ? GmgFirstExpert(localGroups, t.e) : GmgFirstExpert(gg, t.e);
  uint32_t begin = 0, end = 0, taskBase = 0, taskEnd = 0, nextTask = core, done = 0;
  while (true) {
    while (nextTask >= taskEnd && expert < t.e && end < t.m) {
      begin = end;
      end = useLocalGroups ? uint32_t(localGroups.GetValue(expert)) : uint32_t(gg.GetValue(expert));
      ++expert;
      taskBase = taskEnd;
      taskEnd += (end - begin + BM - 1) / BM * nt;
    }
    if (nextTask >= taskEnd) break;
    const uint32_t local = nextTask - taskBase;
    nextTask += t.blocks;
    const uint32_t mr = local / nt * BM, nc = local % nt * BN;
    const uint32_t remain = end - begin - mr, rows = remain < BM ? remain : BM;
    const uint32_t vrows = (rows + 1) / 2, off = sub * vrows;
    const uint32_t currentRows = rows > off ? (rows - off < vrows ? rows - off : vrows) : 0;
    if (currentRows) DataCopy(s, sg[uint64_t(expert - 1) * t.n + nc], BN);
    if (done & 1)
      CrossCoreWaitFlag<2>(3);
    else
      CrossCoreWaitFlag<2>(0);
    if (currentRows) DataCopy(a, cg[(done & 1) * ELEMS + off * BN], currentRows * BN);
    SetFlag<HardEvent::MTE2_S>(EVENT_ID0);
    WaitFlag<HardEvent::MTE2_S>(EVENT_ID0);
    if (done & 1)
      CrossCoreSetFlag<2, PIPE_MTE2>(4);
    else
      CrossCoreSetFlag<2, PIPE_MTE2>(1);
    ++done;
    if (!currentRows) continue;
    SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
    WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
    const uint32_t count = currentRows * BN;
    Cast(z, a, RoundMode::CAST_RINT, count);
    for (uint32_t c = 0; c < BN; c += 64) Mul(z[c], z[c], s[c], uint64_t(64), uint8_t(currentRows), BinaryRepeatParams{1, 1, 1, BN / 8, BN / 8, 0});
    SetMaskCount();
    SetVectorMask<float, MaskMode::COUNTER>(count);
    Mul<float, false>(u, z, z, MASK_PLACEHOLDER, 1, {1, 1, 1, 8, 8, 8});
    Muls<float, false>(u, u, -0.07135481759315014f, MASK_PLACEHOLDER, 1, {1, 1, 8, 8});
    Adds<float, false>(u, u, -1.5957691216057308f, MASK_PLACEHOLDER, 1, {1, 1, 8, 8});
    Mul<float, false>(u, u, z, MASK_PLACEHOLDER, 1, {1, 1, 1, 8, 8, 8});
    Mins<float, false>(u, u, 80.0f, MASK_PLACEHOLDER, 1, {1, 1, 8, 8});
    Exp<float, false>(u, u, MASK_PLACEHOLDER, 1, {1, 1, 8, 8});
    Adds<float, false>(u, u, 1.0f, MASK_PLACEHOLDER, 1, {1, 1, 8, 8});
    Div<float, false>(p, z, u, MASK_PLACEHOLDER, 1, {1, 1, 1, 8, 8, 8});
    Cast<half, float, false>(h, p, RoundMode::CAST_RINT, MASK_PLACEHOLDER, 1, {1, 1, 4, 8});
    SetMaskNorm();
    ResetMask();
    SetFlag<HardEvent::S_MTE3>(EVENT_ID0);
    WaitFlag<HardEvent::S_MTE3>(EVENT_ID0);
    SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
    WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
    DataCopyPad(yg[uint64_t(begin + mr + off) * t.n + nc], h, DataCopyExtParams{uint16_t(currentRows), BN * 2, 0, (t.n - BN) * 2, 0});
    SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
    WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
    SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
    WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
  }
}
#endif

#if !defined(GMG_SEPARATE_BUILD) || defined(GMG_BUILD_LATE_START)
extern "C" __global__ __mix__(1, 2) void groupmatmulgelu_start_cube_legacyvec(
  GM_ADDR x, GM_ADDR w, GM_ADDR scale, GM_ADDR groups, GM_ADDR y, GM_ADDR workspace, GmgTiling t) {
#if defined(SPLIT_CORE_VEC)
  GmgShortEpilogue782(scale, groups, y, workspace, t);
#else
  GmgComputeShortLegacyVec405<64, 256, false, false, true, false, false, false, 2048, true>(x, w, scale, groups, y, workspace, t);
#endif
}
#endif

#if !defined(GMG_SEPARATE_BUILD) || defined(GMG_BUILD_LATE_START)
extern "C" __global__ __mix__(1, 2) void groupmatmulgelu_start_cube(
  GM_ADDR x, GM_ADDR w, GM_ADDR scale, GM_ADDR groups, GM_ADDR y, GM_ADDR workspace, GmgTiling t) {
  GmgComputeSmallTightLateStart<64, 256, false, false, true, false, false, false, 2048, true>(x, w, scale, groups, y, workspace, t);
}
#endif

template <uint32_t BM, uint32_t BN, bool MDL = false, bool REUSE = false, bool DIRECT = false, bool PADDED = false, bool GENERAL = false, bool STREAM = false,
  uint32_t DIRECT_MAX_K = 2048, bool USE_SMALL_GELU = false>
__aicore__ inline void GmgComputeWideLateStart(GM_ADDR x, GM_ADDR w, GM_ADDR scale, GM_ADDR groups, GM_ADDR y, GM_ADDR workspace, const GmgTiling &t) {
  constexpr uint32_t ELEMS = BM * BN, VR = 2, CHUNK_ROWS = 8192 / BN, VELEMS = (BM > 2 * CHUNK_ROWS ? 2 * CHUNK_ROWS : BM) * BN / VR;
  constexpr bool DOUBLE_C = (BM == 128 || BN > 256);
  TPipe pipe;
  const uint32_t core = GetBlockIdx() / GetTaskRation();
  typename Conditional<PADDED, GmgWordWeightPacker, GmgNoWeightPacker>::type packer;
  if constexpr (PADDED) {
    auto padded = workspace + uint64_t(t.blocks) * t.bm * t.bn * 4 + uint64_t(core) * ((t.k + 511) / 512 * 512) * ((t.n + 31) / 32 * 32);
    packer.Init(w, padded, t, pipe);
    w = padded;
  }
  GlobalTensor<int8_t> xg, wg;
  GlobalTensor<int64_t> gg;
  GlobalTensor<float> sg;
  GlobalTensor<half> yg;
  GlobalTensor<int32_t> cg;
  xg.SetGlobalBuffer((__gm__ int8_t *)x);
  wg.SetGlobalBuffer((__gm__ int8_t *)w);
  gg.SetGlobalBuffer((__gm__ int64_t *)groups);
  sg.SetGlobalBuffer((__gm__ float *)scale);
  yg.SetGlobalBuffer((__gm__ half *)y);
  cg.SetGlobalBuffer((__gm__ int32_t *)workspace + core * ELEMS * ((DOUBLE_C || (REUSE && GENERAL)) ? 2 : 1));

#if defined(SPLIT_CORE_CUBE)
  if constexpr (!DIRECT && !STREAM) GmgPrepareL1(pipe, t);
  using CubeOp = typename Conditional<DIRECT, GmgStartupWideCube<false, BN, BM, DIRECT_MAX_K, 256>, GmgDirectCube>::type;
  CubeOp mm;
  mm.Init(&t.cube, &pipe);
  mm.SetOrgShape(REUSE ? t.m : BM, PADDED ? (t.n + 31) / 32 * 32 : t.n, t.k, t.k, BN);
#endif

#if defined(SPLIT_CORE_VEC)
  TBuf<TPosition::VECCALC> ab, zb, ub, vb, pb, sb, hb, maskb1, maskb2, groupBuffer;
  pipe.InitBuffer(ab, (VELEMS * 4) + 256);
  pipe.InitBuffer(zb, (VELEMS * 4) + 256);
  pipe.InitBuffer(ub, (VELEMS * 4) + 256);
  pipe.InitBuffer(vb, (VELEMS * 4) + 256);
  pipe.InitBuffer(pb, (VELEMS * 4) + 256);
  pipe.InitBuffer(sb, (BN * 4) + 256);
  pipe.InitBuffer(hb, (VELEMS * 2) + 256);
  pipe.InitBuffer(maskb1, (VELEMS / 8) + 256);
  pipe.InitBuffer(maskb2, (VELEMS / 8) + 256);
  auto a = ab.Get<int32_t>();
  auto z = zb.Get<float>();
  auto u = ub.Get<float>();
  auto v = vb.Get<float>();
  auto p = pb.Get<float>();
  auto s = sb.Get<float>();
  auto h = hb.Get<half>();
  auto mask1 = maskb1.Get<uint8_t>();
  auto mask2 = maskb2.Get<uint8_t>();

  LocalTensor<int64_t> localGroups;
  bool useLocalGroups = false;
  if constexpr ((DIRECT && BN == 256 && !GENERAL) || (REUSE && GENERAL)) {
    pipe.InitBuffer(groupBuffer, 128 * 8);
    localGroups = groupBuffer.Get<int64_t>();
    useLocalGroups = t.e >= 16;
    if (useLocalGroups) {
      GlobalTensor<int32_t> groupWords;
      groupWords.SetGlobalBuffer((__gm__ int32_t *)groups);
      DataCopyPad(groupBuffer.Get<int32_t>(), groupWords, DataCopyExtParams{1, t.e * 8, 0, 0, 0},
        DataCopyPadExtParams<int32_t>{true, 0, uint8_t((4 - t.e % 4) % 4 * 2), 0});
      SetFlag<HardEvent::MTE2_S>(EVENT_ID0);
      WaitFlag<HardEvent::MTE2_S>(EVENT_ID0);
    }
  }

  CrossCoreSetFlag<2, PIPE_MTE3>(2);
  if (t.n % BN) {
    Duplicate(s, 0.0f, BN);
    SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
    WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
  }
#endif
  uint32_t taskBase = 0, prev = 0, done = 0, nextTask = core, packedExpert = t.e;

  const uint32_t nt = BN == 64 ? 1 : (t.n + BN - 1) / BN;
#if defined(SPLIT_CORE_VEC)
  uint32_t firstExpert = useLocalGroups ? GmgFirstExpert(localGroups, t.e) : GmgFirstExpert(gg, t.e);
#else
  uint32_t firstExpert = GmgFirstExpert(gg, t.e);
#endif
  uint32_t stopTask = 0xffffffffU, runRemaining = 0;
  if constexpr (REUSE) {
    uint32_t total = 0, before = 0;
    for (uint32_t e = firstExpert; e < t.e; ++e) {
      uint32_t end =
#if defined(SPLIT_CORE_VEC)
        useLocalGroups ? localGroups.GetValue(e) : gg.GetValue(e);
#else
        gg.GetValue(e);
#endif
      total += (end - before + BM - 1) / BM * nt;
      before = end;
      if (end == t.m) break;
    }
    nextTask = total * core / t.blocks;
    stopTask = total * (core + 1) / t.blocks;
  }

  bool mergeTail = false;
  if constexpr (DIRECT && !PADDED && !REUSE && BM == 64 && BN == 512 && DIRECT_MAX_K == 2048) {
    const uint32_t tail = t.n % BN;
    mergeTail = tail > BN / 4 && tail <= BN / 2 && t.k <= DIRECT_MAX_K / 2;
  }
  for (uint32_t columnPhase = 0; columnPhase < (BN > 256 && t.n % BN ? 2U : 1U); ++columnPhase) {
    const uint32_t phaseNt = BN > 256 ? (columnPhase ? 1 : t.n / BN) : nt;
    const bool taller = columnPhase && mergeTail;
    const uint32_t phaseBM = taller ? 2 * BM : BM;
    prev = 0;
    for (uint32_t e = firstExpert; e < t.e; ++e) {
      uint32_t end =
#if defined(SPLIT_CORE_VEC)
        useLocalGroups ? localGroups.GetValue(e) : gg.GetValue(e);
#else
        gg.GetValue(e);
#endif
      uint32_t len = end - prev, mt = taller ? ((len + 2 * BM - 1) / (2 * BM)) : ((len + BM - 1) / BM);
      uint32_t tasks = mt * phaseNt;

      for (; nextTask < taskBase + tasks && nextTask < stopTask; nextTask += (REUSE ? 1 : t.blocks)) {
        uint32_t local = nextTask - taskBase;
        uint32_t mr = (BN == 64 ? local : (REUSE ? local % mt : local / phaseNt)) * phaseBM;
        uint32_t nc = BN == 64 ? 0 : (REUSE ? local / mt : local % phaseNt) * BN;
        if constexpr (BN > 256) {
          if (columnPhase) nc = (t.n / BN) * BN;
        }
        uint32_t rows = (len - mr < phaseBM ? len - mr : phaseBM), cols = (t.n - nc < BN ? t.n - nc : BN);
        if constexpr (PADDED)
          if (packedExpert != e) {
            packer.Pack(e, 0, t.k);
            packedExpert = e;
          }
#if defined(SPLIT_CORE_CUBE)
        if constexpr (DOUBLE_C) {
          if (done >= 2) {
            if (done & 1)
              CrossCoreWaitFlag<2>(4);
            else
              CrossCoreWaitFlag<2>(1);
          }
        } else if (done)
          CrossCoreWaitFlag<2>(1);
        if constexpr (REUSE) {

          if (!runRemaining) {
            runRemaining = mt - local % mt;
            if (runRemaining > stopTask - nextTask) runRemaining = stopTask - nextTask;
            uint32_t runRows = runRemaining * BM;
            if (runRows > len - mr) runRows = len - mr;
            mm.SetSingleShape(runRows, cols, t.k);
            mm.SetTensorA(xg[(uint64_t)(prev + mr) * t.k]);
            mm.SetTensorB(wg[(uint64_t)e * t.k * t.n + nc]);
          }
          mm.Iterate();
          mm.GetTensorC(cg, 0, true);
          if (!--runRemaining) {
            mm.Iterate();
            mm.End();
          }
        } else {
          mm.SetSingleShape(rows, cols, t.k);
          mm.SetTensorA(xg[(uint64_t)(prev + mr) * t.k]);
          mm.SetTensorB(wg[PADDED ? 0 : (uint64_t)e * t.k * t.n + nc]);
          if constexpr (DOUBLE_C)
            mm.IterateAll(cg[(done & 1) * ELEMS], done == 0);
          else
            mm.IterateAll(cg, done == 0);
          mm.End();
        }
        if constexpr (DOUBLE_C) {
          if (done & 1)
            CrossCoreSetFlag<2, PIPE_FIX>(3);
          else
            CrossCoreSetFlag<2, PIPE_FIX>(0);
        } else
          CrossCoreSetFlag<2, PIPE_FIX>(0);
#endif
#if defined(SPLIT_CORE_VEC)
        if constexpr (DOUBLE_C) {
          const uint32_t cPitch = rows > BM && taller ? BN / 2 : BN;
          uint32_t vectorRows = (rows + VR - 1) / VR;
          uint32_t rowOffset = GetSubBlockIdx() * vectorRows;
          rows = rows > rowOffset ? (rows - rowOffset < vectorRows ? rows - rowOffset : vectorRows) : 0;
          if (rows) DataCopyPad(s, sg[(uint64_t)e * t.n + nc], DataCopyExtParams{1, cols * 4, 0, 0, 0}, DataCopyPadExtParams<float>{true, 0, 0, 0});
          if (done & 1)
            CrossCoreWaitFlag<2>(3);
          else
            CrossCoreWaitFlag<2>(0);

          uint32_t vectorStride = BN > 256 ? (cols + 63) / 64 * 64 : BN;
          uint32_t chunkRows = BN > 256 ? 8192 / vectorStride : CHUNK_ROWS;
          uint32_t chunks = (rows + chunkRows - 1) / chunkRows;
          if (!chunks) chunks = 1;
          for (uint32_t chunk = 0; chunk < chunks; ++chunk) {
            uint32_t first = chunk * chunkRows;
            uint32_t currentRows = rows > first ? (rows - first < chunkRows ? rows - first : chunkRows) : 0;
            if (currentRows) {
              if (cols == BN)
                DataCopy(a, cg[(done & 1) * ELEMS + (rowOffset + first) * BN], currentRows * BN);
              else
                DataCopyPad(a, cg[(done & 1) * ELEMS + (rowOffset + first) * cPitch],
                  DataCopyExtParams{uint16_t(currentRows), cols * 4, (cPitch - cols) * 4, (vectorStride - ((cols + 7) / 8 * 8)) / 8, 0},
                  DataCopyPadExtParams<int32_t>{true, 0, 0, 0});
            }
            SetFlag<HardEvent::MTE2_S>(EVENT_ID0);
            WaitFlag<HardEvent::MTE2_S>(EVENT_ID0);

            if (chunk + 1 == chunks) {
              if (done & 1)
                CrossCoreSetFlag<2, PIPE_MTE2>(4);
              else
                CrossCoreSetFlag<2, PIPE_MTE2>(1);
            }
            if (currentRows) {
              SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
              WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
              uint32_t count = currentRows * vectorStride;
              Cast(z, a, RoundMode::CAST_RINT, count);
              for (uint32_t c = 0; c < vectorStride; c += 64)
                Mul(z[c], z[c], s[c], uint64_t(64), uint8_t(currentRows), BinaryRepeatParams{1, 1, 1, uint8_t(vectorStride / 8), uint8_t(vectorStride / 8), 0});
              if constexpr (USE_SMALL_GELU)
                GmgGeluSmall<true, true>(z, h, u, v, p, a, mask1, mask2, count);
              else
                GmgGelu<true>(z, h, u, v, p, a, mask1, mask2, count);
              SetFlag<HardEvent::S_MTE3>(EVENT_ID0);
              WaitFlag<HardEvent::S_MTE3>(EVENT_ID0);
              SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
              WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
              DataCopyPad(yg[uint64_t(prev + mr + rowOffset + first) * t.n + nc], h,
                DataCopyExtParams{uint16_t(currentRows), cols * 2, (vectorStride - ((cols + 15) / 16 * 16)) / 16, (t.n - cols) * 2, 0});
              SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
              WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
            }
          }
        } else {
          uint32_t vectorRows = (rows + VR - 1) / VR;
          uint32_t rowOffset = GetSubBlockIdx() * vectorRows;
          rows = rows > rowOffset ? (rows - rowOffset < vectorRows ? rows - rowOffset : vectorRows) : 0;
          mr += rowOffset;

          if (rows) DataCopyPad(s, sg[(uint64_t)e * t.n + nc], DataCopyExtParams{1, cols * 4, 0, 0, 0}, DataCopyPadExtParams<float>{true, 0, 0, 0});
          CrossCoreWaitFlag<2>(0);
          if (rows) {
            if (cols == BN)
              DataCopy(a, cg[(REUSE && GENERAL ? (done & 1) * ELEMS : 0) + rowOffset * BN], rows * BN);
            else
              DataCopyPad(a, cg[(REUSE && GENERAL ? (done & 1) * ELEMS : 0) + rowOffset * ((REUSE && !GENERAL) ? cols : BN)],
                DataCopyExtParams{(uint16_t)rows, cols * 4, ((REUSE && !GENERAL) ? 0 : (BN - cols) * 4), (BN - ((cols + 7) / 8 * 8)) / 8, 0},
                DataCopyPadExtParams<int32_t>{true, 0, 0, 0});
          }
          SetFlag<HardEvent::MTE2_S>(EVENT_ID0);
          WaitFlag<HardEvent::MTE2_S>(EVENT_ID0);
          CrossCoreSetFlag<2, PIPE_MTE2>(1);
          if (rows) {
            SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
            WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
            uint32_t count = rows * BN;
            Cast(z, a, RoundMode::CAST_RINT, count);

            for (uint32_t c = 0; c < BN; c += 64) Mul(z[c], z[c], s[c], uint64_t(64), uint8_t(rows), BinaryRepeatParams{1, 1, 1, BN / 8, BN / 8, 0});
            GmgGelu<DIRECT && BN == 256>(z, h, u, v, p, a, mask1, mask2, count);
            SetFlag<HardEvent::S_MTE3>(EVENT_ID0);
            WaitFlag<HardEvent::S_MTE3>(EVENT_ID0);
            SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
            WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
            DataCopyPad(
              yg[(uint64_t)(prev + mr) * t.n + nc], h, DataCopyExtParams{(uint16_t)rows, cols * 2, (BN - ((cols + 15) / 16 * 16)) / 16, (t.n - cols) * 2, 0});
            SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
            WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
          }
        }
#endif
        ++done;
      }
      taskBase += tasks;
      prev = end;

      if (end == t.m || (REUSE && GENERAL && nextTask >= stopTask)) break;
    }
  }
#if defined(SPLIT_CORE_CUBE)
  if constexpr (DOUBLE_C) {

    if (done > 1) CrossCoreWaitFlag<2>(4);
    if (done) CrossCoreWaitFlag<2>(1);
  } else if (done)
    CrossCoreWaitFlag<2>(1);
  if (!done) CrossCoreWaitFlag<2>(2);

#endif
}

#if !defined(GMG_SEPARATE_BUILD) || defined(GMG_BUILD_LATE_START)
extern "C" __global__ __mix__(1, 2) void groupmatmulgelu_start_panel(
  GM_ADDR x, GM_ADDR w, GM_ADDR scale, GM_ADDR groups, GM_ADDR y, GM_ADDR workspace, GmgTiling t) {
  GmgComputeWideLateStart<64, 512, false, false, true, false, true, false, 2048, true>(x, w, scale, groups, y, workspace, t);
}
#endif

template <uint32_t BM, uint32_t BN, bool MDL = false, bool REUSE = false, bool DIRECT = false, bool PADDED = false, bool GENERAL = false, bool STREAM = false,
  uint32_t DIRECT_MAX_K = 2048, bool USE_SMALL_GELU = false, bool NARROW_TAIL = false, bool RESHAPE_FULL = false>
__aicore__ inline void GmgComputeWideLongTail(GM_ADDR x, GM_ADDR w, GM_ADDR scale, GM_ADDR groups, GM_ADDR y, GM_ADDR workspace, const GmgTiling &t) {
  constexpr uint32_t ELEMS = BM * BN, VR = 2, CHUNK_ROWS = 8192 / BN, VELEMS = (BM > 2 * CHUNK_ROWS ? 2 * CHUNK_ROWS : BM) * BN / VR;
  constexpr bool DOUBLE_C = (BM == 128 || BN > 256);
  TPipe pipe;
  const uint32_t core = GetBlockIdx() / GetTaskRation();
  typename Conditional<PADDED, GmgWordWeightPacker, GmgNoWeightPacker>::type packer;
  if constexpr (PADDED) {
    auto padded = workspace + uint64_t(t.blocks) * t.bm * t.bn * 4 + uint64_t(core) * ((t.k + 511) / 512 * 512) * ((t.n + 31) / 32 * 32);
    packer.Init(w, padded, t, pipe);
    w = padded;
  }
  GlobalTensor<int8_t> xg, wg;
  GlobalTensor<int64_t> gg;
  GlobalTensor<float> sg;
  GlobalTensor<half> yg;
  GlobalTensor<int32_t> cg;
  xg.SetGlobalBuffer((__gm__ int8_t *)x);
  wg.SetGlobalBuffer((__gm__ int8_t *)w);
  gg.SetGlobalBuffer((__gm__ int64_t *)groups);
  sg.SetGlobalBuffer((__gm__ float *)scale);
  yg.SetGlobalBuffer((__gm__ half *)y);
  cg.SetGlobalBuffer((__gm__ int32_t *)workspace + core * ELEMS * ((DOUBLE_C || (REUSE && GENERAL)) ? 2 : 1));

#if defined(SPLIT_CORE_CUBE)
  if constexpr (!DIRECT && !STREAM) GmgPrepareL1(pipe, t);
  using CubeOp = typename Conditional<DIRECT, GmgStartupWideLongTailCube<false, BN, BM, DIRECT_MAX_K, 256, NARROW_TAIL, RESHAPE_FULL>, GmgDirectCube>::type;
  CubeOp mm;
  mm.Init(&t.cube, &pipe);
  mm.SetOrgShape(REUSE ? t.m : BM, PADDED ? (t.n + 31) / 32 * 32 : t.n, t.k, t.k, BN);
#endif

#if defined(SPLIT_CORE_VEC)
  TBuf<TPosition::VECCALC> ab, zb, ub, vb, pb, sb, hb, maskb1, maskb2, groupBuffer;
  pipe.InitBuffer(ab, (VELEMS * 4) + 256);
  pipe.InitBuffer(zb, (VELEMS * 4) + 256);
  pipe.InitBuffer(ub, (VELEMS * 4) + 256);
  pipe.InitBuffer(vb, (VELEMS * 4) + 256);
  pipe.InitBuffer(pb, (VELEMS * 4) + 256);
  pipe.InitBuffer(sb, (BN * 4) + 256);
  pipe.InitBuffer(hb, (VELEMS * 2) + 256);
  pipe.InitBuffer(maskb1, (VELEMS / 8) + 256);
  pipe.InitBuffer(maskb2, (VELEMS / 8) + 256);
  auto a = ab.Get<int32_t>();
  auto z = zb.Get<float>();
  auto u = ub.Get<float>();
  auto v = vb.Get<float>();
  auto p = pb.Get<float>();
  auto s = sb.Get<float>();
  auto h = hb.Get<half>();
  auto mask1 = maskb1.Get<uint8_t>();
  auto mask2 = maskb2.Get<uint8_t>();

  LocalTensor<int64_t> localGroups;
  bool useLocalGroups = false;
  if constexpr ((DIRECT && BN == 256 && !GENERAL) || (REUSE && GENERAL)) {
    pipe.InitBuffer(groupBuffer, 128 * 8);
    localGroups = groupBuffer.Get<int64_t>();
    useLocalGroups = t.e >= 16;
    if (useLocalGroups) {
      GlobalTensor<int32_t> groupWords;
      groupWords.SetGlobalBuffer((__gm__ int32_t *)groups);
      DataCopyPad(groupBuffer.Get<int32_t>(), groupWords, DataCopyExtParams{1, t.e * 8, 0, 0, 0},
        DataCopyPadExtParams<int32_t>{true, 0, uint8_t((4 - t.e % 4) % 4 * 2), 0});
      SetFlag<HardEvent::MTE2_S>(EVENT_ID0);
      WaitFlag<HardEvent::MTE2_S>(EVENT_ID0);
    }
  }

  CrossCoreSetFlag<2, PIPE_MTE3>(2);
  if (t.n % BN) {
    Duplicate(s, 0.0f, BN);
    SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
    WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
  }
#endif
  uint32_t taskBase = 0, prev = 0, done = 0, nextTask = core, packedExpert = t.e;

  const uint32_t nt = BN == 64 ? 1 : (t.n + BN - 1) / BN;
#if defined(SPLIT_CORE_VEC)
  uint32_t firstExpert = useLocalGroups ? GmgFirstExpert(localGroups, t.e) : GmgFirstExpert(gg, t.e);
#else
  uint32_t firstExpert = GmgFirstExpert(gg, t.e);
#endif
  uint32_t stopTask = 0xffffffffU, runRemaining = 0;
  if constexpr (REUSE) {
    uint32_t total = 0, before = 0;
    for (uint32_t e = firstExpert; e < t.e; ++e) {
      uint32_t end =
#if defined(SPLIT_CORE_VEC)
        useLocalGroups ? localGroups.GetValue(e) : gg.GetValue(e);
#else
        gg.GetValue(e);
#endif
      total += (end - before + BM - 1) / BM * nt;
      before = end;
      if (end == t.m) break;
    }
    nextTask = total * core / t.blocks;
    stopTask = total * (core + 1) / t.blocks;
  }

  bool mergeTail = false;
  if constexpr (DIRECT && !PADDED && !REUSE && BM == 64 && BN == 512 && DIRECT_MAX_K == 2048) {
    const uint32_t tail = t.n % BN;
    mergeTail = NARROW_TAIL ? (tail > 0 && tail <= BN / 4) : (tail > BN / 4 && tail <= BN / 2);
  }

  const bool considerLongTail = mergeTail && (NARROW_TAIL || t.k > DIRECT_MAX_K / 2);
  const uint32_t phases = considerLongTail ? 3U : (BN > 256 && t.n % BN ? 2U : 1U);
  bool orderedTail = false, needShortTails = false;
  uint32_t oldTailCount = 0, mergedTailCount = 0;
  for (uint32_t columnPhase = 0; columnPhase < phases; ++columnPhase) {
    if (columnPhase == 1 && considerLongTail) { orderedTail = (taskBase + mergedTailCount - 1) / t.blocks < (taskBase + oldTailCount - 1) / t.blocks; }
    if (columnPhase == 2 && (!orderedTail || !needShortTails)) break;
    const uint32_t phaseNt = BN > 256 ? (columnPhase ? 1 : t.n / BN) : nt;
    const bool taller = columnPhase && mergeTail && (!considerLongTail || orderedTail);
    const uint32_t phaseBM = taller ? 2 * BM : BM;
    prev = 0;
    for (uint32_t e = firstExpert; e < t.e; ++e) {
      uint32_t end =
#if defined(SPLIT_CORE_VEC)
        useLocalGroups ? localGroups.GetValue(e) : gg.GetValue(e);
#else
        gg.GetValue(e);
#endif
      uint32_t len = end - prev, mt = taller ? ((len + 2 * BM - 1) / (2 * BM)) : ((len + BM - 1) / BM);
      uint32_t phaseRowBase = 0;
      if (!columnPhase && considerLongTail) {
        oldTailCount += mt;
        mergedTailCount += (len + 2 * BM - 1) / (2 * BM);
      }
      if (orderedTail && columnPhase) {
        const uint32_t complete = len / (2 * BM), residual = len % (2 * BM);
        const bool hasShort = residual && residual <= BM;
        if (columnPhase == 1) {
          mt = complete + uint32_t(residual > BM);
          needShortTails |= hasShort;
        } else {
          mt = uint32_t(hasShort);
          phaseRowBase = complete * (2 * BM);
        }
      }
      uint32_t tasks = mt * phaseNt;

      for (; nextTask < taskBase + tasks && nextTask < stopTask; nextTask += (REUSE ? 1 : t.blocks)) {
        uint32_t local = nextTask - taskBase;
        uint32_t mr = phaseRowBase + (BN == 64 ? local : (REUSE ? local % mt : local / phaseNt)) * phaseBM;
        uint32_t nc = BN == 64 ? 0 : (REUSE ? local / mt : local % phaseNt) * BN;
        if constexpr (BN > 256) {
          if (columnPhase) nc = (t.n / BN) * BN;
        }
        uint32_t rows = (len - mr < phaseBM ? len - mr : phaseBM), cols = (t.n - nc < BN ? t.n - nc : BN);

        bool reshape = false;
        if constexpr (RESHAPE_FULL) {
          const uint32_t rowTile = local / phaseNt;
          reshape = !columnPhase && ((rowTile ^ 1U) < mt);
          if (reshape) {
            mr = (rowTile & ~1U) * BM;
            nc += (rowTile & 1U) * (BN / 2);
            rows = (len - mr < 2 * BM ? len - mr : 2 * BM);
            cols = BN / 2;
          }
        }
        if constexpr (PADDED)
          if (packedExpert != e) {
            packer.Pack(e, 0, t.k);
            packedExpert = e;
          }
#if defined(SPLIT_CORE_CUBE)
        if constexpr (DOUBLE_C) {
          if (done >= 2) {
            if (done & 1)
              CrossCoreWaitFlag<2>(4);
            else
              CrossCoreWaitFlag<2>(1);
          }
        } else if (done)
          CrossCoreWaitFlag<2>(1);
        if constexpr (REUSE) {

          if (!runRemaining) {
            runRemaining = mt - local % mt;
            if (runRemaining > stopTask - nextTask) runRemaining = stopTask - nextTask;
            uint32_t runRows = runRemaining * BM;
            if (runRows > len - mr) runRows = len - mr;
            mm.SetSingleShape(runRows, cols, t.k);
            mm.SetTensorA(xg[(uint64_t)(prev + mr) * t.k]);
            mm.SetTensorB(wg[(uint64_t)e * t.k * t.n + nc]);
          }
          mm.Iterate();
          mm.GetTensorC(cg, 0, true);
          if (!--runRemaining) {
            mm.Iterate();
            mm.End();
          }
        } else {
          mm.SetSingleShape(rows, cols, t.k);
          mm.SetTensorA(xg[(uint64_t)(prev + mr) * t.k]);
          mm.SetTensorB(wg[PADDED ? 0 : (uint64_t)e * t.k * t.n + nc]);
          if constexpr (DOUBLE_C)
            mm.IterateAll(cg[(done & 1) * ELEMS], done == 0);
          else
            mm.IterateAll(cg, done == 0);
          mm.End();
        }
        if constexpr (DOUBLE_C) {
          if (done & 1)
            CrossCoreSetFlag<2, PIPE_FIX>(3);
          else
            CrossCoreSetFlag<2, PIPE_FIX>(0);
        } else
          CrossCoreSetFlag<2, PIPE_FIX>(0);
#endif
#if defined(SPLIT_CORE_VEC)
        if constexpr (DOUBLE_C) {
          const uint32_t cPitch = rows > BM && (taller || reshape) ? (NARROW_TAIL ? BN / 4 : BN / 2) : BN;
          uint32_t vectorRows = (rows + VR - 1) / VR;
          uint32_t rowOffset = GetSubBlockIdx() * vectorRows;
          rows = rows > rowOffset ? (rows - rowOffset < vectorRows ? rows - rowOffset : vectorRows) : 0;
          if (rows) DataCopyPad(s, sg[(uint64_t)e * t.n + nc], DataCopyExtParams{1, cols * 4, 0, 0, 0}, DataCopyPadExtParams<float>{true, 0, 0, 0});
          if (done & 1)
            CrossCoreWaitFlag<2>(3);
          else
            CrossCoreWaitFlag<2>(0);

          uint32_t vectorStride = BN > 256 ? (cols + 63) / 64 * 64 : BN;
          uint32_t chunkRows = BN > 256 ? 8192 / vectorStride : CHUNK_ROWS;
          uint32_t chunks = (rows + chunkRows - 1) / chunkRows;
          if (!chunks) chunks = 1;
          for (uint32_t chunk = 0; chunk < chunks; ++chunk) {
            uint32_t first = chunk * chunkRows;
            uint32_t currentRows = rows > first ? (rows - first < chunkRows ? rows - first : chunkRows) : 0;
            if (currentRows) {
              if (cols == BN)
                DataCopy(a, cg[(done & 1) * ELEMS + (rowOffset + first) * BN], currentRows * BN);
              else
                DataCopyPad(a, cg[(done & 1) * ELEMS + (rowOffset + first) * cPitch],
                  DataCopyExtParams{uint16_t(currentRows), cols * 4, (cPitch - cols) * 4, (vectorStride - ((cols + 7) / 8 * 8)) / 8, 0},
                  DataCopyPadExtParams<int32_t>{true, 0, 0, 0});
            }
            SetFlag<HardEvent::MTE2_S>(EVENT_ID0);
            WaitFlag<HardEvent::MTE2_S>(EVENT_ID0);

            if (chunk + 1 == chunks) {
              if (done & 1)
                CrossCoreSetFlag<2, PIPE_MTE2>(4);
              else
                CrossCoreSetFlag<2, PIPE_MTE2>(1);
            }
            if (currentRows) {
              SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
              WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
              uint32_t count = currentRows * vectorStride;
              Cast(z, a, RoundMode::CAST_RINT, count);
              for (uint32_t c = 0; c < vectorStride; c += 64)
                Mul(z[c], z[c], s[c], uint64_t(64), uint8_t(currentRows), BinaryRepeatParams{1, 1, 1, uint8_t(vectorStride / 8), uint8_t(vectorStride / 8), 0});
              if constexpr (USE_SMALL_GELU)
                GmgGeluSmall<true, true>(z, h, u, v, p, a, mask1, mask2, count);
              else
                GmgGelu<true>(z, h, u, v, p, a, mask1, mask2, count);
              SetFlag<HardEvent::S_MTE3>(EVENT_ID0);
              WaitFlag<HardEvent::S_MTE3>(EVENT_ID0);
              SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
              WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
              DataCopyPad(yg[uint64_t(prev + mr + rowOffset + first) * t.n + nc], h,
                DataCopyExtParams{uint16_t(currentRows), cols * 2, (vectorStride - ((cols + 15) / 16 * 16)) / 16, (t.n - cols) * 2, 0});
              SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
              WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
            }
          }
        } else {
          uint32_t vectorRows = (rows + VR - 1) / VR;
          uint32_t rowOffset = GetSubBlockIdx() * vectorRows;
          rows = rows > rowOffset ? (rows - rowOffset < vectorRows ? rows - rowOffset : vectorRows) : 0;
          mr += rowOffset;

          if (rows) DataCopyPad(s, sg[(uint64_t)e * t.n + nc], DataCopyExtParams{1, cols * 4, 0, 0, 0}, DataCopyPadExtParams<float>{true, 0, 0, 0});
          CrossCoreWaitFlag<2>(0);
          if (rows) {
            if (cols == BN)
              DataCopy(a, cg[(REUSE && GENERAL ? (done & 1) * ELEMS : 0) + rowOffset * BN], rows * BN);
            else
              DataCopyPad(a, cg[(REUSE && GENERAL ? (done & 1) * ELEMS : 0) + rowOffset * ((REUSE && !GENERAL) ? cols : BN)],
                DataCopyExtParams{(uint16_t)rows, cols * 4, ((REUSE && !GENERAL) ? 0 : (BN - cols) * 4), (BN - ((cols + 7) / 8 * 8)) / 8, 0},
                DataCopyPadExtParams<int32_t>{true, 0, 0, 0});
          }
          SetFlag<HardEvent::MTE2_S>(EVENT_ID0);
          WaitFlag<HardEvent::MTE2_S>(EVENT_ID0);
          CrossCoreSetFlag<2, PIPE_MTE2>(1);
          if (rows) {
            SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
            WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
            uint32_t count = rows * BN;
            Cast(z, a, RoundMode::CAST_RINT, count);

            for (uint32_t c = 0; c < BN; c += 64) Mul(z[c], z[c], s[c], uint64_t(64), uint8_t(rows), BinaryRepeatParams{1, 1, 1, BN / 8, BN / 8, 0});
            GmgGelu<DIRECT && BN == 256>(z, h, u, v, p, a, mask1, mask2, count);
            SetFlag<HardEvent::S_MTE3>(EVENT_ID0);
            WaitFlag<HardEvent::S_MTE3>(EVENT_ID0);
            SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
            WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
            DataCopyPad(
              yg[(uint64_t)(prev + mr) * t.n + nc], h, DataCopyExtParams{(uint16_t)rows, cols * 2, (BN - ((cols + 15) / 16 * 16)) / 16, (t.n - cols) * 2, 0});
            SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
            WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
          }
        }
#endif
        ++done;
      }
      taskBase += tasks;
      prev = end;

      if (end == t.m || (REUSE && GENERAL && nextTask >= stopTask)) break;
    }
  }
#if defined(SPLIT_CORE_CUBE)
  if constexpr (DOUBLE_C) {

    if (done > 1) CrossCoreWaitFlag<2>(4);
    if (done) CrossCoreWaitFlag<2>(1);
  } else if (done)
    CrossCoreWaitFlag<2>(1);
  if (!done) CrossCoreWaitFlag<2>(2);

#endif
}

template <bool WHOLE_COUNT = true, bool WORD_FLAGS = true>
__aicore__ inline void GmgFullTileTightQuotientAndFlags(LocalTensor<float> z, LocalTensor<half> h, LocalTensor<float> u, LocalTensor<float> v,
  LocalTensor<float> p, LocalTensor<int32_t> a, LocalTensor<uint8_t> mask1, LocalTensor<uint8_t> mask2, uint32_t count, bool wrotePrevious) {
  SetMaskCount();
  SetVectorMask<float, MaskMode::COUNTER>(count);
  Div<float, false>(p, z, u, MASK_PLACEHOLDER, 1, {1, 1, 1, 8, 8, 8});
  if (wrotePrevious) WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
  Cast<half, float, false>(h, p, RoundMode::CAST_RINT, MASK_PLACEHOLDER, 1, {1, 1, 4, 8});
  SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
  SetMaskNorm();
  ResetMask();
  SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
  SetFlag<HardEvent::V_S>(EVENT_ID0);
}

__aicore__ inline void GmgFullTileWrite109(LocalTensor<float> z, LocalTensor<half> h, LocalTensor<float> p, LocalTensor<uint8_t> mask1,
  LocalTensor<uint8_t> mask2, uint32_t count, GlobalTensor<half> dst, const DataCopyExtParams &copy) {
  WaitFlag<HardEvent::V_S>(EVENT_ID0);
  SetFlag<HardEvent::S_MTE3>(EVENT_ID0);
  WaitFlag<HardEvent::S_MTE3>(EVENT_ID0);
  WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
  DataCopyPad(dst, h, copy);
}

template <uint32_t BM, uint32_t BN, bool MDL = false, bool REUSE = false, bool DIRECT = false, bool PADDED = false, bool GENERAL = false, bool STREAM = false,
  uint32_t DIRECT_MAX_K = 2048, bool USE_SMALL_GELU = false, bool NARROW_TAIL = false, bool RESHAPE_FULL = false>
__aicore__ inline void GmgComputeWideEarlyReadEpilogue(GM_ADDR x, GM_ADDR w, GM_ADDR scale, GM_ADDR groups, GM_ADDR y, GM_ADDR workspace, const GmgTiling &t) {
  constexpr uint32_t ELEMS = BM * BN, VR = 2, CHUNK_ROWS = 8192 / BN, VELEMS = (BM > 2 * CHUNK_ROWS ? 2 * CHUNK_ROWS : BM) * BN / VR;
  constexpr bool DOUBLE_C = (BM == 128 || BN > 256);
  TPipe pipe;
  const uint32_t core = GetBlockIdx() / GetTaskRation();
  typename Conditional<PADDED, GmgWordWeightPacker, GmgNoWeightPacker>::type packer;
  if constexpr (PADDED) {
    auto padded = workspace + uint64_t(t.blocks) * t.bm * t.bn * 4 + uint64_t(core) * ((t.k + 511) / 512 * 512) * ((t.n + 31) / 32 * 32);
    packer.Init(w, padded, t, pipe);
    w = padded;
  }
  GlobalTensor<int8_t> xg, wg;
  GlobalTensor<int64_t> gg;
  GlobalTensor<float> sg;
  GlobalTensor<half> yg;
  GlobalTensor<int32_t> cg;
  xg.SetGlobalBuffer((__gm__ int8_t *)x);
  wg.SetGlobalBuffer((__gm__ int8_t *)w);
  gg.SetGlobalBuffer((__gm__ int64_t *)groups);
  sg.SetGlobalBuffer((__gm__ float *)scale);
  yg.SetGlobalBuffer((__gm__ half *)y);
  cg.SetGlobalBuffer((__gm__ int32_t *)workspace + core * ELEMS * ((DOUBLE_C || (REUSE && GENERAL)) ? 2 : 1));

#if defined(SPLIT_CORE_CUBE)
  if constexpr (!DIRECT && !STREAM) GmgPrepareL1(pipe, t);
  using CubeOp = typename Conditional<DIRECT, GmgStartupWideLongTailCube<false, BN, BM, DIRECT_MAX_K, 256, NARROW_TAIL, RESHAPE_FULL>, GmgDirectCube>::type;
  CubeOp mm;
  mm.Init(&t.cube, &pipe);
  mm.SetOrgShape(REUSE ? t.m : BM, PADDED ? (t.n + 31) / 32 * 32 : t.n, t.k, t.k, BN);
#endif

#if defined(SPLIT_CORE_VEC)
  TBuf<TPosition::VECCALC> ab, zb, ub, vb, pb, sb, hb, maskb1, maskb2, groupBuffer;
  pipe.InitBuffer(ab, (VELEMS * 4) + 256);
  pipe.InitBuffer(zb, (VELEMS * 4) + 256);
  pipe.InitBuffer(ub, (VELEMS * 4) + 256);
  pipe.InitBuffer(vb, (VELEMS * 4) + 256);
  pipe.InitBuffer(pb, (VELEMS * 4) + 256);
  pipe.InitBuffer(sb, (BN * 4) + 256);
  pipe.InitBuffer(hb, (VELEMS * 2) + 256);
  pipe.InitBuffer(maskb1, (VELEMS / 8) + 256);
  pipe.InitBuffer(maskb2, (VELEMS / 8) + 256);
  auto a = ab.Get<int32_t>();
  auto z = zb.Get<float>();
  auto u = ub.Get<float>();
  auto v = vb.Get<float>();
  auto p = pb.Get<float>();
  auto s = sb.Get<float>();
  auto h = hb.Get<half>();
  auto mask1 = maskb1.Get<uint8_t>();
  auto mask2 = maskb2.Get<uint8_t>();

  bool pending = false;
  uint32_t priorRows = 0, priorCols = 0, priorStride = 0;
  uint64_t priorOffset = 0;

  LocalTensor<int64_t> localGroups;
  bool useLocalGroups = false;
  if constexpr ((DIRECT && BN == 256 && !GENERAL) || (REUSE && GENERAL)) {
    pipe.InitBuffer(groupBuffer, 128 * 8);
    localGroups = groupBuffer.Get<int64_t>();
    useLocalGroups = t.e >= 16;
    if (useLocalGroups) {
      GlobalTensor<int32_t> groupWords;
      groupWords.SetGlobalBuffer((__gm__ int32_t *)groups);
      DataCopyPad(groupBuffer.Get<int32_t>(), groupWords, DataCopyExtParams{1, t.e * 8, 0, 0, 0},
        DataCopyPadExtParams<int32_t>{true, 0, uint8_t((4 - t.e % 4) % 4 * 2), 0});
      SetFlag<HardEvent::MTE2_S>(EVENT_ID0);
      WaitFlag<HardEvent::MTE2_S>(EVENT_ID0);
    }
  }

  // Define both banks before either actor consumes a C rectangle,
  // including padding that can be read for a ragged tile.
  Duplicate(a, int32_t(0), VELEMS);
  SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
  WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
  for (uint32_t bank = 0; bank < 2; ++bank)
    for (uint32_t offset = 0; offset < ELEMS / 2; offset += VELEMS) DataCopy(cg[bank * ELEMS + GetSubBlockIdx() * (ELEMS / 2) + offset], a, VELEMS);
  SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
  WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
  CrossCoreSetFlag<2, PIPE_MTE3>(2);
  if (t.n % BN) {
    Duplicate(s, 0.0f, BN);
    SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
    WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
  }
#endif
  uint32_t taskBase = 0, prev = 0, done = 0, nextTask = core, packedExpert = t.e;

  const uint32_t nt = BN == 64 ? 1 : (t.n + BN - 1) / BN;
#if defined(SPLIT_CORE_VEC)
  uint32_t firstExpert = useLocalGroups ? GmgFirstExpert(localGroups, t.e) : GmgFirstExpert(gg, t.e);
#else
  uint32_t firstExpert = GmgFirstExpert(gg, t.e);
#endif
  uint32_t stopTask = 0xffffffffU, runRemaining = 0;
  if constexpr (REUSE) {
    uint32_t total = 0, before = 0;
    for (uint32_t e = firstExpert; e < t.e; ++e) {
      uint32_t end =
#if defined(SPLIT_CORE_VEC)
        useLocalGroups ? localGroups.GetValue(e) : gg.GetValue(e);
#else
        gg.GetValue(e);
#endif
      total += (end - before + BM - 1) / BM * nt;
      before = end;
      if (end == t.m) break;
    }
    nextTask = total * core / t.blocks;
    stopTask = total * (core + 1) / t.blocks;
  }

  bool mergeTail = false;
  if constexpr (DIRECT && !PADDED && !REUSE && BM == 64 && BN == 512 && DIRECT_MAX_K == 2048) {
    const uint32_t tail = t.n % BN;
    mergeTail = NARROW_TAIL ? (tail > 0 && tail <= BN / 4) : (tail > BN / 4 && tail <= BN / 2);
  }

  const bool considerLongTail = mergeTail && (NARROW_TAIL || t.k > DIRECT_MAX_K / 2);
  const uint32_t phases = considerLongTail ? 3U : (BN > 256 && t.n % BN ? 2U : 1U);
  bool orderedTail = false, needShortTails = false;
  uint32_t oldTailCount = 0, mergedTailCount = 0;
  for (uint32_t columnPhase = 0; columnPhase < phases; ++columnPhase) {
    if (columnPhase == 1 && considerLongTail) { orderedTail = (taskBase + mergedTailCount - 1) / t.blocks < (taskBase + oldTailCount - 1) / t.blocks; }
    if (columnPhase == 2 && (!orderedTail || !needShortTails)) break;
    const uint32_t phaseNt = BN > 256 ? (columnPhase ? 1 : t.n / BN) : nt;
    const bool taller = columnPhase && mergeTail && (!considerLongTail || orderedTail);
    const uint32_t phaseBM = taller ? 2 * BM : BM;
    prev = 0;
#if defined(SPLIT_CORE_VEC)
    for (uint32_t e = firstExpert; e < t.e || (e == t.e && pending); ++e) {
      const bool flush = (e == t.e);
#else
    for (uint32_t e = firstExpert; e < t.e; ++e) {
#endif
      uint32_t end =
#if defined(SPLIT_CORE_VEC)
        flush ? prev : (useLocalGroups ? localGroups.GetValue(e) : gg.GetValue(e));
#else
        gg.GetValue(e);
#endif
      uint32_t len = end - prev, mt = taller ? ((len + 2 * BM - 1) / (2 * BM)) : ((len + BM - 1) / BM);
      uint32_t phaseRowBase = 0;
      if (!columnPhase && considerLongTail) {
        oldTailCount += mt;
        mergedTailCount += (len + 2 * BM - 1) / (2 * BM);
      }
      if (orderedTail && columnPhase) {
        const uint32_t complete = len / (2 * BM), residual = len % (2 * BM);
        const bool hasShort = residual && residual <= BM;
        if (columnPhase == 1) {
          mt = complete + uint32_t(residual > BM);
          needShortTails |= hasShort;
        } else {
          mt = uint32_t(hasShort);
          phaseRowBase = complete * (2 * BM);
        }
      }
      uint32_t tasks = mt * phaseNt;

      for (;
#if defined(SPLIT_CORE_VEC)
        (flush && pending) ||
#endif
        (nextTask < taskBase + tasks && nextTask < stopTask);
        nextTask += (REUSE ? 1 : t.blocks)) {
        uint32_t local =
#if defined(SPLIT_CORE_VEC)
          flush ? 0 :
#endif
                nextTask - taskBase;
        uint32_t mr = phaseRowBase + (BN == 64 ? local : (REUSE ? local % mt : local / phaseNt)) * phaseBM;
        uint32_t nc = BN == 64 ? 0 : (REUSE ? local / mt : local % phaseNt) * BN;
        if constexpr (BN > 256) {
          if (columnPhase) nc = (t.n / BN) * BN;
        }
        uint32_t rows = (len - mr < phaseBM ? len - mr : phaseBM), cols = (t.n - nc < BN ? t.n - nc : BN);

        bool reshape = false;
        if constexpr (RESHAPE_FULL) {
          const uint32_t rowTile = local / phaseNt;
          reshape = !columnPhase && ((rowTile ^ 1U) < mt);
          if (reshape) {
            mr = (rowTile & ~1U) * BM;
            nc += (rowTile & 1U) * (BN / 2);
            rows = (len - mr < 2 * BM ? len - mr : 2 * BM);
            cols = BN / 2;
          }
        }
        if constexpr (PADDED)
          if (packedExpert != e) {
            packer.Pack(e, 0, t.k);
            packedExpert = e;
          }
#if defined(SPLIT_CORE_CUBE)
        if constexpr (DOUBLE_C) {
          if (done >= 2) {
            if (done & 1)
              CrossCoreWaitFlag<2>(4);
            else
              CrossCoreWaitFlag<2>(1);
          }
        } else if (done)
          CrossCoreWaitFlag<2>(1);
        if constexpr (REUSE) {

          if (!runRemaining) {
            runRemaining = mt - local % mt;
            if (runRemaining > stopTask - nextTask) runRemaining = stopTask - nextTask;
            uint32_t runRows = runRemaining * BM;
            if (runRows > len - mr) runRows = len - mr;
            mm.SetSingleShape(runRows, cols, t.k);
            mm.SetTensorA(xg[(uint64_t)(prev + mr) * t.k]);
            mm.SetTensorB(wg[(uint64_t)e * t.k * t.n + nc]);
          }
          mm.Iterate();
          mm.GetTensorC(cg, 0, true);
          if (!--runRemaining) {
            mm.Iterate();
            mm.End();
          }
        } else {
          mm.SetSingleShape(rows, cols, t.k);
          mm.SetTensorA(xg[(uint64_t)(prev + mr) * t.k]);
          mm.SetTensorB(wg[PADDED ? 0 : (uint64_t)e * t.k * t.n + nc]);
          if constexpr (DOUBLE_C)
            mm.IterateAll(cg[(done & 1) * ELEMS], done == 0);
          else
            mm.IterateAll(cg, done == 0);
          mm.End();
        }
        if constexpr (DOUBLE_C) {
          if (done & 1)
            CrossCoreSetFlag<2, PIPE_FIX>(3);
          else
            CrossCoreSetFlag<2, PIPE_FIX>(0);
        } else
          CrossCoreSetFlag<2, PIPE_FIX>(0);
#endif
#if defined(SPLIT_CORE_VEC)
        if constexpr (DOUBLE_C) {
          const uint32_t cPitch = rows > BM && (taller || reshape) ? (NARROW_TAIL ? BN / 4 : BN / 2) : BN;
          uint32_t vectorRows = (rows + VR - 1) / VR;
          uint32_t rowOffset = GetSubBlockIdx() * vectorRows;
          rows = rows > rowOffset ? (rows - rowOffset < vectorRows ? rows - rowOffset : vectorRows) : 0;
          if (rows) {
            if (pending) WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
            DataCopyPad(s, sg[(uint64_t)e * t.n + nc], DataCopyExtParams{1, cols * 4, 0, 0, 0}, DataCopyPadExtParams<float>{true, 0, 0, 0});
          }
          const uint32_t vectorStride = (cols + 63) / 64 * 64;
          const uint32_t chunkRows = 8192 / vectorStride;
          uint32_t chunks = (rows + chunkRows - 1) / chunkRows;
          if (!chunks) chunks = 1;
          for (uint32_t chunk = 0; chunk < chunks; ++chunk) {
            const uint32_t first = chunk * chunkRows;
            const uint32_t currentRows = rows > first ? (rows - first < chunkRows ? rows - first : chunkRows) : 0;

            const bool earlyRead = !flush && chunk && currentRows;
            if (earlyRead) {
              WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
              if (cols == BN)
                DataCopy(a, cg[(done & 1) * ELEMS + (rowOffset + first) * BN], currentRows * BN);
              else
                DataCopyPad(a, cg[(done & 1) * ELEMS + (rowOffset + first) * cPitch],
                  DataCopyExtParams{uint16_t(currentRows), cols * 4, (cPitch - cols) * 4, (vectorStride - ((cols + 7) / 8 * 8)) / 8, 0},
                  DataCopyPadExtParams<int32_t>{true, 0, 0, 0});
              if (done & 1)
                CrossCoreSetFlag<2, PIPE_MTE2>(4);
              else
                CrossCoreSetFlag<2, PIPE_MTE2>(1);
            }

            if (pending && (currentRows || flush)) {
              if (flush || (chunk && !earlyRead)) WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
              GmgFullTileWrite109(z, h, p, mask1, mask2, priorRows * priorStride, yg[priorOffset],
                DataCopyExtParams{uint16_t(priorRows), priorCols * 2, (priorStride - ((priorCols + 15) / 16 * 16)) / 16, (t.n - priorCols) * 2, 0});
              if (flush) {
                SetFlag<HardEvent::MTE3_S>(EVENT_ID0);
                WaitFlag<HardEvent::MTE3_S>(EVENT_ID0);
                pending = false;
              } else {
                SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
                SetFlag<HardEvent::S_V>(EVENT_ID0);
                WaitFlag<HardEvent::S_V>(EVENT_ID0);
              }
            }

            if (!flush && !chunk) {
              if (done & 1)
                CrossCoreWaitFlag<2>(3);
              else
                CrossCoreWaitFlag<2>(0);
            }
            if (currentRows && !earlyRead) {
              if (cols == BN)
                DataCopy(a, cg[(done & 1) * ELEMS + (rowOffset + first) * BN], currentRows * BN);
              else
                DataCopyPad(a, cg[(done & 1) * ELEMS + (rowOffset + first) * cPitch],
                  DataCopyExtParams{uint16_t(currentRows), cols * 4, (cPitch - cols) * 4, (vectorStride - ((cols + 7) / 8 * 8)) / 8, 0},
                  DataCopyPadExtParams<int32_t>{true, 0, 0, 0});
            }
            if (!flush && !earlyRead) {
              SetFlag<HardEvent::MTE2_S>(EVENT_ID0);
              WaitFlag<HardEvent::MTE2_S>(EVENT_ID0);
              if (chunk + 1 == chunks) {
                if (done & 1)
                  CrossCoreSetFlag<2, PIPE_MTE2>(4);
                else
                  CrossCoreSetFlag<2, PIPE_MTE2>(1);
              }
            }
            if (currentRows) {
              SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
              WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
              const uint32_t count = currentRows * vectorStride;
              Cast(z, a, RoundMode::CAST_RINT, count);
              for (uint32_t c = 0; c < vectorStride; c += 64)
                Mul(z[c], z[c], s[c], uint64_t(64), uint8_t(currentRows), BinaryRepeatParams{1, 1, 1, uint8_t(vectorStride / 8), uint8_t(vectorStride / 8), 0});
              GmgTileDenom(z, u, count);
              GmgFullTileTightQuotientAndFlags(z, h, u, v, p, a, mask1, mask2, count, pending);
              priorRows = currentRows;
              priorCols = cols;
              priorStride = vectorStride;
              priorOffset = uint64_t(prev + mr + rowOffset + first) * t.n + nc;
              pending = true;
            }
          }
        } else {
          uint32_t vectorRows = (rows + VR - 1) / VR;
          uint32_t rowOffset = GetSubBlockIdx() * vectorRows;
          rows = rows > rowOffset ? (rows - rowOffset < vectorRows ? rows - rowOffset : vectorRows) : 0;
          mr += rowOffset;

          if (rows) DataCopyPad(s, sg[(uint64_t)e * t.n + nc], DataCopyExtParams{1, cols * 4, 0, 0, 0}, DataCopyPadExtParams<float>{true, 0, 0, 0});
          CrossCoreWaitFlag<2>(0);
          if (rows) {
            if (cols == BN)
              DataCopy(a, cg[(REUSE && GENERAL ? (done & 1) * ELEMS : 0) + rowOffset * BN], rows * BN);
            else
              DataCopyPad(a, cg[(REUSE && GENERAL ? (done & 1) * ELEMS : 0) + rowOffset * ((REUSE && !GENERAL) ? cols : BN)],
                DataCopyExtParams{(uint16_t)rows, cols * 4, ((REUSE && !GENERAL) ? 0 : (BN - cols) * 4), (BN - ((cols + 7) / 8 * 8)) / 8, 0},
                DataCopyPadExtParams<int32_t>{true, 0, 0, 0});
          }
          SetFlag<HardEvent::MTE2_S>(EVENT_ID0);
          WaitFlag<HardEvent::MTE2_S>(EVENT_ID0);
          CrossCoreSetFlag<2, PIPE_MTE2>(1);
          if (rows) {
            SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
            WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
            uint32_t count = rows * BN;
            Cast(z, a, RoundMode::CAST_RINT, count);

            for (uint32_t c = 0; c < BN; c += 64) Mul(z[c], z[c], s[c], uint64_t(64), uint8_t(rows), BinaryRepeatParams{1, 1, 1, BN / 8, BN / 8, 0});
            GmgGelu<DIRECT && BN == 256>(z, h, u, v, p, a, mask1, mask2, count);
            SetFlag<HardEvent::S_MTE3>(EVENT_ID0);
            WaitFlag<HardEvent::S_MTE3>(EVENT_ID0);
            SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
            WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
            DataCopyPad(
              yg[(uint64_t)(prev + mr) * t.n + nc], h, DataCopyExtParams{(uint16_t)rows, cols * 2, (BN - ((cols + 15) / 16 * 16)) / 16, (t.n - cols) * 2, 0});
            SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
            WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
          }
        }
#endif
#if defined(SPLIT_CORE_VEC)
        if (!flush) ++done;
#else
        ++done;
#endif
      }
      taskBase += tasks;
      prev = end;

      if (end == t.m || (REUSE && GENERAL && nextTask >= stopTask)) {
#if defined(SPLIT_CORE_VEC)
        if (!flush && pending) {
          e = t.e - 1;
          continue;
        }
#endif
        break;
      }
    }
  }
#if defined(SPLIT_CORE_CUBE)
  if constexpr (DOUBLE_C) {

    if (done > 1) CrossCoreWaitFlag<2>(4);
    if (done) CrossCoreWaitFlag<2>(1);
  } else if (done)
    CrossCoreWaitFlag<2>(1);
  if (!done) CrossCoreWaitFlag<2>(2);
#endif
}

#if !defined(GMG_SEPARATE_BUILD) || defined(GMG_BUILD_LATE_START)
extern "C" __global__ __mix__(1, 2) void groupmatmulgelu_start_panel_longtail(
  GM_ADDR x, GM_ADDR w, GM_ADDR scale, GM_ADDR groups, GM_ADDR y, GM_ADDR workspace, GmgTiling t) {
  GmgComputeWideLongTail<64, 512, false, false, true, false, true, false, 2048, true>(x, w, scale, groups, y, workspace, t);
}
#endif

#if !defined(GMG_SEPARATE_BUILD) || defined(GMG_BUILD_LATE_START)
extern "C" __global__ __mix__(1, 2) void groupmatmulgelu_start_panel_narrowtail(
  GM_ADDR x, GM_ADDR w, GM_ADDR scale, GM_ADDR groups, GM_ADDR y, GM_ADDR workspace, GmgTiling t) {
  GmgComputeWideLongTail<64, 512, false, false, true, false, true, false, 2048, true, true>(x, w, scale, groups, y, workspace, t);
}
#endif

#if !defined(GMG_SEPARATE_BUILD) || defined(GMG_BUILD_LATE_START)
extern "C" __global__ __mix__(1, 2) void groupmatmulgelu_start_panel_reshape(
  GM_ADDR x, GM_ADDR w, GM_ADDR scale, GM_ADDR groups, GM_ADDR y, GM_ADDR workspace, GmgTiling t) {
  GmgComputeWideEarlyReadEpilogue<64, 512, false, false, true, false, true, false, 2048, true, false, true>(x, w, scale, groups, y, workspace, t);
}
#endif

#if !defined(GMG_SEPARATE_BUILD) || defined(GMG_BUILD_THIN_VEC)
extern "C" __global__ __vector__ void groupmatmulgelu_thin_vec742(GM_ADDR x, GM_ADDR w, GM_ADDR scale, GM_ADDR groups, GM_ADDR y, GM_ADDR, GmgTiling t) {
#if defined(SPLIT_CORE_VEC) || defined(__DAV_C220_VEC__)
  constexpr uint32_t Width = 128, MaxK = 4;
  TPipe pipe;
  TBuf<TPosition::VECCALC> xb, xhb, xib, xrb, wb, whb, ab, sb, zb, ub, vb, pb, hb, mb1, mb2;
  pipe.InitBuffer(xb, 32);
  pipe.InitBuffer(xhb, 64);
  pipe.InitBuffer(xib, 128);
  pipe.InitBuffer(xrb, 256);
  pipe.InitBuffer(wb, MaxK * Width);
  pipe.InitBuffer(whb, MaxK * Width * 2);
  pipe.InitBuffer(ab, MaxK * Width * 4);
  pipe.InitBuffer(sb, Width * 4);
  pipe.InitBuffer(zb, Width * 4);
  pipe.InitBuffer(ub, Width * 4);
  pipe.InitBuffer(vb, Width * 4);
  pipe.InitBuffer(pb, Width * 4);
  pipe.InitBuffer(hb, Width * 2);
  pipe.InitBuffer(mb1, 32);
  pipe.InitBuffer(mb2, 32);

  auto xr = xb.Get<int8_t>();
  auto xh = xhb.Get<half>();
  auto xi = xib.Get<int32_t>();
  auto replicated = xrb.Get<int32_t>();
  auto wr = wb.Get<int8_t>();
  auto wh = whb.Get<half>();
  auto dot = ab.Get<int32_t>();
  auto factors = sb.Get<float>();
  auto z = zb.Get<float>();
  auto u = ub.Get<float>();
  auto v = vb.Get<float>();
  auto p = pb.Get<float>();
  auto h = hb.Get<half>();
  auto mask1 = mb1.Get<uint8_t>();
  auto mask2 = mb2.Get<uint8_t>();
  GlobalTensor<int8_t> gx, gw;
  GlobalTensor<int64_t> gg;
  GlobalTensor<float> gs;
  GlobalTensor<half> gy;
  gx.SetGlobalBuffer((__gm__ int8_t *)x);
  gw.SetGlobalBuffer((__gm__ int8_t *)w);
  gg.SetGlobalBuffer((__gm__ int64_t *)groups);
  gs.SetGlobalBuffer((__gm__ float *)scale);
  gy.SetGlobalBuffer((__gm__ half *)y);

  const uint32_t panels = (t.n + Width - 1) / Width;
  const uint32_t jobs = t.m * panels;
  for (uint32_t job = GetBlockIdx(); job < jobs; job += t.blocks) {
    const uint32_t row = job / panels;
    const uint32_t col = (job % panels) * Width;
    const uint32_t cols = t.n - col < Width ? t.n - col : Width;
    const uint32_t pitch = (cols + 63) / 64 * 64;
    const uint32_t weightBytes = t.k * pitch;
    const uint32_t expert = GmgFindExpert(gg, row, t.e);
    if (cols != Width) {
      Duplicate(wr.ReinterpretCast<int32_t>(), int32_t(0), weightBytes / 4);
      Duplicate(factors, 0.0f, pitch);
    }
    // Retire Vector accesses before reusing the three input buffers.
    SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
    WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
    DataCopyPad(xr, gx[uint64_t(row) * t.k], DataCopyExtParams{1, t.k, 0, 0, 0}, DataCopyPadExtParams<int8_t>{true, 0, uint8_t(32 - t.k), 0});
    const uint32_t alignedCols = (cols + 31) / 32 * 32;
    DataCopyPad(wr, gw[uint64_t(expert) * t.k * t.n + col], DataCopyExtParams{uint16_t(t.k), cols, t.n - cols, (pitch - alignedCols) / 32, 0},
      DataCopyPadExtParams<int8_t>{true, 0, uint8_t(alignedCols - cols), 0});
    DataCopyPad(
      factors, gs[uint64_t(expert) * t.n + col], DataCopyExtParams{1, cols * 4, 0, 0, 0}, DataCopyPadExtParams<float>{true, 0, uint8_t((8 - cols % 8) % 8), 0});
    SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
    WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);

    Cast(xh, xr, RoundMode::CAST_NONE, 32);
    Cast(xi, xh, RoundMode::CAST_RINT, 32);
    Brcb(replicated, xi, 1, {1, 8});
    Cast(wh, wr, RoundMode::CAST_NONE, weightBytes);
    Cast(dot, wh, RoundMode::CAST_RINT, weightBytes);
    for (uint32_t c = 0; c < pitch; c += 64)
      Mul(dot[c], dot[c], replicated, uint64_t(64), uint8_t(t.k), BinaryRepeatParams{1, 1, 0, uint8_t(pitch / 8), uint8_t(pitch / 8), 1});
    for (uint32_t term = 1; term < t.k; ++term) Add(dot, dot, dot[term * pitch], pitch);

    Cast(z, dot, RoundMode::CAST_RINT, pitch);
    Mul(z, z, factors, pitch);
    GmgGelu<true>(z, h, u, v, p, dot, mask1, mask2, pitch);
    SetFlag<HardEvent::S_MTE3>(EVENT_ID0);
    WaitFlag<HardEvent::S_MTE3>(EVENT_ID0);
    SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
    WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
    DataCopyPad(gy[uint64_t(row) * t.n + col], h, DataCopyExtParams{1, cols * 2, 0, 0, 0});
    SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
    WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
  }
#endif
}
#endif

template <uint32_t BM, uint32_t BN, bool MDL = false, bool REUSE = false, bool DIRECT = false, bool PADDED = false, bool GENERAL = false, bool STREAM = false,
  uint32_t DIRECT_MAX_K = 2048, bool FORCE_DOUBLE = false>
__aicore__ inline void GmgComputeFirstUseNz(GM_ADDR x, GM_ADDR w, GM_ADDR scale, GM_ADDR groups, GM_ADDR y, GM_ADDR workspace, const GmgTiling &t) {
  static_assert(BM == 128 && BN == 256 && STREAM && !PADDED && !DIRECT && !GENERAL && !REUSE);
  // Retain at least one wave of owner work while amortizing private
  // weight conversion across more M panels when the output is tall.
  uint32_t OWNER_ROWS = 512;
  const uint64_t ownerBudget = uint64_t(t.m) * ((t.n + BN - 1) / BN) / t.blocks;
  while (uint64_t(OWNER_ROWS) * 2 <= ownerBudget && OWNER_ROWS < 65536) OWNER_ROWS *= 2;
  constexpr uint32_t ELEMS = BM * BN, VR = 2, VELEMS = (BM > 64 ? 64 : BM) * BN / VR;
  constexpr bool DOUBLE_C = (BM == 128 || FORCE_DOUBLE);
  static_assert(
    !FORCE_DOUBLE || (BM == 64 && BN == 256 && DIRECT && !GENERAL && !REUSE && !PADDED && !STREAM), "extra C bank is restricted to direct M64/N256");
  TPipe pipe;
  const uint32_t core = GetBlockIdx() / GetTaskRation();
  typename Conditional<PADDED, GmgWordWeightPacker, GmgNoWeightPacker>::type packer;
  if constexpr (PADDED) {
    auto padded = workspace + uint64_t(t.blocks) * t.bm * t.bn * 4 + uint64_t(core) * ((t.k + 511) / 512 * 512) * ((t.n + 31) / 32 * 32);
    packer.Init(w, padded, t, pipe);
    w = padded;
  }
  GM_ADDR privateWeight = workspace + uint64_t(t.blocks) * ELEMS * 2 * 4 + uint64_t(core) * ((t.k + 511) / 512 * 512) * BN;
  GlobalTensor<int8_t> xg, wg, rawWeight;
  GlobalTensor<int64_t> gg;
  GlobalTensor<float> sg;
  GlobalTensor<half> yg;
  GlobalTensor<int32_t> cg;
  xg.SetGlobalBuffer((__gm__ int8_t *)x);
  wg.SetGlobalBuffer((__gm__ int8_t *)privateWeight);
  rawWeight.SetGlobalBuffer((__gm__ int8_t *)w);
  gg.SetGlobalBuffer((__gm__ int64_t *)groups);
  sg.SetGlobalBuffer((__gm__ float *)scale);
  yg.SetGlobalBuffer((__gm__ half *)y);
  cg.SetGlobalBuffer((__gm__ int32_t *)workspace + core * ELEMS * ((DOUBLE_C || (REUSE && GENERAL)) ? 2 : 1));

#if defined(SPLIT_CORE_CUBE)
  if constexpr (!DIRECT && !STREAM) GmgPrepareL1(pipe, t);
  using StandardCube = typename Conditional<DIRECT,
    typename Conditional<(BN <= 128), GmgNarrowCube<PADDED, BN>,
      typename Conditional<GENERAL, GmgNarrowCube<false, 256, BM, DIRECT_MAX_K>, GmgDirectCube>::type>::type,
    Matmul<MatmulType<TPosition::GM, CubeFormat::ND, int8_t>, MatmulType<TPosition::GM, CubeFormat::ND, int8_t>,
      MatmulType<TPosition::GM, CubeFormat::ND, int32_t>, MatmulType<TPosition::GM, CubeFormat::ND, int32_t>, GMG_MATMUL_CONFIG<MDL>>>::type;
  using CubeOp = typename Conditional<STREAM, GmgFirstUseCube<BN, BM>,
    typename Conditional<(BM == 128 && !GENERAL), GmgTallCube, typename Conditional<REUSE && GENERAL, GmgPaddedReuseCube, StandardCube>::type>::type>::type;
  CubeOp mm;
  mm.Init(&t.cube, &pipe);
  mm.SetOrgShape(BM, BN, t.k, t.k, BN);
  CrossCoreWaitFlag<2>(2);
#endif

#if defined(SPLIT_CORE_VEC)
  TBuf<TPosition::VECCALC> ab, zb, ub, vb, pb, sb, hb, maskb1, maskb2, groupBuffer;
  pipe.InitBuffer(ab, (VELEMS * 4) + 256);
  pipe.InitBuffer(zb, (VELEMS * 4) + 256);
  pipe.InitBuffer(ub, (VELEMS * 4) + 256);
  pipe.InitBuffer(vb, (VELEMS * 4) + 256);
  pipe.InitBuffer(pb, (VELEMS * 4) + 256);
  pipe.InitBuffer(sb, (BN * 4) + 256);
  pipe.InitBuffer(hb, (VELEMS * 2) + 256);
  pipe.InitBuffer(maskb1, (VELEMS / 8) + 256);
  pipe.InitBuffer(maskb2, (VELEMS / 8) + 256);
  auto a = ab.Get<int32_t>();
  auto z = zb.Get<float>();
  auto u = ub.Get<float>();
  auto v = vb.Get<float>();
  auto p = pb.Get<float>();
  auto s = sb.Get<float>();
  auto h = hb.Get<half>();
  auto mask1 = maskb1.Get<uint8_t>();
  auto mask2 = maskb2.Get<uint8_t>();

  LocalTensor<int64_t> localGroups;
  bool useLocalGroups = false;
  if constexpr ((DIRECT && BN == 256 && !GENERAL) || (REUSE && GENERAL)) {
    pipe.InitBuffer(groupBuffer, 128 * 8);
    localGroups = groupBuffer.Get<int64_t>();
    useLocalGroups = t.e >= 16;
    if (useLocalGroups) {
      GlobalTensor<int32_t> groupWords;
      groupWords.SetGlobalBuffer((__gm__ int32_t *)groups);
      DataCopyPad(groupBuffer.Get<int32_t>(), groupWords, DataCopyExtParams{1, t.e * 8, 0, 0, 0},
        DataCopyPadExtParams<int32_t>{true, 0, uint8_t((4 - t.e % 4) % 4 * 2), 0});
      SetFlag<HardEvent::MTE2_S>(EVENT_ID0);
      WaitFlag<HardEvent::MTE2_S>(EVENT_ID0);
    }
  }

  // Initialize both C banks in the exact per-actor row intervals used by
  // the epilogue, including the row/column padding consumed by DMA.
  Duplicate(a, int32_t(0), VELEMS);
  SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
  WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
  for (uint32_t bank = 0; bank < 2; ++bank)
    for (uint32_t row = 0; row < 64; row += 32) DataCopy(cg[bank * ELEMS + (GetSubBlockIdx() * 64 + row) * BN], a, 32 * BN);
  SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
  WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
  CrossCoreSetFlag<2, PIPE_MTE3>(2);
  if (t.n % BN) {
    Duplicate(s, 0.0f, BN);
    SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
    WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
  }
#endif
  uint32_t taskBase = 0, prev = 0, done = 0, nextTask = core, packedExpert = t.e;

  const uint32_t nt = BN == 64 ? 1 : (t.n + BN - 1) / BN;
  const bool streamPack = PADDED && t.k > 512;
#if defined(SPLIT_CORE_VEC)
  uint32_t firstExpert = useLocalGroups ? GmgFirstExpert(localGroups, t.e) : GmgFirstExpert(gg, t.e);
#else
  uint32_t firstExpert = GmgFirstExpert(gg, t.e);
#endif
  uint32_t stopTask = 0xffffffffU, runRemaining = 0;
  if constexpr (REUSE) {
    uint32_t total = 0, before = 0;
    for (uint32_t e = firstExpert; e < t.e; ++e) {
      uint32_t end =
#if defined(SPLIT_CORE_VEC)
        useLocalGroups ? localGroups.GetValue(e) : gg.GetValue(e);
#else
        gg.GetValue(e);
#endif
      total += (end - before + BM - 1) / BM * nt;
      before = end;
      if (end == t.m) break;
    }
    nextTask = total * core / t.blocks;
    stopTask = total * (core + 1) / t.blocks;
  }
  for (uint32_t e = firstExpert; e < t.e; ++e) {
    uint32_t end =
#if defined(SPLIT_CORE_VEC)
      useLocalGroups ? localGroups.GetValue(e) : gg.GetValue(e);
#else
      gg.GetValue(e);
#endif
    uint32_t len = end - prev, mt = (len + OWNER_ROWS - 1) / OWNER_ROWS;
    uint32_t tasks = mt * nt;

    for (; nextTask < taskBase + tasks && nextTask < stopTask; nextTask += (REUSE ? 1 : t.blocks)) {
      uint32_t local = nextTask - taskBase;
      const uint32_t ownerFirst = (local / nt) * OWNER_ROWS;
      const uint32_t ownerEnd = len - ownerFirst < OWNER_ROWS ? len : ownerFirst + OWNER_ROWS;
      const uint32_t nc = (local % nt) * BN;
      const uint32_t cols = t.n - nc < BN ? t.n - nc : BN;
      const bool usePacked = ownerEnd - ownerFirst > BM;
#if defined(SPLIT_CORE_VEC)
      CrossCoreSetFlag<2, PIPE_MTE3>(6);
#endif
#if defined(SPLIT_CORE_CUBE)
      CrossCoreWaitFlag<2>(6);
#endif
      done = 0;
      for (uint32_t ownerRow = ownerFirst; ownerRow < ownerEnd; ownerRow += BM) {
        uint32_t mr = ownerRow;
        uint32_t rows = ownerEnd - mr < BM ? ownerEnd - mr : BM;
        constexpr bool newPack = false;
#if defined(SPLIT_CORE_CUBE)
        if constexpr (DOUBLE_C) {
          if (done >= 2) {
            if (done & 1)
              CrossCoreWaitFlag<2>(4);
            else
              CrossCoreWaitFlag<2>(1);
          }
        } else if (done)
          CrossCoreWaitFlag<2>(1);
        if constexpr (REUSE) {

          if (!runRemaining) {
            runRemaining = mt - local % mt;
            if (runRemaining > stopTask - nextTask) runRemaining = stopTask - nextTask;
            uint32_t runRows = runRemaining * BM;
            if (runRows > len - mr) runRows = len - mr;
            mm.SetSingleShape(runRows, cols, t.k);
            mm.SetTensorA(xg[(uint64_t)(prev + mr) * t.k]);
            mm.SetTensorB(wg[(uint64_t)e * t.k * t.n + nc]);
          }
          mm.Iterate();
          mm.GetTensorC(cg, 0, true);
          if (!--runRemaining) {
            mm.Iterate();
            mm.End();
          }
        } else {
          mm.SetSingleShape(rows, cols, t.k);
          mm.SetTensorA(xg[(uint64_t)(prev + mr) * t.k]);
          const bool reuseStage = usePacked && ownerRow != ownerFirst;
          mm.SetWeightStage(wg, reuseStage, usePacked && !reuseStage);
          mm.SetOrgShape(BM, reuseStage ? BN : t.n, t.k, t.k, BN);
          if (reuseStage)
            mm.SetTensorB(wg);
          else
            mm.SetTensorB(rawWeight[(uint64_t(e) * t.k) * t.n + nc]);
          if constexpr (DOUBLE_C)
            mm.IterateAll(cg[(done & 1) * ELEMS]);
          else if constexpr (PADDED)
            mm.template IterateAll<true>(cg, streamPack && newPack);
          else
            mm.IterateAll(cg);
          mm.End();
        }
        if constexpr (DOUBLE_C) {
          if (done & 1)
            CrossCoreSetFlag<2, PIPE_FIX>(3);
          else
            CrossCoreSetFlag<2, PIPE_FIX>(0);
        } else
          CrossCoreSetFlag<2, PIPE_FIX>(0);
#endif
#if defined(SPLIT_CORE_VEC)
        if constexpr (DOUBLE_C) {
          uint32_t vectorRows = (rows + VR - 1) / VR;
          uint32_t rowOffset = GetSubBlockIdx() * vectorRows;
          rows = rows > rowOffset ? (rows - rowOffset < vectorRows ? rows - rowOffset : vectorRows) : 0;
          if (rows) DataCopyPad(s, sg[(uint64_t)e * t.n + nc], DataCopyExtParams{1, cols * 4, 0, 0, 0}, DataCopyPadExtParams<float>{true, 0, 0, 0});
          if (done & 1)
            CrossCoreWaitFlag<2>(3);
          else
            CrossCoreWaitFlag<2>(0);
          uint32_t chunks = (rows + 31) / 32;
          if (!chunks) chunks = 1;
          const uint32_t cw = cols == BN ? BN : (cols + 63) / 64 * 64;
          for (uint32_t chunk = 0; chunk < chunks; ++chunk) {
            uint32_t first = chunk * 32;
            uint32_t currentRows = rows > first ? (rows - first < 32 ? rows - first : 32) : 0;
            if (currentRows) {
              if (cols == BN)
                DataCopy(a, cg[(done & 1) * ELEMS + (rowOffset + first) * BN], currentRows * BN);
              else
                DataCopyPad(a, cg[(done & 1) * ELEMS + (rowOffset + first) * BN],
                  DataCopyExtParams{uint16_t(currentRows), cols * 4, (BN - cols) * 4, (cw - ((cols + 7) / 8 * 8)) / 8, 0},
                  DataCopyPadExtParams<int32_t>{true, 0, 0, 0});
            }
            SetFlag<HardEvent::MTE2_S>(EVENT_ID0);
            WaitFlag<HardEvent::MTE2_S>(EVENT_ID0);

            if (chunk + 1 == chunks) {
              if (done & 1)
                CrossCoreSetFlag<2, PIPE_MTE2>(4);
              else
                CrossCoreSetFlag<2, PIPE_MTE2>(1);
            }
            if (currentRows) {
              SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
              WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
              uint32_t count = currentRows * cw;
              Cast(z, a, RoundMode::CAST_RINT, count);
              for (uint32_t c = 0; c < cw; c += 64) Mul(z[c], z[c], s[c], uint64_t(64), uint8_t(currentRows), BinaryRepeatParams{1, 1, 1, cw / 8, cw / 8, 0});
              if constexpr (REUSE || (BM == 128 && !STREAM))
                GmgGeluSmall<true>(z, h, u, v, p, a, mask1, mask2, count);
              else
                GmgGelu<true>(z, h, u, v, p, a, mask1, mask2, count);
              SetFlag<HardEvent::S_MTE3>(EVENT_ID0);
              WaitFlag<HardEvent::S_MTE3>(EVENT_ID0);
              SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
              WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
              DataCopyPad(yg[uint64_t(prev + mr + rowOffset + first) * t.n + nc], h,
                DataCopyExtParams{uint16_t(currentRows), cols * 2, (cw - ((cols + 15) / 16 * 16)) / 16, (t.n - cols) * 2, 0});
              SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
              WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
            }
          }
        } else {
          uint32_t vectorRows = (rows + VR - 1) / VR;
          uint32_t rowOffset = GetSubBlockIdx() * vectorRows;
          rows = rows > rowOffset ? (rows - rowOffset < vectorRows ? rows - rowOffset : vectorRows) : 0;
          mr += rowOffset;

          if (rows) DataCopyPad(s, sg[(uint64_t)e * t.n + nc], DataCopyExtParams{1, cols * 4, 0, 0, 0}, DataCopyPadExtParams<float>{true, 0, 0, 0});
          CrossCoreWaitFlag<2>(0);
          const uint32_t cw = cols == BN ? BN : (cols + 63) / 64 * 64;
          if (rows) {
            if (cols == BN)
              DataCopy(a, cg[(REUSE && GENERAL ? (done & 1) * ELEMS : 0) + rowOffset * BN], rows * BN);
            else
              DataCopyPad(a, cg[(REUSE && GENERAL ? (done & 1) * ELEMS : 0) + rowOffset * ((REUSE && !GENERAL) ? cols : BN)],
                DataCopyExtParams{(uint16_t)rows, cols * 4, ((REUSE && !GENERAL) ? 0 : (BN - cols) * 4), (cw - ((cols + 7) / 8 * 8)) / 8, 0},
                DataCopyPadExtParams<int32_t>{true, 0, 0, 0});
          }
          SetFlag<HardEvent::MTE2_S>(EVENT_ID0);
          WaitFlag<HardEvent::MTE2_S>(EVENT_ID0);
          CrossCoreSetFlag<2, PIPE_MTE2>(1);
          if (rows) {
            SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
            WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
            uint32_t count = rows * cw;
            Cast(z, a, RoundMode::CAST_RINT, count);

            for (uint32_t c = 0; c < cw; c += 64) Mul(z[c], z[c], s[c], uint64_t(64), uint8_t(rows), BinaryRepeatParams{1, 1, 1, cw / 8, cw / 8, 0});
            if constexpr (REUSE && GENERAL && DIRECT && BM == 64 && BN == 256 && !STREAM && !PADDED)
              GmgGeluSmall<true, true, false, true, true>(z, h, u, v, p, a, mask1, mask2, count);
            else if constexpr (REUSE || (BM == 128 && !STREAM))
              GmgGeluSmall<DIRECT && BN == 256>(z, h, u, v, p, a, mask1, mask2, count);
            else
              GmgGelu<DIRECT && BN == 256>(z, h, u, v, p, a, mask1, mask2, count);
            SetFlag<HardEvent::S_MTE3>(EVENT_ID0);
            WaitFlag<HardEvent::S_MTE3>(EVENT_ID0);
            SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
            WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
            DataCopyPad(
              yg[(uint64_t)(prev + mr) * t.n + nc], h, DataCopyExtParams{(uint16_t)rows, cols * 2, (cw - ((cols + 15) / 16 * 16)) / 16, (t.n - cols) * 2, 0});
            SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
            WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
          }
        }
#endif
        ++done;
      }
#if defined(SPLIT_CORE_CUBE)
      if (done > 1) CrossCoreWaitFlag<2>(4);
      if (done) CrossCoreWaitFlag<2>(1);
      CrossCoreSetFlag<2, PIPE_MTE2>(7);
#endif
#if defined(SPLIT_CORE_VEC)
      CrossCoreWaitFlag<2>(7);
#endif
    }
    taskBase += tasks;
    prev = end;

    if (end == t.m || (REUSE && GENERAL && nextTask >= stopTask)) break;
  }
#if defined(SPLIT_CORE_CUBE)
  mm.ReleaseEvents();
#endif
}

extern "C" __global__ __mix__(1, 2) void groupmatmulgelu_first_use_nz(
  GM_ADDR x, GM_ADDR w, GM_ADDR scale, GM_ADDR groups, GM_ADDR y, GM_ADDR workspace, GmgTiling t) {
  GmgComputeFirstUseNz<128, 256, false, false, false, false, false, true>(x, w, scale, groups, y, workspace, t);
}

template <uint32_t H, uint32_t W> class GmgTallReuseCube {
  static constexpr uint32_t BK = 512, INNER = 128, MAXK = 2048;
  static_assert(H == 128 && W == 256, "tall reuse cube");
  TQue<TPosition::A1, 1> a1b;
  TQue<TPosition::B1, 2> b1b;
  TQue<TPosition::A2, 2> a2b;
  TQue<TPosition::B2, 2> b2b;
  TQue<TPosition::CO1, 1> c1b;
  LocalTensor<int8_t> a1_;
  uint32_t n_ = 0, k_ = 0;

public:
  __aicore__ inline void Init(TPipe &pipe, uint32_t n, uint32_t k) {
    n_ = n;
    k_ = k;
    pipe.InitBuffer(a1b, 1, H * MAXK);
    pipe.InitBuffer(b1b, 2, BK * W);
    pipe.InitBuffer(a2b, 2, H * INNER);
    pipe.InitBuffer(b2b, 2, INNER * W);
    pipe.InitBuffer(c1b, 1, H * W * 4);
  }
  __aicore__ inline void LoadA(const GmgStreamTile &tile) {
    using namespace AscendC;
    auto a1 = a1b.AllocTensor<int8_t>();
    const uint32_t pm = (tile.rows + 15) / 16 * 16;
    const uint32_t fragments = k_ / 32, pk = (k_ + INNER - 1) / INNER * INNER;
    if (tile.rows != pm && fragments)
      InitConstValue(
        a1.ReinterpretCast<uint32_t>()[tile.rows * 8], InitConstValueParams<uint32_t>{uint16_t(fragments), uint16_t(pm - tile.rows), uint16_t(tile.rows), 0});
    if (k_ % INNER)
      InitConstValue(a1.ReinterpretCast<uint32_t>()[fragments * pm * 8], InitConstValueParams<uint32_t>{1, uint16_t((pk - fragments * 32) * pm / 32), 0, 0});
    if (tile.rows != pm || k_ % INNER) PipeBarrier<PIPE_MTE2>();
    Nd2NzParams ap{};
    ap.ndNum = 1;
    ap.nValue = tile.rows;
    ap.dValue = k_;
    ap.srcDValue = k_;
    ap.dstNzC0Stride = pm;
    ap.dstNzNStride = 1;
    DataCopy(a1, tile.x, ap);
    a1b.EnQue(a1);
  }
  __aicore__ inline void DequeA() { a1_ = a1b.DeQue<int8_t>(); }
  __aicore__ inline void FreeA() { a1b.FreeTensor(a1_); }
  __aicore__ inline void LoadB(const GmgStreamTile &tile, uint32_t base) {
    using namespace AscendC;
    auto b1 = b1b.AllocTensor<int8_t>();
    uint32_t chunk = k_ - base < BK ? k_ - base : BK;
    uint32_t pn = (tile.cols + 31) / 32 * 32, pk = (chunk + INNER - 1) / INNER * INNER;
    if (chunk != pk) {
      InitConstValue(b1.ReinterpretCast<uint32_t>(), InitConstValueParams<uint32_t>{1, uint16_t(pk * pn / 32), 0, 0});
      PipeBarrier<PIPE_MTE2>();
    }
    Nd2NzParams bp{};
    bp.ndNum = 1;
    bp.nValue = chunk;
    bp.dValue = tile.cols;
    bp.srcDValue = n_;
    bp.dstNzC0Stride = pk;
    bp.dstNzNStride = 1;
    DataCopy(b1, tile.w[uint64_t(base) * n_], bp);
    b1b.EnQue(b1);
  }
  __aicore__ inline void ComputePanel(const GmgStreamTile &tile, const GmgStreamTile *next, GlobalTensor<half> result, uint32_t ordinal) {
    using namespace AscendC;
    auto c = c1b.AllocTensor<int32_t>();
    uint32_t pm = (tile.rows + 15) / 16 * 16, pn = (tile.cols + 31) / 32 * 32, ik = INNER;
    for (uint32_t base = 0; base < k_; base += BK) {
      uint32_t chunk = k_ - base < BK ? k_ - base : BK, pk = (chunk + ik - 1) / ik * ik;
      auto b1 = b1b.DeQue<int8_t>();
      if (base + BK < k_)
        LoadB(tile, base + BK);
      else if (next)
        LoadB(*next, 0);
      for (uint32_t inner = 0; inner < pk; inner += ik) {
        auto a2 = a2b.AllocTensor<int8_t>();
        auto b2 = b2b.AllocTensor<int8_t>();
        LoadData2dParams al{};
        al.repeatTimes = ik / 32;
        al.srcStride = pm / 16;
        for (uint32_t m = 0; m < pm; m += 16) LoadData(a2[m * ik], a1_[(base + inner) * pm + m * 32], al);
        LoadData2dTransposeParams bl{};
        bl.repeatTimes = pn / 32;
        bl.srcStride = pk / 32;
        bl.dstGap = 1;
        for (uint32_t kk = 0; kk < ik; kk += 32) LoadDataWithTranspose(b2[kk * pn], b1[(inner + kk) * 32], bl);
        a2b.EnQue(a2);
        b2b.EnQue(b2);
        a2 = a2b.DeQue<int8_t>();
        b2 = b2b.DeQue<int8_t>();
        MmadParams mad{};
        mad.m = pm;
        mad.n = pn;
        mad.k = ik;
        mad.cmatrixInitVal = (base == 0 && inner == 0);
        Mmad(c, a2, b2, mad);
        PipeBarrier<PIPE_M>();
        a2b.FreeTensor(a2);
        b2b.FreeTensor(b2);
      }
      b1b.FreeTensor(b1);
    }
    c1b.EnQue(c);
    c = c1b.DeQue<int32_t>();
    FixpipeParamsV220 fix{};
    fix.nSize = pn;
    fix.mSize = tile.rows;
    fix.srcStride = pm;
    fix.dstStride = W;
    if (!ordinal)
      CrossCoreWaitFlag<2>(2);
    else if (ordinal >= 2) {
      if (ordinal & 1)
        CrossCoreWaitFlag<2>(4);
      else
        CrossCoreWaitFlag<2>(1);
    }
    const uint32_t exponent = 31U - __builtin_clz(k_ - 1);
    fix.quantPre = QuantMode_t::DEQF16;
    fix.deqScalar = uint64_t((127U - exponent) << 23);
    Fixpipe<half, int32_t, CFG_ROW_MAJOR>(result, c, fix);
    c1b.FreeTensor(c);
  }
};

// Same fixed shape-only cost model as c5po, evaluated on device to preserve
// the existing tiling ABI and all other paths' metadata. No input values read.
__aicore__ inline uint32_t GmgWholePrefixShape(const GmgTiling &t) {
  const uint32_t nt = (t.n + 255) / 256, perExpert = (t.m + t.e - 1) / t.e;
  const uint32_t estimated = t.e * ((perExpert + 127) / 128);
  uint32_t best = 1, bestCost = 0xffffffffU;
  const uint32_t firstWave = estimated < t.blocks ? 0 : 1;
  for (uint32_t waves = firstWave; waves <= 8; ++waves) {
    uint32_t cost = waves * (t.n + 128);
    if (estimated > waves * t.blocks) cost += ((estimated - waves * t.blocks) * nt + t.blocks - 1) / t.blocks * 384;
    if (cost < bestCost) {
      bestCost = cost;
      best = waves;
    }
  }
  return best * t.blocks;
}

template <uint32_t BM, uint32_t BN>
__aicore__ inline void GmgCombinedTallPanelGroup(GM_ADDR x, GM_ADDR w, GM_ADDR scale, GM_ADDR groups, GM_ADDR y, GM_ADDR workspace, const GmgTiling &t) {
  constexpr uint32_t ELEMS = BM * BN, VR = 2, VELEMS = ELEMS / VR;
  static_assert(BM == 128 && BN == 256, "tall panel group");
  TPipe pipe;
  const uint32_t core = GetBlockIdx() / GetTaskRation();
  GlobalTensor<int8_t> xg, wg;
  GlobalTensor<int64_t> gg;
  GlobalTensor<float> sg;
  GlobalTensor<half> yg;
  GlobalTensor<half> cg;
  xg.SetGlobalBuffer((__gm__ int8_t *)x);
  wg.SetGlobalBuffer((__gm__ int8_t *)w);
  gg.SetGlobalBuffer((__gm__ int64_t *)groups);
  sg.SetGlobalBuffer((__gm__ float *)scale);
  yg.SetGlobalBuffer((__gm__ half *)y);
  cg.SetGlobalBuffer((__gm__ half *)workspace + core * ELEMS * 2);
#if defined(SPLIT_CORE_CUBE)
  GmgTallReuseCube<BM, BN> mm;
  mm.Init(pipe, t.n, t.k);
#endif
#if defined(SPLIT_CORE_VEC)
  TBuf<TPosition::VECCALC> zb, ub, sb, hb, groupBuffer;
  pipe.InitBuffer(zb, VELEMS * 4);
  pipe.InitBuffer(ub, VELEMS * 4);
  pipe.InitBuffer(hb, VELEMS * 2);
  pipe.InitBuffer(sb, BN * 4);
  pipe.InitBuffer(groupBuffer, 128 * 8);
  auto z = zb.Get<float>();
  auto u = ub.Get<float>();
  auto s = sb.Get<float>();
  auto h = hb.Get<half>();
  auto localGroups = groupBuffer.Get<int64_t>();
  const bool useLocalGroups = t.e >= 16;
  if (useLocalGroups) {
    GlobalTensor<int32_t> groupWords;
    groupWords.SetGlobalBuffer((__gm__ int32_t *)groups);
    DataCopyPad(groupBuffer.Get<int32_t>(), groupWords, DataCopyExtParams{1, t.e * 8, 0, 0, 0},
      DataCopyPadExtParams<int32_t>{true, 0, uint8_t((4 - t.e % 4) % 4 * 2), 0});
    SetFlag<HardEvent::MTE2_S>(EVENT_ID0);
    WaitFlag<HardEvent::MTE2_S>(EVENT_ID0);
  }
  Duplicate(u, 0.0f, VELEMS);
  Duplicate(s, 0.0f, BN);
  SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
  WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
  SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
  WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
  DataCopy(cg[GetSubBlockIdx() * VELEMS], u.ReinterpretCast<half>(), VELEMS);
  DataCopy(cg[ELEMS + GetSubBlockIdx() * VELEMS], u.ReinterpretCast<half>(), VELEMS);
  CrossCoreSetFlag<2, PIPE_MTE3>(2);
#endif
  uint32_t done = 0;
  const uint32_t nt = (t.n + BN - 1) / BN;
  const uint32_t base = GmgWholePrefixShape(t);
  uint32_t rt = 0, slot = 0, pslot = 0, prev = 0;
#if defined(SPLIT_CORE_VEC)
  uint32_t firstExpert = useLocalGroups ? GmgFirstExpert(localGroups, t.e) : GmgFirstExpert(gg, t.e);
#else
  uint32_t firstExpert = GmgFirstExpert(gg, t.e);
#endif
  for (uint32_t e = firstExpert; e < t.e; ++e) {
    uint32_t end =
#if defined(SPLIT_CORE_VEC)
      useLocalGroups ? localGroups.GetValue(e) : gg.GetValue(e);
#else
      gg.GetValue(e);
#endif
    uint32_t len = end - prev, mt = (len + BM - 1) / BM;
    for (uint32_t r = 0; r < mt; ++r) {
      uint32_t lo, hi, step;
      if (rt < base) {
        if (slot == core) {
          lo = 0;
          hi = nt;
          step = 1;
        } else {
          lo = 1;
          hi = 0;
          step = 1;
        }
        if (++slot == t.blocks) slot = 0;
      } else {
        uint32_t d = core + t.blocks - pslot;
        if (d >= t.blocks) d -= t.blocks;
        lo = d;
        hi = nt;
        step = t.blocks;
        pslot += nt % t.blocks;
        if (pslot >= t.blocks) pslot -= t.blocks;
      }
      ++rt;
      if (lo >= hi) continue;
      const uint32_t rowBase = prev + r * BM;
      const uint32_t rowRows = (len - r * BM < BM ? len - r * BM : BM);
#if defined(SPLIT_CORE_CUBE)
      {
        GmgStreamTile at{xg[(uint64_t)rowBase * t.k], wg[uint64_t(e) * t.k * t.n + lo * BN], rowRows, BN};
        mm.LoadA(at);
        GmgStreamTile b0{xg[(uint64_t)rowBase * t.k], wg[uint64_t(e) * t.k * t.n + lo * BN], rowRows, (t.n - lo * BN < BN ? t.n - lo * BN : BN)};
        mm.LoadB(b0, 0);
        mm.DequeA();
        for (uint32_t panel = lo; panel < hi; panel += step) {
          uint32_t nc = panel * BN, cols = (t.n - nc < BN ? t.n - nc : BN), np = panel + step;
          GmgStreamTile tile{xg[(uint64_t)rowBase * t.k], wg[uint64_t(e) * t.k * t.n + nc], rowRows, cols};
          GmgStreamTile nextTile{};
          if (np < hi) {
            uint32_t nn = np * BN;
            nextTile = GmgStreamTile{xg[(uint64_t)rowBase * t.k], wg[uint64_t(e) * t.k * t.n + nn], rowRows, (t.n - nn < BN ? t.n - nn : BN)};
          }
          mm.ComputePanel(tile, (np < hi) ? &nextTile : nullptr, cg[(done & 1) * ELEMS], done);
          if (done & 1)
            CrossCoreSetFlag<2, PIPE_FIX>(3);
          else
            CrossCoreSetFlag<2, PIPE_FIX>(0);
          ++done;
        }
        mm.FreeA();
      }
#endif
#if defined(SPLIT_CORE_VEC)
      for (uint32_t panel = lo; panel < hi; panel += step) {
        const uint32_t nc = panel * BN, cols = t.n - nc < BN ? t.n - nc : BN;
        const uint32_t vr = (rowRows + 1) / 2, off = GetSubBlockIdx() * vr;
        const uint32_t rows = rowRows > off ? (rowRows - off < vr ? rowRows - off : vr) : 0;
        if (rows) DataCopyPad(s, sg[uint64_t(e) * t.n + nc], DataCopyExtParams{1, cols * 4, 0, 0, 0}, DataCopyPadExtParams<float>{true, 0, 0, 0});
        if (done & 1)
          CrossCoreWaitFlag<2>(3);
        else
          CrossCoreWaitFlag<2>(0);
        if (rows) {
          if (cols == BN)
            DataCopy(u.ReinterpretCast<half>(), cg[(done & 1) * ELEMS + off * BN], rows * BN);
          else
            DataCopyPad(u.ReinterpretCast<half>(), cg[(done & 1) * ELEMS + off * BN],
              DataCopyExtParams{uint16_t(rows), cols * 2, (BN - cols) * 2, (BN - (cols + 15) / 16 * 16) / 16, 0}, DataCopyPadExtParams<half>{true, 0, 0, 0});
        }
        SetFlag<HardEvent::MTE2_S>(EVENT_ID0);
        WaitFlag<HardEvent::MTE2_S>(EVENT_ID0);
        if (done & 1)
          CrossCoreSetFlag<2, PIPE_MTE2>(4);
        else
          CrossCoreSetFlag<2, PIPE_MTE2>(1);
        if (rows) {
          SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
          WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
          const uint32_t count = rows * BN;
          Cast(z, u.ReinterpretCast<half>(), RoundMode::CAST_NONE, count);
          const uint32_t exponent = 31U - __builtin_clz(t.k - 1);
          union {
            uint32_t u;
            float f;
          } restore;
          restore.u = (127U + exponent) << 23;
          Muls(s, s, restore.f, BN);
          for (uint32_t c = 0; c < BN; c += 64) Mul(z[c], z[c], s[c], uint64_t(64), uint8_t(rows), BinaryRepeatParams{1, 1, 1, BN / 8, BN / 8, 0});
          SetMaskCount();
          SetVectorMask<float, MaskMode::COUNTER>(count);
          Mul<float, false>(u, z, z, MASK_PLACEHOLDER, 1, {1, 1, 1, 8, 8, 8});
          Muls<float, false>(u, u, -0.07135481759315014f, MASK_PLACEHOLDER, 1, {1, 1, 8, 8});
          Adds<float, false>(u, u, -1.5957691216057308f, MASK_PLACEHOLDER, 1, {1, 1, 8, 8});
          Mul<float, false>(u, u, z, MASK_PLACEHOLDER, 1, {1, 1, 1, 8, 8, 8});
          Mins<float, false>(u, u, 80.0f, MASK_PLACEHOLDER, 1, {1, 1, 8, 8});
          Exp<float, false>(u, u, MASK_PLACEHOLDER, 1, {1, 1, 8, 8});
          Adds<float, false>(u, u, 1.0f, MASK_PLACEHOLDER, 1, {1, 1, 8, 8});
          Div<float, false>(z, z, u, MASK_PLACEHOLDER, 1, {1, 1, 1, 8, 8, 8});
          Cast<half, float, false>(h, z, RoundMode::CAST_RINT, MASK_PLACEHOLDER, 1, {1, 1, 4, 8});
          SetMaskNorm();
          ResetMask();
          SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
          WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
          DataCopyPad(
            yg[uint64_t(rowBase + off) * t.n + nc], h, DataCopyExtParams{uint16_t(rows), cols * 2, (BN - (cols + 15) / 16 * 16) / 16, (t.n - cols) * 2, 0});
          SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
          WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
          SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
          WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
        }
        ++done;
      }
#endif
    }
    prev = end;
    if (end == t.m) break;
  }
#if defined(SPLIT_CORE_CUBE)
  if (done > 1) CrossCoreWaitFlag<2>(4);
  if (done)
    CrossCoreWaitFlag<2>(1);
  else
    CrossCoreWaitFlag<2>(2);
#endif
}

extern "C" __global__ __mix__(1, 2) void groupmatmulgelu_combined_tall(
  GM_ADDR x, GM_ADDR w, GM_ADDR scale, GM_ADDR groups, GM_ADDR y, GM_ADDR workspace, GmgTiling t) {
  GmgCombinedTallPanelGroup<128, 256>(x, w, scale, groups, y, workspace, t);
}

#if !defined(GMG_SEPARATE_BUILD) || defined(GMG_BUILD_N128_LONG)
extern "C" __global__ __mix__(1, 2) void groupmatmulgelu_n128_long64(
  GM_ADDR x, GM_ADDR w, GM_ADDR scale, GM_ADDR groups, GM_ADDR y, GM_ADDR workspace, GmgTiling t) {
  GmgCompute<64, 128, false, false, true, false, false, false, 6144>(x, w, scale, groups, y, workspace, t);
}
extern "C" __global__ __mix__(1, 2) void groupmatmulgelu_n128_long32(
  GM_ADDR x, GM_ADDR w, GM_ADDR scale, GM_ADDR groups, GM_ADDR y, GM_ADDR workspace, GmgTiling t) {
  GmgCompute<32, 128, false, false, true, false, false, false, 8192>(x, w, scale, groups, y, workspace, t);
}
#endif

template <bool MDL, bool PADDED = false>
__aicore__ inline void GmgUnderfillSplit99(GM_ADDR x, GM_ADDR w, GM_ADDR scale, GM_ADDR groups, GM_ADDR y, GM_ADDR workspace, const GmgTiling &t) {
  constexpr uint32_t SM = 32, SN = 128, SE = SM * SN, SV = SE / 2;
  TPipe pipe;
  const uint32_t core = GetBlockIdx() / GetTaskRation();
  typename Conditional<PADDED, GmgWordWeightPacker, GmgNoWeightPacker>::type packer;
  if constexpr (PADDED) {
    auto padded = workspace + uint64_t(t.blocks) * SM * SN * 4 + uint64_t(core) * ((t.k + 511) / 512 * 512) * ((t.n + 31) / 32 * 32);
    packer.Init(w, padded, t, pipe);
    w = padded;
  }
  const uint32_t parts = t.reserved & 255U, logical = core / parts, part = core % parts;
  constexpr uint32_t KALIGN = 512;
  const uint32_t kBlocks = (t.k + KALIGN - 1) / KALIGN;
  const uint32_t kOffset = (kBlocks * part / parts) * KALIGN;
  const uint32_t kEndAligned = (kBlocks * (part + 1) / parts) * KALIGN;
  const uint32_t innerK = (kEndAligned < t.k ? kEndAligned : t.k) - kOffset;
  GlobalTensor<int8_t> xg, wg;
  GlobalTensor<int64_t> gg;
  GlobalTensor<float> sg;
  GlobalTensor<half> yg;
  GlobalTensor<int32_t> cg;
  xg.SetGlobalBuffer((__gm__ int8_t *)x);
  wg.SetGlobalBuffer((__gm__ int8_t *)w);
  gg.SetGlobalBuffer((__gm__ int64_t *)groups);
  sg.SetGlobalBuffer((__gm__ float *)scale);
  yg.SetGlobalBuffer((__gm__ half *)y);
  cg.SetGlobalBuffer((__gm__ int32_t *)workspace);
  uint32_t prev = 0, taskBase = 0, expert = 0, mr = 0, nc = 0, rows = 0, cols = 0;

  const uint32_t nt = (t.n + SN - 1) / SN;
  bool active = false;
  for (uint32_t e = GmgFirstExpert(gg, t.e); e < t.e; ++e) {
    uint32_t end = gg.GetValue(e), len = end - prev;
    uint32_t tasks = (len + SM - 1) / SM * nt;
    if (logical < taskBase + tasks) {
      uint32_t local = logical - taskBase;
      mr = local / nt * SM;
      nc = local % nt * SN;
      rows = len - mr < SM ? len - mr : SM;
      cols = t.n - nc < SN ? t.n - nc : SN;
      expert = e;
      active = true;
      break;
    }
    taskBase += tasks;
    prev = end;
  }
  if constexpr (PADDED)
    if (active) packer.Pack(expert, kOffset, innerK);
#if defined(SPLIT_CORE_CUBE)
  using CubeOp = GmgNarrowCube<false, 128, 32, 4096>;
  CubeOp mm;
  mm.Init(&t.cube, &pipe);
  mm.SetOrgShape(SM, PADDED ? (t.n + 31) / 32 * 32 : t.n, t.k, t.k, SN);
  CrossCoreWaitFlag<2>(2);
  if (active) {
    mm.SetSingleShape(rows, cols, innerK);
    mm.SetTensorA(xg[uint64_t(prev + mr) * t.k + kOffset]);
    mm.SetTensorB(wg[PADDED ? 0 : (uint64_t(expert) * t.k + kOffset) * t.n + nc]);
    mm.IterateAll(cg[core * SE]);
    mm.End();
  }
  CrossCoreSetFlag<0, PIPE_FIX>(6);
  CrossCoreWaitFlag<0>(6);
  CrossCoreSetFlag<2, PIPE_FIX>(0);
#endif
#if defined(SPLIT_CORE_VEC)
  TBuf<TPosition::VECCALC> ab, zb, ub, vb, pb, sb, hb, mb1, mb2;
  pipe.InitBuffer(ab, parts * SV * 4 + 256);
  pipe.InitBuffer(zb, SV * 4 + 256);
  pipe.InitBuffer(ub, SV * 4 + 256);
  pipe.InitBuffer(vb, SV * 4 + 256);
  pipe.InitBuffer(pb, SV * 4 + 256);
  pipe.InitBuffer(sb, SN * 4 + 256);
  pipe.InitBuffer(hb, SV * 2 + 256);
  pipe.InitBuffer(mb1, SV / 8 + 256);
  pipe.InitBuffer(mb2, SV / 8 + 256);
  auto a = ab.Get<int32_t>();
  auto z = zb.Get<float>();
  auto u = ub.Get<float>();
  auto v = vb.Get<float>();
  auto p = pb.Get<float>();
  auto s = sb.Get<float>();
  auto h = hb.Get<half>();
  auto mask1 = mb1.Get<uint8_t>();
  auto mask2 = mb2.Get<uint8_t>();
  Duplicate(a, int32_t(0), part == 0 ? parts * SV : SV);
  SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
  WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);

  if (part == 0) DataCopy(cg[logical * parts * SE + GetSubBlockIdx() * SV], a, DataCopyParams{uint16_t(parts), uint16_t(SV / 8), 0, uint16_t(SV / 8)});
  CrossCoreSetFlag<0, PIPE_MTE3>(7);
  CrossCoreWaitFlag<0>(7);
  CrossCoreSetFlag<2, PIPE_MTE3>(2);
  uint32_t vectorRows = (rows + 1) / 2, rowOffset = GetSubBlockIdx() * vectorRows;
  rows = rows > rowOffset ? (rows - rowOffset < vectorRows ? rows - rowOffset : vectorRows) : 0;
  mr += rowOffset;
  if (active && part == 0 && rows) {
    Duplicate(s, 0.0f, SN);
    SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
    WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
    DataCopyPad(s, sg[uint64_t(expert) * t.n + nc], DataCopyExtParams{1, cols * 4, 0, 0, 0}, DataCopyPadExtParams<float>{true, 0, 0, 0});
  }
  CrossCoreWaitFlag<2>(0);
  if (active && part == 0 && rows) {

    uint32_t offset = logical * parts * SE + rowOffset * SN;
    DataCopy(a, cg[offset], DataCopyParams{uint16_t(parts), uint16_t(rows * SN / 8), uint16_t((SE - rows * SN) / 8), uint16_t((SV - rows * SN) / 8)});
    SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
    WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
    for (uint32_t kPart = 1; kPart < parts; ++kPart) Add(a, a, a[kPart * SV], rows * SN);
    Cast(z, a, RoundMode::CAST_RINT, rows * SN);
    for (uint32_t col = 0; col < SN; col += 64) Mul(z[col], z[col], s[col], uint64_t(64), uint8_t(rows), BinaryRepeatParams{1, 1, 1, SN / 8, SN / 8, 0});
    GmgGelu(z, h, u, v, p, a, mask1, mask2, rows * SN);
    SetFlag<HardEvent::S_MTE3>(EVENT_ID0);
    WaitFlag<HardEvent::S_MTE3>(EVENT_ID0);
    SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
    WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
    DataCopyPad(yg[uint64_t(prev + mr) * t.n + nc], h, DataCopyExtParams{uint16_t(rows), cols * 2, (SN - ((cols + 15) / 16 * 16)) / 16, (t.n - cols) * 2, 0});
  }

#endif
}
extern "C" __global__ __mix__(1, 2) void groupmatmulgelu_underfill_split99(
  GM_ADDR x, GM_ADDR w, GM_ADDR scale, GM_ADDR groups, GM_ADDR y, GM_ADDR workspace, GmgTiling t) {
  GmgUnderfillSplit99<false, false>(x, w, scale, groups, y, workspace, t);
}
template <uint32_t PN> __aicore__ inline void GmgNarrowDense172(GM_ADDR x, GM_ADDR w, GM_ADDR scale, GM_ADDR groups, GM_ADDR y, const GmgTiling &t) {
#if defined(SPLIT_CORE_VEC) || defined(__DAV_C220_VEC__)
  using namespace AscendC;
  static_assert(PN == 32 || PN == 64, "one or two int8 datablocks per row");
  constexpr uint32_t KC = 128, CAP = KC * PN;
  const uint32_t actor = GetBlockIdx();
  const uint32_t rowBegin = uint64_t(t.m) * actor / t.blocks;
  const uint32_t rowEnd = uint64_t(t.m) * (actor + 1) / t.blocks;
  TPipe pipe;
  TBuf<TPosition::VECCALC> rawb, halfb, weightb, productb, indexb;
  TBuf<TPosition::VECCALC> xb, xhb, xfb, xbb, sb, zb, ub, pb, hb, maskb, gb;
  pipe.InitBuffer(rawb, CAP);
  pipe.InitBuffer(halfb, CAP * 2);
  pipe.InitBuffer(weightb, CAP * 4);
  pipe.InitBuffer(productb, CAP * 4);
  pipe.InitBuffer(indexb, CAP * 4);
  pipe.InitBuffer(xb, KC);
  pipe.InitBuffer(xhb, KC * 2);
  pipe.InitBuffer(xfb, KC * 4);
  pipe.InitBuffer(xbb, KC * 8 * 4);
  pipe.InitBuffer(sb, 64 * 4);
  pipe.InitBuffer(zb, 64 * 4);
  pipe.InitBuffer(ub, 64 * 4);
  pipe.InitBuffer(pb, 64 * 4);
  pipe.InitBuffer(hb, 64 * 2);
  pipe.InitBuffer(maskb, CAP / 8);
  pipe.InitBuffer(gb, 128 * 8);
  auto raw = rawb.Get<int8_t>();
  auto halfW = halfb.Get<half>();
  auto weight = weightb.Get<float>();
  auto products = productb.Get<float>();
  auto indices = indexb.Get<uint32_t>();
  auto xx = xb.Get<int8_t>();
  auto xh = xhb.Get<half>();
  auto xf = xfb.Get<float>();
  auto broadcast = xbb.Get<float>();
  auto s = sb.Get<float>();
  auto z = zb.Get<float>();
  auto u = ub.Get<float>();
  auto p = pb.Get<float>();
  auto h = hb.Get<half>();
  auto columns = maskb.Get<uint8_t>();
  auto ends = gb.Get<int64_t>();
  GlobalTensor<int8_t> xg, wg;
  GlobalTensor<float> sg;
  GlobalTensor<int32_t> groupWords;
  GlobalTensor<half> yg;
  xg.SetGlobalBuffer((__gm__ int8_t *)x, uint64_t(t.m) * t.k);
  wg.SetGlobalBuffer((__gm__ int8_t *)w, uint64_t(t.e) * t.k * t.n);
  sg.SetGlobalBuffer((__gm__ float *)scale, uint64_t(t.e) * t.n);
  groupWords.SetGlobalBuffer((__gm__ int32_t *)groups, t.e * 2);
  yg.SetGlobalBuffer((__gm__ half *)y, uint64_t(t.m) * t.n);
  DataCopyPad(gb.Get<int32_t>(), groupWords, DataCopyExtParams{1, t.e * 8, 0, 0, 0}, DataCopyPadExtParams<int32_t>{true, 0, uint8_t((4 - t.e % 4) % 4 * 2), 0});
  SetFlag<HardEvent::MTE2_S>(EVENT_ID0);
  WaitFlag<HardEvent::MTE2_S>(EVENT_ID0);
  uint32_t paddedK = 8;
  while (paddedK < t.k) paddedK *= 2;
  const uint32_t count = paddedK * PN;
  GmgIndex(indices.ReinterpretCast<int32_t>(), count);
  Duplicate(products.ReinterpretCast<uint16_t>(), uint16_t(PN - 1), count * 2);
  And(products.ReinterpretCast<uint16_t>(), indices.ReinterpretCast<uint16_t>(), products.ReinterpretCast<uint16_t>(), count * 2);
  Cast(weight, products.ReinterpretCast<int32_t>(), RoundMode::CAST_RINT, count);
  CompareScalar(columns, weight, float(int32_t(t.n)), CMPMODE::LT, count);
  ShiftRight(products.ReinterpretCast<uint32_t>(), indices, uint32_t(PN == 32 ? 5 : 6), count);
  Muls(products.ReinterpretCast<int32_t>(), products.ReinterpretCast<int32_t>(), int32_t(t.n) - int32_t(PN), count);
  Add(indices.ReinterpretCast<int32_t>(), indices.ReinterpretCast<int32_t>(), products.ReinterpretCast<int32_t>(), count);
  ShiftLeft(indices, indices, uint32_t(2), count);
  uint32_t expert = t.e, expertEnd = 0;
  for (uint32_t row = rowBegin; row < rowEnd; ++row) {
    bool reload = row >= expertEnd;
    if (reload) {
      uint32_t lo = 0, hi = t.e;
      while (lo < hi) {
        const uint32_t mid = lo + (hi - lo) / 2;
        if (uint32_t(ends.GetValue(mid)) <= row)
          lo = mid + 1;
        else
          hi = mid;
      }
      expert = lo;
      expertEnd = uint32_t(ends.GetValue(expert));
    }
    Duplicate(xx.ReinterpretCast<int32_t>(), int32_t(0), KC / 4);
    if (reload) {
      Duplicate(raw.ReinterpretCast<int32_t>(), int32_t(0), count / 4);
      Duplicate(s, 0.0f, 64);
    }
    SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
    WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
    DataCopyPad(xx, xg[uint64_t(row) * t.k], DataCopyExtParams{1, t.k, 0, 0, 0}, DataCopyPadExtParams<int8_t>{true, 0, uint8_t((32 - t.k % 32) % 32), 0});
    if (reload) {
      const uint32_t bytes = t.k * t.n;
      DataCopyPad(
        raw, wg[uint64_t(expert) * bytes], DataCopyExtParams{1, bytes, 0, 0, 0}, DataCopyPadExtParams<int8_t>{true, 0, uint8_t((32 - bytes % 32) % 32), 0});
      DataCopyPad(
        s, sg[uint64_t(expert) * t.n], DataCopyExtParams{1, t.n * 4, 0, 0, 0}, DataCopyPadExtParams<float>{true, 0, uint8_t((8 - t.n % 8) % 8), 0.0f});
    }
    SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
    WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
    if (reload) {
      Cast(halfW, raw, RoundMode::CAST_NONE, count);
      Cast(products, halfW, RoundMode::CAST_NONE, count);
      Gather(weight.ReinterpretCast<uint32_t>(), products.ReinterpretCast<uint32_t>(), indices, 0, count);
      Select(weight, columns, weight, 0.0f, SELMODE::VSEL_TENSOR_SCALAR_MODE, count);
    }
    Cast(xh, xx, RoundMode::CAST_NONE, paddedK);
    Cast(xf, xh, RoundMode::CAST_NONE, paddedK);
    Brcb(broadcast, xf, paddedK / 8, {1, 8});
    Mul(products, weight, broadcast, uint64_t(PN), uint8_t(paddedK), BinaryRepeatParams{1, 1, 0, PN / 8, PN / 8, 1});
    for (uint32_t halfK = paddedK / 2; halfK; halfK /= 2) Add(products, products, products[halfK * PN], halfK * PN);
    Duplicate(z, 0.0f, 64);
    Mul(z, products, s, PN);
    GmgGelu<true>(z, h, u, products, p, products.ReinterpretCast<int32_t>(), columns, columns, 64);
    SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
    WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
    DataCopyPad(yg[uint64_t(row) * t.n], h, DataCopyExtParams{1, t.n * 2, 0, 0, 0});
    SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
    WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
  }
#endif
}
extern "C" __global__ __vector__ void groupmatmulgelu_narrow_dense172(GM_ADDR x, GM_ADDR w, GM_ADDR scale, GM_ADDR groups, GM_ADDR y, GM_ADDR, GmgTiling t) {
  if (t.n <= 32)
    GmgNarrowDense172<32>(x, w, scale, groups, y, t);
  else
    GmgNarrowDense172<64>(x, w, scale, groups, y, t);
}

// Batch complete short-K outer products before the original FP32 epilogue.
__aicore__ inline void GmgOuter185(GM_ADDR x, GM_ADDR w, GM_ADDR scale, GM_ADDR groups, GM_ADDR y, const GmgTiling &t) {
#if defined(SPLIT_CORE_VEC) || defined(__DAV_C220_VEC__)
  using namespace AscendC;
  constexpr uint32_t RM = 32, BN = 256, MAXK = 8, ELEMS = RM * BN;
  TPipe pipe;
  TBuf<TPosition::VECCALC> accb, tmpb, zb, hb, wb, whb, wib;
  TBuf<TPosition::VECCALC> xb, xhb, xib, xcb, xrb, offb, sb;
  pipe.InitBuffer(accb, ELEMS * 4);
  pipe.InitBuffer(tmpb, ELEMS * 4);
  pipe.InitBuffer(zb, ELEMS * 4);
  pipe.InitBuffer(hb, ELEMS * 2);
  pipe.InitBuffer(wb, MAXK * BN);
  pipe.InitBuffer(whb, MAXK * BN * 2);
  pipe.InitBuffer(wib, MAXK * BN * 4);
  pipe.InitBuffer(xb, RM * MAXK);
  pipe.InitBuffer(xhb, RM * MAXK * 2);
  pipe.InitBuffer(xib, RM * MAXK * 4);
  pipe.InitBuffer(xcb, RM * 4);
  pipe.InitBuffer(xrb, RM * 8 * 4);
  pipe.InitBuffer(offb, RM * 4);
  pipe.InitBuffer(sb, BN * 4);
  auto acc = accb.Get<int32_t>();
  auto tmp = tmpb.Get<int32_t>();
  auto z = zb.Get<float>();
  auto h = hb.Get<half>();
  auto wr = wb.Get<int8_t>();
  auto wh = whb.Get<half>();
  auto wi = wib.Get<int32_t>();
  auto xr = xb.Get<int8_t>();
  auto xh = xhb.Get<half>();
  auto xi = xib.Get<int32_t>();
  auto xc = xcb.Get<int32_t>();
  auto replicated = xrb.Get<int32_t>();
  auto offsets = offb.Get<uint32_t>();
  auto factors = sb.Get<float>();
  GlobalTensor<int8_t> gx, gw;
  GlobalTensor<float> gs;
  GlobalTensor<int64_t> gg;
  GlobalTensor<half> gy;
  gx.SetGlobalBuffer((__gm__ int8_t *)x, uint64_t(t.m) * t.k);
  gw.SetGlobalBuffer((__gm__ int8_t *)w, uint64_t(t.e) * t.k * t.n);
  gs.SetGlobalBuffer((__gm__ float *)scale, uint64_t(t.e) * t.n);
  gg.SetGlobalBuffer((__gm__ int64_t *)groups, t.e);
  gy.SetGlobalBuffer((__gm__ half *)y, uint64_t(t.m) * t.n);
  GmgIndex(offsets.ReinterpretCast<int32_t>(), RM);
  Muls(offsets.ReinterpretCast<int32_t>(), offsets.ReinterpretCast<int32_t>(), int32_t(t.k * 4), RM);
  const uint32_t panels = (t.n + BN - 1) / BN;
  uint32_t taskBase = 0, nextTask = GetBlockIdx(), before = 0;
  for (uint32_t expert = 0; expert < t.e; ++expert) {
    const uint32_t end = gg.GetValue(expert), length = end - before;
    const uint32_t tasks = ((length + RM - 1) / RM) * panels;
    for (; nextTask < taskBase + tasks; nextTask += t.blocks) {
      const uint32_t local = nextTask - taskBase;
      const uint32_t row = before + (local / panels) * RM, col = (local % panels) * BN;
      const uint32_t rows = end - row < RM ? end - row : RM, cols = t.n - col < BN ? t.n - col : BN;
      const uint32_t xBytes = rows * t.k, alignedCols = (cols + 31) / 32 * 32;
      Duplicate(xr.ReinterpretCast<int32_t>(), int32_t(0), RM * MAXK / 4);
      Duplicate(wr.ReinterpretCast<int32_t>(), int32_t(0), MAXK * BN / 4);
      Duplicate(factors, 0.0f, BN);
      // Retire old Vector reads and the new padding writes before input DMA.
      SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
      WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
      DataCopyPad(
        xr, gx[uint64_t(row) * t.k], DataCopyExtParams{1, xBytes, 0, 0, 0}, DataCopyPadExtParams<int8_t>{true, 0, uint8_t((32 - xBytes % 32) % 32), 0});
      DataCopyPad(wr, gw[uint64_t(expert) * t.k * t.n + col], DataCopyExtParams{uint16_t(t.k), cols, t.n - cols, (BN - alignedCols) / 32, 0},
        DataCopyPadExtParams<int8_t>{true, 0, uint8_t(alignedCols - cols), 0});
      DataCopyPad(factors, gs[uint64_t(expert) * t.n + col], DataCopyExtParams{1, cols * 4, 0, 0, 0},
        DataCopyPadExtParams<float>{true, 0, uint8_t((8 - cols % 8) % 8), 0});
      SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
      WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
      Cast(xh, xr, RoundMode::CAST_NONE, RM * MAXK);
      Cast(xi, xh, RoundMode::CAST_RINT, RM * MAXK);
      Cast(wh, wr, RoundMode::CAST_NONE, MAXK * BN);
      Cast(wi, wh, RoundMode::CAST_RINT, MAXK * BN);
      for (uint32_t term = 0; term < t.k; ++term) {
        Gather(xc, xi, offsets, uint32_t(term * 4), RM);
        Brcb(replicated, xc, RM / 8, {1, 8});
        for (uint32_t c = 0; c < BN; c += 64) {
          if (term == 0)
            Mul(acc[c], wi[term * BN + c], replicated, uint64_t(64), uint8_t(RM), BinaryRepeatParams{1, 1, 0, uint8_t(BN / 8), 0, 1});
          else
            Mul(tmp[c], wi[term * BN + c], replicated, uint64_t(64), uint8_t(RM), BinaryRepeatParams{1, 1, 0, uint8_t(BN / 8), 0, 1});
        }
        if (term) Add(acc, acc, tmp, ELEMS);
      }
      Cast(z, acc, RoundMode::CAST_RINT, ELEMS);
      for (uint32_t c = 0; c < BN; c += 64)
        Mul(z[c], z[c], factors[c], uint64_t(64), uint8_t(RM), BinaryRepeatParams{1, 1, 1, uint8_t(BN / 8), uint8_t(BN / 8), 0});
      // Dot operands are dead; reuse their real buffers for u and p.
      GmgGelu<true>(z, h, acc.ReinterpretCast<float>(), acc.ReinterpretCast<float>(), tmp.ReinterpretCast<float>(), acc, offsets.ReinterpretCast<uint8_t>(),
        offsets.ReinterpretCast<uint8_t>(), ELEMS);
      SetFlag<HardEvent::S_MTE3>(EVENT_ID0);
      WaitFlag<HardEvent::S_MTE3>(EVENT_ID0);
      SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
      WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
      DataCopyPad(gy[uint64_t(row) * t.n + col], h, DataCopyExtParams{uint16_t(rows), cols * 2, (BN - (cols + 15) / 16 * 16) / 16, (t.n - cols) * 2, 0});
      SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
      WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
    }
    taskBase += tasks;
    before = end;
    if (end == t.m) break;
  }
#endif
}
__aicore__ inline void GmgOuterGelu188(
  AscendC::LocalTensor<float> z, AscendC::LocalTensor<half> h, AscendC::LocalTensor<float> u, uint32_t count, bool pendingOutput) {
  using namespace AscendC;
  SetMaskCount();
  SetVectorMask<float, MaskMode::COUNTER>(count);
  Mul<float, false>(u, z, z, MASK_PLACEHOLDER, 1, {1, 1, 1, 8, 8, 8});
  Muls<float, false>(u, u, -0.07135481759315014f, MASK_PLACEHOLDER, 1, {1, 1, 8, 8});
  Adds<float, false>(u, u, -1.5957691216057308f, MASK_PLACEHOLDER, 1, {1, 1, 8, 8});
  Mul<float, false>(u, u, z, MASK_PLACEHOLDER, 1, {1, 1, 1, 8, 8, 8});
  Mins<float, false>(u, u, 80.0f, MASK_PLACEHOLDER, 1, {1, 1, 8, 8});
  Exp<float, false>(u, u, MASK_PLACEHOLDER, 1, {1, 1, 8, 8});
  Adds<float, false>(u, u, 1.0f, MASK_PLACEHOLDER, 1, {1, 1, 8, 8});
  Div<float, false>(z, z, u, MASK_PLACEHOLDER, 1, {1, 1, 1, 8, 8, 8});
  if (pendingOutput) WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
  Cast<half, float, false>(h, z, RoundMode::CAST_RINT, MASK_PLACEHOLDER, 1, {1, 1, 4, 8});
  SetMaskNorm();
  ResetMask();
}

__aicore__ inline void GmgOuter188(GM_ADDR x, GM_ADDR w, GM_ADDR scale, GM_ADDR groups, GM_ADDR y, const GmgTiling &t) {
#if defined(SPLIT_CORE_VEC) || defined(__DAV_C220_VEC__)
  using namespace AscendC;
  constexpr uint32_t RM = 64, BN = 256, MAXK = 8, ELEMS = RM * BN;
  TPipe pipe;
  TBuf<TPosition::VECCALC> accb, zb, hb, wb, whb, wib;
  TBuf<TPosition::VECCALC> xb, xhb, xib, xcb, xrb, offb, sb;
  pipe.InitBuffer(accb, ELEMS * 4);
  pipe.InitBuffer(zb, ELEMS * 4);
  pipe.InitBuffer(hb, ELEMS * 2);
  pipe.InitBuffer(wb, MAXK * BN);
  pipe.InitBuffer(whb, MAXK * BN * 2);
  pipe.InitBuffer(wib, MAXK * BN * 4);
  pipe.InitBuffer(xb, RM * MAXK);
  pipe.InitBuffer(xhb, RM * MAXK * 2);
  pipe.InitBuffer(xib, RM * MAXK * 4);
  pipe.InitBuffer(xcb, RM * 4);
  pipe.InitBuffer(xrb, RM * 8 * 4);
  pipe.InitBuffer(offb, RM * 4);
  pipe.InitBuffer(sb, BN * 4);
  auto acc = accb.Get<int32_t>();
  auto z = zb.Get<float>();
  auto tmp = zb.Get<int32_t>();
  auto h = hb.Get<half>();
  auto wr = wb.Get<int8_t>();
  auto wh = whb.Get<half>();
  auto wi = wib.Get<int32_t>();
  auto xr = xb.Get<int8_t>();
  auto xh = xhb.Get<half>();
  auto xi = xib.Get<int32_t>();
  auto xc = xcb.Get<int32_t>();
  auto replicated = xrb.Get<int32_t>();
  auto offsets = offb.Get<uint32_t>();
  auto factors = sb.Get<float>();
  GlobalTensor<int8_t> gx, gw;
  GlobalTensor<float> gs;
  GlobalTensor<int64_t> gg;
  GlobalTensor<half> gy;
  gx.SetGlobalBuffer((__gm__ int8_t *)x, uint64_t(t.m) * t.k);
  gw.SetGlobalBuffer((__gm__ int8_t *)w, uint64_t(t.e) * t.k * t.n);
  gs.SetGlobalBuffer((__gm__ float *)scale, uint64_t(t.e) * t.n);
  gg.SetGlobalBuffer((__gm__ int64_t *)groups, t.e);
  gy.SetGlobalBuffer((__gm__ half *)y, uint64_t(t.m) * t.n);
  if (t.k != 1) {
    GmgIndex(offsets.ReinterpretCast<int32_t>(), RM);
    Muls(offsets.ReinterpretCast<int32_t>(), offsets.ReinterpretCast<int32_t>(), int32_t(t.k * 4), RM);
  }
  const uint32_t panels = (t.n + BN - 1) / BN;
  uint32_t taskBase = 0, nextTask = GetBlockIdx(), before = 0;
  uint32_t loadedExpert = t.e, loadedCol = 0, loadedPitch = 0;
  bool pendingOutput = false;
  for (uint32_t expert = 0; expert < t.e; ++expert) {
    const uint32_t end = gg.GetValue(expert), length = end - before;
    const uint32_t mt = (length + RM - 1) / RM, tasks = mt * panels;
    for (; nextTask < taskBase + tasks; nextTask += t.blocks) {
      // Complete N panels contain consecutive M tiles; RR ownership stays local.
      const uint32_t local = nextTask - taskBase;
      const uint32_t row = before + (local % mt) * RM, col = (local / mt) * BN;
      const uint32_t rows = end - row < RM ? end - row : RM, cols = t.n - col < BN ? t.n - col : BN;
      const uint32_t pitch = (cols + 63) / 64 * 64, count = rows * pitch;
      const uint32_t xBytes = rows * t.k, alignedCols = (cols + 31) / 32 * 32;
      const bool loadWeight = loadedExpert != expert || loadedCol != col || loadedPitch != pitch;
      Duplicate(xr.ReinterpretCast<int32_t>(), int32_t(0), RM * MAXK / 4);
      if (loadWeight) {
        Duplicate(wr.ReinterpretCast<int32_t>(), int32_t(0), MAXK * BN / 4);
        Duplicate(factors, 0.0f, BN);
      }
      SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
      WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
      DataCopyPad(
        xr, gx[uint64_t(row) * t.k], DataCopyExtParams{1, xBytes, 0, 0, 0}, DataCopyPadExtParams<int8_t>{true, 0, uint8_t((32 - xBytes % 32) % 32), 0});
      if (loadWeight) {
        DataCopyPad(wr, gw[uint64_t(expert) * t.k * t.n + col], DataCopyExtParams{uint16_t(t.k), cols, t.n - cols, (pitch - alignedCols) / 32, 0},
          DataCopyPadExtParams<int8_t>{true, 0, uint8_t(alignedCols - cols), 0});
        DataCopyPad(factors, gs[uint64_t(expert) * t.n + col], DataCopyExtParams{1, cols * 4, 0, 0, 0},
          DataCopyPadExtParams<float>{true, 0, uint8_t((8 - cols % 8) % 8), 0});
      }
      SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
      WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
      if (t.k == 1) {
        Cast(xh, xr, RoundMode::CAST_NONE, RM);
        Cast(xi.ReinterpretCast<float>(), xh, RoundMode::CAST_NONE, RM);
      } else {
        Cast(xh, xr, RoundMode::CAST_NONE, RM * MAXK);
        Cast(xi, xh, RoundMode::CAST_RINT, RM * MAXK);
      }
      if (loadWeight) {
        Cast(wh, wr, RoundMode::CAST_NONE, t.k * pitch);
        if (t.k == 1) {
          Cast(wi.ReinterpretCast<float>(), wh, RoundMode::CAST_NONE, pitch);
          Mul(wi.ReinterpretCast<float>(), wi.ReinterpretCast<float>(), factors, pitch);
        } else
          Cast(wi, wh, RoundMode::CAST_RINT, t.k * pitch);
        loadedExpert = expert;
        loadedCol = col;
        loadedPitch = pitch;
      }
      if (t.k == 1) {
        // A rank-one tile uses every real X/W/scale value, with scale cached once.
        // Only FP32 multiplication association changes; original FP32 GELU follows.
        Brcb(replicated.ReinterpretCast<float>(), xi.ReinterpretCast<float>(), RM / 8, {1, 8});
        for (uint32_t c = 0; c < pitch; c += 64)
          Mul(z[c], wi.ReinterpretCast<float>()[c], replicated.ReinterpretCast<float>(), uint64_t(64), uint8_t(rows),
            BinaryRepeatParams{1, 1, 0, uint8_t(pitch / 8), 0, 1});
      } else {
        for (uint32_t term = 0; term < t.k; ++term) {
          Gather(xc, xi, offsets, uint32_t(term * 4), RM);
          Brcb(replicated, xc, RM / 8, {1, 8});
          for (uint32_t c = 0; c < pitch; c += 64) {
            if (term == 0)
              Mul(acc[c], wi[term * pitch + c], replicated, uint64_t(64), uint8_t(rows), BinaryRepeatParams{1, 1, 0, uint8_t(pitch / 8), 0, 1});
            else
              Mul(tmp[c], wi[term * pitch + c], replicated, uint64_t(64), uint8_t(rows), BinaryRepeatParams{1, 1, 0, uint8_t(pitch / 8), 0, 1});
          }
          if (term) Add(acc, acc, tmp, count);
        }
        // All integer tmp values are dead before the float z view overwrites them.
        Cast(z, acc, RoundMode::CAST_RINT, count);
        for (uint32_t c = 0; c < pitch; c += 64)
          Mul(z[c], z[c], factors[c], uint64_t(64), uint8_t(rows), BinaryRepeatParams{1, 1, 1, uint8_t(pitch / 8), uint8_t(pitch / 8), 0});
      }
      GmgOuterGelu188(z, h, acc.ReinterpretCast<float>(), count, pendingOutput);
      // h is written only by Vector. Publish it directly on that dependency edge.
      SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
      WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
      DataCopyPad(gy[uint64_t(row) * t.n + col], h, DataCopyExtParams{uint16_t(rows), cols * 2, (pitch - (cols + 15) / 16 * 16) / 16, (t.n - cols) * 2, 0});
      SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
      pendingOutput = true;
    }
    taskBase += tasks;
    before = end;
    if (end == t.m) break;
  }
  if (pendingOutput) WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
#endif
}

extern "C" __global__ __vector__ void groupmatmulgelu_outer185(GM_ADDR x, GM_ADDR w, GM_ADDR scale, GM_ADDR groups, GM_ADDR y, GM_ADDR, GmgTiling t) {
  if (t.bm == 64)
    GmgOuter188(x, w, scale, groups, y, t);
  else
    GmgOuter185(x, w, scale, groups, y, t);
}

extern "C" int gmg_make_tiling_base(void *dst, uint32_t e, uint32_t m, uint32_t k, uint32_t n, uint32_t bm, uint32_t bn, uint32_t blocks) {
  auto *p = platform_ascendc::PlatformAscendCManager::GetInstance(aclrtGetSocName());
  if (!p || !e || !m || !k || !n || !blocks || blocks > p->GetCoreNumAic()) return -1;

  // Increase spatially underfilled long-K calls with exact INT32 partials.
  if (k >= 2048 && n > 64) {
    const uint32_t rowsUpper = ((m + 31) / 32 + e - 1 < m) ? (m + 31) / 32 + e - 1 : m;
    const uint32_t tasksUpper = rowsUpper * ((n + 127) / 128);
    uint32_t parts = blocks / tasksUpper;
    if (parts > 8) parts = 8;
    if (parts > k / 1024) parts = k / 1024;
    if (parts >= 2) {
      GmgTiling t{};
      t.e = e;
      t.m = m;
      t.k = k;
      t.n = n;
      t.bm = 32;
      t.bn = 128;
      t.blocks = tasksUpper * parts;
      t.reserved = 0x00000800U | parts;
      std::memcpy(dst, &t, sizeof(t));
      return 0;
    }
  }

  if (k > 2048 && n > 128 && n <= 256 && n % 64 != 0) {
    GmgTiling t{};
    t.e = e;
    t.m = m;
    t.k = k;
    t.n = n;
    t.bm = k <= 6144 ? 64 : 32;
    t.bn = 128;
    t.blocks = blocks;
    uint32_t maxMTiles = (m + t.bm - 1) / t.bm + e - 1;
    if (maxMTiles > m) maxMTiles = m;
    if (maxMTiles <= blocks) {
      uint32_t maxTasks = maxMTiles * ((n + 127) / 128);
      if (t.blocks > maxTasks) t.blocks = maxTasks;
      t.reserved = 0x00000200U;
      std::memcpy(dst, &t, sizeof(t));
      return 0;
    }
  }

  // At least two M128 panels per average group amortize one private NZ
  // representation. Owners consume up to four panels before relinquishing it.
  if (k > 2048 && n >= 768 && n % 32 != 0 && m >= e * 256) {
    GmgTiling t{};
    t.e = e;
    t.m = m;
    t.k = k;
    t.n = n;
    t.bm = 128;
    t.bn = 256;
    t.blocks = blocks;
    uint32_t maxRows = (m + 511) / 512 + e - 1;
    if (maxRows > m) maxRows = m;
    uint32_t maxTasks = maxRows * ((n + 255) / 256);
    if (t.blocks > maxTasks) t.blocks = maxTasks;
    t.reserved = 0x00000100U;
    std::memcpy(dst, &t, sizeof(t));
    return 0;
  }

  if (n == 1 && k >= 256 && m >= e * 128 && (m + 63) / 64 >= blocks * 2) {
    GmgTiling t{};
    t.e = e;
    t.m = m;
    t.k = k;
    t.n = n;
    t.bm = 64;
    t.bn = 32;
    t.blocks = blocks;
    t.reserved = 0x00040000U;
    std::memcpy(dst, &t, sizeof(t));
    return 0;
  }
  if (n == 1 || (n <= 64 && k <= 32 && (m <= e || k == 1 || (m <= blocks * 2 && m <= p->GetCoreNumAiv())))) {
    blocks *= 2;
    if (blocks > p->GetCoreNumAiv()) blocks = p->GetCoreNumAiv();
    if (blocks > m) blocks = m;
    GmgTiling t{};
    t.e = e;
    t.m = m;
    t.k = k;
    t.n = n;
    t.bm = 32;
    t.bn = 64;
    t.blocks = blocks;
    t.reserved = n == 1 ? 0 : 0x40000000U;
    std::memcpy(dst, &t, sizeof(t));
    return 0;
  }

  if (n > 1 && n <= 64 && k <= 128 && uint64_t(m) <= uint64_t(e) * 2) {
    const uint32_t available = p->GetCoreNumAiv();
    const uint32_t limit = 2 * blocks < available ? 2 * blocks : available;
    if (uint64_t(m) <= uint64_t(limit) * 2) {
      GmgTiling t{};
      t.e = e;
      t.m = m;
      t.k = k;
      t.n = n;
      t.bm = 1;
      t.bn = n <= 32 ? 32 : 64;
      t.blocks = m < limit ? m : limit;
      t.reserved = 0x00001008U;
      std::memcpy(dst, &t, sizeof(t));
      return 0;
    }
  }

  if (k <= 4 && n > 64) {
    const uint32_t panels = (n + 127) / 128;
    const uint32_t tasks = m * panels;
    const uint32_t available = p->GetCoreNumAiv();
    const uint32_t vecBlocks = 2 * blocks < available ? 2 * blocks : available;
    // Bound the workload to two 128-column row panels per Vector actor.
    if (tasks <= 2 * vecBlocks) {
      GmgTiling t{};
      t.e = e;
      t.m = m;
      t.k = k;
      t.n = n;
      t.bm = 1;
      t.bn = 128;
      t.blocks = tasks < vecBlocks ? tasks : vecBlocks;
      t.reserved = 0x00010000U;
      std::memcpy(dst, &t, sizeof(t));
      return 0;
    }
  }

  if (k <= 8 && n > 64 && uint64_t(m) >= uint64_t(e) * 32) {
    const uint32_t available = p->GetCoreNumAiv();
    const uint32_t vecBlocks = 2 * blocks < available ? 2 * blocks : available;
    const uint64_t minTasks = ((uint64_t(m) + 31) / 32) * ((n + 255) / 256);
    if (minTasks >= vecBlocks) {
      GmgTiling t{};
      t.e = e;
      t.m = m;
      t.k = k;
      t.n = n;
      const uint64_t min64 = ((uint64_t(m) + 63) / 64) * ((n + 255) / 256);
      t.bm = min64 >= vecBlocks ? 64 : 32;
      t.bn = 256;
      t.blocks = vecBlocks;
      t.reserved = 0x00001009U;
      std::memcpy(dst, &t, sizeof(t));
      return 0;
    }
  }

  if (n <= 64) {
    bm = 32;
    bn = 64;
  } else if (n <= 128) {
    bm = (m < blocks * 64 && e < blocks) ? 32 : 64;
    bn = 128;
  } else {
    bm = 64;
    bn = 256;
    uint32_t estimatedGroups = (m + 63) / 64 > e ? (m + 63) / 64 : e;
    if (k <= 2048 && estimatedGroups * ((n + 255) / 256) < blocks) {
      bm = 32;
      bn = 128;
    }
  }

  if (k >= 4096 && n >= 512 && bn == 256) {
    const uint32_t perExpert = (m + e - 1) / e;
    const uint32_t t1 = ((perExpert + 63) / 64) * ((n + 511) / 512) * e;
    const uint32_t t2 = ((perExpert + 127) / 128) * ((n + 255) / 256) * e;
    const uint32_t est = t1 < t2 ? t1 : t2;
    if (est * 2 < blocks) {
      bm = 64;
      bn = 128;
    }
  }

  if (k <= 2048 && n > 256 && m < e * 32) {
    GmgTiling t{};
    t.e = e;
    t.m = m;
    t.k = k;
    t.n = n;
    t.bm = 64;
    t.bn = 512;
    t.blocks = blocks;
    uint32_t maxMTiles = (m + 63) / 64 + e - 1;
    if (maxMTiles > m) maxMTiles = m;
    uint32_t maxTasks = maxMTiles * ((n + 511) / 512);
    if (blocks > maxTasks) blocks = maxTasks;
    t.blocks = blocks;
    t.reserved = 0x00080000U;
    matmul_tiling::MatmulApiTiling api(*p);
    api.SetAType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND, matmul_tiling::DataType::DT_INT8, false);
    api.SetBType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND, matmul_tiling::DataType::DT_INT8, false);
    api.SetCType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND, matmul_tiling::DataType::DT_INT32);
    api.SetShape(64, 512, k);
    api.SetOrgShape(m, n, k);
    api.SetBias(false);
    api.SetFixSplit(64, 512, 128);
    if (api.GetTiling(t.cube) != 0) return -2;
    std::memcpy(dst, &t, sizeof(t));
    return 0;
  }

  if (bn == 128 && n <= bn && n % 32 != 0 && k >= 256) bm = 32;

  uint32_t maxMTiles = (m + bm - 1) / bm + e - 1;
  if (maxMTiles > m) maxMTiles = m;
  uint32_t maxTasks = maxMTiles * ((n + bn - 1) / bn);
  uint32_t kParts = 1, innerK = k;

  if (bn == 64 && k >= 2048 && (n % 32 != 0 || k >= 4096) && maxTasks <= blocks / 2) {
    kParts = blocks / maxTasks;
    uint32_t maxParts = k / 1024;
    if (kParts > maxParts) kParts = maxParts;
    innerK = ((k + kParts - 1) / kParts + 31) / 32 * 32;
    kParts = (k + innerK - 1) / innerK;
    blocks = maxTasks * kParts;
  } else if (blocks > maxTasks)
    blocks = maxTasks;
  GmgTiling t{};
  t.e = e;
  t.m = m;
  t.k = k;
  t.n = n;
  t.bm = bm;
  t.bn = bn;
  t.blocks = blocks;

  uint32_t minTasks = ((m + bm - 1) / bm) * ((n + bn - 1) / bn);
  bool reuse = ((bn == 256 && k <= 1024 && ((k > 128 && minTasks >= blocks * 2) || n % 32 == 0 || n % 32 > 16)) ||
                 (bn == 64 && n % 32 == 0 && k <= 4096 && (n < bn || k % 128 != 0))) &&
    m >= e * 128 && maxTasks >= blocks * 2;
  bool direct = !reuse && kParts == 1 &&
    ((bm == 64 && bn == 256 && k % 128 == 0 && n % 32 == 0 && k <= 2048) || (bn == 64 && k >= 256) ||
      (bm == 32 && bn == 128 && n <= bn && n % 32 != 0 && k >= 256));

  if (direct && bm == 64 && bn == 256 && m >= e * 128 && ((m + 127) / 128) * ((n + 255) / 256) >= blocks * 2) {
    t.bm = 128;
    t.reserved = 0x02000000U;
    std::memcpy(dst, &t, sizeof(t));
    return 0;
  }
  bool general = !reuse && !direct && bm == 64 && bn == 256 && k <= 2048;

  // Moderate-K, wide-N groups that do not fill an M128 tile use the
  // existing adaptive producer. Actual group lengths stay on the NPU.
  // The earlier short-group route and the resident/direct paths stay first.
  if (general && k > 1024 && n >= 768 && m <= e * 64) {
    t.bm = 64;
    t.bn = 512;
    t.reserved = 0x10000000U;
    std::memcpy(dst, &t, sizeof(t));
    return 0;
  }

  if (general && k > 1024 && n > 512 && (n % 512) >= 32 && m >= e * 64) {
    GmgTiling t{};
    t.e = e;
    t.m = m;
    t.k = k;
    t.n = n;
    t.bm = 64;
    t.bn = 512;
    t.blocks = blocks;
    uint32_t maxMTiles = (m + 63) / 64 + e - 1;
    if (maxMTiles > m) maxMTiles = m;
    uint32_t maxTasks = maxMTiles * ((n + 511) / 512);
    if (blocks > maxTasks) blocks = maxTasks;
    t.blocks = blocks;
    t.reserved = 0x00080000U;
    matmul_tiling::MatmulApiTiling api(*p);
    api.SetAType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND, matmul_tiling::DataType::DT_INT8, false);
    api.SetBType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND, matmul_tiling::DataType::DT_INT8, false);
    api.SetCType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND, matmul_tiling::DataType::DT_INT32);
    api.SetShape(64, 512, k);
    api.SetOrgShape(m, n, k);
    api.SetBias(false);
    api.SetFixSplit(64, 512, 128);
    if (api.GetTiling(t.cube) != 0) return -2;
    std::memcpy(dst, &t, sizeof(t));
    return 0;
  }

  if (general && m >= e * 16 && ((m + 127) / 128) * ((n + 255) / 256) * 2 >= blocks) {
    t.bm = 128;
    t.reserved = 0x00100000U;
    std::memcpy(dst, &t, sizeof(t));
    return 0;
  }

  bool wordMid = direct && bn == 128 && k >= 384;

  bool safeTail = !reuse && !direct && !general && kParts == 1 && ((bm == 64 && bn == 256) || (n % 32 && n % 32 <= 16));

  if (safeTail && bm == 64 && bn == 256 && m >= e * 64 && ((m + 127) / 128) * ((n + 255) / 256) * 2 >= blocks) {
    t.bm = 128;
    t.reserved = 0x00800000U;
    std::memcpy(dst, &t, sizeof(t));
    return 0;
  }

  if (safeTail && bm == 64 && bn == 256 && k > 4096 && n >= 512) {
    t.bn = 512;
    t.reserved = n >= 768 ? 0x10000000U : 0x00020000U;
    std::memcpy(dst, &t, sizeof(t));
    return 0;
  }

  if (safeTail && bm == 64 && bn == 256 && k > 2048 && k <= 4096) {

    if (n >= 512 && maxMTiles * ((n + 511) / 512) >= blocks) {
      t.bn = 512;
      t.reserved = 0x00080000U;
      std::memcpy(dst, &t, sizeof(t));
      return 0;
    }
    t.reserved = 0x00400000U;
    std::memcpy(dst, &t, sizeof(t));
    return 0;
  }

  if (direct && bm == 64 && bn == 256 && n >= 512 && k >= 8 * bm && ((m + bm - 1) / bm) * ((n + 511) / 512) >= blocks) {
    t.bn = 512;
    t.reserved = 0x01000000U;
    std::memcpy(dst, &t, sizeof(t));
    return 0;
  }
  t.reserved = safeTail ? 0x04000000U : (wordMid ? 0x08000000U : (general ? 0x20000000U : (direct ? 0x80000000U : (kParts > 1 ? kParts : (reuse ? 1 : 0)))));
  matmul_tiling::MatmulApiTiling api(*p);

  api.SetMatmulConfigParams(reuse || (bn == 64 && n >= 16 && n % 32 != 0 && k >= 1024) ? 1 : 0);
  api.SetAType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND, matmul_tiling::DataType::DT_INT8, false);
  api.SetBType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND, matmul_tiling::DataType::DT_INT8, false);
  api.SetCType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND, matmul_tiling::DataType::DT_INT32);
  api.SetShape(reuse ? ((maxTasks + blocks - 1) / blocks) * bm : bm, bn, innerK);
  api.SetOrgShape(reuse ? m : bm, n, k);
  api.SetBias(false);
  api.SetFixSplit(bm, bn, 128);
  if (api.GetTiling(t.cube) != 0) return -2;
  if (t.cube.baseM != bm || t.cube.baseN != bn) return -3;
  if (reuse) {

    uint32_t steps = (k + t.cube.baseK - 1) / t.cube.baseK;
    t.cube.stepM = 1;
    t.cube.stepN = 1;
    t.cube.stepKa = steps;
    t.cube.stepKb = steps;
    t.cube.depthA1 = 2 * steps;
    t.cube.depthB1 = steps;
    t.cube.shareL1Size = (2 * bm + bn) * steps * t.cube.baseK;
    if (t.cube.shareL1Size > 524288) return -4;
  }
  std::memcpy(dst, &t, sizeof(t));
  return 0;
}
extern "C" int gmg_make_tiling(void *dst, uint32_t e, uint32_t m, uint32_t k, uint32_t n, uint32_t bm, uint32_t bn, uint32_t blocks) {
  int status = gmg_make_tiling_base(dst, e, m, k, n, bm, bn, blocks);
  if (status) return status;
  auto &t = *static_cast<GmgTiling *>(dst);

  if (t.reserved == 0x80000000U && t.bm == 64 && t.bn == 256)
    t.reserved = 0x00002000U;
  else if (t.reserved == 0x01000000U)
    t.reserved = 0x00004000U;

  if (t.reserved == 0x02000000U && 2 * (t.bm * t.k + t.bn * 512) > 524288) t.reserved = 0x00008000U;
  if (t.reserved == 1U && t.bn == 256 && t.k > 128 && ((t.m + t.bm - 1) / t.bm) * ((t.n + t.bn - 1) / t.bn) >= t.blocks * 2) t.reserved = 0x00001001U;
  // The resident producer supports a partial N256 panel. At N128 it
  // retains B across M tiles without the generic Matmul control path.
  if (t.reserved == 0U && t.bn == 128 && n == 128 && k >= 512 && k <= 1024 && k % 128 == 0) {
    uint32_t maxRows = (m + 63) / 64 + e - 1;
    if (maxRows > m) maxRows = m;
    const uint32_t residentBlocks = t.blocks < maxRows ? t.blocks : maxRows;
    const uint64_t minTiles = (m + 63) / 64;
    // Contiguous M runs plus ownership cuts and conservative N64 tail splits.
    const uint64_t maxBStarts = e + residentBlocks + residentBlocks / 2 - 1;
    const uint64_t savedB = minTiles > maxBStarts ? (minTiles - maxBStarts) * k * n : 0;
    const uint64_t savedBridge = uint64_t(m) * n * 4;
    const uint64_t newClear = uint64_t(residentBlocks) * 64 * 256 * 2 * 2;
    if (minTiles > maxBStarts && savedB + savedBridge >= newClear) {
      t.bm = 64;
      t.bn = 256;
      t.blocks = residentBlocks;
      t.reserved = 0x00001001U;
    }
  }
  // A whole M128 activation tile fits the 256 KiB A1 arena through K2048.
  // At least 64 rows per metadata group amortize the retained-A panel walk.
  // Actual ragged and empty group lengths are consumed only on the NPU.
  if ((t.reserved == 0x00080000U || t.reserved == 0x00100000U) && t.k > 1024 && t.k <= 2048 && t.n > 512 && t.m >= 64 * t.e) {
    t.bm = 128;
    t.bn = 256;
    t.reserved = 0x00000400U;
  }
  if (t.k > 1024 && t.k <= 2048 && t.n >= 1024 && uint64_t(t.m) >= uint64_t(t.e) * 512) {
    t.bm = 128;
    t.bn = 256;
    t.reserved = 0x00000100U;
  }
  return 0;
}
extern "C" uint64_t gmg_tiling_size() { return sizeof(GmgTiling); }
extern "C" uint64_t gmg_workspace_size(const void *metadata) {
  const auto &t = *static_cast<const GmgTiling *>(metadata);
  if (t.reserved == 0x00000400U) return uint64_t(t.blocks) * 128 * 256 * 2 * 2;
  if (t.reserved == 0x00008000U && t.k <= 2048 && t.k % 128 == 0 && !(t.n % 256 && (t.n + 255) / 256 > 1 && t.blocks % ((t.n + 255) / 256) == 0))
    return uint64_t(t.blocks) * 128 * 256 * 2 * 2;
  if (t.reserved == 0x00001001U) return uint64_t(t.blocks) * 64 * 256 * 2 * 2;
  if (t.reserved == 0x00010000U || t.reserved == 0x00001008U || t.reserved == 0x00001009U) return 0;
  if (t.reserved == 0x00000100U) return uint64_t(t.blocks) * (128 * 256 * 2 * 4 + ((t.k + 511) / 512 * 512) * 256);
  uint64_t bytes = uint64_t(t.blocks) * t.bm * t.bn * 4;
  if (t.reserved == 0x00002000U || (t.reserved & 0xffffU) == 0x4000U || t.reserved == 0x00008000U || t.reserved == 0x10000000U || t.reserved == 0x01000000U ||
    t.reserved == 0x02000000U || t.reserved == 0x00800000U || t.reserved == 0x00100000U || t.reserved == 0x00080000U || t.reserved == 0x00040000U ||
    t.reserved == 0x00020000U || t.reserved == 1U || (t.reserved == 0x80000000U && t.bm == 64 && t.bn == 256))
    bytes *= 2;
  if (t.reserved == 0x10000000U && t.n % 512 == 0 && ((uint64_t(t.m) + 63) / 64 + t.e - 1) * (t.n / 512) > 2 * uint64_t(t.blocks))
    bytes += uint64_t(t.blocks) * t.bm * t.bn * 4;
  if (t.reserved == 0x08000000U || ((t.reserved == 0x80000000U || (t.reserved > 1 && t.reserved <= 8)) && t.bn == 64 && t.k >= 256 && t.n % 32 != 0))
    bytes += uint64_t(t.blocks) * ((t.k + 511) / 512 * 512) * ((t.n + 31) / 32 * 32);
  if (t.reserved == 0x00040000U) bytes += uint64_t(t.blocks) * ((t.k + 255) / 256 * 256) * 32;
  return bytes;
}
extern "C" uint32_t gmg_tile_m() { return BM; }
extern "C" uint32_t gmg_tile_n() { return BN; }

inline bool GmgHybridTailMetadata(const GmgTiling &t) {
  const uint32_t tail = t.n % 512;
  return tail && tail <= 128 && t.m > 64 * t.e;
}
inline bool GmgTallRotatePanels(const GmgTiling &t) {
  const uint32_t panels = (t.n + 255) / 256;
  return t.reserved == 0x00008000U && panels > 1 && t.n % 256 && t.blocks % panels == 0;
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo &info_x, GM_ADDR weight, const TensorGroupInfo &info_weight, GM_ADDR scale,
  const TensorGroupInfo &info_scale, GM_ADDR group_list, const TensorGroupInfo &info_group_list, GM_ADDR y, const TensorGroupInfo &info_y,
  int64_t availableCoreNum, aclrtStream stream) {
  const auto &xi = info_x.tensors[0];
  const auto &wi = info_weight.tensors[0];
  int64_t m = xi.shape[0], k = xi.shape[1], e = wi.shape[0], n = wi.shape[2];
  uint32_t blocks = static_cast<uint32_t>(availableCoreNum);
  auto *platform = platform_ascendc::PlatformAscendCManager::GetInstance(aclrtGetSocName());
  if (blocks > platform->GetCoreNumAic()) blocks = platform->GetCoreNumAic();
  GmgTiling t{};
  gmg_make_tiling(&t, e, m, k, n, BM, BN, blocks);
  blocks = t.blocks;
  void *workspace = nullptr;
  if ((t.n != 1 || t.reserved == 0x00040000U) && t.reserved != 0x40000000U && t.reserved != 0x00010000U && t.reserved != 0x00001008U &&
    t.reserved != 0x00001009U)
    aclrtMalloc(&workspace, gmg_workspace_size(&t), ACL_MEM_MALLOC_HUGE_FIRST);

  if (t.reserved == 0x00001009U)
    groupmatmulgelu_outer185<<<blocks, nullptr, stream>>>(x, weight, scale, group_list, y, (GM_ADDR)workspace, t);
  else if (t.reserved == 0x00001008U)
    groupmatmulgelu_narrow_dense172<<<blocks, nullptr, stream>>>(x, weight, scale, group_list, y, (GM_ADDR)workspace, t);
  else if (t.reserved == 0x00001001U)
    groupmatmulgelu_wide_reuse<<<blocks, nullptr, stream>>>(x, weight, scale, group_list, y, (GM_ADDR)workspace, t);
  else if ((t.reserved & 0xffffff00U) == 0x00000800U)
    groupmatmulgelu_underfill_split99<<<blocks, nullptr, stream>>>(x, weight, scale, group_list, y, (GM_ADDR)workspace, t);
  else if (t.reserved == 0x00000200U) {
    if (t.bm == 64)
      groupmatmulgelu_n128_long64<<<blocks, nullptr, stream>>>(x, weight, scale, group_list, y, (GM_ADDR)workspace, t);
    else
      groupmatmulgelu_n128_long32<<<blocks, nullptr, stream>>>(x, weight, scale, group_list, y, (GM_ADDR)workspace, t);
  } else if (t.reserved == 0x00000100U)
    groupmatmulgelu_first_use_nz<<<blocks, nullptr, stream>>>(x, weight, scale, group_list, y, (GM_ADDR)workspace, t);
  else if (t.reserved == 0x00010000U)
    groupmatmulgelu_thin_vec742<<<blocks, nullptr, stream>>>(x, weight, scale, group_list, y, (GM_ADDR)workspace, t);
  else if (t.n == 32 && t.bm == 32 && t.bn == 64 && t.reserved == 0x80000000U)
    groupmatmulgelu_identity32_full<<<blocks, nullptr, stream>>>(x, weight, scale, group_list, y, (GM_ADDR)workspace, t);
  else if (t.n == 32 && t.bm == 32 && t.bn == 64 && t.reserved > 1 && t.reserved <= 8)
    groupmatmulgelu_identity32_split<<<blocks, nullptr, stream>>>(x, weight, scale, group_list, y, (GM_ADDR)workspace, t);
  else if (t.reserved == 0x00040000U && t.k >= 512)
    groupmatmulgelu_gemv_k512<<<blocks, nullptr, stream>>>(x, weight, scale, group_list, y, (GM_ADDR)workspace, t);
  else if (t.reserved == 0x00040000U)
    groupmatmulgelu_gemv_cube<<<blocks, nullptr, stream>>>(x, weight, scale, group_list, y, (GM_ADDR)workspace, t);
  else if (t.reserved == 0x40000000U && t.k == 1 && t.m > t.e && !(t.n <= 16 && t.m <= t.blocks))
    groupmatmulgelu_shortvec<<<blocks, nullptr, stream>>>(x, weight, scale, group_list, y, (GM_ADDR)workspace, t);
  else if (t.n == 1 || t.reserved == 0x40000000U)
    groupmatmulgelu_gemv<<<blocks, nullptr, stream>>>(x, weight, scale, group_list, y, (GM_ADDR)workspace, t);
  else if (t.reserved == 0x2000U && t.k * t.bn <= 65536 && t.n % t.bn == 0)
    groupmatmulgelu_start_cube_legacyvec<<<blocks, nullptr, stream>>>(x, weight, scale, group_list, y, (GM_ADDR)workspace, t);
  else if (t.reserved == 0x2000U)
    groupmatmulgelu_start_cube<<<blocks, nullptr, stream>>>(x, weight, scale, group_list, y, (GM_ADDR)workspace, t);
  else if ((t.reserved & 0xffffU) == 0x4000U) {
    const uint32_t tail = t.n % 512;
    if (!tail)
      groupmatmulgelu_start_panel_reshape<<<blocks, nullptr, stream>>>(x, weight, scale, group_list, y, (GM_ADDR)workspace, t);
    else if (GmgHybridTailMetadata(t))
      groupmatmulgelu_ep_balanced_widetail<<<blocks, nullptr, stream>>>(x, weight, scale, group_list, y, (GM_ADDR)workspace, t);
    else if (tail <= 128)
      groupmatmulgelu_start_panel_narrowtail<<<blocks, nullptr, stream>>>(x, weight, scale, group_list, y, (GM_ADDR)workspace, t);
    else if (t.k > 1024 && tail > 128 && tail <= 256)
      groupmatmulgelu_start_panel_longtail<<<blocks, nullptr, stream>>>(x, weight, scale, group_list, y, (GM_ADDR)workspace, t);
    else
      groupmatmulgelu_start_panel<<<blocks, nullptr, stream>>>(x, weight, scale, group_list, y, (GM_ADDR)workspace, t);
  } else if (GmgTallRotatePanels(t))
    groupmatmulgelu_ep_tall_rotated<<<blocks, nullptr, stream>>>(x, weight, scale, group_list, y, (GM_ADDR)workspace, t);
  else if (t.reserved == 0x00000400U || (t.reserved == 0x8000U && t.k <= 2048 && t.k % 128 == 0))
    groupmatmulgelu_combined_tall<<<blocks, nullptr, stream>>>(x, weight, scale, group_list, y, (GM_ADDR)workspace, t);
  else if (t.reserved == 0x8000U)
    groupmatmulgelu_ep_tall<<<blocks, nullptr, stream>>>(x, weight, scale, group_list, y, (GM_ADDR)workspace, t);
  else if (t.reserved == 0x10000000U) {
    // Preserve adaptive geometry without long-K residual scheduling.
    if (t.k <= 2048)
      groupmatmulgelu_longflex<<<blocks, nullptr, stream>>>(x, weight, scale, group_list, y, (GM_ADDR)workspace, t);
    else if (t.n % 512)
      groupmatmulgelu_longflex_ragged<<<blocks, nullptr, stream>>>(x, weight, scale, group_list, y, (GM_ADDR)workspace, t);
    else
      groupmatmulgelu_longflex_residual<<<blocks, nullptr, stream>>>(x, weight, scale, group_list, y, (GM_ADDR)workspace, t);
  } else if (t.reserved == 0x00020000U)
    groupmatmulgelu_longwide<<<blocks, nullptr, stream>>>(x, weight, scale, group_list, y, (GM_ADDR)workspace, t);
  else if (t.reserved == 0x01000000U)
    groupmatmulgelu_panel512<<<blocks, nullptr, stream>>>(x, weight, scale, group_list, y, (GM_ADDR)workspace, t);
  else if (t.reserved == 0x00080000U)
    groupmatmulgelu_wide512<<<blocks, nullptr, stream>>>(x, weight, scale, group_list, y, (GM_ADDR)workspace, t);
  else if (t.reserved == 0x00100000U)
    groupmatmulgelu_talltail<<<blocks, nullptr, stream>>>(x, weight, scale, group_list, y, (GM_ADDR)workspace, t);
  else if (t.reserved == 0x00400000U)
    groupmatmulgelu_wholea<<<blocks, nullptr, stream>>>(x, weight, scale, group_list, y, (GM_ADDR)workspace, t);
  else if (t.reserved == 0x00800000U)
    groupmatmulgelu_streamtall<<<blocks, nullptr, stream>>>(x, weight, scale, group_list, y, (GM_ADDR)workspace, t);
  else if (t.reserved == 0x02000000U)
    groupmatmulgelu_tall<<<blocks, nullptr, stream>>>(x, weight, scale, group_list, y, (GM_ADDR)workspace, t);
  else if (t.reserved == 0x20000000U)
    groupmatmulgelu_tail<<<blocks, nullptr, stream>>>(x, weight, scale, group_list, y, (GM_ADDR)workspace, t);
  else if (t.reserved == 0x08000000U)
    groupmatmulgelu_mid_packed<<<blocks, nullptr, stream>>>(x, weight, scale, group_list, y, (GM_ADDR)workspace, t);
  else if (t.reserved == 0x04000000U)
    groupmatmulgelu_safe<<<blocks, nullptr, stream>>>(x, weight, scale, group_list, y, (GM_ADDR)workspace, t);
  else if (t.reserved == 0x80000000U) {
    if (t.bn == 64) {
      if (t.n % 32 == 0)
        groupmatmulgelu_narrow_aligned<<<blocks, nullptr, stream>>>(x, weight, scale, group_list, y, (GM_ADDR)workspace, t);
      else
        groupmatmulgelu_narrow<<<blocks, nullptr, stream>>>(x, weight, scale, group_list, y, (GM_ADDR)workspace, t);
    } else if (t.bn == 128)
      groupmatmulgelu_mid<<<blocks, nullptr, stream>>>(x, weight, scale, group_list, y, (GM_ADDR)workspace, t);
    else
      groupmatmulgelu_cube<<<blocks, nullptr, stream>>>(x, weight, scale, group_list, y, (GM_ADDR)workspace, t);
  } else if (t.reserved > 1) {
    if (t.n % 32 == 0)
      groupmatmulgelu_splitk_aligned<<<blocks, nullptr, stream>>>(x, weight, scale, group_list, y, (GM_ADDR)workspace, t);
    else
      groupmatmulgelu_splitk<<<blocks, nullptr, stream>>>(x, weight, scale, group_list, y, (GM_ADDR)workspace, t);
  } else if (t.reserved == 1) {
    if (t.bn == 64)
      groupmatmulgelu_narrow_reuse<<<blocks, nullptr, stream>>>(x, weight, scale, group_list, y, (GM_ADDR)workspace, t);
    else if (t.k > 128 && ((t.m + t.bm - 1) / t.bm) * ((t.n + t.bn - 1) / t.bn) >= t.blocks * 2)
      groupmatmulgelu_wide_reuse<<<blocks, nullptr, stream>>>(x, weight, scale, group_list, y, (GM_ADDR)workspace, t);
    else
      groupmatmulgelu_reuse<<<blocks, nullptr, stream>>>(x, weight, scale, group_list, y, (GM_ADDR)workspace, t);
  } else if (t.bm == 32 && t.bn == 64) {
    if (t.n >= 16 && t.n % 32 != 0 && t.k >= 1024)
      groupmatmulgelu_dense_m32_n64_mdl<<<blocks, nullptr, stream>>>(x, weight, scale, group_list, y, (GM_ADDR)workspace, t);
    else
      groupmatmulgelu_dense_m32_n64<<<blocks, nullptr, stream>>>(x, weight, scale, group_list, y, (GM_ADDR)workspace, t);
  } else if (t.bm == 32 && t.bn == 128)
    groupmatmulgelu_dense_m32_n128<<<blocks, nullptr, stream>>>(x, weight, scale, group_list, y, (GM_ADDR)workspace, t);
  else if (t.bm == 64 && t.bn == 128)
    groupmatmulgelu_dense_m64_n128<<<blocks, nullptr, stream>>>(x, weight, scale, group_list, y, (GM_ADDR)workspace, t);
  else
    groupmatmulgelu_dense_m64_n256<<<blocks, nullptr, stream>>>(x, weight, scale, group_list, y, (GM_ADDR)workspace, t);
  aclrtSynchronizeStream(stream);
  if (workspace) aclrtFree(workspace);
}
