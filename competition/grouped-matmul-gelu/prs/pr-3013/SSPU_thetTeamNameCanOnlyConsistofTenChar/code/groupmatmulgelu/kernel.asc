#if !defined(GMG_SEPARATE_BUILD) || defined(GMG_BUILD_WIDE_REUSE)
// Atlas A2 panel pipeline. Reuse each actual panel over the old contiguous M run.
// Like a staged producer with a Fixpipe callback, retire only data already read
// by MTE1 and wait for the GM C credit only when publishing the complete tile.
struct GmgResidentTask632 {
  uint32_t expert, row, col, rows, cols;
};

class GmgResidentCursor632 {
public:
  __aicore__ inline void Init(AscendC::GlobalTensor<int64_t> groups, const GmgTiling &t, uint32_t core) {
    groups_ = groups;
    m_ = t.m;
    n_ = t.n;
    panels_ = (n_ + 255) / 256;
    expert_ = GmgFirstExpert(groups, t.e);
    uint32_t tiles = 0, before = 0;
    for (uint32_t e = expert_; e < t.e; ++e) {
      uint32_t end = groups.GetValue(e);
      tiles += ((end - before + 63) / 64) * panels_;
      before = end;
      if (end == m_) break;
    }
    index_ = tiles * core / t.blocks;
    stop_ = tiles * (core + 1) / t.blocks;
    const uint32_t remainder = tiles % t.blocks;
    if (remainder && 4 * remainder <= t.blocks) {
      stop_ = index_ + tiles / t.blocks;
      const uint32_t owner = ((core * remainder / t.blocks + 1) * t.blocks + remainder - 1) / remainder - 1;
      pendingTail_ = owner - core < 4;
      if (pendingTail_) {
        tailIndex_ = tiles * (owner + 1) / t.blocks - 1;
        tailPart_ = owner - core;
      }
    }
  }

  __aicore__ inline bool Next(GmgResidentTask632 &task) {
    if (index_ == stop_) {
      if (!pendingTail_) return false;
      index_ = tailIndex_;
      stop_ = tailIndex_ + 1;
      pendingTail_ = false;
      tailPhase_ = true;
    }
    while (index_ >= groupStop_) {
      begin_ = end_;
      base_ = groupStop_;
      owner_ = expert_++;
      end_ = groups_.GetValue(owner_);
      rowTiles_ = (end_ - begin_ + 63) / 64;
      groupStop_ += rowTiles_ * panels_;
    }
    const uint32_t local = index_++ - base_;
    const uint32_t r = begin_ + (local % rowTiles_) * 64;
    const uint32_t c = (local / rowTiles_) * 256;
    task = {owner_, r, c, end_ - r < 64 ? end_ - r : 64, n_ - c < 256 ? n_ - c : 256};
    if (tailPhase_) {
      const uint32_t delta = tailPart_ * 64;
      if (delta >= task.cols) return false;
      task.col += delta;
      task.cols = task.cols - delta < 64 ? task.cols - delta : 64;
    }
    return true;
  }

private:
  AscendC::GlobalTensor<int64_t> groups_;
  uint32_t m_, n_, panels_, index_, stop_, expert_, owner_, rowTiles_;
  uint32_t begin_ = 0, end_ = 0, base_ = 0, groupStop_ = 0;
  uint32_t tailIndex_ = 0, tailPart_ = 0;
  bool pendingTail_ = false, tailPhase_ = false;
};

#if defined(SPLIT_CORE_CUBE)
class GmgResidentPanel632 {
public:
  __aicore__ inline void Init(AscendC::TPipe &pipe, GM_ADDR x, GM_ADDR w, uint32_t k, uint32_t n) {
    using namespace AscendC;
    k_ = k;
    n_ = n;
    paddedK_ = (k + 127) / 128 * 128;
    x_.SetGlobalBuffer((__gm__ int8_t *)x);
    w_.SetGlobalBuffer((__gm__ int8_t *)w);
    pipe.InitBuffer(a1_, 2, 64 * 1024);
    pipe.InitBuffer(bFirst_, 512 * 256);
    pipe.InitBuffer(bSecond_, 512 * 256);
    pipe.InitBuffer(a2_, 2, 64 * 512);
    pipe.InitBuffer(b2_, 2, 128 * 256);
    pipe.InitBuffer(c1_, 1, 64 * 256 * 4);
    for (uint32_t i = 0; i < Bands(); ++i) {
      ready_[i] = pipe.AllocEventID<HardEvent::MTE2_MTE1>();
      retire_[i] = pipe.AllocEventID<HardEvent::MTE1_MTE2>();
    }
  }

  __aicore__ inline void Prime(const GmgResidentTask632 &first) {
    CopyB<0>(first);
    CopyA(first);
    if (Bands() == 2) CopyB<1>(first);
  }

  __aicore__ inline void Produce(
    const GmgResidentTask632 &current, const GmgResidentTask632 &next, bool hasNext, bool reuseCredit, AscendC::GlobalTensor<half> dst) {
    using namespace AscendC;
    const bool changePanel = hasNext && (next.expert != current.expert || next.col != current.col);
    const uint32_t paddedM = (current.rows + 15) / 16 * 16;
    const uint32_t paddedN = (current.cols + 31) / 32 * 32;
    auto a = a1_.DeQue<int8_t>();
    auto c = c1_.AllocTensor<int32_t>();
    if (paddedN <= 64) {
      ConsumeNarrow<0>(a, c, paddedM, paddedN, next, hasNext, changePanel);
      if (Bands() == 2) ConsumeNarrow<1>(a, c, paddedM, paddedN, next, hasNext, changePanel);
    } else {
      Consume<0>(a, c, paddedM, paddedN, next, hasNext, changePanel);
      if (Bands() == 2) Consume<1>(a, c, paddedM, paddedN, next, hasNext, changePanel);
    }
    a1_.FreeTensor(a);
    c1_.EnQue(c);
    c = c1_.DeQue<int32_t>();
    FixpipeParamsV220 fix{};
    fix.nSize = paddedN;
    fix.mSize = current.rows;
    fix.srcStride = paddedM;
    fix.dstStride = 256;
    const uint32_t exponent = 31U - __builtin_clz(k_ - 1);
    fix.quantPre = QuantMode_t::DEQF16;
    fix.deqScalar = uint64_t((127U - exponent) << 23);
    // Inputs/L0C can run while the original GM C initialization completes.
    if (!reuseCredit) CrossCoreWaitFlag<2>(2);
    Fixpipe<half, int32_t, CFG_ROW_MAJOR>(dst, c, fix);
    c1_.FreeTensor(c);
    CrossCoreSetFlag<2, PIPE_FIX>(0);
    if (reuseCredit) CrossCoreWaitFlag<2>(1);
    fresh_ = changePanel;
  }

  __aicore__ inline void End(AscendC::TPipe &pipe) {
    using namespace AscendC;
    for (uint32_t i = 0; i < Bands(); ++i) {
      pipe.ReleaseEventID<HardEvent::MTE2_MTE1>(ready_[i]);
      pipe.ReleaseEventID<HardEvent::MTE1_MTE2>(retire_[i]);
    }
  }

private:
  __aicore__ inline uint32_t Bands() const { return k_ > 512 ? 2 : 1; }

  template <uint32_t Band> __aicore__ inline uint32_t PaddedBandK() const {
    if constexpr (Band == 0)
      return paddedK_ > 512 ? 512 : paddedK_;
    else
      return paddedK_ - 512;
  }

  template <uint32_t Band> __aicore__ inline AscendC::LocalTensor<int8_t> BBuffer() {
    if constexpr (Band == 0)
      return bFirst_.Get<int8_t>();
    else
      return bSecond_.Get<int8_t>();
  }

  __aicore__ inline void CopyA(const GmgResidentTask632 &task) {
    using namespace AscendC;
    auto a = a1_.AllocTensor<int8_t>();
    const uint32_t pm = (task.rows + 15) / 16 * 16;
    if (task.rows != pm || k_ != paddedK_) {
      InitConstValue(a.ReinterpretCast<uint32_t>(), InitConstValueParams<uint32_t>{1, uint16_t(pm * paddedK_ / 32), 0, 0});
      PipeBarrier<PIPE_MTE2>();
    }
    Nd2NzParams p{};
    p.ndNum = 1;
    p.nValue = task.rows;
    p.dValue = k_;
    p.srcDValue = k_;
    p.dstNzC0Stride = pm;
    p.dstNzNStride = 1;
    DataCopy(a, x_[uint64_t(task.row) * k_], p);
    a1_.EnQue(a);
  }

  template <uint32_t Band> __aicore__ inline void CopyB(const GmgResidentTask632 &task) {
    using namespace AscendC;
    const uint32_t pk = PaddedBandK<Band>();
    const uint32_t realK = k_ - Band * 512 < pk ? k_ - Band * 512 : pk;
    LocalTensor<int8_t> b = BBuffer<Band>();
    if (realK != pk) {
      const uint32_t pn = (task.cols + 31) / 32 * 32;
      InitConstValue(b.ReinterpretCast<uint32_t>(), InitConstValueParams<uint32_t>{1, uint16_t(pk * pn / 32), 0, 0});
      PipeBarrier<PIPE_MTE2>();
    }
    Nd2NzParams p{};
    p.ndNum = 1;
    p.nValue = realK;
    p.dValue = task.cols;
    p.srcDValue = n_;
    p.dstNzC0Stride = pk;
    p.dstNzNStride = 1;
    const uint64_t offset = (uint64_t(task.expert) * k_ + Band * 512) * n_ + task.col;
    DataCopy(b, w_[offset], p);
    SetFlag<HardEvent::MTE2_MTE1>(static_cast<event_t>(ready_[Band]));
  }

  template <uint32_t Band>
  __aicore__ inline void Consume(
    AscendC::LocalTensor<int8_t> a, AscendC::LocalTensor<int32_t> c, uint32_t pm, uint32_t pn, const GmgResidentTask632 &next, bool hasNext, bool changePanel) {
    using namespace AscendC;
    const uint32_t pk = PaddedBandK<Band>();
    const LocalTensor<int8_t> b = BBuffer<Band>();
    if (fresh_) WaitFlag<HardEvent::MTE2_MTE1>(static_cast<event_t>(ready_[Band]));
    for (uint32_t inner = 0; inner < pk; inner += 128) {
      auto a2 = a2_.AllocTensor<int8_t>();
      auto b2 = b2_.AllocTensor<int8_t>();
      LoadData2dParams al{};
      al.repeatTimes = 4;
      al.srcStride = pm / 16;
      for (uint32_t row = 0; row < pm; row += 16) LoadData(a2[row * 128], a[(Band * 512 + inner) * pm + row * 32], al);
      LoadData2dTransposeParams bl{};
      bl.repeatTimes = pn / 32;
      bl.srcStride = pk / 32;
      bl.dstGap = 1;
      for (uint32_t kk = 0; kk < 128; kk += 32) LoadDataWithTranspose(b2[kk * pn], b[(inner + kk) * 32], bl);

      // The old band's final consumer has issued all of its L1 reads.
      // MTE2 can refill only after those reads; MMAD uses L0B from here on.
      if (changePanel && inner + 128 == pk) {
        auto event = static_cast<event_t>(retire_[Band]);
        SetFlag<HardEvent::MTE1_MTE2>(event);
        WaitFlag<HardEvent::MTE1_MTE2>(event);
        CopyB<Band>(next);
      }
      a2_.EnQue(a2);
      b2_.EnQue(b2);
      a2 = a2_.DeQue<int8_t>();
      b2 = b2_.DeQue<int8_t>();
      MmadParams mad{};
      mad.m = pm;
      mad.n = pn;
      mad.k = 128;
      mad.cmatrixInitVal = Band == 0 && inner == 0;
      Mmad(c, a2, b2, mad);
      if constexpr (Band == 0)
        if (inner == 0 && hasNext) CopyA(next);
      PipeBarrier<PIPE_M>();
      a2_.FreeTensor(a2);
      b2_.FreeTensor(b2);
    }
  }

  template <uint32_t Band>
  __aicore__ inline void ConsumeNarrow(
    AscendC::LocalTensor<int8_t> a, AscendC::LocalTensor<int32_t> c, uint32_t pm, uint32_t pn, const GmgResidentTask632 &next, bool hasNext, bool changePanel) {
    using namespace AscendC;
    const uint32_t pk = PaddedBandK<Band>();
    const LocalTensor<int8_t> b = BBuffer<Band>();
    if (fresh_) WaitFlag<HardEvent::MTE2_MTE1>(static_cast<event_t>(ready_[Band]));
    {
      const uint32_t inner = 0, innerK = pk;
      auto a2 = a2_.AllocTensor<int8_t>();
      auto b2 = b2_.AllocTensor<int8_t>();
      LoadData2dParams al{};
      al.repeatTimes = innerK / 32;
      al.srcStride = pm / 16;
      for (uint32_t row = 0; row < pm; row += 16) LoadData(a2[row * innerK], a[(Band * 512 + inner) * pm + row * 32], al);
      LoadData2dTransposeParams bl{};
      bl.repeatTimes = pn / 32;
      bl.srcStride = pk / 32;
      bl.dstGap = 1;
      for (uint32_t kk = 0; kk < innerK; kk += 32) LoadDataWithTranspose(b2[kk * pn], b[(inner + kk) * 32], bl);

      // The old band's final consumer has issued all of its L1 reads.
      // MTE2 can refill only after those reads; MMAD uses L0B from here on.
      if (changePanel) {
        auto event = static_cast<event_t>(retire_[Band]);
        SetFlag<HardEvent::MTE1_MTE2>(event);
        WaitFlag<HardEvent::MTE1_MTE2>(event);
        CopyB<Band>(next);
      }
      a2_.EnQue(a2);
      b2_.EnQue(b2);
      a2 = a2_.DeQue<int8_t>();
      b2 = b2_.DeQue<int8_t>();
      MmadParams mad{};
      mad.m = pm;
      mad.n = pn;
      mad.k = innerK;
      mad.cmatrixInitVal = Band == 0;
      Mmad(c, a2, b2, mad);
      if constexpr (Band == 0)
        if (hasNext) CopyA(next);
      PipeBarrier<PIPE_M>();
      a2_.FreeTensor(a2);
      b2_.FreeTensor(b2);
    }
  }

  AscendC::GlobalTensor<int8_t> x_, w_;
  AscendC::TQue<AscendC::TPosition::A1, 2> a1_;
  AscendC::TBuf<AscendC::TPosition::B1> bFirst_, bSecond_;
  AscendC::TQue<AscendC::TPosition::A2, 2> a2_;
  AscendC::TQue<AscendC::TPosition::B2, 2> b2_;
  AscendC::TQue<AscendC::TPosition::CO1, 1> c1_;
  AscendC::TEventID ready_[2], retire_[2];
  uint32_t k_, n_, paddedK_;
  bool fresh_ = true;
};

__aicore__ inline void GmgResidentMain632(GM_ADDR x, GM_ADDR w, GM_ADDR groups, GM_ADDR workspace, const GmgTiling &t) {
  using namespace AscendC;
  TPipe pipe;
  const uint32_t core = GetBlockIdx() / GetTaskRation();
  GmgResidentPanel632 cube;
  cube.Init(pipe, x, w, t.k, t.n);
  GlobalTensor<int64_t> gg;
  gg.SetGlobalBuffer((__gm__ int64_t *)groups);
  GmgResidentCursor632 cursor;
  cursor.Init(gg, t, core);
  GmgResidentTask632 cur{}, next{};
  if (cursor.Next(cur)) {
    GlobalTensor<half> cg;
    cg.SetGlobalBuffer((__gm__ half *)workspace + core * 64 * 256 * 2);
    cube.Prime(cur);
    bool reuse = false;
    uint32_t bank = 0;
    for (;;) {
      const bool hasNext = cursor.Next(next);
      cube.Produce(cur, next, hasNext, reuse, bank == 0 ? cg : cg[64 * 256]);
      bank ^= 1;
      if (!hasNext) break;
      cur = next;
      reuse = true;
    }
    CrossCoreWaitFlag<2>(1);
  } else
    CrossCoreWaitFlag<2>(2);
  cube.End(pipe);
}
#endif

__aicore__ inline void GmgResidentVectorHTR(GM_ADDR scale, GM_ADDR groups, GM_ADDR y, GM_ADDR workspace, const GmgTiling &t) {
#if defined(SPLIT_CORE_VEC)
  using namespace AscendC;
  constexpr uint32_t SIZE = 64 * 256, HALF_SIZE = SIZE / 2;
  const uint32_t core = GetBlockIdx() / GetTaskRation(), sub = GetSubBlockIdx();
  TPipe pipe;
  TBuf<TPosition::VECCALC> ab, zb, ub, vb, pb, sb, hb, mb, nb;
  pipe.InitBuffer(ab, HALF_SIZE * 4 + 256);
  pipe.InitBuffer(zb, HALF_SIZE * 4 + 256);
  pipe.InitBuffer(ub, HALF_SIZE * 4 + 256);
  pipe.InitBuffer(vb, HALF_SIZE * 4 + 256);
  pipe.InitBuffer(pb, HALF_SIZE * 4 + 256);
  pipe.InitBuffer(sb, 256 * 4 + 256);
  pipe.InitBuffer(hb, HALF_SIZE * 2 + 256);
  pipe.InitBuffer(mb, HALF_SIZE / 8 + 256);
  pipe.InitBuffer(nb, HALF_SIZE / 8 + 256);
  auto a = ab.Get<int32_t>();
  auto z = zb.Get<float>();
  auto u = ub.Get<float>();
  auto v = vb.Get<float>();
  auto p = pb.Get<float>();
  auto s = sb.Get<float>();
  auto h = hb.Get<half>();
  auto m1 = mb.Get<uint8_t>();
  auto m2 = nb.Get<uint8_t>();
  GlobalTensor<int64_t> gg;
  GlobalTensor<float> sg;
  GlobalTensor<half> yg;
  GlobalTensor<half> cg;
  gg.SetGlobalBuffer((__gm__ int64_t *)groups);
  sg.SetGlobalBuffer((__gm__ float *)scale);
  yg.SetGlobalBuffer((__gm__ half *)y);
  cg.SetGlobalBuffer((__gm__ half *)workspace + core * SIZE * 2);
  Duplicate(a, int32_t(0), HALF_SIZE);
  SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
  WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
  DataCopy(cg[sub * HALF_SIZE], a.ReinterpretCast<half>(), HALF_SIZE);
  DataCopy(cg[SIZE + sub * HALF_SIZE], a.ReinterpretCast<half>(), HALF_SIZE);
  SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
  WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
  CrossCoreSetFlag<2, PIPE_MTE3>(2);
  if (t.n % 256) {
    Duplicate(s, 0.0f, 256);
    SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
    WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
  }
  GmgResidentCursor632 cursor;
  cursor.Init(gg, t, core);
  GmgResidentTask632 task{};
  uint32_t bank = 0;
  while (cursor.Next(task)) {
    const uint32_t vr = (task.rows + 1) / 2, offset = sub * vr;
    const uint32_t rows = task.rows > offset ? (task.rows - offset < vr ? task.rows - offset : vr) : 0;
    const uint32_t cols = task.cols, cw = (cols + 63) / 64 * 64;
    if (rows) DataCopyPad(s, sg[uint64_t(task.expert) * t.n + task.col], DataCopyExtParams{1, cols * 4, 0, 0, 0}, DataCopyPadExtParams<float>{true, 0, 0, 0});
    CrossCoreWaitFlag<2>(0);
    if (rows) {
      if (cols == 256)
        DataCopy(a.ReinterpretCast<half>(), cg[bank * SIZE + offset * 256], rows * 256);
      else
        DataCopyPad(a.ReinterpretCast<half>(), cg[bank * SIZE + offset * 256],
          DataCopyExtParams{uint16_t(rows), cols * 2, (256 - cols) * 2, (cw - (cols + 15) / 16 * 16) / 16, 0}, DataCopyPadExtParams<half>{true, 0, 0, 0});
    }
    SetFlag<HardEvent::MTE2_S>(EVENT_ID0);
    WaitFlag<HardEvent::MTE2_S>(EVENT_ID0);
    CrossCoreSetFlag<2, PIPE_MTE2>(1);
    if (rows) {
      SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
      WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
      const uint32_t count = rows * cw;
      Cast(z, a.ReinterpretCast<half>(), RoundMode::CAST_NONE, count);
      const uint32_t exponent = 31U - __builtin_clz(t.k - 1);
      union {
        uint32_t u;
        float f;
      } restore;
      restore.u = (127U + exponent) << 23;
      Muls(s, s, restore.f, cw);
      for (uint32_t c = 0; c < cw; c += 64)
        Mul(z[c], z[c], s[c], uint64_t(64), uint8_t(rows), BinaryRepeatParams{1, 1, 1, uint8_t(cw / 8), uint8_t(cw / 8), 0});
      // Retain the original robust negative-subnormal screen and exact Q56.
      GmgGeluSmall<true, true, false, true, false>(z, h, u, v, p, a, m1, m2, count);
      SetFlag<HardEvent::S_MTE3>(EVENT_ID0);
      WaitFlag<HardEvent::S_MTE3>(EVENT_ID0);
      SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
      WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
      DataCopyPad(yg[uint64_t(task.row + offset) * t.n + task.col], h,
        DataCopyExtParams{uint16_t(rows), cols * 2, (cw - (cols + 15) / 16 * 16) / 16, (t.n - cols) * 2, 0});
      SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
      WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
    }
    bank ^= 1;
  }
#endif
}

extern "C" __global__ __mix__(1, 2) void groupmatmulgelu_wide_reuse(
  GM_ADDR x, GM_ADDR w, GM_ADDR scale, GM_ADDR groups, GM_ADDR y, GM_ADDR workspace, GmgTiling t) {
#if defined(SPLIT_CORE_CUBE)
  GmgResidentMain632(x, w, groups, workspace, t);
#else
  GmgResidentVectorHTR(scale, groups, y, workspace, t);
#endif
}
#endif

