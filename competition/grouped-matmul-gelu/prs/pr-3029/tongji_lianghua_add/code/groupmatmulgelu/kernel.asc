__global__ __vector__ void G43_T(
    GM_ADDR xAddress, GM_ADDR weightAddress, GM_ADDR scaleAddress,
    GM_ADDR groupAddress, GM_ADDR outputAddress, G43_N::qwy shape,
    uint32_t rowSpan) {
    using namespace AscendC;
    const uint32_t begin = GetBlockIdx() * rowSpan;
    if (begin >= shape.M) return;
    const uint32_t limit = begin + rowSpan < shape.M ? begin + rowSpan : shape.M;
    const uint32_t outputCount = (limit - begin) * shape.N;
    constexpr uint32_t count = 64;
    InitSocState();
    GlobalTensor<int8_t> x, weight;
    GlobalTensor<float> scale;
    GlobalTensor<int64_t> ends;
    GlobalTensor<half> output;
    x.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(xAddress));
    weight.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(weightAddress));
    scale.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scaleAddress));
    ends.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groupAddress));
    output.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(outputAddress));
    #if defined(__NPU_ARCH__) && __NPU_ARCH__ == 2201
    GM_ADDR cacheBases[4] = {xAddress, weightAddress, scaleAddress, groupAddress};
    #pragma unroll
    for (uint32_t i = 0; i < 4; ++i) {
        GlobalTensor<uint64_t> region;
        region.SetGlobalBuffer(reinterpret_cast<__gm__ uint64_t*>(cacheBases[i]));
        DataCachePreload(region, int16_t(0));
    }
    #endif
    constexpr uint32_t lanes = 64;
    LocalTensor<float> z(TPosition::VECCALC, 0, lanes);
    LocalTensor<float> magnitude(TPosition::VECCALC, lanes * sizeof(float), lanes);
    LocalTensor<float> scratch(TPosition::VECCALC, 2 * lanes * sizeof(float), lanes);
    LocalTensor<half> packed(TPosition::VECOUT, 3 * lanes * sizeof(float), lanes);
    Duplicate(z, 0.0f, lanes);
    SetFlag<HardEvent::V_S>(EVENT_ID0);
    WaitFlag<HardEvent::V_S>(EVENT_ID0);
    uint32_t expert = 0;
    uint32_t groupEnd = uint32_t(ends.GetValue(expert));

    uint32_t row = begin;
    while (row < limit) {
        while (row >= groupEnd && expert + 1 < shape.E)
            groupEnd = uint32_t(ends.GetValue(++expert));
        const bool pair = row + 1 < limit && row + 1 < groupEnd;
        int32_t first[4], second[4];
        #pragma unroll
        for (uint32_t k = 0; k < 4; ++k) {
            first[k] = k < shape.K ? int32_t(x.GetValue(row * shape.K + k)) : 0;
            second[k] = pair && k < shape.K ? int32_t(x.GetValue((row + 1) * shape.K + k)) : 0;
        }
        const uint32_t weightBase = expert * shape.K * shape.N;
        for (uint32_t col = 0; col < shape.N; ++col) {
            int32_t a = 0, b = 0;
            #pragma unroll
            for (uint32_t k = 0; k < 4; ++k) {
                if (k < shape.K) {
                    const int32_t w = int32_t(weight.GetValue(weightBase + k * shape.N + col));
                    a += first[k] * w;
                    if (pair) b += second[k] * w;
                }
            }
            const float coefficient = scale.GetValue(expert * shape.N + col);
            const uint32_t lane = (row - begin) * shape.N + col;
            z.SetValue(lane, float(a) * coefficient);
            if (pair) z.SetValue(lane + shape.N, float(b) * coefficient);
        }
        row += pair ? 2 : 1;
    }

    SetFlag<HardEvent::S_V>(EVENT_ID0);
    WaitFlag<HardEvent::S_V>(EVENT_ID0);
    Abs(magnitude, z, count);
    Maxs(z, z, 0.0f, count);
    PipeBarrier<PIPE_V>();
    Muls(scratch, magnitude, -0.41371995302807546f, count); PipeBarrier<PIPE_V>();
    Adds(scratch, scratch, -0.71010987362450362f, count); PipeBarrier<PIPE_V>();
    Mul(scratch, scratch, magnitude, count); PipeBarrier<PIPE_V>();
    Adds(scratch, scratch, -0.71449550291840846f, count); PipeBarrier<PIPE_V>();
    Exp(scratch, scratch, count); PipeBarrier<PIPE_V>();
    Mul(magnitude, magnitude, scratch, count); PipeBarrier<PIPE_V>();
    Sub(z, z, magnitude, count); PipeBarrier<PIPE_V>();
    Cast(packed, z, RoundMode::CAST_RINT, count);

    SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
    WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
    DataCopyPad(output[begin * shape.N], packed,
                DataCopyExtParams{1, outputCount * uint32_t(sizeof(half)), 0, 0, 0});
    SetFlag<HardEvent::MTE3_S>(EVENT_ID0);
    WaitFlag<HardEvent::MTE3_S>(EVENT_ID0);
}
