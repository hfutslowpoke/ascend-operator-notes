    }
    __aicore__ inline bool q5i(qds& tile) {
        if(!tailFirst)return fallback.q5i(tile);
        if(pending){tile=saved;tile.q3o=serial++;pending=false;return true;}
        if(wanted>=rows*pairs)return false;
        uint64_t rowIndex;
        uint32_t column;
