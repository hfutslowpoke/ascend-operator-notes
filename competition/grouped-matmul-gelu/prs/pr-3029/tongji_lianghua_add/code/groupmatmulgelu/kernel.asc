namespace expert_schedule {
// A logical-work prefix is implicit in cumulative group rows. Locating a
// core's range needs logarithmic group reads, not a private all-expert table.
// N uses physical 32-column units. M uses valid rows; padding/control cost is
// intentionally not included, so this is an alternative model, not an oracle.
template<int ColumnMajor,class Reader> class AreaPlan {
    Reader reader_;
    uint32_t experts_,columns_,rm_,cn_,nc_,physical_,expert_=0;
    uint32_t first_=0,last_=0,nr_=0,index_=0;
    uint64_t stop_=0;
    __aicore__ inline uint32_t Cols(uint32_t n) const {
        const uint32_t count=n*cn_;return count<physical_?count:physical_;
    }
    __aicore__ inline uint32_t Rows(uint32_t n) const {
        const uint32_t count=n*rm_,valid=last_-first_;return count<valid?count:valid;
    }
    __aicore__ inline uint64_t Prefix(uint32_t n) const {
        if constexpr(ColumnMajor){
            const uint32_t column=n/nr_,row=n%nr_;
            return uint64_t(last_-first_)*Cols(column)+uint64_t(Rows(row))*(Cols(column+1)-Cols(column));
        }else{
            const uint32_t row=n/nc_,column=n%nc_;
            return uint64_t(Rows(row))*physical_+uint64_t(Rows(row+1)-Rows(row))*Cols(column);
        }
    }
    __aicore__ inline void Open(uint32_t expert){
        expert_=expert;first_=expert?uint32_t(reader_.q2z(expert-1)):0;
        last_=uint32_t(reader_.q2z(expert));nr_=(last_-first_+rm_-1)/rm_;
    }
    __aicore__ inline uint64_t Cut(uint64_t target){
        uint32_t low=0,high=experts_;
        while(low<high){const uint32_t middle=low+(high-low)/2;
            if(uint64_t(reader_.q2z(middle))*physical_<target)low=middle+1;else high=middle;}
        if(low==experts_){expert_=experts_;return target;}
        Open(low);low=0;high=nr_*nc_;const uint64_t relative=target-uint64_t(first_)*physical_;
        while(low<high){const uint32_t middle=low+(high-low)/2;
            if(Prefix(middle)<relative)low=middle+1;else high=middle;}
        index_=low;return uint64_t(first_)*physical_+(nr_?Prefix(index_):0);
    }
public:
    __aicore__ inline AreaPlan(Reader reader,uint32_t experts,uint32_t columns,
            uint32_t rowTile,uint32_t columnTile,uint32_t lane,uint32_t lanes,bool enabled=true)
        :reader_(reader),experts_(experts),columns_(columns),rm_(rowTile),cn_(columnTile),
         nc_((columns+columnTile-1)/columnTile),physical_((columns+31)/32*32){
        if(!enabled){experts_=0;return;}const uint64_t total=uint64_t(reader_.q2z(experts_-1))*physical_;
        stop_=total*(lane+1)/lanes;Cut(total*lane/lanes);
    }
    __aicore__ inline bool Next(Tile& tile){
        while(expert_<experts_){
            if(index_>=nr_*nc_){
                if(uint64_t(last_)*physical_>=stop_||expert_+1>=experts_)return false;
                ++expert_;first_=last_;last_=uint32_t(reader_.q2z(expert_));
                nr_=(last_-first_+rm_-1)/rm_;index_=0;continue;
            }
            const uint64_t position=uint64_t(first_)*physical_+Prefix(index_);
            if(position>=stop_)return false;
            const uint32_t row=ColumnMajor?index_%nr_:index_/nc_;
            const uint32_t column=ColumnMajor?index_/nr_:index_%nc_;
            tile={expert_,first_+row*rm_,column*cn_,0,0,position};
            tile.rows=last_-tile.row;if(tile.rows>rm_)tile.rows=rm_;
            tile.columns=columns_-tile.column;if(tile.columns>cn_)tile.columns=cn_;
            ++index_;return true;
        }return false;
    }
};
}

namespace expert_schedule {
template<class Reader> __aicore__ inline bool Balanced(Reader reader,uint32_t experts){
    uint32_t previous=0,small=~uint32_t(0),large=0;
    for(uint32_t e=0;e<experts;++e){const uint32_t stop=uint32_t(reader.q2z(e)),rows=stop-previous;
        if(rows<small)small=rows;if(rows>large)large=rows;previous=stop;}
    return uint64_t(large)<=uint64_t(small)*2;
}
template<class Reader> __aicore__ inline bool HalfImbalance(Reader reader,uint32_t experts){
    if(experts<2)return false;
    const uint64_t total=reader.q2z(experts-1),left=reader.q2z(experts/2-1);
    return left*4<total||left*4>total*3;
}

template<class Reader> __aicore__ inline bool CoarseImbalance(Reader reader,uint32_t experts){
    const uint32_t parts=experts<8?experts:8;
    const uint64_t total=reader.q2z(experts-1);uint32_t previous=0,previousExpert=0;
    for(uint32_t p=1;p<=parts;++p){const uint32_t stopExpert=experts*p/parts;
        const uint32_t stop=uint32_t(reader.q2z(stopExpert-1));
        if(uint64_t(stop-previous)*experts>2*total*(stopExpert-previousExpert))return true;
        previous=stop;previousExpert=stopExpert;}
    return false;
}
}

namespace expert_schedule {
struct ReadEnds {
    AscendC::GlobalTensor<int64_t> tensor;
    __aicore__ ReadEnds(GM_ADDR pointer){tensor.SetGlobalBuffer((__gm__ int64_t*)pointer);}
    __aicore__ inline int64_t q2z(uint32_t e){return tensor.GetValue(e);}
};
template<int Policy,int ColumnMajor=1> class SdkCursor {
    Plan<Policy,ColumnMajor> plan;
public:
    __aicore__ SdkCursor(GM_ADDR groups,sdk_gmmg::Geometry g,int pair)
       :plan(ReadEnds(groups),g.experts,g.columns,g.rowTile,g.columnTile,pair,g.blocks){}
    __aicore__ SdkCursor(AscendC::TPipe&,GM_ADDR groups,sdk_gmmg::Geometry g,int pair,GM_ADDR)
       :SdkCursor(groups,g,pair){}
    __aicore__ inline bool Next(sdk_gmmg::OutputTile& output){
        Tile tile;if(!plan.Next(tile))return false;
        output={};output.firstRow=tile.row;output.firstColumn=tile.column;output.expert=tile.expert;
        output.rows=tile.rows;output.columns=tile.columns;output.pitch=(tile.columns+31)&~31;
        return true;
    }
};
}

