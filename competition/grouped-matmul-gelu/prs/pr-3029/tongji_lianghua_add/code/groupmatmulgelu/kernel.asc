    static constexpr uint32_t RowOverhead=64,ColumnOverhead=4;

    __aicore__ inline uint32_t AlignRows(uint32_t n) const {
        return (n+15)&~uint32_t(15);
    }
    __aicore__ inline uint32_t ColumnPrefix(uint32_t p) const {
        return p*(shape.qrg/32+ColumnOverhead);
    }
    __aicore__ inline uint64_t ExpertCost(uint32_t n) const {
        const uint32_t full=n/shape.qtr,tail=n%shape.qtr;
        return (uint64_t(full)*(shape.qtr+RowOverhead)+
                (tail?AlignRows(tail)+RowOverhead:0))*columnUnits;
    }
    __aicore__ inline uint32_t RowCount() const {
        const uint32_t left=rows-rowBlock*shape.qtr;
        return left<shape.qtr?left:shape.qtr;
    }
    __aicore__ inline uint64_t TilePosition() const {
        return groupBase+uint64_t(rowBlock)*(shape.qtr+RowOverhead)*columnUnits+
               uint64_t(AlignRows(RowCount())+RowOverhead)*ColumnPrefix(column);
    }
    __aicore__ inline bool Open() {
        while(expert<shape.qa3) {
            end=uint32_t(ends.q2z(expert));rows=end-begin;
            const uint64_t cost=ExpertCost(rows);
            if(rows && lower<groupBase+cost) {
                rowBlock=uint32_t((lower>groupBase?lower-groupBase:0)/
                    (uint64_t(shape.qtr+RowOverhead)*columnUnits));
                column=0;
                while(rowBlock*shape.qtr<rows && TilePosition()<lower) {
                    if(++column==panels){column=0;++rowBlock;}
                }
                opened=true;return true;
            }
            groupBase+=cost;begin=end;++expert;
        }
        return false;
    }
public:
    __aicore__ qc0(const qol& g,uint32_t lane,Reader reader):ends(reader),shape(g) {
        widePanels=g.q9b/g.qrg;narrowWidth=g.q9b%g.qrg;
        panels=widePanels+(narrowWidth!=0);
        columnUnits=widePanels*(g.qrg/32+ColumnOverhead)+
                    (narrowWidth?((narrowWidth+31)/32+ColumnOverhead):0);
        uint32_t previous=0;uint64_t total=0;
        for(uint32_t e=0;e<g.qa3;++e) {
            const uint32_t next=uint32_t(ends.q2z(e));
            total+=ExpertCost(next-previous);previous=next;
        }
        lower=total*lane/g.qgo;upper=total*(lane+1)/g.qgo;
    }
    __aicore__ bool q5i(qds& tile) {
        for(;;) {
            if(!opened && !Open())return false;
            if(rowBlock*shape.qtr>=rows) {
                groupBase+=ExpertCost(rows);begin=end;++expert;opened=false;continue;
            }
            const uint64_t position=TilePosition();
            if(position>=upper)return false;
            const uint32_t n=column*shape.qrg,left=shape.q9b-n;
            tile={expert,begin+rowBlock*shape.qtr,n,RowCount(),
                  left<shape.qrg?left:shape.qrg,position,serial++};
            if(++column==panels){column=0;++rowBlock;}
            return true;
        }
    }
};

