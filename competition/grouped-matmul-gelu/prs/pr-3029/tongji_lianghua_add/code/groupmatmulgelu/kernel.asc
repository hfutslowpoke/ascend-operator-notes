namespace sdk_gmmg {
// One cooperative preparation per invocation, independent of output row tiles.
// Each source row is copied once. Padding belongs to this invocation's workspace.
__aicore__ inline void PrepareInputs(GM_ADDR x, GM_ADDR weight, GM_ADDR padded,
                                     const Geometry& shape, GM_ADDR groups) {
    TPipe preparation;
    TBuf<TPosition::VECCALC> storage;
    preparation.InitBuffer(storage, 32768);
    auto bytes = storage.Get<int8_t>();
    auto words = bytes.ReinterpretCast<int32_t>();
    GlobalTensor<int8_t> sourceX, sourceW, targetX, targetW;
    sourceX.SetGlobalBuffer((__gm__ int8_t*)x);
    sourceW.SetGlobalBuffer((__gm__ int8_t*)weight);
    targetX.SetGlobalBuffer((__gm__ int8_t*)padded);
    targetW.SetGlobalBuffer((__gm__ int8_t*)padded + int64_t(shape.rows) * shape.inputK);
    GlobalTensor<int64_t> groupEnds;
    groupEnds.SetGlobalBuffer((__gm__ int64_t*)groups);
    const int32_t lane = GetBlockIdx(), lanes = GetBlockNum() * 2;
    int32_t xRows = 32768 / shape.inputK;
    if (xRows > 64) xRows = 64;
    for (int32_t first = lane * xRows; first < shape.rows; first += lanes * xRows) {
        const int32_t rows = shape.rows - first < xRows ? shape.rows - first : xRows;
        Duplicate(words, int32_t(0), rows * shape.inputK / 4);
        auto cleared = preparation.FetchEventID(HardEvent::V_MTE2);
        SetFlag<HardEvent::V_MTE2>(cleared); WaitFlag<HardEvent::V_MTE2>(cleared);
        DataCopyPad(bytes, sourceX[int64_t(first) * shape.reduction],
            DataCopyExtParams{uint16_t(rows), uint32_t(shape.reduction), 0,
                uint32_t((shape.inputK - Round32(shape.reduction)) / 32), 0},
            DataCopyPadExtParams<int8_t>{true, 0, 0, 0});
        auto loaded = preparation.FetchEventID(HardEvent::MTE2_MTE3);
        SetFlag<HardEvent::MTE2_MTE3>(loaded); WaitFlag<HardEvent::MTE2_MTE3>(loaded);
        DataCopy(targetX[int64_t(first) * shape.inputK], bytes, rows * shape.inputK);
        auto copied = preparation.FetchEventID(HardEvent::MTE3_V);
        SetFlag<HardEvent::MTE3_V>(copied); WaitFlag<HardEvent::MTE3_V>(copied);
    }
    int32_t wRows = 32768 / shape.inputN;
    if (wRows > 64) wRows = 64;
    const int32_t chunks = (shape.inputK + wRows - 1) / wRows;
    for (int32_t job = lane; job < shape.experts * chunks; job += lanes) {
        const int32_t expert = job / chunks, first = (job % chunks) * wRows;
        if (groupEnds.GetValue(expert) == (expert ? groupEnds.GetValue(expert - 1) : 0)) continue;
        const int32_t rows = shape.inputK - first < wRows ? shape.inputK - first : wRows;
        int32_t valid = shape.reduction - first;
        if (valid > rows) valid = rows;
        Duplicate(words, int32_t(0), rows * shape.inputN / 4);
        if (valid > 0) {
            auto cleared = preparation.FetchEventID(HardEvent::V_MTE2);
            SetFlag<HardEvent::V_MTE2>(cleared); WaitFlag<HardEvent::V_MTE2>(cleared);
            DataCopyPad(bytes, sourceW[(int64_t(expert) * shape.reduction + first) * shape.columns],
                DataCopyExtParams{uint16_t(valid), uint32_t(shape.columns), 0,
                    uint32_t((shape.inputN - Round32(shape.columns)) / 32), 0},
                DataCopyPadExtParams<int8_t>{true, 0, 0, 0});
            auto loaded = preparation.FetchEventID(HardEvent::MTE2_MTE3);
            SetFlag<HardEvent::MTE2_MTE3>(loaded); WaitFlag<HardEvent::MTE2_MTE3>(loaded);
        } else {
            auto cleared = preparation.FetchEventID(HardEvent::V_MTE3);
            SetFlag<HardEvent::V_MTE3>(cleared); WaitFlag<HardEvent::V_MTE3>(cleared);
        }
        DataCopy(targetW[(int64_t(expert) * shape.inputK + first) * shape.inputN], bytes, rows * shape.inputN);
        auto copied = preparation.FetchEventID(HardEvent::MTE3_V);
        SetFlag<HardEvent::MTE3_V>(copied); WaitFlag<HardEvent::MTE3_V>(copied);
    }
}
__aicore__ inline void PrepareInputsOverlapped(GM_ADDR x,GM_ADDR weight,GM_ADDR padded,
                                              const Geometry& shape,GM_ADDR groups) {
    GlobalTensor<int8_t> sourceX,sourceW,targetX,targetW;
    GlobalTensor<int64_t> groupEnds;
    sourceX.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
    sourceW.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(weight));
    targetX.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(padded));
    targetW.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(padded)+int64_t(shape.rows)*shape.inputK);
    groupEnds.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups));
    TPipe preparation;
    TBuf<TPosition::VECCALC> storage;
    preparation.InitBuffer(storage,65536);
    auto buffers=storage.Get<int8_t>();
    event_t completed[2],loaded[2],cleared[2];
    bool pending[2]={false,false};
    for(int i=0;i<2;++i) {
        completed[i]=static_cast<event_t>(preparation.AllocEventID<HardEvent::MTE3_V>());
        loaded[i]=static_cast<event_t>(preparation.AllocEventID<HardEvent::MTE2_MTE3>());
        cleared[i]=static_cast<event_t>(preparation.AllocEventID<HardEvent::V_MTE2>());
    }
    const int lane=GetBlockIdx(),lanes=GetBlockNum()*2;
    int serial=0;
    int xRows=32768/shape.inputK;if(xRows>64)xRows=64;
    for(int first=lane*xRows;first<shape.rows;first+=lanes*xRows) {
        const int bank=serial++&1;
        if(pending[bank])WaitFlag<HardEvent::MTE3_V>(completed[bank]);
        auto bytes=buffers[bank*32768];
        const int rows=shape.rows-first<xRows?shape.rows-first:xRows;
        Duplicate(bytes.ReinterpretCast<int32_t>(),int32_t(0),rows*shape.inputK/4);
        SetFlag<HardEvent::V_MTE2>(cleared[bank]);WaitFlag<HardEvent::V_MTE2>(cleared[bank]);
        DataCopyPad(bytes,sourceX[int64_t(first)*shape.reduction],
            DataCopyExtParams{uint16_t(rows),uint32_t(shape.reduction),0,
                uint32_t((shape.inputK-Round32(shape.reduction))/32),0},
            DataCopyPadExtParams<int8_t>{true,0,0,0});
        SetFlag<HardEvent::MTE2_MTE3>(loaded[bank]);WaitFlag<HardEvent::MTE2_MTE3>(loaded[bank]);
        DataCopy(targetX[int64_t(first)*shape.inputK],bytes,rows*shape.inputK);
        SetFlag<HardEvent::MTE3_V>(completed[bank]);pending[bank]=true;
    }
    int wRows=32768/shape.inputN;if(wRows>64)wRows=64;
    const int chunks=(shape.inputK+wRows-1)/wRows;
    for(int job=lane;job<shape.experts*chunks;job+=lanes) {
        const int expert=job/chunks,first=(job%chunks)*wRows;
        if(groupEnds.GetValue(expert)==(expert?groupEnds.GetValue(expert-1):0))continue;
        const int bank=serial++&1;
        if(pending[bank])WaitFlag<HardEvent::MTE3_V>(completed[bank]);
        auto bytes=buffers[bank*32768];
        const int rows=shape.inputK-first<wRows?shape.inputK-first:wRows;
        int valid=shape.reduction-first;if(valid>rows)valid=rows;
        Duplicate(bytes.ReinterpretCast<int32_t>(),int32_t(0),rows*shape.inputN/4);
        SetFlag<HardEvent::V_MTE2>(cleared[bank]);WaitFlag<HardEvent::V_MTE2>(cleared[bank]);
        if(valid>0)DataCopyPad(bytes,sourceW[(int64_t(expert)*shape.reduction+first)*shape.columns],
            DataCopyExtParams{uint16_t(valid),uint32_t(shape.columns),0,
                uint32_t((shape.inputN-Round32(shape.columns))/32),0},
            DataCopyPadExtParams<int8_t>{true,0,0,0});
        SetFlag<HardEvent::MTE2_MTE3>(loaded[bank]);WaitFlag<HardEvent::MTE2_MTE3>(loaded[bank]);
        DataCopy(targetW[(int64_t(expert)*shape.inputK+first)*shape.inputN],bytes,rows*shape.inputN);
        SetFlag<HardEvent::MTE3_V>(completed[bank]);pending[bank]=true;
    }
    for(int i=0;i<2;++i) {
        if(pending[i])WaitFlag<HardEvent::MTE3_V>(completed[i]);
        preparation.ReleaseEventID<HardEvent::MTE3_V>(completed[i]);
        preparation.ReleaseEventID<HardEvent::MTE2_MTE3>(loaded[i]);
        preparation.ReleaseEventID<HardEvent::V_MTE2>(cleared[i]);
    }
}

template<bool Async, bool Stage>
SDK_STAGE_SCHEDULE __global__ __aicore__ __mix__(1, 2) void MatmulKernel(
    GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groups, GM_ADDR y,
    GM_ADDR systemWorkspace, GM_ADDR products, GM_ADDR prepared, Geometry shape, TCubeTiling tiling) {
    if (Stage) {
        if ASCEND_IS_AIV { PrepareInputs(x, weight, prepared, shape, groups); }
        SyncAll<false>();
        x = prepared;
        weight = prepared + int64_t(shape.rows) * shape.inputK;
    }
    SetSysWorkspaceForce(systemWorkspace);
    clearWorkspace(systemWorkspace);
    TPipe pipe;
    Product multiply;
    REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), multiply, &tiling);
    if ASCEND_IS_AIV {
        const int32_t lane = GetBlockIdx();
        const int32_t lanes = GetBlockNum() * 2;
        const int32_t bankElements = shape.rowTile * shape.columnTile;
        GlobalTensor<int8_t> a, b;
        GlobalTensor<int32_t> storage;
        a.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
        b.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(weight));
        storage.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(products) +
                                int64_t(lane) * (Async ? 2 : 1) * bankElements);
        GroupCursor cursor(groups, shape, lane, lanes);
        Activation consumer;
        consumer.Init(pipe, scale, y, shape.columns);
        OutputTile current, ready;
        bool haveReady = false;
        int32_t readyBank = 0;
        while (cursor.Next(current)) {
            const int32_t nextBank = Async && haveReady ? (readyBank ^ 1) : 0;
            multiply.SetOrgShape(shape.rows, shape.inputN, shape.inputK, shape.inputK, current.pitch);
            multiply.SetSingleShape(current.rows, current.columns, Stage ? shape.inputK : shape.reduction);
            multiply.SetTensorA(a[current.firstRow * shape.inputK]);
            multiply.SetTensorB(b[int64_t(current.expert) * shape.inputK * shape.inputN + current.firstColumn]);
            if (Async && haveReady) {
                multiply.template IterateAll<false>(storage[nextBank * bankElements], 0, false, true);
                consumer.Consume(storage[readyBank * bankElements], ready);
                multiply.WaitIterateAll();
            } else {
                multiply.IterateAll(storage[nextBank * bankElements]);
            }
            multiply.End();
            if (Async) {
                ready = current;
                readyBank = nextBank;
                haveReady = true;
            } else {
                consumer.Consume(storage, current);
            }
        }
        if (Async && haveReady) consumer.Consume(storage[readyBank * bankElements], ready);
        consumer.Drain();
    }
}

__global__ __aicore__ void TinyKernel(GM_ADDR x, GM_ADDR weight, GM_ADDR scale,
                                    GM_ADDR groups, GM_ADDR y, Geometry shape) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    TPipe pipe;
    GlobalTensor<int8_t> a, b;
    GlobalTensor<float> s;
    GlobalTensor<int64_t> boundaries;
    GlobalTensor<half> output;
    a.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
    b.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(weight));
    s.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scale));
    boundaries.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups));
    output.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y));
    TBuf<TPosition::VECCALC> scratch;
    pipe.InitBuffer(scratch, 1152);
    auto bytes = scratch.Get<uint8_t>();
    auto z = bytes.ReinterpretCast<float>();
    auto argument = bytes[256].ReinterpretCast<float>();
    auto denominator = bytes[512].ReinterpretCast<float>();
    auto result = bytes[768].ReinterpretCast<half>();
    for (int64_t index = GetBlockIdx(); index < int64_t(shape.rows) * shape.columns; index += GetBlockNum()) {
        const int32_t row = index / shape.columns, column = index % shape.columns;
        int32_t expert = 0;
        while (expert + 1 < shape.experts && row >= boundaries.GetValue(expert)) ++expert;
        int32_t sum = 0;
        for (int32_t k = 0; k < shape.reduction; ++k)
            sum += int32_t(a.GetValue(int64_t(row) * shape.reduction + k)) *
                   int32_t(b.GetValue((int64_t(expert) * shape.reduction + k) * shape.columns + column));
        Duplicate(z, 0.0f, 64);
        auto scalarReady = pipe.FetchEventID(HardEvent::V_S);
        SetFlag<HardEvent::V_S>(scalarReady); WaitFlag<HardEvent::V_S>(scalarReady);
        z.SetValue(0, float(sum) * s.GetValue(int64_t(expert) * shape.columns + column));
        auto vectorReady = pipe.FetchEventID(HardEvent::S_V);
        SetFlag<HardEvent::S_V>(vectorReady); WaitFlag<HardEvent::S_V>(vectorReady);
        GeluEstimate(z, argument, denominator, result, 64);
        RepairOne(z,argument,result);
        auto write = pipe.FetchEventID(HardEvent::V_MTE3);
        SetFlag<HardEvent::V_MTE3>(write); WaitFlag<HardEvent::V_MTE3>(write);
        DataCopyPad(output[index], result, DataCopyExtParams{1, 2, 0, 0, 0});
        auto free = pipe.FetchEventID(HardEvent::MTE3_V);
        SetFlag<HardEvent::MTE3_V>(free); WaitFlag<HardEvent::MTE3_V>(free);
    }
}
struct Resources {
    uint32_t cube, vector;
    uint64_t ub, l1, l0a, l0b, l0c;
};
static Resources ReadResources(platform_ascendc::PlatformAscendC* platform) {
    Resources r{};
    r.cube = platform->GetCoreNumAic(); r.vector = platform->GetCoreNumAiv();
    using Mem = platform_ascendc::CoreMemType;
    platform->GetCoreMemSize(Mem::UB, r.ub);
    platform->GetCoreMemSize(Mem::L1, r.l1);
    platform->GetCoreMemSize(Mem::L0_A, r.l0a);
    platform->GetCoreMemSize(Mem::L0_B, r.l0b);
    platform->GetCoreMemSize(Mem::L0_C, r.l0c);
    return r;
}
static void Check(aclError status) {
    if (status != ACL_SUCCESS) throw std::runtime_error("SDK GMMG ACL failure");
}
static bool PlanMatmul(platform_ascendc::PlatformAscendC& platform, Geometry& g, TCubeTiling& tiling) {
    const int initialRows = g.rowTile;
    for (int width = g.columnTile; width >= (g.columns==1?16:64); width /= 2) {
        for (int rows = initialRows; rows >= 16; rows /= 2) {
            matmul_tiling::MatmulApiTiling plan(platform);
            plan.SetMatmulConfigParams(1);
            plan.SetAType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND, matmul_tiling::DataType::DT_INT8);
            plan.SetBType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND, matmul_tiling::DataType::DT_INT8);
            plan.SetCType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND, matmul_tiling::DataType::DT_INT32);
            plan.SetShape(rows, width, g.inputK);
            plan.SetOrgShape(g.rows, g.inputN, g.inputK);
            plan.SetFixSplit(rows, width, 128);
            plan.SetBufferSpace(-1, -1, -1);
            if (plan.GetTiling(tiling) == 0) {
                g.rowTile = rows; g.columnTile = width;
                return true;
            }
        }
    }
    return false;
}
static void Validate(const TensorGroupInfo& info, int rank, int dtype) {
    if (info.numTensors != 1 || !info.tensors || !info.tensors[0].shape ||
        info.tensors[0].numDims != rank || info.tensors[0].dtype != dtype)
        throw std::runtime_error("invalid SDK GMMG tensor metadata");
}
} // namespace sdk_gmmg

static bool PreferStage(int64_t e,int64_t m,int64_t k,int64_t n) {
    const int64_t kp=(k+63)&~int64_t(63),np=(n+127)&~int64_t(127);
    const int64_t prepared=(m+e*np)*kp;
    return ((k%32)||(n%32)) && k>=768 && k<=2048 && m>=128*e &&
           kp*np*100 <= k*n*105 && (prepared <= (int64_t(16)<<20) || (m>=1024*e && prepared <= (int64_t(128)<<20)));
}

// Tiny arithmetic uses one output per vector worker and no SDK workspace.
// Shape and expert ownership are read for this invocation, never inferred.
__global__ __vector__ void TinyArithmetic(
    GM_ADDR input, GM_ADDR weights, GM_ADDR scales, GM_ADDR boundaries,
    GM_ADDR destination, sdk_gmmg::Geometry shape) {
    using namespace AscendC;
    const int32_t index=GetBlockIdx();
    const int32_t row=index/shape.columns,col=index%shape.columns;
    GlobalTensor<int8_t> x,w;
    GlobalTensor<float> s;
    GlobalTensor<int64_t> ends;
    GlobalTensor<half> y;
    x.SetGlobalBuffer((__gm__ int8_t*)input);
    w.SetGlobalBuffer((__gm__ int8_t*)weights);
    s.SetGlobalBuffer((__gm__ float*)scales);
    ends.SetGlobalBuffer((__gm__ int64_t*)boundaries);
    y.SetGlobalBuffer((__gm__ half*)destination);
    int32_t expert=0;
    while(expert+1<shape.experts && ends.GetValue(expert)<=row) ++expert;
    int32_t integer=0;
    for(int32_t k=0;k<shape.reduction;++k)
        integer+=int32_t(x.GetValue(row*shape.reduction+k))*
            int32_t(w.GetValue((expert*shape.reduction+k)*shape.columns+col));
    const float value=float(integer)*s.GetValue(expert*shape.columns+col);
    LocalTensor<float> z(TPosition::VECCALC,0,64);
    LocalTensor<float> argument(TPosition::VECCALC,256,64);
    LocalTensor<float> denominator(TPosition::VECCALC,512,64);
    LocalTensor<half> result(TPosition::VECCALC,768,64);
    Duplicate(z,value,64);PipeBarrier<PIPE_V>();
    LocalTensor<half> alternatives(TPosition::VECCALC,1024,128);
    sdk_gmmg::GeluEstimate(z,argument,denominator,result,64);
    sdk_gmmg::RepairOne(z,argument,result);
    SetFlag<HardEvent::V_MTE3>(EVENT_ID0);WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
    DataCopyPad(y[index],result,DataCopyExtParams{1,2,0,0,0});
    SetFlag<HardEvent::MTE3_V>(EVENT_ID0);WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
}

// Independent cooperative product/activation stream. The persistent numerical
// primitive is our pre-existing sign-stable GeluEstimate, without AND-only repair.
namespace best_stream {
using namespace AscendC;
using sdk_gmmg::Geometry;
using sdk_gmmg::OutputTile;
using sdk_gmmg::GroupCursor;

template<int Capacity> __aicore__ inline void HalfActivation(LocalTensor<float> input,LocalTensor<float> first,
                                     LocalTensor<float> second,LocalTensor<half> output,int count) {
    Mul(first,input,input,count);PipeBarrier<PIPE_V>();
        Muls(first,first,-0.07135481387376785f,count);PipeBarrier<PIPE_V>();
        Adds(first,first,-1.5957691669464111f,count);PipeBarrier<PIPE_V>();
        Mul(first,first,input,count);PipeBarrier<PIPE_V>();
        
        Exp(first,first,count);PipeBarrier<PIPE_V>();
        Adds(first,first,1.0f,count);PipeBarrier<PIPE_V>();
        Div(second,input,first,count);PipeBarrier<PIPE_V>();
        Cast(output,second,RoundMode::CAST_RINT,count);PipeBarrier<PIPE_V>();










}
template<int Capacity> __aicore__ inline void ShortHalfActivation(LocalTensor<float> input,LocalTensor<float> first,
                                     LocalTensor<float> second,LocalTensor<half> output,int count) {
    Mul(first,input,input,count);PipeBarrier<PIPE_V>();
        Muls(first,first,-0.07135481387376785f,count);PipeBarrier<PIPE_V>();
        Adds(first,first,-1.5957691669464111f,count);PipeBarrier<PIPE_V>();
        Mul(first,first,input,count);PipeBarrier<PIPE_V>();
        
        Exp(first,first,count);PipeBarrier<PIPE_V>();
        Adds(first,first,1.0f,count);PipeBarrier<PIPE_V>();
        Div(second,input,first,count);PipeBarrier<PIPE_V>();
        Cast(output,second,RoundMode::CAST_RINT,count);PipeBarrier<PIPE_V>();








}


template<int ChunkRows=16> class FinishProduct {
    static constexpr int Lanes=ChunkRows*256;
    TBuf<TPosition::VECCALC> memory;
    LocalTensor<int32_t> incoming;
    LocalTensor<float> scaled, argument, temporary, coefficients;
    LocalTensor<half> outputs;
    GlobalTensor<float> scales;
    GlobalTensor<half> result;
    TPipe* owner;
    int columns, serial=0;
    event_t reusable, loaded, scaleAvailable, written[2], ready[2];
    __aicore__ inline void Read(GlobalTensor<int32_t> source,int offset,int rows) {
        WaitFlag<HardEvent::V_MTE2>(reusable);
        DataCopy(incoming,source[offset],rows*256);
        SetFlag<HardEvent::MTE2_V>(loaded);
    }
public:
    static constexpr int Bytes=20*Lanes+1024;
    __aicore__ inline void Init(TPipe& pipe,GM_ADDR s,GM_ADDR y,int n) {
        owner=&pipe;columns=n;
        pipe.InitBuffer(memory,Bytes);
        auto bytes=memory.Get<uint8_t>();
        incoming=bytes.ReinterpretCast<int32_t>();
        scaled=bytes[Lanes*4].ReinterpretCast<float>();
        argument=bytes[Lanes*8].ReinterpretCast<float>();
        temporary=bytes[Lanes*12].ReinterpretCast<float>();
        outputs=bytes[Lanes*16].ReinterpretCast<half>();
        coefficients=bytes[Lanes*20].ReinterpretCast<float>();
        scales.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(s));
        result.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y));
        reusable=static_cast<event_t>(pipe.AllocEventID<HardEvent::V_MTE2>());
        loaded=static_cast<event_t>(pipe.AllocEventID<HardEvent::MTE2_V>());
        scaleAvailable=static_cast<event_t>(pipe.AllocEventID<HardEvent::V_MTE2>());
        SetFlag<HardEvent::V_MTE2>(reusable);
        for(int i=0;i<2;++i) {
            written[i]=static_cast<event_t>(pipe.AllocEventID<HardEvent::MTE3_V>());
            ready[i]=static_cast<event_t>(pipe.AllocEventID<HardEvent::V_MTE3>());
            SetFlag<HardEvent::MTE3_V>(written[i]);
        }
    }
    template<bool HalfMath=false,int Activation=0>
    __aicore__ inline void Run(GlobalTensor<int32_t> source,OutputTile tile,int credit) {
        if(tile.columns<256)Duplicate(coefficients,0.0f,256);
        SetFlag<HardEvent::V_MTE2>(scaleAvailable);WaitFlag<HardEvent::V_MTE2>(scaleAvailable);
        DataCopyPad(coefficients,scales[int64_t(tile.expert)*columns+tile.firstColumn],
                    DataCopyExtParams{1,uint32_t(tile.columns*4),0,0,0},
                    DataCopyPadExtParams<float>{true,0,0,0});
        const int pieces=(tile.rows+ChunkRows-1)/ChunkRows;
        Read(source,0,tile.rows<ChunkRows?tile.rows:ChunkRows);
        if(pieces==1)CrossCoreSetFlag<2,PIPE_MTE2>(credit);
        for(int piece=0;piece<pieces;++piece) {
            const int first=piece*ChunkRows,rows=tile.rows-first<ChunkRows?tile.rows-first:ChunkRows,count=rows*256;
            WaitFlag<HardEvent::MTE2_V>(loaded);
            Cast(scaled,incoming,RoundMode::CAST_RINT,count);PipeBarrier<PIPE_V>();
            SetFlag<HardEvent::V_MTE2>(reusable);
            if(piece+1<pieces) {
                const int remaining=tile.rows-first-ChunkRows;
                Read(source,(first+ChunkRows)*256,remaining<ChunkRows?remaining:ChunkRows);
                if(piece+2==pieces)CrossCoreSetFlag<2,PIPE_MTE2>(credit);
            }
            for(int col=0;col<256;col+=64)
                Mul(scaled[col],scaled[col],coefficients[col],uint64_t(64),uint8_t(rows),
                    BinaryRepeatParams{1,1,1,32,32,0});
            PipeBarrier<PIPE_V>();
            const int slot=serial++&1;
            WaitFlag<HardEvent::MTE3_V>(written[slot]);
            auto halfOutput=outputs[slot*Lanes];
            if constexpr(Activation==3)ShortHalfActivation<Lanes>(scaled,argument,temporary,halfOutput,count);else if constexpr(HalfMath || Activation==2)HalfActivation<Lanes>(scaled,argument,temporary,halfOutput,count);
            else sdk_gmmg::GeluEstimate(scaled,argument,temporary,halfOutput,count);
            SetFlag<HardEvent::V_MTE3>(ready[slot]);WaitFlag<HardEvent::V_MTE3>(ready[slot]);
            DataCopyPad(result[(tile.firstRow+first)*columns+tile.firstColumn],halfOutput,
                DataCopyExtParams{uint16_t(rows),uint32_t(tile.columns*2),
                    uint32_t((256-((tile.columns+15)&~15))/16),uint32_t((columns-tile.columns)*2),0});
            SetFlag<HardEvent::MTE3_V>(written[slot]);
        }
    }
    __aicore__ inline void Drain() {
        WaitFlag<HardEvent::V_MTE2>(reusable);
        owner->ReleaseEventID<HardEvent::V_MTE2>(reusable);
        owner->ReleaseEventID<HardEvent::MTE2_V>(loaded);
        owner->ReleaseEventID<HardEvent::V_MTE2>(scaleAvailable);
        for(int i=0;i<2;++i) {
            WaitFlag<HardEvent::MTE3_V>(written[i]);
            owner->ReleaseEventID<HardEvent::MTE3_V>(written[i]);
            owner->ReleaseEventID<HardEvent::V_MTE3>(ready[i]);
        }
    }
};

template<int Rows,int Reduction,int Ahead,bool AcrossTile=false> class NativeProduct {
    static constexpr int OperandSlots=Reduction==256?1:2;
    TBuf<TPosition::A1> leftCache;
    TBuf<TPosition::B1> rightCache;
    TBuf<TPosition::A2> leftOperand;
    TBuf<TPosition::B2> rightOperand;
    TBuf<TPosition::CO1> accumulator;
    LocalTensor<int8_t> a1,b1,a0,b0;
    LocalTensor<int32_t> c0;
    GlobalTensor<int8_t> a,b;
    Geometry shape;
    TPipe* pipe;
    event_t cacheFree[Ahead],cacheReady[Ahead],operandFree[OperandSlots],operandReady[OperandSlots];
    event_t exportReady,exportDone;
    int cacheOrigin=0;bool nextPrepared=false;
    __aicore__ inline void Prefetch(OutputTile tile,int panel,int bank) {
        WaitFlag<HardEvent::MTE1_MTE2>(cacheFree[bank]);
        Nd2NzParams l{};
        l.ndNum=1;l.nValue=tile.rows;l.dValue=Reduction;l.srcDValue=shape.inputK;
        l.dstNzC0Stride=Rows;l.dstNzNStride=1;
        DataCopy(a1[bank*Rows*Reduction],a[tile.firstRow*shape.inputK+panel*Reduction],l);
        Nd2NzParams r{};
        r.ndNum=1;r.nValue=Reduction;r.dValue=256;r.srcDValue=shape.inputN;
        r.dstNzC0Stride=Reduction;r.dstNzNStride=1;
        DataCopy(b1[bank*256*Reduction],b[(int64_t(tile.expert)*shape.inputK+panel*Reduction)*shape.inputN+tile.firstColumn],r);
        SetFlag<HardEvent::MTE2_MTE1>(cacheReady[bank]);
    }
public:
    __aicore__ inline void Init(TPipe& p,GM_ADDR x,GM_ADDR w,Geometry g) {
        shape=g;pipe=&p;
        a.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));b.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(w));
        p.InitBuffer(leftCache,Ahead*Rows*Reduction);p.InitBuffer(rightCache,Ahead*256*Reduction);
        p.InitBuffer(leftOperand,OperandSlots*Rows*Reduction);p.InitBuffer(rightOperand,OperandSlots*256*Reduction);
        p.InitBuffer(accumulator,Rows*256*4);
        a1=leftCache.Get<int8_t>();b1=rightCache.Get<int8_t>();
        a0=leftOperand.Get<int8_t>();b0=rightOperand.Get<int8_t>();c0=accumulator.Get<int32_t>();
        for(int i=0;i<Ahead;++i) {
            cacheFree[i]=static_cast<event_t>(p.AllocEventID<HardEvent::MTE1_MTE2>());
            cacheReady[i]=static_cast<event_t>(p.AllocEventID<HardEvent::MTE2_MTE1>());
            SetFlag<HardEvent::MTE1_MTE2>(cacheFree[i]);
        }
        for(int i=0;i<OperandSlots;++i) {
            operandFree[i]=static_cast<event_t>(p.AllocEventID<HardEvent::M_MTE1>());
            operandReady[i]=static_cast<event_t>(p.AllocEventID<HardEvent::MTE1_M>());
            SetFlag<HardEvent::M_MTE1>(operandFree[i]);
        }
        exportReady=static_cast<event_t>(p.AllocEventID<HardEvent::M_FIX>());
        exportDone=static_cast<event_t>(p.AllocEventID<HardEvent::FIX_M>());
    }
    __aicore__ inline void Run(OutputTile tile,GlobalTensor<int32_t> destination,int credit,OutputTile next={},bool hasNext=false) {
        const int panels=shape.inputK/Reduction;
        if(!AcrossTile || !nextPrepared)for(int i=0;i<Ahead && i<panels;++i)Prefetch(tile,i,(cacheOrigin+i)%Ahead);
        for(int panel=0;panel<panels;++panel) {
            const int cache=(cacheOrigin+panel)%Ahead,operand=panel%OperandSlots;
            WaitFlag<HardEvent::MTE2_MTE1>(cacheReady[cache]);
            WaitFlag<HardEvent::M_MTE1>(operandFree[operand]);
            LoadData2DParams l{};l.repeatTimes=Reduction/32;l.srcStride=Rows/16;
            for(int row=0;row<Rows;row+=16)
                LoadData(a0[operand*Rows*Reduction+row*Reduction],a1[cache*Rows*Reduction+row*32],l);
            LoadData2dTransposeParams r{};
            r.repeatTimes=8;r.srcStride=Reduction/32;r.dstGap=1;r.dstFracGap=0;
            for(int k=0;k<Reduction;k+=32)
                LoadDataWithTranspose(b0[operand*256*Reduction+k*256],b1[cache*256*Reduction+k*32],r);
            SetFlag<HardEvent::MTE1_M>(operandReady[operand]);
            SetFlag<HardEvent::MTE1_MTE2>(cacheFree[cache]);
            if(panel+Ahead<panels)Prefetch(tile,panel+Ahead,cache);
            WaitFlag<HardEvent::MTE1_M>(operandReady[operand]);
            MmadParams dot{};dot.m=Rows;dot.n=256;dot.k=Reduction;dot.cmatrixInitVal=panel==0;
            Mmad(c0,a0[operand*Rows*Reduction],b0[operand*256*Reduction],dot);
            SetFlag<HardEvent::M_MTE1>(operandFree[operand]);
            if constexpr(AcrossTile) {
                if(hasNext && panel+Ahead>=panels)Prefetch(next,panel+Ahead-panels,cache);
            }
        }
        if constexpr(AcrossTile) {cacheOrigin=(cacheOrigin+panels)%Ahead;nextPrepared=hasNext;}
        SetFlag<HardEvent::M_FIX>(exportReady);WaitFlag<HardEvent::M_FIX>(exportReady);
        CrossCoreWaitFlag<2,PIPE_FIX>(credit);
        FixpipeParamsV220 copy{};
        copy.nSize=256;copy.mSize=tile.rows;copy.srcStride=Rows;copy.dstStride=256;
        copy.ndNum=1;copy.quantPre=QuantMode_t::NoQuant;
        Fixpipe<int32_t,int32_t>(destination,c0,copy);
        CrossCoreSetFlag<2,PIPE_FIX>(credit);
        SetFlag<HardEvent::FIX_M>(exportDone);WaitFlag<HardEvent::FIX_M>(exportDone);
    }
    __aicore__ inline void Drain() {
        for(int i=0;i<Ahead;++i) {
            WaitFlag<HardEvent::MTE1_MTE2>(cacheFree[i]);
            pipe->ReleaseEventID<HardEvent::MTE1_MTE2>(cacheFree[i]);
            pipe->ReleaseEventID<HardEvent::MTE2_MTE1>(cacheReady[i]);
        }
        for(int i=0;i<OperandSlots;++i) {
            WaitFlag<HardEvent::M_MTE1>(operandFree[i]);
            pipe->ReleaseEventID<HardEvent::M_MTE1>(operandFree[i]);
            pipe->ReleaseEventID<HardEvent::MTE1_M>(operandReady[i]);
        }
        pipe->ReleaseEventID<HardEvent::M_FIX>(exportReady);
        pipe->ReleaseEventID<HardEvent::FIX_M>(exportDone);
    }
};

// The L1 transaction spans several unchanged K128 Cube operations.
template<int Rows,int CacheK> class PackageProduct {
    static constexpr int Step=128,Banks=2,Steps=CacheK/Step;
    TBuf<TPosition::A1> leftCache;
    TBuf<TPosition::B1> rightCache;
    TBuf<TPosition::A2> leftOperand;
    TBuf<TPosition::B2> rightOperand;
    TBuf<TPosition::CO1> accumulator;
    LocalTensor<int8_t> a1,b1,a0,b0;
    LocalTensor<int32_t> c0;
    GlobalTensor<int8_t> a,b;
    Geometry shape;TPipe* owner;
    event_t freeCache[Banks],readyCache[Banks],freeOperand[2],readyOperand[2];
    event_t exportReady,exportDone;
    __aicore__ inline void Fetch(OutputTile tile,int package,int bank) {
        WaitFlag<HardEvent::MTE1_MTE2>(freeCache[bank]);
        Nd2NzParams left{};
        const int remaining=shape.inputK-package*CacheK;
        const int extent=remaining<CacheK?remaining:CacheK;
        left.ndNum=1;left.nValue=tile.rows;left.dValue=extent;left.srcDValue=shape.inputK;
        left.dstNzC0Stride=Rows;left.dstNzNStride=1;
        DataCopy(a1[bank*Rows*CacheK],a[tile.firstRow*shape.inputK+package*CacheK],left);
        Nd2NzParams right{};
        right.ndNum=1;right.nValue=extent;right.dValue=256;right.srcDValue=shape.inputN;
        right.dstNzC0Stride=CacheK;right.dstNzNStride=1;
        DataCopy(b1[bank*256*CacheK],b[(int64_t(tile.expert)*shape.inputK+package*CacheK)*shape.inputN+tile.firstColumn],right);
        SetFlag<HardEvent::MTE2_MTE1>(readyCache[bank]);
    }
public:
    __aicore__ inline void Init(TPipe& pipe,GM_ADDR x,GM_ADDR w,Geometry g) {
        owner=&pipe;shape=g;
        a.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
        b.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(w));
        pipe.InitBuffer(leftCache,Banks*Rows*CacheK);pipe.InitBuffer(rightCache,Banks*256*CacheK);
        pipe.InitBuffer(leftOperand,2*Rows*Step);pipe.InitBuffer(rightOperand,2*256*Step);
        pipe.InitBuffer(accumulator,Rows*256*4);
        a1=leftCache.Get<int8_t>();b1=rightCache.Get<int8_t>();
        a0=leftOperand.Get<int8_t>();b0=rightOperand.Get<int8_t>();c0=accumulator.Get<int32_t>();
        for(int bank=0;bank<Banks;++bank) {
            freeCache[bank]=static_cast<event_t>(pipe.AllocEventID<HardEvent::MTE1_MTE2>());
            readyCache[bank]=static_cast<event_t>(pipe.AllocEventID<HardEvent::MTE2_MTE1>());
            SetFlag<HardEvent::MTE1_MTE2>(freeCache[bank]);
        }
        for(int bank=0;bank<2;++bank) {
            freeOperand[bank]=static_cast<event_t>(pipe.AllocEventID<HardEvent::M_MTE1>());
            readyOperand[bank]=static_cast<event_t>(pipe.AllocEventID<HardEvent::MTE1_M>());
            SetFlag<HardEvent::M_MTE1>(freeOperand[bank]);
        }
        exportReady=static_cast<event_t>(pipe.AllocEventID<HardEvent::M_FIX>());
        exportDone=static_cast<event_t>(pipe.AllocEventID<HardEvent::FIX_M>());
    }
    __aicore__ inline void Run(OutputTile tile,GlobalTensor<int32_t> destination,int credit,OutputTile next={},bool more=false) {
        const int packages=(shape.inputK+CacheK-1)/CacheK;
        for(int p=0;p<Banks && p<packages;++p)Fetch(tile,p,p);
        for(int p=0;p<packages;++p) {
            const int cache=p%Banks;
            WaitFlag<HardEvent::MTE2_MTE1>(readyCache[cache]);
            const int remaining=(shape.inputK-p*CacheK)/Step;
            const int steps=remaining<Steps?remaining:Steps;
            for(int step=0;step<steps;++step) {
                const int operand=step&1;
                WaitFlag<HardEvent::M_MTE1>(freeOperand[operand]);
                LoadData2DParams left{};left.repeatTimes=Step/32;left.srcStride=Rows/16;
                for(int row=0;row<Rows;row+=16)
                    LoadData(a0[operand*Rows*Step+row*Step],a1[cache*Rows*CacheK+step*Step*Rows+row*32],left);
                LoadData2dTransposeParams right{};right.repeatTimes=8;right.srcStride=CacheK/32;
                right.dstGap=1;right.dstFracGap=0;
                for(int k=0;k<Step;k+=32)
                    LoadDataWithTranspose(b0[operand*256*Step+k*256],b1[cache*256*CacheK+(step*Step+k)*32],right);
                SetFlag<HardEvent::MTE1_M>(readyOperand[operand]);
                if(step+1==steps) {
                    SetFlag<HardEvent::MTE1_MTE2>(freeCache[cache]);
                    if(p+Banks<packages)Fetch(tile,p+Banks,cache);
                }
                WaitFlag<HardEvent::MTE1_M>(readyOperand[operand]);
                MmadParams dot{};dot.m=Rows;dot.n=256;dot.k=Step;dot.cmatrixInitVal=(p==0 && step==0);
                Mmad(c0,a0[operand*Rows*Step],b0[operand*256*Step],dot);
                SetFlag<HardEvent::M_MTE1>(freeOperand[operand]);
            }
        }
        SetFlag<HardEvent::M_FIX>(exportReady);WaitFlag<HardEvent::M_FIX>(exportReady);
        CrossCoreWaitFlag<2,PIPE_FIX>(credit);
        FixpipeParamsV220 copy{};copy.nSize=256;copy.mSize=tile.rows;copy.srcStride=Rows;copy.dstStride=256;
        copy.ndNum=1;copy.quantPre=QuantMode_t::NoQuant;
        Fixpipe<int32_t,int32_t>(destination,c0,copy);CrossCoreSetFlag<2,PIPE_FIX>(credit);
        SetFlag<HardEvent::FIX_M>(exportDone);WaitFlag<HardEvent::FIX_M>(exportDone);
    }
    __aicore__ inline void Drain() {
        for(int i=0;i<Banks;++i) {
            WaitFlag<HardEvent::MTE1_MTE2>(freeCache[i]);
            owner->ReleaseEventID<HardEvent::MTE1_MTE2>(freeCache[i]);
            owner->ReleaseEventID<HardEvent::MTE2_MTE1>(readyCache[i]);
        }
        for(int i=0;i<2;++i) {
            WaitFlag<HardEvent::M_MTE1>(freeOperand[i]);
            owner->ReleaseEventID<HardEvent::M_MTE1>(freeOperand[i]);
            owner->ReleaseEventID<HardEvent::MTE1_M>(readyOperand[i]);
        }
        owner->ReleaseEventID<HardEvent::M_FIX>(exportReady);owner->ReleaseEventID<HardEvent::FIX_M>(exportDone);
    }
};
template<int Rows,int CacheK> class FlagPackageProduct {
    static constexpr int Step=128,Banks=2,Steps=CacheK/Step;
    TBuf<TPosition::A1> leftCache;
    TBuf<TPosition::B1> rightCache;
    TBuf<TPosition::A2> leftOperand;
    TBuf<TPosition::B2> rightOperand;
    TBuf<TPosition::CO1> accumulator;
    LocalTensor<int8_t> a1,b1,a0,b0;
    LocalTensor<int32_t> c0;
    GlobalTensor<int8_t> a,b;
    Geometry shape;TPipe* owner;
    event_t freeCache[Banks],readyCache[Banks],freeOperand[2],readyOperand[2];
    event_t exportReady,exportDone;
    __aicore__ inline void Fetch(OutputTile tile,int package,int bank) {
        WaitFlag<HardEvent::MTE1_MTE2>(freeCache[bank]);
        Nd2NzParams left{};
        const int remaining=shape.inputK-package*CacheK;
        const int extent=remaining<CacheK?remaining:CacheK;
        left.ndNum=1;left.nValue=tile.rows;left.dValue=extent;left.srcDValue=shape.inputK;
        left.dstNzC0Stride=Rows;left.dstNzNStride=1;
        DataCopy(a1[bank*Rows*CacheK],a[tile.firstRow*shape.inputK+package*CacheK],left);
        Nd2NzParams right{};
        right.ndNum=1;right.nValue=extent;right.dValue=256;right.srcDValue=shape.inputN;
        right.dstNzC0Stride=CacheK;right.dstNzNStride=1;
        DataCopy(b1[bank*256*CacheK],b[(int64_t(tile.expert)*shape.inputK+package*CacheK)*shape.inputN+tile.firstColumn],right);
        SetFlag<HardEvent::MTE2_MTE1>(readyCache[bank]);
    }
public:
    __aicore__ inline void Init(TPipe& pipe,GM_ADDR x,GM_ADDR w,Geometry g) {
        owner=&pipe;shape=g;SetMMRowMajor();
        a.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
        b.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(w));
        pipe.InitBuffer(leftCache,Banks*Rows*CacheK);pipe.InitBuffer(rightCache,Banks*256*CacheK);
        pipe.InitBuffer(leftOperand,2*Rows*Step);pipe.InitBuffer(rightOperand,2*256*Step);
        pipe.InitBuffer(accumulator,Rows*256*4);
        a1=leftCache.Get<int8_t>();b1=rightCache.Get<int8_t>();
        a0=leftOperand.Get<int8_t>();b0=rightOperand.Get<int8_t>();c0=accumulator.Get<int32_t>();
        for(int bank=0;bank<Banks;++bank) {
            freeCache[bank]=static_cast<event_t>(pipe.AllocEventID<HardEvent::MTE1_MTE2>());
            readyCache[bank]=static_cast<event_t>(pipe.AllocEventID<HardEvent::MTE2_MTE1>());
            SetFlag<HardEvent::MTE1_MTE2>(freeCache[bank]);
        }
        for(int bank=0;bank<2;++bank) {
            freeOperand[bank]=static_cast<event_t>(pipe.AllocEventID<HardEvent::M_MTE1>());
            readyOperand[bank]=static_cast<event_t>(pipe.AllocEventID<HardEvent::MTE1_M>());
            SetFlag<HardEvent::M_MTE1>(freeOperand[bank]);
        }
        exportReady=static_cast<event_t>(pipe.AllocEventID<HardEvent::M_FIX>());
        exportDone=static_cast<event_t>(pipe.AllocEventID<HardEvent::FIX_M>());
    }
    __aicore__ inline void Run(OutputTile tile,GlobalTensor<int32_t> destination,int credit,OutputTile next={},bool more=false) {
        const int packages=(shape.inputK+CacheK-1)/CacheK;
        for(int p=0;p<Banks && p<packages;++p)Fetch(tile,p,p);
        for(int p=0;p<packages;++p) {
            const int cache=p%Banks;
            WaitFlag<HardEvent::MTE2_MTE1>(readyCache[cache]);
            const int remaining=(shape.inputK-p*CacheK)/Step;
            const int steps=remaining<Steps?remaining:Steps;
            for(int step=0;step<steps;++step) {
                const int operand=step&1;
                WaitFlag<HardEvent::M_MTE1>(freeOperand[operand]);
                LoadData2DParams left{};left.repeatTimes=Step/32;left.srcStride=Rows/16;
                for(int row=0;row<Rows;row+=16)
                    LoadData(a0[operand*Rows*Step+row*Step],a1[cache*Rows*CacheK+step*Step*Rows+row*32],left);
                LoadData2dTransposeParams right{};right.repeatTimes=8;right.srcStride=CacheK/32;
                right.dstGap=1;right.dstFracGap=0;
                for(int k=0;k<Step;k+=32)
                    LoadDataWithTranspose(b0[operand*256*Step+k*256],b1[cache*256*CacheK+(step*Step+k)*32],right);
                SetFlag<HardEvent::MTE1_M>(readyOperand[operand]);
                if(step+1==steps) {
                    SetFlag<HardEvent::MTE1_MTE2>(freeCache[cache]);
                    if(p+Banks<packages)Fetch(tile,p+Banks,cache);
                }
                WaitFlag<HardEvent::MTE1_M>(readyOperand[operand]);
                MmadParams dot{};dot.m=Rows;dot.n=256;dot.k=Step;dot.cmatrixInitVal=(p==0 && step==0);dot.unitFlag=(p+1==packages&&step+1==steps)?3:2;
                Mmad(c0,a0[operand*Rows*Step],b0[operand*256*Step],dot);
                SetFlag<HardEvent::M_MTE1>(freeOperand[operand]);
            }
        }

        CrossCoreWaitFlag<2,PIPE_FIX>(credit);
        FixpipeParamsV220 copy{};copy.nSize=256;copy.mSize=Rows;copy.unitFlag=3;copy.srcStride=Rows;copy.dstStride=256;
        copy.ndNum=1;copy.quantPre=QuantMode_t::NoQuant;
        Fixpipe<int32_t,int32_t>(destination,c0,copy);CrossCoreSetFlag<2,PIPE_FIX>(credit);

    }
    __aicore__ inline void Drain() {
        for(int i=0;i<Banks;++i) {
            WaitFlag<HardEvent::MTE1_MTE2>(freeCache[i]);
            owner->ReleaseEventID<HardEvent::MTE1_MTE2>(freeCache[i]);
            owner->ReleaseEventID<HardEvent::MTE2_MTE1>(readyCache[i]);
        }
        for(int i=0;i<2;++i) {
            WaitFlag<HardEvent::M_MTE1>(freeOperand[i]);
            owner->ReleaseEventID<HardEvent::M_MTE1>(freeOperand[i]);
            owner->ReleaseEventID<HardEvent::MTE1_M>(readyOperand[i]);
        }
        owner->ReleaseEventID<HardEvent::M_FIX>(exportReady);owner->ReleaseEventID<HardEvent::FIX_M>(exportDone);
    }
};
template<int Rows,int CacheK> class AdjacentProduct {
    static constexpr int Step=128,Banks=2,Steps=CacheK/Step;
    TBuf<TPosition::A1> leftCache;
