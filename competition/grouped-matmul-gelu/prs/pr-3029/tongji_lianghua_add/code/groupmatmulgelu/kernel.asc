            return true;
        }
        return false;
    }
};


template<class Reader> class AttachedTailOrder {
    PairedOrder<Reader> fallback;
    qol shape;Reader ends;
    uint64_t wanted,rows=0,serial=0;
    uint32_t pairs;
    bool enabled=false;
    uint32_t pending=0,position=0;
    qds saved[2]{};
public:
    __aicore__ inline AttachedTailOrder(qol g,uint32_t block,Reader reader,bool allowAttach=true)
        :fallback(g,block,reader),shape(g),ends(reader),wanted(block),pairs(g.q9b/(2*g.qrg)) {
        enabled=allowAttach&&g.qtr==64&&g.qrg==64&&pairs&&g.q9b%(2*g.qrg)&&g.q9b%(2*g.qrg)<=32;
        if(enabled){uint32_t first=0;for(uint32_t e=0;e<g.qa3;++e){const uint32_t last=ends.q2z(e);rows+=(last-first+g.qtr-1)/g.qtr;first=last;}}
    }
    __aicore__ inline bool q5i(qds& tile){
        if(!enabled)return fallback.q5i(tile);
        if(pending){tile=saved[position++];tile.q3o=serial++;--pending;return true;}
        if(wanted>=rows*pairs)return false;
        const uint64_t id=wanted;wanted+=shape.qgo;
