template<class Reader> class PairedOrder {
    OriginalPairedOrder<Reader> fallback;
    qol shape;Reader ends;
    uint64_t wanted,rows=0,serial=0;
    uint32_t pairs;
    bool tailFirst=false,pending=false;
    qds saved{};
public:
    __aicore__ inline PairedOrder(qol g,uint32_t block,Reader reader)
        :fallback(g,block,reader),shape(g),ends(reader),wanted(block),pairs((g.q9b+2*g.qrg-1)/(2*g.qrg)) {
        const uint32_t tail=g.q9b%(2*g.qrg);
