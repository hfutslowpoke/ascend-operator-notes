    event_t freeCache[Banks],readyCache[Banks],freeOperand[2],readyOperand[2];
    event_t exportReady,exportDone;
    __aicore__ inline void Fetch(OutputTile tile,int package,int bank) {
        WaitFlag<HardEvent::MTE1_MTE2>(freeCache[bank]);
        Nd2NzParams left{};
        const int remaining=shape.inputK-package*CacheK;
        const int extent=remaining<CacheK?remaining:CacheK;
        left.ndNum=1;left.nValue=tile.rows;left.dValue=extent;left.srcDValue=shape.inputK;
        left.dstNzC0Stride=Rows;left.dstNzNStride=1;
