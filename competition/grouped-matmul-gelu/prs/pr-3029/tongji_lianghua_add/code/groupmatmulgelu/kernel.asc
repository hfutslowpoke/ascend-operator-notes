        }
        for(int slot=0;slot<2;++slot)if(pending[slot])WaitFlag<HardEvent::MTE3_V>(outputDone[slot]);
    }
    __aicore__ inline void Drain() {
        WaitFlag<HardEvent::V_MTE2>(inputFree);
