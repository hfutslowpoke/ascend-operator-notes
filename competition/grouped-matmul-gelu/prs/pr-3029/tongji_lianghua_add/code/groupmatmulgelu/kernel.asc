// SDK foundation, retained producers, and the teammate Columns512 C1 path.
#define SDK_REBUILD_ASYNC 1
#define SDK_REBUILD_STAGE 0
#define SDK_STAGE_SCHEDULE __schedmode__(1)
#include "kernel_operator.h"
#include "lib/matmul_intf.h"
#include "adv_api/matmul/matmul.h"
#include "tiling/matmul/matmul_tiling.h"
#include "tiling/platform/platform_ascendc.h"
#include <algorithm>
#include <stdexcept>
#include <cstdint>

namespace gmmg_safe_l1 {
__aicore__ inline void ZeroBytes(AscendC::LocalTensor<int8_t> dst, uint32_t totalBytes) {
    using namespace AscendC;
    uint32_t blocks = (totalBytes + 31u) / 32u;
    uint32_t offsetWords = 0;
    auto words = dst.ReinterpretCast<uint32_t>();
    while (blocks > 0) {
        const uint16_t chunk = blocks > 2048u ? uint16_t(2048u) : uint16_t(blocks);
        Fill(words[offsetWords], InitConstValueParams<uint32_t>{1, chunk, 0, 0});
        offsetWords += uint32_t(chunk) * 8u;
        blocks -= chunk;
    }
}
} // namespace gmmg_safe_l1

namespace expert_schedule {
struct Tile { uint32_t expert,row,column,rows,columns; uint64_t ordinal; };

// The same immutable device group list constructs the same plan on the AIC
// and both of its AIV consumers. No Host tensor read or extra kernel launch.
// Policy 0: cyclic tiles; 1: contiguous expert-major tile spans;
// 2: contiguous spans cut by padded arithmetic plus a small per-tile cost.
template<int Policy,int ColumnMajor> class Plan {
    uint32_t ends_[128],rowTiles_[128],tasks_[129];
    uint64_t costs_[129];
    uint32_t experts_,columns_,rm_,cn_,nc_,lane_,lanes_;
    uint32_t current_=0,limit_=0,expert_=0;
    __aicore__ inline uint32_t First(uint32_t e) const { return e?ends_[e-1]:0; }
    __aicore__ inline uint32_t RowUnits(uint32_t e,uint32_t count) const {
        const uint32_t full=rm_/16+(rm_%16!=0), nr=rowTiles_[e];
        if(count<nr)return count*full;
        if(!nr)return 0;
        const uint32_t tail=ends_[e]-First(e)-(nr-1)*rm_;
        return (nr-1)*full+(tail+15)/16;
    }
    __aicore__ inline uint32_t ColumnUnits(uint32_t count) const {
        const uint32_t full=(cn_+31)/32;
        if(count<nc_)return count*full;
        return (nc_-1)*full+(columns_-(nc_-1)*cn_+31)/32;
    }
    __aicore__ inline uint64_t PrefixCost(uint32_t e,uint32_t count) const {
        if(!count)return 0;
        const uint32_t nr=rowTiles_[e];
        uint64_t units;
        if constexpr(ColumnMajor) {
            const uint32_t col=count/nr,row=count%nr;
            units=uint64_t(RowUnits(e,nr))*ColumnUnits(col);
            if(row)units+=uint64_t(RowUnits(e,row))*(ColumnUnits(col+1)-ColumnUnits(col));
        } else {
            const uint32_t row=count/nc_,col=count%nc_;
            units=uint64_t(RowUnits(e,row))*ColumnUnits(nc_);
            if(col)units+=uint64_t(RowUnits(e,row+1)-RowUnits(e,row))*ColumnUnits(col);
        }
        return units+uint64_t(count)*4;
    }
    __aicore__ inline uint32_t Cut(uint64_t target) const {
        if(!target)return 0;
        uint32_t e=0;
        while(e<experts_&&costs_[e+1]<target)++e;
        if(e==experts_)return tasks_[experts_];
        uint32_t lo=0,hi=tasks_[e+1]-tasks_[e];
        const uint64_t relative=target-costs_[e];
        while(lo<hi){const uint32_t mid=lo+(hi-lo)/2;
            if(PrefixCost(e,mid)<relative)lo=mid+1;else hi=mid;}
        return tasks_[e]+lo;
    }
public:
    template<class Reader> __aicore__ inline Plan(Reader reader,uint32_t experts,uint32_t columns,
          uint32_t rowTile,uint32_t columnTile,uint32_t lane,uint32_t lanes,bool enabled=true)
        :experts_(experts),columns_(columns),rm_(rowTile),cn_(columnTile),
         nc_((columns+columnTile-1)/columnTile),lane_(lane),lanes_(lanes) {
        if(!enabled){experts_=0;return;}tasks_[0]=0;costs_[0]=0;uint32_t previous=0;
        for(uint32_t e=0;e<experts_;++e){
            const uint32_t stop=uint32_t(reader.q2z(e));ends_[e]=stop;
            const uint32_t count=(stop-previous+rm_-1)/rm_;rowTiles_[e]=count;
            const uint32_t work=count*nc_;tasks_[e+1]=tasks_[e]+work;
            if constexpr(Policy==2)costs_[e+1]=costs_[e]+PrefixCost(e,work);
            previous=stop;
        }
        const uint32_t total=tasks_[experts_];
        if constexpr(Policy==0){current_=lane_;limit_=total;}
        else if constexpr(Policy==1){current_=uint64_t(total)*lane_/lanes_;limit_=uint64_t(total)*(lane_+1)/lanes_;}
        else {current_=Cut(costs_[experts_]*lane_/lanes_);limit_=Cut(costs_[experts_]*(lane_+1)/lanes_);}
    }
    __aicore__ inline bool Next(Tile& tile) {
        if(current_>=limit_)return false;
        while(expert_<experts_&&current_>=tasks_[expert_+1])++expert_;
        if(expert_==experts_)return false;
        const uint32_t local=current_-tasks_[expert_],nr=rowTiles_[expert_];
        uint32_t row,column;
        if constexpr(ColumnMajor){row=local%nr;column=local/nr;}
        else {row=local/nc_;column=local%nc_;}
        tile.expert=expert_;tile.row=First(expert_)+row*rm_;tile.column=column*cn_;
        tile.rows=ends_[expert_]-tile.row;if(tile.rows>rm_)tile.rows=rm_;
        tile.columns=columns_-tile.column;if(tile.columns>cn_)tile.columns=cn_;
        tile.ordinal=current_;
        current_+=Policy==0?lanes_:1;
        return true;
    }
};
}

namespace sdk_gmmg {
using namespace AscendC;
using InputMatrix = MatmulType<TPosition::GM, CubeFormat::ND, int8_t>;
using IntegerMatrix = MatmulType<TPosition::GM, CubeFormat::ND, int32_t>;
using Product = Matmul<InputMatrix, InputMatrix, IntegerMatrix, IntegerMatrix, CFG_MDL>;

struct Geometry {
    int32_t experts, rows, reduction, columns;
    int32_t rowTile, columnTile, blocks;
    int32_t inputK, inputN;
};
struct OutputTile {
    int64_t firstRow;
    int32_t expert, firstColumn, rows, columns, pitch;
};
__aicore__ inline int32_t Round32(int32_t value) { return (value + 31) & ~31; }

// Each lane owns a disjoint arithmetic progression in the runtime tile stream.
// Empty experts have no tiles, but their cumulative boundaries are still read.
class GroupCursor {
    GlobalTensor<int64_t> boundaries;
    Geometry shape;
    int64_t wanted, prefix = 0, first = 0, end = 0, groupTiles = 0;
    int32_t expert = -1, stride, columns;
public:
    __aicore__ inline GroupCursor(GM_ADDR groups, Geometry g, int32_t lane, int32_t lanes)
        : shape(g), wanted(lane), stride(lanes), columns((g.columns + g.columnTile - 1) / g.columnTile) {
        boundaries.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups), g.experts);
    }
    __aicore__ inline bool Next(OutputTile& result) {
        while (wanted >= prefix + groupTiles) {
            prefix += groupTiles;
            first = end;
            if (++expert >= shape.experts) return false;
            end = boundaries.GetValue(expert);
            groupTiles = ((end - first + shape.rowTile - 1) / shape.rowTile) * columns;
        }
        const int64_t local = wanted - prefix;
        const int32_t row = static_cast<int32_t>(local / columns) * shape.rowTile;
        const int32_t col = static_cast<int32_t>(local % columns) * shape.columnTile;
        result.firstRow = first + row;
        result.firstColumn = col;
        result.expert = expert;
        result.rows = static_cast<int32_t>(end - result.firstRow);
        if (result.rows > shape.rowTile) result.rows = shape.rowTile;
        result.columns = shape.columns - col;
        if (result.columns > shape.columnTile) result.columns = shape.columnTile;
        result.pitch = Round32(result.columns);
        wanted += stride;
        return true;
    }
};
namespace repair_math {
struct Pair { float hi, lo; };
__aicore__ inline uint32_t Bits(float value) {
    union { float value; uint32_t bits; } word;
    word.value = value;
    return word.bits;
}
__aicore__ inline float FromBits(uint32_t bits) {
    union { float value; uint32_t bits; } word;
    word.bits = bits;
    return word.value;
}
__aicore__ inline Pair Normalize(float hi, float lo) {
    const float sum = hi + lo;
    return {sum, lo - (sum - hi)};
}
__aicore__ inline Pair Add(Pair a, Pair b) {
    const float sum = a.hi + b.hi;
    const float v = sum - a.hi;
    const float error = (a.hi - (sum - v)) + (b.hi - v);
    return Normalize(sum, error + (a.lo + b.lo));
}
__aicore__ inline Pair Neg(Pair a) { return {-a.hi, -a.lo}; }
__aicore__ inline Pair Mul(Pair a, Pair b) {
    const float product = a.hi * b.hi;
    const float ah = FromBits(Bits(a.hi) & 0xfffff000u), al = a.hi - ah;
    const float bh = FromBits(Bits(b.hi) & 0xfffff000u), bl = b.hi - bh;
    const float error = ((ah * bh - product) + ah * bl + al * bh) + al * bl;
    return Normalize(product, (error + a.hi * b.lo + a.lo * b.hi) + a.lo * b.lo);
}
__aicore__ inline Pair Div(Pair a, Pair b) {
    const float q = a.hi / b.hi;
    const Pair remainder = Add(a, Neg(Mul(b, {q, 0.0f})));
    return Normalize(q, (remainder.hi + remainder.lo) / b.hi);
}



__aicore__ inline Pair Exp(Pair argument) {
    const Pair log_two{0.69314718246459961f, -1.9046542121259336e-09f};
    const int k = int(argument.hi * 1.4426950408889634f - 0.5f);
    const Pair r = Add(argument, Neg(Mul({float(k), 0.0f}, log_two)));

    const Pair coefficients[11] = {
        {1.0f, 0.0f}, {1.0f, 0.0f}, {0.5f, 0.0f},
        {0.1666666716337204f, -4.9670538793122887e-09f},
        {0.041666667908430099f, -1.2417634698280722e-09f},
        {0.0083333337679505348f, -4.3461720333759502e-10f},
        {0.0013888889225199819f, -3.3631094437103215e-11f},
        {0.00019841270113829523f, -2.7255968749334558e-12f},
        {2.4801587642286904e-05f, -3.4069960936668198e-13f},
        {2.7557318844628753e-06f, 3.7935712242972291e-14f},
        {2.755731998149713e-07f, -7.5751122090511949e-15f}};
    Pair polynomial = coefficients[9];
    polynomial = Add(Mul(polynomial, r), coefficients[8]);
    polynomial = Add(Mul(polynomial, r), coefficients[7]);
    polynomial = Add(Mul(polynomial, r), coefficients[6]);
    polynomial = Add(Mul(polynomial, r), coefficients[5]);
    polynomial = Add(Mul(polynomial, r), coefficients[4]);
    polynomial = Add(Mul(polynomial, r), coefficients[3]);
    polynomial = Add(Mul(polynomial, r), coefficients[2]);
    polynomial = Add(Mul(polynomial, r), coefficients[1]);
    polynomial = Add(Mul(polynomial, r), coefficients[0]);
    const float power = FromBits(uint32_t(k + 127) << 23);
    return {polynomial.hi * power, polynomial.lo * power};
}

__aicore__ inline float RoundToOdd(Pair value) {
    uint32_t word = Bits(value.hi);
    if ((word & 1) == 0 && value.lo != 0.0f) {
        const bool same_sign = ((word ^ Bits(value.lo)) >> 31) == 0;
        word = same_sign ? word + 1 : word - 1;
    }
    return FromBits(word);
}

__aicore__ inline uint16_t HalfBits(float value) {
    const uint32_t word = Bits(value), magnitude = word & 0x7fffffffu;
    const uint16_t sign = uint16_t((word >> 16) & 0x8000u);
    const int exponent = int(magnitude >> 23) - 127;
    if (exponent < -25) return sign;
    uint32_t rounded, remainder, halfway;
    if (exponent < -14) {
        const uint32_t mantissa = (magnitude & 0x7fffffu) | 0x800000u;
        const uint32_t shift = uint32_t(-exponent - 1);
        rounded = mantissa >> shift;
        remainder = mantissa & ((uint32_t(1) << shift) - 1);
        halfway = uint32_t(1) << (shift - 1);
    } else {
        rounded = (magnitude - 0x38000000u) >> 13;
        remainder = magnitude & 0x1fffu;
        halfway = 0x1000u;
    }
    if (remainder > halfway || (remainder == halfway && (rounded & 1))) ++rounded;
    return sign | uint16_t(rounded);
}

// Refine only the final half rounding decision. Retain two-float arithmetic
// through the smooth expression; there is no need to emulate binary64 rounding
// after each intermediate operation for the requested output tolerance.
__aicore__ inline uint16_t CompensatedGeluHalfBits(float z) {
    const uint32_t encoded = Bits(z), magnitude = encoded & 0x7fffffffu;
    if (magnitude < 0x32800000u || z <= -6.0f)
        return uint16_t((encoded >> 16) & 0x8000u);
    if (z >= 8.0f) return HalfBits(z);
    const Pair x{FromBits(magnitude), 0.0f};
    const Pair cubicCoefficient{0.044714998453855515f, 1.5461444347053543e-09f};
    const Pair sqrtTwoOverPi{0.79788458347320557f, -2.2670340271702116e-08f};
    const Pair multiplier = Add({1.0f, 0.0f}, Mul(cubicCoefficient, Mul(x, x)));
    const Pair exponent = Mul({-2.0f, 0.0f}, Mul(sqrtTwoOverPi, Mul(x, multiplier)));
    const Pair tail = Exp(exponent);
    const Pair factor = Div(z < 0.0f ? tail : Pair{1.0f, 0.0f}, Add({1.0f, 0.0f}, tail));
    return HalfBits(RoundToOdd(Mul({z, 0.0f}, factor)));
}

}
// Let a=abs(z), e=exp(-sqrt(8/pi)*a*(1+0.044715*a*a)).
// GELU(z)=max(z,0)-a*e/(1+e). On the positive side this avoids
// multiplying a nearly-one reciprocal into z before half rounding.
__aicore__ inline void GeluEstimate(LocalTensor<float> z,LocalTensor<float> argument,
    LocalTensor<float> denominator,LocalTensor<half> output,int32_t count) {
    Abs(argument,z,count);PipeBarrier<PIPE_V>();
    Mul(denominator,argument,argument,count);PipeBarrier<PIPE_V>();
    Muls(denominator,denominator,0.044715f,count);PipeBarrier<PIPE_V>();
    Adds(denominator,denominator,1.0f,count);PipeBarrier<PIPE_V>();
    Mul(denominator,denominator,argument,count);PipeBarrier<PIPE_V>();
    Muls(denominator,denominator,-1.5957691216057308f,count);PipeBarrier<PIPE_V>();
    Exp(denominator,denominator,count);PipeBarrier<PIPE_V>();
    Mul(argument,argument,denominator,count);PipeBarrier<PIPE_V>();
    Adds(denominator,denominator,1.0f,count);PipeBarrier<PIPE_V>();
    Div(argument,argument,denominator,count);PipeBarrier<PIPE_V>();
    Maxs(denominator,z,0.0f,count);PipeBarrier<PIPE_V>();
    Sub(argument,denominator,argument,count);PipeBarrier<PIPE_V>();
    Cast(output,argument,RoundMode::CAST_RINT,count);PipeBarrier<PIPE_V>();
}

// Ordinary-data qualification selects these numerical guard widths; they are
// internal rounding detection, not relaxed output acceptance thresholds.
__aicore__ inline void RepairOne(LocalTensor<float> input,LocalTensor<float> approximate,
    LocalTensor<half> output) {
    SetFlag<HardEvent::V_S>(EVENT_ID3);WaitFlag<HardEvent::V_S>(EVENT_ID3);
    const float value=approximate.GetValue(0);
    const uint32_t low=repair_math::HalfBits(value*(value>=0?0.9999998f:0.999996f))&0x7fff;
    const uint32_t high=repair_math::HalfBits(value*(value>=0?1.0000002f:1.000004f))&0x7fff;
    const uint32_t minimum=low<high?low:high,maximum=low>high?low:high;
    if(low!=high && !(minimum>=0x400 && maximum<=0x4000 && maximum-minimum<=1)) {
        output.ReinterpretCast<uint16_t>().SetValue(0,
            repair_math::CompensatedGeluHalfBits(input.GetValue(0)));
        SetFlag<HardEvent::S_V>(EVENT_ID3);WaitFlag<HardEvent::S_V>(EVENT_ID3);
    }
}

// FP32-to-FP16 discards 13 significand bits for normal numbers. Only
// outputs above magnitude 2 and subnormal half values need more than an
// adjacent-half tolerance check. This is candidate selection, not the gate.
__aicore__ inline void RepairRounding(LocalTensor<float> input,
    LocalTensor<float> approximate,LocalTensor<float> work,LocalTensor<half> output,
    LocalTensor<half> alternatives,int32_t count) {
    const int32_t maskBytes=((count+255)/256)*32;
    auto mask=alternatives.ReinterpretCast<uint8_t>();
    auto magnitude=mask[maskBytes],negative=mask[maskBytes*2];
    // The constant is a format mask, not a precomputed operator result.
    auto codes=alternatives.ReinterpretCast<int32_t>();
    Duplicate(codes,int32_t(8191),count);PipeBarrier<PIPE_V>();
    And(work.ReinterpretCast<uint16_t>(),approximate.ReinterpretCast<uint16_t>(),
        codes.ReinterpretCast<uint16_t>(),2*count);PipeBarrier<PIPE_V>();
    Cast(work,work.ReinterpretCast<int32_t>(),RoundMode::CAST_NONE,count);PipeBarrier<PIPE_V>();
    Adds(work,work,-4096.0f,count);PipeBarrier<PIPE_V>();
    Abs(work,work,count);PipeBarrier<PIPE_V>();
    Compares(mask,work,4.0f,CMPMODE::LE,count);
    Compares(magnitude,approximate,1.99999f,CMPMODE::GE,count);PipeBarrier<PIPE_V>();
    And(mask.ReinterpretCast<uint16_t>(),mask.ReinterpretCast<uint16_t>(),
        magnitude.ReinterpretCast<uint16_t>(),maskBytes/2);PipeBarrier<PIPE_V>();
    // Negative half subnormals have a uniform 2^-24 quantum. Work in that
    // lattice directly instead of sending every tiny value to scalar math.
    Muls(approximate,approximate,-16777216.0f,count);PipeBarrier<PIPE_V>();
    Maxs(approximate,approximate,0.0f,count);PipeBarrier<PIPE_V>();
    Mins(approximate,approximate,1024.0f,count);PipeBarrier<PIPE_V>();
    Cast(work.ReinterpretCast<int32_t>(),approximate,RoundMode::CAST_FLOOR,count);PipeBarrier<PIPE_V>();
    Cast(work,work.ReinterpretCast<int32_t>(),RoundMode::CAST_NONE,count);PipeBarrier<PIPE_V>();
    Sub(work,approximate,work,count);PipeBarrier<PIPE_V>();
    Adds(work,work,-0.5f,count);PipeBarrier<PIPE_V>();
    Abs(work,work,count);PipeBarrier<PIPE_V>();
    Compares(negative,work,0.008f,CMPMODE::LE,count);PipeBarrier<PIPE_V>();
    Or(mask.ReinterpretCast<uint16_t>(),mask.ReinterpretCast<uint16_t>(),
        negative.ReinterpretCast<uint16_t>(),maskBytes/2);PipeBarrier<PIPE_V>();
    SetFlag<HardEvent::V_S>(EVENT_ID3);WaitFlag<HardEvent::V_S>(EVENT_ID3);
    auto bits=mask.ReinterpretCast<uint64_t>();
    auto words=output.ReinterpretCast<uint16_t>();
    for(int32_t block=0;block<(count+63)/64;++block) {
        uint64_t candidates=bits.GetValue(block);
        if(block*64+64>count)candidates&=(uint64_t(1)<<(count-block*64))-1;
        while(candidates) {
            const uint32_t index=block*64+__builtin_ctzll(candidates);
            words.SetValue(index,repair_math::CompensatedGeluHalfBits(input.GetValue(index)));
            candidates&=candidates-1;
        }
    }
    SetFlag<HardEvent::S_V>(EVENT_ID3);WaitFlag<HardEvent::S_V>(EVENT_ID3);
}

// Independent implementation of z*sigmoid(2*sqrt(2/pi)*(z+0.044715*z^3)).
// Sign-stable exponentials keep both positive and negative tails finite.
// This performance prototype has no rounding certificate or scalar repair.
__aicore__ inline void Gelu(LocalTensor<float> z, LocalTensor<float> argument,
                           LocalTensor<float> denominator, LocalTensor<half> output,
                           int32_t count, LocalTensor<half> alternatives) {
    GeluEstimate(z,argument,denominator,output,count);

}

class Activation {
    static constexpr int Capacity=32*256;
    TBuf<TPosition::VECCALC> storage;
    LocalTensor<int32_t> integers;
    LocalTensor<float> z,argument,denominator,coefficients;
    LocalTensor<half> result;
    GlobalTensor<float> scales;
    GlobalTensor<half> output;
    TPipe* owner;
    int32_t outputColumns;
    event_t inputFree,inputReady,padReady,outputReady[2],outputDone[2];
    __aicore__ inline void Read(GlobalTensor<int32_t> product,int offset,int rows,int nr,int pitch) {
        WaitFlag<HardEvent::V_MTE2>(inputFree);
        DataCopyPad(integers,product[offset*pitch],
            DataCopyExtParams{uint16_t(rows),uint32_t(nr*4),uint32_t((pitch-nr)*4),
                             uint32_t((pitch-((nr+7)&~7))/8),0},
            DataCopyPadExtParams<int32_t>{true,0,0,0});
        SetFlag<HardEvent::MTE2_V>(inputReady);
    }
public:
    __aicore__ inline void Init(TPipe& pipe,GM_ADDR scale,GM_ADDR y,int32_t width) {
        owner=&pipe;outputColumns=width;pipe.InitBuffer(storage,Capacity*20+1024);
        auto bytes=storage.Get<uint8_t>();
        integers=bytes.ReinterpretCast<int32_t>();z=bytes[Capacity*4].ReinterpretCast<float>();
        argument=bytes[Capacity*8].ReinterpretCast<float>();denominator=bytes[Capacity*12].ReinterpretCast<float>();
        result=bytes[Capacity*16].ReinterpretCast<half>();coefficients=bytes[Capacity*20].ReinterpretCast<float>();
        scales.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scale));
        output.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y));
        inputFree=static_cast<event_t>(pipe.AllocEventID<HardEvent::V_MTE2>());
        inputReady=static_cast<event_t>(pipe.AllocEventID<HardEvent::MTE2_V>());
        padReady=static_cast<event_t>(pipe.AllocEventID<HardEvent::V_MTE2>());
        for(int slot=0;slot<2;++slot) {
            outputReady[slot]=static_cast<event_t>(pipe.AllocEventID<HardEvent::V_MTE3>());
            outputDone[slot]=static_cast<event_t>(pipe.AllocEventID<HardEvent::MTE3_V>());
        }
        SetFlag<HardEvent::V_MTE2>(inputFree);
    }
    __aicore__ inline void Consume(GlobalTensor<int32_t> product,const OutputTile& tile) {
        const int pitch=tile.pitch,nr=tile.columns;
        if(nr!=pitch) {
            Duplicate(coefficients,0.0f,pitch);
            Duplicate(integers,int32_t(0),Capacity);
        }
        SetFlag<HardEvent::V_MTE2>(padReady);WaitFlag<HardEvent::V_MTE2>(padReady);
        DataCopyPad(coefficients,scales[int64_t(tile.expert)*outputColumns+tile.firstColumn],
                    DataCopyExtParams{1,uint32_t(nr*4),0,0,0},
                    DataCopyPadExtParams<float>{true,0,0,0});
        bool pending[2]={false,false};int serial=0;
        Read(product,0,tile.rows<32?tile.rows:32,nr,pitch);
        for(int offset=0;offset<tile.rows;offset+=32) {
            const int rows=tile.rows-offset<32?tile.rows-offset:32,count=rows*pitch;
            WaitFlag<HardEvent::MTE2_V>(inputReady);
            Cast(z,integers,RoundMode::CAST_RINT,count);PipeBarrier<PIPE_V>();
            SetFlag<HardEvent::V_MTE2>(inputFree);
            if(offset+32<tile.rows) {
                const int left=tile.rows-offset-32;
                Read(product,offset+32,left<32?left:32,nr,pitch);
            }
            for(int column=0;column<pitch;column+=64) {
                const int lanes=pitch-column<64?pitch-column:64;
                Mul(z[column],z[column],coefficients[column],uint64_t(lanes),uint8_t(rows),
                    BinaryRepeatParams{1,1,1,uint8_t(pitch/8),uint8_t(pitch/8),0});
            }
            PipeBarrier<PIPE_V>();
            const int slot=serial++&1;
            if(pending[slot])WaitFlag<HardEvent::MTE3_V>(outputDone[slot]);
