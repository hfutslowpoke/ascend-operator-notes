// Estimate service cost from padded work plus a per-tile overhead allowance.
// Prefixes are computed from this invocation's actual device group boundaries.
template<class Reader> class qc0 {
    Reader ends;
    qol shape;
    uint32_t expert=0,begin=0,end=0,rows=0,rowBlock=0,column=0;
    uint32_t panels,widePanels,narrowWidth,columnUnits;
    uint64_t groupBase=0,lower,upper,serial=0;
