class qvv {
    static constexpr uint32_t Capacity=8192;
    AscendC::TBuf<AscendC::TPosition::VECCALC> storage;
    AscendC::LocalTensor<float> argument,temporary;
    AscendC::LocalTensor<half> outputs;
    AscendC::TPipe* pipe;
    event_t completed[2];
    bool pending[2]={false,false};
    uint32_t sequence=0,slot=0;
public:
    AscendC::LocalTensor<float> z,q7j;
    AscendC::LocalTensor<int32_t> qia;
    AscendC::LocalTensor<half> q3r,qhu;
    template<bool Unused=false> __aicore__ inline void qyv(AscendC::TPipe& p,uint32_t) {
        using namespace AscendC;
        pipe=&p;p.InitBuffer(storage,Capacity*16);
        auto bytes=storage.Get<uint8_t>();
        z=bytes.ReinterpretCast<float>();argument=bytes[Capacity*4].ReinterpretCast<float>();
        temporary=bytes[Capacity*8].ReinterpretCast<float>();outputs=bytes[Capacity*12].ReinterpretCast<half>();
        q3r=outputs;qhu=q3r;q7j=argument;qia=temporary.ReinterpretCast<int32_t>();
        for(int i=0;i<2;++i)completed[i]=static_cast<event_t>(p.AllocEventID<HardEvent::MTE3_V>());
    }
    __aicore__ inline void qy6(uint32_t count) {
        using namespace AscendC;
        slot=sequence++&1;
        if(pending[slot]){WaitFlag<HardEvent::MTE3_V>(completed[slot]);pending[slot]=false;}
        q3r=outputs[slot*Capacity];qhu=q3r;
        best_stream::ShortHalfActivation<Capacity>(z,argument,temporary,q3r,count);
    }
    __aicore__ inline void qah(uint32_t){}
    __aicore__ inline void qsk(uint32_t){}
    __aicore__ inline void PublishOutput() {
        AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(completed[slot]);pending[slot]=true;
    }
    __aicore__ inline void DrainOutput() {
        for(int i=0;i<2;++i)if(pending[i]){
            AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(completed[i]);pending[i]=false;
        }
    }
    __aicore__ inline void Finish() {
        DrainOutput();
        for(int i=0;i<2;++i)pipe->ReleaseEventID<AscendC::HardEvent::MTE3_V>(completed[i]);
    }
}
;
