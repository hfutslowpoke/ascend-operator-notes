class SelectiveColumns {
    GlobalTensor<int64_t> ends;
    Geometry shape;
    sdk_gmmg::GroupCursor fallback;
    int64_t wanted=0,prefix=0,count=0,first=0,end=0;
    int expert=-1,remaining=0,panels;
    bool selective=false;
public:
    __aicore__ SelectiveColumns(TPipe&,GM_ADDR groups,Geometry g,int lane,GM_ADDR)
        :shape(g),fallback(groups,g,lane,g.blocks),panels((g.columns+255)/256) {
        ends.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups));
        int64_t total=0,previous=0;
        for(int e=0;e<g.experts;++e) {
            const int64_t boundary=ends.GetValue(e);
            total+=((boundary-previous+g.rowTile-1)/g.rowTile)*panels;
            previous=boundary;
        }
        if(!(panels&1)&&g.blocks<total&&total<=2*g.blocks) {
            selective=true;
            const int paired=total-g.blocks;
            if(lane<paired){wanted=2*lane;remaining=2;}
            else {wanted=paired+lane;remaining=1;}
        }
    }
    __aicore__ bool Next(OutputTile& tile) {
        if(!selective)return fallback.Next(tile);
        if(!remaining)return false;
        while(wanted>=prefix+count) {
            prefix+=count;first=end;
            if(++expert>=shape.experts)return false;
            end=ends.GetValue(expert);
            count=((end-first+shape.rowTile-1)/shape.rowTile)*panels;
        }
        const int64_t local=wanted-prefix;
        const int64_t row=first+(local/panels)*shape.rowTile;
        const int column=(local%panels)*256;
        tile={};tile.firstRow=row;tile.expert=expert;tile.firstColumn=column;
        tile.rows=end-row<shape.rowTile?int(end-row):shape.rowTile;
        tile.columns=shape.columns-column<256?shape.columns-column:256;tile.pitch=256;
        ++wanted;--remaining;
        return true;
    }
};

class AdjacentColumns {
    GlobalTensor<int64_t> ends;Geometry g;
    int64_t wanted,prefix=0,jobs=0,first=0,end=0;
    int expert=-1,side=0;
public:
    __aicore__ AdjacentColumns(TPipe&,GM_ADDR groups,Geometry shape,int lane,GM_ADDR):g(shape),wanted(lane){
        ends.SetGlobalBuffer((__gm__ int64_t*)groups);
    }
    __aicore__ bool Next(OutputTile& tile){
        const int pairs=(g.columns+511)/512;
        for(;;){
            while(wanted>=prefix+jobs){prefix+=jobs;first=end;if(++expert>=g.experts)return false;
                end=ends.GetValue(expert);jobs=((end-first+g.rowTile-1)/g.rowTile)*pairs;}
            const int64_t local=wanted-prefix;
            const int64_t row=first+(local/pairs)*g.rowTile;
            const int col=(local%pairs)*512+side*256;
            if(col>=g.columns){side=0;wanted+=g.blocks;continue;}
            tile={};tile.expert=expert;tile.firstRow=row;tile.firstColumn=col;
            tile.rows=end-row<g.rowTile?int(end-row):g.rowTile;
            tile.columns=g.columns-col<256?g.columns-col:256;tile.pitch=256;
            if(++side==2||col+256>=g.columns){side=0;wanted+=g.blocks;}
            return true;
        }
    }
};




template<int Rows,int CacheK> class LookaheadPackageProduct {
    static constexpr int Step=128,Banks=2,Steps=CacheK/Step;
    TBuf<TPosition::A1> leftCache;
    TBuf<TPosition::B1> rightCache;
    TBuf<TPosition::A2> leftOperand;
    TBuf<TPosition::B2> rightOperand;
    TBuf<TPosition::CO1> accumulator;
    LocalTensor<int8_t> a1,b1,a0,b0;
    LocalTensor<int32_t> c0;
    GlobalTensor<int8_t> a,b;
    Geometry shape;TPipe* owner;int origin=0;bool primed=false;
    event_t freeCache[Banks],readyCache[Banks],freeOperand[2],readyOperand[2];
    event_t exportReady,exportDone;
    __aicore__ inline void Fetch(OutputTile tile,int package,int bank) {
        WaitFlag<HardEvent::MTE1_MTE2>(freeCache[bank]);
        Nd2NzParams left{};
        const int remaining=shape.inputK-package*CacheK;
        const int extent=remaining<CacheK?remaining:CacheK;
        left.ndNum=1;left.nValue=tile.rows;left.dValue=extent;left.srcDValue=shape.inputK;
        left.dstNzC0Stride=Rows;left.dstNzNStride=1;
        DataCopy(a1[bank*Rows*CacheK],a[tile.firstRow*shape.inputK+package*CacheK],left);
        Nd2NzParams right{};
        right.ndNum=1;right.nValue=extent;right.dValue=256;right.srcDValue=shape.inputN;
        right.dstNzC0Stride=CacheK;right.dstNzNStride=1;
        DataCopy(b1[bank*256*CacheK],b[(int64_t(tile.expert)*shape.inputK+package*CacheK)*shape.inputN+tile.firstColumn],right);
        SetFlag<HardEvent::MTE2_MTE1>(readyCache[bank]);
    }
public:
    __aicore__ inline void Init(TPipe& pipe,GM_ADDR x,GM_ADDR w,Geometry g) {
        owner=&pipe;shape=g;
        a.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
        b.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(w));
        pipe.InitBuffer(leftCache,Banks*Rows*CacheK);pipe.InitBuffer(rightCache,Banks*256*CacheK);
        pipe.InitBuffer(leftOperand,2*Rows*Step);pipe.InitBuffer(rightOperand,2*256*Step);
        pipe.InitBuffer(accumulator,Rows*256*4);
        a1=leftCache.Get<int8_t>();b1=rightCache.Get<int8_t>();
        a0=leftOperand.Get<int8_t>();b0=rightOperand.Get<int8_t>();c0=accumulator.Get<int32_t>();
        for(int bank=0;bank<Banks;++bank) {
            freeCache[bank]=static_cast<event_t>(pipe.AllocEventID<HardEvent::MTE1_MTE2>());
            readyCache[bank]=static_cast<event_t>(pipe.AllocEventID<HardEvent::MTE2_MTE1>());
            SetFlag<HardEvent::MTE1_MTE2>(freeCache[bank]);
        }
        for(int bank=0;bank<2;++bank) {
            freeOperand[bank]=static_cast<event_t>(pipe.AllocEventID<HardEvent::M_MTE1>());
            readyOperand[bank]=static_cast<event_t>(pipe.AllocEventID<HardEvent::MTE1_M>());
            SetFlag<HardEvent::M_MTE1>(freeOperand[bank]);
        }
        exportReady=static_cast<event_t>(pipe.AllocEventID<HardEvent::M_FIX>());
        exportDone=static_cast<event_t>(pipe.AllocEventID<HardEvent::FIX_M>());
    }
    __aicore__ inline void Run(OutputTile tile,GlobalTensor<int32_t> destination,int credit,OutputTile next={},bool more=false) {
        const int packages=(shape.inputK+CacheK-1)/CacheK;
        if(!primed)for(int p=0;p<Banks && p<packages;++p)Fetch(tile,p,(origin+p)%Banks);
        for(int p=0;p<packages;++p) {
            const int cache=(origin+p)%Banks;
            WaitFlag<HardEvent::MTE2_MTE1>(readyCache[cache]);
            const int remaining=(shape.inputK-p*CacheK)/Step;
            const int steps=remaining<Steps?remaining:Steps;
            for(int step=0;step<steps;++step) {
                const int operand=step&1;
                WaitFlag<HardEvent::M_MTE1>(freeOperand[operand]);
                LoadData2DParams left{};left.repeatTimes=Step/32;left.srcStride=Rows/16;
                for(int row=0;row<Rows;row+=16)
                    LoadData(a0[operand*Rows*Step+row*Step],a1[cache*Rows*CacheK+step*Step*Rows+row*32],left);
                LoadData2dTransposeParams right{};right.repeatTimes=8;right.srcStride=CacheK/32;
                right.dstGap=1;right.dstFracGap=0;
                for(int k=0;k<Step;k+=32)
                    LoadDataWithTranspose(b0[operand*256*Step+k*256],b1[cache*256*CacheK+(step*Step+k)*32],right);
                SetFlag<HardEvent::MTE1_M>(readyOperand[operand]);
                if(step+1==steps) {
                    SetFlag<HardEvent::MTE1_MTE2>(freeCache[cache]);
                    if(p+Banks<packages)Fetch(tile,p+Banks,cache);
                    else if(more && packages>=Banks)Fetch(next,p+Banks-packages,cache);
                }
                WaitFlag<HardEvent::MTE1_M>(readyOperand[operand]);
                MmadParams dot{};dot.m=Rows;dot.n=256;dot.k=Step;dot.cmatrixInitVal=(p==0 && step==0);
                Mmad(c0,a0[operand*Rows*Step],b0[operand*256*Step],dot);
                SetFlag<HardEvent::M_MTE1>(freeOperand[operand]);
            }
        }
        primed=more && packages>=Banks;origin=(origin+packages)%Banks;
        SetFlag<HardEvent::M_FIX>(exportReady);WaitFlag<HardEvent::M_FIX>(exportReady);
        CrossCoreWaitFlag<2,PIPE_FIX>(credit);
        FixpipeParamsV220 copy{};copy.nSize=256;copy.mSize=tile.rows;copy.srcStride=Rows;copy.dstStride=256;
        copy.ndNum=1;copy.quantPre=QuantMode_t::NoQuant;
        Fixpipe<int32_t,int32_t>(destination,c0,copy);CrossCoreSetFlag<2,PIPE_FIX>(credit);
        SetFlag<HardEvent::FIX_M>(exportDone);WaitFlag<HardEvent::FIX_M>(exportDone);
    }
    __aicore__ inline void Drain() {
        for(int i=0;i<Banks;++i) {
            WaitFlag<HardEvent::MTE1_MTE2>(freeCache[i]);
            owner->ReleaseEventID<HardEvent::MTE1_MTE2>(freeCache[i]);
            owner->ReleaseEventID<HardEvent::MTE2_MTE1>(readyCache[i]);
        }
        for(int i=0;i<2;++i) {
            WaitFlag<HardEvent::M_MTE1>(freeOperand[i]);
            owner->ReleaseEventID<HardEvent::M_MTE1>(freeOperand[i]);
            owner->ReleaseEventID<HardEvent::MTE1_M>(readyOperand[i]);
        }
        owner->ReleaseEventID<HardEvent::M_FIX>(exportReady);owner->ReleaseEventID<HardEvent::FIX_M>(exportDone);
    }
};
template<int Rows,int CacheK> class FlagLookaheadProduct {
    static constexpr int Step=128,Banks=2,Steps=CacheK/Step;
    TBuf<TPosition::A1> leftCache;
    TBuf<TPosition::B1> rightCache;
    TBuf<TPosition::A2> leftOperand;
    TBuf<TPosition::B2> rightOperand;
    TBuf<TPosition::CO1> accumulator;
    LocalTensor<int8_t> a1,b1,a0,b0;
    LocalTensor<int32_t> c0;
    GlobalTensor<int8_t> a,b;
    Geometry shape;TPipe* owner;int origin=0;bool primed=false;
    event_t freeCache[Banks],readyCache[Banks],freeOperand[2],readyOperand[2];
    event_t exportReady,exportDone;
    __aicore__ inline void Fetch(OutputTile tile,int package,int bank,bool refill=true) {
        WaitFlag<HardEvent::MTE1_MTE2>(freeCache[bank]);
        Nd2NzParams left{};
        const int remaining=shape.inputK-package*CacheK;
        const int extent=remaining<CacheK?remaining:CacheK;
        left.ndNum=1;left.nValue=tile.rows;left.dValue=extent;left.srcDValue=shape.inputK;
        left.dstNzC0Stride=Rows;left.dstNzNStride=1;
        DataCopy(a1[bank*Rows*CacheK],a[tile.firstRow*shape.inputK+package*CacheK],left);
        if(refill) {
        Nd2NzParams right{};
        right.ndNum=1;right.nValue=extent;right.dValue=256;right.srcDValue=shape.inputN;
        right.dstNzC0Stride=CacheK;right.dstNzNStride=1;
        DataCopy(b1[bank*256*CacheK],b[(int64_t(tile.expert)*shape.inputK+package*CacheK)*shape.inputN+tile.firstColumn],right);
        }
        SetFlag<HardEvent::MTE2_MTE1>(readyCache[bank]);
    }
public:
    __aicore__ inline void Init(TPipe& pipe,GM_ADDR x,GM_ADDR w,Geometry g) {
        owner=&pipe;shape=g;SetMMRowMajor();
        a.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
        b.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(w));
        pipe.InitBuffer(leftCache,Banks*Rows*CacheK);pipe.InitBuffer(rightCache,Banks*256*CacheK);
        pipe.InitBuffer(leftOperand,2*Rows*Step);pipe.InitBuffer(rightOperand,2*256*Step);
        pipe.InitBuffer(accumulator,Rows*256*4);
        a1=leftCache.Get<int8_t>();b1=rightCache.Get<int8_t>();
        a0=leftOperand.Get<int8_t>();b0=rightOperand.Get<int8_t>();c0=accumulator.Get<int32_t>();
        for(int bank=0;bank<Banks;++bank) {
            freeCache[bank]=static_cast<event_t>(pipe.AllocEventID<HardEvent::MTE1_MTE2>());
            readyCache[bank]=static_cast<event_t>(pipe.AllocEventID<HardEvent::MTE2_MTE1>());
            SetFlag<HardEvent::MTE1_MTE2>(freeCache[bank]);
        }
        for(int bank=0;bank<2;++bank) {
            freeOperand[bank]=static_cast<event_t>(pipe.AllocEventID<HardEvent::M_MTE1>());
            readyOperand[bank]=static_cast<event_t>(pipe.AllocEventID<HardEvent::MTE1_M>());
            SetFlag<HardEvent::M_MTE1>(freeOperand[bank]);
        }
        exportReady=static_cast<event_t>(pipe.AllocEventID<HardEvent::M_FIX>());
        exportDone=static_cast<event_t>(pipe.AllocEventID<HardEvent::FIX_M>());
    }
    __aicore__ inline void Run(OutputTile tile,GlobalTensor<int32_t> destination,int credit,OutputTile next={},bool more=false) {
        const int packages=(shape.inputK+CacheK-1)/CacheK;
        if(!primed)for(int p=0;p<Banks && p<packages;++p)Fetch(tile,p,(origin+p)%Banks);
        for(int p=0;p<packages;++p) {
            const int cache=(origin+p)%Banks;
            WaitFlag<HardEvent::MTE2_MTE1>(readyCache[cache]);
            const int remaining=(shape.inputK-p*CacheK)/Step;
            const int steps=remaining<Steps?remaining:Steps;
            for(int step=0;step<steps;++step) {
                const int operand=step&1;
                WaitFlag<HardEvent::M_MTE1>(freeOperand[operand]);
                LoadData2DParams left{};left.repeatTimes=Step/32;left.srcStride=Rows/16;
                for(int row=0;row<Rows;row+=16)
                    LoadData(a0[operand*Rows*Step+row*Step],a1[cache*Rows*CacheK+step*Step*Rows+row*32],left);
                LoadData2dTransposeParams right{};right.repeatTimes=8;right.srcStride=CacheK/32;
                right.dstGap=1;right.dstFracGap=0;
                for(int k=0;k<Step;k+=32)
                    LoadDataWithTranspose(b0[operand*256*Step+k*256],b1[cache*256*CacheK+(step*Step+k)*32],right);
                SetFlag<HardEvent::MTE1_M>(readyOperand[operand]);
                if(step+1==steps) {
                    SetFlag<HardEvent::MTE1_MTE2>(freeCache[cache]);
                    if(p+Banks<packages)Fetch(tile,p+Banks,cache);
                    else if(more && packages>=Banks)Fetch(next,p+Banks-packages,cache,packages>Banks||next.expert!=tile.expert||next.firstColumn!=tile.firstColumn);
                }
                WaitFlag<HardEvent::MTE1_M>(readyOperand[operand]);
                MmadParams dot{};dot.m=Rows;dot.n=256;dot.k=Step;dot.cmatrixInitVal=(p==0 && step==0);dot.unitFlag=(p+1==packages&&step+1==steps)?3:2;
                Mmad(c0,a0[operand*Rows*Step],b0[operand*256*Step],dot);
                SetFlag<HardEvent::M_MTE1>(freeOperand[operand]);
            }
        }
        primed=more && packages>=Banks;origin=(origin+packages)%Banks;

        CrossCoreWaitFlag<2,PIPE_FIX>(credit);
        FixpipeParamsV220 copy{};copy.nSize=256;copy.mSize=Rows;copy.unitFlag=3;copy.srcStride=Rows;copy.dstStride=256;
        copy.ndNum=1;copy.quantPre=QuantMode_t::NoQuant;
        Fixpipe<int32_t,int32_t>(destination,c0,copy);CrossCoreSetFlag<2,PIPE_FIX>(credit);

    }
    __aicore__ inline void Drain() {
        for(int i=0;i<Banks;++i) {
            WaitFlag<HardEvent::MTE1_MTE2>(freeCache[i]);
            owner->ReleaseEventID<HardEvent::MTE1_MTE2>(freeCache[i]);
            owner->ReleaseEventID<HardEvent::MTE2_MTE1>(readyCache[i]);
        }
        for(int i=0;i<2;++i) {
            WaitFlag<HardEvent::M_MTE1>(freeOperand[i]);
            owner->ReleaseEventID<HardEvent::M_MTE1>(freeOperand[i]);
            owner->ReleaseEventID<HardEvent::MTE1_M>(readyOperand[i]);
        }
        owner->ReleaseEventID<HardEvent::M_FIX>(exportReady);owner->ReleaseEventID<HardEvent::FIX_M>(exportDone);
    }
};



class DirectExpertOrder {
    GlobalTensor<int64_t> boundaries;
    Geometry shape;
    int expert,limit;
    int64_t row=0,stop=0;
    bool opened=false;
public:
    __aicore__ inline DirectExpertOrder(TPipe&,GM_ADDR groups,Geometry g,int pair,GM_ADDR)
        : shape(g),expert(pair*g.experts/g.blocks),limit((pair+1)*g.experts/g.blocks) {
        boundaries.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups));
        row=expert?boundaries.GetValue(expert-1):0;stop=row;
    }
    __aicore__ inline bool Next(OutputTile& tile) {
        while(expert<limit) {
            if(!opened) {
                stop=boundaries.GetValue(expert);opened=true;
            }
            if(row<stop) {
                tile.firstRow=row;tile.expert=expert;tile.firstColumn=0;
                tile.rows=int(stop-row<shape.rowTile?stop-row:shape.rowTile);
                tile.columns=shape.columns;tile.pitch=256;
                row+=tile.rows;return true;
            }
            ++expert;opened=false;
        }
        return false;
    }
};

class ColumnReuseOrder {
    GlobalTensor<int64_t> boundaries;
    Geometry shape;
    int64_t wanted=0,stop=0,prefix=0,first=0,last=0,groupTiles=0;
    int expert=-1,rowTiles=0,columns=0;
public:
    __aicore__ inline ColumnReuseOrder(TPipe&,GM_ADDR groups,Geometry g,int pair,GM_ADDR)
        : shape(g),columns((g.columns+g.columnTile-1)/g.columnTile) {
        boundaries.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups),g.experts);
        int64_t previous=0,total=0;
        for(int e=0;e<g.experts;++e) {
            const int64_t end=boundaries.GetValue(e);
            total+=((end-previous+g.rowTile-1)/g.rowTile)*columns;
            previous=end;
        }
        wanted=total*pair/g.blocks;stop=total*(pair+1)/g.blocks;
    }
    __aicore__ inline bool Next(OutputTile& result) {
        if(wanted>=stop)return false;
        while(wanted>=prefix+groupTiles) {
            prefix+=groupTiles;first=last;
            if(++expert>=shape.experts)return false;
            last=boundaries.GetValue(expert);
            rowTiles=int((last-first+shape.rowTile-1)/shape.rowTile);
            groupTiles=int64_t(rowTiles)*columns;
        }
        const int64_t local=wanted++-prefix;
        result.firstRow=first+(local%rowTiles)*shape.rowTile;
        result.firstColumn=int(local/rowTiles)*shape.columnTile;
        result.expert=expert;
        result.rows=int(last-result.firstRow);
        if(result.rows>shape.rowTile)result.rows=shape.rowTile;
        result.columns=shape.columns-result.firstColumn;
        if(result.columns>shape.columnTile)result.columns=shape.columnTile;
        result.pitch=sdk_gmmg::Round32(result.columns);
        return true;
    }
};

template<bool Indexed> class TileOrder {
    GroupCursor cursor;
    TBuf<TPosition::VECCALC> localStorage;
    TBuf<TPosition::VECCALC> boundaryStorage;
    LocalTensor<int32_t> local;
    GlobalTensor<int32_t> published;
    int count=0,index=0;
public:
    __aicore__ inline TileOrder(TPipe& pipe,GM_ADDR groups,Geometry g,int pair,GM_ADDR table)
        : cursor(groups,g,pair,g.blocks) {
        if constexpr(Indexed) {
            published.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(table)+pair*2048);
            if ASCEND_IS_AIV {
                pipe.InitBuffer(localStorage,8192);local=localStorage.Get<int32_t>();
                pipe.InitBuffer(boundaryStorage,1024);
                auto ends=boundaryStorage.Get<int64_t>();
                GlobalTensor<int64_t> source;source.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups));
                DataCopyPad(ends,source,DataCopyExtParams{1,uint32_t(g.experts*8),0,0,0},
                            DataCopyPadExtParams<int64_t>{false,0,0,0});
                auto copied=pipe.FetchEventID(HardEvent::MTE2_S);
                SetFlag<HardEvent::MTE2_S>(copied);WaitFlag<HardEvent::MTE2_S>(copied);
                int64_t first=0,prefix=0,wanted=pair;
                for(int expert=0;expert<g.experts;++expert) {
                    const int64_t end=ends.GetValue(expert);
                    const int64_t stop=prefix+(end-first+g.rowTile-1)/g.rowTile;
                    while(wanted<stop) {
                        const int row=int(first+(wanted-prefix)*g.rowTile);
                        const int rows=end-row<g.rowTile?int(end-row):g.rowTile;
                        const int offset=8+4*count++;
                        local.SetValue(offset,row);local.SetValue(offset+1,expert);
                        local.SetValue(offset+2,rows);local.SetValue(offset+3,0);
                        wanted+=g.blocks;
                    }
                    prefix=stop;first=end;
                }
                const int used=8+4*count,aligned=(used+7)&~7;
                local.SetValue(0,count);
                for(int i=1;i<8;++i)local.SetValue(i,0);
                for(int i=used;i<aligned;++i)local.SetValue(i,0);
                if(GetSubBlockIdx()==0) {
                    auto ready=pipe.FetchEventID(HardEvent::S_MTE3);
                    SetFlag<HardEvent::S_MTE3>(ready);WaitFlag<HardEvent::S_MTE3>(ready);
                    DataCopy(published,local,aligned);
                }
                CrossCoreSetFlag<2,PIPE_MTE3>(14);
            } else {
                CrossCoreWaitFlag<2,PIPE_MTE2>(14);
                auto copied=pipe.FetchEventID(HardEvent::MTE2_S);
                SetFlag<HardEvent::MTE2_S>(copied);WaitFlag<HardEvent::MTE2_S>(copied);
                DataCacheCleanAndInvalid<int32_t,CacheLine::SINGLE_CACHE_LINE,DcciDst::CACHELINE_OUT>(published);
                count=published.GetValue(0);
            }
        }
    }
    __aicore__ inline bool Next(OutputTile& tile) {
        if constexpr(!Indexed)return cursor.Next(tile);
        else {
            if(index==count)return false;
            const int offset=8+4*index++;
            if ASCEND_IS_AIC {
                if(!(offset&15))DataCacheCleanAndInvalid<int32_t,CacheLine::SINGLE_CACHE_LINE,DcciDst::CACHELINE_OUT>(published[offset]);
                tile.firstRow=published.GetValue(offset);tile.expert=published.GetValue(offset+1);
                tile.rows=published.GetValue(offset+2);tile.firstColumn=published.GetValue(offset+3);
            } else {
                tile.firstRow=local.GetValue(offset);tile.expert=local.GetValue(offset+1);
                tile.rows=local.GetValue(offset+2);tile.firstColumn=local.GetValue(offset+3);
            }
            tile.columns=256;tile.pitch=256;return true;
        }
    }
};

template<int Rows,int Reduction,int Ahead,bool DirectSdk,bool Pack,bool AcrossTile=false,int Activation=0,int ProductPolicy=0,int ChunkRows=16>
__aicore__ inline void Execute(GM_ADDR x,GM_ADDR w,GM_ADDR s,GM_ADDR groups,GM_ADDR y,
                              GM_ADDR system,GM_ADDR scratch,GM_ADDR prepared,Geometry g,TCubeTiling tiling) {
    InitSocState();
    if constexpr(Pack) {
        if ASCEND_IS_AIV {if constexpr(ProductPolicy==9)sdk_gmmg::PrepareInputsOverlapped(x,w,prepared,g,groups);else sdk_gmmg::PrepareInputs(x,w,prepared,g,groups);}
        SyncAll<false>();
        x=prepared;w=prepared+int64_t(g.rows)*g.inputK;
    }
    if constexpr(DirectSdk) {SetSysWorkspaceForce(system);clearWorkspace(system);}
    TPipe pipe;
    if constexpr(Reduction==256) {
        g.rowTile=Rows;g.columnTile=256;g.columns=256;g.reduction=256;g.inputK=256;g.inputN=256;
    }
    int pair=GetBlockIdx();
    if ASCEND_IS_AIV {pair/=2;}
    GlobalTensor<int32_t> ring;
    ring.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(scratch)+int64_t(pair)*2*Rows*256);
    typename std::conditional<ProductPolicy==10,SelectiveColumns,typename std::conditional<ProductPolicy==7,AdjacentColumns,typename std::conditional<Reduction==256,DirectExpertOrder,typename std::conditional<ProductPolicy==9,ColumnReuseOrder,TileOrder<false>>::type>::type>::type>::type cursor(pipe,groups,g,pair,prepared);
    OutputTile tile{};int sequence=0;
    if ASCEND_IS_AIC {
        if constexpr(DirectSdk) {
            MatmulImpl<sdk_gmmg::InputMatrix,sdk_gmmg::InputMatrix,sdk_gmmg::IntegerMatrix> product;
            product.Init(&tiling,&pipe);
            GlobalTensor<int8_t> a,b;
            a.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));b.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(w));
            while(cursor.Next(tile)) {
                const int bank=sequence++&1;
                CrossCoreWaitFlag<2,PIPE_FIX>(8+bank);
                product.SetOrgShape(g.rows,g.inputN,g.inputK,g.inputK,256);
                product.SetSingleShape(tile.rows,tile.columns,g.inputK);
                product.SetTensorA(a[tile.firstRow*g.inputK]);
                product.SetTensorB(b[int64_t(tile.expert)*g.inputK*g.inputN+tile.firstColumn]);
                product.IterateAll(ring[bank*Rows*256]);product.End();
                CrossCoreSetFlag<2,PIPE_FIX>(8+bank);
            }
        } else {
            typename std::conditional<ProductPolicy==10,SelectiveProduct<Rows,512>,typename std::conditional<ProductPolicy==8,FlagPackageProduct<Rows,512>,typename std::conditional<ProductPolicy==9,FlagLookaheadProduct<Rows,512>,typename std::conditional<ProductPolicy==7,AdjacentProduct<Rows,512>,typename std::conditional<ProductPolicy==1,LookaheadPackageProduct<Rows,512>,typename std::conditional<ProductPolicy==2 || (ProductPolicy==0 && Reduction==128 && !AcrossTile && Activation!=2),PackageProduct<Rows,512>,NativeProduct<Rows,Reduction,Ahead,AcrossTile>>::type>::type>::type>::type>::type>::type product;product.Init(pipe,x,w,g);
            if constexpr(AcrossTile) {
                bool live=cursor.Next(tile);
                while(live) {
                    OutputTile next{};const bool more=cursor.Next(next);
                    const int bank=sequence++&1;
                    product.Run(tile,ring[bank*Rows*256],8+bank,next,more);
                    tile=next;live=more;
                }
            } else while(cursor.Next(tile)) {
                const int bank=sequence++&1;
                product.Run(tile,ring[bank*Rows*256],8+bank);
            }
            product.Drain();
        }
        CrossCoreWaitFlag<2,PIPE_FIX>(8);CrossCoreWaitFlag<2,PIPE_FIX>(9);
    } else {
        FinishProduct<ChunkRows> epilogue;epilogue.Init(pipe,s,y,g.columns);
        CrossCoreSetFlag<2,PIPE_MTE2>(8);CrossCoreSetFlag<2,PIPE_MTE2>(9);
        while(cursor.Next(tile)) {
            const int bank=sequence++&1,offset=GetSubBlockIdx()*(Rows/2);
            CrossCoreWaitFlag<2,PIPE_MTE2>(8+bank);
            if(offset<tile.rows) {
                tile.rows-=offset;tile.firstRow+=offset;
                if(tile.rows>Rows/2)tile.rows=Rows/2;
                epilogue.template Run<Reduction==256,Activation>(ring[bank*Rows*256+offset*256],tile,8+bank);
            } else CrossCoreSetFlag<2,PIPE_MTE2>(8+bank);
        }
        epilogue.Drain();
    }
    PipeBarrier<PIPE_ALL>();
}
template<int Rows,int CacheK> class WaveProduct {
    static constexpr int Step=128,Banks=2,Steps=CacheK/Step;
    TBuf<TPosition::A1> leftCache;
    TBuf<TPosition::B1> rightCache;
    TBuf<TPosition::A2> leftOperand;
    TBuf<TPosition::B2> rightOperand;
    TBuf<TPosition::CO1> accumulator;
    LocalTensor<int8_t> a1,b1,a0,b0;
    LocalTensor<int32_t> c0;
    GlobalTensor<int8_t> a,b;
    Geometry shape;TPipe* owner;
    event_t freeCache[Banks],readyCache[Banks],freeOperand[2],readyOperand[2];
    event_t exportReady,exportDone;
    template<int Width> __aicore__ inline void Fetch(OutputTile tile,int package,int bank) {
        WaitFlag<HardEvent::MTE1_MTE2>(freeCache[bank]);
        Nd2NzParams left{};
        const int remaining=shape.inputK-package*CacheK;
        const int extent=remaining<CacheK?remaining:CacheK;
        left.ndNum=1;left.nValue=tile.rows;left.dValue=extent;left.srcDValue=shape.inputK;
        left.dstNzC0Stride=Rows;left.dstNzNStride=1;
        DataCopy(a1[bank*Rows*CacheK],a[tile.firstRow*shape.inputK+package*CacheK],left);
        Nd2NzParams right{};
        right.ndNum=1;right.nValue=extent;right.dValue=Width;right.srcDValue=shape.inputN;
        right.dstNzC0Stride=CacheK;right.dstNzNStride=1;
        DataCopy(b1[bank*256*CacheK],b[(int64_t(tile.expert)*shape.inputK+package*CacheK)*shape.inputN+tile.firstColumn],right);
        SetFlag<HardEvent::MTE2_MTE1>(readyCache[bank]);
    }
public:
    __aicore__ inline void Init(TPipe& pipe,GM_ADDR x,GM_ADDR w,Geometry g) {
        owner=&pipe;shape=g;
        a.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
        b.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(w));
        pipe.InitBuffer(leftCache,Banks*Rows*CacheK);pipe.InitBuffer(rightCache,Banks*256*CacheK);
        pipe.InitBuffer(leftOperand,2*Rows*Step);pipe.InitBuffer(rightOperand,2*256*Step);
        pipe.InitBuffer(accumulator,Rows*256*4);
        a1=leftCache.Get<int8_t>();b1=rightCache.Get<int8_t>();
        a0=leftOperand.Get<int8_t>();b0=rightOperand.Get<int8_t>();c0=accumulator.Get<int32_t>();
        for(int bank=0;bank<Banks;++bank) {
            freeCache[bank]=static_cast<event_t>(pipe.AllocEventID<HardEvent::MTE1_MTE2>());
            readyCache[bank]=static_cast<event_t>(pipe.AllocEventID<HardEvent::MTE2_MTE1>());
            SetFlag<HardEvent::MTE1_MTE2>(freeCache[bank]);
        }
        for(int bank=0;bank<2;++bank) {
            freeOperand[bank]=static_cast<event_t>(pipe.AllocEventID<HardEvent::M_MTE1>());
            readyOperand[bank]=static_cast<event_t>(pipe.AllocEventID<HardEvent::MTE1_M>());
            SetFlag<HardEvent::M_MTE1>(freeOperand[bank]);
        }
        exportReady=static_cast<event_t>(pipe.AllocEventID<HardEvent::M_FIX>());
        exportDone=static_cast<event_t>(pipe.AllocEventID<HardEvent::FIX_M>());
    }
    template<int Width> __aicore__ inline void Run(OutputTile tile,GlobalTensor<int32_t> destination,int credit,OutputTile next={},bool more=false) {
        const int packages=(shape.inputK+CacheK-1)/CacheK;
        for(int p=0;p<Banks && p<packages;++p)Fetch<Width>(tile,p,p);
        for(int p=0;p<packages;++p) {
            const int cache=p%Banks;
            WaitFlag<HardEvent::MTE2_MTE1>(readyCache[cache]);
            const int remaining=(shape.inputK-p*CacheK)/Step;
            const int steps=remaining<Steps?remaining:Steps;
            for(int step=0;step<steps;++step) {
                const int operand=step&1;
                WaitFlag<HardEvent::M_MTE1>(freeOperand[operand]);
LoadData3DParamsV2<int8_t> bulk{};bulk.l1H=1;bulk.l1W=Rows;bulk.channelSize=CacheK;bulk.kExtension=Step;bulk.mExtension=Rows;bulk.kStartPt=step*Step;LoadData(a0[operand*Rows*Step],a1[cache*Rows*CacheK],bulk);
                LoadData2dTransposeParams right{};right.repeatTimes=Width/32;right.srcStride=CacheK/32;
                right.dstGap=1;right.dstFracGap=0;
                for(int k=0;k<Step;k+=32)
                    LoadDataWithTranspose(b0[operand*256*Step+k*Width],b1[cache*256*CacheK+(step*Step+k)*32],right);
                SetFlag<HardEvent::MTE1_M>(readyOperand[operand]);
                if(step+1==steps) {
                    SetFlag<HardEvent::MTE1_MTE2>(freeCache[cache]);
                    if(p+Banks<packages)Fetch<Width>(tile,p+Banks,cache);
                }
                WaitFlag<HardEvent::MTE1_M>(readyOperand[operand]);
                MmadParams dot{};dot.m=Rows;dot.n=Width;dot.k=Step;dot.cmatrixInitVal=(p==0 && step==0);
                Mmad(c0,a0[operand*Rows*Step],b0[operand*256*Step],dot);
                SetFlag<HardEvent::M_MTE1>(freeOperand[operand]);
            }
        }
        SetFlag<HardEvent::M_FIX>(exportReady);WaitFlag<HardEvent::M_FIX>(exportReady);
        CrossCoreWaitFlag<2,PIPE_FIX>(credit);
        FixpipeParamsV220 copy{};copy.nSize=Width;copy.mSize=tile.rows;copy.srcStride=Rows;copy.dstStride=Width;
        copy.ndNum=1;copy.quantPre=QuantMode_t::NoQuant;
        Fixpipe<int32_t,int32_t>(destination,c0,copy);CrossCoreSetFlag<2,PIPE_FIX>(credit);
        SetFlag<HardEvent::FIX_M>(exportDone);WaitFlag<HardEvent::FIX_M>(exportDone);
    }
    __aicore__ inline void Drain() {
        for(int i=0;i<Banks;++i) {
            WaitFlag<HardEvent::MTE1_MTE2>(freeCache[i]);
            owner->ReleaseEventID<HardEvent::MTE1_MTE2>(freeCache[i]);
            owner->ReleaseEventID<HardEvent::MTE2_MTE1>(readyCache[i]);
        }
        for(int i=0;i<2;++i) {
            WaitFlag<HardEvent::M_MTE1>(freeOperand[i]);
            owner->ReleaseEventID<HardEvent::M_MTE1>(freeOperand[i]);
            owner->ReleaseEventID<HardEvent::MTE1_M>(readyOperand[i]);
        }
        owner->ReleaseEventID<HardEvent::M_FIX>(exportReady);owner->ReleaseEventID<HardEvent::FIX_M>(exportDone);
    }
};

class WaveFinish {
    static constexpr int Lanes=4096;
    TBuf<TPosition::VECCALC> memory;
    LocalTensor<int32_t> incoming;
    LocalTensor<float> scaled, argument, temporary, coefficients;
    LocalTensor<half> outputs;
    GlobalTensor<float> scales;
    GlobalTensor<half> result;
    TPipe* owner;
    int columns, serial=0;
    event_t reusable, loaded, scaleAvailable, written[2], ready[2];
    __aicore__ inline void Read(GlobalTensor<int32_t> source,int offset,int rows,int width) {
        WaitFlag<HardEvent::V_MTE2>(reusable);
        DataCopy(incoming,source[offset],rows*width);
        SetFlag<HardEvent::MTE2_V>(loaded);
    }
public:
    static constexpr int Bytes=20*Lanes+1024;
    __aicore__ inline void Init(TPipe& pipe,GM_ADDR s,GM_ADDR y,int n) {
        owner=&pipe;columns=n;
        pipe.InitBuffer(memory,Bytes);
        auto bytes=memory.Get<uint8_t>();
        incoming=bytes.ReinterpretCast<int32_t>();
        scaled=bytes[Lanes*4].ReinterpretCast<float>();
        argument=bytes[Lanes*8].ReinterpretCast<float>();
        temporary=bytes[Lanes*12].ReinterpretCast<float>();
        outputs=bytes[Lanes*16].ReinterpretCast<half>();
        coefficients=bytes[Lanes*20].ReinterpretCast<float>();
        scales.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(s));
        result.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y));
        reusable=static_cast<event_t>(pipe.AllocEventID<HardEvent::V_MTE2>());
        loaded=static_cast<event_t>(pipe.AllocEventID<HardEvent::MTE2_V>());
        scaleAvailable=static_cast<event_t>(pipe.AllocEventID<HardEvent::V_MTE2>());
        SetFlag<HardEvent::V_MTE2>(reusable);
        for(int i=0;i<2;++i) {
            written[i]=static_cast<event_t>(pipe.AllocEventID<HardEvent::MTE3_V>());
            ready[i]=static_cast<event_t>(pipe.AllocEventID<HardEvent::V_MTE3>());
            SetFlag<HardEvent::MTE3_V>(written[i]);
        }
    }
    template<int Width,int Activation>
    __aicore__ inline void Run(GlobalTensor<int32_t> source,OutputTile tile,int credit) {
        if(tile.columns<Width)Duplicate(coefficients,0.0f,Width);
        SetFlag<HardEvent::V_MTE2>(scaleAvailable);WaitFlag<HardEvent::V_MTE2>(scaleAvailable);
        DataCopyPad(coefficients,scales[int64_t(tile.expert)*columns+tile.firstColumn],
                    DataCopyExtParams{1,uint32_t(tile.columns*4),0,0,0},
                    DataCopyPadExtParams<float>{true,0,0,0});
        constexpr int Chunk=Lanes/Width;const int pieces=(tile.rows+Chunk-1)/Chunk;
        Read(source,0,tile.rows<Chunk?tile.rows:Chunk,Width);
        if(pieces==1)CrossCoreSetFlag<2,PIPE_MTE2>(credit);
        for(int piece=0;piece<pieces;++piece) {
            const int first=piece*Chunk,rows=tile.rows-first<Chunk?tile.rows-first:Chunk,count=rows*Width;
            WaitFlag<HardEvent::MTE2_V>(loaded);
            Cast(scaled,incoming,RoundMode::CAST_RINT,count);PipeBarrier<PIPE_V>();
            SetFlag<HardEvent::V_MTE2>(reusable);
            if(piece+1<pieces) {
                const int remaining=tile.rows-first-Chunk;
                Read(source,(first+Chunk)*Width,remaining<Chunk?remaining:Chunk,Width);
                if(piece+2==pieces)CrossCoreSetFlag<2,PIPE_MTE2>(credit);
            }
            for(int col=0;col<Width;col+=64)
                Mul(scaled[col],scaled[col],coefficients[col],uint64_t(64),uint8_t(rows),
                    BinaryRepeatParams{1,1,1,Width/8,Width/8,0});
            PipeBarrier<PIPE_V>();
            const int slot=serial++&1;
            WaitFlag<HardEvent::MTE3_V>(written[slot]);
            auto halfOutput=outputs[slot*Lanes];
            if constexpr(Activation==3)ShortHalfActivation<Lanes>(scaled,argument,temporary,halfOutput,count);
            else if constexpr(Activation==2)HalfActivation(scaled,argument,temporary,halfOutput,count);
            else sdk_gmmg::GeluEstimate(scaled,argument,temporary,halfOutput,count);
            SetFlag<HardEvent::V_MTE3>(ready[slot]);WaitFlag<HardEvent::V_MTE3>(ready[slot]);
            DataCopyPad(result[(tile.firstRow+first)*columns+tile.firstColumn],halfOutput,
                DataCopyExtParams{uint16_t(rows),uint32_t(tile.columns*2),
                    uint32_t((Width-((tile.columns+15)&~15))/16),uint32_t((columns-tile.columns)*2),0});
            SetFlag<HardEvent::MTE3_V>(written[slot]);
        }
    }
    __aicore__ inline void Drain() {
        WaitFlag<HardEvent::V_MTE2>(reusable);
        owner->ReleaseEventID<HardEvent::V_MTE2>(reusable);
        owner->ReleaseEventID<HardEvent::MTE2_V>(loaded);
        owner->ReleaseEventID<HardEvent::V_MTE2>(scaleAvailable);
        for(int i=0;i<2;++i) {
            WaitFlag<HardEvent::MTE3_V>(written[i]);
            owner->ReleaseEventID<HardEvent::MTE3_V>(written[i]);
            owner->ReleaseEventID<HardEvent::V_MTE3>(ready[i]);
        }
    }
};

template<int Parts> class WaveCursor {
    GroupCursor normal, tail;
    int ordinal,limit,part,lanes;
    __aicore__ static int FullPrefix(GM_ADDR groups,Geometry g) {
        GlobalTensor<int64_t> ends;ends.SetGlobalBuffer((__gm__ int64_t*)groups);
        int total=0;int64_t previous=0;
        for(int expert=0;expert<g.experts;++expert){int64_t end=ends.GetValue(expert);total+=((end-previous+g.rowTile-1)/g.rowTile)*((g.columns+255)/256);previous=end;}
        return total/g.blocks*g.blocks;
    }
public:
    __aicore__ WaveCursor(GM_ADDR groups,Geometry g,int lane,int full):
      normal(groups,g,full*lane/g.blocks,1),tail(groups,g,full+lane/Parts,g.blocks/Parts),
      ordinal(full*lane/g.blocks),limit(full*(lane+1)/g.blocks),part(lane%Parts),lanes(1){}
    __aicore__ WaveCursor(GM_ADDR groups,Geometry g,int lane):WaveCursor(groups,g,lane,FullPrefix(groups,g)){}
    __aicore__ bool Next(OutputTile& tile){
        if(ordinal<limit){ordinal+=lanes;if(!normal.Next(tile))return false;tile.pitch=256;return true;}
        while(tail.Next(tile)){
            const int offset=part*(256/Parts);if(offset>=tile.columns)continue;
            tile.firstColumn+=offset;tile.columns-=offset;if(tile.columns>256/Parts)tile.columns=256/Parts;tile.pitch=256/Parts;return true;
        }return false;
    }
};
template<int Rows,int Parts,int Activation> __aicore__ inline void ExecuteWave(
 GM_ADDR x,GM_ADDR w,GM_ADDR s,GM_ADDR groups,GM_ADDR y,GM_ADDR scratch,Geometry g){
    InitSocState();int pair=GetBlockIdx();if ASCEND_IS_AIV {pair/=2;}
    GlobalTensor<int32_t> ring;ring.SetGlobalBuffer((__gm__ int32_t*)scratch+int64_t(pair)*2*Rows*256);
    WaveCursor<Parts> cursor(groups,g,pair);TPipe pipe;OutputTile tile{};int sequence=0;
    if ASCEND_IS_AIC {
        WaveProduct<Rows,512> product;product.Init(pipe,x,w,g);
        while(cursor.Next(tile)){int bank=sequence++&1;if(tile.pitch==256)product.template Run<256>(tile,ring[bank*Rows*256],8+bank);else product.template Run<256/Parts>(tile,ring[bank*Rows*256],8+bank);}
        product.Drain();CrossCoreWaitFlag<2,PIPE_FIX>(8);CrossCoreWaitFlag<2,PIPE_FIX>(9);
    }else{
        WaveFinish epilogue;epilogue.Init(pipe,s,y,g.columns);CrossCoreSetFlag<2,PIPE_MTE2>(8);CrossCoreSetFlag<2,PIPE_MTE2>(9);
        while(cursor.Next(tile)){int bank=sequence++&1,offset=GetSubBlockIdx()*(Rows/2);CrossCoreWaitFlag<2,PIPE_MTE2>(8+bank);
            if(offset<tile.rows){tile.rows-=offset;tile.firstRow+=offset;if(tile.rows>Rows/2)tile.rows=Rows/2;
                if(tile.pitch==256)epilogue.template Run<256,Activation>(ring[bank*Rows*256+offset*256],tile,8+bank);
                else epilogue.template Run<256/Parts,Activation>(ring[bank*Rows*256+offset*(256/Parts)],tile,8+bank);
            }else CrossCoreSetFlag<2,PIPE_MTE2>(8+bank);
        }epilogue.Drain();
    }PipeBarrier<PIPE_ALL>();
}


