        FixpipeParamsV220 copy{};copy.nSize=256;copy.mSize=Rows;copy.unitFlag=3;copy.srcStride=Rows;copy.dstStride=256;
        copy.ndNum=1;copy.quantPre=QuantMode_t::NoQuant;
