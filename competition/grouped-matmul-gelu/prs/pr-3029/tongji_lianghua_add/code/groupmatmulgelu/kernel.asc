namespace best_stream {
class FinishProduct512 {
    static constexpr int Lanes=8192;
    TBuf<TPosition::VECCALC> memory;
    LocalTensor<int32_t> incoming;
    LocalTensor<float> scaled, argument, temporary, coefficients;
    LocalTensor<half> outputs;
    GlobalTensor<float> scales;
    GlobalTensor<half> result;
    TPipe* owner;
    int columns, serial=0;
    event_t reusable, loaded, scaleAvailable, written[2], ready[2];
    __aicore__ inline void Read(GlobalTensor<int32_t> source,int offset,int rows) {
        WaitFlag<HardEvent::V_MTE2>(reusable);
        DataCopy(incoming,source[offset],rows*512);
        SetFlag<HardEvent::MTE2_V>(loaded);
    }
public:
    static constexpr int Bytes=20*Lanes+2048;
    __aicore__ inline void Init(TPipe& pipe,GM_ADDR s,GM_ADDR y,int n) {
        owner=&pipe;columns=n;
        pipe.InitBuffer(memory,Bytes);
        auto bytes=memory.Get<uint8_t>();
        incoming=bytes.ReinterpretCast<int32_t>();
        scaled=bytes[Lanes*4].ReinterpretCast<float>();
        argument=bytes[Lanes*8].ReinterpretCast<float>();
        temporary=bytes[Lanes*12].ReinterpretCast<float>();
        outputs=bytes[Lanes*16].ReinterpretCast<half>();
        coefficients=bytes[Lanes*20].ReinterpretCast<float>();
        scales.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(s));
        result.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y));
        reusable=static_cast<event_t>(pipe.AllocEventID<HardEvent::V_MTE2>());
        loaded=static_cast<event_t>(pipe.AllocEventID<HardEvent::MTE2_V>());
        scaleAvailable=static_cast<event_t>(pipe.AllocEventID<HardEvent::V_MTE2>());
        SetFlag<HardEvent::V_MTE2>(reusable);
        for(int i=0;i<2;++i) {
            written[i]=static_cast<event_t>(pipe.AllocEventID<HardEvent::MTE3_V>());
            ready[i]=static_cast<event_t>(pipe.AllocEventID<HardEvent::V_MTE3>());
            SetFlag<HardEvent::MTE3_V>(written[i]);
        }
    }
    template<bool HalfMath=false,int Activation=0>
    __aicore__ inline void Run(GlobalTensor<int32_t> source,OutputTile tile,int credit) {
        if(tile.columns<512)Duplicate(coefficients,0.0f,512);
        SetFlag<HardEvent::V_MTE2>(scaleAvailable);WaitFlag<HardEvent::V_MTE2>(scaleAvailable);
        DataCopyPad(coefficients,scales[int64_t(tile.expert)*columns+tile.firstColumn],
                    DataCopyExtParams{1,uint32_t(tile.columns*4),0,0,0},
                    DataCopyPadExtParams<float>{true,0,0,0});
        const int pieces=(tile.rows+15)/16;
        Read(source,0,tile.rows<16?tile.rows:16);
        if(pieces==1)CrossCoreSetFlag<2,PIPE_MTE2>(credit);
        for(int piece=0;piece<pieces;++piece) {
            const int first=piece*16,rows=tile.rows-first<16?tile.rows-first:16,count=rows*512;
            WaitFlag<HardEvent::MTE2_V>(loaded);
            Cast(scaled,incoming,RoundMode::CAST_RINT,count);PipeBarrier<PIPE_V>();
            SetFlag<HardEvent::V_MTE2>(reusable);
            if(piece+1<pieces) {
                const int remaining=tile.rows-first-16;
                Read(source,(first+16)*512,remaining<16?remaining:16);
                if(piece+2==pieces)CrossCoreSetFlag<2,PIPE_MTE2>(credit);
            }
            for(int col=0;col<512;col+=64)
                Mul(scaled[col],scaled[col],coefficients[col],uint64_t(64),uint8_t(rows),
                    BinaryRepeatParams{1,1,1,64,64,0});
            PipeBarrier<PIPE_V>();
            const int slot=serial++&1;
            WaitFlag<HardEvent::MTE3_V>(written[slot]);
            auto halfOutput=outputs[slot*Lanes];
            if constexpr(HalfMath || Activation==2)HalfActivation<Lanes>(scaled,argument,temporary,halfOutput,count);
            else sdk_gmmg::GeluEstimate(scaled,argument,temporary,halfOutput,count);
            SetFlag<HardEvent::V_MTE3>(ready[slot]);WaitFlag<HardEvent::V_MTE3>(ready[slot]);
            DataCopyPad(result[(tile.firstRow+first)*columns+tile.firstColumn],halfOutput,
                DataCopyExtParams{uint16_t(rows),uint32_t(tile.columns*2),
                    uint32_t((512-((tile.columns+15)&~15))/16),uint32_t((columns-tile.columns)*2),0});
            SetFlag<HardEvent::MTE3_V>(written[slot]);
        }
    }
    __aicore__ inline void Drain() {
        WaitFlag<HardEvent::V_MTE2>(reusable);
        owner->ReleaseEventID<HardEvent::V_MTE2>(reusable);
        owner->ReleaseEventID<HardEvent::MTE2_V>(loaded);
        owner->ReleaseEventID<HardEvent::V_MTE2>(scaleAvailable);
        for(int i=0;i<2;++i) {
            WaitFlag<HardEvent::MTE3_V>(written[i]);
            owner->ReleaseEventID<HardEvent::MTE3_V>(written[i]);
            owner->ReleaseEventID<HardEvent::V_MTE3>(ready[i]);
        }
    }
};

template<int Rows,int CacheK> class Columns512Product {
    static constexpr int Step=64,Banks=2,Steps=CacheK/Step;
    TBuf<TPosition::A1> leftCache;
    TBuf<TPosition::B1> rightCache;
    TBuf<TPosition::A2> leftOperand;
    TBuf<TPosition::B2> rightOperand;
    TBuf<TPosition::CO1> accumulator;
    LocalTensor<int8_t> a1,b1,a0,b0;
    LocalTensor<int32_t> c0;
    GlobalTensor<int8_t> a,b;
    Geometry shape;TPipe* owner;int origin=0;bool primed=false;
    event_t freeCache[Banks],readyCache[Banks],freeOperand[2],readyOperand[2];
    event_t exportReady,exportDone;
    __aicore__ inline void Fetch(OutputTile tile,int package,int bank) {
        WaitFlag<HardEvent::MTE1_MTE2>(freeCache[bank]);
        Nd2NzParams left{};
        const int remaining=shape.inputK-package*CacheK;
        const int extent=remaining<CacheK?remaining:CacheK;
        left.ndNum=1;left.nValue=tile.rows;left.dValue=extent;left.srcDValue=shape.inputK;
        left.dstNzC0Stride=Rows;left.dstNzNStride=1;
        DataCopy(a1[bank*Rows*CacheK],a[tile.firstRow*shape.inputK+package*CacheK],left);
        Nd2NzParams right{};
        right.ndNum=1;right.nValue=extent;right.dValue=512;right.srcDValue=shape.inputN;
        right.dstNzC0Stride=CacheK;right.dstNzNStride=1;
        DataCopy(b1[bank*512*CacheK],b[(int64_t(tile.expert)*shape.inputK+package*CacheK)*shape.inputN+tile.firstColumn],right);
        SetFlag<HardEvent::MTE2_MTE1>(readyCache[bank]);
    }
public:
    __aicore__ inline void Init(TPipe& pipe,GM_ADDR x,GM_ADDR w,Geometry g) {
        owner=&pipe;shape=g;
        a.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
        b.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(w));
        pipe.InitBuffer(leftCache,Banks*Rows*CacheK);pipe.InitBuffer(rightCache,Banks*512*CacheK);
        pipe.InitBuffer(leftOperand,2*Rows*Step);pipe.InitBuffer(rightOperand,2*512*Step);
        pipe.InitBuffer(accumulator,Rows*512*4);
        a1=leftCache.Get<int8_t>();b1=rightCache.Get<int8_t>();
        a0=leftOperand.Get<int8_t>();b0=rightOperand.Get<int8_t>();c0=accumulator.Get<int32_t>();
        for(int bank=0;bank<Banks;++bank) {
            freeCache[bank]=static_cast<event_t>(pipe.AllocEventID<HardEvent::MTE1_MTE2>());
            readyCache[bank]=static_cast<event_t>(pipe.AllocEventID<HardEvent::MTE2_MTE1>());
            SetFlag<HardEvent::MTE1_MTE2>(freeCache[bank]);
        }
        for(int bank=0;bank<2;++bank) {
            freeOperand[bank]=static_cast<event_t>(pipe.AllocEventID<HardEvent::M_MTE1>());
            readyOperand[bank]=static_cast<event_t>(pipe.AllocEventID<HardEvent::MTE1_M>());
            SetFlag<HardEvent::M_MTE1>(freeOperand[bank]);
        }
        exportReady=static_cast<event_t>(pipe.AllocEventID<HardEvent::M_FIX>());
        exportDone=static_cast<event_t>(pipe.AllocEventID<HardEvent::FIX_M>());
    }
    __aicore__ inline void Run(OutputTile tile,GlobalTensor<int32_t> destination,int credit,OutputTile next={},bool more=false) {
        const int packages=(shape.inputK+CacheK-1)/CacheK;
        if(!primed)for(int p=0;p<Banks && p<packages;++p)Fetch(tile,p,(origin+p)%Banks);
        for(int p=0;p<packages;++p) {
            const int cache=(origin+p)%Banks;
            WaitFlag<HardEvent::MTE2_MTE1>(readyCache[cache]);
            const int remaining=(shape.inputK-p*CacheK)/Step;
            const int steps=remaining<Steps?remaining:Steps;
            for(int step=0;step<steps;++step) {
                const int operand=step&1;
                WaitFlag<HardEvent::M_MTE1>(freeOperand[operand]);
                LoadData2DParams left{};left.repeatTimes=Rows/16;left.srcStride=1;
                left.dstGap=Step/32-1;
                for(int k32=0;k32<Step/32;++k32)
                    LoadData(a0[operand*Rows*Step+k32*512],
                             a1[cache*Rows*CacheK+step*Step*Rows+k32*Rows*32],left);
                LoadData2dTransposeParams right{};right.repeatTimes=16;right.srcStride=CacheK/32;
                right.dstGap=1;right.dstFracGap=0;
                for(int k=0;k<Step;k+=32)
                    LoadDataWithTranspose(b0[operand*512*Step+k*512],b1[cache*512*CacheK+(step*Step+k)*32],right);
                SetFlag<HardEvent::MTE1_M>(readyOperand[operand]);
                if(step+1==steps) {
                    SetFlag<HardEvent::MTE1_MTE2>(freeCache[cache]);
                    if(p+Banks<packages)Fetch(tile,p+Banks,cache);
                    else if(more && packages>=Banks)Fetch(next,p+Banks-packages,cache);
                }
                WaitFlag<HardEvent::MTE1_M>(readyOperand[operand]);
                MmadParams dot{};dot.m=Rows;dot.n=512;dot.k=Step;dot.cmatrixInitVal=(p==0 && step==0);
                Mmad(c0,a0[operand*Rows*Step],b0[operand*512*Step],dot);
                SetFlag<HardEvent::M_MTE1>(freeOperand[operand]);
            }
        }
        primed=more && packages>=Banks;origin=(origin+packages)%Banks;
        SetFlag<HardEvent::M_FIX>(exportReady);WaitFlag<HardEvent::M_FIX>(exportReady);
        CrossCoreWaitFlag<2,PIPE_FIX>(credit);
        FixpipeParamsV220 copy{};copy.nSize=512;copy.mSize=tile.rows;copy.srcStride=Rows;copy.dstStride=512;
        copy.ndNum=1;copy.quantPre=QuantMode_t::NoQuant;
        Fixpipe<int32_t,int32_t>(destination,c0,copy);CrossCoreSetFlag<2,PIPE_FIX>(credit);
        SetFlag<HardEvent::FIX_M>(exportDone);WaitFlag<HardEvent::FIX_M>(exportDone);
    }
    __aicore__ inline void Drain() {
        for(int i=0;i<Banks;++i) {
            WaitFlag<HardEvent::MTE1_MTE2>(freeCache[i]);
            owner->ReleaseEventID<HardEvent::MTE1_MTE2>(freeCache[i]);
            owner->ReleaseEventID<HardEvent::MTE2_MTE1>(readyCache[i]);
        }
        for(int i=0;i<2;++i) {
            WaitFlag<HardEvent::M_MTE1>(freeOperand[i]);
            owner->ReleaseEventID<HardEvent::M_MTE1>(freeOperand[i]);
            owner->ReleaseEventID<HardEvent::MTE1_M>(readyOperand[i]);
        }
        owner->ReleaseEventID<HardEvent::M_FIX>(exportReady);owner->ReleaseEventID<HardEvent::FIX_M>(exportDone);
    }
};

template<int CacheK>
__aicore__ inline void ExecuteColumns512(GM_ADDR x,GM_ADDR w,GM_ADDR s,GM_ADDR groups,
                                        GM_ADDR y,GM_ADDR scratch,Geometry g) {
    constexpr int Rows=64,Columns=512;
    InitSocState();TPipe pipe;
    int pair=GetBlockIdx();if ASCEND_IS_AIV {pair/=2;}
    GlobalTensor<int32_t> ring;
    ring.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(scratch)+int64_t(pair)*2*Rows*Columns);
    GroupCursor cursor(groups,g,pair,g.blocks);
    OutputTile tile{};int sequence=0;
    if ASCEND_IS_AIC {
        Columns512Product<Rows,CacheK> product;product.Init(pipe,x,w,g);
        bool live=cursor.Next(tile);
        while(live) {
            OutputTile next{};const bool more=cursor.Next(next);
            const int bank=sequence++&1;
            product.Run(tile,ring[bank*Rows*Columns],8+bank,next,more);
            tile=next;live=more;
        }
        product.Drain();
        CrossCoreWaitFlag<2,PIPE_FIX>(8);CrossCoreWaitFlag<2,PIPE_FIX>(9);
    } else {
        FinishProduct512 epilogue;epilogue.Init(pipe,s,y,g.columns);
        CrossCoreSetFlag<2,PIPE_MTE2>(8);CrossCoreSetFlag<2,PIPE_MTE2>(9);
        while(cursor.Next(tile)) {
            const int bank=sequence++&1,offset=GetSubBlockIdx()*(Rows/2);
            CrossCoreWaitFlag<2,PIPE_MTE2>(8+bank);
            if(offset<tile.rows) {
                tile.rows-=offset;tile.firstRow+=offset;
                if(tile.rows>Rows/2)tile.rows=Rows/2;
                epilogue.template Run<true,0>(ring[bank*Rows*Columns+offset*Columns],tile,8+bank);
            } else CrossCoreSetFlag<2,PIPE_MTE2>(8+bank);
        }
        epilogue.Drain();
    }
    PipeBarrier<PIPE_ALL>();
}

}


extern "C" __global__ __aicore__ __mix__(1,2) void BestNativeMediumLookahead(
 GM_ADDR x,GM_ADDR w,GM_ADDR s,GM_ADDR groups,GM_ADDR y,GM_ADDR system,GM_ADDR scratch,
 GM_ADDR prepared,sdk_gmmg::Geometry shape,TCubeTiling tiling);

extern "C" __global__ __aicore__ __mix__(1,2) void BestColumns512(
 GM_ADDR x,GM_ADDR w,GM_ADDR s,GM_ADDR groups,GM_ADDR y,GM_ADDR scratch,sdk_gmmg::Geometry shape) {
 best_stream::ExecuteColumns512<384>(x,w,s,groups,y,scratch,shape);
}

static bool TryColumns512(GM_ADDR x,const TensorGroupInfo& ix,GM_ADDR w,const TensorGroupInfo& iw,
 GM_ADDR s,const TensorGroupInfo& is,GM_ADDR groups,const TensorGroupInfo& ig,
 GM_ADDR y,const TensorGroupInfo& iy,int64_t available,aclrtStream stream) {
    using namespace sdk_gmmg;
    const int m=ix.tensors[0].shape[0],k=ix.tensors[0].shape[1],e=iw.tensors[0].shape[0],n=iw.tensors[0].shape[2];
    // This is the existing aligned medium-row family, using a wider tile.
    if(!(k>=768 && k%128==0 && n>=512 && n%512==0 && e<=16 && m>=64*e && m<128*e))return false;
    Validate(is,2,0);Validate(ig,1,6);Validate(iy,2,1);
    if(!x||!w||!s||!groups||!y||available<1||e<1||e>128||m<1||m>65536||
       iw.tensors[0].shape[1]!=k||is.tensors[0].shape[0]!=e||is.tensors[0].shape[1]!=n||
       ig.tensors[0].shape[0]!=e||iy.tensors[0].shape[0]!=m||iy.tensors[0].shape[1]!=n)return false;
    auto platform=platform_ascendc::PlatformAscendCManager::GetInstance();if(!platform)return false;
    auto r=ReadResources(platform);
    const int blocks=std::min<int64_t>(available,std::min(r.cube,r.vector/2));
    if(!blocks||r.ub<best_stream::FinishProduct512::Bytes||r.l1<2u*(64u+512u)*384u||
       r.l0a<2u*64u*64u||r.l0b<2u*512u*64u||r.l0c<64u*512u*4u)return false;
    Geometry g{e,m,k,n,64,512,blocks,k,n};
    const size_t bytes=size_t(blocks)*2*64*512*4;
    void* memory=nullptr;Check(aclrtMalloc(&memory,bytes,ACL_MEM_MALLOC_HUGE_FIRST));
    BestColumns512<<<blocks,nullptr,stream>>>(x,w,s,groups,y,(GM_ADDR)memory,g);
    const aclError status=aclrtSynchronizeStream(stream);aclrtFree(memory);Check(status);return true;
}


static bool TryBestStream(GM_ADDR x,const TensorGroupInfo& ix,GM_ADDR w,const TensorGroupInfo& iw,
 GM_ADDR s,const TensorGroupInfo& is,GM_ADDR groups,const TensorGroupInfo& ig,
 GM_ADDR y,const TensorGroupInfo& iy,int64_t available,aclrtStream stream) {
    using namespace sdk_gmmg;
    const int m=ix.tensors[0].shape[0],k=ix.tensors[0].shape[1],e=iw.tensors[0].shape[0],n=iw.tensors[0].shape[2];
    int route=0;
    if(k>=768 && k%128==0 && n%256==0 && n>=512 && e<=16 && m>=64*e && m<128*e)route=6;
    if(k>=768 && k%128==0 && n%256==0 && e<=16 && n>=512 && m>=128*e)route=1;
    if(k==256 && n==256 && e>32)route=2;
    if(k>=768 && k<=1024 && n>512 && e<=8 && m>1024 && (k%32 || n%32))route=3;
    if(k>=256 && k<=1024 && k%32==0 && n%256==0 && n>=512 && e>=24)route=4;

    if(route==4 && k%128==0 && k>=768)route=6;
    if(route==4 && k%128==0 && k<=512)route=6;
    if(!route)return false;
    Validate(is,2,0);Validate(ig,1,6);Validate(iy,2,1);
    if(!x||!w||!s||!groups||!y||available<1||e<1||e>128||m<1||m>65536||
        iw.tensors[0].shape[1]!=k||is.tensors[0].shape[0]!=e||is.tensors[0].shape[1]!=n||
        ig.tensors[0].shape[0]!=e||iy.tensors[0].shape[0]!=m||iy.tensors[0].shape[1]!=n)return false;
    auto platform=platform_ascendc::PlatformAscendCManager::GetInstance();
    if(!platform)return false;
    auto r=ReadResources(platform);
    const int blocks=std::min<int64_t>(available,std::min(r.cube,r.vector/2));
    if(!blocks||r.ub<best_stream::FinishProduct<32>::Bytes)return false;
    if(route==6&&k>1024&&uint64_t(64)*k+2*256*512>r.l1)return false;
    if(route==2 && (((m+31)/32+e+blocks-1)/blocks>510 || r.ub<best_stream::FinishProduct<32>::Bytes+9216))return false;
    const bool pack=route==3||route==5,direct=route==4||route==5;
    const int rows=route==2||route==6?64:direct?64:128;
    const int kp=pack?((k+(direct?63:127))&~(direct?63:127)):k,np=pack?((n+255)&~255):n;
    Geometry g{e,m,k,n,rows,256,blocks,kp,np};
    TCubeTiling tiling{};
    if(direct) {
        matmul_tiling::MatmulApiTiling plan(*platform);
        using P=matmul_tiling::TPosition;using F=matmul_tiling::CubeFormat;using T=matmul_tiling::DataType;
        plan.SetAType(P::GM,F::ND,T::DT_INT8);plan.SetBType(P::GM,F::ND,T::DT_INT8);plan.SetCType(P::GM,F::ND,T::DT_INT32);
        plan.SetShape(64,256,kp);plan.SetOrgShape(m,np,kp);plan.SetFixSplit(64,256,64);plan.SetBufferSpace(-1,-1,-1);
        if(plan.GetTiling(tiling))return false;
    } else if(r.l0b<65536||r.l0c<uint64_t(rows*256*4)||r.l1<147456)return false;
    const size_t sys=direct?((platform->GetLibApiWorkSpaceSize()+511)&~size_t(511)):0;
    const size_t products=size_t(blocks)*2*rows*256*4;
    const size_t prepared=pack?(size_t(m)+size_t(e)*np)*kp:(route==2?size_t(blocks)*8192:0);
    void* memory=nullptr;Check(aclrtMalloc(&memory,sys+products+prepared,ACL_MEM_MALLOC_HUGE_FIRST));
    GM_ADDR scratch=(GM_ADDR)(static_cast<uint8_t*>(memory)+sys);
    GM_ADDR staged=scratch+products;
    switch(route) {
    case 6:if(k<=512 && e>=24)BestNativeActivation<<<blocks,nullptr,stream>>>(x,w,s,groups,y,(GM_ADDR)memory,scratch,staged,g,tiling);else if(k<=1024)BestNativeMediumLookahead<<<blocks,nullptr,stream>>>(x,w,s,groups,y,(GM_ADDR)memory,scratch,staged,g,tiling);else BestNativeMedium<<<blocks,nullptr,stream>>>(x,w,s,groups,y,(GM_ADDR)memory,scratch,staged,g,tiling);break;
    case 1:if(k<=1024)BestNativeWideChunked<<<blocks,nullptr,stream>>>(x,w,s,groups,y,(GM_ADDR)memory,scratch,staged,g,tiling);else if(blocks%2==0)BestWaveWide<<<blocks,nullptr,stream>>>(x,w,s,groups,y,scratch,g);else BestNativeWide<<<blocks,nullptr,stream>>>(x,w,s,groups,y,(GM_ADDR)memory,scratch,staged,g,tiling);break;
    case 2:BestNativeShort<<<blocks,nullptr,stream>>>(x,w,s,groups,y,(GM_ADDR)memory,scratch,staged,g,tiling);break;
    case 3:BestNativePadded<<<blocks,nullptr,stream>>>(x,w,s,groups,y,(GM_ADDR)memory,scratch,staged,g,tiling);break;
    case 4:BestDirectAligned<<<blocks,nullptr,stream>>>(x,w,s,groups,y,(GM_ADDR)memory,scratch,staged,g,tiling);break;
    case 5:BestDirectPadded<<<blocks,nullptr,stream>>>(x,w,s,groups,y,(GM_ADDR)memory,scratch,staged,g,tiling);break;
    }
    const aclError status=aclrtSynchronizeStream(stream);aclrtFree(memory);Check(status);return true;
}

namespace best_stream {
// A first block also brings a complete expert weight panel into L1.
// One work unit for that transition is a scheduling estimate, not a cycle count.
class CacheWorkCursor {
    GlobalTensor<int64_t> ends;
    Geometry shape;
    int expert=0,block=0,blocks=0;
    int64_t first=0,end=0,base=0,lower=0,upper=0;
    bool opened=false,enabled=false;
    static constexpr int Setup=1;
    __aicore__ bool Open() {
        while(expert<shape.experts) {
            end=ends.GetValue(expert);
            blocks=int((end-first+63)/64);
            const int cost=blocks+(blocks?Setup:0);
            if(blocks && lower<base+cost) {
                block=0;
                if(lower>base) {
                    block=int(lower-base-Setup);
                    if(block<1)block=1;
                }
                opened=true;return true;
            }
            base+=cost;first=end;++expert;
        }
        return false;
    }
public:
    __aicore__ CacheWorkCursor(GM_ADDR groups,Geometry g,int core):shape(g) {
        ends.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups),g.experts);
        // This only selects a scheduler. Both schedulers still use actual
        // boundaries for every output tile; no rows are inferred from M/E.
        bool irregular=g.experts<4;
        for(int fraction=1;fraction<=3 && !irregular;++fraction) {
            const int cut=g.experts*fraction/4;
            const int64_t observed=ends.GetValue(cut-1);
            const int64_t expected=int64_t(g.rows)*cut/g.experts;
            irregular=observed>expected+64 || observed+64<expected;
        }
        if(!irregular)return;
        int64_t previous=0,total=0,padded=0;
        for(int e=0;e<g.experts;++e) {
            const int64_t next=ends.GetValue(e),count=(next-previous+63)/64;
            total+=count+(count?Setup:0);padded+=count*64;previous=next;
        }
        enabled=padded-previous>previous/32;
        lower=total*core/g.blocks;upper=total*(core+1)/g.blocks;
    }
    __aicore__ bool Enabled() const {return enabled;}
    __aicore__ bool Next(OutputTile& tile) {
        for(;;) {
            if(!opened && !Open())return false;
            if(block>=blocks) {
                base+=blocks+Setup;first=end;++expert;opened=false;continue;
            }
            const int64_t position=base+block+(block?Setup:0);
            if(position>=upper)return false;
            const int64_t row=first+int64_t(block++)*64;
            tile={};tile.expert=expert;tile.firstRow=row;
            tile.rows=end-row<64?int(end-row):64;
            tile.columns=shape.columns;tile.pitch=416;return true;
        }
    }
};

class CompositeCursor {
    CacheWorkCursor cached;
    expert_schedule::AreaPlan<1,expert_schedule::ReadEnds> area;
public:
    __aicore__ CompositeCursor(GM_ADDR groups,Geometry g,int core)
      :cached(groups,g,core),area(expert_schedule::ReadEnds(groups),g.experts,
       g.columns,g.rowTile,g.columnTile,core,g.blocks,!cached.Enabled()){}
    __aicore__ bool Next(OutputTile& tile) {
        if(cached.Enabled())return cached.Next(tile);
        expert_schedule::Tile part;
        if(!area.Next(part))return false;
        tile={};tile.firstRow=part.row;tile.firstColumn=part.column;
        tile.expert=part.expert;tile.rows=part.rows;tile.columns=part.columns;
        tile.pitch=(part.columns+31)&~31;return true;
    }
};

class CompositeProduct {
    static constexpr int Rows=64,Main=384,Tail=32,Step=64;
    TBuf<TPosition::A1> leftCache;TBuf<TPosition::B1> rightCache;
    TBuf<TPosition::A2> leftOperand;TBuf<TPosition::B2> rightOperand;
    TBuf<TPosition::CO1> accum;
    GlobalTensor<int8_t> a,b;
    LocalTensor<int8_t> a1,b1,a0,b0;
    LocalTensor<int32_t> c0;
    Geometry g;TPipe* owner;int kp,cachedExpert=-1,inputSequence=0;bool preparedA=false;event_t aheadReady[2];
    event_t inputFree,inputReady,operandFree[2],tailFree,operandReady,exportFree,exportReady;
public:
    __aicore__ inline void Bind(GM_ADDR x,GM_ADDR w){
        a.SetGlobalBuffer((__gm__ int8_t*)x);b.SetGlobalBuffer((__gm__ int8_t*)w);
    }
    __aicore__ void Init(TPipe& pipe,Geometry shape){
        g=shape;owner=&pipe;kp=(g.reduction+31)&~31;
        pipe.InitBuffer(leftCache,2*Rows*kp);pipe.InitBuffer(rightCache,(Main+Tail)*kp);
        pipe.InitBuffer(leftOperand,2*Rows*Step+Rows*512);
        pipe.InitBuffer(rightOperand,2*Main*Step+Tail*512);
        pipe.InitBuffer(accum,Rows*(Main+Tail)*4);
        a1=leftCache.Get<int8_t>();b1=rightCache.Get<int8_t>();
        a0=leftOperand.Get<int8_t>();b0=rightOperand.Get<int8_t>();c0=accum.Get<int32_t>();
        for(int bank=0;bank<2;++bank)
            Fill(a1[bank*Rows*kp+(kp-32)*Rows].ReinterpretCast<uint32_t>(),InitConstValueParams<uint32_t>{1,uint16_t(Rows),0,0});
        for(int col=0;col<Main;col+=32)
            Fill(b1[col*kp+(kp-32)*32].ReinterpretCast<uint32_t>(),InitConstValueParams<uint32_t>{1,uint16_t(32),0,0});
        Fill(b1[Main*kp].ReinterpretCast<uint32_t>(),InitConstValueParams<uint32_t>{1,uint16_t(Tail*kp/32),0,0});
        PipeBarrier<PIPE_ALL>();
        for(int i=0;i<2;++i)aheadReady[i]=static_cast<event_t>(pipe.AllocEventID<HardEvent::MTE2_MTE1>());
        inputFree=static_cast<event_t>(pipe.AllocEventID<HardEvent::MTE1_MTE2>());
        inputReady=static_cast<event_t>(pipe.AllocEventID<HardEvent::MTE2_MTE1>());
        operandReady=static_cast<event_t>(pipe.AllocEventID<HardEvent::MTE1_M>());
        tailFree=static_cast<event_t>(pipe.AllocEventID<HardEvent::M_MTE1>());
        exportFree=static_cast<event_t>(pipe.AllocEventID<HardEvent::FIX_M>());
        exportReady=static_cast<event_t>(pipe.AllocEventID<HardEvent::M_FIX>());
        SetFlag<HardEvent::MTE1_MTE2>(inputFree);SetFlag<HardEvent::M_MTE1>(tailFree);
        SetFlag<HardEvent::FIX_M>(exportFree);
        for(int i=0;i<2;++i){operandFree[i]=static_cast<event_t>(pipe.AllocEventID<HardEvent::M_MTE1>());
            SetFlag<HardEvent::M_MTE1>(operandFree[i]);}
    }
    __aicore__ void Run(OutputTile tile,GlobalTensor<int32_t> destination,int credit,OutputTile next,bool more){
        WaitFlag<HardEvent::MTE1_MTE2>(inputFree);
        const int inputBank=inputSequence++&1;auto currentA=a1[inputBank*Rows*kp];
        Nd2NzParams left{};left.ndNum=1;left.nValue=tile.rows;left.dValue=g.reduction;
        left.srcDValue=g.reduction;left.dstNzC0Stride=Rows;left.dstNzNStride=1;
        if(preparedA)WaitFlag<HardEvent::MTE2_MTE1>(aheadReady[inputBank]);
        else DataCopy(currentA,a[tile.firstRow*g.reduction],left);
        preparedA=false;
        if(cachedExpert!=tile.expert){
            Nd2NzParams right{};right.ndNum=1;right.nValue=g.reduction;right.dValue=Main;
            right.srcDValue=g.columns;right.dstNzC0Stride=kp;right.dstNzNStride=1;
            DataCopy(b1,b[int64_t(tile.expert)*g.reduction*g.columns],right);
            right.dValue=g.columns-Main;
            DataCopy(b1[Main*kp],b[int64_t(tile.expert)*g.reduction*g.columns+Main],right);
            cachedExpert=tile.expert;
        }
        SetFlag<HardEvent::MTE2_MTE1>(inputReady);WaitFlag<HardEvent::MTE2_MTE1>(inputReady);
        if(more){left.nValue=next.rows;DataCopy(a1[(inputBank^1)*Rows*kp],a[next.firstRow*g.reduction],left);
            SetFlag<HardEvent::MTE2_MTE1>(aheadReady[inputBank^1]);preparedA=true;}
        WaitFlag<HardEvent::FIX_M>(exportFree);
        // Narrow product uses a long K operand, avoiding one tiny MMAD per main step.
        for(int first=0;first<g.reduction;first+=512){
            WaitFlag<HardEvent::M_MTE1>(tailFree);
            const int live=g.reduction-first<512?g.reduction-first:512,pk=(live+31)&~31;
            LoadData2DParams ap{};ap.repeatTimes=pk/32;ap.srcStride=Rows/16;
            for(int row=0;row<Rows/16;++row)
                LoadData(a0[2*Rows*Step+row*pk*16],currentA[first*Rows+row*512],ap);
            LoadData2dTransposeParams bp{};bp.repeatTimes=pk/32;bp.srcStride=1;bp.dstGap=1;bp.dstFracGap=0;
            LoadDataWithTranspose(b0[2*Main*Step],b1[Main*kp+first*32],bp);
            SetFlag<HardEvent::MTE1_M>(operandReady);WaitFlag<HardEvent::MTE1_M>(operandReady);
            PipeBarrier<PIPE_M>();MmadParams mm{};mm.m=Rows;mm.n=Tail;mm.k=pk;mm.cmatrixInitVal=first==0;
            Mmad(c0[Rows*Main],a0[2*Rows*Step],b0[2*Main*Step],mm);
            SetFlag<HardEvent::M_MTE1>(tailFree);
        }
        for(int first=0,step=0;first<g.reduction;first+=Step,++step){
            const int bank=step&1,live=g.reduction-first<Step?g.reduction-first:Step,pk=(live+31)&~31;
            WaitFlag<HardEvent::M_MTE1>(operandFree[bank]);
            LoadData2DParams ap{};
            ap.repeatTimes=Rows/16;ap.srcStride=1;ap.dstGap=pk/32-1;
            for(int plane=0;plane<pk;plane+=32)
                LoadData(a0[bank*Rows*Step+plane*16],currentA[(first+plane)*Rows],ap);
            LoadData2dTransposeParams bp{};bp.repeatTimes=Main/32;bp.srcStride=kp/32;bp.dstGap=1;bp.dstFracGap=0;
            for(int k=0;k<pk;k+=32)
                LoadDataWithTranspose(b0[bank*Main*Step+k*Main],b1[(first+k)*32],bp);
            SetFlag<HardEvent::MTE1_M>(operandReady);WaitFlag<HardEvent::MTE1_M>(operandReady);
            PipeBarrier<PIPE_M>();MmadParams mm{};mm.m=Rows;mm.n=Main;mm.k=pk;mm.cmatrixInitVal=first==0;
            Mmad(c0,a0[bank*Rows*Step],b0[bank*Main*Step],mm);
            SetFlag<HardEvent::M_MTE1>(operandFree[bank]);
        }
        SetFlag<HardEvent::MTE1_MTE2>(inputFree);
        SetFlag<HardEvent::M_FIX>(exportReady);WaitFlag<HardEvent::M_FIX>(exportReady);
        CrossCoreWaitFlag<2,PIPE_FIX>(credit);
        FixpipeParamsV220 cp{};cp.mSize=Rows;cp.nSize=Main;cp.srcStride=Rows;cp.dstStride=Main;
        cp.ndNum=1;cp.quantPre=QuantMode_t::NoQuant;
        Fixpipe<int32_t,int32_t>(destination,c0,cp);
        cp.nSize=Tail;cp.dstStride=Tail;
        Fixpipe<int32_t,int32_t>(destination[Rows*Main],c0[Rows*Main],cp);
        CrossCoreSetFlag<2,PIPE_FIX>(credit);SetFlag<HardEvent::FIX_M>(exportFree);
    }
    __aicore__ void Drain(){
        WaitFlag<HardEvent::MTE1_MTE2>(inputFree);WaitFlag<HardEvent::M_MTE1>(tailFree);
        WaitFlag<HardEvent::FIX_M>(exportFree);
        for(int i=0;i<2;++i){WaitFlag<HardEvent::M_MTE1>(operandFree[i]);owner->ReleaseEventID<HardEvent::M_MTE1>(operandFree[i]);}
        for(int i=0;i<2;++i)owner->ReleaseEventID<HardEvent::MTE2_MTE1>(aheadReady[i]);
        owner->ReleaseEventID<HardEvent::MTE1_MTE2>(inputFree);owner->ReleaseEventID<HardEvent::MTE2_MTE1>(inputReady);
        owner->ReleaseEventID<HardEvent::M_MTE1>(tailFree);owner->ReleaseEventID<HardEvent::MTE1_M>(operandReady);
        owner->ReleaseEventID<HardEvent::FIX_M>(exportFree);owner->ReleaseEventID<HardEvent::M_FIX>(exportReady);
    }
};

class CompositeFinish {
    static constexpr int Lanes=6144,Main=384,Tail=32,Input=32*416;
    TBuf<TPosition::VECCALC> storage;
    LocalTensor<int32_t> incoming;LocalTensor<float> scaled,arg,temp,coeff;
    LocalTensor<half> outputs;GlobalTensor<float> scales;GlobalTensor<half> result;
    TPipe* owner;int columns,cachedExpert=-1,serial=0;
    event_t inputFree,ready,scaleFree,outFree[2],outReady[2];
    template<int Width> __aicore__ void Finish(OutputTile tile,int offset,int col,int valid){
        constexpr int Chunk=Lanes/Width;
        for(int first=0;first<tile.rows;first+=Chunk){
            const int rows=tile.rows-first<Chunk?tile.rows-first:Chunk,count=rows*Width;
            Cast(scaled,incoming[offset+first*Width],RoundMode::CAST_RINT,count);PipeBarrier<PIPE_V>();
            for(int n=0;n<Width;n+=64){constexpr int Mask=Width<64?Width:64;
                Mul(scaled[n],scaled[n],coeff[col+n],uint64_t(Mask),uint8_t(rows),
                    BinaryRepeatParams{1,1,1,Width/8,Width/8,0});}
            PipeBarrier<PIPE_V>();const int bank=serial++&1;
            WaitFlag<HardEvent::MTE3_V>(outFree[bank]);
            auto out=outputs[bank*Lanes];HalfActivation<Lanes>(scaled,arg,temp,out,count);
            SetFlag<HardEvent::V_MTE3>(outReady[bank]);WaitFlag<HardEvent::V_MTE3>(outReady[bank]);
            DataCopyPad(result[(tile.firstRow+first)*columns+col],out,
                DataCopyExtParams{uint16_t(rows),uint32_t(valid*2),uint32_t((Width-((valid+15)&~15))/16),
                    uint32_t((columns-valid)*2),0});
            SetFlag<HardEvent::MTE3_V>(outFree[bank]);
        }
    }
public:
    __aicore__ void Init(TPipe& pipe,GM_ADDR s,GM_ADDR y,int n){
        scales.SetGlobalBuffer((__gm__ float*)s);result.SetGlobalBuffer((__gm__ half*)y);
        owner=&pipe;columns=n;pipe.InitBuffer(storage,Input*4+Lanes*16+416*4);
        auto bytes=storage.Get<uint8_t>();incoming=bytes.ReinterpretCast<int32_t>();
        scaled=bytes[Input*4].ReinterpretCast<float>();arg=bytes[Input*4+Lanes*4].ReinterpretCast<float>();
        temp=bytes[Input*4+Lanes*8].ReinterpretCast<float>();outputs=bytes[Input*4+Lanes*12].ReinterpretCast<half>();
        coeff=bytes[Input*4+Lanes*16].ReinterpretCast<float>();Duplicate(coeff,0.0f,416);
        inputFree=static_cast<event_t>(pipe.AllocEventID<HardEvent::V_MTE2>());
        ready=static_cast<event_t>(pipe.AllocEventID<HardEvent::MTE2_V>());
        scaleFree=static_cast<event_t>(pipe.AllocEventID<HardEvent::V_MTE2>());
        SetFlag<HardEvent::V_MTE2>(inputFree);
        for(int i=0;i<2;++i){outFree[i]=static_cast<event_t>(pipe.AllocEventID<HardEvent::MTE3_V>());
            outReady[i]=static_cast<event_t>(pipe.AllocEventID<HardEvent::V_MTE3>());SetFlag<HardEvent::MTE3_V>(outFree[i]);}
    }
    __aicore__ void Run(GlobalTensor<int32_t> source,OutputTile tile,int rowOffset,int credit){
        WaitFlag<HardEvent::V_MTE2>(inputFree);
        DataCopy(incoming,source[rowOffset*Main],tile.rows*Main);
        DataCopy(incoming[32*Main],source[64*Main+rowOffset*Tail],tile.rows*Tail);
        CrossCoreSetFlag<2,PIPE_MTE2>(credit);
        if(cachedExpert!=tile.expert){
            SetFlag<HardEvent::V_MTE2>(scaleFree);WaitFlag<HardEvent::V_MTE2>(scaleFree);
            DataCopyPad(coeff,scales[int64_t(tile.expert)*columns],DataCopyExtParams{1,uint32_t(columns*4),0,0,0},
                DataCopyPadExtParams<float>{true,0,0,0});cachedExpert=tile.expert;
        }
        SetFlag<HardEvent::MTE2_V>(ready);WaitFlag<HardEvent::MTE2_V>(ready);
        Finish<Main>(tile,0,0,Main);Finish<Tail>(tile,32*Main,Main,columns-Main);
        SetFlag<HardEvent::V_MTE2>(inputFree);
    }
    __aicore__ void Drain(){
        WaitFlag<HardEvent::V_MTE2>(inputFree);owner->ReleaseEventID<HardEvent::V_MTE2>(inputFree);
        owner->ReleaseEventID<HardEvent::MTE2_V>(ready);owner->ReleaseEventID<HardEvent::V_MTE2>(scaleFree);
        for(int i=0;i<2;++i){WaitFlag<HardEvent::MTE3_V>(outFree[i]);
            owner->ReleaseEventID<HardEvent::MTE3_V>(outFree[i]);owner->ReleaseEventID<HardEvent::V_MTE3>(outReady[i]);}
    }
};

__aicore__ inline void ExecuteComposite(GM_ADDR x,GM_ADDR w,GM_ADDR s,GM_ADDR groups,GM_ADDR y,GM_ADDR scratch,Geometry g){
    InitSocState();int pair=GetBlockIdx();if ASCEND_IS_AIV {pair/=2;}
    GlobalTensor<int32_t> ring;ring.SetGlobalBuffer((__gm__ int32_t*)scratch+int64_t(pair)*2*64*416);
    CompositeCursor cursor(groups,g,pair);TPipe pipe;OutputTile tile{};int serial=0;
    if ASCEND_IS_AIC {
        CompositeProduct product;product.Bind(x,w);product.Init(pipe,g);
        bool live=cursor.Next(tile);while(live){OutputTile next{};const bool more=cursor.Next(next);
            const int bank=serial++&1;product.Run(tile,ring[bank*64*416],8+bank,next,more);tile=next;live=more;}
        product.Drain();CrossCoreWaitFlag<2,PIPE_FIX>(8);CrossCoreWaitFlag<2,PIPE_FIX>(9);
    }else{
        CompositeFinish finish;finish.Init(pipe,s,y,g.columns);
        CrossCoreSetFlag<2,PIPE_MTE2>(8);CrossCoreSetFlag<2,PIPE_MTE2>(9);
        while(cursor.Next(tile)){const int bank=serial++&1,offset=GetSubBlockIdx()*32;
            CrossCoreWaitFlag<2,PIPE_MTE2>(8+bank);
            if(offset<tile.rows){tile.firstRow+=offset;tile.rows-=offset;if(tile.rows>32)tile.rows=32;
                finish.Run(ring[bank*64*416],tile,offset,8+bank);}
            else CrossCoreSetFlag<2,PIPE_MTE2>(8+bank);
        }finish.Drain();
    }
    PipeBarrier<PIPE_ALL>();
}
}
template<int EntrySection> __global__ __aicore__ __mix__(1,2) void BestCompositeRagged(
 GM_ADDR x,GM_ADDR w,GM_ADDR s,GM_ADDR groups,GM_ADDR y,GM_ADDR scratch,sdk_gmmg::Geometry shape){
    best_stream::ExecuteComposite(x,w,s,groups,y,scratch,shape);
}

static bool TryRunSdk(
    GM_ADDR x, const TensorGroupInfo& ix,
    GM_ADDR weight, const TensorGroupInfo& iw,
    GM_ADDR scale, const TensorGroupInfo& is,
    GM_ADDR groups, const TensorGroupInfo& ig,
    GM_ADDR y, const TensorGroupInfo& iy,
    int64_t availableCoreNum, aclrtStream stream) {
    using namespace sdk_gmmg;
    Validate(ix, 2, 3); Validate(iw, 3, 3); Validate(is, 2, 0);
    Validate(ig, 1, 6); Validate(iy, 2, 1);
    Geometry g{};
    g.experts = iw.tensors[0].shape[0]; g.rows = ix.tensors[0].shape[0];
    g.reduction = ix.tensors[0].shape[1]; g.columns = iw.tensors[0].shape[2];
    if (!x || !weight || !scale || !groups || !y || availableCoreNum < 1 ||
        g.experts < 1 || g.experts > 128 || g.rows < 1 || g.rows > 65536 ||
        g.reduction < 1 || g.reduction > 8192 || g.columns < 1 || g.columns > 4096 ||
        iw.tensors[0].shape[1] != g.reduction || is.tensors[0].shape[0] != g.experts ||
        is.tensors[0].shape[1] != g.columns || ig.tensors[0].shape[0] != g.experts ||
        iy.tensors[0].shape[0] != g.rows || iy.tensors[0].shape[1] != g.columns)
        throw std::runtime_error("inconsistent SDK GMMG dimensions");
    auto platform = platform_ascendc::PlatformAscendCManager::GetInstance();
    if (!platform) throw std::runtime_error("SDK GMMG platform unavailable");
    const Resources r = ReadResources(platform);
    if (int64_t(g.rows) * g.columns <= 64 && g.reduction <= 32) {
        const uint32_t workers = std::min<int64_t>(std::min<int64_t>(availableCoreNum, r.vector), int64_t(g.rows) * g.columns);
        TinyKernel<<<workers, nullptr, stream>>>(x, weight, scale, groups, y, g);
        return true;
    }
    g.blocks = std::min<int64_t>(availableCoreNum, std::min(r.cube, r.vector / 2));
    if (!g.blocks || r.ub < 98304 || r.l1 == 0)
        return false;
    g.inputK = g.reduction; g.inputN = g.columns;
    const bool stage = PreferStage(g.experts,g.rows,g.reduction,g.columns);
    if(!stage && g.reduction>512 && g.reduction<768 && g.columns>384 && g.columns<=416 &&
       int64_t(g.rows)>int64_t(g.experts)*64 && r.l1>=uint64_t(544*((g.reduction+31)&~31)) &&
       r.l0a>=40960 && r.l0b>=65536 && r.l0c>=106496 && r.ub>=153216){
        g.rowTile=64;g.columnTile=416;void* composite=nullptr;
        Check(aclrtMalloc(&composite,size_t(g.blocks)*2*64*416*4,ACL_MEM_MALLOC_HUGE_FIRST));
        BestCompositeRagged<0><<<g.blocks,nullptr,stream>>>(x,weight,scale,groups,y,(GM_ADDR)composite,g);
        const aclError status=aclrtSynchronizeStream(stream);aclrtFree(composite);Check(status);return true;
    }

    if (stage) {
        g.inputK = (g.reduction + 63) & ~63;
        g.inputN = (g.columns + 127) & ~127;
    }
    g.rowTile = g.reduction <= 512 ? 32 : 64;
    g.columnTile = g.columns > 128 ? 256 : (g.columns > 64 ? 128 : 64);
    // Short-wide requests benefit from fewer SDK transactions; ragged-short
    // families reuse a larger M block while retaining actual tail sizes.
    if (g.reduction > 256 && g.reduction <= 512 && g.columns > 256) g.rowTile = 64;
    if (g.reduction > 512 && g.reduction < 768 && int64_t(g.rows) > int64_t(g.experts) * 64)
        g.rowTile = 128;
    if(stage) g.rowTile = 128;
    if(g.columns==1){g.rowTile=128;g.columnTile=32;}
    if(g.reduction>4096 && g.rows>1024*g.experts){g.rowTile=128;g.columnTile=256;}
    TCubeTiling tiling{};
    if (!PlanMatmul(*platform, g, tiling)) return false;
    const int64_t nonempty = std::min(g.experts, g.rows);
    const int64_t taskUpper = (nonempty + (g.rows - nonempty) / g.rowTile) *
                              ((g.columns + g.columnTile - 1) / g.columnTile);
    g.blocks = std::min<int64_t>(g.blocks, (taskUpper + 1) / 2);
    constexpr bool async = SDK_REBUILD_ASYNC;
    const size_t systemBytes = (platform->GetLibApiWorkSpaceSize() + 511) & ~size_t(511);
    const size_t productBytes = size_t(g.blocks) * 2 * (async ? 2 : 1) * g.rowTile * g.columnTile * 4;
    const size_t stagingBytes = stage ? size_t(g.rows + g.experts * g.inputN) * g.inputK : 0;
    void* memory = nullptr; void* system = nullptr;
    if(stage) {
        Check(aclrtMalloc(&system,systemBytes,ACL_MEM_MALLOC_HUGE_FIRST));
        const aclError allocated=aclrtMalloc(&memory,productBytes+stagingBytes,ACL_MEM_MALLOC_HUGE_FIRST);
        if(allocated!=ACL_SUCCESS) { aclrtFree(system); Check(allocated); }
    } else {
        Check(aclrtMalloc(&memory,systemBytes+productBytes,ACL_MEM_MALLOC_HUGE_FIRST));
        system=memory;
    }
    GM_ADDR product=(GM_ADDR)((uint8_t*)memory+(stage?0:systemBytes));
    if(stage)
        MatmulKernel<async,true><<<g.blocks,nullptr,stream>>>(x,weight,scale,groups,y,
            (GM_ADDR)system,product,product+productBytes,g,tiling);
    else
        MatmulKernel<async,false><<<g.blocks,nullptr,stream>>>(x,weight,scale,groups,y,
            (GM_ADDR)system,product,product+productBytes,g,tiling);
    const aclError status=aclrtSynchronizeStream(stream);
    aclrtFree(memory); if(stage) aclrtFree(system);
    Check(status);
    return true;
}
// Independent implementation: runtime full-K NZ panels, column-major work,
// resident weights, two L0 operand slots and two INT32 publication slots.
namespace resident_panel {
using namespace AscendC;
using sdk_gmmg::Geometry;
using sdk_gmmg::OutputTile;
constexpr int Height=80,Width=384,Step=64,Elements=Height*Width;

// Runtime expert/column prefixes include a first-use B-panel allowance.
// The allowance is a scheduling weight, not a hardware timing constant.
template<int SetupWeight> class SetupCostOrder {
    GlobalTensor<int64_t> ends;
    Geometry shape;
    int64_t lower=0,upper=0,base=0,first=0,last=0;
    int expert=-1,rowTiles=0,column=0,row=0,columns=0,setup=0;
    bool opened=false;
public:
    __aicore__ inline SetupCostOrder(TPipe&,GM_ADDR groups,Geometry g,int pair,GM_ADDR)
        : shape(g),columns((g.columns+g.columnTile-1)/g.columnTile) {
        ends.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups),g.experts);
        int64_t previous=0,tiles=0,nonempty=0;
        for(int e=0;e<g.experts;++e) {
            const int64_t end=ends.GetValue(e),rows=end-previous;
            tiles+=(rows+g.rowTile-1)/g.rowTile;
            nonempty+=rows>0;previous=end;
        }
        setup=tiles*g.rowTile>int64_t(g.rows)+g.rowTile?SetupWeight:0;
        const int64_t total=(tiles+nonempty*setup)*columns;
        lower=total*pair/g.blocks;upper=total*(pair+1)/g.blocks;
    }
    __aicore__ inline bool Next(OutputTile& out) {
        for(;;) {
            if(!opened) {
                first=last;
                if(++expert>=shape.experts)return false;
                last=ends.GetValue(expert);
                rowTiles=int((last-first+shape.rowTile-1)/shape.rowTile);
                const int64_t cost=rowTiles?int64_t(rowTiles+setup)*columns:0;
                if(!cost || lower>=base+cost){base+=cost;continue;}
                const int64_t local=lower>base?lower-base:0;
                column=int(local/(rowTiles+setup));
                const int within=int(local%(rowTiles+setup));
                row=within==0?0:(within>setup?within-setup:1);
                if(row>=rowTiles){row=0;++column;}
                opened=true;
            }
            if(column>=columns) {
                base+=int64_t(rowTiles+setup)*columns;opened=false;continue;
            }
            const int64_t position=base+int64_t(column)*(rowTiles+setup)+(row?setup+row:0);
            if(position>=upper)return false;
            out.firstRow=first+int64_t(row)*shape.rowTile;
            out.firstColumn=column*shape.columnTile;
            out.expert=expert;
            out.rows=int(last-out.firstRow);
            if(out.rows>shape.rowTile)out.rows=shape.rowTile;
            out.columns=shape.columns-out.firstColumn;
            if(out.columns>shape.columnTile)out.columns=shape.columnTile;
            out.pitch=sdk_gmmg::Round32(out.columns);
            if(++row==rowTiles){row=0;++column;}
            return true;
        }
    }
};

class Product {
    Geometry shape;
    GlobalTensor<int8_t> input,weight;
    TBuf<TPosition::A1> leftStorage;
    TBuf<TPosition::B1> rightStorage;
    TBuf<TPosition::A2> leftSlots;
    TBuf<TPosition::B2> rightSlots;
    TBuf<TPosition::CO1> sumStorage;
    LocalTensor<int8_t> left,right,l0left,l0right;
    LocalTensor<int32_t> sums;
    event_t cacheFree,cacheReady,prefixReady,operandFree[2],operandReady[2],sumReady,sumFree;
    int paddedK,expert=-1,column=-1;
    TPipe* owner;

    __aicore__ inline void PadNZ(LocalTensor<int8_t> target,int rows,int cols,int stride,int capacity) {
        const int occupied=(cols+31)/32;
        if(rows<stride) {
            InitConstValueParams<uint32_t> padding{};
            padding.repeatTimes=occupied;padding.blockNum=stride-rows;
            padding.dstGap=rows;padding.initValue=0;
            InitConstValue(target[rows*32].ReinterpretCast<uint32_t>(),padding);
        }
        const int unused=capacity/32-occupied;
        if(unused) {
            gmmg_safe_l1::ZeroBytes(target[occupied*stride*32],uint32_t(unused)*uint32_t(stride)*32u);
        }
    }
public:
    __aicore__ inline void Bind(GM_ADDR x,GM_ADDR w) {
        input.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
        weight.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(w));
    }
    __aicore__ inline void Init(TPipe& pipe,Geometry g) {
        owner=&pipe;shape=g;paddedK=g.inputK;
        pipe.InitBuffer(leftStorage,Height*paddedK);
        pipe.InitBuffer(rightStorage,Width*paddedK);
        pipe.InitBuffer(leftSlots,2*Height*Step);
        pipe.InitBuffer(rightSlots,2*Width*Step);
        pipe.InitBuffer(sumStorage,Elements*4);
        left=leftStorage.Get<int8_t>();right=rightStorage.Get<int8_t>();
        l0left=leftSlots.Get<int8_t>();l0right=rightSlots.Get<int8_t>();sums=sumStorage.Get<int32_t>();
        cacheFree=static_cast<event_t>(pipe.AllocEventID<HardEvent::MTE1_MTE2>());
        cacheReady=static_cast<event_t>(pipe.AllocEventID<HardEvent::MTE2_MTE1>());
        prefixReady=static_cast<event_t>(pipe.AllocEventID<HardEvent::MTE2_MTE1>());
        sumReady=static_cast<event_t>(pipe.AllocEventID<HardEvent::M_FIX>());
        sumFree=static_cast<event_t>(pipe.AllocEventID<HardEvent::FIX_M>());
        SetFlag<HardEvent::MTE1_MTE2>(cacheFree);
        for(int bank=0;bank<2;++bank) {
            operandFree[bank]=static_cast<event_t>(pipe.AllocEventID<HardEvent::M_MTE1>());
            operandReady[bank]=static_cast<event_t>(pipe.AllocEventID<HardEvent::MTE1_M>());
            SetFlag<HardEvent::M_MTE1>(operandFree[bank]);
        }
    }
    __aicore__ inline void Run(OutputTile tile,GlobalTensor<int32_t> destination,int sequence) {
        const int physicalRows=(tile.rows+15)&~15;
        const int physicalColumns=(tile.columns+63)&~63;
        WaitFlag<HardEvent::MTE1_MTE2>(cacheFree);
        Nd2NzParams desc{};desc.ndNum=1;desc.dstNzNStride=1;
        if(expert!=tile.expert || column!=tile.firstColumn) {
            PadNZ(right,shape.reduction,tile.columns,paddedK,Width);
            desc.nValue=shape.reduction;desc.dValue=tile.columns;
            desc.srcDValue=shape.columns;desc.dstNzC0Stride=paddedK;
            DataCopy(right,weight[int64_t(tile.expert)*shape.reduction*shape.columns+tile.firstColumn],desc);
            expert=tile.expert;column=tile.firstColumn;
        }
        PadNZ(left,tile.rows,shape.reduction,Height,paddedK);
        desc.nValue=tile.rows;
        desc.dValue=512;desc.srcDValue=shape.reduction;
        desc.dstNzC0Stride=Height;desc.dstNzNStride=1;
        DataCopy(left,input[tile.firstRow*shape.reduction],desc);
        SetFlag<HardEvent::MTE2_MTE1>(prefixReady);
        desc.dValue=shape.reduction-512;
        DataCopy(left[512*Height],input[tile.firstRow*shape.reduction+512],desc);
        SetFlag<HardEvent::MTE2_MTE1>(cacheReady);
        WaitFlag<HardEvent::MTE2_MTE1>(prefixReady);
        for(int k=0;k<paddedK;k+=Step) {
            if(k==512)WaitFlag<HardEvent::MTE2_MTE1>(cacheReady);
            const int bank=(k/Step)&1;
            WaitFlag<HardEvent::M_MTE1>(operandFree[bank]);
            LoadData2DParams a{};a.repeatTimes=physicalRows/16;a.srcStride=1;a.dstGap=Step/32-1;
            for(int reduction=0;reduction<Step;reduction+=32)
                LoadData(l0left[bank*Height*Step+reduction*16],left[(k+reduction)*Height],a);
            LoadData2dTransposeParams b{};b.repeatTimes=physicalColumns/32;
            b.srcStride=paddedK/32;b.dstGap=Step/32-1;
            for(int offset=0;offset<Step;offset+=32)
                LoadDataWithTranspose(l0right[bank*Width*Step+offset*physicalColumns],right[(k+offset)*32],b);
            SetFlag<HardEvent::MTE1_M>(operandReady[bank]);
            WaitFlag<HardEvent::MTE1_M>(operandReady[bank]);
            MmadParams dot{};dot.m=physicalRows;dot.n=physicalColumns;dot.k=Step;dot.cmatrixInitVal=!k;
            Mmad(sums,l0left[bank*Height*Step],l0right[bank*Width*Step],dot);
            SetFlag<HardEvent::M_MTE1>(operandFree[bank]);
        }
        SetFlag<HardEvent::MTE1_MTE2>(cacheFree);
        const int publication=sequence&1;
        if(sequence>=2)CrossCoreWaitFlag<2,PIPE_FIX>(8+publication);
        SetFlag<HardEvent::M_FIX>(sumReady);WaitFlag<HardEvent::M_FIX>(sumReady);
        FixpipeParamsV220 out{};out.nSize=physicalColumns;out.mSize=tile.rows;
        out.srcStride=physicalRows;out.dstStride=Width;out.ndNum=1;out.quantPre=QuantMode_t::NoQuant;
        Fixpipe<int32_t,int32_t>(destination,sums,out);
        CrossCoreSetFlag<2,PIPE_FIX>(8+publication);
        SetFlag<HardEvent::FIX_M>(sumFree);WaitFlag<HardEvent::FIX_M>(sumFree);
    }
    __aicore__ inline void Drain(int count) {
        for(int bank=0;bank<2;++bank) {
            if(count>bank)CrossCoreWaitFlag<2,PIPE_FIX>(8+bank);
            WaitFlag<HardEvent::M_MTE1>(operandFree[bank]);
            owner->ReleaseEventID<HardEvent::M_MTE1>(operandFree[bank]);
            owner->ReleaseEventID<HardEvent::MTE1_M>(operandReady[bank]);
        }
        WaitFlag<HardEvent::MTE1_MTE2>(cacheFree);
        owner->ReleaseEventID<HardEvent::MTE1_MTE2>(cacheFree);
        owner->ReleaseEventID<HardEvent::MTE2_MTE1>(cacheReady);
        owner->ReleaseEventID<HardEvent::MTE2_MTE1>(prefixReady);
        owner->ReleaseEventID<HardEvent::M_FIX>(sumReady);
        owner->ReleaseEventID<HardEvent::FIX_M>(sumFree);
    }
};

template<int Math> class Finish {
    static constexpr int ChunkRows=8,Lanes=ChunkRows*Width,Raw=Height/2*Width;
    TBuf<TPosition::VECCALC> storage;
    LocalTensor<int32_t> incoming;
    LocalTensor<float> z,absolute,polynomial,positive,coefficients;
    LocalTensor<half> outputs;
    GlobalTensor<float> scales;
    GlobalTensor<half> result;
    event_t reusable,loaded,written[2],ready[2];
    TPipe* owner;
    int columns,serial=0,expert=-1,column=-1;
public:
    static constexpr int Bytes=Raw*4+Lanes*20+Width*4;
    __aicore__ inline void Bind(GM_ADDR s,GM_ADDR y) {
        scales.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(s));
        result.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y));
    }
    __aicore__ inline void Init(TPipe& pipe,int n) {
        owner=&pipe;columns=n;pipe.InitBuffer(storage,Bytes);
        auto bytes=storage.Get<uint8_t>();incoming=bytes.ReinterpretCast<int32_t>();
        z=bytes[Raw*4].ReinterpretCast<float>();absolute=bytes[Raw*4+Lanes*4].ReinterpretCast<float>();
        polynomial=bytes[Raw*4+Lanes*8].ReinterpretCast<float>();positive=bytes[Raw*4+Lanes*12].ReinterpretCast<float>();
        outputs=bytes[Raw*4+Lanes*16].ReinterpretCast<half>();
        coefficients=bytes[Raw*4+Lanes*20].ReinterpretCast<float>();
        reusable=static_cast<event_t>(pipe.AllocEventID<HardEvent::V_MTE2>());
        loaded=static_cast<event_t>(pipe.AllocEventID<HardEvent::MTE2_V>());
        SetFlag<HardEvent::V_MTE2>(reusable);
        for(int b=0;b<2;++b) {
            written[b]=static_cast<event_t>(pipe.AllocEventID<HardEvent::MTE3_V>());
            ready[b]=static_cast<event_t>(pipe.AllocEventID<HardEvent::V_MTE3>());
            SetFlag<HardEvent::MTE3_V>(written[b]);
        }
    }
    __aicore__ inline void Run(GlobalTensor<int32_t> source,OutputTile tile,int part,int slot) {
        const int skip=part*(Height/2),rows=tile.rows>skip?(tile.rows-skip<Height/2?tile.rows-skip:Height/2):0;
        CrossCoreWaitFlag<2,PIPE_MTE2>(8+slot);
        if(!rows){CrossCoreSetFlag<2,PIPE_MTE2>(8+slot);return;}
        WaitFlag<HardEvent::V_MTE2>(reusable);
        const int pitch=(tile.columns+63)/64*64;
        DataCopyPad(incoming,source[skip*Width],
            DataCopyExtParams{uint16_t(rows),uint32_t(pitch*4),uint32_t((Width-pitch)*4),0,0},
            DataCopyPadExtParams<int32_t>{false,0,0,0});
        CrossCoreSetFlag<2,PIPE_MTE2>(8+slot);
        if(expert!=tile.expert || column!=tile.firstColumn) {
            DataCopyPad(coefficients,scales[int64_t(tile.expert)*columns+tile.firstColumn],
                DataCopyExtParams{1,uint32_t(tile.columns*4),0,0,0},DataCopyPadExtParams<float>{true,0,0,0});
            expert=tile.expert;column=tile.firstColumn;
        }
        SetFlag<HardEvent::MTE2_V>(loaded);WaitFlag<HardEvent::MTE2_V>(loaded);
        for(int first=0;first<rows;first+=ChunkRows) {
            const int active=rows-first<ChunkRows?rows-first:ChunkRows,count=active*pitch;
            Cast(z,incoming[first*pitch],RoundMode::CAST_RINT,count);PipeBarrier<PIPE_V>();
            for(int col=0;col<pitch;col+=64)
                Mul(z[col],z[col],coefficients[col],uint64_t(64),uint8_t(active),
                    BinaryRepeatParams{1,1,1,uint8_t(pitch/8),uint8_t(pitch/8),0});
            PipeBarrier<PIPE_V>();
            const int bank=serial++&1;
            if constexpr(Math==0) {
                WaitFlag<HardEvent::MTE3_V>(written[bank]);
                best_stream::HalfActivation<Lanes>(z,absolute,polynomial,outputs[bank*Lanes],count);
            } else {
                Abs(absolute,z,count);Maxs(positive,z,0.0f,count);PipeBarrier<PIPE_V>();
                if constexpr(Math==2) {
                Mins(absolute,absolute,5.5f,count);PipeBarrier<PIPE_V>();
                Muls(polynomial,absolute,-0.010681291979479f,count);PipeBarrier<PIPE_V>();
                Adds(polynomial,polynomial,-0.023635043782304f,count);PipeBarrier<PIPE_V>();
                Mul(polynomial,polynomial,absolute,count);PipeBarrier<PIPE_V>();
                Adds(polynomial,polynomial,0.97843150314482f,count);PipeBarrier<PIPE_V>();
                Mul(polynomial,polynomial,polynomial,count);PipeBarrier<PIPE_V>();
                Mul(polynomial,polynomial,polynomial,count);PipeBarrier<PIPE_V>();
                Mul(polynomial,polynomial,polynomial,count);PipeBarrier<PIPE_V>();
                Mul(polynomial,polynomial,polynomial,count);PipeBarrier<PIPE_V>();
                Mul(polynomial,polynomial,polynomial,count);PipeBarrier<PIPE_V>();
                Mul(polynomial,polynomial,absolute,count);PipeBarrier<PIPE_V>();
                }else{
                Muls(polynomial,absolute,-0.41371995302807546f,count);PipeBarrier<PIPE_V>();
                Adds(polynomial,polynomial,-0.7101098736245036f,count);PipeBarrier<PIPE_V>();
                Mul(polynomial,polynomial,absolute,count);PipeBarrier<PIPE_V>();
                Adds(polynomial,polynomial,-0.7144955029184085f,count);PipeBarrier<PIPE_V>();
                Exp(polynomial,polynomial,count);PipeBarrier<PIPE_V>();
                Mul(polynomial,polynomial,absolute,count);PipeBarrier<PIPE_V>();
                }
                Sub(positive,positive,polynomial,count);PipeBarrier<PIPE_V>();
                WaitFlag<HardEvent::MTE3_V>(written[bank]);
                Cast(outputs[bank*Lanes],positive,RoundMode::CAST_RINT,count);PipeBarrier<PIPE_V>();
            }
            SetFlag<HardEvent::V_MTE3>(ready[bank]);WaitFlag<HardEvent::V_MTE3>(ready[bank]);
            DataCopyPad(result[(tile.firstRow+skip+first)*columns+tile.firstColumn],outputs[bank*Lanes],
                DataCopyExtParams{uint16_t(active),uint32_t(tile.columns*2),
                    uint32_t((pitch-((tile.columns+15)&~15))/16),uint32_t((columns-tile.columns)*2),0});
            SetFlag<HardEvent::MTE3_V>(written[bank]);
        }
        SetFlag<HardEvent::V_MTE2>(reusable);
    }
    __aicore__ inline void Drain() {
        WaitFlag<HardEvent::V_MTE2>(reusable);
        owner->ReleaseEventID<HardEvent::V_MTE2>(reusable);
        owner->ReleaseEventID<HardEvent::MTE2_V>(loaded);
        for(int b=0;b<2;++b) {
            WaitFlag<HardEvent::MTE3_V>(written[b]);
            owner->ReleaseEventID<HardEvent::MTE3_V>(written[b]);
            owner->ReleaseEventID<HardEvent::V_MTE3>(ready[b]);
        }
    }
};

template<int Math> __aicore__ inline void Execute(GM_ADDR x,GM_ADDR w,GM_ADDR s,GM_ADDR groups,
        GM_ADDR y,GM_ADDR scratch,Geometry shape) {
    InitSocState();
    int pair=GetBlockIdx();if ASCEND_IS_AIV {pair/=2;}
    GlobalTensor<int32_t> exchange;
    exchange.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(scratch)+int64_t(pair)*2*Elements);
    TPipe pipe;
    SetupCostOrder<1> order(pipe,groups,shape,pair,nullptr);
    OutputTile tile{};int sequence=0;
    if ASCEND_IS_AIC {
        Product product;product.Bind(x,w);product.Init(pipe,shape);
        while(order.Next(tile)) {
            product.Run(tile,exchange[(sequence&1)*Elements],sequence);++sequence;
        }
        product.Drain(sequence);
    }
    if ASCEND_IS_AIV {
        Finish<Math> finish;finish.Bind(s,y);finish.Init(pipe,shape.columns);
        while(order.Next(tile)) {
            finish.Run(exchange[(sequence&1)*Elements],tile,GetBlockIdx()%2,sequence&1);++sequence;
        }
        finish.Drain();
    }
    PipeBarrier<PIPE_ALL>();
}
}

extern "C" __global__ __aicore__ __mix__(1,2) void IndependentResidentPanel(
    GM_ADDR x,GM_ADDR w,GM_ADDR s,GM_ADDR groups,GM_ADDR y,GM_ADDR scratch,sdk_gmmg::Geometry shape) {
    resident_panel::Execute<0>(x,w,s,groups,y,scratch,shape);
}
static bool TryResidentPanel(GM_ADDR x,const TensorGroupInfo& ix,GM_ADDR w,const TensorGroupInfo& iw,
    GM_ADDR s,const TensorGroupInfo& is,GM_ADDR groups,const TensorGroupInfo& ig,
    GM_ADDR y,const TensorGroupInfo& iy,int64_t available,aclrtStream stream) {
    using namespace sdk_gmmg;
    const int m=ix.tensors[0].shape[0],k=ix.tensors[0].shape[1],e=iw.tensors[0].shape[0],n=iw.tensors[0].shape[2];
    if(e<1 || k<=512 || n<=1024 || n%32==0 || m<=128*e || m>192*e)return false;
    const int kp=(k+63)/64*64,np=(n+383)/384*384;
    if(kp/32>255 || k*8<kp*7 || n*8<np*7)return false;
    Validate(is,2,0);Validate(ig,1,6);Validate(iy,2,1);
    if(!x||!w||!s||!groups||!y||available<1||m>65536||e>128||k>8192||n>4096||
       iw.tensors[0].shape[1]!=k||is.tensors[0].shape[0]!=e||is.tensors[0].shape[1]!=n||
       ig.tensors[0].shape[0]!=e||iy.tensors[0].shape[0]!=m||iy.tensors[0].shape[1]!=n)return false;
    auto platform=platform_ascendc::PlatformAscendCManager::GetInstance();if(!platform)return false;
    auto r=ReadResources(platform);const int blocks=std::min<int64_t>(available,std::min(r.cube,r.vector/2));
    if(!blocks || r.l1<uint64_t(80+384)*kp || r.l0a<10240 || r.l0b<49152 || r.l0c<122880 ||
       r.ub<resident_panel::Finish<0>::Bytes)return false;
    Geometry shape{e,m,k,n,80,384,blocks,kp,n};
    void* memory=nullptr;Check(aclrtMalloc(&memory,size_t(blocks)*2*80*384*4,ACL_MEM_MALLOC_HUGE_FIRST));
    IndependentResidentPanel<<<blocks,nullptr,stream>>>(x,w,s,groups,y,(GM_ADDR)memory,shape);
    const aclError status=aclrtSynchronizeStream(stream);aclrtFree(memory);Check(status);return true;
}

// Independently written one-wave product: no reusable slots on this route.
// Eligibility proves at most one tile per pair without reading groups on Host.
namespace small_resident {
using namespace AscendC;
using sdk_gmmg::Geometry;
using sdk_gmmg::OutputTile;
constexpr int Rows=16,Columns=128,VectorCapacity=Rows/2*Columns;

__aicore__ inline void Multiply(GM_ADDR x,GM_ADDR w,GM_ADDR scratch,
                               Geometry g,OutputTile tile,int pair) {
    GlobalTensor<int8_t> input,weights;
    GlobalTensor<int32_t> products;
    input.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
    weights.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(w));
    products.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(scratch)+pair*Rows*Columns);
    TPipe pipe;
    TBuf<TPosition::A1> astorage;
    TBuf<TPosition::B1> bstorage;
    TBuf<TPosition::A2> aoperand;
    TBuf<TPosition::B2> boperand;
    TBuf<TPosition::CO1> cstorage;
    pipe.InitBuffer(astorage,Rows*g.reduction);pipe.InitBuffer(bstorage,g.columns*g.reduction);
    pipe.InitBuffer(aoperand,Rows*g.reduction);pipe.InitBuffer(boperand,g.columns*g.reduction);
    pipe.InitBuffer(cstorage,Rows*g.columns*4);
    auto a1=astorage.Get<int8_t>(),b1=bstorage.Get<int8_t>();
    auto a0=aoperand.Get<int8_t>(),b0=boperand.Get<int8_t>();
    auto c0=cstorage.Get<int32_t>();
    if(tile.rows<Rows) {
        gmmg_safe_l1::ZeroBytes(a1,Rows*g.reduction);
    }
    Nd2NzParams a{};a.ndNum=1;a.nValue=tile.rows;a.dValue=g.reduction;
    a.srcDValue=g.reduction;a.dstNzC0Stride=Rows;a.dstNzNStride=1;
    DataCopy(a1,input[tile.firstRow*g.reduction],a);
    Nd2NzParams b{};b.ndNum=g.reduction/32;b.nValue=32;b.dValue=g.columns;
    b.srcNdMatrixStride=32*g.columns;b.srcDValue=g.columns;
    b.dstNzC0Stride=32;b.dstNzNStride=1;b.dstNzMatrixStride=32*g.columns;
    DataCopy(b1,weights[int64_t(tile.expert)*g.reduction*g.columns],b);
    SetFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);WaitFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);
    LoadData2DParams la{};la.repeatTimes=g.reduction/32;la.srcStride=1;
    LoadData(a0,a1,la);
    LoadData2dTransposeParams lb{};lb.repeatTimes=g.reduction/32*(g.columns/32);
    lb.srcStride=1;lb.dstGap=1;
    LoadDataWithTranspose(b0,b1,lb);
    SetFlag<HardEvent::MTE1_M>(EVENT_ID0);WaitFlag<HardEvent::MTE1_M>(EVENT_ID0);
    MmadParams mm{};mm.m=Rows;mm.n=g.columns;mm.k=g.reduction;mm.cmatrixInitVal=true;
    Mmad(c0,a0,b0,mm);
    SetFlag<HardEvent::M_FIX>(EVENT_ID0);WaitFlag<HardEvent::M_FIX>(EVENT_ID0);
    FixpipeParamsV220 copy{};copy.nSize=g.columns;copy.mSize=tile.rows;
    copy.srcStride=Rows;copy.dstStride=g.columns;copy.ndNum=1;copy.quantPre=QuantMode_t::NoQuant;
    Fixpipe<int32_t,int32_t>(products,c0,copy);
    CrossCoreSetFlag<2,PIPE_FIX>(8);
    PipeBarrier<PIPE_ALL>();
}

__aicore__ inline void Complete(GM_ADDR scratch,GM_ADDR s,GM_ADDR y,
                               Geometry g,OutputTile tile,int pair,int part) {
    GlobalTensor<int32_t> products;
    GlobalTensor<float> scales;
    GlobalTensor<half> result;
    products.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(scratch)+pair*Rows*Columns);
    scales.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(s));
    result.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y));
    constexpr int F=VectorCapacity*4;
    LocalTensor<int32_t> input(TPosition::VECCALC,0,VectorCapacity);
    LocalTensor<float> z(TPosition::VECCALC,F,VectorCapacity);
    LocalTensor<float> magnitude(TPosition::VECCALC,2*F,VectorCapacity);
    LocalTensor<float> exponent(TPosition::VECCALC,3*F,VectorCapacity);
    LocalTensor<float> positive(TPosition::VECCALC,4*F,VectorCapacity);
    LocalTensor<float> scale(TPosition::VECCALC,5*F,Columns);
    LocalTensor<half> output(TPosition::VECCALC,5*F+Columns*4,VectorCapacity);
    const int first=part*(Rows/2),rows=tile.rows>first?
        (tile.rows-first<Rows/2?tile.rows-first:Rows/2):0;
    if(rows)DataCopy(scale,scales[int64_t(tile.expert)*g.columns],g.columns);
    CrossCoreWaitFlag<2,PIPE_MTE2>(8);
    if(!rows)return;
    const int count=rows*g.columns;
    DataCopy(input,products[first*g.columns],count);
    SetFlag<HardEvent::MTE2_V>(EVENT_ID0);WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
    Cast(z,input,RoundMode::CAST_RINT,count);PipeBarrier<PIPE_V>();
    const uint8_t stride=g.columns/8;
    for(int col=0;col<g.columns;col+=64)
        Mul(z[col],z[col],scale[col],uint64_t(64),uint8_t(rows),
            BinaryRepeatParams{1,1,1,stride,stride,0});
    PipeBarrier<PIPE_V>();
    Abs(magnitude,z,count);Maxs(positive,z,0.0f,count);PipeBarrier<PIPE_V>();
    Muls(exponent,magnitude,-0.41371995302807546f,count);PipeBarrier<PIPE_V>();
    Adds(exponent,exponent,-0.7101098736245036f,count);PipeBarrier<PIPE_V>();
    Mul(exponent,exponent,magnitude,count);PipeBarrier<PIPE_V>();
    Adds(exponent,exponent,-0.7144955029184085f,count);PipeBarrier<PIPE_V>();
    Exp(exponent,exponent,count);PipeBarrier<PIPE_V>();
    Mul(exponent,exponent,magnitude,count);PipeBarrier<PIPE_V>();
    Sub(z,positive,exponent,count);PipeBarrier<PIPE_V>();
    Cast(output,z,RoundMode::CAST_RINT,count);
    SetFlag<HardEvent::V_MTE3>(EVENT_ID0);WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
    DataCopy(result[(tile.firstRow+first)*g.columns],output,count);
    PipeBarrier<PIPE_ALL>();
}
}

extern "C" __global__ __aicore__ __mix__(1,2) void IndependentSmallResident(
    GM_ADDR x,GM_ADDR w,GM_ADDR s,GM_ADDR groups,GM_ADDR y,GM_ADDR scratch,sdk_gmmg::Geometry g) {
    AscendC::InitSocState();
    int pair=AscendC::GetBlockIdx();if ASCEND_IS_AIV {pair/=2;}
    AscendC::GlobalTensor<int64_t> boundaries;
    boundaries.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups),g.experts);
    sdk_gmmg::OutputTile tile{};
    int64_t first=0;int remaining=pair;bool found=false;
    for(int expert=0;expert<g.experts;++expert) {
        const int64_t end=boundaries.GetValue(expert);
        const int tiles=int((end-first+15)>>4);
        if(remaining<tiles) {
            tile.firstRow=first+(remaining<<4);tile.expert=expert;
            tile.rows=int(end-tile.firstRow);if(tile.rows>16)tile.rows=16;
            tile.firstColumn=0;tile.columns=g.columns;tile.pitch=g.columns;found=true;break;
        }
        remaining-=tiles;first=end;
    }
    if(!found)return;
    if ASCEND_IS_AIC {small_resident::Multiply(x,w,scratch,g,tile,pair);}
    if ASCEND_IS_AIV {small_resident::Complete(scratch,s,y,g,tile,pair,AscendC::GetBlockIdx()%2);}
}

static bool TrySmallResident(GM_ADDR x,const TensorGroupInfo& ix,GM_ADDR w,const TensorGroupInfo& iw,
    GM_ADDR s,const TensorGroupInfo& is,GM_ADDR groups,const TensorGroupInfo& ig,
    GM_ADDR y,const TensorGroupInfo& iy,int64_t available,aclrtStream stream) {
    using namespace sdk_gmmg;
    const int m=ix.tensors[0].shape[0],k=ix.tensors[0].shape[1];
    const int e=iw.tensors[0].shape[0],n=iw.tensors[0].shape[2];
    if(k<32||k>128||k%32||n<64||n>128||n%64||m<1||e<1||e>128||available<1)return false;
    const int nonempty=std::min(e,m),upper=nonempty+(m-nonempty)/16;
    auto platform=platform_ascendc::PlatformAscendCManager::GetInstance();if(!platform)return false;
    const auto r=ReadResources(platform);
    const int cores=std::min<int64_t>(available,std::min(r.cube,r.vector/2));
    if(upper>cores||r.l1<uint64_t(16+n)*k||r.l0a<uint64_t(16)*k||r.l0b<uint64_t(n)*k||
       r.l0c<16u*n*4||r.ub<23040)return false;
    Validate(is,2,0);Validate(ig,1,6);Validate(iy,2,1);
    if(!x||!w||!s||!groups||!y||iw.tensors[0].shape[1]!=k||is.tensors[0].shape[0]!=e||
       is.tensors[0].shape[1]!=n||ig.tensors[0].shape[0]!=e||iy.tensors[0].shape[0]!=m||
       iy.tensors[0].shape[1]!=n)return false;
    Geometry shape{e,m,k,n,16,n,upper,k,n};
    void* temporary=nullptr;
    Check(aclrtMalloc(&temporary,size_t(upper)*16*128*4,ACL_MEM_MALLOC_HUGE_FIRST));
    IndependentSmallResident<<<upper,nullptr,stream>>>(x,w,s,groups,y,(GM_ADDR)temporary,shape);
    const aclError status=aclrtSynchronizeStream(stream);aclrtFree(temporary);Check(status);return true;
}

static void RunManual(GM_ADDR x,const TensorGroupInfo& ix,GM_ADDR w,const TensorGroupInfo& iw,
 GM_ADDR s,const TensorGroupInfo& is,GM_ADDR g,const TensorGroupInfo& ig,GM_ADDR y,const TensorGroupInfo& iy,
 int64_t cores,aclrtStream stream){ const int64_t M=ix.tensors[0].shape[0],K=ix.tensors[0].shape[1],N=iw.tensors[0].shape[2],E=iw.tensors[0].shape[0];
 const int64_t outputs=M*N;const int64_t work=outputs*K;
 if(outputs<=32 && work<=256) { if(outputs==1) qfc(x,ix,w,iw,s,is,g,ig,y,iy,cores,stream); else qbc(x,ix,w,iw,s,is,g,ig,y,iy,cores,stream); }
 else if(K<256 && outputs<65536) qno(x,ix,w,iw,s,is,g,ig,y,iy,cores,stream);
 else if(K<=256) q5q(x,ix,w,iw,s,is,g,ig,y,iy,cores,stream);
 else if(K>4096) q28(x,ix,w,iw,s,is,g,ig,y,iy,cores,stream);
 else if(K<768) qmq(x,ix,w,iw,s,is,g,ig,y,iy,cores,stream);
 else if(K<=1024 && N<768) qhq(x,ix,w,iw,s,is,g,ig,y,iy,cores,stream);
 else if(N>=1024) qe6(x,ix,w,iw,s,is,g,ig,y,iy,cores,stream);
 else if(M<128*E) qw2(x,ix,w,iw,s,is,g,ig,y,iy,cores,stream);
 else qe1(x,ix,w,iw,s,is,g,ig,y,iy,cores,stream);
}

extern "C" __global__ __aicore__ __mix__(1,2) void BestNativeMediumLookahead(
 GM_ADDR x,GM_ADDR w,GM_ADDR s,GM_ADDR groups,GM_ADDR y,GM_ADDR system,GM_ADDR scratch,
 GM_ADDR prepared,sdk_gmmg::Geometry shape,TCubeTiling tiling){
 best_stream::Execute<64,128,3,false,false,true,3,1>(x,w,s,groups,y,system,scratch,prepared,shape,tiling);
}

// Reuse equal scalar operands observed in the current invocation.
// Compute one current-weight/current-scale activation and publish to its rows.
__global__ __vector__ void SharedProductActivation(
    GM_ADDR xAddress,GM_ADDR wAddress,GM_ADDR sAddress,GM_ADDR gAddress,GM_ADDR yAddress,
    int32_t experts,int32_t rows,int32_t columns) {
    using namespace AscendC;
    constexpr int Width=4096,RowCapacity=8192,Bytes=Width*25+RowCapacity*5;
    const int lane=GetBlockIdx(),lanes=GetBlockNum(),stride=(columns+63)&~63;
    GlobalTensor<int8_t> input,weight;GlobalTensor<float> scale;
    GlobalTensor<int64_t> groups;GlobalTensor<half> output;
    input.SetGlobalBuffer((__gm__ int8_t*)xAddress);weight.SetGlobalBuffer((__gm__ int8_t*)wAddress);
    scale.SetGlobalBuffer((__gm__ float*)sAddress);groups.SetGlobalBuffer((__gm__ int64_t*)gAddress);
    output.SetGlobalBuffer((__gm__ half*)yAddress);
    TPipe pipe;TBuf<TPosition::VECCALC> memory;pipe.InitBuffer(memory,Bytes);
    auto bytes=memory.Get<uint8_t>();auto raw=bytes.ReinterpretCast<int8_t>();
    auto bridge=bytes[Width].ReinterpretCast<half>();
    auto values=bytes[Width*3].ReinterpretCast<float>();
    auto coefficients=bytes[Width*7].ReinterpretCast<float>();
    auto z=bytes[Width*11].ReinterpretCast<float>();
    auto argument=bytes[Width*15].ReinterpretCast<float>();
    auto denominator=bytes[Width*19].ReinterpretCast<float>();
    auto packed=bytes[Width*23].ReinterpretCast<half>();
    auto allX=bytes[Width*25].ReinterpretCast<int8_t>();
    auto nextRow=bytes[Width*25+RowCapacity].ReinterpretCast<int32_t>();
    DataCopyPad(allX,input,DataCopyExtParams{1,uint32_t(rows),0,0,0},DataCopyPadExtParams<int8_t>{false,0,0,0});
    SetFlag<HardEvent::MTE2_S>(EVENT_ID0);WaitFlag<HardEvent::MTE2_S>(EVENT_ID0);
    int cached=-1;
    for(int task=lane;task<experts*16;task+=lanes){
        const int expert=task/16,valueBase=(task%16)*16;
        const int first=expert?int(groups.GetValue(expert-1)):0,last=int(groups.GetValue(expert));
        if(first==last)continue;
        int head[16];for(int i=0;i<16;++i)head[i]=-1;
        bool any=false;
        for(int row=first;row<last;++row){
            const int slot=int(allX.GetValue(row))+128-valueBase;
            if(uint32_t(slot)<16){nextRow.SetValue(row,head[slot]);head[slot]=row;any=true;}
        }
        if(!any)continue;
        if(cached!=expert){
            Duplicate(raw.ReinterpretCast<uint16_t>(),uint16_t(0),Width/2);Duplicate(coefficients,0.0f,Width);
            SetFlag<HardEvent::V_MTE2>(EVENT_ID0);WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
            DataCopyPad(raw,weight[int64_t(expert)*columns],DataCopyExtParams{1,uint32_t(columns),0,0,0},DataCopyPadExtParams<int8_t>{false,0,0,0});
            DataCopyPad(coefficients,scale[int64_t(expert)*columns],DataCopyExtParams{1,uint32_t(columns*4),0,0,0},DataCopyPadExtParams<float>{false,0,0,0});
            SetFlag<HardEvent::MTE2_V>(EVENT_ID0);WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
            Cast(bridge,raw,RoundMode::CAST_NONE,stride);PipeBarrier<PIPE_V>();
            Cast(values,bridge,RoundMode::CAST_NONE,stride);PipeBarrier<PIPE_V>();cached=expert;
        }
        for(int slot=0;slot<16;++slot){
            if(head[slot]<0)continue;
            Muls(z,values,float(valueBase+slot-128),stride);PipeBarrier<PIPE_V>();
            Mul(z,z,coefficients,stride);PipeBarrier<PIPE_V>();
            sdk_gmmg::GeluEstimate(z,argument,denominator,packed,stride);
            SetFlag<HardEvent::V_MTE3>(EVENT_ID0);WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
            for(int row=head[slot];row>=0;row=nextRow.GetValue(row))
                DataCopyPad(output[int64_t(row)*columns],packed,DataCopyExtParams{1,uint32_t(columns*2),0,0,0});
            SetFlag<HardEvent::MTE3_V>(EVENT_ID0);WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
        }
    }
}
static bool TrySharedActivation(GM_ADDR x,const TensorGroupInfo& ix,GM_ADDR w,const TensorGroupInfo& iw,
    GM_ADDR s,const TensorGroupInfo& is,GM_ADDR groups,const TensorGroupInfo& ig,
    GM_ADDR y,const TensorGroupInfo& iy,int64_t available,aclrtStream stream) {
    using namespace sdk_gmmg;
    const int m=ix.tensors[0].shape[0],k=ix.tensors[0].shape[1],e=iw.tensors[0].shape[0],n=iw.tensors[0].shape[2];
    if(k!=1||n<64||n>4096||m<=32||m>8192)return false;
    auto platform=platform_ascendc::PlatformAscendCManager::GetInstance();if(!platform)return false;
    const auto resources=ReadResources(platform);if(resources.ub<4096u*25+8192u*5)return false;
    const int blocks=std::min<int64_t>(available,std::min<int64_t>(resources.vector,e*16));if(blocks<1)return false;
    SharedProductActivation<<<blocks,nullptr,stream>>>(x,w,s,groups,y,e,m,n);return true;
}

namespace projection {
using namespace AscendC;
using Plain=matmul::MatmulType<TPosition::GM,CubeFormat::ND,int8_t>;
using Transposed=matmul::MatmulType<TPosition::GM,CubeFormat::ND,int8_t,true>;
using Integer=matmul::MatmulType<TPosition::GM,CubeFormat::ND,int32_t>;
using Multiply=matmul::Matmul<Plain,Transposed,Integer,Integer,CFG_MDL>;
constexpr int Tile=128;
}
__global__ __aicore__ __mix__(1,2) void TransposedProjection(
    GM_ADDR xAddress,GM_ADDR wAddress,GM_ADDR sAddress,GM_ADDR gAddress,GM_ADDR yAddress,
    GM_ADDR system,GM_ADDR products,sdk_gmmg::Geometry g,TCubeTiling tiling) {
    using namespace AscendC;using namespace projection;
    SetSysWorkspaceForce(system);clearWorkspace(system);
    TPipe pipe;Multiply multiply;REGIST_MATMUL_OBJ(&pipe,GetSysWorkSpacePtr(),multiply,&tiling);
    if ASCEND_IS_AIV {
        const int lane=GetBlockIdx(),lanes=GetBlockNum()*2;
        GlobalTensor<int8_t> input,weights;GlobalTensor<float> scales;GlobalTensor<half> output;GlobalTensor<int32_t> sums;
        input.SetGlobalBuffer((__gm__ int8_t*)xAddress);weights.SetGlobalBuffer((__gm__ int8_t*)wAddress);
        scales.SetGlobalBuffer((__gm__ float*)sAddress);output.SetGlobalBuffer((__gm__ half*)yAddress);
        sums.SetGlobalBuffer((__gm__ int32_t*)products+lane*Tile);
        TBuf<TPosition::VECCALC> storage;pipe.InitBuffer(storage,Tile*18);
        auto bytes=storage.Get<uint8_t>();auto integers=bytes.ReinterpretCast<int32_t>();
        auto z=bytes[Tile*4].ReinterpretCast<float>();auto a=bytes[Tile*8].ReinterpretCast<float>();
        auto b=bytes[Tile*12].ReinterpretCast<float>();auto out=bytes[Tile*16].ReinterpretCast<half>();
        sdk_gmmg::GroupCursor cursor(gAddress,g,lane,lanes);sdk_gmmg::OutputTile tile{};
        while(cursor.Next(tile)){
            multiply.SetOrgShape(1,g.rows,g.reduction,g.reduction,Tile);
            multiply.SetSingleShape(1,tile.rows,g.reduction);
            multiply.SetTensorA(weights[int64_t(tile.expert)*g.reduction]);
            multiply.SetTensorB(input[tile.firstRow*g.reduction],true);
            multiply.IterateAll(sums);multiply.End();
            const int count=(tile.rows+63)&~63;
            Duplicate(integers,int32_t(0),Tile);
            SetFlag<HardEvent::V_MTE2>(EVENT_ID0);WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
            DataCopyPad(integers,sums,DataCopyExtParams{1,uint32_t(tile.rows*4),0,0,0},DataCopyPadExtParams<int32_t>{false,0,0,0});
            SetFlag<HardEvent::MTE2_V>(EVENT_ID0);WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
            Cast(z,integers,RoundMode::CAST_RINT,count);PipeBarrier<PIPE_V>();
            Muls(z,z,scales.GetValue(tile.expert),count);PipeBarrier<PIPE_V>();
            sdk_gmmg::GeluEstimate(z,a,b,out,count);
            SetFlag<HardEvent::V_MTE3>(EVENT_ID0);WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
            DataCopyPad(output[tile.firstRow],out,DataCopyExtParams{1,uint32_t(tile.rows*2),0,0,0});
            SetFlag<HardEvent::MTE3_V>(EVENT_ID0);WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
        }
    }
}
static bool TryProjection(GM_ADDR x,const TensorGroupInfo& ix,GM_ADDR w,const TensorGroupInfo& iw,
    GM_ADDR s,const TensorGroupInfo& is,GM_ADDR groups,const TensorGroupInfo& ig,
    GM_ADDR y,const TensorGroupInfo& iy,int64_t available,aclrtStream stream) {
    using namespace sdk_gmmg;
    const int m=ix.tensors[0].shape[0],k=ix.tensors[0].shape[1],e=iw.tensors[0].shape[0],n=iw.tensors[0].shape[2];
    if(n!=1||k<256||m<128)return false;
    auto platform=platform_ascendc::PlatformAscendCManager::GetInstance();if(!platform)return false;
    const auto resources=ReadResources(platform);const int blocks=std::min<int64_t>(available,std::min(resources.cube,resources.vector/2));
    if(blocks<1)return false;
    matmul_tiling::MatmulApiTiling plan(*platform);
    plan.SetMatmulConfigParams(1);
    plan.SetAType(matmul_tiling::TPosition::GM,matmul_tiling::CubeFormat::ND,matmul_tiling::DataType::DT_INT8);
    plan.SetBType(matmul_tiling::TPosition::GM,matmul_tiling::CubeFormat::ND,matmul_tiling::DataType::DT_INT8,true);
    plan.SetCType(matmul_tiling::TPosition::GM,matmul_tiling::CubeFormat::ND,matmul_tiling::DataType::DT_INT32);
    plan.SetShape(1,projection::Tile,k);plan.SetOrgShape(1,m,k);plan.SetFixSplit(16,projection::Tile,128);plan.SetBufferSpace(-1,-1,-1);
    TCubeTiling tiling{};if(plan.GetTiling(tiling)!=0)return false;
    const size_t systemBytes=(platform->GetLibApiWorkSpaceSize()+511)&~size_t(511);
    void* memory=nullptr;Check(aclrtMalloc(&memory,systemBytes+size_t(blocks)*2*projection::Tile*4,ACL_MEM_MALLOC_HUGE_FIRST));
    Geometry g{e,m,k,n,projection::Tile,1,blocks,k,n};
    TransposedProjection<<<blocks,nullptr,stream>>>(x,w,s,groups,y,(GM_ADDR)memory,(GM_ADDR)((uint8_t*)memory+systemBytes),g,tiling);
    const auto status=aclrtSynchronizeStream(stream);aclrtFree(memory);Check(status);return true;
}

extern "C" void run_kernel(GM_ADDR x,const TensorGroupInfo& ix,GM_ADDR w,const TensorGroupInfo& iw,
 GM_ADDR s,const TensorGroupInfo& is,GM_ADDR g,const TensorGroupInfo& ig,GM_ADDR y,const TensorGroupInfo& iy,
 int64_t cores,aclrtStream stream) {
 sdk_gmmg::Validate(ix,2,3); sdk_gmmg::Validate(iw,3,3);
 const int64_t M=ix.tensors[0].shape[0],K=ix.tensors[0].shape[1],N=iw.tensors[0].shape[2];
 const int64_t outputs=M*N;
 const bool tiny=(outputs<=32 && outputs*K<=256) || (K<256 && outputs<65536);
 if(tiny && outputs>1 && outputs<=32 && K<=4 && outputs*K<=256) {
    qbc(x,ix,w,iw,s,is,g,ig,y,iy,cores,stream);return;
 }
 if(TryProjection(x,ix,w,iw,s,is,g,ig,y,iy,cores,stream))return;
 if(TrySharedActivation(x,ix,w,iw,s,is,g,ig,y,iy,cores,stream))return;
 if(TrySmallResident(x,ix,w,iw,s,is,g,ig,y,iy,cores,stream))return;
 if(TryResidentPanel(x,ix,w,iw,s,is,g,ig,y,iy,cores,stream))return;
 if(TryColumns512(x,ix,w,iw,s,is,g,ig,y,iy,cores,stream))return;
 if(TryBestStream(x,ix,w,iw,s,is,g,ig,y,iy,cores,stream))return;
 const bool aligned=!(K%32) && !(N%32);
 bool sdkPreferred=!tiny && (N==1 || (K>4096 && M>1024*iw.tensors[0].shape[0] && (N%32)!=0) || (K<=4096 && (aligned || K<768 || PreferStage(iw.tensors[0].shape[0],M,K,N))));
 if(sdkPreferred && TryRunSdk(x,ix,w,iw,s,is,g,ig,y,iy,cores,stream)) return;
 RunManual(x,ix,w,iw,s,is,g,ig,y,iy,cores,stream);
}
