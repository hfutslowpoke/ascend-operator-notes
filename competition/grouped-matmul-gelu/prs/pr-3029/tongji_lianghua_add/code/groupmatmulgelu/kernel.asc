        PipeBarrier<PIPE_ALL>();
    }
    Nd2NzParams cp{};cp.ndNum=1;cp.nValue=tile.qs5;cp.dValue=actual;cp.srcDValue=K;cp.dstNzC0Stride=BM;cp.dstNzNStride=1;
    DataCopy(a1,x[uint64_t(tile.q5h)*K+start],cp);
    for(int side=0;side<count;++side) {
        const int column=side==2?(N/(2*BN))*2*BN:tile.qh4+side*BN;
        const int width=N-column<=32?32:BN;
