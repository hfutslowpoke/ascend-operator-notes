template<class Reader> class OriginalPairedOrder {
    qol shape;Reader ends;
    uint64_t wanted,prefix=0;uint32_t first=0,last=0,expert=0,pairs;
    uint64_t items=0,serial=0;bool pending=false;qds saved{};
public:
    __aicore__ inline OriginalPairedOrder(qol g,uint32_t block,Reader r):shape(g),ends(r),wanted(block),pairs((g.q9b+2*g.qrg-1)/(2*g.qrg)) {}
    __aicore__ inline bool q5i(qds& tile) {
