__aicore__ inline void GeluTanh(LocalTensor<float>,LocalTensor<float>,LocalTensor<float>,LocalTensor<float>,uint32_t);

    template <int Elements = 2048>
    __aicore__ inline void ProductError(LocalTensor<float> error, LocalTensor<float> a,
					LocalTensor<float> b, LocalTensor<float> product,
					LocalTensor<float> work, uint32_t count)
    {
	auto ah = work[8 * Elements], al = work[9 * Elements];
	auto bh = work[10 * Elements], bl = work[11 * Elements];
	Muls(ah, a, 4097.0f, count);
	PipeBarrier<PIPE_V>();
	Sub(al, ah, a, count);
	PipeBarrier<PIPE_V>();
	Sub(ah, ah, al, count);
	PipeBarrier<PIPE_V>();
	Sub(al, a, ah, count);
	Muls(bh, b, 4097.0f, count);
	PipeBarrier<PIPE_V>();
	Sub(bl, bh, b, count);
	PipeBarrier<PIPE_V>();
	Sub(bh, bh, bl, count);
	PipeBarrier<PIPE_V>();
	Sub(bl, b, bh, count);
	PipeBarrier<PIPE_V>();
	Mul(error, ah, bh, count);
	PipeBarrier<PIPE_V>();
	Sub(error, error, product, count);
	Mul(bh, al, bh, count);
	Mul(ah, ah, bl, count);
	Mul(al, al, bl, count);
	PipeBarrier<PIPE_V>();
	Add(error, error, ah, count);
	PipeBarrier<PIPE_V>();
	Add(error, error, bh, count);
	PipeBarrier<PIPE_V>();
	Add(error, error, al, count);
	PipeBarrier<PIPE_V>();
    }

    template <int Elements = 2048>
    __aicore__ inline void ExpStep(LocalTensor<float> h, LocalTensor<float> l,
				   LocalTensor<float> rh, LocalTensor<float> rl,
				   LocalTensor<float> ph, LocalTensor<float> pl,
				   LocalTensor<float> tmp, LocalTensor<float> coef, float ch,
				   float cl, LocalTensor<float> work, uint32_t count)
    {
	Mul(ph, h, rh, count);
	PipeBarrier<PIPE_V>();
	Muls(tmp, ph, -1.0f, count);
	Adds(pl, h, 0.0f, count);
	PipeBarrier<PIPE_V>();
	ProductError<Elements>(pl, h, rh, ph, work, count);
	PipeBarrier<PIPE_V>();
	Mul(tmp, l, rh, count);
	PipeBarrier<PIPE_V>();
	Add(pl, pl, tmp, count);
	PipeBarrier<PIPE_V>();
	Mul(tmp, h, rl, count);
	PipeBarrier<PIPE_V>();
	Add(pl, pl, tmp, count);
	PipeBarrier<PIPE_V>();
	Adds(h, ph, ch, count);
	PipeBarrier<PIPE_V>();
	Adds(l, h, -ch, count);
	PipeBarrier<PIPE_V>();
	Sub(tmp, h, l, count);
	PipeBarrier<PIPE_V>();
	Sub(l, ph, l, count);
	Duplicate(coef, ch, count);
	PipeBarrier<PIPE_V>();
	Sub(tmp, coef, tmp, count);
	PipeBarrier<PIPE_V>();
	Add(l, l, tmp, count);
	PipeBarrier<PIPE_V>();
	Add(l, l, pl, count);
	PipeBarrier<PIPE_V>();
	Adds(l, l, cl, count);
	PipeBarrier<PIPE_V>();
    }

    template <int Elements = 2048>
    __aicore__ inline void AccurateExpNeg(LocalTensor<float> h, LocalTensor<float> l,
					  LocalTensor<float> evenH, LocalTensor<float> work,
					  uint32_t count)
    {
	auto rh = work, rl = work[Elements], power = work[2 * Elements];
	auto ph = work[3 * Elements], pl = work[4 * Elements];
	auto tmp = work[5 * Elements], coef = work[6 * Elements];
	auto aux = work[7 * Elements];
	auto mask = ph.ReinterpretCast<uint8_t>();
	CompareScalar(mask, h, 40.0f, CMPMODE::LE, count);
	Duplicate(tmp, 0.0f, count);
	PipeBarrier<PIPE_V>();
	Select(l, mask, l, tmp, SELMODE::VSEL_TENSOR_TENSOR_MODE, count);
	Mins(h, h, 40.0f, count);
	PipeBarrier<PIPE_V>();
	Muls(h, h, -1.0f, count);
	Muls(l, l, -1.0f, count);
	PipeBarrier<PIPE_V>();
	Muls(power, h, 1.4426950408889634f, count);
	PipeBarrier<PIPE_V>();
	Cast(ph.ReinterpretCast<int32_t>(), power, RoundMode::CAST_RINT, count);
	PipeBarrier<PIPE_V>();
	Cast(power, ph.ReinterpretCast<int32_t>(), RoundMode::CAST_RINT, count);
	PipeBarrier<PIPE_V>();

	Muls(rh, power, -0.693115234375f, count);
	PipeBarrier<PIPE_V>();
	Add(rh, rh, h, count);
	PipeBarrier<PIPE_V>();
	Muls(rl, power, -3.194618329871446e-05f, count);
	PipeBarrier<PIPE_V>();
	Muls(tmp, rl, -1.0f, count);
	Muls(aux, power, -1.0f, count);
	Duplicate(coef, 3.194618329871446e-05f, count);
	PipeBarrier<PIPE_V>();
	ProductError<Elements>(aux, aux, coef, rl, work, count);
	PipeBarrier<PIPE_V>();
	Muls(tmp, power, -1.6465717678215697e-12f, count);
	PipeBarrier<PIPE_V>();
	Add(aux, aux, tmp, count);
	PipeBarrier<PIPE_V>();
	Add(aux, aux, l, count);
	PipeBarrier<PIPE_V>();
	Add(ph, rh, rl, count);
	PipeBarrier<PIPE_V>();
	Sub(pl, ph, rh, count);
	PipeBarrier<PIPE_V>();
	Sub(tmp, ph, pl, count);
	PipeBarrier<PIPE_V>();
	Sub(tmp, rh, tmp, count);
	PipeBarrier<PIPE_V>();
	Sub(rl, rl, pl, count);
	PipeBarrier<PIPE_V>();
	Add(rl, rl, tmp, count);
	PipeBarrier<PIPE_V>();
	Add(rl, rl, aux, count);
	Adds(rh, ph, 0.0f, count);
	PipeBarrier<PIPE_V>();
	Cast(ph.ReinterpretCast<int32_t>(), power, RoundMode::CAST_RINT, count);
	PipeBarrier<PIPE_V>();
	Adds(ph.ReinterpretCast<int32_t>(), ph.ReinterpretCast<int32_t>(), int32_t(127), count);
	PipeBarrier<PIPE_V>();
	ShiftLeft(power.ReinterpretCast<uint32_t>(), ph.ReinterpretCast<uint32_t>(), uint32_t(23),
		  count);
	PipeBarrier<PIPE_V>();

	auto r2h = work[12 * Elements], r2l = work[13 * Elements];
	Mul(r2h, rh, rh, count);
	PipeBarrier<PIPE_V>();
	ProductError<Elements>(r2l, rh, rh, r2h, work, count);
	Mul(tmp, rh, rl, count);
	PipeBarrier<PIPE_V>();
	Muls(tmp, tmp, 2.0f, count);
	PipeBarrier<PIPE_V>();
	Add(r2l, r2l, tmp, count);
	PipeBarrier<PIPE_V>();
	Mul(tmp, rl, rl, count);
	PipeBarrier<PIPE_V>();
	Add(r2l, r2l, tmp, count);
	PipeBarrier<PIPE_V>();
	Duplicate(h, 0.0009920635493472219f, count);
	Duplicate(l, -5.72837298429274e-11f, count);
	PipeBarrier<PIPE_V>();
	ExpStep<Elements>(h, l, r2h, r2l, ph, pl, tmp, coef, 0.1111111119389534f,
			  -8.278422947149977e-10f, work, count);
	ExpStep<Elements>(h, l, r2h, r2l, ph, pl, tmp, coef, 1.0f, 0.0f, work, count);
	Adds(evenH, h, 0.0f, count);
	Adds(aux, l, 0.0f, count);
	PipeBarrier<PIPE_V>();
	Duplicate(h, 3.3068783523049206e-05f, count);
	Duplicate(l, -4.5426613452847e-13f, count);
	PipeBarrier<PIPE_V>();
	ExpStep<Elements>(h, l, r2h, r2l, ph, pl, tmp, coef, 0.013888888992369175f,
			  -1.0348028683937471e-10f, work, count);
	ExpStep<Elements>(h, l, r2h, r2l, ph, pl, tmp, coef, 0.5f, 0.0f, work, count);
	Mul(ph, h, rh, count);
	PipeBarrier<PIPE_V>();
	ProductError<Elements>(pl, h, rh, ph, work, count);
	Mul(tmp, l, rh, count);
	PipeBarrier<PIPE_V>();
	Add(pl, pl, tmp, count);
	PipeBarrier<PIPE_V>();
	Mul(tmp, h, rl, count);
	PipeBarrier<PIPE_V>();
	Add(pl, pl, tmp, count);
	Adds(h, ph, 0.0f, count);
	PipeBarrier<PIPE_V>();
	Adds(l, pl, 0.0f, count);
	PipeBarrier<PIPE_V>();

	Add(ph, evenH, h, count);
	PipeBarrier<PIPE_V>();
	Sub(tmp, ph, evenH, count);
	PipeBarrier<PIPE_V>();
	Sub(coef, ph, tmp, count);
	PipeBarrier<PIPE_V>();
	Sub(coef, evenH, coef, count);
	Sub(tmp, h, tmp, count);
	PipeBarrier<PIPE_V>();
	Add(pl, coef, tmp, count);
	PipeBarrier<PIPE_V>();
	Add(pl, pl, aux, count);
	PipeBarrier<PIPE_V>();
	Add(pl, pl, l, count);
	PipeBarrier<PIPE_V>();

	Sub(r2h, evenH, h, count);
	PipeBarrier<PIPE_V>();
	Sub(tmp, r2h, evenH, count);
	PipeBarrier<PIPE_V>();
	Sub(coef, r2h, tmp, count);
	PipeBarrier<PIPE_V>();
	Sub(coef, evenH, coef, count);
	Muls(h, h, -1.0f, count);
	PipeBarrier<PIPE_V>();
	Sub(tmp, h, tmp, count);
	PipeBarrier<PIPE_V>();
	Add(r2l, coef, tmp, count);
	PipeBarrier<PIPE_V>();
	Add(r2l, r2l, aux, count);
	PipeBarrier<PIPE_V>();
	Sub(r2l, r2l, l, count);
	PipeBarrier<PIPE_V>();
	Div(h, ph, r2h, count);
	PipeBarrier<PIPE_V>();
	ProductError<Elements>(l, h, r2h, ph, work, count);
	Muls(l, l, -1.0f, count);
	Mul(tmp, h, r2l, count);
	PipeBarrier<PIPE_V>();
	Add(l, l, pl, count);
	PipeBarrier<PIPE_V>();
	Sub(l, l, tmp, count);
	PipeBarrier<PIPE_V>();
	Div(l, l, r2h, count);
	PipeBarrier<PIPE_V>();
	Mul(h, h, power, count);
	Mul(l, l, power, count);
	PipeBarrier<PIPE_V>();

	CompareScalar(mask, h, 1.1102230246251565e-16f, CMPMODE::GT, count);
	Duplicate(tmp, 0.0f, count);
	PipeBarrier<PIPE_V>();
	Select(h, mask, h, tmp, SELMODE::VSEL_TENSOR_TENSOR_MODE, count);
	Select(l, mask, l, tmp, SELMODE::VSEL_TENSOR_TENSOR_MODE, count);
	PipeBarrier<PIPE_V>();
    }

    template <int Elements = 2048>
    __aicore__ inline void GeluArgument(LocalTensor<float> z, LocalTensor<float> p,
					LocalTensor<float> t, LocalTensor<float> num,
					LocalTensor<float> work, uint32_t count)
    {
	auto a = work;
	auto b = work[Elements];
	auto c = work[2 * Elements];
	auto d = work[3 * Elements];
	auto e = work[4 * Elements];

	Mul(p, z, z, count);
	PipeBarrier<PIPE_V>();
	Muls(e, p, -1.0f, count);
	Adds(t, z, 0.0f, count);
	PipeBarrier<PIPE_V>();
	ProductError<Elements>(t, z, z, p, work, count);
	PipeBarrier<PIPE_V>();
	Muls(a, p, 0.07135481387376785f, count);
	PipeBarrier<PIPE_V>();
	Muls(e, a, -1.0f, count);
	Adds(b, p, 0.0f, count);
	Duplicate(num, 0.07135481387376785f, count);
	PipeBarrier<PIPE_V>();
	ProductError<Elements>(b, p, num, a, work, count);
	PipeBarrier<PIPE_V>();
	Muls(e, t, 0.07135481387376785f, count);
	PipeBarrier<PIPE_V>();
	Add(b, b, e, count);
	PipeBarrier<PIPE_V>();
	Muls(e, p, 2.3988323966106506e-09f, count);
	PipeBarrier<PIPE_V>();
	Add(b, b, e, count);
	PipeBarrier<PIPE_V>();
	Adds(c, a, 1.5957691669464111f, count);
	PipeBarrier<PIPE_V>();

	Adds(d, c, -1.5957691669464111f, count);
	PipeBarrier<PIPE_V>();
	Sub(e, c, d, count);
	PipeBarrier<PIPE_V>();
	Sub(d, a, d, count);
	Duplicate(num, 1.5957691669464111f, count);
	PipeBarrier<PIPE_V>();
	Sub(e, num, e, count);
	PipeBarrier<PIPE_V>();
	Add(d, d, e, count);
	PipeBarrier<PIPE_V>();
	Add(d, d, b, count);
	PipeBarrier<PIPE_V>();
	Adds(d, d, -4.534068032135963e-08f, count);
	Abs(e, z, count);
	PipeBarrier<PIPE_V>();
	Mul(p, c, e, count);
	PipeBarrier<PIPE_V>();
	Muls(num, p, -1.0f, count);
	Adds(t, c, 0.0f, count);
	PipeBarrier<PIPE_V>();
	ProductError<Elements>(t, c, e, p, work, count);
	Mul(d, d, e, count);
	PipeBarrier<PIPE_V>();
	Add(t, t, d, count);
	PipeBarrier<PIPE_V>();
    }

    template <int Elements = 2048>
    __aicore__ inline void StableGelu(LocalTensor<float> z, LocalTensor<float> p,
				      LocalTensor<float> t, LocalTensor<float> num,
				      LocalTensor<float> work, uint32_t count)
    {
	auto a = work, b = work[Elements], c = work[2 * Elements];
	auto d = work[3 * Elements], e = work[4 * Elements];
	GeluArgument<Elements>(z, p, t, num, work, count);
	AccurateExpNeg<Elements>(p, t, num, work, count);
	Maxs(a, z, 0.0f, count);
	Mins(b, z, 0.0f, count);
	PipeBarrier<PIPE_V>();
	FusedMulAdd(b, p, a, count);
	PipeBarrier<PIPE_V>();

	Adds(d, p, 1.0f, count);
	PipeBarrier<PIPE_V>();
	Adds(e, d, -1.0f, count);
	PipeBarrier<PIPE_V>();
	Sub(e, p, e, count);
	PipeBarrier<PIPE_V>();
	Add(e, e, t, count);
	Muls(num, b, -1.0f, count);
	Mins(c, z, 0.0f, count);
	PipeBarrier<PIPE_V>();
	ProductError<Elements>(c, c, p, b, work, count);
	PipeBarrier<PIPE_V>();
	Add(c, c, a, count);
	Mins(num, z, 0.0f, count);
	PipeBarrier<PIPE_V>();
	Mul(num, num, t, count);
	PipeBarrier<PIPE_V>();
	Add(c, c, num, count);
	PipeBarrier<PIPE_V>();
	Div(z, b, d, count);
	PipeBarrier<PIPE_V>();
	Muls(num, z, -1.0f, count);
	PipeBarrier<PIPE_V>();
	ProductError<Elements>(num, z, d, b, work, count);
	Muls(num, num, -1.0f, count);
	PipeBarrier<PIPE_V>();
	Mul(e, z, e, count);
	PipeBarrier<PIPE_V>();
	Add(num, num, c, count);
	PipeBarrier<PIPE_V>();
	Sub(num, num, e, count);
	PipeBarrier<PIPE_V>();
	Div(num, num, d, count);
	PipeBarrier<PIPE_V>();
    }

    template <int Elements = 2048>
    __aicore__ inline void RoundHalf(LocalTensor<half> out, LocalTensor<float> hi,
				     LocalTensor<float> lo, LocalTensor<float> work, uint32_t count)
    {
	auto lower = work[3 * Elements].ReinterpretCast<half>();
	auto upper = work[4 * Elements].ReinterpretCast<half>();
	auto mid = work;
	auto upperFloat = work[Elements];
	auto mask = work[2 * Elements].ReinterpretCast<uint8_t>();
	Cast(lower, hi, RoundMode::CAST_FLOOR, count);
	Cast(upper, hi, RoundMode::CAST_CEIL, count);
	Cast(out, hi, RoundMode::CAST_RINT, count);
	PipeBarrier<PIPE_V>();
	Cast(mid, lower, RoundMode::CAST_NONE, count);
	Cast(upperFloat, upper, RoundMode::CAST_NONE, count);
	PipeBarrier<PIPE_V>();
	Add(mid, mid, upperFloat, count);
	PipeBarrier<PIPE_V>();
	Muls(mid, mid, 0.5f, count);
	PipeBarrier<PIPE_V>();
	Sub(mid, hi, mid, count);
	PipeBarrier<PIPE_V>();
	Add(mid, mid, lo, count);
	PipeBarrier<PIPE_V>();
	CompareScalar(mask, mid, 0.0f, CMPMODE::GT, count);
	PipeBarrier<PIPE_V>();
	Select(out, mask, upper, out, SELMODE::VSEL_TENSOR_TENSOR_MODE, count);
	PipeBarrier<PIPE_V>();
	CompareScalar(mask, mid, 0.0f, CMPMODE::LT, count);
	PipeBarrier<PIPE_V>();
	Select(out, mask, lower, out, SELMODE::VSEL_TENSOR_TENSOR_MODE, count);
	PipeBarrier<PIPE_V>();
    }

    template <int Elements = 2048>
    __aicore__ inline void
    EvaluateHalf(LocalTensor<half> out, LocalTensor<float> z, LocalTensor<float> p,
		 LocalTensor<float> t, LocalTensor<float> num, LocalTensor<float> work,
		 LocalTensor<int32_t> selectedIndices, uint32_t count, TPipe *pipe)
    {
	auto original = work[7 * Elements];
	Adds(original, z, 0.0f, count);
	PipeBarrier<PIPE_V>();
	Mul(p, z, z, count);
	PipeBarrier<PIPE_V>();
	Muls(p, p, .044715f, count);
	PipeBarrier<PIPE_V>();
	Adds(p, p, 1.0f, count);
	PipeBarrier<PIPE_V>();
	Mul(p, p, z, count);
	PipeBarrier<PIPE_V>();
	Muls(p, p, 1.5957691216057308f, count);
	PipeBarrier<PIPE_V>();
	Mins(num, z, 0.0f, count);
	Abs(t, p, count);
	PipeBarrier<PIPE_V>();
	Adds(work[8 * Elements], t, 0.0f, count);
	PipeBarrier<PIPE_V>();
	Muls(t, t, -1.0f, count);
	Maxs(p, z, 0.0f, count);
	PipeBarrier<PIPE_V>();
	Exp(t, t, count);
	PipeBarrier<PIPE_V>();
	Adds(work[9 * Elements], t, 0.0f, count);
	PipeBarrier<PIPE_V>();

	FusedMulAdd(num, t, p, count);
	Adds(t, t, 1.0f, count);
	PipeBarrier<PIPE_V>();
	Div(z, num, t, count);
	PipeBarrier<PIPE_V>();
	auto mask = work[5 * Elements].ReinterpretCast<uint8_t>();
	CompareScalar(mask, original, 8.0f, CMPMODE::GE, count);
	PipeBarrier<PIPE_V>();
	Select(z, mask, original, z, SELMODE::VSEL_TENSOR_TENSOR_MODE, count);
	Duplicate(p, 0.0f, count);
	PipeBarrier<PIPE_V>();
	CompareScalar(mask, original, -6.0f, CMPMODE::LE, count);
	PipeBarrier<PIPE_V>();
	Select(z, mask, p, z, SELMODE::VSEL_TENSOR_TENSOR_MODE, count);
	PipeBarrier<PIPE_V>();
	auto lower = work[3 * Elements].ReinterpretCast<half>();
	auto upper = work[4 * Elements].ReinterpretCast<half>();
	auto a = work, b = work[Elements], c = work[2 * Elements];
	auto one = work[6 * Elements];
	Cast(out, z, RoundMode::CAST_RINT, count);
	Cast(lower, z, RoundMode::CAST_FLOOR, count);
	Cast(upper, z, RoundMode::CAST_CEIL, count);
	PipeBarrier<PIPE_V>();
	Cast(b, lower, RoundMode::CAST_NONE, count);
	Cast(c, upper, RoundMode::CAST_NONE, count);
	PipeBarrier<PIPE_V>();
	Add(a, b, c, count);
	Sub(c, c, b, count);
	PipeBarrier<PIPE_V>();
	Muls(a, a, .5f, count);
	PipeBarrier<PIPE_V>();
	Sub(a, z, a, count);
	PipeBarrier<PIPE_V>();

	Muls(p, work[8 * Elements], 4.0e-7f, count);
	PipeBarrier<PIPE_V>();
	Adds(p, p, 1.0e-6f, count);
	Muls(t, work[8 * Elements], 4.0e-7f, count);
	PipeBarrier<PIPE_V>();
	Mul(t, t, work[9 * Elements], count);
	PipeBarrier<PIPE_V>();
	Adds(t, t, 4.0e-7f, count);
	PipeBarrier<PIPE_V>();
	CompareScalar(mask, original, 0.0f, CMPMODE::LT, count);
	PipeBarrier<PIPE_V>();
	Select(p, mask, p, t, SELMODE::VSEL_TENSOR_TENSOR_MODE, count);
	Abs(num, z, count);
	Abs(a, a, count);
	PipeBarrier<PIPE_V>();
	Mul(p, p, num, count);
	PipeBarrier<PIPE_V>();
	Adds(p, p, 1.0e-14f, count);
	PipeBarrier<PIPE_V>();
	Sub(a, a, p, count);
	Duplicate(one, 1.0f, count);
	PipeBarrier<PIPE_V>();

	Sub(p, num, c, count);
	PipeBarrier<PIPE_V>();
	Muls(p, p, 0.000998f, count);
	PipeBarrier<PIPE_V>();
	Mins(p, p, 0.000998f, count);
	PipeBarrier<PIPE_V>();
	Sub(p, p, c, count);
	PipeBarrier<PIPE_V>();
	Max(a, a, p, count);
	PipeBarrier<PIPE_V>();
	CompareScalar(mask, original, 8.0f, CMPMODE::GE, count);
	PipeBarrier<PIPE_V>();
	Select(a, mask, one, a, SELMODE::VSEL_TENSOR_TENSOR_MODE, count);
	PipeBarrier<PIPE_V>();
	CompareScalar(mask, original, -6.0f, CMPMODE::LE, count);
	PipeBarrier<PIPE_V>();
	Select(a, mask, one, a, SELMODE::VSEL_TENSOR_TENSOR_MODE, count);
	PipeBarrier<PIPE_V>();

	CompareScalar(mask, a, 0.0f, CMPMODE::LT, count);
	PipeBarrier<PIPE_V>();
	Duplicate(z, 0.0f, count);
	PipeBarrier<PIPE_V>();
	uint64_t selected = 0, indexCount = 0;
	GatherMask(z, original, mask.ReinterpretCast<uint32_t>(), true, count,
		   GatherMaskParams(1, 1, 8, 1), selected);
	PipeBarrier<PIPE_V>();
	if (selected == 0)
	    return;
	bool dense = selected > count / 4;
	if (dense)
	{
	    Adds(z, original, 0.0f, count);
	    PipeBarrier<PIPE_V>();
	}
	else
	{
	    auto index = work[6 * Elements].ReinterpretCast<int32_t>();
	    CreateVecIndex(index, int32_t(0), count);
	    PipeBarrier<PIPE_V>();
	    GatherMask(selectedIndices, index, mask.ReinterpretCast<uint32_t>(), true, count,
		       GatherMaskParams(1, 1, 8, 1), indexCount);
	    PipeBarrier<PIPE_V>();
	}
	uint32_t preciseCount = dense ? count : (selected + 63) / 64 * 64;
	StableGelu<Elements>(z, p, t, num, work, preciseCount);
	auto corrected = out;
	if (!dense)
	    corrected = work[5 * Elements].ReinterpretCast<half>();
	RoundHalf<Elements>(corrected, z, num, work, preciseCount);
	if (dense)
	    return;
	auto ready = pipe->FetchEventID<HardEvent::V_S>();
	SetFlag<HardEvent::V_S>(ready);
	WaitFlag<HardEvent::V_S>(ready);
	for (uint32_t i = 0; i < selected; ++i)
	    out.SetValue(selectedIndices.GetValue(i), corrected.GetValue(i));
	auto done = pipe->FetchEventID<HardEvent::S_MTE3>();
	SetFlag<HardEvent::S_MTE3>(done);
	WaitFlag<HardEvent::S_MTE3>(done);
	return;
    }

    __aicore__ inline float SingletonScalarGelu(float z)
    {
	if (z >= 8.0f || z == 0.0f)
	    return z;
	if (z <= -6.0f)
	    return -0.0f;
	const float magnitude = z < 0.0f ? -z : z;
        // |z|<=1/256: analytic omitted term <1.7e-11; 1e-8 also covers
        // FP32 evaluation error. Only accept when both bounds round to the same half.
        if(magnitude<=0.00390625f) {
            const float fast=0.5f*z+0.3989422804014327f*z*z;
            const half lower=static_cast<half>(fast-1.0e-8f);
            const half upper=static_cast<half>(fast+1.0e-8f);
            if(static_cast<float>(lower)==static_cast<float>(upper))return fast;
        }

	union FloatBits
	{
	    float f;
	    uint32_t bits;
	} value;
	if (magnitude <= 2.25f)
	{
	    const float t = z * (0.7978845608028654f + 0.03567740813636141f * z * z);
	    const float q = t * t;
	    const float denominator = 135135.0f + q * (62370.0f + q * (3150.0f + q * 28.0f));
	    const float poly = 135135.0f + q * (17325.0f + q * (378.0f + q));
	    const float gate = (t * poly + denominator) / denominator;
	    value.f = (0.5f * z) * gate;
	}
	else
	{
	    const float exponent = magnitude * (1.5957691216057308f + 0.0713548162727228f * z * z);
	    const int shift = int(exponent * 1.4426950408889634f + 0.5f);
	    const float r = (float(shift) * 0.693145751953125f - exponent) +
			    float(shift) * 0.0000014286068203094f;
	    const float poly = 1.0f + r * (1.0f + r * (0.5f + r * (0.1666666666666667f +
		r * (0.0416666666666667f + r * (0.0083333333333333f +
		r * (0.0013888888888889f + r * 0.0001984126984127f))))));
	    FloatBits power;
	    power.bits = uint32_t(127 - shift) << 23;
	    const float tail = poly * power.f;
	    value.f = (z < 0.0f ? z * tail : z) / (1.0f + tail);
	}
	const uint32_t absBits = value.bits & 0x7fffffffU;
	if (absBits >= 0x38800000U)
	{
	    if (((absBits + 80U) & 8191U) >= 4096U &&
		((absBits + 80U) & 8191U) <= 4256U)
		return ::GmmRefine(z);
	}
	else if (absBits >= 0x33000000U)
	{
	    const float units = (value.f < 0.0f ? -value.f : value.f) * 16777216.0f;
	    const float fraction = units - float(int(units));
	    if (fraction > 0.49f && fraction < 0.51f)
		return ::GmmRefine(z);
	}
	return value.f;
    }

    __aicore__ inline void SingletonUnitReduction(GM_ADDR x, GM_ADDR w, GM_ADDR s,
						   GM_ADDR groups, GM_ADDR y, int E)
    {
	const int expert = int(GetBlockIdx());
	LocalTensor<half> out(TPosition::VECCALC, 0, 16);
	LocalTensor<int8_t> bx(TPosition::VECCALC, 32, 32);
	LocalTensor<int8_t> bw(TPosition::VECCALC, 64, 32);
	LocalTensor<float> bs(TPosition::VECCALC, 96, 8);
	LocalTensor<int64_t> bg(TPosition::VECCALC, 128, 4);
	GlobalTensor<int8_t> gx, gw;
	GlobalTensor<float> gs;
	GlobalTensor<int64_t> gg;
	gx.SetGlobalBuffer((__gm__ int8_t *)x);
	gw.SetGlobalBuffer((__gm__ int8_t *)w);
	gs.SetGlobalBuffer((__gm__ float *)s);
	gg.SetGlobalBuffer((__gm__ int64_t *)groups);
	const int previous = expert > 0 ? expert - 1 : 0;
	DataCopyPad(bg, gg[previous], {1, uint32_t((expert ? 2 : 1) * 8), 0, 0, 0},
		    {false, 0, 0, int64_t(0)});
	DataCopyPad(bx, gx, {1, 1, 0, 0, 0}, {false, 0, 0, int8_t(0)});
	DataCopyPad(bw, gw[expert], {1, 1, 0, 0, 0}, {false, 0, 0, int8_t(0)});
	DataCopyPad(bs, gs[expert], {1, 4, 0, 0, 0}, {false, 0, 0, 0.0f});
	SetFlag<HardEvent::MTE2_S>(0);
	WaitFlag<HardEvent::MTE2_S>(0);
	if (bg.GetValue(0) != (expert ? 0 : 1) ||
	    (expert && bg.GetValue(1) == 0))
	    return;
	const int32_t dot = int32_t(bx.GetValue(0)) * int32_t(bw.GetValue(0));
	const float input = float(dot) * bs.GetValue(0);
	out.SetValue(0, static_cast<half>(SingletonScalarGelu(input)));
	SetFlag<HardEvent::S_MTE3>(0);
	WaitFlag<HardEvent::S_MTE3>(0);
	GlobalTensor<half> gy;
	gy.SetGlobalBuffer((__gm__ half *)y);
	DataCopyPad(gy, out, {1, 2, 0, 0, 0});
	SetFlag<HardEvent::MTE3_S>(0);
	WaitFlag<HardEvent::MTE3_S>(0);
    }

    __aicore__ __attribute__((always_inline)) inline void Singleton(GM_ADDR x, GM_ADDR weight,
								    GM_ADDR scale, GM_ADDR groups,
								    GM_ADDR y, int K, int E,
								    int capacity)
    {
	TPipe pipe;
	TBuf<TPosition::VECCALC> calc, xb, wb, hb, fb, gb, ib;
	TQue<TPosition::VECOUT, 1> oq;
	pipe.InitBuffer(calc, 19 * 64 * 4);
	pipe.InitBuffer(oq, 1, 256);
	pipe.InitBuffer(xb, capacity);
	pipe.InitBuffer(wb, capacity);
	pipe.InitBuffer(hb, capacity * 2);
	pipe.InitBuffer(fb, capacity * 4);
	pipe.InitBuffer(gb, capacity * 4);
	pipe.InitBuffer(ib, capacity * 4);
	auto all = calc.Get<float>();
	auto z = all, p = all[64], t = all[128], num = all[192];
	auto work = all[256], sc = all[18 * 64];
	auto bx = xb.Get<int8_t>(), bw = wb.Get<int8_t>();
	auto h = hb.Get<half>();
	auto fx = fb.Get<float>(), fw = gb.Get<float>();
	auto product = ib.Get<int32_t>();
	GlobalTensor<int8_t> gx, gw;
	GlobalTensor<float> gs;
	GlobalTensor<half> gy;
	gx.SetGlobalBuffer((__gm__ int8_t *)x);
	gw.SetGlobalBuffer((__gm__ int8_t *)weight);
	gs.SetGlobalBuffer((__gm__ float *)scale);
	gy.SetGlobalBuffer((__gm__ half *)y);
	int expert = 0;
	while (expert < E - 1 && ((__gm__ int64_t *)groups)[expert] == 0)
	    ++expert;
	DataCopyPad(bx, gx, {1, (uint32_t)K, 0, 0, 0}, {true, 0, 0, 0});
	DataCopyPad(bw, gw[(int64_t)expert * K], {1, (uint32_t)K, 0, 0, 0}, {true, 0, 0, 0});
	DataCopyPad(sc, gs[expert], {1, 4, 0, 0, 0}, {true, 0, 0, 0.0f});
	auto ready = pipe.FetchEventID<HardEvent::MTE2_V>();
	SetFlag<HardEvent::MTE2_V>(ready);
	WaitFlag<HardEvent::MTE2_V>(ready);
	Duplicate(product, int32_t(0), capacity);
	Cast(h, bx, RoundMode::CAST_NONE, K);
	PipeBarrier<PIPE_V>();
	Cast(fx, h, RoundMode::CAST_NONE, K);
	PipeBarrier<PIPE_V>();
	Cast(h, bw, RoundMode::CAST_NONE, K);
	PipeBarrier<PIPE_V>();
	Cast(fw, h, RoundMode::CAST_NONE, K);
	PipeBarrier<PIPE_V>();
	Mul(fx, fx, fw, K);
	PipeBarrier<PIPE_V>();
	Cast(product, fx, RoundMode::CAST_RINT, K);
	PipeBarrier<PIPE_V>();
	for (int width = capacity / 2; width >= 8; width /= 2)
	{
	    Add(product, product, product[width], width);
	    PipeBarrier<PIPE_V>();
	}
	auto scalarReady = pipe.FetchEventID<HardEvent::V_S>();
	SetFlag<HardEvent::V_S>(scalarReady);
	WaitFlag<HardEvent::V_S>(scalarReady);
	int32_t sum = 0;
	for (int i = 0; i < 8; ++i)
	    sum += product.GetValue(i);
	product.SetValue(0, sum);
	auto scalarDone = pipe.FetchEventID<HardEvent::S_V>();
	SetFlag<HardEvent::S_V>(scalarDone);
	WaitFlag<HardEvent::S_V>(scalarDone);
	Duplicate(z, 0.0f, 64);
	PipeBarrier<PIPE_V>();
	Cast(z, product, RoundMode::CAST_RINT, 1);
	PipeBarrier<PIPE_V>();
	Mul(z, z, sc, 1);
	PipeBarrier<PIPE_V>();
	auto out = oq.AllocTensor<half>();
	EvaluateHalf<64>(out, z, p, t, num, work, product, 64, &pipe);
	oq.EnQue(out);
	out = oq.DeQue<half>();
	DataCopyPad(gy, out, {1, 2, 0, 0, 0});
	oq.FreeTensor(out);
    }

    __aicore__ __attribute__((always_inline)) inline void
    Tiny(GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR groups, GM_ADDR y, int M, int K, int N, int E)
    {
	TPipe pipe;
	TBuf<TPosition::VECCALC> calc, integers, scales;
	TQue<TPosition::VECOUT, 1> oq;
	pipe.InitBuffer(calc, 18 * 64 * 4);
	pipe.InitBuffer(integers, 64 * 4);
	pipe.InitBuffer(scales, 64 * 4);
	pipe.InitBuffer(oq, 1, 256);
	auto all = calc.Get<float>();
	auto z = all, p = all[64], t = all[128], num = all[192], work = all[256];
	auto c = integers.Get<int32_t>();
	auto scale = scales.Get<float>();
	GlobalTensor<float> gs;
	GlobalTensor<half> gy;
	gs.SetGlobalBuffer((__gm__ float *)s);
	gy.SetGlobalBuffer((__gm__ half *)y);
	for (int row = GetBlockIdx(); row < M; row += GetBlockNum())
	{
	    int expert = 0;
	    while (expert + 1 < E && ((__gm__ int64_t *)groups)[expert] <= row)
		++expert;
	    for (int col = 0; col < N; ++col)
	    {
		int32_t sum = 0;
		if (col < N)
		{
		    for (int k = 0; k < K; ++k)
			sum += int32_t(((__gm__ int8_t *)x)[(int64_t)row * K + k]) *
			       int32_t(((__gm__ int8_t *)w)[((int64_t)expert * K + k) * N + col]);
		}
		c.SetValue(col, sum);
	    }
	    auto sv = pipe.FetchEventID<HardEvent::S_V>();
	    SetFlag<HardEvent::S_V>(sv);
	    WaitFlag<HardEvent::S_V>(sv);
	    DataCopyPad(scale, gs[(int64_t)expert * N], {1, (uint32_t)N * 4, 0, 0, 0},
			{true, 0, 0, 0.0f});
	    auto mv = pipe.FetchEventID<HardEvent::MTE2_V>();
	    SetFlag<HardEvent::MTE2_V>(mv);
	    WaitFlag<HardEvent::MTE2_V>(mv);
	    Duplicate(z, 0.0f, 64);
	    PipeBarrier<PIPE_V>();
	    Cast(z, c, RoundMode::CAST_RINT, N);
	    PipeBarrier<PIPE_V>();
	    Mul(z, z, scale, N);
	    PipeBarrier<PIPE_V>();
	    auto out = oq.AllocTensor<half>();
	    EvaluateHalf<64>(out, z, p, t, num, work, c, 64, &pipe);
	    oq.EnQue(out);
	    out = oq.DeQue<half>();
	    DataCopyPad(gy[(int64_t)row * N], out, {1, (uint32_t)N * 2, 0, 0, 0});
	    oq.FreeTensor(out);
	}
    }

    template <int KCAP>
    __aicore__ __attribute__((always_inline)) inline void TinyShort(GM_ADDR x, GM_ADDR w, GM_ADDR s,
								    GM_ADDR groups, GM_ADDR y,
								    int M, int K, int N, int E)
    {
	TPipe pipe;
	TBuf<TPosition::VECCALC> calc;
	pipe.InitBuffer(calc, 2 * 64 * sizeof(float));
	auto z = calc.Get<float>();
	auto p = z[64];
	GlobalTensor<half> gy;
	gy.SetGlobalBuffer((__gm__ half *)y);
	for (int row = GetBlockIdx(); row < M; row += GetBlockNum())
	{
	    if (row >= int(GetBlockNum()))
	    {
		auto consumed = pipe.FetchEventID<HardEvent::MTE3_V>();
		SetFlag<HardEvent::MTE3_V>(consumed);
		WaitFlag<HardEvent::MTE3_V>(consumed);
	    }
	    int expert = 0;
	    while (expert + 1 < E && ((__gm__ int64_t *)groups)[expert] <= row)
		++expert;
	    int32_t rowX[KCAP];
	    int32_t sums[32];
#pragma unroll
	    for (int k = 0; k < KCAP; ++k)
		rowX[k] = k < K ? int32_t(((__gm__ int8_t *)x)[int64_t(row) * K + k]) : 0;
	    for (int col = 0; col < N; ++col)
	    {
		int32_t sum = 0;
#pragma unroll
		for (int k = 0; k < KCAP; ++k)
		    if (k < K)
			sum += rowX[k] *
			       int32_t(((__gm__ int8_t *)w)[(int64_t(expert) * K + k) * N + col]);
		sums[col] = sum;
	    }
	    uint32_t risk = 0;
	    for (int col = 0; col < N; ++col)
	    {
		const float input =
		    float(sums[col]) * ((__gm__ float *)s)[int64_t(expert) * N + col];
		z.SetValue(col, input);

		const bool safe = input == 0.0f || input >= 8.0f || input <= -6.0f ||
				  (input >= 0.0002f && input <= 2.0f) ||
				  (input <= -0.0002f && input >= -4.0f);
		if (!safe)
		    risk |= 1U << col;
	    }
	    auto inputWritten = pipe.FetchEventID<HardEvent::S_V>();
	    SetFlag<HardEvent::S_V>(inputWritten);
	    WaitFlag<HardEvent::S_V>(inputWritten);
	    GeluTanh(z, p, p, p, N);
	    if (risk)
	    {
		auto ready = pipe.FetchEventID<HardEvent::V_S>();
		SetFlag<HardEvent::V_S>(ready);
		WaitFlag<HardEvent::V_S>(ready);
		bool corrected = false;
		for (int col = 0; col < N; ++col)
		{
		    if (!(risk & (1U << col)))
			continue;
		    union
		    {
			float f;
			uint32_t bits;
		    } value;
		    value.f = z.GetValue(col);
		    const uint32_t magnitude = value.bits & 0x7fffffffU;
		    bool refine =
			value.f >= 2.0f && value.f < 8.0f && ((value.bits + 4100U) & 8191U) < 8U;
		    if (magnitude && magnitude < 0x38800000U)
		    {
			value.bits = magnitude;
			const float units = value.f * 16777216.0f;
			const float fraction = units - float(int32_t(units));
			refine = fraction >= 0.48f && fraction <= 0.52f;
		    }
		    if (refine)
		    {
			z.SetValue(col,
				   ::GmmRefine(float(sums[col]) *
					       ((__gm__ float *)s)[int64_t(expert) * N + col]));
			corrected = true;
		    }
		}
		if (corrected)
		{
		    auto written = pipe.FetchEventID<HardEvent::S_V>();
		    SetFlag<HardEvent::S_V>(written);
		    WaitFlag<HardEvent::S_V>(written);
		}
	    }
	    auto out = p.ReinterpretCast<half>();
	    Cast(out, z, RoundMode::CAST_RINT, N);
	    auto written = pipe.FetchEventID<HardEvent::V_MTE3>();
	    SetFlag<HardEvent::V_MTE3>(written);
	    WaitFlag<HardEvent::V_MTE3>(written);
	    DataCopyPad(gy[int64_t(row) * N], out, {1, uint32_t(N * 2), 0, 0, 0});
	}
	PipeBarrier<PIPE_ALL>();
    }

    template <int KCAP, int NCAP>
    __aicore__ __attribute__((always_inline)) inline void TinyDot(GM_ADDR x, GM_ADDR w, int row,
								  int expert, int32_t *sums)
    {
	constexpr int K = KCAP;
	constexpr int N = NCAP;
	int32_t rowX[KCAP];
#pragma unroll
	for (int k = 0; k < KCAP; ++k)
	    rowX[k] = k < K ? int32_t(((__gm__ int8_t *)x)[int64_t(row) * K + k]) : 0;
#pragma unroll
	for (int col = 0; col < NCAP; ++col)
	{
	    if (col >= N)
		continue;
	    int32_t sum = 0;
#pragma unroll
	    for (int k = 0; k < KCAP; ++k)
		if (k < K)
		    sum += rowX[k] *
			   int32_t(((__gm__ int8_t *)w)[(int64_t(expert) * K + k) * N + col]);
	    sums[col] = sum;
	}
    }

    __aicore__ __attribute__((always_inline)) inline void TinyCompact(GM_ADDR x, GM_ADDR w,
								      GM_ADDR s, GM_ADDR groups,
								      GM_ADDR y, int M, int K,
								      int N, int E)
    {
	constexpr int NCAP = 8;
	TPipe pipe;
	TBuf<TPosition::VECCALC> calc;
	pipe.InitBuffer(calc, 2 * 64 * sizeof(float));
	auto z = calc.Get<float>();
	auto p = z[64];
	GlobalTensor<half> gy;
	gy.SetGlobalBuffer((__gm__ half *)y);
	for (int row = GetBlockIdx(); row < M; row += GetBlockNum())
	{
	    if (row >= int(GetBlockNum()))
	    {
		auto consumed = pipe.FetchEventID<HardEvent::MTE3_V>();
		SetFlag<HardEvent::MTE3_V>(consumed);
		WaitFlag<HardEvent::MTE3_V>(consumed);
	    }
	    int expert = 0;
	    while (expert + 1 < E && ((__gm__ int64_t *)groups)[expert] <= row)
		++expert;
	    int32_t sums[32];
	    switch (N)
	    {
	    case 1:
		switch (K)
		{
		case 1:
		    TinyDot<1, 1>(x, w, row, expert, sums);
		    break;
		case 2:
		    TinyDot<2, 1>(x, w, row, expert, sums);
		    break;
		case 3:
		    TinyDot<3, 1>(x, w, row, expert, sums);
		    break;
		case 4:
		    TinyDot<4, 1>(x, w, row, expert, sums);
		    break;
		}
		break;
	    case 2:
		switch (K)
		{
		case 1:
		    TinyDot<1, 2>(x, w, row, expert, sums);
		    break;
		case 2:
		    TinyDot<2, 2>(x, w, row, expert, sums);
		    break;
		case 3:
		    TinyDot<3, 2>(x, w, row, expert, sums);
		    break;
		case 4:
		    TinyDot<4, 2>(x, w, row, expert, sums);
		    break;
		}
		break;
	    case 3:
		switch (K)
		{
		case 1:
		    TinyDot<1, 3>(x, w, row, expert, sums);
		    break;
		case 2:
		    TinyDot<2, 3>(x, w, row, expert, sums);
		    break;
		case 3:
		    TinyDot<3, 3>(x, w, row, expert, sums);
		    break;
		case 4:
		    TinyDot<4, 3>(x, w, row, expert, sums);
		    break;
		}
		break;
	    case 4:
		switch (K)
		{
		case 1:
		    TinyDot<1, 4>(x, w, row, expert, sums);
		    break;
		case 2:
		    TinyDot<2, 4>(x, w, row, expert, sums);
		    break;
		case 3:
		    TinyDot<3, 4>(x, w, row, expert, sums);
		    break;
		case 4:
		    TinyDot<4, 4>(x, w, row, expert, sums);
		    break;
		}
		break;
	    case 5:
		switch (K)
		{
		case 1:
		    TinyDot<1, 5>(x, w, row, expert, sums);
		    break;
		case 2:
		    TinyDot<2, 5>(x, w, row, expert, sums);
		    break;
		case 3:
		    TinyDot<3, 5>(x, w, row, expert, sums);
		    break;
		case 4:
		    TinyDot<4, 5>(x, w, row, expert, sums);
		    break;
		}
		break;
	    case 6:
		switch (K)
		{
		case 1:
		    TinyDot<1, 6>(x, w, row, expert, sums);
		    break;
		case 2:
		    TinyDot<2, 6>(x, w, row, expert, sums);
		    break;
		case 3:
		    TinyDot<3, 6>(x, w, row, expert, sums);
		    break;
		case 4:
		    TinyDot<4, 6>(x, w, row, expert, sums);
		    break;
		}
		break;
	    case 7:
		switch (K)
		{
		case 1:
		    TinyDot<1, 7>(x, w, row, expert, sums);
		    break;
		case 2:
		    TinyDot<2, 7>(x, w, row, expert, sums);
		    break;
		case 3:
		    TinyDot<3, 7>(x, w, row, expert, sums);
		    break;
		case 4:
		    TinyDot<4, 7>(x, w, row, expert, sums);
		    break;
		}
		break;
	    case 8:
		switch (K)
		{
		case 1:
		    TinyDot<1, 8>(x, w, row, expert, sums);
		    break;
		case 2:
		    TinyDot<2, 8>(x, w, row, expert, sums);
		    break;
		case 3:
		    TinyDot<3, 8>(x, w, row, expert, sums);
		    break;
		case 4:
		    TinyDot<4, 8>(x, w, row, expert, sums);
		    break;
		}
		break;
	    }
	    uint32_t risk = 0;
#pragma unroll
	    for (int col = 0; col < NCAP; ++col)
	    {
		if (col >= N)
		    continue;
		const float input =
		    float(sums[col]) * ((__gm__ float *)s)[int64_t(expert) * N + col];
		z.SetValue(col, input);

		const bool safe = input == 0.0f || input >= 8.0f || input <= -6.0f ||
				  (input >= 0.0002f && input <= 2.0f) ||
				  (input <= -0.0002f && input >= -4.0f);
		if (!safe)
		    risk |= 1U << col;
	    }
	    auto inputWritten = pipe.FetchEventID<HardEvent::S_V>();
	    SetFlag<HardEvent::S_V>(inputWritten);
	    WaitFlag<HardEvent::S_V>(inputWritten);
	    GeluTanh(z, p, p, p, N);
	    if (risk)
	    {
		auto ready = pipe.FetchEventID<HardEvent::V_S>();
		SetFlag<HardEvent::V_S>(ready);
		WaitFlag<HardEvent::V_S>(ready);
		bool corrected = false;
#pragma unroll
		for (int col = 0; col < NCAP; ++col)
		{
		    if (col >= N)
			continue;
		    if (!(risk & (1U << col)))
			continue;
		    union
		    {
			float f;
			uint32_t bits;
		    } value;
		    value.f = z.GetValue(col);
		    const uint32_t magnitude = value.bits & 0x7fffffffU;
		    bool refine =
			value.f >= 2.0f && value.f < 8.0f && ((value.bits + 4100U) & 8191U) < 8U;
		    if (magnitude && magnitude < 0x38800000U)
		    {
			value.bits = magnitude;
			const float units = value.f * 16777216.0f;
			const float fraction = units - float(int32_t(units));
			refine = fraction >= 0.48f && fraction <= 0.52f;
		    }
		    if (refine)
		    {
			z.SetValue(col,
				   ::GmmRefine(float(sums[col]) *
					       ((__gm__ float *)s)[int64_t(expert) * N + col]));
			corrected = true;
		    }
		}
		if (corrected)
		{
		    auto written = pipe.FetchEventID<HardEvent::S_V>();
		    SetFlag<HardEvent::S_V>(written);
		    WaitFlag<HardEvent::S_V>(written);
		}
	    }
	    auto out = p.ReinterpretCast<half>();
	    Cast(out, z, RoundMode::CAST_RINT, N);
	    auto written = pipe.FetchEventID<HardEvent::V_MTE3>();
	    SetFlag<HardEvent::V_MTE3>(written);
	    WaitFlag<HardEvent::V_MTE3>(written);
	    DataCopyPad(gy[int64_t(row) * N], out, {1, uint32_t(N * 2), 0, 0, 0});
	}
	PipeBarrier<PIPE_ALL>();
    }

    __aicore__ constexpr MatmulConfig MakeBankConfig()
    {
	auto config = GetMDLConfig(false, false, 0, false, false, false, true);
	config.enableL1BankConflictOptimise = true;
	return config;
    }

constexpr MatmulConfig CFG = MakeBankConfig();

    __aicore__ inline void GeluTanh(LocalTensor<float> z, LocalTensor<float> p,
				    LocalTensor<float> u, LocalTensor<float> t, uint32_t count)
    {

	const BinaryRepeatParams binary{1, 1, 1, 8, 8, 8};
	const UnaryRepeatParams unary{1, 1, 8, 8};
	SetMaskCount();
	SetVectorMask<float, MaskMode::COUNTER>(0, count);
	Mul<float, false>(p, z, z, uint64_t(64), 1, binary);
	PipeBarrier<PIPE_V>();
	Muls<float, false>(u, p, -2.0f * GELU_C1, uint64_t(64), 1, unary);
	PipeBarrier<PIPE_V>();
	Adds<float, false>(p, u, -2.0f * GELU_C0, uint64_t(64), 1, unary);
	PipeBarrier<PIPE_V>();
	Mul<float, false>(u, z, p, uint64_t(64), 1, binary);
	PipeBarrier<PIPE_V>();
	Exp<float, false>(p, u, uint64_t(64), 1, unary);
	PipeBarrier<PIPE_V>();
	Adds<float, false>(p, p, 1.0f, uint64_t(64), 1, unary);
	PipeBarrier<PIPE_V>();
	Div<float, false>(z, z, p, uint64_t(64), 1, binary);
	PipeBarrier<PIPE_V>();
	SetMaskNorm();
	ResetMask();
    }

    __aicore__ __attribute__((always_inline)) inline void
    ComputeSdk(GM_ADDR x, GM_ADDR w, GM_ADDR sc, GM_ADDR groups, GM_ADDR y, GM_ADDR workspace, int M,
	    int K, int N, int E, AscendC::tiling::TCubeTiling tiling)
    {
	TPipe pipe;
	GlobalTensor<int8_t> gx, gw;
	GlobalTensor<float> gs;
	GlobalTensor<int32_t> gc;
	GlobalTensor<half> gy;
	gx.SetGlobalBuffer((__gm__ int8_t *)x);
	gw.SetGlobalBuffer((__gm__ int8_t *)w);
	gs.SetGlobalBuffer((__gm__ float *)sc);
	gy.SetGlobalBuffer((__gm__ half *)y);
	gc.SetGlobalBuffer((__gm__ int32_t *)workspace);

	const int tm = (int)tiling.baseM;
	const int tn = (int)tiling.baseN;

	const int capacity = tm * tn <= 16384 ? 8192 : 6144;
	const int vr = capacity / tn;
	const int ve = vr * tn;
	matmul::MatmulImpl<AT, BT, CT, BiasT, CFG> mm;
	if ASCEND_IS_AIC
	{
	    mm.SetSubBlockIdx(0);
	    mm.Init(&tiling, &pipe);
	    mm.SetOrgShape(M, N, K, K, tn);
	}

	TQue<TPosition::VECIN, 1> cq, sq;
	TQue<TPosition::VECOUT, 1> oq;
	TBuf<TPosition::VECCALC> zb, pb, groupCache;
	if ASCEND_IS_AIV
	{
	    pipe.InitBuffer(cq, 1, (uint32_t)(tm * tn) * sizeof(int32_t));
	    pipe.InitBuffer(sq, 1, (uint32_t)tn * sizeof(float) + (tm * tn > 16384 ? 256 : 0));
	    pipe.InitBuffer(oq, 1, (uint32_t)ve * sizeof(half));
	    pipe.InitBuffer(zb, (uint32_t)ve * sizeof(float));
	    pipe.InitBuffer(pb, (uint32_t)ve * sizeof(float) + 256);
	    if (E >= 32)
	    {
		pipe.InitBuffer(groupCache, (E * 8 + 31) / 32 * 32);
		GlobalTensor<int64_t> gg;
		gg.SetGlobalBuffer((__gm__ int64_t *)groups);
		DataCopyPad(groupCache.Get<int64_t>(), gg, {1, (uint32_t)(E * 8), 0, 0, 0},
			    {true, 0, 0, int64_t(0)});
		auto ready = pipe.FetchEventID<HardEvent::MTE2_S>();
		SetFlag<HardEvent::MTE2_S>(ready);
		WaitFlag<HardEvent::MTE2_S>(ready);
	    }
	}

	const int blockIdx = (int)GetBlockIdx();
	const int blockNum = (int)GetBlockNum();
	const int nc = (N + tn - 1) / tn;
	int64_t nextTask = blockIdx;
	int64_t local = 0;
	int begin = 0;
	for (int e = 0; e < E; ++e)
	{
	    int end = 0;
	    if ASCEND_IS_AIC
	    {
		end = (int)((__gm__ int64_t *)groups)[e];
	    }
	    if ASCEND_IS_AIV
	    {
		end = E >= 32 ? (int)groupCache.Get<int64_t>().GetValue(e)
			      : (int)((__gm__ int64_t *)groups)[e];
	    }
	    if (end < begin)
		end = begin;
	    if (end > M)
		end = M;
	    const int me = end - begin;
	    if (me > 0)
	    {
		const int mt = (me + tm - 1) / tm;
		const int64_t tasks = (int64_t)mt * nc;

		int64_t t = nextTask;
		for (; t < tasks; t += blockNum)
		{

		    const int mIdx = (int)(t % mt);
		    const int nIdx = (int)(t / mt);
		    const int row = begin + mIdx * tm;
		    const int col = nIdx * tn;
		    const int rows = (me - mIdx * tm < tm) ? (me - mIdx * tm) : tm;
		    const int cols = (N - col < tn) ? (N - col) : tn;

		    const int pitch = (cols + 31) / 32 * 32;
		    const int slot = (int)(local & 1);
		    const uint16_t tileFlag = slot ? FLAG_TILE1 : FLAG_TILE0;
		    const uint16_t freeFlag = slot ? FLAG_FREE1 : FLAG_FREE0;
		    auto gcSlot = gc[(int64_t)(blockIdx * SLOTS + slot) * tm * tn];

		    if ASCEND_IS_AIC
		    {
			if (local >= SLOTS)
			    CrossCoreWaitFlag<2, PIPE_MTE2>(freeFlag);
			mm.SetSingleShape(rows, cols, K);
			mm.SetTensorA(gx[(int64_t)row * K]);
			mm.SetTensorB(gw[(int64_t)e * K * N + col]);
			mm.IterateAll(gcSlot);
			CrossCoreSetFlag<2, PIPE_FIX>(tileFlag);
		    }
		    if ASCEND_IS_AIV
		    {
			CrossCoreWaitFlag<2, PIPE_MTE2>(tileFlag);
			auto c = cq.AllocTensor<int32_t>();
			auto scale = sq.AllocTensor<float>();

			if (pitch != (cols + 7) / 8 * 8)
			{
			    Duplicate(c, int32_t(0), rows * pitch);
			    auto event = pipe.FetchEventID<HardEvent::V_MTE2>();
			    SetFlag<HardEvent::V_MTE2>(event);
			    WaitFlag<HardEvent::V_MTE2>(event);
			}

			for (int r0 = 0; r0 < rows; r0 += 32)
			{
			    const int rc = (rows - r0 < 32) ? (rows - r0) : 32;
			    DataCopyPad(c[r0 * pitch], gcSlot[(int64_t)r0 * tn],
					{(uint16_t)rc, (uint32_t)(cols * sizeof(int32_t)),
					 (uint32_t)((tn - cols) * sizeof(int32_t)),
					 (uint32_t)((pitch * sizeof(int32_t) -
						     ((cols * sizeof(int32_t) + 31) / 32) * 32) /
						    32),
					 0},
					{true, 0, 0, 0});
			}
			DataCopyPad(scale, gs[(int64_t)e * N + col],
				    {1, (uint32_t)(cols * sizeof(float)), 0, 0, 0},
				    {true, 0, 0, 0.0f});
			cq.EnQue(c);
			sq.EnQue(scale);
			c = cq.DeQue<int32_t>();
			scale = sq.DeQue<float>();

			CrossCoreSetFlag<2, PIPE_MTE2>(freeFlag);

			auto z = zb.Get<float>();
			auto p = pb.Get<float>()[64];
			auto u = pb.Get<float>()[64];
			auto t = pb.Get<float>()[64];

			const BinaryRepeatParams bcast{
			    1, 1, 1, (uint8_t)(pitch / 8), (uint8_t)(pitch / 8), 0};
			for (int r = 0; r < rows; r += vr)
			{
			    const int batch = (rows - r < vr) ? (rows - r) : vr;
			    const uint32_t count = (uint32_t)batch * pitch;
			    Cast(z, c[r * pitch], RoundMode::CAST_NONE, count);
			    PipeBarrier<PIPE_V>();
			    if (cols < 64)
			    {
				Mul(z, z, scale, (uint64_t)64, (uint8_t)batch, bcast);
			    }
			    else
			    {
				for (int c0 = 0; c0 < cols; c0 += 64)
				{
				    const int chunk = (cols - c0 < 64) ? (cols - c0) : 64;
				    Mul(z[c0], z[c0], scale[c0], (uint64_t)chunk, (uint8_t)batch,
					bcast);
				}
			    }
			    PipeBarrier<PIPE_V>();

			    u = c[r * pitch].ReinterpretCast<float>();
			    GeluTanh(z, p, u, t, count);
			    auto out = oq.AllocTensor<half>();
			    Cast(out, z, RoundMode::CAST_RINT, count);
			    oq.EnQue(out);
			    out = oq.DeQue<half>();
			    const uint32_t outBytes = (uint32_t)cols * (uint32_t)sizeof(half);
			    const uint32_t outPitchBytes = (uint32_t)pitch * (uint32_t)sizeof(half);
			    const uint32_t outSrcStride =
				(outPitchBytes - ((outBytes + 31U) / 32U) * 32U) / 32U;
			    DataCopyPad(gy[(int64_t)(row + r) * N + col], out,
					{(uint16_t)batch, outBytes, outSrcStride,
					 (uint32_t)((N - cols) * sizeof(half)), 0});
			    oq.FreeTensor(out);
			}
			cq.FreeTensor(c);
			sq.FreeTensor(scale);
		    }
		    ++local;
		}
		nextTask = t - tasks;
	    }
	    begin = end;
	}
	if ASCEND_IS_AIC
	{

	    if (local > 0)
		CrossCoreWaitFlag<2, PIPE_MTE2>(FLAG_FREE0);
	    if (local > 1)
		CrossCoreWaitFlag<2, PIPE_MTE2>(FLAG_FREE1);
	    mm.End();
	}
    }

    template <int FixedM, int FixedN, int FixedK = 0>
    __aicore__ __attribute__((always_inline)) inline void
    ComputeDirectFixed(GM_ADDR x, GM_ADDR w, GM_ADDR sc, GM_ADDR groups, GM_ADDR y,
		       GM_ADDR workspace, int M, int runtimeK, int N, int E,
		       AscendC::tiling::TCubeTiling tiling)
    {
	const int K = FixedK ? FixedK : runtimeK;
	TPipe pipe;
	GlobalTensor<int8_t> gx, gw;
	GlobalTensor<float> gs;
	GlobalTensor<int32_t> gc;
	GlobalTensor<half> gy;
	gx.SetGlobalBuffer((__gm__ int8_t *)x);
	gw.SetGlobalBuffer((__gm__ int8_t *)w);
	gs.SetGlobalBuffer((__gm__ float *)sc);
	gy.SetGlobalBuffer((__gm__ half *)y);
	gc.SetGlobalBuffer((__gm__ int32_t *)workspace);

	const int tm = FixedM;
	const int tn = FixedN;

	const int capacity = ((tm + 1) / 2) * tn <= 16384 ? 8192 : 6144;
	const int vr = capacity / tn;
	const int ve = vr * tn;
	TBuf<TPosition::A1> a1b;
	TBuf<TPosition::B1> b1b;
	TBuf<TPosition::A2> a2b;
	TBuf<TPosition::B2> b2b;
	TBuf<TPosition::CO1> c0b;
	if ASCEND_IS_AIC
	{
	    pipe.InitBuffer(a1b, tm * 256);
	    pipe.InitBuffer(b1b, 256 * tn);
	    pipe.InitBuffer(a2b, tm * 256);
	    pipe.InitBuffer(b2b, 256 * tn);
	    pipe.InitBuffer(c0b, tm * tn * 4);
	}

	TQue<TPosition::VECIN, 1> cq, sq;
	TQue<TPosition::VECOUT, 1> oq;
	TBuf<TPosition::VECCALC> zb, pb, groupCache;
	if ASCEND_IS_AIV
	{
	    pipe.InitBuffer(cq, 1, (uint32_t)((tm + 1) / 2 * tn) * sizeof(int32_t));
	    pipe.InitBuffer(sq, 1, (uint32_t)tn * sizeof(float) + (tm * tn > 16384 ? 256 : 0));
	    pipe.InitBuffer(oq, 1, (uint32_t)ve * sizeof(half));
	    pipe.InitBuffer(zb, (uint32_t)ve * sizeof(float));
	    pipe.InitBuffer(pb, (uint32_t)ve * sizeof(float) + 256);
	    if (E >= 32)
	    {
		pipe.InitBuffer(groupCache, (E * 8 + 31) / 32 * 32);
		GlobalTensor<int64_t> gg;
		gg.SetGlobalBuffer((__gm__ int64_t *)groups);
		DataCopyPad(groupCache.Get<int64_t>(), gg, {1, (uint32_t)(E * 8), 0, 0, 0},
			    {true, 0, 0, int64_t(0)});
		auto ready = pipe.FetchEventID<HardEvent::MTE2_S>();
		SetFlag<HardEvent::MTE2_S>(ready);
		WaitFlag<HardEvent::MTE2_S>(ready);
	    }
	}

	int blockIdx = (int)GetBlockIdx();
	int lane = 0;
	if ASCEND_IS_AIV
	{
	    lane = blockIdx & 1;
	    blockIdx /= 2;
	}
	const int blockNum = (int)GetBlockNum();
	const int nc = (N + tn - 1) / tn;
	int64_t nextTask = blockIdx;
	int64_t local = 0;
	int begin = 0;
	for (int e = 0; e < E; ++e)
	{
	    int end = 0;
	    if ASCEND_IS_AIC
	    {
		end = (int)((__gm__ int64_t *)groups)[e];
	    }
	    if ASCEND_IS_AIV
	    {
		end = E >= 32 ? (int)groupCache.Get<int64_t>().GetValue(e)
			      : (int)((__gm__ int64_t *)groups)[e];
	    }
	    if (end < begin)
		end = begin;
	    if (end > M)
		end = M;
	    const int me = end - begin;
	    if (me > 0)
	    {
		const int mt = (me + tm - 1) / tm;
		const int64_t tasks = (int64_t)mt * nc;

		int64_t t = nextTask;
		for (; t < tasks; t += blockNum)
		{

		    const int mIdx = mt == 1 ? 0 : (int)(t % mt);
		    const int nIdx = mt == 1 ? (int)t : (int)(t / mt);
		    const int row = begin + mIdx * tm;
		    const int col = nIdx * tn;
		    const int rows = (me - mIdx * tm < tm) ? (me - mIdx * tm) : tm;
		    const int cols = (N - col < tn) ? (N - col) : tn;

		    const int pitch = (cols + 31) / 32 * 32;
		    const int slot = (int)(local & 1);
		    const uint16_t tileFlag = slot ? FLAG_TILE1 : FLAG_TILE0;
		    const uint16_t freeFlag = slot ? FLAG_FREE1 : FLAG_FREE0;
		    auto gcSlot = gc[(int64_t)(blockIdx * SLOTS + slot) * tm * tn];

		    if ASCEND_IS_AIC
		    {
			if (local >= SLOTS)
			    CrossCoreWaitFlag<2, PIPE_MTE2>(freeFlag);
			auto a1 = a1b.Get<int8_t>();
			auto b1 = b1b.Get<int8_t>();
			auto a2 = a2b.Get<int8_t>();
			auto b2 = b2b.Get<int8_t>();
			auto acc = c0b.Get<int32_t>();
			if (local)
			{
			    auto fm = pipe.FetchEventID<HardEvent::FIX_M>();
			    SetFlag<HardEvent::FIX_M>(fm);
			    WaitFlag<HardEvent::FIX_M>(fm);
			}
			for (int k0 = 0; k0 < K; k0 += 256)
			{
			    const int ck = K - k0 < 256 ? K - k0 : 256;
			    if (local || k0)
			    {
				auto release = pipe.FetchEventID<HardEvent::MTE1_MTE2>();
				SetFlag<HardEvent::MTE1_MTE2>(release);
				WaitFlag<HardEvent::MTE1_MTE2>(release);
			    }
			    Nd2NzParams ap;
			    ap.ndNum = 1;
			    ap.nValue = rows;
			    ap.dValue = ck;
			    ap.srcNdMatrixStride = 0;
			    ap.srcDValue = K;
			    ap.dstNzC0Stride = tm;
			    ap.dstNzNStride = 1;
			    ap.dstNzMatrixStride = 0;
			    Nd2NzParams bp;
			    bp.ndNum = 1;
			    bp.nValue = ck;
			    bp.dValue = cols;
			    bp.srcNdMatrixStride = 0;
			    bp.srcDValue = N;
			    bp.dstNzC0Stride = ck;
			    bp.dstNzNStride = 1;
			    bp.dstNzMatrixStride = 0;
			    DataCopy(a1, gx[(int64_t)row * K + k0], ap);
			    DataCopy(b1, gw[(int64_t)e * K * N + (int64_t)k0 * N + col], bp);
			    auto ready = pipe.FetchEventID<HardEvent::MTE2_MTE1>();
			    SetFlag<HardEvent::MTE2_MTE1>(ready);
			    WaitFlag<HardEvent::MTE2_MTE1>(ready);
			    if (local || k0)
			    {
				auto reuse = pipe.FetchEventID<HardEvent::M_MTE1>();
				SetFlag<HardEvent::M_MTE1>(reuse);
				WaitFlag<HardEvent::M_MTE1>(reuse);
			    }
			    LoadData2dParams la;
			    la.repeatTimes = ck / 32;
			    la.srcStride = tm / 16;
			    la.ifTranspose = false;
#pragma unroll
			    for (int mi = 0; mi < FixedM / 16; ++mi)
				if (mi < (rows + 15) / 16)
				    LoadData(a2[mi * ck * 16], a1[mi * 512], la);
			    LoadData2dTransposeParams lb{
				0, (uint8_t)(cols / 32), (uint16_t)(ck / 32), 1, 0, 0};
#pragma unroll
			    for (int ki = 0; ki < ck / 32; ++ki)
				LoadDataWithTranspose(b2[ki * cols * 32], b1[ki * 1024], lb);
			    auto loaded = pipe.FetchEventID<HardEvent::MTE1_M>();
			    SetFlag<HardEvent::MTE1_M>(loaded);
			    WaitFlag<HardEvent::MTE1_M>(loaded);
			    MmadParams mad;
			    mad.m = (rows + 15) / 16 * 16;
			    mad.n = cols;
			    mad.k = ck;
			    mad.cmatrixInitVal = k0 == 0;
			    Mmad(acc, a2, b2, mad);
			    if ((mad.m / 16) * (mad.n / 16) < 10)
				PipeBarrier<PIPE_M>();
			}
			auto completed = pipe.FetchEventID<HardEvent::M_FIX>();
			SetFlag<HardEvent::M_FIX>(completed);
			WaitFlag<HardEvent::M_FIX>(completed);
			FixpipeParamsV220 fix;
			fix.nSize = cols;
			fix.mSize = (rows + 15) / 16 * 16;
			fix.srcStride = (rows + 15) / 16 * 16;
			fix.dstStride = tn;
			Fixpipe<int32_t, int32_t, CFG_ROW_MAJOR>(gcSlot, acc, fix);
			CrossCoreSetFlag<2, PIPE_FIX>(tileFlag);
		    }
		    if ASCEND_IS_AIV
		    {
			CrossCoreWaitFlag<2, PIPE_MTE2>(tileFlag);
			const int halfRows = (rows + 1) / 2;
			const int rowOffset = lane * halfRows;
			const int vectorRows = lane ? rows - halfRows : halfRows;
			auto c = cq.AllocTensor<int32_t>();
			auto scale = sq.AllocTensor<float>();

			if (pitch != (cols + 7) / 8 * 8)
			{
			    Duplicate(c, int32_t(0), vectorRows * pitch);
			    auto event = pipe.FetchEventID<HardEvent::V_MTE2>();
			    SetFlag<HardEvent::V_MTE2>(event);
			    WaitFlag<HardEvent::V_MTE2>(event);
			}

			for (int r0 = 0; r0 < vectorRows; r0 += 32)
			{
			    const int rc = (vectorRows - r0 < 32) ? (vectorRows - r0) : 32;
			    DataCopyPad(c[r0 * pitch], gcSlot[(int64_t)(rowOffset + r0) * tn],
					{(uint16_t)rc, (uint32_t)(cols * sizeof(int32_t)),
					 (uint32_t)((tn - cols) * sizeof(int32_t)),
					 (uint32_t)((pitch * sizeof(int32_t) -
						     ((cols * sizeof(int32_t) + 31) / 32) * 32) /
						    32),
					 0},
					{true, 0, 0, 0});
			}
			DataCopyPad(scale, gs[(int64_t)e * N + col],
				    {1, (uint32_t)(cols * sizeof(float)), 0, 0, 0},
				    {true, 0, 0, 0.0f});
			cq.EnQue(c);
			sq.EnQue(scale);
			c = cq.DeQue<int32_t>();
			scale = sq.DeQue<float>();

			CrossCoreSetFlag<2, PIPE_MTE2>(freeFlag);

			auto z = zb.Get<float>();
			auto p = pb.Get<float>()[64];
			auto u = pb.Get<float>()[64];
			auto t = pb.Get<float>()[64];

			const BinaryRepeatParams bcast{
			    1, 1, 1, (uint8_t)(pitch / 8), (uint8_t)(pitch / 8), 0};
			for (int r = 0; r < vectorRows; r += vr)
			{
			    const int batch = (vectorRows - r < vr) ? (vectorRows - r) : vr;
			    const uint32_t count = (uint32_t)batch * pitch;
			    Cast(z, c[r * pitch], RoundMode::CAST_NONE, count);
			    PipeBarrier<PIPE_V>();
			    if (cols < 64)
			    {
				Mul(z, z, scale, (uint64_t)64, (uint8_t)batch, bcast);
			    }
			    else
			    {
				for (int c0 = 0; c0 < cols; c0 += 64)
				{
				    const int chunk = (cols - c0 < 64) ? (cols - c0) : 64;
				    Mul(z[c0], z[c0], scale[c0], (uint64_t)chunk, (uint8_t)batch,
					bcast);
				}
			    }
			    PipeBarrier<PIPE_V>();

			    u = c[r * pitch].ReinterpretCast<float>();
			    GeluTanh(z, p, u, t, count);
			    auto out = oq.AllocTensor<half>();
			    Cast(out, z, RoundMode::CAST_RINT, count);
			    oq.EnQue(out);
			    out = oq.DeQue<half>();
			    const uint32_t outBytes = (uint32_t)cols * (uint32_t)sizeof(half);
			    const uint32_t outPitchBytes = (uint32_t)pitch * (uint32_t)sizeof(half);
			    const uint32_t outSrcStride =
				(outPitchBytes - ((outBytes + 31U) / 32U) * 32U) / 32U;
			    DataCopyPad(gy[(int64_t)(row + rowOffset + r) * N + col], out,
					{(uint16_t)batch, outBytes, outSrcStride,
					 (uint32_t)((N - cols) * sizeof(half)), 0});
			    oq.FreeTensor(out);
			}
			cq.FreeTensor(c);
			sq.FreeTensor(scale);
		    }
		    ++local;
		}
		nextTask = t - tasks;
	    }
	    begin = end;
	}
	if ASCEND_IS_AIC
	{

	    if (local > 0)
		CrossCoreWaitFlag<2, PIPE_MTE2>(FLAG_FREE0);
	    if (local > 1)
		CrossCoreWaitFlag<2, PIPE_MTE2>(FLAG_FREE1);
	}
    }

    __aicore__ inline void DirectPrefetch512(GlobalTensor<int8_t> gx, GlobalTensor<int8_t> gw,
					     LocalTensor<int8_t> a1, LocalTensor<int8_t> b1,
					     bool reused, uint8_t freeId, uint8_t readyId, int row,
					     int col, int rows, int cols, int expert, int K, int N,
					     int panel)
    {
	if (reused)
	    WaitFlag<HardEvent::MTE1_MTE2>(freeId);
	Nd2NzParams ap;
	ap.ndNum = 1;
	ap.nValue = rows;
	ap.dValue = 512;
	ap.srcNdMatrixStride = 0;
	ap.srcDValue = K;
	ap.dstNzC0Stride = 128;
	ap.dstNzNStride = 1;
	ap.dstNzMatrixStride = 0;
	Nd2NzParams bp;
	bp.ndNum = 1;
	bp.nValue = 512;
	bp.dValue = cols;
	bp.srcNdMatrixStride = 0;
	bp.srcDValue = N;
	bp.dstNzC0Stride = 512;
	bp.dstNzNStride = 1;
	bp.dstNzMatrixStride = 0;
	DataCopy(a1, gx[int64_t(row) * K + panel * 512], ap);
	DataCopy(b1, gw[int64_t(expert) * K * N + int64_t(panel * 512) * N + col], bp);
	SetFlag<HardEvent::MTE2_MTE1>(readyId);
    }

    
    __aicore__ __attribute__((always_inline)) inline void
    ComputeDeepCapacity(GM_ADDR x, GM_ADDR w, GM_ADDR sc, GM_ADDR groups, GM_ADDR y,
			GM_ADDR workspace, int M, int runtimeK, int N, int E,
			AscendC::tiling::TCubeTiling tiling, uint32_t l1Half)
    {
	const int K = runtimeK;
	TPipe pipe;
	GlobalTensor<int8_t> gx, gw;
	GlobalTensor<float> gs;
	GlobalTensor<int32_t> gc;
	GlobalTensor<half> gy;
	gx.SetGlobalBuffer((__gm__ int8_t *)x);
	gw.SetGlobalBuffer((__gm__ int8_t *)w);
	gs.SetGlobalBuffer((__gm__ float *)sc);
	gy.SetGlobalBuffer((__gm__ half *)y);
	gc.SetGlobalBuffer((__gm__ int32_t *)workspace);

	const int tm = 128;
	const int tn = 256;

	const int capacity = 16384;
	const int vr = capacity / tn;
	const int ve = vr * tn;
	TBuf<TPosition::A1> a1Buffer[2], l1Gap;
	TBuf<TPosition::B1> b1Buffer[2];
	TBuf<TPosition::A2> a2Buffer;
	TBuf<TPosition::B2> b2Buffer;
	TBuf<TPosition::CO1> accBuffer;
	LocalTensor<int8_t> a1[2], b1[2], a2[4], b2[4];
	uint8_t l1Free[2], l1Ready[2], l0Free[4], l0Ready[4];
	uint8_t accumulatorFree = 0, matrixReady = 0;
	bool l1Used[2] = {false, false}, l0Used[4] = {};
	if ASCEND_IS_AIC
	{
	    pipe.InitBuffer(a1Buffer[0], tm * 512);
	    pipe.InitBuffer(b1Buffer[0], tn * 512);
	    const uint32_t packetBytes = (tm + tn) * 512;
	    if (l1Half > packetBytes)
		pipe.InitBuffer(l1Gap, l1Half - packetBytes);
	    pipe.InitBuffer(a1Buffer[1], tm * 512);
	    pipe.InitBuffer(b1Buffer[1], tn * 512);
#pragma unroll
	    for (int i = 0; i < 2; ++i)
	    {
		a1[i] = a1Buffer[i].Get<int8_t>();
		b1[i] = b1Buffer[i].Get<int8_t>();
		l1Free[i] = pipe.AllocEventID<HardEvent::MTE1_MTE2>();
		l1Ready[i] = pipe.AllocEventID<HardEvent::MTE2_MTE1>();
	    }
	    pipe.InitBuffer(a2Buffer, 4 * tm * 64);
	    pipe.InitBuffer(b2Buffer, 4 * tn * 64);
#pragma unroll
	    for (int i = 0; i < 4; ++i)
	    {
		a2[i] = a2Buffer.Get<int8_t>()[i * tm * 64];
		b2[i] = b2Buffer.Get<int8_t>()[i * tn * 64];
		l0Free[i] = pipe.AllocEventID<HardEvent::M_MTE1>();
		l0Ready[i] = pipe.AllocEventID<HardEvent::MTE1_M>();
	    }
	    pipe.InitBuffer(accBuffer, tm * tn * sizeof(int32_t));
	    accumulatorFree = pipe.AllocEventID<HardEvent::FIX_M>();
	    matrixReady = pipe.AllocEventID<HardEvent::M_FIX>();
	}

	TQue<TPosition::VECIN, 1> cq;
	TQue<TPosition::VECOUT, 1> oq;
	TBuf<TPosition::VECCALC> zb, pb, groupCache;
	if ASCEND_IS_AIV
	{
	    pipe.InitBuffer(cq, 1,
			    uint32_t(((tm + 1) / 2 * tn + tn) * sizeof(float)) +
				(tm * tn > 16384 ? 256 : 0));
	    pipe.InitBuffer(oq, 1, (uint32_t)ve * sizeof(half));
	    pipe.InitBuffer(zb, (uint32_t)ve * sizeof(float));
	    if (E > 0)
	    {
		pipe.InitBuffer(groupCache, (E * 8 + 31) / 32 * 32);
		GlobalTensor<int64_t> gg;
		gg.SetGlobalBuffer((__gm__ int64_t *)groups);
		DataCopyPad(groupCache.Get<int64_t>(), gg, {1, (uint32_t)(E * 8), 0, 0, 0},
			    {true, 0, 0, int64_t(0)});
		auto ready = pipe.FetchEventID<HardEvent::MTE2_S>();
		SetFlag<HardEvent::MTE2_S>(ready);
		WaitFlag<HardEvent::MTE2_S>(ready);
	    }
	}

	int blockIdx = (int)GetBlockIdx();
	int lane = 0;
	if ASCEND_IS_AIV
	{
	    lane = blockIdx & 1;
	    blockIdx /= 2;
	}
	const int blockNum = (int)GetBlockNum();
	const int nc = N / tn;
	int64_t nextTask = blockIdx;
	const int period = 2 * blockNum;
	int gap = period - 1 - 2 * blockIdx;
	int64_t local = 0;
	for (int bucket = tm + 32; bucket >= 16; bucket -= 32)
	{
	    int begin = 0;
	    for (int e = 0; e < E; ++e)
	    {
		int end = 0;
		if ASCEND_IS_AIC
		{
		    end = (int)((__gm__ int64_t *)groups)[e];
		}
		if ASCEND_IS_AIV
		{
		    end = E > 0 ? (int)groupCache.Get<int64_t>().GetValue(e)
				: (int)((__gm__ int64_t *)groups)[e];
		}
		if (end < begin)
		    end = begin;
		if (end > M)
		    end = M;
		const int me = end - begin;
		const bool fullPass = bucket > tm;
		const int fullTiles = me / tm;
		const int tailRows = me % tm;
		const bool selected = fullPass
					  ? fullTiles > 0
					  : tailRows > 0 && ((tailRows + 31) / 32 * 32 == bucket);
		if (selected)
		{
		    const int mt = fullPass ? fullTiles : 1;
		    const int firstM = fullPass ? 0 : fullTiles;
		    const int64_t tasks = (int64_t)mt * nc;

		    int64_t t = nextTask;
		    for (; t < tasks; t += gap, gap = period - gap)
		    {

			const int mIdx = firstM + (mt == 1 ? 0 : (int)(t % mt));
			const int nIdx = mt == 1 ? (int)t : (int)(t / mt);
			const int row = begin + mIdx * tm;
			const int col = nIdx * tn;
			const int rows = (me - mIdx * tm < tm) ? (me - mIdx * tm) : tm;
			const int cols = tn;

			const int pitch = (cols + 31) / 32 * 32;
			const int slot = (int)(local & 1);
			const uint16_t tileFlag = slot ? FLAG_TILE1 : FLAG_TILE0;
			const uint16_t freeFlag = slot ? FLAG_FREE1 : FLAG_FREE0;
			auto gcSlot = gc[(int64_t)(blockIdx * SLOTS + slot) * tm * tn];

			if ASCEND_IS_AIC
			{
			    const int panels = K / 512;
			    auto acc = accBuffer.Get<int32_t>();
#pragma unroll
			    for (int p = 0; p < 2; ++p)
			    {
				DirectPrefetch512(gx, gw, a1[p], b1[p], l1Used[p], l1Free[p],
						  l1Ready[p], row, col, rows, cols, e, K, N, p);
				l1Used[p] = true;
			    }
			    int fragment = 0;
			    for (int panel = 0; panel < panels; ++panel)
			    {
				const int slot1 = panel & 1;
				WaitFlag<HardEvent::MTE2_MTE1>(l1Ready[slot1]);
#pragma unroll
				for (int sub = 0; sub < 8; ++sub)
				{
				    const int slot0 = fragment & 3;
				    if (l0Used[slot0])
					WaitFlag<HardEvent::M_MTE1>(l0Free[slot0]);
				    LoadData2dParams la;
				    la.repeatTimes = (rows + 15) / 16;
				    la.srcStride = 1;
				    la.dstGap = 1;
				    la.ifTranspose = false;
#pragma unroll
				    for (int ki = 0; ki < 2; ++ki)
				    {
					LoadData(a2[slot0][ki * 512],
						 a1[slot1][(sub * 2 + ki) * tm * 32], la);
				    }
				    LoadData2dTransposeParams lb{
					0, uint8_t(cols / 32), uint16_t(512 / 32), 1, 0, 0};
#pragma unroll
				    for (int ki = 0; ki < 2; ++ki)
					LoadDataWithTranspose(b2[slot0][ki * cols * 32],
							      b1[slot1][(sub * 2 + ki) * 1024], lb);
				    SetFlag<HardEvent::MTE1_M>(l0Ready[slot0]);
				    WaitFlag<HardEvent::MTE1_M>(l0Ready[slot0]);
				    if (fragment == 0 && local > 0)
					WaitFlag<HardEvent::FIX_M>(accumulatorFree);
				    MmadParams mad;
				    mad.m = (rows + 15) / 16 * 16;
				    mad.n = cols;
				    mad.k = 64;
				    mad.cmatrixInitVal = fragment == 0;
				    Mmad(acc, a2[slot0], b2[slot0], mad);

				    if ((mad.m / 16) * (mad.n / 16) < 10)
					PipeBarrier<PIPE_M>();
				    SetFlag<HardEvent::M_MTE1>(l0Free[slot0]);
				    l0Used[slot0] = true;
				    ++fragment;
				}
				SetFlag<HardEvent::MTE1_MTE2>(l1Free[slot1]);
				if (panel + 2 < panels)
				{
				    DirectPrefetch512(gx, gw, a1[slot1], b1[slot1], true,
						      l1Free[slot1], l1Ready[slot1], row, col, rows,
						      cols, e, K, N, panel + 2);
				}
			    }
			    SetFlag<HardEvent::M_FIX>(matrixReady);
			    WaitFlag<HardEvent::M_FIX>(matrixReady);

			    if (local >= SLOTS)
				CrossCoreWaitFlag<2, PIPE_FIX>(freeFlag);
			    FixpipeParamsV220 fix;
			    fix.nSize = cols;
			    fix.mSize = (rows + 15) / 16 * 16;
			    fix.srcStride = (rows + 15) / 16 * 16;
			    fix.dstStride = tn;
			    Fixpipe<int32_t, int32_t, CFG_ROW_MAJOR>(gcSlot, acc, fix);
			    SetFlag<HardEvent::FIX_M>(accumulatorFree);
			    CrossCoreSetFlag<2, PIPE_FIX>(tileFlag);
			}
			if ASCEND_IS_AIV
			{
			    CrossCoreWaitFlag<2, PIPE_MTE2>(tileFlag);
			    const int halfRows = (rows + 1) / 2;
			    const int rowOffset = lane * halfRows;
			    const int vectorRows = lane ? rows - halfRows : halfRows;
			    auto c = cq.AllocTensor<int32_t>();
			    auto scale = c.ReinterpretCast<float>()[((tm + 1) / 2 * tn) +
								    (tm * tn > 16384 ? 64 : 0)];

			    if (pitch != (cols + 7) / 8 * 8)
			    {
				Duplicate(c, int32_t(0), vectorRows * pitch);
				auto event = pipe.FetchEventID<HardEvent::V_MTE2>();
				SetFlag<HardEvent::V_MTE2>(event);
				WaitFlag<HardEvent::V_MTE2>(event);
			    }

			    if (vectorRows > 0)
				DataCopyPad(
				    c, gcSlot[int64_t(rowOffset) * tn],
				    {1, uint32_t(vectorRows * tn * sizeof(int32_t)), 0, 0, 0},
				    {true, 0, 0, 0});
			    DataCopyPad(scale, gs[(int64_t)e * N + col],
					{1, (uint32_t)(cols * sizeof(float)), 0, 0, 0},
					{true, 0, 0, 0.0f});
			    cq.EnQue(c);
			    c = cq.DeQue<int32_t>();

			    CrossCoreSetFlag<2, PIPE_MTE2>(freeFlag);

			    auto z = zb.Get<float>();
			    auto p = c.ReinterpretCast<float>();
			    auto u = p;
			    auto t = p;

			    const BinaryRepeatParams bcast{
				1, 1, 1, (uint8_t)(pitch / 8), (uint8_t)(pitch / 8), 0};
			    for (int r = 0; r < vectorRows; r += vr)
			    {
				const int batch = (vectorRows - r < vr) ? (vectorRows - r) : vr;
				const uint32_t count = (uint32_t)batch * pitch;
				Cast(z, c[r * pitch], RoundMode::CAST_NONE, count);
				PipeBarrier<PIPE_V>();
				if (cols < 64)
				{
				    Mul(z, z, scale, (uint64_t)64, (uint8_t)batch, bcast);
				}
				else
				{
				    for (int c0 = 0; c0 < cols; c0 += 64)
				    {
					const int chunk = (cols - c0 < 64) ? (cols - c0) : 64;
					Mul(z[c0], z[c0], scale[c0], (uint64_t)chunk,
					    (uint8_t)batch, bcast);
				    }
				}
				PipeBarrier<PIPE_V>();

				p = c[r * pitch].ReinterpretCast<float>();
				u = p;
				GeluTanh(z, p, u, t, count);
				auto out = oq.AllocTensor<half>();
				Cast(out, z, RoundMode::CAST_RINT, count);
				oq.EnQue(out);
				out = oq.DeQue<half>();
				const uint32_t outBytes = (uint32_t)cols * (uint32_t)sizeof(half);
				const uint32_t outPitchBytes =
				    (uint32_t)pitch * (uint32_t)sizeof(half);
				const uint32_t outSrcStride =
				    (outPitchBytes - ((outBytes + 31U) / 32U) * 32U) / 32U;
				for (int r0 = 0; r0 < batch; r0 += 32)
				{
				    const int rc = batch - r0 < 32 ? batch - r0 : 32;
				    DataCopyPad(gy[(int64_t)(row + rowOffset + r + r0) * N + col],
						out[r0 * pitch],
						{(uint16_t)rc, outBytes, outSrcStride,
						 (uint32_t)((N - cols) * sizeof(half)), 0});
				}
				oq.FreeTensor(out);
			    }
			    cq.FreeTensor(c);
			}
			++local;
		    }
		    nextTask = t - tasks;
		}
		begin = end;
	    }
	}
	if ASCEND_IS_AIC
	{

	    if (local > 0)
		CrossCoreWaitFlag<2, PIPE_MTE2>(FLAG_FREE0);
	    if (local > 1)
		CrossCoreWaitFlag<2, PIPE_MTE2>(FLAG_FREE1);
	    if (local > 0)
		WaitFlag<HardEvent::FIX_M>(accumulatorFree);
#pragma unroll
	    for (int i = 0; i < 2; ++i)
	    {
		if (l1Used[i])
		    WaitFlag<HardEvent::MTE1_MTE2>(l1Free[i]);
		pipe.ReleaseEventID<HardEvent::MTE1_MTE2>(l1Free[i]);
		pipe.ReleaseEventID<HardEvent::MTE2_MTE1>(l1Ready[i]);
	    }
#pragma unroll
	    for (int i = 0; i < 4; ++i)
	    {
		if (l0Used[i])
		    WaitFlag<HardEvent::M_MTE1>(l0Free[i]);
		pipe.ReleaseEventID<HardEvent::M_MTE1>(l0Free[i]);
		pipe.ReleaseEventID<HardEvent::MTE1_M>(l0Ready[i]);
	    }
	    pipe.ReleaseEventID<HardEvent::FIX_M>(accumulatorFree);
	    pipe.ReleaseEventID<HardEvent::M_FIX>(matrixReady);
	}
    }

    __aicore__ inline void IntertilePrefetch512(GlobalTensor<int8_t> gx, GlobalTensor<int8_t> gw,
					     LocalTensor<int8_t> a1, LocalTensor<int8_t> b1,
					     bool reused, uint8_t freeId, uint8_t readyId, int row,
					     int col, int rows, int cols, int expert, int K, int N,
					     int panel, bool keepA = false, bool keepB = false)
    {
	if (reused)
	    WaitFlag<HardEvent::MTE1_MTE2>(freeId);
	Nd2NzParams ap;
	ap.ndNum = 1;
	ap.nValue = rows;
	ap.dValue = 512;
	ap.srcNdMatrixStride = 0;
	ap.srcDValue = K;
	ap.dstNzC0Stride = 128;
	ap.dstNzNStride = 1;
	ap.dstNzMatrixStride = 0;
	Nd2NzParams bp;
	bp.ndNum = 1;
	bp.nValue = 512;
	bp.dValue = cols;
	bp.srcNdMatrixStride = 0;
	bp.srcDValue = N;
	bp.dstNzC0Stride = 512;
	bp.dstNzNStride = 1;
	bp.dstNzMatrixStride = 0;
	if (N <= 65535 / 2)
	{
	    bp.ndNum = 2;
	    bp.nValue = 512 / 2;
	    bp.srcNdMatrixStride = N;
	    bp.srcDValue = 2 * N;
	    bp.dstNzNStride = 2;
	    bp.dstNzMatrixStride = 32;
	}
	if (!keepB)
	    DataCopy(b1, gw[int64_t(expert) * K * N + int64_t(panel * 512) * N + col], bp);
	if (!keepA)
	    DataCopy(a1, gx[int64_t(row) * K + panel * 512], ap);
	SetFlag<HardEvent::MTE2_MTE1>(readyId);
    }

    
    __aicore__ __attribute__((always_inline)) inline void
    ComputeIntertile_deep(GM_ADDR x, GM_ADDR w, GM_ADDR sc, GM_ADDR groups, GM_ADDR y,
			  GM_ADDR workspace, int M, int runtimeK, int N, int E,
			  AscendC::tiling::TCubeTiling tiling, uint32_t l1Half)
    {
	const int K = runtimeK;
	TPipe pipe;
	GlobalTensor<int8_t> gx, gw;
	GlobalTensor<float> gs;
	GlobalTensor<int32_t> gc;
	GlobalTensor<half> gy;
	gx.SetGlobalBuffer((__gm__ int8_t *)x);
	gw.SetGlobalBuffer((__gm__ int8_t *)w);
	gs.SetGlobalBuffer((__gm__ float *)sc);
	gy.SetGlobalBuffer((__gm__ half *)y);
	gc.SetGlobalBuffer((__gm__ int32_t *)workspace);

	const int tm = 128;
	const int tn = 256;

	const int capacity = 16384;
	const int vr = capacity / tn;
	const int ve = vr * tn;
	TBuf<TPosition::A1> a1Buffer[2], l1Gap;
	TBuf<TPosition::B1> b1Buffer[2];
	TBuf<TPosition::A2> a2Buffer;
	TBuf<TPosition::B2> b2Buffer;
	TBuf<TPosition::CO1> accBuffer;
	LocalTensor<int8_t> a1[2], b1[2], a2[4], b2[4];
	uint8_t l1Free[2], l1Ready[2], l0Free[4], l0Ready[4];
	uint8_t accumulatorFree = 0, matrixReady = 0;
	bool l1Used[2] = {false, false}, l0Used[4] = {};
	if ASCEND_IS_AIC
	{
	    pipe.InitBuffer(a1Buffer[0], tm * 512);
	    pipe.InitBuffer(b1Buffer[0], tn * 512);
	    const uint32_t packetBytes = (tm + tn) * 512;
	    if (l1Half > packetBytes)
		pipe.InitBuffer(l1Gap, l1Half - packetBytes);
	    pipe.InitBuffer(a1Buffer[1], tm * 512);
	    pipe.InitBuffer(b1Buffer[1], tn * 512);
#pragma unroll
	    for (int i = 0; i < 2; ++i)
	    {
		a1[i] = a1Buffer[i].Get<int8_t>();
		b1[i] = b1Buffer[i].Get<int8_t>();
		l1Free[i] = pipe.AllocEventID<HardEvent::MTE1_MTE2>();
		l1Ready[i] = pipe.AllocEventID<HardEvent::MTE2_MTE1>();
	    }
	    pipe.InitBuffer(a2Buffer, 4 * tm * 64);
	    pipe.InitBuffer(b2Buffer, 4 * tn * 64);
#pragma unroll
	    for (int i = 0; i < 4; ++i)
	    {
		a2[i] = a2Buffer.Get<int8_t>()[i * tm * 64];
		b2[i] = b2Buffer.Get<int8_t>()[i * tn * 64];
		l0Free[i] = pipe.AllocEventID<HardEvent::M_MTE1>();
		l0Ready[i] = pipe.AllocEventID<HardEvent::MTE1_M>();
	    }
	    pipe.InitBuffer(accBuffer, tm * tn * sizeof(int32_t));
	    accumulatorFree = pipe.AllocEventID<HardEvent::FIX_M>();
	    matrixReady = pipe.AllocEventID<HardEvent::M_FIX>();
	}

	TQue<TPosition::VECIN, 1> cq;
	TQue<TPosition::VECOUT, 1> oq;
	TBuf<TPosition::VECCALC> zb, pb, groupCache;
	if ASCEND_IS_AIV
	{
	    pipe.InitBuffer(cq, 1,
			    uint32_t(((tm + 1) / 2 * tn + tn) * sizeof(float)) +
				(tm * tn > 16384 ? 256 : 0));
	    pipe.InitBuffer(oq, 1, (uint32_t)ve * sizeof(half));
	    pipe.InitBuffer(zb, (uint32_t)ve * sizeof(float));
	    if (E > 0)
	    {
		pipe.InitBuffer(groupCache, (E * 8 + 31) / 32 * 32);
		GlobalTensor<int64_t> gg;
		gg.SetGlobalBuffer((__gm__ int64_t *)groups);
		DataCopyPad(groupCache.Get<int64_t>(), gg, {1, (uint32_t)(E * 8), 0, 0, 0},
			    {true, 0, 0, int64_t(0)});
		auto ready = pipe.FetchEventID<HardEvent::MTE2_S>();
		SetFlag<HardEvent::MTE2_S>(ready);
		WaitFlag<HardEvent::MTE2_S>(ready);
	    }
	}

	bool hasPending = false;
	uint64_t pendingInfo = 0;
	int64_t producerOrdinal = 0;
	const int startPhase = (2 * (int(GetBlockIdx()) & 1)) % (K / 512);
	int panelStart = startPhase;
	int blockIdx = (int)GetBlockIdx();
	int lane = 0;
	if ASCEND_IS_AIV
	{
	    lane = blockIdx & 1;
	    blockIdx /= 2;
	}
	const int blockNum = (int)GetBlockNum();
	const int nc = N / tn;
	int64_t totalCost = 0;
	int last = 0;
	for (int expert = 0; expert < E; ++expert)
	{
	    int end;
	    if ASCEND_IS_AIV
		end = (int)groupCache.Get<int64_t>().GetValue(expert);
	    else
		end = (int)((__gm__ int64_t *)groups)[expert];
	    end = end < last ? last : (end > M ? M : end);
	    const int rows = end - last;
	    totalCost += int64_t((rows + tm - 1) / tm * tn + 1 * rows) * nc;
	    last = end;
	}
	const int64_t firstCost = totalCost * blockIdx / blockNum;
	const int64_t endCost = totalCost * (blockIdx + 1) / blockNum;
	int64_t costBase = 0;
	int64_t local = 0;
	if (firstCost < endCost)
	{
	    int begin = 0;
	    for (int e = 0; e < E; ++e)
	    {
		int end = 0;
		if ASCEND_IS_AIC
		{
		    end = (int)((__gm__ int64_t *)groups)[e];
		}
		if ASCEND_IS_AIV
		{
		    end = E > 0 ? (int)groupCache.Get<int64_t>().GetValue(e)
				: (int)((__gm__ int64_t *)groups)[e];
		}
		if (end < begin)
		    end = begin;
		if (end > M)
		    end = M;
		const int me = end - begin;
		const int mt = (me + tm - 1) / tm;
		if (mt > 0)
		{
		    const int firstM = 0;
		    const int64_t tasks = int64_t(mt) * nc;
		    const int64_t colCost = int64_t(mt) * tn + 1 * me;
		    const int64_t groupCost = colCost * nc;
		    if (costBase + groupCost <= firstCost)
		    {
			costBase += groupCost;
			begin = end;
			continue;
		    }
		    if (costBase >= endCost)
			break;
		    // Locate the first possible tile using the regular full-row cost.
		    const int64_t relative = firstCost > costBase ? firstCost - costBase : 0;
		    const int64_t colStart = relative / colCost;
		    const int64_t rowStart = relative % colCost / (tn + 1 * tm);
		    for (int64_t t = colStart * mt + rowStart; t < tasks; ++t)
		    {
			const int rowTile = int(t % mt);
			const int validRows = me - rowTile * tm < tm ? me - rowTile * tm : tm;
			const int64_t middle = costBase + (t / mt) * colCost +
			    int64_t(rowTile) * (tn + 1 * tm) + (tn + 1 * validRows) / 2;
			if (middle < firstCost)
			    continue;
			if (middle >= endCost)
			    break;
			const int mIdx = firstM + int(t % mt);
			const int nIdx = int(t / mt);
			const int row = begin + mIdx * tm;
			const int col = nIdx * tn;
			const int rows = (me - mIdx * tm < tm) ? (me - mIdx * tm) : tm;
			const int cols = tn;

			const int pitch = (cols + 31) / 32 * 32;
			const int slot = (int)(local & 1);
			const uint16_t tileFlag = slot ? FLAG_TILE1 : FLAG_TILE0;
			const uint16_t freeFlag = slot ? FLAG_FREE1 : FLAG_FREE0;
			auto gcSlot = gc[(int64_t)(blockIdx * SLOTS + slot) * tm * tn];

			if ASCEND_IS_AIC
			{
			    const uint64_t futureInfo = uint64_t(row) | uint64_t(e) << 16 |
							uint64_t(rows) << 23 | uint64_t(col) << 31 |
							uint64_t(cols) << 43;
			    int nextPanelStart = startPhase;
			    if (hasPending)
			    {
				const int64_t productOrdinal = producerOrdinal;
				const int64_t local = productOrdinal;
				const int row = pendingInfo & 65535U;
				const int e = (pendingInfo >> 16) & 127U;
				const int rows = (pendingInfo >> 23) & 255U;
				const int col = (pendingInfo >> 31) & 4095U;
				const int cols = (pendingInfo >> 43) & 1023U;
				const int slot = int(local & 1);
				const uint16_t tileFlag = slot ? FLAG_TILE1 : FLAG_TILE0;
				const uint16_t freeFlag = slot ? FLAG_FREE1 : FLAG_FREE0;
				auto gcSlot = gc[int64_t(blockIdx * SLOTS + slot) * tm * tn];
				const int panels = K / 512;
				const bool keepA = (futureInfo & 65535U) == uint64_t(row) &&
						   ((futureInfo >> 23) & 255U) == uint64_t(rows);
				const bool keepB = ((futureInfo >> 16) & 127U) == uint64_t(e) &&
						   ((futureInfo >> 31) & 4095U) == uint64_t(col);
				if (keepA || keepB)
				    nextPanelStart = (panelStart + panels - 2) % panels;
				auto acc = accBuffer.Get<int32_t>();

				int fragment = 0;
				for (int panel = 0; panel < panels; ++panel)
				{
				    const int slot1 = (panel + int(local) * panels) & 1;
				    WaitFlag<HardEvent::MTE2_MTE1>(l1Ready[slot1]);
#pragma unroll
				    for (int sub = 0; sub < 8; ++sub)
				    {
					const int slot0 = fragment & 3;
					if (l0Used[slot0])
					    WaitFlag<HardEvent::M_MTE1>(l0Free[slot0]);
					LoadData2dParams la;
					la.repeatTimes = (rows + 15) / 16;
					la.srcStride = 1;
					la.dstGap = 1;
					la.ifTranspose = false;
					LoadData2dTransposeParams lb{
					    0, uint8_t(cols / 32), uint16_t(512 / 32), 1, 0, 0};
#pragma unroll
					for (int ki = 0; ki < 2; ++ki)
					{
					    LoadData(a2[slot0][ki * 512],
						     a1[slot1][(sub * 2 + ki) * tm * 32], la);
					    LoadDataWithTranspose(b2[slot0][ki * cols * 32],
								  b1[slot1][(sub * 2 + ki) * 1024],
								  lb);
					}
					SetFlag<HardEvent::MTE1_M>(l0Ready[slot0]);
					WaitFlag<HardEvent::MTE1_M>(l0Ready[slot0]);
					if (fragment == 0 && local > 0)
					    WaitFlag<HardEvent::FIX_M>(accumulatorFree);
					MmadParams mad;
					mad.m = (rows + 15) / 16 * 16;
					mad.n = cols;
					mad.k = 64;
					mad.cmatrixInitVal = fragment == 0;
					Mmad(acc, a2[slot0], b2[slot0], mad);

					if ((mad.m / 16) * (mad.n / 16) < 10)
					    PipeBarrier<PIPE_M>();
					SetFlag<HardEvent::M_MTE1>(l0Free[slot0]);
					l0Used[slot0] = true;
					++fragment;
				    }
				    SetFlag<HardEvent::MTE1_MTE2>(l1Free[slot1]);
				    if (panel + 2 < panels)
				    {
					IntertilePrefetch512(gx, gw, a1[slot1], b1[slot1], true,
							  l1Free[slot1], l1Ready[slot1], row, col,
							  rows, cols, e, K, N, (panelStart + panel + 2) % panels);
				    }
				    else
				    {
					IntertilePrefetch512(gx, gw, a1[slot1], b1[slot1], true,
							  l1Free[slot1], l1Ready[slot1],
							  int(futureInfo & 65535U),
							  int((futureInfo >> 31) & 4095U),
							  int((futureInfo >> 23) & 255U),
							  int((futureInfo >> 43) & 1023U),
							  int((futureInfo >> 16) & 127U), K, N,
							  (nextPanelStart + panel + 2 - panels) % panels, keepA, keepB);
				    }
				}
				SetFlag<HardEvent::M_FIX>(matrixReady);
				WaitFlag<HardEvent::M_FIX>(matrixReady);

				if (local >= SLOTS)
				    CrossCoreWaitFlag<2, PIPE_FIX>(freeFlag);
				FixpipeParamsV220 fix;
				fix.nSize = cols;
				fix.mSize = (rows + 15) / 16 * 16;
				fix.srcStride = (rows + 15) / 16 * 16;
				fix.dstStride = tn;
				Fixpipe<int32_t, int32_t, CFG_ROW_MAJOR>(gcSlot, acc, fix);
				SetFlag<HardEvent::FIX_M>(accumulatorFree);
				CrossCoreSetFlag<2, PIPE_FIX>(tileFlag);
			    }
			    else
			    {
#pragma unroll
				for (int p = 0; p < 2; ++p)
				{
				    IntertilePrefetch512(gx, gw, a1[p], b1[p], l1Used[p], l1Free[p],
						      l1Ready[p], row, col, rows, cols, e, K, N, (p + startPhase) % (K / 512));
				    l1Used[p] = true;
				}
			    }
			    panelStart = nextPanelStart;
			    pendingInfo = futureInfo;
			    producerOrdinal = local;
			    hasPending = true;
			}
			if ASCEND_IS_AIV
			{
			    CrossCoreWaitFlag<2, PIPE_MTE2>(tileFlag);
			    const int halfRows = (rows + 1) / 2;
			    const int rowOffset = lane * halfRows;
			    const int vectorRows = lane ? rows - halfRows : halfRows;
			    auto c = cq.AllocTensor<int32_t>();
			    auto scale = c.ReinterpretCast<float>()[((tm + 1) / 2 * tn) +
								    (tm * tn > 16384 ? 64 : 0)];

			    if (pitch != (cols + 7) / 8 * 8)
			    {
				Duplicate(c, int32_t(0), vectorRows * pitch);
				auto event = pipe.FetchEventID<HardEvent::V_MTE2>();
				SetFlag<HardEvent::V_MTE2>(event);
				WaitFlag<HardEvent::V_MTE2>(event);
			    }

			    if (vectorRows > 0)
				DataCopyPad(
				    c, gcSlot[int64_t(rowOffset) * tn],
				    {1, uint32_t(vectorRows * tn * sizeof(int32_t)), 0, 0, 0},
				    {true, 0, 0, 0});
			    DataCopyPad(scale, gs[(int64_t)e * N + col],
					{1, (uint32_t)(cols * sizeof(float)), 0, 0, 0},
					{true, 0, 0, 0.0f});
			    cq.EnQue(c);
			    c = cq.DeQue<int32_t>();

			    CrossCoreSetFlag<2, PIPE_MTE2>(freeFlag);

			    auto z = zb.Get<float>();
			    auto p = c.ReinterpretCast<float>();
			    auto u = p;
			    auto t = p;

			    const BinaryRepeatParams bcast{
				1, 1, 1, (uint8_t)(pitch / 8), (uint8_t)(pitch / 8), 0};
			    for (int r = 0; r < vectorRows; r += vr)
			    {
				const int batch = (vectorRows - r < vr) ? (vectorRows - r) : vr;
				const uint32_t count = (uint32_t)batch * pitch;
				Cast(z, c[r * pitch], RoundMode::CAST_NONE, count);
				PipeBarrier<PIPE_V>();
				if (cols < 64)
				{
				    Mul(z, z, scale, (uint64_t)64, (uint8_t)batch, bcast);
				}
				else
				{
				    for (int c0 = 0; c0 < cols; c0 += 64)
				    {
					const int chunk = (cols - c0 < 64) ? (cols - c0) : 64;
					Mul(z[c0], z[c0], scale[c0], (uint64_t)chunk,
					    (uint8_t)batch, bcast);
				    }
				}
				PipeBarrier<PIPE_V>();

				p = c[r * pitch].ReinterpretCast<float>();
				u = p;
				GeluTanh(z, p, u, t, count);
				auto out = oq.AllocTensor<half>();
				Cast(out, z, RoundMode::CAST_RINT, count);
				oq.EnQue(out);
				out = oq.DeQue<half>();
				const uint32_t outBytes = (uint32_t)cols * (uint32_t)sizeof(half);
				const uint32_t outPitchBytes =
				    (uint32_t)pitch * (uint32_t)sizeof(half);
				const uint32_t outSrcStride =
				    (outPitchBytes - ((outBytes + 31U) / 32U) * 32U) / 32U;
				for (int r0 = 0; r0 < batch; r0 += 32)
				{
				    const int rc = batch - r0 < 32 ? batch - r0 : 32;
				    DataCopyPad(gy[(int64_t)(row + rowOffset + r + r0) * N + col],
						out[r0 * pitch],
						{(uint16_t)rc, outBytes, outSrcStride,
						 (uint32_t)((N - cols) * sizeof(half)), 0});
				}
				oq.FreeTensor(out);
			    }
			    cq.FreeTensor(c);
			}
			++local;
		    }
		    costBase += groupCost;
		}
		begin = end;
	    }
	}
	if ASCEND_IS_AIC
	{
	    if (hasPending)
	    {
		const int64_t productOrdinal = producerOrdinal;
		const int64_t local = productOrdinal;
		const int row = pendingInfo & 65535U;
		const int e = (pendingInfo >> 16) & 127U;
		const int rows = (pendingInfo >> 23) & 255U;
		const int col = (pendingInfo >> 31) & 4095U;
		const int cols = (pendingInfo >> 43) & 1023U;
		const int slot = int(local & 1);
		const uint16_t tileFlag = slot ? FLAG_TILE1 : FLAG_TILE0;
		const uint16_t freeFlag = slot ? FLAG_FREE1 : FLAG_FREE0;
		auto gcSlot = gc[int64_t(blockIdx * SLOTS + slot) * tm * tn];
		const int panels = K / 512;
		auto acc = accBuffer.Get<int32_t>();

		int fragment = 0;
		for (int panel = 0; panel < panels; ++panel)
		{
		    const int slot1 = (panel + int(local) * panels) & 1;
		    WaitFlag<HardEvent::MTE2_MTE1>(l1Ready[slot1]);
#pragma unroll
		    for (int sub = 0; sub < 8; ++sub)
		    {
			const int slot0 = fragment & 3;
			if (l0Used[slot0])
			    WaitFlag<HardEvent::M_MTE1>(l0Free[slot0]);
			LoadData2dParams la;
			la.repeatTimes = (rows + 15) / 16;
			la.srcStride = 1;
			la.dstGap = 1;
			la.ifTranspose = false;
			LoadData2dTransposeParams lb{
			    0, uint8_t(cols / 32), uint16_t(512 / 32), 1, 0, 0};
#pragma unroll
			for (int ki = 0; ki < 2; ++ki)
			{
			    LoadData(a2[slot0][ki * 512], a1[slot1][(sub * 2 + ki) * tm * 32], la);
			    LoadDataWithTranspose(b2[slot0][ki * cols * 32],
						  b1[slot1][(sub * 2 + ki) * 1024], lb);
			}
			SetFlag<HardEvent::MTE1_M>(l0Ready[slot0]);
			WaitFlag<HardEvent::MTE1_M>(l0Ready[slot0]);
			if (fragment == 0 && local > 0)
			    WaitFlag<HardEvent::FIX_M>(accumulatorFree);
			MmadParams mad;
			mad.m = (rows + 15) / 16 * 16;
			mad.n = cols;
			mad.k = 64;
			mad.cmatrixInitVal = fragment == 0;
			Mmad(acc, a2[slot0], b2[slot0], mad);

			if ((mad.m / 16) * (mad.n / 16) < 10)
			    PipeBarrier<PIPE_M>();
			SetFlag<HardEvent::M_MTE1>(l0Free[slot0]);
			l0Used[slot0] = true;
			++fragment;
		    }
		    SetFlag<HardEvent::MTE1_MTE2>(l1Free[slot1]);
		    if (panel + 2 < panels)
		    {
			IntertilePrefetch512(gx, gw, a1[slot1], b1[slot1], true, l1Free[slot1],
					  l1Ready[slot1], row, col, rows, cols, e, K, N, (panelStart + panel + 2) % panels);
		    }
		}
		SetFlag<HardEvent::M_FIX>(matrixReady);
		WaitFlag<HardEvent::M_FIX>(matrixReady);

		if (local >= SLOTS)
		    CrossCoreWaitFlag<2, PIPE_FIX>(freeFlag);
		FixpipeParamsV220 fix;
		fix.nSize = cols;
		fix.mSize = (rows + 15) / 16 * 16;
		fix.srcStride = (rows + 15) / 16 * 16;
		fix.dstStride = tn;
		Fixpipe<int32_t, int32_t, CFG_ROW_MAJOR>(gcSlot, acc, fix);
		SetFlag<HardEvent::FIX_M>(accumulatorFree);
		CrossCoreSetFlag<2, PIPE_FIX>(tileFlag);
	    }

	    if (local > 0)
		CrossCoreWaitFlag<2, PIPE_MTE2>(FLAG_FREE0);
	    if (local > 1)
		CrossCoreWaitFlag<2, PIPE_MTE2>(FLAG_FREE1);
	    if (local > 0)
		WaitFlag<HardEvent::FIX_M>(accumulatorFree);
#pragma unroll
	    for (int i = 0; i < 2; ++i)
	    {
		if (l1Used[i])
		    WaitFlag<HardEvent::MTE1_MTE2>(l1Free[i]);
		pipe.ReleaseEventID<HardEvent::MTE1_MTE2>(l1Free[i]);
		pipe.ReleaseEventID<HardEvent::MTE2_MTE1>(l1Ready[i]);
	    }
#pragma unroll
	    for (int i = 0; i < 4; ++i)
	    {
		if (l0Used[i])
		    WaitFlag<HardEvent::M_MTE1>(l0Free[i]);
		pipe.ReleaseEventID<HardEvent::M_MTE1>(l0Free[i]);
		pipe.ReleaseEventID<HardEvent::MTE1_M>(l0Ready[i]);
	    }
	    pipe.ReleaseEventID<HardEvent::FIX_M>(accumulatorFree);
	    pipe.ReleaseEventID<HardEvent::M_FIX>(matrixReady);
	}
    }

    template <int K, int N>
    __aicore__ __attribute__((always_inline)) inline uint32_t
    TinyProduce(GM_ADDR x, GM_ADDR w, GM_ADDR s, LocalTensor<float> z, LocalTensor<float> p,
		int row, int expert)
    {
#pragma clang fp contract(off)
	int32_t rowX[K];
#pragma unroll
	for (int k = 0; k < K; ++k)
	    rowX[k] = k < K ? int32_t(((__gm__ int8_t *)x)[int64_t(row) * K + k]) : 0;
	uint32_t risk = 0;
#pragma unroll
	for (int col = 0; col < N; ++col)
	{
	    if (col >= N)
		continue;
	    int32_t sum = 0;
#pragma unroll
	    for (int k = 0; k < K; ++k)
		if (k < K)
		    sum += rowX[k] *
			   int32_t(((__gm__ int8_t *)w)[(int64_t(expert) * K + k) * N + col]);
	    const float input = float(sum) * ((__gm__ float *)s)[int64_t(expert) * N + col];
	    z.SetValue(col, input);
	    const float square = input * input;
	    const float cubicTerm = square * (-2.0f * GELU_C1);
	    const float factor = cubicTerm + (-2.0f * GELU_C0);
	    p.SetValue(col, input * factor);

	    const bool safe = input == 0.0f || input >= 8.0f || input <= -6.0f ||
			      (input >= 0.0002f && input <= 2.0f) ||
			      (input <= -0.0002f && input >= -4.0f);
	    if (!safe)
		risk |= 1U << col;
	}
	return risk;
    }

    __global__ __aicore__ __vector__ void TinyDispatch(GM_ADDR x, GM_ADDR w, GM_ADDR s,
						       GM_ADDR groups, GM_ADDR y, int M, int K,
						       int N, int E)
    {
#pragma clang fp contract(off)
	LocalTensor<float> z(TPosition::VECCALC, 0, 64);
	LocalTensor<float> p(TPosition::VECCALC, 256, 64);
	GlobalTensor<half> gy;
	gy.SetGlobalBuffer((__gm__ half *)y);
	for (int row = GetBlockIdx(); row < M; row += GetBlockNum())
	{
	    if (row >= int(GetBlockNum()))
	    {
		constexpr auto consumed = EVENT_ID0;
		SetFlag<HardEvent::MTE3_V>(consumed);
		WaitFlag<HardEvent::MTE3_V>(consumed);
	    }
	    int expert = 0;
	    while (expert + 1 < E && ((__gm__ int64_t *)groups)[expert] <= row)
		++expert;
	    uint32_t risk = 0;
	    switch (N)
	    {
	    case 1:
		switch (K)
		{
		case 1:
		    risk = TinyProduce<1, 1>(x, w, s, z, p, row, expert);
		    break;
		case 2:
		    risk = TinyProduce<2, 1>(x, w, s, z, p, row, expert);
		    break;
		case 3:
		    risk = TinyProduce<3, 1>(x, w, s, z, p, row, expert);
		    break;
		case 4:
		    risk = TinyProduce<4, 1>(x, w, s, z, p, row, expert);
		    break;
		}
		break;
	    case 2:
		switch (K)
		{
		case 1:
		    risk = TinyProduce<1, 2>(x, w, s, z, p, row, expert);
		    break;
		case 2:
		    risk = TinyProduce<2, 2>(x, w, s, z, p, row, expert);
		    break;
		case 3:
		    risk = TinyProduce<3, 2>(x, w, s, z, p, row, expert);
		    break;
		case 4:
		    risk = TinyProduce<4, 2>(x, w, s, z, p, row, expert);
		    break;
		}
		break;
	    case 3:
		switch (K)
		{
		case 1:
		    risk = TinyProduce<1, 3>(x, w, s, z, p, row, expert);
		    break;
		case 2:
		    risk = TinyProduce<2, 3>(x, w, s, z, p, row, expert);
		    break;
		case 3:
		    risk = TinyProduce<3, 3>(x, w, s, z, p, row, expert);
		    break;
		case 4:
		    risk = TinyProduce<4, 3>(x, w, s, z, p, row, expert);
		    break;
		}
		break;
	    case 4:
		switch (K)
		{
		case 1:
		    risk = TinyProduce<1, 4>(x, w, s, z, p, row, expert);
		    break;
		case 2:
		    risk = TinyProduce<2, 4>(x, w, s, z, p, row, expert);
		    break;
		case 3:
		    risk = TinyProduce<3, 4>(x, w, s, z, p, row, expert);
		    break;
		case 4:
		    risk = TinyProduce<4, 4>(x, w, s, z, p, row, expert);
		    break;
		}
		break;
	    case 5:
		switch (K)
		{
		case 1:
		    risk = TinyProduce<1, 5>(x, w, s, z, p, row, expert);
		    break;
		case 2:
		    risk = TinyProduce<2, 5>(x, w, s, z, p, row, expert);
		    break;
		case 3:
		    risk = TinyProduce<3, 5>(x, w, s, z, p, row, expert);
		    break;
		case 4:
		    risk = TinyProduce<4, 5>(x, w, s, z, p, row, expert);
		    break;
		}
		break;
	    case 6:
		switch (K)
		{
		case 1:
		    risk = TinyProduce<1, 6>(x, w, s, z, p, row, expert);
		    break;
		case 2:
		    risk = TinyProduce<2, 6>(x, w, s, z, p, row, expert);
		    break;
		case 3:
		    risk = TinyProduce<3, 6>(x, w, s, z, p, row, expert);
		    break;
		case 4:
		    risk = TinyProduce<4, 6>(x, w, s, z, p, row, expert);
		    break;
		}
		break;
	    case 7:
		switch (K)
		{
		case 1:
		    risk = TinyProduce<1, 7>(x, w, s, z, p, row, expert);
		    break;
		case 2:
		    risk = TinyProduce<2, 7>(x, w, s, z, p, row, expert);
		    break;
		case 3:
		    risk = TinyProduce<3, 7>(x, w, s, z, p, row, expert);
		    break;
		case 4:
		    risk = TinyProduce<4, 7>(x, w, s, z, p, row, expert);
		    break;
		}
		break;
	    case 8:
		switch (K)
		{
		case 1:
		    risk = TinyProduce<1, 8>(x, w, s, z, p, row, expert);
		    break;
		case 2:
		    risk = TinyProduce<2, 8>(x, w, s, z, p, row, expert);
		    break;
		case 3:
		    risk = TinyProduce<3, 8>(x, w, s, z, p, row, expert);
		    break;
		case 4:
		    risk = TinyProduce<4, 8>(x, w, s, z, p, row, expert);
		    break;
		}
		break;
	    }
	    constexpr auto inputWritten = EVENT_ID0;
	    SetFlag<HardEvent::S_V>(inputWritten);
	    WaitFlag<HardEvent::S_V>(inputWritten);
	    const UnaryRepeatParams unary{1, 1, 8, 8};
	    const BinaryRepeatParams binary{1, 1, 1, 8, 8, 8};
	    SetMaskCount();
	    SetVectorMask<float, MaskMode::COUNTER>(0, N);
	    Exp<float, false>(p, p, uint64_t(64), 1, unary);
	    PipeBarrier<PIPE_V>();
	    Adds<float, false>(p, p, 1.0f, uint64_t(64), 1, unary);
	    PipeBarrier<PIPE_V>();
	    Div<float, false>(z, z, p, uint64_t(64), 1, binary);
	    PipeBarrier<PIPE_V>();
	    SetMaskNorm();
	    ResetMask();
	    if (risk)
	    {
		constexpr auto ready = EVENT_ID0;
		SetFlag<HardEvent::V_S>(ready);
		WaitFlag<HardEvent::V_S>(ready);
		bool corrected = false;
#pragma clang loop unroll(disable)
		while (risk)
		{
		    const int col = 63 - int(CountLeadingZero(uint64_t(risk)));
		    risk &= ~(1U << col);
		    if (col >= N)
			continue;
		    union
		    {
			float f;
			uint32_t bits;
		    } value;
		    value.f = z.GetValue(col);
		    const uint32_t magnitude = value.bits & 0x7fffffffU;
		    bool refine =
			value.f >= 2.0f && value.f < 8.0f && ((value.bits + 4100U) & 8191U) < 8U;
		    if (magnitude && magnitude < 0x38800000U)
		    {
			value.bits = magnitude;
			const float units = value.f * 16777216.0f;
			const float fraction = units - float(int32_t(units));
			refine = fraction >= 0.48f && fraction <= 0.52f;
		    }
		    if (refine)
		    {
			int32_t preciseDot = 0;
#pragma unroll
			for (int k = 0; k < 4; ++k)
			    if (k < K)
				preciseDot +=
				    int32_t(((__gm__ int8_t *)x)[int64_t(row) * K + k]) *
				    int32_t(
					((__gm__ int8_t *)w)[(int64_t(expert) * K + k) * N + col]);
			z.SetValue(col,
				   ::GmmRefine(float(preciseDot) *
					       ((__gm__ float *)s)[int64_t(expert) * N + col]));
			corrected = true;
		    }
		}
		if (corrected)
		{
		    constexpr auto written = EVENT_ID0;
		    SetFlag<HardEvent::S_V>(written);
		    WaitFlag<HardEvent::S_V>(written);
		}
	    }
	    auto out = p.ReinterpretCast<half>();
	    Cast(out, z, RoundMode::CAST_RINT, N);
	    constexpr auto written = EVENT_ID0;
	    SetFlag<HardEvent::V_MTE3>(written);
	    WaitFlag<HardEvent::V_MTE3>(written);
	    DataCopyPad(gy[int64_t(row) * N], out, {1, uint32_t(N * 2), 0, 0, 0});
	}
	PipeBarrier<PIPE_ALL>();
    }

__global__ __aicore__ __vector__ void
UnitReduction(GM_ADDR x, GM_ADDR w, GM_ADDR sc, GM_ADDR groups, GM_ADDR y, int E)
{
    SingletonUnitReduction(x, w, sc, groups, y, E);
}

__global__ __aicore__ __vector__ void
SmallVector(GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR group_list, GM_ADDR y,
		       int M, int K, int N, int E, int capacity)
{
    if (M == 1 && N == 1)
    {
	Singleton(x, weight, scale, group_list, y, K, E, capacity);
	return;
    }
    if (K <= 4 && N <= 8)
    {
	TinyCompact(x, weight, scale, group_list, y, M, K, N, E);
	return;
    }

    if (K <= 4)
	TinyShort<4>(x, weight, scale, group_list, y, M, K, N, E);
    else
	Tiny(x, weight, scale, group_list, y, M, K, N, E);
    return;
}

    template <int TileM, int PacketK>
    __aicore__ inline void DeepTailPrefetchUnified(GlobalTensor<int8_t> gx, GlobalTensor<int8_t> gw,
						   LocalTensor<int8_t> a1, LocalTensor<int8_t> b1,
						   bool reused, uint8_t freeId, uint8_t readyId,
						   int row, int col, int rows, int cols, int expert,
						   int K, int N, int panel)
    {
	if (reused)
	    WaitFlag<HardEvent::MTE1_MTE2>(freeId);
	const int ck = K - panel * PacketK < PacketK ? K - panel * PacketK : PacketK;
	const int paddedK = (ck + 63) / 64 * 64;
	const int paddedN = (cols + 31) / 32 * 32;
	if (ck % 64)
	{
	    Fill(a1[(ck / 32) * TileM * 32].ReinterpretCast<uint32_t>(),
		 InitConstValueParams<uint32_t>(1, TileM * (paddedK - ck / 32 * 32) / 32, 0, 0));
	    Fill(b1[ck * 32].ReinterpretCast<uint32_t>(),
		 InitConstValueParams<uint32_t>(paddedN / 32, paddedK - ck,
						PacketK - (paddedK - ck), 0));
	    PipeBarrier<PIPE_MTE2>();
	}
	Nd2NzParams ap;
	ap.ndNum = 1;
	ap.nValue = rows;
	ap.dValue = ck;
	ap.srcNdMatrixStride = 0;
	ap.srcDValue = K;
	ap.dstNzC0Stride = TileM;
	ap.dstNzNStride = 1;
	ap.dstNzMatrixStride = 0;
	Nd2NzParams bp;
	bp.ndNum = 1;
	bp.nValue = ck;
	bp.dValue = cols;
	bp.srcNdMatrixStride = 0;
	bp.srcDValue = N;
	bp.dstNzC0Stride = PacketK;
	bp.dstNzNStride = 1;
	bp.dstNzMatrixStride = 0;
	if (K >= 4096 && ck % 2 == 0 && N <= 65535 / 2)
	{
	    bp.ndNum = 2;
	    bp.nValue = ck / 2;
	    bp.srcNdMatrixStride = N;
	    bp.srcDValue = 2 * N;
	    bp.dstNzNStride = 2;
	    bp.dstNzMatrixStride = 32;
	}
	if (K >= 4096)
	{
	    DataCopy(b1, gw[int64_t(expert) * K * N + int64_t(panel * PacketK) * N + col], bp);
	    DataCopy(a1, gx[int64_t(row) * K + panel * PacketK], ap);
	}
	else
	{
	    DataCopy(a1, gx[int64_t(row) * K + panel * PacketK], ap);
	    DataCopy(b1, gw[int64_t(expert) * K * N + int64_t(panel * PacketK) * N + col], bp);
	}
	SetFlag<HardEvent::MTE2_MTE1>(readyId);
    }

    template <int TileM, int TileN, int PacketK, int L0Slots = 4>
    __aicore__ __attribute__((always_inline)) inline void
    ComputeDeepTailUnified(GM_ADDR x, GM_ADDR w, GM_ADDR sc, GM_ADDR groups, GM_ADDR y,
			   GM_ADDR workspace, int M, int K, int N, int E,
			   AscendC::tiling::TCubeTiling tiling, uint32_t l1Half)
    {
	TPipe pipe;
	GlobalTensor<int8_t> gx, gw;
	GlobalTensor<float> gs;
	GlobalTensor<int32_t> gc;
	GlobalTensor<half> gy;
	gx.SetGlobalBuffer((__gm__ int8_t *)x);
	gw.SetGlobalBuffer((__gm__ int8_t *)w);
	gs.SetGlobalBuffer((__gm__ float *)sc);
	gy.SetGlobalBuffer((__gm__ half *)y);
	gc.SetGlobalBuffer((__gm__ int32_t *)workspace);

	const int tm = TileM;
	const int tn = TileN;

	const int capacity = 8192;
	const int vr = capacity / tn;
	const int ve = vr * tn;
	TBuf<TPosition::A1> a1Buffer[2], l1Gap;
	TBuf<TPosition::B1> b1Buffer[2];
	TBuf<TPosition::A2> a2Buffer;
	TBuf<TPosition::B2> b2Buffer;
	TBuf<TPosition::CO1> accBuffer;
	LocalTensor<int8_t> a1[2], b1[2], a2[L0Slots], b2[L0Slots];
	uint8_t l1Free[2], l1Ready[2], l0Free[L0Slots], l0Ready[L0Slots];
	uint8_t accumulatorFree = 0, matrixReady = 0;
	bool l1Used[2] = {false, false}, l0Used[L0Slots] = {};
	if ASCEND_IS_AIC
	{
	    pipe.InitBuffer(a1Buffer[0], tm * PacketK);
	    pipe.InitBuffer(b1Buffer[0], tn * PacketK);
	    const uint32_t packetBytes = (tm + tn) * PacketK;
	    if (l1Half > packetBytes)
		pipe.InitBuffer(l1Gap, l1Half - packetBytes);
	    pipe.InitBuffer(a1Buffer[1], tm * PacketK);
	    pipe.InitBuffer(b1Buffer[1], tn * PacketK);
#pragma unroll
	    for (int i = 0; i < 2; ++i)
	    {
		a1[i] = a1Buffer[i].Get<int8_t>();
		b1[i] = b1Buffer[i].Get<int8_t>();
		l1Free[i] = pipe.AllocEventID<HardEvent::MTE1_MTE2>();
		l1Ready[i] = pipe.AllocEventID<HardEvent::MTE2_MTE1>();
	    }
	    pipe.InitBuffer(a2Buffer, L0Slots * tm * 64);
	    pipe.InitBuffer(b2Buffer, L0Slots * tn * 64);
#pragma unroll
	    for (int i = 0; i < L0Slots; ++i)
	    {
		a2[i] = a2Buffer.Get<int8_t>()[i * tm * 64];
		b2[i] = b2Buffer.Get<int8_t>()[i * tn * 64];
		l0Free[i] = pipe.AllocEventID<HardEvent::M_MTE1>();
		l0Ready[i] = pipe.AllocEventID<HardEvent::MTE1_M>();
	    }
	    pipe.InitBuffer(accBuffer, tm * tn * sizeof(int32_t));
	    accumulatorFree = pipe.AllocEventID<HardEvent::FIX_M>();
	    matrixReady = pipe.AllocEventID<HardEvent::M_FIX>();
	}

	TQue<TPosition::VECIN, 1> cq;
	TQue<TPosition::VECOUT, 1> oq;
	TBuf<TPosition::VECCALC> zb, pb, groupCache;
	if ASCEND_IS_AIV
	{
	    pipe.InitBuffer(cq, 1,
			    uint32_t(((tm + 1) / 2 * tn + tn) * sizeof(float)) +
				(tm * tn > 16384 ? 256 : 0));
	    pipe.InitBuffer(oq, 1, (uint32_t)ve * sizeof(half));
	    pipe.InitBuffer(zb, (uint32_t)ve * sizeof(float));
	    if (E > 0)
	    {
		pipe.InitBuffer(groupCache, (E * 8 + 31) / 32 * 32);
		GlobalTensor<int64_t> gg;
		gg.SetGlobalBuffer((__gm__ int64_t *)groups);
		DataCopyPad(groupCache.Get<int64_t>(), gg, {1, (uint32_t)(E * 8), 0, 0, 0},
			    {true, 0, 0, int64_t(0)});
		auto ready = pipe.FetchEventID<HardEvent::MTE2_S>();
		SetFlag<HardEvent::MTE2_S>(ready);
		WaitFlag<HardEvent::MTE2_S>(ready);
	    }
	}

	int blockIdx = (int)GetBlockIdx();
	int lane = 0;
	if ASCEND_IS_AIV
	{
	    lane = blockIdx & 1;
	    blockIdx /= 2;
	}
	const int blockNum = (int)GetBlockNum();
	const int nc = (N + tn - 1) / tn;
	int64_t nextTask = blockIdx;
	const int period = 2 * blockNum;
	int gap = period - 1 - 2 * blockIdx;
	int64_t local = 0;
	for (int bucket = ((tm + 31) / 32 + 1) * 32; bucket >= 16; bucket -= 32)
	{
	    int begin = 0;
	    for (int e = 0; e < E; ++e)
	    {
		int end = 0;
		if ASCEND_IS_AIC
		{
		    end = (int)((__gm__ int64_t *)groups)[e];
		}
		if ASCEND_IS_AIV
		{
		    end = E > 0 ? (int)groupCache.Get<int64_t>().GetValue(e)
				: (int)((__gm__ int64_t *)groups)[e];
		}
		if (end < begin)
		    end = begin;
		if (end > M)
		    end = M;
		const int me = end - begin;
		const bool fullPass = bucket == ((tm + 31) / 32 + 1) * 32;
		const int fullTiles = me / tm;
		const int tailRows = me % tm;
		const bool selected = fullPass
					  ? fullTiles > 0
					  : tailRows > 0 && ((tailRows + 31) / 32 * 32 == bucket);
		if (selected)
		{
		    const int mt = fullPass ? fullTiles : 1;
		    const int firstM = fullPass ? 0 : fullTiles;
		    const int64_t tasks = (int64_t)mt * nc;

		    int64_t t = nextTask;
		    for (; t < tasks; t += gap, gap = period - gap)
		    {

			const int mIdx = firstM + (mt == 1 ? 0 : (int)(t % mt));
			const int nIdx = mt == 1 ? (int)t : (int)(t / mt);
			const int row = begin + mIdx * tm;
			const int col = nIdx * tn;
			const int rows = (me - mIdx * tm < tm) ? (me - mIdx * tm) : tm;
			const int cols = N - col < tn ? N - col : tn;

			const int pitch = (cols + 31) / 32 * 32;
			const int slot = (int)(local & 1);
			const uint16_t tileFlag = slot ? FLAG_TILE1 : FLAG_TILE0;
			const uint16_t freeFlag = slot ? FLAG_FREE1 : FLAG_FREE0;
			auto gcSlot = gc[(int64_t)(blockIdx * SLOTS + slot) * tm * tn];

			if ASCEND_IS_AIC
			{
			    const int panels = (K + PacketK - 1) / PacketK;
			    auto acc = accBuffer.Get<int32_t>();
#pragma unroll
			    for (int p = 0; p < 2; ++p)
			    {
				DeepTailPrefetchUnified<TileM, PacketK>(
				    gx, gw, a1[p], b1[p], l1Used[p], l1Free[p], l1Ready[p], row,
				    col, rows, cols, e, K, N, p);
				l1Used[p] = true;
			    }
			    int fragment = 0;
			    for (int panel = 0; panel < panels; ++panel)
			    {
				const int slot1 = panel & 1;
				WaitFlag<HardEvent::MTE2_MTE1>(l1Ready[slot1]);
#pragma unroll
				for (int sub = 0; sub < PacketK / 64; ++sub)
				{
				    if (panel * PacketK + sub * 64 >= K)
					break;
				    const int slot0 = fragment & (L0Slots - 1);
				    if (l0Used[slot0])
					WaitFlag<HardEvent::M_MTE1>(l0Free[slot0]);
				    LoadData2dParams la;
				    la.repeatTimes = (rows + 15) / 16;
				    la.srcStride = 1;
				    la.dstGap = 1;
				    la.ifTranspose = false;
#pragma unroll
				    for (int ki = 0; ki < 2; ++ki)
				    {
					LoadData(a2[slot0][ki * 512],
						 a1[slot1][(sub * 2 + ki) * tm * 32], la);
				    }
				    LoadData2dTransposeParams lb{
					0,
					uint8_t(((cols + 31) / 32 * 32) / 32),
					uint16_t(PacketK / 32),
					1,
					0,
					0};
#pragma unroll
				    for (int ki = 0; ki < 2; ++ki)
					LoadDataWithTranspose(
					    b2[slot0][ki * ((cols + 31) / 32 * 32) * 32],
					    b1[slot1][(sub * 2 + ki) * 1024], lb);
				    SetFlag<HardEvent::MTE1_M>(l0Ready[slot0]);
				    WaitFlag<HardEvent::MTE1_M>(l0Ready[slot0]);
				    if (fragment == 0 && local > 0)
					WaitFlag<HardEvent::FIX_M>(accumulatorFree);
				    MmadParams mad;
				    mad.m = (rows + 15) / 16 * 16;
				    mad.n = (cols + 31) / 32 * 32;
				    mad.k = 64;
				    mad.cmatrixInitVal = fragment == 0;
				    Mmad(acc, a2[slot0], b2[slot0], mad);

				    if ((mad.m / 16) * (mad.n / 16) < 10)
					PipeBarrier<PIPE_M>();
				    SetFlag<HardEvent::M_MTE1>(l0Free[slot0]);
				    l0Used[slot0] = true;
				    ++fragment;
				}
				SetFlag<HardEvent::MTE1_MTE2>(l1Free[slot1]);
				if (panel + 2 < panels)
				{
				    DeepTailPrefetchUnified<TileM, PacketK>(
					gx, gw, a1[slot1], b1[slot1], true, l1Free[slot1],
					l1Ready[slot1], row, col, rows, cols, e, K, N, panel + 2);
				}
			    }
			    SetFlag<HardEvent::M_FIX>(matrixReady);
			    WaitFlag<HardEvent::M_FIX>(matrixReady);

			    if (local >= SLOTS)
				CrossCoreWaitFlag<2, PIPE_FIX>(freeFlag);
			    FixpipeParamsV220 fix;
			    fix.nSize = (cols + 31) / 32 * 32;
			    fix.mSize = (rows + 15) / 16 * 16;
			    fix.srcStride = (rows + 15) / 16 * 16;
			    fix.dstStride = tn;
			    Fixpipe<int32_t, int32_t, CFG_ROW_MAJOR>(gcSlot, acc, fix);
			    SetFlag<HardEvent::FIX_M>(accumulatorFree);
			    CrossCoreSetFlag<2, PIPE_FIX>(tileFlag);
			}
			if ASCEND_IS_AIV
			{
			    CrossCoreWaitFlag<2, PIPE_MTE2>(tileFlag);
			    const int halfRows = (rows + 1) / 2;
			    const int rowOffset = lane * halfRows;
			    const int vectorRows = lane ? rows - halfRows : halfRows;
			    auto c = cq.AllocTensor<int32_t>();
			    auto scale = c.ReinterpretCast<float>()[((tm + 1) / 2 * tn) +
								    (tm * tn > 16384 ? 64 : 0)];

			    if (pitch != (cols + 7) / 8 * 8)
			    {
				Duplicate(c, int32_t(0), vectorRows * pitch);
				auto event = pipe.FetchEventID<HardEvent::V_MTE2>();
				SetFlag<HardEvent::V_MTE2>(event);
				WaitFlag<HardEvent::V_MTE2>(event);
			    }

			    if (vectorRows > 0)
				DataCopyPad(c, gcSlot[int64_t(rowOffset) * tn],
					    {uint16_t(vectorRows), uint32_t(cols * sizeof(int32_t)),
					     uint32_t((tn - cols) * sizeof(int32_t)),
					     uint32_t((pitch * 4 - (cols * 4 + 31) / 32 * 32) / 32),
					     0},
					    {true, 0, 0, 0});
			    if (cols < 64)
			    {
				Duplicate(scale, 0.0f, tn);
				auto initialized = pipe.FetchEventID<HardEvent::V_MTE2>();
				SetFlag<HardEvent::V_MTE2>(initialized);
				WaitFlag<HardEvent::V_MTE2>(initialized);
			    }
			    DataCopyPad(scale, gs[(int64_t)e * N + col],
					{1, (uint32_t)(cols * sizeof(float)), 0, 0, 0},
					{true, 0, 0, 0.0f});
			    cq.EnQue(c);
			    c = cq.DeQue<int32_t>();

			    CrossCoreSetFlag<2, PIPE_MTE2>(freeFlag);

			    auto z = zb.Get<float>();
			    auto p = c.ReinterpretCast<float>();
			    auto u = p;
			    auto t = p;

			    const BinaryRepeatParams bcast{
				1, 1, 1, (uint8_t)(pitch / 8), (uint8_t)(pitch / 8), 0};
			    for (int r = 0; r < vectorRows; r += vr)
			    {
				const int batch = (vectorRows - r < vr) ? (vectorRows - r) : vr;
				const uint32_t count = (uint32_t)batch * pitch;
				Cast(z, c[r * pitch], RoundMode::CAST_NONE, count);
				PipeBarrier<PIPE_V>();
				if (cols < 64)
				{
				    Mul(z, z, scale, (uint64_t)(pitch < 64 ? pitch : 64),
					(uint8_t)batch, bcast);
				}
				else
				{
				    for (int c0 = 0; c0 < cols; c0 += 64)
				    {
					const int chunk = (cols - c0 < 64) ? (cols - c0) : 64;
					Mul(z[c0], z[c0], scale[c0], (uint64_t)chunk,
					    (uint8_t)batch, bcast);
				    }
				}
				PipeBarrier<PIPE_V>();

				p = c[r * pitch].ReinterpretCast<float>();
				u = p;
				GeluTanh(z, p, u, t, count);
				auto out = oq.AllocTensor<half>();
				Cast(out, z, RoundMode::CAST_RINT, count);
				oq.EnQue(out);
				out = oq.DeQue<half>();
				const uint32_t outBytes = (uint32_t)cols * (uint32_t)sizeof(half);
				const uint32_t outPitchBytes =
				    (uint32_t)pitch * (uint32_t)sizeof(half);
				const uint32_t outSrcStride =
				    (outPitchBytes - ((outBytes + 31U) / 32U) * 32U) / 32U;
				for (int r0 = 0; r0 < batch; r0 += 32)
				{
				    const int rc = batch - r0 < 32 ? batch - r0 : 32;
				    DataCopyPad(gy[(int64_t)(row + rowOffset + r + r0) * N + col],
						out[r0 * pitch],
						{(uint16_t)rc, outBytes, outSrcStride,
						 (uint32_t)((N - cols) * sizeof(half)), 0});
				}
				oq.FreeTensor(out);
			    }
			    cq.FreeTensor(c);
			}
			++local;
		    }
		    nextTask = t - tasks;
		}
		begin = end;
	    }
	}
	if ASCEND_IS_AIC
	{

	    if (local > 0)
		CrossCoreWaitFlag<2, PIPE_MTE2>(FLAG_FREE0);
	    if (local > 1)
		CrossCoreWaitFlag<2, PIPE_MTE2>(FLAG_FREE1);
	    if (local > 0)
		WaitFlag<HardEvent::FIX_M>(accumulatorFree);
#pragma unroll
	    for (int i = 0; i < 2; ++i)
	    {
		if (l1Used[i])
		    WaitFlag<HardEvent::MTE1_MTE2>(l1Free[i]);
		pipe.ReleaseEventID<HardEvent::MTE1_MTE2>(l1Free[i]);
		pipe.ReleaseEventID<HardEvent::MTE2_MTE1>(l1Ready[i]);
	    }
#pragma unroll
	    for (int i = 0; i < L0Slots; ++i)
	    {
		if (l0Used[i])
		    WaitFlag<HardEvent::M_MTE1>(l0Free[i]);
		pipe.ReleaseEventID<HardEvent::M_MTE1>(l0Free[i]);
		pipe.ReleaseEventID<HardEvent::MTE1_M>(l0Ready[i]);
	    }
	    pipe.ReleaseEventID<HardEvent::FIX_M>(accumulatorFree);
	    pipe.ReleaseEventID<HardEvent::M_FIX>(matrixReady);
	}
    }

template<int CopyRows>
__aicore__ inline void PreloadNZChunk(TPipe& pipe,LocalTensor<int8_t> ub,GlobalTensor<int8_t> gw,
    int task,int K,int N,bool reused,uint8_t freeId,uint8_t readyId)
{
    if(reused)WaitFlag<HardEvent::V_MTE2>(freeId);
    const int kp=(K+63)/64*64,np=(N+31)/32*32,chunks=(kp+CopyRows-1)/CopyRows;
    const int e=task/chunks,row=task%chunks*CopyRows;
    const int rows=kp-row<CopyRows?kp-row:CopyRows,live=K-row<rows?K-row:rows;
    if(live<rows) {
	auto free=pipe.FetchEventID<HardEvent::MTE2_V>();
	SetFlag<HardEvent::MTE2_V>(free);WaitFlag<HardEvent::MTE2_V>(free);
	Duplicate(ub.template ReinterpretCast<int32_t>(),int32_t(0),rows*np/4);
	auto zero=pipe.FetchEventID<HardEvent::V_MTE2>();
	SetFlag<HardEvent::V_MTE2>(zero);WaitFlag<HardEvent::V_MTE2>(zero);
    }
    if(live>0)
	DataCopyPad(ub,gw[int64_t(e)*K*N+int64_t(row)*N],
	    {uint16_t(live),uint32_t(N),0,0,0},{true,0,uint8_t(np-N),int8_t(0)});
    SetFlag<HardEvent::MTE2_V>(readyId);
}

template<int CopyRows,bool PackX>
__aicore__ inline void PrepareTransportNZPipeline(GM_ADDR x,GM_ADDR w,GM_ADDR xp,GM_ADDR wp,
    int M,int K,int N,int E)
{
    if ASCEND_IS_AIV {
	TPipe pipe;
	TBuf<TPosition::VECCALC> input[2],output;
	const int kp=(K+63)/64*64,np=(N+31)/32*32;
	const int bytes=PackX && CopyRows*np<16384?16384:CopyRows*np;
	uint8_t inFree[2],inReady[2];bool used[2]={};
	for(int i=0;i<2;++i) {
	    pipe.InitBuffer(input[i],bytes);
	    inFree[i]=pipe.AllocEventID<HardEvent::V_MTE2>();
	    inReady[i]=pipe.AllocEventID<HardEvent::MTE2_V>();
	}
	pipe.InitBuffer(output,bytes);
	auto packed=output.Get<int8_t>();
	const uint8_t outFree=pipe.AllocEventID<HardEvent::MTE3_V>();
	const uint8_t outReady=pipe.AllocEventID<HardEvent::V_MTE3>();
	GlobalTensor<int8_t> gw,gwp;
	gw.SetGlobalBuffer((__gm__ int8_t*)w);gwp.SetGlobalBuffer((__gm__ int8_t*)wp);
	const int block=GetBlockIdx(),cores=GetBlockNum()*2,chunks=(kp+CopyRows-1)/CopyRows;
	const int tasks=E*chunks;
	for(int i=0;i<2;++i)if(block+i*cores<tasks) {
	    PreloadNZChunk<CopyRows>(pipe,input[i].Get<int8_t>(),gw,block+i*cores,K,N,false,inFree[i],inReady[i]);
	    used[i]=true;
	}
	bool outputUsed=false;
	for(int index=0,task=block;task<tasks;++index,task+=cores) {
	    const int slot=index&1,e=task/chunks,row=task%chunks*CopyRows;
	    const int rows=kp-row<CopyRows?kp-row:CopyRows;
	    auto ub=input[slot].Get<int8_t>();
	    WaitFlag<HardEvent::MTE2_V>(inReady[slot]);
	    if(outputUsed)WaitFlag<HardEvent::MTE3_V>(outFree);
	    for(int c=0;c<np/32;++c)
		DataCopy(packed[c*rows*32],ub[c*32],
		    DataCopyParams{uint16_t(rows),1,uint16_t(np/32-1),0});
	    SetFlag<HardEvent::V_MTE2>(inFree[slot]);
	    SetFlag<HardEvent::V_MTE3>(outReady);WaitFlag<HardEvent::V_MTE3>(outReady);
	    DataCopy(gwp[int64_t(e)*kp*np+row*32],packed,
		DataCopyParams{uint16_t(np/32),uint16_t(rows),0,uint16_t(kp-rows)});
	    SetFlag<HardEvent::MTE3_V>(outFree);outputUsed=true;
	    if(task+2*cores<tasks)
		PreloadNZChunk<CopyRows>(pipe,ub,gw,task+2*cores,K,N,true,inFree[slot],inReady[slot]);
	}
	for(int i=0;i<2;++i) {
	    if(used[i])WaitFlag<HardEvent::V_MTE2>(inFree[i]);
	    pipe.ReleaseEventID<HardEvent::V_MTE2>(inFree[i]);
	    pipe.ReleaseEventID<HardEvent::MTE2_V>(inReady[i]);
	}
	if(outputUsed)WaitFlag<HardEvent::MTE3_V>(outFree);
	pipe.ReleaseEventID<HardEvent::MTE3_V>(outFree);
	pipe.ReleaseEventID<HardEvent::V_MTE3>(outReady);
	if constexpr(PackX) {
	    // X uses [ceil(K/32), ceil(M/16)*16, 32], with aligned column slabs.
	    GlobalTensor<int8_t> gx,gxp;
	    gx.SetGlobalBuffer((__gm__ int8_t*)x);gxp.SetGlobalBuffer((__gm__ int8_t*)xp);
	    const int mp=(M+15)/16*16,kc=(kp+511)/512,mc=(mp+31)/32;
	    auto ub=input[0].Get<int8_t>();
	    bool xUsed=false;
	    for(int task=block;task<mc*kc;task+=cores) {
		const int row=task/kc*32,col=task%kc*512;
		const int rows=mp-row<32?mp-row:32,cols=kp-col<512?kp-col:512;
		const int liveRows=M-row<rows?M-row:rows,liveCols=K-col<cols?K-col:cols;
		if(xUsed) {
		    auto free=pipe.FetchEventID<HardEvent::MTE3_MTE2>();
		    SetFlag<HardEvent::MTE3_MTE2>(free);WaitFlag<HardEvent::MTE3_MTE2>(free);
		}
		if(liveRows<rows || liveCols<cols) {
		    auto free=pipe.FetchEventID<HardEvent::MTE3_V>();
		    SetFlag<HardEvent::MTE3_V>(free);WaitFlag<HardEvent::MTE3_V>(free);
		    Duplicate(ub.ReinterpretCast<int32_t>(),int32_t(0),rows*cols/4);
		    auto zero=pipe.FetchEventID<HardEvent::V_MTE2>();
		    SetFlag<HardEvent::V_MTE2>(zero);WaitFlag<HardEvent::V_MTE2>(zero);
		}
		DataCopyPad(ub,gx[int64_t(row)*K+col],
		    {uint16_t(liveRows),uint32_t(liveCols),uint32_t(K-liveCols),
			uint32_t((cols-(liveCols+31)/32*32)/32),0},
		    {true,0,uint8_t((liveCols+31)/32*32-liveCols),int8_t(0)});
		auto loaded=pipe.FetchEventID<HardEvent::MTE2_V>();
		SetFlag<HardEvent::MTE2_V>(loaded);WaitFlag<HardEvent::MTE2_V>(loaded);
		auto free=pipe.FetchEventID<HardEvent::MTE3_V>();
		SetFlag<HardEvent::MTE3_V>(free);WaitFlag<HardEvent::MTE3_V>(free);
		for(int c=0;c<cols/32;++c)
		    DataCopy(packed[c*rows*32],ub[c*32],
			DataCopyParams{uint16_t(rows),1,uint16_t(cols/32-1),0});
		auto ready=pipe.FetchEventID<HardEvent::V_MTE3>();
		SetFlag<HardEvent::V_MTE3>(ready);WaitFlag<HardEvent::V_MTE3>(ready);
		DataCopy(gxp[int64_t(col)*mp+row*32],packed,
		    DataCopyParams{uint16_t(cols/32),uint16_t(rows),0,uint16_t(mp-rows)});
		xUsed=true;
	    }
	}
	PipeBarrier<PIPE_ALL>();
    }
    SyncAll<false>();
}

template <int TileM, int PacketK>
    __aicore__ inline void NZPrefetch(GlobalTensor<int8_t> gx, GlobalTensor<int8_t> gw,
						   LocalTensor<int8_t> a1, LocalTensor<int8_t> b1,
						   bool reused, uint8_t freeId, uint8_t readyId,
						   int row, int col, int rows, int cols, int expert,
						   int K, int N, int panel, int M)
    {
	if (reused)
	    WaitFlag<HardEvent::MTE1_MTE2>(freeId);
	const int ck = K - panel * PacketK < PacketK ? K - panel * PacketK : PacketK;
	const int paddedK = (ck + 63) / 64 * 64;
	const int paddedN = (cols + 31) / 32 * 32;
	const int kp=(K+63)/64*64,np=(N+31)/32*32;
	DataCopy(b1,gw[(int64_t(expert)*np+col)*kp+int64_t(panel*PacketK)*32],
	    DataCopyParams{uint16_t(paddedN/32),uint16_t(paddedK),
		uint16_t(kp-paddedK),uint16_t(PacketK-paddedK)});
	const int mp=(M+15)/16*16;
	DataCopy(a1,gx[int64_t(panel*PacketK)*mp+row*32],
	    DataCopyParams{uint16_t(paddedK/32),uint16_t(rows),uint16_t(mp-rows),uint16_t(TileM-rows)});
	SetFlag<HardEvent::MTE2_MTE1>(readyId);
    }

template <int TileM, int TileN, int PacketK, int L0Slots = 4>
    __aicore__ __attribute__((always_inline)) inline void
    ComputeTransportNZ(GM_ADDR x, GM_ADDR w, GM_ADDR sc, GM_ADDR groups, GM_ADDR y,
			   GM_ADDR workspace, int M, int K, int N, int E,
			   AscendC::tiling::TCubeTiling tiling, uint32_t l1Half)
    {
	TPipe pipe;
	GlobalTensor<int8_t> gx, gw;
	GlobalTensor<float> gs;
	GlobalTensor<int32_t> gc;
	GlobalTensor<half> gy;
	gx.SetGlobalBuffer((__gm__ int8_t *)x);
	gw.SetGlobalBuffer((__gm__ int8_t *)w);
	gs.SetGlobalBuffer((__gm__ float *)sc);
	gy.SetGlobalBuffer((__gm__ half *)y);
	gc.SetGlobalBuffer((__gm__ int32_t *)workspace);

	const int tm = TileM;
	const int tn = TileN;

	const int capacity = 8192;
	const int vr = capacity / tn;
	const int ve = vr * tn;
	TBuf<TPosition::A1> a1Buffer[2], l1Gap;
	TBuf<TPosition::B1> b1Buffer[2];
	TBuf<TPosition::A2> a2Buffer;
	TBuf<TPosition::B2> b2Buffer;
	TBuf<TPosition::CO1> accBuffer;
	LocalTensor<int8_t> a1[2], b1[2], a2[L0Slots], b2[L0Slots];
	uint8_t l1Free[2], l1Ready[2], l0Free[L0Slots], l0Ready[L0Slots];
	uint8_t accumulatorFree = 0, matrixReady = 0;
	bool l1Used[2] = {false, false}, l0Used[L0Slots] = {};
	if ASCEND_IS_AIC
	{
	    pipe.InitBuffer(a1Buffer[0], tm * PacketK);
	    pipe.InitBuffer(b1Buffer[0], tn * PacketK);
	    const uint32_t packetBytes = (tm + tn) * PacketK;
	    if (l1Half > packetBytes)
		pipe.InitBuffer(l1Gap, l1Half - packetBytes);
	    pipe.InitBuffer(a1Buffer[1], tm * PacketK);
	    pipe.InitBuffer(b1Buffer[1], tn * PacketK);
#pragma unroll
	    for (int i = 0; i < 2; ++i)
	    {
		a1[i] = a1Buffer[i].Get<int8_t>();
		b1[i] = b1Buffer[i].Get<int8_t>();
		l1Free[i] = pipe.AllocEventID<HardEvent::MTE1_MTE2>();
		l1Ready[i] = pipe.AllocEventID<HardEvent::MTE2_MTE1>();
	    }
	    pipe.InitBuffer(a2Buffer, L0Slots * tm * 64);
	    pipe.InitBuffer(b2Buffer, L0Slots * tn * 64);
#pragma unroll
	    for (int i = 0; i < L0Slots; ++i)
	    {
		a2[i] = a2Buffer.Get<int8_t>()[i * tm * 64];
		b2[i] = b2Buffer.Get<int8_t>()[i * tn * 64];
		l0Free[i] = pipe.AllocEventID<HardEvent::M_MTE1>();
		l0Ready[i] = pipe.AllocEventID<HardEvent::MTE1_M>();
	    }
	    pipe.InitBuffer(accBuffer, tm * tn * sizeof(int32_t));
	    accumulatorFree = pipe.AllocEventID<HardEvent::FIX_M>();
	    matrixReady = pipe.AllocEventID<HardEvent::M_FIX>();
	}

	TQue<TPosition::VECIN, 1> cq;
	TQue<TPosition::VECOUT, 1> oq;
	TBuf<TPosition::VECCALC> zb, pb, groupCache;
	if ASCEND_IS_AIV
	{
	    pipe.InitBuffer(cq, 1,
			    uint32_t(((tm + 1) / 2 * tn + tn) * sizeof(float)) +
				(tm * tn > 16384 ? 256 : 0));
	    pipe.InitBuffer(oq, 1, (uint32_t)ve * sizeof(half));
	    pipe.InitBuffer(zb, (uint32_t)ve * sizeof(float));
	    if (E > 0)
	    {
		pipe.InitBuffer(groupCache, (E * 8 + 31) / 32 * 32);
		GlobalTensor<int64_t> gg;
		gg.SetGlobalBuffer((__gm__ int64_t *)groups);
		DataCopyPad(groupCache.Get<int64_t>(), gg, {1, (uint32_t)(E * 8), 0, 0, 0},
			    {true, 0, 0, int64_t(0)});
		auto ready = pipe.FetchEventID<HardEvent::MTE2_S>();
		SetFlag<HardEvent::MTE2_S>(ready);
		WaitFlag<HardEvent::MTE2_S>(ready);
	    }
	}

	int blockIdx = (int)GetBlockIdx();
	int lane = 0;
	if ASCEND_IS_AIV
	{
	    lane = blockIdx & 1;
	    blockIdx /= 2;
	}
	const int blockNum = (int)GetBlockNum();
	const int nc = (N + tn - 1) / tn;
	int64_t nextTask = blockIdx;
	const int period = 2 * blockNum;
	int gap = period - 1 - 2 * blockIdx;
	int64_t local = 0;
	for (int bucket = ((tm + 31) / 32 + 1) * 32; bucket >= 16; bucket -= 32)
	{
	    int begin = 0;
	    for (int e = 0; e < E; ++e)
	    {
		int end = 0;
		if ASCEND_IS_AIC
		{
		    end = (int)((__gm__ int64_t *)groups)[e];
		}
		if ASCEND_IS_AIV
		{
		    end = E > 0 ? (int)groupCache.Get<int64_t>().GetValue(e)
				: (int)((__gm__ int64_t *)groups)[e];
		}
		if (end < begin)
		    end = begin;
		if (end > M)
		    end = M;
		const int me = end - begin;
		const bool fullPass = bucket == ((tm + 31) / 32 + 1) * 32;
		const int fullTiles = me / tm;
		const int tailRows = me % tm;
		const bool selected = fullPass
					  ? fullTiles > 0
					  : tailRows > 0 && ((tailRows + 31) / 32 * 32 == bucket);
		if (selected)
		{
		    const int mt = fullPass ? fullTiles : 1;
		    const int firstM = fullPass ? 0 : fullTiles;
		    const int64_t tasks = (int64_t)mt * nc;

		    int64_t t = nextTask;
		    for (; t < tasks; t += gap, gap = period - gap)
		    {

			const int mIdx = firstM + (mt == 1 ? 0 : (int)(t % mt));
			const int nIdx = mt == 1 ? (int)t : (int)(t / mt);
			const int row = begin + mIdx * tm;
			const int col = nIdx * tn;
			const int rows = (me - mIdx * tm < tm) ? (me - mIdx * tm) : tm;
			const int cols = N - col < tn ? N - col : tn;

			const int pitch = (cols + 31) / 32 * 32;
			const int slot = (int)(local & 1);
			const uint16_t tileFlag = slot ? FLAG_TILE1 : FLAG_TILE0;
			const uint16_t freeFlag = slot ? FLAG_FREE1 : FLAG_FREE0;
			auto gcSlot = gc[(int64_t)(blockIdx * SLOTS + slot) * tm * tn];

			if ASCEND_IS_AIC
			{
			    const int panels = (K + PacketK - 1) / PacketK;
			    auto acc = accBuffer.Get<int32_t>();
#pragma unroll
			    for (int p = 0; p < 2 && p < panels; ++p)
			    {
				NZPrefetch<TileM, PacketK>(
				    gx, gw, a1[p], b1[p], l1Used[p], l1Free[p], l1Ready[p], row,
				    col, rows, cols, e, K, N, p, M);
				l1Used[p] = true;
			    }
			    int fragment = 0;
			    for (int panel = 0; panel < panels; ++panel)
			    {
				const int slot1 = panel & 1;
				WaitFlag<HardEvent::MTE2_MTE1>(l1Ready[slot1]);
#pragma unroll
				for (int sub = 0; sub < PacketK / 64; ++sub)
				{
				    if (panel * PacketK + sub * 64 >= K)
					break;
				    const int slot0 = fragment & (L0Slots - 1);
				    if (l0Used[slot0])
					WaitFlag<HardEvent::M_MTE1>(l0Free[slot0]);
				    LoadData2dParams la;
				    la.repeatTimes = (rows + 15) / 16;
				    la.srcStride = 1;
				    la.dstGap = 1;
				    la.ifTranspose = false;
#pragma unroll
				    for (int ki = 0; ki < 2; ++ki)
				    {
					LoadData(a2[slot0][ki * 512],
						 a1[slot1][(sub * 2 + ki) * tm * 32], la);
				    }
				    LoadData2dTransposeParams lb{
					0,
					uint8_t(((cols + 31) / 32 * 32) / 32),
					uint16_t(PacketK / 32),
					1,
					0,
					0};
#pragma unroll
				    for (int ki = 0; ki < 2; ++ki)
					LoadDataWithTranspose(
					    b2[slot0][ki * ((cols + 31) / 32 * 32) * 32],
					    b1[slot1][(sub * 2 + ki) * 1024], lb);
				    SetFlag<HardEvent::MTE1_M>(l0Ready[slot0]);
				    WaitFlag<HardEvent::MTE1_M>(l0Ready[slot0]);
				    if (fragment == 0 && local > 0)
					WaitFlag<HardEvent::FIX_M>(accumulatorFree);
				    MmadParams mad;
				    mad.m = (rows + 15) / 16 * 16;
				    mad.n = (cols + 31) / 32 * 32;
				    mad.k = 64;
				    mad.cmatrixInitVal = fragment == 0;
				    Mmad(acc, a2[slot0], b2[slot0], mad);

				    if ((mad.m / 16) * (mad.n / 16) < 10)
					PipeBarrier<PIPE_M>();
				    SetFlag<HardEvent::M_MTE1>(l0Free[slot0]);
				    l0Used[slot0] = true;
				    ++fragment;
				}
				SetFlag<HardEvent::MTE1_MTE2>(l1Free[slot1]);
				if (panel + 2 < panels)
				{
				    NZPrefetch<TileM, PacketK>(
					gx, gw, a1[slot1], b1[slot1], true, l1Free[slot1],
					l1Ready[slot1], row, col, rows, cols, e, K, N, panel + 2, M);
				}
			    }
			    SetFlag<HardEvent::M_FIX>(matrixReady);
			    WaitFlag<HardEvent::M_FIX>(matrixReady);

			    if (local >= SLOTS)
				CrossCoreWaitFlag<2, PIPE_FIX>(freeFlag);
			    FixpipeParamsV220 fix;
			    fix.nSize = (cols + 31) / 32 * 32;
			    fix.mSize = (rows + 15) / 16 * 16;
			    fix.srcStride = (rows + 15) / 16 * 16;
			    fix.dstStride = tn;
			    Fixpipe<int32_t, int32_t, CFG_ROW_MAJOR>(gcSlot, acc, fix);
			    SetFlag<HardEvent::FIX_M>(accumulatorFree);
			    CrossCoreSetFlag<2, PIPE_FIX>(tileFlag);
			}
			if ASCEND_IS_AIV
			{
			    CrossCoreWaitFlag<2, PIPE_MTE2>(tileFlag);
			    const int halfRows = (rows + 1) / 2;
			    const int rowOffset = lane * halfRows;
			    const int vectorRows = lane ? rows - halfRows : halfRows;
			    auto c = cq.AllocTensor<int32_t>();
			    auto scale = c.ReinterpretCast<float>()[((tm + 1) / 2 * tn) +
								    (tm * tn > 16384 ? 64 : 0)];

			    if (pitch != (cols + 7) / 8 * 8)
			    {
				Duplicate(c, int32_t(0), vectorRows * pitch);
				auto event = pipe.FetchEventID<HardEvent::V_MTE2>();
				SetFlag<HardEvent::V_MTE2>(event);
				WaitFlag<HardEvent::V_MTE2>(event);
			    }

			    if (vectorRows > 0)
				DataCopyPad(c, gcSlot[int64_t(rowOffset) * tn],
					    {uint16_t(vectorRows), uint32_t(cols * sizeof(int32_t)),
					     uint32_t((tn - cols) * sizeof(int32_t)),
					     uint32_t((pitch * 4 - (cols * 4 + 31) / 32 * 32) / 32),
					     0},
					    {true, 0, 0, 0});
			    if (cols < 64)
			    {
				Duplicate(scale, 0.0f, tn);
				auto initialized = pipe.FetchEventID<HardEvent::V_MTE2>();
				SetFlag<HardEvent::V_MTE2>(initialized);
				WaitFlag<HardEvent::V_MTE2>(initialized);
			    }
			    DataCopyPad(scale, gs[(int64_t)e * N + col],
					{1, (uint32_t)(cols * sizeof(float)), 0, 0, 0},
					{true, 0, 0, 0.0f});
			    cq.EnQue(c);
			    c = cq.DeQue<int32_t>();

			    CrossCoreSetFlag<2, PIPE_MTE2>(freeFlag);

			    auto z = zb.Get<float>();
			    auto p = c.ReinterpretCast<float>();
			    auto u = p;
			    auto t = p;

			    const BinaryRepeatParams bcast{
				1, 1, 1, (uint8_t)(pitch / 8), (uint8_t)(pitch / 8), 0};
			    for (int r = 0; r < vectorRows; r += vr)
			    {
				const int batch = (vectorRows - r < vr) ? (vectorRows - r) : vr;
				const uint32_t count = (uint32_t)batch * pitch;
				Cast(z, c[r * pitch], RoundMode::CAST_NONE, count);
				PipeBarrier<PIPE_V>();
				if (cols < 64)
				{
				    Mul(z, z, scale, (uint64_t)(pitch < 64 ? pitch : 64),
					(uint8_t)batch, bcast);
				}
				else
				{
				    for (int c0 = 0; c0 < cols; c0 += 64)
				    {
					const int chunk = (cols - c0 < 64) ? (cols - c0) : 64;
					Mul(z[c0], z[c0], scale[c0], (uint64_t)chunk,
					    (uint8_t)batch, bcast);
				    }
				}
				PipeBarrier<PIPE_V>();

				p = c[r * pitch].ReinterpretCast<float>();
				u = p;
				GeluTanh(z, p, u, t, count);
				auto out = oq.AllocTensor<half>();
				Cast(out, z, RoundMode::CAST_RINT, count);
				oq.EnQue(out);
				out = oq.DeQue<half>();
				const uint32_t outBytes = (uint32_t)cols * (uint32_t)sizeof(half);
				const uint32_t outPitchBytes =
				    (uint32_t)pitch * (uint32_t)sizeof(half);
				const uint32_t outSrcStride =
				    (outPitchBytes - ((outBytes + 31U) / 32U) * 32U) / 32U;
				for (int r0 = 0; r0 < batch; r0 += 32)
				{
				    const int rc = batch - r0 < 32 ? batch - r0 : 32;
				    DataCopyPad(gy[(int64_t)(row + rowOffset + r + r0) * N + col],
						out[r0 * pitch],
						{(uint16_t)rc, outBytes, outSrcStride,
						 (uint32_t)((N - cols) * sizeof(half)), 0});
				}
				oq.FreeTensor(out);
			    }
			    cq.FreeTensor(c);
			}
			++local;
		    }
		    nextTask = t - tasks;
		}
		begin = end;
	    }
	}
	if ASCEND_IS_AIC
	{

	    if (local > 0)
		CrossCoreWaitFlag<2, PIPE_MTE2>(FLAG_FREE0);
	    if (local > 1)
		CrossCoreWaitFlag<2, PIPE_MTE2>(FLAG_FREE1);
	    if (local > 0)
		WaitFlag<HardEvent::FIX_M>(accumulatorFree);
#pragma unroll
	    for (int i = 0; i < 2; ++i)
	    {
		if (l1Used[i])
		    WaitFlag<HardEvent::MTE1_MTE2>(l1Free[i]);
		pipe.ReleaseEventID<HardEvent::MTE1_MTE2>(l1Free[i]);
		pipe.ReleaseEventID<HardEvent::MTE2_MTE1>(l1Ready[i]);
	    }
#pragma unroll
	    for (int i = 0; i < L0Slots; ++i)
	    {
		if (l0Used[i])
		    WaitFlag<HardEvent::M_MTE1>(l0Free[i]);
		pipe.ReleaseEventID<HardEvent::M_MTE1>(l0Free[i]);
		pipe.ReleaseEventID<HardEvent::MTE1_M>(l0Ready[i]);
	    }
	    pipe.ReleaseEventID<HardEvent::FIX_M>(accumulatorFree);
	    pipe.ReleaseEventID<HardEvent::M_FIX>(matrixReady);
	}
    }

    template <int TileM>
    __aicore__ inline void
    BalancedPrefetch256(GlobalTensor<int8_t> gw, LocalTensor<int8_t> b1, bool reused, uint8_t freeId, uint8_t readyId,
			int row, int col, int rows, int cols, int expert, int K, int N, int panel)
    {
	if (reused)
	    WaitFlag<HardEvent::MTE1_MTE2>(freeId);
	Nd2NzParams bp;
	bp.ndNum = 1;
	bp.nValue = 256;
	bp.dValue = cols;
	bp.srcNdMatrixStride = 0;
	bp.srcDValue = N;
	bp.dstNzC0Stride = 256;
	bp.dstNzNStride = 1;
	bp.dstNzMatrixStride = 0;
	if (N <= 65535 / 2)
	{
	    bp.ndNum = 2;
	    bp.nValue = 256 / 2;
	    bp.srcNdMatrixStride = N;
	    bp.srcDValue = 2 * N;
	    bp.dstNzNStride = 2;
	    bp.dstNzMatrixStride = 32;
	}
	DataCopy(b1, gw[int64_t(expert) * K * N + int64_t(panel * 256) * N + col], bp);
	SetFlag<HardEvent::MTE2_MTE1>(readyId);
    }

    template <int TileM>
    __aicore__ inline void BalancedPrefetchA(GlobalTensor<int8_t> gx, LocalTensor<int8_t> a,
					       int row, int rows, int K)
    {
	Nd2NzParams ap;
	ap.ndNum = 1;
	ap.nValue = rows;
	ap.dValue = K;
	ap.srcNdMatrixStride = 0;
	ap.srcDValue = K;
	ap.dstNzC0Stride = rows <= 64 ? 64 : TileM;
	ap.dstNzNStride = 1;
	ap.dstNzMatrixStride = 0;
	DataCopy(a, gx[int64_t(row) * K], ap);
    }

    template <int TileM, int TileN>
    __aicore__ inline void ShortPackedEpilogue(LocalTensor<int32_t> c, LocalTensor<float> z,
					      GlobalTensor<half> gy, uint64_t info, int lane, int N,
					      TQue<TPosition::VECOUT, 1> &oq)
    {
	const int row = info & 65535U, rows = (info >> 23) & 255U;
	const int col = (info >> 31) & 4095U, cols = (info >> 43) & 1023U;
	const int halfRows = (rows + 1) / 2;
	const int rowOffset = lane * halfRows;
	const int vectorRows = lane ? rows - halfRows : halfRows;
	const int scaleM = TileN == 256 ? rows : TileM;
	auto allScale = c.ReinterpretCast<float>()[((scaleM + 1) / 2 * TileN) +
						   (scaleM * TileN > 16384 ? 64 : 0)];
	constexpr int pitch = 256;
	const BinaryRepeatParams bcast{1, 1, 1, 32, 32, 0};
	for (int segment = 0; segment < cols / 256; ++segment)
	{
	    const int inputBase = segment * ((TileM + 1) / 2) * 256;
	    auto scale = allScale[segment * 256];
	    for (int r = 0; r < vectorRows; r += 32)
	    {
		const int batch = vectorRows - r < 32 ? vectorRows - r : 32;
		const uint32_t count = uint32_t(batch * pitch);
		Cast(z, c[inputBase + r * pitch], RoundMode::CAST_NONE, count);
		PipeBarrier<PIPE_V>();
#pragma unroll
		for (int c0 = 0; c0 < 256; c0 += 64)
		    Mul(z[c0], z[c0], scale[c0], uint64_t(64), uint8_t(batch), bcast);
		PipeBarrier<PIPE_V>();
		auto p = c[inputBase + r * pitch].ReinterpretCast<float>();
		GeluTanh(z, p, p, p, count);
		auto out = oq.AllocTensor<half>();
		Cast(out, z, RoundMode::CAST_RINT, count);
		oq.EnQue(out);
		out = oq.DeQue<half>();
		DataCopyPad(gy[int64_t(row + rowOffset + r) * N + col + segment * 256], out,
			    {uint16_t(batch), 256 * uint32_t(sizeof(half)), 0,
			     uint32_t((N - 256) * sizeof(half)), 0});
		oq.FreeTensor(out);
	    }
	}
    }

    template <int TileM, int TileN, bool Snake>
    __aicore__ __attribute__((always_inline)) inline bool NextIndependentShortTask(
	GM_ADDR groups, GlobalTensor<int64_t> groupInput, LocalTensor<int64_t> cache,
	int M, int N, int E, int blockNum, int &expert, int &begin, int &end,
	int &next, int &mt, bool &loaded, bool &reverse, int core, uint64_t &info)
    {
	const int nc = N / TileN;
	while (expert < E)
	{
	    if (!loaded)
	    {
		if ASCEND_IS_AIV
		    end = int(cache.GetValue(expert));
		if ASCEND_IS_AIC
		{
		    if (expert == 0 ||
			((reinterpret_cast<uint64_t>(groups) + uint64_t(expert) * 8) & 63U) == 0)
			DataCacheCleanAndInvalid<int64_t, CacheLine::SINGLE_CACHE_LINE,
						 DcciDst::CACHELINE_OUT>(groupInput[expert]);
		    end = int(((__gm__ int64_t *)groups)[expert]);
		}
		if (end < begin)
		    end = begin;
		if (end > M)
		    end = M;
		mt = (end - begin + TileM - 1) / TileM;
		loaded = true;
	    }
	    const int tasks = mt * nc;
	    if (next < tasks)
	    {
		const int mi = mt == 1 ? 0 : next % mt;
		const int ni = mt == 1 ? next : next / mt;
		const int row = begin + mi * TileM;
		const int rows = end - row < TileM ? end - row : TileM;
		const int col = ni * TileN;
		info = uint64_t(row) | uint64_t(expert) << 16 | uint64_t(rows) << 23 |
		       uint64_t(col) << 31 | uint64_t(TileN) << 43;
		if constexpr (Snake)
		{
		    next += 2 * (reverse ? core : blockNum - core - 1) + 1;
		    reverse = !reverse;
		}
		else
		    next += blockNum;
		return true;
	    }
	    next -= tasks;
	    begin = end;
	    ++expert;
	    loaded = false;
	}
	info = 0;
	return false;
    }

    template <int KCapacity, int TileM = 128>
    __aicore__ __attribute__((always_inline)) inline void
    ComputeShortFourpack256(GM_ADDR x, GM_ADDR w, GM_ADDR sc, GM_ADDR groups, GM_ADDR y,
			  GM_ADDR workspace, int M, int runtimeK, int N, int E,
			  AscendC::tiling::TCubeTiling tiling, uint32_t l1Half)
    {
	static_assert(KCapacity==256 || KCapacity==512 || KCapacity==1024);
	constexpr int K = KCapacity;
	TPipe pipe;
	GlobalTensor<int8_t> gx, gw;
	GlobalTensor<float> gs;
	GlobalTensor<int32_t> gc;
	GlobalTensor<half> gy;
	gx.SetGlobalBuffer((__gm__ int8_t *)x);
	gw.SetGlobalBuffer((__gm__ int8_t *)w);
	gs.SetGlobalBuffer((__gm__ float *)sc);
	gy.SetGlobalBuffer((__gm__ half *)y);
	gc.SetGlobalBuffer((__gm__ int32_t *)workspace);

	constexpr int tm = TileM;
	const int tn = 256;

	const int capacity = 8192;
	const int vr = capacity / tn;
	const int ve = vr * tn;
	TBuf<TPosition::A1> a1Buffer[3], l1Gap;
	TBuf<TPosition::B1> b1Buffer[4];
	TBuf<TPosition::A2> a2Buffer;
	TBuf<TPosition::B2> b2Buffer;
	TBuf<TPosition::CO1> accBuffer;
	LocalTensor<int8_t> aFull[2], b1[4], a2[4], b2[4];
	uint8_t l1Free[4], l1Ready[4], l0Free[4], l0Ready[4];
	uint8_t aFree[2];
	bool aUsed[2] = {};
	uint8_t accumulatorFree = 0, matrixReady = 0;
	bool l1Used[4] = {}, l0Used[4] = {};
	if ASCEND_IS_AIC
	{
	    aFull[0] = LocalTensor<int8_t>(TPosition::A1, 0, tm * K);
	    aFull[1] = LocalTensor<int8_t>(TPosition::A1, tm * K, tm * K);
#pragma unroll
	    for (int i = 0; i < 4; ++i)
	    {
		b1[i] = LocalTensor<int8_t>(TPosition::B1,
					    uint32_t(2 * tm * K + i * tn * 256), tn * 256);
		l1Free[i] = pipe.AllocEventID<HardEvent::MTE1_MTE2>();
		l1Ready[i] = pipe.AllocEventID<HardEvent::MTE2_MTE1>();
	    }

#pragma unroll
	    for (int i = 0; i < 4; ++i)
	    {
		a2[i] = LocalTensor<int8_t>(TPosition::A2, uint32_t(i * tm * 64), tm * 64);
		b2[i] = LocalTensor<int8_t>(TPosition::B2, uint32_t(i * tn * 64), tn * 64);
		if (i < 2)
		    aFree[i] = pipe.AllocEventID<HardEvent::MTE1_MTE2>();
		l0Free[i] = pipe.AllocEventID<HardEvent::M_MTE1>();
		l0Ready[i] = pipe.AllocEventID<HardEvent::MTE1_M>();
	    }

	    accumulatorFree = pipe.AllocEventID<HardEvent::FIX_M>();
	    matrixReady = pipe.AllocEventID<HardEvent::M_FIX>();
	}

	TQue<TPosition::VECIN, 2> cq;
	TQue<TPosition::VECOUT, 1> oq;
	TBuf<TPosition::VECCALC> zb, pb, groupCache;
	if ASCEND_IS_AIV
	{
	    const uint32_t cBytes = uint32_t(((tm + 1) / 2 * tn + tn) * sizeof(float)) +
				    (tm * tn > 16384 ? 256 : 0);
	    pipe.InitBuffer(cq, 2, (cBytes + 1023) / 1024 * 1024);
	    pipe.InitBuffer(oq, 1, (uint32_t)ve * sizeof(half));
	    pipe.InitBuffer(zb, (uint32_t)ve * sizeof(float) + 768);

	    if (E > 0)
	    {
		pipe.InitBuffer(groupCache, (E * 8 + 31) / 32 * 32);
		GlobalTensor<int64_t> gg;
		gg.SetGlobalBuffer((__gm__ int64_t *)groups);
		DataCopyPad(groupCache.Get<int64_t>(), gg, {1, (uint32_t)(E * 8), 0, 0, 0},
			    {true, 0, 0, int64_t(0)});
		auto ready = pipe.FetchEventID<HardEvent::MTE2_S>();
		SetFlag<HardEvent::MTE2_S>(ready);
		WaitFlag<HardEvent::MTE2_S>(ready);
	    }
	}

	bool hasPending = false;
	bool vectorPending = false;
	uint64_t vectorPendingInfo = 0;
	uint64_t pendingInfo = 0;
	int producerOrdinal = 0;
	int blockIdx = (int)GetBlockIdx();
	int lane = 0;
	if ASCEND_IS_AIV
	{
	    lane = blockIdx & 1;
	    blockIdx /= 2;
	}
	const int blockNum = (int)GetBlockNum();
	const int panelPhase = (blockIdx & (K / 256 - 1));

	GlobalTensor<int64_t> groupInput;
	groupInput.SetGlobalBuffer((__gm__ int64_t *)groups);
	LocalTensor<int64_t> cachedGroups;
	if ASCEND_IS_AIV
	    cachedGroups = groupCache.Get<int64_t>();
	int cursorExpert = 0, cursorBegin = 0, cursorEnd = 0, cursorNext = blockIdx, cursorMt = 0;
	bool cursorLoaded = false, reverse = false;
	uint64_t firstInfo = 0;
	const bool firstValid = NextIndependentShortTask<TileM, 256, K <= 512>(
	    groups, groupInput, cachedGroups, M, N, E, blockNum, cursorExpert, cursorBegin,
	    cursorEnd, cursorNext, cursorMt, cursorLoaded, reverse, blockIdx, firstInfo);
	if ASCEND_IS_AIC
	{
	    if (firstValid)
	    {
		const int firstRows = (firstInfo >> 23) & 255U;
		BalancedPrefetchA<TileM>(gx, aFull[0], firstInfo & 65535U, firstRows, K);
		aUsed[0] = true;
		for (int step = 0; step < K / 256; ++step)
		{
		    const int p = (step + panelPhase) & (K / 256 - 1);
		    BalancedPrefetch256<TileM>(gw, b1[p], false, l1Free[p], l1Ready[p],
					    firstInfo & 65535U, (firstInfo >> 31) & 4095U,
					    firstRows, 256, (firstInfo >> 16) & 127U, K, N, p);
		    l1Used[p] = true;
		}
	    }
	}
	int count = 0;
	int local = 0;
	for (;; ++local)
	{
	    uint64_t info = firstInfo;
	    const bool futureValid = local == 0 ? firstValid : NextIndependentShortTask<TileM, 256, K <= 512>(
		groups, groupInput, cachedGroups, M, N, E, blockNum, cursorExpert, cursorBegin,
		cursorEnd, cursorNext, cursorMt, cursorLoaded, reverse, blockIdx, info);
	    if (futureValid)
		++count;
	    const int row = info & 65535U, e = (info >> 16) & 127U, rows = (info >> 23) & 255U,
		      col = (info >> 31) & 4095U;
	    constexpr int cols = 256;
	    const int pitch = (cols + 31) / 32 * 32;
	    const int slot = (int)(local & 1);
	    const uint16_t tileFlag = slot ? FLAG_TILE1 : FLAG_TILE0;
	    const uint16_t freeFlag = slot ? FLAG_FREE1 : FLAG_FREE0;
	    auto gcSlot = gc[(int64_t)(blockIdx * SLOTS + slot) * tm * tn];

	    if ASCEND_IS_AIC
	    {
		const uint64_t futureInfo = info;
		if (hasPending)
		{
		    if (futureValid)
		    {
			const int aSlot = local & 1;
			if (aUsed[aSlot])
			    WaitFlag<HardEvent::MTE1_MTE2>(aFree[aSlot]);
			BalancedPrefetchA<TileM>(gx, aFull[aSlot], row, rows, K);
			aUsed[aSlot] = true;
			if constexpr (K <= 512)
			{
			    for (int step = 0; step < K / 256; ++step)
			    {
				const int p = (step + panelPhase) & (K / 256 - 1);
				const int futureSlot = (local * (K / 256) + p) & 3;
				BalancedPrefetch256<TileM>(
				    gw, b1[futureSlot], l1Used[futureSlot], l1Free[futureSlot],
				    l1Ready[futureSlot], row, col, rows, cols, e, K, N, p);
				l1Used[futureSlot] = true;
			    }
			}
		    }

		    const int productOrdinal = producerOrdinal;
		    const int local = productOrdinal;
		    const int row = pendingInfo & 65535U;
		    const int e = (pendingInfo >> 16) & 127U;
		    const int rows = (pendingInfo >> 23) & 255U;
		    const int col = (pendingInfo >> 31) & 4095U;
		    constexpr int cols = 256;
		    const int slot = int(local & 1);
		    const uint16_t tileFlag = slot ? FLAG_TILE1 : FLAG_TILE0;
		    const uint16_t freeFlag = slot ? FLAG_FREE1 : FLAG_FREE0;
		    auto gcSlot = gc[int64_t(blockIdx * SLOTS + slot) * tm * tn];
		    const int panels = K / 256;
		    LocalTensor<int32_t> acc(TPosition::CO1, 0, tm * tn);

		    int fragment = 0;
		    for (int step = 0; step < panels; ++step)
		    {
			const int panel = (step + panelPhase) & (panels - 1);
			const int slot1 = K <= 512 ? (productOrdinal * (K / 256) + panel) & 3 : panel;
			WaitFlag<HardEvent::MTE2_MTE1>(l1Ready[slot1]);
#pragma unroll
			for (int sub = 0; sub < 4; ++sub)
			{
			    const int slot0 = fragment & 3;
			    if (l0Used[slot0])
				WaitFlag<HardEvent::M_MTE1>(l0Free[slot0]);
			    LoadData2dParams la;
			    la.repeatTimes = (rows + 15) / 16;
			    la.srcStride = 1;
			    la.dstGap = 1;
			    la.ifTranspose = false;
			    LoadData2dTransposeParams lb{
				0, uint8_t(cols / 32), uint16_t(256 / 32), 1, 0, 0};
#pragma unroll
			    for (int ki = 0; ki < 2; ++ki)
			    {
				LoadData(a2[slot0][ki * 512], aFull[productOrdinal & 1][(panel * 256 + (sub * 2 + ki) * 32) * (rows <= 64 ? 64 : tm)],
					 la);
				LoadDataWithTranspose(b2[slot0][ki * cols * 32],
						      b1[slot1][(sub * 2 + ki) * 1024], lb);
			    }
			    SetFlag<HardEvent::MTE1_M>(l0Ready[slot0]);
			    WaitFlag<HardEvent::MTE1_M>(l0Ready[slot0]);
			    if (fragment == 0 && local > 0)
				WaitFlag<HardEvent::FIX_M>(accumulatorFree);
			    MmadParams mad;
			    mad.m = (rows + 15) / 16 * 16;
			    mad.n = cols;
			    mad.k = 64;
			    mad.cmatrixInitVal = fragment == 0;
			    Mmad(acc, a2[slot0], b2[slot0], mad);

			    if ((mad.m / 16) * (mad.n / 16) < 10)
				PipeBarrier<PIPE_M>();
			    SetFlag<HardEvent::M_MTE1>(l0Free[slot0]);
			    l0Used[slot0] = true;
			    ++fragment;
			}
			SetFlag<HardEvent::MTE1_MTE2>(l1Free[slot1]);
			if constexpr (K == 1024)
			{
			    if (futureValid)
				BalancedPrefetch256<TileM>(
				    gw, b1[slot1], true, l1Free[slot1], l1Ready[slot1],
				    futureInfo & 65535U, (futureInfo >> 31) & 4095U,
				    (futureInfo >> 23) & 255U, cols,
				    (futureInfo >> 16) & 127U, K, N, panel);
			}

		    }
		    SetFlag<HardEvent::MTE1_MTE2>(aFree[productOrdinal & 1]);
		    SetFlag<HardEvent::M_FIX>(matrixReady);
		    WaitFlag<HardEvent::M_FIX>(matrixReady);

		    if (local >= SLOTS)
			CrossCoreWaitFlag<2, PIPE_FIX>(freeFlag);
		    FixpipeParamsV220 fix;
		    fix.nSize = 256;
		    fix.mSize = (rows + 15) / 16 * 16;
		    fix.srcStride = (rows + 15) / 16 * 16;
		    fix.dstStride = 256;
		    Fixpipe<int32_t, int32_t, CFG_ROW_MAJOR>(gcSlot, acc, fix);
		    SetFlag<HardEvent::FIX_M>(accumulatorFree);
		    CrossCoreSetFlag<2, PIPE_FIX>(tileFlag);
		}
		if (futureValid)
		{
		    pendingInfo = futureInfo;
		    producerOrdinal = local;
		    hasPending = true;
		}
		else
		    hasPending = false;
	    }
	    if ASCEND_IS_AIV
	    {
		if (vectorPending)
		{
		    auto c = cq.DeQue<int32_t>();
		    ShortPackedEpilogue<TileM, 256>(c, zb.Get<float>()[192], gy, vectorPendingInfo, lane, N, oq);
		    cq.FreeTensor(c);
		}
		if (futureValid)
		{
		    CrossCoreWaitFlag<2, PIPE_MTE2>(tileFlag);
		    const int halfRows = (rows + 1) / 2;
		    const int rowOffset = lane * halfRows;
		    const int vectorRows = lane ? rows - halfRows : halfRows;
		    auto c = cq.AllocTensor<int32_t>();
		    auto scale =
			c.ReinterpretCast<float>()[((rows + 1) / 2 * tn) + (rows * tn > 16384 ? 64 : 0)];

		    if (pitch != (cols + 7) / 8 * 8)
		    {
			Duplicate(c, int32_t(0), vectorRows * pitch);
			auto event = pipe.FetchEventID<HardEvent::V_MTE2>();
			SetFlag<HardEvent::V_MTE2>(event);
			WaitFlag<HardEvent::V_MTE2>(event);
		    }

		    if (vectorRows > 0)
			for (int segment = 0; segment < cols / 256; ++segment)
			    DataCopyPad(c[segment * ((tm + 1) / 2) * 256],
					gcSlot[segment * tm * 256 + int64_t(rowOffset) * 256],
					{1, uint32_t(vectorRows * 256 * 4), 0, 0, 0},
					{true, 0, 0, 0});
		    DataCopyPad(scale, gs[(int64_t)e * N + col],
				{1, (uint32_t)(cols * sizeof(float)), 0, 0, 0}, {true, 0, 0, 0.0f});
		    cq.EnQue(c);
		    CrossCoreSetFlag<2, PIPE_MTE2>(freeFlag);

		    vectorPendingInfo = info;
		    vectorPending = true;
		}
		else
		    vectorPending = false;
	    }
	    if (!futureValid)
		break;
	}

	local = count;
	if ASCEND_IS_AIV
	{

	    PipeBarrier<PIPE_ALL>();
	}
	if ASCEND_IS_AIC
	{


	    if (local > 0)
		CrossCoreWaitFlag<2, PIPE_MTE2>(FLAG_FREE0);
	    if (local > 1)
		CrossCoreWaitFlag<2, PIPE_MTE2>(FLAG_FREE1);
	    if (local > 0)
		WaitFlag<HardEvent::FIX_M>(accumulatorFree);
#pragma unroll
	    for (int i = 0; i < 4; ++i)
	    {
		if (l1Used[i])
		    WaitFlag<HardEvent::MTE1_MTE2>(l1Free[i]);
		pipe.ReleaseEventID<HardEvent::MTE1_MTE2>(l1Free[i]);
		pipe.ReleaseEventID<HardEvent::MTE2_MTE1>(l1Ready[i]);
	    }
#pragma unroll
	    for (int i = 0; i < 4; ++i)
	    {
		if (l0Used[i])
		    WaitFlag<HardEvent::M_MTE1>(l0Free[i]);
		pipe.ReleaseEventID<HardEvent::M_MTE1>(l0Free[i]);
		pipe.ReleaseEventID<HardEvent::MTE1_M>(l0Ready[i]);
	    }
#pragma unroll
	    for (int i = 0; i < 2; ++i)
	    {
		if (aUsed[i])
		    WaitFlag<HardEvent::MTE1_MTE2>(aFree[i]);
		pipe.ReleaseEventID<HardEvent::MTE1_MTE2>(aFree[i]);
	    }
	    pipe.ReleaseEventID<HardEvent::FIX_M>(accumulatorFree);
	    pipe.ReleaseEventID<HardEvent::M_FIX>(matrixReady);
	}
    }

template <int TN>
__global__ __mix__(1, 2) void CompactAligned(GM_ADDR x, GM_ADDR w, GM_ADDR sc, GM_ADDR y,
						  GM_ADDR workspace, int M, int K, int N)
{
    using namespace AscendC;
    constexpr int TM = 16;
    constexpr int maxK = 256;
    const int index = GetBlockIdx();
    int tile = index;
    if ASCEND_IS_AIV
	tile /= 2;
    const int nt = (N + TN - 1) / TN;
    const int row = (tile / nt) * TM;
    const int col = (tile % nt) * TN;
    const int rows = M - row < TM ? M - row : TM;
    const int cols = N - col < TN ? N - col : TN;
    GlobalTensor<int32_t> gc;
    gc.SetGlobalBuffer((__gm__ int32_t *)workspace + tile * TM * TN);

    if ASCEND_IS_AIC
    {
	GlobalTensor<int8_t> gx, gw;
	gx.SetGlobalBuffer((__gm__ int8_t *)x);
	gw.SetGlobalBuffer((__gm__ int8_t *)w);
	LocalTensor<int8_t> a1(TPosition::A1, 0, TM * maxK);
	LocalTensor<int8_t> b1(TPosition::B1, TM * maxK, TN * maxK);
	LocalTensor<int8_t> a2(TPosition::A2, 0, TM * maxK);
	LocalTensor<int8_t> b2(TPosition::B2, 0, TN * maxK);
	LocalTensor<int32_t> c(TPosition::CO1, 0, TM * TN);
	Nd2NzParams ap{};
	ap.ndNum = 1;
	ap.nValue = rows;
	ap.dValue = K;
	ap.srcDValue = K;
	ap.dstNzC0Stride = TM;
	ap.dstNzNStride = 1;
	Nd2NzParams bp{};
	bp.ndNum = 1;
	bp.nValue = K;
	bp.dValue = cols;
	bp.srcDValue = N;
	bp.dstNzC0Stride = K;
	bp.dstNzNStride = 1;
	DataCopy(b1, gw[col], bp);
	DataCopy(a1, gx[row * K], ap);
	SetFlag<HardEvent::MTE2_MTE1>(0);
	WaitFlag<HardEvent::MTE2_MTE1>(0);
	LoadData2dParams la;
	la.repeatTimes = K / 32;
	la.srcStride = 1;
	la.ifTranspose = false;
	LoadData(a2, a1, la);
	const LoadData2dTransposeParams lb{0, uint8_t(cols / 32), uint16_t(K / 32), 1, 0, 0};
	for (int ki = 0; ki < K / 32; ++ki)
	    LoadDataWithTranspose(b2[ki * cols * 32], b1[ki * 1024], lb);
	SetFlag<HardEvent::MTE1_M>(0);
	WaitFlag<HardEvent::MTE1_M>(0);
	MmadParams mad;
	mad.m = TM;
	mad.n = cols;
	mad.k = K;
	mad.cmatrixInitVal = true;
	Mmad(c, a2, b2, mad);
	if (cols / 16 < 10)
	    PipeBarrier<PIPE_M>();
	SetFlag<HardEvent::M_FIX>(0);
	WaitFlag<HardEvent::M_FIX>(0);
	FixpipeParamsV220 fix;
	fix.mSize = TM;
	fix.nSize = cols;
	fix.srcStride = TM;
	fix.dstStride = cols;
	Fixpipe<int32_t, int32_t, CFG_ROW_MAJOR>(gc, c, fix);
	CrossCoreSetFlag<2, PIPE_FIX>(FLAG_TILE0);
    }
    if ASCEND_IS_AIV
    {
	constexpr int elements = TM / 2 * TN;
	const int halfRows = (rows + 1) / 2;
	const int offset = (index & 1) * halfRows;
	const int valid = index & 1 ? rows - halfRows : halfRows;
	if (valid == 0)
	{
	    CrossCoreWaitFlag<2, PIPE_MTE2>(FLAG_TILE0);
	}
	else
	{
	    LocalTensor<float> scale(TPosition::VECCALC, 0, TN);
	    LocalTensor<int32_t> c(TPosition::VECCALC, TN * 4, elements);
	    LocalTensor<float> z(TPosition::VECCALC, (TN + elements) * 4, elements);
	    LocalTensor<float> p(TPosition::VECCALC, (TN + 2 * elements) * 4, elements);
	    GlobalTensor<float> gs;
	    GlobalTensor<half> gy;
	    gs.SetGlobalBuffer((__gm__ float *)sc);
	    gy.SetGlobalBuffer((__gm__ half *)y);
	    DataCopyPad(scale, gs[col], {1, uint32_t(cols * 4), 0, 0, 0},
			{false, 0, 0, 0.0f});
	    CrossCoreWaitFlag<2, PIPE_MTE2>(FLAG_TILE0);
	    DataCopyPad(c, gc[offset * cols], {1, uint32_t(valid * cols * 4), 0, 0, 0},
			{false, 0, 0, int32_t(0)});
	    SetFlag<HardEvent::MTE2_V>(0);
	    WaitFlag<HardEvent::MTE2_V>(0);
	    const int count = valid * cols;
	    Cast(z, c, RoundMode::CAST_NONE, count);
	    PipeBarrier<PIPE_V>();
	    const BinaryRepeatParams broadcast{1, 1, 1, uint8_t(cols / 8), uint8_t(cols / 8), 0};
	    for (int part = 0; part < cols; part += 64)
		Mul(z[part], z[part], scale[part], uint64_t(cols - part < 64 ? cols - part : 64),
		    uint8_t(valid), broadcast);
	    PipeBarrier<PIPE_V>();
	    GeluTanh(z, p, p, p, count);
	    auto out = c.ReinterpretCast<half>();
	    Cast(out, z, RoundMode::CAST_RINT, count);
	    SetFlag<HardEvent::V_MTE3>(0);
	    WaitFlag<HardEvent::V_MTE3>(0);
	    DataCopyPad(gy[(row + offset) * N + col], out,
			{uint16_t(valid), uint32_t(cols * 2), 0, uint32_t((N - cols) * 2), 0});
	}
    }
    PipeBarrier<PIPE_ALL>();
}

__aicore__ inline void ResidentGelu(LocalTensor<float> z,LocalTensor<float> p,uint32_t count)
{
    const BinaryRepeatParams bp{1,1,1,8,8,8};
    const UnaryRepeatParams up{1,1,8,8};
    SetMaskNorm();
    const uint32_t full=count/64*64;
    for(int tail=0;tail<2;++tail) {
	const uint32_t active=tail?count-full:full;
	if(!active)continue;
	const uint32_t offset=tail?full:0;
	const uint64_t mask=tail?active:64;
	const uint8_t repeat=tail?1:full/64;
	auto zz=z[offset],pp=p[offset];
	Mul(pp,zz,zz,mask,repeat,bp);PipeBarrier<PIPE_V>();
	Muls(pp,pp,-2.0f*GELU_C1,mask,repeat,up);PipeBarrier<PIPE_V>();
	Adds(pp,pp,-2.0f*GELU_C0,mask,repeat,up);PipeBarrier<PIPE_V>();
	Mul(pp,zz,pp,mask,repeat,bp);PipeBarrier<PIPE_V>();
	Exp(pp,pp,mask,repeat,up);PipeBarrier<PIPE_V>();
	Adds(pp,pp,1.0f,mask,repeat,up);PipeBarrier<PIPE_V>();
	Div(zz,zz,pp,mask,repeat,bp);PipeBarrier<PIPE_V>();
    }
}

template<int TM,int TN,int Fold>
__aicore__ inline void ResidentLoadB(LocalTensor<int8_t> b,GlobalTensor<int8_t> w,
    int e,int col,int cols,int K,int N,int KCap)
{
    const int pn=(cols+31)/32*32;
    if(K<KCap) {
	Fill(b[K*32].template ReinterpretCast<uint32_t>(),
	     InitConstValueParams<uint32_t>(pn/32,KCap-K,K,0));
	PipeBarrier<PIPE_MTE2>();
    }
    Nd2NzParams p;
    p.dValue=cols;p.dstNzC0Stride=KCap;
    const int bulk=K/Fold*Fold;
    if(bulk) {
	p.ndNum=Fold;p.nValue=bulk/Fold;p.srcNdMatrixStride=N;
	p.srcDValue=Fold*N;p.dstNzNStride=Fold;p.dstNzMatrixStride=32;
	DataCopy(b,w[int64_t(e)*K*N+col],p);
    }
    if(bulk<K) {
	p.ndNum=1;p.nValue=K-bulk;p.srcNdMatrixStride=0;
	p.srcDValue=N;p.dstNzNStride=1;p.dstNzMatrixStride=0;
	DataCopy(b[bulk*32],w[int64_t(e)*K*N+int64_t(bulk)*N+col],p);
    }
}

template<int TM>
__aicore__ inline void ResidentLoadA(LocalTensor<int8_t> a,GlobalTensor<int8_t> x,
    int row,int rows,int K,bool reused,uint8_t freeId,uint8_t readyId,int KCap)
{
    if(reused)WaitFlag<HardEvent::MTE1_MTE2>(freeId);
    if(K<KCap) {
	Fill(a[(K/32)*TM*32].template ReinterpretCast<uint32_t>(),
	    InitConstValueParams<uint32_t>(1,TM*(KCap-K/32*32)/32,0,0));
	PipeBarrier<PIPE_MTE2>();
    }
    Nd2NzParams p;
    p.ndNum=1;p.nValue=rows;p.dValue=K;p.srcNdMatrixStride=0;
    p.srcDValue=K;p.dstNzC0Stride=TM;p.dstNzNStride=1;p.dstNzMatrixStride=0;
    DataCopy(a,x[int64_t(row)*K],p);
    // Readiness is signalled after the following B load.
}

template<int TileM,int TileN,int GroupM,int Fold>
__aicore__ __attribute__((always_inline)) inline void
ComputeTransportResident(GM_ADDR x,GM_ADDR w,GM_ADDR sc,GM_ADDR groups,GM_ADDR y,GM_ADDR workspace,
    int M,int K,int N,int E)
{
    const int KCap=(K+63)/64*64;
    TPipe pipe;
    GlobalTensor<int8_t> gx,gw;
    GlobalTensor<float> gs;
    GlobalTensor<int32_t> gc;
    GlobalTensor<half> gy;
    gx.SetGlobalBuffer((__gm__ int8_t*)x);gw.SetGlobalBuffer((__gm__ int8_t*)w);
    gs.SetGlobalBuffer((__gm__ float*)sc);gc.SetGlobalBuffer((__gm__ int32_t*)workspace);
    gy.SetGlobalBuffer((__gm__ half*)y);
    constexpr int tm=TileM,tn=TileN,capacity=8192,vr=capacity/tn,ve=(vr*tn+63)/64*64;
    TBuf<TPosition::A1> a1Buffer[2];
    TBuf<TPosition::B1> b1Buffer[2];
    TBuf<TPosition::A2> a2Buffer;
    TBuf<TPosition::B2> b2Buffer;
    TBuf<TPosition::CO1> accBuffer;
    LocalTensor<int8_t> a1[2],b1[2],a2[4],b2[4];
    uint8_t l1Free[2],l1Ready[2],l0Free[4],l0Ready[4];
    uint8_t accumulatorFree=0,matrixReady=0,bFree[2],bReady[2];
    bool l1Used[2]={},l0Used[4]={},bUsed[2]={};
    if ASCEND_IS_AIC {
	pipe.InitBuffer(a1Buffer[0],tm*KCap);
	for(int i=0;i<2;++i) {
	    pipe.InitBuffer(b1Buffer[i],tn*KCap);
	    b1[i]=b1Buffer[i].Get<int8_t>();
	    bFree[i]=pipe.AllocEventID<HardEvent::MTE1_MTE2>();
	    bReady[i]=pipe.AllocEventID<HardEvent::MTE2_MTE1>();
	}
#pragma unroll
	for(int i=0;i<1;++i) {
	    a1[i]=a1Buffer[i].Get<int8_t>();
	    l1Free[i]=pipe.AllocEventID<HardEvent::MTE1_MTE2>();
	    l1Ready[i]=pipe.AllocEventID<HardEvent::MTE2_MTE1>();
	}
	pipe.InitBuffer(a2Buffer,4*tm*64);pipe.InitBuffer(b2Buffer,4*tn*64);
#pragma unroll
	for(int i=0;i<4;++i) {
	    a2[i]=a2Buffer.Get<int8_t>()[i*tm*64];b2[i]=b2Buffer.Get<int8_t>()[i*tn*64];
	    l0Free[i]=pipe.AllocEventID<HardEvent::M_MTE1>();
	    l0Ready[i]=pipe.AllocEventID<HardEvent::MTE1_M>();
	}
	pipe.InitBuffer(accBuffer,tm*tn*4);
	accumulatorFree=pipe.AllocEventID<HardEvent::FIX_M>();
	matrixReady=pipe.AllocEventID<HardEvent::M_FIX>();
    }
    TQue<TPosition::VECIN,1> cq;
    TQue<TPosition::VECOUT,1> oq;
    TBuf<TPosition::VECCALC> zb,pb,groupCache;
    if ASCEND_IS_AIV {
	pipe.InitBuffer(cq,1,uint32_t((tm/2*tn+tn)*4)+(tm*tn>16384?256:0));
	pipe.InitBuffer(oq,1,ve*2);pipe.InitBuffer(zb,ve*4);
	pipe.InitBuffer(groupCache,(E*8+31)/32*32);
	GlobalTensor<int64_t> gg;gg.SetGlobalBuffer((__gm__ int64_t*)groups);
	DataCopyPad(groupCache.Get<int64_t>(),gg,{1,uint32_t(E*8),0,0,0},{true,0,0,int64_t(0)});
	auto ready=pipe.FetchEventID<HardEvent::MTE2_S>();
	SetFlag<HardEvent::MTE2_S>(ready);WaitFlag<HardEvent::MTE2_S>(ready);
    }
    int blockIdx=int(GetBlockIdx()),lane=0;
    if ASCEND_IS_AIV {lane=blockIdx&1;blockIdx/=2;}
    const int blockNum=int(GetBlockNum());
    const int nc=(N+tn-1)/tn;
    const int avgStride=N/nc/32*32;
    const int strideN=N-(nc-1)*avgStride>tn?avgStride+32:avgStride;
    int64_t totalTasks=0;
    int previous=0;
    for(int expert=0;expert<E;++expert) {
	int last=0;
	if ASCEND_IS_AIC {last=int(((__gm__ int64_t*)groups)[expert]);}
	if ASCEND_IS_AIV {last=int(groupCache.Get<int64_t>().GetValue(expert));}
	if(last<previous)last=previous;if(last>M)last=M;
	totalTasks+=int64_t((last-previous+tm-1)/tm)*nc;
	previous=last;
    }
    const int64_t ownedBegin=totalTasks*blockIdx/blockNum;
    const int64_t ownedEnd=totalTasks*(blockIdx+1)/blockNum;
    int64_t taskOffset=0;
    int local=0,begin=0;
    for(int e=0;e<E;++e) {
	int end=0;
	if ASCEND_IS_AIC {end=int(((__gm__ int64_t*)groups)[e]);}
	if ASCEND_IS_AIV {end=int(groupCache.Get<int64_t>().GetValue(e));}
	if(end<begin)end=begin;if(end>M)end=M;
	const int me=end-begin,mt=(me+tm-1)/tm;
	const int64_t tasks=int64_t(mt)*nc;
	const int64_t first=ownedBegin>taskOffset?ownedBegin-taskOffset:0;
	const int64_t limit=ownedEnd-taskOffset<tasks?ownedEnd-taskOffset:tasks;
	for(int64_t task=first;task<limit;) {
	    const int mi=task/nc,niStart=task%nc;
	    const int row=begin+mi*tm,rows=end-row<tm?end-row:tm;
	    const int tiles=nc-niStart<limit-task?nc-niStart:int(limit-task);
	    if ASCEND_IS_AIC {
		ResidentLoadA<tm>(a1[0],gx,row,rows,K,l1Used[0],l1Free[0],l1Ready[0],KCap);
		l1Used[0]=true;
		const int bs=local&1, col=niStart*strideN;
		const int cols=niStart+1==nc?N-col:strideN;
		if(bUsed[bs])WaitFlag<HardEvent::MTE1_MTE2>(bFree[bs]);
		ResidentLoadB<tm,tn,Fold>(b1[bs],gw,e,col,cols,K,N,KCap);
		bUsed[bs]=true;
		SetFlag<HardEvent::MTE2_MTE1>(bReady[bs]);
	    }
	    for(int tile=0;tile<tiles;++tile) {
		const int ni=niStart+tile,col=ni*strideN;
		const int cols=ni+1==nc?N-col:strideN,pitch=(cols+31)/32*32;
		const int slot=local&1;
		const uint16_t tileFlag=slot?FLAG_TILE1:FLAG_TILE0;
		const uint16_t freeFlag=slot?FLAG_FREE1:FLAG_FREE0;
		auto gcSlot=gc[int64_t(blockIdx*SLOTS+slot)*tm*tn];
		if ASCEND_IS_AIC {
		    const int as=0;
		    const int bs=local&1;
		    WaitFlag<HardEvent::MTE2_MTE1>(bReady[bs]);
		    if(tile+1<tiles) {
			const int next=bs^1,nextCol=(ni+1)*strideN;
			const int nextCols=ni+2==nc?N-nextCol:strideN;
			if(bUsed[next])WaitFlag<HardEvent::MTE1_MTE2>(bFree[next]);
			ResidentLoadB<tm,tn,Fold>(b1[next],gw,e,nextCol,nextCols,K,N,KCap);
			bUsed[next]=true;
			SetFlag<HardEvent::MTE2_MTE1>(bReady[next]);
		    }
		    auto acc=accBuffer.Get<int32_t>();
		    for(int sub=0;sub<(K+63)/64;++sub) {
			const int ls=sub&3;
			if(l0Used[ls])WaitFlag<HardEvent::M_MTE1>(l0Free[ls]);
			LoadData2dParams la;la.repeatTimes=(rows+15)/16;la.srcStride=1;la.dstGap=1;la.ifTranspose=false;
			LoadData2dTransposeParams lb{0,uint8_t(pitch/32),uint16_t(KCap/32),1,0,0};
#pragma unroll
			for(int ki=0;ki<2;++ki) {
			    LoadData(a2[ls][ki*512],a1[as][(sub*2+ki)*tm*32],la);
			    LoadDataWithTranspose(b2[ls][ki*pitch*32],b1[bs][(sub*2+ki)*1024],lb);
			}
			SetFlag<HardEvent::MTE1_M>(l0Ready[ls]);WaitFlag<HardEvent::MTE1_M>(l0Ready[ls]);
			if(!sub && local)WaitFlag<HardEvent::FIX_M>(accumulatorFree);
			MmadParams mad;mad.m=(rows+15)/16*16;mad.n=pitch;mad.k=64;mad.cmatrixInitVal=sub==0;
			Mmad(acc,a2[ls],b2[ls],mad);
			if((mad.m/16)*(mad.n/16)<10)PipeBarrier<PIPE_M>();
			SetFlag<HardEvent::M_MTE1>(l0Free[ls]);l0Used[ls]=true;
		    }
		    SetFlag<HardEvent::MTE1_MTE2>(bFree[bs]);
		    SetFlag<HardEvent::M_FIX>(matrixReady);WaitFlag<HardEvent::M_FIX>(matrixReady);
		    if(local>=SLOTS)CrossCoreWaitFlag<2,PIPE_FIX>(freeFlag);
		    FixpipeParamsV220 fix;fix.nSize=pitch;fix.mSize=(rows+15)/16*16;fix.srcStride=fix.mSize;fix.dstStride=tn;
		    Fixpipe<int32_t,int32_t,CFG_ROW_MAJOR>(gcSlot,acc,fix);
		    SetFlag<HardEvent::FIX_M>(accumulatorFree);
		    CrossCoreSetFlag<2,PIPE_FIX>(tileFlag);
		}
					if ASCEND_IS_AIV
			{
			    CrossCoreWaitFlag<2, PIPE_MTE2>(tileFlag);
			    const int halfRows = (rows + 1) / 2;
			    const int rowOffset = lane * halfRows;
			    const int vectorRows = lane ? rows - halfRows : halfRows;
			    auto c = cq.AllocTensor<int32_t>();
			    auto scale = c.ReinterpretCast<float>()[((tm + 1) / 2 * tn) +
								    (tm * tn > 16384 ? 64 : 0)];

			    if (pitch != (cols + 7) / 8 * 8)
			    {
				Duplicate(c, int32_t(0), vectorRows * pitch);
				auto event = pipe.FetchEventID<HardEvent::V_MTE2>();
				SetFlag<HardEvent::V_MTE2>(event);
				WaitFlag<HardEvent::V_MTE2>(event);
			    }

			    if (vectorRows > 0)
				DataCopyPad(c, gcSlot[int64_t(rowOffset) * tn],
					    {uint16_t(vectorRows), uint32_t(cols * sizeof(int32_t)),
					     uint32_t((tn - cols) * sizeof(int32_t)),
					     uint32_t((pitch * 4 - (cols * 4 + 31) / 32 * 32) / 32),
					     0},
					    {true, 0, 0, 0});
			    if (cols < 64)
			    {
				Duplicate(scale, 0.0f, tn);
				auto initialized = pipe.FetchEventID<HardEvent::V_MTE2>();
				SetFlag<HardEvent::V_MTE2>(initialized);
				WaitFlag<HardEvent::V_MTE2>(initialized);
			    }
			    DataCopyPad(scale, gs[(int64_t)e * N + col],
					{1, (uint32_t)(cols * sizeof(float)), 0, 0, 0},
					{true, 0, 0, 0.0f});
			    cq.EnQue(c);
			    c = cq.DeQue<int32_t>();

			    CrossCoreSetFlag<2, PIPE_MTE2>(freeFlag);

			    auto z = zb.Get<float>();
			    auto p = c.ReinterpretCast<float>();
			    auto u = p;
			    auto t = p;

			    const BinaryRepeatParams bcast{
				1, 1, 1, (uint8_t)(pitch / 8), (uint8_t)(pitch / 8), 0};
			    for (int r = 0; r < vectorRows; r += vr)
			    {
				const int batch = (vectorRows - r < vr) ? (vectorRows - r) : vr;
				const uint32_t count = (uint32_t)batch * pitch;
				Cast(z, c[r * pitch], RoundMode::CAST_NONE, count);
				PipeBarrier<PIPE_V>();
				if (cols < 64)
				{
				    Mul(z, z, scale, (uint64_t)(pitch < 64 ? pitch : 64),
					(uint8_t)batch, bcast);
				}
				else
				{
				    for (int c0 = 0; c0 < cols; c0 += 64)
				    {
					const int chunk = (cols - c0 < 64) ? (cols - c0) : 64;
					Mul(z[c0], z[c0], scale[c0], (uint64_t)chunk,
					    (uint8_t)batch, bcast);
				    }
				}
				PipeBarrier<PIPE_V>();

				p = c[r * pitch].ReinterpretCast<float>();
				u = p;
				ResidentGelu(z,p,count);
				auto out = oq.AllocTensor<half>();
				Cast(out, z, RoundMode::CAST_RINT, count);
				oq.EnQue(out);
				out = oq.DeQue<half>();
				const uint32_t outBytes = (uint32_t)cols * (uint32_t)sizeof(half);
				const uint32_t outPitchBytes =
				    (uint32_t)pitch * (uint32_t)sizeof(half);
				const uint32_t outSrcStride =
				    (outPitchBytes - ((outBytes + 31U) / 32U) * 32U) / 32U;
				for (int r0 = 0; r0 < batch; r0 += 32)
				{
				    const int rc = batch - r0 < 32 ? batch - r0 : 32;
				    DataCopyPad(gy[(int64_t)(row + rowOffset + r + r0) * N + col],
						out[r0 * pitch],
						{(uint16_t)rc, outBytes, outSrcStride,
						 (uint32_t)((N - cols) * sizeof(half)), 0});
				}
				oq.FreeTensor(out);
			    }
			    cq.FreeTensor(c);
			}

		++local;
	    }
	    if ASCEND_IS_AIC {SetFlag<HardEvent::MTE1_MTE2>(l1Free[0]);}
	    task+=tiles;
	}
	taskOffset+=tasks;begin=end;
    }
    if ASCEND_IS_AIV {PipeBarrier<PIPE_ALL>();}
    if ASCEND_IS_AIC {
	if(local>0)CrossCoreWaitFlag<2,PIPE_MTE2>(FLAG_FREE0);
	if(local>1)CrossCoreWaitFlag<2,PIPE_MTE2>(FLAG_FREE1);
	if(local>0)WaitFlag<HardEvent::FIX_M>(accumulatorFree);
	for(int i=0;i<2;++i) {
	    if(bUsed[i])WaitFlag<HardEvent::MTE1_MTE2>(bFree[i]);
	    pipe.ReleaseEventID<HardEvent::MTE1_MTE2>(bFree[i]);
	    pipe.ReleaseEventID<HardEvent::MTE2_MTE1>(bReady[i]);
	}
#pragma unroll
	for(int i=0;i<1;++i) {
	    if(l1Used[i])WaitFlag<HardEvent::MTE1_MTE2>(l1Free[i]);
	    pipe.ReleaseEventID<HardEvent::MTE1_MTE2>(l1Free[i]);
	    pipe.ReleaseEventID<HardEvent::MTE2_MTE1>(l1Ready[i]);
	}
#pragma unroll
	for(int i=0;i<4;++i) {
	    if(l0Used[i])WaitFlag<HardEvent::M_MTE1>(l0Free[i]);
	    pipe.ReleaseEventID<HardEvent::M_MTE1>(l0Free[i]);
	    pipe.ReleaseEventID<HardEvent::MTE1_M>(l0Ready[i]);
	}
	pipe.ReleaseEventID<HardEvent::FIX_M>(accumulatorFree);
	pipe.ReleaseEventID<HardEvent::M_FIX>(matrixReady);
    }
}

    __aicore__ inline void WeightPackedGeluTanh(LocalTensor<float> z, LocalTensor<float> p,
				    LocalTensor<float> u, LocalTensor<float> t, uint32_t count)
    {

	const BinaryRepeatParams binary{1, 1, 1, 8, 8, 8};
	const UnaryRepeatParams unary{1, 1, 8, 8};
	SetMaskCount();
	SetVectorMask<float, MaskMode::COUNTER>(0, count);
	Mul<float, false>(p, z, z, uint64_t(64), 1, binary);
	PipeBarrier<PIPE_V>();
	Muls<float, false>(u, p, -2.0f * GELU_C1, uint64_t(64), 1, unary);
	PipeBarrier<PIPE_V>();
	Adds<float, false>(p, u, -2.0f * GELU_C0, uint64_t(64), 1, unary);
	PipeBarrier<PIPE_V>();
	Mul<float, false>(u, z, p, uint64_t(64), 1, binary);
	PipeBarrier<PIPE_V>();
	Exp<float, false>(p, u, uint64_t(64), 1, unary);
	PipeBarrier<PIPE_V>();
	Adds<float, false>(p, p, 1.0f, uint64_t(64), 1, unary);
	PipeBarrier<PIPE_V>();
	Div<float, false>(z, z, p, uint64_t(64), 1, binary);
	PipeBarrier<PIPE_V>();
	SetMaskNorm();
	ResetMask();
    }

template<int CopyRows>
__aicore__ inline void WeightPackedPreloadNZChunk(TPipe& pipe,LocalTensor<int8_t> ub,GlobalTensor<int8_t> gw,
    int task,int K,int N,bool reused,uint8_t freeId,uint8_t readyId)
{
    if(reused)WaitFlag<HardEvent::V_MTE2>(freeId);
    const int kp=(K+63)/64*64,np=(N+31)/32*32,chunks=(kp+CopyRows-1)/CopyRows;
    const int e=task/chunks,row=task%chunks*CopyRows;
    const int rows=kp-row<CopyRows?kp-row:CopyRows,live=K-row<rows?K-row:rows;
    if(live<rows) {
	auto free=pipe.FetchEventID<HardEvent::MTE2_V>();
	SetFlag<HardEvent::MTE2_V>(free);WaitFlag<HardEvent::MTE2_V>(free);
	Duplicate(ub.template ReinterpretCast<int32_t>(),int32_t(0),rows*np/4);
	auto zero=pipe.FetchEventID<HardEvent::V_MTE2>();
	SetFlag<HardEvent::V_MTE2>(zero);WaitFlag<HardEvent::V_MTE2>(zero);
    }
    if(live>0)
	DataCopyPad(ub,gw[int64_t(e)*K*N+int64_t(row)*N],
	    {uint16_t(live),uint32_t(N),0,0,0},{true,0,uint8_t(np-N),int8_t(0)});
    SetFlag<HardEvent::MTE2_V>(readyId);
}

template<int CopyRows,bool PackX>
__aicore__ inline void WeightPackedPrepareTransportNZPipeline(GM_ADDR x,GM_ADDR w,GM_ADDR xp,GM_ADDR wp,
    int M,int K,int N,int E)
{
    if ASCEND_IS_AIV {
	TPipe pipe;
	TBuf<TPosition::VECCALC> input[2],output;
	const int kp=(K+63)/64*64,np=(N+31)/32*32;
	const int bytes=PackX && CopyRows*np<16384?16384:CopyRows*np;
	uint8_t inFree[2],inReady[2];bool used[2]={};
	for(int i=0;i<2;++i) {
	    pipe.InitBuffer(input[i],bytes);
	    inFree[i]=pipe.AllocEventID<HardEvent::V_MTE2>();
	    inReady[i]=pipe.AllocEventID<HardEvent::MTE2_V>();
	}
	pipe.InitBuffer(output,bytes);
	auto packed=output.Get<int8_t>();
	const uint8_t outFree=pipe.AllocEventID<HardEvent::MTE3_V>();
	const uint8_t outReady=pipe.AllocEventID<HardEvent::V_MTE3>();
	GlobalTensor<int8_t> gw,gwp;
	gw.SetGlobalBuffer((__gm__ int8_t*)w);gwp.SetGlobalBuffer((__gm__ int8_t*)wp);
	const int block=GetBlockIdx(),cores=GetBlockNum()*2,chunks=(kp+CopyRows-1)/CopyRows;
	const int tasks=E*chunks;
	for(int i=0;i<2;++i)if(block+i*cores<tasks) {
	    WeightPackedPreloadNZChunk<CopyRows>(pipe,input[i].Get<int8_t>(),gw,block+i*cores,K,N,false,inFree[i],inReady[i]);
	    used[i]=true;
	}
	bool outputUsed=false;
	for(int index=0,task=block;task<tasks;++index,task+=cores) {
	    const int slot=index&1,e=task/chunks,row=task%chunks*CopyRows;
	    const int rows=kp-row<CopyRows?kp-row:CopyRows;
	    auto ub=input[slot].Get<int8_t>();
	    WaitFlag<HardEvent::MTE2_V>(inReady[slot]);
	    if(outputUsed)WaitFlag<HardEvent::MTE3_V>(outFree);
	    for(int c=0;c<np/32;++c)
		DataCopy(packed[c*rows*32],ub[c*32],
		    DataCopyParams{uint16_t(rows),1,uint16_t(np/32-1),0});
	    SetFlag<HardEvent::V_MTE2>(inFree[slot]);
	    SetFlag<HardEvent::V_MTE3>(outReady);WaitFlag<HardEvent::V_MTE3>(outReady);
	    DataCopy(gwp[int64_t(e)*kp*np+row*32],packed,
		DataCopyParams{uint16_t(np/32),uint16_t(rows),0,uint16_t(kp-rows)});
	    SetFlag<HardEvent::MTE3_V>(outFree);outputUsed=true;
	    if(task+2*cores<tasks)
		WeightPackedPreloadNZChunk<CopyRows>(pipe,ub,gw,task+2*cores,K,N,true,inFree[slot],inReady[slot]);
	}
	for(int i=0;i<2;++i) {
	    if(used[i])WaitFlag<HardEvent::V_MTE2>(inFree[i]);
	    pipe.ReleaseEventID<HardEvent::V_MTE2>(inFree[i]);
	    pipe.ReleaseEventID<HardEvent::MTE2_V>(inReady[i]);
	}
	if(outputUsed)WaitFlag<HardEvent::MTE3_V>(outFree);
	pipe.ReleaseEventID<HardEvent::MTE3_V>(outFree);
	pipe.ReleaseEventID<HardEvent::V_MTE3>(outReady);
	if constexpr(PackX) {
	    // X uses [ceil(K/32), ceil(M/16)*16, 32], with aligned column slabs.
	    GlobalTensor<int8_t> gx,gxp;
	    gx.SetGlobalBuffer((__gm__ int8_t*)x);gxp.SetGlobalBuffer((__gm__ int8_t*)xp);
	    const int mp=(M+15)/16*16,kc=(kp+511)/512,mc=(mp+31)/32;
	    auto ub=input[0].Get<int8_t>();
	    bool xUsed=false;
	    for(int task=block;task<mc*kc;task+=cores) {
		const int row=task/kc*32,col=task%kc*512;
		const int rows=mp-row<32?mp-row:32,cols=kp-col<512?kp-col:512;
		const int liveRows=M-row<rows?M-row:rows,liveCols=K-col<cols?K-col:cols;
		if(xUsed) {
		    auto free=pipe.FetchEventID<HardEvent::MTE3_MTE2>();
		    SetFlag<HardEvent::MTE3_MTE2>(free);WaitFlag<HardEvent::MTE3_MTE2>(free);
		}
		if(liveRows<rows || liveCols<cols) {
		    auto free=pipe.FetchEventID<HardEvent::MTE3_V>();
		    SetFlag<HardEvent::MTE3_V>(free);WaitFlag<HardEvent::MTE3_V>(free);
		    Duplicate(ub.ReinterpretCast<int32_t>(),int32_t(0),rows*cols/4);
		    auto zero=pipe.FetchEventID<HardEvent::V_MTE2>();
		    SetFlag<HardEvent::V_MTE2>(zero);WaitFlag<HardEvent::V_MTE2>(zero);
		}
		DataCopyPad(ub,gx[int64_t(row)*K+col],
		    {uint16_t(liveRows),uint32_t(liveCols),uint32_t(K-liveCols),
			uint32_t((cols-(liveCols+31)/32*32)/32),0},
		    {true,0,uint8_t((liveCols+31)/32*32-liveCols),int8_t(0)});
		auto loaded=pipe.FetchEventID<HardEvent::MTE2_V>();
		SetFlag<HardEvent::MTE2_V>(loaded);WaitFlag<HardEvent::MTE2_V>(loaded);
		auto free=pipe.FetchEventID<HardEvent::MTE3_V>();
		SetFlag<HardEvent::MTE3_V>(free);WaitFlag<HardEvent::MTE3_V>(free);
		for(int c=0;c<cols/32;++c)
		    DataCopy(packed[c*rows*32],ub[c*32],
			DataCopyParams{uint16_t(rows),1,uint16_t(cols/32-1),0});
		auto ready=pipe.FetchEventID<HardEvent::V_MTE3>();
		SetFlag<HardEvent::V_MTE3>(ready);WaitFlag<HardEvent::V_MTE3>(ready);
		DataCopy(gxp[int64_t(col)*mp+row*32],packed,
		    DataCopyParams{uint16_t(cols/32),uint16_t(rows),0,uint16_t(mp-rows)});
		xUsed=true;
	    }
	}
	PipeBarrier<PIPE_ALL>();
    }
    SyncAll<false>();
}

    template <int TileM, int PacketK>
    __aicore__ inline void WeightPackedNZPrefetch(GlobalTensor<int8_t> gx, GlobalTensor<int8_t> gw,
						   LocalTensor<int8_t> a1, LocalTensor<int8_t> b1,
						   bool reused, uint8_t freeId, uint8_t readyId,
						   int row, int col, int rows, int cols, int expert,
						   int K, int N, int panel)
    {
	if (reused)
	    WaitFlag<HardEvent::MTE1_MTE2>(freeId);
	const int ck = K - panel * PacketK < PacketK ? K - panel * PacketK : PacketK;
	const int paddedK = (ck + 63) / 64 * 64;
	const int paddedN = (cols + 31) / 32 * 32;
	if (ck % 64)
	{
	    Fill(a1[(ck / 32) * TileM * 32].ReinterpretCast<uint32_t>(),
		 InitConstValueParams<uint32_t>(1, TileM * (paddedK - ck / 32 * 32) / 32, 0, 0));
	    PipeBarrier<PIPE_MTE2>();
	}
	Nd2NzParams ap;
	ap.ndNum = 1;
	ap.nValue = rows;
	ap.dValue = ck;
	ap.srcNdMatrixStride = 0;
	ap.srcDValue = K;
	ap.dstNzC0Stride = TileM;
	ap.dstNzNStride = 1;
	ap.dstNzMatrixStride = 0;
	const int kp=(K+63)/64*64,np=(N+31)/32*32;
	DataCopy(b1,gw[(int64_t(expert)*np+col)*kp+int64_t(panel*PacketK)*32],
	    DataCopyParams{uint16_t(paddedN/32),uint16_t(paddedK),
		uint16_t(kp-paddedK),uint16_t(PacketK-paddedK)});
	DataCopy(a1,gx[int64_t(row)*K+panel*PacketK],ap);
	SetFlag<HardEvent::MTE2_MTE1>(readyId);
    }

    template <int TileM, int TileN, int PacketK, int L0Slots = 4>
    __aicore__ __attribute__((always_inline)) inline void
    WeightPackedComputeTransportNZ(GM_ADDR x, GM_ADDR w, GM_ADDR sc, GM_ADDR groups, GM_ADDR y,
			   GM_ADDR workspace, int M, int K, int N, int E,
			   AscendC::tiling::TCubeTiling tiling, uint32_t l1Half)
    {
	TPipe pipe;
	GlobalTensor<int8_t> gx, gw;
	GlobalTensor<float> gs;
	GlobalTensor<int32_t> gc;
	GlobalTensor<half> gy;
	gx.SetGlobalBuffer((__gm__ int8_t *)x);
	gw.SetGlobalBuffer((__gm__ int8_t *)w);
	gs.SetGlobalBuffer((__gm__ float *)sc);
	gy.SetGlobalBuffer((__gm__ half *)y);
	gc.SetGlobalBuffer((__gm__ int32_t *)workspace);

	const int tm = TileM;
	const int tn = TileN;

	const int capacity = 8192;
	const int vr = capacity / tn;
	const int ve = vr * tn;
	TBuf<TPosition::A1> a1Buffer[2], l1Gap;
	TBuf<TPosition::B1> b1Buffer[2];
	TBuf<TPosition::A2> a2Buffer;
	TBuf<TPosition::B2> b2Buffer;
	TBuf<TPosition::CO1> accBuffer;
	LocalTensor<int8_t> a1[2], b1[2], a2[L0Slots], b2[L0Slots];
	uint8_t l1Free[2], l1Ready[2], l0Free[L0Slots], l0Ready[L0Slots];
	uint8_t accumulatorFree = 0, matrixReady = 0;
	bool l1Used[2] = {false, false}, l0Used[L0Slots] = {};
	if ASCEND_IS_AIC
	{
	    pipe.InitBuffer(a1Buffer[0], tm * PacketK);
	    pipe.InitBuffer(b1Buffer[0], tn * PacketK);
	    const uint32_t packetBytes = (tm + tn) * PacketK;
	    if (l1Half > packetBytes)
		pipe.InitBuffer(l1Gap, l1Half - packetBytes);
	    pipe.InitBuffer(a1Buffer[1], tm * PacketK);
	    pipe.InitBuffer(b1Buffer[1], tn * PacketK);
#pragma unroll
	    for (int i = 0; i < 2; ++i)
	    {
		a1[i] = a1Buffer[i].Get<int8_t>();
		b1[i] = b1Buffer[i].Get<int8_t>();
		l1Free[i] = pipe.AllocEventID<HardEvent::MTE1_MTE2>();
		l1Ready[i] = pipe.AllocEventID<HardEvent::MTE2_MTE1>();
	    }
	    pipe.InitBuffer(a2Buffer, L0Slots * tm * 64);
	    pipe.InitBuffer(b2Buffer, L0Slots * tn * 64);
#pragma unroll
	    for (int i = 0; i < L0Slots; ++i)
	    {
		a2[i] = a2Buffer.Get<int8_t>()[i * tm * 64];
		b2[i] = b2Buffer.Get<int8_t>()[i * tn * 64];
		l0Free[i] = pipe.AllocEventID<HardEvent::M_MTE1>();
		l0Ready[i] = pipe.AllocEventID<HardEvent::MTE1_M>();
	    }
	    pipe.InitBuffer(accBuffer, tm * tn * sizeof(int32_t));
	    accumulatorFree = pipe.AllocEventID<HardEvent::FIX_M>();
	    matrixReady = pipe.AllocEventID<HardEvent::M_FIX>();
	}

	TQue<TPosition::VECIN, 1> cq;
	TQue<TPosition::VECOUT, 1> oq;
	TBuf<TPosition::VECCALC> zb, pb, groupCache;
	if ASCEND_IS_AIV
	{
	    pipe.InitBuffer(cq, 1,
			    uint32_t(((tm + 1) / 2 * tn + tn) * sizeof(float)) +
				(tm * tn > 16384 ? 256 : 0));
	    pipe.InitBuffer(oq, 1, (uint32_t)ve * sizeof(half));
	    pipe.InitBuffer(zb, (uint32_t)ve * sizeof(float));
	    if (E > 0)
	    {
		pipe.InitBuffer(groupCache, (E * 8 + 31) / 32 * 32);
		GlobalTensor<int64_t> gg;
		gg.SetGlobalBuffer((__gm__ int64_t *)groups);
		DataCopyPad(groupCache.Get<int64_t>(), gg, {1, (uint32_t)(E * 8), 0, 0, 0},
			    {true, 0, 0, int64_t(0)});
		auto ready = pipe.FetchEventID<HardEvent::MTE2_S>();
		SetFlag<HardEvent::MTE2_S>(ready);
		WaitFlag<HardEvent::MTE2_S>(ready);
	    }
	}

	int blockIdx = (int)GetBlockIdx();
	int lane = 0;
	if ASCEND_IS_AIV
	{
	    lane = blockIdx & 1;
	    blockIdx /= 2;
	}
	const int blockNum = (int)GetBlockNum();
	const int nc = (N + tn - 1) / tn;
	int64_t nextTask = blockIdx;
	const int period = 2 * blockNum;
	int gap = period - 1 - 2 * blockIdx;
	int64_t local = 0;
	for (int bucket = ((tm + 31) / 32 + 1) * 32; bucket >= 16; bucket -= 32)
	{
	    int begin = 0;
	    for (int e = 0; e < E; ++e)
	    {
		int end = 0;
		if ASCEND_IS_AIC
		{
		    end = (int)((__gm__ int64_t *)groups)[e];
		}
		if ASCEND_IS_AIV
		{
		    end = E > 0 ? (int)groupCache.Get<int64_t>().GetValue(e)
				: (int)((__gm__ int64_t *)groups)[e];
		}
		if (end < begin)
		    end = begin;
		if (end > M)
		    end = M;
		const int me = end - begin;
		const bool fullPass = bucket == ((tm + 31) / 32 + 1) * 32;
		const int fullTiles = me / tm;
		const int tailRows = me % tm;
		const bool selected = fullPass
					  ? fullTiles > 0
					  : tailRows > 0 && ((tailRows + 31) / 32 * 32 == bucket);
		if (selected)
		{
		    const int mt = fullPass ? fullTiles : 1;
		    const int firstM = fullPass ? 0 : fullTiles;
		    const int64_t tasks = (int64_t)mt * nc;

		    int64_t t = nextTask;
		    for (; t < tasks; t += gap, gap = period - gap)
		    {

			const int mIdx = firstM + (mt == 1 ? 0 : (int)(t % mt));
			const int nIdx = mt == 1 ? (int)t : (int)(t / mt);
			const int row = begin + mIdx * tm;
			const int col = nIdx * tn;
			const int rows = (me - mIdx * tm < tm) ? (me - mIdx * tm) : tm;
			const int cols = N - col < tn ? N - col : tn;

			const int pitch = (cols + 31) / 32 * 32;
			const int slot = (int)(local & 1);
			const uint16_t tileFlag = slot ? FLAG_TILE1 : FLAG_TILE0;
			const uint16_t freeFlag = slot ? FLAG_FREE1 : FLAG_FREE0;
			auto gcSlot = gc[(int64_t)(blockIdx * SLOTS + slot) * tm * tn];

			if ASCEND_IS_AIC
			{
			    const int panels = (K + PacketK - 1) / PacketK;
			    auto acc = accBuffer.Get<int32_t>();
#pragma unroll
			    for (int p = 0; p < 2 && p < panels; ++p)
			    {
				WeightPackedNZPrefetch<TileM, PacketK>(
				    gx, gw, a1[p], b1[p], l1Used[p], l1Free[p], l1Ready[p], row,
				    col, rows, cols, e, K, N, p);
				l1Used[p] = true;
			    }
			    int fragment = 0;
			    for (int panel = 0; panel < panels; ++panel)
			    {
				const int slot1 = panel & 1;
				WaitFlag<HardEvent::MTE2_MTE1>(l1Ready[slot1]);
#pragma unroll
				for (int sub = 0; sub < PacketK / 64; ++sub)
				{
				    if (panel * PacketK + sub * 64 >= K)
					break;
				    const int slot0 = fragment & (L0Slots - 1);
				    if (l0Used[slot0])
					WaitFlag<HardEvent::M_MTE1>(l0Free[slot0]);
				    LoadData2dParams la;
				    la.repeatTimes = (rows + 15) / 16;
				    la.srcStride = 1;
				    la.dstGap = 1;
				    la.ifTranspose = false;
#pragma unroll
				    for (int ki = 0; ki < 2; ++ki)
				    {
					LoadData(a2[slot0][ki * 512],
						 a1[slot1][(sub * 2 + ki) * tm * 32], la);
				    }
				    LoadData2dTransposeParams lb{
					0,
					uint8_t(((cols + 31) / 32 * 32) / 32),
					uint16_t(PacketK / 32),
					1,
					0,
					0};
#pragma unroll
				    for (int ki = 0; ki < 2; ++ki)
					LoadDataWithTranspose(
					    b2[slot0][ki * ((cols + 31) / 32 * 32) * 32],
					    b1[slot1][(sub * 2 + ki) * 1024], lb);
				    SetFlag<HardEvent::MTE1_M>(l0Ready[slot0]);
				    WaitFlag<HardEvent::MTE1_M>(l0Ready[slot0]);
				    if (fragment == 0 && local > 0)
					WaitFlag<HardEvent::FIX_M>(accumulatorFree);
				    MmadParams mad;
				    mad.m = (rows + 15) / 16 * 16;
				    mad.n = (cols + 31) / 32 * 32;
				    mad.k = 64;
				    mad.cmatrixInitVal = fragment == 0;
				    Mmad(acc, a2[slot0], b2[slot0], mad);

				    if ((mad.m / 16) * (mad.n / 16) < 10)
					PipeBarrier<PIPE_M>();
				    SetFlag<HardEvent::M_MTE1>(l0Free[slot0]);
				    l0Used[slot0] = true;
				    ++fragment;
				}
				SetFlag<HardEvent::MTE1_MTE2>(l1Free[slot1]);
				if (panel + 2 < panels)
				{
				    WeightPackedNZPrefetch<TileM, PacketK>(
					gx, gw, a1[slot1], b1[slot1], true, l1Free[slot1],
					l1Ready[slot1], row, col, rows, cols, e, K, N, panel + 2);
				}
			    }
			    SetFlag<HardEvent::M_FIX>(matrixReady);
			    WaitFlag<HardEvent::M_FIX>(matrixReady);

			    if (local >= SLOTS)
				CrossCoreWaitFlag<2, PIPE_FIX>(freeFlag);
			    FixpipeParamsV220 fix;
			    fix.nSize = (cols + 31) / 32 * 32;
			    fix.mSize = (rows + 15) / 16 * 16;
			    fix.srcStride = (rows + 15) / 16 * 16;
			    fix.dstStride = tn;
			    Fixpipe<int32_t, int32_t, CFG_ROW_MAJOR>(gcSlot, acc, fix);
			    SetFlag<HardEvent::FIX_M>(accumulatorFree);
			    CrossCoreSetFlag<2, PIPE_FIX>(tileFlag);
			}
			if ASCEND_IS_AIV
			{
			    CrossCoreWaitFlag<2, PIPE_MTE2>(tileFlag);
			    const int halfRows = (rows + 1) / 2;
			    const int rowOffset = lane * halfRows;
			    const int vectorRows = lane ? rows - halfRows : halfRows;
			    auto c = cq.AllocTensor<int32_t>();
			    auto scale = c.ReinterpretCast<float>()[((tm + 1) / 2 * tn) +
								    (tm * tn > 16384 ? 64 : 0)];

			    if (pitch != (cols + 7) / 8 * 8)
			    {
				Duplicate(c, int32_t(0), vectorRows * pitch);
				auto event = pipe.FetchEventID<HardEvent::V_MTE2>();
				SetFlag<HardEvent::V_MTE2>(event);
				WaitFlag<HardEvent::V_MTE2>(event);
			    }

			    if (vectorRows > 0)
				DataCopyPad(c, gcSlot[int64_t(rowOffset) * tn],
					    {uint16_t(vectorRows), uint32_t(cols * sizeof(int32_t)),
					     uint32_t((tn - cols) * sizeof(int32_t)),
					     uint32_t((pitch * 4 - (cols * 4 + 31) / 32 * 32) / 32),
					     0},
					    {true, 0, 0, 0});
			    if (cols < 64)
			    {
				Duplicate(scale, 0.0f, tn);
				auto initialized = pipe.FetchEventID<HardEvent::V_MTE2>();
				SetFlag<HardEvent::V_MTE2>(initialized);
				WaitFlag<HardEvent::V_MTE2>(initialized);
			    }
			    DataCopyPad(scale, gs[(int64_t)e * N + col],
					{1, (uint32_t)(cols * sizeof(float)), 0, 0, 0},
					{true, 0, 0, 0.0f});
			    cq.EnQue(c);
			    c = cq.DeQue<int32_t>();

			    CrossCoreSetFlag<2, PIPE_MTE2>(freeFlag);

			    auto z = zb.Get<float>();
			    auto p = c.ReinterpretCast<float>();
			    auto u = p;
			    auto t = p;

			    const BinaryRepeatParams bcast{
				1, 1, 1, (uint8_t)(pitch / 8), (uint8_t)(pitch / 8), 0};
			    for (int r = 0; r < vectorRows; r += vr)
			    {
				const int batch = (vectorRows - r < vr) ? (vectorRows - r) : vr;
				const uint32_t count = (uint32_t)batch * pitch;
				Cast(z, c[r * pitch], RoundMode::CAST_NONE, count);
				PipeBarrier<PIPE_V>();
				if (cols < 64)
				{
				    Mul(z, z, scale, (uint64_t)(pitch < 64 ? pitch : 64),
					(uint8_t)batch, bcast);
				}
				else
				{
				    for (int c0 = 0; c0 < cols; c0 += 64)
				    {
					const int chunk = (cols - c0 < 64) ? (cols - c0) : 64;
					Mul(z[c0], z[c0], scale[c0], (uint64_t)chunk,
					    (uint8_t)batch, bcast);
				    }
				}
				PipeBarrier<PIPE_V>();

				p = c[r * pitch].ReinterpretCast<float>();
				u = p;
				WeightPackedGeluTanh(z, p, u, t, count);
				auto out = oq.AllocTensor<half>();
				Cast(out, z, RoundMode::CAST_RINT, count);
				oq.EnQue(out);
				out = oq.DeQue<half>();
				const uint32_t outBytes = (uint32_t)cols * (uint32_t)sizeof(half);
				const uint32_t outPitchBytes =
				    (uint32_t)pitch * (uint32_t)sizeof(half);
				const uint32_t outSrcStride =
				    (outPitchBytes - ((outBytes + 31U) / 32U) * 32U) / 32U;
				for (int r0 = 0; r0 < batch; r0 += 32)
				{
				    const int rc = batch - r0 < 32 ? batch - r0 : 32;
				    DataCopyPad(gy[(int64_t)(row + rowOffset + r + r0) * N + col],
						out[r0 * pitch],
						{(uint16_t)rc, outBytes, outSrcStride,
						 (uint32_t)((N - cols) * sizeof(half)), 0});
				}
				oq.FreeTensor(out);
			    }
			    cq.FreeTensor(c);
			}
			++local;
		    }
		    nextTask = t - tasks;
		}
		begin = end;
	    }
	}
	if ASCEND_IS_AIC
	{

	    if (local > 0)
		CrossCoreWaitFlag<2, PIPE_MTE2>(FLAG_FREE0);
	    if (local > 1)
		CrossCoreWaitFlag<2, PIPE_MTE2>(FLAG_FREE1);
	    if (local > 0)
		WaitFlag<HardEvent::FIX_M>(accumulatorFree);
#pragma unroll
	    for (int i = 0; i < 2; ++i)
	    {
		if (l1Used[i])
		    WaitFlag<HardEvent::MTE1_MTE2>(l1Free[i]);
		pipe.ReleaseEventID<HardEvent::MTE1_MTE2>(l1Free[i]);
		pipe.ReleaseEventID<HardEvent::MTE2_MTE1>(l1Ready[i]);
	    }
#pragma unroll
	    for (int i = 0; i < L0Slots; ++i)
	    {
		if (l0Used[i])
		    WaitFlag<HardEvent::M_MTE1>(l0Free[i]);
		pipe.ReleaseEventID<HardEvent::M_MTE1>(l0Free[i]);
		pipe.ReleaseEventID<HardEvent::MTE1_M>(l0Ready[i]);
	    }
	    pipe.ReleaseEventID<HardEvent::FIX_M>(accumulatorFree);
	    pipe.ReleaseEventID<HardEvent::M_FIX>(matrixReady);
	}
    }

template<int TM,int TN,int Fold,int ADepth,int BDepth,int CDepth,int OutputSlots,
	 int Order,int Balance,int L0Slots,int L0K,bool FullB=false,bool Reuse=true>
__aicore__ inline void ComputeResident(
    GM_ADDR x,GM_ADDR w,GM_ADDR sc,GM_ADDR groups,GM_ADDR y,GM_ADDR workspace,
    int M,int K,int N,int E)
{
    static_assert(ADepth>=1 && ADepth<=2 && BDepth>=1 && BDepth<=2);
    static_assert(OutputSlots>=2 && OutputSlots<=4);
    static_assert(TM*TN*4*CDepth<=131072);
    static_assert(TM*L0K*L0Slots<=65536 && TN*L0K*L0Slots<=65536);
    const int KCap=(K+L0K-1)/L0K*L0K;
    constexpr int tm=TM,tn=TN,vr=8192/TN,ve=(vr*TN+63)/64*64;
    TPipe pipe;
    GlobalTensor<int8_t> gx,gw;
    GlobalTensor<float> gs;
    GlobalTensor<int32_t> gc;
    GlobalTensor<half> gy;
    gx.SetGlobalBuffer((__gm__ int8_t*)x);gw.SetGlobalBuffer((__gm__ int8_t*)w);
    gs.SetGlobalBuffer((__gm__ float*)sc);gc.SetGlobalBuffer((__gm__ int32_t*)workspace);
    gy.SetGlobalBuffer((__gm__ half*)y);
    TBuf<TPosition::A1> a1Buffer[ADepth];
    TBuf<TPosition::B1> b1Buffer[BDepth];
    TBuf<TPosition::A2> a2Buffer;
    TBuf<TPosition::B2> b2Buffer;
    TBuf<TPosition::CO1> accBuffer;
    LocalTensor<int8_t> a1[ADepth],b1[BDepth],a2[L0Slots],b2[L0Slots];
    uint8_t aFree[ADepth],aReady[ADepth],bFree[BDepth],bReady[BDepth];
    uint8_t l0Free[L0Slots],l0Ready[L0Slots],accFree[CDepth],matrixReady;
    bool aUsed[ADepth]={},bUsed[BDepth]={},l0Used[L0Slots]={};
    if ASCEND_IS_AIC {
	for(int i=0;i<ADepth;++i) {
	    pipe.InitBuffer(a1Buffer[i],tm*KCap);a1[i]=a1Buffer[i].template Get<int8_t>();
	    aFree[i]=pipe.AllocEventID<HardEvent::MTE1_MTE2>();
	    aReady[i]=pipe.AllocEventID<HardEvent::MTE2_MTE1>();
	}
	for(int i=0;i<BDepth;++i) {
	    pipe.InitBuffer(b1Buffer[i],(FullB?(N+31)/32*32:tn)*KCap);
	    b1[i]=b1Buffer[i].template Get<int8_t>();
	    bFree[i]=pipe.AllocEventID<HardEvent::MTE1_MTE2>();
	    bReady[i]=pipe.AllocEventID<HardEvent::MTE2_MTE1>();
	}
	pipe.InitBuffer(a2Buffer,L0Slots*tm*L0K);pipe.InitBuffer(b2Buffer,L0Slots*tn*L0K);
	for(int i=0;i<L0Slots;++i) {
	    a2[i]=a2Buffer.Get<int8_t>()[i*tm*L0K];b2[i]=b2Buffer.Get<int8_t>()[i*tn*L0K];
	    l0Free[i]=pipe.AllocEventID<HardEvent::M_MTE1>();
	    l0Ready[i]=pipe.AllocEventID<HardEvent::MTE1_M>();
	}
	pipe.InitBuffer(accBuffer,CDepth*tm*tn*4);
	for(int i=0;i<CDepth;++i)accFree[i]=pipe.AllocEventID<HardEvent::FIX_M>();
	matrixReady=pipe.AllocEventID<HardEvent::M_FIX>();
    }
    TQue<TPosition::VECIN,1> cq;
    TQue<TPosition::VECOUT,1> oq;
    TBuf<TPosition::VECCALC> zb,groupCache;
    if ASCEND_IS_AIV {
	pipe.InitBuffer(cq,1,uint32_t((tm/2*tn+tn)*4)+(tm*tn>16384?256:0));
	pipe.InitBuffer(oq,1,ve*2);pipe.InitBuffer(zb,ve*4);
	pipe.InitBuffer(groupCache,(E*8+31)/32*32);
	GlobalTensor<int64_t> gg;gg.SetGlobalBuffer((__gm__ int64_t*)groups);
	DataCopyPad(groupCache.Get<int64_t>(),gg,{1,uint32_t(E*8),0,0,0},{true,0,0,int64_t(0)});
	auto ready=pipe.FetchEventID<HardEvent::MTE2_S>();
	SetFlag<HardEvent::MTE2_S>(ready);WaitFlag<HardEvent::MTE2_S>(ready);
    }
    int blockIdx=int(GetBlockIdx()),lane=0;
    if ASCEND_IS_AIV {lane=blockIdx&1;blockIdx/=2;}
    const int blockNum=int(GetBlockNum()),nc=(N+tn-1)/tn,nUnits=(N+31)/32;
    int64_t totalTasks=0;
    int previous=0;
    for(int e=0;e<E;++e) {
	int end=0;
	if ASCEND_IS_AIC {end=int(((__gm__ int64_t*)groups)[e]);}
	if ASCEND_IS_AIV {end=int(groupCache.Get<int64_t>().GetValue(e));}
	if(end<previous)end=previous;if(end>M)end=M;
	totalTasks+=int64_t((end-previous+tm-1)/tm)*nc;previous=end;
    }
    const int64_t ownedBegin=totalTasks*blockIdx/blockNum,ownedEnd=totalTasks*(blockIdx+1)/blockNum;
    int64_t taskOffset=0;
    int local=0,begin=0;
    for(int e=0;e<E;++e) {
	int end=0;
	if ASCEND_IS_AIC {end=int(((__gm__ int64_t*)groups)[e]);}
	if ASCEND_IS_AIV {end=int(groupCache.Get<int64_t>().GetValue(e));}
	if(end<begin)end=begin;if(end>M)end=M;
	const int mt=(end-begin+tm-1)/tm;
	const int64_t tasks=int64_t(mt)*nc;
	const int64_t first=ownedBegin>taskOffset?ownedBegin-taskOffset:0;
	const int64_t limit=ownedEnd-taskOffset<tasks?ownedEnd-taskOffset:tasks;
	int as=0,bs=0;
	bool freshA=true,freshB=true;
	for(int64_t task=first;task<limit;++task) {
	    const int mi=Order?task%mt:task/nc,ni=Order?task/mt:task%nc;
	    const int row=begin+mi*tm,rows=end-row<tm?end-row:tm;
	    const int col=Balance?(ni*nUnits/nc)*32:ni*tn;
	    const int colEnd=Balance?((ni+1)*nUnits/nc)*32:col+tn;
	    const int cols=(colEnd<N?colEnd:N)-col,pitch=(cols+31)/32*32;
	    const bool next=task+1<limit;
	    const int nextM=next?(Order?(task+1)%mt:(task+1)/nc):mi;
	    const int nextN=next?(Order?(task+1)/mt:(task+1)%nc):ni;
	    const bool changeA=!next || !Reuse || nextM!=mi;
	    const bool changeB=!next || (!FullB && (!Reuse || nextN!=ni));
	    const int nas=(ADepth==2 && changeA)?as^1:as;
	    const int nbs=(BDepth==2 && changeB)?bs^1:bs;
	    const int slot=local%OutputSlots;
	    const uint16_t tileFlag=8+slot,freeFlag=12+slot;
	    auto gcSlot=gc[int64_t(blockIdx*OutputSlots+slot)*tm*tn];
	    if ASCEND_IS_AIC {
		if(freshA && (task==first || ADepth==1)) {
		    ResidentLoadA<tm>(a1[as],gx,row,rows,K,aUsed[as],aFree[as],aReady[as],KCap);
		    aUsed[as]=true;SetFlag<HardEvent::MTE2_MTE1>(aReady[as]);
		}
		if(freshB && (task==first || BDepth==1)) {
		    if(bUsed[bs])WaitFlag<HardEvent::MTE1_MTE2>(bFree[bs]);
		    ResidentLoadB<tm,tn,Fold>(b1[bs],gw,e,FullB?0:col,FullB?N:cols,K,N,KCap);
		    bUsed[bs]=true;SetFlag<HardEvent::MTE2_MTE1>(bReady[bs]);
		}
		if(freshA)WaitFlag<HardEvent::MTE2_MTE1>(aReady[as]);
		if(freshB)WaitFlag<HardEvent::MTE2_MTE1>(bReady[bs]);
		// Prefetch real future tiles while MTE1/Cube consume disjoint current slots.
		if(next && changeB && BDepth==2) {
		    const int ncol=Balance?(nextN*nUnits/nc)*32:nextN*tn;
		    const int nend=Balance?((nextN+1)*nUnits/nc)*32:ncol+tn;
		    if(bUsed[nbs])WaitFlag<HardEvent::MTE1_MTE2>(bFree[nbs]);
		    ResidentLoadB<tm,tn,Fold>(b1[nbs],gw,e,ncol,(nend<N?nend:N)-ncol,K,N,KCap);
		    bUsed[nbs]=true;SetFlag<HardEvent::MTE2_MTE1>(bReady[nbs]);
		}
		if(next && changeA && ADepth==2) {
		    const int nrow=begin+nextM*tm,nrows=end-nrow<tm?end-nrow:tm;
		    ResidentLoadA<tm>(a1[nas],gx,nrow,nrows,K,aUsed[nas],aFree[nas],aReady[nas],KCap);
		    aUsed[nas]=true;SetFlag<HardEvent::MTE2_MTE1>(aReady[nas]);
		}
		const int cs=local%CDepth;
		auto acc=accBuffer.Get<int32_t>()[cs*tm*tn];
		for(int sub=0;sub<KCap/L0K;++sub) {
		    const int ls=sub%L0Slots;
		    if(l0Used[ls])WaitFlag<HardEvent::M_MTE1>(l0Free[ls]);
		    LoadData2dParams la;la.repeatTimes=(rows+15)/16;la.srcStride=1;
		    la.dstGap=L0K/32-1;la.ifTranspose=false;
		    LoadData2dTransposeParams lb{0,uint8_t(pitch/32),uint16_t(KCap/32),1,0,0};
#pragma unroll
		    for(int ki=0;ki<L0K/32;++ki) {
			LoadData(a2[ls][ki*512],a1[as][(sub*(L0K/32)+ki)*tm*32],la);
			LoadDataWithTranspose(b2[ls][ki*pitch*32],
			    b1[bs][(FullB?col*KCap:0)+(sub*(L0K/32)+ki)*1024],lb);
		    }
		    SetFlag<HardEvent::MTE1_M>(l0Ready[ls]);WaitFlag<HardEvent::MTE1_M>(l0Ready[ls]);
		    if(!sub && local>=CDepth)WaitFlag<HardEvent::FIX_M>(accFree[cs]);
		    MmadParams mad;mad.m=(rows+15)/16*16;mad.n=pitch;mad.k=L0K;mad.cmatrixInitVal=sub==0;
		    Mmad(acc,a2[ls],b2[ls],mad);
		    if((mad.m/16)*(mad.n/16)<10)PipeBarrier<PIPE_M>();
		    SetFlag<HardEvent::M_MTE1>(l0Free[ls]);l0Used[ls]=true;
		}
		if(changeA)SetFlag<HardEvent::MTE1_MTE2>(aFree[as]);
		if(changeB)SetFlag<HardEvent::MTE1_MTE2>(bFree[bs]);
		SetFlag<HardEvent::M_FIX>(matrixReady);WaitFlag<HardEvent::M_FIX>(matrixReady);
		if(local>=OutputSlots)CrossCoreWaitFlag<2,PIPE_FIX>(freeFlag);
		FixpipeParamsV220 fix;fix.nSize=pitch;fix.mSize=(rows+15)/16*16;
		fix.srcStride=fix.mSize;fix.dstStride=tn;
		Fixpipe<int32_t,int32_t,CFG_ROW_MAJOR>(gcSlot,acc,fix);
		SetFlag<HardEvent::FIX_M>(accFree[cs]);CrossCoreSetFlag<2,PIPE_FIX>(tileFlag);
	    }
						    if ASCEND_IS_AIV
			{
			    CrossCoreWaitFlag<2, PIPE_MTE2>(tileFlag);
			    const int halfRows = (rows + 1) / 2;
			    const int rowOffset = lane * halfRows;
			    const int vectorRows = lane ? rows - halfRows : halfRows;
			    auto c = cq.AllocTensor<int32_t>();
			    auto scale = c.ReinterpretCast<float>()[((tm + 1) / 2 * tn) +
								    (tm * tn > 16384 ? 64 : 0)];

			    if (pitch != (cols + 7) / 8 * 8)
			    {
				Duplicate(c, int32_t(0), vectorRows * pitch);
				auto event = pipe.FetchEventID<HardEvent::V_MTE2>();
				SetFlag<HardEvent::V_MTE2>(event);
				WaitFlag<HardEvent::V_MTE2>(event);
			    }

			    if (vectorRows > 0)
				DataCopyPad(c, gcSlot[int64_t(rowOffset) * tn],
					    {uint16_t(vectorRows), uint32_t(cols * sizeof(int32_t)),
					     uint32_t((tn - cols) * sizeof(int32_t)),
					     uint32_t((pitch * 4 - (cols * 4 + 31) / 32 * 32) / 32),
					     0},
					    {true, 0, 0, 0});
			    if (cols < 64)
			    {
				Duplicate(scale, 0.0f, tn);
				auto initialized = pipe.FetchEventID<HardEvent::V_MTE2>();
				SetFlag<HardEvent::V_MTE2>(initialized);
				WaitFlag<HardEvent::V_MTE2>(initialized);
			    }
			    DataCopyPad(scale, gs[(int64_t)e * N + col],
					{1, (uint32_t)(cols * sizeof(float)), 0, 0, 0},
					{true, 0, 0, 0.0f});
			    cq.EnQue(c);
			    c = cq.DeQue<int32_t>();

			    CrossCoreSetFlag<2, PIPE_MTE2>(freeFlag);

			    auto z = zb.Get<float>();
			    auto p = c.ReinterpretCast<float>();
			    auto u = p;
			    auto t = p;

			    const BinaryRepeatParams bcast{
				1, 1, 1, (uint8_t)(pitch / 8), (uint8_t)(pitch / 8), 0};
			    for (int r = 0; r < vectorRows; r += vr)
			    {
				const int batch = (vectorRows - r < vr) ? (vectorRows - r) : vr;
				const uint32_t count = (uint32_t)batch * pitch;
				Cast(z, c[r * pitch], RoundMode::CAST_NONE, count);
				PipeBarrier<PIPE_V>();
				if (cols < 64)
				{
				    Mul(z, z, scale, (uint64_t)(pitch < 64 ? pitch : 64),
					(uint8_t)batch, bcast);
				}
				else
				{
				    for (int c0 = 0; c0 < cols; c0 += 64)
				    {
					const int chunk = (cols - c0 < 64) ? (cols - c0) : 64;
					Mul(z[c0], z[c0], scale[c0], (uint64_t)chunk,
					    (uint8_t)batch, bcast);
				    }
				}
				PipeBarrier<PIPE_V>();

				p = c[r * pitch].ReinterpretCast<float>();
				u = p;
				ResidentGelu(z,p,count);
				auto out = oq.AllocTensor<half>();
				Cast(out, z, RoundMode::CAST_RINT, count);
				oq.EnQue(out);
				out = oq.DeQue<half>();
				const uint32_t outBytes = (uint32_t)cols * (uint32_t)sizeof(half);
				const uint32_t outPitchBytes =
				    (uint32_t)pitch * (uint32_t)sizeof(half);
				const uint32_t outSrcStride =
				    (outPitchBytes - ((outBytes + 31U) / 32U) * 32U) / 32U;
				for (int r0 = 0; r0 < batch; r0 += 32)
				{
				    const int rc = batch - r0 < 32 ? batch - r0 : 32;
				    DataCopyPad(gy[(int64_t)(row + rowOffset + r + r0) * N + col],
						out[r0 * pitch],
						{(uint16_t)rc, outBytes, outSrcStride,
						 (uint32_t)((N - cols) * sizeof(half)), 0});
				}
				oq.FreeTensor(out);
			    }
			    cq.FreeTensor(c);
			}

	    as=nas;bs=nbs;freshA=changeA;freshB=changeB;++local;
	}
	taskOffset+=tasks;begin=end;
    }
    if ASCEND_IS_AIV {PipeBarrier<PIPE_ALL>();}
    if ASCEND_IS_AIC {
	for(int i=0;i<OutputSlots;++i)if(local>i)CrossCoreWaitFlag<2,PIPE_MTE2>(12+i);
	for(int i=0;i<CDepth;++i) {
	    if(local>i)WaitFlag<HardEvent::FIX_M>(accFree[i]);
	    pipe.ReleaseEventID<HardEvent::FIX_M>(accFree[i]);
	}
	for(int i=0;i<ADepth;++i) {
	    if(aUsed[i])WaitFlag<HardEvent::MTE1_MTE2>(aFree[i]);
	    pipe.ReleaseEventID<HardEvent::MTE1_MTE2>(aFree[i]);
	    pipe.ReleaseEventID<HardEvent::MTE2_MTE1>(aReady[i]);
	}
	for(int i=0;i<BDepth;++i) {
	    if(bUsed[i])WaitFlag<HardEvent::MTE1_MTE2>(bFree[i]);
	    pipe.ReleaseEventID<HardEvent::MTE1_MTE2>(bFree[i]);
	    pipe.ReleaseEventID<HardEvent::MTE2_MTE1>(bReady[i]);
	}
	for(int i=0;i<L0Slots;++i) {
	    if(l0Used[i])WaitFlag<HardEvent::M_MTE1>(l0Free[i]);
	    pipe.ReleaseEventID<HardEvent::M_MTE1>(l0Free[i]);
	    pipe.ReleaseEventID<HardEvent::MTE1_M>(l0Ready[i]);
	}
	pipe.ReleaseEventID<HardEvent::M_FIX>(matrixReady);
    }
}

__aicore__ inline void FocusedWidePrefetch(GlobalTensor<int8_t> gx, GlobalTensor<int8_t> gw,
					      LocalTensor<int8_t> a1, LocalTensor<int8_t> b1,
					      bool reused, uint8_t freeId, uint8_t readyId, int row,
					      int col, int rows, int cols, int expert, int K, int N,
					      int panel)
    {
	if (reused)
	    WaitFlag<HardEvent::MTE1_MTE2>(freeId);
	Nd2NzParams ap;
	ap.ndNum = 1;
	ap.nValue = rows;
	ap.dValue = 256;
	ap.srcNdMatrixStride = 0;
	ap.srcDValue = K;
	ap.dstNzC0Stride = 64;
	ap.dstNzNStride = 1;
	ap.dstNzMatrixStride = 0;
	Nd2NzParams bp;
	bp.ndNum = 1;
	bp.nValue = 256/1;
	bp.dValue = cols;
	bp.srcNdMatrixStride = N;
	bp.srcDValue = 1*N;
	bp.dstNzC0Stride = 256;
	bp.dstNzNStride = 1;
	bp.dstNzMatrixStride = 32;
	DataCopy(b1, gw[int64_t(expert) * K * N + int64_t(panel * 256) * N + col], bp);
	DataCopy(a1, gx[int64_t(row) * K + panel * 256], ap);
	SetFlag<HardEvent::MTE2_MTE1>(readyId);
    }

__aicore__ __attribute__((always_inline)) inline void
    ComputeAlignedWide(GM_ADDR x, GM_ADDR w, GM_ADDR sc, GM_ADDR groups, GM_ADDR y,
		      GM_ADDR workspace, int M, int K, int N, int E,
		      AscendC::tiling::TCubeTiling tiling, uint32_t l1Half)
    {
	TPipe pipe;
	GlobalTensor<int8_t> gx, gw;
	GlobalTensor<float> gs;
	GlobalTensor<int32_t> gc;
	GlobalTensor<half> gy;
	gx.SetGlobalBuffer((__gm__ int8_t *)x);
	gw.SetGlobalBuffer((__gm__ int8_t *)w);
	gs.SetGlobalBuffer((__gm__ float *)sc);
	gy.SetGlobalBuffer((__gm__ half *)y);
	gc.SetGlobalBuffer((__gm__ int32_t *)workspace);

	const int tm = 64;
	const int tn = 512;

	const int capacity = 16384;
	const int vr = capacity / tn;
	const int ve = vr * tn;
	TBuf<TPosition::A1> a1Buffer[2], l1Gap;
	TBuf<TPosition::B1> b1Buffer[2];
	TBuf<TPosition::A2> a2Buffer[2];
	TBuf<TPosition::B2> b2Buffer[2];
	TBuf<TPosition::CO1> accBuffer;
	LocalTensor<int8_t> a1[2], b1[2], a2[2], b2[2];
	uint8_t l1Free[2], l1Ready[2], l0Free[2], l0Ready[2];
	uint8_t accumulatorFree = 0, matrixReady = 0;
	bool l1Used[2] = {false, false}, l0Used[2] = {false, false};
	if ASCEND_IS_AIC
	{
	    pipe.InitBuffer(a1Buffer[0], tm * 256);
	    pipe.InitBuffer(b1Buffer[0], tn * 256);
	    const uint32_t packetBytes = (tm + tn) * 256;
	    if (l1Half > packetBytes)
		pipe.InitBuffer(l1Gap, l1Half - packetBytes);
	    pipe.InitBuffer(a1Buffer[1], tm * 256);
	    pipe.InitBuffer(b1Buffer[1], tn * 256);
#pragma unroll
	    for (int i = 0; i < 2; ++i)
	    {
		pipe.InitBuffer(a2Buffer[i], tm * 64);
		pipe.InitBuffer(b2Buffer[i], tn * 64);
		a1[i] = a1Buffer[i].Get<int8_t>();
		b1[i] = b1Buffer[i].Get<int8_t>();
		a2[i] = a2Buffer[i].Get<int8_t>();
		b2[i] = b2Buffer[i].Get<int8_t>();
		l1Free[i] = pipe.AllocEventID<HardEvent::MTE1_MTE2>();
		l1Ready[i] = pipe.AllocEventID<HardEvent::MTE2_MTE1>();
		l0Free[i] = pipe.AllocEventID<HardEvent::M_MTE1>();
		l0Ready[i] = pipe.AllocEventID<HardEvent::MTE1_M>();
	    }
	    pipe.InitBuffer(accBuffer, tm * tn * sizeof(int32_t));
	    accumulatorFree = pipe.AllocEventID<HardEvent::FIX_M>();
	    matrixReady = pipe.AllocEventID<HardEvent::M_FIX>();
	}

	TQue<TPosition::VECIN, 1> cq, sq;
	TQue<TPosition::VECOUT, 1> oq;
	TBuf<TPosition::VECCALC> zb, pb, groupCache;
	if ASCEND_IS_AIV
	{
	    pipe.InitBuffer(cq, 1, (uint32_t)((tm + 1) / 2 * tn) * sizeof(int32_t));
	    pipe.InitBuffer(sq, 1, (uint32_t)tn * sizeof(float) + (tm * tn > 16384 ? 256 : 0));
	    pipe.InitBuffer(oq, 1, (uint32_t)ve * sizeof(half));
	    pipe.InitBuffer(zb, (uint32_t)ve * sizeof(float));
	    if (E > 0)
	    {
		pipe.InitBuffer(groupCache, (E * 8 + 31) / 32 * 32);
		GlobalTensor<int64_t> gg;
		gg.SetGlobalBuffer((__gm__ int64_t *)groups);
		DataCopyPad(groupCache.Get<int64_t>(), gg, {1, (uint32_t)(E * 8), 0, 0, 0},
			    {true, 0, 0, int64_t(0)});
		auto ready = pipe.FetchEventID<HardEvent::MTE2_S>();
		SetFlag<HardEvent::MTE2_S>(ready);
		WaitFlag<HardEvent::MTE2_S>(ready);
	    }
	}

	int blockIdx = (int)GetBlockIdx();
	int lane = 0;
	if ASCEND_IS_AIV
	{
	    lane = blockIdx & 1;
	    blockIdx /= 2;
	}
	const int blockNum = (int)GetBlockNum();
	const int nc = (N + tn - 1) / tn;
	int64_t nextTask = blockIdx;
	const int period = 2 * blockNum;
	int gap = period - 1 - 2 * blockIdx;
	int64_t local = 0;
	for (int bucket = tm + 32; bucket >= 16; bucket -= 32)
	{
	    int begin = 0;
	    for (int e = 0; e < E; ++e)
	    {
		int end = 0;
		if ASCEND_IS_AIC
		{
		    end = (int)((__gm__ int64_t *)groups)[e];
		}
		if ASCEND_IS_AIV
		{
		    end = E > 0 ? (int)groupCache.Get<int64_t>().GetValue(e)
				: (int)((__gm__ int64_t *)groups)[e];
		}
		if (end < begin)
		    end = begin;
		if (end > M)
		    end = M;
		const int me = end - begin;
		const bool fullPass = bucket > tm;
		const int fullTiles = me / tm;
		const int tailRows = me % tm;
		const bool selected = fullPass
					  ? fullTiles > 0
					  : tailRows > 0 && ((tailRows + 31) / 32 * 32 == bucket);
		if (selected)
		{
		    const int mt = fullPass ? fullTiles : 1;
		    const int firstM = fullPass ? 0 : fullTiles;
		    const int64_t tasks = (int64_t)mt * nc;

		    int64_t t = nextTask;
		    for (; t < tasks; t += gap, gap = period - gap)
		    {

			const int mIdx = firstM + (mt == 1 ? 0 : (int)(t % mt));
			const int nIdx = mt == 1 ? (int)t : (int)(t / mt);
			const int row = begin + mIdx * tm;
			const int col = nIdx * tn;
			const int rows = (me - mIdx * tm < tm) ? (me - mIdx * tm) : tm;
			const int cols = (N - col < tn) ? (N - col) : tn;

			const int pitch = (cols + 31) / 32 * 32;
			const int slot = (int)(local & 1);
			const uint16_t tileFlag = slot ? FLAG_TILE1 : FLAG_TILE0;
			const uint16_t freeFlag = slot ? FLAG_FREE1 : FLAG_FREE0;
			auto gcSlot = gc[(int64_t)(blockIdx * SLOTS + slot) * tm * tn];

			if ASCEND_IS_AIC
			{
			    const int panels = K / 256;
			    auto acc = accBuffer.Get<int32_t>();
#pragma unroll
			    for (int p = 0; p < 2; ++p)
			    {
				FocusedWidePrefetch(gx, gw, a1[p], b1[p], l1Used[p], l1Free[p],
						   l1Ready[p], row, col, rows, cols, e, K, N, p);
				l1Used[p] = true;
			    }
			    int fragment = 0;
			    for (int panel = 0; panel < panels; ++panel)
			    {
				const int slot1 = panel & 1;
				WaitFlag<HardEvent::MTE2_MTE1>(l1Ready[slot1]);
#pragma unroll
				for (int sub = 0; sub < 4; ++sub)
				{
				    const int slot0 = fragment & 1;
				    if (l0Used[slot0])
					WaitFlag<HardEvent::M_MTE1>(l0Free[slot0]);
				    LoadData2dParams la;
				    la.repeatTimes = (rows + 15) / 16;
				    la.srcStride = 1;
				    la.dstGap = 1;
				    la.ifTranspose = false;
#pragma unroll
				    for (int ki = 0; ki < 2; ++ki)
				    {
					LoadData(a2[slot0][ki * 512],
						 a1[slot1][(sub * 2 + ki) * tm * 32], la);
				    }
				    LoadData2dTransposeParams lb{
					0, uint8_t(cols / 32), uint16_t(256 / 32), 1, 0, 0};
#pragma unroll
				    for (int ki = 0; ki < 2; ++ki)
					LoadDataWithTranspose(b2[slot0][ki * cols * 32],
							      b1[slot1][(sub * 2 + ki) * 1024], lb);
				    SetFlag<HardEvent::MTE1_M>(l0Ready[slot0]);
				    WaitFlag<HardEvent::MTE1_M>(l0Ready[slot0]);
				    if (fragment == 0 && local > 0)
					WaitFlag<HardEvent::FIX_M>(accumulatorFree);
				    MmadParams mad;
				    mad.m = (rows + 15) / 16 * 16;
				    mad.n = cols;
				    mad.k = 64;
				    mad.cmatrixInitVal = fragment == 0;
				    Mmad(acc, a2[slot0], b2[slot0], mad);
				    if ((mad.m / 16) * (mad.n / 16) < 10)
					PipeBarrier<PIPE_M>();
				    SetFlag<HardEvent::M_MTE1>(l0Free[slot0]);
				    l0Used[slot0] = true;
				    ++fragment;
				}
				SetFlag<HardEvent::MTE1_MTE2>(l1Free[slot1]);
				if (panel + 2 < panels)
				{
				    FocusedWidePrefetch(gx, gw, a1[slot1], b1[slot1], true,
						       l1Free[slot1], l1Ready[slot1], row, col,
						       rows, cols, e, K, N, panel + 2);
				}
			    }
			    SetFlag<HardEvent::M_FIX>(matrixReady);
			    WaitFlag<HardEvent::M_FIX>(matrixReady);

			    if (local >= SLOTS)
				CrossCoreWaitFlag<2, PIPE_FIX>(freeFlag);
			    FixpipeParamsV220 fix;
			    fix.nSize = cols;
			    fix.mSize = (rows + 15) / 16 * 16;
			    fix.srcStride = (rows + 15) / 16 * 16;
			    fix.dstStride = tn;
			    Fixpipe<int32_t, int32_t, CFG_ROW_MAJOR>(gcSlot, acc, fix);
			    SetFlag<HardEvent::FIX_M>(accumulatorFree);
			    CrossCoreSetFlag<2, PIPE_FIX>(tileFlag);
			}
			if ASCEND_IS_AIV
			{
			    CrossCoreWaitFlag<2, PIPE_MTE2>(tileFlag);
			    const int halfRows = (rows + 1) / 2;
			    const int rowOffset = lane * halfRows;
			    const int vectorRows = lane ? rows - halfRows : halfRows;
			    auto c = cq.AllocTensor<int32_t>();
			    auto scale = sq.AllocTensor<float>();

			    if (pitch != (cols + 7) / 8 * 8)
			    {
				Duplicate(c, int32_t(0), vectorRows * pitch);
				auto event = pipe.FetchEventID<HardEvent::V_MTE2>();
				SetFlag<HardEvent::V_MTE2>(event);
				WaitFlag<HardEvent::V_MTE2>(event);
			    }

			    for (int r0 = 0; r0 < vectorRows; r0 += 32)
			    {
				const int rc = (vectorRows - r0 < 32) ? (vectorRows - r0) : 32;
				DataCopyPad(
				    c[r0 * pitch], gcSlot[(int64_t)(rowOffset + r0) * tn],
				    {(uint16_t)rc, (uint32_t)(cols * sizeof(int32_t)),
				     (uint32_t)((tn - cols) * sizeof(int32_t)),
				     (uint32_t)((pitch * sizeof(int32_t) -
						 ((cols * sizeof(int32_t) + 31) / 32) * 32) /
						32),
				     0},
				    {true, 0, 0, 0});
			    }
			    DataCopyPad(scale, gs[(int64_t)e * N + col],
					{1, (uint32_t)(cols * sizeof(float)), 0, 0, 0},
					{true, 0, 0, 0.0f});
			    cq.EnQue(c);
			    sq.EnQue(scale);
			    c = cq.DeQue<int32_t>();
			    scale = sq.DeQue<float>();

			    CrossCoreSetFlag<2, PIPE_MTE2>(freeFlag);

			    auto z = zb.Get<float>();
			    auto p = c.ReinterpretCast<float>();
			    auto u = p;
			    auto t = p;

			    const BinaryRepeatParams bcast{
				1, 1, 1, (uint8_t)(pitch / 8), (uint8_t)(pitch / 8), 0};
			    for (int r = 0; r < vectorRows; r += vr)
			    {
				const int batch = (vectorRows - r < vr) ? (vectorRows - r) : vr;
				const uint32_t count = (uint32_t)batch * pitch;
				Cast(z, c[r * pitch], RoundMode::CAST_NONE, count);
				PipeBarrier<PIPE_V>();
				if (cols < 64)
				{
				    Mul(z, z, scale, (uint64_t)64, (uint8_t)batch, bcast);
				}
				else
				{
				    for (int c0 = 0; c0 < cols; c0 += 64)
				    {
					const int chunk = (cols - c0 < 64) ? (cols - c0) : 64;
					Mul(z[c0], z[c0], scale[c0], (uint64_t)chunk,
					    (uint8_t)batch, bcast);
				    }
				}
				PipeBarrier<PIPE_V>();

				p = c[r * pitch].ReinterpretCast<float>();
				u = p;
				GeluTanh(z, p, u, t, count);
				auto out = oq.AllocTensor<half>();
				Cast(out, z, RoundMode::CAST_RINT, count);
				oq.EnQue(out);
				out = oq.DeQue<half>();
				const uint32_t outBytes = (uint32_t)cols * (uint32_t)sizeof(half);
				const uint32_t outPitchBytes =
				    (uint32_t)pitch * (uint32_t)sizeof(half);
				const uint32_t outSrcStride =
				    (outPitchBytes - ((outBytes + 31U) / 32U) * 32U) / 32U;
				for (int r0 = 0; r0 < batch; r0 += 32)
				{
				    const int rc = batch - r0 < 32 ? batch - r0 : 32;
				    DataCopyPad(gy[(int64_t)(row + rowOffset + r + r0) * N + col],
						out[r0 * pitch],
						{(uint16_t)rc, outBytes, outSrcStride,
						 (uint32_t)((N - cols) * sizeof(half)), 0});
				}
				oq.FreeTensor(out);
			    }
			    cq.FreeTensor(c);
			    sq.FreeTensor(scale);
			}
			++local;
		    }
		    nextTask = t - tasks;
		}
		begin = end;
	    }
	}
	if ASCEND_IS_AIC
	{

	    if (local > 0)
		CrossCoreWaitFlag<2, PIPE_MTE2>(FLAG_FREE0);
	    if (local > 1)
		CrossCoreWaitFlag<2, PIPE_MTE2>(FLAG_FREE1);
	    if (local > 0)
		WaitFlag<HardEvent::FIX_M>(accumulatorFree);
#pragma unroll
	    for (int i = 0; i < 2; ++i)
	    {
		if (l1Used[i])
		    WaitFlag<HardEvent::MTE1_MTE2>(l1Free[i]);
		if (l0Used[i])
		    WaitFlag<HardEvent::M_MTE1>(l0Free[i]);
		pipe.ReleaseEventID<HardEvent::MTE1_MTE2>(l1Free[i]);
		pipe.ReleaseEventID<HardEvent::MTE2_MTE1>(l1Ready[i]);
		pipe.ReleaseEventID<HardEvent::M_MTE1>(l0Free[i]);
		pipe.ReleaseEventID<HardEvent::MTE1_M>(l0Ready[i]);
	    }
	    pipe.ReleaseEventID<HardEvent::FIX_M>(accumulatorFree);
	    pipe.ReleaseEventID<HardEvent::M_FIX>(matrixReady);
	}
    }

}

// Complete-K B residency for device-prepared NZ weights. Ownership and
// prefetch use the same continuous task partition as ComputeResident.
namespace gmm_device {
__aicore__ inline void PackedResidentLoadB(LocalTensor<int8_t> b,GlobalTensor<int8_t> w,
    int e,int col,int cols,int K,int N,int KCap) {
    const int np=(N+31)/32*32,pn=(cols+31)/32*32;
    DataCopy(b,w[(int64_t(e)*np+col)*KCap],
        DataCopyParams{1,uint16_t(pn*KCap/32),0,0});
}
template<int TM,int TN,int Fold,int ADepth,int BDepth,int CDepth,int OutputSlots,
	 int Order,int Balance,int L0Slots,int L0K,bool FullB=false,bool Reuse=true,bool DoubleInput=false>
__aicore__ inline void ComputePackedWeightResident(
    GM_ADDR x,GM_ADDR w,GM_ADDR sc,GM_ADDR groups,GM_ADDR y,GM_ADDR workspace,
    int M,int K,int N,int E)
{
    static_assert(ADepth>=1 && ADepth<=2 && BDepth>=1 && BDepth<=2);
    static_assert(OutputSlots>=2 && OutputSlots<=4);
    static_assert(TM*TN*4*CDepth<=131072);
    static_assert(TM*L0K*L0Slots<=65536 && TN*L0K*L0Slots<=65536);
    const int KCap=(K+L0K-1)/L0K*L0K;
    constexpr int tm=TM,tn=TN,vr=8192/TN,ve=(vr*TN+63)/64*64;
    TPipe pipe;
    GlobalTensor<int8_t> gx,gw;
    GlobalTensor<float> gs;
    GlobalTensor<int32_t> gc;
    GlobalTensor<half> gy;
    gx.SetGlobalBuffer((__gm__ int8_t*)x);gw.SetGlobalBuffer((__gm__ int8_t*)w);
    gs.SetGlobalBuffer((__gm__ float*)sc);gc.SetGlobalBuffer((__gm__ int32_t*)workspace);
    gy.SetGlobalBuffer((__gm__ half*)y);
    TBuf<TPosition::A1> a1Buffer[ADepth];
    TBuf<TPosition::B1> b1Buffer[BDepth];
    TBuf<TPosition::A2> a2Buffer;
    TBuf<TPosition::B2> b2Buffer;
    TBuf<TPosition::CO1> accBuffer;
    LocalTensor<int8_t> a1[ADepth],b1[BDepth],a2[L0Slots],b2[L0Slots];
    uint8_t aFree[ADepth],aReady[ADepth],bFree[BDepth],bReady[BDepth];
    uint8_t l0Free[L0Slots],l0Ready[L0Slots],accFree[CDepth],matrixReady;
    bool aUsed[ADepth]={},bUsed[BDepth]={},l0Used[L0Slots]={};
    if ASCEND_IS_AIC {
	for(int i=0;i<ADepth;++i) {
	    pipe.InitBuffer(a1Buffer[i],tm*KCap);a1[i]=a1Buffer[i].template Get<int8_t>();
	    aFree[i]=pipe.AllocEventID<HardEvent::MTE1_MTE2>();
	    aReady[i]=pipe.AllocEventID<HardEvent::MTE2_MTE1>();
	}
	for(int i=0;i<BDepth;++i) {
	    pipe.InitBuffer(b1Buffer[i],(FullB?(N+31)/32*32:tn)*KCap);
	    b1[i]=b1Buffer[i].template Get<int8_t>();
	    bFree[i]=pipe.AllocEventID<HardEvent::MTE1_MTE2>();
	    bReady[i]=pipe.AllocEventID<HardEvent::MTE2_MTE1>();
	}
	pipe.InitBuffer(a2Buffer,L0Slots*tm*L0K);pipe.InitBuffer(b2Buffer,L0Slots*tn*L0K);
	for(int i=0;i<L0Slots;++i) {
	    a2[i]=a2Buffer.Get<int8_t>()[i*tm*L0K];b2[i]=b2Buffer.Get<int8_t>()[i*tn*L0K];
	    l0Free[i]=pipe.AllocEventID<HardEvent::M_MTE1>();
	    l0Ready[i]=pipe.AllocEventID<HardEvent::MTE1_M>();
	}
	pipe.InitBuffer(accBuffer,CDepth*tm*tn*4);
	for(int i=0;i<CDepth;++i)accFree[i]=pipe.AllocEventID<HardEvent::FIX_M>();
	matrixReady=pipe.AllocEventID<HardEvent::M_FIX>();
    }
    // The next INT32 tile can be loaded while Vector consumes the other slot.
    TQue<TPosition::VECIN,DoubleInput?2:1> cq;
    TQue<TPosition::VECOUT,1> oq;
    TBuf<TPosition::VECCALC> zb,groupCache;
    if ASCEND_IS_AIV {
	// A 512-byte slot stride gives both CQ slots the same bank-group phase.
        // The extra 256 bytes after OQ place z opposite the INT32/GELU scratch.
        constexpr int cBytes=(tm/2*tn+tn)*4+(tm*tn>16384?256:0);
        pipe.InitBuffer(cq,DoubleInput?2:1,DoubleInput?(cBytes+511)/512*512:cBytes);
        pipe.InitBuffer(oq,1,ve*2+(DoubleInput?256:0));pipe.InitBuffer(zb,ve*4);
	pipe.InitBuffer(groupCache,(E*8+31)/32*32);
	GlobalTensor<int64_t> gg;gg.SetGlobalBuffer((__gm__ int64_t*)groups);
	DataCopyPad(groupCache.Get<int64_t>(),gg,{1,uint32_t(E*8),0,0,0},{true,0,0,int64_t(0)});
	auto ready=pipe.FetchEventID<HardEvent::MTE2_S>();
	SetFlag<HardEvent::MTE2_S>(ready);WaitFlag<HardEvent::MTE2_S>(ready);
    }
    int blockIdx=int(GetBlockIdx()),lane=0;
    if ASCEND_IS_AIV {lane=blockIdx&1;blockIdx/=2;}
    const int blockNum=int(GetBlockNum()),nc=(N+tn-1)/tn,nUnits=(N+31)/32;
    int64_t totalTasks=0;
    int previous=0;
    for(int e=0;e<E;++e) {
	int end=0;
	if ASCEND_IS_AIC {end=int(((__gm__ int64_t*)groups)[e]);}
	if ASCEND_IS_AIV {end=int(groupCache.Get<int64_t>().GetValue(e));}
	if(end<previous)end=previous;if(end>M)end=M;
	totalTasks+=int64_t((end-previous+tm-1)/tm)*nc;previous=end;
    }
    const int64_t ownedBegin=totalTasks*blockIdx/blockNum,ownedEnd=totalTasks*(blockIdx+1)/blockNum;
    int64_t taskOffset=0;
    int local=0,begin=0;
    for(int e=0;e<E;++e) {
	int end=0;
	if ASCEND_IS_AIC {end=int(((__gm__ int64_t*)groups)[e]);}
	if ASCEND_IS_AIV {end=int(groupCache.Get<int64_t>().GetValue(e));}
	if(end<begin)end=begin;if(end>M)end=M;
	const int mt=(end-begin+tm-1)/tm;
	const int64_t tasks=int64_t(mt)*nc;
	const int64_t first=ownedBegin>taskOffset?ownedBegin-taskOffset:0;
	const int64_t limit=ownedEnd-taskOffset<tasks?ownedEnd-taskOffset:tasks;
	int as=0,bs=0;
	bool freshA=true,freshB=true;
	for(int64_t task=first;task<limit;++task) {
	    const int mi=Order?task%mt:task/nc,ni=Order?task/mt:task%nc;
	    const int row=begin+mi*tm,rows=end-row<tm?end-row:tm;
	    const int col=Balance?(ni*nUnits/nc)*32:ni*tn;
	    const int colEnd=Balance?((ni+1)*nUnits/nc)*32:col+tn;
	    const int cols=(colEnd<N?colEnd:N)-col,pitch=(cols+31)/32*32;
	    const bool next=task+1<limit;
	    const int nextM=next?(Order?(task+1)%mt:(task+1)/nc):mi;
	    const int nextN=next?(Order?(task+1)/mt:(task+1)%nc):ni;
	    const bool changeA=!next || !Reuse || nextM!=mi;
	    const bool changeB=!next || (!FullB && (!Reuse || nextN!=ni));
	    const int nas=(ADepth==2 && changeA)?as^1:as;
	    const int nbs=(BDepth==2 && changeB)?bs^1:bs;
	    const int slot=local%OutputSlots;
	    const uint16_t tileFlag=8+slot,freeFlag=12+slot;
	    auto gcSlot=gc[int64_t(blockIdx*OutputSlots+slot)*tm*tn];
	    if ASCEND_IS_AIC {
		if(freshA && (task==first || ADepth==1)) {
		    ResidentLoadA<tm>(a1[as],gx,row,rows,K,aUsed[as],aFree[as],aReady[as],KCap);
		    aUsed[as]=true;SetFlag<HardEvent::MTE2_MTE1>(aReady[as]);
		}
		if(freshB && (task==first || BDepth==1)) {
		    if(bUsed[bs])WaitFlag<HardEvent::MTE1_MTE2>(bFree[bs]);
		    PackedResidentLoadB(b1[bs],gw,e,FullB?0:col,FullB?N:cols,K,N,KCap);
		    bUsed[bs]=true;SetFlag<HardEvent::MTE2_MTE1>(bReady[bs]);
		}
		if(freshA)WaitFlag<HardEvent::MTE2_MTE1>(aReady[as]);
		if(freshB)WaitFlag<HardEvent::MTE2_MTE1>(bReady[bs]);
		// Prefetch real future tiles while MTE1/Cube consume disjoint current slots.
		if(next && changeB && BDepth==2) {
		    const int ncol=Balance?(nextN*nUnits/nc)*32:nextN*tn;
		    const int nend=Balance?((nextN+1)*nUnits/nc)*32:ncol+tn;
		    if(bUsed[nbs])WaitFlag<HardEvent::MTE1_MTE2>(bFree[nbs]);
		    PackedResidentLoadB(b1[nbs],gw,e,ncol,(nend<N?nend:N)-ncol,K,N,KCap);
		    bUsed[nbs]=true;SetFlag<HardEvent::MTE2_MTE1>(bReady[nbs]);
		}
		if(next && changeA && ADepth==2) {
		    const int nrow=begin+nextM*tm,nrows=end-nrow<tm?end-nrow:tm;
		    ResidentLoadA<tm>(a1[nas],gx,nrow,nrows,K,aUsed[nas],aFree[nas],aReady[nas],KCap);
		    aUsed[nas]=true;SetFlag<HardEvent::MTE2_MTE1>(aReady[nas]);
		}
		const int cs=local%CDepth;
		auto acc=accBuffer.Get<int32_t>()[cs*tm*tn];
		for(int sub=0;sub<KCap/L0K;++sub) {
		    const int ls=sub%L0Slots;
		    if(l0Used[ls])WaitFlag<HardEvent::M_MTE1>(l0Free[ls]);
		    LoadData2dParams la;la.repeatTimes=(rows+15)/16;la.srcStride=1;
		    la.dstGap=L0K/32-1;la.ifTranspose=false;
		    LoadData2dTransposeParams lb{0,uint8_t(pitch/32),uint16_t(KCap/32),1,0,0};
#pragma unroll
		    for(int ki=0;ki<L0K/32;++ki) {
			LoadData(a2[ls][ki*512],a1[as][(sub*(L0K/32)+ki)*tm*32],la);
			LoadDataWithTranspose(b2[ls][ki*pitch*32],
			    b1[bs][(FullB?col*KCap:0)+(sub*(L0K/32)+ki)*1024],lb);
		    }
		    SetFlag<HardEvent::MTE1_M>(l0Ready[ls]);WaitFlag<HardEvent::MTE1_M>(l0Ready[ls]);
		    if(!sub && local>=CDepth)WaitFlag<HardEvent::FIX_M>(accFree[cs]);
		    MmadParams mad;mad.m=(rows+15)/16*16;mad.n=pitch;mad.k=L0K;mad.cmatrixInitVal=sub==0;mad.unitFlag=(sub+1==KCap/L0K)?3:2;
		    Mmad(acc,a2[ls],b2[ls],mad);
		    if((mad.m/16)*(mad.n/16)<10)PipeBarrier<PIPE_M>();
		    SetFlag<HardEvent::M_MTE1>(l0Free[ls]);l0Used[ls]=true;
		}
		if(changeA)SetFlag<HardEvent::MTE1_MTE2>(aFree[as]);
		if(changeB)SetFlag<HardEvent::MTE1_MTE2>(bFree[bs]);
		// UnitFlag publishes each completed final-K fractal to Fixpipe.
		if(local>=OutputSlots)CrossCoreWaitFlag<2,PIPE_FIX>(freeFlag);
		FixpipeParamsV220 fix;fix.unitFlag=3;fix.nSize=pitch;fix.mSize=(rows+15)/16*16;
		fix.srcStride=fix.mSize;fix.dstStride=tn;
		Fixpipe<int32_t,int32_t,CFG_ROW_MAJOR>(gcSlot,acc,fix);
		SetFlag<HardEvent::FIX_M>(accFree[cs]);CrossCoreSetFlag<2,PIPE_FIX>(tileFlag);
	    }
						    if ASCEND_IS_AIV
			{
			    CrossCoreWaitFlag<2, PIPE_MTE2>(tileFlag);
			    const int halfRows = (rows + 1) / 2;
			    const int rowOffset = lane * halfRows;
			    const int vectorRows = lane ? rows - halfRows : halfRows;
			    auto c = cq.template AllocTensor<int32_t>();
			    auto scale = c.template ReinterpretCast<float>()[((tm + 1) / 2 * tn) +
								    (tm * tn > 16384 ? 64 : 0)];

			    if (pitch != (cols + 7) / 8 * 8)
			    {
				Duplicate(c, int32_t(0), vectorRows * pitch);
				auto event = pipe.FetchEventID<HardEvent::V_MTE2>();
				SetFlag<HardEvent::V_MTE2>(event);
				WaitFlag<HardEvent::V_MTE2>(event);
			    }

			    if (vectorRows > 0)
				DataCopyPad(c, gcSlot[int64_t(rowOffset) * tn],
					    {uint16_t(vectorRows), uint32_t(cols * sizeof(int32_t)),
					     uint32_t((tn - cols) * sizeof(int32_t)),
					     uint32_t((pitch * 4 - (cols * 4 + 31) / 32 * 32) / 32),
					     0},
					    {true, 0, 0, 0});
			    if (cols < 64)
			    {
				Duplicate(scale, 0.0f, tn);
				auto initialized = pipe.FetchEventID<HardEvent::V_MTE2>();
				SetFlag<HardEvent::V_MTE2>(initialized);
				WaitFlag<HardEvent::V_MTE2>(initialized);
			    }
			    DataCopyPad(scale, gs[(int64_t)e * N + col],
					{1, (uint32_t)(cols * sizeof(float)), 0, 0, 0},
					{true, 0, 0, 0.0f});
			    cq.EnQue(c);
			    c = cq.template DeQue<int32_t>();

			    CrossCoreSetFlag<2, PIPE_MTE2>(freeFlag);

			    auto z = zb.Get<float>();
			    auto p = c.template ReinterpretCast<float>();
			    auto u = p;
			    auto t = p;

			    const BinaryRepeatParams bcast{
				1, 1, 1, (uint8_t)(pitch / 8), (uint8_t)(pitch / 8), 0};
			    for (int r = 0; r < vectorRows; r += vr)
			    {
				const int batch = (vectorRows - r < vr) ? (vectorRows - r) : vr;
				const uint32_t count = (uint32_t)batch * pitch;
				Cast(z, c[r * pitch], RoundMode::CAST_NONE, count);
				PipeBarrier<PIPE_V>();
				if (cols < 64)
				{
				    Mul(z, z, scale, (uint64_t)(pitch < 64 ? pitch : 64),
					(uint8_t)batch, bcast);
				}
				else
				{
				    for (int c0 = 0; c0 < cols; c0 += 64)
				    {
					const int chunk = (cols - c0 < 64) ? (cols - c0) : 64;
					Mul(z[c0], z[c0], scale[c0], (uint64_t)chunk,
					    (uint8_t)batch, bcast);
				    }
				}
				PipeBarrier<PIPE_V>();

				p = c[r * pitch].template ReinterpretCast<float>();
				u = p;
				ResidentGelu(z,p,count);
				auto out = oq.AllocTensor<half>();
				Cast(out, z, RoundMode::CAST_RINT, count);
				oq.EnQue(out);
				out = oq.DeQue<half>();
				const uint32_t outBytes = (uint32_t)cols * (uint32_t)sizeof(half);
				const uint32_t outPitchBytes =
				    (uint32_t)pitch * (uint32_t)sizeof(half);
				const uint32_t outSrcStride =
				    (outPitchBytes - ((outBytes + 31U) / 32U) * 32U) / 32U;
				for (int r0 = 0; r0 < batch; r0 += 32)
				{
				    const int rc = batch - r0 < 32 ? batch - r0 : 32;
				    DataCopyPad(gy[(int64_t)(row + rowOffset + r + r0) * N + col],
						out[r0 * pitch],
						{(uint16_t)rc, outBytes, outSrcStride,
						 (uint32_t)((N - cols) * sizeof(half)), 0});
				}
				oq.FreeTensor(out);
			    }
			    cq.FreeTensor(c);
			}

	    as=nas;bs=nbs;freshA=changeA;freshB=changeB;++local;
	}
	taskOffset+=tasks;begin=end;
    }
    if ASCEND_IS_AIV {PipeBarrier<PIPE_ALL>();}
    if ASCEND_IS_AIC {
	for(int i=0;i<OutputSlots;++i)if(local>i)CrossCoreWaitFlag<2,PIPE_MTE2>(12+i);
	for(int i=0;i<CDepth;++i) {
	    if(local>i)WaitFlag<HardEvent::FIX_M>(accFree[i]);
	    pipe.ReleaseEventID<HardEvent::FIX_M>(accFree[i]);
	}
	for(int i=0;i<ADepth;++i) {
	    if(aUsed[i])WaitFlag<HardEvent::MTE1_MTE2>(aFree[i]);
	    pipe.ReleaseEventID<HardEvent::MTE1_MTE2>(aFree[i]);
	    pipe.ReleaseEventID<HardEvent::MTE2_MTE1>(aReady[i]);
	}
	for(int i=0;i<BDepth;++i) {
	    if(bUsed[i])WaitFlag<HardEvent::MTE1_MTE2>(bFree[i]);
	    pipe.ReleaseEventID<HardEvent::MTE1_MTE2>(bFree[i]);
	    pipe.ReleaseEventID<HardEvent::MTE2_MTE1>(bReady[i]);
	}
	for(int i=0;i<L0Slots;++i) {
	    if(l0Used[i])WaitFlag<HardEvent::M_MTE1>(l0Free[i]);
	    pipe.ReleaseEventID<HardEvent::M_MTE1>(l0Free[i]);
	    pipe.ReleaseEventID<HardEvent::MTE1_M>(l0Ready[i]);
	}
	pipe.ReleaseEventID<HardEvent::M_FIX>(matrixReady);
    }
}
}

namespace gmm_device {
// Layout-only transformations; every live input element is copied on Device.
template<int TM,int ChunkRows,bool Compact>
__aicore__ inline void SplitResidentLoadA(LocalTensor<int8_t> a,GlobalTensor<int8_t> x,
    int row,int rows,int K,bool reused,uint8_t freeId,uint8_t readyId,int KCap) {
    if(reused)WaitFlag<HardEvent::MTE1_MTE2>(freeId);
    const int stride=Compact?(rows+15)/16*16:TM;
    if(K%64) {
        Fill(a[(K/32)*stride*32].template ReinterpretCast<uint32_t>(),
            InitConstValueParams<uint32_t>(1,stride*(KCap-K/32*32)/32,0,0));
        PipeBarrier<PIPE_MTE2>();
    }
    Nd2NzParams p;
    p.ndNum=1;p.dValue=K;p.srcNdMatrixStride=0;p.srcDValue=K;
    p.dstNzC0Stride=stride;p.dstNzNStride=1;p.dstNzMatrixStride=0;
    constexpr int step=ChunkRows?ChunkRows:TM;
    for(int r=0;r<rows;r+=step) {
        p.nValue=rows-r<step?rows-r:step;
        DataCopy(a[r*32],x[int64_t(row+r)*K],p);
    }
}
template<int ChunkK,int Fold,bool Rotate>
__aicore__ inline void SplitResidentLoadB(LocalTensor<int8_t> b,GlobalTensor<int8_t> w,
    int e,int col,int cols,int K,int N,int KCap,const uint8_t* ready) {
    const int pn=(cols+31)/32*32;
    if(K<KCap) {
        Fill(b[K*32].template ReinterpretCast<uint32_t>(),
            InitConstValueParams<uint32_t>(pn/32,KCap-K,K,0));
        PipeBarrier<PIPE_MTE2>();
    }
    const int chunks=(K+ChunkK-1)/ChunkK;
    const int start=Rotate?int(GetBlockIdx())%chunks:0;
    Nd2NzParams p;p.dValue=cols;p.dstNzC0Stride=KCap;
    for(int i=0;i<chunks;++i) {
        const int offset=((start+i)%chunks)*ChunkK;
        const int rows=K-offset<ChunkK?K-offset:ChunkK,bulk=rows/Fold*Fold;
        if(bulk) {
            p.ndNum=Fold;p.nValue=bulk/Fold;p.srcNdMatrixStride=N;
            p.srcDValue=Fold*N;p.dstNzNStride=Fold;p.dstNzMatrixStride=32;
            DataCopy(b[offset*32],w[(int64_t(e)*K+offset)*N+col],p);
        }
        if(bulk<rows) {
            p.ndNum=1;p.nValue=rows-bulk;p.srcNdMatrixStride=0;
            p.srcDValue=N;p.dstNzNStride=1;p.dstNzMatrixStride=0;
            DataCopy(b[(offset+bulk)*32],w[(int64_t(e)*K+offset+bulk)*N+col],p);
        }
        SetFlag<HardEvent::MTE2_MTE1>(ready[i]);
    }
}
}

namespace gmm_device {
template<int TM,int L0K,bool Load3D,bool Compact>
__aicore__ inline void SplitLoadL0(LocalTensor<int8_t> a2,LocalTensor<int8_t> b2,
    LocalTensor<int8_t> a1,LocalTensor<int8_t> b1,int rows,int pitch,int offset,int ck,int KCap) {
    if constexpr(Load3D) {
        LoadData3DParamsV2Pro p;
        p.channelSize=KCap;
        p.extConfig=(uint64_t(offset)<<32)|(uint64_t((rows+15)/16*16)<<16)|uint64_t(ck);
        LoadData(a2,a1,p);
    }
    LoadData2dParams la;la.repeatTimes=(rows+15)/16;la.srcStride=1;
    la.dstGap=ck/32-1;la.ifTranspose=false;
    LoadData2dTransposeParams lb{0,uint8_t(pitch/32),uint16_t(KCap/32),1,0,0};
#pragma unroll
    for(int ki=0;ki<L0K/32;++ki)if(ki*32<ck) {
        if constexpr(!Load3D)
            LoadData(a2[ki*512],a1[(offset/32+ki)*(Compact?(rows+15)/16*16:TM)*32],la);
        LoadDataWithTranspose(b2[ki*pitch*32],b1[(offset/32+ki)*1024],lb);
    }
}
template<int TileM,int TileN,int Fold,int L0K,int L0Slots,int CDepth,int OutputSlots,bool Load3D,bool UnitFlag,int ChunkK,int ChunkRows,bool Compact,bool Rotate>
__aicore__ __attribute__((always_inline)) inline void
ComputeSplitTransport(GM_ADDR x,GM_ADDR w,GM_ADDR sc,GM_ADDR groups,GM_ADDR y,GM_ADDR workspace,
    int M,int K,int N,int E)
{
    const int KCap=(K+63)/64*64;
    TPipe pipe;
    GlobalTensor<int8_t> gx,gw;
    GlobalTensor<float> gs;
    GlobalTensor<int32_t> gc;
    GlobalTensor<half> gy;
    gx.SetGlobalBuffer((__gm__ int8_t*)x);gw.SetGlobalBuffer((__gm__ int8_t*)w);
    gs.SetGlobalBuffer((__gm__ float*)sc);gc.SetGlobalBuffer((__gm__ int32_t*)workspace);
    gy.SetGlobalBuffer((__gm__ half*)y);
    constexpr int tm=TileM,tn=TileN,capacity=8192,vr=capacity/tn,ve=(vr*tn+63)/64*64;
    TBuf<TPosition::A1> a1Buffer[2];
    TBuf<TPosition::B1> b1Buffer[2];
    TBuf<TPosition::A2> a2Buffer;
    TBuf<TPosition::B2> b2Buffer;
    TBuf<TPosition::CO1> accBuffer;
    LocalTensor<int8_t> a1[2],b1[2],a2[L0Slots],b2[L0Slots];
    uint8_t l1Free[2],l1Ready[2],l0Free[L0Slots],l0Ready[L0Slots];
    // Original L1 capacity check bounds this route to three B chunks.
    uint8_t accumulatorFree[CDepth],matrixReady=0,bFree[2],bReady[2][3];
    bool l1Used[2]={},l0Used[L0Slots]={},bUsed[2]={};
    if ASCEND_IS_AIC {
	pipe.InitBuffer(a1Buffer[0],tm*KCap);
	for(int i=0;i<2;++i) {
	    pipe.InitBuffer(b1Buffer[i],tn*KCap);
	    b1[i]=b1Buffer[i].Get<int8_t>();
	    bFree[i]=pipe.AllocEventID<HardEvent::MTE1_MTE2>();
	    for(int j=0;j<3;++j)bReady[i][j]=pipe.AllocEventID<HardEvent::MTE2_MTE1>();
	}
#pragma unroll
	for(int i=0;i<1;++i) {
	    a1[i]=a1Buffer[i].Get<int8_t>();
	    l1Free[i]=pipe.AllocEventID<HardEvent::MTE1_MTE2>();
	    l1Ready[i]=pipe.AllocEventID<HardEvent::MTE2_MTE1>();
	}
	pipe.InitBuffer(a2Buffer,L0Slots*tm*L0K);pipe.InitBuffer(b2Buffer,L0Slots*tn*L0K);
#pragma unroll
	for(int i=0;i<L0Slots;++i) {
	    a2[i]=a2Buffer.Get<int8_t>()[i*tm*L0K];b2[i]=b2Buffer.Get<int8_t>()[i*tn*L0K];
	    l0Free[i]=pipe.AllocEventID<HardEvent::M_MTE1>();
	    l0Ready[i]=pipe.AllocEventID<HardEvent::MTE1_M>();
	}
	pipe.InitBuffer(accBuffer,CDepth*tm*tn*4);
	for(int i=0;i<CDepth;++i)accumulatorFree[i]=pipe.AllocEventID<HardEvent::FIX_M>();
        if constexpr(Load3D){const uint8_t pads[4]={};SetFmatrix(1,tm,pads,FmatrixMode::FMATRIX_LEFT);}
	matrixReady=pipe.AllocEventID<HardEvent::M_FIX>();
    }
    TQue<TPosition::VECIN,1> cq;
    TQue<TPosition::VECOUT,1> oq;
    TBuf<TPosition::VECCALC> zb,pb,groupCache;
    if ASCEND_IS_AIV {
	pipe.InitBuffer(cq,1,uint32_t((tm/2*tn+tn)*4)+(tm*tn>16384?256:0));
	pipe.InitBuffer(oq,1,ve*2);pipe.InitBuffer(zb,ve*4);
	pipe.InitBuffer(groupCache,(E*8+31)/32*32);
	GlobalTensor<int64_t> gg;gg.SetGlobalBuffer((__gm__ int64_t*)groups);
	DataCopyPad(groupCache.Get<int64_t>(),gg,{1,uint32_t(E*8),0,0,0},{true,0,0,int64_t(0)});
	auto ready=pipe.FetchEventID<HardEvent::MTE2_S>();
	SetFlag<HardEvent::MTE2_S>(ready);WaitFlag<HardEvent::MTE2_S>(ready);
    }
    int blockIdx=int(GetBlockIdx()),lane=0;
    if ASCEND_IS_AIV {lane=blockIdx&1;blockIdx/=2;}
    const int blockNum=int(GetBlockNum());
    const int nc=(N+tn-1)/tn;
    const int avgStride=N/nc/32*32;
    const int strideN=N-(nc-1)*avgStride>tn?avgStride+32:avgStride;
    int64_t totalTasks=0;
    int previous=0;
    for(int expert=0;expert<E;++expert) {
	int last=0;
	if ASCEND_IS_AIC {last=int(((__gm__ int64_t*)groups)[expert]);}
	if ASCEND_IS_AIV {last=int(groupCache.Get<int64_t>().GetValue(expert));}
	if(last<previous)last=previous;if(last>M)last=M;
	totalTasks+=int64_t((last-previous+tm-1)/tm)*nc;
	previous=last;
    }
    const int64_t ownedBegin=totalTasks*blockIdx/blockNum;
    const int64_t ownedEnd=totalTasks*(blockIdx+1)/blockNum;
    int64_t taskOffset=0;
    int local=0,begin=0;
    for(int e=0;e<E;++e) {
	int end=0;
	if ASCEND_IS_AIC {end=int(((__gm__ int64_t*)groups)[e]);}
	if ASCEND_IS_AIV {end=int(groupCache.Get<int64_t>().GetValue(e));}
	if(end<begin)end=begin;if(end>M)end=M;
	const int me=end-begin,mt=(me+tm-1)/tm;
	const int64_t tasks=int64_t(mt)*nc;
	const int64_t first=ownedBegin>taskOffset?ownedBegin-taskOffset:0;
	const int64_t limit=ownedEnd-taskOffset<tasks?ownedEnd-taskOffset:tasks;
	for(int64_t task=first;task<limit;) {
	    const int mi=task/nc,niStart=task%nc;
	    const int row=begin+mi*tm,rows=end-row<tm?end-row:tm;
	    const int tiles=nc-niStart<limit-task?nc-niStart:int(limit-task);
	    if ASCEND_IS_AIC {
		SplitResidentLoadA<tm,ChunkRows,Compact>(a1[0],gx,row,rows,K,l1Used[0],l1Free[0],l1Ready[0],KCap);
		l1Used[0]=true;
		const int bs=local&1, col=niStart*strideN;
		const int cols=niStart+1==nc?N-col:strideN;
		if(bUsed[bs])WaitFlag<HardEvent::MTE1_MTE2>(bFree[bs]);
		SplitResidentLoadB<ChunkK,Fold,Rotate>(b1[bs],gw,e,col,cols,K,N,KCap,bReady[bs]);
		bUsed[bs]=true;

	    }
	    for(int tile=0;tile<tiles;++tile) {
		const int ni=niStart+tile,col=ni*strideN;
		const int cols=ni+1==nc?N-col:strideN,pitch=(cols+31)/32*32;
		const int slot=local%OutputSlots;
		const uint16_t tileFlag=8+slot;
		const uint16_t freeFlag=12+slot;
		auto gcSlot=gc[int64_t(blockIdx*OutputSlots+slot)*tm*tn];
		if ASCEND_IS_AIC {
		    const int as=0;
		    const int bs=local&1;

		    if(tile+1<tiles) {
			const int next=bs^1,nextCol=(ni+1)*strideN;
			const int nextCols=ni+2==nc?N-nextCol:strideN;
			if(bUsed[next])WaitFlag<HardEvent::MTE1_MTE2>(bFree[next]);
			SplitResidentLoadB<ChunkK,Fold,Rotate>(b1[next],gw,e,nextCol,nextCols,K,N,KCap,bReady[next]);
			bUsed[next]=true;

		    }

		    const int cs=local%CDepth;auto acc=accBuffer.Get<int32_t>()[cs*tm*tn];
            const int chunks=(K+ChunkK-1)/ChunkK;
            const int firstChunk=Rotate?blockIdx%chunks:0;
            int sub=0;
            for(int ci=0;ci<chunks;++ci) {
                WaitFlag<HardEvent::MTE2_MTE1>(bReady[bs][ci]);
                const int chunk=(firstChunk+ci)%chunks;
                const int endK=KCap<(chunk+1)*ChunkK?KCap:(chunk+1)*ChunkK;
                for(int offset=chunk*ChunkK;offset<endK;offset+=L0K,++sub) {
                    const int ls=sub%L0Slots,ck=endK-offset<L0K?endK-offset:L0K;
                    if(l0Used[ls])WaitFlag<HardEvent::M_MTE1>(l0Free[ls]);
                    SplitLoadL0<tm,L0K,Load3D,Compact>(a2[ls],b2[ls],a1[as],b1[bs],rows,pitch,offset,ck,KCap);
                    SetFlag<HardEvent::MTE1_M>(l0Ready[ls]);WaitFlag<HardEvent::MTE1_M>(l0Ready[ls]);
                    if(!sub && local>=CDepth)WaitFlag<HardEvent::FIX_M>(accumulatorFree[cs]);
                    MmadParams mad;
                    mad.m=(rows+15)/16*16;mad.n=pitch;mad.k=ck;mad.cmatrixInitVal=sub==0;
                    if constexpr(UnitFlag)mad.unitFlag=sub+1==(KCap+L0K-1)/L0K?3:2;
                    Mmad(acc,a2[ls],b2[ls],mad);
                    if((mad.m/16)*(mad.n/16)<10)PipeBarrier<PIPE_M>();
                    SetFlag<HardEvent::M_MTE1>(l0Free[ls]);l0Used[ls]=true;
                }
            }
		    SetFlag<HardEvent::MTE1_MTE2>(bFree[bs]);
		    if constexpr(!UnitFlag){SetFlag<HardEvent::M_FIX>(matrixReady);WaitFlag<HardEvent::M_FIX>(matrixReady);}
		    if(local>=OutputSlots)CrossCoreWaitFlag<2,PIPE_FIX>(freeFlag);
		    FixpipeParamsV220 fix;if constexpr(UnitFlag)fix.unitFlag=3;fix.nSize=pitch;fix.mSize=(rows+15)/16*16;fix.srcStride=fix.mSize;fix.dstStride=tn;
		    Fixpipe<int32_t,int32_t,CFG_ROW_MAJOR>(gcSlot,acc,fix);
		    SetFlag<HardEvent::FIX_M>(accumulatorFree[cs]);
		    CrossCoreSetFlag<2,PIPE_FIX>(tileFlag);
		}
					if ASCEND_IS_AIV
			{
			    CrossCoreWaitFlag<2, PIPE_MTE2>(tileFlag);
			    const int halfRows = (rows + 1) / 2;
			    const int rowOffset = lane * halfRows;
			    const int vectorRows = lane ? rows - halfRows : halfRows;
			    auto c = cq.AllocTensor<int32_t>();
			    auto scale = c.ReinterpretCast<float>()[((tm + 1) / 2 * tn) +
								    (tm * tn > 16384 ? 64 : 0)];

			    if (pitch != (cols + 7) / 8 * 8)
			    {
				Duplicate(c, int32_t(0), vectorRows * pitch);
				auto event = pipe.FetchEventID<HardEvent::V_MTE2>();
				SetFlag<HardEvent::V_MTE2>(event);
				WaitFlag<HardEvent::V_MTE2>(event);
			    }

			    if (vectorRows > 0)
				DataCopyPad(c, gcSlot[int64_t(rowOffset) * tn],
					    {uint16_t(vectorRows), uint32_t(cols * sizeof(int32_t)),
					     uint32_t((tn - cols) * sizeof(int32_t)),
					     uint32_t((pitch * 4 - (cols * 4 + 31) / 32 * 32) / 32),
					     0},
					    {true, 0, 0, 0});
			    if (cols < 64)
			    {
				Duplicate(scale, 0.0f, tn);
				auto initialized = pipe.FetchEventID<HardEvent::V_MTE2>();
				SetFlag<HardEvent::V_MTE2>(initialized);
				WaitFlag<HardEvent::V_MTE2>(initialized);
			    }
			    DataCopyPad(scale, gs[(int64_t)e * N + col],
					{1, (uint32_t)(cols * sizeof(float)), 0, 0, 0},
					{true, 0, 0, 0.0f});
			    cq.EnQue(c);
			    c = cq.DeQue<int32_t>();

			    CrossCoreSetFlag<2, PIPE_MTE2>(freeFlag);

			    auto z = zb.Get<float>();
			    auto p = c.ReinterpretCast<float>();
			    auto u = p;
			    auto t = p;

			    const BinaryRepeatParams bcast{
				1, 1, 1, (uint8_t)(pitch / 8), (uint8_t)(pitch / 8), 0};
			    for (int r = 0; r < vectorRows; r += vr)
			    {
				const int batch = (vectorRows - r < vr) ? (vectorRows - r) : vr;
				const uint32_t count = (uint32_t)batch * pitch;
				Cast(z, c[r * pitch], RoundMode::CAST_NONE, count);
				PipeBarrier<PIPE_V>();
				if (cols < 64)
				{
				    Mul(z, z, scale, (uint64_t)(pitch < 64 ? pitch : 64),
					(uint8_t)batch, bcast);
				}
				else
				{
				    for (int c0 = 0; c0 < cols; c0 += 64)
				    {
					const int chunk = (cols - c0 < 64) ? (cols - c0) : 64;
					Mul(z[c0], z[c0], scale[c0], (uint64_t)chunk,
					    (uint8_t)batch, bcast);
				    }
				}
				PipeBarrier<PIPE_V>();

				p = c[r * pitch].ReinterpretCast<float>();
				u = p;
				ResidentGelu(z,p,count);
				auto out = oq.AllocTensor<half>();
				Cast(out, z, RoundMode::CAST_RINT, count);
				oq.EnQue(out);
				out = oq.DeQue<half>();
				const uint32_t outBytes = (uint32_t)cols * (uint32_t)sizeof(half);
				const uint32_t outPitchBytes =
				    (uint32_t)pitch * (uint32_t)sizeof(half);
				const uint32_t outSrcStride =
				    (outPitchBytes - ((outBytes + 31U) / 32U) * 32U) / 32U;
				for (int r0 = 0; r0 < batch; r0 += 32)
				{
				    const int rc = batch - r0 < 32 ? batch - r0 : 32;
				    DataCopyPad(gy[(int64_t)(row + rowOffset + r + r0) * N + col],
						out[r0 * pitch],
						{(uint16_t)rc, outBytes, outSrcStride,
						 (uint32_t)((N - cols) * sizeof(half)), 0});
				}
				oq.FreeTensor(out);
			    }
			    cq.FreeTensor(c);
			}

		++local;
	    }
	    if ASCEND_IS_AIC {SetFlag<HardEvent::MTE1_MTE2>(l1Free[0]);}
	    task+=tiles;
	}
	taskOffset+=tasks;begin=end;
    }
    if ASCEND_IS_AIV {PipeBarrier<PIPE_ALL>();}
    if ASCEND_IS_AIC {
	for(int i=0;i<OutputSlots;++i)if(local>i)CrossCoreWaitFlag<2,PIPE_MTE2>(12+i);
	for(int i=0;i<CDepth;++i)if(local>i)WaitFlag<HardEvent::FIX_M>(accumulatorFree[i]);
	for(int i=0;i<2;++i) {
	    if(bUsed[i])WaitFlag<HardEvent::MTE1_MTE2>(bFree[i]);
	    pipe.ReleaseEventID<HardEvent::MTE1_MTE2>(bFree[i]);
	    for(int j=0;j<3;++j)pipe.ReleaseEventID<HardEvent::MTE2_MTE1>(bReady[i][j]);
	}
#pragma unroll
	for(int i=0;i<1;++i) {
	    if(l1Used[i])WaitFlag<HardEvent::MTE1_MTE2>(l1Free[i]);
	    pipe.ReleaseEventID<HardEvent::MTE1_MTE2>(l1Free[i]);
	    pipe.ReleaseEventID<HardEvent::MTE2_MTE1>(l1Ready[i]);
	}
#pragma unroll
	for(int i=0;i<L0Slots;++i) {
	    if(l0Used[i])WaitFlag<HardEvent::M_MTE1>(l0Free[i]);
	    pipe.ReleaseEventID<HardEvent::M_MTE1>(l0Free[i]);
	    pipe.ReleaseEventID<HardEvent::MTE1_M>(l0Ready[i]);
	}
	for(int i=0;i<CDepth;++i)pipe.ReleaseEventID<HardEvent::FIX_M>(accumulatorFree[i]);
	pipe.ReleaseEventID<HardEvent::M_FIX>(matrixReady);
    }
}

}

// Strategies copied from the user-provided reference. Arithmetic and schedules retained.
namespace gmm_imported {
using namespace gmm_device;
__aicore__ inline void OwnedWidePrefetch(GlobalTensor<int8_t>gx,GlobalTensor<int8_t>gw,
					      LocalTensor<int8_t>a1,LocalTensor<int8_t>b1,
					      bool reused,uint8_t freeId,uint8_t readyId,int row,
					      int col,int rows,int cols,int expert,int K,int N,
					      int panel)
    {
	if(reused)
	    WaitFlag<HardEvent::MTE1_MTE2>(freeId);
	Nd2NzParams ap;
	ap.ndNum=1;
	ap.nValue=rows;
	ap.dValue=256;
	ap.srcNdMatrixStride=0;
	ap.srcDValue=K;
	ap.dstNzC0Stride=64;
	ap.dstNzNStride=1;
	ap.dstNzMatrixStride=0;
	Nd2NzParams bp;
	bp.ndNum=1;
	bp.nValue=256/1;
	bp.dValue=cols;
	bp.srcNdMatrixStride=N;
	bp.srcDValue=1*N;
	bp.dstNzC0Stride=256;
	bp.dstNzNStride=1;
	bp.dstNzMatrixStride=32;
	DataCopy(b1,gw[int64_t(expert)*K*N+int64_t(panel*256)*N+col],bp);
	DataCopy(a1,gx[int64_t(row)*K+panel*256],ap);
	SetFlag<HardEvent::MTE2_MTE1>(readyId);
    }
__aicore__ inline void ComputeOwnedWide(GM_ADDR x,GM_ADDR w,GM_ADDR sc,GM_ADDR groups,GM_ADDR y,
		      GM_ADDR workspace,int M,int K,int N,int E,
		      AscendC::tiling::TCubeTiling tiling,uint32_t l1Half)
    {
	TPipe pipe;
	GlobalTensor<int8_t>gx,gw;
	GlobalTensor<float>gs;
	GlobalTensor<half>gc;
	GlobalTensor<half>gy;
	gx.SetGlobalBuffer((__gm__ int8_t*)x);
	gw.SetGlobalBuffer((__gm__ int8_t*)w);
	gs.SetGlobalBuffer((__gm__ float*)sc);
	gy.SetGlobalBuffer((__gm__ half*)y);
	gc.SetGlobalBuffer((__gm__ half*)workspace);

	const int tm=64;
	const int tn=512;

	const int capacity=16384;
	const int vr=capacity/tn;
	const int ve=vr*tn;
	TBuf<TPosition::A1>a1Buffer[2],l1Gap;
	TBuf<TPosition::B1>b1Buffer[2];
	TBuf<TPosition::A2>a2Buffer[2];
	TBuf<TPosition::B2>b2Buffer[2];
	TBuf<TPosition::CO1>accBuffer;
	LocalTensor<int8_t>a1[2],b1[2],a2[2],b2[2];
	uint8_t l1Free[2],l1Ready[2],l0Free[2],l0Ready[2];
	uint8_t accumulatorFree=0,matrixReady=0;
	bool l1Used[2]={false,false},l0Used[2]={false,false};
	if ASCEND_IS_AIC
	{
	    pipe.InitBuffer(a1Buffer[0],tm*256);
	    pipe.InitBuffer(b1Buffer[0],tn*256);
	    const uint32_t packetBytes=(tm+tn)*256;
	    if(l1Half>packetBytes)
		pipe.InitBuffer(l1Gap,l1Half-packetBytes);
	    pipe.InitBuffer(a1Buffer[1],tm*256);
	    pipe.InitBuffer(b1Buffer[1],tn*256);
#pragma unroll
	    for(int i=0;i<2;++i)
	    {
		pipe.InitBuffer(a2Buffer[i],tm*64);
		pipe.InitBuffer(b2Buffer[i],tn*64);
		a1[i]=a1Buffer[i].Get<int8_t>();
		b1[i]=b1Buffer[i].Get<int8_t>();
		a2[i]=a2Buffer[i].Get<int8_t>();
		b2[i]=b2Buffer[i].Get<int8_t>();
		l1Free[i]=pipe.AllocEventID<HardEvent::MTE1_MTE2>();
		l1Ready[i]=pipe.AllocEventID<HardEvent::MTE2_MTE1>();
		l0Free[i]=pipe.AllocEventID<HardEvent::M_MTE1>();
		l0Ready[i]=pipe.AllocEventID<HardEvent::MTE1_M>();
	    }
	    pipe.InitBuffer(accBuffer,tm*tn*sizeof(int32_t));
	    accumulatorFree=pipe.AllocEventID<HardEvent::FIX_M>();
	    matrixReady=pipe.AllocEventID<HardEvent::M_FIX>();
	}

	TQue<TPosition::VECIN,1>cq,sq;
	TQue<TPosition::VECOUT,1>oq;
	TBuf<TPosition::VECCALC>zb,pb,groupCache;
	if ASCEND_IS_AIV
	{
	    pipe.InitBuffer(cq,1,(uint32_t)((tm+1)/2*tn)*sizeof(int32_t));
	    pipe.InitBuffer(sq,1,(uint32_t)tn*sizeof(float)+(tm*tn>16384?256:0));
	    pipe.InitBuffer(oq,1,(uint32_t)ve*sizeof(half));
	    pipe.InitBuffer(zb,(uint32_t)ve*sizeof(float));
	    if(E>0)
	    {
		pipe.InitBuffer(groupCache,(E*8+31)/32*32);
		GlobalTensor<int64_t>gg;
		gg.SetGlobalBuffer((__gm__ int64_t*)groups);
		DataCopyPad(groupCache.Get<int64_t>(),gg,{1,(uint32_t)(E*8),0,0,0},
			    {true,0,0,int64_t(0)});
		auto ready=pipe.FetchEventID<HardEvent::MTE2_S>();
		SetFlag<HardEvent::MTE2_S>(ready);
		WaitFlag<HardEvent::MTE2_S>(ready);
	    }
	}

	int blockIdx=(int)GetBlockIdx();
	int lane=0;
	if ASCEND_IS_AIV
	{
	    lane=blockIdx&1;
	    blockIdx/=2;
	}
	const int blockNum=(int)GetBlockNum();
	const int nc=(N+tn-1)/tn;
	
    int64_t local=0;
    {
        for(int e=blockIdx;e<E;e+=blockNum){
            int begin=0,end=0;
            if ASCEND_IS_AIC{
                const auto ends=(__gm__ int64_t*)groups;
                begin=e?int(ends[e-1]):0;end=int(ends[e]);
            }
            if ASCEND_IS_AIV{
                auto ends=groupCache.Get<int64_t>();
                begin=e?int(ends.GetValue(e-1)):0;end=int(ends.GetValue(e));
            }
            if(end<begin)end=begin;
            if(end>M)end=M;
            const int me=end-begin;
		
        if(me>0){
            const int mt=(me+tm-1)/tm,firstM=0;
            const int64_t tasks=(int64_t)mt*nc;

		    int64_t t=0;
		    for(;t<tasks;++t)
		    {

			const int mIdx=firstM+(mt==1?0:(int)(t%mt));
			const int nIdx=mt==1?(int)t:(int)(t/mt);
			const int row=begin+mIdx*tm;
			const int col=nIdx*tn;
			const int rows=(me-mIdx*tm<tm)?(me-mIdx*tm):tm;
			const int cols=(N-col<tn)?(N-col):tn;

			const int pitch=(cols+31)/32*32;
			const int slot=(int)(local&1);
			const uint16_t tileFlag=slot?FLAG_TILE1:FLAG_TILE0;
			const uint16_t freeFlag=slot?FLAG_FREE1:FLAG_FREE0;
			auto gcSlot=gc[(int64_t)(blockIdx*SLOTS+slot)*tm*tn];

			if ASCEND_IS_AIC
			{
			    const int panels=K/256;
			    auto acc=accBuffer.Get<int32_t>();
#pragma unroll
			    for(int p=0;p<2;++p)
			    {
				OwnedWidePrefetch(gx,gw,a1[p],b1[p],l1Used[p],l1Free[p],
						   l1Ready[p],row,col,rows,cols,e,K,N,p);
				l1Used[p]=true;
			    }
			    int fragment=0;
			    for(int panel=0;panel<panels;++panel)
			    {
				const int slot1=panel&1;
				WaitFlag<HardEvent::MTE2_MTE1>(l1Ready[slot1]);
#pragma unroll
				for(int sub=0;sub<4;++sub)
				{
				    const int slot0=fragment&1;
				    if(l0Used[slot0])
					WaitFlag<HardEvent::M_MTE1>(l0Free[slot0]);
				    LoadData2dParams la;
				    la.repeatTimes=(rows+15)/16;
				    la.srcStride=1;
				    la.dstGap=1;
				    la.ifTranspose=false;
#pragma unroll
				    for(int ki=0;ki<2;++ki)
				    {
					LoadData(a2[slot0][ki*512],
						 a1[slot1][(sub*2+ki)*tm*32],la);
				    }
				    LoadData2dTransposeParams lb{
					0,uint8_t(cols/32),uint16_t(256/32),1,0,0};
#pragma unroll
				    for(int ki=0;ki<2;++ki)
					LoadDataWithTranspose(b2[slot0][ki*cols*32],
							      b1[slot1][(sub*2+ki)*1024],lb);
				    SetFlag<HardEvent::MTE1_M>(l0Ready[slot0]);
				    WaitFlag<HardEvent::MTE1_M>(l0Ready[slot0]);
				    if(fragment==0&&local>0)
					WaitFlag<HardEvent::FIX_M>(accumulatorFree);
				    MmadParams mad;
				    mad.m=(rows+15)/16*16;
				    mad.n=cols;
				    mad.k=64;
				    mad.cmatrixInitVal=fragment==0;
				    Mmad(acc,a2[slot0],b2[slot0],mad);
				    if((mad.m/16)*(mad.n/16)<10)
					PipeBarrier<PIPE_M>();
				    SetFlag<HardEvent::M_MTE1>(l0Free[slot0]);
				    l0Used[slot0]=true;
				    ++fragment;
				}
				SetFlag<HardEvent::MTE1_MTE2>(l1Free[slot1]);
				if(panel+2<panels)
				{
				    OwnedWidePrefetch(gx,gw,a1[slot1],b1[slot1],true,
						       l1Free[slot1],l1Ready[slot1],row,col,
						       rows,cols,e,K,N,panel+2);
				}
			    }
			    SetFlag<HardEvent::M_FIX>(matrixReady);
			    WaitFlag<HardEvent::M_FIX>(matrixReady);

			    if(local>=SLOTS)
				CrossCoreWaitFlag<2,PIPE_FIX>(freeFlag);
			    FixpipeParamsV220 fix;
			    fix.nSize=cols;
			    fix.mSize=(rows+15)/16*16;
			    fix.srcStride=(rows+15)/16*16;
			    fix.dstStride=tn;
			    fix.quantPre=QuantMode_t::DEQF16;fix.deqScalar=0x3a800000ULL;
                Fixpipe<half,int32_t,CFG_ROW_MAJOR>(gcSlot,acc,fix);
			    SetFlag<HardEvent::FIX_M>(accumulatorFree);
			    CrossCoreSetFlag<2,PIPE_FIX>(tileFlag);
			}
			if ASCEND_IS_AIV
			{
			    CrossCoreWaitFlag<2,PIPE_MTE2>(tileFlag);
			    const int halfRows=(rows+1)/2;
			    const int rowOffset=lane*halfRows;
			    const int vectorRows=lane?rows-halfRows:halfRows;
			    auto c=cq.AllocTensor<half>();
			    auto scale=sq.AllocTensor<float>();

			    if(pitch!=(cols+15)/16*16)
			    {
				Duplicate(c,half(0.0f),vectorRows*pitch);
				auto event=pipe.FetchEventID<HardEvent::V_MTE2>();
				SetFlag<HardEvent::V_MTE2>(event);
				WaitFlag<HardEvent::V_MTE2>(event);
			    }

			    for(int r0=0;r0<vectorRows;r0+=32)
			    {
				const int rc=(vectorRows-r0<32)?(vectorRows-r0):32;
				DataCopyPad(
				    c[r0*pitch],gcSlot[(int64_t)(rowOffset+r0)*tn],
				    {(uint16_t)rc,(uint32_t)(cols*sizeof(half)),
				     (uint32_t)((tn-cols)*sizeof(half)),
				     (uint32_t)((pitch*sizeof(half)-
						 ((cols*sizeof(half)+31)/32)*32)/
						32),
				     0},
				    {true,0,0,0});
			    }
			    DataCopyPad(scale,gs[(int64_t)e*N+col],
					{1,(uint32_t)(cols*sizeof(float)),0,0,0},
					{true,0,0,0.0f});
			    cq.EnQue(c);
			    sq.EnQue(scale);
			    c=cq.DeQue<half>();
			    scale=sq.DeQue<float>();

			    CrossCoreSetFlag<2,PIPE_MTE2>(freeFlag);

			    auto z=zb.Get<float>();
			    auto p=c.ReinterpretCast<float>();
			    auto u=p;
			    auto t=p;

			    const BinaryRepeatParams bcast{
				1,1,1,(uint8_t)(pitch/8),(uint8_t)(pitch/8),0};
			    for(int r=0;r<vectorRows;r+=vr)
			    {
				const int batch=(vectorRows-r<vr)?(vectorRows-r):vr;
				const uint32_t count=(uint32_t)batch*pitch;
				Cast(z,c[r*pitch],RoundMode::CAST_NONE,count);PipeBarrier<PIPE_V>();
                Muls(z,z,1024.0f,count);
				PipeBarrier<PIPE_V>();
				if(cols<64)
				{
				    Mul(z,z,scale,(uint64_t)64,(uint8_t)batch,bcast);
				}
				else
				{
				    for(int c0=0;c0<cols;c0+=64)
				    {
					const int chunk=(cols-c0<64)?(cols-c0):64;
					Mul(z[c0],z[c0],scale[c0],(uint64_t)chunk,
					    (uint8_t)batch,bcast);
				    }
				}
				PipeBarrier<PIPE_V>();

				p=c[r*pitch].ReinterpretCast<float>();
				u=p;
				GeluTanh(z,p,u,t,count);
				auto out=oq.AllocTensor<half>();
				Cast(out,z,RoundMode::CAST_RINT,count);
				oq.EnQue(out);
				out=oq.DeQue<half>();
				const uint32_t outBytes=(uint32_t)cols*(uint32_t)sizeof(half);
				const uint32_t outPitchBytes=
				    (uint32_t)pitch*(uint32_t)sizeof(half);
				const uint32_t outSrcStride=
				    (outPitchBytes-((outBytes+31U)/32U)*32U)/32U;
				for(int r0=0;r0<batch;r0+=32)
				{
				    const int rc=batch-r0<32?batch-r0:32;
				    DataCopyPad(gy[(int64_t)(row+rowOffset+r+r0)*N+col],
						out[r0*pitch],
						{(uint16_t)rc,outBytes,outSrcStride,
						 (uint32_t)((N-cols)*sizeof(half)),0});
				}
				oq.FreeTensor(out);
			    }
			    cq.FreeTensor(c);
			    sq.FreeTensor(scale);
			}
			++local;
		    }
		    
		}
		
	    }
	}
	if ASCEND_IS_AIC
	{

	    if(local>0)
		CrossCoreWaitFlag<2,PIPE_MTE2>(FLAG_FREE0);
	    if(local>1)
		CrossCoreWaitFlag<2,PIPE_MTE2>(FLAG_FREE1);
	    if(local>0)
		WaitFlag<HardEvent::FIX_M>(accumulatorFree);
#pragma unroll
	    for(int i=0;i<2;++i)
	    {
		if(l1Used[i])
		    WaitFlag<HardEvent::MTE1_MTE2>(l1Free[i]);
		if(l0Used[i])
		    WaitFlag<HardEvent::M_MTE1>(l0Free[i]);
		pipe.ReleaseEventID<HardEvent::MTE1_MTE2>(l1Free[i]);
		pipe.ReleaseEventID<HardEvent::MTE2_MTE1>(l1Ready[i]);
		pipe.ReleaseEventID<HardEvent::M_MTE1>(l0Free[i]);
		pipe.ReleaseEventID<HardEvent::MTE1_M>(l0Ready[i]);
	    }
	    pipe.ReleaseEventID<HardEvent::FIX_M>(accumulatorFree);
	    pipe.ReleaseEventID<HardEvent::M_FIX>(matrixReady);
	}
    }
template<int KCapacity>__aicore__ inline void ComputeBucketPair(GM_ADDR x,GM_ADDR w,GM_ADDR sc,GM_ADDR groups,GM_ADDR y,
			  GM_ADDR workspace,int M,int runtimeK,int N,int E,
			  AscendC::tiling::TCubeTiling tiling,uint32_t l1Half)
    {
	constexpr int K=KCapacity;
	TPipe pipe;
	GlobalTensor<int8_t>gx,gw;
	GlobalTensor<float>gs;
	GlobalTensor<half>gc;
	GlobalTensor<half>gy;
	gx.SetGlobalBuffer((__gm__ int8_t*)x);
	gw.SetGlobalBuffer((__gm__ int8_t*)w);
	gs.SetGlobalBuffer((__gm__ float*)sc);
	gy.SetGlobalBuffer((__gm__ half*)y);
	gc.SetGlobalBuffer((__gm__ half*)workspace);

	const int tm=128;
	const int tn=256;

	const int capacity=16384;
	const int vr=capacity/tn;
	const int ve=vr*tn;
	TBuf<TPosition::A1>a1Buffer[2],l1Gap;
	TBuf<TPosition::B1>b1Buffer[2];
	TBuf<TPosition::A2>a2Buffer;
	TBuf<TPosition::B2>b2Buffer;
	TBuf<TPosition::CO1>accBuffer;
	LocalTensor<int8_t>a1[2],b1[2],a2[4],b2[4];
	uint8_t l1Free[2],l1Ready[2],l0Free[4],l0Ready[4];
	uint8_t accumulatorFree=0,matrixReady=0;
	bool l1Used[2]={false,false},l0Used[4]={};
	if ASCEND_IS_AIC
	{
	    pipe.InitBuffer(a1Buffer[0],tm*512);
	    pipe.InitBuffer(b1Buffer[0],tn*512);
	    const uint32_t packetBytes=(tm+tn)*512;
	    if(l1Half>packetBytes)
		pipe.InitBuffer(l1Gap,l1Half-packetBytes);
	    pipe.InitBuffer(a1Buffer[1],tm*512);
	    pipe.InitBuffer(b1Buffer[1],tn*512);
#pragma unroll
	    for(int i=0;i<2;++i)
	    {
		a1[i]=a1Buffer[i].Get<int8_t>();
		b1[i]=b1Buffer[i].Get<int8_t>();
		l1Free[i]=pipe.AllocEventID<HardEvent::MTE1_MTE2>();
		l1Ready[i]=pipe.AllocEventID<HardEvent::MTE2_MTE1>();
	    }
	    pipe.InitBuffer(a2Buffer,4*tm*64);
	    pipe.InitBuffer(b2Buffer,4*tn*64);
#pragma unroll
	    for(int i=0;i<4;++i)
	    {
		a2[i]=a2Buffer.Get<int8_t>()[i*tm*64];
		b2[i]=b2Buffer.Get<int8_t>()[i*tn*64];
		l0Free[i]=pipe.AllocEventID<HardEvent::M_MTE1>();
		l0Ready[i]=pipe.AllocEventID<HardEvent::MTE1_M>();
	    }
	    pipe.InitBuffer(accBuffer,tm*tn*sizeof(int32_t));
	    accumulatorFree=pipe.AllocEventID<HardEvent::FIX_M>();
	    matrixReady=pipe.AllocEventID<HardEvent::M_FIX>();
	}

	TQue<TPosition::VECIN,1>cq;
	TQue<TPosition::VECOUT,1>oq;
	TBuf<TPosition::VECCALC>zb,pb,groupCache;
	if ASCEND_IS_AIV
	{
	    pipe.InitBuffer(cq,1,
			    uint32_t(((tm+1)/2*tn+tn)*sizeof(float))+
				(tm*tn>16384?256:0));
	    pipe.InitBuffer(oq,1,(uint32_t)ve*sizeof(half));
	    pipe.InitBuffer(zb,(uint32_t)ve*sizeof(float));
	    if(E>0)
	    {
		pipe.InitBuffer(groupCache,(E*8+31)/32*32);
		GlobalTensor<int64_t>gg;
		gg.SetGlobalBuffer((__gm__ int64_t*)groups);
		DataCopyPad(groupCache.Get<int64_t>(),gg,{1,(uint32_t)(E*8),0,0,0},
			    {true,0,0,int64_t(0)});
		auto ready=pipe.FetchEventID<HardEvent::MTE2_S>();
		SetFlag<HardEvent::MTE2_S>(ready);
		WaitFlag<HardEvent::MTE2_S>(ready);
	    }
	}

	bool hasPending=false;
	uint64_t pendingInfo=0;
	int64_t producerOrdinal=0;
	const int startPhase=int(GetBlockIdx())%(K/512);
	int panelStart=startPhase;
	int blockIdx=(int)GetBlockIdx();
	int lane=0;
	if ASCEND_IS_AIV
	{
	    lane=blockIdx&1;
	    blockIdx/=2;
	}
	const int blockNum=(int)GetBlockNum();
	const int nc=N/tn;
	
    int64_t nextTask=blockIdx,local=0;
    const int period=2*blockNum;
    int gap=period-1-2*blockIdx;
    for(int bucket=tm+32;bucket>=16;bucket-=32)
	{
	    int begin=0;
	    for(int e=0;e<E;++e)
	    {
		int end=0;
		if ASCEND_IS_AIC
		{
		    end=(int)((__gm__ int64_t*)groups)[e];
		}
		if ASCEND_IS_AIV
		{
		    end=E>0?(int)groupCache.Get<int64_t>().GetValue(e)
				:(int)((__gm__ int64_t*)groups)[e];
		}
		if(end<begin)
		    end=begin;
		if(end>M)
		    end=M;
		const int me=end-begin;
		
        const bool fullPass=bucket>tm;
        const int fullTiles=me/tm,tailRows=me%tm;
        const bool selected=fullPass?fullTiles>0:tailRows>0&&(tailRows+31)/32*32==bucket;
        if(selected){
            const int mt=fullPass?fullTiles:1,firstM=fullPass?0:fullTiles;
            const int64_t tasks=int64_t(mt)*nc;
            int64_t t=nextTask;
            for(;t<tasks;t+=gap,gap=period-gap){
                const int mIdx=firstM+int(t%mt),nIdx=int(t/mt);
                const int row=begin+mIdx*tm;
			const int col=nIdx*tn;
			const int rows=(me-mIdx*tm<tm)?(me-mIdx*tm):tm;
			const int cols=tn;

			const int pitch=(cols+31)/32*32;
			const int slot=(int)(local&1);
			const uint16_t tileFlag=slot?FLAG_TILE1:FLAG_TILE0;
			const uint16_t freeFlag=slot?FLAG_FREE1:FLAG_FREE0;
			auto gcSlot=gc[(int64_t)(blockIdx*SLOTS+slot)*tm*tn];

			if ASCEND_IS_AIC
			{
			    const uint64_t futureInfo=uint64_t(row)|uint64_t(e)<<16|
							uint64_t(rows)<<23|uint64_t(col)<<31|
							uint64_t(cols)<<43;
			    int nextPanelStart=startPhase;
			    if(hasPending)
			    {
				const int64_t productOrdinal=producerOrdinal;
				const int64_t local=productOrdinal;
				const int row=pendingInfo&65535U;
				const int e=(pendingInfo>>16)&127U;
				const int rows=(pendingInfo>>23)&255U;
				const int col=(pendingInfo>>31)&4095U;
				const int cols=(pendingInfo>>43)&1023U;
				const int slot=int(local&1);
				const uint16_t tileFlag=slot?FLAG_TILE1:FLAG_TILE0;
				const uint16_t freeFlag=slot?FLAG_FREE1:FLAG_FREE0;
				auto gcSlot=gc[int64_t(blockIdx*SLOTS+slot)*tm*tn];
				const int panels=K/512;
				const bool keepA=(futureInfo&65535U)==uint64_t(row)&&
						   ((futureInfo>>23)&255U)==uint64_t(rows);
				const bool keepB=((futureInfo>>16)&127U)==uint64_t(e)&&
						   ((futureInfo>>31)&4095U)==uint64_t(col);
				if(keepA||keepB)
				    nextPanelStart=(panelStart+panels-2)%panels;
				auto acc=accBuffer.Get<int32_t>();

				int fragment=0;
				for(int panel=0;panel<panels;++panel)
				{
				    const int slot1=(panel+int(local)*(K/512))&1;
				    WaitFlag<HardEvent::MTE2_MTE1>(l1Ready[slot1]);
#pragma unroll
				    for(int sub=0;sub<8;++sub)
				    {
					const int slot0=fragment&3;
					if(l0Used[slot0])
					    WaitFlag<HardEvent::M_MTE1>(l0Free[slot0]);
					LoadData2dParams la;
					la.repeatTimes=(rows+15)/16;
					la.srcStride=1;
					la.dstGap=1;
					la.ifTranspose=false;
					LoadData2dTransposeParams lb{
					    0,uint8_t(cols/32),uint16_t(512/32),1,0,0};
#pragma unroll
					for(int ki=0;ki<2;++ki)
					{
					    LoadData(a2[slot0][ki*512],
						     a1[slot1][(sub*2+ki)*tm*32],la);
					    LoadDataWithTranspose(b2[slot0][ki*cols*32],
								  b1[slot1][(sub*2+ki)*1024],
								  lb);
					}
					SetFlag<HardEvent::MTE1_M>(l0Ready[slot0]);
					WaitFlag<HardEvent::MTE1_M>(l0Ready[slot0]);
					if(fragment==0&&local>0)
					    WaitFlag<HardEvent::FIX_M>(accumulatorFree);
					MmadParams mad;
					mad.m=(rows+15)/16*16;
					mad.n=cols;
					mad.k=64;
					mad.cmatrixInitVal=fragment==0;
					Mmad(acc,a2[slot0],b2[slot0],mad);

					if((mad.m/16)*(mad.n/16)<10)
					    PipeBarrier<PIPE_M>();
					SetFlag<HardEvent::M_MTE1>(l0Free[slot0]);
					l0Used[slot0]=true;
					++fragment;
				    }
				    SetFlag<HardEvent::MTE1_MTE2>(l1Free[slot1]);
				    if(panel+2<panels)
				    {
					IntertilePrefetch512(gx,gw,a1[slot1],b1[slot1],true,
							  l1Free[slot1],l1Ready[slot1],row,col,
							  rows,cols,e,K,N,(panelStart+panel+2)%panels);
				    }
				    else
				    {
					IntertilePrefetch512(gx,gw,a1[slot1],b1[slot1],true,
							  l1Free[slot1],l1Ready[slot1],
							  int(futureInfo&65535U),
							  int((futureInfo>>31)&4095U),
							  int((futureInfo>>23)&255U),
							  int((futureInfo>>43)&1023U),
							  int((futureInfo>>16)&127U),K,N,
							  (nextPanelStart+panel+2-panels)%panels,keepA,keepB);
				    }
				}
				SetFlag<HardEvent::M_FIX>(matrixReady);
				WaitFlag<HardEvent::M_FIX>(matrixReady);

				if(local>=SLOTS)
				    CrossCoreWaitFlag<2,PIPE_FIX>(freeFlag);
				FixpipeParamsV220 fix;
				fix.nSize=cols;
				fix.mSize=(rows+15)/16*16;
				fix.srcStride=(rows+15)/16*16;
				fix.dstStride=tn;
				fix.quantPre=QuantMode_t::DEQF16;fix.deqScalar=0x3b000000ULL;
                Fixpipe<half,int32_t,CFG_ROW_MAJOR>(gcSlot,acc,fix);
				SetFlag<HardEvent::FIX_M>(accumulatorFree);
				CrossCoreSetFlag<2,PIPE_FIX>(tileFlag);
			    }
			    else
			    {
#pragma unroll
				for(int p=0;p<2;++p)
				{
				    IntertilePrefetch512(gx,gw,a1[p],b1[p],l1Used[p],l1Free[p],
						      l1Ready[p],row,col,rows,cols,e,K,N,(p+startPhase)%(K/512));
				    l1Used[p]=true;
				}
			    }
			    panelStart=nextPanelStart;
			    pendingInfo=futureInfo;
			    producerOrdinal=local;
			    hasPending=true;
			}
			if ASCEND_IS_AIV
			{
			    CrossCoreWaitFlag<2,PIPE_MTE2>(tileFlag);
			    const int halfRows=(rows+1)/2;
			    const int rowOffset=lane*halfRows;
			    const int vectorRows=lane?rows-halfRows:halfRows;
			    auto c=cq.AllocTensor<half>();
			    auto scale=c.ReinterpretCast<float>()[((tm+1)/2*tn)+
								    (tm*tn>16384?64:0)];

			    if(pitch!=(cols+15)/16*16)
			    {
				Duplicate(c,half(0.0f),vectorRows*pitch);
				auto event=pipe.FetchEventID<HardEvent::V_MTE2>();
				SetFlag<HardEvent::V_MTE2>(event);
				WaitFlag<HardEvent::V_MTE2>(event);
			    }

			    if(vectorRows>0)
				DataCopyPad(
				    c,gcSlot[int64_t(rowOffset)*tn],
				    {1,uint32_t(vectorRows*tn*sizeof(half)),0,0,0},
				    {true,0,0,0});
			    DataCopyPad(scale,gs[(int64_t)e*N+col],
					{1,(uint32_t)(cols*sizeof(float)),0,0,0},
					{true,0,0,0.0f});
			    cq.EnQue(c);
			    c=cq.DeQue<half>();

			    CrossCoreSetFlag<2,PIPE_MTE2>(freeFlag);

			    auto z=zb.Get<float>();
			    auto p=c.ReinterpretCast<float>();
			    auto u=p;
			    auto t=p;

			    const BinaryRepeatParams bcast{
				1,1,1,(uint8_t)(pitch/8),(uint8_t)(pitch/8),0};
			    for(int r=0;r<vectorRows;r+=vr)
			    {
				const int batch=(vectorRows-r<vr)?(vectorRows-r):vr;
				const uint32_t count=(uint32_t)batch*pitch;
				Cast(z,c[r*pitch],RoundMode::CAST_NONE,count);PipeBarrier<PIPE_V>();
                Muls(z,z,512.0f,count);
				PipeBarrier<PIPE_V>();
				if(cols<64)
				{
				    Mul(z,z,scale,(uint64_t)64,(uint8_t)batch,bcast);
				}
				else
				{
				    for(int c0=0;c0<cols;c0+=64)
				    {
					const int chunk=(cols-c0<64)?(cols-c0):64;
					Mul(z[c0],z[c0],scale[c0],(uint64_t)chunk,
					    (uint8_t)batch,bcast);
				    }
				}
				PipeBarrier<PIPE_V>();

				p=c[r*pitch].ReinterpretCast<float>();
				u=p;
				GeluTanh(z,p,u,t,count);
				auto out=oq.AllocTensor<half>();
				Cast(out,z,RoundMode::CAST_RINT,count);
				oq.EnQue(out);
				out=oq.DeQue<half>();
				const uint32_t outBytes=(uint32_t)cols*(uint32_t)sizeof(half);
				const uint32_t outPitchBytes=
				    (uint32_t)pitch*(uint32_t)sizeof(half);
				const uint32_t outSrcStride=
				    (outPitchBytes-((outBytes+31U)/32U)*32U)/32U;
				for(int r0=0;r0<batch;r0+=32)
				{
				    const int rc=batch-r0<32?batch-r0:32;
				    DataCopyPad(gy[(int64_t)(row+rowOffset+r+r0)*N+col],
						out[r0*pitch],
						{(uint16_t)rc,outBytes,outSrcStride,
						 (uint32_t)((N-cols)*sizeof(half)),0});
				}
				oq.FreeTensor(out);
			    }
			    cq.FreeTensor(c);
			}
			++local;
		    }
		    nextTask=t-tasks;
		}
		begin=end;
	    }
	}
	if ASCEND_IS_AIC
	{
	    if(hasPending)
	    {
		const int64_t productOrdinal=producerOrdinal;
		const int64_t local=productOrdinal;
		const int row=pendingInfo&65535U;
		const int e=(pendingInfo>>16)&127U;
		const int rows=(pendingInfo>>23)&255U;
		const int col=(pendingInfo>>31)&4095U;
		const int cols=(pendingInfo>>43)&1023U;
		const int slot=int(local&1);
		const uint16_t tileFlag=slot?FLAG_TILE1:FLAG_TILE0;
		const uint16_t freeFlag=slot?FLAG_FREE1:FLAG_FREE0;
		auto gcSlot=gc[int64_t(blockIdx*SLOTS+slot)*tm*tn];
		const int panels=K/512;
		auto acc=accBuffer.Get<int32_t>();

		int fragment=0;
		for(int panel=0;panel<panels;++panel)
		{
		    const int slot1=(panel+int(local)*(K/512))&1;
		    WaitFlag<HardEvent::MTE2_MTE1>(l1Ready[slot1]);
#pragma unroll
		    for(int sub=0;sub<8;++sub)
		    {
			const int slot0=fragment&3;
			if(l0Used[slot0])
			    WaitFlag<HardEvent::M_MTE1>(l0Free[slot0]);
			LoadData2dParams la;
			la.repeatTimes=(rows+15)/16;
			la.srcStride=1;
			la.dstGap=1;
			la.ifTranspose=false;
			LoadData2dTransposeParams lb{
			    0,uint8_t(cols/32),uint16_t(512/32),1,0,0};
#pragma unroll
			for(int ki=0;ki<2;++ki)
			{
			    LoadData(a2[slot0][ki*512],a1[slot1][(sub*2+ki)*tm*32],la);
			    LoadDataWithTranspose(b2[slot0][ki*cols*32],
						  b1[slot1][(sub*2+ki)*1024],lb);
			}
			SetFlag<HardEvent::MTE1_M>(l0Ready[slot0]);
			WaitFlag<HardEvent::MTE1_M>(l0Ready[slot0]);
			if(fragment==0&&local>0)
			    WaitFlag<HardEvent::FIX_M>(accumulatorFree);
			MmadParams mad;
			mad.m=(rows+15)/16*16;
			mad.n=cols;
			mad.k=64;
			mad.cmatrixInitVal=fragment==0;
			Mmad(acc,a2[slot0],b2[slot0],mad);

			if((mad.m/16)*(mad.n/16)<10)
			    PipeBarrier<PIPE_M>();
			SetFlag<HardEvent::M_MTE1>(l0Free[slot0]);
			l0Used[slot0]=true;
			++fragment;
		    }
		    SetFlag<HardEvent::MTE1_MTE2>(l1Free[slot1]);
		    if(panel+2<panels)
		    {
			IntertilePrefetch512(gx,gw,a1[slot1],b1[slot1],true,l1Free[slot1],
					  l1Ready[slot1],row,col,rows,cols,e,K,N,(panelStart+panel+2)%panels);
		    }
		}
		SetFlag<HardEvent::M_FIX>(matrixReady);
		WaitFlag<HardEvent::M_FIX>(matrixReady);

		if(local>=SLOTS)
		    CrossCoreWaitFlag<2,PIPE_FIX>(freeFlag);
		FixpipeParamsV220 fix;
		fix.nSize=cols;
		fix.mSize=(rows+15)/16*16;
		fix.srcStride=(rows+15)/16*16;
		fix.dstStride=tn;
		fix.quantPre=QuantMode_t::DEQF16;fix.deqScalar=0x3b000000ULL;
                Fixpipe<half,int32_t,CFG_ROW_MAJOR>(gcSlot,acc,fix);
		SetFlag<HardEvent::FIX_M>(accumulatorFree);
		CrossCoreSetFlag<2,PIPE_FIX>(tileFlag);
	    }

	    if(local>0)
		CrossCoreWaitFlag<2,PIPE_MTE2>(FLAG_FREE0);
	    if(local>1)
		CrossCoreWaitFlag<2,PIPE_MTE2>(FLAG_FREE1);
	    if(local>0)
		WaitFlag<HardEvent::FIX_M>(accumulatorFree);
#pragma unroll
	    for(int i=0;i<2;++i)
	    {
		if(l1Used[i])
		    WaitFlag<HardEvent::MTE1_MTE2>(l1Free[i]);
		pipe.ReleaseEventID<HardEvent::MTE1_MTE2>(l1Free[i]);
		pipe.ReleaseEventID<HardEvent::MTE2_MTE1>(l1Ready[i]);
	    }
#pragma unroll
	    for(int i=0;i<4;++i)
	    {
		if(l0Used[i])
		    WaitFlag<HardEvent::M_MTE1>(l0Free[i]);
		pipe.ReleaseEventID<HardEvent::M_MTE1>(l0Free[i]);
		pipe.ReleaseEventID<HardEvent::MTE1_M>(l0Ready[i]);
	    }
	    pipe.ReleaseEventID<HardEvent::FIX_M>(accumulatorFree);
	    pipe.ReleaseEventID<HardEvent::M_FIX>(matrixReady);
	}
    }
template<int FixedM,int FixedN,int FixedK>__aicore__ inline void ComputeOwnedShort(GM_ADDR x,GM_ADDR w,GM_ADDR sc,GM_ADDR groups,GM_ADDR y,
		       GM_ADDR workspace,int M,int runtimeK,int N,int E,
		       AscendC::tiling::TCubeTiling tiling)
    {
	const int K=FixedK?FixedK:runtimeK;
	TPipe pipe;
	GlobalTensor<int8_t>gx,gw;
	GlobalTensor<float>gs;
	GlobalTensor<int32_t>gc;
	GlobalTensor<half>gy;
	gx.SetGlobalBuffer((__gm__ int8_t*)x);
	gw.SetGlobalBuffer((__gm__ int8_t*)w);
	gs.SetGlobalBuffer((__gm__ float*)sc);
	gy.SetGlobalBuffer((__gm__ half*)y);
	gc.SetGlobalBuffer((__gm__ int32_t*)workspace);

	const int tm=FixedM;
	const int tn=FixedN;

	const int capacity=((tm+1)/2)*tn;
	const int vr=capacity/tn;
	const int ve=vr*tn;
	
    TBuf<TPosition::A1>a1b,a1Next;
    TBuf<TPosition::B1>b1Next;
    uint8_t ready[2]={0,0};
    bool prefetched=false;
	TBuf<TPosition::B1>b1b;
	TBuf<TPosition::A2>a2b;
	TBuf<TPosition::B2>b2b;
	TBuf<TPosition::CO1>c0b;
	if ASCEND_IS_AIC
	{
	    pipe.InitBuffer(a1b,tm*256);
	    
        pipe.InitBuffer(b1b,256*tn);
        pipe.InitBuffer(a1Next,tm*256);
        pipe.InitBuffer(b1Next,tn*256);
        for(int i=0;i<2;++i)ready[i]=pipe.AllocEventID<HardEvent::MTE2_MTE1>();
	    pipe.InitBuffer(a2b,tm*256);
	    pipe.InitBuffer(b2b,256*tn);
	    pipe.InitBuffer(c0b,tm*tn*4);
	}

	int blockIdx=(int)GetBlockIdx();
	int lane=0;
	if ASCEND_IS_AIV
	{
	    lane=blockIdx&1;
	    blockIdx/=2;
	}
	const int blockNum=(int)GetBlockNum();
	constexpr int nc=1;
	
    const int first=E*blockIdx/blockNum,last=E*(blockIdx+1)/blockNum;
    const int cacheStart=first>0?first-1:0;
	TQue<TPosition::VECIN,1>cq,sq;
	TQue<TPosition::VECOUT,1>oq;
	TBuf<TPosition::VECCALC>zb,pb,groupCache;
	if ASCEND_IS_AIV
	{
	    pipe.InitBuffer(cq,1,(uint32_t)((tm+1)/2*tn)*sizeof(int32_t));
	    pipe.InitBuffer(sq,1,(uint32_t)tn*sizeof(float)+(tm*tn>16384?256:0));
	    pipe.InitBuffer(oq,1,(uint32_t)ve*sizeof(half));
	    pipe.InitBuffer(zb,(uint32_t)ve*sizeof(float));
		    if(E>=32)
	    {
		pipe.InitBuffer(groupCache,((last-cacheStart)*8+31)/32*32);
		GlobalTensor<int64_t>gg;
		gg.SetGlobalBuffer((__gm__ int64_t*)groups);
		DataCopyPad(groupCache.Get<int64_t>(),gg[cacheStart],{1,uint32_t((last-cacheStart)*8),0,0,0},
			    {true,0,0,int64_t(0)});
		auto ready=pipe.FetchEventID<HardEvent::MTE2_S>();
		SetFlag<HardEvent::MTE2_S>(ready);
		WaitFlag<HardEvent::MTE2_S>(ready);
	    }
	}

    GlobalTensor<int64_t>ends;
    ends.SetGlobalBuffer((__gm__ int64_t*)groups);
	int64_t local=0;
	int begin=0;
    if(first>0) {
        if ASCEND_IS_AIV {begin=E>=32?int(groupCache.Get<int64_t>().GetValue(0)):int(ends.GetValue(first-1));}
        if ASCEND_IS_AIC {begin=int(ends.GetValue(first-1));}
    }
	for(int e=first;e<last;++e)
	{
	    int end=0;
	    if ASCEND_IS_AIC
	    {
		end=(int)((__gm__ int64_t*)groups)[e];
	    }
	    if ASCEND_IS_AIV
	    {
		end=E>=32?(int)groupCache.Get<int64_t>().GetValue(e-cacheStart)
			      :(int)((__gm__ int64_t*)groups)[e];
	    }
	    if(end<begin)
		end=begin;
	    if(end>M)
		end=M;
	    const int rowBegin=begin,rowEnd=end,me=end-begin;
	    if(me>0)
	    {
		const int mt=(me+tm-1)/tm;
		const int64_t tasks=(int64_t)mt*nc;

		int64_t t=0;
		for(;t<tasks;++t)
		{

		    const int mIdx=mt==1?0:(int)(t%mt);
		    constexpr int nIdx=0;
		    const int row=rowBegin+mIdx*tm;
		    const int col=nIdx*tn;
		    const int rows=(me-mIdx*tm<tm)?(me-mIdx*tm):tm;
		    const int cols=(N-col<tn)?(N-col):tn;

		    const int pitch=(cols+31)/32*32;
		    const int slot=(int)(local&1);
		    const uint16_t tileFlag=slot?FLAG_TILE1:FLAG_TILE0;
		    const uint16_t freeFlag=slot?FLAG_FREE1:FLAG_FREE0;
		    auto gcSlot=gc[(int64_t)(blockIdx*SLOTS+slot)*tm*tn];

		    if ASCEND_IS_AIC
		    {
			
			auto a1=slot?a1Next.Get<int8_t>():a1b.Get<int8_t>();
			auto b1=slot?b1Next.Get<int8_t>():b1b.Get<int8_t>();
			auto a2=a2b.Get<int8_t>();
			auto b2=b2b.Get<int8_t>();
			auto acc=c0b.Get<int32_t>();
			
			
			{
			    const int ck=K;
			    Nd2NzParams ap;
			    ap.ndNum=1;
			    ap.nValue=rows;
			    ap.dValue=ck;
			    ap.srcNdMatrixStride=0;
			    ap.srcDValue=K;
			    ap.dstNzC0Stride=tm;
			    ap.dstNzNStride=1;
			    ap.dstNzMatrixStride=0;
			    Nd2NzParams bp;
			    bp.ndNum=1;
			    bp.nValue=ck;
			    bp.dValue=cols;
			    bp.srcNdMatrixStride=0;
			    bp.srcDValue=N;
			    bp.dstNzC0Stride=ck;
			    bp.dstNzNStride=1;
			    bp.dstNzMatrixStride=0;
			    
                if(!prefetched){
                    DataCopy(a1,gx[int64_t(row)*K],ap);
                    DataCopy(b1,gw[int64_t(e)*K*N+col],bp);
                    SetFlag<HardEvent::MTE2_MTE1>(ready[slot]);
                }
                WaitFlag<HardEvent::MTE2_MTE1>(ready[slot]);
                prefetched=false;
                if(local)
			    {
				auto reuse=pipe.FetchEventID<HardEvent::M_MTE1>();
				SetFlag<HardEvent::M_MTE1>(reuse);
				WaitFlag<HardEvent::M_MTE1>(reuse);
			    }
			    LoadData2dParams la;
			    la.repeatTimes=ck/32;
			    la.srcStride=tm/16;
			    la.ifTranspose=false;
#pragma unroll
			    for(int mi=0;mi<FixedM/16;++mi)
				if(mi<(rows+15)/16)
				    LoadData(a2[mi*ck*16],a1[mi*512],la);
			    LoadData2dTransposeParams lb{
				0,(uint8_t)(cols/32),(uint16_t)(ck/32),1,0,0};
#pragma unroll
			    for(int ki=0;ki<ck/32;++ki)
				LoadDataWithTranspose(b2[ki*cols*32],b1[ki*1024],lb);
			    auto loaded=pipe.FetchEventID<HardEvent::MTE1_M>();
			    SetFlag<HardEvent::MTE1_M>(loaded);
			    WaitFlag<HardEvent::MTE1_M>(loaded);
			    MmadParams mad;
			    mad.m=(rows+15)/16*16;
			    mad.n=cols;
			    mad.k=ck;
			    mad.cmatrixInitVal=true;mad.unitFlag=3;
			    Mmad(acc,a2,b2,mad);
			    if((mad.m/16)*(mad.n/16)<10)
				PipeBarrier<PIPE_M>();
                int nr=row+rows,ne=e,nrows=rowEnd-nr;
                if(nrows<=0){
                    int nb=end;
                    for(ne=e+1;ne<last;++ne){
                        const int raw=int(ends.GetValue(ne));
                        const int bound=raw<nb?nb:(raw>M?M:raw);
                        nr=nb;nrows=bound-nb;
                        if(nrows>0)break;
                        nb=bound;
                    }
                }
                if(nrows>0){
                    const auto safe=pipe.FetchEventID<HardEvent::MTE1_MTE2>();
                    SetFlag<HardEvent::MTE1_MTE2>(safe);WaitFlag<HardEvent::MTE1_MTE2>(safe);
                    auto nextA=slot?a1b.Get<int8_t>():a1Next.Get<int8_t>();
                    auto nextB=slot?b1b.Get<int8_t>():b1Next.Get<int8_t>();
                    ap.nValue=nrows<tm?nrows:tm;
                    DataCopy(nextA,gx[int64_t(nr)*K],ap);
                    DataCopy(nextB,gw[int64_t(ne)*K*N+col],bp);
                    SetFlag<HardEvent::MTE2_MTE1>(ready[slot^1]);
                    prefetched=true;
                }

			}
			
			if(local>=SLOTS)CrossCoreWaitFlag<2,PIPE_FIX>(freeFlag);
            FixpipeParamsV220 fix;fix.unitFlag=3;
			fix.nSize=cols;
			fix.mSize=(rows+15)/16*16;
			fix.srcStride=(rows+15)/16*16;
			fix.dstStride=tn;
			Fixpipe<int32_t,int32_t,CFG_ROW_MAJOR>(gcSlot,acc,fix);
			CrossCoreSetFlag<2,PIPE_FIX>(tileFlag);
		    }
		    if ASCEND_IS_AIV
		    {
			CrossCoreWaitFlag<2,PIPE_MTE2>(tileFlag);
			const int halfRows=(rows+1)/2;
			const int rowOffset=lane*halfRows;
			const int vectorRows=lane?rows-halfRows:halfRows;
			auto c=cq.AllocTensor<int32_t>();
			auto scale=sq.AllocTensor<float>();

			if(pitch!=(cols+7)/8*8)
			{
			    Duplicate(c,int32_t(0),vectorRows*pitch);
			    auto event=pipe.FetchEventID<HardEvent::V_MTE2>();
			    SetFlag<HardEvent::V_MTE2>(event);
			    WaitFlag<HardEvent::V_MTE2>(event);
			}

			for(int r0=0;r0<vectorRows;r0+=32)
			{
			    const int rc=(vectorRows-r0<32)?(vectorRows-r0):32;
			    DataCopyPad(c[r0*pitch],gcSlot[(int64_t)(rowOffset+r0)*tn],
					{(uint16_t)rc,(uint32_t)(cols*sizeof(int32_t)),
					 (uint32_t)((tn-cols)*sizeof(int32_t)),
					 (uint32_t)((pitch*sizeof(int32_t)-
						     ((cols*sizeof(int32_t)+31)/32)*32)/
						    32),
					 0},
					{true,0,0,0});
			}
			DataCopyPad(scale,gs[(int64_t)e*N+col],
				    {1,(uint32_t)(cols*sizeof(float)),0,0,0},
				    {true,0,0,0.0f});
			cq.EnQue(c);
			sq.EnQue(scale);
			c=cq.DeQue<int32_t>();
			scale=sq.DeQue<float>();

			CrossCoreSetFlag<2,PIPE_MTE2>(freeFlag);

			auto z=zb.Get<float>();
			auto p=c.ReinterpretCast<float>();

			const BinaryRepeatParams bcast{
			    1,1,1,(uint8_t)(pitch/8),(uint8_t)(pitch/8),0};
			for(int r=0;r<vectorRows;r+=vr)
			{
			    const int batch=(vectorRows-r<vr)?(vectorRows-r):vr;
			    const uint32_t count=(uint32_t)batch*pitch;
			    Cast(z,c[r*pitch],RoundMode::CAST_NONE,count);
			    PipeBarrier<PIPE_V>();
			    if(cols<64)
			    {
				Mul(z,z,scale,(uint64_t)64,(uint8_t)batch,bcast);
			    }
			    else
			    {
				for(int c0=0;c0<cols;c0+=64)
				{
				    const int chunk=(cols-c0<64)?(cols-c0):64;
				    Mul(z[c0],z[c0],scale[c0],(uint64_t)chunk,(uint8_t)batch,
					bcast);
				}
			    }
			    PipeBarrier<PIPE_V>();

			    GeluTanh(z,p,p,p,count);
			    auto out=oq.AllocTensor<half>();
			    Cast(out,z,RoundMode::CAST_RINT,count);
			    oq.EnQue(out);
			    out=oq.DeQue<half>();
			    const uint32_t outBytes=(uint32_t)cols*(uint32_t)sizeof(half);
			    const uint32_t outPitchBytes=(uint32_t)pitch*(uint32_t)sizeof(half);
			    const uint32_t outSrcStride=
				(outPitchBytes-((outBytes+31U)/32U)*32U)/32U;
			    DataCopyPad(gy[(int64_t)(row+rowOffset+r)*N+col],out,
					{(uint16_t)batch,outBytes,outSrcStride,
					 (uint32_t)((N-cols)*sizeof(half)),0});
			    oq.FreeTensor(out);
			}
			cq.FreeTensor(c);
			sq.FreeTensor(scale);
		    }
		    ++local;
		}
		
	    }
	    begin=end;
	}
	if ASCEND_IS_AIC
	{
        for(int i=0;i<2;++i)pipe.ReleaseEventID<HardEvent::MTE2_MTE1>(ready[i]);

	    if(local>0)
		CrossCoreWaitFlag<2,PIPE_MTE2>(FLAG_FREE0);
	    if(local>1)
		CrossCoreWaitFlag<2,PIPE_MTE2>(FLAG_FREE1);
	}
    }
template<int KCapacity>__aicore__ inline void ComputeBucketUnitScaleHoistPrivate(GM_ADDR x,GM_ADDR w,GM_ADDR sc,GM_ADDR groups,GM_ADDR y,
			  GM_ADDR workspace,int M,int runtimeK,int N,int E,
			  AscendC::tiling::TCubeTiling tiling,uint32_t l1Half)
    {
	constexpr int K=KCapacity;
	TPipe pipe;
	GlobalTensor<int8_t>gx,gw;
	GlobalTensor<float>gs;
	GlobalTensor<half>gc;
	GlobalTensor<half>gy;
	gx.SetGlobalBuffer((__gm__ int8_t*)x);
	gw.SetGlobalBuffer((__gm__ int8_t*)w);
	gs.SetGlobalBuffer((__gm__ float*)sc);
	gy.SetGlobalBuffer((__gm__ half*)y);
	gc.SetGlobalBuffer((__gm__ half*)workspace);

	const int tm=128;
	const int tn=256;

	const int capacity=16384;
	const int vr=capacity/tn;
	const int ve=vr*tn;
	TBuf<TPosition::A1>a1Buffer[2],l1Gap;
	TBuf<TPosition::B1>b1Buffer[2];
	TBuf<TPosition::A2>a2Buffer;
	TBuf<TPosition::B2>b2Buffer;
	TBuf<TPosition::CO1>accBuffer;
	LocalTensor<int8_t>a1[2],b1[2],a2[4],b2[4];
	uint8_t l1Free[2],l1Ready[2],l0Free[4],l0Ready[4];
	uint8_t accumulatorFree=0,matrixReady=0;
	bool l1Used[2]={false,false},l0Used[4]={};
	if ASCEND_IS_AIC
	{
	    pipe.InitBuffer(a1Buffer[0],tm*512);
	    pipe.InitBuffer(b1Buffer[0],tn*512);
	    const uint32_t packetBytes=(tm+tn)*512;
	    if(l1Half>packetBytes)
		pipe.InitBuffer(l1Gap,l1Half-packetBytes);
	    pipe.InitBuffer(a1Buffer[1],tm*512);
	    pipe.InitBuffer(b1Buffer[1],tn*512);
#pragma unroll
	    for(int i=0;i<2;++i)
	    {
		a1[i]=a1Buffer[i].Get<int8_t>();
		b1[i]=b1Buffer[i].Get<int8_t>();
		l1Free[i]=pipe.AllocEventID<HardEvent::MTE1_MTE2>();
		l1Ready[i]=pipe.AllocEventID<HardEvent::MTE2_MTE1>();
	    }
	    pipe.InitBuffer(a2Buffer,4*tm*64);
	    pipe.InitBuffer(b2Buffer,4*tn*64);
#pragma unroll
	    for(int i=0;i<4;++i)
	    {
		a2[i]=a2Buffer.Get<int8_t>()[i*tm*64];
		b2[i]=b2Buffer.Get<int8_t>()[i*tn*64];
		l0Free[i]=pipe.AllocEventID<HardEvent::M_MTE1>();
		l0Ready[i]=pipe.AllocEventID<HardEvent::MTE1_M>();
	    }
	    pipe.InitBuffer(accBuffer,tm*tn*sizeof(int32_t));
	    accumulatorFree=pipe.AllocEventID<HardEvent::FIX_M>();
	    matrixReady=pipe.AllocEventID<HardEvent::M_FIX>();
	}

	TQue<TPosition::VECIN,1>cq;
	TQue<TPosition::VECOUT,1>oq;
	TBuf<TPosition::VECCALC>zb,pb,groupCache;
	if ASCEND_IS_AIV
	{
	    pipe.InitBuffer(cq,1,
			    uint32_t(((tm+1)/2*tn+tn)*sizeof(float))+
				(tm*tn>16384?256:0));
	    pipe.InitBuffer(oq,1,(uint32_t)ve*sizeof(half));
	    pipe.InitBuffer(zb,(uint32_t)ve*sizeof(float));
	    if(E>0)
	    {
		pipe.InitBuffer(groupCache,(E*8+31)/32*32);
		GlobalTensor<int64_t>gg;
		gg.SetGlobalBuffer((__gm__ int64_t*)groups);
		DataCopyPad(groupCache.Get<int64_t>(),gg,{1,(uint32_t)(E*8),0,0,0},
			    {true,0,0,int64_t(0)});
		auto ready=pipe.FetchEventID<HardEvent::MTE2_S>();
		SetFlag<HardEvent::MTE2_S>(ready);
		WaitFlag<HardEvent::MTE2_S>(ready);
	    }
	}

	bool hasPending=false;
	uint64_t pendingInfo=0;
	int64_t producerOrdinal=0;
	int startPhase=0;
    if constexpr(KCapacity>=2048)startPhase=int(GetBlockIdx())%(K/512);
	int panelStart=startPhase;
	int blockIdx=(int)GetBlockIdx();
	int lane=0;
	if ASCEND_IS_AIV
	{
	    lane=blockIdx&1;
	    blockIdx/=2;
	}
	const int blockNum=(int)GetBlockNum();
	const int nc=N/tn;
	
    int64_t nextTask=blockIdx,local=0;
    const int period=2*blockNum;
    int gap=period-1-2*blockIdx;
    for(int bucket=tm+32;bucket>=16;bucket-=32)
	{
	    int begin=0;
	    for(int e=0;e<E;++e)
	    {
		int end=0;
		if ASCEND_IS_AIC
		{
		    end=(int)((__gm__ int64_t*)groups)[e];
		}
		if ASCEND_IS_AIV
		{
		    end=E>0?(int)groupCache.Get<int64_t>().GetValue(e)
				:(int)((__gm__ int64_t*)groups)[e];
		}
		if(end<begin)
		    end=begin;
		if(end>M)
		    end=M;
		const int me=end-begin;
		
        const bool fullPass=bucket>tm;
        const int fullTiles=me/tm,tailRows=me%tm;
        const bool selected=fullPass?fullTiles>0:tailRows>0&&(tailRows+31)/32*32==bucket;
        if(selected){
            const int mt=fullPass?fullTiles:1,firstM=fullPass?0:fullTiles;
            const int64_t tasks=int64_t(mt)*nc;
            int64_t t=nextTask;
            for(;t<tasks;t+=gap,gap=period-gap){
                const int mIdx=firstM+int(t%mt),nIdx=int(t/mt);
                const int row=begin+mIdx*tm;
			const int col=nIdx*tn;
			const int rows=(me-mIdx*tm<tm)?(me-mIdx*tm):tm;
			const int cols=tn;

			const int pitch=(cols+31)/32*32;
			const int slot=(int)(local&1);
			const uint16_t tileFlag=slot?FLAG_TILE1:FLAG_TILE0;
			const uint16_t freeFlag=slot?FLAG_FREE1:FLAG_FREE0;
			auto gcSlot=gc[(int64_t)(blockIdx*SLOTS+slot)*tm*tn];

			if ASCEND_IS_AIC
			{
			    const uint64_t futureInfo=uint64_t(row)|uint64_t(e)<<16|
							uint64_t(rows)<<23|uint64_t(col)<<31|
							uint64_t(cols)<<43;
			    int nextPanelStart=startPhase;
			    if(hasPending)
			    {
				const int64_t productOrdinal=producerOrdinal;
				const int64_t local=productOrdinal;
				const int row=pendingInfo&65535U;
				const int e=(pendingInfo>>16)&127U;
				const int rows=(pendingInfo>>23)&255U;
				const int col=(pendingInfo>>31)&4095U;
				const int cols=(pendingInfo>>43)&1023U;
				const int slot=int(local&1);
				const uint16_t tileFlag=slot?FLAG_TILE1:FLAG_TILE0;
				const uint16_t freeFlag=slot?FLAG_FREE1:FLAG_FREE0;
				auto gcSlot=gc[int64_t(blockIdx*SLOTS+slot)*tm*tn];
				const int panels=K/512;
				const bool keepA=(futureInfo&65535U)==uint64_t(row)&&
						   ((futureInfo>>23)&255U)==uint64_t(rows);
				const bool keepB=((futureInfo>>16)&127U)==uint64_t(e)&&
						   ((futureInfo>>31)&4095U)==uint64_t(col);
				if(keepA||keepB)
				    nextPanelStart=(panelStart+panels-2)%panels;
				auto acc=accBuffer.Get<int32_t>();

				int fragment=0;
				for(int panel=0;panel<panels;++panel)
				{
				    const int slot1=(panel+int(local)*(K/512))&1;
				    WaitFlag<HardEvent::MTE2_MTE1>(l1Ready[slot1]);
#pragma unroll
				    for(int sub=0;sub<8;++sub)
				    {
					const int slot0=fragment&3;
					if(l0Used[slot0])
					    WaitFlag<HardEvent::M_MTE1>(l0Free[slot0]);
					LoadData2dParams la;
					la.repeatTimes=(rows+15)/16;
					la.srcStride=1;
					la.dstGap=1;
					la.ifTranspose=false;
					LoadData2dTransposeParams lb{
					    0,uint8_t(cols/32),uint16_t(512/32),1,0,0};
#pragma unroll
					for(int ki=0;ki<2;++ki)
					{
					    LoadData(a2[slot0][ki*512],
						     a1[slot1][(sub*2+ki)*tm*32],la);
					    LoadDataWithTranspose(b2[slot0][ki*cols*32],
								  b1[slot1][(sub*2+ki)*1024],
								  lb);
					}
					SetFlag<HardEvent::MTE1_M>(l0Ready[slot0]);
					WaitFlag<HardEvent::MTE1_M>(l0Ready[slot0]);
					
					MmadParams mad;
					mad.m=(rows+15)/16*16;
					mad.n=cols;
					mad.k=64;
					mad.cmatrixInitVal=fragment==0;mad.unitFlag=(fragment+1==K/64)?3:2;
					Mmad(acc,a2[slot0],b2[slot0],mad);

					if((mad.m/16)*(mad.n/16)<10)
					    PipeBarrier<PIPE_M>();
					SetFlag<HardEvent::M_MTE1>(l0Free[slot0]);
					l0Used[slot0]=true;
					++fragment;
				    }
				    SetFlag<HardEvent::MTE1_MTE2>(l1Free[slot1]);
				    if(panel+2<panels)
				    {
					IntertilePrefetch512(gx,gw,a1[slot1],b1[slot1],true,
							  l1Free[slot1],l1Ready[slot1],row,col,
							  rows,cols,e,K,N,(panelStart+panel+2)%panels);
				    }
				    else
				    {
					IntertilePrefetch512(gx,gw,a1[slot1],b1[slot1],true,
							  l1Free[slot1],l1Ready[slot1],
							  int(futureInfo&65535U),
							  int((futureInfo>>31)&4095U),
							  int((futureInfo>>23)&255U),
							  int((futureInfo>>43)&1023U),
							  int((futureInfo>>16)&127U),K,N,
							  (nextPanelStart+panel+2-panels)%panels,keepA,keepB);
				    }
				}
				
				

				if(local>=SLOTS)
				    CrossCoreWaitFlag<2,PIPE_FIX>(freeFlag);
				FixpipeParamsV220 fix;fix.unitFlag=3;
				fix.nSize=cols;
				fix.mSize=(rows+15)/16*16;
				fix.srcStride=(rows+15)/16*16;
				fix.dstStride=tn;
				fix.quantPre=QuantMode_t::DEQF16;fix.deqScalar=0x3a800000ULL;
                Fixpipe<half,int32_t,CFG_ROW_MAJOR>(gcSlot,acc,fix);
				
				CrossCoreSetFlag<2,PIPE_FIX>(tileFlag);
			    }
			    else
			    {
#pragma unroll
				for(int p=0;p<2;++p)
				{
				    IntertilePrefetch512(gx,gw,a1[p],b1[p],l1Used[p],l1Free[p],
						      l1Ready[p],row,col,rows,cols,e,K,N,(p+startPhase)%(K/512));
				    l1Used[p]=true;
				}
			    }
			    panelStart=nextPanelStart;
			    pendingInfo=futureInfo;
			    producerOrdinal=local;
			    hasPending=true;
			}
			if ASCEND_IS_AIV
			{
			    CrossCoreWaitFlag<2,PIPE_MTE2>(tileFlag);
			    const int halfRows=(rows+1)/2;
			    const int rowOffset=lane*halfRows;
			    const int vectorRows=lane?rows-halfRows:halfRows;
			    auto c=cq.AllocTensor<half>();
			    auto scale=c.ReinterpretCast<float>()[((tm+1)/2*tn)+
								    (tm*tn>16384?64:0)];

			    if(pitch!=(cols+15)/16*16)
			    {
				Duplicate(c,half(0.0f),vectorRows*pitch);
				auto event=pipe.FetchEventID<HardEvent::V_MTE2>();
				SetFlag<HardEvent::V_MTE2>(event);
				WaitFlag<HardEvent::V_MTE2>(event);
			    }

			    if(vectorRows>0)
				DataCopyPad(
				    c,gcSlot[int64_t(rowOffset)*tn],
				    {1,uint32_t(vectorRows*tn*sizeof(half)),0,0,0},
				    {true,0,0,0});
			    DataCopyPad(scale,gs[(int64_t)e*N+col],
					{1,(uint32_t)(cols*sizeof(float)),0,0,0},
					{true,0,0,0.0f});
			    cq.EnQue(c);
			    c=cq.DeQue<half>();

			    CrossCoreSetFlag<2,PIPE_MTE2>(freeFlag);

			    auto z=zb.Get<float>();
			    auto p=c.ReinterpretCast<float>();
			    auto u=p;
			    auto t=p;

            // Legal scale is finite in [0,1] and 16384*K*scale<=60000.
            // Moving the exact power-of-two restoration to each channel avoids
            // one full-output multiply; the existing post-Cast V barrier also
            // completes this independent scale operation before broadcast Mul.
            Muls(scale,scale,1024.0f,uint32_t(cols));
			    const BinaryRepeatParams bcast{
				1,1,1,(uint8_t)(pitch/8),(uint8_t)(pitch/8),0};
			    for(int r=0;r<vectorRows;r+=vr)
			    {
				const int batch=(vectorRows-r<vr)?(vectorRows-r):vr;
				const uint32_t count=(uint32_t)batch*pitch;
				Cast(z,c[r*pitch],RoundMode::CAST_NONE,count);PipeBarrier<PIPE_V>();
				if(cols<64)
				{
				    Mul(z,z,scale,(uint64_t)64,(uint8_t)batch,bcast);
				}
				else
				{
				    for(int c0=0;c0<cols;c0+=64)
				    {
					const int chunk=(cols-c0<64)?(cols-c0):64;
					Mul(z[c0],z[c0],scale[c0],(uint64_t)chunk,
					    (uint8_t)batch,bcast);
				    }
				}
				PipeBarrier<PIPE_V>();

				p=c[r*pitch].ReinterpretCast<float>();
				u=p;
				GeluTanh(z,p,u,t,count);
				auto out=oq.AllocTensor<half>();
				Cast(out,z,RoundMode::CAST_RINT,count);
				oq.EnQue(out);
				out=oq.DeQue<half>();
				const uint32_t outBytes=(uint32_t)cols*(uint32_t)sizeof(half);
				const uint32_t outPitchBytes=
				    (uint32_t)pitch*(uint32_t)sizeof(half);
				const uint32_t outSrcStride=
				    (outPitchBytes-((outBytes+31U)/32U)*32U)/32U;
				for(int r0=0;r0<batch;r0+=32)
				{
				    const int rc=batch-r0<32?batch-r0:32;
				    DataCopyPad(gy[(int64_t)(row+rowOffset+r+r0)*N+col],
						out[r0*pitch],
						{(uint16_t)rc,outBytes,outSrcStride,
						 (uint32_t)((N-cols)*sizeof(half)),0});
				}
				oq.FreeTensor(out);
			    }
			    cq.FreeTensor(c);
			}
			++local;
		    }
		    nextTask=t-tasks;
		}
		begin=end;
	    }
	}
	if ASCEND_IS_AIC
	{
	    if(hasPending)
	    {
		const int64_t productOrdinal=producerOrdinal;
		const int64_t local=productOrdinal;
		const int row=pendingInfo&65535U;
		const int e=(pendingInfo>>16)&127U;
		const int rows=(pendingInfo>>23)&255U;
		const int col=(pendingInfo>>31)&4095U;
		const int cols=(pendingInfo>>43)&1023U;
		const int slot=int(local&1);
		const uint16_t tileFlag=slot?FLAG_TILE1:FLAG_TILE0;
		const uint16_t freeFlag=slot?FLAG_FREE1:FLAG_FREE0;
		auto gcSlot=gc[int64_t(blockIdx*SLOTS+slot)*tm*tn];
		const int panels=K/512;
		auto acc=accBuffer.Get<int32_t>();

		int fragment=0;
		for(int panel=0;panel<panels;++panel)
		{
		    const int slot1=(panel+int(local)*(K/512))&1;
		    WaitFlag<HardEvent::MTE2_MTE1>(l1Ready[slot1]);
#pragma unroll
		    for(int sub=0;sub<8;++sub)
		    {
			const int slot0=fragment&3;
			if(l0Used[slot0])
			    WaitFlag<HardEvent::M_MTE1>(l0Free[slot0]);
			LoadData2dParams la;
			la.repeatTimes=(rows+15)/16;
			la.srcStride=1;
			la.dstGap=1;
			la.ifTranspose=false;
			LoadData2dTransposeParams lb{
			    0,uint8_t(cols/32),uint16_t(512/32),1,0,0};
#pragma unroll
			for(int ki=0;ki<2;++ki)
			{
			    LoadData(a2[slot0][ki*512],a1[slot1][(sub*2+ki)*tm*32],la);
			    LoadDataWithTranspose(b2[slot0][ki*cols*32],
						  b1[slot1][(sub*2+ki)*1024],lb);
			}
			SetFlag<HardEvent::MTE1_M>(l0Ready[slot0]);
			WaitFlag<HardEvent::MTE1_M>(l0Ready[slot0]);
			
			MmadParams mad;
			mad.m=(rows+15)/16*16;
			mad.n=cols;
			mad.k=64;
			mad.cmatrixInitVal=fragment==0;mad.unitFlag=(fragment+1==K/64)?3:2;
			Mmad(acc,a2[slot0],b2[slot0],mad);

			if((mad.m/16)*(mad.n/16)<10)
			    PipeBarrier<PIPE_M>();
			SetFlag<HardEvent::M_MTE1>(l0Free[slot0]);
			l0Used[slot0]=true;
			++fragment;
		    }
		    SetFlag<HardEvent::MTE1_MTE2>(l1Free[slot1]);
		    if(panel+2<panels)
		    {
			IntertilePrefetch512(gx,gw,a1[slot1],b1[slot1],true,l1Free[slot1],
					  l1Ready[slot1],row,col,rows,cols,e,K,N,(panelStart+panel+2)%panels);
		    }
		}
		
		

		if(local>=SLOTS)
		    CrossCoreWaitFlag<2,PIPE_FIX>(freeFlag);
		FixpipeParamsV220 fix;fix.unitFlag=3;
		fix.nSize=cols;
		fix.mSize=(rows+15)/16*16;
		fix.srcStride=(rows+15)/16*16;
		fix.dstStride=tn;
		fix.quantPre=QuantMode_t::DEQF16;fix.deqScalar=0x3a800000ULL;
                Fixpipe<half,int32_t,CFG_ROW_MAJOR>(gcSlot,acc,fix);
		
		CrossCoreSetFlag<2,PIPE_FIX>(tileFlag);
	    }

	    if(local>0)
		CrossCoreWaitFlag<2,PIPE_MTE2>(FLAG_FREE0);
	    if(local>1)
		CrossCoreWaitFlag<2,PIPE_MTE2>(FLAG_FREE1);
	    
#pragma unroll
	    for(int i=0;i<2;++i)
	    {
		if(l1Used[i])
		    WaitFlag<HardEvent::MTE1_MTE2>(l1Free[i]);
		pipe.ReleaseEventID<HardEvent::MTE1_MTE2>(l1Free[i]);
		pipe.ReleaseEventID<HardEvent::MTE2_MTE1>(l1Ready[i]);
	    }
#pragma unroll
	    for(int i=0;i<4;++i)
	    {
		if(l0Used[i])
		    WaitFlag<HardEvent::M_MTE1>(l0Free[i]);
		pipe.ReleaseEventID<HardEvent::M_MTE1>(l0Free[i]);
		pipe.ReleaseEventID<HardEvent::MTE1_M>(l0Ready[i]);
	    }
	    pipe.ReleaseEventID<HardEvent::FIX_M>(accumulatorFree);
	    pipe.ReleaseEventID<HardEvent::M_FIX>(matrixReady);
	}
    }

template<int KCapacity>__aicore__ inline void ComputeBucketUnit(GM_ADDR x,GM_ADDR w,GM_ADDR sc,GM_ADDR groups,GM_ADDR y,
			  GM_ADDR workspace,int M,int runtimeK,int N,int E,
			  AscendC::tiling::TCubeTiling tiling,uint32_t l1Half)
    {
	constexpr int K=KCapacity;
	TPipe pipe;
	GlobalTensor<int8_t>gx,gw;
	GlobalTensor<float>gs;
	GlobalTensor<half>gc;
	GlobalTensor<half>gy;
	gx.SetGlobalBuffer((__gm__ int8_t*)x);
	gw.SetGlobalBuffer((__gm__ int8_t*)w);
	gs.SetGlobalBuffer((__gm__ float*)sc);
	gy.SetGlobalBuffer((__gm__ half*)y);
	gc.SetGlobalBuffer((__gm__ half*)workspace);

	const int tm=128;
	const int tn=256;

	const int capacity=16384;
	const int vr=capacity/tn;
	const int ve=vr*tn;
	TBuf<TPosition::A1>a1Buffer[2],l1Gap;
	TBuf<TPosition::B1>b1Buffer[2];
	TBuf<TPosition::A2>a2Buffer;
	TBuf<TPosition::B2>b2Buffer;
	TBuf<TPosition::CO1>accBuffer;
	LocalTensor<int8_t>a1[2],b1[2],a2[4],b2[4];
	uint8_t l1Free[2],l1Ready[2],l0Free[4],l0Ready[4];
	uint8_t accumulatorFree=0,matrixReady=0;
	bool l1Used[2]={false,false},l0Used[4]={};
	if ASCEND_IS_AIC
	{
	    pipe.InitBuffer(a1Buffer[0],tm*512);
	    pipe.InitBuffer(b1Buffer[0],tn*512);
	    const uint32_t packetBytes=(tm+tn)*512;
	    if(l1Half>packetBytes)
		pipe.InitBuffer(l1Gap,l1Half-packetBytes);
	    pipe.InitBuffer(a1Buffer[1],tm*512);
	    pipe.InitBuffer(b1Buffer[1],tn*512);
#pragma unroll
	    for(int i=0;i<2;++i)
	    {
		a1[i]=a1Buffer[i].Get<int8_t>();
		b1[i]=b1Buffer[i].Get<int8_t>();
		l1Free[i]=pipe.AllocEventID<HardEvent::MTE1_MTE2>();
		l1Ready[i]=pipe.AllocEventID<HardEvent::MTE2_MTE1>();
	    }
	    pipe.InitBuffer(a2Buffer,4*tm*64);
	    pipe.InitBuffer(b2Buffer,4*tn*64);
#pragma unroll
	    for(int i=0;i<4;++i)
	    {
		a2[i]=a2Buffer.Get<int8_t>()[i*tm*64];
		b2[i]=b2Buffer.Get<int8_t>()[i*tn*64];
		l0Free[i]=pipe.AllocEventID<HardEvent::M_MTE1>();
		l0Ready[i]=pipe.AllocEventID<HardEvent::MTE1_M>();
	    }
	    pipe.InitBuffer(accBuffer,tm*tn*sizeof(int32_t));
	    accumulatorFree=pipe.AllocEventID<HardEvent::FIX_M>();
	    matrixReady=pipe.AllocEventID<HardEvent::M_FIX>();
	}

	TQue<TPosition::VECIN,1>cq;
	TQue<TPosition::VECOUT,1>oq;
	TBuf<TPosition::VECCALC>zb,pb,groupCache;
	if ASCEND_IS_AIV
	{
	    pipe.InitBuffer(cq,1,
			    uint32_t(((tm+1)/2*tn+tn)*sizeof(float))+
				(tm*tn>16384?256:0));
	    pipe.InitBuffer(oq,1,(uint32_t)ve*sizeof(half));
	    pipe.InitBuffer(zb,(uint32_t)ve*sizeof(float));
	    if(E>0)
	    {
		pipe.InitBuffer(groupCache,(E*8+31)/32*32);
		GlobalTensor<int64_t>gg;
		gg.SetGlobalBuffer((__gm__ int64_t*)groups);
		DataCopyPad(groupCache.Get<int64_t>(),gg,{1,(uint32_t)(E*8),0,0,0},
			    {true,0,0,int64_t(0)});
		auto ready=pipe.FetchEventID<HardEvent::MTE2_S>();
		SetFlag<HardEvent::MTE2_S>(ready);
		WaitFlag<HardEvent::MTE2_S>(ready);
	    }
	}

	bool hasPending=false;
	uint64_t pendingInfo=0;
	int64_t producerOrdinal=0;
	const int startPhase=0;
	int panelStart=startPhase;
	int blockIdx=(int)GetBlockIdx();
	int lane=0;
	if ASCEND_IS_AIV
	{
	    lane=blockIdx&1;
	    blockIdx/=2;
	}
	const int blockNum=(int)GetBlockNum();
	const int nc=N/tn;
	
    int64_t nextTask=blockIdx,local=0;
    const int period=2*blockNum;
    int gap=period-1-2*blockIdx;
    for(int bucket=tm+32;bucket>=16;bucket-=32)
	{
	    int begin=0;
	    for(int e=0;e<E;++e)
	    {
		int end=0;
		if ASCEND_IS_AIC
		{
		    end=(int)((__gm__ int64_t*)groups)[e];
		}
		if ASCEND_IS_AIV
		{
		    end=E>0?(int)groupCache.Get<int64_t>().GetValue(e)
				:(int)((__gm__ int64_t*)groups)[e];
		}
		if(end<begin)
		    end=begin;
		if(end>M)
		    end=M;
		const int me=end-begin;
		
        const bool fullPass=bucket>tm;
        const int fullTiles=me/tm,tailRows=me%tm;
        const bool selected=fullPass?fullTiles>0:tailRows>0&&(tailRows+31)/32*32==bucket;
        if(selected){
            const int mt=fullPass?fullTiles:1,firstM=fullPass?0:fullTiles;
            const int64_t tasks=int64_t(mt)*nc;
            int64_t t=nextTask;
            for(;t<tasks;t+=gap,gap=period-gap){
                const int mIdx=firstM+int(t%mt),nIdx=int(t/mt);
                const int row=begin+mIdx*tm;
			const int col=nIdx*tn;
			const int rows=(me-mIdx*tm<tm)?(me-mIdx*tm):tm;
			const int cols=tn;

			const int pitch=(cols+31)/32*32;
			const int slot=(int)(local&1);
			const uint16_t tileFlag=slot?FLAG_TILE1:FLAG_TILE0;
			const uint16_t freeFlag=slot?FLAG_FREE1:FLAG_FREE0;
			auto gcSlot=gc[(int64_t)(blockIdx*SLOTS+slot)*tm*tn];

			if ASCEND_IS_AIC
			{
			    const uint64_t futureInfo=uint64_t(row)|uint64_t(e)<<16|
							uint64_t(rows)<<23|uint64_t(col)<<31|
							uint64_t(cols)<<43;
			    int nextPanelStart=startPhase;
			    if(hasPending)
			    {
				const int64_t productOrdinal=producerOrdinal;
				const int64_t local=productOrdinal;
				const int row=pendingInfo&65535U;
				const int e=(pendingInfo>>16)&127U;
				const int rows=(pendingInfo>>23)&255U;
				const int col=(pendingInfo>>31)&4095U;
				const int cols=(pendingInfo>>43)&1023U;
				const int slot=int(local&1);
				const uint16_t tileFlag=slot?FLAG_TILE1:FLAG_TILE0;
				const uint16_t freeFlag=slot?FLAG_FREE1:FLAG_FREE0;
				auto gcSlot=gc[int64_t(blockIdx*SLOTS+slot)*tm*tn];
				const int panels=K/512;
				const bool keepA=(futureInfo&65535U)==uint64_t(row)&&
						   ((futureInfo>>23)&255U)==uint64_t(rows);
				const bool keepB=((futureInfo>>16)&127U)==uint64_t(e)&&
						   ((futureInfo>>31)&4095U)==uint64_t(col);
				if(keepA||keepB)
				    nextPanelStart=(panelStart+panels-2)%panels;
				auto acc=accBuffer.Get<int32_t>();

				int fragment=0;
				for(int panel=0;panel<panels;++panel)
				{
				    const int slot1=(panel+int(local)*(K/512))&1;
				    WaitFlag<HardEvent::MTE2_MTE1>(l1Ready[slot1]);
#pragma unroll
				    for(int sub=0;sub<8;++sub)
				    {
					const int slot0=fragment&3;
					if(l0Used[slot0])
					    WaitFlag<HardEvent::M_MTE1>(l0Free[slot0]);
					LoadData2dParams la;
					la.repeatTimes=(rows+15)/16;
					la.srcStride=1;
					la.dstGap=1;
					la.ifTranspose=false;
					LoadData2dTransposeParams lb{
					    0,uint8_t(cols/32),uint16_t(512/32),1,0,0};
#pragma unroll
					for(int ki=0;ki<2;++ki)
					{
					    LoadData(a2[slot0][ki*512],
						     a1[slot1][(sub*2+ki)*tm*32],la);
					    LoadDataWithTranspose(b2[slot0][ki*cols*32],
								  b1[slot1][(sub*2+ki)*1024],
								  lb);
					}
					SetFlag<HardEvent::MTE1_M>(l0Ready[slot0]);
					WaitFlag<HardEvent::MTE1_M>(l0Ready[slot0]);
					
					MmadParams mad;
					mad.m=(rows+15)/16*16;
					mad.n=cols;
					mad.k=64;
					mad.cmatrixInitVal=fragment==0;mad.unitFlag=(fragment+1==K/64)?3:2;
					Mmad(acc,a2[slot0],b2[slot0],mad);

					if((mad.m/16)*(mad.n/16)<10)
					    PipeBarrier<PIPE_M>();
					SetFlag<HardEvent::M_MTE1>(l0Free[slot0]);
					l0Used[slot0]=true;
					++fragment;
				    }
				    SetFlag<HardEvent::MTE1_MTE2>(l1Free[slot1]);
				    if(panel+2<panels)
				    {
					IntertilePrefetch512(gx,gw,a1[slot1],b1[slot1],true,
							  l1Free[slot1],l1Ready[slot1],row,col,
							  rows,cols,e,K,N,(panelStart+panel+2)%panels);
				    }
				    else
				    {
					IntertilePrefetch512(gx,gw,a1[slot1],b1[slot1],true,
							  l1Free[slot1],l1Ready[slot1],
							  int(futureInfo&65535U),
							  int((futureInfo>>31)&4095U),
							  int((futureInfo>>23)&255U),
							  int((futureInfo>>43)&1023U),
							  int((futureInfo>>16)&127U),K,N,
							  (nextPanelStart+panel+2-panels)%panels,keepA,keepB);
				    }
				}
				
				

				if(local>=SLOTS)
				    CrossCoreWaitFlag<2,PIPE_FIX>(freeFlag);
				FixpipeParamsV220 fix;fix.unitFlag=3;
				fix.nSize=cols;
				fix.mSize=(rows+15)/16*16;
				fix.srcStride=(rows+15)/16*16;
				fix.dstStride=tn;
				fix.quantPre=QuantMode_t::DEQF16;fix.deqScalar=0x3a800000ULL;
                Fixpipe<half,int32_t,CFG_ROW_MAJOR>(gcSlot,acc,fix);
				
				CrossCoreSetFlag<2,PIPE_FIX>(tileFlag);
			    }
			    else
			    {
#pragma unroll
				for(int p=0;p<2;++p)
				{
				    IntertilePrefetch512(gx,gw,a1[p],b1[p],l1Used[p],l1Free[p],
						      l1Ready[p],row,col,rows,cols,e,K,N,(p+startPhase)%(K/512));
				    l1Used[p]=true;
				}
			    }
			    panelStart=nextPanelStart;
			    pendingInfo=futureInfo;
			    producerOrdinal=local;
			    hasPending=true;
			}
			if ASCEND_IS_AIV
			{
			    CrossCoreWaitFlag<2,PIPE_MTE2>(tileFlag);
			    const int halfRows=(rows+1)/2;
			    const int rowOffset=lane*halfRows;
			    const int vectorRows=lane?rows-halfRows:halfRows;
			    auto c=cq.AllocTensor<half>();
			    auto scale=c.ReinterpretCast<float>()[((tm+1)/2*tn)+
								    (tm*tn>16384?64:0)];

			    if(pitch!=(cols+15)/16*16)
			    {
				Duplicate(c,half(0.0f),vectorRows*pitch);
				auto event=pipe.FetchEventID<HardEvent::V_MTE2>();
				SetFlag<HardEvent::V_MTE2>(event);
				WaitFlag<HardEvent::V_MTE2>(event);
			    }

			    if(vectorRows>0)
				DataCopyPad(
				    c,gcSlot[int64_t(rowOffset)*tn],
				    {1,uint32_t(vectorRows*tn*sizeof(half)),0,0,0},
				    {true,0,0,0});
			    DataCopyPad(scale,gs[(int64_t)e*N+col],
					{1,(uint32_t)(cols*sizeof(float)),0,0,0},
					{true,0,0,0.0f});
			    cq.EnQue(c);
			    c=cq.DeQue<half>();

			    CrossCoreSetFlag<2,PIPE_MTE2>(freeFlag);

			    auto z=zb.Get<float>();
			    auto p=c.ReinterpretCast<float>();
			    auto u=p;
			    auto t=p;

			    const BinaryRepeatParams bcast{
				1,1,1,(uint8_t)(pitch/8),(uint8_t)(pitch/8),0};
			    for(int r=0;r<vectorRows;r+=vr)
			    {
				const int batch=(vectorRows-r<vr)?(vectorRows-r):vr;
				const uint32_t count=(uint32_t)batch*pitch;
				Cast(z,c[r*pitch],RoundMode::CAST_NONE,count);PipeBarrier<PIPE_V>();
                Muls(z,z,1024.0f,count);
				PipeBarrier<PIPE_V>();
				if(cols<64)
				{
				    Mul(z,z,scale,(uint64_t)64,(uint8_t)batch,bcast);
				}
				else
				{
				    for(int c0=0;c0<cols;c0+=64)
				    {
					const int chunk=(cols-c0<64)?(cols-c0):64;
					Mul(z[c0],z[c0],scale[c0],(uint64_t)chunk,
					    (uint8_t)batch,bcast);
				    }
				}
				PipeBarrier<PIPE_V>();

				p=c[r*pitch].ReinterpretCast<float>();
				u=p;
				GeluTanh(z,p,u,t,count);
				auto out=oq.AllocTensor<half>();
				Cast(out,z,RoundMode::CAST_RINT,count);
				oq.EnQue(out);
				out=oq.DeQue<half>();
				const uint32_t outBytes=(uint32_t)cols*(uint32_t)sizeof(half);
				const uint32_t outPitchBytes=
				    (uint32_t)pitch*(uint32_t)sizeof(half);
				const uint32_t outSrcStride=
				    (outPitchBytes-((outBytes+31U)/32U)*32U)/32U;
				for(int r0=0;r0<batch;r0+=32)
				{
				    const int rc=batch-r0<32?batch-r0:32;
				    DataCopyPad(gy[(int64_t)(row+rowOffset+r+r0)*N+col],
						out[r0*pitch],
						{(uint16_t)rc,outBytes,outSrcStride,
						 (uint32_t)((N-cols)*sizeof(half)),0});
				}
				oq.FreeTensor(out);
			    }
			    cq.FreeTensor(c);
			}
			++local;
		    }
		    nextTask=t-tasks;
		}
		begin=end;
	    }
	}
	if ASCEND_IS_AIC
	{
	    if(hasPending)
	    {
		const int64_t productOrdinal=producerOrdinal;
		const int64_t local=productOrdinal;
		const int row=pendingInfo&65535U;
		const int e=(pendingInfo>>16)&127U;
		const int rows=(pendingInfo>>23)&255U;
		const int col=(pendingInfo>>31)&4095U;
		const int cols=(pendingInfo>>43)&1023U;
		const int slot=int(local&1);
		const uint16_t tileFlag=slot?FLAG_TILE1:FLAG_TILE0;
		const uint16_t freeFlag=slot?FLAG_FREE1:FLAG_FREE0;
		auto gcSlot=gc[int64_t(blockIdx*SLOTS+slot)*tm*tn];
		const int panels=K/512;
		auto acc=accBuffer.Get<int32_t>();

		int fragment=0;
		for(int panel=0;panel<panels;++panel)
		{
		    const int slot1=(panel+int(local)*(K/512))&1;
		    WaitFlag<HardEvent::MTE2_MTE1>(l1Ready[slot1]);
#pragma unroll
		    for(int sub=0;sub<8;++sub)
		    {
			const int slot0=fragment&3;
			if(l0Used[slot0])
			    WaitFlag<HardEvent::M_MTE1>(l0Free[slot0]);
			LoadData2dParams la;
			la.repeatTimes=(rows+15)/16;
			la.srcStride=1;
			la.dstGap=1;
			la.ifTranspose=false;
			LoadData2dTransposeParams lb{
			    0,uint8_t(cols/32),uint16_t(512/32),1,0,0};
#pragma unroll
			for(int ki=0;ki<2;++ki)
			{
			    LoadData(a2[slot0][ki*512],a1[slot1][(sub*2+ki)*tm*32],la);
			    LoadDataWithTranspose(b2[slot0][ki*cols*32],
						  b1[slot1][(sub*2+ki)*1024],lb);
			}
			SetFlag<HardEvent::MTE1_M>(l0Ready[slot0]);
			WaitFlag<HardEvent::MTE1_M>(l0Ready[slot0]);
			
			MmadParams mad;
			mad.m=(rows+15)/16*16;
			mad.n=cols;
			mad.k=64;
			mad.cmatrixInitVal=fragment==0;mad.unitFlag=(fragment+1==K/64)?3:2;
			Mmad(acc,a2[slot0],b2[slot0],mad);

			if((mad.m/16)*(mad.n/16)<10)
			    PipeBarrier<PIPE_M>();
			SetFlag<HardEvent::M_MTE1>(l0Free[slot0]);
			l0Used[slot0]=true;
			++fragment;
		    }
		    SetFlag<HardEvent::MTE1_MTE2>(l1Free[slot1]);
		    if(panel+2<panels)
		    {
			IntertilePrefetch512(gx,gw,a1[slot1],b1[slot1],true,l1Free[slot1],
					  l1Ready[slot1],row,col,rows,cols,e,K,N,(panelStart+panel+2)%panels);
		    }
		}
		
		

		if(local>=SLOTS)
		    CrossCoreWaitFlag<2,PIPE_FIX>(freeFlag);
		FixpipeParamsV220 fix;fix.unitFlag=3;
		fix.nSize=cols;
		fix.mSize=(rows+15)/16*16;
		fix.srcStride=(rows+15)/16*16;
		fix.dstStride=tn;
		fix.quantPre=QuantMode_t::DEQF16;fix.deqScalar=0x3a800000ULL;
                Fixpipe<half,int32_t,CFG_ROW_MAJOR>(gcSlot,acc,fix);
		
		CrossCoreSetFlag<2,PIPE_FIX>(tileFlag);
	    }

	    if(local>0)
		CrossCoreWaitFlag<2,PIPE_MTE2>(FLAG_FREE0);
	    if(local>1)
		CrossCoreWaitFlag<2,PIPE_MTE2>(FLAG_FREE1);
	    
#pragma unroll
	    for(int i=0;i<2;++i)
	    {
		if(l1Used[i])
		    WaitFlag<HardEvent::MTE1_MTE2>(l1Free[i]);
		pipe.ReleaseEventID<HardEvent::MTE1_MTE2>(l1Free[i]);
		pipe.ReleaseEventID<HardEvent::MTE2_MTE1>(l1Ready[i]);
	    }
#pragma unroll
	    for(int i=0;i<4;++i)
	    {
		if(l0Used[i])
		    WaitFlag<HardEvent::M_MTE1>(l0Free[i]);
		pipe.ReleaseEventID<HardEvent::M_MTE1>(l0Free[i]);
		pipe.ReleaseEventID<HardEvent::MTE1_M>(l0Ready[i]);
	    }
	    pipe.ReleaseEventID<HardEvent::FIX_M>(accumulatorFree);
	    pipe.ReleaseEventID<HardEvent::M_FIX>(matrixReady);
	}
    }
template<int K,int N>__aicore__ inline uint32_t TinyProduceStaged(GM_ADDR x,GM_ADDR w,GM_ADDR s,LocalTensor<float>z,LocalTensor<float>p,
		int row,int expert)
    {
#pragma clang fp contract(off)
	LocalTensor<int8_t>wb(TPosition::VECCALC,512,256);
    LocalTensor<float>sb(TPosition::VECCALC,768,64);
    LocalTensor<int8_t>xb(TPosition::VECCALC,1024,32);int32_t rowX[K];
#pragma unroll
	for(int k=0;k<K;++k)
	    rowX[k]=k<K?int32_t(xb.GetValue(k)):0;
	float values[N];bool small=true;
#pragma unroll
	for(int col=0;col<N;++col)
	{
	    if(col>=N)
		continue;
	    int32_t sum=0;
#pragma unroll
	    for(int k=0;k<K;++k)
		if(k<K)
		    sum+=rowX[k]*
			   int32_t(wb.GetValue((expert*K+k)*N+col));
	    const float input=float(sum)*sb.GetValue(expert*N+col);
	    
        values[col]=input;
        small&=input*input<=0.0625f;
    }
    auto out=p.ReinterpretCast<half>();
    if(small){
#pragma unroll
        for(int col=0;col<N;++col){
            const float v=values[col];
            out.SetValue(col,static_cast<half>(0.5f*v+0.39894228f*v*v));
        }
    }else{
#pragma unroll
        for(int col=0;col<N;++col)
            out.SetValue(col,static_cast<half>(gmm_device::SingletonScalarGelu(values[col])));
    }
    return 0;
}
template<int KFixed,int NFixed>
__global__ __aicore__ __vector__ void TinyStagedKernel(GM_ADDR x,GM_ADDR w,GM_ADDR s,
						       GM_ADDR groups,GM_ADDR y,int M,int K,
						       int N,int E)
    {
#pragma clang fp contract(off)

    AscendC::GlobalTensor<uint64_t>cacheLine;
    cacheLine.SetGlobalBuffer((__gm__ uint64_t*)groups);AscendC::DataCachePreload(cacheLine,int64_t(0));
	LocalTensor<float>z(TPosition::VECCALC,0,64);
	LocalTensor<float>p(TPosition::VECCALC,256,64);
	GlobalTensor<half>gy;
	gy.SetGlobalBuffer((__gm__ half*)y);
	const int row=GetBlockIdx();
	{
	    
	    
    LocalTensor<int8_t>wb(TPosition::VECCALC,512,256);
    LocalTensor<float>sb(TPosition::VECCALC,768,64);
    GlobalTensor<int8_t>wg;wg.SetGlobalBuffer((__gm__ int8_t*)w);
    GlobalTensor<float>sg;sg.SetGlobalBuffer((__gm__ float*)s);
    LocalTensor<int8_t>xb(TPosition::VECCALC,1024,32);
    GlobalTensor<int8_t>xg;
    xg.SetGlobalBuffer((__gm__ int8_t*)x);
    DataCopyPad(xb,xg[int64_t(row)*KFixed],{1,uint32_t(KFixed),0,0,0},{true,0,0,int8_t(0)});
    DataCopyPad(wb,wg,{1,uint32_t(E*KFixed*NFixed),0,0,0},{false,0,0,int8_t(0)});
    DataCopyPad(sb,sg,{1,uint32_t(E*NFixed*4),0,0,0},{false,0,0,0.0f});
    
    int expert=0;
    
    
	    if(E<=4){
        const auto ends=(__gm__ int64_t*)groups;
        if(E>1)expert+=ends[0]<=row;
        if(E>2)expert+=ends[1]<=row;
        if(E>3)expert+=ends[2]<=row;
    }else{
        while(expert+1<E&&((__gm__ int64_t*)groups)[expert]<=row)++expert;
    }
	    uint32_t risk=0;
	    SetFlag<HardEvent::MTE2_S>(EVENT_ID0);WaitFlag<HardEvent::MTE2_S>(EVENT_ID0);
	    TinyProduceStaged<KFixed,NFixed>(x,w,s,z,p,row,expert);
auto out=p.ReinterpretCast<half>();
	    
	    constexpr auto written=EVENT_ID0;
	    SetFlag<HardEvent::S_MTE3>(written);
	    WaitFlag<HardEvent::S_MTE3>(written);
	    DataCopyPad(gy[int64_t(row)*N],out,{1,uint32_t(NFixed*2),0,0,0});
	}
	SetFlag<HardEvent::MTE3_S>(0);WaitFlag<HardEvent::MTE3_S>(0);
    }

}

namespace gmm_imported {
template<int Schedule,bool RowMajor,bool Unit,bool A3D>
__aicore__ inline void ComputeWideDetails(GM_ADDR x,GM_ADDR w,GM_ADDR sc,GM_ADDR groups,GM_ADDR y,
		      GM_ADDR workspace,int M,int K,int N,int E,
		      AscendC::tiling::TCubeTiling tiling,uint32_t l1Half)
    {
	TPipe pipe;
	GlobalTensor<int8_t>gx,gw;
	GlobalTensor<float>gs;
	GlobalTensor<half>gc;
	GlobalTensor<half>gy;
	gx.SetGlobalBuffer((__gm__ int8_t*)x);
	gw.SetGlobalBuffer((__gm__ int8_t*)w);
	gs.SetGlobalBuffer((__gm__ float*)sc);
	gy.SetGlobalBuffer((__gm__ half*)y);
	gc.SetGlobalBuffer((__gm__ half*)workspace);

	const int tm=64;
	const int tn=512;

	const int capacity=16384;
	const int vr=capacity/tn;
	const int ve=vr*tn;
	TBuf<TPosition::A1>a1Buffer[2],l1Gap;
	TBuf<TPosition::B1>b1Buffer[2];
	TBuf<TPosition::A2>a2Buffer[2];
	TBuf<TPosition::B2>b2Buffer[2];
	TBuf<TPosition::CO1>accBuffer;
	LocalTensor<int8_t>a1[2],b1[2],a2[2],b2[2];
	uint8_t l1Free[2],l1Ready[2],l0Free[2],l0Ready[2];
	uint8_t accumulatorFree=0,matrixReady=0;
	bool l1Used[2]={false,false},l0Used[2]={false,false};
	if ASCEND_IS_AIC
	{
	    pipe.InitBuffer(a1Buffer[0],tm*256);
	    pipe.InitBuffer(b1Buffer[0],tn*256);
	    const uint32_t packetBytes=(tm+tn)*256;
	    if(l1Half>packetBytes)
		pipe.InitBuffer(l1Gap,l1Half-packetBytes);
	    pipe.InitBuffer(a1Buffer[1],tm*256);
	    pipe.InitBuffer(b1Buffer[1],tn*256);
#pragma unroll
	    for(int i=0;i<2;++i)
	    {
		pipe.InitBuffer(a2Buffer[i],tm*64);
		pipe.InitBuffer(b2Buffer[i],tn*64);
		a1[i]=a1Buffer[i].Get<int8_t>();
		b1[i]=b1Buffer[i].Get<int8_t>();
		a2[i]=a2Buffer[i].Get<int8_t>();
		b2[i]=b2Buffer[i].Get<int8_t>();
		l1Free[i]=pipe.AllocEventID<HardEvent::MTE1_MTE2>();
		l1Ready[i]=pipe.AllocEventID<HardEvent::MTE2_MTE1>();
		l0Free[i]=pipe.AllocEventID<HardEvent::M_MTE1>();
		l0Ready[i]=pipe.AllocEventID<HardEvent::MTE1_M>();
	    }
	    pipe.InitBuffer(accBuffer,tm*tn*sizeof(int32_t));
if constexpr(A3D){const uint8_t pads[4]={};SetFmatrix(1,tm,pads,FmatrixMode::FMATRIX_LEFT);}
	    accumulatorFree=pipe.AllocEventID<HardEvent::FIX_M>();
	    matrixReady=pipe.AllocEventID<HardEvent::M_FIX>();
	}

	TQue<TPosition::VECIN,1>cq,sq;
	TQue<TPosition::VECOUT,1>oq;
	TBuf<TPosition::VECCALC>zb,pb,groupCache;
	if ASCEND_IS_AIV
	{
	    pipe.InitBuffer(cq,1,(uint32_t)((tm+1)/2*tn)*sizeof(int32_t));
	    pipe.InitBuffer(sq,1,(uint32_t)tn*sizeof(float)+(tm*tn>16384?256:0));
	    pipe.InitBuffer(oq,1,(uint32_t)ve*sizeof(half));
	    pipe.InitBuffer(zb,(uint32_t)ve*sizeof(float));
	    if(E>0)
	    {
		pipe.InitBuffer(groupCache,(E*8+31)/32*32);
		GlobalTensor<int64_t>gg;
		gg.SetGlobalBuffer((__gm__ int64_t*)groups);
		DataCopyPad(groupCache.Get<int64_t>(),gg,{1,(uint32_t)(E*8),0,0,0},
			    {true,0,0,int64_t(0)});
		auto ready=pipe.FetchEventID<HardEvent::MTE2_S>();
		SetFlag<HardEvent::MTE2_S>(ready);
		WaitFlag<HardEvent::MTE2_S>(ready);
	    }
	}

	int blockIdx=(int)GetBlockIdx();
	int lane=0;
	if ASCEND_IS_AIV
	{
	    lane=blockIdx&1;
	    blockIdx/=2;
	}
	const int blockNum=(int)GetBlockNum();
	const int nc=(N+tn-1)/tn;
	
    int64_t local=0,taskBase=0,total=0;
    if constexpr(Schedule==2){int previous=0;
        for(int e=0;e<E;++e){int end=int(((__gm__ int64_t*)groups)[e]);
            total+=int64_t((end-previous+tm-1)/tm)*nc;previous=end;}}
    const int64_t taskBegin=total*blockIdx/blockNum,taskEnd=total*(blockIdx+1)/blockNum;
    {
        for(int e=(Schedule==0?blockIdx:0);e<E;e+=(Schedule==0?blockNum:1)){
            int begin=0,end=0;
            if ASCEND_IS_AIC{
                const auto ends=(__gm__ int64_t*)groups;
                begin=e?int(ends[e-1]):0;end=int(ends[e]);
            }
            if ASCEND_IS_AIV{
                auto ends=groupCache.Get<int64_t>();
                begin=e?int(ends.GetValue(e-1)):0;end=int(ends.GetValue(e));
            }
            if(end<begin)end=begin;
            if(end>M)end=M;
            const int me=end-begin;
		
        if(me>0){
            const int mt=(me+tm-1)/tm,firstM=0;
            const int64_t tasks=(int64_t)mt*nc;

		    
            int64_t firstTask=0,lastTask=tasks;
            if constexpr(Schedule==1)firstTask=(blockIdx-taskBase%blockNum+blockNum)%blockNum;
            if constexpr(Schedule==2){firstTask=taskBegin>taskBase?taskBegin-taskBase:0;
                if(taskEnd<taskBase+tasks)lastTask=taskEnd-taskBase;}
            for(int64_t t=firstTask;t<lastTask;t+=(Schedule==1?blockNum:1))
		    {

			const int mIdx=firstM+(RowMajor?int(t/nc):(mt==1?0:int(t%mt)));
			const int nIdx=RowMajor?int(t%nc):(mt==1?int(t):int(t/mt));
			const int row=begin+mIdx*tm;
			const int col=nIdx*tn;
			const int rows=(me-mIdx*tm<tm)?(me-mIdx*tm):tm;
			const int cols=(N-col<tn)?(N-col):tn;

			const int pitch=(cols+31)/32*32;
			const int slot=(int)(local&1);
			const uint16_t tileFlag=slot?FLAG_TILE1:FLAG_TILE0;
			const uint16_t freeFlag=slot?FLAG_FREE1:FLAG_FREE0;
			auto gcSlot=gc[(int64_t)(blockIdx*SLOTS+slot)*tm*tn];

			if ASCEND_IS_AIC
			{
			    const int panels=K/256;
			    auto acc=accBuffer.Get<int32_t>();
#pragma unroll
			    for(int p=0;p<2;++p)
			    {
				OwnedWidePrefetch(gx,gw,a1[p],b1[p],l1Used[p],l1Free[p],
						   l1Ready[p],row,col,rows,cols,e,K,N,p);
				l1Used[p]=true;
			    }
			    int fragment=0;
			    for(int panel=0;panel<panels;++panel)
			    {
				const int slot1=panel&1;
				WaitFlag<HardEvent::MTE2_MTE1>(l1Ready[slot1]);
#pragma unroll
				for(int sub=0;sub<4;++sub)
				{
				    const int slot0=fragment&1;
				    if(l0Used[slot0])
					WaitFlag<HardEvent::M_MTE1>(l0Free[slot0]);
				    LoadData2dTransposeParams lb{
					0,uint8_t(cols/32),uint16_t(256/32),1,0,0};
#pragma unroll
				    for(int ki=0;ki<2;++ki)
					LoadDataWithTranspose(b2[slot0][ki*cols*32],
							      b1[slot1][(sub*2+ki)*1024],lb);
				    if constexpr(A3D){LoadData3DParamsV2Pro p;p.channelSize=256;
                        p.extConfig=(uint64_t(sub*64)<<32)|(uint64_t((rows+15)/16*16)<<16)|uint64_t(64);
                        LoadData(a2[slot0],a1[slot1],p);
                    }else{
LoadData2dParams la;
				    la.repeatTimes=(rows+15)/16;
				    la.srcStride=1;
				    la.dstGap=1;
				    la.ifTranspose=false;
#pragma unroll
				    for(int ki=0;ki<2;++ki)
				    {
					LoadData(a2[slot0][ki*512],
						 a1[slot1][(sub*2+ki)*tm*32],la);
				    }
				    
}
SetFlag<HardEvent::MTE1_M>(l0Ready[slot0]);
				    WaitFlag<HardEvent::MTE1_M>(l0Ready[slot0]);
				    if(!Unit&&fragment==0&&local>0)
					WaitFlag<HardEvent::FIX_M>(accumulatorFree);
				    MmadParams mad;
				    mad.m=(rows+15)/16*16;
				    mad.n=cols;
				    mad.k=64;
				    mad.cmatrixInitVal=fragment==0;
if constexpr(Unit)mad.unitFlag=fragment+1==panels*4?3:2;
				    Mmad(acc,a2[slot0],b2[slot0],mad);
				    if((mad.m/16)*(mad.n/16)<10)
					PipeBarrier<PIPE_M>();
				    SetFlag<HardEvent::M_MTE1>(l0Free[slot0]);
				    l0Used[slot0]=true;
				    ++fragment;
				}
				SetFlag<HardEvent::MTE1_MTE2>(l1Free[slot1]);
				if(panel+2<panels)
				{
				    OwnedWidePrefetch(gx,gw,a1[slot1],b1[slot1],true,
						       l1Free[slot1],l1Ready[slot1],row,col,
						       rows,cols,e,K,N,panel+2);
				}
			    }
			    if constexpr(!Unit){SetFlag<HardEvent::M_FIX>(matrixReady);WaitFlag<HardEvent::M_FIX>(matrixReady);}

			    if(local>=SLOTS)
				CrossCoreWaitFlag<2,PIPE_FIX>(freeFlag);
			    FixpipeParamsV220 fix;if constexpr(Unit)fix.unitFlag=3;
			    fix.nSize=cols;
			    fix.mSize=(rows+15)/16*16;
			    fix.srcStride=(rows+15)/16*16;
			    fix.dstStride=tn;
			    fix.quantPre=QuantMode_t::DEQF16;fix.deqScalar=0x3a800000ULL;
                Fixpipe<half,int32_t,CFG_ROW_MAJOR>(gcSlot,acc,fix);
			    if constexpr(!Unit)SetFlag<HardEvent::FIX_M>(accumulatorFree);
			    CrossCoreSetFlag<2,PIPE_FIX>(tileFlag);
			}
			if ASCEND_IS_AIV
			{
			    CrossCoreWaitFlag<2,PIPE_MTE2>(tileFlag);
			    const int halfRows=(rows+1)/2;
			    const int rowOffset=lane*halfRows;
			    const int vectorRows=lane?rows-halfRows:halfRows;
			    auto c=cq.AllocTensor<half>();
			    auto scale=sq.AllocTensor<float>();

			    if(pitch!=(cols+15)/16*16)
			    {
				Duplicate(c,half(0.0f),vectorRows*pitch);
				auto event=pipe.FetchEventID<HardEvent::V_MTE2>();
				SetFlag<HardEvent::V_MTE2>(event);
				WaitFlag<HardEvent::V_MTE2>(event);
			    }

			    for(int r0=0;r0<vectorRows;r0+=32)
			    {
				const int rc=(vectorRows-r0<32)?(vectorRows-r0):32;
				DataCopyPad(
				    c[r0*pitch],gcSlot[(int64_t)(rowOffset+r0)*tn],
				    {(uint16_t)rc,(uint32_t)(cols*sizeof(half)),
				     (uint32_t)((tn-cols)*sizeof(half)),
				     (uint32_t)((pitch*sizeof(half)-
						 ((cols*sizeof(half)+31)/32)*32)/
						32),
				     0},
				    {true,0,0,0});
			    }
			    DataCopyPad(scale,gs[(int64_t)e*N+col],
					{1,(uint32_t)(cols*sizeof(float)),0,0,0},
					{true,0,0,0.0f});
			    cq.EnQue(c);
			    sq.EnQue(scale);
			    c=cq.DeQue<half>();
			    scale=sq.DeQue<float>();

			    CrossCoreSetFlag<2,PIPE_MTE2>(freeFlag);

			    auto z=zb.Get<float>();
			    auto p=c.ReinterpretCast<float>();
			    auto u=p;
			    auto t=p;

			    const BinaryRepeatParams bcast{
				1,1,1,(uint8_t)(pitch/8),(uint8_t)(pitch/8),0};
			    for(int r=0;r<vectorRows;r+=vr)
			    {
				const int batch=(vectorRows-r<vr)?(vectorRows-r):vr;
				const uint32_t count=(uint32_t)batch*pitch;
				Cast(z,c[r*pitch],RoundMode::CAST_NONE,count);PipeBarrier<PIPE_V>();
                Muls(z,z,1024.0f,count);
				PipeBarrier<PIPE_V>();
				if(cols<64)
				{
				    Mul(z,z,scale,(uint64_t)64,(uint8_t)batch,bcast);
				}
				else
				{
				    for(int c0=0;c0<cols;c0+=64)
				    {
					const int chunk=(cols-c0<64)?(cols-c0):64;
					Mul(z[c0],z[c0],scale[c0],(uint64_t)chunk,
					    (uint8_t)batch,bcast);
				    }
				}
				PipeBarrier<PIPE_V>();

				p=c[r*pitch].ReinterpretCast<float>();
				u=p;
				GeluTanh(z,p,u,t,count);
				auto out=oq.AllocTensor<half>();
				Cast(out,z,RoundMode::CAST_RINT,count);
				oq.EnQue(out);
				out=oq.DeQue<half>();
				const uint32_t outBytes=(uint32_t)cols*(uint32_t)sizeof(half);
				const uint32_t outPitchBytes=
				    (uint32_t)pitch*(uint32_t)sizeof(half);
				const uint32_t outSrcStride=
				    (outPitchBytes-((outBytes+31U)/32U)*32U)/32U;
				for(int r0=0;r0<batch;r0+=32)
				{
				    const int rc=batch-r0<32?batch-r0:32;
				    DataCopyPad(gy[(int64_t)(row+rowOffset+r+r0)*N+col],
						out[r0*pitch],
						{(uint16_t)rc,outBytes,outSrcStride,
						 (uint32_t)((N-cols)*sizeof(half)),0});
				}
				oq.FreeTensor(out);
			    }
			    cq.FreeTensor(c);
			    sq.FreeTensor(scale);
			}
			++local;
		    }
		    
		taskBase+=tasks;
		}
		
	    }
	}
	if ASCEND_IS_AIC
	{

	    if(local>0)
		CrossCoreWaitFlag<2,PIPE_MTE2>(FLAG_FREE0);
	    if(local>1)
		CrossCoreWaitFlag<2,PIPE_MTE2>(FLAG_FREE1);
	    if(!Unit&&local>0)WaitFlag<HardEvent::FIX_M>(accumulatorFree);
#pragma unroll
	    for(int i=0;i<2;++i)
	    {
		if(l1Used[i])
		    WaitFlag<HardEvent::MTE1_MTE2>(l1Free[i]);
		if(l0Used[i])
		    WaitFlag<HardEvent::M_MTE1>(l0Free[i]);
		pipe.ReleaseEventID<HardEvent::MTE1_MTE2>(l1Free[i]);
		pipe.ReleaseEventID<HardEvent::MTE2_MTE1>(l1Ready[i]);
		pipe.ReleaseEventID<HardEvent::M_MTE1>(l0Free[i]);
		pipe.ReleaseEventID<HardEvent::MTE1_M>(l0Ready[i]);
	    }
	    pipe.ReleaseEventID<HardEvent::FIX_M>(accumulatorFree);
	    pipe.ReleaseEventID<HardEvent::M_FIX>(matrixReady);
	}
    }

}

// Every entry below performs the entire operator in one launch. Layout
// conversion, when selected, is a device function in that same launch.
#define GMM_ARGUMENTS GM_ADDR x,GM_ADDR w,GM_ADDR sc,GM_ADDR groups,GM_ADDR y,GM_ADDR workspace,int M,int K,int N,int E
#define GMM_FORWARD x,w,sc,groups,y,workspace,M,K,N,E

namespace gmm_device {
__global__ __mix__(1,2) void ResidentNarrowBKernel(GMM_ARGUMENTS,uint32_t halfL1) {
    ComputeResident<144,160,2,1,2,1,2,0,1,4,64,false,true>(GMM_FORWARD);
}
template<int TM,int TN,bool FullB=false>
__global__ __mix__(1,2) void ResidentKernel(GMM_ARGUMENTS) {
    if constexpr(TM==192 && TN==128 && !FullB)
        ComputeSplitTransport<192,128,2,64,4,1,2,false,true,512,0,true,true>(GMM_FORWARD);
    else if constexpr(TM>=192 && TN==128 && !FullB)
        ComputeTransportResident<TM,TN,512,1>(GMM_FORWARD);
    else ComputeResident<TM,TN,FullB?4:1,1,FullB?1:2,1,2,0,1,4,64,FullB,true>(GMM_FORWARD);
}
template<int FixedK=0>
__global__ __mix__(1,2) void AlignedShortKernel(GMM_ARGUMENTS) {
    AscendC::tiling::TCubeTiling unused{};
    ComputeDirectFixed<64,256,FixedK>(GMM_FORWARD,unused);
}
template<int Panels,int TM>
__global__ __mix__(1,2) void FourPacketKernel(GMM_ARGUMENTS,uint32_t halfL1) {
    AscendC::tiling::TCubeTiling unused{};
    ComputeShortFourpack256<Panels*256,TM>(GMM_FORWARD,unused,halfL1);
}
template<bool CrossTile>
__global__ __mix__(1,2) void AlignedDeepKernel(GMM_ARGUMENTS,uint32_t halfL1) {
    AscendC::tiling::TCubeTiling unused{};
    if constexpr(CrossTile) ComputeIntertile_deep(GMM_FORWARD,unused,halfL1);
    else ComputeDeepCapacity(GMM_FORWARD,unused,halfL1);
}
__global__ __mix__(1,2) void AlignedWideKernel(GMM_ARGUMENTS,uint32_t halfL1) {
    AscendC::tiling::TCubeTiling unused{};
    ComputeAlignedWide(GMM_FORWARD,unused,halfL1);
}
__global__ __mix__(1,2) void StreamingKernel(GMM_ARGUMENTS,uint32_t halfL1) {
    AscendC::tiling::TCubeTiling unused{};
    ComputeDeepTailUnified<128,256,512>(GMM_FORWARD,unused,halfL1);
}
template<int CopyRows>
__global__ __mix__(1,2) void PackedBothKernel(GMM_ARGUMENTS,uint32_t halfL1) {
    AscendC::tiling::TCubeTiling unused{};
    GM_ADDR xp=workspace+uint64_t(GetBlockNum())*262144;
    GM_ADDR wp=xp+uint64_t((M+15)/16*16)*((K+63)/64*64);
    PrepareTransportNZPipeline<CopyRows,true>(x,w,xp,wp,M,K,N,E);
    // Evaluate actual group lengths on Device. Shape-derived averages never
    // determine expert ownership or replace the input group_list.
    int previous=0;
    int64_t rows96=0,rows128=0;
    for(int e=0;e<E;++e) {
        const int end=int(((__gm__ int64_t*)groups)[e]);
        const int rows=end-previous;
        rows96+=(rows+95)/96;rows128+=(rows+127)/128;previous=end;
    }
    const int nc=(N+191)/192,cores=int(GetBlockNum());
    const int64_t waves96=(rows96*nc+cores-1)/cores;
    const int64_t waves128=(rows128*nc+cores-1)/cores;
    if(waves96*96>waves128*128)
        ComputeTransportNZ<128,192,768>(xp,wp,sc,groups,y,workspace,M,K,N,E,unused,halfL1);
    else ComputeTransportNZ<96,192,896>(xp,wp,sc,groups,y,workspace,M,K,N,E,unused,halfL1);
}
__global__ __mix__(1,2) void PackedWeightResidentKernel(GMM_ARGUMENTS,uint32_t halfL1) {
    GM_ADDR wp=workspace+uint64_t(GetBlockNum())*2*96*256*4;
    WeightPackedPrepareTransportNZPipeline<16,false>(x,w,wp,wp,M,K,N,E);
    ComputePackedWeightResident<96,256,1,2,1,1,2,1,1,4,64,false,true>(
        x,wp,sc,groups,y,workspace,M,K,N,E);
}
__global__ __mix__(1,2) void PackedWeightResidentBufferedKernel(GMM_ARGUMENTS,uint32_t halfL1) {
    GM_ADDR wp=workspace+uint64_t(GetBlockNum())*2*96*256*4;
    WeightPackedPrepareTransportNZPipeline<16,false>(x,w,wp,wp,M,K,N,E);
    ComputePackedWeightResident<96,256,1,2,1,1,2,1,1,4,64,false,true,true>(
        x,wp,sc,groups,y,workspace,M,K,N,E);
}
template<int CopyRows>
__global__ __mix__(1,2) void PackedWeightKernel(GMM_ARGUMENTS,uint32_t halfL1) {
    AscendC::tiling::TCubeTiling unused{};
    GM_ADDR wp=workspace+uint64_t(GetBlockNum())*262144;
    WeightPackedPrepareTransportNZPipeline<CopyRows,false>(x,w,wp,wp,M,K,N,E);
    WeightPackedComputeTransportNZ<128,256,512>(x,wp,sc,groups,y,workspace,M,K,N,E,unused,halfL1);
}
__global__ __mix__(1,1) void SdkKernel(GMM_ARGUMENTS,AscendC::tiling::TCubeTiling tiling) {
    ComputeSdk(GMM_FORWARD,tiling);
}
}

namespace gmm_imported {
__global__ __mix__(1,2) void BalancedWideKernel(GMM_ARGUMENTS,uint32_t halfL1) {
    AscendC::tiling::TCubeTiling unused{};
    ComputeWideDetails<1,false,true,true>(GMM_FORWARD,unused,halfL1);
}
__global__ __mix__(1,2) void OwnedWideKernel(GMM_ARGUMENTS,uint32_t halfL1) {
    AscendC::tiling::TCubeTiling unused{};
    ComputeOwnedWide(GMM_FORWARD,unused,halfL1);
}
__global__ __mix__(1,2) void BucketPairKernel(GMM_ARGUMENTS,uint32_t halfL1) {
    AscendC::tiling::TCubeTiling unused{};
    ComputeBucketPair<2*512>(GMM_FORWARD,unused,halfL1);
}
template<int Rows=96>
__global__ __mix__(1,2) void OwnedShortKernel(GMM_ARGUMENTS) {
    AscendC::tiling::TCubeTiling unused{};
    ComputeOwnedShort<Rows,256,256>(GMM_FORWARD,unused);
}
__global__ __mix__(1,2) void BucketUnitKernel(GMM_ARGUMENTS,uint32_t halfL1) {
    AscendC::tiling::TCubeTiling unused{};
    ComputeBucketUnitScaleHoistPrivate<4*512>(GMM_FORWARD,unused,halfL1);
}
}

// Exhaustive packet-count/range specializations, not testcase identities.
namespace gmm_imported {
template<int Packets>
__global__ __mix__(1,2) void BucketPairRangeKernel(GMM_ARGUMENTS,uint32_t halfL1) {
    static_assert(Packets>=2 && Packets<=3);
    AscendC::tiling::TCubeTiling unused{};
    ComputeBucketPair<Packets*512>(GMM_FORWARD,unused,halfL1);
}
template<int Packets>
__global__ __mix__(1,2) void BucketUnitRangeKernel(GMM_ARGUMENTS,uint32_t halfL1) {
    static_assert(Packets>=2 && Packets<=7);
    AscendC::tiling::TCubeTiling unused{};
    ComputeBucketUnitScaleHoistPrivate<Packets*512>(GMM_FORWARD,unused,halfL1);
}
template<int Reduction,int Rows=96>
__global__ __mix__(1,2) void OwnedShortRangeKernel(GMM_ARGUMENTS) {
    static_assert(Reduction>=32 && Reduction<=256 && Reduction%32==0);
    AscendC::tiling::TCubeTiling unused{};
    ComputeOwnedShort<Rows,256,Reduction>(GMM_FORWARD,unused);
}
}

// Pure metadata planner. This file has no input tensor pointer and cannot
// inspect input values. Template constants describe SRAM tiles, never cases.
#include <cstdint>
#include <cstddef>
#include <algorithm>

namespace gmm_plan {
inline int Up(int v,int a) { return (v+a-1)/a*a; }
inline int DivUp(int v,int a) { return (v+a-1)/a; }
struct Shape { int M,K,N,E; };
struct Hardware {
    uint32_t aic,aiv;
    uint64_t l1,l0a,l0b,l0c,ub,l2;
};
// X preparation is useful when several column tiles reuse a working set
// that fits the device L2. This is a performance preference, not a data test.
inline bool PreferPackedX(const Shape& s,const Hardware& h) {
    const uint64_t bytes=uint64_t(Up(s.M,16))*Up(s.K,64)
        +uint64_t(s.E)*Up(s.K,64)*Up(s.N,32);
    return DivUp(s.N,256)>=8 && h.l2 && bytes<=h.l2;
}
enum class Family { Unit,SmallVector,Compact,AlignedShort,FourPacket,
    OwnedWide,BucketPair,OwnedShort,BucketUnit,StagedTiny,
    AlignedWide,AlignedDeep,Resident,PackedWeight,PackedWeightResident,PackedBoth,Streaming,Sdk };
enum class ResidentSchedule { DoubleB, FullB, ContinuousTasks };
struct Plan {
    ResidentSchedule residentSchedule=ResidentSchedule::DoubleB;
    Family family=Family::Sdk;
    int tm=64,tn=256,pk=512;
    bool fullB=false,crossTile=false,doubleInput=false,packX=false;
    int copyRows=16;
    uint32_t cores=0,halfL1=0;
    size_t workspace=0;
};
inline uint64_t VectorBytes(int tm,int tn,int E,int capacity=8192) {
    return uint64_t((tm+1)/2*tn+tn)*4+(tm*tn>16384?256:0)
        +uint64_t(Up(capacity/tn*tn,64))*6+Up(E*8,32)+512;
}
inline bool TileFits(const Hardware& h,int tm,int tn,int E,int slots=4,int capacity=8192) {
    return uint64_t(slots)*tm*64<=h.l0a && uint64_t(slots)*tn*64<=h.l0b
        && uint64_t(tm)*tn*4<=h.l0c && VectorBytes(tm,tn,E,capacity)<=h.ub;
}
inline bool StreamFits(const Hardware& h,uint32_t half,int tm,int tn,int pk,int E,
                       int slots=4,int capacity=8192) {
    const uint64_t packet=uint64_t(tm+tn)*pk;
    return packet<=half && uint64_t(half)+packet+4096<=h.l1
        && TileFits(h,tm,tn,E,slots,capacity);
}
inline bool ResidentFits(const Shape& s,const Hardware& h,int tm,int tn,bool fullB) {
    const uint64_t b=fullB?Up(s.N,32):2*tn;
    return (uint64_t(tm)+b)*Up(s.K,64)+512<=h.l1 && TileFits(h,tm,tn,s.E);
}
// Two resident A slots plus one complete-K B tile; the 64-row packing
// pipeline uses three UB slabs. Retain the previous conservative family
// eligibility with a 64-row reserve; its active copy tiles now use 16 rows.
// These sufficient capacity conditions do not enumerate K/N cases.
inline bool CanPackedWeightResident(const Shape& s,const Hardware& h) {
    return uint64_t(2*96+256)*Up(s.K,64)+512<=h.l1
        && 3ULL*64*Up(s.N,32)+512<=h.ub
        && TileFits(h,96,256,s.E)
        && 2ULL*32*Up(s.N,32)+512<=h.l1
        && 24576ULL<=h.l0a && 65536ULL<=h.l0b
        && 98304ULL<=h.l0c
        && 176128ULL+Up(s.E*8,32)<=h.ub;
}
inline bool ResidentEntryMatches(const Plan& p) {
    switch(p.residentSchedule) {
    case ResidentSchedule::FullB:
        return p.fullB && p.tm==128 && p.tn==256;
    case ResidentSchedule::ContinuousTasks:
        return !p.fullB && (p.tm==192 || p.tm==256) && p.tn==128;
    default:
        return !p.fullB && ((p.tm==64 && p.tn==128) ||
            (p.tm==96 && p.tn==192) || (p.tm==128 && p.tn==256) ||
            (p.tm==144 && p.tn==160));
    }
}
// Functional preconditions are separate from the preference thresholds in
// Select. The bounds use the largest legal int8 product, not input values.
inline bool CompletePackets(int k,int packet,int minimum) {
    return k>=minimum*packet && k%packet==0;
}
inline bool HalfAccumulatorFits(int k,int inverseScale) {
    // Fixpipe stores sum/inverseScale in half, then AIV restores the scale.
    // Avoid overflow before the user scale is applied; this does not remove
    // the original half-rounding precision limitation.
    return int64_t(128)*128*k<=int64_t(65504)*inverseScale;
}
inline bool CanOwnedWide(const Shape& s,const Hardware& h,uint32_t half) {
    return CompletePackets(s.K,256,2) && HalfAccumulatorFits(s.K,1024)
        && s.N>=64 && s.N%32==0
        && StreamFits(h,half,64,512,256,s.E,2,16384);
}
inline bool CanBucketPair(const Shape& s,const Hardware& h,uint32_t half) {
    return CompletePackets(s.K,512,2) && HalfAccumulatorFits(s.K,512)
        && s.N>=256 && s.N%256==0
        && StreamFits(h,half,128,256,512,s.E,4,16384);
}
inline bool CanBucketUnit(const Shape& s,const Hardware& h,uint32_t half) {
    return CompletePackets(s.K,512,2) && HalfAccumulatorFits(s.K,1024)
        && s.N>=256 && s.N%256==0
        && StreamFits(h,half,128,256,512,s.E,4,16384);
}
inline bool CanOwnedShort(const Shape& s,const Hardware& h) {
    // A/B are each one K<=256 panel, and this scheduler owns only one N tile.
    // N>=64 keeps the original 64-lane vector broadcast within each row.
    return s.K>=32 && s.K<=256 && s.K%32==0
        && s.N>=64 && s.N<=256 && s.N%32==0
        && 2ULL*(96+256)*256+512<=h.l1
        && 96*256<=h.l0a && 256*256<=h.l0b && 96*256*4<=h.l0c
        && VectorBytes(96,256,s.E)+8192*4+256<=h.ub;
}
inline Plan Select(const Shape& s,const Hardware& h) {
    Plan p;p.cores=h.aic;p.halfL1=uint32_t(h.l1/2/512*512);
    const int avg=DivUp(s.M,s.E),kp=Up(s.K,64),np=Up(s.N,32);
    if(int64_t(s.M)*s.K*s.N==1 && uint32_t(s.E)<=h.aiv && h.ub>=512) {
        p.family=Family::Unit;p.cores=uint32_t(s.E);return p;
    }
    if((s.M==1 && s.N==1) ||
       (s.M<=16 && s.N<=32 && s.K<=64 && int64_t(s.M)*s.K*s.N<=4096)) {
        int capacity=64;while(capacity<s.K)capacity*=2;
        if(uint64_t(capacity)*17+2048<=h.ub) {
            p.family=Family::SmallVector;p.cores=std::min(uint32_t(s.M),h.aiv);
            if(s.M<=16 && s.K<=4 && s.N<=8 && s.E<=8 && p.cores==uint32_t(s.M))
                p.family=Family::StagedTiny;
            return p;
        }
    }
    const int compactTasks=DivUp(s.M,16)*DivUp(s.N,128);
    if(s.E==1 && s.K<=256 && s.K%32==0 && s.N%32==0 && compactTasks<=int(h.aic)
       && h.l1>=144*256 && h.l0a>=16*256 && h.l0b>=128*256
       && h.l0c>=16*128*4 && h.ub>=(128+3*8*128)*4) {
        p.family=Family::Compact;p.tm=16;p.tn=128;p.cores=compactTasks;
        p.workspace=size_t(p.cores)*16*128*4;return p;
    }
    // Each path computes all runtime K terms. Preference cutoffs below
    // retain the original ownership/shape families; capability checks above
    // establish legal alignment, packet count, storage and numeric bounds.
    if(CanOwnedWide(s,h,p.halfL1) && s.E>=4 && s.N>=512
       && s.N%512==0 && avg<=96) {
        p.family=Family::OwnedWide;p.tm=64;p.tn=512;p.pk=256;
        p.cores=std::min(p.cores,16U);p.workspace=size_t(p.cores)*262144;
        return p;
    }
    if(CanBucketPair(s,h,p.halfL1) && s.E>=4 && s.N>=512
       && s.N%512==0 && avg>=64 && avg<=256) {
        p.family=Family::BucketPair;p.tm=128;p.tn=256;p.pk=512;
        p.workspace=size_t(p.cores)*262144;return p;
    }
    if(CanOwnedShort(s,h) && s.E>=64 && s.M>=32*s.E && s.M<=128*s.E) {
        p.family=Family::OwnedShort;p.tm=96;p.tn=256;p.pk=256;
        p.cores=std::min(p.cores,20U);p.workspace=size_t(p.cores)*196608;
        return p;
    }
    // Long reductions use unitFlag completion; shorter ones retain the
    // existing short/four-packet paths, so at least four K512 panels here.
    if(CanBucketUnit(s,h,p.halfL1) && s.K>=4*512 && s.N>=512
       && (avg>=96 || s.N%512!=0)) {
        p.family=Family::BucketUnit;p.tm=128;p.tn=256;p.pk=512;
        p.workspace=size_t(p.cores)*262144;return p;
    }
    p.workspace=size_t(p.cores)*524288;
    if(s.K<=256 && s.K%32==0 && s.N%32==0 && h.l1>=(64+256)*256
       && h.l0a>=64*256 && h.l0b>=256*256 && h.l0c>=64*256*4
       && VectorBytes(64,256,s.E)+8192*4<=h.ub) {
        p.family=Family::AlignedShort;p.tm=64;p.tn=256;
        // A complete K256 panel can pipeline independent output tasks. Require
        // at least two waves even when all rows belong to a single expert.
        // Four B slots and two A slots keep the next task's copy off the
        // current task's critical path; both vector C queues must also fit.
        const uint64_t shortL1=2ULL*64*256+4ULL*256*256+4096;
        const uint64_t shortUB=2ULL*Up((32*256+256)*4,1024)
            +8192*6+768+Up(s.E*8,32);
        p.crossTile=s.K/256==1 && s.N%256==0
            && int64_t(DivUp(s.M,64))*(s.N/256)>=2*h.aic
            && shortL1<=h.l1 && shortUB<=h.ub && TileFits(h,64,256,s.E);
        return p;
    }
    // Two or four complete K256 panels are the four-slot pipeline's capability.
    // Derive the maximum A tile from available L1, then account for UB/C storage.
    const int panels=s.K/256;
    if(s.K%256==0 && (panels==2 || panels==4) && s.N%256==0 && h.l1>4*256*256+4096) {
        int tm=int((h.l1-4*256*256-4096)/(2*s.K))/32*32;
        tm=std::min(tm,128);
        if(tm>=96)tm=tm>=128?128:96;
        if(tm>=96) {
        const uint64_t cbytes=Up(((tm+1)/2*256+256)*4+(tm*256>16384?256:0),1024);
        const uint64_t ub=2*cbytes+8192*6+768+1032*8+Up(s.E*8,32);
        const int64_t maxTasks=int64_t(DivUp(s.M,tm)+s.E)*(s.N/256);
        if(tm>=96 && avg<=tm && TileFits(h,tm,256,s.E) && ub<=h.ub
           && DivUp(s.M,tm)*(s.N/256)>=2*int(h.aic)
           && (maxTasks+h.aic-1)/h.aic<=1024) {
            p.family=Family::FourPacket;p.tm=tm;p.tn=256;p.pk=256;
            p.workspace=size_t(p.cores)*(2*tm*256*4+1032*8);return p;
        }
        }
    }
    if(s.K>=4*256 && s.K%256==0 && s.N%512==0 && avg<=64
       && int64_t(DivUp(avg,64))*s.E*(s.N/512)>=h.aic
       && StreamFits(h,p.halfL1,64,512,256,s.E,2,16384)) {
        p.family=Family::AlignedWide;p.tm=64;p.tn=512;p.pk=256;return p;
    }
    if(s.K>=2*512 && s.K%512==0 && s.N%256==0 && StreamFits(h,p.halfL1,128,256,512,s.E,4,16384)) {
        p.family=Family::AlignedDeep;p.tm=128;p.tn=256;p.pk=512;
        // Two-panel prefetch needs a second task to hide its setup cost.
        // This is a lower bound on tasks for every legal group_list.
        p.crossTile=s.K/512>=3 || int64_t(DivUp(s.M,128))*(s.N/256)>h.aic;
        return p;
    }
    const bool packFits=StreamFits(h,p.halfL1,128,256,512,s.E);

    const bool fullWeightFits=ResidentFits(s,h,128,256,true);
    // At least two full M tiles per expert are needed to amortize a complete
    // weight layout conversion. Full-B residency avoids that conversion first.
    if(!fullWeightFits && (s.K%64 || s.N%32) && avg>=2*128
       && uint64_t(128+2*128)*kp+512<=h.l1 && packFits) {
        // This family already has enough rows to amortize weight preparation.
        // NZ weights can then stay in L1 while consecutive M tiles reuse them.
        if(CanPackedWeightResident(s,h)) {
            p.family=Family::PackedWeightResident;p.tm=96;p.tn=256;p.copyRows=16;
            // Sum(ceil(groupRows/96)) >= ceil(M/96). Four tasks per core
            // guarantee at least two turns of a two-slot queue, even for a
            // maximally concentrated group_list. This is a performance
            // preference; the original one-slot kernel remains the fallback.
            p.doubleInput=int64_t(DivUp(s.M,96))*DivUp(s.N,256)>=int64_t(p.cores)*4
                && VectorBytes(96,256,s.E)+51200<=h.ub;
            p.workspace=size_t(p.cores)*196608+size_t(s.E)*kp*np;
            return p;
        }
        p.family=Family::PackedWeight;p.tm=128;p.tn=256;
        p.copyRows=uint64_t(3)*16*np<=h.ub?16:8;
        p.workspace=size_t(p.cores)*262144+size_t(s.E)*kp*np;return p;
    }
    struct Tile {int m,n;bool full;ResidentSchedule schedule;};
    const Tile tiles[]={
        {64,128,false,ResidentSchedule::DoubleB},
        {96,192,false,ResidentSchedule::DoubleB},
        {128,256,false,ResidentSchedule::DoubleB},
        {192,128,false,ResidentSchedule::ContinuousTasks},
        {256,128,false,ResidentSchedule::ContinuousTasks},
        {128,256,true,ResidentSchedule::FullB}};
    double best=1.0e300;
    for(const Tile& t:tiles) {
        if(!ResidentFits(s,h,t.m,t.n,t.full))continue;
        const int mt=DivUp(avg,t.m),nt=DivUp(s.N,t.n);
        if(t.full && (nt<2 || avg<t.m))continue;
        const int rows=Up(DivUp(avg,mt),16),cols=Up(DivUp(s.N,nt),32);
        const int64_t tasks=int64_t(s.E)*mt*nt;
        const int64_t aLoads=std::min(tasks,int64_t(s.E)*mt+h.aic-1);
        const int64_t bLoads=t.full?std::min(tasks,int64_t(s.E)+h.aic-1):tasks;
        const double bytes=double(aLoads)*rows*kp+double(bLoads)*(t.full?np:cols)*kp;
        const double waves=double((tasks+h.aic-1)/h.aic);
        // Approximate per-wave compute, copy, and descriptor costs. No measured
        // testcase identity, latency table, or tensor contents enter this model.
        const double matrix=double(rows)*cols*kp/4096;
        const double transport=bytes/double(tasks)/32;
        const double score=waves*(std::max(matrix,transport)+64);
        if(score<best) {
            best=score;p.family=Family::Resident;p.tm=t.m;p.tn=t.n;p.fullB=t.full;
            // Keep the tile's declared mechanism when carrying its parameters.
            p.residentSchedule=t.schedule;
            p.workspace=size_t(p.cores)*2*t.m*t.n*4;
        }
    }
    if(p.family==Family::Resident) {
        // Narrower B slots leave room for a larger A tile. Equal N partition
        // counts preserve the existing balanced column boundaries. This is
        // a measured parameter choice within the same resident mechanism;
        // task ownership policy, buffer depths, prefetch order and arithmetic
        // are kept.
        if(p.residentSchedule==ResidentSchedule::DoubleB
            && p.tm==96 && p.tn==192
            && DivUp(s.N,160)==DivUp(s.N,192)
            && ResidentFits(s,h,144,160,false)) {
            p.tm=144;p.tn=160;p.workspace=size_t(p.cores)*2*144*160*4;
        }
        if(p.tm==144 && (s.K%64 || s.N%32) && avg<=96
           && ResidentFits(s,h,192,128,false) && 2ULL*64*np+512<=h.l1) {
            p.tm=192;p.tn=128;p.workspace=size_t(p.cores)*2*192*128*4;
            p.residentSchedule=ResidentSchedule::ContinuousTasks;
        }
        return p;
    }
    if((s.K%64 || s.N%32) && packFits
       && StreamFits(h,p.halfL1,96,192,896,s.E)
       && StreamFits(h,p.halfL1,128,192,768,s.E)) {
        if(avg>=2*128 && s.K>=2*512 && s.N>=64) {
            p.family=Family::PackedWeight;p.tm=128;p.tn=256;p.copyRows=8;
            p.workspace=size_t(p.cores)*262144+size_t(s.E)*kp*np;
            p.packX=PreferPackedX(s,h);
            if(p.packX)p.workspace+=size_t(Up(s.M,16))*kp;
            return p;
        }
        p.family=Family::PackedBoth;p.copyRows=uint64_t(3)*std::max(16384,16*np)<=h.ub?16:8;
        p.workspace=size_t(p.cores)*262144+size_t(Up(s.M,16))*kp+size_t(s.E)*kp*np;return p;
    }
    if(packFits) {p.family=Family::Streaming;p.tm=128;p.tn=256;return p;}
    return p;
}
}

namespace gmm_host {
static gmm_plan::Shape Validate(const TensorGroupInfo& ix,const TensorGroupInfo& iw,
    const TensorGroupInfo& is,const TensorGroupInfo& ig,const TensorGroupInfo& iy) {
    if(ix.numTensors!=1 || iw.numTensors!=1 || is.numTensors!=1
       || ig.numTensors!=1 || iy.numTensors!=1
       || !ix.tensors || !iw.tensors || !is.tensors || !ig.tensors || !iy.tensors)
        throw std::runtime_error("GroupedMatmulGelu: exactly one tensor per argument required");
    const auto& xs=ix.tensors[0].shape;const auto& ws=iw.tensors[0].shape;
    const auto& ss=is.tensors[0].shape;const auto& gs=ig.tensors[0].shape;
    const auto& ys=iy.tensors[0].shape;
    if(ix.tensors[0].numDims!=2 || iw.tensors[0].numDims!=3
       || is.tensors[0].numDims!=2 || ig.tensors[0].numDims!=1 || iy.tensors[0].numDims!=2
       || !xs || !ws || !ss || !gs || !ys)
        throw std::runtime_error("GroupedMatmulGelu: invalid tensor rank");
    // Dtype codes are the public TensorInfo metadata contract.
    if(ix.tensors[0].dtype!=3 || iw.tensors[0].dtype!=3 || is.tensors[0].dtype!=0
       || ig.tensors[0].dtype!=6 || iy.tensors[0].dtype!=1)
        throw std::runtime_error("GroupedMatmulGelu: incompatible tensor dtype");
    if(xs[0]<1 || xs[0]>65536 || xs[1]<1 || xs[1]>8192 || ws[0]<1 || ws[0]>128
       || ws[2]<1 || ws[2]>4096)
        throw std::runtime_error("GroupedMatmulGelu: dimensions out of range");
    const int M=int(xs[0]),K=int(xs[1]),N=int(ws[2]),E=int(ws[0]);
    if(ws[1]!=K || ss[0]!=E || ss[1]!=N || gs[0]!=E || ys[0]!=M || ys[1]!=N)
        throw std::runtime_error("GroupedMatmulGelu: incompatible shapes");
    const uint64_t weightBytes=uint64_t(E)*K*N;
    const uint64_t totalBytes=uint64_t(M)*K+weightBytes+uint64_t(E)*N*4+uint64_t(E)*8+uint64_t(M)*N*2;
    if(weightBytes>256ULL*1024*1024 || totalBytes>512ULL*1024*1024)
        throw std::runtime_error("GroupedMatmulGelu: tensor storage exceeds supported range");
    return {M,K,N,E};
}
static gmm_plan::Hardware Hardware(int64_t available) {
    auto* platform=platform_ascendc::PlatformAscendCManager::GetInstance();
    if(!platform)throw std::runtime_error("GroupedMatmulGelu: platform unavailable");
    gmm_plan::Hardware h{};
    h.aic=platform->GetCoreNumAic();h.aiv=platform->GetCoreNumAiv();
    if(available>0 && uint64_t(available)<h.aic)h.aic=uint32_t(available);
    h.aiv=std::min(h.aiv,2*h.aic);
    if(!h.aic || !h.aiv)throw std::runtime_error("GroupedMatmulGelu: no usable core");
    platform->GetCoreMemSize(platform_ascendc::CoreMemType::L1,h.l1);
    platform->GetCoreMemSize(platform_ascendc::CoreMemType::L0_A,h.l0a);
    platform->GetCoreMemSize(platform_ascendc::CoreMemType::L0_B,h.l0b);
    platform->GetCoreMemSize(platform_ascendc::CoreMemType::L0_C,h.l0c);
    platform->GetCoreMemSize(platform_ascendc::CoreMemType::UB,h.ub);
    platform->GetCoreMemSize(platform_ascendc::CoreMemType::L2,h.l2);
    if(!h.l1 || !h.l0a || !h.l0b || !h.l0c || !h.ub)
        throw std::runtime_error("GroupedMatmulGelu: invalid core memory capacities");
    return h;
}
static AscendC::tiling::TCubeTiling SdkTiling(const gmm_plan::Shape& s,
                                           const gmm_plan::Hardware& h) {
    auto* platform=platform_ascendc::PlatformAscendCManager::GetInstance();
    matmul_tiling::MatmulApiTiling api(*platform);
    api.SetAType(matmul_tiling::TPosition::GM,matmul_tiling::CubeFormat::ND,matmul_tiling::DataType::DT_INT8);
    api.SetBType(matmul_tiling::TPosition::GM,matmul_tiling::CubeFormat::ND,matmul_tiling::DataType::DT_INT8);
    api.SetCType(matmul_tiling::TPosition::GM,matmul_tiling::CubeFormat::ND,matmul_tiling::DataType::DT_INT32);
    const int tm=64,tn=std::min(256,gmm_plan::Up(s.N,32));
    api.SetShape(tm,tn,s.K);api.SetOrgShape(s.M,s.N,s.K);
    api.SetFixSplit(tm,tn);api.SetBufferSpace(-1,-1,0);
    AscendC::tiling::TCubeTiling t{};
    if(api.GetTiling(t)!=0)throw std::runtime_error("GroupedMatmulGelu: matmul tiling failed");
    const uint64_t tile=uint64_t(t.baseM)*t.baseN;
    const uint64_t ve=(tile<=16384?8192:6144)/t.baseN*t.baseN;
    if(tile*4+4*t.baseN+ve*10+512+gmm_plan::Up(s.E*8,32)>h.ub)
        throw std::runtime_error("GroupedMatmulGelu: insufficient UB for fallback");
    t.usedCoreNum=h.aic;return t;
}
}

static void LaunchActiveResident(uint32_t cores,aclrtStream stream,GMM_ARGUMENTS,bool widePipeline);

static void LaunchActivePacked(bool both,bool buffered,uint32_t cores,aclrtStream stream,GMM_ARGUMENTS,uint32_t halfL1);


static bool CanPreparedFullB(const gmm_plan::Shape& s,const gmm_plan::Hardware& h,
                             const gmm_plan::Plan& p) {
    if(p.family!=gmm_plan::Family::Resident || !p.fullB || s.K<=64)return false;
    const uint64_t kp=gmm_plan::Up(s.K,64),np=gmm_plan::Up(s.N,32);
    return (2ULL*96+np)*kp+512<=h.l1 && 2ULL*64*np+512<=h.l1
        && gmm_plan::TileFits(h,96,256,s.E,4)
        && gmm_plan::TileFits(h,80,256,s.E,4,10240);
}
static void LaunchPreparedFullB(uint32_t,aclrtStream,GMM_ARGUMENTS);

namespace OuterProductDevice {
using namespace AscendC;

template<int Rows>
__global__ __aicore__ __vector__ void Outer(
    GM_ADDR x,GM_ADDR w,GM_ADDR sc,GM_ADDR groups,GM_ADDR y,int M,int N,int E) {
    constexpr int C=4096;
    const int beginOwned=M*int(GetBlockIdx())/int(GetBlockNum());
    const int endOwned=M*(int(GetBlockIdx())+1)/int(GetBlockNum());
    const int xCount=endOwned-beginOwned;
    TPipe pipe;
    TBuf<TPosition::VECCALC> gb,xb,wb,hb,fb,sb,zb,pb;
    TQue<TPosition::VECOUT,2> outQueue;
    pipe.InitBuffer(gb,(E*8+31)/32*32);pipe.InitBuffer(xb,(xCount+31)/32*32+32);
    pipe.InitBuffer(wb,C);pipe.InitBuffer(hb,C*2);pipe.InitBuffer(fb,C*4);pipe.InitBuffer(sb,C*4);
    pipe.InitBuffer(zb,Rows*C*4);pipe.InitBuffer(pb,Rows*C*4+256);pipe.InitBuffer(outQueue,2,Rows*C*2);
    GlobalTensor<int8_t> gx,gw;GlobalTensor<float> gs;GlobalTensor<int64_t> gg;GlobalTensor<half> gy;
    gx.SetGlobalBuffer((__gm__ int8_t*)x);gw.SetGlobalBuffer((__gm__ int8_t*)w);
    gs.SetGlobalBuffer((__gm__ float*)sc);gg.SetGlobalBuffer((__gm__ int64_t*)groups);gy.SetGlobalBuffer((__gm__ half*)y);
    auto g=gb.Get<int64_t>();auto xx=xb.Get<int8_t>();auto ww=wb.Get<int8_t>();auto h=hb.Get<half>();
    auto wf=fb.Get<float>();auto ss=sb.Get<float>();auto z=zb.Get<float>();auto p=pb.Get<float>()[64];
    DataCopyPad(g,gg,{1,uint32_t(E*8),0,0,0},{true,0,0,int64_t(0)});
    if(xCount)DataCopyPad(xx,gx[beginOwned],{1,uint32_t(xCount),0,0,0},{true,0,0,int8_t(0)});
    auto m2s=pipe.FetchEventID<HardEvent::MTE2_S>();SetFlag<HardEvent::MTE2_S>(m2s);WaitFlag<HardEvent::MTE2_S>(m2s);
    int start=0;
    for(int e=0;e<E;++e) {
        const int end=int(g.GetValue(e)),lo=start>beginOwned?start:beginOwned,hi=end<endOwned?end:endOwned;
        start=end;if(lo>=hi)continue;
        PipeBarrier<PIPE_ALL>();Duplicate(wf,0.0f,C);Duplicate(ss,0.0f,C);
        auto v2m=pipe.FetchEventID<HardEvent::V_MTE2>();SetFlag<HardEvent::V_MTE2>(v2m);WaitFlag<HardEvent::V_MTE2>(v2m);
        DataCopyPad(ww,gw[int64_t(e)*N],{1,uint32_t(N),0,0,0},{true,0,0,int8_t(0)});
        DataCopyPad(ss,gs[int64_t(e)*N],{1,uint32_t(N*4),0,0,0},{true,0,0,0.0f});
        auto m2v=pipe.FetchEventID<HardEvent::MTE2_V>();SetFlag<HardEvent::MTE2_V>(m2v);WaitFlag<HardEvent::MTE2_V>(m2v);
        Cast(h,ww,RoundMode::CAST_NONE,N);PipeBarrier<PIPE_V>();Cast(wf,h,RoundMode::CAST_NONE,N);PipeBarrier<PIPE_V>();
        for(int row=lo;row<hi;row+=Rows) {
            const int rows=hi-row<Rows?hi-row:Rows;
            auto out=outQueue.AllocTensor<half>();
            for(int r=0;r<rows;++r)Muls(z[r*C],wf,float(xx.GetValue(row+r-beginOwned)),C);
            PipeBarrier<PIPE_V>();
            for(int r=0;r<rows;++r)Mul(z[r*C],z[r*C],ss,C);
            PipeBarrier<PIPE_V>();gmm_device::GeluTanh(z,p,p,p,rows*C);
            Cast(out,z,RoundMode::CAST_RINT,rows*C);
            outQueue.EnQue(out);out=outQueue.DeQue<half>();
            DataCopyPad(gy[int64_t(row)*N],out,{uint16_t(rows),uint32_t(N*2),uint32_t((C*2-(N*2+31)/32*32)/32),0,0});
            outQueue.FreeTensor(out);
        }
    }
    PipeBarrier<PIPE_ALL>();
}


}

namespace Int8OuterLookup {
using namespace AscendC;

// Every INT8 value is evaluated from the live weights and scales. No input
// values or expert sizes are assumed. The following phase of this same kernel
// gathers the rows after the cross-core barrier.
template<int Rows>
__aicore__ inline void Build(GM_ADDR w,GM_ADDR sc,GM_ADDR groups,GM_ADDR table,int N,int E) {
    constexpr int C=4096,Tiles=(256+Rows-1)/Rows;
    TPipe pipe;TBuf<TPosition::VECCALC> gb,wb,hb,fb,sb,zb,pb;
    TQue<TPosition::VECOUT,2> oq;
    pipe.InitBuffer(gb,(E*8+31)/32*32);pipe.InitBuffer(wb,C);pipe.InitBuffer(hb,C*2);
    pipe.InitBuffer(fb,C*4);pipe.InitBuffer(sb,C*4);pipe.InitBuffer(zb,Rows*C*4);
    pipe.InitBuffer(pb,Rows*C*4+256);pipe.InitBuffer(oq,2,Rows*C*2);
    GlobalTensor<int8_t> gw;GlobalTensor<float> gs;GlobalTensor<int64_t> gg;GlobalTensor<half> gt;
    gw.SetGlobalBuffer((__gm__ int8_t*)w);gs.SetGlobalBuffer((__gm__ float*)sc);
    gg.SetGlobalBuffer((__gm__ int64_t*)groups);gt.SetGlobalBuffer((__gm__ half*)table);
    auto g=gb.Get<int64_t>();auto ww=wb.Get<int8_t>();auto h=hb.Get<half>();
    auto wf=fb.Get<float>();auto ss=sb.Get<float>();auto z=zb.Get<float>();auto p=pb.Get<float>()[64];
    DataCopyPad(g,gg,{1,uint32_t(E*8),0,0,0},{true,0,0,int64_t(0)});
    auto m2s=pipe.FetchEventID<HardEvent::MTE2_S>();SetFlag<HardEvent::MTE2_S>(m2s);WaitFlag<HardEvent::MTE2_S>(m2s);
    int expertMap[128],active=0,previous=0;
    for(int e=0;e<E;++e){const int last=int(g.GetValue(e));if(last>previous)expertMap[active++]=e;previous=last;}
    const int first=active*Tiles*int(GetBlockIdx())/(2*int(GetBlockNum()));
    const int limit=active*Tiles*(int(GetBlockIdx())+1)/(2*int(GetBlockNum()));
    int cached=-1;
    for(int task=first;task<limit;++task) {
        const int e=expertMap[task/Tiles],v=(task%Tiles)*Rows,rows=256-v<Rows?256-v:Rows;
        if(g.GetValue(e)==(e?g.GetValue(e-1):0))continue;
        if(cached!=e) {
            PipeBarrier<PIPE_ALL>();Duplicate(wf,0.0f,C);Duplicate(ss,0.0f,C);
            auto v2m=pipe.FetchEventID<HardEvent::V_MTE2>();SetFlag<HardEvent::V_MTE2>(v2m);WaitFlag<HardEvent::V_MTE2>(v2m);
            DataCopyPad(ww,gw[int64_t(e)*N],{1,uint32_t(N),0,0,0},{true,0,0,int8_t(0)});
            DataCopyPad(ss,gs[int64_t(e)*N],{1,uint32_t(N*4),0,0,0},{true,0,0,0.0f});
            auto m2v=pipe.FetchEventID<HardEvent::MTE2_V>();SetFlag<HardEvent::MTE2_V>(m2v);WaitFlag<HardEvent::MTE2_V>(m2v);
            Cast(h,ww,RoundMode::CAST_NONE,N);PipeBarrier<PIPE_V>();Cast(wf,h,RoundMode::CAST_NONE,N);PipeBarrier<PIPE_V>();
            cached=e;
        }
        auto out=oq.AllocTensor<half>();
        for(int r=0;r<rows;++r)Muls(z[r*C],wf,float(v+r-128),C);
        PipeBarrier<PIPE_V>();
        for(int r=0;r<rows;++r)Mul(z[r*C],z[r*C],ss,C);
        PipeBarrier<PIPE_V>();gmm_device::GeluTanh(z,p,p,p,rows*C);
        Cast(out,z,RoundMode::CAST_RINT,rows*C);oq.EnQue(out);out=oq.DeQue<half>();
        DataCopy(gt[(int64_t(e)*256+v)*C],out,rows*C);oq.FreeTensor(out);
    }
    PipeBarrier<PIPE_ALL>();
}

template<int Rows>
__aicore__ inline void Gather(GM_ADDR x,GM_ADDR groups,GM_ADDR table,GM_ADDR y,int M,int N,int E) {
    constexpr int C=4096;
    const int first=M*int(GetBlockIdx())/(2*int(GetBlockNum())),limit=M*(int(GetBlockIdx())+1)/(2*int(GetBlockNum()));
    TPipe pipe;TBuf<TPosition::VECCALC> gb,xb,data[2];
    pipe.InitBuffer(gb,(E*8+31)/32*32);pipe.InitBuffer(xb,(limit-first+31)/32*32+32);
    uint8_t free[2],ready[2];bool used[2]={};
    for(int s=0;s<2;++s){pipe.InitBuffer(data[s],Rows*C*2);free[s]=pipe.AllocEventID<HardEvent::MTE3_MTE2>();ready[s]=pipe.AllocEventID<HardEvent::MTE2_MTE3>();}
    GlobalTensor<int8_t> gx;GlobalTensor<int64_t> gg;GlobalTensor<half> gt,gy;
    gx.SetGlobalBuffer((__gm__ int8_t*)x);gg.SetGlobalBuffer((__gm__ int64_t*)groups);
    gt.SetGlobalBuffer((__gm__ half*)table);gy.SetGlobalBuffer((__gm__ half*)y);
    auto xx=xb.Get<int8_t>();auto g=gb.Get<int64_t>();
    DataCopyPad(g,gg,{1,uint32_t(E*8),0,0,0},{true,0,0,int64_t(0)});
    if(limit>first)DataCopyPad(xx,gx[first],{1,uint32_t(limit-first),0,0,0},{true,0,0,int8_t(0)});
    auto m2s=pipe.FetchEventID<HardEvent::MTE2_S>();SetFlag<HardEvent::MTE2_S>(m2s);WaitFlag<HardEvent::MTE2_S>(m2s);
    int start=0,batch=0;
    for(int e=0;e<E;++e) {
        const int end=int(g.GetValue(e)),lo=start>first?start:first,hi=end<limit?end:limit;
        start=end;
        for(int row=lo;row<hi;row+=Rows,++batch) {
            const int slot=batch&1,rows=hi-row<Rows?hi-row:Rows;
            if(used[slot])WaitFlag<HardEvent::MTE3_MTE2>(free[slot]);
            auto buf=data[slot].Get<half>();
            for(int r=0;r<rows;++r)DataCopy(buf[r*C],gt[(int64_t(e)*256+int(xx.GetValue(row+r-first))+128)*C],C);
            SetFlag<HardEvent::MTE2_MTE3>(ready[slot]);WaitFlag<HardEvent::MTE2_MTE3>(ready[slot]);
            DataCopyPad(gy[int64_t(row)*N],buf,{uint16_t(rows),uint32_t(N*2),uint32_t((C*2-(N*2+31)/32*32)/32),0,0});
            SetFlag<HardEvent::MTE3_MTE2>(free[slot]);used[slot]=true;
        }
    }
    for(int s=0;s<2;++s){if(used[s])WaitFlag<HardEvent::MTE3_MTE2>(free[s]);pipe.ReleaseEventID<HardEvent::MTE3_MTE2>(free[s]);pipe.ReleaseEventID<HardEvent::MTE2_MTE3>(ready[s]);}
    PipeBarrier<PIPE_ALL>();
}
}

namespace Int8OuterLookup {
template<int GatherRows>
__global__ __mix__(1,2) void Fused(GM_ADDR x,GM_ADDR w,GM_ADDR sc,GM_ADDR groups,GM_ADDR y,GM_ADDR table,int M,int N,int E) {
    if ASCEND_IS_AIV {Build<3>(w,sc,groups,table,N,E);}
    AscendC::SyncAll<false>();
    if ASCEND_IS_AIV {Gather<GatherRows>(x,groups,table,y,M,N,E);}
}
}

static void LaunchDotProduct(uint32_t cores,aclrtStream stream,GM_ADDR x,GM_ADDR w,GM_ADDR sc,GM_ADDR groups,GM_ADDR y,GM_ADDR workspace,int M,int K,int N,int E);
static void LaunchGroupedPacked(uint32_t,aclrtStream,GM_ADDR,GM_ADDR,GM_ADDR,GM_ADDR,GM_ADDR,GM_ADDR,int,int,int,int,uint32_t,bool,bool);
extern "C" void run_kernel(GM_ADDR x,const TensorGroupInfo& info_x,
    GM_ADDR w,const TensorGroupInfo& info_weight,GM_ADDR sc,const TensorGroupInfo& info_scale,
    GM_ADDR groups,const TensorGroupInfo& info_groups,GM_ADDR y,const TensorGroupInfo& info_y,
    int64_t availableCoreNum,aclrtStream stream) {
    using gmm_plan::Family;
    const auto shape=gmm_host::Validate(info_x,info_weight,info_scale,info_groups,info_y);
    const auto hardware=gmm_host::Hardware(availableCoreNum);
    // N=1 uses the same dot-product mechanism for any reduction length whose
    // padded resident A/B panels fit. Padding is produced on Device every call.
    const int narrowK=gmm_plan::Up(shape.K,1024);
    const int dotMaxRows=gmm_plan::DivUp(gmm_plan::DivUp(shape.M,32)+shape.E,hardware.aic)*32;
    const uint64_t dotUbBytes=(32*16+16)*4+64*4+32*4
        +gmm_plan::Up(shape.E*8,32)+uint64_t(dotMaxRows+32)*2
        +gmm_plan::Up(shape.E*4,32)+512;
    if(shape.N==1 && shape.K>=256 && shape.M>=4*32
       && uint64_t(2*32+16)*narrowK+512<=hardware.l1
       && 2ULL*32*1024<=hardware.l0a && 2ULL*16*1024<=hardware.l0b
       && 2ULL*32*16*4<=hardware.l0c
       && dotUbBytes<=hardware.ub) {
        void* buffer=nullptr;
        const size_t bytes=size_t(hardware.aic)*2*32*16*4+size_t(shape.E)*narrowK*16;
        if(aclrtMalloc(&buffer,bytes+511,ACL_MEM_MALLOC_HUGE_FIRST)!=ACL_SUCCESS)throw std::runtime_error("Narrow packed workspace");
        GM_ADDR ws=reinterpret_cast<GM_ADDR>((reinterpret_cast<uintptr_t>(buffer)+511)&~uintptr_t(511));
        // The workspace stays alive until this invocation's single kernel
        // has finished. aclrtFree itself does not synchronize the stream.
        LaunchDotProduct(hardware.aic,stream,x,w,sc,groups,y,ws,shape.M,shape.K,shape.N,shape.E);
        const aclError status=aclrtSynchronizeStream(stream);
        const aclError freeStatus=aclrtFree(buffer);
        if(status!=ACL_SUCCESS)throw std::runtime_error("Narrow packed kernel execution failed");
        if(freeStatus!=ACL_SUCCESS)throw std::runtime_error("Narrow packed workspace release failed");
        return;
    }

    // Enumerating the entire INT8 domain costs 256 rows per expert; require
    // at least two uses per domain entry to amortize it. No live values or
    // group sizes are read by this Host decision.
    if(shape.K==1 && shape.N>=2048 && shape.M>=2*256*shape.E && hardware.ub>=192768ULL+gmm_plan::Up(shape.E*8,32)+512) {
        void* table=nullptr;
        if(aclrtMalloc(&table,size_t(shape.E)*256*4096*2,ACL_MEM_MALLOC_HUGE_FIRST)!=ACL_SUCCESS)throw std::runtime_error("Outer fused workspace");
        GM_ADDR lut=reinterpret_cast<GM_ADDR>(reinterpret_cast<uintptr_t>(table));
        Int8OuterLookup::Fused<4><<<hardware.aic,nullptr,stream>>>(x,w,sc,groups,y,lut,shape.M,shape.N,shape.E);
        const aclError status=aclrtSynchronizeStream(stream);
        aclrtFree(table);
        if(status!=ACL_SUCCESS)throw std::runtime_error("Outer fused execution failed");
        return;
    }
    const int owned=(shape.M+hardware.aiv-1)/hardware.aiv;
    if(shape.K==1 && shape.N>=2048 && shape.M>=128 && hardware.ub>=3ULL*4096*12+4096*11+2048+owned) {
        OuterProductDevice::Outer<3><<<hardware.aiv,nullptr,stream>>>(x,w,sc,groups,y,shape.M,shape.N,shape.E);return;
    }
    const auto plan=gmm_plan::Select(shape,hardware);
    const int M=shape.M,K=shape.K,N=shape.N,E=shape.E;
    const uint32_t cores=plan.cores;
    if(plan.family==Family::Unit) {
        gmm_device::UnitReduction<<<cores,nullptr,stream>>>(x,w,sc,groups,y,E);
        return;
    }
    if(plan.family==Family::StagedTiny) {
        switch(K) {
        case 1: switch(N) {
        case 1:gmm_imported::TinyStagedKernel<1,1><<<cores,nullptr,stream>>>(x,w,sc,groups,y,M,K,N,E);break;
        case 2:gmm_imported::TinyStagedKernel<1,2><<<cores,nullptr,stream>>>(x,w,sc,groups,y,M,K,N,E);break;
        case 3:gmm_imported::TinyStagedKernel<1,3><<<cores,nullptr,stream>>>(x,w,sc,groups,y,M,K,N,E);break;
        case 4:gmm_imported::TinyStagedKernel<1,4><<<cores,nullptr,stream>>>(x,w,sc,groups,y,M,K,N,E);break;
        case 5:gmm_imported::TinyStagedKernel<1,5><<<cores,nullptr,stream>>>(x,w,sc,groups,y,M,K,N,E);break;
        case 6:gmm_imported::TinyStagedKernel<1,6><<<cores,nullptr,stream>>>(x,w,sc,groups,y,M,K,N,E);break;
        case 7:gmm_imported::TinyStagedKernel<1,7><<<cores,nullptr,stream>>>(x,w,sc,groups,y,M,K,N,E);break;
        case 8:gmm_imported::TinyStagedKernel<1,8><<<cores,nullptr,stream>>>(x,w,sc,groups,y,M,K,N,E);break;
        }break;
        case 2: switch(N) {
        case 1:gmm_imported::TinyStagedKernel<2,1><<<cores,nullptr,stream>>>(x,w,sc,groups,y,M,K,N,E);break;
        case 2:gmm_imported::TinyStagedKernel<2,2><<<cores,nullptr,stream>>>(x,w,sc,groups,y,M,K,N,E);break;
        case 3:gmm_imported::TinyStagedKernel<2,3><<<cores,nullptr,stream>>>(x,w,sc,groups,y,M,K,N,E);break;
        case 4:gmm_imported::TinyStagedKernel<2,4><<<cores,nullptr,stream>>>(x,w,sc,groups,y,M,K,N,E);break;
        case 5:gmm_imported::TinyStagedKernel<2,5><<<cores,nullptr,stream>>>(x,w,sc,groups,y,M,K,N,E);break;
        case 6:gmm_imported::TinyStagedKernel<2,6><<<cores,nullptr,stream>>>(x,w,sc,groups,y,M,K,N,E);break;
        case 7:gmm_imported::TinyStagedKernel<2,7><<<cores,nullptr,stream>>>(x,w,sc,groups,y,M,K,N,E);break;
        case 8:gmm_imported::TinyStagedKernel<2,8><<<cores,nullptr,stream>>>(x,w,sc,groups,y,M,K,N,E);break;
        }break;
        case 3: switch(N) {
        case 1:gmm_imported::TinyStagedKernel<3,1><<<cores,nullptr,stream>>>(x,w,sc,groups,y,M,K,N,E);break;
        case 2:gmm_imported::TinyStagedKernel<3,2><<<cores,nullptr,stream>>>(x,w,sc,groups,y,M,K,N,E);break;
        case 3:gmm_imported::TinyStagedKernel<3,3><<<cores,nullptr,stream>>>(x,w,sc,groups,y,M,K,N,E);break;
        case 4:gmm_imported::TinyStagedKernel<3,4><<<cores,nullptr,stream>>>(x,w,sc,groups,y,M,K,N,E);break;
        case 5:gmm_imported::TinyStagedKernel<3,5><<<cores,nullptr,stream>>>(x,w,sc,groups,y,M,K,N,E);break;
        case 6:gmm_imported::TinyStagedKernel<3,6><<<cores,nullptr,stream>>>(x,w,sc,groups,y,M,K,N,E);break;
        case 7:gmm_imported::TinyStagedKernel<3,7><<<cores,nullptr,stream>>>(x,w,sc,groups,y,M,K,N,E);break;
        case 8:gmm_imported::TinyStagedKernel<3,8><<<cores,nullptr,stream>>>(x,w,sc,groups,y,M,K,N,E);break;
        }break;
        case 4: switch(N) {
        case 1:gmm_imported::TinyStagedKernel<4,1><<<cores,nullptr,stream>>>(x,w,sc,groups,y,M,K,N,E);break;
        case 2:gmm_imported::TinyStagedKernel<4,2><<<cores,nullptr,stream>>>(x,w,sc,groups,y,M,K,N,E);break;
        case 3:gmm_imported::TinyStagedKernel<4,3><<<cores,nullptr,stream>>>(x,w,sc,groups,y,M,K,N,E);break;
        case 4:gmm_imported::TinyStagedKernel<4,4><<<cores,nullptr,stream>>>(x,w,sc,groups,y,M,K,N,E);break;
        case 5:gmm_imported::TinyStagedKernel<4,5><<<cores,nullptr,stream>>>(x,w,sc,groups,y,M,K,N,E);break;
        case 6:gmm_imported::TinyStagedKernel<4,6><<<cores,nullptr,stream>>>(x,w,sc,groups,y,M,K,N,E);break;
        case 7:gmm_imported::TinyStagedKernel<4,7><<<cores,nullptr,stream>>>(x,w,sc,groups,y,M,K,N,E);break;
        case 8:gmm_imported::TinyStagedKernel<4,8><<<cores,nullptr,stream>>>(x,w,sc,groups,y,M,K,N,E);break;
        }break;
        }return;
    }
    if(plan.family==Family::SmallVector) {
        if(K<=4 && N<=8)
            gmm_device::TinyDispatch<<<cores,nullptr,stream>>>(x,w,sc,groups,y,M,K,N,E);
        else {
            int capacity=64;while(capacity<K)capacity*=2;
            gmm_device::SmallVector<<<cores,nullptr,stream>>>(x,w,sc,groups,y,M,K,N,E,capacity);
        }
        return;
    }
    // Per-invocation scratch: no prepared-input or output cache survives calls.
    // The packed preparation and the resident computation use L1 sequentially.
    const bool useActiveResident=plan.family==Family::Resident && plan.tm==192 && plan.tn==128 && !plan.fullB
        && 2ULL*64*gmm_plan::Up(N,32)+512<=hardware.l1;
    // Wide resident workloads with sufficiently populated experts amortize
    // the extra 96/128-row tasks across their N tiles.
    const bool useWideResident=useActiveResident && gmm_plan::DivUp(N,128)>=8 && int64_t(M)>=int64_t(E)*128
        && 4ULL*128*128<=hardware.l0a && 4ULL*128*128<=hardware.l0b
        && 2ULL*128*128*4<=hardware.l0c;
    // Resource-checked row capacity for the whole aligned short-reduction
    // family. Reduction and column sizes are not matched to a testcase.
    // Every expert boundary is still read from this invocation's group_list.
    const bool largeShort=plan.family==Family::OwnedShort
        && gmm_plan::DivUp(K,256)==1 && K%32==0
        && gmm_plan::DivUp(N,256)==1 && N%32==0
        && 2ULL*(128+256)*256+512<=hardware.l1
        && 128ULL*256<=hardware.l0a && 256ULL*256<=hardware.l0b
        && 128ULL*256*4<=hardware.l0c
        && 64ULL*256*10+256*4+256+gmm_plan::Up(E*8,32)<=hardware.ub;
    const bool preparedFullB=CanPreparedFullB(shape,hardware,plan);
    const size_t extraPacked=(useActiveResident || preparedFullB)?size_t(E)*gmm_plan::Up(K,64)*gmm_plan::Up(N,32):0;
    const size_t scratchBytes=preparedFullB?std::max(plan.workspace,size_t(cores)*2*128*256*4)
        :useWideResident?size_t(cores)*4*128*128*4
        :largeShort?size_t(cores)*2*128*256*4:plan.workspace;
    void* allocation=nullptr;
    if(aclrtMalloc(&allocation,scratchBytes+extraPacked+511,ACL_MEM_MALLOC_HUGE_FIRST)!=ACL_SUCCESS)
        throw std::runtime_error("GroupedMatmulGelu: workspace allocation failed");
    GM_ADDR workspace=reinterpret_cast<GM_ADDR>((reinterpret_cast<uintptr_t>(allocation)+511)&~uintptr_t(511));
    try {
        switch(plan.family) {
        case Family::OwnedWide:
            // Half a TM64 row tile per launched core amortizes the expert scan.
            if(int64_t(M)>=int64_t(cores)*32)
                gmm_imported::BalancedWideKernel<<<cores,nullptr,stream>>>(GMM_FORWARD,plan.halfL1);
            else gmm_imported::OwnedWideKernel<<<cores,nullptr,stream>>>(GMM_FORWARD,plan.halfL1);
            break;
        case Family::BucketPair:
            switch(K/512) {
            case 2:gmm_imported::BucketPairKernel<<<cores,nullptr,stream>>>(GMM_FORWARD,plan.halfL1);break;
            case 3:gmm_imported::BucketPairRangeKernel<3><<<cores,nullptr,stream>>>(GMM_FORWARD,plan.halfL1);break;
            default:throw std::runtime_error("GroupedMatmulGelu: unsupported packet count");
            }break;
        case Family::OwnedShort:
            switch(K/32) {
            case 1:if(largeShort)gmm_imported::OwnedShortRangeKernel<32,128><<<cores,nullptr,stream>>>(GMM_FORWARD);else gmm_imported::OwnedShortRangeKernel<32><<<cores,nullptr,stream>>>(GMM_FORWARD);break;
            case 2:if(largeShort)gmm_imported::OwnedShortRangeKernel<64,128><<<cores,nullptr,stream>>>(GMM_FORWARD);else gmm_imported::OwnedShortRangeKernel<64><<<cores,nullptr,stream>>>(GMM_FORWARD);break;
            case 3:if(largeShort)gmm_imported::OwnedShortRangeKernel<96,128><<<cores,nullptr,stream>>>(GMM_FORWARD);else gmm_imported::OwnedShortRangeKernel<96><<<cores,nullptr,stream>>>(GMM_FORWARD);break;
            case 4:if(largeShort)gmm_imported::OwnedShortRangeKernel<128,128><<<cores,nullptr,stream>>>(GMM_FORWARD);else gmm_imported::OwnedShortRangeKernel<128><<<cores,nullptr,stream>>>(GMM_FORWARD);break;
            case 5:if(largeShort)gmm_imported::OwnedShortRangeKernel<160,128><<<cores,nullptr,stream>>>(GMM_FORWARD);else gmm_imported::OwnedShortRangeKernel<160><<<cores,nullptr,stream>>>(GMM_FORWARD);break;
            case 6:if(largeShort)gmm_imported::OwnedShortRangeKernel<192,128><<<cores,nullptr,stream>>>(GMM_FORWARD);else gmm_imported::OwnedShortRangeKernel<192><<<cores,nullptr,stream>>>(GMM_FORWARD);break;
            case 7:if(largeShort)gmm_imported::OwnedShortRangeKernel<224,128><<<cores,nullptr,stream>>>(GMM_FORWARD);else gmm_imported::OwnedShortRangeKernel<224><<<cores,nullptr,stream>>>(GMM_FORWARD);break;
            case 8:
                if(largeShort)gmm_imported::OwnedShortKernel<128><<<cores,nullptr,stream>>>(GMM_FORWARD);
                else gmm_imported::OwnedShortKernel<96><<<cores,nullptr,stream>>>(GMM_FORWARD);
                break;
            default:throw std::runtime_error("GroupedMatmulGelu: unsupported packet count");
            }break;
        case Family::BucketUnit:
            switch(K/512) {
            case 2:gmm_imported::BucketUnitRangeKernel<2><<<cores,nullptr,stream>>>(GMM_FORWARD,plan.halfL1);break;
            case 3:gmm_imported::BucketUnitRangeKernel<3><<<cores,nullptr,stream>>>(GMM_FORWARD,plan.halfL1);break;
            case 4:gmm_imported::BucketUnitKernel<<<cores,nullptr,stream>>>(GMM_FORWARD,plan.halfL1);break;
            case 5:gmm_imported::BucketUnitRangeKernel<5><<<cores,nullptr,stream>>>(GMM_FORWARD,plan.halfL1);break;
            case 6:gmm_imported::BucketUnitRangeKernel<6><<<cores,nullptr,stream>>>(GMM_FORWARD,plan.halfL1);break;
            case 7:gmm_imported::BucketUnitRangeKernel<7><<<cores,nullptr,stream>>>(GMM_FORWARD,plan.halfL1);break;
            default:throw std::runtime_error("GroupedMatmulGelu: unsupported packet count");
            }break;
        case Family::Compact:
            gmm_device::CompactAligned<128><<<cores,nullptr,stream>>>(x,w,sc,y,workspace,M,K,N);break;
        case Family::AlignedShort:
            if(plan.crossTile) {
                gmm_device::FourPacketKernel<1,64><<<cores,nullptr,stream>>>(GMM_FORWARD,plan.halfL1);
                break;
            }
            // Compile-time unrolling for power-of-two reduction packet counts;
            // every M/N/E satisfying this algorithm's capabilities is supported.
            switch(K/32) {
            case 1:gmm_device::AlignedShortKernel<32><<<cores,nullptr,stream>>>(GMM_FORWARD);break;
            case 2:gmm_device::AlignedShortKernel<64><<<cores,nullptr,stream>>>(GMM_FORWARD);break;
            case 4:gmm_device::AlignedShortKernel<128><<<cores,nullptr,stream>>>(GMM_FORWARD);break;
            case 8:gmm_device::AlignedShortKernel<256><<<cores,nullptr,stream>>>(GMM_FORWARD);break;
            default:gmm_device::AlignedShortKernel<0><<<cores,nullptr,stream>>>(GMM_FORWARD);break;
            }break;
        case Family::FourPacket:
            if(K/256==2) {
                if(plan.tm==128)gmm_device::FourPacketKernel<2,128><<<cores,nullptr,stream>>>(GMM_FORWARD,plan.halfL1);
                else gmm_device::FourPacketKernel<2,96><<<cores,nullptr,stream>>>(GMM_FORWARD,plan.halfL1);
            } else {
                if(plan.tm==128)gmm_device::FourPacketKernel<4,128><<<cores,nullptr,stream>>>(GMM_FORWARD,plan.halfL1);
                else gmm_device::FourPacketKernel<4,96><<<cores,nullptr,stream>>>(GMM_FORWARD,plan.halfL1);
            }break;
        case Family::AlignedWide:
            gmm_device::AlignedWideKernel<<<cores,nullptr,stream>>>(GMM_FORWARD,plan.halfL1);break;
        case Family::AlignedDeep:
            if(plan.crossTile)gmm_device::AlignedDeepKernel<true><<<cores,nullptr,stream>>>(GMM_FORWARD,plan.halfL1);
            else gmm_device::AlignedDeepKernel<false><<<cores,nullptr,stream>>>(GMM_FORWARD,plan.halfL1);break;
        case Family::Resident:
            if(preparedFullB){LaunchPreparedFullB(cores,stream,GMM_FORWARD);break;}
            if(useActiveResident){LaunchActiveResident(cores,stream,GMM_FORWARD,useWideResident);break;}
            if(!gmm_plan::ResidentEntryMatches(plan))
                throw std::runtime_error("GroupedMatmulGelu: resident tile and mechanism mismatch");
            if(plan.fullB)gmm_device::ResidentKernel<128,256,true><<<cores,nullptr,stream>>>(GMM_FORWARD);
            else if(plan.tm==64)gmm_device::ResidentKernel<64,128><<<cores,nullptr,stream>>>(GMM_FORWARD);
            else if(plan.tm==96)gmm_device::ResidentKernel<96,192><<<cores,nullptr,stream>>>(GMM_FORWARD);
            else if(plan.tm==128)gmm_device::ResidentKernel<128,256><<<cores,nullptr,stream>>>(GMM_FORWARD);
            else if(plan.tm==144)gmm_device::ResidentNarrowBKernel<<<cores,nullptr,stream>>>(GMM_FORWARD,plan.halfL1);
            else if(plan.tm==192)gmm_device::ResidentKernel<192,128><<<cores,nullptr,stream>>>(GMM_FORWARD);
            else gmm_device::ResidentKernel<256,128><<<cores,nullptr,stream>>>(GMM_FORWARD);break;
        case Family::PackedWeightResident:
            if(2ULL*32*gmm_plan::Up(N,32)+512<=hardware.l1) {
                LaunchActivePacked(false,plan.doubleInput,cores,stream,GMM_FORWARD,plan.halfL1);break;
            }
            if(plan.doubleInput)
                gmm_device::PackedWeightResidentBufferedKernel<<<cores,nullptr,stream>>>(GMM_FORWARD,plan.halfL1);
            else gmm_device::PackedWeightResidentKernel<<<cores,nullptr,stream>>>(GMM_FORWARD,plan.halfL1);break;
        case Family::PackedWeight:
            if(2ULL*32*gmm_plan::Up(N,32)+512<=hardware.l1){LaunchGroupedPacked(cores,stream,GMM_FORWARD,plan.halfL1,plan.packX,hardware.l2 && uint64_t(M)*K>hardware.l2);break;}
            if(plan.copyRows==16)gmm_device::PackedWeightKernel<16><<<cores,nullptr,stream>>>(GMM_FORWARD,plan.halfL1);
            else gmm_device::PackedWeightKernel<8><<<cores,nullptr,stream>>>(GMM_FORWARD,plan.halfL1);break;
        case Family::PackedBoth:
            if(2ULL*128*gmm_plan::Up(N,32)+512<=hardware.l1 && 2ULL*32768+512<=hardware.ub) {
                LaunchActivePacked(true,false,cores,stream,GMM_FORWARD,plan.halfL1);break;
            }
            if(plan.copyRows==16)gmm_device::PackedBothKernel<16><<<cores,nullptr,stream>>>(GMM_FORWARD,plan.halfL1);
            else gmm_device::PackedBothKernel<8><<<cores,nullptr,stream>>>(GMM_FORWARD,plan.halfL1);break;
        case Family::Streaming:
            gmm_device::StreamingKernel<<<cores,nullptr,stream>>>(GMM_FORWARD,plan.halfL1);break;
        default:
            gmm_device::SdkKernel<<<cores,nullptr,stream>>>(GMM_FORWARD,gmm_host::SdkTiling(shape,hardware));break;
        }
    } catch(...) {aclrtFree(allocation);throw;}
    const aclError status=aclrtSynchronizeStream(stream);
    aclrtFree(allocation);
    if(status!=ACL_SUCCESS)throw std::runtime_error("GroupedMatmulGelu: kernel execution failed");
}
#undef GMM_FORWARD
#undef GMM_ARGUMENTS

#define GMM_ARGUMENTS GM_ADDR x,GM_ADDR w,GM_ADDR sc,GM_ADDR groups,GM_ADDR y,GM_ADDR workspace,int M,int K,int N,int E
#define GMM_FORWARD x,w,sc,groups,y,workspace,M,K,N,E
namespace gmm_l1_prepare {
using namespace AscendC;

template<int Rows,int Width,int Fold,bool Weight>
__aicore__ inline void LoadMatrix(LocalTensor<int8_t> dst,GlobalTensor<int8_t> src,
    int task,int M,int K,int N,bool reused,uint8_t freeId,uint8_t readyId) {
    if(reused)WaitFlag<HardEvent::MTE3_MTE2>(freeId);
    const int height=Weight?K:M,columns=Weight?N:K;
    const int hp=Weight?(K+63)/64*64:(M+15)/16*16;
    const int cp=Weight?(N+31)/32*32:(K+63)/64*64;
    const int tw=Weight?cp:Width,nc=(cp+tw-1)/tw,nr=(hp+Rows-1)/Rows;
    const int e=task/(nc*nr),inner=task%(nc*nr),row=inner/nc*Rows,col=inner%nc*tw;
    const int rows=hp-row<Rows?hp-row:Rows,cols=cp-col<tw?cp-col:tw;
    const int liveRows=height-row<rows?(height>row?height-row:0):rows;
    const int liveCols=columns-col<cols?(columns>col?columns-col:0):cols;
    if constexpr(Weight) {
        // ND2NZ fills the final 32-byte column block; initialize only missing K rows.
        if(liveRows<rows) {
            InitConstValue(dst[liveRows*32].ReinterpretCast<uint32_t>(),
                InitConstValueParams<uint32_t>(cols/32,rows-liveRows,liveRows,0));
            PipeBarrier<PIPE_MTE2>();
        }
    } else {
    if(liveRows<rows || liveCols<cols) {
        InitConstValue(dst.ReinterpretCast<uint32_t>(),InitConstValueParams<uint32_t>(1,rows*cols/32,0,0));
        PipeBarrier<PIPE_MTE2>();
    }
    }
    if(liveRows>0 && liveCols>0) {
        Nd2NzParams p;
        p.ndNum=1;p.nValue=liveRows;p.dValue=liveCols;
        p.srcNdMatrixStride=0;p.srcDValue=columns;
        p.dstNzC0Stride=rows;p.dstNzNStride=1;p.dstNzMatrixStride=0;
        if constexpr(Fold>1)if(liveRows==rows && rows%(16*Fold)==0 && columns*Fold<=65535) {
            p.ndNum=Fold;p.nValue=rows/Fold;p.srcNdMatrixStride=columns;
            p.srcDValue=columns*Fold;p.dstNzNStride=Fold;p.dstNzMatrixStride=32;
        }
        DataCopy(dst,src[(int64_t(e)*height+row)*columns+col],p);
    }
    SetFlag<HardEvent::MTE2_MTE3>(readyId);
}

template<int Rows,int Width,int Depth,int Fold,bool Weight>
__aicore__ inline void PrepareMatrix(GM_ADDR source,GM_ADDR packed,int M,int K,int N,int E) {
    if ASCEND_IS_AIC {
        TPipe pipe;TBuf<TPosition::A1> buffers[Depth];
        uint8_t freeId[Depth],readyId[Depth];bool used[Depth]={};
        const int hp=Weight?(K+63)/64*64:(M+15)/16*16;
        const int cp=Weight?(N+31)/32*32:(K+63)/64*64;
        const int tw=Weight?cp:Width,nc=(cp+tw-1)/tw,nr=(hp+Rows-1)/Rows;
        const int tasks=(Weight?E:1)*nc*nr,block=GetBlockIdx(),cores=GetBlockNum();
        for(int s=0;s<Depth;++s) {
            pipe.InitBuffer(buffers[s],Rows*tw);
            freeId[s]=pipe.AllocEventID<HardEvent::MTE3_MTE2>();
            readyId[s]=pipe.AllocEventID<HardEvent::MTE2_MTE3>();
        }
        GlobalTensor<int8_t> src,dst;
        src.SetGlobalBuffer((__gm__ int8_t*)source);dst.SetGlobalBuffer((__gm__ int8_t*)packed);
        for(int s=0;s<Depth;++s)if(block+s*cores<tasks) {
            LoadMatrix<Rows,Width,Fold,Weight>(buffers[s].template Get<int8_t>(),src,
                block+s*cores,M,K,N,false,freeId[s],readyId[s]);used[s]=true;
        }
        for(int index=0,task=block;task<tasks;++index,task+=cores) {
            const int slot=index%Depth,e=task/(nc*nr),inner=task%(nc*nr),row=inner/nc*Rows,col=inner%nc*tw;
            const int rows=hp-row<Rows?hp-row:Rows,cols=cp-col<tw?cp-col:tw;
            auto local=buffers[slot].template Get<int8_t>();
            WaitFlag<HardEvent::MTE2_MTE3>(readyId[slot]);
            DataCopy(dst[int64_t(e)*hp*cp+int64_t(col)*hp+row*32],local,
                DataCopyParams{uint16_t(cols/32),uint16_t(rows),0,uint16_t(hp-rows)});
            SetFlag<HardEvent::MTE3_MTE2>(freeId[slot]);
            if(task+Depth*cores<tasks)
                LoadMatrix<Rows,Width,Fold,Weight>(local,src,task+Depth*cores,M,K,N,true,freeId[slot],readyId[slot]);
        }
        for(int s=0;s<Depth;++s) {
            if(used[s])WaitFlag<HardEvent::MTE3_MTE2>(freeId[s]);
            pipe.ReleaseEventID<HardEvent::MTE3_MTE2>(freeId[s]);
            pipe.ReleaseEventID<HardEvent::MTE2_MTE3>(readyId[s]);
        }
        PipeBarrier<PIPE_ALL>();
    }
}
}
namespace gmm_coop {
using namespace AscendC;
template<int CubeRows,int VectorEighths>
__aicore__ inline int CubeChunks(int kp) {
    const int total=(kp+CubeRows-1)/CubeRows;
    return total*(8-VectorEighths)/8;
}
template<int CubeRows,int Fold,int VectorEighths>
__aicore__ inline void PrepareCube(GM_ADDR w,GM_ADDR wp,int M,int K,int N,int E) {
    if ASCEND_IS_AIC {
        const int kp=(K+63)/64*64,np=(N+31)/32*32;
        const int allChunks=(kp+CubeRows-1)/CubeRows;
        const int chunks=CubeChunks<CubeRows,VectorEighths>(kp);
        if(chunks==0)return;
        TPipe pipe;TBuf<TPosition::A1> buffers[2];
        uint8_t freeId[2],readyId[2];bool used[2]={};
        for(int s=0;s<2;++s) {
            pipe.InitBuffer(buffers[s],CubeRows*np);
            freeId[s]=pipe.AllocEventID<HardEvent::MTE3_MTE2>();
            readyId[s]=pipe.AllocEventID<HardEvent::MTE2_MTE3>();
        }
        GlobalTensor<int8_t> src,dst;
        src.SetGlobalBuffer((__gm__ int8_t*)w);dst.SetGlobalBuffer((__gm__ int8_t*)wp);
        const int block=GetBlockIdx(),cores=GetBlockNum(),tasks=E*chunks;
        for(int s=0;s<2;++s)if(block+s*cores<tasks) {
            const int task=block+s*cores,mapped=task/chunks*allChunks+task%chunks;
            gmm_l1_prepare::LoadMatrix<CubeRows,0,Fold,true>(buffers[s].Get<int8_t>(),src,
                mapped,M,K,N,false,freeId[s],readyId[s]);used[s]=true;
        }
        for(int index=0,task=block;task<tasks;++index,task+=cores) {
            const int slot=index&1,e=task/chunks,row=task%chunks*CubeRows;
            const int rows=kp-row<CubeRows?kp-row:CubeRows;
            auto local=buffers[slot].Get<int8_t>();
            WaitFlag<HardEvent::MTE2_MTE3>(readyId[slot]);
            DataCopy(dst[int64_t(e)*kp*np+row*32],local,
                DataCopyParams{uint16_t(np/32),uint16_t(rows),0,uint16_t(kp-rows)});
            SetFlag<HardEvent::MTE3_MTE2>(freeId[slot]);
            if(task+2*cores<tasks) {
                const int next=task+2*cores,mapped=next/chunks*allChunks+next%chunks;
                gmm_l1_prepare::LoadMatrix<CubeRows,0,Fold,true>(local,src,mapped,M,K,N,
                    true,freeId[slot],readyId[slot]);
            }
        }
        for(int s=0;s<2;++s) {
            if(used[s])WaitFlag<HardEvent::MTE3_MTE2>(freeId[s]);
            pipe.ReleaseEventID<HardEvent::MTE3_MTE2>(freeId[s]);
            pipe.ReleaseEventID<HardEvent::MTE2_MTE3>(readyId[s]);
        }
        PipeBarrier<PIPE_ALL>();
    }
}}
namespace gmm_coop {
using namespace AscendC;
template<int CubeRows,int Fold,int VectorEighths,bool BypassDense>
__aicore__ inline void PrepareActiveCube(GM_ADDR w,GM_ADDR wp,int M,int K,int N,int E,GM_ADDR groups) {
    if ASCEND_IS_AIC {
        const int kp=(K+63)/64*64,np=(N+31)/32*32;
        const int allChunks=(kp+CubeRows-1)/CubeRows;
        const int chunks=CubeChunks<CubeRows,VectorEighths>(kp);
        if(chunks==0)return;

        if constexpr(BypassDense) {
            bool dense=true;int previous=0;
            for(int e=0;e<E;++e){const int end=int(((__gm__ int64_t*)groups)[e]);dense &= end>previous;previous=end;}
            if(dense){PrepareCube<CubeRows,Fold,VectorEighths>(w,wp,M,K,N,E);return;}
        }
        int expertMap[128],active=0,previous=0;
        for(int e=0;e<E;++e){const int end=int(((__gm__ int64_t*)groups)[e]);if(end>previous)expertMap[active++]=e;previous=end;}
        TPipe pipe;TBuf<TPosition::A1> buffers[2];
        uint8_t freeId[2],readyId[2];bool used[2]={};
        for(int s=0;s<2;++s) {
            pipe.InitBuffer(buffers[s],CubeRows*np);
            freeId[s]=pipe.AllocEventID<HardEvent::MTE3_MTE2>();
            readyId[s]=pipe.AllocEventID<HardEvent::MTE2_MTE3>();
        }
        GlobalTensor<int8_t> src,dst;
        src.SetGlobalBuffer((__gm__ int8_t*)w);dst.SetGlobalBuffer((__gm__ int8_t*)wp);
        const int block=GetBlockIdx(),cores=GetBlockNum(),tasks=active*chunks;
        for(int s=0;s<2;++s)if(block+s*cores<tasks) {
            const int task=block+s*cores,mapped=expertMap[task/chunks]*allChunks+task%chunks;
            gmm_l1_prepare::LoadMatrix<CubeRows,0,Fold,true>(buffers[s].Get<int8_t>(),src,
                mapped,M,K,N,false,freeId[s],readyId[s]);used[s]=true;
        }
        for(int index=0,task=block;task<tasks;++index,task+=cores) {
            const int slot=index&1,e=expertMap[task/chunks],row=task%chunks*CubeRows;
            const int rows=kp-row<CubeRows?kp-row:CubeRows;
            auto local=buffers[slot].Get<int8_t>();
            WaitFlag<HardEvent::MTE2_MTE3>(readyId[slot]);
            DataCopy(dst[int64_t(e)*kp*np+row*32],local,
                DataCopyParams{uint16_t(np/32),uint16_t(rows),0,uint16_t(kp-rows)});
            SetFlag<HardEvent::MTE3_MTE2>(freeId[slot]);
            if(task+2*cores<tasks) {
                const int next=task+2*cores,mapped=expertMap[next/chunks]*allChunks+next%chunks;
                gmm_l1_prepare::LoadMatrix<CubeRows,0,Fold,true>(local,src,mapped,M,K,N,
                    true,freeId[slot],readyId[slot]);
            }
        }
        for(int s=0;s<2;++s) {
            if(used[s])WaitFlag<HardEvent::MTE3_MTE2>(freeId[s]);
            pipe.ReleaseEventID<HardEvent::MTE3_MTE2>(freeId[s]);
            pipe.ReleaseEventID<HardEvent::MTE2_MTE3>(readyId[s]);
        }
        PipeBarrier<PIPE_ALL>();
    }
}}
namespace gmm_device {
template<int ChunkK,bool Rotate>
__aicore__ inline void GlobalPackedLoadB(LocalTensor<int8_t> b,GlobalTensor<int8_t> w,
    int e,int col,int cols,int K,int N,int KCap,const uint8_t* ready) {
    const int np=(N+31)/32*32,pn=(cols+31)/32*32,chunks=(K+ChunkK-1)/ChunkK;
    const int start=Rotate?int(GetBlockIdx())%chunks:0;
    for(int i=0;i<chunks;++i) {
        const int offset=((start+i)%chunks)*ChunkK;
        const int rows=KCap-offset<ChunkK?KCap-offset:ChunkK;
        DataCopy(b[offset*32],w[(int64_t(e)*np+col)*KCap+int64_t(offset)*32],
            DataCopyParams{uint16_t(pn/32),uint16_t(rows),uint16_t(KCap-rows),uint16_t(KCap-rows)});
        SetFlag<HardEvent::MTE2_MTE1>(ready[i]);
    }
}
template<int TileM,int TileN,int Fold,int L0K,int L0Slots,int CDepth,int OutputSlots,bool Load3D,bool UnitFlag,int ChunkK,int ChunkRows,bool Compact,bool Rotate>
__aicore__ __attribute__((always_inline)) inline void
ComputeGloballyPackedSplit(GM_ADDR x,GM_ADDR w,GM_ADDR sc,GM_ADDR groups,GM_ADDR y,GM_ADDR workspace,
    int M,int K,int N,int E)
{
    const int KCap=(K+63)/64*64;
    TPipe pipe;
    GlobalTensor<int8_t> gx,gw;
    GlobalTensor<float> gs;
    GlobalTensor<int32_t> gc;
    GlobalTensor<half> gy;
    gx.SetGlobalBuffer((__gm__ int8_t*)x);gw.SetGlobalBuffer((__gm__ int8_t*)w);
    gs.SetGlobalBuffer((__gm__ float*)sc);gc.SetGlobalBuffer((__gm__ int32_t*)workspace);
    gy.SetGlobalBuffer((__gm__ half*)y);
    constexpr int tm=TileM,tn=TileN,capacity=8192,vr=capacity/tn,ve=(vr*tn+63)/64*64;
    TBuf<TPosition::A1> a1Buffer[2];
    TBuf<TPosition::B1> b1Buffer[2];
    TBuf<TPosition::A2> a2Buffer;
    TBuf<TPosition::B2> b2Buffer;
    TBuf<TPosition::CO1> accBuffer;
    LocalTensor<int8_t> a1[2],b1[2],a2[L0Slots],b2[L0Slots];
    uint8_t l1Free[2],l1Ready[2],l0Free[L0Slots],l0Ready[L0Slots];
    // Original L1 capacity check bounds this route to three B chunks.
    uint8_t accumulatorFree[CDepth],matrixReady=0,bFree[2],bReady[2][3];
    bool l1Used[2]={},l0Used[L0Slots]={},bUsed[2]={};
    if ASCEND_IS_AIC {
	pipe.InitBuffer(a1Buffer[0],tm*KCap);
	for(int i=0;i<2;++i) {
	    pipe.InitBuffer(b1Buffer[i],tn*KCap);
	    b1[i]=b1Buffer[i].Get<int8_t>();
	    bFree[i]=pipe.AllocEventID<HardEvent::MTE1_MTE2>();
	    for(int j=0;j<3;++j)bReady[i][j]=pipe.AllocEventID<HardEvent::MTE2_MTE1>();
	}
#pragma unroll
	for(int i=0;i<1;++i) {
	    a1[i]=a1Buffer[i].Get<int8_t>();
	    l1Free[i]=pipe.AllocEventID<HardEvent::MTE1_MTE2>();
	    l1Ready[i]=pipe.AllocEventID<HardEvent::MTE2_MTE1>();
	}
	pipe.InitBuffer(a2Buffer,L0Slots*tm*L0K);pipe.InitBuffer(b2Buffer,L0Slots*tn*L0K);
#pragma unroll
	for(int i=0;i<L0Slots;++i) {
	    a2[i]=a2Buffer.Get<int8_t>()[i*tm*L0K];b2[i]=b2Buffer.Get<int8_t>()[i*tn*L0K];
	    l0Free[i]=pipe.AllocEventID<HardEvent::M_MTE1>();
	    l0Ready[i]=pipe.AllocEventID<HardEvent::MTE1_M>();
	}
	pipe.InitBuffer(accBuffer,CDepth*tm*tn*4);
	for(int i=0;i<CDepth;++i)accumulatorFree[i]=pipe.AllocEventID<HardEvent::FIX_M>();
        if constexpr(Load3D){const uint8_t pads[4]={};SetFmatrix(1,tm,pads,FmatrixMode::FMATRIX_LEFT);}
	matrixReady=pipe.AllocEventID<HardEvent::M_FIX>();
    }
    TQue<TPosition::VECIN,1> cq;
    TQue<TPosition::VECOUT,1> oq;
    TBuf<TPosition::VECCALC> zb,pb,groupCache;
    if ASCEND_IS_AIV {
	pipe.InitBuffer(cq,1,uint32_t((tm/2*tn+tn)*4)+(tm*tn>16384?256:0));
	pipe.InitBuffer(oq,1,ve*2);pipe.InitBuffer(zb,ve*4);
	pipe.InitBuffer(groupCache,(E*8+31)/32*32);
	GlobalTensor<int64_t> gg;gg.SetGlobalBuffer((__gm__ int64_t*)groups);
	DataCopyPad(groupCache.Get<int64_t>(),gg,{1,uint32_t(E*8),0,0,0},{true,0,0,int64_t(0)});
	auto ready=pipe.FetchEventID<HardEvent::MTE2_S>();
	SetFlag<HardEvent::MTE2_S>(ready);WaitFlag<HardEvent::MTE2_S>(ready);
    }
    int blockIdx=int(GetBlockIdx()),lane=0;
    if ASCEND_IS_AIV {lane=blockIdx&1;blockIdx/=2;}
    const int blockNum=int(GetBlockNum());
    const int nc=(N+tn-1)/tn;
    const int avgStride=N/nc/32*32;
    const int strideN=N-(nc-1)*avgStride>tn?avgStride+32:avgStride;
    static_assert(TileM==192,"Adaptive row count requires physical TM192");
    int64_t totalTasks=0,totalSmall=0;
    int previous=0,largest=0;
    for(int expert=0;expert<E;++expert) {
	int last=0;
	if ASCEND_IS_AIC {last=int(((__gm__ int64_t*)groups)[expert]);}
	if ASCEND_IS_AIV {last=int(groupCache.Get<int64_t>().GetValue(expert));}
	if(last<previous)last=previous;if(last>M)last=M;
        const int size=last-previous;
        totalTasks+=int64_t((size+191)/192)*nc;
        totalSmall+=int64_t((size+95)/96)*nc;
        if(size>largest)largest=size;
        previous=last;
    }
    const bool smaller=int64_t(largest)*E>int64_t(M)*2;
    const int rowTile=smaller?96:192;
    if(smaller)totalTasks=totalSmall;
    const int64_t ownedBegin=totalTasks*blockIdx/blockNum;
    const int64_t ownedEnd=totalTasks*(blockIdx+1)/blockNum;
    int64_t taskOffset=0;
    int local=0,begin=0;
    for(int e=0;e<E;++e) {
	int end=0;
	if ASCEND_IS_AIC {end=int(((__gm__ int64_t*)groups)[e]);}
	if ASCEND_IS_AIV {end=int(groupCache.Get<int64_t>().GetValue(e));}
	if(end<begin)end=begin;if(end>M)end=M;
	const int me=end-begin,mt=smaller?(me+95)/96:(me+191)/192;
	const int64_t tasks=int64_t(mt)*nc;
	const int64_t first=ownedBegin>taskOffset?ownedBegin-taskOffset:0;
	const int64_t limit=ownedEnd-taskOffset<tasks?ownedEnd-taskOffset:tasks;
	for(int64_t task=first;task<limit;) {
	    const int mi=task/nc,niStart=task%nc;
	    const int row=begin+mi*rowTile,rows=end-row<rowTile?end-row:rowTile;
	    const int tiles=nc-niStart<limit-task?nc-niStart:int(limit-task);
	    if ASCEND_IS_AIC {
		SplitResidentLoadA<tm,ChunkRows,Compact>(a1[0],gx,row,rows,K,l1Used[0],l1Free[0],l1Ready[0],KCap);
		l1Used[0]=true;
		const int bs=local&1, col=niStart*strideN;
		const int cols=niStart+1==nc?N-col:strideN;
		if(bUsed[bs])WaitFlag<HardEvent::MTE1_MTE2>(bFree[bs]);
		GlobalPackedLoadB<ChunkK,Rotate>(b1[bs],gw,e,col,cols,K,N,KCap,bReady[bs]);
		bUsed[bs]=true;

	    }
	    for(int tile=0;tile<tiles;++tile) {
		const int ni=niStart+tile,col=ni*strideN;
		const int cols=ni+1==nc?N-col:strideN,pitch=(cols+31)/32*32;
		const int slot=local%OutputSlots;
		const uint16_t tileFlag=8+slot;
		const uint16_t freeFlag=12+slot;
		auto gcSlot=gc[int64_t(blockIdx*OutputSlots+slot)*tm*tn];
		if ASCEND_IS_AIC {
		    const int as=0;
		    const int bs=local&1;

		    if(tile+1<tiles) {
			const int next=bs^1,nextCol=(ni+1)*strideN;
			const int nextCols=ni+2==nc?N-nextCol:strideN;
			if(bUsed[next])WaitFlag<HardEvent::MTE1_MTE2>(bFree[next]);
			GlobalPackedLoadB<ChunkK,Rotate>(b1[next],gw,e,nextCol,nextCols,K,N,KCap,bReady[next]);
			bUsed[next]=true;

		    }

		    const int cs=local%CDepth;auto acc=accBuffer.Get<int32_t>()[cs*tm*tn];
            const int chunks=(K+ChunkK-1)/ChunkK;
            const int firstChunk=Rotate?blockIdx%chunks:0;
            int sub=0;
            for(int ci=0;ci<chunks;++ci) {
                WaitFlag<HardEvent::MTE2_MTE1>(bReady[bs][ci]);
                const int chunk=(firstChunk+ci)%chunks;
                const int endK=KCap<(chunk+1)*ChunkK?KCap:(chunk+1)*ChunkK;
                for(int offset=chunk*ChunkK;offset<endK;offset+=L0K,++sub) {
                    const int ls=sub%L0Slots,ck=endK-offset<L0K?endK-offset:L0K;
                    if(l0Used[ls])WaitFlag<HardEvent::M_MTE1>(l0Free[ls]);
                    SplitLoadL0<tm,L0K,Load3D,Compact>(a2[ls],b2[ls],a1[as],b1[bs],rows,pitch,offset,ck,KCap);
                    SetFlag<HardEvent::MTE1_M>(l0Ready[ls]);WaitFlag<HardEvent::MTE1_M>(l0Ready[ls]);
                    if(!sub && local>=CDepth)WaitFlag<HardEvent::FIX_M>(accumulatorFree[cs]);
                    MmadParams mad;
                    mad.m=(rows+15)/16*16;mad.n=pitch;mad.k=ck;mad.cmatrixInitVal=sub==0;
                    if constexpr(UnitFlag)mad.unitFlag=sub+1==(KCap+L0K-1)/L0K?3:2;
                    Mmad(acc,a2[ls],b2[ls],mad);
                    if((mad.m/16)*(mad.n/16)<10)PipeBarrier<PIPE_M>();
                    SetFlag<HardEvent::M_MTE1>(l0Free[ls]);l0Used[ls]=true;
                }
            }
		    SetFlag<HardEvent::MTE1_MTE2>(bFree[bs]);
		    if constexpr(!UnitFlag){SetFlag<HardEvent::M_FIX>(matrixReady);WaitFlag<HardEvent::M_FIX>(matrixReady);}
		    if(local>=OutputSlots)CrossCoreWaitFlag<2,PIPE_FIX>(freeFlag);
		    FixpipeParamsV220 fix;if constexpr(UnitFlag)fix.unitFlag=3;fix.nSize=pitch;fix.mSize=(rows+15)/16*16;fix.srcStride=fix.mSize;fix.dstStride=tn;
		    Fixpipe<int32_t,int32_t,CFG_ROW_MAJOR>(gcSlot,acc,fix);
		    SetFlag<HardEvent::FIX_M>(accumulatorFree[cs]);
		    CrossCoreSetFlag<2,PIPE_FIX>(tileFlag);
		}
					if ASCEND_IS_AIV
			{
			    CrossCoreWaitFlag<2, PIPE_MTE2>(tileFlag);
			    const int halfRows = (rows + 1) / 2;
			    const int rowOffset = lane * halfRows;
			    const int vectorRows = lane ? rows - halfRows : halfRows;
			    auto c = cq.AllocTensor<int32_t>();
			    auto scale = c.ReinterpretCast<float>()[((tm + 1) / 2 * tn) +
								    (tm * tn > 16384 ? 64 : 0)];

			    if (pitch != (cols + 7) / 8 * 8)
			    {
				Duplicate(c, int32_t(0), vectorRows * pitch);
				auto event = pipe.FetchEventID<HardEvent::V_MTE2>();
				SetFlag<HardEvent::V_MTE2>(event);
				WaitFlag<HardEvent::V_MTE2>(event);
			    }

			    if (vectorRows > 0)
				DataCopyPad(c, gcSlot[int64_t(rowOffset) * tn],
					    {uint16_t(vectorRows), uint32_t(cols * sizeof(int32_t)),
					     uint32_t((tn - cols) * sizeof(int32_t)),
					     uint32_t((pitch * 4 - (cols * 4 + 31) / 32 * 32) / 32),
					     0},
					    {true, 0, 0, 0});
			    if (cols < 64)
			    {
				Duplicate(scale, 0.0f, tn);
				auto initialized = pipe.FetchEventID<HardEvent::V_MTE2>();
				SetFlag<HardEvent::V_MTE2>(initialized);
				WaitFlag<HardEvent::V_MTE2>(initialized);
			    }
			    DataCopyPad(scale, gs[(int64_t)e * N + col],
					{1, (uint32_t)(cols * sizeof(float)), 0, 0, 0},
					{true, 0, 0, 0.0f});
			    cq.EnQue(c);
			    c = cq.DeQue<int32_t>();

			    CrossCoreSetFlag<2, PIPE_MTE2>(freeFlag);

			    auto z = zb.Get<float>();
			    auto p = c.ReinterpretCast<float>();
			    auto u = p;
			    auto t = p;

			    const BinaryRepeatParams bcast{
				1, 1, 1, (uint8_t)(pitch / 8), (uint8_t)(pitch / 8), 0};
			    for (int r = 0; r < vectorRows; r += vr)
			    {
				const int batch = (vectorRows - r < vr) ? (vectorRows - r) : vr;
				const uint32_t count = (uint32_t)batch * pitch;
				Cast(z, c[r * pitch], RoundMode::CAST_NONE, count);
				PipeBarrier<PIPE_V>();
				if (cols < 64)
				{
				    Mul(z, z, scale, (uint64_t)(pitch < 64 ? pitch : 64),
					(uint8_t)batch, bcast);
				}
				else
				{
				    for (int c0 = 0; c0 < cols; c0 += 64)
				    {
					const int chunk = (cols - c0 < 64) ? (cols - c0) : 64;
					Mul(z[c0], z[c0], scale[c0], (uint64_t)chunk,
					    (uint8_t)batch, bcast);
				    }
				}
				PipeBarrier<PIPE_V>();

				p = c[r * pitch].ReinterpretCast<float>();
				u = p;
				ResidentGelu(z,p,count);
				auto out = oq.AllocTensor<half>();
				Cast(out, z, RoundMode::CAST_RINT, count);
				oq.EnQue(out);
				out = oq.DeQue<half>();
				const uint32_t outBytes = (uint32_t)cols * (uint32_t)sizeof(half);
				const uint32_t outPitchBytes =
				    (uint32_t)pitch * (uint32_t)sizeof(half);
				const uint32_t outSrcStride =
				    (outPitchBytes - ((outBytes + 31U) / 32U) * 32U) / 32U;
				for (int r0 = 0; r0 < batch; r0 += 32)
				{
				    const int rc = batch - r0 < 32 ? batch - r0 : 32;
				    DataCopyPad(gy[(int64_t)(row + rowOffset + r + r0) * N + col],
						out[r0 * pitch],
						{(uint16_t)rc, outBytes, outSrcStride,
						 (uint32_t)((N - cols) * sizeof(half)), 0});
				}
				oq.FreeTensor(out);
			    }
			    cq.FreeTensor(c);
			}

		++local;
	    }
	    if ASCEND_IS_AIC {SetFlag<HardEvent::MTE1_MTE2>(l1Free[0]);}
	    task+=tiles;
	}
	taskOffset+=tasks;begin=end;
    }
    if ASCEND_IS_AIV {PipeBarrier<PIPE_ALL>();}
    if ASCEND_IS_AIC {
	for(int i=0;i<OutputSlots;++i)if(local>i)CrossCoreWaitFlag<2,PIPE_MTE2>(12+i);
	for(int i=0;i<CDepth;++i)if(local>i)WaitFlag<HardEvent::FIX_M>(accumulatorFree[i]);
	for(int i=0;i<2;++i) {
	    if(bUsed[i])WaitFlag<HardEvent::MTE1_MTE2>(bFree[i]);
	    pipe.ReleaseEventID<HardEvent::MTE1_MTE2>(bFree[i]);
	    for(int j=0;j<3;++j)pipe.ReleaseEventID<HardEvent::MTE2_MTE1>(bReady[i][j]);
	}
#pragma unroll
	for(int i=0;i<1;++i) {
	    if(l1Used[i])WaitFlag<HardEvent::MTE1_MTE2>(l1Free[i]);
	    pipe.ReleaseEventID<HardEvent::MTE1_MTE2>(l1Free[i]);
	    pipe.ReleaseEventID<HardEvent::MTE2_MTE1>(l1Ready[i]);
	}
#pragma unroll
	for(int i=0;i<L0Slots;++i) {
	    if(l0Used[i])WaitFlag<HardEvent::M_MTE1>(l0Free[i]);
	    pipe.ReleaseEventID<HardEvent::M_MTE1>(l0Free[i]);
	    pipe.ReleaseEventID<HardEvent::MTE1_M>(l0Ready[i]);
	}
	for(int i=0;i<CDepth;++i)pipe.ReleaseEventID<HardEvent::FIX_M>(accumulatorFree[i]);
	pipe.ReleaseEventID<HardEvent::M_FIX>(matrixReady);
    }
}

template<int TileM,int TileN,int Fold,int L0K,int L0Slots,int CDepth,int OutputSlots,bool Load3D,bool UnitFlag,int ChunkK,int ChunkRows,bool Compact,bool Rotate>
__aicore__ __attribute__((always_inline)) inline void
ComputeAdaptive128(GM_ADDR x,GM_ADDR w,GM_ADDR sc,GM_ADDR groups,GM_ADDR y,GM_ADDR workspace,
    int M,int K,int N,int E)
{
    const int KCap=(K+63)/64*64;
    TPipe pipe;
    GlobalTensor<int8_t> gx,gw;
    GlobalTensor<float> gs;
    GlobalTensor<int32_t> gc;
    GlobalTensor<half> gy;
    gx.SetGlobalBuffer((__gm__ int8_t*)x);gw.SetGlobalBuffer((__gm__ int8_t*)w);
    gs.SetGlobalBuffer((__gm__ float*)sc);gc.SetGlobalBuffer((__gm__ int32_t*)workspace);
    gy.SetGlobalBuffer((__gm__ half*)y);
    constexpr int tm=TileM,tn=TileN,capacity=8192,vr=capacity/tn,ve=(vr*tn+63)/64*64;
    TBuf<TPosition::A1> a1Buffer[2];
    TBuf<TPosition::B1> b1Buffer[2];
    TBuf<TPosition::A2> a2Buffer;
    TBuf<TPosition::B2> b2Buffer;
    TBuf<TPosition::CO1> accBuffer;
    LocalTensor<int8_t> a1[2],b1[2],a2[L0Slots],b2[L0Slots];
    uint8_t l1Free[2],l1Ready[2],l0Free[L0Slots],l0Ready[L0Slots];
    // Original L1 capacity check bounds this route to three B chunks.
    uint8_t accumulatorFree[CDepth],matrixReady=0,bFree[2],bReady[2][3];
    bool l1Used[2]={},l0Used[L0Slots]={},bUsed[2]={};
    if ASCEND_IS_AIC {
	pipe.InitBuffer(a1Buffer[0],tm*KCap);
	for(int i=0;i<2;++i) {
	    pipe.InitBuffer(b1Buffer[i],tn*KCap);
	    b1[i]=b1Buffer[i].Get<int8_t>();
	    bFree[i]=pipe.AllocEventID<HardEvent::MTE1_MTE2>();
	    for(int j=0;j<3;++j)bReady[i][j]=pipe.AllocEventID<HardEvent::MTE2_MTE1>();
	}
#pragma unroll
	for(int i=0;i<1;++i) {
	    a1[i]=a1Buffer[i].Get<int8_t>();
	    l1Free[i]=pipe.AllocEventID<HardEvent::MTE1_MTE2>();
	    l1Ready[i]=pipe.AllocEventID<HardEvent::MTE2_MTE1>();
	}
	pipe.InitBuffer(a2Buffer,L0Slots*tm*L0K);pipe.InitBuffer(b2Buffer,L0Slots*tn*L0K);
#pragma unroll
	for(int i=0;i<L0Slots;++i) {
	    a2[i]=a2Buffer.Get<int8_t>()[i*tm*L0K];b2[i]=b2Buffer.Get<int8_t>()[i*tn*L0K];
	    l0Free[i]=pipe.AllocEventID<HardEvent::M_MTE1>();
	    l0Ready[i]=pipe.AllocEventID<HardEvent::MTE1_M>();
	}
	pipe.InitBuffer(accBuffer,CDepth*tm*tn*4);
	for(int i=0;i<CDepth;++i)accumulatorFree[i]=pipe.AllocEventID<HardEvent::FIX_M>();
        if constexpr(Load3D){const uint8_t pads[4]={};SetFmatrix(1,tm,pads,FmatrixMode::FMATRIX_LEFT);}
	matrixReady=pipe.AllocEventID<HardEvent::M_FIX>();
    }
    TQue<TPosition::VECIN,1> cq;
    TQue<TPosition::VECOUT,1> oq;
    TBuf<TPosition::VECCALC> zb,pb,groupCache;
    if ASCEND_IS_AIV {
	pipe.InitBuffer(cq,1,uint32_t((tm/2*tn+tn)*4)+(tm*tn>16384?256:0));
	pipe.InitBuffer(oq,1,ve*2);pipe.InitBuffer(zb,ve*4);
	pipe.InitBuffer(groupCache,(E*8+31)/32*32);
	GlobalTensor<int64_t> gg;gg.SetGlobalBuffer((__gm__ int64_t*)groups);
	DataCopyPad(groupCache.Get<int64_t>(),gg,{1,uint32_t(E*8),0,0,0},{true,0,0,int64_t(0)});
	auto ready=pipe.FetchEventID<HardEvent::MTE2_S>();
	SetFlag<HardEvent::MTE2_S>(ready);WaitFlag<HardEvent::MTE2_S>(ready);
    }
    int blockIdx=int(GetBlockIdx()),lane=0;
    if ASCEND_IS_AIV {lane=blockIdx&1;blockIdx/=2;}
    const int blockNum=int(GetBlockNum());
    const int nc=(N+tn-1)/tn;
    const int avgStride=N/nc/32*32;
    const int strideN=N-(nc-1)*avgStride>tn?avgStride+32:avgStride;
    static_assert(TileM==128,"Resident physical row capacity");
    // Use the real group sizes to compare the number and height of work
    // waves. Both row sizes fit the same physical 128-row resident buffer.
    int64_t tasks96=0,tasks128=0;
    int previous=0,largest=0;
    for(int expert=0;expert<E;++expert) {
        int last=0;
        if ASCEND_IS_AIC {last=int(((__gm__ int64_t*)groups)[expert]);}
        if ASCEND_IS_AIV {last=int(groupCache.Get<int64_t>().GetValue(expert));}
        
        const int size=last-previous;
        tasks96+=int64_t((size+95)/96)*nc;
        tasks128+=int64_t((size+127)/128)*nc;
        if(size>largest)largest=size;
        previous=last;
    }
    const int rows96=largest<96?(largest+15)/16*16:96;
    const int rows128=largest<128?(largest+15)/16*16:128;
    const int64_t score96=(tasks96+blockNum-1)/blockNum*(rows96);
    const int64_t score128=(tasks128+blockNum-1)/blockNum*(rows128);
    const bool choose128=score128<score96;
    const int rowTile=choose128?128:96;
    const int64_t totalTasks=choose128?tasks128:tasks96;
    const int64_t ownedBegin=totalTasks*blockIdx/blockNum;
    const int64_t ownedEnd=totalTasks*(blockIdx+1)/blockNum;
    int64_t taskOffset=0;
    int local=0,begin=0;
    for(int e=0;e<E;++e) {
	int end=0;
	if ASCEND_IS_AIC {end=int(((__gm__ int64_t*)groups)[e]);}
	if ASCEND_IS_AIV {end=int(groupCache.Get<int64_t>().GetValue(e));}
	
	const int me=end-begin,mt=(me+rowTile-1)/rowTile;
	const int64_t tasks=int64_t(mt)*nc;
	const int64_t first=ownedBegin>taskOffset?ownedBegin-taskOffset:0;
	const int64_t limit=ownedEnd-taskOffset<tasks?ownedEnd-taskOffset:tasks;
	for(int64_t task=first;task<limit;) {
	    const int mi=task/nc,niStart=task%nc;
	    const int row=begin+mi*rowTile,rows=end-row<rowTile?end-row:rowTile;
	    const int tiles=nc-niStart<limit-task?nc-niStart:int(limit-task);
	    if ASCEND_IS_AIC {
		SplitResidentLoadA<tm,ChunkRows,Compact>(a1[0],gx,row,rows,K,l1Used[0],l1Free[0],l1Ready[0],KCap);
		l1Used[0]=true;
		const int bs=local&1, col=niStart*strideN;
		const int cols=niStart+1==nc?N-col:strideN;
		if(bUsed[bs])WaitFlag<HardEvent::MTE1_MTE2>(bFree[bs]);
		GlobalPackedLoadB<ChunkK,Rotate>(b1[bs],gw,e,col,cols,K,N,KCap,bReady[bs]);
		bUsed[bs]=true;

	    }
	    for(int tile=0;tile<tiles;++tile) {
		const int ni=niStart+tile,col=ni*strideN;
		const int cols=ni+1==nc?N-col:strideN,pitch=(cols+31)/32*32;
		const int slot=local%OutputSlots;
		const uint16_t tileFlag=8+slot;
		const uint16_t freeFlag=12+slot;
		auto gcSlot=gc[int64_t(blockIdx*OutputSlots+slot)*tm*tn];
		if ASCEND_IS_AIC {
		    const int as=0;
		    const int bs=local&1;

		    if(tile+1<tiles) {
			const int next=bs^1,nextCol=(ni+1)*strideN;
			const int nextCols=ni+2==nc?N-nextCol:strideN;
			if(bUsed[next])WaitFlag<HardEvent::MTE1_MTE2>(bFree[next]);
			GlobalPackedLoadB<ChunkK,Rotate>(b1[next],gw,e,nextCol,nextCols,K,N,KCap,bReady[next]);
			bUsed[next]=true;

		    }

		    const int cs=local%CDepth;auto acc=accBuffer.Get<int32_t>()[cs*tm*tn];
            const int chunks=(K+ChunkK-1)/ChunkK;
            const int firstChunk=Rotate?blockIdx%chunks:0;
            int sub=0;
            for(int ci=0;ci<chunks;++ci) {
                WaitFlag<HardEvent::MTE2_MTE1>(bReady[bs][ci]);
                const int chunk=(firstChunk+ci)%chunks;
                const int endK=KCap<(chunk+1)*ChunkK?KCap:(chunk+1)*ChunkK;
                for(int offset=chunk*ChunkK;offset<endK;offset+=L0K,++sub) {
                    const int ls=sub%L0Slots,ck=endK-offset<L0K?endK-offset:L0K;
                    if(l0Used[ls])WaitFlag<HardEvent::M_MTE1>(l0Free[ls]);
                    SplitLoadL0<tm,L0K,Load3D,Compact>(a2[ls],b2[ls],a1[as],b1[bs],rows,pitch,offset,ck,KCap);
                    SetFlag<HardEvent::MTE1_M>(l0Ready[ls]);WaitFlag<HardEvent::MTE1_M>(l0Ready[ls]);
                    if(!sub && local>=CDepth)WaitFlag<HardEvent::FIX_M>(accumulatorFree[cs]);
                    MmadParams mad;
                    mad.m=(rows+15)/16*16;mad.n=pitch;mad.k=ck;mad.cmatrixInitVal=sub==0;
                    if constexpr(UnitFlag)mad.unitFlag=sub+1==(KCap+L0K-1)/L0K?3:2;
                    Mmad(acc,a2[ls],b2[ls],mad);
                    if((mad.m/16)*(mad.n/16)<10)PipeBarrier<PIPE_M>();
                    SetFlag<HardEvent::M_MTE1>(l0Free[ls]);l0Used[ls]=true;
                }
            }
		    SetFlag<HardEvent::MTE1_MTE2>(bFree[bs]);
		    if constexpr(!UnitFlag){SetFlag<HardEvent::M_FIX>(matrixReady);WaitFlag<HardEvent::M_FIX>(matrixReady);}
		    if(local>=OutputSlots)CrossCoreWaitFlag<2,PIPE_FIX>(freeFlag);
		    FixpipeParamsV220 fix;if constexpr(UnitFlag)fix.unitFlag=3;fix.nSize=pitch;fix.mSize=(rows+15)/16*16;fix.srcStride=fix.mSize;fix.dstStride=tn;
		    Fixpipe<int32_t,int32_t,CFG_ROW_MAJOR>(gcSlot,acc,fix);
		    SetFlag<HardEvent::FIX_M>(accumulatorFree[cs]);
		    CrossCoreSetFlag<2,PIPE_FIX>(tileFlag);
		}
					if ASCEND_IS_AIV
			{
			    CrossCoreWaitFlag<2, PIPE_MTE2>(tileFlag);
			    const int halfRows = (rows + 1) / 2;
			    const int rowOffset = lane * halfRows;
			    const int vectorRows = lane ? rows - halfRows : halfRows;
			    auto c = cq.AllocTensor<int32_t>();
			    auto scale = c.ReinterpretCast<float>()[((tm + 1) / 2 * tn) +
								    (tm * tn > 16384 ? 64 : 0)];

			    if (pitch != (cols + 7) / 8 * 8)
			    {
				Duplicate(c, int32_t(0), vectorRows * pitch);
				auto event = pipe.FetchEventID<HardEvent::V_MTE2>();
				SetFlag<HardEvent::V_MTE2>(event);
				WaitFlag<HardEvent::V_MTE2>(event);
			    }

			    if (vectorRows > 0)
				DataCopyPad(c, gcSlot[int64_t(rowOffset) * tn],
					    {uint16_t(vectorRows), uint32_t(cols * sizeof(int32_t)),
					     uint32_t((tn - cols) * sizeof(int32_t)),
					     uint32_t((pitch * 4 - (cols * 4 + 31) / 32 * 32) / 32),
					     0},
					    {true, 0, 0, 0});
			    if (cols < 64)
			    {
				Duplicate(scale, 0.0f, tn);
				auto initialized = pipe.FetchEventID<HardEvent::V_MTE2>();
				SetFlag<HardEvent::V_MTE2>(initialized);
				WaitFlag<HardEvent::V_MTE2>(initialized);
			    }
			    DataCopyPad(scale, gs[(int64_t)e * N + col],
					{1, (uint32_t)(cols * sizeof(float)), 0, 0, 0},
					{true, 0, 0, 0.0f});
			    cq.EnQue(c);
			    c = cq.DeQue<int32_t>();

			    CrossCoreSetFlag<2, PIPE_MTE2>(freeFlag);

			    auto z = zb.Get<float>();
			    auto p = c.ReinterpretCast<float>();
			    auto u = p;
			    auto t = p;

			    const BinaryRepeatParams bcast{
				1, 1, 1, (uint8_t)(pitch / 8), (uint8_t)(pitch / 8), 0};
			    for (int r = 0; r < vectorRows; r += vr)
			    {
				const int batch = (vectorRows - r < vr) ? (vectorRows - r) : vr;
				const uint32_t count = (uint32_t)batch * pitch;
				Cast(z, c[r * pitch], RoundMode::CAST_NONE, count);
				PipeBarrier<PIPE_V>();
				if (cols < 64)
				{
				    Mul(z, z, scale, (uint64_t)(pitch < 64 ? pitch : 64),
					(uint8_t)batch, bcast);
				}
				else
				{
				    for (int c0 = 0; c0 < cols; c0 += 64)
				    {
					const int chunk = (cols - c0 < 64) ? (cols - c0) : 64;
					Mul(z[c0], z[c0], scale[c0], (uint64_t)chunk,
					    (uint8_t)batch, bcast);
				    }
				}
				PipeBarrier<PIPE_V>();

				p = c[r * pitch].ReinterpretCast<float>();
				u = p;
				ResidentGelu(z,p,count);
				auto out = oq.AllocTensor<half>();
				Cast(out, z, RoundMode::CAST_RINT, count);
				oq.EnQue(out);
				out = oq.DeQue<half>();
				const uint32_t outBytes = (uint32_t)cols * (uint32_t)sizeof(half);
				const uint32_t outPitchBytes =
				    (uint32_t)pitch * (uint32_t)sizeof(half);
				const uint32_t outSrcStride =
				    (outPitchBytes - ((outBytes + 31U) / 32U) * 32U) / 32U;
				for (int r0 = 0; r0 < batch; r0 += 32)
				{
				    const int rc = batch - r0 < 32 ? batch - r0 : 32;
				    DataCopyPad(gy[(int64_t)(row + rowOffset + r + r0) * N + col],
						out[r0 * pitch],
						{(uint16_t)rc, outBytes, outSrcStride,
						 (uint32_t)((N - cols) * sizeof(half)), 0});
				}
				oq.FreeTensor(out);
			    }
			    cq.FreeTensor(c);
			}

		++local;
	    }
	    if ASCEND_IS_AIC {SetFlag<HardEvent::MTE1_MTE2>(l1Free[0]);}
	    task+=tiles;
	}
	taskOffset+=tasks;begin=end;
    }
    // The local TPipe destructor drains AIV queues and all pipelines.
    if ASCEND_IS_AIC {
	for(int i=0;i<OutputSlots;++i)if(local>i)CrossCoreWaitFlag<2,PIPE_MTE2>(12+i);
	for(int i=0;i<CDepth;++i)if(local>i)WaitFlag<HardEvent::FIX_M>(accumulatorFree[i]);
	for(int i=0;i<2;++i) {
	    if(bUsed[i])WaitFlag<HardEvent::MTE1_MTE2>(bFree[i]);
	    pipe.ReleaseEventID<HardEvent::MTE1_MTE2>(bFree[i]);
	    for(int j=0;j<3;++j)pipe.ReleaseEventID<HardEvent::MTE2_MTE1>(bReady[i][j]);
	}
#pragma unroll
	for(int i=0;i<1;++i) {
	    if(l1Used[i])WaitFlag<HardEvent::MTE1_MTE2>(l1Free[i]);
	    pipe.ReleaseEventID<HardEvent::MTE1_MTE2>(l1Free[i]);
	    pipe.ReleaseEventID<HardEvent::MTE2_MTE1>(l1Ready[i]);
	}
#pragma unroll
	for(int i=0;i<L0Slots;++i) {
	    if(l0Used[i])WaitFlag<HardEvent::M_MTE1>(l0Free[i]);
	    pipe.ReleaseEventID<HardEvent::M_MTE1>(l0Free[i]);
	    pipe.ReleaseEventID<HardEvent::MTE1_M>(l0Ready[i]);
	}
	for(int i=0;i<CDepth;++i)pipe.ReleaseEventID<HardEvent::FIX_M>(accumulatorFree[i]);
	pipe.ReleaseEventID<HardEvent::M_FIX>(matrixReady);
    }
}
template<int PrepareRows,bool WidePipeline=false>
__global__ __mix__(1,2) __schedmode__(1) void ActivePreparedResident(GMM_ARGUMENTS) {
    if constexpr(WidePipeline) {
        GM_ADDR wp=workspace+uint64_t(GetBlockNum())*4*128*128*4;
        gmm_coop::PrepareActiveCube<PrepareRows,2,0,false>(w,wp,M,K,N,E,groups);
        SyncAll<false>();
        ComputeAdaptive128<128,128,2,128,4,2,4,false,true,512,0,true,true>(x,wp,sc,groups,y,workspace,M,K,N,E);
    } else {
    GM_ADDR wp=workspace+uint64_t(GetBlockNum())*2*192*128*4;
    gmm_coop::PrepareActiveCube<PrepareRows,2,0,false>(w,wp,M,K,N,E,groups);
    SyncAll<false>();
    ComputeGloballyPackedSplit<192,128,2,64,4,1,2,false,true,512,0,true,true>(x,wp,sc,groups,y,workspace,M,K,N,E);

    }
}

}
static void LaunchActiveResident(uint32_t cores,aclrtStream stream,GMM_ARGUMENTS,bool widePipeline) {
    if(widePipeline)gmm_device::ActivePreparedResident<32,true><<<cores,nullptr,stream>>>(GMM_FORWARD);
    else gmm_device::ActivePreparedResident<32,false><<<cores,nullptr,stream>>>(GMM_FORWARD);
}
#undef GMM_ARGUMENTS
#undef GMM_FORWARD

#define GMM_ARGUMENTS GM_ADDR x,GM_ADDR w,GM_ADDR sc,GM_ADDR groups,GM_ADDR y,GM_ADDR workspace,int M,int K,int N,int E
#define GMM_FORWARD x,w,sc,groups,y,workspace,M,K,N,E
namespace gmm_expert {
using namespace AscendC;
__aicore__ inline void PrepareX(GM_ADDR x,GM_ADDR xp,int M,int K) {
    if ASCEND_IS_AIV {
        TPipe pipe;TBuf<TPosition::VECCALC> input,output;
        constexpr int TileRows=16, TileK=2048;
        pipe.InitBuffer(input,TileRows*TileK);pipe.InitBuffer(output,TileRows*TileK);
        auto packed=output.Get<int8_t>();
        const int kp=(K+63)/64*64,block=GetBlockIdx(),cores=GetBlockNum()*2;

	    // X uses [ceil(K/32), ceil(M/16)*16, 32], with aligned column slabs.
	    GlobalTensor<int8_t> gx,gxp;
	    gx.SetGlobalBuffer((__gm__ int8_t*)x);gxp.SetGlobalBuffer((__gm__ int8_t*)xp);
	    const int mp=(M+15)/16*16,kc=(kp+TileK-1)/TileK,mc=(mp+TileRows-1)/TileRows;
	    auto ub=input.Get<int8_t>();
	    bool xUsed=false;
	    for(int task=block;task<mc*kc;task+=cores) {
		const int row=task/kc*TileRows,col=task%kc*TileK;
		const int rows=mp-row<TileRows?mp-row:TileRows,cols=kp-col<TileK?kp-col:TileK;
		const int liveRows=M-row<rows?M-row:rows,liveCols=K-col<cols?K-col:cols;
		if(xUsed) {
		    auto free=pipe.FetchEventID<HardEvent::MTE3_MTE2>();
		    SetFlag<HardEvent::MTE3_MTE2>(free);WaitFlag<HardEvent::MTE3_MTE2>(free);
		}
		if(liveRows<rows || liveCols<cols) {
		    auto free=pipe.FetchEventID<HardEvent::MTE3_V>();
		    SetFlag<HardEvent::MTE3_V>(free);WaitFlag<HardEvent::MTE3_V>(free);
		    Duplicate(ub.ReinterpretCast<int32_t>(),int32_t(0),rows*cols/4);
		    auto zero=pipe.FetchEventID<HardEvent::V_MTE2>();
		    SetFlag<HardEvent::V_MTE2>(zero);WaitFlag<HardEvent::V_MTE2>(zero);
		}
		DataCopyPad(ub,gx[int64_t(row)*K+col],
		    {uint16_t(liveRows),uint32_t(liveCols),uint32_t(K-liveCols),
			uint32_t((cols-(liveCols+31)/32*32)/32),0},
		    {true,0,uint8_t((liveCols+31)/32*32-liveCols),int8_t(0)});
		auto loaded=pipe.FetchEventID<HardEvent::MTE2_V>();
		SetFlag<HardEvent::MTE2_V>(loaded);WaitFlag<HardEvent::MTE2_V>(loaded);
		auto free=pipe.FetchEventID<HardEvent::MTE3_V>();
		SetFlag<HardEvent::MTE3_V>(free);WaitFlag<HardEvent::MTE3_V>(free);
		for(int c=0;c<cols/32;++c)
		    DataCopy(packed[c*rows*32],ub[c*32],
			DataCopyParams{uint16_t(rows),1,uint16_t(cols/32-1),0});
		auto ready=pipe.FetchEventID<HardEvent::V_MTE3>();
		SetFlag<HardEvent::V_MTE3>(ready);WaitFlag<HardEvent::V_MTE3>(ready);
		DataCopy(gxp[int64_t(col)*mp+row*32],packed,
		    DataCopyParams{uint16_t(cols/32),uint16_t(rows),0,uint16_t(mp-rows)});
		xUsed=true;
	    }
        PipeBarrier<PIPE_ALL>();
    }
}
}
namespace gmm_device {
template<int Rows,int Fold>
__global__ __mix__(1,2) void ActivePreparedBoth(GMM_ARGUMENTS,uint32_t halfL1) {
    AscendC::tiling::TCubeTiling unused{};
    GM_ADDR xp=workspace+uint64_t(GetBlockNum())*262144;
    GM_ADDR wp=xp+uint64_t((M+15)/16*16)*((K+63)/64*64);
    gmm_coop::PrepareActiveCube<Rows,Fold,0,false>(w,wp,M,K,N,E,groups);
    gmm_expert::PrepareX(x,xp,M,K);
    SyncAll<false>();
    // Evaluate actual group lengths on Device. Shape-derived averages never
    // determine expert ownership or replace the input group_list.
    int previous=0;
    int64_t rows96=0,rows128=0;
    for(int e=0;e<E;++e) {
        const int end=int(((__gm__ int64_t*)groups)[e]);
        const int rows=end-previous;
        rows96+=(rows+95)/96;rows128+=(rows+127)/128;previous=end;
    }
    const int nc=(N+191)/192,cores=int(GetBlockNum());
    const int64_t waves96=(rows96*nc+cores-1)/cores;
    const int64_t waves128=(rows128*nc+cores-1)/cores;
    if(waves96*96>waves128*128)
        ComputeTransportNZ<128,192,768>(xp,wp,sc,groups,y,workspace,M,K,N,E,unused,halfL1);
    else ComputeTransportNZ<96,192,896>(xp,wp,sc,groups,y,workspace,M,K,N,E,unused,halfL1);
}
__aicore__ inline void ComputeRSCandidate(GMM_ARGUMENTS);
template<int Rows,int Fold,bool Buffered>
__global__ __mix__(1,2) void ActivePreparedWeightResident(GMM_ARGUMENTS,uint32_t halfL1) {
    GM_ADDR wp=workspace+uint64_t(GetBlockNum())*196608;
    gmm_coop::PrepareActiveCube<32,2,0,false>(w,wp,M,K,N,E,groups);
    SyncAll<false>();
    ComputeRSCandidate(x,wp,sc,groups,y,workspace,M,K,N,E);
}
}
static void LaunchActivePacked(bool both,bool buffered,uint32_t cores,aclrtStream stream,GMM_ARGUMENTS,uint32_t halfL1) {
    if(both)gmm_device::ActivePreparedBoth<128,2><<<cores,nullptr,stream>>>(GMM_FORWARD,halfL1);
    else if(buffered)gmm_device::ActivePreparedWeightResident<32,2,true><<<cores,nullptr,stream>>>(GMM_FORWARD,halfL1);
    else gmm_device::ActivePreparedWeightResident<32,2,false><<<cores,nullptr,stream>>>(GMM_FORWARD,halfL1);
}
#undef GMM_ARGUMENTS
#undef GMM_FORWARD

#define GMM_ARGUMENTS GM_ADDR x,GM_ADDR w,GM_ADDR sc,GM_ADDR groups,GM_ADDR y,GM_ADDR workspace,int M,int K,int N,int E
#define GMM_FORWARD x,w,sc,groups,y,workspace,M,K,N,E
namespace gmm_device {
template<int TM,int TN,int Fold,int ADepth,int BDepth,int CDepth,int OutputSlots,
	 int Order,int Balance,int L0Slots,int L0K,bool FullB=false,bool Reuse=true,bool Prepared=false>
__aicore__ inline void ComputePreparedFullB(
    GM_ADDR x,GM_ADDR w,GM_ADDR sc,GM_ADDR groups,GM_ADDR y,GM_ADDR workspace,
    int M,int K,int N,int E)
{
    static_assert(ADepth>=1 && ADepth<=2 && BDepth>=1 && BDepth<=2);
    static_assert(OutputSlots>=2 && OutputSlots<=4);
    static_assert(TM*TN*4*CDepth<=131072);
    static_assert(TM*L0K*L0Slots<=65536 && TN*L0K*L0Slots<=65536);
    const int KCap=(K+L0K-1)/L0K*L0K;
    constexpr int tm=TM,tn=TN,vr=8192/TN,ve=(vr*TN+63)/64*64;
    TPipe pipe;
    GlobalTensor<int8_t> gx,gw;
    GlobalTensor<float> gs;
    GlobalTensor<int32_t> gc;
    GlobalTensor<half> gy;
    gx.SetGlobalBuffer((__gm__ int8_t*)x);gw.SetGlobalBuffer((__gm__ int8_t*)w);
    gs.SetGlobalBuffer((__gm__ float*)sc);gc.SetGlobalBuffer((__gm__ int32_t*)workspace);
    gy.SetGlobalBuffer((__gm__ half*)y);
    TBuf<TPosition::A1> a1Buffer[ADepth];
    TBuf<TPosition::B1> b1Buffer[BDepth];
    TBuf<TPosition::A2> a2Buffer;
    TBuf<TPosition::B2> b2Buffer;
    TBuf<TPosition::CO1> accBuffer;
    LocalTensor<int8_t> a1[ADepth],b1[BDepth],a2[L0Slots],b2[L0Slots];
    uint8_t aFree[ADepth],aReady[ADepth],bFree[BDepth],bReady[BDepth];
    uint8_t l0Free[L0Slots],l0Ready[L0Slots],accFree[CDepth],matrixReady;
    bool aUsed[ADepth]={},bUsed[BDepth]={},l0Used[L0Slots]={};
    if ASCEND_IS_AIC {
	for(int i=0;i<ADepth;++i) {
	    pipe.InitBuffer(a1Buffer[i],tm*KCap);a1[i]=a1Buffer[i].template Get<int8_t>();
	    aFree[i]=pipe.AllocEventID<HardEvent::MTE1_MTE2>();
	    aReady[i]=pipe.AllocEventID<HardEvent::MTE2_MTE1>();
	}
	for(int i=0;i<BDepth;++i) {
	    pipe.InitBuffer(b1Buffer[i],(FullB?(N+31)/32*32:tn)*KCap);
	    b1[i]=b1Buffer[i].template Get<int8_t>();
	    bFree[i]=pipe.AllocEventID<HardEvent::MTE1_MTE2>();
	    bReady[i]=pipe.AllocEventID<HardEvent::MTE2_MTE1>();
	}
	pipe.InitBuffer(a2Buffer,L0Slots*tm*L0K);pipe.InitBuffer(b2Buffer,L0Slots*tn*L0K);
	for(int i=0;i<L0Slots;++i) {
	    a2[i]=a2Buffer.Get<int8_t>()[i*tm*L0K];b2[i]=b2Buffer.Get<int8_t>()[i*tn*L0K];
	    l0Free[i]=pipe.AllocEventID<HardEvent::M_MTE1>();
	    l0Ready[i]=pipe.AllocEventID<HardEvent::MTE1_M>();
	}
	pipe.InitBuffer(accBuffer,CDepth*tm*tn*4);
	for(int i=0;i<CDepth;++i)accFree[i]=pipe.AllocEventID<HardEvent::FIX_M>();
	matrixReady=pipe.AllocEventID<HardEvent::M_FIX>();
    }
    TQue<TPosition::VECIN,1> cq;
    TQue<TPosition::VECOUT,1> oq;
    TBuf<TPosition::VECCALC> zb,groupCache;
    if ASCEND_IS_AIV {
	pipe.InitBuffer(cq,1,uint32_t((tm/2*tn+tn)*4)+(tm*tn>16384?256:0));
	pipe.InitBuffer(oq,1,ve*2);pipe.InitBuffer(zb,ve*4);
	pipe.InitBuffer(groupCache,(E*8+31)/32*32);
	GlobalTensor<int64_t> gg;gg.SetGlobalBuffer((__gm__ int64_t*)groups);
	DataCopyPad(groupCache.Get<int64_t>(),gg,{1,uint32_t(E*8),0,0,0},{true,0,0,int64_t(0)});
	auto ready=pipe.FetchEventID<HardEvent::MTE2_S>();
	SetFlag<HardEvent::MTE2_S>(ready);WaitFlag<HardEvent::MTE2_S>(ready);
    }
    int blockIdx=int(GetBlockIdx()),lane=0;
    if ASCEND_IS_AIV {lane=blockIdx&1;blockIdx/=2;}
    const int blockNum=int(GetBlockNum()),nc=(N+tn-1)/tn,nUnits=(N+31)/32;
    int64_t totalTasks=0;
    int previous=0;
    for(int e=0;e<E;++e) {
	int end=0;
	if ASCEND_IS_AIC {end=int(((__gm__ int64_t*)groups)[e]);}
	if ASCEND_IS_AIV {end=int(groupCache.Get<int64_t>().GetValue(e));}
	if(end<previous)end=previous;if(end>M)end=M;
	totalTasks+=int64_t((end-previous+tm-1)/tm)*nc;previous=end;
    }
    const int64_t ownedBegin=totalTasks*blockIdx/blockNum,ownedEnd=totalTasks*(blockIdx+1)/blockNum;
    int64_t taskOffset=0;
    int local=0,begin=0;
    for(int e=0;e<E;++e) {
	int end=0;
	if ASCEND_IS_AIC {end=int(((__gm__ int64_t*)groups)[e]);}
	if ASCEND_IS_AIV {end=int(groupCache.Get<int64_t>().GetValue(e));}
	if(end<begin)end=begin;if(end>M)end=M;
	const int mt=(end-begin+tm-1)/tm;
	const int64_t tasks=int64_t(mt)*nc;
	const int64_t first=ownedBegin>taskOffset?ownedBegin-taskOffset:0;
	const int64_t limit=ownedEnd-taskOffset<tasks?ownedEnd-taskOffset:tasks;
	int as=0,bs=0;
	bool freshA=true,freshB=true;
	for(int64_t task=first;task<limit;++task) {
	    const int mi=Order?task%mt:task/nc,ni=Order?task/mt:task%nc;
	    const int row=begin+mi*tm,rows=end-row<tm?end-row:tm;
	    const int col=Balance?(ni*nUnits/nc)*32:ni*tn;
	    const int colEnd=Balance?((ni+1)*nUnits/nc)*32:col+tn;
	    const int cols=(colEnd<N?colEnd:N)-col,pitch=(cols+31)/32*32;
	    const bool next=task+1<limit;
	    const int nextM=next?(Order?(task+1)%mt:(task+1)/nc):mi;
	    const int nextN=next?(Order?(task+1)/mt:(task+1)%nc):ni;
	    const bool changeA=!next || !Reuse || nextM!=mi;
	    const bool changeB=!next || (!FullB && (!Reuse || nextN!=ni));
	    const int nas=(ADepth==2 && changeA)?as^1:as;
	    const int nbs=(BDepth==2 && changeB)?bs^1:bs;
	    const int slot=local%OutputSlots;
	    const uint16_t tileFlag=8+slot,freeFlag=12+slot;
	    auto gcSlot=gc[int64_t(blockIdx*OutputSlots+slot)*tm*tn];
	    if ASCEND_IS_AIC {
		if(freshA && (task==first || ADepth==1)) {
		    ResidentLoadA<tm>(a1[as],gx,row,rows,K,aUsed[as],aFree[as],aReady[as],KCap);
		    aUsed[as]=true;SetFlag<HardEvent::MTE2_MTE1>(aReady[as]);
		}
		if(freshB && (task==first || BDepth==1)) {
		    if(bUsed[bs])WaitFlag<HardEvent::MTE1_MTE2>(bFree[bs]);
		    if constexpr(Prepared) PackedResidentLoadB(b1[bs],gw,e,FullB?0:col,FullB?N:cols,K,N,KCap);
		    else ResidentLoadB<tm,tn,Fold>(b1[bs],gw,e,FullB?0:col,FullB?N:cols,K,N,KCap);
		    bUsed[bs]=true;SetFlag<HardEvent::MTE2_MTE1>(bReady[bs]);
		}
		if(freshA)WaitFlag<HardEvent::MTE2_MTE1>(aReady[as]);
		if(freshB)WaitFlag<HardEvent::MTE2_MTE1>(bReady[bs]);
		// Prefetch real future tiles while MTE1/Cube consume disjoint current slots.
		if(next && changeB && BDepth==2) {
		    const int ncol=Balance?(nextN*nUnits/nc)*32:nextN*tn;
		    const int nend=Balance?((nextN+1)*nUnits/nc)*32:ncol+tn;
		    if(bUsed[nbs])WaitFlag<HardEvent::MTE1_MTE2>(bFree[nbs]);
		    if constexpr(Prepared) PackedResidentLoadB(b1[nbs],gw,e,ncol,(nend<N?nend:N)-ncol,K,N,KCap);
		    else ResidentLoadB<tm,tn,Fold>(b1[nbs],gw,e,ncol,(nend<N?nend:N)-ncol,K,N,KCap);
		    bUsed[nbs]=true;SetFlag<HardEvent::MTE2_MTE1>(bReady[nbs]);
		}
		if(next && changeA && ADepth==2) {
		    const int nrow=begin+nextM*tm,nrows=end-nrow<tm?end-nrow:tm;
		    ResidentLoadA<tm>(a1[nas],gx,nrow,nrows,K,aUsed[nas],aFree[nas],aReady[nas],KCap);
		    aUsed[nas]=true;SetFlag<HardEvent::MTE2_MTE1>(aReady[nas]);
		}
		const int cs=local%CDepth;
		auto acc=accBuffer.Get<int32_t>()[cs*tm*tn];
		for(int sub=0;sub<KCap/L0K;++sub) {
		    const int ls=sub%L0Slots;
		    if(l0Used[ls])WaitFlag<HardEvent::M_MTE1>(l0Free[ls]);
		    LoadData2dParams la;la.repeatTimes=(rows+15)/16;la.srcStride=1;
		    la.dstGap=L0K/32-1;la.ifTranspose=false;
		    LoadData2dTransposeParams lb{0,uint8_t(pitch/32),uint16_t(KCap/32),1,0,0};
#pragma unroll
		    for(int ki=0;ki<L0K/32;++ki) {
			LoadData(a2[ls][ki*512],a1[as][(sub*(L0K/32)+ki)*tm*32],la);
			LoadDataWithTranspose(b2[ls][ki*pitch*32],
			    b1[bs][(FullB?col*KCap:0)+(sub*(L0K/32)+ki)*1024],lb);
		    }
		    SetFlag<HardEvent::MTE1_M>(l0Ready[ls]);WaitFlag<HardEvent::MTE1_M>(l0Ready[ls]);
		    if(!sub && local>=CDepth)WaitFlag<HardEvent::FIX_M>(accFree[cs]);
		    MmadParams mad;mad.m=(rows+15)/16*16;mad.n=pitch;mad.k=L0K;mad.cmatrixInitVal=sub==0;
		    Mmad(acc,a2[ls],b2[ls],mad);
		    if((mad.m/16)*(mad.n/16)<10)PipeBarrier<PIPE_M>();
		    SetFlag<HardEvent::M_MTE1>(l0Free[ls]);l0Used[ls]=true;
		}
		if(changeA)SetFlag<HardEvent::MTE1_MTE2>(aFree[as]);
		if(changeB)SetFlag<HardEvent::MTE1_MTE2>(bFree[bs]);
		SetFlag<HardEvent::M_FIX>(matrixReady);WaitFlag<HardEvent::M_FIX>(matrixReady);
		if(local>=OutputSlots)CrossCoreWaitFlag<2,PIPE_FIX>(freeFlag);
		FixpipeParamsV220 fix;fix.nSize=pitch;fix.mSize=(rows+15)/16*16;
		fix.srcStride=fix.mSize;fix.dstStride=tn;
		Fixpipe<int32_t,int32_t,CFG_ROW_MAJOR>(gcSlot,acc,fix);
		SetFlag<HardEvent::FIX_M>(accFree[cs]);CrossCoreSetFlag<2,PIPE_FIX>(tileFlag);
	    }
						    if ASCEND_IS_AIV
			{
			    CrossCoreWaitFlag<2, PIPE_MTE2>(tileFlag);
			    const int halfRows = (rows + 1) / 2;
			    const int rowOffset = lane * halfRows;
			    const int vectorRows = lane ? rows - halfRows : halfRows;
			    auto c = cq.AllocTensor<int32_t>();
			    auto scale = c.ReinterpretCast<float>()[((tm + 1) / 2 * tn) +
								    (tm * tn > 16384 ? 64 : 0)];

			    if (pitch != (cols + 7) / 8 * 8)
			    {
				Duplicate(c, int32_t(0), vectorRows * pitch);
				auto event = pipe.FetchEventID<HardEvent::V_MTE2>();
				SetFlag<HardEvent::V_MTE2>(event);
				WaitFlag<HardEvent::V_MTE2>(event);
			    }

			    if (vectorRows > 0)
				DataCopyPad(c, gcSlot[int64_t(rowOffset) * tn],
					    {uint16_t(vectorRows), uint32_t(cols * sizeof(int32_t)),
					     uint32_t((tn - cols) * sizeof(int32_t)),
					     uint32_t((pitch * 4 - (cols * 4 + 31) / 32 * 32) / 32),
					     0},
					    {true, 0, 0, 0});
			    if (cols < 64)
			    {
				Duplicate(scale, 0.0f, tn);
				auto initialized = pipe.FetchEventID<HardEvent::V_MTE2>();
				SetFlag<HardEvent::V_MTE2>(initialized);
				WaitFlag<HardEvent::V_MTE2>(initialized);
			    }
			    DataCopyPad(scale, gs[(int64_t)e * N + col],
					{1, (uint32_t)(cols * sizeof(float)), 0, 0, 0},
					{true, 0, 0, 0.0f});
			    cq.EnQue(c);
			    c = cq.DeQue<int32_t>();

			    CrossCoreSetFlag<2, PIPE_MTE2>(freeFlag);

			    auto z = zb.Get<float>();
			    auto p = c.ReinterpretCast<float>();
			    auto u = p;
			    auto t = p;

			    const BinaryRepeatParams bcast{
				1, 1, 1, (uint8_t)(pitch / 8), (uint8_t)(pitch / 8), 0};
			    for (int r = 0; r < vectorRows; r += vr)
			    {
				const int batch = (vectorRows - r < vr) ? (vectorRows - r) : vr;
				const uint32_t count = (uint32_t)batch * pitch;
				Cast(z, c[r * pitch], RoundMode::CAST_NONE, count);
				PipeBarrier<PIPE_V>();
				if (cols < 64)
				{
				    Mul(z, z, scale, (uint64_t)(pitch < 64 ? pitch : 64),
					(uint8_t)batch, bcast);
				}
				else
				{
				    for (int c0 = 0; c0 < cols; c0 += 64)
				    {
					const int chunk = (cols - c0 < 64) ? (cols - c0) : 64;
					Mul(z[c0], z[c0], scale[c0], (uint64_t)chunk,
					    (uint8_t)batch, bcast);
				    }
				}
				PipeBarrier<PIPE_V>();

				p = c[r * pitch].ReinterpretCast<float>();
				u = p;
				ResidentGelu(z,p,count);
				auto out = oq.AllocTensor<half>();
				Cast(out, z, RoundMode::CAST_RINT, count);
				oq.EnQue(out);
				out = oq.DeQue<half>();
				const uint32_t outBytes = (uint32_t)cols * (uint32_t)sizeof(half);
				const uint32_t outPitchBytes =
				    (uint32_t)pitch * (uint32_t)sizeof(half);
				const uint32_t outSrcStride =
				    (outPitchBytes - ((outBytes + 31U) / 32U) * 32U) / 32U;
				for (int r0 = 0; r0 < batch; r0 += 32)
				{
				    const int rc = batch - r0 < 32 ? batch - r0 : 32;
				    DataCopyPad(gy[(int64_t)(row + rowOffset + r + r0) * N + col],
						out[r0 * pitch],
						{(uint16_t)rc, outBytes, outSrcStride,
						 (uint32_t)((N - cols) * sizeof(half)), 0});
				}
				oq.FreeTensor(out);
			    }
			    cq.FreeTensor(c);
			}

	    as=nas;bs=nbs;freshA=changeA;freshB=changeB;++local;
	}
	taskOffset+=tasks;begin=end;
    }
    if ASCEND_IS_AIV {PipeBarrier<PIPE_ALL>();}
    if ASCEND_IS_AIC {
	for(int i=0;i<OutputSlots;++i)if(local>i)CrossCoreWaitFlag<2,PIPE_MTE2>(12+i);
	for(int i=0;i<CDepth;++i) {
	    if(local>i)WaitFlag<HardEvent::FIX_M>(accFree[i]);
	    pipe.ReleaseEventID<HardEvent::FIX_M>(accFree[i]);
	}
	for(int i=0;i<ADepth;++i) {
	    if(aUsed[i])WaitFlag<HardEvent::MTE1_MTE2>(aFree[i]);
	    pipe.ReleaseEventID<HardEvent::MTE1_MTE2>(aFree[i]);
	    pipe.ReleaseEventID<HardEvent::MTE2_MTE1>(aReady[i]);
	}
	for(int i=0;i<BDepth;++i) {
	    if(bUsed[i])WaitFlag<HardEvent::MTE1_MTE2>(bFree[i]);
	    pipe.ReleaseEventID<HardEvent::MTE1_MTE2>(bFree[i]);
	    pipe.ReleaseEventID<HardEvent::MTE2_MTE1>(bReady[i]);
	}
	for(int i=0;i<L0Slots;++i) {
	    if(l0Used[i])WaitFlag<HardEvent::M_MTE1>(l0Free[i]);
	    pipe.ReleaseEventID<HardEvent::M_MTE1>(l0Free[i]);
	    pipe.ReleaseEventID<HardEvent::MTE1_M>(l0Ready[i]);
	}
	pipe.ReleaseEventID<HardEvent::M_FIX>(matrixReady);
    }
}
}
namespace gmm_device {
template<int TM,int Fold>
__aicore__ inline void FoldedLoadA(LocalTensor<int8_t> a,GlobalTensor<int8_t> x,
    int row,int rows,int K,bool reused,uint8_t freeId,uint8_t readyId,int KCap)
{
    if(reused)WaitFlag<HardEvent::MTE1_MTE2>(freeId);
    if(K%64) {
	Fill(a[(K/32)*TM*32].template ReinterpretCast<uint32_t>(),
	    InitConstValueParams<uint32_t>(1,TM*(KCap-K/32*32)/32,0,0));
	PipeBarrier<PIPE_MTE2>();
    }
    Nd2NzParams p;
    p.ndNum=1;p.nValue=rows;p.dValue=K;p.srcNdMatrixStride=0;
    p.srcDValue=K;p.dstNzC0Stride=TM;p.dstNzNStride=1;p.dstNzMatrixStride=0;
    if constexpr(Fold>1)if(rows%Fold==0){p.ndNum=Fold;p.nValue=rows/Fold;p.srcNdMatrixStride=K;p.srcDValue=K*Fold;p.dstNzNStride=Fold;p.dstNzMatrixStride=32;}
DataCopy(a,x[int64_t(row)*K],p);
    // Readiness is signalled after the following B load.
}
template<int TM,int TN,int Fold,int ADepth,int BDepth,int CDepth,int OutputSlots,
	 int Order,int Balance,int L0Slots,int L0K,bool FullB=false,bool Reuse=true,bool Prepared=false,bool A3D=false,int VCapacity=8192,int RowCopy=32,int AFold=1>
__aicore__ inline void ComputeFullFinalHA(
    GM_ADDR x,GM_ADDR w,GM_ADDR sc,GM_ADDR groups,GM_ADDR y,GM_ADDR workspace,
    int M,int K,int N,int E)
{
    static_assert(ADepth>=1 && ADepth<=2 && BDepth>=1 && BDepth<=2);
    static_assert(OutputSlots>=2 && OutputSlots<=4);
    static_assert(TM*TN*4*CDepth<=131072);
    static_assert(TM*L0K*L0Slots<=65536 && TN*L0K*L0Slots<=65536);
    const int KCap=(K+L0K-1)/L0K*L0K;
    constexpr int tm=TM,tn=TN,vr=VCapacity/TN,ve=(vr*TN+63)/64*64;
    TPipe pipe;
    GlobalTensor<int8_t> gx,gw;
    GlobalTensor<float> gs;
    GlobalTensor<int32_t> gc;
    GlobalTensor<half> gy;
    gx.SetGlobalBuffer((__gm__ int8_t*)x);gw.SetGlobalBuffer((__gm__ int8_t*)w);
    gs.SetGlobalBuffer((__gm__ float*)sc);gc.SetGlobalBuffer((__gm__ int32_t*)workspace);
    gy.SetGlobalBuffer((__gm__ half*)y);
    TBuf<TPosition::A1> a1Buffer[ADepth];
    TBuf<TPosition::B1> b1Buffer[BDepth];
    TBuf<TPosition::A2> a2Buffer;
    TBuf<TPosition::B2> b2Buffer;
    TBuf<TPosition::CO1> accBuffer;
    LocalTensor<int8_t> a1[ADepth],b1[BDepth],a2[L0Slots],b2[L0Slots];
    uint8_t aFree[ADepth],aReady[ADepth],bFree[BDepth],bReady[BDepth];
    uint8_t l0Free[L0Slots],l0Ready[L0Slots],accFree[CDepth],matrixReady;
    bool aUsed[ADepth]={},bUsed[BDepth]={},l0Used[L0Slots]={};
    if ASCEND_IS_AIC {
	for(int i=0;i<ADepth;++i) {
	    pipe.InitBuffer(a1Buffer[i],tm*KCap);a1[i]=a1Buffer[i].template Get<int8_t>();
	    aFree[i]=pipe.AllocEventID<HardEvent::MTE1_MTE2>();
	    aReady[i]=pipe.AllocEventID<HardEvent::MTE2_MTE1>();
	}
	for(int i=0;i<BDepth;++i) {
	    pipe.InitBuffer(b1Buffer[i],(FullB?(N+31)/32*32:tn)*KCap);
	    b1[i]=b1Buffer[i].template Get<int8_t>();
	    bFree[i]=pipe.AllocEventID<HardEvent::MTE1_MTE2>();
	    bReady[i]=pipe.AllocEventID<HardEvent::MTE2_MTE1>();
	}
	pipe.InitBuffer(a2Buffer,L0Slots*tm*L0K);pipe.InitBuffer(b2Buffer,L0Slots*tn*L0K);
	for(int i=0;i<L0Slots;++i) {
	    a2[i]=a2Buffer.Get<int8_t>()[i*tm*L0K];b2[i]=b2Buffer.Get<int8_t>()[i*tn*L0K];
	    l0Free[i]=pipe.AllocEventID<HardEvent::M_MTE1>();
	    l0Ready[i]=pipe.AllocEventID<HardEvent::MTE1_M>();
	}
	pipe.InitBuffer(accBuffer,CDepth*tm*tn*4);
 if constexpr(A3D){const uint8_t pads[4]={};SetFmatrix(1,tm,pads,FmatrixMode::FMATRIX_LEFT);}
	for(int i=0;i<CDepth;++i)accFree[i]=pipe.AllocEventID<HardEvent::FIX_M>();
	matrixReady=pipe.AllocEventID<HardEvent::M_FIX>();
    }
    TQue<TPosition::VECIN,1> cq;
    TQue<TPosition::VECOUT,1> oq;
    TBuf<TPosition::VECCALC> zb,groupCache;
    if ASCEND_IS_AIV {
	pipe.InitBuffer(cq,1,uint32_t((tm/2*tn+tn)*4)+(tm*tn>16384?256:0));
	pipe.InitBuffer(oq,1,ve*2);pipe.InitBuffer(zb,ve*4);
	pipe.InitBuffer(groupCache,(E*8+31)/32*32);
	GlobalTensor<int64_t> gg;gg.SetGlobalBuffer((__gm__ int64_t*)groups);
	DataCopyPad(groupCache.Get<int64_t>(),gg,{1,uint32_t(E*8),0,0,0},{true,0,0,int64_t(0)});
	auto ready=pipe.FetchEventID<HardEvent::MTE2_S>();
	SetFlag<HardEvent::MTE2_S>(ready);WaitFlag<HardEvent::MTE2_S>(ready);
    }
    int blockIdx=int(GetBlockIdx()),lane=0;
    if ASCEND_IS_AIV {lane=blockIdx&1;blockIdx/=2;}
    const int blockNum=int(GetBlockNum()),nc=(N+tn-1)/tn,nUnits=(N+31)/32;
    int64_t totalTasks=0;
    int previous=0;
    for(int e=0;e<E;++e) {
	int end=0;
	if ASCEND_IS_AIC {end=int(((__gm__ int64_t*)groups)[e]);}
	if ASCEND_IS_AIV {end=int(groupCache.Get<int64_t>().GetValue(e));}
	if(end<previous)end=previous;if(end>M)end=M;
	totalTasks+=int64_t((end-previous+tm-1)/tm)*nc;previous=end;
    }
    const int64_t ownedBegin=totalTasks*blockIdx/blockNum,ownedEnd=totalTasks*(blockIdx+1)/blockNum;
    int64_t taskOffset=0;
    int local=0,begin=0;
    for(int e=0;e<E;++e) {
	int end=0;
	if ASCEND_IS_AIC {end=int(((__gm__ int64_t*)groups)[e]);}
	if ASCEND_IS_AIV {end=int(groupCache.Get<int64_t>().GetValue(e));}
	if(end<begin)end=begin;if(end>M)end=M;
	const int mt=(end-begin+tm-1)/tm;
	const int64_t tasks=int64_t(mt)*nc;
	const int64_t first=ownedBegin>taskOffset?ownedBegin-taskOffset:0;
	const int64_t limit=ownedEnd-taskOffset<tasks?ownedEnd-taskOffset:tasks;
	int as=0,bs=0;
	bool freshA=true,freshB=true;
	for(int64_t task=first;task<limit;++task) {
	    const int mi=Order?task%mt:task/nc,ni=Order?task/mt:task%nc;
	    const int row=begin+mi*tm,rows=end-row<tm?end-row:tm;
	    const int col=Balance?(ni*nUnits/nc)*32:ni*tn;
	    const int colEnd=Balance?((ni+1)*nUnits/nc)*32:col+tn;
	    const int cols=(colEnd<N?colEnd:N)-col,pitch=(cols+31)/32*32;
	    const bool next=task+1<limit;
	    const int nextM=next?(Order?(task+1)%mt:(task+1)/nc):mi;
	    const int nextN=next?(Order?(task+1)/mt:(task+1)%nc):ni;
	    const bool changeA=!next || !Reuse || nextM!=mi;
	    const bool changeB=!next || (!FullB && (!Reuse || nextN!=ni));
	    const int nas=(ADepth==2 && changeA)?as^1:as;
	    const int nbs=(BDepth==2 && changeB)?bs^1:bs;
	    const int slot=local%OutputSlots;
	    const uint16_t tileFlag=8+slot,freeFlag=12+slot;
	    auto gcSlot=gc[int64_t(blockIdx*OutputSlots+slot)*tm*tn];
	    if ASCEND_IS_AIC {
		if(freshA && (task==first || ADepth==1)) {
		    FoldedLoadA<tm,AFold>(a1[as],gx,row,rows,K,aUsed[as],aFree[as],aReady[as],KCap);
		    aUsed[as]=true;SetFlag<HardEvent::MTE2_MTE1>(aReady[as]);
		}
		if(freshB && (task==first || BDepth==1)) {
		    if(bUsed[bs])WaitFlag<HardEvent::MTE1_MTE2>(bFree[bs]);
		    if constexpr(Prepared) PackedResidentLoadB(b1[bs],gw,e,FullB?0:col,FullB?N:cols,K,N,KCap);
		    else ResidentLoadB<tm,tn,Fold>(b1[bs],gw,e,FullB?0:col,FullB?N:cols,K,N,KCap);
		    bUsed[bs]=true;SetFlag<HardEvent::MTE2_MTE1>(bReady[bs]);
		}
		if(freshA)WaitFlag<HardEvent::MTE2_MTE1>(aReady[as]);
		if(freshB)WaitFlag<HardEvent::MTE2_MTE1>(bReady[bs]);
		// Prefetch real future tiles while MTE1/Cube consume disjoint current slots.
		if(next && changeB && BDepth==2) {
		    const int ncol=Balance?(nextN*nUnits/nc)*32:nextN*tn;
		    const int nend=Balance?((nextN+1)*nUnits/nc)*32:ncol+tn;
		    if(bUsed[nbs])WaitFlag<HardEvent::MTE1_MTE2>(bFree[nbs]);
		    if constexpr(Prepared) PackedResidentLoadB(b1[nbs],gw,e,ncol,(nend<N?nend:N)-ncol,K,N,KCap);
		    else ResidentLoadB<tm,tn,Fold>(b1[nbs],gw,e,ncol,(nend<N?nend:N)-ncol,K,N,KCap);
		    bUsed[nbs]=true;SetFlag<HardEvent::MTE2_MTE1>(bReady[nbs]);
		}
		if(next && changeA && ADepth==2) {
		    const int nrow=begin+nextM*tm,nrows=end-nrow<tm?end-nrow:tm;
		    FoldedLoadA<tm,AFold>(a1[nas],gx,nrow,nrows,K,aUsed[nas],aFree[nas],aReady[nas],KCap);
		    aUsed[nas]=true;SetFlag<HardEvent::MTE2_MTE1>(aReady[nas]);
		}
		const int cs=local%CDepth;
		auto acc=accBuffer.Get<int32_t>()[cs*tm*tn];
		for(int sub=0;sub<KCap/L0K;++sub) {
		    const int ls=sub%L0Slots;
		    if(l0Used[ls])WaitFlag<HardEvent::M_MTE1>(l0Free[ls]);
		    if constexpr(A3D){LoadData3DParamsV2Pro p;p.channelSize=KCap;
p.extConfig=(uint64_t(sub*L0K)<<32)|(uint64_t((rows+15)/16*16)<<16)|uint64_t(L0K);LoadData(a2[ls],a1[as],p);}
LoadData2dParams la;la.repeatTimes=(rows+15)/16;la.srcStride=1;
		    la.dstGap=L0K/32-1;la.ifTranspose=false;
		    LoadData2dTransposeParams lb{0,uint8_t(pitch/32),uint16_t(KCap/32),1,0,0};
#pragma unroll
		    for(int ki=0;ki<L0K/32;++ki) {
			if constexpr(!A3D) LoadData(a2[ls][ki*512],a1[as][(sub*(L0K/32)+ki)*tm*32],la);
			LoadDataWithTranspose(b2[ls][ki*pitch*32],
			    b1[bs][(FullB?col*KCap:0)+(sub*(L0K/32)+ki)*1024],lb);
		    }
		    SetFlag<HardEvent::MTE1_M>(l0Ready[ls]);WaitFlag<HardEvent::MTE1_M>(l0Ready[ls]);
		    if(!sub && local>=CDepth)WaitFlag<HardEvent::FIX_M>(accFree[cs]);
		    MmadParams mad;mad.m=(rows+15)/16*16;mad.n=pitch;mad.k=L0K;mad.cmatrixInitVal=sub==0;
		    Mmad(acc,a2[ls],b2[ls],mad);
		    if((mad.m/16)*(mad.n/16)<10)PipeBarrier<PIPE_M>();
		    SetFlag<HardEvent::M_MTE1>(l0Free[ls]);l0Used[ls]=true;
		}
		if(changeA)SetFlag<HardEvent::MTE1_MTE2>(aFree[as]);
		if(changeB)SetFlag<HardEvent::MTE1_MTE2>(bFree[bs]);
		SetFlag<HardEvent::M_FIX>(matrixReady);WaitFlag<HardEvent::M_FIX>(matrixReady);
		if(local>=OutputSlots)CrossCoreWaitFlag<2,PIPE_FIX>(freeFlag);
		FixpipeParamsV220 fix;fix.nSize=pitch;fix.mSize=(rows+15)/16*16;
		fix.srcStride=fix.mSize;fix.dstStride=tn;
		Fixpipe<int32_t,int32_t,CFG_ROW_MAJOR>(gcSlot,acc,fix);
		SetFlag<HardEvent::FIX_M>(accFree[cs]);CrossCoreSetFlag<2,PIPE_FIX>(tileFlag);
	    }
						    if ASCEND_IS_AIV
			{
			    CrossCoreWaitFlag<2, PIPE_MTE2>(tileFlag);
			    const int halfRows = (rows + 1) / 2;
			    const int rowOffset = lane * halfRows;
			    const int vectorRows = lane ? rows - halfRows : halfRows;
			    auto c = cq.AllocTensor<int32_t>();
			    auto scale = c.ReinterpretCast<float>()[((tm + 1) / 2 * tn) +
								    (tm * tn > 16384 ? 64 : 0)];

			    if (pitch != (cols + 7) / 8 * 8)
			    {
				Duplicate(c, int32_t(0), vectorRows * pitch);
				auto event = pipe.FetchEventID<HardEvent::V_MTE2>();
				SetFlag<HardEvent::V_MTE2>(event);
				WaitFlag<HardEvent::V_MTE2>(event);
			    }

			    if (vectorRows > 0)
				DataCopyPad(c, gcSlot[int64_t(rowOffset) * tn],
					    {uint16_t(vectorRows), uint32_t(cols * sizeof(int32_t)),
					     uint32_t((tn - cols) * sizeof(int32_t)),
					     uint32_t((pitch * 4 - (cols * 4 + 31) / 32 * 32) / 32),
					     0},
					    {true, 0, 0, 0});
			    if (cols < 64)
			    {
				Duplicate(scale, 0.0f, tn);
				auto initialized = pipe.FetchEventID<HardEvent::V_MTE2>();
				SetFlag<HardEvent::V_MTE2>(initialized);
				WaitFlag<HardEvent::V_MTE2>(initialized);
			    }
			    DataCopyPad(scale, gs[(int64_t)e * N + col],
					{1, (uint32_t)(cols * sizeof(float)), 0, 0, 0},
					{true, 0, 0, 0.0f});
			    cq.EnQue(c);
			    c = cq.DeQue<int32_t>();

			    CrossCoreSetFlag<2, PIPE_MTE2>(freeFlag);

			    auto z = zb.Get<float>();
			    auto p = c.ReinterpretCast<float>();
			    auto u = p;
			    auto t = p;

			    const BinaryRepeatParams bcast{
				1, 1, 1, (uint8_t)(pitch / 8), (uint8_t)(pitch / 8), 0};
			    for (int r = 0; r < vectorRows; r += vr)
			    {
				const int batch = (vectorRows - r < vr) ? (vectorRows - r) : vr;
				const uint32_t count = (uint32_t)batch * pitch;
				Cast(z, c[r * pitch], RoundMode::CAST_NONE, count);
				PipeBarrier<PIPE_V>();
				if (cols < 64)
				{
				    Mul(z, z, scale, (uint64_t)(pitch < 64 ? pitch : 64),
					(uint8_t)batch, bcast);
				}
				else
				{
				    for (int c0 = 0; c0 < cols; c0 += 64)
				    {
					const int chunk = (cols - c0 < 64) ? (cols - c0) : 64;
					Mul(z[c0], z[c0], scale[c0], (uint64_t)chunk,
					    (uint8_t)batch, bcast);
				    }
				}
				PipeBarrier<PIPE_V>();

				p = c[r * pitch].ReinterpretCast<float>();
				u = p;
				ResidentGelu(z,p,count);
				auto out = oq.AllocTensor<half>();
				Cast(out, z, RoundMode::CAST_RINT, count);
				oq.EnQue(out);
				out = oq.DeQue<half>();
				const uint32_t outBytes = (uint32_t)cols * (uint32_t)sizeof(half);
				const uint32_t outPitchBytes =
				    (uint32_t)pitch * (uint32_t)sizeof(half);
				const uint32_t outSrcStride =
				    (outPitchBytes - ((outBytes + 31U) / 32U) * 32U) / 32U;
				for (int r0 = 0; r0 < batch; r0 += RowCopy)
				{
				    const int rc = batch - r0 < RowCopy ? batch - r0 : RowCopy;
				    DataCopyPad(gy[(int64_t)(row + rowOffset + r + r0) * N + col],
						out[r0 * pitch],
						{(uint16_t)rc, outBytes, outSrcStride,
						 (uint32_t)((N - cols) * sizeof(half)), 0});
				}
				oq.FreeTensor(out);
			    }
			    cq.FreeTensor(c);
			}

	    as=nas;bs=nbs;freshA=changeA;freshB=changeB;++local;
	}
	taskOffset+=tasks;begin=end;
    }
    if ASCEND_IS_AIV {PipeBarrier<PIPE_ALL>();}
    if ASCEND_IS_AIC {
	for(int i=0;i<OutputSlots;++i)if(local>i)CrossCoreWaitFlag<2,PIPE_MTE2>(12+i);
	for(int i=0;i<CDepth;++i) {
	    if(local>i)WaitFlag<HardEvent::FIX_M>(accFree[i]);
	    pipe.ReleaseEventID<HardEvent::FIX_M>(accFree[i]);
	}
	for(int i=0;i<ADepth;++i) {
	    if(aUsed[i])WaitFlag<HardEvent::MTE1_MTE2>(aFree[i]);
	    pipe.ReleaseEventID<HardEvent::MTE1_MTE2>(aFree[i]);
	    pipe.ReleaseEventID<HardEvent::MTE2_MTE1>(aReady[i]);
	}
	for(int i=0;i<BDepth;++i) {
	    if(bUsed[i])WaitFlag<HardEvent::MTE1_MTE2>(bFree[i]);
	    pipe.ReleaseEventID<HardEvent::MTE1_MTE2>(bFree[i]);
	    pipe.ReleaseEventID<HardEvent::MTE2_MTE1>(bReady[i]);
	}
	for(int i=0;i<L0Slots;++i) {
	    if(l0Used[i])WaitFlag<HardEvent::M_MTE1>(l0Free[i]);
	    pipe.ReleaseEventID<HardEvent::M_MTE1>(l0Free[i]);
	    pipe.ReleaseEventID<HardEvent::MTE1_M>(l0Ready[i]);
	}
	pipe.ReleaseEventID<HardEvent::M_FIX>(matrixReady);
    }
}
template<bool Enable>
__global__ __mix__(1,2) void PreparedFullBKernel(GMM_ARGUMENTS) {
    GM_ADDR packed=workspace+uint64_t(GetBlockNum())*2*128*256*4;
    gmm_coop::PrepareActiveCube<64,2,0,false>(w,packed,M,K,N,E,groups);
    SyncAll<false>();
    ComputeFullFinalHA<80,256,4,2,1,1,2,0,0,4,64,true,true,true,true,10240,64,2>(x,packed,sc,groups,y,workspace,M,K,N,E);
}
}
static void LaunchPreparedFullB(uint32_t cores,aclrtStream stream,GMM_ARGUMENTS) {
    gmm_device::PreparedFullBKernel<true><<<cores,nullptr,stream>>>(GMM_FORWARD);
}
#undef GMM_ARGUMENTS
#undef GMM_FORWARD

#define GMM_ARGUMENTS GM_ADDR x,GM_ADDR w,GM_ADDR sc,GM_ADDR groups,GM_ADDR y,GM_ADDR workspace,int M,int K,int N,int E
namespace gmm_device {
template<int TM,int TN,int Fold,int ADepth,int BDepth,int CDepth,int OutputSlots,
	 int Order,int Balance,int L0Slots,int L0K,bool FullB=false,bool Reuse=true,bool DoubleInput=false,int VCapacity=8192,int RowCopy=32,int AFold=1,bool A3D=false>
__aicore__ inline void ComputeRSTuned(
    GM_ADDR x,GM_ADDR w,GM_ADDR sc,GM_ADDR groups,GM_ADDR y,GM_ADDR workspace,
    int M,int K,int N,int E)
{
    static_assert(ADepth>=1 && ADepth<=2 && BDepth>=1 && BDepth<=2);
    static_assert(OutputSlots>=2 && OutputSlots<=4);
    static_assert(TM*TN*4*CDepth<=131072);
    static_assert(TM*L0K*L0Slots<=65536 && TN*L0K*L0Slots<=65536);
    const int KCap=(K+L0K-1)/L0K*L0K;
    constexpr int tm=TM,tn=TN,vr=VCapacity/TN,ve=(vr*TN+63)/64*64;
    TPipe pipe;
    GlobalTensor<int8_t> gx,gw;
    GlobalTensor<float> gs;
    GlobalTensor<int32_t> gc;
    GlobalTensor<half> gy;
    gx.SetGlobalBuffer((__gm__ int8_t*)x);gw.SetGlobalBuffer((__gm__ int8_t*)w);
    gs.SetGlobalBuffer((__gm__ float*)sc);gc.SetGlobalBuffer((__gm__ int32_t*)workspace);
    gy.SetGlobalBuffer((__gm__ half*)y);
    TBuf<TPosition::A1> a1Buffer[ADepth];
    TBuf<TPosition::B1> b1Buffer[BDepth];
    TBuf<TPosition::A2> a2Buffer;
    TBuf<TPosition::B2> b2Buffer;
    TBuf<TPosition::CO1> accBuffer;
    LocalTensor<int8_t> a1[ADepth],b1[BDepth],a2[L0Slots],b2[L0Slots];
    uint8_t aFree[ADepth],aReady[ADepth],bFree[BDepth],bReady[BDepth];
    uint8_t l0Free[L0Slots],l0Ready[L0Slots],accFree[CDepth],matrixReady;
    bool aUsed[ADepth]={},bUsed[BDepth]={},l0Used[L0Slots]={};
    if ASCEND_IS_AIC {
	for(int i=0;i<ADepth;++i) {
	    pipe.InitBuffer(a1Buffer[i],tm*KCap);a1[i]=a1Buffer[i].template Get<int8_t>();
	    aFree[i]=pipe.AllocEventID<HardEvent::MTE1_MTE2>();
	    aReady[i]=pipe.AllocEventID<HardEvent::MTE2_MTE1>();
	}
	for(int i=0;i<BDepth;++i) {
	    pipe.InitBuffer(b1Buffer[i],(FullB?(N+31)/32*32:tn)*KCap);
	    b1[i]=b1Buffer[i].template Get<int8_t>();
	    bFree[i]=pipe.AllocEventID<HardEvent::MTE1_MTE2>();
	    bReady[i]=pipe.AllocEventID<HardEvent::MTE2_MTE1>();
	}
	pipe.InitBuffer(a2Buffer,L0Slots*tm*L0K);pipe.InitBuffer(b2Buffer,L0Slots*tn*L0K);
	for(int i=0;i<L0Slots;++i) {
	    a2[i]=a2Buffer.Get<int8_t>()[i*tm*L0K];b2[i]=b2Buffer.Get<int8_t>()[i*tn*L0K];
	    l0Free[i]=pipe.AllocEventID<HardEvent::M_MTE1>();
	    l0Ready[i]=pipe.AllocEventID<HardEvent::MTE1_M>();
	}
	pipe.InitBuffer(accBuffer,CDepth*tm*tn*4);
        if constexpr(A3D){const uint8_t pads[4]={};SetFmatrix(1,tm,pads,FmatrixMode::FMATRIX_LEFT);}
	for(int i=0;i<CDepth;++i)accFree[i]=pipe.AllocEventID<HardEvent::FIX_M>();
	matrixReady=pipe.AllocEventID<HardEvent::M_FIX>();
    }
    // The next INT32 tile can be loaded while Vector consumes the other slot.
    TQue<TPosition::VECIN,DoubleInput?2:1> cq;
    TQue<TPosition::VECOUT,1> oq;
    TBuf<TPosition::VECCALC> zb,groupCache;
    if ASCEND_IS_AIV {
	// A 512-byte slot stride gives both CQ slots the same bank-group phase.
        // The extra 256 bytes after OQ place z opposite the INT32/GELU scratch.
        constexpr int cBytes=(tm/2*tn+tn)*4+(tm*tn>16384?256:0);
        pipe.InitBuffer(cq,DoubleInput?2:1,DoubleInput?(cBytes+511)/512*512:cBytes);
        pipe.InitBuffer(oq,1,ve*2+(DoubleInput?256:0));pipe.InitBuffer(zb,ve*4);
	pipe.InitBuffer(groupCache,(E*8+31)/32*32);
	GlobalTensor<int64_t> gg;gg.SetGlobalBuffer((__gm__ int64_t*)groups);
	DataCopyPad(groupCache.Get<int64_t>(),gg,{1,uint32_t(E*8),0,0,0},{true,0,0,int64_t(0)});
	auto ready=pipe.FetchEventID<HardEvent::MTE2_S>();
	SetFlag<HardEvent::MTE2_S>(ready);WaitFlag<HardEvent::MTE2_S>(ready);
    }
    int blockIdx=int(GetBlockIdx()),lane=0;
    if ASCEND_IS_AIV {lane=blockIdx&1;blockIdx/=2;}
    const int blockNum=int(GetBlockNum()),nc=(N+tn-1)/tn,nUnits=(N+31)/32;
    int64_t totalTasks=0;
    int previous=0;
    for(int e=0;e<E;++e) {
	int end=0;
	if ASCEND_IS_AIC {end=int(((__gm__ int64_t*)groups)[e]);}
	if ASCEND_IS_AIV {end=int(groupCache.Get<int64_t>().GetValue(e));}
	if(end<previous)end=previous;if(end>M)end=M;
	totalTasks+=int64_t((end-previous+tm-1)/tm)*nc;previous=end;
    }
    const int64_t ownedBegin=totalTasks*blockIdx/blockNum,ownedEnd=totalTasks*(blockIdx+1)/blockNum;
    int64_t taskOffset=0;
    int local=0,begin=0;
    for(int e=0;e<E;++e) {
	int end=0;
	if ASCEND_IS_AIC {end=int(((__gm__ int64_t*)groups)[e]);}
	if ASCEND_IS_AIV {end=int(groupCache.Get<int64_t>().GetValue(e));}
	if(end<begin)end=begin;if(end>M)end=M;
	const int mt=(end-begin+tm-1)/tm;
	const int64_t tasks=int64_t(mt)*nc;
	const int64_t first=ownedBegin>taskOffset?ownedBegin-taskOffset:0;
	const int64_t limit=ownedEnd-taskOffset<tasks?ownedEnd-taskOffset:tasks;
	int as=0,bs=0;
	bool freshA=true,freshB=true;
	for(int64_t task=first;task<limit;++task) {
	    const int mi=Order?task%mt:task/nc,ni=Order?task/mt:task%nc;
	    const int row=begin+mi*tm,rows=end-row<tm?end-row:tm;
	    const int col=Balance?(ni*nUnits/nc)*32:ni*tn;
	    const int colEnd=Balance?((ni+1)*nUnits/nc)*32:col+tn;
	    const int cols=(colEnd<N?colEnd:N)-col,pitch=(cols+31)/32*32;
	    const bool next=task+1<limit;
	    const int nextM=next?(Order?(task+1)%mt:(task+1)/nc):mi;
	    const int nextN=next?(Order?(task+1)/mt:(task+1)%nc):ni;
	    const bool changeA=!next || !Reuse || nextM!=mi;
	    const bool changeB=!next || (!FullB && (!Reuse || nextN!=ni));
	    const int nas=(ADepth==2 && changeA)?as^1:as;
	    const int nbs=(BDepth==2 && changeB)?bs^1:bs;
	    const int slot=local%OutputSlots;
	    const uint16_t tileFlag=8+slot,freeFlag=12+slot;
	    auto gcSlot=gc[int64_t(blockIdx*OutputSlots+slot)*tm*tn];
	    if ASCEND_IS_AIC {
		if(freshA && (task==first || ADepth==1)) {
		    FoldedLoadA<tm,AFold>(a1[as],gx,row,rows,K,aUsed[as],aFree[as],aReady[as],KCap);
		    aUsed[as]=true;SetFlag<HardEvent::MTE2_MTE1>(aReady[as]);
		}
		if(freshB && (task==first || BDepth==1)) {
		    if(bUsed[bs])WaitFlag<HardEvent::MTE1_MTE2>(bFree[bs]);
		    PackedResidentLoadB(b1[bs],gw,e,FullB?0:col,FullB?N:cols,K,N,KCap);
		    bUsed[bs]=true;SetFlag<HardEvent::MTE2_MTE1>(bReady[bs]);
		}
		if(freshA)WaitFlag<HardEvent::MTE2_MTE1>(aReady[as]);
		if(freshB)WaitFlag<HardEvent::MTE2_MTE1>(bReady[bs]);
		// Prefetch real future tiles while MTE1/Cube consume disjoint current slots.
		if(next && changeB && BDepth==2) {
		    const int ncol=Balance?(nextN*nUnits/nc)*32:nextN*tn;
		    const int nend=Balance?((nextN+1)*nUnits/nc)*32:ncol+tn;
		    if(bUsed[nbs])WaitFlag<HardEvent::MTE1_MTE2>(bFree[nbs]);
		    PackedResidentLoadB(b1[nbs],gw,e,ncol,(nend<N?nend:N)-ncol,K,N,KCap);
		    bUsed[nbs]=true;SetFlag<HardEvent::MTE2_MTE1>(bReady[nbs]);
		}
		if(next && changeA && ADepth==2) {
		    const int nrow=begin+nextM*tm,nrows=end-nrow<tm?end-nrow:tm;
		    FoldedLoadA<tm,AFold>(a1[nas],gx,nrow,nrows,K,aUsed[nas],aFree[nas],aReady[nas],KCap);
		    aUsed[nas]=true;SetFlag<HardEvent::MTE2_MTE1>(aReady[nas]);
		}
		const int cs=local%CDepth;
		auto acc=accBuffer.Get<int32_t>()[cs*tm*tn];
		for(int sub=0;sub<KCap/L0K;++sub) {
		    const int ls=sub%L0Slots;
		    if(l0Used[ls])WaitFlag<HardEvent::M_MTE1>(l0Free[ls]);
		    if constexpr(A3D){LoadData3DParamsV2Pro p;p.channelSize=KCap;p.extConfig=(uint64_t(sub*L0K)<<32)|(uint64_t((rows+15)/16*16)<<16)|uint64_t(L0K);LoadData(a2[ls],a1[as],p);}
            LoadData2dParams la;la.repeatTimes=(rows+15)/16;la.srcStride=1;
		    la.dstGap=L0K/32-1;la.ifTranspose=false;
		    LoadData2dTransposeParams lb{0,uint8_t(pitch/32),uint16_t(KCap/32),1,0,0};
#pragma unroll
		    for(int ki=0;ki<L0K/32;++ki) {
			if constexpr(!A3D)LoadData(a2[ls][ki*512],a1[as][(sub*(L0K/32)+ki)*tm*32],la);
			LoadDataWithTranspose(b2[ls][ki*pitch*32],
			    b1[bs][(FullB?col*KCap:0)+(sub*(L0K/32)+ki)*1024],lb);
		    }
		    SetFlag<HardEvent::MTE1_M>(l0Ready[ls]);WaitFlag<HardEvent::MTE1_M>(l0Ready[ls]);
		    if(!sub && local>=CDepth)WaitFlag<HardEvent::FIX_M>(accFree[cs]);
		    MmadParams mad;mad.m=(rows+15)/16*16;mad.n=pitch;mad.k=L0K;mad.cmatrixInitVal=sub==0;mad.unitFlag=(sub+1==KCap/L0K)?3:2;
		    Mmad(acc,a2[ls],b2[ls],mad);
		    if((mad.m/16)*(mad.n/16)<10)PipeBarrier<PIPE_M>();
		    SetFlag<HardEvent::M_MTE1>(l0Free[ls]);l0Used[ls]=true;
		}
		if(changeA)SetFlag<HardEvent::MTE1_MTE2>(aFree[as]);
		if(changeB)SetFlag<HardEvent::MTE1_MTE2>(bFree[bs]);
		// UnitFlag publishes each completed final-K fractal to Fixpipe.
		if(local>=OutputSlots)CrossCoreWaitFlag<2,PIPE_FIX>(freeFlag);
		FixpipeParamsV220 fix;fix.unitFlag=3;fix.nSize=pitch;fix.mSize=(rows+15)/16*16;
		fix.srcStride=fix.mSize;fix.dstStride=tn;
		Fixpipe<int32_t,int32_t,CFG_ROW_MAJOR>(gcSlot,acc,fix);
		SetFlag<HardEvent::FIX_M>(accFree[cs]);CrossCoreSetFlag<2,PIPE_FIX>(tileFlag);
	    }
						    if ASCEND_IS_AIV
			{
			    CrossCoreWaitFlag<2, PIPE_MTE2>(tileFlag);
			    const int halfRows = (rows + 1) / 2;
			    const int rowOffset = lane * halfRows;
			    const int vectorRows = lane ? rows - halfRows : halfRows;
			    auto c = cq.template AllocTensor<int32_t>();
			    auto scale = c.template ReinterpretCast<float>()[((tm + 1) / 2 * tn) +
								    (tm * tn > 16384 ? 64 : 0)];

			    if (pitch != (cols + 7) / 8 * 8)
			    {
				Duplicate(c, int32_t(0), vectorRows * pitch);
				auto event = pipe.FetchEventID<HardEvent::V_MTE2>();
				SetFlag<HardEvent::V_MTE2>(event);
				WaitFlag<HardEvent::V_MTE2>(event);
			    }

			    if (vectorRows > 0)
				DataCopyPad(c, gcSlot[int64_t(rowOffset) * tn],
					    {uint16_t(vectorRows), uint32_t(cols * sizeof(int32_t)),
					     uint32_t((tn - cols) * sizeof(int32_t)),
					     uint32_t((pitch * 4 - (cols * 4 + 31) / 32 * 32) / 32),
					     0},
					    {true, 0, 0, 0});
			    if (cols < 64)
			    {
				Duplicate(scale, 0.0f, tn);
				auto initialized = pipe.FetchEventID<HardEvent::V_MTE2>();
				SetFlag<HardEvent::V_MTE2>(initialized);
				WaitFlag<HardEvent::V_MTE2>(initialized);
			    }
			    DataCopyPad(scale, gs[(int64_t)e * N + col],
					{1, (uint32_t)(cols * sizeof(float)), 0, 0, 0},
					{true, 0, 0, 0.0f});
			    cq.EnQue(c);
			    c = cq.template DeQue<int32_t>();

			    CrossCoreSetFlag<2, PIPE_MTE2>(freeFlag);

			    auto z = zb.Get<float>();
			    auto p = c.template ReinterpretCast<float>();
			    auto u = p;
			    auto t = p;

			    const BinaryRepeatParams bcast{
				1, 1, 1, (uint8_t)(pitch / 8), (uint8_t)(pitch / 8), 0};
			    for (int r = 0; r < vectorRows; r += vr)
			    {
				const int batch = (vectorRows - r < vr) ? (vectorRows - r) : vr;
				const uint32_t count = (uint32_t)batch * pitch;
				Cast(z, c[r * pitch], RoundMode::CAST_NONE, count);
				PipeBarrier<PIPE_V>();
				if (cols < 64)
				{
				    Mul(z, z, scale, (uint64_t)(pitch < 64 ? pitch : 64),
					(uint8_t)batch, bcast);
				}
				else
				{
				    for (int c0 = 0; c0 < cols; c0 += 64)
				    {
					const int chunk = (cols - c0 < 64) ? (cols - c0) : 64;
					Mul(z[c0], z[c0], scale[c0], (uint64_t)chunk,
					    (uint8_t)batch, bcast);
				    }
				}
				PipeBarrier<PIPE_V>();

				p = c[r * pitch].template ReinterpretCast<float>();
				u = p;
				ResidentGelu(z,p,count);
				auto out = oq.AllocTensor<half>();
				Cast(out, z, RoundMode::CAST_RINT, count);
				oq.EnQue(out);
				out = oq.DeQue<half>();
				const uint32_t outBytes = (uint32_t)cols * (uint32_t)sizeof(half);
				const uint32_t outPitchBytes =
				    (uint32_t)pitch * (uint32_t)sizeof(half);
				const uint32_t outSrcStride =
				    (outPitchBytes - ((outBytes + 31U) / 32U) * 32U) / 32U;
				for (int r0 = 0; r0 < batch; r0 += RowCopy)
				{
				    const int rc = batch - r0 < RowCopy ? batch - r0 : RowCopy;
				    DataCopyPad(gy[(int64_t)(row + rowOffset + r + r0) * N + col],
						out[r0 * pitch],
						{(uint16_t)rc, outBytes, outSrcStride,
						 (uint32_t)((N - cols) * sizeof(half)), 0});
				}
				oq.FreeTensor(out);
			    }
			    cq.FreeTensor(c);
			}

	    as=nas;bs=nbs;freshA=changeA;freshB=changeB;++local;
	}
	taskOffset+=tasks;begin=end;
    }
    if ASCEND_IS_AIV {PipeBarrier<PIPE_ALL>();}
    if ASCEND_IS_AIC {
	for(int i=0;i<OutputSlots;++i)if(local>i)CrossCoreWaitFlag<2,PIPE_MTE2>(12+i);
	for(int i=0;i<CDepth;++i) {
	    if(local>i)WaitFlag<HardEvent::FIX_M>(accFree[i]);
	    pipe.ReleaseEventID<HardEvent::FIX_M>(accFree[i]);
	}
	for(int i=0;i<ADepth;++i) {
	    if(aUsed[i])WaitFlag<HardEvent::MTE1_MTE2>(aFree[i]);
	    pipe.ReleaseEventID<HardEvent::MTE1_MTE2>(aFree[i]);
	    pipe.ReleaseEventID<HardEvent::MTE2_MTE1>(aReady[i]);
	}
	for(int i=0;i<BDepth;++i) {
	    if(bUsed[i])WaitFlag<HardEvent::MTE1_MTE2>(bFree[i]);
	    pipe.ReleaseEventID<HardEvent::MTE1_MTE2>(bFree[i]);
	    pipe.ReleaseEventID<HardEvent::MTE2_MTE1>(bReady[i]);
	}
	for(int i=0;i<L0Slots;++i) {
	    if(l0Used[i])WaitFlag<HardEvent::M_MTE1>(l0Free[i]);
	    pipe.ReleaseEventID<HardEvent::M_MTE1>(l0Free[i]);
	    pipe.ReleaseEventID<HardEvent::MTE1_M>(l0Ready[i]);
	}
	pipe.ReleaseEventID<HardEvent::M_FIX>(matrixReady);
    }
}
__aicore__ inline void ComputeRSCandidate(GMM_ARGUMENTS){
ComputeRSTuned<96,256,1,2,1,1,2,1,1,4,64,false,true,true,12288,64,2,true>(x,w,sc,groups,y,workspace,M,K,N,E);
}
}
#undef GMM_ARGUMENTS

namespace DotProductWeightLayout {
using namespace AscendC;
__aicore__ inline void Weights(GM_ADDR w,GM_ADDR out,GM_ADDR groups,int K,int E) {
 if ASCEND_IS_AIV {
  constexpr int P=256,C=16;
  TPipe pipe;TBuf<TPosition::VECCALC> input,output;
  pipe.InitBuffer(input,P);pipe.InitBuffer(output,P*C);
  auto in=input.Get<int8_t>();auto packed=output.Get<int32_t>();
  GlobalTensor<int8_t> gw,gp;gw.SetGlobalBuffer((__gm__ int8_t*)w);gp.SetGlobalBuffer((__gm__ int8_t*)out);
  const int kp=(K+1023)/1024*1024,chunks=kp/P,cores=GetBlockNum()*2;
  auto free=pipe.AllocEventID<HardEvent::MTE3_V>();bool used=false;
  for(int task=GetBlockIdx();task<E*chunks;task+=cores){
   const int e=task/chunks,col=task%chunks*P;
   if(((__gm__ int64_t*)groups)[e]==(e?((__gm__ int64_t*)groups)[e-1]:0))continue;
   if(used)WaitFlag<HardEvent::MTE3_V>(free);
   Duplicate(in.ReinterpretCast<int32_t>(),int32_t(0),P/4);
   auto z=pipe.FetchEventID<HardEvent::V_MTE2>();SetFlag<HardEvent::V_MTE2>(z);WaitFlag<HardEvent::V_MTE2>(z);
   const int live=K-col<P?K-col:P;
   if(live>0)DataCopyPad(in,gw[int64_t(e)*K+col],{1,uint32_t(live),0,0,0},{true,0,0,int8_t(0)});
   auto loaded=pipe.FetchEventID<HardEvent::MTE2_V>();SetFlag<HardEvent::MTE2_V>(loaded);WaitFlag<HardEvent::MTE2_V>(loaded);
   // Each L0B fractal contains C copies of this live 32-element K vector.
   for(int k=0;k<P/32;++k)Copy(packed[k*(C*8)],in.ReinterpretCast<int32_t>()[k*8],uint64_t(8),uint8_t(C),{1,1,1,0});
   auto ready=pipe.FetchEventID<HardEvent::V_MTE3>();SetFlag<HardEvent::V_MTE3>(ready);WaitFlag<HardEvent::V_MTE3>(ready);
   DataCopy(gp[(int64_t(e)*kp+col)*C],packed.ReinterpretCast<int8_t>(),P*C);
   SetFlag<HardEvent::MTE3_V>(free);used=true;
  }
  if(used)WaitFlag<HardEvent::MTE3_V>(free);pipe.ReleaseEventID<HardEvent::MTE3_V>(free);PipeBarrier<PIPE_ALL>();
 }
}
}
namespace gmm_device {
template<int TM,int TN,int Fold,int ADepth,int BDepth,int CDepth,int OutputSlots,
	 int Order,int Balance,int L0Slots,int L0K,bool FullB=false,bool Reuse=true,bool DoubleInput=false>
__aicore__ inline void NarrowBatchedOutput(
    GM_ADDR x,GM_ADDR w,GM_ADDR sc,GM_ADDR groups,GM_ADDR y,GM_ADDR workspace,
    int M,int K,int N,int E)
{
    static_assert(ADepth>=1 && ADepth<=2 && BDepth>=1 && BDepth<=2);
    static_assert(OutputSlots>=2 && OutputSlots<=4);
    static_assert(TM*TN*4*CDepth<=131072);
    static_assert(TM*L0K*L0Slots<=65536 && TN*L0K*L0Slots<=65536);
    const int KCap=(K+1023)/1024*1024;
    constexpr int tm=TM,tn=TN,vr=8192/TN,ve=(vr*TN+63)/64*64;
    TPipe pipe;
    GlobalTensor<int8_t> gx,gw;
    GlobalTensor<float> gs;
    GlobalTensor<int32_t> gc;
    GlobalTensor<half> gy;
    gx.SetGlobalBuffer((__gm__ int8_t*)x);gw.SetGlobalBuffer((__gm__ int8_t*)w);
    gs.SetGlobalBuffer((__gm__ float*)sc);gc.SetGlobalBuffer((__gm__ int32_t*)workspace);
    gy.SetGlobalBuffer((__gm__ half*)y);
    TBuf<TPosition::A1> a1Buffer[ADepth];
    TBuf<TPosition::B1> b1Buffer[BDepth];
    TBuf<TPosition::A2> a2Buffer;
    TBuf<TPosition::B2> b2Buffer;
    TBuf<TPosition::CO1> accBuffer;
    LocalTensor<int8_t> a1[ADepth],b1[BDepth],a2[L0Slots],b2[L0Slots];
    uint8_t aFree[ADepth],aReady[ADepth],bFree[BDepth],bReady[BDepth];
    uint8_t l0Free[L0Slots],l0Ready[L0Slots],accFree[CDepth],matrixReady;
    bool aUsed[ADepth]={},bUsed[BDepth]={},l0Used[L0Slots]={};
    if ASCEND_IS_AIC {
	for(int i=0;i<ADepth;++i) {
	    pipe.InitBuffer(a1Buffer[i],tm*KCap);a1[i]=a1Buffer[i].template Get<int8_t>();
	    aFree[i]=pipe.AllocEventID<HardEvent::MTE1_MTE2>();
	    aReady[i]=pipe.AllocEventID<HardEvent::MTE2_MTE1>();
	}
	for(int i=0;i<BDepth;++i) {
	    pipe.InitBuffer(b1Buffer[i],(FullB?(N+31)/32*32:tn)*KCap);
	    b1[i]=b1Buffer[i].template Get<int8_t>();
	    bFree[i]=pipe.AllocEventID<HardEvent::MTE1_MTE2>();
	    bReady[i]=pipe.AllocEventID<HardEvent::MTE2_MTE1>();
	}
	pipe.InitBuffer(a2Buffer,L0Slots*tm*L0K);pipe.InitBuffer(b2Buffer,L0Slots*tn*L0K);
	for(int i=0;i<L0Slots;++i) {
	    a2[i]=a2Buffer.Get<int8_t>()[i*tm*L0K];b2[i]=b2Buffer.Get<int8_t>()[i*tn*L0K];
	    l0Free[i]=pipe.AllocEventID<HardEvent::M_MTE1>();
	    l0Ready[i]=pipe.AllocEventID<HardEvent::MTE1_M>();
	}
	pipe.InitBuffer(accBuffer,CDepth*tm*tn*4);
	for(int i=0;i<CDepth;++i)accFree[i]=pipe.AllocEventID<HardEvent::FIX_M>();
	matrixReady=pipe.AllocEventID<HardEvent::M_FIX>();
        const uint8_t pads[4]={};SetFmatrix(1,tm,pads,FmatrixMode::FMATRIX_LEFT);
    }
    // The next INT32 tile can be loaded while Vector consumes the other slot.
    TQue<TPosition::VECIN,DoubleInput?2:1> cq;
    TBuf<TPosition::VECCALC> zb,groupCache,compactOut,gatherOffsets,scaleCache;
    if ASCEND_IS_AIV {
	// Current-invocation INT32 tiles and compact results have separate buffers.
        constexpr int cBytes=(tm*tn+tn)*4+(tm*tn>16384?256:0);
        pipe.InitBuffer(cq,DoubleInput?2:1,DoubleInput?(cBytes+511)/512*512:cBytes);
        pipe.InitBuffer(zb,((tm+63)/64*64)*4);
	pipe.InitBuffer(groupCache,(E*8+31)/32*32);
        pipe.InitBuffer(scaleCache,(E*4+31)/32*32);
        DataCopyPad(scaleCache.Get<float>(),gs,{1,uint32_t(E*4),0,0,0},{true,0,0,0.0f});
        const int maxRows=(((M+tm-1)/tm+E+int(GetBlockNum())-1)/int(GetBlockNum()))*tm;
        pipe.InitBuffer(compactOut,(maxRows+32)*2);
        pipe.InitBuffer(gatherOffsets,tm*4);
        for(int i=0;i<tm;++i)gatherOffsets.Get<uint32_t>().SetValue(i,i*tn*4);
        auto indices=pipe.FetchEventID<HardEvent::S_V>();SetFlag<HardEvent::S_V>(indices);WaitFlag<HardEvent::S_V>(indices);
	GlobalTensor<int64_t> gg;gg.SetGlobalBuffer((__gm__ int64_t*)groups);
	DataCopyPad(groupCache.Get<int64_t>(),gg,{1,uint32_t(E*8),0,0,0},{true,0,0,int64_t(0)});
	auto ready=pipe.FetchEventID<HardEvent::MTE2_S>();
	SetFlag<HardEvent::MTE2_S>(ready);WaitFlag<HardEvent::MTE2_S>(ready);
    }
    int blockIdx=int(GetBlockIdx()),lane=0;
    if ASCEND_IS_AIV {lane=blockIdx&1;blockIdx/=2;}
    const int blockNum=int(GetBlockNum()),nc=(N+tn-1)/tn,nUnits=(N+31)/32;
    int64_t totalTasks=0;
    int previous=0;
    for(int e=0;e<E;++e) {
	int end=0;
	if ASCEND_IS_AIC {end=int(((__gm__ int64_t*)groups)[e]);}
	if ASCEND_IS_AIV {end=int(groupCache.Get<int64_t>().GetValue(e));}
	if(end<previous)end=previous;if(end>M)end=M;
	totalTasks+=int64_t((end-previous+tm-1)/tm)*nc;previous=end;
    }
    const int64_t ownedBegin=totalTasks*blockIdx/blockNum,ownedEnd=totalTasks*(blockIdx+1)/blockNum;
    int64_t taskOffset=0;
    int local=0,begin=0;
    for(int e=0;e<E;++e) {
	int end=0;
	if ASCEND_IS_AIC {end=int(((__gm__ int64_t*)groups)[e]);}
	if ASCEND_IS_AIV {end=int(groupCache.Get<int64_t>().GetValue(e));}
	if(end<begin)end=begin;if(end>M)end=M;
	const int mt=(end-begin+tm-1)/tm;
	const int64_t tasks=int64_t(mt)*nc;
	const int64_t first=ownedBegin>taskOffset?ownedBegin-taskOffset:0;
	const int64_t limit=ownedEnd-taskOffset<tasks?ownedEnd-taskOffset:tasks;
	int as=0,bs=0;
	bool freshA=true,freshB=true;
	for(int64_t task=first;task<limit;++task) {
	    const int mi=Order?task%mt:task/nc,ni=Order?task/mt:task%nc;
	    const int row=begin+mi*tm,rows=end-row<tm?end-row:tm;
	    const int col=Balance?(ni*nUnits/nc)*32:ni*tn;
	    const int colEnd=Balance?((ni+1)*nUnits/nc)*32:col+tn;
	    const int cols=(colEnd<N?colEnd:N)-col,pitch=(cols+15)/16*16;
	    const bool next=task+1<limit;
	    const int nextM=next?(Order?(task+1)%mt:(task+1)/nc):mi;
	    const int nextN=next?(Order?(task+1)/mt:(task+1)%nc):ni;
	    const bool changeA=!next || !Reuse || nextM!=mi;
	    const bool changeB=!next || (!FullB && (!Reuse || nextN!=ni));
	    const int nas=(ADepth==2 && changeA)?as^1:as;
	    const int nbs=(BDepth==2 && changeB)?bs^1:bs;
	    const int slot=local%OutputSlots;
	    const uint16_t tileFlag=8+slot,freeFlag=12+slot;
	    auto gcSlot=gc[int64_t(blockIdx*OutputSlots+slot)*tm*tn];
	    if ASCEND_IS_AIC {
		if(freshA && (task==first || ADepth==1)) {
		    ResidentLoadA<tm>(a1[as],gx,row,rows,K,aUsed[as],aFree[as],aReady[as],KCap);
		    aUsed[as]=true;SetFlag<HardEvent::MTE2_MTE1>(aReady[as]);
		}
		if(freshB && (task==first || BDepth==1)) {
		    if(bUsed[bs])WaitFlag<HardEvent::MTE1_MTE2>(bFree[bs]);
		    DataCopy(b1[bs],gw[int64_t(e)*tn*KCap],tn*KCap);
		    bUsed[bs]=true;SetFlag<HardEvent::MTE2_MTE1>(bReady[bs]);
		}
		if(freshA)WaitFlag<HardEvent::MTE2_MTE1>(aReady[as]);
		if(freshB)WaitFlag<HardEvent::MTE2_MTE1>(bReady[bs]);
		// Prefetch real future tiles while MTE1/Cube consume disjoint current slots.
		if(next && changeB && BDepth==2) {
		    const int ncol=Balance?(nextN*nUnits/nc)*32:nextN*tn;
		    const int nend=Balance?((nextN+1)*nUnits/nc)*32:ncol+tn;
		    if(bUsed[nbs])WaitFlag<HardEvent::MTE1_MTE2>(bFree[nbs]);
		    DataCopy(b1[nbs],gw[int64_t(e)*tn*KCap],tn*KCap);
		    bUsed[nbs]=true;SetFlag<HardEvent::MTE2_MTE1>(bReady[nbs]);
		}
		if(next && changeA && ADepth==2) {
		    const int nrow=begin+nextM*tm,nrows=end-nrow<tm?end-nrow:tm;
		    ResidentLoadA<tm>(a1[nas],gx,nrow,nrows,K,aUsed[nas],aFree[nas],aReady[nas],KCap);
		    aUsed[nas]=true;SetFlag<HardEvent::MTE2_MTE1>(aReady[nas]);
		}
		const int cs=local%CDepth;
		auto acc=accBuffer.Get<int32_t>()[cs*tm*tn];
		for(int sub=0;sub<KCap/L0K;++sub) {
		    const int ls=sub%L0Slots;
		    if(l0Used[ls])WaitFlag<HardEvent::M_MTE1>(l0Free[ls]);
		    LoadData2dParams la;la.repeatTimes=(rows+15)/16;la.srcStride=1;
		    la.dstGap=L0K/32-1;la.ifTranspose=false;
		    LoadData2dTransposeParams lb{0,uint8_t(pitch/32),uint16_t(KCap/32),1,0,0};
#pragma unroll
		    for(int ki=0;ki<L0K/32;++ki) {
			

		    }
            LoadData3DParamsV2Pro directA;directA.channelSize=KCap;
            directA.extConfig=(uint64_t(sub*L0K)<<32)|(uint64_t((rows+15)/16*16)<<16)|uint64_t(L0K);
            LoadData(a2[ls],a1[as],directA);
            LoadData2dParams directB;directB.repeatTimes=L0K*tn/512;directB.srcStride=1;
            directB.dstGap=0;directB.ifTranspose=false;
            LoadData(b2[ls],b1[bs][sub*L0K*tn],directB);
		    SetFlag<HardEvent::MTE1_M>(l0Ready[ls]);WaitFlag<HardEvent::MTE1_M>(l0Ready[ls]);
		    if(!sub && local>=CDepth)WaitFlag<HardEvent::FIX_M>(accFree[cs]);
		    MmadParams mad;mad.m=(rows+15)/16*16;mad.n=pitch;mad.k=L0K;mad.cmatrixInitVal=sub==0;mad.unitFlag=(sub+1==KCap/L0K)?3:2;
		    Mmad(acc,a2[ls],b2[ls],mad);
		    if((mad.m/16)*(mad.n/16)<10)PipeBarrier<PIPE_M>();
		    SetFlag<HardEvent::M_MTE1>(l0Free[ls]);l0Used[ls]=true;
		}
		if(changeA)SetFlag<HardEvent::MTE1_MTE2>(aFree[as]);
		if(changeB)SetFlag<HardEvent::MTE1_MTE2>(bFree[bs]);
		// UnitFlag publishes each completed final-K fractal to Fixpipe.
		if(local>=OutputSlots)CrossCoreWaitFlag<2,PIPE_FIX>(freeFlag);
		FixpipeParamsV220 fix;fix.unitFlag=3;fix.nSize=pitch;fix.mSize=(rows+15)/16*16;
		fix.srcStride=fix.mSize;fix.dstStride=tn;
		Fixpipe<int32_t,int32_t,CFG_ROW_MAJOR>(gcSlot,acc,fix);
		SetFlag<HardEvent::FIX_M>(accFree[cs]);CrossCoreSetFlag<2,PIPE_FIX>(tileFlag);
	    }
						    if ASCEND_IS_AIV {
        CrossCoreWaitFlag<2,PIPE_MTE2>(tileFlag);
        if(lane==0) {
            auto c=cq.template AllocTensor<int32_t>();
            auto scale=c.template ReinterpretCast<float>()[tm*tn];
            DataCopy(c,gcSlot,((rows+15)/16*16)*tn);
            
            cq.EnQue(c);c=cq.template DeQue<int32_t>();
            CrossCoreSetFlag<2,PIPE_MTE2>(freeFlag);
            auto z=zb.Get<float>();
            Gather(z.ReinterpretCast<int32_t>(),c,gatherOffsets.Get<uint32_t>(),0,uint32_t(rows));
            PipeBarrier<PIPE_V>();
            Cast(z,z.ReinterpretCast<int32_t>(),RoundMode::CAST_NONE,rows);PipeBarrier<PIPE_V>();
            auto ready=pipe.FetchEventID<HardEvent::MTE2_S>();SetFlag<HardEvent::MTE2_S>(ready);WaitFlag<HardEvent::MTE2_S>(ready);
            Muls(z,z,scaleCache.Get<float>().GetValue(e),rows);PipeBarrier<PIPE_V>();
            auto scratch=c.template ReinterpretCast<float>();
            ResidentGelu(z,scratch,rows);
            Cast(compactOut.Get<half>()[int(task-first)*tm],z,RoundMode::CAST_RINT,rows);
            PipeBarrier<PIPE_V>();cq.FreeTensor(c);
        } else {
            CrossCoreSetFlag<2,PIPE_MTE2>(freeFlag);
        }
    }

	    as=nas;bs=nbs;freshA=changeA;freshB=changeB;++local;
	}
    if ASCEND_IS_AIV {if(lane==0 && limit>first) {
        const int firstRow=begin+int(first)*tm,lastRow=(begin+int(limit)*tm<end)?begin+int(limit)*tm:end;
        auto ready=pipe.FetchEventID<HardEvent::V_MTE3>();SetFlag<HardEvent::V_MTE3>(ready);WaitFlag<HardEvent::V_MTE3>(ready);
        DataCopyPad(gy[firstRow],compactOut.Get<half>(),{1,uint32_t((lastRow-firstRow)*2),0,0,0});
        auto free=pipe.FetchEventID<HardEvent::MTE3_V>();SetFlag<HardEvent::MTE3_V>(free);WaitFlag<HardEvent::MTE3_V>(free);
    }}
    taskOffset+=tasks;begin=end;
    }
    if ASCEND_IS_AIV {PipeBarrier<PIPE_ALL>();}
    if ASCEND_IS_AIC {
	for(int i=0;i<OutputSlots;++i)if(local>i)CrossCoreWaitFlag<2,PIPE_MTE2>(12+i);
	for(int i=0;i<CDepth;++i) {
	    if(local>i)WaitFlag<HardEvent::FIX_M>(accFree[i]);
	    pipe.ReleaseEventID<HardEvent::FIX_M>(accFree[i]);
	}
	for(int i=0;i<ADepth;++i) {
	    if(aUsed[i])WaitFlag<HardEvent::MTE1_MTE2>(aFree[i]);
	    pipe.ReleaseEventID<HardEvent::MTE1_MTE2>(aFree[i]);
	    pipe.ReleaseEventID<HardEvent::MTE2_MTE1>(aReady[i]);
	}
	for(int i=0;i<BDepth;++i) {
	    if(bUsed[i])WaitFlag<HardEvent::MTE1_MTE2>(bFree[i]);
	    pipe.ReleaseEventID<HardEvent::MTE1_MTE2>(bFree[i]);
	    pipe.ReleaseEventID<HardEvent::MTE2_MTE1>(bReady[i]);
	}
	for(int i=0;i<L0Slots;++i) {
	    if(l0Used[i])WaitFlag<HardEvent::M_MTE1>(l0Free[i]);
	    pipe.ReleaseEventID<HardEvent::M_MTE1>(l0Free[i]);
	    pipe.ReleaseEventID<HardEvent::MTE1_M>(l0Ready[i]);
	}
	pipe.ReleaseEventID<HardEvent::M_FIX>(matrixReady);
    }
}
}


namespace DotProductDevice {
__global__ __mix__(1,2) void Narrow(GM_ADDR x,GM_ADDR w,GM_ADDR sc,GM_ADDR groups,GM_ADDR y,GM_ADDR workspace,int M,int K,int N,int E) {
    GM_ADDR wp=workspace+uint64_t(AscendC::GetBlockNum())*2*32*16*4;
    DotProductWeightLayout::Weights(w,wp,groups,K,E);
    AscendC::SyncAll<false>();
    gmm_device::NarrowBatchedOutput<32,16,1,2,1,2,2,0,1,2,1024,false,true,false>(x,wp,sc,groups,y,workspace,M,K,N,E);
}
}
static void LaunchDotProduct(uint32_t cores,aclrtStream stream,GM_ADDR x,GM_ADDR w,GM_ADDR sc,GM_ADDR groups,GM_ADDR y,GM_ADDR workspace,int M,int K,int N,int E) {
    DotProductDevice::Narrow<<<cores,nullptr,stream>>>(x,w,sc,groups,y,workspace,M,K,N,E);
}

namespace gmm_device {

// Layout and traversal are scheduling parameters of one complete reduction.
// Neither parameter changes which tensor elements contribute to an output.
template<int TileM,int PacketK>
__aicore__ inline void PreparedPrefetch(GlobalTensor<int8_t> gx,GlobalTensor<int8_t> gw,
 LocalTensor<int8_t> a1,LocalTensor<int8_t> b1,bool reused,uint8_t freeId,uint8_t readyId,
 int row,int col,int rows,int cols,int expert,int K,int N,int panel,int M,bool packedInput) {
 if(packedInput)NZPrefetch<TileM,PacketK>(gx,gw,a1,b1,reused,freeId,readyId,row,col,rows,cols,expert,K,N,panel,M);
 else WeightPackedNZPrefetch<TileM,PacketK>(gx,gw,a1,b1,reused,freeId,readyId,row,col,rows,cols,expert,K,N,panel);
}
template <int TileM, int TileN, int PacketK, int L0Slots = 4>
    __aicore__ __attribute__((always_inline)) inline void
    PreparedGroupedCompute(GM_ADDR x, GM_ADDR w, GM_ADDR sc, GM_ADDR groups, GM_ADDR y,
			   GM_ADDR workspace, int M, int K, int N, int E,
			   AscendC::tiling::TCubeTiling tiling, uint32_t l1Half,bool packedInput,bool mFirst)
    {
	TPipe pipe;
	GlobalTensor<int8_t> gx, gw;
	GlobalTensor<float> gs;
	GlobalTensor<int32_t> gc;
	GlobalTensor<half> gy;
	gx.SetGlobalBuffer((__gm__ int8_t *)x);
	gw.SetGlobalBuffer((__gm__ int8_t *)w);
	gs.SetGlobalBuffer((__gm__ float *)sc);
	gy.SetGlobalBuffer((__gm__ half *)y);
	gc.SetGlobalBuffer((__gm__ int32_t *)workspace);

	const int tm = TileM;
	const int tn = TileN;

	const int capacity = 8192;
	const int vr = capacity / tn;
	const int ve = vr * tn;
	TBuf<TPosition::A1> a1Buffer[2], l1Gap;
	TBuf<TPosition::B1> b1Buffer[2];
	TBuf<TPosition::A2> a2Buffer;
	TBuf<TPosition::B2> b2Buffer;
	TBuf<TPosition::CO1> accBuffer;
	LocalTensor<int8_t> a1[2], b1[2], a2[L0Slots], b2[L0Slots];
	uint8_t l1Free[2], l1Ready[2], l0Free[L0Slots], l0Ready[L0Slots];
	uint8_t accumulatorFree = 0, matrixReady = 0;
	bool l1Used[2] = {false, false}, l0Used[L0Slots] = {};
	if ASCEND_IS_AIC
	{
	    pipe.InitBuffer(a1Buffer[0], tm * PacketK);
	    pipe.InitBuffer(b1Buffer[0], tn * PacketK);
	    const uint32_t packetBytes = (tm + tn) * PacketK;
	    if (l1Half > packetBytes)
		pipe.InitBuffer(l1Gap, l1Half - packetBytes);
	    pipe.InitBuffer(a1Buffer[1], tm * PacketK);
	    pipe.InitBuffer(b1Buffer[1], tn * PacketK);
#pragma unroll
	    for (int i = 0; i < 2; ++i)
	    {
		a1[i] = a1Buffer[i].Get<int8_t>();
		b1[i] = b1Buffer[i].Get<int8_t>();
		l1Free[i] = pipe.AllocEventID<HardEvent::MTE1_MTE2>();
		l1Ready[i] = pipe.AllocEventID<HardEvent::MTE2_MTE1>();
	    }
	    pipe.InitBuffer(a2Buffer, L0Slots * tm * 64);
	    pipe.InitBuffer(b2Buffer, L0Slots * tn * 64);
#pragma unroll
	    for (int i = 0; i < L0Slots; ++i)
	    {
		a2[i] = a2Buffer.Get<int8_t>()[i * tm * 64];
		b2[i] = b2Buffer.Get<int8_t>()[i * tn * 64];
		l0Free[i] = pipe.AllocEventID<HardEvent::M_MTE1>();
		l0Ready[i] = pipe.AllocEventID<HardEvent::MTE1_M>();
	    }
	    pipe.InitBuffer(accBuffer, tm * tn * sizeof(int32_t));
	    accumulatorFree = pipe.AllocEventID<HardEvent::FIX_M>();
	    matrixReady = pipe.AllocEventID<HardEvent::M_FIX>();
	}

	TQue<TPosition::VECIN, 1> cq;
	TQue<TPosition::VECOUT, 1> oq;
	TBuf<TPosition::VECCALC> zb, pb, groupCache;
	if ASCEND_IS_AIV
	{
	    pipe.InitBuffer(cq, 1,
			    uint32_t(((tm + 1) / 2 * tn + tn) * sizeof(float)) +
				(tm * tn > 16384 ? 256 : 0));
	    pipe.InitBuffer(oq, 1, (uint32_t)ve * sizeof(half));
	    pipe.InitBuffer(zb, (uint32_t)ve * sizeof(float));
	    if (E > 0)
	    {
		pipe.InitBuffer(groupCache, (E * 8 + 31) / 32 * 32);
		GlobalTensor<int64_t> gg;
		gg.SetGlobalBuffer((__gm__ int64_t *)groups);
		DataCopyPad(groupCache.Get<int64_t>(), gg, {1, (uint32_t)(E * 8), 0, 0, 0},
			    {true, 0, 0, int64_t(0)});
		auto ready = pipe.FetchEventID<HardEvent::MTE2_S>();
		SetFlag<HardEvent::MTE2_S>(ready);
		WaitFlag<HardEvent::MTE2_S>(ready);
	    }
	}

	int blockIdx = (int)GetBlockIdx();
	int lane = 0;
	if ASCEND_IS_AIV
	{
	    lane = blockIdx & 1;
	    blockIdx /= 2;
	}
	const int blockNum = (int)GetBlockNum();
	const int nc = (N + tn - 1) / tn;
	int64_t nextTask = blockIdx;
	const int period = 2 * blockNum;
	int gap = period - 1 - 2 * blockIdx;
	int64_t local = 0;
	for (int bucket = ((tm + 31) / 32 + 1) * 32; bucket >= 16; bucket -= 32)
	{
	    int begin = 0;
	    for (int e = 0; e < E; ++e)
	    {
		int end = 0;
		if ASCEND_IS_AIC
		{
		    end = (int)((__gm__ int64_t *)groups)[e];
		}
		if ASCEND_IS_AIV
		{
		    end = E > 0 ? (int)groupCache.Get<int64_t>().GetValue(e)
				: (int)((__gm__ int64_t *)groups)[e];
		}
		if (end < begin)
		    end = begin;
		if (end > M)
		    end = M;
		const int me = end - begin;
		const bool fullPass = bucket == ((tm + 31) / 32 + 1) * 32;
		const int fullTiles = me / tm;
		const int tailRows = me % tm;
		const bool selected = fullPass
					  ? fullTiles > 0
					  : tailRows > 0 && ((tailRows + 31) / 32 * 32 == bucket);
		if (selected)
		{
		    const int mt = fullPass ? fullTiles : 1;
		    const int firstM = fullPass ? 0 : fullTiles;
		    const int64_t tasks = (int64_t)mt * nc;

		    int64_t t = nextTask;
		    for (; t < tasks; t += gap, gap = period - gap)
		    {

			const int mIdx = firstM + (mFirst ? int(t/nc) : int(t%mt));
			const int nIdx = mFirst ? int(t%nc) : int(t/mt);
			const int row = begin + mIdx * tm;
			const int col = nIdx * tn;
			const int rows = (me - mIdx * tm < tm) ? (me - mIdx * tm) : tm;
			const int cols = N - col < tn ? N - col : tn;

			const int pitch = (cols + 31) / 32 * 32;
			const int slot = (int)(local & 1);
			const uint16_t tileFlag = slot ? FLAG_TILE1 : FLAG_TILE0;
			const uint16_t freeFlag = slot ? FLAG_FREE1 : FLAG_FREE0;
			auto gcSlot = gc[(int64_t)(blockIdx * SLOTS + slot) * tm * tn];

			if ASCEND_IS_AIC
			{
			    const int panels = (K + PacketK - 1) / PacketK;
			    auto acc = accBuffer.Get<int32_t>();
#pragma unroll
			    for (int p = 0; p < 2 && p < panels; ++p)
			    {
				PreparedPrefetch<TileM, PacketK>(
				    gx, gw, a1[p], b1[p], l1Used[p], l1Free[p], l1Ready[p], row,
				    col, rows, cols, e, K, N, p,M,packedInput);
				l1Used[p] = true;
			    }
			    int fragment = 0;
			    for (int panel = 0; panel < panels; ++panel)
			    {
				const int slot1 = panel & 1;
				WaitFlag<HardEvent::MTE2_MTE1>(l1Ready[slot1]);
#pragma unroll
				for (int sub = 0; sub < PacketK / 64; ++sub)
				{
				    if (panel * PacketK + sub * 64 >= K)
					break;
				    const int slot0 = fragment & (L0Slots - 1);
				    if (l0Used[slot0])
					WaitFlag<HardEvent::M_MTE1>(l0Free[slot0]);
				    LoadData2dParams la;
				    la.repeatTimes = (rows + 15) / 16;
				    la.srcStride = 1;
				    la.dstGap = 1;
				    la.ifTranspose = false;
#pragma unroll
				    for (int ki = 0; ki < 2; ++ki)
				    {
					LoadData(a2[slot0][ki * 512],
						 a1[slot1][(sub * 2 + ki) * tm * 32], la);
				    }
				    LoadData2dTransposeParams lb{
					0,
					uint8_t(((cols + 31) / 32 * 32) / 32),
					uint16_t(PacketK / 32),
					1,
					0,
					0};
#pragma unroll
				    for (int ki = 0; ki < 2; ++ki)
					LoadDataWithTranspose(
					    b2[slot0][ki * ((cols + 31) / 32 * 32) * 32],
					    b1[slot1][(sub * 2 + ki) * 1024], lb);
				    SetFlag<HardEvent::MTE1_M>(l0Ready[slot0]);
				    WaitFlag<HardEvent::MTE1_M>(l0Ready[slot0]);
				    if (fragment == 0 && local > 0)
					WaitFlag<HardEvent::FIX_M>(accumulatorFree);
				    MmadParams mad;
				    mad.m = (rows + 15) / 16 * 16;
				    mad.n = (cols + 31) / 32 * 32;
				    mad.k = 64;
				    mad.cmatrixInitVal = fragment == 0;
				    Mmad(acc, a2[slot0], b2[slot0], mad);

				    if ((mad.m / 16) * (mad.n / 16) < 10)
					PipeBarrier<PIPE_M>();
				    SetFlag<HardEvent::M_MTE1>(l0Free[slot0]);
				    l0Used[slot0] = true;
				    ++fragment;
				}
				SetFlag<HardEvent::MTE1_MTE2>(l1Free[slot1]);
				if (panel + 2 < panels)
				{
				    PreparedPrefetch<TileM, PacketK>(
					gx, gw, a1[slot1], b1[slot1], true, l1Free[slot1],
					l1Ready[slot1], row, col, rows, cols, e, K, N, panel + 2,M,packedInput);
				}
			    }
			    SetFlag<HardEvent::M_FIX>(matrixReady);
			    WaitFlag<HardEvent::M_FIX>(matrixReady);

			    if (local >= SLOTS)
				CrossCoreWaitFlag<2, PIPE_FIX>(freeFlag);
			    FixpipeParamsV220 fix;
			    fix.nSize = (cols + 31) / 32 * 32;
			    fix.mSize = (rows + 15) / 16 * 16;
			    fix.srcStride = (rows + 15) / 16 * 16;
			    fix.dstStride = tn;
			    Fixpipe<int32_t, int32_t, CFG_ROW_MAJOR>(gcSlot, acc, fix);
			    SetFlag<HardEvent::FIX_M>(accumulatorFree);
			    CrossCoreSetFlag<2, PIPE_FIX>(tileFlag);
			}
			if ASCEND_IS_AIV
			{
			    CrossCoreWaitFlag<2, PIPE_MTE2>(tileFlag);
			    const int halfRows = (rows + 1) / 2;
			    const int rowOffset = lane * halfRows;
			    const int vectorRows = lane ? rows - halfRows : halfRows;
			    auto c = cq.AllocTensor<int32_t>();
			    auto scale = c.ReinterpretCast<float>()[((tm + 1) / 2 * tn) +
								    (tm * tn > 16384 ? 64 : 0)];

			    if (pitch != (cols + 7) / 8 * 8)
			    {
				Duplicate(c, int32_t(0), vectorRows * pitch);
				auto event = pipe.FetchEventID<HardEvent::V_MTE2>();
				SetFlag<HardEvent::V_MTE2>(event);
				WaitFlag<HardEvent::V_MTE2>(event);
			    }

			    if (vectorRows > 0)
				DataCopyPad(c, gcSlot[int64_t(rowOffset) * tn],
					    {uint16_t(vectorRows), uint32_t(cols * sizeof(int32_t)),
					     uint32_t((tn - cols) * sizeof(int32_t)),
					     uint32_t((pitch * 4 - (cols * 4 + 31) / 32 * 32) / 32),
					     0},
					    {true, 0, 0, 0});
			    if (cols < 64)
			    {
				Duplicate(scale, 0.0f, tn);
				auto initialized = pipe.FetchEventID<HardEvent::V_MTE2>();
				SetFlag<HardEvent::V_MTE2>(initialized);
				WaitFlag<HardEvent::V_MTE2>(initialized);
			    }
			    DataCopyPad(scale, gs[(int64_t)e * N + col],
					{1, (uint32_t)(cols * sizeof(float)), 0, 0, 0},
					{true, 0, 0, 0.0f});
			    cq.EnQue(c);
			    c = cq.DeQue<int32_t>();

			    CrossCoreSetFlag<2, PIPE_MTE2>(freeFlag);

			    auto z = zb.Get<float>();
			    auto p = c.ReinterpretCast<float>();
			    auto u = p;
			    auto t = p;

			    const BinaryRepeatParams bcast{
				1, 1, 1, (uint8_t)(pitch / 8), (uint8_t)(pitch / 8), 0};
			    for (int r = 0; r < vectorRows; r += vr)
			    {
				const int batch = (vectorRows - r < vr) ? (vectorRows - r) : vr;
				const uint32_t count = (uint32_t)batch * pitch;
				Cast(z, c[r * pitch], RoundMode::CAST_NONE, count);
				PipeBarrier<PIPE_V>();
				if (cols < 64)
				{
				    Mul(z, z, scale, (uint64_t)(pitch < 64 ? pitch : 64),
					(uint8_t)batch, bcast);
				}
				else
				{
				    for (int c0 = 0; c0 < cols; c0 += 64)
				    {
					const int chunk = (cols - c0 < 64) ? (cols - c0) : 64;
					Mul(z[c0], z[c0], scale[c0], (uint64_t)chunk,
					    (uint8_t)batch, bcast);
				    }
				}
				PipeBarrier<PIPE_V>();

				p = c[r * pitch].ReinterpretCast<float>();
				u = p;
				WeightPackedGeluTanh(z, p, u, t, count);
				auto out = oq.AllocTensor<half>();
				Cast(out, z, RoundMode::CAST_RINT, count);
				oq.EnQue(out);
				out = oq.DeQue<half>();
				const uint32_t outBytes = (uint32_t)cols * (uint32_t)sizeof(half);
				const uint32_t outPitchBytes =
				    (uint32_t)pitch * (uint32_t)sizeof(half);
				const uint32_t outSrcStride =
				    (outPitchBytes - ((outBytes + 31U) / 32U) * 32U) / 32U;
				for (int r0 = 0; r0 < batch; r0 += 32)
				{
				    const int rc = batch - r0 < 32 ? batch - r0 : 32;
				    DataCopyPad(gy[(int64_t)(row + rowOffset + r + r0) * N + col],
						out[r0 * pitch],
						{(uint16_t)rc, outBytes, outSrcStride,
						 (uint32_t)((N - cols) * sizeof(half)), 0});
				}
				oq.FreeTensor(out);
			    }
			    cq.FreeTensor(c);
			}
			++local;
		    }
		    nextTask = t - tasks;
		}
		begin = end;
	    }
	}
	if ASCEND_IS_AIC
	{

	    if (local > 0)
		CrossCoreWaitFlag<2, PIPE_MTE2>(FLAG_FREE0);
	    if (local > 1)
		CrossCoreWaitFlag<2, PIPE_MTE2>(FLAG_FREE1);
	    if (local > 0)
		WaitFlag<HardEvent::FIX_M>(accumulatorFree);
#pragma unroll
	    for (int i = 0; i < 2; ++i)
	    {
		if (l1Used[i])
		    WaitFlag<HardEvent::MTE1_MTE2>(l1Free[i]);
		pipe.ReleaseEventID<HardEvent::MTE1_MTE2>(l1Free[i]);
		pipe.ReleaseEventID<HardEvent::MTE2_MTE1>(l1Ready[i]);
	    }
#pragma unroll
	    for (int i = 0; i < L0Slots; ++i)
	    {
		if (l0Used[i])
		    WaitFlag<HardEvent::M_MTE1>(l0Free[i]);
		pipe.ReleaseEventID<HardEvent::M_MTE1>(l0Free[i]);
		pipe.ReleaseEventID<HardEvent::MTE1_M>(l0Ready[i]);
	    }
	    pipe.ReleaseEventID<HardEvent::FIX_M>(accumulatorFree);
	    pipe.ReleaseEventID<HardEvent::M_FIX>(matrixReady);
	}
    }
}
namespace gmm_expert {
template<int Rows,int Width>
__aicore__ inline void PrefetchXPipeline(LocalTensor<int8_t> a,GlobalTensor<int8_t> src,
 int M,int K,int task,uint8_t freeId,uint8_t readyId,bool& used) {
 const int kp=(K+63)/64*64,mp=(M+15)/16*16,kc=(kp+Width-1)/Width;
 const int row=task/kc*Rows,col=task%kc*Width,rows=mp-row<Rows?mp-row:Rows,cols=kp-col<Width?kp-col:Width;
 const int liveRows=M-row<rows?M-row:rows,liveCols=K-col<cols?K-col:cols;
 if(used)WaitFlag<HardEvent::V_MTE2>(freeId);
 if(liveRows<rows || cols>(liveCols+31)/32*32){
  Duplicate(a.ReinterpretCast<int32_t>(),int32_t(0),rows*cols/4);
  SetFlag<HardEvent::V_MTE2>(freeId);WaitFlag<HardEvent::V_MTE2>(freeId);
 }
 DataCopyPad(a,src[int64_t(row)*K+col],{uint16_t(liveRows),uint32_t(liveCols),uint32_t(K-liveCols),uint32_t((cols-(liveCols+31)/32*32)/32),0},{true,0,uint8_t((liveCols+31)/32*32-liveCols),int8_t(0)});
 SetFlag<HardEvent::MTE2_V>(readyId);used=true;
}
template<int Rows,int Width>
__aicore__ inline void PrepareXPipelined(GM_ADDR x,GM_ADDR xp,int M,int K) {
 if ASCEND_IS_AIV {
  TPipe pipe;TBuf<TPosition::VECCALC> ib[2],ob[2];
  uint8_t ifree[2],iready[2],ofree[2],oready[2];bool iu[2]={},ou[2]={};
  for(int s=0;s<2;++s){pipe.InitBuffer(ib[s],Rows*Width);pipe.InitBuffer(ob[s],Rows*Width);
   ifree[s]=pipe.AllocEventID<HardEvent::V_MTE2>();iready[s]=pipe.AllocEventID<HardEvent::MTE2_V>();
   ofree[s]=pipe.AllocEventID<HardEvent::MTE3_V>();oready[s]=pipe.AllocEventID<HardEvent::V_MTE3>();}
  const int kp=(K+63)/64*64,mp=(M+15)/16*16,kc=(kp+Width-1)/Width,mc=(mp+Rows-1)/Rows;
  const int cores=GetBlockNum()*2,block=GetBlockIdx(),total=mc*kc;
  GlobalTensor<int8_t> src,dst;src.SetGlobalBuffer((__gm__ int8_t*)x);dst.SetGlobalBuffer((__gm__ int8_t*)xp);
  for(int s=0;s<2;++s)if(block+s*cores<total)PrefetchXPipeline<Rows,Width>(ib[s].Get<int8_t>(),src,M,K,block+s*cores,ifree[s],iready[s],iu[s]);
  for(int i=0,task=block;task<total;task+=cores,++i){
   const int slot=i&1,row=task/kc*Rows,col=task%kc*Width,rows=mp-row<Rows?mp-row:Rows,cols=kp-col<Width?kp-col:Width;
   auto in=ib[slot].Get<int8_t>(),out=ob[slot].Get<int8_t>();
   WaitFlag<HardEvent::MTE2_V>(iready[slot]);if(ou[slot])WaitFlag<HardEvent::MTE3_V>(ofree[slot]);
   for(int c=0;c<cols/32;++c)DataCopy(out[c*rows*32],in[c*32],DataCopyParams{uint16_t(rows),1,uint16_t(cols/32-1),0});
   SetFlag<HardEvent::V_MTE3>(oready[slot]);WaitFlag<HardEvent::V_MTE3>(oready[slot]);
   SetFlag<HardEvent::V_MTE2>(ifree[slot]);
   DataCopy(dst[int64_t(col)*mp+row*32],out,DataCopyParams{uint16_t(cols/32),uint16_t(rows),0,uint16_t(mp-rows)});
   SetFlag<HardEvent::MTE3_V>(ofree[slot]);ou[slot]=true;
   if(task+2*cores<total)PrefetchXPipeline<Rows,Width>(ib[slot].Get<int8_t>(),src,M,K,task+2*cores,ifree[slot],iready[slot],iu[slot]);
  }
  for(int s=0;s<2;++s){if(iu[s])WaitFlag<HardEvent::V_MTE2>(ifree[s]);if(ou[s])WaitFlag<HardEvent::MTE3_V>(ofree[s]);
   pipe.ReleaseEventID<HardEvent::V_MTE2>(ifree[s]);pipe.ReleaseEventID<HardEvent::MTE2_V>(iready[s]);pipe.ReleaseEventID<HardEvent::MTE3_V>(ofree[s]);pipe.ReleaseEventID<HardEvent::V_MTE3>(oready[s]);}
  PipeBarrier<PIPE_ALL>();
 }
}
}
namespace GroupedPackedDevice {
__global__ __mix__(1,2) void Kernel(GM_ADDR x,GM_ADDR w,GM_ADDR sc,GM_ADDR groups,GM_ADDR y,GM_ADDR workspace,int M,int K,int N,int E,uint32_t halfL1,bool allowPackX,bool preferMFirst) {
    GM_ADDR xp=workspace+uint64_t(AscendC::GetBlockNum())*262144;
    GM_ADDR wp=xp+(allowPackX?uint64_t((M+15)/16*16)*((K+63)/64*64):0);
    int active=0,previous=0;
    if(allowPackX)for(int e=0;e<E;++e){const int end=int(((__gm__ int64_t*)groups)[e]);active+=end>previous;previous=end;}
    const bool packX=allowPackX && active>1;
    gmm_coop::PrepareActiveCube<32,2,0,false>(w,wp,M,K,N,E,groups);
    if(packX)gmm_expert::PrepareXPipelined<16,2048>(x,xp,M,K);
    AscendC::SyncAll<false>();
    AscendC::tiling::TCubeTiling unused{};
    gmm_device::PreparedGroupedCompute<128,256,512,4>(packX?xp:x,wp,sc,groups,y,workspace,M,K,N,E,unused,halfL1,packX,preferMFirst);
}
}
static void LaunchGroupedPacked(uint32_t cores,aclrtStream stream,GM_ADDR x,GM_ADDR w,GM_ADDR sc,GM_ADDR groups,GM_ADDR y,GM_ADDR workspace,int M,int K,int N,int E,uint32_t halfL1,bool allowPackX,bool preferMFirst) {
    GroupedPackedDevice::Kernel<<<cores,nullptr,stream>>>(x,w,sc,groups,y,workspace,M,K,N,E,halfL1,allowPackX,preferMFirst);
}
