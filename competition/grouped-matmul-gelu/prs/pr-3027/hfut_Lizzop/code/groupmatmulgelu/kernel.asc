#include "lib/matmul_intf.h"
#include "tiling/tiling_api.h"
#include <stdexcept>

__aicore__ inline int64_t GmmFloatToQ(float x)
{
    union
    {
	float f;
	uint32_t bits;
    } v;
    v.f = x;
    uint32_t a = v.bits & 0x7fffffffU;
    if (!a)
	return 0;
    int shift = (int)((a >> 23) & 255) - 127 + 27;
    uint64_t mant = (a & 0x7fffffU) | 0x800000U;
    uint64_t q = shift >= 0 ? mant << shift : (shift > -64 ? mant >> -shift : 0);
    return v.bits >> 31 ? -(int64_t)q : (int64_t)q;
}
__aicore__ inline float GmmQToFloat(int64_t x)
{
    union
    {
	float f;
	uint32_t bits;
    } v;
    if (!x)
    {
	v.bits = 0;
	return v.f;
    }
    uint64_t a = x < 0 ? -x : x;
    int top = 63 - __builtin_clzll(a), shift = top - 23;
    uint64_t mant;
    if (shift > 0)
    {
	mant = a >> shift;
	uint64_t rem = a & ((1ULL << shift) - 1), halfWay = 1ULL << (shift - 1);
	if (rem > halfWay || (rem == halfWay && (mant & 1)))
	    ++mant;
	if (mant == (1ULL << 24))
	{
	    mant >>= 1;
	    ++top;
	}
    }
    else
	mant = a << -shift;
    v.bits = (x < 0 ? 0x80000000U : 0) | ((uint32_t)(top - 50 + 127) << 23) |
	     ((uint32_t)mant & 0x7fffffU);
    return v.f;
}
__aicore__ inline int64_t GmmQMul(int64_t a, int64_t b)
{
    bool neg = (a < 0) != (b < 0);
    uint64_t aa = a < 0 ? -a : a, bb = b < 0 ? -b : b;
    const uint64_t mask = (1ULL << 25) - 1;
    uint64_t ah = aa >> 25, al = aa & mask, bh = bb >> 25, bl = bb & mask;
    uint64_t v = ah * bh + ((ah * bl + al * bh + ((al * bl) >> 25) + (1ULL << 24)) >> 25);
    return neg ? -(int64_t)v : (int64_t)v;
}
__aicore__ inline int64_t GmmQExpNeg(int64_t a)
{
    const int64_t Q = 1LL << 50, ln2 = 780414346020670LL;
    int64_t n = (a + ln2 / 2) / ln2;
    if (n > 53)
	return 0;
    int64_t r = a - n * ln2, r2 = GmmQMul(r, r);

    int64_t even = Q + GmmQMul(r2, 125099989649180LL + GmmQMul(r2, 1116964193296LL));
    int64_t odd =
	GmmQMul(r, 562949953421312LL + GmmQMul(r2, 15637498706148LL + GmmQMul(r2, 37232139777LL)));
    int64_t den = even + odd;
    int64_t inv = GmmFloatToQ(1.0f / GmmQToFloat(den));
    inv = GmmQMul(inv, 2 * Q - GmmQMul(den, inv));
    inv = GmmQMul(inv, 2 * Q - GmmQMul(den, inv));
    return GmmQMul(even - odd, inv) >> n;
}
__aicore__ inline float GmmRefine(float z)
{
    if (z >= 8.0f)
	return z;
    if (z <= -8.0f)
	return 0.0f;
    const int64_t Q = 1LL << 50;
    int64_t zq = GmmFloatToQ(z);
    int64_t cubic = GmmQMul(GmmQMul(zq, zq), zq);
    int64_t inner = GmmQMul(898338152679114LL, zq + GmmQMul(50344614334468LL, cubic));
    int64_t tail = GmmQExpNeg(2 * (inner < 0 ? -inner : inner));
    int64_t den = Q + tail;
    float df = GmmQToFloat(den);
    int64_t inv = GmmFloatToQ(1.0f / df);
    inv = GmmQMul(inv, 2 * Q - GmmQMul(den, inv));
    inv = GmmQMul(inv, 2 * Q - GmmQMul(den, inv));
    int64_t value = GmmQMul(inner >= 0 ? zq : GmmQMul(zq, tail), inv);
    union
    {
	float f;
	uint32_t bits;
    } v;
    v.f = GmmQToFloat(value);
    int64_t back = GmmFloatToQ(v.f);
    uint32_t ab = v.bits & 0x7fffffffU;
    uint64_t backAbs = back < 0 ? -back : back;
    bool mid = ab >= 0x38800000U ? ((ab & 8191U) == 4096U)
				 : ((backAbs & ((1ULL << 26) - 1)) == (1ULL << 25));
    if (mid)
    {
	if (back > value)
	    v.bits += v.f > 0 ? -1 : 1;
	else if (back < value)
	    v.bits += v.f > 0 ? 1 : -1;
	else if (v.f == z && z > 4.0f && z < 7.09f)
	    --v.bits;
    }
    return v.f;
}



