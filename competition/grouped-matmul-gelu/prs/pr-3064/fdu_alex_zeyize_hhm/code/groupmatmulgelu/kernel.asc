const int padded=(columns+31)&~31;
capi_read_pad(inputBits,reinterpret_cast<__gm__ uint32_t*>(scale)+
(int64_t)expert*p.n+column,DataCopyExtParams{1,(uint32_t)columns*4,0,0,0},
DataCopyPadExtParams<uint32_t>{true,0,0,0});
capi_notify<PIPE_MTE2,PIPE_S>(7);capi_wait<PIPE_MTE2,PIPE_S>(7);
for(int n=0;n<padded;++n) {
uint32_t bits=n<columns?inputBits[n]:0;
bits=(bits+0xfffu+((bits>>13)&1u))&0xffffe000u;
encoded[n]=uint64_t(bits);
}
capi_notify<PIPE_S,PIPE_MTE3>(7);capi_wait<PIPE_S,PIPE_MTE3>(7);
capi_write(quantizedScales+(int64_t)expert*quantizedStride+column,encoded,padded);
capi_notify<PIPE_MTE3,PIPE_S>(7);capi_wait<PIPE_MTE3,PIPE_S>(7);
}
capi_block_arrive<PIPE_MTE3,0>(7);asc_sync_block_wait(7);
capi_block_arrive<PIPE_MTE3,2>(5);
}
}
if constexpr(CooperativePack) {
if ASCEND_IS_AIV {
capi_gather_pack_weights<BM,BN,StageMajorWeights,DeferredNarrowWeights>(weight,workspace,p);
if constexpr(ColumnDequant) {
::capi_prepare_column_coefficients<false>(scale,quantizedScales,p);
capi_block_arrive<PIPE_MTE3,0>(8);asc_sync_block_wait(8);
capi_block_arrive<PIPE_MTE3,2>(8);
}
}
else {capi_cube_pack_partition<BM,BN,StageMajorWeights,DeferredNarrowWeights>(weight,groups,workspace,p);}
} else if constexpr (VectorPackWeights && (Mode==2 || Mode==3 || Mode==4 || Mode==5 || Mode==6)) {
if ASCEND_IS_AIC {
int stride=(p.n+31)&~31;
int packRows=(192*1024/stride)/32*32;
if(packRows>256)packRows=256;
int slotBytes=packRows*stride;
int paddedK=(p.k+31)&~31;
int unitsPerExpert=paddedK/32;
int units=p.e*unitsPerExpert;
int first=units*core/p.cores,stop=units*(core+1)/p.cores;
first=capi_next_active_pack_unit(ends,first,stop,unitsPerExpert);
auto source=reinterpret_cast<__gm__ int8_t*>(weight);
bool pending[2]={false,false};
if(first<stop) {
int expert=first/unitsPerExpert,row=(first%unitsPerExpert)*32;
int countUnits=unitsPerExpert-first%unitsPerExpert;
if(countUnits>stop-first)countUnits=stop-first;
if(countUnits>packRows/32)countUnits=packRows/32;
int count=p.k-row<countUnits*32?p.k-row:countUnits*32;
auto local=reinterpret_cast<__cbuf__ int8_t*>(uint64_t(0));
if constexpr(StageMajorWeights) {
capi_pack_weight_k32_batches(local,source,int64_t(expert)*p.k+row,count,p);
} else if constexpr(Mode==3 && BM==80 && BN==384 && BStages==2) {
if(p.k>1024 && p.k<=1056 && p.n>1024 && p.n<=1056 && (p.n&1))
capi_pack_weight_halfwords(local,source,int64_t(expert)*p.k+row,count,p);
else capi_nd_to_nz(local,source+((int64_t)expert*p.k+row)*p.n,
count,p.n,p.n,(count+31)&~31);
} else if constexpr(Mode==3 && BM==96 && BN==320 && BStages==2) {
if(p.k>1024 && p.k<=1056 && p.n>768 && p.n<=800 && (p.n&1))
capi_pack_weight_halfwords(local,source,int64_t(expert)*p.k+row,count,p);
else capi_nd_to_nz(local,source+((int64_t)expert*p.k+row)*p.n,
count,p.n,p.n,(count+31)&~31);
} else capi_nd_to_nz(local,source+((int64_t)expert*p.k+row)*p.n,
count,p.n,p.n,(count+31)&~31);
capi_notify<PIPE_MTE2,PIPE_MTE3>(4);
}
int iteration=0;
for(int unit=first;unit<stop;) {
int stage=(iteration++)&1;
int expert=unit/unitsPerExpert,row=(unit%unitsPerExpert)*32;
int countUnits=unitsPerExpert-unit%unitsPerExpert;
if(countUnits>stop-unit)countUnits=stop-unit;
if(countUnits>packRows/32)countUnits=packRows/32;
int paddedCount=countUnits*32;
int count=p.k-row<paddedCount?p.k-row:paddedCount;
int nextUnit=capi_next_active_pack_unit(
ends,unit+countUnits,stop,unitsPerExpert);
if(nextUnit<stop) {
int nextStage=stage^1;
if(pending[nextStage]) {
capi_wait<PIPE_MTE3,PIPE_MTE2>(4+nextStage);
pending[nextStage]=false;
}
int nextExpert=nextUnit/unitsPerExpert,nextRow=(nextUnit%unitsPerExpert)*32;
int nextUnits=unitsPerExpert-nextUnit%unitsPerExpert;
if(nextUnits>stop-nextUnit)nextUnits=stop-nextUnit;
if(nextUnits>packRows/32)nextUnits=packRows/32;
int nextCount=p.k-nextRow<nextUnits*32?p.k-nextRow:nextUnits*32;
auto next=reinterpret_cast<__cbuf__ int8_t*>(uint64_t(nextStage*slotBytes));
if constexpr(StageMajorWeights) {
capi_pack_weight_k32_batches(next,source,int64_t(nextExpert)*p.k+nextRow,nextCount,p);
} else if constexpr(Mode==3 && BM==80 && BN==384 && BStages==2) {
if(p.k>1024 && p.k<=1056 && p.n>1024 && p.n<=1056 && (p.n&1))
capi_pack_weight_halfwords(next,source,int64_t(nextExpert)*p.k+nextRow,nextCount,p);
else capi_nd_to_nz(next,source+((int64_t)nextExpert*p.k+nextRow)*p.n,
nextCount,p.n,p.n,(nextCount+31)&~31);
} else if constexpr(Mode==3 && BM==96 && BN==320 && BStages==2) {
if(p.k>1024 && p.k<=1056 && p.n>768 && p.n<=800 && (p.n&1))
capi_pack_weight_halfwords(next,source,int64_t(nextExpert)*p.k+nextRow,nextCount,p);
else capi_nd_to_nz(next,source+((int64_t)nextExpert*p.k+nextRow)*p.n,
nextCount,p.n,p.n,(nextCount+31)&~31);
} else capi_nd_to_nz(next,source+((int64_t)nextExpert*p.k+nextRow)*p.n,
nextCount,p.n,p.n,(nextCount+31)&~31);
capi_notify<PIPE_MTE2,PIPE_MTE3>(4+nextStage);
}
capi_wait<PIPE_MTE2,PIPE_MTE3>(4+stage);
auto local=reinterpret_cast<__cbuf__ int8_t*>(uint64_t(stage*slotBytes));
if constexpr(StageMajorWeights) {
auto destination=packedWeights+(int64_t(expert)*paddedK+row)*stride;
copy_cbuf_to_gm(reinterpret_cast<__gm__ void*>(destination),
reinterpret_cast<__cbuf__ void*>(local),0,1,paddedCount*stride/32,0,0);
} else {
auto destination=packedWeights+
((int64_t)expert*(stride/32)*paddedK+row)*32;
copy_cbuf_to_gm(reinterpret_cast<__gm__ void*>(destination),
reinterpret_cast<__cbuf__ void*>(local),0,
stride/32,paddedCount,0,paddedK-paddedCount);
}
capi_notify<PIPE_MTE3,PIPE_MTE2>(4+stage);
pending[stage]=true;
unit=nextUnit;
}
for(int stage=0;stage<2;++stage)
if(pending[stage])capi_wait<PIPE_MTE3,PIPE_MTE2>(4+stage);
if constexpr(!PrimeBeforePackWait) {
capi_block_arrive<PIPE_MTE3,0>(6);
asc_sync_block_wait(6);
capi_block_arrive<PIPE_MTE3,2>(4);
}
} else {
asc_sync_block_wait(4);
}
} else if constexpr (VectorPackWeights) {
if ASCEND_IS_AIV {
constexpr int SlotBytes=48*1024;
int stride=(p.n+31)&~31;
int PackRows=(SlotBytes/stride)/32*32;
if(PackRows>64)PackRows=64;
int paddedK=(p.k+31)&~31;
int lane=core*2+asc_get_sub_block_id(),lanes=p.cores*2;
int chunks=(p.k+PackRows-1)/PackRows;
int jobs=p.e*chunks;
int first=jobs*lane/lanes,stop=jobs*(lane+1)/lanes;
auto source=reinterpret_cast<__gm__ uint8_t*>(weight);
bool pending[2]={false,false};
if(first<stop) {
int expert=first/chunks,row=(first%chunks)*PackRows;
int count=p.k-row<PackRows?p.k-row:PackRows;
auto initial=reinterpret_cast<__ubuf__ uint8_t*>(uint64_t(0));
asc_copy_gm2ub_align(initial,source+((int64_t)expert*p.k+row)*p.n,
count,p.n,0,0,0,0);
capi_notify<PIPE_MTE2,PIPE_V>(4);
}
for(int job=first;job<stop;++job) {
int stage=(job-first)&1;
int expert=job/chunks,row=(job%chunks)*PackRows;
int count=p.k-row<PackRows?p.k-row:PackRows;
int paddedCount=(count+31)&~31;
if(job+1<stop) {
int nextStage=stage^1,nextJob=job+1;
if(pending[nextStage]) {
capi_wait<PIPE_MTE3,PIPE_MTE2>(4+nextStage);
pending[nextStage]=false;
}
int nextExpert=nextJob/chunks,nextRow=(nextJob%chunks)*PackRows;
int nextCount=p.k-nextRow<PackRows?p.k-nextRow:PackRows;
auto next=reinterpret_cast<__ubuf__ uint8_t*>(uint64_t(nextStage*SlotBytes));
asc_copy_gm2ub_align(next,source+((int64_t)nextExpert*p.k+nextRow)*p.n,
nextCount,p.n,0,0,0,0);
capi_notify<PIPE_MTE2,PIPE_V>(4+nextStage);
}
capi_wait<PIPE_MTE2,PIPE_V>(4+stage);
auto staging=reinterpret_cast<__ubuf__ uint32_t*>(uint64_t(stage*SlotBytes));
auto ordered=reinterpret_cast<__ubuf__ uint32_t*>(uint64_t((stage+2)*SlotBytes));
asc_set_mask_norm();asc_set_vector_mask(0,~uint64_t(0));
for(int column=0;column<stride;column+=32) {
asc_copy(ordered+(column/32)*PackRows*8,staging+column/4,
PackRows/8,1,stride/32,8,8*stride/32);
}
capi_notify<PIPE_V,PIPE_MTE3>(4+stage);
capi_wait<PIPE_V,PIPE_MTE3>(4+stage);
auto destination=reinterpret_cast<__gm__ uint8_t*>(packedWeights)+
((int64_t)expert*(stride/32)*paddedK+row)*32;
asc_copy_ub2gm_align(destination,reinterpret_cast<__ubuf__ uint8_t*>(ordered),
stride/32,paddedCount*32,0,0,PackRows-paddedCount,
(paddedK-paddedCount)*32);
capi_notify<PIPE_MTE3,PIPE_MTE2>(4+stage);
pending[stage]=true;
}
for(int stage=0;stage<2;++stage)
if(pending[stage])capi_wait<PIPE_MTE3,PIPE_MTE2>(4+stage);
capi_block_arrive<PIPE_MTE3,0>(6);
asc_sync_block_wait(6);
capi_block_arrive<PIPE_MTE3,2>(4);
} else {
asc_sync_block_wait(4);
}
}
CapiTraversal<BM,BN,Mode,Rotate> traversal(ends,p,core);
CapiTile tile;
CapiMemory memory;
if ASCEND_IS_AIC {
using OriginalEngine=CapiPanelEngine<BM,BN,BK,KP,(Mode==1 || Mode==5 || PrefetchRows),
((Mode>=2 && Mode<=4) || Mode==8),PIPE_FIX,PrefetchRows,InplaceResidentBPrefetch,Mode==6,VectorPackWeights,BStages,(Mode==4),COMPACT_SCRATCH,(Mode==2 || Mode==4),(Mode==4 || ColumnDequant),CacheExpertActivation,NarrowHalfScratch,StageMajorWeights>;
using Engine=typename std::conditional<Mode==4 && BM==128 && BN==256,
CceBufferedResidentEngine<BM,BN,KP,true>,OriginalEngine>::type;
Engine engine;
engine.Init(memory,p,reinterpret_cast<__gm__ int8_t*>(x),
VectorPackWeights?packedWeights:reinterpret_cast<__gm__ int8_t*>(weight),quantizedScales,ends);
if constexpr(ColumnDequant)engine.coefficientReadyEvent=8;
int produced=0;
bool active=traversal.Next(tile);
if constexpr(PrimeBeforePackWait) {
static_assert(VectorPackWeights && (Mode==2 || Mode==4) && !PrefetchRows,
"Only streamed activations use this packing overlap");
if(active) {
engine.LoadA(tile,0,p.k<KP?p.k:KP);
engine.aPrefetched=true;
}
if constexpr(!CooperativePack || DeferredNarrowWeights) {
capi_block_arrive<PIPE_MTE3,0>(6);
asc_sync_block_wait(6);
capi_block_arrive<PIPE_MTE3,2>(4);
if constexpr(DeferredNarrowWeights)asc_sync_block_wait(5);
}
}
if constexpr(Mode==4)asc_sync_block_wait(5);
while(active) {
CapiTile next;
bool hasNext=traversal.Next(next);
int slot=SingleTile?0:produced&1;
engine.Multiply(tile,scratch+slot*BM*BN,
hasNext?&next:nullptr,!SingleTile && produced>=2?2+slot:-1);
capi_block_arrive<PIPE_FIX,2>(slot);
++produced;
active=hasNext;
if(hasNext)tile=next;
}
engine.Finish();
if constexpr (!SingleTile) {
if(produced>=1)asc_sync_block_wait(2);
if(produced>=2)asc_sync_block_wait(3);
}
} else {
if constexpr(Mode==4) {
constexpr int Rows=32,Count=Rows*BN;
CapiBuffer inputs,temporary;
memory.InitBuffer(inputs,Count*4+256);
memory.InitBuffer(temporary,Count*2+256);
auto values=inputs.Get<half>();auto temp=temporary.Get<half>();
bool pending[2]={false,false};int consumed=0;
while(traversal.Next(tile)) {
const int slot=(consumed++)&1;
const int halfRows=capi_vector_half_rows<BM>(tile.rows,BM/2);
const int slice=asc_get_sub_block_id()*halfRows;
const int localRows=tile.rows-slice<halfRows?tile.rows-slice:halfRows;
asc_sync_block_wait(slot);
if(localRows<=0){capi_block_arrive<PIPE_MTE2,2>(2+slot);continue;}
if(pending[slot]){capi_wait<PIPE_MTE3,PIPE_MTE2>(slot);pending[slot]=false;}
const int firstRows=localRows<Rows?localRows:Rows;
capi_read(values+slot*Count,reinterpret_cast<__gm__ half*>(scratch+slot*BM*BN)+
slice*BN,firstRows*BN);
capi_notify<PIPE_MTE2,PIPE_V>(slot);
if(firstRows==localRows)capi_block_arrive<PIPE_MTE2,2>(2+slot);
for(int part=0;part<localRows;part+=Rows) {
const int stage=(slot+part/Rows)&1;
const int rows=localRows-part<Rows?localRows-part:Rows;
capi_wait<PIPE_MTE2,PIPE_V>(stage);
if(part+rows<localRows) {
const int next=stage^1;
const int nextRows=localRows-part-rows<Rows?localRows-part-rows:Rows;
if(pending[next]){capi_wait<PIPE_MTE3,PIPE_MTE2>(next);pending[next]=false;}
capi_read(values+next*Count,reinterpret_cast<__gm__ half*>(scratch+slot*BM*BN)+
(slice+part+rows)*BN,nextRows*BN);
capi_notify<PIPE_MTE2,PIPE_V>(next);
if(part+rows+nextRows==localRows)capi_block_arrive<PIPE_MTE2,2>(2+slot);
}
auto value=values+stage*Count;
::capi_finish_scaled_half_banked(value,rows*BN);
capi_notify<PIPE_V,PIPE_MTE3>(0);capi_wait<PIPE_V,PIPE_MTE3>(0);
capi_write_pad(reinterpret_cast<__gm__ half*>(output)+
(int64_t)(tile.row+slice+part)*p.n+tile.column,value,
DataCopyExtParams{(uint16_t)rows,(uint32_t)tile.columns*2,
(uint32_t)(BN-((tile.columns+15)&~15))/16,(uint32_t)(p.n-tile.columns)*2,0});
capi_notify<PIPE_MTE3,PIPE_MTE2>(stage);pending[stage]=true;
}
}
for(int stage=0;stage<2;++stage)if(pending[stage])capi_wait<PIPE_MTE3,PIPE_MTE2>(stage);
} else if constexpr(!SingleTile && !FusedAffine && Mode==2) {
if constexpr(NarrowHalfScratch)
::capi_half_vector_stream<BM,BN,CHUNK,ReuseAccumulator,BUFFERED_GELU,PackTail,FineTail,true,COMPACT_SCRATCH,ColumnDequant>(
traversal,tile,p,scratch,scale,output);
else
::capi_vector_stream<BM,BN,CHUNK,ReuseAccumulator,BUFFERED_GELU,PackTail,FineTail,true,COMPACT_SCRATCH>(
traversal,tile,p,scratch,scale,output);
} else {
CapiBuffer cb,zb,vb,tb,sb;
memory.InitBuffer(cb,SIZE*8+PAD);
memory.InitBuffer(zb,ReuseAccumulator?0:SIZE*4+PAD);
memory.InitBuffer(vb,SIZE*4+PAD);
if constexpr(BUFFERED_GELU)memory.InitBuffer(tb,TEMP_SIZE*4+PAD);
memory.InitBuffer(sb,BN*4+PAD);
auto storage=cb.Get<int32_t>();
auto z=zb.Get<float>();auto v=vb.Get<float>();auto scales=sb.Get<float>();
auto temporary=tb.Get<float>();
if constexpr (FusedAffine)capi_init_gelu_affine();
auto sg=reinterpret_cast<__gm__ float*>(scale);
auto yg=reinterpret_cast<__gm__ half*>(output);
bool pending[2]={false,false},scalePending=false;
int lastExpert=-1,lastColumn=-1,consumed=0;
while(traversal.Next(tile)) {
int slot=SingleTile?0:(consumed&1);
++consumed;
int halfRows=capi_vector_half_rows<BM>(tile.rows,
(BM==96 && BN==320)?(tile.rows+1)/2:BM/2);
int slice=asc_get_sub_block_id()*halfRows;
int localRows=tile.rows-slice<halfRows?tile.rows-slice:halfRows;
if(localRows>0 && (tile.expert!=lastExpert || tile.column!=lastColumn)) {
if(scalePending) {
capi_wait<PIPE_V,PIPE_MTE2>(0);scalePending=false;
}
DataCopyExtParams sp{1,(uint32_t)tile.columns*4,0,0,0};
capi_read_pad(scales,sg+(int64_t)tile.expert*p.n+tile.column,
sp,DataCopyPadExtParams<float>{true,0,0,0.0f});
lastExpert=tile.expert;lastColumn=tile.column;
}
asc_sync_block_wait(slot);
if(localRows<=0) {
if constexpr (!SingleTile)capi_block_arrive<PIPE_MTE2,2>(2+slot);
continue;
}
int rowStride=BN;
if constexpr (PackTail) {
if constexpr (FineTail) {
if(tile.columns<=16)rowStride=16;
else if(tile.columns<=32)rowStride=32;
else if(tile.columns<=64)rowStride=64;
else if(tile.columns<=128)rowStride=128;
else rowStride=(tile.columns+15)&~15;
} else {
if(tile.columns<=64 && localRows%2==0 && CHUNK%2==0)rowStride=64;
else if(tile.columns<=128)rowStride=128;
}
}
rowStride=capi_vector_row_stride(tile.columns,rowStride);
int fullWidth=FineTail?(rowStride&~63):rowStride;
int remaining=FineTail?rowStride-fullWidth:0;
uint64_t tailMask=remaining?(uint64_t(1)<<remaining)-1:0;
int firstRows=localRows<CHUNK?localRows:CHUNK;
if(pending[slot]){capi_wait<PIPE_MTE3,PIPE_MTE2>(slot);pending[slot]=false;}
capi_copy_accumulator_rows<BN,PackTail>(storage+slot*SIZE,
scratch+slot*BM*BN+slice*BN,firstRows,rowStride);
capi_notify<PIPE_MTE2,PIPE_V>(slot);
if constexpr (!SingleTile)if(firstRows==localRows)
capi_block_arrive<PIPE_MTE2,2>(2+slot);
for(int part=0;part<localRows;part+=CHUNK) {
int stage=(slot+part/CHUNK)&1;
int nr=localRows-part<CHUNK?localRows-part:CHUNK;
int active=nr*rowStride;
capi_wait<PIPE_MTE2,PIPE_V>(stage);
if(part+nr<localRows) {
int next=stage^1;
if(pending[next]){capi_wait<PIPE_MTE3,PIPE_MTE2>(next);pending[next]=false;}
int nextRows=localRows-part-nr<CHUNK?localRows-part-nr:CHUNK;
capi_copy_accumulator_rows<BN,PackTail>(storage+next*SIZE,
scratch+slot*BM*BN+(slice+part+nr)*BN,nextRows,rowStride);
capi_notify<PIPE_MTE2,PIPE_V>(next);
if constexpr (!SingleTile)if(part+nr+nextRows==localRows)
capi_block_arrive<PIPE_MTE2,2>(2+slot);
}
auto ci=storage+stage*SIZE;
if constexpr (ReuseAccumulator)z=reinterpret_cast<__ubuf__ float*>(ci);
auto out=reinterpret_cast<__ubuf__ half*>(ci);
asc_int322float_rn(z,ci,active);asc_sync_pipe(PIPE_V);
asc_set_mask_norm();
asc_set_vector_mask(0,~uint64_t(0));
#pragma unroll
for(int column=0;column<BN;column+=64) {
if(column<fullWidth)
asc_mul(z+column,z+column,scales+column,nr,1,1,1,
rowStride/8,rowStride/8,0);
}
if constexpr (FineTail) {
if(remaining>0) {
asc_set_vector_mask(0,tailMask);
asc_mul(z+fullWidth,z+fullWidth,scales+fullWidth,nr,1,1,1,
rowStride/8,rowStride/8,0);
}
}
asc_sync_pipe(PIPE_V);
if constexpr(!BUFFERED_GELU) {
capi_finish_gelu<FusedAffine>(z,v,out,active);
} else if constexpr(FusedAffine) {
auto multiplier=reinterpret_cast<__ubuf__ float*>(uint64_t(GELU_MULTIPLIER_ADDRESS));
auto bias=reinterpret_cast<__ubuf__ float*>(uint64_t(GELU_BIAS_ADDRESS));
::capi_finish_gelu_buffered<TEMP_SIZE,true>(z,v,temporary,out,active,multiplier,bias);
} else {
::capi_finish_gelu_buffered<TEMP_SIZE>(z,v,temporary,out,active);
}
capi_notify<PIPE_V,PIPE_MTE3>(0);capi_wait<PIPE_V,PIPE_MTE3>(0);
DataCopyExtParams op{(uint16_t)nr,(uint32_t)tile.columns*2,
(uint32_t)((rowStride-((tile.columns+15)&~15))/16),
(uint32_t)(p.n-tile.columns)*2,0};
capi_write_pad(yg+(int64_t)(tile.row+slice+part)*p.n+tile.column,out,op);
capi_notify<PIPE_MTE3,PIPE_MTE2>(stage);pending[stage]=true;
}
if(scalePending)capi_wait<PIPE_V,PIPE_MTE2>(0);
capi_notify<PIPE_V,PIPE_MTE2>(0);scalePending=true;
}
if(scalePending)capi_wait<PIPE_V,PIPE_MTE2>(0);
for(int stage=0;stage<2;++stage)
if(pending[stage])capi_wait<PIPE_MTE3,PIPE_MTE2>(stage);
}
}
}
}
namespace NdPanels {
template<bool ConfigureMatrix=true>
__aicore__ inline void capi_l1_to_l0a(__ca__ int8_t* dst, __cbuf__ int8_t* src,
uint32_t rows, uint32_t columns, uint32_t alignedRows,
uint32_t sourceColumns = 0, uint32_t columnOffset = 0) {
if (sourceColumns == 0) sourceColumns = columns;
if constexpr (ConfigureMatrix) {
asc_l13d_fmatrix_config matrix{};
matrix.config = (uint64_t(1) << 16) | alignedRows;
asc_set_l13d_fmatrix(matrix);
}
asc_copy_l12l0a(dst, src, columns, alignedRows, columnOffset, 0,
1, 1, 1, 1, 1, 1, false, false, false, false, sourceColumns);
}
__aicore__ inline void capi_l1_to_l0b(__cb__ int8_t* dst, __cbuf__ int8_t* src,
uint32_t rows, uint32_t columns, uint32_t alignedRows) {
uint32_t reductionBlocks = (rows + 31) / 32;
uint32_t sourceStride = (alignedRows + 31) / 32;
uint32_t columnBlocks = (columns + 31) / 32;
uint32_t destinationStride = ((columns + 15) / 16) * 16 * 32;
for (uint32_t block = 0; block < reductionBlocks; ++block)
asc_copy_l12l0b_trans(dst + block * destinationStride, src + block * 1024,
0, columnBlocks, sourceStride, 1, false, 0);
}
constexpr int GELU_AFFINE_BYTES=768;
constexpr int GELU_MULTIPLIER_ADDRESS=192*1024-GELU_AFFINE_BYTES;
constexpr int GELU_BIAS_ADDRESS=GELU_MULTIPLIER_ADDRESS+352;
__aicore__ inline void capi_init_gelu_affine() {
auto multiplier=reinterpret_cast<__ubuf__ float*>(uint64_t(GELU_MULTIPLIER_ADDRESS));
auto bias=reinterpret_cast<__ubuf__ float*>(uint64_t(GELU_BIAS_ADDRESS));
asc_set_mask_norm();asc_set_vector_mask(0,~uint64_t(0));
asc_duplicate(multiplier,-0.07135481627260091f,1,1,8);
asc_duplicate(bias,-1.5957691216057308f,1,1,8);
asc_sync_pipe(PIPE_V);
}
template<bool FusedAffine=false>
__aicore__ inline void capi_finish_gelu(__ubuf__ float* z, __ubuf__ float* v,
__ubuf__ half* out, int count) {
asc_set_mask_count();
asc_set_vector_mask(0, count);
asc_mul(v, z, z, 1, 1, 1, 1, 8, 8, 8); asc_sync_pipe(PIPE_V);
if constexpr (FusedAffine) {
auto multiplier=reinterpret_cast<__ubuf__ float*>(uint64_t(GELU_MULTIPLIER_ADDRESS));
auto bias=reinterpret_cast<__ubuf__ float*>(uint64_t(GELU_BIAS_ADDRESS));
asc_mul_add(v,multiplier,bias,1,1,1,1,8,0,0);asc_sync_pipe(PIPE_V);
} else {
asc_mul_scalar(v, v, -0.07135481627260091f, 1, 1, 1, 8, 8); asc_sync_pipe(PIPE_V);
asc_add_scalar(v, v, -1.5957691216057308f, 1, 1, 1, 8, 8); asc_sync_pipe(PIPE_V);
}
asc_mul(v, v, z, 1, 1, 1, 1, 8, 8, 8); asc_sync_pipe(PIPE_V);
asc_min_scalar(v, v, 80.0f, 1, 1, 1, 8, 8); asc_sync_pipe(PIPE_V);
asc_exp(v, v, 1, 1, 1, 8, 8); asc_sync_pipe(PIPE_V);
asc_add_scalar(v, v, 1.0f, 1, 1, 1, 8, 8); asc_sync_pipe(PIPE_V);
asc_div(v, z, v, 1, 1, 1, 1, 8, 8, 8); asc_sync_pipe(PIPE_V);
asc_set_mask_norm();
asc_set_vector_mask(~uint64_t(0), ~uint64_t(0));
asc_float2half_rn(out, v, count);
asc_sync_pipe(PIPE_V);
}
struct CapiTile {
int expert, row, column, rows, columns;
};
template<int BM, int BN, int Mode, int Rotate>
struct CapiTraversal {
__gm__ int64_t* ends;
GmmPlan p;
int core, expert=0, rowTile=0, columnTile=0;
int rowBase=0, begin=0, index;
int64_t workBase=0, low=0, high=0;
__aicore__ CapiTraversal(__gm__ int64_t* groups, GmmPlan plan, int block)
: ends(groups), p(plan), core(block), index(block) {
if constexpr (Mode==5 || Mode==8) {
int strips=(p.n+31)/32;
int64_t work=(int64_t)p.e*strips;
low=work*core/p.cores;
high=work*(core+1)/p.cores;
expert=low/strips;
begin=expert==0?0:ends[expert-1];
}
if constexpr (Mode==2 || Mode==4) {
int active=0, previous=0;
if constexpr (Mode==4) {
for(int e=0;e<p.e;++e) {
int end=ends[e];
if(end>previous)++active;
previous=end;
}
}
int64_t total=((int64_t)p.m+(Mode==4?int64_t(active)*BM*2:0))*p.n;
low=(total*core+p.cores-1)/p.cores;
high=(total*(core+1)+p.cores-1)/p.cores;
if constexpr (Mode==2) {
int limit=p.e;
while(expert<limit) {
int middle=expert+(limit-expert)/2;
if((int64_t)ends[middle]*p.n<=low)expert=middle+1;
else limit=middle;
}
begin=expert==0?0:ends[expert-1];
}
}
}
__aicore__ inline bool Next(CapiTile& result) {
int nt=(p.n+BN-1)/BN;
if constexpr (Mode==3) {
while(index<p.e*nt) {
int e=index/nt;
int c=(index-e*nt+e)%nt;
int first=e==0?0:ends[e-1],end=ends[e];
int rt=(end-first+BM-1)/BM;
if(rowTile>=rt){index+=p.cores;rowTile=0;continue;}
int row=first+(rowTile++)*BM,col=c*BN;
result={e,row,col,end-row<BM?end-row:BM,p.n-col<BN?p.n-col:BN};
return true;
}
return false;
}
while(expert<p.e) {
int end=ends[expert];
int rows=end-begin, rt=(rows+BM-1)/BM;
if constexpr (Mode==8) {
if(low>=high)return false;
int strips=(p.n+31)/32;
int64_t groupBegin=(int64_t)expert*strips;
int available=high-groupBegin<strips?(int)(high-groupBegin):strips;
int start=(int)(low-groupBegin);
if(!rt || start>=available) {
low=groupBegin+available;begin=end;++expert;rowTile=0;
continue;
}
int remaining=available-start;
int panels=(remaining+BN/32-1)/(BN/32);
int count=(remaining+panels-1)/panels;
int row=begin+rowTile*BM,col=start*32;
int width=p.n-col<count*32?p.n-col:count*32;
result={expert,row,col,end-row<BM?end-row:BM,width};
if(++rowTile==rt){rowTile=0;low+=count;}
return true;
}
if constexpr (Mode==5) {
if(low>=high)return false;
int strips=(p.n+31)/32;
int64_t groupBegin=(int64_t)expert*strips;
int first=low-groupBegin;
int stop=high-groupBegin<strips?(int)(high-groupBegin):strips;
if(rowTile>=rt) {
low=groupBegin+stop;
begin=end;++expert;rowTile=0;columnTile=0;
continue;
}
int firstBlock=first+columnTile;
int count=stop-firstBlock<BN/32?stop-firstBlock:BN/32;
int row=begin+rowTile*BM,col=firstBlock*32;
int width=p.n-col<count*32?p.n-col:count*32;
columnTile+=count;
if(first+columnTile>=stop){columnTile=0;++rowTile;}
result={expert,row,col,end-row<BM?end-row:BM,width};
return true;
}
if constexpr (Mode<=1 || Mode==6) {
int units=Mode==1?rt:rt*nt;
if(index>=units) {
index-=units;rowBase+=rt;begin=end;++expert;
columnTile=0;
continue;
}
int r=Mode==1?index:index/nt;
int c=Mode==1?columnTile:index-r*nt;
c=shifted_column<Rotate>(c,rowBase+r,expert,nt,p.cores);
if constexpr (Mode==1) {
if(++columnTile==nt){columnTile=0;index+=p.cores;}
} else index+=p.cores;
int row=begin+r*BM;
int tileRows=end-row<BM?end-row:BM;
if constexpr (Mode==6) {
int offset=(rows*r+rt-1)/rt;
int nextOffset=(rows*(r+1)+rt-1)/rt;
row=begin+offset;
tileRows=nextOffset-offset;
}
int col=c*BN;
result={expert,row,col,tileRows,p.n-col<BN?p.n-col:BN};
return true;
}
if constexpr (Mode==2)if((int64_t)begin*p.n>=high)return false;
if constexpr (Mode==4)if(workBase>=high)return false;
if(rt==0 || columnTile>=nt) {
rowBase+=rt;
if(rows>0)workBase+=((int64_t)rows+(Mode==4?BM*2:0))*p.n;
begin=end;
++expert;rowTile=0;columnTile=0;
continue;
}
int r=rowTile,c=columnTile;
int nc=p.n-c*BN<BN?p.n-c*BN:BN;
int start,stop;
if constexpr (Mode==4) {
int64_t weightedRows=(int64_t)rows+BM*2;
int64_t panel=workBase+weightedRows*c*BN;
int64_t cost=weightedRows*nc;
start=low<=panel?0:(int)(((low-panel)*rt+cost-1)/cost);
stop=high<=panel?0:(int)(((high-panel)*rt+cost-1)/cost);
} else {
int64_t panel=(int64_t)begin*p.n+(int64_t)rows*c*BN;
int stride=BM*nc;
start=low<=panel?0:(int)((low-panel+stride-1)/stride);
stop=high<=panel?0:(int)((high-panel+stride-1)/stride);
}
if(stop>rt)stop=rt;
if(r<start)r=start;
if(r>=stop){rowTile=0;++columnTile;continue;}
rowTile=r+1;
int row=begin+r*BM,col=c*BN;
result={expert,row,col,end-row<BM?end-row:BM,p.n-col<BN?p.n-col:BN};
return true;
}
return false;
}
};
template<int BM, int BN, int BK, int KP, bool ResidentA, bool ResidentB, pipe_t FixPipeline,
bool PrefetchRows=false, bool InplaceResidentBPrefetch=false, bool WeightFirst=false,
bool PrepackedWeights=false>
struct CapiPanelEngine {
static constexpr int ADepth=ResidentA && !PrefetchRows?1:2;
static constexpr int BDepth=ResidentB?1:2;
CapiQueue<__cbuf__ int8_t*,CapiSpace::L1,PIPE_MTE2,PIPE_MTE1,ADepth,0> aq;
CapiQueue<__cbuf__ int8_t*,CapiSpace::L1,PIPE_MTE2,PIPE_MTE1,BDepth,2> bq;
CapiQueue<__ca__ int8_t*,CapiSpace::L0A,PIPE_MTE1,PIPE_M,2,0> a0q;
CapiQueue<__cb__ int8_t*,CapiSpace::L0B,PIPE_MTE1,PIPE_M,2,2> b0q;
CapiQueue<__cc__ int32_t*,CapiSpace::L0C,PIPE_M,FixPipeline,1,0> cq;
__gm__ int8_t* a;
__gm__ int8_t* b;
__cbuf__ int8_t* heldA=nullptr;
__cbuf__ int8_t* heldB=nullptr;
int aExpert=-1,aRow=-1,bExpert=-1,bColumn=-1;
bool aPrefetched=false,bPrefetched=false;
int bPrefetchedExpert=-1,bPrefetchedColumn=-1;
GmmPlan p;
__aicore__ inline void Init(CapiMemory& memory, GmmPlan plan,
__gm__ int8_t* input, __gm__ int8_t* weights) {
p=plan;a=input;b=weights;
int paddedK=(p.k+31)&~31;
memory.InitBuffer(aq,ADepth,BM*(ResidentA?paddedK:KP));
memory.InitBuffer(bq,BDepth,BN*(ResidentB?paddedK:KP));
memory.InitBuffer(a0q,2,BM*BK);
memory.InitBuffer(b0q,2,BN*BK);
memory.InitBuffer(cq,1,BM*BN*4);
}
__aicore__ inline void LoadA(CapiTile tile,int panel,int count) {
auto local=aq.template AllocTensor<int8_t>();
capi_nd_to_nz(local,a+(int64_t)tile.row*p.k+panel,
tile.rows,count,p.k,(tile.rows+15)&~15);
aq.EnQue(local);
}
__aicore__ inline void LoadB(CapiTile tile,int panel,int count) {
auto local=bq.template AllocTensor<int8_t>();
if constexpr (PrepackedWeights) {
int paddedK=(p.k+31)&~31;
int columnBlocks=(tile.columns+31)/32;
int paddedCount=(count+31)&~31;
auto source=b+((int64_t)tile.expert*((p.n+31)/32)*paddedK+
(int64_t)(tile.column/32)*paddedK+panel)*32;
asc_copy_gm2l1(local,source,columnBlocks,paddedCount,
paddedK-paddedCount,0);
} else {
auto source=b+(int64_t)tile.expert*p.k*p.n+
(int64_t)panel*p.n+tile.column;
capi_nd_to_nz(local,source,count,tile.columns,p.n,(count+31)&~31);
}
bq.EnQue(local);
}
__aicore__ inline void LoadBPanel(__cbuf__ int8_t* local,CapiTile tile,
int panel,int count,int paddedK) {
if constexpr (PrepackedWeights) {
int paddedCount=(count+31)&~31;
auto source=b+((int64_t)tile.expert*((p.n+31)/32)*paddedK+
(int64_t)(tile.column/32)*paddedK+panel)*32;
asc_copy_gm2l1(local+panel*32,source,(tile.columns+31)/32,
paddedCount,paddedK-paddedCount,paddedK-paddedCount);
} else {
auto source=b+(int64_t)tile.expert*p.k*p.n+(int64_t)panel*p.n+tile.column;
capi_nd_to_nz(local+panel*32,source,count,tile.columns,p.n,paddedK);
}
}
__aicore__ inline void Multiply(CapiTile tile,__gm__ int32_t* target,
const CapiTile* nextTile) {
int paddedK=(p.k+31)&~31;
int alignedRows=(tile.rows+15)&~15;
int alignedColumns=(tile.columns+15)&~15;
constexpr bool ConfigurePerTile=BM>=96;
if constexpr (ConfigurePerTile) {
asc_l13d_fmatrix_config matrix{};
matrix.config=(uint64_t(1)<<16)|alignedRows;
asc_set_l13d_fmatrix(matrix);
}
if constexpr (ResidentA) {
if(tile.expert!=aExpert || tile.row!=aRow) {
if(aExpert>=0)aq.FreeTensor(heldA);
if(!aPrefetched)LoadA(tile,0,p.k);
heldA=aq.template DeQue<int8_t>();
aPrefetched=false;
aExpert=tile.expert;aRow=tile.row;
}
}
bool usingPrefetchedB=false;
if constexpr (ResidentB) {
if(tile.expert!=bExpert || tile.column!=bColumn) {
if constexpr (InplaceResidentBPrefetch) {
if(bPrefetched && tile.expert==bPrefetchedExpert &&
tile.column==bPrefetchedColumn) {
usingPrefetchedB=true;
bPrefetched=false;
} else {
if(bExpert>=0)bq.FreeTensor(heldB);
LoadB(tile,0,p.k);
heldB=bq.template DeQue<int8_t>();
}
} else {
if(bExpert>=0)bq.FreeTensor(heldB);
LoadB(tile,0,p.k);
heldB=bq.template DeQue<int8_t>();
}
bExpert=tile.expert;bColumn=tile.column;
}
}
if constexpr (PrefetchRows) {
if(nextTile && (nextTile->expert!=tile.expert || nextTile->row!=tile.row)) {
LoadA(*nextTile,0,p.k);
aPrefetched=true;
}
}
int initial=p.k<KP?p.k:KP;
if constexpr (WeightFirst && !ResidentB)if(!bPrefetched)LoadB(tile,0,initial);
if constexpr (!ResidentA) {
if(!aPrefetched)LoadA(tile,0,initial);
aPrefetched=false;
}
if constexpr (!ResidentB) {
if constexpr (!WeightFirst)if(!bPrefetched)LoadB(tile,0,initial);
bPrefetched=false;
}
auto accumulator=cq.template AllocTensor<int32_t>();
bool prefetchNextB=false;
if constexpr (ResidentB && InplaceResidentBPrefetch) {
prefetchNextB=p.k<=2*KP && nextTile &&
(nextTile->expert!=tile.expert || nextTile->column!=tile.column);
}
for(int panel=0;panel<p.k;panel+=KP) {
int count=p.k-panel<KP?p.k-panel:KP;
int paddedCount=(count+31)&~31;
__cbuf__ int8_t* localA;
__cbuf__ int8_t* localB;
if constexpr (ResidentA)localA=heldA;
else localA=aq.template DeQue<int8_t>();
if constexpr (ResidentB) {
if constexpr (InplaceResidentBPrefetch) {
if(usingPrefetchedB)capi_wait<PIPE_MTE2,PIPE_MTE1>(6+panel/KP);
}
localB=heldB+panel*32;
}
else localB=bq.template DeQue<int8_t>();
if(panel+count<p.k) {
int next=panel+count,nextCount=p.k-next<KP?p.k-next:KP;
if constexpr (WeightFirst && !ResidentB)LoadB(tile,next,nextCount);
if constexpr (!ResidentA)LoadA(tile,next,nextCount);
if constexpr (!WeightFirst && !ResidentB)LoadB(tile,next,nextCount);
} else if(nextTile) {
if constexpr (!ResidentA) {
LoadA(*nextTile,0,initial);aPrefetched=true;
}
if constexpr (!ResidentB) {
LoadB(*nextTile,0,initial);bPrefetched=true;
}
}
int aColumns=ResidentA?paddedK:paddedCount;
int bRows=ResidentB?paddedK:paddedCount;
int aOffset=ResidentA?panel:0;
int firstK=paddedCount<BK?paddedCount:BK;
auto firstA=a0q.template AllocTensor<int8_t>();
auto firstB=b0q.template AllocTensor<int8_t>();
capi_l1_to_l0a<!ConfigurePerTile>(firstA,localA,tile.rows,firstK,alignedRows,aColumns,aOffset);
capi_l1_to_l0b(firstB,localB,firstK,tile.columns,bRows);
a0q.EnQue(firstA);b0q.EnQue(firstB);
for(int inner=0;inner<paddedCount;inner+=BK) {
int reduction=paddedCount-inner<BK?paddedCount-inner:BK;
auto left=a0q.template DeQue<int8_t>();
auto right=b0q.template DeQue<int8_t>();
if constexpr (ResidentB && InplaceResidentBPrefetch) {
if(prefetchNextB && inner+reduction>=paddedCount) {
int consumed=4+panel/KP;
capi_notify<PIPE_MTE1,PIPE_MTE2>(consumed);
capi_wait<PIPE_MTE1,PIPE_MTE2>(consumed);
LoadBPanel(heldB,*nextTile,panel,count,paddedK);
capi_notify<PIPE_MTE2,PIPE_MTE1>(6+panel/KP);
if(panel+count>=p.k) {
bPrefetched=true;
bPrefetchedExpert=nextTile->expert;
bPrefetchedColumn=nextTile->column;
}
}
}
asc_mmad(accumulator,left,right,alignedRows,
reduction,alignedColumns,0,false,false,panel==0 && inner==0);
a0q.FreeTensor(left);b0q.FreeTensor(right);
int next=inner+BK;
if(next<paddedCount) {
int nextK=paddedCount-next<BK?paddedCount-next:BK;
auto nextA=a0q.template AllocTensor<int8_t>();
auto nextB=b0q.template AllocTensor<int8_t>();
capi_l1_to_l0a<!ConfigurePerTile>(nextA,localA,tile.rows,nextK,alignedRows,
aColumns,aOffset+next);
capi_l1_to_l0b(nextB,localB+next*32,nextK,tile.columns,bRows);
a0q.EnQue(nextA);b0q.EnQue(nextB);
}
asc_sync_pipe(PIPE_M);
}
if constexpr (!ResidentA)aq.FreeTensor(localA);
if constexpr (!ResidentB)bq.FreeTensor(localB);
}
capi_notify<PIPE_M,FixPipeline>(0);capi_wait<PIPE_M,FixPipeline>(0);
cq.EnQue(accumulator);accumulator=cq.template DeQue<int32_t>();
FixpipeParamsV220 copy;
copy.nSize=tile.columns;copy.mSize=tile.rows;
copy.srcStride=alignedRows;copy.dstStride=BN;
copy.ndNum=1;copy.srcNdStride=0;copy.dstNdStride=0;copy.unitFlag=0;
capi_fixpipe(target,accumulator,copy);
cq.FreeTensor(accumulator);
}
__aicore__ inline void Finish() {
if constexpr (ResidentA)if(aExpert>=0){aq.FreeTensor(heldA);aExpert=-1;}
if constexpr (ResidentB)if(bExpert>=0){bq.FreeTensor(heldB);bExpert=-1;}
}
};
template<int BM,int BN>
__global__ __aicore__ __schedmode__(1) void gmm_capi_single(
GM_ADDR x,GM_ADDR weight,GM_ADDR scale,GM_ADDR groups,
GM_ADDR output,GM_ADDR workspace,GmmPlan p) {
KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
InitSocState();
int core=asc_get_block_idx();
CapiTraversal<BM,BN,0,0> traversal(reinterpret_cast<__gm__ int64_t*>(groups),p,core);
CapiTile tile;
if(!traversal.Next(tile))return;
auto scratch=reinterpret_cast<__gm__ int32_t*>(workspace)+(int64_t)core*BM*BN;
if ASCEND_IS_AIC {
auto a1=reinterpret_cast<__cbuf__ int8_t*>(uint64_t(0));
auto b1=reinterpret_cast<__cbuf__ int8_t*>(uint64_t(BM*512));
auto a0=reinterpret_cast<__ca__ int8_t*>(uint64_t(0));
auto b0=reinterpret_cast<__cb__ int8_t*>(uint64_t(0));
auto c0=reinterpret_cast<__cc__ int32_t*>(uint64_t(0));
int alignedRows=(tile.rows+15)&~15;
capi_nd_to_nz(a1,reinterpret_cast<__gm__ int8_t*>(x)+(int64_t)tile.row*p.k,
tile.rows,p.k,p.k,alignedRows);
capi_nd_to_nz(b1,reinterpret_cast<__gm__ int8_t*>(weight)+
(int64_t)tile.expert*p.k*p.n+tile.column,p.k,tile.columns,p.n,p.k);
capi_notify<PIPE_MTE2,PIPE_MTE1>(0);capi_wait<PIPE_MTE2,PIPE_MTE1>(0);
capi_l1_to_l0a(a0,a1,tile.rows,p.k,alignedRows,p.k);
capi_l1_to_l0b(b0,b1,p.k,tile.columns,p.k);
capi_notify<PIPE_MTE1,PIPE_M>(0);capi_wait<PIPE_MTE1,PIPE_M>(0);
asc_mmad(c0,a0,b0,alignedRows,p.k,(tile.columns+15)&~15,0,false,false,true);
capi_notify<PIPE_M,PIPE_FIX>(0);capi_wait<PIPE_M,PIPE_FIX>(0);
FixpipeParamsV220 copy;
copy.nSize=tile.columns;copy.mSize=tile.rows;copy.srcStride=alignedRows;
copy.dstStride=BN;copy.ndNum=1;copy.srcNdStride=0;copy.dstNdStride=0;copy.unitFlag=0;
capi_fixpipe(scratch,c0,copy);
capi_block_arrive<PIPE_FIX,2>(0);
} else {
int slice=asc_get_sub_block_id()*(BM/2);
int rows=tile.rows-slice<BM/2?tile.rows-slice:BM/2;
asc_sync_block_wait(0);
if(rows<=0)return;
constexpr int SIZE=BM/2*BN;
auto ci=reinterpret_cast<__ubuf__ int32_t*>(uint64_t(256));
auto z=reinterpret_cast<__ubuf__ float*>(uint64_t(256+SIZE*4));
auto v=reinterpret_cast<__ubuf__ float*>(uint64_t(256+SIZE*8));
auto scales=reinterpret_cast<__ubuf__ float*>(uint64_t(256+SIZE*12));
auto out=reinterpret_cast<__ubuf__ half*>(ci);
DataCopyExtParams sp{1,(uint32_t)tile.columns*4,0,0,0};
capi_read_pad(scales,reinterpret_cast<__gm__ float*>(scale)+
(int64_t)tile.expert*p.n+tile.column,sp,DataCopyPadExtParams<float>{true,0,0,0.0f});
capi_read(ci,scratch+slice*BN,rows*BN);
capi_notify<PIPE_MTE2,PIPE_V>(0);capi_wait<PIPE_MTE2,PIPE_V>(0);
asc_int322float_rn(z,ci,rows*BN);asc_sync_pipe(PIPE_V);
asc_set_mask_norm();asc_set_vector_mask(0,~uint64_t(0));
for(int col=0;col<BN;col+=64)
asc_mul(z+col,z+col,scales+col,rows,1,1,1,BN/8,BN/8,0);
asc_sync_pipe(PIPE_V);
capi_finish_gelu(z,v,out,rows*BN);
capi_notify<PIPE_V,PIPE_MTE3>(0);capi_wait<PIPE_V,PIPE_MTE3>(0);
DataCopyExtParams op{(uint16_t)rows,(uint32_t)tile.columns*2,
(uint32_t)((BN-((tile.columns+15)&~15))/16),(uint32_t)(p.n-tile.columns)*2,0};
capi_write_pad(reinterpret_cast<__gm__ half*>(output)+
(int64_t)(tile.row+slice)*p.n+tile.column,out,op);
capi_notify<PIPE_MTE3,PIPE_S>(0);capi_wait<PIPE_MTE3,PIPE_S>(0);
}
}
template<int BM,int BN,int Mode=0,int PAD=192,int VROWS=0,
bool PackTail=false,int Rotate=0,bool SingleTile=false,bool PrefetchRows=false,
bool ReuseAccumulator=false,int PanelK=0,bool FineTail=false,bool FusedAffine=false,
bool InplaceResidentBPrefetch=false, bool VectorPackWeights=false>
__global__ __aicore__ __schedmode__(1) void gmm_capi_panels(
GM_ADDR x,GM_ADDR weight,GM_ADDR scale,GM_ADDR groups,
GM_ADDR output,GM_ADDR workspace,GmmPlan p) {
KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
InitSocState();
constexpr int BK=BN>256?96:128;
constexpr int KP=PanelK>0?PanelK:(BN>256?256:512);
constexpr int UB_BYTES=192*1024-(FusedAffine?GELU_AFFINE_BYTES:0);
constexpr int REUSED_ROWS=(UB_BYTES-256-3*PAD-BN*4)/(12*BN);
constexpr int ROW_CAPACITY=ReuseAccumulator?REUSED_ROWS:8192/BN;
constexpr int MAX_ROWS=BM/2<ROW_CAPACITY?BM/2:ROW_CAPACITY;
constexpr int CHUNK=VROWS>0 && VROWS<MAX_ROWS?VROWS:MAX_ROWS;
constexpr int SIZE=CHUNK*BN;
static_assert(!ReuseAccumulator || SIZE*12+256+3*PAD+BN*4<=UB_BYTES,
"Accumulator and vector scratch exceed UB capacity");
static_assert(!FusedAffine || SIZE*(ReuseAccumulator?12:16)+256+
(ReuseAccumulator?3:4)*PAD+BN*4<=UB_BYTES,
"GELU constants overlap vector scratch");
int core=asc_get_block_idx();
auto ends=reinterpret_cast<__gm__ int64_t*>(groups);
auto scratch=reinterpret_cast<__gm__ int32_t*>(workspace)+
(int64_t)core*(SingleTile?1:2)*BM*BN;
auto packedWeights=reinterpret_cast<__gm__ int8_t*>(workspace)+
(int64_t)p.cores*2*BM*BN*4;
if constexpr (VectorPackWeights) {
if ASCEND_IS_AIV {
constexpr int SlotBytes=48*1024;
int stride=(p.n+31)&~31;
int PackRows=(SlotBytes/stride)/32*32;
if(PackRows>64)PackRows=64;
int paddedK=(p.k+31)&~31;
int lane=core*2+asc_get_sub_block_id(),lanes=p.cores*2;
int chunks=(p.k+PackRows-1)/PackRows;
int jobs=p.e*chunks;
int first=jobs*lane/lanes,stop=jobs*(lane+1)/lanes;
auto source=reinterpret_cast<__gm__ uint8_t*>(weight);
bool pending[2]={false,false};
if(first<stop) {
int expert=first/chunks,row=(first%chunks)*PackRows;
int count=p.k-row<PackRows?p.k-row:PackRows;
auto initial=reinterpret_cast<__ubuf__ uint8_t*>(uint64_t(0));
asc_copy_gm2ub_align(initial,source+((int64_t)expert*p.k+row)*p.n,
count,p.n,0,0,0,0);
capi_notify<PIPE_MTE2,PIPE_V>(4);
}
for(int job=first;job<stop;++job) {
int stage=(job-first)&1;
int expert=job/chunks,row=(job%chunks)*PackRows;
int count=p.k-row<PackRows?p.k-row:PackRows;
int paddedCount=(count+31)&~31;
if(job+1<stop) {
int nextStage=stage^1,nextJob=job+1;
if(pending[nextStage]) {
capi_wait<PIPE_MTE3,PIPE_MTE2>(4+nextStage);
pending[nextStage]=false;
}
int nextExpert=nextJob/chunks,nextRow=(nextJob%chunks)*PackRows;
int nextCount=p.k-nextRow<PackRows?p.k-nextRow:PackRows;
auto next=reinterpret_cast<__ubuf__ uint8_t*>(uint64_t(nextStage*SlotBytes));
asc_copy_gm2ub_align(next,source+((int64_t)nextExpert*p.k+nextRow)*p.n,
nextCount,p.n,0,0,0,0);
capi_notify<PIPE_MTE2,PIPE_V>(4+nextStage);
}
capi_wait<PIPE_MTE2,PIPE_V>(4+stage);
auto staging=reinterpret_cast<__ubuf__ uint32_t*>(uint64_t(stage*SlotBytes));
auto ordered=reinterpret_cast<__ubuf__ uint32_t*>(uint64_t((stage+2)*SlotBytes));
asc_set_mask_norm();asc_set_vector_mask(0,~uint64_t(0));
for(int column=0;column<stride;column+=32) {
asc_copy(ordered+(column/32)*PackRows*8,staging+column/4,
PackRows/8,1,stride/32,8,8*stride/32);
}
capi_notify<PIPE_V,PIPE_MTE3>(4+stage);
capi_wait<PIPE_V,PIPE_MTE3>(4+stage);
auto destination=reinterpret_cast<__gm__ uint8_t*>(packedWeights)+
((int64_t)expert*(stride/32)*paddedK+row)*32;
asc_copy_ub2gm_align(destination,reinterpret_cast<__ubuf__ uint8_t*>(ordered),
stride/32,paddedCount*32,0,0,PackRows-paddedCount,
(paddedK-paddedCount)*32);
capi_notify<PIPE_MTE3,PIPE_MTE2>(4+stage);
pending[stage]=true;
}
for(int stage=0;stage<2;++stage)
if(pending[stage])capi_wait<PIPE_MTE3,PIPE_MTE2>(4+stage);
capi_block_arrive<PIPE_MTE3,0>(6);
asc_sync_block_wait(6);
capi_block_arrive<PIPE_MTE3,2>(4);
} else {
asc_sync_block_wait(4);
}
}
CapiTraversal<BM,BN,Mode,Rotate> traversal(ends,p,core);
CapiTile tile;
CapiMemory memory;
if ASCEND_IS_AIC {
CapiPanelEngine<BM,BN,BK,KP,(Mode==1 || Mode==5 || PrefetchRows),
((Mode>=2 && Mode<=4) || Mode==8),PIPE_FIX,PrefetchRows,InplaceResidentBPrefetch,Mode==6,VectorPackWeights> engine;
engine.Init(memory,p,reinterpret_cast<__gm__ int8_t*>(x),
VectorPackWeights?packedWeights:reinterpret_cast<__gm__ int8_t*>(weight));
int produced=0;
bool active=traversal.Next(tile);
while(active) {
CapiTile next;
bool hasNext=traversal.Next(next);
int slot=SingleTile?0:produced&1;
if(!SingleTile && produced>=2)asc_sync_block_wait(2+slot);
engine.Multiply(tile,scratch+slot*BM*BN,
hasNext?&next:nullptr);
capi_block_arrive<PIPE_FIX,2>(slot);
++produced;
active=hasNext;
if(hasNext)tile=next;
}
engine.Finish();
if constexpr (!SingleTile) {
if(produced>=1)asc_sync_block_wait(2);
if(produced>=2)asc_sync_block_wait(3);
}
} else {
CapiBuffer cb,zb,vb,sb;
memory.InitBuffer(cb,SIZE*8+PAD);
memory.InitBuffer(zb,ReuseAccumulator?0:SIZE*4+PAD);
memory.InitBuffer(vb,SIZE*4+PAD);
memory.InitBuffer(sb,BN*4+PAD);
auto storage=cb.Get<int32_t>();
auto z=zb.Get<float>();auto v=vb.Get<float>();auto scales=sb.Get<float>();
if constexpr (FusedAffine)capi_init_gelu_affine();
auto sg=reinterpret_cast<__gm__ float*>(scale);
auto yg=reinterpret_cast<__gm__ half*>(output);
bool pending[2]={false,false},scalePending=false;
int lastExpert=-1,lastColumn=-1,consumed=0;
while(traversal.Next(tile)) {
int slot=SingleTile?0:(consumed&1);
++consumed;
int slice=asc_get_sub_block_id()*(BM/2);
int localRows=tile.rows-slice<BM/2?tile.rows-slice:BM/2;
if(localRows>0 && (tile.expert!=lastExpert || tile.column!=lastColumn)) {
if(scalePending) {
capi_wait<PIPE_V,PIPE_MTE2>(0);scalePending=false;
}
DataCopyExtParams sp{1,(uint32_t)tile.columns*4,0,0,0};
capi_read_pad(scales,sg+(int64_t)tile.expert*p.n+tile.column,
sp,DataCopyPadExtParams<float>{true,0,0,0.0f});
lastExpert=tile.expert;lastColumn=tile.column;
}
asc_sync_block_wait(slot);
if(localRows<=0) {
if constexpr (!SingleTile)capi_block_arrive<PIPE_MTE2,2>(2+slot);
continue;
}
int rowStride=BN;
if constexpr (PackTail) {
if constexpr (FineTail) {
if(tile.columns<=16)rowStride=16;
else if(tile.columns<=32)rowStride=32;
else if(tile.columns<=64)rowStride=64;
else if(tile.columns<=128)rowStride=128;
else rowStride=(tile.columns+15)&~15;
} else {
if(tile.columns<=64 && localRows%2==0 && CHUNK%2==0)rowStride=64;
else if(tile.columns<=128)rowStride=128;
}
}
int fullWidth=FineTail?(rowStride&~63):rowStride;
int remaining=FineTail?rowStride-fullWidth:0;
uint64_t tailMask=remaining?(uint64_t(1)<<remaining)-1:0;
int firstRows=localRows<CHUNK?localRows:CHUNK;
if(pending[slot]){capi_wait<PIPE_MTE3,PIPE_MTE2>(slot);pending[slot]=false;}
capi_copy_accumulator_rows<BN,PackTail>(storage+slot*SIZE,
scratch+slot*BM*BN+slice*BN,firstRows,rowStride);
capi_notify<PIPE_MTE2,PIPE_V>(slot);
if constexpr (!SingleTile)if(firstRows==localRows)
capi_block_arrive<PIPE_MTE2,2>(2+slot);
for(int part=0;part<localRows;part+=CHUNK) {
int stage=(slot+part/CHUNK)&1;
int nr=localRows-part<CHUNK?localRows-part:CHUNK;
int active=nr*rowStride;
capi_wait<PIPE_MTE2,PIPE_V>(stage);
if(part+nr<localRows) {
int next=stage^1;
if(pending[next]){capi_wait<PIPE_MTE3,PIPE_MTE2>(next);pending[next]=false;}
int nextRows=localRows-part-nr<CHUNK?localRows-part-nr:CHUNK;
capi_copy_accumulator_rows<BN,PackTail>(storage+next*SIZE,
scratch+slot*BM*BN+(slice+part+nr)*BN,nextRows,rowStride);
capi_notify<PIPE_MTE2,PIPE_V>(next);
if constexpr (!SingleTile)if(part+nr+nextRows==localRows)
capi_block_arrive<PIPE_MTE2,2>(2+slot);
}
auto ci=storage+stage*SIZE;
if constexpr (ReuseAccumulator)z=reinterpret_cast<__ubuf__ float*>(ci);
auto out=reinterpret_cast<__ubuf__ half*>(ci);
asc_int322float_rn(z,ci,active);asc_sync_pipe(PIPE_V);
asc_set_mask_norm();
asc_set_vector_mask(0,~uint64_t(0));
#pragma unroll
for(int column=0;column<BN;column+=64) {
if(column<fullWidth)
asc_mul(z+column,z+column,scales+column,nr,1,1,1,
rowStride/8,rowStride/8,0);
}
if constexpr (FineTail) {
if(remaining>0) {
asc_set_vector_mask(0,tailMask);
asc_mul(z+fullWidth,z+fullWidth,scales+fullWidth,nr,1,1,1,
rowStride/8,rowStride/8,0);
}
}
asc_sync_pipe(PIPE_V);
capi_finish_gelu<FusedAffine>(z,v,out,active);
capi_notify<PIPE_V,PIPE_MTE3>(0);capi_wait<PIPE_V,PIPE_MTE3>(0);
DataCopyExtParams op{(uint16_t)nr,(uint32_t)tile.columns*2,
(uint32_t)((rowStride-((tile.columns+15)&~15))/16),
(uint32_t)(p.n-tile.columns)*2,0};
capi_write_pad(yg+(int64_t)(tile.row+slice+part)*p.n+tile.column,out,op);
capi_notify<PIPE_MTE3,PIPE_MTE2>(stage);pending[stage]=true;
}
if(scalePending)capi_wait<PIPE_V,PIPE_MTE2>(0);
capi_notify<PIPE_V,PIPE_MTE2>(0);scalePending=true;
}
if(scalePending)capi_wait<PIPE_V,PIPE_MTE2>(0);
for(int stage=0;stage<2;++stage)
if(pending[stage])capi_wait<PIPE_MTE3,PIPE_MTE2>(stage);
}
}
}
template<bool DirectGroups>
__global__ __aicore__ void gmm_tiny_vector(
GM_ADDR x,GM_ADDR weight,GM_ADDR scale,GM_ADDR groups,GM_ADDR output,
int m,int k,int n,int e) {
KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
InitSocState();
auto rawA=reinterpret_cast<__ubuf__ int8_t*>(uint64_t(0));
auto rawB=reinterpret_cast<__ubuf__ int8_t*>(uint64_t(8192));
auto halfScratch=reinterpret_cast<__ubuf__ half*>(uint64_t(16384));
auto a=reinterpret_cast<__ubuf__ float*>(uint64_t(32768));
auto b=reinterpret_cast<__ubuf__ float*>(uint64_t(65536));
auto scales=reinterpret_cast<__ubuf__ float*>(uint64_t(98304));
auto ends=reinterpret_cast<__ubuf__ int64_t*>(uint64_t(131072));
auto globalEnds=reinterpret_cast<__gm__ int64_t*>(groups);
auto ao=reinterpret_cast<__ubuf__ uint32_t*>(uint64_t(135168));
auto bo=reinterpret_cast<__ubuf__ uint32_t*>(uint64_t(135680));
auto so=reinterpret_cast<__ubuf__ uint32_t*>(uint64_t(136192));
auto sum=reinterpret_cast<__ubuf__ float*>(uint64_t(136704));
auto left=reinterpret_cast<__ubuf__ float*>(uint64_t(137248));
auto right=reinterpret_cast<__ubuf__ float*>(uint64_t(137792));
auto temporary=reinterpret_cast<__ubuf__ float*>(uint64_t(138336));
auto result=reinterpret_cast<__ubuf__ half*>(uint64_t(138880));
asc_copy_gm2ub_align(rawA,reinterpret_cast<__gm__ int8_t*>(x),1,m*k,0,0,0,0);
asc_copy_gm2ub_align(rawB,reinterpret_cast<__gm__ int8_t*>(weight),1,e*k*n,0,0,0,0);
capi_notify<PIPE_MTE2,PIPE_V>(0);
asc_copy_gm2ub_align(scales,reinterpret_cast<__gm__ float*>(scale),1,e*n*4,0,0,0,0);
if constexpr(DirectGroups) {
capi_notify<PIPE_MTE2,PIPE_V>(1);
} else {
asc_copy_gm2ub_align(reinterpret_cast<__ubuf__ uint8_t*>(ends),
reinterpret_cast<__gm__ uint8_t*>(groups),1,e*8,0,0,0,0);
capi_notify<PIPE_MTE2,PIPE_S>(0);
}
capi_wait<PIPE_MTE2,PIPE_V>(0);
auto halfB=halfScratch+256;
asc_int82half(halfScratch,rawA,m*k);
asc_int82half(halfB,rawB,e*k*n);
asc_sync_pipe(PIPE_V);
asc_half2float(a,halfScratch,m*k);
asc_half2float(b,halfB,e*k*n);
if constexpr(!DirectGroups)capi_wait<PIPE_MTE2,PIPE_S>(0);
int count=m*n,expert=0;
int64_t lastEnd=0;
if constexpr(DirectGroups)lastEnd=globalEnds[0];
for(int row=0;row<m;++row) {
if constexpr(DirectGroups) {
while(expert+1<e && row>=lastEnd)lastEnd=globalEnds[++expert];
} else {
while(expert+1<e && row>=ends[expert])++expert;
}
for(int column=0;column<n;++column) {
int index=row*n+column;
ao[index]=(row*k)*4;
bo[index]=(expert*k*n+column)*4;
so[index]=(expert*n+column)*4;
}
}
capi_notify<PIPE_S,PIPE_V>(0);capi_wait<PIPE_S,PIPE_V>(0);
asc_set_mask_count();asc_set_vector_mask(0,count);
auto accumulator=sum;
auto gathered=left;
auto spare=reinterpret_cast<__ubuf__ float*>(uint64_t(139424));
auto factors=right;
auto spareFactors=temporary;
auto gatheredScales=reinterpret_cast<__ubuf__ float*>(uint64_t(139968));
asc_sync_pipe(PIPE_V);
if constexpr(DirectGroups)capi_wait<PIPE_MTE2,PIPE_V>(1);
asc_gather(gatheredScales,scales,so,8,1);
for(int inner=0;inner<k;++inner) {
asc_gather(gathered,a+inner,ao,8,1);
asc_gather(factors,b+inner*n,bo,8,1);asc_sync_pipe(PIPE_V);
if(inner==0)asc_mul(gathered,gathered,factors,1,1,1,1,8,8,8);
else asc_mul_add(gathered,factors,accumulator,1,1,1,1,8,8,8);
auto previous=accumulator;accumulator=gathered;gathered=spare;spare=previous;
auto oldFactors=factors;factors=spareFactors;spareFactors=oldFactors;
}
asc_sync_pipe(PIPE_V);
asc_mul(accumulator,accumulator,gatheredScales,1,1,1,1,8,8,8);
asc_sync_pipe(PIPE_V);
capi_finish_gelu(accumulator,temporary,result,count);
capi_notify<PIPE_V,PIPE_MTE3>(0);capi_wait<PIPE_V,PIPE_MTE3>(0);
asc_copy_ub2gm_align(reinterpret_cast<__gm__ half*>(output),result,
1,count*2,0,0,0,0);
capi_notify<PIPE_MTE3,PIPE_S>(0);capi_wait<PIPE_MTE3,PIPE_S>(0);
}
__global__ __aicore__ __schedmode__(1) void gmm_small_single_cube(
GM_ADDR x,GM_ADDR weight,GM_ADDR scale,GM_ADDR output,GM_ADDR workspace) {
KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
InitSocState();
constexpr int Rows=16,Columns=128,Reduction=128,Slice=Rows/2;
const int block=asc_get_block_idx();
auto scratch=reinterpret_cast<__gm__ int32_t*>(workspace)+block*Rows*Columns;
if ASCEND_IS_AIC {
auto a1=reinterpret_cast<__cbuf__ int8_t*>(uint64_t(0));
auto b1=reinterpret_cast<__cbuf__ int8_t*>(uint64_t(Rows*Reduction));
auto a0=reinterpret_cast<__ca__ int8_t*>(uint64_t(0));
auto b0=reinterpret_cast<__cb__ int8_t*>(uint64_t(0));
auto c0=reinterpret_cast<__cc__ int32_t*>(uint64_t(0));
capi_nd_to_nz(a1,reinterpret_cast<__gm__ int8_t*>(x)+block*Rows*Reduction,
Rows,Reduction,Reduction,Rows);
capi_nd_to_nz(b1,reinterpret_cast<__gm__ int8_t*>(weight),
Reduction,Columns,Columns,Reduction);
capi_notify<PIPE_MTE2,PIPE_MTE1>(0);capi_wait<PIPE_MTE2,PIPE_MTE1>(0);
capi_l1_to_l0a(a0,a1,Rows,Reduction,Rows,Reduction);
capi_l1_to_l0b(b0,b1,Reduction,Columns,Reduction);
capi_notify<PIPE_MTE1,PIPE_M>(0);capi_wait<PIPE_MTE1,PIPE_M>(0);
asc_mmad(c0,a0,b0,Rows,Reduction,Columns,3,false,false,true);
FixpipeParamsV220 copy;
copy.nSize=Columns;copy.mSize=Rows;copy.srcStride=Rows;copy.dstStride=Columns;
copy.ndNum=1;copy.srcNdStride=0;copy.dstNdStride=0;copy.unitFlag=3;
capi_fixpipe(scratch,c0,copy);
capi_block_arrive<PIPE_FIX,2>(0);
} else {
constexpr int Count=Slice*Columns;
auto accum=reinterpret_cast<__ubuf__ int32_t*>(uint64_t(256));
auto z=reinterpret_cast<__ubuf__ float*>(uint64_t(256+Count*4));
auto v=reinterpret_cast<__ubuf__ float*>(uint64_t(512+Count*8));
auto t=reinterpret_cast<__ubuf__ float*>(uint64_t(768+Count*12));
auto coefficients=reinterpret_cast<__ubuf__ float*>(uint64_t(1024+Count*16));
auto result=reinterpret_cast<__ubuf__ half*>(accum);
const int slice=asc_get_sub_block_id()*Slice;
capi_read(coefficients,reinterpret_cast<__gm__ float*>(scale),Columns);
asc_sync_block_wait(0);
capi_read(accum,scratch+slice*Columns,Count);
capi_notify<PIPE_MTE2,PIPE_V>(0);capi_wait<PIPE_MTE2,PIPE_V>(0);
asc_int322float_rn(z,accum,Count);asc_sync_pipe(PIPE_V);
asc_set_mask_norm();asc_set_vector_mask(0,~uint64_t(0));
for(int column=0;column<Columns;column+=64)
asc_mul(z+column,z+column,coefficients+column,Slice,1,1,1,
Columns/8,Columns/8,0);
asc_sync_pipe(PIPE_V);
capi_finish_gelu_pingpong(z,v,t,result,Count);
capi_notify<PIPE_V,PIPE_MTE3>(0);capi_wait<PIPE_V,PIPE_MTE3>(0);
capi_write(reinterpret_cast<__gm__ half*>(output)+(block*Rows+slice)*Columns,result,Count);
}
}
__global__ __aicore__ void gmm_small_vector_reduce(
GM_ADDR x,GM_ADDR weight,GM_ADDR scale,GM_ADDR groups,GM_ADDR output,
int m,int k,int n,int experts,int rowsPerBlock) {
KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
InitSocState();
constexpr int MaxReduction=128,MaxColumns=128,MaxRowsPerBlock=4;
constexpr int MaxWeights=MaxReduction*MaxColumns;
constexpr int MaxInput=MaxRowsPerBlock*MaxReduction;
constexpr int WeightFloat=MaxWeights;
constexpr int Products=WeightFloat+MaxWeights*sizeof(float);
constexpr int Input=Products+MaxWeights*sizeof(float);
constexpr int InputHalf=Input+MaxInput;
constexpr int InputFloat=InputHalf+MaxInput*sizeof(half);
constexpr int Broadcast=InputFloat+MaxInput*sizeof(float);
constexpr int Scale=Broadcast+MaxInput*8*sizeof(float);
constexpr int Values=Scale+MaxColumns*sizeof(float);
constexpr int Gelu=Values+MaxColumns*sizeof(float);
constexpr int Output=Gelu+MaxColumns*sizeof(float);
static_assert(Output+MaxColumns*sizeof(half)<=192*1024,
"Vector reduction buffers must fit UB");
auto rawWeight=reinterpret_cast<__ubuf__ int8_t*>(uint64_t(0));
auto halfWeight=reinterpret_cast<__ubuf__ half*>(uint64_t(Products));
auto floatWeight=reinterpret_cast<__ubuf__ float*>(uint64_t(WeightFloat));
auto products=reinterpret_cast<__ubuf__ float*>(uint64_t(Products));
auto rawInput=reinterpret_cast<__ubuf__ int8_t*>(uint64_t(Input));
auto halfInput=reinterpret_cast<__ubuf__ half*>(uint64_t(InputHalf));
auto floatInput=reinterpret_cast<__ubuf__ float*>(uint64_t(InputFloat));
auto broadcasts=reinterpret_cast<__ubuf__ float*>(uint64_t(Broadcast));
auto scales=reinterpret_cast<__ubuf__ float*>(uint64_t(Scale));
auto values=reinterpret_cast<__ubuf__ float*>(uint64_t(Values));
auto gelu=reinterpret_cast<__ubuf__ float*>(uint64_t(Gelu));
auto result=reinterpret_cast<__ubuf__ half*>(uint64_t(Output));
auto groupEnds=reinterpret_cast<__gm__ int64_t*>(groups);
auto activations=reinterpret_cast<__gm__ int8_t*>(x);
auto weights=reinterpret_cast<__gm__ int8_t*>(weight);
auto coefficients=reinterpret_cast<__gm__ float*>(scale);
auto destination=reinterpret_cast<__gm__ half*>(output);
int first=asc_get_block_idx()*rowsPerBlock;
int stop=first+rowsPerBlock<m?first+rowsPerBlock:m;
int inputCount=(stop-first)*k;
capi_read(rawInput,activations+int64_t(first)*k,inputCount);
capi_notify<PIPE_MTE2,PIPE_V>(0);
int expert=0,limit=experts;
while(expert<limit) {
int middle=expert+(limit-expert)/2;
if(groupEnds[middle]<=first)expert=middle+1;
else limit=middle;
}
capi_wait<PIPE_MTE2,PIPE_V>(0);
asc_int82half(halfInput,rawInput,inputCount);asc_sync_pipe(PIPE_V);
asc_half2float(floatInput,halfInput,inputCount);asc_sync_pipe(PIPE_V);
asc_set_mask_norm();asc_set_vector_mask(0,~uint64_t(0));
asc_brcb(reinterpret_cast<__ubuf__ uint32_t*>(broadcasts),
reinterpret_cast<__ubuf__ uint32_t*>(floatInput),1,8,inputCount/8);
asc_sync_pipe(PIPE_V);
int currentExpert=-1;
for(int row=first;row<stop;++row) {
while(expert+1<experts && row>=groupEnds[expert])++expert;
bool loadWeight=expert!=currentExpert;
if(loadWeight) {
if(row!=first)capi_wait<PIPE_V,PIPE_MTE2>(1);
capi_read(rawWeight,weights+int64_t(expert)*k*n,k*n);
capi_read(scales,coefficients+int64_t(expert)*n,n);
currentExpert=expert;
capi_notify<PIPE_MTE2,PIPE_V>(0);capi_wait<PIPE_MTE2,PIPE_V>(0);
asc_int82half(halfWeight,rawWeight,k*n);asc_sync_pipe(PIPE_V);
asc_half2float(floatWeight,halfWeight,k*n);asc_sync_pipe(PIPE_V);
}
asc_set_mask_norm();asc_set_vector_mask(0,~uint64_t(0));
auto activation=broadcasts+(row-first)*k*8;
for(int column=0;column<n;column+=64) {
asc_mul(products+column,floatWeight+column,activation,k,
1,1,0,n/8,n/8,1);
}
asc_sync_pipe(PIPE_V);
for(int halfRows=k/2;halfRows>0;halfRows/=2) {
int count=halfRows*n;
asc_add(products,products,products+count,count);
asc_sync_pipe(PIPE_V);
}
asc_mul(values,products,scales,n);asc_sync_pipe(PIPE_V);
if(row!=first)capi_wait<PIPE_MTE3,PIPE_V>(0);
capi_finish_gelu(values,gelu,result,n);
if(row+1<stop && expert+1<experts && row+1>=groupEnds[expert])
capi_notify<PIPE_V,PIPE_MTE2>(1);
capi_notify<PIPE_V,PIPE_MTE3>(0);capi_wait<PIPE_V,PIPE_MTE3>(0);
capi_write(destination+int64_t(row)*n,result,n);
if(row+1<stop)capi_notify<PIPE_MTE3,PIPE_V>(0);
}
asc_sync_pipe(PIPE_ALL);
asc_set_mask_norm();
asc_set_vector_mask(~uint64_t(0),~uint64_t(0));
}
template<int BM,int BN,int MaxK,bool Quant>
struct CcePublicEngine {
__gm__ int8_t* input;
__gm__ int8_t* weights;
__gm__ uint64_t* quantizedScales=nullptr;
__cbuf__ uint64_t* quantizedLocal=nullptr;
GmmPlan plan;
int activationExpert=-1,activationRow=-1,coefficientExpert=-1;
int writeSlot=0,readSlot=0,operandSlot=0;
bool prefetched=false,coefficientsReady=false;
__aicore__ inline void Init(CapiMemory& memory,GmmPlan p,
__gm__ int8_t* a,__gm__ int8_t* b) {
plan=p;input=a;weights=b;
memory.l1=BM*MaxK+2*256*BN;
set_flag(PIPE_MTE1,PIPE_MTE2,EVENT_ID0);
set_flag(PIPE_MTE1,PIPE_MTE2,EVENT_ID2);
set_flag(PIPE_MTE1,PIPE_MTE2,EVENT_ID3);
for(int slot=0;slot<2;++slot) {
set_flag(PIPE_M,PIPE_MTE1,static_cast<event_t>(slot));
}
set_flag(PIPE_FIX,PIPE_M,EVENT_ID0);
}
__aicore__ inline void LoadB(CapiTile tile,int panel) {
const int slot=writeSlot;writeSlot^=1;
wait_flag(PIPE_MTE1,PIPE_MTE2,static_cast<event_t>(2+slot));
auto dst=reinterpret_cast<__cbuf__ int8_t*>(uint64_t(BM*MaxK+slot*256*BN));
auto src=weights+(int64_t(tile.expert)*plan.k+panel)*plan.n+tile.column;
const int step=tile.columns>256?64:128;
copy_gm_to_cbuf_multi_nd2nz_b8(dst,src,0,step/32,32,tile.columns,
32*plan.n,plan.n,32,1,32*tile.columns);
set_flag(PIPE_MTE2,PIPE_MTE1,static_cast<event_t>(4+slot));
copy_gm_to_cbuf_multi_nd2nz_b8(dst+step*tile.columns,src+step*plan.n,
0,step/32,32,tile.columns,32*plan.n,plan.n,32,1,32*tile.columns);
set_flag(PIPE_MTE2,PIPE_MTE1,static_cast<event_t>(6+slot));
if(2*step<256)
copy_gm_to_cbuf_multi_nd2nz_b8(dst+2*step*tile.columns,src+2*step*plan.n,
0,(256-2*step)/32,32,tile.columns,32*plan.n,plan.n,32,1,32*tile.columns);
set_flag(PIPE_MTE2,PIPE_MTE1,static_cast<event_t>(2+slot));
}
__aicore__ inline void LoadOperands(CapiTile tile,__cbuf__ int8_t* b,
int reductionOffset,int inner,int count,int alignedRows,int slot) {
wait_flag(PIPE_M,PIPE_MTE1,static_cast<event_t>(slot));
auto left=reinterpret_cast<__ca__ int8_t*>(uint64_t(slot*BM*128));
auto right=reinterpret_cast<__cb__ int8_t*>(uint64_t(slot*32768));
asc_copy_l12l0a(left,reinterpret_cast<__cbuf__ int8_t*>(uint64_t(0)),
count,alignedRows,reductionOffset,0,1,1,1,1,1,1,false,false,false,false,plan.k);
load_cbuf_to_cb_transpose(right,b+inner*tile.columns,0,
(count/32)*(tile.columns/32),1,1,false,0);
set_flag(PIPE_MTE1,PIPE_M,static_cast<event_t>(slot));
}
__aicore__ inline void Multiply(CapiTile tile,__gm__ int32_t* target,
const CapiTile* nextTile,int reuseEvent=-1,int readySlot=0) {
if(reuseEvent>=0)wait_flag_dev(reuseEvent);
const int alignedRows=(tile.rows+15)&~15;
if(tile.expert!=activationExpert || tile.row!=activationRow) {
if(activationExpert>=0)set_flag(PIPE_MTE1,PIPE_MTE2,EVENT_ID0);
wait_flag(PIPE_MTE1,PIPE_MTE2,EVENT_ID0);
copy_gm_to_cbuf_multi_nd2nz_b8(reinterpret_cast<__cbuf__ int8_t*>(uint64_t(0)),
input+int64_t(tile.row)*plan.k,0,1,tile.rows,plan.k,0,plan.k,alignedRows,1,0);
set_flag(PIPE_MTE2,PIPE_MTE1,EVENT_ID0);
wait_flag(PIPE_MTE2,PIPE_MTE1,EVENT_ID0);
activationExpert=tile.expert;activationRow=tile.row;
}
if(!prefetched)LoadB(tile,0);
prefetched=false;
wait_flag(PIPE_FIX,PIPE_M,EVENT_ID0);
auto accumulator=reinterpret_cast<__cc__ int32_t*>(uint64_t(0));
asc_l13d_fmatrix_config matrix{};
matrix.config=(uint64_t(1)<<16)|alignedRows;
set_fmatrix(matrix.config);
const int step=tile.columns>256?64:128;
for(int panel=0;panel<plan.k;panel+=256) {
const int stage=readSlot;readSlot^=1;
auto b=reinterpret_cast<__cbuf__ int8_t*>(uint64_t(BM*MaxK+stage*256*BN));
wait_flag(PIPE_MTE2,PIPE_MTE1,static_cast<event_t>(4+stage));
if(panel+256<plan.k)LoadB(tile,panel+256);
else if(nextTile){LoadB(*nextTile,0);prefetched=true;}
LoadOperands(tile,b,panel,0,step,alignedRows,operandSlot);
for(int inner=0;inner<256;inner+=step) {
const int slot=operandSlot;operandSlot^=1;
wait_flag(PIPE_MTE1,PIPE_M,static_cast<event_t>(slot));
mad(accumulator,reinterpret_cast<__ca__ int8_t*>(uint64_t(slot*BM*128)),
reinterpret_cast<__cb__ int8_t*>(uint64_t(slot*32768)),
alignedRows,step,(tile.columns+15)&~15,0,false,false,panel==0 && inner==0);
set_flag(PIPE_M,PIPE_MTE1,static_cast<event_t>(slot));
const int next=inner+step;
if(next<256) {
if(next==step)wait_flag(PIPE_MTE2,PIPE_MTE1,static_cast<event_t>(6+stage));
else if(next==2*step)wait_flag(PIPE_MTE2,PIPE_MTE1,static_cast<event_t>(2+stage));
LoadOperands(tile,b,panel+next,next,step,alignedRows,operandSlot);
}
if(tile.rows!=BM)pipe_barrier(PIPE_M);
}
if(256<=2*step)wait_flag(PIPE_MTE2,PIPE_MTE1,static_cast<event_t>(2+stage));
set_flag(PIPE_MTE1,PIPE_MTE2,static_cast<event_t>(2+stage));
}
set_flag(PIPE_M,PIPE_FIX,EVENT_ID0);wait_flag(PIPE_M,PIPE_FIX,EVENT_ID0);
if constexpr(Quant) {
if(!coefficientsReady){wait_flag_dev(5);coefficientsReady=true;}
if(coefficientExpert!=tile.expert) {
if(coefficientExpert>=0) {
set_flag(PIPE_FIX,PIPE_MTE2,EVENT_ID7);wait_flag(PIPE_FIX,PIPE_MTE2,EVENT_ID7);
}
asc_copy_gm2l1(reinterpret_cast<__cbuf__ int8_t*>(quantizedLocal),
reinterpret_cast<__gm__ int8_t*>(quantizedScales+int64_t(tile.expert)*plan.n),
1,plan.n/4,0,0);
set_flag(PIPE_MTE2,PIPE_FIX,EVENT_ID7);wait_flag(PIPE_MTE2,PIPE_FIX,EVENT_ID7);
coefficientExpert=tile.expert;
}
for(int column=0;column<tile.columns;column+=256) {
const int columns=tile.columns-column<256?tile.columns-column:256;
asc_copy_l12fb(reinterpret_cast<__fbuf__ void*>(uint64_t(0)),
reinterpret_cast<__cbuf__ void*>(quantizedLocal+tile.column+column),
1,((columns+31)&~31)/16,0,0);
pipe_barrier(PIPE_FIX);
asc_set_l0c_copy_params(1,0,0);asc_set_l0c2gm_config(0,0,true);
copy_matrix_cc_to_gm(reinterpret_cast<__gm__ half*>(target)+column,
accumulator+column*alignedRows,0,columns,tile.rows,
BN,alignedRows,0,
QuantMode_t::VDEQF16,0,false,true);
pipe_barrier(PIPE_FIX);
}
} else {
asc_set_l0c_copy_params(1,0,0);asc_set_l0c2gm_config(0,0,true);
copy_matrix_cc_to_gm(target,accumulator,0,tile.columns,tile.rows,BN,alignedRows,0,
static_cast<QuantMode_t>(0),0,false,true);
}
set_flag(PIPE_FIX,PIPE_M,EVENT_ID0);
}
__aicore__ inline void Finish() {
if(activationExpert>=0)set_flag(PIPE_MTE1,PIPE_MTE2,EVENT_ID0);
wait_flag(PIPE_MTE1,PIPE_MTE2,EVENT_ID0);
wait_flag(PIPE_MTE1,PIPE_MTE2,EVENT_ID2);
wait_flag(PIPE_MTE1,PIPE_MTE2,EVENT_ID3);
for(int slot=0;slot<2;++slot) {
wait_flag(PIPE_M,PIPE_MTE1,static_cast<event_t>(slot));
}
wait_flag(PIPE_FIX,PIPE_M,EVENT_ID0);
}
};
__aicore__ inline void cce_public_gelu(__ubuf__ float* x,__ubuf__ float* t,
__ubuf__ half* out,int count) {
set_mask_count();set_vector_mask(0,count);
vmul(t,x,x,1,1,1,1,8,8,8);pipe_barrier(PIPE_V);
vmuls(t,t,-0.07135481627260091f,1,1,1,8,8);pipe_barrier(PIPE_V);
vadds(t,t,-1.5957691216057308f,1,1,1,8,8);pipe_barrier(PIPE_V);
vmul(t,t,x,1,1,1,1,8,8,8);pipe_barrier(PIPE_V);
vmins(t,t,80.0f,1,1,1,8,8);pipe_barrier(PIPE_V);
vexp(t,t,1,1,1,8,8);pipe_barrier(PIPE_V);
vadds(t,t,1.0f,1,1,1,8,8);pipe_barrier(PIPE_V);
vdiv(t,x,t,1,1,1,1,8,8,8);pipe_barrier(PIPE_V);
vconv_f322f16r(out,t,1,1,1,4,8);
set_mask_norm();set_vector_mask(~uint64_t(0),~uint64_t(0));
}
template<int BM,int BN>
struct CceColumnOwnerTraversal {
__gm__ int64_t* ends;
GmmPlan p;
int core,totalRows=0,lanes=2,expert=0,begin=0,end=0,rowBase=0,rowTiles=0,rowTile=0,lane=0,column=0;
bool loaded=false,ownerStarted=false;
__aicore__ CceColumnOwnerTraversal(__gm__ int64_t* groups,GmmPlan plan,int block):ends(groups),p(plan),core(block) {
int previous=0;
for(int e=0;e<p.e;++e){int stop=ends[e];totalRows+=(stop-previous+BM-1)/BM;previous=stop;}
if(totalRows<=p.cores && 2*totalRows>p.cores)lanes=1;
}
__aicore__ inline bool Next(CapiTile& tile) {
while(expert<p.e) {
if(!loaded){end=ends[expert];rowTiles=(end-begin+BM-1)/BM;loaded=true;}
while(rowTile<rowTiles) {
while(lane<lanes) {
if(!ownerStarted) {
if((rowBase+rowTile+lane*totalRows)%p.cores!=core){++lane;continue;}
column=lane*BN;ownerStarted=true;
}
if(column<p.n) {
int row=begin+rowTile*BM;
tile={expert,row,column,end-row<BM?end-row:BM,p.n-column<BN?p.n-column:BN};
column+=lanes*BN;return true;
}
++lane;ownerStarted=false;
}
++rowTile;lane=0;
}
rowBase+=rowTiles;begin=end;++expert;rowTile=0;lane=0;loaded=false;ownerStarted=false;
}
return false;
}
};
__aicore__ inline void cce_public_gelu_pingpong(__ubuf__ float* x,__ubuf__ float* t,
__ubuf__ half* out,int count) {
auto spare=t+8192+64;
set_mask_count();set_vector_mask(0,count);
vmul(t,x,x,1,1,1,1,8,8,8);pipe_barrier(PIPE_V);
vmuls(spare,t,-0.07135481627260091f,1,1,1,8,8);pipe_barrier(PIPE_V);
vadds(t,spare,-1.5957691216057308f,1,1,1,8,8);pipe_barrier(PIPE_V);
vmul(spare,t,x,1,1,1,1,8,8,8);pipe_barrier(PIPE_V);
vmins(t,spare,80.0f,1,1,1,8,8);pipe_barrier(PIPE_V);
vexp(spare,t,1,1,1,8,8);pipe_barrier(PIPE_V);
vadds(t,spare,1.0f,1,1,1,8,8);pipe_barrier(PIPE_V);
vdiv(spare,x,t,1,1,1,1,8,8,8);pipe_barrier(PIPE_V);
vconv_f322f16r(out,spare,1,1,1,4,8);
set_mask_norm();set_vector_mask(~uint64_t(0),~uint64_t(0));
}
__aicore__ inline void cce_public_gelu_affine(__ubuf__ float* x,__ubuf__ float* t,
__ubuf__ half* out,int count) {
auto spare=t+8192+64;
set_mask_count();set_vector_mask(0,count);
vmul(t,x,x,1,1,1,1,8,8,8);pipe_barrier(PIPE_V);
vmadd(t,reinterpret_cast<__ubuf__ float*>(uint64_t(185344)),
reinterpret_cast<__ubuf__ float*>(uint64_t(185600)),1,1,1,1,8,0,0);pipe_barrier(PIPE_V);
vmul(spare,t,x,1,1,1,1,8,8,8);pipe_barrier(PIPE_V);
vmins(t,spare,80.0f,1,1,1,8,8);pipe_barrier(PIPE_V);
vexp(spare,t,1,1,1,8,8);pipe_barrier(PIPE_V);
vadds(t,spare,1.0f,1,1,1,8,8);pipe_barrier(PIPE_V);
vdiv(spare,x,t,1,1,1,1,8,8,8);pipe_barrier(PIPE_V);
vconv_f322f16r(out,spare,1,1,1,4,8);
set_mask_norm();set_vector_mask(~uint64_t(0),~uint64_t(0));
}
__aicore__ inline void cce_public_half_gelu(__ubuf__ half* out,
__ubuf__ float* z,__ubuf__ float* t,int count) {
auto value=reinterpret_cast<__ubuf__ half*>((reinterpret_cast<uint64_t>(t)+511)&~uint64_t(511));
auto alternate=reinterpret_cast<__ubuf__ half*>((reinterpret_cast<uint64_t>(z)+511)&~uint64_t(511));
set_mask_count();set_vector_mask(0,count);
vmul(value,out,out,1,1,1,1,8,8,8);pipe_barrier(PIPE_V);
vmuls(alternate,value,half(-0.07135481627260091f),1,1,1,8,8);pipe_barrier(PIPE_V);
vadds(value,alternate,half(-1.5957691216057308f),1,1,1,8,8);pipe_barrier(PIPE_V);
vmul(alternate,value,out,1,1,1,1,8,8,8);pipe_barrier(PIPE_V);
vexp(value,alternate,1,1,1,8,8);pipe_barrier(PIPE_V);
vadds(alternate,value,half(1.0f),1,1,1,8,8);pipe_barrier(PIPE_V);
vdiv(out,out,alternate,1,1,1,1,8,8,8);
set_mask_norm();set_vector_mask(~uint64_t(0),~uint64_t(0));
}
template<int BM,int BN,int MaxK,bool Quant,int Flavor=0,int FullColumns=0>
__global__ __aicore__ __schedmode__(1) void gmm_cce_public(
GM_ADDR x,GM_ADDR weights,GM_ADDR scales,GM_ADDR groups,GM_ADDR output,
GM_ADDR workspace,GmmPlan p) {
KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
InitSocState();
if constexpr(FullColumns>0) {
__builtin_assume(p.k==MaxK);
__builtin_assume(p.n==FullColumns);
}
const int core=asc_get_block_idx();
auto scratch=reinterpret_cast<__gm__ int32_t*>(workspace)+int64_t(core)*2*BM*BN;
auto coefficients=reinterpret_cast<__gm__ uint64_t*>(
reinterpret_cast<__gm__ uint8_t*>(workspace)+int64_t(p.cores)*2*BM*BN*4);
if constexpr(Quant) {
if ASCEND_IS_AIV {capi_prepare_shared_coefficients(scales,coefficients,p);}
}
using Traversal=typename std::conditional<Flavor==2,CceColumnOwnerTraversal<BM,BN>,CapiTraversal<BM,BN,1,0>>::type;
Traversal traversal(reinterpret_cast<__gm__ int64_t*>(groups),p,core);
CapiTile tile;
if ASCEND_IS_AIC {
CcePublicEngine<BM,BN,MaxK,Quant> engine;
CapiMemory memory;
engine.Init(memory,p,reinterpret_cast<__gm__ int8_t*>(x),reinterpret_cast<__gm__ int8_t*>(weights));
engine.quantizedScales=coefficients;
engine.quantizedLocal=reinterpret_cast<__cbuf__ uint64_t*>(uint64_t(memory.l1));
int produced=0;
bool active=traversal.Next(tile);
while(active) {
CapiTile next;bool hasNext=traversal.Next(next);int slot=produced&1;
engine.Multiply(tile,scratch+slot*BM*BN,hasNext?&next:nullptr,
produced>=2?2+slot:-1,slot);
capi_block_arrive<PIPE_FIX,2>(slot);
++produced;active=hasNext;if(hasNext)tile=next;
}
engine.Finish();
if(produced>=1)wait_flag_dev(2);
if(produced>=2)wait_flag_dev(3);
} else {
if constexpr(Flavor==2) {
asc_duplicate(reinterpret_cast<__ubuf__ float*>(uint64_t(185344)),-0.07135481627260091f,64);
asc_duplicate(reinterpret_cast<__ubuf__ float*>(uint64_t(185600)),-1.5957691216057308f,64);
pipe_barrier(PIPE_V);
}
constexpr int ChunkRows=8192/BN;
constexpr int InputBytes=8192*(Quant?2:4);
auto z=reinterpret_cast<__ubuf__ float*>(uint64_t(2*InputBytes+256));
auto t=reinterpret_cast<__ubuf__ float*>(uint64_t(2*InputBytes+32768+512));
auto scaleLocal=reinterpret_cast<__ubuf__ float*>(uint64_t(2*InputBytes+(Flavor==0?65536+768:98304+1024)));
int pending=0,consumed=0;
bool scaleUsed=false;
while(traversal.Next(tile)) {
int tileSlot=consumed++&1;
int halfRows=capi_vector_half_rows<BM>(tile.rows);
int slice=asc_get_sub_block_id()*halfRows;
int rows=tile.rows-slice<halfRows?tile.rows-slice:halfRows;
if constexpr(!Quant) {
if(scaleUsed)wait_flag(PIPE_V,PIPE_MTE2,EVENT_ID6);
copy_gm_to_ubuf_align_b8(scaleLocal,reinterpret_cast<__gm__ float*>(scales)+
int64_t(tile.expert)*p.n+tile.column,0,1,tile.columns*4,0,0,0,0);
set_flag(PIPE_MTE2,PIPE_V,EVENT_ID6);scaleUsed=true;
}
wait_flag_dev(tileSlot);
if(rows<=0) {
capi_block_arrive<PIPE_MTE2,2>(2+tileSlot);
if constexpr(!Quant) {
wait_flag(PIPE_MTE2,PIPE_V,EVENT_ID6);set_flag(PIPE_V,PIPE_MTE2,EVENT_ID6);
}
continue;
}
auto source=reinterpret_cast<__gm__ uint8_t*>(scratch+tileSlot*BM*BN)+slice*BN*(Quant?2:4);
int first=rows<ChunkRows?rows:ChunkRows;
int stage=tileSlot;
if(pending&(1<<stage)){wait_flag(PIPE_MTE3,PIPE_MTE2,static_cast<event_t>(stage));pending^=1<<stage;}
auto in=reinterpret_cast<__ubuf__ uint8_t*>(uint64_t(stage*InputBytes));
copy_gm_to_ubuf_align_b8(in,source,0,1,first*BN*(Quant?2:4),0,0,0,0);
set_flag(PIPE_MTE2,PIPE_V,static_cast<event_t>(stage));
if(first==rows)capi_block_arrive<PIPE_MTE2,2>(2+tileSlot);
if constexpr(!Quant)wait_flag(PIPE_MTE2,PIPE_V,EVENT_ID6);
for(int part=0;part<rows;part+=ChunkRows) {
stage=(tileSlot+part/ChunkRows)&1;
int nr=rows-part<ChunkRows?rows-part:ChunkRows;
wait_flag(PIPE_MTE2,PIPE_V,static_cast<event_t>(stage));
if(part+nr<rows) {
int next=stage^1,remaining=rows-part-nr;
int nextRows=remaining<ChunkRows?remaining:ChunkRows;
if(pending&(1<<next)){wait_flag(PIPE_MTE3,PIPE_MTE2,static_cast<event_t>(next));pending^=1<<next;}
copy_gm_to_ubuf_align_b8(reinterpret_cast<__ubuf__ uint8_t*>(uint64_t(next*InputBytes)),
source+(part+nr)*BN*(Quant?2:4),0,1,nextRows*BN*(Quant?2:4),0,0,0,0);
set_flag(PIPE_MTE2,PIPE_V,static_cast<event_t>(next));
if(part+nr+nextRows==rows)capi_block_arrive<PIPE_MTE2,2>(2+tileSlot);
}
in=reinterpret_cast<__ubuf__ uint8_t*>(uint64_t(stage*InputBytes));
auto out=reinterpret_cast<__ubuf__ half*>(in);
if constexpr(Quant && Flavor==1) {
cce_public_half_gelu(out,z,t,nr*BN);
} else {
set_mask_count();set_vector_mask(0,nr*BN);
if constexpr(Quant)vconv_f162f32(z,reinterpret_cast<__ubuf__ half*>(in),1,1,1,8,4);
else vconv_s322f32r(z,reinterpret_cast<__ubuf__ int32_t*>(in),1,1,1,8,8);
pipe_barrier(PIPE_V);
if constexpr(!Quant) {
set_mask_norm();set_vector_mask(0,~uint64_t(0));
for(int column=0;column<BN;column+=64)
vmul(z+column,z+column,scaleLocal+column,nr,1,1,1,BN/8,BN/8,0);
pipe_barrier(PIPE_V);
}
if constexpr(Flavor==2)cce_public_gelu_affine(z,t,out,nr*BN);
else if constexpr(Flavor==1)cce_public_gelu_pingpong(z,t,out,nr*BN);
else cce_public_gelu(z,t,out,nr*BN);
}
set_flag(PIPE_V,PIPE_MTE3,EVENT_ID0);wait_flag(PIPE_V,PIPE_MTE3,EVENT_ID0);
copy_ubuf_to_gm_align_b8(reinterpret_cast<__gm__ half*>(output)+
int64_t(tile.row+slice+part)*p.n+tile.column,out,0,nr,tile.columns*2,0,0,
(BN-tile.columns)/16,(p.n-tile.columns)*2);
set_flag(PIPE_MTE3,PIPE_MTE2,static_cast<event_t>(stage));pending|=1<<stage;
}
if constexpr(!Quant)set_flag(PIPE_V,PIPE_MTE2,EVENT_ID6);
}
if constexpr(!Quant)if(scaleUsed)wait_flag(PIPE_V,PIPE_MTE2,EVENT_ID6);
for(int slot=0;slot<2;++slot)if(pending&(1<<slot))
wait_flag(PIPE_MTE3,PIPE_MTE2,static_cast<event_t>(slot));
}
}
__global__ __aicore__ __schedmode__(1) void gmm_cce_small_cube(
GM_ADDR x,GM_ADDR weight,GM_ADDR scale,GM_ADDR output,GM_ADDR workspace) {
KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
InitSocState();
constexpr int Rows=16,Columns=128,Reduction=128,Slice=8;
int block=asc_get_block_idx();
auto scratch=reinterpret_cast<__gm__ int32_t*>(workspace)+block*Rows*Columns;
if ASCEND_IS_AIC {
asc_set_l0c2gm_config(0,0,true);
auto a1=reinterpret_cast<__cbuf__ int8_t*>(uint64_t(0));
auto b1=reinterpret_cast<__cbuf__ int8_t*>(uint64_t(Rows*Reduction));
auto a0=reinterpret_cast<__ca__ int8_t*>(uint64_t(0));
auto b0=reinterpret_cast<__cb__ int8_t*>(uint64_t(0));
auto accumulator=reinterpret_cast<__cc__ int32_t*>(uint64_t(0));
copy_gm_to_cbuf_multi_nd2nz_b8(a1,reinterpret_cast<__gm__ int8_t*>(x)+block*Rows*Reduction,
0,1,Rows,Reduction,0,Reduction,Rows,1,0);
copy_gm_to_cbuf_multi_nd2nz_b8(b1,reinterpret_cast<__gm__ int8_t*>(weight),
0,4,32,Columns,32*Columns,Columns,32,1,32*Columns);
set_flag(PIPE_MTE2,PIPE_MTE1,EVENT_ID0);wait_flag(PIPE_MTE2,PIPE_MTE1,EVENT_ID0);
set_fmatrix((uint64_t(1)<<16)|Rows);
asc_copy_l12l0a(a0,a1,Reduction,Rows,0,0,1,1,1,1,1,1,false,false,false,false,Reduction);
load_cbuf_to_cb_transpose(b0,b1,0,16,1,1,false,0);
set_flag(PIPE_MTE1,PIPE_M,EVENT_ID0);wait_flag(PIPE_MTE1,PIPE_M,EVENT_ID0);
mad(accumulator,a0,b0,Rows,Reduction,Columns,3,false,false,true);
asc_set_l0c_copy_params(1,0,0);asc_set_l0c2gm_config(0,0,false);
copy_matrix_cc_to_gm(scratch,accumulator,0,Columns,Rows,Columns,Rows,3,
static_cast<QuantMode_t>(0),0,false,true);
ffts_cross_core_sync(PIPE_FIX,uint64_t(0x21));
} else {
constexpr int Count=Slice*Columns;
auto input=reinterpret_cast<__ubuf__ int32_t*>(uint64_t(256));
auto z=reinterpret_cast<__ubuf__ float*>(uint64_t(256+Count*4));
auto t=reinterpret_cast<__ubuf__ float*>(uint64_t(512+Count*8));
auto coefficients=reinterpret_cast<__ubuf__ float*>(uint64_t(1024+Count*16));
auto out=reinterpret_cast<__ubuf__ half*>(input);
int slice=asc_get_sub_block_id()*Slice;
copy_gm_to_ubuf_align_b8(coefficients,reinterpret_cast<__gm__ float*>(scale),0,1,Columns*4,0,0,0,0);
wait_flag_dev(0);
copy_gm_to_ubuf_align_b8(input,scratch+slice*Columns,0,1,Count*4,0,0,0,0);
set_flag(PIPE_MTE2,PIPE_V,EVENT_ID0);wait_flag(PIPE_MTE2,PIPE_V,EVENT_ID0);
set_mask_count();set_vector_mask(0,Count);
vconv_s322f32r(z,input,1,1,1,8,8);pipe_barrier(PIPE_V);
set_mask_norm();set_vector_mask(0,~uint64_t(0));
for(int column=0;column<Columns;column+=64)
vmul(z+column,z+column,coefficients+column,Slice,1,1,1,Columns/8,Columns/8,0);
pipe_barrier(PIPE_V);
set_mask_count();set_vector_mask(0,Count);
vconv_f322f16r(out,z,1,1,1,4,8);pipe_barrier(PIPE_V);
cce_public_half_gelu(out,z,t,Count);
set_flag(PIPE_V,PIPE_MTE3,EVENT_ID0);wait_flag(PIPE_V,PIPE_MTE3,EVENT_ID0);
copy_ubuf_to_gm_align_b8(reinterpret_cast<__gm__ half*>(output)+(block*Rows+slice)*Columns,
out,0,1,Count*2,0,0,0,0);
}
}
namespace NativeRewrite {
using namespace AscendC;
#pragma clang fp reassociate(off) contract(off)
struct GmmPlan { int m,k,n,e,cores,directCube=0,directTall=0; };
struct CceStorage { uint32_t l1=0; };
struct CceTile { int expert,row,column,rows,columns; };
template<pipe_t Pipeline,int Mode>
__aicore__ inline void CceSignal(int event) {
ffts_cross_core_sync(Pipeline,uint64_t(1)|(uint64_t(Mode)<<4)|(uint64_t(event)<<8));
}
__aicore__ inline int CcePitch(int columns) { return (columns+63)&~63; }
template<int Mode>
__aicore__ inline int shifted_column(int column,int rowTile,int expert,int tiles,int cores) {
if constexpr(Mode==0)return column;
int offset=Mode==1?expert%tiles:(rowTile*tiles/cores)%tiles;
int result=column+offset;
return result<tiles?result:result-tiles;
}
template<int BM, int BN, int Mode, int Rotate, bool FullColumnsFirst=false>
struct CceTraversal {
__gm__ int64_t* ends;
GmmPlan p;
int core, expert=0, rowTile=0, columnTile=0;
int rowBase=0, begin=0, index;
int64_t workBase=0, low=0, high=0;
#if GMM_OPT_GROUP_BOUNDS
int cachedExpert=-1,cachedEnd=0,cachedRows=0,cachedRowTiles=0;
#endif
__aicore__ CceTraversal(__gm__ int64_t* groups, GmmPlan plan, int block)
: ends(groups), p(plan), core(block), index(block) {
if constexpr (Mode==2 || Mode==4) {
int active=0, previous=0;
if constexpr (Mode==4) {
for(int e=0;e<p.e;++e) {
int end=ends[e];
if(end>previous)++active;
previous=end;
}
}
int64_t total=((int64_t)p.m+(Mode==4?int64_t(active)*BM*2:0))*p.n;
low=(total*core+p.cores-1)/p.cores;
high=(total*(core+1)+p.cores-1)/p.cores;
if constexpr (Mode==2) {
int limit=p.e;
while(expert<limit) {
int middle=expert+(limit-expert)/2;
if((int64_t)ends[middle]*p.n<=low)expert=middle+1;
else limit=middle;
}
begin=expert==0?0:ends[expert-1];
}
}
}
__aicore__ inline bool Next(CceTile& result) {
int nt=(p.n+BN-1)/BN;
if constexpr (Mode==3 || Mode==7) {
while(index<p.e*nt) {
int e=index/nt;
int c=(index-e*nt+e)%nt;
if constexpr(FullColumnsFirst) {
if(p.n%BN!=0) {
int fullColumns=nt-1;
int fullUnits=p.e*fullColumns;
if(index<fullUnits) {
e=index/fullColumns;
c=(index-e*fullColumns+e)%fullColumns;
} else {
e=index-fullUnits;
c=fullColumns;
}
}
}
#if GMM_OPT_GROUP_BOUNDS
if(cachedExpert!=e) {
cachedExpert=e;
cachedEnd=ends[e];
int first=e==0?0:ends[e-1];
cachedRows=cachedEnd-first;
cachedRowTiles=(cachedRows+BM-1)/BM;
}
int end=cachedEnd,first=end-cachedRows,rt=cachedRowTiles;
#else
int first=e==0?0:ends[e-1],end=ends[e];
int rt=(end-first+BM-1)/BM;
#endif
if(rowTile>=rt){index+=p.cores;rowTile=0;continue;}
int row=first+(rowTile++)*BM,col=c*BN;
result={e,row,col,end-row<BM?end-row:BM,p.n-col<BN?p.n-col:BN};
return true;
}
return false;
}
while(expert<p.e) {
#if GMM_OPT_GROUP_BOUNDS
if(cachedExpert!=expert) {
cachedExpert=expert;
cachedEnd=ends[expert];
cachedRows=cachedEnd-begin;
cachedRowTiles=(cachedRows+BM-1)/BM;
}
int end=cachedEnd,rows=cachedRows,rt=cachedRowTiles;
#else
int end=ends[expert];
int rows=end-begin, rt=(rows+BM-1)/BM;
#endif
if constexpr (Mode<=1) {
int units=Mode==1?rt:rt*nt;
if(index>=units) {
index-=units;rowBase+=rt;begin=end;++expert;
columnTile=0;
continue;
}
int r=Mode==1?index:index/nt;
int c=Mode==1?columnTile:index-r*nt;
c=shifted_column<Rotate>(c,rowBase+r,expert,nt,p.cores);
if constexpr (Mode==1) {
if(++columnTile==nt){columnTile=0;index+=p.cores;}
} else index+=p.cores;
int row=begin+r*BM,col=c*BN;
result={expert,row,col,end-row<BM?end-row:BM,p.n-col<BN?p.n-col:BN};
return true;
}
if constexpr (Mode==2)if((int64_t)begin*p.n>=high)return false;
if constexpr (Mode==4)if(workBase>=high)return false;
if(rt==0 || columnTile>=nt) {
rowBase+=rt;
if(rows>0)workBase+=((int64_t)rows+(Mode==4?BM*2:0))*p.n;
begin=end;
++expert;rowTile=0;columnTile=0;
continue;
}
int r=rowTile,c=columnTile;
int nc=p.n-c*BN<BN?p.n-c*BN:BN;
int start,stop;
if constexpr (Mode==4) {
int64_t weightedRows=(int64_t)rows+BM*2;
int64_t panel=workBase+weightedRows*c*BN;
int64_t cost=weightedRows*nc;
start=low<=panel?0:(int)(((low-panel)*rt+cost-1)/cost);
stop=high<=panel?0:(int)(((high-panel)*rt+cost-1)/cost);
} else {
int64_t panel=(int64_t)begin*p.n+(int64_t)rows*c*BN;
int stride=BM*nc;
start=low<=panel?0:(int)((low-panel+stride-1)/stride);
stop=high<=panel?0:(int)((high-panel+stride-1)/stride);
}
if(stop>rt)stop=rt;
if(r<start)r=start;
if(r>=stop){rowTile=0;++columnTile;continue;}
rowTile=r+1;
int row=begin+r*BM,col=c*BN;
result={expert,row,col,end-row<BM?end-row:BM,p.n-col<BN?p.n-col:BN};
return true;
}
return false;
}
};
template<int BM, int BN, int Mode, int Rotate>
struct CcePackedTraversal {
__gm__ int64_t* ends;
GmmPlan p;
int core, expert=0, rowTile=0, columnTile=0;
int rowBase=0, begin=0, index;
int64_t workBase=0, low=0, high=0;
int cachedExpert=-1, cachedEnd=0, cachedRows=0, cachedRowTiles=0;
__aicore__ inline int CostColumns() const {
return Mode==9?((p.n+BN-1)/BN)*BN:p.n;
}
__aicore__ CcePackedTraversal(__gm__ int64_t* groups, GmmPlan plan, int block)
: ends(groups), p(plan), core(block), index(block) {
if(Mode==3 && p.e<=p.cores && p.n>768 && p.n<=896 && p.k>=768 && p.k<2048) {
int strips=(p.n+31)/32;
low=(int64_t)p.e*strips*core/p.cores;
high=(int64_t)p.e*strips*(core+1)/p.cores;
expert=low/strips;
begin=expert==0?0:ends[expert-1];
}
if constexpr (Mode==5 || Mode==8) {
int strips=(p.n+31)/32;
int64_t work=(int64_t)p.e*strips;
low=work*core/p.cores;
high=work*(core+1)/p.cores;
expert=low/strips;
begin=expert==0?0:ends[expert-1];
}
if constexpr (Mode==2 || Mode==4 || Mode==9) {
int active=0, previous=0;
if constexpr (Mode==4) {
for(int e=0;e<p.e;++e) {
int end=ends[e];
if(end>previous)++active;
previous=end;
}
}
int64_t total=((int64_t)p.m+(Mode==4?int64_t(active)*BM*2:0))*CostColumns();
low=(total*core+p.cores-1)/p.cores;
high=(total*(core+1)+p.cores-1)/p.cores;
if constexpr (Mode==2 || Mode==9) {
int limit=p.e;
while(expert<limit) {
int middle=expert+(limit-expert)/2;
if((int64_t)ends[middle]*CostColumns()<=low)expert=middle+1;
else limit=middle;
}
begin=expert==0?0:ends[expert-1];
}
}
}
__aicore__ inline bool Next(CceTile& result) {
int nt=(p.n+BN-1)/BN;
if(Mode==3 && p.e<=p.cores && p.n>896 && p.k>=768 && p.k<2048 && nt>1) {
const int fullJobs=p.e*(nt-1);
const int remainder=fullJobs%p.cores;
const int lightCores=p.cores-remainder;
while(index<fullJobs) {
const int e=index/(nt-1),c=index%(nt-1);
const int first=e==0?0:ends[e-1],end=ends[e];
const int rt=(end-first+BM-1)/BM;
if(rowTile>=rt){index+=p.cores;rowTile=0;continue;}
const int row=first+(rowTile++)*BM;
result={e,row,c*BN,end-row<BM?end-row:BM,BN};
return true;
}
if(core<remainder)return false;
if(columnTile==0){expert=core-remainder;columnTile=1;rowTile=0;}
while(expert<p.e) {
const int first=expert==0?0:ends[expert-1],end=ends[expert];
const int rt=(end-first+BM-1)/BM;
if(rowTile>=rt){expert+=lightCores;rowTile=0;continue;}
const int row=first+(rowTile++)*BM,column=(nt-1)*BN;
result={expert,row,column,end-row<BM?end-row:BM,p.n-column};
return true;
}
return false;
}
if(Mode==3 && p.e<=p.cores && p.n>768 && p.n<=896 && p.k>=768 && p.k<2048) {
const int strips=(p.n+31)/32;
while(expert<p.e && low<high) {
int end=ends[expert],rows=end-begin,rt=(rows+BM-1)/BM;
int64_t groupBegin=(int64_t)expert*strips;
int available=high-groupBegin<strips?(int)(high-groupBegin):strips;
int start=(int)(low-groupBegin);
if(!rt || start>=available) {
low=groupBegin+available;begin=end;++expert;rowTile=0;continue;
}
int remaining=available-start;
int panels=(remaining+BN/32-1)/(BN/32);
int count=(remaining+panels-1)/panels;
int row=begin+rowTile*BM,col=start*32;
result={expert,row,col,end-row<BM?end-row:BM,p.n-col<count*32?p.n-col:count*32};
if(++rowTile==rt){rowTile=0;low+=count;}
return true;
}
return false;
}
if constexpr (Mode==3) {
while(index<p.e*nt) {
int e=index/nt;
int c=(index-e*nt+e)%nt;
#if GMM_OPT_GROUP_BOUNDS
if(cachedExpert!=e) {
cachedExpert=e;
cachedEnd=ends[e];
int first=e==0?0:ends[e-1];
cachedRows=cachedEnd-first;
cachedRowTiles=(cachedRows+BM-1)/BM;
}
int end=cachedEnd,first=end-cachedRows,rt=cachedRowTiles;
#else
int first=e==0?0:ends[e-1],end=ends[e];
int rt=(end-first+BM-1)/BM;
#endif
if(rowTile>=rt){index+=p.cores;rowTile=0;continue;}
int row=first+(rowTile++)*BM,col=c*BN;
result={e,row,col,end-row<BM?end-row:BM,p.n-col<BN?p.n-col:BN};
return true;
}
return false;
}
while(expert<p.e) {
int end,rows,rt;
if constexpr (Mode==4 || GMM_OPT_GROUP_BOUNDS) {
if(cachedExpert!=expert) {
cachedExpert=expert;
cachedEnd=ends[expert];
cachedRows=cachedEnd-begin;
cachedRowTiles=(cachedRows+BM-1)/BM;
}
end=cachedEnd;rows=cachedRows;rt=cachedRowTiles;
} else {
end=ends[expert];rows=end-begin;rt=(rows+BM-1)/BM;
}
if constexpr (Mode==8) {
if(low>=high)return false;
int strips=(p.n+31)/32;
int64_t groupBegin=(int64_t)expert*strips;
int available=high-groupBegin<strips?(int)(high-groupBegin):strips;
int start=(int)(low-groupBegin);
if(!rt || start>=available) {
low=groupBegin+available;begin=end;++expert;rowTile=0;
continue;
}
int remaining=available-start;
int panels=(remaining+BN/32-1)/(BN/32);
int count=(remaining+panels-1)/panels;
int row=begin+rowTile*BM,col=start*32;
int width=p.n-col<count*32?p.n-col:count*32;
result={expert,row,col,end-row<BM?end-row:BM,width};
if(++rowTile==rt){rowTile=0;low+=count;}
return true;
}
if constexpr (Mode==5) {
if(low>=high)return false;
int strips=(p.n+31)/32;
int64_t groupBegin=(int64_t)expert*strips;
int first=low-groupBegin;
int stop=high-groupBegin<strips?(int)(high-groupBegin):strips;
if(rowTile>=rt) {
low=groupBegin+stop;
begin=end;++expert;rowTile=0;columnTile=0;
continue;
}
int firstBlock=first+columnTile;
int count=stop-firstBlock<BN/32?stop-firstBlock:BN/32;
int row=begin+rowTile*BM,col=firstBlock*32;
int width=p.n-col<count*32?p.n-col:count*32;
columnTile+=count;
if(first+columnTile>=stop){columnTile=0;++rowTile;}
result={expert,row,col,end-row<BM?end-row:BM,width};
return true;
}
if constexpr (Mode<=1 || Mode==6) {
int units=Mode==1?rt:rt*nt;
if(index>=units) {
index-=units;rowBase+=rt;begin=end;++expert;
columnTile=0;
continue;
}
int r=Mode==1?index:index/nt;
int c=Mode==1?columnTile:index-r*nt;
c=shifted_column<Rotate>(c,rowBase+r,expert,nt,p.cores);
if constexpr (Mode==1) {
if(++columnTile==nt){columnTile=0;index+=p.cores;}
} else index+=p.cores;
int row=begin+r*BM;
int tileRows=end-row<BM?end-row:BM;
if constexpr (Mode==6) {
int offset=(rows*r+rt-1)/rt;
int nextOffset=(rows*(r+1)+rt-1)/rt;
row=begin+offset;
tileRows=nextOffset-offset;
}
int col=c*BN;
int columns=p.n-col<BN?p.n-col:BN;
if constexpr(Mode==6 && BM==96 && BN==256) {
const int blocks=(p.n+31)/32;
const int first=(blocks*c+nt-1)/nt;
const int last=(blocks*(c+1)+nt-1)/nt;
col=first*32;
columns=p.n-col<(last-first)*32?p.n-col:(last-first)*32;
}
result={expert,row,col,tileRows,columns};
return true;
}
if constexpr (Mode==2 || Mode==9)if((int64_t)begin*CostColumns()>=high)return false;
if constexpr (Mode==4)if(workBase>=high)return false;
if(rt==0 || columnTile>=nt) {
rowBase+=rt;
if(rows>0)workBase+=((int64_t)rows+(Mode==4?BM*2:0))*p.n;
begin=end;
++expert;rowTile=0;columnTile=0;
continue;
}
int r=rowTile,c=columnTile;
int nc=p.n-c*BN<BN?p.n-c*BN:BN;
int start,stop;
if constexpr (Mode==4) {
int64_t weightedRows=(int64_t)rows+BM*2;
int64_t panel=workBase+weightedRows*c*BN;
int64_t cost=weightedRows*nc;
start=low<=panel?0:(int)(((low-panel)*rt+cost-1)/cost);
stop=high<=panel?0:(int)(((high-panel)*rt+cost-1)/cost);
} else {
int64_t panel=(int64_t)begin*CostColumns()+(int64_t)rows*c*BN;
int stride=BM*(Mode==9?BN:nc);
start=low<=panel?0:(int)((low-panel+stride-1)/stride);
stop=high<=panel?0:(int)((high-panel+stride-1)/stride);
}
if(stop>rt)stop=rt;
if(r<start)r=start;
if(r>=stop){rowTile=0;++columnTile;continue;}
rowTile=r+1;
int row=begin+r*BM,col=c*BN;
result={expert,row,col,end-row<BM?end-row:BM,p.n-col<BN?p.n-col:BN};
return true;
}
return false;
}
};
template<int BM,int BN>
struct CceContiguousExpertTraversal {
__gm__ int64_t* ends;
GmmPlan p;
int expert,stop,row=0,column=0,end=0;
bool loaded=false,first=true;
__aicore__ CceContiguousExpertTraversal(__gm__ int64_t* groups,GmmPlan plan,int block)
:ends(groups),p(plan),expert(plan.e*block/plan.cores),stop(plan.e*(block+1)/plan.cores) {}
__aicore__ inline bool Next(CceTile& result) {
while(expert<stop) {
if(!loaded) {
row=first?(expert==0?0:int(ends[expert-1])):end;
end=int(ends[expert]);column=0;loaded=true;first=false;
}
if(row>=end){++expert;loaded=false;continue;}
result={expert,row,column,end-row<BM?end-row:BM,p.n-column<BN?p.n-column:BN};
column+=BN;if(column>=p.n){column=0;row+=BM;}
return true;
}
return false;
}
};
__aicore__ inline void cce_public_gelu(__ubuf__ float* x,__ubuf__ float* t,
__ubuf__ half* out,int count) {
set_mask_count();set_vector_mask(0,count);
vmul(t,x,x,1,1,1,1,8,8,8);pipe_barrier(PIPE_V);
vmuls(t,t,-0.07135481627260091f,1,1,1,8,8);pipe_barrier(PIPE_V);
vadds(t,t,-1.5957691216057308f,1,1,1,8,8);pipe_barrier(PIPE_V);
vmul(t,t,x,1,1,1,1,8,8,8);pipe_barrier(PIPE_V);
vmins(t,t,80.0f,1,1,1,8,8);pipe_barrier(PIPE_V);
vexp(t,t,1,1,1,8,8);pipe_barrier(PIPE_V);
vadds(t,t,1.0f,1,1,1,8,8);pipe_barrier(PIPE_V);
vdiv(t,x,t,1,1,1,1,8,8,8);pipe_barrier(PIPE_V);
vconv_f322f16r(out,t,1,1,1,4,8);
set_mask_norm();set_vector_mask(~uint64_t(0),~uint64_t(0));
}
template<int BM,int BN>
struct CceColumnOwnerTraversal {
__gm__ int64_t* ends;
GmmPlan p;
int core,totalRows=0,lanes=2,expert=0,begin=0,end=0,rowBase=0,rowTiles=0,rowTile=0,lane=0,column=0;
bool loaded=false,ownerStarted=false;
__aicore__ CceColumnOwnerTraversal(__gm__ int64_t* groups,GmmPlan plan,int block):ends(groups),p(plan),core(block) {
int previous=0;
for(int e=0;e<p.e;++e){int stop=ends[e];totalRows+=(stop-previous+BM-1)/BM;previous=stop;}
if(totalRows<=p.cores && 2*totalRows>p.cores)lanes=1;
}
__aicore__ inline bool Next(CceTile& tile) {
while(expert<p.e) {
if(!loaded){end=ends[expert];rowTiles=(end-begin+BM-1)/BM;loaded=true;}
while(rowTile<rowTiles) {
while(lane<lanes) {
if(!ownerStarted) {
if((rowBase+rowTile+lane*totalRows)%p.cores!=core){++lane;continue;}
column=lane*BN;ownerStarted=true;
}
if(column<p.n) {
int row=begin+rowTile*BM;
tile={expert,row,column,end-row<BM?end-row:BM,p.n-column<BN?p.n-column:BN};
column+=lanes*BN;return true;
}
++lane;ownerStarted=false;
}
++rowTile;lane=0;
}
rowBase+=rowTiles;begin=end;++expert;rowTile=0;lane=0;loaded=false;ownerStarted=false;
}
return false;
}
};
__aicore__ inline void cce_public_gelu_pingpong(__ubuf__ float* x,__ubuf__ float* t,
