int countUnits=unitsPerExpert-unit%unitsPerExpert;
if(countUnits>stop-unit)countUnits=stop-unit;
if(countUnits>packRows/32)countUnits=packRows/32;
int paddedCount=countUnits*32;
int count=p.k-row<paddedCount?p.k-row:paddedCount;
int nextUnit=capi_next_active_pack_unit(
ends,unit+countUnits,stop,unitsPerExpert);
if(nextUnit<stop) {
int nextStage=stage^1;
if(pending[nextStage]) {
capi_wait<PIPE_MTE3,PIPE_MTE2>(4+nextStage);
pending[nextStage]=false;
}
