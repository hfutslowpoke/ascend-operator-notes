reinterpret_cast<__cb__ int8_t*>(uint64_t(slot*BN*128)),
alignedRows,reduction,columns,unitFlags?(final?3:2):0,
false,false,panel==0 && inner==0);
set_flag(PIPE_M,PIPE_MTE1,static_cast<event_t>(slot));
