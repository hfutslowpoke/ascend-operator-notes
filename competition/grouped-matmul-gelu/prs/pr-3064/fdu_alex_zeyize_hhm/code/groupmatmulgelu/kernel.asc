if(useHalfwordPacking)capi_pack_weight_halfwords(local,source,
int64_t(expert)*p.k+row,count,p);
else capi_nd_to_nz(local,source+((int64_t)expert*p.k+row)*p.n,
count,p.n,p.n,(count+31)&~31);
} else capi_nd_to_nz(local,source+((int64_t)expert*p.k+row)*p.n,
