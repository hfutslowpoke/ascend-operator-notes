reinterpret_cast<__gm__ int16_t*>(source),1,tile.rows/2,bulk/2,0,plan.k,stride,2,0);
asc_copy_gm2l1_nd2nz(reinterpret_cast<__cbuf__ int16_t*>(local+32),
reinterpret_cast<__gm__ int16_t*>(source+plan.k),1,tile.rows/2,bulk/2,0,plan.k,stride,2,0);
if(bulk<count)copy_gm_to_cbuf_multi_nd2nz_b8(local+bulk*stride,source+bulk,
