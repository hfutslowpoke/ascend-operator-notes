constexpr int UB_BYTES=192*1024-(FusedAffine?GELU_AFFINE_BYTES:0);
constexpr bool BUFFERED_GELU=Mode==2 || Mode==4;
constexpr bool COMPACT_SCRATCH=Mode==2 && PackTail && FineTail && !SingleTile && !FusedAffine;
constexpr int TEMP_CAPACITY=BUFFERED_GELU?8192:0;
constexpr int REUSED_ROWS=(UB_BYTES-256-(BUFFERED_GELU?4:3)*PAD-
BN*4-TEMP_CAPACITY*4)/(12*BN);
