if(tile.expert!=weightExpert || tile.column!=weightColumn) {
if(!usingPrefetchedB) {
wait_flag(PIPE_MTE1,PIPE_MTE2,EVENT_ID2);
CopyWeight(tile,0,plan.k);
set_flag(PIPE_MTE2,PIPE_MTE1,EVENT_ID2);
wait_flag(PIPE_MTE2,PIPE_MTE1,EVENT_ID2);
}
weightExpert=tile.expert;weightColumn=tile.column;
}
bPrefetched=false;
int initial=plan.k<KP?plan.k:KP;
if(!aPrefetched)LoadA(tile,0,initial);
aPrefetched=false;
if(!unitFlags || !previousUnit){set_flag(PIPE_FIX,PIPE_M,EVENT_ID0);wait_flag(PIPE_FIX,PIPE_M,EVENT_ID0);}
previousUnit=unitFlags;
auto accumulator=reinterpret_cast<__cc__ int32_t*>(uint64_t(0));
bool prefetchNextB=false && nextTile && plan.k<=2*KP &&
(nextTile->expert!=tile.expert || nextTile->column!=tile.column) &&
((nextTile->columns+31)&~31)==columns;
for(int panel=0;panel<plan.k;panel+=KP) {
int count=plan.k-panel<KP?plan.k-panel:KP;
int paddedCount=(count+31)&~31;
int aSlot=readSlot;readSlot^=1;
wait_flag(PIPE_MTE2,PIPE_MTE1,static_cast<event_t>(aSlot));
if(usingPrefetchedB)wait_flag(PIPE_MTE2,PIPE_MTE1,static_cast<event_t>(6+panel/KP));
auto localA=Activation(aSlot);
if(panel+count<plan.k)LoadA(tile,panel+count,plan.k-panel-count<KP?plan.k-panel-count:KP);
else if(nextTile){LoadA(*nextTile,0,initial);aPrefetched=true;}
LoadOperands(tile,localA,panel,0,paddedCount<128?paddedCount:128,paddedCount,alignedRows,columns);
for(int inner=0;inner<paddedCount;inner+=128) {
int reduction=paddedCount-inner<128?paddedCount-inner:128;
int slot=operandSlot;operandSlot^=1;
wait_flag(PIPE_MTE1,PIPE_M,static_cast<event_t>(slot));
if(prefetchNextB && inner+reduction>=paddedCount) {
event_t event=static_cast<event_t>(4+panel/KP);
set_flag(PIPE_MTE1,PIPE_MTE2,event);wait_flag(PIPE_MTE1,PIPE_MTE2,event);
CopyWeight(*nextTile,panel,count);
set_flag(PIPE_MTE2,PIPE_MTE1,static_cast<event_t>(6+panel/KP));
