using OriginalEngine=CapiPanelEngine<BM,BN,BK,KP,(Mode==1 || Mode==5 || PrefetchRows),
((Mode>=2 && Mode<=4) || Mode==8),PIPE_FIX,PrefetchRows,InplaceResidentBPrefetch,Mode==6,VectorPackWeights,BStages,(Mode==4),false,(Mode==3 && BN>=384),false,false,false,StageMajorWeights>;
