bool usingPrefetchedB=false;
if constexpr (ResidentB) {
if(tile.expert!=bExpert || tile.column!=bColumn) {
if constexpr (InplaceResidentBPrefetch) {
if(bPrefetched && tile.expert==bPrefetchedExpert &&
tile.column==bPrefetchedColumn) {
usingPrefetchedB=true;
bPrefetched=false;
} else {
if(bExpert>=0)bq.FreeTensor(heldB);
LoadB(tile,0,p.k);
heldB=bq.template DeQue<int8_t>();
}
} else {
if(bExpert>=0)bq.FreeTensor(heldB);
LoadB(tile,0,p.k);
heldB=bq.template DeQue<int8_t>();
}
bExpert=tile.expert;bColumn=tile.column;
}
}
if constexpr (PrefetchRows) {
if(nextTile && (nextTile->expert!=tile.expert || nextTile->row!=tile.row)) {
LoadA(*nextTile,0,p.k);
aPrefetched=true;
}
}
int initial=p.k<KP?p.k:KP;
if constexpr (!ResidentB && BStages>2) {
if(!bPrefetched)LoadB(tile,0,initial);
for(int prime=KP;prime<(BStages-1)*KP && prime<p.k;prime+=KP) {
int primeCount=p.k-prime<KP?p.k-prime:KP;
LoadB(tile,prime,primeCount);
}
}
if constexpr (WeightFirst && !ResidentB && BStages==2)if(!bPrefetched)LoadB(tile,0,initial);
if constexpr (!ResidentA) {
if(!useExpertA && !aPrefetched)LoadA(tile,0,initial);
aPrefetched=false;
}
if constexpr (!ResidentB) {
if constexpr (!WeightFirst && BStages==2)if(!bPrefetched)LoadB(tile,0,initial);
bPrefetched=false;
}
auto accumulator=cq.template AllocTensor<int32_t>();
bool prefetchNextB=false;
if constexpr (ResidentB && InplaceResidentBPrefetch) {
prefetchNextB=p.k<=2*KP && nextTile &&
(nextTile->expert!=tile.expert || nextTile->column!=tile.column);
if constexpr(K32MajorWeights) {
if(nextTile && ((nextTile->columns+31)&~31)!=((tile.columns+31)&~31))
prefetchNextB=false;
}
}
for(int panel=0;panel<p.k;panel+=KP) {
int count=p.k-panel<KP?p.k-panel:KP;
int paddedCount=(count+31)&~31;
__cbuf__ int8_t* localA;
__cbuf__ int8_t* localB;
if constexpr (ResidentA)localA=heldA;
else if(useExpertA) {
int row=tile.row-expertFirst;
bool firstWindow=row>=firstCachedRow &&
row+tile.rows<=firstCachedRow+firstCachedRows;
localA=firstWindow?firstStreamedA+(row-firstCachedRow)*32:
cachedA+row*32;
}
else localA=aq.template DeQue<int8_t>();
if constexpr (ResidentB) {
if constexpr (InplaceResidentBPrefetch) {
if(usingPrefetchedB)capi_wait<PIPE_MTE2,PIPE_MTE1>(6+panel/KP);
}
localB=heldB+panel*(K32MajorWeights?((tile.columns+31)&~31):32);
}
else localB=bq.template DeQue<int8_t>();
if(panel+count<p.k) {
int next=panel+count,nextCount=p.k-next<KP?p.k-next:KP;
if constexpr(K32MajorWeights) {
if(streamedWeights && (next-768)%3072==0) {
const int region=(next-768)/3072;
asc_sync_block_wait(region==0?5:region==1?7:1);
}
}
if constexpr (WeightFirst && !ResidentB && BStages==2)LoadB(tile,next,nextCount);
if constexpr (!ResidentA)if(!useExpertA)LoadA(tile,next,nextCount);
if constexpr (!WeightFirst && !ResidentB && BStages==2)LoadB(tile,next,nextCount);
} else if(nextTile) {
if constexpr (!ResidentA) {
if(!useExpertA || nextTile->expert!=tile.expert) {
LoadA(*nextTile,0,initial);aPrefetched=true;
} else if constexpr(CacheExpertActivation) {
PrefetchCachedTile(*nextTile);
}
}
if constexpr (!ResidentB) {
LoadB(*nextTile,0,initial);bPrefetched=true;
}
}
if constexpr (!ResidentB && BStages>2) {
int nextB=panel+(BStages-1)*KP;
if(nextB<p.k)LoadB(tile,nextB,p.k-nextB<KP?p.k-nextB:KP);
}
int aColumns=(ResidentA || useExpertA)?paddedK:paddedCount;
int bRows=ResidentB?paddedK:paddedCount;
int aOffset=(ResidentA || useExpertA)?panel:0;
int firstK=paddedCount<BK?paddedCount:BK;
auto firstA=a0q.template AllocTensor<int8_t>();
auto firstB=b0q.template AllocTensor<int8_t>();
capi_l1_to_l0a<!ConfigurePerTile>(firstA,localA,tile.rows,firstK,alignedRows,aColumns,aOffset);
LoadWeightFragment(firstB,localB,0,firstK,tile.columns,bRows);
a0q.EnQue(firstA);b0q.EnQue(firstB);
for(int inner=0;inner<paddedCount;inner+=BK) {
int reduction=paddedCount-inner<BK?paddedCount-inner:BK;
auto left=a0q.template DeQue<int8_t>();
auto right=b0q.template DeQue<int8_t>();
if constexpr (ResidentB && InplaceResidentBPrefetch) {
if(prefetchNextB && inner+reduction>=paddedCount) {
int consumed=4+panel/KP;
capi_notify<PIPE_MTE1,PIPE_MTE2>(consumed);
capi_wait<PIPE_MTE1,PIPE_MTE2>(consumed);
LoadBPanel(heldB,*nextTile,panel,count,paddedK);
capi_notify<PIPE_MTE2,PIPE_MTE1>(6+panel/KP);
if(panel+count>=p.k) {
bPrefetched=true;
bPrefetchedExpert=nextTile->expert;
bPrefetchedColumn=nextTile->column;
}
}
}
bool finalReduction=panel+count>=p.k && inner+reduction>=paddedCount;
asc_mmad(accumulator,left,right,alignedRows,
reduction,alignedColumns,unitFlags?(finalReduction?3:2):0,
false,false,panel==0 && inner==0);
a0q.FreeTensor(left);b0q.FreeTensor(right);
int next=inner+BK;
if(next<paddedCount) {
int nextK=paddedCount-next<BK?paddedCount-next:BK;
auto nextA=a0q.template AllocTensor<int8_t>();
auto nextB=b0q.template AllocTensor<int8_t>();
capi_l1_to_l0a<!ConfigurePerTile>(nextA,localA,tile.rows,nextK,alignedRows,
aColumns,aOffset+next);
LoadWeightFragment(nextB,localB,next,nextK,tile.columns,bRows);
a0q.EnQue(nextA);b0q.EnQue(nextB);
}
#if !GMM_OPT_ASYNC_MMA
if constexpr(BM==96 && BN==256 && PrepackedWeights && !ResidentA && !ResidentB) {
if((alignedRows/16)*(alignedColumns/16)<10)asc_sync_pipe(PIPE_M);
} else if(!unitFlags)asc_sync_pipe(PIPE_M);
#endif
}
if constexpr (!ResidentA)if(!useExpertA)aq.FreeTensor(localA);
if constexpr (!ResidentB)bq.FreeTensor(localB);
}
if(!unitFlags){capi_notify<PIPE_M,FixPipeline>(0);capi_wait<PIPE_M,FixPipeline>(0);}
cq.EnQue(accumulator);accumulator=cq.template DeQue<int32_t>();
FixpipeParamsV220 copy;
copy.nSize=paddedCompletion?alignedColumns:tile.columns;
copy.mSize=tile.rows;
copy.srcStride=alignedRows;
if constexpr(CompactScratch) {
copy.dstStride=capi_aligned_scratch_stride(tile.columns);
} else copy.dstStride=BN;
copy.ndNum=1;copy.srcNdStride=0;copy.dstNdStride=0;copy.unitFlag=unitFlags?3:0;
if constexpr (LateWorkspaceWait || GMM_OPT_LATE_WORKSPACE_WAIT)
if(reuseEvent>=0)asc_sync_block_wait(reuseEvent);
if constexpr(QuantizedFix) {
asc_set_l0c_copy_params(1,0,0);
asc_set_l0c2gm_config(0,0,true);
asc_copy_l0c2gm(reinterpret_cast<__gm__ half*>(target),accumulator,
copy.nSize,copy.mSize,copy.dstStride,copy.srcStride,copy.unitFlag,
static_cast<uint8_t>(QuantMode_t::VDEQF16),0,false,true);
} else if constexpr(HalfScratch) {
asc_set_l0c_copy_prequant(uint64_t(0x3b000000));
asc_set_l0c_copy_params(1,0,0);
asc_set_l0c2gm_config(0,0,true);
asc_copy_l0c2gm(reinterpret_cast<__gm__ half*>(target),accumulator,
copy.nSize,copy.mSize,copy.dstStride,copy.srcStride,copy.unitFlag,
static_cast<uint8_t>(QuantMode_t::DEQF16),0,false,true);
} else capi_fixpipe(target,accumulator,copy);
cq.FreeTensor(accumulator);
}
__aicore__ inline void Finish() {
if constexpr(CacheExpertActivation)if(loadedExpert>=0) {
if(cacheRestPending) {
capi_wait<PIPE_MTE2,PIPE_MTE1>(5);cacheRestPending=false;
}
aq.FreeTensor(firstStreamedA);
expertAq.FreeTensor(cachedA);loadedExpert=-1;
}
if constexpr(QuantizedFix)if(quantizedExpert>=0) {
capi_wait<PIPE_FIX,PIPE_MTE2>(7);quantizedExpert=-1;
}
if constexpr (ResidentA)if(aExpert>=0){aq.FreeTensor(heldA);aExpert=-1;}
if constexpr (ResidentB)if(bExpert>=0){bq.FreeTensor(heldB);bExpert=-1;}
}
};
template<int BM,int BN>
__global__ __aicore__ __schedmode__(1) void gmm_capi_single(
GM_ADDR x,GM_ADDR weight,GM_ADDR scale,GM_ADDR groups,
GM_ADDR output,GM_ADDR workspace,GmmPlan p) {
KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
InitSocState();
int core=asc_get_block_idx();
CapiTraversal<BM,BN,0,0> traversal(reinterpret_cast<__gm__ int64_t*>(groups),p,core);
CapiTile tile;
if(!traversal.Next(tile))return;
auto scratch=reinterpret_cast<__gm__ int32_t*>(workspace)+(int64_t)core*BM*BN;
if ASCEND_IS_AIC {
auto a1=reinterpret_cast<__cbuf__ int8_t*>(uint64_t(0));
auto b1=reinterpret_cast<__cbuf__ int8_t*>(uint64_t(BM*512));
auto a0=reinterpret_cast<__ca__ int8_t*>(uint64_t(0));
auto b0=reinterpret_cast<__cb__ int8_t*>(uint64_t(0));
auto c0=reinterpret_cast<__cc__ int32_t*>(uint64_t(0));
int alignedRows=(tile.rows+15)&~15;
capi_nd_to_nz(a1,reinterpret_cast<__gm__ int8_t*>(x)+(int64_t)tile.row*p.k,
tile.rows,p.k,p.k,alignedRows);
capi_nd_to_nz(b1,reinterpret_cast<__gm__ int8_t*>(weight)+
(int64_t)tile.expert*p.k*p.n+tile.column,p.k,tile.columns,p.n,p.k);
capi_notify<PIPE_MTE2,PIPE_MTE1>(0);capi_wait<PIPE_MTE2,PIPE_MTE1>(0);
capi_l1_to_l0a(a0,a1,tile.rows,p.k,alignedRows,p.k);
capi_l1_to_l0b(b0,b1,p.k,tile.columns,p.k);
capi_notify<PIPE_MTE1,PIPE_M>(0);capi_wait<PIPE_MTE1,PIPE_M>(0);
asc_mmad(c0,a0,b0,alignedRows,p.k,(tile.columns+15)&~15,0,false,false,true);
capi_notify<PIPE_M,PIPE_FIX>(0);capi_wait<PIPE_M,PIPE_FIX>(0);
FixpipeParamsV220 copy;
copy.nSize=tile.columns;copy.mSize=tile.rows;copy.srcStride=alignedRows;
copy.dstStride=BN;copy.ndNum=1;copy.srcNdStride=0;copy.dstNdStride=0;copy.unitFlag=0;
capi_fixpipe(scratch,c0,copy);
capi_block_arrive<PIPE_FIX,2>(0);
} else {
int halfRows=capi_vector_half_rows<BM>(tile.rows,
(BM==96 && BN==320)?(tile.rows+1)/2:BM/2);
int slice=asc_get_sub_block_id()*halfRows;
int rows=tile.rows-slice<halfRows?tile.rows-slice:halfRows;
asc_sync_block_wait(0);
if(rows<=0)return;
constexpr int SIZE=BM/2*BN;
auto ci=reinterpret_cast<__ubuf__ int32_t*>(uint64_t(256));
auto z=reinterpret_cast<__ubuf__ float*>(uint64_t(256+SIZE*4));
auto v=reinterpret_cast<__ubuf__ float*>(uint64_t(256+SIZE*8));
auto scales=reinterpret_cast<__ubuf__ float*>(uint64_t(256+SIZE*12));
auto out=reinterpret_cast<__ubuf__ half*>(ci);
DataCopyExtParams sp{1,(uint32_t)tile.columns*4,0,0,0};
capi_read_pad(scales,reinterpret_cast<__gm__ float*>(scale)+
(int64_t)tile.expert*p.n+tile.column,sp,DataCopyPadExtParams<float>{true,0,0,0.0f});
capi_read(ci,scratch+slice*BN,rows*BN);
capi_notify<PIPE_MTE2,PIPE_V>(0);capi_wait<PIPE_MTE2,PIPE_V>(0);
asc_int322float_rn(z,ci,rows*BN);asc_sync_pipe(PIPE_V);
asc_set_mask_norm();asc_set_vector_mask(0,~uint64_t(0));
for(int col=0;col<BN;col+=64)
asc_mul(z+col,z+col,scales+col,rows,1,1,1,BN/8,BN/8,0);
asc_sync_pipe(PIPE_V);
capi_finish_gelu(z,v,out,rows*BN);
capi_notify<PIPE_V,PIPE_MTE3>(0);capi_wait<PIPE_V,PIPE_MTE3>(0);
DataCopyExtParams op{(uint16_t)rows,(uint32_t)tile.columns*2,
(uint32_t)((BN-((tile.columns+15)&~15))/16),(uint32_t)(p.n-tile.columns)*2,0};
capi_write_pad(reinterpret_cast<__gm__ half*>(output)+
(int64_t)(tile.row+slice)*p.n+tile.column,out,op);
capi_notify<PIPE_MTE3,PIPE_S>(0);capi_wait<PIPE_MTE3,PIPE_S>(0);
}
}
__aicore__ inline void capi_pack_weight_halfwords(
__cbuf__ int8_t*,__gm__ int8_t*,int64_t,int,GmmPlan);
__aicore__ inline void capi_pack_weight_words(
__cbuf__ int8_t* local,__gm__ int8_t* weights,int64_t row,int count,GmmPlan p) {
if((p.n&3) && count>=64 && count%32==0 && row+count<int64_t(p.e)*p.k) {
auto source=weights+row*p.n;
const int bulk=count&~63;
for(int phase=0;phase<4;++phase)
asc_copy_gm2l1_nd2nz(reinterpret_cast<__cbuf__ uint32_t*>(local+phase*32),
reinterpret_cast<__gm__ uint32_t*>(source+phase*p.n),
1,bulk/4,(p.n+3)/4,0,p.n,count,4,0);
if(bulk<count) {
for(int phase=0;phase<2;++phase)
asc_copy_gm2l1_nd2nz(
reinterpret_cast<__cbuf__ int16_t*>(local+(bulk+phase)*32),
reinterpret_cast<__gm__ int16_t*>(source+(bulk+phase)*p.n),
1,(count-bulk)/2,(p.n+1)/2,0,p.n,count,2,0);
}
} else capi_pack_weight_halfwords(local,weights,row,count,p);
}
__aicore__ inline void capi_pack_weight_k32_batches(
__cbuf__ int8_t* local,__gm__ int8_t* weights,int64_t row,int count,GmmPlan p) {
const int stride=(p.n+31)&~31,bulk=count&~31;
auto source=weights+row*p.n;
if(bulk>0) {
for(int phase=0;phase<2;++phase)
asc_copy_gm2l1_nd2nz(reinterpret_cast<__cbuf__ int16_t*>(local+phase*32),
reinterpret_cast<__gm__ int16_t*>(source+phase*p.n),
bulk/32,16,(p.n+1)/2,16*p.n,p.n,32,2,16*stride);
}
if(bulk<count)
capi_nd_to_nz(local+bulk*stride,source+int64_t(bulk)*p.n,
count-bulk,p.n,p.n,32);
}
template<int BM,int BN,bool StageMajorWeights=false,bool DeferredReady=false>
__aicore__ inline void capi_cube_pack_partition(
GM_ADDR weight,GM_ADDR groups,GM_ADDR workspace,GmmPlan p) {
int core=asc_get_block_idx();
auto ends=reinterpret_cast<__gm__ int64_t*>(groups);
auto packedWeights=reinterpret_cast<__gm__ int8_t*>(workspace)+
int64_t(p.cores)*2*BM*BN*4;
int stride=(p.n+31)&~31;
int packRows=(192*1024/stride)/32*32;
if(packRows>256)packRows=256;
int slotBytes=packRows*stride;
int paddedK=(p.k+31)&~31;
int unitsPerExpert=paddedK/32;
int units=(BM==80 && BN==384)?p.e*unitsPerExpert*7/16:p.e*unitsPerExpert/2;
int first=units*core/p.cores,stop=units*(core+1)/p.cores;
first=capi_next_active_pack_unit(ends,first,stop,unitsPerExpert);
auto source=reinterpret_cast<__gm__ int8_t*>(weight);
bool pending[2]={false,false};
if(first<stop) {
int expert=first/unitsPerExpert,row=(first%unitsPerExpert)*32;
int countUnits=unitsPerExpert-first%unitsPerExpert;
if(countUnits>stop-first)countUnits=stop-first;
if(countUnits>packRows/32)countUnits=packRows/32;
int count=p.k-row<countUnits*32?p.k-row:countUnits*32;
auto local=reinterpret_cast<__cbuf__ int8_t*>(uint64_t(0));
if constexpr(StageMajorWeights)
capi_pack_weight_k32_batches(local,source,int64_t(expert)*p.k+row,count,p);
else if constexpr(BM==80 && BN==384)
capi_pack_weight_words(local,source,int64_t(expert)*p.k+row,count,p);
else
capi_nd_to_nz(local,source+((int64_t)expert*p.k+row)*p.n,
count,p.n,p.n,(count+31)&~31);
capi_notify<PIPE_MTE2,PIPE_MTE3>(4);
}
int iteration=0;
for(int unit=first;unit<stop;) {
int stage=(iteration++)&1;
int expert=unit/unitsPerExpert,row=(unit%unitsPerExpert)*32;
int countUnits=unitsPerExpert-unit%unitsPerExpert;
if(countUnits>stop-unit)countUnits=stop-unit;
if(countUnits>packRows/32)countUnits=packRows/32;
int paddedCount=countUnits*32;
int count=p.k-row<paddedCount?p.k-row:paddedCount;
int nextUnit=capi_next_active_pack_unit(
ends,unit+countUnits,stop,unitsPerExpert);
if(nextUnit<stop) {
int nextStage=stage^1;
if(pending[nextStage]) {
capi_wait<PIPE_MTE3,PIPE_MTE2>(4+nextStage);
pending[nextStage]=false;
}
int nextExpert=nextUnit/unitsPerExpert,nextRow=(nextUnit%unitsPerExpert)*32;
int nextUnits=unitsPerExpert-nextUnit%unitsPerExpert;
if(nextUnits>stop-nextUnit)nextUnits=stop-nextUnit;
if(nextUnits>packRows/32)nextUnits=packRows/32;
int nextCount=p.k-nextRow<nextUnits*32?p.k-nextRow:nextUnits*32;
auto next=reinterpret_cast<__cbuf__ int8_t*>(uint64_t(nextStage*slotBytes));
if constexpr(StageMajorWeights)
capi_pack_weight_k32_batches(next,source,
int64_t(nextExpert)*p.k+nextRow,nextCount,p);
else if constexpr(BM==80 && BN==384)
capi_pack_weight_words(next,source,
int64_t(nextExpert)*p.k+nextRow,nextCount,p);
else
capi_nd_to_nz(next,source+((int64_t)nextExpert*p.k+nextRow)*p.n,
nextCount,p.n,p.n,(nextCount+31)&~31);
capi_notify<PIPE_MTE2,PIPE_MTE3>(4+nextStage);
}
capi_wait<PIPE_MTE2,PIPE_MTE3>(4+stage);
auto local=reinterpret_cast<__cbuf__ int8_t*>(uint64_t(stage*slotBytes));
if constexpr(StageMajorWeights) {
auto destination=packedWeights+(int64_t(expert)*paddedK+row)*stride;
copy_cbuf_to_gm(reinterpret_cast<__gm__ void*>(destination),
reinterpret_cast<__cbuf__ void*>(local),0,1,paddedCount*stride/32,0,0);
} else {
auto destination=packedWeights+
((int64_t)expert*(stride/32)*paddedK+row)*32;
copy_cbuf_to_gm(reinterpret_cast<__gm__ void*>(destination),
reinterpret_cast<__cbuf__ void*>(local),0,
stride/32,paddedCount,0,paddedK-paddedCount);
}
capi_notify<PIPE_MTE3,PIPE_MTE2>(4+stage);
pending[stage]=true;
unit=nextUnit;
}
for(int stage=0;stage<2;++stage)
if(pending[stage])capi_wait<PIPE_MTE3,PIPE_MTE2>(4+stage);
if constexpr(!(BM==80 && BN==384) && !DeferredReady) {
capi_block_arrive<PIPE_MTE3,0>(6);
asc_sync_block_wait(6);
capi_block_arrive<PIPE_MTE3,2>(4);
asc_sync_block_wait(5);
}
}
__aicore__ inline void capi_pack_weight_halfwords(
__cbuf__ int8_t* local,__gm__ int8_t* weights,int64_t row,int count,GmmPlan p) {
auto source=weights+row*p.n;
if((p.n&1) && count%32==0 && row+count<int64_t(p.e)*p.k) {
asc_copy_gm2l1_nd2nz(reinterpret_cast<__cbuf__ int16_t*>(local),
reinterpret_cast<__gm__ int16_t*>(source),1,count/2,(p.n+1)/2,
0,p.n,count,2,0);
asc_copy_gm2l1_nd2nz(reinterpret_cast<__cbuf__ int16_t*>(local+32),
reinterpret_cast<__gm__ int16_t*>(source+p.n),1,count/2,(p.n+1)/2,
0,p.n,count,2,0);
} else {
capi_nd_to_nz(local,source,count,p.n,p.n,(count+31)&~31);
}
}
template<int BM,int BN>
__aicore__ inline void capi_cube_pack_both(
GM_ADDR x,GM_ADDR weight,GM_ADDR groups,GM_ADDR workspace,GmmPlan p,bool streamed=false) {
int core=asc_get_block_idx();
auto ends=reinterpret_cast<__gm__ int64_t*>(groups);
auto packedWeights=reinterpret_cast<__gm__ int8_t*>(workspace)+
int64_t(p.cores)*2*BM*BN*4;
int stride=(p.n+31)&~31;
int packRows=(192*1024/stride)/32*32;
if(packRows>256)packRows=256;
int slotBytes=packRows*stride;
int paddedK=(p.k+31)&~31;
int unitsPerExpert=streamed?768/32:paddedK/32;
int units=streamed?p.e*unitsPerExpert:(p.e*unitsPerExpert/4)/2*2;
int first=units*core/p.cores,stop=units*(core+1)/p.cores;
first=capi_next_active_pack_unit(ends,first,stop,unitsPerExpert);
auto source=reinterpret_cast<__gm__ int8_t*>(weight);
bool pending[2]={false,false};
if(first<stop) {
int expert=first/unitsPerExpert,row=(first%unitsPerExpert)*32;
int countUnits=unitsPerExpert-first%unitsPerExpert;
if(countUnits>stop-first)countUnits=stop-first;
if(countUnits>packRows/32)countUnits=packRows/32;
int count=p.k-row<countUnits*32?p.k-row:countUnits*32;
auto local=reinterpret_cast<__cbuf__ int8_t*>(uint64_t(0));
capi_pack_weight_halfwords(local,source,
int64_t(expert)*p.k+row,count,p);
capi_notify<PIPE_MTE2,PIPE_MTE3>(4);
}
int iteration=0;
for(int unit=first;unit<stop;) {
int stage=(iteration++)&1;
int expert=unit/unitsPerExpert,row=(unit%unitsPerExpert)*32;
int countUnits=unitsPerExpert-unit%unitsPerExpert;
if(countUnits>stop-unit)countUnits=stop-unit;
if(countUnits>packRows/32)countUnits=packRows/32;
int paddedCount=countUnits*32;
int count=p.k-row<paddedCount?p.k-row:paddedCount;
int nextUnit=capi_next_active_pack_unit(
ends,unit+countUnits,stop,unitsPerExpert);
if(nextUnit<stop) {
int nextStage=stage^1;
if(pending[nextStage]) {
capi_wait<PIPE_MTE3,PIPE_MTE2>(4+nextStage);
pending[nextStage]=false;
}
int nextExpert=nextUnit/unitsPerExpert,nextRow=(nextUnit%unitsPerExpert)*32;
int nextUnits=unitsPerExpert-nextUnit%unitsPerExpert;
if(nextUnits>stop-nextUnit)nextUnits=stop-nextUnit;
if(nextUnits>packRows/32)nextUnits=packRows/32;
int nextCount=p.k-nextRow<nextUnits*32?p.k-nextRow:nextUnits*32;
auto next=reinterpret_cast<__cbuf__ int8_t*>(uint64_t(nextStage*slotBytes));
capi_pack_weight_halfwords(next,source,
int64_t(nextExpert)*p.k+nextRow,nextCount,p);
capi_notify<PIPE_MTE2,PIPE_MTE3>(4+nextStage);
}
capi_wait<PIPE_MTE2,PIPE_MTE3>(4+stage);
auto local=reinterpret_cast<__cbuf__ int8_t*>(uint64_t(stage*slotBytes));
for(int krow=0;krow<paddedCount;krow+=32) {
auto destination=packedWeights+
((int64_t)expert*paddedK+row+krow)*stride;
copy_cbuf_to_gm(reinterpret_cast<__gm__ void*>(destination),
reinterpret_cast<__cbuf__ void*>(local+krow*32),0,
stride/32,32,paddedCount-32,0);
}
capi_notify<PIPE_MTE3,PIPE_MTE2>(4+stage);
pending[stage]=true;
unit=nextUnit;
}
for(int stage=0;stage<2;++stage)
if(pending[stage])capi_wait<PIPE_MTE3,PIPE_MTE2>(4+stage);
int paddedM=(p.m+15)&~15;
int rowBlocks=paddedM/16;
int firstBlock=rowBlocks*core/p.cores;
int stopBlock=rowBlocks*(core+1)/p.cores;
auto packedActivation=packedWeights+int64_t(p.e)*paddedK*stride;
auto activation=reinterpret_cast<__gm__ int8_t*>(x);
for(int block=firstBlock;block<stopBlock;block+=2) {
int packedRows=(stopBlock-block<2?stopBlock-block:2)*16;
int row=block*16;
int count=p.m-row<packedRows?p.m-row:packedRows;
auto local=reinterpret_cast<__cbuf__ int8_t*>(uint64_t(0));
const bool paired=(p.k&1) && paddedK<=8192 && count>=2;
const int localRows=paired?32:packedRows;
auto sourceA=activation+int64_t(row)*p.k;
if(paired) {
const int bulk=p.k&~31;
for(int phase=0;phase<2;++phase)
asc_copy_gm2l1_nd2nz(
reinterpret_cast<__cbuf__ int16_t*>(local+phase*32),
reinterpret_cast<__gm__ int16_t*>(sourceA+phase*p.k),
1,(count+1-phase)/2,bulk/2,0,p.k,localRows,2,0);
capi_nd_to_nz(local+bulk*localRows,sourceA+bulk,
count,p.k-bulk,p.k,localRows);
} else capi_nd_to_nz(local,sourceA,count,p.k,p.k,localRows);
capi_notify<PIPE_MTE2,PIPE_MTE3>(4);
capi_wait<PIPE_MTE2,PIPE_MTE3>(4);
copy_cbuf_to_gm(reinterpret_cast<__gm__ void*>(packedActivation+row*32),
reinterpret_cast<__cbuf__ void*>(local),0,
paddedK/32,packedRows,localRows-packedRows,paddedM-packedRows);
capi_notify<PIPE_MTE3,PIPE_MTE2>(4);
capi_wait<PIPE_MTE3,PIPE_MTE2>(4);
}
capi_block_arrive<PIPE_MTE3,0>(6);
asc_sync_block_wait(6);
capi_block_arrive<PIPE_MTE3,2>(4);
if(!streamed)asc_sync_block_wait(5);
}
constexpr int GmmGatherPackColumns=1088;
constexpr int GmmGatherPackRows=16;
constexpr int GmmGatherPackSlot=GmmGatherPackRows*GmmGatherPackColumns;
constexpr int GmmGatherPackRaw=GmmGatherPackSlot+64;
constexpr int GmmGatherPackPhases=2;
constexpr int GmmGatherPackInput=GmmGatherPackPhases*GmmGatherPackRaw;
template<int PackRows=GmmGatherPackRows>
__aicore__ inline void capi_stage_gather_pack_input(
__ubuf__ uint8_t* raw, __gm__ uint8_t* source, int rows, int columns,
int stage, bool& pending) {
if(pending) {
capi_wait<PIPE_V,PIPE_MTE2>(6+stage);
pending=false;
}
if(PackRows==GmmGatherPackRows && rows<PackRows) {
asc_duplicate(reinterpret_cast<__ubuf__ int32_t*>(raw),int32_t(0),
GmmGatherPackInput/4);
capi_notify<PIPE_V,PIPE_MTE2>(6+stage);
capi_wait<PIPE_V,PIPE_MTE2>(6+stage);
}
if(rows>0) {
for(int phase=0;phase<GmmGatherPackPhases;++phase)
asc_copy_gm2ub_align(raw+phase*GmmGatherPackRaw,source+phase,
1,rows*columns-phase,0,0,0,0);
}
capi_notify<PIPE_MTE2,PIPE_V>(4+stage);
}
template<int BM, int BN, bool StageMajorWeights=false, bool DeferredReady=false>
__aicore__ inline void capi_gather_pack_weights(
GM_ADDR weight, GM_ADDR workspace, GmmPlan p) {
constexpr int PackRows=StageMajorWeights?32:GmmGatherPackRows;
constexpr int OutputAddress=2*GmmGatherPackInput;
constexpr int IndexAddress=OutputAddress+2*GmmGatherPackSlot;
constexpr int BaseAddress=IndexAddress+2*GmmGatherPackSlot;
constexpr int IndexBlock=PackRows*16;
static_assert(BaseAddress+IndexBlock*4<=192*1024,"Gather pack buffers exceed UB");
auto index=reinterpret_cast<__ubuf__ uint32_t*>(uint64_t(IndexAddress));
auto base=reinterpret_cast<__ubuf__ uint32_t*>(uint64_t(BaseAddress));
int paddedN=(p.n+31)&~31,paddedK=(p.k+31)&~31;
int columnBlocks=paddedN/32,elements=paddedN*PackRows/2;
for(int row=0;row<PackRows;++row) {
int phase=(row*p.n)&1;
for(int word=0;word<16;++word)
base[row*16+word]=phase*GmmGatherPackRaw+row*p.n-phase+word*2;
}
capi_notify<PIPE_S,PIPE_V>(0);capi_wait<PIPE_S,PIPE_V>(0);
for(int column=0;column<columnBlocks;++column)
asc_add_scalar(reinterpret_cast<__ubuf__ int32_t*>(index+column*IndexBlock),
reinterpret_cast<__ubuf__ int32_t*>(base),int32_t(column*32),IndexBlock);
asc_sync_pipe(PIPE_V);
int lane=asc_get_block_idx()*2+asc_get_sub_block_id(),lanes=p.cores*2;
int chunks=paddedK/PackRows,jobs=p.e*chunks;
int split=(BM==80 && BN==384)?(jobs*7/16)/2*2:(jobs/2)/2*2;
int remaining=jobs-split;
int first=split+remaining*lane/lanes,stop=split+remaining*(lane+1)/lanes;
auto source=reinterpret_cast<__gm__ uint8_t*>(weight);
auto packed=reinterpret_cast<__gm__ uint8_t*>(workspace)+
int64_t(p.cores)*2*BM*BN*4;
bool inputPending[2]={false,false},outputPending[2]={false,false};
if(first<stop) {
int expert=first/chunks,row=first%chunks*PackRows;
int count=p.k-row<PackRows?p.k-row:PackRows;
if(count<0)count=0;
capi_stage_gather_pack_input<PackRows>(reinterpret_cast<__ubuf__ uint8_t*>(uint64_t(0)),
source+(int64_t(expert)*p.k+row)*p.n,count,p.n,0,inputPending[0]);
}
for(int job=first;job<stop;++job) {
int stage=(job-first)&1;
int expert=job/chunks,row=job%chunks*PackRows;
if(job+1<stop) {
int nextStage=stage^1,nextJob=job+1;
int nextExpert=nextJob/chunks,nextRow=nextJob%chunks*PackRows;
int nextCount=p.k-nextRow<PackRows?p.k-nextRow:PackRows;
if(nextCount<0)nextCount=0;
capi_stage_gather_pack_input<PackRows>(
reinterpret_cast<__ubuf__ uint8_t*>(uint64_t(nextStage*GmmGatherPackInput)),
source+(int64_t(nextExpert)*p.k+nextRow)*p.n,
nextCount,p.n,nextStage,inputPending[nextStage]);
}
if(outputPending[stage]) {
capi_wait<PIPE_MTE3,PIPE_V>(4+stage);
outputPending[stage]=false;
}
capi_wait<PIPE_MTE2,PIPE_V>(4+stage);
auto raw=reinterpret_cast<__ubuf__ uint16_t*>(uint64_t(stage*GmmGatherPackInput));
auto output=reinterpret_cast<__ubuf__ uint16_t*>(uint64_t(OutputAddress+stage*GmmGatherPackSlot));
if constexpr(StageMajorWeights) {
const int validRows=p.k-row<PackRows?p.k-row:PackRows;
if(validRows==PackRows)asc_gather(output,raw,index,elements);
else {
asc_duplicate(reinterpret_cast<__ubuf__ int32_t*>(output),int32_t(0),
paddedN*PackRows/4);
asc_sync_pipe(PIPE_V);
for(int column=0;column<columnBlocks;++column)
asc_gather(output+column*IndexBlock,raw,index+column*IndexBlock,validRows*16);
}
} else asc_gather(output,raw,index,elements);
capi_notify<PIPE_V,PIPE_MTE2>(6+stage);inputPending[stage]=true;
capi_notify<PIPE_V,PIPE_MTE3>(4+stage);capi_wait<PIPE_V,PIPE_MTE3>(4+stage);
if constexpr(StageMajorWeights) {
auto destination=packed+(int64_t(expert)*paddedK+row)*paddedN;
asc_copy_ub2gm_align(destination,reinterpret_cast<__ubuf__ uint8_t*>(output),
1,PackRows*paddedN,0,0,0,0);
} else {
auto destination=packed+(int64_t(expert)*columnBlocks*paddedK+row)*32;
asc_copy_ub2gm_align(destination,reinterpret_cast<__ubuf__ uint8_t*>(output),
columnBlocks,PackRows*32,0,0,0,(paddedK-PackRows)*32);
}
capi_notify<PIPE_MTE3,PIPE_V>(4+stage);outputPending[stage]=true;
}
for(int stage=0;stage<2;++stage) {
if(outputPending[stage])capi_wait<PIPE_MTE3,PIPE_V>(4+stage);
if(inputPending[stage])capi_wait<PIPE_V,PIPE_MTE2>(6+stage);
}
capi_block_arrive<PIPE_MTE3,0>(6);
asc_sync_block_wait(6);
capi_block_arrive<PIPE_MTE3,2>(5);
if constexpr(!(BM==80 && BN==384) && !DeferredReady)asc_sync_block_wait(4);
}
constexpr int GmmLongGatherPackColumns=640;
constexpr int GmmLongGatherPackRows=32;
constexpr int GmmLongGatherPackSlot=GmmLongGatherPackRows*GmmLongGatherPackColumns;
constexpr int GmmLongGatherPackRaw=GmmLongGatherPackSlot+64;
constexpr int GmmLongGatherPackPhases=2;
constexpr int GmmLongGatherPackInput=GmmLongGatherPackPhases*GmmLongGatherPackRaw;
__aicore__ inline void capi_stage_long_gather_pack_input(
__ubuf__ uint8_t* raw, __gm__ uint8_t* source, int rows, int columns,
int stage, bool& pending) {
if(pending) {
capi_wait<PIPE_V,PIPE_MTE2>(6+stage);
pending=false;
}
if(rows<GmmLongGatherPackRows) {
asc_duplicate(reinterpret_cast<__ubuf__ int32_t*>(raw),int32_t(0),
GmmLongGatherPackInput/4);
capi_notify<PIPE_V,PIPE_MTE2>(6+stage);
capi_wait<PIPE_V,PIPE_MTE2>(6+stage);
}
if(rows>0) {
for(int phase=0;phase<GmmLongGatherPackPhases;++phase)
asc_copy_gm2ub_align(raw+phase*GmmLongGatherPackRaw,source+phase,
1,rows*columns-phase,0,0,0,0);
}
capi_notify<PIPE_MTE2,PIPE_V>(4+stage);
}
template<int BM, int BN>
__aicore__ inline void capi_long_gather_pack_weights(
GM_ADDR weight, GM_ADDR workspace, GmmPlan p,bool streamed=false) {
constexpr int OutputAddress=2*GmmLongGatherPackInput;
constexpr int IndexAddress=OutputAddress+2*GmmLongGatherPackSlot;
constexpr int BaseAddress=IndexAddress+2*GmmLongGatherPackSlot;
constexpr int IndexBlock=GmmLongGatherPackRows*16;
static_assert(BaseAddress+IndexBlock*4<=192*1024,"Gather pack buffers exceed UB");
auto index=reinterpret_cast<__ubuf__ uint32_t*>(uint64_t(IndexAddress));
auto base=reinterpret_cast<__ubuf__ uint32_t*>(uint64_t(BaseAddress));
int paddedN=(p.n+31)&~31,paddedK=(p.k+31)&~31;
int columnBlocks=paddedN/32,elements=paddedN*GmmLongGatherPackRows/2;
for(int row=0;row<GmmLongGatherPackRows;++row) {
int phase=(row*p.n)&1;
for(int word=0;word<16;++word)
base[row*16+word]=phase*GmmLongGatherPackRaw+row*p.n-phase+word*2;
}
capi_notify<PIPE_S,PIPE_V>(0);capi_wait<PIPE_S,PIPE_V>(0);
for(int column=0;column<columnBlocks;++column)
asc_add_scalar(reinterpret_cast<__ubuf__ int32_t*>(index+column*IndexBlock),
reinterpret_cast<__ubuf__ int32_t*>(base),int32_t(column*32),IndexBlock);
asc_sync_pipe(PIPE_V);
int lane=asc_get_block_idx()*2+asc_get_sub_block_id(),lanes=p.cores*2;
for(int stageStart=streamed?768:0;stageStart<p.k;stageStart+=streamed?3072:p.k) {
int stageRows=streamed?(paddedK-stageStart<3072?paddedK-stageStart:3072):paddedK;
int chunks=stageRows/GmmLongGatherPackRows,jobs=p.e*chunks;
int split=streamed?0:(jobs/4)/2*2;
int remaining=jobs-split;
int first=split+remaining*lane/lanes,stop=split+remaining*(lane+1)/lanes;
auto source=reinterpret_cast<__gm__ uint8_t*>(weight);
auto packed=reinterpret_cast<__gm__ uint8_t*>(workspace)+
int64_t(p.cores)*2*BM*BN*4;
bool inputPending[2]={false,false},outputPending[2]={false,false};
if(first<stop) {
int expert=first/chunks,row=stageStart+first%chunks*GmmLongGatherPackRows;
int count=p.k-row<GmmLongGatherPackRows?p.k-row:GmmLongGatherPackRows;
if(count<0)count=0;
capi_stage_long_gather_pack_input(reinterpret_cast<__ubuf__ uint8_t*>(uint64_t(0)),
source+(int64_t(expert)*p.k+row)*p.n,count,p.n,0,inputPending[0]);
}
for(int job=first;job<stop;++job) {
int stage=(job-first)&1;
int expert=job/chunks,row=stageStart+job%chunks*GmmLongGatherPackRows;
if(job+1<stop) {
int nextStage=stage^1,nextJob=job+1;
int nextExpert=nextJob/chunks,nextRow=stageStart+nextJob%chunks*GmmLongGatherPackRows;
int nextCount=p.k-nextRow<GmmLongGatherPackRows?p.k-nextRow:GmmLongGatherPackRows;
if(nextCount<0)nextCount=0;
capi_stage_long_gather_pack_input(
reinterpret_cast<__ubuf__ uint8_t*>(uint64_t(nextStage*GmmLongGatherPackInput)),
source+(int64_t(nextExpert)*p.k+nextRow)*p.n,
nextCount,p.n,nextStage,inputPending[nextStage]);
}
if(outputPending[stage]) {
capi_wait<PIPE_MTE3,PIPE_V>(4+stage);
outputPending[stage]=false;
}
capi_wait<PIPE_MTE2,PIPE_V>(4+stage);
auto raw=reinterpret_cast<__ubuf__ uint16_t*>(uint64_t(stage*GmmLongGatherPackInput));
auto output=reinterpret_cast<__ubuf__ uint16_t*>(uint64_t(OutputAddress+stage*GmmLongGatherPackSlot));
asc_gather(output,raw,index,elements);
capi_notify<PIPE_V,PIPE_MTE2>(6+stage);inputPending[stage]=true;
capi_notify<PIPE_V,PIPE_MTE3>(4+stage);capi_wait<PIPE_V,PIPE_MTE3>(4+stage);
auto destination=packed+(int64_t(expert)*paddedK+row)*paddedN;
asc_copy_ub2gm_align(destination,reinterpret_cast<__ubuf__ uint8_t*>(output),
1,GmmLongGatherPackRows*paddedN,0,0,0,0);
capi_notify<PIPE_MTE3,PIPE_V>(4+stage);outputPending[stage]=true;
}
for(int stage=0;stage<2;++stage) {
if(outputPending[stage])capi_wait<PIPE_MTE3,PIPE_V>(4+stage);
if(inputPending[stage])capi_wait<PIPE_V,PIPE_MTE2>(6+stage);
}
capi_block_arrive<PIPE_MTE3,0>(6);
asc_sync_block_wait(6);
if(streamed) {
const int region=(stageStart-768)/3072;
capi_block_arrive<PIPE_MTE3,2>(region==0?5:region==1?7:1);
} else {
capi_block_arrive<PIPE_MTE3,2>(5);
asc_sync_block_wait(4);
}
}
if(streamed)asc_sync_block_wait(4);
}
constexpr int ShortStageRows=32,ShortStageColumns=800;
constexpr int ShortStageSlot=ShortStageRows*ShortStageColumns;
constexpr int ShortStageRaw=ShortStageSlot+64,ShortStageInput=2*ShortStageRaw;
__aicore__ inline void stage_short_major_input(__ubuf__ uint8_t* raw,
__gm__ uint8_t* source,int rows,int columns,int stage,bool& pending) {
if(pending) {capi_wait<PIPE_V,PIPE_MTE2>(6+stage);pending=false;}
if(rows>0)for(int phase=0;phase<2;++phase)
asc_copy_gm2ub_align(raw+phase*ShortStageRaw,source+phase,
1,rows*columns-phase,0,0,0,0);
capi_notify<PIPE_MTE2,PIPE_V>(4+stage);
}
template<int BM,int BN>
__aicore__ inline void capi_short_major_weights(GM_ADDR weight,GM_ADDR workspace,GmmPlan p) {
constexpr int OutputAddress=2*ShortStageInput;
constexpr int IndexAddress=OutputAddress+ShortStageSlot;
constexpr int BaseAddress=IndexAddress+2*ShortStageSlot;
constexpr int IndexBlock=ShortStageRows*16;
static_assert(BaseAddress+IndexBlock*4<=192*1024,"Short-row stage buffers exceed UB");
auto index=reinterpret_cast<__ubuf__ uint32_t*>(uint64_t(IndexAddress));
auto base=reinterpret_cast<__ubuf__ uint32_t*>(uint64_t(BaseAddress));
int paddedN=(p.n+31)&~31,paddedK=(p.k+31)&~31;
int columnBlocks=paddedN/32,elements=paddedN*ShortStageRows/2;
for(int row=0;row<ShortStageRows;++row) {
int phase=(row*p.n)&1;
for(int word=0;word<16;++word)
base[row*16+word]=phase*ShortStageRaw+row*p.n-phase+word*2;
}
capi_notify<PIPE_S,PIPE_V>(0);capi_wait<PIPE_S,PIPE_V>(0);
for(int column=0;column<columnBlocks;++column)
asc_add_scalar(reinterpret_cast<__ubuf__ int32_t*>(index+column*IndexBlock),
reinterpret_cast<__ubuf__ int32_t*>(base),int32_t(column*32),IndexBlock);
asc_sync_pipe(PIPE_V);
int lane=asc_get_block_idx()*2+asc_get_sub_block_id(),lanes=p.cores*2;
int chunks=paddedK/ShortStageRows,jobs=p.e*chunks,split=jobs*7/16;
int remaining=jobs-split,first=split+remaining*lane/lanes,stop=split+remaining*(lane+1)/lanes;
auto source=reinterpret_cast<__gm__ uint8_t*>(weight);
auto packed=reinterpret_cast<__gm__ uint8_t*>(workspace)+int64_t(p.cores)*2*BM*BN*4;
bool inputPending[2]={false,false},outputPending=false;
if(first<stop) {
int expert=first/chunks,row=first%chunks*ShortStageRows;
int count=p.k-row<ShortStageRows?p.k-row:ShortStageRows;if(count<0)count=0;
stage_short_major_input(reinterpret_cast<__ubuf__ uint8_t*>(uint64_t(0)),
source+(int64_t(expert)*p.k+row)*p.n,count,p.n,0,inputPending[0]);
}
for(int job=first;job<stop;++job) {
int stage=(job-first)&1,expert=job/chunks,row=job%chunks*ShortStageRows;
if(job+1<stop) {
int nextStage=stage^1,nextJob=job+1,nextExpert=nextJob/chunks,nextRow=nextJob%chunks*ShortStageRows;
int count=p.k-nextRow<ShortStageRows?p.k-nextRow:ShortStageRows;if(count<0)count=0;
stage_short_major_input(reinterpret_cast<__ubuf__ uint8_t*>(uint64_t(nextStage*ShortStageInput)),
source+(int64_t(nextExpert)*p.k+nextRow)*p.n,count,p.n,nextStage,inputPending[nextStage]);
}
if(outputPending) {capi_wait<PIPE_MTE3,PIPE_V>(4);outputPending=false;}
capi_wait<PIPE_MTE2,PIPE_V>(4+stage);
auto raw=reinterpret_cast<__ubuf__ uint16_t*>(uint64_t(stage*ShortStageInput));
auto output=reinterpret_cast<__ubuf__ uint16_t*>(uint64_t(OutputAddress));
int validRows=p.k-row<ShortStageRows?p.k-row:ShortStageRows;
if(validRows==ShortStageRows)asc_gather(output,raw,index,elements);
else {
asc_duplicate(reinterpret_cast<__ubuf__ uint32_t*>(output),uint32_t(0),ShortStageSlot/4);
asc_sync_pipe(PIPE_V);
for(int column=0;column<columnBlocks;++column)
asc_gather(output+column*IndexBlock,raw,index+column*IndexBlock,validRows*16);
}
capi_notify<PIPE_V,PIPE_MTE2>(6+stage);inputPending[stage]=true;
capi_notify<PIPE_V,PIPE_MTE3>(4);capi_wait<PIPE_V,PIPE_MTE3>(4);
asc_copy_ub2gm_align(packed+(int64_t(expert)*paddedK+row)*paddedN,
reinterpret_cast<__ubuf__ uint8_t*>(output),1,ShortStageRows*paddedN,0,0,0,0);
capi_notify<PIPE_MTE3,PIPE_V>(4);outputPending=true;
}
if(outputPending)capi_wait<PIPE_MTE3,PIPE_V>(4);
for(int stage=0;stage<2;++stage)if(inputPending[stage])capi_wait<PIPE_V,PIPE_MTE2>(6+stage);
capi_block_arrive<PIPE_MTE3,0>(6);asc_sync_block_wait(6);capi_block_arrive<PIPE_MTE3,2>(5);
}
template<int BM,int BN,int Mode=0,int PAD=192,int VROWS=0,
bool PackTail=false,int Rotate=0,bool SingleTile=false,bool PrefetchRows=false,
bool ReuseAccumulator=false,int PanelK=0,bool FineTail=false,bool FusedAffine=false,
bool InplaceResidentBPrefetch=false, bool VectorPackWeights=false,int BStages=2, bool PrimeBeforePackWait=false, bool GatherPackWeights=false, bool StageMajorWeights=false>
__global__ __aicore__ __schedmode__(1) void gmm_capi_panels(
GM_ADDR x,GM_ADDR weight,GM_ADDR scale,GM_ADDR groups,
GM_ADDR output,GM_ADDR workspace,GmmPlan p) {
KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
InitSocState();
constexpr bool HalfScratch=(Mode==5 && BM==80 && BN==384 && BStages==4) ||
(Mode==3 && BM==80 && BN==384 && VectorPackWeights && InplaceResidentBPrefetch) ||
(Mode==3 && BM==96 && BN==320 && VectorPackWeights);
constexpr bool ReuseForFloat=ReuseAccumulator && !HalfScratch;
constexpr int BK=(Mode==8 && BN>256)?96:(BN>256?64:128);
constexpr int KP=PanelK>0?PanelK:(BN>256?256:512);
constexpr int UB_BYTES=192*1024-(FusedAffine?GELU_AFFINE_BYTES:0);
constexpr int REUSED_ROWS=(UB_BYTES-256-3*PAD-BN*4)/(12*BN);
constexpr int ROW_CAPACITY=ReuseForFloat?REUSED_ROWS:8192/BN;
constexpr int MAX_ROWS=BM/2<ROW_CAPACITY?BM/2:ROW_CAPACITY;
constexpr int CHUNK=VROWS>0 && VROWS<MAX_ROWS?VROWS:MAX_ROWS;
constexpr int SIZE=CHUNK*BN;
static_assert(!ReuseForFloat || SIZE*12+256+3*PAD+BN*4<=UB_BYTES,
"Accumulator and vector scratch exceed UB capacity");
static_assert(!FusedAffine || SIZE*(ReuseForFloat?12:16)+256+
(ReuseForFloat?3:4)*PAD+BN*4<=UB_BYTES,
"GELU constants overlap vector scratch");
int core=asc_get_block_idx();
auto ends=reinterpret_cast<__gm__ int64_t*>(groups);
auto scratch=reinterpret_cast<__gm__ int32_t*>(workspace)+
(int64_t)core*(SingleTile?1:2)*BM*BN;
auto packedWeights=reinterpret_cast<__gm__ int8_t*>(workspace)+
(int64_t)p.cores*2*BM*BN*4;
