int nextUnits=unitsPerExpert-nextUnit%unitsPerExpert;
if(nextUnits>stop-nextUnit)nextUnits=stop-nextUnit;
if(nextUnits>packRows/32)nextUnits=packRows/32;
int nextCount=p.k-nextRow<nextUnits*32?p.k-nextRow:nextUnits*32;
