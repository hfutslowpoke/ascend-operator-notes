if constexpr(GatherPackWeights && Mode==6 && BM==96 && BN==256 && PanelK==768) {
int tasks=0,previous=0;
for(int expert=0;expert<p.e;++expert) {
int end=ends[expert];
tasks+=((end-previous+BM-1)/BM)*((p.n+BN-1)/BN);
previous=end;
}
streamedWeights=tasks<=p.cores && p.k>768 && p.k<=768+3*3072;
}
