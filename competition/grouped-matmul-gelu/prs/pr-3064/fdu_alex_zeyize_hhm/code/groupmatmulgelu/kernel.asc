paddedK-paddedCount,0);
}
} else {
auto source=b+(int64_t)tile.expert*p.k*p.n+
(int64_t)panel*p.n+tile.column;
if constexpr(ResidentA && !ResidentB && PrefetchRows && BM==80 && BN==384) {
if((p.n&1) && count%32==0 && (tile.columns%2==0 || panel+count<p.k)) {
asc_copy_gm2l1_nd2nz(reinterpret_cast<__cbuf__ int16_t*>(local),
reinterpret_cast<__gm__ int16_t*>(source),1,count/2,(tile.columns+1)/2,
0,p.n,count,2,0);
asc_copy_gm2l1_nd2nz(reinterpret_cast<__cbuf__ int16_t*>(local+32),
reinterpret_cast<__gm__ int16_t*>(source+p.n),1,count/2,(tile.columns+1)/2,
0,p.n,count,2,0);
} else capi_nd_to_nz(local,source,count,tile.columns,p.n,(count+31)&~31);
} else capi_nd_to_nz(local,source,count,tile.columns,p.n,(count+31)&~31);
}
