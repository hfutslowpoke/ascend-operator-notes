const int alignedRows=(tile.rows+15)&~15;
if((p.k&1) && tile.rows%2==0 && count>=32) {
const int bulk=count&~31;
asc_copy_gm2l1_nd2nz(reinterpret_cast<__cbuf__ int16_t*>(local),
reinterpret_cast<__gm__ int16_t*>(source),1,tile.rows/2,bulk/2,
0,p.k,alignedRows,2,0);
asc_copy_gm2l1_nd2nz(reinterpret_cast<__cbuf__ int16_t*>(local+32),
reinterpret_cast<__gm__ int16_t*>(source+p.k),1,tile.rows/2,bulk/2,
0,p.k,alignedRows,2,0);
if(bulk<count)
capi_nd_to_nz(local+bulk*alignedRows,source+bulk,
tile.rows,count-bulk,p.k,alignedRows);
} else {
capi_nd_to_nz(local,source,tile.rows,count,p.k,alignedRows);
}
} else {
capi_nd_to_nz(local,a+(int64_t)tile.row*p.k+panel,
tile.rows,count,p.k,(tile.rows+15)&~15);
}
aq.EnQue(local);
