0,tile.columns,tile.rows,CcePitch(tile.columns),alignedRows,0,
QuantMode_t::VDEQF16,0,false,true);
set_flag(PIPE_FIX,PIPE_M,EVENT_ID0);
}
__aicore__ inline void Finish() {
if(expert>=0) {
if(cachePending)wait_flag(PIPE_MTE2,PIPE_MTE1,EVENT_ID5);
set_flag(PIPE_MTE1,PIPE_MTE2,static_cast<event_t>(firstSlot));
set_flag(PIPE_MTE1,PIPE_MTE2,EVENT_ID7);
}
wait_flag(PIPE_MTE1,PIPE_MTE2,EVENT_ID7);
if(coefficientExpert>=0)wait_flag(PIPE_FIX,PIPE_MTE2,EVENT_ID7);
wait_flag(PIPE_MTE1,PIPE_MTE2,EVENT_ID0);
wait_flag(PIPE_MTE1,PIPE_MTE2,EVENT_ID1);
wait_flag(PIPE_MTE1,PIPE_MTE2,EVENT_ID2);
wait_flag(PIPE_M,PIPE_MTE1,EVENT_ID0);
wait_flag(PIPE_M,PIPE_MTE1,EVENT_ID1);
wait_flag(PIPE_FIX,PIPE_M,EVENT_ID0);
}
};
template<int BM,int BN,int KP>
struct CcePackedStreamingEngine {
__gm__ int8_t* input;
__gm__ int8_t* weights;
GmmPlan plan;
int aWrite=0,aRead=0,bWrite=0,bRead=0,operand=0,weightWidth=0;
bool aPrefetched=false,bPrefetched=false,streamedWeights=false;
__aicore__ inline __cbuf__ int8_t* Activation(int slot) {
return reinterpret_cast<__cbuf__ int8_t*>(uint64_t(slot*BM*KP));
}
__aicore__ inline __cbuf__ int8_t* Weight(int slot) {
return reinterpret_cast<__cbuf__ int8_t*>(uint64_t(2*BM*KP+slot*weightWidth*KP));
}
__aicore__ inline void Init(CceStorage& memory,GmmPlan p,
__gm__ int8_t* a,__gm__ int8_t* b) {
plan=p;input=a;weights=b;
int tiles=(p.n+BN-1)/BN,blocks=(p.n+31)/32;
weightWidth=((blocks+tiles-1)/tiles)*32;
memory.l1=2*BM*KP+2*weightWidth*KP;
for(int i=0;i<4;++i)set_flag(PIPE_MTE1,PIPE_MTE2,static_cast<event_t>(i));
for(int i=0;i<2;++i)set_flag(PIPE_M,PIPE_MTE1,static_cast<event_t>(i));
set_flag(PIPE_FIX,PIPE_M,EVENT_ID0);
}
__aicore__ inline void LoadA(CceTile tile,int panel,int count) {
int slot=aWrite;aWrite^=1;
wait_flag(PIPE_MTE1,PIPE_MTE2,static_cast<event_t>(slot));
int paddedM=(plan.m+15)&~15,rows=(tile.rows+15)&~15;
copy_gm_to_cbuf(Activation(slot),input+(int64_t(panel/32)*paddedM+tile.row)*32,
0,(count+31)/32,rows,paddedM-rows,0,static_cast<pad_t>(0));
set_flag(PIPE_MTE2,PIPE_MTE1,static_cast<event_t>(slot));
}
__aicore__ inline void LoadB(CceTile tile,int panel,int count) {
int slot=bWrite;bWrite^=1;
wait_flag(PIPE_MTE1,PIPE_MTE2,static_cast<event_t>(2+slot));
int paddedK=(plan.k+31)&~31,paddedN=(plan.n+31)&~31,columns=(tile.columns+31)&~31;
copy_gm_to_cbuf(Weight(slot),weights+(int64_t(tile.expert)*paddedK+panel)*paddedN+tile.column*32,
0,(count+31)/32,columns,paddedN-columns,0,static_cast<pad_t>(0));
set_flag(PIPE_MTE2,PIPE_MTE1,static_cast<event_t>(2+slot));
}
__aicore__ inline void Operands(__cbuf__ int8_t* a,__cbuf__ int8_t* b,
int inner,int count,int panelStride,int rows,int columns) {
int slot=operand;
wait_flag(PIPE_M,PIPE_MTE1,static_cast<event_t>(slot));
asc_copy_l12l0a(reinterpret_cast<__ca__ int8_t*>(uint64_t(slot*BM*128)),
a,count,rows,inner,0,1,1,1,1,1,1,false,false,false,false,panelStride);
load_cbuf_to_cb_transpose(reinterpret_cast<__cb__ int8_t*>(uint64_t(slot*BN*128)),
b+inner*columns,0,(count/32)*(columns/32),1,1,false,0);
set_flag(PIPE_MTE1,PIPE_M,static_cast<event_t>(slot));
}
__aicore__ inline void Multiply(CceTile tile,__gm__ int32_t* target,
const CceTile* nextTile,int reuseEvent=-1) {
if(reuseEvent>=0)wait_flag_dev(reuseEvent);
int rows=(tile.rows+15)&~15,columns=(tile.columns+31)&~31;
set_fmatrix((uint64_t(1)<<16)|rows);
int first=plan.k<KP?plan.k:KP;
if(!bPrefetched)LoadB(tile,0,first);
if(!aPrefetched)LoadA(tile,0,first);
aPrefetched=false;bPrefetched=false;
wait_flag(PIPE_FIX,PIPE_M,EVENT_ID0);
auto accumulator=reinterpret_cast<__cc__ int32_t*>(uint64_t(0));
for(int panel=0;panel<plan.k;panel+=KP) {
int count=plan.k-panel<KP?plan.k-panel:KP;
int padded=(count+31)&~31;
int aSlot=aRead,bSlot=bRead;aRead^=1;bRead^=1;
wait_flag(PIPE_MTE2,PIPE_MTE1,static_cast<event_t>(aSlot));
wait_flag(PIPE_MTE2,PIPE_MTE1,static_cast<event_t>(2+bSlot));
int deferredPanel=-1,deferredCount=0;
if(panel+count<plan.k) {
int next=panel+count,nextCount=plan.k-next<KP?plan.k-next:KP;
if(streamedWeights && (next-768)%3072==0) {
LoadA(tile,next,nextCount);
deferredPanel=next;deferredCount=nextCount;
} else {
LoadB(tile,next,nextCount);LoadA(tile,next,nextCount);
}
} else if(nextTile) {
LoadA(*nextTile,0,first);LoadB(*nextTile,0,first);
aPrefetched=true;bPrefetched=true;
}
auto a=Activation(aSlot),b=Weight(bSlot);
Operands(a,b,0,padded<128?padded:128,padded,rows,columns);
for(int inner=0;inner<padded;inner+=128) {
int reduction=padded-inner<128?padded-inner:128;
int slot=operand;operand^=1;
wait_flag(PIPE_MTE1,PIPE_M,static_cast<event_t>(slot));
mad(accumulator,reinterpret_cast<__ca__ int8_t*>(uint64_t(slot*BM*128)),
reinterpret_cast<__cb__ int8_t*>(uint64_t(slot*BN*128)),
rows,reduction,columns,0,false,false,panel==0 && inner==0);
set_flag(PIPE_M,PIPE_MTE1,static_cast<event_t>(slot));
int next=inner+128;
if(next<padded)Operands(a,b,next,padded-next<128?padded-next:128,padded,rows,columns);
if((rows/16)*(columns/16)<10)pipe_barrier(PIPE_M);
}
set_flag(PIPE_MTE1,PIPE_MTE2,static_cast<event_t>(aSlot));
set_flag(PIPE_MTE1,PIPE_MTE2,static_cast<event_t>(2+bSlot));
if(deferredPanel>=0) {
int region=(deferredPanel-768)/3072;
wait_flag_dev(region==0?5:region==1?7:1);
LoadB(tile,deferredPanel,deferredCount);
}
}
set_flag(PIPE_M,PIPE_FIX,EVENT_ID0);wait_flag(PIPE_M,PIPE_FIX,EVENT_ID0);
asc_set_l0c_copy_params(1,0,0);asc_set_l0c2gm_config(0,0,true);
copy_matrix_cc_to_gm(target,accumulator,0,tile.columns,tile.rows,BN,rows,0,
static_cast<QuantMode_t>(0),0,false,true);
set_flag(PIPE_FIX,PIPE_M,EVENT_ID0);
}
__aicore__ inline void Finish() {
for(int i=0;i<4;++i)wait_flag(PIPE_MTE1,PIPE_MTE2,static_cast<event_t>(i));
for(int i=0;i<2;++i)wait_flag(PIPE_M,PIPE_MTE1,static_cast<event_t>(i));
wait_flag(PIPE_FIX,PIPE_M,EVENT_ID0);
}
};
template<int BM,int BN,int KP,bool ResidentB=false,bool FullA=false,bool PackedB=false,bool PackedA=false>
struct CceDirectStreamingEngine {
__gm__ int8_t* input;
__gm__ int8_t* weights;
GmmPlan plan;
int aWrite=0,aRead=0,bWrite=0,bRead=0,operand=0,weightWidth=0;
int weightExpert=-1,weightColumn=-1;
bool aPrefetched=false,bPrefetched=false;
__aicore__ inline __cbuf__ int8_t* Activation(int slot) {
return reinterpret_cast<__cbuf__ int8_t*>(uint64_t(FullA?0:slot*BM*KP));
}
__aicore__ inline __cbuf__ int8_t* Weight(int slot) {
return reinterpret_cast<__cbuf__ int8_t*>(uint64_t((FullA?BM*((plan.k+31)&~31):2*BM*KP)+slot*weightWidth*KP));
}
__aicore__ inline void Init(CceStorage& memory,GmmPlan p,
__gm__ int8_t* a,__gm__ int8_t* b) {
plan=p;input=a;weights=b;
weightWidth=ResidentB && p.n<=BN?((p.n+31)&~31):BN;
memory.l1=(FullA?BM*((p.k+31)&~31):2*BM*KP)+weightWidth*(ResidentB?((p.k+31)&~31):2*KP);
for(int i=0;i<(ResidentB?3:4);++i)set_flag(PIPE_MTE1,PIPE_MTE2,static_cast<event_t>(i));
for(int i=0;i<2;++i)set_flag(PIPE_M,PIPE_MTE1,static_cast<event_t>(i));
set_flag(PIPE_FIX,PIPE_M,EVENT_ID0);
}
__aicore__ inline void LoadA(CceTile tile,int panel,int count) {
int slot=FullA?0:aWrite;if constexpr(!FullA)aWrite^=1;
wait_flag(PIPE_MTE1,PIPE_MTE2,static_cast<event_t>(slot));
if constexpr(PackedA) {
int paddedM=(plan.m+15)&~15,rows=(tile.rows+15)&~15;
copy_gm_to_cbuf(Activation(slot),input+(int64_t(panel/32)*paddedM+tile.row)*32,
0,(count+31)/32,rows,paddedM-rows,0,static_cast<pad_t>(0));
} else {
copy_gm_to_cbuf_multi_nd2nz_b8(Activation(slot),input+int64_t(tile.row)*plan.k+panel,
0,1,tile.rows,count,0,plan.k,(tile.rows+15)&~15,1,0);
}
set_flag(PIPE_MTE2,PIPE_MTE1,static_cast<event_t>(slot));
}
__aicore__ inline void CopyB(__cbuf__ int8_t* destination,CceTile tile,int panel,int count) {
int columns=(tile.columns+31)&~31,bulk=count&~31;
if constexpr(PackedB) {
int paddedK=(plan.k+31)&~31,paddedN=(plan.n+31)&~31;
if constexpr(FullA || BN==32) {
copy_gm_to_cbuf(destination,weights+(int64_t(tile.expert)*paddedK+panel)*paddedN,
0,1,((count+31)&~31)*columns/32,0,0,static_cast<pad_t>(0));
} else {
copy_gm_to_cbuf(destination,weights+(int64_t(tile.expert)*paddedK+panel)*paddedN+tile.column*32,
0,(count+31)/32,columns,paddedN-columns,0,static_cast<pad_t>(0));
}
return;
}
auto source=weights+(int64_t(tile.expert)*plan.k+panel)*plan.n+tile.column;
if(bulk && plan.n<2048) {
copy_gm_to_cbuf_multi_nd2nz_b8(destination,source,0,bulk/32,32,tile.columns,
32*plan.n,plan.n,32,1,32*columns);
} else if(bulk && (plan.n&3)==0) {
for(int phase=0;phase<4;++phase)
asc_copy_gm2l1_nd2nz(reinterpret_cast<__cbuf__ uint32_t*>(destination+phase*32),
reinterpret_cast<__gm__ uint32_t*>(source+phase*plan.n),
bulk/32,8,tile.columns/4,8*plan.n,plan.n,32,4,8*columns);
} else {
for(int row=0;row<bulk;row+=32)
copy_gm_to_cbuf_multi_nd2nz_b8(destination+row*columns,source+int64_t(row)*plan.n,
0,1,32,tile.columns,0,plan.n,32,1,0);
}
if(bulk<count)copy_gm_to_cbuf_multi_nd2nz_b8(destination+bulk*columns,source+bulk*plan.n,
0,1,count-bulk,tile.columns,0,plan.n,32,1,0);
}
__aicore__ inline void LoadB(CceTile tile,int panel,int count) {
int slot=bWrite;bWrite^=1;
wait_flag(PIPE_MTE1,PIPE_MTE2,static_cast<event_t>(2+slot));
CopyB(Weight(slot),tile,panel,count);
set_flag(PIPE_MTE2,PIPE_MTE1,static_cast<event_t>(2+slot));
}
__aicore__ inline void Operands(__cbuf__ int8_t* a,__cbuf__ int8_t* b,
int inner,int count,int panelStride,int rows,int columns) {
int slot=operand;
wait_flag(PIPE_M,PIPE_MTE1,static_cast<event_t>(slot));
asc_copy_l12l0a(reinterpret_cast<__ca__ int8_t*>(uint64_t(slot*BM*128)),
a,count,rows,inner,0,1,1,1,1,1,1,false,false,false,false,panelStride);
load_cbuf_to_cb_transpose(reinterpret_cast<__cb__ int8_t*>(uint64_t(slot*BN*128)),
b+inner*columns,0,(count/32)*(columns/32),1,1,false,0);
set_flag(PIPE_MTE1,PIPE_M,static_cast<event_t>(slot));
}
__aicore__ inline void Multiply(CceTile tile,__gm__ int32_t* target,
const CceTile* nextTile,int reuseEvent=-1) {
if(reuseEvent>=0)wait_flag_dev(reuseEvent);
int rows=(tile.rows+15)&~15,columns=(tile.columns+31)&~31;
set_fmatrix((uint64_t(1)<<16)|rows);
int first=FullA?plan.k:(plan.k<KP?plan.k:KP);
if constexpr(ResidentB) {
if(tile.expert!=weightExpert || tile.column!=weightColumn) {
wait_flag(PIPE_MTE1,PIPE_MTE2,EVENT_ID2);
CopyB(Weight(0),tile,0,plan.k);
set_flag(PIPE_MTE2,PIPE_MTE1,EVENT_ID2);
wait_flag(PIPE_MTE2,PIPE_MTE1,EVENT_ID2);
weightExpert=tile.expert;weightColumn=tile.column;
}
} else if(!bPrefetched)LoadB(tile,0,first);
if(!aPrefetched)LoadA(tile,0,first);
aPrefetched=false;bPrefetched=false;
wait_flag(PIPE_FIX,PIPE_M,EVENT_ID0);
auto accumulator=reinterpret_cast<__cc__ int32_t*>(uint64_t(0));
for(int panel=0;panel<plan.k;panel+=(FullA?plan.k:KP)) {
int count=FullA?plan.k:(plan.k-panel<KP?plan.k-panel:KP);
int padded=(count+31)&~31;
int aSlot=FullA?0:aRead,bSlot=bRead;if constexpr(!FullA)aRead^=1;bRead^=1;
wait_flag(PIPE_MTE2,PIPE_MTE1,static_cast<event_t>(aSlot));
if constexpr(!ResidentB)wait_flag(PIPE_MTE2,PIPE_MTE1,static_cast<event_t>(2+bSlot));
if(panel+count<plan.k) {
int next=panel+count,nextCount=plan.k-next<KP?plan.k-next:KP;
if constexpr(!ResidentB)LoadB(tile,next,nextCount);
LoadA(tile,next,nextCount);
} else if(nextTile && !FullA) {
LoadA(*nextTile,0,first);aPrefetched=true;
if constexpr(!ResidentB){LoadB(*nextTile,0,first);bPrefetched=true;}
}
auto a=Activation(aSlot),b=ResidentB?Weight(0)+panel*columns:Weight(bSlot);
Operands(a,b,0,padded<128?padded:128,padded,rows,columns);
for(int inner=0;inner<padded;inner+=128) {
int reduction=padded-inner<128?padded-inner:128;
int slot=operand;operand^=1;
wait_flag(PIPE_MTE1,PIPE_M,static_cast<event_t>(slot));
mad(accumulator,reinterpret_cast<__ca__ int8_t*>(uint64_t(slot*BM*128)),
reinterpret_cast<__cb__ int8_t*>(uint64_t(slot*BN*128)),
rows,reduction,columns,0,false,false,panel==0 && inner==0);
set_flag(PIPE_M,PIPE_MTE1,static_cast<event_t>(slot));
int next=inner+128;
if(next<padded)Operands(a,b,next,padded-next<128?padded-next:128,padded,rows,columns);
if((rows/16)*(columns/16)<10)pipe_barrier(PIPE_M);
}
set_flag(PIPE_MTE1,PIPE_MTE2,static_cast<event_t>(aSlot));
if constexpr(!ResidentB)set_flag(PIPE_MTE1,PIPE_MTE2,static_cast<event_t>(2+bSlot));
}
if constexpr(ResidentB)if(!nextTile || nextTile->expert!=tile.expert || nextTile->column!=tile.column)
set_flag(PIPE_MTE1,PIPE_MTE2,EVENT_ID2);
set_flag(PIPE_M,PIPE_FIX,EVENT_ID0);wait_flag(PIPE_M,PIPE_FIX,EVENT_ID0);
asc_set_l0c_copy_params(1,0,0);asc_set_l0c2gm_config(0,0,true);
int outputColumns=tile.columns;
if constexpr(PackedB && ResidentB && BN==32)
if(plan.n<32)outputColumns=columns;
copy_matrix_cc_to_gm(target,accumulator,0,outputColumns,tile.rows,BN,rows,0,
static_cast<QuantMode_t>(0),0,false,true);
set_flag(PIPE_FIX,PIPE_M,EVENT_ID0);
}
__aicore__ inline void Finish() {
for(int i=0;i<(ResidentB?3:4);++i)wait_flag(PIPE_MTE1,PIPE_MTE2,static_cast<event_t>(i));
for(int i=0;i<2;++i)wait_flag(PIPE_M,PIPE_MTE1,static_cast<event_t>(i));
wait_flag(PIPE_FIX,PIPE_M,EVENT_ID0);
}
};
__aicore__ inline void CceStageCubeWeights(GM_ADDR weights,GmmPlan p,
__cbuf__ int8_t* local,int job,int stop,int capacity,int event) {
int slabs=(p.k+31)/32,paddedN=(p.n+31)&~31;
int expert=job/slabs,row=job%slabs*32,units=slabs-job%slabs;
if(units>stop-job)units=stop-job;
if(units>capacity)units=capacity;
int rows=p.k-row<units*32?p.k-row:units*32;
auto source=reinterpret_cast<__gm__ int8_t*>(weights)+(int64_t(expert)*p.k+row)*p.n;
int bulk=rows&~31;
if(p.n<=32 && (p.n&1) && row+rows==p.k && bulk==rows)bulk-=32;
if(bulk>0)for(int phase=0;phase<2;++phase)
asc_copy_gm2l1_nd2nz(reinterpret_cast<__cbuf__ int16_t*>(local+phase*32),
reinterpret_cast<__gm__ int16_t*>(source+phase*p.n),
bulk/32,16,(p.n+1)/2,16*p.n,p.n,32,2,16*paddedN);
if(bulk<rows)copy_gm_to_cbuf_multi_nd2nz_b8(local+bulk*paddedN,
source+int64_t(bulk)*p.n,0,1,rows-bulk,p.n,0,p.n,32,1,0);
set_flag(PIPE_MTE2,PIPE_MTE3,static_cast<event_t>(event));
}
template<bool SafeMatrixStride=false>
__aicore__ inline void CceStageWideCubeWeights(GM_ADDR weights,GmmPlan p,
__cbuf__ int8_t* local,int job,int stop,int capacity,int event) {
int slabs=(p.k+31)/32,paddedN=(p.n+31)&~31;
int expert=job/slabs,row=job%slabs*32,units=slabs-job%slabs;
if(units>stop-job)units=stop-job;
if(units>capacity)units=capacity;
int rows=p.k-row<units*32?p.k-row:units*32;
auto source=reinterpret_cast<__gm__ int8_t*>(weights)+(int64_t(expert)*p.k+row)*p.n;
int bulk=rows&~31;
if((p.n&1) && row+rows==p.k && bulk==rows)bulk-=32;
if(bulk>0)for(int phase=0;phase<2;++phase)
asc_copy_gm2l1_nd2nz(reinterpret_cast<__cbuf__ int16_t*>(local+phase*32),
reinterpret_cast<__gm__ int16_t*>(source+phase*p.n),
bulk/32,16,(p.n+1)/2,SafeMatrixStride && bulk==32?0:16*p.n,p.n,32,2,SafeMatrixStride && bulk==32?0:16*paddedN);
if(bulk<rows)copy_gm_to_cbuf_multi_nd2nz_b8(local+bulk*paddedN,
source+int64_t(bulk)*p.n,0,1,rows-bulk,p.n,0,p.n,32,1,0);
set_flag(PIPE_MTE2,PIPE_MTE3,static_cast<event_t>(event));
}
template<int BM,int BN,bool SafeMatrixStride=false>
__aicore__ inline void CcePackWideWeights(GM_ADDR weights,GM_ADDR workspace,GmmPlan p) {
if ASCEND_IS_AIC {
int core=asc_get_block_idx(),paddedK=(p.k+31)&~31,paddedN=(p.n+31)&~31;
int slabs=paddedK/32,jobs=p.e*slabs;
auto packed=reinterpret_cast<__gm__ int8_t*>(workspace)+int64_t(p.cores)*2*BM*BN*4;
constexpr int SlotBytes=192*1024;
int capacity=(SlotBytes/paddedN)/32;
int first=jobs*core/p.cores,stop=jobs*(core+1)/p.cores;
int iteration=0,pending=0;
if(first<stop)CceStageWideCubeWeights<SafeMatrixStride>(weights,p,reinterpret_cast<__cbuf__ int8_t*>(uint64_t(0)),first,stop,capacity,4);
for(int job=first;job<stop;) {
int stage=iteration++&1,expert=job/slabs,row=(job%slabs)*32;
int units=slabs-job%slabs;
if(units>stop-job)units=stop-job;
if(units>capacity)units=capacity;
int next=job+units;
if(next<stop) {
int nextStage=stage^1;
if(pending&(1<<nextStage)) {wait_flag(PIPE_MTE3,PIPE_MTE2,static_cast<event_t>(4+nextStage));pending^=1<<nextStage;}
CceStageWideCubeWeights<SafeMatrixStride>(weights,p,reinterpret_cast<__cbuf__ int8_t*>(uint64_t(nextStage*SlotBytes)),next,stop,capacity,4+nextStage);
}
wait_flag(PIPE_MTE2,PIPE_MTE3,static_cast<event_t>(4+stage));
auto local=reinterpret_cast<__cbuf__ int8_t*>(uint64_t(stage*SlotBytes));
copy_cbuf_to_gm(reinterpret_cast<__gm__ void*>(packed+(int64_t(expert)*paddedK+row)*paddedN),reinterpret_cast<__cbuf__ void*>(local),0,1,units*paddedN,0,0);
set_flag(PIPE_MTE3,PIPE_MTE2,static_cast<event_t>(4+stage));pending|=1<<stage;
job=next;
}
for(int stage=0;stage<2;++stage)if(pending&(1<<stage))wait_flag(PIPE_MTE3,PIPE_MTE2,static_cast<event_t>(4+stage));
}
}
template<int RawBytes>
__aicore__ inline void CceStageVectorWeights(GM_ADDR weights,GmmPlan p,
__ubuf__ uint8_t* input,int job,int slabs,int event,int firstSlab=0) {
int expert=job/slabs,row=(firstSlab+job%slabs)*32,rows=p.k-row<32?p.k-row:32;
auto source=reinterpret_cast<__gm__ uint8_t*>(weights)+(int64_t(expert)*p.k+row)*p.n;
copy_gm_to_ubuf_align_b8(input,source,0,1,rows*p.n,0,0,0,0);
copy_gm_to_ubuf_align_b8(input+RawBytes,source+1,0,1,rows*p.n-1,0,0,0,0);
set_flag(PIPE_MTE2,PIPE_V,static_cast<event_t>(event));
}
template<int BM,int BN>
__aicore__ inline void CcePackNarrowColumnWeights(GM_ADDR weights,GM_ADDR workspace,GmmPlan p) {
if ASCEND_IS_AIV {
constexpr int Rows=512,RawBytes=Rows*32+64,InputBytes=2*RawBytes;
constexpr int OutputAddress=2*InputBytes,OutputBytes=Rows*32;
constexpr int IndexAddress=OutputAddress+2*OutputBytes;
auto indices=reinterpret_cast<__ubuf__ uint32_t*>(uint64_t(IndexAddress));
for(int word=0;word<16;++word) {
indices[word]=word*2;
indices[16+word]=(p.n&1)*RawBytes+p.n-(p.n&1)+word*2;
}
set_flag(PIPE_S,PIPE_V,EVENT_ID0);wait_flag(PIPE_S,PIPE_V,EVENT_ID0);
set_mask_count();
for(int rows=2;rows<Rows;rows*=2) {
set_vector_mask(0,rows*16);
vadds(reinterpret_cast<__ubuf__ int32_t*>(indices+rows*16),
reinterpret_cast<__ubuf__ int32_t*>(indices),rows*p.n,1,1,1,8,8);
pipe_barrier(PIPE_V);
}
const int paddedK=(p.k+31)&~31,chunks=(p.k+Rows-1)/Rows;
const int lane=asc_get_block_idx()*2+asc_get_sub_block_id(),lanes=p.cores*2;
const int first=p.e*chunks*lane/lanes,stop=p.e*chunks*(lane+1)/lanes;
auto packed=reinterpret_cast<__gm__ uint8_t*>(workspace)+int64_t(p.cores)*2*BM*BN*4;
auto source=reinterpret_cast<__gm__ uint8_t*>(weights);
int inputPending=0,outputPending=0;
for(int job=first;job<stop;++job) {
int stage=(job-first)&1,expert=job/chunks,row=(job%chunks)*Rows;
int rows=p.k-row<Rows?p.k-row:Rows,padded=(rows+31)&~31;
if(inputPending&(1<<stage)) {
wait_flag(PIPE_V,PIPE_MTE2,static_cast<event_t>(6+stage));inputPending^=1<<stage;
}
auto raw=reinterpret_cast<__ubuf__ uint8_t*>(uint64_t(stage*InputBytes));
copy_gm_to_ubuf_align_b8(raw,source+(int64_t(expert)*p.k+row)*p.n,0,1,rows*p.n,0,0,0,0);
if(rows*p.n>1)copy_gm_to_ubuf_align_b8(raw+RawBytes,source+(int64_t(expert)*p.k+row)*p.n+1,
0,1,rows*p.n-1,0,0,0,0);
set_flag(PIPE_MTE2,PIPE_V,static_cast<event_t>(4+stage));
if(outputPending&(1<<stage)) {
wait_flag(PIPE_MTE3,PIPE_V,static_cast<event_t>(4+stage));outputPending^=1<<stage;
}
wait_flag(PIPE_MTE2,PIPE_V,static_cast<event_t>(4+stage));
auto out=reinterpret_cast<__ubuf__ uint16_t*>(uint64_t(OutputAddress+stage*OutputBytes));
set_vector_mask(0,padded*16);
vgather(out,indices,reinterpret_cast<uint64_t>(raw),8,1);
set_flag(PIPE_V,PIPE_MTE2,static_cast<event_t>(6+stage));inputPending|=1<<stage;
set_flag(PIPE_V,PIPE_MTE3,static_cast<event_t>(4+stage));
wait_flag(PIPE_V,PIPE_MTE3,static_cast<event_t>(4+stage));
copy_ubuf_to_gm_align_b8(packed+(int64_t(expert)*paddedK+row)*32,out,
0,1,padded*32,0,0,0,0);
set_flag(PIPE_MTE3,PIPE_V,static_cast<event_t>(4+stage));outputPending|=1<<stage;
}
for(int stage=0;stage<2;++stage) {
if(inputPending&(1<<stage))wait_flag(PIPE_V,PIPE_MTE2,static_cast<event_t>(6+stage));
if(outputPending&(1<<stage))wait_flag(PIPE_MTE3,PIPE_V,static_cast<event_t>(4+stage));
}
set_mask_norm();set_vector_mask(~uint64_t(0),~uint64_t(0));
}
}
template<int BM,int BN,int Kind>
__aicore__ inline void CcePackWeights(GM_ADDR weights,GM_ADDR workspace,GmmPlan p,int firstSlab=0,int regionSlabs=0) {
int core=asc_get_block_idx(),paddedK=(p.k+31)&~31,paddedN=(p.n+31)&~31;
int slabs=regionSlabs>0?regionSlabs:paddedK/32,jobs=p.e*slabs;
int split=regionSlabs>0?0:((BM==80 && BN==384 && p.n<=896)?jobs*7/16:jobs/2);
auto packed=reinterpret_cast<__gm__ int8_t*>(workspace)+int64_t(p.cores)*2*BM*BN*4;
if ASCEND_IS_AIC {
constexpr int SlotBytes=192*1024;
int capacity=(SlotBytes/paddedN)/32;
int first=split*core/p.cores,stop=split*(core+1)/p.cores;
int iteration=0,pending=0;
if(first<stop)CceStageCubeWeights(weights,p,
reinterpret_cast<__cbuf__ int8_t*>(uint64_t(0)),first,stop,capacity,4);
for(int job=first;job<stop;) {
int stage=iteration++&1,expert=job/slabs,row=(job%slabs)*32;
int units=slabs-job%slabs;
if(units>stop-job)units=stop-job;
if(units>capacity)units=capacity;
int next=job+units;
if(next<stop) {
int nextStage=stage^1;
if(pending&(1<<nextStage)) {
wait_flag(PIPE_MTE3,PIPE_MTE2,static_cast<event_t>(4+nextStage));
pending^=1<<nextStage;
}
CceStageCubeWeights(weights,p,reinterpret_cast<__cbuf__ int8_t*>(uint64_t(nextStage*SlotBytes)),
next,stop,capacity,4+nextStage);
}
wait_flag(PIPE_MTE2,PIPE_MTE3,static_cast<event_t>(4+stage));
auto local=reinterpret_cast<__cbuf__ int8_t*>(uint64_t(stage*SlotBytes));
copy_cbuf_to_gm(reinterpret_cast<__gm__ void*>(packed+(int64_t(expert)*paddedK+row)*paddedN),
reinterpret_cast<__cbuf__ void*>(local),0,1,units*paddedN,0,0);
set_flag(PIPE_MTE3,PIPE_MTE2,static_cast<event_t>(4+stage));pending|=1<<stage;
job=next;
}
for(int stage=0;stage<2;++stage)if(pending&(1<<stage))wait_flag(PIPE_MTE3,PIPE_MTE2,static_cast<event_t>(4+stage));
} else {
constexpr int MaxColumns=Kind==14?1056:Kind==8?544:Kind==9?768:Kind==15?416:800;
constexpr int RawBytes=MaxColumns*32+64,InputBytes=2*RawBytes;
constexpr int InputStages=MaxColumns>800?1:2;
constexpr int OutputAddress=InputStages*InputBytes;
constexpr int IndexAddress=OutputAddress+MaxColumns*32;
static_assert(IndexAddress+MaxColumns*64<=192*1024,"Native gather buffers exceed UB");
auto indices=reinterpret_cast<__ubuf__ uint32_t*>(uint64_t(IndexAddress));
if(firstSlab==0 || firstSlab==24) {
if constexpr(Kind==9) {
for(int word=0;word<16;++word)indices[word]=word*2;
set_flag(PIPE_S,PIPE_V,EVENT_ID0);wait_flag(PIPE_S,PIPE_V,EVENT_ID0);
set_mask_count();set_vector_mask(0,16);
vadds(reinterpret_cast<__ubuf__ int32_t*>(indices+16),
reinterpret_cast<__ubuf__ int32_t*>(indices),
int32_t(p.n+(p.n&1)*(RawBytes-1)),1,1,1,8,8);
pipe_barrier(PIPE_V);
for(int rows=2;rows<32;rows*=2) {
set_vector_mask(0,rows*16);
vadds(reinterpret_cast<__ubuf__ int32_t*>(indices+rows*16),
reinterpret_cast<__ubuf__ int32_t*>(indices),int32_t(rows*p.n),1,1,1,8,8);
pipe_barrier(PIPE_V);
}
set_vector_mask(0,512);
} else {
for(int row=0;row<32;++row)for(int word=0;word<16;++word) {
int phase=(row*p.n)&1;
indices[row*16+word]=phase*RawBytes+row*p.n-phase+word*2;
}
set_flag(PIPE_S,PIPE_V,EVENT_ID0);wait_flag(PIPE_S,PIPE_V,EVENT_ID0);
set_mask_count();set_vector_mask(0,512);
}
for(int column=32;column<paddedN;column+=32)
vadds(reinterpret_cast<__ubuf__ int32_t*>(indices+column*16),
reinterpret_cast<__ubuf__ int32_t*>(indices),column,1,1,1,8,8);
pipe_barrier(PIPE_V);
}
int lane=core*2+asc_get_sub_block_id(),lanes=p.cores*2;
int first=split+(jobs-split)*lane/lanes,stop=split+(jobs-split)*(lane+1)/lanes;
int pending=0;bool outputPending=false;
if constexpr(InputStages==2)if(first<stop)
CceStageVectorWeights<RawBytes>(weights,p,reinterpret_cast<__ubuf__ uint8_t*>(uint64_t(0)),first,slabs,4,firstSlab);
for(int job=first;job<stop;++job) {
int stage=InputStages==2?((job-first)&1):0;
int expert=job/slabs,row=(firstSlab+job%slabs)*32;
if constexpr(InputStages==2) {
if(job+1<stop) {
int next=stage^1;
if(pending&(1<<next)) {
wait_flag(PIPE_V,PIPE_MTE2,static_cast<event_t>(6+next));pending^=1<<next;
}
CceStageVectorWeights<RawBytes>(weights,p,
reinterpret_cast<__ubuf__ uint8_t*>(uint64_t(next*InputBytes)),job+1,slabs,4+next,firstSlab);
}
} else {
if(pending){wait_flag(PIPE_V,PIPE_MTE2,EVENT_ID6);pending=0;}
CceStageVectorWeights<RawBytes>(weights,p,
reinterpret_cast<__ubuf__ uint8_t*>(uint64_t(0)),job,slabs,4,firstSlab);
}
if(outputPending){wait_flag(PIPE_MTE3,PIPE_V,EVENT_ID4);outputPending=false;}
wait_flag(PIPE_MTE2,PIPE_V,static_cast<event_t>(4+stage));
auto input=reinterpret_cast<__ubuf__ uint16_t*>(uint64_t(stage*InputBytes));
auto output=reinterpret_cast<__ubuf__ uint16_t*>(uint64_t(OutputAddress));
int rows=p.k-row<32?p.k-row:32;
if(rows==32) {
set_mask_count();set_vector_mask(0,paddedN*16);
vgather(output,indices,reinterpret_cast<uint64_t>(input),8,1);
} else {
asc_duplicate(reinterpret_cast<__ubuf__ uint32_t*>(output),uint32_t(0),paddedN*8);
pipe_barrier(PIPE_V);
set_mask_count();set_vector_mask(0,rows*16);
for(int column=0;column<paddedN;column+=32)
vgather(output+column*16,indices+column*16,reinterpret_cast<uint64_t>(input),8,1);
}
set_flag(PIPE_V,PIPE_MTE2,static_cast<event_t>(6+stage));pending|=1<<stage;
set_flag(PIPE_V,PIPE_MTE3,EVENT_ID4);wait_flag(PIPE_V,PIPE_MTE3,EVENT_ID4);
copy_ubuf_to_gm_align_b8(packed+(int64_t(expert)*paddedK+row)*paddedN,output,0,1,paddedN*32,0,0,0,0);
set_flag(PIPE_MTE3,PIPE_V,EVENT_ID4);outputPending=true;
}
if(outputPending)wait_flag(PIPE_MTE3,PIPE_V,EVENT_ID4);
for(int stage=0;stage<InputStages;++stage)if(pending&(1<<stage))wait_flag(PIPE_V,PIPE_MTE2,static_cast<event_t>(6+stage));
set_mask_norm();set_vector_mask(~uint64_t(0),~uint64_t(0));
}
}
template<int BM,int BN,int Kind>
__aicore__ inline void CcePackWeightsCase8(GM_ADDR weights,GM_ADDR workspace,GmmPlan p,int firstSlab=0,int regionSlabs=0) {
if ASCEND_IS_AIC {
CcePackWeights<BM,BN,Kind>(weights,workspace,p,firstSlab,regionSlabs);
} else {
int core=asc_get_block_idx(),paddedK=(p.k+31)&~31,paddedN=(p.n+31)&~31;
int slabs=regionSlabs>0?regionSlabs:paddedK/32,jobs=p.e*slabs;
int split=regionSlabs>0?0:((BM==80 && BN==384 && p.n<=896)?jobs*7/16:jobs/2);
auto packed=reinterpret_cast<__gm__ int8_t*>(workspace)+int64_t(p.cores)*2*BM*BN*4;
constexpr int MaxColumns=Kind==14?1056:Kind==8?544:Kind==9?768:Kind==15?416:800;
constexpr int RawBytes=MaxColumns*32+64,InputBytes=2*RawBytes;
constexpr int InputStages=MaxColumns>800?1:2;
constexpr int OutputAddress=InputStages*InputBytes;
constexpr int IndexAddress=OutputAddress+(Kind==8?2:1)*MaxColumns*32;
static_assert(IndexAddress+MaxColumns*64<=192*1024,"Native gather buffers exceed UB");
int lane=core*2+asc_get_sub_block_id(),lanes=p.cores*2;
int first=split+(jobs-split)*lane/lanes,stop=split+(jobs-split)*(lane+1)/lanes;
if constexpr(Kind==8 && InputStages==2)if(first<stop && firstSlab<=24)
CceStageVectorWeights<RawBytes>(weights,p,reinterpret_cast<__ubuf__ uint8_t*>(uint64_t(0)),first,slabs,4,firstSlab);
auto indices=reinterpret_cast<__ubuf__ uint32_t*>(uint64_t(IndexAddress));
if(firstSlab==0 || firstSlab==24) {
for(int row=0;row<32;++row)for(int word=0;word<16;++word) {
int phase=(row*p.n)&1;
indices[row*16+word]=phase*RawBytes+row*p.n-phase+word*2;
}
set_flag(PIPE_S,PIPE_V,EVENT_ID0);wait_flag(PIPE_S,PIPE_V,EVENT_ID0);
set_mask_count();set_vector_mask(0,512);
for(int column=32;column<paddedN;column+=32)
vadds(reinterpret_cast<__ubuf__ int32_t*>(indices+column*16),
reinterpret_cast<__ubuf__ int32_t*>(indices),column,1,1,1,8,8);
pipe_barrier(PIPE_V);
}
int pending=0,outputPendingMask=0;bool outputPending=false;
if constexpr(InputStages==2 && Kind!=8)if(first<stop)
CceStageVectorWeights<RawBytes>(weights,p,reinterpret_cast<__ubuf__ uint8_t*>(uint64_t(0)),first,slabs,4,firstSlab);
for(int job=first;job<stop;++job) {
int stage=InputStages==2?((job-first)&1):0;
int expert=job/slabs,row=(firstSlab+job%slabs)*32;
if constexpr(InputStages==2) {
if(job+1<stop) {
int next=stage^1;
if(pending&(1<<next)) {
wait_flag(PIPE_V,PIPE_MTE2,static_cast<event_t>(6+next));pending^=1<<next;
}
CceStageVectorWeights<RawBytes>(weights,p,
reinterpret_cast<__ubuf__ uint8_t*>(uint64_t(next*InputBytes)),job+1,slabs,4+next,firstSlab);
}
} else {
if(pending){wait_flag(PIPE_V,PIPE_MTE2,EVENT_ID6);pending=0;}
CceStageVectorWeights<RawBytes>(weights,p,
reinterpret_cast<__ubuf__ uint8_t*>(uint64_t(0)),job,slabs,4,firstSlab);
}
int outputStage=Kind==8?((job-first)&1):0;
event_t outputEvent=static_cast<event_t>(4+outputStage);
if constexpr(Kind==8) {
if(outputPendingMask&(1<<outputStage)) {
wait_flag(PIPE_MTE3,PIPE_V,outputEvent);outputPendingMask^=1<<outputStage;
}
} else if(outputPending){wait_flag(PIPE_MTE3,PIPE_V,EVENT_ID4);outputPending=false;}
wait_flag(PIPE_MTE2,PIPE_V,static_cast<event_t>(4+stage));
auto input=reinterpret_cast<__ubuf__ uint16_t*>(uint64_t(stage*InputBytes));
auto output=reinterpret_cast<__ubuf__ uint16_t*>(uint64_t(OutputAddress+outputStage*MaxColumns*32));
int rows=p.k-row<32?p.k-row:32;
if(rows==32) {
set_mask_count();set_vector_mask(0,paddedN*16);
vgather(output,indices,reinterpret_cast<uint64_t>(input),8,1);
} else {
asc_duplicate(reinterpret_cast<__ubuf__ uint32_t*>(output),uint32_t(0),paddedN*8);
pipe_barrier(PIPE_V);
set_mask_count();set_vector_mask(0,rows*16);
for(int column=0;column<paddedN;column+=32)
vgather(output+column*16,indices+column*16,reinterpret_cast<uint64_t>(input),8,1);
}
set_flag(PIPE_V,PIPE_MTE2,static_cast<event_t>(6+stage));pending|=1<<stage;
set_flag(PIPE_V,PIPE_MTE3,outputEvent);wait_flag(PIPE_V,PIPE_MTE3,outputEvent);
copy_ubuf_to_gm_align_b8(packed+(int64_t(expert)*paddedK+row)*paddedN,output,0,1,paddedN*32,0,0,0,0);
set_flag(PIPE_MTE3,PIPE_V,outputEvent);
if constexpr(Kind==8)outputPendingMask|=1<<outputStage;
else outputPending=true;
}
if constexpr(Kind==8) {
for(int stage=0;stage<2;++stage)if(outputPendingMask&(1<<stage))
wait_flag(PIPE_MTE3,PIPE_V,static_cast<event_t>(4+stage));
} else if(outputPending)wait_flag(PIPE_MTE3,PIPE_V,EVENT_ID4);
for(int stage=0;stage<InputStages;++stage)if(pending&(1<<stage))wait_flag(PIPE_V,PIPE_MTE2,static_cast<event_t>(6+stage));
set_mask_norm();set_vector_mask(~uint64_t(0),~uint64_t(0));
}
}
template<int BM,int BN>
__aicore__ inline void CcePackWeightsCompactIndex(GM_ADDR weights,GM_ADDR workspace,GmmPlan p,int firstSlab=0,int regionSlabs=0) {
int core=asc_get_block_idx(),paddedK=(p.k+31)&~31,paddedN=(p.n+31)&~31;
int slabs=regionSlabs>0?regionSlabs:paddedK/32,jobs=p.e*slabs;
int split=regionSlabs>0?0:((BM==80 && BN==384 && p.n<=896)?jobs*7/16:jobs/2);
auto packed=reinterpret_cast<__gm__ int8_t*>(workspace)+int64_t(p.cores)*2*BM*BN*4;
if ASCEND_IS_AIC {
constexpr int SlotBytes=192*1024;
int capacity=(SlotBytes/paddedN)/32;
int first=split*core/p.cores,stop=split*(core+1)/p.cores;
int iteration=0,pending=0;
if(first<stop)CceStageCubeWeights(weights,p,
reinterpret_cast<__cbuf__ int8_t*>(uint64_t(0)),first,stop,capacity,4);
for(int job=first;job<stop;) {
int stage=iteration++&1,expert=job/slabs,row=(job%slabs)*32;
int units=slabs-job%slabs;
if(units>stop-job)units=stop-job;
if(units>capacity)units=capacity;
int next=job+units;
if(next<stop) {
int nextStage=stage^1;
if(pending&(1<<nextStage)) {
wait_flag(PIPE_MTE3,PIPE_MTE2,static_cast<event_t>(4+nextStage));
pending^=1<<nextStage;
}
CceStageCubeWeights(weights,p,reinterpret_cast<__cbuf__ int8_t*>(uint64_t(nextStage*SlotBytes)),
next,stop,capacity,4+nextStage);
}
wait_flag(PIPE_MTE2,PIPE_MTE3,static_cast<event_t>(4+stage));
auto local=reinterpret_cast<__cbuf__ int8_t*>(uint64_t(stage*SlotBytes));
copy_cbuf_to_gm(reinterpret_cast<__gm__ void*>(packed+(int64_t(expert)*paddedK+row)*paddedN),
reinterpret_cast<__cbuf__ void*>(local),0,1,units*paddedN,0,0);
set_flag(PIPE_MTE3,PIPE_MTE2,static_cast<event_t>(4+stage));pending|=1<<stage;
job=next;
}
for(int stage=0;stage<2;++stage)if(pending&(1<<stage))wait_flag(PIPE_MTE3,PIPE_MTE2,static_cast<event_t>(4+stage));
} else {
constexpr int MaxColumns=800;
constexpr int RawBytes=MaxColumns*32+64,InputBytes=2*RawBytes;
constexpr int OutputAddress=2*InputBytes;
constexpr int IndexAddress=OutputAddress+2*MaxColumns*32;
static_assert(IndexAddress+512*4<=192*1024,"Compact gather buffers exceed UB");
auto indices=reinterpret_cast<__ubuf__ uint32_t*>(uint64_t(IndexAddress));
for(int word=0;word<16;++word)indices[word]=word*2;
set_flag(PIPE_S,PIPE_V,EVENT_ID0);wait_flag(PIPE_S,PIPE_V,EVENT_ID0);
set_mask_count();set_vector_mask(0,16);
vadds(reinterpret_cast<__ubuf__ int32_t*>(indices+16),
reinterpret_cast<__ubuf__ int32_t*>(indices),
int32_t(p.n+(p.n&1)*(RawBytes-1)),1,1,1,8,8);
pipe_barrier(PIPE_V);
for(int rows=2;rows<32;rows*=2) {
set_vector_mask(0,rows*16);
vadds(reinterpret_cast<__ubuf__ int32_t*>(indices+rows*16),
reinterpret_cast<__ubuf__ int32_t*>(indices),int32_t(rows*p.n),1,1,1,8,8);
pipe_barrier(PIPE_V);
}
int lane=core*2+asc_get_sub_block_id(),lanes=p.cores*2;
int first=split+(jobs-split)*lane/lanes,stop=split+(jobs-split)*(lane+1)/lanes;
int pending=0,outputPending=0;
if(first<stop)
CceStageVectorWeights<RawBytes>(weights,p,reinterpret_cast<__ubuf__ uint8_t*>(uint64_t(0)),first,slabs,4,firstSlab);
for(int job=first;job<stop;++job) {
int stage=(job-first)&1;
int expert=job/slabs,row=(firstSlab+job%slabs)*32;
if(job+1<stop) {
int next=stage^1;
if(pending&(1<<next)) {
wait_flag(PIPE_V,PIPE_MTE2,static_cast<event_t>(6+next));pending^=1<<next;
}
CceStageVectorWeights<RawBytes>(weights,p,
reinterpret_cast<__ubuf__ uint8_t*>(uint64_t(next*InputBytes)),job+1,slabs,4+next,firstSlab);
}
event_t event=static_cast<event_t>(4+stage);
if(outputPending&(1<<stage)) {
wait_flag(PIPE_MTE3,PIPE_V,event);outputPending^=1<<stage;
}
wait_flag(PIPE_MTE2,PIPE_V,event);
auto input=reinterpret_cast<__ubuf__ uint16_t*>(uint64_t(stage*InputBytes));
auto output=reinterpret_cast<__ubuf__ uint16_t*>(uint64_t(OutputAddress+stage*MaxColumns*32));
int rows=p.k-row<32?p.k-row:32;
if(rows<32) {
asc_duplicate(reinterpret_cast<__ubuf__ uint32_t*>(output),uint32_t(0),paddedN*8);
pipe_barrier(PIPE_V);
}
set_mask_count();set_vector_mask(0,rows*16);
for(int column=0;column<paddedN;column+=32)
vgather(output+column*16,indices,reinterpret_cast<uint64_t>(input)+column,8,1);
set_flag(PIPE_V,PIPE_MTE2,static_cast<event_t>(6+stage));pending|=1<<stage;
set_flag(PIPE_V,PIPE_MTE3,event);wait_flag(PIPE_V,PIPE_MTE3,event);
copy_ubuf_to_gm_align_b8(packed+(int64_t(expert)*paddedK+row)*paddedN,output,0,1,paddedN*32,0,0,0,0);
set_flag(PIPE_MTE3,PIPE_V,event);outputPending|=1<<stage;
}
for(int stage=0;stage<2;++stage)if(outputPending&(1<<stage))
wait_flag(PIPE_MTE3,PIPE_V,static_cast<event_t>(4+stage));
for(int stage=0;stage<2;++stage)if(pending&(1<<stage))
wait_flag(PIPE_V,PIPE_MTE2,static_cast<event_t>(6+stage));
set_mask_norm();set_vector_mask(~uint64_t(0),~uint64_t(0));
}
}
template<int RawBytes,int PackRows=32>
__aicore__ inline void CceStageVectorWeightsSplitInput(GM_ADDR weights,GmmPlan p,
__ubuf__ uint8_t* input,int job,int slabs,int event,int firstSlab=0) {
int expert=job/slabs,row=firstSlab*32+(job%slabs)*PackRows,rows=p.k<=row?0:(p.k-row<PackRows?p.k-row:PackRows);
auto source=reinterpret_cast<__gm__ uint8_t*>(weights)+(int64_t(expert)*p.k+row)*p.n;
if(rows>0) {
copy_gm_to_ubuf_align_b8(input,source,0,1,rows*p.n,0,0,0,0);
copy_gm_to_ubuf_align_b8(input+RawBytes,source+1,0,1,rows*p.n-1,0,0,0,0);
}
set_flag(PIPE_MTE2,PIPE_V,static_cast<event_t>(event));
}
template<int BM,int BN,int Kind>
__aicore__ inline void CcePackWeightsSplitInput(GM_ADDR weights,GM_ADDR workspace,GmmPlan p,int firstSlab=0,int regionSlabs=0) {
int core=asc_get_block_idx(),paddedK=(p.k+31)&~31,paddedN=(p.n+31)&~31;
int slabs=regionSlabs>0?regionSlabs:paddedK/32,jobs=p.e*slabs;
int split=regionSlabs>0?0:((BM==80 && BN==384 && p.n<=896)?jobs*7/16:jobs/2);
auto packed=reinterpret_cast<__gm__ int8_t*>(workspace)+int64_t(p.cores)*2*BM*BN*4;
if ASCEND_IS_AIC {
constexpr int SlotBytes=192*1024;
int capacity=(SlotBytes/paddedN)/32;
int first=split*core/p.cores,stop=split*(core+1)/p.cores;
int iteration=0,pending=0;
if(first<stop)CceStageCubeWeights(weights,p,
reinterpret_cast<__cbuf__ int8_t*>(uint64_t(0)),first,stop,capacity,4);
for(int job=first;job<stop;) {
int stage=iteration++&1,expert=job/slabs,row=(job%slabs)*32;
int units=slabs-job%slabs;
if(units>stop-job)units=stop-job;
if(units>capacity)units=capacity;
int next=job+units;
if(next<stop) {
int nextStage=stage^1;
if(pending&(1<<nextStage)) {
wait_flag(PIPE_MTE3,PIPE_MTE2,static_cast<event_t>(4+nextStage));
pending^=1<<nextStage;
}
CceStageCubeWeights(weights,p,reinterpret_cast<__cbuf__ int8_t*>(uint64_t(nextStage*SlotBytes)),
next,stop,capacity,4+nextStage);
}
wait_flag(PIPE_MTE2,PIPE_MTE3,static_cast<event_t>(4+stage));
auto local=reinterpret_cast<__cbuf__ int8_t*>(uint64_t(stage*SlotBytes));
copy_cbuf_to_gm(reinterpret_cast<__gm__ void*>(packed+(int64_t(expert)*paddedK+row)*paddedN),
reinterpret_cast<__cbuf__ void*>(local),0,1,units*paddedN,0,0);
set_flag(PIPE_MTE3,PIPE_MTE2,static_cast<event_t>(4+stage));pending|=1<<stage;
job=next;
}
for(int stage=0;stage<2;++stage)if(pending&(1<<stage))wait_flag(PIPE_MTE3,PIPE_MTE2,static_cast<event_t>(4+stage));
} else {
constexpr int MaxColumns=Kind==14?1056:Kind==8?544:Kind==9?768:Kind==15?416:800;
constexpr int PackRows=Kind==14?16:32;
constexpr int RawBytes=MaxColumns*PackRows+64,InputBytes=2*RawBytes;
constexpr int InputStages=2;
constexpr int OutputAddress=InputStages*InputBytes;
constexpr int IndexAddress=OutputAddress+2*MaxColumns*PackRows;
static_assert(IndexAddress+MaxColumns*PackRows*2<=192*1024,"Native gather buffers exceed UB");
auto indices=reinterpret_cast<__ubuf__ uint32_t*>(uint64_t(IndexAddress));
if(firstSlab==0 || firstSlab==24) {
for(int row=0;row<PackRows;++row)for(int word=0;word<16;++word) {
int phase=(row*p.n)&1;
indices[row*16+word]=phase*RawBytes+row*p.n-phase+word*2;
}
set_flag(PIPE_S,PIPE_V,EVENT_ID0);wait_flag(PIPE_S,PIPE_V,EVENT_ID0);
set_mask_count();set_vector_mask(0,PackRows*16);
for(int column=32;column<paddedN;column+=32)
vadds(reinterpret_cast<__ubuf__ int32_t*>(indices+column*(PackRows/2)),
reinterpret_cast<__ubuf__ int32_t*>(indices),column,1,1,1,8,8);
pipe_barrier(PIPE_V);
}
int lane=core*2+asc_get_sub_block_id(),lanes=p.cores*2;
int vectorSlabs=slabs*(32/PackRows),vectorSplit=split*(32/PackRows),vectorJobs=jobs*(32/PackRows);
int first=vectorSplit+(vectorJobs-vectorSplit)*lane/lanes,stop=vectorSplit+(vectorJobs-vectorSplit)*(lane+1)/lanes;
int pending=0,outputPendingMask=0;
if constexpr(InputStages==2)if(first<stop)
CceStageVectorWeightsSplitInput<RawBytes,PackRows>(weights,p,reinterpret_cast<__ubuf__ uint8_t*>(uint64_t(0)),first,vectorSlabs,4,firstSlab);
for(int job=first;job<stop;++job) {
int stage=InputStages==2?((job-first)&1):0;
int expert=job/vectorSlabs,row=firstSlab*32+(job%vectorSlabs)*PackRows;
if constexpr(InputStages==2) {
if(job+1<stop) {
int next=stage^1;
if(pending&(1<<next)) {
wait_flag(PIPE_V,PIPE_MTE2,static_cast<event_t>(6+next));pending^=1<<next;
}
CceStageVectorWeightsSplitInput<RawBytes,PackRows>(weights,p,
reinterpret_cast<__ubuf__ uint8_t*>(uint64_t(next*InputBytes)),job+1,vectorSlabs,4+next,firstSlab);
}
} else {
if(pending){wait_flag(PIPE_V,PIPE_MTE2,EVENT_ID6);pending=0;}
CceStageVectorWeightsSplitInput<RawBytes,PackRows>(weights,p,
reinterpret_cast<__ubuf__ uint8_t*>(uint64_t(0)),job,vectorSlabs,4,firstSlab);
}
event_t outputEvent=static_cast<event_t>(4+stage);
if(outputPendingMask&(1<<stage)){wait_flag(PIPE_MTE3,PIPE_V,outputEvent);outputPendingMask^=1<<stage;}
wait_flag(PIPE_MTE2,PIPE_V,static_cast<event_t>(4+stage));
auto input=reinterpret_cast<__ubuf__ uint16_t*>(uint64_t(stage*InputBytes));
auto output=reinterpret_cast<__ubuf__ uint16_t*>(uint64_t(OutputAddress+stage*MaxColumns*PackRows));
int rows=p.k<=row?0:(p.k-row<PackRows?p.k-row:PackRows);
if(rows==PackRows) {
set_mask_count();set_vector_mask(0,paddedN*PackRows/2);
vgather(output,indices,reinterpret_cast<uint64_t>(input),8,1);
} else {
asc_duplicate(reinterpret_cast<__ubuf__ uint32_t*>(output),uint32_t(0),paddedN*PackRows/4);
pipe_barrier(PIPE_V);
if(rows>0) {
set_mask_count();set_vector_mask(0,rows*16);
for(int column=0;column<paddedN;column+=32)
vgather(output+column*(PackRows/2),indices+column*(PackRows/2),reinterpret_cast<uint64_t>(input),8,1);
}
}
set_flag(PIPE_V,PIPE_MTE2,static_cast<event_t>(6+stage));pending|=1<<stage;
set_flag(PIPE_V,PIPE_MTE3,outputEvent);wait_flag(PIPE_V,PIPE_MTE3,outputEvent);
if constexpr(PackRows==32)
copy_ubuf_to_gm_align_b8(packed+(int64_t(expert)*paddedK+row)*paddedN,output,0,1,paddedN*32,0,0,0,0);
else
copy_ubuf_to_gm_align_b8(packed+(int64_t(expert)*paddedK+(row/32)*32)*paddedN+(row%32)*32,
output,0,paddedN/32,PackRows*32,0,0,0,(32-PackRows)*32);
set_flag(PIPE_MTE3,PIPE_V,outputEvent);outputPendingMask|=1<<stage;
}
for(int stage=0;stage<2;++stage)if(outputPendingMask&(1<<stage))wait_flag(PIPE_MTE3,PIPE_V,static_cast<event_t>(4+stage));
for(int stage=0;stage<InputStages;++stage)if(pending&(1<<stage))wait_flag(PIPE_V,PIPE_MTE2,static_cast<event_t>(6+stage));
set_mask_norm();set_vector_mask(~uint64_t(0),~uint64_t(0));
}
}
template<bool Publish=true>
__aicore__ inline void CcePrepareCoefficients(GM_ADDR scales,__gm__ uint64_t* encoded,GmmPlan p,bool tiesEven) {
auto input=reinterpret_cast<__ubuf__ uint32_t*>(uint64_t(0));
auto output=reinterpret_cast<__ubuf__ uint32_t*>(uint64_t(4096));
auto offsets=reinterpret_cast<__ubuf__ int32_t*>(uint64_t(6144));
auto keep=reinterpret_cast<__ubuf__ uint32_t*>(uint64_t(8192));
auto ones=reinterpret_cast<__ubuf__ uint32_t*>(uint64_t(9216));
auto rounding=reinterpret_cast<__ubuf__ int32_t*>(uint64_t(10240));
for(int i=0;i<8;++i)offsets[i]=((i&1)?256:0)*4+(i/2)*4;
set_flag(PIPE_S,PIPE_V,EVENT_ID7);wait_flag(PIPE_S,PIPE_V,EVENT_ID7);
set_mask_count();
for(int count=8;count<512;count*=2) {
set_vector_mask(0,count);vadds(offsets+count,offsets,int32_t(count*2),1,1,1,8,8);
pipe_barrier(PIPE_V);
}
asc_duplicate(keep,uint32_t(0xffffe000u),256);
asc_duplicate(ones,uint32_t(1),256);pipe_barrier(PIPE_V);
int stride=(p.n+31)&~31,panels=(p.n+255)/256;
int lane=asc_get_block_idx()*2+asc_get_sub_block_id(),lanes=p.cores*2;
for(int job=lane;job<p.e*panels;job+=lanes) {
int expert=job/panels,column=job%panels*256;
int count=p.n-column<256?p.n-column:256,padded=(count+31)&~31;
asc_duplicate(input,uint32_t(0),512);
set_flag(PIPE_V,PIPE_MTE2,EVENT_ID7);wait_flag(PIPE_V,PIPE_MTE2,EVENT_ID7);
copy_gm_to_ubuf_align_b8(input,reinterpret_cast<__gm__ uint32_t*>(scales)+int64_t(expert)*p.n+column,
0,1,count*4,0,0,0,0);
set_flag(PIPE_MTE2,PIPE_V,EVENT_ID7);wait_flag(PIPE_MTE2,PIPE_V,EVENT_ID7);
set_mask_count();set_vector_mask(0,padded);
auto bits=reinterpret_cast<__ubuf__ int32_t*>(input);
if(tiesEven) {
vshr(rounding,bits,13,1,1,1,8,8,false);pipe_barrier(PIPE_V);
set_vector_mask(0,2*padded);
vand(reinterpret_cast<__ubuf__ uint16_t*>(rounding),reinterpret_cast<__ubuf__ uint16_t*>(rounding),
reinterpret_cast<__ubuf__ uint16_t*>(ones),1,1,1,1,8,8,8);pipe_barrier(PIPE_V);
set_vector_mask(0,padded);
vadds(rounding,rounding,int32_t(0xfff),1,1,1,8,8);pipe_barrier(PIPE_V);
vadd(bits,bits,rounding,1,1,1,1,8,8,8);
} else vadds(bits,bits,int32_t(0x1000),1,1,1,8,8);
pipe_barrier(PIPE_V);set_vector_mask(0,2*padded);
vand(reinterpret_cast<__ubuf__ uint16_t*>(input),reinterpret_cast<__ubuf__ uint16_t*>(input),
reinterpret_cast<__ubuf__ uint16_t*>(keep),1,1,1,1,8,8,8);pipe_barrier(PIPE_V);
vgather(output,reinterpret_cast<__ubuf__ uint32_t*>(offsets),uint64_t(input),8,1);
set_flag(PIPE_V,PIPE_MTE3,EVENT_ID7);wait_flag(PIPE_V,PIPE_MTE3,EVENT_ID7);
copy_ubuf_to_gm_align_b8(encoded+int64_t(expert)*stride+column,output,0,1,padded*8,0,0,0,0);
set_flag(PIPE_MTE3,PIPE_V,EVENT_ID7);wait_flag(PIPE_MTE3,PIPE_V,EVENT_ID7);
}
if constexpr(Publish) {CceSignal<PIPE_MTE3,0>(8);wait_flag_dev(8);CceSignal<PIPE_MTE3,2>(5);}
}
template<int BM,int BN>
__aicore__ inline void CcePackActivation(GM_ADDR x,GM_ADDR workspace,GmmPlan p) {
int core=asc_get_block_idx(),paddedM=(p.m+15)&~15,paddedK=(p.k+31)&~31;
int blocks=paddedM/16,first=blocks*core/p.cores,stop=blocks*(core+1)/p.cores;
auto target=reinterpret_cast<__gm__ int8_t*>(workspace)+int64_t(p.cores)*2*BM*BN*4+
int64_t(p.e)*paddedK*((p.n+31)&~31);
for(int block=first;block<stop;block+=2) {
int packedRows=(stop-block<2?stop-block:2)*16,row=block*16;
int count=p.m-row<packedRows?p.m-row:packedRows;
auto local=reinterpret_cast<__cbuf__ int8_t*>(uint64_t(0));
auto source=reinterpret_cast<__gm__ int8_t*>(x)+int64_t(row)*p.k;
bool paired=(p.k&1) && paddedK<=8192 && count>=2;
int localRows=paired?32:packedRows;
if(paired) {
int bulk=p.k&~31;
for(int phase=0;phase<2;++phase)
asc_copy_gm2l1_nd2nz(reinterpret_cast<__cbuf__ int16_t*>(local+phase*32),
reinterpret_cast<__gm__ int16_t*>(source+phase*p.k),
1,(count+1-phase)/2,bulk/2,0,p.k,localRows,2,0);
copy_gm_to_cbuf_multi_nd2nz_b8(local+bulk*localRows,source+bulk,
0,1,count,p.k-bulk,0,p.k,localRows,1,0);
} else copy_gm_to_cbuf_multi_nd2nz_b8(local,source,0,1,count,p.k,0,p.k,localRows,1,0);
set_flag(PIPE_MTE2,PIPE_MTE3,EVENT_ID4);wait_flag(PIPE_MTE2,PIPE_MTE3,EVENT_ID4);
copy_cbuf_to_gm(target+row*32,local,0,paddedK/32,packedRows,
localRows-packedRows,paddedM-packedRows);
set_flag(PIPE_MTE3,PIPE_MTE2,EVENT_ID4);wait_flag(PIPE_MTE3,PIPE_MTE2,EVENT_ID4);
}
}
template<int BM,int BN>
__aicore__ inline void CcePackPrefix(GM_ADDR weights,GM_ADDR workspace,GmmPlan p) {
int core=asc_get_block_idx(),slabs=(p.k+31)/32,paddedN=(p.n+31)&~31;
int jobs=p.e*24,first=jobs*core/p.cores,stop=jobs*(core+1)/p.cores;
auto local=reinterpret_cast<__cbuf__ int8_t*>(uint64_t(0));
auto target=reinterpret_cast<__gm__ int8_t*>(workspace)+int64_t(p.cores)*2*BM*BN*4;
for(int job=first;job<stop;) {
int expert=job/24,inner=job%24,units=24-inner;
if(units>stop-job)units=stop-job;
int actual=expert*slabs+inner;
CceStageCubeWeights(weights,p,local,actual,actual+units,units,4);
wait_flag(PIPE_MTE2,PIPE_MTE3,EVENT_ID4);
copy_cbuf_to_gm(target+int64_t(actual)*32*paddedN,local,0,1,units*paddedN,0,0);
set_flag(PIPE_MTE3,PIPE_MTE2,EVENT_ID4);wait_flag(PIPE_MTE3,PIPE_MTE2,EVENT_ID4);
job+=units;
}
}
template<int ChunkRows,int SlotBytes,int ElementBytes,int InputOffset=0>
__aicore__ inline void CcePrefetchChunk(__gm__ uint8_t* source,int part,int rows,int slot,
int sourcePitch,int pitch,int& pending) {
int stage=(slot+part/ChunkRows)&1,nr=rows-part<ChunkRows?rows-part:ChunkRows;
if(pending&(1<<stage)) {
wait_flag(PIPE_MTE3,PIPE_MTE2,static_cast<event_t>(stage));
pending&=~(1<<stage);
}
auto input=reinterpret_cast<__ubuf__ uint8_t*>(uint64_t(InputOffset+stage*SlotBytes));
copy_gm_to_ubuf_align_b8(input,source+part*sourcePitch*ElementBytes,0,nr,
pitch*ElementBytes,0,0,(sourcePitch-pitch)*ElementBytes,0);
set_flag(PIPE_MTE2,PIPE_V,static_cast<event_t>(stage));
if(part+nr==rows)CceSignal<PIPE_MTE2,2>(2+slot);
}
template<int BM,int BN,int Kind,int KP,int Mode,int Rotate=0>
__global__ __aicore__ __schedmode__(1) void CceKernel(
GM_ADDR x,GM_ADDR weights,GM_ADDR scales,GM_ADDR groups,GM_ADDR output,
GM_ADDR workspace,GmmPlan p) {
KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
InitSocState();
constexpr bool Packed=Kind==7 || Kind==8 || Kind==9 || Kind==13 || Kind==14 || Kind==15 || Kind==19 || Kind==20 || Kind==21 || Kind==22;
constexpr bool Quant=Kind==1 || Kind==2 || Kind==5 || Kind==9 || Kind==12 || Kind==15;
constexpr bool HalfInput=Quant || Kind==7 || Kind==11 || Kind==13 || Kind==14;
constexpr bool Compact=Kind==12 || Kind==15;
constexpr int ElementBytes=HalfInput?2:4;
constexpr int InputOffset=Kind==14?256:0;
int core=asc_get_block_idx();
auto ends=reinterpret_cast<__gm__ int64_t*>(groups);
auto scratch=reinterpret_cast<__gm__ int32_t*>(workspace)+int64_t(core)*2*BM*BN;
auto packedWeights=reinterpret_cast<__gm__ int8_t*>(workspace)+int64_t(p.cores)*2*BM*BN*4;
auto coefficients=reinterpret_cast<__gm__ uint64_t*>(packedWeights+
(Packed?int64_t(p.e)*((p.k+31)&~31)*((p.n+31)&~31):0));
bool streamed=false;
if constexpr(Kind==8) {
int tasks=0,previous=0;
for(int e=0;e<p.e;++e) {int end=ends[e];tasks+=((end-previous+BM-1)/BM)*((p.n+BN-1)/BN);previous=end;}
streamed=tasks<=p.cores && p.k>768 && p.k<=9984;
}
if constexpr(Packed) {
if(streamed) {
if ASCEND_IS_AIC {
CcePackPrefix<BM,BN>(weights,workspace,p);
CcePackActivation<BM,BN>(x,workspace,p);
} else {
int slabs=(p.k+31)/32;
for(int first=24;first<slabs;first+=96) {
int count=slabs-first<96?slabs-first:96;
CcePackWeightsCase8<BM,BN,Kind>(weights,workspace,p,first,count);
int next=first+count;
if(next<slabs) {
int nextCount=slabs-next<96?slabs-next:96;
int lane=core*2+asc_get_sub_block_id(),lanes=p.cores*2;
int firstJob=(p.e*nextCount)*lane/lanes;
int stopJob=(p.e*nextCount)*(lane+1)/lanes;
if(firstJob<stopJob)
CceStageVectorWeights<544*32+64>(weights,p,
reinterpret_cast<__ubuf__ uint8_t*>(uint64_t(0)),firstJob,nextCount,4,next);
}
CceSignal<PIPE_MTE3,0>(6);wait_flag_dev(6);
int region=(first-24)/96;CceSignal<PIPE_MTE3,2>(region==0?5:region==1?7:1);
}
wait_flag_dev(4);
}
} else {
if constexpr(Kind==21)CcePackWideWeights<BM,BN,true>(weights,workspace,p);
else if constexpr(Kind==19 || Kind==22) {
if(p.n<32)CcePackNarrowColumnWeights<BM,BN>(weights,workspace,p);
else CcePackWeights<BM,BN,Kind>(weights,workspace,p);
} else if constexpr(Kind==20)CcePackWideWeights<BM,BN,true>(weights,workspace,p);
else if constexpr(Kind==8)CcePackWeightsCase8<BM,BN,Kind>(weights,workspace,p);
else if constexpr(Kind==14)CcePackWeightsSplitInput<BM,BN,Kind>(weights,workspace,p);
else if constexpr(Kind==9 || Kind==13)CcePackWeightsCompactIndex<BM,BN>(weights,workspace,p);
else CcePackWeights<BM,BN,Kind>(weights,workspace,p);
if constexpr(Kind==8 || Kind==21)if ASCEND_IS_AIC CcePackActivation<BM,BN>(x,workspace,p);
if ASCEND_IS_AIV {
CceSignal<PIPE_MTE3,0>(6);wait_flag_dev(6);CceSignal<PIPE_MTE3,2>(5);if constexpr(!Quant)wait_flag_dev(4);
}
}
}
if constexpr(Quant)if ASCEND_IS_AIV CcePrepareCoefficients<>(scales,coefficients,p,Kind==9 || Kind==15);
if constexpr(Packed && Quant)if ASCEND_IS_AIV wait_flag_dev(4);
using OrdinaryTraversal=typename std::conditional<Packed,
CcePackedTraversal<BM,BN,Mode,Rotate>,CceTraversal<BM,BN,Mode,Rotate>>::type;
using Traversal=typename std::conditional<Kind==2,CceColumnOwnerTraversal<BM,BN>,
typename std::conditional<Kind==4,CceContiguousExpertTraversal<BM,BN>,OrdinaryTraversal>::type>::type;
Traversal traversal(ends,p,core);
CceTile tile;
if ASCEND_IS_AIC {
using E0=CceDirectStreamingEngine<BM,BN,KP,Kind==16 || Kind==18 || Kind==19 || Kind==21 || Kind==22,Kind==19,Kind==19 || Kind==20 || Kind==21 || Kind==22,Kind==21>;
using E1=typename std::conditional<Kind==1 || Kind==5,CcePublicEngine<BM,BN,2048,(Kind==5?768:1024),true>,E0>::type;
using E2=typename std::conditional<Kind==2,CcePublicEngine<BM,BN,1024,1024,true>,E1>::type;
using E4=typename std::conditional<Kind==4,CceShortEngine<BM,BN,256,256,false>,E2>::type;
using E7=typename std::conditional<Kind==7 || Kind==14,CcePackedResidentEngine<BM,BN,KP,false>,E4>::type;
using E8=typename std::conditional<Kind==8,CcePackedStreamingEngine<BM,BN,KP>,E7>::type;
using E9=typename std::conditional<Kind==9,CceBufferedResidentEngine<BM,BN,KP,true>,E8>::type;
using E11=typename std::conditional<Kind==11,CceK1024Engine,E9>::type;
using E12=typename std::conditional<Kind==12,CceHalfKEngine,E11>::type;
using E13=typename std::conditional<Kind==13,CcePackedFourStageEngine<BM,BN,KP>,E12>::type;
using Engine=typename std::conditional<Kind==15,CceCachedResidentEngine<BM,BN,KP,true>,E13>::type;
Engine engine;
CceStorage memory;
auto input=reinterpret_cast<__gm__ int8_t*>(x);
if constexpr(Kind==8 || Kind==21)input=packedWeights+int64_t(p.e)*((p.k+31)&~31)*((p.n+31)&~31);
auto weight=Packed?packedWeights:reinterpret_cast<__gm__ int8_t*>(weights);
if constexpr(Kind==9 || Kind==15) {
engine.Init(memory,p,input,weight,coefficients,ends);
} else {
engine.Init(memory,p,input,weight);
if constexpr(Quant) {
engine.quantizedScales=coefficients;
engine.quantizedLocal=reinterpret_cast<__cbuf__ uint64_t*>(uint64_t(memory.l1));
}
}
if constexpr(Kind==8)engine.streamedWeights=streamed;
int produced=0;
bool active=traversal.Next(tile);
if constexpr(Packed) {
if(active && Kind!=8 && Kind!=21) {
engine.LoadA(tile,0,(Kind==13 || Kind==19)?p.k:(p.k<KP?p.k:KP));
engine.aPrefetched=true;
}
CceSignal<PIPE_MTE3,0>(6);wait_flag_dev(6);CceSignal<PIPE_MTE3,2>(4);if(!streamed)wait_flag_dev(5);
if constexpr(Quant)wait_flag_dev(5);
}
if(streamed && !active)for(int first=768;first<p.k;first+=3072) {
int region=(first-768)/3072;wait_flag_dev(region==0?5:region==1?7:1);
}
while(active) {
CceTile next;bool hasNext=traversal.Next(next);int slot=produced&1;
if constexpr(Kind==1 || Kind==2 || Kind==4 || Kind==5 || Kind==11 || Kind==12)
engine.Multiply(tile,scratch+slot*BM*BN,hasNext?&next:nullptr,produced>=2?2+slot:-1,slot);
else engine.Multiply(tile,scratch+slot*BM*BN,hasNext?&next:nullptr,produced>=2?2+slot:-1);
CceSignal<PIPE_FIX,2>(slot);
++produced;active=hasNext;if(hasNext)tile=next;
}
engine.Finish();
if(produced>=1)wait_flag_dev(2);
if(produced>=2)wait_flag_dev(3);
} else {
constexpr int ChunkRows=8192/BN,SlotBytes=8192*ElementBytes;
auto z=reinterpret_cast<__ubuf__ float*>(uint64_t(2*SlotBytes+256));
auto temporary=reinterpret_cast<__ubuf__ float*>(uint64_t(2*SlotBytes+32768+512));
auto factors=reinterpret_cast<__ubuf__ float*>(uint64_t(2*SlotBytes+98304+1024));
if constexpr(Kind==9 || Kind==13) {
asc_duplicate(reinterpret_cast<__ubuf__ half*>(uint64_t(185344)),half(0.07135481627260091f),16);
asc_duplicate(reinterpret_cast<__ubuf__ half*>(uint64_t(185600)),half(1.5957691216057308f),16);
pipe_barrier(PIPE_V);
}
if constexpr(Kind==19 || Kind==22)if(p.n<32) {
auto offsets=reinterpret_cast<__ubuf__ uint32_t*>(uint64_t(180224));
for(int row=0;row<(BM+1)/2;++row)
for(int col=0;col<p.n;++col)offsets[row*p.n+col]=(row*BN+col)*2;
set_flag(PIPE_S,PIPE_V,EVENT_ID0);wait_flag(PIPE_S,PIPE_V,EVENT_ID0);
}
int pending=0,consumed=0,expert=-1,column=-1;
bool factorsUsed=false;
while(traversal.Next(tile)) {
int slot=consumed++&1;
int halfRows=(tile.rows+1)/2,slice=asc_get_sub_block_id()*halfRows;
int rows=tile.rows-slice<halfRows?tile.rows-slice:halfRows;
int sourcePitch=Compact?CcePitch(tile.columns):BN;
int pitch=(tile.columns+31)&~31;
bool loadScale=!Quant && rows>0 && (expert!=tile.expert || column!=tile.column);
if(loadScale) {
if(factorsUsed) {set_flag(PIPE_V,PIPE_MTE2,EVENT_ID6);wait_flag(PIPE_V,PIPE_MTE2,EVENT_ID6);}
copy_gm_to_ubuf_align_b8(factors,reinterpret_cast<__gm__ float*>(scales)+int64_t(tile.expert)*p.n+tile.column,
0,1,tile.columns*4,0,0,0,0);
set_flag(PIPE_MTE2,PIPE_V,EVENT_ID6);
expert=tile.expert;column=tile.column;factorsUsed=true;
}
wait_flag_dev(slot);
if(rows<=0){CceSignal<PIPE_MTE2,2>(2+slot);continue;}
if(loadScale) {
wait_flag(PIPE_MTE2,PIPE_V,EVENT_ID6);
if constexpr(HalfInput) {
set_mask_count();set_vector_mask(0,tile.columns);
vmuls(factors,factors,512.0f,1,1,1,8,8);pipe_barrier(PIPE_V);
}
}
auto source=reinterpret_cast<__gm__ uint8_t*>(scratch+slot*BM*BN)+slice*sourcePitch*ElementBytes;
CcePrefetchChunk<ChunkRows,SlotBytes,ElementBytes,InputOffset>(source,0,rows,slot,sourcePitch,pitch,pending);
for(int part=0;part<rows;part+=ChunkRows) {
int stage=(slot+part/ChunkRows)&1,nr=rows-part<ChunkRows?rows-part:ChunkRows;
wait_flag(PIPE_MTE2,PIPE_V,static_cast<event_t>(stage));
if(part+nr<rows)CcePrefetchChunk<ChunkRows,SlotBytes,ElementBytes,InputOffset>(source,part+nr,rows,slot,sourcePitch,pitch,pending);
auto input=reinterpret_cast<__ubuf__ uint8_t*>(uint64_t(InputOffset+stage*SlotBytes));
auto out=reinterpret_cast<__ubuf__ half*>(input);
if constexpr(Kind==9) {
cce_symmetric_half_gelu(out,z,temporary,nr*pitch);
} else if constexpr(Kind==5 || Kind==15) {
cce_public_half_gelu(out,z,temporary,nr*pitch);
} else {
set_mask_count();set_vector_mask(0,nr*pitch);
if constexpr(HalfInput)vconv_f162f32(z,reinterpret_cast<__ubuf__ half*>(input),1,1,1,8,4);
else vconv_s322f32r(z,reinterpret_cast<__ubuf__ int32_t*>(input),1,1,1,8,8);
pipe_barrier(PIPE_V);
if constexpr(!Quant) {
set_mask_norm();
for(int col=0;col<pitch;col+=64) {
int width=pitch-col<64?pitch-col:64;
set_vector_mask(0,width==64?~uint64_t(0):(uint64_t(1)<<width)-1);
vmul(z+col,z+col,factors+col,nr,1,1,1,pitch/8,pitch/8,0);
}
pipe_barrier(PIPE_V);
}
if constexpr(Kind==13 || Kind==14) {
set_mask_count();set_vector_mask(0,nr*pitch);
vconv_f322f16r(out,z,1,1,1,4,8);pipe_barrier(PIPE_V);
if constexpr(Kind==13)cce_symmetric_half_gelu(out,z,temporary,nr*pitch);
else cce_public_half_gelu(out,z,temporary,nr*pitch);
} else cce_public_gelu_pingpong(z,temporary,out,nr*pitch);
}
auto writeOut=out;
int writeRows=nr,writeBytes=tile.columns*2;
int sourceStride=(pitch-tile.columns)/16,destinationStride=(p.n-tile.columns)*2;
if constexpr(Kind==19 || Kind==22)if(p.n<32) {
// Compact useful narrow columns before their contiguous GM write.
writeOut=reinterpret_cast<__ubuf__ half*>(input+SlotBytes/2);
pipe_barrier(PIPE_V);
set_mask_count();set_vector_mask(0,nr*p.n);
vgather(reinterpret_cast<__ubuf__ uint16_t*>(writeOut),
reinterpret_cast<__ubuf__ uint32_t*>(uint64_t(180224)),
reinterpret_cast<uint64_t>(out),8,1);
set_mask_norm();set_vector_mask(~uint64_t(0),~uint64_t(0));
writeRows=1;writeBytes=nr*p.n*2;sourceStride=0;destinationStride=0;
}
set_flag(PIPE_V,PIPE_MTE3,EVENT_ID0);wait_flag(PIPE_V,PIPE_MTE3,EVENT_ID0);
copy_ubuf_to_gm_align_b8(reinterpret_cast<__gm__ half*>(output)+int64_t(tile.row+slice+part)*p.n+tile.column,
writeOut,0,writeRows,writeBytes,0,0,sourceStride,destinationStride);
set_flag(PIPE_MTE3,PIPE_MTE2,static_cast<event_t>(stage));pending|=1<<stage;
}
}
for(int stage=0;stage<2;++stage)if(pending&(1<<stage))wait_flag(PIPE_MTE3,PIPE_MTE2,static_cast<event_t>(stage));
}
}
template<int BM,int BN,int Kind,int KP,int Mode,int Rotate=0>
void CceLaunch(GM_ADDR x,GM_ADDR w,GM_ADDR s,GM_ADDR g,GM_ADDR y,GmmPlan p,aclrtStream stream) {
constexpr bool Packed=Kind==7 || Kind==8 || Kind==9 || Kind==13 || Kind==14 || Kind==15 || Kind==19 || Kind==20 || Kind==21 || Kind==22;
constexpr bool Quant=Kind==1 || Kind==2 || Kind==5 || Kind==9 || Kind==12 || Kind==15;
size_t bytes=size_t(p.cores)*2*BM*BN*4;
if constexpr(Packed)bytes+=size_t(p.e)*((p.k+31)&~31)*((p.n+31)&~31);
if constexpr(Kind==8 || Kind==21)bytes+=size_t((p.m+15)&~15)*((p.k+31)&~31);
if constexpr(Quant)bytes+=size_t(p.e)*((p.n+31)&~31)*8;
void* workspace=nullptr;
if(aclrtMalloc(&workspace,bytes,ACL_MEM_MALLOC_HUGE_FIRST)!=ACL_SUCCESS)
throw std::runtime_error("CCE workspace allocation failed");
CceKernel<BM,BN,Kind,KP,Mode,Rotate><<<p.cores,nullptr,stream>>>(x,w,s,g,y,(GM_ADDR)workspace,p);
aclError status=aclrtSynchronizeStream(stream);aclrtFree(workspace);
if(status!=ACL_SUCCESS)throw std::runtime_error("CCE kernel execution failed");
}
}
extern "C" void run_kernel(
GM_ADDR x,const TensorGroupInfo& ix,GM_ADDR w,const TensorGroupInfo& iw,
GM_ADDR s,const TensorGroupInfo& is,GM_ADDR g,const TensorGroupInfo& ig,
GM_ADDR y,const TensorGroupInfo& iy,int64_t cores,aclrtStream stream)
{
GmmPlan p{};p.m=ix.tensors[0].shape[0];p.k=ix.tensors[0].shape[1];
p.e=iw.tensors[0].shape[0];p.n=iw.tensors[0].shape[2];p.cores=cores;
if(p.e>0 && p.cores>0) {
NativeRewrite::GmmPlan nativePlan{p.m,p.k,p.n,p.e,p.cores,0,0};
const int averageRows=(p.m+p.e-1)/p.e;
if(p.k>1024 && p.k<=1056 && p.n>1024 && p.n<=1056 && averageRows<=256) {
NativeRewrite::CceLaunch<80,384,14,704,4>(x,w,s,g,y,nativePlan,stream);return;
}
if(p.k>1024 && p.k<=1088 && p.n>768 && p.n<=800 && averageRows>80 && averageRows<=192) {
NativeRewrite::CceLaunch<96,320,7,576,3>(x,w,s,g,y,nativePlan,stream);return;
}
if(p.k>2048 && p.k<=8192 && p.n>512 && p.n<=544 && averageRows<=192) {
NativeRewrite::CceLaunch<96,256,8,768,6,1>(x,w,s,g,y,nativePlan,stream);return;
}
if(p.k>=768 && p.k<=1024 && p.n>512 && p.n<=768 && averageRows>=256) {
NativeRewrite::CceLaunch<128,256,9,512,4>(x,w,s,g,y,nativePlan,stream);return;
}
if(p.k>1024 && p.k<=1088 && p.n>768 && p.n<=800 && averageRows<=80) {
NativeRewrite::CceLaunch<80,384,13,192,5>(x,w,s,g,y,nativePlan,stream);return;
}
if(p.n>0 && p.n<=32 && p.k>2048 && p.k<=4096 && p.m>=128*p.cores) {
if(p.n==1)
NativeRewrite::CceLaunch<128,32,22,1536,2>(x,w,s,g,y,nativePlan,stream);
else if((128u+32u)*((p.k+31)&~31)<=512u*1024u)
NativeRewrite::CceLaunch<128,32,19,128,2>(x,w,s,g,y,nativePlan,stream);
else NativeRewrite::CceLaunch<96,32,19,128,2>(x,w,s,g,y,nativePlan,stream);
return;
}
const bool wideLongOutput=p.n>2048 && p.n<=4096 && p.m>=128*p.cores;
const bool mediumLongOutput=p.n>512 && p.n<=1024 && p.m>=2048 &&
int64_t((p.m+127)/128)*((p.n+255)/256)>=2*p.cores;
if(p.k>4096 && (mediumLongOutput || (wideLongOutput && p.m>=256*p.cores))) {
const auto platform=platform_ascendc::PlatformAscendCManager::GetInstance();
uint64_t l1=0;
platform->GetCoreMemSize(platform_ascendc::CoreMemType::L1,l1);
constexpr int panelK=640;
constexpr uint64_t panelBytes=2u*(128+256)*panelK;
if(panelBytes<=l1) {
if(wideLongOutput && p.n<4096)
NativeRewrite::CceLaunch<128,256,20,panelK,1>(x,w,s,g,y,nativePlan,stream);
else NativeRewrite::CceLaunch<128,256,20,panelK,0>(x,w,s,g,y,nativePlan,stream);
return;
}
}
if(p.k>4096 && (wideLongOutput || mediumLongOutput)) {
NativeRewrite::CceLaunch<128,256,20,512,0>(x,w,s,g,y,nativePlan,stream);return;
}
if(p.n>0 && p.n<=128 && p.k>2048 && p.k<=4096 && p.m>=16*p.cores) {
const auto platform=platform_ascendc::PlatformAscendCManager::GetInstance();
uint64_t l1=0;platform->GetCoreMemSize(platform_ascendc::CoreMemType::L1,l1);
const int columns=(p.n+31)&~31;
if(2u*128*256+uint64_t(columns)*((p.k+31)&~31)<=l1) {
if(columns<=64)NativeRewrite::CceLaunch<128,64,16,256,2>(x,w,s,g,y,nativePlan,stream);
else NativeRewrite::CceLaunch<128,128,16,256,2>(x,w,s,g,y,nativePlan,stream);
} else {
NativeRewrite::CceLaunch<128,128,0,512,0>(x,w,s,g,y,nativePlan,stream);
}
return;
}
if(p.n>2048 && p.k>1024 && p.k<=2048 && p.m>=128*p.cores) {
const auto platform=platform_ascendc::PlatformAscendCManager::GetInstance();
uint64_t l1=0;platform->GetCoreMemSize(platform_ascendc::CoreMemType::L1,l1);
const uint64_t paddedK=(p.k+31)&~31;
if(2u*112u*256u+256u*paddedK<=l1) {
NativeRewrite::CceLaunch<112,256,21,256,9>(x,w,s,g,y,nativePlan,stream);return;
}
if(2u*112u*256u+224u*paddedK<=l1) {
NativeRewrite::CceLaunch<112,224,21,256,9>(x,w,s,g,y,nativePlan,stream);return;
}
if(2u*112u*256u+192u*paddedK<=l1) {
NativeRewrite::CceLaunch<112,192,21,256,9>(x,w,s,g,y,nativePlan,stream);return;
}
}
constexpr int residentRows=128,residentColumns=256,residentPanelK=256;
if(p.n>2048 && p.k>1024 && p.k<=2048 && p.m/p.e>=2*residentRows &&
int64_t(p.e)*((p.n+residentColumns-1)/residentColumns)>=2*p.cores) {
const auto platform=platform_ascendc::PlatformAscendCManager::GetInstance();
uint64_t l1Capacity=0;
platform->GetCoreMemSize(platform_ascendc::CoreMemType::L1,l1Capacity);
const uint64_t l1Bytes=2u*residentRows*residentPanelK+
uint64_t(residentColumns)*((p.k+31)&~31);
if(l1Bytes<=l1Capacity) {
NativeRewrite::CceLaunch<residentRows,residentColumns,18,residentPanelK,3>(x,w,s,g,y,nativePlan,stream);
return;
}
constexpr int smallerResidentColumns=192;
const uint64_t smallerL1Bytes=2u*residentRows*residentPanelK+
uint64_t(smallerResidentColumns)*((p.k+31)&~31);
if(smallerL1Bytes<=l1Capacity) {
NativeRewrite::CceLaunch<residentRows,smallerResidentColumns,18,residentPanelK,3>(x,w,s,g,y,nativePlan,stream);
return;
}
}
if(p.k>=256 && p.n>=128 && (p.n>2048 || int64_t(p.m)*p.n>=4194304) &&
int64_t((p.m+127)/128)*((p.n+255)/256)>=p.cores) {
NativeRewrite::CceLaunch<128,256,0,512,0>(x,w,s,g,y,nativePlan,stream);return;
}
}
constexpr int smallCubeRows=16,smallCubeWidth=128;
const int smallCubeBlocks=p.m/smallCubeRows;
if(p.e==1 && p.m>=4*smallCubeRows && p.m%smallCubeRows==0 &&
p.k==smallCubeWidth && p.n==smallCubeWidth && smallCubeBlocks<=p.cores) {
void* temporary=nullptr;
if(aclrtMalloc(&temporary,size_t(p.m)*p.n*sizeof(int32_t),ACL_MEM_MALLOC_HUGE_FIRST)!=ACL_SUCCESS)
throw std::runtime_error("CCE small workspace allocation failed");
gmm_cce_small_cube<<<smallCubeBlocks,nullptr,stream>>>(x,w,s,y,(GM_ADDR)temporary);
aclError status=aclrtSynchronizeStream(stream);aclrtFree(temporary);
if(status!=ACL_SUCCESS)throw std::runtime_error("CCE small kernel execution failed");
return;
}
const int rowsPerExpert=(p.m+p.e-1)/p.e;
const bool completeKPanels=p.k%256==0;
if(completeKPanels && p.k>1024 && p.k<=2048 &&
p.n>=512 && p.n<=1024 && p.n%512==0 && rowsPerExpert<=64) {
if(p.cores>16)p.cores=16;
size_t size=size_t(p.cores)*2*64*512*4+size_t(p.e)*p.n*8;
void* temporary=nullptr;
if(aclrtMalloc(&temporary,size,ACL_MEM_MALLOC_HUGE_FIRST)!=ACL_SUCCESS)
throw std::runtime_error("CCE workspace allocation failed");
if(p.k==2048 && p.n==1024)
gmm_cce_public<64,512,2048,true,0,1024><<<p.cores,nullptr,stream>>>(x,w,s,g,y,(GM_ADDR)temporary,p);
else
gmm_cce_public<64,512,2048,true><<<p.cores,nullptr,stream>>>(x,w,s,g,y,(GM_ADDR)temporary,p);
aclError status=aclrtSynchronizeStream(stream);aclrtFree(temporary);
if(status!=ACL_SUCCESS)throw std::runtime_error("CCE kernel execution failed");
return;
}
if(completeKPanels && p.k>=768 && p.k<=1024 &&
p.n>=768 && p.n<=1024 && p.n%256==0 && rowsPerExpert>=96 && rowsPerExpert<=160) {
if(p.cores>16)p.cores=16;
size_t size=size_t(p.cores)*2*128*256*4+size_t(p.e)*p.n*8;
void* temporary=nullptr;
if(aclrtMalloc(&temporary,size,ACL_MEM_MALLOC_HUGE_FIRST)!=ACL_SUCCESS)
throw std::runtime_error("CCE workspace allocation failed");
if(p.k==1024 && p.n==1024)
gmm_cce_public<128,256,1024,true,2,1024><<<p.cores,nullptr,stream>>>(x,w,s,g,y,(GM_ADDR)temporary,p);
else
gmm_cce_public<128,256,1024,true,2><<<p.cores,nullptr,stream>>>(x,w,s,g,y,(GM_ADDR)temporary,p);
aclError status=aclrtSynchronizeStream(stream);aclrtFree(temporary);
if(status!=ACL_SUCCESS)throw std::runtime_error("CCE kernel execution failed");
return;
}
if(completeKPanels && p.k>1024 && p.k<=2048 &&
p.n>=512 && p.n<=768 && p.n%256==0 && rowsPerExpert>=96 && rowsPerExpert<=192) {
if(p.cores>16)p.cores=16;
size_t size=size_t(p.cores)*2*128*256*4+size_t(p.e)*p.n*8;
void* temporary=nullptr;
if(aclrtMalloc(&temporary,size,ACL_MEM_MALLOC_HUGE_FIRST)!=ACL_SUCCESS)
throw std::runtime_error("CCE workspace allocation failed");
if(p.k==2048 && p.n==768)
gmm_cce_public<128,256,2048,true,1,768><<<p.cores,nullptr,stream>>>(x,w,s,g,y,(GM_ADDR)temporary,p);
else
gmm_cce_public<128,256,2048,true,1><<<p.cores,nullptr,stream>>>(x,w,s,g,y,(GM_ADDR)temporary,p);
aclError status=aclrtSynchronizeStream(stream);aclrtFree(temporary);
if(status!=ACL_SUCCESS)throw std::runtime_error("CCE kernel execution failed");
return;
}
if (int64_t(p.m)*p.n==1 && p.k==1) {
gmm_scalar_output<<<1,nullptr,stream>>>(x,w,s,g,y,p.e);
return;
}
if(p.k<=4 && p.n>2048) {
const int columns=(p.n+1023)/1024;
const int slab=((p.n+columns-1)/columns+31)&~31;
const int vectorCores=platform_ascendc::PlatformAscendCManager::GetInstance()->GetCoreNumAiv();
const int available=vectorCores/columns,rowLanes=p.m<available?p.m:available;
gmm_wide_short_k<<<rowLanes*columns,nullptr,stream>>>(x,w,s,g,y,p.m,p.k,p.n,p.e,rowLanes,slab);
return;
}
if((int64_t)p.m*p.n<=128 && p.k<=64 && (int64_t)p.e*p.k*p.n<=8192) {
if((int64_t)p.m*p.k+(int64_t)p.e*p.k*p.n<=256 && p.e<=512) {
constexpr int DirectGroupLimit=8;
if(p.e<=DirectGroupLimit)
gmm_tiny_vector<true><<<1,nullptr,stream>>>(x,w,s,g,y,p.m,p.k,p.n,p.e);
else
gmm_tiny_vector<false><<<1,nullptr,stream>>>(x,w,s,g,y,p.m,p.k,p.n,p.e);
} else {
int count=p.m*p.n;
int span=(count+7)/8;
int blocks=(count+span-1)/span;
gmm_tiny_parallel<<<blocks,nullptr,stream>>>(x,w,s,g,y,p.m,p.k,p.n,p.e);
}
return;
}
if(p.e==1 && p.m>=smallCubeRows && p.m<=4*smallCubeRows && p.m%smallCubeRows==0 &&
p.k==smallCubeWidth && p.n==smallCubeWidth && smallCubeBlocks<=p.cores) {
void* temporary=nullptr;
if(aclrtMalloc(&temporary,p.m*p.n*sizeof(int32_t),ACL_MEM_MALLOC_HUGE_FIRST)!=ACL_SUCCESS)
throw std::runtime_error("Small Cube workspace allocation failed");
gmm_small_single_cube<<<smallCubeBlocks,nullptr,stream>>>(x,w,s,y,(GM_ADDR)temporary);
aclError status=aclrtSynchronizeStream(stream);
aclrtFree(temporary);
if(status!=ACL_SUCCESS)throw std::runtime_error("Small Cube execution failed");
return;
}
auto vectorPlatform=platform_ascendc::PlatformAscendCManager::GetInstance();
int vectorCores=vectorPlatform->GetCoreNumAiv();
int rowsPerVectorCore=(p.m+vectorCores-1)/vectorCores;
if(p.m<=128 && p.n>=64 && p.n<=128 && p.n%64==0 &&
p.k>=64 && p.k<=128 && (p.k&(p.k-1))==0 && rowsPerVectorCore<=4) {
int blocks=(p.m+rowsPerVectorCore-1)/rowsPerVectorCore;
gmm_small_vector_reduce<<<blocks,nullptr,stream>>>(
x,w,s,g,y,p.m,p.k,p.n,p.e,rowsPerVectorCore);
return;
}
auto platform=platform_ascendc::PlatformAscendCManager::GetInstance();
uint64_t l1Capacity=0;
platform->GetCoreMemSize(platform_ascendc::CoreMemType::L1,l1Capacity);
int tileM=64,tileN=p.n<=128?128:256;
if(tileN==128 && p.m<=128) {
tileM=16;
bool directSmall=p.n>=32 && p.n%32==0 && p.k>=128 && p.k<=512 && p.k%128==0;
if(directSmall && p.m/p.e>=32)tileM=32;
}
int averageRows=p.m/p.e;
bool shortNarrow=p.m<=128 && p.n<=128 && p.k>=64 && p.k<=256;
bool alignedShortRows=p.n%256==0 && p.k>=1024 && p.k<=1536 &&
averageRows<=64;
const bool stagedShortRows=p.n>=768 && p.n<=1024 && p.n%256==0 &&
p.k>=768 && p.k<=1024 && p.k%256==0 && averageRows<=64 &&
l1Capacity>=65536u+2u*196608;
bool alignedHalfK=p.n>=512 && p.n%256==0 && p.k>=384 && p.k<768 &&
averageRows<=64;
constexpr int stagedFullColumns=512,stagedTailColumns=256;
const bool stagedHalfK=p.n==stagedFullColumns+stagedTailColumns &&
p.k>=384 && p.k<=512 && p.k%128==0 && averageRows<=64;
if(tileN==256 && averageRows>=65) {
int wideTiles=((averageRows+63)/64)*((p.n+255)/256);
int tallTiles=((averageRows+127)/128)*((p.n+127)/128);
if(p.n%256!=0 && (int64_t)tallTiles*256<(int64_t)wideTiles*320) {
tileM=128;tileN=128;
}
}
bool tallMidRange=p.k%128==0 && p.k>=512 && p.k<=1536 &&
p.n%256==0 && p.n>=512 && p.n<=1024 &&
averageRows>=96 && averageRows<=192;
if(tallMidRange){tileM=128;tileN=256;}
if(p.n%256==0 && p.k>=1536 && p.k%32==0 && averageRows>=128 &&
((averageRows+127)/128)*128==((averageRows+63)/64)*64) {
tileM=128;tileN=256;
}
uint64_t residentAL1Bytes=(uint64_t)128*2048+
(uint64_t)2*384*256;
bool residentARange=tileM==128 && tileN==256 &&
p.k%512==0 && p.k>=1024 && p.k<=2048 &&
p.n%256==0 && p.n>=768 && p.n<=1024 &&
averageRows>=96 && averageRows<=192 &&
residentAL1Bytes<=l1Capacity;
if(residentARange && p.k>=1536 && averageRows<=128 && p.cores>p.e)
p.cores=p.e;
else if(residentARange && p.cores>p.e*2)p.cores=p.e*2;
bool widePanel=p.n>=1024 && p.n%512==0 && p.k>=1536 &&
!tallMidRange && !residentARange;
if(widePanel) {
tileM=averageRows>=128?128:64;
tileN=averageRows>=128?256:512;
if(averageRows>=32 && averageRows<=tileM && tileN==512 &&
p.e<p.cores && 4*p.e>=3*p.cores &&
p.k%256==0 && p.k<=2048 &&
uint64_t(64)*2048+2u*256*512<=l1Capacity)
p.cores=p.e;
}
const bool alignedMediumLong=p.k>4096 && p.n>640 && p.n<=1024 && p.n%256==0;
bool raggedLong=p.k>=4096 && p.n>256 && p.n<=1024 &&
(p.n%256!=0 || alignedMediumLong);
bool raggedLongCompact=raggedLong && p.n>512 && p.n<=640 &&
averageRows>=96 && averageRows<=256;
bool raggedMid=p.k>=768 && p.k<2048 && p.n>512 && p.n<=1280 &&
p.n%128!=0 && averageRows>=64;
bool raggedMidMedium=raggedMid && averageRows>=128 && averageRows<256;
bool raggedMidWide=raggedMid && averageRows>=256;
bool raggedMidTall=raggedMid && averageRows<128;
bool narrowTall=p.k>=512 && p.k<768 && p.n>256 && p.n<=512 &&
