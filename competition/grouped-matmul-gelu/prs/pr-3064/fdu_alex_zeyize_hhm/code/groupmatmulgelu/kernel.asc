}
int alignedRows=(tile.rows+15)&~15;
int alignedColumns=K32MajorWeights?((tile.columns+31)&~31):((tile.columns+15)&~15);
bool paddedCompletion=PaddedCompletion && tile.rows==alignedRows &&
alignedColumns%32==0;
bool unitFlags=!LateWorkspaceWait &&
