0,(256-2*step)/32,32,tile.columns,32*768,768,32,1,32*tile.columns);
set_flag(PIPE_MTE2,PIPE_MTE1,static_cast<event_t>(2+slot));
}
__aicore__ inline void LoadOperands(CceTile tile,__cbuf__ int8_t* b,
int reductionOffset,int inner,int count,int alignedRows,int slot) {
wait_flag(PIPE_M,PIPE_MTE1,static_cast<event_t>(slot));
auto left=reinterpret_cast<__ca__ int8_t*>(uint64_t(slot*8192));
auto right=reinterpret_cast<__cb__ int8_t*>(uint64_t(slot*32768));
asc_copy_l12l0a(left,reinterpret_cast<__cbuf__ int8_t*>(uint64_t(0)),
count,alignedRows,reductionOffset,0,1,1,1,1,1,1,false,false,false,false,512);
load_cbuf_to_cb_transpose(right,b+inner*tile.columns,0,
(count/32)*(tile.columns/32),1,1,false,0);
set_flag(PIPE_MTE1,PIPE_M,static_cast<event_t>(slot));
}
__aicore__ inline void Multiply(CceTile tile,__gm__ int32_t* target,
const CceTile* nextTile,int reuseEvent=-1,int readySlot=0) {
if(reuseEvent>=0)wait_flag_dev(reuseEvent);
const int alignedRows=(tile.rows+15)&~15;
if(tile.expert!=activationExpert || tile.row!=activationRow) {
if(activationExpert>=0)set_flag(PIPE_MTE1,PIPE_MTE2,EVENT_ID0);
wait_flag(PIPE_MTE1,PIPE_MTE2,EVENT_ID0);
copy_gm_to_cbuf_multi_nd2nz_b8(reinterpret_cast<__cbuf__ int8_t*>(uint64_t(0)),
input+int64_t(tile.row)*512,0,1,tile.rows,512,0,512,alignedRows,1,0);
set_flag(PIPE_MTE2,PIPE_MTE1,EVENT_ID0);
wait_flag(PIPE_MTE2,PIPE_MTE1,EVENT_ID0);
activationExpert=tile.expert;activationRow=tile.row;
}
if(!prefetched)LoadB(tile,0);
prefetched=false;
wait_flag(PIPE_FIX,PIPE_M,EVENT_ID0);
auto accumulator=reinterpret_cast<__cc__ int32_t*>(uint64_t(0));
asc_l13d_fmatrix_config matrix{};
matrix.config=(uint64_t(1)<<16)|alignedRows;
asc_set_l13d_fmatrix(matrix);
const int step=tile.columns>256?64:128;
for(int panel=0;panel<512;panel+=256) {
const int stage=readSlot;readSlot^=1;
auto b=reinterpret_cast<__cbuf__ int8_t*>(uint64_t(32768+stage*131072));
wait_flag(PIPE_MTE2,PIPE_MTE1,static_cast<event_t>(4+stage));
if(panel==0)LoadB(tile,256);
else if(nextTile){LoadB(*nextTile,0);prefetched=true;}
LoadOperands(tile,b,panel,0,step,alignedRows,operandSlot);
for(int inner=0;inner<256;inner+=step) {
const int slot=operandSlot;operandSlot^=1;
wait_flag(PIPE_MTE1,PIPE_M,static_cast<event_t>(slot));
mad(accumulator,reinterpret_cast<__ca__ int8_t*>(uint64_t(slot*8192)),
reinterpret_cast<__cb__ int8_t*>(uint64_t(slot*32768)),
alignedRows,step,(tile.columns+15)&~15,0,false,false,panel==0 && inner==0);
set_flag(PIPE_M,PIPE_MTE1,static_cast<event_t>(slot));
const int next=inner+step;
if(next<256) {
if(next==step)wait_flag(PIPE_MTE2,PIPE_MTE1,static_cast<event_t>(6+stage));
else if(next==2*step)wait_flag(PIPE_MTE2,PIPE_MTE1,static_cast<event_t>(2+stage));
LoadOperands(tile,b,panel+next,next,step,alignedRows,operandSlot);
}
if(tile.rows!=64)pipe_barrier(PIPE_M);
}
if(256<=2*step)wait_flag(PIPE_MTE2,PIPE_MTE1,static_cast<event_t>(2+stage));
set_flag(PIPE_MTE1,PIPE_MTE2,static_cast<event_t>(2+stage));
}
set_flag(PIPE_M,PIPE_FIX,EVENT_ID0);wait_flag(PIPE_M,PIPE_FIX,EVENT_ID0);
if(!coefficientsReady){wait_flag_dev(5);coefficientsReady=true;}
if(coefficientExpert!=tile.expert) {
if(coefficientExpert>=0) {
set_flag(PIPE_FIX,PIPE_MTE2,EVENT_ID7);wait_flag(PIPE_FIX,PIPE_MTE2,EVENT_ID7);
}
asc_copy_gm2l1(reinterpret_cast<__cbuf__ int8_t*>(quantizedLocal),
reinterpret_cast<__gm__ int8_t*>(quantizedScales+int64_t(tile.expert)*768),
1,768/4,0,0);
set_flag(PIPE_MTE2,PIPE_FIX,EVENT_ID7);wait_flag(PIPE_MTE2,PIPE_FIX,EVENT_ID7);
coefficientExpert=tile.expert;
}
for(int column=0;column<tile.columns;column+=256) {
const int columns=tile.columns-column<256?tile.columns-column:256;
asc_copy_l12fb(reinterpret_cast<__fbuf__ void*>(uint64_t(0)),
reinterpret_cast<__cbuf__ void*>(quantizedLocal+tile.column+column),
1,((columns+31)&~31)/16,0,0);
pipe_barrier(PIPE_FIX);
asc_set_l0c_copy_params(1,0,0);asc_set_l0c2gm_config(0,0,true);
copy_matrix_cc_to_gm(reinterpret_cast<__gm__ half*>(target)+column,
accumulator+column*alignedRows,0,columns,tile.rows,
CcePitch(tile.columns),alignedRows,0,
QuantMode_t::VDEQF16,0,false,true);
pipe_barrier(PIPE_FIX);
}
set_flag(PIPE_FIX,PIPE_M,EVENT_ID0);
}
__aicore__ inline void Finish() {
if(activationExpert>=0)set_flag(PIPE_MTE1,PIPE_MTE2,EVENT_ID0);
wait_flag(PIPE_MTE1,PIPE_MTE2,EVENT_ID0);
wait_flag(PIPE_MTE1,PIPE_MTE2,EVENT_ID2);
wait_flag(PIPE_MTE1,PIPE_MTE2,EVENT_ID3);
for(int slot=0;slot<2;++slot) {
wait_flag(PIPE_M,PIPE_MTE1,static_cast<event_t>(slot));
}
wait_flag(PIPE_FIX,PIPE_M,EVENT_ID0);
}
};
template<int BM,int BN,int K,int N,bool Quant>
struct CceShortEngine {
__gm__ int8_t* input;__gm__ int8_t* weights;
__gm__ uint64_t* quantizedScales=nullptr;
__cbuf__ uint64_t* quantizedLocal=nullptr;
int tileIndex=0,operandSlot=0;
bool prefetched=false;
__aicore__ inline void Init(CceStorage& memory,GmmPlan,
__gm__ int8_t* a,__gm__ int8_t* b) {
input=a;weights=b;memory.l1=2*BM*K+2*K*BN;
for(int slot=0;slot<2;++slot) {
set_flag(PIPE_MTE1,PIPE_MTE2,static_cast<event_t>(slot));
set_flag(PIPE_M,PIPE_MTE1,static_cast<event_t>(slot));
set_flag(PIPE_FIX,PIPE_M,static_cast<event_t>(slot));
}
}
__aicore__ inline void LoadTile(CceTile tile,int slot) {
wait_flag(PIPE_MTE1,PIPE_MTE2,static_cast<event_t>(slot));
auto a=reinterpret_cast<__cbuf__ int8_t*>(uint64_t(slot*BM*K));
auto b=reinterpret_cast<__cbuf__ int8_t*>(uint64_t(2*BM*K+slot*K*BN));
copy_gm_to_cbuf_multi_nd2nz_b8(a,input+int64_t(tile.row)*K,0,1,tile.rows,K,0,K,
(tile.rows+15)&~15,1,0);
copy_gm_to_cbuf_multi_nd2nz_b8(b,weights+(int64_t(tile.expert)*K)*N+tile.column,
0,K/32,32,tile.columns,32*N,N,32,1,32*tile.columns);
set_flag(PIPE_MTE2,PIPE_MTE1,static_cast<event_t>(slot));
}
__aicore__ inline void Multiply(CceTile tile,__gm__ int32_t* target,
const CceTile* nextTile,int reuseEvent=-1,int readySlot=0) {
const int slot=tileIndex++&1,alignedRows=(tile.rows+15)&~15;
if(!prefetched)LoadTile(tile,slot);
wait_flag(PIPE_MTE2,PIPE_MTE1,static_cast<event_t>(slot));
prefetched=nextTile!=nullptr;
if(nextTile)LoadTile(*nextTile,slot^1);
wait_flag(PIPE_FIX,PIPE_M,static_cast<event_t>(slot));
auto accumulator=reinterpret_cast<__cc__ int32_t*>(uint64_t(slot*BM*BN*4));
auto a=reinterpret_cast<__cbuf__ int8_t*>(uint64_t(slot*BM*K));
auto b=reinterpret_cast<__cbuf__ int8_t*>(uint64_t(2*BM*K+slot*K*BN));
set_fmatrix((uint64_t(1)<<16)|alignedRows);
constexpr bool unitCompletion=false;
if(unitCompletion)asc_set_mmad_direction_n();
for(int inner=0;inner<K;inner+=128) {
int stage=operandSlot;operandSlot^=1;
wait_flag(PIPE_M,PIPE_MTE1,static_cast<event_t>(stage));
auto left=reinterpret_cast<__ca__ int8_t*>(uint64_t(stage*BM*128));
auto right=reinterpret_cast<__cb__ int8_t*>(uint64_t(stage*128*BN));
asc_copy_l12l0a(left,a,128,alignedRows,inner,0,1,1,1,1,1,1,false,false,false,false,K);
load_cbuf_to_cb_transpose(right,b+inner*tile.columns,0,4*(tile.columns/32),1,1,false,0);
set_flag(PIPE_MTE1,PIPE_M,static_cast<event_t>(stage));
wait_flag(PIPE_MTE1,PIPE_M,static_cast<event_t>(stage));
mad(accumulator,left,right,alignedRows,128,(tile.columns+15)&~15,
unitCompletion?(inner+128==K?3:2):0,false,false,inner==0);
set_flag(PIPE_M,PIPE_MTE1,static_cast<event_t>(stage));
}
set_flag(PIPE_MTE1,PIPE_MTE2,static_cast<event_t>(slot));
if(!unitCompletion){set_flag(PIPE_M,PIPE_FIX,static_cast<event_t>(slot));wait_flag(PIPE_M,PIPE_FIX,static_cast<event_t>(slot));}
if(reuseEvent>=0)wait_flag_dev(reuseEvent);
asc_set_l0c_copy_params(1,0,0);asc_set_l0c2gm_config(0,0,true);
copy_matrix_cc_to_gm(target,accumulator,0,tile.columns,tile.rows,BN,alignedRows,
unitCompletion?3:0,static_cast<QuantMode_t>(0),0,false,true);
set_flag(PIPE_FIX,PIPE_M,static_cast<event_t>(slot));
}
__aicore__ inline void Finish() {
for(int slot=0;slot<2;++slot) {
wait_flag(PIPE_MTE1,PIPE_MTE2,static_cast<event_t>(slot));
wait_flag(PIPE_M,PIPE_MTE1,static_cast<event_t>(slot));
wait_flag(PIPE_FIX,PIPE_M,static_cast<event_t>(slot));
}
}
};
template<int BM,int BN,int KP,bool LateWait>
struct CcePackedResidentEngine {
__gm__ int8_t* input;
__gm__ int8_t* weights;
GmmPlan plan;
int writeSlot=0,readSlot=0,operandSlot=0;
int weightExpert=-1,weightColumn=-1;
bool aPrefetched=false,bPrefetched=false,streamedWeights=false;
__aicore__ inline __cbuf__ int8_t* Activation(int slot) {
return reinterpret_cast<__cbuf__ int8_t*>(uint64_t(slot*BM*KP));
}
__aicore__ inline __cbuf__ int8_t* Weight() {
return reinterpret_cast<__cbuf__ int8_t*>(uint64_t(2*BM*KP));
}
__aicore__ inline void Init(CceStorage& memory,GmmPlan p,
__gm__ int8_t* a,__gm__ int8_t* b) {
plan=p;input=a;weights=b;
if constexpr(!LateWait)asc_set_l0c2gm_config(0,0,true);
memory.l1=2*BM*KP+BN*((p.k+31)&~31);
set_flag(PIPE_MTE1,PIPE_MTE2,EVENT_ID0);
set_flag(PIPE_MTE1,PIPE_MTE2,EVENT_ID1);
set_flag(PIPE_MTE1,PIPE_MTE2,EVENT_ID2);
set_flag(PIPE_M,PIPE_MTE1,EVENT_ID0);
set_flag(PIPE_M,PIPE_MTE1,EVENT_ID1);
if constexpr(LateWait)set_flag(PIPE_FIX,PIPE_M,EVENT_ID0);
}
__aicore__ inline void LoadA(CceTile tile,int panel,int count) {
int slot=writeSlot;writeSlot^=1;
wait_flag(PIPE_MTE1,PIPE_MTE2,static_cast<event_t>(slot));
copy_gm_to_cbuf_multi_nd2nz_b8(Activation(slot),input+int64_t(tile.row)*plan.k+panel,
0,1,tile.rows,count,0,plan.k,(tile.rows+15)&~15,1,0);
set_flag(PIPE_MTE2,PIPE_MTE1,static_cast<event_t>(slot));
}
__aicore__ inline void CopyWeight(CceTile tile,int panel,int count) {
int paddedK=(plan.k+31)&~31;
int paddedN=(plan.n+31)&~31;
int columns=(tile.columns+31)&~31;
auto source=weights+(int64_t(tile.expert)*paddedK+panel)*paddedN+tile.column*32;
copy_gm_to_cbuf(Weight()+panel*columns,source,0,(count+31)/32,
columns,paddedN-columns,0,static_cast<pad_t>(0));
}
__aicore__ inline void LoadOperands(CceTile tile,__cbuf__ int8_t* a,
int panel,int inner,int count,int panelStride,int alignedRows,int columns) {
int slot=operandSlot;
wait_flag(PIPE_M,PIPE_MTE1,static_cast<event_t>(slot));
auto left=reinterpret_cast<__ca__ int8_t*>(uint64_t(slot*BM*64));
auto right=reinterpret_cast<__cb__ int8_t*>(uint64_t(slot*BN*64));
asc_copy_l12l0a(left,a,count,alignedRows,inner,0,
1,1,1,1,1,1,false,false,false,false,panelStride);
load_cbuf_to_cb_transpose(right,Weight()+(panel+inner)*columns,0,
(count/32)*(columns/32),1,1,false,0);
set_flag(PIPE_MTE1,PIPE_M,static_cast<event_t>(slot));
}
__aicore__ inline void Multiply(CceTile tile,__gm__ int32_t* target,
const CceTile* nextTile,int reuseEvent=-1) {
int alignedRows=(tile.rows+15)&~15;
int columns=(tile.columns+31)&~31;
bool unitFlags=!LateWait;
if(unitFlags)asc_set_mmad_direction_n();
set_fmatrix((uint64_t(1)<<16)|alignedRows);
bool usingPrefetchedB=bPrefetched;
if(tile.expert!=weightExpert || tile.column!=weightColumn) {
if(!usingPrefetchedB) {
wait_flag(PIPE_MTE1,PIPE_MTE2,EVENT_ID2);
CopyWeight(tile,0,plan.k);
set_flag(PIPE_MTE2,PIPE_MTE1,EVENT_ID2);
wait_flag(PIPE_MTE2,PIPE_MTE1,EVENT_ID2);
}
weightExpert=tile.expert;weightColumn=tile.column;
}
bPrefetched=false;
int initial=plan.k<KP?plan.k:KP;
if(!aPrefetched)LoadA(tile,0,initial);
aPrefetched=false;
if constexpr(LateWait)wait_flag(PIPE_FIX,PIPE_M,EVENT_ID0);
auto accumulator=reinterpret_cast<__cc__ int32_t*>(uint64_t(0));
bool prefetchNextB=BM==80 && nextTile && plan.k<=2*KP &&
(nextTile->expert!=tile.expert || nextTile->column!=tile.column) &&
((nextTile->columns+31)&~31)==columns;
for(int panel=0;panel<plan.k;panel+=KP) {
int count=plan.k-panel<KP?plan.k-panel:KP;
int paddedCount=(count+31)&~31;
int aSlot=readSlot;readSlot^=1;
wait_flag(PIPE_MTE2,PIPE_MTE1,static_cast<event_t>(aSlot));
if(usingPrefetchedB)wait_flag(PIPE_MTE2,PIPE_MTE1,static_cast<event_t>(6+panel/KP));
auto localA=Activation(aSlot);
if(panel+count<plan.k)LoadA(tile,panel+count,plan.k-panel-count<KP?plan.k-panel-count:KP);
else if(nextTile){LoadA(*nextTile,0,initial);aPrefetched=true;}
LoadOperands(tile,localA,panel,0,paddedCount<64?paddedCount:64,paddedCount,alignedRows,columns);
for(int inner=0;inner<paddedCount;inner+=64) {
int reduction=paddedCount-inner<64?paddedCount-inner:64;
int slot=operandSlot;operandSlot^=1;
wait_flag(PIPE_MTE1,PIPE_M,static_cast<event_t>(slot));
if(prefetchNextB && inner+reduction>=paddedCount) {
event_t event=static_cast<event_t>(4+panel/KP);
set_flag(PIPE_MTE1,PIPE_MTE2,event);wait_flag(PIPE_MTE1,PIPE_MTE2,event);
CopyWeight(*nextTile,panel,count);
set_flag(PIPE_MTE2,PIPE_MTE1,static_cast<event_t>(6+panel/KP));
if(panel+count>=plan.k)bPrefetched=true;
}
bool final=panel+count>=plan.k && inner+reduction>=paddedCount;
mad(accumulator,reinterpret_cast<__ca__ int8_t*>(uint64_t(slot*BM*64)),
reinterpret_cast<__cb__ int8_t*>(uint64_t(slot*BN*64)),
alignedRows,reduction,columns,unitFlags?(final?3:2):0,
false,false,panel==0 && inner==0);
set_flag(PIPE_M,PIPE_MTE1,static_cast<event_t>(slot));
int next=inner+64;
if(next<paddedCount)
LoadOperands(tile,localA,panel,next,paddedCount-next<64?paddedCount-next:64,
paddedCount,alignedRows,columns);
if(!unitFlags && (alignedRows/16)*(columns/16)<10)pipe_barrier(PIPE_M);
}
set_flag(PIPE_MTE1,PIPE_MTE2,static_cast<event_t>(aSlot));
}
bool changesWeight=!nextTile || nextTile->expert!=tile.expert || nextTile->column!=tile.column;
if(changesWeight && !prefetchNextB)set_flag(PIPE_MTE1,PIPE_MTE2,EVENT_ID2);
if(!unitFlags){set_flag(PIPE_M,PIPE_FIX,EVENT_ID0);wait_flag(PIPE_M,PIPE_FIX,EVENT_ID0);}
if(reuseEvent>=0)wait_flag_dev(reuseEvent);
asc_set_l0c_copy_prequant(uint64_t(0x3b000000));
asc_set_l0c_copy_params(1,0,0);asc_set_l0c2gm_config(0,0,LateWait);
copy_matrix_cc_to_gm(reinterpret_cast<__gm__ half*>(target),accumulator,
0,unitFlags?columns:tile.columns,unitFlags?alignedRows:tile.rows,BN,alignedRows,unitFlags?3:0,QuantMode_t::DEQF16,0,false,true);
if constexpr(LateWait)set_flag(PIPE_FIX,PIPE_M,EVENT_ID0);
}
__aicore__ inline void Finish() {
wait_flag(PIPE_MTE1,PIPE_MTE2,EVENT_ID0);
wait_flag(PIPE_MTE1,PIPE_MTE2,EVENT_ID1);
wait_flag(PIPE_MTE1,PIPE_MTE2,EVENT_ID2);
wait_flag(PIPE_M,PIPE_MTE1,EVENT_ID0);
wait_flag(PIPE_M,PIPE_MTE1,EVENT_ID1);
if constexpr(!LateWait)set_flag(PIPE_FIX,PIPE_M,EVENT_ID0);
wait_flag(PIPE_FIX,PIPE_M,EVENT_ID0);
}
};
template<int BM,int BN,int KP,bool LateWait>
struct CceBufferedResidentEngine {
__gm__ int8_t* input;
__gm__ int8_t* weights;
GmmPlan plan;
int writeSlot=0,readSlot=0,operandSlot=0;
__gm__ uint64_t* quantizedScales;
__cbuf__ uint64_t* quantizedLocal;
int coefficientReadyEvent=-1,coefficientExpert=-1,coefficientColumn=-1;
int weightExpert=-1,weightColumn=-1;
bool aPrefetched=false,bPrefetched=false,streamedWeights=false,previousUnit=false;
__aicore__ inline __cbuf__ int8_t* Activation(int slot) {
return reinterpret_cast<__cbuf__ int8_t*>(uint64_t(slot*BM*KP));
}
__aicore__ inline __cbuf__ int8_t* Weight() {
return reinterpret_cast<__cbuf__ int8_t*>(uint64_t(2*BM*KP));
}
__aicore__ inline void Init(CceStorage& memory,GmmPlan p,
__gm__ int8_t* a,__gm__ int8_t* b,__gm__ uint64_t* scales,__gm__ int64_t* ends) {
plan=p;input=a;weights=b;
asc_set_l0c2gm_config(0,0,true);
memory.l1=2*BM*KP+BN*((p.k+31)&~31);
quantizedScales=scales;
quantizedLocal=reinterpret_cast<__cbuf__ uint64_t*>(uint64_t(memory.l1));
memory.l1+=BN*8;
set_flag(PIPE_MTE1,PIPE_MTE2,EVENT_ID0);
set_flag(PIPE_MTE1,PIPE_MTE2,EVENT_ID1);
set_flag(PIPE_MTE1,PIPE_MTE2,EVENT_ID2);
set_flag(PIPE_M,PIPE_MTE1,EVENT_ID0);
set_flag(PIPE_M,PIPE_MTE1,EVENT_ID1);
}
__aicore__ inline void LoadCoefficients(CceTile tile) {
if(coefficientReadyEvent>=0){wait_flag_dev(coefficientReadyEvent);coefficientReadyEvent=-1;}
if(tile.expert==coefficientExpert && tile.column==coefficientColumn)return;
if(coefficientExpert>=0)wait_flag(PIPE_FIX,PIPE_MTE2,EVENT_ID7);
int columns=(tile.columns+31)&~31;
copy_gm_to_cbuf(reinterpret_cast<__cbuf__ int8_t*>(quantizedLocal),
reinterpret_cast<__gm__ int8_t*>(quantizedScales+int64_t(tile.expert)*((plan.n+31)&~31)+tile.column),
0,1,columns/4,0,0,static_cast<pad_t>(0));
set_flag(PIPE_MTE2,PIPE_FIX,EVENT_ID7);wait_flag(PIPE_MTE2,PIPE_FIX,EVENT_ID7);
asc_copy_l12fb(reinterpret_cast<__fbuf__ void*>(uint64_t(0)),
reinterpret_cast<__cbuf__ void*>(quantizedLocal),1,columns/16,0,0);
pipe_barrier(PIPE_FIX);
set_flag(PIPE_FIX,PIPE_MTE2,EVENT_ID7);
coefficientExpert=tile.expert;coefficientColumn=tile.column;
}
__aicore__ inline void LoadA(CceTile tile,int panel,int count) {
int slot=writeSlot;writeSlot^=1;
wait_flag(PIPE_MTE1,PIPE_MTE2,static_cast<event_t>(slot));
copy_gm_to_cbuf_multi_nd2nz_b8(Activation(slot),input+int64_t(tile.row)*plan.k+panel,
0,1,tile.rows,count,0,plan.k,(tile.rows+15)&~15,1,0);
set_flag(PIPE_MTE2,PIPE_MTE1,static_cast<event_t>(slot));
}
__aicore__ inline void CopyWeight(CceTile tile,int panel,int count) {
int paddedK=(plan.k+31)&~31;
int paddedN=(plan.n+31)&~31;
int columns=(tile.columns+31)&~31;
auto source=weights+(int64_t(tile.expert)*paddedK+panel)*paddedN+tile.column*32;
copy_gm_to_cbuf(Weight()+panel*columns,source,0,(count+31)/32,
columns,paddedN-columns,0,static_cast<pad_t>(0));
}
__aicore__ inline void LoadOperands(CceTile tile,__cbuf__ int8_t* a,
int panel,int inner,int count,int panelStride,int alignedRows,int columns) {
int slot=operandSlot;
wait_flag(PIPE_M,PIPE_MTE1,static_cast<event_t>(slot));
auto left=reinterpret_cast<__ca__ int8_t*>(uint64_t(slot*BM*128));
auto right=reinterpret_cast<__cb__ int8_t*>(uint64_t(slot*BN*128));
asc_copy_l12l0a(left,a,count,alignedRows,inner,0,
1,1,1,1,1,1,false,false,false,false,panelStride);
load_cbuf_to_cb_transpose(right,Weight()+(panel+inner)*columns,0,
(count/32)*(columns/32),1,1,false,0);
set_flag(PIPE_MTE1,PIPE_M,static_cast<event_t>(slot));
}
__aicore__ inline void Multiply(CceTile tile,__gm__ int32_t* target,
const CceTile* nextTile,int reuseEvent=-1) {
if constexpr(!LateWait)if(reuseEvent>=0)wait_flag_dev(reuseEvent);
LoadCoefficients(tile);
int alignedRows=(tile.rows+15)&~15;
int columns=(tile.columns+31)&~31;
bool unitFlags=tile.rows==alignedRows;
if(unitFlags)asc_set_mmad_direction_n();
set_fmatrix((uint64_t(1)<<16)|alignedRows);
