if(tile.expert!=expert){LoadA(tile,0,plan.k);aPrefetched=true;return;}
int row=tile.row-expertFirst;
uint64_t bit=uint64_t(1)<<(row/BM);
if(cachedMask&bit)return;
CopyRows(Cached()+row*32,input+int64_t(tile.row)*plan.k,tile.rows,expertStride);
