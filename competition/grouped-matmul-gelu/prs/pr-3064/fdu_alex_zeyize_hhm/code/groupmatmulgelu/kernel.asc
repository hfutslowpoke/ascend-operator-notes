if constexpr (Mode==4 || GMM_OPT_GROUP_BOUNDS) {
if(cachedExpert!=expert) {
cachedExpert=expert;
cachedEnd=ends[expert];
cachedRows=cachedEnd-begin;
cachedRowTiles=(cachedRows+BM-1)/BM;
}
end=cachedEnd;rows=cachedRows;rt=cachedRowTiles;
} else {
end=ends[expert];rows=end-begin;rt=(rows+BM-1)/BM;
}
if constexpr (Mode==8) {
if(low>=high)return false;
int strips=(p.n+31)/32;
int64_t groupBegin=(int64_t)expert*strips;
int available=high-groupBegin<strips?(int)(high-groupBegin):strips;
int start=(int)(low-groupBegin);
if(!rt || start>=available) {
low=groupBegin+available;begin=end;++expert;rowTile=0;
continue;
}
int remaining=available-start;
int panels=(remaining+BN/32-1)/(BN/32);
int count=(remaining+panels-1)/panels;
int row=begin+rowTile*BM,col=start*32;
int width=p.n-col<count*32?p.n-col:count*32;
result={expert,row,col,end-row<BM?end-row:BM,width};
if(++rowTile==rt){rowTile=0;low+=count;}
return true;
}
if constexpr (Mode==5) {
if(low>=high)return false;
int strips=(p.n+31)/32;
int64_t groupBegin=(int64_t)expert*strips;
int first=low-groupBegin;
int stop=high-groupBegin<strips?(int)(high-groupBegin):strips;
if(rowTile>=rt) {
low=groupBegin+stop;
begin=end;++expert;rowTile=0;columnTile=0;
continue;
}
int firstBlock=first+columnTile;
int count=stop-firstBlock<BN/32?stop-firstBlock:BN/32;
int row=begin+rowTile*BM,col=firstBlock*32;
int width=p.n-col<count*32?p.n-col:count*32;
columnTile+=count;
if(first+columnTile>=stop){columnTile=0;++rowTile;}
result={expert,row,col,end-row<BM?end-row:BM,width};
return true;
}
if constexpr (Mode<=1 || Mode==6) {
int units=Mode==1?rt:rt*nt;
if(index>=units) {
index-=units;rowBase+=rt;begin=end;++expert;
columnTile=0;
continue;
}
int r=Mode==1?index:index/nt;
int c=Mode==1?columnTile:index-r*nt;
c=shifted_column<Rotate>(c,rowBase+r,expert,nt,p.cores);
if constexpr (Mode==1) {
if(++columnTile==nt){columnTile=0;index+=p.cores;}
} else index+=p.cores;
int row=begin+r*BM;
int tileRows=end-row<BM?end-row:BM;
if constexpr (Mode==6) {
int offset=(rows*r+rt-1)/rt;
int nextOffset=(rows*(r+1)+rt-1)/rt;
row=begin+offset;
tileRows=nextOffset-offset;
}
int col=c*BN;
int columns=p.n-col<BN?p.n-col:BN;
if constexpr(Mode==6 && BM==96 && BN==256) {
const int blocks=(p.n+31)/32;
const int first=(blocks*c+nt-1)/nt;
const int last=(blocks*(c+1)+nt-1)/nt;
col=first*32;
columns=p.n-col<(last-first)*32?p.n-col:(last-first)*32;
}
result={expert,row,col,tileRows,columns};
return true;
}
if constexpr (Mode==2)if((int64_t)begin*p.n>=high)return false;
if constexpr (Mode==4)if(workBase>=high)return false;
if(rt==0 || columnTile>=nt) {
rowBase+=rt;
if(rows>0)workBase+=((int64_t)rows+(Mode==4?BM*2:0))*p.n;
begin=end;
++expert;rowTile=0;columnTile=0;
continue;
}
int r=rowTile,c=columnTile;
int nc=p.n-c*BN<BN?p.n-c*BN:BN;
int start,stop;
if constexpr (Mode==4) {
int64_t weightedRows=(int64_t)rows+BM*2;
int64_t panel=workBase+weightedRows*c*BN;
int64_t cost=weightedRows*nc;
start=low<=panel?0:(int)(((low-panel)*rt+cost-1)/cost);
stop=high<=panel?0:(int)(((high-panel)*rt+cost-1)/cost);
} else {
int64_t panel=(int64_t)begin*p.n+(int64_t)rows*c*BN;
int stride=BM*nc;
start=low<=panel?0:(int)((low-panel+stride-1)/stride);
stop=high<=panel?0:(int)((high-panel+stride-1)/stride);
}
if(stop>rt)stop=rt;
if(r<start)r=start;
if(r>=stop){rowTile=0;++columnTile;continue;}
rowTile=r+1;
int row=begin+r*BM,col=c*BN;
result={expert,row,col,end-row<BM?end-row:BM,p.n-col<BN?p.n-col:BN};
return true;
}
return false;
}
};
template<int BM,int BN,int KP>
struct CcePackedStreamingEngine {
__gm__ int8_t* input;
__gm__ int8_t* weights;
GmmPlan plan;
int aWrite=0,aRead=0,bWrite=0,bRead=0,operand=0,weightWidth=0;
bool aPrefetched=false,bPrefetched=false,streamedWeights=false;
__aicore__ inline __cbuf__ int8_t* Activation(int slot) {
return reinterpret_cast<__cbuf__ int8_t*>(uint64_t(slot*BM*KP));
}
__aicore__ inline __cbuf__ int8_t* Weight(int slot) {
return reinterpret_cast<__cbuf__ int8_t*>(uint64_t(2*BM*KP+slot*weightWidth*KP));
}
__aicore__ inline void Init(CapiMemory& memory,GmmPlan p,
__gm__ int8_t* a,__gm__ int8_t* b) {
plan=p;input=a;weights=b;
int tiles=(p.n+BN-1)/BN,blocks=(p.n+31)/32;
weightWidth=((blocks+tiles-1)/tiles)*32;
memory.l1=2*BM*KP+2*weightWidth*KP;
for(int i=0;i<4;++i)set_flag(PIPE_MTE1,PIPE_MTE2,static_cast<event_t>(i));
for(int i=0;i<2;++i)set_flag(PIPE_M,PIPE_MTE1,static_cast<event_t>(i));
set_flag(PIPE_FIX,PIPE_M,EVENT_ID0);
}
__aicore__ inline void LoadA(CapiTile tile,int panel,int count) {
int slot=aWrite;aWrite^=1;
wait_flag(PIPE_MTE1,PIPE_MTE2,static_cast<event_t>(slot));
int paddedM=(plan.m+15)&~15,rows=(tile.rows+15)&~15;
copy_gm_to_cbuf(Activation(slot),input+(int64_t(panel/32)*paddedM+tile.row)*32,
0,(count+31)/32,rows,paddedM-rows,0,static_cast<pad_t>(0));
set_flag(PIPE_MTE2,PIPE_MTE1,static_cast<event_t>(slot));
}
__aicore__ inline void LoadB(CapiTile tile,int panel,int count) {
int slot=bWrite;bWrite^=1;
wait_flag(PIPE_MTE1,PIPE_MTE2,static_cast<event_t>(2+slot));
int paddedK=(plan.k+31)&~31,paddedN=(plan.n+31)&~31,columns=(tile.columns+31)&~31;
copy_gm_to_cbuf(Weight(slot),weights+(int64_t(tile.expert)*paddedK+panel)*paddedN+tile.column*32,
0,(count+31)/32,columns,paddedN-columns,0,static_cast<pad_t>(0));
set_flag(PIPE_MTE2,PIPE_MTE1,static_cast<event_t>(2+slot));
}
__aicore__ inline void Operands(__cbuf__ int8_t* a,__cbuf__ int8_t* b,
int inner,int count,int panelStride,int rows,int columns) {
int slot=operand;
wait_flag(PIPE_M,PIPE_MTE1,static_cast<event_t>(slot));
asc_copy_l12l0a(reinterpret_cast<__ca__ int8_t*>(uint64_t(slot*BM*128)),
a,count,rows,inner,0,1,1,1,1,1,1,false,false,false,false,panelStride);
load_cbuf_to_cb_transpose(reinterpret_cast<__cb__ int8_t*>(uint64_t(slot*BN*128)),
b+inner*columns,0,(count/32)*(columns/32),1,1,false,0);
set_flag(PIPE_MTE1,PIPE_M,static_cast<event_t>(slot));
}
__aicore__ inline void Multiply(CapiTile tile,__gm__ int32_t* target,
const CapiTile* nextTile,int reuseEvent=-1) {
if(reuseEvent>=0)wait_flag_dev(reuseEvent);
int rows=(tile.rows+15)&~15,columns=(tile.columns+31)&~31;
set_fmatrix((uint64_t(1)<<16)|rows);
int first=plan.k<KP?plan.k:KP;
if(!bPrefetched)LoadB(tile,0,first);
if(!aPrefetched)LoadA(tile,0,first);
aPrefetched=false;bPrefetched=false;
wait_flag(PIPE_FIX,PIPE_M,EVENT_ID0);
auto accumulator=reinterpret_cast<__cc__ int32_t*>(uint64_t(0));
for(int panel=0;panel<plan.k;panel+=KP) {
int count=plan.k-panel<KP?plan.k-panel:KP;
int padded=(count+31)&~31;
int aSlot=aRead,bSlot=bRead;aRead^=1;bRead^=1;
wait_flag(PIPE_MTE2,PIPE_MTE1,static_cast<event_t>(aSlot));
wait_flag(PIPE_MTE2,PIPE_MTE1,static_cast<event_t>(2+bSlot));
if(panel+count<plan.k) {
int next=panel+count,nextCount=plan.k-next<KP?plan.k-next:KP;
if(streamedWeights && (next-768)%3072==0) {
int region=(next-768)/3072;
wait_flag_dev(region==0?5:region==1?7:1);
}
LoadB(tile,next,nextCount);LoadA(tile,next,nextCount);
} else if(nextTile) {
LoadA(*nextTile,0,first);LoadB(*nextTile,0,first);
aPrefetched=true;bPrefetched=true;
}
auto a=Activation(aSlot),b=Weight(bSlot);
Operands(a,b,0,padded<128?padded:128,padded,rows,columns);
for(int inner=0;inner<padded;inner+=128) {
int reduction=padded-inner<128?padded-inner:128;
int slot=operand;operand^=1;
wait_flag(PIPE_MTE1,PIPE_M,static_cast<event_t>(slot));
mad(accumulator,reinterpret_cast<__ca__ int8_t*>(uint64_t(slot*BM*128)),
reinterpret_cast<__cb__ int8_t*>(uint64_t(slot*BN*128)),
rows,reduction,columns,0,false,false,panel==0 && inner==0);
set_flag(PIPE_M,PIPE_MTE1,static_cast<event_t>(slot));
int next=inner+128;
if(next<padded)Operands(a,b,next,padded-next<128?padded-next:128,padded,rows,columns);
if((rows/16)*(columns/16)<10)pipe_barrier(PIPE_M);
}
set_flag(PIPE_MTE1,PIPE_MTE2,static_cast<event_t>(aSlot));
set_flag(PIPE_MTE1,PIPE_MTE2,static_cast<event_t>(2+bSlot));
}
set_flag(PIPE_M,PIPE_FIX,EVENT_ID0);wait_flag(PIPE_M,PIPE_FIX,EVENT_ID0);
asc_set_l0c_copy_params(1,0,0);asc_set_l0c2gm_config(0,0,true);
copy_matrix_cc_to_gm(target,accumulator,0,tile.columns,tile.rows,BN,rows,0,
static_cast<QuantMode_t>(0),0,false,true);
set_flag(PIPE_FIX,PIPE_M,EVENT_ID0);
}
__aicore__ inline void Finish() {
for(int i=0;i<4;++i)wait_flag(PIPE_MTE1,PIPE_MTE2,static_cast<event_t>(i));
for(int i=0;i<2;++i)wait_flag(PIPE_M,PIPE_MTE1,static_cast<event_t>(i));
wait_flag(PIPE_FIX,PIPE_M,EVENT_ID0);
}
};
template<int BM,int BN,int KP,bool LateWait>
struct CceBufferedResidentEngine {
__gm__ int8_t* input;
__gm__ int8_t* weights;
GmmPlan plan;
int writeSlot=0,readSlot=0,operandSlot=0;
__gm__ uint64_t* quantizedScales;
__cbuf__ uint64_t* quantizedLocal;
int coefficientReadyEvent=-1,coefficientExpert=-1,coefficientColumn=-1;
int weightExpert=-1,weightColumn=-1;
bool aPrefetched=false,bPrefetched=false,streamedWeights=false;
__aicore__ inline __cbuf__ int8_t* Activation(int slot) {
return reinterpret_cast<__cbuf__ int8_t*>(uint64_t(slot*BM*KP));
}
__aicore__ inline __cbuf__ int8_t* Weight() {
return reinterpret_cast<__cbuf__ int8_t*>(uint64_t(2*BM*KP));
}
__aicore__ inline void Init(CapiMemory& memory,GmmPlan p,
__gm__ int8_t* a,__gm__ int8_t* b,__gm__ uint64_t* scales,__gm__ int64_t* ends) {
plan=p;input=a;weights=b;
memory.l1=2*BM*KP+BN*((p.k+31)&~31);
quantizedScales=scales;
quantizedLocal=reinterpret_cast<__cbuf__ uint64_t*>(uint64_t(memory.l1));
memory.l1+=BN*8;
set_flag(PIPE_MTE1,PIPE_MTE2,EVENT_ID0);
set_flag(PIPE_MTE1,PIPE_MTE2,EVENT_ID1);
set_flag(PIPE_MTE1,PIPE_MTE2,EVENT_ID2);
set_flag(PIPE_M,PIPE_MTE1,EVENT_ID0);
set_flag(PIPE_M,PIPE_MTE1,EVENT_ID1);
set_flag(PIPE_FIX,PIPE_M,EVENT_ID0);
}
__aicore__ inline void LoadCoefficients(CapiTile tile) {
if(coefficientReadyEvent>=0){wait_flag_dev(coefficientReadyEvent);coefficientReadyEvent=-1;}
if(tile.expert==coefficientExpert && tile.column==coefficientColumn)return;
if(coefficientExpert>=0)wait_flag(PIPE_FIX,PIPE_MTE2,EVENT_ID7);
int columns=(tile.columns+31)&~31;
copy_gm_to_cbuf(reinterpret_cast<__cbuf__ int8_t*>(quantizedLocal),
reinterpret_cast<__gm__ int8_t*>(quantizedScales+int64_t(tile.expert)*((plan.n+31)&~31)+tile.column),
0,1,columns/4,0,0,static_cast<pad_t>(0));
set_flag(PIPE_MTE2,PIPE_FIX,EVENT_ID7);wait_flag(PIPE_MTE2,PIPE_FIX,EVENT_ID7);
asc_copy_l12fb(reinterpret_cast<__fbuf__ void*>(uint64_t(0)),
reinterpret_cast<__cbuf__ void*>(quantizedLocal),1,columns/16,0,0);
pipe_barrier(PIPE_FIX);
set_flag(PIPE_FIX,PIPE_MTE2,EVENT_ID7);
coefficientExpert=tile.expert;coefficientColumn=tile.column;
}
__aicore__ inline void LoadA(CapiTile tile,int panel,int count) {
int slot=writeSlot;writeSlot^=1;
wait_flag(PIPE_MTE1,PIPE_MTE2,static_cast<event_t>(slot));
copy_gm_to_cbuf_multi_nd2nz_b8(Activation(slot),input+int64_t(tile.row)*plan.k+panel,
0,1,tile.rows,count,0,plan.k,(tile.rows+15)&~15,1,0);
set_flag(PIPE_MTE2,PIPE_MTE1,static_cast<event_t>(slot));
}
__aicore__ inline void CopyWeight(CapiTile tile,int panel,int count) {
int paddedK=(plan.k+31)&~31;
int paddedN=(plan.n+31)&~31;
int columns=(tile.columns+31)&~31;
auto source=weights+(int64_t(tile.expert)*paddedK+panel)*paddedN+tile.column*32;
copy_gm_to_cbuf(Weight()+panel*columns,source,0,(count+31)/32,
columns,paddedN-columns,0,static_cast<pad_t>(0));
}
__aicore__ inline void LoadOperands(CapiTile tile,__cbuf__ int8_t* a,
int panel,int inner,int count,int panelStride,int alignedRows,int columns) {
int slot=operandSlot;
wait_flag(PIPE_M,PIPE_MTE1,static_cast<event_t>(slot));
auto left=reinterpret_cast<__ca__ int8_t*>(uint64_t(slot*BM*128));
auto right=reinterpret_cast<__cb__ int8_t*>(uint64_t(slot*BN*128));
asc_copy_l12l0a(left,a,count,alignedRows,inner,0,
1,1,1,1,1,1,false,false,false,false,panelStride);
load_cbuf_to_cb_transpose(right,Weight()+(panel+inner)*columns,0,
(count/32)*(columns/32),1,1,false,0);
set_flag(PIPE_MTE1,PIPE_M,static_cast<event_t>(slot));
}
__aicore__ inline void Multiply(CapiTile tile,__gm__ int32_t* target,
const CapiTile* nextTile,int reuseEvent=-1) {
if constexpr(!LateWait)if(reuseEvent>=0)wait_flag_dev(reuseEvent);
LoadCoefficients(tile);
int alignedRows=(tile.rows+15)&~15;
int columns=(tile.columns+31)&~31;
bool unitFlags=!LateWait && tile.rows==alignedRows && tile.columns%16==0;
if(unitFlags)asc_set_mmad_direction_n();
set_fmatrix((uint64_t(1)<<16)|alignedRows);
bool usingPrefetchedB=bPrefetched;
if(tile.expert!=weightExpert || tile.column!=weightColumn) {
if(!usingPrefetchedB) {
wait_flag(PIPE_MTE1,PIPE_MTE2,EVENT_ID2);
CopyWeight(tile,0,plan.k);
set_flag(PIPE_MTE2,PIPE_MTE1,EVENT_ID2);
wait_flag(PIPE_MTE2,PIPE_MTE1,EVENT_ID2);
}
weightExpert=tile.expert;weightColumn=tile.column;
}
bPrefetched=false;
int initial=plan.k<KP?plan.k:KP;
if(!aPrefetched)LoadA(tile,0,initial);
aPrefetched=false;
wait_flag(PIPE_FIX,PIPE_M,EVENT_ID0);
auto accumulator=reinterpret_cast<__cc__ int32_t*>(uint64_t(0));
bool prefetchNextB=false && nextTile && plan.k<=2*KP &&
(nextTile->expert!=tile.expert || nextTile->column!=tile.column) &&
((nextTile->columns+31)&~31)==columns;
for(int panel=0;panel<plan.k;panel+=KP) {
int count=plan.k-panel<KP?plan.k-panel:KP;
int paddedCount=(count+31)&~31;
int aSlot=readSlot;readSlot^=1;
wait_flag(PIPE_MTE2,PIPE_MTE1,static_cast<event_t>(aSlot));
if(usingPrefetchedB)wait_flag(PIPE_MTE2,PIPE_MTE1,static_cast<event_t>(6+panel/KP));
auto localA=Activation(aSlot);
if(panel+count<plan.k)LoadA(tile,panel+count,plan.k-panel-count<KP?plan.k-panel-count:KP);
else if(nextTile){LoadA(*nextTile,0,initial);aPrefetched=true;}
LoadOperands(tile,localA,panel,0,paddedCount<128?paddedCount:128,paddedCount,alignedRows,columns);
for(int inner=0;inner<paddedCount;inner+=128) {
int reduction=paddedCount-inner<128?paddedCount-inner:128;
int slot=operandSlot;operandSlot^=1;
wait_flag(PIPE_MTE1,PIPE_M,static_cast<event_t>(slot));
if(prefetchNextB && inner+reduction>=paddedCount) {
event_t event=static_cast<event_t>(4+panel/KP);
set_flag(PIPE_MTE1,PIPE_MTE2,event);wait_flag(PIPE_MTE1,PIPE_MTE2,event);
CopyWeight(*nextTile,panel,count);
set_flag(PIPE_MTE2,PIPE_MTE1,static_cast<event_t>(6+panel/KP));
if(panel+count>=plan.k)bPrefetched=true;
}
bool final=panel+count>=plan.k && inner+reduction>=paddedCount;
mad(accumulator,reinterpret_cast<__ca__ int8_t*>(uint64_t(slot*BM*128)),
reinterpret_cast<__cb__ int8_t*>(uint64_t(slot*BN*128)),
alignedRows,reduction,columns,unitFlags?(final?3:2):0,
false,false,panel==0 && inner==0);
set_flag(PIPE_M,PIPE_MTE1,static_cast<event_t>(slot));
int next=inner+128;
if(next<paddedCount)
LoadOperands(tile,localA,panel,next,paddedCount-next<128?paddedCount-next:128,
paddedCount,alignedRows,columns);
if(!unitFlags && (alignedRows/16)*(columns/16)<10)pipe_barrier(PIPE_M);
}
set_flag(PIPE_MTE1,PIPE_MTE2,static_cast<event_t>(aSlot));
}
bool changesWeight=!nextTile || nextTile->expert!=tile.expert || nextTile->column!=tile.column;
if(changesWeight && !prefetchNextB)set_flag(PIPE_MTE1,PIPE_MTE2,EVENT_ID2);
if(!unitFlags){set_flag(PIPE_M,PIPE_FIX,EVENT_ID0);wait_flag(PIPE_M,PIPE_FIX,EVENT_ID0);}
if constexpr(LateWait)if(reuseEvent>=0)wait_flag_dev(reuseEvent);
asc_set_l0c_copy_params(1,0,0);asc_set_l0c2gm_config(0,0,true);
copy_matrix_cc_to_gm(reinterpret_cast<__gm__ half*>(target),accumulator,
0,tile.rows==alignedRows?columns:tile.columns,tile.rows,BN,alignedRows,unitFlags?3:0,QuantMode_t::VDEQF16,0,false,true);
set_flag(PIPE_FIX,PIPE_M,EVENT_ID0);
}
__aicore__ inline void Finish() {
if(coefficientExpert>=0)wait_flag(PIPE_FIX,PIPE_MTE2,EVENT_ID7);
wait_flag(PIPE_MTE1,PIPE_MTE2,EVENT_ID0);
wait_flag(PIPE_MTE1,PIPE_MTE2,EVENT_ID1);
wait_flag(PIPE_MTE1,PIPE_MTE2,EVENT_ID2);
wait_flag(PIPE_M,PIPE_MTE1,EVENT_ID0);
wait_flag(PIPE_M,PIPE_MTE1,EVENT_ID1);
wait_flag(PIPE_FIX,PIPE_M,EVENT_ID0);
}
};
template<int BM,int BN,int KP>
struct CcePackedFourStageEngine {
__gm__ int8_t* input;
__gm__ int8_t* weights;
GmmPlan plan;
int aWrite=0,aRead=0,bWrite=0,bRead=0,operand=0,paddedK=0;
int activationExpert=-1,activationRow=-1,heldSlot=0;
bool aPrefetched=false,bPrefetched=false,streamedWeights=false;
__aicore__ inline __cbuf__ int8_t* Activation(int slot) {
return reinterpret_cast<__cbuf__ int8_t*>(uint64_t(slot*BM*paddedK));
}
__aicore__ inline __cbuf__ int8_t* Weight(int slot) {
return reinterpret_cast<__cbuf__ int8_t*>(uint64_t(2*BM*paddedK+slot*BN*KP));
}
__aicore__ inline void Init(CapiMemory& memory,GmmPlan p,
__gm__ int8_t* a,__gm__ int8_t* b) {
plan=p;input=a;weights=b;paddedK=(p.k+31)&~31;
memory.l1=2*BM*paddedK+4*BN*KP;
for(int i=0;i<6;++i)set_flag(PIPE_MTE1,PIPE_MTE2,static_cast<event_t>(i));
for(int i=0;i<2;++i)set_flag(PIPE_M,PIPE_MTE1,static_cast<event_t>(i));
set_flag(PIPE_FIX,PIPE_M,EVENT_ID0);
}
__aicore__ inline void LoadA(CapiTile tile,int panel,int count) {
int slot=aWrite;aWrite^=1;
wait_flag(PIPE_MTE1,PIPE_MTE2,static_cast<event_t>(slot));
copy_gm_to_cbuf_multi_nd2nz_b8(Activation(slot),input+int64_t(tile.row)*plan.k+panel,
0,1,tile.rows,count,0,plan.k,(tile.rows+15)&~15,1,0);
set_flag(PIPE_MTE2,PIPE_MTE1,static_cast<event_t>(slot));
}
__aicore__ inline void LoadB(CapiTile tile,int panel,int count) {
int slot=bWrite;bWrite=(bWrite+1)&3;
wait_flag(PIPE_MTE1,PIPE_MTE2,static_cast<event_t>(2+slot));
int paddedN=(plan.n+31)&~31,columns=(tile.columns+31)&~31;
copy_gm_to_cbuf(Weight(slot),weights+(int64_t(tile.expert)*paddedK+panel)*paddedN+tile.column*32,
0,(count+31)/32,columns,paddedN-columns,0,static_cast<pad_t>(0));
set_flag(PIPE_MTE2,PIPE_MTE1,static_cast<event_t>(2+slot));
}
__aicore__ inline void Operands(__cbuf__ int8_t* b,
int panel,int inner,int count,int rows,int columns) {
int slot=operand;
wait_flag(PIPE_M,PIPE_MTE1,static_cast<event_t>(slot));
asc_copy_l12l0a(reinterpret_cast<__ca__ int8_t*>(uint64_t(slot*BM*64)),
Activation(heldSlot),count,rows,panel+inner,0,1,1,1,1,1,1,false,false,false,false,paddedK);
load_cbuf_to_cb_transpose(reinterpret_cast<__cb__ int8_t*>(uint64_t(slot*BN*64)),
b+inner*columns,0,(count/32)*(columns/32),1,1,false,0);
set_flag(PIPE_MTE1,PIPE_M,static_cast<event_t>(slot));
}
__aicore__ inline void Multiply(CapiTile tile,__gm__ int32_t* target,
const CapiTile* nextTile,int reuseEvent=-1) {
if(reuseEvent>=0)wait_flag_dev(reuseEvent);
int rows=(tile.rows+15)&~15,columns=(tile.columns+31)&~31;
set_fmatrix((uint64_t(1)<<16)|rows);
if(tile.expert!=activationExpert || tile.row!=activationRow) {
if(activationExpert>=0)set_flag(PIPE_MTE1,PIPE_MTE2,static_cast<event_t>(heldSlot));
if(!aPrefetched)LoadA(tile,0,plan.k);
heldSlot=aRead;aRead^=1;
wait_flag(PIPE_MTE2,PIPE_MTE1,static_cast<event_t>(heldSlot));
aPrefetched=false;activationExpert=tile.expert;activationRow=tile.row;
}
if(nextTile && (nextTile->expert!=tile.expert || nextTile->row!=tile.row)) {
LoadA(*nextTile,0,plan.k);aPrefetched=true;
}
int first=plan.k<KP?plan.k:KP;
if(!bPrefetched)LoadB(tile,0,first);
bPrefetched=false;
for(int prime=KP;prime<3*KP && prime<plan.k;prime+=KP)
LoadB(tile,prime,plan.k-prime<KP?plan.k-prime:KP);
wait_flag(PIPE_FIX,PIPE_M,EVENT_ID0);
auto accumulator=reinterpret_cast<__cc__ int32_t*>(uint64_t(0));
for(int panel=0;panel<plan.k;panel+=KP) {
int count=plan.k-panel<KP?plan.k-panel:KP,padded=(count+31)&~31;
int bSlot=bRead;bRead=(bRead+1)&3;
wait_flag(PIPE_MTE2,PIPE_MTE1,static_cast<event_t>(2+bSlot));
if(panel+count>=plan.k && nextTile){LoadB(*nextTile,0,first);bPrefetched=true;}
int ahead=panel+3*KP;
if(ahead<plan.k)LoadB(tile,ahead,plan.k-ahead<KP?plan.k-ahead:KP);
auto b=Weight(bSlot);
Operands(b,panel,0,padded<64?padded:64,rows,columns);
for(int inner=0;inner<padded;inner+=64) {
int reduction=padded-inner<64?padded-inner:64;
int slot=operand;operand^=1;
wait_flag(PIPE_MTE1,PIPE_M,static_cast<event_t>(slot));
mad(accumulator,reinterpret_cast<__ca__ int8_t*>(uint64_t(slot*BM*64)),
reinterpret_cast<__cb__ int8_t*>(uint64_t(slot*BN*64)),
rows,reduction,columns,0,false,false,panel==0 && inner==0);
set_flag(PIPE_M,PIPE_MTE1,static_cast<event_t>(slot));
int next=inner+64;
if(next<padded)Operands(b,panel,next,padded-next<64?padded-next:64,rows,columns);
pipe_barrier(PIPE_M);
}
set_flag(PIPE_MTE1,PIPE_MTE2,static_cast<event_t>(2+bSlot));
}
set_flag(PIPE_M,PIPE_FIX,EVENT_ID0);wait_flag(PIPE_M,PIPE_FIX,EVENT_ID0);
asc_set_l0c_copy_prequant(uint64_t(0x3b000000));
asc_set_l0c_copy_params(1,0,0);asc_set_l0c2gm_config(0,0,true);
copy_matrix_cc_to_gm(reinterpret_cast<__gm__ half*>(target),accumulator,
0,tile.columns,tile.rows,BN,rows,0,QuantMode_t::DEQF16,0,false,true);
set_flag(PIPE_FIX,PIPE_M,EVENT_ID0);
}
__aicore__ inline void Finish() {
if(activationExpert>=0)set_flag(PIPE_MTE1,PIPE_MTE2,static_cast<event_t>(heldSlot));
for(int i=0;i<6;++i)wait_flag(PIPE_MTE1,PIPE_MTE2,static_cast<event_t>(i));
for(int i=0;i<2;++i)wait_flag(PIPE_M,PIPE_MTE1,static_cast<event_t>(i));
wait_flag(PIPE_FIX,PIPE_M,EVENT_ID0);
}
};
template<int BM,int BN,int KP,bool LateWait>
struct CcePackedResidentEngine {
__gm__ int8_t* input;
__gm__ int8_t* weights;
GmmPlan plan;
int writeSlot=0,readSlot=0,operandSlot=0;
int weightExpert=-1,weightColumn=-1;
bool aPrefetched=false,bPrefetched=false,streamedWeights=false;
__aicore__ inline __cbuf__ int8_t* Activation(int slot) {
return reinterpret_cast<__cbuf__ int8_t*>(uint64_t(slot*BM*KP));
}
__aicore__ inline __cbuf__ int8_t* Weight() {
return reinterpret_cast<__cbuf__ int8_t*>(uint64_t(2*BM*KP));
}
__aicore__ inline void Init(CapiMemory& memory,GmmPlan p,
__gm__ int8_t* a,__gm__ int8_t* b) {
plan=p;input=a;weights=b;
memory.l1=2*BM*KP+BN*((p.k+31)&~31);
set_flag(PIPE_MTE1,PIPE_MTE2,EVENT_ID0);
set_flag(PIPE_MTE1,PIPE_MTE2,EVENT_ID1);
set_flag(PIPE_MTE1,PIPE_MTE2,EVENT_ID2);
set_flag(PIPE_M,PIPE_MTE1,EVENT_ID0);
set_flag(PIPE_M,PIPE_MTE1,EVENT_ID1);
set_flag(PIPE_FIX,PIPE_M,EVENT_ID0);
}
__aicore__ inline void LoadA(CapiTile tile,int panel,int count) {
int slot=writeSlot;writeSlot^=1;
wait_flag(PIPE_MTE1,PIPE_MTE2,static_cast<event_t>(slot));
copy_gm_to_cbuf_multi_nd2nz_b8(Activation(slot),input+int64_t(tile.row)*plan.k+panel,
0,1,tile.rows,count,0,plan.k,(tile.rows+15)&~15,1,0);
set_flag(PIPE_MTE2,PIPE_MTE1,static_cast<event_t>(slot));
}
__aicore__ inline void CopyWeight(CapiTile tile,int panel,int count) {
int paddedK=(plan.k+31)&~31;
int paddedN=(plan.n+31)&~31;
int columns=(tile.columns+31)&~31;
auto source=weights+(int64_t(tile.expert)*paddedK+panel)*paddedN+tile.column*32;
copy_gm_to_cbuf(Weight()+panel*columns,source,0,(count+31)/32,
columns,paddedN-columns,0,static_cast<pad_t>(0));
}
__aicore__ inline void LoadOperands(CapiTile tile,__cbuf__ int8_t* a,
int panel,int inner,int count,int panelStride,int alignedRows,int columns) {
int slot=operandSlot;
wait_flag(PIPE_M,PIPE_MTE1,static_cast<event_t>(slot));
auto left=reinterpret_cast<__ca__ int8_t*>(uint64_t(slot*BM*64));
auto right=reinterpret_cast<__cb__ int8_t*>(uint64_t(slot*BN*64));
asc_copy_l12l0a(left,a,count,alignedRows,inner,0,
1,1,1,1,1,1,false,false,false,false,panelStride);
load_cbuf_to_cb_transpose(right,Weight()+(panel+inner)*columns,0,
(count/32)*(columns/32),1,1,false,0);
set_flag(PIPE_MTE1,PIPE_M,static_cast<event_t>(slot));
}
__aicore__ inline void Multiply(CapiTile tile,__gm__ int32_t* target,
const CapiTile* nextTile,int reuseEvent=-1) {
if constexpr(!LateWait)if(reuseEvent>=0)wait_flag_dev(reuseEvent);
int alignedRows=(tile.rows+15)&~15;
int columns=(tile.columns+31)&~31;
bool unitFlags=!LateWait && tile.rows==alignedRows && tile.columns%16==0;
if(unitFlags)asc_set_mmad_direction_n();
set_fmatrix((uint64_t(1)<<16)|alignedRows);
bool usingPrefetchedB=bPrefetched;
if(tile.expert!=weightExpert || tile.column!=weightColumn) {
if(!usingPrefetchedB) {
wait_flag(PIPE_MTE1,PIPE_MTE2,EVENT_ID2);
CopyWeight(tile,0,plan.k);
set_flag(PIPE_MTE2,PIPE_MTE1,EVENT_ID2);
wait_flag(PIPE_MTE2,PIPE_MTE1,EVENT_ID2);
}
weightExpert=tile.expert;weightColumn=tile.column;
}
bPrefetched=false;
int initial=plan.k<KP?plan.k:KP;
if(!aPrefetched)LoadA(tile,0,initial);
aPrefetched=false;
wait_flag(PIPE_FIX,PIPE_M,EVENT_ID0);
auto accumulator=reinterpret_cast<__cc__ int32_t*>(uint64_t(0));
bool prefetchNextB=BM==80 && nextTile && plan.k<=2*KP &&
(nextTile->expert!=tile.expert || nextTile->column!=tile.column) &&
((nextTile->columns+31)&~31)==columns;
for(int panel=0;panel<plan.k;panel+=KP) {
int count=plan.k-panel<KP?plan.k-panel:KP;
int paddedCount=(count+31)&~31;
int aSlot=readSlot;readSlot^=1;
wait_flag(PIPE_MTE2,PIPE_MTE1,static_cast<event_t>(aSlot));
if(usingPrefetchedB)wait_flag(PIPE_MTE2,PIPE_MTE1,static_cast<event_t>(6+panel/KP));
auto localA=Activation(aSlot);
if(panel+count<plan.k)LoadA(tile,panel+count,plan.k-panel-count<KP?plan.k-panel-count:KP);
else if(nextTile){LoadA(*nextTile,0,initial);aPrefetched=true;}
LoadOperands(tile,localA,panel,0,paddedCount<64?paddedCount:64,paddedCount,alignedRows,columns);
for(int inner=0;inner<paddedCount;inner+=64) {
int reduction=paddedCount-inner<64?paddedCount-inner:64;
int slot=operandSlot;operandSlot^=1;
wait_flag(PIPE_MTE1,PIPE_M,static_cast<event_t>(slot));
if(prefetchNextB && inner+reduction>=paddedCount) {
event_t event=static_cast<event_t>(4+panel/KP);
set_flag(PIPE_MTE1,PIPE_MTE2,event);wait_flag(PIPE_MTE1,PIPE_MTE2,event);
CopyWeight(*nextTile,panel,count);
set_flag(PIPE_MTE2,PIPE_MTE1,static_cast<event_t>(6+panel/KP));
if(panel+count>=plan.k)bPrefetched=true;
}
bool final=panel+count>=plan.k && inner+reduction>=paddedCount;
mad(accumulator,reinterpret_cast<__ca__ int8_t*>(uint64_t(slot*BM*64)),
reinterpret_cast<__cb__ int8_t*>(uint64_t(slot*BN*64)),
alignedRows,reduction,columns,unitFlags?(final?3:2):0,
false,false,panel==0 && inner==0);
set_flag(PIPE_M,PIPE_MTE1,static_cast<event_t>(slot));
int next=inner+64;
if(next<paddedCount)
LoadOperands(tile,localA,panel,next,paddedCount-next<64?paddedCount-next:64,
paddedCount,alignedRows,columns);
if(!unitFlags && (alignedRows/16)*(columns/16)<10)pipe_barrier(PIPE_M);
}
set_flag(PIPE_MTE1,PIPE_MTE2,static_cast<event_t>(aSlot));
}
bool changesWeight=!nextTile || nextTile->expert!=tile.expert || nextTile->column!=tile.column;
if(changesWeight && !prefetchNextB)set_flag(PIPE_MTE1,PIPE_MTE2,EVENT_ID2);
if(!unitFlags){set_flag(PIPE_M,PIPE_FIX,EVENT_ID0);wait_flag(PIPE_M,PIPE_FIX,EVENT_ID0);}
if constexpr(LateWait)if(reuseEvent>=0)wait_flag_dev(reuseEvent);
asc_set_l0c_copy_prequant(uint64_t(0x3b000000));
asc_set_l0c_copy_params(1,0,0);asc_set_l0c2gm_config(0,0,true);
copy_matrix_cc_to_gm(reinterpret_cast<__gm__ half*>(target),accumulator,
0,tile.columns,tile.rows,BN,alignedRows,unitFlags?3:0,QuantMode_t::DEQF16,0,false,true);
set_flag(PIPE_FIX,PIPE_M,EVENT_ID0);
}
__aicore__ inline void Finish() {
wait_flag(PIPE_MTE1,PIPE_MTE2,EVENT_ID0);
wait_flag(PIPE_MTE1,PIPE_MTE2,EVENT_ID1);
wait_flag(PIPE_MTE1,PIPE_MTE2,EVENT_ID2);
wait_flag(PIPE_M,PIPE_MTE1,EVENT_ID0);
wait_flag(PIPE_M,PIPE_MTE1,EVENT_ID1);
wait_flag(PIPE_FIX,PIPE_M,EVENT_ID0);
}
};
template<int BM, int BN, int BK, int KP, bool ResidentA, bool ResidentB, pipe_t FixPipeline,
bool PrefetchRows=false, bool InplaceResidentBPrefetch=false, bool WeightFirst=false,
bool PrepackedWeights=false,int BStages=2,bool PaddedCompletion=false,bool CompactScratch=false,
bool LateWorkspaceWait=false,bool QuantizedFix=false,bool CacheExpertActivation=false,bool ForceHalfScratch=false,bool StageMajorWeights=false>
struct CapiPanelEngine {
static constexpr bool K32MajorWeights=StageMajorWeights || (BM==96 && BN==256 &&
PrepackedWeights && !ResidentA && !ResidentB);
static constexpr bool PrimedQueues=ResidentA && PrefetchRows && !ResidentB && BStages==4 && BM==80 && BN==384;
static constexpr bool HalfScratch=ForceHalfScratch || PrimedQueues ||
(BM==80 && BN==384 && ResidentB && PrepackedWeights && InplaceResidentBPrefetch) ||
(BM==96 && BN==320 && ResidentB && PrepackedWeights);
static constexpr int ADepth=ResidentA && !PrefetchRows?1:2;
static constexpr int BDepth=ResidentB?1:BStages;
CapiQueue<__cbuf__ int8_t*,CapiSpace::L1,PIPE_MTE2,PIPE_MTE1,ADepth,0,PrimedQueues> aq;
CapiQueue<__cbuf__ int8_t*,CapiSpace::L1,PIPE_MTE2,PIPE_MTE1,BDepth,2,PrimedQueues> bq;
CapiQueue<__ca__ int8_t*,CapiSpace::L0A,PIPE_MTE1,PIPE_M,2,0,PrimedQueues> a0q;
CapiQueue<__cb__ int8_t*,CapiSpace::L0B,PIPE_MTE1,PIPE_M,2,2,PrimedQueues> b0q;
CapiQueue<__cc__ int32_t*,CapiSpace::L0C,PIPE_M,FixPipeline,1,0,PrimedQueues> cq;
__gm__ int8_t* a;
__gm__ int8_t* b;
__cbuf__ int8_t* heldA=nullptr;
__cbuf__ int8_t* heldB=nullptr;
int aExpert=-1,aRow=-1,bExpert=-1,bColumn=-1;
bool aPrefetched=false,bPrefetched=false;
bool streamedWeights=false;
int bPrefetchedExpert=-1,bPrefetchedColumn=-1;
GmmPlan p;
CapiQueue<__cbuf__ int8_t*,CapiSpace::L1,PIPE_MTE2,PIPE_MTE1,1,7> expertAq;
__gm__ int64_t* groupEnds=nullptr;
__cbuf__ int8_t* cachedA=nullptr;
__cbuf__ int8_t* firstStreamedA=nullptr;
int selectedExpert=-1,expertFirst=0,expertRows=0,expertStride=0;
int loadedExpert=-1,expertCapacityRows=0;
bool cacheAvailable=false,useExpertA=false,expertPending=false;
bool cacheRestQueued=false,cacheRestPending=false;
int firstCachedRow=0,firstCachedRows=0;
uint64_t cachedRowMask=0;
__gm__ uint64_t* quantizedScales=nullptr;
__cbuf__ uint64_t* quantizedLocal=nullptr;
int quantizedExpert=-1,quantizedColumn=-1;
int coefficientReadyEvent=-1;
__aicore__ inline void Init(CapiMemory& memory, GmmPlan plan,
__gm__ int8_t* input, __gm__ int8_t* weights, __gm__ uint64_t* scales=nullptr, __gm__ int64_t* ends=nullptr) {
p=plan;a=input;b=weights;
int paddedK=(p.k+31)&~31;
memory.InitBuffer(aq,ADepth,BM*(ResidentA?paddedK:KP));
if constexpr(CacheExpertActivation) {
static_assert(BM==128 && BN==256 && !ResidentA && ResidentB &&
InplaceResidentBPrefetch,
"Expert activation cache requires the narrow resident pipeline");
groupEnds=ends;
int capacityRows=(((p.m+p.e-1)/p.e)+15)&~15;
int bytes=capacityRows*paddedK;
expertCapacityRows=capacityRows;
cacheAvailable=p.k<=KP && capacityRows<=64*BM && uint64_t(memory.l1)+bytes+
uint64_t(BDepth)*BN*paddedK+(QuantizedFix?BN*8:0)<=512*1024;
if(cacheAvailable)memory.InitBuffer(expertAq,1,bytes);
}
int weightColumns=BN;
if constexpr(BM==96 && BN==256 && PrepackedWeights && !ResidentA && !ResidentB) {
const int columnTiles=(p.n+BN-1)/BN;
const int columnBlocks=(p.n+31)/32;
weightColumns=((columnBlocks+columnTiles-1)/columnTiles)*32;
}
memory.InitBuffer(bq,BDepth,weightColumns*(ResidentB?paddedK:KP));
memory.InitBuffer(a0q,2,BM*BK);
memory.InitBuffer(b0q,2,BN*BK);
memory.InitBuffer(cq,1,BM*BN*4);
if constexpr(QuantizedFix) {
quantizedScales=scales;
quantizedLocal=reinterpret_cast<__cbuf__ uint64_t*>(uint64_t(memory.l1));
memory.l1+=BN*8;
}
}
__aicore__ inline void SelectExpert(CapiTile tile) {
if constexpr(CacheExpertActivation) {
if(selectedExpert==tile.expert)return;
if(loadedExpert>=0) {
if(cacheRestPending) {
capi_wait<PIPE_MTE2,PIPE_MTE1>(5);cacheRestPending=false;
}
aq.FreeTensor(firstStreamedA);
expertAq.FreeTensor(cachedA);
loadedExpert=-1;
}
selectedExpert=tile.expert;
expertFirst=tile.expert==0?0:groupEnds[tile.expert-1];
expertRows=groupEnds[tile.expert]-expertFirst;
expertStride=(expertRows+15)&~15;
useExpertA=cacheAvailable && expertStride<=expertCapacityRows;
}
}
__aicore__ inline void CopyExpertRows(int first,int rows) {
if(rows<=0)return;
auto local=cachedA+first*32;
auto source=a+int64_t(expertFirst+first)*p.k;
int pairedRows=rows&~31,bulk=p.k&~31;
if((p.k&1) && pairedRows>0 && bulk>0) {
asc_copy_gm2l1_nd2nz(reinterpret_cast<__cbuf__ int16_t*>(local),
reinterpret_cast<__gm__ int16_t*>(source),1,pairedRows/2,bulk/2,
0,p.k,expertStride,2,0);
asc_copy_gm2l1_nd2nz(reinterpret_cast<__cbuf__ int16_t*>(local+32),
reinterpret_cast<__gm__ int16_t*>(source+p.k),1,pairedRows/2,bulk/2,
0,p.k,expertStride,2,0);
if(bulk<p.k)
capi_nd_to_nz(local+bulk*expertStride,source+bulk,
pairedRows,p.k-bulk,p.k,expertStride);
if(pairedRows<rows)
capi_nd_to_nz(local+pairedRows*32,source+int64_t(pairedRows)*p.k,
rows-pairedRows,p.k,p.k,expertStride);
} else capi_nd_to_nz(local,source,rows,p.k,p.k,expertStride);
}
__aicore__ inline void LoadExpertActivation(CapiTile tile) {
if(loadedExpert==tile.expert)return;
cachedA=expertAq.template AllocTensor<int8_t>();
firstCachedRow=tile.row-expertFirst;
firstCachedRows=tile.rows;
firstStreamedA=aq.template DeQue<int8_t>();
loadedExpert=tile.expert;expertPending=false;
cacheRestQueued=false;cacheRestPending=false;
cachedRowMask=uint64_t(1)<<(firstCachedRow/BM);
}
__aicore__ inline void PrefetchCachedTile(CapiTile tile) {
int row=tile.row-expertFirst;
uint64_t bit=uint64_t(1)<<(row/BM);
if(cachedRowMask&bit)return;
CopyExpertRows(row,tile.rows);
capi_notify<PIPE_MTE2,PIPE_MTE1>(5);
