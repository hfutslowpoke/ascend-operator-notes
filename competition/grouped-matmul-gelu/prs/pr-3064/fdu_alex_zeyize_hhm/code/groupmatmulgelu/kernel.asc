__ubuf__ float* result;
if constexpr(ClampExponent) {
asc_min_scalar(v,temporary,80.0f,1,1,1,8,8);asc_sync_pipe(PIPE_V);
asc_exp(temporary,v,1,1,1,8,8);asc_sync_pipe(PIPE_V);
asc_add_scalar(v,temporary,1.0f,1,1,1,8,8);asc_sync_pipe(PIPE_V);
asc_div(temporary,z,v,1,1,1,1,8,8,8);asc_sync_pipe(PIPE_V);
result=temporary;
} else {
asc_exp(v,temporary,1,1,1,8,8);asc_sync_pipe(PIPE_V);
asc_add_scalar(temporary,v,1.0f,1,1,1,8,8);asc_sync_pipe(PIPE_V);
asc_div(v,z,temporary,1,1,1,1,8,8,8);asc_sync_pipe(PIPE_V);
result=v;
}
asc_set_mask_norm();asc_set_vector_mask(~uint64_t(0),~uint64_t(0));
asc_float2half_rn(out,result,count);asc_sync_pipe(PIPE_V);
}
template<int TemporaryElements, bool FusedAffine=false, bool ClampExponent=true, bool ReuseValueScratch=false>
__aicore__ inline void capi_finish_gelu_buffered(__ubuf__ float* z,
__ubuf__ float* v, __ubuf__ float* temporary, __ubuf__ half* out, int count,
__ubuf__ float* multiplier=nullptr, __ubuf__ float* bias=nullptr) {
for(int offset=0;offset<count;offset+=TemporaryElements) {
int active=count-offset<TemporaryElements?count-offset:TemporaryElements;
auto input=z+offset;
auto values=ReuseValueScratch?v:v+offset;
asc_set_mask_count();asc_set_vector_mask(0,active);
asc_mul(values,input,input,1,1,1,1,8,8,8);asc_sync_pipe(PIPE_V);
if constexpr(FusedAffine) {
asc_mul_add(values,multiplier,bias,1,1,1,1,8,0,0);
asc_sync_pipe(PIPE_V);
} else {
asc_mul_scalar(temporary,values,-0.07135481627260091f,1,1,1,8,8);
asc_sync_pipe(PIPE_V);
asc_add_scalar(values,temporary,-1.5957691216057308f,1,1,1,8,8);
asc_sync_pipe(PIPE_V);
}
asc_mul(temporary,values,input,1,1,1,1,8,8,8);asc_sync_pipe(PIPE_V);
__ubuf__ float* result;
if constexpr(ClampExponent) {
asc_min_scalar(values,temporary,80.0f,1,1,1,8,8);asc_sync_pipe(PIPE_V);
asc_exp(temporary,values,1,1,1,8,8);asc_sync_pipe(PIPE_V);
asc_add_scalar(values,temporary,1.0f,1,1,1,8,8);asc_sync_pipe(PIPE_V);
asc_div(temporary,input,values,1,1,1,1,8,8,8);asc_sync_pipe(PIPE_V);
result=temporary;
} else {
asc_exp(values,temporary,1,1,1,8,8);asc_sync_pipe(PIPE_V);
asc_add_scalar(temporary,values,1.0f,1,1,1,8,8);asc_sync_pipe(PIPE_V);
asc_div(values,input,temporary,1,1,1,1,8,8,8);asc_sync_pipe(PIPE_V);
result=values;
}
asc_set_mask_norm();asc_set_vector_mask(~uint64_t(0),~uint64_t(0));
asc_float2half_rn(out+offset,result,active);asc_sync_pipe(PIPE_V);
}
}
template<int BM>
__aicore__ inline int capi_vector_half_rows(int rows,int legacy=BM/2) {
#if GMM_OPT_BALANCED_AIV_ROWS
return (rows+1)/2;
#else
return legacy;
#endif
}
template<int BM, int BN, bool ContiguousExperts=false, bool FullColumns=false>
__aicore__ inline bool capi_next_expert_tile(
ExpertTileCursor &cursor, ExpertTileState &state,
__ubuf__ int64_t* groups, GmmPlan p, int block, int subBlock, int groupOffset=0)
{
const int nt=FullColumns?1:(p.n+BN-1)/BN;
int expertStop=ContiguousExperts?p.e*(block+1)/p.cores:p.e;
while(cursor.expert<expertStop) {
if(!cursor.loaded) {
cursor.begin=cursor.expert==0?0:groups[cursor.expert-1-groupOffset];
cursor.end=groups[cursor.expert-groupOffset];
int rows=cursor.end-cursor.begin;
cursor.tiles=((rows+BM-1)/BM)*nt;
cursor.tile=0;
cursor.loaded=true;
}
if(cursor.tile<cursor.tiles) {
int tile=cursor.tile++;
int row=cursor.begin+(tile/nt)*BM;
int tileRows=cursor.end-row<BM?cursor.end-row:BM;
int halfRows=capi_vector_half_rows<BM>(tileRows);
int slice=subBlock*halfRows;
int firstRow=row+slice;
int remaining=cursor.end-firstRow;
state.expert=cursor.expert;
state.row=row;
state.col=(tile%nt)*BN;
state.firstRow=firstRow;
state.localRows=remaining>0?(remaining<halfRows?remaining:halfRows):0;
state.nc=FullColumns?BN:(p.n-state.col<BN?p.n-state.col:BN);
state.slot=cursor.sequence++&1;
return true;
}
cursor.expert+=ContiguousExperts?1:p.cores;
cursor.loaded=false;
}
return false;
}
template<int BM, int BN, int SIZE, bool FullColumns=false>
__aicore__ inline void capi_prefetch_expert_tile(
ExpertTileState state, __gm__ int32_t* scratch,
__gm__ float* sg, __ubuf__ int32_t* ciStorage,
__ubuf__ float* scales, TEventID inputReady[2],
TEventID outputFree[2], bool outputPending[2],
TEventID scaleFree, bool &scalePending, int outputWidth)
{
asc_sync_block_wait(state.slot);
if(state.localRows<=0) {
capi_block_arrive<PIPE_MTE2,2>(2+state.slot);
return;
}
if(scalePending) {
capi_wait<PIPE_V,PIPE_MTE2>(scaleFree);
scalePending=false;
}
if(outputPending[state.slot]) {
capi_wait<PIPE_MTE3,PIPE_MTE2>(outputFree[state.slot]);
outputPending[state.slot]=false;
}
const int columns=FullColumns?BN:state.nc;
const int stride=FullColumns?BN:outputWidth;
const int firstColumn=FullColumns?0:state.col;
DataCopyExtParams scaleParams{1,(uint32_t)(columns*4),0,0,0};
DataCopyPadExtParams<float> scalePad{true,0,0,0.0f};
capi_read_pad(scales,
(sg + ((int64_t)state.expert*stride+firstColumn)),
scaleParams,scalePad);
int slice=state.firstRow-state.row;
capi_read((ciStorage + (state.slot*SIZE)),
(scratch + (state.slot*BM*BN+slice*BN)),state.localRows*BN);
capi_notify<PIPE_MTE2,PIPE_V>(inputReady[state.slot]);
capi_block_arrive<PIPE_MTE2,2>(2+state.slot);
}
__aicore__ inline int capi_vector_row_stride(int columns,int stride) {
#if GMM_OPT_TAIL_STRIDE
int compact=(columns+63)&~63;
return compact<stride?compact:stride;
#else
return stride;
#endif
}
__aicore__ inline int capi_fine_tail_stride(int columns) {
if(columns<=16)return 16;
if(columns<=32)return 32;
if(columns<=64)return 64;
if(columns<=128)return 128;
return (columns+15)&~15;
}
__aicore__ inline int capi_aligned_scratch_stride(int columns) {
return (columns+63)&~63;
}
template<int BN, bool PackTail>
__aicore__ inline void capi_copy_accumulator_rows(
__ubuf__ int32_t* dst, __gm__ int32_t* src, int rows, int rowStride) {
if constexpr (PackTail || GMM_OPT_TAIL_STRIDE) {
if (rowStride != BN) {
asc_copy_gm2ub_align(reinterpret_cast<__ubuf__ uint8_t*>(dst),
reinterpret_cast<__gm__ uint8_t*>(src), rows, rowStride * 4,
0, 0, (BN - rowStride) * 4, 0);
return;
}
}
capi_read(dst, src, rows * BN);
}
template<int First, int Later>
__aicore__ inline int resident_panel_start(int panel) {
if constexpr(First==Later)return panel*Later;
return panel==0?0:First+(panel-1)*Later;
}
template<bool ClampExponent=true>
__aicore__ inline void case2_finish_gelu_affine(__ubuf__ float* z,
__ubuf__ float* v, __ubuf__ float* temporary, __ubuf__ half* out, int count) {
asc_set_mask_count();asc_set_vector_mask(0,count);
asc_mul(v,z,z,1,1,1,1,8,8,8);asc_sync_pipe(PIPE_V);
