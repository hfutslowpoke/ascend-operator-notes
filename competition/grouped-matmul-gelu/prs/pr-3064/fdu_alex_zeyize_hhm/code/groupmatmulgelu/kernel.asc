__aicore__ inline void Multiply(CceTile tile,__gm__ int32_t* target,
const CceTile* nextTile,int reuseEvent=-1) {
SelectActivation(tile);LoadCoefficients(tile);
int alignedRows=(tile.rows+15)&~15,columns=(tile.columns+31)&~31;
int row=tile.row-expertFirst;
bool first=row>=firstRow && row+tile.rows<=firstRow+firstRows;
int sourceRows=first?((firstRows+15)&~15):expertStride;
auto localA=first?Activation(firstSlot)+(row-firstRow)*32:Cached()+row*32;
