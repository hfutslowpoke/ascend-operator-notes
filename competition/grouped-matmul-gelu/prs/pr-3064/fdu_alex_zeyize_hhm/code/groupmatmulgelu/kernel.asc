#pragma clang fp reassociate(off) contract(off)
struct GmmDD { float hi,lo; };
__aicore__ inline float gadd(float a,float b) { return a+b; }
__aicore__ inline float gsub(float a,float b) { return a-b; }
__aicore__ inline float gmul(float a,float b) { return a*b; }
__aicore__ inline GmmDD gsum(float a,float b) {
float s=gadd(a,b),v=gsub(s,a);
return {s,gadd(gsub(a,gsub(s,v)),gsub(b,v))};
}
__aicore__ inline GmmDD gdadd(GmmDD a,GmmDD b) {
GmmDD s=gsum(a.hi,b.hi);
return gsum(s.hi,gadd(gadd(s.lo,a.lo),b.lo));
}
__aicore__ inline GmmDD gdneg(GmmDD a) { return {-a.hi,-a.lo}; }
__aicore__ inline GmmDD gdmul(GmmDD a,GmmDD b) {
float h=gmul(a.hi,b.hi);
float ca=gmul(4097.0f,a.hi),cb=gmul(4097.0f,b.hi);
float ah=gsub(ca,gsub(ca,a.hi)),al=gsub(a.hi,ah);
float bh=gsub(cb,gsub(cb,b.hi)),bl=gsub(b.hi,bh);
float err=gadd(gadd(gsub(gmul(ah,bh),h),gmul(ah,bl)),gmul(al,bh));
err=gadd(err,gmul(al,bl));
err=gadd(err,gadd(gmul(a.hi,b.lo),gmul(a.lo,b.hi)));
return gsum(h,err);
}
__aicore__ inline GmmDD gddiv(GmmDD a,GmmDD b) {
float q=a.hi/b.hi;
GmmDD r=gdadd(a,gdneg(gdmul(b,{q,0.0f})));
return gsum(q,gadd(r.hi,r.lo)/b.hi);
}
__aicore__ inline GmmDD gdexp(GmmDD a) {
const GmmDD ln2={0x1.62e4300000000p-1f,-0x1.05c6100000000p-29f};
int exponent=(int)(a.hi*1.4426950408889634f);
GmmDD r=gdadd(a,gdneg(gdmul(ln2,{(float)exponent,0.0f})));
if(r.hi>0.34657359028f) { ++exponent;r=gdadd(r,gdneg(ln2)); }
if(r.hi< -0.34657359028f) { --exponent;r=gdadd(r,ln2); }
const GmmDD coefficients[15]={{0x1.0000000000000p+0f,0x0.0p+0f},{0x1.0000000000000p+0f,0x0.0p+0f},{0x1.0000000000000p-1f,0x0.0p+0f},{0x1.5555560000000p-3f,-0x1.5555560000000p-28f},{0x1.5555560000000p-5f,-0x1.5555560000000p-30f},{0x1.1111120000000p-7f,-0x1.ddddde0000000p-32f},{0x1.6c16c20000000p-10f,-0x1.27d27e0000000p-35f},{0x1.a01a020000000p-13f,-0x1.7f97fa0000000p-39f},{0x1.a01a020000000p-16f,-0x1.7f97fa0000000p-42f},{0x1.71de3a0000000p-19f,0x1.55b1cc0000000p-45f},{0x1.27e4fc0000000p-22f,-0x1.10ec140000000p-47f},{0x1.ae64560000000p-26f,0x1.fd51380000000p-52f},{0x1.1eed8e0000000p-29f,0x1.ff1b140000000p-54f},{0x1.6124620000000p-33f,-0x1.8af25e0000000p-58f},{0x1.93974a0000000p-37f,0x1.180f940000000p-62f}};
r.hi*=0.25f;r.lo*=0.25f;
GmmDD sum=coefficients[9];
#pragma unroll
for(int i=8;i>=0;--i)sum=gdadd(gdmul(sum,r),coefficients[i]);
sum=gdmul(sum,sum);sum=gdmul(sum,sum);
union { uint32_t bits; float value; } power;
power.bits=(uint32_t)(exponent+127)<<23;
return {gmul(sum.hi,power.value),gmul(sum.lo,power.value)};
}
__aicore__ inline float precise_gelu_round_input(float value) {
union { uint32_t bits; float value; } input;
input.value=value;
if(value>=4.0f && value<=7.0f && (input.bits&8191u)==4096u) {
--input.bits;
return input.value;
}
if(value>=5.0f && value<=7.0f)return value;
if(value>=4.0f && value<=7.0f && (input.bits&8191u)==0)return value;
GmmDD z={value,0.0f};
GmmDD cubic=gdmul(gdmul(z,z),z);
GmmDD u=gdmul(gdadd(z,gdmul(cubic,{0x1.6e4e260000000p-5f,0x1.a9003e0000000p-30f})),{0x1.9884540000000p-1f,-0x1.8579360000000p-26f});
if(u.hi>18.36840028483855f)return value;
if(u.hi< -20.0f)return 0.0f;
bool positive=u.hi>=0.0f;
GmmDD t=gdexp(gdmul(positive?gdneg(u):u,{2.0f,0.0f}));
GmmDD numerator=positive?z:gdmul(z,t);
GmmDD result=gddiv(numerator,gdadd({1.0f,0.0f},t));
union { uint32_t bits; float value; } rounded;
rounded.value=result.hi;
int exponent=(rounded.bits>>23)&255;
int shift=exponent>=113?13:126-exponent;
if(shift>0 && shift<24 && result.lo!=0.0f &&
(rounded.bits&((1u<<shift)-1))==(1u<<(shift-1))) {
bool increase=result.lo>0.0f;
if((result.hi>0.0f)==increase)++rounded.bits;else --rounded.bits;
}
return rounded.value;
}
__aicore__ inline float scalar_tiny_gelu(float value) {
if(value==0.0f)return value;
if(value>=8.0f)return value;
if(value<=-6.0f)return 0.0f;
float u=0.7978845608028654f*(value+0.044715f*value*value*value);
float q=u>0.0f?-2.0f*u:2.0f*u;
int exponent=(int)(q*1.4426950408889634f-0.5f);
float r=(q-exponent*0.693145751953125f)-exponent*1.428606765330187e-6f;
float polynomial=1.0f+r*(1.0f+r*(0.5f+r*(0.1666666666666667f+
r*(0.04166666666666667f+r*(0.008333333333333333f+
r*(0.001388888888888889f+r*0.0001984126984126984f))))));
union { uint32_t bits; float value; } power;
power.bits=(uint32_t)(exponent+127)<<23;
float tail=polynomial*power.value;
float result=value>=0.0f?value/(1.0f+tail):value*tail/(1.0f+tail);
float magnitude=result>=0.0f?result:-result;
if(magnitude>=0x1p-14f && magnitude<1.999f)return result;
union { uint32_t bits; float value; } probe;
probe.value=magnitude<0x1p-14f?magnitude+0x1p-14f:magnitude;
int distance=(int)(probe.bits&8191u)-4096;
if(distance<0)distance=-distance;
if(distance>64)return result;
return precise_gelu_round_input(value);
}
struct GmmPlan {
AscendC::tiling::TCubeTiling cube;
int m,k,n,e,cores,directCube,directTall;
};
constexpr int CUBE_MODE_NONE=0;
constexpr int CUBE_MODE_MID_K=1;
constexpr int CUBE_MODE_WIDE_A=2;
constexpr int TALL_MODE_NONE=0;
constexpr int TALL_MODE_MID_K=1;
constexpr int TALL_MODE_RESIDENT_A=2;
template<typename T>
__aicore__ inline void direct_nd_to_nz(
LocalTensor<T> dst, GlobalTensor<T> src,
uint32_t rows, uint32_t columns, uint32_t sourceStride,
uint32_t alignedRows)
{
Nd2NzParams params;
params.ndNum=1;
params.nValue=rows;
params.dValue=columns;
params.srcNdMatrixStride=0;
params.srcDValue=sourceStride;
params.dstNzC0Stride=alignedRows;
params.dstNzNStride=1;
params.dstNzMatrixStride=0;
DataCopy(dst,src,params);
}
template<typename T>
__aicore__ inline void direct_l1_to_l0a(
LocalTensor<T> dst, LocalTensor<T> src,
uint32_t rows, uint32_t columns, uint32_t alignedRows,
uint32_t sourceColumns=0, uint32_t columnOffset=0)
{
if(sourceColumns==0)sourceColumns=columns;
const uint8_t padding[4]={0,0,0,0};
Load3DSetFMatrixCal(1,alignedRows,padding);
LoadData3DParamsV2Pro params;
params.channelSize=sourceColumns;
params.extConfig=((uint64_t)columnOffset<<32)|
((uint64_t)alignedRows<<16)|(uint64_t)columns;
LoadData<T>(dst,src,params);
}
template<typename T>
__aicore__ inline void direct_l1_to_l0b(
LocalTensor<T> dst, LocalTensor<T> src,
uint32_t rows, uint32_t columns, uint32_t alignedRows)
{
const uint32_t reductionBlocks=(rows+31)/32;
const uint32_t sourceReductionStride=(alignedRows+31)/32;
const uint32_t columnBlocks=(columns+31)/32;
const uint32_t destinationReductionStride=((columns+15)/16)*16*32;
LoadData2dTransposeParams params;
params.startIndex=0;
params.repeatTimes=columnBlocks;
params.srcStride=sourceReductionStride;
params.dstGap=1;
params.dstFracGap=0;
params.addrMode=inc;
for(uint32_t reductionBlock=0;reductionBlock<reductionBlocks;++reductionBlock) {
LoadDataWithTranspose(dst[reductionBlock*destinationReductionStride],
src[reductionBlock*1024],params);
}
}
__aicore__ inline void dense_gelu_chain(LocalTensor<float> z, LocalTensor<float> v, int count) {
if ASCEND_IS_AIV {
auto dst=(__ubuf__ float*)v.GetPhyAddr();
auto src=(__ubuf__ float*)z.GetPhyAddr();
set_mask_count();
set_vector_mask((uint64_t)0,(uint64_t)count);
vmul(dst,src,src,1,1,1,1,8,8,8);PipeBarrier<PIPE_V>();
vmuls(dst,dst,-0.07135481627260091f,1,1,1,8,8);PipeBarrier<PIPE_V>();
vadds(dst,dst,-1.5957691216057308f,1,1,1,8,8);PipeBarrier<PIPE_V>();
vmul(dst,dst,src,1,1,1,1,8,8,8);PipeBarrier<PIPE_V>();
vmins(dst,dst,80.0f,1,1,1,8,8);PipeBarrier<PIPE_V>();
vexp(dst,dst,1,1,1,8,8);PipeBarrier<PIPE_V>();
vadds(dst,dst,1.0f,1,1,1,8,8);PipeBarrier<PIPE_V>();
vdiv(dst,src,dst,1,1,1,1,8,8,8);PipeBarrier<PIPE_V>();
set_mask_norm();
set_vector_mask(~(uint64_t)0,~(uint64_t)0);
}
}
__aicore__ inline void finish_gelu(LocalTensor<float> z, LocalTensor<float> v,
LocalTensor<half> out, int active) {
dense_gelu_chain(z, v, active);
Cast(out, v, RoundMode::CAST_RINT, active);
PipeBarrier<PIPE_V>();
}

struct ExpertTileCursor {
int expert;
int begin;
int end;
int tile;
int tiles;
int sequence;
bool loaded;
};
struct ExpertTileState {
int expert;
int row;
int col;
int firstRow;
int localRows;
int nc;
int slot;
};
template<int BM, int BN, typename GroupTensor>
__aicore__ inline bool next_expert_tile(
ExpertTileCursor &cursor, ExpertTileState &state,
GroupTensor groups, GmmPlan p, int block, int subBlock)
{
int nt=(p.n+BN-1)/BN;
while(cursor.expert<p.e) {
if(!cursor.loaded) {
cursor.begin=cursor.expert==0?0:groups.GetValue(cursor.expert-1);
cursor.end=groups.GetValue(cursor.expert);
int rows=cursor.end-cursor.begin;
cursor.tiles=((rows+BM-1)/BM)*nt;
cursor.tile=0;
cursor.loaded=true;
}
if(cursor.tile<cursor.tiles) {
int tile=cursor.tile++;
int row=cursor.begin+(tile/nt)*BM;
int slice=subBlock*(BM/2);
int firstRow=row+slice;
int remaining=cursor.end-firstRow;
state.expert=cursor.expert;
state.row=row;
state.col=(tile%nt)*BN;
state.firstRow=firstRow;
state.localRows=remaining>0?(remaining<BM/2?remaining:BM/2):0;
state.nc=p.n-state.col<BN?p.n-state.col:BN;
state.slot=cursor.sequence++&1;
return true;
}
cursor.expert+=p.cores;
cursor.loaded=false;
}
return false;
}
template<int BM, int BN, int SIZE>
__aicore__ inline void prefetch_expert_tile(
ExpertTileState state, GlobalTensor<int32_t> scratch,
GlobalTensor<float> scaleGlobal, LocalTensor<int32_t> ciStorage,
LocalTensor<float> scales, TEventID inputReady[2],
TEventID outputFree[2], bool outputPending[2],
TEventID scaleFree, bool &scalePending, int outputWidth)
{
CrossCoreWaitFlag(state.slot);
if(state.localRows<=0) {
CrossCoreSetFlag<2,PIPE_MTE2>(2+state.slot);
return;
}
if(scalePending) {
WaitFlag<HardEvent::V_MTE2>(scaleFree);
scalePending=false;
}
if(outputPending[state.slot]) {
WaitFlag<HardEvent::MTE3_MTE2>(outputFree[state.slot]);
outputPending[state.slot]=false;
}
DataCopyExtParams scaleParams{1,(uint32_t)(state.nc*4),0,0,0};
DataCopyPadExtParams<float> scalePad{true,0,0,0.0f};
DataCopyPad(scales,
scaleGlobal[(int64_t)state.expert*outputWidth+state.col],
scaleParams,scalePad);
int slice=state.firstRow-state.row;
DataCopy(ciStorage[state.slot*SIZE],
scratch[state.slot*BM*BN+slice*BN],state.localRows*BN);
SetFlag<HardEvent::MTE2_V>(inputReady[state.slot]);
CrossCoreSetFlag<2,PIPE_MTE2>(2+state.slot);
}
template<int BN, bool PackTail>
__aicore__ inline void copy_accumulator_rows(
LocalTensor<int32_t> dst, GlobalTensor<int32_t> src, int rows, int rowStride) {
if constexpr (PackTail) {
if (rowStride != BN) {
DataCopyParams gather{(uint16_t)rows, (uint16_t)(rowStride/8),
(uint16_t)((BN-rowStride)/8), 0};
DataCopy(dst,src,gather);
return;
}
}
DataCopy(dst,src,rows*BN);
}
template<int Mode>
__aicore__ inline int shifted_column(int col,int rowTile,int expert,int nt,int cores) {
if constexpr(Mode==0)return col;
int shift=Mode==1?expert%nt:(rowTile*nt/cores)%nt;
int shifted=col+shift;
return shifted<nt?shifted:shifted-nt;
}

template<pipe_t Source, pipe_t Target>
__aicore__ inline void capi_notify(int event) {
asc_sync_notify(Source, Target, static_cast<event_t>(event));
}
template<pipe_t Source, pipe_t Target>
__aicore__ inline void capi_wait(int event) {
asc_sync_wait(Source, Target, static_cast<event_t>(event));
}
template<pipe_t Pipeline, int Mode>
__aicore__ inline void capi_block_arrive(int64_t event) {
uint64_t config = 1ULL | (uint64_t(Mode) << 4) | (uint64_t(event) << 8);
ffts_cross_core_sync(Pipeline, config);
}
enum class CapiSpace { L1, L0A, L0B, L0C };
template<typename Pointer, CapiSpace Space, pipe_t Producer, pipe_t Consumer,
int Depth, int EventBase, bool SeedFreeEvents=false>
struct CapiQueue {
uint32_t address = 0, stride = 0;
int allocations = 0, enqueues = 0, dequeues = 0;
uint32_t freeMask = 0;
static constexpr CapiSpace space = Space;
__aicore__ inline void configure(uint32_t start, uint32_t bytes) {
address = start;
stride = bytes;
if constexpr(SeedFreeEvents)
for(int slot=0;slot<Depth;++slot)capi_notify<Consumer,Producer>(EventBase+slot);
}
__aicore__ inline int NextSlot(int& counter) {
if constexpr (Depth==3) {
int slot=counter;
counter=slot==Depth-1?0:slot+1;
return slot;
} else {
return counter++ & (Depth-1);
}
}
template<typename T>
__aicore__ inline Pointer AllocTensor() {
int slot = NextSlot(allocations);
if constexpr(SeedFreeEvents) {
capi_wait<Consumer,Producer>(EventBase+slot);
} else if (freeMask & (uint32_t(1) << slot)) {
capi_wait<Consumer, Producer>(EventBase + slot);
freeMask &= ~(uint32_t(1) << slot);
}
return reinterpret_cast<Pointer>(static_cast<uint64_t>(address + slot * stride));
}
__aicore__ inline void EnQue(Pointer) {
int slot = NextSlot(enqueues);
if constexpr (Space != CapiSpace::L0C)
capi_notify<Producer, Consumer>(EventBase + slot);
}
template<typename T,bool WaitForProducer=true>
__aicore__ inline Pointer DeQue() {
int slot = NextSlot(dequeues);
if constexpr (WaitForProducer && Space != CapiSpace::L0C)
capi_wait<Producer, Consumer>(EventBase + slot);
return reinterpret_cast<Pointer>(static_cast<uint64_t>(address + slot * stride));
}
__aicore__ inline void FreeTensor(Pointer pointer) {
int slot;
if constexpr (Depth <= 2)
slot = Depth == 1 || reinterpret_cast<uint64_t>(pointer) == address ? 0 : 1;
else
slot = (reinterpret_cast<uint64_t>(pointer)-address)/stride;
ReleaseSlot(slot);
}
__aicore__ inline void ReleaseSlot(int slot) {
capi_notify<Consumer, Producer>(EventBase + slot);
if constexpr(!SeedFreeEvents)freeMask |= uint32_t(1) << slot;
}
__aicore__ inline ~CapiQueue() {
for (int slot = 0; slot < Depth; ++slot) {
if constexpr(SeedFreeEvents)capi_wait<Consumer,Producer>(EventBase+slot);
else if (freeMask & (uint32_t(1) << slot)) capi_wait<Consumer, Producer>(EventBase + slot);
}
}
};
struct CapiBuffer {
uint32_t address = 0;
template<typename T>
__aicore__ inline __ubuf__ T* Get() {
return reinterpret_cast<__ubuf__ T*>(static_cast<uint64_t>(address));
}
};
struct CapiMemory {
uint32_t l1 = 0, l0a = 0, l0b = 0, l0c = 0, ub = 256;
template<typename Queue>
__aicore__ inline void InitBuffer(Queue& queue, int depth, uint32_t bytes) {
uint32_t* cursor = Queue::space == CapiSpace::L1 ? &l1 :
Queue::space == CapiSpace::L0A ? &l0a :
Queue::space == CapiSpace::L0B ? &l0b : &l0c;
bytes = (bytes + 31) & ~31u;
queue.configure(*cursor, bytes);
*cursor += depth * bytes;
}
__aicore__ inline void InitBuffer(CapiBuffer& buffer, uint32_t bytes) {
buffer.address = ub;
ub += (bytes + 31) & ~31u;
}
};
__aicore__ inline void capi_nd_to_nz(__cbuf__ int8_t* dst, __gm__ int8_t* src,
uint32_t rows, uint32_t columns, uint32_t sourceStride, uint32_t alignedRows) {
asc_copy_gm2l1_nd2nz(dst, src, 1, rows, columns, 0, sourceStride, alignedRows, 1, 0);
}
__aicore__ inline void capi_l1_to_l0a(__ca__ int8_t* dst, __cbuf__ int8_t* src,
uint32_t rows, uint32_t columns, uint32_t alignedRows,
uint32_t sourceColumns = 0, uint32_t columnOffset = 0, bool configureMatrix = true) {
if (sourceColumns == 0) sourceColumns = columns;
if (configureMatrix) {
asc_l13d_fmatrix_config matrix{};
matrix.config = (uint64_t(1) << 16) | alignedRows;
asc_set_l13d_fmatrix(matrix);
}
asc_copy_l12l0a(dst, src, columns, alignedRows, columnOffset, 0,
1, 1, 1, 1, 1, 1, false, false, false, false, sourceColumns);
}
__aicore__ inline void capi_l1_to_l0b(__cb__ int8_t* dst, __cbuf__ int8_t* src,
uint32_t rows, uint32_t columns, uint32_t alignedRows) {
uint32_t reductionBlocks = (rows + 31) / 32;
uint32_t sourceStride = (alignedRows + 31) / 32;
uint32_t columnBlocks = (columns + 31) / 32;
uint32_t destinationStride = ((columns + 15) / 16) * 16 * 32;
for (uint32_t block = 0; block < reductionBlocks; ++block)
asc_copy_l12l0b_trans(dst + block * destinationStride, src + block * 1024,
0, columnBlocks, sourceStride, 1, false, 0);
}
template<typename T>
__aicore__ inline void capi_read(__ubuf__ T* dst, __gm__ T* src, uint32_t count) {
asc_copy_gm2ub(dst, src, count * sizeof(T));
}
template<typename T>
__aicore__ inline void capi_write(__gm__ T* dst, __ubuf__ T* src, uint32_t count) {
asc_copy_ub2gm(dst, src, count * sizeof(T));
}
template<typename T>
__aicore__ inline void capi_read_pad(__ubuf__ T* dst, __gm__ T* src,
DataCopyExtParams params, DataCopyPadExtParams<T>) {
asc_copy_gm2ub_align(reinterpret_cast<__ubuf__ uint8_t*>(dst),
reinterpret_cast<__gm__ uint8_t*>(src), params.blockCount, params.blockLen,
0, 0, params.srcStride, params.dstStride);
}
template<typename T>
__aicore__ inline void capi_write_pad(__gm__ T* dst, __ubuf__ T* src, DataCopyExtParams params) {
asc_copy_ub2gm_align(dst, src, params.blockCount, params.blockLen,
0, 0, params.srcStride, params.dstStride);
}
__aicore__ inline void capi_fixpipe(__gm__ int32_t* dst, __cc__ int32_t* src,
FixpipeParamsV220 params) {
asc_set_l0c_copy_params(1, 0, 0);
asc_set_l0c2gm_config(0, 0, true);
asc_copy_l0c2gm(dst, src, params.nSize, params.mSize, params.dstStride,
params.srcStride, params.unitFlag, 0, 0, false, true);
}
__aicore__ inline void capi_finish_dequantized_half_banked(__ubuf__ float* z,
__ubuf__ float* spare, __ubuf__ half* out, int count) {
auto value=reinterpret_cast<__ubuf__ half*>(
(reinterpret_cast<uint64_t>(spare)+511)&~uint64_t(511));
auto alternate=reinterpret_cast<__ubuf__ half*>(
(reinterpret_cast<uint64_t>(z)+511)&~uint64_t(511));
asc_set_mask_count();asc_set_vector_mask(0,count);
asc_mul(value,out,out,1,1,1,1,8,8,8);asc_sync_pipe(PIPE_V);
asc_mul_scalar(alternate,value,half(-0.07135481627260091f),1,1,1,8,8);asc_sync_pipe(PIPE_V);
asc_add_scalar(value,alternate,half(-1.5957691216057308f),1,1,1,8,8);asc_sync_pipe(PIPE_V);
asc_mul(alternate,value,out,1,1,1,1,8,8,8);asc_sync_pipe(PIPE_V);
asc_exp(value,alternate,1,1,1,8,8);asc_sync_pipe(PIPE_V);
asc_add_scalar(alternate,value,half(1.0f),1,1,1,8,8);asc_sync_pipe(PIPE_V);
