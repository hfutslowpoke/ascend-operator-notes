}
template<int BM,int BN,int Mode=0,int PAD=192,int VROWS=0,
bool PackTail=false,int Rotate=0,bool SingleTile=false,bool PrefetchRows=false,
bool ReuseAccumulator=false,int PanelK=0,bool FineTail=false,bool FusedAffine=false,
bool InplaceResidentBPrefetch=false, bool VectorPackWeights=false,int BStages=2,bool PrimeBeforePackWait=false,bool CooperativePack=false,bool CacheExpertActivation=false,bool NarrowHalfScratch=false,bool ColumnDequant=false>
__global__ __aicore__ __schedmode__(1) void gmm_capi_panels_buffered(
GM_ADDR x,GM_ADDR weight,GM_ADDR scale,GM_ADDR groups,
GM_ADDR output,GM_ADDR workspace,GmmPlan p) {
KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
InitSocState();
constexpr bool StageMajorWeights=Mode==4 || NarrowHalfScratch;
constexpr bool DeferredNarrowWeights=NarrowHalfScratch && CooperativePack;
constexpr int BK=(Mode==8 && BN>256)?96:(BN>256?64:128);
