wait_flag(PIPE_MTE1,PIPE_MTE2,EVENT_ID2);CopyWeight(tile,0,plan.k);
set_flag(PIPE_MTE2,PIPE_MTE1,EVENT_ID2);wait_flag(PIPE_MTE2,PIPE_MTE1,EVENT_ID2);
