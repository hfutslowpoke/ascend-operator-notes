} else if constexpr(Mode==3 && ((BM==80 && BN==384) || (BM==96 && BN==320)) && BStages==2) {
const bool useHalfwordPacking=(p.k>1024 && p.k<=1056 && p.n>1024 && p.n<=1056 && (p.n&1)) ||
(p.k>1024 && p.k<=1056 && p.n>768 && p.n<=800 && (p.n&1));
if(useHalfwordPacking)capi_pack_weight_halfwords(next,source,
int64_t(nextExpert)*p.k+nextRow,nextCount,p);
else capi_nd_to_nz(next,source+((int64_t)nextExpert*p.k+nextRow)*p.n,
nextCount,p.n,p.n,(nextCount+31)&~31);
} else capi_nd_to_nz(next,source+((int64_t)nextExpert*p.k+nextRow)*p.n,
nextCount,p.n,p.n,(nextCount+31)&~31);
