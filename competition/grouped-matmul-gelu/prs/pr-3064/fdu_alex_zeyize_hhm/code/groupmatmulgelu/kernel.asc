auto bias=reinterpret_cast<__ubuf__ float*>(uint64_t(185600));
asc_mul_add(v,multiplier,bias,1,1,1,1,8,0,0);asc_sync_pipe(PIPE_V);
asc_mul(temporary,v,z,1,1,1,1,8,8,8);asc_sync_pipe(PIPE_V);
__ubuf__ float* result;
