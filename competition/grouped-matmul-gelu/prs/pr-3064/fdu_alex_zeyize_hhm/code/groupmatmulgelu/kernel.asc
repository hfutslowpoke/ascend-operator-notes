if ASCEND_IS_AIV {
auto inputBits=reinterpret_cast<__ubuf__ uint32_t*>(uint64_t(0));
auto encoded=reinterpret_cast<__ubuf__ uint64_t*>(uint64_t(2048));
const int panels=(p.n+BN-1)/BN;
