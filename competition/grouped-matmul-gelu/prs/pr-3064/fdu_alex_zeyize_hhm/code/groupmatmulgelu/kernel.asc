__aicore__ inline void capi_prepare_shared_coefficients(
GM_ADDR scale,__gm__ uint64_t* quantizedScales,GmmPlan p);
__global__ __aicore__ __schedmode__(1) void gmm_resident_row_halves(
GM_ADDR x,GM_ADDR weight,GM_ADDR scale,GM_ADDR groups,
GM_ADDR output,GM_ADDR workspace,GmmPlan p) {
KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
InitSocState();
constexpr int OuterRows=128,Rows=64,Columns=256,MaxReduction=1024;
constexpr int PanelK=256,Inner=128,WeightSlots=5;
const int panels=p.k/PanelK;
const int block=asc_get_block_idx();
auto ends=reinterpret_cast<__gm__ int64_t*>(groups);
auto a=reinterpret_cast<__gm__ int8_t*>(x);
auto b=reinterpret_cast<__gm__ int8_t*>(weight);
auto scratch=reinterpret_cast<__gm__ int32_t*>(workspace)+block*2*Rows*Columns;
auto quantizedScales=reinterpret_cast<__gm__ uint64_t*>(
reinterpret_cast<__gm__ int8_t*>(workspace)+int64_t(p.cores)*2*Rows*Columns*4);
int totalRows=0,scan=0;
for(int expert=0;expert<p.e;++expert) {
const int end=ends[expert];
totalRows+=(end-scan+OuterRows-1)/OuterRows;scan=end;
}
const int lanes=totalRows<=p.cores && 2*totalRows>p.cores?1:2;
const int nt=p.n/Columns;
CapiMemory memory;
if ASCEND_IS_AIC {
CapiQueue<__cbuf__ int8_t*,CapiSpace::L1,PIPE_MTE2,PIPE_MTE1,1,0> aq;
CapiQueue<__ca__ int8_t*,CapiSpace::L0A,PIPE_MTE1,PIPE_M,2,0> a0q;
CapiQueue<__cb__ int8_t*,CapiSpace::L0B,PIPE_MTE1,PIPE_M,2,2> b0q;
CapiQueue<__cc__ int32_t*,CapiSpace::L0C,PIPE_M,PIPE_FIX,2,0> cq;
memory.InitBuffer(aq,1,OuterRows*MaxReduction);
memory.l1+=32;
const uint64_t weightBase=memory.l1;
constexpr int WeightStride=PanelK*Columns+32;
memory.l1+=WeightSlots*WeightStride;
auto quantizedLocal=reinterpret_cast<__cbuf__ uint64_t*>(uint64_t(memory.l1));
memory.l1+=p.n*8;
bool coefficientsReady=false;
memory.InitBuffer(a0q,2,Rows*Inner);
memory.InitBuffer(b0q,2,Inner*Columns);
memory.InitBuffer(cq,2,Rows*Columns*4);
int begin=0,rowBase=0,produced=0;
for(int expert=0;expert<p.e;++expert) {
const int end=ends[expert],rowTiles=(end-begin+OuterRows-1)/OuterRows;
for(int rt=0;rt<rowTiles;++rt)for(int lane=0;lane<lanes;++lane) {
if((rowBase+rt+lane*totalRows)%p.cores!=block)continue;
const int row=begin+rt*OuterRows;
const int nr=end-row<OuterRows?end-row:OuterRows;
const int alignedRows=(nr+15)&~15;
const int owned=(nt-lane+lanes-1)/lanes;
if(owned<=0)continue;
auto fullA=aq.AllocTensor<int8_t>();
capi_nd_to_nz(fullA,a+(int64_t)row*p.k,nr,p.k,p.k,alignedRows);
aq.EnQue(fullA);
for(int id=0;id<WeightSlots && id<owned*panels;++id) {
const int tile=lane+(id/panels)*lanes;
const int col=shifted_column<1>(tile,rowBase+rt,expert,nt,p.cores)*Columns;
auto dst=reinterpret_cast<__cbuf__ int8_t*>(weightBase+id*WeightStride);
capi_nd_to_nz(dst,b+((int64_t)expert*p.k+(id%panels)*PanelK)*p.n+col,
PanelK,Columns,p.n,PanelK);
capi_notify<PIPE_MTE2,PIPE_MTE1>(2+id);
}
fullA=aq.DeQue<int8_t>();
if(!coefficientsReady){asc_sync_block_wait(5);coefficientsReady=true;}
capi_notify<PIPE_FIX,PIPE_MTE2>(7);capi_wait<PIPE_FIX,PIPE_MTE2>(7);
asc_copy_gm2l1(reinterpret_cast<__cbuf__ int8_t*>(quantizedLocal),
reinterpret_cast<__gm__ int8_t*>(quantizedScales+int64_t(expert)*p.n),
1,p.n/4,0,0);
capi_notify<PIPE_MTE2,PIPE_FIX>(7);capi_wait<PIPE_MTE2,PIPE_FIX>(7);
uint32_t freed=0;
asc_l13d_fmatrix_config matrix{};
matrix.config=(uint64_t(1)<<16)|alignedRows;
asc_set_l13d_fmatrix(matrix);
for(int local=0;local<owned;++local) {
for(int rowHalf=0;rowHalf<2;++rowHalf) {
const int remaining=nr-rowHalf*Rows;
const int halfRows=remaining<=0?0:(remaining<Rows?remaining:Rows);
const int halfAligned=(halfRows+15)&~15;
const int outputSlot=produced&1;
auto accumulator=cq.AllocTensor<int32_t>();
for(int quarter=0;quarter<panels;++quarter) {
const int id=local*panels+quarter,slot=id%WeightSlots;
auto weights=reinterpret_cast<__cbuf__ int8_t*>(weightBase+slot*WeightStride);
if(rowHalf==0)capi_wait<PIPE_MTE2,PIPE_MTE1>(2+slot);
if(halfRows>0)for(int inner=0;inner<PanelK;inner+=Inner) {
auto left=a0q.AllocTensor<int8_t>();
auto right=b0q.AllocTensor<int8_t>();
asc_copy_l12l0a(left,fullA,Inner,halfAligned,quarter*PanelK+inner,rowHalf*Rows,
1,1,1,1,1,1,false,false,false,false,p.k);
capi_l1_to_l0b(right,weights+inner*32,Inner,Columns,PanelK);
a0q.EnQue(left);b0q.EnQue(right);
left=a0q.DeQue<int8_t>();right=b0q.DeQue<int8_t>();
asc_mmad(accumulator,left,right,halfRows==1?16:halfRows,
Inner,Columns,0,false,false,quarter==0 && inner==0);
a0q.FreeTensor(left);b0q.FreeTensor(right);
}
if(rowHalf==1) {
capi_notify<PIPE_MTE1,PIPE_MTE2>(2+slot);
freed|=uint32_t(1)<<slot;
const int future=id+WeightSlots;
if(future<owned*panels) {
const int tile=lane+(future/panels)*lanes;
const int col=shifted_column<1>(tile,rowBase+rt,expert,nt,p.cores)*Columns;
capi_wait<PIPE_MTE1,PIPE_MTE2>(2+slot);
freed&=~(uint32_t(1)<<slot);
capi_nd_to_nz(weights,b+((int64_t)expert*p.k+(future%panels)*PanelK)*p.n+col,
PanelK,Columns,p.n,PanelK);
capi_notify<PIPE_MTE2,PIPE_MTE1>(2+slot);
}
}
}
cq.EnQue(accumulator);accumulator=cq.DeQue<int32_t>();
capi_notify<PIPE_M,PIPE_FIX>(outputSlot);
capi_wait<PIPE_M,PIPE_FIX>(outputSlot);
if(produced>=2)asc_sync_block_wait(2+outputSlot);
if(halfRows>0) {
FixpipeParamsV220 copy;
copy.nSize=Columns;copy.mSize=halfRows;copy.srcStride=halfAligned;
copy.dstStride=Columns;copy.ndNum=1;copy.srcNdStride=0;
copy.dstNdStride=0;copy.unitFlag=0;
const int tile=lane+local*lanes;
const int col=shifted_column<1>(tile,rowBase+rt,expert,nt,p.cores)*Columns;
asc_copy_l12fb(reinterpret_cast<__fbuf__ void*>(uint64_t(0)),
reinterpret_cast<__cbuf__ void*>(quantizedLocal+col),1,Columns/16,0,0);
asc_sync_pipe(PIPE_FIX);
asc_set_l0c_copy_params(1,0,0);
asc_set_l0c2gm_config(0,0,true);
asc_copy_l0c2gm(reinterpret_cast<__gm__ half*>(scratch+outputSlot*Rows*Columns),
accumulator,Columns,halfRows,Columns,halfAligned,0,
static_cast<uint8_t>(QuantMode_t::VDEQF16),0,false,true);
}
cq.FreeTensor(accumulator);
capi_block_arrive<PIPE_FIX,2>(outputSlot);
++produced;
}
}
for(int slot=0;slot<WeightSlots;++slot)
if(freed&(uint32_t(1)<<slot))capi_wait<PIPE_MTE1,PIPE_MTE2>(2+slot);
aq.FreeTensor(fullA);
}
begin=end;rowBase+=rowTiles;
}
if(!coefficientsReady)asc_sync_block_wait(5);
for(int slot=0;slot<(produced<2?produced:2);++slot)asc_sync_block_wait(2+slot);
} else {
capi_prepare_shared_coefficients(scale,quantizedScales,p);
constexpr int VectorRows=Rows/2,Count=VectorRows*Columns;
CapiBuffer cb,zb,vb,tb,sb;
memory.InitBuffer(cb,2*Count*4+256);
memory.InitBuffer(zb,Count*4+256);memory.InitBuffer(vb,Count*4+256);
memory.InitBuffer(tb,Count*4+256);memory.InitBuffer(sb,Columns*4+256);
auto accum=cb.Get<int32_t>();auto z=zb.Get<float>();auto v=vb.Get<float>();
auto t=tb.Get<float>();auto coefficients=sb.Get<float>();
asc_duplicate(reinterpret_cast<__ubuf__ float*>(uint64_t(185344)),-0.07135481627260091f,64);
asc_duplicate(reinterpret_cast<__ubuf__ float*>(uint64_t(185600)),-1.5957691216057308f,64);
asc_sync_pipe(PIPE_V);
auto destination=reinterpret_cast<__gm__ half*>(output);
auto scales=reinterpret_cast<__gm__ float*>(scale);
bool pending[2]={false,false};bool scalePending=false;
int begin=0,rowBase=0,consumed=0;
for(int expert=0;expert<p.e;++expert) {
const int end=ends[expert],rowTiles=(end-begin+OuterRows-1)/OuterRows;
for(int rt=0;rt<rowTiles;++rt)for(int lane=0;lane<lanes;++lane) {
if((rowBase+rt+lane*totalRows)%p.cores!=block)continue;
const int row=begin+rt*OuterRows;
for(int tile=lane;tile<nt;tile+=lanes) {
const int col=shifted_column<1>(tile,rowBase+rt,expert,nt,p.cores)*Columns;
for(int rowHalf=0;rowHalf<2;++rowHalf) {
const int slot=consumed++&1;
const int first=row+rowHalf*Rows+asc_get_sub_block_id()*VectorRows;
const int limit=end<row+(rowHalf+1)*Rows?end:row+(rowHalf+1)*Rows;
const int nr=limit-first<=0?0:(limit-first<VectorRows?limit-first:VectorRows);
asc_sync_block_wait(slot);
if(nr<=0){capi_block_arrive<PIPE_MTE2,2>(2+slot);continue;}
if(pending[slot]){capi_wait<PIPE_MTE3,PIPE_MTE2>(slot);pending[slot]=false;}
auto local=accum+slot*Count;
capi_read(reinterpret_cast<__ubuf__ half*>(local),
reinterpret_cast<__gm__ half*>(scratch+slot*Rows*Columns)+asc_get_sub_block_id()*Count,nr*Columns);
capi_notify<PIPE_MTE2,PIPE_V>(slot);
capi_block_arrive<PIPE_MTE2,2>(2+slot);
capi_wait<PIPE_MTE2,PIPE_V>(slot);
asc_half2float(z,reinterpret_cast<__ubuf__ half*>(local),nr*Columns);asc_sync_pipe(PIPE_V);
auto result=reinterpret_cast<__ubuf__ half*>(local);
case2_finish_gelu_affine(z,v,t,result,nr*Columns);
capi_notify<PIPE_V,PIPE_MTE3>(0);capi_wait<PIPE_V,PIPE_MTE3>(0);
DataCopyExtParams store{(uint16_t)nr,Columns*2,0,(uint32_t)((p.n-Columns)*2),0};
capi_write_pad(destination+(int64_t)first*p.n+col,result,store);
capi_notify<PIPE_MTE3,PIPE_MTE2>(slot);pending[slot]=true;
}
}
}
begin=end;rowBase+=rowTiles;
}
if(scalePending)capi_wait<PIPE_V,PIPE_MTE2>(1);
for(int slot=0;slot<2;++slot)if(pending[slot])capi_wait<PIPE_MTE3,PIPE_MTE2>(slot);
}
}
template<int BM, int BN, int PAD=160, bool EXPERT=false, int VROWS=0, bool AdaptiveOwners=false, bool PackTail=false, int Rotate=0, int ResidentBSpacing=0, int WideWeightStages=2, int ExpertWeightReuse=0, bool ContiguousExperts=false, int ExpertReductionSlices=0>
__global__ __aicore__ __schedmode__(1) void gmm_capi(
GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groups,
GM_ADDR output, GM_ADDR workspace, GmmPlan p)
{
KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
constexpr bool TALL_MANUAL_TEMPLATE=BM==128 && BN==256 && !EXPERT;
constexpr bool WIDE_A_REUSE_TEMPLATE=BM==64 && BN==512 && !EXPERT && VROWS==0;
constexpr int VM=BM/2<8192/BN?BM/2:8192/BN;
constexpr int CHUNK=VROWS>0 && VROWS<VM?VROWS:VM;
constexpr int SIZE=CHUNK*BN;
constexpr bool CROSS_TILE=EXPERT && CHUNK==BM/2;
constexpr bool FULL_EXPERT_COLUMNS=ContiguousExperts && ExpertReductionSlices>0;
constexpr bool BUFFERED_GELU=CROSS_TILE || WIDE_A_REUSE_TEMPLATE ||
(TALL_MANUAL_TEMPLATE && AdaptiveOwners);
int block=asc_get_block_idx();
InitSocState();
CapiMemory pipe;
auto a = reinterpret_cast<__gm__ int8_t*>(x);
auto b = reinterpret_cast<__gm__ int8_t*>(weight);
auto scratch = reinterpret_cast<__gm__ int32_t*>(workspace) + (int64_t)block*2*BM*BN;
auto gg = reinterpret_cast<__gm__ int64_t*>(groups);
if ASCEND_IS_AIC {
if constexpr(EXPERT && BM==64 && BN==256) {
constexpr bool KeepExpertL0B=ExpertWeightReuse==2;
constexpr bool KeepExpertL1B=ExpertWeightReuse!=0;
constexpr int BK=KeepExpertL0B?256:128;
constexpr int MAX_K=KeepExpertL0B?256:512;
constexpr int L0BDepth=KeepExpertL0B?1:2;
static_assert(ExpertReductionSlices==0 || !KeepExpertL1B);
const int reduction=p.k;
const int expertWidth=p.n;
CapiQueue<__cbuf__ int8_t*, CapiSpace::L1, PIPE_MTE2, PIPE_MTE1, 2, 0> a1Queue;
CapiQueue<__ca__ int8_t*, CapiSpace::L0A, PIPE_MTE1, PIPE_M, 2, 0> a2Queue;
CapiQueue<__cbuf__ int8_t*, CapiSpace::L1, PIPE_MTE2, PIPE_MTE1, 2, 2> b1Queue;
CapiQueue<__cb__ int8_t*, CapiSpace::L0B, PIPE_MTE1, PIPE_M, L0BDepth, 2> b2Queue;
CapiQueue<__cc__ int32_t*, CapiSpace::L0C, PIPE_M, PIPE_FIX, 2, 0> cQueue;
pipe.InitBuffer(a1Queue,2,BM*MAX_K);
pipe.InitBuffer(a2Queue,2,BM*BK);
pipe.InitBuffer(b1Queue,2,MAX_K*BN);
pipe.InitBuffer(b2Queue,L0BDepth,BK*BN);
static_assert(2*BM*BN*sizeof(int32_t)<=128*1024,
"Both accumulators must fit L0C");
pipe.InitBuffer(cQueue,2,BM*BN*4);
int produced=0;
__cbuf__ int8_t* heldL1B=nullptr;
__cb__ int8_t* heldL0B=nullptr;
int expert=ContiguousExperts?p.e*block/p.cores:block;
int expertStop=ContiguousExperts?p.e*(block+1)/p.cores:p.e;
int tile=0;
int begin=0,end=0,tiles=0;
while(expert<expertStop) {
begin=expert==0?0:gg[expert-1];
end=gg[expert];
tiles=(end-begin+BM-1)>>6;
if(tiles>0)break;
expert+=ContiguousExperts?1:p.cores;
}
if(expert<expertStop) {
int row=begin+tile*BM;
constexpr int col=0;
int nr=end-row<BM?end-row:BM;
int nc=expertWidth;
int alignedRows=(nr+15)&~15;
auto initialA=a1Queue.template AllocTensor<int8_t>();
capi_nd_to_nz(initialA,(a + ((int64_t)row*reduction)),nr,reduction,
reduction,alignedRows);
a1Queue.EnQue(initialA);
auto initialB=b1Queue.template AllocTensor<int8_t>();
capi_nd_to_nz(initialB,
(b + ((int64_t)expert*reduction*expertWidth+col)),
reduction,nc,expertWidth,reduction);
b1Queue.EnQue(initialB);
}
while(expert<expertStop) {
int row=begin+tile*BM;
constexpr int col=0;
int nr=end-row<BM?end-row:BM;
int nc=expertWidth;
int alignedRows=(nr+15)&~15;
auto a1=a1Queue.template DeQue<int8_t>();
if(!KeepExpertL1B || tile==0)heldL1B=b1Queue.template DeQue<int8_t>();
auto b1=heldL1B;
int nextExpert=expert;
int nextTile=tile+1;
int nextBegin=begin,nextEnd=end,nextTiles=tiles;
if(nextTile>=tiles) {
nextTile=0;
do {
nextExpert+=ContiguousExperts?1:p.cores;
if(nextExpert>=expertStop)break;
if constexpr(ContiguousExperts)nextBegin=nextEnd;
else nextBegin=nextExpert==0?0:gg[nextExpert-1];
nextEnd=gg[nextExpert];
nextTiles=(nextEnd-nextBegin+BM-1)>>6;
} while(nextTiles==0);
}
if(nextExpert<expertStop) {
int nextRow=nextBegin+nextTile*BM;
constexpr int nextCol=0;
int nextNr=nextEnd-nextRow<BM?nextEnd-nextRow:BM;
int nextNc=expertWidth;
int nextAlignedRows=(nextNr+15)&~15;
auto nextA=a1Queue.template AllocTensor<int8_t>();
capi_nd_to_nz(nextA,(a + ((int64_t)nextRow*reduction)),nextNr,
reduction,reduction,nextAlignedRows);
a1Queue.EnQue(nextA);
if(!KeepExpertL1B || nextExpert!=expert) {
auto nextB=b1Queue.template AllocTensor<int8_t>();
capi_nd_to_nz(nextB,
(b + ((int64_t)nextExpert*reduction*expertWidth+nextCol)),
reduction,nextNc,expertWidth,reduction);
b1Queue.EnQue(nextB);
}
}
int slot=(produced++)&1;
auto c=cQueue.AllocTensor<int32_t>();
if constexpr(KeepExpertL0B) {
auto a2=a2Queue.AllocTensor<int8_t>();
capi_l1_to_l0a(a2,a1,nr,reduction,alignedRows,reduction,0);
a2Queue.EnQue(a2);
a1Queue.FreeTensor(a1);
if(tile==0) {
auto b2=b2Queue.template AllocTensor<int8_t>();
capi_l1_to_l0b(b2,b1,reduction,nc,reduction);
b2Queue.EnQue(b2);
b1Queue.FreeTensor(b1);
heldL0B=b2Queue.template DeQue<int8_t>();
}
a2=a2Queue.DeQue<int8_t>();
asc_mmad(c,a2,heldL0B,nr==1?16:nr,reduction,nc,0,false,false,true);
a2Queue.FreeTensor(a2);
if(nextExpert!=expert)b2Queue.FreeTensor(heldL0B);
} else {
auto firstA2=a2Queue.AllocTensor<int8_t>();
auto firstB2=b2Queue.template AllocTensor<int8_t>();
capi_l1_to_l0a(firstA2,a1,nr,BK,alignedRows,reduction,0);
capi_l1_to_l0b(firstB2,b1,BK,nc,reduction);
a2Queue.EnQue(firstA2);
b2Queue.EnQue(firstB2);
for(int inner=0;inner<reduction;inner+=BK) {
auto a2=a2Queue.DeQue<int8_t>();
auto b2=b2Queue.template DeQue<int8_t>();
MmadParams params;
params.m=nr==1?16:nr;
params.n=nc;
params.k=BK;
params.cmatrixInitVal=inner==0;
params.unitFlag=0;
asc_mmad(c,a2,b2,params.m,params.k,params.n,params.unitFlag,false,false,params.cmatrixInitVal);
a2Queue.FreeTensor(a2);
b2Queue.FreeTensor(b2);
if(inner+BK<reduction) {
auto nextA2=a2Queue.AllocTensor<int8_t>();
auto nextB2=b2Queue.template AllocTensor<int8_t>();
capi_l1_to_l0a(nextA2,a1,nr,BK,alignedRows,
reduction,inner+BK,false);
capi_l1_to_l0b(nextB2,(b1 + ((inner+BK)*32)),
BK,nc,reduction);
a2Queue.EnQue(nextA2);
b2Queue.EnQue(nextB2);
}
}
a1Queue.FreeTensor(a1);
if(!KeepExpertL1B || nextExpert!=expert)b1Queue.FreeTensor(b1);
}
cQueue.EnQue(c);
c=cQueue.DeQue<int32_t>();
FixpipeParamsV220 outputParams;
outputParams.nSize=nc;
outputParams.mSize=nr;
outputParams.srcStride=alignedRows;
outputParams.dstStride=BN;
outputParams.ndNum=1;
outputParams.srcNdStride=0;
outputParams.dstNdStride=0;
outputParams.unitFlag=0;
capi_notify<PIPE_M,PIPE_FIX>(slot);
capi_wait<PIPE_M,PIPE_FIX>(slot);
if(produced>2)asc_sync_block_wait(2+slot);
capi_fixpipe((scratch + (slot*BM*BN)),c,outputParams);
cQueue.FreeTensor(c);
capi_block_arrive<PIPE_FIX,2>(slot);
expert=nextExpert;
tile=nextTile;
begin=nextBegin;
end=nextEnd;
tiles=nextTiles;
}
if(produced>=1)asc_sync_block_wait(2);
if(produced>=2)asc_sync_block_wait(3);
} else if(WIDE_A_REUSE_TEMPLATE && p.directCube==CUBE_MODE_WIDE_A) {
constexpr int BK=64, KP=WideWeightStages>=3?192:256, MAX_K=2048;
static_assert(WideWeightStages>=2 && WideWeightStages<=4,
"The resident activation path supports two to four weight panels");
CapiQueue<__cbuf__ int8_t*, CapiSpace::L1, PIPE_MTE2, PIPE_MTE1, 1, 0> a1Queue;
CapiQueue<__ca__ int8_t*, CapiSpace::L0A, PIPE_MTE1, PIPE_M, 2, 0> a2Queue;
CapiQueue<__cbuf__ int8_t*, CapiSpace::L1, PIPE_MTE2, PIPE_MTE1, WideWeightStages, 2> b1Queue;
CapiQueue<__cb__ int8_t*, CapiSpace::L0B, PIPE_MTE1, PIPE_M, 2, 2> b2Queue;
CapiQueue<__cc__ int32_t*, CapiSpace::L0C, PIPE_M, PIPE_FIX, 1, 0> cQueue;
pipe.InitBuffer(a1Queue,1,BM*MAX_K);
pipe.InitBuffer(a2Queue,2,BM*BK);
pipe.InitBuffer(b1Queue,WideWeightStages,KP*BN);
pipe.InitBuffer(b2Queue,2,BK*BN);
pipe.InitBuffer(cQueue,1,BM*BN*4);
int produced=0;
int begin=0,nt=(p.n+BN-1)/BN,firstUnit=block;
for(int e=0;e<p.e;++e) {
int end=gg[e],rows=end-begin;
int units=(rows+BM-1)/BM;
for(int unit=firstUnit;unit<units;unit+=p.cores) {
int row=begin+unit*BM;
int nr=end-row<BM?end-row:BM;
int alignedRows=(nr+15)/16*16;
auto fullA=a1Queue.template AllocTensor<int8_t>();
capi_nd_to_nz(fullA,(a + ((int64_t)row*p.k)),nr,p.k,p.k,alignedRows);
a1Queue.EnQue(fullA);
fullA=a1Queue.template DeQue<int8_t>();
int preloaded=0;
for(int columnTile=0;columnTile<nt;++columnTile) {
#if !GMM_OPT_LATE_DIRECT_WAIT
if(produced>=2)asc_sync_block_wait(1);
#endif
int slot=(produced++)&1;
int phase=nt==2?(e&1):0;
int col=(columnTile^phase)*BN,nc=p.n-col<BN?p.n-col:BN;
auto c=cQueue.AllocTensor<int32_t>();
for(int prime=preloaded*KP;prime<(WideWeightStages-1)*KP && prime<p.k;prime+=KP) {
int count=p.k-prime<KP?p.k-prime:KP;
auto firstB=b1Queue.template AllocTensor<int8_t>();
capi_nd_to_nz(firstB,b+((int64_t)e*p.k+prime)*p.n+col,
count,nc,p.n,count);
b1Queue.EnQue(firstB);
}
preloaded=0;
for(int panel=0;panel<p.k;panel+=KP) {
int panelK=p.k-panel<KP?p.k-panel:KP;
auto b1=b1Queue.template DeQue<int8_t>();
int nextPanel=panel+(WideWeightStages-1)*KP;
if(nextPanel<p.k) {
int nextK=p.k-nextPanel<KP?p.k-nextPanel:KP;
auto nextB=b1Queue.template AllocTensor<int8_t>();
capi_nd_to_nz(nextB,
(b + ((int64_t)e*p.k*p.n+(int64_t)nextPanel*p.n+col)),
nextK,nc,p.n,nextK);
b1Queue.EnQue(nextB);
} else if constexpr (WideWeightStages>=3) {
if(columnTile+1<nt && preloaded<WideWeightStages-1 &&
preloaded*KP<p.k) {
int nextCol=((columnTile+1)^phase)*BN;
int width=p.n-nextCol<BN?p.n-nextCol:BN;
int offset=preloaded*KP;
int count=p.k-offset<KP?p.k-offset:KP;
auto future=b1Queue.template AllocTensor<int8_t>();
capi_nd_to_nz(future,b+((int64_t)e*p.k+offset)*p.n+nextCol,
count,width,p.n,count);
b1Queue.EnQue(future);
++preloaded;
}
}
auto firstA2=a2Queue.AllocTensor<int8_t>();
auto firstB2=b2Queue.AllocTensor<int8_t>();
capi_l1_to_l0a(firstA2,fullA,nr,BK,alignedRows,p.k,panel,panel==0);
capi_l1_to_l0b(firstB2,b1,BK,nc,panelK);
a2Queue.EnQue(firstA2);b2Queue.EnQue(firstB2);
for(int inner=0;inner<panelK;inner+=BK) {
auto a2=a2Queue.DeQue<int8_t>();
auto b2=b2Queue.DeQue<int8_t>();
MmadParams params;
params.m=nr==1?16:nr;params.n=nc;params.k=BK;
params.cmatrixInitVal=panel==0 && inner==0;
params.unitFlag=panel+inner+BK==p.k?3:2;
asc_mmad(c,a2,b2,params.m,params.k,params.n,params.unitFlag,false,false,params.cmatrixInitVal);
a2Queue.FreeTensor(a2);b2Queue.FreeTensor(b2);
int nextInner=inner+BK;
if(nextInner<panelK) {
auto nextA2=a2Queue.AllocTensor<int8_t>();
auto nextB2=b2Queue.AllocTensor<int8_t>();
capi_l1_to_l0a(nextA2,fullA,nr,BK,alignedRows,
p.k,panel+nextInner,false);
capi_l1_to_l0b(nextB2,(b1 + (nextInner*32)),
BK,nc,panelK);
a2Queue.EnQue(nextA2);b2Queue.EnQue(nextB2);
}
}
b1Queue.FreeTensor(b1);
}
cQueue.EnQue(c);c=cQueue.DeQue<int32_t>();
FixpipeParamsV220 outputParams;
outputParams.nSize=nc;outputParams.mSize=nr;
outputParams.srcStride=alignedRows;outputParams.dstStride=BN;
outputParams.ndNum=1;outputParams.srcNdStride=0;
outputParams.dstNdStride=0;outputParams.unitFlag=3;
#if GMM_OPT_LATE_DIRECT_WAIT
if(produced>2)asc_sync_block_wait(1);
#endif
capi_fixpipe((scratch + (slot*BM*BN)),c,outputParams);
cQueue.FreeTensor(c);
capi_block_arrive<PIPE_FIX,2>(0);
}
a1Queue.FreeTensor(fullA);
}
begin=end;
firstUnit-=units%p.cores;
if(firstUnit<0)firstUnit+=p.cores;
}
for(int pending=0;pending<(produced<2?produced:2);++pending)
asc_sync_block_wait(1);
} else if(TALL_MANUAL_TEMPLATE && p.directTall==TALL_MODE_RESIDENT_A) {
constexpr bool CarryWeights=AdaptiveOwners && ResidentBSpacing>0 && WideWeightStages==3;
constexpr int BK=128, MAX_K=2048;
constexpr int KP=CarryWeights?384:(AdaptiveOwners?256:384);
constexpr int WeightDepth=CarryWeights?3:2;
constexpr int FirstPanel=CarryWeights?256:KP;
CapiQueue<__cbuf__ int8_t*, CapiSpace::L1, PIPE_MTE2, PIPE_MTE1, 1, 0> a1Queue;
CapiQueue<__ca__ int8_t*, CapiSpace::L0A, PIPE_MTE1, PIPE_M, 2, 0> a2Queue;
CapiQueue<__cbuf__ int8_t*, CapiSpace::L1, PIPE_MTE2, PIPE_MTE1, WeightDepth, 2> b1Queue;
CapiQueue<__cb__ int8_t*, CapiSpace::L0B, PIPE_MTE1, PIPE_M, 2, 2> b2Queue;
CapiQueue<__cc__ int32_t*, CapiSpace::L0C, PIPE_M, PIPE_FIX, 1, 0> cQueue;
pipe.InitBuffer(a1Queue,1,BM*(CarryWeights?p.k:MAX_K));
pipe.InitBuffer(a2Queue,2,BM*BK);
pipe.l1+=ResidentBSpacing;
pipe.InitBuffer(b1Queue,WeightDepth,KP*BN+ResidentBSpacing);
pipe.InitBuffer(b2Queue,2,BK*BN);
pipe.InitBuffer(cQueue,1,BM*BN*4);
int totalRowTiles=0,scanBegin=0;
int releasedWeight=0;
for(int e=0;e<p.e;++e) {
int scanEnd=gg[e];
totalRowTiles+=(scanEnd-scanBegin+BM-1)/BM;
scanBegin=scanEnd;
}
int lanes=AdaptiveOwners && totalRowTiles<=p.cores &&
totalRowTiles*2>p.cores?1:2;
int produced=0;
int begin=0,nt=(p.n+BN-1)/BN,rowTileBase=0;
for(int e=0;e<p.e;++e) {
int end=gg[e],rows=end-begin;
int rowTiles=(rows+BM-1)/BM,units=rowTiles*lanes;
for(int unit=0;unit<units;++unit) {
int localRowTile=unit/lanes,lane=unit%lanes;
int owner=(rowTileBase+localRowTile+
lane*totalRowTiles)%p.cores;
if(owner!=block)continue;
int row=begin+localRowTile*BM;
int nr=end-row<BM?end-row:BM;
int alignedRows=(nr+15)/16*16;
auto fullA=a1Queue.template AllocTensor<int8_t>();
capi_nd_to_nz(fullA,(a + ((int64_t)row*p.k)),
nr,p.k,p.k,alignedRows);
a1Queue.EnQue(fullA);
if constexpr(!CarryWeights)fullA=a1Queue.template DeQue<int8_t>();
int preloaded=0;
for(int columnTile=lane;columnTile<nt;
columnTile+=lanes) {
#if !GMM_OPT_LATE_DIRECT_WAIT
if(produced>=2)asc_sync_block_wait(1);
#endif
int slot=(produced++)&1;
int col=shifted_column<Rotate>(
columnTile,rowTileBase+localRowTile,e,nt,p.cores)*BN;
int nc=p.n-col<BN?p.n-col:BN;
auto c=cQueue.AllocTensor<int32_t>();
for(int prime=preloaded;prime<WeightDepth-1;++prime) {
int offset=resident_panel_start<FirstPanel,KP>(prime);
if(offset>=p.k)break;
int size=prime==0?FirstPanel:KP;
int initialK=p.k-offset<size?p.k-offset:size;
auto initialB=b1Queue.template AllocTensor<int8_t>();
capi_nd_to_nz(initialB,b+((int64_t)e*p.k+offset)*p.n+col,
initialK,nc,p.n,initialK);
b1Queue.EnQue(initialB);
}
if constexpr(CarryWeights)
if(columnTile==lane)fullA=a1Queue.template DeQue<int8_t>();
preloaded=0;
int panel=0;
for(int index=0;panel<p.k;++index,panel=resident_panel_start<FirstPanel,KP>(index)) {
int size=index==0?FirstPanel:KP;
int panelK=p.k-panel<size?p.k-panel:size;
auto b1=b1Queue.template DeQue<int8_t>();
int nextPanel=resident_panel_start<FirstPanel,KP>(index+WeightDepth-1);
if(nextPanel<p.k) {
int nextK=p.k-nextPanel<KP?p.k-nextPanel:KP;
auto nextB=b1Queue.template AllocTensor<int8_t>();
capi_nd_to_nz(nextB,
(b + ((int64_t)e*p.k*p.n+
(int64_t)nextPanel*p.n+col)),
nextK,nc,p.n,nextK);
b1Queue.EnQue(nextB);
} else if constexpr(CarryWeights) {
int nextColumnTile=columnTile+lanes;
int offset=resident_panel_start<FirstPanel,KP>(preloaded);
if(nextColumnTile<nt && preloaded<WeightDepth-1 && offset<p.k) {
int nextCol=shifted_column<Rotate>(
nextColumnTile,rowTileBase+localRowTile,e,nt,p.cores)*BN;
int nextWidth=p.n-nextCol<BN?p.n-nextCol:BN;
int width=preloaded==0?FirstPanel:KP;
int nextK=p.k-offset<width?p.k-offset:width;
auto nextB=b1Queue.template AllocTensor<int8_t>();
capi_nd_to_nz(nextB,b+((int64_t)e*p.k+offset)*p.n+nextCol,
nextK,nextWidth,p.n,nextK);
b1Queue.EnQue(nextB);
++preloaded;
}
}
auto firstA2=a2Queue.AllocTensor<int8_t>();
auto firstB2=b2Queue.AllocTensor<int8_t>();
capi_l1_to_l0a(firstA2,fullA,nr,BK,alignedRows,
p.k,panel);
capi_l1_to_l0b(firstB2,b1,BK,nc,panelK);
a2Queue.EnQue(firstA2);b2Queue.EnQue(firstB2);
for(int inner=0;inner<panelK;inner+=BK) {
auto a2=a2Queue.DeQue<int8_t>();
auto b2=b2Queue.DeQue<int8_t>();
MmadParams params;
params.m=nr==1?16:nr;params.n=nc;params.k=BK;
params.cmatrixInitVal=panel==0 && inner==0;
params.unitFlag=panel+inner+BK==p.k?3:2;
asc_mmad(c,a2,b2,params.m,params.k,params.n,params.unitFlag,false,false,params.cmatrixInitVal);
a2Queue.FreeTensor(a2);b2Queue.FreeTensor(b2);
int nextInner=inner+BK;
if(nextInner<panelK) {
auto nextA2=a2Queue.AllocTensor<int8_t>();
auto nextB2=b2Queue.AllocTensor<int8_t>();
capi_l1_to_l0a(nextA2,fullA,nr,BK,
alignedRows,p.k,
panel+nextInner);
capi_l1_to_l0b(nextB2,
(b1 + (nextInner*32)),
BK,nc,panelK);
a2Queue.EnQue(nextA2);
b2Queue.EnQue(nextB2);
}
}
if constexpr(CarryWeights)
b1Queue.ReleaseSlot(b1Queue.NextSlot(releasedWeight));
else
b1Queue.FreeTensor(b1);
}
cQueue.EnQue(c);c=cQueue.DeQue<int32_t>();
FixpipeParamsV220 outputParams;
outputParams.nSize=nc;outputParams.mSize=nr;
outputParams.srcStride=alignedRows;
outputParams.dstStride=BN;
outputParams.ndNum=1;outputParams.srcNdStride=0;
outputParams.dstNdStride=0;outputParams.unitFlag=3;
#if GMM_OPT_LATE_DIRECT_WAIT
if(produced>2)asc_sync_block_wait(1);
#endif
capi_fixpipe((scratch + (slot*BM*BN)),c,outputParams);
cQueue.FreeTensor(c);
capi_block_arrive<PIPE_FIX,2>(0);
}
a1Queue.FreeTensor(fullA);
}
rowTileBase+=rowTiles;
begin=end;
}
for(int pending=0;pending<(produced<2?produced:2);++pending)
asc_sync_block_wait(1);
} else if(TALL_MANUAL_TEMPLATE &&
p.directTall==TALL_MODE_MID_K) {
constexpr int BK=128, KP=512, L1_DEPTH=2;
CapiQueue<__cbuf__ int8_t*, CapiSpace::L1, PIPE_MTE2, PIPE_MTE1, L1_DEPTH, 0> a1Queue;
CapiQueue<__ca__ int8_t*, CapiSpace::L0A, PIPE_MTE1, PIPE_M, 2, 0> a2Queue;
CapiQueue<__cbuf__ int8_t*, CapiSpace::L1, PIPE_MTE2, PIPE_MTE1, L1_DEPTH, 2> b1Queue;
CapiQueue<__cb__ int8_t*, CapiSpace::L0B, PIPE_MTE1, PIPE_M, 2, 2> b2Queue;
CapiQueue<__cc__ int32_t*, CapiSpace::L0C, PIPE_M, PIPE_FIX, 1, 0> cQueue;
pipe.InitBuffer(a1Queue,L1_DEPTH,BM*KP);
pipe.InitBuffer(a2Queue,2,BM*BK);
pipe.InitBuffer(b1Queue,L1_DEPTH,KP*BN);
pipe.InitBuffer(b2Queue,2,BK*BN);
pipe.InitBuffer(cQueue,1,BM*BN*4);
int produced=0;
int begin=0,nt=(p.n+BN-1)/BN,firstTile=block;
for(int e=0;e<p.e;++e) {
int end=gg[e],rows=end-begin;
int tiles=((rows+BM-1)/BM)*nt;
for(int t=firstTile;t<tiles;t+=p.cores) {
#if !GMM_OPT_LATE_DIRECT_WAIT
if(produced>=2)asc_sync_block_wait(1);
#endif
int slot=(produced++)&1;
int row=begin+(t/nt)*BM,col=(t%nt)*BN;
int nr=end-row<BM?end-row:BM,nc=p.n-col<BN?p.n-col:BN;
int alignedRows=(nr+15)/16*16;
auto c=cQueue.AllocTensor<int32_t>();
int initialK=p.k<KP?p.k:KP;
auto initialA=a1Queue.template AllocTensor<int8_t>();
capi_nd_to_nz(initialA,(a + ((int64_t)row*p.k)),
nr,initialK,p.k,alignedRows);
a1Queue.EnQue(initialA);
auto initialB=b1Queue.template AllocTensor<int8_t>();
capi_nd_to_nz(initialB,(b + ((int64_t)e*p.k*p.n+col)),
initialK,nc,p.n,initialK);
b1Queue.EnQue(initialB);
for(int panel=0;panel<p.k;panel+=KP) {
int panelK=p.k-panel<KP?p.k-panel:KP;
auto a1=a1Queue.template DeQue<int8_t>();
auto b1=b1Queue.template DeQue<int8_t>();
if(panel+panelK<p.k) {
int nextPanel=panel+panelK;
int nextK=p.k-nextPanel<KP?p.k-nextPanel:KP;
auto nextA=a1Queue.template AllocTensor<int8_t>();
capi_nd_to_nz(nextA,(a + ((int64_t)row*p.k+nextPanel)),
nr,nextK,p.k,alignedRows);
a1Queue.EnQue(nextA);
auto nextB=b1Queue.template AllocTensor<int8_t>();
capi_nd_to_nz(nextB,
(b + ((int64_t)e*p.k*p.n+(int64_t)nextPanel*p.n+col)),
nextK,nc,p.n,nextK);
b1Queue.EnQue(nextB);
}
auto firstA2=a2Queue.AllocTensor<int8_t>();
auto firstB2=b2Queue.AllocTensor<int8_t>();
capi_l1_to_l0a(firstA2,a1,nr,BK,alignedRows,panelK,0);
capi_l1_to_l0b(firstB2,b1,BK,nc,panelK);
a2Queue.EnQue(firstA2);b2Queue.EnQue(firstB2);
for(int inner=0;inner<panelK;inner+=BK) {
auto a2=a2Queue.DeQue<int8_t>();
auto b2=b2Queue.DeQue<int8_t>();
MmadParams params;
params.m=nr==1?16:nr;params.n=nc;params.k=BK;
params.cmatrixInitVal=panel==0 && inner==0;
params.unitFlag=panel+inner+BK==p.k?3:2;
asc_mmad(c,a2,b2,params.m,params.k,params.n,params.unitFlag,false,false,params.cmatrixInitVal);
a2Queue.FreeTensor(a2);b2Queue.FreeTensor(b2);
int nextInner=inner+BK;
if(nextInner<panelK) {
auto nextA2=a2Queue.AllocTensor<int8_t>();
auto nextB2=b2Queue.AllocTensor<int8_t>();
capi_l1_to_l0a(nextA2,a1,nr,BK,alignedRows,
panelK,nextInner);
capi_l1_to_l0b(nextB2,(b1 + (nextInner*32)),
BK,nc,panelK);
a2Queue.EnQue(nextA2);b2Queue.EnQue(nextB2);
}
}
a1Queue.FreeTensor(a1);b1Queue.FreeTensor(b1);
}
cQueue.EnQue(c);c=cQueue.DeQue<int32_t>();
FixpipeParamsV220 outputParams;
outputParams.nSize=nc;outputParams.mSize=nr;
outputParams.srcStride=alignedRows;outputParams.dstStride=BN;
outputParams.ndNum=1;outputParams.srcNdStride=0;
outputParams.dstNdStride=0;outputParams.unitFlag=3;
#if GMM_OPT_LATE_DIRECT_WAIT
if(produced>2)asc_sync_block_wait(1);
#endif
capi_fixpipe((scratch + (slot*BM*BN)),c,outputParams);
cQueue.FreeTensor(c);
capi_block_arrive<PIPE_FIX,2>(0);
}
begin=end;
firstTile-=tiles%p.cores;
if(firstTile<0)firstTile+=p.cores;
}
for(int pending=0;pending<(produced<2?produced:2);++pending)
asc_sync_block_wait(1);
}
} else {
CapiBuffer cb, zb, vb, sb, tb;
pipe.InitBuffer(cb, SIZE*4*2+PAD); pipe.InitBuffer(zb, SIZE*4+PAD);
pipe.InitBuffer(vb, SIZE*4+PAD);
if constexpr(BUFFERED_GELU)pipe.InitBuffer(tb,SIZE*4+PAD);
pipe.InitBuffer(sb, BN*4+PAD);
auto ciStorage=cb.Get<int32_t>(); auto z=zb.Get<float>(); auto v=vb.Get<float>();
auto scales=sb.Get<float>();
auto temporary=tb.Get<float>();
TEventID inputReady[2],outputFree[2];
bool outputPending[2]={false,false};
for(int stage=0;stage<2;++stage) {
inputReady[stage]=stage;
outputFree[stage]=stage;
}
auto scaleFree=0;
bool scalePending=false;
auto sg = reinterpret_cast<__gm__ float*>(scale);
auto yg = reinterpret_cast<__gm__ half*>(output);
if constexpr(CROSS_TILE) {
CapiBuffer groupCache;
int firstExpert=ContiguousExperts?p.e*block/p.cores:block;
int expertStop=ContiguousExperts?p.e*(block+1)/p.cores:p.e;
int groupOffset=ContiguousExperts && firstExpert>0?firstExpert-1:0;
int bytes=(expertStop-groupOffset)*sizeof(int64_t);
pipe.InitBuffer(groupCache,(bytes+31)/32*32);
auto bounds=groupCache.Get<int64_t>();
DataCopyExtParams copyBounds{1,(uint32_t)bytes,0,0,0};
DataCopyPadExtParams<int64_t> padBounds{false,0,0,0};
capi_read_pad(bounds,gg+groupOffset,copyBounds,padBounds);
auto boundsReady=0;
capi_notify<PIPE_MTE2,PIPE_S>(boundsReady);capi_wait<PIPE_MTE2,PIPE_S>(boundsReady);
ExpertTileCursor cursor{firstExpert,0,0,0,0,0,false};
ExpertTileState current,next;
bool hasCurrent=capi_next_expert_tile<BM,BN,ContiguousExperts,FULL_EXPERT_COLUMNS>(
cursor,current,bounds,p,block,asc_get_sub_block_id(),groupOffset);
if(hasCurrent) {
capi_prefetch_expert_tile<BM,BN,SIZE,FULL_EXPERT_COLUMNS>(
current,scratch,sg,ciStorage,scales,inputReady,outputFree,
outputPending,scaleFree,scalePending,p.n);
}
while(hasCurrent) {
if(current.localRows<=0) {
hasCurrent=capi_next_expert_tile<BM,BN,ContiguousExperts,FULL_EXPERT_COLUMNS>(
cursor,next,bounds,p,block,asc_get_sub_block_id(),groupOffset);
if(hasCurrent) {
capi_prefetch_expert_tile<BM,BN,SIZE,FULL_EXPERT_COLUMNS>(
next,scratch,sg,ciStorage,scales,inputReady,outputFree,
outputPending,scaleFree,scalePending,p.n);
current=next;
}
continue;
}
int stage=current.slot;
int nr=current.localRows;
int active=nr*BN;
capi_wait<PIPE_MTE2,PIPE_V>(inputReady[stage]);
auto ci=(ciStorage + (stage*SIZE));
auto out=reinterpret_cast<__ubuf__ half*>(ci);
asc_int322float_rn(z,ci,active);asc_sync_pipe(PIPE_V);
asc_set_mask_norm();
asc_set_vector_mask(0, ~uint64_t(0));
BinaryRepeatParams broadcast{1,1,1,BN/8,BN/8,0};
for(int c=0;c<BN;c+=64)
asc_mul(((TALL_MANUAL_TEMPLATE && AdaptiveOwners?v:z) + (c)),(z + (c)),(scales + (c)),(uint8_t)nr,1,1,1,broadcast.dstRepStride,broadcast.src0RepStride,0);
asc_sync_pipe(PIPE_V);
capi_notify<PIPE_V,PIPE_MTE2>(scaleFree);
scalePending=true;
bool hasNext=capi_next_expert_tile<BM,BN,ContiguousExperts,FULL_EXPERT_COLUMNS>(
cursor,next,bounds,p,block,asc_get_sub_block_id(),groupOffset);
if(active==SIZE && current.nc==BN)
capi_finish_gelu_pingpong(TALL_MANUAL_TEMPLATE && AdaptiveOwners?v:z,TALL_MANUAL_TEMPLATE && AdaptiveOwners?z:v,temporary,out,SIZE);
else
capi_finish_gelu_pingpong(TALL_MANUAL_TEMPLATE && AdaptiveOwners?v:z,TALL_MANUAL_TEMPLATE && AdaptiveOwners?z:v,temporary,out,active);
if(hasNext) {
capi_prefetch_expert_tile<BM,BN,SIZE,FULL_EXPERT_COLUMNS>(
next,scratch,sg,ciStorage,scales,inputReady,outputFree,
outputPending,scaleFree,scalePending,p.n);
}
auto done=0;
capi_notify<PIPE_V,PIPE_MTE3>(done);capi_wait<PIPE_V,PIPE_MTE3>(done);
if constexpr(FULL_EXPERT_COLUMNS) {
capi_write(yg+(int64_t)current.firstRow*p.n,out,active);
} else {
auto destination=yg+(int64_t)current.firstRow*p.n+current.col;
if(p.n==BN && current.nc==BN) {
capi_write(destination,out,active);
} else {
DataCopyExtParams outputParams{
(uint16_t)nr,(uint32_t)(current.nc*2),
(uint32_t)((BN-((current.nc+15)/16)*16)/16),
(uint32_t)((p.n-current.nc)*2),0};
capi_write_pad(destination,out,outputParams);
}
}
capi_notify<PIPE_MTE3,PIPE_MTE2>(outputFree[stage]);
outputPending[stage]=true;
hasCurrent=hasNext;
if(hasNext) current=next;
}
} else {
bool useResidentOwners=TALL_MANUAL_TEMPLATE &&
p.directTall==TALL_MODE_RESIDENT_A;
int totalRowTiles=0;
if(useResidentOwners) {
int scanBegin=0;
for(int e=0;e<p.e;++e) {
int scanEnd=gg[e];
totalRowTiles+=(scanEnd-scanBegin+BM-1)/BM;
scanBegin=scanEnd;
}
}
int residentLanes=useResidentOwners && AdaptiveOwners &&
totalRowTiles<=p.cores &&
totalRowTiles*2>p.cores?1:2;
int begin=0,nt=(p.n+BN-1)/BN,firstUnit=block;
int rowTileBase=0,consumed=0;
for(int e=EXPERT?block:0;e<p.e;e+=EXPERT?p.cores:1) {
if(EXPERT)begin=e==0?0:gg[e-1];
int end=gg[e],rows=end-begin;
int rowTiles=(rows+BM-1)/BM;
bool residentOwners=TALL_MANUAL_TEMPLATE &&
p.directTall==TALL_MODE_RESIDENT_A;
bool wideOwners=WIDE_A_REUSE_TEMPLATE &&
p.directCube==CUBE_MODE_WIDE_A;
int units=wideOwners?rowTiles:
(residentOwners?rowTiles*residentLanes:rowTiles*nt);
int unitStart=residentOwners?0:(EXPERT?0:firstUnit);
int unitStep=residentOwners?1:(EXPERT?1:p.cores);
for(int unit=unitStart;unit<units;unit+=unitStep) {
int rowTile=wideOwners?unit:(residentOwners?unit/residentLanes:unit/nt);
int firstColumn=wideOwners?0:(residentOwners?unit%residentLanes:unit%nt);
if(residentOwners) {
int owner=(rowTileBase+rowTile+
firstColumn*totalRowTiles)%p.cores;
if(owner!=block)continue;
}
int columnLimit=(wideOwners || residentOwners)?nt:firstColumn+1;
int columnStep=residentOwners?residentLanes:1;
for(int columnTile=firstColumn;columnTile<columnLimit;
columnTile+=columnStep) {
int slot=(consumed++)&1;
int tileRows=end-(begin+rowTile*BM);
if(tileRows>BM)tileRows=BM;
int halfRows=capi_vector_half_rows<BM>(tileRows);
int slice=asc_get_sub_block_id()*halfRows;
int firstRow=begin+rowTile*BM+slice;
int orderedColumn=shifted_column<Rotate>(columnTile,rowTileBase+rowTile,e,nt,p.cores);
if constexpr(WIDE_A_REUSE_TEMPLATE)
if(wideOwners && nt==2)orderedColumn=columnTile^(e&1);
int col=orderedColumn*BN;
int localRows=end-firstRow<halfRows?end-firstRow:halfRows;
int nc=p.n-col<BN?p.n-col:BN;
asc_sync_block_wait(0);
if(localRows<=0) {
capi_block_arrive<PIPE_MTE2,2>(1);
continue;
}
if(scalePending) {
capi_wait<PIPE_V,PIPE_MTE2>(scaleFree);
scalePending=false;
}
DataCopyExtParams sp{1,(uint32_t)(nc*4),0,0,0};
DataCopyPadExtParams<float> pad{true,0,0,0.0f};
capi_read_pad(scales,(sg + ((int64_t)e*p.n+col)),sp,pad);
int startStage=(consumed-1)&1;
if(outputPending[startStage]) {
capi_wait<PIPE_MTE3,PIPE_MTE2>(outputFree[startStage]);
outputPending[startStage]=false;
}
int firstRows=localRows<CHUNK?localRows:CHUNK;
int rowStride=BN;
if constexpr (PackTail) {
if (nc<=64 && (localRows%2)==0 && (CHUNK%2)==0) rowStride=64;
else if (nc<=128) rowStride=128;
}
rowStride=capi_vector_row_stride(nc,rowStride);
capi_copy_accumulator_rows<BN,PackTail>((ciStorage + (startStage*SIZE)),(scratch + (slot*BM*BN+slice*BN)),firstRows,rowStride);
capi_notify<PIPE_MTE2,PIPE_V>(inputReady[startStage]);
if(localRows<=CHUNK)capi_block_arrive<PIPE_MTE2,2>(1);
for(int part=0;part<localRows;part+=CHUNK) {
int stage=(startStage+part/CHUNK)&1;
int row=firstRow+part;
int nr=localRows-part<CHUNK?localRows-part:CHUNK;
int active=nr*rowStride;
capi_wait<PIPE_MTE2,PIPE_V>(inputReady[stage]);
if(part+nr<localRows) {
int next=stage^1;
if(outputPending[next]) {
capi_wait<PIPE_MTE3,PIPE_MTE2>(outputFree[next]);
outputPending[next]=false;
}
int nextRows=localRows-part-nr<CHUNK?localRows-part-nr:CHUNK;
capi_copy_accumulator_rows<BN,PackTail>((ciStorage + (next*SIZE)),(scratch + (slot*BM*BN+(slice+part+nr)*BN)),nextRows,rowStride);
capi_notify<PIPE_MTE2,PIPE_V>(inputReady[next]);
if(part+nr+nextRows==localRows)capi_block_arrive<PIPE_MTE2,2>(1);
}
auto ci=(ciStorage + (stage*SIZE));
auto out=reinterpret_cast<__ubuf__ half*>(ci);
asc_int322float_rn(z,ci,active);asc_sync_pipe(PIPE_V);
asc_set_mask_norm();
asc_set_vector_mask(0, ~uint64_t(0));
BinaryRepeatParams broadcast{1,1,1,(uint8_t)(rowStride/8),(uint8_t)(rowStride/8),0};
for(int c=0;c<rowStride;c+=64)
asc_mul(((TALL_MANUAL_TEMPLATE && AdaptiveOwners?v:z) + (c)),(z + (c)),(scales + (c)),(uint8_t)nr,1,1,1,broadcast.dstRepStride,broadcast.src0RepStride,0);
asc_sync_pipe(PIPE_V);
if(part+nr==localRows) {
capi_notify<PIPE_V,PIPE_MTE2>(scaleFree);
scalePending=true;
}
if constexpr(BUFFERED_GELU)
capi_finish_gelu_pingpong(TALL_MANUAL_TEMPLATE && AdaptiveOwners?v:z,TALL_MANUAL_TEMPLATE && AdaptiveOwners?z:v,temporary,out,active);
else
capi_finish_gelu(TALL_MANUAL_TEMPLATE && AdaptiveOwners?v:z,TALL_MANUAL_TEMPLATE && AdaptiveOwners?z:v,out,active);
auto done=0;
capi_notify<PIPE_V,PIPE_MTE3>(done);capi_wait<PIPE_V,PIPE_MTE3>(done);
DataCopyExtParams op{(uint16_t)nr,(uint32_t)(nc*2),
(uint32_t)((rowStride-((nc+15)/16)*16)/16),
(uint32_t)((p.n-nc)*2),0};
capi_write_pad((yg + ((int64_t)row*p.n+col)),out,op);
capi_notify<PIPE_MTE3,PIPE_MTE2>(outputFree[stage]);
outputPending[stage]=true;
}
}
}
rowTileBase+=rowTiles;
begin=end;
if(!EXPERT && !residentOwners){firstUnit-=units%p.cores;
if(firstUnit<0)firstUnit+=p.cores;}
}
}
if(scalePending)capi_wait<PIPE_V,PIPE_MTE2>(scaleFree);
for(int stage=0;stage<2;++stage) {
if(outputPending[stage])capi_wait<PIPE_MTE3,PIPE_MTE2>(outputFree[stage]);
}
}
}
template<int BM,int BN,int CHUNK,int SIZE,bool PackTail,bool FineTail,bool CompactScratch,
typename Traversal,typename Tile>
struct CapiVectorStreamReader {
struct Job { Tile tile; int stage,part,rows,rowStride,slice; };
Traversal &traversal;
GmmPlan p;
__gm__ int32_t* scratch;
__gm__ float* sourceScales;
__ubuf__ int32_t* storage;
__ubuf__ float* scales;
Tile tile;
int part=0,localRows=0,tiles=0,batches=0,lastExpert=-1,lastColumn=-1;
int scratchSlot=0,rowSlice=0;
bool pending[2]={false,false},scalePending=false;
__aicore__ CapiVectorStreamReader(Traversal &cursor,GmmPlan plan,
__gm__ int32_t* work,__gm__ float* scale,
__ubuf__ int32_t* inputs,__ubuf__ float* coefficients)
:traversal(cursor),p(plan),scratch(work),sourceScales(scale),
storage(inputs),scales(coefficients) {}
__aicore__ bool Next(Job &job) {
while(part>=localRows) {
if(!traversal.Next(tile))return false;
part=0;
scratchSlot=(tiles++)&1;
int halfRows=capi_vector_half_rows<BM>(tile.rows);
rowSlice=asc_get_sub_block_id()*halfRows;
localRows=tile.rows-rowSlice<halfRows?tile.rows-rowSlice:halfRows;
asc_sync_block_wait(scratchSlot);
if(localRows<=0) {
capi_block_arrive<PIPE_MTE2,2>(2+scratchSlot);
continue;
}
}
int stage=(batches++)&1;
if(pending[stage]) {
capi_wait<PIPE_MTE3,PIPE_MTE2>(stage);
pending[stage]=false;
}
if(tile.expert!=lastExpert || tile.column!=lastColumn) {
if(scalePending) {
capi_wait<PIPE_V,PIPE_MTE2>(2);scalePending=false;
}
DataCopyExtParams sp{1,(uint32_t)tile.columns*4,0,0,0};
capi_read_pad(scales,sourceScales+(int64_t)tile.expert*p.n+tile.column,
sp,DataCopyPadExtParams<float>{true,0,0,0.0f});
lastExpert=tile.expert;lastColumn=tile.column;
}
int rowStride=BN;
if constexpr(PackTail) {
if constexpr(FineTail) {
rowStride=capi_fine_tail_stride(tile.columns);
} else {
if(tile.columns<=64 && localRows%2==0 && CHUNK%2==0)rowStride=64;
else if(tile.columns<=128)rowStride=128;
}
}
if constexpr(CompactScratch)rowStride=capi_aligned_scratch_stride(tile.columns);
else rowStride=capi_vector_row_stride(tile.columns,rowStride);
int rows=localRows-part<CHUNK?localRows-part:CHUNK;
int slice=rowSlice;
auto tileBase=scratch+scratchSlot*BM*BN;
if constexpr(CompactScratch) {
capi_read(storage+stage*SIZE,tileBase+(slice+part)*rowStride,rows*rowStride);
} else {
capi_copy_accumulator_rows<BN,PackTail>(storage+stage*SIZE,
tileBase+(slice+part)*BN,rows,rowStride);
}
capi_notify<PIPE_MTE2,PIPE_V>(stage);
job={tile,stage,part,rows,rowStride,rowSlice};
part+=rows;
if(part>=localRows)capi_block_arrive<PIPE_MTE2,2>(2+scratchSlot);
return true;
}
};
template<int BM,int BN,int CHUNK,bool ReuseAccumulator,bool BufferedGelu,
bool PackTail,bool FineTail,bool AfterGelu,bool CompactScratch=false,
typename Traversal,typename Tile>
__aicore__ void capi_vector_stream(Traversal &traversal,Tile unused,GmmPlan p,
__gm__ int32_t* scratch,GM_ADDR scale,GM_ADDR output) {
constexpr int SIZE=CHUNK*BN;
constexpr int TEMP_SIZE=BufferedGelu?(SIZE<8192?SIZE:8192):0;
constexpr int PAD=192;
static_assert(SIZE*(ReuseAccumulator?12:16)+TEMP_SIZE*4+256+5*PAD+BN*4<=192*1024,
"Vector stream exceeds UB capacity");
CapiMemory memory;
CapiBuffer cb,zb,vb,tb,sb;
memory.InitBuffer(cb,SIZE*8+PAD);
memory.InitBuffer(zb,ReuseAccumulator?0:SIZE*4+PAD);
memory.InitBuffer(vb,SIZE*4+PAD);
if constexpr(BufferedGelu)memory.InitBuffer(tb,TEMP_SIZE*4+PAD);
memory.InitBuffer(sb,BN*4+PAD);
auto storage=cb.Get<int32_t>();
auto z=zb.Get<float>();auto v=vb.Get<float>();auto temporary=tb.Get<float>();
auto scales=sb.Get<float>();
using Reader=CapiVectorStreamReader<BM,BN,CHUNK,SIZE,PackTail,FineTail,CompactScratch,Traversal,Tile>;
Reader reader(traversal,p,scratch,reinterpret_cast<__gm__ float*>(scale),storage,scales);
typename Reader::Job current,next;
bool active=reader.Next(current);
while(active) {
auto ci=storage+current.stage*SIZE;
auto out=reinterpret_cast<__ubuf__ half*>(ci);
if constexpr(ReuseAccumulator)z=reinterpret_cast<__ubuf__ float*>(ci);
int count=current.rows*current.rowStride;
capi_wait<PIPE_MTE2,PIPE_V>(current.stage);
asc_int322float_rn(z,ci,count);asc_sync_pipe(PIPE_V);
asc_set_mask_norm();asc_set_vector_mask(0,~uint64_t(0));
int fullWidth=FineTail?(current.rowStride&~63):current.rowStride;
for(int column=0;column<BN;column+=64)
if(column<fullWidth)
asc_mul(z+column,z+column,scales+column,current.rows,1,1,1,
current.rowStride/8,current.rowStride/8,0);
if constexpr(FineTail) {
int remaining=current.rowStride-fullWidth;
if(remaining) {
asc_set_vector_mask(0,(uint64_t(1)<<remaining)-1);
asc_mul(z+fullWidth,z+fullWidth,scales+fullWidth,current.rows,1,1,1,
current.rowStride/8,current.rowStride/8,0);
}
}
asc_sync_pipe(PIPE_V);
if(reader.scalePending)capi_wait<PIPE_V,PIPE_MTE2>(2);
capi_notify<PIPE_V,PIPE_MTE2>(2);reader.scalePending=true;
bool hasNext=false;
if constexpr(!AfterGelu)hasNext=reader.Next(next);
if(p.k>=512 && p.k<768 && p.n>256 && p.n<=448)
capi_finish_gelu_half(z,v,out,count);
else if constexpr(BufferedGelu)
capi_finish_gelu_buffered<TEMP_SIZE,false,false>(z,v,temporary,out,count);
else capi_finish_gelu(z,v,out,count);
if constexpr(AfterGelu)hasNext=reader.Next(next);
capi_notify<PIPE_V,PIPE_MTE3>(0);capi_wait<PIPE_V,PIPE_MTE3>(0);
DataCopyExtParams op{(uint16_t)current.rows,(uint32_t)current.tile.columns*2,
(uint32_t)((current.rowStride-((current.tile.columns+15)&~15))/16),
(uint32_t)(p.n-current.tile.columns)*2,0};
int slice=current.slice;
capi_write_pad(reinterpret_cast<__gm__ half*>(output)+
(int64_t)(current.tile.row+slice+current.part)*p.n+current.tile.column,out,op);
capi_notify<PIPE_MTE3,PIPE_MTE2>(current.stage);reader.pending[current.stage]=true;
active=hasNext;if(active)current=next;
}
if(reader.scalePending)capi_wait<PIPE_V,PIPE_MTE2>(2);
for(int stage=0;stage<2;++stage)
if(reader.pending[stage])capi_wait<PIPE_MTE3,PIPE_MTE2>(stage);
}
template<int BM,int BN,int CHUNK,int SIZE,bool PackTail,bool FineTail,bool CompactScratch,
typename Traversal,typename Tile,bool Dequantized=false>
struct CapiHalfVectorStreamReader {
struct Job { Tile tile; int stage,part,rows,rowStride,slice; };
Traversal &traversal;
GmmPlan p;
__gm__ int32_t* scratch;
__gm__ float* sourceScales;
__ubuf__ int32_t* storage;
__ubuf__ float* scales;
Tile tile;
int part=0,localRows=0,tiles=0,batches=0,lastExpert=-1,lastColumn=-1;
int scratchSlot=0,rowSlice=0;
bool pending[2]={false,false},scalePending=false,scaleNeedsAdjust=false;
__aicore__ CapiHalfVectorStreamReader(Traversal &cursor,GmmPlan plan,
__gm__ int32_t* work,__gm__ float* scale,
__ubuf__ int32_t* inputs,__ubuf__ float* coefficients)
:traversal(cursor),p(plan),scratch(work),sourceScales(scale),
storage(inputs),scales(coefficients) {}
__aicore__ bool Next(Job &job) {
while(part>=localRows) {
if(!traversal.Next(tile))return false;
part=0;
scratchSlot=(tiles++)&1;
int halfRows=capi_vector_half_rows<BM>(tile.rows);
rowSlice=asc_get_sub_block_id()*halfRows;
localRows=tile.rows-rowSlice<halfRows?tile.rows-rowSlice:halfRows;
asc_sync_block_wait(scratchSlot);
if(localRows<=0) {
capi_block_arrive<PIPE_MTE2,2>(2+scratchSlot);
continue;
}
}
int stage=(batches++)&1;
if(pending[stage]) {
capi_wait<PIPE_MTE3,PIPE_MTE2>(stage);
pending[stage]=false;
}
if(!Dequantized && (tile.expert!=lastExpert || tile.column!=lastColumn)) {
if(scalePending) {
capi_wait<PIPE_V,PIPE_MTE2>(2);scalePending=false;
}
DataCopyExtParams sp{1,(uint32_t)tile.columns*4,0,0,0};
capi_read_pad(scales,sourceScales+(int64_t)tile.expert*p.n+tile.column,
sp,DataCopyPadExtParams<float>{true,0,0,0.0f});
lastExpert=tile.expert;lastColumn=tile.column;scaleNeedsAdjust=true;
}
int rowStride=BN;
if constexpr(PackTail) {
if constexpr(FineTail) {
rowStride=capi_fine_tail_stride(tile.columns);
} else {
if(tile.columns<=64 && localRows%2==0 && CHUNK%2==0)rowStride=64;
else if(tile.columns<=128)rowStride=128;
}
}
if constexpr(CompactScratch)rowStride=capi_aligned_scratch_stride(tile.columns);
else rowStride=capi_vector_row_stride(tile.columns,rowStride);
int rows=localRows-part<CHUNK?localRows-part:CHUNK;
int slice=rowSlice;
static_assert(CompactScratch, "Half stream requires compact intermediate rows");
auto tileBase=reinterpret_cast<__gm__ half*>(scratch+scratchSlot*BM*BN);
capi_read(reinterpret_cast<__ubuf__ half*>(storage+stage*SIZE),
tileBase+(slice+part)*rowStride,rows*rowStride);
capi_notify<PIPE_MTE2,PIPE_V>(stage);
job={tile,stage,part,rows,rowStride,rowSlice};
part+=rows;
if(part>=localRows)capi_block_arrive<PIPE_MTE2,2>(2+scratchSlot);
return true;
}
};
__aicore__ inline void capi_finish_dequantized_symmetric_half(__ubuf__ half* out,int count) {
auto magnitude=reinterpret_cast<__ubuf__ half*>(uint64_t(65792));
auto polynomial=reinterpret_cast<__ubuf__ half*>(uint64_t(98304));
auto spare=reinterpret_cast<__ubuf__ half*>(uint64_t(131072));
set_mask_count();set_vector_mask(0,count);
vabs(magnitude,out,1,1,1,8,8);pipe_barrier(PIPE_V);
vmul(polynomial,magnitude,magnitude,1,1,1,1,8,8,8);pipe_barrier(PIPE_V);
vmadd(polynomial,reinterpret_cast<__ubuf__ half*>(uint64_t(185344)),
reinterpret_cast<__ubuf__ half*>(uint64_t(185600)),1,1,0,0,8,0,0);pipe_barrier(PIPE_V);
vmul(spare,polynomial,magnitude,1,1,1,1,8,8,8);pipe_barrier(PIPE_V);
vexp(polynomial,spare,1,1,1,8,8);pipe_barrier(PIPE_V);
vadds(polynomial,polynomial,half(1.0f),1,1,1,8,8);pipe_barrier(PIPE_V);
vrec(spare,polynomial,1,1,1,8,8);pipe_barrier(PIPE_V);
vmul(spare,magnitude,spare,1,1,1,1,8,8,8);pipe_barrier(PIPE_V);
vmaxs(out,out,half(0.0f),1,1,1,8,8);pipe_barrier(PIPE_V);
vsub(out,out,spare,1,1,1,1,8,8,8);
set_mask_norm();set_vector_mask(~uint64_t(0),~uint64_t(0));
}
template<int BM,int BN,int CHUNK,bool ReuseAccumulator,bool BufferedGelu,
bool PackTail,bool FineTail,bool AfterGelu,bool CompactScratch=false,bool Dequantized=false,
typename Traversal,typename Tile>
__aicore__ void capi_half_vector_stream(Traversal &traversal,Tile unused,GmmPlan p,
__gm__ int32_t* scratch,GM_ADDR scale,GM_ADDR output) {
constexpr int SIZE=CHUNK*BN;
constexpr int TEMP_SIZE=BufferedGelu?(SIZE<8192?SIZE:8192):0;
constexpr int PAD=192;
static_assert(SIZE*(ReuseAccumulator?12:16)+TEMP_SIZE*4+768+6*PAD+BN*4<=192*1024,
"Vector stream exceeds UB capacity");
CapiMemory memory;
CapiBuffer cb,zb,vb,tb,sb;
memory.InitBuffer(cb,SIZE*8+PAD);
memory.InitBuffer(zb,ReuseAccumulator?0:SIZE*4+PAD);
memory.InitBuffer(vb,SIZE*4+PAD);
if constexpr(BufferedGelu)memory.InitBuffer(tb,TEMP_SIZE*4+PAD);
memory.InitBuffer(sb,BN*4+PAD);
auto storage=cb.Get<int32_t>();
auto z=zb.Get<float>();auto v=vb.Get<float>();auto temporary=tb.Get<float>();
auto scales=sb.Get<float>();
using Reader=CapiHalfVectorStreamReader<BM,BN,CHUNK,SIZE,PackTail,FineTail,CompactScratch,Traversal,Tile,Dequantized>;
Reader reader(traversal,p,scratch,reinterpret_cast<__gm__ float*>(scale),storage,scales);
typename Reader::Job current,next;
if constexpr(Dequantized) {
asc_duplicate(reinterpret_cast<__ubuf__ half*>(uint64_t(185344)),half(0.07135481627260091f),16);
asc_duplicate(reinterpret_cast<__ubuf__ half*>(uint64_t(185600)),half(1.5957691216057308f),16);
pipe_barrier(PIPE_V);
}
bool active=reader.Next(current);
while(active) {
auto ci=storage+current.stage*SIZE;
auto out=reinterpret_cast<__ubuf__ half*>(ci);
if constexpr(ReuseAccumulator)z=reinterpret_cast<__ubuf__ float*>(ci);
int count=current.rows*current.rowStride;
capi_wait<PIPE_MTE2,PIPE_V>(current.stage);
if constexpr(!Dequantized) {
if(reader.scaleNeedsAdjust) {
asc_mul_scalar(scales,scales,512.0f,BN);
asc_sync_pipe(PIPE_V);
reader.scaleNeedsAdjust=false;
}
asc_half2float(z,reinterpret_cast<__ubuf__ half*>(ci),count);
asc_sync_pipe(PIPE_V);
asc_set_mask_norm();asc_set_vector_mask(0,~uint64_t(0));
int fullWidth=FineTail?(current.rowStride&~63):current.rowStride;
for(int column=0;column<BN;column+=64)
if(column<fullWidth)
asc_mul(z+column,z+column,scales+column,current.rows,1,1,1,
current.rowStride/8,current.rowStride/8,0);
if constexpr(FineTail) {
int remaining=current.rowStride-fullWidth;
if(remaining) {
asc_set_vector_mask(0,(uint64_t(1)<<remaining)-1);
asc_mul(z+fullWidth,z+fullWidth,scales+fullWidth,current.rows,1,1,1,
current.rowStride/8,current.rowStride/8,0);
}
}
asc_sync_pipe(PIPE_V);
if(reader.scalePending)capi_wait<PIPE_V,PIPE_MTE2>(2);
capi_notify<PIPE_V,PIPE_MTE2>(2);reader.scalePending=true;
}
bool hasNext=false;
if constexpr(!AfterGelu)hasNext=reader.Next(next);
if constexpr(Dequantized)
capi_finish_dequantized_symmetric_half(out,count);
else if(p.k>=512 && p.k<768 && p.n>256 && p.n<=448)
capi_finish_gelu_half_banked(z,temporary,out,count);
else if constexpr(BufferedGelu)
capi_finish_gelu_buffered<TEMP_SIZE,false,false>(z,v,temporary,out,count);
else capi_finish_gelu(z,v,out,count);
if constexpr(AfterGelu)hasNext=reader.Next(next);
capi_notify<PIPE_V,PIPE_MTE3>(0);capi_wait<PIPE_V,PIPE_MTE3>(0);
DataCopyExtParams op{(uint16_t)current.rows,(uint32_t)current.tile.columns*2,
(uint32_t)((current.rowStride-((current.tile.columns+15)&~15))/16),
(uint32_t)(p.n-current.tile.columns)*2,0};
int slice=current.slice;
capi_write_pad(reinterpret_cast<__gm__ half*>(output)+
(int64_t)(current.tile.row+slice+current.part)*p.n+current.tile.column,out,op);
capi_notify<PIPE_MTE3,PIPE_MTE2>(current.stage);reader.pending[current.stage]=true;
active=hasNext;if(active)current=next;
}
if(reader.scalePending)capi_wait<PIPE_V,PIPE_MTE2>(2);
for(int stage=0;stage<2;++stage)
if(reader.pending[stage])capi_wait<PIPE_MTE3,PIPE_MTE2>(stage);
}
struct CapiTile {
int expert, row, column, rows, columns;
};
template<int BM, int BN, int Mode, int Rotate, bool FullColumnsFirst=false>
struct CapiTraversal {
__gm__ int64_t* ends;
GmmPlan p;
int core, expert=0, rowTile=0, columnTile=0;
int rowBase=0, begin=0, index;
int64_t workBase=0, low=0, high=0;
#if GMM_OPT_GROUP_BOUNDS
int cachedExpert=-1,cachedEnd=0,cachedRows=0,cachedRowTiles=0;
#endif
__aicore__ CapiTraversal(__gm__ int64_t* groups, GmmPlan plan, int block)
: ends(groups), p(plan), core(block), index(block) {
if constexpr (Mode==2 || Mode==4) {
int active=0, previous=0;
if constexpr (Mode==4) {
for(int e=0;e<p.e;++e) {
int end=ends[e];
if(end>previous)++active;
previous=end;
}
}
int64_t total=((int64_t)p.m+(Mode==4?int64_t(active)*BM*2:0))*p.n;
low=(total*core+p.cores-1)/p.cores;
high=(total*(core+1)+p.cores-1)/p.cores;
if constexpr (Mode==2) {
int limit=p.e;
while(expert<limit) {
int middle=expert+(limit-expert)/2;
if((int64_t)ends[middle]*p.n<=low)expert=middle+1;
else limit=middle;
}
begin=expert==0?0:ends[expert-1];
}
}
}
__aicore__ inline bool Next(CapiTile& result) {
int nt=(p.n+BN-1)/BN;
if constexpr (Mode==3 || Mode==7) {
while(index<p.e*nt) {
int e=index/nt;
int c=(index-e*nt+e)%nt;
if constexpr(FullColumnsFirst) {
if(p.n%BN!=0) {
int fullColumns=nt-1;
int fullUnits=p.e*fullColumns;
if(index<fullUnits) {
e=index/fullColumns;
c=(index-e*fullColumns+e)%fullColumns;
} else {
e=index-fullUnits;
c=fullColumns;
}
}
}
#if GMM_OPT_GROUP_BOUNDS
if(cachedExpert!=e) {
cachedExpert=e;
cachedEnd=ends[e];
int first=e==0?0:ends[e-1];
cachedRows=cachedEnd-first;
cachedRowTiles=(cachedRows+BM-1)/BM;
}
int end=cachedEnd,first=end-cachedRows,rt=cachedRowTiles;
#else
int first=e==0?0:ends[e-1],end=ends[e];
int rt=(end-first+BM-1)/BM;
#endif
if(rowTile>=rt){index+=p.cores;rowTile=0;continue;}
int row=first+(rowTile++)*BM,col=c*BN;
result={e,row,col,end-row<BM?end-row:BM,p.n-col<BN?p.n-col:BN};
return true;
}
return false;
}
while(expert<p.e) {
#if GMM_OPT_GROUP_BOUNDS
if(cachedExpert!=expert) {
cachedExpert=expert;
cachedEnd=ends[expert];
cachedRows=cachedEnd-begin;
cachedRowTiles=(cachedRows+BM-1)/BM;
}
int end=cachedEnd,rows=cachedRows,rt=cachedRowTiles;
#else
int end=ends[expert];
int rows=end-begin, rt=(rows+BM-1)/BM;
#endif
if constexpr (Mode<=1) {
int units=Mode==1?rt:rt*nt;
if(index>=units) {
index-=units;rowBase+=rt;begin=end;++expert;
columnTile=0;
continue;
}
int r=Mode==1?index:index/nt;
int c=Mode==1?columnTile:index-r*nt;
c=shifted_column<Rotate>(c,rowBase+r,expert,nt,p.cores);
if constexpr (Mode==1) {
if(++columnTile==nt){columnTile=0;index+=p.cores;}
} else index+=p.cores;
int row=begin+r*BM,col=c*BN;
result={expert,row,col,end-row<BM?end-row:BM,p.n-col<BN?p.n-col:BN};
return true;
}
if constexpr (Mode==2)if((int64_t)begin*p.n>=high)return false;
if constexpr (Mode==4)if(workBase>=high)return false;
if(rt==0 || columnTile>=nt) {
rowBase+=rt;
if(rows>0)workBase+=((int64_t)rows+(Mode==4?BM*2:0))*p.n;
begin=end;
++expert;rowTile=0;columnTile=0;
continue;
}
int r=rowTile,c=columnTile;
int nc=p.n-c*BN<BN?p.n-c*BN:BN;
int start,stop;
if constexpr (Mode==4) {
int64_t weightedRows=(int64_t)rows+BM*2;
int64_t panel=workBase+weightedRows*c*BN;
int64_t cost=weightedRows*nc;
start=low<=panel?0:(int)(((low-panel)*rt+cost-1)/cost);
stop=high<=panel?0:(int)(((high-panel)*rt+cost-1)/cost);
} else {
int64_t panel=(int64_t)begin*p.n+(int64_t)rows*c*BN;
int stride=BM*nc;
start=low<=panel?0:(int)((low-panel+stride-1)/stride);
stop=high<=panel?0:(int)((high-panel+stride-1)/stride);
}
if(stop>rt)stop=rt;
if(r<start)r=start;
if(r>=stop){rowTile=0;++columnTile;continue;}
rowTile=r+1;
int row=begin+r*BM,col=c*BN;
result={expert,row,col,end-row<BM?end-row:BM,p.n-col<BN?p.n-col:BN};
return true;
}
return false;
}
};
__aicore__ inline void capi_prepare_split_expert_coefficients(
GM_ADDR scale,__gm__ uint64_t* quantizedScales,GmmPlan p) {
const int core=asc_get_block_idx();
const int lane=asc_get_sub_block_id();
const int ownedExperts=(p.e+p.cores-1-core)/p.cores;
const int columns=p.n/2;
auto inputBits=reinterpret_cast<__ubuf__ uint32_t*>(uint64_t(0));
auto encoded=reinterpret_cast<__ubuf__ uint32_t*>(uint64_t(8192));
auto offsets=reinterpret_cast<__ubuf__ int32_t*>(uint64_t(16384));
auto keep=reinterpret_cast<__ubuf__ uint32_t*>(uint64_t(24576));
for(int index=0;index<8;++index)
offsets[index]=((index&1)?512:0)*4+(index/2)*4;
capi_notify<PIPE_S,PIPE_V>(7);capi_wait<PIPE_S,PIPE_V>(7);
for(int length=8;length<1024;length*=2) {
asc_add_scalar(offsets+length,offsets,int32_t(length*2),length);
asc_sync_pipe(PIPE_V);
}
asc_duplicate(inputBits+512,uint32_t(0),512);
asc_duplicate(keep,uint32_t(0xffffe000u),512);
for(int owned=0;owned<ownedExperts;++owned) {
const int expert=core+owned*p.cores;
capi_read_pad(inputBits,reinterpret_cast<__gm__ uint32_t*>(scale)+
int64_t(expert)*p.n+lane*columns,
DataCopyExtParams{1,(uint32_t)columns*4,0,0,0},
DataCopyPadExtParams<uint32_t>{true,0,0,0});
capi_notify<PIPE_MTE2,PIPE_V>(7);capi_wait<PIPE_MTE2,PIPE_V>(7);
asc_add_scalar(reinterpret_cast<__ubuf__ int32_t*>(inputBits),
reinterpret_cast<__ubuf__ int32_t*>(inputBits),int32_t(0x1000),columns);
asc_sync_pipe(PIPE_V);
asc_and(reinterpret_cast<__ubuf__ uint16_t*>(inputBits),
reinterpret_cast<__ubuf__ uint16_t*>(inputBits),
reinterpret_cast<__ubuf__ uint16_t*>(keep),2*columns);
asc_sync_pipe(PIPE_V);
asc_gather(encoded,inputBits,reinterpret_cast<__ubuf__ uint32_t*>(offsets),2*columns);
capi_notify<PIPE_V,PIPE_MTE3>(7);capi_wait<PIPE_V,PIPE_MTE3>(7);
capi_write_pad(quantizedScales+int64_t(expert)*p.n+lane*columns,
reinterpret_cast<__ubuf__ uint64_t*>(encoded),
DataCopyExtParams{1,(uint32_t)columns*8,0,0,0});
capi_block_arrive<PIPE_MTE3,2>(8+owned);
capi_notify<PIPE_MTE3,PIPE_S>(7);capi_wait<PIPE_MTE3,PIPE_S>(7);
}
}
template<bool SignalReady=true>
__aicore__ inline void capi_prepare_column_coefficients(
GM_ADDR scale,__gm__ uint64_t* quantizedScales,GmmPlan p) {
const int core=asc_get_block_idx();
const int quantizedStride=(p.n+31)&~31;
auto inputBits=reinterpret_cast<__ubuf__ uint32_t*>(uint64_t(0));
auto encoded=reinterpret_cast<__ubuf__ uint32_t*>(uint64_t(4096));
auto offsets=reinterpret_cast<__ubuf__ int32_t*>(uint64_t(6144));
auto keep=reinterpret_cast<__ubuf__ uint32_t*>(uint64_t(8192));
static_assert(256==256,"Vector coefficient buffers require 256 columns");
for(int index=0;index<8;++index)
offsets[index]=((index&1)?256:0)*4+(index/2)*4;
capi_notify<PIPE_S,PIPE_V>(7);capi_wait<PIPE_S,PIPE_V>(7);
for(int count=8;count<2*256;count*=2) {
asc_add_scalar(offsets+count,offsets,int32_t(count*2),count);
asc_sync_pipe(PIPE_V);
}
asc_duplicate(keep,uint32_t(0xffffe000u),256);
asc_sync_pipe(PIPE_V);
const int panels=(p.n+256-1)/256;
const int lane=asc_get_sub_block_id();
const int ownedExperts=(p.e+p.cores-1-core)/p.cores;
for(int job=lane;job<ownedExperts*panels;job+=2) {
const int expert=core+(job/panels)*p.cores,column=(job%panels)*256;
const int columns=p.n-column<256?p.n-column:256;
const int padded=(columns+31)&~31;
asc_duplicate(inputBits,uint32_t(0),2*256);
capi_notify<PIPE_V,PIPE_MTE2>(7);capi_wait<PIPE_V,PIPE_MTE2>(7);
capi_read_pad(inputBits,reinterpret_cast<__gm__ uint32_t*>(scale)+
(int64_t)expert*p.n+column,DataCopyExtParams{1,(uint32_t)columns*4,0,0,0},
DataCopyPadExtParams<uint32_t>{true,0,0,0});
capi_notify<PIPE_MTE2,PIPE_V>(7);capi_wait<PIPE_MTE2,PIPE_V>(7);
asc_add_scalar(reinterpret_cast<__ubuf__ int32_t*>(inputBits),
reinterpret_cast<__ubuf__ int32_t*>(inputBits),int32_t(0x1000),padded);
asc_sync_pipe(PIPE_V);
asc_and(reinterpret_cast<__ubuf__ uint16_t*>(inputBits),
reinterpret_cast<__ubuf__ uint16_t*>(inputBits),
reinterpret_cast<__ubuf__ uint16_t*>(keep),2*padded);
asc_sync_pipe(PIPE_V);
asc_gather(encoded,inputBits,reinterpret_cast<__ubuf__ uint32_t*>(offsets),2*padded);
capi_notify<PIPE_V,PIPE_MTE3>(7);capi_wait<PIPE_V,PIPE_MTE3>(7);
capi_write(quantizedScales+(int64_t)expert*quantizedStride+column,
reinterpret_cast<__ubuf__ uint64_t*>(encoded),padded);
capi_notify<PIPE_MTE3,PIPE_V>(7);capi_wait<PIPE_MTE3,PIPE_V>(7);
}
capi_notify<PIPE_MTE3,PIPE_S>(7);capi_wait<PIPE_MTE3,PIPE_S>(7);
if constexpr(SignalReady)capi_block_arrive<PIPE_MTE3,2>(5);
}
__aicore__ inline void capi_prepare_shared_coefficients(
GM_ADDR scale,__gm__ uint64_t* quantizedScales,GmmPlan p) {
const int core=asc_get_block_idx();
const int quantizedStride=(p.n+31)&~31;
auto inputBits=reinterpret_cast<__ubuf__ uint32_t*>(uint64_t(0));
auto encoded=reinterpret_cast<__ubuf__ uint32_t*>(uint64_t(4096));
auto offsets=reinterpret_cast<__ubuf__ int32_t*>(uint64_t(6144));
auto keep=reinterpret_cast<__ubuf__ uint32_t*>(uint64_t(8192));
static_assert(256==256,"Vector coefficient buffers require 256 columns");
for(int index=0;index<8;++index)
offsets[index]=((index&1)?256:0)*4+(index/2)*4;
capi_notify<PIPE_S,PIPE_V>(7);capi_wait<PIPE_S,PIPE_V>(7);
for(int count=8;count<2*256;count*=2) {
asc_add_scalar(offsets+count,offsets,int32_t(count*2),count);
asc_sync_pipe(PIPE_V);
}
asc_duplicate(keep,uint32_t(0xffffe000u),256);
asc_sync_pipe(PIPE_V);
const int panels=(p.n+256-1)/256;
const int lane=asc_get_sub_block_id();
const int ownedExperts=(p.e+p.cores-1-core)/p.cores;
for(int job=lane;job<ownedExperts*panels;job+=2) {
const int expert=core+(job/panels)*p.cores,column=(job%panels)*256;
const int columns=p.n-column<256?p.n-column:256;
const int padded=(columns+31)&~31;
asc_duplicate(inputBits,uint32_t(0),2*256);
capi_notify<PIPE_V,PIPE_MTE2>(7);capi_wait<PIPE_V,PIPE_MTE2>(7);
capi_read_pad(inputBits,reinterpret_cast<__gm__ uint32_t*>(scale)+
(int64_t)expert*p.n+column,DataCopyExtParams{1,(uint32_t)columns*4,0,0,0},
DataCopyPadExtParams<uint32_t>{true,0,0,0});
capi_notify<PIPE_MTE2,PIPE_V>(7);capi_wait<PIPE_MTE2,PIPE_V>(7);
asc_add_scalar(reinterpret_cast<__ubuf__ int32_t*>(inputBits),
reinterpret_cast<__ubuf__ int32_t*>(inputBits),int32_t(0x1000),padded);
asc_sync_pipe(PIPE_V);
asc_and(reinterpret_cast<__ubuf__ uint16_t*>(inputBits),
reinterpret_cast<__ubuf__ uint16_t*>(inputBits),
reinterpret_cast<__ubuf__ uint16_t*>(keep),2*padded);
asc_sync_pipe(PIPE_V);
asc_gather(encoded,inputBits,reinterpret_cast<__ubuf__ uint32_t*>(offsets),2*padded);
capi_notify<PIPE_V,PIPE_MTE3>(7);capi_wait<PIPE_V,PIPE_MTE3>(7);
capi_write(quantizedScales+(int64_t)expert*quantizedStride+column,
reinterpret_cast<__ubuf__ uint64_t*>(encoded),padded);
capi_notify<PIPE_MTE3,PIPE_V>(7);capi_wait<PIPE_MTE3,PIPE_V>(7);
}
capi_notify<PIPE_MTE3,PIPE_S>(7);capi_wait<PIPE_MTE3,PIPE_S>(7);
capi_block_arrive<PIPE_MTE3,0>(8);asc_sync_block_wait(8);
capi_block_arrive<PIPE_MTE3,2>(5);
}
template<int BM, int BN, int BK, int KP, bool ResidentA, bool ResidentB, pipe_t FixPipeline, bool AdaptiveB=false, bool UnitCompletion=false, bool SplitPublish=false, int WeightPrefixK=0,bool CacheL0B=false,bool CompactScratch=false,bool HalfScratch=false,bool K32MajorWeights=false,bool EarlyWeightReady=false,bool TwoWeightFragments=false,bool PrimeQueues=false,bool VectorDequant=false>
struct CapiPanelEngine {
static_assert(!CacheL0B || (!ResidentA && ResidentB && !AdaptiveB && BK==KP && BK*BN<=64*1024),
"The full reduction weight must fit one L0B slot");
static constexpr bool CachePrefix=WeightPrefixK>0;
static_assert(!EarlyWeightReady || K32MajorWeights,"Early readiness requires K32-major weights");
static_assert(!K32MajorWeights || (ResidentA && !ResidentB && !CachePrefix && BM==64 && BN==512),
"K32-major weights require the aligned streamed-weight path");
static_assert(!CachePrefix || (!ResidentB && WeightPrefixK%KP==0),
"The resident prefix must contain complete streamed panels");
static constexpr int ADepth=ResidentA?1:2;
static constexpr int BDepth=ResidentB?1:2;
CapiQueue<__cbuf__ int8_t*,CapiSpace::L1,PIPE_MTE2,PIPE_MTE1,ADepth,0,PrimeQueues> aq;
CapiQueue<__cbuf__ int8_t*,CapiSpace::L1,PIPE_MTE2,PIPE_MTE1,BDepth,2,PrimeQueues> bq;
CapiQueue<__cbuf__ int8_t*,CapiSpace::L1,PIPE_MTE2,PIPE_MTE1,1,6> prefixQueue;
CapiQueue<__ca__ int8_t*,CapiSpace::L0A,PIPE_MTE1,PIPE_M,2,0,PrimeQueues> a0q;
static constexpr int L0BDepth=CacheL0B?1:2;
CapiQueue<__cb__ int8_t*,CapiSpace::L0B,PIPE_MTE1,PIPE_M,L0BDepth,2,PrimeQueues> b0q;
CapiQueue<__cc__ int32_t*,CapiSpace::L0C,PIPE_M,FixPipeline,1,0,PrimeQueues> cq;
__gm__ int8_t* a;
__gm__ int8_t* b;
__cbuf__ int8_t* heldA=nullptr;
__cbuf__ int8_t* heldB=nullptr;
__cb__ int8_t* heldL0B=nullptr;
bool cachedL0BValid=false;
int aExpert=-1,aRow=-1,bExpert=-1,bColumn=-1;
bool aPrefetched=false,bPrefetched=false;
__gm__ uint64_t* quantizedScales=nullptr;
__cbuf__ uint64_t* quantizedLocal=nullptr;
bool coefficientMapReady=false;
int coefficientExpert=-1,coefficientColumn=0;
GmmPlan p;
__aicore__ inline void Init(CapiMemory& memory, GmmPlan plan,
__gm__ int8_t* input, __gm__ int8_t* weights) {
p=plan;a=input;b=weights;
int paddedK=(p.k+31)&~31;
memory.InitBuffer(aq,ADepth,BM*(ResidentA?paddedK:KP));
memory.InitBuffer(bq,BDepth,BN*(ResidentB?paddedK:KP));
if constexpr(CachePrefix)memory.InitBuffer(prefixQueue,1,BN*WeightPrefixK);
memory.InitBuffer(a0q,2,BM*BK);
memory.InitBuffer(b0q,L0BDepth,BN*(AdaptiveB?64:BK));
memory.InitBuffer(cq,1,BM*BN*4);
}
__aicore__ inline void LoadA(CapiTile tile,int panel,int count) {
auto local=aq.template AllocTensor<int8_t>();
capi_nd_to_nz(local,a+(int64_t)tile.row*p.k+panel,
tile.rows,count,p.k,(tile.rows+15)&~15);
aq.EnQue(local);
}
__aicore__ inline void LoadB(CapiTile tile,int panel,int count) {
auto local=bq.template AllocTensor<int8_t>();
auto source=b+(int64_t)tile.expert*p.k*p.n+
(int64_t)panel*p.n+tile.column;
if constexpr(EarlyWeightReady) {
if constexpr(TwoWeightFragments) {
const int firstStep=AdaptiveB && tile.columns>256?64:BK;
const int firstCount=count<firstStep?count:firstStep;
const int secondCount=count-firstCount<firstStep?count-firstCount:firstStep;
const int firstReady=4+((bq.allocations-1)&1);
asc_copy_gm2l1_nd2nz(local,source,firstCount/32,32,tile.columns,
32*p.n,p.n,32,1,32*tile.columns);
capi_notify<PIPE_MTE2,PIPE_MTE1>(firstReady);
if(secondCount>0)
asc_copy_gm2l1_nd2nz(local+firstCount*tile.columns,
source+int64_t(firstCount)*p.n,secondCount/32,32,tile.columns,
32*p.n,p.n,32,1,32*tile.columns);
capi_notify<PIPE_MTE2,PIPE_MTE1>(firstReady+2);
const int prefixCount=firstCount+secondCount;
if(prefixCount<count)
asc_copy_gm2l1_nd2nz(local+prefixCount*tile.columns,
source+int64_t(prefixCount)*p.n,(count-prefixCount)/32,32,tile.columns,
32*p.n,p.n,32,1,32*tile.columns);
} else {
const int firstStep=AdaptiveB && tile.columns>256?64:BK;
const int firstCount=count<firstStep?count:firstStep;
asc_copy_gm2l1_nd2nz(local,source,firstCount/32,32,tile.columns,
32*p.n,p.n,32,1,32*tile.columns);
capi_notify<PIPE_MTE2,PIPE_MTE1>(7);
if(firstCount<count)
asc_copy_gm2l1_nd2nz(local+firstCount*tile.columns,
source+int64_t(firstCount)*p.n,(count-firstCount)/32,32,tile.columns,
32*p.n,p.n,32,1,32*tile.columns);
}
} else if constexpr(K32MajorWeights) {
asc_copy_gm2l1_nd2nz(local,source,count/32,32,tile.columns,
32*p.n,p.n,32,1,32*tile.columns);
} else capi_nd_to_nz(local,source,count,tile.columns,p.n,(count+31)&~31);
bq.EnQue(local);
}
__aicore__ inline void LoadWeightFragment(__cb__ int8_t* target,
__cbuf__ int8_t* source,int offset,int reduction,int columns,int sourceRows) {
if constexpr(K32MajorWeights) {
asc_copy_l12l0b_trans(target,source+offset*columns,
0,(reduction/32)*(columns/32),1,1,false,0);
} else capi_l1_to_l0b(target,source+offset*32,reduction,columns,sourceRows);
}
__aicore__ inline void LoadPrefixPanel(CapiTile tile,int panel) {
capi_nd_to_nz(heldB+panel*32,b+(int64_t)tile.expert*p.k*p.n+
(int64_t)panel*p.n+tile.column,KP,tile.columns,p.n,WeightPrefixK);
capi_notify<PIPE_MTE2,PIPE_MTE1>(6);
}
__aicore__ inline void PrepareQuant(CapiTile tile) {
if(!coefficientMapReady) {
asc_sync_block_wait(5);coefficientMapReady=true;
}
if(coefficientExpert!=tile.expert) {
if(coefficientExpert>=0) {
capi_notify<PIPE_FIX,PIPE_MTE2>(7);capi_wait<PIPE_FIX,PIPE_MTE2>(7);
}
asc_copy_gm2l1(reinterpret_cast<__cbuf__ int8_t*>(quantizedLocal),
reinterpret_cast<__gm__ int8_t*>(quantizedScales+
(int64_t)tile.expert*((p.n+31)&~31)),
1,((p.n+31)&~31)/4,0,0);
capi_notify<PIPE_MTE2,PIPE_FIX>(7);capi_wait<PIPE_MTE2,PIPE_FIX>(7);
coefficientExpert=tile.expert;
}
coefficientColumn=tile.column;
}
__aicore__ inline void Publish(__gm__ int32_t* target,
__cc__ int32_t* accumulator,FixpipeParamsV220 copy) {
if constexpr(VectorDequant) {
for(int column=0;column<copy.nSize;column+=256) {
const int columns=copy.nSize-column<256?copy.nSize-column:256;
asc_copy_l12fb(reinterpret_cast<__fbuf__ void*>(uint64_t(0)),
reinterpret_cast<__cbuf__ void*>(quantizedLocal+coefficientColumn+column),
1,((columns+31)&~31)/16,0,0);
asc_sync_pipe(PIPE_FIX);
asc_set_l0c_copy_params(1,0,0);
asc_set_l0c2gm_config(0,0,true);
asc_copy_l0c2gm(reinterpret_cast<__gm__ half*>(target)+column,
accumulator+column*copy.srcStride,columns,copy.mSize,
copy.dstStride,copy.srcStride,column==0?copy.unitFlag:0,
static_cast<uint8_t>(QuantMode_t::VDEQF16),0,false,true);
asc_sync_pipe(PIPE_FIX);
}
} else if constexpr(HalfScratch) {
asc_set_l0c_copy_prequant(uint64_t(0x3b000000));
asc_set_l0c_copy_params(1,0,0);
asc_set_l0c2gm_config(0,0,true);
asc_copy_l0c2gm(reinterpret_cast<__gm__ half*>(target),accumulator,
copy.nSize,copy.mSize,copy.dstStride,copy.srcStride,copy.unitFlag,
static_cast<uint8_t>(QuantMode_t::DEQF16),0,false,true);
} else capi_fixpipe(target,accumulator,copy);
}
__aicore__ inline void MultiplyShortResident(
CapiTile tile,__gm__ int32_t* target,const CapiTile* nextTile,int reuseEvent) {
#if !GMM_OPT_LATE_WORKSPACE_WAIT
if(reuseEvent>=0)asc_sync_block_wait(reuseEvent);
#endif
if(!aPrefetched)LoadA(tile,0,p.k);
const bool newWeight=!cachedL0BValid || tile.expert!=bExpert || tile.column!=bColumn;
if(newWeight)LoadB(tile,0,p.k);
const int alignedRows=(tile.rows+15)&~15;
const int alignedColumns=(tile.columns+15)&~15;
auto activation=aq.template DeQue<int8_t>();
auto left=a0q.template AllocTensor<int8_t>();
capi_l1_to_l0a(left,activation,tile.rows,p.k,alignedRows,p.k);
a0q.EnQue(left);
aq.FreeTensor(activation);
if(newWeight) {
if(cachedL0BValid)b0q.FreeTensor(heldL0B);
auto localWeight=bq.template DeQue<int8_t>();
auto right=b0q.template AllocTensor<int8_t>();
capi_l1_to_l0b(right,localWeight,p.k,tile.columns,p.k);
b0q.EnQue(right);
bq.FreeTensor(localWeight);
heldL0B=b0q.template DeQue<int8_t>();
cachedL0BValid=true;
bExpert=tile.expert;
bColumn=tile.column;
}
auto accumulator=cq.template AllocTensor<int32_t>();
left=a0q.template DeQue<int8_t>();
asc_mmad(accumulator,left,heldL0B,alignedRows,p.k,alignedColumns,0,false,false,true);
a0q.FreeTensor(left);
if(nextTile)LoadA(*nextTile,0,p.k);
aPrefetched=nextTile!=nullptr;
capi_notify<PIPE_M,FixPipeline>(0);
capi_wait<PIPE_M,FixPipeline>(0);
cq.EnQue(accumulator);
accumulator=cq.template DeQue<int32_t>();
FixpipeParamsV220 copy;
copy.nSize=tile.columns;copy.mSize=tile.rows;
copy.srcStride=alignedRows;copy.dstStride=BN;
copy.ndNum=1;copy.srcNdStride=0;copy.dstNdStride=0;copy.unitFlag=0;
#if GMM_OPT_LATE_WORKSPACE_WAIT
if(reuseEvent>=0)asc_sync_block_wait(reuseEvent);
#endif
Publish(target,accumulator,copy);
cq.FreeTensor(accumulator);
}
__aicore__ inline void Multiply(CapiTile tile,__gm__ int32_t* target,
const CapiTile* nextTile, int reuseEvent=-1, int readySlot=0) {
if constexpr(CacheL0B) {
MultiplyShortResident(tile,target,nextTile,reuseEvent);
} else {
#if !GMM_OPT_LATE_WORKSPACE_WAIT
if(reuseEvent>=0)asc_sync_block_wait(reuseEvent);
#endif
int paddedK=(p.k+31)&~31;
int alignedRows=(tile.rows+15)&~15;
const bool splitRows=SplitPublish && tile.rows==BM;
bool unitFlags=UnitCompletion && !VectorDequant && !splitRows && tile.rows==alignedRows && tile.columns%16==0;
if(unitFlags)asc_set_mmad_direction_n();
int stepK=AdaptiveB && tile.columns>256?64:BK;
if constexpr (ResidentA) {
if(tile.expert!=aExpert || tile.row!=aRow) {
if(aExpert>=0)aq.FreeTensor(heldA);
LoadA(tile,0,p.k);
heldA=aq.template DeQue<int8_t>();
aExpert=tile.expert;aRow=tile.row;
}
}
if constexpr (ResidentB) {
if(tile.expert!=bExpert || tile.column!=bColumn) {
if(bExpert>=0)bq.FreeTensor(heldB);
LoadB(tile,0,p.k);
heldB=bq.template DeQue<int8_t>();
bExpert=tile.expert;bColumn=tile.column;
}
}
int initial=p.k<KP?p.k:KP;
if constexpr (!ResidentA) {
if(!aPrefetched)LoadA(tile,0,initial);
aPrefetched=false;
}
bool fillPrefix=false;
if constexpr(CachePrefix) {
if(tile.expert!=bExpert || tile.column!=bColumn) {
if(bExpert>=0)prefixQueue.FreeTensor(heldB);
heldB=prefixQueue.template AllocTensor<int8_t>();
fillPrefix=true;
LoadPrefixPanel(tile,0);
bExpert=tile.expert;bColumn=tile.column;
}
} else if constexpr (!ResidentB) {
if(!bPrefetched)LoadB(tile,0,initial);
bPrefetched=false;
}
auto accumulator=cq.template AllocTensor<int32_t>();
for(int panel=0;panel<p.k;panel+=KP) {
int count=p.k-panel<KP?p.k-panel:KP;
int paddedCount=(count+31)&~31;
__cbuf__ int8_t* localA;
__cbuf__ int8_t* localB;
int fullWeightEvent=-1;
if constexpr (ResidentA)localA=heldA;
else localA=aq.template DeQue<int8_t>();
if constexpr (ResidentB)localB=heldB+panel*32;
else if constexpr(CachePrefix) {
if(panel<WeightPrefixK) {
if(fillPrefix)capi_wait<PIPE_MTE2,PIPE_MTE1>(6);
localB=heldB+panel*32;
} else localB=bq.template DeQue<int8_t>();
}
else if constexpr(EarlyWeightReady) {
fullWeightEvent=2+(bq.dequeues&1);
localB=bq.template DeQue<int8_t,false>();
if constexpr(TwoWeightFragments)capi_wait<PIPE_MTE2,PIPE_MTE1>(fullWeightEvent+2);
else capi_wait<PIPE_MTE2,PIPE_MTE1>(7);
} else localB=bq.template DeQue<int8_t>();
if(panel+count<p.k) {
int next=panel+count,nextCount=p.k-next<KP?p.k-next:KP;
if constexpr (!ResidentA)LoadA(tile,next,nextCount);
if constexpr (CachePrefix) {
if(next>=WeightPrefixK)LoadB(tile,next,nextCount);
else if(fillPrefix)LoadPrefixPanel(tile,next);
} else if constexpr (!ResidentB)LoadB(tile,next,nextCount);
} else if(nextTile) {
if constexpr (!ResidentA) {
LoadA(*nextTile,0,initial);aPrefetched=true;
}
if constexpr (!ResidentB && !CachePrefix) {
LoadB(*nextTile,0,initial);bPrefetched=true;
}
}
int aColumns=ResidentA?paddedK:paddedCount;
int bRows=ResidentB?paddedK:paddedCount;
if constexpr(CachePrefix)if(panel<WeightPrefixK)bRows=WeightPrefixK;
int aOffset=ResidentA?panel:0;
int firstK=paddedCount<stepK?paddedCount:stepK;
auto firstA=a0q.template AllocTensor<int8_t>();
auto firstB=b0q.template AllocTensor<int8_t>();
capi_l1_to_l0a(firstA,localA,tile.rows,firstK,alignedRows,aColumns,aOffset);
LoadWeightFragment(firstB,localB,0,firstK,tile.columns,bRows);
a0q.EnQue(firstA);b0q.EnQue(firstB);
for(int inner=0;inner<paddedCount;inner+=stepK) {
int reduction=paddedCount-inner<stepK?paddedCount-inner:stepK;
auto left=a0q.template DeQue<int8_t>();
auto right=b0q.template DeQue<int8_t>();
bool finalReduction=panel+count>=p.k && inner+reduction>=paddedCount;
asc_mmad(accumulator,left,right,alignedRows,
reduction,(tile.columns+15)&~15,unitFlags?(finalReduction?3:2):0,
false,false,panel==0 && inner==0);
a0q.FreeTensor(left);b0q.FreeTensor(right);
int next=inner+stepK;
if(next<paddedCount) {
int nextK=paddedCount-next<stepK?paddedCount-next:stepK;
auto nextA=a0q.template AllocTensor<int8_t>();
auto nextB=b0q.template AllocTensor<int8_t>();
capi_l1_to_l0a(nextA,localA,tile.rows,nextK,alignedRows,
aColumns,aOffset+next);
if constexpr(EarlyWeightReady) {
if constexpr(TwoWeightFragments) {
if(next==stepK)capi_wait<PIPE_MTE2,PIPE_MTE1>(fullWeightEvent+4);
else if(next==2*stepK)capi_wait<PIPE_MTE2,PIPE_MTE1>(fullWeightEvent);
} else if(next==stepK)capi_wait<PIPE_MTE2,PIPE_MTE1>(fullWeightEvent);
}
LoadWeightFragment(nextB,localB,next,nextK,tile.columns,bRows);
a0q.EnQue(nextA);b0q.EnQue(nextB);
}
#if !GMM_OPT_ASYNC_MMA
if(!unitFlags && !splitRows)asc_sync_pipe(PIPE_M);
#endif
}
if constexpr(EarlyWeightReady) {
if constexpr(TwoWeightFragments) {
if(paddedCount<=stepK)capi_wait<PIPE_MTE2,PIPE_MTE1>(fullWeightEvent+4);
if(paddedCount<=2*stepK)capi_wait<PIPE_MTE2,PIPE_MTE1>(fullWeightEvent);
} else if(paddedCount<=stepK)capi_wait<PIPE_MTE2,PIPE_MTE1>(fullWeightEvent);
}
if constexpr (!ResidentA)aq.FreeTensor(localA);
if constexpr (CachePrefix) {
if(panel>=WeightPrefixK)bq.FreeTensor(localB);
} else if constexpr (!ResidentB)bq.FreeTensor(localB);
}
if(!unitFlags){capi_notify<PIPE_M,FixPipeline>(0);capi_wait<PIPE_M,FixPipeline>(0);}
if constexpr(VectorDequant)PrepareQuant(tile);
cq.EnQue(accumulator);accumulator=cq.template DeQue<int32_t>();
FixpipeParamsV220 copy;
copy.nSize=tile.columns;copy.mSize=tile.rows;
const int scratchStride=CompactScratch?capi_aligned_scratch_stride(tile.columns):BN;
copy.srcStride=alignedRows;copy.dstStride=scratchStride;
copy.ndNum=1;copy.srcNdStride=0;copy.dstNdStride=0;copy.unitFlag=unitFlags?3:0;
#if GMM_OPT_LATE_WORKSPACE_WAIT
if(reuseEvent>=0)asc_sync_block_wait(reuseEvent);
#endif
if constexpr (SplitPublish) {
if(splitRows && !VectorDequant) {
constexpr int HalfRows=BM/2;
constexpr int FractalWidth=16;
copy.mSize=HalfRows;
Publish(target,accumulator,copy);
capi_block_arrive<PIPE_FIX,2>(readySlot);
Publish(target+HalfRows*scratchStride/(HalfScratch?2:1),
accumulator+HalfRows*FractalWidth,copy);
} else {
Publish(target,accumulator,copy);
capi_block_arrive<PIPE_FIX,2>(readySlot);
}
capi_block_arrive<PIPE_FIX,2>(4+readySlot);
} else {
Publish(target,accumulator,copy);
}
cq.FreeTensor(accumulator);
}
}
__aicore__ inline void Finish() {
if constexpr(CacheL0B) {
if(cachedL0BValid)b0q.FreeTensor(heldL0B);
} else {
if constexpr (ResidentA)if(aExpert>=0){aq.FreeTensor(heldA);aExpert=-1;}
if constexpr (ResidentB)if(bExpert>=0){bq.FreeTensor(heldB);bExpert=-1;}
}
if constexpr (CachePrefix)if(bExpert>=0){prefixQueue.FreeTensor(heldB);bExpert=-1;}
}
};
template<int BM,int BN,int PAD=0>
__global__ __aicore__ __schedmode__(1) void gmm_capi_single(
GM_ADDR x,GM_ADDR weight,GM_ADDR scale,GM_ADDR groups,
GM_ADDR output,GM_ADDR workspace,GmmPlan p) {
KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
InitSocState();
int core=asc_get_block_idx();
CapiTraversal<BM,BN,0,0> traversal(reinterpret_cast<__gm__ int64_t*>(groups),p,core);
CapiTile tile;
if(!traversal.Next(tile))return;
auto scratch=reinterpret_cast<__gm__ int32_t*>(workspace)+(int64_t)core*BM*BN;
if ASCEND_IS_AIC {
auto a1=reinterpret_cast<__cbuf__ int8_t*>(uint64_t(0));
auto b1=reinterpret_cast<__cbuf__ int8_t*>(uint64_t(BM*512));
auto a0=reinterpret_cast<__ca__ int8_t*>(uint64_t(0));
auto b0=reinterpret_cast<__cb__ int8_t*>(uint64_t(0));
auto c0=reinterpret_cast<__cc__ int32_t*>(uint64_t(0));
int alignedRows=(tile.rows+15)&~15;
bool flags=tile.rows==alignedRows && tile.columns%16==0;
asc_set_mmad_direction_n();
capi_nd_to_nz(a1,reinterpret_cast<__gm__ int8_t*>(x)+(int64_t)tile.row*p.k,
tile.rows,p.k,p.k,alignedRows);
capi_nd_to_nz(b1,reinterpret_cast<__gm__ int8_t*>(weight)+
(int64_t)tile.expert*p.k*p.n+tile.column,p.k,tile.columns,p.n,p.k);
capi_notify<PIPE_MTE2,PIPE_MTE1>(0);capi_wait<PIPE_MTE2,PIPE_MTE1>(0);
capi_l1_to_l0a(a0,a1,tile.rows,p.k,alignedRows,p.k);
capi_l1_to_l0b(b0,b1,p.k,tile.columns,p.k);
capi_notify<PIPE_MTE1,PIPE_M>(0);capi_wait<PIPE_MTE1,PIPE_M>(0);
asc_mmad(c0,a0,b0,alignedRows,p.k,(tile.columns+15)&~15,flags?3:0,false,false,true);
if(!flags){capi_notify<PIPE_M,PIPE_FIX>(0);capi_wait<PIPE_M,PIPE_FIX>(0);}
FixpipeParamsV220 copy;
copy.nSize=tile.columns;copy.mSize=tile.rows;copy.srcStride=alignedRows;
copy.dstStride=BN;copy.ndNum=1;copy.srcNdStride=0;copy.dstNdStride=0;copy.unitFlag=flags?3:0;
capi_fixpipe(scratch,c0,copy);
capi_block_arrive<PIPE_FIX,2>(0);
} else {
int halfRows=capi_vector_half_rows<BM>(tile.rows);
int slice=asc_get_sub_block_id()*halfRows;
int rows=tile.rows-slice<halfRows?tile.rows-slice:halfRows;
if(rows<=0){asc_sync_block_wait(0);return;}
constexpr int SIZE=BM/2*BN;
auto ci=reinterpret_cast<__ubuf__ int32_t*>(uint64_t(256));
auto z=reinterpret_cast<__ubuf__ float*>(uint64_t(256+SIZE*4+PAD));
auto v=reinterpret_cast<__ubuf__ float*>(uint64_t(256+SIZE*8+2*PAD));
auto scales=reinterpret_cast<__ubuf__ float*>(uint64_t(256+SIZE*12+3*PAD));
auto out=reinterpret_cast<__ubuf__ half*>(ci);
DataCopyExtParams sp{1,(uint32_t)tile.columns*4,0,0,0};
capi_read_pad(scales,reinterpret_cast<__gm__ float*>(scale)+
(int64_t)tile.expert*p.n+tile.column,sp,DataCopyPadExtParams<float>{true,0,0,0.0f});
asc_sync_block_wait(0);
capi_read(ci,scratch+slice*BN,rows*BN);
capi_notify<PIPE_MTE2,PIPE_V>(0);capi_wait<PIPE_MTE2,PIPE_V>(0);
asc_int322float_rn(z,ci,rows*BN);asc_sync_pipe(PIPE_V);
asc_set_mask_norm();asc_set_vector_mask(0,~uint64_t(0));
for(int col=0;col<BN;col+=64)
asc_mul(z+col,z+col,scales+col,rows,1,1,1,BN/8,BN/8,0);
asc_sync_pipe(PIPE_V);
capi_finish_gelu(z,v,out,rows*BN);
capi_notify<PIPE_V,PIPE_MTE3>(0);capi_wait<PIPE_V,PIPE_MTE3>(0);
DataCopyExtParams op{(uint16_t)rows,(uint32_t)tile.columns*2,
(uint32_t)((BN-((tile.columns+15)&~15))/16),(uint32_t)(p.n-tile.columns)*2,0};
capi_write_pad(reinterpret_cast<__gm__ half*>(output)+
(int64_t)(tile.row+slice)*p.n+tile.column,out,op);
capi_notify<PIPE_MTE3,PIPE_S>(0);capi_wait<PIPE_MTE3,PIPE_S>(0);
}
}
template<int BM,int BN>
struct CapiExpertTraversal {
__gm__ int64_t* ends;
GmmPlan p;
int expert,row=0,column=0,end=0;
bool loaded=false;
__aicore__ CapiExpertTraversal(__gm__ int64_t* groups,GmmPlan plan,int block)
:ends(groups),p(plan),expert(block) {}
__aicore__ inline bool Next(CapiTile& result) {
while(expert<p.e) {
if(!loaded) {
row=expert==0?0:int(ends[expert-1]);
end=int(ends[expert]);
column=0;
loaded=true;
}
if(row>=end) {
expert+=p.cores;
loaded=false;
continue;
}
result={expert,row,column,end-row<BM?end-row:BM,
p.n-column<BN?p.n-column:BN};
column+=BN;
if(column>=p.n){column=0;row+=BM;}
return true;
}
return false;
}
};
struct CceHalfKEngine {
__gm__ int8_t* input;
__gm__ int8_t* weights;
__gm__ uint64_t* quantizedScales=nullptr;
__cbuf__ uint64_t* quantizedLocal=nullptr;
GmmPlan plan;
int activationExpert=-1,activationRow=-1,coefficientExpert=-1;
int operandSlot=0,activationSlot=0;
bool prefetched=false,coefficientsReady=false;
__aicore__ inline void Init(CapiMemory& memory,GmmPlan p,
__gm__ int8_t* a,__gm__ int8_t* b) {
plan=p;input=a;weights=b;
memory.l1=65536+512*768;
set_flag(PIPE_MTE1,PIPE_MTE2,EVENT_ID0);
set_flag(PIPE_MTE1,PIPE_MTE2,EVENT_ID1);
set_flag(PIPE_MTE1,PIPE_MTE2,EVENT_ID2);
set_flag(PIPE_MTE1,PIPE_MTE2,EVENT_ID3);
for(int slot=0;slot<2;++slot)set_flag(PIPE_M,PIPE_MTE1,static_cast<event_t>(slot));
set_flag(PIPE_FIX,PIPE_M,EVENT_ID0);
}
__aicore__ inline void LoadActivation(CapiTile tile,int slot) {
wait_flag(PIPE_MTE1,PIPE_MTE2,static_cast<event_t>(slot));
copy_gm_to_cbuf_multi_nd2nz_b8(
reinterpret_cast<__cbuf__ int8_t*>(uint64_t(slot*32768)),
input+int64_t(tile.row)*plan.k,0,1,tile.rows,plan.k,0,plan.k,(tile.rows+15)&~15,1,0);
set_flag(PIPE_MTE2,PIPE_MTE1,static_cast<event_t>(slot));
}
__aicore__ inline void PackFull(int expert) {
wait_flag(PIPE_MTE1,PIPE_MTE2,EVENT_ID2);
auto dst=reinterpret_cast<__cbuf__ int8_t*>(uint64_t(65536));
auto src=weights+int64_t(expert)*plan.k*plan.n;
copy_gm_to_cbuf_multi_nd2nz_b8(dst,src,0,2,32,512,32*plan.n,plan.n,32,1,32*512);
set_flag(PIPE_MTE2,PIPE_MTE1,EVENT_ID4);
copy_gm_to_cbuf_multi_nd2nz_b8(dst+64*512,src+64*plan.n,
0,2,32,512,32*plan.n,plan.n,32,1,32*512);
set_flag(PIPE_MTE2,PIPE_MTE1,EVENT_ID5);
copy_gm_to_cbuf_multi_nd2nz_b8(dst+128*512,src+128*plan.n,
0,4,32,512,32*plan.n,plan.n,32,1,32*512);
set_flag(PIPE_MTE2,PIPE_MTE1,EVENT_ID6);
copy_gm_to_cbuf_multi_nd2nz_b8(dst+256*512,src+256*plan.n,
0,(plan.k-256)/32,32,512,32*plan.n,plan.n,32,1,32*512);
set_flag(PIPE_MTE2,PIPE_MTE1,EVENT_ID7);
}
__aicore__ inline void PackTail(int expert) {
wait_flag(PIPE_MTE1,PIPE_MTE2,EVENT_ID3);
copy_gm_to_cbuf_multi_nd2nz_b8(
reinterpret_cast<__cbuf__ int8_t*>(uint64_t(65536+512*512)),
weights+int64_t(expert)*plan.k*plan.n+512,
0,plan.k/32,32,plan.n-512,32*plan.n,plan.n,32,1,32*(plan.n-512));
set_flag(PIPE_MTE2,PIPE_MTE1,EVENT_ID2);
}
__aicore__ inline void LoadOperands(CapiTile tile,int reductionOffset,
int count,int alignedRows,int slot) {
wait_flag(PIPE_M,PIPE_MTE1,static_cast<event_t>(slot));
auto left=reinterpret_cast<__ca__ int8_t*>(uint64_t(slot*8192));
auto right=reinterpret_cast<__cb__ int8_t*>(uint64_t(slot*32768));
asc_copy_l12l0a(left,reinterpret_cast<__cbuf__ int8_t*>(uint64_t(activationSlot*32768)),
count,alignedRows,reductionOffset,0,1,1,1,1,1,1,false,false,false,false,plan.k);
auto b=reinterpret_cast<__cbuf__ int8_t*>(uint64_t(65536+(tile.column==0?0:512*512)));
load_cbuf_to_cb_transpose(right,b+reductionOffset*tile.columns,0,
(count/32)*(tile.columns/32),1,1,false,0);
set_flag(PIPE_MTE1,PIPE_M,static_cast<event_t>(slot));
}
__aicore__ inline void Multiply(CapiTile tile,__gm__ int32_t* target,
const CapiTile* nextTile,int reuseEvent=-1,int readySlot=0) {
if(reuseEvent>=0)asc_sync_block_wait(reuseEvent);
const int alignedRows=(tile.rows+15)&~15;
if(tile.column==0) {
if(prefetched)activationSlot^=1;
else LoadActivation(tile,activationSlot);
wait_flag(PIPE_MTE2,PIPE_MTE1,static_cast<event_t>(activationSlot));
if(!prefetched)PackFull(tile.expert);
prefetched=false;
if(coefficientExpert!=tile.expert) {
const int owned=(tile.expert-asc_get_block_idx())/plan.cores;
asc_sync_block_wait(8+owned);
asc_copy_gm2l1(reinterpret_cast<__cbuf__ int8_t*>(quantizedLocal+owned*plan.n),
reinterpret_cast<__gm__ int8_t*>(quantizedScales+int64_t(tile.expert)*plan.n),
1,plan.n/4,0,0);
set_flag(PIPE_MTE2,PIPE_FIX,EVENT_ID7);
coefficientExpert=tile.expert;
}
PackTail(tile.expert);
wait_flag(PIPE_MTE2,PIPE_MTE1,EVENT_ID4);
} else {
wait_flag(PIPE_MTE2,PIPE_MTE1,EVENT_ID2);
if(nextTile && nextTile->column==0) {
LoadActivation(*nextTile,activationSlot^1);
PackFull(nextTile->expert);prefetched=true;
}
}
wait_flag(PIPE_FIX,PIPE_M,EVENT_ID0);
auto accumulator=reinterpret_cast<__cc__ int32_t*>(uint64_t(0));
asc_l13d_fmatrix_config matrix{};
matrix.config=(uint64_t(1)<<16)|alignedRows;
asc_set_l13d_fmatrix(matrix);
const int step=tile.columns>256?64:128;
LoadOperands(tile,0,step,alignedRows,operandSlot);
for(int reduction=0;reduction<plan.k;reduction+=step) {
const int slot=operandSlot;operandSlot^=1;
wait_flag(PIPE_MTE1,PIPE_M,static_cast<event_t>(slot));
mad(accumulator,reinterpret_cast<__ca__ int8_t*>(uint64_t(slot*8192)),
reinterpret_cast<__cb__ int8_t*>(uint64_t(slot*32768)),
alignedRows,step,(tile.columns+15)&~15,0,false,false,reduction==0);
set_flag(PIPE_M,PIPE_MTE1,static_cast<event_t>(slot));
if(reduction+step<plan.k) {
if(tile.column==0) {
if(reduction+step==64)wait_flag(PIPE_MTE2,PIPE_MTE1,EVENT_ID5);
if(reduction+step==128)wait_flag(PIPE_MTE2,PIPE_MTE1,EVENT_ID6);
if(reduction+step==256)wait_flag(PIPE_MTE2,PIPE_MTE1,EVENT_ID7);
}
LoadOperands(tile,reduction+step,step,alignedRows,operandSlot);
}
if(tile.rows!=64)pipe_barrier(PIPE_M);
}
set_flag(PIPE_MTE1,PIPE_MTE2,tile.column==0?EVENT_ID2:EVENT_ID3);
if(tile.column!=0)set_flag(PIPE_MTE1,PIPE_MTE2,static_cast<event_t>(activationSlot));
set_flag(PIPE_M,PIPE_FIX,EVENT_ID0);wait_flag(PIPE_M,PIPE_FIX,EVENT_ID0);
if(tile.column==0)wait_flag(PIPE_MTE2,PIPE_FIX,EVENT_ID7);
const int coefficientOffset=((tile.expert-asc_get_block_idx())/plan.cores)*plan.n;
for(int column=0;column<tile.columns;column+=256) {
const int columns=tile.columns-column<256?tile.columns-column:256;
asc_copy_l12fb(reinterpret_cast<__fbuf__ void*>(uint64_t(0)),
reinterpret_cast<__cbuf__ void*>(quantizedLocal+coefficientOffset+tile.column+column),
1,((columns+31)&~31)/16,0,0);
pipe_barrier(PIPE_FIX);
asc_set_l0c_copy_params(1,0,0);asc_set_l0c2gm_config(0,0,true);
copy_matrix_cc_to_gm(reinterpret_cast<__gm__ half*>(target)+column,
accumulator+column*alignedRows,0,columns,tile.rows,
capi_aligned_scratch_stride(tile.columns),alignedRows,0,
QuantMode_t::VDEQF16,0,false,true);
pipe_barrier(PIPE_FIX);
}
capi_block_arrive<PIPE_FIX,2>(readySlot);
capi_block_arrive<PIPE_FIX,2>(4+readySlot);
set_flag(PIPE_FIX,PIPE_M,EVENT_ID0);
}
__aicore__ inline void Finish() {
wait_flag(PIPE_MTE1,PIPE_MTE2,EVENT_ID0);
wait_flag(PIPE_MTE1,PIPE_MTE2,EVENT_ID1);
wait_flag(PIPE_MTE1,PIPE_MTE2,EVENT_ID2);
wait_flag(PIPE_MTE1,PIPE_MTE2,EVENT_ID3);
for(int slot=0;slot<2;++slot)wait_flag(PIPE_M,PIPE_MTE1,static_cast<event_t>(slot));
wait_flag(PIPE_FIX,PIPE_M,EVENT_ID0);
}
};
struct CceK1024Engine {
__gm__ int8_t* input;
__gm__ int8_t* weights;
__gm__ uint64_t* quantizedScales=nullptr;
__cbuf__ uint64_t* quantizedLocal=nullptr;
GmmPlan plan;
int activationExpert=-1,activationRow=-1,coefficientExpert=-1;
int writeSlot=0,readSlot=0,operandSlot=0;
bool prefetched=false,coefficientsReady=false,previousUnit=false;
__aicore__ inline void Init(CapiMemory& memory,GmmPlan p,
__gm__ int8_t* a,__gm__ int8_t* b) {
plan=p;input=a;weights=b;
asc_set_l0c2gm_config(0,0,true);
memory.l1=65536+2*196608;
set_flag(PIPE_MTE1,PIPE_MTE2,EVENT_ID0);
set_flag(PIPE_MTE1,PIPE_MTE2,EVENT_ID2);
set_flag(PIPE_MTE1,PIPE_MTE2,EVENT_ID3);
for(int slot=0;slot<2;++slot) {
set_flag(PIPE_M,PIPE_MTE1,static_cast<event_t>(slot));
}
}
__aicore__ inline void LoadB(CapiTile tile,int panel) {
const int slot=writeSlot;writeSlot^=1;
wait_flag(PIPE_MTE1,PIPE_MTE2,static_cast<event_t>(2+slot));
auto dst=reinterpret_cast<__cbuf__ int8_t*>(uint64_t(65536+slot*196608));
auto src=weights+(int64_t(tile.expert)*plan.k+panel)*plan.n+tile.column;
const int step=tile.columns>256?64:128;
const int count=plan.k-panel<384?plan.k-panel:384;
copy_gm_to_cbuf_multi_nd2nz_b8(dst,src,0,step/32,32,tile.columns,
32*plan.n,plan.n,32,1,32*tile.columns);
set_flag(PIPE_MTE2,PIPE_MTE1,static_cast<event_t>(4+slot));
copy_gm_to_cbuf_multi_nd2nz_b8(dst+step*tile.columns,src+step*plan.n,
0,step/32,32,tile.columns,32*plan.n,plan.n,32,1,32*tile.columns);
set_flag(PIPE_MTE2,PIPE_MTE1,static_cast<event_t>(6+slot));
if(2*step<count)
copy_gm_to_cbuf_multi_nd2nz_b8(dst+2*step*tile.columns,src+2*step*plan.n,
0,(count-2*step)/32,32,tile.columns,32*plan.n,plan.n,32,1,32*tile.columns);
set_flag(PIPE_MTE2,PIPE_MTE1,static_cast<event_t>(2+slot));
}
__aicore__ inline void LoadOperands(CapiTile tile,__cbuf__ int8_t* b,
int reductionOffset,int inner,int count,int alignedRows,int slot) {
wait_flag(PIPE_M,PIPE_MTE1,static_cast<event_t>(slot));
auto left=reinterpret_cast<__ca__ int8_t*>(uint64_t(slot*8192));
auto right=reinterpret_cast<__cb__ int8_t*>(uint64_t(slot*32768));
asc_copy_l12l0a(left,reinterpret_cast<__cbuf__ int8_t*>(uint64_t(0)),
count,alignedRows,reductionOffset,0,1,1,1,1,1,1,false,false,false,false,plan.k);
load_cbuf_to_cb_transpose(right,b+inner*tile.columns,0,
(count/32)*(tile.columns/32),1,1,false,0);
set_flag(PIPE_MTE1,PIPE_M,static_cast<event_t>(slot));
}
__aicore__ inline void Multiply(CapiTile tile,__gm__ int32_t* target,
const CapiTile* nextTile,int reuseEvent=-1,int readySlot=0) {
const int alignedRows=(tile.rows+15)&~15;
const bool unitFlags=tile.rows==alignedRows && tile.columns%16==0;
if(unitFlags)asc_set_mmad_direction_n();
if(tile.expert!=activationExpert || tile.row!=activationRow) {
if(activationExpert>=0)set_flag(PIPE_MTE1,PIPE_MTE2,EVENT_ID0);
wait_flag(PIPE_MTE1,PIPE_MTE2,EVENT_ID0);
copy_gm_to_cbuf_multi_nd2nz_b8(reinterpret_cast<__cbuf__ int8_t*>(uint64_t(0)),
input+int64_t(tile.row)*plan.k,0,1,tile.rows,plan.k,0,plan.k,alignedRows,1,0);
set_flag(PIPE_MTE2,PIPE_MTE1,EVENT_ID0);
wait_flag(PIPE_MTE2,PIPE_MTE1,EVENT_ID0);
activationExpert=tile.expert;activationRow=tile.row;
}
if(!prefetched)LoadB(tile,0);
prefetched=false;
if(!unitFlags || !previousUnit){set_flag(PIPE_FIX,PIPE_M,EVENT_ID0);wait_flag(PIPE_FIX,PIPE_M,EVENT_ID0);}
previousUnit=unitFlags;
auto accumulator=reinterpret_cast<__cc__ int32_t*>(uint64_t(0));
asc_l13d_fmatrix_config matrix{};
matrix.config=(uint64_t(1)<<16)|alignedRows;
asc_set_l13d_fmatrix(matrix);
const int step=tile.columns>256?64:128;
for(int panel=0;panel<plan.k;panel+=384) {
const int count=plan.k-panel<384?plan.k-panel:384;
const int stage=readSlot;readSlot^=1;
auto b=reinterpret_cast<__cbuf__ int8_t*>(uint64_t(65536+stage*196608));
wait_flag(PIPE_MTE2,PIPE_MTE1,static_cast<event_t>(4+stage));
if(panel+count<plan.k)LoadB(tile,panel+count);
else if(nextTile){LoadB(*nextTile,0);prefetched=true;}
LoadOperands(tile,b,panel,0,step,alignedRows,operandSlot);
for(int inner=0;inner<count;inner+=step) {
const int slot=operandSlot;operandSlot^=1;
wait_flag(PIPE_MTE1,PIPE_M,static_cast<event_t>(slot));
mad(accumulator,reinterpret_cast<__ca__ int8_t*>(uint64_t(slot*8192)),
reinterpret_cast<__cb__ int8_t*>(uint64_t(slot*32768)),
alignedRows,step,(tile.columns+15)&~15,unitFlags?(panel+inner+step==plan.k?3:2):0,false,false,panel==0 && inner==0);
set_flag(PIPE_M,PIPE_MTE1,static_cast<event_t>(slot));
const int next=inner+step;
if(next<count) {
if(next==step)wait_flag(PIPE_MTE2,PIPE_MTE1,static_cast<event_t>(6+stage));
else if(next==2*step)wait_flag(PIPE_MTE2,PIPE_MTE1,static_cast<event_t>(2+stage));
LoadOperands(tile,b,panel+next,next,step,alignedRows,operandSlot);
}
if(tile.rows!=64)pipe_barrier(PIPE_M);
}
if(count<=2*step)wait_flag(PIPE_MTE2,PIPE_MTE1,static_cast<event_t>(2+stage));
set_flag(PIPE_MTE1,PIPE_MTE2,static_cast<event_t>(2+stage));
}
if(!unitFlags){set_flag(PIPE_M,PIPE_FIX,EVENT_ID0);wait_flag(PIPE_M,PIPE_FIX,EVENT_ID0);}
if(reuseEvent>=0)asc_sync_block_wait(reuseEvent);
asc_set_l0c_copy_prequant(uint64_t(0x3b000000));
asc_set_l0c_copy_params(1,0,0);
asc_set_l0c2gm_config(0,0,false);
copy_matrix_cc_to_gm(reinterpret_cast<__gm__ half*>(target),accumulator,
0,tile.columns,tile.rows,512,alignedRows,unitFlags?3:0,
QuantMode_t::DEQF16,0,false,true);
}
__aicore__ inline void Finish() {
if(activationExpert>=0)set_flag(PIPE_MTE1,PIPE_MTE2,EVENT_ID0);
wait_flag(PIPE_MTE1,PIPE_MTE2,EVENT_ID0);
wait_flag(PIPE_MTE1,PIPE_MTE2,EVENT_ID2);
wait_flag(PIPE_MTE1,PIPE_MTE2,EVENT_ID3);
for(int slot=0;slot<2;++slot) {
wait_flag(PIPE_M,PIPE_MTE1,static_cast<event_t>(slot));
}
set_flag(PIPE_FIX,PIPE_M,EVENT_ID0);wait_flag(PIPE_FIX,PIPE_M,EVENT_ID0);
}
};
template<int BM,int BN,int Mode=0,int PAD=192,int VROWS=0,
bool PackTail=false,int Rotate=0,bool SingleTile=false,int PanelK=0,
bool UnclippedGelu=false,bool WholeVectorHalf=false,bool SplitPublish=false,int WeightPrefixK=0,bool CacheL0B=false,bool CompactScratch=false,bool HalfScratch=false,bool StagedK32Engine=false,bool K32MajorWeights=false,bool EarlyWeightReady=false,bool TwoWeightFragments=false,bool ExpertOwnership=false,bool PrimeQueues=false,bool VectorDequant=false,bool FloatDequantGelu=false>
__global__ __aicore__ __schedmode__(1) void gmm_capi_panels(
GM_ADDR x,GM_ADDR weight,GM_ADDR scale,GM_ADDR groups,
GM_ADDR output,GM_ADDR workspace,GmmPlan p) {
KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
InitSocState();
static_assert(!SplitPublish || (WholeVectorHalf && !SingleTile),
"Two-phase publication requires the whole-half Vector path");
static_assert(!CompactScratch || (SplitPublish && PackTail && !CacheL0B),
"Compact scratch requires the streamed two-phase tail path");
constexpr int BK=CacheL0B?256:(Mode==1 && BN==512?128:(BN>256?64:128));
constexpr int KP=PanelK>0?PanelK:(Mode==1 && BN==512?384:(BN>256?256:512));
constexpr int MAX_ROWS=BM/2<8192/BN?BM/2:8192/BN;
constexpr int CHUNK=VROWS>0 && VROWS<MAX_ROWS?VROWS:MAX_ROWS;
constexpr int SIZE=WholeVectorHalf?(BM/2)*BN:CHUNK*BN;
constexpr int TEMP_SIZE=HalfScratch && !FloatDequantGelu?SIZE/2:SIZE;
constexpr int StorageStride=HalfScratch?SIZE/2:SIZE;
static_assert(!HalfScratch || SIZE*10+256+4*PAD+BN*4<=192*1024,
"Half input and FP32 expansion exceed UB capacity");
static_assert(!WholeVectorHalf ||
(BM==64 && BN==512 && Mode==1 && Rotate==0 && !SingleTile &&
(SIZE+SIZE/2)*4+TEMP_SIZE*4+256+5*PAD+BN*4<=192*1024),
"Asymmetric full-width and tail vector buffers must fit UB");
constexpr bool BUFFERED_GELU=Mode==1 && BN==512 && VROWS==0;
int core=asc_get_block_idx();
auto ends=reinterpret_cast<__gm__ int64_t*>(groups);
auto scratch=reinterpret_cast<__gm__ int32_t*>(workspace)+
(int64_t)core*(SingleTile?1:2)*BM*BN;
static_assert(!ExpertOwnership || (Mode==1 && Rotate==0),"Expert ownership requires unrotated resident activations");
using Traversal=typename std::conditional<ExpertOwnership,CapiExpertTraversal<BM,BN>,
CapiTraversal<BM,BN,Mode,Rotate,(WeightPrefixK>0)>>::type;
auto quantizedScales=reinterpret_cast<__gm__ uint64_t*>(
reinterpret_cast<__gm__ int8_t*>(workspace)+(int64_t)p.cores*2*BM*BN*4);
if constexpr(VectorDequant) {
static_assert(HalfScratch,
"Owner-local coefficients require shared expert ownership");
if ASCEND_IS_AIV {
if constexpr(ExpertOwnership && VectorDequant && WholeVectorHalf && SplitPublish && PanelK==256)
capi_prepare_split_expert_coefficients(scale,quantizedScales,p);
else if constexpr(ExpertOwnership)capi_prepare_column_coefficients(scale,quantizedScales,p);
else capi_prepare_shared_coefficients(scale,quantizedScales,p);
}
}
Traversal traversal(ends,p,core);
CapiTile tile;
CapiMemory memory;
if ASCEND_IS_AIC {
using GenericEngine=CapiPanelEngine<BM,BN,BK,KP,Mode==1,(Mode>=2 && Mode<=4 && WeightPrefixK==0),
PIPE_FIX,(Mode==1 && BN==512),(Mode==1 && BN==512),SplitPublish,
WeightPrefixK,CacheL0B,CompactScratch,HalfScratch,K32MajorWeights,EarlyWeightReady,TwoWeightFragments,PrimeQueues,VectorDequant>;
using OtherEngine=typename std::conditional<StagedK32Engine && HalfScratch && K32MajorWeights && ExpertOwnership && BM==64 && BN==512,
CceK1024Engine,GenericEngine>::type;
using SelectedEngine=typename std::conditional<VectorDequant && WholeVectorHalf && SplitPublish && PanelK==256,
CceHalfKEngine,OtherEngine>::type;
SelectedEngine engine;
engine.Init(memory,p,reinterpret_cast<__gm__ int8_t*>(x),
reinterpret_cast<__gm__ int8_t*>(weight));
if constexpr(VectorDequant) {
engine.quantizedScales=quantizedScales;
engine.quantizedLocal=reinterpret_cast<__cbuf__ uint64_t*>(uint64_t(memory.l1));
if constexpr(VectorDequant && WholeVectorHalf && SplitPublish && PanelK==256)
memory.l1+=((p.e+p.cores-1-core)/p.cores)*((p.n+31)&~31)*8;
else memory.l1+=((p.n+31)&~31)*8;
}
int produced=0;
bool active=traversal.Next(tile);
while(active) {
CapiTile next;
bool hasNext=traversal.Next(next);
int slot=SingleTile?0:produced&1;
engine.Multiply(tile,scratch+slot*BM*BN,hasNext?&next:nullptr,
!SingleTile && produced>=2?2+slot:-1,slot);
if constexpr(!SplitPublish)capi_block_arrive<PIPE_FIX,2>(slot);
++produced;
active=hasNext;
if(hasNext)tile=next;
}
engine.Finish();
if constexpr (!SingleTile) {
if(produced>=1)asc_sync_block_wait(2);
if(produced>=2)asc_sync_block_wait(3);
}
} else {
if constexpr(false) {
::capi_vector_stream<BM,BN,CHUNK,false,BUFFERED_GELU,PackTail,false,true>(
traversal,tile,p,scratch,scale,output);
} else {
CapiBuffer cb,zb,vb,tb,sb;
memory.InitBuffer(cb,HalfScratch?SIZE*4+PAD:(WholeVectorHalf?(SIZE+SIZE/2)*4+PAD:SIZE*8+PAD));
memory.InitBuffer(zb,WholeVectorHalf && !HalfScratch?0:SIZE*4+PAD);
memory.InitBuffer(vb,TEMP_SIZE*4+PAD);
if constexpr(FloatDequantGelu || (BUFFERED_GELU && !WholeVectorHalf && !HalfScratch))memory.InitBuffer(tb,TEMP_SIZE*4+PAD);
memory.InitBuffer(sb,BN*4+PAD);
auto storage=cb.Get<int32_t>();
auto z=zb.Get<float>();auto v=vb.Get<float>();auto scales=sb.Get<float>();
auto temporary=tb.Get<float>();
auto sg=reinterpret_cast<__gm__ float*>(scale);
auto yg=reinterpret_cast<__gm__ half*>(output);
bool pending[2]={false,false},scalePending=false,scaleNeedsAdjust=false;
int lastExpert=-1,lastColumn=-1,consumed=0;
while(traversal.Next(tile)) {
int slot=SingleTile?0:(consumed&1);
++consumed;
int halfRows=capi_vector_half_rows<BM>(tile.rows);
int slice=asc_get_sub_block_id()*halfRows;
int localRows=tile.rows-slice<halfRows?tile.rows-slice:halfRows;
if(!VectorDequant && localRows>0 && (tile.expert!=lastExpert || tile.column!=lastColumn)) {
if constexpr(CacheL0B) {
if(lastExpert>=0) {
capi_notify<PIPE_V,PIPE_MTE2>(0);
capi_wait<PIPE_V,PIPE_MTE2>(0);
}
} else if(scalePending) {
capi_wait<PIPE_V,PIPE_MTE2>(0);scalePending=false;
}
DataCopyExtParams sp{1,(uint32_t)tile.columns*4,0,0,0};
capi_read_pad(scales,sg+(int64_t)tile.expert*p.n+tile.column,
sp,DataCopyPadExtParams<float>{true,0,0,0.0f});
if constexpr(HalfScratch)scaleNeedsAdjust=true;
lastExpert=tile.expert;lastColumn=tile.column;
}
asc_sync_block_wait(slot);
if constexpr(SplitPublish) {
if(asc_get_sub_block_id()!=0 || localRows<=0)asc_sync_block_wait(4+slot);
}
if(localRows<=0) {
if constexpr (!SingleTile)capi_block_arrive<PIPE_MTE2,2>(2+slot);
continue;
}
int rowStride=BN;
if constexpr(CompactScratch)rowStride=capi_aligned_scratch_stride(tile.columns);
else if constexpr (Mode==1 && BN==512)rowStride=(tile.columns+63)&~63;
else if constexpr (PackTail) {
if(tile.columns<=64 && localRows%2==0 && CHUNK%2==0)rowStride=64;
else if(tile.columns<=128)rowStride=128;
}
if constexpr(!CompactScratch)
rowStride=capi_vector_row_stride(tile.columns,rowStride);
int chunkRows=CHUNK;
if constexpr (WholeVectorHalf)chunkRows=BM/2;
else if constexpr (Mode==1 && BN==512)chunkRows=BM/2<8192/rowStride?BM/2:8192/rowStride;
int firstRows=localRows<chunkRows?localRows:chunkRows;
if(pending[slot]){capi_wait<PIPE_MTE3,PIPE_MTE2>(slot);pending[slot]=false;}
auto tileScratch=scratch+slot*BM*BN;
if constexpr(HalfScratch) {
int pitch=CompactScratch?rowStride:BN;
auto halfStorage=reinterpret_cast<__ubuf__ half*>(storage+slot*StorageStride);
auto halfSource=reinterpret_cast<__gm__ half*>(tileScratch)+slice*pitch;
if(pitch==rowStride)capi_read(halfStorage,halfSource,firstRows*rowStride);
else asc_copy_gm2ub_align(halfStorage,halfSource,firstRows,rowStride*2,
0,0,(pitch-rowStride)*2,0);
} else if constexpr(CompactScratch) {
capi_read(storage+slot*StorageStride,tileScratch+slice*rowStride,
firstRows*rowStride);
} else {
capi_copy_accumulator_rows<BN,PackTail>(storage+slot*StorageStride,
tileScratch+slice*BN,firstRows,rowStride);
}
capi_notify<PIPE_MTE2,PIPE_V>(slot);
if constexpr(SplitPublish) {
if(asc_get_sub_block_id()==0)asc_sync_block_wait(4+slot);
}
if constexpr (!SingleTile)if(firstRows==localRows)
capi_block_arrive<PIPE_MTE2,2>(2+slot);
for(int part=0;part<localRows;part+=chunkRows) {
int stage=(slot+part/chunkRows)&1;
int nr=localRows-part<chunkRows?localRows-part:chunkRows;
int active=nr*rowStride;
capi_wait<PIPE_MTE2,PIPE_V>(stage);
if(part+nr<localRows) {
int next=stage^1;
if(pending[next]){capi_wait<PIPE_MTE3,PIPE_MTE2>(next);pending[next]=false;}
int nextRows=localRows-part-nr<chunkRows?localRows-part-nr:chunkRows;
if constexpr(HalfScratch) {
int pitch=CompactScratch?rowStride:BN;
auto halfStorage=reinterpret_cast<__ubuf__ half*>(storage+next*StorageStride);
auto halfSource=reinterpret_cast<__gm__ half*>(tileScratch)+(slice+part+nr)*pitch;
if(pitch==rowStride)capi_read(halfStorage,halfSource,nextRows*rowStride);
else asc_copy_gm2ub_align(halfStorage,halfSource,nextRows,rowStride*2,
0,0,(pitch-rowStride)*2,0);
} else if constexpr(CompactScratch) {
capi_read(storage+next*StorageStride,
tileScratch+(slice+part+nr)*rowStride,nextRows*rowStride);
} else {
capi_copy_accumulator_rows<BN,PackTail>(storage+next*StorageStride,
tileScratch+(slice+part+nr)*BN,nextRows,rowStride);
}
capi_notify<PIPE_MTE2,PIPE_V>(next);
if constexpr (!SingleTile)if(part+nr+nextRows==localRows)
capi_block_arrive<PIPE_MTE2,2>(2+slot);
}
auto ci=storage+stage*StorageStride;
if constexpr(WholeVectorHalf && !HalfScratch)z=reinterpret_cast<__ubuf__ float*>(ci);
auto out=reinterpret_cast<__ubuf__ half*>(ci);
if constexpr(VectorDequant) {
if constexpr(FloatDequantGelu) {
asc_half2float(z,out,active);asc_sync_pipe(PIPE_V);
capi_finish_gelu_pingpong(z,v,temporary,out,active);
} else capi_finish_dequantized_half_banked(z,v,out,active);
} else {
if constexpr(HalfScratch) {
if(scaleNeedsAdjust) {
asc_mul_scalar(scales,scales,512.0f,BN);asc_sync_pipe(PIPE_V);
scaleNeedsAdjust=false;
}
asc_half2float(z,reinterpret_cast<__ubuf__ half*>(ci),active);
} else asc_int322float_rn(z,ci,active);
asc_sync_pipe(PIPE_V);
asc_set_mask_norm();asc_set_vector_mask(0,~uint64_t(0));
for(int column=0;column<rowStride;column+=64)
asc_mul(z+column,z+column,scales+column,nr,1,1,1,
rowStride/8,rowStride/8,0);
asc_sync_pipe(PIPE_V);
if constexpr(HalfScratch)
capi_finish_gelu_half_banked(z,v,out,active);
else if(p.n==768 && (p.k==512 || p.k==1024) && p.m/p.e<=64)
capi_finish_gelu_half_banked(z,v,out,active);
else if constexpr(WholeVectorHalf)
capi_finish_gelu<!UnclippedGelu>(z,v,out,active);
else if constexpr(BUFFERED_GELU)
capi_finish_gelu_pingpong<!UnclippedGelu>(z,v,temporary,out,active);
else
capi_finish_gelu(z,v,out,active);
}
capi_notify<PIPE_V,PIPE_MTE3>(0);capi_wait<PIPE_V,PIPE_MTE3>(0);
DataCopyExtParams op{(uint16_t)nr,(uint32_t)tile.columns*2,
(uint32_t)((rowStride-((tile.columns+15)&~15))/16),
(uint32_t)(p.n-tile.columns)*2,0};
capi_write_pad(yg+(int64_t)(tile.row+slice+part)*p.n+tile.column,out,op);
capi_notify<PIPE_MTE3,PIPE_MTE2>(stage);pending[stage]=true;
}
if constexpr(!CacheL0B) {
if(scalePending)capi_wait<PIPE_V,PIPE_MTE2>(0);
capi_notify<PIPE_V,PIPE_MTE2>(0);scalePending=true;
}
}
if constexpr(!CacheL0B)
if(scalePending)capi_wait<PIPE_V,PIPE_MTE2>(0);
for(int stage=0;stage<2;++stage)
if(pending[stage])capi_wait<PIPE_MTE3,PIPE_MTE2>(stage);
}
}
}
template<int BM, int BN, int PAD=192, int OWNER_LANES=1>
__global__ __aicore__ __schedmode__(1) void gmm_static_b_panels(
GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groups,
GM_ADDR output, GM_ADDR workspace, GmmPlan p)
{
KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
constexpr int CHUNK=32;
constexpr int SIZE=CHUNK*BN;
int block=GetBlockIdx();
if ASCEND_IS_AIV { block/=2; }
TPipe pipe;
GlobalTensor<int8_t> a,b;
GlobalTensor<int32_t> scratch;
GlobalTensor<int64_t> gg;
a.SetGlobalBuffer((__gm__ int8_t*)x);
b.SetGlobalBuffer((__gm__ int8_t*)weight);
scratch.SetGlobalBuffer((__gm__ int32_t*)workspace+
(int64_t)block*2*BM*BN);
gg.SetGlobalBuffer((__gm__ int64_t*)groups);
int columnTiles=(p.n+BN-1)/BN;
int alignedK=(p.k+31)&~31;
if ASCEND_IS_AIC {
using A=matmul::MatmulType<TPosition::GM,CubeFormat::ND,int8_t>;
using B=matmul::MatmulType<TPosition::TSCM,CubeFormat::NZ,int8_t>;
using C=matmul::MatmulType<TPosition::GM,CubeFormat::ND,int32_t>;
using Bias=matmul::MatmulType<TPosition::GM,CubeFormat::ND,int32_t>;
matmul::Matmul<A,B,C,Bias,CFG_MDL> mm;
TSCM<TPosition::GM> bCache;
pipe.InitBuffer(bCache,1,alignedK*BN);
mm.Init(&p.cube,&pipe);
int produced=0;
int units=p.e*columnTiles*OWNER_LANES;
for(int unit=block;unit<units;unit+=p.cores) {
int lane=unit%OWNER_LANES;
int panel=unit/OWNER_LANES;
int expert=panel/columnTiles;
int columnTile=(panel-expert*columnTiles + expert) % columnTiles;
int begin=expert==0?0:gg.GetValue(expert-1);
int end=gg.GetValue(expert);
int rows=end-begin;
if(rows<=0)continue;
int col=columnTile*BN;
int nc=p.n-col<BN?p.n-col:BN;
auto localB=bCache.template AllocTensor<int8_t>();
Nd2NzParams transform;
transform.ndNum=1;
transform.nValue=p.k;
transform.dValue=nc;
transform.srcNdMatrixStride=0;
transform.srcDValue=p.n;
transform.dstNzC0Stride=alignedK;
transform.dstNzNStride=1;
transform.dstNzMatrixStride=0;
DataCopy(localB,b[(int64_t)expert*p.k*p.n+col],transform);
bCache.EnQue(localB);
bCache.DeQue();
int rowTiles=(rows+BM-1)/BM;
for(int rowTile=lane;rowTile<rowTiles;rowTile+=OWNER_LANES) {
int slot=produced&1;
if(produced>=2)CrossCoreWaitFlag(2+slot);
++produced;
int row=begin+rowTile*BM;
int nr=end-row<BM?end-row:BM;
mm.SetOrgShape(p.m,p.n,p.k,p.k,BN);
mm.SetSingleShape(nr,nc,p.k);
mm.SetTensorA(a[(int64_t)row*p.k]);
mm.SetTensorB(localB);
while(mm.Iterate())
mm.GetTensorC(scratch[slot*BM*BN],0,false);
mm.End();
CrossCoreSetFlag<2,PIPE_FIX>(slot);
}
bCache.FreeTensor(localB);
}
if(produced==1)CrossCoreWaitFlag(2);
else if(produced>=2) {
CrossCoreWaitFlag(2);
CrossCoreWaitFlag(3);
}
} else {
TBuf<TPosition::VECCALC> cb,zb,vb,sb;
pipe.InitBuffer(cb,SIZE*4*2+PAD);
pipe.InitBuffer(zb,SIZE*4+PAD);
pipe.InitBuffer(vb,SIZE*4+PAD);
pipe.InitBuffer(sb,BN*4+PAD);
auto ciStorage=cb.Get<int32_t>();
auto z=zb.Get<float>();
auto v=vb.Get<float>();
auto scales=sb.Get<float>();
TEventID inputReady[2],outputFree[2];
bool outputPending[2]={false,false};
for(int stage=0;stage<2;++stage) {
inputReady[stage]=pipe.AllocEventID<HardEvent::MTE2_V>();
outputFree[stage]=pipe.AllocEventID<HardEvent::MTE3_MTE2>();
}
GlobalTensor<float> scaleGlobal;
GlobalTensor<half> outputGlobal;
scaleGlobal.SetGlobalBuffer((__gm__ float*)scale);
outputGlobal.SetGlobalBuffer((__gm__ half*)output);
int consumed=0;
int units=p.e*columnTiles*OWNER_LANES;
for(int unit=block;unit<units;unit+=p.cores) {
int lane=unit%OWNER_LANES;
int panel=unit/OWNER_LANES;
int expert=panel/columnTiles;
int columnTile=(panel-expert*columnTiles + expert) % columnTiles;
int begin=expert==0?0:gg.GetValue(expert-1);
int end=gg.GetValue(expert);
int rows=end-begin;
if(rows<=0)continue;
int col=columnTile*BN;
int nc=p.n-col<BN?p.n-col:BN;
DataCopyExtParams scaleParams{1,(uint32_t)(nc*4),0,0,0};
DataCopyPadExtParams<float> scalePad{true,0,0,0.0f};
DataCopyPad(scales,
scaleGlobal[(int64_t)expert*p.n+col],
scaleParams,scalePad);
int rowTiles=(rows+BM-1)/BM;
for(int rowTile=lane;rowTile<rowTiles;rowTile+=OWNER_LANES) {
int slot=(consumed++)&1;
int row=begin+rowTile*BM;
int nr=end-row<BM?end-row:BM;
int slice=GetSubBlockIdx()*(BM/2);
int firstRow=row+slice;
int localRows=end-firstRow<BM/2?end-firstRow:BM/2;
CrossCoreWaitFlag(slot);
if(localRows<=0) {
CrossCoreSetFlag<2,PIPE_MTE2>(2+slot);
continue;
}
int firstStage=slot;
if(outputPending[firstStage]) {
WaitFlag<HardEvent::MTE3_MTE2>(outputFree[firstStage]);
outputPending[firstStage]=false;
}
int firstRows=localRows<CHUNK?localRows:CHUNK;
DataCopy(ciStorage[firstStage*SIZE],
scratch[slot*BM*BN+slice*BN],firstRows*BN);
SetFlag<HardEvent::MTE2_V>(inputReady[firstStage]);
if(firstRows==localRows)
CrossCoreSetFlag<2,PIPE_MTE2>(2+slot);
for(int part=0;part<localRows;part+=CHUNK) {
int stage=(firstStage+part/CHUNK)&1;
int currentRow=firstRow+part;
int partRows=localRows-part<CHUNK?localRows-part:CHUNK;
int active=partRows*BN;
WaitFlag<HardEvent::MTE2_V>(inputReady[stage]);
if(part+partRows<localRows) {
int next=stage^1;
if(outputPending[next]) {
WaitFlag<HardEvent::MTE3_MTE2>(outputFree[next]);
outputPending[next]=false;
}
int nextRows=localRows-part-partRows<CHUNK?
localRows-part-partRows:CHUNK;
DataCopy(ciStorage[next*SIZE],
scratch[slot*BM*BN+
(slice+part+partRows)*BN],
nextRows*BN);
SetFlag<HardEvent::MTE2_V>(inputReady[next]);
if(part+partRows+nextRows==localRows)
CrossCoreSetFlag<2,PIPE_MTE2>(2+slot);
}
auto ci=ciStorage[stage*SIZE];
auto out=ci.ReinterpretCast<half>();
Cast(z,ci,RoundMode::CAST_RINT,active);
PipeBarrier<PIPE_V>();
BinaryRepeatParams broadcast{1,1,1,BN/8,BN/8,0};
for(int c=0;c<BN;c+=64)
Mul(z[c],z[c],scales[c],64,partRows,broadcast);
PipeBarrier<PIPE_V>();
finish_gelu(z,v,out,active);
auto done=pipe.FetchEventID(HardEvent::V_MTE3);
SetFlag<HardEvent::V_MTE3>(done);
WaitFlag<HardEvent::V_MTE3>(done);
DataCopyExtParams outputParams{
(uint16_t)partRows,(uint32_t)(nc*2),
(uint32_t)((BN-((nc+15)/16)*16)/16),
(uint32_t)((p.n-nc)*2),0};
DataCopyPad(outputGlobal[(int64_t)currentRow*p.n+col],
out,outputParams);
SetFlag<HardEvent::MTE3_MTE2>(outputFree[stage]);
outputPending[stage]=true;
}
}
auto scaleReuse=pipe.FetchEventID(HardEvent::V_MTE2);
SetFlag<HardEvent::V_MTE2>(scaleReuse);
WaitFlag<HardEvent::V_MTE2>(scaleReuse);
}
for(int stage=0;stage<2;++stage) {
if(outputPending[stage])
WaitFlag<HardEvent::MTE3_MTE2>(outputFree[stage]);
pipe.ReleaseEventID<HardEvent::MTE2_V>(inputReady[stage]);
pipe.ReleaseEventID<HardEvent::MTE3_MTE2>(outputFree[stage]);
}
}
}
template<int BM, int BN, int PAD=192, bool SetupAware=false>
__global__ __aicore__ __schedmode__(1) void gmm_b_resident(
GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groups,
GM_ADDR output, GM_ADDR workspace, GmmPlan p)
{
KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
constexpr int CHUNK=32;
constexpr int SIZE=CHUNK*BN;
int block=GetBlockIdx();
if ASCEND_IS_AIV { block/=2; }
TPipe pipe;
GlobalTensor<int8_t> a,b;
GlobalTensor<int32_t> scratch;
GlobalTensor<int64_t> gg;
a.SetGlobalBuffer((__gm__ int8_t*)x);
b.SetGlobalBuffer((__gm__ int8_t*)weight);
scratch.SetGlobalBuffer((__gm__ int32_t*)workspace+
(int64_t)block*2*BM*BN);
gg.SetGlobalBuffer((__gm__ int64_t*)groups);
int columnTiles=(p.n+BN-1)/BN;
int extent=p.n;
int64_t total=(int64_t)p.m*extent;
if constexpr (SetupAware) {
int activeExperts = 0;
int previousEnd = 0;
for (int expert = 0; expert < p.e; ++expert) {
int end = gg.GetValue(expert);
if (end > previousEnd) ++activeExperts;
previousEnd = end;
}
total = ((int64_t)p.m + (int64_t)activeExperts * (BM * 2)) * extent;
}
int64_t low=(total*block+p.cores-1)/p.cores;
int64_t high=(total*(block+1)+p.cores-1)/p.cores;
int firstExpert=0;
if constexpr (!SetupAware) {
int limit=p.e;
while(firstExpert<limit) {
int mid=firstExpert+(limit-firstExpert)/2;
if((int64_t)gg.GetValue(mid)*extent<=low)firstExpert=mid+1;
else limit=mid;
}
}
if ASCEND_IS_AIC {
using A=matmul::MatmulType<TPosition::GM,CubeFormat::ND,int8_t>;
using B=matmul::MatmulType<TPosition::TSCM,CubeFormat::NZ,int8_t>;
using C=matmul::MatmulType<TPosition::GM,CubeFormat::ND,int32_t>;
using Bias=matmul::MatmulType<TPosition::GM,CubeFormat::ND,int32_t>;
matmul::Matmul<A,B,C,Bias,CFG_MDL> mm;
TSCM<TPosition::GM> bCache;
pipe.InitBuffer(bCache,1,((p.k+31)&~31)*BN);
mm.Init(&p.cube,&pipe);
int produced=0;
int units=p.e*columnTiles;
int64_t groupWorkBase = 0;
for(int unit=firstExpert*columnTiles;unit<units;++unit) {
int expert=unit/columnTiles;
int columnTile=unit-expert*columnTiles;
int begin=expert==0?0:gg.GetValue(expert-1);
int end=gg.GetValue(expert);
int rows=end-begin;
if(rows<=0)continue;
int col=columnTile*BN;
int nc=p.n-col<BN?p.n-col:BN;
int rowTiles=(rows+BM-1)/BM;
int start, stop;
if constexpr (SetupAware) {
int64_t currentBase = groupWorkBase;
int64_t weightedRows = (int64_t)rows + (BM * 2);
if (columnTile + 1 == columnTiles)
groupWorkBase += weightedRows * extent;
if(currentBase>=high)break;
int64_t panelStart=currentBase+weightedRows*col;
int64_t panelCost=weightedRows*nc;
start=low<=panelStart?0:
(int)(((low-panelStart)*rowTiles+panelCost-1)/panelCost);
stop=high<=panelStart?0:
(int)(((high-panelStart)*rowTiles+panelCost-1)/panelCost);
} else {
if((int64_t)begin*extent>=high)break;
int64_t panelStart=(int64_t)begin*extent+(int64_t)rows*col;
int stride=BM*nc;
start=low<=panelStart?0:(int)((low-panelStart+stride-1)/stride);
stop=high<=panelStart?0:(int)((high-panelStart+stride-1)/stride);
}
if(stop>rowTiles)stop=rowTiles;
if(start>=stop)continue;
int alignedK=(p.k+31)&~31;
auto localB=bCache.template AllocTensor<int8_t>();
Nd2NzParams transform;
transform.ndNum=1;
transform.nValue=p.k;
transform.dValue=nc;
transform.srcNdMatrixStride=0;
transform.srcDValue=p.n;
transform.dstNzC0Stride=alignedK;
transform.dstNzNStride=1;
transform.dstNzMatrixStride=0;
DataCopy(localB,b[(int64_t)expert*p.k*p.n+col],transform);
bCache.EnQue(localB);
bCache.DeQue();
for(int rowTile=start;rowTile<stop;++rowTile) {
int slot=produced&1;
if(produced>=2)CrossCoreWaitFlag(2+slot);
++produced;
int row=begin+rowTile*BM;
int nr=end-row<BM?end-row:BM;
mm.SetOrgShape(p.m,p.n,p.k,p.k,BN);
mm.SetSingleShape(nr,nc,p.k);
mm.SetTensorA(a[(int64_t)row*p.k]);
mm.SetTensorB(localB);
while(mm.Iterate())
mm.GetTensorC(scratch[slot*BM*BN],0,false);
mm.End();
CrossCoreSetFlag<2,PIPE_FIX>(slot);
}
bCache.FreeTensor(localB);
}
if(produced==1)CrossCoreWaitFlag(2);
else if(produced>=2) {
CrossCoreWaitFlag(2);
CrossCoreWaitFlag(3);
}
} else {
TBuf<TPosition::VECCALC> cb,zb,vb,sb;
pipe.InitBuffer(cb,SIZE*4*2+PAD);
pipe.InitBuffer(zb,SIZE*4+PAD);
pipe.InitBuffer(vb,SIZE*4+PAD);
pipe.InitBuffer(sb,BN*4+PAD);
auto ciStorage=cb.Get<int32_t>();
auto z=zb.Get<float>();
auto v=vb.Get<float>();
auto scales=sb.Get<float>();
TEventID inputReady[2],outputFree[2];
bool outputPending[2]={false,false};
for(int stage=0;stage<2;++stage) {
inputReady[stage]=pipe.AllocEventID<HardEvent::MTE2_V>();
outputFree[stage]=pipe.AllocEventID<HardEvent::MTE3_MTE2>();
}
GlobalTensor<float> scaleGlobal;
GlobalTensor<half> outputGlobal;
scaleGlobal.SetGlobalBuffer((__gm__ float*)scale);
outputGlobal.SetGlobalBuffer((__gm__ half*)output);
int consumed=0;
int units=p.e*columnTiles;
int64_t groupWorkBase = 0;
for(int unit=firstExpert*columnTiles;unit<units;++unit) {
int expert=unit/columnTiles;
int columnTile=unit-expert*columnTiles;
int begin=expert==0?0:gg.GetValue(expert-1);
int end=gg.GetValue(expert);
int rows=end-begin;
if(rows<=0)continue;
int col=columnTile*BN;
int nc=p.n-col<BN?p.n-col:BN;
int rowTiles=(rows+BM-1)/BM;
int start, stop;
if constexpr (SetupAware) {
int64_t currentBase = groupWorkBase;
int64_t weightedRows = (int64_t)rows + (BM * 2);
if (columnTile + 1 == columnTiles)
groupWorkBase += weightedRows * extent;
if(currentBase>=high)break;
int64_t panelStart=currentBase+weightedRows*col;
int64_t panelCost=weightedRows*nc;
start=low<=panelStart?0:
(int)(((low-panelStart)*rowTiles+panelCost-1)/panelCost);
stop=high<=panelStart?0:
(int)(((high-panelStart)*rowTiles+panelCost-1)/panelCost);
} else {
if((int64_t)begin*extent>=high)break;
int64_t panelStart=(int64_t)begin*extent+(int64_t)rows*col;
int stride=BM*nc;
start=low<=panelStart?0:(int)((low-panelStart+stride-1)/stride);
stop=high<=panelStart?0:(int)((high-panelStart+stride-1)/stride);
}
if(stop>rowTiles)stop=rowTiles;
if(start>=stop)continue;
DataCopyExtParams scaleParams{1,(uint32_t)(nc*4),0,0,0};
DataCopyPadExtParams<float> scalePad{true,0,0,0.0f};
DataCopyPad(scales,
scaleGlobal[(int64_t)expert*p.n+col],
scaleParams,scalePad);
for(int rowTile=start;rowTile<stop;++rowTile) {
int slot=(consumed++)&1;
int row=begin+rowTile*BM;
int nr=end-row<BM?end-row:BM;
int slice=GetSubBlockIdx()*(BM/2);
int firstRow=row+slice;
int localRows=end-firstRow<BM/2?end-firstRow:BM/2;
CrossCoreWaitFlag(slot);
if(localRows<=0) {
CrossCoreSetFlag<2,PIPE_MTE2>(2+slot);
continue;
}
int firstStage=slot;
if(outputPending[firstStage]) {
WaitFlag<HardEvent::MTE3_MTE2>(outputFree[firstStage]);
outputPending[firstStage]=false;
}
int firstRows=localRows<CHUNK?localRows:CHUNK;
DataCopy(ciStorage[firstStage*SIZE],
scratch[slot*BM*BN+slice*BN],firstRows*BN);
SetFlag<HardEvent::MTE2_V>(inputReady[firstStage]);
if(firstRows==localRows)
CrossCoreSetFlag<2,PIPE_MTE2>(2+slot);
for(int part=0;part<localRows;part+=CHUNK) {
int stage=(firstStage+part/CHUNK)&1;
int currentRow=firstRow+part;
int partRows=localRows-part<CHUNK?localRows-part:CHUNK;
int active=partRows*BN;
WaitFlag<HardEvent::MTE2_V>(inputReady[stage]);
if(part+partRows<localRows) {
int next=stage^1;
if(outputPending[next]) {
WaitFlag<HardEvent::MTE3_MTE2>(outputFree[next]);
outputPending[next]=false;
}
int nextRows=localRows-part-partRows<CHUNK?
localRows-part-partRows:CHUNK;
DataCopy(ciStorage[next*SIZE],
scratch[slot*BM*BN+
(slice+part+partRows)*BN],
nextRows*BN);
SetFlag<HardEvent::MTE2_V>(inputReady[next]);
if(part+partRows+nextRows==localRows)
CrossCoreSetFlag<2,PIPE_MTE2>(2+slot);
}
auto ci=ciStorage[stage*SIZE];
auto out=ci.ReinterpretCast<half>();
Cast(z,ci,RoundMode::CAST_RINT,active);
PipeBarrier<PIPE_V>();
BinaryRepeatParams broadcast{1,1,1,BN/8,BN/8,0};
for(int c=0;c<BN;c+=64)
Mul(z[c],z[c],scales[c],64,partRows,broadcast);
PipeBarrier<PIPE_V>();
finish_gelu(z,v,out,active);
auto done=pipe.FetchEventID(HardEvent::V_MTE3);
SetFlag<HardEvent::V_MTE3>(done);
WaitFlag<HardEvent::V_MTE3>(done);
DataCopyExtParams outputParams{
(uint16_t)partRows,(uint32_t)(nc*2),
(uint32_t)((BN-((nc+15)/16)*16)/16),
(uint32_t)((p.n-nc)*2),0};
DataCopyPad(outputGlobal[(int64_t)currentRow*p.n+col],
out,outputParams);
SetFlag<HardEvent::MTE3_MTE2>(outputFree[stage]);
outputPending[stage]=true;
}
}
auto scaleReuse=pipe.FetchEventID(HardEvent::V_MTE2);
SetFlag<HardEvent::V_MTE2>(scaleReuse);
WaitFlag<HardEvent::V_MTE2>(scaleReuse);
}
for(int stage=0;stage<2;++stage) {
if(outputPending[stage])
WaitFlag<HardEvent::MTE3_MTE2>(outputFree[stage]);
pipe.ReleaseEventID<HardEvent::MTE2_V>(inputReady[stage]);
pipe.ReleaseEventID<HardEvent::MTE3_MTE2>(outputFree[stage]);
}
}
}
template<int BM, int BN, int PAD=192>
__global__ __aicore__ __schedmode__(1) void gmm_a_resident(
GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groups,
GM_ADDR output, GM_ADDR workspace, GmmPlan p)
{
KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
constexpr int CHUNK=32;
constexpr int SIZE=CHUNK*BN;
int block=GetBlockIdx();
if ASCEND_IS_AIV { block/=2; }
TPipe pipe;
GlobalTensor<int8_t> a,b;
GlobalTensor<int32_t> scratch;
GlobalTensor<int64_t> gg;
a.SetGlobalBuffer((__gm__ int8_t*)x);
b.SetGlobalBuffer((__gm__ int8_t*)weight);
scratch.SetGlobalBuffer((__gm__ int32_t*)workspace+
(int64_t)block*2*BM*BN);
gg.SetGlobalBuffer((__gm__ int64_t*)groups);
int columnTiles=(p.n+BN-1)/BN;
if ASCEND_IS_AIC {
using A=matmul::MatmulType<TPosition::TSCM,CubeFormat::NZ,int8_t>;
using B=matmul::MatmulType<TPosition::GM,CubeFormat::ND,int8_t>;
using C=matmul::MatmulType<TPosition::GM,CubeFormat::ND,int32_t>;
using Bias=matmul::MatmulType<TPosition::GM,CubeFormat::ND,int32_t>;
matmul::Matmul<A,B,C,Bias,CFG_MDL> mm;
TSCM<TPosition::GM> aCache;
pipe.InitBuffer(aCache,1,((p.k+31)&~31)*BM);
mm.Init(&p.cube,&pipe);
int produced=0;
int firstRowTile=block;
int begin=0;
for(int expert=0;expert<p.e;++expert) {
int end=gg.GetValue(expert);
int rowTiles=(end-begin+BM-1)/BM;
for(int rowTile=firstRowTile;rowTile<rowTiles;rowTile+=p.cores) {
int row=begin+rowTile*BM;
int nr=end-row<BM?end-row:BM;
auto localA=aCache.template AllocTensor<int8_t>();
direct_nd_to_nz(localA,a[(int64_t)row*p.k],nr,p.k,p.k,(nr+15)&~15);
aCache.EnQue(localA);aCache.DeQue();
for(int columnTile=0;columnTile<columnTiles;++columnTile) {
int col=columnTile*BN;
int nc=p.n-col<BN?p.n-col:BN;
int slot=produced&1;
if(produced>=2)CrossCoreWaitFlag(2+slot);
++produced;
mm.SetOrgShape(p.m,p.n,p.k,p.k,BN);
mm.SetSingleShape(nr,nc,p.k);
mm.SetTensorA(localA);
mm.SetTensorB(b[(int64_t)expert*p.k*p.n+col]);
while(mm.Iterate())
mm.GetTensorC(scratch[slot*BM*BN],0,false);
mm.End();
CrossCoreSetFlag<2,PIPE_FIX>(slot);
}
aCache.FreeTensor(localA);
}
firstRowTile-=rowTiles%p.cores;
if(firstRowTile<0)firstRowTile+=p.cores;
begin=end;
}
if(produced==1)CrossCoreWaitFlag(2);
else if(produced>=2) {
CrossCoreWaitFlag(2);
CrossCoreWaitFlag(3);
}
} else {
TBuf<TPosition::VECCALC> cb,zb,vb,sb;
pipe.InitBuffer(cb,SIZE*4+PAD);
pipe.InitBuffer(zb,SIZE*4+PAD);
pipe.InitBuffer(vb,SIZE*4+PAD);
pipe.InitBuffer(sb,BN*4+PAD);
auto ci=cb.Get<int32_t>();
auto z=zb.Get<float>();
auto v=vb.Get<float>();
auto scales=sb.Get<float>();
auto out=ci.ReinterpretCast<half>();
GlobalTensor<float> scaleGlobal;
GlobalTensor<half> outputGlobal;
scaleGlobal.SetGlobalBuffer((__gm__ float*)scale);
outputGlobal.SetGlobalBuffer((__gm__ half*)output);
int consumed=0;
int firstRowTile=block;
int begin=0;
for(int expert=0;expert<p.e;++expert) {
int end=gg.GetValue(expert);
int rowTiles=(end-begin+BM-1)/BM;
for(int rowTile=firstRowTile;rowTile<rowTiles;rowTile+=p.cores) {
int row=begin+rowTile*BM;
int nr=end-row<BM?end-row:BM;
for(int columnTile=0;columnTile<columnTiles;++columnTile) {
int col=columnTile*BN;
int nc=p.n-col<BN?p.n-col:BN;
DataCopyExtParams scaleParams{1,(uint32_t)(nc*4),0,0,0};
DataCopyPadExtParams<float> scalePad{true,0,0,0.0f};
DataCopyPad(scales,
scaleGlobal[(int64_t)expert*p.n+col],
scaleParams,scalePad);
int slot=(consumed++)&1;
int slice=GetSubBlockIdx()*(BM/2);
int firstRow=row+slice;
int localRows=end-firstRow<BM/2?end-firstRow:BM/2;
CrossCoreWaitFlag(slot);
if(localRows<=0) {
CrossCoreSetFlag<2,PIPE_MTE2>(2+slot);
continue;
}
for(int part=0;part<localRows;part+=CHUNK) {
int currentRow=firstRow+part;
int partRows=localRows-part<CHUNK?localRows-part:CHUNK;
int active=partRows*BN;
DataCopy(ci,
scratch[slot*BM*BN+(slice+part)*BN],active);
auto ready=pipe.FetchEventID(HardEvent::MTE2_V);
SetFlag<HardEvent::MTE2_V>(ready);
WaitFlag<HardEvent::MTE2_V>(ready);
if(part+partRows==localRows)
CrossCoreSetFlag<2,PIPE_MTE2>(2+slot);
Cast(z,ci,RoundMode::CAST_RINT,active);
PipeBarrier<PIPE_V>();
BinaryRepeatParams broadcast{1,1,1,BN/8,BN/8,0};
for(int c=0;c<BN;c+=64)
Mul(z[c],z[c],scales[c],64,partRows,broadcast);
PipeBarrier<PIPE_V>();
finish_gelu(z,v,out,active);
auto done=pipe.FetchEventID(HardEvent::V_MTE3);
SetFlag<HardEvent::V_MTE3>(done);
WaitFlag<HardEvent::V_MTE3>(done);
DataCopyExtParams outputParams{
(uint16_t)partRows,(uint32_t)(nc*2),
(uint32_t)((BN-((nc+15)/16)*16)/16),
(uint32_t)((p.n-nc)*2),0};
DataCopyPad(outputGlobal[(int64_t)currentRow*p.n+col],
out,outputParams);
auto reuse=pipe.FetchEventID(HardEvent::MTE3_V);
SetFlag<HardEvent::MTE3_V>(reuse);
WaitFlag<HardEvent::MTE3_V>(reuse);
auto overwrite=pipe.FetchEventID(HardEvent::V_MTE2);
SetFlag<HardEvent::V_MTE2>(overwrite);
WaitFlag<HardEvent::V_MTE2>(overwrite);
}
auto scaleReuse=pipe.FetchEventID(HardEvent::V_MTE2);
SetFlag<HardEvent::V_MTE2>(scaleReuse);
WaitFlag<HardEvent::V_MTE2>(scaleReuse);
}
}
firstRowTile-=rowTiles%p.cores;
if(firstRowTile<0)firstRowTile+=p.cores;
begin=end;
}
}
}
template<int BM, int BN>
__global__ __aicore__ __schedmode__(1) void gmm_short_one_panel(
GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groups,
GM_ADDR output, GM_ADDR workspace, GmmPlan p)
{
KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
int block=GetBlockIdx();
if ASCEND_IS_AIV { block/=2; }
GlobalTensor<int8_t> a,b;
GlobalTensor<int32_t> scratch;
GlobalTensor<int64_t> gg;
a.SetGlobalBuffer((__gm__ int8_t*)x);
b.SetGlobalBuffer((__gm__ int8_t*)weight);
scratch.SetGlobalBuffer((__gm__ int32_t*)workspace+(int64_t)block*BM*BN);
gg.SetGlobalBuffer((__gm__ int64_t*)groups);
int selectedExpert=-1,selectedRow=0,selectedColumn=0;
int selectedRows=0,selectedColumns=0;
int begin=0,firstTile=0,nt=(p.n+BN-1)/BN;
for(int expert=0;expert<p.e;++expert) {
int end=gg.GetValue(expert);
int rowTiles=(end-begin+BM-1)/BM;
int tiles=rowTiles*nt;
if(block>=firstTile && block<firstTile+tiles) {
int local=block-firstTile;
selectedExpert=expert;
selectedRow=begin+(local/nt)*BM;
selectedColumn=(local%nt)*BN;
selectedRows=end-selectedRow<BM?end-selectedRow:BM;
selectedColumns=p.n-selectedColumn<BN?p.n-selectedColumn:BN;
break;
}
firstTile+=tiles;
begin=end;
}
if(selectedExpert<0)return;
TPipe pipe;
if ASCEND_IS_AIC {
constexpr int MAX_K=512;
TQue<TPosition::A1,1> a1Queue;
TQue<TPosition::A2,1> a2Queue;
TQue<TPosition::B1,1> b1Queue;
TQue<TPosition::B2,1> b2Queue;
TQue<TPosition::CO1,1> cQueue;
pipe.InitBuffer(a1Queue,1,BM*MAX_K);
pipe.InitBuffer(a2Queue,1,BM*MAX_K);
pipe.InitBuffer(b1Queue,1,MAX_K*BN);
pipe.InitBuffer(b2Queue,1,MAX_K*BN);
pipe.InitBuffer(cQueue,1,BM*BN*4);
int alignedRows=(selectedRows+15)/16*16;
auto a1=a1Queue.AllocTensor<int8_t>();
direct_nd_to_nz(a1,a[(int64_t)selectedRow*p.k],selectedRows,p.k,
p.k,alignedRows);
a1Queue.EnQue(a1);a1=a1Queue.DeQue<int8_t>();
auto b1=b1Queue.AllocTensor<int8_t>();
direct_nd_to_nz(b1,b[(int64_t)selectedExpert*p.k*p.n+selectedColumn],
p.k,selectedColumns,p.n,p.k);
b1Queue.EnQue(b1);b1=b1Queue.DeQue<int8_t>();
auto a2=a2Queue.AllocTensor<int8_t>();
auto b2=b2Queue.AllocTensor<int8_t>();
direct_l1_to_l0a(a2,a1,selectedRows,p.k,alignedRows,p.k,0);
direct_l1_to_l0b(b2,b1,p.k,selectedColumns,p.k);
a2Queue.EnQue(a2);b2Queue.EnQue(b2);
a2=a2Queue.DeQue<int8_t>();b2=b2Queue.DeQue<int8_t>();
auto c=cQueue.AllocTensor<int32_t>();
MmadParams mm;
mm.m=selectedRows==1?16:selectedRows;
mm.n=selectedColumns;mm.k=p.k;
mm.cmatrixInitVal=true;mm.unitFlag=3;
Mmad(c,a2,b2,mm);
a2Queue.FreeTensor(a2);b2Queue.FreeTensor(b2);
a1Queue.FreeTensor(a1);b1Queue.FreeTensor(b1);
cQueue.EnQue(c);c=cQueue.DeQue<int32_t>();
FixpipeParamsV220 fp;
fp.nSize=selectedColumns;fp.mSize=selectedRows;
fp.srcStride=alignedRows;fp.dstStride=BN;
fp.ndNum=1;fp.srcNdStride=0;fp.dstNdStride=0;fp.unitFlag=3;
Fixpipe(scratch,c,fp);
cQueue.FreeTensor(c);
CrossCoreSetFlag<2,PIPE_FIX>(0);
} else {
constexpr int HALF_ROWS=BM/2;
constexpr int SIZE=HALF_ROWS*BN;
int slice=GetSubBlockIdx()*HALF_ROWS;
int localRows=selectedRows-slice<HALF_ROWS?
selectedRows-slice:HALF_ROWS;
CrossCoreWaitFlag(0);
if(localRows<=0)return;
TBuf<TPosition::VECCALC> cb,zb,vb,sb,hb;
pipe.InitBuffer(cb,SIZE*4);pipe.InitBuffer(zb,SIZE*4);
pipe.InitBuffer(vb,SIZE*4);pipe.InitBuffer(sb,BN*4);
pipe.InitBuffer(hb,SIZE*2);
auto ci=cb.Get<int32_t>();auto z=zb.Get<float>();
auto v=vb.Get<float>();auto scales=sb.Get<float>();
auto out=hb.Get<half>();
GlobalTensor<float> sg;GlobalTensor<half> yg;
sg.SetGlobalBuffer((__gm__ float*)scale);
yg.SetGlobalBuffer((__gm__ half*)output);
DataCopyExtParams scaleCopy{1,(uint32_t)(selectedColumns*4),0,0,0};
DataCopyPadExtParams<float> scalePad{true,0,0,0.0f};
DataCopyPad(scales,
sg[(int64_t)selectedExpert*p.n+selectedColumn],scaleCopy,scalePad);
DataCopy(ci,scratch[slice*BN],localRows*BN);
SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
int active=localRows*BN;
Cast(z,ci,RoundMode::CAST_RINT,active);PipeBarrier<PIPE_V>();
BinaryRepeatParams broadcast{1,1,1,BN/8,BN/8,0};
for(int column=0;column<BN;column+=64)
Mul(z[column],z[column],scales[column],64,localRows,broadcast);
PipeBarrier<PIPE_V>();
finish_gelu(z,v,out,active);
SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
DataCopyExtParams outputCopy{
(uint16_t)localRows,(uint32_t)(selectedColumns*2),
(uint32_t)((BN-((selectedColumns+15)/16)*16)/16),
(uint32_t)((p.n-selectedColumns)*2),0};
DataCopyPad(yg[(int64_t)(selectedRow+slice)*p.n+selectedColumn],
out,outputCopy);
PipeBarrier<PIPE_ALL>();
}
}
__global__ __aicore__ void gmm_scalar_output(
GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groups, GM_ADDR output, int experts)
{
KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
InitSocState();
constexpr int MaxPrefetchExperts=128;
constexpr int WeightOffset=32;
constexpr int ScaleOffset=WeightOffset+MaxPrefetchExperts;
constexpr int GroupOffset=ScaleOffset+MaxPrefetchExperts*sizeof(float);
constexpr int OutputOffset=GroupOffset+MaxPrefetchExperts*sizeof(int64_t);
int dot;
float factor;
if(experts>2 && experts<=MaxPrefetchExperts) {
auto inputs=reinterpret_cast<__ubuf__ int8_t*>(uint64_t(0));
auto weights=reinterpret_cast<__ubuf__ int8_t*>(uint64_t(WeightOffset));
auto scales=reinterpret_cast<__ubuf__ float*>(uint64_t(ScaleOffset));
auto ends=reinterpret_cast<__ubuf__ int64_t*>(uint64_t(GroupOffset));
asc_copy_gm2ub_align(inputs,reinterpret_cast<__gm__ int8_t*>(x),1,1,0,0,0,0);
asc_copy_gm2ub_align(weights,reinterpret_cast<__gm__ int8_t*>(weight),1,experts,0,0,0,0);
asc_copy_gm2ub_align(scales,reinterpret_cast<__gm__ float*>(scale),1,experts*sizeof(float),0,0,0,0);
asc_copy_gm2ub_align(reinterpret_cast<__ubuf__ uint8_t*>(ends),
reinterpret_cast<__gm__ uint8_t*>(groups),1,experts*sizeof(int64_t),0,0,0,0);
capi_notify<PIPE_MTE2,PIPE_S>(0);capi_wait<PIPE_MTE2,PIPE_S>(0);
int first=0,last=experts-1;
while(first<last) {
int middle=first+(last-first)/2;
if(ends[middle]==0)first=middle+1;
else last=middle;
}
dot=int(inputs[0])*int(weights[first]);
factor=scales[first];
} else {
auto ends=reinterpret_cast<__gm__ int64_t*>(groups);
int first=0,last=experts-1;
while(first<last) {
int middle=first+(last-first)/2;
if(ends[middle]==0)first=middle+1;
else last=middle;
}
dot=int(reinterpret_cast<__gm__ int8_t*>(x)[0])*
int(reinterpret_cast<__gm__ int8_t*>(weight)[first]);
factor=reinterpret_cast<__gm__ float*>(scale)[first];
}
const float z=float(dot)*factor;
const float u = (0.79788456f * z) * (1.0f + 0.044715f * (z * z));
const float arg = u < 0 ? 2.0f * u : -2.0f * u;
const float r = (arg < -32.0f ? -32.0f : arg) * 0.0078125f;
float t = ((((1.0f / 24 * r + 1.0f / 6) * r + 0.5f) * r + 1.0f) * r + 1.0f);
for (int i = 0; i < 7; ++i) t *= t;
auto out=reinterpret_cast<__ubuf__ half*>(uint64_t(OutputOffset));
out[0]=(half)(z * ((u >= 0 ? 1.0f : t) / (1.0f + t)));
capi_notify<PIPE_S,PIPE_MTE3>(0);capi_wait<PIPE_S,PIPE_MTE3>(0);
asc_copy_ub2gm_align(reinterpret_cast<__gm__ half*>(output),out,1,2,0,0,0,0);
capi_notify<PIPE_MTE3,PIPE_S>(0);capi_wait<PIPE_MTE3,PIPE_S>(0);
}
__global__ __aicore__ void gmm_wide_short_k(
GM_ADDR x,GM_ADDR weight,GM_ADDR scale,GM_ADDR groups,GM_ADDR output,
int m,int k,int n,int experts,int rowLanes,int slab) {
KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
InitSocState();
if ASCEND_IS_AIV {
constexpr int MaxColumns=1024,Elements=8192;
constexpr int Raw=256,Half=Raw+4*MaxColumns+256;
constexpr int Weight=Half+8*MaxColumns+256,Scale=Weight+16*MaxColumns+256;
constexpr int Value=Scale+4*MaxColumns+256,Temporary=Value+4*Elements+256;
constexpr int Output=Temporary+4*Elements+256;
constexpr int Alternate=Output+2*Elements+256,ExpandedScale=Alternate+4*Elements+256;
static_assert(ExpandedScale+4*Elements<=192*1024);
auto a=reinterpret_cast<__ubuf__ int8_t*>(uint64_t(0));
auto raw=reinterpret_cast<__ubuf__ int8_t*>(uint64_t(Raw));
auto halfWeight=reinterpret_cast<__ubuf__ half*>(uint64_t(Half));
auto b=reinterpret_cast<__ubuf__ float*>(uint64_t(Weight));
auto factors=reinterpret_cast<__ubuf__ float*>(uint64_t(Scale));
auto z=reinterpret_cast<__ubuf__ float*>(uint64_t(Value));
auto temporary=reinterpret_cast<__ubuf__ float*>(uint64_t(Temporary));
auto out=reinterpret_cast<__ubuf__ half*>(uint64_t(Output));
auto alternate=reinterpret_cast<__ubuf__ float*>(uint64_t(Alternate));
auto expandedScale=reinterpret_cast<__ubuf__ float*>(uint64_t(ExpandedScale));
const int block=asc_get_block_idx(),lane=block/rowLanes;
const int column=lane*slab,cols=n-column<slab?n-column:slab;
const int pitch=(cols+31)&~31,rowsPerTile=Elements/pitch;
const int rowLane=block-lane*rowLanes;
int row=m*rowLane/rowLanes,stop=m*(rowLane+1)/rowLanes;
auto ends=reinterpret_cast<__gm__ int64_t*>(groups);
int expert=0;
while(ends[expert]<=row)++expert;
int loaded=-1;
bool outputPending=false;
auto input=reinterpret_cast<__gm__ int8_t*>(x);
auto weights=reinterpret_cast<__gm__ int8_t*>(weight);
auto scales=reinterpret_cast<__gm__ float*>(scale);
auto destination=reinterpret_cast<__gm__ half*>(output);
while(row<stop) {
int end=ends[expert];
while(end<=row)end=ends[++expert];
if(end>stop)end=stop;
int rows=end-row<rowsPerTile?end-row:rowsPerTile;
asc_copy_gm2ub_align(a,input+int64_t(row)*k,1,rows*k,0,0,0,0);
capi_notify<PIPE_MTE2,PIPE_S>(0);capi_wait<PIPE_MTE2,PIPE_S>(0);
if(expert!=loaded) {
if(loaded>=0){capi_notify<PIPE_V,PIPE_MTE2>(1);capi_wait<PIPE_V,PIPE_MTE2>(1);}
asc_copy_gm2ub_align(raw,weights+int64_t(expert)*k*n+column,k,cols,0,0,n-cols,0);
asc_copy_gm2ub_align(factors,scales+int64_t(expert)*n+column,1,cols*4,0,0,0,0);
capi_notify<PIPE_MTE2,PIPE_V>(0);capi_wait<PIPE_MTE2,PIPE_V>(0);
asc_int82half(halfWeight,raw,k*pitch);asc_sync_pipe(PIPE_V);
asc_half2float(b,halfWeight,k*pitch);asc_sync_pipe(PIPE_V);
set_mask_count();set_vector_mask(0,pitch);
for(int r=0;r<rowsPerTile;++r)
vadds(expandedScale+r*pitch,factors,0.0f,1,1,1,8,8);
pipe_barrier(PIPE_V);
set_mask_norm();
loaded=expert;
}
set_mask_count();set_vector_mask(0,pitch);
for(int r=0;r<rows;++r) {
auto values=z+r*pitch;
vmuls(values,b,float(a[r*k]),1,1,1,8,8);
for(int reduction=1;reduction<k;++reduction) {
pipe_barrier(PIPE_V);
vaxpy(values,b+reduction*pitch,float(a[r*k+reduction]),1,1,1,8,8);
}
}
pipe_barrier(PIPE_V);
set_vector_mask(0,rows*pitch);
vmul(z,z,expandedScale,1,1,1,1,8,8,8);
pipe_barrier(PIPE_V);
set_mask_norm();
if(outputPending)capi_wait<PIPE_MTE3,PIPE_V>(0);
capi_finish_gelu_pingpong(z,temporary,alternate,out,rows*pitch);
capi_notify<PIPE_V,PIPE_MTE3>(0);capi_wait<PIPE_V,PIPE_MTE3>(0);
asc_copy_ub2gm_align(destination+int64_t(row)*n+column,out,rows,cols*2,
0,0,(pitch-((cols+15)&~15))/16,(n-cols)*2);
capi_notify<PIPE_MTE3,PIPE_V>(0);
outputPending=true;
row+=rows;
}
if(outputPending)capi_wait<PIPE_MTE3,PIPE_V>(0);
}
}
__global__ __aicore__ void gmm_tiny_parallel(
GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groups,
GM_ADDR output, int m, int k, int n, int e)
{
KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
InitSocState();
__ubuf__ half* out = reinterpret_cast<__ubuf__ half*>(256);
__gm__ int8_t* a = reinterpret_cast<__gm__ int8_t*>(x);
__gm__ int8_t* b = reinterpret_cast<__gm__ int8_t*>(weight);
__gm__ float* scales = reinterpret_cast<__gm__ float*>(scale);
__gm__ int64_t* bounds = reinterpret_cast<__gm__ int64_t*>(groups);
__gm__ half* result = reinterpret_cast<__gm__ half*>(output);
const int count = m * n;
constexpr int maxBlocks = 8;
const int span = (count + maxBlocks - 1) / maxBlocks;
const int first = static_cast<int>(asc_get_block_idx()) * span;
if (first >= count) return;
const int last = first + span < count ? first + span : count;
int row = first / n;
int col = first - row * n;
int expert = 0;
int expertEnd = static_cast<int>(bounds[0]);
while (expert + 1 < e && row >= expertEnd)
expertEnd = static_cast<int>(bounds[++expert]);
for (int index = first; index < last; ++index) {
int32_t sum = 0;
for (int inner = 0; inner < k; ++inner)
sum += static_cast<int32_t>(a[row * k + inner]) *
static_cast<int32_t>(b[(expert * k + inner) * n + col]);
const float value = gmul(static_cast<float>(sum), scales[expert * n + col]);
out[index - first] = static_cast<half>(scalar_tiny_gelu(value));
if (++col == n) {
col = 0;
++row;
while (expert + 1 < e && row >= expertEnd)
expertEnd = static_cast<int>(bounds[++expert]);
}
}
asc_sync_notify(PIPE_S, PIPE_MTE3, EVENT_ID0);
asc_sync_wait(PIPE_S, PIPE_MTE3, EVENT_ID0);
const uint32_t bytes = static_cast<uint32_t>(last - first) * sizeof(half);
asc_copy_ub2gm_align(result + first, out, 1, bytes, 0, 0, 0, 0);
asc_sync_notify(PIPE_MTE3, PIPE_S, EVENT_ID0);
asc_sync_wait(PIPE_MTE3, PIPE_S, EVENT_ID0);
}
namespace NzPacked {
template<bool ConfigureMatrix=true>
__aicore__ inline void capi_l1_to_l0a(__ca__ int8_t* dst, __cbuf__ int8_t* src,
uint32_t rows, uint32_t columns, uint32_t alignedRows,
uint32_t sourceColumns = 0, uint32_t columnOffset = 0) {
if (sourceColumns == 0) sourceColumns = columns;
if constexpr (ConfigureMatrix) {
asc_l13d_fmatrix_config matrix{};
matrix.config = (uint64_t(1) << 16) | alignedRows;
asc_set_l13d_fmatrix(matrix);
}
asc_copy_l12l0a(dst, src, columns, alignedRows, columnOffset, 0,
1, 1, 1, 1, 1, 1, false, false, false, false, sourceColumns);
}
__aicore__ inline void capi_l1_to_l0b(__cb__ int8_t* dst, __cbuf__ int8_t* src,
uint32_t rows, uint32_t columns, uint32_t alignedRows) {
uint32_t reductionBlocks = (rows + 31) / 32;
uint32_t sourceStride = (alignedRows + 31) / 32;
uint32_t columnBlocks = (columns + 31) / 32;
uint32_t destinationStride = ((columns + 15) / 16) * 16 * 32;
for (uint32_t block = 0; block < reductionBlocks; ++block)
asc_copy_l12l0b_trans(dst + block * destinationStride, src + block * 1024,
0, columnBlocks, sourceStride, 1, false, 0);
}
constexpr int GELU_AFFINE_BYTES=768;
constexpr int GELU_MULTIPLIER_ADDRESS=192*1024-GELU_AFFINE_BYTES;
constexpr int GELU_BIAS_ADDRESS=GELU_MULTIPLIER_ADDRESS+352;
__aicore__ inline void capi_init_gelu_affine() {
auto multiplier=reinterpret_cast<__ubuf__ float*>(uint64_t(GELU_MULTIPLIER_ADDRESS));
auto bias=reinterpret_cast<__ubuf__ float*>(uint64_t(GELU_BIAS_ADDRESS));
asc_set_mask_norm();asc_set_vector_mask(0,~uint64_t(0));
asc_duplicate(multiplier,-0.07135481627260091f,1,1,8);
asc_duplicate(bias,-1.5957691216057308f,1,1,8);
asc_sync_pipe(PIPE_V);
}
template<bool FusedAffine=false>
__aicore__ inline void capi_finish_gelu(__ubuf__ float* z, __ubuf__ float* v,
__ubuf__ half* out, int count) {
asc_set_mask_count();
asc_set_vector_mask(0, count);
asc_mul(v, z, z, 1, 1, 1, 1, 8, 8, 8); asc_sync_pipe(PIPE_V);
if constexpr (FusedAffine) {
auto multiplier=reinterpret_cast<__ubuf__ float*>(uint64_t(GELU_MULTIPLIER_ADDRESS));
auto bias=reinterpret_cast<__ubuf__ float*>(uint64_t(GELU_BIAS_ADDRESS));
asc_mul_add(v,multiplier,bias,1,1,1,1,8,0,0);asc_sync_pipe(PIPE_V);
} else {
asc_mul_scalar(v, v, -0.07135481627260091f, 1, 1, 1, 8, 8); asc_sync_pipe(PIPE_V);
asc_add_scalar(v, v, -1.5957691216057308f, 1, 1, 1, 8, 8); asc_sync_pipe(PIPE_V);
}
asc_mul(v, v, z, 1, 1, 1, 1, 8, 8, 8); asc_sync_pipe(PIPE_V);
asc_min_scalar(v, v, 80.0f, 1, 1, 1, 8, 8); asc_sync_pipe(PIPE_V);
asc_exp(v, v, 1, 1, 1, 8, 8); asc_sync_pipe(PIPE_V);
asc_add_scalar(v, v, 1.0f, 1, 1, 1, 8, 8); asc_sync_pipe(PIPE_V);
asc_div(v, z, v, 1, 1, 1, 1, 8, 8, 8); asc_sync_pipe(PIPE_V);
asc_set_mask_norm();
asc_set_vector_mask(~uint64_t(0), ~uint64_t(0));
asc_float2half_rn(out, v, count);
asc_sync_pipe(PIPE_V);
}
__aicore__ inline int capi_next_active_pack_unit(__gm__ int64_t* ends,
int unit,int stop,int unitsPerExpert) {
#if GMM_OPT_SKIP_EMPTY_PACK
while(unit<stop) {
int expert=unit/unitsPerExpert;
int64_t begin=expert==0?0:ends[expert-1];
if(ends[expert]>begin)break;
unit=(expert+1)*unitsPerExpert;
}
if(unit>stop)unit=stop;
#endif
return unit;
}
struct CapiTile {
int expert, row, column, rows, columns;
};
template<int BM, int BN, int Mode, int Rotate>
struct CapiTraversal {
__gm__ int64_t* ends;
GmmPlan p;
int core, expert=0, rowTile=0, columnTile=0;
int rowBase=0, begin=0, index;
int64_t workBase=0, low=0, high=0;
int cachedExpert=-1, cachedEnd=0, cachedRows=0, cachedRowTiles=0;
__aicore__ CapiTraversal(__gm__ int64_t* groups, GmmPlan plan, int block)
: ends(groups), p(plan), core(block), index(block) {
if(Mode==3 && p.e<=p.cores && p.n>768 && p.n<=896 && p.k>=768 && p.k<2048) {
int strips=(p.n+31)/32;
low=(int64_t)p.e*strips*core/p.cores;
high=(int64_t)p.e*strips*(core+1)/p.cores;
expert=low/strips;
begin=expert==0?0:ends[expert-1];
}
if constexpr (Mode==5 || Mode==8) {
int strips=(p.n+31)/32;
int64_t work=(int64_t)p.e*strips;
low=work*core/p.cores;
high=work*(core+1)/p.cores;
expert=low/strips;
begin=expert==0?0:ends[expert-1];
}
if constexpr (Mode==2 || Mode==4) {
int active=0, previous=0;
if constexpr (Mode==4) {
for(int e=0;e<p.e;++e) {
int end=ends[e];
if(end>previous)++active;
previous=end;
}
}
int64_t total=((int64_t)p.m+(Mode==4?int64_t(active)*BM*2:0))*p.n;
low=(total*core+p.cores-1)/p.cores;
high=(total*(core+1)+p.cores-1)/p.cores;
if constexpr (Mode==2) {
int limit=p.e;
while(expert<limit) {
int middle=expert+(limit-expert)/2;
if((int64_t)ends[middle]*p.n<=low)expert=middle+1;
else limit=middle;
}
begin=expert==0?0:ends[expert-1];
}
}
}
__aicore__ inline bool Next(CapiTile& result) {
int nt=(p.n+BN-1)/BN;
if(Mode==3 && p.e<=p.cores && p.n>896 && p.k>=768 && p.k<2048 && nt>1) {
const int fullJobs=p.e*(nt-1);
const int remainder=fullJobs%p.cores;
const int lightCores=p.cores-remainder;
while(index<fullJobs) {
const int e=index/(nt-1),c=index%(nt-1);
const int first=e==0?0:ends[e-1],end=ends[e];
const int rt=(end-first+BM-1)/BM;
if(rowTile>=rt){index+=p.cores;rowTile=0;continue;}
const int row=first+(rowTile++)*BM;
result={e,row,c*BN,end-row<BM?end-row:BM,BN};
return true;
}
if(core<remainder)return false;
if(columnTile==0){expert=core-remainder;columnTile=1;rowTile=0;}
while(expert<p.e) {
const int first=expert==0?0:ends[expert-1],end=ends[expert];
const int rt=(end-first+BM-1)/BM;
if(rowTile>=rt){expert+=lightCores;rowTile=0;continue;}
const int row=first+(rowTile++)*BM,column=(nt-1)*BN;
result={expert,row,column,end-row<BM?end-row:BM,p.n-column};
return true;
}
return false;
}
if(Mode==3 && p.e<=p.cores && p.n>768 && p.n<=896 && p.k>=768 && p.k<2048) {
const int strips=(p.n+31)/32;
while(expert<p.e && low<high) {
int end=ends[expert],rows=end-begin,rt=(rows+BM-1)/BM;
int64_t groupBegin=(int64_t)expert*strips;
int available=high-groupBegin<strips?(int)(high-groupBegin):strips;
int start=(int)(low-groupBegin);
if(!rt || start>=available) {
low=groupBegin+available;begin=end;++expert;rowTile=0;continue;
}
int remaining=available-start;
int panels=(remaining+BN/32-1)/(BN/32);
int count=(remaining+panels-1)/panels;
int row=begin+rowTile*BM,col=start*32;
result={expert,row,col,end-row<BM?end-row:BM,p.n-col<count*32?p.n-col:count*32};
if(++rowTile==rt){rowTile=0;low+=count;}
return true;
}
return false;
}
if constexpr (Mode==3) {
while(index<p.e*nt) {
int e=index/nt;
