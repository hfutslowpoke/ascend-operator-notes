__aicore__ inline void LoadOperands(CceTile tile,__cbuf__ int8_t* a,
int panel,int inner,int count,int panelStride,int alignedRows,int columns) {
int slot=operandSlot;
wait_flag(PIPE_M,PIPE_MTE1,static_cast<event_t>(slot));
auto left=reinterpret_cast<__ca__ int8_t*>(uint64_t(slot*BM*128));
auto right=reinterpret_cast<__cb__ int8_t*>(uint64_t(slot*BN*128));
