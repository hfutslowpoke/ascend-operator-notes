__aicore__ inline void CopyRows(__cbuf__ int8_t* local,__gm__ int8_t* source,
int rows,int stride) {
const int paired=rows&~31,bulk=plan.k&~31;
if((plan.k&1) && paired>0 && bulk>0) {
asc_copy_gm2l1_nd2nz(reinterpret_cast<__cbuf__ int16_t*>(local),
reinterpret_cast<__gm__ int16_t*>(source),1,paired/2,bulk/2,0,plan.k,stride,2,0);
asc_copy_gm2l1_nd2nz(reinterpret_cast<__cbuf__ int16_t*>(local+32),
reinterpret_cast<__gm__ int16_t*>(source+plan.k),1,paired/2,bulk/2,0,plan.k,stride,2,0);
