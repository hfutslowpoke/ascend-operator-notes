wait_flag(PIPE_MTE1,PIPE_M,static_cast<event_t>(slot));
if(prefetchB && inner+count>=paddedK) {
set_flag(PIPE_MTE1,PIPE_MTE2,EVENT_ID4);wait_flag(PIPE_MTE1,PIPE_MTE2,EVENT_ID4);
CopyWeight(*nextTile,0,plan.k);
set_flag(PIPE_MTE2,PIPE_MTE1,EVENT_ID6);bPrefetched=true;
}
mad(accumulator,reinterpret_cast<__ca__ int8_t*>(uint64_t(slot*BM*128)),
reinterpret_cast<__cb__ int8_t*>(uint64_t(slot*BN*128)),
alignedRows,count,columns,0,false,false,inner==0);
set_flag(PIPE_M,PIPE_MTE1,static_cast<event_t>(slot));
int next=inner+128;
if(next<paddedK)LoadOperands(tile,localA,0,next,paddedK-next<128?paddedK-next:128,
