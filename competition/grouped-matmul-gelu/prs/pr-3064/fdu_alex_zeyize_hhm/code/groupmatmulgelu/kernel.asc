gmm_capi_panels<64,512,1,256,0,true,0,false,256,true,true,true,0,false,true,true,false,true,true,true,true,true,true><<<p.cores,nullptr,stream>>>(x,w,s,g,y,(GM_ADDR)workspace,p);
else if(p.n>512 && p.n<=768 && p.k%256==0)
gmm_capi_panels<64,512,1,256,0,true,0,false,256,true,true,true,0,false,true,true><<<p.cores,nullptr,stream>>>(x,w,s,g,y,(GM_ADDR)workspace,p);
else if(p.n<=768)
gmm_capi_panels<64,512,1,256,0,true,0,false,256,true><<<p.cores,nullptr,stream>>>(x,w,s,g,y,(GM_ADDR)workspace,p);
else
gmm_capi_panels<64,256,1><<<p.cores,nullptr,stream>>>(x,w,s,g,y,(GM_ADDR)workspace,p);
}
else if(tileM==64 && tileN==256 && p.e<=512 &&
averageRows>tileM && averageRows<=3*tileM && p.n==tileN &&
p.k>=128 && p.k<=512 && p.k%128==0 &&
(p.e>=4*p.cores ||
(p.e>=p.cores && p.e%p.cores==0) ||
(p.e<p.cores && p.k>=256 && 4*p.e>=3*p.cores))) {
GmmPlan residentPlan=p;
if(residentPlan.cores>p.e)residentPlan.cores=p.e;
if(p.k<=256)
gmm_capi<64,256,256,true,0,false,false,0,0,2,2><<<residentPlan.cores,nullptr,stream>>>(x,w,s,g,y,(GM_ADDR)workspace,residentPlan);
else
gmm_capi<64,256,256,true,0,false,false,0,0,2,1><<<residentPlan.cores,nullptr,stream>>>(x,w,s,g,y,(GM_ADDR)workspace,residentPlan);
}
else if(tileM==64 && tileN==256 && p.e>=4*p.cores && p.e<=512 && p.m/p.e<=tileM && p.n<=tileN &&
p.k%128==0 && p.k<=512 && p.n%32==0) {
constexpr int expertSlice=128;
const int reductionSlices=p.k/expertSlice;
if(p.n==tileN && reductionSlices==1)
gmm_capi<64,256,256,true,0,false,false,0,0,2,0,true,1><<<p.cores,nullptr,stream>>>(x,w,s,g,y,(GM_ADDR)workspace,p);
else if(p.n==tileN && reductionSlices==2)
gmm_capi<64,256,256,true,0,false,false,0,0,2,0,true,2><<<p.cores,nullptr,stream>>>(x,w,s,g,y,(GM_ADDR)workspace,p);
else if(p.n==tileN)
gmm_capi<64,256,256,true,0,false,false,0,0,2,0,true><<<p.cores,nullptr,stream>>>(x,w,s,g,y,(GM_ADDR)workspace,p);
else
gmm_capi<64,256,256,true><<<p.cores,nullptr,stream>>>(x,w,s,g,y,(GM_ADDR)workspace,p);
}
else if(widePanel && p.directCube==CUBE_MODE_WIDE_A) {
constexpr uint64_t fourStageL1Bytes=64u*2048+4u*192*512;
constexpr uint64_t threeStageL1Bytes=64u*2048+3u*192*512;
if(fourStageL1Bytes<=l1Capacity)
gmm_capi<64,512,256,false,0,false,false,0,0,4><<<p.cores,nullptr,stream>>>(x,w,s,g,y,(GM_ADDR)workspace,p);
else if(threeStageL1Bytes<=l1Capacity)
gmm_capi<64,512,256,false,0,false,false,0,0,3><<<p.cores,nullptr,stream>>>(x,w,s,g,y,(GM_ADDR)workspace,p);
else
gmm_capi<64,512,256><<<p.cores,nullptr,stream>>>(x,w,s,g,y,(GM_ADDR)workspace,p);
}
else if(widePanel) {
if(averageRows>=128)
gmm_capi_panels<128,256><<<p.cores,nullptr,stream>>>(x,w,s,g,y,(GM_ADDR)workspace,p);
else
gmm_capi_panels<64,512,7,320><<<p.cores,nullptr,stream>>>(x,w,s,g,y,(GM_ADDR)workspace,p);
}
else if(tileM==128 && tileN==256 && p.directTall==TALL_MODE_RESIDENT_A) {
if(residentRowHalves)
gmm_resident_row_halves<<<p.cores,nullptr,stream>>>(x,w,s,g,y,(GM_ADDR)workspace,p);
else if(p.k<=1024)
gmm_capi<128,256,256,false,0,true,false,1,32><<<p.cores,nullptr,stream>>>(x,w,s,g,y,(GM_ADDR)workspace,p);
else
gmm_capi<128,256,256,false,0,true,false,1><<<p.cores,nullptr,stream>>>(x,w,s,g,y,(GM_ADDR)workspace,p);
}
else if(tileM==128 && tileN==256 && p.directTall==TALL_MODE_MID_K)
gmm_capi<128,256><<<p.cores,nullptr,stream>>>(x,w,s,g,y,(GM_ADDR)workspace,p);
else if(tileM==128 && tileN==256)
gmm_capi_panels<128,256><<<p.cores,nullptr,stream>>>(x,w,s,g,y,(GM_ADDR)workspace,p);
else if(tileM==128)
gmm_capi_panels<128,128><<<p.cores,nullptr,stream>>>(x,w,s,g,y,(GM_ADDR)workspace,p);
else if(tileM==16 && shortNarrow)
gmm_capi_panels<16,128,0,256><<<p.cores,nullptr,stream>>>(x,w,s,g,y,(GM_ADDR)workspace,p);
else if(tileM==16)
gmm_capi_panels<16,128><<<p.cores,nullptr,stream>>>(x,w,s,g,y,(GM_ADDR)workspace,p);
else if(tileN==128)
gmm_capi_panels<64,128><<<p.cores,nullptr,stream>>>(x,w,s,g,y,(GM_ADDR)workspace,p);
else
gmm_capi_panels<64,256><<<p.cores,nullptr,stream>>>(x,w,s,g,y,(GM_ADDR)workspace,p);
aclError execution=aclrtSynchronizeStream(stream);
aclError release=aclrtFree(workspace);
if(execution!=ACL_SUCCESS || release!=ACL_SUCCESS)
throw std::runtime_error("GMM execution or workspace release failed");
}
