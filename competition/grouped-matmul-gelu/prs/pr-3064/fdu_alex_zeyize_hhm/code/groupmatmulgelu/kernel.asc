template<int BM,int BN,int KP>
struct CcePackedFourStageEngine {
__gm__ int8_t* input;
__gm__ int8_t* weights;
GmmPlan plan;
int aWrite=0,aRead=0,bWrite=0,bRead=0,operand=0,paddedK=0;
int activationExpert=-1,activationRow=-1,heldSlot=0;
bool aPrefetched=false,bPrefetched=false,streamedWeights=false;
__aicore__ inline __cbuf__ int8_t* Activation(int slot) {
return reinterpret_cast<__cbuf__ int8_t*>(uint64_t(slot*BM*paddedK));
}
__aicore__ inline __cbuf__ int8_t* Weight(int slot) {
return reinterpret_cast<__cbuf__ int8_t*>(uint64_t(2*BM*paddedK+slot*BN*KP));
}
__aicore__ inline void Init(CceStorage& memory,GmmPlan p,
__gm__ int8_t* a,__gm__ int8_t* b) {
plan=p;input=a;weights=b;paddedK=(p.k+31)&~31;
memory.l1=2*BM*paddedK+4*BN*KP;
for(int i=0;i<6;++i)set_flag(PIPE_MTE1,PIPE_MTE2,static_cast<event_t>(i));
for(int i=0;i<2;++i)set_flag(PIPE_M,PIPE_MTE1,static_cast<event_t>(i));
set_flag(PIPE_FIX,PIPE_M,EVENT_ID0);
}
__aicore__ inline void LoadA(CceTile tile,int panel,int count) {
int slot=aWrite;aWrite^=1;
wait_flag(PIPE_MTE1,PIPE_MTE2,static_cast<event_t>(slot));
copy_gm_to_cbuf_multi_nd2nz_b8(Activation(slot),input+int64_t(tile.row)*plan.k+panel,
0,1,tile.rows,count,0,plan.k,(tile.rows+15)&~15,1,0);
set_flag(PIPE_MTE2,PIPE_MTE1,static_cast<event_t>(slot));
}
__aicore__ inline void LoadB(CceTile tile,int panel,int count) {
int slot=bWrite;bWrite=(bWrite+1)&3;
wait_flag(PIPE_MTE1,PIPE_MTE2,static_cast<event_t>(2+slot));
int paddedN=(plan.n+31)&~31,columns=(tile.columns+31)&~31;
copy_gm_to_cbuf(Weight(slot),weights+(int64_t(tile.expert)*paddedK+panel)*paddedN+tile.column*32,
0,(count+31)/32,columns,paddedN-columns,0,static_cast<pad_t>(0));
set_flag(PIPE_MTE2,PIPE_MTE1,static_cast<event_t>(2+slot));
}
__aicore__ inline void Operands(__cbuf__ int8_t* b,
int panel,int inner,int count,int rows,int columns) {
int slot=operand;
wait_flag(PIPE_M,PIPE_MTE1,static_cast<event_t>(slot));
asc_copy_l12l0a(reinterpret_cast<__ca__ int8_t*>(uint64_t(slot*BM*64)),
Activation(heldSlot),count,rows,panel+inner,0,1,1,1,1,1,1,false,false,false,false,paddedK);
load_cbuf_to_cb_transpose(reinterpret_cast<__cb__ int8_t*>(uint64_t(slot*BN*64)),
b+inner*columns,0,(count/32)*(columns/32),1,1,false,0);
set_flag(PIPE_MTE1,PIPE_M,static_cast<event_t>(slot));
}
__aicore__ inline void Multiply(CceTile tile,__gm__ int32_t* target,
const CceTile* nextTile,int reuseEvent=-1) {
if(reuseEvent>=0)wait_flag_dev(reuseEvent);
int rows=(tile.rows+15)&~15,columns=(tile.columns+31)&~31;
set_fmatrix((uint64_t(1)<<16)|rows);
if(tile.expert!=activationExpert || tile.row!=activationRow) {
if(activationExpert>=0)set_flag(PIPE_MTE1,PIPE_MTE2,static_cast<event_t>(heldSlot));
if(!aPrefetched)LoadA(tile,0,plan.k);
heldSlot=aRead;aRead^=1;
wait_flag(PIPE_MTE2,PIPE_MTE1,static_cast<event_t>(heldSlot));
aPrefetched=false;activationExpert=tile.expert;activationRow=tile.row;
}
if(nextTile && (nextTile->expert!=tile.expert || nextTile->row!=tile.row)) {
LoadA(*nextTile,0,plan.k);aPrefetched=true;
}
int first=plan.k<KP?plan.k:KP;
if(!bPrefetched)LoadB(tile,0,first);
bPrefetched=false;
for(int prime=KP;prime<3*KP && prime<plan.k;prime+=KP)
LoadB(tile,prime,plan.k-prime<KP?plan.k-prime:KP);
wait_flag(PIPE_FIX,PIPE_M,EVENT_ID0);
auto accumulator=reinterpret_cast<__cc__ int32_t*>(uint64_t(0));
for(int panel=0;panel<plan.k;panel+=KP) {
int count=plan.k-panel<KP?plan.k-panel:KP,padded=(count+31)&~31;
int bSlot=bRead;bRead=(bRead+1)&3;
wait_flag(PIPE_MTE2,PIPE_MTE1,static_cast<event_t>(2+bSlot));
if(panel+count>=plan.k && nextTile){LoadB(*nextTile,0,first);bPrefetched=true;}
int ahead=panel+3*KP;
if(ahead<plan.k)LoadB(tile,ahead,plan.k-ahead<KP?plan.k-ahead:KP);
auto b=Weight(bSlot);
Operands(b,panel,0,padded<64?padded:64,rows,columns);
for(int inner=0;inner<padded;inner+=64) {
int reduction=padded-inner<64?padded-inner:64;
int slot=operand;operand^=1;
wait_flag(PIPE_MTE1,PIPE_M,static_cast<event_t>(slot));
mad(accumulator,reinterpret_cast<__ca__ int8_t*>(uint64_t(slot*BM*64)),
reinterpret_cast<__cb__ int8_t*>(uint64_t(slot*BN*64)),
rows,reduction,columns,0,false,false,panel==0 && inner==0);
set_flag(PIPE_M,PIPE_MTE1,static_cast<event_t>(slot));
int next=inner+64;
if(next<padded)Operands(b,panel,next,padded-next<64?padded-next:64,rows,columns);
pipe_barrier(PIPE_M);
}
set_flag(PIPE_MTE1,PIPE_MTE2,static_cast<event_t>(2+bSlot));
}
set_flag(PIPE_M,PIPE_FIX,EVENT_ID0);wait_flag(PIPE_M,PIPE_FIX,EVENT_ID0);
asc_set_l0c_copy_prequant(uint64_t(0x3b000000));
asc_set_l0c_copy_params(1,0,0);asc_set_l0c2gm_config(0,0,true);
copy_matrix_cc_to_gm(reinterpret_cast<__gm__ half*>(target),accumulator,
0,tile.columns,tile.rows,BN,rows,0,QuantMode_t::DEQF16,0,false,true);
set_flag(PIPE_FIX,PIPE_M,EVENT_ID0);
}
__aicore__ inline void Finish() {
if(activationExpert>=0)set_flag(PIPE_MTE1,PIPE_MTE2,static_cast<event_t>(heldSlot));
for(int i=0;i<6;++i)wait_flag(PIPE_MTE1,PIPE_MTE2,static_cast<event_t>(i));
for(int i=0;i<2;++i)wait_flag(PIPE_M,PIPE_MTE1,static_cast<event_t>(i));
wait_flag(PIPE_FIX,PIPE_M,EVENT_ID0);
}
};
template<int BM,int BN,int KP,bool LateWait>
struct CceCachedResidentEngine {
__gm__ int8_t* input;
