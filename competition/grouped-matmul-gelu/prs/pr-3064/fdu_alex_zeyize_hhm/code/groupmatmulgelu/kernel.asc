rowStride/8,rowStride/8,0);
}
}
asc_sync_pipe(PIPE_V);
if(p.k>=768 && p.k<2048 && p.n%128!=0) {
if constexpr(HalfScratch && Mode==3 && BM==96 && BN==320)::capi_finish_ragged_half_affine(z,v,out,active);
else ::capi_finish_gelu_half(z,v,out,active);
}
else capi_finish_gelu<FusedAffine>(z,v,out,active);
