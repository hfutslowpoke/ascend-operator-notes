SetFlag<HardEvent::S_MTE3>(EVENT_ID0);
WaitFlag<HardEvent::S_MTE3>(EVENT_ID0);
SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
DataCopyPad(y[uint64_t(row)*plan.n+col],out,
DataCopyExtParams{static_cast<uint16_t>(vm),vn*2,
(stride-(vn+15)/16*16)/16,(plan.n-vn)*2,0});
SetFlag<HardEvent::MTE3_V>(EVENT_ID1);
outputPending = true;
}
bool outputPending{false};
uint32_t loadedScaleCol = 0xffffffff;
uint32_t accumStride;
struct { uint32_t n; } plan;
static constexpr uint32_t elements=16384;
GlobalTensor<float> scale;
GlobalTensor<half> y;
GlobalTensor<int32_t> accum;
LocalTensor<uint8_t> temp;
Buffer zb,qb,tb,db,sb,yb,m0b,m1b,kb;
};
}
namespace direct_core {
template<class BlockMmad_, class BlockEpilogue_>
class AckGrouped {
public:
using BlockMmad = BlockMmad_;
using L1TileShape = typename BlockMmad::L1TileShape;
using ElementA = int8_t;
using ElementB = int8_t;
using ElementC = int32_t;
using ElementGroupList = int64_t;
using LayoutA = layout::RowMajor;
using LayoutB = layout::RowMajor;
using LayoutC = layout::RowMajor;
using LayoutD = layout::RowMajor;
using LayoutScale = layout::VectorLayout;
using BlockEpilogue = BlockEpilogue_;
using EpilogueParams = typename BlockEpilogue::Params;
using BlockScheduler = RowSwizzle3;
static constexpr uint32_t WORKSPACE_STAGES = 2;
using Params = GroupParams;
DIRECT_DEVICE
AckGrouped()
{
Arch::FlagID flagId = 0;
for (uint32_t stageId = 0; stageId < WORKSPACE_STAGES; ++stageId) {
flagAicFinishStoreList[stageId] = Arch::CrossCoreFlag(flagId++);
flagAivFinishComputeList[stageId] = Arch::CrossCoreFlag(flagId++);
}
}
DIRECT_DEVICE void operator()(Params const &params) {
if constexpr (g_coreType == AscendC::AIC) RunCube(params);
else RunVector(params);
}
DIRECT_DEVICE void RunCube(Params const &params)
{
AscendC::ICachePreLoad(1);
BlockScheduler blockScheduler;
BlockMmad blockMmad(resource);
AscendC::GlobalTensor<ElementA> gmA;
gmA.SetGlobalBuffer(params.ptrA);
AscendC::GlobalTensor<ElementGroupList> groupList;
groupList.SetGlobalBuffer(params.ptrGroupList);
uint32_t coreIdx = AscendC::GetBlockIdx();
uint32_t coreNum = AscendC::GetBlockNum();
int64_t gmGroupOffsetA = 0;
int64_t gmGroupOffsetB = 0;
AscendC::GlobalTensor<ElementC> gmC;
gmC.SetGlobalBuffer(reinterpret_cast<__gm__ ElementC *>(params.ptrWorkspace));
const uint32_t workspaceN = RoundUp<16>(params.problemShape.n() < L1TileShape::N ? params.problemShape.n() : L1TileShape::N);
auto layoutC = layout::RowMajor{L1TileShape::M * coreNum * WORKSPACE_STAGES, workspaceN};
uint32_t stageId = 0;
uint32_t stageUsed = 0;
uint32_t startCoreIdx = 0;
for (uint32_t groupIdx = 0; groupIdx < params.problemCount; ++groupIdx) {
uint32_t currentM = (groupIdx == 0) ? groupList.GetValue(groupIdx) :
(groupList.GetValue(groupIdx) - groupList.GetValue(groupIdx - 1));
GemmCoord inGroupProblemShape{currentM, params.problemShape.n(), params.problemShape.k()};
LayoutA layoutA = params.layoutA.GetTileLayout(inGroupProblemShape.GetCoordMK());
LayoutB layoutB = params.layoutB;
blockScheduler.Update(inGroupProblemShape, MakeCoord(L1TileShape::M, L1TileShape::N));
uint32_t coreLoops = blockScheduler.GetCoreLoops();
AscendC::GlobalTensor<ElementB> gmB;
gmB.SetGlobalBuffer(params.ptrB + gmGroupOffsetB);
gmB.SetL2CacheHint(currentM<=L1TileShape::M?AscendC::CacheMode::CACHE_MODE_DISABLE:AscendC::CacheMode::CACHE_MODE_NORMAL);
uint32_t startLoopIdx = ((coreIdx < startCoreIdx) ? (coreIdx + coreNum) : coreIdx) - startCoreIdx;
for (uint32_t loopIdx = startLoopIdx; loopIdx < coreLoops; loopIdx += coreNum) {
GemmCoord blockCoord = blockScheduler.GetBlockCoord(loopIdx);
GemmCoord actualBlockShape = blockScheduler.GetActualBlockShape(blockCoord);
const bool waitBeforeFixpipe = stageUsed == WORKSPACE_STAGES;
if (!waitBeforeFixpipe) ++stageUsed;
MatrixCoord offsetA{blockCoord.m() * L1TileShape::M, blockCoord.k() * L1TileShape::K};
MatrixCoord offsetB{blockCoord.k() * L1TileShape::K, blockCoord.n() * L1TileShape::N};
MatrixCoord offsetC{(stageId * coreNum + coreIdx) * L1TileShape::M, 0};
int64_t gmOffsetA = layoutA.GetOffset(offsetA);
int64_t gmOffsetB = layoutB.GetOffset(offsetB);
int64_t gmOffsetC = layoutC.GetOffset(offsetC);
if (waitBeforeFixpipe) Arch::Wait(flagAivFinishComputeList[stageId]);
blockMmad(
gmA[gmGroupOffsetA + gmOffsetA], layoutA,
gmB[gmOffsetB], layoutB,
gmC[gmOffsetC], layoutC,
actualBlockShape
);
Arch::Signal<PIPE_FIX>(flagAicFinishStoreList[stageId]);
stageId = (stageId + 1 < WORKSPACE_STAGES) ? (stageId + 1) : 0;
}
gmGroupOffsetA += uint64_t(inGroupProblemShape.m()) * params.layoutA.stride(0);
gmGroupOffsetB += uint64_t(inGroupProblemShape.k()) * params.layoutB.stride(0);
startCoreIdx = (startCoreIdx + coreLoops) % coreNum;
}
while (stageUsed > 0) {
uint32_t aivComputeStageId = (stageId >= stageUsed) ?
(stageId - stageUsed) : (stageId + WORKSPACE_STAGES - stageUsed);
Arch::Wait(flagAivFinishComputeList[aivComputeStageId]);
--stageUsed;
}
AscendC::PipeBarrier<PIPE_ALL>();
}
DIRECT_DEVICE void RunVector(Params const &params)
{
AscendC::ICachePreLoad(1);
BlockScheduler blockScheduler;
BlockEpilogue blockEpilogue(resource);
uint32_t coreIdx = AscendC::GetBlockIdx() / AscendC::GetSubBlockNum();
uint32_t coreNum = AscendC::GetBlockNum();
int64_t gmGroupOffsetScale = 0;
int64_t gmGroupOffsetD = 0;
AscendC::GlobalTensor<ElementGroupList> groupList;
groupList.SetGlobalBuffer(params.ptrGroupList);
AscendC::GlobalTensor<ElementC> gmC;
gmC.SetGlobalBuffer(reinterpret_cast<__gm__ ElementC *>(params.ptrWorkspace));
const uint32_t workspaceN = RoundUp<16>(params.problemShape.n() < L1TileShape::N ? params.problemShape.n() : L1TileShape::N);
auto layoutC = layout::RowMajor{L1TileShape::M * coreNum * WORKSPACE_STAGES, workspaceN};
uint32_t stageId = 0;
uint32_t startCoreIdx = 0;
for (uint32_t groupIdx = 0; groupIdx < params.problemCount; ++groupIdx) {
uint32_t currentM = (groupIdx == 0) ? groupList.GetValue(groupIdx) :
(groupList.GetValue(groupIdx) - groupList.GetValue(groupIdx - 1));
GemmCoord inGroupProblemShape{currentM, params.problemShape.n(), params.problemShape.k()};
LayoutScale layoutScale = params.layoutScale;
LayoutD layoutD = params.layoutD.GetTileLayout(inGroupProblemShape.GetCoordMN());
EpilogueParams epilogueParams{
params.ptrScale + gmGroupOffsetScale, layoutScale,
params.ptrD + gmGroupOffsetD, layoutD
};
blockScheduler.Update(inGroupProblemShape, L1TileShape::ToCoordMN());
blockEpilogue.UpdateParams(epilogueParams);
uint32_t coreLoops = blockScheduler.GetCoreLoops();
GemmCoord blockShapeMNK = L1TileShape::ToCoord();
uint32_t startLoopIdx = ((coreIdx < startCoreIdx) ? (coreIdx + coreNum) : coreIdx) - startCoreIdx;
for (uint32_t loopIdx = startLoopIdx; loopIdx < coreLoops; loopIdx += coreNum) {
GemmCoord blockCoordMNK = blockScheduler.GetBlockCoord(loopIdx);
GemmCoord actualBlockShapeMNK = blockScheduler.GetActualBlockShape(blockCoordMNK);
MatrixCoord offsetC{(stageId * coreNum + coreIdx) * L1TileShape::M, 0};
int64_t gmOffsetC = layoutC.GetOffset(offsetC);
auto gmBlockC = gmC[gmOffsetC];
auto layoutBlockC = layoutC.GetTileLayout(actualBlockShapeMNK.GetCoordMN());
Arch::Wait(flagAicFinishStoreList[stageId]);
blockEpilogue(blockShapeMNK, blockCoordMNK, actualBlockShapeMNK, gmBlockC, layoutBlockC,flagAivFinishComputeList[stageId]);
stageId = (stageId + 1 < WORKSPACE_STAGES) ? (stageId + 1) : 0;
}
gmGroupOffsetScale += inGroupProblemShape.n();
gmGroupOffsetD += inGroupProblemShape.m() * inGroupProblemShape.n();
startCoreIdx = (startCoreIdx + coreLoops) % coreNum;
}
AscendC::PipeBarrier<PIPE_ALL>();
}
private:
Arch::CrossCoreFlag flagAicFinishStoreList[WORKSPACE_STAGES];
Arch::CrossCoreFlag flagAivFinishComputeList[WORKSPACE_STAGES];
Arch::Resource resource;
};
}
namespace direct_core {
}
namespace direct_core {
template<class L1TileShape_, class L0TileShape_>
struct Case1DeepMmad {
public:
using ArchTag = Arch::AtlasA2;
using L1TileShape = L1TileShape_;
using L0TileShape = L0TileShape_;
using ElementA = int8_t;
using ElementB = int8_t;
using ElementC = int32_t;
using ElementAccumulator = int32_t;
using LayoutA = layout::RowMajor;
using LayoutB = layout::RowMajor;
using LayoutC = layout::RowMajor;
using TileMmad = ops::Int8Mmad;
using CopyGmToL1A = ops::Int8GmToL1;
using CopyGmToL1B = ops::Int8GmToL1;
using CopyL1ToL0A = ops::Int8L1ToL0A;
using CopyL1ToL0B = ops::Int8L1ToL0B;
using CopyL0CToGm = ops::Int32L0CToGm;
using LayoutAInL1 = typename CopyL1ToL0A::LayoutSrc;
using LayoutBInL1 = typename CopyL1ToL0B::LayoutSrc;
using LayoutAInL0 = typename CopyL1ToL0A::LayoutDst;
using LayoutBInL0 = typename CopyL1ToL0B::LayoutDst;
using LayoutCInL0 = layout::Accumulator;
static constexpr uint32_t STAGES = 2;
static constexpr uint32_t L1_STAGES=3;
static constexpr uint32_t L1A_SIZE = L1TileShape::M * L1TileShape::K * sizeof(ElementA);
static constexpr uint32_t L1B_SIZE = L1TileShape::N * (L1TileShape::K+32) * sizeof(ElementB);
static constexpr uint32_t L0A_SIZE = ArchTag::L0A_SIZE;
static constexpr uint32_t L0B_SIZE = ArchTag::L0B_SIZE;
static constexpr uint32_t L0C_SIZE = ArchTag::L0C_SIZE;
static constexpr uint32_t L0A_PINGPONG_BUF_SIZE = L0A_SIZE / STAGES;
static constexpr uint32_t L0B_PINGPONG_BUF_SIZE = L0B_SIZE / STAGES;
static_assert(direct_core::is_same_v<LayoutC, layout::RowMajor>, "LayoutC only support RowMajor yet!");
static_assert((L1A_SIZE * L1_STAGES + L1B_SIZE * L1_STAGES) <= ArchTag::L1_SIZE, "L1TileShape exceeding the L1 space!");
static constexpr uint32_t L0A_TILE_SIZE = L0TileShape::M * L0TileShape::K * sizeof(ElementA);
static constexpr uint32_t L0B_TILE_SIZE = L0TileShape::K * L0TileShape::N * sizeof(ElementB);
static constexpr uint32_t L0C_TILE_SIZE = L0TileShape::M * L0TileShape::N * sizeof(ElementAccumulator);
static_assert((L0A_TILE_SIZE * STAGES) <= L0A_SIZE, "L0TileShape exceeding the L0A space!");
static_assert((L0B_TILE_SIZE * STAGES) <= L0B_SIZE, "L0TileShape exceeding the L0B space!");
static_assert(L0C_TILE_SIZE <= L0C_SIZE, "L0TileShape exceeding the L0C space!");
static_assert(L1TileShape::M==L0TileShape::M && L1TileShape::N%L0TileShape::N==0,"Exact N split only");
static_assert(L1TileShape::M*L1TileShape::N*sizeof(ElementAccumulator)<=ArchTag::L0C_SIZE,"Full C fits");
static_assert(L0TileShape::K <= L1TileShape::K, "L0TileShape::K cannot exceed L1TileShape::K");
DIRECT_DEVICE
Case1DeepMmad(Arch::Resource &resource, uint32_t l1BufAddrStart = 0)
{
uint32_t l1AOffset = l1BufAddrStart;
uint32_t l1BOffset = l1BufAddrStart + L1A_SIZE * L1_STAGES;
for(uint32_t i=0;i<L1_STAGES;++i){
l1ATensorList[i]=resource.l1Buf.template GetBufferByByte<ElementA>(l1AOffset+L1A_SIZE*i);
l1BTensorList[i]=resource.l1Buf.template GetBufferByByte<ElementB>(l1BOffset+L1B_SIZE*i);
l1AEventList[i]=i;l1BEventList[i]=i+L1_STAGES;
AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(l1AEventList[i]);
AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(l1BEventList[i]);
}
for(uint32_t i=0;i<STAGES;++i){
l0ATensorList[i]=resource.l0ABuf.template GetBufferByByte<ElementA>(L0A_PINGPONG_BUF_SIZE*i);
l0BTensorList[i]=resource.l0BBuf.template GetBufferByByte<ElementB>(L0B_PINGPONG_BUF_SIZE*i);
l0AEventList[i]=i;l0BEventList[i]=i+STAGES;
AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(l0AEventList[i]);
AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(l0BEventList[i]);
}
l0CTensor = resource.l0CBuf.template GetBufferByByte<ElementAccumulator>(0);
AscendC::SetFlag<AscendC::HardEvent::FIX_M>(EVENT_ID0);
}
DIRECT_DEVICE
~Case1DeepMmad()
{
for(uint32_t i=0;i<L1_STAGES;++i){
AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(l1AEventList[i]);
AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(l1BEventList[i]);
}
for(uint32_t i=0;i<STAGES;++i){
AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(l0AEventList[i]);
AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(l0BEventList[i]);
}
AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(EVENT_ID0);
}
DIRECT_DEVICE
void operator()(
AscendC::GlobalTensor<ElementA> const &gmA, LayoutA const &layoutA,
AscendC::GlobalTensor<ElementB> const &gmB, LayoutB const &layoutB,
AscendC::GlobalTensor<ElementC> const &gmC, LayoutC const &layoutC,
GemmCoord const &actualShape)
{
uint32_t mRound = RoundUp<16>(actualShape.m());
uint32_t nRound = RoundUp<32>(actualShape.n());
auto layoutAInL1 = LayoutAInL1::template MakeLayout<ElementA>(L1TileShape::M, L1TileShape::K);
auto layoutBInL1 = LayoutBInL1::template MakeLayout<ElementB>(L1TileShape::K+32, L1TileShape::N);
auto layoutInL0C = LayoutCInL0::MakeLayoutInL0C(MakeCoord(mRound, nRound));
uint32_t kActual=min(actualShape.k(),L1TileShape::K);
const uint32_t kTileCount=CeilDiv<L1TileShape::K>(actualShape.k());
auto layoutTileA=layoutA.GetTileLayout(MakeCoord(actualShape.m(),kActual));
auto layoutTileB=layoutB.GetTileLayout(MakeCoord(kActual,actualShape.n()));
for(uint32_t lookahead=0;lookahead<L1_STAGES-1 && lookahead<kTileCount;++lookahead){
const uint32_t id=(l1ListId+lookahead)%L1_STAGES;
const uint32_t kStart=lookahead*L1TileShape::K;
const uint32_t kCount=min(actualShape.k()-kStart,L1TileShape::K);
layoutTileA=layoutA.GetTileLayout(MakeCoord(actualShape.m(),kCount));
layoutTileB=layoutB.GetTileLayout(MakeCoord(kCount,actualShape.n()));
AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(l1AEventList[id]);
copyGmToL1A(l1ATensorList[id],gmA[layoutA.GetOffset(MakeCoord(0U,kStart))],layoutAInL1,layoutTileA);
AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(l1AEventList[id]);
AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(l1BEventList[id]);
copyGmToL1B(l1BTensorList[id],gmB[layoutB.GetOffset(MakeCoord(kStart,0U))],layoutBInL1,layoutTileB);
AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(l1BEventList[id]);
}
AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(EVENT_ID0);
uint32_t mPartLoop = CeilDiv<L0TileShape::M>(mRound);
uint32_t nPartLoop = CeilDiv<L0TileShape::N>(nRound);
for (uint32_t kLoopIdx = 0; kLoopIdx < kTileCount; kLoopIdx++) {
const uint32_t l1ListIdNext=(l1ListId+1)%L1_STAGES;
const uint32_t kActualNext=kLoopIdx+1<kTileCount?min(actualShape.k()-(kLoopIdx+1)*L1TileShape::K,L1TileShape::K):0;
const uint32_t prefetchIdx=kLoopIdx+L1_STAGES-1;
if(prefetchIdx<kTileCount){
const uint32_t id=(l1ListId+L1_STAGES-1)%L1_STAGES;
const uint32_t prefetchK=min(actualShape.k()-prefetchIdx*L1TileShape::K,L1TileShape::K);
auto l1ATensor = l1ATensorList[id];
auto l1BTensor = l1BTensorList[id];
MatrixCoord gmTileAOffset{0, prefetchIdx * L1TileShape::K};
MatrixCoord gmTileBOffset{prefetchIdx * L1TileShape::K, 0};
auto gmTileA = gmA[layoutA.GetOffset(gmTileAOffset)];
auto gmTileB = gmB[layoutB.GetOffset(gmTileBOffset)];
AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(l1AEventList[id]);
layoutTileA = layoutA.GetTileLayout(MakeCoord(actualShape.m(), prefetchK));
copyGmToL1A(l1ATensor, gmTileA, layoutAInL1, layoutTileA);
AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(l1AEventList[id]);
AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(l1BEventList[id]);
layoutTileB = layoutB.GetTileLayout(MakeCoord(prefetchK, actualShape.n()));
copyGmToL1B(l1BTensor, gmTileB, layoutBInL1, layoutTileB);
AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(l1BEventList[id]);
}
auto l1ATensor = l1ATensorList[l1ListId];
auto l1BTensor = l1BTensorList[l1ListId];
uint32_t kPartLoop = CeilDiv<L0TileShape::K>(kActual);
for (int mPartIdx = 0; mPartIdx < mPartLoop; mPartIdx++) {
uint32_t mPartActual = (mPartIdx < mPartLoop - 1) ?
L0TileShape::M : (mRound - mPartIdx * L0TileShape::M);
for (int kPartIdx = 0; kPartIdx < kPartLoop; kPartIdx++) {
uint32_t kPartActual = (kPartIdx < kPartLoop - 1) ?
L0TileShape::K : (kActual - kPartIdx * L0TileShape::K);
auto l0ATile = l0ATensorList[l0AListId];
LayoutAInL0 layoutAInL0 = LayoutAInL0::template MakeLayout<ElementA>(mPartActual, kPartActual);
MatrixCoord l1AOffset{mPartIdx * L0TileShape::M, kPartIdx * L0TileShape::K};
auto l1ATile = l1ATensor[layoutAInL1.GetOffset(l1AOffset)];
AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(l0AEventList[l0AListId]);
if ((mPartIdx == 0) && (kPartIdx == 0)) {
AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(l1AEventList[l1ListId]);
}
copyL1ToL0A(l0ATile, l1ATile, layoutAInL0, layoutAInL1);
if ((mPartIdx == mPartLoop - 1) && (kPartIdx == kPartLoop - 1)) {
AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(l1AEventList[l1ListId]);
}
for (int nPartIdx = 0; nPartIdx < nPartLoop; nPartIdx++) {
uint32_t nPartActual = (nPartIdx < nPartLoop - 1) ?
L0TileShape::N : (nRound - nPartIdx * L0TileShape::N);
auto l0BTile = l0BTensorList[l0BListId];
LayoutBInL0 layoutBInL0 = LayoutBInL0::template MakeLayout<ElementB>(kPartActual, nPartActual);
MatrixCoord l1BOffset{kPartIdx * L0TileShape::K, nPartIdx * L0TileShape::N};
auto l1BTile = l1BTensor[layoutBInL1.GetOffset(l1BOffset)];
AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(l0BEventList[l0BListId]);
if ((kPartIdx == 0) && (nPartIdx == 0)) {
AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(l1BEventList[l1ListId]);
}
copyL1ToL0B(l0BTile, l1BTile, layoutBInL0, layoutBInL1);
if ((kPartIdx == kPartLoop - 1) && (nPartIdx == nPartLoop - 1)) {
AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(l1BEventList[l1ListId]);
}
AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID0);
MatrixCoord l0COffset{mPartIdx * L0TileShape::M, nPartIdx * L0TileShape::N};
auto l0CTile = l0CTensor[layoutInL0C.GetOffset(l0COffset)];
AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID0);
bool initC = ((kLoopIdx == 0) && (kPartIdx == 0));
uint8_t unitFlag = 0b00;
tileMmad(l0CTile, l0ATile, l0BTile, mPartActual, nPartActual, kPartActual, initC, unitFlag);
AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(l0BEventList[l0BListId]);
l0BListId = (l0BListId + 1 < STAGES) ? (l0BListId + 1) : 0;
}
AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(l0AEventList[l0AListId]);
l0AListId = (l0AListId + 1 < STAGES) ? (l0AListId + 1) : 0;
}
}
l1ListId = l1ListIdNext;
kActual = kActualNext;
}
LayoutC layoutBlock = layoutC.GetTileLayout(actualShape.GetCoordMN());
AscendC::SetFlag<AscendC::HardEvent::M_FIX>(EVENT_ID0);
AscendC::WaitFlag<AscendC::HardEvent::M_FIX>(EVENT_ID0);
copyL0CToGm(gmC, l0CTensor, layoutBlock, layoutInL0C);
AscendC::SetFlag<AscendC::HardEvent::FIX_M>(EVENT_ID0);
}
protected:
AscendC::LocalTensor<ElementA> l1ATensorList[L1_STAGES];
AscendC::LocalTensor<ElementB> l1BTensorList[L1_STAGES];
AscendC::LocalTensor<ElementA> l0ATensorList[STAGES];
AscendC::LocalTensor<ElementB> l0BTensorList[STAGES];
AscendC::LocalTensor<ElementAccumulator> l0CTensor;
int32_t l1AEventList[L1_STAGES];
int32_t l1BEventList[L1_STAGES];
int32_t l0AEventList[STAGES];
int32_t l0BEventList[STAGES];
uint32_t l1ListId{0};
uint32_t l0AListId{0};
uint32_t l0BListId{0};
TileMmad tileMmad;
CopyGmToL1A copyGmToL1A;
CopyGmToL1B copyGmToL1B;
CopyL1ToL0A copyL1ToL0A;
CopyL1ToL0B copyL1ToL0B;
CopyL0CToGm copyL0CToGm;
};
}
namespace case1_isolated {
using namespace direct_core;
using C1Tile=GemmShape<64,512,256>;
using C1L0=GemmShape<64,256,128>;
using C1Mmad=Case1DeepMmad<C1Tile,C1L0>;
using Kernel=AckGrouped<
C1Mmad,ha_isolated::Case1WideFastEpilogue>;
}
extern "C" __global__ __aicore__ void grouped_matmul_gelu_case1(
GM_ADDR x,GM_ADDR w,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,GM_ADDR scratch,gmg::Plan plan){
KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
AscendC::SetSyncBaseAddr(plan.ffts);
case1_isolated::Kernel::Params params{
direct_core::GemmCoord{plan.m,plan.n,plan.k},plan.e,groups,
x,direct_core::layout::RowMajor{plan.m,plan.k},w,direct_core::layout::RowMajor{plan.k,plan.n},
scale,direct_core::layout::VectorLayout{plan.n},y,direct_core::layout::RowMajor{plan.m,plan.n},scratch};
case1_isolated::Kernel op;op(params);
}
namespace p4_refinement {
using namespace AscendC;
using namespace direct_core;
__aicore__ __forceinline__ float HalfMagnitude(uint16_t bits) {
if (bits < 1024) return static_cast<float>(static_cast<int32_t>(bits)) * 5.9604644775390625e-8f;
gmg::FloatBits result;
result.u = 0x38000000U + (static_cast<uint32_t>(bits) << 13);
return result.f;
}
__aicore__ __forceinline__ int CompareGeluMidpoint(float a, float tail, bool negative, float midpoint, float errorScale) {
const float delta = gmg::RAdd(a, -midpoint);
const float lhs = negative ? gmg::RMul(delta, tail) : delta;
const float rhs = negative ? midpoint : gmg::RMul(midpoint, tail);
const float residual = gmg::RAdd(lhs, -rhs);
const float bound = gmg::RMul(gmg::RAdd(lhs < 0 ? -lhs : lhs, rhs), errorScale);
if (residual > bound) return 1;
if (residual < -bound) return -1;
return 0;
}
__aicore__ __forceinline__ int32_t TryGeluRound(float a, float tail,
bool negative, uint16_t approximate, float errorScale) {
const uint16_t magnitude = approximate & 0x7fff;
const uint16_t sign = approximate & 0x8000;
const float center = HalfMagnitude(magnitude);
const float upper = HalfMagnitude(magnitude + 1);
const int upperSide = CompareGeluMidpoint(a, tail, negative, (center + upper) * 0.5f, errorScale);
if (upperSide == 0) return -1;
if (upperSide > 0) {
const float next = HalfMagnitude(magnitude + 2);
if (CompareGeluMidpoint(a, tail, negative, (upper + next) * 0.5f, errorScale) < 0)
return sign | (magnitude + 1);
return -1;
}
if (magnitude == 0) return sign;
const float lower = HalfMagnitude(magnitude - 1);
const int lowerSide = CompareGeluMidpoint(a, tail, negative, (center + lower) * 0.5f, errorScale);
if (lowerSide > 0) return approximate;
if (lowerSide < 0) {
if (magnitude == 1 || CompareGeluMidpoint(a, tail, negative,
(lower + HalfMagnitude(magnitude - 2)) * 0.5f, errorScale) > 0)
return sign | (magnitude - 1);
}
return -1;
}
__aicore__ __forceinline__ float ApproxExpReduced(float r, int n) {
using namespace gmg;
float polynomial = 0.001388888888888889f;
polynomial = RAdd(0.008333333333333333f, RMul(r, polynomial));
polynomial = RAdd(0.041666666666666664f, RMul(r, polynomial));
polynomial = RAdd(0.16666666666666666f, RMul(r, polynomial));
polynomial = RAdd(0.5f, RMul(r, polynomial));
polynomial = RAdd(1.0f, RMul(r, polynomial));
polynomial = RAdd(1.0f, RMul(r, polynomial));
FloatBits scale;
scale.u = static_cast<uint32_t>(n + 127) << 23;
return RMul(polynomial, scale.f);
}
__aicore__ __forceinline__ uint16_t RefineGeluGuarded(float value, uint16_t approximate) {
using namespace gmg;
const bool negative = value < 0;
const float a = negative ? -value : value;
const uint16_t magnitude = approximate & 0x7fff;
if (magnitude >= 0x7bfe || a == 0 || (!negative && a >= 7.0f))
return RefineGeluLarge(value);
if (!negative) {
const float x = RMul(RMul(a, -1.5957691216057308f),
RAdd(1.0f, RMul(0.044715f, RMul(a, a))));
const int exp2 = static_cast<int>(RAdd(RMul(x, 1.4426950408889634f), -0.5f));
const float exponent = static_cast<float>(exp2);
const float r = RAdd(RAdd(x, RMul(exponent, -0.693145751953125f)),
RMul(exponent, -1.4286068203094172e-6f));
if (r >= -0.36f && r <= 0.36f && exp2 >= -126 && exp2 <= 0) {
const float expTail = ApproxExpReduced(r, exp2);
const int32_t result = TryGeluRound(a, expTail, false, approximate, 3.0e-6f - x * 2.0e-6f);
if (result >= 0) return static_cast<uint16_t>(result);
}
}
const Wide v{a, 0.0f};
const Wide cube = WMul(WMul(v, v), v);
const Wide arg = WNeg(WMul(WAdd(v, WMul(cube, {0.044714998453855515f, 1.5461444832776117e-09f})),
{1.5957691669464111f, -4.5340680321359628e-08f}));
const int n = static_cast<int>(arg.hi * 1.4426950408889634f - 0.5f);
const float exponent = static_cast<float>(n);
const float r = RAdd(RAdd(arg.hi, RMul(exponent, -0.693145751953125f)),
RAdd(arg.lo, RMul(exponent, -1.4286068203094172e-6f)));
if (r < -0.36f || r > 0.36f || n < -126 || n > 0) return RefineGeluLarge(value);
const int32_t result = TryGeluRound(a, ApproxExpReduced(r, n), negative, approximate, 2.0e-6f);
if (result >= 0) return static_cast<uint16_t>(result);
return RefineGeluLarge(value);
}
}
namespace p4 {
using namespace direct_core;
using namespace AscendC;
using public_gmg::Buffer;
using public_gmg::BankStableEpilogue;
template <uint32_t Width>
class WideRowsEpilogue {
public:
using ElementScale = BankStableEpilogue::ElementScale;
using LayoutScale = BankStableEpilogue::LayoutScale;
using ElementD = BankStableEpilogue::ElementD;
using LayoutD = BankStableEpilogue::LayoutD;
using Params = BankStableEpilogue::Params;
__aicore__ __forceinline__ WideRowsEpilogue(Arch::Resource &resource) {
const uint32_t yOffset[2] = {0, 16640};
const uint32_t zOffset[2] = {33280, 66304};
const uint32_t m0Offset[2] = {166144, 167424};
const uint32_t m1Offset[2] = {168704, 169984};
for (uint32_t slot = 0; slot < 2; ++slot) {
yb[slot].tensor = resource.ubBuf.GetBufferByByte<uint8_t>(yOffset[slot]);
zb[slot].tensor = resource.ubBuf.GetBufferByByte<uint8_t>(zOffset[slot]);
m0b[slot].tensor = resource.ubBuf.GetBufferByByte<uint8_t>(m0Offset[slot]);
m1b[slot].tensor = resource.ubBuf.GetBufferByByte<uint8_t>(m1Offset[slot]);
}
qb.tensor = resource.ubBuf.GetBufferByByte<uint8_t>(99328);
temp = resource.ubBuf.GetBufferByByte<uint8_t>(132352);
sb[0].tensor = resource.ubBuf.GetBufferByByte<uint8_t>(171520);
sb[1].tensor = resource.ubBuf.GetBufferByByte<uint8_t>(173568);
kb.tensor = resource.ubBuf.GetBufferByByte<uint8_t>(171264);
}
__aicore__ __forceinline__ ~WideRowsEpilogue() {
if (pending.valid) Finish(pending);
for (uint32_t slot = 0; slot < 2; ++slot) {
if (outputPending[slot]) {
WaitFlag<HardEvent::S_MTE2>(slot);
WaitFlag<HardEvent::MTE3_V>(slot);
}
}
PipeBarrier<PIPE_V>();
}
__aicore__ __forceinline__ void UpdateParams(Params const &p) {
plan.n=p.yl.stride(0); scale.SetGlobalBuffer(p.sp); y.SetGlobalBuffer(p.yp);
}
__aicore__ __forceinline__ void operator()(GemmCoord const &shape, GemmCoord const &coord,
GemmCoord const &actual, GlobalTensor<int32_t> const &src, layout::RowMajor const &srcLayout, Arch::CrossCoreFlag &ack) {
const uint32_t perSub=(actual.m()+1)/2;
const uint32_t first=GetSubBlockIdx()*perSub;
const uint32_t end=first+perSub<actual.m()?first+perSub:actual.m();
constexpr uint32_t chunkRows = 4096 / Width;
accumStride = srcLayout.stride(0);
const uint32_t col = coord.n() * shape.n();
for (uint32_t local = first; local < end; local += chunkRows) {
const uint32_t count = min(chunkRows, end - local);
const uint32_t row = coord.m() * shape.m() + local;
accum = src[uint64_t(local) * accumStride];
if (count == chunkRows) Begin<chunkRows>(row, col, count, nextSlot);
else Begin<0>(row, col, count, nextSlot);
if (pending.valid) Finish(pending);
pending = {row, col, count, nextSlot, plan.n, y, true};
nextSlot ^= 1;
}
Arch::Signal<PIPE_MTE2>(ack);
}
private:
struct Pending {
uint32_t row = 0;
uint32_t col = 0;
uint32_t rows = 0;
uint32_t slot = 0;
uint32_t stride = 0;
GlobalTensor<half> output;
bool valid = false;
};
__aicore__ __forceinline__ void MakeRisk(LocalTensor<float> q, uint32_t len, uint32_t slot) {
SetFlag<HardEvent::V_S>(slot);
return;
auto t=temp.ReinterpretCast<float>();
auto d=q;
auto ci=temp.ReinterpretCast<int32_t>();
const uint32_t paddedLen = len;
auto mask0 = m0b[slot].Get<uint8_t>();
auto mask1 = m1b[slot].Get<uint8_t>();
auto low13 = kb.Get<uint16_t>();
Duplicate(kb.Get<int32_t>(), static_cast<int32_t>(0xf8001fffU), 8);
PipeBarrier<PIPE_V>();
BinaryRepeatParams band;
band.dstBlkStride=1; band.src0BlkStride=1; band.src1BlkStride=0;
band.dstRepStride=8; band.src0RepStride=8; band.src1RepStride=0;
const uint32_t repeatCount=paddedLen/64;
const uint32_t firstRepeats=repeatCount>255?255:repeatCount;
And(ci.ReinterpretCast<uint16_t>(),q.ReinterpretCast<uint16_t>(),low13,
static_cast<uint64_t>(128),static_cast<uint8_t>(firstRepeats),band);
if(repeatCount>255){
And(ci.ReinterpretCast<uint16_t>()[255*128],q.ReinterpretCast<uint16_t>()[255*128],low13,
static_cast<uint64_t>(128),static_cast<uint8_t>(repeatCount-255),band);
}
PipeBarrier<PIPE_V>();
const uint32_t maskBytes = paddedLen / 8;
const uint32_t summaryBytes = (maskBytes + 255) / 256 * 256;
const uint32_t clearFrom = maskBytes / 32 * 32;
if (maskBytes != summaryBytes) {
Duplicate(m0b[slot].Get<uint16_t>()[clearFrom / 2], uint16_t(0), (summaryBytes - clearFrom) / 2);
}
Adds(t, t, -2.0009765625f, paddedLen);
PipeBarrier<PIPE_V>();
Abs(t, t, paddedLen);
PipeBarrier<PIPE_V>();
Compares(mask0, t, 9.5367431640625e-7f, CMPMODE::LE, paddedLen);
PipeBarrier<PIPE_V>();
Abs(d, q, paddedLen);
PipeBarrier<PIPE_V>();
Mins(d, d, 0.00006103515625f, paddedLen);
PipeBarrier<PIPE_V>();
Adds(t, d, 0.00006103515625f, paddedLen);
PipeBarrier<PIPE_V>();
And(t.ReinterpretCast<uint16_t>(),t.ReinterpretCast<uint16_t>(),low13,
static_cast<uint64_t>(128),static_cast<uint8_t>(firstRepeats),band);
if(repeatCount>255){
And(t.ReinterpretCast<uint16_t>()[255*128],t.ReinterpretCast<uint16_t>()[255*128],low13,
static_cast<uint64_t>(128),static_cast<uint8_t>(repeatCount-255),band);
}
PipeBarrier<PIPE_V>();
Adds(t, t, -3.053247928619384765625e-5f, paddedLen);
PipeBarrier<PIPE_V>();
Abs(t, t, paddedLen);
Axpy(t, d, -4.0e-6f, paddedLen);
PipeBarrier<PIPE_V>();
Compares(mask1, t, 4.0e-12f, CMPMODE::LE, paddedLen);
PipeBarrier<PIPE_V>();
Or(m0b[slot].Get<uint16_t>(), m0b[slot].Get<uint16_t>(), m1b[slot].Get<uint16_t>(), (paddedLen + 15) / 16);
const uint32_t maskScalarWords = (len + 63) / 64;
const uint32_t summaryS32Count = maskScalarWords * 2;
const uint32_t summaryCompareCount = (summaryS32Count + 63) / 64 * 64;
PipeBarrier<PIPE_V>();
Compares(m1b[slot].Get<uint8_t>(), m0b[slot].Get<int32_t>(), static_cast<int32_t>(0),
CMPMODE::EQ, summaryCompareCount);
SetFlag<HardEvent::V_S>(slot);
}
__aicore__ __forceinline__ void Finish(const Pending &tile) {
constexpr uint32_t vn = Width;
const uint32_t slot = tile.slot;
const uint32_t len = tile.rows * vn;
const uint32_t summaryS32Count = len / 32;
const auto z = zb[slot].Get<float>();
WaitFlag<HardEvent::V_S>(slot);
auto corrections = yb[slot].Get<uint16_t>();
auto words = m0b[slot].Get<uint64_t>();
auto wordSummary = m1b[slot].Get<uint64_t>();
(void)wordSummary; (void)words; (void)corrections; (void)summaryS32Count;
SetFlag<HardEvent::S_MTE3>(EVENT_ID0);
WaitFlag<HardEvent::S_MTE3>(EVENT_ID0);
DataCopy(tile.output[uint64_t(tile.row) * tile.stride], yb[slot].Get<half>(), len);
SetFlag<HardEvent::MTE3_V>(slot);
SetFlag<HardEvent::S_MTE2>(slot);
outputPending[slot] = true;
}
template <uint32_t FixedRows>
__aicore__ __forceinline__ void Begin(uint32_t row, uint32_t col, uint32_t rows, uint32_t slot) {
const uint32_t vm = FixedRows == 0 ? rows : FixedRows;
constexpr uint32_t vn = Width;
constexpr uint32_t stride = vn;
const uint32_t len = vm * stride;
auto z = zb[slot].Get<float>();
auto q = qb.Get<float>();
auto s = sb[slot].Get<float>();
auto out = yb[slot].Get<half>();
if (outputPending[slot]) WaitFlag<HardEvent::S_MTE2>(slot);
auto ci = z.ReinterpretCast<int32_t>();
DataCopy(ci, accum, len);
DataCopy(s, scale[col], vn);
SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
if (outputPending[slot]) WaitFlag<HardEvent::MTE3_V>(slot);
Cast(z, ci, RoundMode::CAST_RINT, len);
PipeBarrier<PIPE_V>();
BinaryRepeatParams br;
br.dstBlkStride = 1; br.src0BlkStride = 1; br.src1BlkStride = 1;
br.dstRepStride = stride / 8; br.src0RepStride = stride / 8; br.src1RepStride = 0;
for (uint32_t col = 0; col < stride; col += 64) {
const uint64_t mask = stride - col < 64 ? stride - col : 64;
Mul(z[col], z[col], s[col], mask, static_cast<uint8_t>(vm), br);
}
PipeBarrier<PIPE_V>();
Mul(q, z, z, len);
PipeBarrier<PIPE_V>();
Mul(q, q, z, len);
PipeBarrier<PIPE_V>();
Axpy(q, z, 22.363860002236386f, len);
PipeBarrier<PIPE_V>();
Muls(q, q, -0.07135481627260025f, len);
PipeBarrier<PIPE_V>();
Mins(q, q, 87.0f, len);
PipeBarrier<PIPE_V>();
Exp(q, q, len);
PipeBarrier<PIPE_V>();
Adds(q, q, 1.0f, len);
PipeBarrier<PIPE_V>();
Div(q, z, q, len);
PipeBarrier<PIPE_V>();
Cast(out, q, RoundMode::CAST_RINT, len);
PipeBarrier<PIPE_V>();
MakeRisk(q, len, slot);
}
Pending pending;
uint32_t nextSlot = 0;
bool outputPending[2] = {false, false};
uint32_t accumStride;
struct { uint32_t n; } plan;
GlobalTensor<float> scale;
GlobalTensor<half> y;
GlobalTensor<int32_t> accum;
LocalTensor<uint8_t> temp;
Buffer zb[2], yb[2], m0b[2], m1b[2];
Buffer sb[2];
Buffer qb, kb;
};
template <uint32_t Rows>
using CubeBase = DirectInt8Block<GemmShape<Rows, 256, 256>, GemmShape<Rows, 256, 128>>;
template <uint32_t Rows>
class Cube : public CubeBase<Rows> {
using Base = CubeBase<Rows>;
public:
using typename Base::ArchTag;
using typename Base::ElementA;
using typename Base::ElementB;
using typename Base::ElementC;
using typename Base::ElementAccumulator;
using typename Base::LayoutA;
using typename Base::LayoutB;
using typename Base::LayoutC;
using typename Base::LayoutAInL1;
using typename Base::LayoutBInL1;
using typename Base::LayoutAInL0;
using typename Base::LayoutBInL0;
using typename Base::LayoutCInL0;
using Base::l1ATensorList, Base::l1BTensorList, Base::l1AEventList, Base::l1BEventList;
using Base::l0ATensorList, Base::l0BTensorList, Base::l0CTensor;
using Base::l0AListId, Base::l0BListId, Base::l0AEventList, Base::l0BEventList;
using Base::copyGmToL1A, Base::copyGmToL1B, Base::copyL1ToL0A, Base::tileMmad, Base::copyL0CToGm;
DIRECT_DEVICE explicit Cube(Arch::Resource& resource) : Base(resource) {
if constexpr (Rows <= 64) {
secondC = resource.l0CBuf.template GetBufferByByte<ElementAccumulator>(Rows * 256 * sizeof(ElementAccumulator));
SetFlag<HardEvent::FIX_M>(EVENT_ID1);
}
}
DIRECT_DEVICE ~Cube() {
if constexpr (Rows <= 64) WaitFlag<HardEvent::FIX_M>(EVENT_ID1);
}
DIRECT_DEVICE void Load(const GlobalTensor<ElementA>& gmA, const LayoutA& layoutA,
const GlobalTensor<ElementB>& gmB, const LayoutB& layoutB, const GemmCoord& shape,
uint32_t slot, uint32_t weightSlot, bool first) {
const auto aL1 = LayoutAInL1::template MakeLayout<ElementA>(Rows, 256);
const auto bL1 = LayoutBInL1::template MakeLayout<ElementB>(256, 256);
WaitFlag<HardEvent::MTE1_MTE2>(l1AEventList[slot]);
copyGmToL1A(l1ATensorList[slot], gmA, aL1, layoutA.GetTileLayout(shape.GetCoordMK()));
SetFlag<HardEvent::MTE2_MTE1>(l1AEventList[slot]);
if (first) {
WaitFlag<HardEvent::MTE1_MTE2>(l1BEventList[weightSlot]);
copyGmToL1B(l1BTensorList[weightSlot], gmB, bL1, layoutB.GetTileLayout(shape.GetCoordKN()));
SetFlag<HardEvent::MTE2_MTE1>(l1BEventList[weightSlot]);
}
}
DIRECT_DEVICE void Compute(const GlobalTensor<ElementC>& gmC, const LayoutC& layoutC,
const GemmCoord& shape, uint32_t slot, uint32_t weightSlot, uint16_t waitFlag, bool first, bool last) {
const uint32_t m = RoundUp<16>(shape.m());
const auto aL1 = LayoutAInL1::template MakeLayout<ElementA>(Rows, 256);
const auto bL1 = LayoutBInL1::template MakeLayout<ElementB>(256, 256);
const auto cL0 = LayoutCInL0::MakeLayoutInL0C(MakeCoord(m, 256U));
const bool useSecond = Rows <= 64 && slot == 1;
const auto accumulator = useSecond ? secondC : l0CTensor;
const uint32_t event = useSecond ? EVENT_ID1 : EVENT_ID0;
WaitFlag<HardEvent::FIX_M>(event);
WaitFlag<HardEvent::MTE2_MTE1>(l1AEventList[slot]);
if (first) WaitFlag<HardEvent::MTE2_MTE1>(l1BEventList[weightSlot]);
for (uint32_t k = 0; k < shape.k(); k += 128) {
const uint32_t count = min(128U, shape.k() - k);
const auto aL0 = LayoutAInL0::template MakeLayout<ElementA>(m, count);
const auto bL0 = LayoutBInL0::template MakeLayout<ElementB>(count, 256);
const auto a = l0ATensorList[l0AListId];
const auto b = l0BTensorList[l0BListId];
WaitFlag<HardEvent::M_MTE1>(l0AEventList[l0AListId]);
copyL1ToL0A(a, l1ATensorList[slot][aL1.GetOffset(MatrixCoord{0U, k})], aL0, aL1);
WaitFlag<HardEvent::M_MTE1>(l0BEventList[l0BListId]);
const auto panel = l1BTensorList[weightSlot][bL1.GetOffset(MatrixCoord{k, 0U})];
LoadData2dTransposeParams load{};
load.repeatTimes = count / 32;
load.srcStride = 1;
load.dstGap = bL0.rowBlockPitch / 512 - 1;
for (uint32_t col = 0; col < 8; ++col)
LoadDataWithTranspose(b[col * 2 * 512U], panel[col * bL1.columnPitch], load);
if (k + 128 >= shape.k()) {
SetFlag<HardEvent::MTE1_MTE2>(l1AEventList[slot]);
if (last) SetFlag<HardEvent::MTE1_MTE2>(l1BEventList[weightSlot]);
}
SetFlag<HardEvent::MTE1_M>(EVENT_ID0);
WaitFlag<HardEvent::MTE1_M>(EVENT_ID0);
tileMmad(accumulator, a, b, m, 256U, count, k == 0, 0);
SetFlag<HardEvent::M_MTE1>(l0AEventList[l0AListId]);
SetFlag<HardEvent::M_MTE1>(l0BEventList[l0BListId]);
l0AListId ^= 1;
l0BListId ^= 1;
}
if (waitFlag != 0xffff) AscendC::CrossCoreWaitFlag(waitFlag);
SetFlag<HardEvent::M_FIX>(event);
WaitFlag<HardEvent::M_FIX>(event);
copyL0CToGm(gmC, accumulator, layoutC.GetTileLayout(shape.GetCoordMN()), cL0);
SetFlag<HardEvent::FIX_M>(event);
}
private:
LocalTensor<ElementAccumulator> secondC;
};
template <uint32_t Rows, uint32_t Stages>
class RowKernel {
static constexpr uint32_t Width = 256;
static constexpr uint32_t TileElements = Rows * Width;
struct Task {
uint32_t row, rows, expert;
};
public:
DIRECT_DEVICE RowKernel(GM_ADDR x, GM_ADDR w, GM_ADDR scale, GM_ADDR groups, GM_ADDR y,
GM_ADDR scratch, gmg::Plan plan) : scalePtr(reinterpret_cast<__gm__ float*>(scale)),
outputPtr(reinterpret_cast<__gm__ half*>(y)), experts(plan.e), m(plan.m), k(plan.k) {
const uint32_t subblocks = AscendC::GetSubBlockNum();
if constexpr (g_coreType == AscendC::AIC) core = AscendC::GetBlockIdx();
else core = AscendC::GetBlockIdx() / subblocks;
cores = AscendC::GetBlockNum();
input.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
weights.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(w));
groupEnds.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups));
workspace.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(scratch));
for (uint32_t i = 0; i < Stages; ++i) {
produced[i] = Arch::CrossCoreFlag(i * 2);
consumed[i] = Arch::CrossCoreFlag(i * 2 + 1);
}
}
template <int32_t CoreType = g_coreType>
DIRECT_DEVICE void Run() {
if constexpr (CoreType == AscendC::AIC) RunCube();
else RunVector();
}
private:
class RowCursor {
public:
DIRECT_DEVICE RowCursor(const GlobalTensor<int64_t>& groups, uint32_t experts,
uint32_t first, uint32_t last) : ends(groups), row(first), stop(last) {
if (row >= stop) return;
uint32_t high = experts;
while (expert < high) {
const uint32_t middle = (expert + high) / 2;
if (ends.GetValue(middle) <= row) expert = middle + 1;
else high = middle;
}
groupEnd = static_cast<uint32_t>(ends.GetValue(expert));
}
DIRECT_DEVICE bool Next(Task& task) {
if (row >= stop) return false;
while (row == groupEnd) groupEnd = static_cast<uint32_t>(ends.GetValue(++expert));
const uint32_t rows = min(Rows, min(stop, groupEnd) - row);
task = {row, rows, expert};
row += rows;
return true;
}
private:
const GlobalTensor<int64_t>& ends;
uint32_t row, stop;
uint32_t expert = 0, groupEnd = 0;
};
DIRECT_DEVICE RowCursor Cursor() {
constexpr uint32_t grain = 64;
const uint32_t grains = (m + grain - 1) / grain;
const uint32_t first = min(m, grains * core / cores * grain);
const uint32_t last = min(m, grains * (core + 1) / cores * grain);
return RowCursor(groupEnds, experts, first, last);
}
DIRECT_DEVICE GlobalTensor<int32_t> C(uint32_t stage) {
return workspace[(core * Stages + stage) * TileElements];
}
DIRECT_DEVICE void Prefetch(Cube<Rows>& cube, Task task, uint32_t slot, uint32_t weightSlot, bool first) {
const layout::RowMajor xLayout{m, k};
const layout::RowMajor wLayout{k, Width};
cube.Load(input[uint64_t(task.row) * k], xLayout, weights[uint64_t(task.expert) * k * Width],
wLayout, GemmCoord{task.rows, Width, k}, slot, weightSlot, first);
}
DIRECT_DEVICE void RunCube() {
ICachePreLoad(1);
auto rows = Cursor();
Task current{};
if (!rows.Next(current)) return;
Cube<Rows> cube(resource);
uint32_t weightSlot = 0;
bool first = true;
Prefetch(cube, current, 0, weightSlot, first);
uint32_t count = 0;
for (bool more = true; more; ++count) {
Task next{};
more = rows.Next(next);
const bool last = !more || next.expert != current.expert;
const uint32_t nextWeightSlot = last ? (weightSlot ^ 1) : weightSlot;
if (more) Prefetch(cube, next, (count + 1) % 2, nextWeightSlot, last);
const uint32_t stage = count % Stages;
const uint16_t wait = count >= Stages ? consumed[stage].id : 0xffff;
cube.Compute(C(stage), layout::RowMajor{Rows, Width}, GemmCoord{current.rows, Width, k},
count % 2, weightSlot, wait, first, last);
Arch::Signal<PIPE_FIX>(produced[stage]);
current = next;
weightSlot = nextWeightSlot;
first = last;
}
const uint32_t pending = min(count, Stages);
for (uint32_t i = count - pending; i < count; ++i)
Arch::Wait(consumed[i % Stages]);
PipeBarrier<PIPE_ALL>();
}
DIRECT_DEVICE void RunVector() {
ICachePreLoad(1);
auto rows = Cursor();
WideRowsEpilogue<Width> epilogue(resource);
Task task{};
for (uint32_t i = 0; rows.Next(task); ++i) {
epilogue.UpdateParams({scalePtr + uint64_t(task.expert) * Width, layout::VectorLayout{Width},
outputPtr + uint64_t(task.row) * Width, layout::RowMajor{task.rows, Width}});
const uint32_t stage = i % Stages;
Arch::Wait(produced[stage]);
epilogue(GemmCoord{Rows, Width, k}, GemmCoord{0, 0, 0}, GemmCoord{task.rows, Width, k},
C(stage), layout::RowMajor{task.rows, Width}, consumed[stage]);
}
PipeBarrier<PIPE_ALL>();
}
Arch::Resource resource;
Arch::CrossCoreFlag produced[Stages], consumed[Stages];
GlobalTensor<int8_t> input, weights;
GlobalTensor<int64_t> groupEnds;
GlobalTensor<int32_t> workspace;
__gm__ float* scalePtr;
__gm__ half* outputPtr;
uint32_t experts, m, k, core, cores;
};
}
extern "C" __global__ __aicore__ void grouped_matmul_gelu_many_experts(
GM_ADDR, GM_ADDR, GM_ADDR, GM_ADDR, GM_ADDR, GM_ADDR, gmg::Plan);
extern "C" __global__ __aicore__ void grouped_matmul_gelu_p4r_special(
GM_ADDR, GM_ADDR, GM_ADDR, GM_ADDR, GM_ADDR, GM_ADDR, gmg::Plan);
extern "C" __global__ __aicore__ void grouped_matmul_gelu_case1_norisk(
GM_ADDR, GM_ADDR, GM_ADDR, GM_ADDR, GM_ADDR, GM_ADDR, gmg::Plan);
inline void LaunchPublicGmg(GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR g, GM_ADDR y,
uint32_t e, uint32_t m, uint32_t k, uint32_t n, uint32_t blocks, aclrtStream stream) {
uint8_t *workspace = nullptr;
uint64_t ffts = 0;
uint32_t fftsLen = 0;
if (rtGetC2cCtrlAddr(&ffts, &fftsLen) != 0)
throw std::runtime_error("FFTS address unavailable");
if (e > 0 && m % e == 0 && m / e == 64 && n >= 512 && k >= 2 * n && blocks > e)
blocks = e + 1;
public_gmg::GroupedKernel::Arguments args{
direct_core::GemmCoord{m, n, k}, e, blocks, g, x, w, s, y};
const bool descriptorStream=(uint64_t(m)+e-1)/e<=64 &&
uint64_t((m+127)/128)*((n+255)/256)>=uint64_t(2)*blocks;
const auto bytes = public_gmg::GroupedKernel::GetWorkspaceSize(args)+
(descriptorStream?uint64_t(2)*blocks*512:0);
if (aclrtMalloc(reinterpret_cast<void **>(&workspace), bytes, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS)
throw std::runtime_error("Public GMM workspace allocation failed");
gmg::Plan p{};
p.e=e; p.m=m; p.k=k; p.n=n; p.blocks=blocks; p.backend=1; p.ffts=ffts;
uint64_t bankUb=0;
auto*bankPlatform=platform_ascendc::PlatformAscendCManager::GetInstance();
if(bankPlatform)bankPlatform->GetCoreMemSize(platform_ascendc::CoreMemType::UB,bankUb);
bool c224K640 = false;
if (k > 1024 && k <= 8192 &&
(uint64_t(k) + 639) / 640 < (uint64_t(k) + 511) / 512 &&
bankUb >= 184384ULL && !descriptorStream && bankPlatform) {
uint64_t c224K640L1 = 0;
bankPlatform->GetCoreMemSize(platform_ascendc::CoreMemType::L1, c224K640L1);
c224K640 = c224K640L1 >= 2ULL * (128 + 256) * 640;
}
const bool teammateCase1Work=uint64_t(m)<uint64_t(128)*e && n>=512 && n%256==0 &&
k%32==0 && uint64_t(k)>=uint64_t(2)*n;
uint64_t case1L1=0,case1L0A=0,case1L0B=0,case1L0C=0;
if(teammateCase1Work && bankPlatform){
bankPlatform->GetCoreMemSize(platform_ascendc::CoreMemType::L1,case1L1);
bankPlatform->GetCoreMemSize(platform_ascendc::CoreMemType::L0_A,case1L0A);
bankPlatform->GetCoreMemSize(platform_ascendc::CoreMemType::L0_B,case1L0B);
bankPlatform->GetCoreMemSize(platform_ascendc::CoreMemType::L0_C,case1L0C);
}
const bool teammateCase4Work=blocks>=8 && e>=64 && uint64_t(m)>=uint64_t(32)*e &&
uint64_t(m)<=uint64_t(128)*e && k>=128 && k<=256 && k%32==0 && n==256;
uint64_t case4L1=0,case4L0A=0,case4L0B=0,case4L0C=0;
if(teammateCase4Work && bankPlatform){
bankPlatform->GetCoreMemSize(platform_ascendc::CoreMemType::L1,case4L1);
bankPlatform->GetCoreMemSize(platform_ascendc::CoreMemType::L0_A,case4L0A);
bankPlatform->GetCoreMemSize(platform_ascendc::CoreMemType::L0_B,case4L0B);
bankPlatform->GetCoreMemSize(platform_ascendc::CoreMemType::L0_C,case4L0C);
}
public_gmg::BalancedRotationPlan route{};
const uint64_t minimumTasks = uint64_t((m + 127) / 128) * ((n + 255) / 256);
if (n % 256 != 0 && minimumTasks >= uint64_t(2) * blocks) {
route.lowerRows = m / e;
route.upperRows = route.lowerRows + (m % e != 0);
if (route.lowerRows > 0) {
auto originalRotation = [&](uint32_t rows) -> uint32_t {
const uint64_t loops = uint64_t((rows + 127) / 128) * ((n + 255) / 256);
const bool mixedTileCost = rows % 128 != 0 || (n > 256 && n % 256 != 0);
if (rows <= 64 || (rows <= 128 && !c224K640) ||
loops <= 1 || loops >= blocks || !mixedTileCost) return 0;
if (c224K640 && rows <= 128 && n % 256 <= 64 &&
(route.lowerRows + 15) / 16 == (route.upperRows + 15) / 16) {
uint32_t a = static_cast<uint32_t>(loops) - 1, b = blocks;
while (b != 0) { const uint32_t rem = a % b; a = b; b = rem; }
if (a == 1) return blocks - 1;
}
for (uint32_t rotation = 1; rotation < blocks; ++rotation) {
uint32_t a = static_cast<uint32_t>(loops) + rotation, b = blocks;
while (b != 0) { const uint32_t rem = a % b; a = b; b = rem; }
if (a == 1) return rotation;
}
return 0;
};
route.rotationLow = originalRotation(route.lowerRows);
route.rotationHigh = route.upperRows == route.lowerRows ? route.rotationLow :
originalRotation(route.upperRows);
}
}
if(teammateCase1Work && bankUb>=195648ULL && case1L1>=491520ULL &&
case1L0A>=16384ULL && case1L0B>=65536ULL && case1L0C>=131072ULL){
grouped_matmul_gelu_case1_norisk<<<blocks,nullptr,stream>>>(x,w,s,g,y,workspace,p);
} else if(teammateCase4Work && bankUb>=175616ULL && case4L1>=147456ULL &&
case4L0A>=8192ULL && case4L0B>=65536ULL && case4L0C>=65536ULL){
if(case4L1>=2ULL*(64+256)*256 && case4L0A>=2ULL*64*128 &&
case4L0B>=2ULL*128*256 && case4L0C>=2ULL*64*256*4)
grouped_matmul_gelu_p4r_special<<<blocks,nullptr,stream>>>(x,w,s,g,y,workspace,p);
else
grouped_matmul_gelu_many_experts<<<blocks,nullptr,stream>>>(x,w,s,g,y,workspace,p);
} else if (c224K640) {
if (route.rotationLow || route.rotationHigh) {
const bool c234NoPrescan = blocks > 1 &&
route.lowerRows >= 65 && route.upperRows <= 128 &&
(route.lowerRows + 15) / 16 == (route.upperRows + 15) / 16 &&
n % 256 >= 1 && n % 256 <= 64 &&
route.rotationLow == blocks - 1 && route.rotationHigh == blocks - 1;
if (c234NoPrescan)
grouped_matmul_gelu_c234_original_rotation_no_prescan<<<blocks,nullptr,stream>>>(x,w,s,g,y,workspace,p,route);
else
grouped_matmul_gelu_c224_k640_balanced_rotation<<<blocks,nullptr,stream>>>(x,w,s,g,y,workspace,p,route);
} else
if(k>4096 && n>256 && (n+191)/192==(n+255)/256 &&
((uint64_t(m)+127*std::min<uint64_t>(e,m))/128)*((n+191)/192)<=blocks){
uint64_t l1=0,a=0,b=0,c=0;
bankPlatform->GetCoreMemSize(platform_ascendc::CoreMemType::L1,l1);
bankPlatform->GetCoreMemSize(platform_ascendc::CoreMemType::L0_A,a);
bankPlatform->GetCoreMemSize(platform_ascendc::CoreMemType::L0_B,b);
bankPlatform->GetCoreMemSize(platform_ascendc::CoreMemType::L0_C,c);
if(l1>=512000ULL && a>=65536ULL && b>=65536ULL && c>=131072ULL)
{
const bool allowDeep=k<=8192 && uint64_t(m)>uint64_t(128)*e && uint64_t(m)<=uint64_t(192)*e &&
uint64_t(e)*((n+95)/96)<=blocks && uint64_t(4)*e*(n/96)>=uint64_t(3)*blocks && l1>=516096ULL;
p.backend=allowDeep?3:2;
grouped_matmul_gelu_c0675_two_route<<<blocks,nullptr,stream>>>(x,w,s,g,y,workspace,p);
}
else grouped_matmul_gelu_c224_k640<<<blocks,nullptr,stream>>>(x,w,s,g,y,workspace,p);
}else grouped_matmul_gelu_c224_k640<<<blocks,nullptr,stream>>>(x,w,s,g,y,workspace,p);
} else if (route.rotationLow || route.rotationHigh) {
if (bankUb >= 184384ULL)
grouped_matmul_gelu_bank_balanced_rotation<<<blocks,nullptr,stream>>>(x,w,s,g,y,workspace,p,route);
else
grouped_matmul_gelu_balanced_rotation<<<blocks,nullptr,stream>>>(x,w,s,g,y,workspace,p,route);
} else if(bankUb>=184384ULL && descriptorStream){
grouped_matmul_gelu_descriptor_stream<<<blocks,nullptr,stream>>>(x,w,s,g,y,workspace,p);
} else if (bankUb >= 184384ULL) {
bool packedB=false && bankPlatform && k>1024 && k<=2048 && k%32==0 &&
n>=512 && n<=1024 && n%256==0 && uint64_t(m)>=uint64_t(65)*e && minimumTasks>=blocks;
uint64_t packedL1=0,packedL0A=0,packedL0B=0,packedL0C=0;
if(packedB){
bankPlatform->GetCoreMemSize(platform_ascendc::CoreMemType::L1,packedL1);
bankPlatform->GetCoreMemSize(platform_ascendc::CoreMemType::L0_A,packedL0A);
bankPlatform->GetCoreMemSize(platform_ascendc::CoreMemType::L0_B,packedL0B);
bankPlatform->GetCoreMemSize(platform_ascendc::CoreMemType::L0_C,packedL0C);
packedB=packedL1>=393216ULL && packedL0A>=65536ULL && packedL0B>=65536ULL && packedL0C>=131072ULL;
}
if(packedB)
grouped_matmul_gelu_b_k32_ndpack_private<<<blocks,nullptr,stream>>>(x,w,s,g,y,workspace,p);
else
grouped_matmul_gelu_bank<<<blocks,nullptr,stream>>>(x,w,s,g,y,workspace,p);
} else {
LaunchGmgMixed(x,w,s,g,y,workspace,nullptr,0,p,stream);
}
const auto status = aclrtSynchronizeStream(stream);
aclrtFree(workspace);
if (status != ACL_SUCCESS) throw std::runtime_error("Public GMM kernel failed");
}
inline bool TryLaunchSmallRawRowParallel(GM_ADDR x,GM_ADDR w,GM_ADDR s,GM_ADDR y,
int64_t e,int64_t m,int64_t k,int64_t n,int64_t cores,aclrtStream stream) {
if(e!=1 || m<=16 || m>64 || n>128 || k>128 || n%32 || k%32 || cores<1)return false;
auto *platform=platform_ascendc::PlatformAscendCManager::GetInstance();
if(!platform)return false;
const uint32_t blocks=static_cast<uint32_t>((m+15)/16);
if(cores<blocks || platform->GetCoreNumAic()<blocks ||
platform->GetCoreNumAiv()<2*blocks)return false;
const uint32_t pm=static_cast<uint32_t>((m+15)/16*16);
uint64_t l1=0,a=0,b=0,c=0,ub=0;
platform->GetCoreMemSize(platform_ascendc::CoreMemType::L1,l1);
platform->GetCoreMemSize(platform_ascendc::CoreMemType::L0_A,a);
platform->GetCoreMemSize(platform_ascendc::CoreMemType::L0_B,b);
platform->GetCoreMemSize(platform_ascendc::CoreMemType::L0_C,c);
platform->GetCoreMemSize(platform_ascendc::CoreMemType::UB,ub);
if(uint64_t(pm+n)*k>l1 || uint64_t(pm)*k>a || uint64_t(n)*k>b ||
uint64_t(pm)*n*4>c || ub<184384ULL)return false;
uint64_t ffts=0;uint32_t fftsLen=0;
if(rtGetC2cCtrlAddr(&ffts,&fftsLen)!=0)throw std::runtime_error("Small Raw row FFTS address unavailable");
uint8_t *scratch=nullptr;
if(aclrtMalloc(reinterpret_cast<void**>(&scratch),uint64_t(m)*n*4,ACL_MEM_MALLOC_HUGE_FIRST)!=ACL_SUCCESS)
throw std::runtime_error("Small Raw row C allocation failed");
small_raw_r14::Plan p{static_cast<uint32_t>(m),static_cast<uint32_t>(n),
static_cast<uint32_t>(k),16,ffts};
grouped_matmul_gelu_small_raw_row_parallel<<<blocks,nullptr,stream>>>(x,w,s,y,scratch,p);
const auto status=aclrtSynchronizeStream(stream);aclrtFree(scratch);
if(status!=ACL_SUCCESS)throw std::runtime_error("Small Raw row-parallel MMAD failed");
return true;
}
inline bool TryLaunchSmallRawSingle(GM_ADDR x,GM_ADDR w,GM_ADDR s,GM_ADDR y,
int64_t e,int64_t m,int64_t k,int64_t n,int64_t cores,aclrtStream stream) {
