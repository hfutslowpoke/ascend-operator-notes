direct_core::GemmCoord{plan.m,plan.n,plan.k},plan.e,groups,
x,direct_core::layout::RowMajor{plan.m,plan.k},w,direct_core::layout::RowMajor{plan.k,plan.n},
scale,direct_core::layout::VectorLayout{plan.n},y,direct_core::layout::RowMajor{plan.m,plan.n},scratch};
b_k32_ndpack_private::Kernel op;op(params);
}
