Kernel::Params a{direct_core::GemmCoord{p.m,p.n,p.k},p.e,g,p.k%32?px:x,direct_core::layout::RowMajor{p.m,p.k,pk},p.n%32?pw:w,direct_core::layout::RowMajor{p.k,p.n,pn},s,direct_core::layout::VectorLayout{p.n},y,direct_core::layout::RowMajor{p.m,p.n},scratch};Kernel op;op(a);
}
inline bool TryLargeMatrices(GM_ADDR x,GM_ADDR w,GM_ADDR s,GM_ADDR g,GM_ADDR y,int64_t e,int64_t m,int64_t k,int64_t n,int64_t cores,aclrtStream stream){
if(uint64_t(m)*k>134217728 || m<256*e || k<1024 || k>8192 || n<512 || n>4096 || cores<1)return false;
auto*hw=platform_ascendc::PlatformAscendCManager::GetInstance();if(!hw)return false;
uint64_t l1=0,ub=0,c=0;hw->GetCoreMemSize(platform_ascendc::CoreMemType::L1,l1);hw->GetCoreMemSize(platform_ascendc::CoreMemType::UB,ub);hw->GetCoreMemSize(platform_ascendc::CoreMemType::L0_C,c);if(l1<393216 || ub<184384 || c<131072)return false;
uint32_t blocks=std::min<int64_t>(cores,std::min<int64_t>(hw->GetCoreNumAic(),hw->GetCoreNumAiv()/2));if(!blocks)return false;
uint64_t ffts=0;uint32_t len=0;if(rtGetC2cCtrlAddr(&ffts,&len))throw std::runtime_error("large FFTS");
uint8_t*tmp=nullptr;if(aclrtMalloc(reinterpret_cast<void**>(&tmp),uint64_t(blocks)*2*128*256*4+(n%32?uint64_t(e)*k*((n+255)/256*256):0)+(k%32?uint64_t(m)*((k+255)/256*256):0),ACL_MEM_MALLOC_HUGE_FIRST)!=ACL_SUCCESS)throw std::runtime_error("large scratch");
gmg::Plan p{};p.e=e;p.m=m;p.k=k;p.n=n;p.blocks=blocks;p.ffts=ffts;
grouped_matmul_gelu_large_stream<<<blocks,nullptr,stream>>>(x,w,s,g,y,tmp,p);auto status=aclrtSynchronizeStream(stream);aclrtFree(tmp);if(status!=ACL_SUCCESS)throw std::runtime_error("large failed");return true;}
