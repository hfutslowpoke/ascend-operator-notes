band.dstBlkStride=1; band.src0BlkStride=1; band.src1BlkStride=0;
band.dstRepStride=8; band.src0RepStride=8; band.src1RepStride=0;
const uint32_t repeatCount=paddedLen/64;
const uint32_t firstRepeats=repeatCount>255?255:repeatCount;
And(ci.ReinterpretCast<uint16_t>(),q.ReinterpretCast<uint16_t>(),low13,
static_cast<uint64_t>(128),static_cast<uint8_t>(firstRepeats),band);
if(repeatCount>255){
And(ci.ReinterpretCast<uint16_t>()[255*128],q.ReinterpretCast<uint16_t>()[255*128],low13,
static_cast<uint64_t>(128),static_cast<uint8_t>(repeatCount-255),band);
}
PipeBarrier<PIPE_V>();
Duplicate(m0b.Get<uint16_t>(), static_cast<uint16_t>(0), ((paddedLen + 2047) / 2048) * 128);
Duplicate(m1b.Get<uint16_t>(), static_cast<uint16_t>(0), ((paddedLen + 2047) / 2048) * 128);
PipeBarrier<PIPE_V>();
Compares(mask0, ci.ReinterpretCast<float>(), 2.00097560882568359375f, CMPMODE::GE, paddedLen);
Compares(mask1, ci.ReinterpretCast<float>(), 2.00097751617431640625f, CMPMODE::LE, paddedLen);
PipeBarrier<PIPE_V>();
And(m0b.Get<uint16_t>(), m0b.Get<uint16_t>(), m1b.Get<uint16_t>(), (paddedLen + 15) / 16);
Abs(d, q, paddedLen);
PipeBarrier<PIPE_V>();
Mins(d, d, 0.00006103515625f, paddedLen);
PipeBarrier<PIPE_V>();
Adds(t, d, 0.00006103515625f, paddedLen);
PipeBarrier<PIPE_V>();
And(t.ReinterpretCast<uint16_t>(),t.ReinterpretCast<uint16_t>(),low13,
static_cast<uint64_t>(128),static_cast<uint8_t>(firstRepeats),band);
if(repeatCount>255){
And(t.ReinterpretCast<uint16_t>()[255*128],t.ReinterpretCast<uint16_t>()[255*128],low13,
static_cast<uint64_t>(128),static_cast<uint8_t>(repeatCount-255),band);
