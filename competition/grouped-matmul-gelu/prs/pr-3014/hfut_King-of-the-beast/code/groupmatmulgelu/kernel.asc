using LayoutScale = BankStableEpilogue::LayoutScale;
using ElementD = BankStableEpilogue::ElementD;
using LayoutD = BankStableEpilogue::LayoutD;
using Params = BankStableEpilogue::Params;
__aicore__ __forceinline__ Case1NoRiskRetainedEpilogue(Arch::Resource &resource) {
Buffer *buffers[] = {&zb,&qb,&tb,&db,&sb,&yb,&m0b,&m1b,&kb};
const uint32_t offsets[] = {0,65792,0,65792,164608,131328,166656,168736,170816};
temp = resource.ubBuf.GetBufferByByte<uint8_t>(171072);
for(uint32_t i=0;i<9;++i)
buffers[i]->tensor=resource.ubBuf.GetBufferByByte<uint8_t>(offsets[i]);
