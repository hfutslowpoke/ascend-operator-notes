extern "C" __global__ __aicore__ void grouped_matmul_gelu_tiny(
GM_ADDR xp, GM_ADDR wp, GM_ADDR sp, GM_ADDR gp, GM_ADDR yp,
uint32_t e, uint32_t m, uint32_t k, uint32_t n, uint32_t blocks) {
KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
using namespace AscendC;
InitSocState();
GlobalTensor<int8_t> x, w;
GlobalTensor<float> scale;
GlobalTensor<int64_t> groups;
GlobalTensor<half> y;
x.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t *>(xp));
w.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t *>(wp));
scale.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(sp));
groups.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t *>(gp));
y.SetGlobalBuffer(reinterpret_cast<__gm__ half *>(yp));
TPipe pipe;
TBuf<TPosition::VECCALC> zb, qb, tb, db, ob;
TBuf<TPosition::VECCALC> axb, bwb, hbb, afb, bfb, reduceb;
pipe.InitBuffer(zb, 32); pipe.InitBuffer(qb, 32);
pipe.InitBuffer(tb, 32); pipe.InitBuffer(db, 32); pipe.InitBuffer(ob, 32);
if (n == 1 && k > 32) {
pipe.InitBuffer(axb, 256); pipe.InitBuffer(bwb, 256);
pipe.InitBuffer(hbb, 1024); pipe.InitBuffer(afb, 1024);
pipe.InitBuffer(bfb, 1024); pipe.InitBuffer(reduceb, 1024);
}
auto z = zb.Get<float>(); auto q = qb.Get<float>();
auto t = tb.Get<float>(); auto d = db.Get<float>(); auto out = ob.Get<half>();
for (uint32_t index = GetBlockIdx(); index < m * n; index += blocks) {
const uint32_t row = index / n, col = index % n;
uint32_t low = 0, high = e;
while (low < high) {
const uint32_t middle = (low + high) / 2;
if (static_cast<uint32_t>(groups.GetValue(middle)) <= row) low = middle + 1;
else high = middle;
}
int32_t dot = 0;
if (n == 1 && k > 32) {
auto ai = axb.Get<int8_t>(); auto bi = bwb.Get<int8_t>();
auto ah = hbb.Get<half>(); auto bh = hbb.Get<half>()[256];
auto af = afb.Get<int32_t>(); auto bf = bfb.Get<int32_t>();
for (uint32_t off = 0; off < k; off += 256) {
const uint32_t count = k - off < 256 ? k - off : 256;
const uint8_t pad = static_cast<uint8_t>((count + 31) / 32 * 32 - count);
DataCopyPad(ai, x[uint64_t(row) * k + off], DataCopyExtParams{1, count, 0, 0, 0},
DataCopyPadExtParams<int8_t>{true, 0, pad, 0});
DataCopyPad(bi, w[uint64_t(low) * k + off], DataCopyExtParams{1, count, 0, 0, 0},
DataCopyPadExtParams<int8_t>{true, 0, pad, 0});
SetFlag<HardEvent::MTE2_V>(EVENT_ID0); WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
Cast(ah, ai, RoundMode::CAST_NONE, count);
Cast(bh, bi, RoundMode::CAST_NONE, count);
PipeBarrier<PIPE_V>();
Duplicate(af, static_cast<int32_t>(0), 256);
Duplicate(bf, static_cast<int32_t>(0), 256);
PipeBarrier<PIPE_V>();
Cast(af, ah, RoundMode::CAST_RINT, count);
Cast(bf, bh, RoundMode::CAST_RINT, count);
PipeBarrier<PIPE_V>();
Mul(af, af, bf, 256); PipeBarrier<PIPE_V>();
for (uint32_t step = 128; step >= 8; step /= 2) {
Add(af, af, af[step], step); PipeBarrier<PIPE_V>();
}
SetFlag<HardEvent::V_S>(EVENT_ID0); WaitFlag<HardEvent::V_S>(EVENT_ID0);
for (uint32_t lane = 0; lane < 8; ++lane) dot += af.GetValue(lane);
PipeBarrier<PIPE_ALL>();
}
} else {
for (uint32_t lane = 0; lane < k; ++lane)
dot += static_cast<int32_t>(x.GetValue(uint64_t(row) * k + lane)) *
static_cast<int32_t>(w.GetValue((uint64_t(low) * k + lane) * n + col));
}
const float value = static_cast<float>(dot) * scale.GetValue(uint64_t(low) * n + col);
float scalarPolynomial = gmg::RMul(value, value);
scalarPolynomial = gmg::RMul(scalarPolynomial, 0.044715f);
scalarPolynomial = gmg::RAdd(scalarPolynomial, 1.0f);
scalarPolynomial = gmg::RMul(scalarPolynomial, value);
gmg::FloatBits scalarExponent;
scalarExponent.f = gmg::RMul(scalarPolynomial, 1.5957691216057308f);
scalarExponent.u |= 0x80000000U;
z.SetValue(0, value);
t.SetValue(0, scalarExponent.f);
SetFlag<HardEvent::S_V>(EVENT_ID0); WaitFlag<HardEvent::S_V>(EVENT_ID0);
Exp(t, t, 1); PipeBarrier<PIPE_V>();
Adds(d, t, 1.0f, 1); PipeBarrier<PIPE_V>();
Abs(q, z, 1); PipeBarrier<PIPE_V>();
Mul(q, q, t, 1); PipeBarrier<PIPE_V>();
Div(q, q, d, 1); PipeBarrier<PIPE_V>();
Maxs(t, z, 0.0f, 1); PipeBarrier<PIPE_V>();
Sub(q, t, q, 1); PipeBarrier<PIPE_V>();
Cast(out, q, RoundMode::CAST_RINT, 1);
SetFlag<HardEvent::V_S>(EVENT_ID0); WaitFlag<HardEvent::V_S>(EVENT_ID0);
const uint32_t bits = qb.Get<uint32_t>().GetValue(0), mag = bits & 0x7fffffff;
if (((bits >> 31) ? mag < 0x38800000 : (mag >= 0x40000000 || mag < 0x38800000)) &&
value > -8.0f && value < 8.0f && gmg::NearHalfBoundary(bits))
ob.Get<uint16_t>().SetValue(0, gmg::RefineGelu(value));
SetFlag<HardEvent::S_MTE3>(EVENT_ID0); WaitFlag<HardEvent::S_MTE3>(EVENT_ID0);
SetFlag<HardEvent::V_MTE3>(EVENT_ID0); WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
DataCopyPad(y[index], out, DataCopyExtParams{1, 2, 0, 0, 0});
PipeBarrier<PIPE_ALL>();
}
}
inline void LaunchGmgMixed(GM_ADDR x, GM_ADDR w, GM_ADDR scale,
GM_ADDR groups, GM_ADDR y, GM_ADDR scratch, GM_ADDR sys,
uint64_t sysPerCore, gmg::Plan p, aclrtStream stream) {
grouped_matmul_gelu_v0<<<p.blocks, nullptr, stream>>>(x, w, scale, groups, y,
scratch, sys, sysPerCore, p);
}
namespace ha_isolated {
using namespace AscendC;
using namespace direct_core;
using public_gmg::Buffer;
using public_gmg::BankStableEpilogue;
__aicore__ __forceinline__ float HalfMagnitude(uint16_t bits) {
if (bits < 1024) return static_cast<float>(static_cast<int32_t>(bits)) * 5.9604644775390625e-8f;
gmg::FloatBits result;
result.u = 0x38000000U + (static_cast<uint32_t>(bits) << 13);
return result.f;
}
__aicore__ __forceinline__ int CompareGeluMidpoint(float a, float tail, bool negative, float midpoint, float errorScale) {
const float delta = gmg::RAdd(a, -midpoint);
const float lhs = negative ? gmg::RMul(delta, tail) : delta;
const float rhs = negative ? midpoint : gmg::RMul(midpoint, tail);
const float residual = gmg::RAdd(lhs, -rhs);
const float bound = gmg::RMul(gmg::RAdd(lhs < 0 ? -lhs : lhs, rhs), errorScale);
if (residual > bound) return 1;
if (residual < -bound) return -1;
return 0;
}
__aicore__ __forceinline__ int32_t TryGeluRound(float a, float tail,
bool negative, uint16_t approximate, float errorScale) {
const uint16_t magnitude = approximate & 0x7fff;
const uint16_t sign = approximate & 0x8000;
const float center = HalfMagnitude(magnitude);
const float upper = HalfMagnitude(magnitude + 1);
const int upperSide = CompareGeluMidpoint(a, tail, negative, (center + upper) * 0.5f, errorScale);
if (upperSide == 0) return -1;
if (upperSide > 0) {
const float next = HalfMagnitude(magnitude + 2);
if (CompareGeluMidpoint(a, tail, negative, (upper + next) * 0.5f, errorScale) < 0)
return sign | (magnitude + 1);
return -1;
}
if (magnitude == 0) return sign;
const float lower = HalfMagnitude(magnitude - 1);
const int lowerSide = CompareGeluMidpoint(a, tail, negative, (center + lower) * 0.5f, errorScale);
if (lowerSide > 0) return approximate;
if (lowerSide < 0) {
if (magnitude == 1 || CompareGeluMidpoint(a, tail, negative,
(lower + HalfMagnitude(magnitude - 2)) * 0.5f, errorScale) > 0)
return sign | (magnitude - 1);
}
return -1;
}
__aicore__ __forceinline__ float ApproxExpReduced(float r, int n) {
using namespace gmg;
float polynomial = 0.001388888888888889f;
polynomial = RAdd(0.008333333333333333f, RMul(r, polynomial));
polynomial = RAdd(0.041666666666666664f, RMul(r, polynomial));
polynomial = RAdd(0.16666666666666666f, RMul(r, polynomial));
polynomial = RAdd(0.5f, RMul(r, polynomial));
polynomial = RAdd(1.0f, RMul(r, polynomial));
polynomial = RAdd(1.0f, RMul(r, polynomial));
FloatBits scale;
scale.u = static_cast<uint32_t>(n + 127) << 23;
return RMul(polynomial, scale.f);
}
__aicore__ __forceinline__ uint16_t RefineGeluGuarded(float value, uint16_t approximate) {
using namespace gmg;
const bool negative = value < 0;
const float a = negative ? -value : value;
const uint16_t magnitude = approximate & 0x7fff;
if (magnitude >= 0x7bfe || a == 0 || (!negative && a >= 7.0f))
return RefineGeluLarge(value);
if (!negative) {
const float x = RMul(RMul(a, -1.5957691216057308f),
RAdd(1.0f, RMul(0.044715f, RMul(a, a))));
const int exp2 = static_cast<int>(RAdd(RMul(x, 1.4426950408889634f), -0.5f));
const float exponent = static_cast<float>(exp2);
const float r = RAdd(RAdd(x, RMul(exponent, -0.693145751953125f)),
RMul(exponent, -1.4286068203094172e-6f));
if (r >= -0.36f && r <= 0.36f && exp2 >= -126 && exp2 <= 0) {
const float expTail = ApproxExpReduced(r, exp2);
const int32_t result = TryGeluRound(a, expTail, false, approximate, 3.0e-6f - x * 2.0e-6f);
if (result >= 0) return static_cast<uint16_t>(result);
}
}
const Wide v{a, 0.0f};
const Wide cube = WMul(WMul(v, v), v);
const Wide arg = WNeg(WMul(WAdd(v, WMul(cube, {0.044714998453855515f, 1.5461444832776117e-09f})),
{1.5957691669464111f, -4.5340680321359628e-08f}));
const int n = static_cast<int>(arg.hi * 1.4426950408889634f - 0.5f);
const float exponent = static_cast<float>(n);
const float r = RAdd(RAdd(arg.hi, RMul(exponent, -0.693145751953125f)),
RAdd(arg.lo, RMul(exponent, -1.4286068203094172e-6f)));
if (r < -0.36f || r > 0.36f || n < -126 || n > 0) return RefineGeluLarge(value);
const int32_t result = TryGeluRound(a, ApproxExpReduced(r, n), negative, approximate, 2.0e-6f);
if (result >= 0) return static_cast<uint16_t>(result);
return RefineGeluLarge(value);
}
class Case1WideFastEpilogue {
