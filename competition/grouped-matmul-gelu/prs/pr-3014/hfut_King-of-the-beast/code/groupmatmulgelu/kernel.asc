scale,direct_core::layout::VectorLayout{plan.n},y,direct_core::layout::RowMajor{plan.m,plan.n},scratch};
public_gmg::C224K640BankBalancedRotationKernel op(route.lowerRows,route.rotationLow,route.rotationHigh);
op(params);
