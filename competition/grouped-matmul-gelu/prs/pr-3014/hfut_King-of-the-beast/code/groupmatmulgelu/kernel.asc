copyGmToL1B(bfull,gb,lb,bl.GetTileLayout(MakeCoord(s.k(),s.n())));
AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(l1BEventList[0]);
AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(l1AEventList[0]);
copyGmToL1A(l1ATensorList[0],ga,la,al.GetTileLayout(MakeCoord(min(s.m(),mstep),s.k())));
AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(l1AEventList[0]);
AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(l1BEventList[0]);
for(uint32_t row=0;row<s.m();row+=mstep){
uint32_t idx=(row/mstep)&1,rows=min(s.m()-row,mstep),mr=RoundUp<16>(rows);auto lc=LayoutCInL0::MakeLayoutInL0C(MakeCoord(mr,nr));
if(row+mstep<s.m()){
uint32_t next=idx^1;AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(l1AEventList[next]);
copyGmToL1A(l1ATensorList[next],ga[uint64_t(row+mstep)*al.stride(0)],la,al.GetTileLayout(MakeCoord(min(s.m()-row-mstep,mstep),s.k())));
AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(l1AEventList[next]);
}
AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(l1AEventList[idx]);AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(EVENT_ID0);
for(uint32_t j=0;j<parts;++j){
uint32_t kk=min(s.k()-j*128,128U);auto l0a=LayoutAInL0::MakeLayout<int8_t>(mr,kk);auto l0b=LayoutBInL0::MakeLayout<int8_t>(kk,nr);auto aa=l0ATensorList[l0AListId],bb=l0BTensorList[l0BListId];
AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(l0AEventList[l0AListId]);copyL1ToL0A(aa,l1ATensorList[idx][la.GetOffset(MatrixCoord{0,j*128})],l0a,la);
if(j+1==parts)AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(l1AEventList[idx]);
AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(l0BEventList[l0BListId]);copyL1ToL0B(bb,bfull[lb.GetOffset(MatrixCoord{j*128,0})],l0b,lb);
AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID0);AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID0);
tileMmad(l0CTensor,aa,bb,mr,nr,kk,j==0,0);
AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(l0AEventList[l0AListId]);AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(l0BEventList[l0BListId]);l0AListId^=1;l0BListId^=1;
}
AscendC::SetFlag<AscendC::HardEvent::M_FIX>(EVENT_ID0);AscendC::WaitFlag<AscendC::HardEvent::M_FIX>(EVENT_ID0);
