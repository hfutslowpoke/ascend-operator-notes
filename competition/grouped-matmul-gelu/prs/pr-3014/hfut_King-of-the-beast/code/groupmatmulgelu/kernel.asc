extern "C" __global__ __aicore__ __attribute__((section(".hel1_opt_20261113")))
void grouped_matmul_gelu_hel1_opt_20261113(GM_ADDR,GM_ADDR,GM_ADDR,GM_ADDR,GM_ADDR,small_raw_r14::Plan,uint32_t,uint32_t);
inline bool TrySmallMatrix(GM_ADDR x,GM_ADDR w,GM_ADDR s,GM_ADDR y,int64_t e,int64_t m,int64_t k,int64_t n,int64_t cores,aclrtStream stream) {
constexpr uint32_t panelM=16,panelN=128;
if(e!=1 || m<=16 || m>64 || n>128 || k>128 || n%32 || k%32 || cores<1)return false;
const uint32_t nt=(n+panelN-1)/panelN;
const uint32_t blocks=((m+panelM-1)/panelM)*nt;
auto *platform=platform_ascendc::PlatformAscendCManager::GetInstance();
if(!platform || cores<blocks || platform->GetCoreNumAic()<blocks || platform->GetCoreNumAiv()<2*blocks)return false;
uint64_t l1=0,a=0,b=0,c=0,ub=0;
platform->GetCoreMemSize(platform_ascendc::CoreMemType::L1,l1);
platform->GetCoreMemSize(platform_ascendc::CoreMemType::L0_A,a);
platform->GetCoreMemSize(platform_ascendc::CoreMemType::L0_B,b);
platform->GetCoreMemSize(platform_ascendc::CoreMemType::L0_C,c);
platform->GetCoreMemSize(platform_ascendc::CoreMemType::UB,ub);
const uint32_t width=n<panelN?n:panelN;
if(l1<18432ULL || a<2048ULL || b<16384ULL || c<8192ULL || ub<184384ULL)return false;
uint64_t ffts=0;uint32_t length=0;
if(rtGetC2cCtrlAddr(&ffts,&length)!=0)throw std::runtime_error("Small matrix FFTS unavailable");
uint8_t *scratch=nullptr;
if(aclrtMalloc(reinterpret_cast<void**>(&scratch),uint64_t(m)*n*4,ACL_MEM_MALLOC_HUGE_FIRST)!=ACL_SUCCESS)throw std::runtime_error("Small matrix workspace allocation failed");
small_raw_r14::Plan p{static_cast<uint32_t>(m),static_cast<uint32_t>(n),static_cast<uint32_t>(k),panelM,ffts};
grouped_matmul_gelu_hel1_opt_20261113<<<blocks,nullptr,stream>>>(x,w,s,y,scratch,p,panelM,panelN);
const auto status=aclrtSynchronizeStream(stream);aclrtFree(scratch);
if(status!=ACL_SUCCESS)throw std::runtime_error("Small matrix tiled kernel failed");
return true;
}
