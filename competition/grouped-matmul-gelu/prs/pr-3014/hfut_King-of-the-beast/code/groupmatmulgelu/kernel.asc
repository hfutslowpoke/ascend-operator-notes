#include "kernel_operator.h"
#include "lib/matmul_intf.h"
#include "tiling/tiling_api.h"
#include "tiling/platform/platform_ascendc.h"
#include <algorithm>
#include <cstdint>
#include <stdexcept>
namespace gmg {
using namespace AscendC;
using namespace matmul;
constexpr uint32_t BM = 64;
constexpr uint32_t BN = 128;
constexpr uint32_t ELEMS = BM * BN;
struct Plan {
AscendC::tiling::TCubeTiling cube;
uint32_t e, m, k, n, blocks;
uint32_t backend;
uint64_t ffts;
};
using A = MatmulType<TPosition::GM, CubeFormat::ND, int8_t, false>;
using B = MatmulType<TPosition::GM, CubeFormat::ND, int8_t, false>;
using C = MatmulType<TPosition::GM, CubeFormat::ND, int32_t>;
using Bias = MatmulType<TPosition::GM, CubeFormat::ND, int32_t>;
struct Wide { float hi, lo; };
union FloatBits { float f; uint32_t u; };
#pragma clang fp contract(off)
#pragma clang fp reassociate(off)
__aicore__ inline float RAdd(float a, float b) { return a + b; }
__aicore__ inline float RMul(float a, float b) { return a * b; }
__aicore__ inline Wide WAdd(Wide a, Wide b) {
const float s = RAdd(a.hi, b.hi);
const float v = RAdd(s, -a.hi);
float e = RAdd(RAdd(a.hi, -RAdd(s, -v)), RAdd(b.hi, -v));
e = RAdd(e, RAdd(a.lo, b.lo));
const float h = RAdd(s, e);
return {h, RAdd(e, -RAdd(h, -s))};
}
__aicore__ inline Wide WNeg(Wide a) { return {-a.hi, -a.lo}; }
__aicore__ inline Wide WSub(Wide a, Wide b) { return WAdd(a, WNeg(b)); }
__aicore__ inline Wide WMul(Wide a, Wide b) {
const float p = RMul(a.hi, b.hi);
const float ca = RMul(4097.0f, a.hi), cb = RMul(4097.0f, b.hi);
const float ah = RAdd(ca, -RAdd(ca, -a.hi)), bh = RAdd(cb, -RAdd(cb, -b.hi));
const float al = RAdd(a.hi, -ah), bl = RAdd(b.hi, -bh);
float e = RAdd(RAdd(RAdd(RAdd(RMul(ah, bh), -p), RMul(ah, bl)), RMul(al, bh)), RMul(al, bl));
e = RAdd(e, RAdd(RMul(a.hi, b.lo), RMul(a.lo, b.hi)));
e = RAdd(e, RMul(a.lo, b.lo));
return WAdd({p, 0.0f}, {e, 0.0f});
}
__aicore__ inline Wide WDiv(Wide a, Wide b) {
const float q = a.hi / b.hi;
const Wide residual = WSub(a, WMul(b, {q, 0.0f}));
return WAdd({q, 0.0f}, {RAdd(residual.hi, residual.lo) / b.hi, 0.0f});
}
__aicore__ inline Wide WExp(Wide x) {
const int n = static_cast<int>(x.hi * 1.4426950408889634f - 0.5f);
const Wide r = WSub(x, WMul({static_cast<float>(n), 0.0f},
{0.69314718246459961f, -1.904654323148236e-09f}));
const Wide coeff[15] = {
{1.0f, 0.0f}, {1.0f, 0.0f}, {0.5f, 0.0f},
{0.1666666716337204f, -4.9670537405344106e-09f},
{0.041666667908430099f, -1.2417634351336027e-09f},
{0.0083333337679505348f, -4.3461720160287154e-10f},
{0.0013888889225199819f, -3.3631092919220174e-11f},
{0.00019841270113829523f, -2.7255968207233472e-12f},
{2.4801587642286904e-05f, -3.406996025904184e-13f},
{2.7557318844628753e-06f, 3.7935713937038186e-14f},
{2.755731998149713e-07f, -7.5751124208094317e-15f},
{2.5052107943679403e-08f, 4.4176231769972645e-16f},
{2.0876755879584152e-09f, 1.1082839478332097e-16f},
{1.6059044372074283e-10f, -5.3525266925084846e-18f},
{1.147074536050896e-11f, 2.372207640763624e-19f}
};
Wide sum = coeff[14];
for (int i = 13; i >= 0; --i) sum = WAdd(WMul(sum, r), coeff[i]);
FloatBits power;
power.u = static_cast<uint32_t>(n + 127) << 23;
return WMul(sum, {power.f, 0.0f});
}
__aicore__ inline uint16_t RoundWideHalf(Wide a) {
FloatBits bits;
bits.f = a.hi;
const uint32_t sign = bits.u >> 31;
const uint32_t mag = bits.u & 0x7fffffff;
const uint32_t exponent = mag >> 23;
if (exponent < 101) return static_cast<uint16_t>(sign << 15);
const uint32_t shift = exponent >= 113 ? 13 : 126 - exponent;
const uint32_t significand = exponent >= 113 ? mag : ((mag & 0x7fffff) | 0x800000);
uint32_t rounded = exponent >= 113 ? (mag - 0x38000000) >> 13 : significand >> shift;
const uint32_t rem = significand & ((1U << shift) - 1);
const uint32_t midpoint = 1U << (shift - 1);
const float low = sign ? -a.lo : a.lo;
if (rem > midpoint || (rem == midpoint && (low > 0 || (low == 0 && (rounded & 1))))) ++rounded;
return static_cast<uint16_t>((sign << 15) | rounded);
}
__aicore__ inline bool NearHalfBoundary(uint32_t bits) {
const uint32_t mag = bits & 0x7fffffff;
const uint32_t exponent = mag >> 23;
if (exponent < 101 || exponent >= 143) return false;
const uint32_t shift = exponent >= 113 ? 13 : 126 - exponent;
const uint32_t significand = exponent >= 113 ? mag : ((mag & 0x7fffff) | 0x800000);
const int rem = static_cast<int>(significand & ((1U << shift) - 1));
const int midpoint = 1U << (shift - 1);
return rem >= midpoint - 64 && rem <= midpoint + 64;
}
__aicore__ inline uint16_t RefineGelu(float z) {
if (z >= 8.0f) return RoundWideHalf({z, 0.0f});
if (z <= -8.0f) return 0x8000;
const Wide v{z, 0.0f};
const Wide cube = WMul(WMul(v, v), v);
Wide q = WMul(WAdd(v, WMul(cube, {0.044714998453855515f, 1.5461444832776117e-09f})),
{1.5957691669464111f, -4.5340680321359628e-08f});
if (q.hi >= 0) q = WNeg(q);
const Wide tail = WExp(q);
if (z >= 0 && tail.hi < 1.1102230246251565e-16f) return RoundWideHalf(v);
const Wide numerator = z >= 0 ? v : WMul(v, tail);
return RoundWideHalf(WDiv(numerator, WAdd({1.0f, 0.0f}, tail)));
}
__aicore__ inline Wide WExpLarge(Wide x) {
const int n = static_cast<int>(x.hi * 1.4426950408889634f - 0.5f);
const Wide r = WSub(x, WMul({static_cast<float>(n), 0.0f},
{0.69314718246459961f, -1.904654323148236e-09f}));
const Wide coeff[11] = {
{1.0f, 0.0f}, {1.0f, 0.0f}, {0.5f, 0.0f},
{0.1666666716337204f, -4.9670537405344106e-09f},
{0.041666667908430099f, -1.2417634351336027e-09f},
{0.0083333337679505348f, -4.3461720160287154e-10f},
{0.0013888889225199819f, -3.3631092919220174e-11f},
{0.00019841270113829523f, -2.7255968207233472e-12f},
{2.4801587642286904e-05f, -3.406996025904184e-13f},
{2.7557318844628753e-06f, 3.7935713937038186e-14f},
{2.755731998149713e-07f, -7.5751124208094317e-15f},
};
Wide sum = coeff[10];
#pragma unroll
for (int i = 9; i >= 0; --i) sum = WAdd(WMul(sum, r), coeff[i]);
FloatBits power;
power.u = static_cast<uint32_t>(n + 127) << 23;
return WMul(sum, {power.f, 0.0f});
}
__aicore__ inline uint16_t RefineGeluLarge(float z) {
if (z >= 8.0f) return RoundWideHalf({z, 0.0f});
if (z <= -8.0f) return 0x8000;
const Wide v{z, 0.0f};
const Wide cube = WMul(WMul(v, v), v);
Wide q = WMul(WAdd(v, WMul(cube, {0.044714998453855515f, 1.5461444832776117e-09f})),
{1.5957691669464111f, -4.5340680321359628e-08f});
if (q.hi >= 0) q = WNeg(q);
const Wide tail = WExpLarge(q);
if (z >= 0 && tail.hi < 1.1102230246251565e-16f) return RoundWideHalf(v);
const Wide numerator = z >= 0 ? v : WMul(v, tail);
return RoundWideHalf(WDiv(numerator, WAdd({1.0f, 0.0f}, tail)));
}
__aicore__ inline uint16_t BQ28Half(int64_t y) {
const uint32_t shift = y >= (int64_t(2)<<28) ? 19 : 18;
const uint32_t offset = shift == 19 ? 0x3c00 : 0x3800;
uint32_t v = static_cast<uint32_t>(y >> shift);
const int64_t rem = y & ((int64_t(1)<<shift)-1);
const int64_t mid = int64_t(1)<<(shift-1);
if(rem>mid || (rem==mid && (v&1))) ++v;
return static_cast<uint16_t>(offset+v);
}
__aicore__ inline bool BTryInterval(float z, uint16_t &answer) {
if(!(z>=2.0f && z<=4.0f)) return false;
constexpr int64_t Q=int64_t(1)<<28;
FloatBits bits;bits.f=z;
const int64_t Z=int64_t((bits.u&0x7fffff)|0x800000)<<((bits.u>>23)-122);
int64_t p=Z*Z;
const int64_t zl=p>>28, zh=(p+Q-1)>>28;
const int64_t cl=(zl*Z)>>28, ch=(zh*Z+Q-1)>>28;
int64_t ql=((cl*12003091)>>28)+Z;
int64_t qh=((ch*12003092+Q-1)>>28)+Z;
ql=(ql*428361011)>>28;
qh=(qh*428361012+Q-1)>>28;
const int n=-static_cast<int>((static_cast<uint32_t>(ql)+93032640U)/186065280U);
if(n>=0 || n < -30) return false;
const int64_t rl=-qh-int64_t(n)*186065279;
const int64_t rh=-ql-int64_t(n)*186065280;
if(rl < -93147103 || rh > 93147103) return false;
const int64_t coeffL[6]={268435456,268435456,134217728,44739242,11184810,2236962};
const int64_t coeffH[6]={268435456,268435456,134217728,44739243,11184811,2236963};
int64_t pl=372827,ph=372828;
#pragma unroll
for(int j=5;j>=0;--j){
const int64_t low=(rl>=0?pl:ph)*rl;
const int64_t high=(rh<=0?pl:ph)*rh;
pl=(low>>28)+coeffL[j];
ph=-((-high)>>28)+coeffH[j];
}
pl-=50;ph+=50;
const uint32_t shift=static_cast<uint32_t>(-n);
const int64_t tl=pl>>shift;
const int64_t th=(ph+(int64_t(1)<<shift)-1)>>shift;
const int64_t correctionL=(Z*tl)/(Q+tl);
const int64_t correctionH=(Z*th+Q+th-1)/(Q+th);
const int64_t yl=Z-correctionH-4, yh=Z-correctionL+4;
if(yl<Q || yh>4*Q) return false;
const uint16_t a=BQ28Half(yl),b=BQ28Half(yh);
if(a!=b) return false;
answer=a;return true;
}
__aicore__ inline uint16_t BRefineInterval(float z) {
uint16_t y;
return BTryInterval(z,y)?y:RefineGeluLarge(z);
}
template<int Segment> __aicore__ inline bool BNegDirectSegment(int64_t Z,uint16_t &answer){
const int32_t X=static_cast<int32_t>(Z-int64_t(Segment==0?35:41)*(int64_t(1)<<29));
const int32_t coeffL[10]={(Segment==0?3317334:-894430),(Segment==0?2796861:2610915),(Segment==0?-35505458:-5091110),(Segment==0?107376667:7675604),(Segment==0?-203130249:-8945849),(Segment==0?268052397:7987958),(Segment==0?-249804819:-5324834),(Segment==0?158582286:2509280),(Segment==0?-62041073:-748444),(Segment==0?11353452:106567)};
const int32_t coeffH[10]={(Segment==0?3317335:-894429),(Segment==0?2796862:2610916),(Segment==0?-35505457:-5091109),(Segment==0?107376668:7675605),(Segment==0?-203130248:-8945848),(Segment==0?268052398:7987959),(Segment==0?-249804818:-5324833),(Segment==0?158582287:2509281),(Segment==0?-62041072:-748443),(Segment==0?11353453:106568)};
int32_t pl=coeffL[0],ph=coeffH[0];
#pragma unroll
for(int j=1;j<10;++j){
const int64_t low=static_cast<int64_t>(X>=0?pl:ph)*X;
const int64_t high=static_cast<int64_t>(X>=0?ph:pl)*X;
pl=static_cast<int32_t>((low>>32)+coeffL[j]);
ph=static_cast<int32_t>(-((-high)>>32)+coeffH[j]);
}
const int64_t lo=int64_t(pl)-3,hi=int64_t(ph)+3;
if(lo<0 || hi>(int64_t(1)<<26))return false;
uint32_t a=static_cast<uint32_t>(lo>>16),b=static_cast<uint32_t>(hi>>16);
const uint32_t rl=static_cast<uint32_t>(lo)&65535,rh=static_cast<uint32_t>(hi)&65535;
if(rl>32768 || (rl==32768 && (a&1)))++a;
if(rh>32768 || (rh==32768 && (b&1)))++b;
if(a!=b)return false;
answer=static_cast<uint16_t>(0x8000|a);return true;
}
__aicore__ inline bool BNegTryDirect(float z,uint16_t &answer){
if(!(z<=-4.0f && z>=-5.5f))return false;
FloatBits bits;bits.f=-z;
const int64_t Z=int64_t((bits.u&0x7fffff)|0x800000)<<((bits.u>>23)-118);
return z>-4.75f?BNegDirectSegment<0>(Z,answer):BNegDirectSegment<1>(Z,answer);
}
__aicore__ inline uint16_t BRefineWithNegativeDirect(float z){
uint16_t y;
if(BTryInterval(z,y))return y;
if(BNegTryDirect(z,y))return y;
return RefineGeluLarge(z);
}
class Kernel {
public:
Matmul<A, B, C, Bias> mm;
__aicore__ inline void Init(GM_ADDR xp, GM_ADDR wp, GM_ADDR sp,
GM_ADDR gp, GM_ADDR yp, GM_ADDR scratch, const Plan &p, TPipe &pipe) {
plan = p;
tileN = plan.cube.baseN;
packed = plan.n % 16 == 0;
elements = plan.cube.baseM * tileN;
x.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t *>(xp));
w.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t *>(wp));
scale.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(sp));
groups.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t *>(gp));
y.SetGlobalBuffer(reinterpret_cast<__gm__ half *>(yp));
uint32_t core = GetBlockIdx();
if ASCEND_IS_AIV { core /= 2; }
accum.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t *>(scratch) + uint64_t(core) * ELEMS);
pipe.InitBuffer(cb, elements * sizeof(int32_t));
pipe.InitBuffer(zb, elements * sizeof(float));
pipe.InitBuffer(qb, elements * sizeof(float));
pipe.InitBuffer(tb, elements * sizeof(float));
pipe.InitBuffer(db, elements * sizeof(float));
pipe.InitBuffer(sb, tileN * sizeof(float));
pipe.InitBuffer(yb, elements * sizeof(half));
if (!packed) pipe.InitBuffer(hb, elements * sizeof(half));
pipe.InitBuffer(m0b, elements / 8 + 32);
pipe.InitBuffer(m1b, elements / 8 + 32);
}
__aicore__ inline void Process() {
if (GetSubBlockIdx() != 0) return;
uint32_t core = GetBlockIdx();
if ASCEND_IS_AIV { core /= 2; }
const uint32_t tileN = plan.cube.baseN;
const uint32_t tileM = plan.cube.baseM;
const uint32_t ntiles = (plan.n + tileN - 1) / tileN;
uint32_t start = 0, prefix = 0;
for (uint32_t e = 0; e < plan.e; ++e) {
const uint32_t end = static_cast<uint32_t>(groups.GetValue(e));
const uint32_t rows = end - start;
const uint32_t count = ((rows + tileM - 1) / tileM) * ntiles;
const uint32_t first = (core + plan.blocks - prefix % plan.blocks) % plan.blocks;
for (uint32_t task = first; task < count; task += plan.blocks) {
const uint32_t mr = (task / ntiles) * tileM;
const uint32_t nc = (task % ntiles) * tileN;
const uint32_t vm = rows - mr < tileM ? rows - mr : tileM;
const uint32_t vn = plan.n - nc < tileN ? plan.n - nc : tileN;
Compute(e, start + mr, nc, vm, vn);
}
prefix += count;
start = end;
}
}
private:
__aicore__ inline void Compute(uint32_t e, uint32_t row, uint32_t col,
uint32_t vm, uint32_t vn) {
mm.SetTensorA(x[uint64_t(row) * plan.k]);
mm.SetTensorB(w[uint64_t(e) * plan.k * plan.n + col]);
mm.SetSingleShape(vm, vn, plan.k);
mm.template Iterate<true>();
mm.template GetTensorC<true>(accum, false, true);
mm.End();
const uint32_t stride = (vn + 7) / 8 * 8;
const uint32_t len = vm * stride;
auto ci = cb.Get<int32_t>();
auto z = zb.Get<float>();
auto q = qb.Get<float>();
auto t = tb.Get<float>();
auto d = db.Get<float>();
auto s = sb.Get<float>();
auto out = yb.Get<half>();
DataCopyPad(ci, accum,
DataCopyExtParams{static_cast<uint16_t>(vm), vn * 4, 0, 0, 0},
DataCopyPadExtParams<int32_t>{true, 0, static_cast<uint8_t>(stride - vn), 0});
DataCopyPad(s, scale[uint64_t(e) * plan.n + col],
DataCopyExtParams{1, vn * 4, 0, 0, 0},
DataCopyPadExtParams<float>{true, 0, static_cast<uint8_t>(stride - vn), 0.0f});
SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
Cast(z, ci, RoundMode::CAST_RINT, len);
PipeBarrier<PIPE_V>();
BinaryRepeatParams br;
br.dstBlkStride = 1; br.src0BlkStride = 1; br.src1BlkStride = 1;
br.dstRepStride = stride / 8; br.src0RepStride = stride / 8; br.src1RepStride = 0;
for (uint32_t col = 0; col < stride; col += 64) {
const uint64_t mask = stride - col < 64 ? stride - col : 64;
Mul(z[col], z[col], s[col], mask, static_cast<uint8_t>(vm), br);
}
PipeBarrier<PIPE_V>();
Mul(q, z, z, len);
PipeBarrier<PIPE_V>();
Muls(q, q, 0.044715f, len);
PipeBarrier<PIPE_V>();
Adds(q, q, 1.0f, len);
PipeBarrier<PIPE_V>();
Mul(q, q, z, len);
PipeBarrier<PIPE_V>();
Muls(q, q, 1.5957691216057308f, len);
PipeBarrier<PIPE_V>();
Abs(t, q, len);
PipeBarrier<PIPE_V>();
Muls(t, t, -1.0f, len);
PipeBarrier<PIPE_V>();
Exp(t, t, len);
PipeBarrier<PIPE_V>();
Adds(d, t, 1.0f, len);
PipeBarrier<PIPE_V>();
Abs(q, z, len);
PipeBarrier<PIPE_V>();
Mul(q, q, t, len);
PipeBarrier<PIPE_V>();
Div(q, q, d, len);
PipeBarrier<PIPE_V>();
Maxs(t, z, 0.0f, len);
PipeBarrier<PIPE_V>();
Sub(q, t, q, len);
PipeBarrier<PIPE_V>();
if (packed) Cast(out, q, RoundMode::CAST_RINT, len);
else for (uint32_t r = 0; r < vm; ++r)
Cast(out[r * tileN], q[r * stride], RoundMode::CAST_RINT, stride);
const uint32_t paddedLen = (len + 63) / 64 * 64;
if (paddedLen > len) {
Duplicate(q[len], 0.0f, paddedLen - len);
PipeBarrier<PIPE_V>();
}
auto mask0 = m0b.Get<uint8_t>();
auto mask1 = m1b.Get<uint8_t>();
Duplicate(db.Get<int32_t>(), static_cast<int32_t>(0x1fff), paddedLen);
PipeBarrier<PIPE_V>();
And(cb.Get<uint16_t>(), q.ReinterpretCast<uint16_t>(), db.Get<uint16_t>(), paddedLen * 2);
PipeBarrier<PIPE_V>();
Cast(t, cb.Get<int32_t>(), RoundMode::CAST_RINT, paddedLen);
PipeBarrier<PIPE_V>();
Adds(t, t, -4096.0f, paddedLen);
PipeBarrier<PIPE_V>();
Abs(t, t, paddedLen);
Duplicate(m0b.Get<uint16_t>(), static_cast<uint16_t>(0), elements / 16 + 16);
Duplicate(m1b.Get<uint16_t>(), static_cast<uint16_t>(0), elements / 16 + 16);
PipeBarrier<PIPE_V>();
Compares(mask0, t, 4.0f, CMPMODE::LE, paddedLen);
Compares(mask1, q, 2.0f, CMPMODE::GE, paddedLen);
PipeBarrier<PIPE_V>();
And(m0b.Get<uint16_t>(), m0b.Get<uint16_t>(), m1b.Get<uint16_t>(), (paddedLen + 15) / 16);
Abs(d, q, paddedLen);
PipeBarrier<PIPE_V>();
Mins(d, d, 0.00006103515625f, paddedLen);
PipeBarrier<PIPE_V>();
Muls(d, d, 16777216.0f, paddedLen);
PipeBarrier<PIPE_V>();
Cast(cb.Get<int32_t>(), d, RoundMode::CAST_FLOOR, paddedLen);
PipeBarrier<PIPE_V>();
Cast(t, cb.Get<int32_t>(), RoundMode::CAST_RINT, paddedLen);
PipeBarrier<PIPE_V>();
Sub(t, d, t, paddedLen);
PipeBarrier<PIPE_V>();
Adds(t, t, -0.5f, paddedLen);
PipeBarrier<PIPE_V>();
Abs(t, t, paddedLen);
Muls(d, d, 8.0e-6f, paddedLen);
PipeBarrier<PIPE_V>();
Sub(t, t, d, paddedLen);
PipeBarrier<PIPE_V>();
Compares(mask1, t, 0.0f, CMPMODE::LE, paddedLen);
PipeBarrier<PIPE_V>();
Or(m0b.Get<uint16_t>(), m0b.Get<uint16_t>(), m1b.Get<uint16_t>(), (paddedLen + 15) / 16);
SetFlag<HardEvent::V_S>(EVENT_ID0);
WaitFlag<HardEvent::V_S>(EVENT_ID0);
auto qbits = qb.Get<uint32_t>();
auto outbits = yb.Get<uint16_t>();
auto words = m0b.Get<uint64_t>();
for (uint32_t base = 0; base < len; base += 64) {
uint64_t flags = words.GetValue(base / 64);
while (flags) {
const uint32_t bit = static_cast<uint32_t>(__builtin_ctzll(flags));
flags &= flags - 1;
const uint32_t i = base + bit;
if (i >= len || i % stride >= vn) continue;
const uint32_t bits = qbits.GetValue(i);
const uint32_t mag = bits & 0x7fffffff;
if ((bits >> 31) ? (mag < 0x38800000) : (mag >= 0x40000000 || mag < 0x38800000)) {
const float value = z.GetValue(i);
if (value > -8.0f && value < 8.0f)
outbits.SetValue((i / stride) * (packed ? stride : tileN) + i % stride, RefineGeluLarge(value));
}
}
}
SetFlag<HardEvent::S_MTE3>(EVENT_ID0);
WaitFlag<HardEvent::S_MTE3>(EVENT_ID0);
SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
const uint32_t rowStride = packed ? stride : tileN;
DataCopyPad(y[uint64_t(row) * plan.n + col], out,
DataCopyExtParams{static_cast<uint16_t>(vm), vn * 2,
(rowStride - (vn + 15) / 16 * 16) / 16, (plan.n - vn) * 2, 0});
PipeBarrier<PIPE_ALL>();
}
Plan plan;
uint32_t elements;
uint32_t tileN;
bool packed;
GlobalTensor<int8_t> x, w;
GlobalTensor<float> scale;
GlobalTensor<int64_t> groups;
GlobalTensor<half> y;
GlobalTensor<int32_t> accum;
TBuf<TPosition::VECCALC> cb, zb, qb, tb, db, sb, yb, hb, pb, nb, m0b, m1b;
};
}
extern "C" int32_t rtGetC2cCtrlAddr(uint64_t *, uint32_t *);
#include <type_traits>
#define DIRECT_DEVICE __forceinline__ __aicore__
#ifdef __CCE__
#define DIRECT_HOST_DEVICE __forceinline__ [host, aicore]
#else
#define DIRECT_HOST_DEVICE
#endif
namespace direct_core {
constexpr uint32_t STRIDE_LIMIT = 65536;
template<class T, class U> constexpr bool is_same_v = std::is_same<T, U>::value;
template<uint32_t A, class T> DIRECT_HOST_DEVICE constexpr T RoundUp(T x) { return (x+A-1)/A*A; }
template<uint32_t A, class T> DIRECT_HOST_DEVICE constexpr T CeilDiv(T x) { return (x+A-1)/A; }
template<class T, class U> DIRECT_HOST_DEVICE constexpr auto CeilDiv(T x, U a) { return (x+a-1)/a; }
}
namespace direct_core {
struct MatrixCoord {
uint32_t r, c;
DIRECT_HOST_DEVICE constexpr MatrixCoord(uint32_t row = 0, uint32_t col = 0) : r(row), c(col) {}
DIRECT_HOST_DEVICE uint32_t row() const { return r; }
DIRECT_HOST_DEVICE uint32_t column() const { return c; }
};
DIRECT_HOST_DEVICE constexpr MatrixCoord MakeCoord(uint32_t r, uint32_t c) { return {r, c}; }
struct GemmCoord {
uint32_t rows, cols, depth;
DIRECT_HOST_DEVICE constexpr GemmCoord(uint32_t m = 0, uint32_t n = 0, uint32_t k = 0)
: rows(m), cols(n), depth(k) {}
DIRECT_HOST_DEVICE uint32_t m() const { return rows; }
DIRECT_HOST_DEVICE uint32_t n() const { return cols; }
DIRECT_HOST_DEVICE uint32_t k() const { return depth; }
DIRECT_HOST_DEVICE MatrixCoord GetCoordMN() const { return {rows, cols}; }
DIRECT_HOST_DEVICE MatrixCoord GetCoordMK() const { return {rows, depth}; }
DIRECT_HOST_DEVICE MatrixCoord GetCoordKN() const { return {depth, cols}; }
};
template<uint32_t M_, uint32_t N_, uint32_t K_>
struct GemmShape {
static constexpr uint32_t M = M_, N = N_, K = K_;
DIRECT_HOST_DEVICE static GemmCoord ToCoord() { return {M, N, K}; }
DIRECT_HOST_DEVICE static MatrixCoord ToCoordMN() { return {M, N}; }
};
namespace layout {
struct RowMajor {
uint32_t rows, cols;
int64_t pitch;
DIRECT_HOST_DEVICE RowMajor(uint32_t r = 0, uint32_t c = 0) : rows(r), cols(c), pitch(c) {}
DIRECT_HOST_DEVICE RowMajor(uint32_t r, uint32_t c, int64_t p) : rows(r), cols(c), pitch(p) {}
DIRECT_HOST_DEVICE uint32_t shape(int axis) const { return axis == 0 ? rows : cols; }
DIRECT_HOST_DEVICE int64_t stride(int axis) const { return axis == 0 ? pitch : 1; }
DIRECT_HOST_DEVICE int64_t GetOffset(MatrixCoord const &p) const { return int64_t(p.row()) * pitch + p.column(); }
DIRECT_HOST_DEVICE RowMajor GetTileLayout(MatrixCoord const &p) const { return {p.row(), p.column(), pitch}; }
};
struct VectorLayout {
uint32_t size;
DIRECT_HOST_DEVICE VectorLayout(uint32_t n = 0) : size(n) {}
};
struct L1Panel {
uint32_t columnPitch;
template<class T> DIRECT_HOST_DEVICE static L1Panel MakeLayout(uint32_t rows, uint32_t) {
static_assert(sizeof(T) == 1, "C0313 L1 is INT8 only");
return {RoundUp<16>(rows) * 32};
}
DIRECT_HOST_DEVICE int64_t GetOffset(MatrixCoord const &p) const {
return int64_t(p.row() / 16) * 512 + int64_t(p.column() / 32) * columnPitch
+ (p.row() % 16) * 32 + p.column() % 32;
}
};
struct L0ATile {
uint32_t rows, cols, rowBlockPitch;
template<class T> DIRECT_HOST_DEVICE static L0ATile MakeLayout(uint32_t r, uint32_t c) {
static_assert(sizeof(T) == 1, "C0313 L0A is INT8 only");
return {r, c, RoundUp<32>(c) * 16};
}
};
struct L0BTile {
uint32_t rows, cols, rowBlockPitch;
template<class T> DIRECT_HOST_DEVICE static L0BTile MakeLayout(uint32_t r, uint32_t c) {
static_assert(sizeof(T) == 1, "C0313 L0B is INT8 only");
return {r, c, RoundUp<16>(c) * 32};
}
};
struct Accumulator {
uint32_t columnPitch;
DIRECT_HOST_DEVICE static Accumulator MakeLayoutInL0C(MatrixCoord const &p) {
return {RoundUp<16>(p.row()) * 16};
}
DIRECT_HOST_DEVICE int64_t GetOffset(MatrixCoord const &p) const {
return int64_t(p.row() / 16) * 256 + int64_t(p.column() / 16) * columnPitch
+ (p.row() % 16) * 16 + p.column() % 16;
}
};
}
namespace Arch {
struct AtlasA2 {
static constexpr uint32_t UB_SIZE = 192 * 1024, L1_SIZE = 512 * 1024;
static constexpr uint32_t L0A_SIZE = 64 * 1024, L0B_SIZE = 64 * 1024, L0C_SIZE = 128 * 1024;
};
struct ByteBuffer {
AscendC::LocalTensor<uint8_t> tensor;
template<class T> DIRECT_DEVICE AscendC::LocalTensor<T> GetBufferByByte(uint32_t offset) const {
return tensor[offset].template ReinterpretCast<T>();
}
};
struct Resource {
AscendC::TPipe pipe;
ByteBuffer l1Buf, l0ABuf, l0BBuf, l0CBuf, ubBuf;
DIRECT_DEVICE Resource() {
{
AscendC::TBuf<AscendC::TPosition::A1> b;
GetTPipePtr()->InitBuffer(b, AtlasA2::L1_SIZE);
l1Buf.tensor = b.Get<uint8_t>();
}
{
AscendC::TBuf<AscendC::TPosition::A2> b;
GetTPipePtr()->InitBuffer(b, AtlasA2::L0A_SIZE);
l0ABuf.tensor = b.Get<uint8_t>();
}
{
AscendC::TBuf<AscendC::TPosition::B2> b;
GetTPipePtr()->InitBuffer(b, AtlasA2::L0B_SIZE);
l0BBuf.tensor = b.Get<uint8_t>();
}
{
AscendC::TBuf<AscendC::TPosition::CO1> b;
GetTPipePtr()->InitBuffer(b, AtlasA2::L0C_SIZE);
l0CBuf.tensor = b.Get<uint8_t>();
}
{
AscendC::TBuf<AscendC::TPosition::VECCALC> b;
GetTPipePtr()->InitBuffer(b, AtlasA2::UB_SIZE);
ubBuf.tensor = b.Get<uint8_t>();
}
pipe.Destroy();
}
};
using FlagID = uint16_t;
struct CrossCoreFlag {
FlagID id;
DIRECT_DEVICE CrossCoreFlag(FlagID value = 0) : id(value) {}
};
template<pipe_t Pipe> DIRECT_DEVICE void Signal(CrossCoreFlag &flag) {
AscendC::CrossCoreSetFlag<0x2, Pipe>(flag.id);
}
DIRECT_DEVICE void Wait(CrossCoreFlag &flag) { AscendC::CrossCoreWaitFlag(flag.id); }
}
namespace ops {
struct Int8GmToL1 {
using LayoutDst = layout::L1Panel;
using LayoutSrc = layout::RowMajor;
DIRECT_DEVICE void operator()(AscendC::LocalTensor<int8_t> const &dst,
AscendC::GlobalTensor<int8_t> const &src, LayoutDst const &ld, LayoutSrc const &ls) {
AscendC::Nd2NzParams p;
p.ndNum = 1; p.dValue = ls.cols;
p.srcNdMatrixStride = 0; p.dstNzC0Stride = ld.columnPitch / 32;
p.dstNzMatrixStride = 0;
if (ls.pitch < STRIDE_LIMIT) {
p.nValue = ls.rows; p.srcDValue = ls.pitch; p.dstNzNStride = 1;
AscendC::DataCopy(dst, src, p);
} else {
p.nValue = 1; p.srcDValue = 0; p.dstNzNStride = 0;
for (uint32_t i = 0; i < ls.rows; ++i)
AscendC::DataCopy(dst[i * 32], src[i * ls.pitch], p);
}
}
};
struct Int8L1ToL0A {
using LayoutDst = layout::L0ATile;
using LayoutSrc = layout::L1Panel;
DIRECT_DEVICE void operator()(AscendC::LocalTensor<int8_t> const &dst,
AscendC::LocalTensor<int8_t> const &src, LayoutDst const &ld, LayoutSrc const &ls) {
AscendC::LoadData2DParams p;
p.startIndex = 0; p.repeatTimes = static_cast<uint16_t>(CeilDiv<32>(ld.cols));
p.srcStride = ls.columnPitch / 512; p.sid = 0; p.dstGap = 0;
p.ifTranspose = false; p.addrMode = 0;
for (uint32_t i = 0; i < CeilDiv<16>(ld.rows); ++i)
AscendC::LoadData(dst[i * ld.rowBlockPitch], src[i * 512], p);
}
};
struct Int8L1ToL0B {
using LayoutDst = layout::L0BTile;
using LayoutSrc = layout::L1Panel;
DIRECT_DEVICE void operator()(AscendC::LocalTensor<int8_t> const &dst,
AscendC::LocalTensor<int8_t> const &src, LayoutDst const &ld, LayoutSrc const &ls) {
AscendC::LoadData2dTransposeParams p;
p.startIndex = 0; p.repeatTimes = static_cast<uint16_t>(CeilDiv<32>(ld.cols));
p.srcStride = ls.columnPitch / 512 / 2; p.dstGap = 1; p.dstFracGap = 0;
for (uint32_t i = 0; i < CeilDiv<32>(ld.rows); ++i)
AscendC::LoadDataWithTranspose(dst[i * ld.rowBlockPitch], src[i * 1024], p);
}
};
struct Int32L0CToGm {
using LayoutSrc = layout::Accumulator;
using LayoutDst = layout::RowMajor;
DIRECT_DEVICE void operator()(AscendC::GlobalTensor<int32_t> const &dst,
AscendC::LocalTensor<int32_t> const &src, LayoutDst const &ld,
LayoutSrc const &ls, uint8_t unitFlag = 0) {
AscendC::FixpipeParamsV220 p;
p.nSize = RoundUp<16>(ld.cols); p.mSize = ld.rows;
p.srcStride = ls.columnPitch / 16; p.dstStride = ld.pitch;
p.quantPre = QuantMode_t::NoQuant; p.reluEn = false; p.unitFlag = unitFlag;
AscendC::Fixpipe<int32_t, int32_t, AscendC::CFG_ROW_MAJOR>(dst, src, p);
}
};
struct Int8Mmad {
DIRECT_DEVICE void operator()(AscendC::LocalTensor<int32_t> const &c,
AscendC::LocalTensor<int8_t> const &a, AscendC::LocalTensor<int8_t> const &b,
uint32_t m, uint32_t n, uint32_t k, bool initC = true, uint8_t unitFlag = 0) {
AscendC::MmadParams p;
p.m = m; p.n = n; p.k = k; p.unitFlag = unitFlag; p.cmatrixInitVal = initC;
AscendC::Mmad(c, a, b, p);
if ((m / 16) * (n / 16) < 10) AscendC::PipeBarrier<PIPE_M>();
}
};
}
}
namespace direct_core {
struct GroupParams {
GemmCoord problemShape;
uint32_t problemCount;
__gm__ int64_t *ptrGroupList;
__gm__ int8_t *ptrA;
layout::RowMajor layoutA;
__gm__ int8_t *ptrB;
layout::RowMajor layoutB;
__gm__ float *ptrScale;
layout::VectorLayout layoutScale;
__gm__ half *ptrD;
layout::RowMajor layoutD;
GM_ADDR ptrWorkspace;
DIRECT_HOST_DEVICE GroupParams() {}
DIRECT_HOST_DEVICE GroupParams(GemmCoord shape, uint32_t count, GM_ADDR groups,
GM_ADDR a, layout::RowMajor la, GM_ADDR b, layout::RowMajor lb,
GM_ADDR scale, layout::VectorLayout ls, GM_ADDR y, layout::RowMajor ly, GM_ADDR scratch)
: problemShape(shape), problemCount(count), ptrGroupList(reinterpret_cast<__gm__ int64_t *>(groups)),
ptrA(reinterpret_cast<__gm__ int8_t *>(a)), layoutA(la),
ptrB(reinterpret_cast<__gm__ int8_t *>(b)), layoutB(lb),
ptrScale(reinterpret_cast<__gm__ float *>(scale)), layoutScale(ls),
ptrD(reinterpret_cast<__gm__ half *>(y)), layoutD(ly), ptrWorkspace(scratch) {}
};
struct GroupArguments {
GemmCoord problemShape;
uint32_t problemCount, aicCoreNum;
uint8_t *ptrGroupList, *ptrA, *ptrB, *ptrScale, *ptrD;
};
}
namespace direct_core {
}
namespace direct_core {
template<class L1TileShape_, class L0TileShape_>
struct DirectInt8Block {
public:
using ArchTag = Arch::AtlasA2;
using L1TileShape = L1TileShape_;
using L0TileShape = L0TileShape_;
using ElementA = int8_t;
using ElementB = int8_t;
using ElementC = int32_t;
using ElementAccumulator = int32_t;
using LayoutA = layout::RowMajor;
using LayoutB = layout::RowMajor;
using LayoutC = layout::RowMajor;
using TileMmad = ops::Int8Mmad;
using CopyGmToL1A = ops::Int8GmToL1;
using CopyGmToL1B = ops::Int8GmToL1;
using CopyL1ToL0A = ops::Int8L1ToL0A;
using CopyL1ToL0B = ops::Int8L1ToL0B;
using CopyL0CToGm = ops::Int32L0CToGm;
using LayoutAInL1 = typename CopyL1ToL0A::LayoutSrc;
using LayoutBInL1 = typename CopyL1ToL0B::LayoutSrc;
using LayoutAInL0 = typename CopyL1ToL0A::LayoutDst;
using LayoutBInL0 = typename CopyL1ToL0B::LayoutDst;
using LayoutCInL0 = layout::Accumulator;
static constexpr uint32_t STAGES = 2;
static constexpr uint32_t L1A_SIZE = L1TileShape::M * L1TileShape::K * sizeof(ElementA);
static constexpr uint32_t L1B_SIZE = L1TileShape::N * L1TileShape::K * sizeof(ElementB);
static constexpr uint32_t L0A_SIZE = ArchTag::L0A_SIZE;
static constexpr uint32_t L0B_SIZE = ArchTag::L0B_SIZE;
static constexpr uint32_t L0C_SIZE = ArchTag::L0C_SIZE;
static constexpr uint32_t L0A_PINGPONG_BUF_SIZE = L0A_SIZE / STAGES;
static constexpr uint32_t L0B_PINGPONG_BUF_SIZE = L0B_SIZE / STAGES;
static_assert(direct_core::is_same_v<LayoutC, layout::RowMajor>, "LayoutC only support RowMajor yet!");
static_assert((L1A_SIZE * STAGES + L1B_SIZE * STAGES) <= ArchTag::L1_SIZE, "L1TileShape exceeding the L1 space!");
static constexpr uint32_t L0A_TILE_SIZE = L0TileShape::M * L0TileShape::K * sizeof(ElementA);
static constexpr uint32_t L0B_TILE_SIZE = L0TileShape::K * L0TileShape::N * sizeof(ElementB);
static constexpr uint32_t L0C_TILE_SIZE = L0TileShape::M * L0TileShape::N * sizeof(ElementAccumulator);
static_assert((L0A_TILE_SIZE * STAGES) <= L0A_SIZE, "L0TileShape exceeding the L0A space!");
static_assert((L0B_TILE_SIZE * STAGES) <= L0B_SIZE, "L0TileShape exceeding the L0B space!");
static_assert(L0C_TILE_SIZE <= L0C_SIZE, "L0TileShape exceeding the L0C space!");
static_assert(L1TileShape::M == L0TileShape::M && L1TileShape::N == L0TileShape::N,
"The situation where the basic blocks of L1 and L0 differ on the m and n axes is not supported yet");
static_assert(L0TileShape::K <= L1TileShape::K, "L0TileShape::K cannot exceed L1TileShape::K");
DIRECT_DEVICE
DirectInt8Block(Arch::Resource &resource, uint32_t l1BufAddrStart = 0)
{
uint32_t l1AOffset = l1BufAddrStart;
uint32_t l1BOffset = l1BufAddrStart + L1A_SIZE * STAGES;
for (uint32_t i = 0; i < STAGES; i++) {
l1ATensorList[i] = resource.l1Buf.template GetBufferByByte<ElementA>(l1AOffset + L1A_SIZE * i);
l1BTensorList[i] = resource.l1Buf.template GetBufferByByte<ElementB>(l1BOffset + L1B_SIZE * i);
l0ATensorList[i] = resource.l0ABuf.template GetBufferByByte<ElementA>(L0A_PINGPONG_BUF_SIZE * i);
l0BTensorList[i] = resource.l0BBuf.template GetBufferByByte<ElementB>(L0B_PINGPONG_BUF_SIZE * i);
l1AEventList[i] = i;
l1BEventList[i] = i + STAGES;
l0AEventList[i] = i;
l0BEventList[i] = i + STAGES;
AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(l1AEventList[i]);
AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(l1BEventList[i]);
AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(l0AEventList[i]);
AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(l0BEventList[i]);
}
l0CTensor = resource.l0CBuf.template GetBufferByByte<ElementAccumulator>(0);
AscendC::SetFlag<AscendC::HardEvent::FIX_M>(EVENT_ID0);
}
DIRECT_DEVICE
~DirectInt8Block()
{
for (uint32_t i = 0; i < STAGES; i++) {
AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(l1AEventList[i]);
AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(l1BEventList[i]);
AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(l0AEventList[i]);
AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(l0BEventList[i]);
}
AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(EVENT_ID0);
}
DIRECT_DEVICE
void operator()(
AscendC::GlobalTensor<ElementA> const &gmA, LayoutA const &layoutA,
AscendC::GlobalTensor<ElementB> const &gmB, LayoutB const &layoutB,
AscendC::GlobalTensor<ElementC> const &gmC, LayoutC const &layoutC,
GemmCoord const &actualShape)
{
uint32_t mRound = RoundUp<16>(actualShape.m());
uint32_t nRound = RoundUp<32>(actualShape.n());
auto layoutAInL1 = LayoutAInL1::template MakeLayout<ElementA>(L1TileShape::M, L1TileShape::K);
auto layoutBInL1 = LayoutBInL1::template MakeLayout<ElementB>(L1TileShape::K, L1TileShape::N);
auto layoutInL0C = LayoutCInL0::MakeLayoutInL0C(MakeCoord(mRound, nRound));
uint32_t kActual = min(actualShape.k(), L1TileShape::K);
AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(l1AEventList[l1ListId]);
auto layoutTileA = layoutA.GetTileLayout(MakeCoord(actualShape.m(), kActual));
copyGmToL1A(l1ATensorList[l1ListId], gmA, layoutAInL1, layoutTileA);
AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(l1AEventList[l1ListId]);
AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(l1BEventList[l1ListId]);
auto layoutTileB = layoutB.GetTileLayout(MakeCoord(kActual, actualShape.n()));
copyGmToL1B(l1BTensorList[l1ListId], gmB, layoutBInL1, layoutTileB);
AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(l1BEventList[l1ListId]);
AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(EVENT_ID0);
uint32_t mPartLoop = CeilDiv<L0TileShape::M>(mRound);
uint32_t nPartLoop = CeilDiv<L0TileShape::N>(nRound);
uint32_t kTileCount = CeilDiv<L1TileShape::K>(actualShape.k());
for (uint32_t kLoopIdx = 0; kLoopIdx < kTileCount; kLoopIdx++) {
uint32_t l1ListIdNext = (l1ListId + 1 < STAGES) ? (l1ListId + 1) : 0;
uint32_t kActualNext{0};
if (kLoopIdx < kTileCount - 1) {
uint32_t kLoopIdxNext = kLoopIdx + 1;
kActualNext = (kLoopIdxNext < kTileCount - 1) ?
L1TileShape::K : (actualShape.k() - kLoopIdxNext * L1TileShape::K);
auto l1ATensor = l1ATensorList[l1ListIdNext];
auto l1BTensor = l1BTensorList[l1ListIdNext];
MatrixCoord gmTileAOffset{0, kLoopIdxNext * L1TileShape::K};
MatrixCoord gmTileBOffset{kLoopIdxNext * L1TileShape::K, 0};
auto gmTileA = gmA[layoutA.GetOffset(gmTileAOffset)];
auto gmTileB = gmB[layoutB.GetOffset(gmTileBOffset)];
AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(l1AEventList[l1ListIdNext]);
layoutTileA = layoutA.GetTileLayout(MakeCoord(actualShape.m(), kActualNext));
copyGmToL1A(l1ATensor, gmTileA, layoutAInL1, layoutTileA);
AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(l1AEventList[l1ListIdNext]);
AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(l1BEventList[l1ListIdNext]);
layoutTileB = layoutB.GetTileLayout(MakeCoord(kActualNext, actualShape.n()));
copyGmToL1B(l1BTensor, gmTileB, layoutBInL1, layoutTileB);
AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(l1BEventList[l1ListIdNext]);
}
auto l1ATensor = l1ATensorList[l1ListId];
auto l1BTensor = l1BTensorList[l1ListId];
uint32_t kPartLoop = CeilDiv<L0TileShape::K>(kActual);
for (int mPartIdx = 0; mPartIdx < mPartLoop; mPartIdx++) {
uint32_t mPartActual = (mPartIdx < mPartLoop - 1) ?
L0TileShape::M : (mRound - mPartIdx * L0TileShape::M);
for (int kPartIdx = 0; kPartIdx < kPartLoop; kPartIdx++) {
uint32_t kPartActual = (kPartIdx < kPartLoop - 1) ?
L0TileShape::K : (kActual - kPartIdx * L0TileShape::K);
auto l0ATile = l0ATensorList[l0AListId];
LayoutAInL0 layoutAInL0 = LayoutAInL0::template MakeLayout<ElementA>(mPartActual, kPartActual);
MatrixCoord l1AOffset{mPartIdx * L0TileShape::M, kPartIdx * L0TileShape::K};
auto l1ATile = l1ATensor[layoutAInL1.GetOffset(l1AOffset)];
AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(l0AEventList[l0AListId]);
if ((mPartIdx == 0) && (kPartIdx == 0)) {
AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(l1AEventList[l1ListId]);
}
copyL1ToL0A(l0ATile, l1ATile, layoutAInL0, layoutAInL1);
if ((mPartIdx == mPartLoop - 1) && (kPartIdx == kPartLoop - 1)) {
AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(l1AEventList[l1ListId]);
}
for (int nPartIdx = 0; nPartIdx < nPartLoop; nPartIdx++) {
uint32_t nPartActual = (nPartIdx < nPartLoop - 1) ?
L0TileShape::N : (nRound - nPartIdx * L0TileShape::N);
auto l0BTile = l0BTensorList[l0BListId];
LayoutBInL0 layoutBInL0 = LayoutBInL0::template MakeLayout<ElementB>(kPartActual, nPartActual);
MatrixCoord l1BOffset{kPartIdx * L0TileShape::K, nPartIdx * L0TileShape::N};
auto l1BTile = l1BTensor[layoutBInL1.GetOffset(l1BOffset)];
AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(l0BEventList[l0BListId]);
if ((kPartIdx == 0) && (nPartIdx == 0)) {
AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(l1BEventList[l1ListId]);
}
copyL1ToL0B(l0BTile, l1BTile, layoutBInL0, layoutBInL1);
if ((kPartIdx == kPartLoop - 1) && (nPartIdx == nPartLoop - 1)) {
AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(l1BEventList[l1ListId]);
}
AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID0);
MatrixCoord l0COffset{mPartIdx * L0TileShape::M, nPartIdx * L0TileShape::N};
auto l0CTile = l0CTensor[layoutInL0C.GetOffset(l0COffset)];
AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID0);
bool initC = ((kLoopIdx == 0) && (kPartIdx == 0));
uint8_t unitFlag = 0b00;
tileMmad(l0CTile, l0ATile, l0BTile, mPartActual, nPartActual, kPartActual, initC, unitFlag);
AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(l0BEventList[l0BListId]);
l0BListId = (l0BListId + 1 < STAGES) ? (l0BListId + 1) : 0;
}
AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(l0AEventList[l0AListId]);
l0AListId = (l0AListId + 1 < STAGES) ? (l0AListId + 1) : 0;
}
}
l1ListId = l1ListIdNext;
kActual = kActualNext;
}
LayoutC layoutBlock = layoutC.GetTileLayout(actualShape.GetCoordMN());
AscendC::SetFlag<AscendC::HardEvent::M_FIX>(EVENT_ID0);
AscendC::WaitFlag<AscendC::HardEvent::M_FIX>(EVENT_ID0);
copyL0CToGm(gmC, l0CTensor, layoutBlock, layoutInL0C);
AscendC::SetFlag<AscendC::HardEvent::FIX_M>(EVENT_ID0);
}
protected:
AscendC::LocalTensor<ElementA> l1ATensorList[STAGES];
AscendC::LocalTensor<ElementB> l1BTensorList[STAGES];
AscendC::LocalTensor<ElementA> l0ATensorList[STAGES];
AscendC::LocalTensor<ElementB> l0BTensorList[STAGES];
AscendC::LocalTensor<ElementAccumulator> l0CTensor;
int32_t l1AEventList[STAGES];
int32_t l1BEventList[STAGES];
int32_t l0AEventList[STAGES];
int32_t l0BEventList[STAGES];
uint32_t l1ListId{0};
uint32_t l0AListId{0};
uint32_t l0BListId{0};
TileMmad tileMmad;
CopyGmToL1A copyGmToL1A;
CopyGmToL1B copyGmToL1B;
CopyL1ToL0A copyL1ToL0A;
CopyL1ToL0B copyL1ToL0B;
CopyL0CToGm copyL0CToGm;
};
}
namespace direct_core {
struct GuardedDeepK192Block : DirectInt8Block<GemmShape<192,96,896>,GemmShape<192,96,128>> {
using Parent=DirectInt8Block<GemmShape<192,96,896>,GemmShape<192,96,128>>;
using Parent::Parent;
static constexpr uint32_t DEEP_K=320;
static_assert(192*320<=65536 && 2*320*96<=65536 && 192*96*4<=131072,"physical L0 capacities");
DIRECT_DEVICE uint64_t GetCalls()const{return calls;}
DIRECT_DEVICE uint64_t GetPieces()const{return pieces;}
DIRECT_DEVICE void operator()(
AscendC::GlobalTensor<ElementA>const&gmA,LayoutA const&layoutA,
AscendC::GlobalTensor<ElementB>const&gmB,LayoutB const&layoutB,
AscendC::GlobalTensor<ElementC>const&gmC,LayoutC const&layoutC,GemmCoord const&actualShape){
++calls;
uint32_t mRound = RoundUp<16>(actualShape.m());
uint32_t nRound = RoundUp<32>(actualShape.n());
auto layoutAInL1 = LayoutAInL1::template MakeLayout<ElementA>(L1TileShape::M, L1TileShape::K);
auto layoutBInL1 = LayoutBInL1::template MakeLayout<ElementB>(L1TileShape::K, L1TileShape::N);
auto layoutInL0C = LayoutCInL0::MakeLayoutInL0C(MakeCoord(mRound, nRound));
uint32_t kActual = min(actualShape.k(), L1TileShape::K);
AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(l1AEventList[l1ListId]);
auto layoutTileA = layoutA.GetTileLayout(MakeCoord(actualShape.m(), kActual));
copyGmToL1A(l1ATensorList[l1ListId], gmA, layoutAInL1, layoutTileA);
AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(l1AEventList[l1ListId]);
AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(l1BEventList[l1ListId]);
auto layoutTileB = layoutB.GetTileLayout(MakeCoord(kActual, actualShape.n()));
copyGmToL1B(l1BTensorList[l1ListId], gmB, layoutBInL1, layoutTileB);
AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(l1BEventList[l1ListId]);
AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(EVENT_ID0);
AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(l0AEventList[1]);
uint32_t mPartLoop = CeilDiv<L0TileShape::M>(mRound);
uint32_t nPartLoop = CeilDiv<L0TileShape::N>(nRound);
uint32_t kTileCount = CeilDiv<L1TileShape::K>(actualShape.k());
for (uint32_t kLoopIdx = 0; kLoopIdx < kTileCount; kLoopIdx++) {
uint32_t l1ListIdNext = (l1ListId + 1 < STAGES) ? (l1ListId + 1) : 0;
uint32_t kActualNext{0};
if (kLoopIdx < kTileCount - 1) {
uint32_t kLoopIdxNext = kLoopIdx + 1;
kActualNext = (kLoopIdxNext < kTileCount - 1) ?
L1TileShape::K : (actualShape.k() - kLoopIdxNext * L1TileShape::K);
auto l1ATensor = l1ATensorList[l1ListIdNext];
auto l1BTensor = l1BTensorList[l1ListIdNext];
MatrixCoord gmTileAOffset{0, kLoopIdxNext * L1TileShape::K};
MatrixCoord gmTileBOffset{kLoopIdxNext * L1TileShape::K, 0};
auto gmTileA = gmA[layoutA.GetOffset(gmTileAOffset)];
auto gmTileB = gmB[layoutB.GetOffset(gmTileBOffset)];
AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(l1AEventList[l1ListIdNext]);
layoutTileA = layoutA.GetTileLayout(MakeCoord(actualShape.m(), kActualNext));
copyGmToL1A(l1ATensor, gmTileA, layoutAInL1, layoutTileA);
AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(l1AEventList[l1ListIdNext]);
AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(l1BEventList[l1ListIdNext]);
layoutTileB = layoutB.GetTileLayout(MakeCoord(kActualNext, actualShape.n()));
copyGmToL1B(l1BTensor, gmTileB, layoutBInL1, layoutTileB);
AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(l1BEventList[l1ListIdNext]);
}
auto l1ATensor = l1ATensorList[l1ListId];
auto l1BTensor = l1BTensorList[l1ListId];
uint32_t kPartLoop = CeilDiv<DEEP_K>(kActual);
for (int mPartIdx = 0; mPartIdx < mPartLoop; mPartIdx++) {
uint32_t mPartActual = (mPartIdx < mPartLoop - 1) ?
L0TileShape::M : (mRound - mPartIdx * L0TileShape::M);
for (int kPartIdx = 0; kPartIdx < kPartLoop; kPartIdx++) {
uint32_t kPartActual = (kPartIdx < kPartLoop - 1) ?
DEEP_K : (kActual - kPartIdx * DEEP_K);
auto l0ATile = l0ATensorList[0];
LayoutAInL0 layoutAInL0 = LayoutAInL0::template MakeLayout<ElementA>(mPartActual, kPartActual);
MatrixCoord l1AOffset{mPartIdx * L0TileShape::M, kPartIdx * DEEP_K};
auto l1ATile = l1ATensor[layoutAInL1.GetOffset(l1AOffset)];
AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(l0AEventList[0]);
if ((mPartIdx == 0) && (kPartIdx == 0)) {
AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(l1AEventList[l1ListId]);
}
copyL1ToL0A(l0ATile, l1ATile, layoutAInL0, layoutAInL1);
if ((mPartIdx == mPartLoop - 1) && (kPartIdx == kPartLoop - 1)) {
AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(l1AEventList[l1ListId]);
}
for (int nPartIdx = 0; nPartIdx < nPartLoop; nPartIdx++) {
uint32_t nPartActual = (nPartIdx < nPartLoop - 1) ?
L0TileShape::N : (nRound - nPartIdx * L0TileShape::N);
auto l0BTile = l0BTensorList[l0BListId];
LayoutBInL0 layoutBInL0 = LayoutBInL0::template MakeLayout<ElementB>(kPartActual, nPartActual);
MatrixCoord l1BOffset{kPartIdx * DEEP_K, nPartIdx * L0TileShape::N};
auto l1BTile = l1BTensor[layoutBInL1.GetOffset(l1BOffset)];
AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(l0BEventList[l0BListId]);
if ((kPartIdx == 0) && (nPartIdx == 0)) {
AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(l1BEventList[l1ListId]);
}
copyL1ToL0B(l0BTile, l1BTile, layoutBInL0, layoutBInL1);
if ((kPartIdx == kPartLoop - 1) && (nPartIdx == nPartLoop - 1)) {
AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(l1BEventList[l1ListId]);
}
AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID0);
MatrixCoord l0COffset{mPartIdx * L0TileShape::M, nPartIdx * L0TileShape::N};
auto l0CTile = l0CTensor[layoutInL0C.GetOffset(l0COffset)];
AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID0);
bool initC = ((kLoopIdx == 0) && (kPartIdx == 0));
uint8_t unitFlag = 0b00;
++pieces;
tileMmad(l0CTile, l0ATile, l0BTile, mPartActual, nPartActual, kPartActual, initC, unitFlag);
AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(l0BEventList[l0BListId]);
l0BListId = (l0BListId + 1 < STAGES) ? (l0BListId + 1) : 0;
}
AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(l0AEventList[0]);
l0AListId = 0;
}
}
l1ListId = l1ListIdNext;
kActual = kActualNext;
}
AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(l0AEventList[1]);
LayoutC layoutBlock = layoutC.GetTileLayout(actualShape.GetCoordMN());
AscendC::SetFlag<AscendC::HardEvent::M_FIX>(EVENT_ID0);
AscendC::WaitFlag<AscendC::HardEvent::M_FIX>(EVENT_ID0);
copyL0CToGm(gmC, l0CTensor, layoutBlock, layoutInL0C);
AscendC::SetFlag<AscendC::HardEvent::FIX_M>(EVENT_ID0);
}
private:uint64_t calls{0},pieces{0};
};
}
namespace direct_core {
constexpr AscendC::IsResetLoad3dConfig kFastA3DKeep{false,false};
struct FastA3DCopy {
using Parent=ops::Int8L1ToL0A;
using LayoutDst=Parent::LayoutDst;using LayoutSrc=Parent::LayoutSrc;
bool repeatInitialized{false},featureInitialized{false};uint32_t featureW{0};
uint64_t a3dHits{0},a2dHits{0};
DIRECT_DEVICE void operator()(AscendC::LocalTensor<int8_t>const&dst,
AscendC::LocalTensor<int8_t>const&src,LayoutDst const&ld,LayoutSrc const&ls){
const uint32_t mr=RoundUp<16>(ld.rows),kr=RoundUp<32>(ld.cols),capacityM=ls.columnPitch/32;
if(mr>=64 && mr<=capacityM && capacityM%16==0 && capacityM<=32767 &&
kr>0 && kr<=128 && mr*kr<=16384 && ls.columnPitch==capacityM*32){
++a3dHits;
if(!repeatInitialized){
AscendC::LoadDataRepeatParam rpt{};rpt.repeatMode=0;rpt.repeatTime=1;rpt.repeatStride=0;
AscendC::SetLoadDataRepeat(rpt);repeatInitialized=true;
}
AscendC::LoadData3DParamsV2<int8_t> p;
p.l1H=1;p.l1W=capacityM;p.channelSize=kr;
p.kExtension=kr;p.mExtension=mr;p.kStartPt=0;p.mStartPt=0;
p.strideW=1;p.strideH=1;p.filterW=1;p.filterH=1;
p.dilationFilterW=1;p.dilationFilterH=1;
p.enTranspose=false;p.enSmallK=false;p.padValue=0;
p.filterSizeW=false;p.filterSizeH=false;p.fMatrixCtrl=false;
if(!featureInitialized || featureW!=capacityM){
AscendC::SetFmatrix(p.l1H,p.l1W,p.padList,AscendC::FmatrixMode::FMATRIX_LEFT);
AscendC::SetLoadDataPaddingValue<int8_t>(p.padValue);
featureInitialized=true;featureW=capacityM;
}
AscendC::LoadData<int8_t,kFastA3DKeep>(dst,src,p);
return;
}
++a2dHits;Parent{}(dst,src,ld,ls);
}
};
struct FastPanelA3DBlock : DirectInt8Block<GemmShape<128,256,640>,GemmShape<128,256,128>> {
using Parent=DirectInt8Block<GemmShape<128,256,640>,GemmShape<128,256,128>>;
using Parent::Parent;
DIRECT_DEVICE uint64_t GetA3DHits()const{return a3d.a3dHits;}
DIRECT_DEVICE uint64_t GetA2DHits()const{return a3d.a2dHits;}
DIRECT_DEVICE void operator()(
AscendC::GlobalTensor<ElementA>const&gmA,LayoutA const&layoutA,
AscendC::GlobalTensor<ElementB>const&gmB,LayoutB const&layoutB,
AscendC::GlobalTensor<ElementC>const&gmC,LayoutC const&layoutC,GemmCoord const&actualShape){
uint32_t mRound = RoundUp<16>(actualShape.m());
uint32_t nRound = RoundUp<32>(actualShape.n());
auto layoutAInL1 = LayoutAInL1::template MakeLayout<ElementA>(L1TileShape::M, L1TileShape::K);
auto layoutBInL1 = LayoutBInL1::template MakeLayout<ElementB>(L1TileShape::K, L1TileShape::N);
auto layoutInL0C = LayoutCInL0::MakeLayoutInL0C(MakeCoord(mRound, nRound));
uint32_t kActual = min(actualShape.k(), L1TileShape::K);
AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(l1AEventList[l1ListId]);
auto layoutTileA = layoutA.GetTileLayout(MakeCoord(actualShape.m(), kActual));
copyGmToL1A(l1ATensorList[l1ListId], gmA, layoutAInL1, layoutTileA);
AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(l1AEventList[l1ListId]);
AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(l1BEventList[l1ListId]);
const uint32_t bReadWidth = layoutB.stride(0) != int64_t(layoutB.cols)
? RoundUp<128>(actualShape.n()) : actualShape.n();
auto layoutTileB = layoutB.GetTileLayout(MakeCoord(kActual, bReadWidth));
copyGmToL1B(l1BTensorList[l1ListId], gmB, layoutBInL1, layoutTileB);
AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(l1BEventList[l1ListId]);
AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(EVENT_ID0);
uint32_t mPartLoop = CeilDiv<L0TileShape::M>(mRound);
uint32_t nPartLoop = CeilDiv<L0TileShape::N>(nRound);
uint32_t kTileCount = CeilDiv<L1TileShape::K>(actualShape.k());
for (uint32_t kLoopIdx = 0; kLoopIdx < kTileCount; kLoopIdx++) {
uint32_t l1ListIdNext = (l1ListId + 1 < STAGES) ? (l1ListId + 1) : 0;
uint32_t kActualNext{0};
if (kLoopIdx < kTileCount - 1) {
uint32_t kLoopIdxNext = kLoopIdx + 1;
kActualNext = (kLoopIdxNext < kTileCount - 1) ?
L1TileShape::K : (actualShape.k() - kLoopIdxNext * L1TileShape::K);
auto l1ATensor = l1ATensorList[l1ListIdNext];
auto l1BTensor = l1BTensorList[l1ListIdNext];
MatrixCoord gmTileAOffset{0, kLoopIdxNext * L1TileShape::K};
MatrixCoord gmTileBOffset{kLoopIdxNext * L1TileShape::K, 0};
auto gmTileA = gmA[layoutA.GetOffset(gmTileAOffset)];
auto gmTileB = gmB[layoutB.GetOffset(gmTileBOffset)];
AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(l1AEventList[l1ListIdNext]);
layoutTileA = layoutA.GetTileLayout(MakeCoord(actualShape.m(), kActualNext));
copyGmToL1A(l1ATensor, gmTileA, layoutAInL1, layoutTileA);
AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(l1AEventList[l1ListIdNext]);
AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(l1BEventList[l1ListIdNext]);
layoutTileB = layoutB.GetTileLayout(MakeCoord(kActualNext, actualShape.n()));
copyGmToL1B(l1BTensor, gmTileB, layoutBInL1, layoutTileB);
AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(l1BEventList[l1ListIdNext]);
}
auto l1ATensor = l1ATensorList[l1ListId];
auto l1BTensor = l1BTensorList[l1ListId];
uint32_t kPartLoop = CeilDiv<L0TileShape::K>(kActual);
for (int mPartIdx = 0; mPartIdx < mPartLoop; mPartIdx++) {
uint32_t mPartActual = (mPartIdx < mPartLoop - 1) ?
L0TileShape::M : (mRound - mPartIdx * L0TileShape::M);
for (int kPartIdx = 0; kPartIdx < kPartLoop; kPartIdx++) {
uint32_t kPartActual = (kPartIdx < kPartLoop - 1) ?
L0TileShape::K : (kActual - kPartIdx * L0TileShape::K);
auto l0ATile = l0ATensorList[l0AListId];
LayoutAInL0 layoutAInL0 = LayoutAInL0::template MakeLayout<ElementA>(mPartActual, kPartActual);
MatrixCoord l1AOffset{mPartIdx * L0TileShape::M, kPartIdx * L0TileShape::K};
auto l1ATile = l1ATensor[layoutAInL1.GetOffset(l1AOffset)];
AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(l0AEventList[l0AListId]);
if ((mPartIdx == 0) && (kPartIdx == 0)) {
AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(l1AEventList[l1ListId]);
}
a3d(l0ATile, l1ATile, layoutAInL0, layoutAInL1);
if ((mPartIdx == mPartLoop - 1) && (kPartIdx == kPartLoop - 1)) {
AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(l1AEventList[l1ListId]);
}
for (int nPartIdx = 0; nPartIdx < nPartLoop; nPartIdx++) {
uint32_t nPartActual = (nPartIdx < nPartLoop - 1) ?
L0TileShape::N : (nRound - nPartIdx * L0TileShape::N);
auto l0BTile = l0BTensorList[l0BListId];
LayoutBInL0 layoutBInL0 = LayoutBInL0::template MakeLayout<ElementB>(kPartActual, nPartActual);
MatrixCoord l1BOffset{kPartIdx * L0TileShape::K, nPartIdx * L0TileShape::N};
auto l1BTile = l1BTensor[layoutBInL1.GetOffset(l1BOffset)];
AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(l0BEventList[l0BListId]);
if ((kPartIdx == 0) && (nPartIdx == 0)) {
AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(l1BEventList[l1ListId]);
}
copyL1ToL0B(l0BTile, l1BTile, layoutBInL0, layoutBInL1);
if ((kPartIdx == kPartLoop - 1) && (nPartIdx == nPartLoop - 1)) {
AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(l1BEventList[l1ListId]);
}
AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID0);
MatrixCoord l0COffset{mPartIdx * L0TileShape::M, nPartIdx * L0TileShape::N};
auto l0CTile = l0CTensor[layoutInL0C.GetOffset(l0COffset)];
AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID0);
bool initC = ((kLoopIdx == 0) && (kPartIdx == 0));
uint8_t unitFlag = 0b00;
tileMmad(l0CTile, l0ATile, l0BTile, mPartActual, nPartActual, kPartActual, initC, unitFlag);
AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(l0BEventList[l0BListId]);
l0BListId = (l0BListId + 1 < STAGES) ? (l0BListId + 1) : 0;
}
AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(l0AEventList[l0AListId]);
l0AListId = (l0AListId + 1 < STAGES) ? (l0AListId + 1) : 0;
}
}
l1ListId = l1ListIdNext;
kActual = kActualNext;
}
LayoutC layoutBlock = layoutC.GetTileLayout(actualShape.GetCoordMN());
AscendC::SetFlag<AscendC::HardEvent::M_FIX>(EVENT_ID0);
AscendC::WaitFlag<AscendC::HardEvent::M_FIX>(EVENT_ID0);
copyL0CToGm(gmC, l0CTensor, layoutBlock, layoutInL0C);
AscendC::SetFlag<AscendC::HardEvent::FIX_M>(EVENT_ID0);
}
private:FastA3DCopy a3d;
};
}
namespace direct_core {
struct RowSwizzle3 {
GemmCoord problem;
MatrixCoord tile;
uint32_t mLoops{0}, nLoops{0};
DIRECT_DEVICE void Update(GemmCoord const &p, MatrixCoord const &t) {
problem = p; tile = t;
mLoops = CeilDiv(p.m(), t.row());
nLoops = CeilDiv(p.n(), t.column());
}
DIRECT_DEVICE uint32_t GetCoreLoops() const { return mLoops * nLoops; }
DIRECT_DEVICE GemmCoord GetBlockCoord(uint32_t taskIdx) const {
const uint32_t inner = taskIdx % GetCoreLoops();
const uint32_t slab = inner / (3 * nLoops);
const uint32_t within = inner % (3 * nLoops);
const uint32_t rows = slab == CeilDiv(mLoops, 3U) - 1 ? mLoops - 3 * slab : 3;
const uint32_t m = 3 * slab + within % rows;
uint32_t n = within / rows;
if (slab % 2 == 1) n = nLoops - n - 1;
return {m, n, 0};
}
DIRECT_DEVICE GemmCoord GetActualBlockShape(GemmCoord const &c) const {
const uint32_t m = c.m() == mLoops - 1 ? problem.m() - c.m() * tile.row() : tile.row();
const uint32_t n = c.n() == nLoops - 1 ? problem.n() - c.n() * tile.column() : tile.column();
return {m, n, problem.k()};
}
};
}
namespace direct_core {
template<class BlockMmad_, class BlockEpilogue_>
class DirectGrouped {
public:
using BlockMmad = BlockMmad_;
using L1TileShape = typename BlockMmad::L1TileShape;
using ElementA = int8_t;
using ElementB = int8_t;
using ElementC = int32_t;
using ElementGroupList = int64_t;
using LayoutA = layout::RowMajor;
using LayoutB = layout::RowMajor;
using LayoutC = layout::RowMajor;
using LayoutD = layout::RowMajor;
using LayoutScale = layout::VectorLayout;
using BlockEpilogue = BlockEpilogue_;
using EpilogueParams = typename BlockEpilogue::Params;
using BlockScheduler = RowSwizzle3;
static constexpr uint32_t WORKSPACE_STAGES = 4;
using Params = GroupParams;
using Arguments = GroupArguments;
static size_t GetWorkspaceSize(Arguments const &args) {
const uint32_t n = RoundUp<16>(args.problemShape.n() < L1TileShape::N ? args.problemShape.n() : L1TileShape::N);
return static_cast<size_t>(L1TileShape::M) * n * args.aicCoreNum * WORKSPACE_STAGES * sizeof(uint32_t);
}
DIRECT_DEVICE
DirectGrouped()
{
Arch::FlagID flagId = 0;
for (uint32_t stageId = 0; stageId < WORKSPACE_STAGES; ++stageId) {
flagAicFinishStoreList[stageId] = Arch::CrossCoreFlag(flagId++);
flagAivFinishComputeList[stageId] = Arch::CrossCoreFlag(flagId++);
}
}
DIRECT_DEVICE void operator()(Params const &params) {
if constexpr (g_coreType == AscendC::AIC) RunCube(params);
else RunVector(params);
}
DIRECT_DEVICE void RunCube(Params const &params)
{
AscendC::ICachePreLoad(1);
BlockScheduler blockScheduler;
BlockMmad blockMmad(resource);
AscendC::GlobalTensor<ElementA> gmA;
gmA.SetGlobalBuffer(params.ptrA);
AscendC::GlobalTensor<ElementGroupList> groupList;
groupList.SetGlobalBuffer(params.ptrGroupList);
uint32_t coreIdx = AscendC::GetBlockIdx();
uint32_t coreNum = AscendC::GetBlockNum();
int64_t gmGroupOffsetA = 0;
int64_t gmGroupOffsetB = 0;
AscendC::GlobalTensor<ElementC> gmC;
gmC.SetGlobalBuffer(reinterpret_cast<__gm__ ElementC *>(params.ptrWorkspace));
const uint32_t workspaceN = RoundUp<16>(params.problemShape.n() < L1TileShape::N ? params.problemShape.n() : L1TileShape::N);
auto layoutC = layout::RowMajor{L1TileShape::M * coreNum * WORKSPACE_STAGES, workspaceN};
uint32_t totalTasks = 0;
uint32_t passM = 0;
for (uint32_t g = 0; g < params.problemCount; ++g) {
uint32_t endM = static_cast<uint32_t>(groupList.GetValue(g));
uint32_t curMp = endM - passM;
passM = endM;
blockScheduler.Update(GemmCoord{curMp, params.problemShape.n(), params.problemShape.k()},
MakeCoord(L1TileShape::M, L1TileShape::N));
totalTasks += blockScheduler.GetCoreLoops();
}
uint32_t stageId = 0;
uint32_t stageUsed = 0;
uint32_t curG = 0;
uint32_t curBase = 0;
uint32_t curM = static_cast<uint32_t>(groupList.GetValue(0));
GemmCoord curShape{curM, params.problemShape.n(), params.problemShape.k()};
LayoutA layoutA = params.layoutA.GetTileLayout(curShape.GetCoordMK());
LayoutB layoutB = params.layoutB;
blockScheduler.Update(curShape, MakeCoord(L1TileShape::M, L1TileShape::N));
uint32_t curLoops = blockScheduler.GetCoreLoops();
AscendC::GlobalTensor<ElementB> gmB;
gmB.SetGlobalBuffer(params.ptrB);
for (uint32_t taskIdx = coreIdx; taskIdx < totalTasks; taskIdx += coreNum) {
while (taskIdx >= curBase + curLoops) {
gmGroupOffsetA += curShape.m() * curShape.k();
gmGroupOffsetB += int64_t(curShape.k()) * layoutB.stride(0);
curBase += curLoops;
++curG;
uint32_t endM = static_cast<uint32_t>(groupList.GetValue(curG));
uint32_t prevM = static_cast<uint32_t>(groupList.GetValue(curG - 1));
curShape = GemmCoord{endM - prevM, params.problemShape.n(), params.problemShape.k()};
layoutA = params.layoutA.GetTileLayout(curShape.GetCoordMK());
blockScheduler.Update(curShape, MakeCoord(L1TileShape::M, L1TileShape::N));
curLoops = blockScheduler.GetCoreLoops();
gmB.SetGlobalBuffer(params.ptrB + gmGroupOffsetB);
}
uint32_t loopIdx = taskIdx - curBase;
GemmCoord blockCoord = blockScheduler.GetBlockCoord(loopIdx);
GemmCoord actualBlockShape = blockScheduler.GetActualBlockShape(blockCoord);
const bool waitBeforeFixpipe = stageUsed == WORKSPACE_STAGES;
if (!waitBeforeFixpipe) ++stageUsed;
MatrixCoord offsetA{blockCoord.m() * L1TileShape::M, blockCoord.k() * L1TileShape::K};
MatrixCoord offsetB{blockCoord.k() * L1TileShape::K, blockCoord.n() * L1TileShape::N};
MatrixCoord offsetC{(stageId * coreNum + coreIdx) * L1TileShape::M, 0};
int64_t gmOffsetA = layoutA.GetOffset(offsetA);
int64_t gmOffsetB = layoutB.GetOffset(offsetB);
int64_t gmOffsetC = layoutC.GetOffset(offsetC);
if (waitBeforeFixpipe) Arch::Wait(flagAivFinishComputeList[stageId]);
blockMmad(
gmA[gmGroupOffsetA + gmOffsetA], layoutA,
gmB[gmOffsetB], layoutB,
gmC[gmOffsetC], layoutC,
actualBlockShape
);
Arch::Signal<PIPE_FIX>(flagAicFinishStoreList[stageId]);
stageId = (stageId + 1 < WORKSPACE_STAGES) ? (stageId + 1) : 0;
}
while (stageUsed > 0) {
uint32_t aivComputeStageId = (stageId >= stageUsed) ?
(stageId - stageUsed) : (stageId + WORKSPACE_STAGES - stageUsed);
Arch::Wait(flagAivFinishComputeList[aivComputeStageId]);
--stageUsed;
}
AscendC::PipeBarrier<PIPE_ALL>();
}
DIRECT_DEVICE void RunVector(Params const &params)
{
AscendC::ICachePreLoad(1);
BlockScheduler blockScheduler;
BlockEpilogue blockEpilogue(resource);
uint32_t coreIdx = AscendC::GetBlockIdx() / AscendC::GetSubBlockNum();
uint32_t coreNum = AscendC::GetBlockNum();
int64_t gmGroupOffsetScale = 0;
int64_t gmGroupOffsetD = 0;
AscendC::GlobalTensor<ElementGroupList> groupList;
groupList.SetGlobalBuffer(params.ptrGroupList);
AscendC::GlobalTensor<ElementC> gmC;
gmC.SetGlobalBuffer(reinterpret_cast<__gm__ ElementC *>(params.ptrWorkspace));
const uint32_t workspaceN = RoundUp<16>(params.problemShape.n() < L1TileShape::N ? params.problemShape.n() : L1TileShape::N);
auto layoutC = layout::RowMajor{L1TileShape::M * coreNum * WORKSPACE_STAGES, workspaceN};
uint32_t stageId = 0;
uint32_t startCoreIdx = 0;
for (uint32_t groupIdx = 0; groupIdx < params.problemCount; ++groupIdx) {
uint32_t currentM = (groupIdx == 0) ? groupList.GetValue(groupIdx) :
(groupList.GetValue(groupIdx) - groupList.GetValue(groupIdx - 1));
GemmCoord inGroupProblemShape{currentM, params.problemShape.n(), params.problemShape.k()};
LayoutScale layoutScale = params.layoutScale;
LayoutD layoutD = params.layoutD.GetTileLayout(inGroupProblemShape.GetCoordMN());
EpilogueParams epilogueParams{
params.ptrScale + gmGroupOffsetScale, layoutScale,
params.ptrD + gmGroupOffsetD, layoutD
};
blockScheduler.Update(inGroupProblemShape, L1TileShape::ToCoordMN());
blockEpilogue.UpdateParams(epilogueParams);
uint32_t coreLoops = blockScheduler.GetCoreLoops();
GemmCoord blockShapeMNK = L1TileShape::ToCoord();
uint32_t startLoopIdx = ((coreIdx < startCoreIdx) ? (coreIdx + coreNum) : coreIdx) - startCoreIdx;
for (uint32_t loopIdx = startLoopIdx; loopIdx < coreLoops; loopIdx += coreNum) {
GemmCoord blockCoordMNK = blockScheduler.GetBlockCoord(loopIdx);
GemmCoord actualBlockShapeMNK = blockScheduler.GetActualBlockShape(blockCoordMNK);
MatrixCoord offsetC{(stageId * coreNum + coreIdx) * L1TileShape::M, 0};
int64_t gmOffsetC = layoutC.GetOffset(offsetC);
auto gmBlockC = gmC[gmOffsetC];
auto layoutBlockC = layoutC.GetTileLayout(actualBlockShapeMNK.GetCoordMN());
Arch::Wait(flagAicFinishStoreList[stageId]);
blockEpilogue(blockShapeMNK, blockCoordMNK, actualBlockShapeMNK, gmBlockC, layoutBlockC);
Arch::Signal<PIPE_MTE3>(flagAivFinishComputeList[stageId]);
stageId = (stageId + 1 < WORKSPACE_STAGES) ? (stageId + 1) : 0;
}
gmGroupOffsetScale += inGroupProblemShape.n();
gmGroupOffsetD += inGroupProblemShape.m() * inGroupProblemShape.n();
startCoreIdx = (startCoreIdx + coreLoops) % coreNum;
}
AscendC::PipeBarrier<PIPE_ALL>();
}
private:
Arch::CrossCoreFlag flagAicFinishStoreList[WORKSPACE_STAGES];
Arch::CrossCoreFlag flagAivFinishComputeList[WORKSPACE_STAGES];
Arch::Resource resource;
};
template<class BlockMmad_, class BlockEpilogue_>
class DescriptorGrouped {
public:
using BlockMmad = BlockMmad_;
using L1TileShape = typename BlockMmad::L1TileShape;
using ElementA = int8_t;
using ElementB = int8_t;
using ElementC = int32_t;
using ElementGroupList = int64_t;
using LayoutA = layout::RowMajor;
using LayoutB = layout::RowMajor;
using LayoutC = layout::RowMajor;
using LayoutD = layout::RowMajor;
using LayoutScale = layout::VectorLayout;
using BlockEpilogue = BlockEpilogue_;
using EpilogueParams = typename BlockEpilogue::Params;
using BlockScheduler = RowSwizzle3;
static constexpr uint32_t WORKSPACE_STAGES = 2;
using Params = GroupParams;
DIRECT_DEVICE
DescriptorGrouped()
{
Arch::FlagID flagId = 0;
for (uint32_t stageId = 0; stageId < WORKSPACE_STAGES; ++stageId) {
flagAicFinishStoreList[stageId] = Arch::CrossCoreFlag(flagId++);
flagAivFinishComputeList[stageId] = Arch::CrossCoreFlag(flagId++);
}
}
DIRECT_DEVICE void operator()(Params const &params) {
if constexpr (g_coreType == AscendC::AIC) RunCube(params);
else RunVector(params);
}
DIRECT_DEVICE void RunCube(Params const &params)
{
AscendC::ICachePreLoad(1);
BlockScheduler blockScheduler;
BlockMmad blockMmad(resource);
AscendC::GlobalTensor<ElementA> gmA;
gmA.SetGlobalBuffer(params.ptrA);
AscendC::GlobalTensor<ElementGroupList> groupList;
groupList.SetGlobalBuffer(params.ptrGroupList);
uint32_t coreIdx = AscendC::GetBlockIdx();
uint32_t coreNum = AscendC::GetBlockNum();
int64_t gmGroupOffsetA = 0;
int64_t gmGroupOffsetB = 0;
AscendC::GlobalTensor<ElementC> gmC;
gmC.SetGlobalBuffer(reinterpret_cast<__gm__ ElementC *>(params.ptrWorkspace));
const uint32_t workspaceN = RoundUp<16>(params.problemShape.n() < L1TileShape::N ? params.problemShape.n() : L1TileShape::N);
auto layoutC = layout::RowMajor{L1TileShape::M * coreNum * WORKSPACE_STAGES, workspaceN};
uint32_t stageId = 0;
uint32_t stageUsed = 0;
uint32_t startCoreIdx = 0;
for (uint32_t groupIdx = 0; groupIdx < params.problemCount; ++groupIdx) {
uint32_t currentM = (groupIdx == 0) ? groupList.GetValue(groupIdx) :
(groupList.GetValue(groupIdx) - groupList.GetValue(groupIdx - 1));
GemmCoord inGroupProblemShape{currentM, params.problemShape.n(), params.problemShape.k()};
LayoutA layoutA = params.layoutA.GetTileLayout(inGroupProblemShape.GetCoordMK());
LayoutB layoutB = params.layoutB;
blockScheduler.Update(inGroupProblemShape, MakeCoord(L1TileShape::M, L1TileShape::N));
uint32_t coreLoops = blockScheduler.GetCoreLoops();
AscendC::GlobalTensor<ElementB> gmB;
gmB.SetGlobalBuffer(params.ptrB + gmGroupOffsetB);
uint32_t startLoopIdx = ((coreIdx < startCoreIdx) ? (coreIdx + coreNum) : coreIdx) - startCoreIdx;
for (uint32_t loopIdx = startLoopIdx; loopIdx < coreLoops; loopIdx += coreNum) {
GemmCoord blockCoord = blockScheduler.GetBlockCoord(loopIdx);
GemmCoord actualBlockShape = blockScheduler.GetActualBlockShape(blockCoord);
const bool waitBeforeFixpipe = stageUsed == WORKSPACE_STAGES;
if (!waitBeforeFixpipe) ++stageUsed;
MatrixCoord offsetA{blockCoord.m() * L1TileShape::M, blockCoord.k() * L1TileShape::K};
MatrixCoord offsetB{blockCoord.k() * L1TileShape::K, blockCoord.n() * L1TileShape::N};
MatrixCoord offsetC{(stageId * coreNum + coreIdx) * L1TileShape::M, 0};
int64_t gmOffsetA = layoutA.GetOffset(offsetA);
int64_t gmOffsetB = layoutB.GetOffset(offsetB);
int64_t gmOffsetC = layoutC.GetOffset(offsetC);
if (waitBeforeFixpipe) Arch::Wait(flagAivFinishComputeList[stageId]);
blockMmad(
gmA[gmGroupOffsetA + gmOffsetA], layoutA,
gmB[gmOffsetB], layoutB,
gmC[gmOffsetC], layoutC,
actualBlockShape
);
Publish(params,stageId,coreIdx,coreNum,
static_cast<uint64_t>(gmGroupOffsetA/params.problemShape.k()+blockCoord.m()*L1TileShape::M)*params.problemShape.n()+blockCoord.n()*L1TileShape::N,
static_cast<uint64_t>(groupIdx)*params.problemShape.n()+blockCoord.n()*L1TileShape::N,
actualBlockShape.m(),actualBlockShape.n(),false);
Arch::Signal<PIPE_FIX>(flagAicFinishStoreList[stageId]);
stageId = (stageId + 1 < WORKSPACE_STAGES) ? (stageId + 1) : 0;
}
gmGroupOffsetA += inGroupProblemShape.m() * inGroupProblemShape.k();
gmGroupOffsetB += inGroupProblemShape.k() * inGroupProblemShape.n();
startCoreIdx = (startCoreIdx + coreLoops) % coreNum;
}
if(stageUsed==WORKSPACE_STAGES)
Arch::Wait(flagAivFinishComputeList[stageId]);
else ++stageUsed;
Publish(params,stageId,coreIdx,coreNum,0,0,0,0,true);
Arch::Signal<PIPE_FIX>(flagAicFinishStoreList[stageId]);
stageId=(stageId+1<WORKSPACE_STAGES)?stageId+1:0;
while (stageUsed > 0) {
uint32_t aivComputeStageId = (stageId >= stageUsed) ?
(stageId - stageUsed) : (stageId + WORKSPACE_STAGES - stageUsed);
Arch::Wait(flagAivFinishComputeList[aivComputeStageId]);
--stageUsed;
}
AscendC::PipeBarrier<PIPE_ALL>();
}
DIRECT_DEVICE void RunVector(Params const &params)
{
AscendC::ICachePreLoad(1);
BlockEpilogue blockEpilogue(resource);
const uint32_t coreIdx=AscendC::GetBlockIdx()/AscendC::GetSubBlockNum();
const uint32_t coreNum=AscendC::GetBlockNum();
const uint32_t workspaceN=RoundUp<16>(params.problemShape.n()<L1TileShape::N?params.problemShape.n():L1TileShape::N);
auto layoutC=layout::RowMajor{L1TileShape::M*coreNum*WORKSPACE_STAGES,workspaceN};
AscendC::GlobalTensor<ElementC>gmC;
gmC.SetGlobalBuffer(reinterpret_cast<__gm__ ElementC*>(params.ptrWorkspace));
AscendC::GlobalTensor<uint64_t>desc;
const uint64_t cBytes=uint64_t(L1TileShape::M)*workspaceN*coreNum*WORKSPACE_STAGES*sizeof(ElementC);
desc.SetGlobalBuffer(reinterpret_cast<__gm__ uint64_t*>(params.ptrWorkspace+cBytes));
uint32_t stageId=0;
while(true){
Arch::Wait(flagAicFinishStoreList[stageId]);
const uint32_t base=(stageId*coreNum+coreIdx)*64;
AscendC::DataCacheCleanAndInvalid<uint64_t,AscendC::CacheLine::SINGLE_CACHE_LINE,AscendC::DcciDst::CACHELINE_OUT>(desc[base]);
AscendC::PipeBarrier<PIPE_ALL>();
const uint64_t done=desc.GetValue(base+3);
if(done){
Arch::Signal<PIPE_MTE3>(flagAivFinishComputeList[stageId]);
break;
}
const uint64_t outputOffset=desc.GetValue(base);
const uint64_t scaleOffset=desc.GetValue(base+1);
const uint64_t dims=desc.GetValue(base+2);
const uint32_t rows=static_cast<uint32_t>(dims),cols=static_cast<uint32_t>(dims>>32);
EpilogueParams epilogueParams{params.ptrScale+scaleOffset,params.layoutScale,
params.ptrD+outputOffset,LayoutD{rows,params.problemShape.n()}};
blockEpilogue.UpdateParams(epilogueParams);
const MatrixCoord offsetC{(stageId*coreNum+coreIdx)*L1TileShape::M,0};
auto gmBlockC=gmC[layoutC.GetOffset(offsetC)];
const GemmCoord actual{rows,cols,params.problemShape.k()};
blockEpilogue(L1TileShape::ToCoord(),GemmCoord{0,0,0},actual,gmBlockC,
layoutC.GetTileLayout(actual.GetCoordMN()));
Arch::Signal<PIPE_MTE3>(flagAivFinishComputeList[stageId]);
stageId=(stageId+1<WORKSPACE_STAGES)?stageId+1:0;
}
AscendC::PipeBarrier<PIPE_ALL>();
}
private:
DIRECT_DEVICE
void Publish(Params const&params,uint32_t stage,uint32_t core,uint32_t cores,
uint64_t yoff,uint64_t soff,uint32_t rows,uint32_t cols,bool done){
const uint32_t workspaceN=RoundUp<16>(params.problemShape.n()<L1TileShape::N?params.problemShape.n():L1TileShape::N);
const uint64_t cBytes=uint64_t(L1TileShape::M)*workspaceN*cores*WORKSPACE_STAGES*sizeof(ElementC);
AscendC::GlobalTensor<uint64_t>desc;
desc.SetGlobalBuffer(reinterpret_cast<__gm__ uint64_t*>(params.ptrWorkspace+cBytes));
const uint32_t base=(stage*cores+core)*64;
desc.SetValue(base,yoff);desc.SetValue(base+1,soff);
desc.SetValue(base+2,uint64_t(rows)|(uint64_t(cols)<<32));desc.SetValue(base+3,done?1ULL:0ULL);
AscendC::DataCacheCleanAndInvalid<uint64_t,AscendC::CacheLine::SINGLE_CACHE_LINE,AscendC::DcciDst::CACHELINE_OUT>(desc[base]);
AscendC::PipeBarrier<PIPE_ALL>();
}
Arch::CrossCoreFlag flagAicFinishStoreList[WORKSPACE_STAGES];
Arch::CrossCoreFlag flagAivFinishComputeList[WORKSPACE_STAGES];
Arch::Resource resource;
};
template<class BlockMmad_, class BlockEpilogue_>
class RotationGrouped {
public:
using BlockMmad = BlockMmad_;
using L1TileShape = typename BlockMmad::L1TileShape;
using ElementA = int8_t;
using ElementB = int8_t;
using ElementC = int32_t;
using ElementGroupList = int64_t;
using LayoutA = layout::RowMajor;
using LayoutB = layout::RowMajor;
using LayoutC = layout::RowMajor;
using LayoutD = layout::RowMajor;
using LayoutScale = layout::VectorLayout;
using BlockEpilogue = BlockEpilogue_;
using EpilogueParams = typename BlockEpilogue::Params;
using BlockScheduler = RowSwizzle3;
static constexpr uint32_t WORKSPACE_STAGES = 2;
using Params = GroupParams;
DIRECT_DEVICE
RotationGrouped(uint32_t low, uint32_t rotateLow, uint32_t rotateHigh) :
lowerRows(low), rotationLow(rotateLow), rotationHigh(rotateHigh)
{
Arch::FlagID flagId = 0;
for (uint32_t stageId = 0; stageId < WORKSPACE_STAGES; ++stageId) {
flagAicFinishStoreList[stageId] = Arch::CrossCoreFlag(flagId++);
flagAivFinishComputeList[stageId] = Arch::CrossCoreFlag(flagId++);
}
}
DIRECT_DEVICE void operator()(Params const &params) {
if constexpr (g_coreType == AscendC::AIC) RunCube(params);
else RunVector(params);
}
DIRECT_DEVICE void RunCube(Params const &params)
{
AscendC::ICachePreLoad(1);
BlockScheduler blockScheduler;
BlockMmad blockMmad(resource);
AscendC::GlobalTensor<ElementA> gmA;
gmA.SetGlobalBuffer(params.ptrA);
AscendC::GlobalTensor<ElementGroupList> groupList;
groupList.SetGlobalBuffer(params.ptrGroupList);
uint32_t coreIdx = AscendC::GetBlockIdx();
uint32_t coreNum = AscendC::GetBlockNum();
int64_t gmGroupOffsetA = 0;
int64_t gmGroupOffsetB = 0;
AscendC::GlobalTensor<ElementC> gmC;
gmC.SetGlobalBuffer(reinterpret_cast<__gm__ ElementC *>(params.ptrWorkspace));
const uint32_t workspaceN = RoundUp<16>(params.problemShape.n() < L1TileShape::N ? params.problemShape.n() : L1TileShape::N);
auto layoutC = layout::RowMajor{L1TileShape::M * coreNum * WORKSPACE_STAGES, workspaceN};
uint32_t stageId = 0;
uint32_t stageUsed = 0;
uint32_t startCoreIdx = 0;
for (uint32_t groupIdx = 0; groupIdx < params.problemCount; ++groupIdx) {
uint32_t currentM = (groupIdx == 0) ? groupList.GetValue(groupIdx) :
(groupList.GetValue(groupIdx) - groupList.GetValue(groupIdx - 1));
GemmCoord inGroupProblemShape{currentM, params.problemShape.n(), params.problemShape.k()};
LayoutA layoutA = params.layoutA.GetTileLayout(inGroupProblemShape.GetCoordMK());
LayoutB layoutB = params.layoutB;
blockScheduler.Update(inGroupProblemShape, MakeCoord(L1TileShape::M, L1TileShape::N));
uint32_t coreLoops = blockScheduler.GetCoreLoops();
AscendC::GlobalTensor<ElementB> gmB;
gmB.SetGlobalBuffer(params.ptrB + gmGroupOffsetB);
uint32_t startLoopIdx = ((coreIdx < startCoreIdx) ? (coreIdx + coreNum) : coreIdx) - startCoreIdx;
for (uint32_t loopIdx = startLoopIdx; loopIdx < coreLoops; loopIdx += coreNum) {
GemmCoord blockCoord = blockScheduler.GetBlockCoord(loopIdx);
GemmCoord actualBlockShape = blockScheduler.GetActualBlockShape(blockCoord);
const bool waitBeforeFixpipe = stageUsed == WORKSPACE_STAGES;
if (!waitBeforeFixpipe) ++stageUsed;
MatrixCoord offsetA{blockCoord.m() * L1TileShape::M, blockCoord.k() * L1TileShape::K};
MatrixCoord offsetB{blockCoord.k() * L1TileShape::K, blockCoord.n() * L1TileShape::N};
MatrixCoord offsetC{(stageId * coreNum + coreIdx) * L1TileShape::M, 0};
int64_t gmOffsetA = layoutA.GetOffset(offsetA);
int64_t gmOffsetB = layoutB.GetOffset(offsetB);
int64_t gmOffsetC = layoutC.GetOffset(offsetC);
if (waitBeforeFixpipe) Arch::Wait(flagAivFinishComputeList[stageId]);
blockMmad(
gmA[gmGroupOffsetA + gmOffsetA], layoutA,
gmB[gmOffsetB], layoutB,
gmC[gmOffsetC], layoutC,
actualBlockShape
);
Arch::Signal<PIPE_FIX>(flagAicFinishStoreList[stageId]);
stageId = (stageId + 1 < WORKSPACE_STAGES) ? (stageId + 1) : 0;
}
gmGroupOffsetA += inGroupProblemShape.m() * inGroupProblemShape.k();
gmGroupOffsetB += inGroupProblemShape.k() * inGroupProblemShape.n();
const uint32_t rotation = currentM == lowerRows ? rotationLow : rotationHigh;
startCoreIdx = (startCoreIdx + coreLoops + rotation) % coreNum;
}
while (stageUsed > 0) {
uint32_t aivComputeStageId = (stageId >= stageUsed) ?
(stageId - stageUsed) : (stageId + WORKSPACE_STAGES - stageUsed);
Arch::Wait(flagAivFinishComputeList[aivComputeStageId]);
--stageUsed;
}
AscendC::PipeBarrier<PIPE_ALL>();
}
DIRECT_DEVICE void RunVector(Params const &params)
{
AscendC::ICachePreLoad(1);
BlockScheduler blockScheduler;
BlockEpilogue blockEpilogue(resource);
uint32_t coreIdx = AscendC::GetBlockIdx() / AscendC::GetSubBlockNum();
uint32_t coreNum = AscendC::GetBlockNum();
int64_t gmGroupOffsetScale = 0;
int64_t gmGroupOffsetD = 0;
AscendC::GlobalTensor<ElementGroupList> groupList;
groupList.SetGlobalBuffer(params.ptrGroupList);
AscendC::GlobalTensor<ElementC> gmC;
gmC.SetGlobalBuffer(reinterpret_cast<__gm__ ElementC *>(params.ptrWorkspace));
const uint32_t workspaceN = RoundUp<16>(params.problemShape.n() < L1TileShape::N ? params.problemShape.n() : L1TileShape::N);
auto layoutC = layout::RowMajor{L1TileShape::M * coreNum * WORKSPACE_STAGES, workspaceN};
uint32_t stageId = 0;
uint32_t startCoreIdx = 0;
for (uint32_t groupIdx = 0; groupIdx < params.problemCount; ++groupIdx) {
uint32_t currentM = (groupIdx == 0) ? groupList.GetValue(groupIdx) :
(groupList.GetValue(groupIdx) - groupList.GetValue(groupIdx - 1));
GemmCoord inGroupProblemShape{currentM, params.problemShape.n(), params.problemShape.k()};
LayoutScale layoutScale = params.layoutScale;
LayoutD layoutD = params.layoutD.GetTileLayout(inGroupProblemShape.GetCoordMN());
EpilogueParams epilogueParams{
params.ptrScale + gmGroupOffsetScale, layoutScale,
params.ptrD + gmGroupOffsetD, layoutD
};
blockScheduler.Update(inGroupProblemShape, L1TileShape::ToCoordMN());
blockEpilogue.UpdateParams(epilogueParams);
uint32_t coreLoops = blockScheduler.GetCoreLoops();
GemmCoord blockShapeMNK = L1TileShape::ToCoord();
uint32_t startLoopIdx = ((coreIdx < startCoreIdx) ? (coreIdx + coreNum) : coreIdx) - startCoreIdx;
for (uint32_t loopIdx = startLoopIdx; loopIdx < coreLoops; loopIdx += coreNum) {
GemmCoord blockCoordMNK = blockScheduler.GetBlockCoord(loopIdx);
GemmCoord actualBlockShapeMNK = blockScheduler.GetActualBlockShape(blockCoordMNK);
MatrixCoord offsetC{(stageId * coreNum + coreIdx) * L1TileShape::M, 0};
int64_t gmOffsetC = layoutC.GetOffset(offsetC);
auto gmBlockC = gmC[gmOffsetC];
auto layoutBlockC = layoutC.GetTileLayout(actualBlockShapeMNK.GetCoordMN());
Arch::Wait(flagAicFinishStoreList[stageId]);
blockEpilogue(blockShapeMNK, blockCoordMNK, actualBlockShapeMNK, gmBlockC, layoutBlockC);
Arch::Signal<PIPE_MTE3>(flagAivFinishComputeList[stageId]);
stageId = (stageId + 1 < WORKSPACE_STAGES) ? (stageId + 1) : 0;
}
gmGroupOffsetScale += inGroupProblemShape.n();
gmGroupOffsetD += inGroupProblemShape.m() * inGroupProblemShape.n();
const uint32_t rotation = currentM == lowerRows ? rotationLow : rotationHigh;
startCoreIdx = (startCoreIdx + coreLoops + rotation) % coreNum;
}
AscendC::PipeBarrier<PIPE_ALL>();
}
private:
Arch::CrossCoreFlag flagAicFinishStoreList[WORKSPACE_STAGES];
Arch::CrossCoreFlag flagAivFinishComputeList[WORKSPACE_STAGES];
uint32_t lowerRows, rotationLow, rotationHigh;
Arch::Resource resource;
};
}
namespace public_gmg {
using namespace AscendC;
using namespace direct_core;
struct Buffer {
LocalTensor<uint8_t> tensor;
template<class T> __aicore__ __forceinline__ LocalTensor<T> Get() { return tensor.ReinterpretCast<T>(); }
};
class StableEpilogue {
public:
using ElementScale = float;
using LayoutScale = layout::VectorLayout;
using ElementD = half;
using LayoutD = layout::RowMajor;
struct Params {
__gm__ float *sp;
LayoutScale sl;
__gm__ half *yp;
LayoutD yl;
__aicore__ __forceinline__ Params() {}
__aicore__ __forceinline__ Params(__gm__ float *s, LayoutScale a, __gm__ half *y, LayoutD c) :
sp(s), sl(a), yp(y), yl(c) {}
};
__aicore__ __forceinline__ StableEpilogue(Arch::Resource &resource) {
uint32_t offset = 0;
Buffer *buffers[] = {&cb, &zb, &qb, &tb, &db, &sb, &yb, &m0b, &m1b};
uint32_t sizes[] = {elements * 4, elements * 4, elements * 4, elements * 4,
elements * 4, 256 * 4, elements * 2, elements / 8 + 32, elements / 8 + 32};
for (uint32_t i = 0; i < 9; ++i) {
buffers[i]->tensor = resource.ubBuf.GetBufferByByte<uint8_t>(offset);
offset += sizes[i];
}
}
__aicore__ __forceinline__ void UpdateParams(Params const &p) {
params = p;
plan.n = p.yl.stride(0);
scale.SetGlobalBuffer(p.sp);
y.SetGlobalBuffer(p.yp);
}
__aicore__ __forceinline__ void operator()(GemmCoord const &shape, GemmCoord const &coord,
GemmCoord const &actual, GlobalTensor<int32_t> const &src,
