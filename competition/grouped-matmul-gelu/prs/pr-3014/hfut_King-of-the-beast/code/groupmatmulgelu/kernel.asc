namespace direct_core {
template<class BlockMmad_,class BlockEpilogue_,uint32_t SPLITS>
class HBSplit015 {
public:
using BlockMmad=BlockMmad_;using BlockEpilogue=BlockEpilogue_;using Params=GroupParams;
using L1TileShape=typename BlockMmad::L1TileShape;using EpilogueParams=typename BlockEpilogue::Params;
static constexpr uint32_t TM=512,TN=256,TILE=TM*TN;
struct Job {uint32_t expert,rowBase,index,slice,kBase;GemmCoord coord,actual;};
class Iterator {
public:
DIRECT_DEVICE Iterator(Params const&p,uint32_t core,uint32_t count,uint32_t s,bool useAdaptive=true):p(p),nextTask(core),cores(count),splits(s),adaptive(useAdaptive){groups.SetGlobalBuffer(p.ptrGroupList);}
DIRECT_DEVICE bool Next(Job&job){
while(group<p.problemCount){
if(!loaded){end=groups.GetValue(group);rows=end-rowBase;ml=CeilDiv(rows,TM);nl=CeilDiv(p.problemShape.n(),TN);tailSplits=(adaptive && splits==SPLITS && p.problemShape.n()-(nl-1)*TN<=32)?4:splits;rowTasks=(nl-1)*splits+tailSplits;tiles=ml*rowTasks;loaded=true;}
if(nextTask>=begin+tiles){begin+=tiles;indexBase+=ml*nl;rowBase=end;++group;loaded=false;continue;}
uint32_t task=nextTask-begin,mt=task/rowTasks,local=task%rowTasks,full=(nl-1)*splits;uint32_t nc=local<full?local/splits:nl-1,sp=local<full?local%splits:local-full;uint32_t activeSplits=(local<full?splits:tailSplits),idx=mt*nl+nc;GemmCoord c{mt,nc,0};
job.expert=group;job.rowBase=rowBase;job.index=indexBase+idx;job.slice=sp;
uint32_t part=CeilDiv(p.problemShape.k(),(splits==SPLITS?activeSplits:SPLITS)*32)*32;job.kBase=job.slice*part;
job.coord=c;job.actual={min(rows-c.m()*TM,TM),min(p.problemShape.n()-c.n()*TN,TN),min(p.problemShape.k()-job.kBase,part)};
nextTask+=cores;return true;
}
return false;
}
private:
Params const&p;AscendC::GlobalTensor<int64_t>groups;uint32_t nextTask,cores,splits,group=0,rowBase=0,end=0,rows=0,ml=0,nl=0,tiles=0,begin=0,indexBase=0,tailSplits=0,rowTasks=0;bool loaded=false,adaptive=true;
};
DIRECT_DEVICE void Clear(Params const&p){
auto tmp=resource.ubBuf.GetBufferByByte<int32_t>(0);AscendC::GlobalTensor<int32_t>c;AscendC::GlobalTensor<int64_t>groups;
c.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(p.ptrWorkspace));groups.SetGlobalBuffer(p.ptrGroupList);
AscendC::Duplicate(tmp,static_cast<int32_t>(0),8192);
AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
uint32_t core=AscendC::GetBlockIdx(),count=AscendC::GetBlockNum()*AscendC::GetSubBlockNum(),base=0,prefix=0,nl=CeilDiv(p.problemShape.n(),TN);
for(uint32_t g=0;g<p.problemCount;++g){
uint32_t end=groups.GetValue(g),rows=end-base;
for(uint32_t job=core;job<CeilDiv<32>(rows)*nl;job+=count){
uint32_t row=(job/nl)*32,col=job%nl,tile=prefix+(row/TM)*nl+col;
AscendC::DataCopy(c[uint64_t(tile)*TILE+(row%TM)*TN],tmp,min(rows-row,32U)*TN);
}
prefix+=CeilDiv(rows,TM)*nl;base=end;
}
AscendC::PipeBarrier<PIPE_ALL>();
}
DIRECT_DEVICE void operator()(Params const&p){
if constexpr(g_coreType==AscendC::AIV)Clear(p);
AscendC::SyncAll<false>();
if constexpr(g_coreType==AscendC::AIC)Cube(p);
AscendC::SyncAll<false>();
if constexpr(g_coreType==AscendC::AIV)Vector(p);
}
DIRECT_DEVICE void Cube(Params const&p){
AscendC::ICachePreLoad(1);BlockMmad mma(resource);Iterator jobs(p,AscendC::GetBlockIdx(),AscendC::GetBlockNum(),SPLITS);Job job;
AscendC::GlobalTensor<int8_t>a,b;AscendC::GlobalTensor<int32_t>c;
a.SetGlobalBuffer(p.ptrA);b.SetGlobalBuffer(p.ptrB);c.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(p.ptrWorkspace));
AscendC::SetAtomicAdd<int32_t>();
while(jobs.Next(job)){
mma(a[uint64_t(job.rowBase+job.coord.m()*TM)*p.problemShape.k()+job.kBase],p.layoutA,
b[uint64_t(job.expert)*p.problemShape.k()*p.problemShape.n()+job.coord.n()*TN+uint64_t(job.kBase)*p.problemShape.n()],p.layoutB,
c[uint64_t(job.index)*TILE],layout::RowMajor{TM,TN},job.actual);
}
AscendC::PipeBarrier<PIPE_ALL>();AscendC::SetAtomicNone();
}
DIRECT_DEVICE void Vector(Params const&p){
AscendC::ICachePreLoad(1);BlockEpilogue ep(resource);uint32_t core=AscendC::GetBlockIdx()/AscendC::GetSubBlockNum();
Iterator jobs(p,core,AscendC::GetBlockNum(),8,false);Job job;AscendC::GlobalTensor<int32_t>c;
c.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(p.ptrWorkspace));
while(jobs.Next(job)){
uint32_t row=job.slice*64;if(row>=job.actual.m())continue;
uint32_t rows=min(job.actual.m()-row,64U);
EpilogueParams e{p.ptrScale+uint64_t(job.expert)*p.problemShape.n(),p.layoutScale,p.ptrD+uint64_t(job.rowBase+job.coord.m()*TM+row)*p.problemShape.n(),p.layoutD};ep.UpdateParams(e);
auto src=c[uint64_t(job.index)*TILE+row*TN];auto cl=layout::RowMajor{TM,TN}.GetTileLayout(MakeCoord(rows,job.actual.n()));
ep(GemmCoord{TM,TN,512},GemmCoord{0,job.coord.n(),0},GemmCoord{rows,job.actual.n(),job.actual.k()},src,cl);
}
AscendC::PipeBarrier<PIPE_ALL>();
}
private:Arch::Resource resource;
};
struct HBResident015 : public public_gmg::Mmad {
using L1TileShape=GemmShape<512,256,512>;AscendC::LocalTensor<int8_t>bfull,normalA[2],tailA[2],normalB,tailB;
DIRECT_DEVICE HBResident015(Arch::Resource&r):public_gmg::Mmad(r){
l1ATensorList[0]=r.l1Buf.GetBufferByByte<int8_t>(0);l1ATensorList[1]=r.l1Buf.GetBufferByByte<int8_t>(114688);bfull=r.l1Buf.GetBufferByByte<int8_t>(229376);normalB=bfull;tailB=r.l1Buf.GetBufferByByte<int8_t>(393216);for(uint32_t i=0;i<2;++i){normalA[i]=l1ATensorList[i];tailA[i]=r.l1Buf.GetBufferByByte<int8_t>(i*196608);}
}
DIRECT_DEVICE void operator()(AscendC::GlobalTensor<ElementA>const&ga,LayoutA const&al,AscendC::GlobalTensor<ElementB>const&gb,LayoutB const&bl,AscendC::GlobalTensor<ElementC>const&gc,LayoutC const&cl,GemmCoord const&s){
const bool tailWide=s.k()>1024;const uint32_t mstep=tailWide?96:112;for(uint32_t i=0;i<2;++i)l1ATensorList[i]=tailWide?tailA[i]:normalA[i];bfull=tailWide?tailB:normalB;
uint32_t pk=RoundUp<32>(s.k()),nr=RoundUp<32>(s.n()),parts=CeilDiv<128>(s.k());auto lb=LayoutBInL1::MakeLayout<int8_t>(pk,s.k()>1024?nr:256);auto la=LayoutAInL1::MakeLayout<int8_t>(mstep,pk);
