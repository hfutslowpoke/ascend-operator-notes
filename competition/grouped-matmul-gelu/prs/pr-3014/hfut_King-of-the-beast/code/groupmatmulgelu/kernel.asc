SetFlag<HardEvent::S_V>(EVENT_ID0);
WaitFlag<HardEvent::S_V>(EVENT_ID0);
}
__aicore__ __forceinline__ void Compute64(uint32_t row,uint32_t col,uint32_t vm,uint32_t vn,Arch::CrossCoreFlag &ack) {
const uint32_t e=0, stride=(vn+15)/16*16, len=vm*stride;
auto ci = qb.Get<int32_t>();
auto z = zb.Get<float>();
auto q = qb.Get<float>();
auto s = sb.Get<float>();
auto out = yb.Get<half>();
const uint32_t scaleAligned = (vn + 7) / 8 * 8;
if(accumStride==stride)DataCopy(ci, accum, len);
else DataCopyPad(ci,accum,
DataCopyExtParams{static_cast<uint16_t>(vm),vn*4,(accumStride-vn)*4,0,0},
DataCopyPadExtParams<int32_t>{true,0,0,0});
const bool loadScale = loadedScaleCol != col;
if (loadScale) {
DataCopyPad(s, scale[uint64_t(e) * plan.n + col],
DataCopyExtParams{1, vn * 4, 0, 0, 0},
DataCopyPadExtParams<float>{true, 0, static_cast<uint8_t>((vn+7)/8*8 - vn), 0.0f});
loadedScaleCol = col;
