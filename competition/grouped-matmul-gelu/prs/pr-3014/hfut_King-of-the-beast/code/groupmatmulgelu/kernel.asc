while (flags) {
const uint32_t bit = static_cast<uint32_t>(__builtin_ctzll(flags));
flags &= flags - 1;
const uint32_t i = base + bit;
if (i >= len || (vn != stride && (offset + i) % stride >= vn)) continue;
const float value = z.GetValue(offset + i);
if (value > -8.0f && value < 8.0f)
corrections.SetValue(offset + i, RefineGeluGuarded(value, corrections.GetValue(offset + i)));
