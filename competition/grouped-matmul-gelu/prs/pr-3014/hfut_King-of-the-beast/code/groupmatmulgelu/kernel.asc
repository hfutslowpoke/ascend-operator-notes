namespace public_gmg {
class HaFull64Epilogue {
public:
using ElementScale = BankStableEpilogue::ElementScale;
using LayoutScale = BankStableEpilogue::LayoutScale;
using ElementD = BankStableEpilogue::ElementD;
using LayoutD = BankStableEpilogue::LayoutD;
using Params = BankStableEpilogue::Params;
__aicore__ __forceinline__ HaFull64Epilogue(Arch::Resource &resource) : fallback(resource) {
Buffer *buffers[] = {&zb,&qb,&tb,&db,&sb,&yb,&m0b,&m1b,&kb};
const uint32_t offsets[] = {0,65792,0,65792,164608,131328,165632,167712,169792};
for(uint32_t i=0;i<9;++i)
buffers[i]->tensor=resource.ubBuf.GetBufferByByte<uint8_t>(offsets[i]);
inputReuseEvent=static_cast<event_t>(GetTPipePtr()->FetchEventID(HardEvent::V_MTE2));
outputReuseEvent=static_cast<event_t>(GetTPipePtr()->FetchEventID(HardEvent::MTE3_V));
}
__aicore__ __forceinline__ ~HaFull64Epilogue(){Drain();}
__aicore__ __forceinline__ void Drain(){
if(inputPending){WaitFlag<HardEvent::V_MTE2>(inputReuseEvent);inputPending=false;}
if(outputPending){WaitFlag<HardEvent::MTE3_V>(outputReuseEvent);outputPending=false;}
}
__aicore__ __forceinline__ uint64_t GetOverlapCount()const{return overlapCount;}
__aicore__ __forceinline__ void UpdateParams(Params const &p) {
fallback.UpdateParams(p);
plan.n=p.yl.stride(0); scale.SetGlobalBuffer(p.sp); y.SetGlobalBuffer(p.yp);
}
__aicore__ __forceinline__ void operator()(GemmCoord const &shape, GemmCoord const &coord,
GemmCoord const &actual, GlobalTensor<int32_t> const &src, layout::RowMajor const &srcLayout) {
const uint32_t perSub=(actual.m()+1)/2;
const uint32_t first=GetSubBlockIdx()*perSub;
const uint32_t end=first+perSub<actual.m()?first+perSub:actual.m();
const uint32_t count=end>first?end-first:0;
const uint32_t stride=(actual.n()+15)/16*16;
if(count<=32 || count>64){
Drain();
fallback(shape,coord,actual,src,srcLayout);
return;
}
overlapEnabled=count>=48;
if(!overlapEnabled)Drain();
accumStride=srcLayout.stride(0);
accum=src[uint64_t(first)*accumStride];
Compute64(coord.m()*shape.m()+first,coord.n()*shape.n(),count,actual.n());
}
private:
__aicore__ __forceinline__ void Compute64(uint32_t row,uint32_t col,uint32_t vm,uint32_t vn) {
const uint32_t stride=(vn+15)/16*16;
ComputeChunk(row,col,0,vm,vn,stride);
}
__aicore__ __forceinline__ void ComputeChunk(uint32_t row,uint32_t col,
uint32_t rowOffset,uint32_t vm,uint32_t vn,uint32_t stride) {
const uint32_t e=0, len=vm*stride, dmaStride=(vn+7)/8*8;
auto ci = qb.Get<int32_t>();
auto z = zb.Get<float>();
auto q = qb.Get<float>();
auto s = sb.Get<float>();
auto out = yb.Get<half>();
if(inputPending){WaitFlag<HardEvent::V_MTE2>(inputReuseEvent);inputPending=false;}
if(stride!=dmaStride){Duplicate(ci,static_cast<int32_t>(0),len);Duplicate(s,0.0f,stride);SetFlag<HardEvent::V_MTE2>(EVENT_ID0);WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);}
DataCopyPad(ci, accum[uint64_t(rowOffset) * accumStride],
DataCopyExtParams{static_cast<uint16_t>(vm), vn * 4, (accumStride - vn) * 4, (stride-dmaStride)/8, 0},
DataCopyPadExtParams<int32_t>{true, 0, static_cast<uint8_t>(dmaStride - vn), 0});
DataCopyPad(s, scale[uint64_t(e) * plan.n + col],
DataCopyExtParams{1, vn * 4, 0, 0, 0},
DataCopyPadExtParams<float>{true, 0, static_cast<uint8_t>(dmaStride - vn), 0.0f});
SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
Cast(z, ci, RoundMode::CAST_RINT, len);
PipeBarrier<PIPE_V>();
BinaryRepeatParams br;
br.dstBlkStride = 1; br.src0BlkStride = 1; br.src1BlkStride = 1;
br.dstRepStride = stride / 8; br.src0RepStride = stride / 8; br.src1RepStride = 0;
for (uint32_t c = 0; c < stride; c += 64) {
const uint64_t mask = stride - c < 64 ? stride - c : 64;
Mul(z[c], z[c], s[c], mask, static_cast<uint8_t>(vm), br);
}
PipeBarrier<PIPE_V>();
Mul(q, z, z, len);
PipeBarrier<PIPE_V>();
Muls(q, q, 0.044715f, len);
PipeBarrier<PIPE_V>();
Adds(q, q, 1.0f, len);
PipeBarrier<PIPE_V>();
Mul(q, q, z, len);
PipeBarrier<PIPE_V>();
Muls(q, q, 1.5957691216057308f, len);
PipeBarrier<PIPE_V>();
Muls(q, q, -1.0f, len);
PipeBarrier<PIPE_V>();
Mins(q, q, 87.0f, len);
PipeBarrier<PIPE_V>();
Exp(q, q, len);
PipeBarrier<PIPE_V>();
Adds(q, q, 1.0f, len);
PipeBarrier<PIPE_V>();
Div(q, z, q, len);
PipeBarrier<PIPE_V>();
if(outputPending){WaitFlag<HardEvent::MTE3_V>(outputReuseEvent);outputPending=false;++overlapCount;}
Cast(out,q,RoundMode::CAST_RINT,len);
PipeBarrier<PIPE_V>();
if(overlapEnabled){SetFlag<HardEvent::V_MTE2>(inputReuseEvent);inputPending=true;}
SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
DataCopyPad(y[uint64_t(row)*plan.n+col],out,
DataCopyExtParams{static_cast<uint16_t>(vm),vn*2,
(stride-(vn+15)/16*16)/16,(plan.n-vn)*2,0});
if(overlapEnabled){SetFlag<HardEvent::MTE3_V>(outputReuseEvent);outputPending=true;}
else PipeBarrier<PIPE_ALL>();
}
bool inputPending{false},outputPending{false},overlapEnabled{false};
event_t inputReuseEvent,outputReuseEvent;
uint64_t overlapCount{0};
PackedTailBankStableEpilogue fallback;
uint32_t accumStride;
struct { uint32_t n; } plan;
static constexpr uint32_t elements=16384;
GlobalTensor<float> scale;
GlobalTensor<half> y;
GlobalTensor<int32_t> accum;
Buffer zb,qb,tb,db,sb,yb,m0b,m1b,kb;
};
}
namespace fastexp {
using Tile = direct_core::GemmShape<128, 256, 640>;
using Mmad = direct_core::FastPanelA3DBlock;
using Kernel = direct_core::DirectGrouped<Mmad, public_gmg::HaFull64Epilogue>;
}
extern "C" __global__ __aicore__ void grouped_matmul_gelu_fast(
GM_ADDR x, GM_ADDR w, GM_ADDR scale, GM_ADDR groups, GM_ADDR y,
GM_ADDR scratch, gmg::Plan plan) {
KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
AscendC::SetSyncBaseAddr(plan.ffts);
fastexp::Kernel::Params params{
direct_core::GemmCoord{plan.m, plan.n, plan.k}, plan.e, groups,
x, direct_core::layout::RowMajor{plan.m, plan.k},
w, direct_core::layout::RowMajor{plan.k, plan.n},
scale, direct_core::layout::VectorLayout{plan.n},
y, direct_core::layout::RowMajor{plan.m, plan.n}, scratch};
fastexp::Kernel op;
op(params);
}
namespace ha_pack {
using namespace AscendC;
__aicore__ inline void PackWeights(GM_ADDR wp, GM_ADDR pwp, uint32_t e, uint32_t k,
uint32_t n, uint32_t pn, uint32_t chunk=64) {
TPipe pipe;
TBuf<TPosition::VECCALC> buf;
pipe.InitBuffer(buf, 65536);
auto storage = buf.Get<int8_t>();
GlobalTensor<int8_t> w, pw;
w.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t *>(wp));
pw.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t *>(pwp));
const uint32_t core = GetBlockIdx(), cores = GetBlockNum() * GetSubBlockNum();
const uint64_t totalRows=uint64_t(e)*k;
const uint64_t jobs=(totalRows+chunk-1)/chunk;
const uint32_t slots=pn<=512?2:1;
for(uint32_t i=0;i<slots;++i)SetFlag<HardEvent::MTE3_MTE2>(static_cast<event_t>(i+1));
uint32_t turn=0;
for (uint64_t job=core;job<jobs;job+=cores){
const uint64_t row=job*chunk;
const uint32_t count=static_cast<uint32_t>(totalRows-row<chunk?totalRows-row:chunk);
const uint32_t slot=turn++%slots;
const event_t reuse=static_cast<event_t>(slot+1);
WaitFlag<HardEvent::MTE3_MTE2>(reuse);
auto tmp=storage[slot*32768];
DataCopyPad(tmp, w[row * n],
DataCopyExtParams{static_cast<uint16_t>(count), n, 0,
static_cast<uint32_t>((pn - (n + 31) / 32 * 32) / 32), 0},
DataCopyPadExtParams<int8_t>{true, 0, 0, 0});
SetFlag<HardEvent::MTE2_MTE3>(EVENT_ID0);
WaitFlag<HardEvent::MTE2_MTE3>(EVENT_ID0);
DataCopy(pw[row * pn], tmp, count * pn);
SetFlag<HardEvent::MTE3_MTE2>(reuse);
}
for(uint32_t i=0;i<slots;++i)WaitFlag<HardEvent::MTE3_MTE2>(static_cast<event_t>(i+1));
PipeBarrier<PIPE_ALL>();
}
}
extern "C" __global__ __aicore__ __attribute__((section(".text.zzzzzzzz_ha_pack")))
void grouped_matmul_gelu_fast_packed(GM_ADDR x, GM_ADDR w, GM_ADDR scale, GM_ADDR groups,
GM_ADDR y, GM_ADDR scratch, gmg::Plan plan) {
KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
AscendC::SetSyncBaseAddr(plan.ffts);
const uint32_t pn = (plan.n + 127) / 128 * 128;
const uint32_t workspaceN = (min(plan.n, uint32_t(256)) + 15) / 16 * 16;
const uint64_t cbytes = uint64_t(plan.blocks) * 4 * 128 * workspaceN * 4;
GM_ADDR pw = scratch + cbytes;
if ASCEND_IS_AIV { ha_pack::PackWeights(w, pw, plan.e, plan.k, plan.n, pn); }
AscendC::SyncAll<false>();
fastexp::Kernel::Params params{direct_core::GemmCoord{plan.m, plan.n, plan.k}, plan.e, groups,
x, direct_core::layout::RowMajor{plan.m, plan.k},
pw, direct_core::layout::RowMajor{plan.k, plan.n, pn},
scale, direct_core::layout::VectorLayout{plan.n},
y, direct_core::layout::RowMajor{plan.m, plan.n}, scratch};
fastexp::Kernel op;
op(params);
}
inline bool TryLaunchFastPacked(GM_ADDR x, GM_ADDR w, GM_ADDR scale, GM_ADDR groups,
GM_ADDR y, int64_t e, int64_t m, int64_t k, int64_t n,
int64_t availableCoreNum, aclrtStream stream) {
const bool shapeFits = (k % 16 != 0 || n % 16 != 0) && k >= 64 && k <= 640 &&
n >= 64 && n <= 1024 && m >= 64 * e && (n % 128) != 0;
if (!shapeFits) return false;
auto *platform = platform_ascendc::PlatformAscendCManager::GetInstance();
if (!platform) return false;
const uint32_t blocks = static_cast<uint32_t>(std::min<int64_t>(availableCoreNum,
std::min<int64_t>(platform->GetCoreNumAic(), platform->GetCoreNumAiv() / 2)));
if (blocks == 0) return false;
uint64_t ffts = 0;
uint32_t fftsLen = 0;
if (rtGetC2cCtrlAddr(&ffts, &fftsLen) != 0)
throw std::runtime_error("FFTS address unavailable");
gmg::Plan p{};
p.e = static_cast<uint32_t>(e); p.m = static_cast<uint32_t>(m);
p.k = static_cast<uint32_t>(k); p.n = static_cast<uint32_t>(n);
p.blocks = blocks; p.backend = 1; p.ffts = ffts;
fastexp::Kernel::Arguments args{
direct_core::GemmCoord{static_cast<uint32_t>(m), static_cast<uint32_t>(n),
static_cast<uint32_t>(k)},
static_cast<uint32_t>(e), blocks, groups, x, w, scale, y};
const uint32_t pn = static_cast<uint32_t>((n + 127) / 128 * 128);
const size_t bytes = fastexp::Kernel::GetWorkspaceSize(args)
+ static_cast<size_t>(e) * static_cast<size_t>(k) * pn + 4096;
uint8_t *workspace = nullptr;
if (aclrtMalloc(reinterpret_cast<void **>(&workspace), bytes ? bytes : 1,
ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS)
throw std::runtime_error("Fast packed GMM workspace allocation failed");
grouped_matmul_gelu_fast_packed<<<blocks, nullptr, stream>>>(x, w, scale, groups, y, workspace, p);
const auto status = aclrtSynchronizeStream(stream);
aclrtFree(workspace);
if (status != ACL_SUCCESS) throw std::runtime_error("Fast packed GMM kernel failed");
return true;
}
inline bool TryLaunchFast(GM_ADDR x, GM_ADDR w, GM_ADDR scale, GM_ADDR groups,
GM_ADDR y, int64_t e, int64_t m, int64_t k, int64_t n,
int64_t availableCoreNum, aclrtStream stream) {
const bool shapeFits = (k % 16 != 0 || n % 16 != 0) && k >= 64 && k <= 640 &&
n >= 64 && m >= 64 * e;
if (!shapeFits) return false;
auto *platform = platform_ascendc::PlatformAscendCManager::GetInstance();
if (!platform) return false;
const uint32_t blocks = static_cast<uint32_t>(std::min<int64_t>(availableCoreNum,
std::min<int64_t>(platform->GetCoreNumAic(), platform->GetCoreNumAiv() / 2)));
if (blocks == 0) return false;
uint64_t ffts = 0;
uint32_t fftsLen = 0;
if (rtGetC2cCtrlAddr(&ffts, &fftsLen) != 0)
throw std::runtime_error("FFTS address unavailable");
gmg::Plan p{};
p.e = static_cast<uint32_t>(e); p.m = static_cast<uint32_t>(m);
p.k = static_cast<uint32_t>(k); p.n = static_cast<uint32_t>(n);
p.blocks = blocks; p.backend = 1; p.ffts = ffts;
fastexp::Kernel::Arguments args{
direct_core::GemmCoord{static_cast<uint32_t>(m), static_cast<uint32_t>(n),
static_cast<uint32_t>(k)},
static_cast<uint32_t>(e), blocks, groups, x, w, scale, y};
const auto bytes = fastexp::Kernel::GetWorkspaceSize(args);
uint8_t *workspace = nullptr;
if (aclrtMalloc(reinterpret_cast<void **>(&workspace), bytes ? bytes : 1,
ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS)
throw std::runtime_error("Fast GMM workspace allocation failed");
grouped_matmul_gelu_fast<<<blocks, nullptr, stream>>>(x, w, scale, groups, y, workspace, p);
const auto status = aclrtSynchronizeStream(stream);
aclrtFree(workspace);
if (status != ACL_SUCCESS) throw std::runtime_error("Fast GMM kernel failed");
return true;
}
extern "C" __global__ __aicore__ __attribute__((section(".hel2_aiv_retained"))) void grouped_matmul_gelu_hel2_aiv_retained(GM_ADDR,GM_ADDR,GM_ADDR,GM_ADDR,GM_ADDR,uint32_t);
extern "C" __global__ __aicore__ __attribute__((section(".text.zzz_r3_hel")))
void grouped_matmul_gelu_r3_hel(GM_ADDR,GM_ADDR,GM_ADDR,GM_ADDR,GM_ADDR,uint32_t);
extern "C" __global__ __aicore__ __attribute__((section(".text.zzz_r3_c3")))
void grouped_matmul_gelu_r3_short(GM_ADDR,GM_ADDR,GM_ADDR,GM_ADDR,GM_ADDR,uint32_t,uint32_t,uint32_t,uint32_t,uint32_t);
extern "C" __global__ __aicore__ __attribute__((section(".text.zzzzz_hdl_r2"))) void grouped_matmul_gelu_hdl_r2(GM_ADDR,GM_ADDR,GM_ADDR,GM_ADDR,GM_ADDR,GM_ADDR,gmg::Plan);
extern "C" __global__ __aicore__ __attribute__((section(".hdl_k256"))) void grouped_matmul_gelu_hdl_k256(GM_ADDR,GM_ADDR,GM_ADDR,GM_ADDR,GM_ADDR,GM_ADDR,gmg::Plan);
inline bool TryShortRows(GM_ADDR x,GM_ADDR w,GM_ADDR s,GM_ADDR g,GM_ADDR y,int64_t e,int64_t m,int64_t k,int64_t n,int64_t cores,aclrtStream stream){
if(e<32 || e>128 || m<32*e || m>128*e || k<384 || k>1024 || k%32 || n<512 || n>1024 || n%256 || cores<1)return false;
auto *hw=platform_ascendc::PlatformAscendCManager::GetInstance();if(!hw)return false;
uint32_t blocks=std::min<int64_t>(cores,std::min<int64_t>(hw->GetCoreNumAic(),hw->GetCoreNumAiv()/2));if(!blocks)return false;
uint64_t l1=0,a=0,b=0,c=0,ub=0;
hw->GetCoreMemSize(platform_ascendc::CoreMemType::L1,l1);hw->GetCoreMemSize(platform_ascendc::CoreMemType::L0_A,a);
hw->GetCoreMemSize(platform_ascendc::CoreMemType::L0_B,b);hw->GetCoreMemSize(platform_ascendc::CoreMemType::L0_C,c);hw->GetCoreMemSize(platform_ascendc::CoreMemType::UB,ub);
if(l1<2ULL*(128+256)*512 || a<2ULL*128*128 || b<2ULL*256*128 || c<uint64_t(128)*256*4 || ub<164864)return false;
uint64_t ffts=0;uint32_t length=0;if(rtGetC2cCtrlAddr(&ffts,&length)!=0)throw std::runtime_error("HDL FFTS unavailable");
const uint64_t bytes=uint64_t(blocks)*2*128*256*4+0;
uint8_t *scratch=nullptr;if(aclrtMalloc(reinterpret_cast<void**>(&scratch),bytes,ACL_MEM_MALLOC_HUGE_FIRST)!=ACL_SUCCESS)throw std::runtime_error("HDL workspace allocation failed");
gmg::Plan p{};p.e=e;p.m=m;p.k=k;p.n=n;p.blocks=blocks;p.backend=1;p.ffts=ffts;
if(k<=512)
grouped_matmul_gelu_hdl_k256<<<blocks,nullptr,stream>>>(x,w,s,g,y,scratch,p);
else
grouped_matmul_gelu_hdl_r2<<<blocks,nullptr,stream>>>(x,w,s,g,y,scratch,p);
auto status=aclrtSynchronizeStream(stream);aclrtFree(scratch);if(status!=ACL_SUCCESS)throw std::runtime_error("HDL kernel failed");return true;
}
extern "C" __global__ __aicore__ __attribute__((section(".text.zzzzzzz_hers_pack"))) void grouped_matmul_gelu_hers_pack(GM_ADDR,GM_ADDR,GM_ADDR,GM_ADDR,GM_ADDR,GM_ADDR,gmg::Plan);
inline bool TryPackedLongRows(GM_ADDR x,GM_ADDR w,GM_ADDR s,GM_ADDR g,GM_ADDR y,int64_t e,int64_t m,int64_t k,int64_t n,int64_t cores,aclrtStream stream){
if(k<768 || k>1024 || n<512 || n>1024 || n%16==0 || m<128*e || cores<1)return false;
auto *hw=platform_ascendc::PlatformAscendCManager::GetInstance();if(!hw)return false;
const uint32_t blocks=std::min<int64_t>(cores,std::min<int64_t>(hw->GetCoreNumAic(),hw->GetCoreNumAiv()/2));if(!blocks)return false;
uint64_t l1=0,a=0,b=0,c=0,ub=0;
hw->GetCoreMemSize(platform_ascendc::CoreMemType::L1,l1);hw->GetCoreMemSize(platform_ascendc::CoreMemType::L0_A,a);hw->GetCoreMemSize(platform_ascendc::CoreMemType::L0_B,b);hw->GetCoreMemSize(platform_ascendc::CoreMemType::L0_C,c);hw->GetCoreMemSize(platform_ascendc::CoreMemType::UB,ub);
if(l1<2ULL*(128+256)*512 || a<2ULL*128*128 || b<2ULL*256*128 || c<uint64_t(128)*256*4 || ub<165632)return false;
uint64_t ffts=0;uint32_t length=0;if(rtGetC2cCtrlAddr(&ffts,&length)!=0)throw std::runtime_error("HERS pack FFTS unavailable");
const uint64_t pk=(k+31)/32*32,pn=(n+31)/32*32;
const uint64_t bytes=uint64_t(blocks)*4*128*256*4+(true?uint64_t(m)*pk:0)+uint64_t(e)*pk*pn;
uint8_t *scratch=nullptr;if(aclrtMalloc(reinterpret_cast<void**>(&scratch),bytes,ACL_MEM_MALLOC_HUGE_FIRST)!=ACL_SUCCESS)throw std::runtime_error("HERS packed workspace unavailable");
gmg::Plan p{};p.e=e;p.m=m;p.k=k;p.n=n;p.blocks=blocks;p.backend=1;p.ffts=ffts;
grouped_matmul_gelu_hers_pack<<<blocks,nullptr,stream>>>(x,w,s,g,y,scratch,p);
const auto status=aclrtSynchronizeStream(stream);aclrtFree(scratch);if(status!=ACL_SUCCESS)throw std::runtime_error("HERS packed kernel failed");return true;
}
inline void LaunchGroupedMatmulGelu(GM_ADDR x, GM_ADDR w, GM_ADDR scale,
GM_ADDR groups, GM_ADDR y, int64_t e, int64_t m, int64_t k,
int64_t n, int64_t availableCoreNum, aclrtStream stream) {
auto *platform = platform_ascendc::PlatformAscendCManager::GetInstance();
if (!platform) throw std::runtime_error("NPU platform unavailable");
if (uint64_t(m) * n * k <= 256 || (n == 1 && m <= availableCoreNum)) {
const uint32_t blocks = std::min<int64_t>(m * n,
std::min<int64_t>(availableCoreNum, platform->GetCoreNumAiv()));
if (!blocks) throw std::runtime_error("No available vector cores");
if (m*n==1 && k<=32) {
if(k==1 && (reinterpret_cast<uint64_t>(y)&127ULL)<=30 && (reinterpret_cast<uint64_t>(y)&1ULL)==0) {
grouped_matmul_gelu_hel2_aiv_retained<<<1,nullptr,stream>>>(x,w,scale,groups,y,static_cast<uint32_t>(e));
return;
}
grouped_matmul_gelu_single_scalar<<<1,nullptr,stream>>>(x,w,scale,groups,y,
static_cast<uint32_t>(e),static_cast<uint32_t>(k));
return;
}
const bool useSmallPrefetch = uint64_t(m) * n > 1 &&
uint64_t(m) * n * k <= 256 &&
uint64_t(m) * k + uint64_t(e) * k * n + uint64_t(e) * n * 4 + uint64_t(e) * 8 <= 8192;
if (useSmallPrefetch) {
if (k==3 && e<=4) {
const uint32_t batchBlocks=std::min<uint32_t>(blocks,(m*n+1)/2);
grouped_matmul_gelu_r3_short<<<batchBlocks,nullptr,stream>>>(x,w,scale,groups,y,
static_cast<uint32_t>(e),static_cast<uint32_t>(m),static_cast<uint32_t>(n),batchBlocks,
static_cast<uint32_t>((0x100000000ULL+n-1)/n));
} else {
grouped_matmul_gelu_tiny_prefetch<<<blocks, nullptr, stream>>>(x, w, scale, groups, y,
static_cast<uint32_t>(e), static_cast<uint32_t>(m), static_cast<uint32_t>(k),
static_cast<uint32_t>(n), blocks);
}
} else {
grouped_matmul_gelu_tiny<<<blocks, nullptr, stream>>>(x, w, scale, groups, y,
static_cast<uint32_t>(e), static_cast<uint32_t>(m), static_cast<uint32_t>(k),
static_cast<uint32_t>(n), blocks);
}
return;
}
if(TryPackedLongRows(x,w,scale,groups,y,e,m,k,n,availableCoreNum,stream))return;
if(TryShortRows(x,w,scale,groups,y,e,m,k,n,availableCoreNum,stream))return;
if (TryLaunchFastPacked(x,w,scale,groups,y,e,m,k,n,availableCoreNum,stream)) return;
if (TryLaunchFast(x,w,scale,groups,y,e,m,k,n,availableCoreNum,stream)) return;
if (TryLaunchSmallRawRowParallel(x,w,scale,y,e,m,k,n,availableCoreNum,stream)) return;
if (TryLaunchSmallRawSingle(x,w,scale,y,e,m,k,n,availableCoreNum,stream)) return;
const int64_t tailCoreLimit = std::min<int64_t>(availableCoreNum,
std::min<int64_t>(platform->GetCoreNumAic(), platform->GetCoreNumAiv() / 2));
bool tailTiled = false;
if (tailCoreLimit > 0 && (k % 16 != 0 || n % 16 != 0) &&
k >= 32 && n >= 32 && m >= 8 * e) {
uint64_t l1 = 0, l0a = 0, l0b = 0, l0c = 0, ub = 0;
platform->GetCoreMemSize(platform_ascendc::CoreMemType::L1, l1);
platform->GetCoreMemSize(platform_ascendc::CoreMemType::L0_A, l0a);
platform->GetCoreMemSize(platform_ascendc::CoreMemType::L0_B, l0b);
platform->GetCoreMemSize(platform_ascendc::CoreMemType::L0_C, l0c);
platform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ub);
tailTiled = l1 >= 2ULL * (128 + 256) * 512 &&
l0a >= 2ULL * 128 * 128 && l0b >= 2ULL * 128 * 256 &&
l0c >= 128ULL * 256 * 4 && ub >= 8192ULL * 22 + 256 * 4 + 2 * (8192 / 8 + 32);
}
if ((k % 16 == 0 && n % 16 == 0 && (m >= 8 * e || (k >= 512 && n >= 512))) || tailTiled) {
const uint32_t blocks = std::min<int64_t>(availableCoreNum,
std::min<int64_t>(platform->GetCoreNumAic(), platform->GetCoreNumAiv() / 2));
LaunchPublicGmg(x, w, scale, groups, y, e, m, k, n, blocks, stream);
return;
}
gmg::Plan p{};
p.e = e; p.m = m; p.k = k; p.n = n;
const int64_t hw = std::min<int64_t>(platform->GetCoreNumAic(), platform->GetCoreNumAiv() / 2);
const int bm = m >= 32 * e ? 64 : 16;
const int bn = std::min<int64_t>(n % 16 == 0 && m >= 16 * e ? 128 : 64, (n + 15) / 16 * 16);
const uint64_t upperTasks = (uint64_t(m) + e * (bm - 1)) / bm * ((n + bn - 1) / bn);
p.blocks = std::min<uint64_t>(std::min<int64_t>(availableCoreNum, hw), upperTasks);
if (!p.blocks) throw std::runtime_error("No available compute cores");
matmul_tiling::MatmulApiTiling tiling(*platform);
using namespace matmul_tiling;
uint64_t ubBytes = 0;
platform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ubBytes);
const uint64_t elements = uint64_t(bm) * bn;
const uint64_t explicitBytes = elements * (n % 16 == 0 ? 22 : 24) + 2 * (elements / 8 + 32) + bn * 4;
if (ubBytes <= explicitBytes + 1024) throw std::runtime_error("Insufficient UB for tile");
if (tiling.SetAType(TPosition::GM, matmul_tiling::CubeFormat::ND, DataType::DT_INT8, false) != 0 ||
tiling.SetBType(TPosition::GM, matmul_tiling::CubeFormat::ND, DataType::DT_INT8, false) != 0 ||
tiling.SetCType(TPosition::GM, matmul_tiling::CubeFormat::ND, DataType::DT_INT32) != 0 ||
tiling.SetOrgShape(bm, n, k) != 0 || tiling.SetShape(bm, bn, k) != 0 ||
tiling.SetFixSplit(bm, bn, -1) != 0 || tiling.SetBias(false) != 0 ||
tiling.SetBufferSpace(-1, -1, static_cast<int32_t>(ubBytes - explicitBytes - 1024)) != 0 || tiling.GetTiling(p.cube) == -1)
throw std::runtime_error("INT8 matmul tiling failed");
if (p.cube.baseM != bm || p.cube.baseN != bn)
throw std::runtime_error("Unexpected INT8 base tile");
const uint64_t sysPerCore = std::max<uint64_t>(512, platform->GetLibApiWorkSpaceSize());
uint8_t *scratch = nullptr, *sys = nullptr;
if (aclrtMalloc(reinterpret_cast<void **>(&scratch), uint64_t(p.blocks) * gmg::ELEMS * 4, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS)
throw std::runtime_error("Scratch allocation failed");
if (aclrtMalloc(reinterpret_cast<void **>(&sys), p.blocks * sysPerCore, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) {
aclrtFree(scratch);
throw std::runtime_error("Matmul workspace allocation failed");
}
LaunchGmgMixed(x, w, scale, groups, y, scratch, sys, sysPerCore, p, stream);
const aclError status = aclrtSynchronizeStream(stream);
aclrtFree(sys);
aclrtFree(scratch);
if (status != ACL_SUCCESS) throw std::runtime_error("GroupedMatmulGelu kernel failed");
}
inline const TensorInfo &RequireGmgTensor(const TensorGroupInfo &info,
int64_t rank, int32_t dtype) {
if (info.numTensors != 1 || !info.tensors || !info.tensors[0].shape ||
info.tensors[0].numDims != rank || info.tensors[0].dtype != dtype)
throw std::runtime_error("Invalid GroupedMatmulGelu tensor metadata");
return info.tensors[0];
}
inline bool TryAsymmetricPipeline(GM_ADDR,GM_ADDR,GM_ADDR,GM_ADDR,GM_ADDR,int64_t,int64_t,int64_t,int64_t,int64_t,aclrtStream);
inline bool TryUniformRows(GM_ADDR,GM_ADDR,GM_ADDR,GM_ADDR,GM_ADDR,int64_t,int64_t,int64_t,int64_t,int64_t,aclrtStream);
inline bool TrySmallMatrix(GM_ADDR,GM_ADDR,GM_ADDR,GM_ADDR,int64_t,int64_t,int64_t,int64_t,int64_t,aclrtStream);
inline bool TryPairedPipeline(GM_ADDR,GM_ADDR,GM_ADDR,GM_ADDR,GM_ADDR,int64_t,int64_t,int64_t,int64_t,int64_t,aclrtStream);
inline void LaunchHB015(GM_ADDR,GM_ADDR,GM_ADDR,GM_ADDR,GM_ADDR,GM_ADDR,gmg::Plan,uint32_t,aclrtStream);
inline bool TrySplitK(GM_ADDR,GM_ADDR,GM_ADDR,GM_ADDR,GM_ADDR,int64_t,int64_t,int64_t,int64_t,int64_t,aclrtStream);
inline bool TryPairedPanels(GM_ADDR,GM_ADDR,GM_ADDR,GM_ADDR,GM_ADDR,int64_t,int64_t,int64_t,int64_t,int64_t,aclrtStream);
inline bool TryResidentA(GM_ADDR,GM_ADDR,GM_ADDR,GM_ADDR,GM_ADDR,int64_t,int64_t,int64_t,int64_t,int64_t,aclrtStream);
inline bool TryResidentB(GM_ADDR,GM_ADDR,GM_ADDR,GM_ADDR,GM_ADDR,int64_t,int64_t,int64_t,int64_t,int64_t,aclrtStream);
inline bool TryLargeMatrices(GM_ADDR,GM_ADDR,GM_ADDR,GM_ADDR,GM_ADDR,int64_t,int64_t,int64_t,int64_t,int64_t,aclrtStream);
extern "C" void run_kernel(
GM_ADDR x, const TensorGroupInfo &info_x,
GM_ADDR weight, const TensorGroupInfo &info_weight,
GM_ADDR scale, const TensorGroupInfo &info_scale,
GM_ADDR group_list, const TensorGroupInfo &info_group_list,
GM_ADDR y, const TensorGroupInfo &info_y,
int64_t availableCoreNum, aclrtStream stream) {
const auto &a = RequireGmgTensor(info_x, 2, 3);
const auto &b = RequireGmgTensor(info_weight, 3, 3);
const auto &s = RequireGmgTensor(info_scale, 2, 0);
const auto &g = RequireGmgTensor(info_group_list, 1, 6);
const auto &o = RequireGmgTensor(info_y, 2, 1);
const int64_t m = a.shape[0], k = a.shape[1];
const int64_t e = b.shape[0], n = b.shape[2];
if (b.shape[1] != k || s.shape[0] != e || s.shape[1] != n ||
g.shape[0] != e || o.shape[0] != m || o.shape[1] != n)
throw std::runtime_error("Inconsistent GroupedMatmulGelu shapes");
if (!x || !weight || !scale || !group_list || !y || e < 1 || e > 128 ||
m < 1 || m > 65536 || k < 1 || k > 8192 || n < 1 || n > 4096 ||
availableCoreNum < 1) throw std::runtime_error("Invalid GroupedMatmulGelu metadata");
const uint64_t weights = uint64_t(e) * k * n;
const uint64_t total = uint64_t(m) * k + weights + uint64_t(e) * n * 4 + e * 8 + uint64_t(m) * n * 2;
if (weights > 256ULL * 1024 * 1024 || total > 512ULL * 1024 * 1024)
throw std::runtime_error("GroupedMatmulGelu size limit exceeded");
if(TryLargeMatrices(x,weight,scale,group_list,y,e,m,k,n,availableCoreNum,stream))return;
if(TryResidentB(x,weight,scale,group_list,y,e,m,k,n,availableCoreNum,stream))return;
if(TrySmallMatrix(x,weight,scale,y,e,m,k,n,availableCoreNum,stream))return;
if(TryUniformRows(x,weight,scale,group_list,y,e,m,k,n,availableCoreNum,stream))return;
if(TrySplitK(x,weight,scale,group_list,y,e,m,k,n,availableCoreNum,stream))return;
if(TryPairedPanels(x,weight,scale,group_list,y,e,m,k,n,availableCoreNum,stream))return;
if(TryResidentA(x,weight,scale,group_list,y,e,m,k,n,availableCoreNum,stream))return;
if(TryPairedPipeline(x,weight,scale,group_list,y,e,m,k,n,availableCoreNum,stream))return;
if(TryAsymmetricPipeline(x,weight,scale,group_list,y,e,m,k,n,availableCoreNum,stream))return;
LaunchGroupedMatmulGelu(x, weight, scale, group_list, y,
e, m, k, n, availableCoreNum, stream);
}
namespace tiny_scalar {
__aicore__ __forceinline__ uint16_t Gelu(float value) {
if (value >= 8.0f) return gmg::RoundWideHalf({value, 0.0f});
if (value <= -8.0f) return 0x8000;
float q = gmg::RMul(value, value);
q = gmg::RMul(q, 0.044715f);
q = gmg::RAdd(q, 1.0f);
q = gmg::RMul(q, value);
gmg::FloatBits ab;
ab.f = gmg::RMul(q, 1.5957691216057308f);
ab.u |= 0x80000000U;
const float x = ab.f;
const int power = static_cast<int>(gmg::RAdd(gmg::RMul(x, 1.4426950408889634f), -0.5f));
float r = gmg::RAdd(x, -gmg::RMul(static_cast<float>(power), 0.693145751953125f));
r = gmg::RAdd(r, -gmg::RMul(static_cast<float>(power), 1.428606765330187e-6f));
float p = 0.00019841270113829523f;
p = gmg::RAdd(gmg::RMul(p, r), 0.0013888889225199819f);
p = gmg::RAdd(gmg::RMul(p, r), 0.0083333337679505348f);
p = gmg::RAdd(gmg::RMul(p, r), 0.041666667908430099f);
p = gmg::RAdd(gmg::RMul(p, r), 0.1666666716337204f);
p = gmg::RAdd(gmg::RMul(p, r), 0.5f);
p = gmg::RAdd(gmg::RMul(p, r), 1.0f);
p = gmg::RAdd(gmg::RMul(p, r), 1.0f);
gmg::FloatBits factor;
factor.u = static_cast<uint32_t>(power + 127) << 23;
const float tail = gmg::RMul(p, factor.f);
const float result = (value < 0.0f ? gmg::RMul(value, tail) : value) / gmg::RAdd(1.0f, tail);
gmg::FloatBits bits;
bits.f = result;
if (gmg::NearHalfBoundary(bits.u)) return gmg::RefineGelu(value);
return gmg::RoundWideHalf({result, 0.0f});
}
}
extern "C" __global__ __aicore__ void grouped_matmul_gelu_tiny_prefetch(
GM_ADDR xp, GM_ADDR wp, GM_ADDR sp, GM_ADDR gp, GM_ADDR yp,
uint32_t e, uint32_t m, uint32_t k, uint32_t n, uint32_t blocks) {
KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
using namespace AscendC;
InitSocState();
GlobalTensor<int8_t> x, w;
GlobalTensor<float> scale;
GlobalTensor<int64_t> groups;
GlobalTensor<half> y;
x.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t *>(xp));
w.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t *>(wp));
scale.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(sp));
groups.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t *>(gp));
y.SetGlobalBuffer(reinterpret_cast<__gm__ half *>(yp));
TPipe pipe;
TBuf<TPosition::VECCALC> zb, qb, tb, db, ob;
TBuf<TPosition::VECCALC> axb, bwb, hbb, afb, bfb, reduceb;
pipe.InitBuffer(zb, 32); pipe.InitBuffer(qb, 32);
pipe.InitBuffer(tb, 32); pipe.InitBuffer(db, 32); pipe.InitBuffer(ob, 32);
if (n == 1 && k > 32) {
pipe.InitBuffer(axb, 256); pipe.InitBuffer(bwb, 256);
pipe.InitBuffer(hbb, 1024); pipe.InitBuffer(afb, 1024);
pipe.InitBuffer(bfb, 1024); pipe.InitBuffer(reduceb, 1024);
}
auto z = zb.Get<float>(); auto q = qb.Get<float>();
auto t = tb.Get<float>(); auto d = db.Get<float>(); auto out = ob.Get<half>();
const bool localInputs = uint64_t(m) * n * k <= 256 &&
uint64_t(m)*k + uint64_t(e)*k*n + uint64_t(e)*n*4 + uint64_t(e)*8 <= 8192;
TBuf<TPosition::VECCALC> localInputBuffer;
pipe.InitBuffer(localInputBuffer, 8320);
auto localBytes = localInputBuffer.Get<int8_t>();
const uint32_t xBytes = m*k, wBytes=e*k*n, scaleBytes=e*n*4, groupBytes=e*8;
const uint32_t wOffset=(xBytes+31)/32*32;
const uint32_t sOffset=wOffset+(wBytes+31)/32*32;
const uint32_t gOffset=sOffset+(scaleBytes+31)/32*32;
if (localInputs) {
DataCopyPad(localBytes, x, DataCopyExtParams{1,xBytes,0,0,0},DataCopyPadExtParams<int8_t>{false,0,0,0});
DataCopyPad(localBytes[wOffset],w,DataCopyExtParams{1,wBytes,0,0,0},DataCopyPadExtParams<int8_t>{false,0,0,0});
DataCopyPad(localInputBuffer.Get<float>()[sOffset/4],scale,DataCopyExtParams{1,scaleBytes,0,0,0},DataCopyPadExtParams<float>{false,0,0,0});
DataCopyPad(localInputBuffer.Get<int64_t>()[gOffset/8],groups,DataCopyExtParams{1,groupBytes,0,0,0},DataCopyPadExtParams<int64_t>{false,0,0,0});
SetFlag<HardEvent::MTE2_S>(EVENT_ID0); WaitFlag<HardEvent::MTE2_S>(EVENT_ID0);
}
for (uint32_t index = GetBlockIdx(); index < m * n; index += blocks) {
const uint32_t row = index / n, col = index % n;
uint32_t low = 0, high = e;
while (low < high) {
const uint32_t middle = (low + high) / 2;
if (static_cast<uint32_t>((localInputs ? localInputBuffer.Get<int64_t>().GetValue(gOffset/8+middle) : groups.GetValue(middle))) <= row) low = middle + 1;
else high = middle;
}
int32_t dot = 0;
if (n == 1 && k > 32) {
auto ai = axb.Get<int8_t>(); auto bi = bwb.Get<int8_t>();
auto ah = hbb.Get<half>(); auto bh = hbb.Get<half>()[256];
auto af = afb.Get<int32_t>(); auto bf = bfb.Get<int32_t>();
for (uint32_t off = 0; off < k; off += 256) {
const uint32_t count = k - off < 256 ? k - off : 256;
const uint8_t pad = static_cast<uint8_t>((count + 31) / 32 * 32 - count);
DataCopyPad(ai, x[uint64_t(row) * k + off], DataCopyExtParams{1, count, 0, 0, 0},
DataCopyPadExtParams<int8_t>{true, 0, pad, 0});
DataCopyPad(bi, w[uint64_t(low) * k + off], DataCopyExtParams{1, count, 0, 0, 0},
DataCopyPadExtParams<int8_t>{true, 0, pad, 0});
SetFlag<HardEvent::MTE2_V>(EVENT_ID0); WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
Cast(ah, ai, RoundMode::CAST_NONE, count);
Cast(bh, bi, RoundMode::CAST_NONE, count);
PipeBarrier<PIPE_V>();
Duplicate(af, static_cast<int32_t>(0), 256);
Duplicate(bf, static_cast<int32_t>(0), 256);
PipeBarrier<PIPE_V>();
Cast(af, ah, RoundMode::CAST_RINT, count);
Cast(bf, bh, RoundMode::CAST_RINT, count);
PipeBarrier<PIPE_V>();
Mul(af, af, bf, 256); PipeBarrier<PIPE_V>();
for (uint32_t step = 128; step >= 8; step /= 2) {
Add(af, af, af[step], step); PipeBarrier<PIPE_V>();
}
SetFlag<HardEvent::V_S>(EVENT_ID0); WaitFlag<HardEvent::V_S>(EVENT_ID0);
for (uint32_t lane = 0; lane < 8; ++lane) dot += af.GetValue(lane);
PipeBarrier<PIPE_ALL>();
}
} else {
for (uint32_t lane = 0; lane < k; ++lane)
dot += static_cast<int32_t>(localInputs ? localBytes.GetValue(row*k+lane) : x.GetValue(uint64_t(row)*k+lane)) *
static_cast<int32_t>(localInputs ? localBytes.GetValue(wOffset+(low*k+lane)*n+col) : w.GetValue((uint64_t(low)*k+lane)*n+col));
}
const float value = static_cast<float>(dot) * (localInputs ? localInputBuffer.Get<float>().GetValue(sOffset/4+low*n+col) : scale.GetValue(uint64_t(low)*n+col));
ob.Get<uint16_t>().SetValue(0, tiny_scalar::Gelu(value));
SetFlag<HardEvent::S_MTE3>(EVENT_ID0); WaitFlag<HardEvent::S_MTE3>(EVENT_ID0);
SetFlag<HardEvent::V_MTE3>(EVENT_ID0); WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
DataCopyPad(y[index], out, DataCopyExtParams{1, 2, 0, 0, 0});
PipeBarrier<PIPE_ALL>();
}
}
namespace tiny_short_scalar {
__aicore__ __forceinline__ uint16_t NormalFirst(float value, uint32_t bits) {
const uint32_t sign = (bits >> 16) & 0x8000U;
const uint32_t mag = bits & 0x7fffffffU;
if (mag >= 0x38800000U) {
const uint32_t rem = mag & 0x1fffU;
if (rem - 0x0fc0U <= 128U) return gmg::RefineGeluLarge(value);
return static_cast<uint16_t>(sign | ((mag - 0x38000000U + 0x1000U) >> 13U));
}
if (mag < 0x32800000U) return static_cast<uint16_t>(sign);
const uint32_t shift = 126U - (mag >> 23);
const uint32_t payload = (mag & 0x007fffffU) | 0x00800000U;
const uint32_t midpoint = 1U << (shift - 1U);
const uint32_t rem = payload & ((midpoint << 1U) - 1U);
if (rem - (midpoint - 64U) <= 128U) return gmg::RefineGeluLarge(value);
return static_cast<uint16_t>(sign | ((payload + midpoint) >> shift));
}
__aicore__ __forceinline__ uint16_t Gelu(float value) {
if (value >= 8.0f) return gmg::RoundWideHalf({value, 0.0f});
if (value <= -8.0f) return 0x8000;
gmg::FloatBits valueBits;
valueBits.f=value;
if ((valueBits.u&0x7fffffffU)<=0x3f800000U) {
const float t=gmg::RMul(value,value);
float p=-7.08252765e-06f;
p=gmg::RAdd(gmg::RMul(p,t),0.000117656338f);
p=gmg::RAdd(gmg::RMul(p,t),-0.00124291389f);
p=gmg::RAdd(gmg::RMul(p,t),0.010201524f);
p=gmg::RAdd(gmg::RMul(p,t),-0.0668194741f);
p=gmg::RAdd(gmg::RMul(p,t),0.398942292f);
gmg::FloatBits result;
result.f=gmg::RAdd(gmg::RMul(value,0.5f),gmg::RMul(t,p));
return NormalFirst(value,result.u);
}
float q = gmg::RMul(value, value);
q = gmg::RMul(q, 0.044715f);
q = gmg::RAdd(q, 1.0f);
q = gmg::RMul(q, value);
gmg::FloatBits ab;
ab.f = gmg::RMul(q, 1.5957691216057308f);
ab.u |= 0x80000000U;
const float x = ab.f;
const int power = static_cast<int>(gmg::RAdd(gmg::RMul(x, 1.4426950408889634f), -0.5f));
float r = gmg::RAdd(x, -gmg::RMul(static_cast<float>(power), 0.693145751953125f));
r = gmg::RAdd(r, -gmg::RMul(static_cast<float>(power), 1.428606765330187e-6f));
float p = 0.00019841270113829523f;
p = gmg::RAdd(gmg::RMul(p, r), 0.0013888889225199819f);
p = gmg::RAdd(gmg::RMul(p, r), 0.0083333337679505348f);
p = gmg::RAdd(gmg::RMul(p, r), 0.041666667908430099f);
p = gmg::RAdd(gmg::RMul(p, r), 0.1666666716337204f);
p = gmg::RAdd(gmg::RMul(p, r), 0.5f);
p = gmg::RAdd(gmg::RMul(p, r), 1.0f);
p = gmg::RAdd(gmg::RMul(p, r), 1.0f);
gmg::FloatBits factor;
factor.u = static_cast<uint32_t>(power + 127) << 23;
const float tail = gmg::RMul(p, factor.f);
const float result = (value < 0.0f ? gmg::RMul(value, tail) : value) / gmg::RAdd(1.0f, tail);
gmg::FloatBits bits;
bits.f = result;
return NormalFirst(value,bits.u);
}
}
template <uint32_t K>
__aicore__ __forceinline__ void TinyShortCompute(
GM_ADDR xp, GM_ADDR wp, GM_ADDR sp, GM_ADDR gp, GM_ADDR yp,
uint32_t e, uint32_t m, uint32_t n, uint32_t blocks, uint32_t nrecip) {
constexpr uint32_t k=K, batch=2;
using namespace AscendC;
GlobalTensor<int8_t> x, w;
GlobalTensor<float> scale;
GlobalTensor<int64_t> groups;
GlobalTensor<half> y;
x.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t *>(xp));
w.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t *>(wp));
scale.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(sp));
groups.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t *>(gp));
y.SetGlobalBuffer(reinterpret_cast<__gm__ half *>(yp));
LocalTensor<int8_t> bytes(TPosition::VECCALC,0,256);
LocalTensor<int8_t> weights(TPosition::VECCALC,256,8192);
LocalTensor<float> scales(TPosition::VECCALC,8448,2048);
LocalTensor<int64_t> ends(TPosition::VECCALC,16640,128);
LocalTensor<uint16_t> bits(TPosition::VECCALC,17664,16);
LocalTensor<half> output(TPosition::VECCALC,17664,16);
const uint32_t xBytes=m*k, wBytes=e*k*n, scaleBytes=e*n*4, groupBytes=e*8;
DataCopyPad(ends,groups,DataCopyExtParams{1,groupBytes,0,0,0},DataCopyPadExtParams<int64_t>{true,0,static_cast<uint8_t>(4-e),-1});
SetFlag<HardEvent::MTE2_S>(EVENT_ID0);
DataCopyPad(bytes,x,DataCopyExtParams{1,xBytes,0,0,0},DataCopyPadExtParams<int8_t>{false,0,0,0});
DataCopyPad(weights,w,DataCopyExtParams{1,wBytes,0,0,0},DataCopyPadExtParams<int8_t>{false,0,0,0});
DataCopyPad(scales,scale,DataCopyExtParams{1,scaleBytes,0,0,0},DataCopyPadExtParams<float>{false,0,0,0});
SetFlag<HardEvent::MTE2_S>(EVENT_ID1);
WaitFlag<HardEvent::MTE2_S>(EVENT_ID0);
WaitFlag<HardEvent::MTE2_S>(EVENT_ID1);
for (uint32_t base=GetBlockIdx()*batch; base<m*n; base+=blocks*batch) {
const uint32_t count=m*n-base<batch?m*n-base:batch;
#pragma clang loop unroll(disable)
for (uint32_t laneOut=0;laneOut<count;++laneOut) {
const uint32_t index=base+laneOut;
const uint32_t row=n==1?index:static_cast<uint32_t>((uint64_t(index)*nrecip)>>32);
const uint32_t col=index-row*n;
const uint32_t low=(static_cast<uint32_t>(ends.GetValue(0))<=row)+
(static_cast<uint32_t>(ends.GetValue(1))<=row)+
(static_cast<uint32_t>(ends.GetValue(2))<=row);
int32_t dot=0;
#pragma unroll
for (uint32_t lane=0;lane<K;++lane)
dot+=static_cast<int32_t>(bytes.GetValue(row*k+lane))*
static_cast<int32_t>(weights.GetValue((low*k+lane)*n+col));
const float value=static_cast<float>(dot)*scales.GetValue(low*n+col);
bits.SetValue(laneOut,tiny_short_scalar::Gelu(value));
}
SetFlag<HardEvent::S_MTE3>(EVENT_ID0); WaitFlag<HardEvent::S_MTE3>(EVENT_ID0);
DataCopyPad(y[base],output,DataCopyExtParams{1,count*2,0,0,0});
SetFlag<HardEvent::MTE3_S>(EVENT_ID0); WaitFlag<HardEvent::MTE3_S>(EVENT_ID0);
}
}
extern "C" __global__ __aicore__ __attribute__((section(".text.zzz_c3_short"))) void grouped_matmul_gelu_tiny_short3(
GM_ADDR xp, GM_ADDR wp, GM_ADDR sp, GM_ADDR gp, GM_ADDR yp,
uint32_t e, uint32_t m, uint32_t n, uint32_t blocks, uint32_t nrecip) {
KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
TinyShortCompute<3>(xp,wp,sp,gp,yp,e,m,n,blocks,nrecip);
}
extern "C" __global__ __aicore__ __attribute__((section(".text.zzz_hel_single")))
void grouped_matmul_gelu_single_scalar(
GM_ADDR xp, GM_ADDR wp, GM_ADDR sp, GM_ADDR gp, GM_ADDR yp,
uint32_t e, uint32_t k) {
KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
using namespace AscendC;
GlobalTensor<int8_t> x, w;
GlobalTensor<float> s;
GlobalTensor<int64_t> g;
GlobalTensor<half> y;
x.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t *>(xp));
w.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t *>(wp));
s.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(sp));
g.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t *>(gp));
y.SetGlobalBuffer(reinterpret_cast<__gm__ half *>(yp));
LocalTensor<int8_t> a(TPosition::VECCALC,0,32);
LocalTensor<int8_t> b(TPosition::VECCALC,32,4096);
LocalTensor<float> scales(TPosition::VECCALC,4128,128);
LocalTensor<int64_t> ends(TPosition::VECCALC,4640,128);
LocalTensor<uint16_t> bits(TPosition::VECCALC,5664,16);
LocalTensor<half> out(TPosition::VECCALC,5664,16);
DataCopyPad(ends,g,DataCopyExtParams{1,e*8,0,0,0},DataCopyPadExtParams<int64_t>{false,0,0,0});
DataCopyPad(a,x,DataCopyExtParams{1,k,0,0,0},DataCopyPadExtParams<int8_t>{false,0,0,0});
DataCopyPad(b,w,DataCopyExtParams{1,e*k,0,0,0},DataCopyPadExtParams<int8_t>{false,0,0,0});
DataCopyPad(scales,s,DataCopyExtParams{1,e*4,0,0,0},DataCopyPadExtParams<float>{false,0,0,0});
SetFlag<HardEvent::MTE2_S>(EVENT_ID0);
WaitFlag<HardEvent::MTE2_S>(EVENT_ID0);
uint32_t low=0,high=e;
while(low<high) {
const uint32_t mid=(low+high)/2;
if(ends.GetValue(mid)==0) low=mid+1; else high=mid;
}
int32_t dot=0;
for(uint32_t i=0;i<k;++i)
dot+=static_cast<int32_t>(a.GetValue(i))*static_cast<int32_t>(b.GetValue(low*k+i));
const float value=static_cast<float>(dot)*scales.GetValue(low);
bits.SetValue(0,tiny_short_scalar::Gelu(value));
SetFlag<HardEvent::S_MTE3>(EVENT_ID0);
WaitFlag<HardEvent::S_MTE3>(EVENT_ID0);
DataCopyPad(y,out,DataCopyExtParams{1,2,0,0,0});
SetFlag<HardEvent::MTE3_S>(EVENT_ID0);
WaitFlag<HardEvent::MTE3_S>(EVENT_ID0);
}
extern "C" __global__ __aicore__ __attribute__((section(".text.zzz_r3_hel")))
void grouped_matmul_gelu_r3_hel(
GM_ADDR xp,GM_ADDR wp,GM_ADDR sp,GM_ADDR gp,GM_ADDR yp,uint32_t e) {
KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIC_ONLY);
using namespace AscendC;
GlobalTensor<int8_t> x,w;
GlobalTensor<float> s;
GlobalTensor<int64_t> g;
GlobalTensor<uint16_t> y;
x.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t *>(xp));
w.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t *>(wp));
s.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(sp));
g.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t *>(gp));
y.SetGlobalBuffer(reinterpret_cast<__gm__ uint16_t *>(yp));
GlobalTensor<uint64_t> cx,cw,cs;
cx.SetGlobalBuffer(reinterpret_cast<__gm__ uint64_t *>(xp));
cw.SetGlobalBuffer(reinterpret_cast<__gm__ uint64_t *>(wp));
cs.SetGlobalBuffer(reinterpret_cast<__gm__ uint64_t *>(sp));
DataCachePreload(cx,static_cast<int16_t>(0));
DataCachePreload(cw,static_cast<int16_t>(0));
DataCachePreload(cs,static_cast<int16_t>(0));
GlobalTensor<uint64_t> cy;
cy.SetGlobalBuffer(reinterpret_cast<__gm__ uint64_t *>(yp));
int32_t left=-1,right=static_cast<int32_t>(e)-1;
while(right-left>1) {
const uint32_t mid=static_cast<uint32_t>((left+right)/2);
if(g.GetValue(mid)==0)left=mid;else right=mid;
}
const uint32_t expert=static_cast<uint32_t>(right);
const int32_t dot=static_cast<int32_t>(x.GetValue(0))*static_cast<int32_t>(w.GetValue(expert));
const float value=static_cast<float>(dot)*s.GetValue(expert);
WriteGmByPassDCache(reinterpret_cast<__gm__ uint16_t *>(yp),tiny_short_scalar::Gelu(value));
DataSyncBarrier<MemDsbT::DDR>();
}
extern "C" __global__ __aicore__ __attribute__((section(".text.zzz_r3_c3")))
void grouped_matmul_gelu_r3_short(GM_ADDR xp,GM_ADDR wp,GM_ADDR sp,GM_ADDR gp,GM_ADDR yp,
uint32_t e,uint32_t m,uint32_t n,uint32_t blocks,uint32_t nrecip) {
KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
using namespace AscendC;
constexpr uint32_t batch=2;
GlobalTensor<int8_t> x,w;
GlobalTensor<float> s;
GlobalTensor<int64_t> g;
GlobalTensor<half> y;
x.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t *>(xp));
w.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t *>(wp));
s.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(sp));
g.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t *>(gp));
y.SetGlobalBuffer(reinterpret_cast<__gm__ half *>(yp));
LocalTensor<int8_t> a(TPosition::VECCALC,0,256);
LocalTensor<int8_t> b(TPosition::VECCALC,256,8192);
LocalTensor<float> scales(TPosition::VECCALC,8448,2048);
LocalTensor<int64_t> ends(TPosition::VECCALC,16640,128);
LocalTensor<uint16_t> bits(TPosition::VECCALC,17664,16);
LocalTensor<half> out(TPosition::VECCALC,17664,16);
GlobalTensor<uint64_t> cx,cw,cs,cg;
cx.SetGlobalBuffer(reinterpret_cast<__gm__ uint64_t *>(xp));
cw.SetGlobalBuffer(reinterpret_cast<__gm__ uint64_t *>(wp));
cs.SetGlobalBuffer(reinterpret_cast<__gm__ uint64_t *>(sp));
cg.SetGlobalBuffer(reinterpret_cast<__gm__ uint64_t *>(gp));
DataCachePreload(cx,static_cast<int16_t>(0));DataCachePreload(cw,static_cast<int16_t>(0));
DataCachePreload(cs,static_cast<int16_t>(0));DataCachePreload(cg,static_cast<int16_t>(0));
const uint32_t g0=e>1?static_cast<uint32_t>(g.GetValue(0)):0xffffffffU;
const uint32_t g1=e>2?static_cast<uint32_t>(g.GetValue(1)):0xffffffffU;
const uint32_t g2=e>3?static_cast<uint32_t>(g.GetValue(2)):0xffffffffU;
for(uint32_t base=GetBlockIdx()*batch;base<m*n;base+=blocks*batch) {
const uint32_t count=batch==1?1:(m*n-base<2?m*n-base:2);
const uint32_t row=n==1?base:static_cast<uint32_t>((uint64_t(base)*nrecip)>>32);
const uint32_t col=base-row*n;
const uint32_t expert=(g0<=row)+(g1<=row)+(g2<=row);
const int32_t x0=static_cast<int32_t>(x.GetValue(row*3));
const int32_t x1=static_cast<int32_t>(x.GetValue(row*3+1));
const int32_t x2=static_cast<int32_t>(x.GetValue(row*3+2));
const int32_t dot0=x0*static_cast<int32_t>(w.GetValue(expert*3*n+col))+
x1*static_cast<int32_t>(w.GetValue((expert*3+1)*n+col))+
x2*static_cast<int32_t>(w.GetValue((expert*3+2)*n+col));
const float z0=static_cast<float>(dot0)*s.GetValue(expert*n+col);
float z1=0.0f;
if(batch==2 && count==2) {
const uint32_t index=base+1;
const uint32_t row1=n==1?index:static_cast<uint32_t>((uint64_t(index)*nrecip)>>32);
const uint32_t col1=index-row1*n;
const uint32_t ex1=row1==row?expert:static_cast<uint32_t>((g0<=row1)+(g1<=row1)+(g2<=row1));
const int32_t a0=row1==row?x0:static_cast<int32_t>(x.GetValue(row1*3));
const int32_t a1=row1==row?x1:static_cast<int32_t>(x.GetValue(row1*3+1));
const int32_t a2=row1==row?x2:static_cast<int32_t>(x.GetValue(row1*3+2));
const int32_t dot1=a0*static_cast<int32_t>(w.GetValue(ex1*3*n+col1))+
a1*static_cast<int32_t>(w.GetValue((ex1*3+1)*n+col1))+
a2*static_cast<int32_t>(w.GetValue((ex1*3+2)*n+col1));
z1=static_cast<float>(dot1)*s.GetValue(ex1*n+col1);
}
#pragma clang loop unroll(disable)
for(uint32_t i=0;i<count;++i)bits.SetValue(i,tiny_short_scalar::Gelu(i==0?z0:z1));
SetFlag<HardEvent::S_MTE3>(EVENT_ID0);WaitFlag<HardEvent::S_MTE3>(EVENT_ID0);
DataCopyPad(y[base],out,DataCopyExtParams{1,count*2,0,0,0});
SetFlag<HardEvent::MTE3_S>(EVENT_ID0);WaitFlag<HardEvent::MTE3_S>(EVENT_ID0);
}
}
namespace public_gmg {
class HdlR2Epilogue {
public:
using ElementScale=float; using LayoutScale=layout::VectorLayout;
using ElementD=half; using LayoutD=layout::RowMajor;
using Params=DescriptorBankStableEpilogue::Params;
__aicore__ __forceinline__ HdlR2Epilogue(Arch::Resource &resource) {
Buffer *buffers[]={&zb,&qb,&sb,&yb};
const uint32_t offsets[]={0,65536,131072,132096};
for(uint32_t i=0;i<4;++i)buffers[i]->tensor=resource.ubBuf.GetBufferByByte<uint8_t>(offsets[i]);
}
__aicore__ __forceinline__ void UpdateParams(Params const&p) {
plan.n=p.yl.stride(0);scale.SetGlobalBuffer(p.sp);y.SetGlobalBuffer(p.yp);
}
__aicore__ __forceinline__ void operator()(GemmCoord const&shape,GemmCoord const&coord,
GemmCoord const&actual,GlobalTensor<int32_t> const&src,layout::RowMajor const&srcLayout) {
const uint32_t perSub=(actual.m()+1)/2,first=GetSubBlockIdx()*perSub;
const uint32_t end=first+perSub<actual.m()?first+perSub:actual.m();
if(first>=end)return;
accumStride=srcLayout.stride(0);accum=src[uint64_t(first)*accumStride];
Compute64(coord.m()*shape.m()+first,coord.n()*shape.n(),end-first,actual.n());
}
private:
__aicore__ __forceinline__ void Compute64(uint32_t row,uint32_t col,uint32_t vm,uint32_t vn) {
const uint32_t e=0, stride=(vn+7)/8*8, len=vm*stride;
auto ci = qb.Get<int32_t>();
auto z = zb.Get<float>();
auto q = qb.Get<float>();
auto s = sb.Get<float>();
auto out = yb.Get<half>();
DataCopyPad(ci, accum,
DataCopyExtParams{static_cast<uint16_t>(vm), vn * 4, (accumStride - vn) * 4, 0, 0},
DataCopyPadExtParams<int32_t>{true, 0, static_cast<uint8_t>(stride - vn), 0});
DataCopyPad(s, scale[uint64_t(e) * plan.n + col],
DataCopyExtParams{1, vn * 4, 0, 0, 0},
DataCopyPadExtParams<float>{true, 0, static_cast<uint8_t>(stride - vn), 0.0f});
SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
Cast(z, ci, RoundMode::CAST_RINT, len);
BinaryRepeatParams br;
br.dstBlkStride = 1; br.src0BlkStride = 1; br.src1BlkStride = 1;
br.dstRepStride = stride / 8; br.src0RepStride = stride / 8; br.src1RepStride = 0;
for (uint32_t col = 0; col < stride; col += 64) {
const uint64_t mask = stride - col < 64 ? stride - col : 64;
Mul(z[col], z[col], s[col], mask, static_cast<uint8_t>(vm), br);
}
Mul(q, z, z, len);
Muls(q, q, 0.044715f, len);
Adds(q, q, 1.0f, len);
Mul(q, q, z, len);
Muls(q, q, -1.5957691216057308f, len);
Mins(q, q, 87.0f, len);
Exp(q, q, len);
Adds(q, q, 1.0f, len);
Div(q, z, q, len);
Cast(out,q,RoundMode::CAST_RINT,len);
SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
DataCopyPad(y[uint64_t(row)*plan.n+col],out,
DataCopyExtParams{static_cast<uint16_t>(vm),vn*2,
(stride-(vn+15)/16*16)/16,(plan.n-vn)*2,0});
PipeBarrier<PIPE_ALL>();
}
uint32_t accumStride;struct{uint32_t n;}plan;
GlobalTensor<float>scale;GlobalTensor<half>y;GlobalTensor<int32_t>accum;
Buffer zb,qb,sb,yb;
};
}
namespace public_gmg {
class HdlDeferredOutputEpilogue {
public:
using ElementScale=float; using LayoutScale=layout::VectorLayout;
using ElementD=half; using LayoutD=layout::RowMajor;
using Params=DescriptorBankStableEpilogue::Params;
__aicore__ __forceinline__ HdlDeferredOutputEpilogue(Arch::Resource &resource) {
Buffer *buffers[]={&zb,&qb,&sb,&yb};
const uint32_t offsets[]={0,65536,131072,132096};
for(uint32_t i=0;i<4;++i)buffers[i]->tensor=resource.ubBuf.GetBufferByByte<uint8_t>(offsets[i]);
}
__aicore__ __forceinline__ ~HdlDeferredOutputEpilogue() {
if(outputPending){
WaitFlag<HardEvent::V_MTE2>(EVENT_ID1);
WaitFlag<HardEvent::MTE3_V>(EVENT_ID1);
}
PipeBarrier<PIPE_ALL>();
}
__aicore__ __forceinline__ void UpdateParams(Params const&p) {
plan.n=p.yl.stride(0);scale.SetGlobalBuffer(p.sp);y.SetGlobalBuffer(p.yp);
}
__aicore__ __forceinline__ void operator()(GemmCoord const&shape,GemmCoord const&coord,
GemmCoord const&actual,GlobalTensor<int32_t> const&src,layout::RowMajor const&srcLayout) {
const uint32_t perSub=(actual.m()+1)/2,first=GetSubBlockIdx()*perSub;
const uint32_t end=first+perSub<actual.m()?first+perSub:actual.m();
if(first>=end)return;
accumStride=srcLayout.stride(0);accum=src[uint64_t(first)*accumStride];
Compute64(coord.m()*shape.m()+first,coord.n()*shape.n(),end-first,actual.n());
}
private:
__aicore__ __forceinline__ void Compute64(uint32_t row,uint32_t col,uint32_t vm,uint32_t vn) {
const uint32_t e=0, stride=(vn+7)/8*8, len=vm*stride;
auto ci = qb.Get<int32_t>();
auto z = zb.Get<float>();
auto q = qb.Get<float>();
auto s = sb.Get<float>();
auto out = yb.Get<half>();
if(outputPending)WaitFlag<HardEvent::V_MTE2>(EVENT_ID1);
DataCopyPad(ci, accum,
DataCopyExtParams{static_cast<uint16_t>(vm), vn * 4, (accumStride - vn) * 4, 0, 0},
DataCopyPadExtParams<int32_t>{true, 0, static_cast<uint8_t>(stride - vn), 0});
DataCopyPad(s, scale[uint64_t(e) * plan.n + col],
DataCopyExtParams{1, vn * 4, 0, 0, 0},
DataCopyPadExtParams<float>{true, 0, static_cast<uint8_t>(stride - vn), 0.0f});
SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
Cast(z, ci, RoundMode::CAST_RINT, len);
BinaryRepeatParams br;
br.dstBlkStride = 1; br.src0BlkStride = 1; br.src1BlkStride = 1;
br.dstRepStride = stride / 8; br.src0RepStride = stride / 8; br.src1RepStride = 0;
for (uint32_t col = 0; col < stride; col += 64) {
const uint64_t mask = stride - col < 64 ? stride - col : 64;
Mul(z[col], z[col], s[col], mask, static_cast<uint8_t>(vm), br);
}
Mul(q, z, z, len);
Muls(q, q, 0.044715f, len);
Adds(q, q, 1.0f, len);
Mul(q, q, z, len);
Muls(q, q, -1.5957691216057308f, len);
Mins(q, q, 87.0f, len);
Exp(q, q, len);
Adds(q, q, 1.0f, len);
Div(q, z, q, len);
if(outputPending) {
WaitFlag<HardEvent::MTE3_V>(EVENT_ID1);
outputPending=false;
}
Cast(out,q,RoundMode::CAST_RINT,len);
SetFlag<HardEvent::V_MTE2>(EVENT_ID1);
SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
DataCopyPad(y[uint64_t(row)*plan.n+col],out,
DataCopyExtParams{static_cast<uint16_t>(vm),vn*2,
(stride-(vn+15)/16*16)/16,(plan.n-vn)*2,0});
SetFlag<HardEvent::MTE3_V>(EVENT_ID1);
outputPending=true;
}
uint32_t accumStride;struct{uint32_t n;}plan;
GlobalTensor<float>scale;GlobalTensor<half>y;GlobalTensor<int32_t>accum;
Buffer zb,qb,sb,yb;
bool outputPending=false;
};
}
namespace public_gmg {
class HdlDoubleInputEpilogue {
public:
using ElementScale=float;using LayoutScale=layout::VectorLayout;
using ElementD=half;using LayoutD=layout::RowMajor;
using Params=DescriptorBankStableEpilogue::Params;
__aicore__ __forceinline__ HdlDoubleInputEpilogue(Arch::Resource&r){
for(uint32_t s=0;s<2;++s){
zb[s].tensor=r.ubBuf.GetBufferByByte<uint8_t>(s*32768);
yb[s].tensor=r.ubBuf.GetBufferByByte<uint8_t>(98304+s*16384);
sb[s].tensor=r.ubBuf.GetBufferByByte<uint8_t>(131072+s*1024);
}
qb.tensor=r.ubBuf.GetBufferByByte<uint8_t>(65536);
}
__aicore__ __forceinline__ ~HdlDoubleInputEpilogue(){
if(pending.valid){if(pending.slot==0)Finish<0>(pending);else Finish<1>(pending);}
for(uint32_t s=0;s<2;++s)if(used[s]){
WaitFlag<HardEvent::V_MTE2>(s);
WaitFlag<HardEvent::MTE3_V>(s);
}
PipeBarrier<PIPE_ALL>();
}
__aicore__ __forceinline__ void UpdateParams(Params const&p){
n=p.yl.stride(0);scale.SetGlobalBuffer(p.sp);outputBase=p.yp;
}
__aicore__ __forceinline__ void operator()(GemmCoord const&shape,GemmCoord const&coord,
GemmCoord const&actual,GlobalTensor<int32_t>const&src,layout::RowMajor const&sl,Arch::CrossCoreFlag&ack){
if(nextSlot==0)Step<0>(shape,coord,actual,src,sl,ack);
else Step<1>(shape,coord,actual,src,sl,ack);
}
template<uint32_t Slot>
__aicore__ __forceinline__ void Step(GemmCoord const&shape,GemmCoord const&coord,
GemmCoord const&actual,GlobalTensor<int32_t>const&src,layout::RowMajor const&sl,Arch::CrossCoreFlag&ack){
const uint32_t per=(actual.m()+1)/2,first=GetSubBlockIdx()*per;
const uint32_t end=min(actual.m(),first+per);
if(first>=end){Arch::Signal<PIPE_MTE2>(ack);return;}
const uint32_t rows=end-first,cols=actual.n(),stride=(cols+7)/8*8;
constexpr uint32_t slot=Slot;const uint32_t len=rows*stride;
auto z=zb[slot].Get<float>();auto ci=z.ReinterpretCast<int32_t>();
auto sc=sb[slot].Get<float>();auto q=qb.Get<float>();auto out=yb[slot].Get<half>();
if(used[slot])WaitFlag<HardEvent::V_MTE2>(slot);
DataCopyPad(ci,src[uint64_t(first)*sl.stride(0)],
DataCopyExtParams{static_cast<uint16_t>(rows),cols*4,static_cast<uint32_t>((sl.stride(0)-cols)*4),0,0},
DataCopyPadExtParams<int32_t>{true,0,static_cast<uint8_t>(stride-cols),0});
DataCopyPad(sc,scale[coord.n()*shape.n()],DataCopyExtParams{1,cols*4,0,0,0},
DataCopyPadExtParams<float>{true,0,static_cast<uint8_t>(stride-cols),0.0f});
Arch::Signal<PIPE_MTE2>(ack);
SetFlag<HardEvent::MTE2_V>(slot);WaitFlag<HardEvent::MTE2_V>(slot);
Cast(z,ci,RoundMode::CAST_RINT,len);
BinaryRepeatParams br;
br.dstBlkStride=1;br.src0BlkStride=1;br.src1BlkStride=1;
br.dstRepStride=stride/8;br.src0RepStride=stride/8;br.src1RepStride=0;
for(uint32_t c=0;c<stride;c+=64){
const uint64_t mask=stride-c<64?stride-c:64;
Mul(z[c],z[c],sc[c],mask,static_cast<uint8_t>(rows),br);
}
Mul(q,z,z,len);
Muls(q,q,0.044715f,len);
Adds(q,q,1.0f,len);
Mul(q,q,z,len);
Muls(q,q,-1.5957691216057308f,len);
Mins(q,q,87.0f,len);
Exp(q,q,len);
Adds(q,q,1.0f,len);
Div(q,z,q,len);
if(used[slot])WaitFlag<HardEvent::MTE3_V>(slot);
Cast(out,q,RoundMode::CAST_RINT,len);
SetFlag<HardEvent::V_MTE2>(slot);
SetFlag<HardEvent::V_MTE3>(slot);
if(pending.valid)Finish<Slot^1>(pending);
pending={rows,cols,stride,slot,outputBase+uint64_t(coord.m()*shape.m()+first)*n+coord.n()*shape.n(),n,true};
used[slot]=true;nextSlot^=1;
}
private:
struct Pending{
uint32_t rows=0,cols=0,stride=0,slot=0;
__gm__ half*dst=nullptr;uint32_t n=0;bool valid=false;
};
template<uint32_t Slot>
__aicore__ __forceinline__ void Finish(Pending const&p){
WaitFlag<HardEvent::V_MTE3>(Slot);
GlobalTensor<half>destination;destination.SetGlobalBuffer(p.dst);
DataCopyPad(destination,yb[Slot].Get<half>(),
DataCopyExtParams{static_cast<uint16_t>(p.rows),p.cols*2,
(p.stride-(p.cols+15)/16*16)/16,(p.n-p.cols)*2,0});
SetFlag<HardEvent::MTE3_V>(Slot);
}
Buffer zb[2],yb[2],sb[2],qb;
GlobalTensor<float>scale;__gm__ half*outputBase=nullptr;
Pending pending;bool used[2]={false,false};uint32_t nextSlot=0,n=0;
};
}
namespace direct_core {
template<class BlockMmad_, class BlockEpilogue_>
class InputConsumedGrouped {
public:
using BlockMmad = BlockMmad_;
using L1TileShape = typename BlockMmad::L1TileShape;
using ElementA = int8_t;
using ElementB = int8_t;
using ElementC = int32_t;
using ElementGroupList = int64_t;
using LayoutA = layout::RowMajor;
using LayoutB = layout::RowMajor;
using LayoutC = layout::RowMajor;
using LayoutD = layout::RowMajor;
using LayoutScale = layout::VectorLayout;
using BlockEpilogue = BlockEpilogue_;
using EpilogueParams = typename BlockEpilogue::Params;
using BlockScheduler = RowSwizzle3;
static constexpr uint32_t WORKSPACE_STAGES = 4;
using Params = GroupParams;
using Arguments = GroupArguments;
static size_t GetWorkspaceSize(Arguments const &args) {
const uint32_t n = RoundUp<16>(args.problemShape.n() < L1TileShape::N ? args.problemShape.n() : L1TileShape::N);
return static_cast<size_t>(L1TileShape::M) * n * args.aicCoreNum * WORKSPACE_STAGES * sizeof(uint32_t);
}
DIRECT_DEVICE
InputConsumedGrouped()
{
Arch::FlagID flagId = 0;
for (uint32_t stageId = 0; stageId < WORKSPACE_STAGES; ++stageId) {
flagAicFinishStoreList[stageId] = Arch::CrossCoreFlag(flagId++);
flagAivFinishComputeList[stageId] = Arch::CrossCoreFlag(flagId++);
}
}
DIRECT_DEVICE void operator()(Params const &params) {
if constexpr (g_coreType == AscendC::AIC) RunCube(params);
else RunVector(params);
}
DIRECT_DEVICE void RunCube(Params const &params)
{
AscendC::ICachePreLoad(1);
BlockScheduler blockScheduler;
BlockMmad blockMmad(resource);
AscendC::GlobalTensor<ElementA> gmA;
gmA.SetGlobalBuffer(params.ptrA);
AscendC::GlobalTensor<ElementGroupList> groupList;
groupList.SetGlobalBuffer(params.ptrGroupList);
uint32_t coreIdx = AscendC::GetBlockIdx();
uint32_t coreNum = AscendC::GetBlockNum();
int64_t gmGroupOffsetA = 0;
int64_t gmGroupOffsetB = 0;
AscendC::GlobalTensor<ElementC> gmC;
gmC.SetGlobalBuffer(reinterpret_cast<__gm__ ElementC *>(params.ptrWorkspace));
const uint32_t workspaceN = RoundUp<16>(params.problemShape.n() < L1TileShape::N ? params.problemShape.n() : L1TileShape::N);
auto layoutC = layout::RowMajor{L1TileShape::M * coreNum * WORKSPACE_STAGES, workspaceN};
uint32_t totalTasks = 0;
uint32_t passM = 0;
for (uint32_t g = 0; g < params.problemCount; ++g) {
uint32_t endM = static_cast<uint32_t>(groupList.GetValue(g));
uint32_t curMp = endM - passM;
passM = endM;
blockScheduler.Update(GemmCoord{curMp, params.problemShape.n(), params.problemShape.k()},
MakeCoord(L1TileShape::M, L1TileShape::N));
totalTasks += blockScheduler.GetCoreLoops();
}
uint32_t stageId = 0;
uint32_t stageUsed = 0;
uint32_t curG = 0;
uint32_t curBase = 0;
uint32_t curM = static_cast<uint32_t>(groupList.GetValue(0));
GemmCoord curShape{curM, params.problemShape.n(), params.problemShape.k()};
LayoutA layoutA = params.layoutA.GetTileLayout(curShape.GetCoordMK());
LayoutB layoutB = params.layoutB;
blockScheduler.Update(curShape, MakeCoord(L1TileShape::M, L1TileShape::N));
uint32_t curLoops = blockScheduler.GetCoreLoops();
AscendC::GlobalTensor<ElementB> gmB;
gmB.SetGlobalBuffer(params.ptrB);
for (uint32_t taskIdx = coreIdx; taskIdx < totalTasks; taskIdx += coreNum) {
while (taskIdx >= curBase + curLoops) {
gmGroupOffsetA += curShape.m() * curShape.k();
gmGroupOffsetB += curShape.k() * curShape.n();
curBase += curLoops;
++curG;
uint32_t endM = static_cast<uint32_t>(groupList.GetValue(curG));
uint32_t prevM = static_cast<uint32_t>(groupList.GetValue(curG - 1));
curShape = GemmCoord{endM - prevM, params.problemShape.n(), params.problemShape.k()};
layoutA = params.layoutA.GetTileLayout(curShape.GetCoordMK());
blockScheduler.Update(curShape, MakeCoord(L1TileShape::M, L1TileShape::N));
curLoops = blockScheduler.GetCoreLoops();
gmB.SetGlobalBuffer(params.ptrB + gmGroupOffsetB);
}
uint32_t loopIdx = taskIdx - curBase;
GemmCoord blockCoord = blockScheduler.GetBlockCoord(loopIdx);
GemmCoord actualBlockShape = blockScheduler.GetActualBlockShape(blockCoord);
const bool waitBeforeFixpipe = stageUsed == WORKSPACE_STAGES;
if (!waitBeforeFixpipe) ++stageUsed;
MatrixCoord offsetA{blockCoord.m() * L1TileShape::M, blockCoord.k() * L1TileShape::K};
MatrixCoord offsetB{blockCoord.k() * L1TileShape::K, blockCoord.n() * L1TileShape::N};
MatrixCoord offsetC{(stageId * coreNum + coreIdx) * L1TileShape::M, 0};
int64_t gmOffsetA = layoutA.GetOffset(offsetA);
int64_t gmOffsetB = layoutB.GetOffset(offsetB);
int64_t gmOffsetC = layoutC.GetOffset(offsetC);
if (waitBeforeFixpipe) Arch::Wait(flagAivFinishComputeList[stageId]);
blockMmad(
gmA[gmGroupOffsetA + gmOffsetA], layoutA,
gmB[gmOffsetB], layoutB,
gmC[gmOffsetC], layoutC,
actualBlockShape
);
Arch::Signal<PIPE_FIX>(flagAicFinishStoreList[stageId]);
stageId = (stageId + 1 < WORKSPACE_STAGES) ? (stageId + 1) : 0;
}
while (stageUsed > 0) {
uint32_t aivComputeStageId = (stageId >= stageUsed) ?
(stageId - stageUsed) : (stageId + WORKSPACE_STAGES - stageUsed);
Arch::Wait(flagAivFinishComputeList[aivComputeStageId]);
--stageUsed;
}
AscendC::PipeBarrier<PIPE_ALL>();
}
DIRECT_DEVICE void RunVector(Params const &params)
{
AscendC::ICachePreLoad(1);
BlockScheduler blockScheduler;
BlockEpilogue blockEpilogue(resource);
uint32_t coreIdx = AscendC::GetBlockIdx() / AscendC::GetSubBlockNum();
uint32_t coreNum = AscendC::GetBlockNum();
int64_t gmGroupOffsetScale = 0;
int64_t gmGroupOffsetD = 0;
AscendC::GlobalTensor<ElementGroupList> groupList;
groupList.SetGlobalBuffer(params.ptrGroupList);
AscendC::GlobalTensor<ElementC> gmC;
gmC.SetGlobalBuffer(reinterpret_cast<__gm__ ElementC *>(params.ptrWorkspace));
const uint32_t workspaceN = RoundUp<16>(params.problemShape.n() < L1TileShape::N ? params.problemShape.n() : L1TileShape::N);
auto layoutC = layout::RowMajor{L1TileShape::M * coreNum * WORKSPACE_STAGES, workspaceN};
uint32_t stageId = 0;
uint32_t startCoreIdx = 0;
for (uint32_t groupIdx = 0; groupIdx < params.problemCount; ++groupIdx) {
uint32_t currentM = (groupIdx == 0) ? groupList.GetValue(groupIdx) :
(groupList.GetValue(groupIdx) - groupList.GetValue(groupIdx - 1));
GemmCoord inGroupProblemShape{currentM, params.problemShape.n(), params.problemShape.k()};
LayoutScale layoutScale = params.layoutScale;
LayoutD layoutD = params.layoutD.GetTileLayout(inGroupProblemShape.GetCoordMN());
EpilogueParams epilogueParams{
params.ptrScale + gmGroupOffsetScale, layoutScale,
params.ptrD + gmGroupOffsetD, layoutD
};
blockScheduler.Update(inGroupProblemShape, L1TileShape::ToCoordMN());
blockEpilogue.UpdateParams(epilogueParams);
uint32_t coreLoops = blockScheduler.GetCoreLoops();
GemmCoord blockShapeMNK = L1TileShape::ToCoord();
uint32_t startLoopIdx = ((coreIdx < startCoreIdx) ? (coreIdx + coreNum) : coreIdx) - startCoreIdx;
for (uint32_t loopIdx = startLoopIdx; loopIdx < coreLoops; loopIdx += coreNum) {
GemmCoord blockCoordMNK = blockScheduler.GetBlockCoord(loopIdx);
GemmCoord actualBlockShapeMNK = blockScheduler.GetActualBlockShape(blockCoordMNK);
MatrixCoord offsetC{(stageId * coreNum + coreIdx) * L1TileShape::M, 0};
int64_t gmOffsetC = layoutC.GetOffset(offsetC);
auto gmBlockC = gmC[gmOffsetC];
auto layoutBlockC = layoutC.GetTileLayout(actualBlockShapeMNK.GetCoordMN());
Arch::Wait(flagAicFinishStoreList[stageId]);
blockEpilogue(blockShapeMNK, blockCoordMNK, actualBlockShapeMNK,
gmBlockC, layoutBlockC, flagAivFinishComputeList[stageId]);
stageId = (stageId + 1 < WORKSPACE_STAGES) ? (stageId + 1) : 0;
}
gmGroupOffsetScale += inGroupProblemShape.n();
gmGroupOffsetD += inGroupProblemShape.m() * inGroupProblemShape.n();
startCoreIdx = (startCoreIdx + coreLoops) % coreNum;
}
AscendC::PipeBarrier<PIPE_ALL>();
}
private:
Arch::CrossCoreFlag flagAicFinishStoreList[WORKSPACE_STAGES];
Arch::CrossCoreFlag flagAivFinishComputeList[WORKSPACE_STAGES];
Arch::Resource resource;
};
}
namespace hdl_r1 {
using Tile=direct_core::GemmShape<64,256,512>;
using L0Tile=direct_core::GemmShape<64,256,128>;
using Mmad=direct_core::DirectInt8Block<Tile,L0Tile>;
using Kernel=direct_core::DirectGrouped<Mmad,public_gmg::HdlR2Epilogue>;
}
extern "C" __global__ __aicore__ __attribute__((section(".text.zzzzz_hdl_r2"))) void grouped_matmul_gelu_hdl_r2(
GM_ADDR x,GM_ADDR w,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,GM_ADDR scratch,gmg::Plan plan){
KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
AscendC::SetSyncBaseAddr(plan.ffts);
hdl_r1::Kernel::Params params{
direct_core::GemmCoord{plan.m,plan.n,plan.k},plan.e,groups,
x,direct_core::layout::RowMajor{plan.m,plan.k},w,direct_core::layout::RowMajor{plan.k,plan.n},
scale,direct_core::layout::VectorLayout{plan.n},y,direct_core::layout::RowMajor{plan.m,plan.n},scratch};
if(plan.k<=hdl_r1::Tile::K){
using Deferred=direct_core::InputConsumedGrouped<hdl_r1::Mmad,public_gmg::HdlDoubleInputEpilogue>;
Deferred op;op(params);
}else{
hdl_r1::Kernel op;op(params);
}
}
namespace public_gmg {
class HersPackedEpilogue {
public:
using ElementScale=float; using LayoutScale=layout::VectorLayout;
using ElementD=half; using LayoutD=layout::RowMajor;
using Params=DescriptorBankStableEpilogue::Params;
__aicore__ __forceinline__ HersPackedEpilogue(Arch::Resource &resource) {
Buffer *buffers[]={&zb,&qb,&sb,&yb};
const uint32_t offsets[]={256,66048,131584,132864};
for(uint32_t i=0;i<4;++i)buffers[i]->tensor=resource.ubBuf.GetBufferByByte<uint8_t>(offsets[i]);
}
__aicore__ __forceinline__ ~HersPackedEpilogue(){if(inputPending)WaitFlag<HardEvent::V_MTE2>(EVENT_ID3);if(outputPending)WaitFlag<HardEvent::MTE3_V>(EVENT_ID2);}
__aicore__ __forceinline__ void UpdateParams(Params const&p) {
plan.n=p.yl.stride(0);scale.SetGlobalBuffer(p.sp);y.SetGlobalBuffer(p.yp);
scaleCached=false;
}
__aicore__ __forceinline__ void operator()(GemmCoord const&shape,GemmCoord const&coord,
GemmCoord const&actual,GlobalTensor<int32_t> const&src,layout::RowMajor const&srcLayout,Arch::CrossCoreFlag &ack) {
const uint32_t perSub=(actual.m()+1)/2,first=GetSubBlockIdx()*perSub;
const uint32_t end=first+perSub<actual.m()?first+perSub:actual.m();
if(first>=end){Arch::Signal<PIPE_MTE2>(ack);return;}
accumStride=srcLayout.stride(0);accum=src[uint64_t(first)*accumStride];
Compute64(coord.m()*shape.m()+first,coord.n()*shape.n(),end-first,actual.n(),ack);
}
private:
__aicore__ __forceinline__ void Compute64(uint32_t row,uint32_t col,uint32_t vm,uint32_t vn,Arch::CrossCoreFlag &ack) {
const uint32_t e=0, stride=(vn+7)/8*8, len=vm*stride;
auto ci = qb.Get<int32_t>();
auto z = zb.Get<float>();
auto q = qb.Get<float>();
auto s = sb.Get<float>();
auto out = yb.Get<half>();
if(inputPending){WaitFlag<HardEvent::V_MTE2>(EVENT_ID3);inputPending=false;}
DataCopyPad(ci, accum,
DataCopyExtParams{static_cast<uint16_t>(vm), vn * 4, (accumStride - vn) * 4, 0, 0},
DataCopyPadExtParams<int32_t>{true, 0, static_cast<uint8_t>(stride - vn), 0});
if(!scaleCached || cachedCol!=col || cachedVn!=vn){
DataCopyPad(s, scale[uint64_t(e) * plan.n + col],
DataCopyExtParams{1, vn * 4, 0, 0, 0},
DataCopyPadExtParams<float>{true, 0, static_cast<uint8_t>(stride - vn), 0.0f});
scaleCached=true;cachedCol=col;cachedVn=vn;
}
SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
Arch::Signal<PIPE_MTE2>(ack);
Cast(z, ci, RoundMode::CAST_RINT, len);
BinaryRepeatParams br;
br.dstBlkStride = 1; br.src0BlkStride = 1; br.src1BlkStride = 1;
br.dstRepStride = stride / 8; br.src0RepStride = stride / 8; br.src1RepStride = 0;
for (uint32_t col = 0; col < stride; col += 64) {
const uint64_t mask = stride - col < 64 ? stride - col : 64;
Mul(z[col], z[col], s[col], mask, static_cast<uint8_t>(vm), br);
}
Mul(q, z, z, len);
Muls(q, q, 0.044715f, len);
Adds(q, q, 1.0f, len);
Mul(q, q, z, len);
Muls(q, q, -1.5957691216057308f, len);
Mins(q, q, 87.0f, len);
Exp(q, q, len);
Adds(q, q, 1.0f, len);
Div(q, z, q, len);
const bool packed=stride%16==0;
if(outputPending){WaitFlag<HardEvent::MTE3_V>(EVENT_ID2);outputPending=false;}
if(packed)Cast(out,q,RoundMode::CAST_RINT,len);
else for(uint32_t r=0;r<vm;++r)Cast(out[r*256],q[r*stride],RoundMode::CAST_RINT,stride);
SetFlag<HardEvent::V_MTE2>(EVENT_ID3);inputPending=true;
SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
DataCopyPad(y[uint64_t(row)*plan.n+col],out,
DataCopyExtParams{static_cast<uint16_t>(vm),vn*2,
((packed?stride:256)-(vn+15)/16*16)/16,(plan.n-vn)*2,0});
SetFlag<HardEvent::MTE3_V>(EVENT_ID2);outputPending=true;
}
bool scaleCached{false};uint32_t cachedCol{0},cachedVn{0};
bool outputPending{false},inputPending{false};
uint32_t accumStride;struct{uint32_t n;}plan;
GlobalTensor<float>scale;GlobalTensor<half>y;GlobalTensor<int32_t>accum;
Buffer zb,qb,sb,yb;
};
}
namespace direct_core {
template<class L1TileShape_, class L0TileShape_>
struct HersCachedBBlock {
public:
using ArchTag = Arch::AtlasA2;
using L1TileShape = L1TileShape_;
using L0TileShape = L0TileShape_;
using ElementA = int8_t;
using ElementB = int8_t;
using ElementC = int32_t;
using ElementAccumulator = int32_t;
using LayoutA = layout::RowMajor;
using LayoutB = layout::RowMajor;
using LayoutC = layout::RowMajor;
using TileMmad = ops::Int8Mmad;
using CopyGmToL1A = ops::Int8GmToL1;
using CopyGmToL1B = ops::Int8GmToL1;
using CopyL1ToL0A = ops::Int8L1ToL0A;
using CopyL1ToL0B = ops::Int8L1ToL0B;
using CopyL0CToGm = ops::Int32L0CToGm;
using LayoutAInL1 = typename CopyL1ToL0A::LayoutSrc;
using LayoutBInL1 = typename CopyL1ToL0B::LayoutSrc;
using LayoutAInL0 = typename CopyL1ToL0A::LayoutDst;
using LayoutBInL0 = typename CopyL1ToL0B::LayoutDst;
using LayoutCInL0 = layout::Accumulator;
static constexpr uint32_t STAGES = 2;
static constexpr uint32_t L1A_SIZE = L1TileShape::M * L1TileShape::K * sizeof(ElementA);
static constexpr uint32_t L1B_SIZE = L1TileShape::N * L1TileShape::K * sizeof(ElementB);
static constexpr uint32_t L0A_SIZE = ArchTag::L0A_SIZE;
static constexpr uint32_t L0B_SIZE = ArchTag::L0B_SIZE;
static constexpr uint32_t L0C_SIZE = ArchTag::L0C_SIZE;
static constexpr uint32_t L0A_PINGPONG_BUF_SIZE = L0A_SIZE / STAGES;
static constexpr uint32_t L0B_PINGPONG_BUF_SIZE = L0B_SIZE / STAGES;
static_assert(direct_core::is_same_v<LayoutC, layout::RowMajor>, "LayoutC only support RowMajor yet!");
static_assert((L1A_SIZE * STAGES + L1B_SIZE * STAGES) <= ArchTag::L1_SIZE, "L1TileShape exceeding the L1 space!");
static constexpr uint32_t L0A_TILE_SIZE = L0TileShape::M * L0TileShape::K * sizeof(ElementA);
static constexpr uint32_t L0B_TILE_SIZE = L0TileShape::K * L0TileShape::N * sizeof(ElementB);
static constexpr uint32_t L0C_TILE_SIZE = L0TileShape::M * L0TileShape::N * sizeof(ElementAccumulator);
static_assert((L0A_TILE_SIZE * STAGES) <= L0A_SIZE, "L0TileShape exceeding the L0A space!");
static_assert((L0B_TILE_SIZE * STAGES) <= L0B_SIZE, "L0TileShape exceeding the L0B space!");
static_assert(L0C_TILE_SIZE <= L0C_SIZE, "L0TileShape exceeding the L0C space!");
static_assert(L1TileShape::M == L0TileShape::M && L1TileShape::N == L0TileShape::N,
"The situation where the basic blocks of L1 and L0 differ on the m and n axes is not supported yet");
static_assert(L0TileShape::K <= L1TileShape::K, "L0TileShape::K cannot exceed L1TileShape::K");
DIRECT_DEVICE
HersCachedBBlock(Arch::Resource &resource, uint32_t l1BufAddrStart = 0)
{
uint32_t l1AOffset = l1BufAddrStart;
uint32_t l1BOffset = l1BufAddrStart + L1A_SIZE * STAGES;
for (uint32_t i = 0; i < STAGES; i++) {
l1ATensorList[i] = resource.l1Buf.template GetBufferByByte<ElementA>(l1AOffset + L1A_SIZE * i);
l1BTensorList[i] = resource.l1Buf.template GetBufferByByte<ElementB>(l1BOffset + L1B_SIZE * i);
l0ATensorList[i] = resource.l0ABuf.template GetBufferByByte<ElementA>(L0A_PINGPONG_BUF_SIZE * i);
l0BTensorList[i] = resource.l0BBuf.template GetBufferByByte<ElementB>(L0B_PINGPONG_BUF_SIZE * i);
l1AEventList[i] = i;
l1BEventList[i] = i + STAGES;
l0AEventList[i] = i;
l0BEventList[i] = i + STAGES;
AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(l1AEventList[i]);
AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(l1BEventList[i]);
AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(l0AEventList[i]);
AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(l0BEventList[i]);
}
l0CTensor = resource.l0CBuf.template GetBufferByByte<ElementAccumulator>(0);
AscendC::SetFlag<AscendC::HardEvent::FIX_M>(EVENT_ID0);
}
DIRECT_DEVICE
~HersCachedBBlock()
{
for (uint32_t i = 0; i < STAGES; i++) {
AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(l1AEventList[i]);
AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(l1BEventList[i]);
AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(l0AEventList[i]);
AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(l0BEventList[i]);
}
AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(EVENT_ID0);
}
DIRECT_DEVICE
void operator()(
AscendC::GlobalTensor<ElementA> const &gmA, LayoutA const &layoutA,
AscendC::GlobalTensor<ElementB> const &gmB, LayoutB const &layoutB,
AscendC::GlobalTensor<ElementC> const &gmC, LayoutC const &layoutC,
GemmCoord const &actualShape)
{
uint32_t mRound = RoundUp<16>(actualShape.m());
uint32_t nRound = RoundUp<32>(actualShape.n());
auto layoutAInL1 = LayoutAInL1::template MakeLayout<ElementA>(L1TileShape::M, L1TileShape::K);
auto layoutBInL1 = LayoutBInL1::template MakeLayout<ElementB>(L1TileShape::K, L1TileShape::N);
auto layoutInL0C = LayoutCInL0::MakeLayoutInL0C(MakeCoord(mRound, nRound));
uint32_t kActual = min(actualShape.k(), L1TileShape::K);
const uint64_t bAddress=reinterpret_cast<uint64_t>(gmB.GetPhyAddr());
const bool reuseB=cachedValid && cachedAddress==bAddress && cachedK==actualShape.k() && cachedN==actualShape.n() && cachedPitch==layoutB.stride(0) && CeilDiv<L1TileShape::K>(actualShape.k())==2;
cachedValid=CeilDiv<L1TileShape::K>(actualShape.k())==2;cachedAddress=bAddress;
cachedK=actualShape.k();cachedN=actualShape.n();cachedPitch=layoutB.stride(0);
AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(l1AEventList[l1ListId]);
auto layoutTileA = layoutA.GetTileLayout(MakeCoord(actualShape.m(), kActual));
copyGmToL1A(l1ATensorList[l1ListId], gmA, layoutAInL1, layoutTileA);
AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(l1AEventList[l1ListId]);
AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(l1BEventList[l1ListId]);
auto layoutTileB = layoutB.GetTileLayout(MakeCoord(kActual, actualShape.n()));
if(!reuseB)copyGmToL1B(l1BTensorList[l1ListId], gmB, layoutBInL1, layoutTileB);
AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(l1BEventList[l1ListId]);
AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(EVENT_ID0);
uint32_t mPartLoop = CeilDiv<L0TileShape::M>(mRound);
uint32_t nPartLoop = CeilDiv<L0TileShape::N>(nRound);
uint32_t kTileCount = CeilDiv<L1TileShape::K>(actualShape.k());
for (uint32_t kLoopIdx = 0; kLoopIdx < kTileCount; kLoopIdx++) {
uint32_t l1ListIdNext = (l1ListId + 1 < STAGES) ? (l1ListId + 1) : 0;
uint32_t kActualNext{0};
if (kLoopIdx < kTileCount - 1) {
uint32_t kLoopIdxNext = kLoopIdx + 1;
kActualNext = (kLoopIdxNext < kTileCount - 1) ?
L1TileShape::K : (actualShape.k() - kLoopIdxNext * L1TileShape::K);
auto l1ATensor = l1ATensorList[l1ListIdNext];
auto l1BTensor = l1BTensorList[l1ListIdNext];
MatrixCoord gmTileAOffset{0, kLoopIdxNext * L1TileShape::K};
MatrixCoord gmTileBOffset{kLoopIdxNext * L1TileShape::K, 0};
auto gmTileA = gmA[layoutA.GetOffset(gmTileAOffset)];
auto gmTileB = gmB[layoutB.GetOffset(gmTileBOffset)];
AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(l1AEventList[l1ListIdNext]);
layoutTileA = layoutA.GetTileLayout(MakeCoord(actualShape.m(), kActualNext));
copyGmToL1A(l1ATensor, gmTileA, layoutAInL1, layoutTileA);
AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(l1AEventList[l1ListIdNext]);
AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(l1BEventList[l1ListIdNext]);
layoutTileB = layoutB.GetTileLayout(MakeCoord(kActualNext, actualShape.n()));
if(!reuseB)copyGmToL1B(l1BTensor, gmTileB, layoutBInL1, layoutTileB);
AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(l1BEventList[l1ListIdNext]);
}
auto l1ATensor = l1ATensorList[l1ListId];
auto l1BTensor = l1BTensorList[l1ListId];
uint32_t kPartLoop = CeilDiv<L0TileShape::K>(kActual);
for (int mPartIdx = 0; mPartIdx < mPartLoop; mPartIdx++) {
uint32_t mPartActual = (mPartIdx < mPartLoop - 1) ?
L0TileShape::M : (mRound - mPartIdx * L0TileShape::M);
for (int kPartIdx = 0; kPartIdx < kPartLoop; kPartIdx++) {
uint32_t kPartActual = (kPartIdx < kPartLoop - 1) ?
L0TileShape::K : (kActual - kPartIdx * L0TileShape::K);
auto l0ATile = l0ATensorList[l0AListId];
LayoutAInL0 layoutAInL0 = LayoutAInL0::template MakeLayout<ElementA>(mPartActual, kPartActual);
MatrixCoord l1AOffset{mPartIdx * L0TileShape::M, kPartIdx * L0TileShape::K};
auto l1ATile = l1ATensor[layoutAInL1.GetOffset(l1AOffset)];
AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(l0AEventList[l0AListId]);
if ((mPartIdx == 0) && (kPartIdx == 0)) {
AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(l1AEventList[l1ListId]);
}
copyL1ToL0A(l0ATile, l1ATile, layoutAInL0, layoutAInL1);
if ((mPartIdx == mPartLoop - 1) && (kPartIdx == kPartLoop - 1)) {
AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(l1AEventList[l1ListId]);
}
for (int nPartIdx = 0; nPartIdx < nPartLoop; nPartIdx++) {
uint32_t nPartActual = (nPartIdx < nPartLoop - 1) ?
L0TileShape::N : (nRound - nPartIdx * L0TileShape::N);
auto l0BTile = l0BTensorList[l0BListId];
LayoutBInL0 layoutBInL0 = LayoutBInL0::template MakeLayout<ElementB>(kPartActual, nPartActual);
MatrixCoord l1BOffset{kPartIdx * L0TileShape::K, nPartIdx * L0TileShape::N};
auto l1BTile = l1BTensor[layoutBInL1.GetOffset(l1BOffset)];
AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(l0BEventList[l0BListId]);
if ((kPartIdx == 0) && (nPartIdx == 0)) {
AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(l1BEventList[l1ListId]);
}
copyL1ToL0B(l0BTile, l1BTile, layoutBInL0, layoutBInL1);
if ((kPartIdx == kPartLoop - 1) && (nPartIdx == nPartLoop - 1)) {
AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(l1BEventList[l1ListId]);
}
AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID0);
MatrixCoord l0COffset{mPartIdx * L0TileShape::M, nPartIdx * L0TileShape::N};
auto l0CTile = l0CTensor[layoutInL0C.GetOffset(l0COffset)];
AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID0);
bool initC = ((kLoopIdx == 0) && (kPartIdx == 0));
uint8_t unitFlag = 0b00;
tileMmad(l0CTile, l0ATile, l0BTile, mPartActual, nPartActual, kPartActual, initC, unitFlag);
AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(l0BEventList[l0BListId]);
l0BListId = (l0BListId + 1 < STAGES) ? (l0BListId + 1) : 0;
}
AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(l0AEventList[l0AListId]);
l0AListId = (l0AListId + 1 < STAGES) ? (l0AListId + 1) : 0;
}
}
l1ListId = l1ListIdNext;
kActual = kActualNext;
}
LayoutC layoutBlock = layoutC.GetTileLayout(actualShape.GetCoordMN());
AscendC::SetFlag<AscendC::HardEvent::M_FIX>(EVENT_ID0);
AscendC::WaitFlag<AscendC::HardEvent::M_FIX>(EVENT_ID0);
copyL0CToGm(gmC, l0CTensor, layoutBlock, layoutInL0C);
AscendC::SetFlag<AscendC::HardEvent::FIX_M>(EVENT_ID0);
}
protected:
bool cachedValid{false};uint64_t cachedAddress{0};uint32_t cachedK{0},cachedN{0},cachedPitch{0};
AscendC::LocalTensor<ElementA> l1ATensorList[STAGES];
AscendC::LocalTensor<ElementB> l1BTensorList[STAGES];
AscendC::LocalTensor<ElementA> l0ATensorList[STAGES];
AscendC::LocalTensor<ElementB> l0BTensorList[STAGES];
AscendC::LocalTensor<ElementAccumulator> l0CTensor;
int32_t l1AEventList[STAGES];
int32_t l1BEventList[STAGES];
int32_t l0AEventList[STAGES];
int32_t l0BEventList[STAGES];
uint32_t l1ListId{0};
uint32_t l0AListId{0};
uint32_t l0BListId{0};
TileMmad tileMmad;
CopyGmToL1A copyGmToL1A;
CopyGmToL1B copyGmToL1B;
CopyL1ToL0A copyL1ToL0A;
CopyL1ToL0B copyL1ToL0B;
CopyL0CToGm copyL0CToGm;
};
template<class BlockMmad_, class BlockEpilogue_>
class HersPackedGrouped {
public:
DIRECT_DEVICE static GemmCoord PersistentCoord(uint32_t job,uint32_t ownN,uint32_t rank,
uint32_t panelCores,uint32_t primaryTasks,uint32_t spillBegin,uint32_t taskCap,
uint32_t mTiles,uint32_t nPanels,uint32_t coreNum){
if(job<primaryTasks)return {rank+job*panelCores,ownN,0};
uint32_t spill=spillBegin+job-primaryTasks;
for(uint32_t nc=0;nc<nPanels;++nc){
const uint32_t ncCores=(coreNum+nPanels-1-nc)/nPanels;
const uint32_t primaryM=min(mTiles,taskCap*ncCores),count=mTiles-primaryM;
if(spill<count)return {primaryM+spill,nc,0};
spill-=count;
}
return {0,0,0};
}
using BlockMmad = BlockMmad_;
using L1TileShape = typename BlockMmad::L1TileShape;
using ElementA = int8_t;
using ElementB = int8_t;
using ElementC = int32_t;
using ElementGroupList = int64_t;
using LayoutA = layout::RowMajor;
using LayoutB = layout::RowMajor;
using LayoutC = layout::RowMajor;
using LayoutD = layout::RowMajor;
using LayoutScale = layout::VectorLayout;
using BlockEpilogue = BlockEpilogue_;
using EpilogueParams = typename BlockEpilogue::Params;
using BlockScheduler = RowSwizzle3;
static constexpr uint32_t WORKSPACE_STAGES = 4;
using Params = GroupParams;
using Arguments = GroupArguments;
static size_t GetWorkspaceSize(Arguments const &args) {
const uint32_t n = RoundUp<16>(args.problemShape.n() < L1TileShape::N ? args.problemShape.n() : L1TileShape::N);
return static_cast<size_t>(L1TileShape::M) * n * args.aicCoreNum * WORKSPACE_STAGES * sizeof(uint32_t);
}
DIRECT_DEVICE
HersPackedGrouped(GM_ADDR originalWeight, uint32_t originalK)
: rawWeight(reinterpret_cast<__gm__ int8_t*>(originalWeight)), rawK(originalK)
{
Arch::FlagID flagId = 0;
for (uint32_t stageId = 0; stageId < WORKSPACE_STAGES; ++stageId) {
flagAicFinishStoreList[stageId] = Arch::CrossCoreFlag(flagId++);
flagAivFinishComputeList[stageId] = Arch::CrossCoreFlag(flagId++);
}
}
DIRECT_DEVICE void operator()(Params const &params) {
if constexpr (g_coreType == AscendC::AIC) RunCube(params);
else RunVector(params);
}
DIRECT_DEVICE void RunCube(Params const &params)
{
AscendC::ICachePreLoad(1);
BlockScheduler blockScheduler;
BlockMmad blockMmad(resource);
AscendC::GlobalTensor<ElementA> gmA;
gmA.SetGlobalBuffer(params.ptrA);
AscendC::GlobalTensor<ElementGroupList> groupList;
groupList.SetGlobalBuffer(params.ptrGroupList);
uint32_t coreIdx = AscendC::GetBlockIdx();
uint32_t coreNum = AscendC::GetBlockNum();
int64_t gmGroupOffsetA = 0;
int64_t gmGroupOffsetB = 0;
AscendC::GlobalTensor<ElementC> gmC;
gmC.SetGlobalBuffer(reinterpret_cast<__gm__ ElementC *>(params.ptrWorkspace));
const uint32_t workspaceN = RoundUp<16>(params.problemShape.n() < L1TileShape::N ? params.problemShape.n() : L1TileShape::N);
auto layoutC = layout::RowMajor{L1TileShape::M * coreNum * WORKSPACE_STAGES, workspaceN};
uint32_t stageId = 0;
uint32_t stageUsed = 0;
uint32_t startCoreIdx = 0;
for(uint32_t partition=0;partition<2;++partition)
for (uint32_t groupIdx = 0; groupIdx < params.problemCount; ++groupIdx) {
uint32_t currentM = (groupIdx == 0) ? groupList.GetValue(groupIdx) :
(groupList.GetValue(groupIdx) - groupList.GetValue(groupIdx - 1));
if(currentM==0 || (currentM<=16)!=(partition==1))continue;
const uint32_t trueRowBase=groupIdx?static_cast<uint32_t>(groupList.GetValue(groupIdx-1)):0;
gmGroupOffsetA=uint64_t(trueRowBase)*params.layoutA.stride(0);
gmGroupOffsetB=uint64_t(groupIdx)*params.problemShape.k()*params.layoutB.stride(0);
const bool rawGroup=currentM<=16;
GemmCoord inGroupProblemShape{currentM, params.problemShape.n(), rawGroup?rawK:params.problemShape.k()};
LayoutA layoutA = params.layoutA.GetTileLayout(inGroupProblemShape.GetCoordMK());
LayoutB layoutB = rawGroup?LayoutB{rawK,params.problemShape.n()}:params.layoutB;
blockScheduler.Update(inGroupProblemShape, MakeCoord(L1TileShape::M, L1TileShape::N));
uint32_t coreLoops = blockScheduler.GetCoreLoops();
AscendC::GlobalTensor<ElementB> gmB;
gmB.SetGlobalBuffer(rawGroup?rawWeight+uint64_t(groupIdx)*rawK*params.problemShape.n():params.ptrB+gmGroupOffsetB);
uint32_t startLoopIdx = ((coreIdx < startCoreIdx) ? (coreIdx + coreNum) : coreIdx) - startCoreIdx;
const uint32_t nPanels=CeilDiv<L1TileShape::N>(inGroupProblemShape.n());
const uint32_t mTiles=CeilDiv<L1TileShape::M>(currentM);
const bool persistentB=nPanels>=2 && nPanels<=coreNum && mTiles>=2*CeilDiv(coreNum,nPanels);
const uint32_t ownedN=startLoopIdx%nPanels,rank=startLoopIdx/nPanels;
const uint32_t panelCores=(coreNum+nPanels-1-ownedN)/nPanels;
uint32_t primaryTasks=0,spillBegin=0,ownedTasks=0,taskCap=0;
if(persistentB){
taskCap=CeilDiv(mTiles*nPanels,coreNum);
const uint32_t primaryM=min(mTiles,taskCap*panelCores);
primaryTasks=primaryM>rank?CeilDiv(primaryM-rank,panelCores):0;
uint32_t prefixLoad=0,totalSpill=0;
for(uint32_t nc=0;nc<nPanels;++nc){
const uint32_t ncCores=(coreNum+nPanels-1-nc)/nPanels;
const uint32_t ncM=min(mTiles,taskCap*ncCores);
const uint32_t prior=startLoopIdx>nc?CeilDiv(startLoopIdx-nc,nPanels):0;
prefixLoad+=prior*(ncM/ncCores)+min(prior,ncM%ncCores);
totalSpill+=mTiles-ncM;
}
spillBegin=taskCap*startLoopIdx-prefixLoad;
const uint32_t ownSpill=spillBegin<totalSpill?min(taskCap-primaryTasks,totalSpill-spillBegin):0;
ownedTasks=primaryTasks+ownSpill;
}
const uint32_t loopEnd=persistentB?ownedTasks:coreLoops;
const uint32_t loopBegin=persistentB?0:startLoopIdx;
const uint32_t loopStep=persistentB?1:coreNum;
for (uint32_t loopIdx=loopBegin;loopIdx<loopEnd;loopIdx+=loopStep) {
GemmCoord blockCoord = persistentB?PersistentCoord(loopIdx,ownedN,rank,panelCores,primaryTasks,spillBegin,taskCap,mTiles,nPanels,coreNum):blockScheduler.GetBlockCoord(loopIdx);
GemmCoord actualBlockShape = blockScheduler.GetActualBlockShape(blockCoord);
const bool waitBeforeFixpipe = stageUsed == WORKSPACE_STAGES;
if (!waitBeforeFixpipe) ++stageUsed;
MatrixCoord offsetA{blockCoord.m() * L1TileShape::M, blockCoord.k() * L1TileShape::K};
MatrixCoord offsetB{blockCoord.k() * L1TileShape::K, blockCoord.n() * L1TileShape::N};
MatrixCoord offsetC{(stageId * coreNum + coreIdx) * L1TileShape::M, 0};
int64_t gmOffsetA = layoutA.GetOffset(offsetA);
int64_t gmOffsetB = layoutB.GetOffset(offsetB);
int64_t gmOffsetC = layoutC.GetOffset(offsetC);
if (waitBeforeFixpipe) Arch::Wait(flagAivFinishComputeList[stageId]);
blockMmad(
gmA[gmGroupOffsetA + gmOffsetA], layoutA,
gmB[gmOffsetB], layoutB,
gmC[gmOffsetC], layoutC,
GemmCoord{actualBlockShape.m(),rawGroup?actualBlockShape.n():RoundUp<32>(actualBlockShape.n()),actualBlockShape.k()}
);
Arch::Signal<PIPE_FIX>(flagAicFinishStoreList[stageId]);
stageId = (stageId + 1 < WORKSPACE_STAGES) ? (stageId + 1) : 0;
}
startCoreIdx = (startCoreIdx + coreLoops) % coreNum;
}
while (stageUsed > 0) {
uint32_t aivComputeStageId = (stageId >= stageUsed) ?
(stageId - stageUsed) : (stageId + WORKSPACE_STAGES - stageUsed);
Arch::Wait(flagAivFinishComputeList[aivComputeStageId]);
--stageUsed;
}
AscendC::PipeBarrier<PIPE_ALL>();
}
DIRECT_DEVICE void RunVector(Params const &params)
{
AscendC::ICachePreLoad(1);
BlockScheduler blockScheduler;
BlockEpilogue blockEpilogue(resource);
uint32_t coreIdx = AscendC::GetBlockIdx() / AscendC::GetSubBlockNum();
uint32_t coreNum = AscendC::GetBlockNum();
int64_t gmGroupOffsetScale = 0;
int64_t gmGroupOffsetD = 0;
AscendC::GlobalTensor<ElementGroupList> groupList;
groupList.SetGlobalBuffer(params.ptrGroupList);
AscendC::GlobalTensor<ElementC> gmC;
gmC.SetGlobalBuffer(reinterpret_cast<__gm__ ElementC *>(params.ptrWorkspace));
const uint32_t workspaceN = RoundUp<16>(params.problemShape.n() < L1TileShape::N ? params.problemShape.n() : L1TileShape::N);
auto layoutC = layout::RowMajor{L1TileShape::M * coreNum * WORKSPACE_STAGES, workspaceN};
uint32_t stageId = 0;
uint32_t startCoreIdx = 0;
for(uint32_t partition=0;partition<2;++partition)
for (uint32_t groupIdx = 0; groupIdx < params.problemCount; ++groupIdx) {
uint32_t currentM = (groupIdx == 0) ? groupList.GetValue(groupIdx) :
(groupList.GetValue(groupIdx) - groupList.GetValue(groupIdx - 1));
if(currentM==0 || (currentM<=16)!=(partition==1))continue;
const uint32_t trueRowBase=groupIdx?static_cast<uint32_t>(groupList.GetValue(groupIdx-1)):0;
gmGroupOffsetScale=uint64_t(groupIdx)*params.problemShape.n();
gmGroupOffsetD=uint64_t(trueRowBase)*params.problemShape.n();
GemmCoord inGroupProblemShape{currentM, params.problemShape.n(), params.problemShape.k()};
LayoutScale layoutScale = params.layoutScale;
LayoutD layoutD = params.layoutD.GetTileLayout(inGroupProblemShape.GetCoordMN());
EpilogueParams epilogueParams{
params.ptrScale + gmGroupOffsetScale, layoutScale,
params.ptrD + gmGroupOffsetD, layoutD
};
blockScheduler.Update(inGroupProblemShape, L1TileShape::ToCoordMN());
blockEpilogue.UpdateParams(epilogueParams);
uint32_t coreLoops = blockScheduler.GetCoreLoops();
GemmCoord blockShapeMNK = L1TileShape::ToCoord();
uint32_t startLoopIdx = ((coreIdx < startCoreIdx) ? (coreIdx + coreNum) : coreIdx) - startCoreIdx;
const uint32_t nPanels=CeilDiv<L1TileShape::N>(inGroupProblemShape.n());
const uint32_t mTiles=CeilDiv<L1TileShape::M>(currentM);
const bool persistentB=nPanels>=2 && nPanels<=coreNum && mTiles>=2*CeilDiv(coreNum,nPanels);
const uint32_t ownedN=startLoopIdx%nPanels,rank=startLoopIdx/nPanels;
const uint32_t panelCores=(coreNum+nPanels-1-ownedN)/nPanels;
uint32_t primaryTasks=0,spillBegin=0,ownedTasks=0,taskCap=0;
if(persistentB){
taskCap=CeilDiv(mTiles*nPanels,coreNum);
const uint32_t primaryM=min(mTiles,taskCap*panelCores);
primaryTasks=primaryM>rank?CeilDiv(primaryM-rank,panelCores):0;
uint32_t prefixLoad=0,totalSpill=0;
for(uint32_t nc=0;nc<nPanels;++nc){
const uint32_t ncCores=(coreNum+nPanels-1-nc)/nPanels;
const uint32_t ncM=min(mTiles,taskCap*ncCores);
const uint32_t prior=startLoopIdx>nc?CeilDiv(startLoopIdx-nc,nPanels):0;
prefixLoad+=prior*(ncM/ncCores)+min(prior,ncM%ncCores);
totalSpill+=mTiles-ncM;
}
spillBegin=taskCap*startLoopIdx-prefixLoad;
const uint32_t ownSpill=spillBegin<totalSpill?min(taskCap-primaryTasks,totalSpill-spillBegin):0;
ownedTasks=primaryTasks+ownSpill;
}
const uint32_t loopEnd=persistentB?ownedTasks:coreLoops;
const uint32_t loopBegin=persistentB?0:startLoopIdx;
const uint32_t loopStep=persistentB?1:coreNum;
for (uint32_t loopIdx=loopBegin;loopIdx<loopEnd;loopIdx+=loopStep) {
GemmCoord blockCoordMNK = persistentB?PersistentCoord(loopIdx,ownedN,rank,panelCores,primaryTasks,spillBegin,taskCap,mTiles,nPanels,coreNum):blockScheduler.GetBlockCoord(loopIdx);
GemmCoord actualBlockShapeMNK = blockScheduler.GetActualBlockShape(blockCoordMNK);
MatrixCoord offsetC{(stageId * coreNum + coreIdx) * L1TileShape::M, 0};
int64_t gmOffsetC = layoutC.GetOffset(offsetC);
auto gmBlockC = gmC[gmOffsetC];
auto layoutBlockC = layoutC.GetTileLayout(actualBlockShapeMNK.GetCoordMN());
Arch::Wait(flagAicFinishStoreList[stageId]);
blockEpilogue(blockShapeMNK, blockCoordMNK, actualBlockShapeMNK, gmBlockC, layoutBlockC,flagAivFinishComputeList[stageId]);
stageId = (stageId + 1 < WORKSPACE_STAGES) ? (stageId + 1) : 0;
}
startCoreIdx = (startCoreIdx + coreLoops) % coreNum;
}
AscendC::PipeBarrier<PIPE_ALL>();
}
private:
Arch::CrossCoreFlag flagAicFinishStoreList[WORKSPACE_STAGES];
Arch::CrossCoreFlag flagAivFinishComputeList[WORKSPACE_STAGES];
__gm__ int8_t* rawWeight;
uint32_t rawK;
Arch::Resource resource;
};
}
namespace hers_pack {
using namespace AscendC;
__aicore__ inline void PackInputs(GM_ADDR xp,GM_ADDR wp,GM_ADDR pxp,GM_ADDR pwp,GM_ADDR gp,
uint32_t e,uint32_t m,uint32_t k,uint32_t n,uint32_t pk,uint32_t pn,bool packX) {
TPipe pipe;TBuf<TPosition::VECCALC> buf;pipe.InitBuffer(buf,65536);
auto tmp=buf.Get<int8_t>();GlobalTensor<int8_t>x,w,px,pw;
x.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(xp));w.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(wp));
px.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(pxp));pw.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(pwp));
const uint32_t core=GetBlockIdx(),cores=GetBlockNum()*GetSubBlockNum();
GlobalTensor<int64_t> ends;ends.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(gp));
const uint32_t xjobs=packX?(m+63)/64:0,chunks=(pk+63)/64;
for(uint32_t job=core;job<xjobs;job+=cores){
const uint32_t row=job*64,count=m-row<64?m-row:64;
DataCopyPad(tmp,x[uint64_t(row)*k],DataCopyExtParams{static_cast<uint16_t>(count),k,0,0,0},DataCopyPadExtParams<int8_t>{true,0,static_cast<uint8_t>(pk-k),0});
SetFlag<HardEvent::MTE2_MTE3>(EVENT_ID0);WaitFlag<HardEvent::MTE2_MTE3>(EVENT_ID0);
DataCopy(px[uint64_t(row)*pk],tmp,count*pk);
SetFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);WaitFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);
}
uint32_t packedPrefix=xjobs,previous=0;
for(uint32_t expert=0;expert<e;++expert){
const uint32_t end=static_cast<uint32_t>(ends.GetValue(expert));
const uint32_t rows=end-previous;previous=end;
if(rows<=16)continue;
const uint32_t first=(core+cores-packedPrefix%cores)%cores;
for(uint32_t chunk=first;chunk<chunks;chunk+=cores){
const uint32_t row=chunk*64,count=pk-row<64?pk-row:64;
const uint32_t valid=row<k?(k-row<count?k-row:count):0;
if(valid)DataCopyPad(tmp,w[(uint64_t(expert)*k+row)*n],DataCopyExtParams{static_cast<uint16_t>(valid),n,0,0,0},DataCopyPadExtParams<int8_t>{true,0,static_cast<uint8_t>(pn-n),0});
if(valid<count){
SetFlag<HardEvent::MTE2_V>(EVENT_ID0);WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
Duplicate(tmp.ReinterpretCast<uint16_t>()[valid*pn/2],static_cast<uint16_t>(0),(count-valid)*pn/2);
SetFlag<HardEvent::V_MTE3>(EVENT_ID0);WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
}else{
SetFlag<HardEvent::MTE2_MTE3>(EVENT_ID0);WaitFlag<HardEvent::MTE2_MTE3>(EVENT_ID0);
}
DataCopy(pw[(uint64_t(expert)*pk+row)*pn],tmp,count*pn);
SetFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);WaitFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);
}
packedPrefix+=chunks;
}
PipeBarrier<PIPE_ALL>();
}
}
namespace hers_pack {
using Tile=direct_core::GemmShape<128,256,512>;using L0=direct_core::GemmShape<128,256,128>;
using Mmad=direct_core::HersCachedBBlock<Tile,L0>;
using Kernel=direct_core::HersPackedGrouped<Mmad,public_gmg::HersPackedEpilogue>;
}
extern "C" __global__ __aicore__ __attribute__((section(".text.zzzzzzz_hers_pack")))
void grouped_matmul_gelu_hers_pack(GM_ADDR x,GM_ADDR w,GM_ADDR s,GM_ADDR g,GM_ADDR y,GM_ADDR scratch,gmg::Plan p){
KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);AscendC::SetSyncBaseAddr(p.ffts);
const uint32_t pk=(p.k+31)/32*32,pn=(p.n+31)/32*32;
const uint64_t cbytes=uint64_t(p.blocks)*4*128*256*4;
GM_ADDR px=scratch+cbytes;
GM_ADDR pw=px+(true?uint64_t(p.m)*pk:0);
if ASCEND_IS_AIV {hers_pack::PackInputs(x,w,px,pw,g,p.e,p.m,p.k,p.n,pk,pn,true);}
AscendC::SyncAll<false>();
const uint32_t ck=true?pk:p.k;
hers_pack::Kernel::Params params{direct_core::GemmCoord{p.m,p.n,ck},p.e,g,
true?px:x,direct_core::layout::RowMajor{p.m,ck},pw,direct_core::layout::RowMajor{ck,pn},
s,direct_core::layout::VectorLayout{p.n},y,direct_core::layout::RowMajor{p.m,p.n},scratch};
hers_pack::Kernel op(w,p.k);op(params);
}
extern "C" __global__ __aicore__ __attribute__((section(".text.zz_p4")))
void grouped_matmul_gelu_many_experts(
GM_ADDR x, GM_ADDR w, GM_ADDR scale, GM_ADDR groups, GM_ADDR y, GM_ADDR scratch, gmg::Plan plan)
{
KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
AscendC::SetSyncBaseAddr(plan.ffts);
p4::RowKernel<64, 4> op(x,w,scale,groups,y,scratch,plan);
op.Run();
}
extern "C" __global__ __aicore__ __attribute__((section(".herl1_pipeline"))) void grouped_matmul_gelu_herl1_pipeline(GM_ADDR,GM_ADDR,GM_ADDR,GM_ADDR,GM_ADDR,GM_ADDR,gmg::Plan);
inline bool TryAsymmetricPipeline(GM_ADDR x,GM_ADDR w,GM_ADDR s,GM_ADDR g,GM_ADDR y,int64_t e,int64_t m,int64_t k,int64_t n,int64_t cores,aclrtStream stream){
if(k<1025 || k>1152 || n<512 || n>1024 || m<128*e || cores<1)return false;
auto *hw=platform_ascendc::PlatformAscendCManager::GetInstance();if(!hw)return false;
const uint32_t blocks=std::min<int64_t>(cores,std::min<int64_t>(hw->GetCoreNumAic(),hw->GetCoreNumAiv()/2));if(!blocks)return false;
uint64_t l1=0,a=0,b=0,c=0,ub=0;
hw->GetCoreMemSize(platform_ascendc::CoreMemType::L1,l1);hw->GetCoreMemSize(platform_ascendc::CoreMemType::L0_A,a);hw->GetCoreMemSize(platform_ascendc::CoreMemType::L0_B,b);hw->GetCoreMemSize(platform_ascendc::CoreMemType::L0_C,c);hw->GetCoreMemSize(platform_ascendc::CoreMemType::UB,ub);
if(l1<2ULL*(96+320)*576 || a<2ULL*96*96 || b<2ULL*320*96 || c<uint64_t(96)*320*4 || ub<166400)return false;
uint64_t ffts=0;uint32_t length=0;if(rtGetC2cCtrlAddr(&ffts,&length)!=0)throw std::runtime_error("HERL2 FFTS unavailable");
const uint64_t pk=(k+31)/32*32,pn=(n+31)/32*32;
const uint64_t bytes=uint64_t(blocks)*2*96*320*4;
uint8_t *scratch=nullptr;if(aclrtMalloc(reinterpret_cast<void**>(&scratch),bytes,ACL_MEM_MALLOC_HUGE_FIRST)!=ACL_SUCCESS)throw std::runtime_error("HERL2 workspace unavailable");
gmg::Plan p{};p.e=e;p.m=m;p.k=k;p.n=n;p.blocks=blocks;p.backend=1;p.ffts=ffts;
grouped_matmul_gelu_herl1_pipeline<<<blocks,nullptr,stream>>>(x,w,s,g,y,scratch,p);
const auto status=aclrtSynchronizeStream(stream);aclrtFree(scratch);if(status!=ACL_SUCCESS)throw std::runtime_error("HERL2 kernel failed");return true;
}
namespace direct_core {
template<class BlockMmad_, class BlockEpilogue_>
class Herl1Grouped {
public:
using BlockMmad = BlockMmad_;
using L1TileShape = typename BlockMmad::L1TileShape;
using ElementA = int8_t;
using ElementB = int8_t;
using ElementC = int32_t;
using ElementGroupList = int64_t;
using LayoutA = layout::RowMajor;
using LayoutB = layout::RowMajor;
using LayoutC = layout::RowMajor;
using LayoutD = layout::RowMajor;
using LayoutScale = layout::VectorLayout;
using BlockEpilogue = BlockEpilogue_;
using EpilogueParams = typename BlockEpilogue::Params;
using BlockScheduler = RowSwizzle3;
static constexpr uint32_t WORKSPACE_STAGES = 2;
using Params = GroupParams;
using Arguments = GroupArguments;
static size_t GetWorkspaceSize(Arguments const &args) {
const uint32_t n = RoundUp<16>(args.problemShape.n() < L1TileShape::N ? args.problemShape.n() : L1TileShape::N);
return static_cast<size_t>(L1TileShape::M) * n * args.aicCoreNum * 2 * sizeof(uint32_t);
}
DIRECT_DEVICE
Herl1Grouped()
{
Arch::FlagID flagId = 0;
for (uint32_t stageId = 0; stageId < WORKSPACE_STAGES; ++stageId) {
flagAicFinishStoreList[stageId] = Arch::CrossCoreFlag(flagId++);
flagAivFinishComputeList[stageId] = Arch::CrossCoreFlag(flagId++);
}
}
DIRECT_DEVICE void operator()(Params const &params) {
if constexpr (g_coreType == AscendC::AIC) RunCube(params);
else RunVector(params);
}
DIRECT_DEVICE void RunCube(Params const &params)
{
AscendC::ICachePreLoad(1);
BlockScheduler blockScheduler;
BlockMmad blockMmad(resource);
AscendC::GlobalTensor<ElementA> gmA;
gmA.SetGlobalBuffer(params.ptrA);
AscendC::GlobalTensor<ElementGroupList> groupList;
groupList.SetGlobalBuffer(params.ptrGroupList);
uint32_t coreIdx = AscendC::GetBlockIdx();
uint32_t coreNum = AscendC::GetBlockNum();
int64_t gmGroupOffsetA = 0;
int64_t gmGroupOffsetB = 0;
AscendC::GlobalTensor<ElementC> gmC;
gmC.SetGlobalBuffer(reinterpret_cast<__gm__ ElementC *>(params.ptrWorkspace));
const uint32_t workspaceN = RoundUp<16>(params.problemShape.n() < L1TileShape::N ? params.problemShape.n() : L1TileShape::N);
auto layoutC = layout::RowMajor{L1TileShape::M * coreNum * WORKSPACE_STAGES, workspaceN};
uint32_t stageId = 0;
uint32_t stageUsed = 0;
uint32_t startCoreIdx = 0;
for (uint32_t groupIdx = 0; groupIdx < params.problemCount; ++groupIdx) {
uint32_t currentM = (groupIdx == 0) ? groupList.GetValue(groupIdx) :
(groupList.GetValue(groupIdx) - groupList.GetValue(groupIdx - 1));
GemmCoord inGroupProblemShape{currentM, params.problemShape.n(), params.problemShape.k()};
LayoutA layoutA = params.layoutA.GetTileLayout(inGroupProblemShape.GetCoordMK());
LayoutB layoutB = params.layoutB;
blockScheduler.Update(inGroupProblemShape, MakeCoord(L1TileShape::M, L1TileShape::N));
uint32_t coreLoops = blockScheduler.GetCoreLoops();
AscendC::GlobalTensor<ElementB> gmB;
gmB.SetGlobalBuffer(params.ptrB + gmGroupOffsetB);
uint32_t startLoopIdx = ((coreIdx < startCoreIdx) ? (coreIdx + coreNum) : coreIdx) - startCoreIdx;
for (uint32_t loopIdx = startLoopIdx; loopIdx < coreLoops; loopIdx += coreNum) {
GemmCoord blockCoord = blockScheduler.GetBlockCoord(loopIdx);
GemmCoord actualBlockShape = blockScheduler.GetActualBlockShape(blockCoord);
const bool waitBeforeFixpipe = stageUsed == WORKSPACE_STAGES;
if (!waitBeforeFixpipe) ++stageUsed;
MatrixCoord offsetA{blockCoord.m() * L1TileShape::M, blockCoord.k() * L1TileShape::K};
MatrixCoord offsetB{blockCoord.k() * L1TileShape::K, blockCoord.n() * L1TileShape::N};
MatrixCoord offsetC{(stageId * coreNum + coreIdx) * L1TileShape::M, 0};
int64_t gmOffsetA = layoutA.GetOffset(offsetA);
int64_t gmOffsetB = layoutB.GetOffset(offsetB);
int64_t gmOffsetC = layoutC.GetOffset(offsetC);
if (waitBeforeFixpipe) Arch::Wait(flagAivFinishComputeList[stageId]);
blockMmad(
gmA[gmGroupOffsetA + gmOffsetA], layoutA,
gmB[gmOffsetB], layoutB,
gmC[gmOffsetC], layoutC,
actualBlockShape
);
Arch::Signal<PIPE_FIX>(flagAicFinishStoreList[stageId]);
stageId = (stageId + 1 < WORKSPACE_STAGES) ? (stageId + 1) : 0;
}
gmGroupOffsetA += inGroupProblemShape.m() * inGroupProblemShape.k();
gmGroupOffsetB += inGroupProblemShape.k() * inGroupProblemShape.n();
startCoreIdx = (startCoreIdx + coreLoops) % coreNum;
}
while (stageUsed > 0) {
uint32_t aivComputeStageId = (stageId >= stageUsed) ?
(stageId - stageUsed) : (stageId + WORKSPACE_STAGES - stageUsed);
Arch::Wait(flagAivFinishComputeList[aivComputeStageId]);
--stageUsed;
}
AscendC::PipeBarrier<PIPE_ALL>();
}
DIRECT_DEVICE void RunVector(Params const &params)
{
AscendC::ICachePreLoad(1);
BlockScheduler blockScheduler;
BlockEpilogue blockEpilogue(resource);
uint32_t coreIdx = AscendC::GetBlockIdx() / AscendC::GetSubBlockNum();
uint32_t coreNum = AscendC::GetBlockNum();
int64_t gmGroupOffsetScale = 0;
int64_t gmGroupOffsetD = 0;
AscendC::GlobalTensor<ElementGroupList> groupList;
groupList.SetGlobalBuffer(params.ptrGroupList);
AscendC::GlobalTensor<ElementC> gmC;
gmC.SetGlobalBuffer(reinterpret_cast<__gm__ ElementC *>(params.ptrWorkspace));
const uint32_t workspaceN = RoundUp<16>(params.problemShape.n() < L1TileShape::N ? params.problemShape.n() : L1TileShape::N);
auto layoutC = layout::RowMajor{L1TileShape::M * coreNum * WORKSPACE_STAGES, workspaceN};
uint32_t stageId = 0;
uint32_t startCoreIdx = 0;
for (uint32_t groupIdx = 0; groupIdx < params.problemCount; ++groupIdx) {
uint32_t currentM = (groupIdx == 0) ? groupList.GetValue(groupIdx) :
(groupList.GetValue(groupIdx) - groupList.GetValue(groupIdx - 1));
GemmCoord inGroupProblemShape{currentM, params.problemShape.n(), params.problemShape.k()};
LayoutScale layoutScale = params.layoutScale;
LayoutD layoutD = params.layoutD.GetTileLayout(inGroupProblemShape.GetCoordMN());
EpilogueParams epilogueParams{
params.ptrScale + gmGroupOffsetScale, layoutScale,
params.ptrD + gmGroupOffsetD, layoutD
};
blockScheduler.Update(inGroupProblemShape, L1TileShape::ToCoordMN());
blockEpilogue.UpdateParams(epilogueParams);
uint32_t coreLoops = blockScheduler.GetCoreLoops();
GemmCoord blockShapeMNK = L1TileShape::ToCoord();
uint32_t startLoopIdx = ((coreIdx < startCoreIdx) ? (coreIdx + coreNum) : coreIdx) - startCoreIdx;
for (uint32_t loopIdx = startLoopIdx; loopIdx < coreLoops; loopIdx += coreNum) {
GemmCoord blockCoordMNK = blockScheduler.GetBlockCoord(loopIdx);
GemmCoord actualBlockShapeMNK = blockScheduler.GetActualBlockShape(blockCoordMNK);
MatrixCoord offsetC{(stageId * coreNum + coreIdx) * L1TileShape::M, 0};
int64_t gmOffsetC = layoutC.GetOffset(offsetC);
auto gmBlockC = gmC[gmOffsetC];
auto layoutBlockC = layoutC.GetTileLayout(actualBlockShapeMNK.GetCoordMN());
Arch::Wait(flagAicFinishStoreList[stageId]);
blockEpilogue(blockShapeMNK, blockCoordMNK, actualBlockShapeMNK, gmBlockC, layoutBlockC);
Arch::Signal<PIPE_MTE3>(flagAivFinishComputeList[stageId]);
stageId = (stageId + 1 < WORKSPACE_STAGES) ? (stageId + 1) : 0;
}
gmGroupOffsetScale += inGroupProblemShape.n();
gmGroupOffsetD += inGroupProblemShape.m() * inGroupProblemShape.n();
startCoreIdx = (startCoreIdx + coreLoops) % coreNum;
}
AscendC::PipeBarrier<PIPE_ALL>();
}
private:
Arch::CrossCoreFlag flagAicFinishStoreList[WORKSPACE_STAGES];
Arch::CrossCoreFlag flagAivFinishComputeList[WORKSPACE_STAGES];
Arch::Resource resource;
};
}
namespace public_gmg {
class Herl1WideEpilogue {
public:
using ElementScale=float; using LayoutScale=layout::VectorLayout;
using ElementD=half; using LayoutD=layout::RowMajor;
using Params=DescriptorBankStableEpilogue::Params;
__aicore__ __forceinline__ Herl1WideEpilogue(Arch::Resource &resource) {
Buffer *buffers[]={&zb,&qb,&sb,&yb};
const uint32_t offsets[]={0,65792,131328,133632};
for(uint32_t i=0;i<4;++i)buffers[i]->tensor=resource.ubBuf.GetBufferByByte<uint8_t>(offsets[i]);
}
__aicore__ __forceinline__ void UpdateParams(Params const&p) {
plan.n=p.yl.stride(0);scale.SetGlobalBuffer(p.sp);y.SetGlobalBuffer(p.yp);
}
__aicore__ __forceinline__ void operator()(GemmCoord const&shape,GemmCoord const&coord,
GemmCoord const&actual,GlobalTensor<int32_t> const&src,layout::RowMajor const&srcLayout) {
const uint32_t perSub=(actual.m()+1)/2,first=GetSubBlockIdx()*perSub;
const uint32_t end=first+perSub<actual.m()?first+perSub:actual.m();
if(first>=end)return;
accumStride=srcLayout.stride(0);accum=src[uint64_t(first)*accumStride];
Compute64(coord.m()*shape.m()+first,coord.n()*shape.n(),end-first,actual.n());
}
private:
__aicore__ __forceinline__ void Compute64(uint32_t row,uint32_t col,uint32_t vm,uint32_t vn) {
const uint32_t e=0, stride=(vn+7)/8*8, len=vm*stride;
auto ci = qb.Get<int32_t>();
auto z = zb.Get<float>();
auto q = qb.Get<float>();
auto s = sb.Get<float>();
auto out = yb.Get<half>();
DataCopyPad(ci, accum,
DataCopyExtParams{static_cast<uint16_t>(vm), vn * 4, (accumStride - vn) * 4, 0, 0},
DataCopyPadExtParams<int32_t>{true, 0, static_cast<uint8_t>(stride - vn), 0});
DataCopyPad(s, scale[uint64_t(e) * plan.n + col],
DataCopyExtParams{1, vn * 4, 0, 0, 0},
DataCopyPadExtParams<float>{true, 0, static_cast<uint8_t>(stride - vn), 0.0f});
SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
Cast(z, ci, RoundMode::CAST_RINT, len);
BinaryRepeatParams br;
br.dstBlkStride = 1; br.src0BlkStride = 1; br.src1BlkStride = 1;
br.dstRepStride = stride / 8; br.src0RepStride = stride / 8; br.src1RepStride = 0;
for (uint32_t col = 0; col < stride; col += 64) {
const uint64_t mask = stride - col < 64 ? stride - col : 64;
Mul(z[col], z[col], s[col], mask, static_cast<uint8_t>(vm), br);
}
Mul(q, z, z, len);
Muls(q, q, 0.044715f, len);
Adds(q, q, 1.0f, len);
Mul(q, q, z, len);
Muls(q, q, -1.5957691216057308f, len);
Mins(q, q, 87.0f, len);
Exp(q, q, len);
Adds(q, q, 1.0f, len);
Div(q, z, q, len);
const bool packed=stride%16==0;const uint32_t outPitch=(vn+15)/16*16;
if(packed)Cast(out,q,RoundMode::CAST_RINT,len);
else {
UnaryRepeatParams cr;cr.dstBlkStride=1;cr.srcBlkStride=1;cr.dstRepStride=outPitch/16;cr.srcRepStride=stride/8;
for(uint32_t cc=0;cc<stride;cc+=64){
uint64_t mask=stride-cc<64?stride-cc:64;
Cast(out[cc],q[cc],RoundMode::CAST_RINT,mask,static_cast<uint8_t>(vm),cr);
}
}
SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
DataCopyPad(y[uint64_t(row)*plan.n+col],out,
DataCopyExtParams{static_cast<uint16_t>(vm),vn*2,
((packed?stride:outPitch)-(vn+15)/16*16)/16,(plan.n-vn)*2,0});
PipeBarrier<PIPE_ALL>();
}
uint32_t accumStride;struct{uint32_t n;}plan;
GlobalTensor<float>scale;GlobalTensor<half>y;GlobalTensor<int32_t>accum;
Buffer zb,qb,sb,yb;
};
class Herl2EarlyAckEpilogue {
public:
using ElementScale=float; using LayoutScale=layout::VectorLayout;
using ElementD=half; using LayoutD=layout::RowMajor;
using Params=DescriptorBankStableEpilogue::Params;
__aicore__ __forceinline__ Herl2EarlyAckEpilogue(Arch::Resource &resource) {
Buffer *buffers[]={&zb,&qb,&sb,&yb};
const uint32_t offsets[]={0,65792,131328,133632};
for(uint32_t i=0;i<4;++i)buffers[i]->tensor=resource.ubBuf.GetBufferByByte<uint8_t>(offsets[i]);
}
__aicore__ __forceinline__ void UpdateParams(Params const&p) {
plan.n=p.yl.stride(0);scale.SetGlobalBuffer(p.sp);y.SetGlobalBuffer(p.yp);
}
__aicore__ __forceinline__ void operator()(GemmCoord const&shape,GemmCoord const&coord,
GemmCoord const&actual,GlobalTensor<int32_t> const&src,layout::RowMajor const&srcLayout,Arch::CrossCoreFlag &ack) {
const uint32_t perSub=(actual.m()+1)/2,first=GetSubBlockIdx()*perSub;
const uint32_t end=first+perSub<actual.m()?first+perSub:actual.m();
if(first>=end){Arch::Signal<PIPE_MTE2>(ack);return;}
accumStride=srcLayout.stride(0);accum=src[uint64_t(first)*accumStride];
Compute64(coord.m()*shape.m()+first,coord.n()*shape.n(),end-first,actual.n(),ack);
}
private:
__aicore__ __forceinline__ void Compute64(uint32_t row,uint32_t col,uint32_t vm,uint32_t vn,Arch::CrossCoreFlag &ack) {
const uint32_t e=0, stride=(vn+7)/8*8, len=vm*stride;
auto ci = qb.Get<int32_t>();
auto z = zb.Get<float>();
auto q = qb.Get<float>();
auto s = sb.Get<float>();
auto out = yb.Get<half>();
DataCopyPad(ci, accum,
DataCopyExtParams{static_cast<uint16_t>(vm), vn * 4, (accumStride - vn) * 4, 0, 0},
DataCopyPadExtParams<int32_t>{true, 0, static_cast<uint8_t>(stride - vn), 0});
DataCopyPad(s, scale[uint64_t(e) * plan.n + col],
DataCopyExtParams{1, vn * 4, 0, 0, 0},
DataCopyPadExtParams<float>{true, 0, static_cast<uint8_t>(stride - vn), 0.0f});
SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
Arch::Signal<PIPE_MTE2>(ack);
Cast(z, ci, RoundMode::CAST_RINT, len);
BinaryRepeatParams br;
br.dstBlkStride = 1; br.src0BlkStride = 1; br.src1BlkStride = 1;
br.dstRepStride = stride / 8; br.src0RepStride = stride / 8; br.src1RepStride = 0;
for (uint32_t col = 0; col < stride; col += 64) {
const uint64_t mask = stride - col < 64 ? stride - col : 64;
Mul(z[col], z[col], s[col], mask, static_cast<uint8_t>(vm), br);
}
Mul(q, z, z, len);
Muls(q, q, 0.044715f, len);
Adds(q, q, 1.0f, len);
Mul(q, q, z, len);
Muls(q, q, -1.5957691216057308f, len);
Mins(q, q, 87.0f, len);
Exp(q, q, len);
Adds(q, q, 1.0f, len);
Div(q, z, q, len);
const bool packed=stride%16==0;const uint32_t outPitch=(vn+15)/16*16;
if(packed)Cast(out,q,RoundMode::CAST_RINT,len);
else {
UnaryRepeatParams cr;cr.dstBlkStride=1;cr.srcBlkStride=1;cr.dstRepStride=outPitch/16;cr.srcRepStride=stride/8;
for(uint32_t cc=0;cc<stride;cc+=64){
uint64_t mask=stride-cc<64?stride-cc:64;
Cast(out[cc],q[cc],RoundMode::CAST_RINT,mask,static_cast<uint8_t>(vm),cr);
}
}
SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
DataCopyPad(y[uint64_t(row)*plan.n+col],out,
DataCopyExtParams{static_cast<uint16_t>(vm),vn*2,
((packed?stride:outPitch)-(vn+15)/16*16)/16,(plan.n-vn)*2,0});
PipeBarrier<PIPE_ALL>();
}
uint32_t accumStride;struct{uint32_t n;}plan;
GlobalTensor<float>scale;GlobalTensor<half>y;GlobalTensor<int32_t>accum;
Buffer zb,qb,sb,yb;
};
}
namespace herl1_k32 {
using namespace direct_core;
template<uint32_t N>struct Panel{
template<class T>DIRECT_DEVICE static Panel MakeLayout(uint32_t,uint32_t){return {};}
DIRECT_DEVICE int64_t GetOffset(MatrixCoord const&p)const{return int64_t(p.row()/32)*32*N+int64_t(p.column()/32)*1024+(p.row()%32)*32+p.column()%32;}
};
template<uint32_t N>struct GmToL1{
using LayoutDst=Panel<N>;using LayoutSrc=layout::RowMajor;
DIRECT_DEVICE void operator()(AscendC::LocalTensor<int8_t>const&dst,AscendC::GlobalTensor<int8_t>const&src,LayoutDst const&,LayoutSrc const&ls){
AscendC::Nd2NzParams p{};p.nValue=32;p.dValue=ls.cols;p.srcDValue=ls.pitch;
p.srcNdMatrixStride=32*ls.pitch;p.dstNzC0Stride=32;p.dstNzNStride=1;p.dstNzMatrixStride=32*N;
const uint32_t full=ls.rows/32,tail=ls.rows%32;
if(full){p.ndNum=full;AscendC::DataCopy(dst,src,p);}
if(tail){p.ndNum=1;p.nValue=tail;p.srcNdMatrixStride=0;p.dstNzMatrixStride=0;AscendC::DataCopy(dst[full*32*N],src[int64_t(full)*32*ls.pitch],p);}
}
};
template<uint32_t N>struct L1ToL0{
using LayoutSrc=Panel<N>;using LayoutDst=layout::L0BTile;
DIRECT_DEVICE void operator()(AscendC::LocalTensor<int8_t>const&dst,AscendC::LocalTensor<int8_t>const&src,LayoutDst const&ld,LayoutSrc const&){
AscendC::LoadData2dTransposeParams p{};p.srcStride=1;p.dstGap=1;p.dstFracGap=0;p.addrMode=0;
if(ld.cols==N){p.repeatTimes=CeilDiv<32>(ld.rows)*(N/32);AscendC::LoadDataWithTranspose(dst,src,p);}
else{p.repeatTimes=CeilDiv<32>(ld.cols);for(uint32_t i=0;i<CeilDiv<32>(ld.rows);++i)AscendC::LoadDataWithTranspose(dst[i*ld.rowBlockPitch],src[i*32*N],p);}
}
};
}
namespace direct_core {
using Herl1AsymParent=direct_core::DirectInt8Block<direct_core::GemmShape<96,320,576>,direct_core::GemmShape<96,320,96>>;
struct Herl1SplitBase : public Herl1AsymParent {
using Herl1AsymParent::Herl1AsymParent;
__aicore__ inline void operator()(
AscendC::GlobalTensor<ElementA> const &gmA,LayoutA const &layoutA,
AscendC::GlobalTensor<ElementB> const &gmB,LayoutB const &layoutB,
AscendC::GlobalTensor<ElementC> const &gmC,LayoutC const &layoutC,
direct_core::GemmCoord const &actualShape){
using namespace direct_core;
const uint32_t mr=RoundUp<16>(actualShape.m());
const uint32_t nr=RoundUp<32>(actualShape.n());
const uint32_t parts=CeilDiv<96>(actualShape.k());
auto aL1=LayoutAInL1::template MakeLayout<ElementA>(96,576);
auto bL1=LayoutBInL1::template MakeLayout<ElementB>(96,320);
auto cL0=LayoutCInL0::MakeLayoutInL0C(MakeCoord(mr,nr));
AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(l1AEventList[0]);
copyGmToL1A(l1ATensorList[0],gmA,aL1,layoutA.GetTileLayout(MakeCoord(actualShape.m(),min(actualShape.k(),576U))));
AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(l1AEventList[0]);
AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(l1BEventList[0]);
copyGmToL1B(l1BTensorList[0],gmB,bL1,layoutB.GetTileLayout(MakeCoord(min(actualShape.k(),96U),actualShape.n())));
AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(l1BEventList[0]);
AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(EVENT_ID0);
for(uint32_t j=0;j<parts;++j){
const uint32_t slab=j/6,as=slab&1,bs=j&1;
if(j+1<parts){
const uint32_t next=bs^1,begin=(j+1)*96,count=min(actualShape.k()-begin,96U);
AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(l1BEventList[next]);
auto gb=gmB[layoutB.GetOffset(MatrixCoord{begin,uint32_t(0)})];
copyGmToL1B(l1BTensorList[next],gb,bL1,layoutB.GetTileLayout(MakeCoord(count,actualShape.n())));
AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(l1BEventList[next]);
}
if((j%6)==4 && uint64_t(slab+1)*576<actualShape.k()){
const uint32_t next=as^1,begin=(slab+1)*576,count=min(actualShape.k()-begin,576U);
AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(l1AEventList[next]);
auto ga=gmA[layoutA.GetOffset(MatrixCoord{uint32_t(0),begin})];
copyGmToL1A(l1ATensorList[next],ga,aL1,layoutA.GetTileLayout(MakeCoord(actualShape.m(),count)));
AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(l1AEventList[next]);
}
const uint32_t ka=min(actualShape.k()-j*96,96U);
auto aL0=LayoutAInL0::template MakeLayout<ElementA>(mr,ka);
auto bL0=LayoutBInL0::template MakeLayout<ElementB>(ka,nr);
auto a=l0ATensorList[l0AListId],b=l0BTensorList[l0BListId];
AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(l0AEventList[l0AListId]);
if((j%6)==0)AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(l1AEventList[as]);
auto aPart=l1ATensorList[as][aL1.GetOffset(MatrixCoord{uint32_t(0),(j%6)*96})];
copyL1ToL0A(a,aPart,aL0,aL1);
if((j%6)==5 || j+1==parts)AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(l1AEventList[as]);
AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(l0BEventList[l0BListId]);
AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(l1BEventList[bs]);
copyL1ToL0B(b,l1BTensorList[bs],bL0,bL1);
AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(l1BEventList[bs]);
AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID0);
AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID0);
tileMmad(l0CTensor,a,b,mr,nr,ka,j==0,0);
AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(l0AEventList[l0AListId]);
AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(l0BEventList[l0BListId]);
l0AListId^=1;l0BListId^=1;
}
auto cBlock=layoutC.GetTileLayout(actualShape.GetCoordMN());
AscendC::SetFlag<AscendC::HardEvent::M_FIX>(EVENT_ID0);
AscendC::WaitFlag<AscendC::HardEvent::M_FIX>(EVENT_ID0);
copyL0CToGm(gmC,l0CTensor,cBlock,cL0);
AscendC::SetFlag<AscendC::HardEvent::FIX_M>(EVENT_ID0);
}
};
struct Herl1AsymBlock : public Herl1SplitBase {
using Herl1SplitBase::Herl1SplitBase;
__aicore__ inline void operator()(
AscendC::GlobalTensor<ElementA> const &gmA,LayoutA const &layoutA,
AscendC::GlobalTensor<ElementB> const &gmB,LayoutB const &layoutB,
AscendC::GlobalTensor<ElementC> const &gmC,LayoutC const &layoutC,
direct_core::GemmCoord const &actualShape){
const uint64_t aBytes=uint64_t(RoundUp<16>(actualShape.m()))*RoundUp<32>(actualShape.k());
if(actualShape.m()<=96 && aBytes<=2ULL*96*576)RunResident(gmA,layoutA,gmB,layoutB,gmC,layoutC,actualShape);
else Herl1SplitBase::operator()(gmA,layoutA,gmB,layoutB,gmC,layoutC,actualShape);
}
__aicore__ inline void RunResident(
AscendC::GlobalTensor<ElementA> const &gmA,LayoutA const &layoutA,
AscendC::GlobalTensor<ElementB> const &gmB,LayoutB const &layoutB,
AscendC::GlobalTensor<ElementC> const &gmC,LayoutC const &layoutC,
direct_core::GemmCoord const &actualShape){
using namespace direct_core;
const uint32_t mr=RoundUp<16>(actualShape.m());
const uint32_t nr=RoundUp<32>(actualShape.n());
const uint32_t parts=CeilDiv<96>(actualShape.k());
auto aL1=LayoutAInL1::template MakeLayout<ElementA>(mr,RoundUp<32>(actualShape.k()));
auto bL1=LayoutBInL1::template MakeLayout<ElementB>(96,320);
auto cL0=LayoutCInL0::MakeLayoutInL0C(MakeCoord(mr,nr));
AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(l1AEventList[0]);
AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(l1AEventList[1]);
copyGmToL1A(l1ATensorList[0],gmA,aL1,layoutA.GetTileLayout(MakeCoord(actualShape.m(),actualShape.k())));
AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(l1AEventList[0]);
AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(l1BEventList[0]);
copyGmToL1B(l1BTensorList[0],gmB,bL1,layoutB.GetTileLayout(MakeCoord(min(actualShape.k(),96U),actualShape.n())));
AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(l1BEventList[0]);
AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(EVENT_ID0);
for(uint32_t j=0;j<parts;++j){
const uint32_t bs=j&1;
if(j+1<parts){
const uint32_t next=bs^1,begin=(j+1)*96,count=min(actualShape.k()-begin,96U);
AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(l1BEventList[next]);
auto gb=gmB[layoutB.GetOffset(MatrixCoord{begin,uint32_t(0)})];
copyGmToL1B(l1BTensorList[next],gb,bL1,layoutB.GetTileLayout(MakeCoord(count,actualShape.n())));
AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(l1BEventList[next]);
}
const uint32_t ka=min(actualShape.k()-j*96,96U);
auto aL0=LayoutAInL0::template MakeLayout<ElementA>(mr,ka);
auto bL0=LayoutBInL0::template MakeLayout<ElementB>(ka,nr);
auto a=l0ATensorList[l0AListId],b=l0BTensorList[l0BListId];
AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(l0AEventList[l0AListId]);
if(j==0)AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(l1AEventList[0]);
auto aPart=l1ATensorList[0][aL1.GetOffset(MatrixCoord{uint32_t(0),j*96})];
copyL1ToL0A(a,aPart,aL0,aL1);
if(j+1==parts){
AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(l1AEventList[0]);
AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(l1AEventList[1]);
}
AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(l0BEventList[l0BListId]);
AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(l1BEventList[bs]);
copyL1ToL0B(b,l1BTensorList[bs],bL0,bL1);
AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(l1BEventList[bs]);
AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID0);
AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID0);
tileMmad(l0CTensor,a,b,mr,nr,ka,j==0,0);
AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(l0AEventList[l0AListId]);
AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(l0BEventList[l0BListId]);
l0AListId^=1;l0BListId^=1;
}
auto cBlock=layoutC.GetTileLayout(actualShape.GetCoordMN());
AscendC::SetFlag<AscendC::HardEvent::M_FIX>(EVENT_ID0);
AscendC::WaitFlag<AscendC::HardEvent::M_FIX>(EVENT_ID0);
copyL0CToGm(gmC,l0CTensor,cBlock,cL0);
AscendC::SetFlag<AscendC::HardEvent::FIX_M>(EVENT_ID0);
}
};}
namespace herl1_wide {
using Tile=direct_core::GemmShape<96,320,576>;using L0=direct_core::GemmShape<96,320,96>;
using Mmad=direct_core::Herl1AsymBlock;
using Kernel=direct_core::Herl1Grouped<Mmad,public_gmg::Herl1WideEpilogue>;
}
extern "C" __global__ __aicore__ __attribute__((section(".herl1_pipeline")))
void grouped_matmul_gelu_herl1_pipeline(GM_ADDR x,GM_ADDR w,GM_ADDR s,GM_ADDR g,GM_ADDR y,GM_ADDR scratch,gmg::Plan p){
KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);AscendC::SetSyncBaseAddr(p.ffts);
herl1_wide::Kernel::Params params{direct_core::GemmCoord{p.m,p.n,p.k},p.e,g,
x,direct_core::layout::RowMajor{p.m,p.k},w,direct_core::layout::RowMajor{p.k,p.n},
s,direct_core::layout::VectorLayout{p.n},y,direct_core::layout::RowMajor{p.m,p.n},scratch};
herl1_wide::Kernel op;op(params);
}
namespace direct_core {
template<class BlockMmad_,class BlockEpilogue_>
class Herl2IteratorGrouped {
public:
using BlockMmad=BlockMmad_;using BlockEpilogue=BlockEpilogue_;
using L1TileShape=typename BlockMmad::L1TileShape;using Params=GroupParams;
using Arguments=GroupArguments;using EpilogueParams=typename BlockEpilogue::Params;
static constexpr uint32_t WORKSPACE_STAGES=2;
static size_t GetWorkspaceSize(Arguments const&a){return uint64_t(a.aicCoreNum)*2*30720*4;}
struct Job {uint32_t expert,rowBase,tileM,tileN;GemmCoord coord,actual;};
class Iterator {
public:
DIRECT_DEVICE Iterator(Params const&p,uint32_t core,uint32_t count):p(p),nextTask(core),cores(count){groups.SetGlobalBuffer(p.ptrGroupList);}
DIRECT_DEVICE bool Next(Job &job){
while(group<p.problemCount){
if(!loaded){end=groups.GetValue(group);rows=end-rowBase;tm=(rows>=193||(rows>=97&&rows<=128))?128:96;tn=tm==128?224:320;ml=CeilDiv(rows,tm);nl=CeilDiv(p.problemShape.n(),tn);tiles=ml*nl;loaded=true;}
if(nextTask>=begin+tiles){begin+=tiles;rowBase=end;++group;loaded=false;continue;}
uint32_t task=nextTask-begin;GemmCoord c;
if(nl==3)c={task/3,task%3,0};
else if(nl==2)c={task/2,task%2,0};
else c={task/nl,task%nl,0};
job.expert=group;job.rowBase=rowBase;job.tileM=tm;job.tileN=tn;job.coord=c;
job.actual=GemmCoord{min(rows-c.m()*tm,tm),min(p.problemShape.n()-c.n()*tn,tn),p.problemShape.k()};
nextTask+=cores;return true;
}
return false;
}
private:
Params const&p;AscendC::GlobalTensor<int64_t> groups;
uint32_t nextTask,cores,group=0,rowBase=0,end=0,rows=0,ml=0,nl=0,tiles=0,begin=0,tm=96,tn=320;bool loaded=false;
};
DIRECT_DEVICE Herl2IteratorGrouped(){for(uint32_t i=0;i<2;++i){ready[i]=Arch::CrossCoreFlag(2*i);ack[i]=Arch::CrossCoreFlag(2*i+1);}}
DIRECT_DEVICE void operator()(Params const&p){if constexpr(g_coreType==AscendC::AIC)Cube(p);else Vector(p);}
DIRECT_DEVICE void Cube(Params const&p){
AscendC::ICachePreLoad(1);BlockMmad mma(resource);uint32_t core=AscendC::GetBlockIdx(),cores=AscendC::GetBlockNum();
Iterator jobs(p,core,cores);Job job;uint32_t stage=0,used=0;
AscendC::GlobalTensor<int8_t> a,b;AscendC::GlobalTensor<int32_t> c;
a.SetGlobalBuffer(p.ptrA);b.SetGlobalBuffer(p.ptrB);c.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(p.ptrWorkspace));
while(jobs.Next(job)){
if(used==2)Arch::Wait(ack[stage]);else ++used;
mma(a[uint64_t(job.rowBase+job.coord.m()*job.tileM)*p.problemShape.k()],p.layoutA,
b[uint64_t(job.expert)*p.problemShape.k()*p.problemShape.n()+job.coord.n()*job.tileN],p.layoutB,
c[uint64_t(stage*cores+core)*30720],layout::RowMajor{job.tileM,job.tileN},job.actual);
Arch::Signal<PIPE_FIX>(ready[stage]);stage^=1;
}
while(used){uint32_t i=stage>=used?stage-used:stage+2-used;Arch::Wait(ack[i]);--used;}
AscendC::PipeBarrier<PIPE_ALL>();
}
DIRECT_DEVICE void Vector(Params const&p){
AscendC::ICachePreLoad(1);BlockEpilogue ep(resource);
uint32_t core=AscendC::GetBlockIdx()/AscendC::GetSubBlockNum(),cores=AscendC::GetBlockNum(),stage=0;
Iterator jobs(p,core,cores);Job job;AscendC::GlobalTensor<int32_t> c;
c.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(p.ptrWorkspace));
while(jobs.Next(job)){
EpilogueParams e{p.ptrScale+uint64_t(job.expert)*p.problemShape.n(),p.layoutScale,p.ptrD+uint64_t(job.rowBase)*p.problemShape.n(),p.layoutD};ep.UpdateParams(e);
auto src=c[uint64_t(stage*cores+core)*30720];auto block=layout::RowMajor{job.tileM,job.tileN}.GetTileLayout(job.actual.GetCoordMN());
Arch::Wait(ready[stage]);ep(GemmCoord{job.tileM,job.tileN,L1TileShape::K},job.coord,job.actual,src,block);Arch::Signal<PIPE_MTE3>(ack[stage]);stage^=1;
}
AscendC::PipeBarrier<PIPE_ALL>();
}
private:Arch::CrossCoreFlag ready[2],ack[2];Arch::Resource resource;
};
template<class BlockMmad_,class BlockEpilogue_>
class Herl2EarlyAckGrouped {
public:
using BlockMmad=BlockMmad_;using BlockEpilogue=BlockEpilogue_;
using L1TileShape=typename BlockMmad::L1TileShape;using Params=GroupParams;
using Arguments=GroupArguments;using EpilogueParams=typename BlockEpilogue::Params;
static constexpr uint32_t WORKSPACE_STAGES=2;
static size_t GetWorkspaceSize(Arguments const&a){return uint64_t(a.aicCoreNum)*2*30720*4;}
struct Job {uint32_t expert,rowBase,tileM,tileN;bool reuseB,firstB,lastB;GemmCoord coord,actual;};
class Iterator {
public:
DIRECT_DEVICE Iterator(Params const&p,uint32_t core,uint32_t count):p(p),nextTask(core),cores(count){groups.SetGlobalBuffer(p.ptrGroupList);}
DIRECT_DEVICE bool Next(Job &job){
while(group<p.problemCount){
if(!loaded){end=groups.GetValue(group);rows=end-rowBase;tm=(rows>=193||(rows>=97&&rows<=128))?128:96;tn=tm==128?224:320;ml=CeilDiv(rows,tm);nl=CeilDiv(p.problemShape.n(),tn);paired=rows>128 && rows<=256 && 167936ULL+uint64_t(RoundUp<32>(p.problemShape.k()))*320<=524288;tiles=paired?nl:ml*nl;loaded=true;}
if(nextTask>=begin+tiles){begin+=tiles;rowBase=end;++group;loaded=false;continue;}
uint32_t task=nextTask-begin;GemmCoord c;
if(paired)c={pairRow,task,0};
else if(nl==3)c={task/3,task%3,0};
else if(nl==2)c={task/2,task%2,0};
else c={task/nl,task%nl,0};
job.reuseB=paired;job.firstB=c.m()==0;job.lastB=c.m()+1==ml;
job.expert=group;job.rowBase=rowBase;job.tileM=tm;job.tileN=tn;job.coord=c;
job.actual=GemmCoord{min(rows-c.m()*tm,tm),min(p.problemShape.n()-c.n()*tn,tn),p.problemShape.k()};
if(paired && pairRow+1<ml)++pairRow;else{pairRow=0;nextTask+=cores;}return true;
}
return false;
}
private:
Params const&p;AscendC::GlobalTensor<int64_t> groups;
uint32_t nextTask,cores,group=0,rowBase=0,end=0,rows=0,ml=0,nl=0,tiles=0,begin=0,tm=96,tn=320,pairRow=0;bool loaded=false,paired=false;
};
DIRECT_DEVICE Herl2EarlyAckGrouped(){for(uint32_t i=0;i<2;++i){ready[i]=Arch::CrossCoreFlag(2*i);ack[i]=Arch::CrossCoreFlag(2*i+1);}}
DIRECT_DEVICE void operator()(Params const&p){if constexpr(g_coreType==AscendC::AIC)Cube(p);else Vector(p);}
DIRECT_DEVICE void Cube(Params const&p){
AscendC::ICachePreLoad(1);BlockMmad mma(resource);uint32_t core=AscendC::GetBlockIdx(),cores=AscendC::GetBlockNum();
Iterator jobs(p,core,cores);Job job;uint32_t stage=0,used=0;
AscendC::GlobalTensor<int8_t> a,b;AscendC::GlobalTensor<int32_t> c;
a.SetGlobalBuffer(p.ptrA);b.SetGlobalBuffer(p.ptrB);c.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(p.ptrWorkspace));
while(jobs.Next(job)){
if(used==2)Arch::Wait(ack[stage]);else ++used;
mma.reuseB=job.reuseB;mma.firstB=job.firstB;mma.lastB=job.lastB;
mma(a[uint64_t(job.rowBase+job.coord.m()*job.tileM)*p.problemShape.k()],p.layoutA,
b[uint64_t(job.expert)*p.problemShape.k()*p.problemShape.n()+job.coord.n()*job.tileN],p.layoutB,
c[uint64_t(stage*cores+core)*30720],layout::RowMajor{job.tileM,job.tileN},job.actual);
Arch::Signal<PIPE_FIX>(ready[stage]);stage^=1;
}
while(used){uint32_t i=stage>=used?stage-used:stage+2-used;Arch::Wait(ack[i]);--used;}
AscendC::PipeBarrier<PIPE_ALL>();
}
DIRECT_DEVICE void Vector(Params const&p){
AscendC::ICachePreLoad(1);BlockEpilogue ep(resource);
uint32_t core=AscendC::GetBlockIdx()/AscendC::GetSubBlockNum(),cores=AscendC::GetBlockNum(),stage=0;
Iterator jobs(p,core,cores);Job job;AscendC::GlobalTensor<int32_t> c;
c.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(p.ptrWorkspace));
while(jobs.Next(job)){
EpilogueParams e{p.ptrScale+uint64_t(job.expert)*p.problemShape.n(),p.layoutScale,p.ptrD+uint64_t(job.rowBase)*p.problemShape.n(),p.layoutD};ep.UpdateParams(e);
auto src=c[uint64_t(stage*cores+core)*30720];auto block=layout::RowMajor{job.tileM,job.tileN}.GetTileLayout(job.actual.GetCoordMN());
Arch::Wait(ready[stage]);ep(GemmCoord{job.tileM,job.tileN,L1TileShape::K},job.coord,job.actual,src,block,ack[stage]);stage^=1;
}
AscendC::PipeBarrier<PIPE_ALL>();
}
private:Arch::CrossCoreFlag ready[2],ack[2];Arch::Resource resource;
};
}
namespace direct_core {
struct Herl2FullA96 : public Herl1AsymParent {
using Parent=Herl1AsymParent;
using L1TileShape=GemmShape<128,320,576>;
bool reuseB=false,firstB=false,lastB=false;
__aicore__ inline void ReuseB(
AscendC::GlobalTensor<ElementA> const &gmA,LayoutA const &layoutA,
AscendC::GlobalTensor<ElementB> const &gmB,LayoutB const &layoutB,
AscendC::GlobalTensor<ElementC> const &gmC,LayoutC const &layoutC,
direct_core::GemmCoord const &s){
const uint32_t mr=RoundUp<16>(s.m()),nr=RoundUp<32>(s.n()),pk=RoundUp<32>(s.k());
const uint32_t kk=nr<=224?128:96,parts=CeilDiv(s.k(),kk);
auto la=LayoutAInL1::template MakeLayout<ElementA>((mr/16)%2?mr:mr+16,pk);
auto lb=LayoutBInL1::template MakeLayout<ElementB>(pk,nr);
auto lc=LayoutCInL0::MakeLayoutInL0C(MakeCoord(mr,nr));
for(uint32_t i=0;i<2;++i)AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(l1AEventList[i]);
copyGmToL1A(l1ATensorList[0],gmA,la,layoutA.GetTileLayout(MakeCoord(s.m(),s.k())));
AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(l1AEventList[0]);
if(firstB){
for(uint32_t i=0;i<2;++i)AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(l1BEventList[i]);
copyGmToL1B(l1BTensorList[0],gmB,lb,layoutB.GetTileLayout(MakeCoord(s.k(),s.n())));
AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(l1BEventList[0]);
}
AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(EVENT_ID0);
for(uint32_t j=0;j<parts;++j){
const uint32_t ka=min(s.k()-j*kk,kk);
auto a0=LayoutAInL0::template MakeLayout<ElementA>(mr,ka);
auto b0=LayoutBInL0::template MakeLayout<ElementB>(ka,nr);
auto a=l0ATensorList[l0AListId],b=l0BTensorList[l0BListId];
AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(l0AEventList[l0AListId]);
if(j==0)AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(l1AEventList[0]);
copyL1ToL0A(a,l1ATensorList[0][la.GetOffset(MatrixCoord{0,j*kk})],a0,la);
if(j+1==parts){for(uint32_t i=0;i<2;++i)AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(l1AEventList[i]);}
AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(l0BEventList[l0BListId]);
if(j==0 && firstB)AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(l1BEventList[0]);
copyL1ToL0B(b,l1BTensorList[0][lb.GetOffset(MatrixCoord{j*kk,0})],b0,lb);
if(j+1==parts && lastB){for(uint32_t i=0;i<2;++i)AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(l1BEventList[i]);}
AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID0);
AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID0);
tileMmad(l0CTensor,a,b,mr,nr,ka,j==0,0);
AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(l0AEventList[l0AListId]);
AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(l0BEventList[l0BListId]);
l0AListId^=1;l0BListId^=1;
}
AscendC::SetFlag<AscendC::HardEvent::M_FIX>(EVENT_ID0);
AscendC::WaitFlag<AscendC::HardEvent::M_FIX>(EVENT_ID0);
copyL0CToGm(gmC,l0CTensor,layoutC.GetTileLayout(s.GetCoordMN()),lc);
AscendC::SetFlag<AscendC::HardEvent::FIX_M>(EVENT_ID0);
}

__aicore__ inline Herl2FullA96(Arch::Resource&r):Parent(r){
l0BTensorList[1]=r.l0BBuf.GetBufferByByte<int8_t>(30720);
l1ATensorList[0]=r.l1Buf.GetBufferByByte<int8_t>(0);
l1BTensorList[0]=r.l1Buf.GetBufferByByte<int8_t>(167936);
l1BTensorList[1]=r.l1Buf.GetBufferByByte<int8_t>(167936+30720);
}
__aicore__ inline void operator()(
AscendC::GlobalTensor<ElementA> const &gmA,LayoutA const &layoutA,
AscendC::GlobalTensor<ElementB> const &gmB,LayoutB const &layoutB,
AscendC::GlobalTensor<ElementC> const &gmC,LayoutC const &layoutC,
direct_core::GemmCoord const &actualShape){
using namespace direct_core;
if(reuseB){ReuseB(gmA,layoutA,gmB,layoutB,gmC,layoutC,actualShape);return;}
const uint32_t mr=RoundUp<16>(actualShape.m());
const uint32_t nr=RoundUp<32>(actualShape.n());
const uint32_t kk=nr<=224?128:96;
const uint32_t parts=CeilDiv(actualShape.k(),kk);
auto aL1=LayoutAInL1::template MakeLayout<ElementA>((mr/16)%2?mr:mr+16,RoundUp<32>(actualShape.k()));
auto bL1=LayoutBInL1::template MakeLayout<ElementB>(kk,nr);
auto cL0=LayoutCInL0::MakeLayoutInL0C(MakeCoord(mr,nr));
AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(l1AEventList[0]);
AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(l1AEventList[1]);
copyGmToL1A(l1ATensorList[0],gmA,aL1,layoutA.GetTileLayout(MakeCoord(actualShape.m(),actualShape.k())));
AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(l1AEventList[0]);
AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(l1BEventList[0]);
copyGmToL1B(l1BTensorList[0],gmB,bL1,layoutB.GetTileLayout(MakeCoord(min(actualShape.k(),kk),actualShape.n())));
AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(l1BEventList[0]);
AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(EVENT_ID0);
for(uint32_t j=0;j<parts;++j){
const uint32_t bs=j&1;
if(j+1<parts){
const uint32_t next=bs^1,begin=(j+1)*kk,count=min(actualShape.k()-begin,kk);
AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(l1BEventList[next]);
auto gb=gmB[layoutB.GetOffset(MatrixCoord{begin,uint32_t(0)})];
copyGmToL1B(l1BTensorList[next],gb,bL1,layoutB.GetTileLayout(MakeCoord(count,actualShape.n())));
AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(l1BEventList[next]);
}
const uint32_t ka=min(actualShape.k()-j*kk,kk);
auto aL0=LayoutAInL0::template MakeLayout<ElementA>(mr,ka);
auto bL0=LayoutBInL0::template MakeLayout<ElementB>(ka,nr);
auto a=l0ATensorList[l0AListId],b=l0BTensorList[l0BListId];
AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(l0AEventList[l0AListId]);
if(j==0)AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(l1AEventList[0]);
auto aPart=l1ATensorList[0][aL1.GetOffset(MatrixCoord{uint32_t(0),j*kk})];
copyL1ToL0A(a,aPart,aL0,aL1);
if(j+1==parts){AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(l1AEventList[0]);AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(l1AEventList[1]);}
AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(l0BEventList[l0BListId]);
AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(l1BEventList[bs]);
copyL1ToL0B(b,l1BTensorList[bs],bL0,bL1);
AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(l1BEventList[bs]);
AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID0);
AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID0);
tileMmad(l0CTensor,a,b,mr,nr,ka,j==0,0);
AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(l0AEventList[l0AListId]);
AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(l0BEventList[l0BListId]);
l0AListId^=1;l0BListId^=1;
}
auto cBlock=layoutC.GetTileLayout(actualShape.GetCoordMN());
AscendC::SetFlag<AscendC::HardEvent::M_FIX>(EVENT_ID0);
AscendC::WaitFlag<AscendC::HardEvent::M_FIX>(EVENT_ID0);
copyL0CToGm(gmC,l0CTensor,cBlock,cL0);
AscendC::SetFlag<AscendC::HardEvent::FIX_M>(EVENT_ID0);
}
};
}
namespace herl2_profile {using Kernel=direct_core::Herl2EarlyAckGrouped<direct_core::Herl2FullA96,public_gmg::Herl2EarlyAckEpilogue>;}
extern "C" __global__ __aicore__ __attribute__((section(".herl2_profile")))
void grouped_matmul_gelu_herl2_profile(GM_ADDR,GM_ADDR,GM_ADDR,GM_ADDR,GM_ADDR,GM_ADDR,gmg::Plan);
inline bool TryPairedPipeline(GM_ADDR x,GM_ADDR w,GM_ADDR s,GM_ADDR g,GM_ADDR y,int64_t e,int64_t m,int64_t k,int64_t n,int64_t cores,aclrtStream stream){
if(k<1025 || k>1152 || n<512 || n>1024 || m<16*e || m>=128*e || cores<1)return false;
auto *hw=platform_ascendc::PlatformAscendCManager::GetInstance();if(!hw)return false;
const uint32_t blocks=std::min<int64_t>(cores,std::min<int64_t>(hw->GetCoreNumAic(),hw->GetCoreNumAiv()/2));if(!blocks)return false;
uint64_t l1=0,a=0,b=0,c=0,ub=0;
hw->GetCoreMemSize(platform_ascendc::CoreMemType::L1,l1);hw->GetCoreMemSize(platform_ascendc::CoreMemType::L0_A,a);hw->GetCoreMemSize(platform_ascendc::CoreMemType::L0_B,b);hw->GetCoreMemSize(platform_ascendc::CoreMemType::L0_C,c);hw->GetCoreMemSize(platform_ascendc::CoreMemType::UB,ub);
if(l1<516096 || a<2ULL*128*128 || b<61440 || c<122880 || ub<166400)return false;
uint64_t ffts=0;uint32_t length=0;if(rtGetC2cCtrlAddr(&ffts,&length)!=0)throw std::runtime_error("HERL2 FFTS unavailable");
const uint64_t pk=(k+31)/32*32,pn=(n+31)/32*32;
const uint64_t bytes=uint64_t(blocks)*2*30720*4;
uint8_t *scratch=nullptr;if(aclrtMalloc(reinterpret_cast<void**>(&scratch),bytes,ACL_MEM_MALLOC_HUGE_FIRST)!=ACL_SUCCESS)throw std::runtime_error("HERL2 workspace unavailable");
gmg::Plan p{};p.e=e;p.m=m;p.k=k;p.n=n;p.blocks=blocks;p.backend=1;p.ffts=ffts;
grouped_matmul_gelu_herl2_profile<<<blocks,nullptr,stream>>>(x,w,s,g,y,scratch,p);
const auto status=aclrtSynchronizeStream(stream);aclrtFree(scratch);if(status!=ACL_SUCCESS)throw std::runtime_error("HERL2 kernel failed");return true;
}
extern "C" __global__ __aicore__ __attribute__((section(".herl2_profile")))
void grouped_matmul_gelu_herl2_profile(GM_ADDR x,GM_ADDR w,GM_ADDR s,GM_ADDR g,GM_ADDR y,GM_ADDR scratch,gmg::Plan p){
KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);AscendC::SetSyncBaseAddr(p.ffts);
herl2_profile::Kernel::Params params{direct_core::GemmCoord{p.m,p.n,p.k},p.e,g,
x,direct_core::layout::RowMajor{p.m,p.k},w,direct_core::layout::RowMajor{p.k,p.n},
s,direct_core::layout::VectorLayout{p.n},y,direct_core::layout::RowMajor{p.m,p.n},scratch};
herl2_profile::Kernel op;op(params);
}
namespace direct_core {
template<class BlockMmad_,class BlockEpilogue_,uint32_t SPLITS>
class HBSplit {
public:
using BlockMmad=BlockMmad_;using BlockEpilogue=BlockEpilogue_;using Params=GroupParams;
using L1TileShape=typename BlockMmad::L1TileShape;using EpilogueParams=typename BlockEpilogue::Params;
static constexpr uint32_t TM=512,TN=256,TILE=TM*TN;
struct Job {uint32_t expert,rowBase,index,slice,kBase;GemmCoord coord,actual;};
class Iterator {
public:
DIRECT_DEVICE Iterator(Params const&p,uint32_t core,uint32_t count,uint32_t s):p(p),nextTask(core),cores(count),splits(s){groups.SetGlobalBuffer(p.ptrGroupList);}
DIRECT_DEVICE bool Next(Job&job){
while(group<p.problemCount){
if(!loaded){end=groups.GetValue(group);rows=end-rowBase;ml=CeilDiv(rows,TM);nl=CeilDiv(p.problemShape.n(),TN);tiles=ml*nl*splits;loaded=true;}
if(nextTask>=begin+tiles){begin+=tiles;rowBase=end;++group;loaded=false;continue;}
uint32_t task=nextTask-begin,idx=task/splits;GemmCoord c{idx/nl,idx%nl,0};
job.expert=group;job.rowBase=rowBase;job.index=begin/splits+idx;job.slice=task%splits;
uint32_t part=CeilDiv(p.problemShape.k(),SPLITS*32)*32;job.kBase=job.slice*part;
job.coord=c;job.actual={min(rows-c.m()*TM,TM),min(p.problemShape.n()-c.n()*TN,TN),min(p.problemShape.k()-job.kBase,part)};
nextTask+=cores;return true;
}
return false;
}
private:
Params const&p;AscendC::GlobalTensor<int64_t>groups;uint32_t nextTask,cores,splits,group=0,rowBase=0,end=0,rows=0,ml=0,nl=0,tiles=0,begin=0;bool loaded=false;
};
DIRECT_DEVICE void Clear(Params const&p){
auto tmp=resource.ubBuf.GetBufferByByte<int32_t>(0);AscendC::GlobalTensor<int32_t>c;AscendC::GlobalTensor<int64_t>groups;
c.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(p.ptrWorkspace));groups.SetGlobalBuffer(p.ptrGroupList);
AscendC::Duplicate(tmp,static_cast<int32_t>(0),8192);
AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
uint32_t core=AscendC::GetBlockIdx(),count=AscendC::GetBlockNum()*AscendC::GetSubBlockNum(),base=0,prefix=0,nl=CeilDiv(p.problemShape.n(),TN);
for(uint32_t g=0;g<p.problemCount;++g){
uint32_t end=groups.GetValue(g),rows=end-base;
for(uint32_t job=core;job<CeilDiv<32>(rows)*nl;job+=count){
uint32_t row=(job/nl)*32,col=job%nl,tile=prefix+(row/TM)*nl+col;
AscendC::DataCopy(c[uint64_t(tile)*TILE+(row%TM)*TN],tmp,min(rows-row,32U)*TN);
}
prefix+=CeilDiv(rows,TM)*nl;base=end;
}
AscendC::PipeBarrier<PIPE_ALL>();
}
DIRECT_DEVICE void operator()(Params const&p){
if constexpr(g_coreType==AscendC::AIV)Clear(p);
AscendC::SyncAll<false>();
if constexpr(g_coreType==AscendC::AIC)Cube(p);
AscendC::SyncAll<false>();
if constexpr(g_coreType==AscendC::AIV)Vector(p);
}
DIRECT_DEVICE void Cube(Params const&p){
AscendC::ICachePreLoad(1);BlockMmad mma(resource);Iterator jobs(p,AscendC::GetBlockIdx(),AscendC::GetBlockNum(),SPLITS);Job job;
AscendC::GlobalTensor<int8_t>a,b;AscendC::GlobalTensor<int32_t>c;
a.SetGlobalBuffer(p.ptrA);b.SetGlobalBuffer(p.ptrB);c.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(p.ptrWorkspace));
