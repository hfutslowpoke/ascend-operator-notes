const uint32_t summaryCompareCount = (summaryS32Count + 63) / 64 * 64;
PipeBarrier<PIPE_V>();
Compares(m1b.Get<uint8_t>(), m0b.Get<int32_t>(), static_cast<int32_t>(0),
