class Producer {
public:
__aicore__ __forceinline__ void Run(GM_ADDR xp,GM_ADDR wp,GM_ADDR cp,
small_raw_r14::Plan const &p,TPipe *pipe,uint32_t pitch) {
LocalTensor<int8_t> a1(TPosition::A1,0,2048),b1(TPosition::B1,2048,16384);
LocalTensor<int8_t> a2(TPosition::A2,0,2048),b2(TPosition::B2,0,16384);
LocalTensor<int32_t> c1(TPosition::CO1,0,2048);
GlobalTensor<int8_t> x,w;
x.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(xp),uint64_t(p.m)*p.k);
w.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(wp),uint64_t(p.k)*p.n);
GlobalTensor<int32_t> c;
c.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(cp),uint64_t(p.m)*p.n);
if(p.m!=p.paddedM){
InitConstValue(a1.ReinterpretCast<uint32_t>(),InitConstValueParams<uint32_t>{
1,static_cast<uint16_t>(p.paddedM*p.k/32),0,0U});
PipeBarrier<PIPE_ALL>();
}
Nd2NzParams ac{};
ac.ndNum=1;ac.nValue=p.m;ac.dValue=p.k;ac.srcDValue=p.k;
ac.dstNzC0Stride=p.paddedM;ac.dstNzNStride=1;
DataCopy(a1,x,ac);
SetFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);
Nd2NzParams bc{};
bc.ndNum=1;bc.nValue=p.k;bc.dValue=p.n;bc.srcDValue=pitch;
bc.dstNzC0Stride=p.k;bc.dstNzNStride=1;
DataCopy(b1,w,bc);
SetFlag<HardEvent::MTE2_MTE1>(EVENT_ID1);
WaitFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);
const uint32_t mb=p.paddedM/16,kb=p.k/32;
LoadData2DParams la{};
la.repeatTimes=static_cast<uint8_t>(kb);la.srcStride=static_cast<uint16_t>(mb);
la.ifTranspose=false;
for(uint32_t i=0;i<mb;++i)
LoadData(a2[i*kb*512],a1[i*512],la);
WaitFlag<HardEvent::MTE2_MTE1>(EVENT_ID1);
LoadData2dTransposeParams lb{};
lb.repeatTimes=static_cast<uint8_t>(p.n/32);lb.srcStride=static_cast<uint16_t>(kb);
lb.dstGap=1;lb.dstFracGap=0;
for(uint32_t i=0;i<kb;++i)
LoadDataWithTranspose(b2[i*p.n*32],b1[i*1024],lb);
Fence<HardEvent::MTE1_M>();
MmadParams mm{};
mm.m=static_cast<uint16_t>(p.paddedM);mm.n=static_cast<uint16_t>(p.n);
mm.k=static_cast<uint16_t>(p.k);mm.cmatrixInitVal=true;
Mmad(c1,a2,b2,mm);
Fence<HardEvent::M_FIX>();
FixpipeParamsV220 fp{};
fp.nSize=static_cast<uint16_t>(p.n);fp.mSize=static_cast<uint16_t>(p.m);
fp.srcStride=static_cast<uint16_t>(p.paddedM);fp.dstStride=pitch;fp.ndNum=1;
fp.quantPre=QuantMode_t::NoQuant;
Fixpipe<int32_t,int32_t,CFG_ROW_MAJOR>(c,c1,fp);
CrossCoreSetFlag<2,PIPE_FIX>(8);
PipeBarrier<PIPE_ALL>();
}
private:
template<HardEvent E> __aicore__ __forceinline__ void Fence() {
SetFlag<E>(EVENT_ID0);WaitFlag<E>(EVENT_ID0);
}
TBuf<TPosition::A1> ab;TBuf<TPosition::B1> bb;
TBuf<TPosition::A2> a2b;TBuf<TPosition::B2> b2b;TBuf<TPosition::CO1> cb;
};
}
namespace public_gmg {
class Hel1OptEpilogue {
public:
using ElementScale = float;
using LayoutScale = layout::VectorLayout;
using ElementD = half;
using LayoutD = layout::RowMajor;
struct Params {
__gm__ float *sp;
LayoutScale sl;
__gm__ half *yp;
LayoutD yl;
__aicore__ __forceinline__ Params() {}
__aicore__ __forceinline__ Params(__gm__ float *s, LayoutScale a, __gm__ half *y, LayoutD c) :
sp(s), sl(a), yp(y), yl(c) {}
};
__aicore__ __forceinline__ Hel1OptEpilogue() {
Buffer *buffers[] = {&cb,&zb,&qb,&tb,&db,&sb,&yb,&m0b,&m1b};
const uint32_t offsets[] = {0,4352,8704,13056,17664,22016,22528,24576,25632};
for(uint32_t i=0;i<9;++i)
buffers[i]->tensor=LocalTensor<uint8_t>(TPosition::VECCALC,offsets[i],184384-offsets[i]);
}
__aicore__ __forceinline__ void PreloadScale(uint32_t vn) {
auto s=sb.Get<float>();
const uint32_t stride=(vn+7)/8*8;
DataCopyPad(s,scale,DataCopyExtParams{1,vn*4,0,0,0},
DataCopyPadExtParams<float>{true,0,static_cast<uint8_t>(stride-vn),0.0f});
}
__aicore__ __forceinline__ void UpdateParams(Params const &p) {
params = p;
plan.n = p.yl.stride(0);
scale.SetGlobalBuffer(p.sp);
y.SetGlobalBuffer(p.yp);
}
__aicore__ __forceinline__ void operator()(GemmCoord const &shape, GemmCoord const &coord,
GemmCoord const &actual, GlobalTensor<int32_t> const &src,
layout::RowMajor const &srcLayout) {
accumStride = srcLayout.stride(0);
const uint32_t perSub = (actual.m() + 1) / 2;
const uint32_t first = GetSubBlockIdx() * perSub;
const uint32_t end = first + perSub < actual.m() ? first + perSub : actual.m();
for (uint32_t local = first; local < end; local += 32) {
const uint32_t count = end - local < 32 ? end - local : 32;
accum = src[uint64_t(local) * srcLayout.stride(0)];
Compute(0, coord.m() * shape.m() + local, coord.n() * shape.n(), count, actual.n());
}
}
private:
__aicore__ __forceinline__ static uint16_t RefineGeluLarge(float x) { return hel1_opt_20261113::HelRefine(x); }
__aicore__ __forceinline__ void Compute(uint32_t e, uint32_t row, uint32_t col,
uint32_t vm, uint32_t vn) {
const uint32_t stride = (vn + 7) / 8 * 8;
const bool packed = stride % 16 == 0;
const uint32_t len = vm * stride;
auto ci = cb.Get<int32_t>();
auto z = zb.Get<float>();
auto q = qb.Get<float>();
auto t = tb.Get<float>();
auto d = db.Get<float>();
auto s = sb.Get<float>();
auto out = yb.Get<half>();
DataCopyPad(ci, accum,
DataCopyExtParams{static_cast<uint16_t>(vm), vn * 4, (accumStride - vn) * 4, 0, 0},
DataCopyPadExtParams<int32_t>{true, 0, static_cast<uint8_t>(stride - vn), 0});
SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
Cast(z, ci, RoundMode::CAST_RINT, len);
BinaryRepeatParams br;
br.dstBlkStride = 1; br.src0BlkStride = 1; br.src1BlkStride = 1;
br.dstRepStride = stride / 8; br.src0RepStride = stride / 8; br.src1RepStride = 0;
for (uint32_t col = 0; col < stride; col += 64) {
const uint64_t mask = stride - col < 64 ? stride - col : 64;
Mul(z[col], z[col], s[col], mask, static_cast<uint8_t>(vm), br);
}
Mul(q, z, z, len);
Muls(q, q, 0.044715f, len);
Adds(q, q, 1.0f, len);
Mul(q, q, z, len);
Muls(q, q, -1.5957691216057308f, len);
Mins(q, q, 87.0f, len);
Exp(q,q, len);
Adds(d, q, 1.0f, len);
Div(q, z, d, len);
if (packed) Cast(out, q, RoundMode::CAST_RINT, len);
else for (uint32_t r = 0; r < vm; ++r)
Cast(out[r * tileN], q[r * stride], RoundMode::CAST_RINT, stride);
const uint32_t paddedLen = (len + 63) / 64 * 64;
if (paddedLen > len) {
Duplicate(q[len], 0.0f, paddedLen - len);
}
auto mask0 = m0b.Get<uint8_t>();
auto mask1 = m1b.Get<uint8_t>();
Duplicate(db.Get<int32_t>(), static_cast<int32_t>(0xf8001fffU), paddedLen);
And(cb.Get<uint16_t>(), q.ReinterpretCast<uint16_t>(), db.Get<uint16_t>(), paddedLen * 2);
Duplicate(m0b.Get<uint16_t>(), static_cast<uint16_t>(0), 128);
Compares(mask0, cb.Get<float>(), 2.00097560882568359375f, CMPMODE::GE, paddedLen);
Compares(mask1, cb.Get<float>(), 2.00097751617431640625f, CMPMODE::LE, paddedLen);
And(m0b.Get<uint16_t>(), m0b.Get<uint16_t>(), m1b.Get<uint16_t>(), (paddedLen + 15) / 16);
Abs(d, q, paddedLen);
Mins(d, d, 0.00006103515625f, paddedLen);
Muls(d, d, 16777216.0f, paddedLen);
Adds(t,d,8388608.0f,paddedLen);
Adds(t,t,-8388608.0f,paddedLen);
Sub(t,d,t,paddedLen);
Abs(t,t,paddedLen);
Adds(t,t,-0.5f,paddedLen);
Muls(d,d,8.0e-6f,paddedLen);
Add(t,t,d,paddedLen);
Compares(mask1,t,0.0f,CMPMODE::GE,paddedLen);
Or(m0b.Get<uint16_t>(), m0b.Get<uint16_t>(), m1b.Get<uint16_t>(), (paddedLen + 15) / 16);
const uint32_t maskScalarWords = (len + 63) / 64;
const uint32_t summaryS32Count = maskScalarWords * 2;
const uint32_t summaryCompareCount = (summaryS32Count + 63) / 64 * 64;
Compares(m1b.Get<uint8_t>(), m0b.Get<int32_t>(), static_cast<int32_t>(0),
CMPMODE::EQ, summaryCompareCount);
SetFlag<HardEvent::V_S>(EVENT_ID0);
WaitFlag<HardEvent::V_S>(EVENT_ID0);
auto qbits = qb.Get<uint32_t>();
auto outbits = yb.Get<uint16_t>();
auto words = m0b.Get<uint64_t>();
auto wordSummary = m1b.Get<uint64_t>();
for (uint32_t summaryBase = 0; summaryBase < summaryS32Count; summaryBase += 64) {
uint64_t nonzeroSubwords = ~wordSummary.GetValue(summaryBase / 64);
const uint32_t remaining = summaryS32Count - summaryBase;
if (remaining < 64) nonzeroSubwords &= (uint64_t(1) << remaining) - 1;
while (nonzeroSubwords) {
const uint32_t summaryBit = static_cast<uint32_t>(__builtin_ctzll(nonzeroSubwords));
nonzeroSubwords &= ~(uint64_t(3) << (summaryBit & ~uint32_t(1)));
const uint32_t originalWord = (summaryBase + summaryBit) / 2;
const uint32_t base = originalWord * 64;
uint64_t flags = words.GetValue(originalWord);
while (flags) {
const uint32_t bit = static_cast<uint32_t>(__builtin_ctzll(flags));
flags &= flags - 1;
const uint32_t i = base + bit;
if (i >= len || i % stride >= vn) continue;
const uint32_t bits = qbits.GetValue(i);
const uint32_t mag = bits & 0x7fffffff;
if ((bits >> 31) ? (mag < 0x38800000) : (mag >= 0x40000000 || mag < 0x38800000)) {
const float value = z.GetValue(i);
if (value > -8.0f && value < 8.0f)
outbits.SetValue((i / stride) * (packed ? stride : tileN) + i % stride, RefineGeluLarge(value));
}
}
}
}
SetFlag<HardEvent::S_MTE3>(EVENT_ID0);
WaitFlag<HardEvent::S_MTE3>(EVENT_ID0);
SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
const uint32_t rowStride = packed ? stride : tileN;
DataCopyPad(y[uint64_t(row) * plan.n + col], out,
DataCopyExtParams{static_cast<uint16_t>(vm), vn * 2,
(rowStride - (vn + 15) / 16 * 16) / 16, (plan.n - vn) * 2, 0});
}
uint32_t accumStride;
Params params;
struct { uint32_t n; } plan;
static constexpr uint32_t elements = 8192;
static constexpr uint32_t tileN = 256;
GlobalTensor<float> scale;
GlobalTensor<half> y;
GlobalTensor<int32_t> accum;
Buffer cb, zb, qb, tb, db, sb, yb, hb, m0b, m1b;
};
}
extern "C" __global__ __aicore__ __attribute__((section(".hel1_opt_20261113")))
void grouped_matmul_gelu_hel1_opt_20261113(GM_ADDR xp,GM_ADDR wp,GM_ADDR sp,GM_ADDR yp,GM_ADDR cp,
small_raw_r14::Plan p,uint32_t panelM,uint32_t panelN) {
KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
using namespace AscendC;
SetSyncBaseAddr(p.ffts);
constexpr uint32_t tileM=16,tileN=128;
const uint32_t nt=1;
if ASCEND_IS_AIC {
const uint32_t group=GetBlockIdx(),row=group/nt*tileM,col=group%nt*tileN;
const uint32_t rows=p.m-row<tileM?p.m-row:tileM;
const uint32_t cols=p.n-col<tileN?p.n-col:tileN;
const small_raw_r14::Plan tile{rows,cols,p.k,16,p.ffts};
hel1_opt_20261113::Producer op;
op.Run(xp+uint64_t(row)*p.k,wp+col,cp+(uint64_t(row)*p.n+col)*4,tile,nullptr,p.n);
}
if ASCEND_IS_AIV {
const uint32_t group=GetBlockIdx()/GetSubBlockNum(),row=group/nt*tileM,col=group%nt*tileN;
const uint32_t rows=p.m-row<tileM?p.m-row:tileM;
const uint32_t cols=p.n-col<tileN?p.n-col:tileN;
public_gmg::Hel1OptEpilogue op;
public_gmg::Hel1OptEpilogue::Params params{
reinterpret_cast<__gm__ float*>(sp)+col,direct_core::layout::VectorLayout{p.n},
reinterpret_cast<__gm__ half*>(yp)+uint64_t(row)*p.n+col,direct_core::layout::RowMajor{rows,p.n}};
op.UpdateParams(params);
GlobalTensor<int32_t> c;c.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(cp)+uint64_t(row)*p.n+col,uint64_t(rows)*p.n);
const direct_core::GemmCoord shape{tileM,cols,p.k},coord{0,0,0},actual{rows,cols,p.k};
const direct_core::layout::RowMajor cl{rows,p.n};
op.PreloadScale(cols);
CrossCoreWaitFlag(8);
op(shape,coord,actual,c,cl);
PipeBarrier<PIPE_ALL>();
}
}
extern "C" __global__ __aicore__ __attribute__((section(".hel2_aiv_retained")))
void grouped_matmul_gelu_hel2_aiv_retained(
GM_ADDR xp,GM_ADDR wp,GM_ADDR sp,GM_ADDR gp,GM_ADDR yp,uint32_t e) {
KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
using namespace AscendC;
GlobalTensor<int8_t> x,w;
GlobalTensor<float> s;
GlobalTensor<int64_t> g;
GlobalTensor<uint16_t> y;
x.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t *>(xp));
w.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t *>(wp));
s.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(sp));
g.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t *>(gp));
y.SetGlobalBuffer(reinterpret_cast<__gm__ uint16_t *>(yp));
GlobalTensor<uint64_t> cg;
cg.SetGlobalBuffer(reinterpret_cast<__gm__ uint64_t *>(gp));
DataCachePreload(cg,static_cast<int16_t>(0));
GlobalTensor<uint64_t> cx,cw,cs;
cx.SetGlobalBuffer(reinterpret_cast<__gm__ uint64_t *>(xp));
cw.SetGlobalBuffer(reinterpret_cast<__gm__ uint64_t *>(wp));
cs.SetGlobalBuffer(reinterpret_cast<__gm__ uint64_t *>(sp));
DataCachePreload(cx,static_cast<int16_t>(0));
DataCachePreload(cw,static_cast<int16_t>(0));
DataCachePreload(cs,static_cast<int16_t>(0));
GlobalTensor<uint64_t> cy;
cy.SetGlobalBuffer(reinterpret_cast<__gm__ uint64_t *>(yp));
int32_t left=-1,right=static_cast<int32_t>(e)-1;
while(right-left>1) {
const uint32_t mid=static_cast<uint32_t>((left+right)/2);
if(g.GetValue(mid)==0)left=mid;else right=mid;
}
const uint32_t expert=static_cast<uint32_t>(right);
const int32_t dot=static_cast<int32_t>(x.GetValue(0))*static_cast<int32_t>(w.GetValue(expert));
const float value=static_cast<float>(dot)*s.GetValue(expert);
WriteGmByPassDCache(reinterpret_cast<__gm__ uint16_t *>(yp),tiny_short_scalar::Gelu(value));
DataSyncBarrier<MemDsbT::DDR>();
}

namespace public_gmg {
template<uint32_t Chunk>
class C0845HCStreamEpilogue {
public:
using ElementScale=float;using LayoutScale=layout::VectorLayout;
using ElementD=half;using LayoutD=layout::RowMajor;
using Params=DescriptorBankStableEpilogue::Params;
__aicore__ __forceinline__ C0845HCStreamEpilogue(Arch::Resource&r){
constexpr uint32_t qo=Chunk*256*4,so=qo+128*256*4,yo=so+1024;
zb.tensor=r.ubBuf.GetBufferByByte<uint8_t>(0);qb.tensor=r.ubBuf.GetBufferByByte<uint8_t>(qo);
sb.tensor=r.ubBuf.GetBufferByByte<uint8_t>(so);
for(uint32_t i=0;i<2;++i)yb[i].tensor=r.ubBuf.GetBufferByByte<uint8_t>(yo+i*Chunk*256*2);
}
__aicore__ __forceinline__ ~C0845HCStreamEpilogue(){
if(vPending)WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
for(uint32_t i=0;i<2;++i)if(yPending[i])WaitFlag<HardEvent::MTE3_V>(i);
PipeBarrier<PIPE_ALL>();
}
__aicore__ __forceinline__ void UpdateParams(Params const&p){width=p.yl.stride(0);scale.SetGlobalBuffer(p.sp);y.SetGlobalBuffer(p.yp);}
__aicore__ __forceinline__ void operator()(GemmCoord const&shape,GemmCoord const&coord,GemmCoord const&actual,GlobalTensor<int32_t>const&src,layout::RowMajor const&sl,Arch::CrossCoreFlag&ack){
const uint32_t per=(actual.m()+1)/2,first=GetSubBlockIdx()*per,end=min(first+per,actual.m());
if(first>=end){Arch::Signal<PIPE_MTE2>(ack);return;}
const uint32_t vm=end-first,vn=actual.n(),stride=(vn+7)/8*8,outPitch=(vn+15)/16*16,col=coord.n()*shape.n();
auto ci=qb.Get<int32_t>();auto q=qb.Get<float>();auto z=zb.Get<float>();auto s=sb.Get<float>();
if(vPending){WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);vPending=false;}
DataCopyPad(ci,src[uint64_t(first)*sl.stride(0)],DataCopyExtParams{static_cast<uint16_t>(vm),vn*4,uint32_t(sl.stride(0)-vn)*4,0,0},DataCopyPadExtParams<int32_t>{true,0,static_cast<uint8_t>(stride-vn),0});
DataCopyPad(s,scale[col],DataCopyExtParams{1,vn*4,0,0,0},DataCopyPadExtParams<float>{true,0,static_cast<uint8_t>(stride-vn),0.f});
Arch::Signal<PIPE_MTE2>(ack);
SetFlag<HardEvent::MTE2_V>(EVENT_ID0);WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
for(uint32_t r=0;r<vm;r+=Chunk){
const uint32_t rows=min(Chunk,vm-r),len=rows*stride,slot=outIndex;
auto qq=q[r*stride];auto cc=ci[r*stride];
Cast(z,cc,RoundMode::CAST_RINT,len);
BinaryRepeatParams br;br.dstBlkStride=1;br.src0BlkStride=1;br.src1BlkStride=1;br.dstRepStride=stride/8;br.src0RepStride=stride/8;br.src1RepStride=0;
for(uint32_t c=0;c<stride;c+=64)Mul(z[c],z[c],s[c],uint64_t(min(stride-c,64U)),static_cast<uint8_t>(rows),br);
Mul(qq,z,z,len);Muls(qq,qq,.044715f,len);Adds(qq,qq,1.f,len);Mul(qq,qq,z,len);
Muls(qq,qq,-1.5957691216057308f,len);Mins(qq,qq,87.f,len);Exp(qq,qq,len);Adds(qq,qq,1.f,len);Div(qq,z,qq,len);
if(yPending[slot])WaitFlag<HardEvent::MTE3_V>(slot);
auto out=yb[slot].Get<half>();
if(stride%16==0)Cast(out,qq,RoundMode::CAST_RINT,len);
else{
UnaryRepeatParams cr;cr.dstBlkStride=1;cr.srcBlkStride=1;cr.dstRepStride=outPitch/16;cr.srcRepStride=stride/8;
for(uint32_t c=0;c<stride;c+=64)Cast(out[c],qq[c],RoundMode::CAST_RINT,uint64_t(min(stride-c,64U)),static_cast<uint8_t>(rows),cr);
}
SetFlag<HardEvent::V_MTE3>(EVENT_ID0);WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
DataCopyPad(y[uint64_t(coord.m()*shape.m()+first+r)*width+col],out,DataCopyExtParams{static_cast<uint16_t>(rows),vn*2,0,(width-vn)*2,0});
SetFlag<HardEvent::MTE3_V>(slot);yPending[slot]=true;outIndex^=1;
}
SetFlag<HardEvent::V_MTE2>(EVENT_ID0);vPending=true;
}
private:
uint32_t width=0,outIndex=0;bool vPending=false,yPending[2]={false,false};
GlobalTensor<float>scale;GlobalTensor<half>y;Buffer zb,qb,sb,yb[2];
};
}
namespace direct_core {
template<class BlockMmad_,class BlockEpilogue_>
class C0845HCIterator {
public:
using BlockMmad=BlockMmad_;using BlockEpilogue=BlockEpilogue_;
using L1TileShape=typename BlockMmad::L1TileShape;using Params=GroupParams;
using Arguments=GroupArguments;using EpilogueParams=typename BlockEpilogue::Params;
static constexpr uint32_t WORKSPACE_STAGES=2;
static size_t GetWorkspaceSize(Arguments const&a){return uint64_t(a.aicCoreNum)*2*L1TileShape::M*L1TileShape::N*4;}
struct Job {uint32_t expert,rowBase;GemmCoord coord,actual;};
class Iterator {
public:
DIRECT_DEVICE Iterator(Params const&p,uint32_t core,uint32_t count):p(p),nextTask(core),cores(count){
groups.SetGlobalBuffer(p.ptrGroupList);uint32_t prev=0,big=0,second=0;
for(uint32_t i=0;i<p.problemCount;++i){uint32_t end=groups.GetValue(i),v=end-prev;prev=end;if(v>=big){second=big;big=v;}else if(v>second)second=v;}
tileM=second&&second<=256?max(160U,RoundUp<16>(second)):256;
}
DIRECT_DEVICE uint32_t TileM()const{return tileM;}
DIRECT_DEVICE bool Next(Job &job){
while(group<p.problemCount){
if(!loaded){end=groups.GetValue(group);rows=end-rowBase;ml=CeilDiv(rows,tileM);nl=CeilDiv(p.problemShape.n(),L1TileShape::N);tiles=ml*nl;loaded=true;if(rows)++active;}
if(nextTask>=begin+tiles){begin+=tiles;rowBase=end;++group;loaded=false;continue;}
uint32_t task=nextTask-begin;GemmCoord c;
if(nl==5)c={task/5,(task%5+task/5+active-1)%5,0};
else if(nl==3)c={task/3,task%3,0};
else if(nl==2)c={task/2,task%2,0};
else c={task/nl,task%nl,0};
job.expert=group;job.rowBase=rowBase;job.coord=c;
job.actual=GemmCoord{min(rows-c.m()*tileM,tileM),min(p.problemShape.n()-c.n()*L1TileShape::N,L1TileShape::N),p.problemShape.k()};
nextTask+=cores;return true;
}
return false;
}
private:
Params const&p;AscendC::GlobalTensor<int64_t> groups;
uint32_t nextTask,cores,group=0,rowBase=0,end=0,rows=0,ml=0,nl=0,tiles=0,begin=0,active=0,tileM=256;bool loaded=false;
