And(cb.Get<uint16_t>(), q.ReinterpretCast<uint16_t>(), db.Get<uint16_t>(), paddedLen * 2);
Duplicate(m0b.Get<uint16_t>(), static_cast<uint16_t>(0), 128);
PipeBarrier<PIPE_V>();
Compares(mask0, cb.Get<float>(), 2.00097560882568359375f, CMPMODE::GE, paddedLen);
Compares(mask1, cb.Get<float>(), 2.00097751617431640625f, CMPMODE::LE, paddedLen);
PipeBarrier<PIPE_V>();
And(m0b.Get<uint16_t>(), m0b.Get<uint16_t>(), m1b.Get<uint16_t>(), (paddedLen + 15) / 16);
Abs(d, q, paddedLen);
PipeBarrier<PIPE_V>();
Mins(d, d, 0.00006103515625f, paddedLen);
PipeBarrier<PIPE_V>();
Muls(d, d, 16777216.0f, paddedLen);
PipeBarrier<PIPE_V>();
Cast(cb.Get<int32_t>(), d, RoundMode::CAST_FLOOR, paddedLen);
PipeBarrier<PIPE_V>();
Cast(t, cb.Get<int32_t>(), RoundMode::CAST_RINT, paddedLen);
PipeBarrier<PIPE_V>();
Sub(t, d, t, paddedLen);
PipeBarrier<PIPE_V>();
Adds(t, t, -0.5f, paddedLen);
PipeBarrier<PIPE_V>();
Abs(t, t, paddedLen);
Muls(d, d, 8.0e-6f, paddedLen);
PipeBarrier<PIPE_V>();
Sub(t, t, d, paddedLen);
PipeBarrier<PIPE_V>();
Compares(mask1, t, 0.0f, CMPMODE::LE, paddedLen);
PipeBarrier<PIPE_V>();
Or(m0b.Get<uint16_t>(), m0b.Get<uint16_t>(), m1b.Get<uint16_t>(), (paddedLen + 15) / 16);
const uint32_t maskScalarWords = (len + 63) / 64;
const uint32_t summaryS32Count = maskScalarWords * 2;
const uint32_t summaryCompareCount = (summaryS32Count + 63) / 64 * 64;
PipeBarrier<PIPE_V>();
Compares(m1b.Get<uint8_t>(), m0b.Get<int32_t>(), static_cast<int32_t>(0),
CMPMODE::EQ, summaryCompareCount);
SetFlag<HardEvent::V_S>(EVENT_ID0);
WaitFlag<HardEvent::V_S>(EVENT_ID0);
auto qbits = qb.Get<uint32_t>();
auto outbits = yb.Get<uint16_t>();
auto words = m0b.Get<uint64_t>();
auto wordSummary = m1b.Get<uint64_t>();
for (uint32_t summaryBase = 0; summaryBase < summaryS32Count; summaryBase += 64) {
uint64_t nonzeroSubwords = ~wordSummary.GetValue(summaryBase / 64);
const uint32_t remaining = summaryS32Count - summaryBase;
if (remaining < 64) nonzeroSubwords &= (uint64_t(1) << remaining) - 1;
while (nonzeroSubwords) {
const uint32_t summaryBit = static_cast<uint32_t>(__builtin_ctzll(nonzeroSubwords));
nonzeroSubwords &= ~(uint64_t(3) << (summaryBit & ~uint32_t(1)));
const uint32_t originalWord = (summaryBase + summaryBit) / 2;
const uint32_t base = originalWord * 64;
uint64_t flags = words.GetValue(originalWord);
while (flags) {
const uint32_t bit = static_cast<uint32_t>(__builtin_ctzll(flags));
flags &= flags - 1;
const uint32_t i = base + bit;
if (i >= len || i % stride >= vn) continue;
const uint32_t bits = qbits.GetValue(i);
const uint32_t mag = bits & 0x7fffffff;
if ((bits >> 31) ? (mag < 0x38800000) : (mag >= 0x40000000 || mag < 0x38800000)) {
const float value = z.GetValue(i);
if (value > -8.0f && value < 8.0f)
outbits.SetValue((i / stride) * (packed ? stride : tileN) + i % stride, RefineGeluLarge(value));
}
}
}
}
SetFlag<HardEvent::S_MTE3>(EVENT_ID0);
WaitFlag<HardEvent::S_MTE3>(EVENT_ID0);
SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
const uint32_t rowStride = packed ? stride : tileN;
DataCopyPad(y[uint64_t(row) * plan.n + col], out,
DataCopyExtParams{static_cast<uint16_t>(vm), vn * 2,
(rowStride - (vn + 15) / 16 * 16) / 16, (plan.n - vn) * 2, 0});
PipeBarrier<PIPE_ALL>();
}
uint32_t accumStride;
Params params;
struct { uint32_t n; } plan;
static constexpr uint32_t elements = 8192;
static constexpr uint32_t tileN = 256;
GlobalTensor<float> scale;
GlobalTensor<half> y;
GlobalTensor<int32_t> accum;
Buffer cb, zb, qb, tb, db, sb, yb, hb, m0b, m1b;
};
class Base64IntervalEpilogue {
public:
using ElementScale = BankStableEpilogue::ElementScale;
using LayoutScale = BankStableEpilogue::LayoutScale;
using ElementD = BankStableEpilogue::ElementD;
using LayoutD = BankStableEpilogue::LayoutD;
using Params = BankStableEpilogue::Params;
__aicore__ __forceinline__ Base64IntervalEpilogue(Arch::Resource &resource) : fallback(resource) {
Buffer *buffers[] = {&zb,&qb,&tb,&db,&sb,&yb,&m0b,&m1b,&kb};
const uint32_t offsets[] = {0,65792,0,65792,164608,131328,165632,167712,169792};
for(uint32_t i=0;i<9;++i)
buffers[i]->tensor=resource.ubBuf.GetBufferByByte<uint8_t>(offsets[i]);
}
__aicore__ __forceinline__ void UpdateParams(Params const &p) {
fallback.UpdateParams(p);
plan.n=p.yl.stride(0); scale.SetGlobalBuffer(p.sp); y.SetGlobalBuffer(p.yp);
}
__aicore__ __forceinline__ void operator()(GemmCoord const &shape, GemmCoord const &coord,
GemmCoord const &actual, GlobalTensor<int32_t> const &src, layout::RowMajor const &srcLayout) {
const uint32_t perSub=(actual.m()+1)/2;
const uint32_t first=GetSubBlockIdx()*perSub;
const uint32_t end=first+perSub<actual.m()?first+perSub:actual.m();
const uint32_t count=end>first?end-first:0;
const uint32_t stride=(actual.n()+7)/8*8;
if(count<=32 || count>64 || stride%16!=0){
fallback(shape,coord,actual,src,srcLayout);
return;
}
accumStride=srcLayout.stride(0);
accum=src[uint64_t(first)*accumStride];
Compute64(coord.m()*shape.m()+first,coord.n()*shape.n(),count,actual.n());
}
private:
__aicore__ __forceinline__ void Compute64(uint32_t row,uint32_t col,uint32_t vm,uint32_t vn) {
const uint32_t e=0, stride=(vn+7)/8*8, len=vm*stride;
auto ci = qb.Get<int32_t>();
auto z = zb.Get<float>();
auto q = qb.Get<float>();
auto s = sb.Get<float>();
auto out = yb.Get<half>();
DataCopyPad(ci, accum,
DataCopyExtParams{static_cast<uint16_t>(vm), vn * 4, (accumStride - vn) * 4, 0, 0},
DataCopyPadExtParams<int32_t>{true, 0, static_cast<uint8_t>(stride - vn), 0});
DataCopyPad(s, scale[uint64_t(e) * plan.n + col],
DataCopyExtParams{1, vn * 4, 0, 0, 0},
DataCopyPadExtParams<float>{true, 0, static_cast<uint8_t>(stride - vn), 0.0f});
SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
Cast(z, ci, RoundMode::CAST_RINT, len);
PipeBarrier<PIPE_V>();
BinaryRepeatParams br;
br.dstBlkStride = 1; br.src0BlkStride = 1; br.src1BlkStride = 1;
br.dstRepStride = stride / 8; br.src0RepStride = stride / 8; br.src1RepStride = 0;
for (uint32_t col = 0; col < stride; col += 64) {
const uint64_t mask = stride - col < 64 ? stride - col : 64;
Mul(z[col], z[col], s[col], mask, static_cast<uint8_t>(vm), br);
}
PipeBarrier<PIPE_V>();
Mul(q, z, z, len);
PipeBarrier<PIPE_V>();
Muls(q, q, 0.044715f, len);
PipeBarrier<PIPE_V>();
Adds(q, q, 1.0f, len);
PipeBarrier<PIPE_V>();
Mul(q, q, z, len);
PipeBarrier<PIPE_V>();
Muls(q, q, 1.5957691216057308f, len);
PipeBarrier<PIPE_V>();
Muls(q, q, -1.0f, len);
PipeBarrier<PIPE_V>();
Mins(q, q, 87.0f, len);
PipeBarrier<PIPE_V>();
Exp(q, q, len);
PipeBarrier<PIPE_V>();
Adds(q, q, 1.0f, len);
PipeBarrier<PIPE_V>();
Div(q, z, q, len);
PipeBarrier<PIPE_V>();
Cast(out,q,RoundMode::CAST_RINT,len);
PipeBarrier<PIPE_V>();
SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
DataCopyPad(y[uint64_t(row)*plan.n+col],out,
DataCopyExtParams{static_cast<uint16_t>(vm),vn*2,
(stride-(vn+15)/16*16)/16,(plan.n-vn)*2,0});
PipeBarrier<PIPE_ALL>();
}
BankStableEpilogue fallback;
uint32_t accumStride;
struct { uint32_t n; } plan;
static constexpr uint32_t elements=16384;
GlobalTensor<float> scale;
GlobalTensor<half> y;
GlobalTensor<int32_t> accum;
Buffer zb,qb,tb,db,sb,yb,m0b,m1b,kb;
};
class PackedTailBankStableEpilogue {
public:
using ElementScale = float;
using LayoutScale = layout::VectorLayout;
using ElementD = half;
using LayoutD = layout::RowMajor;
using Params = BankStableEpilogue::Params;
__aicore__ __forceinline__ PackedTailBankStableEpilogue(Arch::Resource &resource) {
Buffer *buffers[] = {&cb,&zb,&qb,&tb,&db,&sb,&yb,&m0b,&m1b};
const uint32_t offsets[] = {0,33024,66048,98816,131840,164864,165888,182272,183328};
for(uint32_t i=0;i<9;++i)
buffers[i]->tensor=resource.ubBuf.GetBufferByByte<uint8_t>(offsets[i]);
}
__aicore__ __forceinline__ void UpdateParams(Params const &p) {
params = p;
plan.n = p.yl.stride(0);
scale.SetGlobalBuffer(p.sp);
y.SetGlobalBuffer(p.yp);
}
__aicore__ __forceinline__ void operator()(GemmCoord const &shape, GemmCoord const &coord,
GemmCoord const &actual, GlobalTensor<int32_t> const &src,
layout::RowMajor const &srcLayout) {
accumStride = srcLayout.stride(0);
const uint32_t perSub = (actual.m() + 1) / 2;
const uint32_t first = GetSubBlockIdx() * perSub;
const uint32_t end = first + perSub < actual.m() ? first + perSub : actual.m();
for (uint32_t local = first; local < end; local += 32) {
const uint32_t count = end - local < 32 ? end - local : 32;
accum = src[uint64_t(local) * srcLayout.stride(0)];
Compute(0, coord.m() * shape.m() + local, coord.n() * shape.n(), count, actual.n());
}
}
private:
__aicore__ __forceinline__ static uint16_t RefineGeluLarge(float x) { return gmg::RefineGeluLarge(x); }
__aicore__ __forceinline__ void Compute(uint32_t e, uint32_t row, uint32_t col,
uint32_t vm, uint32_t vn) {
const uint32_t stride = (vn + 15) / 16 * 16;
const bool packed = stride % 16 == 0;
const uint32_t len = vm * stride;
auto ci = cb.Get<int32_t>();
auto z = zb.Get<float>();
auto q = qb.Get<float>();
auto t = tb.Get<float>();
auto d = db.Get<float>();
auto s = sb.Get<float>();
auto out = yb.Get<half>();
const uint32_t dmaStride=(vn+7)/8*8;
if(stride!=dmaStride){
Duplicate(ci,static_cast<int32_t>(0),len);
Duplicate(s,0.0f,stride);
SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
}
DataCopyPad(ci, accum,
DataCopyExtParams{static_cast<uint16_t>(vm), vn * 4, (accumStride - vn) * 4, (stride-dmaStride)/8, 0},
DataCopyPadExtParams<int32_t>{true, 0, static_cast<uint8_t>(dmaStride - vn), 0});
DataCopyPad(s, scale[uint64_t(e) * plan.n + col],
DataCopyExtParams{1, vn * 4, 0, 0, 0},
DataCopyPadExtParams<float>{true, 0, static_cast<uint8_t>(dmaStride - vn), 0.0f});
SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
Cast(z, ci, RoundMode::CAST_RINT, len);
PipeBarrier<PIPE_V>();
BinaryRepeatParams br;
br.dstBlkStride = 1; br.src0BlkStride = 1; br.src1BlkStride = 1;
br.dstRepStride = stride / 8; br.src0RepStride = stride / 8; br.src1RepStride = 0;
for (uint32_t col = 0; col < stride; col += 64) {
const uint64_t mask = stride - col < 64 ? stride - col : 64;
Mul(z[col], z[col], s[col], mask, static_cast<uint8_t>(vm), br);
}
PipeBarrier<PIPE_V>();
Mul(q, z, z, len);
PipeBarrier<PIPE_V>();
Muls(q, q, 0.044715f, len);
PipeBarrier<PIPE_V>();
Adds(q, q, 1.0f, len);
PipeBarrier<PIPE_V>();
Mul(q, q, z, len);
PipeBarrier<PIPE_V>();
Muls(q, q, 1.5957691216057308f, len);
PipeBarrier<PIPE_V>();
Muls(q, q, -1.0f, len);
PipeBarrier<PIPE_V>();
Mins(q, q, 87.0f, len);
PipeBarrier<PIPE_V>();
Exp(q, q, len);
PipeBarrier<PIPE_V>();
Adds(d, q, 1.0f, len);
PipeBarrier<PIPE_V>();
Div(q, z, d, len);
PipeBarrier<PIPE_V>();
if (packed) Cast(out, q, RoundMode::CAST_RINT, len);
else for (uint32_t r = 0; r < vm; ++r)
Cast(out[r * tileN], q[r * stride], RoundMode::CAST_RINT, stride);
const uint32_t paddedLen = (len + 63) / 64 * 64;
if (paddedLen > len) {
Duplicate(q[len], 0.0f, paddedLen - len);
PipeBarrier<PIPE_V>();
}
auto mask0 = m0b.Get<uint8_t>();
auto mask1 = m1b.Get<uint8_t>();
Duplicate(db.Get<int32_t>(), static_cast<int32_t>(0xf8001fffU), paddedLen);
PipeBarrier<PIPE_V>();
And(cb.Get<uint16_t>(), q.ReinterpretCast<uint16_t>(), db.Get<uint16_t>(), paddedLen * 2);
Duplicate(m0b.Get<uint16_t>(), static_cast<uint16_t>(0), elements / 16 + 16);
Duplicate(m1b.Get<uint16_t>(), static_cast<uint16_t>(0), elements / 16 + 16);
PipeBarrier<PIPE_V>();
Compares(mask0, cb.Get<float>(), 2.00097560882568359375f, CMPMODE::GE, paddedLen);
Compares(mask1, cb.Get<float>(), 2.00097751617431640625f, CMPMODE::LE, paddedLen);
PipeBarrier<PIPE_V>();
And(m0b.Get<uint16_t>(), m0b.Get<uint16_t>(), m1b.Get<uint16_t>(), (paddedLen + 15) / 16);
Abs(d, q, paddedLen);
PipeBarrier<PIPE_V>();
Mins(d, d, 0.00006103515625f, paddedLen);
PipeBarrier<PIPE_V>();
Muls(d, d, 16777216.0f, paddedLen);
PipeBarrier<PIPE_V>();
Cast(cb.Get<int32_t>(), d, RoundMode::CAST_FLOOR, paddedLen);
PipeBarrier<PIPE_V>();
Cast(t, cb.Get<int32_t>(), RoundMode::CAST_RINT, paddedLen);
PipeBarrier<PIPE_V>();
Sub(t, d, t, paddedLen);
PipeBarrier<PIPE_V>();
Adds(t, t, -0.5f, paddedLen);
PipeBarrier<PIPE_V>();
Abs(t, t, paddedLen);
Muls(d, d, 8.0e-6f, paddedLen);
PipeBarrier<PIPE_V>();
Sub(t, t, d, paddedLen);
PipeBarrier<PIPE_V>();
Compares(mask1, t, 0.0f, CMPMODE::LE, paddedLen);
PipeBarrier<PIPE_V>();
Or(m0b.Get<uint16_t>(), m0b.Get<uint16_t>(), m1b.Get<uint16_t>(), (paddedLen + 15) / 16);
const uint32_t maskScalarWords = (len + 63) / 64;
const uint32_t summaryS32Count = maskScalarWords * 2;
const uint32_t summaryCompareCount = (summaryS32Count + 63) / 64 * 64;
PipeBarrier<PIPE_V>();
Compares(m1b.Get<uint8_t>(), m0b.Get<int32_t>(), static_cast<int32_t>(0),
CMPMODE::EQ, summaryCompareCount);
SetFlag<HardEvent::V_S>(EVENT_ID0);
WaitFlag<HardEvent::V_S>(EVENT_ID0);
auto qbits = qb.Get<uint32_t>();
auto outbits = yb.Get<uint16_t>();
auto words = m0b.Get<uint64_t>();
auto wordSummary = m1b.Get<uint64_t>();
for (uint32_t summaryBase = 0; summaryBase < summaryS32Count; summaryBase += 64) {
uint64_t nonzeroSubwords = ~wordSummary.GetValue(summaryBase / 64);
const uint32_t remaining = summaryS32Count - summaryBase;
if (remaining < 64) nonzeroSubwords &= (uint64_t(1) << remaining) - 1;
while (nonzeroSubwords) {
const uint32_t summaryBit = static_cast<uint32_t>(__builtin_ctzll(nonzeroSubwords));
nonzeroSubwords &= ~(uint64_t(3) << (summaryBit & ~uint32_t(1)));
const uint32_t originalWord = (summaryBase + summaryBit) / 2;
const uint32_t base = originalWord * 64;
uint64_t flags = words.GetValue(originalWord);
while (flags) {
const uint32_t bit = static_cast<uint32_t>(__builtin_ctzll(flags));
flags &= flags - 1;
const uint32_t i = base + bit;
if (i >= len || i % stride >= vn) continue;
const uint32_t bits = qbits.GetValue(i);
const uint32_t mag = bits & 0x7fffffff;
if ((bits >> 31) ? (mag < 0x38800000) : (mag >= 0x40000000 || mag < 0x38800000)) {
const float value = z.GetValue(i);
if (value > -8.0f && value < 8.0f)
outbits.SetValue((i / stride) * (packed ? stride : tileN) + i % stride, RefineGeluLarge(value));
}
}
}
}
SetFlag<HardEvent::S_MTE3>(EVENT_ID0);
WaitFlag<HardEvent::S_MTE3>(EVENT_ID0);
SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
const uint32_t rowStride = packed ? stride : tileN;
DataCopyPad(y[uint64_t(row) * plan.n + col], out,
DataCopyExtParams{static_cast<uint16_t>(vm), vn * 2,
(rowStride - (vn + 15) / 16 * 16) / 16, (plan.n - vn) * 2, 0});
PipeBarrier<PIPE_ALL>();
}
uint32_t accumStride;
Params params;
struct { uint32_t n; } plan;
static constexpr uint32_t elements = 8192;
static constexpr uint32_t tileN = 256;
GlobalTensor<float> scale;
GlobalTensor<half> y;
GlobalTensor<int32_t> accum;
Buffer cb, zb, qb, tb, db, sb, yb, hb, m0b, m1b;
};
class FastGeluEpilogue {
public:
using ElementScale = BankStableEpilogue::ElementScale;
using LayoutScale = BankStableEpilogue::LayoutScale;
using ElementD = BankStableEpilogue::ElementD;
using LayoutD = BankStableEpilogue::LayoutD;
using Params = BankStableEpilogue::Params;
__aicore__ __forceinline__ FastGeluEpilogue(Arch::Resource &resource) : fallback(resource) {
Buffer *buffers[] = {&zb,&qb,&tb,&db,&sb,&yb,&m0b,&m1b,&kb};
const uint32_t offsets[] = {0,32768,65536,98304,147456,131072,148480,149504,150528};
for(uint32_t i=0;i<9;++i)
buffers[i]->tensor=resource.ubBuf.GetBufferByByte<uint8_t>(offsets[i]);
inputReuseEvent=static_cast<event_t>(GetTPipePtr()->FetchEventID(HardEvent::V_MTE2));
outputReuseEvent=static_cast<event_t>(GetTPipePtr()->FetchEventID(HardEvent::MTE3_V));
}
__aicore__ __forceinline__ ~FastGeluEpilogue(){Drain();}
__aicore__ __forceinline__ void Drain(){
if(inputPending){WaitFlag<HardEvent::V_MTE2>(inputReuseEvent);inputPending=false;}
if(outputPending){WaitFlag<HardEvent::MTE3_V>(outputReuseEvent);outputPending=false;}
}
__aicore__ __forceinline__ uint64_t GetOverlapCount()const{return overlapCount;}
__aicore__ __forceinline__ void UpdateParams(Params const &p) {
fallback.UpdateParams(p);
plan.n=p.yl.stride(0); scale.SetGlobalBuffer(p.sp); y.SetGlobalBuffer(p.yp);
}
__aicore__ __forceinline__ void operator()(GemmCoord const &shape, GemmCoord const &coord,
GemmCoord const &actual, GlobalTensor<int32_t> const &src, layout::RowMajor const &srcLayout) {
const uint32_t perSub=(actual.m()+1)/2;
const uint32_t first=GetSubBlockIdx()*perSub;
const uint32_t end=first+perSub<actual.m()?first+perSub:actual.m();
const uint32_t count=end>first?end-first:0;
const uint32_t stride=(actual.n()+15)/16*16;
if(count<=32 || count>64){
Drain();
fallback(shape,coord,actual,src,srcLayout);
return;
}
overlapEnabled=count>=48;
if(!overlapEnabled)Drain();
accumStride=srcLayout.stride(0);
accum=src[uint64_t(first)*accumStride];
Compute64(coord.m()*shape.m()+first,coord.n()*shape.n(),count,actual.n());
}
private:
__aicore__ __forceinline__ void Compute64(uint32_t row,uint32_t col,uint32_t vm,uint32_t vn) {
const uint32_t stride=(vn+15)/16*16;
for (uint32_t r0 = 0; r0 < vm; r0 += 32) {
const uint32_t rows = (vm - r0) < 32 ? (vm - r0) : 32;
ComputeChunk(row + r0, col, r0, rows, vn, stride);
}
}
__aicore__ __forceinline__ void ComputeChunk(uint32_t row,uint32_t col,
uint32_t rowOffset,uint32_t vm,uint32_t vn,uint32_t stride) {
const uint32_t e=0, len=vm*stride, dmaStride=(vn+7)/8*8;
auto ci = qb.Get<int32_t>();
auto z = zb.Get<float>();
auto q = qb.Get<float>();
auto s = sb.Get<float>();
auto out = yb.Get<half>();
if(inputPending){WaitFlag<HardEvent::V_MTE2>(inputReuseEvent);inputPending=false;}
if(stride!=dmaStride){Duplicate(ci,static_cast<int32_t>(0),len);Duplicate(s,0.0f,stride);SetFlag<HardEvent::V_MTE2>(EVENT_ID0);WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);}
DataCopyPad(ci, accum[uint64_t(rowOffset) * accumStride],
DataCopyExtParams{static_cast<uint16_t>(vm), vn * 4, (accumStride - vn) * 4, (stride-dmaStride)/8, 0},
DataCopyPadExtParams<int32_t>{true, 0, static_cast<uint8_t>(dmaStride - vn), 0});
DataCopyPad(s, scale[uint64_t(e) * plan.n + col],
DataCopyExtParams{1, vn * 4, 0, 0, 0},
DataCopyPadExtParams<float>{true, 0, static_cast<uint8_t>(dmaStride - vn), 0.0f});
SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
Cast(z, ci, RoundMode::CAST_RINT, len);
PipeBarrier<PIPE_V>();
BinaryRepeatParams br;
br.dstBlkStride = 1; br.src0BlkStride = 1; br.src1BlkStride = 1;
br.dstRepStride = stride / 8; br.src0RepStride = stride / 8; br.src1RepStride = 0;
for (uint32_t c = 0; c < stride; c += 64) {
const uint64_t mask = stride - c < 64 ? stride - c : 64;
Mul(z[c], z[c], s[c], mask, static_cast<uint8_t>(vm), br);
}
PipeBarrier<PIPE_V>();
Mul(q, z, z, len);
PipeBarrier<PIPE_V>();
Muls(q, q, 0.044715f, len);
PipeBarrier<PIPE_V>();
Adds(q, q, 1.0f, len);
PipeBarrier<PIPE_V>();
Mul(q, q, z, len);
PipeBarrier<PIPE_V>();
Muls(q, q, 1.5957691216057308f, len);
PipeBarrier<PIPE_V>();
Muls(q, q, -1.0f, len);
PipeBarrier<PIPE_V>();
Mins(q, q, 87.0f, len);
PipeBarrier<PIPE_V>();
Exp(q, q, len);
PipeBarrier<PIPE_V>();
Adds(q, q, 1.0f, len);
PipeBarrier<PIPE_V>();
Div(q, z, q, len);
PipeBarrier<PIPE_V>();
if(outputPending){WaitFlag<HardEvent::MTE3_V>(outputReuseEvent);outputPending=false;++overlapCount;}
Cast(out,q,RoundMode::CAST_RINT,len);
PipeBarrier<PIPE_V>();
if(overlapEnabled){SetFlag<HardEvent::V_MTE2>(inputReuseEvent);inputPending=true;}
SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
DataCopyPad(y[uint64_t(row)*plan.n+col],out,
DataCopyExtParams{static_cast<uint16_t>(vm),vn*2,
(stride-(vn+15)/16*16)/16,(plan.n-vn)*2,0});
if(overlapEnabled){SetFlag<HardEvent::MTE3_V>(outputReuseEvent);outputPending=true;}
else PipeBarrier<PIPE_ALL>();
}
bool inputPending{false},outputPending{false},overlapEnabled{false};
event_t inputReuseEvent,outputReuseEvent;
uint64_t overlapCount{0};
PackedTailBankStableEpilogue fallback;
uint32_t accumStride;
struct { uint32_t n; } plan;
static constexpr uint32_t elements=16384;
GlobalTensor<float> scale;
GlobalTensor<half> y;
GlobalTensor<int32_t> accum;
Buffer zb,qb,tb,db,sb,yb,m0b,m1b,kb;
};
class DescriptorBankStableEpilogue {
public:
using ElementScale = float;
using LayoutScale = layout::VectorLayout;
using ElementD = half;
using LayoutD = layout::RowMajor;
struct Params {
__gm__ float *sp;
LayoutScale sl;
__gm__ half *yp;
LayoutD yl;
__aicore__ __forceinline__ Params() {}
__aicore__ __forceinline__ Params(__gm__ float *s, LayoutScale a, __gm__ half *y, LayoutD c) :
sp(s), sl(a), yp(y), yl(c) {}
};
__aicore__ __forceinline__ DescriptorBankStableEpilogue(Arch::Resource &resource) {
Buffer *buffers[] = {&cb,&zb,&qb,&tb,&db,&sb,&yb,&m0b,&m1b};
const uint32_t offsets[] = {0,33024,66048,98816,131840,164864,165888,182272,183328};
for(uint32_t i=0;i<9;++i)
buffers[i]->tensor=resource.ubBuf.GetBufferByByte<uint8_t>(offsets[i]);
}
__aicore__ __forceinline__ void UpdateParams(Params const &p) {
params = p;
plan.n = p.yl.stride(0);
scale.SetGlobalBuffer(p.sp);
y.SetGlobalBuffer(p.yp);
}
__aicore__ __forceinline__ void operator()(GemmCoord const &shape, GemmCoord const &coord,
GemmCoord const &actual, GlobalTensor<int32_t> const &src,
layout::RowMajor const &srcLayout) {
accumStride = srcLayout.stride(0);
const uint32_t perSub = (actual.m() + 1) / 2;
const uint32_t first = GetSubBlockIdx() * perSub;
const uint32_t end = first + perSub < actual.m() ? first + perSub : actual.m();
for (uint32_t local = first; local < end; local += 32) {
const uint32_t count = end - local < 32 ? end - local : 32;
accum = src[uint64_t(local) * srcLayout.stride(0)];
Compute(0, coord.m() * shape.m() + local, coord.n() * shape.n(), count, actual.n());
}
}
private:
__aicore__ __forceinline__ static uint16_t RefineGeluLarge(float x) { return gmg::RefineGeluLarge(x); }
__aicore__ __forceinline__ void Compute(uint32_t e, uint32_t row, uint32_t col,
uint32_t vm, uint32_t vn) {
const uint32_t stride = (vn + 7) / 8 * 8;
const bool packed = stride % 16 == 0;
const uint32_t len = vm * stride;
auto ci = cb.Get<int32_t>();
auto z = zb.Get<float>();
auto q = qb.Get<float>();
auto t = tb.Get<float>();
auto d = db.Get<float>();
auto s = sb.Get<float>();
auto out = yb.Get<half>();
DataCopyPad(ci, accum,
DataCopyExtParams{static_cast<uint16_t>(vm), vn * 4, (accumStride - vn) * 4, 0, 0},
DataCopyPadExtParams<int32_t>{true, 0, static_cast<uint8_t>(stride - vn), 0});
DataCopyPad(s, scale[uint64_t(e) * plan.n + col],
DataCopyExtParams{1, vn * 4, 0, 0, 0},
DataCopyPadExtParams<float>{true, 0, static_cast<uint8_t>(stride - vn), 0.0f});
SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
Cast(z, ci, RoundMode::CAST_RINT, len);
PipeBarrier<PIPE_V>();
BinaryRepeatParams br;
br.dstBlkStride = 1; br.src0BlkStride = 1; br.src1BlkStride = 1;
br.dstRepStride = stride / 8; br.src0RepStride = stride / 8; br.src1RepStride = 0;
for (uint32_t col = 0; col < stride; col += 64) {
const uint64_t mask = stride - col < 64 ? stride - col : 64;
Mul(z[col], z[col], s[col], mask, static_cast<uint8_t>(vm), br);
}
PipeBarrier<PIPE_V>();
Mul(q, z, z, len);
PipeBarrier<PIPE_V>();
Muls(q, q, 0.044715f, len);
PipeBarrier<PIPE_V>();
Adds(q, q, 1.0f, len);
PipeBarrier<PIPE_V>();
Mul(q, q, z, len);
PipeBarrier<PIPE_V>();
Muls(q, q, 1.5957691216057308f, len);
PipeBarrier<PIPE_V>();
Muls(q, q, -1.0f, len);
PipeBarrier<PIPE_V>();
Mins(q, q, 87.0f, len);
PipeBarrier<PIPE_V>();
Exp(q, q, len);
PipeBarrier<PIPE_V>();
Adds(d, q, 1.0f, len);
PipeBarrier<PIPE_V>();
Div(q, z, d, len);
PipeBarrier<PIPE_V>();
if (packed) Cast(out, q, RoundMode::CAST_RINT, len);
else for (uint32_t r = 0; r < vm; ++r)
Cast(out[r * tileN], q[r * stride], RoundMode::CAST_RINT, stride);
const uint32_t paddedLen = (len + 63) / 64 * 64;
if (paddedLen > len) {
Duplicate(q[len], 0.0f, paddedLen - len);
PipeBarrier<PIPE_V>();
}
auto mask0 = m0b.Get<uint8_t>();
auto mask1 = m1b.Get<uint8_t>();
Duplicate(db.Get<int32_t>(), static_cast<int32_t>(0xf8001fffU), paddedLen);
PipeBarrier<PIPE_V>();
And(cb.Get<uint16_t>(), q.ReinterpretCast<uint16_t>(), db.Get<uint16_t>(), paddedLen * 2);
Duplicate(m0b.Get<uint16_t>(), static_cast<uint16_t>(0), elements / 16 + 16);
Duplicate(m1b.Get<uint16_t>(), static_cast<uint16_t>(0), elements / 16 + 16);
PipeBarrier<PIPE_V>();
Compares(mask0, cb.Get<float>(), 2.00097560882568359375f, CMPMODE::GE, paddedLen);
Compares(mask1, cb.Get<float>(), 2.00097751617431640625f, CMPMODE::LE, paddedLen);
PipeBarrier<PIPE_V>();
And(m0b.Get<uint16_t>(), m0b.Get<uint16_t>(), m1b.Get<uint16_t>(), (paddedLen + 15) / 16);
auto absq = cb.Get<float>();
Abs(absq, q, paddedLen);
PipeBarrier<PIPE_V>();
Mins(t, absq, 0.00006103515625f, paddedLen);
PipeBarrier<PIPE_V>();
Adds(t, t, 0.00006103515625f, paddedLen);
PipeBarrier<PIPE_V>();
And(t.ReinterpretCast<uint16_t>(), t.ReinterpretCast<uint16_t>(), db.Get<uint16_t>(), paddedLen * 2);
PipeBarrier<PIPE_V>();
Adds(t, t, -3.053247928619384765625e-05f, paddedLen);
PipeBarrier<PIPE_V>();
Abs(t, t, paddedLen);
PipeBarrier<PIPE_V>();
Compares(mask1, t, 2.47382558882236480712890625e-10f, CMPMODE::LE, paddedLen);
PipeBarrier<PIPE_V>();
Or(m0b.Get<uint16_t>(), m0b.Get<uint16_t>(), m1b.Get<uint16_t>(), (paddedLen + 15) / 16);
const uint32_t maskScalarWords = (len + 63) / 64;
const uint32_t summaryS32Count = maskScalarWords * 2;
const uint32_t summaryCompareCount = (summaryS32Count + 63) / 64 * 64;
PipeBarrier<PIPE_V>();
Compares(m1b.Get<uint8_t>(), m0b.Get<int32_t>(), static_cast<int32_t>(0),
CMPMODE::EQ, summaryCompareCount);
SetFlag<HardEvent::V_S>(EVENT_ID0);
WaitFlag<HardEvent::V_S>(EVENT_ID0);
auto qbits = qb.Get<uint32_t>();
auto outbits = yb.Get<uint16_t>();
auto words = m0b.Get<uint64_t>();
auto wordSummary = m1b.Get<uint64_t>();
for (uint32_t summaryBase = 0; summaryBase < summaryS32Count; summaryBase += 64) {
uint64_t nonzeroSubwords = ~wordSummary.GetValue(summaryBase / 64);
const uint32_t remaining = summaryS32Count - summaryBase;
if (remaining < 64) nonzeroSubwords &= (uint64_t(1) << remaining) - 1;
while (nonzeroSubwords) {
const uint32_t summaryBit = static_cast<uint32_t>(__builtin_ctzll(nonzeroSubwords));
nonzeroSubwords &= ~(uint64_t(3) << (summaryBit & ~uint32_t(1)));
const uint32_t originalWord = (summaryBase + summaryBit) / 2;
const uint32_t base = originalWord * 64;
uint64_t flags = words.GetValue(originalWord);
while (flags) {
const uint32_t bit = static_cast<uint32_t>(__builtin_ctzll(flags));
flags &= flags - 1;
const uint32_t i = base + bit;
if (i >= len || i % stride >= vn) continue;
const uint32_t bits = qbits.GetValue(i);
const uint32_t mag = bits & 0x7fffffff;
if (mag < 0x38800000U) {
gmg::FloatBits magnitude; magnitude.u = mag;
const float units = gmg::RMul(magnitude.f, 16777216.0f);
const float floorUnits = static_cast<float>(static_cast<int32_t>(units));
const float fraction = gmg::RAdd(units, -floorUnits);
float distance = gmg::RAdd(fraction, -0.5f);
if (distance < 0.0f) distance = -distance;
if (gmg::RAdd(distance, -gmg::RMul(units, 8.0e-6f)) > 0.0f) continue;
}
if ((bits >> 31) ? (mag < 0x38800000) : (mag >= 0x40000000 || mag < 0x38800000)) {
const float value = z.GetValue(i);
if (value > -8.0f && value < 8.0f)
outbits.SetValue((i / stride) * (packed ? stride : tileN) + i % stride, RefineGeluLarge(value));
}
}
}
}
SetFlag<HardEvent::S_MTE3>(EVENT_ID0);
WaitFlag<HardEvent::S_MTE3>(EVENT_ID0);
SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
const uint32_t rowStride = packed ? stride : tileN;
DataCopyPad(y[uint64_t(row) * plan.n + col], out,
DataCopyExtParams{static_cast<uint16_t>(vm), vn * 2,
(rowStride - (vn + 15) / 16 * 16) / 16, (plan.n - vn) * 2, 0});
PipeBarrier<PIPE_ALL>();
}
uint32_t accumStride;
Params params;
struct { uint32_t n; } plan;
static constexpr uint32_t elements = 8192;
static constexpr uint32_t tileN = 256;
GlobalTensor<float> scale;
GlobalTensor<half> y;
GlobalTensor<int32_t> accum;
Buffer cb, zb, qb, tb, db, sb, yb, hb, m0b, m1b;
};
class DescriptorBase64IntervalEpilogue {
public:
using ElementScale = DescriptorBankStableEpilogue::ElementScale;
using LayoutScale = DescriptorBankStableEpilogue::LayoutScale;
using ElementD = DescriptorBankStableEpilogue::ElementD;
using LayoutD = DescriptorBankStableEpilogue::LayoutD;
using Params = DescriptorBankStableEpilogue::Params;
__aicore__ __forceinline__ DescriptorBase64IntervalEpilogue(Arch::Resource &resource) : fallback(resource) {
Buffer *buffers[] = {&zb,&qb,&tb,&db,&sb,&yb,&m0b,&m1b,&kb};
const uint32_t offsets[] = {0,65792,0,65792,164608,131328,165632,167712,169792};
for(uint32_t i=0;i<9;++i)
buffers[i]->tensor=resource.ubBuf.GetBufferByByte<uint8_t>(offsets[i]);
}
__aicore__ __forceinline__ void UpdateParams(Params const &p) {
fallback.UpdateParams(p);
plan.n=p.yl.stride(0); scale.SetGlobalBuffer(p.sp); y.SetGlobalBuffer(p.yp);
}
__aicore__ __forceinline__ void operator()(GemmCoord const &shape, GemmCoord const &coord,
GemmCoord const &actual, GlobalTensor<int32_t> const &src, layout::RowMajor const &srcLayout) {
const uint32_t perSub=(actual.m()+1)/2;
const uint32_t first=GetSubBlockIdx()*perSub;
const uint32_t end=first+perSub<actual.m()?first+perSub:actual.m();
const uint32_t count=end>first?end-first:0;
const uint32_t stride=(actual.n()+7)/8*8;
if(count<=32 || count>64 || stride%16!=0){
fallback(shape,coord,actual,src,srcLayout);
return;
}
accumStride=srcLayout.stride(0);
accum=src[uint64_t(first)*accumStride];
Compute64(coord.m()*shape.m()+first,coord.n()*shape.n(),count,actual.n());
}
private:
__aicore__ __forceinline__ void Compute64(uint32_t row,uint32_t col,uint32_t vm,uint32_t vn) {
const uint32_t e=0, stride=(vn+7)/8*8, len=vm*stride;
auto ci = qb.Get<int32_t>();
auto z = zb.Get<float>();
auto q = qb.Get<float>();
auto s = sb.Get<float>();
auto out = yb.Get<half>();
DataCopyPad(ci, accum,
DataCopyExtParams{static_cast<uint16_t>(vm), vn * 4, (accumStride - vn) * 4, 0, 0},
DataCopyPadExtParams<int32_t>{true, 0, static_cast<uint8_t>(stride - vn), 0});
DataCopyPad(s, scale[uint64_t(e) * plan.n + col],
DataCopyExtParams{1, vn * 4, 0, 0, 0},
DataCopyPadExtParams<float>{true, 0, static_cast<uint8_t>(stride - vn), 0.0f});
SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
Cast(z, ci, RoundMode::CAST_RINT, len);
PipeBarrier<PIPE_V>();
BinaryRepeatParams br;
br.dstBlkStride = 1; br.src0BlkStride = 1; br.src1BlkStride = 1;
br.dstRepStride = stride / 8; br.src0RepStride = stride / 8; br.src1RepStride = 0;
for (uint32_t col = 0; col < stride; col += 64) {
const uint64_t mask = stride - col < 64 ? stride - col : 64;
Mul(z[col], z[col], s[col], mask, static_cast<uint8_t>(vm), br);
}
PipeBarrier<PIPE_V>();
Mul(q, z, z, len);
PipeBarrier<PIPE_V>();
Muls(q, q, 0.044715f, len);
PipeBarrier<PIPE_V>();
Adds(q, q, 1.0f, len);
PipeBarrier<PIPE_V>();
Mul(q, q, z, len);
PipeBarrier<PIPE_V>();
Muls(q, q, 1.5957691216057308f, len);
PipeBarrier<PIPE_V>();
Muls(q, q, -1.0f, len);
PipeBarrier<PIPE_V>();
Mins(q, q, 87.0f, len);
PipeBarrier<PIPE_V>();
Exp(q, q, len);
PipeBarrier<PIPE_V>();
Adds(q, q, 1.0f, len);
PipeBarrier<PIPE_V>();
Div(q, z, q, len);
PipeBarrier<PIPE_V>();
Cast(out,q,RoundMode::CAST_RINT,len);
PipeBarrier<PIPE_V>();
SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
DataCopyPad(y[uint64_t(row)*plan.n+col],out,
DataCopyExtParams{static_cast<uint16_t>(vm),vn*2,
(stride-(vn+15)/16*16)/16,(plan.n-vn)*2,0});
PipeBarrier<PIPE_ALL>();
}
DescriptorBankStableEpilogue fallback;
uint32_t accumStride;
struct { uint32_t n; } plan;
static constexpr uint32_t elements=16384;
GlobalTensor<float> scale;
GlobalTensor<half> y;
GlobalTensor<int32_t> accum;
Buffer zb,qb,tb,db,sb,yb,m0b,m1b,kb;
};
using Tile = GemmShape<128, 256, 512>;
using L0Tile = GemmShape<128, 256, 128>;
using Mmad = DirectInt8Block<Tile, L0Tile>;
struct BAsymmetricKMmad : public Mmad {
using Mmad::Mmad;
__aicore__ inline void operator()(
AscendC::GlobalTensor<ElementA> const &gmA,LayoutA const &layoutA,
AscendC::GlobalTensor<ElementB> const &gmB,LayoutB const &layoutB,
AscendC::GlobalTensor<ElementC> const &gmC,LayoutC const &layoutC,
direct_core::GemmCoord const &actualShape){
using namespace direct_core;
const uint32_t mr=RoundUp<16>(actualShape.m());
const uint32_t nr=RoundUp<32>(actualShape.n());
const uint32_t parts=CeilDiv<128>(actualShape.k());
auto aL1=LayoutAInL1::template MakeLayout<ElementA>(128,512);
auto bL1=LayoutBInL1::template MakeLayout<ElementB>(128,256);
auto cL0=LayoutCInL0::MakeLayoutInL0C(MakeCoord(mr,nr));
AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(l1AEventList[0]);
copyGmToL1A(l1ATensorList[0],gmA,aL1,layoutA.GetTileLayout(MakeCoord(actualShape.m(),min(actualShape.k(),512U))));
AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(l1AEventList[0]);
AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(l1BEventList[0]);
copyGmToL1B(l1BTensorList[0],gmB,bL1,layoutB.GetTileLayout(MakeCoord(min(actualShape.k(),128U),actualShape.n())));
AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(l1BEventList[0]);
AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(EVENT_ID0);
for(uint32_t j=0;j<parts;++j){
const uint32_t slab=j/4,as=slab&1,bs=j&1;
if(j+1<parts){
const uint32_t next=bs^1,begin=(j+1)*128,count=min(actualShape.k()-begin,128U);
AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(l1BEventList[next]);
auto gb=gmB[layoutB.GetOffset(MatrixCoord{begin,uint32_t(0)})];
copyGmToL1B(l1BTensorList[next],gb,bL1,layoutB.GetTileLayout(MakeCoord(count,actualShape.n())));
AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(l1BEventList[next]);
}
if((j&3)==2 && uint64_t(slab+1)*512<actualShape.k()){
const uint32_t next=as^1,begin=(slab+1)*512,count=min(actualShape.k()-begin,512U);
AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(l1AEventList[next]);
auto ga=gmA[layoutA.GetOffset(MatrixCoord{uint32_t(0),begin})];
copyGmToL1A(l1ATensorList[next],ga,aL1,layoutA.GetTileLayout(MakeCoord(actualShape.m(),count)));
AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(l1AEventList[next]);
}
const uint32_t ka=min(actualShape.k()-j*128,128U);
auto aL0=LayoutAInL0::template MakeLayout<ElementA>(mr,ka);
auto bL0=LayoutBInL0::template MakeLayout<ElementB>(ka,nr);
auto a=l0ATensorList[l0AListId],b=l0BTensorList[l0BListId];
AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(l0AEventList[l0AListId]);
if((j&3)==0)AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(l1AEventList[as]);
auto aPart=l1ATensorList[as][aL1.GetOffset(MatrixCoord{uint32_t(0),(j&3)*128})];
copyL1ToL0A(a,aPart,aL0,aL1);
if((j&3)==3 || j+1==parts)AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(l1AEventList[as]);
AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(l0BEventList[l0BListId]);
AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(l1BEventList[bs]);
copyL1ToL0B(b,l1BTensorList[bs],bL0,bL1);
AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(l1BEventList[bs]);
AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID0);
AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID0);
tileMmad(l0CTensor,a,b,mr,nr,ka,j==0,0);
AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(l0AEventList[l0AListId]);
AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(l0BEventList[l0BListId]);
l0AListId^=1;l0BListId^=1;
}
auto cBlock=layoutC.GetTileLayout(actualShape.GetCoordMN());
AscendC::SetFlag<AscendC::HardEvent::M_FIX>(EVENT_ID0);
AscendC::WaitFlag<AscendC::HardEvent::M_FIX>(EVENT_ID0);
copyL0CToGm(gmC,l0CTensor,cBlock,cL0);
AscendC::SetFlag<AscendC::HardEvent::FIX_M>(EVENT_ID0);
}
};
using GroupedKernel = DirectGrouped<
Mmad, StableEpilogue>;
using BankGroupedKernel=DirectGrouped<
BAsymmetricKMmad,Base64IntervalEpilogue>;
using DescriptorStreamKernel=DescriptorGrouped<
Mmad,DescriptorBase64IntervalEpilogue>;
struct BalancedRotationPlan { uint32_t lowerRows, upperRows, rotationLow, rotationHigh; };
using BalancedRotationKernel = RotationGrouped<
Mmad, StableEpilogue>;
using BankBalancedRotationKernel = RotationGrouped<
Mmad, Base64IntervalEpilogue>;
using C224K640Tile = GemmShape<128, 256, 640>;
using C224K640Mmad = DirectInt8Block<C224K640Tile, L0Tile>;
using C224K640BankKernel = DirectGrouped<
C224K640Mmad, Base64IntervalEpilogue>;
using C224K640BankBalancedRotationKernel = RotationGrouped<
C224K640Mmad, Base64IntervalEpilogue>;
}
namespace small_raw_r14 {
using namespace AscendC;
struct Plan { uint32_t m,n,k,paddedM; uint64_t ffts; };
class SingleMmad {
public:
__aicore__ __forceinline__ void Run(GM_ADDR xp,GM_ADDR wp,GM_ADDR cp,
Plan const &p,TPipe *pipe) {
pipe->InitBuffer(ab,p.paddedM*p.k);
pipe->InitBuffer(bb,p.k*p.n);
pipe->InitBuffer(a2b,p.paddedM*p.k);
pipe->InitBuffer(b2b,p.k*p.n);
pipe->InitBuffer(cb,p.paddedM*p.n*sizeof(int32_t));
auto a1=ab.Get<int8_t>();auto b1=bb.Get<int8_t>();
auto a2=a2b.Get<int8_t>();auto b2=b2b.Get<int8_t>();auto c1=cb.Get<int32_t>();
GlobalTensor<int8_t> x,w;
x.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(xp),uint64_t(p.m)*p.k);
w.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(wp),uint64_t(p.k)*p.n);
GlobalTensor<int32_t> c;
c.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(cp),uint64_t(p.m)*p.n);
if(p.m!=p.paddedM){
InitConstValue(a1.ReinterpretCast<uint32_t>(),InitConstValueParams<uint32_t>{
1,static_cast<uint16_t>(p.paddedM*p.k/32),0,0U});
PipeBarrier<PIPE_ALL>();
}
Nd2NzParams ac{};
ac.ndNum=1;ac.nValue=p.m;ac.dValue=p.k;ac.srcDValue=p.k;
ac.dstNzC0Stride=p.paddedM;ac.dstNzNStride=1;
DataCopy(a1,x,ac);
Nd2NzParams bc{};
bc.ndNum=1;bc.nValue=p.k;bc.dValue=p.n;bc.srcDValue=p.n;
bc.dstNzC0Stride=p.k;bc.dstNzNStride=1;
DataCopy(b1,w,bc);
Fence<HardEvent::MTE2_MTE1>();
const uint32_t mb=p.paddedM/16,kb=p.k/32;
LoadData2DParams la{};
la.repeatTimes=static_cast<uint8_t>(kb);la.srcStride=static_cast<uint16_t>(mb);
la.ifTranspose=false;
for(uint32_t i=0;i<mb;++i)
LoadData(a2[i*kb*512],a1[i*512],la);
LoadData2dTransposeParams lb{};
lb.repeatTimes=static_cast<uint8_t>(p.n/32);lb.srcStride=static_cast<uint16_t>(kb);
lb.dstGap=1;lb.dstFracGap=0;
for(uint32_t i=0;i<kb;++i)
LoadDataWithTranspose(b2[i*p.n*32],b1[i*1024],lb);
Fence<HardEvent::MTE1_M>();
MmadParams mm{};
mm.m=static_cast<uint16_t>(p.paddedM);mm.n=static_cast<uint16_t>(p.n);
mm.k=static_cast<uint16_t>(p.k);mm.cmatrixInitVal=true;
Mmad(c1,a2,b2,mm);
Fence<HardEvent::M_FIX>();
FixpipeParamsV220 fp{};
fp.nSize=static_cast<uint16_t>(p.n);fp.mSize=static_cast<uint16_t>(p.m);
fp.srcStride=static_cast<uint16_t>(p.paddedM);fp.dstStride=p.n;fp.ndNum=1;
fp.quantPre=QuantMode_t::NoQuant;
Fixpipe<int32_t,int32_t,CFG_ROW_MAJOR>(c,c1,fp);
CrossCoreSetFlag<2,PIPE_FIX>(8);
CrossCoreWaitFlag(9);
PipeBarrier<PIPE_ALL>();
}
private:
template<HardEvent E> __aicore__ __forceinline__ void Fence() {
const auto id=GetTPipePtr()->FetchEventID(E);SetFlag<E>(id);WaitFlag<E>(id);
}
TBuf<TPosition::A1> ab;TBuf<TPosition::B1> bb;
TBuf<TPosition::A2> a2b;TBuf<TPosition::B2> b2b;TBuf<TPosition::CO1> cb;
};
}
extern "C" __global__ __aicore__ void grouped_matmul_gelu_small_raw_single(
GM_ADDR xp,GM_ADDR wp,GM_ADDR sp,GM_ADDR yp,GM_ADDR cp,small_raw_r14::Plan p) {
KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
AscendC::SetSyncBaseAddr(p.ffts);
if ASCEND_IS_AIC {
AscendC::TPipe pipe;
small_raw_r14::SingleMmad op;op.Run(xp,wp,cp,p,&pipe);
}
if ASCEND_IS_AIV {
direct_core::Arch::Resource resource;
public_gmg::BankStableEpilogue op(resource);
public_gmg::BankStableEpilogue::Params params{
reinterpret_cast<__gm__ float*>(sp),direct_core::layout::VectorLayout{p.n},
reinterpret_cast<__gm__ half*>(yp),direct_core::layout::RowMajor{p.m,p.n}};
op.UpdateParams(params);
AscendC::GlobalTensor<int32_t> c;
c.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(cp),uint64_t(p.m)*p.n);
const direct_core::GemmCoord shape{p.paddedM,p.n,p.k},coord{0,0,0},actual{p.m,p.n,p.k};
const direct_core::layout::RowMajor cl{p.m,p.n};
AscendC::CrossCoreWaitFlag(8);
op(shape,coord,actual,c,cl);
AscendC::CrossCoreSetFlag<2,PIPE_MTE3>(9);
AscendC::PipeBarrier<PIPE_ALL>();
}
}
extern "C" __global__ __aicore__ void grouped_matmul_gelu_small_raw_row_parallel(
GM_ADDR xp,GM_ADDR wp,GM_ADDR sp,GM_ADDR yp,GM_ADDR cp,small_raw_r14::Plan p) {
KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
AscendC::SetSyncBaseAddr(p.ffts);
if ASCEND_IS_AIC {
const uint32_t group=AscendC::GetBlockIdx();
const uint32_t row=group*16;
const uint32_t rows=p.m-row<16?p.m-row:16;
const small_raw_r14::Plan tile{rows,p.n,p.k,16,p.ffts};
AscendC::TPipe pipe;
small_raw_r14::SingleMmad op;
op.Run(xp+uint64_t(row)*p.k,wp,
cp+uint64_t(row)*p.n*sizeof(int32_t),tile,&pipe);
}
if ASCEND_IS_AIV {
const uint32_t group=AscendC::GetBlockIdx()/AscendC::GetSubBlockNum();
const uint32_t row=group*16;
const uint32_t rows=p.m-row<16?p.m-row:16;
direct_core::Arch::Resource resource;
public_gmg::SmallRawOwnedMaskEpilogue op(resource);
public_gmg::SmallRawOwnedMaskEpilogue::Params params{
reinterpret_cast<__gm__ float*>(sp),direct_core::layout::VectorLayout{p.n},
reinterpret_cast<__gm__ half*>(yp)+uint64_t(row)*p.n,
direct_core::layout::RowMajor{rows,p.n}};
op.UpdateParams(params);
AscendC::GlobalTensor<int32_t> c;
c.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(cp)+uint64_t(row)*p.n,
uint64_t(rows)*p.n);
const direct_core::GemmCoord shape{16,p.n,p.k},coord{0,0,0},actual{rows,p.n,p.k};
const direct_core::layout::RowMajor cl{rows,p.n};
AscendC::CrossCoreWaitFlag(8);
op(shape,coord,actual,c,cl);
AscendC::CrossCoreSetFlag<2,PIPE_MTE3>(9);
AscendC::PipeBarrier<PIPE_ALL>();
}
}
extern "C" __global__ __aicore__ void grouped_matmul_gelu_v0(
GM_ADDR x, GM_ADDR w, GM_ADDR scale, GM_ADDR groups, GM_ADDR y,
GM_ADDR scratch, GM_ADDR sys, uint64_t sysPerCore, gmg::Plan plan) {
KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
if (plan.backend == 1) {
AscendC::SetSyncBaseAddr(plan.ffts);
public_gmg::GroupedKernel::Params params{
direct_core::GemmCoord{plan.m, plan.n, plan.k}, plan.e, groups,
x, direct_core::layout::RowMajor{plan.m, plan.k},
w, direct_core::layout::RowMajor{plan.k, plan.n},
scale, direct_core::layout::VectorLayout{plan.n},
y, direct_core::layout::RowMajor{plan.m, plan.n}, scratch};
public_gmg::GroupedKernel op;
op(params);
return;
}
AscendC::InitSocState();
uint32_t core = AscendC::GetBlockIdx();
if ASCEND_IS_AIV { core /= 2; }
GM_ADDR ws = sys + uint64_t(core) * sysPerCore;
AscendC::SetSysWorkspaceForce(ws);
AscendC::clearWorkspace(ws);
AscendC::TPipe pipe;
gmg::Kernel op;
REGIST_MATMUL_OBJ(&pipe, ws, op.mm, &plan.cube);
op.Init(x, w, scale, groups, y, scratch, plan, pipe);
op.Process();
}
namespace b_k32_ndpack_private {
using namespace direct_core;
struct PackedK32N256 {
template<class T> DIRECT_DEVICE static PackedK32N256 MakeLayout(uint32_t, uint32_t) {
static_assert(sizeof(T)==1, "INT8 only");
return {};
}
};
struct CopyGmB {
using LayoutDst=PackedK32N256;
using LayoutSrc=layout::RowMajor;
DIRECT_DEVICE void operator()(AscendC::LocalTensor<int8_t> const &dst,
AscendC::GlobalTensor<int8_t> const &src, LayoutDst const &, LayoutSrc const &ls) {
AscendC::Nd2NzParams p;
p.ndNum=static_cast<uint16_t>(ls.shape(0)/32);
p.nValue=32; p.dValue=256;
p.srcDValue=static_cast<uint16_t>(ls.stride(0));
p.srcNdMatrixStride=static_cast<uint16_t>(32*ls.stride(0));
p.dstNzC0Stride=32;
p.dstNzNStride=1;
p.dstNzMatrixStride=8192;
AscendC::DataCopy(dst,src,p);
}
};
struct CopyL0B {
using LayoutSrc=PackedK32N256;
using LayoutDst=layout::L0BTile;
DIRECT_DEVICE void operator()(AscendC::LocalTensor<int8_t> const &dst,
AscendC::LocalTensor<int8_t> const &src, LayoutDst const &ld, LayoutSrc const &) {
AscendC::LoadData2dTransposeParams p;
p.startIndex=0;
p.repeatTimes=static_cast<uint8_t>((ld.rows/32)*8);
p.srcStride=1;
p.dstGap=1; p.dstFracGap=0; p.addrMode=0;
AscendC::LoadDataWithTranspose(dst,src,p);
}
};
struct CopyGmA {
using Parent = ops::Int8GmToL1;
using LayoutDst = typename Parent::LayoutDst;
using LayoutSrc = typename Parent::LayoutSrc;
DIRECT_DEVICE void operator()(AscendC::LocalTensor<int8_t> const &dst,
AscendC::GlobalTensor<int8_t> const &src, LayoutDst const &ld,
LayoutSrc const &ls, bool raw) {
if (!raw) { Parent{}(dst, src, ld, ls); return; }
AscendC::DataCopyParams cp;
cp.blockCount = static_cast<uint16_t>(ls.shape(0));
cp.blockLen = static_cast<uint16_t>(ls.shape(1) / 32);
cp.srcStride = static_cast<uint16_t>((ls.stride(0) - ls.shape(1)) / 32);
cp.dstStride = static_cast<uint16_t>((512 - ls.shape(1)) / 32);
AscendC::DataCopy(dst, src, cp);
}
};
constexpr bool kReuseRawA3DConfig = true;
constexpr AscendC::IsResetLoad3dConfig kRetainRawA3DConfig{false, false};
struct CopyL0A {
bool rawConfigInitialized{false};
using Parent = ops::Int8L1ToL0A;
using LayoutDst = typename Parent::LayoutDst;
using LayoutSrc = typename Parent::LayoutSrc;
DIRECT_DEVICE void operator()(AscendC::LocalTensor<int8_t> const &dst,
AscendC::LocalTensor<int8_t> const &src, LayoutDst const &ld,
LayoutSrc const &ls, uint32_t kStart, bool raw) {
if (!raw) { Parent{}(dst, src, ld, ls); return; }
AscendC::LoadData3DParamsV2<int8_t> p;
p.l1H = 128; p.l1W = 16; p.channelSize = 32;
p.filterH = 1; p.filterW = 16;
p.strideH = 1; p.strideW = 16;
p.mExtension = static_cast<uint16_t>(ld.rows);
p.kExtension = static_cast<uint16_t>(ld.cols);
p.mStartPt = 0; p.kStartPt = static_cast<uint16_t>(kStart);
if (!kReuseRawA3DConfig || !rawConfigInitialized) {
AscendC::LoadDataRepeatParam repeat;
AscendC::SetLoadDataRepeat(repeat);
AscendC::LoadData(dst, src, p);
rawConfigInitialized = true;
} else {
AscendC::LoadData<int8_t, kRetainRawA3DConfig>(dst, src, p);
}
}
};
}
namespace direct_core {
template<class L1TileShape_, class L0TileShape_>
struct BK32PackBlock {
public:
using ArchTag = Arch::AtlasA2;
using L1TileShape = L1TileShape_;
using L0TileShape = L0TileShape_;
using ElementA = int8_t;
using ElementB = int8_t;
using ElementC = int32_t;
using ElementAccumulator = int32_t;
using LayoutA = layout::RowMajor;
using LayoutB = layout::RowMajor;
using LayoutC = layout::RowMajor;
using TileMmad = ops::Int8Mmad;
using CopyGmToL1A = b_k32_ndpack_private::CopyGmA;
using CopyGmToL1B = b_k32_ndpack_private::CopyGmB;
using CopyL1ToL0A = b_k32_ndpack_private::CopyL0A;
using CopyL1ToL0B = b_k32_ndpack_private::CopyL0B;
using CopyL0CToGm = ops::Int32L0CToGm;
using LayoutAInL1 = typename CopyL1ToL0A::LayoutSrc;
using LayoutBInL1 = typename CopyL1ToL0B::LayoutSrc;
using LayoutAInL0 = typename CopyL1ToL0A::LayoutDst;
using LayoutBInL0 = typename CopyL1ToL0B::LayoutDst;
using LayoutCInL0 = layout::Accumulator;
static constexpr uint32_t STAGES = 2;
static constexpr bool PREFETCH_INITIAL_HEAD = true;
static constexpr uint32_t L1A_SIZE = L1TileShape::M * L1TileShape::K * sizeof(ElementA);
static constexpr uint32_t L1B_SIZE = L1TileShape::N * L1TileShape::K * sizeof(ElementB);
static constexpr uint32_t L0A_SIZE = ArchTag::L0A_SIZE;
static constexpr uint32_t L0B_SIZE = ArchTag::L0B_SIZE;
static constexpr uint32_t L0C_SIZE = ArchTag::L0C_SIZE;
static constexpr uint32_t L0A_PINGPONG_BUF_SIZE = L0A_SIZE / STAGES;
static constexpr uint32_t L0B_PINGPONG_BUF_SIZE = L0B_SIZE / STAGES;
static_assert(direct_core::is_same_v<LayoutC, layout::RowMajor>, "LayoutC only support RowMajor yet!");
static_assert((L1A_SIZE * STAGES + L1B_SIZE * STAGES) <= ArchTag::L1_SIZE, "L1TileShape exceeding the L1 space!");
static constexpr uint32_t L0A_TILE_SIZE = L0TileShape::M * L0TileShape::K * sizeof(ElementA);
static constexpr uint32_t L0B_TILE_SIZE = L0TileShape::K * L0TileShape::N * sizeof(ElementB);
static constexpr uint32_t L0C_TILE_SIZE = L0TileShape::M * L0TileShape::N * sizeof(ElementAccumulator);
static_assert((L0A_TILE_SIZE * STAGES) <= L0A_SIZE, "L0TileShape exceeding the L0A space!");
static_assert((L0B_TILE_SIZE * STAGES) <= L0B_SIZE, "L0TileShape exceeding the L0B space!");
static_assert(L0C_TILE_SIZE <= L0C_SIZE, "L0TileShape exceeding the L0C space!");
static_assert(L1TileShape::M == L0TileShape::M && L1TileShape::N == L0TileShape::N,
"The situation where the basic blocks of L1 and L0 differ on the m and n axes is not supported yet");
static_assert(L0TileShape::K <= L1TileShape::K, "L0TileShape::K cannot exceed L1TileShape::K");
DIRECT_DEVICE
BK32PackBlock(Arch::Resource &resource, uint32_t l1BufAddrStart = 0)
{
uint32_t l1AOffset = l1BufAddrStart;
uint32_t l1BOffset = l1BufAddrStart + L1A_SIZE * STAGES;
for (uint32_t i = 0; i < STAGES; i++) {
l1ATensorList[i] = resource.l1Buf.template GetBufferByByte<ElementA>(l1AOffset + L1A_SIZE * i);
l1BTensorList[i] = resource.l1Buf.template GetBufferByByte<ElementB>(l1BOffset + L1B_SIZE * i);
l0ATensorList[i] = resource.l0ABuf.template GetBufferByByte<ElementA>(L0A_PINGPONG_BUF_SIZE * i);
l0BTensorList[i] = resource.l0BBuf.template GetBufferByByte<ElementB>(L0B_PINGPONG_BUF_SIZE * i);
l1AEventList[i] = i;
l1BEventList[i] = i + STAGES;
l0AEventList[i] = i;
l0BEventList[i] = i + STAGES;
AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(l1AEventList[i]);
AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(l1BEventList[i]);
AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(l0AEventList[i]);
AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(l0BEventList[i]);
}
l0CTensor = resource.l0CBuf.template GetBufferByByte<ElementAccumulator>(0);
AscendC::SetFlag<AscendC::HardEvent::FIX_M>(EVENT_ID0);
}
DIRECT_DEVICE
~BK32PackBlock()
{
for (uint32_t i = 0; i < STAGES; i++) {
AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(l1AEventList[i]);
AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(l1BEventList[i]);
AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(l0AEventList[i]);
AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(l0BEventList[i]);
}
AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(EVENT_ID0);
}
DIRECT_DEVICE
void PrefetchInitialHead(
AscendC::GlobalTensor<ElementA> const &gmA, LayoutA const &layoutA,
AscendC::GlobalTensor<ElementB> const &gmB, LayoutB const &layoutB,
GemmCoord const &actualShape)
{
const bool useRawA = (actualShape.m() == 128);
const uint32_t kActual = min(actualShape.k(), L1TileShape::K);
auto layoutAInL1 = LayoutAInL1::template MakeLayout<ElementA>(L1TileShape::M, L1TileShape::K);
auto layoutBInL1 = LayoutBInL1::template MakeLayout<ElementB>(L1TileShape::K, L1TileShape::N);
auto layoutTileA = layoutA.GetTileLayout(MakeCoord(actualShape.m(), kActual));
auto layoutTileB = layoutB.GetTileLayout(MakeCoord(kActual, actualShape.n()));
AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(l1AEventList[l1ListId]);
copyGmToL1A(l1ATensorList[l1ListId], gmA, layoutAInL1, layoutTileA, useRawA);
AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(l1AEventList[l1ListId]);
AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(l1BEventList[l1ListId]);
copyGmToL1B(l1BTensorList[l1ListId], gmB, layoutBInL1, layoutTileB);
AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(l1BEventList[l1ListId]);
prefetchValid = true;
}
DIRECT_DEVICE
void operator()(
AscendC::GlobalTensor<ElementA> const &gmA, LayoutA const &layoutA,
AscendC::GlobalTensor<ElementB> const &gmB, LayoutB const &layoutB,
AscendC::GlobalTensor<ElementC> const &gmC, LayoutC const &layoutC,
GemmCoord const &actualShape,
AscendC::GlobalTensor<ElementA> const &nextGmA, LayoutA const &nextLayoutA,
AscendC::GlobalTensor<ElementB> const &nextGmB, LayoutB const &nextLayoutB,
GemmCoord const *nextShape)
{
const bool useRawA = (actualShape.m() == 128);
uint32_t mRound = RoundUp<16>(actualShape.m());
uint32_t nRound = RoundUp<32>(actualShape.n());
auto layoutAInL1 = LayoutAInL1::template MakeLayout<ElementA>(L1TileShape::M, L1TileShape::K);
auto layoutBInL1 = LayoutBInL1::template MakeLayout<ElementB>(L1TileShape::K, L1TileShape::N);
auto layoutInL0C = LayoutCInL0::MakeLayoutInL0C(MakeCoord(mRound, nRound));
uint32_t kActual = min(actualShape.k(), L1TileShape::K);
auto layoutTileA = layoutA.GetTileLayout(MakeCoord(actualShape.m(), kActual));
auto layoutTileB = layoutB.GetTileLayout(MakeCoord(kActual, actualShape.n()));
if (!prefetchValid) {
AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(l1AEventList[l1ListId]);
copyGmToL1A(l1ATensorList[l1ListId], gmA, layoutAInL1, layoutTileA, useRawA);
AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(l1AEventList[l1ListId]);
AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(l1BEventList[l1ListId]);
copyGmToL1B(l1BTensorList[l1ListId], gmB, layoutBInL1, layoutTileB);
AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(l1BEventList[l1ListId]);
}
prefetchValid = false;
AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(EVENT_ID0);
uint32_t mPartLoop = CeilDiv<L0TileShape::M>(mRound);
uint32_t nPartLoop = CeilDiv<L0TileShape::N>(nRound);
uint32_t kTileCount = CeilDiv<L1TileShape::K>(actualShape.k());
for (uint32_t kLoopIdx = 0; kLoopIdx < kTileCount; kLoopIdx++) {
uint32_t l1ListIdNext = (l1ListId + 1 < STAGES) ? (l1ListId + 1) : 0;
uint32_t kActualNext{0};
if (kLoopIdx < kTileCount - 1) {
uint32_t kLoopIdxNext = kLoopIdx + 1;
kActualNext = (kLoopIdxNext < kTileCount - 1) ?
L1TileShape::K : (actualShape.k() - kLoopIdxNext * L1TileShape::K);
auto l1ATensor = l1ATensorList[l1ListIdNext];
auto l1BTensor = l1BTensorList[l1ListIdNext];
MatrixCoord gmTileAOffset{0, kLoopIdxNext * L1TileShape::K};
MatrixCoord gmTileBOffset{kLoopIdxNext * L1TileShape::K, 0};
auto gmTileA = gmA[layoutA.GetOffset(gmTileAOffset)];
auto gmTileB = gmB[layoutB.GetOffset(gmTileBOffset)];
AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(l1AEventList[l1ListIdNext]);
layoutTileA = layoutA.GetTileLayout(MakeCoord(actualShape.m(), kActualNext));
copyGmToL1A(l1ATensor, gmTileA, layoutAInL1, layoutTileA, useRawA);
AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(l1AEventList[l1ListIdNext]);
AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(l1BEventList[l1ListIdNext]);
layoutTileB = layoutB.GetTileLayout(MakeCoord(kActualNext, actualShape.n()));
copyGmToL1B(l1BTensor, gmTileB, layoutBInL1, layoutTileB);
AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(l1BEventList[l1ListIdNext]);
} else if (nextShape != nullptr) {
const uint32_t nextK = min(nextShape->k(), L1TileShape::K);
const bool nextUseRawA = (nextShape->m() == 128);
auto nextTileA = nextLayoutA.GetTileLayout(MakeCoord(nextShape->m(), nextK));
auto nextTileB = nextLayoutB.GetTileLayout(MakeCoord(nextK, nextShape->n()));
AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(l1AEventList[l1ListIdNext]);
copyGmToL1A(l1ATensorList[l1ListIdNext], nextGmA, layoutAInL1, nextTileA, nextUseRawA);
AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(l1AEventList[l1ListIdNext]);
AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(l1BEventList[l1ListIdNext]);
copyGmToL1B(l1BTensorList[l1ListIdNext], nextGmB, layoutBInL1, nextTileB);
AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(l1BEventList[l1ListIdNext]);
prefetchValid = true;
}
auto l1ATensor = l1ATensorList[l1ListId];
auto l1BTensor = l1BTensorList[l1ListId];
uint32_t kPartLoop = CeilDiv<L0TileShape::K>(kActual);
for (int mPartIdx = 0; mPartIdx < mPartLoop; mPartIdx++) {
uint32_t mPartActual = (mPartIdx < mPartLoop - 1) ?
L0TileShape::M : (mRound - mPartIdx * L0TileShape::M);
for (int kPartIdx = 0; kPartIdx < kPartLoop; kPartIdx++) {
uint32_t kPartActual = (kPartIdx < kPartLoop - 1) ?
L0TileShape::K : (kActual - kPartIdx * L0TileShape::K);
auto l0ATile = l0ATensorList[l0AListId];
LayoutAInL0 layoutAInL0 = LayoutAInL0::template MakeLayout<ElementA>(mPartActual, kPartActual);
MatrixCoord l1AOffset{mPartIdx * L0TileShape::M, kPartIdx * L0TileShape::K};
auto l1ATile = l1ATensor[layoutAInL1.GetOffset(l1AOffset)];
AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(l0AEventList[l0AListId]);
if ((mPartIdx == 0) && (kPartIdx == 0)) {
AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(l1AEventList[l1ListId]);
}
copyL1ToL0A(l0ATile, useRawA ? l1ATensor : l1ATile,
layoutAInL0, layoutAInL1, kPartIdx * 128, useRawA);
if ((mPartIdx == mPartLoop - 1) && (kPartIdx == kPartLoop - 1)) {
AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(l1AEventList[l1ListId]);
}
for (int nPartIdx = 0; nPartIdx < nPartLoop; nPartIdx++) {
uint32_t nPartActual = (nPartIdx < nPartLoop - 1) ?
L0TileShape::N : (nRound - nPartIdx * L0TileShape::N);
auto l0BTile = l0BTensorList[l0BListId];
LayoutBInL0 layoutBInL0 = LayoutBInL0::template MakeLayout<ElementB>(kPartActual, nPartActual);
auto l1BTile = l1BTensor[kPartIdx * 128 * 256];
AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(l0BEventList[l0BListId]);
if ((kPartIdx == 0) && (nPartIdx == 0)) {
AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(l1BEventList[l1ListId]);
}
copyL1ToL0B(l0BTile, l1BTile, layoutBInL0, layoutBInL1);
if ((kPartIdx == kPartLoop - 1) && (nPartIdx == nPartLoop - 1)) {
AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(l1BEventList[l1ListId]);
}
AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID0);
MatrixCoord l0COffset{mPartIdx * L0TileShape::M, nPartIdx * L0TileShape::N};
auto l0CTile = l0CTensor[layoutInL0C.GetOffset(l0COffset)];
AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID0);
bool initC = ((kLoopIdx == 0) && (kPartIdx == 0));
uint8_t unitFlag = 0b00;
tileMmad(l0CTile, l0ATile, l0BTile, mPartActual, nPartActual, kPartActual, initC, unitFlag);
AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(l0BEventList[l0BListId]);
l0BListId = (l0BListId + 1 < STAGES) ? (l0BListId + 1) : 0;
}
AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(l0AEventList[l0AListId]);
l0AListId = (l0AListId + 1 < STAGES) ? (l0AListId + 1) : 0;
}
}
l1ListId = l1ListIdNext;
kActual = kActualNext;
}
LayoutC layoutBlock = layoutC.GetTileLayout(actualShape.GetCoordMN());
AscendC::SetFlag<AscendC::HardEvent::M_FIX>(EVENT_ID0);
AscendC::WaitFlag<AscendC::HardEvent::M_FIX>(EVENT_ID0);
copyL0CToGm(gmC, l0CTensor, layoutBlock, layoutInL0C);
AscendC::SetFlag<AscendC::HardEvent::FIX_M>(EVENT_ID0);
}
protected:
AscendC::LocalTensor<ElementA> l1ATensorList[STAGES];
AscendC::LocalTensor<ElementB> l1BTensorList[STAGES];
AscendC::LocalTensor<ElementA> l0ATensorList[STAGES];
AscendC::LocalTensor<ElementB> l0BTensorList[STAGES];
AscendC::LocalTensor<ElementAccumulator> l0CTensor;
int32_t l1AEventList[STAGES];
int32_t l1BEventList[STAGES];
int32_t l0AEventList[STAGES];
int32_t l0BEventList[STAGES];
bool prefetchValid{false};
uint32_t l1ListId{0};
uint32_t l0AListId{0};
uint32_t l0BListId{0};
TileMmad tileMmad;
CopyGmToL1A copyGmToL1A;
CopyGmToL1B copyGmToL1B;
CopyL1ToL0A copyL1ToL0A;
CopyL1ToL0B copyL1ToL0B;
CopyL0CToGm copyL0CToGm;
};
}
namespace direct_core {
template<class BlockMmad_, class BlockEpilogue_>
class PrefetchGrouped {
public:
using BlockMmad = BlockMmad_;
using L1TileShape = typename BlockMmad::L1TileShape;
using ElementA = int8_t;
using ElementB = int8_t;
using ElementC = int32_t;
using ElementGroupList = int64_t;
using LayoutA = layout::RowMajor;
using LayoutB = layout::RowMajor;
using LayoutC = layout::RowMajor;
using LayoutD = layout::RowMajor;
using LayoutScale = layout::VectorLayout;
using BlockEpilogue = BlockEpilogue_;
using EpilogueParams = typename BlockEpilogue::Params;
using BlockScheduler = RowSwizzle3;
static constexpr uint32_t WORKSPACE_STAGES = 2;
using Params = GroupParams;
DIRECT_DEVICE
PrefetchGrouped()
{
Arch::FlagID flagId = 0;
for (uint32_t stageId = 0; stageId < WORKSPACE_STAGES; ++stageId) {
flagAicFinishStoreList[stageId] = Arch::CrossCoreFlag(flagId++);
flagAivFinishComputeList[stageId] = Arch::CrossCoreFlag(flagId++);
}
}
struct Job {
int64_t offsetA, offsetB;
LayoutA layoutA;
LayoutB layoutB;
GemmCoord actualShape;
};
DIRECT_DEVICE
void RunJob(BlockMmad &blockMmad,
AscendC::GlobalTensor<ElementA> const &gmA,
AscendC::GlobalTensor<ElementB> const &allGmB,
AscendC::GlobalTensor<ElementC> const &gmC, LayoutC const &layoutC,
uint32_t coreIdx, uint32_t coreNum, uint32_t &stageId, uint32_t &stageUsed,
Job const &current, Job const *next)
{
const bool waitBeforeFixpipe = stageUsed == WORKSPACE_STAGES;
if (!waitBeforeFixpipe) ++stageUsed;
MatrixCoord offsetC{(stageId * coreNum + coreIdx) * L1TileShape::M, 0U};
int64_t gmOffsetC = layoutC.GetOffset(offsetC);
Job const &view = next != nullptr ? *next : current;
auto nextA = gmA[view.offsetA];
auto nextB = allGmB[view.offsetB];
if (waitBeforeFixpipe) Arch::Wait(flagAivFinishComputeList[stageId]);
blockMmad(gmA[current.offsetA], current.layoutA,
allGmB[current.offsetB], current.layoutB, gmC[gmOffsetC], layoutC,
current.actualShape, nextA, view.layoutA, nextB, view.layoutB,
next != nullptr ? &view.actualShape : nullptr);
Arch::Signal<PIPE_FIX>(flagAicFinishStoreList[stageId]);
stageId = (stageId + 1 < WORKSPACE_STAGES) ? (stageId + 1) : 0;
}
DIRECT_DEVICE void operator()(Params const &params) {
if constexpr (g_coreType == AscendC::AIC) RunCube(params);
else RunVector(params);
}
DIRECT_DEVICE void RunCube(Params const &params)
{
AscendC::ICachePreLoad(1);
BlockScheduler blockScheduler;
BlockMmad blockMmad(resource);
AscendC::GlobalTensor<ElementA> gmA;
gmA.SetGlobalBuffer(params.ptrA);
AscendC::GlobalTensor<ElementGroupList> groupList;
groupList.SetGlobalBuffer(params.ptrGroupList);
uint32_t coreIdx = AscendC::GetBlockIdx();
uint32_t coreNum = AscendC::GetBlockNum();
int64_t gmGroupOffsetA = 0;
int64_t gmGroupOffsetB = 0;
AscendC::GlobalTensor<ElementC> gmC;
gmC.SetGlobalBuffer(reinterpret_cast<__gm__ ElementC *>(params.ptrWorkspace));
const uint32_t workspaceN = RoundUp<16>(params.problemShape.n() < L1TileShape::N ? params.problemShape.n() : L1TileShape::N);
auto layoutC = layout::RowMajor{L1TileShape::M * coreNum * WORKSPACE_STAGES, workspaceN};
AscendC::GlobalTensor<ElementB> allGmB;
allGmB.SetGlobalBuffer(params.ptrB);
Job pending{};
bool pendingValid = false;
uint32_t stageId = 0;
uint32_t stageUsed = 0;
uint32_t startCoreIdx = 0;
for (uint32_t groupIdx = 0; groupIdx < params.problemCount; ++groupIdx) {
uint32_t currentM = (groupIdx == 0) ? groupList.GetValue(groupIdx) :
(groupList.GetValue(groupIdx) - groupList.GetValue(groupIdx - 1));
GemmCoord inGroupProblemShape{currentM, params.problemShape.n(), params.problemShape.k()};
LayoutA layoutA = params.layoutA.GetTileLayout(inGroupProblemShape.GetCoordMK());
LayoutB layoutB = params.layoutB;
blockScheduler.Update(inGroupProblemShape, MakeCoord(L1TileShape::M, L1TileShape::N));
uint32_t coreLoops = blockScheduler.GetCoreLoops();
AscendC::GlobalTensor<ElementB> gmB;
gmB.SetGlobalBuffer(params.ptrB + gmGroupOffsetB);
uint32_t startLoopIdx = ((coreIdx < startCoreIdx) ? (coreIdx + coreNum) : coreIdx) - startCoreIdx;
for (uint32_t loopIdx = startLoopIdx; loopIdx < coreLoops; loopIdx += coreNum) {
GemmCoord blockCoord = blockScheduler.GetBlockCoord(loopIdx);
GemmCoord actualBlockShape = blockScheduler.GetActualBlockShape(blockCoord);
MatrixCoord offsetA{blockCoord.m() * L1TileShape::M, blockCoord.k() * L1TileShape::K};
MatrixCoord offsetB{blockCoord.k() * L1TileShape::K, blockCoord.n() * L1TileShape::N};
Job job{gmGroupOffsetA + layoutA.GetOffset(offsetA),
gmGroupOffsetB + layoutB.GetOffset(offsetB), layoutA, layoutB, actualBlockShape};
if (pendingValid) {
RunJob(blockMmad, gmA, allGmB, gmC, layoutC,
coreIdx, coreNum, stageId, stageUsed, pending, &job);
} else {
if constexpr (BlockMmad::PREFETCH_INITIAL_HEAD) {
blockMmad.PrefetchInitialHead(gmA[job.offsetA], job.layoutA,
allGmB[job.offsetB], job.layoutB, job.actualShape);
}
}
pending = job;
pendingValid = true;
}
gmGroupOffsetA += inGroupProblemShape.m() * inGroupProblemShape.k();
gmGroupOffsetB += inGroupProblemShape.k() * inGroupProblemShape.n();
startCoreIdx = (startCoreIdx + coreLoops) % coreNum;
}
if (pendingValid) {
RunJob(blockMmad, gmA, allGmB, gmC, layoutC,
coreIdx, coreNum, stageId, stageUsed, pending, nullptr);
}
while (stageUsed > 0) {
uint32_t aivComputeStageId = (stageId >= stageUsed) ?
(stageId - stageUsed) : (stageId + WORKSPACE_STAGES - stageUsed);
Arch::Wait(flagAivFinishComputeList[aivComputeStageId]);
--stageUsed;
}
AscendC::PipeBarrier<PIPE_ALL>();
}
DIRECT_DEVICE void RunVector(Params const &params)
{
AscendC::ICachePreLoad(1);
BlockScheduler blockScheduler;
BlockEpilogue blockEpilogue(resource);
uint32_t coreIdx = AscendC::GetBlockIdx() / AscendC::GetSubBlockNum();
uint32_t coreNum = AscendC::GetBlockNum();
int64_t gmGroupOffsetScale = 0;
int64_t gmGroupOffsetD = 0;
AscendC::GlobalTensor<ElementGroupList> groupList;
groupList.SetGlobalBuffer(params.ptrGroupList);
AscendC::GlobalTensor<ElementC> gmC;
gmC.SetGlobalBuffer(reinterpret_cast<__gm__ ElementC *>(params.ptrWorkspace));
const uint32_t workspaceN = RoundUp<16>(params.problemShape.n() < L1TileShape::N ? params.problemShape.n() : L1TileShape::N);
auto layoutC = layout::RowMajor{L1TileShape::M * coreNum * WORKSPACE_STAGES, workspaceN};
uint32_t stageId = 0;
uint32_t startCoreIdx = 0;
for (uint32_t groupIdx = 0; groupIdx < params.problemCount; ++groupIdx) {
uint32_t currentM = (groupIdx == 0) ? groupList.GetValue(groupIdx) :
(groupList.GetValue(groupIdx) - groupList.GetValue(groupIdx - 1));
GemmCoord inGroupProblemShape{currentM, params.problemShape.n(), params.problemShape.k()};
LayoutScale layoutScale = params.layoutScale;
LayoutD layoutD = params.layoutD.GetTileLayout(inGroupProblemShape.GetCoordMN());
EpilogueParams epilogueParams{
params.ptrScale + gmGroupOffsetScale, layoutScale,
params.ptrD + gmGroupOffsetD, layoutD
};
blockScheduler.Update(inGroupProblemShape, L1TileShape::ToCoordMN());
blockEpilogue.UpdateParams(epilogueParams);
uint32_t coreLoops = blockScheduler.GetCoreLoops();
GemmCoord blockShapeMNK = L1TileShape::ToCoord();
uint32_t startLoopIdx = ((coreIdx < startCoreIdx) ? (coreIdx + coreNum) : coreIdx) - startCoreIdx;
for (uint32_t loopIdx = startLoopIdx; loopIdx < coreLoops; loopIdx += coreNum) {
GemmCoord blockCoordMNK = blockScheduler.GetBlockCoord(loopIdx);
GemmCoord actualBlockShapeMNK = blockScheduler.GetActualBlockShape(blockCoordMNK);
MatrixCoord offsetC{(stageId * coreNum + coreIdx) * L1TileShape::M, 0};
int64_t gmOffsetC = layoutC.GetOffset(offsetC);
auto gmBlockC = gmC[gmOffsetC];
auto layoutBlockC = layoutC.GetTileLayout(actualBlockShapeMNK.GetCoordMN());
Arch::Wait(flagAicFinishStoreList[stageId]);
blockEpilogue(blockShapeMNK, blockCoordMNK, actualBlockShapeMNK, gmBlockC, layoutBlockC);
Arch::Signal<PIPE_MTE3>(flagAivFinishComputeList[stageId]);
stageId = (stageId + 1 < WORKSPACE_STAGES) ? (stageId + 1) : 0;
}
gmGroupOffsetScale += inGroupProblemShape.n();
gmGroupOffsetD += inGroupProblemShape.m() * inGroupProblemShape.n();
startCoreIdx = (startCoreIdx + coreLoops) % coreNum;
}
AscendC::PipeBarrier<PIPE_ALL>();
}
private:
Arch::CrossCoreFlag flagAicFinishStoreList[WORKSPACE_STAGES];
Arch::CrossCoreFlag flagAivFinishComputeList[WORKSPACE_STAGES];
Arch::Resource resource;
};
}
namespace b_k32_ndpack_private {
using Cube=direct_core::BK32PackBlock<public_gmg::Tile, public_gmg::L0Tile>;
static_assert(Cube::L1A_SIZE==65536 && Cube::L1B_SIZE==131072,"same slots");
using Kernel=direct_core::PrefetchGrouped<
Cube,public_gmg::Base64IntervalEpilogue>;
}
extern "C" __global__ __aicore__ void grouped_matmul_gelu_b_k32_ndpack_private(
GM_ADDR x,GM_ADDR w,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,GM_ADDR scratch,gmg::Plan plan){
