};}
namespace public_gmg {
class HBEpilogue {
public:
using ElementScale=float; using LayoutScale=layout::VectorLayout;
using ElementD=half; using LayoutD=layout::RowMajor;
using Params=DescriptorBankStableEpilogue::Params;
__aicore__ __forceinline__ HBEpilogue(Arch::Resource &resource) {
Buffer *buffers[]={&zb,&qb,&sb,&yb};
const uint32_t offsets[]={0,65792,131328,133632};
for(uint32_t i=0;i<4;++i)buffers[i]->tensor=resource.ubBuf.GetBufferByByte<uint8_t>(offsets[i]);
}
__aicore__ __forceinline__ void UpdateParams(Params const&p) {
plan.n=p.yl.stride(0);scale.SetGlobalBuffer(p.sp);y.SetGlobalBuffer(p.yp);
}
__aicore__ __forceinline__ void operator()(GemmCoord const&shape,GemmCoord const&coord,
GemmCoord const&actual,GlobalTensor<int32_t> const&src,layout::RowMajor const&srcLayout) {
const uint32_t perSub=(actual.m()+1)/2,first=GetSubBlockIdx()*perSub;
const uint32_t end=first+perSub<actual.m()?first+perSub:actual.m();
if(first>=end)return;
accumStride=srcLayout.stride(0);
for(uint32_t row=first;row<end;row+=48){
accum=src[uint64_t(row)*accumStride];
Compute64(coord.m()*shape.m()+row,coord.n()*shape.n(),min(end-row,48U),actual.n());
}
}
private:
__aicore__ __forceinline__ void Compute64(uint32_t row,uint32_t col,uint32_t vm,uint32_t vn) {
const uint32_t e=0, stride=(vn+7)/8*8, len=vm*stride;
auto ci = qb.Get<int32_t>();
auto z = zb.Get<float>();
auto q = qb.Get<float>();
auto s = sb.Get<float>();
auto out = yb.Get<half>();
DataCopyPad(ci, accum,
DataCopyExtParams{static_cast<uint16_t>(vm), vn * 4, (accumStride - vn) * 4, 0, 0},
DataCopyPadExtParams<int32_t>{true, 0, static_cast<uint8_t>(stride - vn), 0});
DataCopyPad(s, scale[uint64_t(e) * plan.n + col],
DataCopyExtParams{1, vn * 4, 0, 0, 0},
DataCopyPadExtParams<float>{true, 0, static_cast<uint8_t>(stride - vn), 0.0f});
SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
Cast(z, ci, RoundMode::CAST_RINT, len);
BinaryRepeatParams br;
br.dstBlkStride = 1; br.src0BlkStride = 1; br.src1BlkStride = 1;
br.dstRepStride = stride / 8; br.src0RepStride = stride / 8; br.src1RepStride = 0;
for (uint32_t col = 0; col < stride; col += 64) {
const uint64_t mask = stride - col < 64 ? stride - col : 64;
Mul(z[col], z[col], s[col], mask, static_cast<uint8_t>(vm), br);
}
Mul(q, z, z, len);
Muls(q, q, 0.044715f, len);
Adds(q, q, 1.0f, len);
Mul(q, q, z, len);
Muls(q, q, -1.5957691216057308f, len);
Mins(q, q, 87.0f, len);
Exp(q, q, len);
Adds(q, q, 1.0f, len);
Div(q, z, q, len);
const bool packed=stride%16==0;const uint32_t outPitch=(vn+15)/16*16;
if(packed)Cast(out,q,RoundMode::CAST_RINT,len);
else {
UnaryRepeatParams cr;cr.dstBlkStride=1;cr.srcBlkStride=1;cr.dstRepStride=outPitch/16;cr.srcRepStride=stride/8;
for(uint32_t cc=0;cc<stride;cc+=64){
uint64_t mask=stride-cc<64?stride-cc:64;
Cast(out[cc],q[cc],RoundMode::CAST_RINT,mask,static_cast<uint8_t>(vm),cr);
}
}
SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
DataCopyPad(y[uint64_t(row)*plan.n+col],out,
DataCopyExtParams{static_cast<uint16_t>(vm),vn*2,
((packed?stride:outPitch)-(vn+15)/16*16)/16,(plan.n-vn)*2,0});
PipeBarrier<PIPE_ALL>();
}
uint32_t accumStride;struct{uint32_t n;}plan;
GlobalTensor<float>scale;GlobalTensor<half>y;GlobalTensor<int32_t>accum;
Buffer zb,qb,sb,yb;
};
}
namespace longk_split_resident {using Kernel=direct_core::HBSplit<direct_core::HBResident,public_gmg::HBEpilogue,8>;}
extern "C" __global__ __aicore__ __attribute__((section(".longk_split_resident")))
void grouped_matmul_gelu_longk_split_resident(GM_ADDR,GM_ADDR,GM_ADDR,GM_ADDR,GM_ADDR,GM_ADDR,gmg::Plan);
inline bool TrySplitK(GM_ADDR x,GM_ADDR w,GM_ADDR s,GM_ADDR g,GM_ADDR y,int64_t e,int64_t m,int64_t k,int64_t n,int64_t cores,aclrtStream stream){
if(m<1 || m>2048 || k<=4096 || k>8192 || n<=256 || n>768 || cores<1)return false;
auto *hw=platform_ascendc::PlatformAscendCManager::GetInstance();if(!hw)return false;
const uint32_t blocks=std::min<int64_t>(cores,std::min<int64_t>(hw->GetCoreNumAic(),hw->GetCoreNumAiv()/2));if(!blocks)return false;
uint64_t l1=0,a=0,b=0,c=0,ub=0;
hw->GetCoreMemSize(platform_ascendc::CoreMemType::L1,l1);hw->GetCoreMemSize(platform_ascendc::CoreMemType::L0_A,a);hw->GetCoreMemSize(platform_ascendc::CoreMemType::L0_B,b);hw->GetCoreMemSize(platform_ascendc::CoreMemType::L0_C,c);hw->GetCoreMemSize(platform_ascendc::CoreMemType::UB,ub);
if(l1<491520 || a<32768 || b<65536 || c<131072 || ub<166400)return false;
uint64_t ffts=0;uint32_t length=0;if(rtGetC2cCtrlAddr(&ffts,&length)!=0)throw std::runtime_error("HB FFTS unavailable");
const uint64_t pk=(k+31)/32*32,pn=(n+31)/32*32;
const uint64_t bytes=uint64_t((m+511)/512+e-1)*((n+255)/256)*512*256*4;
uint8_t *scratch=nullptr;if(aclrtMalloc(reinterpret_cast<void**>(&scratch),bytes,ACL_MEM_MALLOC_HUGE_FIRST)!=ACL_SUCCESS)throw std::runtime_error("HB workspace unavailable");
gmg::Plan p{};p.e=e;p.m=m;p.k=k;p.n=n;p.blocks=blocks;p.backend=1;p.ffts=ffts;
LaunchHB015(x,w,s,g,y,scratch,p,blocks,stream);
const auto status=aclrtSynchronizeStream(stream);aclrtFree(scratch);if(status!=ACL_SUCCESS)throw std::runtime_error("HB kernel failed");return true;
}
extern "C" __global__ __aicore__ __attribute__((section(".longk_split_resident")))
void grouped_matmul_gelu_longk_split_resident(GM_ADDR x,GM_ADDR w,GM_ADDR s,GM_ADDR g,GM_ADDR y,GM_ADDR scratch,gmg::Plan p){
KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);AscendC::SetSyncBaseAddr(p.ffts);
longk_split_resident::Kernel::Params params{direct_core::GemmCoord{p.m,p.n,p.k},p.e,g,x,direct_core::layout::RowMajor{p.m,p.k},w,direct_core::layout::RowMajor{p.k,p.n},s,direct_core::layout::VectorLayout{p.n},y,direct_core::layout::RowMajor{p.m,p.n},scratch};longk_split_resident::Kernel op;op(params);
}
namespace direct_core {
template<class BlockMmad_,class BlockEpilogue_>
class WideResidentIterator {
public:
using BlockMmad=BlockMmad_;using BlockEpilogue=BlockEpilogue_;
using L1TileShape=typename BlockMmad::L1TileShape;using Params=GroupParams;
using Arguments=GroupArguments;using EpilogueParams=typename BlockEpilogue::Params;
static constexpr uint32_t WORKSPACE_STAGES=2;
static size_t GetWorkspaceSize(Arguments const&a){return uint64_t(a.aicCoreNum)*2*L1TileShape::M*L1TileShape::N*4;}
struct Job {uint32_t expert,rowBase;GemmCoord coord,actual;};
class Iterator {
public:
DIRECT_DEVICE Iterator(Params const&p,uint32_t core,uint32_t count):p(p),cores(count),group(core){groups.SetGlobalBuffer(p.ptrGroupList);}
DIRECT_DEVICE bool Next(Job &job){
while(group<p.problemCount){
if(!loaded){end=groups.GetValue(group);rowBase=group?groups.GetValue(group-1):0;rows=end-rowBase;nextTask=0;ml=CeilDiv(rows,L1TileShape::M);nl=CeilDiv(p.problemShape.n(),L1TileShape::N);tiles=ml*nl;loaded=true;}
if(nextTask>=tiles){group+=cores;loaded=false;continue;}
uint32_t task=nextTask;GemmCoord c;
if(nl==3)c={task/3,task%3,0};
else if(nl==2)c={task/2,task%2,0};
else c={task/nl,task%nl,0};
job.expert=group;job.rowBase=rowBase;job.coord=c;
job.actual=GemmCoord{min(rows-c.m()*L1TileShape::M,L1TileShape::M),min(p.problemShape.n()-c.n()*L1TileShape::N,L1TileShape::N),p.problemShape.k()};
++nextTask;return true;
}
return false;
}
private:
Params const&p;AscendC::GlobalTensor<int64_t> groups;
uint32_t nextTask,cores,group=0,rowBase=0,end=0,rows=0,ml=0,nl=0,tiles=0,begin=0;bool loaded=false;
};
DIRECT_DEVICE WideResidentIterator(){for(uint32_t i=0;i<2;++i){ready[i]=Arch::CrossCoreFlag(2*i);ack[i]=Arch::CrossCoreFlag(2*i+1);}}
DIRECT_DEVICE void operator()(Params const&p){if constexpr(g_coreType==AscendC::AIC)Cube(p);else Vector(p);}
DIRECT_DEVICE void Cube(Params const&p){
AscendC::ICachePreLoad(1);BlockMmad mma(resource);uint32_t core=AscendC::GetBlockIdx(),cores=AscendC::GetBlockNum();
Iterator jobs(p,core,cores);Job job;uint32_t stage=0,used=0;
AscendC::GlobalTensor<int8_t> a,b;AscendC::GlobalTensor<int32_t> c;
a.SetGlobalBuffer(p.ptrA);b.SetGlobalBuffer(p.ptrB);c.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(p.ptrWorkspace));
auto cl=layout::RowMajor{L1TileShape::M*cores*2,L1TileShape::N};
while(jobs.Next(job)){
if(used==2)Arch::Wait(ack[stage]);else ++used;
mma.reuseA=job.coord.n()!=0;mma.nextColumn=(job.coord.n()+1)*L1TileShape::N<p.problemShape.n();
mma(a[uint64_t(job.rowBase+job.coord.m()*L1TileShape::M)*p.problemShape.k()],p.layoutA,
b[uint64_t(job.expert)*p.problemShape.k()*p.problemShape.n()+job.coord.n()*L1TileShape::N],p.layoutB,
c[uint64_t(stage*cores+core)*L1TileShape::M*L1TileShape::N],cl,job.actual);
Arch::Signal<PIPE_FIX>(ready[stage]);stage^=1;
}
while(used){uint32_t i=stage>=used?stage-used:stage+2-used;Arch::Wait(ack[i]);--used;}
AscendC::PipeBarrier<PIPE_ALL>();
}
DIRECT_DEVICE void Vector(Params const&p){
AscendC::ICachePreLoad(1);BlockEpilogue ep(resource);
uint32_t core=AscendC::GetBlockIdx()/AscendC::GetSubBlockNum(),cores=AscendC::GetBlockNum(),stage=0;
Iterator jobs(p,core,cores);Job job;AscendC::GlobalTensor<int32_t> c;
c.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(p.ptrWorkspace));auto cl=layout::RowMajor{L1TileShape::M*cores*2,L1TileShape::N};
while(jobs.Next(job)){
EpilogueParams e{p.ptrScale+uint64_t(job.expert)*p.problemShape.n(),p.layoutScale,p.ptrD+uint64_t(job.rowBase)*p.problemShape.n(),p.layoutD};ep.UpdateParams(e);
auto src=c[uint64_t(stage*cores+core)*L1TileShape::M*L1TileShape::N];auto block=cl.GetTileLayout(job.actual.GetCoordMN());
Arch::Wait(ready[stage]);ep(L1TileShape::ToCoord(),job.coord,job.actual,src,block);Arch::Signal<PIPE_MTE3>(ack[stage]);stage^=1;
}
AscendC::PipeBarrier<PIPE_ALL>();
}
private:Arch::CrossCoreFlag ready[2],ack[2];Arch::Resource resource;
};
}
namespace direct_core {
struct WideResidentMmad : public public_gmg::Mmad {
bool reuseA=false,nextColumn=false,pendingB=false;
using LayoutBInL1=b_k32_ndpack_private::PackedK32N256;
b_k32_ndpack_private::CopyGmB copyGmToL1B;
b_k32_ndpack_private::CopyL0B copyL1ToL0B;
__aicore__ inline WideResidentMmad(Arch::Resource&r):public_gmg::Mmad(r){
l1ATensorList[0]=r.l1Buf.GetBufferByByte<int8_t>(0);
l1BTensorList[0]=r.l1Buf.GetBufferByByte<int8_t>(296960);
l1BTensorList[1]=r.l1Buf.GetBufferByByte<int8_t>(296960+128*256);
}
__aicore__ inline void operator()(
AscendC::GlobalTensor<ElementA> const &gmA,LayoutA const &layoutA,
AscendC::GlobalTensor<ElementB> const &gmB,LayoutB const &layoutB,
AscendC::GlobalTensor<ElementC> const &gmC,LayoutC const &layoutC,
direct_core::GemmCoord const &actualShape){
using namespace direct_core;
const uint32_t mr=RoundUp<16>(actualShape.m());
const uint32_t nr=RoundUp<32>(actualShape.n());
const uint32_t parts=CeilDiv<128>(actualShape.k());
auto aL1=LayoutAInL1::template MakeLayout<ElementA>((mr/16)%2?mr:mr+16,RoundUp<32>(actualShape.k()));
auto bL1=LayoutBInL1::template MakeLayout<ElementB>(128,256);
auto cL0=LayoutCInL0::MakeLayoutInL0C(MakeCoord(mr,nr));
AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(l1AEventList[0]);
AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(l1AEventList[1]);
if(!reuseA)copyGmToL1A(l1ATensorList[0],gmA,aL1,layoutA.GetTileLayout(MakeCoord(actualShape.m(),actualShape.k())));
AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(l1AEventList[0]);
if(!pendingB){
AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(l1BEventList[0]);
copyGmToL1B(l1BTensorList[0],gmB,bL1,layoutB.GetTileLayout(MakeCoord(min(actualShape.k(),128U),actualShape.n())));
AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(l1BEventList[0]);
}
pendingB=false;
AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(EVENT_ID0);
for(uint32_t j=0;j<parts;++j){
const uint32_t bs=j&1;
if(j+1<parts){
const uint32_t next=bs^1,begin=(j+1)*128,count=min(actualShape.k()-begin,128U);
AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(l1BEventList[next]);
auto gb=gmB[layoutB.GetOffset(MatrixCoord{begin,uint32_t(0)})];
copyGmToL1B(l1BTensorList[next],gb,bL1,layoutB.GetTileLayout(MakeCoord(count,actualShape.n())));
AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(l1BEventList[next]);
}
if(j+1==parts && nextColumn){
const uint32_t next=bs^1;
AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(l1BEventList[next]);
copyGmToL1B(l1BTensorList[next],gmB[256],bL1,layoutB.GetTileLayout(MakeCoord(128U,actualShape.n())));
AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(l1BEventList[next]);
pendingB=true;
}
const uint32_t ka=min(actualShape.k()-j*128,128U);
auto aL0=LayoutAInL0::template MakeLayout<ElementA>(mr,ka);
auto bL0=LayoutBInL0::template MakeLayout<ElementB>(ka,nr);
auto a=l0ATensorList[l0AListId],b=l0BTensorList[l0BListId];
AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(l0AEventList[l0AListId]);
if(j==0)AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(l1AEventList[0]);
auto aPart=l1ATensorList[0][aL1.GetOffset(MatrixCoord{uint32_t(0),j*128})];
copyL1ToL0A(a,aPart,aL0,aL1);
if(j+1==parts){AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(l1AEventList[0]);AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(l1AEventList[1]);}
AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(l0BEventList[l0BListId]);
AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(l1BEventList[bs]);
copyL1ToL0B(b,l1BTensorList[bs],bL0,bL1);
AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(l1BEventList[bs]);
AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID0);
AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID0);
tileMmad(l0CTensor,a,b,mr,nr,ka,j==0,0);
AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(l0AEventList[l0AListId]);
AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(l0BEventList[l0BListId]);
l0AListId^=1;l0BListId^=1;
}
auto cBlock=layoutC.GetTileLayout(actualShape.GetCoordMN());
AscendC::SetFlag<AscendC::HardEvent::M_FIX>(EVENT_ID0);
AscendC::WaitFlag<AscendC::HardEvent::M_FIX>(EVENT_ID0);
copyL0CToGm(gmC,l0CTensor,cBlock,cL0);
AscendC::SetFlag<AscendC::HardEvent::FIX_M>(EVENT_ID0);
}
};
}
namespace wide_resident_family {using Kernel=direct_core::WideResidentIterator<direct_core::WideResidentMmad,public_gmg::Base64IntervalEpilogue>;}
extern "C" __global__ __aicore__ __attribute__((section(".wide_resident_family")))
void grouped_matmul_gelu_wide_resident_family(GM_ADDR,GM_ADDR,GM_ADDR,GM_ADDR,GM_ADDR,GM_ADDR,gmg::Plan);
inline bool TryResidentA(GM_ADDR x,GM_ADDR w,GM_ADDR s,GM_ADDR g,GM_ADDR y,int64_t e,int64_t m,int64_t k,int64_t n,int64_t cores,aclrtStream stream){
if(e<1 || m<96*e || m>160*e ||
k<1536 || k>2048 || (k%256)!=0 ||
n<512 || n>1024 || (n%256)!=0 || cores<1)return false;
auto *hw=platform_ascendc::PlatformAscendCManager::GetInstance();if(!hw)return false;
const uint32_t blocks=std::min<int64_t>(16,std::min<int64_t>(cores,std::min<int64_t>(hw->GetCoreNumAic(),hw->GetCoreNumAiv()/2)));if(!blocks)return false;
uint64_t l1=0,a=0,b=0,c=0,ub=0;
hw->GetCoreMemSize(platform_ascendc::CoreMemType::L1,l1);hw->GetCoreMemSize(platform_ascendc::CoreMemType::L0_A,a);hw->GetCoreMemSize(platform_ascendc::CoreMemType::L0_B,b);hw->GetCoreMemSize(platform_ascendc::CoreMemType::L0_C,c);hw->GetCoreMemSize(platform_ascendc::CoreMemType::UB,ub);
if(l1<393216 || a<49152 || b<65536 || c<131072 || ub<184384)return false;
uint64_t ffts=0;uint32_t length=0;if(rtGetC2cCtrlAddr(&ffts,&length)!=0)throw std::runtime_error("HERL2 FFTS unavailable");
const uint64_t pk=(k+31)/32*32,pn=(n+31)/32*32;
const uint64_t bytes=uint64_t(blocks)*2*128*256*4;
uint8_t *scratch=nullptr;if(aclrtMalloc(reinterpret_cast<void**>(&scratch),bytes,ACL_MEM_MALLOC_HUGE_FIRST)!=ACL_SUCCESS)throw std::runtime_error("HERL2 workspace unavailable");
gmg::Plan p{};p.e=e;p.m=m;p.k=k;p.n=n;p.blocks=blocks;p.backend=1;p.ffts=ffts;
grouped_matmul_gelu_wide_resident_family<<<blocks,nullptr,stream>>>(x,w,s,g,y,scratch,p);
const auto status=aclrtSynchronizeStream(stream);aclrtFree(scratch);if(status!=ACL_SUCCESS)throw std::runtime_error("HERL2 kernel failed");return true;
}
extern "C" __global__ __aicore__ __attribute__((section(".wide_resident_family")))
void grouped_matmul_gelu_wide_resident_family(GM_ADDR x,GM_ADDR w,GM_ADDR s,GM_ADDR g,GM_ADDR y,GM_ADDR scratch,gmg::Plan p){
KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);AscendC::SetSyncBaseAddr(p.ffts);
wide_resident_family::Kernel::Params params{direct_core::GemmCoord{p.m,p.n,p.k},p.e,g,
x,direct_core::layout::RowMajor{p.m,p.k},w,direct_core::layout::RowMajor{p.k,p.n},
s,direct_core::layout::VectorLayout{p.n},y,direct_core::layout::RowMajor{p.m,p.n},scratch};
wide_resident_family::Kernel op;op(params);
}
namespace direct_core {
struct PanelPairResidentMmad : public public_gmg::Mmad {
bool reuseA=false,nextColumn=false,pendingB=false;
__aicore__ inline PanelPairResidentMmad(Arch::Resource&r):public_gmg::Mmad(r){
l1ATensorList[0]=r.l1Buf.GetBufferByByte<int8_t>(0);
l1BTensorList[0]=r.l1Buf.GetBufferByByte<int8_t>(296960);
l1BTensorList[1]=r.l1Buf.GetBufferByByte<int8_t>(296960+128*256);
}
__aicore__ inline void operator()(
AscendC::GlobalTensor<ElementA> const &gmA,LayoutA const &layoutA,
AscendC::GlobalTensor<ElementB> const &gmB,LayoutB const &layoutB,
AscendC::GlobalTensor<ElementC> const &gmC,LayoutC const &layoutC,
direct_core::GemmCoord const &actualShape){
using namespace direct_core;
const uint32_t mr=RoundUp<16>(actualShape.m());
const uint32_t nr=RoundUp<32>(actualShape.n());
const uint32_t parts=CeilDiv<128>(actualShape.k());
auto aL1=LayoutAInL1::template MakeLayout<ElementA>((mr/16)%2?mr:mr+16,RoundUp<32>(actualShape.k()));
auto bL1=LayoutBInL1::template MakeLayout<ElementB>(128,256);
auto cL0=LayoutCInL0::MakeLayoutInL0C(MakeCoord(mr,nr));
AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(l1AEventList[0]);
AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(l1AEventList[1]);
if(!reuseA)copyGmToL1A(l1ATensorList[0],gmA,aL1,layoutA.GetTileLayout(MakeCoord(actualShape.m(),actualShape.k())));
AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(l1AEventList[0]);
if(!pendingB){
AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(l1BEventList[0]);
copyGmToL1B(l1BTensorList[0],gmB,bL1,layoutB.GetTileLayout(MakeCoord(min(actualShape.k(),128U),actualShape.n())));
AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(l1BEventList[0]);
}
pendingB=false;
AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(EVENT_ID0);
for(uint32_t j=0;j<parts;++j){
const uint32_t bs=j&1;
if(j+1<parts){
const uint32_t next=bs^1,begin=(j+1)*128,count=min(actualShape.k()-begin,128U);
AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(l1BEventList[next]);
auto gb=gmB[layoutB.GetOffset(MatrixCoord{begin,uint32_t(0)})];
copyGmToL1B(l1BTensorList[next],gb,bL1,layoutB.GetTileLayout(MakeCoord(count,actualShape.n())));
AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(l1BEventList[next]);
}
if(j+1==parts && nextColumn){
const uint32_t next=bs^1;
AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(l1BEventList[next]);
copyGmToL1B(l1BTensorList[next],gmB[256],bL1,layoutB.GetTileLayout(MakeCoord(128U,actualShape.n())));
AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(l1BEventList[next]);
pendingB=true;
}
const uint32_t ka=min(actualShape.k()-j*128,128U);
auto aL0=LayoutAInL0::template MakeLayout<ElementA>(mr,ka);
auto bL0=LayoutBInL0::template MakeLayout<ElementB>(ka,nr);
auto a=l0ATensorList[l0AListId],b=l0BTensorList[l0BListId];
AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(l0AEventList[l0AListId]);
if(j==0)AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(l1AEventList[0]);
auto aPart=l1ATensorList[0][aL1.GetOffset(MatrixCoord{uint32_t(0),j*128})];
a3d(a,aPart,aL0,aL1);
if(j+1==parts){AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(l1AEventList[0]);AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(l1AEventList[1]);}
AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(l0BEventList[l0BListId]);
AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(l1BEventList[bs]);
copyL1ToL0B(b,l1BTensorList[bs],bL0,bL1);
AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(l1BEventList[bs]);
AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID0);
AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID0);
tileMmad(l0CTensor,a,b,mr,nr,ka,j==0,0);
AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(l0AEventList[l0AListId]);
AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(l0BEventList[l0BListId]);
l0AListId^=1;l0BListId^=1;
}
auto cBlock=layoutC.GetTileLayout(actualShape.GetCoordMN());
AscendC::SetFlag<AscendC::HardEvent::M_FIX>(EVENT_ID0);
AscendC::WaitFlag<AscendC::HardEvent::M_FIX>(EVENT_ID0);
copyL0CToGm(gmC,l0CTensor,cBlock,cL0);
AscendC::SetFlag<AscendC::HardEvent::FIX_M>(EVENT_ID0);
}
FastA3DCopy a3d;
};
template<class BlockMmad_,class BlockEpilogue_>
class PanelPairResidentIterator {
public:
using BlockMmad=BlockMmad_;using BlockEpilogue=BlockEpilogue_;
using L1TileShape=typename BlockMmad::L1TileShape;using Params=GroupParams;
using Arguments=GroupArguments;using EpilogueParams=typename BlockEpilogue::Params;
static constexpr uint32_t WORKSPACE_STAGES=2;
static size_t GetWorkspaceSize(Arguments const&a){return uint64_t(a.aicCoreNum)*2*L1TileShape::M*L1TileShape::N*4;}
struct Job {uint32_t expert,rowBase;GemmCoord coord,actual;bool reuseA,nextColumn;};
class Iterator {
public:
DIRECT_DEVICE Iterator(Params const&p,uint32_t core,uint32_t count):p(p),core(core),cores(count) {groups.SetGlobalBuffer(p.ptrGroupList);}
DIRECT_DEVICE bool Next(Job &job) {
while(group<p.problemCount) {
if(!loaded) {
end=groups.GetValue(group);rowBase=group?groups.GetValue(group-1):0;
rows=end-rowBase;nl=CeilDiv(p.problemShape.n(),L1TileShape::N);
packsN=CeilDiv(nl,2U);packs=CeilDiv(rows,L1TileShape::M)*packsN;
packet=(core+cores-prefix%cores)%cores;lane=0;loaded=true;
}
if(packet>=packs) {prefix+=packs;++group;loaded=false;continue;}
const uint32_t mi=packet/packsN,ni=(packet%packsN)*2+lane;
job.expert=group;job.rowBase=rowBase;job.coord={mi,ni,0};
job.actual={min(rows-mi*L1TileShape::M,L1TileShape::M),min(p.problemShape.n()-ni*L1TileShape::N,L1TileShape::N),p.problemShape.k()};
job.reuseA=lane!=0;job.nextColumn=lane==0 && ni+1<nl;
if(job.nextColumn)lane=1;else {lane=0;packet+=cores;}
return true;
}
return false;
}
private:
Params const&p;AscendC::GlobalTensor<int64_t> groups;
uint32_t core,cores,group=0,prefix=0,rowBase=0,end=0,rows=0,nl=0,packsN=0,packs=0,packet=0,lane=0;
bool loaded=false;
};
DIRECT_DEVICE PanelPairResidentIterator(){for(uint32_t i=0;i<2;++i){ready[i]=Arch::CrossCoreFlag(2*i);ack[i]=Arch::CrossCoreFlag(2*i+1);}}
DIRECT_DEVICE void operator()(Params const&p){if constexpr(g_coreType==AscendC::AIC)Cube(p);else Vector(p);}
DIRECT_DEVICE void Cube(Params const&p){
AscendC::ICachePreLoad(1);BlockMmad mma(resource);uint32_t core=AscendC::GetBlockIdx(),cores=AscendC::GetBlockNum();
Iterator jobs(p,core,cores);Job job;uint32_t stage=0,used=0;
AscendC::GlobalTensor<int8_t> a,b;AscendC::GlobalTensor<int32_t> c;
a.SetGlobalBuffer(p.ptrA);b.SetGlobalBuffer(p.ptrB);c.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(p.ptrWorkspace));
auto cl=layout::RowMajor{L1TileShape::M*cores*2,L1TileShape::N};
while(jobs.Next(job)){
if(used==2)Arch::Wait(ack[stage]);else ++used;
mma.reuseA=job.reuseA;mma.nextColumn=job.nextColumn;
mma(a[uint64_t(job.rowBase+job.coord.m()*L1TileShape::M)*p.problemShape.k()],p.layoutA,
b[uint64_t(job.expert)*p.problemShape.k()*p.problemShape.n()+job.coord.n()*L1TileShape::N],p.layoutB,
c[uint64_t(stage*cores+core)*L1TileShape::M*L1TileShape::N],cl,job.actual);
Arch::Signal<PIPE_FIX>(ready[stage]);stage^=1;
}
while(used){uint32_t i=stage>=used?stage-used:stage+2-used;Arch::Wait(ack[i]);--used;}
AscendC::PipeBarrier<PIPE_ALL>();
}
DIRECT_DEVICE void Vector(Params const&p){
AscendC::ICachePreLoad(1);BlockEpilogue ep(resource);
uint32_t core=AscendC::GetBlockIdx()/AscendC::GetSubBlockNum(),cores=AscendC::GetBlockNum(),stage=0;
Iterator jobs(p,core,cores);Job job;AscendC::GlobalTensor<int32_t> c;
c.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(p.ptrWorkspace));auto cl=layout::RowMajor{L1TileShape::M*cores*2,L1TileShape::N};
while(jobs.Next(job)){
EpilogueParams e{p.ptrScale+uint64_t(job.expert)*p.problemShape.n(),p.layoutScale,p.ptrD+uint64_t(job.rowBase)*p.problemShape.n(),p.layoutD};ep.UpdateParams(e);
auto src=c[uint64_t(stage*cores+core)*L1TileShape::M*L1TileShape::N];auto block=cl.GetTileLayout(job.actual.GetCoordMN());
Arch::Wait(ready[stage]);ep(L1TileShape::ToCoord(),job.coord,job.actual,src,block);Arch::Signal<PIPE_MTE3>(ack[stage]);stage^=1;
}
AscendC::PipeBarrier<PIPE_ALL>();
}
private:Arch::CrossCoreFlag ready[2],ack[2];Arch::Resource resource;
};
}
namespace panel_pair_family {using Kernel=direct_core::PanelPairResidentIterator<direct_core::PanelPairResidentMmad,public_gmg::Base64IntervalEpilogue>;}
extern "C" __global__ __aicore__ void grouped_matmul_gelu_panel_pair_resident(
GM_ADDR x,GM_ADDR w,GM_ADDR s,GM_ADDR g,GM_ADDR y,GM_ADDR scratch,gmg::Plan p) {
KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
AscendC::SetSyncBaseAddr(p.ffts);
panel_pair_family::Kernel::Params params{direct_core::GemmCoord{p.m,p.n,p.k},p.e,g,
x,direct_core::layout::RowMajor{p.m,p.k},w,direct_core::layout::RowMajor{p.k,p.n},
s,direct_core::layout::VectorLayout{p.n},y,direct_core::layout::RowMajor{p.m,p.n},scratch};
panel_pair_family::Kernel op;op(params);
}
inline bool TryPairedPanels(GM_ADDR x,GM_ADDR w,GM_ADDR s,GM_ADDR g,GM_ADDR y,
int64_t e,int64_t m,int64_t k,int64_t n,int64_t cores,aclrtStream stream) {
if(e<1 || m<96*e || m>160*e || k<512 || k>1280 || k%256 ||
n<512 || n>2048 || n%512 || cores<1)return false;
auto* hw=platform_ascendc::PlatformAscendCManager::GetInstance();if(!hw)return false;
const uint64_t lowerPackets=uint64_t((m+127)/128)*(n/512);
const uint32_t blocks=std::min<uint64_t>(lowerPackets,std::min<int64_t>(cores,std::min<int64_t>(hw->GetCoreNumAic(),hw->GetCoreNumAiv()/2)));
if(!blocks)return false;
uint64_t l1=0,a=0,b=0,c=0,ub=0;
hw->GetCoreMemSize(platform_ascendc::CoreMemType::L1,l1);
hw->GetCoreMemSize(platform_ascendc::CoreMemType::L0_A,a);
hw->GetCoreMemSize(platform_ascendc::CoreMemType::L0_B,b);
hw->GetCoreMemSize(platform_ascendc::CoreMemType::L0_C,c);
hw->GetCoreMemSize(platform_ascendc::CoreMemType::UB,ub);
if(l1<393216 || a<65536 || b<65536 || c<131072 || ub<184384)return false;
uint64_t ffts=0;uint32_t len=0;
if(rtGetC2cCtrlAddr(&ffts,&len)!=0)throw std::runtime_error("Panel pair FFTS unavailable");
uint8_t* scratch=nullptr;
if(aclrtMalloc(reinterpret_cast<void**>(&scratch),uint64_t(blocks)*2*128*256*4,ACL_MEM_MALLOC_HUGE_FIRST)!=ACL_SUCCESS)
throw std::runtime_error("Panel pair workspace unavailable");
gmg::Plan p{};p.e=e;p.m=m;p.k=k;p.n=n;p.blocks=blocks;p.backend=1;p.ffts=ffts;
grouped_matmul_gelu_panel_pair_resident<<<blocks,nullptr,stream>>>(x,w,s,g,y,scratch,p);
const auto status=aclrtSynchronizeStream(stream);aclrtFree(scratch);
if(status!=ACL_SUCCESS)throw std::runtime_error("Panel pair kernel failed");return true;
}
namespace public_gmg {
class MidEpilogue {
public:
using ElementScale=float; using LayoutScale=layout::VectorLayout;
using ElementD=half; using LayoutD=layout::RowMajor;
using Params=DescriptorBankStableEpilogue::Params;
__aicore__ __forceinline__ MidEpilogue(Arch::Resource &resource) {
Buffer *buffers[]={&zb,&qb,&sb,&yb};
const uint32_t offsets[]={0,65792,131328,133632};
for(uint32_t i=0;i<4;++i)buffers[i]->tensor=resource.ubBuf.GetBufferByByte<uint8_t>(offsets[i]);
}
__aicore__ __forceinline__ void UpdateParams(Params const&p) {
plan.n=p.yl.stride(0);scale.SetGlobalBuffer(p.sp);y.SetGlobalBuffer(p.yp);
}
__aicore__ __forceinline__ void operator()(GemmCoord const&shape,GemmCoord const&coord,
GemmCoord const&actual,GlobalTensor<int32_t> const&src,layout::RowMajor const&srcLayout,Arch::CrossCoreFlag &ack) {
const uint32_t perSub=(actual.m()+1)/2,first=GetSubBlockIdx()*perSub;
const uint32_t end=first+perSub<actual.m()?first+perSub:actual.m();
if(first>=end){Arch::Signal<PIPE_MTE3>(ack);return;}
accumStride=srcLayout.stride(0);accum=src[uint64_t(first)*accumStride];
Compute64(coord.m()*shape.m()+first,coord.n()*shape.n(),end-first,actual.n(),ack);
}
private:
__aicore__ __forceinline__ void Compute64(uint32_t row,uint32_t col,uint32_t vm,uint32_t vn,Arch::CrossCoreFlag &ack) {
const uint32_t e=0, stride=(vn+7)/8*8, len=vm*stride;
auto ci = qb.Get<int32_t>();
auto z = zb.Get<float>();
auto q = qb.Get<float>();
auto s = sb.Get<float>();
auto out = yb.Get<half>();
DataCopyPad(ci, accum,
DataCopyExtParams{static_cast<uint16_t>(vm), vn * 4, (accumStride - vn) * 4, 0, 0},
DataCopyPadExtParams<int32_t>{true, 0, static_cast<uint8_t>(stride - vn), 0});
DataCopyPad(s, scale[uint64_t(e) * plan.n + col],
DataCopyExtParams{1, vn * 4, 0, 0, 0},
DataCopyPadExtParams<float>{true, 0, static_cast<uint8_t>(stride - vn), 0.0f});
Arch::Signal<PIPE_MTE2>(ack);
SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
Cast(z, ci, RoundMode::CAST_RINT, len);
BinaryRepeatParams br;
br.dstBlkStride = 1; br.src0BlkStride = 1; br.src1BlkStride = 1;
br.dstRepStride = stride / 8; br.src0RepStride = stride / 8; br.src1RepStride = 0;
for (uint32_t col = 0; col < stride; col += 64) {
const uint64_t mask = stride - col < 64 ? stride - col : 64;
Mul(z[col], z[col], s[col], mask, static_cast<uint8_t>(vm), br);
}
Mul(q, z, z, len);
Muls(q, q, 0.044715f, len);
Adds(q, q, 1.0f, len);
Mul(q, q, z, len);
Muls(q, q, -1.5957691216057308f, len);
Mins(q, q, 87.0f, len);
Exp(q, q, len);
Adds(q, q, 1.0f, len);
Div(q, z, q, len);
Cast(out,q,RoundMode::CAST_RINT,len);
SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
DataCopyPad(y[uint64_t(row)*plan.n+col],out,
DataCopyExtParams{static_cast<uint16_t>(vm),vn*2,
(stride-(vn+15)/16*16)/16,(plan.n-vn)*2,0});
PipeBarrier<PIPE_ALL>();
}
uint32_t accumStride;struct{uint32_t n;}plan;
GlobalTensor<float>scale;GlobalTensor<half>y;GlobalTensor<int32_t>accum;
Buffer zb,qb,sb,yb;
};
}
namespace mid64 {
using namespace direct_core;
template<uint32_t NT,uint32_t BK,uint32_t BS>
struct FullAMmad:public Case1DeepMmad<GemmShape<64,512,256>,GemmShape<64,256,128>> {
bool reuseA=false;
using Parent=Case1DeepMmad<GemmShape<64,512,256>,GemmShape<64,256,128>>;
using L1TileShape=GemmShape<64,NT,BK>;
DIRECT_DEVICE FullAMmad(Arch::Resource&r):Parent(r){
l1ATensorList[0]=r.l1Buf.GetBufferByByte<int8_t>(0);
for(uint32_t i=0;i<BS;++i)l1BTensorList[i]=r.l1Buf.GetBufferByByte<int8_t>(98304+i*BK*NT);
}
DIRECT_DEVICE void CopyB(AscendC::LocalTensor<int8_t>const&dst,AscendC::GlobalTensor<int8_t>const&src,layout::RowMajor const&bl,uint32_t k,uint32_t n){
AscendC::Nd2NzParams p;p.ndNum=k/32;p.nValue=32;p.dValue=n;p.srcDValue=bl.stride(0);p.srcNdMatrixStride=32*bl.stride(0);p.dstNzC0Stride=32;p.dstNzNStride=1;p.dstNzMatrixStride=32*n;AscendC::DataCopy(dst,src,p);
}
DIRECT_DEVICE void operator()(AscendC::GlobalTensor<int8_t>const&ga,LayoutA const&al,AscendC::GlobalTensor<int8_t>const&gb,LayoutB const&bl,AscendC::GlobalTensor<int32_t>const&gc,LayoutC const&cl,GemmCoord const&s){
const uint32_t mr=RoundUp<16>(s.m()),nr=RoundUp<32>(s.n()),step=nr>256?64:(BK%128?64:128),slabs=CeilDiv(s.k(),BK);
auto la=LayoutAInL1::MakeLayout<int8_t>(80,s.k());auto lc=LayoutCInL0::MakeLayoutInL0C(MakeCoord(mr,nr));
AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(l1AEventList[0]);if(!reuseA)copyGmToL1A(l1ATensorList[0],ga,la,al.GetTileLayout(MakeCoord(s.m(),s.k())));AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(l1AEventList[0]);
for(uint32_t j=0;j<BS-1&&j<slabs;++j){AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(l1BEventList[j]);CopyB(l1BTensorList[j],gb[uint64_t(j)*BK*bl.stride(0)],bl,min(s.k()-j*BK,BK),nr);AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(l1BEventList[j]);}
AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(EVENT_ID0);
for(uint32_t kk=0;kk<s.k();kk+=step){
uint32_t slab=kk/BK,id=slab%BS,vk=min(s.k()-kk,step);
if(kk%BK==0){uint32_t future=slab+BS-1;if(future<slabs){uint32_t next=future%BS;AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(l1BEventList[next]);CopyB(l1BTensorList[next],gb[uint64_t(future)*BK*bl.stride(0)],bl,min(s.k()-future*BK,BK),nr);AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(l1BEventList[next]);}}
auto aa=l0ATensorList[l0AListId],bb=l0BTensorList[l0BListId];auto a0=LayoutAInL0::MakeLayout<int8_t>(mr,vk);auto b0=LayoutBInL0::MakeLayout<int8_t>(vk,nr);
AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(l0AEventList[l0AListId]);if(kk==0)AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(l1AEventList[0]);copyL1ToL0A(aa,l1ATensorList[0][la.GetOffset(MatrixCoord{0,kk})],a0,la);if(kk+vk==s.k())AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(l1AEventList[0]);
AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(l0BEventList[l0BListId]);if(kk%BK==0)AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(l1BEventList[id]);
AscendC::LoadData2dTransposeParams lp;lp.startIndex=0;lp.repeatTimes=(vk/32)*(nr/32);lp.srcStride=1;lp.dstGap=1;lp.dstFracGap=0;lp.addrMode=0;AscendC::LoadDataWithTranspose(bb,l1BTensorList[id][uint64_t(kk%BK)*nr],lp);
if(kk+vk==min((slab+1)*BK,s.k()))AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(l1BEventList[id]);
AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID0);AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID0);tileMmad(l0CTensor,aa,bb,mr,nr,vk,kk==0,0);
AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(l0AEventList[l0AListId]);AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(l0BEventList[l0BListId]);l0AListId^=1;l0BListId^=1;
}
AscendC::SetFlag<AscendC::HardEvent::M_FIX>(EVENT_ID0);AscendC::WaitFlag<AscendC::HardEvent::M_FIX>(EVENT_ID0);copyL0CToGm(gc,l0CTensor,cl.GetTileLayout(s.GetCoordMN()),lc);AscendC::SetFlag<AscendC::HardEvent::FIX_M>(EVENT_ID0);
}
};
template<class Mmad,class Epi,uint32_t NT,bool WEIGHTED,uint32_t CS>
class UniformKernel {
public:using Params=GroupParams;
struct Job{uint32_t expert,col,width;};
class Iterator{
public:DIRECT_DEVICE Iterator(uint32_t e,uint32_t n,uint32_t c,uint32_t cs):experts(e),n(n),core(c),cores(cs){}
DIRECT_DEVICE bool Next(Job&j){
if constexpr(NT==512){
while(index<experts*2){uint32_t at=index++,phase=at%2,e=at/2,owner;
if(!phase)owner=e%cores;
else if constexpr(WEIGHTED){uint32_t heavy=experts%cores,light=cores-heavy;owner=(e<cores || experts>2*cores)?e%cores:heavy+(e-cores)%light;}
else owner=at%cores;
if(owner==core){j={e,phase*512,phase?n-512:512};return true;}
}
}else{
const uint32_t tiles=(n+NT-1)/NT;
while(index<experts*tiles){uint32_t at=index++;if(at%cores==core){uint32_t col=(at%tiles)*NT;j={at/tiles,col,min(n-col,NT)};return true;}}
}
return false;
}
private:uint32_t experts,n,core,cores,index=0;
};
DIRECT_DEVICE UniformKernel(Arch::Resource&r):resource(r){for(uint32_t i=0;i<CS;++i){ready[i]=Arch::CrossCoreFlag(2*i);ack[i]=Arch::CrossCoreFlag(2*i+1);}}
DIRECT_DEVICE void operator()(Params const&p){if constexpr(g_coreType==AscendC::AIC)Cube(p);else Vector(p);}
DIRECT_DEVICE void Cube(Params const&p){
AscendC::ICachePreLoad(1);Mmad mma(resource);uint32_t core=AscendC::GetBlockIdx(),cores=AscendC::GetBlockNum(),stage=0,used=0;Iterator it(p.problemCount,p.problemShape.n(),core,cores);Job j;
AscendC::GlobalTensor<int8_t>a,b;AscendC::GlobalTensor<int32_t>c;a.SetGlobalBuffer(p.ptrA);b.SetGlobalBuffer(p.ptrB);c.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(p.ptrWorkspace));
uint32_t lastExpert=0xffffffff;
while(it.Next(j)){
mma.reuseA=j.expert==lastExpert;lastExpert=j.expert;
if(used==CS)Arch::Wait(ack[stage]);else ++used;
mma(a[uint64_t(j.expert)*64*p.problemShape.k()],p.layoutA,b[uint64_t(j.expert)*p.problemShape.k()*p.problemShape.n()+j.col],p.layoutB,c[uint64_t(stage*cores+core)*64*NT],layout::RowMajor{64,NT},GemmCoord{64,j.width,p.problemShape.k()});Arch::Signal<PIPE_FIX>(ready[stage]);stage=(stage+1)%CS;
}
while(used){uint32_t i=(stage+CS-used)%CS;Arch::Wait(ack[i]);--used;}AscendC::PipeBarrier<PIPE_ALL>();
}
DIRECT_DEVICE void Vector(Params const&p){
AscendC::ICachePreLoad(1);Epi ep(resource);uint32_t core=AscendC::GetBlockIdx()/AscendC::GetSubBlockNum(),cores=AscendC::GetBlockNum(),stage=0;Iterator it(p.problemCount,p.problemShape.n(),core,cores);Job j;
AscendC::GlobalTensor<int32_t>c;c.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(p.ptrWorkspace));
while(it.Next(j)){
typename Epi::Params q{p.ptrScale+uint64_t(j.expert)*p.problemShape.n(),p.layoutScale,p.ptrD+uint64_t(j.expert)*64*p.problemShape.n(),p.layoutD};ep.UpdateParams(q);Arch::Wait(ready[stage]);ep(GemmCoord{64,NT,1024},GemmCoord{0,j.col/NT,0},GemmCoord{64,j.width,p.problemShape.k()},c[uint64_t(stage*cores+core)*64*NT],layout::RowMajor{64,NT},ack[stage]);stage=(stage+1)%CS;
}AscendC::PipeBarrier<PIPE_ALL>();
}
private:Arch::Resource &resource;Arch::CrossCoreFlag ready[CS],ack[CS];
};
}
namespace mid64 {
template<uint32_t NT>
DIRECT_DEVICE bool Verify64(GM_ADDR gp,GM_ADDR scratch,gmg::Plan const&p,Arch::Resource &resource){
const uint64_t offset=uint64_t(p.blocks)*3*64*NT*4;
AscendC::GlobalTensor<int64_t> status;status.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(scratch+offset));
Arch::CrossCoreFlag checked(14);
if constexpr(g_coreType==AscendC::AIC){
Arch::Wait(checked);AscendC::DataCacheCleanAndInvalid<int64_t,AscendC::CacheLine::SINGLE_CACHE_LINE,AscendC::DcciDst::CACHELINE_OUT>(status[uint64_t(AscendC::GetBlockIdx())*8]);AscendC::PipeBarrier<PIPE_ALL>();return status.GetValue(uint64_t(AscendC::GetBlockIdx())*8)==1;
}else{
bool uniform=true;
{
auto local=resource.ubBuf.GetBufferByByte<int64_t>(0);AscendC::GlobalTensor<int64_t> groups;groups.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(gp));
AscendC::DataCopyPad(local,groups,AscendC::DataCopyExtParams{1,uint32_t(p.e)*8,0,0,0},AscendC::DataCopyPadExtParams<int64_t>{false,0,0,0});
AscendC::SetFlag<AscendC::HardEvent::MTE2_S>(EVENT_ID0);AscendC::WaitFlag<AscendC::HardEvent::MTE2_S>(EVENT_ID0);
for(uint32_t i=0;i<p.e;++i)if(local.GetValue(i)!=int64_t(i+1)*64){uniform=false;break;}
local.SetValue(0,uniform?1:0);
AscendC::SetFlag<AscendC::HardEvent::S_MTE3>(EVENT_ID0);AscendC::WaitFlag<AscendC::HardEvent::S_MTE3>(EVENT_ID0);
const uint32_t core=AscendC::GetBlockIdx()/AscendC::GetSubBlockNum(),sub=AscendC::GetSubBlockIdx();
AscendC::DataCopy(status[uint64_t(core)*8+sub*4],local,4);
Arch::Signal<PIPE_MTE3>(checked);AscendC::PipeBarrier<PIPE_ALL>();
}
return uniform;
}
}
}
namespace mid64_selected {using Mmad=mid64::FullAMmad<512,128,3>;using Kernel=mid64::UniformKernel<Mmad,public_gmg::MidEpilogue,512,true,3>;}
extern "C" __global__ __aicore__ __attribute__((section(".mid64_special")))
void grouped_matmul_gelu_hdmid64_special(GM_ADDR x,GM_ADDR w,GM_ADDR s,GM_ADDR g,GM_ADDR y,GM_ADDR scratch,gmg::Plan p){
KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);AscendC::SetSyncBaseAddr(p.ffts);
direct_core::Arch::Resource resource;bool uniform=mid64::Verify64<512>(g,scratch,p,resource);
direct_core::GroupParams params{direct_core::GemmCoord{p.m,p.n,p.k},p.e,g,x,direct_core::layout::RowMajor{p.m,p.k},w,direct_core::layout::RowMajor{p.k,p.n},s,direct_core::layout::VectorLayout{p.n},y,direct_core::layout::RowMajor{p.m,p.n},scratch};
if(uniform){mid64_selected::Kernel op(resource);op(params);}else{hdl_r1::Kernel op;op(params);}
}
inline bool TryUniformRows(GM_ADDR x,GM_ADDR w,GM_ADDR s,GM_ADDR g,GM_ADDR y,int64_t e,int64_t m,int64_t k,int64_t n,int64_t cores,aclrtStream stream){
if(m>64*e || k<768 || k>1024 || k%128 || n<=512 || n>1024 || cores<1)return false;
auto *hw=platform_ascendc::PlatformAscendCManager::GetInstance();if(!hw)return false;
const uint32_t blocks=std::min<int64_t>(20,std::min<int64_t>(cores,std::min<int64_t>(hw->GetCoreNumAic(),hw->GetCoreNumAiv()/2)));if(!blocks)return false;
uint64_t l1=0,a=0,b=0,c=0,ub=0;
hw->GetCoreMemSize(platform_ascendc::CoreMemType::L1,l1);hw->GetCoreMemSize(platform_ascendc::CoreMemType::L0_A,a);hw->GetCoreMemSize(platform_ascendc::CoreMemType::L0_B,b);hw->GetCoreMemSize(platform_ascendc::CoreMemType::L0_C,c);hw->GetCoreMemSize(platform_ascendc::CoreMemType::UB,ub);
if(l1<491520 || a<65536 || b<65536 || c<131072 || ub<166400)return false;
uint64_t ffts=0;uint32_t len=0;if(rtGetC2cCtrlAddr(&ffts,&len)!=0)throw std::runtime_error("HDMid FFTS unavailable");
const uint64_t bytes=uint64_t(blocks)*3*64*512*4+uint64_t(blocks)*64;
uint8_t *scratch=nullptr;if(aclrtMalloc(reinterpret_cast<void**>(&scratch),bytes,ACL_MEM_MALLOC_HUGE_FIRST)!=ACL_SUCCESS)throw std::runtime_error("HDMid scratch unavailable");
gmg::Plan p{};p.e=e;p.m=m;p.k=k;p.n=n;p.blocks=blocks;p.backend=1;p.ffts=ffts;
grouped_matmul_gelu_hdmid64_special<<<blocks,nullptr,stream>>>(x,w,s,g,y,scratch,p);
auto status=aclrtSynchronizeStream(stream);aclrtFree(scratch);if(status!=ACL_SUCCESS)throw std::runtime_error("HDMid kernel failed");return true;
}
namespace p4r {
using namespace direct_core;
using namespace AscendC;
using public_gmg::Buffer;
using public_gmg::BankStableEpilogue;
template <uint32_t Width>
class WideRowsEpilogue {
public:
using ElementScale = BankStableEpilogue::ElementScale;
using LayoutScale = BankStableEpilogue::LayoutScale;
using ElementD = BankStableEpilogue::ElementD;
using LayoutD = BankStableEpilogue::LayoutD;
using Params = BankStableEpilogue::Params;
__aicore__ __forceinline__ WideRowsEpilogue(Arch::Resource &resource) {
for(uint32_t i=0;i<2;++i)yb[i].tensor=resource.ubBuf.GetBufferByByte<uint8_t>(i*16640);
for(uint32_t i=0;i<2;++i){zb[i].tensor=resource.ubBuf.GetBufferByByte<uint8_t>(33536+i*33024);sb[i].tensor=resource.ubBuf.GetBufferByByte<uint8_t>(133120+i*1280);}
qb.tensor=resource.ubBuf.GetBufferByByte<uint8_t>(99840);
}
__aicore__ __forceinline__ ~WideRowsEpilogue(){
if(pending.valid)Finish(pending);
for(uint32_t i=0;i<2;++i)if(zPending[i])WaitFlag<HardEvent::S_MTE2>(i);
for(uint32_t i=0;i<2;++i)if(yPending[i])WaitFlag<HardEvent::MTE3_V>(i);
PipeBarrier<PIPE_V>();
}
__aicore__ __forceinline__ void UpdateParams(Params const &p) {
plan.n=p.yl.stride(0); scale.SetGlobalBuffer(p.sp); y.SetGlobalBuffer(p.yp);
const uint32_t rows=p.yl.shape(0),perSub=(rows+1)/2;
scalePrefetched=GetSubBlockIdx()*perSub<rows;
if(scalePrefetched){if(zPending[nextSlot])WaitFlag<HardEvent::S_MTE2>(nextSlot);DataCopy(sb[nextSlot].Get<float>(),scale,Width);}
}
__aicore__ __forceinline__ void operator()(GemmCoord const &shape, GemmCoord const &coord,
GemmCoord const &actual, GlobalTensor<int32_t> const &src, layout::RowMajor const &srcLayout, Arch::CrossCoreFlag &ack) {
const uint32_t perSub=(actual.m()+1)/2;
const uint32_t first=GetSubBlockIdx()*perSub;
const uint32_t end=first+perSub<actual.m()?first+perSub:actual.m();
constexpr uint32_t chunkRows = 8192 / Width;
accumStride = srcLayout.stride(0);
const uint32_t col = coord.n() * shape.n();
for (uint32_t local = first; local < end; local += chunkRows) {
const uint32_t count = min(chunkRows, end - local);
const uint32_t row = coord.m() * shape.m() + local;
accum = src[uint64_t(local) * accumStride];
if (count == chunkRows) Begin<chunkRows>(row, col, count, nextSlot,nextOut);
else Begin<0>(row, col, count, nextSlot,nextOut);
if (pending.valid) Finish(pending);
pending = {row, col, count, nextSlot,nextOut, plan.n, y, true};
nextSlot ^= 1;nextOut=(nextOut+1)%2;
}
Arch::Signal<PIPE_MTE2>(ack);
}
private:
struct Pending {
uint32_t row = 0;
uint32_t col = 0;
uint32_t rows = 0;
uint32_t slot = 0;
uint32_t outSlot = 0;
uint32_t stride = 0;
GlobalTensor<half> output;
bool valid = false;
};
__aicore__ __forceinline__ void MakeRisk(LocalTensor<float>,uint32_t,uint32_t slot){SetFlag<HardEvent::V_S>(slot);}
__aicore__ __forceinline__ void Finish(const Pending&tile){
const uint32_t zslot=tile.slot,yslot=tile.outSlot,len=tile.rows*Width;
WaitFlag<HardEvent::V_S>(zslot);
SetFlag<HardEvent::S_MTE3>(EVENT_ID0);WaitFlag<HardEvent::S_MTE3>(EVENT_ID0);
DataCopy(tile.output[uint64_t(tile.row)*tile.stride],yb[yslot].Get<half>(),len);
SetFlag<HardEvent::MTE3_V>(yslot);SetFlag<HardEvent::S_MTE2>(zslot);
zPending[zslot]=true;yPending[yslot]=true;
}
template <uint32_t FixedRows>
__aicore__ __forceinline__ void Begin(uint32_t row, uint32_t col, uint32_t rows, uint32_t slot,uint32_t outSlot) {
const uint32_t vm = FixedRows == 0 ? rows : FixedRows;
constexpr uint32_t vn = Width;
constexpr uint32_t stride = vn;
const uint32_t len = vm * stride;
auto z = zb[slot].Get<float>();
auto q = qb.Get<float>();
auto s = sb[slot].Get<float>();
auto out = yb[outSlot].Get<half>();
if (zPending[slot] && !scalePrefetched) WaitFlag<HardEvent::S_MTE2>(slot);
auto ci = z.ReinterpretCast<int32_t>();
DataCopy(ci, accum, len);
if(!scalePrefetched)DataCopy(s, scale[col], vn);scalePrefetched=false;
SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
SetMaskNorm();SetVectorMask<float>(64);
const uint8_t reps=static_cast<uint8_t>(vm*4);
UnaryRepeatParams ur;ur.dstBlkStride=1;ur.srcBlkStride=1;ur.dstRepStride=8;ur.srcRepStride=8;
UnaryRepeatParams castOut;castOut.dstBlkStride=1;castOut.srcBlkStride=1;castOut.dstRepStride=4;castOut.srcRepStride=8;
BinaryRepeatParams flat;flat.dstBlkStride=1;flat.src0BlkStride=1;flat.src1BlkStride=1;flat.dstRepStride=8;flat.src0RepStride=8;flat.src1RepStride=8;
Cast<float,int32_t,false>(z,ci,RoundMode::CAST_RINT,uint64_t(64),reps,ur);
PipeBarrier<PIPE_V>();
BinaryRepeatParams br;
br.dstBlkStride = 1; br.src0BlkStride = 1; br.src1BlkStride = 1;
br.dstRepStride = stride / 8; br.src0RepStride = stride / 8; br.src1RepStride = 0;
for (uint32_t col = 0; col < stride; col += 64) {
const uint64_t mask = stride - col < 64 ? stride - col : 64;
Mul<float,false>(z[col],z[col],s[col],mask,static_cast<uint8_t>(vm),br);
}
PipeBarrier<PIPE_V>();
Mul<float,false>(q,z,z,uint64_t(64),reps,flat);
PipeBarrier<PIPE_V>();
Mul<float,false>(q,q,z,uint64_t(64),reps,flat);
PipeBarrier<PIPE_V>();
Axpy<float,float,false>(q,z,22.363860002236386f,uint64_t(64),reps,ur);
PipeBarrier<PIPE_V>();
Muls<float,false>(q,q,-0.07135481627260025f,uint64_t(64),reps,ur);
PipeBarrier<PIPE_V>();
Mins<float,false>(q,q,87.0f,uint64_t(64),reps,ur);
PipeBarrier<PIPE_V>();
Exp<float,false>(q,q,uint64_t(64),reps,ur);
PipeBarrier<PIPE_V>();
Adds<float,false>(q,q,1.0f,uint64_t(64),reps,ur);
PipeBarrier<PIPE_V>();
Div<float,false>(q,z,q,uint64_t(64),reps,flat);
PipeBarrier<PIPE_V>();
if(yPending[outSlot])WaitFlag<HardEvent::MTE3_V>(outSlot);
Cast<half,float,false>(out,q,RoundMode::CAST_RINT,uint64_t(64),reps,castOut);
PipeBarrier<PIPE_V>();
SetVectorMask<float>(uint64_t(-1),uint64_t(-1));
MakeRisk(q, len, slot);
}
bool scalePrefetched{false};
Pending pending;
uint32_t nextSlot = 0;
uint32_t nextOut=0;bool zPending[2]={false,false};bool yPending[2]={false};
uint32_t accumStride;
struct { uint32_t n; } plan;
GlobalTensor<float> scale;
GlobalTensor<half> y;
GlobalTensor<int32_t> accum;
Buffer zb[2],yb[2],sb[2],qb;
};
template <uint32_t Rows>
using CubeBase = DirectInt8Block<GemmShape<Rows, 256, 256>, GemmShape<Rows, 256, 128>>;
template <uint32_t Rows>
class Cube : public CubeBase<Rows> {
using Base = CubeBase<Rows>;
public:
using typename Base::ArchTag;
using typename Base::ElementA;
using typename Base::ElementB;
using typename Base::ElementC;
using typename Base::ElementAccumulator;
using typename Base::LayoutA;
using typename Base::LayoutB;
using typename Base::LayoutC;
using typename Base::LayoutAInL1;
using typename Base::LayoutBInL1;
using typename Base::LayoutAInL0;
using typename Base::LayoutBInL0;
using typename Base::LayoutCInL0;
using Base::l1ATensorList, Base::l1BTensorList, Base::l1AEventList, Base::l1BEventList;
using Base::l0ATensorList, Base::l0BTensorList, Base::l0CTensor;
using Base::l0AListId, Base::l0BListId, Base::l0AEventList, Base::l0BEventList;
using Base::copyGmToL1A, Base::copyGmToL1B, Base::copyL1ToL0A, Base::tileMmad, Base::copyL0CToGm;
DIRECT_DEVICE explicit Cube(Arch::Resource& resource) : Base(resource) {
if constexpr (Rows <= 64) {
secondC = resource.l0CBuf.template GetBufferByByte<ElementAccumulator>(Rows * 256 * sizeof(ElementAccumulator));
SetFlag<HardEvent::FIX_M>(EVENT_ID1);
}
}
DIRECT_DEVICE ~Cube() {
if constexpr (Rows <= 64) WaitFlag<HardEvent::FIX_M>(EVENT_ID1);
}
DIRECT_DEVICE void Load(const GlobalTensor<ElementA>& gmA, const LayoutA& layoutA,
const GlobalTensor<ElementB>& gmB, const LayoutB& layoutB, const GemmCoord& shape,
uint32_t slot, uint32_t weightSlot, bool first) {
const auto aL1 = LayoutAInL1::template MakeLayout<ElementA>(Rows, 256);
const auto bL1 = LayoutBInL1::template MakeLayout<ElementB>(256, 256);
WaitFlag<HardEvent::MTE1_MTE2>(l1AEventList[slot]);
copyGmToL1A(l1ATensorList[slot], gmA, aL1, layoutA.GetTileLayout(shape.GetCoordMK()));
SetFlag<HardEvent::MTE2_MTE1>(l1AEventList[slot]);
if (first) {
WaitFlag<HardEvent::MTE1_MTE2>(l1BEventList[weightSlot]);
copyGmToL1B(l1BTensorList[weightSlot], gmB, bL1, layoutB.GetTileLayout(shape.GetCoordKN()));
SetFlag<HardEvent::MTE2_MTE1>(l1BEventList[weightSlot]);
}
}
DIRECT_DEVICE void Compute(const GlobalTensor<ElementC>& gmC, const LayoutC& layoutC,
const GemmCoord& shape, uint32_t slot, uint32_t weightSlot, uint16_t waitFlag, bool first, bool last) {
const uint32_t m = RoundUp<16>(shape.m());
const auto aL1 = LayoutAInL1::template MakeLayout<ElementA>(Rows, 256);
const auto bL1 = LayoutBInL1::template MakeLayout<ElementB>(256, 256);
const auto cL0 = LayoutCInL0::MakeLayoutInL0C(MakeCoord(m, 256U));
const bool useSecond = Rows <= 64 && slot == 1;
const auto accumulator = useSecond ? secondC : l0CTensor;
const uint32_t event = useSecond ? EVENT_ID1 : EVENT_ID0;
WaitFlag<HardEvent::FIX_M>(event);
WaitFlag<HardEvent::MTE2_MTE1>(l1AEventList[slot]);
if (first) WaitFlag<HardEvent::MTE2_MTE1>(l1BEventList[weightSlot]);
for (uint32_t k = 0; k < shape.k(); k += 128) {
const uint32_t count = min(128U, shape.k() - k);
const auto aL0 = LayoutAInL0::template MakeLayout<ElementA>(m, count);
const auto bL0 = LayoutBInL0::template MakeLayout<ElementB>(count, 256);
const auto a = l0ATensorList[l0AListId];
const auto b = l0BTensorList[l0BListId];
WaitFlag<HardEvent::M_MTE1>(l0AEventList[l0AListId]);
copyL1ToL0A(a, l1ATensorList[slot][aL1.GetOffset(MatrixCoord{0U, k})], aL0, aL1);
WaitFlag<HardEvent::M_MTE1>(l0BEventList[l0BListId]);
const auto panel = l1BTensorList[weightSlot][bL1.GetOffset(MatrixCoord{k, 0U})];
LoadData2dTransposeParams load{};
load.repeatTimes = count / 32;
load.srcStride = 1;
load.dstGap = bL0.rowBlockPitch / 512 - 1;
for (uint32_t col = 0; col < 8; ++col)
LoadDataWithTranspose(b[col * 2 * 512U], panel[col * bL1.columnPitch], load);
if (k + 128 >= shape.k()) {
SetFlag<HardEvent::MTE1_MTE2>(l1AEventList[slot]);
if (last) SetFlag<HardEvent::MTE1_MTE2>(l1BEventList[weightSlot]);
}
SetFlag<HardEvent::MTE1_M>(EVENT_ID0);
WaitFlag<HardEvent::MTE1_M>(EVENT_ID0);
tileMmad(accumulator, a, b, m, 256U, count, k == 0, 0);
SetFlag<HardEvent::M_MTE1>(l0AEventList[l0AListId]);
SetFlag<HardEvent::M_MTE1>(l0BEventList[l0BListId]);
l0AListId ^= 1;
l0BListId ^= 1;
}
if (waitFlag != 0xffff) AscendC::CrossCoreWaitFlag(waitFlag);
SetFlag<HardEvent::M_FIX>(event);
WaitFlag<HardEvent::M_FIX>(event);
copyL0CToGm(gmC, accumulator, layoutC.GetTileLayout(shape.GetCoordMN()), cL0);
SetFlag<HardEvent::FIX_M>(event);
}
private:
LocalTensor<ElementAccumulator> secondC;
};
template <uint32_t Rows, uint32_t Stages>
class RowKernel {
static constexpr uint32_t Width = 256;
static constexpr uint32_t TileElements = Rows * Width;
struct Task {
uint32_t row, rows, expert;
};
public:
DIRECT_DEVICE RowKernel(GM_ADDR x, GM_ADDR w, GM_ADDR scale, GM_ADDR groups, GM_ADDR y,
GM_ADDR scratch, gmg::Plan plan) : scalePtr(reinterpret_cast<__gm__ float*>(scale)),
outputPtr(reinterpret_cast<__gm__ half*>(y)), experts(plan.e), m(plan.m), k(plan.k) {
const uint32_t subblocks = AscendC::GetSubBlockNum();
if constexpr (g_coreType == AscendC::AIC) core = AscendC::GetBlockIdx();
else core = AscendC::GetBlockIdx() / subblocks;
cores = AscendC::GetBlockNum();
input.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
weights.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(w));
groupEnds.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups));
workspace.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(scratch));
for (uint32_t i = 0; i < Stages; ++i) {
produced[i] = Arch::CrossCoreFlag(i * 2);
consumed[i] = Arch::CrossCoreFlag(i * 2 + 1);
}
}
template <int32_t CoreType = g_coreType>
DIRECT_DEVICE void Run() {
if constexpr (CoreType == AscendC::AIC) RunCube();
else RunVector();
}
private:
class RowCursor {
public:
DIRECT_DEVICE RowCursor(const GlobalTensor<int64_t>& groups, uint32_t experts,
uint32_t first, uint32_t last) : ends(groups), row(first), stop(last) {
if (row >= stop) return;
const uint32_t hint=row/64;
if(hint<experts){const uint32_t end=static_cast<uint32_t>(ends.GetValue(hint));const uint32_t start=hint?static_cast<uint32_t>(ends.GetValue(hint-1)):0;if(start<=row&&row<end){expert=hint;groupEnd=end;return;}}
uint32_t high = experts;
while (expert < high) {
const uint32_t middle = (expert + high) / 2;
if (ends.GetValue(middle) <= row) expert = middle + 1;
else high = middle;
}
groupEnd = static_cast<uint32_t>(ends.GetValue(expert));
}
DIRECT_DEVICE bool Next(Task& task) {
if (row >= stop) return false;
while (row == groupEnd) groupEnd = static_cast<uint32_t>(ends.GetValue(++expert));
const uint32_t rows = min(Rows, min(stop, groupEnd) - row);
task = {row, rows, expert};
row += rows;
return true;
}
private:
const GlobalTensor<int64_t>& ends;
uint32_t row, stop;
uint32_t expert = 0, groupEnd = 0;
};
DIRECT_DEVICE RowCursor Cursor() {
constexpr uint32_t grain = 64;
const uint32_t grains = (m + grain - 1) / grain;
const uint32_t first = min(m, grains * core / cores * grain);
const uint32_t last = min(m, grains * (core + 1) / cores * grain);
return RowCursor(groupEnds, experts, first, last);
}
DIRECT_DEVICE GlobalTensor<int32_t> C(uint32_t stage) {
return workspace[(core * Stages + stage) * TileElements];
}
DIRECT_DEVICE void Prefetch(Cube<Rows>& cube, Task task, uint32_t slot, uint32_t weightSlot, bool first) {
const layout::RowMajor xLayout{m, k};
const layout::RowMajor wLayout{k, Width};
cube.Load(input[uint64_t(task.row) * k], xLayout, weights[uint64_t(task.expert) * k * Width],
wLayout, GemmCoord{task.rows, Width, k}, slot, weightSlot, first);
}
DIRECT_DEVICE void RunCube() {
ICachePreLoad(1);
auto rows = Cursor();
Task current{};
if (!rows.Next(current)) return;
Cube<Rows> cube(resource);
uint32_t weightSlot = 0;
bool first = true;
Prefetch(cube, current, 0, weightSlot, first);
uint32_t count = 0;
for (bool more = true; more; ++count) {
Task next{};
more = rows.Next(next);
const bool last = !more || next.expert != current.expert;
const uint32_t nextWeightSlot = last ? (weightSlot ^ 1) : weightSlot;
if (more) Prefetch(cube, next, (count + 1) % 2, nextWeightSlot, last);
const uint32_t stage = count % Stages;
const uint16_t wait = count >= Stages ? consumed[stage].id : 0xffff;
cube.Compute(C(stage), layout::RowMajor{Rows, Width}, GemmCoord{current.rows, Width, k},
count % 2, weightSlot, wait, first, last);
Arch::Signal<PIPE_FIX>(produced[stage]);
current = next;
weightSlot = nextWeightSlot;
first = last;
}
const uint32_t pending = min(count, Stages);
for (uint32_t i = count - pending; i < count; ++i)
Arch::Wait(consumed[i % Stages]);
PipeBarrier<PIPE_ALL>();
}
DIRECT_DEVICE void RunVector() {
ICachePreLoad(1);
auto rows = Cursor();
WideRowsEpilogue<Width> epilogue(resource);
Task task{};
for (uint32_t i = 0; rows.Next(task); ++i) {
epilogue.UpdateParams({scalePtr + uint64_t(task.expert) * Width, layout::VectorLayout{Width},
outputPtr + uint64_t(task.row) * Width, layout::RowMajor{task.rows, Width}});
const uint32_t stage = i % Stages;
Arch::Wait(produced[stage]);
epilogue(GemmCoord{Rows, Width, k}, GemmCoord{0, 0, 0}, GemmCoord{task.rows, Width, k},
C(stage), layout::RowMajor{task.rows, Width}, consumed[stage]);
}
PipeBarrier<PIPE_ALL>();
}
Arch::Resource resource;
Arch::CrossCoreFlag produced[Stages], consumed[Stages];
GlobalTensor<int8_t> input, weights;
GlobalTensor<int64_t> groupEnds;
GlobalTensor<int32_t> workspace;
__gm__ float* scalePtr;
__gm__ half* outputPtr;
uint32_t experts, m, k, core, cores;
};
}
extern "C" __global__ __aicore__ __attribute__((section(".p4r_special")))
void grouped_matmul_gelu_p4r_special(GM_ADDR x,GM_ADDR w,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,GM_ADDR scratch,gmg::Plan plan){KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);AscendC::SetSyncBaseAddr(plan.ffts);p4r::RowKernel<64,2> op(x,w,scale,groups,y,scratch,plan);op.Run();}
