AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(l1AEventList[0]);
copyGmToL1A(l1ATensorList[0],ga,la,al.GetTileLayout(MakeCoord(min(s.m(),112U),s.k())));
AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(l1AEventList[0]);
AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(l1BEventList[0]);
for(uint32_t row=0;row<s.m();row+=112){
uint32_t idx=(row/112)&1,rows=min(s.m()-row,112U),mr=RoundUp<16>(rows);auto lc=LayoutCInL0::MakeLayoutInL0C(MakeCoord(mr,nr));
if(row+112<s.m()){
