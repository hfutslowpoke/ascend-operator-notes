#include "operator_device.h"



template<bool Five>
__attribute__((aligned(128))) __schedmode__(1) __global__ __mix__(1,2) void ShortWideHbKernel(
    GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groups, GM_ADDR y,
    GM_ADDR workspace, Shape shape, uint32_t partSpan, uint64_t maximumTiles)
{
    Shape mixedShape=shape;
    mixedShape.slabK=176;
    if(hb_mixed::Run(x,weight,scale,groups,y,workspace,mixedShape))return;
    if constexpr(Five)
        if(hb_five::Run(x,weight,scale,groups,y,workspace,mixedShape))return;
    AscendC::TPipe pipe;
    shape.residentK=partSpan;
#ifdef __DAV_CUBE__
    const auto windows=PlanCompactSplitWindows(groups,shape,AscendC::GetBlockNum()/4);
    if(windows)
        SplitNzWindowCubeRun<4,true>(x,weight,groups,workspace,shape,pipe,partSpan,maximumTiles,windows);
    else
        SplitNzCompactCubeRun<4,false,true,true>(x,weight,groups,workspace,shape,pipe,partSpan,maximumTiles);
#endif
    AscendC::SyncAll<false>();
#ifndef __DAV_CUBE__
    PackedSplitCompactVectorRun<4,false,true>(scale,groups,y,workspace,shape,pipe,maximumTiles);
#endif
}

inline bool TrySplitNzPackets(GM_ADDR x, GM_ADDR w, GM_ADDR scale, GM_ADDR groups, GM_ADDR y,
    uint32_t e, uint32_t m, uint32_t k, uint32_t n, int64_t available, aclrtStream stream,
    kernel_common::HostPlatform& platform)
{
    // Resource-defined fallback of the resident long-K route: full K no longer
    // fits at M64, and a narrow N tail makes the smaller M48 route inefficient.
    if (k <= 2048 || k > 8192 || n < 512 || n > 1024 || n % 32 == 0 ||
        m < 128 || m > 2048 || uint64_t(m) < uint64_t(128) * e ||
        n % 256 == 0 || n % 256 > 32) return false;
    const uint32_t capacity = std::min<int64_t>(available,
        std::min(platform.GetCoreNumAic(), platform.GetCoreNumAiv() / 2));
    uint64_t l1 = 0, l0a = 0, l0b = 0, l0c = 0, ub = 0;
    platform.GetCoreMemSize(platform_ascendc::CoreMemType::L1, l1);
    platform.GetCoreMemSize(platform_ascendc::CoreMemType::L0_A, l0a);
    platform.GetCoreMemSize(platform_ascendc::CoreMemType::L0_B, l0b);
    platform.GetCoreMemSize(platform_ascendc::CoreMemType::L0_C, l0c);
    platform.GetCoreMemSize(platform_ascendc::CoreMemType::UB, ub);
    const uint32_t kp = (k + 31) / 32 * 32, np = (n + 31) / 32 * 32;
    if (uint64_t(64) * kp + 131072 <= l1 || capacity < 4 || e > capacity ||
        l0a < 65536 || l0b < 65536 || l0c < 131072 || ub < 160 * 1024 ||
        uint64_t(128) * np + (e + 3) / 4 * 32 + 4096 > ub) return false;
    const uint32_t columns = (n + 127) / 128, blocks = (k + 255) / 256;
    const uint64_t tasks = uint64_t((m + 127) / 128) * columns;
    if (tasks >= 4 * capacity) return false;
    const uint64_t maximumTiles = uint64_t((m + 127) / 128 + e - 1) * columns;
    const uint64_t partialOffset = uint64_t(e) * kp * np;
    uint64_t best = (tasks + capacity - 1) / capacity * blocks;
    uint32_t parts = 0, span = 0, launchBlocks = 0;
    uint64_t bytes = 0;
    for (uint32_t p = 2; p <= 8 && p <= capacity; p *= 2) {
        const uint32_t workers = capacity / p, piece = (blocks + p - 1) / p;
        const uint64_t cost = (tasks + workers - 1) / workers * piece;
        const uint64_t l1Need = uint64_t(128) * piece * 256 + 131072 + 4096;
        const uint64_t count = p == 8 ? 4096 : 8192;
        const uint64_t ubNeed = (p < 3 ? 3 : p) * count * 4 + count * 2 +
            128 * 4 + 256 + (e + 3) / 4 * 32 + 4096;
        const uint64_t allocation = partialOffset + uint64_t(p) * maximumTiles * kTileElements * 4;
        if (cost < best && l1Need <= l1 && ubNeed <= ub && allocation <= 64 * 1024 * 1024) {
            best = cost; parts = p; span = piece * 256; launchBlocks = workers * p; bytes = allocation;
        }
    }
    if (!parts) return false;
    Shape s{}; s.m = m; s.k = k; s.n = n; s.experts = e;
    s.rowTile = 128; s.columnTiles = columns; s.kTile = 256; s.slabK = np; s.packedPartials = 1;
    const bool directB = parts == 4 && uint64_t(176) * span + 131072 + 4096 <= l1;
    const uint64_t workspaceBytes = directB ? bytes - partialOffset : bytes;
    bool mixed=directB && launchBlocks==20 && span==2048 && e==3 && m<=672 &&
        (k+127)/128==64 && n>512 && n<=544 && l1>=479232 && ub>=164640;
    const uint64_t mixedBytes=6ull*4*columns*hb_mixed::MaxSlab*128*sizeof(int32_t);
    constexpr uint64_t mixedL1=uint64_t(hb_mixed::MaxSlab)*(11*128)+2ull*512*128+4096;
    mixed = mixed && mixedL1 <= l1;
    void* memory = nullptr;
    if (mixed && aclrtMalloc(&memory, std::max(mixedBytes,workspaceBytes), ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS)
        mixed=false;
    if (!mixed && aclrtMalloc(&memory, workspaceBytes, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS)
        throw std::runtime_error("Split NZ workspace allocation failed");
    if (parts == 2) SplitNzCompactKernel<2><<<launchBlocks, nullptr, stream>>>(x,w,scale,groups,y,(GM_ADDR)memory,s,span,maximumTiles,partialOffset);
    else if (mixed && l1>=507904 && ub>=185120)
        ShortWideHbKernel<true><<<launchBlocks, nullptr, stream>>>(x,w,scale,groups,y,(GM_ADDR)memory,s,span,maximumTiles);
    else if (mixed)
        ShortWideHbKernel<false><<<launchBlocks, nullptr, stream>>>(x,w,scale,groups,y,(GM_ADDR)memory,s,span,maximumTiles);
    else if (directB)
        SplitNzCompactKernel<4, true, true><<<launchBlocks, nullptr, stream>>>(x,w,scale,groups,y,(GM_ADDR)memory,s,span,maximumTiles,0);
    else if (parts == 4)
        SplitNzCompactKernel<4><<<launchBlocks, nullptr, stream>>>(x,w,scale,groups,y,(GM_ADDR)memory,s,span,maximumTiles,partialOffset);
    else SplitNzCompactKernel<8><<<launchBlocks, nullptr, stream>>>(x,w,scale,groups,y,(GM_ADDR)memory,s,span,maximumTiles,partialOffset);
    const aclError result = aclrtSynchronizeStream(stream), freed = aclrtFree(memory);
    if (result != ACL_SUCCESS || freed != ACL_SUCCESS) throw std::runtime_error("Split NZ execution failed");
    return true;
}
}



// Invocation-local NZ preprocessing, resident bands and native C epilogue.
#ifndef __DAV_CUBE__
namespace grouped_matmul_gelu {
__aicore__ inline void PrepareNzWeightsFullRows(GM_ADDR weightAddress, GM_ADDR target,
    GM_ADDR groupsAddress, Shape s, AscendC::TPipe& pipe)
{
    const uint32_t np = s.packedPartials;
    const uint32_t Bytes = s.slabK * np;
    AscendC::TBuf<AscendC::TPosition::VECCALC> inputBuffer, outputBuffer;
    pipe.InitBuffer(inputBuffer, Bytes);
    pipe.InitBuffer(outputBuffer, 2 * Bytes);
    auto input = inputBuffer.Get<int8_t>();
    auto groups = outputBuffer.Get<int64_t>();
    AscendC::GlobalTensor<int64_t> groupGm;
    AscendC::GlobalTensor<int8_t> weight, packed;
    groupGm.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groupsAddress));
    weight.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(weightAddress));
    packed.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(target));
    AscendC::DataCopyExtParams gc{1, uint32_t(s.experts * 8), 0, 0, 0};
    AscendC::DataCopyPad(groups, groupGm, gc, {false, 0, 0, 0});
    Fence<AscendC::HardEvent::MTE2_S>();
    uint64_t activeLow = 0, activeHigh = 0;
    uint32_t activeCount = 0;
    int64_t previous = 0;
    for (uint32_t expert = 0; expert < s.experts; ++expert) {
        const int64_t end = groups.GetValue(expert);
        if (end > previous) {
            ++activeCount;
            if (expert < 64) activeLow |= uint64_t(1) << expert;
            else activeHigh |= uint64_t(1) << (expert - 64);
        }
        previous = end;
    }
    // The cached group array is dead before the same UB becomes NZ output.
    Fence<AscendC::HardEvent::S_V>();
    const event_t inputFree = static_cast<event_t>(pipe.AllocEventID<AscendC::HardEvent::V_MTE2>());
    const event_t inputReady = static_cast<event_t>(pipe.AllocEventID<AscendC::HardEvent::MTE2_V>());
    event_t outputFree[2];
    AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(inputFree);
    for (uint32_t i = 0; i < 2; ++i) {
        outputFree[i] = static_cast<event_t>(pipe.AllocEventID<AscendC::HardEvent::MTE3_V>());
        AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(outputFree[i]);
    }
    const uint32_t vectorWorkers = AscendC::GetBlockNum() * 2;
    const uint32_t parallelRows = (s.residentK * activeCount + vectorWorkers - 1) / vectorWorkers;
    const uint32_t usefulRows = parallelRows < 16 ? 16 : parallelRows;
    const uint32_t Rows = usefulRows < s.slabK ? usefulRows : s.slabK;
    const uint32_t perExpert = (s.residentK + Rows - 1) / Rows;
    const uint32_t tasks = s.experts * perExpert;
    uint32_t sequence = 0;
    for (uint32_t task = AscendC::GetBlockIdx(); task < tasks;
        task += AscendC::GetBlockNum() * 2) {
        const uint32_t expert = task / perExpert;
        const uint64_t active = expert < 64 ? activeLow : activeHigh;
        if (((active >> (expert & 63)) & 1) == 0) continue;
        const uint32_t k0 = task % perExpert * Rows;
        const uint32_t physicalRows = s.residentK - k0 < Rows ? s.residentK - k0 : Rows;
        const uint32_t rows = k0 >= s.k ? 0 : (s.k - k0 < physicalRows ? s.k - k0 : physicalRows);
        const uint32_t slot = sequence++ & 1;
        auto output = outputBuffer.Get<int8_t>()[slot * Bytes];
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(inputFree);
        if (rows != physicalRows) {
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Duplicate(input.ReinterpretCast<int16_t>(), int16_t(0), physicalRows * np / 2);
            Fence<AscendC::HardEvent::V_MTE2>();
        }
        AscendC::DataCopyExtParams cp{static_cast<uint16_t>(rows), uint32_t(s.n), 0, 0, 0};
        if (rows) AscendC::DataCopyPad(input, weight[(uint64_t(expert) * s.k + k0) * s.n],
            cp, {true, 0, static_cast<uint8_t>(np - s.n), int8_t(0)});
        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(inputReady);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(inputReady);
        AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(outputFree[slot]);
        for (uint32_t plane = 0; plane < np / 32; plane += 8) {
            const uint32_t planes = np / 32 - plane < 8 ? np / 32 - plane : 8;
            const uint32_t lanes = planes * 16;
            asc_set_mask_norm();
            asc_set_vector_mask(lanes > 64 ? (lanes == 128 ? ~uint64_t(0) : (uint64_t(1) << (lanes - 64)) - 1) : 0,
                lanes >= 64 ? ~uint64_t(0) : (uint64_t(1) << lanes) - 1);
            asc_copy(Ub(output.ReinterpretCast<uint16_t>()[plane * physicalRows * 16]),
                Ub(input.ReinterpretCast<uint16_t>()[plane * 16]),
                static_cast<uint8_t>(physicalRows), static_cast<uint16_t>(physicalRows), 1, 1, static_cast<uint16_t>(np / 32));
        }
        asc_set_vector_mask(~uint64_t(0), ~uint64_t(0));
        AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(inputFree);
        Fence<AscendC::HardEvent::V_MTE3>();
        const uint64_t offset = uint64_t(expert) * s.residentK * np + uint64_t(k0) * 32;
        AscendC::DataCopyParams copyOut{static_cast<uint16_t>(np / 32),
            static_cast<uint16_t>(physicalRows), 0, static_cast<uint16_t>(s.residentK - physicalRows)};
        AscendC::DataCopy(packed[offset], output, copyOut);
        AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(outputFree[slot]);
    }
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(inputFree);
    pipe.ReleaseEventID<AscendC::HardEvent::V_MTE2>(inputFree);
    pipe.ReleaseEventID<AscendC::HardEvent::MTE2_V>(inputReady);
    for (uint32_t i = 0; i < 2; ++i) {
        AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(outputFree[i]);
        pipe.ReleaseEventID<AscendC::HardEvent::MTE3_V>(outputFree[i]);
    }
}
}
#endif

#ifndef __DAV_CUBE__
namespace grouped_matmul_gelu {

struct NzBalancedRowTask {uint32_t expert,k0,physicalRows,rows;};
class NzBalancedRowTasks {
    Shape shape;uint64_t low,high;uint32_t row,limit,expert,k0;
    __aicore__ inline bool Active(uint32_t e) const {
        return (((e<64?low:high)>>(e&63))&1)!=0;
    }
public:
    __aicore__ inline NzBalancedRowTasks(Shape s,uint64_t lo,uint64_t hi,
        uint32_t activeCount,uint32_t worker,uint32_t workers):shape(s),low(lo),high(hi),expert(0) {
        const uint32_t total=s.residentK*activeCount;
        row=uint64_t(total)*worker/workers;limit=uint64_t(total)*(worker+1)/workers;
        uint32_t ordinal=row/s.residentK;k0=row%s.residentK;
        while(expert<s.experts){if(Active(expert)){if(!ordinal)break;--ordinal;}++expert;}
    }
    __aicore__ inline bool Next(NzBalancedRowTask& task) {
        if(row>=limit)return false;
        uint32_t count=limit-row;
        if(count>shape.residentK-k0)count=shape.residentK-k0;
        if(count>shape.slabK)count=shape.slabK;
        const uint32_t valid=k0>=shape.k?0:(shape.k-k0<count?shape.k-k0:count);
        task={expert,k0,count,valid};row+=count;k0+=count;
        if(k0==shape.residentK){k0=0;do{++expert;}while(expert<shape.experts&&!Active(expert));}
        return true;
    }
};

__aicore__ inline void PrepareBalancedNzWeightsFullRows(GM_ADDR weightAddress, GM_ADDR target,
    GM_ADDR groupsAddress, Shape s, AscendC::TPipe& pipe)
{
    const uint32_t np = s.packedPartials;
    const uint32_t Bytes = s.slabK * np;
    AscendC::TBuf<AscendC::TPosition::VECCALC> inputBuffer, outputBuffer;
    pipe.InitBuffer(inputBuffer, Bytes);
    pipe.InitBuffer(outputBuffer, 2 * Bytes);
    auto input = inputBuffer.Get<int8_t>();
    auto groups = outputBuffer.Get<int64_t>();
    AscendC::GlobalTensor<int64_t> groupGm;
    AscendC::GlobalTensor<int8_t> weight, packed;
    groupGm.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groupsAddress));
    weight.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(weightAddress));
    packed.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(target));
    AscendC::DataCopyExtParams gc{1, uint32_t(s.experts * 8), 0, 0, 0};
    AscendC::DataCopyPad(groups, groupGm, gc, {false, 0, 0, 0});
    Fence<AscendC::HardEvent::MTE2_S>();
    uint64_t activeLow = 0, activeHigh = 0;
    uint32_t activeCount = 0;
    int64_t previous = 0;
    for (uint32_t expert = 0; expert < s.experts; ++expert) {
        const int64_t end = groups.GetValue(expert);
        if (end > previous) {
            ++activeCount;
            if (expert < 64) activeLow |= uint64_t(1) << expert;
            else activeHigh |= uint64_t(1) << (expert - 64);
        }
        previous = end;
    }
    // The cached group array is dead before the same UB becomes NZ output.
    Fence<AscendC::HardEvent::S_V>();
    const event_t inputFree = static_cast<event_t>(pipe.AllocEventID<AscendC::HardEvent::V_MTE2>());
    const event_t inputReady = static_cast<event_t>(pipe.AllocEventID<AscendC::HardEvent::MTE2_V>());
    event_t outputFree[2];
    AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(inputFree);
    for (uint32_t i = 0; i < 2; ++i) {
        outputFree[i] = static_cast<event_t>(pipe.AllocEventID<AscendC::HardEvent::MTE3_V>());
        AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(outputFree[i]);
    }
    NzBalancedRowTasks tasks(s,activeLow,activeHigh,activeCount,
        AscendC::GetBlockIdx(),AscendC::GetBlockNum()*2);
    NzBalancedRowTask task;uint32_t sequence=0;
    while(tasks.Next(task)) {
        const uint32_t expert=task.expert,k0=task.k0;
        const uint32_t physicalRows=task.physicalRows,rows=task.rows;
        const uint32_t slot = sequence++ & 1;
        auto output = outputBuffer.Get<int8_t>()[slot * Bytes];
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(inputFree);
        if (rows != physicalRows) {
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Duplicate(input.ReinterpretCast<int16_t>(), int16_t(0), physicalRows * np / 2);
            Fence<AscendC::HardEvent::V_MTE2>();
        }
        AscendC::DataCopyExtParams cp{static_cast<uint16_t>(rows), uint32_t(s.n), 0, 0, 0};
        if (rows) AscendC::DataCopyPad(input, weight[(uint64_t(expert) * s.k + k0) * s.n],
            cp, {true, 0, static_cast<uint8_t>(np - s.n), int8_t(0)});
        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(inputReady);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(inputReady);
        AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(outputFree[slot]);
        for (uint32_t plane = 0; plane < np / 32; plane += 8) {
            const uint32_t planes = np / 32 - plane < 8 ? np / 32 - plane : 8;
            const uint32_t lanes = planes * 16;
            asc_set_mask_norm();
            asc_set_vector_mask(lanes > 64 ? (lanes == 128 ? ~uint64_t(0) : (uint64_t(1) << (lanes - 64)) - 1) : 0,
                lanes >= 64 ? ~uint64_t(0) : (uint64_t(1) << lanes) - 1);
            asc_copy(Ub(output.ReinterpretCast<uint16_t>()[plane * physicalRows * 16]),
                Ub(input.ReinterpretCast<uint16_t>()[plane * 16]),
                static_cast<uint8_t>(physicalRows), static_cast<uint16_t>(physicalRows), 1, 1, static_cast<uint16_t>(np / 32));
        }
        asc_set_vector_mask(~uint64_t(0), ~uint64_t(0));
        AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(inputFree);
        Fence<AscendC::HardEvent::V_MTE3>();
        const uint64_t offset = uint64_t(expert) * s.residentK * np + uint64_t(k0) * 32;
        AscendC::DataCopyParams copyOut{static_cast<uint16_t>(np / 32),
            static_cast<uint16_t>(physicalRows), 0, static_cast<uint16_t>(s.residentK - physicalRows)};
        AscendC::DataCopy(packed[offset], output, copyOut);
        AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(outputFree[slot]);
    }
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(inputFree);
    pipe.ReleaseEventID<AscendC::HardEvent::V_MTE2>(inputFree);
    pipe.ReleaseEventID<AscendC::HardEvent::MTE2_V>(inputReady);
    for (uint32_t i = 0; i < 2; ++i) {
        AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(outputFree[i]);
        pipe.ReleaseEventID<AscendC::HardEvent::MTE3_V>(outputFree[i]);
    }
}
}
#endif

namespace grouped_matmul_gelu {
#ifdef __DAV_CUBE__
template<bool NativeC,uint32_t Columns>
__aicore__ inline void PublishCLayout(AscendC::GlobalTensor<int32_t> ring,
    AscendC::LocalTensor<int32_t> c,uint32_t mp,uint32_t np,uint32_t& sequence,event_t cFree) {
    if constexpr(!NativeC)PublishPairedPanel<Columns>(ring,c,mp,np,sequence,cFree);
    else {
        const uint32_t slot=sequence%kSlots;
        AscendC::CrossCoreWaitFlag<2>(4+slot);
        AscendC::FixpipeParamsV220 fp{};fp.unitFlag=3;fp.nSize=np;fp.mSize=mp;
        fp.srcStride=mp;fp.dstStride=2*mp;fp.quantPre=QuantMode_t::NoQuant;fp.isChannelSplit=false;
        AscendC::Fixpipe<int32_t,int32_t,AscendC::CFG_NZ>(ring[slot*kTileElements],c,fp);
        AscendC::SetFlag<AscendC::HardEvent::FIX_M>(cFree);
        AscendC::CrossCoreSetFlag<2,PIPE_FIX>(slot);++sequence;
    }
}
#else

// Independent design reference, not installed in a candidate or NPU tested.
// Checked against local CANN 9.0.0 npu_arch_2201 asc_copy signatures.
// Caller provides Ub(), AscendC namespace and normal events/lifetimes.

#ifndef __DAV_CUBE__
// srcScale holds [columns] FP32, padded channels already initialized to zero.
// dstExpanded becomes [columns/16][rows][16]. rows <= 48 for R328.
// Cache on {expert, column, columns, rows}; R328 only needs a rows identity.
__aicore__ inline void ExpandScaleForNativeC(
    AscendC::LocalTensor<float> dstExpanded,
    AscendC::LocalTensor<float> srcScale, uint32_t rows, uint32_t columns) {
    asc_set_mask_norm();
    asc_set_vector_mask(0, 0xffff); // 16 x 32-bit elements = two datablocks.
    auto d = dstExpanded.ReinterpretCast<uint32_t>();
    auto s = srcScale.ReinterpretCast<uint32_t>();
    for (uint32_t p = 0; p < columns / 16; ++p) {
        asc_copy(Ub(d[p * rows * 16]), Ub(s[p * 16]), uint8_t(rows),
                 1, 1, 2, 0); // dstBlock, srcBlock, dstRepeat, srcRepeat.
    }
    AscendC::PipeBarrier<PIPE_V>();
    asc_set_vector_mask(~uint64_t(0), ~uint64_t(0));
}

// Exact bit permutation AFTER the only FP16 cast. Both buffers are distinct.
// srcNz: [columns/16][rows][16]; dstNd: [rows][columns].
// Each half N16 cell is one 32B block: no TransDataTo5HD is needed.
__aicore__ inline void NativeHalfCToNd(
    AscendC::LocalTensor<half> dstNd,
    AscendC::LocalTensor<half> srcNz, uint32_t rows, uint32_t columns) {
    const uint32_t planes = columns / 16;
    auto d = dstNd.ReinterpretCast<uint16_t>();
    auto s = srcNz.ReinterpretCast<uint16_t>();
    asc_set_mask_norm();
    for (uint32_t p = 0; p < planes; p += 8) {
        const uint32_t pp = planes - p < 8 ? planes - p : 8;
        const uint32_t lanes = pp * 16;
        const uint64_t lo = lanes >= 64 ? ~uint64_t(0) : (uint64_t(1) << lanes) - 1;
        const uint64_t hi = lanes <= 64 ? 0 :
            (lanes == 128 ? ~uint64_t(0) : (uint64_t(1) << (lanes - 64)) - 1);
        asc_set_vector_mask(hi, lo);
        asc_copy(Ub(d[p * 16]), Ub(s[p * rows * 16]), uint8_t(rows),
                 1, uint16_t(rows), uint16_t(planes), 1);
    }
    AscendC::PipeBarrier<PIPE_V>();
    asc_set_vector_mask(~uint64_t(0), ~uint64_t(0));
}
#endif

/* Cube replacement, retaining existing slot, credit and complete INT32 MMAD:
  FixpipeParamsV220 fp{};
  fp.nSize = np32;
  fp.mSize = mp;
  fp.srcStride = mp;       // source unit = 16 * sizeof(int32_t) = 64 B
  fp.dstStride = 2 * mp;   // destination NZ unit = 32 B; NOT N or RingColumns
  fp.quantPre = QuantMode_t::NoQuant;
  fp.isChannelSplit = false;
  fp.unitFlag = 3;
  Fixpipe<int32_t, int32_t, CFG_NZ>(ring[slot * SlotElements], c, fp);
  SetFlag<FIX_M>(cFree);
  CrossCoreSetFlag<2, PIPE_FIX>(slot);

  AIV receive after normal WaitReady and local inputFree:
    mp = roundUp(segment.rows, 16);   // must match producer, including tail
    cols16 = roundUp(segment.columns, 16); // R328 may retain fixed 160
    DataCopyParams cp{uint16_t(cols16 / 16), uint16_t(2 * rows),
                      uint16_t(2 * (mp - rows)), 0};
    DataCopy(c, ring[slot * SlotElements + firstRow * 16], cp);
    CrossCoreSetFlag<2, PIPE_MTE2>(4 + slot);
    Fence<MTE2_V>();
    asc_int322float_rn(Ub(z), Ub(c), rows * cols16);
    PipeBarrier<PIPE_V>();
    SetFlag<V_MTE2>(inputFree); // C input may refill; z is independent.
    if (expandedScaleIdentityChanged) ExpandScaleForNativeC(expanded, scale, rows, cols16);
    asc_set_mask_count(); asc_set_vector_mask(0, rows * cols16);
    asc_mul(Ub(z), Ub(z), Ub(expanded), 1, 1, 1, 1, 8, 8, 8);
    PipeBarrier<PIPE_V>();
    GeluCountMasked(Ub(z), Ub(u)); // unchanged FP32 expression and Div, once/frame
    asc_float2half_rn(Ub(halfNz), Ub(z), 1, 1, 1, 4, 8);
    PipeBarrier<PIPE_V>();
    WaitFlag<MTE3_V>(outputFree[hs]);
    NativeHalfCToNd(halfNd[hs], halfNz, rows, cols16);
    Fence<V_MTE3>();
    // Original ND output DataCopyPad, same valid rows/columns and outputFree.

  R328 48x160 AIV resource budget, separate raw C/z/u and two ND half outputs:
    C 30,720 + z 30,976 + u 30,976 + ND half 30,720 + scale 896
    + expanded scale 30,720 + NZ half 15,360 = 170,368 B.
  Metadata and optional extra bank offsets remain to be added explicitly.
  N256/32-row analogue = 182,016 B with the same three 256B offsets.
*/

template<class Iterator>
__aicore__ inline void NativeCVectorPrepared(GM_ADDR scaleAddress,GM_ADDR yAddress,
    GM_ADDR workspace,Shape s,AscendC::TPipe& pipe,Iterator& segments) {
    constexpr uint32_t MaxN=256,MaxRows=32,Elements=MaxN*MaxRows;
    const uint32_t worker=AscendC::GetBlockIdx()/2,sub=AscendC::GetSubBlockIdx();
    AscendC::GlobalTensor<int32_t> ring;ring.SetGlobalBuffer((__gm__ int32_t*)workspace+worker*kSlots*kTileElements);
    AscendC::GlobalTensor<float> scales;scales.SetGlobalBuffer((__gm__ float*)scaleAddress);
    AscendC::GlobalTensor<half> output;output.SetGlobalBuffer((__gm__ half*)yAddress);
    AscendC::TBuf<AscendC::TPosition::VECCALC> cb,zb,ub,hb,sb,eb,nb;
    pipe.InitBuffer(cb,Elements*4);pipe.InitBuffer(zb,Elements*4+256);
    pipe.InitBuffer(ub,Elements*4+256);pipe.InitBuffer(hb,2*Elements*2);
    pipe.InitBuffer(sb,MaxN*4+256);pipe.InitBuffer(eb,Elements*4);pipe.InitBuffer(nb,Elements*2);
    auto c=cb.Get<int32_t>();auto z=zb.Get<float>()[64],u=ub.Get<float>()[64];
    auto halfNd=hb.Get<half>(),halfNz=nb.Get<half>();
    auto scale=sb.Get<float>()[64],expanded=eb.Get<float>();
    const auto inputFree=(event_t)pipe.AllocEventID<AscendC::HardEvent::V_MTE2>();
    const auto scaleFree=(event_t)pipe.AllocEventID<AscendC::HardEvent::V_MTE2>();
    event_t outputFree[2];
    AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(inputFree);
    AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(scaleFree);
    for(uint32_t i=0;i<2;++i){
        outputFree[i]=(event_t)pipe.AllocEventID<AscendC::HardEvent::MTE3_V>();
        AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(outputFree[i]);
        AscendC::CrossCoreSetFlag<2,PIPE_MTE2>(4+i);
    }
    int64_t scaleExpert=-1,scaleColumn=-1;uint32_t expandedRows=0;
    Segment segment;uint32_t sequence=0;
    while(segments.Next(segment)) {
        const uint32_t slot=sequence++%kSlots;
        AscendC::CrossCoreWaitFlag<2>(slot);
        const uint32_t split=(segment.rows+1)/2,first=sub*split;
        const uint32_t rows=segment.rows<=first?0:(segment.rows-first<split?segment.rows-first:split);
        if(!rows){AscendC::CrossCoreSetFlag<2,PIPE_MTE2>(4+slot);continue;}
        const uint32_t mp=(segment.rows+15)/16*16,np=(segment.columns+31)/32*32;
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(inputFree);
        AscendC::DataCopyParams input{uint16_t(np/16),uint16_t(2*rows),uint16_t(2*(mp-rows)),0};
        AscendC::DataCopy(c,ring[slot*kTileElements+first*16],input);
        AscendC::CrossCoreSetFlag<2,PIPE_MTE2>(4+slot);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(scaleFree);
        const bool newScale=scaleExpert!=segment.expert || scaleColumn!=segment.column;
        if(newScale) {
            if(segment.columns!=np) {
                AscendC::Duplicate(scale,0.0f,np);Fence<AscendC::HardEvent::V_MTE2>();
                AscendC::DataCopyExtParams cp{1,segment.columns*4,0,0,0};
                AscendC::DataCopyPadExtParams<float> pad{true,0,uint8_t((segment.columns+7)/8*8-segment.columns),0};
                AscendC::DataCopyPad(scale,scales[segment.expert*s.n+segment.column],cp,pad);
            } else AscendC::DataCopy(scale,scales[segment.expert*s.n+segment.column],np);
            scaleExpert=segment.expert;scaleColumn=segment.column;
        }
        Fence<AscendC::HardEvent::MTE2_V>();
        asc_int322float_rn(Ub(z),Ub(c),rows*np);AscendC::PipeBarrier<PIPE_V>();
        AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(inputFree);
        if(newScale || expandedRows!=rows){ExpandScaleForNativeC(expanded,scale,rows,np);expandedRows=rows;}
        AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(scaleFree);
        asc_set_mask_count();asc_set_vector_mask(0,rows*np);
        asc_mul(Ub(z),Ub(z),Ub(expanded),1,1,1,1,8,8,8);AscendC::PipeBarrier<PIPE_V>();
        kernel_common::GeluCountMasked(Ub(z),Ub(u));
        asc_float2half_rn(Ub(halfNz),Ub(z),1,1,1,4,8);AscendC::PipeBarrier<PIPE_V>();
        AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(outputFree[slot]);
        auto h=halfNd[slot*Elements];NativeHalfCToNd(h,halfNz,rows,np);
        Fence<AscendC::HardEvent::V_MTE3>();
        AscendC::DataCopyExtParams out{uint16_t(rows),segment.columns*2,
            (np-(segment.columns+15)/16*16)/16,uint32_t((s.n-segment.columns)*2),0};
        AscendC::DataCopyPad(output[(segment.row+first)*s.n+segment.column],h,out);
        AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(outputFree[slot]);
    }
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(inputFree);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(scaleFree);
    pipe.ReleaseEventID<AscendC::HardEvent::V_MTE2>(inputFree);
    pipe.ReleaseEventID<AscendC::HardEvent::V_MTE2>(scaleFree);
    for(uint32_t i=0;i<2;++i){AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(outputFree[i]);
        pipe.ReleaseEventID<AscendC::HardEvent::MTE3_V>(outputFree[i]);}
}
template<uint32_t Kind>
__aicore__ inline void NativeCVectorRun(GM_ADDR scale,GM_ADDR groups,GM_ADDR y,
    GM_ADDR workspace,Shape shape,AscendC::TPipe& pipe) {
    AscendC::TBuf<AscendC::TPosition::VECCALC> metadata;
    pipe.InitBuffer(metadata,(shape.experts+3)/4*32);
    Segments<Kind,256,true> segments(groups,shape,AscendC::GetBlockIdx()/2,
        AscendC::GetBlockNum(),metadata.Get<int64_t>());
    NativeCVectorPrepared(scale,y,workspace,shape,pipe,segments);
}
#endif
}

namespace grouped_matmul_gelu {
#ifdef __DAV_CUBE__
template <uint32_t BPacketK, uint32_t PadN = 0, bool PackedWeights = false>
__aicore__ inline void CopyNzBPacket(
    AscendC::TQue<AscendC::TPosition::B1, 2>& bq,
    AscendC::GlobalTensor<int8_t> weight, Shape s, Segment segment,
    uint32_t start, uint32_t end)
{
    const uint32_t count = end - start < BPacketK ? end - start : BPacketK;
    const uint32_t kp = (count + 31) / 32 * 32;
    const uint32_t np = PadN ? PadN : (segment.columns + 31) / 32 * 32;
    auto b1 = bq.AllocTensor<int8_t>();
    if constexpr (PackedWeights) {
        AscendC::DataCopyParams copy{static_cast<uint16_t>(np / 32),
            static_cast<uint16_t>(kp), static_cast<uint16_t>(s.residentK - kp), 0};
        const uint64_t base = uint64_t(segment.expert) * s.residentK * s.packedPartials +
            uint64_t(segment.column) * s.residentK + uint64_t(start) * 32;
        AscendC::DataCopy(b1, weight[base], copy);
        bq.EnQue(b1);
        return;
    }
    if (segment.columns != np || count != kp) {
        AscendC::InitConstValueParams<uint16_t> zero{1, static_cast<uint16_t>(np * kp / 32), 0, 0};
        AscendC::InitConstValue(b1.ReinterpretCast<uint16_t>(), zero);
        AscendC::PipeBarrier<PIPE_MTE2>();
    }
    AscendC::Nd2NzParams bp{};
    bp.ndNum = 1; bp.nValue = count; bp.dValue = segment.columns;
    bp.srcDValue = s.n; bp.dstNzC0Stride = kp; bp.dstNzNStride = 1;
    AscendC::DataCopy(b1, weight[segment.expert * s.k * s.n + start * s.n + segment.column], bp);
    bq.EnQue(b1);
}

template <bool Persistent, bool PackedWeights = false, bool NativeC = false>
__aicore__ inline void NzPairedEarlyCube(GM_ADDR xAddress, GM_ADDR weightAddress,
    GM_ADDR groupsAddress, GM_ADDR workspace, Shape s, AscendC::TPipe& pipe)
{
    constexpr uint32_t Columns = 256, PacketK = 256, MadK = 128;
    const uint32_t worker = AscendC::GetBlockIdx();
    AscendC::GlobalTensor<int8_t> x, weight;
    AscendC::GlobalTensor<int32_t> ring;
    x.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(xAddress));
    weight.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(weightAddress));
    ring.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(workspace) + worker * kSlots * kTileElements);
    AscendC::SetAtomicNone();
    AscendC::SetMMRowMajor();
    AscendC::SetLoadDataBoundary(uint64_t(0));
    AscendC::SetLoadDataPaddingValue(uint64_t(0));
    AscendC::TBuf<AscendC::TPosition::A1> resident;
    AscendC::TQue<AscendC::TPosition::B1, 2> bq;
    AscendC::TBuf<AscendC::TPosition::A2> ab;
    AscendC::TBuf<AscendC::TPosition::B2> bb;
    AscendC::TBuf<AscendC::TPosition::CO1> cb;
    pipe.InitBuffer(resident, 128 * s.residentK);
    pipe.InitBuffer(bq, 2, PacketK * Columns);
    pipe.InitBuffer(ab, 2 * 128 * MadK);
    pipe.InitBuffer(bb, 2 * Columns * MadK);
    pipe.InitBuffer(cb, 2 * kL0CSlotElements * sizeof(int32_t));
    auto a1 = resident.Get<int8_t>();
    auto aAll = ab.Get<int8_t>();
    auto bAll = bb.Get<int8_t>();
    auto cAll = cb.Get<int32_t>();
    event_t free[2], ready[2], cFree[2];
    for (uint32_t i = 0; i < 2; ++i) {
        free[i] = static_cast<event_t>(pipe.AllocEventID<AscendC::HardEvent::M_MTE1>());
        ready[i] = static_cast<event_t>(pipe.AllocEventID<AscendC::HardEvent::MTE1_M>());
        cFree[i] = static_cast<event_t>(pipe.AllocEventID<AscendC::HardEvent::FIX_M>());
        AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(free[i]);
        AscendC::SetFlag<AscendC::HardEvent::FIX_M>(cFree[i]);
    }
    Segments<Persistent ? 2 : 1, Columns> blocks(groupsAddress, s, worker, AscendC::GetBlockNum());
    Segment block;
    uint32_t sequence = 0, kSequence = 0;
    int64_t loadedRow = -1;
    while (blocks.Next(block)) {
        if (loadedRow != block.row) {
            LoadResidentRange(a1, x, s, block, 0, s.k);
            loadedRow = block.row;
        }
        const uint32_t mp = (block.rows + 15) / 16 * 16;
        const uint32_t np = (block.columns + 31) / 32 * 32;
        const uint32_t firstM = mp < 64 ? mp : 64;
        const uint32_t secondM = mp > 64 ? mp - 64 : 0;
        const uint32_t cs = sequence & 1, cs2 = (sequence + 1) & 1;
        auto c0 = cAll[cs * kL0CSlotElements];
        auto c1 = cAll[cs2 * kL0CSlotElements];
        AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(cFree[cs]);
        if (secondM) AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(cFree[cs2]);
        CopyNzBPacket<PacketK, 0, PackedWeights>(bq, weight, s, block, 0, s.k);
        if (PacketK < s.k) CopyNzBPacket<PacketK, 0, PackedWeights>(bq, weight, s, block, PacketK, s.k);
        for (uint32_t packet = 0; packet < s.k; packet += PacketK) {
            const uint32_t end = s.k - packet < PacketK ? s.k : packet + PacketK;
            const uint32_t packetKp = (end - packet + 31) / 32 * 32;
            auto b1 = bq.DeQue<int8_t>();
            for (uint32_t k0 = packet; k0 < end; k0 += MadK, ++kSequence) {
                const uint32_t count = end - k0 < MadK ? end - k0 : MadK;
                const uint32_t kp = (count + 31) / 32 * 32;
                const uint32_t ks = kSequence & 1;
                auto a2 = aAll[ks * 128 * MadK];
                auto b2 = bAll[ks * Columns * MadK];
                AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(free[ks]);
                AscendC::LoadData2DParams ap{};
                ap.repeatTimes = kp / 32; ap.srcStride = mp / 16;
                for (uint32_t m = 0; m < mp / 16; ++m)
                    AscendC::LoadData(a2[m * kp * 16], a1[k0 * mp + m * 512], ap);
                AscendC::LoadData2dTransposeParams bp{};
                bp.repeatTimes = np / 32; bp.srcStride = packetKp / 32; bp.dstGap = 1;
                for (uint32_t k = 0; k < kp / 32; ++k)
                    AscendC::LoadDataWithTranspose(b2[k * np * 32], b1[(k0 - packet) * 32 + k * 1024], bp);
                if (k0 + MadK >= end) {
                    bq.FreeTensor(b1);
                    if (packet + 2 * PacketK < s.k)
                        CopyNzBPacket<PacketK, 0, PackedWeights>(bq, weight, s, block, packet + 2 * PacketK, s.k);
                }
                AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(ready[ks]);
                AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(ready[ks]);
                AscendC::MmadParams mm{};
                mm.m = firstM; mm.n = np; mm.k = kp; mm.cmatrixInitVal = k0 == 0;
                const bool last = k0 + MadK >= s.k;
                mm.unitFlag = last ? 3 : 2;
                AscendC::Mmad(c0, a2, b2, mm);
                if ((mm.m / 16) * (mm.n / 16) < 10) AscendC::PipeBarrier<PIPE_M>();
                if (last) PublishCLayout<NativeC,Columns>(ring, c0, firstM, np, sequence, cFree[cs]);
                if (secondM) {
                    mm.m = secondM;
                    AscendC::Mmad(c1, a2[64 * kp], b2, mm);
                    if ((mm.m / 16) * (mm.n / 16) < 10) AscendC::PipeBarrier<PIPE_M>();
                    if (last) PublishCLayout<NativeC,Columns>(ring, c1, secondM, np, sequence, cFree[cs2]);
                }
                // Both MAD consumers retire before either shared L0 slot is reused.
                AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(free[ks]);
            }
        }
    }
    for (uint32_t i = 0; i < 2; ++i) {
        AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(free[i]);
        AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(cFree[i]);
        pipe.ReleaseEventID<AscendC::HardEvent::M_MTE1>(free[i]);
        pipe.ReleaseEventID<AscendC::HardEvent::MTE1_M>(ready[i]);
        pipe.ReleaseEventID<AscendC::HardEvent::FIX_M>(cFree[i]);
        AscendC::CrossCoreWaitFlag<2>(4 + i);
    }
}
#endif
}

#ifndef __DAV_CUBE__
namespace grouped_matmul_gelu {
__aicore__ inline void PrepareNzWeightsAlignedRows(GM_ADDR weightAddress, GM_ADDR target,
    GM_ADDR groupsAddress, Shape s, AscendC::TPipe& pipe)
{
    const uint32_t np = s.packedPartials;
    const uint32_t Bytes = s.slabK * np;
    AscendC::TBuf<AscendC::TPosition::VECCALC> inputBuffer, outputBuffer;
    pipe.InitBuffer(inputBuffer, Bytes);
    pipe.InitBuffer(outputBuffer, 2 * Bytes);
    auto input = inputBuffer.Get<int8_t>();
    auto groups = outputBuffer.Get<int64_t>();
    AscendC::GlobalTensor<int64_t> groupGm;
    AscendC::GlobalTensor<int8_t> weight, packed;
    groupGm.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groupsAddress));
    weight.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(weightAddress));
    packed.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(target));
    AscendC::DataCopyExtParams gc{1, uint32_t(s.experts * 8), 0, 0, 0};
    AscendC::DataCopyPad(groups, groupGm, gc, {false, 0, 0, 0});
    Fence<AscendC::HardEvent::MTE2_S>();
    uint64_t activeLow = 0, activeHigh = 0;
    uint32_t activeCount = 0;
    int64_t previous = 0;
    for (uint32_t expert = 0; expert < s.experts; ++expert) {
        const int64_t end = groups.GetValue(expert);
        if (end > previous) {
            ++activeCount;
            if (expert < 64) activeLow |= uint64_t(1) << expert;
            else activeHigh |= uint64_t(1) << (expert - 64);
        }
        previous = end;
    }
    // The cached group array is dead before the same UB becomes NZ output.
    Fence<AscendC::HardEvent::S_V>();
    const event_t inputFree = static_cast<event_t>(pipe.AllocEventID<AscendC::HardEvent::V_MTE2>());
    const event_t inputReady = static_cast<event_t>(pipe.AllocEventID<AscendC::HardEvent::MTE2_V>());
    event_t outputFree[2];
    AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(inputFree);
    for (uint32_t i = 0; i < 2; ++i) {
        outputFree[i] = static_cast<event_t>(pipe.AllocEventID<AscendC::HardEvent::MTE3_V>());
        AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(outputFree[i]);
    }
    const uint32_t vectorWorkers = AscendC::GetBlockNum() * 2;
    const uint32_t parallelRows = (s.residentK * activeCount + vectorWorkers - 1) / vectorWorkers;
    const uint32_t usefulRows = parallelRows < 16 ? 16 : parallelRows;
    const uint32_t Rows = usefulRows < s.slabK ? usefulRows : s.slabK;
    const uint32_t perExpert = (s.residentK + Rows - 1) / Rows;
    const uint32_t tasks = s.experts * perExpert;
    uint32_t sequence = 0;
    for (uint32_t task = AscendC::GetBlockIdx(); task < tasks;
        task += AscendC::GetBlockNum() * 2) {
        const uint32_t expert = task / perExpert;
        const uint64_t active = expert < 64 ? activeLow : activeHigh;
        if (((active >> (expert & 63)) & 1) == 0) continue;
        const uint32_t k0 = task % perExpert * Rows;
        const uint32_t physicalRows = s.residentK - k0 < Rows ? s.residentK - k0 : Rows;
        const uint32_t rows = k0 >= s.k ? 0 : (s.k - k0 < physicalRows ? s.k - k0 : physicalRows);
        const uint32_t slot = sequence++ & 1;
        auto output = outputBuffer.Get<int8_t>()[slot * Bytes];
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(inputFree);
        if (rows != physicalRows) {
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Duplicate(input.ReinterpretCast<int16_t>(), int16_t(0), physicalRows * np / 2);
            Fence<AscendC::HardEvent::V_MTE2>();
        }
        // Host proves N=Np and all offsets/counts are 32-byte aligned.
        if (rows) AscendC::DataCopy(input, weight[(uint64_t(expert) * s.k + k0) * s.n],
            uint32_t(rows * s.n));
        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(inputReady);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(inputReady);
        AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(outputFree[slot]);
        for (uint32_t plane = 0; plane < np / 32; plane += 8) {
            const uint32_t planes = np / 32 - plane < 8 ? np / 32 - plane : 8;
            const uint32_t lanes = planes * 16;
            asc_set_mask_norm();
            asc_set_vector_mask(lanes > 64 ? (lanes == 128 ? ~uint64_t(0) : (uint64_t(1) << (lanes - 64)) - 1) : 0,
                lanes >= 64 ? ~uint64_t(0) : (uint64_t(1) << lanes) - 1);
            asc_copy(Ub(output.ReinterpretCast<uint16_t>()[plane * physicalRows * 16]),
                Ub(input.ReinterpretCast<uint16_t>()[plane * 16]),
                static_cast<uint8_t>(physicalRows), static_cast<uint16_t>(physicalRows), 1, 1, static_cast<uint16_t>(np / 32));
        }
        asc_set_vector_mask(~uint64_t(0), ~uint64_t(0));
        AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(inputFree);
        Fence<AscendC::HardEvent::V_MTE3>();
        const uint64_t offset = uint64_t(expert) * s.residentK * np + uint64_t(k0) * 32;
        AscendC::DataCopyParams copyOut{static_cast<uint16_t>(np / 32),
            static_cast<uint16_t>(physicalRows), 0, static_cast<uint16_t>(s.residentK - physicalRows)};
        AscendC::DataCopy(packed[offset], output, copyOut);
        AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(outputFree[slot]);
    }
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(inputFree);
    pipe.ReleaseEventID<AscendC::HardEvent::V_MTE2>(inputFree);
    pipe.ReleaseEventID<AscendC::HardEvent::MTE2_V>(inputReady);
    for (uint32_t i = 0; i < 2; ++i) {
        AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(outputFree[i]);
        pipe.ReleaseEventID<AscendC::HardEvent::MTE3_V>(outputFree[i]);
    }
}
}
#endif

namespace grouped_matmul_gelu {
template<bool Persistent>
__schedmode__(1) __global__ __mix__(1,2) void AlignedNzWeightKernel(GM_ADDR x,GM_ADDR w,
    GM_ADDR scale,GM_ADDR groups,GM_ADDR y,GM_ADDR workspace,Shape s,uint64_t ringOffset) {
    AscendC::TPipe pipe;
#ifndef __DAV_CUBE__
    PrepareNzWeightsAlignedRows(w,workspace,groups,s,pipe);
#endif
    AscendC::PipeBarrier<PIPE_ALL>();
    AscendC::SyncAll<false>();
#ifdef __DAV_CUBE__
    NzPairedEarlyCube<Persistent,true>(x,workspace,groups,workspace+ringOffset,s,pipe);
#else
    pipe.Reset();
    VectorRun<Persistent?10:4,64,256,32>(scale,groups,y,workspace+ringOffset,s,pipe);
#endif
}
}

namespace grouped_matmul_gelu {
#ifndef __DAV_CUBE__
__aicore__ inline void PrepareNzWeights(GM_ADDR weightAddress, GM_ADDR target,
    GM_ADDR groupsAddress, Shape s, AscendC::TPipe& pipe)
{
    constexpr uint32_t Rows = 64, Columns = 512, Bytes = Rows * Columns;
    AscendC::TBuf<AscendC::TPosition::VECCALC> inputBuffer, outputBuffer, groupBuffer;
    pipe.InitBuffer(inputBuffer, 2 * Bytes);
    pipe.InitBuffer(outputBuffer, 2 * Bytes);
    pipe.InitBuffer(groupBuffer, 1024);
    auto groups = groupBuffer.Get<int64_t>();
    AscendC::GlobalTensor<int64_t> groupGm;
    AscendC::GlobalTensor<int8_t> weight, packed;
    groupGm.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groupsAddress));
    weight.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(weightAddress));
    packed.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(target));
    AscendC::DataCopyExtParams gc{1, uint32_t(s.experts * 8), 0, 0, 0};
    AscendC::DataCopyPad(groups, groupGm, gc, {false, 0, 0, 0});
    Fence<AscendC::HardEvent::MTE2_S>();
    event_t inputFree[2], inputReady[2], outputFree[2];
    for (uint32_t i = 0; i < 2; ++i) {
        inputFree[i] = static_cast<event_t>(pipe.AllocEventID<AscendC::HardEvent::V_MTE2>());
        inputReady[i] = static_cast<event_t>(pipe.AllocEventID<AscendC::HardEvent::MTE2_V>());
        outputFree[i] = static_cast<event_t>(pipe.AllocEventID<AscendC::HardEvent::MTE3_V>());
        AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(inputFree[i]);
        AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(outputFree[i]);
    }
    const uint32_t kChunks = (s.residentK + Rows - 1) / Rows;
    const uint32_t nChunks = (s.packedPartials + Columns - 1) / Columns;
    const uint32_t perExpert = kChunks * nChunks;
    const uint32_t tasks = s.experts * perExpert;
    uint32_t sequence = 0;
    for (uint32_t task = AscendC::GetBlockIdx(); task < tasks;
        task += AscendC::GetBlockNum() * 2) {
        const uint32_t expert = task / perExpert;
        const int64_t end = groups.GetValue(expert);
        const int64_t begin = expert ? groups.GetValue(expert - 1) : 0;
        if (end == begin) continue;
        const uint32_t within = task % perExpert;
        const uint32_t k0 = within / nChunks * Rows;
        const uint32_t n0 = within % nChunks * Columns;
        const uint32_t rows = s.k - k0 < Rows ? s.k - k0 : Rows;
        const uint32_t columns = s.n - n0 < Columns ? s.n - n0 : Columns;
        const uint32_t kp = (rows + 31) / 32 * 32;
        const uint32_t np = (columns + 31) / 32 * 32;
        const uint32_t slot = sequence++ & 1;
        auto input = inputBuffer.Get<int8_t>()[slot * Bytes];
        auto output = outputBuffer.Get<int8_t>()[slot * Bytes];
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(inputFree[slot]);
        if (rows != kp) {
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Duplicate(input.ReinterpretCast<int16_t>(), int16_t(0), Bytes / 2);
            Fence<AscendC::HardEvent::V_MTE2>();
        }
        AscendC::DataCopyExtParams cp{static_cast<uint16_t>(rows), columns,
            uint32_t(s.n - columns), (Columns - np) / 32, 0};
        AscendC::DataCopyPad(input, weight[(uint64_t(expert) * s.k + k0) * s.n + n0],
            cp, {true, 0, static_cast<uint8_t>(np - columns), int8_t(0)});
        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(inputReady[slot]);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(inputReady[slot]);
        AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(outputFree[slot]);
        // Each 32-byte block remains bit-identical; no INT8 arithmetic or cast.
        for (uint32_t plane = 0; plane < np / 32; plane += 8) {
            const uint32_t planes = np / 32 - plane < 8 ? np / 32 - plane : 8;
            const uint32_t lanes = planes * 16;
            asc_set_mask_norm();
            asc_set_vector_mask(lanes > 64 ? (lanes == 128 ? ~uint64_t(0) : (uint64_t(1) << (lanes - 64)) - 1) : 0,
                lanes >= 64 ? ~uint64_t(0) : (uint64_t(1) << lanes) - 1);
            asc_copy(Ub(output.ReinterpretCast<uint16_t>()[plane * kp * 16]),
                Ub(input.ReinterpretCast<uint16_t>()[plane * 16]),
                static_cast<uint8_t>(kp), static_cast<uint16_t>(kp), 1, 1, Columns / 32);
        }
        asc_set_vector_mask(~uint64_t(0), ~uint64_t(0));
        AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(inputFree[slot]);
        Fence<AscendC::HardEvent::V_MTE3>();
        const uint64_t offset = uint64_t(expert) * s.residentK * s.packedPartials +
            uint64_t(n0) * s.residentK + uint64_t(k0) * 32;
        AscendC::DataCopyParams copyOut{static_cast<uint16_t>(np / 32),
            static_cast<uint16_t>(kp), 0, static_cast<uint16_t>(s.residentK - kp)};
        AscendC::DataCopy(packed[offset], output, copyOut);
        AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(outputFree[slot]);
    }
    for (uint32_t i = 0; i < 2; ++i) {
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(inputFree[i]);
        AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(outputFree[i]);
        pipe.ReleaseEventID<AscendC::HardEvent::V_MTE2>(inputFree[i]);
        pipe.ReleaseEventID<AscendC::HardEvent::MTE2_V>(inputReady[i]);
        pipe.ReleaseEventID<AscendC::HardEvent::MTE3_V>(outputFree[i]);
    }
}
#endif

template <bool Persistent, bool NativeC = false>
__schedmode__(1) __global__ __mix__(1, 2) void NzWeightKernel(GM_ADDR x, GM_ADDR w,
    GM_ADDR scale, GM_ADDR groups, GM_ADDR y, GM_ADDR workspace, Shape shape, uint64_t ringOffset)
{
    AscendC::TPipe pipe;
#ifndef __DAV_CUBE__
    if (shape.vectorPrefetch) PrepareNzWeightsFullRows(w, workspace, groups, shape, pipe);
    else PrepareNzWeights(w, workspace, groups, shape, pipe);
#endif
    AscendC::PipeBarrier<PIPE_ALL>();
    AscendC::SyncAll<false>();
#ifdef __DAV_CUBE__
    NzPairedEarlyCube<Persistent, true,NativeC>(x, workspace, groups, workspace + ringOffset, shape, pipe);
#else
    // AIC keeps constructor-reserved events; only AIV recycles preprocessing UB.
    pipe.Reset();
    if constexpr(NativeC)NativeCVectorRun<Persistent?10:4>(scale,groups,y,workspace+ringOffset,shape,pipe);
    else VectorRun<Persistent ? 10 : 4, 64, 256, 32>(scale, groups, y, workspace + ringOffset, shape, pipe);
#endif
}

// Included inside grouped_matmul_gelu after the original packers.

// Included inside grouped_matmul_gelu after the original packers.
#ifdef __DAV_CUBE__
// ND2NZ writes every valid M row including its D/K tail; only missing M rows need zero.
__aicore__ inline void LoadNzResidentRowTail(AscendC::LocalTensor<int8_t> residentA,
    AscendC::GlobalTensor<int8_t> x, Shape s, Segment segment,
    uint32_t begin, uint32_t count)
{
    const uint32_t mp = (segment.rows + 15) / 16 * 16;
    const uint32_t kp = (count + 31) / 32 * 32;
    Fence<AscendC::HardEvent::MTE1_MTE2>();
    kernel_common::ZeroNzRows(residentA, segment.rows, mp, kp);
    AscendC::Nd2NzParams ap{};
    ap.ndNum = 1; ap.nValue = segment.rows; ap.dValue = count;
    ap.srcDValue = s.k; ap.dstNzC0Stride = mp; ap.dstNzNStride = 1;
    AscendC::DataCopy(residentA, x[segment.row * s.k + begin], ap);
    Fence<AscendC::HardEvent::MTE2_MTE1>();
}

template <bool Persistent, bool PackedWeights = false, bool NativeC = false>
__aicore__ inline void NzAZeroEarlyCube(GM_ADDR xAddress, GM_ADDR weightAddress,
    GM_ADDR groupsAddress, GM_ADDR workspace, Shape s, AscendC::TPipe& pipe)
{
    constexpr uint32_t Columns = 256, PacketK = 256, MadK = 128;
    const uint32_t worker = AscendC::GetBlockIdx();
    AscendC::GlobalTensor<int8_t> x, weight;
    AscendC::GlobalTensor<int32_t> ring;
    x.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(xAddress));
    weight.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(weightAddress));
    ring.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(workspace) + worker * kSlots * kTileElements);
    AscendC::SetAtomicNone();
    AscendC::SetMMRowMajor();
    AscendC::SetLoadDataBoundary(uint64_t(0));
    AscendC::SetLoadDataPaddingValue(uint64_t(0));
    AscendC::TBuf<AscendC::TPosition::A1> resident;
    AscendC::TQue<AscendC::TPosition::B1, 2> bq;
    AscendC::TBuf<AscendC::TPosition::A2> ab;
    AscendC::TBuf<AscendC::TPosition::B2> bb;
    AscendC::TBuf<AscendC::TPosition::CO1> cb;
    pipe.InitBuffer(resident, 128 * s.residentK);
    pipe.InitBuffer(bq, 2, PacketK * Columns);
    pipe.InitBuffer(ab, 2 * 128 * MadK);
    pipe.InitBuffer(bb, 2 * Columns * MadK);
    pipe.InitBuffer(cb, 2 * kL0CSlotElements * sizeof(int32_t));
    auto a1 = resident.Get<int8_t>();
    auto aAll = ab.Get<int8_t>();
    auto bAll = bb.Get<int8_t>();
    auto cAll = cb.Get<int32_t>();
    event_t free[2], ready[2], cFree[2];
    for (uint32_t i = 0; i < 2; ++i) {
        free[i] = static_cast<event_t>(pipe.AllocEventID<AscendC::HardEvent::M_MTE1>());
        ready[i] = static_cast<event_t>(pipe.AllocEventID<AscendC::HardEvent::MTE1_M>());
        cFree[i] = static_cast<event_t>(pipe.AllocEventID<AscendC::HardEvent::FIX_M>());
        AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(free[i]);
        AscendC::SetFlag<AscendC::HardEvent::FIX_M>(cFree[i]);
    }
    Segments<Persistent ? 2 : 1, Columns> blocks(groupsAddress, s, worker, AscendC::GetBlockNum());
    Segment block;
    uint32_t sequence = 0, kSequence = 0;
    int64_t loadedRow = -1;
    bool packedReady = false;
    while (blocks.Next(block)) {
        if (loadedRow != block.row) {
            LoadNzResidentRowTail(a1, x, s, block, 0, s.k);
            loadedRow = block.row;
        }
        // First A is independent of the AIV-produced B workspace.
        if (!packedReady) {
            AscendC::PipeBarrier<PIPE_ALL>();
            AscendC::SyncAll<false>();
            packedReady = true;
        }
        const uint32_t mp = (block.rows + 15) / 16 * 16;
        const uint32_t np = (block.columns + 31) / 32 * 32;
        const uint32_t firstM = mp < 64 ? mp : 64;
        const uint32_t secondM = mp > 64 ? mp - 64 : 0;
        const uint32_t cs = sequence & 1, cs2 = (sequence + 1) & 1;
        auto c0 = cAll[cs * kL0CSlotElements];
        auto c1 = cAll[cs2 * kL0CSlotElements];
        AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(cFree[cs]);
        if (secondM) AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(cFree[cs2]);
        CopyNzBPacket<PacketK, 0, PackedWeights>(bq, weight, s, block, 0, s.k);
        if (PacketK < s.k) CopyNzBPacket<PacketK, 0, PackedWeights>(bq, weight, s, block, PacketK, s.k);
        for (uint32_t packet = 0; packet < s.k; packet += PacketK) {
            const uint32_t end = s.k - packet < PacketK ? s.k : packet + PacketK;
            const uint32_t packetKp = (end - packet + 31) / 32 * 32;
            auto b1 = bq.DeQue<int8_t>();
            for (uint32_t k0 = packet; k0 < end; k0 += MadK, ++kSequence) {
                const uint32_t count = end - k0 < MadK ? end - k0 : MadK;
                const uint32_t kp = (count + 31) / 32 * 32;
                const uint32_t ks = kSequence & 1;
                auto a2 = aAll[ks * 128 * MadK];
                auto b2 = bAll[ks * Columns * MadK];
                AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(free[ks]);
                AscendC::LoadData2DParams ap{};
                ap.repeatTimes = kp / 32; ap.srcStride = mp / 16;
                for (uint32_t m = 0; m < mp / 16; ++m)
                    AscendC::LoadData(a2[m * kp * 16], a1[k0 * mp + m * 512], ap);
                AscendC::LoadData2dTransposeParams bp{};
                bp.repeatTimes = np / 32; bp.srcStride = packetKp / 32; bp.dstGap = 1;
                for (uint32_t k = 0; k < kp / 32; ++k)
                    AscendC::LoadDataWithTranspose(b2[k * np * 32], b1[(k0 - packet) * 32 + k * 1024], bp);
                if (k0 + MadK >= end) {
                    bq.FreeTensor(b1);
                    if (packet + 2 * PacketK < s.k)
                        CopyNzBPacket<PacketK, 0, PackedWeights>(bq, weight, s, block, packet + 2 * PacketK, s.k);
                }
                AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(ready[ks]);
                AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(ready[ks]);
                AscendC::MmadParams mm{};
                mm.m = firstM; mm.n = np; mm.k = kp; mm.cmatrixInitVal = k0 == 0;
                const bool last = k0 + MadK >= s.k;
                mm.unitFlag = last ? 3 : 2;
                AscendC::Mmad(c0, a2, b2, mm);
                if ((mm.m / 16) * (mm.n / 16) < 10) AscendC::PipeBarrier<PIPE_M>();
                if (last) PublishCLayout<NativeC,Columns>(ring, c0, firstM, np, sequence, cFree[cs]);
                if (secondM) {
                    mm.m = secondM;
                    AscendC::Mmad(c1, a2[64 * kp], b2, mm);
                    if ((mm.m / 16) * (mm.n / 16) < 10) AscendC::PipeBarrier<PIPE_M>();
                    if (last) PublishCLayout<NativeC,Columns>(ring, c1, secondM, np, sequence, cFree[cs2]);
                }
                // Both MAD consumers retire before either shared L0 slot is reused.
                AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(free[ks]);
            }
        }
    }
    // Empty Cube workers must reach the same one global rendezvous.
    if (!packedReady) {
        AscendC::PipeBarrier<PIPE_ALL>();
        AscendC::SyncAll<false>();
    }
    for (uint32_t i = 0; i < 2; ++i) {
        AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(free[i]);
        AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(cFree[i]);
        pipe.ReleaseEventID<AscendC::HardEvent::M_MTE1>(free[i]);
        pipe.ReleaseEventID<AscendC::HardEvent::MTE1_M>(ready[i]);
        pipe.ReleaseEventID<AscendC::HardEvent::FIX_M>(cFree[i]);
        AscendC::CrossCoreWaitFlag<2>(4 + i);
    }
}
#endif

template <bool Persistent, bool NativeC = false>
__schedmode__(1) __global__ __mix__(1, 2) void NzAZeroWeightKernel(GM_ADDR x, GM_ADDR w,
    GM_ADDR scale, GM_ADDR groups, GM_ADDR y, GM_ADDR workspace, Shape shape, uint64_t ringOffset)
{
    AscendC::TPipe pipe;
#ifdef __DAV_CUBE__
    NzAZeroEarlyCube<Persistent, true,NativeC>(x, workspace, groups, workspace + ringOffset, shape, pipe);
#else
    if (shape.vectorPrefetch)
        PrepareBalancedNzWeightsFullRows(w,workspace,groups,shape,pipe);
    else PrepareNzWeights(w, workspace, groups, shape, pipe);
    AscendC::PipeBarrier<PIPE_ALL>();
    AscendC::SyncAll<false>();
    pipe.Reset();
    if constexpr(NativeC)NativeCVectorRun<Persistent?10:4>(scale,groups,y,workspace+ringOffset,shape,pipe);
    else VectorRun<Persistent ? 10 : 4, 64, 256, 32>(scale, groups, y, workspace + ringOffset, shape, pipe);
#endif
}

// Included inside grouped_matmul_gelu. All group contents are read on device.
struct NzPanelWork {
    uint64_t l1 = 0, mac = 0, frames = 0;
    __aicore__ bool Less(const NzPanelWork& b) const {
        return l1 != b.l1 ? l1 < b.l1 : mac != b.mac ? mac < b.mac : frames < b.frames;
    }
    __aicore__ bool Equal(const NzPanelWork& b) const {
        return l1 == b.l1 && mac == b.mac && frames == b.frames;
    }
    __aicore__ void Maxima(const NzPanelWork& b) {
        if (l1 < b.l1) l1 = b.l1;
        if (mac < b.mac) mac = b.mac;
        if (frames < b.frames) frames = b.frames;
    }
};
struct NzActivePanelGroup {
    int64_t expert, begin, end;
    uint64_t macros;
    uint32_t tailRows, tailPad;
};
__aicore__ inline NzPanelWork NzPanelPart(const NzActivePanelGroup& g,
    uint32_t np, uint64_t count, bool last)
{
    const uint64_t pad = 128 * count - (last ? 128 - g.tailPad : 0);
    return {pad + np + (last ? g.tailPad - g.tailRows : 0), pad * np,
        2 * count - (last ? 2 - (g.tailRows + 63) / 64 : 0)};
}
// Floor-based contiguous partition: only the final part contains the M tail.
__aicore__ inline NzPanelWork NzPanelScore(const NzActivePanelGroup& g,
    uint32_t np, uint32_t quota, bool componentMax = false)
{
    const uint64_t d = g.macros / quota, r = g.macros % quota;
    NzPanelWork result = NzPanelPart(g, np, d + (r != 0), true);
    if (quota > 1) {
        const NzPanelWork regular = NzPanelPart(g, np, d + (r > 1), false);
        if (componentMax) result.Maxima(regular);
        else if (result.Less(regular)) result = regular;
    }
    return result;
}
__aicore__ inline uint64_t NzPanelNPrefix(uint64_t t, uint32_t panels, uint32_t packedN)
{
    const uint64_t remainder = t % panels * 256;
    return t / panels * packedN + (remainder < packedN ? remainder : packedN);
}
// Exact original A reuse, padded MAC and C-frame work; Kp is a common factor.
template <bool Persistent>
__aicore__ inline NzPanelWork NzPanelOriginal(const NzActivePanelGroup* groups,
    uint32_t active, Shape s, uint64_t totalMacros, uint32_t worker, uint32_t workers)
{
    NzPanelWork result;
    const uint32_t nc = s.columnTiles, np = s.packedPartials;
    uint64_t prefix = 0;
    const uint64_t begin = totalMacros * nc * worker / workers;
    const uint64_t end = totalMacros * nc * (worker + 1) / workers;
    for (uint32_t i = 0; i < active; ++i) {
        const auto& g = groups[i];
        if constexpr (Persistent) {
            const uint32_t first = (worker + workers - prefix % workers) % workers;
            if (first < g.macros) {
                const uint64_t count = (g.macros - first + workers - 1) / workers;
                const bool tail = (prefix + g.macros - 1) % workers == worker;
                const uint64_t pad = 128 * count - (tail ? 128 - g.tailPad : 0);
                result.l1 += pad + uint64_t(np) * count + (tail ? g.tailPad - g.tailRows : 0);
                result.mac += pad * np;
                result.frames += 2 * nc * count - (tail ? (2 - (g.tailRows + 63) / 64) * nc : 0);
            }
        } else {
            const uint64_t base = prefix * nc, limit = (prefix + g.macros) * nc;
            const uint64_t b = begin > base ? begin : base;
            const uint64_t e = end < limit ? end : limit;
            if (b < e) {
                const uint64_t localB = b - base, localE = e - base;
                const uint64_t count = (localE - 1) / nc - localB / nc + 1;
                const uint64_t bSum = NzPanelNPrefix(localE, nc, np) - NzPanelNPrefix(localB, nc, np);
                const uint64_t tailStart = (g.macros - 1) * nc;
                const uint64_t lastB = localB > tailStart ? localB : tailStart;
                const bool tail = localE > lastB;
                const uint64_t tailB = tail ? NzPanelNPrefix(localE, nc, np) - NzPanelNPrefix(lastB, nc, np) : 0;
                result.l1 += 128 * count + bSum - (tail ? 128 - g.tailPad : 0) + (tail ? g.tailPad - g.tailRows : 0);
                result.mac += 128 * bSum - (128 - g.tailPad) * tailB;
                result.frames += 2 * (e - b) - (tail ? (2 - (g.tailRows + 63) / 64) * (localE - lastB) : 0);
            }
        }
        prefix += g.macros;
    }
    return result;
}
struct NzPanelPlan {
    bool enabled = false;
    int64_t expert = 0, rowBegin = 0, rowEnd = 0, column = 0;
    uint32_t columns = 0;

    template <bool Persistent>
    __aicore__ void Build(GM_ADDR address, Shape s, uint32_t worker, uint32_t workers)
    {
        // Fixed local metadata capacity is guarded by real launch resources.
        if (!workers || workers > 32 || s.columnTiles < 4 || s.columnTiles > workers) return;
        // Equal panel quotas should not waste more than 20% of the available N work.
        if (uint64_t(4) * 256 * s.columnTiles > uint64_t(5) * s.packedPartials) return;
        constexpr uint32_t MaxActive = 1, MaxPanels = 32;
        NzActivePanelGroup groups[MaxActive];
        uint32_t quota[MaxPanels];
        AscendC::GlobalTensor<int64_t> gm;
        gm.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(address));
        const uint32_t nc = s.columnTiles;
        int64_t activeExpert = 0, end = gm.GetValue(0);
        if (end == 0) {
            int64_t low = 1, high = s.experts - 1;
            while (low < high) {
                const int64_t mid = (low + high) / 2;
                if (gm.GetValue(mid) == 0) low = mid + 1;
                else high = mid;
            }
            activeExpert = low; end = gm.GetValue(activeExpert);
        }
        // A first nonempty prefix smaller than M proves that another expert is active.
        if (end != s.m) return;
        const uint32_t active = 1;
        const uint64_t totalMacros = (s.m + 127) / 128;
        const uint32_t tail = s.m - (totalMacros - 1) * 128;
        groups[0] = {activeExpert, 0, s.m, totalMacros, tail, (tail + 15) / 16 * 16};
        const uint32_t panels = active * nc;
        const uint64_t tasks = totalMacros * nc;
        const uint32_t budget = tasks < workers ? tasks : workers;
        const uint32_t extra = budget - panels;
        uint32_t assigned = 0;
        for (uint32_t p = 0; p < panels; ++p) {
            quota[p] = 1 + extra * groups[p / nc].macros / tasks;
            assigned += quota[p];
        }
        while (assigned < budget) {
            uint32_t best = panels;
            NzPanelWork bestNow, bestNext;
            for (uint32_t p = 0; p < panels; ++p) {
                const auto& g = groups[p / nc];
                if (quota[p] >= g.macros) continue;
                const uint32_t np = p % nc + 1 == nc ? s.packedPartials - (nc - 1) * 256 : 256;
                const auto now = NzPanelScore(g, np, quota[p]);
                const auto next = NzPanelScore(g, np, quota[p] + 1);
                if (best == panels || bestNow.Less(now) || (bestNow.Equal(now) && bestNext.Less(next))) {
                    best = p; bestNow = now; bestNext = next;
                }
            }
            ++quota[best]; ++assigned;
        }
        NzPanelWork oldMax, newMax;
        for (uint32_t w = 0; w < workers; ++w)
            oldMax.Maxima(NzPanelOriginal<Persistent>(groups, active, s, totalMacros, w, workers));
        for (uint32_t p = 0; p < panels; ++p) {
            const uint32_t np = p % nc + 1 == nc ? s.packedPartials - (nc - 1) * 256 : 256;
            newMax.Maxima(NzPanelScore(groups[p / nc], np, quota[p], true));
        }
        if (newMax.l1 >= oldMax.l1 || 4 * newMax.mac > 5 * oldMax.mac ||
            newMax.frames > oldMax.frames) return;
        enabled = true;
        uint32_t first = 0;
        for (uint32_t p = 0; p < panels; ++p) {
            if (worker >= first && worker < first + quota[p]) {
                const auto& g = groups[p / nc];
                const uint32_t part = worker - first;
                expert = g.expert;
                rowBegin = g.begin + g.macros * part / quota[p] * 128;
                rowEnd = g.begin + g.macros * (part + 1) / quota[p] * 128;
                if (rowEnd > g.end) rowEnd = g.end;
                column = p % nc * 256;
                columns = s.n - column < 256 ? s.n - column : 256;
                break;
            }
            first += quota[p];
        }
    }
};
template <bool VectorFrames>
class NzPanelSegments {
public:
    __aicore__ explicit NzPanelSegments(const NzPanelPlan& p) : plan(p), row(p.rowBegin) {}
    __aicore__ bool Next(Segment& out) {
        if constexpr (VectorFrames) {
            if (pending) { out = child; pending = false; return true; }
        }
        if (row >= plan.rowEnd) return false;
        const uint32_t rows = plan.rowEnd - row < 128 ? plan.rowEnd - row : 128;
        out = {plan.expert, row, plan.column, rows, plan.columns};
        row += rows;
        if constexpr (VectorFrames) {
            if (rows > 64) {
                child = out; child.row += 64; child.rows -= 64;
                out.rows = 64; pending = true;
            }
        }
        return true;
    }
private:
    NzPanelPlan plan;
    int64_t row;
    Segment child;
    bool pending = false;
};

#ifndef __DAV_CUBE__
__aicore__ inline void NzPanelVectorRun(GM_ADDR scaleAddress, GM_ADDR groupsAddress, GM_ADDR yAddress,
    GM_ADDR workspace, Shape shape, AscendC::TPipe& pipe, const NzPanelPlan& plan)
{
    constexpr uint32_t Rows = 64, Columns = 256, StripeRows = 32;
    constexpr uint32_t kColumnsPerTile = Columns;
    constexpr uint32_t kVectorRows = Rows / 2;
    constexpr uint32_t kStripeRows = StripeRows;
    constexpr uint32_t kVectorElements = StripeRows * Columns;
    const uint32_t worker = AscendC::GetBlockIdx() / 2;
    const uint32_t sub = AscendC::GetSubBlockIdx();
    AscendC::GlobalTensor<float> scale;
    AscendC::GlobalTensor<half> y;
    AscendC::GlobalTensor<int32_t> ring;
    scale.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scaleAddress));
    y.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(yAddress));
    ring.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(workspace) + worker * kSlots * kTileElements);
        AscendC::TBuf<AscendC::TPosition::VECCALC> cInput;
        AscendC::TBuf<AscendC::TPosition::VECCALC> zBuffer, uBuffer, scaleBuffer,
            outputBuffer;
        pipe.InitBuffer(cInput, kVectorRows * kColumnsPerTile * sizeof(int32_t));
        pipe.InitBuffer(zBuffer, kVectorElements * sizeof(float) + 256);
        pipe.InitBuffer(uBuffer, kVectorElements * sizeof(float) + 256);
        pipe.InitBuffer(scaleBuffer, kColumnsPerTile * sizeof(float) + 256);
        pipe.InitBuffer(outputBuffer, kVectorElements * sizeof(half));
        auto z = zBuffer.Get<float>();
        auto u = uBuffer.Get<float>();
        auto scaleTile = scaleBuffer.Get<float>()[64];
        auto outputTile = outputBuffer.Get<half>();

    const event_t outputFree = static_cast<event_t>(pipe.AllocEventID<AscendC::HardEvent::MTE3_V>());
    AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(outputFree);
    for (uint32_t i = 0; i < kSlots; ++i) AscendC::CrossCoreSetFlag<2, PIPE_MTE2>(4 + i);
    NzPanelSegments<true> segments(plan);
    Segment segment;
    uint32_t sequence = 0;
    while (segments.Next(segment)) {
        const uint32_t slot = sequence++ % kSlots;
        AscendC::CrossCoreWaitFlag<2>(slot);
        const uint32_t partitionRows = (segment.rows + 1) / 2;
        const uint32_t firstRow = sub * partitionRows;
        const uint32_t rows = segment.rows <= firstRow ? 0 :
            (segment.rows - firstRow < partitionRows ? segment.rows - firstRow : partitionRows);
        if (!rows) {
            AscendC::CrossCoreSetFlag<2, PIPE_MTE2>(4 + slot);
            continue;
        }
        const int64_t row = segment.row + firstRow;
        const int64_t expert = segment.expert;
        const int64_t firstColumn = segment.column;
        const uint32_t columns = segment.columns;
        const uint32_t paddedColumns = (columns + 15) / 16 * 16;
        // Complete previous C/scale vector reads before either MTE2 overwrite.
        auto c = cInput.Get<int32_t>();
        if (paddedColumns != (columns + 7) / 8 * 8)
            AscendC::Duplicate(c, int32_t(0), rows * paddedColumns);
        Fence<AscendC::HardEvent::V_MTE2>();
        AscendC::DataCopyExtParams copyIn{static_cast<uint16_t>(rows),
            columns * uint32_t(sizeof(int32_t)), (kColumnsPerTile - columns) * uint32_t(sizeof(int32_t)),
            (paddedColumns - (columns + 7) / 8 * 8) / 8, 0};
        AscendC::DataCopyPadExtParams<int32_t> cPad{true, 0,
            static_cast<uint8_t>((columns + 7) / 8 * 8 - columns), 0};
        AscendC::DataCopyPad(c, ring[slot * kTileElements + firstRow * kColumnsPerTile], copyIn, cPad);
        // Publish recycle after C's MTE2 copy; scale has a separate GM source.
        AscendC::CrossCoreSetFlag<2, PIPE_MTE2>(4 + slot);
                    if (paddedColumns == columns) {
                        AscendC::DataCopy(scaleTile, scale[expert * shape.n + firstColumn], columns);
                    } else {
                        AscendC::Duplicate(scaleTile, 0.0f, paddedColumns);
                        Fence<AscendC::HardEvent::V_MTE2>();
                        AscendC::DataCopyExtParams scaleCopy{1, columns * uint32_t(sizeof(float)), 0, 0, 0};
                        AscendC::DataCopyPadExtParams<float> scalePad{true, 0,
                            static_cast<uint8_t>((columns + 7) / 8 * 8 - columns), 0.0f};
                        AscendC::DataCopyPad(scaleTile, scale[expert * shape.n + firstColumn], scaleCopy, scalePad);
                    }
                    Fence<AscendC::HardEvent::MTE2_V>();
                    for (uint32_t stripe = 0; stripe < rows; stripe += kStripeRows) {
                        const uint32_t stripeRows = rows - stripe < kStripeRows ? rows - stripe : kStripeRows;
                        const uint32_t elementCount = stripeRows * paddedColumns;
                        asc_int322float_rn(Ub(z), Ub(c[stripe * paddedColumns]), elementCount);
                        AscendC::PipeBarrier<PIPE_V>();
                        for (uint32_t col = 0; col < paddedColumns; col += 64) {
                            const uint32_t count = paddedColumns - col < 64 ? paddedColumns - col : 64;

                            asc_set_mask_norm();
                            asc_set_vector_mask(0, count == 64 ? ~uint64_t(0) : (uint64_t(1) << count) - 1);
                            asc_mul(Ub(z[col]), Ub(z[col]), Ub(scaleTile[col]), static_cast<uint8_t>(stripeRows),
                                1, 1, 1, static_cast<uint8_t>(paddedColumns / 8),
                                static_cast<uint8_t>(paddedColumns / 8), 0);
                            asc_set_vector_mask(~uint64_t(0), ~uint64_t(0));
                        }
                        AscendC::PipeBarrier<PIPE_V>();
                        const uint32_t elements = stripeRows * paddedColumns;
                        asc_set_mask_count();
                        asc_set_vector_mask(0, elements);
                        // Stable sigmoid form. Clipping positive exponent at 80 only
                        // changes values that round to FP16 zero for |z| <= 60000.
                        kernel_common::GeluCountMasked(Ub(z),Ub(u));
                        // Only output narrowing overwrites the previous MTE3 source.
                        AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(outputFree);
                        asc_float2half_rn(Ub(outputTile), Ub(z), 1, 1, 1, 4, 8);
                        asc_set_mask_norm();
                        asc_set_vector_mask(~uint64_t(0), ~uint64_t(0));
                        // Publish narrowing directly to MTE3; input reuse is guarded above.
                        Fence<AscendC::HardEvent::V_MTE3>();
                        AscendC::DataCopyExtParams copy{static_cast<uint16_t>(stripeRows),
                            columns * uint32_t(sizeof(half)), 0,
                            static_cast<uint32_t>((shape.n - columns) * sizeof(half)), 0};
                        // UB rows include 32B padding; GM rows retain the exact ND width.
                        copy.srcStride = (paddedColumns - (columns + 15) / 16 * 16) / 16;
                        AscendC::DataCopyPad(y[(row + stripe) * shape.n + firstColumn], outputTile, copy);
                        AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(outputFree);
                    }

    }
    AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(outputFree);
    pipe.ReleaseEventID<AscendC::HardEvent::MTE3_V>(outputFree);
}
#endif

#ifdef __DAV_CUBE__

__aicore__ inline void CopyNzResidentPacket(AscendC::LocalTensor<int8_t> b1,
    AscendC::GlobalTensor<int8_t> packed, Shape s, Segment segment,
    uint32_t start, event_t free, event_t ready)
{
    const uint32_t count = s.k - start < 256 ? s.k - start : 256;
    const uint32_t kp = (count + 31) / 32 * 32;
    const uint32_t np = (segment.columns + 31) / 32 * 32;
    AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(free);
    // Both strides are 32-byte units: keep full-K distance between N32 panels.
    AscendC::DataCopyParams copy{static_cast<uint16_t>(np / 32),
        static_cast<uint16_t>(kp), static_cast<uint16_t>(s.residentK - kp),
        static_cast<uint16_t>(s.residentK - kp)};
    const uint64_t base = uint64_t(segment.expert) * s.residentK * s.packedPartials +
        uint64_t(segment.column) * s.residentK + uint64_t(start) * 32;
    AscendC::DataCopy(b1[start * 32], packed[base], copy);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(ready);
}
template<bool NativeC=false>
__aicore__ inline void NzPanelResidentCube(GM_ADDR xAddress, GM_ADDR weightAddress,
    GM_ADDR groupsAddress, GM_ADDR workspace, Shape s, AscendC::TPipe& pipe, const NzPanelPlan& plan)
{
    constexpr uint32_t Columns = 256, PacketK = 256, MadK = 128;
    const uint32_t worker = AscendC::GetBlockIdx();
    AscendC::GlobalTensor<int8_t> x, weight;
    AscendC::GlobalTensor<int32_t> ring;
    x.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(xAddress));
    weight.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(weightAddress));
    ring.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(workspace) + worker * kSlots * kTileElements);
    AscendC::SetAtomicNone();
    AscendC::SetMMRowMajor();
    AscendC::SetLoadDataBoundary(uint64_t(0));
    AscendC::SetLoadDataPaddingValue(uint64_t(0));
    AscendC::TBuf<AscendC::TPosition::A1> resident;
    AscendC::TBuf<AscendC::TPosition::B1> residentB;
    AscendC::TBuf<AscendC::TPosition::A2> ab;
    AscendC::TBuf<AscendC::TPosition::B2> bb;
    AscendC::TBuf<AscendC::TPosition::CO1> cb;
    pipe.InitBuffer(resident, 128 * s.residentK);
    pipe.InitBuffer(residentB, s.residentK * Columns);
    pipe.InitBuffer(ab, 2 * 128 * MadK);
    pipe.InitBuffer(bb, 2 * Columns * MadK);
    pipe.InitBuffer(cb, 2 * kL0CSlotElements * sizeof(int32_t));
    auto a1 = resident.Get<int8_t>();
    auto b1 = residentB.Get<int8_t>();
    auto aAll = ab.Get<int8_t>();
    auto bAll = bb.Get<int8_t>();
    auto cAll = cb.Get<int32_t>();
    event_t free[2], ready[2], cFree[2], bFree[2], bReady[2];
    for (uint32_t i = 0; i < 2; ++i) {
        free[i] = static_cast<event_t>(pipe.AllocEventID<AscendC::HardEvent::M_MTE1>());
        ready[i] = static_cast<event_t>(pipe.AllocEventID<AscendC::HardEvent::MTE1_M>());
        cFree[i] = static_cast<event_t>(pipe.AllocEventID<AscendC::HardEvent::FIX_M>());
        bFree[i] = static_cast<event_t>(pipe.AllocEventID<AscendC::HardEvent::MTE1_MTE2>());
        bReady[i] = static_cast<event_t>(pipe.AllocEventID<AscendC::HardEvent::MTE2_MTE1>());
        AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(bFree[i]);
        AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(free[i]);
        AscendC::SetFlag<AscendC::HardEvent::FIX_M>(cFree[i]);
    }
    NzPanelSegments<false> blocks(plan);
    Segment block;
    uint32_t sequence = 0, kSequence = 0;
    int64_t loadedRow = -1;
    bool packedReady = false, residentReady = false;
    while (blocks.Next(block)) {
        if (loadedRow != block.row) {
            LoadNzResidentRowTail(a1, x, s, block, 0, s.k);
            loadedRow = block.row;
        }
        // First A is independent of the AIV-produced B workspace.
        if (!packedReady) {
            AscendC::PipeBarrier<PIPE_ALL>();
            AscendC::SyncAll<false>();
            packedReady = true;
        }
        const uint32_t mp = (block.rows + 15) / 16 * 16;
        const uint32_t np = (block.columns + 31) / 32 * 32;
        const uint32_t firstM = mp < 64 ? mp : 64;
        const uint32_t secondM = mp > 64 ? mp - 64 : 0;
        const uint32_t cs = sequence & 1, cs2 = (sequence + 1) & 1;
        auto c0 = cAll[cs * kL0CSlotElements];
        auto c1 = cAll[cs2 * kL0CSlotElements];
        AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(cFree[cs]);
        if (secondM) AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(cFree[cs2]);
        if (!residentReady) {
            CopyNzResidentPacket(b1, weight, s, block, 0, bFree[0], bReady[0]);
            if (PacketK < s.k) CopyNzResidentPacket(b1, weight, s, block, PacketK, bFree[1], bReady[1]);
        }
        for (uint32_t packet = 0; packet < s.k; packet += PacketK) {
            const uint32_t end = s.k - packet < PacketK ? s.k : packet + PacketK;
            const uint32_t bs = (packet / PacketK) & 1;
            if (!residentReady) AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(bReady[bs]);
            for (uint32_t k0 = packet; k0 < end; k0 += MadK, ++kSequence) {
                const uint32_t count = end - k0 < MadK ? end - k0 : MadK;
                const uint32_t kp = (count + 31) / 32 * 32;
                const uint32_t ks = kSequence & 1;
                auto a2 = aAll[ks * 128 * MadK];
                auto b2 = bAll[ks * Columns * MadK];
                AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(free[ks]);
                AscendC::LoadData2DParams ap{};
                ap.repeatTimes = kp / 32; ap.srcStride = mp / 16;
                for (uint32_t m = 0; m < mp / 16; ++m)
                    AscendC::LoadData(a2[m * kp * 16], a1[k0 * mp + m * 512], ap);
                AscendC::LoadData2dTransposeParams bp{};
                bp.repeatTimes = np / 32; bp.srcStride = s.residentK / 32; bp.dstGap = 1;
                for (uint32_t k = 0; k < kp / 32; ++k)
                    AscendC::LoadDataWithTranspose(b2[k * np * 32], b1[k0 * 32 + k * 1024], bp);
                if (!residentReady && k0 + MadK >= end) {
                    // Consume ready before reusing its event ID; physical B slices never overlap.
                    AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(bFree[bs]);
                    if (packet + 2 * PacketK < s.k)
                        CopyNzResidentPacket(b1, weight, s, block, packet + 2 * PacketK, bFree[bs], bReady[bs]);
                }
                AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(ready[ks]);
                AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(ready[ks]);
                AscendC::MmadParams mm{};
                mm.m = firstM; mm.n = np; mm.k = kp; mm.cmatrixInitVal = k0 == 0;
                const bool last = k0 + MadK >= s.k;
                mm.unitFlag = last ? 3 : 2;
                AscendC::Mmad(c0, a2, b2, mm);
                if ((mm.m / 16) * (mm.n / 16) < 10) AscendC::PipeBarrier<PIPE_M>();
                if (last) PublishCLayout<NativeC,Columns>(ring, c0, firstM, np, sequence, cFree[cs]);
                if (secondM) {
                    mm.m = secondM;
                    AscendC::Mmad(c1, a2[64 * kp], b2, mm);
                    if ((mm.m / 16) * (mm.n / 16) < 10) AscendC::PipeBarrier<PIPE_M>();
                    if (last) PublishCLayout<NativeC,Columns>(ring, c1, secondM, np, sequence, cFree[cs2]);
                }
                // Both MAD consumers retire before either shared L0 slot is reused.
                AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(free[ks]);
            }
        }
        residentReady = true;
    }
    // Empty Cube workers must reach the same one global rendezvous.
    if (!packedReady) {
        AscendC::PipeBarrier<PIPE_ALL>();
        AscendC::SyncAll<false>();
    }
    for (uint32_t i = 0; i < 2; ++i) {
        AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(bFree[i]);
        pipe.ReleaseEventID<AscendC::HardEvent::MTE1_MTE2>(bFree[i]);
        pipe.ReleaseEventID<AscendC::HardEvent::MTE2_MTE1>(bReady[i]);
        AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(free[i]);
        AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(cFree[i]);
        pipe.ReleaseEventID<AscendC::HardEvent::M_MTE1>(free[i]);
        pipe.ReleaseEventID<AscendC::HardEvent::MTE1_M>(ready[i]);
        pipe.ReleaseEventID<AscendC::HardEvent::FIX_M>(cFree[i]);
        AscendC::CrossCoreWaitFlag<2>(4 + i);
    }
}
#endif

template <bool Persistent, bool NativeC = false>
__schedmode__(1) __global__ __mix__(1, 2) void NzPanelResidentWeightKernel(GM_ADDR x, GM_ADDR w,
    GM_ADDR scale, GM_ADDR groups, GM_ADDR y, GM_ADDR workspace, Shape shape, uint64_t ringOffset)
{
    AscendC::TPipe pipe;
    NzPanelPlan plan;
#ifdef __DAV_CUBE__
    const uint32_t worker = AscendC::GetBlockIdx();
#else
    const uint32_t worker = AscendC::GetBlockIdx() / 2;
#endif
    plan.Build<Persistent>(groups, shape, worker, AscendC::GetBlockNum());
#ifdef __DAV_CUBE__
    if (plan.enabled)
        NzPanelResidentCube<NativeC>(x, workspace, groups, workspace + ringOffset, shape, pipe, plan);
    else
        NzAZeroEarlyCube<Persistent, true,NativeC>(x, workspace, groups, workspace + ringOffset, shape, pipe);
#else
    if (shape.vectorPrefetch)
        PrepareBalancedNzWeightsFullRows(w, workspace, groups, shape, pipe);
    else PrepareNzWeights(w, workspace, groups, shape, pipe);
    AscendC::PipeBarrier<PIPE_ALL>();
    AscendC::SyncAll<false>();
    pipe.Reset();
    if constexpr(NativeC) {
        if(plan.enabled){NzPanelSegments<true> segments(plan);NativeCVectorPrepared(scale,y,workspace+ringOffset,shape,pipe,segments);}
        else NativeCVectorRun<Persistent?10:4>(scale,groups,y,workspace+ringOffset,shape,pipe);
    } else {
    if (plan.enabled)
        NzPanelVectorRun(scale, groups, y, workspace + ringOffset, shape, pipe, plan);
    else
        VectorRun<Persistent ? 10 : 4, 64, 256, 32>(scale, groups, y, workspace + ringOffset, shape, pipe);
    }
#endif
}



// Per-core row bands are determined from the existing group-length scan.
struct ResidentOwnerBands {
    Segment segments[2]{};
    uint32_t count=0;
};

__aicore__ inline ResidentOwnerBands PlanResidentOwnerBands(const int64_t* rows,
    uint32_t experts,uint32_t worker,uint32_t workers,uint32_t pairs,uint32_t bands) {
    ResidentOwnerBands out;
    if(!workers||pairs>workers||bands>2*workers) return out;
    // A worker assigned a pair can receive at most one single band.
    const uint32_t firstSingle=(worker+workers-pairs)%workers;
    uint32_t pair=0,single=0,first=0;
    for(uint32_t expert=0;expert<experts;++expert) {
        const uint32_t length=uint32_t(rows[expert]);
        const uint32_t pairsHere=(length+95)/192;
        const uint32_t pairRows=pairsHere*192;
        if(worker>=pair&&worker-pair<pairsHere) {
            const uint32_t offset=(worker-pair)*192;
            const uint32_t rest=length-offset;
            out.segments[out.count++]={int64_t(expert),int64_t(first+offset),0,
                rest<192?rest:192,0};
        }
        if(length>pairRows) {
            if(single==firstSingle||single==firstSingle+workers) {
                out.segments[out.count++]={int64_t(expert),int64_t(first+pairRows),0,
                    length-pairRows,0};
            }
            ++single;
        }
        first+=length;
        pair+=pairsHere;
    }
    return out;
}

class PlannedResidentBands {
    const ResidentOwnerBands& bands;
    uint32_t index=0,mask;
public:
    __aicore__ PlannedResidentBands(const ResidentOwnerBands& local,uint32_t firstMask):
        bands(local),mask(firstMask){}
    __aicore__ bool Next(Segment& out) {
        while(index<bands.count) {
            const Segment& candidate=bands.segments[index++];
            if((mask>>uint32_t(candidate.expert))&1u) {
                out=candidate;
                return true;
            }
        }
        return false;
    }
};

struct WeightWavePlan {uint32_t firstMask=0,active=0,activeMask=0,firstActive=0,tiles128=0;};
__aicore__ inline bool UseM96WeightWaves(const WeightWavePlan& p,Shape s,uint32_t workers){
    const uint32_t maxTiles96=(uint32_t(s.m)-1)/96+p.active;
    return p.active==uint32_t(s.experts) &&
        (maxTiles96+workers-1)/workers <= (p.tiles128+workers-1)/workers;
}

template<bool ResidentBands>
__aicore__ inline WeightWavePlan BuildWeightWaves(GM_ADDR address,Shape s,
    uint32_t& pairs,uint32_t& bands,ResidentOwnerBands* local=nullptr,
    uint32_t worker=0,uint32_t workers=1) {
    AscendC::GlobalTensor<int64_t> groups;groups.SetGlobalBuffer((__gm__ int64_t*)address);
    int64_t rows[32],previous=0;WeightWavePlan plan;
    for(uint32_t e=0;e<uint32_t(s.experts);++e) {
        const int64_t end=groups.GetValue(e);
        const uint32_t length=end-previous;
        rows[e]=length;
        previous=end;
        if(!length)continue;
        ++plan.active;
        plan.tiles128+=(length+127)/128;
        plan.activeMask|=uint32_t(1)<<e;
        if constexpr(ResidentBands) {
            const uint32_t tiles=(length+95)/96;
            pairs+=tiles/2;
            bands+=(tiles+1)/2;
        }
    }
    // Supply above-mean experts first, using two linear scans instead of ranking.
    for(uint32_t e=0;e<uint32_t(s.experts);++e)
        if(rows[e]*plan.active>=s.m){plan.firstMask|=uint32_t(1)<<e;++plan.firstActive;}
    if constexpr(ResidentBands)if(local&&UseM96WeightWaves(plan,s,workers))
        *local=PlanResidentOwnerBands(rows,s.experts,worker,workers,pairs,bands);
    return plan;
}
template<uint32_t Kind,bool Local>
class WeightWaveSegments {
    Segments<Kind,256,Local,true> base;uint32_t mask;bool second;
public:
    __aicore__ WeightWaveSegments(GM_ADDR address,Shape s,uint32_t worker,uint32_t workers,
        uint32_t firstMask,bool secondWave,AscendC::LocalTensor<int64_t> metadata={}):
        base(address,s,worker,workers,metadata),mask(firstMask),second(secondWave){}
    __aicore__ bool Next(Segment& out){while(base.Next(out)){if(bool((mask>>out.expert)&1u)!=second)return true;}return false;}
};
class WeightWaveConsumer {
    WeightWaveSegments<10,true> first,second;bool firstPhase=true;
public:
    __aicore__ WeightWaveConsumer(GM_ADDR address,Shape s,uint32_t worker,uint32_t workers,
        uint32_t mask,AscendC::LocalTensor<int64_t> metadata):first(address,s,worker,workers,mask,false,metadata),second(address,s,worker,workers,mask,true,metadata){}
    __aicore__ bool Next(Segment& out){if(firstPhase){if(first.Next(out))return true;firstPhase=false;}return second.Next(out);}
};

// Shape rowTile/columnTiles belong to the preserved single-active fallback.
// This independent iterator has actual M96 and N256/256/288 geometry.
template<bool Fragment,bool Local>
class M96WaveSegments {
    Shape s;AscendC::GlobalTensor<int64_t> groups;AscendC::LocalTensor<int64_t> cached;
    uint32_t task,step,expert=0,base=0,end=0,column=0,fragment=0,mask;bool second;
    int64_t beginRow=0,endRow=0;
    __aicore__ int64_t GroupEnd(uint32_t e){if constexpr(Local)return cached.GetValue(e);else return groups.GetValue(e);}
    __aicore__ void AdvanceColumn(){fragment=0;if(++column==3){column=0;task+=step;}}
public:
    __aicore__ M96WaveSegments(GM_ADDR address,Shape shape,uint32_t worker,uint32_t workers,
        uint32_t firstMask,bool secondWave,AscendC::LocalTensor<int64_t> local={}):
        s(shape),cached(local),task(worker),step(workers),mask(firstMask),second(secondWave){
        groups.SetGlobalBuffer((__gm__ int64_t*)address);endRow=GroupEnd(0);end=(endRow+95)/96;
    }
    __aicore__ bool Next(Segment& out){
        while(true){
            while(task>=end){
                if(++expert>=uint32_t(s.experts))return false;
                beginRow=endRow;endRow=GroupEnd(expert);base=end;end+=(endRow-beginRow+95)/96;
            }
            if(bool((mask>>expert)&1u)==second){task+=step;continue;}
            const int64_t row=beginRow+int64_t(task-base)*96;
            const uint32_t rows=endRow-row<96?uint32_t(endRow-row):96;
            const uint32_t col=column*256,cols=column<2?256:uint32_t(s.n-512);
            if constexpr(Fragment){
                const uint32_t first=fragment*48,nrows=rows-first<48?rows-first:48;
                out={int64_t(expert),row+first,int64_t(col),nrows,cols};
                if(!fragment&&rows>48)fragment=1;else AdvanceColumn();
            }else{out={int64_t(expert),row,int64_t(col),rows,cols};AdvanceColumn();}
            return true;
        }
    }
};
class M96WaveConsumer {
    M96WaveSegments<true,true> first,second;bool firstPhase=true;
public:
    __aicore__ M96WaveConsumer(GM_ADDR address,Shape s,uint32_t worker,uint32_t workers,
        uint32_t mask,AscendC::LocalTensor<int64_t> metadata):
        first(address,s,worker,workers,mask,false,metadata),second(address,s,worker,workers,mask,true,metadata){}
    __aicore__ bool Next(Segment& out){if(firstPhase){if(first.Next(out))return true;firstPhase=false;}return second.Next(out);}
};



#ifndef __DAV_CUBE__
__aicore__ inline __attribute__((always_inline)) void IssuePrefetchB(AscendC::LocalTensor<int8_t> input,
    AscendC::GlobalTensor<int8_t> weight,Shape s,NzBalancedRowTask task,event_t free,event_t ready){
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(free);
    const uint32_t np=s.packedPartials;
    if(task.rows!=task.physicalRows){AscendC::Duplicate(input.ReinterpretCast<int16_t>(),int16_t(0),task.physicalRows*np/2);
        Fence<AscendC::HardEvent::V_MTE2>();}
    if(task.rows){AscendC::DataCopyExtParams cp{uint16_t(task.rows),uint32_t(s.n),0,0,0};
        AscendC::DataCopyPadExtParams<int8_t> pad{true,0,uint8_t(np-s.n),0};
        AscendC::DataCopyPad(input,weight[(uint64_t(task.expert)*s.k+task.k0)*s.n],cp,pad);}
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(ready);
}
// Partition a uniform K suffix among all AIVs, without crossing an expert.
template<uint32_t HeadK>
class ResidentWeightTailRows {
    Shape s;
    uint32_t row,limit,expert,k0,remaining;
    __aicore__ void AdvanceExpert(){
        do{++expert;}while(expert<uint32_t(s.experts)&&!((remaining>>expert)&1u));
    }
public:
    __aicore__ ResidentWeightTailRows(Shape shape,uint32_t worker,uint32_t workers,
        uint32_t mask,uint32_t active):s(shape),remaining(mask){
        const uint32_t span=s.residentK-HeadK,total=span*active;
        row=uint64_t(total)*worker/workers;
        limit=uint64_t(total)*(worker+1)/workers;
        uint32_t ordinal=row/span;
        expert=~uint32_t(0);
        do{AdvanceExpert();}while(ordinal--&&expert<uint32_t(s.experts));
        k0=HeadK+row%span;
    }
    __aicore__ bool Next(NzBalancedRowTask& task){
        if(row>=limit)return false;
        uint32_t count=limit-row;
        if(count>s.residentK-k0)count=s.residentK-k0;
        if(count>s.slabK)count=s.slabK;
        const uint32_t valid=k0>=s.k?0:(s.k-k0<count?uint32_t(s.k-k0):count);
        task={expert,k0,count,valid};
        row+=count;k0+=count;
        if(k0==s.residentK){k0=HeadK;AdvanceExpert();}
        return true;
    }
};
template<uint32_t HeadK>
__aicore__ inline auto MakeResidentWeightRows(Shape s,uint32_t mask,uint32_t active){
    if constexpr(HeadK)return ResidentWeightTailRows<HeadK>(s,AscendC::GetBlockIdx(),AscendC::GetBlockNum()*2,mask,active);
    else return NzBalancedRowTasks(s,mask,0,active,AscendC::GetBlockIdx(),AscendC::GetBlockNum()*2);
}
template<bool Early,uint32_t HeadK=0>
__aicore__ inline void PrepareWaveNzWeights(GM_ADDR weightAddress,GM_ADDR target,
    Shape s,AscendC::TPipe& pipe,uint32_t mask,uint32_t active){
    const uint32_t np=s.packedPartials,Bytes=s.slabK*np;
    AscendC::TBuf<AscendC::TPosition::VECCALC> inputBuffer,outputBuffer;
    pipe.InitBuffer(inputBuffer,2*Bytes);pipe.InitBuffer(outputBuffer,2*Bytes);
    auto inputAll=inputBuffer.Get<int8_t>(),outputAll=outputBuffer.Get<int8_t>();
    AscendC::GlobalTensor<int8_t> weight,packed;
    weight.SetGlobalBuffer((__gm__ int8_t*)weightAddress);packed.SetGlobalBuffer((__gm__ int8_t*)target);
    event_t inputFree[2],inputReady[2],outputFree[2];
    for(uint32_t i=0;i<2;++i){inputFree[i]=(event_t)pipe.AllocEventID<AscendC::HardEvent::V_MTE2>();
        inputReady[i]=(event_t)pipe.AllocEventID<AscendC::HardEvent::MTE2_V>();outputFree[i]=(event_t)pipe.AllocEventID<AscendC::HardEvent::MTE3_V>();
        AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(inputFree[i]);AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(outputFree[i]);}
    auto tasks=MakeResidentWeightRows<HeadK>(s,mask,active);
    NzBalancedRowTask task,next;uint32_t slot=0;bool live=tasks.Next(task);
    if(live)IssuePrefetchB(inputAll,weight,s,task,inputFree[0],inputReady[0]);
    while(live){bool haveNext=false;
        if constexpr(Early){haveNext=tasks.Next(next);if(haveNext)IssuePrefetchB(inputAll[(slot^1)*Bytes],weight,s,next,inputFree[slot^1],inputReady[slot^1]);}
        auto input=inputAll[slot*Bytes],output=outputAll[slot*Bytes];
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(inputReady[slot]);AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(outputFree[slot]);
        for(uint32_t plane=0;plane<np/32;plane+=8){const uint32_t planes=np/32-plane<8?np/32-plane:8,lanes=planes*16;
            asc_set_mask_norm();asc_set_vector_mask(lanes>64?(lanes==128?~uint64_t(0):(uint64_t(1)<<(lanes-64))-1):0,lanes>=64?~uint64_t(0):(uint64_t(1)<<lanes)-1);
            asc_copy(Ub(output.ReinterpretCast<uint16_t>()[plane*task.physicalRows*16]),Ub(input.ReinterpretCast<uint16_t>()[plane*16]),
                uint8_t(task.physicalRows),uint16_t(task.physicalRows),uint16_t(1),uint16_t(1),uint16_t(np/32));}
        asc_set_vector_mask(~uint64_t(0),~uint64_t(0));
        AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(inputFree[slot]);Fence<AscendC::HardEvent::V_MTE3>();
        AscendC::DataCopyParams cp{uint16_t(np/32),uint16_t(task.physicalRows),0,uint16_t(s.residentK-task.physicalRows)};
        AscendC::DataCopy(packed[uint64_t(task.expert)*s.residentK*np+uint64_t(task.k0)*32],output,cp);
        AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(outputFree[slot]);
        if constexpr(!Early){haveNext=tasks.Next(next);if(haveNext)IssuePrefetchB(inputAll[(slot^1)*Bytes],weight,s,next,inputFree[slot^1],inputReady[slot^1]);}
        live=haveNext;if(live)task=next;slot^=1;
    }
    for(uint32_t i=0;i<2;++i){AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(inputFree[i]);AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(outputFree[i]);
        pipe.ReleaseEventID<AscendC::HardEvent::V_MTE2>(inputFree[i]);pipe.ReleaseEventID<AscendC::HardEvent::MTE2_V>(inputReady[i]);pipe.ReleaseEventID<AscendC::HardEvent::MTE3_V>(outputFree[i]);}
}
#endif

#ifdef __DAV_CUBE__
__aicore__ inline void PublishSelectiveAppendPanel(AscendC::GlobalTensor<int32_t> ring,
    AscendC::LocalTensor<int32_t> c,uint32_t mp,uint32_t np,uint32_t& sequence,event_t cFree) {
    const uint32_t frame=sequence++;
    AscendC::FixpipeParamsV220 fp{};fp.unitFlag=3;fp.nSize=np;fp.mSize=mp;
    fp.srcStride=mp;fp.dstStride=2*mp;fp.quantPre=QuantMode_t::NoQuant;fp.isChannelSplit=false;
    AscendC::Fixpipe<int32_t,int32_t,AscendC::CFG_NZ>(ring[frame*kTileElements],c,fp);
    AscendC::SetFlag<AscendC::HardEvent::FIX_M>(cFree);
    AscendC::CrossCoreSetFlag<2,PIPE_FIX>(frame&1);
}
__aicore__ inline void WeightWaveCube(GM_ADDR xAddress, GM_ADDR weightAddress,
    GM_ADDR groupsAddress, GM_ADDR workspace, Shape s, AscendC::TPipe& pipe, uint32_t firstMask)
{
    constexpr uint32_t Columns = 256, PacketK = 256, MadK = 128;
    const uint32_t worker = AscendC::GetBlockIdx();
    AscendC::GlobalTensor<int8_t> x, weight;
    AscendC::GlobalTensor<int32_t> ring;
    x.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(xAddress));
    weight.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(weightAddress));
    ring.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(workspace) + worker * 24 * kTileElements);
    AscendC::SetAtomicNone();
    AscendC::SetMMRowMajor();
    AscendC::SetLoadDataBoundary(uint64_t(0));
    AscendC::SetLoadDataPaddingValue(uint64_t(0));
    AscendC::TBuf<AscendC::TPosition::A1> resident;
    AscendC::TQue<AscendC::TPosition::B1, 2> bq;
    AscendC::TBuf<AscendC::TPosition::A2> ab;
    AscendC::TBuf<AscendC::TPosition::B2> bb;
    AscendC::TBuf<AscendC::TPosition::CO1> cb;
    pipe.InitBuffer(resident, 128 * s.residentK);
    pipe.InitBuffer(bq, 2, PacketK * Columns);
    pipe.InitBuffer(ab, 2 * 128 * MadK);
    pipe.InitBuffer(bb, 2 * Columns * MadK);
    pipe.InitBuffer(cb, 2 * kL0CSlotElements * sizeof(int32_t));
    auto a1 = resident.Get<int8_t>();
    auto aAll = ab.Get<int8_t>();
    auto bAll = bb.Get<int8_t>();
    auto cAll = cb.Get<int32_t>();
    event_t free[2], ready[2], cFree[2];
    for (uint32_t i = 0; i < 2; ++i) {
        free[i] = static_cast<event_t>(pipe.AllocEventID<AscendC::HardEvent::M_MTE1>());
        ready[i] = static_cast<event_t>(pipe.AllocEventID<AscendC::HardEvent::MTE1_M>());
        cFree[i] = static_cast<event_t>(pipe.AllocEventID<AscendC::HardEvent::FIX_M>());
        AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(free[i]);
        AscendC::SetFlag<AscendC::HardEvent::FIX_M>(cFree[i]);
    }
    Segment block;
    uint32_t sequence = 0, kSequence = 0;
    int64_t loadedRow = -1;
    for(uint32_t phase=0;phase<2;++phase) {
        bool waveReady=false;
        WeightWaveSegments<2,false> blocks(groupsAddress,s,worker,AscendC::GetBlockNum(),firstMask,phase==1);
        while(blocks.Next(block)) {
        if (loadedRow != block.row) {
            LoadNzResidentRowTail(a1, x, s, block, 0, s.k);
            loadedRow = block.row;
        }
        if(!waveReady){AscendC::CrossCoreWaitFlag<2>(8+phase);waveReady=true;}
        const uint32_t mp = (block.rows + 15) / 16 * 16;
        const uint32_t np = (block.columns + 31) / 32 * 32;
        const uint32_t firstM = mp < 64 ? mp : 64;
        const uint32_t secondM = mp > 64 ? mp - 64 : 0;
        const uint32_t cs = sequence & 1, cs2 = (sequence + 1) & 1;
        auto c0 = cAll[cs * kL0CSlotElements];
        auto c1 = cAll[cs2 * kL0CSlotElements];
        AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(cFree[cs]);
        if (secondM) AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(cFree[cs2]);
        CopyNzBPacket<PacketK,0,true>(bq, weight, s, block, 0, s.k);
        if (PacketK < s.k) CopyNzBPacket<PacketK,0,true>(bq, weight, s, block, PacketK, s.k);
        for (uint32_t packet = 0; packet < s.k; packet += PacketK) {
            const uint32_t end = s.k - packet < PacketK ? s.k : packet + PacketK;
            const uint32_t packetKp = (end - packet + 31) / 32 * 32;
            auto b1 = bq.DeQue<int8_t>();
            for (uint32_t k0 = packet; k0 < end; k0 += MadK, ++kSequence) {
                const uint32_t count = end - k0 < MadK ? end - k0 : MadK;
                const uint32_t kp = (count + 31) / 32 * 32;
                const uint32_t ks = kSequence & 1;
                auto a2 = aAll[ks * 128 * MadK];
                auto b2 = bAll[ks * Columns * MadK];
                AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(free[ks]);
                AscendC::LoadData2DParams ap{};
                ap.repeatTimes = kp / 32; ap.srcStride = mp / 16;
                for (uint32_t m = 0; m < mp / 16; ++m)
                    AscendC::LoadData(a2[m * kp * 16], a1[k0 * mp + m * 512], ap);
                AscendC::LoadData2dTransposeParams bp{};
                bp.repeatTimes = np / 32; bp.srcStride = packetKp / 32; bp.dstGap = 1;
                for (uint32_t k = 0; k < kp / 32; ++k)
                    AscendC::LoadDataWithTranspose(b2[k * np * 32], b1[(k0 - packet) * 32 + k * 1024], bp);
                if (k0 + MadK >= end) {
                    bq.FreeTensor(b1);
                    if (packet + 2 * PacketK < s.k)
                        CopyNzBPacket<PacketK,0,true>(bq, weight, s, block, packet + 2 * PacketK, s.k);
                }
                AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(ready[ks]);
                AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(ready[ks]);
                AscendC::MmadParams mm{};
                mm.m = firstM; mm.n = np; mm.k = kp; mm.cmatrixInitVal = k0 == 0;
                const bool last = k0 + MadK >= s.k;
                mm.unitFlag = last ? 3 : 2;
                AscendC::Mmad(c0, a2, b2, mm);
                if ((mm.m / 16) * (mm.n / 16) < 10) AscendC::PipeBarrier<PIPE_M>();
                if (last) PublishSelectiveAppendPanel(ring, c0, firstM, np, sequence, cFree[cs]);
                if (secondM) {
                    mm.m = secondM;
                    AscendC::Mmad(c1, a2[64 * kp], b2, mm);
                    if ((mm.m / 16) * (mm.n / 16) < 10) AscendC::PipeBarrier<PIPE_M>();
                    if (last) PublishSelectiveAppendPanel(ring, c1, secondM, np, sequence, cFree[cs2]);
                }
                // Both MAD consumers retire before either shared L0 slot is reused.
                AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(free[ks]);
            }
        }
    }
    if(!waveReady)AscendC::CrossCoreWaitFlag<2>(8+phase);
    } // both phases
    for (uint32_t i = 0; i < 2; ++i) {
        AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(free[i]);
        AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(cFree[i]);
        pipe.ReleaseEventID<AscendC::HardEvent::M_MTE1>(free[i]);
        pipe.ReleaseEventID<AscendC::HardEvent::MTE1_M>(ready[i]);
        pipe.ReleaseEventID<AscendC::HardEvent::FIX_M>(cFree[i]);
    }
}
#endif

#ifndef __DAV_CUBE__
template<class Iterator,uint32_t Frames=24>
__aicore__ inline void WeightWaveVector(GM_ADDR scaleAddress,GM_ADDR yAddress,
    GM_ADDR workspace,Shape s,AscendC::TPipe& pipe,Iterator& segments) {
    constexpr uint32_t MaxN=256,MaxRows=32,Elements=MaxN*MaxRows;
    const uint32_t worker=AscendC::GetBlockIdx()/2,sub=AscendC::GetSubBlockIdx();
    AscendC::GlobalTensor<int32_t> ring;ring.SetGlobalBuffer((__gm__ int32_t*)workspace+worker*Frames*kTileElements);
    AscendC::GlobalTensor<float> scales;scales.SetGlobalBuffer((__gm__ float*)scaleAddress);
    AscendC::GlobalTensor<half> output;output.SetGlobalBuffer((__gm__ half*)yAddress);
    AscendC::TBuf<AscendC::TPosition::VECCALC> cb,zb,ub,hb,sb,eb,nb;
    pipe.InitBuffer(cb,Elements*4);pipe.InitBuffer(zb,Elements*4+256);
    pipe.InitBuffer(ub,Elements*4+256);pipe.InitBuffer(hb,2*Elements*2);
    pipe.InitBuffer(sb,MaxN*4+256);pipe.InitBuffer(eb,Elements*4);pipe.InitBuffer(nb,Elements*2);
    auto c=cb.Get<int32_t>();auto z=zb.Get<float>()[64],u=ub.Get<float>()[64];
    auto halfNd=hb.Get<half>(),halfNz=nb.Get<half>();
    auto scale=sb.Get<float>()[64],expanded=eb.Get<float>();
    const auto inputFree=(event_t)pipe.AllocEventID<AscendC::HardEvent::V_MTE2>();
    const auto scaleFree=(event_t)pipe.AllocEventID<AscendC::HardEvent::V_MTE2>();
    event_t outputFree[2];
    AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(inputFree);
    AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(scaleFree);
    for(uint32_t i=0;i<2;++i){
        outputFree[i]=(event_t)pipe.AllocEventID<AscendC::HardEvent::MTE3_V>();
        AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(outputFree[i]);
    }
    int64_t scaleExpert=-1,scaleColumn=-1;uint32_t expandedRows=0;
    Segment segment;uint32_t sequence=0;
    while(segments.Next(segment)) {
        const uint32_t frame=sequence++,slot=frame&1;
        AscendC::CrossCoreWaitFlag<2>(slot);
        const uint32_t split=(segment.rows+1)/2,first=sub*split;
        const uint32_t rows=segment.rows<=first?0:(segment.rows-first<split?segment.rows-first:split);
        if(!rows)continue;
        const uint32_t mp=(segment.rows+15)/16*16,np=(segment.columns+31)/32*32;
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(inputFree);
        AscendC::DataCopyParams input{uint16_t(np/16),uint16_t(2*rows),uint16_t(2*(mp-rows)),0};
        AscendC::DataCopy(c,ring[frame*kTileElements+first*16],input);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(scaleFree);
        const bool newScale=scaleExpert!=segment.expert || scaleColumn!=segment.column;
        if(newScale) {
            if(segment.columns!=np) {
                AscendC::Duplicate(scale,0.0f,np);Fence<AscendC::HardEvent::V_MTE2>();
                AscendC::DataCopyExtParams cp{1,segment.columns*4,0,0,0};
                AscendC::DataCopyPadExtParams<float> pad{true,0,uint8_t((segment.columns+7)/8*8-segment.columns),0};
                AscendC::DataCopyPad(scale,scales[segment.expert*s.n+segment.column],cp,pad);
            } else AscendC::DataCopy(scale,scales[segment.expert*s.n+segment.column],np);
            scaleExpert=segment.expert;scaleColumn=segment.column;
        }
        Fence<AscendC::HardEvent::MTE2_V>();
        asc_int322float_rn(Ub(z),Ub(c),rows*np);AscendC::PipeBarrier<PIPE_V>();
        AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(inputFree);
        if(newScale || expandedRows!=rows){ExpandScaleForNativeC(expanded,scale,rows,np);expandedRows=rows;}
        AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(scaleFree);
        asc_set_mask_count();asc_set_vector_mask(0,rows*np);
        asc_mul(Ub(z),Ub(z),Ub(expanded),1,1,1,1,8,8,8);AscendC::PipeBarrier<PIPE_V>();
        kernel_common::GeluCountMasked(Ub(z),Ub(u));
        asc_float2half_rn(Ub(halfNz),Ub(z),1,1,1,4,8);AscendC::PipeBarrier<PIPE_V>();
        AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(outputFree[slot]);
        auto h=halfNd[slot*Elements];NativeHalfCToNd(h,halfNz,rows,np);
        Fence<AscendC::HardEvent::V_MTE3>();
        AscendC::DataCopyExtParams out{uint16_t(rows),segment.columns*2,
            (np-(segment.columns+15)/16*16)/16,uint32_t((s.n-segment.columns)*2),0};
        AscendC::DataCopyPad(output[(segment.row+first)*s.n+segment.column],h,out);
        AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(outputFree[slot]);
    }
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(inputFree);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(scaleFree);
    pipe.ReleaseEventID<AscendC::HardEvent::V_MTE2>(inputFree);
    pipe.ReleaseEventID<AscendC::HardEvent::V_MTE2>(scaleFree);
    for(uint32_t i=0;i<2;++i){AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(outputFree[i]);
        pipe.ReleaseEventID<AscendC::HardEvent::MTE3_V>(outputFree[i]);}
}

#endif

#ifdef __DAV_CUBE__
template<uint32_t Columns,uint32_t PacketK,uint32_t MadK>
__aicore__ inline void M96WaveBlock(AscendC::TQue<AscendC::TPosition::B1,2>& bq,
    AscendC::GlobalTensor<int8_t> weight,AscendC::GlobalTensor<int32_t> ring,Shape s,Segment block,
    AscendC::LocalTensor<int8_t> a1,AscendC::LocalTensor<int8_t> aAll,
    AscendC::LocalTensor<int8_t> bAll,AscendC::LocalTensor<int32_t> cAll,
    event_t (&free)[2],event_t (&ready)[2],event_t (&cFree)[2],uint32_t& sequence,uint32_t& kSequence){
        const uint32_t mp = (block.rows + 15) / 16 * 16;
        const uint32_t np = Columns;
        const uint32_t firstM = mp < 48 ? mp : 48;
        const uint32_t secondM = mp > 48 ? mp - 48 : 0;
        const uint32_t cs = sequence & 1, cs2 = (sequence + 1) & 1;
        auto c0 = cAll[cs * kL0CSlotElements];
        auto c1 = cAll[cs2 * kL0CSlotElements];
        AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(cFree[cs]);
        if (secondM) AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(cFree[cs2]);
        CopyNzBPacket<PacketK,0,true>(bq, weight, s, block, 0, s.k);
        if (PacketK < s.k) CopyNzBPacket<PacketK,0,true>(bq, weight, s, block, PacketK, s.k);
        for (uint32_t packet = 0; packet < s.k; packet += PacketK) {
            const uint32_t end = s.k - packet < PacketK ? s.k : packet + PacketK;
            const uint32_t packetKp = (end - packet + 31) / 32 * 32;
            auto b1 = bq.DeQue<int8_t>();
            for (uint32_t k0 = packet; k0 < end; k0 += MadK, ++kSequence) {
                const uint32_t count = end - k0 < MadK ? end - k0 : MadK;
                const uint32_t kp = (count + 31) / 32 * 32;
                const uint32_t ks = kSequence & 1;
                auto a2 = aAll[ks * 96 * 128];
                auto b2 = bAll[ks * 256 * 128];
                AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(free[ks]);
                AscendC::LoadData2DParams ap{};
                ap.repeatTimes = kp / 32; ap.srcStride = mp / 16;
                for (uint32_t m = 0; m < mp / 16; ++m)
                    AscendC::LoadData(a2[m * kp * 16], a1[k0 * mp + m * 512], ap);
                AscendC::LoadData2dTransposeParams bp{};
                bp.repeatTimes = np / 32; bp.srcStride = packetKp / 32; bp.dstGap = 1;
                for (uint32_t k = 0; k < kp / 32; ++k)
                    AscendC::LoadDataWithTranspose(b2[k * np * 32], b1[(k0 - packet) * 32 + k * 1024], bp);
                if (k0 + MadK >= end) {
                    bq.FreeTensor(b1);
                    if (packet + 2 * PacketK < s.k)
                        CopyNzBPacket<PacketK,0,true>(bq, weight, s, block, packet + 2 * PacketK, s.k);
                }
                AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(ready[ks]);
                AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(ready[ks]);
                AscendC::MmadParams mm{};
                mm.m = firstM; mm.n = np; mm.k = kp; mm.cmatrixInitVal = k0 == 0;
                const bool last = k0 + MadK >= s.k;
                mm.unitFlag = last ? 3 : 2;
                AscendC::Mmad(c0, a2, b2, mm);
                // Columns >= 256 and valid M >= 16 satisfy the accumulation constraint.
                if (last) PublishSelectiveAppendPanel(ring, c0, firstM, np, sequence, cFree[cs]);
                if (secondM) {
                    mm.m = secondM;
                    AscendC::Mmad(c1, a2[48 * kp], b2, mm);
                    // Columns >= 256 and valid M >= 16 satisfy the accumulation constraint.
                    if (last) PublishSelectiveAppendPanel(ring, c1, secondM, np, sequence, cFree[cs2]);
                }
                // Both MAD consumers retire before either shared L0 slot is reused.
                AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(free[ks]);
            }
        }
}
__aicore__ inline void GuardedM96Cube(GM_ADDR xAddress, GM_ADDR weightAddress,
    GM_ADDR groupsAddress, GM_ADDR workspace, Shape s, AscendC::TPipe& pipe, uint32_t firstMask)
{
    constexpr uint32_t Columns = 256, PacketK = 256, MadK = 128;
    const uint32_t worker = AscendC::GetBlockIdx();
    AscendC::GlobalTensor<int8_t> x, weight;
    AscendC::GlobalTensor<int32_t> ring;
    x.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(xAddress));
    weight.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(weightAddress));
    ring.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(workspace) + worker * 18 * kTileElements);
    AscendC::SetAtomicNone();
    AscendC::SetMMRowMajor();
    AscendC::SetLoadDataBoundary(uint64_t(0));
    AscendC::SetLoadDataPaddingValue(uint64_t(0));
    AscendC::TBuf<AscendC::TPosition::A1> resident;
    AscendC::TQue<AscendC::TPosition::B1, 2> bq;
    AscendC::TBuf<AscendC::TPosition::A2> ab;
    AscendC::TBuf<AscendC::TPosition::B2> bb;
    AscendC::TBuf<AscendC::TPosition::CO1> cb;
    pipe.InitBuffer(resident, 96 * s.residentK);
    pipe.InitBuffer(bq, 2, PacketK * Columns);
    pipe.InitBuffer(ab, 2 * 96 * MadK);
    pipe.InitBuffer(bb, 2 * Columns * MadK);
    pipe.InitBuffer(cb, 2 * kL0CSlotElements * sizeof(int32_t));
    auto a1 = resident.Get<int8_t>();
    auto aAll = ab.Get<int8_t>();
    auto bAll = bb.Get<int8_t>();
    auto cAll = cb.Get<int32_t>();
    event_t free[2], ready[2], cFree[2];
    for (uint32_t i = 0; i < 2; ++i) {
        free[i] = static_cast<event_t>(pipe.AllocEventID<AscendC::HardEvent::M_MTE1>());
        ready[i] = static_cast<event_t>(pipe.AllocEventID<AscendC::HardEvent::MTE1_M>());
        cFree[i] = static_cast<event_t>(pipe.AllocEventID<AscendC::HardEvent::FIX_M>());
        AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(free[i]);
        AscendC::SetFlag<AscendC::HardEvent::FIX_M>(cFree[i]);
    }
    Segment block;
    uint32_t sequence = 0, kSequence = 0;
    int64_t loadedRow = -1;
    for(uint32_t phase=0;phase<2;++phase) {
        bool waveReady=false;
        M96WaveSegments<false,false> blocks(groupsAddress,s,worker,AscendC::GetBlockNum(),firstMask,phase==1);
        while(blocks.Next(block)) {
        if (loadedRow != block.row) {
            LoadNzResidentRowTail(a1, x, s, block, 0, s.k);
            loadedRow = block.row;
        }
        if(!waveReady){AscendC::CrossCoreWaitFlag<2>(8+phase);waveReady=true;}
        if(block.column<512)M96WaveBlock<256,256,128>(bq,weight,ring,s,block,a1,aAll,bAll,cAll,free,ready,cFree,sequence,kSequence);
        else M96WaveBlock<288,192,96>(bq,weight,ring,s,block,a1,aAll,bAll,cAll,free,ready,cFree,sequence,kSequence);
    }
    if(!waveReady)AscendC::CrossCoreWaitFlag<2>(8+phase);
    } // both phases
    for (uint32_t i = 0; i < 2; ++i) {
        AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(free[i]);
        AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(cFree[i]);
        pipe.ReleaseEventID<AscendC::HardEvent::M_MTE1>(free[i]);
        pipe.ReleaseEventID<AscendC::HardEvent::MTE1_M>(ready[i]);
        pipe.ReleaseEventID<AscendC::HardEvent::FIX_M>(cFree[i]);
    }
}
#endif

#ifndef __DAV_CUBE__
template<class Iterator>
__aicore__ inline void GuardedM96Vector(GM_ADDR scaleAddress,GM_ADDR yAddress,
    GM_ADDR workspace,Shape s,AscendC::TPipe& pipe,Iterator& segments) {
    constexpr uint32_t MaxN=288,MaxRows=24,Elements=MaxN*MaxRows;
    const uint32_t worker=AscendC::GetBlockIdx()/2,sub=AscendC::GetSubBlockIdx();
    AscendC::GlobalTensor<int32_t> ring;ring.SetGlobalBuffer((__gm__ int32_t*)workspace+worker*18*kTileElements);
    AscendC::GlobalTensor<float> scales;scales.SetGlobalBuffer((__gm__ float*)scaleAddress);
    AscendC::GlobalTensor<half> output;output.SetGlobalBuffer((__gm__ half*)yAddress);
    AscendC::TBuf<AscendC::TPosition::VECCALC> cb,zb,ub,hb,sb,eb,nb;
    pipe.InitBuffer(cb,Elements*4);pipe.InitBuffer(zb,Elements*4+256);
    pipe.InitBuffer(ub,Elements*4+256);pipe.InitBuffer(hb,2*Elements*2);
    pipe.InitBuffer(sb,MaxN*4+256);pipe.InitBuffer(eb,Elements*4);pipe.InitBuffer(nb,Elements*2);
    auto c=cb.Get<int32_t>();auto z=zb.Get<float>()[64],u=ub.Get<float>()[64];
    auto halfNd=hb.Get<half>(),halfNz=nb.Get<half>();
    auto scale=sb.Get<float>()[64],expanded=eb.Get<float>();
    const auto inputFree=(event_t)pipe.AllocEventID<AscendC::HardEvent::V_MTE2>();
    const auto scaleFree=(event_t)pipe.AllocEventID<AscendC::HardEvent::V_MTE2>();
    event_t outputFree[2];
    AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(inputFree);
    AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(scaleFree);
    for(uint32_t i=0;i<2;++i){
        outputFree[i]=(event_t)pipe.AllocEventID<AscendC::HardEvent::MTE3_V>();
        AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(outputFree[i]);
    }
    int64_t scaleExpert=-1,scaleColumn=-1;uint32_t expandedRows=0;
    Segment segment;uint32_t sequence=0;
    while(segments.Next(segment)) {
        const uint32_t frame=sequence++,slot=frame&1;
        AscendC::CrossCoreWaitFlag<2>(slot);
        const uint32_t split=(segment.rows+1)/2,first=sub*split;
        const uint32_t rows=segment.rows<=first?0:(segment.rows-first<split?segment.rows-first:split);
        if(!rows)continue;
        const uint32_t mp=(segment.rows+15)/16*16,np=(segment.columns+31)/32*32;
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(inputFree);
        AscendC::DataCopyParams input{uint16_t(np/16),uint16_t(2*rows),uint16_t(2*(mp-rows)),0};
        AscendC::DataCopy(c,ring[frame*kTileElements+first*16],input);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(scaleFree);
        const bool newScale=scaleExpert!=segment.expert || scaleColumn!=segment.column;
        if(newScale) {
            if(segment.columns!=np) {
                AscendC::Duplicate(scale,0.0f,np);Fence<AscendC::HardEvent::V_MTE2>();
                AscendC::DataCopyExtParams cp{1,segment.columns*4,0,0,0};
                AscendC::DataCopyPadExtParams<float> pad{true,0,uint8_t((segment.columns+7)/8*8-segment.columns),0};
                AscendC::DataCopyPad(scale,scales[segment.expert*s.n+segment.column],cp,pad);
            } else AscendC::DataCopy(scale,scales[segment.expert*s.n+segment.column],np);
            scaleExpert=segment.expert;scaleColumn=segment.column;
        }
        Fence<AscendC::HardEvent::MTE2_V>();
        asc_int322float_rn(Ub(z),Ub(c),rows*np);AscendC::PipeBarrier<PIPE_V>();
        AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(inputFree);
        if(newScale || expandedRows!=rows){ExpandScaleForNativeC(expanded,scale,rows,np);expandedRows=rows;}
        AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(scaleFree);
        asc_set_mask_count();asc_set_vector_mask(0,rows*np);
        asc_mul(Ub(z),Ub(z),Ub(expanded),1,1,1,1,8,8,8);AscendC::PipeBarrier<PIPE_V>();
        kernel_common::GeluCountMasked(Ub(z),Ub(u));
        asc_float2half_rn(Ub(halfNz),Ub(z),1,1,1,4,8);AscendC::PipeBarrier<PIPE_V>();
        AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(outputFree[slot]);
        auto h=halfNd[slot*Elements];NativeHalfCToNd(h,halfNz,rows,np);
        Fence<AscendC::HardEvent::V_MTE3>();
        AscendC::DataCopyExtParams out{uint16_t(rows),segment.columns*2,
            (np-(segment.columns+15)/16*16)/16,uint32_t((s.n-segment.columns)*2),0};
        AscendC::DataCopyPad(output[(segment.row+first)*s.n+segment.column],h,out);
        AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(outputFree[slot]);
    }
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(inputFree);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(scaleFree);
    pipe.ReleaseEventID<AscendC::HardEvent::V_MTE2>(inputFree);
    pipe.ReleaseEventID<AscendC::HardEvent::V_MTE2>(scaleFree);
    for(uint32_t i=0;i<2;++i){AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(outputFree[i]);
        pipe.ReleaseEventID<AscendC::HardEvent::MTE3_V>(outputFree[i]);}
}

#endif

template<bool UseM96,bool LateReady>
__aicore__ __attribute__((noinline, aligned(128))) void WeightWaveEngine(GM_ADDR x,GM_ADDR w,
    GM_ADDR scale,GM_ADDR groups,GM_ADDR y,GM_ADDR workspace,Shape shape,uint64_t ringOffset,WeightWavePlan plan) {
    AscendC::TPipe pipe;
#ifdef __DAV_CUBE__
    if(plan.active>1){
        if constexpr(UseM96)GuardedM96Cube(x,workspace,groups,workspace+ringOffset,shape,pipe,plan.firstMask);
        else WeightWaveCube(x,workspace,groups,workspace+ringOffset,shape,pipe,plan.firstMask);
    }
    else NzAZeroEarlyCube<true,true,true>(x,workspace,groups,workspace+ringOffset,shape,pipe);
#else
    if(plan.active<=1){
        PrepareBalancedNzWeightsFullRows(w,workspace,groups,shape,pipe);
        AscendC::PipeBarrier<PIPE_ALL>();AscendC::SyncAll<false>();pipe.Reset();
        NativeCVectorRun<10>(scale,groups,y,workspace+ringOffset,shape,pipe);return;
    }
    PrepareWaveNzWeights<false>(w,workspace,shape,pipe,plan.firstMask,plan.firstActive);
    AscendC::PipeBarrier<PIPE_ALL>();AscendC::SyncAll<true>();
    if constexpr(!LateReady)AscendC::CrossCoreSetFlag<2,PIPE_MTE3>(8);
    pipe.Reset();
    PrepareWaveNzWeights<false>(w,workspace,shape,pipe,plan.activeMask & ~plan.firstMask,plan.active-plan.firstActive);
    AscendC::PipeBarrier<PIPE_ALL>();AscendC::SyncAll<true>();
    if constexpr(LateReady)AscendC::CrossCoreSetFlag<2,PIPE_MTE3>(8);
    AscendC::CrossCoreSetFlag<2,PIPE_MTE3>(9);pipe.Reset();
    AscendC::TBuf<AscendC::TPosition::VECCALC> metadata;
    pipe.InitBuffer(metadata,(shape.experts+3)/4*32);
    auto local=metadata.Get<int64_t>();AscendC::GlobalTensor<int64_t> groupGm;
    groupGm.SetGlobalBuffer((__gm__ int64_t*)groups);
    AscendC::DataCopyExtParams gc{1,uint32_t(shape.experts*8),0,0,0};
    AscendC::DataCopyPadExtParams<int64_t> gp{false,0,0,0};
    AscendC::DataCopyPad(local,groupGm,gc,gp);Fence<AscendC::HardEvent::MTE2_S>();
    if constexpr(UseM96){
        M96WaveConsumer segments(groups,shape,AscendC::GetBlockIdx()/2,AscendC::GetBlockNum(),plan.firstMask,local);
        GuardedM96Vector(scale,y,workspace+ringOffset,shape,pipe,segments);
    }else{
        WeightWaveConsumer segments(groups,shape,AscendC::GetBlockIdx()/2,AscendC::GetBlockNum(),plan.firstMask,local);
        WeightWaveVector(scale,y,workspace+ringOffset,shape,pipe,segments);
    }
#endif
}



struct LowCubePackTask {uint32_t expert,row,physical,valid;};
template<uint32_t Rows,uint32_t KHead=0,bool ActiveOnly=false>
class LowCubePackRows {
    Shape s;uint32_t cursor,limit,expert,row,remaining;
    __aicore__ void AdvanceExpert(){
        ++expert;
        if constexpr(KHead || ActiveOnly)
            while(expert<uint32_t(s.experts)&&!((remaining>>expert)&1u))++expert;
    }
public:
    __aicore__ LowCubePackRows(Shape shape,uint32_t worker,uint32_t workers,uint32_t mask,uint32_t active):
        s(shape),remaining(mask){
        const uint32_t span=KHead?KHead:s.residentK;
        const uint32_t total=(KHead || ActiveOnly ? active : uint32_t(s.experts))*span;
        cursor=uint64_t(total)*worker/workers;limit=uint64_t(total)*(worker+1)/workers;
        if constexpr(KHead || ActiveOnly){
            uint32_t ordinal=cursor/span;
            expert=~uint32_t(0);
            do{AdvanceExpert();}while(ordinal--&&expert<uint32_t(s.experts));
        }else expert=cursor/span;
        row=cursor%span;
    }
    __aicore__ bool Next(LowCubePackTask& task){
        if(cursor>=limit)return false;
        const uint32_t span=KHead?KHead:s.residentK;
        uint32_t count=limit-cursor;if(count>span-row)count=span-row;if(count>Rows)count=Rows;
        const uint32_t valid=row>=s.k?0:(s.k-row<count?uint32_t(s.k-row):count);
        task={expert,row,count,valid};cursor+=count;row+=count;
        if(row==span){row=0;AdvanceExpert();}return true;
    }
};
#ifdef __DAV_CUBE__
template<uint32_t Rows,uint32_t MaxN>
__aicore__ inline void IssueLowCubePack(AscendC::GlobalTensor<int8_t> source,
    Shape s,LowCubePackTask task,uint32_t slot,event_t free,event_t ready){
    AscendC::WaitFlag<AscendC::HardEvent::MTE3_MTE2>(free);
    AscendC::LocalTensor<int8_t> local(AscendC::TPosition::A1,slot*Rows*MaxN,Rows*MaxN);
    kernel_common::ZeroNzRows(local,task.valid,task.physical,s.packedPartials);
    if(task.valid){AscendC::Nd2NzParams cp{};cp.ndNum=1;cp.nValue=task.valid;cp.dValue=s.n;
        cp.srcDValue=s.n;cp.dstNzC0Stride=task.physical;cp.dstNzNStride=1;
        AscendC::DataCopy(local,source[(uint64_t(task.expert)*s.k+task.row)*s.n],cp);}
    AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE3>(ready);
}
template<uint32_t Rows,uint32_t MaxN,uint32_t KHead=0,bool ActiveOnly=false>
__aicore__ __attribute__((noinline)) void PrepareLowCubeNzAll(GM_ADDR source,GM_ADDR target,
    Shape s,AscendC::TPipe& pipe,uint32_t mask=0,uint32_t active=0){
    AscendC::SetAtomicNone();
    AscendC::GlobalTensor<int8_t> input,output;input.SetGlobalBuffer((__gm__ int8_t*)source);output.SetGlobalBuffer((__gm__ int8_t*)target);
    event_t free[2],ready[2];
    for(uint32_t i=0;i<2;++i){free[i]=(event_t)pipe.AllocEventID<AscendC::HardEvent::MTE3_MTE2>();
        ready[i]=(event_t)pipe.AllocEventID<AscendC::HardEvent::MTE2_MTE3>();
        AscendC::SetFlag<AscendC::HardEvent::MTE3_MTE2>(free[i]);}
    LowCubePackRows<Rows,KHead,ActiveOnly> tasks(s,AscendC::GetBlockIdx(),AscendC::GetBlockNum(),mask,active);
    LowCubePackTask task,next;uint32_t slot=0;bool live=tasks.Next(task);
    if(live)IssueLowCubePack<Rows,MaxN>(input,s,task,slot,free[slot],ready[slot]);
    while(live){
        const bool haveNext=tasks.Next(next);
        if(haveNext)IssueLowCubePack<Rows,MaxN>(input,s,next,slot^1,free[slot^1],ready[slot^1]);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE3>(ready[slot]);
        AscendC::LocalTensor<int8_t> local(AscendC::TPosition::A1,slot*Rows*MaxN,Rows*MaxN);
        const uint64_t base=uint64_t(task.expert)*s.residentK*s.packedPartials+uint64_t(task.row)*32;
        AscendC::DataCopyParams cp{uint16_t(s.packedPartials/32),uint16_t(task.physical),0,uint16_t(s.residentK-task.physical)};
        AscendC::DataCopy(output[base],local,cp);
        AscendC::SetFlag<AscendC::HardEvent::MTE3_MTE2>(free[slot]);
        live=haveNext;if(live)task=next;slot^=1;
    }
    for(uint32_t i=0;i<2;++i){AscendC::WaitFlag<AscendC::HardEvent::MTE3_MTE2>(free[i]);
        pipe.ReleaseEventID<AscendC::HardEvent::MTE3_MTE2>(free[i]);
        pipe.ReleaseEventID<AscendC::HardEvent::MTE2_MTE3>(ready[i]);}
}
#endif



// Give each two-tile band its own owner, then fill the remaining band slots
// with single tiles. The kernel guard bounds every worker to three M96 tiles.
class ResidentBandConsumer {
    PlannedResidentBands first,second;
    Segment band{};
    uint32_t phase=0,column=0,tile=0,fragment=0,n;
    bool live=false;
public:
    __aicore__ ResidentBandConsumer(Shape s,const ResidentOwnerBands& local,uint32_t mask):
        first(local,mask),second(local,~mask),n(s.n){}

    __aicore__ bool Next(Segment& out) {
        if(!live){
            if(phase==0&&!first.Next(band))++phase;
            if(phase==1&&!second.Next(band))return false;
            live=true;
        }
        const uint32_t offset=tile*96;
        const uint32_t rows=band.rows-offset<96?band.rows-offset:96;
        const uint32_t firstRow=fragment*48;
        const uint32_t count=rows-firstRow<48?rows-firstRow:48;
        out={band.expert,band.row+offset+firstRow,int64_t(column*256),count,
            column<2?256:n-512};
        if(fragment==0&&rows>48){fragment=1;return true;}
        fragment=0;
        if(tile==0&&band.rows>96){tile=1;return true;}
        tile=0;
        if(++column==3){column=0;live=false;}
        return true;
    }
};

#ifdef __DAV_CUBE__
template<uint32_t Columns,uint32_t MadK,uint32_t HeadK>
__aicore__ inline void ResidentBandMatmul(AscendC::GlobalTensor<int32_t> ring,
    Shape s,uint32_t rows,uint32_t bandMp,uint32_t rowOffset,
    AscendC::LocalTensor<int8_t> a1,AscendC::LocalTensor<int8_t> b1,
    AscendC::LocalTensor<int8_t> aAll,AscendC::LocalTensor<int8_t> bAll,
    AscendC::LocalTensor<int32_t> cAll,event_t (&free)[2],event_t (&ready)[2],
    event_t (&cFree)[2],event_t tailReady,uint32_t& sequence,uint32_t& kSequence) {
    const uint32_t mp=(rows+15)/16*16;
    const uint32_t firstM=mp<48?mp:48;
    const uint32_t secondM=mp>48?mp-48:0;
    const uint32_t cs=sequence&1,cs2=cs^1;
    auto c0=cAll[cs*kL0CSlotElements],c1=cAll[cs2*kL0CSlotElements];
    AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(cFree[cs]);
    if(secondM)AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(cFree[cs2]);
    for(uint32_t k0=0;k0<s.k;k0+=MadK,++kSequence){
        const uint32_t count=s.k-k0<MadK?s.k-k0:MadK;
        const uint32_t kp=(count+31)/32*32,ks=kSequence&1;
        auto a2=aAll[ks*96*128],b2=bAll[ks*256*128];
        AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(free[ks]);
        AscendC::LoadData2DParams ap{};
        ap.repeatTimes=kp/32;ap.srcStride=bandMp/16;
        for(uint32_t m=0;m<mp/16;++m)
            AscendC::LoadData(a2[m*kp*16],a1[k0*bandMp+(rowOffset/16+m)*512],ap);
        if(rowOffset==0&&k0==HeadK)AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(tailReady);
        AscendC::LoadData2dTransposeParams bp{};
        bp.repeatTimes=Columns/32;bp.srcStride=s.residentK/32;bp.dstGap=1;
        for(uint32_t k=0;k<kp/32;++k)
            AscendC::LoadDataWithTranspose(b2[k*Columns*32],b1[k0*32+k*1024],bp);
        AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(ready[ks]);
        AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(ready[ks]);
        const bool last=k0+MadK>=s.k;
        AscendC::MmadParams mm{};
        mm.m=firstM;mm.n=Columns;mm.k=kp;mm.cmatrixInitVal=k0==0;
        mm.unitFlag=last?3:2;
        AscendC::Mmad(c0,a2,b2,mm);
        if(last)PublishSelectiveAppendPanel(ring,c0,firstM,Columns,sequence,cFree[cs]);
        if(secondM){
            mm.m=secondM;
            AscendC::Mmad(c1,a2[48*kp],b2,mm);
            if(last)PublishSelectiveAppendPanel(ring,c1,secondM,Columns,sequence,cFree[cs2]);
        }
        AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(free[ks]);
    }
}

template<bool SharedPack>
__aicore__ inline void ResidentBandCube(GM_ADDR xAddress,GM_ADDR workspace,
    Shape s,uint64_t ringOffset,AscendC::TPipe& pipe,
    const ResidentOwnerBands& local,uint32_t firstMask) {
    const uint32_t worker=AscendC::GetBlockIdx();
    AscendC::GlobalTensor<int8_t> x,weight;
    AscendC::GlobalTensor<int32_t> ring;
    x.SetGlobalBuffer((__gm__ int8_t*)xAddress);
    weight.SetGlobalBuffer((__gm__ int8_t*)workspace);
    ring.SetGlobalBuffer((__gm__ int32_t*)(workspace+ringOffset)+worker*18*kTileElements);
    AscendC::SetAtomicNone();
    AscendC::SetMMRowMajor();
    AscendC::SetLoadDataBoundary(uint64_t(0));
    AscendC::SetLoadDataPaddingValue(uint64_t(0));
    AscendC::TBuf<AscendC::TPosition::A1> ab1;
    AscendC::TBuf<AscendC::TPosition::B1> bb1;
    AscendC::TBuf<AscendC::TPosition::A2> ab;
    AscendC::TBuf<AscendC::TPosition::B2> bb;
    AscendC::TBuf<AscendC::TPosition::CO1> cb;
    pipe.InitBuffer(ab1,192*s.residentK);
    pipe.InitBuffer(bb1,288*s.residentK);
    pipe.InitBuffer(ab,2*96*128);
    pipe.InitBuffer(bb,2*256*128);
    pipe.InitBuffer(cb,2*kL0CSlotElements*sizeof(int32_t));
    auto a1=ab1.Get<int8_t>(),b1=bb1.Get<int8_t>();
    auto aAll=ab.Get<int8_t>(),bAll=bb.Get<int8_t>();
    auto cAll=cb.Get<int32_t>();
    event_t free[2],ready[2],cFree[2];
    for(uint32_t i=0;i<2;++i){
        free[i]=(event_t)pipe.AllocEventID<AscendC::HardEvent::M_MTE1>();
        ready[i]=(event_t)pipe.AllocEventID<AscendC::HardEvent::MTE1_M>();
        cFree[i]=(event_t)pipe.AllocEventID<AscendC::HardEvent::FIX_M>();
        AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(free[i]);
        AscendC::SetFlag<AscendC::HardEvent::FIX_M>(cFree[i]);
    }
    const event_t tailReady=(event_t)pipe.AllocEventID<AscendC::HardEvent::MTE2_MTE1>();
    uint32_t sequence=0,kSequence=0;
    bool mixedReady=false;
    for(uint32_t phase=0;phase<2;++phase){
        PlannedResidentBands bands(local,phase?~firstMask:firstMask);
        Segment band;
        bool waveReady=false;
        while(bands.Next(band)){
            LoadNzResidentRowTail(a1,x,s,band,0,s.k);
            if constexpr(SharedPack)if(!mixedReady){
                AscendC::PipeBarrier<PIPE_ALL>();
                AscendC::SyncAll<false>();
                mixedReady=true;
            }
            if(!waveReady){AscendC::CrossCoreWaitFlag<2>(8+phase);waveReady=true;}
            const uint32_t bandMp=(band.rows+15)/16*16;
            for(uint32_t col=0;col<3;++col){
                const uint32_t columns=col<2?256:288;
                const uint64_t base=(uint64_t(band.expert)*s.packedPartials+col*256)*s.residentK;
                const uint16_t headK=col<2?256:192;
                const uint16_t tailK=s.residentK-headK;
                const uint16_t planes=columns/32;
                Fence<AscendC::HardEvent::MTE1_MTE2>();
                const AscendC::DataCopyParams head{planes,headK,tailK,tailK};
                AscendC::DataCopy(b1,weight[base],head);
                Fence<AscendC::HardEvent::MTE2_MTE1>();
                const AscendC::DataCopyParams tail{planes,tailK,headK,headK};
                const uint32_t tailOffset=headK*32;
                AscendC::DataCopy(b1[tailOffset],weight[base+tailOffset],tail);
                AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(tailReady);
                for(uint32_t offset=0;offset<band.rows;offset+=96){
                    const uint32_t rows=band.rows-offset<96?band.rows-offset:96;
                    if(col<2)ResidentBandMatmul<256,128,256>(ring,s,rows,bandMp,offset,a1,b1,
                        aAll,bAll,cAll,free,ready,cFree,tailReady,sequence,kSequence);
                    else ResidentBandMatmul<288,96,192>(ring,s,rows,bandMp,offset,a1,b1,
                        aAll,bAll,cAll,free,ready,cFree,tailReady,sequence,kSequence);
                }
            }
        }
        if constexpr(SharedPack)if(!mixedReady){
            // A worker without a first-wave band still joins the mixed barrier.
            AscendC::PipeBarrier<PIPE_ALL>();
            AscendC::SyncAll<false>();
            mixedReady=true;
        }
        if(!waveReady)AscendC::CrossCoreWaitFlag<2>(8+phase);
    }
    pipe.ReleaseEventID<AscendC::HardEvent::MTE2_MTE1>(tailReady);
    for(uint32_t i=0;i<2;++i){
        AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(free[i]);
        AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(cFree[i]);
        pipe.ReleaseEventID<AscendC::HardEvent::M_MTE1>(free[i]);
        pipe.ReleaseEventID<AscendC::HardEvent::MTE1_M>(ready[i]);
        pipe.ReleaseEventID<AscendC::HardEvent::FIX_M>(cFree[i]);
    }
}
#endif

template<bool ResidentBands,bool SharedPack=false>
__aicore__ __attribute__((noinline, aligned(128))) void ResidentBandEngine(GM_ADDR x,GM_ADDR w,
    GM_ADDR scale,GM_ADDR y,GM_ADDR workspace,Shape shape,
    uint64_t ringOffset,WeightWavePlan plan,const ResidentOwnerBands& local) {
    AscendC::TPipe pipe;
#ifdef __DAV_CUBE__
    if constexpr(SharedPack){
        PrepareLowCubeNzAll<224,800,256>(w,workspace,shape,pipe,plan.firstMask,plan.firstActive);
        // Manual L1 pack is fully drained before ResidentBandCube reuses L1.
        // The first resident A transfer can start ahead of the mixed barrier.
    }
    ResidentBandCube<SharedPack>(x,workspace,shape,ringOffset,pipe,local,plan.firstMask);
#else
    if constexpr(SharedPack){
        PrepareWaveNzWeights<true,256>(w,workspace,shape,pipe,plan.firstMask,plan.firstActive);
        AscendC::PipeBarrier<PIPE_ALL>();
        AscendC::SyncAll<false>();
        AscendC::CrossCoreSetFlag<2,PIPE_MTE3>(8);
        pipe.Reset();
        PrepareWaveNzWeights<false>(w,workspace,shape,pipe,plan.activeMask&~plan.firstMask,plan.active-plan.firstActive);
        AscendC::PipeBarrier<PIPE_ALL>();
        AscendC::SyncAll<true>();
        AscendC::CrossCoreSetFlag<2,PIPE_MTE3>(9);
        pipe.Reset();
    }else for(uint32_t phase=0;phase<2;++phase){
        const uint32_t mask=phase?plan.activeMask&~plan.firstMask:plan.firstMask;
        const uint32_t active=phase?plan.active-plan.firstActive:plan.firstActive;
        PrepareWaveNzWeights<false>(w,workspace,shape,pipe,mask,active);
        AscendC::PipeBarrier<PIPE_ALL>();
        AscendC::SyncAll<true>();
        AscendC::CrossCoreSetFlag<2,PIPE_MTE3>(8+phase);
        pipe.Reset();
    }
    ResidentBandConsumer segments(shape,local,plan.firstMask);
    GuardedM96Vector(scale,y,workspace+ringOffset,shape,pipe,segments);
#endif
}



template<bool LateReady,bool ResidentBands=false,bool SharedPack=false>
__attribute__((aligned(128))) __schedmode__(1) __global__ __mix__(1,2) void WeightWaveKernel(GM_ADDR x,GM_ADDR w,
    GM_ADDR scale,GM_ADDR groups,GM_ADDR y,GM_ADDR workspace,Shape shape,uint64_t ringOffset){
    WeightWavePlan plan;
    const uint32_t workers=AscendC::GetBlockNum();
    if constexpr(ResidentBands&&!LateReady) {
#ifdef __DAV_CUBE__
        const uint32_t worker=AscendC::GetBlockIdx();
#else
        const uint32_t worker=AscendC::GetBlockIdx()/2;
#endif
        ResidentOwnerBands local;
        uint32_t pairs=0,bands=0;
        plan=BuildWeightWaves<true>(groups,shape,pairs,bands,&local,worker,workers);
        if(UseM96WeightWaves(plan,shape,workers)&&pairs<=workers&&bands<=2*workers) {
            ResidentBandEngine<ResidentBands,SharedPack>(x,w,scale,y,workspace,shape,ringOffset,plan,local);
            return;
        }
    } else {
        uint32_t pairs=0,bands=0;
        plan=BuildWeightWaves<ResidentBands>(groups,shape,pairs,bands);
    }
    if(UseM96WeightWaves(plan,shape,workers))
        WeightWaveEngine<true,LateReady>(x,w,scale,groups,y,workspace,shape,ringOffset,plan);
    else WeightWaveEngine<false,LateReady>(x,w,scale,groups,y,workspace,shape,ringOffset,plan);
}




struct LowM96Plan { WeightWavePlan wave; uint32_t tiles96=0; };
__aicore__ inline LowM96Plan BuildLowM96Waves(GM_ADDR address,Shape s) {
    AscendC::GlobalTensor<int64_t> groups;groups.SetGlobalBuffer((__gm__ int64_t*)address);
    int64_t rows[32],previous=0;LowM96Plan low;auto& plan=low.wave;
    for(uint32_t e=0;e<uint32_t(s.experts);++e){int64_t end=groups.GetValue(e);rows[e]=end-previous;previous=end;if(rows[e]){++plan.active;plan.tiles128+=(uint32_t(rows[e])+127)/128;low.tiles96+=(uint32_t(rows[e])+95)/96;plan.activeMask|=uint32_t(1)<<e;}}
    for(uint32_t e=0;e<uint32_t(s.experts);++e)if(rows[e]*plan.active>=s.m){plan.firstMask|=uint32_t(1)<<e;++plan.firstActive;}
    return low;
}
template<bool Fragment,bool Local>
class FlatM96Segments {
    Shape s;AscendC::GlobalTensor<int64_t> groups;AscendC::LocalTensor<int64_t> cached;
    uint32_t task,limit,expert=0,base=0,end=0,fragment=0,mask;bool second;
    int64_t beginRow=0,endRow=0;
    __aicore__ int64_t GroupEnd(uint32_t e){if constexpr(Local)return cached.GetValue(e);else return groups.GetValue(e);}
public:
    __aicore__ FlatM96Segments(GM_ADDR address,Shape shape,uint32_t worker,uint32_t workers,
        uint32_t firstMask,bool secondWave,uint32_t tiles96,AscendC::LocalTensor<int64_t> local={}):
        s(shape),cached(local),task(tiles96*3*worker/workers),limit(tiles96*3*(worker+1)/workers),mask(firstMask),second(secondWave){
        groups.SetGlobalBuffer((__gm__ int64_t*)address);endRow=GroupEnd(0);end=(endRow+95)/96;
    }
    __aicore__ bool Next(Segment& out){
        while(task<limit){
            const uint32_t ordinal=task/3;
            while(ordinal>=end){if(++expert>=uint32_t(s.experts))return false;beginRow=endRow;endRow=GroupEnd(expert);base=end;end+=(endRow-beginRow+95)/96;}
            if(bool((mask>>expert)&1u)==second){++task;continue;}
            const int64_t row=beginRow+int64_t(ordinal-base)*96;
            const uint32_t rows=endRow-row<96?uint32_t(endRow-row):96,column=task%3;
            const uint32_t col=column*256,cols=column<2?256:uint32_t(s.n-512);
            if constexpr(Fragment){const uint32_t first=fragment*48,nrows=rows-first<48?rows-first:48;
                out={int64_t(expert),row+first,int64_t(col),nrows,cols};
                if(!fragment&&rows>48)fragment=1;else{fragment=0;++task;}
            }else{out={int64_t(expert),row,int64_t(col),rows,cols};++task;}
            return true;
        }
        return false;
    }
};


#ifdef __DAV_CUBE__
__aicore__ inline void FlatM96Cube(GM_ADDR xAddress, GM_ADDR weightAddress,
    GM_ADDR groupsAddress, GM_ADDR workspace, Shape s, AscendC::TPipe& pipe, uint32_t firstMask,uint32_t tiles96)
{
    constexpr uint32_t Columns = 256, PacketK = 256, MadK = 128;
    const uint32_t worker = AscendC::GetBlockIdx();
    AscendC::GlobalTensor<int8_t> x, weight;
    AscendC::GlobalTensor<int32_t> ring;
    x.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(xAddress));
    weight.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(weightAddress));
    ring.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(workspace) + worker * 18 * kTileElements);
    AscendC::SetAtomicNone();
    AscendC::SetMMRowMajor();
    AscendC::SetLoadDataBoundary(uint64_t(0));
    AscendC::SetLoadDataPaddingValue(uint64_t(0));
    AscendC::TBuf<AscendC::TPosition::A1> resident;
    AscendC::TQue<AscendC::TPosition::B1, 2> bq;
    AscendC::TBuf<AscendC::TPosition::A2> ab;
    AscendC::TBuf<AscendC::TPosition::B2> bb;
    AscendC::TBuf<AscendC::TPosition::CO1> cb;
    pipe.InitBuffer(resident, 96 * s.residentK);
    pipe.InitBuffer(bq, 2, PacketK * Columns);
    pipe.InitBuffer(ab, 2 * 96 * MadK);
    pipe.InitBuffer(bb, 2 * Columns * MadK);
    pipe.InitBuffer(cb, 2 * kL0CSlotElements * sizeof(int32_t));
    auto a1 = resident.Get<int8_t>();
    auto aAll = ab.Get<int8_t>();
    auto bAll = bb.Get<int8_t>();
    auto cAll = cb.Get<int32_t>();
    event_t free[2], ready[2], cFree[2];
    for (uint32_t i = 0; i < 2; ++i) {
        free[i] = static_cast<event_t>(pipe.AllocEventID<AscendC::HardEvent::M_MTE1>());
        ready[i] = static_cast<event_t>(pipe.AllocEventID<AscendC::HardEvent::MTE1_M>());
        cFree[i] = static_cast<event_t>(pipe.AllocEventID<AscendC::HardEvent::FIX_M>());
        AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(free[i]);
        AscendC::SetFlag<AscendC::HardEvent::FIX_M>(cFree[i]);
    }
    Segment block;
    uint32_t sequence = 0, kSequence = 0;
    int64_t loadedRow = -1;
    for(uint32_t phase=0;phase<1;++phase) {
        bool waveReady=false;
        FlatM96Segments<false,false> blocks(groupsAddress,s,worker,AscendC::GetBlockNum(),firstMask,phase==1,tiles96);
        while(blocks.Next(block)) {
        if (loadedRow != block.row) {
            LoadNzResidentRowTail(a1, x, s, block, 0, s.k);
            loadedRow = block.row;
        }
        if(!waveReady){AscendC::CrossCoreWaitFlag<2>(8+phase);waveReady=true;}
        if(block.column<512)M96WaveBlock<256,256,128>(bq,weight,ring,s,block,a1,aAll,bAll,cAll,free,ready,cFree,sequence,kSequence);
        else M96WaveBlock<288,192,96>(bq,weight,ring,s,block,a1,aAll,bAll,cAll,free,ready,cFree,sequence,kSequence);
    }
    if(!waveReady)AscendC::CrossCoreWaitFlag<2>(8+phase);
    } // both phases
    for (uint32_t i = 0; i < 2; ++i) {
        AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(free[i]);
        AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(cFree[i]);
        pipe.ReleaseEventID<AscendC::HardEvent::M_MTE1>(free[i]);
        pipe.ReleaseEventID<AscendC::HardEvent::MTE1_M>(ready[i]);
        pipe.ReleaseEventID<AscendC::HardEvent::FIX_M>(cFree[i]);
    }
}
#endif

template<bool LateReady>
__aicore__ __attribute__((noinline)) void FlatM96Engine(GM_ADDR x,GM_ADDR w,
    GM_ADDR scale,GM_ADDR groups,GM_ADDR y,GM_ADDR workspace,Shape shape,uint64_t ringOffset,WeightWavePlan plan,uint32_t tiles96) {
    AscendC::TPipe pipe;
#ifdef __DAV_CUBE__
    if(plan.active>1){
        FlatM96Cube(x,workspace,groups,workspace+ringOffset,shape,pipe,plan.firstMask,tiles96);
    }
    else NzAZeroEarlyCube<true,true,true>(x,workspace,groups,workspace+ringOffset,shape,pipe);
#else
    if(plan.active<=1){
        PrepareBalancedNzWeightsFullRows(w,workspace,groups,shape,pipe);
        AscendC::PipeBarrier<PIPE_ALL>();AscendC::SyncAll<false>();pipe.Reset();
        NativeCVectorRun<10>(scale,groups,y,workspace+ringOffset,shape,pipe);return;
    }
    PrepareWaveNzWeights<false>(w,workspace,shape,pipe,plan.activeMask,plan.active);
    AscendC::PipeBarrier<PIPE_ALL>();AscendC::SyncAll<true>();
    AscendC::CrossCoreSetFlag<2,PIPE_MTE3>(8);pipe.Reset();
    AscendC::TBuf<AscendC::TPosition::VECCALC> metadata;
    pipe.InitBuffer(metadata,(shape.experts+3)/4*32);
    auto local=metadata.Get<int64_t>();AscendC::GlobalTensor<int64_t> groupGm;
    groupGm.SetGlobalBuffer((__gm__ int64_t*)groups);
    AscendC::DataCopyExtParams gc{1,uint32_t(shape.experts*8),0,0,0};
    AscendC::DataCopyPadExtParams<int64_t> gp{false,0,0,0};
    AscendC::DataCopyPad(local,groupGm,gc,gp);Fence<AscendC::HardEvent::MTE2_S>();
    FlatM96Segments<true,true> segments(groups,shape,AscendC::GetBlockIdx()/2,AscendC::GetBlockNum(),plan.activeMask,false,tiles96,local);
    GuardedM96Vector(scale,y,workspace+ringOffset,shape,pipe,segments);
#endif
}

template<bool LateReady>
__schedmode__(1) __global__ __mix__(1,2) void LowM96Kernel(GM_ADDR x,GM_ADDR w,
    GM_ADDR scale,GM_ADDR groups,GM_ADDR y,GM_ADDR workspace,Shape shape,uint64_t ringOffset){
    auto plan=BuildLowM96Waves(groups,shape);
    if(UseM96WeightWaves(plan.wave,shape,AscendC::GetBlockNum())) {
        plan.wave.firstMask=plan.wave.activeMask;plan.wave.firstActive=plan.wave.active;
        FlatM96Engine<LateReady>(x,w,scale,groups,y,workspace,shape,ringOffset,plan.wave,plan.tiles96);
    } else WeightWaveEngine<false,LateReady>(x,w,scale,groups,y,workspace,shape,ringOffset,plan.wave);
}










// Give each two-tile band its own owner, then fill the remaining band slots
// with single tiles. The kernel guard bounds every worker to three M96 tiles.
template<bool Local>
class LowResidentBandIterator {
    Shape shape;AscendC::GlobalTensor<int64_t> groups;AscendC::LocalTensor<int64_t> cached;
    uint32_t worker,workers,pairCount,singleCount,mask,pairTask,smallLow=0,singleTask;
    uint32_t expert=0,ordinalBase=0,begin=0,end=0;
    bool pairPhase=true;
    __aicore__ uint32_t End(uint32_t e){if constexpr(Local)return uint32_t(cached.GetValue(e));else return uint32_t(groups.GetValue(e));}
    __aicore__ bool Find(uint32_t ordinal,uint32_t column,Segment& out){
        while(expert<uint32_t(shape.experts)){
            const uint32_t tiles=(end-begin+95)/96;
            const uint32_t count=pairPhase?tiles/2:tiles%2;
            if(ordinal<ordinalBase+count){
                const uint32_t first=begin+192*(pairPhase?ordinal-ordinalBase:tiles/2);
                const uint32_t rows=end-first<192?end-first:192;
                out={int64_t(expert),int64_t(first),int64_t(column*256),rows,column<2?256u:uint32_t(shape.n-512)};
                return true;
            }
            ordinalBase+=count;begin=end;
            if(++expert<uint32_t(shape.experts))end=End(expert);
        }
        return false;
    }
public:
    __aicore__ LowResidentBandIterator(GM_ADDR address,Shape s,uint32_t owner,
        uint32_t owners,uint32_t pairs,uint32_t singles,uint32_t experts,AscendC::LocalTensor<int64_t> metadata={}):
        shape(s),cached(metadata),worker(owner),workers(owners),pairCount(pairs),singleCount(singles),mask(experts),pairTask(owner){
        groups.SetGlobalBuffer((__gm__ int64_t*)address);end=End(0);
        singleTask=2*(workers-(3*pairCount)%workers)+worker;
    }
    __aicore__ bool Next(Segment& out){
        while(true){
            if(pairPhase){
                if(pairTask<3*pairCount){const uint32_t task=pairTask;pairTask+=workers;
                    if(Find(task/3,task%3,out)&&((mask>>out.expert)&1u))return true;
                    continue;
                }
                pairPhase=false;expert=0;ordinalBase=0;begin=0;end=End(0);
            }
            const uint32_t r=(3*pairCount)%workers,low=workers-r;
            uint32_t task;
            if(worker>=r&&smallLow<2){task=worker-r+(smallLow++)*low;if(task>=3*singleCount)continue;}
            else{task=singleTask;singleTask+=workers;if(task>=3*singleCount)return false;}
            if(Find(task/3,task%3,out)&&((mask>>out.expert)&1u))return true;
        }
    }
};

class LowResidentBandConsumer {
    LowResidentBandIterator<true> bands;
    Segment band{};
    uint32_t tile=0,fragment=0;
    bool live=false;
public:
    __aicore__ LowResidentBandConsumer(GM_ADDR groups,Shape s,uint32_t worker,
        uint32_t workers,uint32_t pairs,uint32_t singles,uint32_t mask,AscendC::LocalTensor<int64_t> metadata):
        bands(groups,s,worker,workers,pairs,singles,mask,metadata){}

    __aicore__ bool Next(Segment& out) {
        if(!live){
            if(!bands.Next(band))return false;
            live=true;
        }
        const uint32_t offset=tile*96;
        const uint32_t rows=band.rows-offset<96?band.rows-offset:96;
        const uint32_t firstRow=fragment*48;
        const uint32_t count=rows-firstRow<48?rows-firstRow:48;
        out={band.expert,band.row+offset+firstRow,band.column,count,band.columns};
        if(fragment==0&&rows>48){fragment=1;return true;}
        fragment=0;
        if(tile==0&&band.rows>96){tile=1;return true;}
        tile=0;
        live=false;
        return true;
    }
};

#ifdef __DAV_CUBE__
template<uint32_t Columns,uint32_t MadK,uint32_t HeadK>
__aicore__ inline void LowResidentBandMatmul(AscendC::GlobalTensor<int32_t> ring,
    Shape s,uint32_t rows,uint32_t bandMp,uint32_t rowOffset,
    AscendC::LocalTensor<int8_t> a1,AscendC::LocalTensor<int8_t> b1,
    AscendC::LocalTensor<int8_t> aAll,AscendC::LocalTensor<int8_t> bAll,
    AscendC::LocalTensor<int32_t> cAll,event_t (&free)[2],event_t (&ready)[2],
    event_t (&cFree)[2],event_t tailReady,uint32_t& sequence,uint32_t& kSequence) {
    const uint32_t mp=(rows+15)/16*16;
    const uint32_t firstM=mp<48?mp:48;
    const uint32_t secondM=mp>48?mp-48:0;
    const uint32_t cs=sequence&1,cs2=cs^1;
    auto c0=cAll[cs*kL0CSlotElements],c1=cAll[cs2*kL0CSlotElements];
    AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(cFree[cs]);
    if(secondM)AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(cFree[cs2]);
    for(uint32_t k0=0;k0<s.k;k0+=MadK,++kSequence){
        const uint32_t count=s.k-k0<MadK?s.k-k0:MadK;
        const uint32_t kp=(count+31)/32*32,ks=kSequence&1;
        auto a2=aAll[ks*96*128],b2=bAll[ks*256*128];
        AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(free[ks]);
        AscendC::LoadData2DParams ap{};
        ap.repeatTimes=kp/32;ap.srcStride=bandMp/16;
        for(uint32_t m=0;m<mp/16;++m)
            AscendC::LoadData(a2[m*kp*16],a1[k0*bandMp+(rowOffset/16+m)*512],ap);
        if(rowOffset==0&&k0==HeadK)AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(tailReady);
        AscendC::LoadData2dTransposeParams bp{};
        bp.repeatTimes=Columns/32;bp.srcStride=s.residentK/32;bp.dstGap=1;
        for(uint32_t k=0;k<kp/32;++k)
            AscendC::LoadDataWithTranspose(b2[k*Columns*32],b1[k0*32+k*1024],bp);
        AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(ready[ks]);
        AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(ready[ks]);
        const bool last=k0+MadK>=s.k;
        AscendC::MmadParams mm{};
        mm.m=firstM;mm.n=Columns;mm.k=kp;mm.cmatrixInitVal=k0==0;
        mm.unitFlag=last?3:2;
        AscendC::Mmad(c0,a2,b2,mm);
        if(last)PublishSelectiveAppendPanel(ring,c0,firstM,Columns,sequence,cFree[cs]);
        if(secondM){
            mm.m=secondM;
            AscendC::Mmad(c1,a2[48*kp],b2,mm);
            if(last)PublishSelectiveAppendPanel(ring,c1,secondM,Columns,sequence,cFree[cs2]);
        }
        AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(free[ks]);
    }
}

__aicore__ inline void LowResidentBandCube(GM_ADDR xAddress,GM_ADDR groups,GM_ADDR workspace,
    Shape s,uint64_t ringOffset,AscendC::TPipe& pipe,uint32_t pairs,uint32_t singles,uint32_t firstMask) {
    const uint32_t worker=AscendC::GetBlockIdx(),workers=AscendC::GetBlockNum();
    AscendC::GlobalTensor<int8_t> x,weight;
    AscendC::GlobalTensor<int32_t> ring;
    const uint64_t aOffset=ringOffset+uint64_t(workers)*24*kTileElements*4;
    x.SetGlobalBuffer((__gm__ int8_t*)(workspace+aOffset));
    weight.SetGlobalBuffer((__gm__ int8_t*)workspace);
    ring.SetGlobalBuffer((__gm__ int32_t*)(workspace+ringOffset)+worker*18*kTileElements);
    AscendC::SetAtomicNone();
    AscendC::SetMMRowMajor();
    AscendC::SetLoadDataBoundary(uint64_t(0));
    AscendC::SetLoadDataPaddingValue(uint64_t(0));
    AscendC::TBuf<AscendC::TPosition::A1> ab1;
    AscendC::TBuf<AscendC::TPosition::B1> bb1;
    AscendC::TBuf<AscendC::TPosition::A2> ab;
    AscendC::TBuf<AscendC::TPosition::B2> bb;
    AscendC::TBuf<AscendC::TPosition::CO1> cb;
    pipe.InitBuffer(ab1,192*s.residentK);
    pipe.InitBuffer(bb1,288*s.residentK);
    pipe.InitBuffer(ab,2*96*128);
    pipe.InitBuffer(bb,2*256*128);
    pipe.InitBuffer(cb,2*kL0CSlotElements*sizeof(int32_t));
    auto a1=ab1.Get<int8_t>(),b1=bb1.Get<int8_t>();
    auto aAll=ab.Get<int8_t>(),bAll=bb.Get<int8_t>();
    auto cAll=cb.Get<int32_t>();
    event_t free[2],ready[2],cFree[2];
    for(uint32_t i=0;i<2;++i){
        free[i]=(event_t)pipe.AllocEventID<AscendC::HardEvent::M_MTE1>();
        ready[i]=(event_t)pipe.AllocEventID<AscendC::HardEvent::MTE1_M>();
        cFree[i]=(event_t)pipe.AllocEventID<AscendC::HardEvent::FIX_M>();
        AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(free[i]);
        AscendC::SetFlag<AscendC::HardEvent::FIX_M>(cFree[i]);
    }
    const event_t tailReady=(event_t)pipe.AllocEventID<AscendC::HardEvent::MTE2_MTE1>();
    AscendC::CrossCoreWaitFlag<2>(9);
    uint32_t sequence=0,kSequence=0;
    for(uint32_t phase=0;phase<1;++phase){
        LowResidentBandIterator<false> bands(groups,s,worker,workers,pairs,singles,phase?~firstMask:firstMask);
        Segment band;
        bool waveReady=false;
        while(bands.Next(band)){
            const uint32_t localMp=(band.rows+15)/16*16,globalMp=(uint32_t(s.m)+31)/32*32;
            Fence<AscendC::HardEvent::MTE1_MTE2>();
            kernel_common::ZeroNzRows(a1,band.rows,localMp,s.residentK);
            AscendC::DataCopyParams aCopy{uint16_t(s.residentK/32),uint16_t(band.rows),
                uint16_t(globalMp-band.rows),uint16_t(localMp-band.rows)};
            AscendC::DataCopy(a1,x[uint64_t(band.row)*32],aCopy);
            Fence<AscendC::HardEvent::MTE2_MTE1>();
            if(!waveReady){AscendC::CrossCoreWaitFlag<2>(8+phase);waveReady=true;}
            const uint32_t bandMp=(band.rows+15)/16*16;
            {const uint32_t col=uint32_t(band.column)/256;
                const uint32_t columns=col<2?256:288;
                const uint64_t base=(uint64_t(band.expert)*s.packedPartials+col*256)*s.residentK;
                const uint16_t headK=col<2?256:192;
                const uint16_t tailK=s.residentK-headK;
                const uint16_t planes=columns/32;
                Fence<AscendC::HardEvent::MTE1_MTE2>();
                const AscendC::DataCopyParams head{planes,headK,tailK,tailK};
                AscendC::DataCopy(b1,weight[base],head);
                Fence<AscendC::HardEvent::MTE2_MTE1>();
                const AscendC::DataCopyParams tail{planes,tailK,headK,headK};
                const uint32_t tailOffset=headK*32;
                AscendC::DataCopy(b1[tailOffset],weight[base+tailOffset],tail);
                AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(tailReady);
                for(uint32_t offset=0;offset<band.rows;offset+=96){
                    const uint32_t rows=band.rows-offset<96?band.rows-offset:96;
                    if(col<2)LowResidentBandMatmul<256,128,256>(ring,s,rows,bandMp,offset,a1,b1,
                        aAll,bAll,cAll,free,ready,cFree,tailReady,sequence,kSequence);
                    else LowResidentBandMatmul<288,96,192>(ring,s,rows,bandMp,offset,a1,b1,
                        aAll,bAll,cAll,free,ready,cFree,tailReady,sequence,kSequence);
                }
            }
        }
        if(!waveReady)AscendC::CrossCoreWaitFlag<2>(8+phase);
    }
    pipe.ReleaseEventID<AscendC::HardEvent::MTE2_MTE1>(tailReady);
    for(uint32_t i=0;i<2;++i){
        AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(free[i]);
        AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(cFree[i]);
        pipe.ReleaseEventID<AscendC::HardEvent::M_MTE1>(free[i]);
        pipe.ReleaseEventID<AscendC::HardEvent::MTE1_M>(ready[i]);
        pipe.ReleaseEventID<AscendC::HardEvent::FIX_M>(cFree[i]);
    }
}
#endif

#ifndef __DAV_CUBE__
template<bool Tagged>
__aicore__ __attribute__((noinline)) void PrepareLowAOnePass(GM_ADDR source,GM_ADDR target,
    Shape s,AscendC::TPipe& pipe){
    const uint32_t workers=AscendC::GetBlockNum()*2,worker=AscendC::GetBlockIdx();
    const uint32_t mp=(uint32_t(s.m)+31)/32*32,np=s.residentK;
    const uint32_t first=uint64_t(mp)*worker/workers,end=uint64_t(mp)*(worker+1)/workers;
    const uint32_t physical=end-first,rows=first>=s.m?0:(s.m-first<physical?uint32_t(s.m-first):physical);
    const uint32_t maxRows=(mp+workers-1)/workers;
    AscendC::TBuf<AscendC::TPosition::VECCALC> ib,ob;
    pipe.InitBuffer(ib,maxRows*np);pipe.InitBuffer(ob,maxRows*np);
    auto input=ib.Get<int8_t>(),output=ob.Get<int8_t>();
    AscendC::GlobalTensor<int8_t> x,packed;x.SetGlobalBuffer((__gm__ int8_t*)source);packed.SetGlobalBuffer((__gm__ int8_t*)target);
    if(rows!=physical){AscendC::Duplicate(input.ReinterpretCast<int16_t>(),int16_t(0),physical*np/2);Fence<AscendC::HardEvent::V_MTE2>();}
    if(rows){AscendC::DataCopyExtParams cp{uint16_t(rows),uint32_t(s.k),0,0,0};
        AscendC::DataCopyPad(input,x[uint64_t(first)*s.k],cp,{true,0,uint8_t(np-s.k),int8_t(0)});}
    Fence<AscendC::HardEvent::MTE2_V>();
    for(uint32_t plane=0;plane<np/32;plane+=8){
        const uint32_t planes=np/32-plane<8?np/32-plane:8,lanes=planes*16;
        asc_set_mask_norm();asc_set_vector_mask(lanes>64?(lanes==128?~uint64_t(0):(uint64_t(1)<<(lanes-64))-1):0,lanes>=64?~uint64_t(0):(uint64_t(1)<<lanes)-1);
        asc_copy(Ub(output.ReinterpretCast<uint16_t>()[plane*physical*16]),Ub(input.ReinterpretCast<uint16_t>()[plane*16]),uint8_t(physical),uint16_t(physical),1,1,uint16_t(np/32));
    }
    asc_set_vector_mask(~uint64_t(0),~uint64_t(0));Fence<AscendC::HardEvent::V_MTE3>();
    AscendC::DataCopyParams cp{uint16_t(np/32),uint16_t(physical),0,uint16_t(mp-physical)};
    AscendC::DataCopy(packed[uint64_t(first)*32],output,cp);
    // Caller drains all pipes before the global ready publication and Reset.
}
#endif

template<bool LowResidentBands>
__aicore__ __attribute__((noinline)) void LowResidentBandEngine(GM_ADDR x,GM_ADDR w,
    GM_ADDR scale,GM_ADDR groups,GM_ADDR y,GM_ADDR workspace,Shape shape,
    uint64_t ringOffset,WeightWavePlan plan,uint32_t pairs,uint32_t singles) {
    AscendC::TPipe pipe;
#ifdef __DAV_CUBE__
    if (plan.active < uint32_t(shape.experts))
        PrepareLowCubeNzAll<224,1056,0,true>(w,workspace,shape,pipe,plan.activeMask,plan.active);
    else PrepareLowCubeNzAll<224,1056>(w,workspace,shape,pipe);
    // Manual L1 pack releases its own events. Preserve TPipe's reserved M_MTE1 IDs.
    AscendC::PipeBarrier<PIPE_ALL>();AscendC::SyncAll<false>();
    LowResidentBandCube(x,groups,workspace,shape,ringOffset,pipe,pairs,singles,plan.firstMask);
#else
    const uint64_t aOffset=ringOffset+uint64_t(AscendC::GetBlockNum())*24*kTileElements*4;
    PrepareLowAOnePass<true>(x,workspace+aOffset,shape,pipe);
    AscendC::PipeBarrier<PIPE_ALL>();AscendC::SyncAll<false>();
    AscendC::CrossCoreSetFlag<2,PIPE_MTE3>(9);
    AscendC::CrossCoreSetFlag<2,PIPE_MTE3>(8);pipe.Reset();
    AscendC::TBuf<AscendC::TPosition::VECCALC> metadata;
    pipe.InitBuffer(metadata,(shape.experts+3)/4*32);
    auto local=metadata.Get<int64_t>();
    AscendC::GlobalTensor<int64_t> groupGm;
    groupGm.SetGlobalBuffer((__gm__ int64_t*)groups);
    AscendC::DataCopyExtParams copy{1,uint32_t(shape.experts*8),0,0,0};
    AscendC::DataCopyPadExtParams<int64_t> pad{false,0,0,0};
    AscendC::DataCopyPad(local,groupGm,copy,pad);
    Fence<AscendC::HardEvent::MTE2_S>();
    LowResidentBandConsumer segments(groups,shape,AscendC::GetBlockIdx()/2,
        AscendC::GetBlockNum(),pairs,singles,plan.firstMask,local);
    GuardedM96Vector(scale,y,workspace+ringOffset,shape,pipe,segments);
#endif
}

template<bool Tagged>
__schedmode__(1) __global__ __mix__(1,2) void LowResidentM96Kernel(GM_ADDR x,GM_ADDR w,
    GM_ADDR scale,GM_ADDR groups,GM_ADDR y,GM_ADDR workspace,Shape shape,uint64_t ringOffset){
    auto low=BuildLowM96Waves(groups,shape);auto plan=low.wave;
    const uint32_t workers = AscendC::GetBlockNum();
    const uint32_t maxTiles96 = (uint32_t(shape.m) - 1) / 96 + plan.active;
    const bool sparse = plan.active > 1 && plan.active < uint32_t(shape.experts) &&
        (maxTiles96 + workers - 1) / workers <= (plan.tiles128 + workers - 1) / workers;
    if (UseM96WeightWaves(plan,shape,workers) || sparse) {
        AscendC::GlobalTensor<int64_t> gm;gm.SetGlobalBuffer((__gm__ int64_t*)groups);
        int64_t previous=0;uint32_t pairs=0,bands=0;
        for(uint32_t e=0;e<uint32_t(shape.experts);++e){const int64_t end=gm.GetValue(e);
            const uint32_t tiles=(uint32_t(end-previous)+95)/96;previous=end;
            pairs+=tiles/2;bands+=(tiles+1)/2;
        }
        const auto originalWave = plan;
        plan.firstMask=plan.activeMask;plan.firstActive=plan.active;
        if (3*pairs <= 2*workers && 3*(pairs+bands) <= 5*workers)
            LowResidentBandEngine<true>(x,w,scale,groups,y,workspace,shape,ringOffset,plan,pairs,bands-pairs);
        else if (sparse)
            WeightWaveEngine<false,false>(x,w,scale,groups,y,workspace,shape,ringOffset,originalWave);
        else FlatM96Engine<false>(x,w,scale,groups,y,workspace,shape,ringOffset,plan,low.tiles96);
    }else WeightWaveEngine<false,false>(x,w,scale,groups,y,workspace,shape,ringOffset,plan);
}




#ifdef __DAV_CUBE__
template <bool Persistent, bool PackedWeights = false, bool NativeC = false>
__aicore__ inline void ErsNativeEarlyCube(GM_ADDR xAddress, GM_ADDR weightAddress,
    GM_ADDR groupsAddress, GM_ADDR workspace, Shape s, AscendC::TPipe& pipe)
{
    constexpr uint32_t Columns = 256, PacketK = 256, MadK = 128;
    const uint32_t worker = AscendC::GetBlockIdx();
    AscendC::GlobalTensor<int8_t> x, weight;
    AscendC::GlobalTensor<int32_t> ring;
    x.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(xAddress));
    weight.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(weightAddress));
    ring.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(workspace) + worker * kSlots * kTileElements);
    AscendC::SetAtomicNone();
    AscendC::SetMMRowMajor();
    AscendC::SetLoadDataBoundary(uint64_t(0));
    AscendC::SetLoadDataPaddingValue(uint64_t(0));
    AscendC::TBuf<AscendC::TPosition::A1> resident;
    AscendC::TQue<AscendC::TPosition::B1, 2> bq;
    AscendC::TBuf<AscendC::TPosition::A2> ab;
    AscendC::TBuf<AscendC::TPosition::B2> bb;
    AscendC::TBuf<AscendC::TPosition::CO1> cb;
    pipe.InitBuffer(resident, 128 * s.residentK);
    pipe.InitBuffer(bq, 2, PacketK * Columns);
    pipe.InitBuffer(ab, 2 * 128 * MadK);
    pipe.InitBuffer(bb, 2 * Columns * MadK);
    pipe.InitBuffer(cb, 2 * kL0CSlotElements * sizeof(int32_t));
    auto a1 = resident.Get<int8_t>();
    auto aAll = ab.Get<int8_t>();
    auto bAll = bb.Get<int8_t>();
    auto cAll = cb.Get<int32_t>();
    event_t free[2], ready[2], cFree[2];
    for (uint32_t i = 0; i < 2; ++i) {
        free[i] = static_cast<event_t>(pipe.AllocEventID<AscendC::HardEvent::M_MTE1>());
        ready[i] = static_cast<event_t>(pipe.AllocEventID<AscendC::HardEvent::MTE1_M>());
        cFree[i] = static_cast<event_t>(pipe.AllocEventID<AscendC::HardEvent::FIX_M>());
        AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(free[i]);
        AscendC::SetFlag<AscendC::HardEvent::FIX_M>(cFree[i]);
    }
    Segments<Persistent ? 2 : 1, Columns> blocks(groupsAddress, s, worker, AscendC::GetBlockNum());
    Segment block;
    uint32_t sequence = 0, kSequence = 0;
    int64_t loadedRow = -1;
    bool packedReady=false;
    while (blocks.Next(block)) {
        if (loadedRow != block.row) {
            LoadResidentRange(a1, x, s, block, 0, s.k);
            loadedRow = block.row;
        }
        if(!packedReady){AscendC::PipeBarrier<PIPE_ALL>();AscendC::SyncAll<false>();packedReady=true;}
        const uint32_t mp = (block.rows + 15) / 16 * 16;
        const uint32_t np = (block.columns + 31) / 32 * 32;
        const uint32_t firstM = mp < 64 ? mp : 64;
        const uint32_t secondM = mp > 64 ? mp - 64 : 0;
        const uint32_t cs = sequence & 1, cs2 = (sequence + 1) & 1;
        auto c0 = cAll[cs * kL0CSlotElements];
        auto c1 = cAll[cs2 * kL0CSlotElements];
        AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(cFree[cs]);
        if (secondM) AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(cFree[cs2]);
        CopyNzBPacket<PacketK, 0, PackedWeights>(bq, weight, s, block, 0, s.k);
        if (PacketK < s.k) CopyNzBPacket<PacketK, 0, PackedWeights>(bq, weight, s, block, PacketK, s.k);
        for (uint32_t packet = 0; packet < s.k; packet += PacketK) {
            const uint32_t end = s.k - packet < PacketK ? s.k : packet + PacketK;
            const uint32_t packetKp = (end - packet + 31) / 32 * 32;
            auto b1 = bq.DeQue<int8_t>();
            for (uint32_t k0 = packet; k0 < end; k0 += MadK, ++kSequence) {
                const uint32_t count = end - k0 < MadK ? end - k0 : MadK;
                const uint32_t kp = (count + 31) / 32 * 32;
                const uint32_t ks = kSequence & 1;
                auto a2 = aAll[ks * 128 * MadK];
                auto b2 = bAll[ks * Columns * MadK];
                AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(free[ks]);
                AscendC::LoadData2DParams ap{};
                ap.repeatTimes = kp / 32; ap.srcStride = mp / 16;
                for (uint32_t m = 0; m < mp / 16; ++m)
                    AscendC::LoadData(a2[m * kp * 16], a1[k0 * mp + m * 512], ap);
                AscendC::LoadData2dTransposeParams bp{};
                bp.repeatTimes = np / 32; bp.srcStride = packetKp / 32; bp.dstGap = 1;
                for (uint32_t k = 0; k < kp / 32; ++k)
                    AscendC::LoadDataWithTranspose(b2[k * np * 32], b1[(k0 - packet) * 32 + k * 1024], bp);
                if (k0 + MadK >= end) {
                    bq.FreeTensor(b1);
                    if (packet + 2 * PacketK < s.k)
                        CopyNzBPacket<PacketK, 0, PackedWeights>(bq, weight, s, block, packet + 2 * PacketK, s.k);
                }
                AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(ready[ks]);
                AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(ready[ks]);
                AscendC::MmadParams mm{};
                mm.m = firstM; mm.n = np; mm.k = kp; mm.cmatrixInitVal = k0 == 0;
                const bool last = k0 + MadK >= s.k;
                mm.unitFlag = last ? 3 : 2;
                AscendC::Mmad(c0, a2, b2, mm);
                if ((mm.m / 16) * (mm.n / 16) < 10) AscendC::PipeBarrier<PIPE_M>();
                if (last) PublishCLayout<NativeC,Columns>(ring, c0, firstM, np, sequence, cFree[cs]);
                if (secondM) {
                    mm.m = secondM;
                    AscendC::Mmad(c1, a2[64 * kp], b2, mm);
                    if ((mm.m / 16) * (mm.n / 16) < 10) AscendC::PipeBarrier<PIPE_M>();
                    if (last) PublishCLayout<NativeC,Columns>(ring, c1, secondM, np, sequence, cFree[cs2]);
                }
                // Both MAD consumers retire before either shared L0 slot is reused.
                AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(free[ks]);
            }
        }
    }
    if(!packedReady){AscendC::PipeBarrier<PIPE_ALL>();AscendC::SyncAll<false>();}
    for (uint32_t i = 0; i < 2; ++i) {
        AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(free[i]);
        AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(cFree[i]);
        pipe.ReleaseEventID<AscendC::HardEvent::M_MTE1>(free[i]);
        pipe.ReleaseEventID<AscendC::HardEvent::MTE1_M>(ready[i]);
        pipe.ReleaseEventID<AscendC::HardEvent::FIX_M>(cFree[i]);
        AscendC::CrossCoreWaitFlag<2>(4 + i);
    }
}
#endif
__schedmode__(1) __global__ __mix__(1,2) void ErsNativeEarlyWeightKernel(GM_ADDR x,GM_ADDR w,
    GM_ADDR scale,GM_ADDR groups,GM_ADDR y,GM_ADDR workspace,Shape shape,uint64_t ringOffset) {
    AscendC::TPipe pipe;
#ifdef __DAV_CUBE__
    ErsNativeEarlyCube<false,true,true>(x,workspace,groups,workspace+ringOffset,shape,pipe);
#else
    if(shape.vectorPrefetch)PrepareNzWeightsFullRows(w,workspace,groups,shape,pipe);
    else PrepareNzWeights(w,workspace,groups,shape,pipe);
    AscendC::PipeBarrier<PIPE_ALL>();AscendC::SyncAll<false>();pipe.Reset();
    NativeCVectorRun<4>(scale,groups,y,workspace+ringOffset,shape,pipe);
#endif
}



struct ErsBandPlan {
    uint32_t pairs=0,singles=0;
    __aicore__ bool Supported(uint32_t workers) const {
        return 2*pairs+singles<=2*workers;
    }
};

__aicore__ inline ErsBandPlan BuildErsBandPlan(GM_ADDR address,Shape shape) {
    AscendC::GlobalTensor<int64_t> groups;
    groups.SetGlobalBuffer((__gm__ int64_t*)address);
    ErsBandPlan plan;
    int64_t previous=0;
    for(uint32_t e=0;e<shape.experts;++e){
        const int64_t end=groups.GetValue(e);
        const uint32_t tiles=(uint32_t(end-previous)+127)/128;
        plan.pairs+=tiles/2;plan.singles+=tiles&1;
        previous=end;
    }
    return plan;
}

struct ErsBand {Segment rows;uint32_t panelMask;};

template<bool Local>
class ErsBandIterator {
    Shape shape;
    AscendC::GlobalTensor<int64_t> groups;
    AscendC::LocalTensor<int64_t> cached;
    uint32_t worker,workers,pairs;
    uint32_t expert=~uint32_t(0),row=0,end=0,pair=0,single=0;

public:
    __aicore__ ErsBandIterator(GM_ADDR address,Shape s,uint32_t owner,uint32_t owners,
        ErsBandPlan plan,AscendC::LocalTensor<int64_t> metadata={}):
        shape(s),cached(metadata),worker(owner),workers(owners),pairs(plan.pairs) {
        groups.SetGlobalBuffer((__gm__ int64_t*)address);
    }

    __aicore__ bool Next(ErsBand& out) {
        while(true){
            while(row==end){
                if(++expert>=shape.experts)return false;
                if constexpr(Local)end=uint32_t(cached.GetValue(expert));
                else end=uint32_t(groups.GetValue(expert));
            }
            const uint32_t count=end-row<256?end-row:256;
            const uint32_t first=row;
            row+=count;
            const uint32_t owner=count>128?pair++:pairs+single++%(workers-pairs);
            if(owner==worker){
                out={{int64_t(expert),int64_t(first),0,count,0},7};
                return true;
            }
        }
    }
};

class ErsBandConsumer {
    ErsBandIterator<true> bands;
    ErsBand band{};
    uint32_t col=3,tile=0,fragment=0,n;
public:
    __aicore__ ErsBandConsumer(GM_ADDR groups,Shape shape,uint32_t worker,
        uint32_t workers,ErsBandPlan plan,AscendC::LocalTensor<int64_t> metadata):
        bands(groups,shape,worker,workers,plan,metadata),n(shape.n) {}

    __aicore__ bool Next(Segment& out) {
        if(col==3){
            if(!bands.Next(band))return false;
            col=0;
            while(!((band.panelMask>>col)&1u))++col;
        }
        const uint32_t offset=((col&1)&&band.rows.rows>128?1-tile:tile)*128,first=fragment*64;
        const uint32_t rows=band.rows.rows-offset<128?band.rows.rows-offset:128;
        const uint32_t count=rows-first<64?rows-first:64;
        out={band.rows.expert,band.rows.row+offset+first,int64_t(col*256),count,col<2?256:n-512};
        if(fragment==0&&rows>64){fragment=1;return true;}
        fragment=0;
        if(tile==0&&band.rows.rows>128){tile=1;return true;}
        tile=0;
        do{++col;}while(col<3&&!((band.panelMask>>col)&1u));
        return true;
    }
};

#ifdef __DAV_CUBE__
__aicore__ inline void ErsPrefixMatmul(AscendC::GlobalTensor<int32_t> ring,
    Shape s,uint32_t rows,uint32_t bandMp,uint32_t rowOffset,
    AscendC::LocalTensor<int8_t> a1,AscendC::LocalTensor<int8_t> aTail,AscendC::LocalTensor<int8_t> b1,
    AscendC::LocalTensor<int8_t> aAll,AscendC::LocalTensor<int8_t> bAll,
    AscendC::LocalTensor<int32_t> cAll,event_t (&free)[2],event_t (&ready)[2],
    event_t (&cFree)[2],event_t tailReady,event_t aReady,bool firstTile,bool newTail,uint32_t& sequence,uint32_t& kSequence) {
    constexpr uint32_t Columns=256,MadK=128,HeadK=256,PrefixK=896;
    const uint32_t mp=(rows+15)/16*16;
    const uint32_t firstM=mp<64?mp:64;
    const uint32_t secondM=mp>64?mp-64:0;
    const uint32_t cs=sequence&1,cs2=cs^1;
    auto c0=cAll[cs*kL0CSlotElements],c1=cAll[cs2*kL0CSlotElements];
    AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(cFree[cs]);
    if(secondM)AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(cFree[cs2]);
    for(uint32_t k0=0;k0<s.k;k0+=MadK,++kSequence){
        const uint32_t count=s.k-k0<MadK?s.k-k0:MadK;
        const uint32_t kp=(count+31)/32*32,ks=kSequence&1;
        auto a2=aAll[ks*128*128],b2=bAll[ks*256*128];
        AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(free[ks]);
        AscendC::LoadData2DParams ap{};
        ap.repeatTimes=kp/32;
        if(k0==PrefixK){
            if(newTail)AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(aReady);
            ap.srcStride=mp/16;
            for(uint32_t m=0;m<mp/16;++m)AscendC::LoadData(a2[m*kp*16],aTail[m*512],ap);
        }else{
            ap.srcStride=bandMp/16;
            for(uint32_t m=0;m<mp/16;++m)
                AscendC::LoadData(a2[m*kp*16],a1[k0*bandMp+(rowOffset/16+m)*512],ap);
        }
        if(firstTile&&k0==HeadK)AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(tailReady);
        AscendC::LoadData2dTransposeParams bp{};
        bp.repeatTimes=Columns/32;bp.srcStride=s.residentK/32;bp.dstGap=1;
        for(uint32_t k=0;k<kp/32;++k)
            AscendC::LoadDataWithTranspose(b2[k*Columns*32],b1[k0*32+k*1024],bp);
        AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(ready[ks]);
        AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(ready[ks]);
        const bool last=k0+MadK>=s.k;
        AscendC::MmadParams mm{};
        mm.m=firstM;mm.n=Columns;mm.k=kp;mm.cmatrixInitVal=k0==0;
        mm.unitFlag=last?3:2;
        AscendC::Mmad(c0,a2,b2,mm);
        if(last)PublishSelectiveAppendPanel(ring,c0,firstM,Columns,sequence,cFree[cs]);
        if(secondM){
            mm.m=secondM;
            AscendC::Mmad(c1,a2[64*kp],b2,mm);
            if(last)PublishSelectiveAppendPanel(ring,c1,secondM,Columns,sequence,cFree[cs2]);
        }
        AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(free[ks]);
    }
}

__aicore__ inline void ErsBandCube(GM_ADDR xAddress,GM_ADDR groups,GM_ADDR workspace,
    Shape s,uint64_t ringOffset,AscendC::TPipe& pipe,ErsBandPlan plan) {
    constexpr uint32_t Head=256;
    const uint32_t worker=AscendC::GetBlockIdx();
    AscendC::GlobalTensor<int8_t> x,weight;
    AscendC::GlobalTensor<int32_t> ring;
    x.SetGlobalBuffer((__gm__ int8_t*)xAddress);
    weight.SetGlobalBuffer((__gm__ int8_t*)workspace);
    ring.SetGlobalBuffer((__gm__ int32_t*)(workspace+ringOffset)+worker*18*kTileElements);
    AscendC::SetAtomicNone();AscendC::SetMMRowMajor();
    AscendC::SetLoadDataBoundary(uint64_t(0));AscendC::SetLoadDataPaddingValue(uint64_t(0));
    AscendC::TBuf<AscendC::TPosition::A1> ab1;
    AscendC::TBuf<AscendC::TPosition::B1> bb1;
    AscendC::TBuf<AscendC::TPosition::A2> ab;
    AscendC::TBuf<AscendC::TPosition::B2> bb;
    AscendC::TBuf<AscendC::TPosition::CO1> cb;
    pipe.InitBuffer(ab1,256*896+128*128);pipe.InitBuffer(bb1,256*s.residentK);
    pipe.InitBuffer(ab,2*128*128);pipe.InitBuffer(bb,2*256*128);
    pipe.InitBuffer(cb,2*kL0CSlotElements*sizeof(int32_t));
    auto a1=ab1.Get<int8_t>(),b1=bb1.Get<int8_t>(),aAll=ab.Get<int8_t>(),bAll=bb.Get<int8_t>();
    auto aTail=a1[256*896];
    auto cAll=cb.Get<int32_t>();
    event_t free[2],ready[2],cFree[2];
    for(uint32_t i=0;i<2;++i){
        free[i]=(event_t)pipe.AllocEventID<AscendC::HardEvent::M_MTE1>();
        ready[i]=(event_t)pipe.AllocEventID<AscendC::HardEvent::MTE1_M>();
        cFree[i]=(event_t)pipe.AllocEventID<AscendC::HardEvent::FIX_M>();
        AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(free[i]);
        AscendC::SetFlag<AscendC::HardEvent::FIX_M>(cFree[i]);
    }
    const auto tailReady=(event_t)pipe.AllocEventID<AscendC::HardEvent::MTE2_MTE1>();
    const auto aReady=(event_t)pipe.AllocEventID<AscendC::HardEvent::MTE2_MTE1>();
    ErsBandIterator<false> bands(groups,s,worker,AscendC::GetBlockNum(),plan);
    ErsBand band;
    bool live=bands.Next(band);
    if(live)LoadNzResidentRowTail(a1,x,s,band.rows,0,896);
    AscendC::PipeBarrier<PIPE_ALL>();AscendC::SyncAll<false>();
    uint32_t sequence=0,kSequence=0;
    while(live){
        int64_t loadedTail=-1;
        const uint32_t bandMp=(band.rows.rows+15)/16*16;
        for(uint32_t col=0;col<3;++col){
            if(!((band.panelMask>>col)&1u))continue;
            const uint64_t base=(uint64_t(band.rows.expert)*s.packedPartials+col*256)*s.residentK;
            const uint16_t tail=s.residentK-Head;
            Fence<AscendC::HardEvent::MTE1_MTE2>();
            AscendC::DataCopy(b1,weight[base],AscendC::DataCopyParams{8,Head,tail,tail});
            Fence<AscendC::HardEvent::MTE2_MTE1>();
            AscendC::DataCopy(b1[Head*32],weight[base+Head*32],AscendC::DataCopyParams{8,tail,Head,Head});
            AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(tailReady);
            const bool paired=band.rows.rows>128;
            for(uint32_t tile=0;tile<(paired?2:1);++tile){
                const uint32_t offset=((col&1)&&paired?1-tile:tile)*128;
                const uint32_t rows=band.rows.rows-offset<128?band.rows.rows-offset:128;
                const int64_t row=band.rows.row+offset;
                const bool newTail=loadedTail!=row;
                if(newTail){
                    const uint32_t mp=(rows+15)/16*16;
                    Fence<AscendC::HardEvent::MTE1_MTE2>();
                    kernel_common::ZeroNzRows(aTail,rows,mp,128);
                    AscendC::Nd2NzParams cp{};
                    cp.ndNum=1;cp.nValue=rows;cp.dValue=s.k-896;cp.srcDValue=s.k;
                    cp.dstNzC0Stride=mp;cp.dstNzNStride=1;
                    AscendC::DataCopy(aTail,x[row*s.k+896],cp);
                    AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(aReady);
                    loadedTail=row;
                }
                ErsPrefixMatmul(ring,s,rows,bandMp,offset,a1,aTail,b1,
                    aAll,bAll,cAll,free,ready,cFree,tailReady,aReady,tile==0,newTail,sequence,kSequence);
            }
        }
        live=bands.Next(band);
        if(live)LoadNzResidentRowTail(a1,x,s,band.rows,0,896);
    }
    pipe.ReleaseEventID<AscendC::HardEvent::MTE2_MTE1>(aReady);
    pipe.ReleaseEventID<AscendC::HardEvent::MTE2_MTE1>(tailReady);
    for(uint32_t i=0;i<2;++i){
        AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(free[i]);
        AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(cFree[i]);
        pipe.ReleaseEventID<AscendC::HardEvent::M_MTE1>(free[i]);
        pipe.ReleaseEventID<AscendC::HardEvent::MTE1_M>(ready[i]);
        pipe.ReleaseEventID<AscendC::HardEvent::FIX_M>(cFree[i]);
    }
}
#endif

template<bool Enabled>
__attribute__((aligned(128))) __schedmode__(1) __global__ __mix__(1,2) void ErsResidentBandKernel(GM_ADDR x,GM_ADDR w,
    GM_ADDR scale,GM_ADDR groups,GM_ADDR y,GM_ADDR workspace,Shape shape,uint64_t ringOffset) {
    AscendC::TPipe pipe;
    const auto plan=BuildErsBandPlan(groups,shape);
    const bool resident=Enabled&&plan.Supported(AscendC::GetBlockNum());
#ifdef __DAV_CUBE__
    if(resident)ErsBandCube(x,groups,workspace,shape,ringOffset,pipe,plan);
    else ErsNativeEarlyCube<false,true,true>(x,workspace,groups,workspace+ringOffset,shape,pipe);
#else
    if(shape.vectorPrefetch)PrepareNzWeightsFullRows(w,workspace,groups,shape,pipe);
    else PrepareNzWeights(w,workspace,groups,shape,pipe);
    AscendC::PipeBarrier<PIPE_ALL>();AscendC::SyncAll<false>();pipe.Reset();
    if(resident){
        AscendC::TBuf<AscendC::TPosition::VECCALC> metadata;
        pipe.InitBuffer(metadata,(shape.experts+3)/4*32);
        auto local=metadata.Get<int64_t>();
        AscendC::GlobalTensor<int64_t> g;g.SetGlobalBuffer((__gm__ int64_t*)groups);
        AscendC::DataCopyExtParams copy{1,uint32_t(shape.experts*8),0,0,0};
        AscendC::DataCopyPadExtParams<int64_t> pad{false,0,0,0};
        AscendC::DataCopyPad(local,g,copy,pad);Fence<AscendC::HardEvent::MTE2_S>();
        ErsBandConsumer segments(groups,shape,AscendC::GetBlockIdx()/2,
            AscendC::GetBlockNum(),plan,local);
        WeightWaveVector<ErsBandConsumer,18>(scale,y,workspace+ringOffset,shape,pipe,segments);
    }else NativeCVectorRun<4>(scale,groups,y,workspace+ringOffset,shape,pipe);
#endif
}


static void LaunchSharedErs(GM_ADDR x,GM_ADDR w,GM_ADDR scale,GM_ADDR groups,
    GM_ADDR y,GM_ADDR workspace,Shape shape,uint64_t ringOffset,uint32_t workers,aclrtStream stream);

namespace hc_wide_resident {
constexpr uint32_t BandRows = 192;
constexpr uint32_t MaxN = 160;
constexpr uint32_t HeadK = 256;
constexpr uint32_t MadK = 128;
constexpr uint32_t FrameCount = 16;
constexpr uint32_t FrameElements = 2 * kTileElements;
constexpr uint32_t VecElements = (BandRows / 2) * MaxN;
constexpr uint32_t VectorBytes = 12 * VecElements + MaxN * 4 + 1024;

__aicore__ inline uint32_t Min(uint32_t a,uint32_t b) {
    return a<b?a:b;
}

struct Plan {
    uint32_t ends[33]{};
    uint32_t planes = 0, panels = 0, base = 0, wide = 0;
    uint32_t total = 0, active = 0, mask = 0;
    bool admitted = false;

    __aicore__ void Build(GM_ADDR groups, Shape s, uint32_t workers, bool resident) {
        AscendC::GlobalTensor<int64_t> groupGm;
        groupGm.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups));
        planes = s.packedPartials / 32;
        panels = (planes + MaxN / 32 - 1) / (MaxN / 32);
        base = planes / panels;
        wide = planes % panels;
        uint32_t bands = 0, oldBands = 0;
        for (uint32_t expert = 0; expert < uint32_t(s.experts); ++expert) {
            ends[expert+1] = uint32_t(groupGm.GetValue(expert));
            const uint32_t rows = ends[expert+1] - ends[expert];
            if (!rows) continue;
            ++active;
            mask |= uint32_t(1) << expert;
            const uint32_t expertBands = (rows + BandRows - 1) / BandRows;
            oldBands += (rows + 127) / 128;
            bands += expertBands;
            total += 4 * planes * expertBands + (rows + 15) / 16;
        }
        // Two neighboring task midpoints are at least one minimum task
        // cost apart. This bounds every append-only frame interval.
        // Wide tasks have a K-head/tail schedule and separate output
        // frames. Reserve another five percentage points of band savings
        // to pay for the finer column panels on weakly compacted groups.
        admitted = resident && active > 1 && 4 * bands <= 3 * oldBands &&
            total <= workers * 4 * base * FrameCount;
    }

    __aicore__ uint32_t BandCost(uint32_t rows) const {
        return 4 * planes + (rows + 15) / 16;
    }
};

class Cursor {
    const Plan& plan;
    uint32_t n, worker, workers, expert = 0, band = 0, unit = 0, prefix = 0;

    __aicore__ void AdvanceBand() {
        band += BandRows;
        unit = 0;
        while (expert + 1 < 33 && band >= plan.ends[expert+1]) {
            band = plan.ends[++expert];
            if (expert == 32) break;
        }
    }

public:
    __aicore__ Cursor(const Plan& p, Shape s, uint32_t owner, uint32_t owners)
        : plan(p), n(s.n), worker(owner), workers(owners) {
        const uint32_t lower = 2 * plan.total * worker;
        while (band < uint32_t(s.m)) {
            if (plan.ends[expert+1] != band) {
                const uint32_t rows = Min(plan.ends[expert+1] - band, BandRows);
                const uint32_t cost = plan.BandCost(rows);
                if ((prefix + cost) * 2 * workers > lower) break;
                prefix += cost;
            }
            AdvanceBand();
        }
    }

    __aicore__ bool Next(Segment& out) {
        const uint32_t lower = 2 * plan.total * worker, upper = lower + 2 * plan.total;
        while (prefix < plan.total) {
            const uint32_t ordinal = (band - plan.ends[expert]) / BandRows;
            const uint32_t panel = (ordinal & 1) ? plan.panels - 1 - unit : unit;
            const uint32_t col = 32 * (panel * plan.base + Min(panel,plan.wide));
            const uint32_t np = 32 * (plan.base + uint32_t(panel < plan.wide));
            const uint32_t rows = Min(plan.ends[expert+1] - band,BandRows);
            const uint32_t cost = np / 8 + (unit == 0 ? (rows + 15) / 16 : 0);
            const uint32_t middle = (2 * prefix + cost) * workers;
            if (middle >= upper) return false;
            out = {int64_t(expert),int64_t(band),int64_t(col),rows,Min(n-col,np)};
            prefix += cost;
            if (++unit == plan.panels) AdvanceBand();
            if (middle >= lower) return true;
        }
        return false;
    }
};

#ifdef __DAV_CUBE__
__aicore__ inline bool SameWeight(const Segment& first, const Segment& second) {
    return first.expert == second.expert && first.column == second.column;
}

__aicore__ inline void CopyWeightHead(AscendC::LocalTensor<int8_t> dst,
    AscendC::GlobalTensor<int8_t> src, Shape s, const Segment& panel) {
    const uint32_t np = (panel.columns+31)/32*32;
    const uint64_t base = (uint64_t(panel.expert)*s.packedPartials+panel.column)*s.residentK;
    const AscendC::DataCopyParams copy{uint16_t(np/32),HeadK,uint16_t(s.residentK-HeadK),0};
    AscendC::DataCopy(dst,src[base],copy);
}

__aicore__ inline void CopyWeightTail(AscendC::LocalTensor<int8_t> dst,
    AscendC::GlobalTensor<int8_t> src, Shape s, const Segment& panel) {
    const uint32_t np = (panel.columns+31)/32*32;
    const uint32_t tail = s.residentK-HeadK;
    const uint64_t base = (uint64_t(panel.expert)*s.packedPartials+panel.column)*s.residentK+HeadK*32;
    const AscendC::DataCopyParams copy{uint16_t(np/32),uint16_t(tail),HeadK,0};
    AscendC::DataCopy(dst,src[base],copy);
}

__aicore__ inline void RunCube(GM_ADDR xAddress, GM_ADDR packedAddress, GM_ADDR frames,
    Shape s, AscendC::TPipe& pipe, const Plan& plan) {
    const uint32_t worker = AscendC::GetBlockIdx(), workers = AscendC::GetBlockNum();
    AscendC::GlobalTensor<int8_t> x, weight;
    AscendC::GlobalTensor<int32_t> ring;
    x.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(xAddress));
    weight.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(packedAddress));
    ring.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(frames) + worker*FrameCount*FrameElements);
    AscendC::SetAtomicNone();
    AscendC::SetMMRowMajor();
    AscendC::SetLoadDataBoundary(uint64_t(0));
    AscendC::SetLoadDataPaddingValue(uint64_t(0));
    AscendC::TBuf<AscendC::TPosition::A1> aResident;
    AscendC::TBuf<AscendC::TPosition::B1> bResident;
    AscendC::TBuf<AscendC::TPosition::A2> aBuffer;
    AscendC::TBuf<AscendC::TPosition::B2> bBuffer;
    AscendC::TBuf<AscendC::TPosition::CO1> cBuffer;
    pipe.InitBuffer(aResident,BandRows*s.residentK);
    pipe.InitBuffer(bResident,MaxN*(s.residentK+HeadK));
    pipe.InitBuffer(aBuffer,2*BandRows*MadK);
    pipe.InitBuffer(bBuffer,2*MaxN*MadK);
    pipe.InitBuffer(cBuffer,BandRows*MaxN*sizeof(int32_t));
    auto a1=aResident.Get<int8_t>(), heads=bResident.Get<int8_t>();
    auto tail=heads[2*HeadK*MaxN];
    auto aAll=aBuffer.Get<int8_t>(), bAll=bBuffer.Get<int8_t>();
    auto c=cBuffer.Get<int32_t>();
    event_t operandFree[2], operandReady[2], headFree[2], headReady[2];
    for (uint32_t slot=0;slot<2;++slot) {
        operandFree[slot]=static_cast<event_t>(pipe.AllocEventID<AscendC::HardEvent::M_MTE1>());
        operandReady[slot]=static_cast<event_t>(pipe.AllocEventID<AscendC::HardEvent::MTE1_M>());
        headFree[slot]=static_cast<event_t>(pipe.AllocEventID<AscendC::HardEvent::MTE1_MTE2>());
        headReady[slot]=static_cast<event_t>(pipe.AllocEventID<AscendC::HardEvent::MTE2_MTE1>());
        AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(operandFree[slot]);
        AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(headFree[slot]);
    }
    const auto tailReady=static_cast<event_t>(pipe.AllocEventID<AscendC::HardEvent::MTE2_MTE1>());
    const auto cFree=static_cast<event_t>(pipe.AllocEventID<AscendC::HardEvent::FIX_M>());
    AscendC::SetFlag<AscendC::HardEvent::FIX_M>(cFree);

    Cursor tasks(plan,s,worker,workers);
    Segment panel, next;
    bool live=tasks.Next(panel);
    if (live) LoadNzResidentRowTail(a1,x,s,panel,0,s.k);
    AscendC::PipeBarrier<PIPE_ALL>();
    AscendC::SyncAll<false>();
    uint32_t sequence=0, kSequence=0, headSlot=0;
    int64_t loadedRow=live?panel.row:-1;
    bool newWeight=live;
    if (live) {
        AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(headFree[0]);
        CopyWeightHead(heads,weight,s,panel);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(headReady[0]);
    }
    AscendC::LoadData3DParamsV2<int8_t> aLoad{};
    aLoad.l1H=1;
    aLoad.strideW=1; aLoad.strideH=1;
    aLoad.filterW=1; aLoad.filterH=1;
    aLoad.dilationFilterW=1; aLoad.dilationFilterH=1;
    while (live) {
        const bool nextLive=tasks.Next(next);
        const bool sameNext=nextLive && SameWeight(panel,next);
        if (newWeight) {
            Fence<AscendC::HardEvent::MTE1_MTE2>();
            CopyWeightTail(tail,weight,s,panel);
            AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(tailReady);
        }
        if (nextLive && !sameNext) {
            const uint32_t ahead=headSlot^1;
            AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(headFree[ahead]);
            CopyWeightHead(heads[ahead*HeadK*MaxN],weight,s,next);
            AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(headReady[ahead]);
        }
        if (loadedRow != panel.row) {
            LoadNzResidentRowTail(a1,x,s,panel,0,s.k);
            loadedRow=panel.row;
        }
        const uint32_t mp=(panel.rows+15)/16*16, np=(panel.columns+31)/32*32;
        auto head=heads[headSlot*HeadK*MaxN];
        aLoad.l1W=mp;
        aLoad.mExtension=mp;
        AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(cFree);
        if (newWeight)
            AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(headReady[headSlot]);
        for (uint32_t k=0;k<uint32_t(s.k);k+=MadK,++kSequence) {
            const uint32_t count=Min(uint32_t(s.k)-k,MadK);
            const uint32_t kp=(count+31)/32*32, slot=kSequence&1;
            auto a2=aAll[slot*BandRows*MadK], b2=bAll[slot*MaxN*MadK];
            AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(operandFree[slot]);
            aLoad.channelSize=kp;
            aLoad.kExtension=kp;
            AscendC::LoadData(a2,a1[k*mp],aLoad);
            if (newWeight && k==HeadK)
                AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(tailReady);
            auto b1=k<HeadK?head[k*32]:tail[(k-HeadK)*32];
            AscendC::LoadData2dTransposeParams bp{};
            bp.repeatTimes=np/32;
            bp.srcStride=(k<HeadK?HeadK:s.residentK-HeadK)/32;
            bp.dstGap=1;
            for (uint32_t slice=0;slice<kp/32;++slice)
                AscendC::LoadDataWithTranspose(b2[slice*np*32],b1[slice*1024],bp);
            if (!sameNext && k+MadK==HeadK)
                AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(headFree[headSlot]);
            AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(operandReady[slot]);
            AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(operandReady[slot]);
            const bool last=k+MadK>=uint32_t(s.k);
            AscendC::MmadParams mm{};
            mm.m=mp; mm.n=np; mm.k=kp;
            mm.cmatrixInitVal=k==0; mm.unitFlag=last?3:2;
            AscendC::Mmad(c,a2,b2,mm);
            if ((mp/16)*(np/16)<10) AscendC::PipeBarrier<PIPE_M>();
            AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(operandFree[slot]);
        }
        AscendC::FixpipeParamsV220 fp{};
        fp.unitFlag=3; fp.nSize=np; fp.mSize=mp; fp.srcStride=mp; fp.dstStride=2*mp;
        AscendC::Fixpipe<int32_t,int32_t,AscendC::CFG_NZ>(ring[sequence*FrameElements],c,fp);
        AscendC::SetFlag<AscendC::HardEvent::FIX_M>(cFree);
        AscendC::CrossCoreSetFlag<2,PIPE_FIX>(sequence&1);
        ++sequence;
        live=nextLive;
        if (live) {
            panel=next;
            newWeight=!sameNext;
            if (newWeight) headSlot^=1;
        }
    }
    for (uint32_t slot=0;slot<2;++slot) {
        AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(headFree[slot]);
        AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(operandFree[slot]);
        pipe.ReleaseEventID<AscendC::HardEvent::MTE1_MTE2>(headFree[slot]);
        pipe.ReleaseEventID<AscendC::HardEvent::MTE2_MTE1>(headReady[slot]);
        pipe.ReleaseEventID<AscendC::HardEvent::M_MTE1>(operandFree[slot]);
        pipe.ReleaseEventID<AscendC::HardEvent::MTE1_M>(operandReady[slot]);
    }
    AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(cFree);
    pipe.ReleaseEventID<AscendC::HardEvent::MTE2_MTE1>(tailReady);
    pipe.ReleaseEventID<AscendC::HardEvent::FIX_M>(cFree);
}
#else
__aicore__ inline void RunVector(GM_ADDR scaleAddress, GM_ADDR yAddress, GM_ADDR frames,
    Shape s, AscendC::TPipe& pipe, const Plan& plan) {
    const uint32_t worker=AscendC::GetBlockIdx()/2, sub=AscendC::GetSubBlockIdx();
    AscendC::GlobalTensor<int32_t> ring;
    AscendC::GlobalTensor<float> scales;
    AscendC::GlobalTensor<half> output;
    ring.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(frames)+worker*FrameCount*FrameElements);
    scales.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scaleAddress));
    output.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(yAddress));
    AscendC::TBuf<AscendC::TPosition::VECCALC> cBuffer,scratchBuffer,outputBuffer,scaleBuffer;
    pipe.InitBuffer(cBuffer,VecElements*4+256);
    pipe.InitBuffer(scratchBuffer,VecElements*4+512);
    pipe.InitBuffer(outputBuffer,VecElements*4);
    pipe.InitBuffer(scaleBuffer,MaxN*4+256);
    auto c=cBuffer.Get<int32_t>()[64];
    auto z=c.ReinterpretCast<float>(), scratch=scratchBuffer.Get<float>()[128];
    auto halfNz=scratch.ReinterpretCast<half>(), halfNd=outputBuffer.Get<half>();
    auto scale=scaleBuffer.Get<float>()[64];
    const auto inputFree=static_cast<event_t>(pipe.AllocEventID<AscendC::HardEvent::V_MTE2>());
    event_t outputFree[2];
    AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(inputFree);
    for (uint32_t slot=0;slot<2;++slot) {
        outputFree[slot]=static_cast<event_t>(pipe.AllocEventID<AscendC::HardEvent::MTE3_V>());
        AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(outputFree[slot]);
    }
    Cursor tasks(plan,s,worker,AscendC::GetBlockNum());
    Segment panel;
    uint32_t sequence=0;
    int64_t scaleExpert=-1,scaleColumn=-1;
    while (tasks.Next(panel)) {
        const uint32_t frame=sequence++, slot=frame&1;
        AscendC::CrossCoreWaitFlag<2>(slot);
        const uint32_t partition=(panel.rows+1)/2, first=sub*partition;
        const uint32_t rows=panel.rows-first;
        if (!rows) continue;
        const uint32_t count=Min(rows,partition);
        const uint32_t mp=(panel.rows+15)/16*16, np=(panel.columns+31)/32*32;
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(inputFree);
        const AscendC::DataCopyParams input{uint16_t(np/16),uint16_t(2*count),uint16_t(2*(mp-count)),0};
        AscendC::DataCopy(c,ring[frame*FrameElements+first*16],input);
        if (scaleExpert!=panel.expert || scaleColumn!=panel.column) {
            auto source=scales[panel.expert*s.n+panel.column];
            if (np!=panel.columns) {
                AscendC::Duplicate(scale,0.0f,np);
                Fence<AscendC::HardEvent::V_MTE2>();
                const AscendC::DataCopyExtParams cp{1,panel.columns*4,0,0,0};
                const AscendC::DataCopyPadExtParams<float> pad{
                    true,0,uint8_t((panel.columns+7)/8*8-panel.columns),0.0f};
                AscendC::DataCopyPad(scale,source,cp,pad);
            } else AscendC::DataCopy(scale,source,np);
            scaleExpert=panel.expert; scaleColumn=panel.column;
        }
        Fence<AscendC::HardEvent::MTE2_V>();
        asc_int322float_rn(Ub(z),Ub(c),count*np);
        AscendC::PipeBarrier<PIPE_V>();
        ExpandScaleForNativeC(scratch,scale,count,np);
        asc_set_mask_count(); asc_set_vector_mask(0,count*np);
        asc_mul(Ub(z),Ub(z),Ub(scratch),1,1,1,1,8,8,8);
        AscendC::PipeBarrier<PIPE_V>();
        kernel_common::GeluCountMasked(Ub(z),Ub(scratch));
        asc_float2half_rn(Ub(halfNz),Ub(z),1,1,1,4,8);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(inputFree);
        AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(outputFree[slot]);
        auto h=halfNd[slot*VecElements];
        NativeHalfCToNd(h,halfNz,count,np);
        Fence<AscendC::HardEvent::V_MTE3>();
        const AscendC::DataCopyExtParams out{uint16_t(count),panel.columns*2,
            (np-(panel.columns+15)/16*16)/16,uint32_t((s.n-panel.columns)*2),0};
        AscendC::DataCopyPad(output[(panel.row+first)*s.n+panel.column],h,out);
        AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(outputFree[slot]);
    }
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(inputFree);
    pipe.ReleaseEventID<AscendC::HardEvent::V_MTE2>(inputFree);
    for (uint32_t slot=0;slot<2;++slot) {
        AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(outputFree[slot]);
        pipe.ReleaseEventID<AscendC::HardEvent::MTE3_V>(outputFree[slot]);
    }
}
#endif
} // namespace hc_wide_resident

// Called inside grouped_matmul_gelu after the ordinary NZ weight pipeline.
template<uint32_t HeadK, uint32_t PackRows, uint32_t PackColumns>
__schedmode__(1) __global__ __mix__(1,2) void WideOddNzSharedPackKernel(GM_ADDR x, GM_ADDR weight,
    GM_ADDR scale, GM_ADDR groups, GM_ADDR y, GM_ADDR workspace, Shape s, uint64_t ringOffset,
    uint32_t sharedSlabK, bool wideResident) {
    AscendC::TPipe pipe;
    NzPanelPlan plan;
#ifdef __DAV_CUBE__
    const uint32_t worker = AscendC::GetBlockIdx();
#else
    const uint32_t worker = AscendC::GetBlockIdx() / 2;
#endif
    const uint32_t workers = AscendC::GetBlockNum();
    hc_wide_resident::Plan resident;
    resident.Build(groups,s,workers,wideResident);
    const uint32_t active=resident.active,mask=resident.mask;
    const bool shared = active * HeadK >= workers * 64;
    if (active == 1) plan.Build<false>(groups, s, worker, workers);
#ifdef __DAV_CUBE__
    if (shared)
        PrepareLowCubeNzAll<PackRows,PackColumns,HeadK>(weight,workspace,s,pipe,mask,active);
    if (resident.admitted)
        hc_wide_resident::RunCube(x,workspace,workspace+ringOffset,s,pipe,resident);
    else if (plan.enabled)
        NzPanelResidentCube<true>(x, workspace, groups, workspace + ringOffset, s, pipe, plan);
    else
        NzAZeroEarlyCube<false,true,true>(x, workspace, groups, workspace + ringOffset, s, pipe);
#else
    if (shared) {
        Shape packing = s;
        packing.slabK = sharedSlabK;
        PrepareWaveNzWeights<true,HeadK>(weight,workspace,packing,pipe,mask,active);
    } else if (s.vectorPrefetch) {
        PrepareBalancedNzWeightsFullRows(weight, workspace, groups, s, pipe);
    } else {
        PrepareNzWeights(weight, workspace, groups, s, pipe);
    }
    AscendC::PipeBarrier<PIPE_ALL>();
    AscendC::SyncAll<false>();
    pipe.Reset();
    if (resident.admitted) {
        hc_wide_resident::RunVector(scale,y,workspace+ringOffset,s,pipe,resident);
    } else if (plan.enabled) {
        NzPanelSegments<true> segments(plan);
        NativeCVectorPrepared(scale,y,workspace+ringOffset,s,pipe,segments);
    } else {
        NativeCVectorRun<4>(scale,groups,y,workspace+ringOffset,s,pipe);
    }
#endif
}

inline bool TryLaunchNzWeights(GM_ADDR x, GM_ADDR w, GM_ADDR scale, GM_ADDR groups,
    GM_ADDR y, uint32_t e, uint32_t m, uint32_t k, uint32_t n,
    int64_t availableCores, aclrtStream stream, kernel_common::HostPlatform& platform)
{
    // Four N256 panels with a partial last panel can amortize full-row B packing.
    const bool fourPanelShortK = k<=1344 && k%32!=0 && n>3*256 && n<4*256;
    const bool alignedRemainder = fourPanelShortK && n%32==0 && n%256!=0;
    // A complete K256 packet avoids the short-packet supply penalty.
    // Require three N256 panels with at least half of the last panel useful.
    // Original M/expert amortization and all resource checks still apply.
    const bool completeShortPackets = k>512 && k<=1024 &&
        (((k+31)/32*32)%256==0) && n>2*256 && n<3*256 &&
        n%256>=128 && n%32!=0;
    const uint32_t workers = std::min<int64_t>(availableCores,
        std::min(platform.GetCoreNumAic(), platform.GetCoreNumAiv() / 2));
    // Two M64 fragments per expert on average can share one M128 NZ macro.
    // Keep the low-expert adaptive/paired families outside this experiment.
    const bool manyExpertShortPanels = fourPanelShortK && n%32!=0 && e>workers &&
        uint64_t(m)>=uint64_t(64)*e && uint64_t(m)<uint64_t(128)*e;
    if ((k <= 1024 && !completeShortPackets) || k > 2048 || n < 512 || (n % 32 == 0 && !alignedRemainder) ||
        m < 1024 || (m < 128 * e && !manyExpertShortPanels)) return false;
    // Four short-K N256 panels may also amortize preprocessing at one
    // average M128 tile. Capacity checks below still apply; groups stay on device.
    if (n > 2048 || (!fourPanelShortK && uint64_t(m) < uint64_t(256) * e && n <= 1024)) return false;
    if (!workers || uint64_t((m + 127) / 128) * ((n + 255) / 256) < workers) return false;
    const uint32_t kp = (k + 31) / 32 * 32, np = (n + 31) / 32 * 32;
    uint64_t l1 = 0, l0a = 0, l0b = 0, l0c = 0, ub = 0;
    platform.GetCoreMemSize(platform_ascendc::CoreMemType::L1, l1);
    platform.GetCoreMemSize(platform_ascendc::CoreMemType::L0_A, l0a);
    platform.GetCoreMemSize(platform_ascendc::CoreMemType::L0_B, l0b);
    platform.GetCoreMemSize(platform_ascendc::CoreMemType::L0_C, l0c);
    platform.GetCoreMemSize(platform_ascendc::CoreMemType::UB, ub);
    if (l1 < uint64_t(128) * kp + 2 * 256 * 256 + 4096 || l0a < 32768 ||
        l0b < 65536 || l0c < 131072 || ub < 132 * 1024) return false;
    // Preserve full-K B residency when a short final K256 packet cannot
    // amortize preprocessing/packet supply over at most three N256 panels.
    // A half/full packet and wider N retain the measured NZ path.
    const uint32_t packetTail = kp % 256;
    const bool keepResidentNarrow = k <= 1344 && (n + 255) / 256 <= 3 &&
        packetTail > 0 && packetTail < 128 &&
        l1 >= std::max<uint64_t>(uint64_t(384) * kp + 4096,
            uint64_t(128) * kp + 65536 + 1024) &&
        l0a >= 65536 && l0b >= 65536 && l0c >= 131072 && ub >= 176 * 1024;
    if (keepResidentNarrow) return false;
    Shape shape{};
    shape.m = m; shape.k = k; shape.n = n; shape.experts = e;
    shape.rowTile = 128; shape.columnTiles = (n + 255) / 256;
    shape.residentK = kp; shape.kTile = 128; shape.packedPartials = np;
    shape.slabK = static_cast<uint32_t>(std::min<uint64_t>(128, ub / (3 * uint64_t(np))));
    shape.vectorPrefetch = np <= 2048 && shape.slabK >= 16;
    const uint64_t ringOffset = (uint64_t(e) * kp * np + 511) / 512 * 512;
    const uint64_t groupBytes = (e+3)/4*32;
    const bool nativeC = n % 32 != 0 && ub >= 182016 + groupBytes;
    // The M96 engine uses two N256 panels and one N288-capacity tail.
    // The append fallback emits at most two M64 frames per N256 tile.
    const uint64_t maximumMTiles = (uint64_t(m)-1)/128 + e;
    const uint64_t appendFrames = 2 * ((maximumMTiles+workers-1)/workers) * shape.columnTiles;
    constexpr uint32_t waveFrames = 24;
    constexpr uint32_t waveSlab = 61;
    const bool m96Waves = nativeC && e <= 32 && n > 3 * 256 && n <= 2 * 256 + 288 &&
        appendFrames <= waveFrames && ub >= 4ull * waveSlab * np;
    if (m96Waves) shape.slabK = waveSlab;
    const bool earlyPacked = nativeC && completeShortPackets;
    // The prefix-band engine reads three full N256 panels. The ordinary
    // early-packed path reads only the padded width of a shorter last panel.
    const bool prefixBands = earlyPacked && np == 3 * 256 && kp > 896 && kp <= 1024 &&
        l1 >= uint64_t(256) * 896 + 128 * 128 + uint64_t(256) * kp + 4096;
    const bool panelResident = !m96Waves && !earlyPacked && nativeC && workers <= 32 &&
        k <= 1344 && k % 32 != 0 && n > 3 * 256 && n <= 5 * 256 &&
        l1 >= uint64_t(384) * kp + 4096 &&
        uint64_t(4) * 256 * shape.columnTiles <= uint64_t(5) * np;
    constexpr uint32_t hcPackHead = 320;
    constexpr uint32_t hcPackRows = 224, hcPackColumns = 1152;
    const bool sharedWidePack = panelResident && e <= workers && e <= 32 &&
        np > 4 * 256 && np <= hcPackColumns && kp > hcPackHead &&
        l1 >= 2ull * hcPackRows * hcPackColumns + 4096 &&
        ub >= 4ull * 16 * np;
    const bool wideResident = sharedWidePack &&
        l1 >= uint64_t(hc_wide_resident::BandRows+hc_wide_resident::MaxN)*kp +
            hc_wide_resident::HeadK*hc_wide_resident::MaxN + 4096 &&
        l0a >= 2ull*hc_wide_resident::BandRows*hc_wide_resident::MadK &&
        l0b >= 2ull*hc_wide_resident::MaxN*hc_wide_resident::MadK &&
        l0c >= 4ull*hc_wide_resident::BandRows*hc_wide_resident::MaxN &&
        ub >= hc_wide_resident::VectorBytes;
    // Only low expert count pays for the global A pack to balance full-K
    // weight packing. Bound both manual Cube B banks and Vector copy repeats.
    const uint32_t paddedM = (m+31)/32*32;
    const uint32_t maxPackRows = (paddedM+2*workers-1)/(2*workers);
    const bool lowResident = m96Waves && e <= workers && kp <= 1056 &&
        l1 >= std::max<uint64_t>(uint64_t(480)*kp,2ull*224*1056) + 4096 &&
        maxPackRows <= 255 && 2ull * maxPackRows * kp <= ub;
    const uint64_t packedABytes = lowResident ? uint64_t(paddedM)*kp : 0;
    const uint64_t bytes = ringOffset + uint64_t(workers) *
        (wideResident ? 2*hc_wide_resident::FrameCount : (m96Waves ? waveFrames : (prefixBands ? 18 : kSlots))) * kTileElements * 4 + packedABytes;
    void* workspace = nullptr;
    if (aclrtMalloc(&workspace, bytes, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS)
        throw std::runtime_error("NZ weight workspace allocation failed");
    if (prefixBands && e<=32 && ub>=4ull*58*np)
        LaunchSharedErs(x,w,scale,groups,y,(GM_ADDR)workspace,shape,ringOffset,workers,stream);
    else if (prefixBands)
        ErsResidentBandKernel<true><<<workers,nullptr,stream>>>(x,w,scale,groups,y,(GM_ADDR)workspace,shape,ringOffset);
    else if (earlyPacked)
        ErsNativeEarlyWeightKernel<<<workers,nullptr,stream>>>(x,w,scale,groups,y,(GM_ADDR)workspace,shape,ringOffset);
    else if (lowResident)
        LowResidentM96Kernel<false><<<workers,nullptr,stream>>>(x,w,scale,groups,y,(GM_ADDR)workspace,shape,ringOffset);
    else if (m96Waves && e <= workers)
        LowM96Kernel<false><<<workers,nullptr,stream>>>(x,w,scale,groups,y,(GM_ADDR)workspace,shape,ringOffset);
    else if (m96Waves && l1 >= uint64_t(192+288)*kp+4096)
        WeightWaveKernel<false,true,true><<<workers,nullptr,stream>>>(x,w,scale,groups,y,(GM_ADDR)workspace,shape,ringOffset);
    else if (m96Waves)
        WeightWaveKernel<false><<<workers,nullptr,stream>>>(x,w,scale,groups,y,(GM_ADDR)workspace,shape,ringOffset);
    else if (sharedWidePack)
        WideOddNzSharedPackKernel<hcPackHead,hcPackRows,hcPackColumns><<<workers,nullptr,stream>>>(
            x,w,scale,groups,y,(GM_ADDR)workspace,shape,ringOffset,
            static_cast<uint32_t>(std::min<uint64_t>(128,ub/(4ull*np))),wideResident);
    else if (panelResident && e > workers)
        NzPanelResidentWeightKernel<true,true><<<workers,nullptr,stream>>>(x,w,scale,groups,y,(GM_ADDR)workspace,shape,ringOffset);
    else if (panelResident)
        NzPanelResidentWeightKernel<false,true><<<workers,nullptr,stream>>>(x,w,scale,groups,y,(GM_ADDR)workspace,shape,ringOffset);
    else if (nativeC && e > workers)
        NzAZeroWeightKernel<true,true><<<workers,nullptr,stream>>>(x,w,scale,groups,y,(GM_ADDR)workspace,shape,ringOffset);
    else if (nativeC)
        NzAZeroWeightKernel<false,true><<<workers,nullptr,stream>>>(x,w,scale,groups,y,(GM_ADDR)workspace,shape,ringOffset);
    else if (alignedRemainder) {
        if(e>workers)
            AlignedNzWeightKernel<true><<<workers,nullptr,stream>>>(x,w,scale,groups,y,
                (GM_ADDR)workspace,shape,ringOffset);
        else
            AlignedNzWeightKernel<false><<<workers,nullptr,stream>>>(x,w,scale,groups,y,
                (GM_ADDR)workspace,shape,ringOffset);
    // Existing NZ admission and all capacities above remain unchanged.
    // Four/five short-K panels use the same independent first-A overlap.
    } else if (k<=1344 && k%32!=0 && n>3*256 && n<=5*256) {
        if (workers <= 32 && l1 >= uint64_t(384) * kp + 4096 &&
            uint64_t(4) * 256 * shape.columnTiles <= uint64_t(5) * np) {
            if (e > workers)
                NzPanelResidentWeightKernel<true><<<workers,nullptr,stream>>>(x,w,scale,groups,y,
                    (GM_ADDR)workspace,shape,ringOffset);
            else
                NzPanelResidentWeightKernel<false><<<workers,nullptr,stream>>>(x,w,scale,groups,y,
                    (GM_ADDR)workspace,shape,ringOffset);
        } else {
        if (e > workers)
            NzAZeroWeightKernel<true><<<workers,nullptr,stream>>>(x,w,scale,groups,y,
                (GM_ADDR)workspace,shape,ringOffset);
        else
            NzAZeroWeightKernel<false><<<workers,nullptr,stream>>>(x,w,scale,groups,y,
                (GM_ADDR)workspace,shape,ringOffset);
        }
    } else if (e > workers)
        NzWeightKernel<true><<<workers, nullptr, stream>>>(x, w, scale, groups, y,
            (GM_ADDR)workspace, shape, ringOffset);
    else
        NzWeightKernel<false><<<workers, nullptr, stream>>>(x, w, scale, groups, y,
            (GM_ADDR)workspace, shape, ringOffset);
    const aclError error = aclrtSynchronizeStream(stream);
    const aclError freed = aclrtFree(workspace);
    if (error != ACL_SUCCESS || freed != ACL_SUCCESS)
        throw std::runtime_error("NZ weight kernel or cleanup failed");
    return true;
}
}



// N256 row and panel ownership, with direct and prefetch Cube paths.
namespace grouped_matmul_gelu {

// Included inside grouped_matmul_gelu after the generic Segments definition.
// Route selection shares the group's required prefix walk with the scheduler.
template <uint32_t Columns, bool LocalGroups, bool GroupsReady>
class Segments<20, Columns, LocalGroups, GroupsReady> {
    static_assert(Columns==256 || Columns==512,"routed panel scheduler width");
public:
    __aicore__ Segments(GM_ADDR address,Shape shape,uint32_t worker,uint32_t workers,
        AscendC::LocalTensor<int64_t> local={}) : s(shape), task(worker), step(workers) {
        groups.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(address));
        if constexpr(LocalGroups) {
            cached=local;
            if constexpr(!GroupsReady) {
                AscendC::GlobalTensor<uint8_t> bytes;
                bytes.SetGlobalBuffer(reinterpret_cast<__gm__ uint8_t*>(address));
                AscendC::DataCopyExtParams cp{1,uint32_t(s.experts*8),0,0,0};
                AscendC::DataCopyPadExtParams<uint8_t> pad{false,0,0,0};
                AscendC::DataCopyPad(cached.template ReinterpretCast<uint8_t>(),bytes,cp,pad);
                Fence<AscendC::HardEvent::MTE2_S>();
            }
        }

        uint32_t scanExpert=0,active=0,firstExpert=0;
        int64_t previous=0,end=GroupEnd(0),totalRows=0,firstEnd=0;
        bool located=false;
        const uint32_t activeLimit=workers/2;
        for(;;) {
            if(!FindPositive(scanExpert,previous,end))return;
            if(active==0) {firstExpert=scanExpert;firstEnd=end;}
            const int64_t count=(end-previous+63)/64;
            // This cursor is the same first row ordinal used by Segments<2>.
            // Preserve already-read boundaries if the route rejects later.
            if(!located && int64_t(worker)<totalRows+count) {
                SetPersistentCursor(scanExpert,previous,end,totalRows,totalRows+count);
                located=true;
            }
            totalRows+=count;
            if(end-previous<=64 || ++active>activeLimit) {
                if(!located)SetPersistentCursor(scanExpert,previous,end,totalRows-count,totalRows);
                return;
            }
            if(end==s.m) {
                flat=true;
                const int64_t panels=s.n/256,total=totalRows*panels;
                task=total*worker/workers;endTask=total*(worker+1)/workers;
                if(task>=endTask)return;
                int64_t ordinal=task/panels;
                expert=firstExpert;first=0;groupEnd=firstEnd;
                int64_t groupRows=(groupEnd+63)/64;
                while(ordinal>=groupRows) {
                    ordinal-=groupRows;first=groupEnd;
                    ++expert;groupEnd=GroupEnd(expert);
                    if(!FindPositive(expert,first,groupEnd))return;
                    groupRows=(groupEnd-first+63)/64;
                }
                row=first+ordinal*64;column=task%panels*256;
                return;
            }
            previous=end;++scanExpert;end=GroupEnd(scanExpert);
        }
    }

    __aicore__ bool IsFlat() const {return flat;}
    __aicore__ bool Next(Segment& out) {
        if constexpr(Columns==256) {
            if(pending) {out=child;pending=false;return true;}
        }
        if(flat) {
            if(task>=endTask)return false;
            out={int64_t(expert),row,column,uint32_t(groupEnd-row<64?groupEnd-row:64),256};
            ++task;
            if(task<endTask) {
                column+=256;
                if(column>=s.n) {
                    column=0;
                    row=groupEnd-row<64?groupEnd:row+64;
                    if(row>=groupEnd) {
                        first=groupEnd;++expert;groupEnd=GroupEnd(expert);
                        FindPositive(expert,first,groupEnd);
                    }
                }
            }
            return true;
        }
        if(column==0) {
            while(task>=prefixEnd) {
                if(++expert>=s.experts)return false;
                first=groupEnd;groupEnd=GroupEnd(expert);
                prefixStart=prefixEnd;
                prefixEnd+=(groupEnd-first+63)/64;
            }
            row=first+(task-prefixStart)*64;
        }
        out={int64_t(expert),row,column,uint32_t(groupEnd-row<64?groupEnd-row:64),
            uint32_t(s.n-column<512?s.n-column:512)};
        column+=512;
        if(column>=s.n) {column=0;task+=step;}
        if constexpr(Columns==256) {
            if(out.columns>256) {
                child=out;child.column+=256;child.columns-=256;
                out.columns=256;pending=true;
            }
        }
        return true;
    }
private:
    __aicore__ int64_t GroupEnd(uint32_t e) const {
        if constexpr(LocalGroups)return cached.GetValue(e);
        else return groups.GetValue(e);
    }
    __aicore__ bool FindPositive(uint32_t& e,int64_t previous,int64_t& end) const {
        if(end!=previous)return true;
        uint32_t lo=e+1,hi=uint32_t(s.experts);
        while(lo<hi) {
            const uint32_t mid=(lo+hi)/2;
            if(GroupEnd(mid)<=previous)lo=mid+1;
            else hi=mid;
        }
        if(lo>=s.experts)return false;
        e=lo;end=GroupEnd(e);return true;
    }
    __aicore__ void SetPersistentCursor(uint32_t e,int64_t begin,int64_t end,
        int64_t beginPrefix,int64_t endPrefix) {
        expert=e;first=begin;groupEnd=end;prefixStart=beginPrefix;prefixEnd=endPrefix;
    }
    Shape s;
    AscendC::GlobalTensor<int64_t> groups;
    AscendC::LocalTensor<int64_t> cached;
    int64_t task=0,step=0,endTask=0,first=0,groupEnd=0,prefixStart=0,prefixEnd=0,row=0,column=0;
    uint32_t expert=0;
    bool flat=false,pending=false;
    Segment child;
};

#if defined(__DAV_CUBE__)
__aicore__ inline void FusedRouteCube(GM_ADDR xAddress, GM_ADDR weightAddress,
    GM_ADDR groupsAddress, GM_ADDR workspace, Shape s, AscendC::TPipe& pipe)
{
    constexpr uint32_t Rows = 64, Columns = 512, OutputN = 256, PacketK = 256, MadK = 128;
    const uint32_t worker = AscendC::GetBlockIdx();
    AscendC::GlobalTensor<int8_t> x, weight;
    AscendC::GlobalTensor<int32_t> ring;
    x.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(xAddress));
    weight.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(weightAddress));
    ring.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(workspace) + worker * kSlots * kTileElements);
    AscendC::SetAtomicNone();
    AscendC::SetMMRowMajor();
    AscendC::SetLoadDataBoundary(uint64_t(0));
    AscendC::SetLoadDataPaddingValue(uint64_t(0));
    AscendC::TBuf<AscendC::TPosition::A1> resident;
    AscendC::TQue<AscendC::TPosition::B1, 2> bq;
    AscendC::TBuf<AscendC::TPosition::A2> ab;
    AscendC::TBuf<AscendC::TPosition::B2> bb;
    AscendC::TBuf<AscendC::TPosition::CO1> cb;
    pipe.InitBuffer(resident, Rows * s.residentK);
    pipe.InitBuffer(bq, 2, PacketK * Columns);
    pipe.InitBuffer(ab, 2 * Rows * MadK);
    pipe.InitBuffer(bb, 2 * OutputN * MadK);
    pipe.InitBuffer(cb, 2 * kL0CSlotElements * sizeof(int32_t));
    auto a1 = resident.Get<int8_t>();
    auto aAll = ab.Get<int8_t>();
    auto bAll = bb.Get<int8_t>();
    auto cAll = cb.Get<int32_t>();
    event_t free[2], ready[2], cFree[2];
    for (uint32_t i = 0; i < 2; ++i) {
        free[i] = static_cast<event_t>(pipe.AllocEventID<AscendC::HardEvent::M_MTE1>());
        ready[i] = static_cast<event_t>(pipe.AllocEventID<AscendC::HardEvent::MTE1_M>());
        cFree[i] = static_cast<event_t>(pipe.AllocEventID<AscendC::HardEvent::FIX_M>());
        AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(free[i]);
        AscendC::SetFlag<AscendC::HardEvent::FIX_M>(cFree[i]);
    }
    Segments<20, Columns> blocks(groupsAddress, s, worker, AscendC::GetBlockNum());
    const bool flat=blocks.IsFlat();
    Segment block;
    uint32_t sequence = 0, kSequence = 0;
    int64_t loadedRow = -1;
    while (blocks.Next(block)) {
        if (loadedRow != block.row) {
            LoadResidentRange(a1, x, s, block, 0, s.k);
            loadedRow = block.row;
        }
        const uint32_t mp = (block.rows + 15) / 16 * 16;
        const uint32_t np = (block.columns + 31) / 32 * 32;
        const uint32_t panels = (np + OutputN - 1) / OutputN;
        const uint32_t firstC = sequence & 1;
        for (uint32_t n = 0; n < panels; ++n)
            AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(cFree[(firstC + n) & 1]);
        CopyBPacket<PacketK>(bq, weight, s, block, 0, s.k);
        if (PacketK < s.k) CopyBPacket<PacketK>(bq, weight, s, block, PacketK, s.k);
        for (uint32_t packet = 0; packet < s.k; packet += PacketK) {
            const uint32_t end = s.k - packet < PacketK ? s.k : packet + PacketK;
            const uint32_t packetKp = (end - packet + 31) / 32 * 32;
            auto b1 = bq.DeQue<int8_t>();
            for (uint32_t k0 = packet; k0 < end; k0 += MadK, ++kSequence) {
                const uint32_t count = end - k0 < MadK ? end - k0 : MadK;
                const uint32_t kp = (count + 31) / 32 * 32;
                auto a2 = aAll[(kSequence & 1) * Rows * MadK];
                AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(free[flat?(kSequence&1):0]);
                AscendC::LoadData2DParams ap{};
                ap.repeatTimes = kp / 32; ap.srcStride = mp / 16;
                for (uint32_t m = 0; m < mp / 16; ++m)
                    AscendC::LoadData(a2[m * kp * 16], a1[k0 * mp + m * 512], ap);
                for (uint32_t n = 0; n < panels; ++n) {
                    const uint32_t operandSlot=flat?(kSequence&1):n;
                    if (n) AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(free[operandSlot]);
                    const uint32_t columns = np - n * OutputN < OutputN ? np - n * OutputN : OutputN;
                    auto b2 = bAll[operandSlot * OutputN * MadK];
                    AscendC::LoadData2dTransposeParams bp{};
                    bp.repeatTimes = columns / 32; bp.srcStride = packetKp / 32; bp.dstGap = 1;
                    for (uint32_t k = 0; k < kp / 32; ++k)
                        AscendC::LoadDataWithTranspose(b2[k * columns * 32],
                            b1[n * OutputN * packetKp + (k0 - packet) * 32 + k * 1024], bp);
                    if (k0 + MadK >= end && n + 1 == panels) {
                        bq.FreeTensor(b1);
                        if (packet + 2 * PacketK < s.k)
                            CopyBPacket<PacketK>(bq, weight, s, block, packet + 2 * PacketK, s.k);
                    }
                    AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(ready[operandSlot]);
                    AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(ready[operandSlot]);
                    const uint32_t cs = (firstC + n) & 1;
                    auto c = cAll[cs * kL0CSlotElements];
                    AscendC::MmadParams mm{};
                    mm.m = mp; mm.n = columns; mm.k = kp; mm.cmatrixInitVal = k0 == 0;
                    const bool last = k0 + MadK >= s.k;
                    mm.unitFlag = last ? 3 : 2;
                    AscendC::Mmad(c, a2, b2, mm);
                    if ((mm.m / 16) * (mm.n / 16) < 10) AscendC::PipeBarrier<PIPE_M>();
                    if (last) PublishPairedPanel<OutputN>(ring, c, mp, columns, sequence, cFree[cs]);
                    AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(free[operandSlot]);
                }
            }
        }
    }
    for (uint32_t i = 0; i < 2; ++i) {
        AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(free[i]);
        AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(cFree[i]);
        pipe.ReleaseEventID<AscendC::HardEvent::M_MTE1>(free[i]);
        pipe.ReleaseEventID<AscendC::HardEvent::MTE1_M>(ready[i]);
        pipe.ReleaseEventID<AscendC::HardEvent::FIX_M>(cFree[i]);
        AscendC::CrossCoreWaitFlag<2>(4 + i);
    }
}
#endif
__schedmode__(1) __global__ __mix__(1,2) void FusedRouteKernel(GM_ADDR x,GM_ADDR w,
    GM_ADDR scale,GM_ADDR groups,GM_ADDR y,GM_ADDR workspace,Shape shape) {
    AscendC::TPipe pipe;
#if defined(__DAV_CUBE__)
    FusedRouteCube(x,w,groups,workspace,shape,pipe);
#else
    VectorRun<20,64,256,32>(scale,groups,y,workspace,shape,pipe);
#endif
}

// Included inside grouped_matmul_gelu after the generic Segments definition.
// Route selection shares the group's required prefix walk with the scheduler.
template <uint32_t Columns, bool LocalGroups, bool GroupsReady>
class Segments<22, Columns, LocalGroups, GroupsReady> {
    static_assert(Columns==256 || Columns==512,"routed panel scheduler width");
public:
    __aicore__ Segments(GM_ADDR address,Shape shape,uint32_t worker,uint32_t workers,
        AscendC::LocalTensor<int64_t> local={}) : s(shape), task(worker), step(workers) {
        groups.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(address));
        if constexpr(LocalGroups) {
            cached=local;
            if constexpr(!GroupsReady) {
                AscendC::GlobalTensor<uint8_t> bytes;
                bytes.SetGlobalBuffer(reinterpret_cast<__gm__ uint8_t*>(address));
                AscendC::DataCopyExtParams cp{1,uint32_t(s.experts*8),0,0,0};
                AscendC::DataCopyPadExtParams<uint8_t> pad{false,0,0,0};
                AscendC::DataCopyPad(cached.template ReinterpretCast<uint8_t>(),bytes,cp,pad);
                Fence<AscendC::HardEvent::MTE2_S>();
            }
        }

        uint32_t scanExpert=0,active=0,firstExpert=0;
        int64_t previous=0,end=GroupEnd(0),totalRows=0,firstEnd=0;
        bool located=false;
        const uint32_t activeLimit=workers/2;
        for(;;) {
            if(!FindPositive(scanExpert,previous,end))return;
            if(active==0) {firstExpert=scanExpert;firstEnd=end;}
            const int64_t count=(end-previous+63)/64;
            // This cursor is the same first row ordinal used by Segments<2>.
            // Preserve already-read boundaries if the route rejects later.
            if(!located && int64_t(worker)<totalRows+count) {
                SetPersistentCursor(scanExpert,previous,end,totalRows,totalRows+count);
                located=true;
            }
            totalRows+=count;
            if(end-previous<=64 || ++active>activeLimit) {
                if(!located)SetPersistentCursor(scanExpert,previous,end,totalRows-count,totalRows);
                return;
            }
            if(end==s.m) {
                flat=true;
                const int64_t panels=s.n/256,total=totalRows*panels;
                task=total*worker/workers;endTask=total*(worker+1)/workers;
                if(task>=endTask)return;
                int64_t ordinal=task/panels;
                reverse=bool(ordinal&1);
                expert=firstExpert;first=0;groupEnd=firstEnd;
                int64_t groupRows=(groupEnd+63)/64;
                while(ordinal>=groupRows) {
                    ordinal-=groupRows;first=groupEnd;
                    ++expert;groupEnd=GroupEnd(expert);
                    if(!FindPositive(expert,first,groupEnd))return;
                    groupRows=(groupEnd-first+63)/64;
                }
                row=first+ordinal*64;column=task%panels*256;
                return;
            }
            previous=end;++scanExpert;end=GroupEnd(scanExpert);
        }
    }

    __aicore__ bool IsFlat() const {return flat;}
    __aicore__ bool Next(Segment& out) {
        if constexpr(Columns==256) {
            if(pending) {out=child;pending=false;return true;}
        }
        if(flat) {
            if(task>=endTask)return false;
            out={int64_t(expert),row,reverse?s.n-256-column:column,
                uint32_t(groupEnd-row<64?groupEnd-row:64),256};
            ++task;
            if(task<endTask) {
                column+=256;
                if(column>=s.n) {
                    column=0;reverse=!reverse;
                    row=groupEnd-row<64?groupEnd:row+64;
                    if(row>=groupEnd) {
                        first=groupEnd;++expert;groupEnd=GroupEnd(expert);
                        FindPositive(expert,first,groupEnd);
                    }
                }
            }
            return true;
        }
        if(column==0) {
            while(task>=prefixEnd) {
                if(++expert>=s.experts)return false;
                first=groupEnd;groupEnd=GroupEnd(expert);
                prefixStart=prefixEnd;
                prefixEnd+=(groupEnd-first+63)/64;
            }
            row=first+(task-prefixStart)*64;
        }
        out={int64_t(expert),row,column,uint32_t(groupEnd-row<64?groupEnd-row:64),
            uint32_t(s.n-column<512?s.n-column:512)};
        column+=512;
        if(column>=s.n) {column=0;task+=step;}
        if constexpr(Columns==256) {
            if(out.columns>256) {
                child=out;child.column+=256;child.columns-=256;
                out.columns=256;pending=true;
            }
        }
        return true;
    }
private:
    __aicore__ int64_t GroupEnd(uint32_t e) const {
        if constexpr(LocalGroups)return cached.GetValue(e);
        else return groups.GetValue(e);
    }
    __aicore__ bool FindPositive(uint32_t& e,int64_t previous,int64_t& end) const {
        if(end!=previous)return true;
        uint32_t lo=e+1,hi=uint32_t(s.experts);
        while(lo<hi) {
            const uint32_t mid=(lo+hi)/2;
            if(GroupEnd(mid)<=previous)lo=mid+1;
            else hi=mid;
        }
        if(lo>=s.experts)return false;
        e=lo;end=GroupEnd(e);return true;
    }
    __aicore__ void SetPersistentCursor(uint32_t e,int64_t begin,int64_t end,
        int64_t beginPrefix,int64_t endPrefix) {
        expert=e;first=begin;groupEnd=end;prefixStart=beginPrefix;prefixEnd=endPrefix;
    }
    Shape s;
    AscendC::GlobalTensor<int64_t> groups;
    AscendC::LocalTensor<int64_t> cached;
    int64_t task=0,step=0,endTask=0,first=0,groupEnd=0,prefixStart=0,prefixEnd=0,row=0,column=0;
    uint32_t expert=0;
    bool flat=false,pending=false,reverse=false;
    Segment child;
};

#if defined(__DAV_CUBE__)
// Four K256 packets of one N256 panel. The first two packet locations match
// the parent's two-slot N512 allocation; the gaps retain packets 2 and 3.
class SnakeBPanelCache {
    AscendC::LocalTensor<int8_t> base;
    event_t free[4],ready[4];uint32_t packets=0;
public:
    __aicore__ inline void Init(AscendC::TPipe& pipe,AscendC::LocalTensor<int8_t> buffer,uint32_t k) {
        base=buffer;packets=(k+255)/256;
        for(uint32_t p=0;p<packets;++p) {
            free[p]=static_cast<event_t>(pipe.AllocEventID<AscendC::HardEvent::MTE1_MTE2>());
            ready[p]=static_cast<event_t>(pipe.AllocEventID<AscendC::HardEvent::MTE2_MTE1>());
            AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(free[p]);
        }
    }
    __aicore__ inline AscendC::LocalTensor<int8_t> Alloc(uint32_t p) {
        AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(free[p]);
        return base[(p&1)*131072+(p>>1)*65536];
    }
    __aicore__ inline void EnQue(uint32_t p) {AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(ready[p]);}
    __aicore__ inline AscendC::LocalTensor<int8_t> DeQue(uint32_t p) {
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(ready[p]);
        return base[(p&1)*131072+(p>>1)*65536];
    }
    __aicore__ inline void Free(uint32_t p) {AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(free[p]);}
    __aicore__ inline void Drain(AscendC::TPipe& pipe) {
        for(uint32_t p=0;p<packets;++p) {
            AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(free[p]);
            pipe.ReleaseEventID<AscendC::HardEvent::MTE1_MTE2>(free[p]);
            pipe.ReleaseEventID<AscendC::HardEvent::MTE2_MTE1>(ready[p]);
        }
    }
};
template<uint32_t PacketK>
__aicore__ inline void CopySnakeBPacket(SnakeBPanelCache& cache,
    AscendC::GlobalTensor<int8_t> weight,Shape s,Segment segment,uint32_t start,uint32_t end,bool hot) {
    const uint32_t p=start/PacketK;
    auto b1=cache.Alloc(p);
    if(!hot) {
        const uint32_t count=end-start<PacketK?end-start:PacketK;
        const uint32_t kp=(count+31)/32*32;
        if(count!=kp) {
            AscendC::InitConstValueParams<uint16_t> zero{1,static_cast<uint16_t>(256*kp/32),0,0};
            AscendC::InitConstValue(b1.ReinterpretCast<uint16_t>(),zero);
            AscendC::PipeBarrier<PIPE_MTE2>();
        }
        AscendC::Nd2NzParams bp{};
        bp.ndNum=1;bp.nValue=count;bp.dValue=256;bp.srcDValue=s.n;
        bp.dstNzC0Stride=kp;bp.dstNzNStride=1;
        AscendC::DataCopy(b1,weight[segment.expert*s.k*s.n+start*s.n+segment.column],bp);
    }
    cache.EnQue(p);
}
#endif

#if defined(__DAV_CUBE__)
template<bool CacheB>
__aicore__ inline void SnakeA0Engine(GM_ADDR xAddress, GM_ADDR weightAddress,
    GM_ADDR groupsAddress, GM_ADDR workspace, Shape s, AscendC::TPipe& pipe, Segments<22,512>& blocks)
{
    constexpr uint32_t Rows = 64, Columns = 512, OutputN = 256, PacketK = 256, MadK = 128;
    const uint32_t worker = AscendC::GetBlockIdx();
    AscendC::GlobalTensor<int8_t> x, weight;
    AscendC::GlobalTensor<int32_t> ring;
    x.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(xAddress));
    weight.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(weightAddress));
    ring.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(workspace) + worker * kSlots * kTileElements);
    AscendC::SetAtomicNone();
    AscendC::SetMMRowMajor();
    AscendC::SetLoadDataBoundary(uint64_t(0));
    AscendC::SetLoadDataPaddingValue(uint64_t(0));
    AscendC::TBuf<AscendC::TPosition::A1> resident;
    AscendC::TQue<AscendC::TPosition::B1, 2> bq;
    AscendC::TBuf<AscendC::TPosition::B1> cacheBuffer;
    SnakeBPanelCache cache;
    AscendC::TBuf<AscendC::TPosition::A2> ab;
    AscendC::TBuf<AscendC::TPosition::B2> bb;
    AscendC::TBuf<AscendC::TPosition::CO1> cb;
    pipe.InitBuffer(resident, Rows * s.residentK);
    if constexpr(CacheB) {
        pipe.InitBuffer(cacheBuffer,2*PacketK*Columns);
        cache.Init(pipe,cacheBuffer.template Get<int8_t>(),s.k);
    } else pipe.InitBuffer(bq, 2, PacketK * Columns);
    pipe.InitBuffer(ab, Rows * s.residentK);
    pipe.InitBuffer(bb, 2 * OutputN * MadK);
    pipe.InitBuffer(cb, 2 * kL0CSlotElements * sizeof(int32_t));
    auto a1 = resident.Get<int8_t>();
    auto aAll = ab.Get<int8_t>();
    auto bAll = bb.Get<int8_t>();
    auto cAll = cb.Get<int32_t>();
    event_t free[2], ready[2], cFree[2];
    for (uint32_t i = 0; i < 2; ++i) {
        free[i] = static_cast<event_t>(pipe.AllocEventID<AscendC::HardEvent::M_MTE1>());
        ready[i] = static_cast<event_t>(pipe.AllocEventID<AscendC::HardEvent::MTE1_M>());
        cFree[i] = static_cast<event_t>(pipe.AllocEventID<AscendC::HardEvent::FIX_M>());
        AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(free[i]);
        AscendC::SetFlag<AscendC::HardEvent::FIX_M>(cFree[i]);
    }
    constexpr bool flat=CacheB;
    Segment block;
    uint32_t sequence = 0, kSequence = 0;
    int64_t loadedRow = -1, loadedExpert=-1, loadedColumn=-1;
    while (blocks.Next(block)) {
        const bool reuseA0 = loadedRow == block.row;
        if (!reuseA0) {
            LoadResidentRange(a1, x, s, block, 0, s.k);
            loadedRow = block.row;
        }
        const uint32_t mp = (block.rows + 15) / 16 * 16;
        const uint32_t np = (block.columns + 31) / 32 * 32;
        const uint32_t panels = (np + OutputN - 1) / OutputN;
        const uint32_t firstC = sequence & 1;
        for (uint32_t n = 0; n < panels; ++n)
            AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(cFree[(firstC + n) & 1]);
        const bool hot=CacheB && loadedExpert==block.expert && loadedColumn==block.column;
        loadedExpert=block.expert;loadedColumn=block.column;
        if constexpr(CacheB) {
            CopySnakeBPacket<PacketK>(cache,weight,s,block,0,s.k,hot);
            if(PacketK<s.k) CopySnakeBPacket<PacketK>(cache,weight,s,block,PacketK,s.k,hot);
        } else {
            CopyBPacket<PacketK>(bq, weight, s, block, 0, s.k);
            if (PacketK < s.k) CopyBPacket<PacketK>(bq, weight, s, block, PacketK, s.k);
        }
        for (uint32_t packet = 0; packet < s.k; packet += PacketK) {
            const uint32_t end = s.k - packet < PacketK ? s.k : packet + PacketK;
            const uint32_t packetKp = (end - packet + 31) / 32 * 32;
            AscendC::LocalTensor<int8_t> b1;
            if constexpr(CacheB)b1=cache.DeQue(packet/PacketK);
            else b1=bq.template DeQue<int8_t>();
            for (uint32_t k0 = packet; k0 < end; k0 += MadK, ++kSequence) {
                const uint32_t count = end - k0 < MadK ? end - k0 : MadK;
                const uint32_t kp = (count + 31) / 32 * 32;
                auto a2 = aAll[k0 * Rows];
                AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(free[flat?(kSequence&1):0]);
                if (!reuseA0) {
                AscendC::LoadData2DParams ap{};
                ap.repeatTimes = kp / 32; ap.srcStride = mp / 16;
                for (uint32_t m = 0; m < mp / 16; ++m)
                    AscendC::LoadData(a2[m * kp * 16], a1[k0 * mp + m * 512], ap);
                }
                for (uint32_t n = 0; n < panels; ++n) {
                    const uint32_t operandSlot=flat?(kSequence&1):n;
                    if (n) AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(free[operandSlot]);
                    const uint32_t columns = np - n * OutputN < OutputN ? np - n * OutputN : OutputN;
                    auto b2 = bAll[operandSlot * OutputN * MadK];
                    AscendC::LoadData2dTransposeParams bp{};
                    bp.repeatTimes = columns / 32; bp.srcStride = packetKp / 32; bp.dstGap = 1;
                    for (uint32_t k = 0; k < kp / 32; ++k)
                        AscendC::LoadDataWithTranspose(b2[k * columns * 32],
                            b1[n * OutputN * packetKp + (k0 - packet) * 32 + k * 1024], bp);
                    if (k0 + MadK >= end && n + 1 == panels) {
                        if constexpr(CacheB) {
                            cache.Free(packet/PacketK);
                            if(packet+2*PacketK<s.k)
                                CopySnakeBPacket<PacketK>(cache,weight,s,block,packet+2*PacketK,s.k,hot);
                        } else {
                            bq.FreeTensor(b1);
                            if (packet + 2 * PacketK < s.k)
                                CopyBPacket<PacketK>(bq, weight, s, block, packet + 2 * PacketK, s.k);
                        }
                    }
                    AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(ready[operandSlot]);
                    AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(ready[operandSlot]);
                    const uint32_t cs = (firstC + n) & 1;
                    auto c = cAll[cs * kL0CSlotElements];
                    AscendC::MmadParams mm{};
                    mm.m = mp; mm.n = columns; mm.k = kp; mm.cmatrixInitVal = k0 == 0;
                    const bool last = k0 + MadK >= s.k;
                    mm.unitFlag = last ? 3 : 2;
                    AscendC::Mmad(c, a2, b2, mm);
                    if ((mm.m / 16) * (mm.n / 16) < 10) AscendC::PipeBarrier<PIPE_M>();
                    if (last) PublishPairedPanel<OutputN>(ring, c, mp, columns, sequence, cFree[cs]);
                    AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(free[operandSlot]);
                }
            }
        }
    }
    if constexpr(CacheB)cache.Drain(pipe);
    for (uint32_t i = 0; i < 2; ++i) {
        AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(free[i]);
        AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(cFree[i]);
        pipe.ReleaseEventID<AscendC::HardEvent::M_MTE1>(free[i]);
        pipe.ReleaseEventID<AscendC::HardEvent::MTE1_M>(ready[i]);
        pipe.ReleaseEventID<AscendC::HardEvent::FIX_M>(cFree[i]);
        AscendC::CrossCoreWaitFlag<2>(4 + i);
    }
}
__aicore__ inline void SnakeRouteCube(GM_ADDR x,GM_ADDR w,GM_ADDR g,GM_ADDR workspace,
    Shape s,AscendC::TPipe& pipe) {
    Segments<22,512> blocks(g,s,AscendC::GetBlockIdx(),AscendC::GetBlockNum());
    if(blocks.IsFlat())SnakeA0Engine<true>(x,w,g,workspace,s,pipe,blocks);
    else SnakeA0Engine<false>(x,w,g,workspace,s,pipe,blocks);
}
#endif
__schedmode__(1) __global__ __mix__(1,2) void SnakeRouteKernel(GM_ADDR x,GM_ADDR w,
    GM_ADDR scale,GM_ADDR groups,GM_ADDR y,GM_ADDR workspace,Shape shape) {
    AscendC::TPipe pipe;
#if defined(__DAV_CUBE__)
    SnakeRouteCube(x,w,groups,workspace,shape,pipe);
#else
    VectorRun<22,64,256,32>(scale,groups,y,workspace,shape,pipe);
#endif
}

#if defined(__DAV_CUBE__)
template<uint32_t PacketK>
__aicore__ inline void CopySnakeStaggerCache(SnakeBPanelCache& cache,
    AscendC::GlobalTensor<int8_t> weight,Shape s,Segment block,uint32_t logical,uint32_t phase,bool hot) {
    uint32_t physical=logical+phase;if(physical>=uint32_t(s.k))physical-=s.k;
    CopySnakeBPacket<PacketK>(cache,weight,s,block,physical,physical+PacketK,hot);
}
template<uint32_t PacketK, bool WiderSinglePanel = false>
__aicore__ inline void CopySnakeStaggerQueue(AscendC::TQue<AscendC::TPosition::B1,2>& bq,
    AscendC::GlobalTensor<int8_t> weight,Shape s,Segment block,uint32_t logical,uint32_t phase,uint32_t packetK) {
    uint32_t physical=logical+phase;if(physical>=uint32_t(s.k))physical-=s.k;
    if constexpr (WiderSinglePanel)
        CopyBPacket<2 * PacketK>(bq,weight,s,block,physical,physical+packetK);
    else
        CopyBPacket<PacketK>(bq,weight,s,block,physical,physical+PacketK);
}
__aicore__ inline void PrefetchNextResidentRow(AscendC::LocalTensor<int8_t> destination,
    AscendC::GlobalTensor<int8_t> input, Shape shape, Segment next, event_t ready)
{
    const uint32_t mp = (next.rows + 15) / 16 * 16;
    Fence<AscendC::HardEvent::MTE1_MTE2>();
    if (next.rows != mp) {
        AscendC::InitConstValueParams<uint16_t> zero{1,
            static_cast<uint16_t>(mp * shape.residentK / 32), 0, 0};
        AscendC::InitConstValue(destination.ReinterpretCast<uint16_t>(), zero);
        AscendC::PipeBarrier<PIPE_MTE2>();
    }
    AscendC::Nd2NzParams copy{};
    copy.ndNum = 1;
    copy.nValue = next.rows;
    copy.dValue = shape.k;
    copy.srcDValue = shape.k;
    copy.dstNzC0Stride = mp;
    copy.dstNzNStride = 1;
    AscendC::DataCopy(destination, input[next.row * shape.k], copy);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(ready);
}

template<bool CacheB, bool WiderSinglePanel = false, bool PrefetchRows = false, bool PrefetchB = false, class Schedule>
__aicore__ inline void SnakeStaggerA0Engine(GM_ADDR xAddress, GM_ADDR weightAddress,
    GM_ADDR groupsAddress, GM_ADDR workspace, Shape s, AscendC::TPipe& pipe, Schedule& blocks)
{
    constexpr uint32_t Rows = 64, Columns = 512, OutputN = 256, PacketK = 256, MadK = 128;
    const uint32_t worker = AscendC::GetBlockIdx();
    AscendC::GlobalTensor<int8_t> x, weight;
    AscendC::GlobalTensor<int32_t> ring;
    x.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(xAddress));
    weight.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(weightAddress));
    ring.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(workspace) + worker * kSlots * kTileElements);
    AscendC::SetAtomicNone();
    AscendC::SetMMRowMajor();
    AscendC::SetLoadDataBoundary(uint64_t(0));
    AscendC::SetLoadDataPaddingValue(uint64_t(0));
    AscendC::TBuf<AscendC::TPosition::A1> resident;
    AscendC::TQue<AscendC::TPosition::B1, 2> bq;
    AscendC::TBuf<AscendC::TPosition::B1> cacheBuffer;
    SnakeBPanelCache cache;
    AscendC::TBuf<AscendC::TPosition::A2> ab;
    AscendC::TBuf<AscendC::TPosition::B2> bb;
    AscendC::TBuf<AscendC::TPosition::CO1> cb;
    const uint32_t residentSlotElements = Rows * s.residentK;
    pipe.InitBuffer(resident, (PrefetchRows ? 2 : 1) * residentSlotElements);
    if constexpr(CacheB) {
        pipe.InitBuffer(cacheBuffer,2*PacketK*Columns);
        cache.Init(pipe,cacheBuffer.template Get<int8_t>(),s.k);
    } else pipe.InitBuffer(bq, 2, PacketK * Columns);
    pipe.InitBuffer(ab, Rows * s.residentK);
    pipe.InitBuffer(bb, 2 * OutputN * MadK);
    pipe.InitBuffer(cb, 2 * kL0CSlotElements * sizeof(int32_t));
    auto aSlots = resident.Get<int8_t>();
    uint32_t aSlot = 0;
    event_t aReady{};
    if constexpr (PrefetchRows)
        aReady = static_cast<event_t>(pipe.AllocEventID<AscendC::HardEvent::MTE2_MTE1>());
    auto aAll = ab.Get<int8_t>();
    auto bAll = bb.Get<int8_t>();
    auto cAll = cb.Get<int32_t>();
    event_t free[2], ready[2], cFree[2];
    for (uint32_t i = 0; i < 2; ++i) {
        free[i] = static_cast<event_t>(pipe.AllocEventID<AscendC::HardEvent::M_MTE1>());
        ready[i] = static_cast<event_t>(pipe.AllocEventID<AscendC::HardEvent::MTE1_M>());
        cFree[i] = static_cast<event_t>(pipe.AllocEventID<AscendC::HardEvent::FIX_M>());
        AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(free[i]);
        AscendC::SetFlag<AscendC::HardEvent::FIX_M>(cFree[i]);
    }
    constexpr bool flat=CacheB;
    Segment block, next;
    uint32_t sequence = 0, kSequence = 0;
    int64_t loadedRow = -1, loadedExpert=-1, loadedColumn=-1;
    bool pendingA = false;
    bool pendingB = false;
    bool more = blocks.Next(block);
    while (more) {
        if constexpr (PrefetchRows) more = blocks.Next(next);
        const bool reuseA0 = loadedRow == block.row;
        if (!reuseA0) {
            if constexpr (PrefetchRows) {
                if (pendingA) {
                    AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(aReady);
                    aSlot ^= 1;
                    pendingA = false;
                } else {
                    LoadResidentRange(aSlots[aSlot * residentSlotElements], x, s, block, 0, s.k);
                }
            } else {
                LoadResidentRange(aSlots, x, s, block, 0, s.k);
            }
            loadedRow = block.row;
        }
        auto a1 = aSlots[aSlot * residentSlotElements];
        const uint32_t mp = (block.rows + 15) / 16 * 16;
        const uint32_t np = (block.columns + 31) / 32 * 32;
        const uint32_t panels = (np + OutputN - 1) / OutputN;
        const uint32_t packetK = WiderSinglePanel && panels == 1 && s.k % (2 * PacketK) == 0
            ? 2 * PacketK : PacketK;
        const uint32_t phase = (worker % (uint32_t(s.k) / packetK)) * packetK;
        const uint32_t firstC = sequence & 1;
        for (uint32_t n = 0; n < panels; ++n)
            AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(cFree[(firstC + n) & 1]);
        const bool hot=CacheB && loadedExpert==block.expert && loadedColumn==block.column;
        loadedExpert=block.expert;loadedColumn=block.column;
        if constexpr(CacheB) {
            CopySnakeStaggerCache<PacketK>(cache,weight,s,block,0,phase,hot);
            if(PacketK<s.k) CopySnakeStaggerCache<PacketK>(cache,weight,s,block,PacketK,phase,hot);
        } else {
            if (!PrefetchB || !pendingB)
                CopySnakeStaggerQueue<PacketK, WiderSinglePanel>(bq, weight, s, block, 0, phase, packetK);
            pendingB = false;
            if (packetK < s.k)
                CopySnakeStaggerQueue<PacketK, WiderSinglePanel>(bq, weight, s, block, packetK, phase, packetK);
        }
        if constexpr (PrefetchRows) {
            if (more && next.row != block.row && 2 * packetK >= s.k) {
                PrefetchNextResidentRow(aSlots[(aSlot ^ 1) * residentSlotElements], x, s, next, aReady);
                pendingA = true;
            }
        }
        for (uint32_t packet = 0; packet < s.k; packet += packetK) {
            uint32_t physicalPacket=packet+phase;
            if(physicalPacket>=uint32_t(s.k))physicalPacket-=s.k;
            const uint32_t end = s.k - packet < packetK ? s.k : packet + packetK;
            const uint32_t packetKp = (end - packet + 31) / 32 * 32;
            AscendC::LocalTensor<int8_t> b1;
            if constexpr(CacheB)b1=cache.DeQue(physicalPacket/PacketK);
            else b1=bq.template DeQue<int8_t>();
            for (uint32_t k0 = packet; k0 < end; k0 += MadK, ++kSequence) {
                const uint32_t count = end - k0 < MadK ? end - k0 : MadK;
                const uint32_t kp = (count + 31) / 32 * 32;
                const uint32_t physicalK=physicalPacket+(k0-packet);
                auto a2 = aAll[physicalK * Rows];
                AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(free[flat?(kSequence&1):0]);
                if (!reuseA0) {
                AscendC::LoadData2DParams ap{};
                ap.repeatTimes = kp / 32; ap.srcStride = mp / 16;
                for (uint32_t m = 0; m < mp / 16; ++m)
                    AscendC::LoadData(a2[m * kp * 16], a1[physicalK * mp + m * 512], ap);
                }
                for (uint32_t n = 0; n < panels; ++n) {
                    const uint32_t operandSlot=flat?(kSequence&1):n;
                    if (n) AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(free[operandSlot]);
                    const uint32_t columns = np - n * OutputN < OutputN ? np - n * OutputN : OutputN;
                    auto b2 = bAll[operandSlot * OutputN * MadK];
                    AscendC::LoadData2dTransposeParams bp{};
                    bp.repeatTimes = columns / 32; bp.srcStride = packetKp / 32; bp.dstGap = 1;
                    for (uint32_t k = 0; k < kp / 32; ++k)
                        AscendC::LoadDataWithTranspose(b2[k * columns * 32],
                            b1[n * OutputN * packetKp + (k0 - packet) * 32 + k * 1024], bp);
                    if (k0 + MadK >= end && n + 1 == panels) {
                        if constexpr(CacheB) {
                            cache.Free(physicalPacket/PacketK);
                            if(packet+2*PacketK<s.k)
                                CopySnakeStaggerCache<PacketK>(cache,weight,s,block,packet+2*PacketK,phase,hot);
                        } else {
                            bq.FreeTensor(b1);
                            if (packet + 2 * packetK < s.k) {
                                CopySnakeStaggerQueue<PacketK, WiderSinglePanel>(
                                    bq, weight, s, block, packet + 2 * packetK, phase, packetK);
                                if constexpr (PrefetchRows) {
                                    if (more && next.row != block.row && packet + 3 * packetK >= s.k) {
                                        PrefetchNextResidentRow(aSlots[(aSlot ^ 1) * residentSlotElements],
                                            x, s, next, aReady);
                                        pendingA = true;
                                    }
                                }
                            } else if constexpr (PrefetchB) {
                                // The current last B is already queued. Append the next tile's first B.
                                if (more && packet + packetK < s.k) {
                                    const uint32_t nextPacketK =
                                        WiderSinglePanel && next.columns <= OutputN && s.k % (2 * PacketK) == 0
                                        ? 2 * PacketK : PacketK;
                                    const uint32_t nextPhase = (worker % (uint32_t(s.k) / nextPacketK)) * nextPacketK;
                                    CopySnakeStaggerQueue<PacketK, WiderSinglePanel>(
                                        bq, weight, s, next, 0, nextPhase, nextPacketK);
                                    pendingB = true;
                                }
                            }
                        }
                    }
                    AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(ready[operandSlot]);
                    AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(ready[operandSlot]);
                    const uint32_t cs = (firstC + n) & 1;
                    auto c = cAll[cs * kL0CSlotElements];
                    AscendC::MmadParams mm{};
                    mm.m = mp; mm.n = columns; mm.k = kp; mm.cmatrixInitVal = k0 == 0;
                    const bool last = k0 + MadK >= s.k;
                    mm.unitFlag = last ? 3 : 2;
                    AscendC::Mmad(c, a2, b2, mm);
                    if ((mm.m / 16) * (mm.n / 16) < 10) AscendC::PipeBarrier<PIPE_M>();
                    if (last) PublishPairedPanel<OutputN>(ring, c, mp, columns, sequence, cFree[cs]);
                    AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(free[operandSlot]);
                }
            }
        }
        if constexpr (PrefetchRows) {
            if (more) block = next;
        } else {
            more = blocks.Next(block);
        }
    }
    if constexpr (PrefetchRows)
        pipe.ReleaseEventID<AscendC::HardEvent::MTE2_MTE1>(aReady);
    if constexpr(CacheB)cache.Drain(pipe);
    for (uint32_t i = 0; i < 2; ++i) {
        AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(free[i]);
        AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(cFree[i]);
        pipe.ReleaseEventID<AscendC::HardEvent::M_MTE1>(free[i]);
        pipe.ReleaseEventID<AscendC::HardEvent::MTE1_M>(ready[i]);
        pipe.ReleaseEventID<AscendC::HardEvent::FIX_M>(cFree[i]);
        AscendC::CrossCoreWaitFlag<2>(4 + i);
    }
}
__aicore__ inline void SnakeStaggerCube(GM_ADDR x,GM_ADDR w,GM_ADDR g,GM_ADDR workspace,
    Shape s,AscendC::TPipe& pipe) {
    Segments<22,512> blocks(g,s,AscendC::GetBlockIdx(),AscendC::GetBlockNum());
    if(blocks.IsFlat())SnakeStaggerA0Engine<true>(x,w,g,workspace,s,pipe,blocks);
    else SnakeStaggerA0Engine<false>(x,w,g,workspace,s,pipe,blocks);
}
#endif
__schedmode__(1) __global__ __mix__(1,2) void SnakeStaggerKernel(GM_ADDR x,GM_ADDR w,
    GM_ADDR scale,GM_ADDR groups,GM_ADDR y,GM_ADDR workspace,Shape shape) {
    AscendC::TPipe pipe;
#if defined(__DAV_CUBE__)
    SnakeStaggerCube(x,w,groups,workspace,shape,pipe);
#else
    VectorRun<22,64,256,32>(scale,groups,y,workspace,shape,pipe);
#endif
}

#ifdef __DAV_CUBE__
class ContiguousPanelPairs {
public:
    __aicore__ ContiguousPanelPairs(GM_ADDR groups, Shape shape, uint32_t worker, uint32_t workers)
        : panels(groups, shape, worker, workers) {}

    __aicore__ bool Next(Segment& block)
    {
        if (hasPending) {
            block = pending;
            hasPending = false;
        } else if (!panels.Next(block)) {
            return false;
        }

        if (block.column % 512 || !panels.Next(pending)) return true;
        if (pending.expert == block.expert && pending.row == block.row &&
            pending.column == block.column + 256) {
            block.columns += pending.columns;
        } else {
            hasPending = true;
        }
        return true;
    }

private:
    Segments<1, 256> panels;
    Segment pending;
    bool hasPending = false;
};
#endif

__schedmode__(1) __global__ __mix__(1, 2) void NextOperandPanelPairKernel(GM_ADDR x,
    GM_ADDR weight, GM_ADDR scale, GM_ADDR groups, GM_ADDR y, GM_ADDR workspace, Shape shape)
{
    AscendC::TPipe pipe;
#ifdef __DAV_CUBE__
    ContiguousPanelPairs blocks(groups, shape, AscendC::GetBlockIdx(), AscendC::GetBlockNum());
    SnakeStaggerA0Engine<false, true, true, true>(x, weight, groups, workspace, shape, pipe, blocks);
#else
    VectorRun<1, 64, 256, 32>(scale, groups, y, workspace, shape, pipe);
#endif
}

inline bool TryFlatN256(GM_ADDR x,GM_ADDR w,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,
    uint32_t e,uint32_t m,uint32_t k,uint32_t n,int64_t available,aclrtStream stream,
    kernel_common::HostPlatform& platform) {
    const uint32_t workers=std::min<int64_t>(available,std::min(platform.GetCoreNumAic(),platform.GetCoreNumAiv()/2));
    if(!workers || e<=workers || m<512 || uint64_t(m)<uint64_t(64)*e || uint64_t(m)>=uint64_t(128)*e ||
        k<=512 || k>1024 || n<512 || n>1024 || n%512!=256)return false;
    const uint32_t kp=(k+31)/32*32;
    uint64_t l1=0,l0a=0,l0b=0,l0c=0,ub=0;
    platform.GetCoreMemSize(platform_ascendc::CoreMemType::L1,l1);
    platform.GetCoreMemSize(platform_ascendc::CoreMemType::L0_A,l0a);
    platform.GetCoreMemSize(platform_ascendc::CoreMemType::L0_B,l0b);
    platform.GetCoreMemSize(platform_ascendc::CoreMemType::L0_C,l0c);
    platform.GetCoreMemSize(platform_ascendc::CoreMemType::UB,ub);
    if(l1<uint64_t(64)*kp+2*256*512+4096 || l0a<16384 || l0b<65536 || l0c<131072 || ub<120*1024)return false;
    Shape sh{m,k,n,e,n/256,kp,64,128,0,0,0};
    void* workspace=nullptr;
    if(aclrtMalloc(&workspace,uint64_t(workers)*kSlots*kTileElements*4,ACL_MEM_MALLOC_HUGE_FIRST)!=ACL_SUCCESS)
        throw std::runtime_error("Flat N256 workspace allocation failed");
    if (l0a >= uint64_t(64) * kp) {
        const uint64_t rowTiles = (uint64_t(m) + 63) / 64;
        const uint64_t panels = n / 256;
        const uint64_t wholeRowMax = ((rowTiles + workers - 1) / workers) * panels;
        const uint64_t panelMax = (rowTiles * panels + workers - 1) / workers;
        if (k % 512 == 0 && panelMax < wholeRowMax && l1 >= uint64_t(128) * kp + 2 * 256 * 512 + 4096)
            NextOperandPanelPairKernel<<<workers,nullptr,stream>>>(x,w,scale,groups,y,(GM_ADDR)workspace,sh);
        else if(k%256==0)
            SnakeStaggerKernel<<<workers,nullptr,stream>>>(x,w,scale,groups,y,(GM_ADDR)workspace,sh);
        else
            SnakeRouteKernel<<<workers,nullptr,stream>>>(x,w,scale,groups,y,(GM_ADDR)workspace,sh);
    }
    else
        FusedRouteKernel<<<workers,nullptr,stream>>>(x,w,scale,groups,y,(GM_ADDR)workspace,sh);
    const aclError err=aclrtSynchronizeStream(stream),freed=aclrtFree(workspace);
    if(err!=ACL_SUCCESS || freed!=ACL_SUCCESS)throw std::runtime_error("Flat N256 kernel failed");
    return true;
}
}



// Whole K256 tail rotation and paired narrow/wide output.
namespace grouped_matmul_gelu {
#ifdef __DAV_CUBE__
template<uint32_t PacketK>
__aicore__ inline void CopyStaggerBPacket(ArenaBPipe& bq,AscendC::GlobalTensor<int8_t> w,
    Shape s,Segment block,uint32_t start,uint32_t end,uint32_t phase) {
    uint32_t physical=start+phase;if(physical>=uint32_t(s.k))physical-=s.k;
    CopyTailBPacket<PacketK>(bq,w,s,block,physical,physical+PacketK);
}
template<uint32_t PacketK>
__aicore__ inline void StaggerEarlyBlock(ArenaBPipe& bq,
    AscendC::GlobalTensor<int8_t> weight, AscendC::GlobalTensor<int32_t> ring,
    Shape s, Segment block, AscendC::LocalTensor<int8_t> a1,
    AscendC::LocalTensor<int8_t> aAll, AscendC::LocalTensor<int8_t> bAll,
    AscendC::LocalTensor<int32_t> cAll, event_t (&free)[2], event_t (&ready)[2],
    event_t (&cFree)[2], uint32_t& sequence, uint32_t& kSequence)
{
    constexpr uint32_t Columns = 256, MadK = 128;
    const uint32_t phase=(AscendC::GetBlockIdx()%(uint32_t(s.k)/PacketK))*PacketK;
        const uint32_t mp = (block.rows + 15) / 16 * 16;
        const uint32_t np = (block.columns + 31) / 32 * 32;
        const uint32_t firstM = mp < 64 ? mp : 64;
        const uint32_t secondM = mp > 64 ? mp - 64 : 0;
        const uint32_t cs = sequence & 1, cs2 = (sequence + 1) & 1;
        auto c0 = cAll[cs * kL0CSlotElements];
        auto c1 = cAll[cs2 * kL0CSlotElements];
        AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(cFree[cs]);
        if (secondM) AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(cFree[cs2]);
        CopyStaggerBPacket<PacketK>(bq, weight, s, block, 0, s.k, phase);
        if (PacketK < s.k) CopyStaggerBPacket<PacketK>(bq, weight, s, block, PacketK, s.k, phase);
        for (uint32_t packet = 0; packet < s.k; packet += PacketK) {
            const uint32_t end = s.k - packet < PacketK ? s.k : packet + PacketK;
            const uint32_t packetKp = (end - packet + 31) / 32 * 32;
            auto b1 = bq.DeQue();
            for (uint32_t k0 = packet; k0 < end; k0 += MadK, ++kSequence) {
                const uint32_t count = end - k0 < MadK ? end - k0 : MadK;
                const uint32_t kp = (count + 31) / 32 * 32;
                const uint32_t ks = kSequence & 1;
                auto a2 = aAll[ks * 192 * MadK];
                auto b2 = bAll[ks * Columns * MadK];
                AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(free[ks]);
                uint32_t physicalK=k0+phase;if(physicalK>=uint32_t(s.k))physicalK-=s.k;
                AscendC::LoadData2DParams ap{};
                ap.repeatTimes = kp / 32; ap.srcStride = mp / 16;
                for (uint32_t m = 0; m < mp / 16; ++m)
                    AscendC::LoadData(a2[m * kp * 16], a1[physicalK * mp + m * 512], ap);
                AscendC::LoadData2dTransposeParams bp{};
                bp.repeatTimes = np / 32; bp.srcStride = packetKp / 32; bp.dstGap = 1;
                for (uint32_t k = 0; k < kp / 32; ++k)
                    AscendC::LoadDataWithTranspose(b2[k * np * 32], b1[(k0 - packet) * 32 + k * 1024], bp);
                if (k0 + MadK >= end) {
                    bq.FreeTensor(b1);
                    if (packet + 2 * PacketK < s.k)
                        CopyStaggerBPacket<PacketK>(bq, weight, s, block, packet + 2 * PacketK, s.k, phase);
                }
                AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(ready[ks]);
                AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(ready[ks]);
                AscendC::MmadParams mm{};
                mm.m = firstM; mm.n = np; mm.k = kp; mm.cmatrixInitVal = k0 == 0; // k0 is logical traversal position, not physical K.
                const bool last = k0 + MadK >= s.k;
                mm.unitFlag = last ? 3 : 2;
                AscendC::Mmad(c0, a2, b2, mm);
                if ((mm.m / 16) * (mm.n / 16) < 10) AscendC::PipeBarrier<PIPE_M>();
                if (last) PublishTailPanel(ring, c0, firstM, np, sequence, cFree[cs]);
                if (secondM) {
                    mm.m = secondM;
                    AscendC::Mmad(c1, a2[64 * kp], b2, mm);
                    if ((mm.m / 16) * (mm.n / 16) < 10) AscendC::PipeBarrier<PIPE_M>();
                    if (last) PublishTailPanel(ring, c1, secondM, np, sequence, cFree[cs2]);
                }
                // Both MAD consumers retire before either shared L0 slot is reused.
                AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(free[ks]);
            }
        }
}

#endif
}

namespace grouped_matmul_gelu {

// Only a final M128 plus 1..64 rows is coalesced; no fixed group assumptions.
template<bool LocalGroups=false,bool GroupsReady=false>
class TailRotateMacroSegments {
    AscendC::GlobalTensor<int64_t> groups;
    AscendC::LocalTensor<int64_t> cached;
    uint32_t experts=0,n=0,current=0,limit=0;
    bool mixed=false;
    uint32_t rotationBegin=0,rotationPivot=0;bool rotationPending=false;
    uint32_t singleRows=0,mixedRows=0,cachedMixed=~uint32_t(0),mixedExpert=0,mixedRow=0,mixedCount=0;
    bool weighted=true,mergeEnabled=true;
    uint32_t transferWeight=4,tailLimit=64;
    uint32_t expert=0,groupEnd=0,row=0,column=0;
    __aicore__ inline uint32_t End(uint32_t e) {
        if constexpr(LocalGroups) return uint32_t(cached.GetValue(e));
        else return uint32_t(groups.GetValue(e));
    }
    __aicore__ inline uint32_t Weight(uint32_t rows,uint32_t columns) {
        return weighted?16+(((rows+15)>>4)+transferWeight)*((columns+31)>>5)+(rows>128?16:0):1;
    }
    __aicore__ inline uint32_t RowWeight(uint32_t rows) {
        return (n>>8)*Weight(rows,256)+((n&255)?Weight(rows,n&255):0);
    }
    __aicore__ inline void Decompose(uint32_t rows,uint32_t& full,uint32_t& tail) {
        full=rows>>7;tail=rows&127;
        if(mergeEnabled && full && tail && tail<=tailLimit) {--full;tail+=128;}
    }
    __aicore__ inline uint32_t GroupWeight(uint32_t rows) {
        uint32_t full,tail;Decompose(rows,full,tail);
        return full*RowWeight(128)+(tail?RowWeight(tail):0);
    }
    __aicore__ inline uint32_t Locate(uint32_t rows,uint32_t target,
        uint32_t& relativeRow,uint32_t& firstColumn) {
        uint32_t full,tail;Decompose(rows,full,tail);
        const uint32_t fullRowWeight=RowWeight(128),fullWeight=full*fullRowWeight;
        const uint32_t ordinal=target<fullWeight?target/fullRowWeight:full;
        const uint32_t tileRows=ordinal<full?128:tail;
        const uint32_t base=ordinal*fullRowWeight,within=target-base;
        const uint32_t tileWeight=Weight(tileRows,256),nFull=n>>8;
        const uint32_t col=within<nFull*tileWeight?within/tileWeight:nFull;
        relativeRow=ordinal*128;firstColumn=col*256;
        return base+col*tileWeight;
    }
    __aicore__ inline void LocateMixed(uint32_t ordinal) {
            if(ordinal!=cachedMixed) {
                const uint32_t before=(ordinal*singleRows+mixedRows/2)/mixedRows;
                const bool single=((ordinal+1)*singleRows+mixedRows/2)/mixedRows!=before;
                uint32_t target=single?before:ordinal-before,previous=0;
                for(uint32_t e=0;e<experts;++e) {
                    const uint32_t end=End(e),rows=end-previous;
                    const uint32_t count=single?uint32_t(rows>0 && rows<=128):
                        (rows>128?(rows+127)/128:0);
                    if(target<count) {
                        mixedExpert=e;mixedRow=previous+target*128;
                        mixedCount=end-mixedRow<128?end-mixedRow:128;
                        break;
                    }
                    target-=count;previous=end;
                }
                cachedMixed=ordinal;
            }
    }

public:
    __aicore__ TailRotateMacroSegments(GM_ADDR address,Shape shape,uint32_t worker,
        uint32_t workers,AscendC::LocalTensor<int64_t> local={}) {
        experts=uint32_t(shape.experts);n=uint32_t(shape.n);tailLimit=(n&31)?64:32;
        groups.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(address));
        if constexpr(LocalGroups) {
            cached=local;
            if constexpr(!GroupsReady) {
                AscendC::GlobalTensor<uint8_t> bytes;
                bytes.SetGlobalBuffer(reinterpret_cast<__gm__ uint8_t*>(address));
                AscendC::DataCopyExtParams cp{1,experts*uint32_t(sizeof(int64_t)),0,0,0};
                AscendC::DataCopyPadExtParams<uint8_t> pad{false,0,0,0};
                AscendC::DataCopyPad(cached.ReinterpretCast<uint8_t>(),bytes,cp,pad);
                Fence<AscendC::HardEvent::MTE2_S>();
            }
        }
        uint32_t total=0,previous=0,originalRows=0,mergeCount=0;bool hasTiny=false;
        for(uint32_t e=0;e<experts;++e) {
            const uint32_t end=End(e),rows=end-previous;
            total+=GroupWeight(rows);originalRows+=(rows+127)>>7;
            singleRows+=rows>0 && rows<=128;
            const uint32_t tail=rows&127;
            mergeCount+=rows>128 && tail && tail<=tailLimit;
            hasTiny=hasTiny || (rows && rows<64);
            previous=end;
        }
        if(!mergeCount || mergeCount*8<originalRows) {
            mergeEnabled=false;weighted=false;total=originalRows*((n+255)>>8);
        }
        else if(hasTiny || (n&31)) {
            transferWeight=24;total+=20*(originalRows-mergeCount)*((n+31)>>5);
        }
        if(!mergeEnabled && !(n&255) && singleRows && singleRows<originalRows) {
            mixed=true;mixedRows=originalRows;
            current=total*worker/workers;limit=total*(worker+1)/workers;
            // Move a final two-frame row run before the preceding one-frame run.
            // The two half-open ranges partition exactly this worker's original interval.
            if(current<limit) {
                const uint32_t columns=n>>8,lastOrdinal=(limit-1)/columns;
                if(current/columns<lastOrdinal) {
                    LocateMixed(lastOrdinal-1);const bool shortPredecessor=mixedCount<=64;
                    LocateMixed(lastOrdinal);
                    if(shortPredecessor && mixedCount>64) {
                        rotationBegin=current;rotationPivot=lastOrdinal*columns;
                        current=rotationPivot;rotationPending=true;
                    }
                }
            }
            return;
        }
        if(!total) return;
        const uint32_t low=total*worker/workers,high=total*(worker+1)/workers;
        limit=total;previous=0;uint32_t prefix=0;bool located=false;
        for(uint32_t e=0;e<experts;++e) {
            const uint32_t end=End(e),rows=end-previous,weight=GroupWeight(rows);
            if(!located && low<prefix+weight) {
                uint32_t r=0,c=0;current=prefix+Locate(rows,low-prefix,r,c);
                expert=e;groupEnd=end;row=previous+r;column=c;located=true;
            }
            if(high<prefix+weight) {
                uint32_t r=0,c=0;limit=prefix+Locate(rows,high-prefix,r,c);break;
            }
            if(located && high==total) break;
            prefix+=weight;previous=end;
        }
    }
    __aicore__ inline bool Next(Segment& out) {
        if(current>=limit) {
            if(!rotationPending) return false;
            current=rotationBegin;limit=rotationPivot;rotationPending=false;
        }
        if(mixed) {
            const uint32_t columns=n>>8,ordinal=current/columns;
            LocateMixed(ordinal);
            out={mixedExpert,mixedRow,(current%columns)*256,mixedCount,256};
            ++current;return true;
        }
        const uint32_t remaining=groupEnd-row;
        // A 193..255 remainder retains M128 + its long tail.
        const uint32_t actual=mergeEnabled && remaining<=128+tailLimit?remaining:(remaining<128?remaining:128);
        const uint32_t columns=n-column<256?n-column:256;
        out={expert,row,column,actual,columns};current+=Weight(actual,columns);
        column+=256;
        if(column>=n) {
            column=0;row+=actual;
            if(row>=groupEnd && current<limit) {
                do {
                    row=groupEnd;
                    if(++expert>=experts) {current=limit;return true;}
                    groupEnd=End(expert);
                } while(row==groupEnd);
            }
        }
        return true;
    }
};

template<bool LocalGroups,bool GroupsReady>
class Segments<29,256,LocalGroups,GroupsReady> {
    TailRotateMacroSegments<LocalGroups,GroupsReady> base;
    Segment pending{};
    uint32_t remaining=0;
public:
    __aicore__ Segments(GM_ADDR address,Shape shape,uint32_t worker,uint32_t workers,
        AscendC::LocalTensor<int64_t> local={}) :base(address,shape,worker,workers,local) {}
    __aicore__ inline bool Next(Segment& out) {
        if(!remaining) {
            if(!base.Next(pending)) return false;
            remaining=pending.rows;
        }
        out=pending;out.rows=remaining<64?remaining:64;
        remaining-=out.rows;pending.row+=out.rows;
        return true;
    }
};

// Included inside grouped_matmul_gelu, after the retained TailRotate entry.
#ifdef __DAV_CUBE__
__aicore__ inline void TailPairNBlock(ArenaBPipe& bq,
    AscendC::GlobalTensor<int8_t> weight,AscendC::GlobalTensor<int32_t> ring,
    Shape s,Segment block,AscendC::LocalTensor<int8_t> a1,
    AscendC::LocalTensor<int8_t> aAll,AscendC::LocalTensor<int8_t> bAll,
    AscendC::LocalTensor<int32_t> cAll,event_t (&free)[2],event_t (&ready)[2],
    event_t (&cFree)[2],uint32_t& sequence,uint32_t& kSequence) {
    // Two complete N256 macros, sharing at most 64 resident rows.
    // K64 keeps two N512 L0B slices within the existing 65536-byte buffer.
    constexpr uint32_t Columns=512,OutputN=256,PacketK=256,MadK=64;
    const uint32_t mp=(block.rows+15)/16*16;
    const uint32_t phase=(AscendC::GetBlockIdx()%(uint32_t(s.k)/PacketK))*PacketK;
    AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(cFree[0]);
    AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(cFree[1]);
    CopyStaggerBPacket<PacketK>(bq,weight,s,block,0,s.k,phase);
    CopyStaggerBPacket<PacketK>(bq,weight,s,block,PacketK,s.k,phase);
    for(uint32_t packet=0;packet<s.k;packet+=PacketK) {
        auto b1=bq.DeQue();
        for(uint32_t k0=packet;k0<packet+PacketK;k0+=MadK,++kSequence) {
            const uint32_t ks=kSequence&1;
            // Keep the original physical slot boundaries across helper changes.
            auto a2=aAll[ks*192*128];auto b2=bAll[ks*Columns*MadK];
            AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(free[ks]);
            uint32_t physicalK=k0+phase;
            if(physicalK>=uint32_t(s.k)) physicalK-=s.k;
            AscendC::LoadData2DParams ap{};
            ap.repeatTimes=MadK/32;ap.srcStride=mp/16;
            for(uint32_t m=0;m<mp/16;++m)
                AscendC::LoadData(a2[m*MadK*16],a1[physicalK*mp+m*512],ap);
            AscendC::LoadData2dTransposeParams bp{};
            bp.repeatTimes=Columns/32;bp.srcStride=PacketK/32;bp.dstGap=1;
            for(uint32_t k=0;k<MadK/32;++k)
                AscendC::LoadDataWithTranspose(b2[k*Columns*32],
                    b1[(k0-packet)*32+k*1024],bp);
            if(k0+MadK==packet+PacketK) {
                bq.FreeTensor(b1);
                if(packet+2*PacketK<uint32_t(s.k))
                    CopyStaggerBPacket<PacketK>(bq,weight,s,block,
                        packet+2*PacketK,s.k,phase);
            }
            AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(ready[ks]);
            AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(ready[ks]);
            AscendC::MmadParams mm{};
            mm.m=mp;mm.n=Columns;mm.k=MadK;mm.cmatrixInitVal=k0==0;
            mm.unitFlag=k0+MadK>=s.k?3:2;
            AscendC::Mmad(cAll,a2,b2,mm);
            if((mp/16)*(Columns/16)<10) AscendC::PipeBarrier<PIPE_M>();
            AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(free[ks]);
        }
    }
    // The N512 NZ accumulator spans both old C slots. Publish two complete
    // N256 frames in the unchanged Vector order, then return BOTH C credits.
    for(uint32_t panel=0;panel<2;++panel) {
        const uint32_t slot=sequence++&3;
        AscendC::CrossCoreWaitFlag<2>(4+slot);
        AscendC::FixpipeParamsV220 fp{};
        fp.unitFlag=3;fp.nSize=OutputN;fp.mSize=mp;
        fp.srcStride=mp;fp.dstStride=OutputN;
        AscendC::Fixpipe(ring[slot*kTileElements],cAll[panel*OutputN*mp],fp);
        AscendC::CrossCoreSetFlag<2,PIPE_FIX>(slot);
    }
    AscendC::SetFlag<AscendC::HardEvent::FIX_M>(cFree[0]);
    AscendC::SetFlag<AscendC::HardEvent::FIX_M>(cFree[1]);
}

__aicore__ inline void TailPairNCube(GM_ADDR xa,GM_ADDR wa,GM_ADDR ga,
    GM_ADDR workspace,Shape s,AscendC::TPipe& pipe) {
    AscendC::GlobalTensor<int8_t> x,w;AscendC::GlobalTensor<int32_t> ring;
    x.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(xa));
    w.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(wa));
    ring.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(workspace)+AscendC::GetBlockIdx()*4*kTileElements);
    AscendC::SetAtomicNone();AscendC::SetMMRowMajor();
    AscendC::SetLoadDataBoundary(uint64_t(0));AscendC::SetLoadDataPaddingValue(uint64_t(0));
    AscendC::TBuf<AscendC::TPosition::A1> arena;
    AscendC::TBuf<AscendC::TPosition::A2> ab;
    AscendC::TBuf<AscendC::TPosition::B2> bb;
    AscendC::TBuf<AscendC::TPosition::CO1> cb;
    const uint32_t oldBytes=128*s.residentK+2*256*256;
    const uint32_t wideBytes=192*s.residentK+2*256*128;
    // The pair region is 64*K+2*256*512, <= wideBytes for admitted K>=1536.
    pipe.InitBuffer(arena,oldBytes>wideBytes?oldBytes:wideBytes);
    pipe.InitBuffer(ab,2*192*128);pipe.InitBuffer(bb,2*256*128);
    pipe.InitBuffer(cb,2*kL0CSlotElements*sizeof(int32_t));
    auto a1=arena.Get<int8_t>();auto aAll=ab.Get<int8_t>();
    auto bAll=bb.Get<int8_t>();auto cAll=cb.Get<int32_t>();
    ArenaBPipe bq;bq.Init(pipe);
    event_t free[2],ready[2],cFree[2];
    for(uint32_t i=0;i<2;++i) {
        free[i]=static_cast<event_t>(pipe.AllocEventID<AscendC::HardEvent::M_MTE1>());
        ready[i]=static_cast<event_t>(pipe.AllocEventID<AscendC::HardEvent::MTE1_M>());
        cFree[i]=static_cast<event_t>(pipe.AllocEventID<AscendC::HardEvent::FIX_M>());
        AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(free[i]);
        AscendC::SetFlag<AscendC::HardEvent::FIX_M>(cFree[i]);
    }
    TailRotateMacroSegments<> blocks(ga,s,AscendC::GetBlockIdx(),AscendC::GetBlockNum());
    Segment block{},following{};int64_t loadedRow=-1;
    uint32_t sequence=0,kSequence=0;bool previousPair=false;
    bool hasBlock=blocks.Next(block);
    while(hasBlock) {
        // Large blocks retain the original issue path, with no extra Next/scan.
        const bool small=block.rows<=64;
        const bool hasFollowing=small && blocks.Next(following);
        const bool pair=hasFollowing && block.columns==256 && following.columns==256 &&
            following.expert==block.expert && following.row==block.row &&
            following.rows==block.rows && following.column==block.column+256;
        if(loadedRow!=block.row) {
            const uint32_t mp=(block.rows+15)/16*16;
            Fence<AscendC::HardEvent::MTE1_MTE2>();
            kernel_common::ZeroNzRows(a1,block.rows,mp,s.residentK);
            AscendC::Nd2NzParams cp{};cp.ndNum=1;cp.nValue=block.rows;cp.dValue=s.k;
            cp.srcDValue=s.k;cp.dstNzC0Stride=mp;cp.dstNzNStride=1;
            AscendC::DataCopy(a1,x[block.row*s.k],cp);
            Fence<AscendC::HardEvent::MTE2_MTE1>();loadedRow=block.row;
        } else if(pair!=previousPair) {
            // Rebased B slots can overlap the OTHER old physical slot. Its
            // reads must retire even if AllocTensor waits a different credit.
            Fence<AscendC::HardEvent::MTE1_MTE2>();
        }
        if(pair) {
            Segment combined=block;combined.columns=512;
            bq.Reset(a1[64*s.residentK],256*512);
            TailPairNBlock(bq,w,ring,s,combined,a1,aAll,bAll,cAll,
                free,ready,cFree,sequence,kSequence);
        } else if(block.rows>128) {
            TailWideBlock(bq,w,ring,s,block,a1,aAll,bAll,cAll,
                free,ready,cFree,sequence,kSequence);
        } else {
            bq.Reset(a1[128*s.residentK],256*256);
            StaggerEarlyBlock<256>(bq,w,ring,s,block,a1,aAll,bAll,cAll,
                free,ready,cFree,sequence,kSequence);
        }
        previousPair=pair;
        // An unpaired lookahead remains pending; a paired one was just consumed.
        if(small && !pair) {block=following;hasBlock=hasFollowing;}
        else hasBlock=blocks.Next(block);
    }
    bq.Drain(pipe);
    for(uint32_t i=0;i<2;++i) {
        AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(free[i]);
        AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(cFree[i]);
        pipe.ReleaseEventID<AscendC::HardEvent::M_MTE1>(free[i]);
        pipe.ReleaseEventID<AscendC::HardEvent::MTE1_M>(ready[i]);
        pipe.ReleaseEventID<AscendC::HardEvent::FIX_M>(cFree[i]);
    }
    for(uint32_t i=0;i<4;++i) AscendC::CrossCoreWaitFlag<2>(4+i);
}
#endif
__schedmode__(1) __global__ __mix__(1,2) void TailPairNKernel(GM_ADDR x,GM_ADDR w,
    GM_ADDR scale,GM_ADDR groups,GM_ADDR y,GM_ADDR workspace,Shape s) {
    AscendC::TPipe pipe;
#ifdef __DAV_CUBE__
    TailPairNCube(x,w,groups,workspace,s,pipe);
#else
    BufferedVectorRun<29,64,256,32,false,4>(scale,groups,y,workspace,s,pipe);
#endif
}

inline bool TryTailRotate(GM_ADDR x,GM_ADDR w,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,
    uint32_t e,uint32_t m,uint32_t k,uint32_t n,int64_t availableCoreNum,aclrtStream stream,
    kernel_common::HostPlatform& hardware) {
    // Whole K256 packets admit an exact cyclic traversal with no physical wrap inside a packet.
    if(k<=1344 || k>2048 || k%256 || n<512 || n>1024 || n%256 ||
        m<512 || uint64_t(m)<uint64_t(e)*128 || uint64_t(m)>uint64_t(e)*256) return false;
    const uint32_t workers=std::min<int64_t>(availableCoreNum,
        std::min<int64_t>(hardware.GetCoreNumAic(),hardware.GetCoreNumAiv()/2));
    const uint64_t originalTasks=uint64_t((m+127)/128)*((n+255)/256);
    if(!workers || e>workers || originalTasks<workers || originalTasks>4*workers) return false;
    uint64_t l1=0,la=0,lb=0,lc=0,ub=0;
    hardware.GetCoreMemSize(platform_ascendc::CoreMemType::L1,l1);
    hardware.GetCoreMemSize(platform_ascendc::CoreMemType::L0_A,la);
    hardware.GetCoreMemSize(platform_ascendc::CoreMemType::L0_B,lb);
    hardware.GetCoreMemSize(platform_ascendc::CoreMemType::L0_C,lc);
    hardware.GetCoreMemSize(platform_ascendc::CoreMemType::UB,ub);
    if(std::max<uint64_t>(uint64_t(128)*k+2*256*256,uint64_t(192)*k+2*256*128)+4096>l1 || la<49152 || lb<65536 || lc<131072 || ub<160*1024) return false;
    Shape shape{m,k,n,e,n/256,k,128,128,0,0,0};
    void* workspace=nullptr;
    if(aclrtMalloc(&workspace,uint64_t(workers)*4*kTileElements*sizeof(int32_t),ACL_MEM_MALLOC_HUGE_FIRST)!=ACL_SUCCESS)
        throw std::runtime_error("Tail rotate workspace allocation failed");
    TailPairNKernel<<<workers,nullptr,stream>>>(x,w,scale,groups,y,(GM_ADDR)workspace,shape);
    const auto error=aclrtSynchronizeStream(stream),freed=aclrtFree(workspace);
    if(error!=ACL_SUCCESS || freed!=ACL_SUCCESS) throw std::runtime_error("Tail rotate kernel or cleanup failed");
    return true;
}
}



// Streamed P5 A/B producer and resource fallback for the public paired shapes.
namespace r305ga {
using grouped_matmul_gelu::Shape;
using grouped_matmul_gelu::Segment;
using grouped_matmul_gelu::kColumnsPerTile;
using grouped_matmul_gelu::kRowsPerCubeTile;
using grouped_matmul_gelu::kKPerTile;
using grouped_matmul_gelu::kSlots;
using grouped_matmul_gelu::kL0CSlotElements;
using grouped_matmul_gelu::kTileElements;
using grouped_matmul_gelu::kStripeRows;
using grouped_matmul_gelu::kVectorElements;
#ifdef __DAV_CUBE__
using grouped_matmul_gelu::CopyBPacket;
using grouped_matmul_gelu::PublishPairedPanel;
#endif
using grouped_matmul_gelu::MakeShape;

using kernel_common::Ub;
using kernel_common::Fence;

// Legacy mode locates its first expert once and advances group boundaries.
// ExpertAligned counts actual tiles; host admission bounds its metadata scan.
template <uint32_t ExpertAligned, uint32_t Columns = kColumnsPerTile, bool LocalGroups = false, bool GroupsReady = false>
class Segments {
    static constexpr uint32_t kColumnsPerTile = Columns;
    static constexpr bool kMergeColumnUnits = ExpertAligned == 18 || ExpertAligned == 19;
    static constexpr uint32_t kColumnUnit = kMergeColumnUnits ? Columns / 2 : Columns;
public:
    __aicore__ Segments(GM_ADDR address, Shape shape, uint32_t worker, uint32_t workers,
        AscendC::LocalTensor<int64_t> localGroups = {})
        : s(shape)
    {
        groups.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(address));
        if constexpr (LocalGroups) {
            cachedGroups = localGroups;
            if constexpr(!GroupsReady) {
            AscendC::GlobalTensor<uint8_t> bytes;
            bytes.SetGlobalBuffer(reinterpret_cast<__gm__ uint8_t*>(address));
            AscendC::DataCopyExtParams copy{1, uint32_t(s.experts * sizeof(int64_t)), 0, 0, 0};
            AscendC::DataCopyPadExtParams<uint8_t> pad{false, 0, 0, 0};
            AscendC::DataCopyPad(cachedGroups.ReinterpretCast<uint8_t>(), bytes, copy, pad);
            Fence<AscendC::HardEvent::MTE2_S>();
            }
        }
        if constexpr (ExpertAligned == 2 || ExpertAligned == 7 || ExpertAligned == 10) {
            task = worker;
            rowStep = workers;
            while ((uint32_t(1) << persistentShift) < s.rowTile) ++persistentShift;
            groupEnd = GroupEnd(0);
            persistentGroupEnd = (groupEnd + s.rowTile - 1) >> persistentShift;
            return;
        }
        if constexpr (ExpertAligned) {
            uint32_t rowShift = 0;
            while ((uint32_t(1) << rowShift) < s.rowTile) ++rowShift;
            int64_t tileRows = 0, previous = 0;
            int64_t firstActive = 0, firstActiveEnd = 0;
            for (int64_t i = 0; i < s.experts; ++i) {
                const int64_t end = GroupEnd(i);
                if constexpr (ExpertAligned == 13) {
                    if (tileRows == 0 && end > previous) { firstActive = i; firstActiveEnd = end; }
                }
                tileRows += (end - previous + s.rowTile - 1) >> rowShift;
                previous = end;
            }
            const int64_t total = tileRows * s.columnTiles;
            task = total * worker / workers;
            endTask = total * (worker + 1) / workers;
            if (task < endTask) {
                int64_t ordinal = task / s.columnTiles;
                if constexpr (ExpertAligned == 13) { expert = firstActive; groupEnd = firstActiveEnd; }
                else groupEnd = GroupEnd(0);
                int64_t first = 0;
                int64_t groupTiles = (groupEnd - first + s.rowTile - 1) >> rowShift;
                while (ordinal >= groupTiles) {
                    ordinal -= groupTiles;
                    first = groupEnd;
                    groupEnd = GroupEnd(++expert);
                    groupTiles = (groupEnd - first + s.rowTile - 1) >> rowShift;
                }
                row = first + ordinal * s.rowTile;
                column = task % s.columnTiles * kColumnUnit;
            }
            return;
        }
        const int64_t total = (s.m + s.rowTile - 1) / s.rowTile * s.columnTiles;
        task = total * worker / workers;
        endTask = total * (worker + 1) / workers;
        if (task < endTask) {
            const int64_t firstRow = (task / s.columnTiles) * s.rowTile;
            int64_t low = 0, high = s.experts;
            while (low < high) {
                const int64_t mid = (low + high) / 2;
                if (GroupEnd(mid) <= firstRow) low = mid + 1;
                else high = mid;
            }
            expert = low;
            groupEnd = GroupEnd(expert);
        }
    }

    __aicore__ bool Next(Segment& out)
    {
        if constexpr (ExpertAligned == 4 || ExpertAligned == 19 || ExpertAligned == 5 || ExpertAligned == 7 || ExpertAligned == 10) {
            if (childPending) { out = childSegment; childPending = false; return true; }
        }
        if constexpr (ExpertAligned == 2 || ExpertAligned == 7 || ExpertAligned == 10) {
            if (column == 0) {
                while (task >= persistentGroupEnd) {
                    if (++expert >= s.experts) return false;
                    persistentFirst = groupEnd;
                    groupEnd = GroupEnd(expert);
                    persistentGroupStart = persistentGroupEnd;
                    persistentGroupEnd += (groupEnd - persistentFirst + s.rowTile - 1) >> persistentShift;
                }
                row = persistentFirst + ((task - persistentGroupStart) << persistentShift);
            }
            out.expert = expert; out.row = row; out.column = column;
            out.rows = groupEnd - row < s.rowTile ? groupEnd - row : s.rowTile;
            out.columns = s.n - column < kColumnsPerTile ? s.n - column : kColumnsPerTile;
            column += kColumnsPerTile;
            if (column >= s.n) { column = 0; task += rowStep; }
            if constexpr (ExpertAligned == 7) {
                if (out.columns > 256) {
                    childSegment = out;
                    childSegment.column += 256;
                    childSegment.columns -= 256;
                    childPending = true;
                    out.columns = 256;
                }
            }
            if constexpr (ExpertAligned == 10) {
                if (out.rows > 64) {
                    childSegment = out;
                    childSegment.row += 64;
                    childSegment.rows -= 64;
                    childPending = true;
                    out.rows = 64;
                }
            }
            return true;
        }
        if constexpr (ExpertAligned) {
            if (task >= endTask) return false;
            out.expert = expert; out.row = row; out.column = column;
            out.rows = groupEnd - row < s.rowTile ? groupEnd - row : s.rowTile;
            uint32_t width = kColumnsPerTile;
            if constexpr (kMergeColumnUnits) {
                // Merge only whole aligned pairs of units owned by this worker.
                if (column % Columns || endTask - task < 2 || s.n - column < Columns)
                    width = kColumnUnit;
            }
            out.columns = s.n - column < width ? s.n - column : width;
            task += width / kColumnUnit;
            if (task < endTask) {
                column += width;
                if (column >= s.n) {
                    column = 0;
                    row = groupEnd - row < s.rowTile ? groupEnd : row + s.rowTile;
                    while (row >= groupEnd) groupEnd = GroupEnd(++expert);
                }
            }
            if constexpr (ExpertAligned == 4 || ExpertAligned == 19) {
                if (out.rows > 64) {
                    childSegment = out;
                    childSegment.row += 64;
                    childSegment.rows -= 64;
                    childPending = true;
                    out.rows = 64;
                }
            }
            if constexpr (ExpertAligned == 5) {
                if (out.columns > 256) {
                    childSegment = out;
                    childSegment.column += 256;
                    childSegment.columns -= 256;
                    childPending = true;
                    out.columns = 256;
                }
            }
            return true;
        }
        if (row == tileEnd) {
            if (task >= endTask) return false;
            row = (task / s.columnTiles) * s.rowTile;
            tileEnd = row + s.rowTile < s.m ? row + s.rowTile : s.m;
            column = (task % s.columnTiles) * kColumnsPerTile;
            ++task;
            if (row == previousTileRow) {
                expert = tileExpert;
                groupEnd = tileGroupEnd;
            } else {
                while (row >= groupEnd) groupEnd = GroupEnd(++expert);
                previousTileRow = row;
                tileExpert = expert;
                tileGroupEnd = groupEnd;
            }
        }
        while (row >= groupEnd) groupEnd = GroupEnd(++expert);
        out.expert = expert;
        out.row = row;
        out.column = column;
        out.rows = static_cast<uint32_t>(groupEnd - row < tileEnd - row ? groupEnd - row : tileEnd - row);
        out.columns = static_cast<uint32_t>(s.n - column < kColumnsPerTile ? s.n - column : kColumnsPerTile);
        row += out.rows;
        return true;
    }

private:
    __aicore__ int64_t GroupEnd(int64_t index) const
    {
        if constexpr (LocalGroups) return cachedGroups.GetValue(index);
        else return groups.GetValue(index);
    }
    AscendC::LocalTensor<int64_t> cachedGroups;
    uint32_t persistentShift = 0, rowStep = 0;
    int64_t persistentFirst = 0, persistentGroupStart = 0, persistentGroupEnd = 0;
    Segment childSegment;
    bool childPending = false;
    Shape s;
    AscendC::GlobalTensor<int64_t> groups;
    int64_t task, endTask, row = 0, tileEnd = 0, column = 0;
    int64_t expert = 0, groupEnd = 0, previousTileRow = -1, tileExpert = 0, tileGroupEnd = 0;
};

// Only this specialization admits non-power-of-two row tiles.
template <uint32_t Columns, bool LocalGroups, bool GroupsReady>
class Segments<12, Columns, LocalGroups, GroupsReady> {
public:
    __aicore__ Segments(GM_ADDR address, Shape shape, uint32_t worker, uint32_t workers,
        AscendC::LocalTensor<int64_t> local = {}) : s(shape)
    {
        groups.SetGlobalBuffer((__gm__ int64_t*)address);
        if constexpr (LocalGroups) {
            cached = local;
            if constexpr (!GroupsReady) {
                AscendC::DataCopyPad(cached, groups,
                    AscendC::DataCopyExtParams{1, uint32_t(s.experts * 8), 0, 0, 0}, {false, 0, 0, 0});
                Fence<AscendC::HardEvent::MTE2_S>();
            }
        }
        int64_t rows = 0, previous = 0;
        for (int64_t e = 0; e < s.experts; ++e) {
            const int64_t end = GroupEnd(e);
            rows += (end - previous + s.rowTile - 1) / s.rowTile;
            previous = end;
        }
        const int64_t total = rows * s.columnTiles;
        task = total * worker / workers;
        endTask = total * (worker + 1) / workers;
        if (task == endTask) return;
        int64_t ordinal = task / s.columnTiles, first = 0;
        groupEnd = GroupEnd(0);
        while (ordinal >= (groupEnd - first + s.rowTile - 1) / s.rowTile) {
            ordinal -= (groupEnd - first + s.rowTile - 1) / s.rowTile;
            first = groupEnd; groupEnd = GroupEnd(++expert);
        }
        row = first + ordinal * s.rowTile;
        column = task % s.columnTiles * Columns;
    }

    __aicore__ bool Next(Segment& out)
    {
        if (task >= endTask) return false;
        out.expert = expert; out.row = row; out.column = column;
        out.rows = groupEnd - row < s.rowTile ? groupEnd - row : s.rowTile;
        out.columns = s.n - column < Columns ? s.n - column : Columns;
        if (++task < endTask) {
            column += Columns;
            if (column >= s.n) {
                column = 0;
                row = groupEnd - row < s.rowTile ? groupEnd : row + s.rowTile;
                while (row >= groupEnd) groupEnd = GroupEnd(++expert);
            }
        }
        return true;
    }

private:
    __aicore__ int64_t GroupEnd(int64_t e) const {
        if constexpr (LocalGroups) return cached.GetValue(e);
        else return groups.GetValue(e);
    }
    Shape s;
    AscendC::GlobalTensor<int64_t> groups;
    AscendC::LocalTensor<int64_t> cached;
    int64_t task = 0, endTask = 0, expert = 0, groupEnd = 0, row = 0, column = 0;
};

// Included inside r305ga after the generic Segments declaration.
// Actual group work prefix; the first M tile also pays for a full B-panel load.
template <bool LocalGroups, bool GroupsReady>
class Segments<11, 256, LocalGroups, GroupsReady> {
public:
    __aicore__ Segments(GM_ADDR address, Shape shape, uint32_t worker, uint32_t workers,
        AscendC::LocalTensor<int64_t> localGroups = {}) : s(shape) {
        groups.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(address));
        if constexpr (LocalGroups) {
            cached = localGroups;
            if constexpr (!GroupsReady) {
                AscendC::GlobalTensor<uint8_t> bytes;
                bytes.SetGlobalBuffer(reinterpret_cast<__gm__ uint8_t*>(address));
                AscendC::DataCopyExtParams cp{1, uint32_t(s.experts * 8), 0, 0, 0};
                AscendC::DataCopyPadExtParams<uint8_t> pad{false, 0, 0, 0};
                AscendC::DataCopyPad(cached.ReinterpretCast<uint8_t>(), bytes, cp, pad);
                Fence<AscendC::HardEvent::MTE2_S>();
            }
        }
        panelPenalty = s.k < 128 ? 0 : 4;
        int64_t previous = 0, totalWork = 0;
        for (int64_t e = 0; e < s.experts; ++e) {
            const int64_t end = GroupEnd(e);
            if (end > previous) totalWork += ((end - previous + 63) / 64 + panelPenalty) * s.columnTiles;
            previous = end;
        }
        const int64_t beginWork = totalWork * worker / workers;
        endWork = totalWork * (worker + 1) / workers;
        if (beginWork == endWork) return;
        int64_t prefix = 0;
        for (;;) {
            if (expert >= s.experts) return;
            groupEnd = GroupEnd(expert);
            rowTiles = (groupEnd - groupStart + 63) / 64;
            const int64_t groupWork = rowTiles ? (rowTiles + panelPenalty) * s.columnTiles : 0;
            if (beginWork < prefix + groupWork) {
                const int64_t offset = beginWork - prefix;
                columnTile = offset / (rowTiles + panelPenalty);
                const int64_t inPanel = offset % (rowTiles + panelPenalty);
                rowTile = inPanel == 0 ? 0 : (inPanel <= panelPenalty + 1 ? 1 : inPanel - panelPenalty);
                if (rowTile >= rowTiles) { rowTile = 0; ++columnTile; }
                if (columnTile < s.columnTiles) {
                    currentWork = prefix + columnTile * (rowTiles + panelPenalty) +
                        (rowTile == 0 ? 0 : rowTile + panelPenalty);
                    remaining = currentWork < endWork;
                    return;
                }
                // The boundary lies inside the last heavy tile of this group.
                // Its successor is the first tile of the next nonempty group.
                prefix += groupWork;
                if (prefix >= endWork) return;
                do {
                    groupStart = groupEnd;
                    groupEnd = GroupEnd(++expert);
                } while (groupEnd == groupStart && expert + 1 < s.experts);
                rowTiles = (groupEnd - groupStart + 63) / 64;
                columnTile = rowTile = 0;
                currentWork = prefix;
                remaining = rowTiles && currentWork < endWork;
                return;
            }
            prefix += groupWork;
            groupStart = groupEnd;
            ++expert;
        }
    }
    __aicore__ bool Next(Segment& out) {
        if (!remaining) return false;
        const int64_t row = groupStart + rowTile * 64;
        const int64_t col = columnTile * 256;
        out = {expert, row, col,
            uint32_t(groupEnd - row < 64 ? groupEnd - row : 64),
            uint32_t(s.n - col < 256 ? s.n - col : 256)};
        currentWork += rowTile == 0 ? panelPenalty + 1 : 1;
        remaining = currentWork < endWork;
        if (remaining) {
            if (++rowTile == rowTiles) {
                rowTile = 0;
                if (++columnTile == s.columnTiles) {
                    columnTile = 0;
                    do {
                        groupStart = groupEnd;
                        groupEnd = GroupEnd(++expert);
                    } while (groupEnd == groupStart);
                    rowTiles = (groupEnd - groupStart + 63) / 64;
                }
            }
        }
        return true;
    }
private:
    __aicore__ int64_t GroupEnd(int64_t e) const {
        if constexpr (LocalGroups) return cached.GetValue(e);
        else return groups.GetValue(e);
    }
    Shape s;
    AscendC::GlobalTensor<int64_t> groups;
    AscendC::LocalTensor<int64_t> cached;
    int64_t remaining = 0, expert = 0, groupStart = 0, groupEnd = 0;
    int64_t rowTiles = 0, rowTile = 0, columnTile = 0;
    int64_t currentWork = 0, endWork = 0, panelPenalty = 0;
};

// Included inside r305ga after the generic Segments declaration.
// Actual group work prefix; the first M tile also pays for a full B-panel load.
template <bool LocalGroups = false, bool GroupsReady = false>
class WideMacroSegments {
public:
    __aicore__ WideMacroSegments(GM_ADDR address, Shape shape, uint32_t worker, uint32_t workers,
        AscendC::LocalTensor<int64_t> localGroups = {}) : s(shape) {
        groups.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(address));
        if constexpr (LocalGroups) {
            cached = localGroups;
            if constexpr (!GroupsReady) {
                AscendC::GlobalTensor<uint8_t> bytes;
                bytes.SetGlobalBuffer(reinterpret_cast<__gm__ uint8_t*>(address));
                AscendC::DataCopyExtParams cp{1, uint32_t(s.experts * 8), 0, 0, 0};
                AscendC::DataCopyPadExtParams<uint8_t> pad{false, 0, 0, 0};
                AscendC::DataCopyPad(cached.ReinterpretCast<uint8_t>(), bytes, cp, pad);
                Fence<AscendC::HardEvent::MTE2_S>();
            }
        }
        panelPenalty = s.k < 128 ? 0 : 8;
        int64_t previous = 0, totalWork = 0;
        for (int64_t e = 0; e < s.experts; ++e) {
            const int64_t end = GroupEnd(e);
            if (end > previous) totalWork += ((end - previous + 31) / 32 + panelPenalty) * s.columnTiles;
            previous = end;
        }
        const int64_t beginWork = totalWork * worker / workers;
        endWork = totalWork * (worker + 1) / workers;
        if (beginWork == endWork) return;
        int64_t prefix = 0;
        for (;;) {
            if (expert >= s.experts) return;
            groupEnd = GroupEnd(expert);
            rowTiles = (groupEnd - groupStart + 31) / 32;
            const int64_t groupWork = rowTiles ? (rowTiles + panelPenalty) * s.columnTiles : 0;
            if (beginWork < prefix + groupWork) {
                const int64_t offset = beginWork - prefix;
                columnTile = offset / (rowTiles + panelPenalty);
                const int64_t inPanel = offset % (rowTiles + panelPenalty);
                rowTile = inPanel == 0 ? 0 : (inPanel <= panelPenalty + 1 ? 1 : inPanel - panelPenalty);
                if (rowTile >= rowTiles) { rowTile = 0; ++columnTile; }
                if (columnTile < s.columnTiles) {
                    currentWork = prefix + columnTile * (rowTiles + panelPenalty) +
                        (rowTile == 0 ? 0 : rowTile + panelPenalty);
                    remaining = currentWork < endWork;
                    return;
                }
                // The boundary lies inside the last heavy tile of this group.
                // Its successor is the first tile of the next nonempty group.
                prefix += groupWork;
                if (prefix >= endWork) return;
                do {
                    groupStart = groupEnd;
                    groupEnd = GroupEnd(++expert);
                } while (groupEnd == groupStart && expert + 1 < s.experts);
                rowTiles = (groupEnd - groupStart + 31) / 32;
                columnTile = rowTile = 0;
                currentWork = prefix;
                remaining = rowTiles && currentWork < endWork;
                return;
            }
            prefix += groupWork;
            groupStart = groupEnd;
            ++expert;
        }
    }
    __aicore__ bool Next(Segment& out) {
        if (!remaining) return false;
        const int64_t row = groupStart + rowTile * 32;
        const int64_t col = columnTile * 1024;
        out = {expert, row, col,
            uint32_t(groupEnd - row < 32 ? groupEnd - row : 32),
            uint32_t(s.n - col < 1024 ? s.n - col : 1024)};
        currentWork += rowTile == 0 ? panelPenalty + 1 : 1;
        remaining = currentWork < endWork;
        if (remaining) {
            if (++rowTile == rowTiles) {
                rowTile = 0;
                if (++columnTile == s.columnTiles) {
                    columnTile = 0;
                    do {
                        groupStart = groupEnd;
                        groupEnd = GroupEnd(++expert);
                    } while (groupEnd == groupStart);
                    rowTiles = (groupEnd - groupStart + 31) / 32;
                }
            }
        }
        return true;
    }
private:
    __aicore__ int64_t GroupEnd(int64_t e) const {
        if constexpr (LocalGroups) return cached.GetValue(e);
        else return groups.GetValue(e);
    }
    Shape s;
    AscendC::GlobalTensor<int64_t> groups;
    AscendC::LocalTensor<int64_t> cached;
    int64_t remaining = 0, expert = 0, groupStart = 0, groupEnd = 0;
    int64_t rowTiles = 0, rowTile = 0, columnTile = 0;
    int64_t currentWork = 0, endWork = 0, panelPenalty = 0;
};

template <bool LocalGroups, bool GroupsReady>
class Segments<12, 1024, LocalGroups, GroupsReady> {
public:
    __aicore__ Segments(GM_ADDR g, Shape s, uint32_t worker, uint32_t workers,
        AscendC::LocalTensor<int64_t> local = {}) : macros(g,s,worker,workers,local) {}
    __aicore__ bool Next(Segment& out) {
        if(pending) { out=child; pending=false; return true; }
        if(!macros.Next(out)) return false;
        if(out.rows>16) {
            child=out;child.row+=16;child.rows-=16;out.rows=16;pending=true;
        }
        return true;
    }
private:
    WideMacroSegments<LocalGroups,GroupsReady> macros;
    Segment child;
    bool pending=false;
};

#ifdef __DAV_CUBE__

template <uint32_t PacketK, bool WiderNarrowPackets, uint32_t AChunkK>
__aicore__ inline void CopyPairedOperands(AscendC::TQue<AscendC::TPosition::B1, 2>& bq,
    AscendC::GlobalTensor<int8_t> x, AscendC::GlobalTensor<int8_t> weight,
    AscendC::LocalTensor<int8_t> a1, Shape s, Segment block,
    uint32_t start, uint32_t packetK, bool coldA)
{
    if constexpr (AChunkK) {
        if (coldA && start % AChunkK == 0) {
            const uint32_t mp = (block.rows + 15) / 16 * 16;
            const uint32_t count = s.k - start < AChunkK ? s.k - start : AChunkK;
            AscendC::Nd2NzParams copy{};
            copy.ndNum = 1;
            copy.nValue = block.rows;
            copy.dValue = count;
            copy.srcDValue = s.k;
            copy.dstNzC0Stride = mp;
            copy.dstNzNStride = 1;
            AscendC::DataCopy(a1[start * mp], x[block.row * s.k + start], copy);
        }
    }
    // The B queue ready event follows both copies on MTE2.
    if constexpr (WiderNarrowPackets) {
        const uint32_t end = s.k - start < packetK ? s.k : start + packetK;
        CopyBPacket<2 * PacketK>(bq, weight, s, block, start, end);
    } else {
        CopyBPacket<PacketK>(bq, weight, s, block, start, s.k);
    }
}

template <bool Persistent, uint32_t Columns = 256, uint32_t PacketK = 256,
    uint32_t Schedule = Persistent ? 2 : 1, bool WiderNarrowPackets = false, uint32_t AChunkK = 0, bool NextHead = false>
__aicore__ inline void PairedEarlyCube(GM_ADDR xAddress, GM_ADDR weightAddress,
    GM_ADDR groupsAddress, GM_ADDR workspace, Shape s, AscendC::TPipe& pipe)
{
    constexpr uint32_t MadK=128,HeadK=256,BBytes=PacketK*Columns;
    const uint32_t worker = AscendC::GetBlockIdx();
    AscendC::GlobalTensor<int8_t> x, weight;
    AscendC::GlobalTensor<int32_t> ring;
    x.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(xAddress));
    weight.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(weightAddress));
    ring.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(workspace) + worker * kSlots * kTileElements);
    AscendC::SetAtomicNone();
    AscendC::SetMMRowMajor();
    AscendC::SetLoadDataBoundary(uint64_t(0));
    AscendC::SetLoadDataPaddingValue(uint64_t(0));
    AscendC::TBuf<AscendC::TPosition::A1> resident;
    AscendC::TQue<AscendC::TPosition::B1, 2> bq;
    AscendC::TBuf<AscendC::TPosition::B1> headBuffer;
    AscendC::TBuf<AscendC::TPosition::A2> ab;
    AscendC::TBuf<AscendC::TPosition::B2> bb;
    AscendC::TBuf<AscendC::TPosition::CO1> cb;
    pipe.InitBuffer(resident,128*(s.residentK+(NextHead?HeadK:0)));
    pipe.InitBuffer(bq,2,BBytes);
    if constexpr(NextHead)pipe.InitBuffer(headBuffer,BBytes);
    pipe.InitBuffer(ab, 2 * 128 * MadK);
    pipe.InitBuffer(bb, 2 * Columns * MadK);
    pipe.InitBuffer(cb, 2 * kL0CSlotElements * sizeof(int32_t));
    auto a1 = resident.Get<int8_t>();
    auto aAll = ab.Get<int8_t>();
    auto bAll = bb.Get<int8_t>();
    auto cAll = cb.Get<int32_t>();
    event_t free[2],ready[2],cFree[2],headFree,headReady,aTailReady;
    AscendC::LocalTensor<int8_t> aHead,bHead;
    if constexpr(NextHead){
        aHead=a1[128*s.residentK];bHead=headBuffer.Get<int8_t>();
        headFree=(event_t)pipe.AllocEventID<AscendC::HardEvent::MTE1_MTE2>();
        headReady=(event_t)pipe.AllocEventID<AscendC::HardEvent::MTE2_MTE1>();
        aTailReady=(event_t)pipe.AllocEventID<AscendC::HardEvent::MTE2_MTE1>();
        AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(headFree);
    }
    for (uint32_t i = 0; i < 2; ++i) {
        free[i] = static_cast<event_t>(pipe.AllocEventID<AscendC::HardEvent::M_MTE1>());
        ready[i] = static_cast<event_t>(pipe.AllocEventID<AscendC::HardEvent::MTE1_M>());
        cFree[i] = static_cast<event_t>(pipe.AllocEventID<AscendC::HardEvent::FIX_M>());
        AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(free[i]);
        AscendC::SetFlag<AscendC::HardEvent::FIX_M>(cFree[i]);
    }
    Segments<Schedule, Columns> blocks(groupsAddress, s, worker, AscendC::GetBlockNum());
    Segment block,next;
    uint32_t sequence=0,kSequence=0;
    int64_t loadedRow=-1;
    bool live=blocks.Next(block),staged=false,headAResident=false;
    while(live){
        bool hasNext=false;
        if constexpr(NextHead)hasNext=blocks.Next(next);
        const bool coldA = loadedRow != block.row;
        const uint32_t mp=(block.rows+15)/16*16;
        if(coldA){
            if constexpr(NextHead)headAResident=staged;
            if constexpr (AChunkK) {
                // Protect every old A1 fragment before publishing the new row.
                Fence<AscendC::HardEvent::MTE1_MTE2>();
                if (block.rows != mp) {
                    AscendC::InitConstValueParams<uint16_t> zero{1,
                        static_cast<uint16_t>(mp * s.residentK / 32), 0, 0};
                    AscendC::InitConstValue(a1.ReinterpretCast<uint16_t>(), zero);
                    AscendC::PipeBarrier<PIPE_MTE2>();
                }
            } else {
                LoadResidentRange(a1, x, s, block, 0, s.k);
            }
            if constexpr(NextHead)if(staged){
                AscendC::Nd2NzParams cp{1,uint16_t(block.rows),HeadK,0,uint16_t(s.k),uint16_t(mp),1,0};
                AscendC::DataCopy(a1[HeadK*mp],x[block.row*s.k+HeadK],cp);
                AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(aTailReady);
            }
            loadedRow=block.row;
        }
        const uint32_t np = (block.columns + 31) / 32 * 32;
        const uint32_t firstM = mp < 64 ? mp : 64;
        const uint32_t secondM = mp > 64 ? mp - 64 : 0;
        const uint32_t cs = sequence & 1, cs2 = (sequence + 1) & 1;
        auto c0 = cAll[cs * kL0CSlotElements];
        auto c1 = cAll[cs2 * kL0CSlotElements];
        AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(cFree[cs]);
        if (secondM) AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(cFree[cs2]);
        // Both packet shapes occupy the same B1 slot: 256x256 or 128x512.
        const uint32_t packetK = WiderNarrowPackets && block.columns <= Columns / 2 ? 2 * PacketK : PacketK;
        const uint32_t queueStart=staged?packetK:0;
        CopyPairedOperands<PacketK,WiderNarrowPackets,AChunkK>(bq,x,weight,a1,s,block,queueStart,packetK,coldA);
        if(queueStart+packetK<s.k)
            CopyPairedOperands<PacketK,WiderNarrowPackets,AChunkK>(bq,x,weight,a1,s,block,queueStart+packetK,packetK,coldA);
        for (uint32_t packet = 0; packet < s.k; packet += packetK) {
            const uint32_t end = s.k - packet < packetK ? s.k : packet + packetK;
            const uint32_t packetKp = (end - packet + 31) / 32 * 32;
            const bool fromHead=staged&&packet==0;
            AscendC::LocalTensor<int8_t> b1;
            if(fromHead){
                AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(headReady);
                b1=bHead;
            }else b1=bq.DeQue<int8_t>();
            for (uint32_t k0 = packet; k0 < end; k0 += MadK, ++kSequence) {
                const uint32_t count = end - k0 < MadK ? end - k0 : MadK;
                const uint32_t kp = (count + 31) / 32 * 32;
                const uint32_t ks = kSequence & 1;
                auto a2 = aAll[ks * 128 * MadK];
                auto b2 = bAll[ks * Columns * MadK];
                AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(free[ks]);
                AscendC::LoadData2DParams ap{};
                ap.repeatTimes = kp / 32; ap.srcStride = mp / 16;
                if constexpr(NextHead)if(coldA&&staged&&k0==HeadK)
                    AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(aTailReady);
                auto aSource=headAResident&&k0<HeadK?aHead:a1;
                for(uint32_t m=0;m<mp/16;++m)
                    AscendC::LoadData(a2[m*kp*16],aSource[k0*mp+m*512],ap);
                AscendC::LoadData2dTransposeParams bp{};
                bp.repeatTimes = np / 32; bp.srcStride = packetKp / 32; bp.dstGap = 1;
                for (uint32_t k = 0; k < kp / 32; ++k)
                    AscendC::LoadDataWithTranspose(b2[k * np * 32], b1[(k0 - packet) * 32 + k * 1024], bp);
                if (k0 + MadK >= end) {
                    if(fromHead)AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(headFree);
                    else{
                        bq.FreeTensor(b1);
                        if(packet+2*packetK<s.k)
                            CopyPairedOperands<PacketK,WiderNarrowPackets,AChunkK>(
                                bq,x,weight,a1,s,block,packet+2*packetK,packetK,coldA);
                    }
                    if constexpr(NextHead)if(hasNext&&packet+3*packetK==s.k){
                        AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(headFree);
                        if(next.row!=block.row){
                            const uint32_t nextMp=(next.rows+15)/16*16;
                            kernel_common::ZeroNzRows(aHead,next.rows,nextMp,HeadK);
                            AscendC::Nd2NzParams ap{1,uint16_t(next.rows),HeadK,0,uint16_t(s.k),uint16_t(nextMp),1,0};
                            AscendC::DataCopy(aHead,x[next.row*s.k],ap);
                        }
                        const uint16_t nk=next.columns<=Columns/2?2*PacketK:PacketK;
                        AscendC::Nd2NzParams bp{1,nk,uint16_t(next.columns),0,uint16_t(s.n),nk,1,0};
                        AscendC::DataCopy(bHead,weight[next.expert*s.k*s.n+next.column],bp);
                        AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(headReady);
                    }
                }
                AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(ready[ks]);
                AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(ready[ks]);
                AscendC::MmadParams mm{};
                mm.m = firstM; mm.n = np; mm.k = kp; mm.cmatrixInitVal = k0 == 0;
                const bool last = k0 + MadK >= s.k;
                mm.unitFlag = last ? 3 : 2;
                AscendC::Mmad(c0, a2, b2, mm);
                if ((mm.m / 16) * (mm.n / 16) < 10) AscendC::PipeBarrier<PIPE_M>();
                if (last) PublishPairedPanel<Columns>(ring, c0, firstM, np, sequence, cFree[cs]);
                if (secondM) {
                    mm.m = secondM;
                    AscendC::Mmad(c1, a2[64 * kp], b2, mm);
                    if ((mm.m / 16) * (mm.n / 16) < 10) AscendC::PipeBarrier<PIPE_M>();
                    if (last) PublishPairedPanel<Columns>(ring, c1, secondM, np, sequence, cFree[cs2]);
                }
                // Both MAD consumers retire before either shared L0 slot is reused.
                AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(free[ks]);
            }
        }
        if constexpr(NextHead){live=hasNext;staged=hasNext;if(hasNext)block=next;}
        else live=blocks.Next(block);
    }
    if constexpr(NextHead){
        AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(headFree);
        pipe.ReleaseEventID<AscendC::HardEvent::MTE1_MTE2>(headFree);
        pipe.ReleaseEventID<AscendC::HardEvent::MTE2_MTE1>(headReady);
        pipe.ReleaseEventID<AscendC::HardEvent::MTE2_MTE1>(aTailReady);
    }
    for (uint32_t i = 0; i < 2; ++i) {
        AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(free[i]);
        AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(cFree[i]);
        pipe.ReleaseEventID<AscendC::HardEvent::M_MTE1>(free[i]);
        pipe.ReleaseEventID<AscendC::HardEvent::MTE1_M>(ready[i]);
        pipe.ReleaseEventID<AscendC::HardEvent::FIX_M>(cFree[i]);
        AscendC::CrossCoreWaitFlag<2>(4 + i);
    }
}


#endif

template <uint32_t KTile, bool SlabMode = false, uint32_t ExpertAligned = false, uint32_t BPacketK = 0,
    uint32_t Rows = kRowsPerCubeTile, uint32_t Columns = kColumnsPerTile, uint32_t StripeRows = kStripeRows>
__schedmode__(1) __global__ __mix__(1, 2) void ManualKernel(
    GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groups, GM_ADDR y,
    GM_ADDR workspace, Shape shape)
{
    static_assert(BPacketK == 0 || (KTile <= kKPerTile && BPacketK % KTile == 0));
    static_assert(Rows * Columns == kTileElements && StripeRows * Columns == kVectorElements);
    shape.kTile = KTile;
    AscendC::TPipe pipe;
#ifdef __DAV_CUBE__
    grouped_matmul_gelu::CubeRun<SlabMode, ExpertAligned, BPacketK, Rows, Columns, Segments>(x, weight, groups, workspace, shape, pipe);
#else
    if (shape.vectorPrefetch)
        grouped_matmul_gelu::BufferedVectorRun<ExpertAligned, Rows, Columns, StripeRows,
            false, kSlots, false, Segments>(scale, groups, y, workspace, shape, pipe);
    else
        grouped_matmul_gelu::VectorRun<ExpertAligned, Rows, Columns, StripeRows, 0, Segments>(scale, groups, y, workspace, shape, pipe);
#endif
}

template <bool Persistent>
__schedmode__(1) __global__ __mix__(1, 2) void PairedEarlyKernel(GM_ADDR x,
    GM_ADDR weight, GM_ADDR scale, GM_ADDR groups, GM_ADDR y, GM_ADDR workspace, Shape shape)
{
    AscendC::TPipe pipe;
#ifdef __DAV_CUBE__
    r305ga::PairedEarlyCube<Persistent>(x, weight, groups, workspace, shape, pipe);
#else
    grouped_matmul_gelu::VectorRun<Persistent ? 10 : 4, 64, 256, 32, 0, Segments>(scale, groups, y, workspace, shape, pipe);
#endif
}

template <uint32_t PacketK,bool NextHead=false>
__schedmode__(1) __global__ __mix__(1, 2) void DesktopMixedStreamedPairedKernel(
    GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groups, GM_ADDR y,
    GM_ADDR workspace, Shape shape)
{
    AscendC::TPipe pipe;
#ifdef __DAV_CUBE__
    r305ga::PairedEarlyCube<false,256,PacketK,18,true,512,NextHead>(x, weight, groups, workspace, shape, pipe);
#else
    grouped_matmul_gelu::VectorRun<19, 64, 256, 32, 0, Segments>(scale, groups, y, workspace, shape, pipe);
#endif
}

} // namespace r305ga




namespace r305fb {
template<bool WindowScale>
__schedmode__(1) __global__ __mix__(1,2) void GridShortGroupKernel(
    GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR g, GM_ADDR y, GM_ADDR workspace,
    grouped_matmul_gelu::Shape shape)
{
    AscendC::TPipe pipe;
#if defined(__DAV_CUBE__)
    grouped_matmul_gelu::ShortGroupFullKCube<0>(x,w,g,workspace,shape,pipe);
#else
    grouped_matmul_gelu::BufferedVectorRun<0,64,256,32,false,
        grouped_matmul_gelu::kSlots,true,grouped_matmul_gelu::Segments,WindowScale>(s,g,y,workspace,shape,pipe);
#endif
}
} // namespace r305fb



namespace grouped_matmul_gelu {
namespace uniform_panels {

constexpr uint32_t Rows=128,Cols=256,PacketK=256,MadK=128;
constexpr uint32_t BBytes=PacketK*Cols;

template<uint32_t Experts>
__aicore__ inline bool Uniform(GM_ADDR address) {
    AscendC::GlobalTensor<int64_t> groups;
    groups.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(address));
    for(uint32_t e=0;e<Experts;++e)
        if(groups.GetValue(e)!=int64_t((e+1)*Rows))return false;
    return true;
}

#ifdef __DAV_CUBE__
template<uint32_t K>
__aicore__ inline void CopyA(AscendC::LocalTensor<int8_t> dst,
    AscendC::GlobalTensor<int8_t> x,uint32_t expert,uint32_t first,uint32_t count) {
    AscendC::Nd2NzParams ap{};
    ap.ndNum=1;ap.nValue=Rows;ap.dValue=count;ap.srcDValue=K;
    ap.dstNzC0Stride=Rows;ap.dstNzNStride=1;
    AscendC::DataCopy(dst[first*Rows],x[expert*Rows*K+first],ap);
}

template<uint32_t K, uint32_t Panels>
__aicore__ inline void Issue(AscendC::LocalTensor<int8_t> b,
    AscendC::GlobalTensor<int8_t> w,AscendC::LocalTensor<int8_t> a,
    AscendC::GlobalTensor<int8_t> x,uint32_t macro,uint32_t packet,
    bool cold,event_t free,event_t ready) {
    AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(free);
    const uint32_t expert=macro/Panels,column=(macro%Panels)*Cols;
    if(cold&&packet==0)CopyA<K>(a,x,expert,0,PacketK);
    if(cold&&packet==1)CopyA<K>(a,x,expert,PacketK,K-PacketK);
    AscendC::Nd2NzParams bp{};
    bp.ndNum=1;bp.nValue=PacketK;bp.dValue=Cols;bp.srcDValue=Panels*Cols;
    bp.dstNzC0Stride=PacketK;bp.dstNzNStride=1;
    AscendC::DataCopy(b,w[(expert*K+packet*PacketK)*(Panels*Cols)+column],bp);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(ready);
}

__aicore__ inline void Publish(AscendC::GlobalTensor<int32_t> ring,
    AscendC::LocalTensor<int32_t> c,uint32_t& frame,event_t free) {
    AscendC::FixpipeParamsV220 fp{};
    fp.unitFlag=3;fp.nSize=Cols;fp.mSize=64;fp.srcStride=64;fp.dstStride=Cols;
    AscendC::Fixpipe(ring[frame*kTileElements],c,fp);
    AscendC::SetFlag<AscendC::HardEvent::FIX_M>(free);
    AscendC::CrossCoreSetFlag<2,PIPE_FIX>(frame&1);
    ++frame;
}

template<uint32_t K, uint32_t Panels, uint32_t Experts>
__aicore__ inline void Run(GM_ADDR xAddress,GM_ADDR wAddress,GM_ADDR workspace,AscendC::TPipe& pipe) {
    constexpr uint32_t ABytes=Rows*K, Packets=K/PacketK;
    static_assert(Packets>=3 && K%PacketK==0);
    const uint32_t worker=AscendC::GetBlockIdx(),workers=AscendC::GetBlockNum();
    constexpr uint32_t tasks=Experts*Panels;
    const uint32_t first=tasks*worker/workers,end=tasks*(worker+1)/workers;
    AscendC::GlobalTensor<int8_t> x,w;
    x.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(xAddress));
    w.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(wAddress));
    AscendC::GlobalTensor<int32_t> ring;
    ring.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(workspace)+worker*4*kTileElements);
    AscendC::SetAtomicNone();AscendC::SetMMRowMajor();
    AscendC::SetLoadDataBoundary(uint64_t(0));AscendC::SetLoadDataPaddingValue(uint64_t(0));
    AscendC::TBuf<AscendC::TPosition::A1> arena;
    AscendC::TBuf<AscendC::TPosition::A2> ab;
    AscendC::TBuf<AscendC::TPosition::B2> bb;
    AscendC::TBuf<AscendC::TPosition::CO1> cb;
    pipe.InitBuffer(arena,2*ABytes+3*BBytes);
    pipe.InitBuffer(ab,2*Rows*MadK);pipe.InitBuffer(bb,2*Cols*MadK);
    pipe.InitBuffer(cb,2*kTileElements*sizeof(int32_t));
    auto a=arena.Get<int8_t>(),b=a[2*ABytes];
    auto aAll=ab.Get<int8_t>(),bAll=bb.Get<int8_t>();
    auto c=cb.Get<int32_t>();
    event_t free[2],ready[2],cFree[2],bFree[3],bReady[3];
    for(uint32_t i=0;i<3;++i){
        bFree[i]=(event_t)pipe.AllocEventID<AscendC::HardEvent::MTE1_MTE2>();
        bReady[i]=(event_t)pipe.AllocEventID<AscendC::HardEvent::MTE2_MTE1>();
        AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(bFree[i]);
    }
    for(uint32_t i=0;i<2;++i){
        free[i]=(event_t)pipe.AllocEventID<AscendC::HardEvent::M_MTE1>();
        ready[i]=(event_t)pipe.AllocEventID<AscendC::HardEvent::MTE1_M>();
        cFree[i]=(event_t)pipe.AllocEventID<AscendC::HardEvent::FIX_M>();
        AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(free[i]);
        AscendC::SetFlag<AscendC::HardEvent::FIX_M>(cFree[i]);
    }
    for(uint32_t p=0;p<3;++p)
        Issue<K,Panels>(b[p*BBytes],w,a,x,first,p,true,bFree[p],bReady[p]);
    uint32_t frame=0,aSlot=0;
    const uint32_t total=(end-first)*Packets;
    for(uint32_t macro=first;macro<end;++macro){
        const bool nextCold=(macro+1)/Panels!=macro/Panels;
        const uint32_t nextA=aSlot^uint32_t(nextCold);
        auto a1=a[aSlot*ABytes];
        for(uint32_t i=0;i<2;++i)AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(cFree[i]);
        for(uint32_t p=0;p<Packets;++p){
            const uint32_t sequence=(macro-first)*Packets+p,bs=sequence%3;
            AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(bReady[bs]);
            auto b1=b[bs*BBytes];
            for(uint32_t halfK=0;halfK<2;++halfK){
                const uint32_t k0=p*PacketK+halfK*MadK;
                auto a2=aAll[halfK*Rows*MadK],b2=bAll[halfK*Cols*MadK];
                AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(free[halfK]);
                AscendC::LoadData2DParams ap{};
                ap.repeatTimes=MadK/32;ap.srcStride=Rows/16;
                for(uint32_t m=0;m<Rows/16;++m)
                    AscendC::LoadData(a2[m*MadK*16],a1[k0*Rows+m*512],ap);
                AscendC::LoadData2dTransposeParams bp{};
                bp.repeatTimes=Cols/32;bp.srcStride=PacketK/32;bp.dstGap=1;
                for(uint32_t k=0;k<MadK/32;++k)
                    AscendC::LoadDataWithTranspose(b2[k*Cols*32],b1[halfK*MadK*32+k*1024],bp);
                if(halfK==1){
                    AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(bFree[bs]);
                    const uint32_t issue=sequence+3;
                    if(issue<total){
                        const uint32_t job=first+issue/Packets;
                        const bool next=job!=macro;
                        Issue<K,Panels>(b1,w,a[(next?nextA:aSlot)*ABytes],x,job,issue%Packets,
                            next&&nextCold,bFree[bs],bReady[bs]);
                    }
                }
                AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(ready[halfK]);
                AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(ready[halfK]);
                const bool last=k0+MadK==K;
                AscendC::MmadParams mm{};
                mm.m=64;mm.n=Cols;mm.k=MadK;mm.cmatrixInitVal=k0==0;mm.unitFlag=last?3:2;
                for(uint32_t m=0;m<2;++m){
                    auto acc=c[m*kTileElements];
                    AscendC::Mmad(acc,a2[m*64*MadK],b2,mm);
                    if(last)Publish(ring,acc,frame,cFree[m]);
                }
                AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(free[halfK]);
            }
        }
        aSlot=nextA;
    }
    for(uint32_t i=0;i<3;++i){
        AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(bFree[i]);
        pipe.ReleaseEventID<AscendC::HardEvent::MTE1_MTE2>(bFree[i]);
        pipe.ReleaseEventID<AscendC::HardEvent::MTE2_MTE1>(bReady[i]);
    }
    for(uint32_t i=0;i<2;++i){
        AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(free[i]);
        AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(cFree[i]);
        pipe.ReleaseEventID<AscendC::HardEvent::M_MTE1>(free[i]);
        pipe.ReleaseEventID<AscendC::HardEvent::MTE1_M>(ready[i]);
        pipe.ReleaseEventID<AscendC::HardEvent::FIX_M>(cFree[i]);
    }
}
#endif

template<uint32_t Panels, uint32_t Experts>
struct Schedule {
    template<uint32_t Kind, uint32_t Width, bool Local, bool Ready=false>
    class Frames {
        uint32_t frame, end;
    public:
        __aicore__ Frames(GM_ADDR,Shape,uint32_t worker,uint32_t workers,
            AscendC::LocalTensor<int64_t> = {})
            : frame(2*((Experts*Panels*worker)/workers)),
              end(2*((Experts*Panels*(worker+1))/workers)) {}
        __aicore__ bool Next(Segment& out) {
            if(frame==end)return false;
            const uint32_t macro=frame/2,expert=macro/Panels;
            out={int64_t(expert),int64_t(expert*Rows+(frame%2)*64),
                int64_t((macro%Panels)*Cols),64,Cols};
            ++frame;
            return true;
        }
    };
};
} // namespace uniform_panels

template<uint32_t K, uint32_t Panels, uint32_t Experts>
__schedmode__(1) __global__ __mix__(1,2) void UniformPanelPipelineKernel(GM_ADDR x,
    GM_ADDR w,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,GM_ADDR workspace,Shape shape) {
    AscendC::TPipe pipe;
    if(uniform_panels::Uniform<Experts>(groups)){
#ifdef __DAV_CUBE__
        uniform_panels::Run<K,Panels,Experts>(x,w,workspace,pipe);
#else
        VectorRun<37,64,256,32,4,uniform_panels::Schedule<Panels,Experts>::template Frames>(scale,groups,y,workspace,shape,pipe);
#endif
    }else{
#ifdef __DAV_CUBE__
        PairedEarlyCube<false>(x,w,groups,workspace,shape,pipe);
#else
        VectorRun<4,64,256,32>(scale,groups,y,workspace,shape,pipe);
#endif
    }
}
} // namespace grouped_matmul_gelu



namespace grouped_matmul_gelu {
namespace expert_stream {

constexpr uint32_t Rows=64;
constexpr uint32_t Panel=512, Columns=256, Packet=256, MadK=128;
constexpr uint32_t Frames=4, FrameElements=Rows*Columns;

__aicore__ inline bool FullExperts(GM_ADDR address, uint32_t experts) {
    AscendC::GlobalTensor<int64_t> groups;
    groups.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(address));
    for(uint32_t e=0;e<experts;++e)
        if(groups.GetValue(e)!=int64_t((e+1)*Rows))return false;
    return true;
}

template<uint32_t Kind,uint32_t Width,bool Local,bool Ready=false>
class ExpertFrames {
    static_assert(Kind==15 && Width==Columns && Local && !Ready);
    uint32_t expert,frame=0;
public:
    __aicore__ ExpertFrames(GM_ADDR,Shape,uint32_t worker,uint32_t,AscendC::LocalTensor<int64_t>)
        : expert(worker) {}
    __aicore__ bool Next(Segment& out) {
        if(frame==Frames)return false;
        out={int64_t(expert),int64_t(expert*Rows),int64_t(frame*Columns),Rows,Columns};
        ++frame;
        return true;
    }
};

#ifdef __DAV_CUBE__
template<uint32_t K>
__aicore__ inline void RunCube(GM_ADDR xAddress,GM_ADDR wAddress,GM_ADDR workspace,
    Shape shape,AscendC::TPipe& pipe) {
    constexpr uint32_t Packets=K/Packet,Jobs=Frames/2*Packets;
    static_assert((Packets & (Packets-1))==0 && Packets>=2);
    constexpr uint32_t ABytes=Rows*K,BBytes=Panel*Packet;
    const uint32_t expert=AscendC::GetBlockIdx();
    const uint32_t phase=expert&(Packets-1);
    const uint32_t firstK=phase*Packet;
    AscendC::GlobalTensor<int8_t> x,w;
    AscendC::GlobalTensor<int32_t> ring;
    x.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(xAddress));
    w.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(wAddress));
    ring.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(workspace)+expert*Frames*FrameElements);
    AscendC::SetAtomicNone();
    AscendC::SetMMRowMajor();
    AscendC::SetLoadDataBoundary(uint64_t(0));
    AscendC::SetLoadDataPaddingValue(uint64_t(0));

    AscendC::TBuf<AscendC::TPosition::A1> arena;
    AscendC::TBuf<AscendC::TPosition::A2> ab;
    AscendC::TBuf<AscendC::TPosition::B2> bb;
    AscendC::TBuf<AscendC::TPosition::CO1> cb;
    pipe.InitBuffer(arena,ABytes+2*BBytes);
    pipe.InitBuffer(ab,2*Rows*MadK);
    pipe.InitBuffer(bb,2*Columns*MadK);
    pipe.InitBuffer(cb,2*FrameElements*sizeof(int32_t));
    auto a1=arena.Get<int8_t>(),aAll=ab.Get<int8_t>(),bAll=bb.Get<int8_t>();
    auto c=cb.Get<int32_t>();
    ArenaBPipe bq;
    bq.Init(pipe);
    bq.Reset(a1[ABytes],BBytes);
    event_t aFree[2],bFree[2],ready[2],cFree[2];
    for(uint32_t i=0;i<2;++i){
        aFree[i]=(event_t)pipe.AllocEventID<AscendC::HardEvent::M_MTE1>();
        bFree[i]=(event_t)pipe.AllocEventID<AscendC::HardEvent::M_MTE1>();
        ready[i]=(event_t)pipe.AllocEventID<AscendC::HardEvent::MTE1_M>();
        cFree[i]=(event_t)pipe.AllocEventID<AscendC::HardEvent::FIX_M>();
        AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(aFree[i]);
        AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(bFree[i]);
        AscendC::SetFlag<AscendC::HardEvent::FIX_M>(cFree[i]);
    }
    AscendC::LoadData3DParamsV2<int8_t> aLoad{};
    aLoad.l1H=1;
    aLoad.l1W=Rows;
    aLoad.channelSize=MadK;
    aLoad.kExtension=MadK;
    aLoad.mExtension=Rows;
    aLoad.kStartPt=0;
    aLoad.mStartPt=0;
    aLoad.strideW=1;
    aLoad.strideH=1;
    aLoad.filterW=1;
    aLoad.filterH=1;
    aLoad.dilationFilterW=1;
    aLoad.dilationFilterH=1;
    aLoad.filterSizeW=false;
    aLoad.filterSizeH=false;
    aLoad.enTranspose=false;
    aLoad.fMatrixCtrl=false;
    const auto xBase=uint64_t(expert)*Rows*K;
    AscendC::Nd2NzParams ap{1,Rows,Packet,0,K,Rows,1,0};
    AscendC::DataCopy(a1[firstK*Rows],x[xBase+firstK],ap);
    Segment first{int64_t(expert),int64_t(expert*Rows),0,Rows,Panel};
    CopyArenaBPacket<Packet>(bq,w,shape,first,firstK,firstK+Packet);
    if(firstK+Packet<K) {
        ap.dValue=K-firstK-Packet;
        AscendC::DataCopy(a1[(firstK+Packet)*Rows],x[xBase+firstK+Packet],ap);
    }
    if(firstK) {
        ap.dValue=firstK;
        AscendC::DataCopy(a1,x[xBase],ap);
    }
    const uint32_t second=(phase+1)&(Packets-1);
    CopyArenaBPacket<Packet>(bq,w,shape,first,second*Packet,(second+1)*Packet);

    for(uint32_t job=0;job<Jobs;++job) {
        const uint32_t packet=job&(Packets-1),physical=((packet+phase)&(Packets-1))*Packet;
        if(!packet)
            for(uint32_t n=0;n<2;++n)AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(cFree[n]);
        auto b1=bq.DeQue();
        for(uint32_t k=0;k<Packet;k+=MadK) {
            const uint32_t aSlot=k/MadK;
            auto a2=aAll[aSlot*Rows*MadK];
            AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(aFree[aSlot]);
            AscendC::LoadData(a2,a1[(physical+k)*Rows],aLoad);
            for(uint32_t n=0;n<2;++n) {
                auto b2=bAll[n*Columns*MadK];
                AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(bFree[n]);
                AscendC::LoadData2dTransposeParams bp{};
                bp.repeatTimes=Columns/32;
                bp.srcStride=Packet/32;
                bp.dstGap=1;
                for(uint32_t slice=0;slice<MadK/32;++slice)
                    AscendC::LoadDataWithTranspose(b2[slice*Columns*32],
                        b1[n*Columns*Packet+k*32+slice*1024],bp);
                if(n==1 && k+MadK==Packet) {
                    bq.FreeTensor(b1);
                    const uint32_t ahead=job+2;
                    if(ahead<Jobs) {
                        Segment next=first;
                        next.column=(ahead/Packets)*Panel;
                        const uint32_t nextK=((ahead+phase)&(Packets-1))*Packet;
                        CopyArenaBPacket<Packet>(bq,w,shape,next,nextK,nextK+Packet);
                    }
                }
                AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(ready[n]);
                AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(ready[n]);
                const bool last=packet==Packets-1 && k+MadK==Packet;
                AscendC::MmadParams mm{};
                mm.m=Rows;
                mm.n=Columns;
                mm.k=MadK;
                mm.cmatrixInitVal=packet==0&&k==0;
                mm.unitFlag=last?3:2;
                auto acc=c[n*FrameElements];
                AscendC::Mmad(acc,a2,b2,mm);
                AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(bFree[n]);
                if(last) {
                    const uint32_t frame=(job/Packets)*2+n;
                    AscendC::FixpipeParamsV220 fp{};
                    fp.unitFlag=3;fp.nSize=Columns;fp.mSize=Rows;fp.srcStride=Rows;fp.dstStride=Columns;
                    AscendC::Fixpipe(ring[frame*FrameElements],acc,fp);
                    AscendC::SetFlag<AscendC::HardEvent::FIX_M>(cFree[n]);
                    AscendC::CrossCoreSetFlag<2,PIPE_FIX>(n);
                }
            }
            AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(aFree[aSlot]);
        }
    }
    bq.Drain(pipe);
    for(uint32_t i=0;i<2;++i){
        AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(aFree[i]);
        AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(bFree[i]);
        AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(cFree[i]);
        pipe.ReleaseEventID<AscendC::HardEvent::M_MTE1>(aFree[i]);
        pipe.ReleaseEventID<AscendC::HardEvent::M_MTE1>(bFree[i]);
        pipe.ReleaseEventID<AscendC::HardEvent::MTE1_M>(ready[i]);
        pipe.ReleaseEventID<AscendC::HardEvent::FIX_M>(cFree[i]);
    }
}
#endif

} // namespace expert_stream

template<uint32_t K>
__schedmode__(1) __global__ __mix__(1,2) void ResidentExpertStreamKernel(
    GM_ADDR x,GM_ADDR w,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,GM_ADDR workspace,Shape shape) {
    AscendC::TPipe pipe;
    const bool full=expert_stream::FullExperts(groups, AscendC::GetBlockNum());
#ifdef __DAV_CUBE__
    if(full)expert_stream::RunCube<K>(x,w,workspace,shape,pipe);
    else AdaptiveStaggerCube(x,w,groups,workspace,shape,pipe);
#else
    if(full)VectorRun<15,64,256,32,expert_stream::Frames,expert_stream::ExpertFrames>(scale,groups,y,workspace,shape,pipe);
    else VectorRun<15,64,256,32>(scale,groups,y,workspace,shape,pipe);
#endif
}

} // namespace grouped_matmul_gelu



namespace grouped_matmul_gelu {

enum class AlignedSchedule { None, ResidentExpert, UniformPanels, ShortGroupGrid };

struct AlignedLaunchPlan {
    AlignedSchedule schedule = AlignedSchedule::None;
    Shape shape{};
    uint32_t blocks = 0;
    uint32_t cFrames = 0;
};

inline AlignedLaunchPlan PlanAlignedSchedule(Shape shape, uint32_t workers,
    uint64_t l1, uint64_t l0a, uint64_t l0b, uint64_t l0c, uint64_t ub) {
    if (!workers || l0a < 32768 || l0b < 65536 || l0c < 131072 || ub < 120 * 1024)
        return {};

    constexpr uint32_t PacketK = 256, ColumnTile = 256;
    constexpr uint32_t GuardBytes = 4096;
    const uint32_t experts = shape.experts;
    const uint32_t rows = shape.m, depth = shape.k, columns = shape.n;
    if (depth % PacketK == 0 && columns % ColumnTile == 0) {
        const uint32_t packets = depth / PacketK;
        const uint32_t panels = columns / ColumnTile;
        const uint32_t groupTasks = experts * panels;

        // Two N512 jobs publish four frames. One owner per expert avoids
        // duplicate resident A and uses more than half the available cores.
        // The device verifies every M64 boundary and falls back for ragged groups.
        const uint64_t expertArena = uint64_t(64) * depth + 2 * PacketK * 512;
        const uint64_t fallbackArena = std::max<uint64_t>(
            uint64_t(128) * depth + 2 * PacketK * ColumnTile, expertArena);
        if (rows == experts * 64 && experts <= workers && 2 * experts > workers &&
            panels == expert_stream::Frames && packets >= 2 && packets <= 8 &&
            (packets & (packets - 1)) == 0 &&
            fallbackArena + GuardBytes <= l1) {
            shape.rowTile = 64;
            shape.columnTiles = panels / 2;
            shape.residentK = depth;
            shape.kTile = 128;
            return {AlignedSchedule::ResidentExpert, shape, experts, expert_stream::Frames};
        }

        // Three B slots prefill across whole K256 packets. Two M128 A banks
        // overlap changes of expert. At most two N256 tasks fit in the four
        // append-only C frames owned by each core.
        constexpr uint32_t frames = 4;
        const uint64_t panelArena = uint64_t(2 * 128) * depth + 3 * PacketK * ColumnTile;
        // Limit unrolled static group/tile geometry to one metadata sector.
        if (rows == experts * 128 && experts <= 8 && packets >= 3 && packets <= 4 &&
            groupTasks >= workers && groupTasks * 2 <= workers * frames && panels <= 4 &&
            panelArena + GuardBytes <= l1) {
            shape.rowTile = 128;
            shape.columnTiles = panels;
            shape.residentK = depth;
            shape.kTile = 128;
            return {AlignedSchedule::UniformPanels, shape, workers, frames};
        }
    }

    // The resident full-K B producer fits one N256 tile in L0B. An M64
    // grid splits at real group boundaries and preserves reuse with many groups.
    if (columns == ColumnTile && depth >= 128 && depth <= 256 && depth % 32 == 0 &&
        experts > workers && rows >= 64 * workers && rows <= 64 * experts &&
        uint64_t(rows) * columns < uint64_t(workers) * 2 * 65536 &&
        l1 >= 163840 && ub >= 189440) {
        shape.rowTile = 64;
        shape.columnTiles = 1;
        shape.kTile = 128;
        shape.vectorPrefetch = 1;
        return {AlignedSchedule::ShortGroupGrid, shape, workers, kSlots};
    }
    return {};
}

template<uint32_t Depth,uint32_t Panels,uint32_t Experts=1>
inline void LaunchUniformPanels(GM_ADDR x,GM_ADDR w,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,
    GM_ADDR workspace,AlignedLaunchPlan plan,aclrtStream stream) {
    if (plan.shape.experts == Experts)
        UniformPanelPipelineKernel<Depth,Panels,Experts><<<plan.blocks,nullptr,stream>>>(
            x,w,scale,groups,y,workspace,plan.shape);
    else if constexpr(Experts<8)
        LaunchUniformPanels<Depth,Panels,Experts+1>(x,w,scale,groups,y,workspace,plan,stream);
}

template<uint32_t Depth>
inline void LaunchUniformPanelCount(GM_ADDR x,GM_ADDR w,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,
    GM_ADDR workspace,AlignedLaunchPlan plan,aclrtStream stream) {
    switch (plan.shape.columnTiles) {
        case 1: LaunchUniformPanels<Depth,1>(x,w,scale,groups,y,workspace,plan,stream); break;
        case 2: LaunchUniformPanels<Depth,2>(x,w,scale,groups,y,workspace,plan,stream); break;
        case 3: LaunchUniformPanels<Depth,3>(x,w,scale,groups,y,workspace,plan,stream); break;
        case 4: LaunchUniformPanels<Depth,4>(x,w,scale,groups,y,workspace,plan,stream); break;
    }
}

inline bool TryAlignedSchedule(GM_ADDR x,GM_ADDR w,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,
    Shape shape,int64_t available,aclrtStream stream,kernel_common::HostPlatform& platform) {
    const uint32_t workers=std::min<int64_t>(available,
        std::min(platform.GetCoreNumAic(),platform.GetCoreNumAiv()/2));
    uint64_t l1=0,l0a=0,l0b=0,l0c=0,ub=0;
    platform.GetCoreMemSize(platform_ascendc::CoreMemType::L1,l1);
    platform.GetCoreMemSize(platform_ascendc::CoreMemType::L0_A,l0a);
    platform.GetCoreMemSize(platform_ascendc::CoreMemType::L0_B,l0b);
    platform.GetCoreMemSize(platform_ascendc::CoreMemType::L0_C,l0c);
    platform.GetCoreMemSize(platform_ascendc::CoreMemType::UB,ub);
    const auto plan=PlanAlignedSchedule(shape,workers,l1,l0a,l0b,l0c,ub);
    if (plan.schedule==AlignedSchedule::None) return false;

    void* memory=nullptr;
    const uint64_t bytes=uint64_t(plan.blocks)*plan.cFrames*kTileElements*sizeof(int32_t);
    if (aclrtMalloc(&memory,bytes,ACL_MEM_MALLOC_HUGE_FIRST)!=ACL_SUCCESS)
        throw std::runtime_error("Aligned schedule workspace allocation failed");
    auto workspace=(GM_ADDR)memory;
    switch (plan.schedule) {
        case AlignedSchedule::ResidentExpert:
            switch (plan.shape.k / 256) {
                case 2: ResidentExpertStreamKernel<512><<<plan.blocks,nullptr,stream>>>(x,w,scale,groups,y,workspace,plan.shape); break;
                case 4: ResidentExpertStreamKernel<1024><<<plan.blocks,nullptr,stream>>>(x,w,scale,groups,y,workspace,plan.shape); break;
                case 8: ResidentExpertStreamKernel<2048><<<plan.blocks,nullptr,stream>>>(x,w,scale,groups,y,workspace,plan.shape); break;
            }
            break;
        case AlignedSchedule::UniformPanels:
            if (plan.shape.k == 3 * 256)
                LaunchUniformPanelCount<768>(x,w,scale,groups,y,workspace,plan,stream);
            else
                LaunchUniformPanelCount<1024>(x,w,scale,groups,y,workspace,plan,stream);
            break;
        case AlignedSchedule::ShortGroupGrid:
            if (ub >= 189440)
                r305fb::GridShortGroupKernel<true><<<plan.blocks,nullptr,stream>>>(x,w,scale,groups,y,workspace,plan.shape);
            else
                r305fb::GridShortGroupKernel<false><<<plan.blocks,nullptr,stream>>>(x,w,scale,groups,y,workspace,plan.shape);
            break;
        case AlignedSchedule::None: break;
    }
    const auto status=aclrtSynchronizeStream(stream),released=aclrtFree(memory);
    if (status!=ACL_SUCCESS || released!=ACL_SUCCESS)
        throw std::runtime_error("Aligned schedule execution or cleanup failed");
    return true;
}

} // namespace grouped_matmul_gelu



inline bool TryDesktopMixedPaired(GM_ADDR x, GM_ADDR weight, GM_ADDR scale,
    GM_ADDR groups, GM_ADDR y, uint32_t experts, uint32_t m, uint32_t k, uint32_t n,
    int64_t available, aclrtStream stream)
{
    constexpr uint32_t ColumnUnit = 128;
    constexpr uint32_t Columns = 2 * ColumnUnit;
    constexpr uint32_t PacketK = 256;
    if (k < 1536 || k > 2048 || k % PacketK || n < 512 || n > 1024 ||
        n % Columns || experts > 64) {
        return false;
    }

    kernel_common::HostPlatform platform;
    const uint32_t workers = std::min<int64_t>(available,
        std::min(platform.GetCoreNumAic(), platform.GetCoreNumAiv() / 2));
    if (!workers) return false;

    // Minimum output-tile count follows from total M. Actual groups are read
    // by the device iterator, which covers any distribution, including empty groups.
    const uint64_t rowTiles = (uint64_t(m) + 127) / 128;
    const uint64_t wideTiles = rowTiles * (n / Columns);
    const uint64_t wideWaves = (wideTiles + workers - 1) / workers;
    const uint64_t narrowWaves = (2 * wideTiles + workers - 1) / workers;
    if (wideTiles < workers || narrowWaves >= 2 * wideWaves) return false;

    uint64_t l1 = 0, l0a = 0, l0b = 0, l0c = 0, ub = 0;
    platform.GetCoreMemSize(platform_ascendc::CoreMemType::L1, l1);
    platform.GetCoreMemSize(platform_ascendc::CoreMemType::L0_A, l0a);
    platform.GetCoreMemSize(platform_ascendc::CoreMemType::L0_B, l0b);
    platform.GetCoreMemSize(platform_ascendc::CoreMemType::L0_C, l0c);
    platform.GetCoreMemSize(platform_ascendc::CoreMemType::UB, ub);
    if (l1 < 128 * k + 2 * PacketK * Columns + 4096 || l0a < 32768 ||
        l0b < 2 * Columns * 128 || l0c < 131072 || ub < 122880) {
        return false;
    }

    // With one nominal M128 tile per expert, using one owner for each
    // row tile preserves A reuse across N without adding a serial wide wave.
    // Actual row tile counts and tails remain device-scheduled.
    const bool keepWholeRows = rowTiles == experts && m % 128 == 0 &&
        rowTiles <= workers && n / Columns <= wideWaves;
    const uint32_t blocks = keepWholeRows ? experts : workers;
    // A256-wide head uses 128*256 bytes. The extra B head shares the
    // regular packet geometry and is issued three packets from the end.
    const uint64_t lookaheadArena = uint64_t(128) * (k + PacketK) +
        3 * PacketK * Columns + 4096;
    const bool lookahead = keepWholeRows && k % (2 * PacketK) == 0 &&
        k >= 6 * PacketK && l1 >= lookaheadArena;
    const r305ga::Shape shape{m, k, n, experts, n / ColumnUnit, k, 128, 128, 0, 0, 0};
    const uint64_t bytes = uint64_t(blocks) * 2 * 16384 * sizeof(int32_t);
    void* workspace = nullptr;
    if (aclrtMalloc(&workspace, bytes, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) {
        throw std::runtime_error("Mixed-width paired workspace allocation failed");
    }
    if (lookahead)
        r305ga::DesktopMixedStreamedPairedKernel<PacketK,true><<<blocks,nullptr,stream>>>(
            x,weight,scale,groups,y,(GM_ADDR)workspace,shape);
    else
        r305ga::DesktopMixedStreamedPairedKernel<PacketK><<<blocks,nullptr,stream>>>(
            x,weight,scale,groups,y,(GM_ADDR)workspace,shape);
    const auto status = aclrtSynchronizeStream(stream);
    const auto released = aclrtFree(workspace);
    if (status != ACL_SUCCESS || released != ACL_SUCCESS) {
        throw std::runtime_error("Mixed-width paired kernel or cleanup failed");
    }
    return true;
}



namespace legacy_gmm {

// One row per AIV. Specialize K/N to unroll the complete dot and read the actual group ends.
// Only valid output lanes execute; all source bytes are read each invocation.
// Scalar FP32 dequantization precedes the unchanged vector FP32 GELU.

template<uint32_t K,uint32_t N,uint32_t Experts>
__global__ __vector__ void grouped_matmul_gelu_tiny_one_row(
    GM_ADDR x,GM_ADDR w,GM_ADDR s,GM_ADDR g,GM_ADDR y) {
    InitSocState();
    LocalTensor<int8_t> xv(TPosition::VECCALC,0,128);
    LocalTensor<int8_t> wv(TPosition::VECCALC,128,512);
    LocalTensor<float> scale(TPosition::VECCALC,768,128);
    LocalTensor<float> z(TPosition::VECCALC,1280,64);
    LocalTensor<float> u(TPosition::VECCALC,1536,64);
    LocalTensor<float> t(TPosition::VECCALC,1792,64);
    LocalTensor<float> a(TPosition::VECCALC,2048,64);
    LocalTensor<half> out(TPosition::VECCALC,2304,64);
    GlobalTensor<int8_t> xs,ws;GlobalTensor<float> scales;GlobalTensor<int64_t> gs;GlobalTensor<half> output;
    xs.SetGlobalBuffer((__gm__ int8_t*)x);ws.SetGlobalBuffer((__gm__ int8_t*)w);
    scales.SetGlobalBuffer((__gm__ float*)s);gs.SetGlobalBuffer((__gm__ int64_t*)g);
    output.SetGlobalBuffer((__gm__ half*)y);
    // Multi-row B is arranged in 32-byte UB blocks for word loads.
    // A single K row fits a scalar word. DMA alignment fills its unused bytes.
    const uint32_t row=GetBlockIdx();
    DataCopyExtParams xp{1,K,0,0,0};
    DataCopyExtParams wp{K>1 ? Experts*K:1,K>1 ? N:Experts*N,0,0,0};
    DataCopyExtParams sp{1,Experts*N*4,0,0,0};
    DataCopyPad(xv,xs[row*K],xp,{false,0,0,0});
    DataCopyPad(wv,ws,wp,{false,0,0,0});
    DataCopyPad(scale,scales,sp,{false,0,0,0});
    {
        uint32_t expert=0;
        #pragma unroll
        for(uint32_t e=0;e+1<Experts;++e) expert+=uint32_t(gs.GetValue(e)<=row);
        kernel_common::FixedFence<HardEvent::MTE2_S>();
        const int32_t x0=int32_t(xv.GetValue(0));
        int32_t x1=0,x2=0,x3=0;
        if constexpr(K>=2)x1=int32_t(xv.GetValue(1));
        if constexpr(K>=3)x2=int32_t(xv.GetValue(2));
        if constexpr(K>=4)x3=int32_t(xv.GetValue(3));

        // Each B row uses a 32-byte DMA block. Use wide loads only
        // when the valid columns cover the entire machine word.
        const uint32_t base=expert*K;
        uint64_t w0=0,w1=0,w2=0,w3=0;
        if constexpr(K>1 && N==8) {
            auto words=wv.template ReinterpretCast<uint64_t>();
            w0=words.GetValue(base*4);
            w1=words.GetValue((base+1)*4);
            if constexpr(K>=3)w2=words.GetValue((base+2)*4);
            if constexpr(K>=4)w3=words.GetValue((base+3)*4);
        }
        #pragma unroll
        for(uint32_t col=0;col<N;++col) {
            int32_t sum;
            if constexpr(K==1) {
                sum=x0*int32_t(wv.GetValue(expert*N+col));
            } else if constexpr(N==8) {
                sum=x0*int32_t(int8_t(w0>>(col*8)));
                sum+=x1*int32_t(int8_t(w1>>(col*8)));
                if constexpr(K>=3)sum+=x2*int32_t(int8_t(w2>>(col*8)));
                if constexpr(K>=4)sum+=x3*int32_t(int8_t(w3>>(col*8)));
            } else {
                const uint32_t index=base*32+col;
                sum=x0*int32_t(wv.GetValue(index));
                sum+=x1*int32_t(wv.GetValue(index+32));
                if constexpr(K>=3)sum+=x2*int32_t(wv.GetValue(index+64));
                if constexpr(K>=4)sum+=x3*int32_t(wv.GetValue(index+96));
            }
            z.SetValue(col,static_cast<float>(sum)*scale.GetValue(expert*N+col));
        }
        kernel_common::FixedFence<HardEvent::S_V>();
#if defined(__DAV_VEC__)
        auto zp=(__ubuf__ float*)z.GetPhyAddr();auto up=(__ubuf__ float*)u.GetPhyAddr();
        auto tp=(__ubuf__ float*)t.GetPhyAddr();auto ap=(__ubuf__ float*)a.GetPhyAddr();
        asc_set_mask_norm();asc_set_vector_mask(0,(uint64_t(1)<<N)-1);
        asc_mul(up,zp,zp,uint8_t(1),1,1,1,8,8,8);PipeBarrier<PIPE_V>();
        asc_mul_scalar(up,up,0.044715f,uint8_t(1),1,1,8,8);PipeBarrier<PIPE_V>();
        asc_add_scalar(up,up,1.0f,uint8_t(1),1,1,8,8);PipeBarrier<PIPE_V>();
        asc_mul(up,up,zp,uint8_t(1),1,1,1,8,8,8);PipeBarrier<PIPE_V>();
        asc_mul_scalar(up,up,-1.5957691216057308f,uint8_t(1),1,1,8,8);PipeBarrier<PIPE_V>();
        Mins(u,u,80.0f,N);PipeBarrier<PIPE_V>();
        asc_set_mask_norm();asc_set_vector_mask(0,(uint64_t(1)<<N)-1);
        asc_exp(tp,up,uint8_t(1),1,1,8,8);PipeBarrier<PIPE_V>();
        asc_add_scalar(tp,tp,1.0f,uint8_t(1),1,1,8,8);PipeBarrier<PIPE_V>();
        asc_div(ap,zp,tp,uint8_t(1),1,1,1,8,8,8);PipeBarrier<PIPE_V>();
#endif
        Cast(out,a,RoundMode::CAST_RINT,N);kernel_common::FixedFence<HardEvent::V_MTE3>();
        DataCopyExtParams cp{1,N*2,0,0,0};DataCopyPad(output[(uint64_t)row*N],out,cp);
    }
    PipeBarrier<PIPE_ALL>();
}



template<uint32_t K,uint32_t Experts>
inline void LaunchOneRowTiny(GM_ADDR x,GM_ADDR w,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,
    uint32_t rows,uint32_t columns,aclrtStream stream) {
    switch(columns) {
        case 1:
            grouped_matmul_gelu_tiny_one_row<K,1,Experts><<<rows,nullptr,stream>>>(x,w,scale,groups,y);
            return;
        case 2:
            grouped_matmul_gelu_tiny_one_row<K,2,Experts><<<rows,nullptr,stream>>>(x,w,scale,groups,y);
            return;
        case 3:
            grouped_matmul_gelu_tiny_one_row<K,3,Experts><<<rows,nullptr,stream>>>(x,w,scale,groups,y);
            return;
        case 4:
            grouped_matmul_gelu_tiny_one_row<K,4,Experts><<<rows,nullptr,stream>>>(x,w,scale,groups,y);
            return;
        case 5:
            grouped_matmul_gelu_tiny_one_row<K,5,Experts><<<rows,nullptr,stream>>>(x,w,scale,groups,y);
            return;
        case 6:
            grouped_matmul_gelu_tiny_one_row<K,6,Experts><<<rows,nullptr,stream>>>(x,w,scale,groups,y);
            return;
        case 7:
            grouped_matmul_gelu_tiny_one_row<K,7,Experts><<<rows,nullptr,stream>>>(x,w,scale,groups,y);
            return;
        case 8:
            grouped_matmul_gelu_tiny_one_row<K,8,Experts><<<rows,nullptr,stream>>>(x,w,scale,groups,y);
            return;
    }
}

template<uint32_t K,uint32_t Experts=1>
inline void LaunchTinyGroupCount(GM_ADDR x,GM_ADDR w,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,
    uint32_t experts,uint32_t rows,uint32_t columns,aclrtStream stream) {
    // Specialize group count uniformly across a 64-byte metadata sector.
    // K>1 also needs one UB block per weight row.
    constexpr uint32_t maxExperts = K<=2 ? 8 : 16/K;
    if(experts==Experts)
        LaunchOneRowTiny<K,Experts>(x,w,scale,groups,y,rows,columns,stream);
    else if constexpr(Experts<maxExperts)
        LaunchTinyGroupCount<K,Experts+1>(x,w,scale,groups,y,experts,rows,columns,stream);
}
} // namespace legacy_gmm

inline bool TryOneRowTiny(GM_ADDR x,GM_ADDR w,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,
    uint32_t experts,uint32_t rows,uint32_t depth,uint32_t columns,int64_t available,
    aclrtStream stream,kernel_common::HostPlatform& platform) {
    // One AIV per row avoids a serial row loop and shared workspace.
    if(depth>4 || columns>8 || rows>uint64_t(available) || experts>8 ||
        (depth>1 && experts*depth*32>512) || rows>platform.GetCoreNumAiv())return false;
    constexpr uint64_t tinyUbBytes = 2304 + 64 * sizeof(half);
    uint64_t ub = 0;
    platform.GetCoreMemSize(platform_ascendc::CoreMemType::UB, ub);
    if (ub < tinyUbBytes) return false;
    switch(depth) {
        case 1:
            legacy_gmm::LaunchTinyGroupCount<1>(x,w,scale,groups,y,experts,rows,columns,stream);
            return true;
        case 2:
            legacy_gmm::LaunchTinyGroupCount<2>(x,w,scale,groups,y,experts,rows,columns,stream);
            return true;
        case 3:
            legacy_gmm::LaunchTinyGroupCount<3>(x,w,scale,groups,y,experts,rows,columns,stream);
            return true;
        case 4:
            legacy_gmm::LaunchTinyGroupCount<4>(x,w,scale,groups,y,experts,rows,columns,stream);
            return true;
    }
    return false;
}



namespace fused_gmm {
using namespace AscendC;
#if defined(__DAV_CUBE__)
template<uint32_t R,uint32_t BK,uint32_t PK> struct RowDotProducer {
    Shape sh;
    GlobalTensor<int8_t> xs,ws;
    LocalTensor<int8_t> w1,x1,a0,b0;
    LocalTensor<int32_t> c0;
    event_t packetFree[2],packetReady[2],operandFree[2],operandReady[2],cFree[2];
    uint32_t lastExpert=~0u,sequence=0;
    __aicore__ inline void Init(TPipe& pipe,GM_ADDR x,GM_ADDR w,Shape shape) {
        sh=shape;xs.SetGlobalBuffer((__gm__ int8_t*)x);ws.SetGlobalBuffer((__gm__ int8_t*)w);
        w1=LocalTensor<int8_t>(TPosition::A1,0,16384);
        x1=LocalTensor<int8_t>(TPosition::B1,16384,2*R*PK);
        a0=LocalTensor<int8_t>(TPosition::A2,0,1024);
        b0=LocalTensor<int8_t>(TPosition::B2,0,2*R*BK);
        c0=LocalTensor<int32_t>(TPosition::CO1,0,2*16*R);
        for(uint32_t i=0;i<2;++i) {
            packetFree[i]=(event_t)pipe.AllocEventID<HardEvent::MTE1_MTE2>();
            packetReady[i]=(event_t)pipe.AllocEventID<HardEvent::MTE2_MTE1>();
            operandFree[i]=(event_t)pipe.AllocEventID<HardEvent::M_MTE1>();
            operandReady[i]=(event_t)pipe.AllocEventID<HardEvent::MTE1_M>();
            cFree[i]=(event_t)pipe.AllocEventID<HardEvent::FIX_M>();
            SetFlag<HardEvent::MTE1_MTE2>(packetFree[i]);
            SetFlag<HardEvent::M_MTE1>(operandFree[i]);
            SetFlag<HardEvent::FIX_M>(cFree[i]);
        }
        SetMMRowMajor();SetAtomicNone();SetLoadDataBoundary((uint64_t)0);SetLoadDataPaddingValue(0);
    }
    __aicore__ inline void LoadWeight(uint32_t e) {
        if(e==lastExpert)return;
        legacy_gmm::Fence<HardEvent::MTE1_MTE2>();
        const uint32_t bytes=(sh.k+511)/512*512+512;
        InitConstValueParams<uint16_t> zero{1,(uint16_t)(bytes/32),0,uint16_t(0)};
        InitConstValue(w1.ReinterpretCast<uint16_t>(),zero);PipeBarrier<PIPE_MTE2>();
        Nd2NzParams p;p.ndNum=1;p.nValue=1;p.dValue=sh.k;p.srcDValue=sh.k;
        p.srcNdMatrixStride=0;p.dstNzC0Stride=1;p.dstNzNStride=1;p.dstNzMatrixStride=0;
        DataCopy(w1,ws[(uint64_t)e*sh.k],p);
        legacy_gmm::Fence<HardEvent::MTE2_MTE1>();lastExpert=e;
    }
    __aicore__ inline void Prefetch(uint32_t slot,uint32_t row,uint32_t rows,uint32_t k0) {
        WaitFlag<HardEvent::MTE1_MTE2>(packetFree[slot]);
        const uint32_t kk=sh.k-k0<PK?sh.k-k0:PK,rr=(rows+31)/32*32;
        auto dest=x1[slot*R*PK];legacy_gmm::ZeroNzRows(dest,rows,rr,kk);
        Nd2NzParams p;p.ndNum=1;p.nValue=rows;p.dValue=kk;p.srcDValue=sh.k;
        p.srcNdMatrixStride=0;p.dstNzC0Stride=rr;p.dstNzNStride=1;p.dstNzMatrixStride=0;
        DataCopy(dest,xs[(uint64_t)row*sh.k+k0],p);
        SetFlag<HardEvent::MTE2_MTE1>(packetReady[slot]);
    }
    __aicore__ inline void Compute(uint32_t serial,uint32_t e,uint32_t row,uint32_t rows) {
        LoadWeight(e);
        const uint32_t packets=(sh.k+PK-1)/PK,rr=(rows+31)/32*32,cs=serial&1;
        Prefetch(0,row,rows,0);if(packets>1)Prefetch(1,row,rows,PK);
        WaitFlag<HardEvent::FIX_M>(cFree[cs]);
        for(uint32_t p=0;p<packets;++p) {
            const uint32_t ps=p&1,k0=p*PK,kk=sh.k-k0<PK?sh.k-k0:PK;
            WaitFlag<HardEvent::MTE2_MTE1>(packetReady[ps]);
            for(uint32_t ko=0;ko<kk;ko+=BK) {
                const uint32_t slot=(sequence++)&1,k=((kk-ko<BK?kk-ko:BK)+31)/32*32;
                WaitFlag<HardEvent::M_MTE1>(operandFree[slot]);
                LoadData2DParams a;a.repeatTimes=1;a.srcStride=1;a.dstGap=0;a.ifTranspose=false;
                LoadData(a0[slot*512],w1[k0+ko],a);
                LoadData2DParams b;b.repeatTimes=rr*k/512;b.srcStride=1;b.dstGap=0;b.ifTranspose=false;
                LoadData(b0[slot*R*BK],x1[ps*R*PK+ko*rr],b);
                if(ko+BK>=kk) {
                    SetFlag<HardEvent::MTE1_MTE2>(packetFree[ps]);
                    if(p+2<packets)Prefetch(ps,row,rows,(p+2)*PK);
                }
                SetFlag<HardEvent::MTE1_M>(operandReady[slot]);
                WaitFlag<HardEvent::MTE1_M>(operandReady[slot]);
                MmadParams mm;mm.m=1;mm.n=rr;mm.k=k;mm.cmatrixInitVal=p==0 && ko==0;
                mm.unitFlag=(p+1==packets && ko+BK>=kk)?3:2;
                Mmad(c0[cs*16*R],a0[slot*512],b0[slot*R*BK],mm);
                PipeBarrier<PIPE_M>();SetFlag<HardEvent::M_MTE1>(operandFree[slot]);
            }
        }
    }
    __aicore__ inline void Publish(uint32_t serial,GlobalTensor<int32_t> ring,uint32_t rows) {
        const uint32_t frame=serial%4;CrossCoreWaitFlag<2>(12+frame);
        FixpipeParamsV220 fp;fp.nSize=(rows+31)/32*32;fp.mSize=1;fp.srcStride=16;fp.dstStride=R;
        fp.ndNum=1;fp.srcNdStride=0;fp.dstNdStride=0;fp.unitFlag=3;
        Fixpipe(ring[frame*R],c0[(serial&1)*16*R],fp);
        SetFlag<HardEvent::FIX_M>(cFree[serial&1]);CrossCoreSetFlag<2,PIPE_FIX>(8+frame);
    }
    __aicore__ inline void Drain() {
        for(uint32_t i=0;i<2;++i) {
            WaitFlag<HardEvent::MTE1_MTE2>(packetFree[i]);WaitFlag<HardEvent::M_MTE1>(operandFree[i]);WaitFlag<HardEvent::FIX_M>(cFree[i]);
        }
        for(uint32_t i=0;i<4;++i)CrossCoreWaitFlag<2>(12+i);
    }
};
#endif

template<uint32_t R,uint32_t BK,uint32_t PK>
__schedmode__(1) __global__ __mix__(1,2) void RowDotKernel(
    GM_ADDR x,GM_ADDR w,GM_ADDR s,GM_ADDR g,GM_ADDR y,GM_ADDR workspace,Shape sh) {
    static_assert(BK==256 && R*BK*2<=65536 && PK%BK==0,"native dot buffer budget");
    TPipe pipe;
#if defined(__DAV_CUBE__)
    const uint32_t worker=GetBlockIdx();
#else
    const uint32_t worker=GetBlockIdx()/2,sub=GetBlockIdx()%2;
#endif
    grouped_matmul_gelu::Shape ps{sh.m,sh.k,1,sh.e,1,0,R,BK,0,0,0};
    GlobalTensor<int32_t> ring;ring.SetGlobalBuffer((__gm__ int32_t*)workspace+worker*4*R);
#if defined(__DAV_CUBE__)
    grouped_matmul_gelu::Segments<1,128,false> schedule(g,ps,worker,sh.workers);
    RowDotProducer<R,BK,PK> producer;producer.Init(pipe,x,w,sh);
#else
    TBuf<TPosition::VECCALC> gb,ib,zb,ub,ob;
    pipe.InitBuffer(gb,1024);pipe.InitBuffer(ib,R*4);pipe.InitBuffer(zb,R*4);pipe.InitBuffer(ub,R*4);pipe.InitBuffer(ob,R*2);
    grouped_matmul_gelu::Segments<1,128,true> schedule(g,ps,worker,sh.workers,gb.Get<int64_t>());
    auto input=ib.Get<int32_t>();auto z=zb.Get<float>();auto u=ub.Get<float>();auto out=ob.Get<half>();
    GlobalTensor<float> scales;scales.SetGlobalBuffer((__gm__ float*)s);
    GlobalTensor<half> output;output.SetGlobalBuffer((__gm__ half*)y);
    const event_t inputFree=(event_t)pipe.AllocEventID<HardEvent::V_MTE2>();
    SetFlag<HardEvent::V_MTE2>(inputFree);
    uint32_t lastExpert=~0u;float alpha=0.0f;
    for(uint32_t f=0;f<4;++f)CrossCoreSetFlag<2,PIPE_MTE2>(12+f);
#endif
    grouped_matmul_gelu::Segment seg;uint32_t serial=0;
    while(schedule.Next(seg)) {
#if defined(__DAV_CUBE__)
        producer.Compute(serial,seg.expert,seg.row,seg.rows);producer.Publish(serial,ring,seg.rows);
#else
        const uint32_t frame=serial%4;CrossCoreWaitFlag<2>(8+frame);
        if((serial&1)==sub) {
            if(lastExpert!=(uint32_t)seg.expert){alpha=scales.GetValue(seg.expert);lastExpert=seg.expert;}
            const uint32_t count=(seg.rows+31)/32*32;
            WaitFlag<HardEvent::V_MTE2>(inputFree);
            DataCopy(input,ring[frame*R],count);
            CrossCoreSetFlag<2,PIPE_MTE2>(12+frame);
            legacy_gmm::Fence<HardEvent::MTE2_V>();
            Cast(z,input,RoundMode::CAST_RINT,count);PipeBarrier<PIPE_V>();
            SetFlag<HardEvent::V_MTE2>(inputFree);
            auto zp=(__ubuf__ float*)z.GetPhyAddr();auto up=(__ubuf__ float*)u.GetPhyAddr();
            asc_set_mask_count();asc_set_vector_mask(0,count);
            asc_mul_scalar(zp,zp,alpha,1,1,1,8,8);PipeBarrier<PIPE_V>();
            kernel_common::GeluCountMasked(zp,up);
            asc_set_mask_norm();asc_set_vector_mask(~uint64_t(0),~uint64_t(0));
            Cast(out,z,RoundMode::CAST_RINT,count);legacy_gmm::Fence<HardEvent::V_MTE3>();
            DataCopyExtParams copy{1,seg.rows*2,0,0,0};DataCopyPad(output[seg.row],out,copy);
            legacy_gmm::Fence<HardEvent::MTE3_V>();
        } else CrossCoreSetFlag<2,PIPE_MTE2>(12+frame);
#endif
        ++serial;
    }
#if defined(__DAV_CUBE__)
    producer.Drain();
#else
    WaitFlag<HardEvent::V_MTE2>(inputFree);
    PipeBarrier<PIPE_ALL>();
#endif
}
} // namespace fused_gmm

namespace narrow_resident {
using namespace AscendC;
using Shape = legacy_gmm::Shape;
using kernel_common::Fence;
using kernel_common::ZeroNzRows;

#if defined(__DAV_CUBE__)
template<uint32_t TM,uint32_t TN> struct BasicPipeline {
    static constexpr uint32_t PK=1024, BK=512, BCAP=8192;
    static_assert(TN==32 && TM==64, "resident narrow tile");
    GlobalTensor<int8_t> xs,ws;
    LocalTensor<int8_t> a1s,b1s,a2s,b2s;
    LocalTensor<int32_t> cs;
    Shape shape;
    event_t packetFree[2],packetReady[2],l0Free[2],l0Ready[2],cFree[2];
    uint32_t sequence=0,lastE=0xffffffffu,lastN=0xffffffffu;
    __aicore__ inline void Init(TPipe& pipe,GM_ADDR x,GM_ADDR w,Shape sh) {
        shape=sh;
        xs.SetGlobalBuffer((__gm__ int8_t*)x);ws.SetGlobalBuffer((__gm__ int8_t*)w);
        a1s=LocalTensor<int8_t>(TPosition::A1,0,2*TM*PK);
        b1s=LocalTensor<int8_t>(TPosition::B1,2*TM*PK,TN*BCAP);
        a2s=LocalTensor<int8_t>(TPosition::A2,0,2*TM*BK);
        b2s=LocalTensor<int8_t>(TPosition::B2,0,2*TN*BK);
        cs=LocalTensor<int32_t>(TPosition::CO1,0,2*TM*TN);
        for(uint32_t j=0;j<2;++j) {
            packetFree[j]=(event_t)pipe.AllocEventID<HardEvent::MTE1_MTE2>();
            packetReady[j]=(event_t)pipe.AllocEventID<HardEvent::MTE2_MTE1>();
            l0Free[j]=(event_t)pipe.AllocEventID<HardEvent::M_MTE1>();
            l0Ready[j]=(event_t)pipe.AllocEventID<HardEvent::MTE1_M>();
            cFree[j]=(event_t)pipe.AllocEventID<HardEvent::FIX_M>();
            SetFlag<HardEvent::MTE1_MTE2>(packetFree[j]);
            SetFlag<HardEvent::M_MTE1>(l0Free[j]);SetFlag<HardEvent::FIX_M>(cFree[j]);
        }
        SetAtomicNone();SetLoadDataBoundary((uint64_t)0);SetLoadDataPaddingValue(0);
    }
    __aicore__ inline void ResidentB(uint32_t e,uint32_t col,uint32_t cols) {
        if(lastE==e && lastN==col)return;
        Fence<HardEvent::MTE1_MTE2>();
        uint32_t kp=(shape.k+31)/32*32;
        if(shape.n==1 && shape.k>=1024) {
            // A single contiguous K-vector is equally an N=1 row. Load its
            // transpose-view with a wide inner K dimension; no tensor data
            // is transposed on Host or outside this complete kernel.
            ZeroNzRows(b1s,1,32,shape.k);
            Nd2NzParams row;
            row.ndNum=1;row.nValue=1;row.dValue=shape.k;row.srcDValue=shape.k;
            row.srcNdMatrixStride=0;row.dstNzC0Stride=32;row.dstNzNStride=1;row.dstNzMatrixStride=0;
            DataCopy(b1s,ws[(uint64_t)e*shape.k],row);
            Fence<HardEvent::MTE2_MTE1>();lastE=e;lastN=col;return;
        }
        ZeroNzRows(b1s,shape.k,kp,cols);
        Nd2NzParams cp;
        cp.ndNum=1;cp.nValue=shape.k;cp.dValue=cols;cp.srcDValue=shape.n;
        cp.srcNdMatrixStride=0;cp.dstNzC0Stride=kp;cp.dstNzNStride=1;cp.dstNzMatrixStride=0;
        DataCopy(b1s,ws[(uint64_t)e*shape.k*shape.n+col],cp);
        Fence<HardEvent::MTE2_MTE1>();lastE=e;lastN=col;
    }
    __aicore__ inline void Prefetch(uint32_t slot,uint32_t row,uint32_t rows,uint32_t k0) {
        WaitFlag<HardEvent::MTE1_MTE2>(packetFree[slot]);
        uint32_t kk=shape.k-k0<PK?shape.k-k0:PK;
        uint32_t mp=(rows+15)/16*16;
        auto a1=a1s[slot*TM*PK];
        ZeroNzRows(a1,rows,mp,kk);
        Nd2NzParams ap;
        ap.ndNum=1;ap.nValue=rows;ap.dValue=kk;ap.srcDValue=shape.k;
        ap.srcNdMatrixStride=0;ap.dstNzC0Stride=mp;ap.dstNzNStride=1;ap.dstNzMatrixStride=0;
        DataCopy(a1,xs[(uint64_t)row*shape.k+k0],ap);
        SetFlag<HardEvent::MTE2_MTE1>(packetReady[slot]);
    }
    __aicore__ inline void Compute(uint32_t frame,uint32_t e,uint32_t row,uint32_t col,
                                  uint32_t rows,uint32_t cols) {
        WaitFlag<HardEvent::FIX_M>(cFree[frame]);
        ResidentB(e,col,cols);
        uint32_t packets=(shape.k+PK-1)/PK,mb=(rows+15)/16,mp=mb*16;
        uint32_t nb=(cols+31)/32,np=nb*32;
        Prefetch(0,row,rows,0);
        if(packets>1)Prefetch(1,row,rows,PK);
        for(uint32_t p=0;p<packets;++p) {
            uint32_t ps=p&1,k0=p*PK;
            uint32_t kk=shape.k-k0<PK?shape.k-k0:PK;
            uint32_t bStride=(shape.k+31)/32*32;
            auto a1=a1s[ps*TM*PK];
            WaitFlag<HardEvent::MTE2_MTE1>(packetReady[ps]);
            for(uint32_t ko=0;ko<kk;ko+=BK) {
                uint32_t slot=(sequence++)&1,validK=kk-ko<BK?kk-ko:BK;
                uint32_t k=(validK+31)/32*32;
                auto a2=a2s[slot*TM*BK];auto b2=b2s[slot*TN*BK];
                WaitFlag<HardEvent::M_MTE1>(l0Free[slot]);
                LoadData2DParams al;
                al.repeatTimes=k/32;al.srcStride=mb;al.dstGap=0;al.ifTranspose=false;
                for(uint32_t mi=0;mi<mb;++mi)
                    LoadData(a2[mi*16*k],a1[ko*mp+mi*16*32],al);
                LoadData2dTransposeParams bl;
                bl.startIndex=0;bl.repeatTimes=k/32;bl.srcStride=1;bl.dstGap=nb*2-1;bl.dstFracGap=0;
                uint32_t bk0=k0+ko;
                if(shape.n==1 && shape.k>=1024) {
                    // Mmad uses np=32 even for one valid column. Keep both
                    // N16 fractals, with every padded N row explicitly zero.
                    LoadData2DParams direct;
                    direct.startIndex=0;direct.repeatTimes=k/16;direct.srcStride=1;
                    direct.dstGap=0;direct.ifTranspose=false;
                    LoadData(b2,b1s[bk0*32],direct);
                } else {
                    for(uint32_t ni=0;ni<nb;++ni)
                        LoadDataWithTranspose(b2[ni*32*32],b1s[ni*bStride*32+bk0*32],bl);
                }
                SetFlag<HardEvent::MTE1_M>(l0Ready[slot]);WaitFlag<HardEvent::MTE1_M>(l0Ready[slot]);
                MmadParams mm;mm.m=mp;mm.n=np;mm.k=k;mm.cmatrixInitVal=p==0&&ko==0;
                Mmad(cs[frame*TM*TN],a2,b2,mm);
                if((mp/16)*(np/16)<10)PipeBarrier<PIPE_M>();
                SetFlag<HardEvent::M_MTE1>(l0Free[slot]);
            }
            SetFlag<HardEvent::MTE1_MTE2>(packetFree[ps]);
            if(p+2<packets)Prefetch(ps,row,rows,(p+2)*PK);
        }
        Fence<HardEvent::M_FIX>();
    }
    __aicore__ inline void Publish(uint32_t frame,const GlobalTensor<int32_t>& ring,
                                  uint32_t rows,uint32_t cols) {
        if(frame)CrossCoreWaitFlag<2>(11);else CrossCoreWaitFlag<2>(9);
        FixpipeParamsV220 fp;
        fp.nSize=(cols+31)/32*32;fp.mSize=rows;fp.srcStride=(rows+15)/16*16;fp.dstStride=TN;
        fp.ndNum=1;fp.srcNdStride=0;fp.dstNdStride=0;
        Fixpipe(ring[frame*TM*TN],cs[frame*TM*TN],fp);
        SetFlag<HardEvent::FIX_M>(cFree[frame]);
        if(frame)CrossCoreSetFlag<2,PIPE_FIX>(10);else CrossCoreSetFlag<2,PIPE_FIX>(8);
    }
    __aicore__ inline void Drain() {
        for(uint32_t j=0;j<2;++j) {
            WaitFlag<HardEvent::MTE1_MTE2>(packetFree[j]);
            WaitFlag<HardEvent::M_MTE1>(l0Free[j]);WaitFlag<HardEvent::FIX_M>(cFree[j]);
        }
    }
};
#endif
template<uint32_t TM,uint32_t TN>
__global__ __mix__(1,2) void NarrowResidentKernel(GM_ADDR x,GM_ADDR w,GM_ADDR s,
    GM_ADDR g,GM_ADDR y,GM_ADDR workspace,Shape shape) {
#if defined(__DAV_CUBE__)
    uint32_t worker=GetBlockIdx();
#else
    uint32_t worker=GetBlockIdx()/2,sub=GetBlockIdx()%2;
#endif
    TPipe pipe;
    grouped_matmul_gelu::Shape tiles{shape.m,shape.k,shape.n,shape.e,1,0,TM,512,0,0,0};
#if defined(__DAV_CUBE__)
    grouped_matmul_gelu::Segments<13,TN> schedule(g,tiles,worker,shape.workers);
#else
    TBuf<TPosition::VECCALC> groupBuffer;
    pipe.InitBuffer(groupBuffer,(shape.e+3)/4*32);
    grouped_matmul_gelu::Segments<13,TN,true> schedule(g,tiles,worker,shape.workers,groupBuffer.Get<int64_t>());
#endif
    GlobalTensor<int32_t> ring;
    ring.SetGlobalBuffer((__gm__ int32_t*)workspace+worker*2*TM*TN);
#if defined(__DAV_CUBE__)
    BasicPipeline<TM,TN> cube;cube.Init(pipe,x,w,shape);
#else
    legacy_gmm::TiledEpilogue<TM/2,TN> ep;ep.Init(pipe,s,y);
    CrossCoreSetFlag<2,PIPE_MTE2>(9);CrossCoreSetFlag<2,PIPE_MTE2>(11);
#endif
    uint32_t sequence=0;
    grouped_matmul_gelu::Segment tile;
    while (schedule.Next(tile)) {
            uint32_t e=tile.expert,row=tile.row,col=tile.column;
            uint32_t rows=tile.rows,cols=tile.columns;
            uint32_t frame=(sequence++)&1;
#if defined(__DAV_CUBE__)
            cube.Compute(frame,e,row,col,rows,cols);cube.Publish(frame,ring,rows,cols);
#else
            if(frame)CrossCoreWaitFlag<2>(10);else CrossCoreWaitFlag<2>(8);
            // Balance the actual tail, not the nominal TM/2. An empty reader
            // still returns both mode-2 credits, so Cube never waits on a skipped consumer.
            uint32_t top=(rows+1)/2,offset=sub?top:0,myRows=sub?rows-top:top;
            if(myRows) {
                auto c=ep.cb.template Get<int32_t>();
                uint32_t count=(myRows*TN+63u)&~63u;
                if(cols==TN && count==myRows*TN)
                    DataCopy(c,ring[frame*TM*TN+offset*TN],myRows*TN);
                else {
                    Duplicate(c,0,count);Fence<HardEvent::V_MTE2>();
                    DataCopyExtParams cp{(uint16_t)myRows,cols*4,(TN-cols)*4,
                        (TN-((cols+7)/8)*8)/8,0};
                    DataCopyPad(c,ring[frame*TM*TN+offset*TN],cp,{false,0,0,0});
                }
                Fence<HardEvent::MTE2_V>();
            }
            // Mode 2 joins both AIV acknowledgements before the producer can recycle.
            if(frame)CrossCoreSetFlag<2,PIPE_MTE2>(11);else CrossCoreSetFlag<2,PIPE_MTE2>(9);
            if(myRows)ep.Finish(e,row+offset,col,myRows,cols,shape.n);
#endif
    }
#if defined(__DAV_CUBE__)
    cube.Drain();CrossCoreWaitFlag<2>(9);CrossCoreWaitFlag<2>(11);
#else
    ep.Drain();
#endif
}
} // namespace narrow_resident

namespace grouped_matmul_gelu {

inline bool TryNarrowResident(GM_ADDR x, GM_ADDR w, GM_ADDR scale, GM_ADDR groups,
    GM_ADDR y, Shape shape, int64_t available, aclrtStream stream,
    kernel_common::HostPlatform& platform)
{
    if (shape.n > 32 || shape.m < 512 || shape.k < 32)
        return false;
    const uint32_t workers = std::min<int64_t>(available,
        std::min(platform.GetCoreNumAic(), platform.GetCoreNumAiv() / 2));
    if (!workers)
        return false;
    uint64_t l1=0, l0a=0, l0b=0, l0c=0, ub=0;
    using platform_ascendc::CoreMemType;
    platform.GetCoreMemSize(CoreMemType::L1, l1);
    platform.GetCoreMemSize(CoreMemType::L0_A, l0a);
    platform.GetCoreMemSize(CoreMemType::L0_B, l0b);
    platform.GetCoreMemSize(CoreMemType::L0_C, l0c);
    platform.GetCoreMemSize(CoreMemType::UB, ub);

    const bool rowDot = shape.n == 1 && shape.m >= 4096 && shape.k >= 256;
    const bool dotFits = rowDot && l1 >= 278528 && l0a >= 1024 && l0b >= 65536 &&
        l0c >= 16384 && ub >= 8192;
    const bool narrowFits = l1 >= 393216 && l0a >= 65536 && l0b >= 32768 &&
        l0c >= 16384 && ub >= 24 * 1024;
    if (!dotFits && !narrowFits)
        return false;
    const legacy_gmm::Shape compact{uint32_t(shape.experts), uint32_t(shape.m),
        uint32_t(shape.k), uint32_t(shape.n), workers};
    const uint64_t bytes = uint64_t(workers) * (dotFits ? 4*128 : 2*64*32) * sizeof(int32_t);
    void* memory = nullptr;
    if (aclrtMalloc(&memory, bytes, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS)
        return false;
    if (dotFits)
        fused_gmm::RowDotKernel<128,256,1024><<<workers, nullptr, stream>>>(
            x,w,scale,groups,y,(GM_ADDR)memory,compact);
    else
        narrow_resident::NarrowResidentKernel<64,32><<<workers, nullptr, stream>>>(
            x,w,scale,groups,y,(GM_ADDR)memory,compact);
    const auto status = aclrtSynchronizeStream(stream);
    const auto released = aclrtFree(memory);
    if (status != ACL_SUCCESS || released != ACL_SUCCESS)
        throw std::runtime_error("Narrow resident kernel execution or cleanup failed");
    return true;
}

// Small-output N=1 dots avoid padded Cube work and a GM intermediate.
// INT8 unpack and individual FP32 products are exact; every addition is INT32.
__global__ __aicore__ __vector__ void DotKernel(
    GM_ADDR xAddress, GM_ADDR weightAddress, GM_ADDR scaleAddress,
    GM_ADDR groupsAddress, GM_ADDR yAddress, Shape shape, uint32_t paddedK)
{
    const int64_t workers = AscendC::GetBlockNum() * AscendC::GetTaskRatio();
    const int64_t worker = AscendC::GetBlockIdx();
    const int64_t begin = shape.m * worker / workers;
    const int64_t end = shape.m * (worker + 1) / workers;
    if (begin == end) return;
    AscendC::TPipe pipe;
    AscendC::TBuf<AscendC::TPosition::VECCALC> aByteBuffer, bByteBuffer,
        aHalfBuffer, bHalfBuffer, aFloatBuffer, bFloatBuffer, productBuffer, outputBuffer;
    pipe.InitBuffer(aByteBuffer, paddedK);
    pipe.InitBuffer(bByteBuffer, paddedK);
    pipe.InitBuffer(aHalfBuffer, paddedK * sizeof(half));
    pipe.InitBuffer(bHalfBuffer, paddedK * sizeof(half));
    pipe.InitBuffer(aFloatBuffer, paddedK * sizeof(float));
    pipe.InitBuffer(bFloatBuffer, paddedK * sizeof(float));
    pipe.InitBuffer(productBuffer, paddedK * sizeof(int32_t));
    pipe.InitBuffer(outputBuffer, 32);
    auto aByte = aByteBuffer.Get<int8_t>();
    auto bByte = bByteBuffer.Get<int8_t>();
    auto aHalf = aHalfBuffer.Get<half>();
    auto bHalf = bHalfBuffer.Get<half>();
    auto aFloat = aFloatBuffer.Get<float>();
    auto bFloat = bFloatBuffer.Get<float>();
    auto product = productBuffer.Get<int32_t>();
    auto output = outputBuffer.Get<half>();
    AscendC::GlobalTensor<int8_t> x, weight;
    AscendC::GlobalTensor<float> scale;
    AscendC::GlobalTensor<int64_t> groups;
    AscendC::GlobalTensor<half> y;
    x.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(xAddress));
    weight.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(weightAddress));
    scale.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scaleAddress));
    groups.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groupsAddress));
    y.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(yAddress));
    int64_t low = 0, high = shape.experts;
    while (low < high) {
        const int64_t mid = (low + high) / 2;
        if (groups.GetValue(mid) <= begin) low = mid + 1;
        else high = mid;
    }
    int64_t expert = low;
    int64_t groupEnd = groups.GetValue(expert);
    int64_t loadedExpert = -1;
    float channelScale = 0.0f;
    AscendC::Duplicate(aByte.ReinterpretCast<int16_t>(), int16_t(0), paddedK / 2);
    AscendC::Duplicate(bByte.ReinterpretCast<int16_t>(), int16_t(0), paddedK / 2);
    Fence<AscendC::HardEvent::V_MTE2>();
    AscendC::DataCopyExtParams copy{1, static_cast<uint32_t>(shape.k), 0, 0, 0};
    AscendC::DataCopyPadExtParams<int8_t> pad{true, 0,
        static_cast<uint8_t>((shape.k + 31) / 32 * 32 - shape.k), 0};
    uint32_t buffered = 0;
    int64_t outputStart = begin;
    for (int64_t row = begin; row < end; ++row) {
        while (row >= groupEnd) groupEnd = groups.GetValue(++expert);
        const bool newExpert = expert != loadedExpert;
        AscendC::DataCopyPad(aByte, x[row * shape.k], copy, pad);
        if (newExpert) AscendC::DataCopyPad(bByte, weight[expert * shape.k], copy, pad);
        Fence<AscendC::HardEvent::MTE2_V>();
        asc_int82half(Ub(aHalf), Ub(aByte), paddedK);
        AscendC::PipeBarrier<PIPE_V>();
        asc_half2float(Ub(aFloat), Ub(aHalf), paddedK);
        AscendC::PipeBarrier<PIPE_V>();
        if (newExpert) {
            asc_int82half(Ub(bHalf), Ub(bByte), paddedK);
            AscendC::PipeBarrier<PIPE_V>();
            asc_half2float(Ub(bFloat), Ub(bHalf), paddedK);
            AscendC::PipeBarrier<PIPE_V>();
            channelScale = scale.GetValue(expert);
            loadedExpert = expert;
        }
        asc_mul(Ub(aFloat), Ub(aFloat), Ub(bFloat), paddedK);
        AscendC::PipeBarrier<PIPE_V>();
        asc_float2int32_rn(Ub(product), Ub(aFloat), paddedK);
        AscendC::PipeBarrier<PIPE_V>();
        // Power-of-two padding keeps every tree source 32-byte aligned.
        // K<=8192 bounds all partial sums by 2^27, safely inside INT32.
        for (uint32_t count = paddedK / 2; count >= 8; count /= 2) {
            asc_add(Ub(product), Ub(product), Ub(product[count]), count);
            AscendC::PipeBarrier<PIPE_V>();
        }
        Fence<AscendC::HardEvent::V_S>();
        int32_t sum = 0;
        for (uint32_t i = 0; i < 8; ++i) sum += product.GetValue(i);
        const float value = static_cast<float>(sum) * channelScale;
        const float inner = 0.7978845608028654f *
            (value + 0.044715f * value * value * value);
        aFloat.SetValue(0, -2.0f * (inner >= 0.0f ? inner : -inner));
        Fence<AscendC::HardEvent::S_V>();
        asc_exp(Ub(aFloat), Ub(aFloat), uint32_t(1));
        Fence<AscendC::HardEvent::V_S>();
        const float tail = aFloat.GetValue(0);
        const float result = value * (inner >= 0.0f ? 1.0f : tail) / (1.0f + tail);
        output.SetValue(buffered++, static_cast<half>(result));
        if (buffered == 16 || row + 1 == end) {
            Fence<AscendC::HardEvent::S_MTE3>();
            AscendC::DataCopyExtParams copyOut{1, buffered * uint32_t(sizeof(half)), 0, 0, 0};
            AscendC::DataCopyPad(y[outputStart], output, copyOut);
            Fence<AscendC::HardEvent::MTE3_S>();
            outputStart = row + 1;
            buffered = 0;
        }
    }
}

inline bool TryColumnDot(GM_ADDR x, GM_ADDR w, GM_ADDR scale, GM_ADDR groups,
    GM_ADDR y, Shape shape, int64_t available, aclrtStream stream,
    kernel_common::HostPlatform& platform)
{
    if (shape.n != 1 || shape.k < 256)
        return false;
    const uint32_t workers=std::min<int64_t>(available, platform.GetCoreNumAiv());
    if (!workers || (shape.experts > 1 && shape.k < 512 && shape.m > 16ull * workers))
        return false;

    uint32_t paddedK = 256;
    while (paddedK < shape.k) paddedK *= 2;
    uint64_t ub = 0;
    platform.GetCoreMemSize(platform_ascendc::CoreMemType::UB, ub);
    // Two byte arrays, two half arrays, two float arrays and one int32 array.
    if (ub < 18ull * paddedK + 32)
        return false;
    const uint32_t blocks=std::min<int64_t>(shape.m, workers);
    DotKernel<<<blocks, nullptr, stream>>>(x,w,scale,groups,y,shape,paddedK);
    return true;
}

__schedmode__(1) __global__ __mix__(1,2) void StreamedCubeFallbackKernel(
    GM_ADDR x, GM_ADDR w, GM_ADDR scale, GM_ADDR groups, GM_ADDR y,
    GM_ADDR workspace, Shape shape) {
    AscendC::TPipe pipe;
#ifdef __DAV_CUBE__
    CubeRun<false,0>(x,w,groups,workspace,shape,pipe);
#else
    VectorRun<0>(scale,groups,y,workspace,shape,pipe);
#endif
}

#ifndef __DAV_CUBE__
namespace wide_fallback_pack {
constexpr uint32_t Rows = 32;

template<uint32_t Columns>
__aicore__ inline void PreparePanelWeights(
    GM_ADDR weightAddress, GM_ADDR packedAddress, GM_ADDR groupsAddress,
    Shape shape, AscendC::TPipe& pipe) {
    constexpr uint32_t Packet = kKPerTile;
    constexpr uint32_t bytes = Rows * Columns;
    const uint32_t paddedK = (shape.k + Rows - 1) / Rows * Rows;
    const uint32_t paddedN = (shape.n + 31) / 32 * 32;
    const uint32_t chunks = paddedK / Rows;
    const uint32_t panels = (shape.n + Columns - 1) / Columns;
    AscendC::TBuf<AscendC::TPosition::VECCALC> inputBuffer, outputBuffer, groupBuffer;
    pipe.InitBuffer(inputBuffer, 2 * bytes);
    pipe.InitBuffer(outputBuffer, 2 * bytes);
    pipe.InitBuffer(groupBuffer, (shape.experts + 3) / 4 * 32);

    AscendC::GlobalTensor<int8_t> weight, packed;
    AscendC::GlobalTensor<int64_t> groupGm;
    weight.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(weightAddress));
    packed.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(packedAddress));
    groupGm.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groupsAddress));
    auto groups = groupBuffer.Get<int64_t>();
    AscendC::DataCopyPad(groups, groupGm,
        AscendC::DataCopyExtParams{1, uint32_t(shape.experts * 8), 0, 0, 0}, {false, 0, 0, 0});
    Fence<AscendC::HardEvent::MTE2_S>();

    event_t inputFree[2], inputReady[2], outputFree[2];
    for (uint32_t i = 0; i < 2; ++i) {
        inputFree[i] = static_cast<event_t>(pipe.AllocEventID<AscendC::HardEvent::V_MTE2>());
        inputReady[i] = static_cast<event_t>(pipe.AllocEventID<AscendC::HardEvent::MTE2_V>());
        outputFree[i] = static_cast<event_t>(pipe.AllocEventID<AscendC::HardEvent::MTE3_V>());
        AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(inputFree[i]);
        AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(outputFree[i]);
    }

    const uint32_t tasksPerExpert = chunks * panels;
    const uint32_t tasks = shape.experts * tasksPerExpert;
    uint32_t sequence = 0;
    for (uint32_t task = AscendC::GetBlockIdx(); task < tasks; task += AscendC::GetBlockNum() * 2) {
        const uint32_t expert = task / tasksPerExpert;
        if (groups.GetValue(expert) == (expert ? groups.GetValue(expert - 1) : 0))
            continue;

        const uint32_t panel = task % panels;
        const uint32_t col = panel * Columns;
        const uint32_t k0 = (task % tasksPerExpert / panels) * Rows;
        const uint32_t width = shape.n - col < Columns ? uint32_t(shape.n) - col : Columns;
        const uint32_t pitch = (width + 31) / 32 * 32;
        const uint32_t valid = shape.k - k0 < Rows ? uint32_t(shape.k) - k0 : Rows;
        const uint32_t packetStart = k0 / Packet * Packet;
        const uint32_t packetK = paddedK - packetStart < Packet ? paddedK - packetStart : Packet;
        const uint32_t slot = sequence++ & 1;
        auto input = inputBuffer.Get<int8_t>()[slot * bytes];
        auto output = outputBuffer.Get<int8_t>()[slot * bytes];

        AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(inputFree[slot]);
        if (valid < Rows) {
            AscendC::Duplicate(input.ReinterpretCast<int16_t>(), int16_t(0), Rows * pitch / 2);
            Fence<AscendC::HardEvent::V_MTE2>();
        }
        AscendC::DataCopyPad(input, weight[(uint64_t(expert) * shape.k + k0) * shape.n + col],
            AscendC::DataCopyExtParams{
                uint16_t(valid), width, uint32_t(shape.n) - width, 0, 0},
            {true, 0, uint8_t(pitch - width), int8_t(0)});
        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(inputReady[slot]);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(inputReady[slot]);
        AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(outputFree[slot]);

        const uint64_t all = ~uint64_t(0);
        asc_set_mask_norm();
        for (uint32_t plane = 0; plane < pitch / 32; plane += 8) {
            const uint32_t remaining = pitch / 32 - plane;
            const uint32_t lanes = (remaining < 8 ? remaining : 8) * 16;
            const uint64_t high = lanes > 64 ? (lanes == 128 ? all : (uint64_t(1) << (lanes - 64)) - 1) : 0;
            const uint64_t low = lanes >= 64 ? all : (uint64_t(1) << lanes) - 1;
            asc_set_vector_mask(high, low);
            asc_copy(Ub(output.ReinterpretCast<uint16_t>()[plane * Rows * 16]),
                Ub(input.ReinterpretCast<uint16_t>()[plane * 16]),
                uint8_t(Rows), uint16_t(Rows), 1, 1, uint16_t(pitch / 32));
        }
        asc_set_vector_mask(all, all);
        AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(inputFree[slot]);
        Fence<AscendC::HardEvent::V_MTE3>();
        const uint64_t offset = uint64_t(expert) * paddedK * paddedN +
            uint64_t(packetStart) * paddedN + uint64_t(col) * packetK +
            uint64_t(k0 - packetStart) * 32;
        AscendC::DataCopy(packed[offset], output,
            AscendC::DataCopyParams{uint16_t(pitch / 32), uint16_t(Rows), 0, uint16_t(packetK - Rows)});
        AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(outputFree[slot]);
    }

    for (uint32_t i = 0; i < 2; ++i) {
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(inputFree[i]);
        AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(outputFree[i]);
        pipe.ReleaseEventID<AscendC::HardEvent::V_MTE2>(inputFree[i]);
        pipe.ReleaseEventID<AscendC::HardEvent::MTE2_V>(inputReady[i]);
        pipe.ReleaseEventID<AscendC::HardEvent::MTE3_V>(outputFree[i]);
    }
}
} // namespace wide_fallback_pack
#endif


template<bool PanelWeights, bool ReuseSlab = false>
__attribute__((section(".gmmg_wide_pack_text"),aligned(128)))
__schedmode__(1) __global__ __mix__(1,2) void PackedWeightFallbackKernel(
    GM_ADDR x, GM_ADDR w, GM_ADDR scale, GM_ADDR groups, GM_ADDR y,
    GM_ADDR workspace, Shape shape, uint64_t weightOffset, bool widePack, bool groupedTiles) {
    AscendC::TPipe pipe;
    GM_ADDR packed = workspace + weightOffset;
#ifndef __DAV_CUBE__
    Shape packing = shape;
    packing.residentK = (shape.k + 31) / 32 * 32;
    packing.packedPartials = (shape.n + 31) / 32 * 32;
    if constexpr (PanelWeights) {
        if (widePack)
            wide_fallback_pack::PreparePanelWeights<1024>(w,packed,groups,packing,pipe);
        else
            wide_fallback_pack::PreparePanelWeights<256>(w,packed,groups,packing,pipe);
    } else
        PackLongKWeights<kKPerTile>(w,packed,groups,packing,pipe);
#endif
    AscendC::PipeBarrier<PIPE_ALL>();
    AscendC::SyncAll<false>();
#ifdef __DAV_CUBE__
    if (groupedTiles)
        CubeRun<ReuseSlab,1,0,kRowsPerCubeTile,kColumnsPerTile,Segments,true>(
            x,packed,groups,workspace,shape,pipe);
    else
        CubeRun<ReuseSlab,0,0,kRowsPerCubeTile,kColumnsPerTile,Segments,true>(
            x,packed,groups,workspace,shape,pipe);
#else
    pipe.Reset();
    if (groupedTiles)
        VectorRun<1>(scale,groups,y,workspace,shape,pipe);
    else
        VectorRun<0>(scale,groups,y,workspace,shape,pipe);
#endif
}

__attribute__((section(".gmmg_wide_resident_pair_text"),aligned(128)))
__schedmode__(1) __global__ __mix__(1,2) void WideResidentPackedPairKernel(
    GM_ADDR x, GM_ADDR w, GM_ADDR scale, GM_ADDR groups, GM_ADDR y,
    GM_ADDR workspace, Shape s, uint64_t packedOffset) {
    AscendC::TPipe pipe;
    GM_ADDR packed=workspace+packedOffset;
#ifdef __DAV_CUBE__
    PairedEarlyCube<false,true>(x,packed,groups,workspace,s,pipe);
#else
    Shape packing=s;
    packing.residentK=(s.k+31)/32*32;
    packing.packedPartials=(s.n+31)/32*32;
    wide_fallback_pack::PreparePanelWeights<1024>(w,packed,groups,packing,pipe);
    AscendC::PipeBarrier<PIPE_ALL>();
    AscendC::SyncAll<false>();
    pipe.Reset();
    VectorRun<4,64,256,32>(scale,groups,y,workspace,s,pipe);
#endif
}

inline bool TryStreamedCubeFallback(
    GM_ADDR x, GM_ADDR w, GM_ADDR scale, GM_ADDR groups, GM_ADDR y,
    Shape shape, int64_t available, aclrtStream stream,
    kernel_common::HostPlatform& platform) {
    constexpr uint32_t Rows = kRowsPerCubeTile, Columns = kColumnsPerTile;
    constexpr uint32_t Depth = kKPerTile;
    const uint64_t macs = uint64_t(shape.m) * shape.k * shape.n;
    // Keep all existing large jobs eligible, and account for the scalar
    // K loop in the Vector fallback even when either matrix side is thin.
    const bool narrow = shape.n < 32;
    const bool existingCube = shape.k >= 32 &&
        (narrow ? shape.n >= 8 && shape.m >= 128 && macs >= 16ull*1024*1024
                : macs >= 4ull*1024*1024);
    const uint64_t vectorSteps = uint64_t(shape.m) * ((shape.n + 63) / 64) * shape.k;
    if (!existingCube && vectorSteps < (1ull << 16))
        return false;
    uint32_t workers=std::min<int64_t>(available,
        std::min(platform.GetCoreNumAic(),platform.GetCoreNumAiv()/2));
    if (!workers) return false;

    shape.columnTiles=(shape.n+Columns-1)/Columns;
    shape.kTile=Depth;
    shape.residentK=0;
    shape.slabK=0;
    shape.rowTile=Rows;
    // Smaller row tiles fill the device when the output has few columns.
    // Group splits and true lengths are still handled by Segments<0>.
    while (shape.rowTile>16 &&
        uint64_t((shape.m+shape.rowTile-1)/shape.rowTile)*shape.columnTiles<workers)
        shape.rowTile/=2;
    const uint64_t tasks=uint64_t((shape.m+shape.rowTile-1)/shape.rowTile)*shape.columnTiles;
    workers=std::min<uint64_t>(workers,tasks);

    constexpr uint64_t l1Need=2ull*(Rows+Columns)*Depth+512+4096;
    constexpr uint64_t l0aNeed=2ull*Rows*Depth, l0bNeed=2ull*Columns*Depth;
    constexpr uint64_t l0cNeed=2ull*kL0CSlotElements*sizeof(int32_t);
    constexpr uint64_t vectorElements=kStripeRows*Columns;
    constexpr uint64_t ubNeed=uint64_t(Rows/2)*Columns*sizeof(int32_t)+
        2*(vectorElements*sizeof(float)+256)+(Columns*sizeof(float)+256)+
        vectorElements*sizeof(half);
    const uint64_t groupBytes=(shape.experts+3)/4*32;
    uint64_t l1=0,l0a=0,l0b=0,l0c=0,ub=0;
    platform.GetCoreMemSize(platform_ascendc::CoreMemType::L1,l1);
    platform.GetCoreMemSize(platform_ascendc::CoreMemType::L0_A,l0a);
    platform.GetCoreMemSize(platform_ascendc::CoreMemType::L0_B,l0b);
    platform.GetCoreMemSize(platform_ascendc::CoreMemType::L0_C,l0c);
    platform.GetCoreMemSize(platform_ascendc::CoreMemType::UB,ub);
    if (l1<l1Need || l0a<l0aNeed || l0b<l0bNeed || l0c<l0cNeed || ub<ubNeed+groupBytes)
        return false;

    void* workspace=nullptr;
    const uint64_t bytes=uint64_t(workers)*kSlots*kTileElements*sizeof(int32_t);
    const uint32_t paddedK = (shape.k + 31) / 32 * 32;
    const uint32_t paddedN = (shape.n + 31) / 32 * 32;
    const uint64_t weightBytes = uint64_t(shape.experts) * paddedK * paddedN;
    const uint64_t rowTiles = (shape.m + shape.rowTile - 1) / shape.rowTile;
    const bool fullRows = shape.n % 32 != 0 && 4ull*32*paddedN + groupBytes <= ub;
    const bool panels = !fullRows && shape.n % 256 != 0 && 4ull*32*256 + groupBytes <= ub;
    const uint64_t residentL1 = uint64_t(Rows)*paddedK + 2ull*Columns*Depth + 2*512 + 4096;
    const bool reuseA = shape.columnTiles >= 4 && shape.k >= Depth &&
        rowTiles >= 3 * shape.experts && residentL1 <= l1;
    const bool regularPack = (fullRows || panels) && rowTiles >= 2 * shape.experts &&
        weightBytes <= 32ull*1024*1024;
    // More row consumers can amortize a full packing pass even on aligned B.
    const bool largePack = !reuseA && shape.k >= 4*Depth &&
        shape.columnTiles >= 3 &&
        (rowTiles >= 2 * shape.experts || rowTiles >= 4ull*workers) &&
        weightBytes <= 256ull*1024*1024 && 4ull*32*256 + groupBytes <= ub;
    const bool contiguousPack = 4ull*32*paddedN + groupBytes <= ub && (fullRows || largePack);
    const bool pack = shape.n > 32 && shape.k >= 2*Depth && (regularPack || largePack);
    const bool widePack = shape.n >= 1024 && 4ull*32*1024 + groupBytes <= ub;
    // Preserve full M128 segments across unaligned expert boundaries, and
    // distribute the resulting tiles instead of fixed nominal-row bands.
    const bool groupedTiles = largePack && shape.k >= 8*Depth &&
        shape.experts <= workers*2 && shape.columnTiles >= 4;
    if (reuseA) shape.residentK=paddedK;
    if (pack && aclrtMalloc(&workspace,bytes+weightBytes,ACL_MEM_MALLOC_HUGE_FIRST)==ACL_SUCCESS) {
        // With depth spanning multiple slabs, retain each A slab for both
        // neighboring N panels. Both INT32 accumulators stay in L0 until full K.
        if (largePack && shape.columnTiles >= 6 && l1 >= l1Need + 4ull*Rows*Depth) {
            shape.slabK = 4*Depth;
            if (l1 >= l1Need + 8ull*Rows*Depth) shape.slabK = 8*Depth;
            if (contiguousPack)
                PackedWeightFallbackKernel<false,true><<<workers,nullptr,stream>>>(
                    x,w,scale,groups,y,(GM_ADDR)workspace,shape,bytes,widePack,groupedTiles);
            else
                PackedWeightFallbackKernel<true,true><<<workers,nullptr,stream>>>(
                    x,w,scale,groups,y,(GM_ADDR)workspace,shape,bytes,widePack,groupedTiles);
        } else if (contiguousPack)
            PackedWeightFallbackKernel<false><<<workers,nullptr,stream>>>(
                x,w,scale,groups,y,(GM_ADDR)workspace,shape,bytes,widePack,groupedTiles);
        else
            PackedWeightFallbackKernel<true><<<workers,nullptr,stream>>>(
                x,w,scale,groups,y,(GM_ADDR)workspace,shape,bytes,widePack,groupedTiles);
    } else {
        if (aclrtMalloc(&workspace,bytes,ACL_MEM_MALLOC_HUGE_FIRST)!=ACL_SUCCESS)
            return false;
        // A deeper packet reduces ND-to-NZ copy submissions while the
        // existing L0 footprint fits one K512 slot instead of two K256 slots.
        const uint64_t deepL1Need = l1Need + 2ull*(Rows+Columns)*Depth;
        if (!reuseA && shape.k >= 4*Depth && shape.columnTiles > 1 &&
            tasks >= 2ull*workers && l1 >= deepL1Need)
            shape.kTile = 2*Depth;
        StreamedCubeFallbackKernel<<<workers,nullptr,stream>>>(
            x,w,scale,groups,y,(GM_ADDR)workspace,shape);
    }
    const auto status=aclrtSynchronizeStream(stream);
    const auto released=aclrtFree(workspace);
    if (status!=ACL_SUCCESS || released!=ACL_SUCCESS)
        throw std::runtime_error("Streamed Cube fallback execution or cleanup failed");
    return true;
}

} // namespace grouped_matmul_gelu



namespace fused_gmm {
__aicore__ inline void K1PrefetchX(LocalTensor<int8_t> local,
    GlobalTensor<int8_t> global,uint32_t row,uint32_t rows) {
    DataCopyExtParams cp{1,rows,0,0,0};
    DataCopyPad(local,global[row],cp,{true,0,(uint8_t)(32-rows),int8_t(0)});
    SetFlag<HardEvent::MTE2_S>(static_cast<event_t>(0));
}

// Full K=1 INT32 outer product. Actual groups, invocation-local UB,
// persistent W/scale, early X recycle and independent FP16 output slots.
__attribute__((section(".gmmg_k1_text"),aligned(128)))
__global__ __vector__ void K1VectorKernel(GM_ADDR x,GM_ADDR w,GM_ADDR s,
    GM_ADDR g,GM_ADDR y,Shape shape) {
    constexpr uint32_t R=16,N=512,Elements=R*N,OutStride=Elements+128;
    TPipe pipe;
    TBuf<TPosition::VECCALC> gb,xb,wb,whb,wib,sb,ab,zb,ub,ob;
    pipe.InitBuffer(gb,1024);pipe.InitBuffer(xb,32);
    pipe.InitBuffer(wb,N);pipe.InitBuffer(whb,N*2);pipe.InitBuffer(wib,N*4);
    pipe.InitBuffer(sb,N*4);pipe.InitBuffer(ab,Elements*4);
    pipe.InitBuffer(zb,Elements*4+256);pipe.InitBuffer(ub,Elements*4+256);
    pipe.InitBuffer(ob,2*OutStride*2);
    auto groups=gb.Get<int64_t>();auto xv=xb.Get<int8_t>();
    auto wv=wb.Get<int8_t>();auto wh=whb.Get<half>();auto wi=wib.Get<int32_t>();
    auto scales=sb.Get<float>();auto acc=ab.Get<int32_t>();
    auto z=zb.Get<float>();auto u=ub.Get<float>();auto outputs=ob.Get<half>();
    GlobalTensor<int8_t> xs,ws;GlobalTensor<float> ss;
    GlobalTensor<int64_t> gs;GlobalTensor<half> ys;
    xs.SetGlobalBuffer((__gm__ int8_t*)x);ws.SetGlobalBuffer((__gm__ int8_t*)w);
    ss.SetGlobalBuffer((__gm__ float*)s);gs.SetGlobalBuffer((__gm__ int64_t*)g);
    ys.SetGlobalBuffer((__gm__ half*)y);
    event_t outputFree[2];
    for(uint32_t i=0;i<2;++i) {
        outputFree[i]=static_cast<event_t>(pipe.AllocEventID<HardEvent::MTE3_V>());
        SetFlag<HardEvent::MTE3_V>(outputFree[i]);
    }
    DataCopyExtParams gp{1,shape.e*8,0,0,0};
    DataCopyPad(groups,gs,gp,{false,0,0,0});
    kernel_common::FixedFence<HardEvent::MTE2_S>();
    const uint32_t first=(uint64_t)shape.m*GetBlockIdx()/shape.workers;
    const uint32_t last=(uint64_t)shape.m*(GetBlockIdx()+1)/shape.workers;
    uint32_t expert=0,hi=shape.e;
    while(expert<hi) {
        const uint32_t mid=(expert+hi)/2;
        if((uint32_t)groups.GetValue(mid)<=first)expert=mid+1;else hi=mid;
    }
    uint32_t row=first,sequence=0;
    while(row<last) {
        uint32_t groupEnd=(uint32_t)groups.GetValue(expert);
        while(row>=groupEnd)groupEnd=(uint32_t)groups.GetValue(++expert);
        const uint32_t end=groupEnd<last?groupEnd:last;
        for(uint32_t col=0;col<shape.n;col+=N) {
            const uint32_t cols=shape.n-col<N?shape.n-col:N;
            const uint32_t pn=(cols+15)/16*16,np=(cols+31)/32*32;
            Duplicate(scales,0.0f,pn);
            kernel_common::FixedFence<HardEvent::V_MTE2>();
            DataCopyExtParams wp{1,cols,0,0,0},sp{1,cols*4,0,0,0};
            DataCopyPad(wv,ws[(uint64_t)expert*shape.n+col],wp,
                {true,0,(uint8_t)(np-cols),int8_t(0)});
            DataCopyPad(scales,ss[(uint64_t)expert*shape.n+col],sp,
                {true,0,(uint8_t)((cols+7)/8*8-cols),0.0f});
            kernel_common::FixedFence<HardEvent::MTE2_V>();
            Cast(wh,wv,RoundMode::CAST_NONE,np);PipeBarrier<PIPE_V>();
            Cast(wi,wh,RoundMode::CAST_RINT,np);PipeBarrier<PIPE_V>();
            K1PrefetchX(xv,xs,row,end-row<R?end-row:R);
            for(uint32_t start=row;start<end;start+=R) {
                const uint32_t rows=end-start<R?end-start:R,elements=rows*pn;
                WaitFlag<HardEvent::MTE2_S>(static_cast<event_t>(0));
                for(uint32_t r=0;r<rows;++r)
                    Muls(acc[r*pn],wi,(int32_t)xv.GetValue(r),pn);
                PipeBarrier<PIPE_V>();
                // Only scalar reads X; recycle it before the current epilogue.
                kernel_common::FixedFence<HardEvent::S_MTE2>();
                if(start+R<end)K1PrefetchX(xv,xs,start+R,end-start-R<R?end-start-R:R);
                Cast(z,acc,RoundMode::CAST_RINT,elements);PipeBarrier<PIPE_V>();
#if defined(__DAV_VEC__)
                for(uint32_t c=0;c<pn;c+=64) {
                    const uint32_t count=pn-c<64?pn-c:64;
                    asc_set_mask_norm();
                    asc_set_vector_mask(0,count==64?~uint64_t(0):(uint64_t(1)<<count)-1);
                    asc_mul(kernel_common::Ub(z[c]),kernel_common::Ub(z[c]),
                        kernel_common::Ub(scales[c]),(uint8_t)rows,1,1,1,
                        (uint8_t)(pn/8),(uint8_t)(pn/8),0);
                }
                PipeBarrier<PIPE_V>();
                asc_set_mask_count();asc_set_vector_mask(0,elements);
                kernel_common::GeluCountMasked(kernel_common::Ub(z),kernel_common::Ub(u));
                asc_set_mask_norm();asc_set_vector_mask(~uint64_t(0),~uint64_t(0));
#endif
                const uint32_t slot=sequence++&1u;
                WaitFlag<HardEvent::MTE3_V>(outputFree[slot]);
                auto out=outputs[slot*OutStride];
                Cast(out,z,RoundMode::CAST_RINT,elements);
                kernel_common::FixedFence<HardEvent::V_MTE3>();
                DataCopyExtParams cp{(uint16_t)rows,cols*2,0,(shape.n-cols)*2,0};
                DataCopyPad(ys[(uint64_t)start*shape.n+col],out,cp);
                SetFlag<HardEvent::MTE3_V>(outputFree[slot]);
            }
        }
        row=end;
    }
    for(uint32_t i=0;i<2;++i) {
        WaitFlag<HardEvent::MTE3_V>(outputFree[i]);
        pipe.ReleaseEventID<HardEvent::MTE3_V>(outputFree[i]);
    }
}
} // namespace fused_gmm


// Host dispatch uses dimensions and invocation-local hardware capabilities.
namespace grouped_matmul_gelu {
inline void LaunchGeneralPaired(GM_ADDR x,GM_ADDR weight,GM_ADDR scale,GM_ADDR group_list,GM_ADDR y,
    Shape shape,int64_t availableCoreNum,aclrtStream stream,kernel_common::HostPlatform& hardware) {
    if(shape.experts==1 && shape.n>64 && shape.n<=128 && shape.k>=128 && shape.k<=256 && shape.m>16 &&
        (shape.n==kColumnsPerTile || shape.m<=kRowsPerCubeTile)) {
        const uint32_t capacity=std::min<int64_t>(availableCoreNum,std::min(hardware.GetCoreNumAic(),hardware.GetCoreNumAiv()/2));
        const uint32_t blocks=(shape.m+15)/16,kp=(shape.k+31)/32*32;
        uint64_t l1=0,la=0,lb=0,lc=0,ub=0;
        hardware.GetCoreMemSize(platform_ascendc::CoreMemType::L1,l1);
        hardware.GetCoreMemSize(platform_ascendc::CoreMemType::L0_A,la);
        hardware.GetCoreMemSize(platform_ascendc::CoreMemType::L0_B,lb);
        hardware.GetCoreMemSize(platform_ascendc::CoreMemType::L0_C,lc);
        hardware.GetCoreMemSize(platform_ascendc::CoreMemType::UB,ub);
        if(blocks<=capacity && l1>=144ull*kp+4096 && la>=16ull*kp && lb>=128ull*kp && lc>=8192 && ub>=16384) {
            shape.rowTile=16;shape.kTile=kp;
            void* workspace=nullptr;
            if(aclrtMalloc(&workspace,uint64_t(blocks)*16*128*4,ACL_MEM_MALLOC_HUGE_FIRST)!=ACL_SUCCESS)
                throw std::runtime_error("Small matmul workspace allocation failed");
            OneShotSmallMatmulKernel<<<blocks,nullptr,stream>>>(x,weight,scale,group_list,y,(GM_ADDR)workspace,shape,kp);
            const auto error=aclrtSynchronizeStream(stream),freed=aclrtFree(workspace);
            if(error!=ACL_SUCCESS || freed!=ACL_SUCCESS)throw std::runtime_error("Small matmul kernel or cleanup failed");
            return;
        }
    }
    auto* platform = &hardware;
    uint64_t vectorUbBytes = 0;
    platform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, vectorUbBytes);
    int64_t vectorCapacity = platform->GetCoreNumAiv();
    if (availableCoreNum < vectorCapacity) vectorCapacity = availableCoreNum;
    int64_t capacity = platform->GetCoreNumAic();
    if (availableCoreNum < capacity) capacity = availableCoreNum;
    const int64_t pairs = platform->GetCoreNumAiv() / 2;
    if (pairs < capacity) capacity = pairs;
    shape.vectorPrefetch = vectorUbBytes >= 160 * 1024 && shape.experts > capacity &&
        shape.k * shape.n < 256 * 1024;
    uint64_t l1Bytes = 0;
    platform->GetCoreMemSize(platform_ascendc::CoreMemType::L1, l1Bytes);
    const uint32_t paddedK = (shape.k + 31) / 32 * 32;
    const uint64_t residentBytes = uint64_t(kRowsPerCubeTile) * paddedK;
    if (shape.columnTiles > 1 && residentBytes + 2 * kKPerTile * kColumnsPerTile + 4096 <= l1Bytes)
        shape.residentK = paddedK;
    shape.rowTile = 1;
    while (shape.rowTile < kRowsPerCubeTile && shape.rowTile * 2 <= shape.m / shape.experts)
        shape.rowTile *= 2;
    const int64_t pairedNTasks = (shape.m + 63) / 64 * ((shape.n + 511) / 512);
    if (capacity > 0 && shape.rowTile == 64 && shape.k >= 512 && shape.k <= 2048 && shape.n >= 512 &&
        (pairedNTasks >= capacity ||
            (pairedNTasks < capacity && (shape.m + 63) / 64 * ((shape.n + 255) / 256) > capacity)) &&
        uint64_t(64) * paddedK + 2 * uint64_t(256) * 512 + 4096 <= l1Bytes) {
        uint64_t l0a = 0, l0b = 0, l0c = 0, ub = 0;
        platform->GetCoreMemSize(platform_ascendc::CoreMemType::L0_A, l0a);
        platform->GetCoreMemSize(platform_ascendc::CoreMemType::L0_B, l0b);
        platform->GetCoreMemSize(platform_ascendc::CoreMemType::L0_C, l0c);
        platform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ub);
        if (l0a >= 16384 && l0b >= 65536 && l0c >= 131072 && ub >= 120 * 1024) {
            shape.rowTile = 64;
            shape.columnTiles = (shape.n + 511) / 512;
            shape.residentK = paddedK;
            shape.kTile = 128;
            // Actual expert tails can exceed the shape-grid estimate.
            const uint32_t blocks = capacity;
            void* pairedWorkspace = nullptr;
            if (aclrtMalloc(&pairedWorkspace, uint64_t(blocks) * kSlots * kTileElements * 4,
                ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS)
                throw std::runtime_error("Paired N workspace allocation failed");
            if(shape.experts>capacity && shape.k<=2*256 && l0a>=64ull*paddedK &&
                uint64_t(64+(shape.n+31)/32*32)*paddedK+4096<=l1Bytes)
            {
                const uint64_t minRows = (shape.m + 63) / 64;
                const uint64_t panels = (shape.n + 255) / 256;
                const uint64_t wholeMax = (minRows + blocks - 1) / blocks * panels;
                const uint64_t panelMax = (minRows * panels + blocks - 1) / blocks;
                if (shape.k == 2 * 256 && shape.n > 512 && shape.n % 256 == 0 &&
                    panelMax < wholeMax &&
                    uint64_t(64 + shape.n) * paddedK + 4096 <= l1Bytes) {
                    shape.columnTiles = panels;
                    GridLookaheadInputPanelKernel<<<blocks,nullptr,stream>>>(x,weight,scale,group_list,y,
                        (GM_ADDR)pairedWorkspace,shape);
                } else if(shape.k == 2*256 && shape.n > 512 && shape.n%32 == 0 &&
                    uint64_t(64+shape.n)*paddedK + 4096 <= l1Bytes)
                    InplaceLookaheadInputPanelKernel<<<blocks,nullptr,stream>>>(x,weight,scale,group_list,y,
                        (GM_ADDR)pairedWorkspace,shape);
                else if(shape.k%256==0 && shape.n%32==0)
                    EarlyInputPanelKernel<<<blocks,nullptr,stream>>>(x,weight,scale,group_list,y,
                        (GM_ADDR)pairedWorkspace,shape);
                else
                    RetainedOperandKernel<<<blocks,nullptr,stream>>>(x,weight,scale,group_list,y,
                        (GM_ADDR)pairedWorkspace,shape);
            }
            else if (shape.experts > capacity)
                PairedNKernel<true><<<blocks, nullptr, stream>>>(x, weight, scale, group_list, y,
                    (GM_ADDR)pairedWorkspace, shape);
            else if(shape.k>=1024 && l0a>=32768 &&
                std::max<uint64_t>(128*uint64_t(paddedK)+2*256*256,
                    64*uint64_t(paddedK)+2*256*512)+4096<=l1Bytes)
            {
                if(shape.k%256==0 && shape.n%256==0)
                    AdaptiveStaggerKernel<<<blocks,nullptr,stream>>>(x,weight,scale,group_list,y,
                        (GM_ADDR)pairedWorkspace,shape);
                else
                    AdaptiveNKernel<<<blocks,nullptr,stream>>>(x,weight,scale,group_list,y,
                        (GM_ADDR)pairedWorkspace,shape);
            }
            else
                PairedNKernel<false><<<blocks, nullptr, stream>>>(x, weight, scale, group_list, y,
                    (GM_ADDR)pairedWorkspace, shape);
            const aclError err = aclrtSynchronizeStream(stream);
            const aclError freeErr = aclrtFree(pairedWorkspace);
            if (err != ACL_SUCCESS || freeErr != ACL_SUCCESS)
                throw std::runtime_error("Paired N kernel execution failed");
            return;
        }
    }
    const int64_t pairedTasks = (shape.m + 127) / 128 * ((shape.n + 255) / 256);
    if (capacity > 0 && shape.rowTile == 128 && shape.k >= 512 && shape.k <= 2048 && shape.n >= 2 * 256 &&
        (pairedTasks >= capacity ||
            (pairedTasks < capacity && (shape.m + 127) / 128 * ((shape.n + 127) / 128) > capacity &&
             (shape.m + 63) / 64 * ((shape.n + 255) / 256) > capacity)) &&
        uint64_t(128) * paddedK + 2 * uint64_t(256) * 256 + 4096 <= l1Bytes) {
        uint64_t l0a = 0, l0b = 0, l0c = 0, ub = 0;
        platform->GetCoreMemSize(platform_ascendc::CoreMemType::L0_A, l0a);
        platform->GetCoreMemSize(platform_ascendc::CoreMemType::L0_B, l0b);
        platform->GetCoreMemSize(platform_ascendc::CoreMemType::L0_C, l0c);
        platform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ub);
        if (l0a >= 32768 && l0b >= 65536 && l0c >= 131072 && ub >= 120 * 1024) {
            shape.columnTiles = (shape.n + 255) / 256;
            shape.residentK = paddedK;
            shape.kTile = 128;
            const uint32_t blocks = capacity;
            constexpr uint32_t tailPacket = 256;
            const uint64_t tailArena = std::max<uint64_t>(uint64_t(128)*paddedK+2*uint64_t(tailPacket)*256,
                uint64_t(192)*paddedK+2*uint64_t(256)*128);
            const bool mergeTail = shape.experts<=capacity && shape.k>1344 &&
                shape.m<=((shape.n&31)?960:928)*shape.experts &&
                (shape.m+191)/192*((shape.n+255)/256)>=capacity &&
                tailArena+4096<=l1Bytes && l0a>=49152 && ub>=160*1024;
            const uint32_t ringSlots = mergeTail?4:kSlots;
            void* pairedWorkspace = nullptr;
            const uint64_t ringBytes = uint64_t(blocks)*ringSlots*kTileElements*sizeof(int32_t);
            const uint64_t groups = (shape.experts+3)/4*32;
            const uint64_t packedBytes = uint64_t(shape.experts)*paddedK*((shape.n+31)/32*32);
            // Wide N repeatedly reads each B panel after resident A is loaded.
            // Amortize the pack only when many row tiles share each expert's B.
            const bool packWide = shape.experts<=blocks && shape.n>8*256 &&
                (shape.m+127)/128>=4*shape.experts && packedBytes<=96ull*1024*1024 &&
                4ull*32*1024+groups<=ub;
            if (packWide && aclrtMalloc(&pairedWorkspace,ringBytes+packedBytes,ACL_MEM_MALLOC_HUGE_FIRST)==ACL_SUCCESS) {
                WideResidentPackedPairKernel<<<blocks,nullptr,stream>>>(x,weight,scale,group_list,y,
                    (GM_ADDR)pairedWorkspace,shape,ringBytes);
                const aclError err=aclrtSynchronizeStream(stream), released=aclrtFree(pairedWorkspace);
                if (err!=ACL_SUCCESS || released!=ACL_SUCCESS)
                    throw std::runtime_error("Wide resident packed pair failed");
                return;
            }
            if (aclrtMalloc(&pairedWorkspace, ringBytes,
                ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS)
                throw std::runtime_error("Paired workspace allocation failed");
            if (mergeTail) {
                TailMergeKernel<256><<<blocks,nullptr,stream>>>(x,weight,scale,group_list,y,
                    (GM_ADDR)pairedWorkspace,shape);
            } else if (shape.experts > capacity)
                PairedEarlyKernel<true><<<blocks, nullptr, stream>>>(x, weight, scale, group_list, y,
                    (GM_ADDR)pairedWorkspace, shape);
            else if(shape.k<=1024 && shape.k%256==0 && shape.n%256==0)
                PairedStaggerKernel<<<blocks,nullptr,stream>>>(x,weight,scale,group_list,y,
                    (GM_ADDR)pairedWorkspace,shape);
            else
                PairedEarlyKernel<false><<<blocks, nullptr, stream>>>(x, weight, scale, group_list, y,
                    (GM_ADDR)pairedWorkspace, shape);
            const aclError err = aclrtSynchronizeStream(stream);
            const aclError freeErr = aclrtFree(pairedWorkspace);
            if (err != ACL_SUCCESS || freeErr != ACL_SUCCESS)
                throw std::runtime_error("Paired kernel execution failed");
            return;
        }
    }
    legacy_gmm::Shape fallback{uint32_t(shape.experts),uint32_t(shape.m),uint32_t(shape.k),uint32_t(shape.n),0};
    if (legacy_gmm::LaunchRetained(x,weight,scale,group_list,y,fallback,
            availableCoreNum,stream,hardware,false) ||
        TryStreamedCubeFallback(x,weight,scale,group_list,y,shape,availableCoreNum,stream,hardware))
        return;
    legacy_gmm::LaunchRetained(x,weight,scale,group_list,y,fallback,availableCoreNum,stream,hardware);
}

inline bool TryShortGroups(GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groups, GM_ADDR y,
    uint32_t experts, uint32_t rows, uint32_t depth, uint32_t columns,
    int64_t available, aclrtStream stream, kernel_common::HostPlatform& hardware) {
    if (experts < 64 || rows < 4096 || columns != 256 ||
        depth < 128 || depth > 256 || depth % 32 != 0)
        return false;
    const uint32_t workers = std::min<int64_t>(available,
        std::min(hardware.GetCoreNumAic(), hardware.GetCoreNumAiv() / 2));
    uint64_t l1=0,l0a=0,l0b=0,l0c=0,ub=0;
    hardware.GetCoreMemSize(platform_ascendc::CoreMemType::L1,l1);
    hardware.GetCoreMemSize(platform_ascendc::CoreMemType::L0_A,l0a);
    hardware.GetCoreMemSize(platform_ascendc::CoreMemType::L0_B,l0b);
    hardware.GetCoreMemSize(platform_ascendc::CoreMemType::L0_C,l0c);
    hardware.GetCoreMemSize(platform_ascendc::CoreMemType::UB,ub);
    if (!workers || workers >= experts ||
        uint64_t(rows) * columns >= uint64_t(workers) * 2 * 65536 ||
        l1 < 163840 || l0a < 32768 || l0b < 65536 || l0c < 131072 || ub < 189440)
        return false;

    uint32_t rowTile = 1;
    while (rowTile < 64 && rowTile * 2 <= rows / experts)
        rowTile *= 2;
    Shape shape{rows,depth,columns,experts,1,0,rowTile,128,0,1,0};
    void* workspace = nullptr;
    if (aclrtMalloc(&workspace,uint64_t(workers)*4*64*256*sizeof(int32_t),
        ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS)
        throw std::runtime_error("Workspace allocation failed");
    fused_gmm::ShortGroupKernel<<<workers, nullptr, stream>>>(
        x, weight, scale, groups, y, (GM_ADDR)workspace, shape, workers);
    const auto status = aclrtSynchronizeStream(stream);
    const auto released = aclrtFree(workspace);
    if (status != ACL_SUCCESS || released != ACL_SUCCESS)
        throw std::runtime_error("Kernel or cleanup failed");
    return true;
}

inline bool TryResidentWeightTail(GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groups, GM_ADDR y,
    uint32_t experts, uint32_t rows, uint32_t depth, uint32_t columns,
    int64_t available, aclrtStream stream, kernel_common::HostPlatform& hardware) {
    if (rows < 512 || depth < 2 || depth > 1344 || columns < 128 || columns % 32 == 0)
        return false;
    const uint32_t workers = std::min<int64_t>(available,
        std::min(hardware.GetCoreNumAic(), hardware.GetCoreNumAiv() / 2));
    uint64_t l1=0,l0a=0,l0b=0,l0c=0,ub=0;
    hardware.GetCoreMemSize(platform_ascendc::CoreMemType::L1,l1);
    hardware.GetCoreMemSize(platform_ascendc::CoreMemType::L0_A,l0a);
    hardware.GetCoreMemSize(platform_ascendc::CoreMemType::L0_B,l0b);
    hardware.GetCoreMemSize(platform_ascendc::CoreMemType::L0_C,l0c);
    hardware.GetCoreMemSize(platform_ascendc::CoreMemType::UB,ub);
    const uint32_t paddedK = (depth + 31) / 32 * 32;
    const uint64_t row64 = (rows + 63) / 64, row128 = (rows + 127) / 128;
    const uint64_t col128 = (columns + 127) / 128, col256 = (columns + 255) / 256;
    const uint64_t pairedNTasks = row64 * ((columns + 511) / 512);
    const uint64_t pairedMTasks = row128 * col256;
    const uint64_t pairArena = uint64_t(128)*paddedK + 2*256*256 + 4096;
    const bool keepAdaptive = depth > 1024 && rows/experts >= 64 && rows/experts < 128 &&
        experts <= workers && columns >= 512 &&
        (pairedNTasks >= workers || row64*col256 > workers) &&
        std::max(pairArena, uint64_t(64)*paddedK + 2*256*512 + 4096) <= l1;
    const bool keepPaired = depth > 1024 && rows/experts >= 128 && rows/experts < 256 &&
        experts <= workers && columns >= 512 &&
        (pairedMTasks >= workers || (row128*col128 > workers && row64*col256 > workers)) &&
        pairArena <= l1;
    const uint64_t arena = std::max<uint64_t>(
        uint64_t(384)*paddedK + (depth > 1024 ? 4096 : 0),128*paddedK+65536+1024);
    if (keepAdaptive || keepPaired || !workers || l1 < arena || l0a < 65536 ||
        l0b < 65536 || l0c < 131072 || ub < 176*1024)
        return false;

    Shape shape{rows,depth,columns,experts,uint32_t(col256),paddedK,64,128,0,1,0};
    Shape fallback = MakeShape(experts,rows,depth,columns);
    fallback.residentK = paddedK;
    fallback.rowTile = 1;
    while (fallback.rowTile < 128 && fallback.rowTile * 2 <= rows/experts)
        fallback.rowTile *= 2;
    fallback.vectorPrefetch = ub >= 160*1024 && experts > workers && uint64_t(depth)*columns < 256*1024;
    void* workspace = nullptr;
    if (aclrtMalloc(&workspace,uint64_t(workers)*2*16384*sizeof(int32_t),
        ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS)
        throw std::runtime_error("Resident weight workspace allocation failed");
    ResidentWeightKernel<<<workers, nullptr, stream>>>(
        x, weight, scale, groups, y, (GM_ADDR)workspace, shape, fallback);
    const auto status = aclrtSynchronizeStream(stream);
    const auto released = aclrtFree(workspace);
    if (status != ACL_SUCCESS || released != ACL_SUCCESS)
        throw std::runtime_error("Resident weight kernel or cleanup failed");
    return true;
}

inline void Dispatch(GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groups, GM_ADDR y,
    uint32_t experts, uint32_t rows, uint32_t depth, uint32_t columns,
    int64_t available, aclrtStream stream) {
    kernel_common::HostPlatform hardware;
    if (TryOneRowTiny(x,weight,scale,groups,y,experts,rows,depth,columns,available,stream,hardware))
        return;
    const Shape shape = MakeShape(experts, rows, depth, columns);
    if (TryNarrowResident(x,weight,scale,groups,y,shape,available,stream,hardware))
        return;
    if (TryColumnDot(x,weight,scale,groups,y,shape,available,stream,hardware))
        return;
    if (depth == 1 && rows >= 128 && columns >= 128) {
        uint64_t ub = 0;
        hardware.GetCoreMemSize(platform_ascendc::CoreMemType::UB,ub);
        const uint32_t workers = std::min<int64_t>(available,hardware.GetCoreNumAiv());
        if (workers && ub >= 144*1024) {
            const fused_gmm::Shape outerProduct{experts,rows,depth,columns,workers};
            fused_gmm::K1VectorKernel<<<workers,nullptr,stream>>>(x,weight,scale,groups,y,outerProduct);
            return;
        }
    }
    if (TryAlignedSchedule(x,weight,scale,groups,y,shape,available,stream,hardware))
        return;
    if (TryDesktopMixedPaired(x, weight, scale, groups, y, experts, rows, depth, columns, available, stream) ||
        TryTailRotate(x, weight, scale, groups, y, experts, rows, depth, columns, available, stream, hardware) ||
        TryFlatN256(x, weight, scale, groups, y, experts, rows, depth, columns, available, stream, hardware) ||
        TrySplitNzPackets(x, weight, scale, groups, y, experts, rows, depth, columns, available, stream, hardware) ||
        TryLaunchNzWeights(x, weight, scale, groups, y, experts, rows, depth, columns, available, stream, hardware))
        return;

    const bool tiny = depth <= 4 && columns <= 8 && rows <= 32 && experts <= 16;
    const bool middleTail = experts > 1 && rows >= 512 && columns > 256 && columns < 512 &&
        depth >= 256 && depth <= 1024;
    if (tiny || middleTail) {
        const legacy_gmm::Shape retained{experts,rows,depth,columns,0};
        if (legacy_gmm::LaunchRetained(x,weight,scale,groups,y,retained,
                available,stream,hardware,false) ||
            TryStreamedCubeFallback(x,weight,scale,groups,y,shape,available,stream,hardware))
            return;
        legacy_gmm::LaunchRetained(x,weight,scale,groups,y,retained,available,stream,hardware);
        return;
    }
    if (TryShortGroups(x, weight, scale, groups, y, experts, rows, depth, columns, available, stream, hardware) ||
        TryResidentWeightTail(x, weight, scale, groups, y, experts, rows, depth, columns, available, stream, hardware))
        return;

    LaunchGeneralPaired(x, weight, scale, groups, y, shape, available, stream, hardware);
}
} // namespace grouped_matmul_gelu



extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& xInfo,
    GM_ADDR weight, const TensorGroupInfo& weightInfo,
    GM_ADDR scale, const TensorGroupInfo& scaleInfo,
    GM_ADDR groups, const TensorGroupInfo& groupInfo,
    GM_ADDR y, const TensorGroupInfo& yInfo, int64_t available, aclrtStream stream) {
    legacy_gmm::Validate(xInfo, weightInfo, scaleInfo, groupInfo, yInfo);
    if (!x || !weight || !scale || !groups || !y || available <= 0)
        throw std::runtime_error("Invalid device pointers/core count");

    const auto experts = uint32_t(weightInfo.tensors[0].shape[0]);
    const auto rows = uint32_t(xInfo.tensors[0].shape[0]);
    const auto depth = uint32_t(xInfo.tensors[0].shape[1]);
    const auto columns = uint32_t(weightInfo.tensors[0].shape[2]);
    grouped_matmul_gelu::Dispatch(x, weight, scale, groups, y,
        experts, rows, depth, columns, available, stream);
}


namespace grouped_matmul_gelu {
#ifdef __DAV_CUBE__
template<bool ShortPrefix>
__aicore__ inline void SharedErsPrefixMatmul(AscendC::GlobalTensor<int32_t> ring,
    Shape s,uint32_t rows,uint32_t bandMp,uint32_t rowOffset,
    AscendC::LocalTensor<int8_t> a1,AscendC::LocalTensor<int8_t> aTail,AscendC::LocalTensor<int8_t> b1,
    AscendC::LocalTensor<int8_t> aAll,AscendC::LocalTensor<int8_t> bAll,
    AscendC::LocalTensor<int32_t> cAll,event_t (&free)[2],event_t (&ready)[2],
    event_t (&cFree)[2],event_t tailReady,event_t aReady,bool firstTile,bool newTail,
    uint32_t& sequence,uint32_t& kSequence,AscendC::LocalTensor<int8_t> stagedTail,
    bool stageOther,bool useStaged,event_t otherReady,AscendC::GlobalTensor<int8_t> x,int64_t otherRow,
    uint32_t otherRows) {
    constexpr uint32_t Columns=256,MadK=128,HeadK=256,PrefixK=ShortPrefix?768:896;
    const uint32_t mp=(rows+15)/16*16;
    const uint32_t firstM=mp<64?mp:64;
    const uint32_t secondM=mp>64?mp-64:0;
    const uint32_t cs=sequence&1,cs2=cs^1;
    auto c0=cAll[cs*kL0CSlotElements],c1=cAll[cs2*kL0CSlotElements];
    AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(cFree[cs]);
    if(secondM)AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(cFree[cs2]);
    for(uint32_t k0=0;k0<s.k;k0+=MadK,++kSequence){
        const uint32_t count=s.k-k0<MadK?s.k-k0:MadK;
        const uint32_t kp=(count+31)/32*32,ks=kSequence&1;
        auto a2=aAll[ks*128*128],b2=bAll[ks*256*128];
        AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(free[ks]);
        AscendC::LoadData2DParams ap{};
        ap.repeatTimes=kp/32;
        if(k0>=PrefixK){
            if(newTail&&k0==PrefixK)AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(aReady);
            ap.srcStride=mp/16;
            auto aSource=aTail[(k0-PrefixK)*mp];
            if constexpr(ShortPrefix) {
                if(useStaged&&k0==PrefixK) {
                    if(!firstTile)AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(otherReady);
                    aSource=stagedTail;
                }
            }
            for(uint32_t m=0;m<mp/16;++m)
                AscendC::LoadData(a2[m*kp*16],aSource[m*512],ap);
        }else{
            ap.srcStride=bandMp/16;
            for(uint32_t m=0;m<mp/16;++m)
                AscendC::LoadData(a2[m*kp*16],a1[k0*bandMp+(rowOffset/16+m)*512],ap);
        }
        if(firstTile&&k0==HeadK)AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(tailReady);
        if constexpr(ShortPrefix) {
            if(stageOther&&k0==(useStaged?PrefixK:HeadK)) {
                // With serpentine traversal this first tile can itself
                // read the previous panel's staged stripe at K768. Only
                // overwrite after that final MTE1 reader, not at K256.
                Fence<AscendC::HardEvent::MTE1_MTE2>();
                const uint32_t otherMp=(otherRows+15)/16*16;
                kernel_common::ZeroNzRows(stagedTail,otherRows,otherMp,128);
                const AscendC::Nd2NzParams cp{1,uint16_t(otherRows),128,0,uint16_t(s.k),
                    uint16_t(otherMp),1,0};
                AscendC::DataCopy(stagedTail,x[otherRow*s.k+PrefixK],cp);
                AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(otherReady);
            }
        }
        AscendC::LoadData2dTransposeParams bp{};
        bp.repeatTimes=Columns/32;bp.srcStride=s.residentK/32;bp.dstGap=1;
        for(uint32_t k=0;k<kp/32;++k)
            AscendC::LoadDataWithTranspose(b2[k*Columns*32],b1[k0*32+k*1024],bp);
        AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(ready[ks]);
        AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(ready[ks]);
        const bool last=k0+MadK>=s.k;
        AscendC::MmadParams mm{};
        mm.m=firstM;mm.n=Columns;mm.k=kp;mm.cmatrixInitVal=k0==0;
        mm.unitFlag=last?3:2;
        AscendC::Mmad(c0,a2,b2,mm);
        if(last)PublishSelectiveAppendPanel(ring,c0,firstM,Columns,sequence,cFree[cs]);
        if(secondM){
            mm.m=secondM;
            AscendC::Mmad(c1,a2[64*kp],b2,mm);
            if(last)PublishSelectiveAppendPanel(ring,c1,secondM,Columns,sequence,cFree[cs2]);
        }
        AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(free[ks]);
    }
}

template<bool ShortPrefix>
__aicore__ inline void SharedErsBandCube(GM_ADDR xAddress,GM_ADDR weightAddress,GM_ADDR groups,GM_ADDR workspace,
    Shape s,uint64_t ringOffset,AscendC::TPipe& pipe,ErsBandPlan plan) {
    constexpr uint32_t Head=256,PrefixK=ShortPrefix?768:896;
    constexpr uint32_t TailK=ShortPrefix?256:128;
    const uint32_t worker=AscendC::GetBlockIdx();
    AscendC::GlobalTensor<int8_t> x,weight;
    AscendC::GlobalTensor<int32_t> ring;
    x.SetGlobalBuffer((__gm__ int8_t*)xAddress);
    weight.SetGlobalBuffer((__gm__ int8_t*)workspace);
    ring.SetGlobalBuffer((__gm__ int32_t*)(workspace+ringOffset)+worker*18*kTileElements);
    AscendC::SetAtomicNone();AscendC::SetMMRowMajor();
    AscendC::SetLoadDataBoundary(uint64_t(0));AscendC::SetLoadDataPaddingValue(uint64_t(0));
    if constexpr(ShortPrefix) {
        uint32_t active=0,mask=0;
        AscendC::GlobalTensor<int64_t> groupEnds;
        groupEnds.SetGlobalBuffer((__gm__ int64_t*)groups);
        uint32_t previous=0;
        for(uint32_t e=0;e<s.experts;++e){
            const uint32_t end=uint32_t(groupEnds.GetValue(e));
            if(end>previous){mask|=uint32_t(1)<<e;++active;}
            previous=end;
        }
        PrepareLowCubeNzAll<224,800,Head>(weightAddress,workspace,s,pipe,mask,active);
    }
    AscendC::TBuf<AscendC::TPosition::A1> ab1;
    AscendC::TBuf<AscendC::TPosition::B1> bb1;
    AscendC::TBuf<AscendC::TPosition::A2> ab;
    AscendC::TBuf<AscendC::TPosition::B2> bb;
    AscendC::TBuf<AscendC::TPosition::CO1> cb;
    pipe.InitBuffer(ab1,256*PrefixK+128*TailK+(ShortPrefix?128*128:0));
    pipe.InitBuffer(bb1,256*s.residentK);
    pipe.InitBuffer(ab,2*128*128);pipe.InitBuffer(bb,2*256*128);
    pipe.InitBuffer(cb,2*kL0CSlotElements*sizeof(int32_t));
    auto a1=ab1.Get<int8_t>(),b1=bb1.Get<int8_t>(),aAll=ab.Get<int8_t>(),bAll=bb.Get<int8_t>();
    auto aTail=a1[256*PrefixK];
    auto stagedTail=a1[256*PrefixK+128*TailK];
    auto cAll=cb.Get<int32_t>();
    event_t free[2],ready[2],cFree[2];
    for(uint32_t i=0;i<2;++i){
        free[i]=(event_t)pipe.AllocEventID<AscendC::HardEvent::M_MTE1>();
        ready[i]=(event_t)pipe.AllocEventID<AscendC::HardEvent::MTE1_M>();
        cFree[i]=(event_t)pipe.AllocEventID<AscendC::HardEvent::FIX_M>();
        AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(free[i]);
        AscendC::SetFlag<AscendC::HardEvent::FIX_M>(cFree[i]);
    }
    const auto tailReady=(event_t)pipe.AllocEventID<AscendC::HardEvent::MTE2_MTE1>();
    const auto aReady=(event_t)pipe.AllocEventID<AscendC::HardEvent::MTE2_MTE1>();
    event_t otherReady=static_cast<event_t>(0);
    if constexpr(ShortPrefix)otherReady=(event_t)pipe.AllocEventID<AscendC::HardEvent::MTE2_MTE1>();
    ErsBandIterator<false> bands(groups,s,worker,AscendC::GetBlockNum(),plan);
    ErsBand band;
    bool live=bands.Next(band);
    if(live)LoadNzResidentRowTail(a1,x,s,band.rows,0,PrefixK);
    AscendC::PipeBarrier<PIPE_ALL>();AscendC::SyncAll<false>();
    uint32_t sequence=0,kSequence=0;
    while(live){
        int64_t loadedTail=-1,loadedStripe=-1;
        const uint32_t bandMp=(band.rows.rows+15)/16*16;
        for(uint32_t col=0;col<3;++col){
            if(!((band.panelMask>>col)&1u))continue;
            const uint64_t base=(uint64_t(band.rows.expert)*s.packedPartials+col*256)*s.residentK;
            const uint16_t tail=s.residentK-Head;
            Fence<AscendC::HardEvent::MTE1_MTE2>();
            AscendC::DataCopy(b1,weight[base],AscendC::DataCopyParams{8,Head,tail,tail});
            Fence<AscendC::HardEvent::MTE2_MTE1>();
            AscendC::DataCopy(b1[Head*32],weight[base+Head*32],AscendC::DataCopyParams{8,tail,Head,Head});
            AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(tailReady);
            const bool paired=band.rows.rows>128;
            for(uint32_t tile=0;tile<(paired?2:1);++tile){
                const uint32_t offset=((col&1)&&paired?1-tile:tile)*128;
                const uint32_t rows=band.rows.rows-offset<128?band.rows.rows-offset:128;
                const int64_t row=band.rows.row+offset;
                const bool newTail=loadedTail!=row;
                if(newTail){
                    const uint32_t mp=(rows+15)/16*16;
                    Fence<AscendC::HardEvent::MTE1_MTE2>();
                    const bool staged=ShortPrefix&&tile;
                    const uint32_t start=PrefixK+(staged?128:0);
                    kernel_common::ZeroNzRows(aTail,rows,mp,TailK);
                    AscendC::Nd2NzParams cp{};
                    cp.ndNum=1;cp.nValue=rows;cp.dValue=s.k-start;cp.srcDValue=s.k;
                    cp.dstNzC0Stride=mp;cp.dstNzNStride=1;
                    AscendC::DataCopy(aTail[(start-PrefixK)*mp],x[row*s.k+start],cp);
                    AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(aReady);
                    loadedTail=row;
                }
                const uint32_t otherOffset=offset^128;
                const uint32_t otherRows=paired?
                    (band.rows.rows-otherOffset<128?band.rows.rows-otherOffset:128):0;
                SharedErsPrefixMatmul<ShortPrefix>(ring,s,rows,bandMp,offset,a1,aTail,b1,
                    aAll,bAll,cAll,free,ready,cFree,tailReady,aReady,tile==0,newTail,sequence,kSequence,
                    stagedTail,paired&&tile==0,tile!=0||loadedStripe==row,
                    otherReady,x,band.rows.row+otherOffset,otherRows);
                if constexpr(ShortPrefix)if(tile)loadedStripe=row;
            }
        }
        live=bands.Next(band);
        if(live)LoadNzResidentRowTail(a1,x,s,band.rows,0,PrefixK);
    }
    if constexpr(ShortPrefix)pipe.ReleaseEventID<AscendC::HardEvent::MTE2_MTE1>(otherReady);
    pipe.ReleaseEventID<AscendC::HardEvent::MTE2_MTE1>(aReady);
    pipe.ReleaseEventID<AscendC::HardEvent::MTE2_MTE1>(tailReady);
    for(uint32_t i=0;i<2;++i){
        AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(free[i]);
        AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(cFree[i]);
        pipe.ReleaseEventID<AscendC::HardEvent::M_MTE1>(free[i]);
        pipe.ReleaseEventID<AscendC::HardEvent::MTE1_M>(ready[i]);
        pipe.ReleaseEventID<AscendC::HardEvent::FIX_M>(cFree[i]);
    }
}
#endif

template<bool Enabled,bool ShortPrefix=false>
__attribute__((section(".gmmg_ers_text"),aligned(128))) __schedmode__(1) __global__ __mix__(1,2) void SharedErsResidentBandKernel(GM_ADDR x,GM_ADDR w,
    GM_ADDR scale,GM_ADDR groups,GM_ADDR y,GM_ADDR workspace,Shape shape,uint64_t ringOffset) {
    AscendC::TPipe pipe;
    const auto plan=BuildErsBandPlan(groups,shape);
    const bool resident=Enabled&&plan.Supported(AscendC::GetBlockNum());
#ifdef __DAV_CUBE__
    if(resident)SharedErsBandCube<ShortPrefix>(x,w,groups,workspace,shape,ringOffset,pipe,plan);
    else ErsNativeEarlyCube<false,true,true>(x,workspace,groups,workspace+ringOffset,shape,pipe);
#else
    if constexpr(ShortPrefix) {
        if(resident) {
            uint32_t active=0,mask=0;
            AscendC::GlobalTensor<int64_t> groupEnds;
            groupEnds.SetGlobalBuffer((__gm__ int64_t*)groups);
            uint32_t previous=0;
            for(uint32_t e=0;e<shape.experts;++e){
                const uint32_t end=uint32_t(groupEnds.GetValue(e));
                if(end>previous){mask|=uint32_t(1)<<e;++active;}
                previous=end;
            }
            Shape packShape=shape;
            // Four AIV preparation buffers share the native-C UB budget.
            if(packShape.slabK>58)packShape.slabK=58;
            PrepareWaveNzWeights<true,256>(w,workspace,packShape,pipe,mask,active);
        } else if(shape.vectorPrefetch) {
            PrepareNzWeightsFullRows(w,workspace,groups,shape,pipe);
        } else {
            PrepareNzWeights(w,workspace,groups,shape,pipe);
        }
    } else if(shape.vectorPrefetch) {
        PrepareNzWeightsFullRows(w,workspace,groups,shape,pipe);
    } else {
        PrepareNzWeights(w,workspace,groups,shape,pipe);
    }
    AscendC::PipeBarrier<PIPE_ALL>();AscendC::SyncAll<false>();pipe.Reset();
    if(resident){
        AscendC::TBuf<AscendC::TPosition::VECCALC> metadata;
        pipe.InitBuffer(metadata,(shape.experts+3)/4*32);
        auto local=metadata.Get<int64_t>();
        AscendC::GlobalTensor<int64_t> g;g.SetGlobalBuffer((__gm__ int64_t*)groups);
        AscendC::DataCopyExtParams copy{1,uint32_t(shape.experts*8),0,0,0};
        AscendC::DataCopyPadExtParams<int64_t> pad{false,0,0,0};
        AscendC::DataCopyPad(local,g,copy,pad);Fence<AscendC::HardEvent::MTE2_S>();
        ErsBandConsumer segments(groups,shape,AscendC::GetBlockIdx()/2,
            AscendC::GetBlockNum(),plan,local);
        WeightWaveVector<ErsBandConsumer,18>(scale,y,workspace+ringOffset,shape,pipe,segments);
    }else NativeCVectorRun<4>(scale,groups,y,workspace+ringOffset,shape,pipe);
#endif
}


static void LaunchSharedErs(GM_ADDR x,GM_ADDR w,GM_ADDR scale,GM_ADDR groups,
    GM_ADDR y,GM_ADDR workspace,Shape shape,uint64_t ringOffset,uint32_t workers,aclrtStream stream) {
    SharedErsResidentBandKernel<true,true><<<workers,nullptr,stream>>>(
        x,w,scale,groups,y,workspace,shape,ringOffset);
}
} // namespace grouped_matmul_gelu
