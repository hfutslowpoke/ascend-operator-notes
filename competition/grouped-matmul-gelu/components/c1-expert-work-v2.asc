namespace c1_expert_work_pipeline {
using namespace AscendC;
constexpr int COLS = 256;
constexpr int READER_ROWS = 64;
constexpr int C_ELEMS = READER_ROWS * COLS;
constexpr int MATH_ROWS = 16;
constexpr int MATH_ELEMS = MATH_ROWS * COLS;

struct Lifetimes {
  bool c0VectorReader = false;
  bool heldMte3Reader = false;
  bool c1Mte3Reader = false;
};

__aicore__ inline void StagePanel(
    int panel, int row, int first, int rows, int expert, int ownedN, int n,
    GlobalTensor<int32_t> &raw, GlobalTensor<float> &scales,
    LocalTensor<int32_t> value, LocalTensor<float> scale,
    Lifetimes &live) {
  if (panel == 0 && live.c0VectorReader) {
    // Only CQ0 and scale0 wait for their own previous Vector readers.
    WaitFlag<HardEvent::V_MTE2>(6);
    live.c0VectorReader = false;
  }
  if (panel == 1 && live.c1Mte3Reader) {
    // CQ1 contains the preceding final half output. CQ0 did not wait for it.
    WaitFlag<HardEvent::MTE3_MTE2>(7);
    live.c1Mte3Reader = false;
  }
  DataCopy(scale, scales[expert * n + (ownedN + panel) * COLS], COLS);
  CrossCoreWaitFlag(5);
  if (rows > 0) {
    DataCopyExtParams cp{};
    cp.blockCount = rows;
    cp.blockLen = COLS * sizeof(int32_t);
    cp.srcStride = (n / 2 - COLS) * sizeof(int32_t);
    DataCopyPadExtParams<int32_t> pad{true, 0, 0, 0};
    DataCopyPad(value, raw[((row + first) * n + ownedN * COLS) / 2], cp, pad);
  }
  // Both AIV readers acknowledge the original complete N256 GM generation.
  CrossCoreSetFlag<2, PIPE_MTE2>(3);
  if (panel == 0) {
    SetFlag<HardEvent::MTE2_V>(6);
  } else {
    SetFlag<HardEvent::MTE2_V>(7);
    // This reader's raw Y rows become writable after the actual final C read.
    SetFlag<HardEvent::MTE2_MTE3>(6);
  }
}

template <bool FIRST>
__aicore__ inline void IssueMath(
    LocalTensor<int32_t> value, LocalTensor<float> scale,
    LocalTensor<float> scratch, LocalTensor<half> held, int rows,
    Lifetimes &live) {
  WaitFlag<HardEvent::MTE2_V>(FIRST ? 6 : 7);
  if (rows > 0) {
    auto z = value.ReinterpretCast<float>();
    Cast(z, value, RoundMode::CAST_NONE, rows * COLS);
    PipeBarrier<PIPE_V>();
    RgC1FP32ScaleRows(z, scale, rows, COLS);
    for (int row = 0; row < rows; row += MATH_ROWS) {
      const int count = (rows - row < MATH_ROWS ? rows - row : MATH_ROWS) * COLS;
      RgC1FP32GeluInplace(z[row * COLS], scratch, count);
      PipeBarrier<PIPE_V>();
      if constexpr (FIRST) {
        if (row == 0 && live.heldMte3Reader) {
          // Current CQ arithmetic can run before the previous held output retires.
          WaitFlag<HardEvent::MTE3_V>(6);
          live.heldMte3Reader = false;
        }
        if (row + MATH_ROWS >= rows) {
          // Div is the final CQ0/scale0 reader. The following Cast reads scratch.
          SetFlag<HardEvent::V_MTE2>(6);
          live.c0VectorReader = true;
        }
        Cast(held[row * COLS], scratch, RoundMode::CAST_NONE, count);
      } else {
        // The compact half destination overwrites only already-consumed z rows.
        Cast(value.ReinterpretCast<half>()[row * COLS], scratch,
             RoundMode::CAST_NONE, count);
      }
      // Scratch is one independent 16-row FP32 allocation, reused per chunk.
      PipeBarrier<PIPE_V>();
    }
  } else if constexpr (FIRST) {
    // A zero-row reader still consumes every generation before issuing the next.
    if (live.heldMte3Reader) {
      WaitFlag<HardEvent::MTE3_V>(6);
      live.heldMte3Reader = false;
    }
    SetFlag<HardEvent::V_MTE2>(6);
    live.c0VectorReader = true;
  }
  SetFlag<HardEvent::V_MTE3>(FIRST ? 6 : 7);
}

__aicore__ inline void StoreHeld(
    GlobalTensor<half> &y, LocalTensor<half> held, int row, int first,
    int rows, int ownedN, int n, Lifetimes &live) {
  WaitFlag<HardEvent::V_MTE3>(6);
  WaitFlag<HardEvent::MTE2_MTE3>(6);
  if (rows > 0) {
    DataCopyExtParams out{};
    out.blockCount = rows;
    out.blockLen = COLS * sizeof(half);
    out.dstStride = (n - COLS) * sizeof(half);
    DataCopyPad(y[(row + first) * n + ownedN * COLS], held, out);
  }
  SetFlag<HardEvent::MTE3_V>(6);
  live.heldMte3Reader = true;
}

__aicore__ inline void StoreLast(
    GlobalTensor<half> &y, LocalTensor<int32_t> value, int row, int first,
    int rows, int ownedN, int n, Lifetimes &live) {
  WaitFlag<HardEvent::V_MTE3>(7);
  if (rows > 0) {
    DataCopyExtParams out{};
    out.blockCount = rows;
    out.blockLen = COLS * sizeof(half);
    out.dstStride = (n - COLS) * sizeof(half);
    DataCopyPad(y[(row + first) * n + (ownedN + 1) * COLS],
                value.ReinterpretCast<half>(), out);
  }
  SetFlag<HardEvent::MTE3_MTE2>(7);
  live.c1Mte3Reader = true;
}


struct Work {
  int row;
  int rows;
  int expert;
  int ownedN;
};

// Enumerate each expert's own row tiles rather than splitting fixed row slabs.
// Every core walks the same real device GL and takes ordinal core + k * cores.
// No expert array, per-owner search or Host inspection is needed.
class WorkCursor {
 public:
  __aicore__ inline explicit WorkCursor(int core) : ordinal_(core) {}

  __aicore__ inline bool Next(GlobalTensor<int64_t> &gl, int experts,
                              int groups, int cores, Work &work) {
    while (expert_ < experts) {
      if (!loaded_) {
        end_ = static_cast<int>(gl.GetValue(expert_));
        loaded_ = true;
      }
      const int rowTiles = (end_ - begin_ + 127) / 128;
      const int count = rowTiles * groups;
      if (ordinal_ < prefix_ + count) {
        const int local = ordinal_ - prefix_;
        work.row = begin_ + (local / groups) * 128;
        work.rows = end_ - work.row < 128 ? end_ - work.row : 128;
        work.expert = expert_;
        work.ownedN = (local % groups) * 2;
        ordinal_ += cores;
        return true;
      }
      prefix_ += count;
      begin_ = end_;
      ++expert_;
      loaded_ = false;
    }
    return false;
  }

 private:
  int ordinal_;
  int prefix_ = 0;
  int expert_ = 0;
  int begin_ = 0;
  int end_ = 0;
  bool loaded_ = false;
};

__aicore__ inline void Consume(
    TPipe &pipe, GlobalTensor<int64_t> &gl, GlobalTensor<int32_t> &raw,
    GlobalTensor<float> &scales, GlobalTensor<half> &y, int n, int experts,
    int core, int sub, int cores) {
  constexpr int UB_BYTES = 2 * C_ELEMS * sizeof(int32_t) +
                           2 * COLS * sizeof(float) +
                           MATH_ELEMS * sizeof(float) +
                           C_ELEMS * sizeof(half);
  static_assert(UB_BYTES == 178 * 1024 && UB_BYTES <= 192 * 1024,
                "Independent double C, double scale, scratch and held half");
  TBuf<TPosition::VECCALC> cBuffer, scaleBuffer, mathBuffer, heldBuffer;
  pipe.InitBuffer(cBuffer, 2 * C_ELEMS * sizeof(int32_t));
  pipe.InitBuffer(scaleBuffer, 2 * COLS * sizeof(float));
  pipe.InitBuffer(mathBuffer, MATH_ELEMS * sizeof(float));
  pipe.InitBuffer(heldBuffer, C_ELEMS * sizeof(half));
  auto c0 = cBuffer.Get<int32_t>();
  auto c1 = c0[C_ELEMS];
  auto s0 = scaleBuffer.Get<float>();
  auto s1 = s0[COLS];
  auto scratch = mathBuffer.Get<float>();
  auto held = heldBuffer.Get<half>();
  Lifetimes live;
  WorkCursor cursor(core);
  Work work;
  while (cursor.Next(gl, experts, n / 512, cores, work)) {
    const int rowsPerSub = (work.rows + 1) / 2;
    const int first = sub * rowsPerSub;
    const int remaining = work.rows - first;
    const int rows = remaining <= 0 ? 0 :
                     (remaining < rowsPerSub ? remaining : rowsPerSub);
    StagePanel(0, work.row, first, rows, work.expert, work.ownedN, n,
               raw, scales, c0, s0, live);
    IssueMath<true>(c0, s0, scratch, held, rows, live);
    StagePanel(1, work.row, first, rows, work.expert, work.ownedN, n,
               raw, scales, c1, s1, live);
    StoreHeld(y, held, work.row, first, rows, work.ownedN, n, live);
    IssueMath<false>(c1, s1, scratch, held, rows, live);
    StoreLast(y, c1, work.row, first, rows, work.ownedN, n, live);
  }
  if (live.c0VectorReader)
    WaitFlag<HardEvent::V_MTE2>(6);
  if (live.heldMte3Reader)
    WaitFlag<HardEvent::MTE3_V>(6);
  if (live.c1Mte3Reader)
    WaitFlag<HardEvent::MTE3_MTE2>(7);
  PipeBarrier<PIPE_MTE3>();
}

__aicore__ inline void Produce(
    TPipe &pipe, GlobalTensor<int8_t> &x, GlobalTensor<int8_t> &weight,
    GlobalTensor<int64_t> &gl, GlobalTensor<int32_t> &raw,
    int n, int experts, int core, int cores) {
  constexpr int CM = 128;
  constexpr int CN = 256;
  constexpr int DEPTH = 1024;
  constexpr int QK = 128;
  constexpr int NB = 8;
  constexpr int BK = 128;
  constexpr int PANELS_PER_WORK = 2;
  constexpr int K_MICROS = DEPTH / QK;
  static_assert(CM * DEPTH + NB * BK * CN == 384 * 1024,
                "Original469 A1 and B1 footprint");
  TBuf<TPosition::A1> a1Buffer;
  TBuf<TPosition::B1> b1Buffer;
  TBuf<TPosition::A2> a2Buffer;
  TBuf<TPosition::B2> b2Buffer;
  TBuf<TPosition::CO1> cBuffer;
  pipe.InitBuffer(a1Buffer, CM * DEPTH);
  pipe.InitBuffer(b1Buffer, NB * BK * CN);
  pipe.InitBuffer(a2Buffer, 2 * CM * QK);
  pipe.InitBuffer(b2Buffer, 2 * QK * CN);
  pipe.InitBuffer(cBuffer, CM * CN * sizeof(int32_t));
  auto a1 = a1Buffer.Get<int8_t>();
  auto b1 = b1Buffer.Get<int8_t>();
  auto a2 = a2Buffer.Get<int8_t>();
  auto b2 = b2Buffer.Get<int8_t>();
  auto acc = cBuffer.Get<int32_t>();
  const uint8_t pads[4] = {0, 0, 0, 0};
  SetFmatrix(1, CM, pads, FmatrixMode::FMATRIX_LEFT);
  int iter = 0;
  WorkCursor cursor(core);
  Work work;
  while (cursor.Next(gl, experts, n / 512, cores, work)) {
    const int paddedM = (work.rows + 15) / 16 * 16;
    Nd2NzParams pa{};
    pa.ndNum = 1;
    pa.nValue = work.rows;
    pa.dValue = DEPTH;
    pa.srcDValue = DEPTH;
    pa.dstNzC0Stride = CM;
    pa.dstNzNStride = 1;
    DataCopy(a1, x[work.row * DEPTH], pa);
    for (int bank = 0; bank < NB; ++bank)
      rg_c1_B_granularity128::StageB<DEPTH, NB, BK>(
          bank, work.ownedN, false, n, work.expert, weight, b1);
    rg_c1_B_granularity128::StageL0<DEPTH, NB, BK>(
        0, work.ownedN, PANELS_PER_WORK, n, work.expert, paddedM,
        weight, a1, b1, a2, b2);
    rg_c1_B_granularity128::StageL0<DEPTH, NB, BK>(
        1, work.ownedN, PANELS_PER_WORK, n, work.expert, paddedM,
        weight, a1, b1, a2, b2);
    for (int panel = 0; panel < PANELS_PER_WORK; ++panel) {
      for (int micro = 0; micro < K_MICROS; ++micro) {
        const int op = panel * K_MICROS + micro;
        const int bank = op & 1;
        WaitFlag<HardEvent::MTE1_M>(bank + 6);
        MmadParams mm;
        mm.m = paddedM;
        mm.n = CN;
        mm.k = QK;
        mm.cmatrixInitVal = micro == 0;
        mm.unitFlag = micro + 1 == K_MICROS ? 3 : 2;
        Mmad(acc, a2[bank * CM * QK], b2[bank * QK * CN], mm);
        SetFlag<HardEvent::M_MTE1>(bank + 6);
        if (op + 2 < PANELS_PER_WORK * K_MICROS)
          rg_c1_B_granularity128::StageL0<DEPTH, NB, BK>(
              op + 2, work.ownedN, PANELS_PER_WORK, n, work.expert, paddedM,
              weight, a1, b1, a2, b2);
      }
      if (iter >= 1)
        CrossCoreWaitFlag(3);
      FixpipeParamsV220 fp;
      fp.nSize = CN;
      fp.mSize = work.rows;
      fp.srcStride = paddedM;
      fp.dstStride = n / 2;
      fp.reluEn = false;
      fp.quantPre = QuantMode_t::NoQuant;
      fp.deqScalar = 0;
      fp.unitFlag = 3;
      Fixpipe<int32_t, int32_t, CFG_ROW_MAJOR>(
          raw[(work.row * n + work.ownedN * CN) / 2], acc, fp);
      CrossCoreSetFlag<2, PIPE_FIX>(5);
      if (panel + 1 == PANELS_PER_WORK) {
        WaitFlag<HardEvent::M_MTE1>(6);
        WaitFlag<HardEvent::M_MTE1>(7);
        for (int bank = 0; bank < NB; ++bank)
          WaitFlag<HardEvent::MTE1_MTE2>(bank);
      }
      ++iter;
    }
  }
  if (iter > 0) {
    SetFlag<HardEvent::FIX_M>(6);
    WaitFlag<HardEvent::FIX_M>(6);
  }
}

template <int PANELS>
__aicore__ inline void Compute(
    GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groupList, GM_ADDR y,
    int m, int experts) {
  static_assert(PANELS == 2 || PANELS == 4,
                "Original C1 Host-selected K1024 and N512/N1024 family");
  constexpr int K = 1024;
  constexpr int N = PANELS * COLS;
  GlobalTensor<int8_t> xGm, weightGm;
  GlobalTensor<int64_t> glGm;
  GlobalTensor<float> scaleGm;
  GlobalTensor<int32_t> rawYGm;
  GlobalTensor<half> yGm;
  xGm.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t *>(x), m * K);
  weightGm.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t *>(weight),
                           experts * K * N);
  glGm.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t *>(groupList), experts);
  scaleGm.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(scale), experts * N);
  rawYGm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t *>(y), m * N / 2);
  yGm.SetGlobalBuffer(reinterpret_cast<__gm__ half *>(y), m * N);
  const int cores = GetBlockNum();
  const int core = gmm_common::CoreGroupIndex();
  TPipe pipe;
  if ASCEND_IS_AIC {
    Produce(pipe, xGm, weightGm, glGm, rawYGm, N, experts, core, cores);
  } else {
    const int sub = gmm_common::SubCoreIndex();
    Consume(pipe, glGm, rawYGm, scaleGm, yGm, N, experts, core, sub, cores);
  }
}
}
