if(cores>1 && E>=3*cores && N>128 && N<=256 && N%32==0 && K%32==0
 && K>=32 && (int64_t)256*K<=65536 && M>=64*E && M<128*E){
 Expert::LaunchExpertUnclamped<1>(x,weight,scale,group_list,y,M,N,K,E,cores,stream);return;
}
if(cores>1 && E>=2*cores && N>128 && N<=256 && N%32==0 && K%32==0
 && K>=32 && (int64_t)256*K<=65536 && M>=64*E && M<128*E){
 Expert::LaunchAdaptiveDirectRows<64,256>(x,weight,scale,group_list,y,M,N,K,E,cores,stream);return;
}
if(K>=128 && K%32==0 && N>512 && N%32==0
 && (int64_t)((K+127)/128*128)*(2*64+256)<=524288
 && M>=16*E && M<128*E && (int64_t)2*128*K+2*1024*128<=524288
 && (int64_t)E*((N+1023)/1024)>=cores){
 Expert::LaunchAlignedWordTransport<128,1024>(x,weight,scale,group_list,y,M,N,K,E,cores,stream);return;
}
const int pk=(K+31)/32*32;
const bool tails=N%32!=0 || K%32!=0;
const bool amortized=M>=256*E && K%32>=16 && N%32>=16;
if(amortized && N>=256 && K>=128 && (int64_t)(128+256)*pk<=524032
 && (int64_t)((M+63)/64)*((N+255)/256)>=2*cores){
 Core::LaunchAlignedResident<256>(x,weight,scale,group_list,y,M,N,K,E,cores,stream);return;
}
if(!amortized && tails && N>=128 && K>=128 && M>=256*E
 && (int64_t)(128+256)*pk<=524032){
 Core::LaunchTscmColumns<256>(x,weight,scale,group_list,y,M,N,K,E,cores,stream);return;
}
if(!amortized && tails && N>384 && K>=128 && M>=64*E && M<=80*E
 && (int64_t)E*((N+383)/384)>=cores && (int64_t)(80+384)*pk<=524032){
 if((N+287)/288==(N+383)/384)
 Core::LaunchWideTriple<288>(x,weight,scale,group_list,y,M,N,K,E,cores,stream);
 else Core::LaunchWideResident<384>(x,weight,scale,group_list,y,M,N,K,E,cores,stream);
 return;
}
constexpr int capacityRows=(32768/192/16)*16;
if(!amortized && tails && N>=128 && K>=128 && M>=128*E && M<=capacityRows*E
 && (int64_t)E*((N+127)/128)>=2*cores && (int64_t)(192+2*128)*pk<=524032){
 Medium::LaunchMediumResident<128>(x,weight,scale,group_list,y,M,N,K,E,cores,stream);return;
}
if(!amortized && tails && N>=160 && K>=128 && M>=128*E && M<=176*E
 && (int64_t)E*((N+159)/160)>=2*cores && (int64_t)(176+2*160)*pk<=524032){
 Core::LaunchMediumCapacity<160>(x,weight,scale,group_list,y,M,N,K,E,cores,stream);return;
}
if(M>=64*E && K>=128 && N>128 && N%32!=0){
 if(M>=128*E){
 const int physicalK=(K+127)/128*128;
 if((int64_t)physicalK*256+2*64*128<=524288){
  constexpr int balancedN=256-32;
  const int nTasks=(N+255)/256;
  const int balancedWidth=((N+nTasks-1)/nTasks+31)/32*32;
  if((int64_t)physicalK*512>524288 && (int64_t)physicalK*384<=524288
  && balancedWidth<=balancedN && (N+balancedN-1)/balancedN==nTasks){
  if((int64_t)E*((N+balancedN-1)/balancedN)>=4*cores
   && (int64_t)pk*(2*128+balancedN)<=524288)
   Resident::LaunchResidentWideRows<512,balancedN>(x,weight,scale,group_list,y,M,N,K,E,cores,stream);
  else Resident::LaunchResidentBalancedN<256,balancedN>(x,weight,scale,group_list,y,M,N,K,E,cores,stream);
  }else Resident::LaunchResidentB<256,256>(x,weight,scale,group_list,y,M,N,K,E,cores,stream);
  return;
 }
 }else{
 const int pk64=(K+63)/64*64;
 if((int64_t)pk64*(64+416)<=524288 && (int64_t)pk64*(2*64+416)>524288
  && (N+415)/416==(N+511)/512)
  Resident::LaunchResidentSingleA<256,416>(x,weight,scale,group_list,y,M,N,K,E,cores,stream);
 else Resident::LaunchRowReuse<128,512>(x,weight,scale,group_list,y,M,N,K,E,cores,stream);
 return;
 }
}
const int splitNTiles=(N+255)/256,splitDenseTiles=((M+127)/128)*splitNTiles;
const int splitMaxTiles=((M+127)/128+E-1)*splitNTiles;
if(K>=4096 && M>=128*E && N>128 && N%32!=0 && cores>=4
 && splitDenseTiles<cores && splitMaxTiles<=2*cores){
