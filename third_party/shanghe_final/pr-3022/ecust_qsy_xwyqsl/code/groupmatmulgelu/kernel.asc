 else if(M>=128*E)Core::LaunchSelected<128,256,false>(x,weight,scale,group_list,y,M,N,K,E,cores,stream);
 else Core::LaunchSelected<64,256,false>(x,weight,scale,group_list,y,M,N,K,E,cores,stream);
 return;
}
if(K>=4096 && M<=64 && N<=128 && N%32!=0 && cores>=4)
 Dense::LaunchSplitK<16,128,4>(x,weight,scale,group_list,y,M,N,K,E,cores,stream);
else if(N>512 && N%32!=0 && M<128*E)
 Dense::Launch<64,512>(x,weight,scale,group_list,y,M,N,K,E,cores,stream);
else if(N<=128 && M>=128*E && M>=128*cores){
 if(M>=256*E && M>=256*cores)Dense::Launch<256,128>(x,weight,scale,group_list,y,M,N,K,E,cores,stream);
