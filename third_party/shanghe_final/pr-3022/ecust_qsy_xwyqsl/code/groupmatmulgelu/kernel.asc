      else
      { if(alignedWaveRows>1) Expert::ComputeAlignedUnitReady<16,128,512><<<alignedWaveRows,nullptr,stream>>>(x,weight,scale,group_list,y,(GM_ADDR)scratch,M,N,K); else Expert::ComputeAlignedRowSplit<16,128,512><<<alignedWaveRows,nullptr,stream>>>(
