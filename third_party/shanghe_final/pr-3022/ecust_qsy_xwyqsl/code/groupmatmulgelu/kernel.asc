        { if(alignedWaveRows>1) Expert::ComputeAlignedUnitReady<16,128,64,true><<<alignedWaveRows,nullptr,stream>>>(x,weight,scale,group_list,y,(GM_ADDR)scratch,M,N,K); else Expert::ComputeAlignedRowSplit<16,128,64,true><<<alignedWaveRows,nullptr,stream>>>(
          x,weight,scale,group_list,y,(GM_ADDR)scratch,M,N,K); }
      else
      { if(alignedWaveRows>1) Expert::ComputeAlignedUnitReady<16,128,64><<<alignedWaveRows,nullptr,stream>>>(x,weight,scale,group_list,y,(GM_ADDR)scratch,M,N,K); else Expert::ComputeAlignedRowSplit<16,128,64><<<alignedWaveRows,nullptr,stream>>>(
        x,weight,scale,group_list,y,(GM_ADDR)scratch,M,N,K); }
    }
    else if (N == 128 && K == 128)
    {
      if (M % 16 == 0)
        { if(alignedWaveRows>1) Expert::ComputeAlignedUnitReady<16,128,128,true><<<alignedWaveRows,nullptr,stream>>>(x,weight,scale,group_list,y,(GM_ADDR)scratch,M,N,K); else Expert::ComputeAlignedRowSplit<16,128,128,true><<<alignedWaveRows,nullptr,stream>>>(
          x,weight,scale,group_list,y,(GM_ADDR)scratch,M,N,K); }
      else
      { if(alignedWaveRows>1) Expert::ComputeAlignedUnitReady<16,128,128><<<alignedWaveRows,nullptr,stream>>>(x,weight,scale,group_list,y,(GM_ADDR)scratch,M,N,K); else Expert::ComputeAlignedRowSplit<16,128,128><<<alignedWaveRows,nullptr,stream>>>(
