}else if(N<=128 && M<=64)Dense::Launch<16,128>(x,weight,scale,group_list,y,M,N,K,E,cores,stream);
else if(N<=128)Dense::Launch<64,128>(x,weight,scale,group_list,y,M,N,K,E,cores,stream);
else if(M>=128*E)Dense::Launch<128,256>(x,weight,scale,group_list,y,M,N,K,E,cores,stream);
else if(N%512==0)Dense::Launch<64,512>(x,weight,scale,group_list,y,M,N,K,E,cores,stream);
else Dense::Launch<64,256>(x,weight,scale,group_list,y,M,N,K,E,cores,stream);
