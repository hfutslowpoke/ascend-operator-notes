if(amortized && K>=128 && N>=128){
 Packed::Launch<128,256>(x,weight,scale,group_list,y,M,N,K,E,cores,stream);return;
}
if(!tails && N>128){
 if((K<=512 && N>512 && N%256==0 && M>=16*E && M<128*E) || (M<128*E && N%512==0))
