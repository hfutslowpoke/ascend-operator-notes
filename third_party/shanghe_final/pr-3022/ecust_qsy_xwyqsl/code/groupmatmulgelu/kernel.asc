// Unified generic dispatch. Expanded source and provenance: optimization/merge_fastest_20261114.
#include "kernel_operator.h"
#include "lib/matmul_intf.h"
#include "tiling/tiling_api.h"
using namespace AscendC;
namespace Core {
constexpr MatmulConfig MM_CONFIG =
  GetMDLConfig(false, false, 0, false, false, false, true, true, true, false, false, true);
constexpr MatmulConfig NORMAL_CONFIG = GetNormalConfig(false, false, false,
  BatchMode::NONE, true, IterateOrder::UNDEF, ScheduleType::INNER_PRODUCT,
  true, false, BatchOutMode::SINGLE_BATCH);
using AType = matmul::MatmulType<TPosition::GM, CubeFormat::ND, int8_t, false>;
using BType = matmul::MatmulType<TPosition::GM, CubeFormat::ND, int8_t, false>;
using CType = matmul::MatmulType<TPosition::GM, CubeFormat::ND, int32_t>;
using BiasType = matmul::MatmulType<TPosition::GM, CubeFormat::ND, int32_t>;
template<bool USE_NORMAL, typename CALLBACK> struct MatmulSelect;
template<typename CALLBACK> struct MatmulSelect<false, CALLBACK> {
  using Type = matmul::MatmulImpl<AType, BType, CType, BiasType, MM_CONFIG, CALLBACK>;
};
template<typename CALLBACK> struct MatmulSelect<true, CALLBACK> {
  using Type = matmul::MatmulImpl<AType, BType, CType, BiasType, NORMAL_CONFIG, CALLBACK>;
};
__aicore__ inline int SingleRowExpert(GlobalTensor<int64_t> groups,int E)
{
  if(E==1 || groups.GetValue(0)>0)return 0;
  int lo=1,hi=E-1;
  while(lo<hi){
    const int mid=(lo+hi)/2;
    if(groups.GetValue(mid)==0)lo=mid+1;else hi=mid;
  }
  return lo;
}
__aicore__ inline int SingleRowExpert(LocalTensor<int32_t> groups,int E)
{
  if(E==1 || groups.GetValue(0)>0)return 0;
  int lo=1,hi=E-1;
  while(lo<hi){
    const int mid=(lo+hi)/2;
    if(groups.GetValue(2*mid)==0)lo=mid+1;else hi=mid;
  }
  return lo;
}
__aicore__ inline void Gelu(LocalTensor<float> z, LocalTensor<float> t, int count)
{
  Mul(t, z, z, count);
  PipeBarrier<PIPE_V>();
  Muls(t, t, -0.07135481627260025f, count);
  PipeBarrier<PIPE_V>();
  Adds(t, t, -1.5957691216057308f, count);
  PipeBarrier<PIPE_V>();
  Mul(t, t, z, count);
  PipeBarrier<PIPE_V>();
  Maxs(t, t, -87.0f, count);
  PipeBarrier<PIPE_V>();
  Mins(t, t, 87.0f, count);
  PipeBarrier<PIPE_V>();
  Exp(t, t, count);
  PipeBarrier<PIPE_V>();
  Adds(t, t, 1.0f, count);
  PipeBarrier<PIPE_V>();
  Div(z, z, t, count);
  PipeBarrier<PIPE_V>();
}
template<int DEPTH,int ROWS>
__vector__ __global__ __aicore__ void __attribute__((section(".text.Core.gmg.02.ComputeTiny"))) ComputeTiny(
  GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groups,
  GM_ADDR y, int M, int N, int E)
{
  constexpr int K=DEPTH;
  GlobalTensor<int8_t> ag, bg;
  GlobalTensor<int64_t> gg;
  GlobalTensor<float> sg;
  GlobalTensor<half> yg;
  ag.SetGlobalBuffer((__gm__ int8_t*)x);
  bg.SetGlobalBuffer((__gm__ int8_t*)weight);
  gg.SetGlobalBuffer((__gm__ int64_t*)groups);
  sg.SetGlobalBuffer((__gm__ float*)scale);
  yg.SetGlobalBuffer((__gm__ half*)y);
  GlobalTensor<uint64_t> xp, wp, sp, gp;
  xp.SetGlobalBuffer((__gm__ uint64_t*)x);
  wp.SetGlobalBuffer((__gm__ uint64_t*)weight);
  sp.SetGlobalBuffer((__gm__ uint64_t*)scale);
  gp.SetGlobalBuffer((__gm__ uint64_t*)groups);
  DataCachePreload(gp,(int64_t)0);
  DataCachePreload(xp,(int64_t)GetBlockIdx()*ROWS*K);
  DataCachePreload(wp,(int64_t)0);
  DataCachePreload(sp,(int64_t)0);
  InitSocState();
  LocalTensor<float> z(TPosition::VECCALC,0,64);
  LocalTensor<float> t(TPosition::VECCALC,256,64);
  LocalTensor<half> out(TPosition::VECOUT,512,64);
  const int first = GetBlockIdx()*ROWS;
  const int rows = M-first<ROWS?M-first:ROWS;
  const int count = rows*N;
  int expert = M==1 ? SingleRowExpert(gg,E) : 0;
  for(int r=0;r<rows;++r) {
  const int row=first+r;
  if(M!=1)while (expert + 1 < E && row >= (int)gg.GetValue(expert)) ++expert;
  int32_t av[K];
  #pragma unroll
  for (int k=0;k<K;++k) av[k]=(int32_t)ag.GetValue(row*K+k);
  for (int col = 0; col < N; ++col) {
    int32_t acc = 0;
    #pragma unroll
    for (int k = 0; k < K; ++k)
      acc += av[k] * (int32_t)bg.GetValue((expert * K + k) * N + col);
    z.SetValue(r*N+col, (float)acc * sg.GetValue(expert * N + col));
  }
  }
  SetFlag<HardEvent::S_V>(EVENT_ID0);
  WaitFlag<HardEvent::S_V>(EVENT_ID0);
  Gelu(z, t, count);
  Cast(out, z, RoundMode::CAST_RINT, count);
  SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
  WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
  DataCopyPad(yg[first * N], out,
    DataCopyExtParams{1, (uint32_t)(count * 2), 0, 0, 0});
  PipeBarrier<PIPE_ALL>();
}
__aicore__ inline void PadRows(GlobalTensor<int8_t> dst, GlobalTensor<int8_t> src,
  int64_t rows, int width, int padded)
{
  TPipe pipe;
  TBuf<TPosition::VECCALC> buffer;
  pipe.InitBuffer(buffer, 32768);
  auto data = buffer.Get<int8_t>();
  const int chunk = 32768 / padded;
  const int blocks = GetBlockNum() * 2;
  for (int64_t row = (int64_t)GetBlockIdx() * chunk; row < rows; row += (int64_t)blocks * chunk) {
    int count = rows - row < chunk ? rows - row : chunk;
    DataCopyPad(data, src[row * width],
      DataCopyExtParams{(uint16_t)count, (uint32_t)width, 0, 0, 0},
      DataCopyPadExtParams<int8_t>{true, 0, (uint8_t)(padded - width), 0});
    SetFlag<HardEvent::MTE2_MTE3>(EVENT_ID0);
    WaitFlag<HardEvent::MTE2_MTE3>(EVENT_ID0);
    DataCopy(dst[row * padded], data, count * padded);
    SetFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);
    WaitFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);
  }
}
__aicore__ inline void WordCopy(const LocalTensor<int8_t>& dst, const __gm__ int8_t* ptr,
  int height, int width, int stride, int paddedHeight, bool finalRow)
{
  const int count=height-((width%4 && finalRow)?1:0);
  const int groups=stride%4==0?1:(stride%2==0?2:4);
  auto d32=dst.ReinterpretCast<int32_t>();
  for (int g=0;g<groups && g<count;++g) {
    GlobalTensor<int32_t> src;
    src.SetGlobalBuffer((__gm__ int32_t*)(ptr+(int64_t)g*stride));
    DataCopy(d32[g*8],src,Nd2NzParams{1,(uint16_t)((count-g+groups-1)/groups),
      (uint16_t)((width+3)/4),0,(uint16_t)(stride*groups/4),
      (uint16_t)paddedHeight,(uint16_t)groups,0});
  }
  if (count<height) {
    GlobalTensor<int8_t> src;
    src.SetGlobalBuffer((__gm__ int8_t*)(ptr+(int64_t)(height-1)*stride));
    DataCopy(dst[(height-1)*32],src,Nd2NzParams{1,1,(uint16_t)width,0,
      (uint16_t)stride,(uint16_t)paddedHeight,1,0});
  }
}
__aicore__ inline void PairCopy(const LocalTensor<int8_t>& dst, const __gm__ int8_t* ptr,
  int height, int width, int stride, int paddedHeight, bool allowOdd, bool finalRow, bool preferWord)
{
  if (allowOdd && stride >= 4 && (stride <= 64 || preferWord)) {
    WordCopy(dst,ptr,height,width,stride,paddedHeight,finalRow);
    return;
  }
  GlobalTensor<int8_t> src;
  src.SetGlobalBuffer((__gm__ int8_t*)ptr);
  if ((width & 1) && !allowOdd) {
    DataCopy(dst,src,Nd2NzParams{1,(uint16_t)height,(uint16_t)width,0,
      (uint16_t)stride,(uint16_t)paddedHeight,1,0});
    return;
  }
  const int count=height-(((width&1)&&finalRow)?1:0);
  const int pairs=(width+1)/2;
  if (count>0) {
    auto d16=dst.ReinterpretCast<int16_t>();
    GlobalTensor<int16_t> s16;
    s16.SetGlobalBuffer((__gm__ int16_t*)ptr);
    if (stride % 2 == 0) {
      DataCopy(d16,s16,Nd2NzParams{1,(uint16_t)count,(uint16_t)pairs,0,
        (uint16_t)(stride/2),(uint16_t)paddedHeight,1,0});
    } else {
      DataCopy(d16,s16,Nd2NzParams{1,(uint16_t)((count+1)/2),(uint16_t)pairs,0,
        (uint16_t)stride,(uint16_t)paddedHeight,2,0});
      if (count>1) {
        s16.SetGlobalBuffer((__gm__ int16_t*)(ptr+stride));
        DataCopy(d16[16],s16,Nd2NzParams{1,(uint16_t)(count/2),(uint16_t)pairs,0,
          (uint16_t)stride,(uint16_t)paddedHeight,2,0});
      }
    }
  }
  if (count<height) {
    DataCopy(dst[(height-1)*32],src[(int64_t)(height-1)*stride],
      Nd2NzParams{1,1,(uint16_t)width,0,(uint16_t)stride,(uint16_t)paddedHeight,1,0});
  }
}
__aicore__ inline void PairA(const LocalTensor<int8_t>& dst, const __gm__ void* gm,
  int row, int col, int useM, int useK, uint64_t unused, uint64_t meta)
{
  int stride=meta&0x3fff;
  int bm=((meta>>41)&15)*16;
  int bk=((meta>>50)&31)*32;
  auto ptr=(const __gm__ int8_t*)gm+(int64_t)row*bm*stride+col*bk;
  const bool odd=(useK&1)!=0;
  const bool wholeWords=stride%4==0 && useK%4==0;
  PairCopy(dst,ptr,useM,useK,stride,(useM+15)/16*16,
    odd || wholeWords,odd && ((meta>>62)&1),wholeWords);
}
__aicore__ inline void PairB(const LocalTensor<int8_t>& dst, const __gm__ void* gm,
  int row, int col, int useK, int useN, uint64_t unused, uint64_t meta)
{
  int stride=(meta>>14)&0x1fff;
  int k=(meta>>27)&0x3fff;
  int bn=((meta>>45)&31)*32;
  int bk=((meta>>50)&31)*32;
  bool finalRow=((meta>>55)&1) && row*bk+useK==k;
  auto ptr=(const __gm__ int8_t*)gm+(int64_t)row*bk*stride+col*bn;
  const int paddedK=(useK+31)/32*32;
  PairCopy(dst,ptr,useK,useN,stride,paddedK,true,finalRow,(meta>>56)&1);
  if((useK&1) && useN>0){
    InitConstValue(dst.ReinterpretCast<int32_t>()[useK*8],
      InitConstValueParams<int32_t>{(uint16_t)((useN+31)/32),
        (uint16_t)(paddedK-useK),(uint16_t)useK,0});
  }
}
__aicore__ inline void AdaptiveB(const LocalTensor<int8_t>& dst,const __gm__ void* gm,
  int row,int col,int useK,int useN,uint64_t unused,uint64_t meta)
{
  const int stride=(meta>>14)&0x1fff;
  const int bn=((meta>>45)&31)*32;
  const int outer=(int)((meta>>57)&31)*128;
  const int valid=stride-outer-col*bn;
  PairB(dst,gm,row,col,useK,useN<valid?useN:valid,unused,meta);
}
template<bool ENABLED> struct TransportCallback;
template<> struct TransportCallback<true> {
  using Type=MatmulCallBackFunc<nullptr,PairA,AdaptiveB>;
};
template<> struct TransportCallback<false> {
  using Type=MatmulCallBackFunc<nullptr,nullptr,nullptr>;
};
__aicore__ inline void CopyDirectBlockedB(const LocalTensor<int8_t>& dst,
  const __gm__ int8_t* ptr,int height,int width,int stride,bool finalRow)
{
  const int nr=(width+31)/32*32;
  const int guarded=((width%4)&&finalRow)?1:0;
  const int bulk=(height-guarded)/32*32;
  const int blocks=bulk/32;
  if(blocks && stride%4==0 && stride*8<=65535){
    GlobalTensor<int32_t> src;src.SetGlobalBuffer((__gm__ int32_t*)ptr);
    DataCopy(dst.ReinterpretCast<int32_t>(),src,
      Nd2NzParams{(uint16_t)blocks,32,(uint16_t)((width+3)/4),
        (uint16_t)(stride*8),(uint16_t)(stride/4),32,1,(uint16_t)(nr*8)});
  }else if(blocks && stride*16<=65535){
    auto d=dst.ReinterpretCast<int16_t>();GlobalTensor<int16_t> src;
    src.SetGlobalBuffer((__gm__ int16_t*)ptr);
    if(stride%2==0){
      DataCopy(d,src,Nd2NzParams{(uint16_t)blocks,32,(uint16_t)((width+1)/2),
        (uint16_t)(stride*16),(uint16_t)(stride/2),32,1,(uint16_t)(nr*16)});
    }else{
      DataCopy(d,src,Nd2NzParams{(uint16_t)blocks,16,(uint16_t)((width+1)/2),
        (uint16_t)(stride*16),(uint16_t)stride,32,2,(uint16_t)(nr*16)});
      src.SetGlobalBuffer((__gm__ int16_t*)(ptr+stride));
      DataCopy(d[16],src,Nd2NzParams{(uint16_t)blocks,16,(uint16_t)((width+1)/2),
        (uint16_t)(stride*16),(uint16_t)stride,32,2,(uint16_t)(nr*16)});
    }
  }else{
    for(int row=0;row<bulk;row+=32)
      PairCopy(dst[row*nr],ptr+(int64_t)row*stride,32,width,stride,32,true,false,false);
  }
  const int tail=height-bulk;
  if(tail){
    auto last=dst[bulk*nr];
    PairCopy(last,ptr+(int64_t)bulk*stride,tail,width,stride,32,true,finalRow,false);
    if(tail<32)InitConstValue(last.ReinterpretCast<int32_t>()[tail*8],
      InitConstValueParams<int32_t>{(uint16_t)(nr/32),(uint16_t)(32-tail),(uint16_t)tail,0});
  }
}
template<int TM, int TN>
class DirectSingleMatmul {
  static constexpr int CK = 65536 / (TM > TN ? TM : TN);
  static_assert(TM * TN * sizeof(int32_t) <= 128 * 1024);
  LocalTensor<int8_t> ab;
  LocalTensor<int8_t> bb;
  LocalTensor<int8_t> a0;
  LocalTensor<int8_t> b0;
  LocalTensor<int32_t> cb;
  GlobalTensor<int8_t> a, b;
  uint64_t meta = 0;
  int rows, cols, depth;
  bool previous = false;
  const __gm__ int8_t* cached_b = nullptr;
  uint64_t cached_b_meta = 0;
  int cached_b_cols = 0, cached_b_depth = 0;
  TEventID event_MTE1_MTE2;
  TEventID event_MTE2_MTE1;
  TEventID event_M_MTE1;
  TEventID event_MTE1_M;
  TEventID event_FIX_M;
  TEventID event_M_FIX;
public:
  __aicore__ inline void SetSubBlockIdx(int) {}
  __aicore__ inline void Init(TCubeTiling*, TPipe*) {
    ab=LocalTensor<int8_t>(TPosition::A1,0,TM*CK);
    bb=LocalTensor<int8_t>(TPosition::B1,TM*CK,CK*TN);
    a0=LocalTensor<int8_t>(TPosition::A2,0,TM*CK);
    b0=LocalTensor<int8_t>(TPosition::B2,0,CK*TN);
    cb=LocalTensor<int32_t>(TPosition::CO1,0,TM*TN);
    event_MTE1_MTE2=static_cast<TEventID>(0);
    event_MTE2_MTE1=static_cast<TEventID>(0);
    event_M_MTE1=static_cast<TEventID>(3);
    event_MTE1_M=static_cast<TEventID>(0);
    event_FIX_M=static_cast<TEventID>(0);
    event_M_FIX=static_cast<TEventID>(0);
  }
  __aicore__ inline void SetOrgShape(int, int, int, int, int) {}
  __aicore__ inline void SetSingleShape(int m, int n, int k) {
    rows = m; cols = n; depth = k;
  }
  __aicore__ inline void SetSelfDefineData(uint64_t value) { meta = value; }
  __aicore__ inline void SetTensorA(GlobalTensor<int8_t> value, bool) { a = value; }
  __aicore__ inline void SetTensorB(GlobalTensor<int8_t> value, bool) { b = value; }
  __aicore__ inline void End() {
    PipeBarrier<PIPE_ALL>();
  }
  __aicore__ inline void IterateAll(GlobalTensor<int32_t> c, bool) {
    auto al = ab, bl = bb;
    auto ac = a0, bc = b0;
    auto cc = cb;
    const int mr = (rows + 15) / 16 * 16;
    const int nr = (cols + 31) / 32 * 32;
    const int kr = (depth + 31) / 32 * 32;
    const auto bptr = b.GetPhyAddr();
    const uint64_t bmeta = meta & ~(uint64_t(1) << 62);
    const bool reuseB = previous && bptr == cached_b && bmeta == cached_b_meta
      && cols == cached_b_cols && depth == cached_b_depth;
    if (previous) {
      SetFlag<HardEvent::MTE1_MTE2>(static_cast<event_t>(event_MTE1_MTE2));
      WaitFlag<HardEvent::MTE1_MTE2>(static_cast<event_t>(event_MTE1_MTE2));
    }
    PairA(al, a.GetPhyAddr(), 0, 0, rows, depth, 0, meta);
    if (!reuseB) {
      const int stride=(meta>>14)&0x1fff;
      const int outer=(int)((meta>>57)&31)*128;
      const int valid=stride-outer<cols?stride-outer:cols;
      CopyDirectBlockedB(bl,bptr,depth,valid,stride,((meta>>55)&1)!=0);
    }
    SetFlag<HardEvent::MTE2_MTE1>(static_cast<event_t>(event_MTE2_MTE1));
    WaitFlag<HardEvent::MTE2_MTE1>(static_cast<event_t>(event_MTE2_MTE1));
    if (previous) {
      SetFlag<HardEvent::M_MTE1>(static_cast<event_t>(event_M_MTE1));
      WaitFlag<HardEvent::M_MTE1>(static_cast<event_t>(event_M_MTE1));
    }
    const uint8_t pad[4] = {0, 0, 0, 0};
    SetFmatrix(1, mr, pad, FmatrixMode::FMATRIX_LEFT);
    LoadData3DParamsV2Pro la;
    la.channelSize = kr;
    la.extConfig = ((uint64_t)mr << 16) | kr;
    LoadData(ac, al, la);
    if (!reuseB) {
      LoadData2dTransposeParams lb{0,(uint8_t)((kr/32)*(nr/32)),1,1,0};
      LoadDataWithTranspose(bc,bl,lb);
    }
    SetFlag<HardEvent::MTE1_M>(static_cast<event_t>(event_MTE1_M));
    WaitFlag<HardEvent::MTE1_M>(static_cast<event_t>(event_MTE1_M));
    if (previous) {
      SetFlag<HardEvent::FIX_M>(static_cast<event_t>(event_FIX_M));
      WaitFlag<HardEvent::FIX_M>(static_cast<event_t>(event_FIX_M));
    }
    MmadParams mp;
    mp.m = mr; mp.n = nr; mp.k = kr; mp.cmatrixInitVal = true;
    Mmad(cc, ac, bc, mp);
    SetFlag<HardEvent::M_FIX>(static_cast<event_t>(event_M_FIX));
    WaitFlag<HardEvent::M_FIX>(static_cast<event_t>(event_M_FIX));
    FixpipeParamsV220 fp;
    fp.nSize = cols; fp.mSize = rows; fp.srcStride = mr; fp.dstStride = TN;
    Fixpipe(c, cc, fp);
    cached_b = bptr; cached_b_meta = bmeta;
    cached_b_cols = cols; cached_b_depth = depth;
    previous = true;
  }
};
template<int TM, int TN, bool NORMAL, bool DIRECT, typename CALLBACK>
struct CubeSelect {
  using Type = typename MatmulSelect<NORMAL, CALLBACK>::Type;
};
template<int TM, int TN, bool NORMAL, typename CALLBACK>
struct CubeSelect<TM, TN, NORMAL, true, CALLBACK> {
  using Type = DirectSingleMatmul<TM, TN>;
};
template<int TM,int TN,int STATIC_K=0>
struct PartialSdkTiling {
  static constexpr MatmulApiStaticTiling Make() {
    MatmulApiStaticTiling t;
    t.cfg=MM_CONFIG;
    t.cfg.enableSetBias=false;
    t.cfg.enableQuantVector=false;
    t.cfg.enableSetDefineData=false;
    t.cfg.iterateMode=IterateMode::ITERATE_MODE_ALL;
    t.cfg.iterateOrder=IterateOrder::ORDER_N;
    t.iterateOrder=static_cast<int>(IterateOrder::ORDER_N);
    t.singleCoreM=TM;t.singleCoreN=TN;
    if constexpr(STATIC_K>0){t.Ka=STATIC_K;t.Kb=STATIC_K;t.singleCoreK=STATIC_K;}
    t.baseM=TM;t.baseN=TN;t.baseK=128;
    t.stepM=1;t.stepN=1;t.isBias=0;
    t.dbL0A=2;t.dbL0B=(2*TN*128<=65536?2:1);
    t.stepKa=4;t.stepKb=(TM>=128?2:4);
    t.depthA1=2*t.stepKa;t.depthB1=2*t.stepKb;
    t.dbL0C=1;t.shareMode=0;
    static_assert(2*TM*128*4+2*TN*128*(TM>=128?2:4)<=524032,
           "Static SDK packages exceed usable L1 capacity");
    return t;
  }
  inline static constexpr MatmulApiStaticTiling value=Make();
};
template<int TM,int TN,bool NORMAL,bool DIRECT,typename CALLBACK,bool STATIC_TILE,int STATIC_K=0>
struct TileCubeSelect : CubeSelect<TM,TN,NORMAL,DIRECT,CALLBACK> {};
template<int TM,int TN,typename CALLBACK,int STATIC_K>
struct TileCubeSelect<TM,TN,false,false,CALLBACK,true,STATIC_K> {
  using Type=matmul::MatmulImpl<AType,BType,CType,BiasType,
    PartialSdkTiling<TM,TN,STATIC_K>::value,CALLBACK>;
};
template<int TM, int TN>
class DirectPlaneMatmul {
  static constexpr int CK = 65536 / (TM > TN ? TM : TN);
  static_assert(TM * TN * sizeof(int32_t) <= 128 * 1024);
  TBuf<TPosition::A1> ab;
  TBuf<TPosition::B1> bb;
  TBuf<TPosition::A2> a0;
  TBuf<TPosition::B2> b0;
  TBuf<TPosition::CO1> cb;
  GlobalTensor<int8_t> a, b;
  uint64_t meta = 0;
  int rows, cols, depth;
  bool previous = false;
  const __gm__ int8_t* cached_b = nullptr;
  uint64_t cached_b_meta = 0;
  int cached_b_cols = 0, cached_b_depth = 0;
  TPipe* pipe_;
  TEventID event_MTE1_MTE2;
  TEventID event_MTE2_MTE1;
  TEventID event_M_MTE1;
  TEventID event_MTE1_M;
  TEventID event_FIX_M;
  TEventID event_M_FIX;
public:
  __aicore__ inline void SetSubBlockIdx(int) {}
  __aicore__ inline void Init(TCubeTiling*, TPipe* pipe) {
    pipe->InitBuffer(ab, TM * CK);
    pipe->InitBuffer(bb, CK * TN);
    pipe->InitBuffer(a0, TM * CK);
    pipe->InitBuffer(b0, CK * TN);
    pipe->InitBuffer(cb, TM * TN * sizeof(int32_t));
    pipe_ = pipe;
    event_MTE1_MTE2 = pipe->AllocEventID<HardEvent::MTE1_MTE2>();
    event_MTE2_MTE1 = pipe->AllocEventID<HardEvent::MTE2_MTE1>();
    event_M_MTE1 = pipe->AllocEventID<HardEvent::M_MTE1>();
    event_MTE1_M = pipe->AllocEventID<HardEvent::MTE1_M>();
    event_FIX_M = pipe->AllocEventID<HardEvent::FIX_M>();
    event_M_FIX = pipe->AllocEventID<HardEvent::M_FIX>();
  }
  __aicore__ inline void SetOrgShape(int, int, int, int, int) {}
  __aicore__ inline void SetSingleShape(int m, int n, int k) {
    rows = m; cols = n; depth = k;
  }
  __aicore__ inline void SetSelfDefineData(uint64_t value) { meta = value; }
  __aicore__ inline void SetTensorA(GlobalTensor<int8_t> value, bool) { a = value; }
  __aicore__ inline void SetTensorB(GlobalTensor<int8_t> value, bool) { b = value; }
  __aicore__ inline void End() {
    PipeBarrier<PIPE_ALL>();
    pipe_->ReleaseEventID<HardEvent::MTE1_MTE2>(event_MTE1_MTE2);
    pipe_->ReleaseEventID<HardEvent::MTE2_MTE1>(event_MTE2_MTE1);
    pipe_->ReleaseEventID<HardEvent::M_MTE1>(event_M_MTE1);
    pipe_->ReleaseEventID<HardEvent::MTE1_M>(event_MTE1_M);
    pipe_->ReleaseEventID<HardEvent::FIX_M>(event_FIX_M);
    pipe_->ReleaseEventID<HardEvent::M_FIX>(event_M_FIX);
  }
  __aicore__ inline void IterateAll(GlobalTensor<int32_t> c, bool) {
    auto al = ab.Get<int8_t>(), bl = bb.Get<int8_t>();
    auto ac = a0.Get<int8_t>(), bc = b0.Get<int8_t>();
    auto cc = cb.Get<int32_t>();
    const int mr = (rows + 15) / 16 * 16;
    const int nr = (cols + 31) / 32 * 32;
    const int kr = (depth + 31) / 32 * 32;
    const auto bptr = b.GetPhyAddr();
    const uint64_t bmeta = meta & ~(uint64_t(1) << 62);
    const bool reuseB = previous && bptr == cached_b && bmeta == cached_b_meta
      && cols == cached_b_cols && depth == cached_b_depth;
    if (previous) {
      SetFlag<HardEvent::MTE1_MTE2>(static_cast<event_t>(event_MTE1_MTE2));
      WaitFlag<HardEvent::MTE1_MTE2>(static_cast<event_t>(event_MTE1_MTE2));
    }
    PairA(al, a.GetPhyAddr(), 0, 0, rows, depth, 0, meta);
    if (!reuseB) {
      AdaptiveB(bl, bptr, 0, 0, depth, cols, 0, meta);
      if (kr != depth && (depth & 1) == 0) {
        const int stride = (meta >> 14) & 0x1fff;
        const int outer = (int)((meta >> 57) & 31) * 128;
        const int valid = stride - outer < cols ? stride - outer : cols;
        InitConstValue(bl.ReinterpretCast<int32_t>()[depth * 8],
          InitConstValueParams<int32_t>{(uint16_t)((valid + 31) / 32),
            (uint16_t)(kr - depth), (uint16_t)depth, 0});
      }
    }
    SetFlag<HardEvent::MTE2_MTE1>(static_cast<event_t>(event_MTE2_MTE1));
    WaitFlag<HardEvent::MTE2_MTE1>(static_cast<event_t>(event_MTE2_MTE1));
    if (previous) {
      SetFlag<HardEvent::M_MTE1>(static_cast<event_t>(event_M_MTE1));
      WaitFlag<HardEvent::M_MTE1>(static_cast<event_t>(event_M_MTE1));
    }
    const uint8_t pad[4] = {0, 0, 0, 0};
    SetFmatrix(1, mr, pad, FmatrixMode::FMATRIX_LEFT);
    LoadData3DParamsV2Pro la;
    la.channelSize = kr;
    la.extConfig = ((uint64_t)mr << 16) | kr;
    LoadData(ac, al, la);
    if (!reuseB) {
      LoadData2dTransposeParams lb{0, (uint8_t)(nr / 32), (uint16_t)(kr / 32), 1, 0};
      for (int ki = 0; ki < kr; ki += 32)
        LoadDataWithTranspose(bc[ki * nr], bl[ki * 32], lb);
    }
    SetFlag<HardEvent::MTE1_M>(static_cast<event_t>(event_MTE1_M));
    WaitFlag<HardEvent::MTE1_M>(static_cast<event_t>(event_MTE1_M));
    if (previous) {
      SetFlag<HardEvent::FIX_M>(static_cast<event_t>(event_FIX_M));
      WaitFlag<HardEvent::FIX_M>(static_cast<event_t>(event_FIX_M));
    }
    MmadParams mp;
    mp.m = mr; mp.n = nr; mp.k = kr; mp.cmatrixInitVal = true;
    Mmad(cc, ac, bc, mp);
    SetFlag<HardEvent::M_FIX>(static_cast<event_t>(event_M_FIX));
    WaitFlag<HardEvent::M_FIX>(static_cast<event_t>(event_M_FIX));
    FixpipeParamsV220 fp;
    fp.nSize = cols; fp.mSize = rows; fp.srcStride = mr; fp.dstStride = TN;
    Fixpipe(c, cc, fp);
    cached_b = bptr; cached_b_meta = bmeta;
    cached_b_cols = cols; cached_b_depth = depth;
    previous = true;
  }
};
template<int TM, int TN, bool NORMAL, bool DIRECT, typename CALLBACK>
struct PlaneCubeSelect {
  using Type = typename MatmulSelect<NORMAL, CALLBACK>::Type;
};
template<int TM, int TN, bool NORMAL, typename CALLBACK>
struct PlaneCubeSelect<TM, TN, NORMAL, true, CALLBACK> {
  using Type = DirectPlaneMatmul<TM, TN>;
};
__aicore__ inline int AdvanceTaskBase(int base,int count,int cores)
{
  const int sum=base+count;
  if(sum<cores)return sum;
  return count<cores?sum-cores:sum%cores;
}
__aicore__ inline void TileCoordinates(int task,int nc,int& mr,int& nr)
{
  if(nc==1){mr=task;nr=0;}
  else if(nc==2){mr=task>>1;nr=task&1;}
  else {mr=task/nc;nr=task-mr*nc;}
}
__aicore__ inline void GeluBounded(LocalTensor<float> z,LocalTensor<float> t,int count)
{
  const BinaryRepeatParams binary{1,1,1,8,8,8};
  const UnaryRepeatParams unary{1,1,8,8};
  for(int offset=0;offset<count;){
    const int remaining=count-offset;
    const int full=remaining/64;
    const uint8_t repeats=(uint8_t)(full>255?255:(full>0?full:1));
    const uint64_t mask=full>0?64:(uint64_t)remaining;
    auto a=z[offset];auto b=t[offset];
    Mul(b,a,a,mask,repeats,binary);PipeBarrier<PIPE_V>();
    Muls(b,b,-0.07135481627260025f,mask,repeats,unary);PipeBarrier<PIPE_V>();
    Adds(b,b,-1.5957691216057308f,mask,repeats,unary);PipeBarrier<PIPE_V>();
    Mul(b,b,a,mask,repeats,binary);PipeBarrier<PIPE_V>();
    Maxs(b,b,-87.0f,mask,repeats,unary);PipeBarrier<PIPE_V>();
    Mins(b,b,87.0f,mask,repeats,unary);PipeBarrier<PIPE_V>();
    Exp(b,b,mask,repeats,unary);PipeBarrier<PIPE_V>();
    Adds(b,b,1.0f,mask,repeats,unary);PipeBarrier<PIPE_V>();
    Div(a,a,b,mask,repeats,binary);PipeBarrier<PIPE_V>();
    offset+=full>0?(int)repeats*64:(int)mask;
  }
}
__aicore__ inline void GeluUnclamped(LocalTensor<float> z,LocalTensor<float> t,int count)
{
  const BinaryRepeatParams binary{1,1,1,8,8,8};
  const UnaryRepeatParams unary{1,1,8,8};
  for(int offset=0;offset<count;){
    const int remaining=count-offset;
    const int full=remaining/64;
    const uint8_t repeats=(uint8_t)(full>255?255:(full>0?full:1));
    const uint64_t mask=full>0?64:(uint64_t)remaining;
    auto a=z[offset];auto b=t[offset];
    Mul(b,a,a,mask,repeats,binary);PipeBarrier<PIPE_V>();
    Muls(b,b,-0.07135481627260025f,mask,repeats,unary);PipeBarrier<PIPE_V>();
    Adds(b,b,-1.5957691216057308f,mask,repeats,unary);PipeBarrier<PIPE_V>();
    Mul(b,b,a,mask,repeats,binary);PipeBarrier<PIPE_V>();
    Exp(b,b,mask,repeats,unary);PipeBarrier<PIPE_V>();
    Adds(b,b,1.0f,mask,repeats,unary);PipeBarrier<PIPE_V>();
    Div(a,a,b,mask,repeats,binary);PipeBarrier<PIPE_V>();
    offset+=full>0?(int)repeats*64:(int)mask;
  }
}
__aicore__ inline void CanonicalIntegerZero(LocalTensor<float> z,int count)
{
  const UnaryRepeatParams unary{1,1,8,8};
  for(int offset=0;offset<count;){
    const int remaining=count-offset,full=remaining/64;
    const uint8_t repeats=(uint8_t)(full>255?255:(full>0?full:1));
    const uint64_t mask=full>0?64:(uint64_t)remaining;
    Adds(z[offset],z[offset],0.0f,mask,repeats,unary);
    PipeBarrier<PIPE_V>();
    offset+=full>0?(int)repeats*64:(int)mask;
  }
}
template<int ROWS>
__global__ __aicore__ void ComputeVectorK1(GM_ADDR x,GM_ADDR weight,GM_ADDR scale,
  GM_ADDR groups,GM_ADDR y,int M,int N,int E)
{
  GlobalTensor<int8_t> ag,bg;
  GlobalTensor<float> sg;
  GlobalTensor<int32_t> gg;
  GlobalTensor<half> yg;
  ag.SetGlobalBuffer((__gm__ int8_t*)x);
  bg.SetGlobalBuffer((__gm__ int8_t*)weight);
  sg.SetGlobalBuffer((__gm__ float*)scale);
  gg.SetGlobalBuffer((__gm__ int32_t*)groups);
  yg.SetGlobalBuffer((__gm__ half*)y);
  TPipe pipe;
  TBuf<TPosition::VECCALC> gb,wb,whb,wfb,sb,ahb,afb,abb,zb,tb;
  TQue<TPosition::VECIN,1> aq;
  TQue<TPosition::VECOUT,1> oq;
  pipe.InitBuffer(gb,128*8);
  pipe.InitBuffer(wb,128);
  pipe.InitBuffer(whb,128*2);
  pipe.InitBuffer(wfb,128*4);
  pipe.InitBuffer(sb,128*4);
  pipe.InitBuffer(ahb,ROWS*2);
  pipe.InitBuffer(afb,ROWS*4);
  pipe.InitBuffer(abb,ROWS*8*4);
  pipe.InitBuffer(zb,ROWS*128*4);
  pipe.InitBuffer(tb,ROWS*128*4);
  pipe.InitBuffer(aq,1,ROWS);
  pipe.InitBuffer(oq,1,ROWS*128*2);
  auto g=gb.Get<int32_t>();auto w=wb.Get<int8_t>();
  auto wh=whb.Get<half>();auto wf=wfb.Get<float>();auto s=sb.Get<float>();
  auto ah=ahb.Get<half>();auto af=afb.Get<float>();auto ab=abb.Get<float>();
  auto z=zb.Get<float>();auto t=tb.Get<float>();
  DataCopyPad(g,gg,DataCopyExtParams{1,(uint32_t)(E*8),0,0,0},
    DataCopyPadExtParams<int32_t>{true,0,0,0});
  SetFlag<HardEvent::MTE2_S>(EVENT_ID0);
  WaitFlag<HardEvent::MTE2_S>(EVENT_ID0);
  const int nc=(N+127)/128;
  const int core=GetBlockIdx(),cores=GetBlockNum();
  int start=0,base=0;
  const int eBegin=M==1?SingleRowExpert(g,E):0;
  const int eLimit=M==1?eBegin+1:E;
  for(int e=eBegin;e<eLimit;++e){
    const int end=g.GetValue(2*e);
    const int tasks=(end-start+ROWS-1)/ROWS*nc;
    int first=core-base;if(first<0)first+=cores;
    int cachedCol=-1;
    for(int task=first;task<tasks;task+=cores){
        int mr,nr;TileCoordinates(task,nc,mr,nr);
        const int row=start+mr*ROWS,col=nr*128;
        const int cols=N-col<128?N-col:128;
        const int pn=(cols+15)/16*16,wc=(cols+31)/32*32;
        const int rows=end-row<ROWS?end-row:ROWS;
        const int ac=(rows+31)/32*32;
        if(col!=cachedCol){
          SetFlag<HardEvent::V_MTE2>(EVENT_ID7);
          WaitFlag<HardEvent::V_MTE2>(EVENT_ID7);
          DataCopyPad(w,bg[e*N+col],DataCopyExtParams{1,(uint32_t)cols,0,0,0},
            DataCopyPadExtParams<int8_t>{true,0,0,0});
          DataCopyPad(s,sg[e*N+col],DataCopyExtParams{1,(uint32_t)(cols*4),0,0,0},
            DataCopyPadExtParams<float>{true,0,0,0});
          SetFlag<HardEvent::MTE2_V>(EVENT_ID7);
          WaitFlag<HardEvent::MTE2_V>(EVENT_ID7);
          Cast(wh,w,RoundMode::CAST_NONE,wc);PipeBarrier<PIPE_V>();
          Cast(wf,wh,RoundMode::CAST_NONE,wc);PipeBarrier<PIPE_V>();
          cachedCol=col;
        }
        auto a=aq.AllocTensor<int8_t>();
        DataCopyPad(a,ag[row],DataCopyExtParams{1,(uint32_t)rows,0,0,0},
          DataCopyPadExtParams<int8_t>{true,0,0,0});
        aq.EnQue(a);a=aq.DeQue<int8_t>();
        Cast(ah,a,RoundMode::CAST_NONE,ac);PipeBarrier<PIPE_V>();
        Cast(af,ah,RoundMode::CAST_NONE,ac);PipeBarrier<PIPE_V>();
        aq.FreeTensor(a);
        Brcb(ab,af,(uint8_t)((rows+7)/8),{1,8});PipeBarrier<PIPE_V>();
        for(int c=0;c<pn;c+=64)
          Mul(z[c],ab,wf[c],(uint64_t)(pn-c<64?pn-c:64),(uint8_t)rows,
            BinaryRepeatParams{1,0,1,(uint8_t)(pn/8),1,0});
        PipeBarrier<PIPE_V>();
        CanonicalIntegerZero(z,rows*pn);
        for(int c=0;c<cols;c+=64)
          Mul(z[c],z[c],s[c],(uint64_t)(cols-c<64?cols-c:64),(uint8_t)rows,
            BinaryRepeatParams{1,1,1,(uint8_t)(pn/8),(uint8_t)(pn/8),0});
        PipeBarrier<PIPE_V>();
        GeluBounded(z,t,rows*pn);
        auto out=oq.AllocTensor<half>();
        Cast(out,z,RoundMode::CAST_RINT,rows*pn);
        oq.EnQue(out);out=oq.DeQue<half>();
        DataCopyPad(yg[(int64_t)row*N+col],out,
          DataCopyExtParams{(uint16_t)rows,(uint32_t)(cols*2),0,(uint32_t)((N-cols)*2),0});
        oq.FreeTensor(out);
    }
    base=AdvanceTaskBase(base,tasks,cores);start=end;
  }
}
template<int BLOCK>
__global__ __aicore__ void ComputeVectorN1Short(GM_ADDR x,GM_ADDR weight,GM_ADDR scale,
  GM_ADDR groups,GM_ADDR y,int M,int K,int E)
{
  constexpr int MAX_ROW_SHIFT=7,ROWS=1<<MAX_ROW_SHIFT;
  static_assert(BLOCK==64 || BLOCK==128,"One or two vector blocks");
  GlobalTensor<int8_t> ag,bg;
  GlobalTensor<float> sg;
  GlobalTensor<int32_t> gg;
  GlobalTensor<half> yg;
  ag.SetGlobalBuffer((__gm__ int8_t*)x);bg.SetGlobalBuffer((__gm__ int8_t*)weight);
  sg.SetGlobalBuffer((__gm__ float*)scale);gg.SetGlobalBuffer((__gm__ int32_t*)groups);
  yg.SetGlobalBuffer((__gm__ half*)y);
  TPipe pipe;
  TBuf<TPosition::VECCALC> gb,wb,whb,wfb,ab,ahb,afb,zb,tb,sb;
  TQue<TPosition::VECOUT,1> oq;
  pipe.InitBuffer(gb,1024);pipe.InitBuffer(wb,BLOCK);
  pipe.InitBuffer(whb,BLOCK*2);pipe.InitBuffer(wfb,BLOCK*4);
  pipe.InitBuffer(ab,ROWS*BLOCK);pipe.InitBuffer(ahb,ROWS*BLOCK*2);
  pipe.InitBuffer(afb,ROWS*BLOCK*4);pipe.InitBuffer(zb,ROWS*4);
  pipe.InitBuffer(tb,ROWS*4);pipe.InitBuffer(sb,32);
  pipe.InitBuffer(oq,1,ROWS*2);
  auto g=gb.Get<int32_t>();auto w=wb.Get<int8_t>();auto wh=whb.Get<half>();
  auto wf=wfb.Get<float>();auto a=ab.Get<int8_t>();auto ah=ahb.Get<half>();
  auto af=afb.Get<float>();auto z=zb.Get<float>();auto t=tb.Get<float>();auto s=sb.Get<float>();
  Duplicate(a.ReinterpretCast<int16_t>(),(int16_t)0,ROWS*BLOCK/2);
  DataCopyPad(g,gg,DataCopyExtParams{1,(uint32_t)(E*8),0,0,0},
    DataCopyPadExtParams<int32_t>{true,0,0,0});
  SetFlag<HardEvent::MTE2_S>(EVENT_ID0);WaitFlag<HardEvent::MTE2_S>(EVENT_ID0);
  const int core=GetBlockIdx(),cores=GetBlockNum();
  int rowShift=3;
  while(rowShift<MAX_ROW_SHIFT && M>=cores*(1<<(rowShift+1)))++rowShift;
  const int rowTile=1<<rowShift,wp=(K+31)/32*32;
  int start=0,base=0;
  const int eBegin=M==1?SingleRowExpert(g,E):0;
  const int eLimit=M==1?eBegin+1:E;
  for(int e=eBegin;e<eLimit;++e){
    const int end=g.GetValue(2*e),tasks=(end-start+rowTile-1)>>rowShift;
    int first=core-base;if(first<0)first+=cores;
    if(first<tasks){
      SetFlag<HardEvent::V_MTE2>(EVENT_ID7);WaitFlag<HardEvent::V_MTE2>(EVENT_ID7);
      DataCopyPad(w,bg[(int64_t)e*K],DataCopyExtParams{1,(uint32_t)K,0,0,0},
        DataCopyPadExtParams<int8_t>{true,0,(uint8_t)(wp-K),0});
      DataCopyPad(s,sg[e],DataCopyExtParams{1,4,0,0,0},
        DataCopyPadExtParams<float>{true,0,0,0});
      SetFlag<HardEvent::MTE2_S>(EVENT_ID0);WaitFlag<HardEvent::MTE2_S>(EVENT_ID0);
      const float scaleValue=s.GetValue(0);
      SetFlag<HardEvent::MTE2_V>(EVENT_ID7);WaitFlag<HardEvent::MTE2_V>(EVENT_ID7);
      Cast(wh,w,RoundMode::CAST_NONE,wp);PipeBarrier<PIPE_V>();
      Duplicate(wf,0.0f,BLOCK);PipeBarrier<PIPE_V>();
      Cast(wf,wh,RoundMode::CAST_NONE,wp);PipeBarrier<PIPE_V>();
      for(int task=first;task<tasks;task+=cores){
        const int row=start+(task<<rowShift),rows=end-row<rowTile?end-row:rowTile;
        SetFlag<HardEvent::V_MTE2>(EVENT_ID7);WaitFlag<HardEvent::V_MTE2>(EVENT_ID7);
        DataCopyPad(a,ag[(int64_t)row*K],
          DataCopyExtParams{(uint16_t)rows,(uint32_t)K,0,
            (uint32_t)((BLOCK-wp)/32),0},
          DataCopyPadExtParams<int8_t>{true,0,(uint8_t)(wp-K),0});
        SetFlag<HardEvent::MTE2_V>(EVENT_ID7);WaitFlag<HardEvent::MTE2_V>(EVENT_ID7);
        Cast(ah,a,RoundMode::CAST_NONE,rows*BLOCK);PipeBarrier<PIPE_V>();
        Cast(af,ah,RoundMode::CAST_NONE,rows*BLOCK);PipeBarrier<PIPE_V>();
        for(int col=0;col<BLOCK;col+=64)
          Mul(af[col],af[col],wf[col],(uint64_t)64,(uint8_t)rows,
            BinaryRepeatParams{1,1,1,BLOCK/8,BLOCK/8,0});
        PipeBarrier<PIPE_V>();
        if constexpr(BLOCK==128){
          Add(af,af,af[64],(uint64_t)64,(uint8_t)rows,
            BinaryRepeatParams{1,1,1,BLOCK/8,BLOCK/8,BLOCK/8});
          PipeBarrier<PIPE_V>();
        }
        WholeReduceSum(z,af,64,rows,1,1,BLOCK/8);PipeBarrier<PIPE_V>();
        CanonicalIntegerZero(z,rows);
        for(int offset=0;offset<rows;offset+=64)
          Muls(z[offset],z[offset],scaleValue,(uint64_t)(rows-offset<64?rows-offset:64),1,
            UnaryRepeatParams{1,1,8,8});
        PipeBarrier<PIPE_V>();GeluBounded(z,t,rows);
        auto out=oq.AllocTensor<half>();Cast(out,z,RoundMode::CAST_RINT,rows);
        oq.EnQue(out);out=oq.DeQue<half>();
        DataCopyPad(yg[row],out,DataCopyExtParams{1,(uint32_t)(rows*2),0,0,0});
        oq.FreeTensor(out);
      }
    }
    base=AdvanceTaskBase(base,tasks,cores);start=end;
  }
}
template<int BLOCK>
__global__ __aicore__ void ComputeVectorN1Alias(GM_ADDR x,GM_ADDR weight,GM_ADDR scale,
  GM_ADDR groups,GM_ADDR y,int M,int K,int E)
{
  constexpr int MAX_ROW_SHIFT=BLOCK==256?7:6,ROWS=1<<MAX_ROW_SHIFT;
  constexpr int GROUPS=BLOCK/64;
  static_assert(BLOCK==256 || BLOCK==512,"Four or eight vector blocks");
  GlobalTensor<int8_t> ag,bg;
  GlobalTensor<float> sg;
  GlobalTensor<int32_t> gg;
  GlobalTensor<half> yg;
  ag.SetGlobalBuffer((__gm__ int8_t*)x);bg.SetGlobalBuffer((__gm__ int8_t*)weight);
  sg.SetGlobalBuffer((__gm__ float*)scale);gg.SetGlobalBuffer((__gm__ int32_t*)groups);
  yg.SetGlobalBuffer((__gm__ half*)y);
  TPipe pipe;
  TBuf<TPosition::VECCALC> gb,wb,whb,wfb,afb,rb,zb,tb,sb;
  TQue<TPosition::VECOUT,1> oq;
  pipe.InitBuffer(gb,1024);pipe.InitBuffer(wb,BLOCK);
  pipe.InitBuffer(whb,BLOCK*2);pipe.InitBuffer(wfb,BLOCK*4);
  pipe.InitBuffer(afb,ROWS*BLOCK*4);pipe.InitBuffer(rb,ROWS*GROUPS*8*8);
  pipe.InitBuffer(zb,ROWS*4);
  pipe.InitBuffer(tb,ROWS*4);pipe.InitBuffer(sb,32);
  pipe.InitBuffer(oq,1,ROWS*2);
  auto g=gb.Get<int32_t>();auto w=wb.Get<int8_t>();auto wh=whb.Get<half>();
  auto wf=wfb.Get<float>();
  auto af=afb.Get<float>();
  auto a=af.ReinterpretCast<int8_t>()[3*ROWS*BLOCK];
  auto partial=rb.Get<float>();auto scratch=partial.ReinterpretCast<half>();auto z=zb.Get<float>();auto t=tb.Get<float>();auto s=sb.Get<float>();
  const int core=GetBlockIdx(),cores=GetBlockNum();
  int rowShift=3;
  while(rowShift<MAX_ROW_SHIFT && M>=cores*(1<<(rowShift+1)))++rowShift;
  const int rowTile=1<<rowShift,wp=(K+31)/32*32;
  Duplicate(a.ReinterpretCast<int16_t>(),(int16_t)0,rowTile*BLOCK/2);
  DataCopyPad(g,gg,DataCopyExtParams{1,(uint32_t)(E*8),0,0,0},
    DataCopyPadExtParams<int32_t>{true,0,0,0});
  SetFlag<HardEvent::MTE2_S>(EVENT_ID0);WaitFlag<HardEvent::MTE2_S>(EVENT_ID0);
  int start=0,base=0;
  const int eBegin=M==1?SingleRowExpert(g,E):0;
  const int eLimit=M==1?eBegin+1:E;
  for(int e=eBegin;e<eLimit;++e){
    const int end=g.GetValue(2*e),tasks=(end-start+rowTile-1)>>rowShift;
    int first=core-base;if(first<0)first+=cores;
    if(first<tasks){
      SetFlag<HardEvent::V_MTE2>(EVENT_ID7);WaitFlag<HardEvent::V_MTE2>(EVENT_ID7);
      DataCopyPad(w,bg[(int64_t)e*K],DataCopyExtParams{1,(uint32_t)K,0,0,0},
        DataCopyPadExtParams<int8_t>{true,0,(uint8_t)(wp-K),0});
      DataCopyPad(s,sg[e],DataCopyExtParams{1,4,0,0,0},
        DataCopyPadExtParams<float>{true,0,0,0});
      SetFlag<HardEvent::MTE2_S>(EVENT_ID0);WaitFlag<HardEvent::MTE2_S>(EVENT_ID0);
      const float scaleValue=s.GetValue(0);
      SetFlag<HardEvent::MTE2_V>(EVENT_ID7);WaitFlag<HardEvent::MTE2_V>(EVENT_ID7);
      Cast(wh,w,RoundMode::CAST_NONE,wp);PipeBarrier<PIPE_V>();
      Duplicate(wf,0.0f,BLOCK);PipeBarrier<PIPE_V>();
      Cast(wf,wh,RoundMode::CAST_NONE,wp);PipeBarrier<PIPE_V>();
      for(int task=first;task<tasks;task+=cores){
        const int row=start+(task<<rowShift),rows=end-row<rowTile?end-row:rowTile;
        SetFlag<HardEvent::V_MTE2>(EVENT_ID7);WaitFlag<HardEvent::V_MTE2>(EVENT_ID7);
        DataCopyPad(a,ag[(int64_t)row*K],
          DataCopyExtParams{(uint16_t)rows,(uint32_t)K,0,
            (uint32_t)((BLOCK-wp)/32),0},
          DataCopyPadExtParams<int8_t>{true,0,(uint8_t)(wp-K),0});
        SetFlag<HardEvent::MTE2_V>(EVENT_ID7);WaitFlag<HardEvent::MTE2_V>(EVENT_ID7);
        constexpr int CAST_CHUNK=ROWS*GROUPS*8*4;
        for(int offset=0;offset<rows*BLOCK;offset+=CAST_CHUNK){
          const int left=rows*BLOCK-offset,count=left<CAST_CHUNK?left:CAST_CHUNK;
          Cast(scratch,a[offset],RoundMode::CAST_NONE,count);PipeBarrier<PIPE_V>();
          Cast(af[offset],scratch,RoundMode::CAST_NONE,count);PipeBarrier<PIPE_V>();
        }
        for(int col=0;col<BLOCK;col+=64)
          Mul(af[col],af[col],wf[col],(uint64_t)64,(uint8_t)rows,
            BinaryRepeatParams{1,1,1,BLOCK/8,BLOCK/8,0});
        PipeBarrier<PIPE_V>();
        for(int part=0;part<rows*GROUPS;part+=255){
          const int left=rows*GROUPS-part;
          WholeReduceSum(partial[part*8],af[part*64],64,left<255?left:255,8,1,8);
        }
        PipeBarrier<PIPE_V>();
        uint64_t mask[2]={GROUPS==4?0x01010101ULL:0x0101010101010101ULL,0};
        WholeReduceSum(z,partial,mask,rows,1,1,GROUPS);PipeBarrier<PIPE_V>();
        CanonicalIntegerZero(z,rows);
        for(int offset=0;offset<rows;offset+=64)
          Muls(z[offset],z[offset],scaleValue,(uint64_t)(rows-offset<64?rows-offset:64),1,
            UnaryRepeatParams{1,1,8,8});
        PipeBarrier<PIPE_V>();GeluBounded(z,t,rows);
        auto out=oq.AllocTensor<half>();Cast(out,z,RoundMode::CAST_RINT,rows);
        oq.EnQue(out);out=oq.DeQue<half>();
        DataCopyPad(yg[row],out,DataCopyExtParams{1,(uint32_t)(rows*2),0,0,0});
        oq.FreeTensor(out);
      }
    }
    base=AdvanceTaskBase(base,tasks,cores);start=end;
  }
}
__global__ __aicore__ void __attribute__((section(".text.Core.gmg.10.ComputeVectorN1Wide"))) ComputeVectorN1Wide(GM_ADDR x,GM_ADDR weight,GM_ADDR scale,
  GM_ADDR groups,GM_ADDR y,int M,int K,int E)
{
  constexpr int BLOCK=1024,MAX_ROW_SHIFT=5,ROWS=1<<MAX_ROW_SHIFT;
  constexpr int GROUPS=BLOCK/64;
  GlobalTensor<int8_t> ag,bg;
  GlobalTensor<float> sg;
  GlobalTensor<int32_t> gg;
  GlobalTensor<half> yg;
  ag.SetGlobalBuffer((__gm__ int8_t*)x);bg.SetGlobalBuffer((__gm__ int8_t*)weight);
  sg.SetGlobalBuffer((__gm__ float*)scale);gg.SetGlobalBuffer((__gm__ int32_t*)groups);
  yg.SetGlobalBuffer((__gm__ half*)y);
  TPipe pipe;
  TBuf<TPosition::VECCALC> gb,wb,whb,wfb,afb,rb,zb,tb,sb;
  TQue<TPosition::VECOUT,1> oq;
  pipe.InitBuffer(gb,1024);pipe.InitBuffer(wb,BLOCK);
  pipe.InitBuffer(whb,BLOCK*2);pipe.InitBuffer(wfb,BLOCK*4);
  pipe.InitBuffer(afb,ROWS*BLOCK*4);pipe.InitBuffer(rb,ROWS*GROUPS*8*8);
  pipe.InitBuffer(zb,ROWS*4);
  pipe.InitBuffer(tb,ROWS*4);pipe.InitBuffer(sb,32);
  pipe.InitBuffer(oq,1,ROWS*2);
  auto g=gb.Get<int32_t>();auto w=wb.Get<int8_t>();auto wh=whb.Get<half>();
  auto wf=wfb.Get<float>();
  auto af=afb.Get<float>();
  auto a=af.ReinterpretCast<int8_t>()[3*ROWS*BLOCK];
  auto partial=rb.Get<float>();auto scratch=partial.ReinterpretCast<half>();auto z=zb.Get<float>();auto t=tb.Get<float>();auto s=sb.Get<float>();
  const int core=GetBlockIdx(),cores=GetBlockNum();
  int rowShift=3;
  while(rowShift<MAX_ROW_SHIFT && M>=cores*(1<<(rowShift+1)))++rowShift;
  const int rowTile=1<<rowShift,wp=(K+31)/32*32;
  Duplicate(a.ReinterpretCast<int16_t>(),(int16_t)0,rowTile*BLOCK/2);
  DataCopyPad(g,gg,DataCopyExtParams{1,(uint32_t)(E*8),0,0,0},
    DataCopyPadExtParams<int32_t>{true,0,0,0});
  SetFlag<HardEvent::MTE2_S>(EVENT_ID0);WaitFlag<HardEvent::MTE2_S>(EVENT_ID0);
  int start=0,base=0;
  const int eBegin=M==1?SingleRowExpert(g,E):0;
  const int eLimit=M==1?eBegin+1:E;
  for(int e=eBegin;e<eLimit;++e){
    const int end=g.GetValue(2*e),tasks=(end-start+rowTile-1)>>rowShift;
    int first=core-base;if(first<0)first+=cores;
    if(first<tasks){
      SetFlag<HardEvent::V_MTE2>(EVENT_ID7);WaitFlag<HardEvent::V_MTE2>(EVENT_ID7);
      DataCopyPad(w,bg[(int64_t)e*K],DataCopyExtParams{1,(uint32_t)K,0,0,0},
        DataCopyPadExtParams<int8_t>{true,0,(uint8_t)(wp-K),0});
      DataCopyPad(s,sg[e],DataCopyExtParams{1,4,0,0,0},
        DataCopyPadExtParams<float>{true,0,0,0});
      SetFlag<HardEvent::MTE2_S>(EVENT_ID0);WaitFlag<HardEvent::MTE2_S>(EVENT_ID0);
      const float scaleValue=s.GetValue(0);
      SetFlag<HardEvent::MTE2_V>(EVENT_ID7);WaitFlag<HardEvent::MTE2_V>(EVENT_ID7);
      Cast(wh,w,RoundMode::CAST_NONE,wp);PipeBarrier<PIPE_V>();
      Duplicate(wf,0.0f,BLOCK);PipeBarrier<PIPE_V>();
      Cast(wf,wh,RoundMode::CAST_NONE,wp);PipeBarrier<PIPE_V>();
      for(int task=first;task<tasks;task+=cores){
        const int row=start+(task<<rowShift),rows=end-row<rowTile?end-row:rowTile;
        SetFlag<HardEvent::V_MTE2>(EVENT_ID7);WaitFlag<HardEvent::V_MTE2>(EVENT_ID7);
        DataCopyPad(a,ag[(int64_t)row*K],
          DataCopyExtParams{(uint16_t)rows,(uint32_t)K,0,
            (uint32_t)((BLOCK-wp)/32),0},
          DataCopyPadExtParams<int8_t>{true,0,(uint8_t)(wp-K),0});
        SetFlag<HardEvent::MTE2_V>(EVENT_ID7);WaitFlag<HardEvent::MTE2_V>(EVENT_ID7);
        constexpr int CAST_CHUNK=ROWS*GROUPS*8*4;
        for(int offset=0;offset<rows*BLOCK;offset+=CAST_CHUNK){
          const int left=rows*BLOCK-offset,count=left<CAST_CHUNK?left:CAST_CHUNK;
          Cast(scratch,a[offset],RoundMode::CAST_NONE,count);PipeBarrier<PIPE_V>();
          Cast(af[offset],scratch,RoundMode::CAST_NONE,count);PipeBarrier<PIPE_V>();
        }
        for(int col=0;col<BLOCK;col+=64)
          Mul(af[col],af[col],wf[col],(uint64_t)64,(uint8_t)rows,
            BinaryRepeatParams{1,1,1,BLOCK/8,BLOCK/8,0});
        PipeBarrier<PIPE_V>();
        for(int part=0;part<rows*GROUPS;part+=255){
          const int left=rows*GROUPS-part;
          WholeReduceSum(partial[part*8],af[part*64],64,left<255?left:255,8,1,8);
        }
        PipeBarrier<PIPE_V>();
        uint64_t mask[2]={0x0101010101010101ULL,0};
        Add(partial,partial,partial[64],mask,(uint8_t)rows,
          BinaryRepeatParams{1,1,1,GROUPS,GROUPS,GROUPS});
        PipeBarrier<PIPE_V>();
        WholeReduceSum(z,partial,mask,rows,1,1,GROUPS);PipeBarrier<PIPE_V>();
        Adds(z,z,0.0f,(uint64_t)rows,1,UnaryRepeatParams{1,1,8,8});
        PipeBarrier<PIPE_V>();
        Muls(z,z,scaleValue,(uint64_t)rows,1,UnaryRepeatParams{1,1,8,8});
        PipeBarrier<PIPE_V>();GeluBounded(z,t,rows);
        auto out=oq.AllocTensor<half>();Cast(out,z,RoundMode::CAST_RINT,rows);
        oq.EnQue(out);out=oq.DeQue<half>();
        DataCopyPad(yg[row],out,DataCopyExtParams{1,(uint32_t)(rows*2),0,0,0});
        oq.FreeTensor(out);
      }
    }
    base=AdvanceTaskBase(base,tasks,cores);start=end;
  }
}
template<int BLOCK>
__global__ __aicore__ void ComputeVectorN1Long(GM_ADDR x,GM_ADDR weight,GM_ADDR scale,
  GM_ADDR groups,GM_ADDR y,int M,int K,int E)
{
  static_assert(BLOCK==2048 || BLOCK==4096 || BLOCK==8192,"Long vector blocks");
  constexpr int ROWS=32768/BLOCK,MAX_ROW_SHIFT=BLOCK==2048?4:(BLOCK==4096?3:2);
  constexpr int PARTS=BLOCK/64,SUBDOTS=BLOCK/1024,CHUNKS=ROWS*SUBDOTS;
  constexpr int SCRATCH_BYTES=BLOCK<=4096?32768:16384,CAST_CHUNK=SCRATCH_BYTES/2;
  constexpr int ROW_BYTES=(ROWS*4+31)/32*32,OUT_BYTES=(ROWS*2+31)/32*32;
  GlobalTensor<int8_t> ag,bg;
  GlobalTensor<float> sg;
  GlobalTensor<int32_t> gg;
  GlobalTensor<half> yg;
  ag.SetGlobalBuffer((__gm__ int8_t*)x);bg.SetGlobalBuffer((__gm__ int8_t*)weight);
  sg.SetGlobalBuffer((__gm__ float*)scale);gg.SetGlobalBuffer((__gm__ int32_t*)groups);
  yg.SetGlobalBuffer((__gm__ half*)y);
  TPipe pipe;
  TBuf<TPosition::VECCALC> gb,wfb,afb,rb,pfb,pib,zb,tb,sb;
  TQue<TPosition::VECOUT,1> oq;
  pipe.InitBuffer(gb,1024);pipe.InitBuffer(wfb,BLOCK*4);
  pipe.InitBuffer(afb,ROWS*BLOCK*4);pipe.InitBuffer(rb,SCRATCH_BYTES);
  pipe.InitBuffer(pfb,CHUNKS*8*4);pipe.InitBuffer(pib,CHUNKS*8*4);
  pipe.InitBuffer(zb,ROW_BYTES);pipe.InitBuffer(tb,ROW_BYTES);pipe.InitBuffer(sb,32);
  pipe.InitBuffer(oq,1,OUT_BYTES);
  auto g=gb.Get<int32_t>();auto wf=wfb.Get<float>();
  auto w=wf.ReinterpretCast<int8_t>()[3*BLOCK];
  auto af=afb.Get<float>();auto a=af.ReinterpretCast<int8_t>()[3*ROWS*BLOCK];
  auto partial=rb.Get<float>();auto scratch=partial.ReinterpretCast<half>();
  auto pf=pfb.Get<float>();auto pi=pib.Get<int32_t>();
  auto z=zb.Get<float>();auto t=tb.Get<float>();auto s=sb.Get<float>();
  const int core=GetBlockIdx(),cores=GetBlockNum();
  int rowShift=0;
  while(rowShift<MAX_ROW_SHIFT && M>=cores*(1<<(rowShift+1)))++rowShift;
  const int rowTile=1<<rowShift,wp=(K+31)/32*32;
  Duplicate(a.ReinterpretCast<int16_t>(),(int16_t)0,rowTile*BLOCK/2);
  Duplicate(pf,0.0f,CHUNKS*8);
  DataCopyPad(g,gg,DataCopyExtParams{1,(uint32_t)(E*8),0,0,0},
    DataCopyPadExtParams<int32_t>{true,0,0,0});
  SetFlag<HardEvent::MTE2_S>(EVENT_ID0);WaitFlag<HardEvent::MTE2_S>(EVENT_ID0);
  int start=0,base=0;
  const int eBegin=M==1?SingleRowExpert(g,E):0;
  const int eLimit=M==1?eBegin+1:E;
  for(int e=eBegin;e<eLimit;++e){
    const int end=g.GetValue(2*e),tasks=(end-start+rowTile-1)>>rowShift;
    int first=core-base;if(first<0)first+=cores;
    if(first<tasks){
      SetFlag<HardEvent::V_MTE2>(EVENT_ID7);WaitFlag<HardEvent::V_MTE2>(EVENT_ID7);
      DataCopyPad(w,bg[(int64_t)e*K],DataCopyExtParams{1,(uint32_t)K,0,0,0},
        DataCopyPadExtParams<int8_t>{true,0,(uint8_t)(wp-K),0});
      DataCopyPad(s,sg[e],DataCopyExtParams{1,4,0,0,0},
        DataCopyPadExtParams<float>{true,0,0,0});
      SetFlag<HardEvent::MTE2_S>(EVENT_ID0);WaitFlag<HardEvent::MTE2_S>(EVENT_ID0);
      const float scaleValue=s.GetValue(0);
      SetFlag<HardEvent::MTE2_V>(EVENT_ID7);WaitFlag<HardEvent::MTE2_V>(EVENT_ID7);
      Cast(scratch,w,RoundMode::CAST_NONE,wp);PipeBarrier<PIPE_V>();
      Duplicate(wf,0.0f,BLOCK);PipeBarrier<PIPE_V>();
      Cast(wf,scratch,RoundMode::CAST_NONE,wp);PipeBarrier<PIPE_V>();
      for(int task=first;task<tasks;task+=cores){
        const int row=start+(task<<rowShift),rows=end-row<rowTile?end-row:rowTile;
        SetFlag<HardEvent::V_MTE2>(EVENT_ID7);WaitFlag<HardEvent::V_MTE2>(EVENT_ID7);
        DataCopyPad(a,ag[(int64_t)row*K],
          DataCopyExtParams{(uint16_t)rows,(uint32_t)K,0,
            (uint32_t)((BLOCK-wp)/32),0},
          DataCopyPadExtParams<int8_t>{true,0,(uint8_t)(wp-K),0});
        SetFlag<HardEvent::MTE2_V>(EVENT_ID7);WaitFlag<HardEvent::MTE2_V>(EVENT_ID7);
        for(int offset=0;offset<rows*BLOCK;offset+=CAST_CHUNK){
          const int left=rows*BLOCK-offset,count=left<CAST_CHUNK?left:CAST_CHUNK;
          Cast(scratch,a[offset],RoundMode::CAST_NONE,count);PipeBarrier<PIPE_V>();
          Cast(af[offset],scratch,RoundMode::CAST_NONE,count);PipeBarrier<PIPE_V>();
        }
        for(int localRow=0;localRow<rows;++localRow)
          Mul(af[localRow*BLOCK],af[localRow*BLOCK],wf,BLOCK);
        PipeBarrier<PIPE_V>();
        for(int part=0;part<rows*PARTS;part+=255){
          const int left=rows*PARTS-part;
          WholeReduceSum(partial[part*8],af[part*64],64,left<255?left:255,8,1,8);
        }
        PipeBarrier<PIPE_V>();
        uint64_t eight[2]={0x0101010101010101ULL,0};
        Add(partial,partial,partial[64],eight,(uint8_t)(rows*SUBDOTS),
          BinaryRepeatParams{1,1,1,16,16,16});
        PipeBarrier<PIPE_V>();
        WholeReduceSum(pf,partial,eight,rows*SUBDOTS,8,1,16);
        PipeBarrier<PIPE_V>();
        Cast(pi,pf,RoundMode::CAST_RINT,rows*SUBDOTS*8);PipeBarrier<PIPE_V>();
        for(int step=SUBDOTS/2;step>0;step/=2){
          uint64_t mask[2]={0,0};
          for(int i=0;i<step;++i)mask[0]|=1ULL<<(i*8);
          Add(pi,pi,pi[step*8],mask,(uint8_t)rows,
            BinaryRepeatParams{1,1,1,SUBDOTS,SUBDOTS,SUBDOTS});
          PipeBarrier<PIPE_V>();
        }
        Cast(pf,pi,RoundMode::CAST_RINT,rows*SUBDOTS*8);PipeBarrier<PIPE_V>();
        uint64_t one[2]={1,0};
        WholeReduceSum(z,pf,one,rows,1,1,SUBDOTS);PipeBarrier<PIPE_V>();
        Muls(z,z,scaleValue,(uint64_t)rows,1,UnaryRepeatParams{1,1,8,8});
        PipeBarrier<PIPE_V>();GeluBounded(z,t,rows);
        auto out=oq.AllocTensor<half>();Cast(out,z,RoundMode::CAST_RINT,rows);
        oq.EnQue(out);out=oq.DeQue<half>();
        DataCopyPad(yg[row],out,DataCopyExtParams{1,(uint32_t)(rows*2),0,0,0});
        oq.FreeTensor(out);
      }
    }
    base=AdvanceTaskBase(base,tasks,cores);start=end;
  }
}
template<int TM, int TN, bool PADDED, bool TRANSPORT, bool USE_NORMAL = false, bool USE_DIRECT = false>
__global__ __mix__(1, 1) __attribute__((aligned(64))) void __attribute__((section(".text.Core.gmg.03.ComputeBulkDirect"))) ComputeBulkDirect(
  GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groups,
  GM_ADDR y, GM_ADDR workspace, int M, int N, int K, int E, TCubeTiling tiling)
{
  static_assert(!PADDED,"single-reader Direct uses guarded operand transport");
  InitSocState();
  GlobalTensor<int8_t> ag, bg;
  GlobalTensor<int64_t> gg;
  GlobalTensor<int32_t> cg;
  GlobalTensor<float> sg;
  GlobalTensor<half> yg;
  ag.SetGlobalBuffer((__gm__ int8_t*)x);
  bg.SetGlobalBuffer((__gm__ int8_t*)weight);
  gg.SetGlobalBuffer((__gm__ int64_t*)groups);
  cg.SetGlobalBuffer((__gm__ int32_t*)workspace);
  sg.SetGlobalBuffer((__gm__ float*)scale);
  yg.SetGlobalBuffer((__gm__ half*)y);
  const int ka = K;
  const int nb = PADDED ? (N + 31) / 32 * 32 : N;
  if constexpr (PADDED) {
    auto base = workspace + (int64_t)GetBlockNum() * 2 * (TM * TN + 128) * sizeof(int32_t);
    GlobalTensor<int8_t> ap, bp;
    ap.SetGlobalBuffer((__gm__ int8_t*)base);
    bp.SetGlobalBuffer((__gm__ int8_t*)(base + (ka != K ? (int64_t)M * ka : 0)));
    if ASCEND_IS_AIV {
      if (ka != K) PadRows(ap, ag, M, K, ka);
      if (nb != N) PadRows(bp, bg, (int64_t)E * K, N, nb);
    }
    SyncAll<false>();
    if (ka != K) ag = ap;
    if (nb != N) bg = bp;
  }
  const int nc = (N + TN - 1) / TN;
  const int cores = GetBlockNum();
  const bool shardExperts = M!=1 && E >= 2 * cores && N <= 512 && K <= 512;
  if ASCEND_IS_AIC {
    TPipe pipe;
    typename CubeSelect<TM,TN,USE_NORMAL,USE_DIRECT,typename TransportCallback<TRANSPORT>::Type>::Type mm;
    mm.SetSubBlockIdx(0);
    mm.Init(&tiling, &pipe);
    mm.SetOrgShape(M, TRANSPORT ? (N+31)/32*32 : nb, ka, K, TN);
    uint64_t meta=0;
    if constexpr (TRANSPORT || USE_DIRECT)
      meta=(uint64_t)ka|((uint64_t)nb<<14)|((uint64_t)K<<27)
        |((uint64_t)(tiling.baseM/16)<<41)|((uint64_t)(tiling.baseN/32)<<45)
        |((uint64_t)(tiling.baseK/32)<<50)|((uint64_t)PADDED<<56);
    int taskBase = 0;
    int start = 0;
    int produced = 0;
    const int eFirst = M==1 ? SingleRowExpert(gg,E) : (shardExperts ? GetBlockIdx() : 0);
    const int eStep = M==1 ? E : (shardExperts ? cores : 1);
    for (int e = eFirst; e < E; e += eStep) {
      if (shardExperts) start = e == 0 ? 0 : (int)gg.GetValue(e - 1);
      int end = (int)gg.GetValue(e);
      int tiles = ((end - start + TM - 1) / TM) * nc;
      if(tiles==0){start=end;continue;}
      int first = shardExperts ? 0 : GetBlockIdx()-taskBase;
      if(first<0)first+=cores;
      const int taskStep = shardExperts ? 1 : cores;
      for (int task = first; task < tiles; task += taskStep) {
        const int slot = produced & 1;
        if (produced >= 2) CrossCoreWaitFlag<2>(1 + 2 * slot);
        int mr,nr;TileCoordinates(task,nc,mr,nr);
        int row = start + mr * TM;
        int col = nr * TN;
        int rows = end - row < TM ? end - row : TM;
        int cols = N - col < TN ? N - col : TN;
        if constexpr (TRANSPORT || USE_DIRECT) {
          mm.SetSelfDefineData(meta|((uint64_t)(e==E-1 && nb==N)<<55)
            |((uint64_t)(col/128)<<57)|((uint64_t)(row+rows==M)<<62));
        }
        mm.SetSingleShape(rows, TRANSPORT ? (cols+31)/32*32 : cols, K);
        mm.SetTensorA(ag[(int64_t)row * ka], false);
        mm.SetTensorB(bg[(int64_t)e * K * nb + col], false);
        mm.IterateAll(cg[((int64_t)GetBlockIdx() * 2 + slot) * (TM * TN + 128)], false);
        CrossCoreSetFlag<2, PIPE_FIX>(2 * slot);
        ++produced;
      }
      if(!shardExperts)taskBase=AdvanceTaskBase(taskBase,tiles,cores);
      start = end;
    }
    if (produced > 1) CrossCoreWaitFlag<2>(1 + 2 * ((produced - 2) & 1));
    if (produced > 0) CrossCoreWaitFlag<2>(1 + 2 * ((produced - 1) & 1));
    mm.End();
  }
  if ASCEND_IS_AIV {
    const int core = GetBlockIdx();
    constexpr int sub = 0;
    constexpr int VCOLS = TN;
    constexpr int VCOUNT = TM * VCOLS;
    static_assert(10*VCOUNT+4*VCOLS<=196352,"AIV static UB capacity");
    LocalTensor<int32_t> c(TPosition::VECIN,0,VCOUNT);
    LocalTensor<float> s(TPosition::VECIN,4*VCOUNT,VCOLS);
    LocalTensor<float> t(TPosition::VECCALC,6*VCOUNT+4*VCOLS,VCOUNT);
    LocalTensor<half> out(TPosition::VECOUT,4*VCOUNT+4*VCOLS,VCOUNT);
    SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
    SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
    int consumed = 0;
    int taskBase = 0;
    int start = 0;
    const int eFirst = M==1 ? SingleRowExpert(gg,E) : (shardExperts ? core : 0);
    const int eStep = M==1 ? E : (shardExperts ? cores : 1);
    for (int e = eFirst; e < E; e += eStep) {
      if (shardExperts) start = e == 0 ? 0 : (int)gg.GetValue(e - 1);
      int end = (int)gg.GetValue(e);
      int tiles = ((end - start + TM - 1) / TM) * nc;
      if(tiles==0){start=end;continue;}
      int first = shardExperts ? 0 : core-taskBase;
      if(first<0)first+=cores;
      const int taskStep = shardExperts ? 1 : cores;
      for (int task = first; task < tiles; task += taskStep) {
        int mr,nr;TileCoordinates(task,nc,mr,nr);
        int row = start + mr * TM;
        int col = nr * TN + sub * VCOLS;
        int rows = end - row < TM ? end - row : TM;
        int cols = N - col < VCOLS ? N - col : VCOLS;
        const int slot = consumed & 1;
        CrossCoreWaitFlag<2>(2 * slot);
        if (rows > 0 && cols > 0) {
          WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
          DataCopyPad(c, cg[((int64_t)core * 2 + slot) * (TM * TN + 128) + sub * VCOLS],
            DataCopyExtParams{(uint16_t)rows, (uint32_t)(cols * 4),
              (uint32_t)((TN - cols) * 4), (uint32_t)((VCOLS - (cols + 7) / 8 * 8) / 8), 0},
            DataCopyPadExtParams<int32_t>{true, 0, 0, 0});
          DataCopyPad(s, sg[(int64_t)e * N + col],
            DataCopyExtParams{1, (uint32_t)(cols * 4), 0, 0, 0},
            DataCopyPadExtParams<float>{true, 0, 0, 0.0f});
          SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
          WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
          CrossCoreSetFlag<2, PIPE_MTE2>(1 + 2 * slot);
          auto z = c.ReinterpretCast<float>();
          Cast(z, c, RoundMode::CAST_RINT, rows * VCOLS);
          PipeBarrier<PIPE_V>();
          if constexpr (TM > 255) {
            for(int r0=0;r0<rows;r0+=255){
              const uint8_t repeats=(uint8_t)(rows-r0<255?rows-r0:255);
              for(int c0=0;c0<VCOLS;c0+=64)
                Mul(z[r0*VCOLS+c0],z[r0*VCOLS+c0],s[c0],(uint64_t)64,repeats,
                  BinaryRepeatParams{1,1,1,VCOLS/8,VCOLS/8,0});
            }
          } else {
            for (int c0 = 0; c0 < VCOLS; c0 += 64)
              Mul(z[c0], z[c0], s[c0], (uint64_t)64, (uint8_t)rows,
                BinaryRepeatParams{1, 1, 1, VCOLS / 8, VCOLS / 8, 0});
          }
          PipeBarrier<PIPE_V>();
          GeluBounded(z,t,rows*VCOLS);
          WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
          Cast(out, z, RoundMode::CAST_RINT, rows * VCOLS);
          SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
          WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
          SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
          DataCopyPad(yg[(int64_t)row * N + col], out,
            DataCopyExtParams{(uint16_t)rows, (uint32_t)(cols * 2),
              (uint32_t)((VCOLS - (cols + 15) / 16 * 16) / 16),
              (uint32_t)((N - cols) * 2), 0});
          SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
        } else {
          CrossCoreSetFlag<2, PIPE_MTE2>(1 + 2 * slot);
        }
        ++consumed;
      }
      if(!shardExperts)taskBase=AdvanceTaskBase(taskBase,tiles,cores);
      start = end;
    }
    WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
    WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
    PipeBarrier<PIPE_ALL>();
  }
}
template<int TM, int TN, bool PADDED, bool TRANSPORT, bool USE_NORMAL = false, bool USE_DIRECT = false, bool STATIC_TILE = false, int STATIC_K = 0>
__global__ __mix__(1, 2) void __attribute__((section(".text.Core.gmg.01.Compute"))) Compute(
  GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groups,
  GM_ADDR y, GM_ADDR workspace, int M, int N, int runtimeK, int E, TCubeTiling tiling)
{
  const int K=STATIC_K>0?STATIC_K:runtimeK;
  InitSocState();
  GlobalTensor<int8_t> ag, bg;
  GlobalTensor<int64_t> gg;
  GlobalTensor<int32_t> cg;
  GlobalTensor<float> sg;
  GlobalTensor<half> yg;
  ag.SetGlobalBuffer((__gm__ int8_t*)x);
  bg.SetGlobalBuffer((__gm__ int8_t*)weight);
  gg.SetGlobalBuffer((__gm__ int64_t*)groups);
  cg.SetGlobalBuffer((__gm__ int32_t*)workspace);
  sg.SetGlobalBuffer((__gm__ float*)scale);
  yg.SetGlobalBuffer((__gm__ half*)y);
  const int ka = PADDED ? (K + 31) / 32 * 32 : K;
  const int nb = PADDED ? (N + 31) / 32 * 32 : N;
  if constexpr (PADDED) {
    auto base = workspace + (int64_t)GetBlockNum() * 2 * (TM * TN + 128) * sizeof(int32_t);
    GlobalTensor<int8_t> ap, bp;
    ap.SetGlobalBuffer((__gm__ int8_t*)base);
    bp.SetGlobalBuffer((__gm__ int8_t*)(base + (ka != K ? (int64_t)M * ka : 0)));
    if ASCEND_IS_AIV {
      if (ka != K) PadRows(ap, ag, M, K, ka);
      if (nb != N) PadRows(bp, bg, (int64_t)E * K, N, nb);
    }
    SyncAll<false>();
    if (ka != K) ag = ap;
    if (nb != N) bg = bp;
  }
  const int nc = (N + TN - 1) / TN;
  const int cores = GetBlockNum();
  const bool shardExperts = M!=1 && E >= 2 * cores && N <= 512 && K <= 512;
  if ASCEND_IS_AIC {
    TPipe pipe;
    typename TileCubeSelect<TM,TN,USE_NORMAL,USE_DIRECT,typename TransportCallback<TRANSPORT>::Type,STATIC_TILE,STATIC_K>::Type mm;
    mm.SetSubBlockIdx(0);
    mm.Init(&tiling, &pipe);
    mm.SetOrgShape(M, TRANSPORT ? (N+31)/32*32 : nb, ka, K, TN);
    uint64_t meta=0;
    if constexpr (TRANSPORT || USE_DIRECT)
      meta=(uint64_t)ka|((uint64_t)nb<<14)|((uint64_t)K<<27)
        |((uint64_t)(tiling.baseM/16)<<41)|((uint64_t)(tiling.baseN/32)<<45)
        |((uint64_t)(tiling.baseK/32)<<50)|((uint64_t)PADDED<<56);
    int taskBase = 0;
    int start = 0;
    int produced = 0;
    const int eFirst = M==1 ? SingleRowExpert(gg,E) : (shardExperts ? GetBlockIdx() : 0);
    const int eStep = M==1 ? E : (shardExperts ? cores : 1);
    for (int e = eFirst; e < E; e += eStep) {
      if (shardExperts) start = e == 0 ? 0 : (int)gg.GetValue(e - 1);
      int end = (int)gg.GetValue(e);
      int tiles = ((end - start + TM - 1) / TM) * nc;
      if(tiles==0){start=end;continue;}
      int first = shardExperts ? 0 : GetBlockIdx()-taskBase;
      if(first<0)first+=cores;
      const int taskStep = shardExperts ? 1 : cores;
      for (int task = first; task < tiles; task += taskStep) {
        const int slot = produced & 1;
        if (produced >= 2) CrossCoreWaitFlag<2>(1 + 2 * slot);
        int mr,nr;TileCoordinates(task,nc,mr,nr);
        int row = start + mr * TM;
        int col = nr * TN;
        int rows = end - row < TM ? end - row : TM;
        int cols = N - col < TN ? N - col : TN;
        if constexpr (TRANSPORT || USE_DIRECT) {
          mm.SetSelfDefineData(meta|((uint64_t)(e==E-1 && nb==N)<<55)
            |((uint64_t)(col/128)<<57)|((uint64_t)(row+rows==M)<<62));
        }
        mm.SetSingleShape(rows, TRANSPORT ? (cols+31)/32*32 : cols, K);
        mm.SetTensorA(ag[(int64_t)row * ka], false);
        mm.SetTensorB(bg[(int64_t)e * K * nb + col], false);
        mm.IterateAll(cg[((int64_t)GetBlockIdx() * 2 + slot) * (TM * TN + 128)], false);
        CrossCoreSetFlag<2, PIPE_FIX>(2 * slot);
        ++produced;
      }
      if(!shardExperts)taskBase=AdvanceTaskBase(taskBase,tiles,cores);
      start = end;
    }
    if (produced > 1) CrossCoreWaitFlag<2>(1 + 2 * ((produced - 2) & 1));
    if (produced > 0) CrossCoreWaitFlag<2>(1 + 2 * ((produced - 1) & 1));
    mm.End();
  }
  if ASCEND_IS_AIV {
    if constexpr (TRANSPORT || TN >= 512 || STATIC_TILE) {
    const int core = GetBlockIdx() / 2;
    const int sub = GetBlockIdx() % 2;
    constexpr int VCOLS = TN / 2;
    constexpr int VCOUNT = TM * VCOLS;
    static_assert(10*VCOUNT+4*VCOLS<=196352,"AIV static UB capacity");
    LocalTensor<int32_t> c(TPosition::VECIN,0,VCOUNT);
    LocalTensor<float> s(TPosition::VECIN,4*VCOUNT,VCOLS);
    LocalTensor<float> t(TPosition::VECCALC,6*VCOUNT+4*VCOLS,VCOUNT);
    LocalTensor<half> out(TPosition::VECOUT,4*VCOUNT+4*VCOLS,VCOUNT);
    SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
    SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
    int consumed = 0;
    int taskBase = 0;
    int start = 0;
    const int eFirst = M==1 ? SingleRowExpert(gg,E) : (shardExperts ? core : 0);
    const int eStep = M==1 ? E : (shardExperts ? cores : 1);
    for (int e = eFirst; e < E; e += eStep) {
      if (shardExperts) start = e == 0 ? 0 : (int)gg.GetValue(e - 1);
      int end = (int)gg.GetValue(e);
      int tiles = ((end - start + TM - 1) / TM) * nc;
      if(tiles==0){start=end;continue;}
      int first = shardExperts ? 0 : core-taskBase;
      if(first<0)first+=cores;
      const int taskStep = shardExperts ? 1 : cores;
      for (int task = first; task < tiles; task += taskStep) {
        int mr,nr;TileCoordinates(task,nc,mr,nr);
        int row = start + mr * TM;
        int col = nr * TN + sub * VCOLS;
        int rows = end - row < TM ? end - row : TM;
        int cols = N - col < VCOLS ? N - col : VCOLS;
        const int slot = consumed & 1;
        CrossCoreWaitFlag<2>(2 * slot);
        if (rows > 0 && cols > 0) {
          WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
          DataCopyPad(c, cg[((int64_t)core * 2 + slot) * (TM * TN + 128) + sub * VCOLS],
            DataCopyExtParams{(uint16_t)rows, (uint32_t)(cols * 4),
              (uint32_t)((TN - cols) * 4), (uint32_t)((VCOLS - (cols + 7) / 8 * 8) / 8), 0},
            DataCopyPadExtParams<int32_t>{true, 0, 0, 0});
          DataCopyPad(s, sg[(int64_t)e * N + col],
            DataCopyExtParams{1, (uint32_t)(cols * 4), 0, 0, 0},
            DataCopyPadExtParams<float>{true, 0, 0, 0.0f});
          SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
          WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
          CrossCoreSetFlag<2, PIPE_MTE2>(1 + 2 * slot);
          auto z = c.ReinterpretCast<float>();
          Cast(z, c, RoundMode::CAST_RINT, rows * VCOLS);
          PipeBarrier<PIPE_V>();
          if constexpr (TM > 255) {
            for(int r0=0;r0<rows;r0+=255){
              const uint8_t repeats=(uint8_t)(rows-r0<255?rows-r0:255);
              for(int c0=0;c0<VCOLS;c0+=64)
                Mul(z[r0*VCOLS+c0],z[r0*VCOLS+c0],s[c0],(uint64_t)64,repeats,
                  BinaryRepeatParams{1,1,1,VCOLS/8,VCOLS/8,0});
            }
          } else {
            for (int c0 = 0; c0 < VCOLS; c0 += 64)
              Mul(z[c0], z[c0], s[c0], (uint64_t)64, (uint8_t)rows,
                BinaryRepeatParams{1, 1, 1, VCOLS / 8, VCOLS / 8, 0});
          }
          PipeBarrier<PIPE_V>();
          GeluBounded(z,t,rows*VCOLS);
          WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
          Cast(out, z, RoundMode::CAST_RINT, rows * VCOLS);
          SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
          WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
          SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
          DataCopyPad(yg[(int64_t)row * N + col], out,
            DataCopyExtParams{(uint16_t)rows, (uint32_t)(cols * 2),
              (uint32_t)((VCOLS - (cols + 15) / 16 * 16) / 16),
              (uint32_t)((N - cols) * 2), 0});
          SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
        } else {
          CrossCoreSetFlag<2, PIPE_MTE2>(1 + 2 * slot);
        }
        ++consumed;
      }
      if(!shardExperts)taskBase=AdvanceTaskBase(taskBase,tiles,cores);
      start = end;
    }
    WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
    WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
    PipeBarrier<PIPE_ALL>();
    } else {
    const int core = GetBlockIdx() / 2;
    const int sub = GetBlockIdx() % 2;
    constexpr int VCOLS = TN / 2;
    constexpr int VCOUNT = TM * VCOLS;
    TPipe pipe;
    TQue<TPosition::VECIN, 1> cq, sq;
    TQue<TPosition::VECOUT, 1> oq;
    TBuf<TPosition::VECCALC> tb;
    pipe.InitBuffer(cq, 1, VCOUNT * sizeof(int32_t));
    pipe.InitBuffer(sq, 1, VCOLS * sizeof(float));
    pipe.InitBuffer(oq, 1, VCOUNT * sizeof(half));
    pipe.InitBuffer(tb, VCOUNT * sizeof(float));
    auto t = tb.Get<float>();
    int consumed = 0;
    int taskBase = 0;
    int start = 0;
    const int eFirst = M==1 ? SingleRowExpert(gg,E) : (shardExperts ? core : 0);
    const int eStep = M==1 ? E : (shardExperts ? cores : 1);
    for (int e = eFirst; e < E; e += eStep) {
      if (shardExperts) start = e == 0 ? 0 : (int)gg.GetValue(e - 1);
      int end = (int)gg.GetValue(e);
      int tiles = ((end - start + TM - 1) / TM) * nc;
      if(tiles==0){start=end;continue;}
      int first = shardExperts ? 0 : core-taskBase;
      if(first<0)first+=cores;
      const int taskStep = shardExperts ? 1 : cores;
      for (int task = first; task < tiles; task += taskStep) {
        int mr,nr;TileCoordinates(task,nc,mr,nr);
        int row = start + mr * TM;
        int col = nr * TN + sub * VCOLS;
        int rows = end - row < TM ? end - row : TM;
        int cols = N - col < VCOLS ? N - col : VCOLS;
        const int slot = consumed & 1;
        CrossCoreWaitFlag<2>(2 * slot);
        if (rows > 0 && cols > 0) {
          auto c = cq.AllocTensor<int32_t>();
          auto s = sq.AllocTensor<float>();
          DataCopyPad(c, cg[((int64_t)core * 2 + slot) * (TM * TN + 128) + sub * VCOLS],
            DataCopyExtParams{(uint16_t)rows, (uint32_t)(cols * 4),
              (uint32_t)((TN - cols) * 4), (uint32_t)((VCOLS - (cols + 7) / 8 * 8) / 8), 0},
            DataCopyPadExtParams<int32_t>{true, 0, 0, 0});
          DataCopyPad(s, sg[(int64_t)e * N + col],
            DataCopyExtParams{1, (uint32_t)(cols * 4), 0, 0, 0},
            DataCopyPadExtParams<float>{true, 0, 0, 0.0f});
          cq.EnQue(c);
          sq.EnQue(s);
          c = cq.DeQue<int32_t>();
          s = sq.DeQue<float>();
          CrossCoreSetFlag<2, PIPE_MTE2>(1 + 2 * slot);
          auto z = c.ReinterpretCast<float>();
          Cast(z, c, RoundMode::CAST_RINT, rows * VCOLS);
          PipeBarrier<PIPE_V>();
          if constexpr (TM > 255) {
            for(int r0=0;r0<rows;r0+=255){
              const uint8_t repeats=(uint8_t)(rows-r0<255?rows-r0:255);
              for(int c0=0;c0<VCOLS;c0+=64)
                Mul(z[r0*VCOLS+c0],z[r0*VCOLS+c0],s[c0],(uint64_t)64,repeats,
                  BinaryRepeatParams{1,1,1,VCOLS/8,VCOLS/8,0});
            }
          } else {
            for (int c0 = 0; c0 < VCOLS; c0 += 64)
              Mul(z[c0], z[c0], s[c0], (uint64_t)64, (uint8_t)rows,
                BinaryRepeatParams{1, 1, 1, VCOLS / 8, VCOLS / 8, 0});
          }
          PipeBarrier<PIPE_V>();
          GeluBounded(z,t,rows*VCOLS);
          auto out = oq.AllocTensor<half>();
          Cast(out, z, RoundMode::CAST_RINT, rows * VCOLS);
          oq.EnQue(out);
          out = oq.DeQue<half>();
          DataCopyPad(yg[(int64_t)row * N + col], out,
            DataCopyExtParams{(uint16_t)rows, (uint32_t)(cols * 2),
              (uint32_t)((VCOLS - (cols + 15) / 16 * 16) / 16),
              (uint32_t)((N - cols) * 2), 0});
          oq.FreeTensor(out);
          sq.FreeTensor(s);
          cq.FreeTensor(c);
        } else {
          CrossCoreSetFlag<2, PIPE_MTE2>(1 + 2 * slot);
        }
        ++consumed;
      }
      if(!shardExperts)taskBase=AdvanceTaskBase(taskBase,tiles,cores);
      start = end;
    }
    }
  }
}
__aicore__ inline int FindExpert(GlobalTensor<int64_t> gg,int row,int M,int E,int& end)
{
  const int guess=row*E/M;
  end=(int)gg.GetValue(guess);
  const int start=guess==0?0:(int)gg.GetValue(guess-1);
  if(start<=row && row<end)return guess;
  int lo=row>=end?guess+1:0;
  int hi=row>=end?E-1:guess-1;
  while(lo<hi){
    const int mid=(lo+hi)/2;
    if(row<(int)gg.GetValue(mid))hi=mid;
    else lo=mid+1;
  }
  end=(int)gg.GetValue(lo);
  return lo;
}
template<bool ENABLED>struct AdaptiveCallback;
template<>struct AdaptiveCallback<true>{using Type=MatmulCallBackFunc<nullptr,PairA,AdaptiveB>;};
template<>struct AdaptiveCallback<false>{using Type=MatmulCallBackFunc<nullptr,nullptr,nullptr>;};
__aicore__ inline bool NeedsSchedulePlan(GlobalTensor<int64_t> gg,int M,int N,int K,int E,int cores)
{
  const int first=(int)gg.GetValue(0);
  const int last=M-(int)gg.GetValue(E-2);
  const int largest=first>last?first:last;
  return (first==0 && last==0) || largest*cores>2*M
    || (first+last)*E*4<M
    || ((first==0 || last==0) && (K*N>=65536 || K%32 || N%32));
}
template<int TM,int TN>
__aicore__ inline int ChooseSchedule(GM_ADDR groups,GlobalTensor<int32_t> record,
  int M,int N,int E,int cores)
{
  TPipe pipe;
  TBuf<TPosition::VECCALC> gb,hb,ob;
  pipe.InitBuffer(gb,128*8);
  pipe.InitBuffer(hb,64*4);
  pipe.InitBuffer(ob,32);
  auto g=gb.Get<int32_t>();
  auto h=hb.Get<int32_t>();
  auto out=ob.Get<int32_t>();
  GlobalTensor<int32_t> gg;
  gg.SetGlobalBuffer((__gm__ int32_t*)groups);
  DataCopyPad(g,gg,DataCopyExtParams{1,(uint32_t)(E*8),0,0,0},
    DataCopyPadExtParams<int32_t>{true,0,0,0});
  SetFlag<HardEvent::MTE2_S>(EVENT_ID0);
  WaitFlag<HardEvent::MTE2_S>(EVENT_ID0);
  const int nc=(N+TN-1)/TN;
  const int stripes=(M+TM-1)/TM*nc;
  for(int c=0;c<cores;++c){
    h.SetValue(c,0);
    h.SetValue(32+c,(stripes+cores-1-c)/cores);
  }
  int start=0,total=0,owner=0;
  for(int e=0;e<E;++e){
    const int end=g.GetValue(2*e);
    const int tasks=(end-start+TM-1)/TM*nc;
    h.SetValue(owner,h.GetValue(owner)+tasks);
    if(++owner==cores)owner=0;
    total+=tasks;
    if(end>start && start>0 && start%TM){
      const int tile=start/TM*nc;
      for(int col=0;col<nc;++col){
        const int c=(tile+col)%cores;
        h.SetValue(32+c,h.GetValue(32+c)+1);
      }
    }
    start=end;
  }
  int maxExpert=0,maxStripe=0;
  for(int c=0;c<cores;++c){
    const int a=h.GetValue(c),b=h.GetValue(32+c);
    if(a>maxExpert)maxExpert=a;
    if(b>maxStripe)maxStripe=b;
  }
  int mode=maxStripe<maxExpert?1:0;
  const int best=mode?maxStripe:maxExpert;
  const int ideal=(total+cores-1)/cores;
  if(best>ideal+(E+15)/16)mode=2;
  for(int i=0;i<8;++i)out.SetValue(i,mode);
  SetFlag<HardEvent::S_MTE3>(EVENT_ID0);
  WaitFlag<HardEvent::S_MTE3>(EVENT_ID0);
  DataCopy(record,out,8);
  CrossCoreSetFlag<2,PIPE_MTE3>(4);
  SetFlag<HardEvent::MTE3_S>(EVENT_ID0);
  WaitFlag<HardEvent::MTE3_S>(EVENT_ID0);
  return mode;
}
struct ScheduledTile {int expert,row,col,rows,cols;};
template<int TM,int TN>
class TaskSchedule {
  GlobalTensor<int64_t> gg_;
  int M_,N_,E_,cores_,core_,mode_,nc_;
  int e_,start_,end_,tiles_,next_,base_;
  int stripe_,stripeCount_,row_,limit_;
  __aicore__ inline void LoadExpert()
  {
    if(mode_==0)start_=e_==0?0:(int)gg_.GetValue(e_-1);
    end_=(int)gg_.GetValue(e_);
    tiles_=(end_-start_+TM-1)/TM*nc_;
    next_=mode_==0?0:core_-base_;
    if(next_<0)next_+=cores_;
  }
  __aicore__ inline void LoadStripe()
  {
    int mr,nr;TileCoordinates(stripe_,nc_,mr,nr);
    row_=mr*TM;
    limit_=row_+TM<M_?row_+TM:M_;
  }
public:
  __aicore__ inline TaskSchedule(GlobalTensor<int64_t> gg,int M,int N,int E,
    int cores,int core,int mode):gg_(gg),M_(M),N_(N),E_(E),cores_(cores),
    core_(core),mode_(mode),nc_((N+TN-1)/TN),e_(mode==0?core:0),
    start_(0),end_(0),tiles_(0),next_(0),base_(0),stripe_(core),
    stripeCount_((M+TM-1)/TM*nc_),row_(0),limit_(0)
  {
    if(mode_==1)LoadStripe();
    else if(e_<E_)LoadExpert();
  }
  __aicore__ inline bool Next(ScheduledTile& t)
  {
    if(mode_==1){
      if(row_>=limit_){stripe_+=cores_;LoadStripe();}
      if(stripe_>=stripeCount_)return false;
      int end;
      t.expert=FindExpert(gg_,row_,M_,E_,end);
      int mr,nr;TileCoordinates(stripe_,nc_,mr,nr);
      t.row=row_;t.col=nr*TN;
      t.rows=(end<limit_?end:limit_)-row_;
      t.cols=N_-t.col<TN?N_-t.col:TN;
      row_+=t.rows;
      return true;
    }
    while(e_<E_){
      if(next_<tiles_){
        int mr,nr;TileCoordinates(next_,nc_,mr,nr);
        t.expert=e_;t.row=start_+mr*TM;t.col=nr*TN;
        t.rows=end_-t.row<TM?end_-t.row:TM;
        t.cols=N_-t.col<TN?N_-t.col:TN;
        next_+=mode_==0?1:cores_;
        return true;
      }
      if(mode_!=0)base_=AdvanceTaskBase(base_,tiles_,cores_);
      start_=end_;e_+=mode_==0?cores_:1;
      if(e_<E_)LoadExpert();
    }
    return false;
  }
};
template<int TM, int TN, bool PADDED, bool TRANSPORT, bool USE_NORMAL = false, bool USE_DIRECT = false>
__global__ __mix__(1, 2) void __attribute__((section(".text.Core.gmg.00.ComputeAdaptive"))) ComputeAdaptive(
  GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groups,
  GM_ADDR y, GM_ADDR workspace, int M, int N, int K, int E, TCubeTiling tiling)
{
  InitSocState();
  GlobalTensor<int8_t> ag, bg;
  GlobalTensor<int64_t> gg;
  GlobalTensor<int32_t> cg;
  GlobalTensor<float> sg;
  GlobalTensor<half> yg;
  ag.SetGlobalBuffer((__gm__ int8_t*)x);
  bg.SetGlobalBuffer((__gm__ int8_t*)weight);
  gg.SetGlobalBuffer((__gm__ int64_t*)groups);
  cg.SetGlobalBuffer((__gm__ int32_t*)workspace);
  sg.SetGlobalBuffer((__gm__ float*)scale);
  yg.SetGlobalBuffer((__gm__ half*)y);
  const int ka = K;
  const int nb = PADDED ? (N + 31) / 32 * 32 : N;
  if constexpr (PADDED) {
    auto base = workspace + (int64_t)GetBlockNum() * 2 * (TM * TN + 128) * sizeof(int32_t);
    GlobalTensor<int8_t> ap, bp;
    ap.SetGlobalBuffer((__gm__ int8_t*)base);
    bp.SetGlobalBuffer((__gm__ int8_t*)(base + (ka != K ? (int64_t)M * ka : 0)));
    if ASCEND_IS_AIV {
      if (ka != K) PadRows(ap, ag, M, K, ka);
      if (nb != N) PadRows(bp, bg, (int64_t)E * K, N, nb);
    }
    SyncAll<false>();
    if (ka != K) ag = ap;
    if (nb != N) bg = bp;
  }
  const int nc = (N + TN - 1) / TN;
  const int cores = GetBlockNum();
  GlobalTensor<int32_t> rg;
  rg.SetGlobalBuffer((__gm__ int32_t*)(workspace
    +(int64_t)cores*2*(TM*TN+128)*sizeof(int32_t)));
  const bool plan=NeedsSchedulePlan(gg,M,N,K,E,cores);
  if ASCEND_IS_AIC {
    TPipe pipe;
    typename PlaneCubeSelect<TM,TN,USE_NORMAL,USE_DIRECT,typename AdaptiveCallback<TRANSPORT>::Type>::Type mm;
    mm.SetSubBlockIdx(0);
    mm.Init(&tiling, &pipe);
    mm.SetOrgShape(M, TRANSPORT?(N+31)/32*32:nb, ka, K, TN);
    uint64_t meta=0;
    if constexpr (TRANSPORT || USE_DIRECT)
      meta=(uint64_t)ka|((uint64_t)nb<<14)|((uint64_t)K<<27)
        |((uint64_t)(tiling.baseM/16)<<41)|((uint64_t)(tiling.baseN/32)<<45)
        |((uint64_t)(tiling.baseK/32)<<50)|((uint64_t)PADDED<<56);
    int mode=0;
    if(plan){
      CrossCoreWaitFlag<2>(4);
      auto record=rg[GetBlockIdx()*16];
      DataCacheCleanAndInvalid<int32_t,CacheLine::SINGLE_CACHE_LINE,DcciDst::CACHELINE_OUT>(record);
      mode=record.GetValue(0);
    }
    TaskSchedule<TM,TN> schedule(gg,M,N,E,cores,GetBlockIdx(),mode);
    ScheduledTile task;
    int produced=0;
    while(schedule.Next(task)){
      const int slot=produced&1;
      if(produced>=2)CrossCoreWaitFlag<2>(1+2*slot);
      if constexpr(TRANSPORT || USE_DIRECT)
        mm.SetSelfDefineData(meta|((uint64_t)(task.expert==E-1 && nb==N)<<55)
          |((uint64_t)(task.col/128)<<57)|((uint64_t)(task.row+task.rows==M)<<62));
      mm.SetSingleShape(task.rows,TRANSPORT?(task.cols+31)/32*32:task.cols,K);
      mm.SetTensorA(ag[(int64_t)task.row*ka],false);
      mm.SetTensorB(bg[(int64_t)task.expert*K*nb+task.col],false);
      mm.IterateAll(cg[((int64_t)GetBlockIdx()*2+slot)*(TM*TN+128)],false);
      CrossCoreSetFlag<2,PIPE_FIX>(2*slot);
      ++produced;
    }
    if (produced > 1) CrossCoreWaitFlag<2>(1 + 2 * ((produced - 2) & 1));
    if (produced > 0) CrossCoreWaitFlag<2>(1 + 2 * ((produced - 1) & 1));
    mm.End();
  }
  if ASCEND_IS_AIV {
    const int core = GetBlockIdx() / 2;
    const int sub = GetBlockIdx() % 2;
    const int mode=plan?ChooseSchedule<TM,TN>(groups,
      rg[core*16+sub*8],M,N,E,cores):0;
    constexpr bool ROW_SPLIT = USE_DIRECT && !PADDED && !TRANSPORT && TM>=64;
    constexpr int VCOLS = ROW_SPLIT?TN:TN/2;
    constexpr int VCOUNT = (ROW_SPLIT?TM/2:TM)*VCOLS;
    TPipe pipe;
    TQue<TPosition::VECIN, 1> cq, sq;
    TQue<TPosition::VECOUT, 1> oq;
    TBuf<TPosition::VECCALC> tb;
    pipe.InitBuffer(cq, 1, VCOUNT * sizeof(int32_t));
    pipe.InitBuffer(sq, 1, VCOLS * sizeof(float));
    pipe.InitBuffer(oq, 1, VCOUNT * sizeof(half));
    pipe.InitBuffer(tb, VCOUNT * sizeof(float));
    auto t = tb.Get<float>();
    TaskSchedule<TM,TN> schedule(gg,M,N,E,cores,core,mode);
    ScheduledTile task;
    int consumed=0;
    while(schedule.Next(task)){
      const int e=task.expert;
      const int rowShift=ROW_SPLIT && sub?(task.rows+1)/2:0;
      const int row=task.row+rowShift;
      const int col=task.col+(ROW_SPLIT?0:sub*VCOLS);
      const int rows=ROW_SPLIT?(sub?task.rows-rowShift:(task.rows+1)/2):task.rows;
      const int cols=N-col<VCOLS?N-col:VCOLS;
        const int slot = consumed & 1;
        CrossCoreWaitFlag<2>(2 * slot);
        if (rows > 0 && cols > 0) {
          const int pitch=ROW_SPLIT?(cols+63)/64*64:VCOLS;
          auto c = cq.AllocTensor<int32_t>();
          auto s = sq.AllocTensor<float>();
          DataCopyPad(c, cg[((int64_t)core * 2 + slot) * (TM * TN + 128) + (ROW_SPLIT?rowShift*TN:sub*VCOLS)],
            DataCopyExtParams{(uint16_t)rows, (uint32_t)(cols * 4),
              (uint32_t)((TN - cols) * 4), (uint32_t)((pitch - (cols + 7) / 8 * 8) / 8), 0},
            DataCopyPadExtParams<int32_t>{true, 0, 0, 0});
          DataCopyPad(s, sg[(int64_t)e * N + col],
            DataCopyExtParams{1, (uint32_t)(cols * 4), 0, 0, 0},
            DataCopyPadExtParams<float>{true, 0, 0, 0.0f});
          cq.EnQue(c);
          sq.EnQue(s);
          c = cq.DeQue<int32_t>();
          s = sq.DeQue<float>();
          CrossCoreSetFlag<2, PIPE_MTE2>(1 + 2 * slot);
          auto z = c.ReinterpretCast<float>();
          Cast(z, c, RoundMode::CAST_RINT, rows * pitch);
          PipeBarrier<PIPE_V>();
          for (int c0 = 0; c0 < pitch; c0 += 64)
            Mul(z[c0], z[c0], s[c0], (uint64_t)64, (uint8_t)rows,
              BinaryRepeatParams{1, 1, 1, (uint8_t)(pitch / 8), (uint8_t)(pitch / 8), 0});
          PipeBarrier<PIPE_V>();
          GeluUnclamped(z,t,rows*pitch);
          auto out = oq.AllocTensor<half>();
          Cast(out, z, RoundMode::CAST_RINT, rows * pitch);
          oq.EnQue(out);
          out = oq.DeQue<half>();
          DataCopyPad(yg[(int64_t)row * N + col], out,
            DataCopyExtParams{(uint16_t)rows, (uint32_t)(cols * 2),
              (uint32_t)((pitch - (cols + 15) / 16 * 16) / 16),
              (uint32_t)((N - cols) * 2), 0});
          oq.FreeTensor(out);
          sq.FreeTensor(s);
          cq.FreeTensor(c);
        } else {
          CrossCoreSetFlag<2, PIPE_MTE2>(1 + 2 * slot);
        }
        ++consumed;
    }
  }
}
template<int TM,int TN,int CK=128>
bool LaunchStaticSdkK(GM_ADDR x,GM_ADDR weight,GM_ADDR scale,GM_ADDR groups,
  GM_ADDR y,GM_ADDR scratch,int M,int N,int K,int E,int cores,
  TCubeTiling tiling,aclrtStream stream)
{
  if(K==CK && tiling.Ka==CK && tiling.Kb==CK && tiling.singleCoreK==CK){
    Compute<TM,TN,false,false,false,false,true,CK><<<cores,nullptr,stream>>>(
      x,weight,scale,groups,y,scratch,M,N,K,E,tiling);
    return true;
  }
  if constexpr(CK<8192)
    return LaunchStaticSdkK<TM,TN,CK*2>(x,weight,scale,groups,y,scratch,
      M,N,K,E,cores,tiling,stream);
  return false;
}
template<int TM, int TN, bool TRANSPORT, int ROUTE = 0>
void LaunchSelected(GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR group_list,
  GM_ADDR y, int M, int N, int K, int E, int cores, aclrtStream stream)
{
  const int maxTiles = ((M + TM - 1) / TM + E - 1) * ((N + TN - 1) / TN);
  if (cores > maxTiles) cores = maxTiles;
  const int denseTiles = ((M + TM - 1) / TM) * ((N + TN - 1) / TN);
  if (K >= 1024 && N % 128 == 0 && cores > 16 && denseTiles > 16 && denseTiles <= 32 &&
    (denseTiles + 15) / 16 == (denseTiles + cores - 1) / cores)
    cores = 16;
  if constexpr(TM==64 && TN==512){
    const int nc=(N+TN-1)/TN,tail=N%TN;
    if(cores>2 && cores%2==0 && nc==2 && tail>0 && tail*4<=3*TN
     && denseTiles>=2*cores)--cores;
  }
  const int ka=K,nb=N;
  matmul_tiling::MultiCoreMatmulTiling mt;
  mt.SetDim(1);
  mt.SetAType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
    matmul_tiling::DataType::DT_INT8, false);
  mt.SetBType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
    matmul_tiling::DataType::DT_INT8, false);
  mt.SetCType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
    matmul_tiling::DataType::DT_INT32);
  mt.SetShape(TM, TN, K);
  mt.SetOrgShape(M, nb, ka, K);
  mt.SetFixSplit(TM > 128 ? 128 : TM, TN, 128);
  mt.SetBufferSpace(512 * 1024, 128 * 1024, 0);
  TCubeTiling tiling;
  if (mt.GetTiling(tiling) != 0) return;
  if(K>=4096 && N>128 && (K%32!=0 || N%32!=0)) {
    tiling.stepKa=4;tiling.stepKb=4;
    tiling.depthA1=8;tiling.depthB1=8;
  } else if(K>=1024 && K%32==0 && N%128==0 && tiling.stepKa>4) {
    const int bytesA=8*tiling.baseM*tiling.baseK;
    const int bytesB=tiling.depthB1*tiling.baseN*tiling.baseK;
    if(bytesA+bytesB<=512*1024) {
      tiling.stepKa=4;tiling.depthA1=8;
    }
  }
  void* scratch = nullptr;
  const int64_t extra = (ka != K ? (int64_t)M * ka : 0)
    + (nb != N ? (int64_t)E * K * nb : 0);
  if (aclrtMalloc(&scratch, cores * 2 * (TM * TN + 128) * sizeof(int32_t) + extra + cores*64,
      ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) return;
  if constexpr (ROUTE == 1) {
    ComputeBulkDirect<TM,TN,false,TRANSPORT,false,true><<<cores,nullptr,stream>>>(
      x,weight,scale,group_list,y,(GM_ADDR)scratch,M,N,K,E,tiling);
  } else if constexpr (ROUTE == 2) {
    ComputeAdaptive<TM,TN,false,TRANSPORT,false,true><<<cores,nullptr,stream>>>(
      x,weight,scale,group_list,y,(GM_ADDR)scratch,M,N,K,E,tiling);
  } else {
    if constexpr (!TRANSPORT && TN<=256) {
      const bool fixed=tiling.singleCoreM==TM && tiling.singleCoreN==TN
        && tiling.baseM==TM && tiling.baseN==TN && tiling.baseK==128
        && tiling.stepM==1 && tiling.stepN==1 && tiling.isBias==0
        && tiling.dbL0A==2 && tiling.dbL0B==(2*TN*128<=65536?2:1)
        && tiling.stepKa==4 && tiling.stepKb==(TM>=128?2:4)
        && tiling.depthA1==8 && tiling.depthB1==2*(TM>=128?2:4)
        && tiling.dbL0C==1 && tiling.shareMode==0
        && tiling.iterateOrder==static_cast<int>(IterateOrder::ORDER_N);
      if(fixed){
        bool launched=false;
        if constexpr(TM*TN*sizeof(int32_t)==128*1024)
          launched=LaunchStaticSdkK<TM,TN>(x,weight,scale,group_list,y,(GM_ADDR)scratch,
            M,N,K,E,cores,tiling,stream);
        if(!launched)
          Compute<TM,TN,false,false,false,false,true><<<cores,nullptr,stream>>>(
            x,weight,scale,group_list,y,(GM_ADDR)scratch,M,N,K,E,tiling);
      } else
        Compute<TM,TN,false,false,false,false><<<cores,nullptr,stream>>>(
          x,weight,scale,group_list,y,(GM_ADDR)scratch,M,N,K,E,tiling);
    } else {
      Compute<TM,TN,false,TRANSPORT,false,false><<<cores,nullptr,stream>>>(
        x,weight,scale,group_list,y,(GM_ADDR)scratch,M,N,K,E,tiling);
    }
  }
  aclrtSynchronizeStream(stream);
  aclrtFree(scratch);
}
__aicore__ inline void GeluResident(LocalTensor<float> z,LocalTensor<float> t,int count)
{
  const BinaryRepeatParams binary{1,1,1,8,8,8};
  const UnaryRepeatParams unary{1,1,8,8};
  for(int offset=0;offset<count;){
    const int remaining=count-offset;
    const int full=remaining/64;
    const uint8_t repeats=(uint8_t)(full>255?255:(full>0?full:1));
    const uint64_t mask=full>0?64:(uint64_t)remaining;
    auto a=z[offset];auto b=t[offset];
    Mul(b,a,a,mask,repeats,binary);PipeBarrier<PIPE_V>();
    Muls(b,b,-0.07135481627260025f,mask,repeats,unary);PipeBarrier<PIPE_V>();
    Adds(b,b,-1.5957691216057308f,mask,repeats,unary);PipeBarrier<PIPE_V>();
    Mul(b,b,a,mask,repeats,binary);PipeBarrier<PIPE_V>();
    Exp(b,b,mask,repeats,unary);PipeBarrier<PIPE_V>();
    Adds(b,b,1.0f,mask,repeats,unary);PipeBarrier<PIPE_V>();
    Div(a,a,b,mask,repeats,binary);PipeBarrier<PIPE_V>();
    offset+=full>0?(int)repeats*64:(int)mask;
  }
}
template<int TM,int TN,int VCOLS>
class ChunkedResidentOutputPipeline {
  static constexpr int COUNT=TM*VCOLS;
  static_assert(14*COUNT+8*VCOLS<=196352);
  TPipe pipe_;
  TQue<TPosition::VECIN,2> cq_,sq_;
  TQue<TPosition::VECOUT,1> oq_;
  TBuf<TPosition::VECCALC> tb_;
  GlobalTensor<int32_t> cg_;
  GlobalTensor<float> sg_;
  GlobalTensor<half> yg_;
  LocalTensor<int32_t> c_;
  LocalTensor<float> s_,t_;
  int N_=0;
  bool pending_=false;
public:
  struct Task { int e,row,col,rows,cols,pitch,slot; int64_t offset; bool first,last; };
private:
  Task saved_;
  __aicore__ inline void Start() {
    c_=cq_.DeQue<int32_t>();s_=sq_.DeQue<float>();
    auto z=c_.template ReinterpretCast<float>();
    const int rows=saved_.rows,pitch=saved_.pitch;
    Cast(z,c_,RoundMode::CAST_RINT,rows*pitch);
    PipeBarrier<PIPE_V>();
    for(int c0=0;c0<pitch;c0+=64)
      Mul(z[c0],z[c0],s_[c0],(uint64_t)64,(uint8_t)rows,
        BinaryRepeatParams{1,1,1,(uint8_t)(pitch/8),(uint8_t)(pitch/8),0});
    PipeBarrier<PIPE_V>();
    GeluResident(z,t_,rows*pitch);
    auto out=oq_.AllocTensor<half>();
    Cast(out,z,RoundMode::CAST_RINT,rows*pitch);
    oq_.EnQue(out);
  }
  __aicore__ inline void Finish() {
    auto out=oq_.DeQue<half>();
    const auto p=saved_;
    DataCopyPad(yg_[(int64_t)p.row*N_+p.col],out,
      DataCopyExtParams{(uint16_t)p.rows,(uint32_t)(p.cols*2),
        (uint32_t)((p.pitch-(p.cols+15)/16*16)/16),(uint32_t)((N_-p.cols)*2),0});
    oq_.FreeTensor(out);sq_.FreeTensor(s_);cq_.FreeTensor(c_);
  }
  __aicore__ inline bool Read(const Task& p) {
    if(p.first)CrossCoreWaitFlag<2>(2*p.slot);
    if(p.rows>0 && p.cols>0) {
      auto c=cq_.AllocTensor<int32_t>();auto s=sq_.AllocTensor<float>();
      DataCopyPad(c,cg_[p.offset],
        DataCopyExtParams{(uint16_t)p.rows,(uint32_t)(p.cols*4),
          (uint32_t)((TN-p.cols)*4),(uint32_t)((p.pitch-(p.cols+7)/8*8)/8),0},
        DataCopyPadExtParams<int32_t>{true,0,0,0});
      DataCopyPad(s,sg_[(int64_t)p.e*N_+p.col],
        DataCopyExtParams{1,(uint32_t)(p.cols*4),0,0,0},
        DataCopyPadExtParams<float>{true,0,0,0.0f});
      cq_.EnQue(c);sq_.EnQue(s);
      if(p.last)CrossCoreSetFlag<2,PIPE_MTE2>(1+2*p.slot);
      return true;
    }
    if(p.last)CrossCoreSetFlag<2,PIPE_MTE2>(1+2*p.slot);
    return false;
  }
public:
  __aicore__ inline void Init(GlobalTensor<int32_t> cg,GlobalTensor<float> sg,
    GlobalTensor<half> yg,int N) {
    cg_=cg;sg_=sg;yg_=yg;N_=N;
    pipe_.InitBuffer(cq_,2,COUNT*4);pipe_.InitBuffer(sq_,2,VCOLS*4);
    pipe_.InitBuffer(oq_,1,COUNT*2);pipe_.InitBuffer(tb_,COUNT*4);
    t_=tb_.Get<float>();
  }
  __aicore__ inline void Push(const Task& next) {
    if(pending_)Start();
    const bool valid=Read(next);
    if(pending_)Finish();
    saved_=next;pending_=valid;
  }
  __aicore__ inline void End() {
    if(pending_){Start();Finish();}
    PipeBarrier<PIPE_ALL>();
  }
};
template<int TN>
class SDKResident {
  static constexpr int BM=128;
  using AT=matmul::MatmulType<TPosition::TSCM,CubeFormat::NZ,int8_t,false>;
  using BT=matmul::MatmulType<TPosition::TSCM,CubeFormat::NZ,int8_t,false>;
  matmul::MatmulImpl<AT,BT,CType,BiasType,NORMAL_CONFIG> mm;
  TBuf<TPosition::A1> ab;TBuf<TPosition::B1> bb;
  TPipe* pipe_;
  GlobalTensor<int8_t> a,b;
  int rows=0,cols=0,depth=0,nextRow=0,currentRow=0,currentRows=0;
  uint64_t meta=0;
  bool previous=false;
  TEventID released,ready;
public:
  __aicore__ inline void Init(TCubeTiling* t,TPipe* pipe) {
    pipe_=pipe;
    const int kr=(t->Ka+31)/32*32;
    pipe->InitBuffer(ab,BM*kr);pipe->InitBuffer(bb,TN*kr);
    released=pipe->AllocEventID<HardEvent::MTE1_MTE2>();
    ready=pipe->AllocEventID<HardEvent::MTE2_MTE1>();
    mm.SetSubBlockIdx(0);mm.Init(t,pipe);
    mm.SetOrgShape(BM,TN,kr,kr,TN);
  }
  __aicore__ inline void SetSingleShape(int m,int n,int k){rows=m;cols=n;depth=k;nextRow=0;}
  __aicore__ inline void SetSelfDefineData(uint64_t value){meta=value;}
  __aicore__ inline void SetTensorA(GlobalTensor<int8_t> value,bool){a=value;}
  __aicore__ inline void SetTensorB(GlobalTensor<int8_t> value,bool){b=value;}
  __aicore__ inline bool Iterate(){
    if(nextRow>=rows)return false;
    currentRow=nextRow;currentRows=rows-nextRow<BM?rows-nextRow:BM;nextRow+=currentRows;
    if(previous){
      SetFlag<HardEvent::MTE1_MTE2>(static_cast<event_t>(released));
      WaitFlag<HardEvent::MTE1_MTE2>(static_cast<event_t>(released));
    }
    const int kr=(depth+31)/32*32,strideA=meta&0x3fff,strideB=(meta>>14)&0x1fff;
    const bool odd=(depth&1)!=0;
    auto al=ab.Get<int8_t>(),bl=bb.Get<int8_t>();
    PairCopy(al,a.GetPhyAddr()+(int64_t)currentRow*strideA,currentRows,depth,strideA,(currentRows+15)/16*16,
      odd,odd && ((meta>>62)&1) && currentRow+currentRows==rows,false);
    if(currentRow==0){
      const int outer=(int)((meta>>57)&31)*128;
      const int valid=strideB-outer<cols?strideB-outer:cols;
      PairCopy(bl,b.GetPhyAddr(),depth,valid,strideB,kr,true,((meta>>55)&1)!=0,false);
      if(kr!=depth)InitConstValue(bl.ReinterpretCast<int32_t>()[depth*8],
        InitConstValueParams<int32_t>{(uint16_t)((valid+31)/32),
          (uint16_t)(kr-depth),(uint16_t)depth,0});
    }
    SetFlag<HardEvent::MTE2_MTE1>(static_cast<event_t>(ready));
    WaitFlag<HardEvent::MTE2_MTE1>(static_cast<event_t>(ready));
    mm.SetSingleShape(currentRows,cols,kr);
    mm.SetTensorA(al,false);mm.SetTensorB(bl,false);
    return true;
  }
  __aicore__ inline void GetTensorC(GlobalTensor<int32_t> output){mm.IterateAll(output,false);previous=true;}
  __aicore__ inline void End(){
    mm.End();PipeBarrier<PIPE_ALL>();
    pipe_->ReleaseEventID<HardEvent::MTE1_MTE2>(released);
    pipe_->ReleaseEventID<HardEvent::MTE2_MTE1>(ready);
  }
};
template<int TN>
__global__ __mix__(1,2) void __attribute__((section(".text.Core.gmg.05.ComputeTscmStripes"))) ComputeTscmStripes(
GM_ADDR x,GM_ADDR weight,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,GM_ADDR workspace,
int M,int N,int K,int E,TCubeTiling tiling)
{
constexpr int TM=128,VCOLS=(TN+63)/64*64,VCOUNT=((TM+1)/2)*VCOLS;
InitSocState();
GlobalTensor<int8_t> ag,bg;GlobalTensor<int64_t> gg;
GlobalTensor<int32_t> cg;GlobalTensor<float> sg;GlobalTensor<half> yg;
ag.SetGlobalBuffer((__gm__ int8_t*)x);bg.SetGlobalBuffer((__gm__ int8_t*)weight);
gg.SetGlobalBuffer((__gm__ int64_t*)groups);cg.SetGlobalBuffer((__gm__ int32_t*)workspace);
sg.SetGlobalBuffer((__gm__ float*)scale);yg.SetGlobalBuffer((__gm__ half*)y);
const int cores=GetBlockNum(),nc=(N+TN-1)/TN;
if ASCEND_IS_AIC {
 const int core=GetBlockIdx();
 TPipe pipe;SDKResident<TN> mm;mm.Init(&tiling,&pipe);int produced=0;
 int panels=0,prior=0;
 for(int e=0;e<E;++e){const int end=(int)gg.GetValue(e);panels+=(end-prior+TM-1)/TM;prior=end;}
 const int lower=panels*nc*core/cores,upper=panels*nc*(core+1)/cores;
 int prefix=0,start=0;
 for(int e=0;e<E && prefix<upper;++e){
 const int end=(int)gg.GetValue(e),count=(end-start+TM-1)/TM;
 for(int ni=0;ni<nc && prefix<upper;++ni){
  const int first=lower>prefix?lower-prefix:0;
  const int last=upper-prefix<count?upper-prefix:count;
  prefix+=count;
  if(first>=last)continue;
  const int begin=start+first*TM,finish=start+last*TM<end?start+last*TM:end;
  const int col=ni*TN,cols=N-col<TN?N-col:TN;
  mm.SetSingleShape(finish-begin,(cols+31)/32*32,K);
  mm.SetTensorA(ag[(int64_t)begin*K],false);
  mm.SetTensorB(bg[(int64_t)e*K*N+col],false);
  mm.SetSelfDefineData((uint64_t)K|((uint64_t)N<<14)|((uint64_t)(col/128)<<57)
   |((uint64_t)(e==E-1)<<55)|((uint64_t)(finish==M)<<62));
  for(int row=begin;row<finish;row+=TM){
  const int slot=produced&1;
  if(produced>=2)CrossCoreWaitFlag<2>(1+2*slot);
  mm.Iterate();mm.GetTensorC(cg[((int64_t)core*2+slot)*TM*TN]);
  CrossCoreSetFlag<2,PIPE_FIX>(2*slot);++produced;
  }
 }
 start=end;
 }
 if(produced>1)CrossCoreWaitFlag<2>(1+2*((produced-2)&1));
 if(produced>0)CrossCoreWaitFlag<2>(1+2*((produced-1)&1));
 mm.End();
}
if ASCEND_IS_AIV {
 const int core=GetBlockIdx()/2,sub=GetBlockIdx()%2;
 constexpr int maxRows=((196352-8*VCOLS)/(14*VCOLS)/16)*16;
 constexpr int readerRows=(TM+1)/2;
 constexpr int chunks=(readerRows+maxRows-1)/maxRows;
 constexpr int chunkRows=((readerRows+chunks-1)/chunks+15)/16*16;
 static_assert(chunkRows<=maxRows && chunkRows<=255);
 ChunkedResidentOutputPipeline<chunkRows,TN,VCOLS> ep;ep.Init(cg,sg,yg,N);
 int consumed=0;
 int panels=0,prior=0;
 for(int e=0;e<E;++e){const int end=(int)gg.GetValue(e);panels+=(end-prior+TM-1)/TM;prior=end;}
 const int lower=panels*nc*core/cores,upper=panels*nc*(core+1)/cores;
 int prefix=0,start=0;
 for(int e=0;e<E && prefix<upper;++e){
 const int end=(int)gg.GetValue(e),count=(end-start+TM-1)/TM;
 for(int ni=0;ni<nc && prefix<upper;++ni){
  const int first=lower>prefix?lower-prefix:0;
  const int last=upper-prefix<count?upper-prefix:count;
  prefix+=count;
  if(first>=last)continue;
  const int begin=start+first*TM,finish=start+last*TM<end?start+last*TM:end;
  const int tileCol=ni*TN;
  for(int row=begin;row<finish;row+=TM){
  const int fullRows=finish-row<TM?finish-row:TM,split=(fullRows+1)/2;
  const int rowOff=sub?split:0,rows=sub?fullRows-split:split,col=tileCol;
  const int cols=N-col<TN?N-col:TN,slot=consumed&1;
  if(rows==0) {
   ep.Push({e,row+rowOff,col,0,cols,(cols+63)/64*64,slot,
     ((int64_t)core*2+slot)*TM*TN+(int64_t)rowOff*TN,true,true});
  }
  for(int r0=0;r0<rows;r0+=chunkRows) {
   const int count=rows-r0<chunkRows?rows-r0:chunkRows;
   ep.Push({e,row+rowOff+r0,col,count,cols,(cols+63)/64*64,slot,
     ((int64_t)core*2+slot)*TM*TN+(int64_t)(rowOff+r0)*TN,
     r0==0,r0+count==rows});
  }
  ++consumed;
  }
 }
 start=end;
 }
 ep.End();
}
}
template<int TN>
void LaunchTscmColumns(GM_ADDR x,GM_ADDR weight,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,
int M,int N,int K,int E,int cores,aclrtStream stream){
const int tasks=((M+127)/128+E-1)*((N+TN-1)/TN);if(cores>tasks)cores=tasks;
matmul_tiling::MultiCoreMatmulTiling mt;mt.SetDim(1);
mt.SetAType(matmul_tiling::TPosition::TSCM,matmul_tiling::CubeFormat::NZ,matmul_tiling::DataType::DT_INT8,false);
mt.SetBType(matmul_tiling::TPosition::TSCM,matmul_tiling::CubeFormat::NZ,matmul_tiling::DataType::DT_INT8,false);
mt.SetCType(matmul_tiling::TPosition::GM,matmul_tiling::CubeFormat::ND,matmul_tiling::DataType::DT_INT32);
const int packedK=(K+31)/32*32;
mt.SetShape(128,TN,packedK);mt.SetOrgShape(128,TN,packedK,packedK);mt.SetFixSplit(128,TN,128);
mt.SetBufferSpace(512*1024-256,128*1024,0);TCubeTiling tiling{};
if(mt.GetTiling(tiling)!=0)return;
void* scratch=nullptr;
if(aclrtMalloc(&scratch,(int64_t)cores*2*128*TN*4,ACL_MEM_MALLOC_HUGE_FIRST)!=ACL_SUCCESS)return;
ComputeTscmStripes<TN><<<cores,nullptr,stream>>>(x,weight,scale,groups,y,(GM_ADDR)scratch,M,N,K,E,tiling);
aclrtSynchronizeStream(stream);aclrtFree(scratch);
}
template<int TN>
class WideResidentColumns {
  static constexpr int BM=80,BK=(32768/80/32)*32;
  static constexpr int FK=((512*1024-256)/(BM+TN)/32)*32;
  static constexpr int FB=((512*1024-256-BM*FK)/(2*TN)/32)*32;
  static_assert(BM*FK+2*TN*FB<=512*1024-256 && FB>=BK);
  static_assert(2*BM*BK<=65536);
  static_assert(BM*TN*4<=128*1024);
  TBuf<TPosition::A1> ab;
  TBuf<TPosition::B1> bb;
  TBuf<TPosition::A2> a0;
  TBuf<TPosition::B2> b0;
  TBuf<TPosition::CO1> cb;
  TPipe* pipe_;
  GlobalTensor<int32_t> output_;
  struct Task {
    GlobalTensor<int8_t> a,b;
    int rows,cols,depth,strideB,ticket,firstBank;
    bool lastA,lastB;
  } saved_;
  int core_=0,tasks_=0,produced_=0,lserial_=0;
  bool pending_=false;
  const __gm__ int8_t* cachedA_=nullptr;
  int cachedARows_=0,cachedADepth_=0;
  TEventID afree,aready,bfree[2],bready[2],lfree[2],lready[2];
  __aicore__ inline void PrepareA(const Task& p,int row) {
    const int rows=p.rows-row<BM?p.rows-row:BM,mr=(rows+15)/16*16;
    WaitFlag<HardEvent::MTE1_MTE2>(static_cast<event_t>(afree));
    const bool odd=(p.depth&1)!=0;
    auto address=p.a.GetPhyAddr()+(int64_t)row*p.depth;
    if(address!=cachedA_ || rows!=cachedARows_ || p.depth!=cachedADepth_){
      PairCopy(ab.Get<int8_t>(),address,rows,p.depth,p.depth,mr,
        odd,odd && p.lastA && row+rows==p.rows,false);
      cachedA_=address;cachedARows_=rows;cachedADepth_=p.depth;
    }
    SetFlag<HardEvent::MTE2_MTE1>(static_cast<event_t>(aready));
  }
  __aicore__ inline void PrepareB(const Task& p,int start) {
    const int slot=(p.firstBank+start/FB)&1;
    const int depth=p.depth-start<FB?p.depth-start:FB,kr=(depth+31)/32*32;
    WaitFlag<HardEvent::MTE1_MTE2>(static_cast<event_t>(bfree[slot]));
    auto dst=bb.Get<int8_t>()[slot*TN*FB];
    PairCopy(dst,p.b.GetPhyAddr()+(int64_t)start*p.strideB,depth,p.cols,p.strideB,kr,
      true,p.lastB && start+depth==p.depth,false);
    if(kr!=depth)InitConstValue(dst.template ReinterpretCast<int32_t>()[depth*8],
      InitConstValueParams<int32_t>{(uint16_t)((p.cols+31)/32),
        (uint16_t)(kr-depth),(uint16_t)depth,0});
    SetFlag<HardEvent::MTE2_MTE1>(static_cast<event_t>(bready[slot]));
  }
  __aicore__ inline void Compute(const Task& p,const Task* next) {
    const int kr=(p.depth+31)/32*32,nr=(p.cols+31)/32*32;
    const int bcap=(32768/nr/32)*32,stepK=bcap<BK?bcap:BK;
    auto al=ab.Get<int8_t>(),ac=a0.Get<int8_t>(),bc=b0.Get<int8_t>();
    auto cc=cb.Get<int32_t>();
    for(int row=0;row<p.rows;row+=BM) {
      const int rows=p.rows-row<BM?p.rows-row:BM,mr=(rows+15)/16*16;
      if(row)PrepareB(p,0);
      WaitFlag<HardEvent::MTE2_MTE1>(static_cast<event_t>(aready));
      const uint8_t pad[4]={0,0,0,0};
      SetFmatrix(1,mr,pad,FmatrixMode::FMATRIX_LEFT);
      for(int start=0;start<kr;start+=FB) {
        const int bs=(p.firstBank+start/FB)&1,bkr=kr-start<FB?kr-start:FB;
        if(start+FB<kr)PrepareB(p,start+FB);
        else if(row+rows==p.rows && next)PrepareB(*next,0);
        auto bl=bb.Get<int8_t>()[bs*TN*FB];
        WaitFlag<HardEvent::MTE2_MTE1>(static_cast<event_t>(bready[bs]));
        for(int ks=0;ks<bkr;ks+=stepK) {
          const int kb=bkr-ks<stepK?bkr-ks:stepK,ls=(lserial_++)&1;
          WaitFlag<HardEvent::M_MTE1>(static_cast<event_t>(lfree[ls]));
          auto aa=ac[ls*BM*BK],ba=bc[ls*32768];
          LoadData3DParamsV2Pro la;
          la.channelSize=kb;la.extConfig=((uint64_t)mr<<16)|kb;
          LoadData(aa,al[(start+ks)*mr],la);
          if(kb>=nr) {
            LoadData2dTransposeParams lb{0,(uint8_t)(kb/32),1,(uint16_t)(nr/16-1),0};
            for(int ni=0;ni<nr;ni+=32)
              LoadDataWithTranspose(ba[ni*32],bl[ni*bkr+ks*32],lb);
          } else {
            LoadData2dTransposeParams lb{0,(uint8_t)(nr/32),(uint16_t)(bkr/32),1,0};
            for(int ki=0;ki<kb;ki+=32)
              LoadDataWithTranspose(ba[ki*nr],bl[(ks+ki)*32],lb);
          }
          if(ks+kb==bkr)
            SetFlag<HardEvent::MTE1_MTE2>(static_cast<event_t>(bfree[bs]));
          if(start+ks+kb==kr) {
            SetFlag<HardEvent::MTE1_MTE2>(static_cast<event_t>(afree));
            if(row+rows<p.rows)PrepareA(p,row+rows);
            else if(next)PrepareA(*next,0);
          }
          SetFlag<HardEvent::MTE1_M>(static_cast<event_t>(lready[ls]));
          WaitFlag<HardEvent::MTE1_M>(static_cast<event_t>(lready[ls]));
          MmadParams mp;
          mp.m=mr;mp.n=nr;mp.k=kb;mp.cmatrixInitVal=start+ks==0;
          mp.unitFlag=start+ks+kb==kr?3:2;
          Mmad(cc,aa,ba,mp);
          if((mr/16)*(nr/16)<10)PipeBarrier<PIPE_M>();
          SetFlag<HardEvent::M_MTE1>(static_cast<event_t>(lfree[ls]));
        }
      }
      const int slot=produced_&1;
      if(produced_>=2)CrossCoreWaitFlag<2>(1+2*slot);
      FixpipeParamsV220 fp;
      fp.nSize=nr;fp.mSize=mr;fp.srcStride=mr;fp.dstStride=TN;fp.unitFlag=3;
      Fixpipe(output_[((int64_t)core_*2+slot)*BM*TN],cc,fp);
      CrossCoreSetFlag<2,PIPE_FIX>(2*slot);++produced_;
    }
  }
public:
  __aicore__ inline void Init(TPipe* pipe,GlobalTensor<int32_t> out,int core) {
    pipe_=pipe;output_=out;core_=core;
    pipe->InitBuffer(ab,BM*FK);pipe->InitBuffer(bb,2*TN*FB);
    pipe->InitBuffer(a0,2*BM*BK);pipe->InitBuffer(b0,65536);
    pipe->InitBuffer(cb,BM*TN*4);SetMMRowMajor();
    afree=pipe->AllocEventID<HardEvent::MTE1_MTE2>();
    aready=pipe->AllocEventID<HardEvent::MTE2_MTE1>();
    SetFlag<HardEvent::MTE1_MTE2>(static_cast<event_t>(afree));
    for(int i=0;i<2;++i) {
      bfree[i]=pipe->AllocEventID<HardEvent::MTE1_MTE2>();
      bready[i]=pipe->AllocEventID<HardEvent::MTE2_MTE1>();
      lfree[i]=pipe->AllocEventID<HardEvent::M_MTE1>();
      lready[i]=pipe->AllocEventID<HardEvent::MTE1_M>();
      SetFlag<HardEvent::MTE1_MTE2>(static_cast<event_t>(bfree[i]));
      SetFlag<HardEvent::M_MTE1>(static_cast<event_t>(lfree[i]));
    }
  }
  __aicore__ inline void Push(GlobalTensor<int8_t> a,GlobalTensor<int8_t> b,
    int rows,int cols,int depth,int strideB,bool lastA,bool lastB) {
    if(rows<=0)return;
    const int first=pending_?(saved_.firstBank+(saved_.depth+FB-1)/FB)&1:0;
    Task next={a,b,rows,cols,depth,strideB,tasks_,first,lastA,lastB};
    if(pending_)Compute(saved_,&next);
    else {PrepareA(next,0);PrepareB(next,0);}
    saved_=next;pending_=true;++tasks_;
  }
  __aicore__ inline void End() {
    if(pending_)Compute(saved_,nullptr);
    if(produced_>1)CrossCoreWaitFlag<2>(1+2*((produced_-2)&1));
    if(produced_>0)CrossCoreWaitFlag<2>(1+2*((produced_-1)&1));
    WaitFlag<HardEvent::MTE1_MTE2>(static_cast<event_t>(afree));
    for(int i=0;i<2;++i) {
      WaitFlag<HardEvent::MTE1_MTE2>(static_cast<event_t>(bfree[i]));
      WaitFlag<HardEvent::M_MTE1>(static_cast<event_t>(lfree[i]));
    }
    PipeBarrier<PIPE_ALL>();SetMMColumnMajor();
    pipe_->ReleaseEventID<HardEvent::MTE1_MTE2>(afree);
    pipe_->ReleaseEventID<HardEvent::MTE2_MTE1>(aready);
    for(int i=0;i<2;++i) {
      pipe_->ReleaseEventID<HardEvent::MTE1_MTE2>(bfree[i]);
      pipe_->ReleaseEventID<HardEvent::MTE2_MTE1>(bready[i]);
      pipe_->ReleaseEventID<HardEvent::M_MTE1>(lfree[i]);
      pipe_->ReleaseEventID<HardEvent::MTE1_M>(lready[i]);
    }
  }
};
template<int TN>
__global__ __mix__(1,2) void __attribute__((section(".text.Core.gmg.07.ComputeWideResident"))) ComputeWideResident(
GM_ADDR x,GM_ADDR weight,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,GM_ADDR workspace,
int M,int N,int K,int E,TCubeTiling tiling)
{
constexpr int TM=80,SCOLS=TN/2,VCOLS=(SCOLS+63)/64*64,VCOUNT=TM*VCOLS;
InitSocState();
GlobalTensor<int8_t> ag,bg;GlobalTensor<int64_t> gg;
GlobalTensor<int32_t> cg;GlobalTensor<float> sg;GlobalTensor<half> yg;
ag.SetGlobalBuffer((__gm__ int8_t*)x);bg.SetGlobalBuffer((__gm__ int8_t*)weight);
gg.SetGlobalBuffer((__gm__ int64_t*)groups);cg.SetGlobalBuffer((__gm__ int32_t*)workspace);
sg.SetGlobalBuffer((__gm__ float*)scale);yg.SetGlobalBuffer((__gm__ half*)y);
const int cores=GetBlockNum(),nc=(N+TN-1)/TN;
const int span=((N+nc-1)/nc+31)/32*32;
if ASCEND_IS_AIC {
 const int core=GetBlockIdx();
 TPipe pipe;WideResidentColumns<TN> mm;mm.Init(&pipe,cg,core);
 int panels=0,prior=0;
 for(int e=0;e<E;++e){const int end=(int)gg.GetValue(e);panels+=(end-prior+TM-1)/TM;prior=end;}
 const int lower=panels*nc*core/cores,upper=panels*nc*(core+1)/cores;
 int prefix=0,start=0;
 for(int e=0;e<E && prefix<upper;++e){
 const int end=(int)gg.GetValue(e),count=(end-start+TM-1)/TM;
 for(int ni=0;ni<nc && prefix<upper;++ni){
  const int first=lower>prefix?lower-prefix:0;
  const int last=upper-prefix<count?upper-prefix:count;
  prefix+=count;
  if(first>=last)continue;
  const int begin=start+first*TM,finish=start+last*TM<end?start+last*TM:end;
  const int col=ni*span,cols=N-col<span?N-col:span;
  mm.Push(ag[(int64_t)begin*K],bg[(int64_t)e*K*N+col],finish-begin,cols,K,N,finish==M,e==E-1);
 }
 start=end;
 }
 mm.End();
}
if ASCEND_IS_AIV {
 const int core=GetBlockIdx()/2,sub=GetBlockIdx()%2;
 TPipe pipe;TQue<TPosition::VECIN,1> cq,sq;TQue<TPosition::VECOUT,1> oq;
 TBuf<TPosition::VECCALC> tb;
 pipe.InitBuffer(cq,1,VCOUNT*4);pipe.InitBuffer(sq,1,VCOLS*4);
 pipe.InitBuffer(oq,1,VCOUNT*2);pipe.InitBuffer(tb,VCOUNT*4);
 auto t=tb.Get<float>();int consumed=0;
 int panels=0,prior=0;
 for(int e=0;e<E;++e){const int end=(int)gg.GetValue(e);panels+=(end-prior+TM-1)/TM;prior=end;}
 const int lower=panels*nc*core/cores,upper=panels*nc*(core+1)/cores;
 int prefix=0,start=0;
 for(int e=0;e<E && prefix<upper;++e){
 const int end=(int)gg.GetValue(e),count=(end-start+TM-1)/TM;
 for(int ni=0;ni<nc && prefix<upper;++ni){
  const int first=lower>prefix?lower-prefix:0;
  const int last=upper-prefix<count?upper-prefix:count;
  prefix+=count;
  if(first>=last)continue;
  const int begin=start+first*TM,finish=start+last*TM<end?start+last*TM:end;
  const int tileCol=ni*span;
  for(int row=begin;row<finish;row+=TM){
  const int rows=finish-row<TM?finish-row:TM,col=tileCol+sub*SCOLS;
  const int tileEnd=tileCol+span<N?tileCol+span:N;
  const int cols=tileEnd-col<SCOLS?tileEnd-col:SCOLS,slot=consumed&1;
  CrossCoreWaitFlag<2>(2*slot);
        if (rows > 0 && cols > 0) {
          const int pitch = (cols + 63) / 64 * 64;
          auto c = cq.AllocTensor<int32_t>();
          auto s = sq.AllocTensor<float>();
          DataCopyPad(c, cg[((int64_t)core * 2 + slot) * TM * TN + sub * SCOLS],
            DataCopyExtParams{(uint16_t)rows, (uint32_t)(cols * 4),
              (uint32_t)((TN - cols) * 4), (uint32_t)((pitch - (cols + 7) / 8 * 8) / 8), 0},
            DataCopyPadExtParams<int32_t>{true, 0, 0, 0});
          DataCopyPad(s, sg[(int64_t)e * N + col],
            DataCopyExtParams{1, (uint32_t)(cols * 4), 0, 0, 0},
            DataCopyPadExtParams<float>{true, 0, 0, 0.0f});
          cq.EnQue(c);
          sq.EnQue(s);
          c = cq.DeQue<int32_t>();
          s = sq.DeQue<float>();
          CrossCoreSetFlag<2, PIPE_MTE2>(1 + 2 * slot);
          auto z = c.ReinterpretCast<float>();
          Cast(z, c, RoundMode::CAST_RINT, rows * pitch);
          PipeBarrier<PIPE_V>();
          if constexpr (TM > 255) {
            for(int r0=0;r0<rows;r0+=255){
              const uint8_t repeats=(uint8_t)(rows-r0<255?rows-r0:255);
              for(int c0=0;c0<pitch;c0+=64)
                Mul(z[r0*pitch+c0],z[r0*pitch+c0],s[c0],(uint64_t)64,repeats,
                  BinaryRepeatParams{1,1,1,(uint8_t)(pitch/8),(uint8_t)(pitch/8),0});
            }
          } else {
            for (int c0 = 0; c0 < pitch; c0 += 64)
              Mul(z[c0], z[c0], s[c0], (uint64_t)64, (uint8_t)rows,
                BinaryRepeatParams{1, 1, 1, (uint8_t)(pitch / 8), (uint8_t)(pitch / 8), 0});
          }
          PipeBarrier<PIPE_V>();
          GeluResident(z,t,rows*pitch);
          auto out = oq.AllocTensor<half>();
          Cast(out, z, RoundMode::CAST_RINT, rows * pitch);
          oq.EnQue(out);
          out = oq.DeQue<half>();
          DataCopyPad(yg[(int64_t)row * N + col], out,
            DataCopyExtParams{(uint16_t)rows, (uint32_t)(cols * 2),
              (uint32_t)((pitch - (cols + 15) / 16 * 16) / 16),
              (uint32_t)((N - cols) * 2), 0});
          oq.FreeTensor(out);
          sq.FreeTensor(s);
          cq.FreeTensor(c);
        } else {
          CrossCoreSetFlag<2, PIPE_MTE2>(1 + 2 * slot);
        }
  ++consumed;
  }
 }
 start=end;
 }
}
}
template<int TN>
void LaunchWideResident(GM_ADDR x,GM_ADDR weight,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,
int M,int N,int K,int E,int cores,aclrtStream stream){
const int tasks=((M+79)/80+E-1)*((N+TN-1)/TN);if(cores>tasks)cores=tasks;
TCubeTiling tiling{};void* scratch=nullptr;
if(aclrtMalloc(&scratch,(int64_t)cores*2*80*TN*4,ACL_MEM_MALLOC_HUGE_FIRST)!=ACL_SUCCESS)return;
ComputeWideResident<TN><<<cores,nullptr,stream>>>(x,weight,scale,groups,y,(GM_ADDR)scratch,M,N,K,E,tiling);
aclrtSynchronizeStream(stream);aclrtFree(scratch);
}
template<int TN>
class WideTripleColumns {
  static constexpr int BM=80,BK=(32768/TN/32)*32;
  int FK=0,FB=0;
  static_assert(2*BM*BK<=65536);
  static_assert(BM*TN*4<=128*1024);
  LocalTensor<int8_t> ab;
  LocalTensor<int8_t> bb;
  LocalTensor<int8_t> a0;
  LocalTensor<int8_t> b0;
  LocalTensor<int32_t> cb;
  GlobalTensor<int32_t> output_;
  struct Task {
    GlobalTensor<int8_t> a,b;
    int rows,cols,depth,strideB,ticket,firstBank;
    bool lastA,lastB;
  } saved_;
  int core_=0,tasks_=0,produced_=0,lserial_=0;
  bool pending_=false;
  const __gm__ int8_t* cachedA_=nullptr;
  int cachedARows_=0,cachedADepth_=0;
  TEventID afree,aready,bfree[3],bready[3],lfree[2],lready[2];
  __aicore__ inline void PrepareA(const Task& p,int row) {
    const int rows=p.rows-row<BM?p.rows-row:BM,mr=(rows+15)/16*16;
    WaitFlag<HardEvent::MTE1_MTE2>(static_cast<event_t>(afree));
    const bool odd=(p.depth&1)!=0;
    auto address=p.a.GetPhyAddr()+(int64_t)row*p.depth;
    if(address!=cachedA_ || rows!=cachedARows_ || p.depth!=cachedADepth_){
      PairCopy(ab,address,rows,p.depth,p.depth,mr,
        odd,odd && p.lastA && row+rows==p.rows,false);
      cachedA_=address;cachedARows_=rows;cachedADepth_=p.depth;
    }
    SetFlag<HardEvent::MTE2_MTE1>(static_cast<event_t>(aready));
  }
  __aicore__ inline void PrepareB(const Task& p,int start) {
    const int slot=(p.firstBank+start/FB)%3;
    const int depth=p.depth-start<FB?p.depth-start:FB,kr=(depth+31)/32*32;
    WaitFlag<HardEvent::MTE1_MTE2>(static_cast<event_t>(bfree[slot]));
    auto dst=bb[slot*TN*FB];
    PairCopy(dst,p.b.GetPhyAddr()+(int64_t)start*p.strideB,depth,p.cols,p.strideB,kr,
      true,p.lastB && start+depth==p.depth,false);
    if(kr!=depth)InitConstValue(dst.template ReinterpretCast<int32_t>()[depth*8],
      InitConstValueParams<int32_t>{(uint16_t)((p.cols+31)/32),
        (uint16_t)(kr-depth),(uint16_t)depth,0});
    SetFlag<HardEvent::MTE2_MTE1>(static_cast<event_t>(bready[slot]));
  }
  __aicore__ inline void Compute(const Task& p,const Task* next) {
    const int kr=(p.depth+31)/32*32,nr=(p.cols+31)/32*32;
    const int bcap=(32768/nr/32)*32,stepK=bcap<BK?bcap:BK;
    auto al=ab,ac=a0,bc=b0;
    auto cc=cb;
    for(int row=0;row<p.rows;row+=BM) {
      const int rows=p.rows-row<BM?p.rows-row:BM,mr=(rows+15)/16*16;
      if(row)PrepareB(p,0);
      if(FB<kr)PrepareB(p,FB);
      WaitFlag<HardEvent::MTE2_MTE1>(static_cast<event_t>(aready));
      const uint8_t pad[4]={0,0,0,0};
      SetFmatrix(1,mr,pad,FmatrixMode::FMATRIX_LEFT);
      for(int start=0;start<kr;start+=FB) {
        const int bs=(p.firstBank+start/FB)%3,bkr=kr-start<FB?kr-start:FB;
        if(start+2*FB<kr)PrepareB(p,start+2*FB);
        else if(row+rows==p.rows && next && (start==0 || start+FB<kr))PrepareB(*next,0);
        auto bl=bb[bs*TN*FB];
        WaitFlag<HardEvent::MTE2_MTE1>(static_cast<event_t>(bready[bs]));
        for(int ks=0;ks<bkr;ks+=stepK) {
          const int kb=bkr-ks<stepK?bkr-ks:stepK,ls=(lserial_++)&1;
          WaitFlag<HardEvent::M_MTE1>(static_cast<event_t>(lfree[ls]));
          auto aa=ac[ls*BM*BK],ba=bc[ls*32768];
          LoadData3DParamsV2Pro la;
          la.channelSize=kb;la.extConfig=((uint64_t)mr<<16)|kb;
          LoadData(aa,al[(start+ks)*mr],la);
          if(kb>=nr) {
            LoadData2dTransposeParams lb{0,(uint8_t)(kb/32),1,(uint16_t)(nr/16-1),0};
            for(int ni=0;ni<nr;ni+=32)
              LoadDataWithTranspose(ba[ni*32],bl[ni*bkr+ks*32],lb);
          } else {
            LoadData2dTransposeParams lb{0,(uint8_t)(nr/32),(uint16_t)(bkr/32),1,0};
            for(int ki=0;ki<kb;ki+=32)
              LoadDataWithTranspose(ba[ki*nr],bl[(ks+ki)*32],lb);
          }
          if(ks+kb==bkr)
            SetFlag<HardEvent::MTE1_MTE2>(static_cast<event_t>(bfree[bs]));
          if(start+ks+kb==kr) {
            SetFlag<HardEvent::MTE1_MTE2>(static_cast<event_t>(afree));
            if(row+rows<p.rows)PrepareA(p,row+rows);
            else if(next)PrepareA(*next,0);
          }
          SetFlag<HardEvent::MTE1_M>(static_cast<event_t>(lready[ls]));
          WaitFlag<HardEvent::MTE1_M>(static_cast<event_t>(lready[ls]));
          MmadParams mp;
          mp.m=mr;mp.n=nr;mp.k=kb;mp.cmatrixInitVal=start+ks==0;
          mp.unitFlag=start+ks+kb==kr?3:2;
          Mmad(cc,aa,ba,mp);
          if((mr/16)*(nr/16)<10)PipeBarrier<PIPE_M>();
          SetFlag<HardEvent::M_MTE1>(static_cast<event_t>(lfree[ls]));
        }
      }
      const int slot=produced_&1;
      if(produced_>=2)CrossCoreWaitFlag<2>(1+2*slot);
      FixpipeParamsV220 fp;
      fp.nSize=nr;fp.mSize=mr;fp.srcStride=mr;fp.dstStride=TN;fp.unitFlag=3;
      Fixpipe(output_[((int64_t)core_*2+slot)*BM*TN],cc,fp);
      CrossCoreSetFlag<2,PIPE_FIX>(2*slot);++produced_;
    }
  }
public:
  __aicore__ inline void Init(GlobalTensor<int32_t> out,int core,int depth) {
    output_=out;core_=core;
    FK=(depth+31)/32*32;FB=((524032-BM*FK)/(3*TN)/BK)*BK;
    ab=LocalTensor<int8_t>(TPosition::A1,0,BM*FK);
    bb=LocalTensor<int8_t>(TPosition::B1,BM*FK,3*TN*FB);
    a0=LocalTensor<int8_t>(TPosition::A2,0,2*BM*BK);
    b0=LocalTensor<int8_t>(TPosition::B2,0,65536);
    cb=LocalTensor<int32_t>(TPosition::CO1,0,BM*TN);
    SetMMRowMajor();
    afree=static_cast<TEventID>(0);aready=static_cast<TEventID>(0);
    SetFlag<HardEvent::MTE1_MTE2>(static_cast<event_t>(afree));
    for(int i=0;i<3;++i) {
      bfree[i]=static_cast<TEventID>(i+1);
      bready[i]=static_cast<TEventID>(i+1);
      SetFlag<HardEvent::MTE1_MTE2>(static_cast<event_t>(bfree[i]));
    }
    for(int i=0;i<2;++i) {
      lfree[i]=static_cast<TEventID>(i+3);
      lready[i]=static_cast<TEventID>(i);
      SetFlag<HardEvent::M_MTE1>(static_cast<event_t>(lfree[i]));
    }
  }
  __aicore__ inline void Push(GlobalTensor<int8_t> a,GlobalTensor<int8_t> b,
    int rows,int cols,int depth,int strideB,bool lastA,bool lastB) {
    if(rows<=0)return;
    const int first=pending_?(saved_.firstBank+(saved_.depth+FB-1)/FB)%3:0;
    Task next={a,b,rows,cols,depth,strideB,tasks_,first,lastA,lastB};
    if(pending_)Compute(saved_,&next);
    else {PrepareA(next,0);PrepareB(next,0);}
    saved_=next;pending_=true;++tasks_;
  }
  __aicore__ inline void End() {
    if(pending_)Compute(saved_,nullptr);
    if(produced_>1)CrossCoreWaitFlag<2>(1+2*((produced_-2)&1));
    if(produced_>0)CrossCoreWaitFlag<2>(1+2*((produced_-1)&1));
    WaitFlag<HardEvent::MTE1_MTE2>(static_cast<event_t>(afree));
    for(int i=0;i<3;++i)
      WaitFlag<HardEvent::MTE1_MTE2>(static_cast<event_t>(bfree[i]));
    for(int i=0;i<2;++i)
      WaitFlag<HardEvent::M_MTE1>(static_cast<event_t>(lfree[i]));
    PipeBarrier<PIPE_ALL>();SetMMColumnMajor();
  }
};
template<int TN>
__global__ __mix__(1,2) void __attribute__((section(".text.Core.gmg.06.ComputeWideTriple"))) ComputeWideTriple(
GM_ADDR x,GM_ADDR weight,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,GM_ADDR workspace,
int M,int N,int K,int E,TCubeTiling tiling)
{
constexpr int TM=80,MAXROWS=(TM+1)/2,VCOLS=(TN+63)/64*64,VCOUNT=MAXROWS*VCOLS;
InitSocState();
GlobalTensor<int8_t> ag,bg;GlobalTensor<int64_t> gg;
GlobalTensor<int32_t> cg;GlobalTensor<float> sg;GlobalTensor<half> yg;
ag.SetGlobalBuffer((__gm__ int8_t*)x);bg.SetGlobalBuffer((__gm__ int8_t*)weight);
gg.SetGlobalBuffer((__gm__ int64_t*)groups);cg.SetGlobalBuffer((__gm__ int32_t*)workspace);
sg.SetGlobalBuffer((__gm__ float*)scale);yg.SetGlobalBuffer((__gm__ half*)y);
const int cores=GetBlockNum(),nc=(N+TN-1)/TN;
const int span=((N+nc-1)/nc+31)/32*32;
if ASCEND_IS_AIC {
 const int core=GetBlockIdx();
 WideTripleColumns<TN> mm;mm.Init(cg,core,K);
 int panels=0,prior=0;
 for(int e=0;e<E;++e){const int end=(int)gg.GetValue(e);panels+=(end-prior+TM-1)/TM;prior=end;}
 const int lower=panels*nc*core/cores,upper=panels*nc*(core+1)/cores;
 int prefix=0,start=0;
 for(int e=0;e<E && prefix<upper;++e){
 const int end=(int)gg.GetValue(e),count=(end-start+TM-1)/TM;
 for(int ni=0;ni<nc && prefix<upper;++ni){
  const int first=lower>prefix?lower-prefix:0;
  const int last=upper-prefix<count?upper-prefix:count;
  prefix+=count;
  if(first>=last)continue;
  const int begin=start+first*TM,finish=start+last*TM<end?start+last*TM:end;
  const int col=ni*span,cols=N-col<span?N-col:span;
  mm.Push(ag[(int64_t)begin*K],bg[(int64_t)e*K*N+col],finish-begin,cols,K,N,finish==M,e==E-1);
 }
 start=end;
 }
 mm.End();
}
if ASCEND_IS_AIV {
 const int core=GetBlockIdx()/2,sub=GetBlockIdx()%2;
 TPipe pipe;TQue<TPosition::VECIN,1> cq,sq;TQue<TPosition::VECOUT,1> oq;
 TBuf<TPosition::VECCALC> tb;
 pipe.InitBuffer(cq,1,VCOUNT*4);pipe.InitBuffer(sq,1,VCOLS*4);
 pipe.InitBuffer(oq,1,VCOUNT*2);pipe.InitBuffer(tb,VCOUNT*4);
 auto t=tb.Get<float>();int consumed=0;
 int panels=0,prior=0;
 for(int e=0;e<E;++e){const int end=(int)gg.GetValue(e);panels+=(end-prior+TM-1)/TM;prior=end;}
 const int lower=panels*nc*core/cores,upper=panels*nc*(core+1)/cores;
 int prefix=0,start=0;
 for(int e=0;e<E && prefix<upper;++e){
 const int end=(int)gg.GetValue(e),count=(end-start+TM-1)/TM;
 for(int ni=0;ni<nc && prefix<upper;++ni){
  const int first=lower>prefix?lower-prefix:0;
  const int last=upper-prefix<count?upper-prefix:count;
  prefix+=count;
  if(first>=last)continue;
  const int begin=start+first*TM,finish=start+last*TM<end?start+last*TM:end;
  const int tileCol=ni*span;
  for(int row=begin;row<finish;row+=TM){
  const int fullRows=finish-row<TM?finish-row:TM,split=(fullRows+1)/2;
  const int rowOff=sub?split:0,rows=sub?fullRows-split:split,col=tileCol;
  const int tileEnd=tileCol+span<N?tileCol+span:N;
  const int cols=tileEnd-col,slot=consumed&1;
  CrossCoreWaitFlag<2>(2*slot);
        if (rows > 0 && cols > 0) {
          const int pitch = (cols + 63) / 64 * 64;
          auto c = cq.AllocTensor<int32_t>();
          auto s = sq.AllocTensor<float>();
          DataCopyPad(c, cg[((int64_t)core * 2 + slot) * TM * TN + (int64_t)rowOff * TN],
            DataCopyExtParams{(uint16_t)rows, (uint32_t)(cols * 4),
              (uint32_t)((TN - cols) * 4), (uint32_t)((pitch - (cols + 7) / 8 * 8) / 8), 0},
            DataCopyPadExtParams<int32_t>{true, 0, 0, 0});
          DataCopyPad(s, sg[(int64_t)e * N + col],
            DataCopyExtParams{1, (uint32_t)(cols * 4), 0, 0, 0},
            DataCopyPadExtParams<float>{true, 0, 0, 0.0f});
          cq.EnQue(c);
          sq.EnQue(s);
          c = cq.DeQue<int32_t>();
          s = sq.DeQue<float>();
          CrossCoreSetFlag<2, PIPE_MTE2>(1 + 2 * slot);
          auto z = c.ReinterpretCast<float>();
          Cast(z, c, RoundMode::CAST_RINT, rows * pitch);
          PipeBarrier<PIPE_V>();
          if constexpr (TM > 255) {
            for(int r0=0;r0<rows;r0+=255){
              const uint8_t repeats=(uint8_t)(rows-r0<255?rows-r0:255);
              for(int c0=0;c0<pitch;c0+=64)
                Mul(z[r0*pitch+c0],z[r0*pitch+c0],s[c0],(uint64_t)64,repeats,
                  BinaryRepeatParams{1,1,1,(uint8_t)(pitch/8),(uint8_t)(pitch/8),0});
            }
          } else {
            for (int c0 = 0; c0 < pitch; c0 += 64)
              Mul(z[c0], z[c0], s[c0], (uint64_t)64, (uint8_t)rows,
                BinaryRepeatParams{1, 1, 1, (uint8_t)(pitch / 8), (uint8_t)(pitch / 8), 0});
          }
          PipeBarrier<PIPE_V>();
          GeluResident(z,t,rows*pitch);
          auto out = oq.AllocTensor<half>();
          Cast(out, z, RoundMode::CAST_RINT, rows * pitch);
          oq.EnQue(out);
          out = oq.DeQue<half>();
          DataCopyPad(yg[(int64_t)(row+rowOff) * N + col], out,
            DataCopyExtParams{(uint16_t)rows, (uint32_t)(cols * 2),
              (uint32_t)((pitch - (cols + 15) / 16 * 16) / 16),
              (uint32_t)((N - cols) * 2), 0});
          oq.FreeTensor(out);
          sq.FreeTensor(s);
          cq.FreeTensor(c);
        } else {
          CrossCoreSetFlag<2, PIPE_MTE2>(1 + 2 * slot);
        }
  ++consumed;
  }
 }
 start=end;
 }
}
}
template<int TN>
void LaunchWideTriple(GM_ADDR x,GM_ADDR weight,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,
int M,int N,int K,int E,int cores,aclrtStream stream){
const int tasks=((M+79)/80+E-1)*((N+TN-1)/TN);if(cores>tasks)cores=tasks;
TCubeTiling tiling{};void* scratch=nullptr;
if(aclrtMalloc(&scratch,(int64_t)cores*2*80*TN*4,ACL_MEM_MALLOC_HUGE_FIRST)!=ACL_SUCCESS)return;
ComputeWideTriple<TN><<<cores,nullptr,stream>>>(x,weight,scale,groups,y,(GM_ADDR)scratch,M,N,K,E,tiling);
aclrtSynchronizeStream(stream);aclrtFree(scratch);
}
template<int TM,int TN,int VCOLS>
class ResidentOutputPipeline {
  static constexpr int COUNT=TM*VCOLS;
  static_assert(14*COUNT+8*VCOLS<=196352);
  TPipe pipe_;
  TQue<TPosition::VECIN,2> cq_,sq_;
  TQue<TPosition::VECOUT,1> oq_;
  TBuf<TPosition::VECCALC> tb_;
  GlobalTensor<int32_t> cg_;
  GlobalTensor<float> sg_;
  GlobalTensor<half> yg_;
  LocalTensor<int32_t> c_;
  LocalTensor<float> s_,t_;
  int N_=0;
  bool pending_=false;
public:
  struct Task { int e,row,col,rows,cols,pitch,slot; int64_t offset; };
private:
  Task saved_;
  __aicore__ inline void Start() {
    c_=cq_.DeQue<int32_t>();s_=sq_.DeQue<float>();
    auto z=c_.template ReinterpretCast<float>();
    const int rows=saved_.rows,pitch=saved_.pitch;
    Cast(z,c_,RoundMode::CAST_RINT,rows*pitch);
    PipeBarrier<PIPE_V>();
    for(int c0=0;c0<pitch;c0+=64)
      Mul(z[c0],z[c0],s_[c0],(uint64_t)64,(uint8_t)rows,
        BinaryRepeatParams{1,1,1,(uint8_t)(pitch/8),(uint8_t)(pitch/8),0});
    PipeBarrier<PIPE_V>();
    GeluResident(z,t_,rows*pitch);
    auto out=oq_.AllocTensor<half>();
    Cast(out,z,RoundMode::CAST_RINT,rows*pitch);
    oq_.EnQue(out);
  }
  __aicore__ inline void Finish() {
    auto out=oq_.DeQue<half>();
    const auto p=saved_;
    DataCopyPad(yg_[(int64_t)p.row*N_+p.col],out,
      DataCopyExtParams{(uint16_t)p.rows,(uint32_t)(p.cols*2),
        (uint32_t)((p.pitch-(p.cols+15)/16*16)/16),(uint32_t)((N_-p.cols)*2),0});
    oq_.FreeTensor(out);sq_.FreeTensor(s_);cq_.FreeTensor(c_);
  }
  __aicore__ inline bool Read(const Task& p) {
    CrossCoreWaitFlag<2>(2*p.slot);
    if(p.rows>0 && p.cols>0) {
      auto c=cq_.AllocTensor<int32_t>();auto s=sq_.AllocTensor<float>();
      DataCopyPad(c,cg_[p.offset],
        DataCopyExtParams{(uint16_t)p.rows,(uint32_t)(p.cols*4),
          (uint32_t)((TN-p.cols)*4),(uint32_t)((p.pitch-(p.cols+7)/8*8)/8),0},
        DataCopyPadExtParams<int32_t>{true,0,0,0});
      DataCopyPad(s,sg_[(int64_t)p.e*N_+p.col],
        DataCopyExtParams{1,(uint32_t)(p.cols*4),0,0,0},
        DataCopyPadExtParams<float>{true,0,0,0.0f});
      cq_.EnQue(c);sq_.EnQue(s);
      CrossCoreSetFlag<2,PIPE_MTE2>(1+2*p.slot);
      return true;
    }
    CrossCoreSetFlag<2,PIPE_MTE2>(1+2*p.slot);
    return false;
  }
public:
  __aicore__ inline void Init(GlobalTensor<int32_t> cg,GlobalTensor<float> sg,
    GlobalTensor<half> yg,int N) {
    cg_=cg;sg_=sg;yg_=yg;N_=N;
    pipe_.InitBuffer(cq_,2,COUNT*4);pipe_.InitBuffer(sq_,2,VCOLS*4);
    pipe_.InitBuffer(oq_,1,COUNT*2);pipe_.InitBuffer(tb_,COUNT*4);
    t_=tb_.Get<float>();
  }
  __aicore__ inline void Push(const Task& next) {
    if(pending_)Start();
    const bool valid=Read(next);
    if(pending_)Finish();
    saved_=next;pending_=valid;
  }
  __aicore__ inline void End() {
    if(pending_){Start();Finish();}
    PipeBarrier<PIPE_ALL>();
  }
};
template<int TN>
class AlignedResidentColumns {
  static constexpr int BM=64,BK=128;
  static constexpr int FK=((512*1024-256)/(2*BM+TN)/32)*32;
  static_assert((2*BM+TN)*FK<=512*1024-256);
  static_assert(2*BM*BK<=65536 && 2*TN*BK<=65536);
  static_assert(2*BM*TN*4<=128*1024);
  LocalTensor<int8_t> ab;
  LocalTensor<int8_t> bb;
  LocalTensor<int8_t> a0;
  LocalTensor<int8_t> b0;
  LocalTensor<int32_t> cb;
  GlobalTensor<int32_t> output_;
  struct Task {
    GlobalTensor<int8_t> a,b;
    int rows,cols,depth,strideB,ticket;
    bool lastA,lastB;
  } saved_;
  int core_=0,tasks_=0,produced_=0,lserial_=0;
  bool pending_=false;
  const __gm__ int8_t* cachedA_[2]={nullptr,nullptr};
  int cachedARows_[2]={0,0},cachedADepth_[2]={0,0};
  TEventID afree[2],aready[2],bfree,bready,lfree[2],lready[2];
  __aicore__ inline void PrepareA(const Task& p,int row,int slot) {
    const int rows=p.rows-row<BM?p.rows-row:BM,mr=(rows+15)/16*16;
    WaitFlag<HardEvent::MTE1_MTE2>(static_cast<event_t>(afree[slot]));
    const bool odd=(p.depth&1)!=0;
    auto address=p.a.GetPhyAddr()+(int64_t)row*p.depth;
    if(address!=cachedA_[slot] || rows!=cachedARows_[slot] || p.depth!=cachedADepth_[slot]){
      PairCopy(ab[slot*BM*FK],address,rows,p.depth,p.depth,mr,
        odd,odd && p.lastA && row+rows==p.rows,false);
      cachedA_[slot]=address;cachedARows_[slot]=rows;cachedADepth_[slot]=p.depth;
    }
    SetFlag<HardEvent::MTE2_MTE1>(static_cast<event_t>(aready[slot]));
  }
  __aicore__ inline void PrepareB(const Task& p) {
    const int slot=0,kr=(p.depth+31)/32*32;
    WaitFlag<HardEvent::MTE1_MTE2>(static_cast<event_t>(bfree));
    auto dst=bb[slot*TN*FK];
    PairCopy(dst,p.b.GetPhyAddr(),p.depth,p.cols,p.strideB,kr,true,p.lastB,true);
    if(kr!=p.depth)InitConstValue(dst.template ReinterpretCast<int32_t>()[p.depth*8],
      InitConstValueParams<int32_t>{(uint16_t)((p.cols+31)/32),
        (uint16_t)(kr-p.depth),(uint16_t)p.depth,0});
    SetFlag<HardEvent::MTE2_MTE1>(static_cast<event_t>(bready));
  }
  __aicore__ inline void Compute(const Task& p,const Task* next) {
    const int kr=(p.depth+31)/32*32,nr=(p.cols+31)/32*32;
    WaitFlag<HardEvent::MTE2_MTE1>(static_cast<event_t>(bready));
    for(int row=0;row<p.rows;row+=BM) {
      const int rows=p.rows-row<BM?p.rows-row:BM,mr=(rows+15)/16*16;
      const int slot=produced_&1;
      if(row+rows<p.rows)PrepareA(p,row+rows,slot^1);
      else if(next)PrepareA(*next,0,slot^1);
      WaitFlag<HardEvent::MTE2_MTE1>(static_cast<event_t>(aready[slot]));
      WaitFlag<HardEvent::FIX_M>(static_cast<event_t>(slot));
      auto al=ab[slot*BM*FK];auto cc=cb[slot*BM*TN];
      const uint8_t pad[4]={0,0,0,0};
      SetFmatrix(1,mr,pad,FmatrixMode::FMATRIX_LEFT);
      for(int ks=0;ks<kr;ks+=BK) {
        const int kb=kr-ks<BK?kr-ks:BK,ls=(lserial_++)&1;
        WaitFlag<HardEvent::M_MTE1>(static_cast<event_t>(lfree[ls]));
        auto aa=a0[ls*BM*BK],ba=b0[ls*TN*BK];
        LoadData3DParamsV2Pro la;
        la.channelSize=kb;la.extConfig=((uint64_t)mr<<16)|kb;
        LoadData(aa,al[ks*mr],la);
        if(kb>=nr) {
          LoadData2dTransposeParams lb{0,(uint8_t)(kb/32),1,(uint16_t)(nr/16-1),0};
          for(int ni=0;ni<nr;ni+=32)
            LoadDataWithTranspose(ba[ni*32],bb[ni*kr+ks*32],lb);
        } else {
          LoadData2dTransposeParams lb{0,(uint8_t)(nr/32),(uint16_t)(kr/32),1,0};
          for(int ki=0;ki<kb;ki+=32)
            LoadDataWithTranspose(ba[ki*nr],bb[(ks+ki)*32],lb);
        }
        if(ks+kb==kr) {
          SetFlag<HardEvent::MTE1_MTE2>(static_cast<event_t>(afree[slot]));
          if(row+rows==p.rows) {
            SetFlag<HardEvent::MTE1_MTE2>(static_cast<event_t>(bfree));
            if(next)PrepareB(*next);
          }
        }
        SetFlag<HardEvent::MTE1_M>(static_cast<event_t>(lready[ls]));
        WaitFlag<HardEvent::MTE1_M>(static_cast<event_t>(lready[ls]));
        MmadParams mp;
        mp.m=mr;mp.n=nr;mp.k=kb;mp.cmatrixInitVal=ks==0;mp.unitFlag=0;
        Mmad(cc,aa,ba,mp);
        if((mr/16)*(nr/16)<10)PipeBarrier<PIPE_M>();
        SetFlag<HardEvent::M_MTE1>(static_cast<event_t>(lfree[ls]));
      }
      if(produced_>=2)CrossCoreWaitFlag<2>(1+2*slot);
      SetFlag<HardEvent::M_FIX>(static_cast<event_t>(slot));
      WaitFlag<HardEvent::M_FIX>(static_cast<event_t>(slot));
      FixpipeParamsV220 fp;
      fp.nSize=nr;fp.mSize=mr;fp.srcStride=mr;fp.dstStride=TN;fp.unitFlag=0;
      Fixpipe(output_[((int64_t)core_*2+slot)*BM*TN],cc,fp);
      SetFlag<HardEvent::FIX_M>(static_cast<event_t>(slot));
      CrossCoreSetFlag<2,PIPE_FIX>(2*slot);++produced_;
    }
  }
public:
  __aicore__ inline void Init(GlobalTensor<int32_t> out,int core) {
    output_=out;core_=core;
    ab=LocalTensor<int8_t>(TPosition::A1,0,2*BM*FK);
    bb=LocalTensor<int8_t>(TPosition::B1,2*BM*FK,TN*FK);
    a0=LocalTensor<int8_t>(TPosition::A2,0,2*BM*BK);
    b0=LocalTensor<int8_t>(TPosition::B2,0,2*TN*BK);
    cb=LocalTensor<int32_t>(TPosition::CO1,0,2*BM*TN);
    SetMMRowMajor();bfree=static_cast<TEventID>(2);bready=static_cast<TEventID>(2);
    SetFlag<HardEvent::MTE1_MTE2>(static_cast<event_t>(bfree));
    for(int i=0;i<2;++i) {
      afree[i]=static_cast<TEventID>(i);aready[i]=static_cast<TEventID>(i);
      lfree[i]=static_cast<TEventID>(i+3);lready[i]=static_cast<TEventID>(i);
      SetFlag<HardEvent::MTE1_MTE2>(static_cast<event_t>(afree[i]));
      SetFlag<HardEvent::M_MTE1>(static_cast<event_t>(lfree[i]));
      SetFlag<HardEvent::FIX_M>(static_cast<event_t>(i));
    }
  }
  __aicore__ inline void Push(GlobalTensor<int8_t> a,GlobalTensor<int8_t> b,
    int rows,int cols,int depth,int strideB,bool lastA,bool lastB) {
    if(rows<=0)return;
    Task next={a,b,rows,cols,depth,strideB,tasks_,lastA,lastB};
    if(pending_)Compute(saved_,&next);
    else {PrepareA(next,0,produced_&1);PrepareB(next);}
    saved_=next;pending_=true;++tasks_;
  }
  __aicore__ inline void End() {
    if(pending_)Compute(saved_,nullptr);
    if(produced_>1)CrossCoreWaitFlag<2>(1+2*((produced_-2)&1));
    if(produced_>0)CrossCoreWaitFlag<2>(1+2*((produced_-1)&1));
    WaitFlag<HardEvent::MTE1_MTE2>(static_cast<event_t>(bfree));
    for(int i=0;i<2;++i) {
      WaitFlag<HardEvent::MTE1_MTE2>(static_cast<event_t>(afree[i]));
      WaitFlag<HardEvent::M_MTE1>(static_cast<event_t>(lfree[i]));
      WaitFlag<HardEvent::FIX_M>(static_cast<event_t>(i));
    }
    PipeBarrier<PIPE_ALL>();SetMMColumnMajor();
  }
};
template<int TN>
__global__ __mix__(1,2) void __attribute__((section(".text.Core.gmg.04.ZAlignedB"))) ZAlignedB(
GM_ADDR x,GM_ADDR weight,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,GM_ADDR workspace,
int M,int N,int K,int E,TCubeTiling tiling)
{
constexpr int TM=64,SCOLS=TN/2,VCOLS=(SCOLS+63)/64*64,VCOUNT=TM*VCOLS;
InitSocState();
GlobalTensor<int8_t> ag,bg;GlobalTensor<int64_t> gg;
GlobalTensor<int32_t> cg;GlobalTensor<float> sg;GlobalTensor<half> yg;
ag.SetGlobalBuffer((__gm__ int8_t*)x);bg.SetGlobalBuffer((__gm__ int8_t*)weight);
gg.SetGlobalBuffer((__gm__ int64_t*)groups);cg.SetGlobalBuffer((__gm__ int32_t*)workspace);
sg.SetGlobalBuffer((__gm__ float*)scale);yg.SetGlobalBuffer((__gm__ half*)y);
const int cores=GetBlockNum(),nc=(N+TN-1)/TN;
const int nb=(N+31)/32*32;
if(nb!=N){
 GlobalTensor<int8_t> bp;
 bp.SetGlobalBuffer((__gm__ int8_t*)(workspace+(int64_t)cores*2*TM*TN*4));
 if ASCEND_IS_AIV {PadRows(bp,bg,(int64_t)E*K,N,nb);}
 SyncAll<false>();bg=bp;
}
const int span=((N+nc-1)/nc+31)/32*32;
if ASCEND_IS_AIC {
 const int core=GetBlockIdx();
 AlignedResidentColumns<TN> mm;mm.Init(cg,core);
 int panels=0,prior=0;
 for(int e=0;e<E;++e){const int end=(int)gg.GetValue(e);panels+=(end-prior+TM-1)/TM;prior=end;}
 const int lower=panels*nc*core/cores,upper=panels*nc*(core+1)/cores;
 int prefix=0,start=0;
 for(int e=0;e<E && prefix<upper;++e){
 const int end=(int)gg.GetValue(e),count=(end-start+TM-1)/TM;
 for(int ni=0;ni<nc && prefix<upper;++ni){
  const int first=lower>prefix?lower-prefix:0;
  const int last=upper-prefix<count?upper-prefix:count;
  prefix+=count;
  if(first>=last)continue;
  const int begin=start+first*TM,finish=start+last*TM<end?start+last*TM:end;
  const int col=ni*span,cols=N-col<span?N-col:span;
  mm.Push(ag[(int64_t)begin*K],bg[(int64_t)e*K*nb+col],finish-begin,cols,K,nb,finish==M,e==E-1);
 }
 start=end;
 }
 mm.End();
}
if ASCEND_IS_AIV {
 const int core=GetBlockIdx()/2,sub=GetBlockIdx()%2;
 ResidentOutputPipeline<TM,TN,VCOLS> ep;ep.Init(cg,sg,yg,N);
 int consumed=0;
 int panels=0,prior=0;
 for(int e=0;e<E;++e){const int end=(int)gg.GetValue(e);panels+=(end-prior+TM-1)/TM;prior=end;}
 const int lower=panels*nc*core/cores,upper=panels*nc*(core+1)/cores;
 int prefix=0,start=0;
 for(int e=0;e<E && prefix<upper;++e){
 const int end=(int)gg.GetValue(e),count=(end-start+TM-1)/TM;
 for(int ni=0;ni<nc && prefix<upper;++ni){
  const int first=lower>prefix?lower-prefix:0;
  const int last=upper-prefix<count?upper-prefix:count;
  prefix+=count;
  if(first>=last)continue;
  const int begin=start+first*TM,finish=start+last*TM<end?start+last*TM:end;
  const int tileCol=ni*span;
  for(int row=begin;row<finish;row+=TM){
  const int rows=finish-row<TM?finish-row:TM,col=tileCol+sub*SCOLS;
  const int tileEnd=tileCol+span<N?tileCol+span:N;
  const int cols=tileEnd-col<SCOLS?tileEnd-col:SCOLS,slot=consumed&1;
  ep.Push({e,row,col,rows,cols,(cols+63)/64*64,slot,
    ((int64_t)core*2+slot)*TM*TN+sub*SCOLS});
  ++consumed;
  }
 }
 start=end;
 }
 ep.End();
}
}
template<int TN>
void LaunchAlignedResident(GM_ADDR x,GM_ADDR weight,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,
int M,int N,int K,int E,int cores,aclrtStream stream){
const int tasks=((M+63)/64+E-1)*((N+TN-1)/TN);if(cores>tasks)cores=tasks;
TCubeTiling tiling{};void* scratch=nullptr;
const int nb=(N+31)/32*32;
if(aclrtMalloc(&scratch,(int64_t)cores*2*64*TN*4+(nb!=N?(int64_t)E*K*nb:0),ACL_MEM_MALLOC_HUGE_FIRST)!=ACL_SUCCESS)return;
ZAlignedB<TN><<<cores,nullptr,stream>>>(x,weight,scale,groups,y,(GM_ADDR)scratch,M,N,K,E,tiling);
aclrtSynchronizeStream(stream);aclrtFree(scratch);
}
template<int TN>
void LaunchMediumCapacity(GM_ADDR,GM_ADDR,GM_ADDR,GM_ADDR,GM_ADDR,int,int,int,int,int,aclrtStream);
template<int ROWS>
__global__ __mix__(1,2) void ComputeColumnDots(
GM_ADDR x,GM_ADDR weight,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,GM_ADDR workspace,
int M,int K,int E,TCubeTiling tiling)
{
constexpr int VC=ROWS/2;
InitSocState();
GlobalTensor<int8_t> ag,bg;GlobalTensor<int64_t> gg;
GlobalTensor<int32_t> cg;GlobalTensor<float> sg;GlobalTensor<half> yg;
ag.SetGlobalBuffer((__gm__ int8_t*)x);bg.SetGlobalBuffer((__gm__ int8_t*)weight);
gg.SetGlobalBuffer((__gm__ int64_t*)groups);cg.SetGlobalBuffer((__gm__ int32_t*)workspace);
sg.SetGlobalBuffer((__gm__ float*)scale);yg.SetGlobalBuffer((__gm__ half*)y);
const int cores=GetBlockNum();
if ASCEND_IS_AIC {
 using BT=matmul::MatmulType<TPosition::GM,CubeFormat::ND,int8_t,true>;
 TPipe pipe;
 matmul::MatmulImpl<AType,BT,CType,BiasType,MM_CONFIG,typename TransportCallback<false>::Type> mm;
 mm.SetSubBlockIdx(0);mm.Init(&tiling,&pipe);mm.SetOrgShape(1,M,K,K,ROWS);
 int start=0,base=0,produced=0;
 for(int e=0;e<E;++e){
 const int end=(int)gg.GetValue(e),tasks=(end-start+ROWS-1)/ROWS;
 int first=GetBlockIdx()-base;if(first<0)first+=cores;
 for(int task=first;task<tasks;task+=cores){
  const int row=start+task*ROWS,rows=end-row<ROWS?end-row:ROWS,slot=produced&1;
  if(produced>=2)CrossCoreWaitFlag<2>(1+2*slot);
  mm.SetSingleShape(1,rows,K);
  mm.SetTensorA(bg[(int64_t)e*K],false);
  mm.SetTensorB(ag[(int64_t)row*K],true);
  mm.IterateAll(cg[((int64_t)GetBlockIdx()*2+slot)*ROWS],false);
  CrossCoreSetFlag<2,PIPE_FIX>(2*slot);++produced;
 }
 base=AdvanceTaskBase(base,tasks,cores);start=end;
 }
 if(produced>1)CrossCoreWaitFlag<2>(1+2*((produced-2)&1));
 if(produced>0)CrossCoreWaitFlag<2>(1+2*((produced-1)&1));
 mm.End();
}
if ASCEND_IS_AIV {
 const int core=GetBlockIdx()/2,sub=GetBlockIdx()%2;
 TPipe pipe;TQue<TPosition::VECIN,1> cq;TQue<TPosition::VECOUT,1> oq;
 TBuf<TPosition::VECCALC> tb;
 pipe.InitBuffer(cq,1,VC*4);pipe.InitBuffer(oq,1,VC*2);pipe.InitBuffer(tb,VC*4);
 auto t=tb.Get<float>();int start=0,base=0,consumed=0;
 for(int e=0;e<E;++e){
 const int end=(int)gg.GetValue(e),tasks=(end-start+ROWS-1)/ROWS;
 int first=core-base;if(first<0)first+=cores;
 for(int task=first;task<tasks;task+=cores){
  const int row=start+task*ROWS+sub*VC,rows=end-row<VC?end-row:VC,slot=consumed&1;
  CrossCoreWaitFlag<2>(2*slot);
  if(rows>0){
  auto c=cq.AllocTensor<int32_t>();
  DataCopyPad(c,cg[((int64_t)core*2+slot)*ROWS+sub*VC],
   DataCopyExtParams{1,(uint32_t)(rows*4),0,0,0},
   DataCopyPadExtParams<int32_t>{true,0,0,0});
  cq.EnQue(c);c=cq.DeQue<int32_t>();
  CrossCoreSetFlag<2,PIPE_MTE2>(1+2*slot);
  auto z=c.ReinterpretCast<float>();Cast(z,c,RoundMode::CAST_RINT,rows);
  PipeBarrier<PIPE_V>();Muls(z,z,sg.GetValue(e),rows);PipeBarrier<PIPE_V>();
  GeluBounded(z,t,rows);
  auto out=oq.AllocTensor<half>();Cast(out,z,RoundMode::CAST_RINT,rows);
  oq.EnQue(out);out=oq.DeQue<half>();
  DataCopyPad(yg[row],out,DataCopyExtParams{1,(uint32_t)(rows*2),0,0,0});
  oq.FreeTensor(out);cq.FreeTensor(c);
  }else CrossCoreSetFlag<2,PIPE_MTE2>(1+2*slot);
  ++consumed;
 }
 base=AdvanceTaskBase(base,tasks,cores);start=end;
 }
 PipeBarrier<PIPE_ALL>();
}
}
template<int ROWS>
void LaunchColumnDots(GM_ADDR x,GM_ADDR weight,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,
int M,int K,int E,int cores,aclrtStream stream)
{
const int maxTasks=(M+ROWS-1)/ROWS+E-1;if(cores>maxTasks)cores=maxTasks;
matmul_tiling::MultiCoreMatmulTiling mt;mt.SetDim(1);
mt.SetAType(matmul_tiling::TPosition::GM,matmul_tiling::CubeFormat::ND,matmul_tiling::DataType::DT_INT8,false);
mt.SetBType(matmul_tiling::TPosition::GM,matmul_tiling::CubeFormat::ND,matmul_tiling::DataType::DT_INT8,true);
mt.SetCType(matmul_tiling::TPosition::GM,matmul_tiling::CubeFormat::ND,matmul_tiling::DataType::DT_INT32);
mt.SetShape(1,ROWS,K);mt.SetOrgShape(1,M,K);mt.SetFixSplit(16,ROWS,128);
mt.SetBufferSpace(512*1024,128*1024,0);TCubeTiling tiling{};
if(mt.GetTiling(tiling)!=0)return;
void* scratch=nullptr;
if(aclrtMalloc(&scratch,(int64_t)cores*2*ROWS*4+cores*64,ACL_MEM_MALLOC_HUGE_FIRST)!=ACL_SUCCESS)return;
ComputeColumnDots<ROWS><<<cores,nullptr,stream>>>(x,weight,scale,groups,y,(GM_ADDR)scratch,M,K,E,tiling);
aclrtSynchronizeStream(stream);aclrtFree(scratch);
}
template<int DEPTH>
void LaunchTinyRows(GM_ADDR x,GM_ADDR weight,GM_ADDR scale,GM_ADDR groups,
  GM_ADDR y,int M,int N,int E,aclrtStream stream)
{
  if(DEPTH*N<=64)
    ComputeTiny<DEPTH,2><<<(M+1)/2,nullptr,stream>>>(x,weight,scale,groups,y,M,N,E);
  else
    ComputeTiny<DEPTH,1><<<M,nullptr,stream>>>(x,weight,scale,groups,y,M,N,E);
}
template<int TN>
class MediumCapacityColumns {
  static constexpr int BM=176,BK=160;
  static constexpr int FK=((512*1024-256)/(BM+2*TN)/32)*32;
  static_assert((BM+2*TN)*FK<=512*1024-256);
  static_assert(2*BM*BK<=65536 && 2*TN*BK<=65536);
  static_assert(BM*TN*4<=128*1024);
  LocalTensor<int8_t> ab;
  LocalTensor<int8_t> bb;
  LocalTensor<int8_t> a0;
  LocalTensor<int8_t> b0;
  LocalTensor<int32_t> cb;
  GlobalTensor<int32_t> output_;
  struct Task {
    GlobalTensor<int8_t> a,b;
    int rows,cols,depth,strideB,ticket;
    bool lastA,lastB;
  } saved_;
  int core_=0,tasks_=0,produced_=0,lserial_=0;
  bool pending_=false;
  const __gm__ int8_t* cachedA_=nullptr;
  int cachedARows_=0,cachedADepth_=0;
  TEventID afree,aready,bfree[2],bready[2],lfree[2],lready[2];
  __aicore__ inline void PrepareA(const Task& p,int row) {
    const int rows=p.rows-row<BM?p.rows-row:BM,mr=(rows+15)/16*16;
    WaitFlag<HardEvent::MTE1_MTE2>(static_cast<event_t>(afree));
    const bool odd=(p.depth&1)!=0;
    auto address=p.a.GetPhyAddr()+(int64_t)row*p.depth;
    if(address!=cachedA_ || rows!=cachedARows_ || p.depth!=cachedADepth_){
      PairCopy(ab,address,rows,p.depth,p.depth,mr,
        odd,odd && p.lastA && row+rows==p.rows,false);
      cachedA_=address;cachedARows_=rows;cachedADepth_=p.depth;
    }
    SetFlag<HardEvent::MTE2_MTE1>(static_cast<event_t>(aready));
  }
  __aicore__ inline void PrepareB(const Task& p) {
    const int slot=p.ticket&1,kr=(p.depth+31)/32*32;
    WaitFlag<HardEvent::MTE1_MTE2>(static_cast<event_t>(bfree[slot]));
    auto dst=bb[slot*TN*FK];
    PairCopy(dst,p.b.GetPhyAddr(),p.depth,p.cols,p.strideB,kr,true,p.lastB,false);
    if(kr!=p.depth)InitConstValue(dst.template ReinterpretCast<int32_t>()[p.depth*8],
      InitConstValueParams<int32_t>{(uint16_t)((p.cols+31)/32),
        (uint16_t)(kr-p.depth),(uint16_t)p.depth,0});
    SetFlag<HardEvent::MTE2_MTE1>(static_cast<event_t>(bready[slot]));
  }
  __aicore__ inline void Compute(const Task& p) {
    const int bs=p.ticket&1,kr=(p.depth+31)/32*32,nr=(p.cols+31)/32*32;
    auto bl=bb[bs*TN*FK];
    auto al=ab,ac=a0,bc=b0;
    auto cc=cb;
    WaitFlag<HardEvent::MTE2_MTE1>(static_cast<event_t>(bready[bs]));
    for(int row=0;row<p.rows;row+=BM) {
      const int rows=p.rows-row<BM?p.rows-row:BM,mr=(rows+15)/16*16;
      WaitFlag<HardEvent::MTE2_MTE1>(static_cast<event_t>(aready));
      const uint8_t pad[4]={0,0,0,0};
      SetFmatrix(1,mr,pad,FmatrixMode::FMATRIX_LEFT);
      for(int ks=0;ks<kr;ks+=BK) {
        const int kb=kr-ks<BK?kr-ks:BK,ls=(lserial_++)&1;
        WaitFlag<HardEvent::M_MTE1>(static_cast<event_t>(lfree[ls]));
        auto aa=ac[ls*BM*BK],ba=bc[ls*TN*BK];
        LoadData3DParamsV2Pro la;
        la.channelSize=kb;la.extConfig=((uint64_t)mr<<16)|kb;
        LoadData(aa,al[ks*mr],la);
        if(kb>=nr) {
          LoadData2dTransposeParams lb{0,(uint8_t)(kb/32),1,(uint16_t)(nr/16-1),0};
          for(int ni=0;ni<nr;ni+=32)
            LoadDataWithTranspose(ba[ni*32],bl[ni*kr+ks*32],lb);
        } else {
          LoadData2dTransposeParams lb{0,(uint8_t)(nr/32),(uint16_t)(kr/32),1,0};
          for(int ki=0;ki<kb;ki+=32)
            LoadDataWithTranspose(ba[ki*nr],bl[(ks+ki)*32],lb);
        }
        if(ks+kb==kr) {
          SetFlag<HardEvent::MTE1_MTE2>(static_cast<event_t>(afree));
          if(row+rows==p.rows)
            SetFlag<HardEvent::MTE1_MTE2>(static_cast<event_t>(bfree[bs]));
          else PrepareA(p,row+rows);
        }
        SetFlag<HardEvent::MTE1_M>(static_cast<event_t>(lready[ls]));
        WaitFlag<HardEvent::MTE1_M>(static_cast<event_t>(lready[ls]));
        MmadParams mp;
        mp.m=mr;mp.n=nr;mp.k=kb;mp.cmatrixInitVal=ks==0;
        mp.unitFlag=ks+kb==kr?3:2;
        Mmad(cc,aa,ba,mp);
        if((mr/16)*(nr/16)<10)PipeBarrier<PIPE_M>();
        SetFlag<HardEvent::M_MTE1>(static_cast<event_t>(lfree[ls]));
      }
      const int slot=produced_&1;
      if(produced_>=2)CrossCoreWaitFlag<2>(1+2*slot);
      FixpipeParamsV220 fp;
      fp.nSize=nr;fp.mSize=mr;fp.srcStride=mr;fp.dstStride=TN;fp.unitFlag=3;
      Fixpipe(output_[((int64_t)core_*2+slot)*BM*TN],cc,fp);
      CrossCoreSetFlag<2,PIPE_FIX>(2*slot);++produced_;
    }
  }
public:
  __aicore__ inline void Init(GlobalTensor<int32_t> out,int core) {
    output_=out;core_=core;
    ab=LocalTensor<int8_t>(TPosition::A1,0,BM*FK);
    bb=LocalTensor<int8_t>(TPosition::B1,BM*FK,2*TN*FK);
    a0=LocalTensor<int8_t>(TPosition::A2,0,2*BM*BK);
    b0=LocalTensor<int8_t>(TPosition::B2,0,2*TN*BK);
    cb=LocalTensor<int32_t>(TPosition::CO1,0,BM*TN);
    SetMMRowMajor();
    afree=static_cast<TEventID>(0);
    aready=static_cast<TEventID>(0);
    SetFlag<HardEvent::MTE1_MTE2>(static_cast<event_t>(afree));
    for(int i=0;i<2;++i) {
      bfree[i]=static_cast<TEventID>(i+1);
      bready[i]=static_cast<TEventID>(i+1);
      lfree[i]=static_cast<TEventID>(i+3);
      lready[i]=static_cast<TEventID>(i);
      SetFlag<HardEvent::MTE1_MTE2>(static_cast<event_t>(bfree[i]));
      SetFlag<HardEvent::M_MTE1>(static_cast<event_t>(lfree[i]));
    }
  }
  __aicore__ inline void Push(GlobalTensor<int8_t> a,GlobalTensor<int8_t> b,
    int rows,int cols,int depth,int strideB,bool lastA,bool lastB) {
    if(rows<=0)return;
    Task next={a,b,rows,cols,depth,strideB,tasks_,lastA,lastB};
    if(!pending_) { PrepareA(next,0);PrepareB(next); }
    else { PrepareB(next);Compute(saved_);PrepareA(next,0); }
    saved_=next;pending_=true;++tasks_;
  }
  __aicore__ inline void End() {
    if(pending_)Compute(saved_);
    if(produced_>1)CrossCoreWaitFlag<2>(1+2*((produced_-2)&1));
    if(produced_>0)CrossCoreWaitFlag<2>(1+2*((produced_-1)&1));
    WaitFlag<HardEvent::MTE1_MTE2>(static_cast<event_t>(afree));
    for(int i=0;i<2;++i) {
      WaitFlag<HardEvent::MTE1_MTE2>(static_cast<event_t>(bfree[i]));
      WaitFlag<HardEvent::M_MTE1>(static_cast<event_t>(lfree[i]));
    }
    PipeBarrier<PIPE_ALL>();SetMMColumnMajor();
  }
};
template<int TN>
__global__ __mix__(1,2) void __attribute__((section(".text.Core.gmg.09.ZCompactM"))) ZCompactM(
GM_ADDR x,GM_ADDR weight,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,GM_ADDR workspace,
int M,int N,int K,int E,TCubeTiling tiling)
{
constexpr int TM=176,MAXROWS=(TM+1)/2,VCOLS=(TN+63)/64*64,VCOUNT=MAXROWS*VCOLS;
InitSocState();
GlobalTensor<int8_t> ag,bg;GlobalTensor<int64_t> gg;
GlobalTensor<int32_t> cg;GlobalTensor<float> sg;GlobalTensor<half> yg;
ag.SetGlobalBuffer((__gm__ int8_t*)x);bg.SetGlobalBuffer((__gm__ int8_t*)weight);
gg.SetGlobalBuffer((__gm__ int64_t*)groups);cg.SetGlobalBuffer((__gm__ int32_t*)workspace);
sg.SetGlobalBuffer((__gm__ float*)scale);yg.SetGlobalBuffer((__gm__ half*)y);
const int cores=GetBlockNum(),nc=(N+TN-1)/TN;
const int nblocks=(N+31)/32;
if ASCEND_IS_AIC {
 const int core=GetBlockIdx();
 MediumCapacityColumns<TN> mm;mm.Init(cg,core);
 int panels=0,prior=0;
 for(int e=0;e<E;++e){const int end=(int)gg.GetValue(e);panels+=(end-prior+TM-1)/TM;prior=end;}
 const int lower=panels*nc*core/cores,upper=panels*nc*(core+1)/cores;
 int prefix=0,start=0;
 for(int e=0;e<E && prefix<upper;++e){
 const int end=(int)gg.GetValue(e),count=(end-start+TM-1)/TM;
 for(int ni=0;ni<nc && prefix<upper;++ni){
  const int first=lower>prefix?lower-prefix:0;
  const int last=upper-prefix<count?upper-prefix:count;
  prefix+=count;
  if(first>=last)continue;
  const int begin=start+first*TM,finish=start+last*TM<end?start+last*TM:end;
  const int col=(nblocks*ni/nc)*32;
  const int tileLimit=(nblocks*(ni+1)/nc)*32;
  const int cols=(tileLimit<N?tileLimit:N)-col;
  mm.Push(ag[(int64_t)begin*K],bg[(int64_t)e*K*N+col],finish-begin,cols,K,N,finish==M,e==E-1);
 }
 start=end;
 }
 mm.End();
}
if ASCEND_IS_AIV {
 const int core=GetBlockIdx()/2,sub=GetBlockIdx()%2;
 TPipe pipe;TQue<TPosition::VECIN,1> cq,sq;TQue<TPosition::VECOUT,1> oq;
 TBuf<TPosition::VECCALC> tb;
 pipe.InitBuffer(cq,1,VCOUNT*4);pipe.InitBuffer(sq,1,VCOLS*4);
 pipe.InitBuffer(oq,1,VCOUNT*2);pipe.InitBuffer(tb,VCOUNT*4);
 auto t=tb.Get<float>();int consumed=0;
 int panels=0,prior=0;
 for(int e=0;e<E;++e){const int end=(int)gg.GetValue(e);panels+=(end-prior+TM-1)/TM;prior=end;}
 const int lower=panels*nc*core/cores,upper=panels*nc*(core+1)/cores;
 int prefix=0,start=0;
 for(int e=0;e<E && prefix<upper;++e){
 const int end=(int)gg.GetValue(e),count=(end-start+TM-1)/TM;
 for(int ni=0;ni<nc && prefix<upper;++ni){
  const int first=lower>prefix?lower-prefix:0;
  const int last=upper-prefix<count?upper-prefix:count;
  prefix+=count;
  if(first>=last)continue;
  const int begin=start+first*TM,finish=start+last*TM<end?start+last*TM:end;
  const int tileCol=(nblocks*ni/nc)*32;
  for(int row=begin;row<finish;row+=TM){
  const int fullRows=finish-row<TM?finish-row:TM,split=(fullRows+1)/2;
  const int rowOff=sub?split:0,rows=sub?fullRows-split:split,col=tileCol;
  const int tileLimit=(nblocks*(ni+1)/nc)*32;
  const int tileEnd=tileLimit<N?tileLimit:N;
  const int cols=tileEnd-col,slot=consumed&1;
  CrossCoreWaitFlag<2>(2*slot);
        if (rows > 0 && cols > 0) {
          const int pitch = (cols + 63) / 64 * 64;
          auto c = cq.AllocTensor<int32_t>();
          auto s = sq.AllocTensor<float>();
          DataCopyPad(c, cg[((int64_t)core * 2 + slot) * TM * TN + (int64_t)rowOff * TN],
            DataCopyExtParams{(uint16_t)rows, (uint32_t)(cols * 4),
              (uint32_t)((TN - cols) * 4), (uint32_t)((pitch - (cols + 7) / 8 * 8) / 8), 0},
            DataCopyPadExtParams<int32_t>{true, 0, 0, 0});
          DataCopyPad(s, sg[(int64_t)e * N + col],
            DataCopyExtParams{1, (uint32_t)(cols * 4), 0, 0, 0},
            DataCopyPadExtParams<float>{true, 0, 0, 0.0f});
          cq.EnQue(c);
          sq.EnQue(s);
          c = cq.DeQue<int32_t>();
          s = sq.DeQue<float>();
          CrossCoreSetFlag<2, PIPE_MTE2>(1 + 2 * slot);
          auto z = c.ReinterpretCast<float>();
          Cast(z, c, RoundMode::CAST_RINT, rows * pitch);
          PipeBarrier<PIPE_V>();
          if constexpr (TM > 255) {
            for(int r0=0;r0<rows;r0+=255){
              const uint8_t repeats=(uint8_t)(rows-r0<255?rows-r0:255);
              for(int c0=0;c0<pitch;c0+=64)
                Mul(z[r0*pitch+c0],z[r0*pitch+c0],s[c0],(uint64_t)64,repeats,
                  BinaryRepeatParams{1,1,1,(uint8_t)(pitch/8),(uint8_t)(pitch/8),0});
            }
          } else {
            for (int c0 = 0; c0 < pitch; c0 += 64)
              Mul(z[c0], z[c0], s[c0], (uint64_t)64, (uint8_t)rows,
                BinaryRepeatParams{1, 1, 1, (uint8_t)(pitch / 8), (uint8_t)(pitch / 8), 0});
          }
          PipeBarrier<PIPE_V>();
          GeluResident(z,t,rows*pitch);
          auto out = oq.AllocTensor<half>();
          Cast(out, z, RoundMode::CAST_RINT, rows * pitch);
          oq.EnQue(out);
          out = oq.DeQue<half>();
          DataCopyPad(yg[(int64_t)(row+rowOff) * N + col], out,
            DataCopyExtParams{(uint16_t)rows, (uint32_t)(cols * 2),
              (uint32_t)((pitch - (cols + 15) / 16 * 16) / 16),
              (uint32_t)((N - cols) * 2), 0});
          oq.FreeTensor(out);
          sq.FreeTensor(s);
          cq.FreeTensor(c);
        } else {
          CrossCoreSetFlag<2, PIPE_MTE2>(1 + 2 * slot);
        }
  ++consumed;
  }
 }
 start=end;
 }
}
}
template<int TN>
void LaunchMediumCapacity(GM_ADDR x,GM_ADDR weight,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,
int M,int N,int K,int E,int cores,aclrtStream stream){
const int tasks=((M+175)/176+E-1)*((N+TN-1)/TN);if(cores>tasks)cores=tasks;
TCubeTiling tiling{};void* scratch=nullptr;
if(aclrtMalloc(&scratch,(int64_t)cores*2*176*TN*4,ACL_MEM_MALLOC_HUGE_FIRST)!=ACL_SUCCESS)return;
ZCompactM<TN><<<cores,nullptr,stream>>>(x,weight,scale,groups,y,(GM_ADDR)scratch,M,N,K,E,tiling);
aclrtSynchronizeStream(stream);aclrtFree(scratch);
}
}
namespace TinySingle {
template<int KMAX, int NCOLS>
__vector__ __global__ __aicore__ void ComputeTinyKnownKN(
  GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groups,
  GM_ADDR y, int M, int E)
{
  constexpr int K = KMAX;
  constexpr int N = NCOLS;
  InitSocState();
  GlobalTensor<uint64_t> xp,wp,sp,gp;
  xp.SetGlobalBuffer((__gm__ uint64_t*)x);
  wp.SetGlobalBuffer((__gm__ uint64_t*)weight);
  sp.SetGlobalBuffer((__gm__ uint64_t*)scale);
  gp.SetGlobalBuffer((__gm__ uint64_t*)groups);
  DataCachePreload(gp,(int64_t)0);
  DataCachePreload(xp,(int64_t)GetBlockIdx()*K);
  DataCachePreload(wp,(int64_t)0);
  DataCachePreload(sp,(int64_t)0);
  const __gm__ int8_t* a = (__gm__ int8_t*)x;
  const __gm__ int8_t* w = (__gm__ int8_t*)weight;
  const __gm__ int64_t* g = (__gm__ int64_t*)groups;
  const __gm__ float* s = (__gm__ float*)scale;
  GlobalTensor<half> yg;
  yg.SetGlobalBuffer((__gm__ half*)y);
  LocalTensor<float> z(TPosition::VECCALC, 0, 64);
  LocalTensor<float> t(TPosition::VECCALC, 256, 64);
  LocalTensor<half> out(TPosition::VECOUT, 512, 64);
  int expert = 0;
  const int row = GetBlockIdx();
  {
    while (expert + 1 < E && row >= g[expert]) ++expert;
    int32_t av[KMAX];
    #pragma unroll
    for (int k = 0; k < KMAX; ++k)
      av[k] = k < K ? (int32_t)a[row * K + k] : 0;
    const __gm__ int8_t* b = w + (int64_t)expert * K * N;
    #pragma unroll
    for (int col = 0; col < N; ++col) {
      int32_t acc = 0;
      #pragma unroll
      for (int k = 0; k < KMAX; ++k)
        if (k < K) acc += av[k] * (int32_t)b[k * N + col];
      z.SetValue(col, (float)acc * s[expert * N + col]);
    }
  }
  SetFlag<HardEvent::S_V>(EVENT_ID0);
  WaitFlag<HardEvent::S_V>(EVENT_ID0);
  SetMaskNorm();
  SetVectorMask<float, MaskMode::NORMAL>((uint64_t)N);
  const BinaryRepeatParams binary{1,1,1,8,8,8};
  const UnaryRepeatParams unary{1,1,8,8};
  Mul<float,false>(t,z,z,MASK_PLACEHOLDER,1,binary);
  PipeBarrier<PIPE_V>();
  Muls<float,false>(t,t,-0.07135481627260025f,MASK_PLACEHOLDER,1,unary);
  PipeBarrier<PIPE_V>();
  Adds<float,false>(t,t,-1.5957691216057308f,MASK_PLACEHOLDER,1,unary);
  PipeBarrier<PIPE_V>();
  Mul<float,false>(t,t,z,MASK_PLACEHOLDER,1,binary);
  PipeBarrier<PIPE_V>();
  Maxs<float,false>(t,t,-87.0f,MASK_PLACEHOLDER,1,unary);
  PipeBarrier<PIPE_V>();
  Mins<float,false>(t,t,87.0f,MASK_PLACEHOLDER,1,unary);
  PipeBarrier<PIPE_V>();
  Exp<float,false>(t,t,MASK_PLACEHOLDER,1,unary);
  PipeBarrier<PIPE_V>();
  Adds<float,false>(t,t,1.0f,MASK_PLACEHOLDER,1,unary);
  PipeBarrier<PIPE_V>();
  Div<float,false>(z,z,t,MASK_PLACEHOLDER,1,binary);
  PipeBarrier<PIPE_V>();
  Cast<half,float,false>(out,z,RoundMode::CAST_RINT,MASK_PLACEHOLDER,1,
    UnaryRepeatParams{1,1,4,8});
  PipeBarrier<PIPE_V>();
  ResetMask();
  SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
  WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
  DataCopyPad(yg[(int64_t)row*N],out,DataCopyExtParams{1,(uint32_t)(N*2),0,0,0});
  PipeBarrier<PIPE_ALL>();
}
template<int DEPTH>
void LaunchTinyKnownN(GM_ADDR x,GM_ADDR weight,GM_ADDR scale,GM_ADDR groups,
  GM_ADDR y,int M,int N,int E,aclrtStream stream)
{
  switch (N) {
  case 1: ComputeTinyKnownKN<DEPTH,1><<<M,nullptr,stream>>>(x,weight,scale,groups,y,M,E); break;
  case 2: ComputeTinyKnownKN<DEPTH,2><<<M,nullptr,stream>>>(x,weight,scale,groups,y,M,E); break;
  case 3: ComputeTinyKnownKN<DEPTH,3><<<M,nullptr,stream>>>(x,weight,scale,groups,y,M,E); break;
  case 4: ComputeTinyKnownKN<DEPTH,4><<<M,nullptr,stream>>>(x,weight,scale,groups,y,M,E); break;
  case 5: ComputeTinyKnownKN<DEPTH,5><<<M,nullptr,stream>>>(x,weight,scale,groups,y,M,E); break;
  case 6: ComputeTinyKnownKN<DEPTH,6><<<M,nullptr,stream>>>(x,weight,scale,groups,y,M,E); break;
  case 7: ComputeTinyKnownKN<DEPTH,7><<<M,nullptr,stream>>>(x,weight,scale,groups,y,M,E); break;
  case 8: ComputeTinyKnownKN<DEPTH,8><<<M,nullptr,stream>>>(x,weight,scale,groups,y,M,E); break;
  case 9: ComputeTinyKnownKN<DEPTH,9><<<M,nullptr,stream>>>(x,weight,scale,groups,y,M,E); break;
  case 10: ComputeTinyKnownKN<DEPTH,10><<<M,nullptr,stream>>>(x,weight,scale,groups,y,M,E); break;
  case 11: ComputeTinyKnownKN<DEPTH,11><<<M,nullptr,stream>>>(x,weight,scale,groups,y,M,E); break;
  case 12: ComputeTinyKnownKN<DEPTH,12><<<M,nullptr,stream>>>(x,weight,scale,groups,y,M,E); break;
  case 13: ComputeTinyKnownKN<DEPTH,13><<<M,nullptr,stream>>>(x,weight,scale,groups,y,M,E); break;
  case 14: ComputeTinyKnownKN<DEPTH,14><<<M,nullptr,stream>>>(x,weight,scale,groups,y,M,E); break;
  case 15: ComputeTinyKnownKN<DEPTH,15><<<M,nullptr,stream>>>(x,weight,scale,groups,y,M,E); break;
  case 16: ComputeTinyKnownKN<DEPTH,16><<<M,nullptr,stream>>>(x,weight,scale,groups,y,M,E); break;
  }
}
}
namespace Expert {
constexpr MatmulConfig MM_CONFIG =
  GetMDLConfig(false, false, 0, false, false, false, true, true, true, false, false, true);
constexpr MatmulConfig NORMAL_CONFIG = GetNormalConfig(false, false, false,
  BatchMode::NONE, true, IterateOrder::UNDEF, ScheduleType::INNER_PRODUCT,
  true, false, BatchOutMode::SINGLE_BATCH);
using AType = matmul::MatmulType<TPosition::GM, CubeFormat::ND, int8_t, false>;
using BType = matmul::MatmulType<TPosition::GM, CubeFormat::ND, int8_t, false>;
using CType = matmul::MatmulType<TPosition::GM, CubeFormat::ND, int32_t>;
using BiasType = matmul::MatmulType<TPosition::GM, CubeFormat::ND, int32_t>;
template<bool USE_NORMAL, typename CALLBACK> struct MatmulSelect;
template<typename CALLBACK> struct MatmulSelect<false, CALLBACK> {
  using Type = matmul::MatmulImpl<AType, BType, CType, BiasType, MM_CONFIG, CALLBACK>;
};
template<typename CALLBACK> struct MatmulSelect<true, CALLBACK> {
  using Type = matmul::MatmulImpl<AType, BType, CType, BiasType, NORMAL_CONFIG, CALLBACK>;
};
__aicore__ inline int SingleRowExpert(GlobalTensor<int64_t> groups,int E)
{
  if(E==1 || groups.GetValue(0)>0)return 0;
  int lo=1,hi=E-1;
  while(lo<hi){
    const int mid=(lo+hi)/2;
    if(groups.GetValue(mid)==0)lo=mid+1;else hi=mid;
  }
  return lo;
}
__aicore__ inline int SingleRowExpert(LocalTensor<int32_t> groups,int E)
{
  if(E==1 || groups.GetValue(0)>0)return 0;
  int lo=1,hi=E-1;
  while(lo<hi){
    const int mid=(lo+hi)/2;
    if(groups.GetValue(2*mid)==0)lo=mid+1;else hi=mid;
  }
  return lo;
}
__aicore__ inline void PadRows(GlobalTensor<int8_t> dst, GlobalTensor<int8_t> src,
  int64_t rows, int width, int padded)
{
  TPipe pipe;
  TBuf<TPosition::VECCALC> buffer;
  pipe.InitBuffer(buffer, 32768);
  auto data = buffer.Get<int8_t>();
  const int chunk = 32768 / padded;
  const int blocks = GetBlockNum() * 2;
  for (int64_t row = (int64_t)GetBlockIdx() * chunk; row < rows; row += (int64_t)blocks * chunk) {
    int count = rows - row < chunk ? rows - row : chunk;
    DataCopyPad(data, src[row * width],
      DataCopyExtParams{(uint16_t)count, (uint32_t)width, 0, 0, 0},
      DataCopyPadExtParams<int8_t>{true, 0, (uint8_t)(padded - width), 0});
    SetFlag<HardEvent::MTE2_MTE3>(EVENT_ID0);
    WaitFlag<HardEvent::MTE2_MTE3>(EVENT_ID0);
    DataCopy(dst[row * padded], data, count * padded);
    SetFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);
    WaitFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);
  }
}
__aicore__ inline void WordCopy(const LocalTensor<int8_t>& dst, const __gm__ int8_t* ptr,
  int height, int width, int stride, int paddedHeight, bool finalRow)
{
  const int count=height-((width%4 && finalRow)?1:0);
  const int groups=stride%4==0?1:(stride%2==0?2:4);
  auto d32=dst.ReinterpretCast<int32_t>();
  for (int g=0;g<groups && g<count;++g) {
    GlobalTensor<int32_t> src;
    src.SetGlobalBuffer((__gm__ int32_t*)(ptr+(int64_t)g*stride));
    DataCopy(d32[g*8],src,Nd2NzParams{1,(uint16_t)((count-g+groups-1)/groups),
      (uint16_t)((width+3)/4),0,(uint16_t)(stride*groups/4),
      (uint16_t)paddedHeight,(uint16_t)groups,0});
  }
  if (count<height) {
    GlobalTensor<int8_t> src;
    src.SetGlobalBuffer((__gm__ int8_t*)(ptr+(int64_t)(height-1)*stride));
    DataCopy(dst[(height-1)*32],src,Nd2NzParams{1,1,(uint16_t)width,0,
      (uint16_t)stride,(uint16_t)paddedHeight,1,0});
  }
}
__aicore__ inline void PairCopy(const LocalTensor<int8_t>& dst, const __gm__ int8_t* ptr,
  int height, int width, int stride, int paddedHeight, bool allowOdd, bool finalRow, bool preferWord)
{
  if (allowOdd && stride >= 4 && (stride <= 64 || preferWord)) {
    WordCopy(dst,ptr,height,width,stride,paddedHeight,finalRow);
    return;
  }
  GlobalTensor<int8_t> src;
  src.SetGlobalBuffer((__gm__ int8_t*)ptr);
  if ((width & 1) && !allowOdd) {
    DataCopy(dst,src,Nd2NzParams{1,(uint16_t)height,(uint16_t)width,0,
      (uint16_t)stride,(uint16_t)paddedHeight,1,0});
    return;
  }
  const int count=height-(((width&1)&&finalRow)?1:0);
  const int pairs=(width+1)/2;
  if (count>0) {
    auto d16=dst.ReinterpretCast<int16_t>();
    GlobalTensor<int16_t> s16;
    s16.SetGlobalBuffer((__gm__ int16_t*)ptr);
    if (stride % 2 == 0) {
      DataCopy(d16,s16,Nd2NzParams{1,(uint16_t)count,(uint16_t)pairs,0,
        (uint16_t)(stride/2),(uint16_t)paddedHeight,1,0});
    } else {
      DataCopy(d16,s16,Nd2NzParams{1,(uint16_t)((count+1)/2),(uint16_t)pairs,0,
        (uint16_t)stride,(uint16_t)paddedHeight,2,0});
      if (count>1) {
        s16.SetGlobalBuffer((__gm__ int16_t*)(ptr+stride));
        DataCopy(d16[16],s16,Nd2NzParams{1,(uint16_t)(count/2),(uint16_t)pairs,0,
          (uint16_t)stride,(uint16_t)paddedHeight,2,0});
      }
    }
  }
  if (count<height) {
    DataCopy(dst[(height-1)*32],src[(int64_t)(height-1)*stride],
      Nd2NzParams{1,1,(uint16_t)width,0,(uint16_t)stride,(uint16_t)paddedHeight,1,0});
  }
}
__aicore__ inline void PairA(const LocalTensor<int8_t>& dst, const __gm__ void* gm,
  int row, int col, int useM, int useK, uint64_t unused, uint64_t meta)
{
  int stride=meta&0x3fff;
  int bm=((meta>>41)&15)*16;
  int bk=((meta>>50)&31)*32;
  auto ptr=(const __gm__ int8_t*)gm+(int64_t)row*bm*stride+col*bk;
  const bool odd=(useK&1)!=0;
  PairCopy(dst,ptr,useM,useK,stride,(useM+15)/16*16,
    odd,odd && ((meta>>62)&1),false);
}
__aicore__ inline void PairB(const LocalTensor<int8_t>& dst, const __gm__ void* gm,
  int row, int col, int useK, int useN, uint64_t unused, uint64_t meta)
{
  int stride=(meta>>14)&0x1fff;
  int k=(meta>>27)&0x3fff;
  int bn=((meta>>45)&31)*32;
  int bk=((meta>>50)&31)*32;
  bool finalRow=((meta>>55)&1) && row*bk+useK==k;
  auto ptr=(const __gm__ int8_t*)gm+(int64_t)row*bk*stride+col*bn;
  const int paddedK=(useK+31)/32*32;
  PairCopy(dst,ptr,useK,useN,stride,paddedK,true,finalRow,(meta>>56)&1);
  if((useK&1) && useN>0){
    InitConstValue(dst.ReinterpretCast<int32_t>()[useK*8],
      InitConstValueParams<int32_t>{(uint16_t)((useN+31)/32),
        (uint16_t)(paddedK-useK),(uint16_t)useK,0});
  }
}
__aicore__ inline void AdaptiveB(const LocalTensor<int8_t>& dst,const __gm__ void* gm,
  int row,int col,int useK,int useN,uint64_t unused,uint64_t meta)
{
  const int stride=(meta>>14)&0x1fff;
  const int bn=((meta>>45)&31)*32;
  const int outer=(int)((meta>>57)&31)*128;
  const int valid=stride-outer-col*bn;
  PairB(dst,gm,row,col,useK,useN<valid?useN:valid,unused,meta);
}
template<bool ENABLED> struct TransportCallback;
template<> struct TransportCallback<true> {
  using Type=MatmulCallBackFunc<nullptr,PairA,AdaptiveB>;
};
template<> struct TransportCallback<false> {
  using Type=MatmulCallBackFunc<nullptr,nullptr,nullptr>;
};
template<int TM, int TN>
class DirectSingleMatmul {
  static constexpr int CK = 65536 / (TM > TN ? TM : TN);
  static_assert(TM * TN * sizeof(int32_t) <= 128 * 1024);
  TBuf<TPosition::A1> ab;
  TBuf<TPosition::B1> bb;
  TBuf<TPosition::A2> a0;
  TBuf<TPosition::B2> b0;
  TBuf<TPosition::CO1> cb;
  GlobalTensor<int8_t> a, b;
  uint64_t meta = 0;
  int rows, cols, depth;
  bool previous = false;
  const __gm__ int8_t* cached_b = nullptr;
  uint64_t cached_b_meta = 0;
  int cached_b_cols = 0, cached_b_depth = 0;
  TPipe* pipe_;
  TEventID event_MTE1_MTE2;
  TEventID event_MTE2_MTE1;
  TEventID event_M_MTE1;
  TEventID event_MTE1_M;
  TEventID event_FIX_M;
  TEventID event_M_FIX;
public:
  __aicore__ inline void SetSubBlockIdx(int) {}
  __aicore__ inline void Init(TCubeTiling*, TPipe* pipe) {
    pipe->InitBuffer(ab, TM * CK);
    pipe->InitBuffer(bb, CK * TN);
    pipe->InitBuffer(a0, TM * CK);
    pipe->InitBuffer(b0, CK * TN);
    pipe->InitBuffer(cb, TM * TN * sizeof(int32_t));
    pipe_ = pipe;
    event_MTE1_MTE2 = pipe->AllocEventID<HardEvent::MTE1_MTE2>();
    event_MTE2_MTE1 = pipe->AllocEventID<HardEvent::MTE2_MTE1>();
    event_M_MTE1 = pipe->AllocEventID<HardEvent::M_MTE1>();
    event_MTE1_M = pipe->AllocEventID<HardEvent::MTE1_M>();
    event_FIX_M = pipe->AllocEventID<HardEvent::FIX_M>();
    event_M_FIX = pipe->AllocEventID<HardEvent::M_FIX>();
  }
  __aicore__ inline void SetOrgShape(int, int, int, int, int) {}
  __aicore__ inline void SetSingleShape(int m, int n, int k) {
    rows = m; cols = n; depth = k;
  }
  __aicore__ inline void SetSelfDefineData(uint64_t value) { meta = value; }
  __aicore__ inline void SetTensorA(GlobalTensor<int8_t> value, bool) { a = value; }
  __aicore__ inline void SetTensorB(GlobalTensor<int8_t> value, bool) { b = value; }
  __aicore__ inline void End() {
    PipeBarrier<PIPE_ALL>();
    pipe_->ReleaseEventID<HardEvent::MTE1_MTE2>(event_MTE1_MTE2);
    pipe_->ReleaseEventID<HardEvent::MTE2_MTE1>(event_MTE2_MTE1);
    pipe_->ReleaseEventID<HardEvent::M_MTE1>(event_M_MTE1);
    pipe_->ReleaseEventID<HardEvent::MTE1_M>(event_MTE1_M);
    pipe_->ReleaseEventID<HardEvent::FIX_M>(event_FIX_M);
    pipe_->ReleaseEventID<HardEvent::M_FIX>(event_M_FIX);
  }
  __aicore__ inline void IterateAll(GlobalTensor<int32_t> c, bool) {
    auto al = ab.Get<int8_t>(), bl = bb.Get<int8_t>();
    auto ac = a0.Get<int8_t>(), bc = b0.Get<int8_t>();
    auto cc = cb.Get<int32_t>();
    const int mr = (rows + 15) / 16 * 16;
    const int nr = (cols + 31) / 32 * 32;
    const int kr = (depth + 31) / 32 * 32;
    const auto bptr = b.GetPhyAddr();
    const uint64_t bmeta = meta & ~(uint64_t(1) << 62);
    const bool reuseB = previous && bptr == cached_b && bmeta == cached_b_meta
      && cols == cached_b_cols && depth == cached_b_depth;
    if (previous) {
      SetFlag<HardEvent::MTE1_MTE2>(static_cast<event_t>(event_MTE1_MTE2));
      WaitFlag<HardEvent::MTE1_MTE2>(static_cast<event_t>(event_MTE1_MTE2));
    }
    PairA(al, a.GetPhyAddr(), 0, 0, rows, depth, 0, meta);
    if (!reuseB) {
      AdaptiveB(bl, bptr, 0, 0, depth, cols, 0, meta);
      if (kr != depth && (depth & 1) == 0) {
        const int stride = (meta >> 14) & 0x1fff;
        const int outer = (int)((meta >> 57) & 31) * 128;
        const int valid = stride - outer < cols ? stride - outer : cols;
        InitConstValue(bl.ReinterpretCast<int32_t>()[depth * 8],
          InitConstValueParams<int32_t>{(uint16_t)((valid + 31) / 32),
            (uint16_t)(kr - depth), (uint16_t)depth, 0});
      }
    }
    SetFlag<HardEvent::MTE2_MTE1>(static_cast<event_t>(event_MTE2_MTE1));
    WaitFlag<HardEvent::MTE2_MTE1>(static_cast<event_t>(event_MTE2_MTE1));
    if (previous) {
      SetFlag<HardEvent::M_MTE1>(static_cast<event_t>(event_M_MTE1));
      WaitFlag<HardEvent::M_MTE1>(static_cast<event_t>(event_M_MTE1));
    }
    const uint8_t pad[4] = {0, 0, 0, 0};
    SetFmatrix(1, mr, pad, FmatrixMode::FMATRIX_LEFT);
    LoadData3DParamsV2Pro la;
    la.channelSize = kr;
    la.extConfig = ((uint64_t)mr << 16) | kr;
    LoadData(ac, al, la);
    if (!reuseB) {
      LoadData2dTransposeParams lb{0, (uint8_t)(nr / 32), (uint16_t)(kr / 32), 1, 0};
      for (int ki = 0; ki < kr; ki += 32)
        LoadDataWithTranspose(bc[ki * nr], bl[ki * 32], lb);
    }
    SetFlag<HardEvent::MTE1_M>(static_cast<event_t>(event_MTE1_M));
    WaitFlag<HardEvent::MTE1_M>(static_cast<event_t>(event_MTE1_M));
    if (previous) {
      SetFlag<HardEvent::FIX_M>(static_cast<event_t>(event_FIX_M));
      WaitFlag<HardEvent::FIX_M>(static_cast<event_t>(event_FIX_M));
    }
    MmadParams mp;
    mp.m = mr; mp.n = nr; mp.k = kr; mp.cmatrixInitVal = true;
    Mmad(cc, ac, bc, mp);
    SetFlag<HardEvent::M_FIX>(static_cast<event_t>(event_M_FIX));
    WaitFlag<HardEvent::M_FIX>(static_cast<event_t>(event_M_FIX));
    FixpipeParamsV220 fp;
    fp.nSize = cols; fp.mSize = rows; fp.srcStride = mr; fp.dstStride = TN;
    Fixpipe(c, cc, fp);
    cached_b = bptr; cached_b_meta = bmeta;
    cached_b_cols = cols; cached_b_depth = depth;
    previous = true;
  }
};
template<int TM, int TN, bool NORMAL, bool DIRECT, typename CALLBACK>
struct CubeSelect {
  using Type = typename MatmulSelect<NORMAL, CALLBACK>::Type;
};
template<int TM, int TN, bool NORMAL, typename CALLBACK>
struct CubeSelect<TM, TN, NORMAL, true, CALLBACK> {
  using Type = DirectSingleMatmul<TM, TN>;
};
__aicore__ inline int AdvanceTaskBase(int base,int count,int cores)
{
  const int sum=base+count;
  if(sum<cores)return sum;
  return count<cores?sum-cores:sum%cores;
}
__aicore__ inline void TileCoordinates(int task,int nc,int& mr,int& nr)
{
  if(nc==1){mr=task;nr=0;}
  else if(nc==2){mr=task>>1;nr=task&1;}
  else {mr=task/nc;nr=task-mr*nc;}
}
__aicore__ inline void GeluBounded(LocalTensor<float> z,LocalTensor<float> t,int count)
{
  const BinaryRepeatParams binary{1,1,1,8,8,8};
  const UnaryRepeatParams unary{1,1,8,8};
  for(int offset=0;offset<count;){
    const int remaining=count-offset;
    const int full=remaining/64;
    const uint8_t repeats=(uint8_t)(full>255?255:(full>0?full:1));
    const uint64_t mask=full>0?64:(uint64_t)remaining;
    auto a=z[offset];auto b=t[offset];
    Mul(b,a,a,mask,repeats,binary);PipeBarrier<PIPE_V>();
    Muls(b,b,-0.07135481627260025f,mask,repeats,unary);PipeBarrier<PIPE_V>();
    Adds(b,b,-1.5957691216057308f,mask,repeats,unary);PipeBarrier<PIPE_V>();
    Mul(b,b,a,mask,repeats,binary);PipeBarrier<PIPE_V>();
    Maxs(b,b,-87.0f,mask,repeats,unary);PipeBarrier<PIPE_V>();
    Mins(b,b,87.0f,mask,repeats,unary);PipeBarrier<PIPE_V>();
    Exp(b,b,mask,repeats,unary);PipeBarrier<PIPE_V>();
    Adds(b,b,1.0f,mask,repeats,unary);PipeBarrier<PIPE_V>();
    Div(a,a,b,mask,repeats,binary);PipeBarrier<PIPE_V>();
    offset+=full>0?(int)repeats*64:(int)mask;
  }
}
template<int TM, int TN, bool PADDED, bool TRANSPORT, bool USE_NORMAL = false, bool USE_DIRECT = false>
__global__ __mix__(1, 2) void Compute(
  GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groups,
  GM_ADDR y, GM_ADDR workspace, int M, int N, int K, int E, TCubeTiling tiling)
{
  InitSocState();
  GlobalTensor<int8_t> ag, bg;
  GlobalTensor<int64_t> gg;
  GlobalTensor<int32_t> cg;
  GlobalTensor<float> sg;
  GlobalTensor<half> yg;
  ag.SetGlobalBuffer((__gm__ int8_t*)x);
  bg.SetGlobalBuffer((__gm__ int8_t*)weight);
  gg.SetGlobalBuffer((__gm__ int64_t*)groups);
  cg.SetGlobalBuffer((__gm__ int32_t*)workspace);
  sg.SetGlobalBuffer((__gm__ float*)scale);
  yg.SetGlobalBuffer((__gm__ half*)y);
  const int ka = PADDED ? (K + 31) / 32 * 32 : K;
  const int nb = PADDED ? (N + 31) / 32 * 32 : N;
  if constexpr (PADDED) {
    auto base = workspace + (int64_t)GetBlockNum() * 2 * TM * TN * sizeof(int32_t);
    GlobalTensor<int8_t> ap, bp;
    ap.SetGlobalBuffer((__gm__ int8_t*)base);
    bp.SetGlobalBuffer((__gm__ int8_t*)(base + (ka != K ? (int64_t)M * ka : 0)));
    if ASCEND_IS_AIV {
      if (ka != K) PadRows(ap, ag, M, K, ka);
      if (nb != N) PadRows(bp, bg, (int64_t)E * K, N, nb);
    }
    SyncAll<false>();
    if (ka != K) ag = ap;
    if (nb != N) bg = bp;
  }
  const int nc = (N + TN - 1) / TN;
  const int cores = GetBlockNum();
  const bool shardExperts = M!=1 && E >= 2 * cores && N <= 512 && K <= 512;
  if ASCEND_IS_AIC {
    TPipe pipe;
    typename CubeSelect<TM,TN,USE_NORMAL,USE_DIRECT,typename TransportCallback<TRANSPORT>::Type>::Type mm;
    mm.SetSubBlockIdx(0);
    mm.Init(&tiling, &pipe);
    mm.SetOrgShape(M, TRANSPORT ? (N+31)/32*32 : nb, ka, K, TN);
    uint64_t meta=0;
    if constexpr (TRANSPORT || USE_DIRECT)
      meta=(uint64_t)ka|((uint64_t)nb<<14)|((uint64_t)K<<27)
        |((uint64_t)(tiling.baseM/16)<<41)|((uint64_t)(tiling.baseN/32)<<45)
        |((uint64_t)(tiling.baseK/32)<<50)|((uint64_t)PADDED<<56);
    int taskBase = 0;
    int start = 0;
    int produced = 0;
    const int eFirst = M==1 ? SingleRowExpert(gg,E) : (shardExperts ? GetBlockIdx() : 0);
    const int eStep = M==1 ? E : (shardExperts ? cores : 1);
    for (int e = eFirst; e < E; e += eStep) {
      if (shardExperts) start = e == 0 ? 0 : (int)gg.GetValue(e - 1);
      int end = (int)gg.GetValue(e);
      int tiles = ((end - start + TM - 1) / TM) * nc;
      if(tiles==0){start=end;continue;}
      int first = shardExperts ? 0 : GetBlockIdx()-taskBase;
      if(first<0)first+=cores;
      const int taskStep = shardExperts ? 1 : cores;
      for (int task = first; task < tiles; task += taskStep) {
        const int slot = produced & 1;
        if (produced >= 2) CrossCoreWaitFlag<2>(1 + 2 * slot);
        int mr,nr;TileCoordinates(task,nc,mr,nr);
        int row = start + mr * TM;
        int col = nr * TN;
        int rows = end - row < TM ? end - row : TM;
        int cols = N - col < TN ? N - col : TN;
        if constexpr (TRANSPORT || USE_DIRECT) {
          mm.SetSelfDefineData(meta|((uint64_t)(e==E-1 && nb==N)<<55)
            |((uint64_t)(col/128)<<57)|((uint64_t)(row+rows==M)<<62));
        }
        mm.SetSingleShape(rows, TRANSPORT ? (cols+31)/32*32 : cols, K);
        mm.SetTensorA(ag[(int64_t)row * ka], false);
        mm.SetTensorB(bg[(int64_t)e * K * nb + col], false);
        mm.IterateAll(cg[((int64_t)GetBlockIdx() * 2 + slot) * TM * TN], false);
        CrossCoreSetFlag<2, PIPE_FIX>(2 * slot);
        ++produced;
      }
      if(!shardExperts)taskBase=AdvanceTaskBase(taskBase,tiles,cores);
      start = end;
    }
    if (produced > 1) CrossCoreWaitFlag<2>(1 + 2 * ((produced - 2) & 1));
    if (produced > 0) CrossCoreWaitFlag<2>(1 + 2 * ((produced - 1) & 1));
    mm.End();
  }
  if ASCEND_IS_AIV {
    const int core = GetBlockIdx() / 2;
    const int sub = GetBlockIdx() % 2;
    constexpr int VCOLS = TN / 2;
    constexpr int VCOUNT = TM * VCOLS;
    TPipe pipe;
    TQue<TPosition::VECIN, 1> cq, sq;
    TQue<TPosition::VECOUT, 1> oq;
    TBuf<TPosition::VECCALC> tb;
    pipe.InitBuffer(cq, 1, VCOUNT * sizeof(int32_t));
    pipe.InitBuffer(sq, 1, VCOLS * sizeof(float));
    pipe.InitBuffer(oq, 1, VCOUNT * sizeof(half));
    pipe.InitBuffer(tb, VCOUNT * sizeof(float));
    auto t = tb.Get<float>();
    int consumed = 0;
    int taskBase = 0;
    int start = 0;
    const int eFirst = M==1 ? SingleRowExpert(gg,E) : (shardExperts ? core : 0);
    const int eStep = M==1 ? E : (shardExperts ? cores : 1);
    for (int e = eFirst; e < E; e += eStep) {
      if (shardExperts) start = e == 0 ? 0 : (int)gg.GetValue(e - 1);
      int end = (int)gg.GetValue(e);
      int tiles = ((end - start + TM - 1) / TM) * nc;
      if(tiles==0){start=end;continue;}
      int first = shardExperts ? 0 : core-taskBase;
      if(first<0)first+=cores;
      const int taskStep = shardExperts ? 1 : cores;
      for (int task = first; task < tiles; task += taskStep) {
        int mr,nr;TileCoordinates(task,nc,mr,nr);
        int row = start + mr * TM;
        int col = nr * TN + sub * VCOLS;
        int rows = end - row < TM ? end - row : TM;
        int cols = N - col < VCOLS ? N - col : VCOLS;
        const int slot = consumed & 1;
        CrossCoreWaitFlag<2>(2 * slot);
        if (rows > 0 && cols > 0) {
          auto c = cq.AllocTensor<int32_t>();
          auto s = sq.AllocTensor<float>();
          DataCopyPad(c, cg[((int64_t)core * 2 + slot) * TM * TN + sub * VCOLS],
            DataCopyExtParams{(uint16_t)rows, (uint32_t)(cols * 4),
              (uint32_t)((TN - cols) * 4), (uint32_t)((VCOLS - (cols + 7) / 8 * 8) / 8), 0},
            DataCopyPadExtParams<int32_t>{true, 0, 0, 0});
          DataCopyPad(s, sg[(int64_t)e * N + col],
            DataCopyExtParams{1, (uint32_t)(cols * 4), 0, 0, 0},
            DataCopyPadExtParams<float>{true, 0, 0, 0.0f});
          cq.EnQue(c);
          sq.EnQue(s);
          c = cq.DeQue<int32_t>();
          s = sq.DeQue<float>();
          CrossCoreSetFlag<2, PIPE_MTE2>(1 + 2 * slot);
          auto z = c.ReinterpretCast<float>();
          Cast(z, c, RoundMode::CAST_RINT, rows * VCOLS);
          PipeBarrier<PIPE_V>();
          if constexpr (TM > 255) {
            for(int r0=0;r0<rows;r0+=255){
              const uint8_t repeats=(uint8_t)(rows-r0<255?rows-r0:255);
              for(int c0=0;c0<VCOLS;c0+=64)
                Mul(z[r0*VCOLS+c0],z[r0*VCOLS+c0],s[c0],(uint64_t)64,repeats,
                  BinaryRepeatParams{1,1,1,VCOLS/8,VCOLS/8,0});
            }
          } else {
            for (int c0 = 0; c0 < VCOLS; c0 += 64)
              Mul(z[c0], z[c0], s[c0], (uint64_t)64, (uint8_t)rows,
                BinaryRepeatParams{1, 1, 1, VCOLS / 8, VCOLS / 8, 0});
          }
          PipeBarrier<PIPE_V>();
          GeluBounded(z,t,rows*VCOLS);
          auto out = oq.AllocTensor<half>();
          Cast(out, z, RoundMode::CAST_RINT, rows * VCOLS);
          oq.EnQue(out);
          out = oq.DeQue<half>();
          DataCopyPad(yg[(int64_t)row * N + col], out,
            DataCopyExtParams{(uint16_t)rows, (uint32_t)(cols * 2),
              (uint32_t)((VCOLS - (cols + 15) / 16 * 16) / 16),
              (uint32_t)((N - cols) * 2), 0});
          oq.FreeTensor(out);
          sq.FreeTensor(s);
          cq.FreeTensor(c);
        } else {
          CrossCoreSetFlag<2, PIPE_MTE2>(1 + 2 * slot);
        }
        ++consumed;
      }
      if(!shardExperts)taskBase=AdvanceTaskBase(taskBase,tiles,cores);
      start = end;
    }
  }
}
__aicore__ inline int FindExpert(GlobalTensor<int64_t> gg,int row,int M,int E,int& end)
{
  const int guess=row*E/M;
  end=(int)gg.GetValue(guess);
  const int start=guess==0?0:(int)gg.GetValue(guess-1);
  if(start<=row && row<end)return guess;
  int lo=row>=end?guess+1:0;
  int hi=row>=end?E-1:guess-1;
  while(lo<hi){
    const int mid=(lo+hi)/2;
    if(row<(int)gg.GetValue(mid))hi=mid;
    else lo=mid+1;
  }
  end=(int)gg.GetValue(lo);
  return lo;
}
__aicore__ inline bool NeedsSchedulePlan(GlobalTensor<int64_t> gg,int M,int N,int K,int E,int cores)
{
  const int first=(int)gg.GetValue(0);
  const int last=M-(int)gg.GetValue(E-2);
  const int largest=first>last?first:last;
  return (first==0 && last==0) || largest*cores>2*M
    || (first+last)*E*4<M
    || ((first==0 || last==0) && (K*N>=65536 || K%32 || N%32));
}
template<int TM,int TN>
__aicore__ inline int ChooseSchedule(GM_ADDR groups,GlobalTensor<int32_t> record,
  int M,int N,int E,int cores)
{
  TPipe pipe;
  TBuf<TPosition::VECCALC> gb,hb,ob;
  pipe.InitBuffer(gb,128*8);
  pipe.InitBuffer(hb,64*4);
  pipe.InitBuffer(ob,32);
  auto g=gb.Get<int32_t>();
  auto h=hb.Get<int32_t>();
  auto out=ob.Get<int32_t>();
  GlobalTensor<int32_t> gg;
  gg.SetGlobalBuffer((__gm__ int32_t*)groups);
  DataCopyPad(g,gg,DataCopyExtParams{1,(uint32_t)(E*8),0,0,0},
    DataCopyPadExtParams<int32_t>{true,0,0,0});
  SetFlag<HardEvent::MTE2_S>(EVENT_ID0);
  WaitFlag<HardEvent::MTE2_S>(EVENT_ID0);
  const int nc=(N+TN-1)/TN;
  const int stripes=(M+TM-1)/TM*nc;
  for(int c=0;c<cores;++c){
    h.SetValue(c,0);
    h.SetValue(32+c,(stripes+cores-1-c)/cores);
  }
  int start=0,total=0,owner=0;
  for(int e=0;e<E;++e){
    const int end=g.GetValue(2*e);
    const int tasks=(end-start+TM-1)/TM*nc;
    h.SetValue(owner,h.GetValue(owner)+tasks);
    if(++owner==cores)owner=0;
    total+=tasks;
    if(end>start && start>0 && start%TM){
      const int tile=start/TM*nc;
      for(int col=0;col<nc;++col){
        const int c=(tile+col)%cores;
        h.SetValue(32+c,h.GetValue(32+c)+1);
      }
    }
    start=end;
  }
  int maxExpert=0,maxStripe=0;
  for(int c=0;c<cores;++c){
    const int a=h.GetValue(c),b=h.GetValue(32+c);
    if(a>maxExpert)maxExpert=a;
    if(b>maxStripe)maxStripe=b;
  }
  int mode=maxStripe<maxExpert?1:0;
  const int best=mode?maxStripe:maxExpert;
  const int ideal=(total+cores-1)/cores;
  if(best>ideal+(E+15)/16)mode=2;
  for(int i=0;i<8;++i)out.SetValue(i,mode);
  SetFlag<HardEvent::S_MTE3>(EVENT_ID0);
  WaitFlag<HardEvent::S_MTE3>(EVENT_ID0);
  DataCopy(record,out,8);
  CrossCoreSetFlag<2,PIPE_MTE3>(4);
  SetFlag<HardEvent::MTE3_S>(EVENT_ID0);
  WaitFlag<HardEvent::MTE3_S>(EVENT_ID0);
  return mode;
}
struct ScheduledTile {int expert,row,col,rows,cols;};
template<int TM,int TN>
class TaskSchedule {
  GlobalTensor<int64_t> gg_;
  int M_,N_,E_,cores_,core_,mode_,nc_;
  int e_,start_,end_,tiles_,next_,base_;
  int stripe_,stripeCount_,row_,limit_;
  __aicore__ inline void LoadExpert()
  {
    if(mode_==0)start_=e_==0?0:(int)gg_.GetValue(e_-1);
    end_=(int)gg_.GetValue(e_);
    tiles_=(end_-start_+TM-1)/TM*nc_;
    next_=mode_==0?0:core_-base_;
    if(next_<0)next_+=cores_;
  }
  __aicore__ inline void LoadStripe()
  {
    int mr,nr;TileCoordinates(stripe_,nc_,mr,nr);
    row_=mr*TM;
    limit_=row_+TM<M_?row_+TM:M_;
  }
public:
  __aicore__ inline TaskSchedule(GlobalTensor<int64_t> gg,int M,int N,int E,
    int cores,int core,int mode):gg_(gg),M_(M),N_(N),E_(E),cores_(cores),
    core_(core),mode_(mode),nc_((N+TN-1)/TN),e_(mode==0?core:0),
    start_(0),end_(0),tiles_(0),next_(0),base_(0),stripe_(core),
    stripeCount_((M+TM-1)/TM*nc_),row_(0),limit_(0)
  {
    if(mode_==1)LoadStripe();
    else if(e_<E_)LoadExpert();
  }
  __aicore__ inline bool Next(ScheduledTile& t)
  {
    if(mode_==1){
      if(row_>=limit_){stripe_+=cores_;LoadStripe();}
      if(stripe_>=stripeCount_)return false;
      int end;
      t.expert=FindExpert(gg_,row_,M_,E_,end);
      int mr,nr;TileCoordinates(stripe_,nc_,mr,nr);
      t.row=row_;t.col=nr*TN;
      t.rows=(end<limit_?end:limit_)-row_;
      t.cols=N_-t.col<TN?N_-t.col:TN;
      row_+=t.rows;
      return true;
    }
    while(e_<E_){
      if(next_<tiles_){
        int mr,nr;TileCoordinates(next_,nc_,mr,nr);
        t.expert=e_;t.row=start_+mr*TM;t.col=nr*TN;
        t.rows=end_-t.row<TM?end_-t.row:TM;
        t.cols=N_-t.col<TN?N_-t.col:TN;
        next_+=mode_==0?1:cores_;
        return true;
      }
      if(mode_!=0)base_=AdvanceTaskBase(base_,tiles_,cores_);
      start_=end_;e_+=mode_==0?cores_:1;
      if(e_<E_)LoadExpert();
    }
    return false;
  }
};template<int TM, int TN, int FIXED_K = 0, bool FULL_ROWS = false>
__global__ __mix__(1, 2) void ComputeAlignedUnitReady(
  GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groups,
  GM_ADDR y, GM_ADDR workspace, int M, int actualN, int actualK)
{
  const int N = FIXED_K ? TN : actualN;
  const int K = FIXED_K ? FIXED_K : actualK;
  constexpr int e=0;
  InitSocState();
  GlobalTensor<int8_t> ag,bg;
  GlobalTensor<int64_t> gg;
  GlobalTensor<int32_t> cg;
  GlobalTensor<float> sg;
  GlobalTensor<half> yg;
  ag.SetGlobalBuffer((__gm__ int8_t*)x);bg.SetGlobalBuffer((__gm__ int8_t*)weight);
  gg.SetGlobalBuffer((__gm__ int64_t*)groups);cg.SetGlobalBuffer((__gm__ int32_t*)workspace);
  sg.SetGlobalBuffer((__gm__ float*)scale);yg.SetGlobalBuffer((__gm__ half*)y);
  const int end=M;
  constexpr int nc=1;
  if ASCEND_IS_AIC {
    static_assert(TM == 16 && TN == 128);
    constexpr int CK = 65536 / TN;
    const int core = GetBlockIdx();
    const int row = core * TM;
    const int rows = FULL_ROWS ? TM : (M - row < TM ? M - row : TM);
    LocalTensor<int8_t> al(TPosition::A1, 0, TM * CK);
    LocalTensor<int8_t> bl(TPosition::B1, TM * CK, CK * TN);
    LocalTensor<int8_t> ac(TPosition::A2, 0, TM * CK);
    LocalTensor<int8_t> bc(TPosition::B2, 0, CK * TN);
    LocalTensor<int32_t> cc(TPosition::CO1, 0, TM * TN);
    constexpr event_t copyReady = EVENT_ID3;
    constexpr event_t loadReady = EVENT_ID3;
    constexpr event_t cubeReady = EVENT_ID3;
    GlobalTensor<int32_t> aw, bw;
    aw.SetGlobalBuffer((__gm__ int32_t*)(x + (int64_t)row * K));
    bw.SetGlobalBuffer((__gm__ int32_t*)weight);
    DataCopy(bl.ReinterpretCast<int32_t>(), bw,
      Nd2NzParams{1, (uint16_t)K, (uint16_t)(N / 4), 0,
        (uint16_t)(N / 4), (uint16_t)K, 1, 0});
    SetFlag<HardEvent::MTE2_MTE1>(static_cast<event_t>(copyReady));
    WaitFlag<HardEvent::MTE2_MTE1>(static_cast<event_t>(copyReady));
    LoadData2dTransposeParams lb{0, (uint8_t)(N / 32), (uint16_t)(K / 32), 1, 0};
    #pragma unroll
    for (int ki = 0; ki < K; ki += 32)
      LoadDataWithTranspose(bc[ki * N], bl[ki * 32], lb);
    DataCopy(al.ReinterpretCast<int32_t>(), aw,
      Nd2NzParams{1, (uint16_t)rows, (uint16_t)(K / 4), 0,
        (uint16_t)(K / 4), (uint16_t)TM, 1, 0});
    SetFlag<HardEvent::MTE2_MTE1>(EVENT_ID2);
    WaitFlag<HardEvent::MTE2_MTE1>(EVENT_ID2);
    LoadData2DParams la;
    la.repeatTimes=K/32;la.srcStride=1;la.dstGap=0;la.ifTranspose=false;
    LoadData(ac,al,la);
    SetFlag<HardEvent::MTE1_M>(static_cast<event_t>(loadReady));
    WaitFlag<HardEvent::MTE1_M>(static_cast<event_t>(loadReady));
    MmadParams mp;
    mp.m = TM; mp.n = N; mp.k = K; mp.cmatrixInitVal = true;
    if constexpr(FULL_ROWS){SetMMRowMajor();mp.unitFlag=3;}
    Mmad(cc, ac, bc, mp);
    if constexpr(!FULL_ROWS){
      SetFlag<HardEvent::M_FIX>(static_cast<event_t>(cubeReady));
      WaitFlag<HardEvent::M_FIX>(static_cast<event_t>(cubeReady));
    }
    FixpipeParamsV220 fp;
    fp.nSize = N; fp.mSize = rows; fp.srcStride = TM; fp.dstStride = TN;
    fp.unitFlag=FULL_ROWS?3:0;
    Fixpipe(cg[(int64_t)core * TM * TN], cc, fp);
    CrossCoreSetFlag<2, PIPE_FIX>(0);
    PipeBarrier<PIPE_ALL>();
    if constexpr(FULL_ROWS)SetMMColumnMajor();
  }
  if ASCEND_IS_AIV {
    const int core = GetBlockIdx() / 2, sub = GetBlockIdx() % 2;
    constexpr int VROWS = TM / 2, VCOLS = TN, VCOUNT = VROWS * VCOLS;
    const int row = core * TM + sub * VROWS, col = 0;
    const int rows = FULL_ROWS ? VROWS : (M - row < VROWS ? M - row : VROWS);
    const int cols = N - col < VCOLS ? N - col : VCOLS;
    LocalTensor<int32_t> c(TPosition::VECIN, 0, VCOUNT);
    LocalTensor<float> s(TPosition::VECIN, VCOUNT * sizeof(int32_t), VCOLS);
    LocalTensor<float> t(TPosition::VECCALC, (VCOUNT + VCOLS) * sizeof(float), VCOUNT);
    LocalTensor<half> out(TPosition::VECOUT, (2 * VCOUNT + VCOLS) * sizeof(float), VCOUNT);
    constexpr event_t inputReady = EVENT_ID3;
    constexpr event_t outputReady = EVENT_ID3;
    if (rows > 0 && cols > 0) {
      DataCopy(s,sg[col],VCOLS);
    }
    CrossCoreWaitFlag<2>(0);
    if (rows > 0 && cols > 0) {
      DataCopy(c,cg[(int64_t)row*TN],rows*TN);
      SetFlag<HardEvent::MTE2_V>(static_cast<event_t>(inputReady));
      WaitFlag<HardEvent::MTE2_V>(static_cast<event_t>(inputReady));
      auto z = c.ReinterpretCast<float>();
      SetVectorMask<float,MaskMode::NORMAL>(64);
      const uint8_t vectorRepeats=(uint8_t)(rows*VCOLS/64);
      Cast<float,int32_t,false>(z,c,RoundMode::CAST_RINT,MASK_PLACEHOLDER,
        vectorRepeats,UnaryRepeatParams{1,1,8,8});
      PipeBarrier<PIPE_V>();
      for (int c0 = 0; c0 < VCOLS; c0 += 64)
        Mul<float,false>(z[c0], z[c0], s[c0], MASK_PLACEHOLDER, (uint8_t)rows,
          BinaryRepeatParams{1, 1, 1, VCOLS / 8, VCOLS / 8, 0});
      PipeBarrier<PIPE_V>();
      const BinaryRepeatParams binary{1,1,1,8,8,8};
      const UnaryRepeatParams unary{1,1,8,8};
      Mul<float,false>(t,z,z,MASK_PLACEHOLDER,vectorRepeats,binary);PipeBarrier<PIPE_V>();
      Muls<float,false>(t,t,-0.07135481627260025f,MASK_PLACEHOLDER,vectorRepeats,unary);PipeBarrier<PIPE_V>();
      Adds<float,false>(t,t,-1.5957691216057308f,MASK_PLACEHOLDER,vectorRepeats,unary);PipeBarrier<PIPE_V>();
      Mul<float,false>(t,t,z,MASK_PLACEHOLDER,vectorRepeats,binary);PipeBarrier<PIPE_V>();
      Exp<float,false>(t,t,MASK_PLACEHOLDER,vectorRepeats,unary);PipeBarrier<PIPE_V>();
      Adds<float,false>(t,t,1.0f,MASK_PLACEHOLDER,vectorRepeats,unary);PipeBarrier<PIPE_V>();
      Div<float,false>(z,z,t,MASK_PLACEHOLDER,vectorRepeats,binary);PipeBarrier<PIPE_V>();
      Cast<half,float,false>(out,z,RoundMode::CAST_RINT,MASK_PLACEHOLDER,
        vectorRepeats,UnaryRepeatParams{1,1,4,8});
      PipeBarrier<PIPE_V>();
      ResetMask();
      SetFlag<HardEvent::V_MTE3>(static_cast<event_t>(outputReady));
      WaitFlag<HardEvent::V_MTE3>(static_cast<event_t>(outputReady));
      DataCopy(yg[(int64_t)row*TN],out,rows*TN);
    }
    PipeBarrier<PIPE_ALL>();
  }
}
template<int TM, int TN, int FIXED_K = 0, bool FULL_ROWS = false>
__global__ __mix__(1, 2) void ComputeAlignedRowSplit(
  GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groups,
  GM_ADDR y, GM_ADDR workspace, int M, int actualN, int actualK)
{
  const int N = FIXED_K ? TN : actualN;
  const int K = FIXED_K ? FIXED_K : actualK;
  constexpr int e=0;
  InitSocState();
  GlobalTensor<int8_t> ag,bg;
  GlobalTensor<int64_t> gg;
  GlobalTensor<int32_t> cg;
  GlobalTensor<float> sg;
  GlobalTensor<half> yg;
  ag.SetGlobalBuffer((__gm__ int8_t*)x);bg.SetGlobalBuffer((__gm__ int8_t*)weight);
  gg.SetGlobalBuffer((__gm__ int64_t*)groups);cg.SetGlobalBuffer((__gm__ int32_t*)workspace);
  sg.SetGlobalBuffer((__gm__ float*)scale);yg.SetGlobalBuffer((__gm__ half*)y);
  const int end=M;
  constexpr int nc=1;
  if ASCEND_IS_AIC {
    static_assert(TM == 16 && TN == 128);
    constexpr int CK = 65536 / TN;
    const int core = GetBlockIdx();
    const int row = core * TM;
    const int rows = FULL_ROWS ? TM : (M - row < TM ? M - row : TM);
    LocalTensor<int8_t> al(TPosition::A1, 0, TM * CK);
    LocalTensor<int8_t> bl(TPosition::B1, TM * CK, CK * TN);
    LocalTensor<int8_t> ac(TPosition::A2, 0, TM * CK);
    LocalTensor<int8_t> bc(TPosition::B2, 0, CK * TN);
    LocalTensor<int32_t> cc(TPosition::CO1, 0, TM * TN);
    constexpr event_t copyReady = EVENT_ID3;
    constexpr event_t loadReady = EVENT_ID3;
    constexpr event_t cubeReady = EVENT_ID3;
    GlobalTensor<int32_t> aw, bw;
    aw.SetGlobalBuffer((__gm__ int32_t*)(x + (int64_t)row * K));
    bw.SetGlobalBuffer((__gm__ int32_t*)weight);
    DataCopy(bl.ReinterpretCast<int32_t>(), bw,
      Nd2NzParams{1, (uint16_t)K, (uint16_t)(N / 4), 0,
        (uint16_t)(N / 4), (uint16_t)K, 1, 0});
    SetFlag<HardEvent::MTE2_MTE1>(static_cast<event_t>(copyReady));
    WaitFlag<HardEvent::MTE2_MTE1>(static_cast<event_t>(copyReady));
    LoadData2dTransposeParams lb{0, (uint8_t)(N / 32), (uint16_t)(K / 32), 1, 0};
    #pragma unroll
    for (int ki = 0; ki < K; ki += 32)
      LoadDataWithTranspose(bc[ki * N], bl[ki * 32], lb);
    DataCopy(al.ReinterpretCast<int32_t>(), aw,
      Nd2NzParams{1, (uint16_t)rows, (uint16_t)(K / 4), 0,
        (uint16_t)(K / 4), (uint16_t)TM, 1, 0});
    SetFlag<HardEvent::MTE2_MTE1>(EVENT_ID2);
    WaitFlag<HardEvent::MTE2_MTE1>(EVENT_ID2);
    LoadData2DParams la;
    la.repeatTimes=K/32;la.srcStride=1;la.dstGap=0;la.ifTranspose=false;
    LoadData(ac,al,la);
    SetFlag<HardEvent::MTE1_M>(static_cast<event_t>(loadReady));
    WaitFlag<HardEvent::MTE1_M>(static_cast<event_t>(loadReady));
    MmadParams mp;
    mp.m = TM; mp.n = N; mp.k = K; mp.cmatrixInitVal = true;
    Mmad(cc, ac, bc, mp);
    SetFlag<HardEvent::M_FIX>(static_cast<event_t>(cubeReady));
    WaitFlag<HardEvent::M_FIX>(static_cast<event_t>(cubeReady));
    FixpipeParamsV220 fp;
    fp.nSize = N; fp.mSize = rows; fp.srcStride = TM; fp.dstStride = TN;
    Fixpipe(cg[(int64_t)core * TM * TN], cc, fp);
    CrossCoreSetFlag<2, PIPE_FIX>(0);
    PipeBarrier<PIPE_ALL>();
  }
  if ASCEND_IS_AIV {
    const int core = GetBlockIdx() / 2, sub = GetBlockIdx() % 2;
    constexpr int VROWS = TM / 2, VCOLS = TN, VCOUNT = VROWS * VCOLS;
    const int row = core * TM + sub * VROWS, col = 0;
    const int rows = FULL_ROWS ? VROWS : (M - row < VROWS ? M - row : VROWS);
    const int cols = N - col < VCOLS ? N - col : VCOLS;
    LocalTensor<int32_t> c(TPosition::VECIN, 0, VCOUNT);
    LocalTensor<float> s(TPosition::VECIN, VCOUNT * sizeof(int32_t), VCOLS);
    LocalTensor<float> t(TPosition::VECCALC, (VCOUNT + VCOLS) * sizeof(float), VCOUNT);
    LocalTensor<half> out(TPosition::VECOUT, (2 * VCOUNT + VCOLS) * sizeof(float), VCOUNT);
    constexpr event_t inputReady = EVENT_ID3;
    constexpr event_t outputReady = EVENT_ID3;
    if (rows > 0 && cols > 0) {
      DataCopy(s,sg[col],VCOLS);
    }
    CrossCoreWaitFlag<2>(0);
    if (rows > 0 && cols > 0) {
      DataCopy(c,cg[(int64_t)row*TN],rows*TN);
      SetFlag<HardEvent::MTE2_V>(static_cast<event_t>(inputReady));
      WaitFlag<HardEvent::MTE2_V>(static_cast<event_t>(inputReady));
      auto z = c.ReinterpretCast<float>();
      SetVectorMask<float,MaskMode::NORMAL>(64);
      const uint8_t vectorRepeats=(uint8_t)(rows*VCOLS/64);
      Cast<float,int32_t,false>(z,c,RoundMode::CAST_RINT,MASK_PLACEHOLDER,
        vectorRepeats,UnaryRepeatParams{1,1,8,8});
      PipeBarrier<PIPE_V>();
      for (int c0 = 0; c0 < VCOLS; c0 += 64)
        Mul<float,false>(z[c0], z[c0], s[c0], MASK_PLACEHOLDER, (uint8_t)rows,
          BinaryRepeatParams{1, 1, 1, VCOLS / 8, VCOLS / 8, 0});
      PipeBarrier<PIPE_V>();
      const BinaryRepeatParams binary{1,1,1,8,8,8};
      const UnaryRepeatParams unary{1,1,8,8};
      Mul<float,false>(t,z,z,MASK_PLACEHOLDER,vectorRepeats,binary);PipeBarrier<PIPE_V>();
      Muls<float,false>(t,t,-0.07135481627260025f,MASK_PLACEHOLDER,vectorRepeats,unary);PipeBarrier<PIPE_V>();
      Adds<float,false>(t,t,-1.5957691216057308f,MASK_PLACEHOLDER,vectorRepeats,unary);PipeBarrier<PIPE_V>();
      Mul<float,false>(t,t,z,MASK_PLACEHOLDER,vectorRepeats,binary);PipeBarrier<PIPE_V>();
      Exp<float,false>(t,t,MASK_PLACEHOLDER,vectorRepeats,unary);PipeBarrier<PIPE_V>();
      Adds<float,false>(t,t,1.0f,MASK_PLACEHOLDER,vectorRepeats,unary);PipeBarrier<PIPE_V>();
      Div<float,false>(z,z,t,MASK_PLACEHOLDER,vectorRepeats,binary);PipeBarrier<PIPE_V>();
      Cast<half,float,false>(out,z,RoundMode::CAST_RINT,MASK_PLACEHOLDER,
        vectorRepeats,UnaryRepeatParams{1,1,4,8});
      PipeBarrier<PIPE_V>();
      ResetMask();
      SetFlag<HardEvent::V_MTE3>(static_cast<event_t>(outputReady));
      WaitFlag<HardEvent::V_MTE3>(static_cast<event_t>(outputReady));
      DataCopy(yg[(int64_t)row*TN],out,rows*TN);
    }
    PipeBarrier<PIPE_ALL>();
  }
}
template<int TM, int TN, int FIXED_K = 0, bool FULL_ROWS = false>
__global__ __mix__(1, 2) void ComputeAlignedOneWave(
  GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groups,
  GM_ADDR y, GM_ADDR workspace, int M, int actualN, int actualK)
{
  const int N = FIXED_K ? TN : actualN;
  const int K = FIXED_K ? FIXED_K : actualK;
  constexpr int e=0;
  InitSocState();
  GlobalTensor<int8_t> ag,bg;
  GlobalTensor<int64_t> gg;
  GlobalTensor<int32_t> cg;
  GlobalTensor<float> sg;
  GlobalTensor<half> yg;
  ag.SetGlobalBuffer((__gm__ int8_t*)x);bg.SetGlobalBuffer((__gm__ int8_t*)weight);
  gg.SetGlobalBuffer((__gm__ int64_t*)groups);cg.SetGlobalBuffer((__gm__ int32_t*)workspace);
  sg.SetGlobalBuffer((__gm__ float*)scale);yg.SetGlobalBuffer((__gm__ half*)y);
  const int end=M;
  constexpr int nc=1;
  if ASCEND_IS_AIC {
    static_assert(TM == 16 && TN == 128);
    constexpr int CK = 65536 / TN;
    const int core = GetBlockIdx();
    const int row = core * TM;
    const int rows = FULL_ROWS ? TM : (M - row < TM ? M - row : TM);
    LocalTensor<int8_t> al(TPosition::A1, 0, TM * CK);
    LocalTensor<int8_t> bl(TPosition::B1, TM * CK, CK * TN);
    LocalTensor<int8_t> ac(TPosition::A2, 0, TM * CK);
    LocalTensor<int8_t> bc(TPosition::B2, 0, CK * TN);
    LocalTensor<int32_t> cc(TPosition::CO1, 0, TM * TN);
    constexpr event_t copyReady = EVENT_ID3;
    constexpr event_t loadReady = EVENT_ID3;
    constexpr event_t cubeReady = EVENT_ID3;
    GlobalTensor<int32_t> aw, bw;
    aw.SetGlobalBuffer((__gm__ int32_t*)(x + (int64_t)row * K));
    bw.SetGlobalBuffer((__gm__ int32_t*)weight);
    DataCopy(al.ReinterpretCast<int32_t>(), aw,
      Nd2NzParams{1, (uint16_t)rows, (uint16_t)(K / 4), 0,
        (uint16_t)(K / 4), (uint16_t)TM, 1, 0});
    DataCopy(bl.ReinterpretCast<int32_t>(), bw,
      Nd2NzParams{1, (uint16_t)K, (uint16_t)(N / 4), 0,
        (uint16_t)(N / 4), (uint16_t)K, 1, 0});
    SetFlag<HardEvent::MTE2_MTE1>(static_cast<event_t>(copyReady));
    WaitFlag<HardEvent::MTE2_MTE1>(static_cast<event_t>(copyReady));
    const uint8_t pad[4] = {0, 0, 0, 0};
    SetFmatrix(1, TM, pad, FmatrixMode::FMATRIX_LEFT);
    LoadData3DParamsV2Pro la;
    la.channelSize = K;
    la.extConfig = ((uint64_t)TM << 16) | K;
    LoadData(ac, al, la);
    LoadData2dTransposeParams lb{0, (uint8_t)(N / 32), (uint16_t)(K / 32), 1, 0};
    #pragma unroll
    for (int ki = 0; ki < K; ki += 32)
      LoadDataWithTranspose(bc[ki * N], bl[ki * 32], lb);
    SetFlag<HardEvent::MTE1_M>(static_cast<event_t>(loadReady));
    WaitFlag<HardEvent::MTE1_M>(static_cast<event_t>(loadReady));
    MmadParams mp;
    mp.m = TM; mp.n = N; mp.k = K; mp.cmatrixInitVal = true;
    Mmad(cc, ac, bc, mp);
    SetFlag<HardEvent::M_FIX>(static_cast<event_t>(cubeReady));
    WaitFlag<HardEvent::M_FIX>(static_cast<event_t>(cubeReady));
    FixpipeParamsV220 fp;
    fp.nSize = N; fp.mSize = rows; fp.srcStride = TM; fp.dstStride = TN;
    Fixpipe(cg[(int64_t)core * TM * TN], cc, fp);
    CrossCoreSetFlag<2, PIPE_FIX>(0);
    PipeBarrier<PIPE_ALL>();
  }
  if ASCEND_IS_AIV {
    const int core = GetBlockIdx() / 2, sub = GetBlockIdx() % 2;
    constexpr int VCOLS = TN / 2, VCOUNT = TM * VCOLS;
    const int row = core * TM, col = sub * VCOLS;
    const int rows = FULL_ROWS ? TM : (M - row < TM ? M - row : TM);
    const int cols = N - col < VCOLS ? N - col : VCOLS;
    LocalTensor<int32_t> c(TPosition::VECIN, 0, VCOUNT);
    LocalTensor<float> s(TPosition::VECIN, VCOUNT * sizeof(int32_t), VCOLS);
    LocalTensor<float> t(TPosition::VECCALC, (VCOUNT + VCOLS) * sizeof(float), VCOUNT);
    LocalTensor<half> out(TPosition::VECOUT, (2 * VCOUNT + VCOLS) * sizeof(float), VCOUNT);
    constexpr event_t inputReady = EVENT_ID3;
    constexpr event_t outputReady = EVENT_ID3;
    if (rows > 0 && cols > 0) {
      if constexpr (FIXED_K > 0) DataCopy(s,sg[col],VCOLS);
      else {
      DataCopyPad(s, sg[col], DataCopyExtParams{1, (uint32_t)(cols * 4), 0, 0, 0},
        DataCopyPadExtParams<float>{true, 0, 0, 0.0f});
      }
    }
    CrossCoreWaitFlag<2>(0);
    if (rows > 0 && cols > 0) {
      if constexpr (FIXED_K > 0)
        DataCopy(c,cg[(int64_t)core*TM*TN+sub*VCOLS],
          DataCopyParams{(uint16_t)rows,VCOLS*4/32,(TN-VCOLS)*4/32,0});
      else {
      DataCopyPad(c, cg[(int64_t)core * TM * TN + sub * VCOLS],
        DataCopyExtParams{(uint16_t)rows, (uint32_t)(cols * 4),
          (uint32_t)((TN - cols) * 4), (uint32_t)((VCOLS - (cols + 7) / 8 * 8) / 8), 0},
        DataCopyPadExtParams<int32_t>{true, 0, 0, 0});
      }
      SetFlag<HardEvent::MTE2_V>(static_cast<event_t>(inputReady));
      WaitFlag<HardEvent::MTE2_V>(static_cast<event_t>(inputReady));
      auto z = c.ReinterpretCast<float>();
      Cast(z, c, RoundMode::CAST_RINT, rows * VCOLS);
      PipeBarrier<PIPE_V>();
      for (int c0 = 0; c0 < VCOLS; c0 += 64)
        Mul(z[c0], z[c0], s[c0], (uint64_t)64, (uint8_t)rows,
          BinaryRepeatParams{1, 1, 1, VCOLS / 8, VCOLS / 8, 0});
      PipeBarrier<PIPE_V>();
      GeluBounded(z, t, rows * VCOLS);
      Cast(out, z, RoundMode::CAST_RINT, rows * VCOLS);
      SetFlag<HardEvent::V_MTE3>(static_cast<event_t>(outputReady));
      WaitFlag<HardEvent::V_MTE3>(static_cast<event_t>(outputReady));
      if constexpr (FIXED_K > 0)
        DataCopy(yg[(int64_t)row*N+col],out,
          DataCopyParams{(uint16_t)rows,VCOLS*2/32,0,(TN-VCOLS)*2/32});
      else {
      DataCopyPad(yg[(int64_t)row * N + col], out,
        DataCopyExtParams{(uint16_t)rows, (uint32_t)(cols * 2),
          (uint32_t)((VCOLS - (cols + 15) / 16 * 16) / 16),
          (uint32_t)((N - cols) * 2), 0});
      }
    }
    PipeBarrier<PIPE_ALL>();
  }
}
__aicore__ inline void GeluExpertUnclamped(LocalTensor<float> z,LocalTensor<float> t,int count)
{
  const BinaryRepeatParams binary{1,1,1,8,8,8};
  const UnaryRepeatParams unary{1,1,8,8};
  for(int offset=0;offset<count;){
    const int remaining=count-offset;
    const int full=remaining/64;
    const uint8_t repeats=(uint8_t)(full>255?255:(full>0?full:1));
    const uint64_t mask=full>0?64:(uint64_t)remaining;
    auto a=z[offset];auto b=t[offset];
    Mul(b,a,a,mask,repeats,binary);PipeBarrier<PIPE_V>();
    Muls(b,b,-0.07135481627260025f,mask,repeats,unary);PipeBarrier<PIPE_V>();
    Adds(b,b,-1.5957691216057308f,mask,repeats,unary);PipeBarrier<PIPE_V>();
    Mul(b,b,a,mask,repeats,binary);PipeBarrier<PIPE_V>();
    Exp(b,b,mask,repeats,unary);PipeBarrier<PIPE_V>();
    Adds(b,b,1.0f,mask,repeats,unary);PipeBarrier<PIPE_V>();
    Div(a,a,b,mask,repeats,binary);PipeBarrier<PIPE_V>();
    offset+=full>0?(int)repeats*64:(int)mask;
  }
}
template<int BATCH>
class ManualExpertBatch {
  static constexpr int TM=64,TN=256,CK=256,ABYTES=TM*CK,BBYTES=TN*CK;
  static_assert(2*BATCH*(ABYTES+BBYTES)<=512*1024);
  static_assert(2*BATCH+2<=8);
  TBuf<TPosition::A1> ab;TBuf<TPosition::B1> bb;
  TBuf<TPosition::A2> a0;TBuf<TPosition::B2> b0;TBuf<TPosition::CO1> cb;
  TPipe* pipe_;GlobalTensor<int8_t> a_,b_;GlobalTensor<int64_t> groups_;
  GlobalTensor<int32_t> c_;int K_,N_,core_,produced_=0;
  TEventID afree[2*BATCH],aready[2*BATCH],bfree[2],bready[2],lfree,lready;
  __aicore__ inline void PrepareA(int local,int row,int rows) {
    WaitFlag<HardEvent::MTE1_MTE2>(static_cast<event_t>(afree[local]));
    WordCopy(ab.Get<int8_t>()[local*ABYTES],a_.GetPhyAddr()+(int64_t)row*K_,
      rows,K_,K_,(rows+15)/16*16,false);
    SetFlag<HardEvent::MTE2_MTE1>(static_cast<event_t>(aready[local]));
  }
public:
  __aicore__ inline void Init(TPipe* pipe,GlobalTensor<int8_t> a,GlobalTensor<int8_t> b,
    GlobalTensor<int64_t> groups,GlobalTensor<int32_t> c,int K,int N,int core) {
    pipe_=pipe;a_=a;b_=b;groups_=groups;c_=c;K_=K;N_=N;core_=core;
    pipe->InitBuffer(ab,2*BATCH*ABYTES);pipe->InitBuffer(bb,2*BATCH*BBYTES);
    pipe->InitBuffer(a0,ABYTES);pipe->InitBuffer(b0,BBYTES);pipe->InitBuffer(cb,TM*TN*4);
    SetMMRowMajor();
    for(int i=0;i<2*BATCH;++i){
      afree[i]=pipe->AllocEventID<HardEvent::MTE1_MTE2>();
      aready[i]=pipe->AllocEventID<HardEvent::MTE2_MTE1>();
      SetFlag<HardEvent::MTE1_MTE2>(static_cast<event_t>(afree[i]));
    }
    for(int i=0;i<2;++i){
      bfree[i]=pipe->AllocEventID<HardEvent::MTE1_MTE2>();
      bready[i]=pipe->AllocEventID<HardEvent::MTE2_MTE1>();
      SetFlag<HardEvent::MTE1_MTE2>(static_cast<event_t>(bfree[i]));
    }
    lfree=pipe->AllocEventID<HardEvent::M_MTE1>();
    lready=pipe->AllocEventID<HardEvent::MTE1_M>();
    SetFlag<HardEvent::M_MTE1>(static_cast<event_t>(lfree));
  }
  __aicore__ inline void Prepare(int first,int count,int slot) {
    for(int j=0;j<count;++j){
      const int e=first+j,start=e==0?0:(int)groups_.GetValue(e-1);
      const int end=(int)groups_.GetValue(e),rows=end-start<TM?end-start:TM;
      if(rows>0)PrepareA(slot*BATCH+j,start,rows);
    }
    WaitFlag<HardEvent::MTE1_MTE2>(static_cast<event_t>(bfree[slot]));
    GlobalTensor<int32_t> source;
    source.SetGlobalBuffer((__gm__ int32_t*)(b_.GetPhyAddr()+(int64_t)first*K_*N_));
    DataCopy(bb.Get<int8_t>()[slot*BATCH*BBYTES].template ReinterpretCast<int32_t>(),source,
      Nd2NzParams{(uint16_t)count,(uint16_t)K_,(uint16_t)(N_/4),
        (uint16_t)(K_*N_/4),(uint16_t)(N_/4),(uint16_t)K_,1,(uint16_t)(BBYTES/4)});
    SetFlag<HardEvent::MTE2_MTE1>(static_cast<event_t>(bready[slot]));
  }
  __aicore__ inline void Compute(int first,int count,int slot) {
    WaitFlag<HardEvent::MTE2_MTE1>(static_cast<event_t>(bready[slot]));
    auto ac=a0.Get<int8_t>(),bc=b0.Get<int8_t>();auto cc=cb.Get<int32_t>();
    for(int j=0;j<count;++j){
      const int e=first+j,start=e==0?0:(int)groups_.GetValue(e-1);
      const int end=(int)groups_.GetValue(e),local=slot*BATCH+j;
      auto al=ab.Get<int8_t>()[local*ABYTES],bl=bb.Get<int8_t>()[local*BBYTES];
      for(int row=start;row<end;row+=TM){
        const int rows=end-row<TM?end-row:TM,mr=(rows+15)/16*16;
        if(row!=start)PrepareA(local,row,rows);
        WaitFlag<HardEvent::MTE2_MTE1>(static_cast<event_t>(aready[local]));
        WaitFlag<HardEvent::M_MTE1>(static_cast<event_t>(lfree));
        const uint8_t pad[4]={0,0,0,0};SetFmatrix(1,mr,pad,FmatrixMode::FMATRIX_LEFT);
        LoadData3DParamsV2Pro la;la.channelSize=K_;la.extConfig=((uint64_t)mr<<16)|K_;
        LoadData(ac,al,la);
        SetFlag<HardEvent::MTE1_MTE2>(static_cast<event_t>(afree[local]));
        if(row==start){
          LoadData2dTransposeParams lb{0,(uint8_t)(N_/32),(uint16_t)(K_/32),1,0};
          for(int ki=0;ki<K_;ki+=32)LoadDataWithTranspose(bc[ki*N_],bl[ki*32],lb);
        }
        SetFlag<HardEvent::MTE1_M>(static_cast<event_t>(lready));
        WaitFlag<HardEvent::MTE1_M>(static_cast<event_t>(lready));
        MmadParams mp;mp.m=mr;mp.n=N_;mp.k=K_;mp.cmatrixInitVal=true;mp.unitFlag=3;
        Mmad(cc,ac,bc,mp);
        SetFlag<HardEvent::M_MTE1>(static_cast<event_t>(lfree));
        const int outputSlot=produced_&1;
        if(produced_>=2)CrossCoreWaitFlag<2>(1+2*outputSlot);
        FixpipeParamsV220 fp;fp.nSize=N_;fp.mSize=mr;fp.srcStride=mr;fp.dstStride=TN;fp.unitFlag=3;
        Fixpipe(c_[((int64_t)core_*2+outputSlot)*TM*TN],cc,fp);
        CrossCoreSetFlag<2,PIPE_FIX>(2*outputSlot);++produced_;
      }
    }
    SetFlag<HardEvent::MTE1_MTE2>(static_cast<event_t>(bfree[slot]));
  }
  __aicore__ inline void End() {
    if(produced_>1)CrossCoreWaitFlag<2>(1+2*((produced_-2)&1));
    if(produced_>0)CrossCoreWaitFlag<2>(1+2*((produced_-1)&1));
    for(int i=0;i<2*BATCH;++i)WaitFlag<HardEvent::MTE1_MTE2>(static_cast<event_t>(afree[i]));
    for(int i=0;i<2;++i)WaitFlag<HardEvent::MTE1_MTE2>(static_cast<event_t>(bfree[i]));
    WaitFlag<HardEvent::M_MTE1>(static_cast<event_t>(lfree));
    PipeBarrier<PIPE_ALL>();SetMMColumnMajor();
    for(int i=0;i<2*BATCH;++i){
      pipe_->ReleaseEventID<HardEvent::MTE1_MTE2>(afree[i]);
      pipe_->ReleaseEventID<HardEvent::MTE2_MTE1>(aready[i]);
    }
    for(int i=0;i<2;++i){
      pipe_->ReleaseEventID<HardEvent::MTE1_MTE2>(bfree[i]);
      pipe_->ReleaseEventID<HardEvent::MTE2_MTE1>(bready[i]);
    }
    pipe_->ReleaseEventID<HardEvent::M_MTE1>(lfree);
    pipe_->ReleaseEventID<HardEvent::MTE1_M>(lready);
  }
};
template<int BATCH>
__global__ __mix__(1,2) void ComputeExpertUnclamped(
  GM_ADDR x,GM_ADDR weight,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,GM_ADDR workspace,
  int M,int N,int K,int E)
{
  constexpr int TM=64,TN=256,COUNT=32*TN;
  InitSocState();
  GlobalTensor<int8_t> ag,bg;GlobalTensor<int64_t> gg;
  GlobalTensor<int32_t> cg;GlobalTensor<float> sg;GlobalTensor<half> yg;
  ag.SetGlobalBuffer((__gm__ int8_t*)x);bg.SetGlobalBuffer((__gm__ int8_t*)weight);
  gg.SetGlobalBuffer((__gm__ int64_t*)groups);cg.SetGlobalBuffer((__gm__ int32_t*)workspace);
  sg.SetGlobalBuffer((__gm__ float*)scale);yg.SetGlobalBuffer((__gm__ half*)y);
  const int cores=GetBlockNum();
  if ASCEND_IS_AIC {
    const int core=GetBlockIdx(),begin=(int64_t)E*core/cores,last=(int64_t)E*(core+1)/cores;
    TPipe pipe;ManualExpertBatch<BATCH> mm;mm.Init(&pipe,ag,bg,gg,cg,K,N,core);
    if(begin<last)mm.Prepare(begin,last-begin<BATCH?last-begin:BATCH,0);
    int batch=0;
    for(int first=begin;first<last;first+=BATCH,++batch){
      const int next=first+BATCH;
      if(next<last)mm.Prepare(next,last-next<BATCH?last-next:BATCH,(batch+1)&1);
      mm.Compute(first,last-first<BATCH?last-first:BATCH,batch&1);
    }
    mm.End();
  }
  if ASCEND_IS_AIV {
    const int core=GetBlockIdx()/2,sub=GetBlockIdx()%2;
    const int begin=(int64_t)E*core/cores,last=(int64_t)E*(core+1)/cores;
    TPipe pipe;TQue<TPosition::VECIN,2> cq,sq;TQue<TPosition::VECOUT,2> oq;
    TBuf<TPosition::VECCALC> tb;
    pipe.InitBuffer(cq,2,COUNT*4);pipe.InitBuffer(sq,2,TN*4);
    pipe.InitBuffer(oq,2,COUNT*2);pipe.InitBuffer(tb,COUNT*4);auto t=tb.Get<float>();
    int consumed=0;
    for(int e=begin;e<last;++e){
      const int first=e==0?0:(int)gg.GetValue(e-1),end=(int)gg.GetValue(e);
      for(int row=first;row<end;row+=TM){
        const int allRows=end-row<TM?end-row:TM,halfRows=(allRows+1)/2,subRow=sub*halfRows;
        const int rows=allRows-subRow<halfRows?allRows-subRow:halfRows,slot=consumed&1;
        CrossCoreWaitFlag<2>(2*slot);
        if(rows>0){
          auto c=cq.AllocTensor<int32_t>();auto s=sq.AllocTensor<float>();
          DataCopyPad(c,cg[((int64_t)core*2+slot)*TM*TN+subRow*TN],
            DataCopyExtParams{(uint16_t)rows,(uint32_t)(N*4),(uint32_t)((TN-N)*4),0,0},
            DataCopyPadExtParams<int32_t>{true,0,0,0});
          DataCopyPad(s,sg[(int64_t)e*N],DataCopyExtParams{1,(uint32_t)(N*4),0,0,0},DataCopyPadExtParams<float>{true,0,0,0});
          cq.EnQue(c);sq.EnQue(s);c=cq.DeQue<int32_t>();s=sq.DeQue<float>();
          CrossCoreSetFlag<2,PIPE_MTE2>(1+2*slot);
          auto z=c.ReinterpretCast<float>();Cast(z,c,RoundMode::CAST_RINT,rows*N);PipeBarrier<PIPE_V>();
          for(int c0=0;c0<N;c0+=64)Mul(z[c0],z[c0],s[c0],(uint64_t)(N-c0<64?N-c0:64),(uint8_t)rows,
            BinaryRepeatParams{1,1,1,(uint8_t)(N/8),(uint8_t)(N/8),0});
          PipeBarrier<PIPE_V>();GeluExpertUnclamped(z,t,rows*N);
          auto out=oq.AllocTensor<half>();Cast(out,z,RoundMode::CAST_RINT,rows*N);
          oq.EnQue(out);out=oq.DeQue<half>();
          DataCopyPad(yg[(int64_t)(row+subRow)*N],out,DataCopyExtParams{1,(uint32_t)(rows*N*2),0,0,0});
          oq.FreeTensor(out);sq.FreeTensor(s);cq.FreeTensor(c);
        }else CrossCoreSetFlag<2,PIPE_MTE2>(1+2*slot);
        ++consumed;
      }
    }
    PipeBarrier<PIPE_ALL>();SetMaskNorm();ResetMask();
  }
}
template<int BATCH>
void LaunchExpertUnclamped(GM_ADDR x,GM_ADDR weight,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,
  int M,int N,int K,int E,int cores,aclrtStream stream)
{
  void* scratch=nullptr;
  if(aclrtMalloc(&scratch,(int64_t)cores*2*64*256*4+cores*64,ACL_MEM_MALLOC_HUGE_FIRST)!=ACL_SUCCESS)return;
  ComputeExpertUnclamped<BATCH><<<cores,nullptr,stream>>>(x,weight,scale,groups,y,(GM_ADDR)scratch,M,N,K,E);
  aclrtSynchronizeStream(stream);aclrtFree(scratch);
}
template<int TN>
class ManualAlignedWordTransport {
  static constexpr int BM=128, BK=128, COPY_K=128;
  static constexpr int CPITCH=(TN+127)/128*128;
  static constexpr int FK=(524288-2*TN*COPY_K)/(2*BM)/32*32;
  static_assert(2*BM*FK+2*TN*COPY_K<=512*1024);
  static_assert(2*BM*BK<=65536 && 65536<=65536);
  static_assert(BM*256*4<=128*1024);
  TBuf<TPosition::A1> ab;
  TBuf<TPosition::B1> bb;
  TBuf<TPosition::A2> a0;
  TBuf<TPosition::B2> b0;
  TBuf<TPosition::CO1> cb;
  TPipe* pipe_;
  GlobalTensor<int32_t> output_;
  int core_=0,tiles_=0,segments_=0,produced_=0,lserial_=0;
  bool pending_=false;
  struct Segment {
    int rows,cols,depth,mr,nr,ks,kb,aslot,bslot;
  } saved_;
  TEventID afree[2],bfree[2],aready[2],bready[2],lfree[2],lready[2],cFree,cReady;
  __aicore__ inline void Compute(const Segment& p) {
    auto al=ab.Get<int8_t>()[p.aslot*BM*FK];
    auto bl=bb.Get<int8_t>()[p.bslot*TN*COPY_K];
    auto ac=a0.Get<int8_t>(),bc=b0.Get<int8_t>();
    auto cc=cb.Get<int32_t>();
    if(p.ks==0)WaitFlag<HardEvent::MTE2_MTE1>(static_cast<event_t>(aready[p.aslot]));
    WaitFlag<HardEvent::MTE2_MTE1>(static_cast<event_t>(bready[p.bslot]));
    const uint8_t pad[4]={0,0,0,0};
    SetFmatrix(1,p.mr,pad,FmatrixMode::FMATRIX_LEFT);
    const int stepK=(32768/p.nr/32)*32<BK?(32768/p.nr/32)*32:BK;
    for(int ki=0;ki<p.kb;ki+=stepK){
      const int kb=p.kb-ki<stepK?p.kb-ki:stepK;
      const int slot=(lserial_++)&1;
      WaitFlag<HardEvent::M_MTE1>(static_cast<event_t>(lfree[slot]));
      auto aa=ac[slot*BM*BK],ba=bc[slot*32768];
      LoadData3DParamsV2Pro la;
      la.channelSize=kb;la.extConfig=((uint64_t)p.mr<<16)|kb;
      LoadData(aa,al[(p.ks+ki)*p.mr],la);
      LoadData2dTransposeParams lb{0,(uint8_t)(kb*p.nr/1024),1,1,0};
      LoadDataWithTranspose(ba,bl[ki*p.nr],lb);
      if(ki+kb==p.kb){
        SetFlag<HardEvent::MTE1_MTE2>(static_cast<event_t>(bfree[p.bslot]));
        if(p.ks+p.kb==p.depth)
          SetFlag<HardEvent::MTE1_MTE2>(static_cast<event_t>(afree[p.aslot]));
      }
      SetFlag<HardEvent::MTE1_M>(static_cast<event_t>(lready[slot]));
      WaitFlag<HardEvent::MTE1_M>(static_cast<event_t>(lready[slot]));
      const bool first=p.ks==0 && ki==0;
      if(first && produced_>0){
        SetFlag<HardEvent::FIX_M>(static_cast<event_t>(cFree));
        WaitFlag<HardEvent::FIX_M>(static_cast<event_t>(cFree));
      }
      MmadParams mp;
      mp.m=p.mr;mp.n=p.nr;mp.k=kb;mp.cmatrixInitVal=first;
      Mmad(cc,aa,ba,mp);
      if((p.mr/16)*(p.nr/16)<10)PipeBarrier<PIPE_M>();
      SetFlag<HardEvent::M_MTE1>(static_cast<event_t>(lfree[slot]));
    }
    if(p.ks+p.kb==p.depth){
      SetFlag<HardEvent::M_FIX>(static_cast<event_t>(cReady));
      WaitFlag<HardEvent::M_FIX>(static_cast<event_t>(cReady));
      const int slot=produced_&1;
      if(produced_>=2)CrossCoreWaitFlag<2>(1+2*slot);
      FixpipeParamsV220 fp;
      fp.nSize=p.cols;fp.mSize=p.rows;fp.srcStride=p.mr;fp.dstStride=(p.cols+127)/128*128;
      Fixpipe(output_[((int64_t)core_*2+slot)*BM*256],cc,fp);
      CrossCoreSetFlag<2,PIPE_FIX>(2*slot);
      ++produced_;
    }
  }
public:
  __aicore__ inline void Init(TPipe* pipe,GlobalTensor<int32_t> out,int core) {
    pipe_=pipe;output_=out;core_=core;
    pipe->InitBuffer(ab,2*BM*FK);pipe->InitBuffer(bb,2*TN*COPY_K);
    pipe->InitBuffer(a0,2*BM*BK);pipe->InitBuffer(b0,65536);
    pipe->InitBuffer(cb,BM*256*4);
    for(int i=0;i<2;++i){
      afree[i]=pipe->AllocEventID<HardEvent::MTE1_MTE2>();
      bfree[i]=pipe->AllocEventID<HardEvent::MTE1_MTE2>();
      aready[i]=pipe->AllocEventID<HardEvent::MTE2_MTE1>();
      bready[i]=pipe->AllocEventID<HardEvent::MTE2_MTE1>();
      lfree[i]=pipe->AllocEventID<HardEvent::M_MTE1>();
      lready[i]=pipe->AllocEventID<HardEvent::MTE1_M>();
      SetFlag<HardEvent::MTE1_MTE2>(static_cast<event_t>(afree[i]));
      SetFlag<HardEvent::MTE1_MTE2>(static_cast<event_t>(bfree[i]));
      SetFlag<HardEvent::M_MTE1>(static_cast<event_t>(lfree[i]));
    }
    cFree=pipe->AllocEventID<HardEvent::FIX_M>();
    cReady=pipe->AllocEventID<HardEvent::M_FIX>();
  }
  __aicore__ inline void Push(GlobalTensor<int8_t> a,GlobalTensor<int8_t> b,
    int rows,int cols,int depth,int strideB) {
    const int aslot=tiles_&1,mr=(rows+15)/16*16,nr=(cols+31)/32*32;
    WaitFlag<HardEvent::MTE1_MTE2>(static_cast<event_t>(afree[aslot]));
    GlobalTensor<int32_t> aw;
    aw.SetGlobalBuffer((__gm__ int32_t*)a.GetPhyAddr());
    DataCopy(ab.Get<int8_t>()[aslot*BM*FK].template ReinterpretCast<int32_t>(),aw,
      Nd2NzParams{1,(uint16_t)rows,(uint16_t)(depth/4),0,(uint16_t)(depth/4),(uint16_t)mr,1,0});
    SetFlag<HardEvent::MTE2_MTE1>(static_cast<event_t>(aready[aslot]));
    for(int ks=0;ks<depth;ks+=COPY_K){
      const int kb=depth-ks<COPY_K?depth-ks:COPY_K;
      const int bslot=segments_&1;
      WaitFlag<HardEvent::MTE1_MTE2>(static_cast<event_t>(bfree[bslot]));
      GlobalTensor<int32_t> bw;
      bw.SetGlobalBuffer((__gm__ int32_t*)(b.GetPhyAddr()+(int64_t)ks*strideB));
      DataCopy(bb.Get<int8_t>()[bslot*TN*COPY_K].template ReinterpretCast<int32_t>(),bw,
        Nd2NzParams{(uint16_t)(kb/32),32,(uint16_t)(cols/4),
          (uint16_t)(32*strideB/4),(uint16_t)(strideB/4),32,1,(uint16_t)(32*nr/4)});
      SetFlag<HardEvent::MTE2_MTE1>(static_cast<event_t>(bready[bslot]));
      if(pending_)Compute(saved_);
      saved_={rows,cols,depth,mr,nr,ks,kb,aslot,bslot};
      pending_=true;++segments_;
    }
    ++tiles_;
  }
  __aicore__ inline void End() {
    if(pending_)Compute(saved_);
    if(produced_>1)CrossCoreWaitFlag<2>(1+2*((produced_-2)&1));
    if(produced_>0)CrossCoreWaitFlag<2>(1+2*((produced_-1)&1));
    for(int i=0;i<2;++i){
      WaitFlag<HardEvent::MTE1_MTE2>(static_cast<event_t>(afree[i]));
      WaitFlag<HardEvent::MTE1_MTE2>(static_cast<event_t>(bfree[i]));
      WaitFlag<HardEvent::M_MTE1>(static_cast<event_t>(lfree[i]));
    }
    PipeBarrier<PIPE_ALL>();
    for(int i=0;i<2;++i){
      pipe_->ReleaseEventID<HardEvent::MTE1_MTE2>(afree[i]);
      pipe_->ReleaseEventID<HardEvent::MTE1_MTE2>(bfree[i]);
      pipe_->ReleaseEventID<HardEvent::MTE2_MTE1>(aready[i]);
      pipe_->ReleaseEventID<HardEvent::MTE2_MTE1>(bready[i]);
      pipe_->ReleaseEventID<HardEvent::M_MTE1>(lfree[i]);
      pipe_->ReleaseEventID<HardEvent::MTE1_M>(lready[i]);
    }
    pipe_->ReleaseEventID<HardEvent::FIX_M>(cFree);
    pipe_->ReleaseEventID<HardEvent::M_FIX>(cReady);
  }
};
__aicore__ inline int AdaptiveColumnTile(int groupRows){
  const int mr=((groupRows<128?groupRows:128)+15)/16*16;
  const int capacity=32768/(mr>0?mr:16);
  int width=256;
  while(width<1024 && width*2<=capacity)width*=2;
  return width;
}
template<int TM,int TN,bool PADDED>
__global__ __mix__(1,2) void ComputeAlignedWordTransport(
  GM_ADDR x,GM_ADDR weight,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,GM_ADDR workspace,
  int M,int N,int K,int E,TCubeTiling tiling)
{
  InitSocState();
  GlobalTensor<int8_t> ag,bg;GlobalTensor<int64_t> gg;GlobalTensor<int32_t> cg;
  GlobalTensor<float> sg;GlobalTensor<half> yg;
  ag.SetGlobalBuffer((__gm__ int8_t*)x);bg.SetGlobalBuffer((__gm__ int8_t*)weight);
  gg.SetGlobalBuffer((__gm__ int64_t*)groups);cg.SetGlobalBuffer((__gm__ int32_t*)workspace);
  sg.SetGlobalBuffer((__gm__ float*)scale);yg.SetGlobalBuffer((__gm__ half*)y);
  const int cores=GetBlockNum();
  if ASCEND_IS_AIC {
    TPipe pipe;ManualAlignedWordTransport<TN> mm;mm.Init(&pipe,cg,GetBlockIdx());
    int start=0,base=0;
    for(int e=0;e<E;++e){
      const int end=(int)gg.GetValue(e),width=AdaptiveColumnTile(end-start),nc=(N+width-1)/width;
      const int tiles=((end-start+TM-1)/TM)*nc;
      int first=GetBlockIdx()-base;if(first<0)first+=cores;
      for(int task=first;task<tiles;task+=cores){
        int mr,nr;TileCoordinates(task,nc,mr,nr);
        const int row=start+mr*TM,col=nr*width;
        const int rows=end-row<TM?end-row:TM,cols=N-col<width?N-col:width;
        mm.Push(ag[(int64_t)row*K],bg[(int64_t)e*K*N+col],rows,cols,K,N);
      }
      base=AdvanceTaskBase(base,tiles,cores);start=end;
    }
    mm.End();
  }
  if ASCEND_IS_AIV {
    const int core=GetBlockIdx()/2,sub=GetBlockIdx()%2;
    constexpr int COUNT=128*128,MAXCOLS=TN/2;
    TPipe pipe;TQue<TPosition::VECIN,1> cq,sq;TQue<TPosition::VECOUT,1> oq;TBuf<TPosition::VECCALC> tb;
    pipe.InitBuffer(cq,1,COUNT*4);pipe.InitBuffer(sq,1,MAXCOLS*4);
    pipe.InitBuffer(oq,1,COUNT*2);pipe.InitBuffer(tb,COUNT*4);auto tmp=tb.Get<float>();
    int start=0,base=0,consumed=0;
    for(int e=0;e<E;++e){
      const int end=(int)gg.GetValue(e),width=AdaptiveColumnTile(end-start),nc=(N+width-1)/width;
      const int tiles=((end-start+TM-1)/TM)*nc;
      int first=core-base;if(first<0)first+=cores;
      for(int task=first;task<tiles;task+=cores){
        int mr,nr;TileCoordinates(task,nc,mr,nr);
        const int row=start+mr*TM,tileCol=nr*width;
        const int rows=end-row<TM?end-row:TM,totalCols=N-tileCol<width?N-tileCol:width;
        const int pitch=(totalCols+127)/128*128,vc=pitch/2;
        const int cols=totalCols-sub*vc<vc?totalCols-sub*vc:vc;
        const int col=tileCol+sub*vc,slot=consumed&1;
        CrossCoreWaitFlag<2>(2*slot);
        if(cols>0){
          auto c=cq.AllocTensor<int32_t>();auto s=sq.AllocTensor<float>();
          DataCopyPad(c,cg[((int64_t)core*2+slot)*128*256+sub*vc],
            DataCopyExtParams{(uint16_t)rows,(uint32_t)(cols*4),(uint32_t)((pitch-cols)*4),(uint32_t)((vc-(cols+7)/8*8)/8),0},DataCopyPadExtParams<int32_t>{true,0,0,0});
          DataCopyPad(s,sg[(int64_t)e*N+col],DataCopyExtParams{1,(uint32_t)(cols*4),0,0,0},DataCopyPadExtParams<float>{true,0,0,0});
          cq.EnQue(c);sq.EnQue(s);c=cq.DeQue<int32_t>();s=sq.DeQue<float>();
          CrossCoreSetFlag<2,PIPE_MTE2>(1+2*slot);
          auto z=c.ReinterpretCast<float>();Cast(z,c,RoundMode::CAST_RINT,rows*vc);PipeBarrier<PIPE_V>();
          for(int c0=0;c0<vc;c0+=64)Mul(z[c0],z[c0],s[c0],(uint64_t)64,(uint8_t)rows,BinaryRepeatParams{1,1,1,(uint8_t)(vc/8),(uint8_t)(vc/8),0});
          PipeBarrier<PIPE_V>();GeluBounded(z,tmp,rows*vc);
          auto out=oq.AllocTensor<half>();Cast(out,z,RoundMode::CAST_RINT,rows*vc);oq.EnQue(out);out=oq.DeQue<half>();
          DataCopyPad(yg[(int64_t)row*N+col],out,DataCopyExtParams{(uint16_t)rows,(uint32_t)(cols*2),(uint32_t)((vc-(cols+15)/16*16)/16),(uint32_t)((N-cols)*2),0});
          oq.FreeTensor(out);sq.FreeTensor(s);cq.FreeTensor(c);
        }else CrossCoreSetFlag<2,PIPE_MTE2>(1+2*slot);
        ++consumed;
      }
      base=AdvanceTaskBase(base,tiles,cores);start=end;
    }
  }
}
template<int TM,int TN>
void LaunchAlignedWordTransport(GM_ADDR x,GM_ADDR weight,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,
  int M,int N,int K,int E,int cores,aclrtStream stream)
{
  if((int64_t)2*128*K+2*TN*128>524288)return;
  TCubeTiling tiling{};tiling.baseM=128;tiling.baseN=256;tiling.baseK=128;
  void* scratch=nullptr;
  if(aclrtMalloc(&scratch,(int64_t)cores*2*128*256*4+cores*64,ACL_MEM_MALLOC_HUGE_FIRST)!=ACL_SUCCESS)return;
  if(N%32)ComputeAlignedWordTransport<TM,TN,true><<<cores,nullptr,stream>>>(x,weight,scale,groups,y,(GM_ADDR)scratch,M,N,K,E,tiling);
  else ComputeAlignedWordTransport<TM,TN,false><<<cores,nullptr,stream>>>(x,weight,scale,groups,y,(GM_ADDR)scratch,M,N,K,E,tiling);
  aclrtSynchronizeStream(stream);aclrtFree(scratch);
}
__aicore__ inline void AlignedSDKWordA(const LocalTensor<int8_t>& dst,const __gm__ void* gm,
  int row,int col,int useM,int useK,uint64_t,uint64_t meta) {
  const int stride=meta&0x3fff,bm=((meta>>41)&15)*16,bk=((meta>>50)&31)*32;
  WordCopy(dst,(const __gm__ int8_t*)gm+(int64_t)row*bm*stride+col*bk,
    useM,useK,stride,(useM+15)/16*16,false);
}
__aicore__ inline void AlignedSDKWordB(const LocalTensor<int8_t>& dst,const __gm__ void* gm,
  int row,int col,int useK,int useN,uint64_t,uint64_t meta) {
  const int stride=(meta>>14)&0x1fff,bn=((meta>>45)&31)*32,bk=((meta>>50)&31)*32;
  const int outer=(int)((meta>>57)&31)*128,remaining=stride-outer-col*bn;
  const int cols=useN<remaining?useN:remaining;
  WordCopy(dst,(const __gm__ int8_t*)gm+(int64_t)row*bk*stride+col*bn,
    useK,cols,stride,(useK+31)/32*32,false);
}
template<int TM, int TN>
class DirectSingleUnit {
  static constexpr int CK = 65536 / (TM > TN ? TM : TN);
  static_assert(TM * TN * sizeof(int32_t) <= 128 * 1024);
  TBuf<TPosition::A1> ab;
  TBuf<TPosition::B1> bb;
  TBuf<TPosition::A2> a0;
  TBuf<TPosition::B2> b0;
  TBuf<TPosition::CO1> cb;
  GlobalTensor<int8_t> a, b;
  uint64_t meta = 0;
  int rows, cols, depth;
  bool previous = false;
  const __gm__ int8_t* cached_b = nullptr;
  uint64_t cached_b_meta = 0;
  int cached_b_cols = 0, cached_b_depth = 0;
  TPipe* pipe_;
  TEventID event_MTE1_MTE2;
  TEventID event_MTE2_MTE1;
  TEventID event_M_MTE1;
  TEventID event_MTE1_M;
public:
  __aicore__ inline void SetSubBlockIdx(int) {}
  __aicore__ inline void Init(TCubeTiling*, TPipe* pipe) {
    pipe->InitBuffer(ab, TM * CK);
    pipe->InitBuffer(bb, CK * TN);
    pipe->InitBuffer(a0, TM * CK);
    pipe->InitBuffer(b0, CK * TN);
    pipe->InitBuffer(cb, TM * TN * sizeof(int32_t));
    pipe_ = pipe;
    SetMMRowMajor();
    event_MTE1_MTE2 = pipe->AllocEventID<HardEvent::MTE1_MTE2>();
    event_MTE2_MTE1 = pipe->AllocEventID<HardEvent::MTE2_MTE1>();
    event_M_MTE1 = pipe->AllocEventID<HardEvent::M_MTE1>();
    event_MTE1_M = pipe->AllocEventID<HardEvent::MTE1_M>();
  }
  __aicore__ inline void SetOrgShape(int, int, int, int, int) {}
  __aicore__ inline void SetSingleShape(int m, int n, int k) {
    rows = m; cols = n; depth = k;
  }
  __aicore__ inline void SetSelfDefineData(uint64_t value) { meta = value; }
  __aicore__ inline void SetTensorA(GlobalTensor<int8_t> value, bool) { a = value; }
  __aicore__ inline void SetTensorB(GlobalTensor<int8_t> value, bool) { b = value; }
  __aicore__ inline void End() {
    PipeBarrier<PIPE_ALL>();
    SetMMColumnMajor();
    pipe_->ReleaseEventID<HardEvent::MTE1_MTE2>(event_MTE1_MTE2);
    pipe_->ReleaseEventID<HardEvent::MTE2_MTE1>(event_MTE2_MTE1);
    pipe_->ReleaseEventID<HardEvent::M_MTE1>(event_M_MTE1);
    pipe_->ReleaseEventID<HardEvent::MTE1_M>(event_MTE1_M);
  }
  __aicore__ inline void IterateAll(GlobalTensor<int32_t> c, bool) {
    auto al = ab.Get<int8_t>(), bl = bb.Get<int8_t>();
    auto ac = a0.Get<int8_t>(), bc = b0.Get<int8_t>();
    auto cc = cb.Get<int32_t>();
    const int mr = (rows + 15) / 16 * 16;
    const int nr = (cols + 31) / 32 * 32;
    const int kr = (depth + 31) / 32 * 32;
    const auto bptr = b.GetPhyAddr();
    const uint64_t bmeta = meta & ~(uint64_t(1) << 62);
    const bool reuseB = previous && bptr == cached_b && bmeta == cached_b_meta
      && cols == cached_b_cols && depth == cached_b_depth;
    if (previous) {
      SetFlag<HardEvent::MTE1_MTE2>(static_cast<event_t>(event_MTE1_MTE2));
      WaitFlag<HardEvent::MTE1_MTE2>(static_cast<event_t>(event_MTE1_MTE2));
    }
    AlignedSDKWordA(al, a.GetPhyAddr(), 0, 0, rows, depth, 0, meta);
    if (!reuseB) {
      AlignedSDKWordB(bl, bptr, 0, 0, depth, cols, 0, meta);
      if (kr != depth && (depth & 1) == 0) {
        const int stride = (meta >> 14) & 0x1fff;
        const int outer = (int)((meta >> 57) & 31) * 128;
        const int valid = stride - outer < cols ? stride - outer : cols;
        InitConstValue(bl.ReinterpretCast<int32_t>()[depth * 8],
          InitConstValueParams<int32_t>{(uint16_t)((valid + 31) / 32),
            (uint16_t)(kr - depth), (uint16_t)depth, 0});
      }
    }
    SetFlag<HardEvent::MTE2_MTE1>(static_cast<event_t>(event_MTE2_MTE1));
    WaitFlag<HardEvent::MTE2_MTE1>(static_cast<event_t>(event_MTE2_MTE1));
    if (previous) {
      SetFlag<HardEvent::M_MTE1>(static_cast<event_t>(event_M_MTE1));
      WaitFlag<HardEvent::M_MTE1>(static_cast<event_t>(event_M_MTE1));
    }
    const uint8_t pad[4] = {0, 0, 0, 0};
    SetFmatrix(1, mr, pad, FmatrixMode::FMATRIX_LEFT);
    LoadData3DParamsV2Pro la;
    la.channelSize = kr;
    la.extConfig = ((uint64_t)mr << 16) | kr;
    LoadData(ac, al, la);
    if (!reuseB) {
      LoadData2dTransposeParams lb{0, (uint8_t)(nr / 32), (uint16_t)(kr / 32), 1, 0};
      for (int ki = 0; ki < kr; ki += 32)
        LoadDataWithTranspose(bc[ki * nr], bl[ki * 32], lb);
    }
    SetFlag<HardEvent::MTE1_M>(static_cast<event_t>(event_MTE1_M));
    WaitFlag<HardEvent::MTE1_M>(static_cast<event_t>(event_MTE1_M));
    MmadParams mp;
    mp.m = mr; mp.n = nr; mp.k = kr; mp.cmatrixInitVal = true; mp.unitFlag = 3;
    Mmad(cc, ac, bc, mp);
    FixpipeParamsV220 fp;
    fp.nSize = nr; fp.mSize = mr; fp.srcStride = mr; fp.dstStride = TN;
    fp.unitFlag = 3;
    Fixpipe(c, cc, fp);
    cached_b = bptr; cached_b_meta = bmeta;
    cached_b_cols = cols; cached_b_depth = depth;
    previous = true;
  }
};template<int TM,int TN>
__global__ __mix__(1, 2) void ComputeAdaptiveDirectRows(
  GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groups,
  GM_ADDR y, GM_ADDR workspace, int M, int N, int K, int E, TCubeTiling tiling)
{
  constexpr bool PADDED=false,TRANSPORT=false,USE_NORMAL=false,USE_DIRECT=true;
  InitSocState();
  GlobalTensor<int8_t> ag, bg;
  GlobalTensor<int64_t> gg;
  GlobalTensor<int32_t> cg;
  GlobalTensor<float> sg;
  GlobalTensor<half> yg;
  ag.SetGlobalBuffer((__gm__ int8_t*)x);
  bg.SetGlobalBuffer((__gm__ int8_t*)weight);
  gg.SetGlobalBuffer((__gm__ int64_t*)groups);
  cg.SetGlobalBuffer((__gm__ int32_t*)workspace);
  sg.SetGlobalBuffer((__gm__ float*)scale);
  yg.SetGlobalBuffer((__gm__ half*)y);
  const int ka = PADDED ? (K + 31) / 32 * 32 : K;
  const int nb = PADDED ? (N + 31) / 32 * 32 : N;
  if constexpr (PADDED) {
    auto base = workspace + (int64_t)GetBlockNum() * 2 * TM * TN * sizeof(int32_t);
    GlobalTensor<int8_t> ap, bp;
    ap.SetGlobalBuffer((__gm__ int8_t*)base);
    bp.SetGlobalBuffer((__gm__ int8_t*)(base + (ka != K ? (int64_t)M * ka : 0)));
    if ASCEND_IS_AIV {
      if (ka != K) PadRows(ap, ag, M, K, ka);
      if (nb != N) PadRows(bp, bg, (int64_t)E * K, N, nb);
    }
    SyncAll<false>();
    if (ka != K) ag = ap;
    if (nb != N) bg = bp;
  }
  const int nc = (N + TN - 1) / TN;
  const int cores = GetBlockNum();
  GlobalTensor<int32_t> rg;
  rg.SetGlobalBuffer((__gm__ int32_t*)(workspace
    +(int64_t)cores*2*TM*TN*sizeof(int32_t)));
  const bool plan=NeedsSchedulePlan(gg,M,N,K,E,cores);
  if ASCEND_IS_AIC {
    TPipe pipe;
    DirectSingleUnit<TM,TN> mm;
    mm.SetSubBlockIdx(0);
    mm.Init(&tiling, &pipe);
    mm.SetOrgShape(M, TRANSPORT?(N+31)/32*32:nb, ka, K, TN);
    uint64_t meta=0;
    if constexpr (TRANSPORT || USE_DIRECT)
      meta=(uint64_t)ka|((uint64_t)nb<<14)|((uint64_t)K<<27)
        |((uint64_t)(tiling.baseM/16)<<41)|((uint64_t)(tiling.baseN/32)<<45)
        |((uint64_t)(tiling.baseK/32)<<50)|((uint64_t)PADDED<<56);
    int mode=0;
    if(plan){
      CrossCoreWaitFlag<2>(4);
      auto record=rg[GetBlockIdx()*16];
      DataCacheCleanAndInvalid<int32_t,CacheLine::SINGLE_CACHE_LINE,DcciDst::CACHELINE_OUT>(record);
      mode=record.GetValue(0);
    }
    TaskSchedule<TM,TN> schedule(gg,M,N,E,cores,GetBlockIdx(),mode);
    ScheduledTile task;
    int produced=0;
    while(schedule.Next(task)){
      const int slot=produced&1;
      if(produced>=2)CrossCoreWaitFlag<2>(1+2*slot);
      if constexpr(TRANSPORT || USE_DIRECT)
        mm.SetSelfDefineData(meta|((uint64_t)(task.expert==E-1 && nb==N)<<55)
          |((uint64_t)(task.col/128)<<57)|((uint64_t)(task.row+task.rows==M)<<62));
      mm.SetSingleShape(task.rows,TRANSPORT?(task.cols+31)/32*32:task.cols,K);
      mm.SetTensorA(ag[(int64_t)task.row*ka],false);
      mm.SetTensorB(bg[(int64_t)task.expert*K*nb+task.col],false);
      mm.IterateAll(cg[((int64_t)GetBlockIdx()*2+slot)*TM*TN],false);
      CrossCoreSetFlag<2,PIPE_FIX>(2*slot);
      ++produced;
    }
    if (produced > 1) CrossCoreWaitFlag<2>(1 + 2 * ((produced - 2) & 1));
    if (produced > 0) CrossCoreWaitFlag<2>(1 + 2 * ((produced - 1) & 1));
    mm.End();
  }
  if ASCEND_IS_AIV {
    const int core = GetBlockIdx() / 2;
    const int sub = GetBlockIdx() % 2;
    const int mode=plan?ChooseSchedule<TM,TN>(groups,
      rg[core*16+sub*8],M,N,E,cores):0;
    static_assert(TM%2==0 && TN%64==0);
    constexpr int VCOLS=TN;
    constexpr int VCOUNT=(TM/2)*VCOLS;
    static_assert(VCOUNT * (2 * sizeof(int32_t) + 2 * sizeof(half)
      + sizeof(float)) + 2 * VCOLS * sizeof(float) <= 184 * 1024);
    TPipe pipe;
    TQue<TPosition::VECIN, 2> cq, sq;
    TQue<TPosition::VECOUT, 2> oq;
    TBuf<TPosition::VECCALC> tb;
    pipe.InitBuffer(cq, 2, VCOUNT * sizeof(int32_t));
    pipe.InitBuffer(sq, 2, VCOLS * sizeof(float));
    pipe.InitBuffer(oq, 2, VCOUNT * sizeof(half));
    pipe.InitBuffer(tb, VCOUNT * sizeof(float));
    auto t = tb.Get<float>();
    TaskSchedule<TM,TN> schedule(gg,M,N,E,cores,core,mode);
    ScheduledTile task;
    int consumed=0;
    while(schedule.Next(task)){
      const int halfRows=(task.rows+1)/2,subRow=sub*halfRows;
      const int e=task.expert,row=task.row+subRow,col=task.col;
      const int rows=task.rows-subRow<halfRows?task.rows-subRow:halfRows;
      const int cols=task.cols;
        const int slot = consumed & 1;
        CrossCoreWaitFlag<2>(2 * slot);
        if (rows > 0 && cols > 0) {
          auto c = cq.AllocTensor<int32_t>();
          auto s = sq.AllocTensor<float>();
          DataCopyPad(c, cg[((int64_t)core * 2 + slot) * TM * TN + subRow * TN],
            DataCopyExtParams{(uint16_t)rows, (uint32_t)(cols * 4),
              (uint32_t)((TN - cols) * 4), (uint32_t)((VCOLS - (cols + 7) / 8 * 8) / 8), 0},
            DataCopyPadExtParams<int32_t>{true, 0, 0, 0});
          DataCopyPad(s, sg[(int64_t)e * N + col],
            DataCopyExtParams{1, (uint32_t)(cols * 4), 0, 0, 0},
            DataCopyPadExtParams<float>{true, 0, 0, 0.0f});
          cq.EnQue(c);
          sq.EnQue(s);
          c = cq.DeQue<int32_t>();
          s = sq.DeQue<float>();
          CrossCoreSetFlag<2, PIPE_MTE2>(1 + 2 * slot);
          auto z = c.ReinterpretCast<float>();
          Cast(z, c, RoundMode::CAST_RINT, rows * VCOLS);
          PipeBarrier<PIPE_V>();
          for (int c0 = 0; c0 < VCOLS; c0 += 64)
            Mul(z[c0], z[c0], s[c0], (uint64_t)64, (uint8_t)rows,
              BinaryRepeatParams{1, 1, 1, VCOLS / 8, VCOLS / 8, 0});
          PipeBarrier<PIPE_V>();
          GeluBounded(z,t,rows*VCOLS);
          auto out = oq.AllocTensor<half>();
          Cast(out, z, RoundMode::CAST_RINT, rows * VCOLS);
          oq.EnQue(out);
          out = oq.DeQue<half>();
          DataCopyPad(yg[(int64_t)row * N + col], out,
            DataCopyExtParams{(uint16_t)rows, (uint32_t)(cols * 2),
              (uint32_t)((VCOLS - (cols + 15) / 16 * 16) / 16),
              (uint32_t)((N - cols) * 2), 0});
          oq.FreeTensor(out);
          sq.FreeTensor(s);
          cq.FreeTensor(c);
        } else {
          CrossCoreSetFlag<2, PIPE_MTE2>(1 + 2 * slot);
        }
        ++consumed;
    }
  }
}
template<int TM, int TN>
void LaunchAdaptiveDirectRows(GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR group_list,
  GM_ADDR y, int M, int N, int K, int E, int cores, aclrtStream stream)
{
  const int maxTiles = ((M + TM - 1) / TM + E - 1) * ((N + TN - 1) / TN);
  if (cores > maxTiles) cores = maxTiles;
  const int denseTiles = ((M + TM - 1) / TM) * ((N + TN - 1) / TN);
  if (K >= 1024 && N % 128 == 0 && cores > 16 && denseTiles > 16 &&
    (denseTiles + 15) / 16 == (denseTiles + cores - 1) / cores)
    cores = 16;
  const bool padded = M >= 256 * E && K >= 128 && N >= 128
    && K % 32 >= 16 && N % 32 >= 16;
  const int ka = padded ? (K + 31) / 32 * 32 : K;
  const int nb = padded ? (N + 31) / 32 * 32 : N;
  matmul_tiling::MultiCoreMatmulTiling mt;
  mt.SetDim(1);
  mt.SetAType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
    matmul_tiling::DataType::DT_INT8, false);
  mt.SetBType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
    matmul_tiling::DataType::DT_INT8, false);
  mt.SetCType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
    matmul_tiling::DataType::DT_INT32);
  mt.SetShape(TM, TN, K);
  mt.SetOrgShape(M, nb, ka, K);
  mt.SetFixSplit(TM > 128 ? 128 : TM, TN, 128);
  mt.SetBufferSpace(512 * 1024, 128 * 1024, 0);
  TCubeTiling tiling;
  if (mt.GetTiling(tiling) != 0) return;
  if(K>=4096 && N>128 && (K%32!=0 || N%32!=0)) {
    tiling.stepKa=4;tiling.stepKb=4;
    tiling.depthA1=8;tiling.depthB1=8;
  } else if(K>=1024 && K%32==0 && N%128==0 && tiling.stepKa>4) {
    const int bytesA=8*tiling.baseM*tiling.baseK;
    const int bytesB=tiling.depthB1*tiling.baseN*tiling.baseK;
    if(bytesA+bytesB<=512*1024) {
      tiling.stepKa=4;tiling.depthA1=8;
    }
  }
  void* scratch = nullptr;
  const int64_t extra = (ka != K ? (int64_t)M * ka : 0)
    + (nb != N ? (int64_t)E * K * nb : 0);
  if (aclrtMalloc(&scratch, cores * 2 * TM * TN * sizeof(int32_t) + extra + cores*64,
      ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) return;
  ComputeAdaptiveDirectRows<TM,TN><<<cores,nullptr,stream>>>(x,weight,scale,group_list,y,(GM_ADDR)scratch,M,N,K,E,tiling);
  aclrtSynchronizeStream(stream);
  aclrtFree(scratch);
}
template<int TM, int TN, int SPLITS>
__global__ __mix__(1, 2) void ComputeStreamingSplitK(
  GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groups,
  GM_ADDR y, GM_ADDR workspace, int M, int N, int K, int E, TCubeTiling tiling)
{
  InitSocState();
  GlobalTensor<int8_t> ag,bg;
  GlobalTensor<int64_t> gg;
  GlobalTensor<int32_t> cg;
  GlobalTensor<float> sg;
  GlobalTensor<half> yg;
  ag.SetGlobalBuffer((__gm__ int8_t*)x);
  bg.SetGlobalBuffer((__gm__ int8_t*)weight);
  gg.SetGlobalBuffer((__gm__ int64_t*)groups);
  cg.SetGlobalBuffer((__gm__ int32_t*)workspace);
  sg.SetGlobalBuffer((__gm__ float*)scale);
  yg.SetGlobalBuffer((__gm__ half*)y);
  constexpr int VCOLS=TN/2;
  const int cn=(N+127)/128*128;
  const int nc=(N+TN-1)/TN;
  const int cores=GetBlockNum();
  const int chunk=(K+SPLITS*32-1)/(SPLITS*32)*32;
  if ASCEND_IS_AIC {
    TPipe pipe;
    matmul::MatmulImpl<AType,BType,CType,BiasType,MM_CONFIG,
      MatmulCallBackFunc<nullptr,PairA,AdaptiveB>> mm;
    mm.SetSubBlockIdx(0);
    mm.Init(&tiling,&pipe);
    mm.SetOrgShape(M,cn,K,K,cn);
    const uint64_t meta=(uint64_t)K|((uint64_t)N<<14)
      |((uint64_t)(tiling.baseM/16)<<41)|((uint64_t)(tiling.baseN/32)<<45)
      |((uint64_t)(tiling.baseK/32)<<50);
    int start=0,base=0;
    const int eBegin=M==1?SingleRowExpert(gg,E):0;
    const int eLimit=M==1?eBegin+1:E;
    for(int e=eBegin;e<eLimit;++e){
      const int end=(int)gg.GetValue(e);
      const int tasks=((end-start+TM-1)/TM)*nc*SPLITS;
      const int first=(GetBlockIdx()-base%cores+cores)%cores;
      for(int task=first;task<tasks;task+=cores){
        const int split=task%SPLITS,tile=task/SPLITS;
        const int row=start+tile/nc*TM,col=tile%nc*TN;
        const int rows=end-row<TM?end-row:TM;
        const int cols=N-col<TN?N-col:TN;
        const int kb=split*chunk;
        const int kk=K-kb<chunk?K-kb:chunk;
        mm.SetSelfDefineData(meta|((uint64_t)kk<<27)
          |((uint64_t)(e==E-1 && kb+kk==K)<<55)|((uint64_t)(row+rows==M)<<62)
          |((uint64_t)(col/128)<<57));
        mm.SetSingleShape(rows,(cols+31)/32*32,kk);
        mm.SetTensorA(ag[(int64_t)row*K+kb],false);
        mm.SetTensorB(bg[(int64_t)e*K*N+(int64_t)kb*N+col],false);
        mm.IterateAll(cg[((int64_t)split*M+row)*cn+col],false);
      }
      base+=tasks;start=end;
    }
    mm.End();
    PipeBarrier<PIPE_ALL>();
  }
  SyncAll<false>();
  if ASCEND_IS_AIV {
    const int core=GetBlockIdx()/2,sub=GetBlockIdx()%2;
    constexpr int CHUNK_ROWS=64;
    constexpr int VCOUNT=CHUNK_ROWS*VCOLS;
    TPipe pipe;
    TQue<TPosition::VECIN,1> cq,sq,rq;
    TQue<TPosition::VECOUT,1> oq;
    TBuf<TPosition::VECCALC> tb;
    pipe.InitBuffer(cq,1,VCOUNT*sizeof(int32_t));
    pipe.InitBuffer(rq,1,VCOUNT*sizeof(int32_t));
    pipe.InitBuffer(sq,1,VCOLS*sizeof(float));
    pipe.InitBuffer(oq,1,VCOUNT*sizeof(half));
    pipe.InitBuffer(tb,VCOUNT*sizeof(float));
    auto t=tb.Get<float>();
    int start=0,base=0;
    const int eBegin=M==1?SingleRowExpert(gg,E):0;
    const int eLimit=M==1?eBegin+1:E;
    for(int e=eBegin;e<eLimit;++e){
      const int end=(int)gg.GetValue(e);
      const int tasks=((end-start+TM-1)/TM)*nc;
      const int first=(core-base%cores+cores)%cores;
      for(int task=first;task<tasks;task+=cores){
        const int tileRow=start+task/nc*TM,col=task%nc*TN+sub*VCOLS;
        const int tileRows=end-tileRow<TM?end-tileRow:TM;
        const int cols=N-col<VCOLS?N-col:VCOLS;
        if(cols<=0)continue;
        for(int row=tileRow;row<tileRow+tileRows;row+=CHUNK_ROWS){
        const int rows=tileRow+tileRows-row<CHUNK_ROWS?tileRow+tileRows-row:CHUNK_ROWS;
        auto c=cq.AllocTensor<int32_t>();
        auto s=sq.AllocTensor<float>();
        const DataCopyExtParams cp{(uint16_t)rows,(uint32_t)(cols*4),
          (uint32_t)((cn-cols)*4),
          (uint32_t)((VCOLS-(cols+7)/8*8)/8),0};
        DataCopyPad(c,cg[(int64_t)row*cn+col],cp,
          DataCopyPadExtParams<int32_t>{true,0,0,0});
        cq.EnQue(c);c=cq.DeQue<int32_t>();
        for(int split=1;split<SPLITS;++split){
          auto r=rq.AllocTensor<int32_t>();
          DataCopyPad(r,cg[((int64_t)split*M+row)*cn+col],cp,
            DataCopyPadExtParams<int32_t>{true,0,0,0});
          rq.EnQue(r);r=rq.DeQue<int32_t>();
          Add(c,c,r,rows*VCOLS);
          PipeBarrier<PIPE_V>();
          rq.FreeTensor(r);
        }
        DataCopyPad(s,sg[(int64_t)e*N+col],
          DataCopyExtParams{1,(uint32_t)(cols*4),0,0,0},
          DataCopyPadExtParams<float>{true,0,0,0.0f});
        sq.EnQue(s);s=sq.DeQue<float>();
        auto z=c.ReinterpretCast<float>();
        Cast(z,c,RoundMode::CAST_RINT,rows*VCOLS);
        PipeBarrier<PIPE_V>();
        for(int c0=0;c0<VCOLS;c0+=64)
          Mul(z[c0],z[c0],s[c0],(uint64_t)64,(uint8_t)rows,
            BinaryRepeatParams{1,1,1,VCOLS/8,VCOLS/8,0});
        PipeBarrier<PIPE_V>();
        GeluBounded(z,t,rows*VCOLS);
        auto out=oq.AllocTensor<half>();
        Cast(out,z,RoundMode::CAST_RINT,rows*VCOLS);
        oq.EnQue(out);out=oq.DeQue<half>();
        DataCopyPad(yg[(int64_t)row*N+col],out,
          DataCopyExtParams{(uint16_t)rows,(uint32_t)(cols*2),
            (uint32_t)((VCOLS-(cols+15)/16*16)/16),
            (uint32_t)((N-cols)*2),0});
        oq.FreeTensor(out);sq.FreeTensor(s);cq.FreeTensor(c);
        }
      }
      base+=tasks;start=end;
    }
  }
}
template<int TM,int TN,int SPLITS>
void LaunchStreamingSplitK(GM_ADDR x,GM_ADDR weight,GM_ADDR scale,GM_ADDR groups,
  GM_ADDR y,int M,int N,int K,int E,int cores,aclrtStream stream)
{
  const int cn=(N+127)/128*128;
  const int maxTiles=((M+TM-1)/TM+E-1)*((N+TN-1)/TN)*SPLITS;
  if(cores>maxTiles)cores=maxTiles;
  matmul_tiling::MultiCoreMatmulTiling mt;
  mt.SetDim(1);
  mt.SetAType(matmul_tiling::TPosition::GM,matmul_tiling::CubeFormat::ND,
    matmul_tiling::DataType::DT_INT8,false);
  mt.SetBType(matmul_tiling::TPosition::GM,matmul_tiling::CubeFormat::ND,
    matmul_tiling::DataType::DT_INT8,false);
  mt.SetCType(matmul_tiling::TPosition::GM,matmul_tiling::CubeFormat::ND,
    matmul_tiling::DataType::DT_INT32);
  mt.SetShape(TM,TN,(K+SPLITS*32-1)/(SPLITS*32)*32);
  mt.SetOrgShape(M,cn,K,K);
  mt.SetFixSplit(TM,TN,128);
  mt.SetBufferSpace(512*1024,128*1024,0);
  TCubeTiling tiling;
  if(mt.GetTiling(tiling)!=0)return;
  void* scratch=nullptr;
  if(aclrtMalloc(&scratch,(int64_t)SPLITS*M*cn*4,
    ACL_MEM_MALLOC_HUGE_FIRST)!=ACL_SUCCESS)return;
  ComputeStreamingSplitK<TM,TN,SPLITS><<<cores,nullptr,stream>>>(
    x,weight,scale,groups,y,(GM_ADDR)scratch,M,N,K,E,tiling);
  aclrtSynchronizeStream(stream);
  aclrtFree(scratch);
}
template<int TM, int TN, int SPLITS>
__global__ __mix__(1, 2) void ComputeResidentEightSplit(
  GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groups,
  GM_ADDR y, GM_ADDR workspace, int M, int N, int K, int E, TCubeTiling tiling)
{
  InitSocState();
  GlobalTensor<int8_t> ag,bg;
  GlobalTensor<int64_t> gg;
  GlobalTensor<int32_t> cg;
  GlobalTensor<float> sg;
  GlobalTensor<half> yg;
  ag.SetGlobalBuffer((__gm__ int8_t*)x);
  bg.SetGlobalBuffer((__gm__ int8_t*)weight);
  gg.SetGlobalBuffer((__gm__ int64_t*)groups);
  cg.SetGlobalBuffer((__gm__ int32_t*)workspace);
  sg.SetGlobalBuffer((__gm__ float*)scale);
  yg.SetGlobalBuffer((__gm__ half*)y);
  constexpr int VCOLS=TN/2;
  const int cn=(N+127)/128*128;
  const int nc=(N+TN-1)/TN;
  const int cores=GetBlockNum();
  const int chunk=(K+SPLITS*32-1)/(SPLITS*32)*32;
  if ASCEND_IS_AIC {
    TPipe pipe;
    matmul::MatmulImpl<AType,BType,CType,BiasType,MM_CONFIG,
      MatmulCallBackFunc<nullptr,PairA,AdaptiveB>> mm;
    mm.SetSubBlockIdx(0);
    mm.Init(&tiling,&pipe);
    mm.SetOrgShape(M,cn,K,K,cn);
    const uint64_t meta=(uint64_t)K|((uint64_t)N<<14)
      |((uint64_t)(tiling.baseM/16)<<41)|((uint64_t)(tiling.baseN/32)<<45)
      |((uint64_t)(tiling.baseK/32)<<50);
    int start=0,base=0;
    const int eBegin=M==1?SingleRowExpert(gg,E):0;
    const int eLimit=M==1?eBegin+1:E;
    for(int e=eBegin;e<eLimit;++e){
      const int end=(int)gg.GetValue(e);
      const int tasks=((end-start+TM-1)/TM)*nc*SPLITS;
      const int first=(GetBlockIdx()-base%cores+cores)%cores;
      for(int task=first;task<tasks;task+=cores){
        const int split=task%SPLITS,tile=task/SPLITS;
        const int row=start+tile/nc*TM,col=tile%nc*TN;
        const int rows=end-row<TM?end-row:TM;
        const int cols=N-col<TN?N-col:TN;
        const int kb=split*chunk;
        const int kk=K-kb<chunk?K-kb:chunk;
        mm.SetSelfDefineData(meta|((uint64_t)kk<<27)
          |((uint64_t)(e==E-1 && kb+kk==K)<<55)|((uint64_t)(row+rows==M)<<62)
          |((uint64_t)(col/128)<<57));
        mm.SetSingleShape(rows,(cols+31)/32*32,kk);
        mm.SetTensorA(ag[(int64_t)row*K+kb],false);
        mm.SetTensorB(bg[(int64_t)e*K*N+(int64_t)kb*N+col],false);
        mm.IterateAll(cg[((int64_t)split*M+row)*cn+col],false);
      }
      base+=tasks;start=end;
    }
    mm.End();
    PipeBarrier<PIPE_ALL>();
  }
  SyncAll<false>();
  if ASCEND_IS_AIV {
    const int core=GetBlockIdx()/2,sub=GetBlockIdx()%2;
    constexpr int UB_LIMIT=184*1024;
    constexpr int SCALE_BYTES=2*VCOLS*sizeof(float);
    constexpr int ROW_BYTES=VCOLS*(2*sizeof(int32_t)+2*sizeof(int32_t)+
      2*sizeof(half)+sizeof(float));
    constexpr int RESOURCE_ROWS=(UB_LIMIT-SCALE_BYTES)/ROW_BYTES/8*8;
    constexpr int CHUNK_ROWS=RESOURCE_ROWS<64?RESOURCE_ROWS:64;
    constexpr int REDUCE_ROWS=CHUNK_ROWS;
    static_assert(CHUNK_ROWS>=8 && CHUNK_ROWS<=64);
    constexpr int VCOUNT=CHUNK_ROWS*VCOLS;
    TPipe pipe;
    TQue<TPosition::VECIN,2> cq,sq;
    TQue<TPosition::VECIN,2> rq;
    TQue<TPosition::VECOUT,2> oq;
    TBuf<TPosition::VECCALC> tb;
    pipe.InitBuffer(cq,2,VCOUNT*sizeof(int32_t));
    pipe.InitBuffer(rq,2,VCOUNT*sizeof(int32_t));
    pipe.InitBuffer(sq,2,VCOLS*sizeof(float));
    pipe.InitBuffer(oq,2,VCOUNT*sizeof(half));
    pipe.InitBuffer(tb,VCOUNT*sizeof(float));
    auto t=tb.Get<float>();
    const bool narrowTail=N%TN>0 && N%TN<=32;
    int totalRowTiles=0;
    if(narrowTail){
      int previous=0;
      for(int e=0;e<E;++e){
        const int end=(int)gg.GetValue(e);
        totalRowTiles+=(end-previous+REDUCE_ROWS-1)/REDUCE_ROWS;
        previous=end;
      }
    }
    for(int pass=0;pass<(narrowTail?2:1);++pass){
    const int taskColumns=narrowTail?(pass==0?N/TN:1):nc;
    const int passColumn=narrowTail && pass==1?(N/TN)*TN:0;
    int start=0,base=narrowTail && pass==1?totalRowTiles*(N/TN):0;
    const int eBegin=M==1?SingleRowExpert(gg,E):0;
    const int eLimit=M==1?eBegin+1:E;
    for(int e=eBegin;e<eLimit;++e){
      const int end=(int)gg.GetValue(e);
      const int tasks=((end-start+REDUCE_ROWS-1)/REDUCE_ROWS)*taskColumns;
      const int first=(core-base%cores+cores)%cores;
      for(int task=first;task<tasks;task+=cores){
        const int tileRow=start+task/taskColumns*REDUCE_ROWS,col=passColumn+task%taskColumns*TN+sub*VCOLS;
        const int tileRows=end-tileRow<REDUCE_ROWS?end-tileRow:REDUCE_ROWS;
        const int cols=N-col<VCOLS?N-col:VCOLS;
        if(cols<=0)continue;
        const int pitch=(cols+7)/8*8,outPitch=(cols+15)/16*16;
        for(int row=tileRow;row<tileRow+tileRows;row+=CHUNK_ROWS){
        const int rows=tileRow+tileRows-row<CHUNK_ROWS?tileRow+tileRows-row:CHUNK_ROWS;
        auto c=cq.AllocTensor<int32_t>();
        auto s=sq.AllocTensor<float>();
        const DataCopyExtParams cp{(uint16_t)rows,(uint32_t)(cols*4),
          (uint32_t)((cn-cols)*4),
          0,0};
        DataCopyPad(c,cg[(int64_t)row*cn+col],cp,
          DataCopyPadExtParams<int32_t>{true,0,0,0});
        cq.EnQue(c);c=cq.DeQue<int32_t>();
        if constexpr(SPLITS>1){
          auto first=rq.AllocTensor<int32_t>();
          DataCopyPad(first,cg[((int64_t)M+row)*cn+col],cp,
            DataCopyPadExtParams<int32_t>{true,0,0,0});
          rq.EnQue(first);
        }
        for(int split=1;split<SPLITS;++split){
          auto r=rq.DeQue<int32_t>();
          if(split+1<SPLITS){
            auto next=rq.AllocTensor<int32_t>();
            DataCopyPad(next,cg[((int64_t)(split+1)*M+row)*cn+col],cp,
              DataCopyPadExtParams<int32_t>{true,0,0,0});
            rq.EnQue(next);
          }
          Add(c,c,r,rows*pitch);
          PipeBarrier<PIPE_V>();
          rq.FreeTensor(r);
        }
        DataCopyPad(s,sg[(int64_t)e*N+col],
          DataCopyExtParams{1,(uint32_t)(cols*4),0,0,0},
          DataCopyPadExtParams<float>{true,0,0,0.0f});
        sq.EnQue(s);s=sq.DeQue<float>();
        auto z=c.ReinterpretCast<float>();
        Cast(z,c,RoundMode::CAST_RINT,rows*pitch);
        PipeBarrier<PIPE_V>();
        if(pitch==32/sizeof(float)){
          const int count=rows*pitch,full=count/64,last=count%64;
          const BinaryRepeatParams repeat{1,1,0,8,8,0};
          if(full)Mul(z,z,s,(uint64_t)64,(uint8_t)full,repeat);
          if(last)Mul(z[full*64],z[full*64],s,(uint64_t)last,1,repeat);
        }else{
          for(int c0=0;c0<pitch;c0+=64)
            Mul(z[c0],z[c0],s[c0],(uint64_t)(pitch-c0<64?pitch-c0:64),(uint8_t)rows,
              BinaryRepeatParams{1,1,1,(uint8_t)(pitch/8),(uint8_t)(pitch/8),0});
        }
        PipeBarrier<PIPE_V>();
        GeluBounded(z,t,rows*pitch);
        auto out=oq.AllocTensor<half>();
        if(pitch==outPitch){
          Cast(out,z,RoundMode::CAST_RINT,rows*pitch);
        }else{
          for(int c0=0;c0<cols;c0+=64)
            Cast(out[c0],z[c0],RoundMode::CAST_RINT,
              (uint64_t)(cols-c0<64?cols-c0:64),(uint8_t)rows,
              UnaryRepeatParams{1,1,(uint8_t)(outPitch/16),(uint8_t)(pitch/8)});
        }
        oq.EnQue(out);out=oq.DeQue<half>();
        DataCopyPad(yg[(int64_t)row*N+col],out,
          DataCopyExtParams{(uint16_t)rows,(uint32_t)(cols*2),
            0,
            (uint32_t)((N-cols)*2),0});
        oq.FreeTensor(out);sq.FreeTensor(s);cq.FreeTensor(c);
        }
      }
      base+=tasks;start=end;
    }
    }
    PipeBarrier<PIPE_ALL>();SetMaskNorm();ResetMask();
  }
}
template<int TM,int TN,int SPLITS>
void LaunchResidentEightSplit(GM_ADDR x,GM_ADDR weight,GM_ADDR scale,GM_ADDR groups,
  GM_ADDR y,int M,int N,int K,int E,int cores,aclrtStream stream)
{
  const int cn=(N+127)/128*128;
  const int maxTiles=((M+TM-1)/TM+E-1)*((N+TN-1)/TN)*SPLITS;
  if(cores>maxTiles)cores=maxTiles;
  matmul_tiling::MultiCoreMatmulTiling mt;
  mt.SetDim(1);
  mt.SetAType(matmul_tiling::TPosition::GM,matmul_tiling::CubeFormat::ND,
    matmul_tiling::DataType::DT_INT8,false);
  mt.SetBType(matmul_tiling::TPosition::GM,matmul_tiling::CubeFormat::ND,
    matmul_tiling::DataType::DT_INT8,false);
  mt.SetCType(matmul_tiling::TPosition::GM,matmul_tiling::CubeFormat::ND,
    matmul_tiling::DataType::DT_INT32);
  mt.SetShape(TM,TN,(K+SPLITS*32-1)/(SPLITS*32)*32);
  mt.SetOrgShape(M,cn,K,K);
  mt.SetFixSplit(128,TN,128);
  mt.SetBufferSpace(512*1024,128*1024,0);
  TCubeTiling tiling;
  if(mt.GetTiling(tiling)!=0){
    LaunchStreamingSplitK<128,256,4>(x,weight,scale,groups,y,M,N,K,E,cores,stream);return;
  }
  const int partK=(K+SPLITS*32-1)/(SPLITS*32)*32;
  const int blocks=(partK+tiling.baseK-1)/tiling.baseK;
  const int64_t l1=(int64_t)(2*tiling.baseM+tiling.baseN)*blocks*tiling.baseK;
  if(l1>512*1024 || tiling.stepM!=1 || tiling.stepN!=1){
    LaunchStreamingSplitK<128,256,4>(x,weight,scale,groups,y,M,N,K,E,cores,stream);return;
  }
  tiling.stepKa=blocks;tiling.depthA1=2*blocks;
  tiling.stepKb=blocks;tiling.depthB1=blocks;
  void* scratch=nullptr;
  if(aclrtMalloc(&scratch,(int64_t)SPLITS*M*cn*4,
    ACL_MEM_MALLOC_HUGE_FIRST)!=ACL_SUCCESS)return;
  ComputeResidentEightSplit<TM,TN,SPLITS><<<cores,nullptr,stream>>>(
    x,weight,scale,groups,y,(GM_ADDR)scratch,M,N,K,E,tiling);
  aclrtSynchronizeStream(stream);
  aclrtFree(scratch);
}
}
namespace Medium {
constexpr MatmulConfig MM_CONFIG =
  GetMDLConfig(false, false, 0, false, false, false, true, true, true, false, false, true);
constexpr MatmulConfig NORMAL_CONFIG = GetNormalConfig(false, false, false,
  BatchMode::NONE, true, IterateOrder::UNDEF, ScheduleType::INNER_PRODUCT,
  true, false, BatchOutMode::SINGLE_BATCH);
using AType = matmul::MatmulType<TPosition::GM, CubeFormat::ND, int8_t, false>;
using BType = matmul::MatmulType<TPosition::GM, CubeFormat::ND, int8_t, false>;
using CType = matmul::MatmulType<TPosition::GM, CubeFormat::ND, int32_t>;
using BiasType = matmul::MatmulType<TPosition::GM, CubeFormat::ND, int32_t>;
template<bool USE_NORMAL, typename CALLBACK> struct MatmulSelect;
template<typename CALLBACK> struct MatmulSelect<false, CALLBACK> {
  using Type = matmul::MatmulImpl<AType, BType, CType, BiasType, MM_CONFIG, CALLBACK>;
};
template<typename CALLBACK> struct MatmulSelect<true, CALLBACK> {
  using Type = matmul::MatmulImpl<AType, BType, CType, BiasType, NORMAL_CONFIG, CALLBACK>;
};
__aicore__ inline int SingleRowExpert(GlobalTensor<int64_t> groups,int E)
{
  if(E==1 || groups.GetValue(0)>0)return 0;
  int lo=1,hi=E-1;
  while(lo<hi){
    const int mid=(lo+hi)/2;
    if(groups.GetValue(mid)==0)lo=mid+1;else hi=mid;
  }
  return lo;
}
__aicore__ inline int SingleRowExpert(LocalTensor<int32_t> groups,int E)
{
  if(E==1 || groups.GetValue(0)>0)return 0;
  int lo=1,hi=E-1;
  while(lo<hi){
    const int mid=(lo+hi)/2;
    if(groups.GetValue(2*mid)==0)lo=mid+1;else hi=mid;
  }
  return lo;
}
__aicore__ inline void PadRows(GlobalTensor<int8_t> dst, GlobalTensor<int8_t> src,
  int64_t rows, int width, int padded)
{
  TPipe pipe;
  TBuf<TPosition::VECCALC> buffer;
  pipe.InitBuffer(buffer, 32768);
  auto data = buffer.Get<int8_t>();
  const int chunk = 32768 / padded;
  const int blocks = GetBlockNum() * 2;
  for (int64_t row = (int64_t)GetBlockIdx() * chunk; row < rows; row += (int64_t)blocks * chunk) {
    int count = rows - row < chunk ? rows - row : chunk;
    DataCopyPad(data, src[row * width],
      DataCopyExtParams{(uint16_t)count, (uint32_t)width, 0, 0, 0},
      DataCopyPadExtParams<int8_t>{true, 0, (uint8_t)(padded - width), 0});
    SetFlag<HardEvent::MTE2_MTE3>(EVENT_ID0);
    WaitFlag<HardEvent::MTE2_MTE3>(EVENT_ID0);
    DataCopy(dst[row * padded], data, count * padded);
    SetFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);
    WaitFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);
  }
}
__aicore__ inline void WordCopy(const LocalTensor<int8_t>& dst, const __gm__ int8_t* ptr,
  int height, int width, int stride, int paddedHeight, bool finalRow)
{
  const int count=height-((width%4 && finalRow)?1:0);
  const int groups=stride%4==0?1:(stride%2==0?2:4);
  auto d32=dst.ReinterpretCast<int32_t>();
  for (int g=0;g<groups && g<count;++g) {
    GlobalTensor<int32_t> src;
    src.SetGlobalBuffer((__gm__ int32_t*)(ptr+(int64_t)g*stride));
    DataCopy(d32[g*8],src,Nd2NzParams{1,(uint16_t)((count-g+groups-1)/groups),
      (uint16_t)((width+3)/4),0,(uint16_t)(stride*groups/4),
      (uint16_t)paddedHeight,(uint16_t)groups,0});
  }
  if (count<height) {
    GlobalTensor<int8_t> src;
    src.SetGlobalBuffer((__gm__ int8_t*)(ptr+(int64_t)(height-1)*stride));
    DataCopy(dst[(height-1)*32],src,Nd2NzParams{1,1,(uint16_t)width,0,
      (uint16_t)stride,(uint16_t)paddedHeight,1,0});
  }
}
__aicore__ inline void PairCopy(const LocalTensor<int8_t>& dst, const __gm__ int8_t* ptr,
  int height, int width, int stride, int paddedHeight, bool allowOdd, bool finalRow, bool preferWord)
{
  if (allowOdd && stride >= 4 && (stride <= 64 || preferWord)) {
    WordCopy(dst,ptr,height,width,stride,paddedHeight,finalRow);
    return;
  }
  GlobalTensor<int8_t> src;
  src.SetGlobalBuffer((__gm__ int8_t*)ptr);
  if ((width & 1) && !allowOdd) {
    DataCopy(dst,src,Nd2NzParams{1,(uint16_t)height,(uint16_t)width,0,
      (uint16_t)stride,(uint16_t)paddedHeight,1,0});
    return;
  }
  const int count=height-(((width&1)&&finalRow)?1:0);
  const int pairs=(width+1)/2;
  if (count>0) {
    auto d16=dst.ReinterpretCast<int16_t>();
    GlobalTensor<int16_t> s16;
    s16.SetGlobalBuffer((__gm__ int16_t*)ptr);
    if (stride % 2 == 0) {
      DataCopy(d16,s16,Nd2NzParams{1,(uint16_t)count,(uint16_t)pairs,0,
        (uint16_t)(stride/2),(uint16_t)paddedHeight,1,0});
    } else {
      DataCopy(d16,s16,Nd2NzParams{1,(uint16_t)((count+1)/2),(uint16_t)pairs,0,
        (uint16_t)stride,(uint16_t)paddedHeight,2,0});
      if (count>1) {
        s16.SetGlobalBuffer((__gm__ int16_t*)(ptr+stride));
        DataCopy(d16[16],s16,Nd2NzParams{1,(uint16_t)(count/2),(uint16_t)pairs,0,
          (uint16_t)stride,(uint16_t)paddedHeight,2,0});
      }
    }
  }
  if (count<height) {
    DataCopy(dst[(height-1)*32],src[(int64_t)(height-1)*stride],
      Nd2NzParams{1,1,(uint16_t)width,0,(uint16_t)stride,(uint16_t)paddedHeight,1,0});
  }
}
__aicore__ inline void PairA(const LocalTensor<int8_t>& dst, const __gm__ void* gm,
  int row, int col, int useM, int useK, uint64_t unused, uint64_t meta)
{
  int stride=meta&0x3fff;
  int bm=((meta>>41)&15)*16;
  int bk=((meta>>50)&31)*32;
  auto ptr=(const __gm__ int8_t*)gm+(int64_t)row*bm*stride+col*bk;
  const bool odd=(useK&1)!=0;
  PairCopy(dst,ptr,useM,useK,stride,(useM+15)/16*16,
    odd,odd && ((meta>>62)&1),false);
}
__aicore__ inline void PairB(const LocalTensor<int8_t>& dst, const __gm__ void* gm,
  int row, int col, int useK, int useN, uint64_t unused, uint64_t meta)
{
  int stride=(meta>>14)&0x1fff;
  int k=(meta>>27)&0x3fff;
  int bn=((meta>>45)&31)*32;
  int bk=((meta>>50)&31)*32;
  bool finalRow=((meta>>55)&1) && row*bk+useK==k;
  auto ptr=(const __gm__ int8_t*)gm+(int64_t)row*bk*stride+col*bn;
  const int paddedK=(useK+31)/32*32;
  PairCopy(dst,ptr,useK,useN,stride,paddedK,true,finalRow,(meta>>56)&1);
  if((useK&1) && useN>0){
    InitConstValue(dst.ReinterpretCast<int32_t>()[useK*8],
      InitConstValueParams<int32_t>{(uint16_t)((useN+31)/32),
        (uint16_t)(paddedK-useK),(uint16_t)useK,0});
  }
}
__aicore__ inline void AdaptiveB(const LocalTensor<int8_t>& dst,const __gm__ void* gm,
  int row,int col,int useK,int useN,uint64_t unused,uint64_t meta)
{
  const int stride=(meta>>14)&0x1fff;
  const int bn=((meta>>45)&31)*32;
  const int outer=(int)((meta>>57)&31)*128;
  const int valid=stride-outer-col*bn;
  PairB(dst,gm,row,col,useK,useN<valid?useN:valid,unused,meta);
}
template<bool ENABLED> struct TransportCallback;
template<> struct TransportCallback<true> {
  using Type=MatmulCallBackFunc<nullptr,PairA,AdaptiveB>;
};
template<> struct TransportCallback<false> {
  using Type=MatmulCallBackFunc<nullptr,nullptr,nullptr>;
};
template<int TM, int TN>
class DirectSingleMatmul {
  static constexpr int CK = 65536 / (TM > TN ? TM : TN);
  static_assert(TM * TN * sizeof(int32_t) <= 128 * 1024);
  TBuf<TPosition::A1> ab;
  TBuf<TPosition::B1> bb;
  TBuf<TPosition::A2> a0;
  TBuf<TPosition::B2> b0;
  TBuf<TPosition::CO1> cb;
  GlobalTensor<int8_t> a, b;
  uint64_t meta = 0;
  int rows, cols, depth;
  bool previous = false;
  const __gm__ int8_t* cached_b = nullptr;
  uint64_t cached_b_meta = 0;
  int cached_b_cols = 0, cached_b_depth = 0;
  TPipe* pipe_;
  TEventID event_MTE1_MTE2;
  TEventID event_MTE2_MTE1;
  TEventID event_M_MTE1;
  TEventID event_MTE1_M;
  TEventID event_FIX_M;
  TEventID event_M_FIX;
public:
  __aicore__ inline void SetSubBlockIdx(int) {}
  __aicore__ inline void Init(TCubeTiling*, TPipe* pipe) {
    pipe->InitBuffer(ab, TM * CK);
    pipe->InitBuffer(bb, CK * TN);
    pipe->InitBuffer(a0, TM * CK);
    pipe->InitBuffer(b0, CK * TN);
    pipe->InitBuffer(cb, TM * TN * sizeof(int32_t));
    pipe_ = pipe;
    event_MTE1_MTE2 = pipe->AllocEventID<HardEvent::MTE1_MTE2>();
    event_MTE2_MTE1 = pipe->AllocEventID<HardEvent::MTE2_MTE1>();
    event_M_MTE1 = pipe->AllocEventID<HardEvent::M_MTE1>();
    event_MTE1_M = pipe->AllocEventID<HardEvent::MTE1_M>();
    event_FIX_M = pipe->AllocEventID<HardEvent::FIX_M>();
    event_M_FIX = pipe->AllocEventID<HardEvent::M_FIX>();
  }
  __aicore__ inline void SetOrgShape(int, int, int, int, int) {}
  __aicore__ inline void SetSingleShape(int m, int n, int k) {
    rows = m; cols = n; depth = k;
  }
  __aicore__ inline void SetSelfDefineData(uint64_t value) { meta = value; }
  __aicore__ inline void SetTensorA(GlobalTensor<int8_t> value, bool) { a = value; }
  __aicore__ inline void SetTensorB(GlobalTensor<int8_t> value, bool) { b = value; }
  __aicore__ inline void End() {
    PipeBarrier<PIPE_ALL>();
    pipe_->ReleaseEventID<HardEvent::MTE1_MTE2>(event_MTE1_MTE2);
    pipe_->ReleaseEventID<HardEvent::MTE2_MTE1>(event_MTE2_MTE1);
    pipe_->ReleaseEventID<HardEvent::M_MTE1>(event_M_MTE1);
    pipe_->ReleaseEventID<HardEvent::MTE1_M>(event_MTE1_M);
    pipe_->ReleaseEventID<HardEvent::FIX_M>(event_FIX_M);
    pipe_->ReleaseEventID<HardEvent::M_FIX>(event_M_FIX);
  }
  __aicore__ inline void IterateAll(GlobalTensor<int32_t> c, bool) {
    auto al = ab.Get<int8_t>(), bl = bb.Get<int8_t>();
    auto ac = a0.Get<int8_t>(), bc = b0.Get<int8_t>();
    auto cc = cb.Get<int32_t>();
    const int mr = (rows + 15) / 16 * 16;
    const int nr = (cols + 31) / 32 * 32;
    const int kr = (depth + 31) / 32 * 32;
    const auto bptr = b.GetPhyAddr();
    const uint64_t bmeta = meta & ~(uint64_t(1) << 62);
    const bool reuseB = previous && bptr == cached_b && bmeta == cached_b_meta
      && cols == cached_b_cols && depth == cached_b_depth;
    if (previous) {
      SetFlag<HardEvent::MTE1_MTE2>(static_cast<event_t>(event_MTE1_MTE2));
      WaitFlag<HardEvent::MTE1_MTE2>(static_cast<event_t>(event_MTE1_MTE2));
    }
    PairA(al, a.GetPhyAddr(), 0, 0, rows, depth, 0, meta);
    if (!reuseB) {
      AdaptiveB(bl, bptr, 0, 0, depth, cols, 0, meta);
      if (kr != depth && (depth & 1) == 0) {
        const int stride = (meta >> 14) & 0x1fff;
        const int outer = (int)((meta >> 57) & 31) * 128;
        const int valid = stride - outer < cols ? stride - outer : cols;
        InitConstValue(bl.ReinterpretCast<int32_t>()[depth * 8],
          InitConstValueParams<int32_t>{(uint16_t)((valid + 31) / 32),
            (uint16_t)(kr - depth), (uint16_t)depth, 0});
      }
    }
    SetFlag<HardEvent::MTE2_MTE1>(static_cast<event_t>(event_MTE2_MTE1));
    WaitFlag<HardEvent::MTE2_MTE1>(static_cast<event_t>(event_MTE2_MTE1));
    if (previous) {
      SetFlag<HardEvent::M_MTE1>(static_cast<event_t>(event_M_MTE1));
      WaitFlag<HardEvent::M_MTE1>(static_cast<event_t>(event_M_MTE1));
    }
    const uint8_t pad[4] = {0, 0, 0, 0};
    SetFmatrix(1, mr, pad, FmatrixMode::FMATRIX_LEFT);
    LoadData3DParamsV2Pro la;
    la.channelSize = kr;
    la.extConfig = ((uint64_t)mr << 16) | kr;
    LoadData(ac, al, la);
    if (!reuseB) {
      LoadData2dTransposeParams lb{0, (uint8_t)(nr / 32), (uint16_t)(kr / 32), 1, 0};
      for (int ki = 0; ki < kr; ki += 32)
        LoadDataWithTranspose(bc[ki * nr], bl[ki * 32], lb);
    }
    SetFlag<HardEvent::MTE1_M>(static_cast<event_t>(event_MTE1_M));
    WaitFlag<HardEvent::MTE1_M>(static_cast<event_t>(event_MTE1_M));
    if (previous) {
      SetFlag<HardEvent::FIX_M>(static_cast<event_t>(event_FIX_M));
      WaitFlag<HardEvent::FIX_M>(static_cast<event_t>(event_FIX_M));
    }
    MmadParams mp;
    mp.m = mr; mp.n = nr; mp.k = kr; mp.cmatrixInitVal = true;
    Mmad(cc, ac, bc, mp);
    SetFlag<HardEvent::M_FIX>(static_cast<event_t>(event_M_FIX));
    WaitFlag<HardEvent::M_FIX>(static_cast<event_t>(event_M_FIX));
    FixpipeParamsV220 fp;
    fp.nSize = cols; fp.mSize = rows; fp.srcStride = mr; fp.dstStride = TN;
    Fixpipe(c, cc, fp);
    cached_b = bptr; cached_b_meta = bmeta;
    cached_b_cols = cols; cached_b_depth = depth;
    previous = true;
  }
};
template<int TM, int TN, bool NORMAL, bool DIRECT, typename CALLBACK>
struct CubeSelect {
  using Type = typename MatmulSelect<NORMAL, CALLBACK>::Type;
};
template<int TM, int TN, bool NORMAL, typename CALLBACK>
struct CubeSelect<TM, TN, NORMAL, true, CALLBACK> {
  using Type = DirectSingleMatmul<TM, TN>;
};
__aicore__ inline int AdvanceTaskBase(int base,int count,int cores)
{
  const int sum=base+count;
  if(sum<cores)return sum;
  return count<cores?sum-cores:sum%cores;
}
__aicore__ inline void TileCoordinates(int task,int nc,int& mr,int& nr)
{
  if(nc==1){mr=task;nr=0;}
  else if(nc==2){mr=task>>1;nr=task&1;}
  else {mr=task/nc;nr=task-mr*nc;}
}
__aicore__ inline void GeluBounded(LocalTensor<float> z,LocalTensor<float> t,int count)
{
  const BinaryRepeatParams binary{1,1,1,8,8,8};
  const UnaryRepeatParams unary{1,1,8,8};
  for(int offset=0;offset<count;){
    const int remaining=count-offset;
    const int full=remaining/64;
    const uint8_t repeats=(uint8_t)(full>255?255:(full>0?full:1));
    const uint64_t mask=full>0?64:(uint64_t)remaining;
    auto a=z[offset];auto b=t[offset];
    Mul(b,a,a,mask,repeats,binary);PipeBarrier<PIPE_V>();
    Muls(b,b,-0.07135481627260025f,mask,repeats,unary);PipeBarrier<PIPE_V>();
    Adds(b,b,-1.5957691216057308f,mask,repeats,unary);PipeBarrier<PIPE_V>();
    Mul(b,b,a,mask,repeats,binary);PipeBarrier<PIPE_V>();
    Maxs(b,b,-87.0f,mask,repeats,unary);PipeBarrier<PIPE_V>();
    Mins(b,b,87.0f,mask,repeats,unary);PipeBarrier<PIPE_V>();
    Exp(b,b,mask,repeats,unary);PipeBarrier<PIPE_V>();
    Adds(b,b,1.0f,mask,repeats,unary);PipeBarrier<PIPE_V>();
    Div(a,a,b,mask,repeats,binary);PipeBarrier<PIPE_V>();
    offset+=full>0?(int)repeats*64:(int)mask;
  }
}
template<int TM, int TN, bool PADDED, bool TRANSPORT, bool USE_NORMAL = false, bool USE_DIRECT = false>
__global__ __mix__(1, 2) void Compute(
  GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groups,
  GM_ADDR y, GM_ADDR workspace, int M, int N, int K, int E, TCubeTiling tiling)
{
  constexpr int SLOT_PITCH=TM*TN+(PADDED?0:128);
  InitSocState();
  GlobalTensor<int8_t> ag, bg;
  GlobalTensor<int64_t> gg;
  GlobalTensor<int32_t> cg;
  GlobalTensor<float> sg;
  GlobalTensor<half> yg;
  ag.SetGlobalBuffer((__gm__ int8_t*)x);
  bg.SetGlobalBuffer((__gm__ int8_t*)weight);
  gg.SetGlobalBuffer((__gm__ int64_t*)groups);
  cg.SetGlobalBuffer((__gm__ int32_t*)workspace);
  sg.SetGlobalBuffer((__gm__ float*)scale);
  yg.SetGlobalBuffer((__gm__ half*)y);
  const int ka = K;
  const int nb = PADDED ? (N + 31) / 32 * 32 : N;
  if constexpr (PADDED) {
    auto base = workspace + (int64_t)GetBlockNum() * 2 * SLOT_PITCH * sizeof(int32_t);
    GlobalTensor<int8_t> ap, bp;
    ap.SetGlobalBuffer((__gm__ int8_t*)base);
    bp.SetGlobalBuffer((__gm__ int8_t*)(base + (ka != K ? (int64_t)M * ka : 0)));
    if ASCEND_IS_AIV {
      if (ka != K) PadRows(ap, ag, M, K, ka);
      if (nb != N) PadRows(bp, bg, (int64_t)E * K, N, nb);
    }
    SyncAll<false>();
    if (ka != K) ag = ap;
    if (nb != N) bg = bp;
  }
  const int nc = (N + TN - 1) / TN;
  const int cores = GetBlockNum();
  const bool shardExperts = M!=1 && E >= 2 * cores && N <= 512 && K <= 512;
  if ASCEND_IS_AIC {
    TPipe pipe;
    typename CubeSelect<TM,TN,USE_NORMAL,USE_DIRECT,typename TransportCallback<TRANSPORT>::Type>::Type mm;
    mm.SetSubBlockIdx(0);
    mm.Init(&tiling, &pipe);
    mm.SetOrgShape(M, TRANSPORT ? (N+31)/32*32 : nb, ka, K, TN);
    uint64_t meta=0;
    if constexpr (TRANSPORT || USE_DIRECT)
      meta=(uint64_t)ka|((uint64_t)nb<<14)|((uint64_t)K<<27)
        |((uint64_t)(tiling.baseM/16)<<41)|((uint64_t)(tiling.baseN/32)<<45)
        |((uint64_t)(tiling.baseK/32)<<50)|((uint64_t)PADDED<<56);
    int taskBase = 0;
    int start = 0;
    int produced = 0;
    const int eFirst = M==1 ? SingleRowExpert(gg,E) : (shardExperts ? GetBlockIdx() : 0);
    const int eStep = M==1 ? E : (shardExperts ? cores : 1);
    for (int e = eFirst; e < E; e += eStep) {
      if (shardExperts) start = e == 0 ? 0 : (int)gg.GetValue(e - 1);
      int end = (int)gg.GetValue(e);
      int tiles = ((end - start + TM - 1) / TM) * nc;
      if(tiles==0){start=end;continue;}
      int first = shardExperts ? 0 : GetBlockIdx()-taskBase;
      if(first<0)first+=cores;
      const int taskStep = shardExperts ? 1 : cores;
      for (int task = first; task < tiles; task += taskStep) {
        const int slot = produced & 1;
        if (produced >= 2) CrossCoreWaitFlag<2>(1 + 2 * slot);
        int mr,nr;TileCoordinates(task,nc,mr,nr);
        int row = start + mr * TM;
        int col = nr * TN;
        int rows = end - row < TM ? end - row : TM;
        int cols = N - col < TN ? N - col : TN;
        if constexpr (TRANSPORT || USE_DIRECT) {
          mm.SetSelfDefineData(meta|((uint64_t)(e==E-1 && nb==N)<<55)
            |((uint64_t)(col/128)<<57)|((uint64_t)(row+rows==M)<<62));
        }
        mm.SetSingleShape(rows, TRANSPORT ? (cols+31)/32*32 : cols, K);
        mm.SetTensorA(ag[(int64_t)row * ka], false);
        mm.SetTensorB(bg[(int64_t)e * K * nb + col], false);
        mm.IterateAll(cg[((int64_t)GetBlockIdx() * 2 + slot) * SLOT_PITCH], false);
        CrossCoreSetFlag<2, PIPE_FIX>(2 * slot);
        ++produced;
      }
      if(!shardExperts)taskBase=AdvanceTaskBase(taskBase,tiles,cores);
      start = end;
    }
    if (produced > 1) CrossCoreWaitFlag<2>(1 + 2 * ((produced - 2) & 1));
    if (produced > 0) CrossCoreWaitFlag<2>(1 + 2 * ((produced - 1) & 1));
    mm.End();
  }
  if ASCEND_IS_AIV {
    const int core = GetBlockIdx() / 2;
    const int sub = GetBlockIdx() % 2;
    constexpr int VCOLS = TN / 2;
    constexpr int VCOUNT = TM * VCOLS;
    TPipe pipe;
    TQue<TPosition::VECIN, 1> cq, sq;
    TQue<TPosition::VECOUT, 1> oq;
    TBuf<TPosition::VECCALC> tb;
    pipe.InitBuffer(cq, 1, VCOUNT * sizeof(int32_t));
    pipe.InitBuffer(sq, 1, VCOLS * sizeof(float));
    pipe.InitBuffer(oq, 1, VCOUNT * sizeof(half));
    pipe.InitBuffer(tb, VCOUNT * sizeof(float));
    auto t = tb.Get<float>();
    int consumed = 0;
    int taskBase = 0;
    int start = 0;
    const int eFirst = M==1 ? SingleRowExpert(gg,E) : (shardExperts ? core : 0);
    const int eStep = M==1 ? E : (shardExperts ? cores : 1);
    for (int e = eFirst; e < E; e += eStep) {
      if (shardExperts) start = e == 0 ? 0 : (int)gg.GetValue(e - 1);
      int end = (int)gg.GetValue(e);
      int tiles = ((end - start + TM - 1) / TM) * nc;
      if(tiles==0){start=end;continue;}
      int first = shardExperts ? 0 : core-taskBase;
      if(first<0)first+=cores;
      const int taskStep = shardExperts ? 1 : cores;
      for (int task = first; task < tiles; task += taskStep) {
        int mr,nr;TileCoordinates(task,nc,mr,nr);
        int row = start + mr * TM;
        int col = nr * TN + sub * VCOLS;
        int rows = end - row < TM ? end - row : TM;
        int cols = N - col < VCOLS ? N - col : VCOLS;
        const int slot = consumed & 1;
        CrossCoreWaitFlag<2>(2 * slot);
        if (rows > 0 && cols > 0) {
          auto c = cq.AllocTensor<int32_t>();
          auto s = sq.AllocTensor<float>();
          DataCopyPad(c, cg[((int64_t)core * 2 + slot) * SLOT_PITCH + sub * VCOLS],
            DataCopyExtParams{(uint16_t)rows, (uint32_t)(cols * 4),
              (uint32_t)((TN - cols) * 4), (uint32_t)((VCOLS - (cols + 7) / 8 * 8) / 8), 0},
            DataCopyPadExtParams<int32_t>{true, 0, 0, 0});
          DataCopyPad(s, sg[(int64_t)e * N + col],
            DataCopyExtParams{1, (uint32_t)(cols * 4), 0, 0, 0},
            DataCopyPadExtParams<float>{true, 0, 0, 0.0f});
          cq.EnQue(c);
          sq.EnQue(s);
          c = cq.DeQue<int32_t>();
          s = sq.DeQue<float>();
          CrossCoreSetFlag<2, PIPE_MTE2>(1 + 2 * slot);
          auto z = c.ReinterpretCast<float>();
          Cast(z, c, RoundMode::CAST_RINT, rows * VCOLS);
          PipeBarrier<PIPE_V>();
          if constexpr (TM > 255) {
            for(int r0=0;r0<rows;r0+=255){
              const uint8_t repeats=(uint8_t)(rows-r0<255?rows-r0:255);
              for(int c0=0;c0<VCOLS;c0+=64)
                Mul(z[r0*VCOLS+c0],z[r0*VCOLS+c0],s[c0],(uint64_t)64,repeats,
                  BinaryRepeatParams{1,1,1,VCOLS/8,VCOLS/8,0});
            }
          } else {
            for (int c0 = 0; c0 < VCOLS; c0 += 64)
              Mul(z[c0], z[c0], s[c0], (uint64_t)64, (uint8_t)rows,
                BinaryRepeatParams{1, 1, 1, VCOLS / 8, VCOLS / 8, 0});
          }
          PipeBarrier<PIPE_V>();
          GeluBounded(z,t,rows*VCOLS);
          auto out = oq.AllocTensor<half>();
          Cast(out, z, RoundMode::CAST_RINT, rows * VCOLS);
          oq.EnQue(out);
          out = oq.DeQue<half>();
          DataCopyPad(yg[(int64_t)row * N + col], out,
            DataCopyExtParams{(uint16_t)rows, (uint32_t)(cols * 2),
              (uint32_t)((VCOLS - (cols + 15) / 16 * 16) / 16),
              (uint32_t)((N - cols) * 2), 0});
          oq.FreeTensor(out);
          sq.FreeTensor(s);
          cq.FreeTensor(c);
        } else {
          CrossCoreSetFlag<2, PIPE_MTE2>(1 + 2 * slot);
        }
        ++consumed;
      }
      if(!shardExperts)taskBase=AdvanceTaskBase(taskBase,tiles,cores);
      start = end;
    }
  }
}
__aicore__ inline void GeluResident(LocalTensor<float> z,LocalTensor<float> t,int count)
{
  const BinaryRepeatParams binary{1,1,1,8,8,8};
  const UnaryRepeatParams unary{1,1,8,8};
  for(int offset=0;offset<count;){
    const int remaining=count-offset;
    const int full=remaining/64;
    const uint8_t repeats=(uint8_t)(full>255?255:(full>0?full:1));
    const uint64_t mask=full>0?64:(uint64_t)remaining;
    auto a=z[offset];auto b=t[offset];
    Mul(b,a,a,mask,repeats,binary);PipeBarrier<PIPE_V>();
    Muls(b,b,-0.07135481627260025f,mask,repeats,unary);PipeBarrier<PIPE_V>();
    Adds(b,b,-1.5957691216057308f,mask,repeats,unary);PipeBarrier<PIPE_V>();
    Mul(b,b,a,mask,repeats,binary);PipeBarrier<PIPE_V>();
    Exp(b,b,mask,repeats,unary);PipeBarrier<PIPE_V>();
    Adds(b,b,1.0f,mask,repeats,unary);PipeBarrier<PIPE_V>();
    Div(a,a,b,mask,repeats,binary);PipeBarrier<PIPE_V>();
    offset+=full>0?(int)repeats*64:(int)mask;
  }
}
template<int TN>
class MediumResidentColumns {
  static constexpr int BM=192,BK=160;
  static constexpr int FK=((512*1024-256)/(BM+2*TN)/32)*32;
  static_assert((BM+2*TN)*FK<=512*1024-256);
  static_assert(2*BM*BK<=65536 && 2*TN*BK<=65536);
  static_assert(BM*TN*4<=128*1024);
  LocalTensor<int8_t> ab;
  LocalTensor<int8_t> bb;
  LocalTensor<int8_t> a0;
  LocalTensor<int8_t> b0;
  LocalTensor<int32_t> cb;
  GlobalTensor<int32_t> output_;
  struct Task {
    GlobalTensor<int8_t> a,b;
    int rows,cols,depth,strideB,ticket;
    bool lastA,lastB;
  } saved_;
  int core_=0,tasks_=0,produced_=0,lserial_=0;
  bool pending_=false;
  const __gm__ int8_t* cachedA_=nullptr;
  int cachedARows_=0,cachedADepth_=0;
  TEventID afree,aready,bfree[2],bready[2],lfree[2],lready[2];
  __aicore__ inline void PrepareA(const Task& p,int row) {
    const int rows=p.rows-row<BM?p.rows-row:BM,mr=(rows+15)/16*16;
    WaitFlag<HardEvent::MTE1_MTE2>(static_cast<event_t>(afree));
    const bool odd=(p.depth&1)!=0;
    auto address=p.a.GetPhyAddr()+(int64_t)row*p.depth;
    if(address!=cachedA_ || rows!=cachedARows_ || p.depth!=cachedADepth_){
      PairCopy(ab,address,rows,p.depth,p.depth,mr,
        odd,odd && p.lastA && row+rows==p.rows,false);
      cachedA_=address;cachedARows_=rows;cachedADepth_=p.depth;
    }
    SetFlag<HardEvent::MTE2_MTE1>(static_cast<event_t>(aready));
  }
  __aicore__ inline void PrepareB(const Task& p) {
    const int slot=p.ticket&1,kr=(p.depth+31)/32*32;
    WaitFlag<HardEvent::MTE1_MTE2>(static_cast<event_t>(bfree[slot]));
    auto dst=bb[slot*TN*FK];
    PairCopy(dst,p.b.GetPhyAddr(),p.depth,p.cols,p.strideB,kr,true,p.lastB,false);
    if(kr!=p.depth)InitConstValue(dst.template ReinterpretCast<int32_t>()[p.depth*8],
      InitConstValueParams<int32_t>{(uint16_t)((p.cols+31)/32),
        (uint16_t)(kr-p.depth),(uint16_t)p.depth,0});
    SetFlag<HardEvent::MTE2_MTE1>(static_cast<event_t>(bready[slot]));
  }
  __aicore__ inline void Compute(const Task& p) {
    const int bs=p.ticket&1,kr=(p.depth+31)/32*32,nr=(p.cols+31)/32*32;
    auto bl=bb[bs*TN*FK];
    auto al=ab,ac=a0,bc=b0;
    auto cc=cb;
    WaitFlag<HardEvent::MTE2_MTE1>(static_cast<event_t>(bready[bs]));
    for(int row=0;row<p.rows;row+=BM) {
      const int rows=p.rows-row<BM?p.rows-row:BM,mr=(rows+15)/16*16;
      WaitFlag<HardEvent::MTE2_MTE1>(static_cast<event_t>(aready));
      const uint8_t pad[4]={0,0,0,0};
      SetFmatrix(1,mr,pad,FmatrixMode::FMATRIX_LEFT);
      for(int ks=0;ks<kr;ks+=BK) {
        const int kb=kr-ks<BK?kr-ks:BK,ls=(lserial_++)&1;
        WaitFlag<HardEvent::M_MTE1>(static_cast<event_t>(lfree[ls]));
        auto aa=ac[ls*BM*BK],ba=bc[ls*TN*BK];
        LoadData3DParamsV2Pro la;
        la.channelSize=kb;la.extConfig=((uint64_t)mr<<16)|kb;
        LoadData(aa,al[ks*mr],la);
        if(kb>=nr) {
          LoadData2dTransposeParams lb{0,(uint8_t)(kb/32),1,(uint16_t)(nr/16-1),0};
          for(int ni=0;ni<nr;ni+=32)
            LoadDataWithTranspose(ba[ni*32],bl[ni*kr+ks*32],lb);
        } else {
          LoadData2dTransposeParams lb{0,(uint8_t)(nr/32),(uint16_t)(kr/32),1,0};
          for(int ki=0;ki<kb;ki+=32)
            LoadDataWithTranspose(ba[ki*nr],bl[(ks+ki)*32],lb);
        }
        if(ks+kb==kr) {
          SetFlag<HardEvent::MTE1_MTE2>(static_cast<event_t>(afree));
          if(row+rows==p.rows)
            SetFlag<HardEvent::MTE1_MTE2>(static_cast<event_t>(bfree[bs]));
          else PrepareA(p,row+rows);
        }
        SetFlag<HardEvent::MTE1_M>(static_cast<event_t>(lready[ls]));
        WaitFlag<HardEvent::MTE1_M>(static_cast<event_t>(lready[ls]));
        MmadParams mp;
        mp.m=mr;mp.n=nr;mp.k=kb;mp.cmatrixInitVal=ks==0;
        mp.unitFlag=ks+kb==kr?3:2;
        Mmad(cc,aa,ba,mp);
        if((mr/16)*(nr/16)<10)PipeBarrier<PIPE_M>();
        SetFlag<HardEvent::M_MTE1>(static_cast<event_t>(lfree[ls]));
      }
      const int slot=produced_&1;
      if(produced_>=2)CrossCoreWaitFlag<2>(1+2*slot);
      FixpipeParamsV220 fp;
      fp.nSize=nr;fp.mSize=mr;fp.srcStride=mr;fp.dstStride=TN;fp.unitFlag=3;
      Fixpipe(output_[((int64_t)core_*2+slot)*BM*TN],cc,fp);
      CrossCoreSetFlag<2,PIPE_FIX>(2*slot);++produced_;
    }
  }
public:
  __aicore__ inline void Init(GlobalTensor<int32_t> out,int core) {
    output_=out;core_=core;
    ab=LocalTensor<int8_t>(TPosition::A1,0,BM*FK);
    bb=LocalTensor<int8_t>(TPosition::B1,BM*FK,2*TN*FK);
    a0=LocalTensor<int8_t>(TPosition::A2,0,2*BM*BK);
    b0=LocalTensor<int8_t>(TPosition::B2,0,2*TN*BK);
    cb=LocalTensor<int32_t>(TPosition::CO1,0,BM*TN);
    SetMMRowMajor();
    afree=static_cast<TEventID>(0);
    aready=static_cast<TEventID>(0);
    SetFlag<HardEvent::MTE1_MTE2>(static_cast<event_t>(afree));
    for(int i=0;i<2;++i) {
      bfree[i]=static_cast<TEventID>(i+1);
      bready[i]=static_cast<TEventID>(i+1);
      lfree[i]=static_cast<TEventID>(i+3);
      lready[i]=static_cast<TEventID>(i);
      SetFlag<HardEvent::MTE1_MTE2>(static_cast<event_t>(bfree[i]));
      SetFlag<HardEvent::M_MTE1>(static_cast<event_t>(lfree[i]));
    }
  }
  __aicore__ inline void Push(GlobalTensor<int8_t> a,GlobalTensor<int8_t> b,
    int rows,int cols,int depth,int strideB,bool lastA,bool lastB) {
    if(rows<=0)return;
    Task next={a,b,rows,cols,depth,strideB,tasks_,lastA,lastB};
    if(!pending_) { PrepareA(next,0);PrepareB(next); }
    else { PrepareB(next);Compute(saved_);PrepareA(next,0); }
    saved_=next;pending_=true;++tasks_;
  }
  __aicore__ inline void End() {
    if(pending_)Compute(saved_);
    if(produced_>1)CrossCoreWaitFlag<2>(1+2*((produced_-2)&1));
    if(produced_>0)CrossCoreWaitFlag<2>(1+2*((produced_-1)&1));
    WaitFlag<HardEvent::MTE1_MTE2>(static_cast<event_t>(afree));
    for(int i=0;i<2;++i) {
      WaitFlag<HardEvent::MTE1_MTE2>(static_cast<event_t>(bfree[i]));
      WaitFlag<HardEvent::M_MTE1>(static_cast<event_t>(lfree[i]));
    }
    PipeBarrier<PIPE_ALL>();SetMMColumnMajor();
    for(int i=0;i<2;++i) {
    }
  }
};
template<int TN>
__global__ __mix__(1,2) void ComputeMediumResident(
GM_ADDR x,GM_ADDR weight,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,GM_ADDR workspace,
int M,int N,int K,int E,TCubeTiling tiling)
{
constexpr int TM=192,SCOLS=TN/2,VCOLS=(SCOLS+63)/64*64,VCOUNT=TM*VCOLS;
InitSocState();
GlobalTensor<int8_t> ag,bg;GlobalTensor<int64_t> gg;
GlobalTensor<int32_t> cg;GlobalTensor<float> sg;GlobalTensor<half> yg;
ag.SetGlobalBuffer((__gm__ int8_t*)x);bg.SetGlobalBuffer((__gm__ int8_t*)weight);
gg.SetGlobalBuffer((__gm__ int64_t*)groups);cg.SetGlobalBuffer((__gm__ int32_t*)workspace);
sg.SetGlobalBuffer((__gm__ float*)scale);yg.SetGlobalBuffer((__gm__ half*)y);
const int cores=GetBlockNum(),nc=(N+TN-1)/TN;
const int nblocks=(N+31)/32;
if ASCEND_IS_AIC {
 const int core=GetBlockIdx();
 MediumResidentColumns<TN> mm;mm.Init(cg,core);
 int panels=0,prior=0;
 for(int e=0;e<E;++e){const int end=(int)gg.GetValue(e);panels+=(end-prior+TM-1)/TM;prior=end;}
 const int lower=panels*nc*core/cores,upper=panels*nc*(core+1)/cores;
 int prefix=0,start=0;
 for(int e=0;e<E && prefix<upper;++e){
 const int end=(int)gg.GetValue(e),count=(end-start+TM-1)/TM;
 for(int ni=0;ni<nc && prefix<upper;++ni){
  const int first=lower>prefix?lower-prefix:0;
  const int last=upper-prefix<count?upper-prefix:count;
  prefix+=count;
  if(first>=last)continue;
  const int begin=start+first*TM,finish=start+last*TM<end?start+last*TM:end;
  const int col=(nblocks*ni/nc)*32;
  const int tileLimit=(nblocks*(ni+1)/nc)*32;
  const int cols=(tileLimit<N?tileLimit:N)-col;
  mm.Push(ag[(int64_t)begin*K],bg[(int64_t)e*K*N+col],finish-begin,cols,K,N,finish==M,e==E-1);
 }
 start=end;
 }
 mm.End();
}
if ASCEND_IS_AIV {
 const int core=GetBlockIdx()/2,sub=GetBlockIdx()%2;
 TPipe pipe;TQue<TPosition::VECIN,1> cq,sq;TQue<TPosition::VECOUT,1> oq;
 TBuf<TPosition::VECCALC> tb;
 pipe.InitBuffer(cq,1,VCOUNT*4);pipe.InitBuffer(sq,1,VCOLS*4);
 pipe.InitBuffer(oq,1,VCOUNT*2);pipe.InitBuffer(tb,VCOUNT*4);
 auto t=tb.Get<float>();int consumed=0;
 int panels=0,prior=0;
 for(int e=0;e<E;++e){const int end=(int)gg.GetValue(e);panels+=(end-prior+TM-1)/TM;prior=end;}
 const int lower=panels*nc*core/cores,upper=panels*nc*(core+1)/cores;
 int prefix=0,start=0;
 for(int e=0;e<E && prefix<upper;++e){
 const int end=(int)gg.GetValue(e),count=(end-start+TM-1)/TM;
 for(int ni=0;ni<nc && prefix<upper;++ni){
  const int first=lower>prefix?lower-prefix:0;
  const int last=upper-prefix<count?upper-prefix:count;
  prefix+=count;
  if(first>=last)continue;
  const int begin=start+first*TM,finish=start+last*TM<end?start+last*TM:end;
  const int tileCol=(nblocks*ni/nc)*32;
  for(int row=begin;row<finish;row+=TM){
  const int rows=finish-row<TM?finish-row:TM,col=tileCol+sub*SCOLS;
  const int tileLimit=(nblocks*(ni+1)/nc)*32;
  const int tileEnd=tileLimit<N?tileLimit:N;
  const int cols=tileEnd-col<SCOLS?tileEnd-col:SCOLS,slot=consumed&1;
  CrossCoreWaitFlag<2>(2*slot);
        if (rows > 0 && cols > 0) {
          const int pitch = (cols + 63) / 64 * 64;
          auto c = cq.AllocTensor<int32_t>();
          auto s = sq.AllocTensor<float>();
          DataCopyPad(c, cg[((int64_t)core * 2 + slot) * TM * TN + sub * SCOLS],
            DataCopyExtParams{(uint16_t)rows, (uint32_t)(cols * 4),
              (uint32_t)((TN - cols) * 4), (uint32_t)((pitch - (cols + 7) / 8 * 8) / 8), 0},
            DataCopyPadExtParams<int32_t>{true, 0, 0, 0});
          DataCopyPad(s, sg[(int64_t)e * N + col],
            DataCopyExtParams{1, (uint32_t)(cols * 4), 0, 0, 0},
            DataCopyPadExtParams<float>{true, 0, 0, 0.0f});
          cq.EnQue(c);
          sq.EnQue(s);
          c = cq.DeQue<int32_t>();
          s = sq.DeQue<float>();
          CrossCoreSetFlag<2, PIPE_MTE2>(1 + 2 * slot);
          auto z = c.ReinterpretCast<float>();
          Cast(z, c, RoundMode::CAST_RINT, rows * pitch);
          PipeBarrier<PIPE_V>();
          if constexpr (TM > 255) {
            for(int r0=0;r0<rows;r0+=255){
              const uint8_t repeats=(uint8_t)(rows-r0<255?rows-r0:255);
              for(int c0=0;c0<pitch;c0+=64)
                Mul(z[r0*pitch+c0],z[r0*pitch+c0],s[c0],(uint64_t)64,repeats,
                  BinaryRepeatParams{1,1,1,(uint8_t)(pitch/8),(uint8_t)(pitch/8),0});
            }
          } else {
            for (int c0 = 0; c0 < pitch; c0 += 64)
              Mul(z[c0], z[c0], s[c0], (uint64_t)64, (uint8_t)rows,
                BinaryRepeatParams{1, 1, 1, (uint8_t)(pitch / 8), (uint8_t)(pitch / 8), 0});
          }
          PipeBarrier<PIPE_V>();
          GeluResident(z,t,rows*pitch);
          auto out = oq.AllocTensor<half>();
          Cast(out, z, RoundMode::CAST_RINT, rows * pitch);
          oq.EnQue(out);
          out = oq.DeQue<half>();
          DataCopyPad(yg[(int64_t)row * N + col], out,
            DataCopyExtParams{(uint16_t)rows, (uint32_t)(cols * 2),
              (uint32_t)((pitch - (cols + 15) / 16 * 16) / 16),
              (uint32_t)((N - cols) * 2), 0});
          oq.FreeTensor(out);
          sq.FreeTensor(s);
          cq.FreeTensor(c);
        } else {
          CrossCoreSetFlag<2, PIPE_MTE2>(1 + 2 * slot);
        }
  ++consumed;
  }
 }
 start=end;
 }
}
}
template<int TN>
void LaunchMediumResident(GM_ADDR x,GM_ADDR weight,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,
int M,int N,int K,int E,int cores,aclrtStream stream){
const int tasks=((M+191)/192+E-1)*((N+TN-1)/TN);if(cores>tasks)cores=tasks;
TCubeTiling tiling{};void* scratch=nullptr;
if(aclrtMalloc(&scratch,(int64_t)cores*2*192*TN*4,ACL_MEM_MALLOC_HUGE_FIRST)!=ACL_SUCCESS)return;
ComputeMediumResident<TN><<<cores,nullptr,stream>>>(x,weight,scale,groups,y,(GM_ADDR)scratch,M,N,K,E,tiling);
aclrtSynchronizeStream(stream);aclrtFree(scratch);
}
}
namespace Resident {
constexpr MatmulConfig MM_CONFIG =
  GetMDLConfig(false, false, 0, false, false, false, true, true, true, false, false, true);
constexpr MatmulConfig NORMAL_CONFIG = GetNormalConfig(false, false, false,
  BatchMode::NONE, true, IterateOrder::UNDEF, ScheduleType::INNER_PRODUCT,
  true, false, BatchOutMode::SINGLE_BATCH);
using AType = matmul::MatmulType<TPosition::GM, CubeFormat::ND, int8_t, false>;
using BType = matmul::MatmulType<TPosition::GM, CubeFormat::ND, int8_t, false>;
using CType = matmul::MatmulType<TPosition::GM, CubeFormat::ND, int32_t>;
using BiasType = matmul::MatmulType<TPosition::GM, CubeFormat::ND, int32_t>;
template<bool USE_NORMAL, typename CALLBACK> struct MatmulSelect;
template<typename CALLBACK> struct MatmulSelect<false, CALLBACK> {
  using Type = matmul::MatmulImpl<AType, BType, CType, BiasType, MM_CONFIG, CALLBACK>;
};
template<typename CALLBACK> struct MatmulSelect<true, CALLBACK> {
  using Type = matmul::MatmulImpl<AType, BType, CType, BiasType, NORMAL_CONFIG, CALLBACK>;
};
__aicore__ inline int SingleRowExpert(GlobalTensor<int64_t> groups,int E)
{
  if(E==1 || groups.GetValue(0)>0)return 0;
  int lo=1,hi=E-1;
  while(lo<hi){
    const int mid=(lo+hi)/2;
    if(groups.GetValue(mid)==0)lo=mid+1;else hi=mid;
  }
  return lo;
}
__aicore__ inline int SingleRowExpert(LocalTensor<int32_t> groups,int E)
{
  if(E==1 || groups.GetValue(0)>0)return 0;
  int lo=1,hi=E-1;
  while(lo<hi){
    const int mid=(lo+hi)/2;
    if(groups.GetValue(2*mid)==0)lo=mid+1;else hi=mid;
  }
  return lo;
}
__aicore__ inline void PadRows(GlobalTensor<int8_t> dst, GlobalTensor<int8_t> src,
  int64_t rows, int width, int padded)
{
  TPipe pipe;
  TBuf<TPosition::VECCALC> buffer;
  pipe.InitBuffer(buffer, 32768);
  auto data = buffer.Get<int8_t>();
  const int chunk = 32768 / padded;
  const int blocks = GetBlockNum() * 2;
  for (int64_t row = (int64_t)GetBlockIdx() * chunk; row < rows; row += (int64_t)blocks * chunk) {
    int count = rows - row < chunk ? rows - row : chunk;
    DataCopyPad(data, src[row * width],
      DataCopyExtParams{(uint16_t)count, (uint32_t)width, 0, 0, 0},
      DataCopyPadExtParams<int8_t>{true, 0, (uint8_t)(padded - width), 0});
    SetFlag<HardEvent::MTE2_MTE3>(EVENT_ID0);
    WaitFlag<HardEvent::MTE2_MTE3>(EVENT_ID0);
    DataCopy(dst[row * padded], data, count * padded);
    SetFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);
    WaitFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);
  }
}
__aicore__ inline void WordCopy(const LocalTensor<int8_t>& dst, const __gm__ int8_t* ptr,
  int height, int width, int stride, int paddedHeight, bool finalRow)
{
  const int count=height-((width%4 && finalRow)?1:0);
  const int groups=stride%4==0?1:(stride%2==0?2:4);
  auto d32=dst.ReinterpretCast<int32_t>();
  for (int g=0;g<groups && g<count;++g) {
    GlobalTensor<int32_t> src;
    src.SetGlobalBuffer((__gm__ int32_t*)(ptr+(int64_t)g*stride));
    DataCopy(d32[g*8],src,Nd2NzParams{1,(uint16_t)((count-g+groups-1)/groups),
      (uint16_t)((width+3)/4),0,(uint16_t)(stride*groups/4),
      (uint16_t)paddedHeight,(uint16_t)groups,0});
  }
  if (count<height) {
    GlobalTensor<int8_t> src;
    src.SetGlobalBuffer((__gm__ int8_t*)(ptr+(int64_t)(height-1)*stride));
    DataCopy(dst[(height-1)*32],src,Nd2NzParams{1,1,(uint16_t)width,0,
      (uint16_t)stride,(uint16_t)paddedHeight,1,0});
  }
}
__aicore__ inline void PairCopy(const LocalTensor<int8_t>& dst, const __gm__ int8_t* ptr,
  int height, int width, int stride, int paddedHeight, bool allowOdd, bool finalRow, bool preferWord)
{
  if (allowOdd && stride >= 4 && (stride <= 64 || preferWord)) {
    WordCopy(dst,ptr,height,width,stride,paddedHeight,finalRow);
    return;
  }
  GlobalTensor<int8_t> src;
  src.SetGlobalBuffer((__gm__ int8_t*)ptr);
  if ((width & 1) && !allowOdd) {
    DataCopy(dst,src,Nd2NzParams{1,(uint16_t)height,(uint16_t)width,0,
      (uint16_t)stride,(uint16_t)paddedHeight,1,0});
    return;
  }
  const int count=height-(((width&1)&&finalRow)?1:0);
  const int pairs=(width+1)/2;
  if (count>0) {
    auto d16=dst.ReinterpretCast<int16_t>();
    GlobalTensor<int16_t> s16;
    s16.SetGlobalBuffer((__gm__ int16_t*)ptr);
    if (stride % 2 == 0) {
      DataCopy(d16,s16,Nd2NzParams{1,(uint16_t)count,(uint16_t)pairs,0,
        (uint16_t)(stride/2),(uint16_t)paddedHeight,1,0});
    } else {
      DataCopy(d16,s16,Nd2NzParams{1,(uint16_t)((count+1)/2),(uint16_t)pairs,0,
        (uint16_t)stride,(uint16_t)paddedHeight,2,0});
      if (count>1) {
        s16.SetGlobalBuffer((__gm__ int16_t*)(ptr+stride));
        DataCopy(d16[16],s16,Nd2NzParams{1,(uint16_t)(count/2),(uint16_t)pairs,0,
          (uint16_t)stride,(uint16_t)paddedHeight,2,0});
      }
    }
  }
  if (count<height) {
    DataCopy(dst[(height-1)*32],src[(int64_t)(height-1)*stride],
      Nd2NzParams{1,1,(uint16_t)width,0,(uint16_t)stride,(uint16_t)paddedHeight,1,0});
  }
}
__aicore__ inline void PairA(const LocalTensor<int8_t>& dst, const __gm__ void* gm,
  int row, int col, int useM, int useK, uint64_t unused, uint64_t meta)
{
  int stride=meta&0x3fff;
  int bm=((meta>>41)&15)*16;
  int bk=((meta>>50)&31)*32;
  auto ptr=(const __gm__ int8_t*)gm+(int64_t)row*bm*stride+col*bk;
  const bool odd=(useK&1)!=0;
  PairCopy(dst,ptr,useM,useK,stride,(useM+15)/16*16,
    odd,odd && ((meta>>62)&1),false);
}
__aicore__ inline void PairB(const LocalTensor<int8_t>& dst, const __gm__ void* gm,
  int row, int col, int useK, int useN, uint64_t unused, uint64_t meta)
{
  int stride=(meta>>14)&0x1fff;
  int k=(meta>>27)&0x3fff;
  int bn=((meta>>45)&31)*32;
  int bk=((meta>>50)&31)*32;
  bool finalRow=((meta>>55)&1) && row*bk+useK==k;
  auto ptr=(const __gm__ int8_t*)gm+(int64_t)row*bk*stride+col*bn;
  const int paddedK=(useK+31)/32*32;
  PairCopy(dst,ptr,useK,useN,stride,paddedK,true,finalRow,(meta>>56)&1);
  if((useK&1) && useN>0){
    InitConstValue(dst.ReinterpretCast<int32_t>()[useK*8],
      InitConstValueParams<int32_t>{(uint16_t)((useN+31)/32),
        (uint16_t)(paddedK-useK),(uint16_t)useK,0});
  }
}
__aicore__ inline void AdaptiveB(const LocalTensor<int8_t>& dst,const __gm__ void* gm,
  int row,int col,int useK,int useN,uint64_t unused,uint64_t meta)
{
  const int stride=(meta>>14)&0x1fff;
  const int bn=((meta>>45)&31)*32;
  const int outer=(int)((meta>>57)&31)*128;
  const int valid=stride-outer-col*bn;
  PairB(dst,gm,row,col,useK,useN<valid?useN:valid,unused,meta);
}
template<bool ENABLED> struct TransportCallback;
template<> struct TransportCallback<true> {
  using Type=MatmulCallBackFunc<nullptr,PairA,AdaptiveB>;
};
template<> struct TransportCallback<false> {
  using Type=MatmulCallBackFunc<nullptr,nullptr,nullptr>;
};
template<int TM, int TN>
class DirectSingleMatmul {
  static constexpr int CK = 65536 / (TM > TN ? TM : TN);
  static_assert(TM * TN * sizeof(int32_t) <= 128 * 1024);
  TBuf<TPosition::A1> ab;
  TBuf<TPosition::B1> bb;
  TBuf<TPosition::A2> a0;
  TBuf<TPosition::B2> b0;
  TBuf<TPosition::CO1> cb;
  GlobalTensor<int8_t> a, b;
  uint64_t meta = 0;
  int rows, cols, depth;
  bool previous = false;
  const __gm__ int8_t* cached_b = nullptr;
  uint64_t cached_b_meta = 0;
  int cached_b_cols = 0, cached_b_depth = 0;
  TPipe* pipe_;
  TEventID event_MTE1_MTE2;
  TEventID event_MTE2_MTE1;
  TEventID event_M_MTE1;
  TEventID event_MTE1_M;
  TEventID event_FIX_M;
  TEventID event_M_FIX;
public:
  __aicore__ inline void SetSubBlockIdx(int) {}
  __aicore__ inline void Init(TCubeTiling*, TPipe* pipe) {
    pipe->InitBuffer(ab, TM * CK);
    pipe->InitBuffer(bb, CK * TN);
    pipe->InitBuffer(a0, TM * CK);
    pipe->InitBuffer(b0, CK * TN);
    pipe->InitBuffer(cb, TM * TN * sizeof(int32_t));
    pipe_ = pipe;
    event_MTE1_MTE2 = pipe->AllocEventID<HardEvent::MTE1_MTE2>();
    event_MTE2_MTE1 = pipe->AllocEventID<HardEvent::MTE2_MTE1>();
    event_M_MTE1 = pipe->AllocEventID<HardEvent::M_MTE1>();
    event_MTE1_M = pipe->AllocEventID<HardEvent::MTE1_M>();
    event_FIX_M = pipe->AllocEventID<HardEvent::FIX_M>();
    event_M_FIX = pipe->AllocEventID<HardEvent::M_FIX>();
  }
  __aicore__ inline void SetOrgShape(int, int, int, int, int) {}
  __aicore__ inline void SetSingleShape(int m, int n, int k) {
    rows = m; cols = n; depth = k;
  }
  __aicore__ inline void SetSelfDefineData(uint64_t value) { meta = value; }
  __aicore__ inline void SetTensorA(GlobalTensor<int8_t> value, bool) { a = value; }
  __aicore__ inline void SetTensorB(GlobalTensor<int8_t> value, bool) { b = value; }
  __aicore__ inline void End() {
    PipeBarrier<PIPE_ALL>();
    pipe_->ReleaseEventID<HardEvent::MTE1_MTE2>(event_MTE1_MTE2);
    pipe_->ReleaseEventID<HardEvent::MTE2_MTE1>(event_MTE2_MTE1);
    pipe_->ReleaseEventID<HardEvent::M_MTE1>(event_M_MTE1);
    pipe_->ReleaseEventID<HardEvent::MTE1_M>(event_MTE1_M);
    pipe_->ReleaseEventID<HardEvent::FIX_M>(event_FIX_M);
    pipe_->ReleaseEventID<HardEvent::M_FIX>(event_M_FIX);
  }
  __aicore__ inline void IterateAll(GlobalTensor<int32_t> c, bool) {
    auto al = ab.Get<int8_t>(), bl = bb.Get<int8_t>();
    auto ac = a0.Get<int8_t>(), bc = b0.Get<int8_t>();
    auto cc = cb.Get<int32_t>();
    const int mr = (rows + 15) / 16 * 16;
    const int nr = (cols + 31) / 32 * 32;
    const int kr = (depth + 31) / 32 * 32;
    const auto bptr = b.GetPhyAddr();
    const uint64_t bmeta = meta & ~(uint64_t(1) << 62);
    const bool reuseB = previous && bptr == cached_b && bmeta == cached_b_meta
      && cols == cached_b_cols && depth == cached_b_depth;
    if (previous) {
      SetFlag<HardEvent::MTE1_MTE2>(static_cast<event_t>(event_MTE1_MTE2));
      WaitFlag<HardEvent::MTE1_MTE2>(static_cast<event_t>(event_MTE1_MTE2));
    }
    PairA(al, a.GetPhyAddr(), 0, 0, rows, depth, 0, meta);
    if (!reuseB) {
      AdaptiveB(bl, bptr, 0, 0, depth, cols, 0, meta);
      if (kr != depth && (depth & 1) == 0) {
        const int stride = (meta >> 14) & 0x1fff;
        const int outer = (int)((meta >> 57) & 31) * 128;
        const int valid = stride - outer < cols ? stride - outer : cols;
        InitConstValue(bl.ReinterpretCast<int32_t>()[depth * 8],
          InitConstValueParams<int32_t>{(uint16_t)((valid + 31) / 32),
            (uint16_t)(kr - depth), (uint16_t)depth, 0});
      }
    }
    SetFlag<HardEvent::MTE2_MTE1>(static_cast<event_t>(event_MTE2_MTE1));
    WaitFlag<HardEvent::MTE2_MTE1>(static_cast<event_t>(event_MTE2_MTE1));
    if (previous) {
      SetFlag<HardEvent::M_MTE1>(static_cast<event_t>(event_M_MTE1));
      WaitFlag<HardEvent::M_MTE1>(static_cast<event_t>(event_M_MTE1));
    }
    const uint8_t pad[4] = {0, 0, 0, 0};
    SetFmatrix(1, mr, pad, FmatrixMode::FMATRIX_LEFT);
    LoadData3DParamsV2Pro la;
    la.channelSize = kr;
    la.extConfig = ((uint64_t)mr << 16) | kr;
    LoadData(ac, al, la);
    if (!reuseB) {
      LoadData2dTransposeParams lb{0, (uint8_t)(nr / 32), (uint16_t)(kr / 32), 1, 0};
      for (int ki = 0; ki < kr; ki += 32)
        LoadDataWithTranspose(bc[ki * nr], bl[ki * 32], lb);
    }
    SetFlag<HardEvent::MTE1_M>(static_cast<event_t>(event_MTE1_M));
    WaitFlag<HardEvent::MTE1_M>(static_cast<event_t>(event_MTE1_M));
    if (previous) {
      SetFlag<HardEvent::FIX_M>(static_cast<event_t>(event_FIX_M));
      WaitFlag<HardEvent::FIX_M>(static_cast<event_t>(event_FIX_M));
    }
    MmadParams mp;
    mp.m = mr; mp.n = nr; mp.k = kr; mp.cmatrixInitVal = true;
    Mmad(cc, ac, bc, mp);
    SetFlag<HardEvent::M_FIX>(static_cast<event_t>(event_M_FIX));
    WaitFlag<HardEvent::M_FIX>(static_cast<event_t>(event_M_FIX));
    FixpipeParamsV220 fp;
    fp.nSize = cols; fp.mSize = rows; fp.srcStride = mr; fp.dstStride = TN;
    Fixpipe(c, cc, fp);
    cached_b = bptr; cached_b_meta = bmeta;
    cached_b_cols = cols; cached_b_depth = depth;
    previous = true;
  }
};
template<int TM, int TN, bool NORMAL, bool DIRECT, typename CALLBACK>
struct CubeSelect {
  using Type = typename MatmulSelect<NORMAL, CALLBACK>::Type;
};
template<int TM, int TN, bool NORMAL, typename CALLBACK>
struct CubeSelect<TM, TN, NORMAL, true, CALLBACK> {
  using Type = DirectSingleMatmul<TM, TN>;
};
__aicore__ inline int AdvanceTaskBase(int base,int count,int cores)
{
  const int sum=base+count;
  if(sum<cores)return sum;
  return count<cores?sum-cores:sum%cores;
}
__aicore__ inline void TileCoordinates(int task,int nc,int& mr,int& nr)
{
  if(nc==1){mr=task;nr=0;}
  else if(nc==2){mr=task>>1;nr=task&1;}
  else {mr=task/nc;nr=task-mr*nc;}
}
__aicore__ inline void GeluBounded(LocalTensor<float> z,LocalTensor<float> t,int count)
{
  const BinaryRepeatParams binary{1,1,1,8,8,8};
  const UnaryRepeatParams unary{1,1,8,8};
  for(int offset=0;offset<count;){
    const int remaining=count-offset;
    const int full=remaining/64;
    const uint8_t repeats=(uint8_t)(full>255?255:(full>0?full:1));
    const uint64_t mask=full>0?64:(uint64_t)remaining;
    auto a=z[offset];auto b=t[offset];
    Mul(b,a,a,mask,repeats,binary);PipeBarrier<PIPE_V>();
    Muls(b,b,-0.07135481627260025f,mask,repeats,unary);PipeBarrier<PIPE_V>();
    Adds(b,b,-1.5957691216057308f,mask,repeats,unary);PipeBarrier<PIPE_V>();
    Mul(b,b,a,mask,repeats,binary);PipeBarrier<PIPE_V>();
    Maxs(b,b,-87.0f,mask,repeats,unary);PipeBarrier<PIPE_V>();
    Mins(b,b,87.0f,mask,repeats,unary);PipeBarrier<PIPE_V>();
    Exp(b,b,mask,repeats,unary);PipeBarrier<PIPE_V>();
    Adds(b,b,1.0f,mask,repeats,unary);PipeBarrier<PIPE_V>();
    Div(a,a,b,mask,repeats,binary);PipeBarrier<PIPE_V>();
    offset+=full>0?(int)repeats*64:(int)mask;
  }
}
constexpr MatmulConfig RESIDENT_PRELOAD_CONFIG =
  GetMDLConfig(false,false,1,false,false,false,true,true,true,false,false,true);
template<bool PRELOAD>struct ResidentConfig;
template<>struct ResidentConfig<false>{static constexpr MatmulConfig value=MM_CONFIG;};
template<>struct ResidentConfig<true>{static constexpr MatmulConfig value=RESIDENT_PRELOAD_CONFIG;};
__aicore__ inline void PadActiveWeights(GlobalTensor<int8_t> dst,
  GlobalTensor<int8_t> src, GlobalTensor<int64_t> groups,
  int experts, int depth, int width, int padded)
{
  TPipe pipe;
  TBuf<TPosition::VECCALC> buffer;
  pipe.InitBuffer(buffer, 32768);
  auto data = buffer.Get<int8_t>();
  const int chunk = 32768 / padded;
  const int chunks = (depth + chunk - 1) / chunk;
  const int blocks = GetBlockNum() * 2;
  for (int task = GetBlockIdx(); task < experts * chunks; task += blocks) {
    const int expert = task / chunks;
    const int begin = expert == 0 ? 0 : (int)groups.GetValue(expert - 1);
    const int end = (int)groups.GetValue(expert);
    if (begin == end) continue;
    const int row = (task % chunks) * chunk;
    const int count = depth - row < chunk ? depth - row : chunk;
    DataCopyPad(data, src[((int64_t)expert * depth + row) * width],
      DataCopyExtParams{(uint16_t)count, (uint32_t)width, 0, 0, 0},
      DataCopyPadExtParams<int8_t>{true, 0, (uint8_t)(padded - width), 0});
    SetFlag<HardEvent::MTE2_MTE3>(EVENT_ID0);
    WaitFlag<HardEvent::MTE2_MTE3>(EVENT_ID0);
    DataCopy(dst[((int64_t)expert * depth + row) * padded], data, count * padded);
    SetFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);
    WaitFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);
  }
}
template<int TM, int TN, bool PADDED, bool PRELOAD>
__global__ __mix__(1, 2) void ComputeResidentB(
  GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groups,
  GM_ADDR y, GM_ADDR workspace, int M, int N, int K, int E, TCubeTiling tiling)
{
  constexpr bool TRANSPORT=true, USE_NORMAL=false, USE_DIRECT=false;
  InitSocState();
  GlobalTensor<int8_t> ag, bg;
  GlobalTensor<int64_t> gg;
  GlobalTensor<int32_t> cg;
  GlobalTensor<float> sg;
  GlobalTensor<half> yg;
  ag.SetGlobalBuffer((__gm__ int8_t*)x);
  bg.SetGlobalBuffer((__gm__ int8_t*)weight);
  gg.SetGlobalBuffer((__gm__ int64_t*)groups);
  cg.SetGlobalBuffer((__gm__ int32_t*)workspace);
  sg.SetGlobalBuffer((__gm__ float*)scale);
  yg.SetGlobalBuffer((__gm__ half*)y);
  const int ka = K;
  const int nb = PADDED ? (N + 31) / 32 * 32 : N;
  if constexpr (PADDED) {
    auto base = workspace + (int64_t)GetBlockNum() * 2 * TM * TN * sizeof(int32_t);
    GlobalTensor<int8_t> bp;
    bp.SetGlobalBuffer((__gm__ int8_t*)base);
    if ASCEND_IS_AIV {
      PadActiveWeights(bp, bg, gg, E, K, N, nb);
    }
    SyncAll<false>();
    bg = bp;
  }
  const int nc = (N + TN - 1) / TN;
  const int cores = GetBlockNum();
  const bool shardExperts = M!=1 && E >= 2 * cores && N <= 512 && K <= 512;
  if ASCEND_IS_AIC {
    TPipe pipe;
    matmul::MatmulImpl<AType,BType,CType,BiasType,ResidentConfig<PRELOAD>::value,typename TransportCallback<true>::Type> mm;
    mm.SetSubBlockIdx(0);
    mm.Init(&tiling, &pipe);
    mm.SetOrgShape(M, TRANSPORT ? (N+31)/32*32 : nb, ka, K, TN);
    uint64_t meta=0;
    if constexpr (TRANSPORT || USE_DIRECT)
      meta=(uint64_t)ka|((uint64_t)nb<<14)|((uint64_t)K<<27)
        |((uint64_t)(tiling.baseM/16)<<41)|((uint64_t)(tiling.baseN/32)<<45)
        |((uint64_t)(tiling.baseK/32)<<50)|((uint64_t)PADDED<<56);
    int taskBase = 0;
    int start = 0;
    int produced = 0;
    int tileCount = 0;
    const int eFirst = M==1 ? SingleRowExpert(gg,E) : (shardExperts ? GetBlockIdx() : 0);
    const int eStep = M==1 ? E : (shardExperts ? cores : 1);
    for (int e = eFirst; e < E; e += eStep) {
      if (shardExperts) start = e == 0 ? 0 : (int)gg.GetValue(e - 1);
      int end = (int)gg.GetValue(e);
      int tiles = ((end - start + TM - 1) / TM) * nc;
      if(tiles==0){start=end;continue;}
      int first = shardExperts ? 0 : GetBlockIdx()-taskBase;
      if(first<0)first+=cores;
      const int taskStep = shardExperts ? 1 : cores;
      for (int task = first; task < tiles; task += taskStep) {
        const int scratchSlot = tileCount & 1;
        int mr,nr;TileCoordinates(task,nc,mr,nr);
        int row = start + mr * TM;
        int col = nr * TN;
        int rows = end - row < TM ? end - row : TM;
        int cols = N - col < TN ? N - col : TN;
        if constexpr (TRANSPORT || USE_DIRECT) {
          mm.SetSelfDefineData(meta|((uint64_t)(e==E-1 && nb==N)<<55)
            |((uint64_t)(col/128)<<57)|((uint64_t)(row+rows==M)<<62));
        }
        mm.SetSingleShape(rows, TRANSPORT ? (cols+31)/32*32 : cols, K);
        mm.SetTensorA(ag[(int64_t)row * ka], false);
        mm.SetTensorB(bg[(int64_t)e * K * nb + col], false);
        while (mm.Iterate()) {
          const int slot = produced & 1;
          if (produced >= 2) CrossCoreWaitFlag<2>(1 + 2 * slot);
          mm.GetTensorC(cg[((int64_t)GetBlockIdx() * 2 + scratchSlot) * TM * TN]);
          CrossCoreSetFlag<2, PIPE_FIX>(2 * slot);
          ++produced;
        }
        ++tileCount;
      }
      if(!shardExperts)taskBase=AdvanceTaskBase(taskBase,tiles,cores);
      start = end;
    }
    if (produced > 1) CrossCoreWaitFlag<2>(1 + 2 * ((produced - 2) & 1));
    if (produced > 0) CrossCoreWaitFlag<2>(1 + 2 * ((produced - 1) & 1));
    mm.End();
  }
  if ASCEND_IS_AIV {
    const int core = GetBlockIdx() / 2;
    const int sub = GetBlockIdx() % 2;
    constexpr int VCOLS = TN / 2;
    constexpr int CHUNK_ROWS = (128 * 1024) / (TN * sizeof(int32_t));
    constexpr int VCOUNT = CHUNK_ROWS * VCOLS;
    TPipe pipe;
    TQue<TPosition::VECIN, 1> cq, sq;
    TQue<TPosition::VECOUT, 1> oq;
    TBuf<TPosition::VECCALC> tb;
    pipe.InitBuffer(cq, 1, VCOUNT * sizeof(int32_t));
    pipe.InitBuffer(sq, 1, VCOLS * sizeof(float));
    pipe.InitBuffer(oq, 1, VCOUNT * sizeof(half));
    pipe.InitBuffer(tb, VCOUNT * sizeof(float));
    auto t = tb.Get<float>();
    int consumed = 0;
    int tileCount = 0;
    int taskBase = 0;
    int start = 0;
    const int eFirst = M==1 ? SingleRowExpert(gg,E) : (shardExperts ? core : 0);
    const int eStep = M==1 ? E : (shardExperts ? cores : 1);
    for (int e = eFirst; e < E; e += eStep) {
      if (shardExperts) start = e == 0 ? 0 : (int)gg.GetValue(e - 1);
      int end = (int)gg.GetValue(e);
      int tiles = ((end - start + TM - 1) / TM) * nc;
      if(tiles==0){start=end;continue;}
      int first = shardExperts ? 0 : core-taskBase;
      if(first<0)first+=cores;
      const int taskStep = shardExperts ? 1 : cores;
      for (int task = first; task < tiles; task += taskStep) {
        int mr,nr;TileCoordinates(task,nc,mr,nr);
        int row = start + mr * TM;
        int col = nr * TN + sub * VCOLS;
        int rows = end - row < TM ? end - row : TM;
        int cols = N - col < VCOLS ? N - col : VCOLS;
        const int scratchSlot = tileCount & 1;
        for (int chunkRow=0;chunkRow<rows;chunkRow+=tiling.baseM) {
          const int chunkRows=rows-chunkRow<tiling.baseM?rows-chunkRow:tiling.baseM;
          const int slot = consumed & 1;
          CrossCoreWaitFlag<2>(2 * slot);
          if (cols > 0) {
          auto c = cq.AllocTensor<int32_t>();
          auto s = sq.AllocTensor<float>();
          DataCopyPad(c, cg[((int64_t)core * 2 + scratchSlot) * TM * TN + chunkRow * TN + sub * VCOLS],
            DataCopyExtParams{(uint16_t)chunkRows, (uint32_t)(cols * 4),
              (uint32_t)((TN - cols) * 4), (uint32_t)((VCOLS - (cols + 7) / 8 * 8) / 8), 0},
            DataCopyPadExtParams<int32_t>{true, 0, 0, 0});
          DataCopyPad(s, sg[(int64_t)e * N + col],
            DataCopyExtParams{1, (uint32_t)(cols * 4), 0, 0, 0},
            DataCopyPadExtParams<float>{true, 0, 0, 0.0f});
          cq.EnQue(c);
          sq.EnQue(s);
          c = cq.DeQue<int32_t>();
          s = sq.DeQue<float>();
          CrossCoreSetFlag<2, PIPE_MTE2>(1 + 2 * slot);
          auto z = c.ReinterpretCast<float>();
          Cast(z, c, RoundMode::CAST_RINT, chunkRows * VCOLS);
          PipeBarrier<PIPE_V>();
          if constexpr (TM > 255) {
            for(int r0=0;r0<chunkRows;r0+=255){
              const uint8_t repeats=(uint8_t)(chunkRows-r0<255?chunkRows-r0:255);
              for(int c0=0;c0<VCOLS;c0+=64)
                Mul(z[r0*VCOLS+c0],z[r0*VCOLS+c0],s[c0],(uint64_t)64,repeats,
                  BinaryRepeatParams{1,1,1,VCOLS/8,VCOLS/8,0});
            }
          } else {
            for (int c0 = 0; c0 < VCOLS; c0 += 64)
              Mul(z[c0], z[c0], s[c0], (uint64_t)64, (uint8_t)chunkRows,
                BinaryRepeatParams{1, 1, 1, VCOLS / 8, VCOLS / 8, 0});
          }
          PipeBarrier<PIPE_V>();
          GeluBounded(z,t,chunkRows*VCOLS);
          auto out = oq.AllocTensor<half>();
          Cast(out, z, RoundMode::CAST_RINT, chunkRows * VCOLS);
          oq.EnQue(out);
          out = oq.DeQue<half>();
          DataCopyPad(yg[(int64_t)(row + chunkRow) * N + col], out,
            DataCopyExtParams{(uint16_t)chunkRows, (uint32_t)(cols * 2),
              (uint32_t)((VCOLS - (cols + 15) / 16 * 16) / 16),
              (uint32_t)((N - cols) * 2), 0});
          oq.FreeTensor(out);
          sq.FreeTensor(s);
          cq.FreeTensor(c);
          } else {
            CrossCoreSetFlag<2, PIPE_MTE2>(1 + 2 * slot);
          }
          ++consumed;
        }
        ++tileCount;
      }
      if(!shardExperts)taskBase=AdvanceTaskBase(taskBase,tiles,cores);
      start = end;
    }
  }
}
template<int TN>
class ManualResidentEarlyA {
  static constexpr int BM=128, BK=128, COPY_K=2*BK;
  static constexpr int CPITCH=(TN+127)/128*128;
  static constexpr int FK=(524288/(2*BM+TN)/BK)*BK;
  static constexpr int STAGES=(FK+COPY_K-1)/COPY_K;
  static_assert(TN==256, "Full L0C-width resident tile");
  static_assert(STAGES+2<=8);
  static_assert((2*BM+TN)*FK<=512*1024);
  static_assert(2*BM*BK<=64*1024 && 2*TN*BK<=64*1024);
  static_assert(BM*TN*sizeof(int32_t)<=128*1024);
  TBuf<TPosition::A1> ab;
  TBuf<TPosition::B1> bb;
  TBuf<TPosition::A2> a0;
  TBuf<TPosition::B2> b0;
  TBuf<TPosition::CO1> cb;
  GlobalTensor<int8_t> a,b;
  uint64_t meta=0;
  int rows=0,cols=0,depth=0,nextRow=0,currentRow=0,currentRows=0;
  bool previous=false,firstAPrefetched=false;
  TPipe* pipe_;
  TEventID e_MTE1_MTE2,e_AReady[2],e_BReady[STAGES],e_M_MTE1[2],e_MTE1_M[2],e_FIX_M,e_M_FIX;
public:
  __aicore__ inline void SetSubBlockIdx(int) {}
  __aicore__ inline void Init(TCubeTiling*,TPipe* pipe) {
    pipe->InitBuffer(ab,2*BM*FK);pipe->InitBuffer(bb,TN*FK);
    pipe->InitBuffer(a0,2*BM*BK);pipe->InitBuffer(b0,2*TN*BK);
    pipe->InitBuffer(cb,BM*TN*sizeof(int32_t));pipe_=pipe;
    e_MTE1_MTE2=pipe->AllocEventID<HardEvent::MTE1_MTE2>();
    for(int i=0;i<2;++i)e_AReady[i]=pipe->AllocEventID<HardEvent::MTE2_MTE1>();
    for(int i=0;i<STAGES;++i)e_BReady[i]=pipe->AllocEventID<HardEvent::MTE2_MTE1>();
    for(int slot=0;slot<2;++slot){
      e_M_MTE1[slot]=pipe->AllocEventID<HardEvent::M_MTE1>();
      e_MTE1_M[slot]=pipe->AllocEventID<HardEvent::MTE1_M>();
      SetFlag<HardEvent::M_MTE1>(static_cast<event_t>(e_M_MTE1[slot]));
    }
    e_FIX_M=pipe->AllocEventID<HardEvent::FIX_M>();
    e_M_FIX=pipe->AllocEventID<HardEvent::M_FIX>();
  }
  __aicore__ inline void PrefetchFirstA(GlobalTensor<int8_t> input,int m,int k,uint64_t info) {
    const int firstRows=m<BM?m:BM;
    PairA(ab.Get<int8_t>(),input.GetPhyAddr(),0,0,firstRows,k,0,info);
    firstAPrefetched=true;
  }
  __aicore__ inline void SetOrgShape(int,int,int,int,int) {}
  __aicore__ inline void SetSingleShape(int m,int n,int k) {
    rows=m;cols=n;depth=k;nextRow=0;
  }
  __aicore__ inline void SetSelfDefineData(uint64_t value) {meta=value;}
  __aicore__ inline void SetTensorA(GlobalTensor<int8_t> value,bool) {a=value;}
  __aicore__ inline void SetTensorB(GlobalTensor<int8_t> value,bool) {b=value;}
  __aicore__ inline void End() {
    for(int slot=0;slot<2;++slot)
      WaitFlag<HardEvent::M_MTE1>(static_cast<event_t>(e_M_MTE1[slot]));
    PipeBarrier<PIPE_ALL>();
    pipe_->ReleaseEventID<HardEvent::MTE1_MTE2>(e_MTE1_MTE2);
    for(int i=0;i<2;++i)pipe_->ReleaseEventID<HardEvent::MTE2_MTE1>(e_AReady[i]);
    for(int i=0;i<STAGES;++i)pipe_->ReleaseEventID<HardEvent::MTE2_MTE1>(e_BReady[i]);
    for(int slot=0;slot<2;++slot){
      pipe_->ReleaseEventID<HardEvent::M_MTE1>(e_M_MTE1[slot]);
      pipe_->ReleaseEventID<HardEvent::MTE1_M>(e_MTE1_M[slot]);
    }
    pipe_->ReleaseEventID<HardEvent::FIX_M>(e_FIX_M);
    pipe_->ReleaseEventID<HardEvent::M_FIX>(e_M_FIX);
  }
  __aicore__ inline bool Iterate() {
    if(nextRow>=rows)return false;
    currentRow=nextRow;
    currentRows=rows-nextRow<BM?rows-nextRow:BM;
    nextRow+=currentRows;
    const int aSlot=(currentRow/BM)&1;
    auto al=ab.Get<int8_t>()[aSlot*BM*FK],bl=bb.Get<int8_t>();
    auto ac=a0.Get<int8_t>(),bc=b0.Get<int8_t>();
    auto cc=cb.Get<int32_t>();
    const int mr=(currentRows+15)/16*16;
    const int nr=(cols+31)/32*32,kr=(depth+31)/32*32;
    if(previous){
      SetFlag<HardEvent::MTE1_MTE2>(static_cast<event_t>(e_MTE1_MTE2));
      WaitFlag<HardEvent::MTE1_MTE2>(static_cast<event_t>(e_MTE1_MTE2));
    }
    const int strideA=meta&0x3fff;
    if(currentRow==0){
      if(firstAPrefetched)firstAPrefetched=false;
      else PairA(al,a.GetPhyAddr(),0,0,currentRows,depth,0,meta);
      SetFlag<HardEvent::MTE2_MTE1>(static_cast<event_t>(e_AReady[aSlot]));
      const int stride=(meta>>14)&0x1fff;
      const int outer=(int)((meta>>57)&31)*128;
      const int valid=stride-outer<cols?stride-outer:cols;
      for(int start=0;start<depth;start+=COPY_K){
        const int count=depth-start<COPY_K?depth-start:COPY_K;
        const bool last=start+count==depth;
        PairCopy(bl[start*32],b.GetPhyAddr()+(int64_t)start*stride,
          count,valid,stride,kr,true,last&&((meta>>55)&1),(meta>>56)&1);
        if(last && kr!=depth){
          InitConstValue(bl.ReinterpretCast<int32_t>()[depth*8],
            InitConstValueParams<int32_t>{(uint16_t)((valid+31)/32),
              (uint16_t)(kr-depth),(uint16_t)depth,0});
        }
        SetFlag<HardEvent::MTE2_MTE1>(static_cast<event_t>(e_BReady[start/COPY_K]));
      }
    }
    WaitFlag<HardEvent::MTE2_MTE1>(static_cast<event_t>(e_AReady[aSlot]));
    if(nextRow<rows){
      const int nextRows=rows-nextRow<BM?rows-nextRow:BM;
      const int nextSlot=aSlot^1;
      auto nextA=ab.Get<int8_t>()[nextSlot*BM*FK];
      PairA(nextA,a.GetPhyAddr()+(int64_t)nextRow*strideA,
        0,0,nextRows,depth,0,meta);
      SetFlag<HardEvent::MTE2_MTE1>(static_cast<event_t>(e_AReady[nextSlot]));
    }
    const uint8_t pad[4]={0,0,0,0};
    SetFmatrix(1,mr,pad,FmatrixMode::FMATRIX_LEFT);
    for(int ks=0;ks<kr;ks+=BK){
      if(currentRow==0 && ks%COPY_K==0)
        WaitFlag<HardEvent::MTE2_MTE1>(static_cast<event_t>(e_BReady[ks/COPY_K]));
      const int kb=kr-ks<BK?kr-ks:BK;
      const int slot=(ks/BK)&1;
      WaitFlag<HardEvent::M_MTE1>(static_cast<event_t>(e_M_MTE1[slot]));
      auto acSlot=ac[slot*BM*BK],bcSlot=bc[slot*TN*BK];
      LoadData3DParamsV2Pro la;
      la.channelSize=kb;la.extConfig=((uint64_t)mr<<16)|kb;
      LoadData(acSlot,al[ks*mr],la);
      LoadData2dTransposeParams lb{0,(uint8_t)(nr/32),(uint16_t)(kr/32),1,0};
      for(int ki=0;ki<kb;ki+=32)
        LoadDataWithTranspose(bcSlot[ki*nr],bl[(ks+ki)*32],lb);
      SetFlag<HardEvent::MTE1_M>(static_cast<event_t>(e_MTE1_M[slot]));
      WaitFlag<HardEvent::MTE1_M>(static_cast<event_t>(e_MTE1_M[slot]));
      if(previous && ks==0){
        SetFlag<HardEvent::FIX_M>(static_cast<event_t>(e_FIX_M));
        WaitFlag<HardEvent::FIX_M>(static_cast<event_t>(e_FIX_M));
      }
      MmadParams mp;
      mp.m=mr;mp.n=nr;mp.k=kb;mp.cmatrixInitVal=(ks==0);
      Mmad(cc,acSlot,bcSlot,mp);
      if((mr/16)*(nr/16)<10)PipeBarrier<PIPE_M>();
      SetFlag<HardEvent::M_MTE1>(static_cast<event_t>(e_M_MTE1[slot]));
    }
    SetFlag<HardEvent::M_FIX>(static_cast<event_t>(e_M_FIX));
    WaitFlag<HardEvent::M_FIX>(static_cast<event_t>(e_M_FIX));
    return true;
  }
  __aicore__ inline void GetTensorC(GlobalTensor<int32_t> c) {
    auto cc=cb.Get<int32_t>();
    FixpipeParamsV220 fp;
    fp.nSize=cols;fp.mSize=currentRows;
    fp.srcStride=(currentRows+15)/16*16;fp.dstStride=CPITCH;
    Fixpipe(c[(int64_t)currentRow*CPITCH],cc,fp);
    previous=true;
  }
};
template<int TM, int TN>
__global__ __mix__(1, 2) void ComputeResidentEarlyA(
  GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groups,
  GM_ADDR y, GM_ADDR workspace, int M, int N, int K, int E, TCubeTiling tiling)
{
  constexpr bool PADDED=true, TRANSPORT=true, USE_NORMAL=false, USE_DIRECT=false;
  InitSocState();
  GlobalTensor<int8_t> ag, bg;
  GlobalTensor<int64_t> gg;
  GlobalTensor<int32_t> cg;
  GlobalTensor<float> sg;
  GlobalTensor<half> yg;
  ag.SetGlobalBuffer((__gm__ int8_t*)x);
  bg.SetGlobalBuffer((__gm__ int8_t*)weight);
  gg.SetGlobalBuffer((__gm__ int64_t*)groups);
  cg.SetGlobalBuffer((__gm__ int32_t*)workspace);
  sg.SetGlobalBuffer((__gm__ float*)scale);
  yg.SetGlobalBuffer((__gm__ half*)y);
  const int ka = K;
  const int nb = PADDED ? (N + 31) / 32 * 32 : N;
  if constexpr (PADDED) {
    auto base = workspace + (int64_t)GetBlockNum() * 2 * TM * TN * sizeof(int32_t);
    GlobalTensor<int8_t> bp;
    bp.SetGlobalBuffer((__gm__ int8_t*)base);
    if ASCEND_IS_AIV {
      PadActiveWeights(bp, bg, gg, E, K, N, nb);
    }
    bg = bp;
  }
  const int nc = (N + TN - 1) / TN;
  const int cores = GetBlockNum();
  const bool shardExperts = M!=1 && E >= 2 * cores && N <= 512 && K <= 512;
  if ASCEND_IS_AIC {
    TPipe pipe;
    ManualResidentEarlyA<TN> mm;
    mm.SetSubBlockIdx(0);
    mm.Init(&tiling, &pipe);
    mm.SetOrgShape(M, TRANSPORT ? (N+31)/32*32 : nb, ka, K, TN);
    uint64_t meta=0;
    if constexpr (TRANSPORT || USE_DIRECT)
      meta=(uint64_t)ka|((uint64_t)nb<<14)|((uint64_t)K<<27)
        |((uint64_t)(tiling.baseM/16)<<41)|((uint64_t)(tiling.baseN/32)<<45)
        |((uint64_t)(tiling.baseK/32)<<50)|((uint64_t)PADDED<<56);
    int earlyStart=0,earlyBase=0;
    const int earlyFirst=M==1?SingleRowExpert(gg,E):(shardExperts?GetBlockIdx():0);
    const int earlyStep=M==1?E:(shardExperts?cores:1);
    for(int e=earlyFirst;e<E;e+=earlyStep){
      if(shardExperts)earlyStart=e==0?0:(int)gg.GetValue(e-1);
      const int end=(int)gg.GetValue(e);
      const int tiles=((end-earlyStart+TM-1)/TM)*nc;
      int first=shardExperts?0:GetBlockIdx()-earlyBase;
      if(first<0)first+=cores;
      if(first<tiles){
        int mr,nr;TileCoordinates(first,nc,mr,nr);
        const int row=earlyStart+mr*TM;
        const int rows=end-row<TM?end-row:TM;
        mm.PrefetchFirstA(ag[(int64_t)row*ka],rows,K,
          meta|((uint64_t)(row+rows==M)<<62));
        break;
      }
      if(!shardExperts)earlyBase=AdvanceTaskBase(earlyBase,tiles,cores);
      earlyStart=end;
    }
    SyncAll<false>();
    int taskBase = 0;
    int start = 0;
    int produced = 0;
    int tileCount = 0;
    const int eFirst = M==1 ? SingleRowExpert(gg,E) : (shardExperts ? GetBlockIdx() : 0);
    const int eStep = M==1 ? E : (shardExperts ? cores : 1);
    for (int e = eFirst; e < E; e += eStep) {
      if (shardExperts) start = e == 0 ? 0 : (int)gg.GetValue(e - 1);
      int end = (int)gg.GetValue(e);
      int tiles = ((end - start + TM - 1) / TM) * nc;
      if(tiles==0){start=end;continue;}
      int first = shardExperts ? 0 : GetBlockIdx()-taskBase;
      if(first<0)first+=cores;
      const int taskStep = shardExperts ? 1 : cores;
      for (int task = first; task < tiles; task += taskStep) {
        const int scratchSlot = tileCount & 1;
        int mr,nr;TileCoordinates(task,nc,mr,nr);
        int row = start + mr * TM;
        int col = nr * TN;
        int rows = end - row < TM ? end - row : TM;
        int cols = N - col < TN ? N - col : TN;
        if constexpr (TRANSPORT || USE_DIRECT) {
          mm.SetSelfDefineData(meta|((uint64_t)(e==E-1 && nb==N)<<55)
            |((uint64_t)(col/128)<<57)|((uint64_t)(row+rows==M)<<62));
        }
        mm.SetSingleShape(rows, TRANSPORT ? (cols+31)/32*32 : cols, K);
        mm.SetTensorA(ag[(int64_t)row * ka], false);
        mm.SetTensorB(bg[(int64_t)e * K * nb + col], false);
        while (mm.Iterate()) {
          const int slot = produced & 1;
          if (produced >= 2) CrossCoreWaitFlag<2>(1 + 2 * slot);
          mm.GetTensorC(cg[((int64_t)GetBlockIdx() * 2 + scratchSlot) * TM * TN]);
          CrossCoreSetFlag<2, PIPE_FIX>(2 * slot);
          ++produced;
        }
        ++tileCount;
      }
      if(!shardExperts)taskBase=AdvanceTaskBase(taskBase,tiles,cores);
      start = end;
    }
    if (produced > 1) CrossCoreWaitFlag<2>(1 + 2 * ((produced - 2) & 1));
    if (produced > 0) CrossCoreWaitFlag<2>(1 + 2 * ((produced - 1) & 1));
    mm.End();
  }
  if ASCEND_IS_AIV {
    SyncAll<false>();
    const int core = GetBlockIdx() / 2;
    const int sub = GetBlockIdx() % 2;
    constexpr int VCOLS = TN / 2;
    constexpr int CHUNK_ROWS = (128 * 1024) / (TN * sizeof(int32_t));
    constexpr int VCOUNT = CHUNK_ROWS * VCOLS;
    TPipe pipe;
    TQue<TPosition::VECIN, 1> cq, sq;
    TQue<TPosition::VECOUT, 1> oq;
    TBuf<TPosition::VECCALC> tb;
    pipe.InitBuffer(cq, 1, VCOUNT * sizeof(int32_t));
    pipe.InitBuffer(sq, 1, VCOLS * sizeof(float));
    pipe.InitBuffer(oq, 1, VCOUNT * sizeof(half));
    pipe.InitBuffer(tb, VCOUNT * sizeof(float));
    auto t = tb.Get<float>();
    int consumed = 0;
    int tileCount = 0;
    int taskBase = 0;
    int start = 0;
    const int eFirst = M==1 ? SingleRowExpert(gg,E) : (shardExperts ? core : 0);
    const int eStep = M==1 ? E : (shardExperts ? cores : 1);
    for (int e = eFirst; e < E; e += eStep) {
      if (shardExperts) start = e == 0 ? 0 : (int)gg.GetValue(e - 1);
      int end = (int)gg.GetValue(e);
      int tiles = ((end - start + TM - 1) / TM) * nc;
      if(tiles==0){start=end;continue;}
      int first = shardExperts ? 0 : core-taskBase;
      if(first<0)first+=cores;
      const int taskStep = shardExperts ? 1 : cores;
      for (int task = first; task < tiles; task += taskStep) {
        int mr,nr;TileCoordinates(task,nc,mr,nr);
        int row = start + mr * TM;
        int col = nr * TN + sub * VCOLS;
        int rows = end - row < TM ? end - row : TM;
        int cols = N - col < VCOLS ? N - col : VCOLS;
        const int scratchSlot = tileCount & 1;
        for (int chunkRow=0;chunkRow<rows;chunkRow+=tiling.baseM) {
          const int chunkRows=rows-chunkRow<tiling.baseM?rows-chunkRow:tiling.baseM;
          const int slot = consumed & 1;
          CrossCoreWaitFlag<2>(2 * slot);
          if (cols > 0) {
          auto c = cq.AllocTensor<int32_t>();
          auto s = sq.AllocTensor<float>();
          DataCopyPad(c, cg[((int64_t)core * 2 + scratchSlot) * TM * TN + chunkRow * TN + sub * VCOLS],
            DataCopyExtParams{(uint16_t)chunkRows, (uint32_t)(cols * 4),
              (uint32_t)((TN - cols) * 4), (uint32_t)((VCOLS - (cols + 7) / 8 * 8) / 8), 0},
            DataCopyPadExtParams<int32_t>{true, 0, 0, 0});
          DataCopyPad(s, sg[(int64_t)e * N + col],
            DataCopyExtParams{1, (uint32_t)(cols * 4), 0, 0, 0},
            DataCopyPadExtParams<float>{true, 0, 0, 0.0f});
          cq.EnQue(c);
          sq.EnQue(s);
          c = cq.DeQue<int32_t>();
          s = sq.DeQue<float>();
          CrossCoreSetFlag<2, PIPE_MTE2>(1 + 2 * slot);
          auto z = c.ReinterpretCast<float>();
          Cast(z, c, RoundMode::CAST_RINT, chunkRows * VCOLS);
          PipeBarrier<PIPE_V>();
          if constexpr (TM > 255) {
            for(int r0=0;r0<chunkRows;r0+=255){
              const uint8_t repeats=(uint8_t)(chunkRows-r0<255?chunkRows-r0:255);
              for(int c0=0;c0<VCOLS;c0+=64)
                Mul(z[r0*VCOLS+c0],z[r0*VCOLS+c0],s[c0],(uint64_t)64,repeats,
                  BinaryRepeatParams{1,1,1,VCOLS/8,VCOLS/8,0});
            }
          } else {
            for (int c0 = 0; c0 < VCOLS; c0 += 64)
              Mul(z[c0], z[c0], s[c0], (uint64_t)64, (uint8_t)chunkRows,
                BinaryRepeatParams{1, 1, 1, VCOLS / 8, VCOLS / 8, 0});
          }
          PipeBarrier<PIPE_V>();
          GeluBounded(z,t,chunkRows*VCOLS);
          auto out = oq.AllocTensor<half>();
          Cast(out, z, RoundMode::CAST_RINT, chunkRows * VCOLS);
          oq.EnQue(out);
          out = oq.DeQue<half>();
          DataCopyPad(yg[(int64_t)(row + chunkRow) * N + col], out,
            DataCopyExtParams{(uint16_t)chunkRows, (uint32_t)(cols * 2),
              (uint32_t)((VCOLS - (cols + 15) / 16 * 16) / 16),
              (uint32_t)((N - cols) * 2), 0});
          oq.FreeTensor(out);
          sq.FreeTensor(s);
          cq.FreeTensor(c);
          } else {
            CrossCoreSetFlag<2, PIPE_MTE2>(1 + 2 * slot);
          }
          ++consumed;
        }
        ++tileCount;
      }
      if(!shardExperts)taskBase=AdvanceTaskBase(taskBase,tiles,cores);
      start = end;
    }
  }
}
template<int TM,int TN>
void LaunchResidentB(GM_ADDR x,GM_ADDR weight,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,
  int M,int N,int K,int E,int cores,aclrtStream stream)
{
  constexpr int fullBM=(128*1024)/(TN*sizeof(int32_t));
  constexpr int halfBM=fullBM/2;
  const int physicalK=(K+127)/128*128;
  const bool enableFullA=(int64_t)physicalK*(2*fullBM+TN)>512*1024
    && (int64_t)physicalK*(2*halfBM+TN)<=512*1024;
  const int BM=enableFullA?halfBM:fullBM;
  const int maxTiles=((M+TM-1)/TM+E-1)*((N+TN-1)/TN);
  if(cores>maxTiles)cores=maxTiles;
  matmul_tiling::MultiCoreMatmulTiling mt;
  mt.SetDim(1);
  mt.SetAType(matmul_tiling::TPosition::GM,matmul_tiling::CubeFormat::ND,matmul_tiling::DataType::DT_INT8,false);
  mt.SetBType(matmul_tiling::TPosition::GM,matmul_tiling::CubeFormat::ND,matmul_tiling::DataType::DT_INT8,false);
  mt.SetCType(matmul_tiling::TPosition::GM,matmul_tiling::CubeFormat::ND,matmul_tiling::DataType::DT_INT32);
  const bool padded=M>=256*E && K>=128 && N>=128 && K%32>=16 && N%32>=16;
  const int nb=padded?(N+31)/32*32:N;
  mt.SetShape(TM,TN,K);mt.SetOrgShape(M,nb,K,K);
  mt.SetFixSplit(BM,TN,128);mt.SetBufferSpace(512*1024,128*1024,0);
  TCubeTiling tiling;if(mt.GetTiling(tiling)!=0)return;
  const int kBlocks=(K+tiling.baseK-1)/tiling.baseK;
  const int aBlock=tiling.baseM*tiling.baseK;
  const int bBytes=kBlocks*tiling.baseK*tiling.baseN;
  tiling.stepM=1;tiling.stepN=1;
  if(bBytes+2*aBlock<=512*1024){
    int aStep=(512*1024-bBytes)/(2*aBlock);
    if(aStep>kBlocks)aStep=kBlocks;
    while(kBlocks%aStep!=0)--aStep;
    tiling.stepKa=aStep;tiling.stepKb=kBlocks;
    tiling.depthA1=2*aStep;tiling.depthB1=kBlocks;
  }else{
    const int kStep=(512*1024)/(2*tiling.baseK*(tiling.baseM+tiling.baseN));
    tiling.stepKa=kStep;tiling.stepKb=kStep;
    tiling.depthA1=2*kStep;tiling.depthB1=2*kStep;
  }
  void* scratch=nullptr;
  if(aclrtMalloc(&scratch,(int64_t)cores*2*TM*TN*sizeof(int32_t)+(padded?(int64_t)E*K*nb:0)+cores*64,ACL_MEM_MALLOC_HUGE_FIRST)!=ACL_SUCCESS)return;
  if constexpr (TN==256) {
    const bool earlyA=padded && tiling.baseM==128 && tiling.baseN==TN && tiling.baseK==128
      && (int64_t)physicalK*(2*128+TN)<=512*1024;
    if(earlyA){
      ComputeResidentEarlyA<TM,TN><<<cores,nullptr,stream>>>(x,weight,scale,groups,y,(GM_ADDR)scratch,M,N,K,E,tiling);
      aclrtSynchronizeStream(stream);aclrtFree(scratch);return;
    }
  }
  const bool preload=tiling.stepKa*tiling.baseK>=K && tiling.depthA1==2*tiling.stepKa && TM>tiling.baseM;
  if(preload){
    if(padded)ComputeResidentB<TM,TN,true,true><<<cores,nullptr,stream>>>(x,weight,scale,groups,y,(GM_ADDR)scratch,M,N,K,E,tiling);
    else ComputeResidentB<TM,TN,false,true><<<cores,nullptr,stream>>>(x,weight,scale,groups,y,(GM_ADDR)scratch,M,N,K,E,tiling);
  }else{
    if(padded)ComputeResidentB<TM,TN,true,false><<<cores,nullptr,stream>>>(x,weight,scale,groups,y,(GM_ADDR)scratch,M,N,K,E,tiling);
    else ComputeResidentB<TM,TN,false,false><<<cores,nullptr,stream>>>(x,weight,scale,groups,y,(GM_ADDR)scratch,M,N,K,E,tiling);
  }
  aclrtSynchronizeStream(stream);aclrtFree(scratch);
}
template<int TM, int TN>
__global__ __mix__(1, 2) void ComputeRowReuse(
  GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groups,
  GM_ADDR y, GM_ADDR workspace, int M, int N, int K, int E, TCubeTiling tiling)
{
  constexpr bool PADDED=false, TRANSPORT=true, USE_NORMAL=false, USE_DIRECT=false;
  InitSocState();
  GlobalTensor<int8_t> ag, bg;
  GlobalTensor<int64_t> gg;
  GlobalTensor<int32_t> cg;
  GlobalTensor<float> sg;
  GlobalTensor<half> yg;
  ag.SetGlobalBuffer((__gm__ int8_t*)x);
  bg.SetGlobalBuffer((__gm__ int8_t*)weight);
  gg.SetGlobalBuffer((__gm__ int64_t*)groups);
  cg.SetGlobalBuffer((__gm__ int32_t*)workspace);
  sg.SetGlobalBuffer((__gm__ float*)scale);
  yg.SetGlobalBuffer((__gm__ half*)y);
  const int ka = PADDED ? (K + 31) / 32 * 32 : K;
  const int nb = PADDED ? (N + 31) / 32 * 32 : N;
  if constexpr (PADDED) {
    auto base = workspace + (int64_t)GetBlockNum() * 2 * TM * TN * sizeof(int32_t);
    GlobalTensor<int8_t> ap, bp;
    ap.SetGlobalBuffer((__gm__ int8_t*)base);
    bp.SetGlobalBuffer((__gm__ int8_t*)(base + (ka != K ? (int64_t)M * ka : 0)));
    if ASCEND_IS_AIV {
      if (ka != K) PadRows(ap, ag, M, K, ka);
      if (nb != N) PadRows(bp, bg, (int64_t)E * K, N, nb);
    }
    SyncAll<false>();
    if (ka != K) ag = ap;
    if (nb != N) bg = bp;
  }
  const int nc = (N + TN - 1) / TN;
  const int cores = GetBlockNum();
  const bool shardExperts = M!=1 && E >= 2 * cores && N <= 512 && K <= 512;
  if ASCEND_IS_AIC {
    TPipe pipe;
    typename CubeSelect<TM,TN,USE_NORMAL,USE_DIRECT,typename TransportCallback<TRANSPORT>::Type>::Type mm;
    mm.SetSubBlockIdx(0);
    mm.Init(&tiling, &pipe);
    mm.SetOrgShape(M, TRANSPORT ? (N+31)/32*32 : nb, ka, K, TN);
    uint64_t meta=0;
    if constexpr (TRANSPORT || USE_DIRECT)
      meta=(uint64_t)ka|((uint64_t)nb<<14)|((uint64_t)K<<27)
        |((uint64_t)(tiling.baseM/16)<<41)|((uint64_t)(tiling.baseN/32)<<45)
        |((uint64_t)(tiling.baseK/32)<<50)|((uint64_t)PADDED<<56);
    int taskBase = 0;
    int start = 0;
    int produced = 0;
    const int eFirst = M==1 ? SingleRowExpert(gg,E) : (shardExperts ? GetBlockIdx() : 0);
    const int eStep = M==1 ? E : (shardExperts ? cores : 1);
    for (int e = eFirst; e < E; e += eStep) {
      if (shardExperts) start = e == 0 ? 0 : (int)gg.GetValue(e - 1);
      int end = (int)gg.GetValue(e);
      int tiles = ((end - start + TM - 1) / TM) * nc;
      if(tiles==0){start=end;continue;}
      int first = shardExperts ? 0 : GetBlockIdx()-taskBase;
      if(first<0)first+=cores;
      const int taskStep = shardExperts ? 1 : cores;
      for (int task = first; task < tiles; task += taskStep) {
        const int slot = produced & 1;
        if (produced >= 2) CrossCoreWaitFlag<2>(1 + 2 * slot);
        int mr,nr;TileCoordinates(task,nc,mr,nr);
        int row = start + mr * TM;
        int col = nr * TN;
        int rows = end - row < TM ? end - row : TM;
        int cols = N - col < TN ? N - col : TN;
        if constexpr (TRANSPORT || USE_DIRECT) {
          mm.SetSelfDefineData(meta|((uint64_t)(e==E-1 && nb==N)<<55)
            |((uint64_t)(col/128)<<57)|((uint64_t)(row+rows==M)<<62));
        }
        mm.SetSingleShape(rows, TRANSPORT ? (cols+31)/32*32 : cols, K);
        mm.SetTensorA(ag[(int64_t)row * ka], false);
        mm.SetTensorB(bg[(int64_t)e * K * nb + col], false);
        mm.IterateAll(cg[((int64_t)GetBlockIdx() * 2 + slot) * TM * TN], false);
        CrossCoreSetFlag<2, PIPE_FIX>(2 * slot);
        ++produced;
      }
      if(!shardExperts)taskBase=AdvanceTaskBase(taskBase,tiles,cores);
      start = end;
    }
    if (produced > 1) CrossCoreWaitFlag<2>(1 + 2 * ((produced - 2) & 1));
    if (produced > 0) CrossCoreWaitFlag<2>(1 + 2 * ((produced - 1) & 1));
    mm.End();
  }
  if ASCEND_IS_AIV {
    const int core = GetBlockIdx() / 2;
    const int sub = GetBlockIdx() % 2;
    constexpr int VCOLS = TN / 2;
    constexpr int CHUNK_ROWS = (128 * 1024) / (TN * sizeof(int32_t));
    constexpr int VCOUNT = CHUNK_ROWS * VCOLS;
    TPipe pipe;
    TQue<TPosition::VECIN, 1> cq, sq;
    TQue<TPosition::VECOUT, 1> oq;
    TBuf<TPosition::VECCALC> tb;
    pipe.InitBuffer(cq, 1, VCOUNT * sizeof(int32_t));
    pipe.InitBuffer(sq, 1, VCOLS * sizeof(float));
    pipe.InitBuffer(oq, 1, VCOUNT * sizeof(half));
    pipe.InitBuffer(tb, VCOUNT * sizeof(float));
    auto t = tb.Get<float>();
    int consumed = 0;
    int taskBase = 0;
    int start = 0;
    const int eFirst = M==1 ? SingleRowExpert(gg,E) : (shardExperts ? core : 0);
    const int eStep = M==1 ? E : (shardExperts ? cores : 1);
    for (int e = eFirst; e < E; e += eStep) {
      if (shardExperts) start = e == 0 ? 0 : (int)gg.GetValue(e - 1);
      int end = (int)gg.GetValue(e);
      int tiles = ((end - start + TM - 1) / TM) * nc;
      if(tiles==0){start=end;continue;}
      int first = shardExperts ? 0 : core-taskBase;
      if(first<0)first+=cores;
      const int taskStep = shardExperts ? 1 : cores;
      for (int task = first; task < tiles; task += taskStep) {
        int mr,nr;TileCoordinates(task,nc,mr,nr);
        int row = start + mr * TM;
        int col = nr * TN + sub * VCOLS;
        int rows = end - row < TM ? end - row : TM;
        int cols = N - col < VCOLS ? N - col : VCOLS;
        const int slot = consumed & 1;
        CrossCoreWaitFlag<2>(2 * slot);
        if (rows > 0 && cols > 0) {
          for (int chunkRow=0;chunkRow<rows;chunkRow+=CHUNK_ROWS) {
            const int chunkRows=rows-chunkRow<CHUNK_ROWS?rows-chunkRow:CHUNK_ROWS;
          auto c = cq.AllocTensor<int32_t>();
          auto s = sq.AllocTensor<float>();
          DataCopyPad(c, cg[((int64_t)core * 2 + slot) * TM * TN + chunkRow * TN + sub * VCOLS],
            DataCopyExtParams{(uint16_t)chunkRows, (uint32_t)(cols * 4),
              (uint32_t)((TN - cols) * 4), (uint32_t)((VCOLS - (cols + 7) / 8 * 8) / 8), 0},
            DataCopyPadExtParams<int32_t>{true, 0, 0, 0});
          DataCopyPad(s, sg[(int64_t)e * N + col],
            DataCopyExtParams{1, (uint32_t)(cols * 4), 0, 0, 0},
            DataCopyPadExtParams<float>{true, 0, 0, 0.0f});
          cq.EnQue(c);
          sq.EnQue(s);
          c = cq.DeQue<int32_t>();
          s = sq.DeQue<float>();
          if (chunkRow + chunkRows == rows)
            CrossCoreSetFlag<2, PIPE_MTE2>(1 + 2 * slot);
          auto z = c.ReinterpretCast<float>();
          Cast(z, c, RoundMode::CAST_RINT, chunkRows * VCOLS);
          PipeBarrier<PIPE_V>();
          if constexpr (TM > 255) {
            for(int r0=0;r0<chunkRows;r0+=255){
              const uint8_t repeats=(uint8_t)(chunkRows-r0<255?chunkRows-r0:255);
              for(int c0=0;c0<VCOLS;c0+=64)
                Mul(z[r0*VCOLS+c0],z[r0*VCOLS+c0],s[c0],(uint64_t)64,repeats,
                  BinaryRepeatParams{1,1,1,VCOLS/8,VCOLS/8,0});
            }
          } else {
            for (int c0 = 0; c0 < VCOLS; c0 += 64)
              Mul(z[c0], z[c0], s[c0], (uint64_t)64, (uint8_t)chunkRows,
                BinaryRepeatParams{1, 1, 1, VCOLS / 8, VCOLS / 8, 0});
          }
          PipeBarrier<PIPE_V>();
          GeluBounded(z,t,chunkRows*VCOLS);
          auto out = oq.AllocTensor<half>();
          Cast(out, z, RoundMode::CAST_RINT, chunkRows * VCOLS);
          oq.EnQue(out);
          out = oq.DeQue<half>();
          DataCopyPad(yg[(int64_t)(row + chunkRow) * N + col], out,
            DataCopyExtParams{(uint16_t)chunkRows, (uint32_t)(cols * 2),
              (uint32_t)((VCOLS - (cols + 15) / 16 * 16) / 16),
              (uint32_t)((N - cols) * 2), 0});
          oq.FreeTensor(out);
          sq.FreeTensor(s);
          cq.FreeTensor(c);
          }
        } else {
          CrossCoreSetFlag<2, PIPE_MTE2>(1 + 2 * slot);
        }
        ++consumed;
      }
      if(!shardExperts)taskBase=AdvanceTaskBase(taskBase,tiles,cores);
      start = end;
    }
  }
}
template<int TM,int TN>
void LaunchRowReuse(GM_ADDR x,GM_ADDR weight,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,
  int M,int N,int K,int E,int cores,aclrtStream stream)
{
  constexpr int BM=(128*1024)/(TN*sizeof(int32_t));
  const int maxTiles=((M+TM-1)/TM+E-1)*((N+TN-1)/TN);
  if(cores>maxTiles)cores=maxTiles;
  matmul_tiling::MultiCoreMatmulTiling mt;
  mt.SetDim(1);
  mt.SetAType(matmul_tiling::TPosition::GM,matmul_tiling::CubeFormat::ND,matmul_tiling::DataType::DT_INT8,false);
  mt.SetBType(matmul_tiling::TPosition::GM,matmul_tiling::CubeFormat::ND,matmul_tiling::DataType::DT_INT8,false);
  mt.SetCType(matmul_tiling::TPosition::GM,matmul_tiling::CubeFormat::ND,matmul_tiling::DataType::DT_INT32);
  mt.SetShape(TM,TN,K);mt.SetOrgShape(M,N,K,K);
  mt.SetFixSplit(BM,TN,128);mt.SetBufferSpace(512*1024,128*1024,0);
  TCubeTiling tiling;if(mt.GetTiling(tiling)!=0)return;
  int mBlocks=(TM+tiling.baseM-1)/tiling.baseM;
  const int kBlocks=(K+tiling.baseK-1)/tiling.baseK;
  if((int64_t)kBlocks*tiling.baseK*(mBlocks*tiling.baseM+tiling.baseN)>512*1024)
    mBlocks=1;
  const int panelBytes=tiling.baseK*(mBlocks*tiling.baseM+tiling.baseN);
  const bool resident=(int64_t)kBlocks*panelBytes<=512*1024;
  const int kStep=resident?kBlocks:(512*1024)/(2*panelBytes);
  tiling.stepM=mBlocks;tiling.stepN=1;
  tiling.stepKa=kStep;tiling.stepKb=kStep;
  tiling.depthA1=mBlocks*kStep*(resident?1:2);
  tiling.depthB1=kStep*(resident?1:2);
  void* scratch=nullptr;
  if(aclrtMalloc(&scratch,(int64_t)cores*2*TM*TN*sizeof(int32_t)+cores*64,ACL_MEM_MALLOC_HUGE_FIRST)!=ACL_SUCCESS)return;
  ComputeRowReuse<TM,TN><<<cores,nullptr,stream>>>(x,weight,scale,groups,y,(GM_ADDR)scratch,M,N,K,E,tiling);
  aclrtSynchronizeStream(stream);aclrtFree(scratch);
}
__aicore__ inline void SinglePanelA(const LocalTensor<int8_t>& dst,const __gm__ void* gm,
  int row,int col,int useM,int useK,uint64_t unused,uint64_t meta)
{
  const uint64_t fixed=(meta&~(15ULL<<41))|(4ULL<<41);
  PairA(dst,gm,row,col,useM,useK,unused,fixed);
}
template<int TN>
class ManualStagedResidentB {
  static constexpr int BM=64, BK=64, COPY_K=4*BK;
  static constexpr int CPITCH=(TN+127)/128*128;
  static constexpr int FK=(524288/(BM+TN)/BK)*BK;
  static constexpr int STAGES=(FK+COPY_K-1)/COPY_K;
  static_assert(STAGES+2<=8);
  static_assert((BM+TN)*FK<=512*1024);
  static_assert(2*BM*BK<=64*1024 && 2*TN*BK<=64*1024);
  static_assert(BM*TN*sizeof(int32_t)<=128*1024);
  TBuf<TPosition::A1> ab;
  TBuf<TPosition::B1> bb;
  TBuf<TPosition::A2> a0;
  TBuf<TPosition::B2> b0;
  TBuf<TPosition::CO1> cb;
  GlobalTensor<int8_t> a,b;
  uint64_t meta=0;
  int rows=0,cols=0,depth=0,nextRow=0,currentRow=0,currentRows=0;
  bool previous=false;
  TPipe* pipe_;
  TEventID e_MTE1_MTE2,e_ARelease[2],e_AReady[2],e_BReady[STAGES],e_M_MTE1[2],e_MTE1_M[2],e_FIX_M,e_M_FIX;
  __aicore__ inline void PrefetchAPart(int start,int count,int nextRows,int phase) {
    SetFlag<HardEvent::MTE1_MTE2>(static_cast<event_t>(e_ARelease[phase]));
    WaitFlag<HardEvent::MTE1_MTE2>(static_cast<event_t>(e_ARelease[phase]));
    const int stride=meta&0x3fff;
    const int nextMr=(nextRows+15)/16*16;
    const bool odd=(count&1)!=0;
    PairCopy(ab.Get<int8_t>()[start*nextMr],
      a.GetPhyAddr()+(int64_t)nextRow*stride+start,
      nextRows,count,stride,nextMr,odd,odd&&((meta>>62)&1),false);
    SetFlag<HardEvent::MTE2_MTE1>(static_cast<event_t>(e_AReady[phase]));
  }
public:
  __aicore__ inline void SetSubBlockIdx(int) {}
  __aicore__ inline void Init(TCubeTiling*,TPipe* pipe) {
    pipe->InitBuffer(ab,BM*FK);pipe->InitBuffer(bb,TN*FK);
    pipe->InitBuffer(a0,2*BM*BK);pipe->InitBuffer(b0,2*TN*BK);
    pipe->InitBuffer(cb,BM*TN*sizeof(int32_t));pipe_=pipe;
    e_MTE1_MTE2=pipe->AllocEventID<HardEvent::MTE1_MTE2>();
    for(int i=0;i<2;++i){
      e_ARelease[i]=pipe->AllocEventID<HardEvent::MTE1_MTE2>();
      e_AReady[i]=pipe->AllocEventID<HardEvent::MTE2_MTE1>();
    }
    for(int i=0;i<STAGES;++i)e_BReady[i]=pipe->AllocEventID<HardEvent::MTE2_MTE1>();
    for(int slot=0;slot<2;++slot){
      e_M_MTE1[slot]=pipe->AllocEventID<HardEvent::M_MTE1>();
      e_MTE1_M[slot]=pipe->AllocEventID<HardEvent::MTE1_M>();
      SetFlag<HardEvent::M_MTE1>(static_cast<event_t>(e_M_MTE1[slot]));
    }
    e_FIX_M=pipe->AllocEventID<HardEvent::FIX_M>();
    e_M_FIX=pipe->AllocEventID<HardEvent::M_FIX>();
  }
  __aicore__ inline void SetOrgShape(int,int,int,int,int) {}
  __aicore__ inline void SetSingleShape(int m,int n,int k) {
    rows=m;cols=n;depth=k;nextRow=0;
  }
  __aicore__ inline void SetSelfDefineData(uint64_t value) {meta=value;}
  __aicore__ inline void SetTensorA(GlobalTensor<int8_t> value,bool) {a=value;}
  __aicore__ inline void SetTensorB(GlobalTensor<int8_t> value,bool) {b=value;}
  __aicore__ inline void End() {
    for(int slot=0;slot<2;++slot)
      WaitFlag<HardEvent::M_MTE1>(static_cast<event_t>(e_M_MTE1[slot]));
    PipeBarrier<PIPE_ALL>();
    pipe_->ReleaseEventID<HardEvent::MTE1_MTE2>(e_MTE1_MTE2);
    for(int i=0;i<2;++i){
      pipe_->ReleaseEventID<HardEvent::MTE1_MTE2>(e_ARelease[i]);
      pipe_->ReleaseEventID<HardEvent::MTE2_MTE1>(e_AReady[i]);
    }
    for(int i=0;i<STAGES;++i)pipe_->ReleaseEventID<HardEvent::MTE2_MTE1>(e_BReady[i]);
    for(int slot=0;slot<2;++slot){
      pipe_->ReleaseEventID<HardEvent::M_MTE1>(e_M_MTE1[slot]);
      pipe_->ReleaseEventID<HardEvent::MTE1_M>(e_MTE1_M[slot]);
    }
    pipe_->ReleaseEventID<HardEvent::FIX_M>(e_FIX_M);
    pipe_->ReleaseEventID<HardEvent::M_FIX>(e_M_FIX);
  }
  __aicore__ inline bool Iterate() {
    if(nextRow>=rows)return false;
    currentRow=nextRow;
    currentRows=rows-nextRow<BM?rows-nextRow:BM;
    nextRow+=currentRows;
    auto al=ab.Get<int8_t>(),bl=bb.Get<int8_t>();
    auto ac=a0.Get<int8_t>(),bc=b0.Get<int8_t>();
    auto cc=cb.Get<int32_t>();
    const int mr=(currentRows+15)/16*16;
    const int nr=(cols+31)/32*32,kr=(depth+31)/32*32;
    if(previous){
      SetFlag<HardEvent::MTE1_MTE2>(static_cast<event_t>(e_MTE1_MTE2));
      WaitFlag<HardEvent::MTE1_MTE2>(static_cast<event_t>(e_MTE1_MTE2));
    }
    const int strideA=meta&0x3fff;
    if(currentRow==0)
      SinglePanelA(al,a.GetPhyAddr(),0,0,currentRows,depth,0,meta);
    if(currentRow==0){
      const int stride=(meta>>14)&0x1fff;
      const int outer=(int)((meta>>57)&31)*128+(int)((meta>>41)&3)*32;
      const int valid=stride-outer<cols?stride-outer:cols;
      for(int start=0;start<depth;start+=COPY_K){
        const int count=depth-start<COPY_K?depth-start:COPY_K;
        const bool last=start+count==depth;
        PairCopy(bl[start*32],b.GetPhyAddr()+(int64_t)start*stride,
          count,valid,stride,kr,true,last&&((meta>>55)&1),false);
        if(last && kr!=depth){
          InitConstValue(bl.ReinterpretCast<int32_t>()[depth*8],
            InitConstValueParams<int32_t>{(uint16_t)((valid+31)/32),
              (uint16_t)(kr-depth),(uint16_t)depth,0});
        }
        SetFlag<HardEvent::MTE2_MTE1>(static_cast<event_t>(e_BReady[start/COPY_K]));
      }
    }
    const uint8_t pad[4]={0,0,0,0};
    SetFmatrix(1,mr,pad,FmatrixMode::FMATRIX_LEFT);
    constexpr int A_PREFIX_K=8*BK;
    const int prefix=depth<A_PREFIX_K?depth:A_PREFIX_K;
    const int prefixPadded=(prefix+31)/32*32;
    for(int ks=0;ks<kr;ks+=BK){
      if(currentRow>0 && (ks==0 || ks==A_PREFIX_K))
        WaitFlag<HardEvent::MTE2_MTE1>(static_cast<event_t>(e_AReady[ks==0?0:1]));
      if(currentRow==0 && ks%COPY_K==0)
        WaitFlag<HardEvent::MTE2_MTE1>(static_cast<event_t>(e_BReady[ks/COPY_K]));
      const int kb=kr-ks<BK?kr-ks:BK;
      const int slot=(ks/BK)&1;
      WaitFlag<HardEvent::M_MTE1>(static_cast<event_t>(e_M_MTE1[slot]));
      auto acSlot=ac[slot*BM*BK],bcSlot=bc[slot*TN*BK];
      LoadData3DParamsV2Pro la;
      la.channelSize=kb;la.extConfig=((uint64_t)mr<<16)|kb;
      LoadData(acSlot,al[ks*mr],la);
      LoadData2dTransposeParams lb{0,(uint8_t)(nr/32),(uint16_t)(kr/32),1,0};
      for(int ki=0;ki<kb;ki+=32)
        LoadDataWithTranspose(bcSlot[ki*nr],bl[(ks+ki)*32],lb);
      SetFlag<HardEvent::MTE1_M>(static_cast<event_t>(e_MTE1_M[slot]));
      WaitFlag<HardEvent::MTE1_M>(static_cast<event_t>(e_MTE1_M[slot]));
      if(previous && ks==0){
        SetFlag<HardEvent::FIX_M>(static_cast<event_t>(e_FIX_M));
        WaitFlag<HardEvent::FIX_M>(static_cast<event_t>(e_FIX_M));
      }
      MmadParams mp;
      mp.m=mr;mp.n=nr;mp.k=kb;mp.cmatrixInitVal=(ks==0);
      Mmad(cc,acSlot,bcSlot,mp);
      if((mr/16)*(nr/16)<10)PipeBarrier<PIPE_M>();
      SetFlag<HardEvent::M_MTE1>(static_cast<event_t>(e_M_MTE1[slot]));
      if(nextRow<rows){
        const int nextRows=rows-nextRow<BM?rows-nextRow:BM;
        if(ks+kb==prefixPadded)PrefetchAPart(0,prefix,nextRows,0);
        if(ks+kb==kr && depth>prefix)
          PrefetchAPart(prefix,depth-prefix,nextRows,1);
      }
    }
    SetFlag<HardEvent::M_FIX>(static_cast<event_t>(e_M_FIX));
    WaitFlag<HardEvent::M_FIX>(static_cast<event_t>(e_M_FIX));
    return true;
  }
  __aicore__ inline void GetTensorC(GlobalTensor<int32_t> c) {
    auto cc=cb.Get<int32_t>();
    FixpipeParamsV220 fp;
    fp.nSize=cols;fp.mSize=currentRows;
    fp.srcStride=(currentRows+15)/16*16;fp.dstStride=CPITCH;
    Fixpipe(c[(int64_t)currentRow*CPITCH],cc,fp);
    previous=true;
  }
};
template<int TM, int TN>
__global__ __mix__(1, 2) void ComputeResidentSingleA(
  GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groups,
  GM_ADDR y, GM_ADDR workspace, int M, int N, int K, int E, TCubeTiling tiling)
{
  constexpr int CPITCH=(TN+127)/128*128;
  constexpr bool PADDED=false, PRELOAD=false, TRANSPORT=true, USE_NORMAL=false, USE_DIRECT=false;
  InitSocState();
  GlobalTensor<int8_t> ag, bg;
  GlobalTensor<int64_t> gg;
  GlobalTensor<int32_t> cg;
  GlobalTensor<float> sg;
  GlobalTensor<half> yg;
  ag.SetGlobalBuffer((__gm__ int8_t*)x);
  bg.SetGlobalBuffer((__gm__ int8_t*)weight);
  gg.SetGlobalBuffer((__gm__ int64_t*)groups);
  cg.SetGlobalBuffer((__gm__ int32_t*)workspace);
  sg.SetGlobalBuffer((__gm__ float*)scale);
  yg.SetGlobalBuffer((__gm__ half*)y);
  const int ka = K;
  const int nb = PADDED ? (N + 31) / 32 * 32 : N;
  if constexpr (PADDED) {
    auto base = workspace + (int64_t)GetBlockNum() * 2 * TM * CPITCH * sizeof(int32_t);
    GlobalTensor<int8_t> bp;
    bp.SetGlobalBuffer((__gm__ int8_t*)base);
    if ASCEND_IS_AIV {
      PadActiveWeights(bp, bg, gg, E, K, N, nb);
    }
    SyncAll<false>();
    bg = bp;
  }
  const int nc = (N + TN - 1) / TN;
  const int cores = GetBlockNum();
  const bool shardExperts = M!=1 && E >= 2 * cores && N <= 512 && K <= 512;
  if ASCEND_IS_AIC {
    TPipe pipe;
    ManualStagedResidentB<TN> mm;
    mm.SetSubBlockIdx(0);
    mm.Init(&tiling, &pipe);
    mm.SetOrgShape(M, TRANSPORT ? (N+31)/32*32 : nb, ka, K, CPITCH);
    uint64_t meta=0;
    if constexpr (TRANSPORT || USE_DIRECT)
      meta=(uint64_t)ka|((uint64_t)nb<<14)|((uint64_t)K<<27)
        |((uint64_t)(tiling.baseN/32)<<45)
        |((uint64_t)(tiling.baseK/32)<<50)|((uint64_t)PADDED<<56);
    int taskBase = 0;
    int start = 0;
    int produced = 0;
    int tileCount = 0;
    const int eFirst = M==1 ? SingleRowExpert(gg,E) : (shardExperts ? GetBlockIdx() : 0);
    const int eStep = M==1 ? E : (shardExperts ? cores : 1);
    for (int e = eFirst; e < E; e += eStep) {
      if (shardExperts) start = e == 0 ? 0 : (int)gg.GetValue(e - 1);
      int end = (int)gg.GetValue(e);
      int tiles = ((end - start + TM - 1) / TM) * nc;
      if(tiles==0){start=end;continue;}
      int first = shardExperts ? 0 : GetBlockIdx()-taskBase;
      if(first<0)first+=cores;
      const int taskStep = shardExperts ? 1 : cores;
      for (int task = first; task < tiles; task += taskStep) {
        const int scratchSlot = tileCount & 1;
        int mr,nr;TileCoordinates(task,nc,mr,nr);
        int row = start + mr * TM;
        int col = nr * TN;
        int rows = end - row < TM ? end - row : TM;
        int cols = N - col < TN ? N - col : TN;
        if constexpr (TRANSPORT || USE_DIRECT) {
          mm.SetSelfDefineData(meta|((uint64_t)(e==E-1 && nb==N)<<55)
            |((uint64_t)(col/128)<<57)|((uint64_t)((col%128)/32)<<41)
            |((uint64_t)(row+rows==M)<<62));
        }
        mm.SetSingleShape(rows, TRANSPORT ? (cols+31)/32*32 : cols, K);
        mm.SetTensorA(ag[(int64_t)row * ka], false);
        mm.SetTensorB(bg[(int64_t)e * K * nb + col], false);
        while (mm.Iterate()) {
          const int slot = produced & 1;
          if (produced >= 2) CrossCoreWaitFlag<2>(1 + 2 * slot);
          mm.GetTensorC(cg[((int64_t)GetBlockIdx() * 2 + scratchSlot) * TM * CPITCH]);
          CrossCoreSetFlag<2, PIPE_FIX>(2 * slot);
          ++produced;
        }
        ++tileCount;
      }
      if(!shardExperts)taskBase=AdvanceTaskBase(taskBase,tiles,cores);
      start = end;
    }
    if (produced > 1) CrossCoreWaitFlag<2>(1 + 2 * ((produced - 2) & 1));
    if (produced > 0) CrossCoreWaitFlag<2>(1 + 2 * ((produced - 1) & 1));
    mm.End();
  }
  if ASCEND_IS_AIV {
    const int core = GetBlockIdx() / 2;
    const int sub = GetBlockIdx() % 2;
    constexpr int VCOLS = CPITCH / 2;
    constexpr int CHUNK_ROWS = 64;
    static_assert(CHUNK_ROWS*VCOLS*10+VCOLS*sizeof(float)<=184*1024);
    constexpr int VCOUNT = CHUNK_ROWS * VCOLS;
    TPipe pipe;
    TQue<TPosition::VECIN, 1> cq, sq;
    TQue<TPosition::VECOUT, 1> oq;
    TBuf<TPosition::VECCALC> tb;
    pipe.InitBuffer(cq, 1, VCOUNT * sizeof(int32_t));
    pipe.InitBuffer(sq, 1, VCOLS * sizeof(float));
    pipe.InitBuffer(oq, 1, VCOUNT * sizeof(half));
    pipe.InitBuffer(tb, VCOUNT * sizeof(float));
    auto t = tb.Get<float>();
    int consumed = 0;
    int tileCount = 0;
    int taskBase = 0;
    int start = 0;
    const int eFirst = M==1 ? SingleRowExpert(gg,E) : (shardExperts ? core : 0);
    const int eStep = M==1 ? E : (shardExperts ? cores : 1);
    for (int e = eFirst; e < E; e += eStep) {
      if (shardExperts) start = e == 0 ? 0 : (int)gg.GetValue(e - 1);
      int end = (int)gg.GetValue(e);
      int tiles = ((end - start + TM - 1) / TM) * nc;
      if(tiles==0){start=end;continue;}
      int first = shardExperts ? 0 : core-taskBase;
      if(first<0)first+=cores;
      const int taskStep = shardExperts ? 1 : cores;
      for (int task = first; task < tiles; task += taskStep) {
        int mr,nr;TileCoordinates(task,nc,mr,nr);
        int row = start + mr * TM;
        int col = nr * TN + sub * VCOLS;
        int rows = end - row < TM ? end - row : TM;
        const int tileRemaining = TN - sub * VCOLS;
        const int validRemaining = N - col < tileRemaining ? N - col : tileRemaining;
        int cols = validRemaining < VCOLS ? validRemaining : VCOLS;
        const int scratchSlot = tileCount & 1;
        for (int chunkRow=0;chunkRow<rows;chunkRow+=tiling.baseM) {
          const int chunkRows=rows-chunkRow<tiling.baseM?rows-chunkRow:tiling.baseM;
          const int slot = consumed & 1;
          CrossCoreWaitFlag<2>(2 * slot);
          if (cols > 0) {
          auto c = cq.AllocTensor<int32_t>();
          auto s = sq.AllocTensor<float>();
          DataCopyPad(c, cg[((int64_t)core * 2 + scratchSlot) * TM * CPITCH + chunkRow * CPITCH + sub * VCOLS],
            DataCopyExtParams{(uint16_t)chunkRows, (uint32_t)(cols * 4),
              (uint32_t)((CPITCH - cols) * 4), (uint32_t)((VCOLS - (cols + 7) / 8 * 8) / 8), 0},
            DataCopyPadExtParams<int32_t>{true, 0, 0, 0});
          DataCopyPad(s, sg[(int64_t)e * N + col],
            DataCopyExtParams{1, (uint32_t)(cols * 4), 0, 0, 0},
            DataCopyPadExtParams<float>{true, 0, 0, 0.0f});
          cq.EnQue(c);
          sq.EnQue(s);
          c = cq.DeQue<int32_t>();
          s = sq.DeQue<float>();
          CrossCoreSetFlag<2, PIPE_MTE2>(1 + 2 * slot);
          auto z = c.ReinterpretCast<float>();
          Cast(z, c, RoundMode::CAST_RINT, chunkRows * VCOLS);
          PipeBarrier<PIPE_V>();
          if constexpr (TM > 255) {
            for(int r0=0;r0<chunkRows;r0+=255){
              const uint8_t repeats=(uint8_t)(chunkRows-r0<255?chunkRows-r0:255);
              for(int c0=0;c0<VCOLS;c0+=64)
                Mul(z[r0*VCOLS+c0],z[r0*VCOLS+c0],s[c0],(uint64_t)(VCOLS-c0<64?VCOLS-c0:64),repeats,
                  BinaryRepeatParams{1,1,1,VCOLS/8,VCOLS/8,0});
            }
          } else {
            for (int c0 = 0; c0 < VCOLS; c0 += 64)
              Mul(z[c0], z[c0], s[c0], (uint64_t)(VCOLS-c0<64?VCOLS-c0:64), (uint8_t)chunkRows,
                BinaryRepeatParams{1, 1, 1, VCOLS / 8, VCOLS / 8, 0});
          }
          PipeBarrier<PIPE_V>();
          GeluBounded(z,t,chunkRows*VCOLS);
          auto out = oq.AllocTensor<half>();
          Cast(out, z, RoundMode::CAST_RINT, chunkRows * VCOLS);
          oq.EnQue(out);
          out = oq.DeQue<half>();
          DataCopyPad(yg[(int64_t)(row + chunkRow) * N + col], out,
            DataCopyExtParams{(uint16_t)chunkRows, (uint32_t)(cols * 2),
              (uint32_t)((VCOLS - (cols + 15) / 16 * 16) / 16),
              (uint32_t)((N - cols) * 2), 0});
          oq.FreeTensor(out);
          sq.FreeTensor(s);
          cq.FreeTensor(c);
          } else {
            CrossCoreSetFlag<2, PIPE_MTE2>(1 + 2 * slot);
          }
          ++consumed;
        }
        ++tileCount;
      }
      if(!shardExperts)taskBase=AdvanceTaskBase(taskBase,tiles,cores);
      start = end;
    }
  }
}
template<int TM,int TN>
void LaunchResidentSingleA(GM_ADDR x,GM_ADDR weight,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,
  int M,int N,int K,int E,int cores,aclrtStream stream)
{
  constexpr int BM=64, BK=64;
  constexpr int CPITCH=(TN+127)/128*128;
  static_assert(BM*TN*sizeof(int32_t)<=128*1024);
  static_assert(2*TN*BK<=64*1024);
  const int maxTiles=((M+TM-1)/TM+E-1)*((N+TN-1)/TN);
  if(cores>maxTiles)cores=maxTiles;
  matmul_tiling::MultiCoreMatmulTiling mt;
  mt.SetDim(1);
  mt.SetAType(matmul_tiling::TPosition::GM,matmul_tiling::CubeFormat::ND,matmul_tiling::DataType::DT_INT8,false);
  mt.SetBType(matmul_tiling::TPosition::GM,matmul_tiling::CubeFormat::ND,matmul_tiling::DataType::DT_INT8,false);
  mt.SetCType(matmul_tiling::TPosition::GM,matmul_tiling::CubeFormat::ND,matmul_tiling::DataType::DT_INT32);
  mt.SetShape(TM,TN,K);mt.SetOrgShape(M,N,K,K);
  mt.SetFixSplit(BM,TN,BK);mt.SetBufferSpace(512*1024,128*1024,0);
  TCubeTiling tiling;if(mt.GetTiling(tiling)!=0)return;
  tiling.baseM=BM;tiling.baseN=TN;tiling.baseK=BK;
  tiling.dbL0A=2;tiling.dbL0B=2;tiling.dbL0C=1;
  const int kBlocks=(K+BK-1)/BK;
  tiling.stepM=1;tiling.stepN=1;
  tiling.stepKa=kBlocks;tiling.stepKb=kBlocks;
  tiling.depthA1=kBlocks;tiling.depthB1=kBlocks;
  void* scratch=nullptr;
  if(aclrtMalloc(&scratch,(int64_t)cores*2*TM*CPITCH*sizeof(int32_t)+cores*64,ACL_MEM_MALLOC_HUGE_FIRST)!=ACL_SUCCESS)return;
  ComputeResidentSingleA<TM,TN><<<cores,nullptr,stream>>>(x,weight,scale,groups,y,(GM_ADDR)scratch,M,N,K,E,tiling);
  aclrtSynchronizeStream(stream);aclrtFree(scratch);
}
template<int TN>
class ManualBalancedDoubleA {
  static constexpr int BM=64, BK=128, COPY_K=2*BK;
  static constexpr int CPITCH=(TN+127)/128*128;
  static constexpr int FK=(524288/(2*BM+TN)/BK)*BK;
  static constexpr int STAGES=(FK+COPY_K-1)/COPY_K;
  static_assert(STAGES+2<=8);
  static_assert((2*BM+TN)*FK<=512*1024);
  static_assert(2*BM*BK<=64*1024 && 2*TN*BK<=64*1024);
  static_assert(BM*TN*sizeof(int32_t)<=128*1024);
  TBuf<TPosition::A1> ab;
  TBuf<TPosition::B1> bb;
  TBuf<TPosition::A2> a0;
  TBuf<TPosition::B2> b0;
  TBuf<TPosition::CO1> cb;
  GlobalTensor<int8_t> a,b;
  uint64_t meta=0;
  int rows=0,cols=0,depth=0,nextRow=0,currentRow=0,currentRows=0;
  bool previous=false;
  TPipe* pipe_;
  TEventID e_MTE1_MTE2,e_AReady[2],e_BReady[STAGES],e_M_MTE1[2],e_MTE1_M[2],e_FIX_M,e_M_FIX;
public:
  __aicore__ inline void SetSubBlockIdx(int) {}
  __aicore__ inline void Init(TCubeTiling*,TPipe* pipe) {
    pipe->InitBuffer(ab,2*BM*FK);pipe->InitBuffer(bb,TN*FK);
    pipe->InitBuffer(a0,2*BM*BK);pipe->InitBuffer(b0,2*TN*BK);
    pipe->InitBuffer(cb,BM*TN*sizeof(int32_t));pipe_=pipe;
    e_MTE1_MTE2=pipe->AllocEventID<HardEvent::MTE1_MTE2>();
    for(int i=0;i<2;++i)e_AReady[i]=pipe->AllocEventID<HardEvent::MTE2_MTE1>();
    for(int i=0;i<STAGES;++i)e_BReady[i]=pipe->AllocEventID<HardEvent::MTE2_MTE1>();
    for(int slot=0;slot<2;++slot){
      e_M_MTE1[slot]=pipe->AllocEventID<HardEvent::M_MTE1>();
      e_MTE1_M[slot]=pipe->AllocEventID<HardEvent::MTE1_M>();
      SetFlag<HardEvent::M_MTE1>(static_cast<event_t>(e_M_MTE1[slot]));
    }
    e_FIX_M=pipe->AllocEventID<HardEvent::FIX_M>();
    e_M_FIX=pipe->AllocEventID<HardEvent::M_FIX>();
  }
  __aicore__ inline void SetOrgShape(int,int,int,int,int) {}
  __aicore__ inline void SetSingleShape(int m,int n,int k) {
    rows=m;cols=n;depth=k;nextRow=0;
  }
  __aicore__ inline void SetSelfDefineData(uint64_t value) {meta=value;}
  __aicore__ inline void SetTensorA(GlobalTensor<int8_t> value,bool) {a=value;}
  __aicore__ inline void SetTensorB(GlobalTensor<int8_t> value,bool) {b=value;}
  __aicore__ inline void End() {
    for(int slot=0;slot<2;++slot)
      WaitFlag<HardEvent::M_MTE1>(static_cast<event_t>(e_M_MTE1[slot]));
    PipeBarrier<PIPE_ALL>();
    pipe_->ReleaseEventID<HardEvent::MTE1_MTE2>(e_MTE1_MTE2);
    for(int i=0;i<2;++i)pipe_->ReleaseEventID<HardEvent::MTE2_MTE1>(e_AReady[i]);
    for(int i=0;i<STAGES;++i)pipe_->ReleaseEventID<HardEvent::MTE2_MTE1>(e_BReady[i]);
    for(int slot=0;slot<2;++slot){
      pipe_->ReleaseEventID<HardEvent::M_MTE1>(e_M_MTE1[slot]);
      pipe_->ReleaseEventID<HardEvent::MTE1_M>(e_MTE1_M[slot]);
    }
    pipe_->ReleaseEventID<HardEvent::FIX_M>(e_FIX_M);
    pipe_->ReleaseEventID<HardEvent::M_FIX>(e_M_FIX);
  }
  __aicore__ inline bool Iterate() {
    if(nextRow>=rows)return false;
    currentRow=nextRow;
    currentRows=rows-nextRow<BM?rows-nextRow:BM;
    nextRow+=currentRows;
    const int aSlot=(currentRow/BM)&1;
    auto al=ab.Get<int8_t>()[aSlot*BM*FK],bl=bb.Get<int8_t>();
    auto ac=a0.Get<int8_t>(),bc=b0.Get<int8_t>();
    auto cc=cb.Get<int32_t>();
    const int mr=(currentRows+15)/16*16;
    const int nr=(cols+31)/32*32,kr=(depth+31)/32*32;
    if(previous){
      SetFlag<HardEvent::MTE1_MTE2>(static_cast<event_t>(e_MTE1_MTE2));
      WaitFlag<HardEvent::MTE1_MTE2>(static_cast<event_t>(e_MTE1_MTE2));
    }
    const int strideA=meta&0x3fff;
    if(currentRow==0){
      SinglePanelA(al,a.GetPhyAddr(),0,0,currentRows,depth,0,meta);
      SetFlag<HardEvent::MTE2_MTE1>(static_cast<event_t>(e_AReady[aSlot]));
      const int stride=(meta>>14)&0x1fff;
      const int outer=(int)((meta>>57)&31)*128+(int)((meta>>41)&3)*32;
      const int valid=stride-outer<cols?stride-outer:cols;
      for(int start=0;start<depth;start+=COPY_K){
        const int count=depth-start<COPY_K?depth-start:COPY_K;
        const bool last=start+count==depth;
        PairCopy(bl[start*32],b.GetPhyAddr()+(int64_t)start*stride,
          count,valid,stride,kr,true,last&&((meta>>55)&1),(meta>>56)&1);
        if(last && kr!=depth){
          InitConstValue(bl.ReinterpretCast<int32_t>()[depth*8],
            InitConstValueParams<int32_t>{(uint16_t)((valid+31)/32),
              (uint16_t)(kr-depth),(uint16_t)depth,0});
        }
        SetFlag<HardEvent::MTE2_MTE1>(static_cast<event_t>(e_BReady[start/COPY_K]));
      }
    }
    WaitFlag<HardEvent::MTE2_MTE1>(static_cast<event_t>(e_AReady[aSlot]));
    if(nextRow<rows){
      const int nextRows=rows-nextRow<BM?rows-nextRow:BM;
      const int nextSlot=aSlot^1;
      auto nextA=ab.Get<int8_t>()[nextSlot*BM*FK];
      SinglePanelA(nextA,a.GetPhyAddr()+(int64_t)nextRow*strideA,
        0,0,nextRows,depth,0,meta);
      SetFlag<HardEvent::MTE2_MTE1>(static_cast<event_t>(e_AReady[nextSlot]));
    }
    const uint8_t pad[4]={0,0,0,0};
    SetFmatrix(1,mr,pad,FmatrixMode::FMATRIX_LEFT);
    for(int ks=0;ks<kr;ks+=BK){
      if(currentRow==0 && ks%COPY_K==0)
        WaitFlag<HardEvent::MTE2_MTE1>(static_cast<event_t>(e_BReady[ks/COPY_K]));
      const int kb=kr-ks<BK?kr-ks:BK;
      const int slot=(ks/BK)&1;
      WaitFlag<HardEvent::M_MTE1>(static_cast<event_t>(e_M_MTE1[slot]));
      auto acSlot=ac[slot*BM*BK],bcSlot=bc[slot*TN*BK];
      LoadData3DParamsV2Pro la;
      la.channelSize=kb;la.extConfig=((uint64_t)mr<<16)|kb;
      LoadData(acSlot,al[ks*mr],la);
      LoadData2dTransposeParams lb{0,(uint8_t)(nr/32),(uint16_t)(kr/32),1,0};
      for(int ki=0;ki<kb;ki+=32)
        LoadDataWithTranspose(bcSlot[ki*nr],bl[(ks+ki)*32],lb);
      SetFlag<HardEvent::MTE1_M>(static_cast<event_t>(e_MTE1_M[slot]));
      WaitFlag<HardEvent::MTE1_M>(static_cast<event_t>(e_MTE1_M[slot]));
      if(previous && ks==0){
        SetFlag<HardEvent::FIX_M>(static_cast<event_t>(e_FIX_M));
        WaitFlag<HardEvent::FIX_M>(static_cast<event_t>(e_FIX_M));
      }
      MmadParams mp;
      mp.m=mr;mp.n=nr;mp.k=kb;mp.cmatrixInitVal=(ks==0);
      Mmad(cc,acSlot,bcSlot,mp);
      if((mr/16)*(nr/16)<10)PipeBarrier<PIPE_M>();
      SetFlag<HardEvent::M_MTE1>(static_cast<event_t>(e_M_MTE1[slot]));
    }
    SetFlag<HardEvent::M_FIX>(static_cast<event_t>(e_M_FIX));
    WaitFlag<HardEvent::M_FIX>(static_cast<event_t>(e_M_FIX));
    return true;
  }
  __aicore__ inline void GetTensorC(GlobalTensor<int32_t> c) {
    auto cc=cb.Get<int32_t>();
    FixpipeParamsV220 fp;
    fp.nSize=cols;fp.mSize=currentRows;
    fp.srcStride=(currentRows+15)/16*16;fp.dstStride=CPITCH;
    Fixpipe(c[(int64_t)currentRow*CPITCH],cc,fp);
    previous=true;
  }
};
template<int TN>
class ManualBalancedWideRows {
  static constexpr int BM=128, BK=128, COPY_K=3*BK;
  static constexpr int CPITCH=(TN+127)/128*128;
  static constexpr int FK=(524288/(2*BM+TN)/32)*32;
  static constexpr int STAGES=(FK+COPY_K-1)/COPY_K;
  static_assert(STAGES+2<=8);
  static_assert((2*BM+TN)*FK<=512*1024);
  static_assert(2*BM*BK<=64*1024 && 2*TN*BK<=64*1024);
  static_assert(BM*TN*sizeof(int32_t)<=128*1024);
  TBuf<TPosition::A1> ab;
  TBuf<TPosition::B1> bb;
  TBuf<TPosition::A2> a0;
  TBuf<TPosition::B2> b0;
  TBuf<TPosition::CO1> cb;
  GlobalTensor<int8_t> a,b;
  uint64_t meta=0;
  int rows=0,cols=0,depth=0,nextRow=0,currentRow=0,currentRows=0;
  bool previous=false;
  TPipe* pipe_;
  TEventID e_MTE1_MTE2,e_AReady[2],e_BReady[STAGES],e_M_MTE1[2],e_MTE1_M[2],e_FIX_M,e_M_FIX;
public:
  __aicore__ inline void SetSubBlockIdx(int) {}
  __aicore__ inline void Init(TCubeTiling*,TPipe* pipe) {
    pipe->InitBuffer(ab,2*BM*FK);pipe->InitBuffer(bb,TN*FK);
    pipe->InitBuffer(a0,2*BM*BK);pipe->InitBuffer(b0,2*TN*BK);
    pipe->InitBuffer(cb,BM*TN*sizeof(int32_t));pipe_=pipe;
    e_MTE1_MTE2=pipe->AllocEventID<HardEvent::MTE1_MTE2>();
    for(int i=0;i<2;++i)e_AReady[i]=pipe->AllocEventID<HardEvent::MTE2_MTE1>();
    for(int i=0;i<STAGES;++i)e_BReady[i]=pipe->AllocEventID<HardEvent::MTE2_MTE1>();
    for(int slot=0;slot<2;++slot){
      e_M_MTE1[slot]=pipe->AllocEventID<HardEvent::M_MTE1>();
      e_MTE1_M[slot]=pipe->AllocEventID<HardEvent::MTE1_M>();
      SetFlag<HardEvent::M_MTE1>(static_cast<event_t>(e_M_MTE1[slot]));
    }
    e_FIX_M=pipe->AllocEventID<HardEvent::FIX_M>();
    e_M_FIX=pipe->AllocEventID<HardEvent::M_FIX>();
  }
  __aicore__ inline void SetOrgShape(int,int,int,int,int) {}
  __aicore__ inline void SetSingleShape(int m,int n,int k) {
    rows=m;cols=n;depth=k;nextRow=0;
  }
  __aicore__ inline void SetSelfDefineData(uint64_t value) {meta=value;}
  __aicore__ inline void SetTensorA(GlobalTensor<int8_t> value,bool) {a=value;}
  __aicore__ inline void SetTensorB(GlobalTensor<int8_t> value,bool) {b=value;}
  __aicore__ inline void End() {
    for(int slot=0;slot<2;++slot)
      WaitFlag<HardEvent::M_MTE1>(static_cast<event_t>(e_M_MTE1[slot]));
    PipeBarrier<PIPE_ALL>();
    pipe_->ReleaseEventID<HardEvent::MTE1_MTE2>(e_MTE1_MTE2);
    for(int i=0;i<2;++i)pipe_->ReleaseEventID<HardEvent::MTE2_MTE1>(e_AReady[i]);
    for(int i=0;i<STAGES;++i)pipe_->ReleaseEventID<HardEvent::MTE2_MTE1>(e_BReady[i]);
    for(int slot=0;slot<2;++slot){
      pipe_->ReleaseEventID<HardEvent::M_MTE1>(e_M_MTE1[slot]);
      pipe_->ReleaseEventID<HardEvent::MTE1_M>(e_MTE1_M[slot]);
    }
    pipe_->ReleaseEventID<HardEvent::FIX_M>(e_FIX_M);
    pipe_->ReleaseEventID<HardEvent::M_FIX>(e_M_FIX);
  }
  __aicore__ inline bool Iterate() {
    if(nextRow>=rows)return false;
    currentRow=nextRow;
    currentRows=rows-nextRow<BM?rows-nextRow:BM;
    nextRow+=currentRows;
    const int aSlot=(currentRow/BM)&1;
    auto al=ab.Get<int8_t>()[aSlot*BM*FK],bl=bb.Get<int8_t>();
    auto ac=a0.Get<int8_t>(),bc=b0.Get<int8_t>();
    auto cc=cb.Get<int32_t>();
    const int mr=(currentRows+15)/16*16;
    const int nr=(cols+31)/32*32,kr=(depth+31)/32*32;
    if(previous){
      SetFlag<HardEvent::MTE1_MTE2>(static_cast<event_t>(e_MTE1_MTE2));
      WaitFlag<HardEvent::MTE1_MTE2>(static_cast<event_t>(e_MTE1_MTE2));
    }
    const int strideA=meta&0x3fff;
    if(currentRow==0){
      SinglePanelA(al,a.GetPhyAddr(),0,0,currentRows,depth,0,meta);
      SetFlag<HardEvent::MTE2_MTE1>(static_cast<event_t>(e_AReady[aSlot]));
      const int stride=(meta>>14)&0x1fff;
      const int outer=(int)((meta>>57)&31)*128+(int)((meta>>41)&3)*32;
      const int valid=stride-outer<cols?stride-outer:cols;
      for(int start=0;start<depth;start+=COPY_K){
        const int count=depth-start<COPY_K?depth-start:COPY_K;
        const bool last=start+count==depth;
        PairCopy(bl[start*32],b.GetPhyAddr()+(int64_t)start*stride,
          count,valid,stride,kr,true,last&&((meta>>55)&1),(meta>>56)&1);
        if(last && kr!=depth){
          InitConstValue(bl.ReinterpretCast<int32_t>()[depth*8],
            InitConstValueParams<int32_t>{(uint16_t)((valid+31)/32),
              (uint16_t)(kr-depth),(uint16_t)depth,0});
        }
        SetFlag<HardEvent::MTE2_MTE1>(static_cast<event_t>(e_BReady[start/COPY_K]));
      }
    }
    WaitFlag<HardEvent::MTE2_MTE1>(static_cast<event_t>(e_AReady[aSlot]));
    if(nextRow<rows){
      const int nextRows=rows-nextRow<BM?rows-nextRow:BM;
      const int nextSlot=aSlot^1;
      auto nextA=ab.Get<int8_t>()[nextSlot*BM*FK];
      SinglePanelA(nextA,a.GetPhyAddr()+(int64_t)nextRow*strideA,
        0,0,nextRows,depth,0,meta);
      SetFlag<HardEvent::MTE2_MTE1>(static_cast<event_t>(e_AReady[nextSlot]));
    }
    const uint8_t pad[4]={0,0,0,0};
    SetFmatrix(1,mr,pad,FmatrixMode::FMATRIX_LEFT);
    for(int ks=0;ks<kr;ks+=BK){
      if(currentRow==0 && ks%COPY_K==0)
        WaitFlag<HardEvent::MTE2_MTE1>(static_cast<event_t>(e_BReady[ks/COPY_K]));
      const int kb=kr-ks<BK?kr-ks:BK;
      const int slot=(ks/BK)&1;
      WaitFlag<HardEvent::M_MTE1>(static_cast<event_t>(e_M_MTE1[slot]));
      auto acSlot=ac[slot*BM*BK],bcSlot=bc[slot*TN*BK];
      LoadData3DParamsV2Pro la;
      la.channelSize=kb;la.extConfig=((uint64_t)mr<<16)|kb;
      LoadData(acSlot,al[ks*mr],la);
      LoadData2dTransposeParams lb{0,(uint8_t)(nr/32),(uint16_t)(kr/32),1,0};
      for(int ki=0;ki<kb;ki+=32)
        LoadDataWithTranspose(bcSlot[ki*nr],bl[(ks+ki)*32],lb);
      SetFlag<HardEvent::MTE1_M>(static_cast<event_t>(e_MTE1_M[slot]));
      WaitFlag<HardEvent::MTE1_M>(static_cast<event_t>(e_MTE1_M[slot]));
      if(previous && ks==0){
        SetFlag<HardEvent::FIX_M>(static_cast<event_t>(e_FIX_M));
        WaitFlag<HardEvent::FIX_M>(static_cast<event_t>(e_FIX_M));
      }
      MmadParams mp;
      mp.m=mr;mp.n=nr;mp.k=kb;mp.cmatrixInitVal=(ks==0);
      Mmad(cc,acSlot,bcSlot,mp);
      if((mr/16)*(nr/16)<10)PipeBarrier<PIPE_M>();
      SetFlag<HardEvent::M_MTE1>(static_cast<event_t>(e_M_MTE1[slot]));
    }
    SetFlag<HardEvent::M_FIX>(static_cast<event_t>(e_M_FIX));
    WaitFlag<HardEvent::M_FIX>(static_cast<event_t>(e_M_FIX));
    return true;
  }
  __aicore__ inline void GetTensorC(GlobalTensor<int32_t> c) {
    auto cc=cb.Get<int32_t>();
    FixpipeParamsV220 fp;
    fp.nSize=cols;fp.mSize=currentRows;
    fp.srcStride=(currentRows+15)/16*16;fp.dstStride=CPITCH;
    Fixpipe(c[(int64_t)currentRow*CPITCH],cc,fp);
    previous=true;
  }
};
template<int TM, int TN, bool PADDED>
__global__ __mix__(1, 2) void ComputeResidentWideRows(
  GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groups,
  GM_ADDR y, GM_ADDR workspace, int M, int N, int K, int E, TCubeTiling tiling)
{
  constexpr int CPITCH=(TN+127)/128*128;
  constexpr bool PRELOAD=true, TRANSPORT=true, USE_NORMAL=false, USE_DIRECT=false;
  InitSocState();
  GlobalTensor<int8_t> ag, bg;
  GlobalTensor<int64_t> gg;
  GlobalTensor<int32_t> cg;
  GlobalTensor<float> sg;
  GlobalTensor<half> yg;
  ag.SetGlobalBuffer((__gm__ int8_t*)x);
  bg.SetGlobalBuffer((__gm__ int8_t*)weight);
  gg.SetGlobalBuffer((__gm__ int64_t*)groups);
  cg.SetGlobalBuffer((__gm__ int32_t*)workspace);
  sg.SetGlobalBuffer((__gm__ float*)scale);
  yg.SetGlobalBuffer((__gm__ half*)y);
  const int ka = K;
  const int nb = PADDED ? (N + 31) / 32 * 32 : N;
  if constexpr (PADDED) {
    auto base = workspace + (int64_t)GetBlockNum() * 2 * TM * CPITCH * sizeof(int32_t);
    GlobalTensor<int8_t> bp;
    bp.SetGlobalBuffer((__gm__ int8_t*)base);
    if ASCEND_IS_AIV {
      PadActiveWeights(bp, bg, gg, E, K, N, nb);
    }
    SyncAll<false>();
    bg = bp;
  }
  const int nc = (N + TN - 1) / TN;
  const int cores = GetBlockNum();
  const bool shardExperts = M!=1 && E >= 2 * cores && N <= 512 && K <= 512;
  if ASCEND_IS_AIC {
    TPipe pipe;
    ManualBalancedWideRows<TN> mm;
    mm.SetSubBlockIdx(0);
    mm.Init(&tiling, &pipe);
    mm.SetOrgShape(M, TRANSPORT ? (N+31)/32*32 : nb, ka, K, CPITCH);
    uint64_t meta=0;
    if constexpr (TRANSPORT || USE_DIRECT)
      meta=(uint64_t)ka|((uint64_t)nb<<14)|((uint64_t)K<<27)
        |((uint64_t)(tiling.baseN/32)<<45)
        |((uint64_t)(tiling.baseK/32)<<50)|((uint64_t)PADDED<<56);
    int taskBase = 0;
    int start = 0;
    int produced = 0;
    int tileCount = 0;
    const int eFirst = M==1 ? SingleRowExpert(gg,E) : (shardExperts ? GetBlockIdx() : 0);
    const int eStep = M==1 ? E : (shardExperts ? cores : 1);
    for (int e = eFirst; e < E; e += eStep) {
      if (shardExperts) start = e == 0 ? 0 : (int)gg.GetValue(e - 1);
      int end = (int)gg.GetValue(e);
      int tiles = ((end - start + TM - 1) / TM) * nc;
      if(tiles==0){start=end;continue;}
      int first = shardExperts ? 0 : GetBlockIdx()-taskBase;
      if(first<0)first+=cores;
      const int taskStep = shardExperts ? 1 : cores;
      for (int task = first; task < tiles; task += taskStep) {
        const int scratchSlot = tileCount & 1;
        int mr,nr;TileCoordinates(task,nc,mr,nr);
        int row = start + mr * TM;
        int col = nr * TN;
        int rows = end - row < TM ? end - row : TM;
        int cols = N - col < TN ? N - col : TN;
        if constexpr (TRANSPORT || USE_DIRECT) {
          mm.SetSelfDefineData(meta|((uint64_t)(e==E-1 && nb==N)<<55)
            |((uint64_t)(col/128)<<57)|((uint64_t)((col/32)&3)<<41)|((uint64_t)(row+rows==M)<<62));
        }
        mm.SetSingleShape(rows, TRANSPORT ? (cols+31)/32*32 : cols, K);
        mm.SetTensorA(ag[(int64_t)row * ka], false);
        mm.SetTensorB(bg[(int64_t)e * K * nb + col], false);
        while (mm.Iterate()) {
          const int slot = produced & 1;
          if (produced >= 2) CrossCoreWaitFlag<2>(1 + 2 * slot);
          mm.GetTensorC(cg[((int64_t)GetBlockIdx() * 2 + scratchSlot) * TM * CPITCH]);
          CrossCoreSetFlag<2, PIPE_FIX>(2 * slot);
          ++produced;
        }
        ++tileCount;
      }
      if(!shardExperts)taskBase=AdvanceTaskBase(taskBase,
        tiles+((end-start+127)/128)*nc,cores);
      start = end;
    }
    if (produced > 1) CrossCoreWaitFlag<2>(1 + 2 * ((produced - 2) & 1));
    if (produced > 0) CrossCoreWaitFlag<2>(1 + 2 * ((produced - 1) & 1));
    mm.End();
  }
  if ASCEND_IS_AIV {
    const int core = GetBlockIdx() / 2;
    const int sub = GetBlockIdx() % 2;
    constexpr int VCOLS = CPITCH / 2;
    constexpr int CHUNK_ROWS = 128;
    constexpr int VCOUNT = CHUNK_ROWS * VCOLS;
    TPipe pipe;
    TQue<TPosition::VECIN, 1> cq, sq;
    TQue<TPosition::VECOUT, 1> oq;
    TBuf<TPosition::VECCALC> tb;
    pipe.InitBuffer(cq, 1, VCOUNT * sizeof(int32_t));
    pipe.InitBuffer(sq, 1, VCOLS * sizeof(float));
    pipe.InitBuffer(oq, 1, VCOUNT * sizeof(half));
    pipe.InitBuffer(tb, VCOUNT * sizeof(float));
    auto t = tb.Get<float>();
    int consumed = 0;
    int tileCount = 0;
    int taskBase = 0;
    int start = 0;
    const int eFirst = M==1 ? SingleRowExpert(gg,E) : (shardExperts ? core : 0);
    const int eStep = M==1 ? E : (shardExperts ? cores : 1);
    for (int e = eFirst; e < E; e += eStep) {
      if (shardExperts) start = e == 0 ? 0 : (int)gg.GetValue(e - 1);
      int end = (int)gg.GetValue(e);
      int tiles = ((end - start + TM - 1) / TM) * nc;
      if(tiles==0){start=end;continue;}
      int first = shardExperts ? 0 : core-taskBase;
      if(first<0)first+=cores;
      const int taskStep = shardExperts ? 1 : cores;
      for (int task = first; task < tiles; task += taskStep) {
        int mr,nr;TileCoordinates(task,nc,mr,nr);
        int row = start + mr * TM;
        int col = nr * TN + sub * VCOLS;
        int rows = end - row < TM ? end - row : TM;
        const int tileRemaining = TN - sub * VCOLS;
        const int validRemaining = N - col < tileRemaining ? N - col : tileRemaining;
        int cols = validRemaining < VCOLS ? validRemaining : VCOLS;
        const int scratchSlot = tileCount & 1;
        for (int chunkRow=0;chunkRow<rows;chunkRow+=tiling.baseM) {
          const int chunkRows=rows-chunkRow<tiling.baseM?rows-chunkRow:tiling.baseM;
          const int slot = consumed & 1;
          CrossCoreWaitFlag<2>(2 * slot);
          if (cols > 0) {
          auto c = cq.AllocTensor<int32_t>();
          auto s = sq.AllocTensor<float>();
          DataCopyPad(c, cg[((int64_t)core * 2 + scratchSlot) * TM * CPITCH + chunkRow * CPITCH + sub * VCOLS],
            DataCopyExtParams{(uint16_t)chunkRows, (uint32_t)(cols * 4),
              (uint32_t)((CPITCH - cols) * 4), (uint32_t)((VCOLS - (cols + 7) / 8 * 8) / 8), 0},
            DataCopyPadExtParams<int32_t>{true, 0, 0, 0});
          DataCopyPad(s, sg[(int64_t)e * N + col],
            DataCopyExtParams{1, (uint32_t)(cols * 4), 0, 0, 0},
            DataCopyPadExtParams<float>{true, 0, 0, 0.0f});
          cq.EnQue(c);
          sq.EnQue(s);
          c = cq.DeQue<int32_t>();
          s = sq.DeQue<float>();
          CrossCoreSetFlag<2, PIPE_MTE2>(1 + 2 * slot);
          auto z = c.ReinterpretCast<float>();
          Cast(z, c, RoundMode::CAST_RINT, chunkRows * VCOLS);
          PipeBarrier<PIPE_V>();
          if constexpr (TM > 255) {
            for(int r0=0;r0<chunkRows;r0+=255){
              const uint8_t repeats=(uint8_t)(chunkRows-r0<255?chunkRows-r0:255);
              for(int c0=0;c0<VCOLS;c0+=64)
                Mul(z[r0*VCOLS+c0],z[r0*VCOLS+c0],s[c0],(uint64_t)(VCOLS-c0<64?VCOLS-c0:64),repeats,
                  BinaryRepeatParams{1,1,1,VCOLS/8,VCOLS/8,0});
            }
          } else {
            for (int c0 = 0; c0 < VCOLS; c0 += 64)
              Mul(z[c0], z[c0], s[c0], (uint64_t)(VCOLS-c0<64?VCOLS-c0:64), (uint8_t)chunkRows,
                BinaryRepeatParams{1, 1, 1, VCOLS / 8, VCOLS / 8, 0});
          }
          PipeBarrier<PIPE_V>();
          GeluBounded(z,t,chunkRows*VCOLS);
          auto out = oq.AllocTensor<half>();
          Cast(out, z, RoundMode::CAST_RINT, chunkRows * VCOLS);
          oq.EnQue(out);
          out = oq.DeQue<half>();
          DataCopyPad(yg[(int64_t)(row + chunkRow) * N + col], out,
            DataCopyExtParams{(uint16_t)chunkRows, (uint32_t)(cols * 2),
              (uint32_t)((VCOLS - (cols + 15) / 16 * 16) / 16),
              (uint32_t)((N - cols) * 2), 0});
          oq.FreeTensor(out);
          sq.FreeTensor(s);
          cq.FreeTensor(c);
          } else {
            CrossCoreSetFlag<2, PIPE_MTE2>(1 + 2 * slot);
          }
          ++consumed;
        }
        ++tileCount;
      }
      if(!shardExperts)taskBase=AdvanceTaskBase(taskBase,
        tiles+((end-start+127)/128)*nc,cores);
      start = end;
    }
  }
}
template<int TM,int TN>
void LaunchResidentWideRows(GM_ADDR x,GM_ADDR weight,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,
  int M,int N,int K,int E,int cores,aclrtStream stream)
{
  constexpr int BM=128, BK=128, CPITCH=(TN+127)/128*128;
  static_assert(2*BM*BK<=64*1024 && 2*TN*BK<=64*1024);
  static_assert(BM*TN*sizeof(int32_t)<=128*1024);
  static_assert(BM*(CPITCH/2)*10+(CPITCH/2)*sizeof(float)<=184*1024);
  const int packedK=(K+31)/32*32;
  if((int64_t)packedK*(2*BM+TN)>512*1024)return;
  const int maxTiles=((M+TM-1)/TM+E-1)*((N+TN-1)/TN);
  if(cores>maxTiles)cores=maxTiles;
  const bool padded=M>=256*E && K>=128 && N>=128 && K%32>=16 && N%32>=16;
  const int nb=padded?(N+31)/32*32:N;
  TCubeTiling tiling{};
  tiling.baseM=BM;tiling.baseN=TN;tiling.baseK=BK;
  void* scratch=nullptr;
  if(aclrtMalloc(&scratch,(int64_t)cores*2*TM*CPITCH*sizeof(int32_t)+(padded?(int64_t)E*K*nb:0)+cores*64,
    ACL_MEM_MALLOC_HUGE_FIRST)!=ACL_SUCCESS)return;
  if(padded)ComputeResidentWideRows<TM,TN,true><<<cores,nullptr,stream>>>(x,weight,scale,groups,y,(GM_ADDR)scratch,M,N,K,E,tiling);
  else ComputeResidentWideRows<TM,TN,false><<<cores,nullptr,stream>>>(x,weight,scale,groups,y,(GM_ADDR)scratch,M,N,K,E,tiling);
  aclrtSynchronizeStream(stream);aclrtFree(scratch);
}
template<int TM, int TN, bool PADDED>
__global__ __mix__(1, 2) void ComputeResidentBalancedN(
  GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groups,
  GM_ADDR y, GM_ADDR workspace, int M, int N, int K, int E, TCubeTiling tiling)
{
  constexpr int CPITCH=(TN+127)/128*128;
  constexpr bool PRELOAD=true, TRANSPORT=true, USE_NORMAL=false, USE_DIRECT=false;
  InitSocState();
  GlobalTensor<int8_t> ag, bg;
  GlobalTensor<int64_t> gg;
  GlobalTensor<int32_t> cg;
  GlobalTensor<float> sg;
  GlobalTensor<half> yg;
  ag.SetGlobalBuffer((__gm__ int8_t*)x);
  bg.SetGlobalBuffer((__gm__ int8_t*)weight);
  gg.SetGlobalBuffer((__gm__ int64_t*)groups);
  cg.SetGlobalBuffer((__gm__ int32_t*)workspace);
  sg.SetGlobalBuffer((__gm__ float*)scale);
  yg.SetGlobalBuffer((__gm__ half*)y);
  const int ka = K;
  const int nb = PADDED ? (N + 31) / 32 * 32 : N;
  if constexpr (PADDED) {
    auto base = workspace + (int64_t)GetBlockNum() * 2 * TM * CPITCH * sizeof(int32_t);
    GlobalTensor<int8_t> bp;
    bp.SetGlobalBuffer((__gm__ int8_t*)base);
    if ASCEND_IS_AIV {
      PadActiveWeights(bp, bg, gg, E, K, N, nb);
    }
    SyncAll<false>();
    bg = bp;
  }
  const int nc = (N + TN - 1) / TN;
  const int cores = GetBlockNum();
  const bool shardExperts = M!=1 && E >= 2 * cores && N <= 512 && K <= 512;
  if ASCEND_IS_AIC {
    TPipe pipe;
    ManualBalancedDoubleA<TN> mm;
    mm.SetSubBlockIdx(0);
    mm.Init(&tiling, &pipe);
    mm.SetOrgShape(M, TRANSPORT ? (N+31)/32*32 : nb, ka, K, CPITCH);
    uint64_t meta=0;
    if constexpr (TRANSPORT || USE_DIRECT)
      meta=(uint64_t)ka|((uint64_t)nb<<14)|((uint64_t)K<<27)
        |((uint64_t)(tiling.baseN/32)<<45)
        |((uint64_t)(tiling.baseK/32)<<50)|((uint64_t)PADDED<<56);
    int taskBase = 0;
    int start = 0;
    int produced = 0;
    int tileCount = 0;
    const int eFirst = M==1 ? SingleRowExpert(gg,E) : (shardExperts ? GetBlockIdx() : 0);
    const int eStep = M==1 ? E : (shardExperts ? cores : 1);
    for (int e = eFirst; e < E; e += eStep) {
      if (shardExperts) start = e == 0 ? 0 : (int)gg.GetValue(e - 1);
      int end = (int)gg.GetValue(e);
      int tiles = ((end - start + TM - 1) / TM) * nc;
      if(tiles==0){start=end;continue;}
      int first = shardExperts ? 0 : GetBlockIdx()-taskBase;
      if(first<0)first+=cores;
      const int taskStep = shardExperts ? 1 : cores;
      for (int task = first; task < tiles; task += taskStep) {
        const int scratchSlot = tileCount & 1;
        int mr,nr;TileCoordinates(task,nc,mr,nr);
        int row = start + mr * TM;
        int col = nr * TN;
        int rows = end - row < TM ? end - row : TM;
        int cols = N - col < TN ? N - col : TN;
        if constexpr (TRANSPORT || USE_DIRECT) {
          mm.SetSelfDefineData(meta|((uint64_t)(e==E-1 && nb==N)<<55)
            |((uint64_t)(col/128)<<57)|((uint64_t)((col/32)&3)<<41)|((uint64_t)(row+rows==M)<<62));
        }
        mm.SetSingleShape(rows, TRANSPORT ? (cols+31)/32*32 : cols, K);
        mm.SetTensorA(ag[(int64_t)row * ka], false);
        mm.SetTensorB(bg[(int64_t)e * K * nb + col], false);
        while (mm.Iterate()) {
          const int slot = produced & 1;
          if (produced >= 2) CrossCoreWaitFlag<2>(1 + 2 * slot);
          mm.GetTensorC(cg[((int64_t)GetBlockIdx() * 2 + scratchSlot) * TM * CPITCH]);
          CrossCoreSetFlag<2, PIPE_FIX>(2 * slot);
          ++produced;
        }
        ++tileCount;
      }
      if(!shardExperts)taskBase=AdvanceTaskBase(taskBase,tiles,cores);
      start = end;
    }
    if (produced > 1) CrossCoreWaitFlag<2>(1 + 2 * ((produced - 2) & 1));
    if (produced > 0) CrossCoreWaitFlag<2>(1 + 2 * ((produced - 1) & 1));
    mm.End();
  }
  if ASCEND_IS_AIV {
    const int core = GetBlockIdx() / 2;
    const int sub = GetBlockIdx() % 2;
    constexpr int VCOLS = CPITCH / 2;
    constexpr int CHUNK_ROWS = 64;
    constexpr int VCOUNT = CHUNK_ROWS * VCOLS;
    TPipe pipe;
    TQue<TPosition::VECIN, 1> cq, sq;
    TQue<TPosition::VECOUT, 1> oq;
    TBuf<TPosition::VECCALC> tb;
    pipe.InitBuffer(cq, 1, VCOUNT * sizeof(int32_t));
    pipe.InitBuffer(sq, 1, VCOLS * sizeof(float));
    pipe.InitBuffer(oq, 1, VCOUNT * sizeof(half));
    pipe.InitBuffer(tb, VCOUNT * sizeof(float));
    auto t = tb.Get<float>();
    int consumed = 0;
    int tileCount = 0;
    int taskBase = 0;
    int start = 0;
    const int eFirst = M==1 ? SingleRowExpert(gg,E) : (shardExperts ? core : 0);
    const int eStep = M==1 ? E : (shardExperts ? cores : 1);
    for (int e = eFirst; e < E; e += eStep) {
      if (shardExperts) start = e == 0 ? 0 : (int)gg.GetValue(e - 1);
      int end = (int)gg.GetValue(e);
      int tiles = ((end - start + TM - 1) / TM) * nc;
      if(tiles==0){start=end;continue;}
      int first = shardExperts ? 0 : core-taskBase;
      if(first<0)first+=cores;
      const int taskStep = shardExperts ? 1 : cores;
      for (int task = first; task < tiles; task += taskStep) {
        int mr,nr;TileCoordinates(task,nc,mr,nr);
        int row = start + mr * TM;
        int col = nr * TN + sub * VCOLS;
        int rows = end - row < TM ? end - row : TM;
        const int tileRemaining = TN - sub * VCOLS;
        const int validRemaining = N - col < tileRemaining ? N - col : tileRemaining;
        int cols = validRemaining < VCOLS ? validRemaining : VCOLS;
        const int scratchSlot = tileCount & 1;
        for (int chunkRow=0;chunkRow<rows;chunkRow+=tiling.baseM) {
          const int chunkRows=rows-chunkRow<tiling.baseM?rows-chunkRow:tiling.baseM;
          const int slot = consumed & 1;
          CrossCoreWaitFlag<2>(2 * slot);
          if (cols > 0) {
          auto c = cq.AllocTensor<int32_t>();
          auto s = sq.AllocTensor<float>();
          DataCopyPad(c, cg[((int64_t)core * 2 + scratchSlot) * TM * CPITCH + chunkRow * CPITCH + sub * VCOLS],
            DataCopyExtParams{(uint16_t)chunkRows, (uint32_t)(cols * 4),
              (uint32_t)((CPITCH - cols) * 4), (uint32_t)((VCOLS - (cols + 7) / 8 * 8) / 8), 0},
            DataCopyPadExtParams<int32_t>{true, 0, 0, 0});
          DataCopyPad(s, sg[(int64_t)e * N + col],
            DataCopyExtParams{1, (uint32_t)(cols * 4), 0, 0, 0},
            DataCopyPadExtParams<float>{true, 0, 0, 0.0f});
          cq.EnQue(c);
          sq.EnQue(s);
          c = cq.DeQue<int32_t>();
          s = sq.DeQue<float>();
          CrossCoreSetFlag<2, PIPE_MTE2>(1 + 2 * slot);
          auto z = c.ReinterpretCast<float>();
          Cast(z, c, RoundMode::CAST_RINT, chunkRows * VCOLS);
          PipeBarrier<PIPE_V>();
          if constexpr (TM > 255) {
            for(int r0=0;r0<chunkRows;r0+=255){
              const uint8_t repeats=(uint8_t)(chunkRows-r0<255?chunkRows-r0:255);
              for(int c0=0;c0<VCOLS;c0+=64)
                Mul(z[r0*VCOLS+c0],z[r0*VCOLS+c0],s[c0],(uint64_t)(VCOLS-c0<64?VCOLS-c0:64),repeats,
                  BinaryRepeatParams{1,1,1,VCOLS/8,VCOLS/8,0});
            }
          } else {
            for (int c0 = 0; c0 < VCOLS; c0 += 64)
              Mul(z[c0], z[c0], s[c0], (uint64_t)(VCOLS-c0<64?VCOLS-c0:64), (uint8_t)chunkRows,
                BinaryRepeatParams{1, 1, 1, VCOLS / 8, VCOLS / 8, 0});
          }
          PipeBarrier<PIPE_V>();
          GeluBounded(z,t,chunkRows*VCOLS);
          auto out = oq.AllocTensor<half>();
          Cast(out, z, RoundMode::CAST_RINT, chunkRows * VCOLS);
          oq.EnQue(out);
          out = oq.DeQue<half>();
          DataCopyPad(yg[(int64_t)(row + chunkRow) * N + col], out,
            DataCopyExtParams{(uint16_t)chunkRows, (uint32_t)(cols * 2),
              (uint32_t)((VCOLS - (cols + 15) / 16 * 16) / 16),
              (uint32_t)((N - cols) * 2), 0});
          oq.FreeTensor(out);
          sq.FreeTensor(s);
          cq.FreeTensor(c);
          } else {
            CrossCoreSetFlag<2, PIPE_MTE2>(1 + 2 * slot);
          }
          ++consumed;
        }
        ++tileCount;
      }
      if(!shardExperts)taskBase=AdvanceTaskBase(taskBase,tiles,cores);
      start = end;
    }
  }
}
template<int TM,int TN>
void LaunchResidentBalancedN(GM_ADDR x,GM_ADDR weight,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,
  int M,int N,int K,int E,int cores,aclrtStream stream)
{
  constexpr int BM=64, BK=128;
  constexpr int CPITCH=(TN+127)/128*128;
  static_assert(BM*TN*sizeof(int32_t)<=128*1024);
  static_assert(2*TN*BK<=64*1024);
  static_assert(BM*(CPITCH/2)*10+(CPITCH/2)*sizeof(float)<=184*1024);
  const int kBlocks=(K+BK-1)/BK;
  if((int64_t)kBlocks*BK*(2*BM+TN)>512*1024)return;
  const int maxTiles=((M+TM-1)/TM+E-1)*((N+TN-1)/TN);
  if(cores>maxTiles)cores=maxTiles;
  const bool padded=M>=256*E && K>=128 && N>=128 && K%32>=16 && N%32>=16;
  const int nb=padded?(N+31)/32*32:N;
  matmul_tiling::MultiCoreMatmulTiling mt;
  mt.SetDim(1);
  mt.SetAType(matmul_tiling::TPosition::GM,matmul_tiling::CubeFormat::ND,matmul_tiling::DataType::DT_INT8,false);
  mt.SetBType(matmul_tiling::TPosition::GM,matmul_tiling::CubeFormat::ND,matmul_tiling::DataType::DT_INT8,false);
  mt.SetCType(matmul_tiling::TPosition::GM,matmul_tiling::CubeFormat::ND,matmul_tiling::DataType::DT_INT32);
  mt.SetShape(TM,TN,K);mt.SetOrgShape(M,nb,K,K);
  mt.SetFixSplit(BM,TN,BK);mt.SetBufferSpace(512*1024,128*1024,0);
  TCubeTiling tiling;if(mt.GetTiling(tiling)!=0)return;
  tiling.baseM=BM;tiling.baseN=TN;tiling.baseK=BK;
  tiling.dbL0A=2;tiling.dbL0B=2;tiling.dbL0C=1;
  tiling.stepM=1;tiling.stepN=1;
  tiling.stepKa=kBlocks;tiling.stepKb=kBlocks;
  tiling.depthA1=2*kBlocks;tiling.depthB1=kBlocks;
  void* scratch=nullptr;
  if(aclrtMalloc(&scratch,(int64_t)cores*2*TM*CPITCH*sizeof(int32_t)+(padded?(int64_t)E*K*nb:0)+cores*64,
    ACL_MEM_MALLOC_HUGE_FIRST)!=ACL_SUCCESS)return;
  if(padded)ComputeResidentBalancedN<TM,TN,true><<<cores,nullptr,stream>>>(x,weight,scale,groups,y,(GM_ADDR)scratch,M,N,K,E,tiling);
  else ComputeResidentBalancedN<TM,TN,false><<<cores,nullptr,stream>>>(x,weight,scale,groups,y,(GM_ADDR)scratch,M,N,K,E,tiling);
  aclrtSynchronizeStream(stream);aclrtFree(scratch);
}
}
namespace Dense {
constexpr MatmulConfig MM_CONFIG =
  GetMDLConfig(false, false, 0, false, false, false, true, true, true, false, false, true);
constexpr MatmulConfig NORMAL_CONFIG = GetNormalConfig(false, false, false,
  BatchMode::NONE, true, IterateOrder::UNDEF, ScheduleType::INNER_PRODUCT,
  true, false, BatchOutMode::SINGLE_BATCH);
using AType = matmul::MatmulType<TPosition::GM, CubeFormat::ND, int8_t, false>;
using BType = matmul::MatmulType<TPosition::GM, CubeFormat::ND, int8_t, false>;
using CType = matmul::MatmulType<TPosition::GM, CubeFormat::ND, int32_t>;
using BiasType = matmul::MatmulType<TPosition::GM, CubeFormat::ND, int32_t>;
template<bool USE_NORMAL, typename CALLBACK> struct MatmulSelect;
template<typename CALLBACK> struct MatmulSelect<false, CALLBACK> {
  using Type = matmul::MatmulImpl<AType, BType, CType, BiasType, MM_CONFIG, CALLBACK>;
};
template<typename CALLBACK> struct MatmulSelect<true, CALLBACK> {
  using Type = matmul::MatmulImpl<AType, BType, CType, BiasType, NORMAL_CONFIG, CALLBACK>;
};
__aicore__ inline int SingleRowExpert(GlobalTensor<int64_t> groups,int E)
{
  if(E==1 || groups.GetValue(0)>0)return 0;
  int lo=1,hi=E-1;
  while(lo<hi){
    const int mid=(lo+hi)/2;
    if(groups.GetValue(mid)==0)lo=mid+1;else hi=mid;
  }
  return lo;
}
__aicore__ inline int SingleRowExpert(LocalTensor<int32_t> groups,int E)
{
  if(E==1 || groups.GetValue(0)>0)return 0;
  int lo=1,hi=E-1;
  while(lo<hi){
    const int mid=(lo+hi)/2;
    if(groups.GetValue(2*mid)==0)lo=mid+1;else hi=mid;
  }
  return lo;
}
__aicore__ inline void PadRows(GlobalTensor<int8_t> dst, GlobalTensor<int8_t> src,
  int64_t rows, int width, int padded)
{
  TPipe pipe;
  TBuf<TPosition::VECCALC> buffer;
  pipe.InitBuffer(buffer, 32768);
  auto data = buffer.Get<int8_t>();
  const int chunk = 32768 / padded;
  const int blocks = GetBlockNum() * 2;
  for (int64_t row = (int64_t)GetBlockIdx() * chunk; row < rows; row += (int64_t)blocks * chunk) {
    int count = rows - row < chunk ? rows - row : chunk;
    DataCopyPad(data, src[row * width],
      DataCopyExtParams{(uint16_t)count, (uint32_t)width, 0, 0, 0},
      DataCopyPadExtParams<int8_t>{true, 0, (uint8_t)(padded - width), 0});
    SetFlag<HardEvent::MTE2_MTE3>(EVENT_ID0);
    WaitFlag<HardEvent::MTE2_MTE3>(EVENT_ID0);
    DataCopy(dst[row * padded], data, count * padded);
    SetFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);
    WaitFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);
  }
}
__aicore__ inline void WordCopy(const LocalTensor<int8_t>& dst, const __gm__ int8_t* ptr,
  int height, int width, int stride, int paddedHeight, bool finalRow)
{
  const int count=height-((width%4 && finalRow)?1:0);
  const int groups=stride%4==0?1:(stride%2==0?2:4);
  auto d32=dst.ReinterpretCast<int32_t>();
  for (int g=0;g<groups && g<count;++g) {
    GlobalTensor<int32_t> src;
    src.SetGlobalBuffer((__gm__ int32_t*)(ptr+(int64_t)g*stride));
    DataCopy(d32[g*8],src,Nd2NzParams{1,(uint16_t)((count-g+groups-1)/groups),
      (uint16_t)((width+3)/4),0,(uint16_t)(stride*groups/4),
      (uint16_t)paddedHeight,(uint16_t)groups,0});
  }
  if (count<height) {
    GlobalTensor<int8_t> src;
    src.SetGlobalBuffer((__gm__ int8_t*)(ptr+(int64_t)(height-1)*stride));
    DataCopy(dst[(height-1)*32],src,Nd2NzParams{1,1,(uint16_t)width,0,
      (uint16_t)stride,(uint16_t)paddedHeight,1,0});
  }
}
__aicore__ inline void PairCopy(const LocalTensor<int8_t>& dst, const __gm__ int8_t* ptr,
  int height, int width, int stride, int paddedHeight, bool allowOdd, bool finalRow, bool preferWord)
{
  if (allowOdd && stride >= 4 && (stride <= 64 || preferWord)) {
    WordCopy(dst,ptr,height,width,stride,paddedHeight,finalRow);
    return;
  }
  GlobalTensor<int8_t> src;
  src.SetGlobalBuffer((__gm__ int8_t*)ptr);
  if ((width & 1) && !allowOdd) {
    DataCopy(dst,src,Nd2NzParams{1,(uint16_t)height,(uint16_t)width,0,
      (uint16_t)stride,(uint16_t)paddedHeight,1,0});
    return;
  }
  const int count=height-(((width&1)&&finalRow)?1:0);
  const int pairs=(width+1)/2;
  if (count>0) {
    auto d16=dst.ReinterpretCast<int16_t>();
    GlobalTensor<int16_t> s16;
    s16.SetGlobalBuffer((__gm__ int16_t*)ptr);
    if (stride % 2 == 0) {
      DataCopy(d16,s16,Nd2NzParams{1,(uint16_t)count,(uint16_t)pairs,0,
        (uint16_t)(stride/2),(uint16_t)paddedHeight,1,0});
    } else {
      DataCopy(d16,s16,Nd2NzParams{1,(uint16_t)((count+1)/2),(uint16_t)pairs,0,
        (uint16_t)stride,(uint16_t)paddedHeight,2,0});
      if (count>1) {
        s16.SetGlobalBuffer((__gm__ int16_t*)(ptr+stride));
        DataCopy(d16[16],s16,Nd2NzParams{1,(uint16_t)(count/2),(uint16_t)pairs,0,
          (uint16_t)stride,(uint16_t)paddedHeight,2,0});
      }
    }
  }
  if (count<height) {
    DataCopy(dst[(height-1)*32],src[(int64_t)(height-1)*stride],
      Nd2NzParams{1,1,(uint16_t)width,0,(uint16_t)stride,(uint16_t)paddedHeight,1,0});
  }
}
__aicore__ inline void PairA(const LocalTensor<int8_t>& dst, const __gm__ void* gm,
  int row, int col, int useM, int useK, uint64_t unused, uint64_t meta)
{
  int stride=meta&0x3fff;
  int bm=((meta>>41)&15)*16;
  int bk=((meta>>50)&31)*32;
  auto ptr=(const __gm__ int8_t*)gm+(int64_t)row*bm*stride+col*bk;
  const bool odd=(useK&1)!=0;
  PairCopy(dst,ptr,useM,useK,stride,(useM+15)/16*16,
    odd,odd && ((meta>>62)&1),false);
}
__aicore__ inline void PairB(const LocalTensor<int8_t>& dst, const __gm__ void* gm,
  int row, int col, int useK, int useN, uint64_t unused, uint64_t meta)
{
  int stride=(meta>>14)&0x1fff;
  int k=(meta>>27)&0x3fff;
  int bn=((meta>>45)&31)*32;
  int bk=((meta>>50)&31)*32;
  bool finalRow=((meta>>55)&1) && row*bk+useK==k;
  auto ptr=(const __gm__ int8_t*)gm+(int64_t)row*bk*stride+col*bn;
  const int paddedK=(useK+31)/32*32;
  PairCopy(dst,ptr,useK,useN,stride,paddedK,true,finalRow,(meta>>56)&1);
  if((useK&1) && useN>0){
    InitConstValue(dst.ReinterpretCast<int32_t>()[useK*8],
      InitConstValueParams<int32_t>{(uint16_t)((useN+31)/32),
        (uint16_t)(paddedK-useK),(uint16_t)useK,0});
  }
}
__aicore__ inline void SplitB(const LocalTensor<int8_t>& dst,const __gm__ void* gm,
  int row,int col,int useK,int useN,uint64_t unused,uint64_t meta)
{
  const int stride=(meta>>14)&0x1fff;
  const int bn=((meta>>45)&31)*32;
  const int valid=stride-col*bn;
  PairB(dst,gm,row,col,useK,useN<valid?useN:valid,unused,meta);
}
__aicore__ inline void AdaptiveB(const LocalTensor<int8_t>& dst,const __gm__ void* gm,
  int row,int col,int useK,int useN,uint64_t unused,uint64_t meta)
{
  const int stride=(meta>>14)&0x1fff;
  const int bn=((meta>>45)&31)*32;
  const int outer=(int)((meta>>57)&31)*128;
  const int valid=stride-outer-col*bn;
  PairB(dst,gm,row,col,useK,useN<valid?useN:valid,unused,meta);
}
template<bool ENABLED> struct TransportCallback;
template<> struct TransportCallback<true> {
  using Type=MatmulCallBackFunc<nullptr,PairA,AdaptiveB>;
};
template<> struct TransportCallback<false> {
  using Type=MatmulCallBackFunc<nullptr,nullptr,nullptr>;
};
template<int TM, int TN>
class DirectSingleMatmul {
  static constexpr int CK = 65536 / (TM > TN ? TM : TN);
  static_assert(TM * TN * sizeof(int32_t) <= 128 * 1024);
  TBuf<TPosition::A1> ab;
  TBuf<TPosition::B1> bb;
  TBuf<TPosition::A2> a0;
  TBuf<TPosition::B2> b0;
  TBuf<TPosition::CO1> cb;
  GlobalTensor<int8_t> a, b;
  uint64_t meta = 0;
  int rows, cols, depth;
  bool previous = false;
  const __gm__ int8_t* cached_b = nullptr;
  uint64_t cached_b_meta = 0;
  int cached_b_cols = 0, cached_b_depth = 0;
  TPipe* pipe_;
  TEventID event_MTE1_MTE2;
  TEventID event_MTE2_MTE1;
  TEventID event_M_MTE1;
  TEventID event_MTE1_M;
  TEventID event_FIX_M;
  TEventID event_M_FIX;
public:
  __aicore__ inline void SetSubBlockIdx(int) {}
  __aicore__ inline void Init(TCubeTiling*, TPipe* pipe) {
    pipe->InitBuffer(ab, TM * CK);
    pipe->InitBuffer(bb, CK * TN);
    pipe->InitBuffer(a0, TM * CK);
    pipe->InitBuffer(b0, CK * TN);
    pipe->InitBuffer(cb, TM * TN * sizeof(int32_t));
    pipe_ = pipe;
    event_MTE1_MTE2 = pipe->AllocEventID<HardEvent::MTE1_MTE2>();
    event_MTE2_MTE1 = pipe->AllocEventID<HardEvent::MTE2_MTE1>();
    event_M_MTE1 = pipe->AllocEventID<HardEvent::M_MTE1>();
    event_MTE1_M = pipe->AllocEventID<HardEvent::MTE1_M>();
    event_FIX_M = pipe->AllocEventID<HardEvent::FIX_M>();
    event_M_FIX = pipe->AllocEventID<HardEvent::M_FIX>();
  }
  __aicore__ inline void SetOrgShape(int, int, int, int, int) {}
  __aicore__ inline void SetSingleShape(int m, int n, int k) {
    rows = m; cols = n; depth = k;
  }
  __aicore__ inline void SetSelfDefineData(uint64_t value) { meta = value; }
  __aicore__ inline void SetTensorA(GlobalTensor<int8_t> value, bool) { a = value; }
  __aicore__ inline void SetTensorB(GlobalTensor<int8_t> value, bool) { b = value; }
  __aicore__ inline void End() {
    PipeBarrier<PIPE_ALL>();
    pipe_->ReleaseEventID<HardEvent::MTE1_MTE2>(event_MTE1_MTE2);
    pipe_->ReleaseEventID<HardEvent::MTE2_MTE1>(event_MTE2_MTE1);
    pipe_->ReleaseEventID<HardEvent::M_MTE1>(event_M_MTE1);
    pipe_->ReleaseEventID<HardEvent::MTE1_M>(event_MTE1_M);
    pipe_->ReleaseEventID<HardEvent::FIX_M>(event_FIX_M);
    pipe_->ReleaseEventID<HardEvent::M_FIX>(event_M_FIX);
  }
  __aicore__ inline void IterateAll(GlobalTensor<int32_t> c, bool) {
    auto al = ab.Get<int8_t>(), bl = bb.Get<int8_t>();
    auto ac = a0.Get<int8_t>(), bc = b0.Get<int8_t>();
    auto cc = cb.Get<int32_t>();
    const int mr = (rows + 15) / 16 * 16;
    const int nr = (cols + 31) / 32 * 32;
    const int kr = (depth + 31) / 32 * 32;
    const auto bptr = b.GetPhyAddr();
    const uint64_t bmeta = meta & ~(uint64_t(1) << 62);
    const bool reuseB = previous && bptr == cached_b && bmeta == cached_b_meta
      && cols == cached_b_cols && depth == cached_b_depth;
    if (previous) {
      SetFlag<HardEvent::MTE1_MTE2>(static_cast<event_t>(event_MTE1_MTE2));
      WaitFlag<HardEvent::MTE1_MTE2>(static_cast<event_t>(event_MTE1_MTE2));
    }
    PairA(al, a.GetPhyAddr(), 0, 0, rows, depth, 0, meta);
    if (!reuseB) {
      AdaptiveB(bl, bptr, 0, 0, depth, cols, 0, meta);
      if (kr != depth && (depth & 1) == 0) {
        const int stride = (meta >> 14) & 0x1fff;
        const int outer = (int)((meta >> 57) & 31) * 128;
        const int valid = stride - outer < cols ? stride - outer : cols;
        InitConstValue(bl.ReinterpretCast<int32_t>()[depth * 8],
          InitConstValueParams<int32_t>{(uint16_t)((valid + 31) / 32),
            (uint16_t)(kr - depth), (uint16_t)depth, 0});
      }
    }
    SetFlag<HardEvent::MTE2_MTE1>(static_cast<event_t>(event_MTE2_MTE1));
    WaitFlag<HardEvent::MTE2_MTE1>(static_cast<event_t>(event_MTE2_MTE1));
    if (previous) {
      SetFlag<HardEvent::M_MTE1>(static_cast<event_t>(event_M_MTE1));
      WaitFlag<HardEvent::M_MTE1>(static_cast<event_t>(event_M_MTE1));
    }
    const uint8_t pad[4] = {0, 0, 0, 0};
    SetFmatrix(1, mr, pad, FmatrixMode::FMATRIX_LEFT);
    LoadData3DParamsV2Pro la;
    la.channelSize = kr;
    la.extConfig = ((uint64_t)mr << 16) | kr;
    LoadData(ac, al, la);
    if (!reuseB) {
      LoadData2dTransposeParams lb{0, (uint8_t)(nr / 32), (uint16_t)(kr / 32), 1, 0};
      for (int ki = 0; ki < kr; ki += 32)
        LoadDataWithTranspose(bc[ki * nr], bl[ki * 32], lb);
    }
    SetFlag<HardEvent::MTE1_M>(static_cast<event_t>(event_MTE1_M));
    WaitFlag<HardEvent::MTE1_M>(static_cast<event_t>(event_MTE1_M));
    if (previous) {
      SetFlag<HardEvent::FIX_M>(static_cast<event_t>(event_FIX_M));
      WaitFlag<HardEvent::FIX_M>(static_cast<event_t>(event_FIX_M));
    }
    MmadParams mp;
    mp.m = mr; mp.n = nr; mp.k = kr; mp.cmatrixInitVal = true;
    Mmad(cc, ac, bc, mp);
    SetFlag<HardEvent::M_FIX>(static_cast<event_t>(event_M_FIX));
    WaitFlag<HardEvent::M_FIX>(static_cast<event_t>(event_M_FIX));
    FixpipeParamsV220 fp;
    fp.nSize = cols; fp.mSize = rows; fp.srcStride = mr; fp.dstStride = TN;
    Fixpipe(c, cc, fp);
    cached_b = bptr; cached_b_meta = bmeta;
    cached_b_cols = cols; cached_b_depth = depth;
    previous = true;
  }
};
template<int TM, int TN, bool NORMAL, bool DIRECT, typename CALLBACK>
struct CubeSelect {
  using Type = typename MatmulSelect<NORMAL, CALLBACK>::Type;
};
template<int TM, int TN, bool NORMAL, typename CALLBACK>
struct CubeSelect<TM, TN, NORMAL, true, CALLBACK> {
  using Type = DirectSingleMatmul<TM, TN>;
};
__aicore__ inline int AdvanceTaskBase(int base,int count,int cores)
{
  const int sum=base+count;
  if(sum<cores)return sum;
  return count<cores?sum-cores:sum%cores;
}
__aicore__ inline void TileCoordinates(int task,int nc,int& mr,int& nr)
{
  if(nc==1){mr=task;nr=0;}
  else if(nc==2){mr=task>>1;nr=task&1;}
  else {mr=task/nc;nr=task-mr*nc;}
}
__aicore__ inline void GeluBounded(LocalTensor<float> z,LocalTensor<float> t,int count)
{
  const BinaryRepeatParams binary{1,1,1,8,8,8};
  const UnaryRepeatParams unary{1,1,8,8};
  for(int offset=0;offset<count;){
    const int remaining=count-offset;
    const int full=remaining/64;
    const uint8_t repeats=(uint8_t)(full>255?255:(full>0?full:1));
    const uint64_t mask=full>0?64:(uint64_t)remaining;
    auto a=z[offset];auto b=t[offset];
    Mul(b,a,a,mask,repeats,binary);PipeBarrier<PIPE_V>();
    Muls(b,b,-0.07135481627260025f,mask,repeats,unary);PipeBarrier<PIPE_V>();
    Adds(b,b,-1.5957691216057308f,mask,repeats,unary);PipeBarrier<PIPE_V>();
    Mul(b,b,a,mask,repeats,binary);PipeBarrier<PIPE_V>();
    Maxs(b,b,-87.0f,mask,repeats,unary);PipeBarrier<PIPE_V>();
    Mins(b,b,87.0f,mask,repeats,unary);PipeBarrier<PIPE_V>();
    Exp(b,b,mask,repeats,unary);PipeBarrier<PIPE_V>();
    Adds(b,b,1.0f,mask,repeats,unary);PipeBarrier<PIPE_V>();
    Div(a,a,b,mask,repeats,binary);PipeBarrier<PIPE_V>();
    offset+=full>0?(int)repeats*64:(int)mask;
  }
}
template<int TM, int TN, bool PADDED, bool TRANSPORT, bool USE_NORMAL = false, bool USE_DIRECT = false>
__global__ __mix__(1, 2) void Compute(
  GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groups,
  GM_ADDR y, GM_ADDR workspace, int M, int N, int K, int E, TCubeTiling tiling)
{
  InitSocState();
  GlobalTensor<int8_t> ag, bg;
  GlobalTensor<int64_t> gg;
  GlobalTensor<int32_t> cg;
  GlobalTensor<float> sg;
  GlobalTensor<half> yg;
  ag.SetGlobalBuffer((__gm__ int8_t*)x);
  bg.SetGlobalBuffer((__gm__ int8_t*)weight);
  gg.SetGlobalBuffer((__gm__ int64_t*)groups);
  cg.SetGlobalBuffer((__gm__ int32_t*)workspace);
  sg.SetGlobalBuffer((__gm__ float*)scale);
  yg.SetGlobalBuffer((__gm__ half*)y);
  const int ka = K;
  const int nb = PADDED ? (N + 31) / 32 * 32 : N;
  if constexpr (PADDED) {
    auto base = workspace + (int64_t)GetBlockNum() * 2 * (TM * TN + 128) * sizeof(int32_t);
    GlobalTensor<int8_t> ap, bp;
    ap.SetGlobalBuffer((__gm__ int8_t*)base);
    bp.SetGlobalBuffer((__gm__ int8_t*)(base + (ka != K ? (int64_t)M * ka : 0)));
    if ASCEND_IS_AIV {
      if (ka != K) PadRows(ap, ag, M, K, ka);
      if (nb != N) PadRows(bp, bg, (int64_t)E * K, N, nb);
    }
    SyncAll<false>();
    if (ka != K) ag = ap;
    if (nb != N) bg = bp;
  }
  const int nc = (N + TN - 1) / TN;
  const int cores = GetBlockNum();
  const bool shardExperts = M!=1 && E >= 2 * cores && N <= 512 && K <= 512;
  if ASCEND_IS_AIC {
    TPipe pipe;
    typename CubeSelect<TM,TN,USE_NORMAL,USE_DIRECT,typename TransportCallback<TRANSPORT>::Type>::Type mm;
    mm.SetSubBlockIdx(0);
    mm.Init(&tiling, &pipe);
    mm.SetOrgShape(M, TRANSPORT ? (N+31)/32*32 : nb, ka, K, TN);
    uint64_t meta=0;
    if constexpr (TRANSPORT || USE_DIRECT)
      meta=(uint64_t)ka|((uint64_t)nb<<14)|((uint64_t)K<<27)
        |((uint64_t)(tiling.baseM/16)<<41)|((uint64_t)(tiling.baseN/32)<<45)
        |((uint64_t)(tiling.baseK/32)<<50)|((uint64_t)PADDED<<56);
    int taskBase = 0;
    int start = 0;
    int produced = 0;
    const int eFirst = M==1 ? SingleRowExpert(gg,E) : (shardExperts ? GetBlockIdx() : 0);
    const int eStep = M==1 ? E : (shardExperts ? cores : 1);
    for (int e = eFirst; e < E; e += eStep) {
      if (shardExperts) start = e == 0 ? 0 : (int)gg.GetValue(e - 1);
      int end = (int)gg.GetValue(e);
      int tiles = ((end - start + TM - 1) / TM) * nc;
      if(tiles==0){start=end;continue;}
      int first = shardExperts ? 0 : GetBlockIdx()-taskBase;
      if(first<0)first+=cores;
      const int taskStep = shardExperts ? 1 : cores;
      for (int task = first; task < tiles; task += taskStep) {
        const int slot = produced & 1;
        if (produced >= 2) CrossCoreWaitFlag<2>(1 + 2 * slot);
        int mr,nr;TileCoordinates(task,nc,mr,nr);
        int row = start + mr * TM;
        int col = nr * TN;
        int rows = end - row < TM ? end - row : TM;
        int cols = N - col < TN ? N - col : TN;
        if constexpr (TRANSPORT || USE_DIRECT) {
          mm.SetSelfDefineData(meta|((uint64_t)(e==E-1 && nb==N)<<55)
            |((uint64_t)(col/128)<<57)|((uint64_t)(row+rows==M)<<62));
        }
        mm.SetSingleShape(rows, TRANSPORT ? (cols+31)/32*32 : cols, K);
        mm.SetTensorA(ag[(int64_t)row * ka], false);
        mm.SetTensorB(bg[(int64_t)e * K * nb + col], false);
        mm.IterateAll(cg[((int64_t)GetBlockIdx() * 2 + slot) * (TM * TN + 128)], false);
        CrossCoreSetFlag<2, PIPE_FIX>(2 * slot);
        ++produced;
      }
      if(!shardExperts)taskBase=AdvanceTaskBase(taskBase,tiles,cores);
      start = end;
    }
    if (produced > 1) CrossCoreWaitFlag<2>(1 + 2 * ((produced - 2) & 1));
    if (produced > 0) CrossCoreWaitFlag<2>(1 + 2 * ((produced - 1) & 1));
    mm.End();
  }
  if ASCEND_IS_AIV {
    const int core = GetBlockIdx() / 2;
    const int sub = GetBlockIdx() % 2;
    constexpr int VCOLS = TN / 2;
    constexpr int VCOUNT = TM * VCOLS;
    TPipe pipe;
    TQue<TPosition::VECIN, 1> cq, sq;
    TQue<TPosition::VECOUT, 1> oq;
    TBuf<TPosition::VECCALC> tb;
    pipe.InitBuffer(cq, 1, VCOUNT * sizeof(int32_t));
    pipe.InitBuffer(sq, 1, VCOLS * sizeof(float));
    pipe.InitBuffer(oq, 1, VCOUNT * sizeof(half));
    pipe.InitBuffer(tb, VCOUNT * sizeof(float));
    auto t = tb.Get<float>();
    int consumed = 0;
    int taskBase = 0;
    int start = 0;
    const int eFirst = M==1 ? SingleRowExpert(gg,E) : (shardExperts ? core : 0);
    const int eStep = M==1 ? E : (shardExperts ? cores : 1);
    for (int e = eFirst; e < E; e += eStep) {
      if (shardExperts) start = e == 0 ? 0 : (int)gg.GetValue(e - 1);
      int end = (int)gg.GetValue(e);
      int tiles = ((end - start + TM - 1) / TM) * nc;
      if(tiles==0){start=end;continue;}
      int first = shardExperts ? 0 : core-taskBase;
      if(first<0)first+=cores;
      const int taskStep = shardExperts ? 1 : cores;
      for (int task = first; task < tiles; task += taskStep) {
        int mr,nr;TileCoordinates(task,nc,mr,nr);
        int row = start + mr * TM;
        int col = nr * TN + sub * VCOLS;
        int rows = end - row < TM ? end - row : TM;
        int cols = N - col < VCOLS ? N - col : VCOLS;
        const int slot = consumed & 1;
        CrossCoreWaitFlag<2>(2 * slot);
        if (rows > 0 && cols > 0) {
          auto c = cq.AllocTensor<int32_t>();
          auto s = sq.AllocTensor<float>();
          DataCopyPad(c, cg[((int64_t)core * 2 + slot) * (TM * TN + 128) + sub * VCOLS],
            DataCopyExtParams{(uint16_t)rows, (uint32_t)(cols * 4),
              (uint32_t)((TN - cols) * 4), (uint32_t)((VCOLS - (cols + 7) / 8 * 8) / 8), 0},
            DataCopyPadExtParams<int32_t>{true, 0, 0, 0});
          DataCopyPad(s, sg[(int64_t)e * N + col],
            DataCopyExtParams{1, (uint32_t)(cols * 4), 0, 0, 0},
            DataCopyPadExtParams<float>{true, 0, 0, 0.0f});
          cq.EnQue(c);
          sq.EnQue(s);
          c = cq.DeQue<int32_t>();
          s = sq.DeQue<float>();
          CrossCoreSetFlag<2, PIPE_MTE2>(1 + 2 * slot);
          auto z = c.ReinterpretCast<float>();
          Cast(z, c, RoundMode::CAST_RINT, rows * VCOLS);
          PipeBarrier<PIPE_V>();
          if constexpr (TM > 255) {
            for(int r0=0;r0<rows;r0+=255){
              const uint8_t repeats=(uint8_t)(rows-r0<255?rows-r0:255);
              for(int c0=0;c0<VCOLS;c0+=64)
                Mul(z[r0*VCOLS+c0],z[r0*VCOLS+c0],s[c0],(uint64_t)64,repeats,
                  BinaryRepeatParams{1,1,1,VCOLS/8,VCOLS/8,0});
            }
          } else {
            for (int c0 = 0; c0 < VCOLS; c0 += 64)
              Mul(z[c0], z[c0], s[c0], (uint64_t)64, (uint8_t)rows,
                BinaryRepeatParams{1, 1, 1, VCOLS / 8, VCOLS / 8, 0});
          }
          PipeBarrier<PIPE_V>();
          GeluBounded(z,t,rows*VCOLS);
          auto out = oq.AllocTensor<half>();
          Cast(out, z, RoundMode::CAST_RINT, rows * VCOLS);
          oq.EnQue(out);
          out = oq.DeQue<half>();
          DataCopyPad(yg[(int64_t)row * N + col], out,
            DataCopyExtParams{(uint16_t)rows, (uint32_t)(cols * 2),
              (uint32_t)((VCOLS - (cols + 15) / 16 * 16) / 16),
              (uint32_t)((N - cols) * 2), 0});
          oq.FreeTensor(out);
          sq.FreeTensor(s);
          cq.FreeTensor(c);
        } else {
          CrossCoreSetFlag<2, PIPE_MTE2>(1 + 2 * slot);
        }
        ++consumed;
      }
      if(!shardExperts)taskBase=AdvanceTaskBase(taskBase,tiles,cores);
      start = end;
    }
  }
}
__aicore__ inline int FindExpert(GlobalTensor<int64_t> gg,int row,int M,int E,int& end)
{
  const int guess=row*E/M;
  end=(int)gg.GetValue(guess);
  const int start=guess==0?0:(int)gg.GetValue(guess-1);
  if(start<=row && row<end)return guess;
  int lo=row>=end?guess+1:0;
  int hi=row>=end?E-1:guess-1;
  while(lo<hi){
    const int mid=(lo+hi)/2;
    if(row<(int)gg.GetValue(mid))hi=mid;
    else lo=mid+1;
  }
  end=(int)gg.GetValue(lo);
  return lo;
}
template<bool ENABLED>struct AdaptiveCallback;
template<>struct AdaptiveCallback<true>{using Type=MatmulCallBackFunc<nullptr,PairA,AdaptiveB>;};
template<>struct AdaptiveCallback<false>{using Type=MatmulCallBackFunc<nullptr,nullptr,nullptr>;};
__aicore__ inline bool NeedsSchedulePlan(GlobalTensor<int64_t> gg,int M,int N,int K,int E,int cores)
{
  const int first=(int)gg.GetValue(0);
  const int last=M-(int)gg.GetValue(E-2);
  const int largest=first>last?first:last;
  return (first==0 && last==0) || largest*cores>2*M
    || (first+last)*E*4<M
    || ((first==0 || last==0) && (K*N>=65536 || K%32 || N%32));
}
template<int TM,int TN>
__aicore__ inline int ChooseSchedule(GM_ADDR groups,GlobalTensor<int32_t> record,
  int M,int N,int E,int cores)
{
  TPipe pipe;
  TBuf<TPosition::VECCALC> gb,hb,ob;
  pipe.InitBuffer(gb,128*8);
  pipe.InitBuffer(hb,64*4);
  pipe.InitBuffer(ob,32);
  auto g=gb.Get<int32_t>();
  auto h=hb.Get<int32_t>();
  auto out=ob.Get<int32_t>();
  GlobalTensor<int32_t> gg;
  gg.SetGlobalBuffer((__gm__ int32_t*)groups);
  DataCopyPad(g,gg,DataCopyExtParams{1,(uint32_t)(E*8),0,0,0},
    DataCopyPadExtParams<int32_t>{true,0,0,0});
  SetFlag<HardEvent::MTE2_S>(EVENT_ID0);
  WaitFlag<HardEvent::MTE2_S>(EVENT_ID0);
  const int nc=(N+TN-1)/TN;
  const int stripes=(M+TM-1)/TM*nc;
  for(int c=0;c<cores;++c){
    h.SetValue(c,0);
    h.SetValue(32+c,(stripes+cores-1-c)/cores);
  }
  int start=0,total=0,owner=0;
  for(int e=0;e<E;++e){
    const int end=g.GetValue(2*e);
    const int tasks=(end-start+TM-1)/TM*nc;
    h.SetValue(owner,h.GetValue(owner)+tasks);
    if(++owner==cores)owner=0;
    total+=tasks;
    if(end>start && start>0 && start%TM){
      const int tile=start/TM*nc;
      for(int col=0;col<nc;++col){
        const int c=(tile+col)%cores;
        h.SetValue(32+c,h.GetValue(32+c)+1);
      }
    }
    start=end;
  }
  int maxExpert=0,maxStripe=0;
  for(int c=0;c<cores;++c){
    const int a=h.GetValue(c),b=h.GetValue(32+c);
    if(a>maxExpert)maxExpert=a;
    if(b>maxStripe)maxStripe=b;
  }
  int mode=maxStripe<maxExpert?1:0;
  const int best=mode?maxStripe:maxExpert;
  const int ideal=(total+cores-1)/cores;
  if(best>ideal+(E+15)/16)mode=2;
  for(int i=0;i<8;++i)out.SetValue(i,mode);
  SetFlag<HardEvent::S_MTE3>(EVENT_ID0);
  WaitFlag<HardEvent::S_MTE3>(EVENT_ID0);
  DataCopy(record,out,8);
  CrossCoreSetFlag<2,PIPE_MTE3>(4);
  SetFlag<HardEvent::MTE3_S>(EVENT_ID0);
  WaitFlag<HardEvent::MTE3_S>(EVENT_ID0);
  return mode;
}
struct ScheduledTile {int expert,row,col,rows,cols;};
template<int TM,int TN>
class TaskSchedule {
  GlobalTensor<int64_t> gg_;
  int M_,N_,E_,cores_,core_,mode_,nc_;
  int e_,start_,end_,tiles_,next_,base_;
  int stripe_,stripeCount_,row_,limit_;
  __aicore__ inline void LoadExpert()
  {
    if(mode_==0)start_=e_==0?0:(int)gg_.GetValue(e_-1);
    end_=(int)gg_.GetValue(e_);
    tiles_=(end_-start_+TM-1)/TM*nc_;
    next_=mode_==0?0:core_-base_;
    if(next_<0)next_+=cores_;
  }
  __aicore__ inline void LoadStripe()
  {
    int mr,nr;TileCoordinates(stripe_,nc_,mr,nr);
    row_=mr*TM;
    limit_=row_+TM<M_?row_+TM:M_;
  }
public:
  __aicore__ inline TaskSchedule(GlobalTensor<int64_t> gg,int M,int N,int E,
    int cores,int core,int mode):gg_(gg),M_(M),N_(N),E_(E),cores_(cores),
    core_(core),mode_(mode),nc_((N+TN-1)/TN),e_(mode==0?core:0),
    start_(0),end_(0),tiles_(0),next_(0),base_(0),stripe_(core),
    stripeCount_((M+TM-1)/TM*nc_),row_(0),limit_(0)
  {
    if(mode_==1)LoadStripe();
    else if(e_<E_)LoadExpert();
  }
  __aicore__ inline bool Next(ScheduledTile& t)
  {
    if(mode_==1){
      if(row_>=limit_){stripe_+=cores_;LoadStripe();}
      if(stripe_>=stripeCount_)return false;
      int end;
      t.expert=FindExpert(gg_,row_,M_,E_,end);
      int mr,nr;TileCoordinates(stripe_,nc_,mr,nr);
      t.row=row_;t.col=nr*TN;
      t.rows=(end<limit_?end:limit_)-row_;
      t.cols=N_-t.col<TN?N_-t.col:TN;
      row_+=t.rows;
      return true;
    }
    while(e_<E_){
      if(next_<tiles_){
        int mr,nr;TileCoordinates(next_,nc_,mr,nr);
        t.expert=e_;t.row=start_+mr*TM;t.col=nr*TN;
        t.rows=end_-t.row<TM?end_-t.row:TM;
        t.cols=N_-t.col<TN?N_-t.col:TN;
        next_+=mode_==0?1:cores_;
        return true;
      }
      if(mode_!=0)base_=AdvanceTaskBase(base_,tiles_,cores_);
      start_=end_;e_+=mode_==0?cores_:1;
      if(e_<E_)LoadExpert();
    }
    return false;
  }
};
template<int TM, int TN, bool PADDED, bool TRANSPORT, bool USE_NORMAL = false, bool USE_DIRECT = false>
__global__ __mix__(1, 2) void ComputeAdaptive(
  GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groups,
  GM_ADDR y, GM_ADDR workspace, int M, int N, int K, int E, TCubeTiling tiling)
{
  InitSocState();
  GlobalTensor<int8_t> ag, bg;
  GlobalTensor<int64_t> gg;
  GlobalTensor<int32_t> cg;
  GlobalTensor<float> sg;
  GlobalTensor<half> yg;
  ag.SetGlobalBuffer((__gm__ int8_t*)x);
  bg.SetGlobalBuffer((__gm__ int8_t*)weight);
  gg.SetGlobalBuffer((__gm__ int64_t*)groups);
  cg.SetGlobalBuffer((__gm__ int32_t*)workspace);
  sg.SetGlobalBuffer((__gm__ float*)scale);
  yg.SetGlobalBuffer((__gm__ half*)y);
  const int ka = K;
  const int nb = PADDED ? (N + 31) / 32 * 32 : N;
  if constexpr (PADDED) {
    auto base = workspace + (int64_t)GetBlockNum() * 2 * (TM * TN + 128) * sizeof(int32_t);
    GlobalTensor<int8_t> ap, bp;
    ap.SetGlobalBuffer((__gm__ int8_t*)base);
    bp.SetGlobalBuffer((__gm__ int8_t*)(base + (ka != K ? (int64_t)M * ka : 0)));
    if ASCEND_IS_AIV {
      if (ka != K) PadRows(ap, ag, M, K, ka);
      if (nb != N) PadRows(bp, bg, (int64_t)E * K, N, nb);
    }
    SyncAll<false>();
    if (ka != K) ag = ap;
    if (nb != N) bg = bp;
  }
  const int nc = (N + TN - 1) / TN;
  const int cores = GetBlockNum();
  GlobalTensor<int32_t> rg;
  rg.SetGlobalBuffer((__gm__ int32_t*)(workspace
    +(int64_t)cores*2*(TM*TN+128)*sizeof(int32_t)));
  const bool plan=NeedsSchedulePlan(gg,M,N,K,E,cores);
  if ASCEND_IS_AIC {
    TPipe pipe;
    typename CubeSelect<TM,TN,USE_NORMAL,USE_DIRECT,typename AdaptiveCallback<TRANSPORT>::Type>::Type mm;
    mm.SetSubBlockIdx(0);
    mm.Init(&tiling, &pipe);
    mm.SetOrgShape(M, TRANSPORT?(N+31)/32*32:nb, ka, K, TN);
    uint64_t meta=0;
    if constexpr (TRANSPORT || USE_DIRECT)
      meta=(uint64_t)ka|((uint64_t)nb<<14)|((uint64_t)K<<27)
        |((uint64_t)(tiling.baseM/16)<<41)|((uint64_t)(tiling.baseN/32)<<45)
        |((uint64_t)(tiling.baseK/32)<<50)|((uint64_t)PADDED<<56);
    int mode=0;
    if(plan){
      CrossCoreWaitFlag<2>(4);
      auto record=rg[GetBlockIdx()*16];
      DataCacheCleanAndInvalid<int32_t,CacheLine::SINGLE_CACHE_LINE,DcciDst::CACHELINE_OUT>(record);
      mode=record.GetValue(0);
    }
    TaskSchedule<TM,TN> schedule(gg,M,N,E,cores,GetBlockIdx(),mode);
    ScheduledTile task;
    int produced=0;
    while(schedule.Next(task)){
      const int slot=produced&1;
      if(produced>=2)CrossCoreWaitFlag<2>(1+2*slot);
      if constexpr(TRANSPORT || USE_DIRECT)
        mm.SetSelfDefineData(meta|((uint64_t)(task.expert==E-1 && nb==N)<<55)
          |((uint64_t)(task.col/128)<<57)|((uint64_t)(task.row+task.rows==M)<<62));
      mm.SetSingleShape(task.rows,TRANSPORT?(task.cols+31)/32*32:task.cols,K);
      mm.SetTensorA(ag[(int64_t)task.row*ka],false);
      mm.SetTensorB(bg[(int64_t)task.expert*K*nb+task.col],false);
      mm.IterateAll(cg[((int64_t)GetBlockIdx()*2+slot)*(TM*TN+128)],false);
      CrossCoreSetFlag<2,PIPE_FIX>(2*slot);
      ++produced;
    }
    if (produced > 1) CrossCoreWaitFlag<2>(1 + 2 * ((produced - 2) & 1));
    if (produced > 0) CrossCoreWaitFlag<2>(1 + 2 * ((produced - 1) & 1));
    mm.End();
  }
  if ASCEND_IS_AIV {
    const int core = GetBlockIdx() / 2;
    const int sub = GetBlockIdx() % 2;
    const int mode=plan?ChooseSchedule<TM,TN>(groups,
      rg[core*16+sub*8],M,N,E,cores):0;
    constexpr int VCOLS = TN / 2;
    constexpr int VCOUNT = TM * VCOLS;
    TPipe pipe;
    TQue<TPosition::VECIN, 1> cq, sq;
    TQue<TPosition::VECOUT, 1> oq;
    TBuf<TPosition::VECCALC> tb;
    pipe.InitBuffer(cq, 1, VCOUNT * sizeof(int32_t));
    pipe.InitBuffer(sq, 1, VCOLS * sizeof(float));
    pipe.InitBuffer(oq, 1, VCOUNT * sizeof(half));
    pipe.InitBuffer(tb, VCOUNT * sizeof(float));
    auto t = tb.Get<float>();
    TaskSchedule<TM,TN> schedule(gg,M,N,E,cores,core,mode);
    ScheduledTile task;
    int consumed=0;
    while(schedule.Next(task)){
      const int e=task.expert,row=task.row;
      const int col=task.col+sub*VCOLS;
      const int rows=task.rows;
      const int cols=N-col<VCOLS?N-col:VCOLS;
        const int slot = consumed & 1;
        CrossCoreWaitFlag<2>(2 * slot);
        if (rows > 0 && cols > 0) {
          auto c = cq.AllocTensor<int32_t>();
          auto s = sq.AllocTensor<float>();
          DataCopyPad(c, cg[((int64_t)core * 2 + slot) * (TM * TN + 128) + sub * VCOLS],
            DataCopyExtParams{(uint16_t)rows, (uint32_t)(cols * 4),
              (uint32_t)((TN - cols) * 4), (uint32_t)((VCOLS - (cols + 7) / 8 * 8) / 8), 0},
            DataCopyPadExtParams<int32_t>{true, 0, 0, 0});
          DataCopyPad(s, sg[(int64_t)e * N + col],
            DataCopyExtParams{1, (uint32_t)(cols * 4), 0, 0, 0},
            DataCopyPadExtParams<float>{true, 0, 0, 0.0f});
          cq.EnQue(c);
          sq.EnQue(s);
          c = cq.DeQue<int32_t>();
          s = sq.DeQue<float>();
          CrossCoreSetFlag<2, PIPE_MTE2>(1 + 2 * slot);
          auto z = c.ReinterpretCast<float>();
          Cast(z, c, RoundMode::CAST_RINT, rows * VCOLS);
          PipeBarrier<PIPE_V>();
          for (int c0 = 0; c0 < VCOLS; c0 += 64)
            Mul(z[c0], z[c0], s[c0], (uint64_t)64, (uint8_t)rows,
              BinaryRepeatParams{1, 1, 1, VCOLS / 8, VCOLS / 8, 0});
          PipeBarrier<PIPE_V>();
          GeluBounded(z,t,rows*VCOLS);
          auto out = oq.AllocTensor<half>();
          Cast(out, z, RoundMode::CAST_RINT, rows * VCOLS);
          oq.EnQue(out);
          out = oq.DeQue<half>();
          DataCopyPad(yg[(int64_t)row * N + col], out,
            DataCopyExtParams{(uint16_t)rows, (uint32_t)(cols * 2),
              (uint32_t)((VCOLS - (cols + 15) / 16 * 16) / 16),
              (uint32_t)((N - cols) * 2), 0});
          oq.FreeTensor(out);
          sq.FreeTensor(s);
          cq.FreeTensor(c);
        } else {
          CrossCoreSetFlag<2, PIPE_MTE2>(1 + 2 * slot);
        }
        ++consumed;
    }
  }
}
template<int TM, int TN, bool PADDED>
void Dispatch(GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR group_list,
  GM_ADDR y, GM_ADDR scratch, int M, int N, int K, int E, int cores,
  aclrtStream stream, TCubeTiling tiling)
{
  if constexpr (!PADDED && TM*TN*sizeof(int32_t)<=128*1024) {
    const int kr=(K+31)/32*32;
    if((int64_t)TM*kr<=64*1024 && (int64_t)TN*kr<=64*1024) {
      if constexpr(TM==64 && (TN==128 || TN==256 || TN==512)) {
        if(cores>1 && E>=2*cores && N<=512 && K<=512 && M>=TM*E && M<128*E) {
          if(K%32!=0 || N%32!=0)
            ComputeAdaptive<TM,TN,false,true,false,true><<<cores,nullptr,stream>>>(
              x,weight,scale,group_list,y,scratch,M,N,K,E,tiling);
          else ComputeAdaptive<TM,TN,false,false,false,true><<<cores,nullptr,stream>>>(
              x,weight,scale,group_list,y,scratch,M,N,K,E,tiling);
          return;
        }
      }
      if(N%32!=0 || (K>=128 && K%32!=0))
        Compute<TM,TN,false,true,false,true><<<cores,nullptr,stream>>>(
          x,weight,scale,group_list,y,scratch,M,N,K,E,tiling);
      else Compute<TM,TN,false,false,false,true><<<cores,nullptr,stream>>>(
          x,weight,scale,group_list,y,scratch,M,N,K,E,tiling);
      return;
    }
  }
  if constexpr(TM==64 && (TN==128 || TN==256 || TN==512) && !PADDED) {
    if(cores>1 && E>=2*cores && N<=512 && K<=512 && M>=TM*E && M<128*E){
      if(K<=tiling.baseK) {
        if(K%32!=0 || N%32!=0)
          ComputeAdaptive<TM,TN,false,true,true><<<cores,nullptr,stream>>>(
            x,weight,scale,group_list,y,scratch,M,N,K,E,tiling);
        else ComputeAdaptive<TM,TN,false,false,true><<<cores,nullptr,stream>>>(
            x,weight,scale,group_list,y,scratch,M,N,K,E,tiling);
      } else {
        if(K%32!=0 || N%32!=0)
          ComputeAdaptive<TM,TN,false,true><<<cores,nullptr,stream>>>(
            x,weight,scale,group_list,y,scratch,M,N,K,E,tiling);
        else ComputeAdaptive<TM,TN,false,false><<<cores,nullptr,stream>>>(
            x,weight,scale,group_list,y,scratch,M,N,K,E,tiling);
      }
      return;
    }
  }
  if constexpr (PADDED) {
    Compute<TM,TN,PADDED,true><<<cores,nullptr,stream>>>(
      x,weight,scale,group_list,y,scratch,M,N,K,E,tiling);
  } else {
    if(K<=tiling.baseK) {
      if(N%32!=0 || (K>=128 && K%32!=0))
        Compute<TM,TN,false,true,true><<<cores,nullptr,stream>>>(
          x,weight,scale,group_list,y,scratch,M,N,K,E,tiling);
      else Compute<TM,TN,false,false,true><<<cores,nullptr,stream>>>(
          x,weight,scale,group_list,y,scratch,M,N,K,E,tiling);
      return;
    }
    if (N%32!=0 || (K>=128 && K%32!=0))
      Compute<TM,TN,PADDED,true><<<cores,nullptr,stream>>>(
        x,weight,scale,group_list,y,scratch,M,N,K,E,tiling);
    else
      Compute<TM,TN,PADDED,false><<<cores,nullptr,stream>>>(
        x,weight,scale,group_list,y,scratch,M,N,K,E,tiling);
  }
}
template<int TM, int TN>
void Launch(GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR group_list,
  GM_ADDR y, int M, int N, int K, int E, int cores, aclrtStream stream)
{
  const int maxTiles = ((M + TM - 1) / TM + E - 1) * ((N + TN - 1) / TN);
  if (cores > maxTiles) cores = maxTiles;
  const int denseTiles = ((M + TM - 1) / TM) * ((N + TN - 1) / TN);
  if (K >= 1024 && N % 128 == 0 && cores > 16 && denseTiles > 16 &&
    (denseTiles + 15) / 16 == (denseTiles + cores - 1) / cores)
    cores = 16;
  if constexpr(TM==64 && TN==512){
    const int nc=(N+TN-1)/TN,tail=N%TN;
    if(cores>2 && cores%2==0 && nc==2 && tail>0 && tail*4<=3*TN
     && denseTiles>=2*cores)--cores;
  }
  const bool padded = M >= 256 * E && K >= 128 && N >= 128
    && K % 32 >= 16 && N % 32 >= 16;
  const int ka = K;
  const int nb = padded ? (N + 31) / 32 * 32 : N;
  matmul_tiling::MultiCoreMatmulTiling mt;
  mt.SetDim(1);
  mt.SetAType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
    matmul_tiling::DataType::DT_INT8, false);
  mt.SetBType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
    matmul_tiling::DataType::DT_INT8, false);
  mt.SetCType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
    matmul_tiling::DataType::DT_INT32);
  mt.SetShape(TM, TN, K);
  mt.SetOrgShape(M, nb, ka, K);
  mt.SetFixSplit(TM > 128 ? 128 : TM, TN, 128);
  mt.SetBufferSpace(512 * 1024, 128 * 1024, 0);
  TCubeTiling tiling;
  if (mt.GetTiling(tiling) != 0) return;
  if(K>=4096 && N>128 && (K%32!=0 || N%32!=0)) {
    tiling.stepKa=4;tiling.stepKb=4;
    tiling.depthA1=8;tiling.depthB1=8;
  } else if(K>=1024 && K%32==0 && N%128==0 && tiling.stepKa>4) {
    const int bytesA=8*tiling.baseM*tiling.baseK;
    const int bytesB=tiling.depthB1*tiling.baseN*tiling.baseK;
    if(bytesA+bytesB<=512*1024) {
      tiling.stepKa=4;tiling.depthA1=8;
    }
  }
  void* scratch = nullptr;
  const int64_t extra = (ka != K ? (int64_t)M * ka : 0)
    + (nb != N ? (int64_t)E * K * nb : 0);
  if (aclrtMalloc(&scratch, cores * 2 * (TM * TN + 128) * sizeof(int32_t) + extra + cores*64,
      ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) return;
  if constexpr (TM == 128 && TN == 256) {
    if (padded)
      Dispatch<TM,TN,true>(x,weight,scale,group_list,y,(GM_ADDR)scratch,
        M,N,K,E,cores,stream,tiling);
    else
      Dispatch<TM,TN,false>(x,weight,scale,group_list,y,(GM_ADDR)scratch,
        M,N,K,E,cores,stream,tiling);
  } else {
    Dispatch<TM,TN,false>(x,weight,scale,group_list,y,(GM_ADDR)scratch,
      M,N,K,E,cores,stream,tiling);
  }
  aclrtSynchronizeStream(stream);
  aclrtFree(scratch);
}
template<int TM, int TN, int SPLITS>
__global__ __mix__(1, 2) void ComputeSplitK(
  GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groups,
  GM_ADDR y, GM_ADDR workspace, int M, int N, int K, int E, TCubeTiling tiling)
{
  InitSocState();
  GlobalTensor<int8_t> ag,bg;
  GlobalTensor<int64_t> gg;
  GlobalTensor<int32_t> cg;
  GlobalTensor<float> sg;
  GlobalTensor<half> yg;
  ag.SetGlobalBuffer((__gm__ int8_t*)x);
  bg.SetGlobalBuffer((__gm__ int8_t*)weight);
  gg.SetGlobalBuffer((__gm__ int64_t*)groups);
  cg.SetGlobalBuffer((__gm__ int32_t*)workspace);
  sg.SetGlobalBuffer((__gm__ float*)scale);
  yg.SetGlobalBuffer((__gm__ half*)y);
  constexpr int VCOLS=TN/2;
  const int cn=(N+31)/32*32;
  const int nc=(N+TN-1)/TN;
  const int cores=GetBlockNum();
  const int chunk=(K+SPLITS*32-1)/(SPLITS*32)*32;
  if ASCEND_IS_AIC {
    TPipe pipe;
    matmul::MatmulImpl<AType,BType,CType,BiasType,MM_CONFIG,
      MatmulCallBackFunc<nullptr,PairA,SplitB>> mm;
    mm.SetSubBlockIdx(0);
    mm.Init(&tiling,&pipe);
    mm.SetOrgShape(M,cn,K,K,cn);
    const uint64_t meta=(uint64_t)K|((uint64_t)N<<14)
      |((uint64_t)(tiling.baseM/16)<<41)|((uint64_t)(tiling.baseN/32)<<45)
      |((uint64_t)(tiling.baseK/32)<<50);
    int start=0,base=0;
    const int eBegin=M==1?SingleRowExpert(gg,E):0;
    const int eLimit=M==1?eBegin+1:E;
    for(int e=eBegin;e<eLimit;++e){
      const int end=(int)gg.GetValue(e);
      const int tasks=((end-start+TM-1)/TM)*nc*SPLITS;
      const int first=(GetBlockIdx()-base%cores+cores)%cores;
      for(int task=first;task<tasks;task+=cores){
        const int split=task%SPLITS,tile=task/SPLITS;
        const int row=start+tile/nc*TM,col=tile%nc*TN;
        const int rows=end-row<TM?end-row:TM;
        const int cols=N-col<TN?N-col:TN;
        const int kb=split*chunk;
        const int kk=K-kb<chunk?K-kb:chunk;
        mm.SetSelfDefineData(meta|((uint64_t)kk<<27)
          |((uint64_t)(e==E-1 && kb+kk==K)<<55)|((uint64_t)(row+rows==M)<<62));
        mm.SetSingleShape(rows,(cols+31)/32*32,kk);
        mm.SetTensorA(ag[(int64_t)row*K+kb],false);
        mm.SetTensorB(bg[(int64_t)e*K*N+(int64_t)kb*N+col],false);
        mm.IterateAll(cg[((int64_t)split*M+row)*cn+col],false);
      }
      base+=tasks;start=end;
    }
    mm.End();
    PipeBarrier<PIPE_ALL>();
  }
  SyncAll<false>();
  if ASCEND_IS_AIV {
    const int core=GetBlockIdx()/2,sub=GetBlockIdx()%2;
    constexpr int VCOUNT=TM*VCOLS;
    TPipe pipe;
    TQue<TPosition::VECIN,1> cq,sq,rq;
    TQue<TPosition::VECOUT,1> oq;
    TBuf<TPosition::VECCALC> tb;
    pipe.InitBuffer(cq,1,VCOUNT*sizeof(int32_t));
    pipe.InitBuffer(rq,1,VCOUNT*sizeof(int32_t));
    pipe.InitBuffer(sq,1,VCOLS*sizeof(float));
    pipe.InitBuffer(oq,1,VCOUNT*sizeof(half));
    pipe.InitBuffer(tb,VCOUNT*sizeof(float));
    auto t=tb.Get<float>();
    int start=0,base=0;
    const int eBegin=M==1?SingleRowExpert(gg,E):0;
    const int eLimit=M==1?eBegin+1:E;
    for(int e=eBegin;e<eLimit;++e){
      const int end=(int)gg.GetValue(e);
      const int tasks=((end-start+TM-1)/TM)*nc;
      const int first=(core-base%cores+cores)%cores;
      for(int task=first;task<tasks;task+=cores){
        const int row=start+task/nc*TM,col=task%nc*TN+sub*VCOLS;
        const int rows=end-row<TM?end-row:TM;
        const int cols=N-col<VCOLS?N-col:VCOLS;
        if(cols<=0)continue;
        auto c=cq.AllocTensor<int32_t>();
        auto s=sq.AllocTensor<float>();
        const DataCopyExtParams cp{(uint16_t)rows,(uint32_t)(cols*4),
          (uint32_t)((cn-cols)*4),
          (uint32_t)((VCOLS-(cols+7)/8*8)/8),0};
        DataCopyPad(c,cg[(int64_t)row*cn+col],cp,
          DataCopyPadExtParams<int32_t>{true,0,0,0});
        cq.EnQue(c);c=cq.DeQue<int32_t>();
        for(int split=1;split<SPLITS;++split){
          auto r=rq.AllocTensor<int32_t>();
          DataCopyPad(r,cg[((int64_t)split*M+row)*cn+col],cp,
            DataCopyPadExtParams<int32_t>{true,0,0,0});
          rq.EnQue(r);r=rq.DeQue<int32_t>();
          Add(c,c,r,rows*VCOLS);
          PipeBarrier<PIPE_V>();
          rq.FreeTensor(r);
        }
        DataCopyPad(s,sg[(int64_t)e*N+col],
          DataCopyExtParams{1,(uint32_t)(cols*4),0,0,0},
          DataCopyPadExtParams<float>{true,0,0,0.0f});
        sq.EnQue(s);s=sq.DeQue<float>();
        auto z=c.ReinterpretCast<float>();
        Cast(z,c,RoundMode::CAST_RINT,rows*VCOLS);
        PipeBarrier<PIPE_V>();
        for(int c0=0;c0<VCOLS;c0+=64)
          Mul(z[c0],z[c0],s[c0],(uint64_t)64,(uint8_t)rows,
            BinaryRepeatParams{1,1,1,VCOLS/8,VCOLS/8,0});
        PipeBarrier<PIPE_V>();
        GeluBounded(z,t,rows*VCOLS);
        auto out=oq.AllocTensor<half>();
        Cast(out,z,RoundMode::CAST_RINT,rows*VCOLS);
        oq.EnQue(out);out=oq.DeQue<half>();
        DataCopyPad(yg[(int64_t)row*N+col],out,
          DataCopyExtParams{(uint16_t)rows,(uint32_t)(cols*2),
            (uint32_t)((VCOLS-(cols+15)/16*16)/16),
            (uint32_t)((N-cols)*2),0});
        oq.FreeTensor(out);sq.FreeTensor(s);cq.FreeTensor(c);
      }
      base+=tasks;start=end;
    }
  }
}
template<int TM,int TN,int SPLITS>
void LaunchSplitK(GM_ADDR x,GM_ADDR weight,GM_ADDR scale,GM_ADDR groups,
  GM_ADDR y,int M,int N,int K,int E,int cores,aclrtStream stream)
{
  const int cn=(N+31)/32*32;
  const int maxTiles=((M+TM-1)/TM+E-1)*((N+TN-1)/TN)*SPLITS;
  if(cores>maxTiles)cores=maxTiles;
  matmul_tiling::MultiCoreMatmulTiling mt;
  mt.SetDim(1);
  mt.SetAType(matmul_tiling::TPosition::GM,matmul_tiling::CubeFormat::ND,
    matmul_tiling::DataType::DT_INT8,false);
  mt.SetBType(matmul_tiling::TPosition::GM,matmul_tiling::CubeFormat::ND,
    matmul_tiling::DataType::DT_INT8,false);
  mt.SetCType(matmul_tiling::TPosition::GM,matmul_tiling::CubeFormat::ND,
    matmul_tiling::DataType::DT_INT32);
  mt.SetShape(TM,TN,(K+SPLITS*32-1)/(SPLITS*32)*32);
  mt.SetOrgShape(M,cn,K,K);
  mt.SetFixSplit(TM,TN,128);
  mt.SetBufferSpace(512*1024,128*1024,0);
  TCubeTiling tiling;
  if(mt.GetTiling(tiling)!=0)return;
  void* scratch=nullptr;
  if(aclrtMalloc(&scratch,(int64_t)SPLITS*M*cn*4,
    ACL_MEM_MALLOC_HUGE_FIRST)!=ACL_SUCCESS)return;
  ComputeSplitK<TM,TN,SPLITS><<<cores,nullptr,stream>>>(
    x,weight,scale,groups,y,(GM_ADDR)scratch,M,N,K,E,tiling);
  aclrtSynchronizeStream(stream);
  aclrtFree(scratch);
}
}
namespace Packed {
constexpr MatmulConfig MM_CONFIG =
  GetMDLConfig(false, false, 0, false, false, false, true, true, true, false, false, true);
constexpr MatmulConfig NORMAL_CONFIG = GetNormalConfig(false, false, false,
  BatchMode::NONE, true, IterateOrder::UNDEF, ScheduleType::INNER_PRODUCT,
  true, false, BatchOutMode::SINGLE_BATCH);
using AType = matmul::MatmulType<TPosition::GM, CubeFormat::ND, int8_t, false>;
using BType = matmul::MatmulType<TPosition::GM, CubeFormat::ND, int8_t, false>;
using CType = matmul::MatmulType<TPosition::GM, CubeFormat::ND, int32_t>;
using BiasType = matmul::MatmulType<TPosition::GM, CubeFormat::ND, int32_t>;
template<bool USE_NORMAL, typename CALLBACK> struct MatmulSelect;
template<typename CALLBACK> struct MatmulSelect<false, CALLBACK> {
  using Type = matmul::MatmulImpl<AType, BType, CType, BiasType, MM_CONFIG, CALLBACK>;
};
template<typename CALLBACK> struct MatmulSelect<true, CALLBACK> {
  using Type = matmul::MatmulImpl<AType, BType, CType, BiasType, NORMAL_CONFIG, CALLBACK>;
};
__aicore__ inline int SingleRowExpert(GlobalTensor<int64_t> groups,int E)
{
  if(E==1 || groups.GetValue(0)>0)return 0;
  int lo=1,hi=E-1;
  while(lo<hi){
    const int mid=(lo+hi)/2;
    if(groups.GetValue(mid)==0)lo=mid+1;else hi=mid;
  }
  return lo;
}
__aicore__ inline int SingleRowExpert(LocalTensor<int32_t> groups,int E)
{
  if(E==1 || groups.GetValue(0)>0)return 0;
  int lo=1,hi=E-1;
  while(lo<hi){
    const int mid=(lo+hi)/2;
    if(groups.GetValue(2*mid)==0)lo=mid+1;else hi=mid;
  }
  return lo;
}
__aicore__ inline void PadRows(GlobalTensor<int8_t> dst, GlobalTensor<int8_t> src,
  int64_t rows, int width, int padded)
{
  TPipe pipe;
  TBuf<TPosition::VECCALC> buffer;
  pipe.InitBuffer(buffer, 32768);
  auto data = buffer.Get<int8_t>();
  const int chunk = 32768 / padded;
  const int blocks = GetBlockNum() * 2;
  for (int64_t row = (int64_t)GetBlockIdx() * chunk; row < rows; row += (int64_t)blocks * chunk) {
    int count = rows - row < chunk ? rows - row : chunk;
    DataCopyPad(data, src[row * width],
      DataCopyExtParams{(uint16_t)count, (uint32_t)width, 0, 0, 0},
      DataCopyPadExtParams<int8_t>{true, 0, (uint8_t)(padded - width), 0});
    SetFlag<HardEvent::MTE2_MTE3>(EVENT_ID0);
    WaitFlag<HardEvent::MTE2_MTE3>(EVENT_ID0);
    DataCopy(dst[row * padded], data, count * padded);
    SetFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);
    WaitFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);
  }
}
__aicore__ inline void WordCopy(const LocalTensor<int8_t>& dst, const __gm__ int8_t* ptr,
  int height, int width, int stride, int paddedHeight, bool finalRow)
{
  const int count=height-((width%4 && finalRow)?1:0);
  const int groups=stride%4==0?1:(stride%2==0?2:4);
  auto d32=dst.ReinterpretCast<int32_t>();
  for (int g=0;g<groups && g<count;++g) {
    GlobalTensor<int32_t> src;
    src.SetGlobalBuffer((__gm__ int32_t*)(ptr+(int64_t)g*stride));
    DataCopy(d32[g*8],src,Nd2NzParams{1,(uint16_t)((count-g+groups-1)/groups),
      (uint16_t)((width+3)/4),0,(uint16_t)(stride*groups/4),
      (uint16_t)paddedHeight,(uint16_t)groups,0});
  }
  if (count<height) {
    GlobalTensor<int8_t> src;
    src.SetGlobalBuffer((__gm__ int8_t*)(ptr+(int64_t)(height-1)*stride));
    DataCopy(dst[(height-1)*32],src,Nd2NzParams{1,1,(uint16_t)width,0,
      (uint16_t)stride,(uint16_t)paddedHeight,1,0});
  }
}
__aicore__ inline void PairCopy(const LocalTensor<int8_t>& dst, const __gm__ int8_t* ptr,
  int height, int width, int stride, int paddedHeight, bool allowOdd, bool finalRow, bool preferWord)
{
  if (allowOdd && stride >= 4 && (stride <= 64 || preferWord)) {
    WordCopy(dst,ptr,height,width,stride,paddedHeight,finalRow);
    return;
  }
  GlobalTensor<int8_t> src;
  src.SetGlobalBuffer((__gm__ int8_t*)ptr);
  if ((width & 1) && !allowOdd) {
    DataCopy(dst,src,Nd2NzParams{1,(uint16_t)height,(uint16_t)width,0,
      (uint16_t)stride,(uint16_t)paddedHeight,1,0});
    return;
  }
  const int count=height-(((width&1)&&finalRow)?1:0);
  const int pairs=(width+1)/2;
  if (count>0) {
    auto d16=dst.ReinterpretCast<int16_t>();
    GlobalTensor<int16_t> s16;
    s16.SetGlobalBuffer((__gm__ int16_t*)ptr);
    if (stride % 2 == 0) {
      DataCopy(d16,s16,Nd2NzParams{1,(uint16_t)count,(uint16_t)pairs,0,
        (uint16_t)(stride/2),(uint16_t)paddedHeight,1,0});
    } else {
      DataCopy(d16,s16,Nd2NzParams{1,(uint16_t)((count+1)/2),(uint16_t)pairs,0,
        (uint16_t)stride,(uint16_t)paddedHeight,2,0});
      if (count>1) {
        s16.SetGlobalBuffer((__gm__ int16_t*)(ptr+stride));
        DataCopy(d16[16],s16,Nd2NzParams{1,(uint16_t)(count/2),(uint16_t)pairs,0,
          (uint16_t)stride,(uint16_t)paddedHeight,2,0});
      }
    }
  }
  if (count<height) {
    DataCopy(dst[(height-1)*32],src[(int64_t)(height-1)*stride],
      Nd2NzParams{1,1,(uint16_t)width,0,(uint16_t)stride,(uint16_t)paddedHeight,1,0});
  }
}
__aicore__ inline void PairA(const LocalTensor<int8_t>& dst, const __gm__ void* gm,
  int row, int col, int useM, int useK, uint64_t unused, uint64_t meta)
{
  int stride=meta&0x3fff;
  int bm=((meta>>41)&15)*16;
  int bk=((meta>>50)&31)*32;
  auto ptr=(const __gm__ int8_t*)gm+(int64_t)row*bm*stride+col*bk;
  const bool odd=(useK&1)!=0;
  PairCopy(dst,ptr,useM,useK,stride,(useM+15)/16*16,
    odd,odd && ((meta>>62)&1),false);
}
__aicore__ inline void PairB(const LocalTensor<int8_t>& dst, const __gm__ void* gm,
  int row, int col, int useK, int useN, uint64_t unused, uint64_t meta)
{
  int stride=(meta>>14)&0x1fff;
  int k=(meta>>27)&0x3fff;
  int bn=((meta>>45)&31)*32;
  int bk=((meta>>50)&31)*32;
  bool finalRow=((meta>>55)&1) && row*bk+useK==k;
  auto ptr=(const __gm__ int8_t*)gm+(int64_t)row*bk*stride+col*bn;
  const int paddedK=(useK+31)/32*32;
  PairCopy(dst,ptr,useK,useN,stride,paddedK,true,finalRow,(meta>>56)&1);
  if((useK&1) && useN>0){
    InitConstValue(dst.ReinterpretCast<int32_t>()[useK*8],
      InitConstValueParams<int32_t>{(uint16_t)((useN+31)/32),
        (uint16_t)(paddedK-useK),(uint16_t)useK,0});
  }
}
__aicore__ inline void AdaptiveB(const LocalTensor<int8_t>& dst,const __gm__ void* gm,
  int row,int col,int useK,int useN,uint64_t unused,uint64_t meta)
{
  const int stride=(meta>>14)&0x1fff;
  const int bn=((meta>>45)&31)*32;
  const int outer=(int)((meta>>57)&31)*128;
  const int valid=stride-outer-col*bn;
  PairB(dst,gm,row,col,useK,useN<valid?useN:valid,unused,meta);
}
template<bool ENABLED> struct TransportCallback;
template<> struct TransportCallback<true> {
  using Type=MatmulCallBackFunc<nullptr,PairA,AdaptiveB>;
};
template<> struct TransportCallback<false> {
  using Type=MatmulCallBackFunc<nullptr,nullptr,nullptr>;
};
template<int TM, int TN>
class DirectSingleMatmul {
  static constexpr int CK = 65536 / (TM > TN ? TM : TN);
  static_assert(TM * TN * sizeof(int32_t) <= 128 * 1024);
  TBuf<TPosition::A1> ab;
  TBuf<TPosition::B1> bb;
  TBuf<TPosition::A2> a0;
  TBuf<TPosition::B2> b0;
  TBuf<TPosition::CO1> cb;
  GlobalTensor<int8_t> a, b;
  uint64_t meta = 0;
  int rows, cols, depth;
  bool previous = false;
  const __gm__ int8_t* cached_b = nullptr;
  uint64_t cached_b_meta = 0;
  int cached_b_cols = 0, cached_b_depth = 0;
  TPipe* pipe_;
  TEventID event_MTE1_MTE2;
  TEventID event_MTE2_MTE1;
  TEventID event_M_MTE1;
  TEventID event_MTE1_M;
  TEventID event_FIX_M;
  TEventID event_M_FIX;
public:
  __aicore__ inline void SetSubBlockIdx(int) {}
  __aicore__ inline void Init(TCubeTiling*, TPipe* pipe) {
    pipe->InitBuffer(ab, TM * CK);
    pipe->InitBuffer(bb, CK * TN);
    pipe->InitBuffer(a0, TM * CK);
    pipe->InitBuffer(b0, CK * TN);
    pipe->InitBuffer(cb, TM * TN * sizeof(int32_t));
    pipe_ = pipe;
    event_MTE1_MTE2 = pipe->AllocEventID<HardEvent::MTE1_MTE2>();
    event_MTE2_MTE1 = pipe->AllocEventID<HardEvent::MTE2_MTE1>();
    event_M_MTE1 = pipe->AllocEventID<HardEvent::M_MTE1>();
    event_MTE1_M = pipe->AllocEventID<HardEvent::MTE1_M>();
    event_FIX_M = pipe->AllocEventID<HardEvent::FIX_M>();
    event_M_FIX = pipe->AllocEventID<HardEvent::M_FIX>();
  }
  __aicore__ inline void SetOrgShape(int, int, int, int, int) {}
  __aicore__ inline void SetSingleShape(int m, int n, int k) {
    rows = m; cols = n; depth = k;
  }
  __aicore__ inline void SetSelfDefineData(uint64_t value) { meta = value; }
  __aicore__ inline void SetTensorA(GlobalTensor<int8_t> value, bool) { a = value; }
  __aicore__ inline void SetTensorB(GlobalTensor<int8_t> value, bool) { b = value; }
  __aicore__ inline void End() {
    PipeBarrier<PIPE_ALL>();
    pipe_->ReleaseEventID<HardEvent::MTE1_MTE2>(event_MTE1_MTE2);
    pipe_->ReleaseEventID<HardEvent::MTE2_MTE1>(event_MTE2_MTE1);
    pipe_->ReleaseEventID<HardEvent::M_MTE1>(event_M_MTE1);
    pipe_->ReleaseEventID<HardEvent::MTE1_M>(event_MTE1_M);
    pipe_->ReleaseEventID<HardEvent::FIX_M>(event_FIX_M);
    pipe_->ReleaseEventID<HardEvent::M_FIX>(event_M_FIX);
  }
  __aicore__ inline void IterateAll(GlobalTensor<int32_t> c, bool) {
    auto al = ab.Get<int8_t>(), bl = bb.Get<int8_t>();
    auto ac = a0.Get<int8_t>(), bc = b0.Get<int8_t>();
    auto cc = cb.Get<int32_t>();
    const int mr = (rows + 15) / 16 * 16;
    const int nr = (cols + 31) / 32 * 32;
    const int kr = (depth + 31) / 32 * 32;
    const auto bptr = b.GetPhyAddr();
    const uint64_t bmeta = meta & ~(uint64_t(1) << 62);
    const bool reuseB = previous && bptr == cached_b && bmeta == cached_b_meta
      && cols == cached_b_cols && depth == cached_b_depth;
    if (previous) {
      SetFlag<HardEvent::MTE1_MTE2>(static_cast<event_t>(event_MTE1_MTE2));
      WaitFlag<HardEvent::MTE1_MTE2>(static_cast<event_t>(event_MTE1_MTE2));
    }
    PairA(al, a.GetPhyAddr(), 0, 0, rows, depth, 0, meta);
    if (!reuseB) {
      AdaptiveB(bl, bptr, 0, 0, depth, cols, 0, meta);
      if (kr != depth && (depth & 1) == 0) {
        const int stride = (meta >> 14) & 0x1fff;
        const int outer = (int)((meta >> 57) & 31) * 128;
        const int valid = stride - outer < cols ? stride - outer : cols;
        InitConstValue(bl.ReinterpretCast<int32_t>()[depth * 8],
          InitConstValueParams<int32_t>{(uint16_t)((valid + 31) / 32),
            (uint16_t)(kr - depth), (uint16_t)depth, 0});
      }
    }
    SetFlag<HardEvent::MTE2_MTE1>(static_cast<event_t>(event_MTE2_MTE1));
    WaitFlag<HardEvent::MTE2_MTE1>(static_cast<event_t>(event_MTE2_MTE1));
    if (previous) {
      SetFlag<HardEvent::M_MTE1>(static_cast<event_t>(event_M_MTE1));
      WaitFlag<HardEvent::M_MTE1>(static_cast<event_t>(event_M_MTE1));
    }
    const uint8_t pad[4] = {0, 0, 0, 0};
    SetFmatrix(1, mr, pad, FmatrixMode::FMATRIX_LEFT);
    LoadData3DParamsV2Pro la;
    la.channelSize = kr;
    la.extConfig = ((uint64_t)mr << 16) | kr;
    LoadData(ac, al, la);
    if (!reuseB) {
      LoadData2dTransposeParams lb{0, (uint8_t)(nr / 32), (uint16_t)(kr / 32), 1, 0};
      for (int ki = 0; ki < kr; ki += 32)
        LoadDataWithTranspose(bc[ki * nr], bl[ki * 32], lb);
    }
    SetFlag<HardEvent::MTE1_M>(static_cast<event_t>(event_MTE1_M));
    WaitFlag<HardEvent::MTE1_M>(static_cast<event_t>(event_MTE1_M));
    if (previous) {
      SetFlag<HardEvent::FIX_M>(static_cast<event_t>(event_FIX_M));
      WaitFlag<HardEvent::FIX_M>(static_cast<event_t>(event_FIX_M));
    }
    MmadParams mp;
    mp.m = mr; mp.n = nr; mp.k = kr; mp.cmatrixInitVal = true;
    Mmad(cc, ac, bc, mp);
    SetFlag<HardEvent::M_FIX>(static_cast<event_t>(event_M_FIX));
    WaitFlag<HardEvent::M_FIX>(static_cast<event_t>(event_M_FIX));
    FixpipeParamsV220 fp;
    fp.nSize = cols; fp.mSize = rows; fp.srcStride = mr; fp.dstStride = TN;
    Fixpipe(c, cc, fp);
    cached_b = bptr; cached_b_meta = bmeta;
    cached_b_cols = cols; cached_b_depth = depth;
    previous = true;
  }
};
template<int TM, int TN, bool NORMAL, bool DIRECT, typename CALLBACK>
struct CubeSelect {
  using Type = typename MatmulSelect<NORMAL, CALLBACK>::Type;
};
template<int TM, int TN, bool NORMAL, typename CALLBACK>
struct CubeSelect<TM, TN, NORMAL, true, CALLBACK> {
  using Type = DirectSingleMatmul<TM, TN>;
};
__aicore__ inline int AdvanceTaskBase(int base,int count,int cores)
{
  const int sum=base+count;
  if(sum<cores)return sum;
  return count<cores?sum-cores:sum%cores;
}
__aicore__ inline void TileCoordinates(int task,int nc,int& mr,int& nr)
{
  if(nc==1){mr=task;nr=0;}
  else if(nc==2){mr=task>>1;nr=task&1;}
  else {mr=task/nc;nr=task-mr*nc;}
}
__aicore__ inline void GeluBounded(LocalTensor<float> z,LocalTensor<float> t,int count)
{
  const BinaryRepeatParams binary{1,1,1,8,8,8};
  const UnaryRepeatParams unary{1,1,8,8};
  for(int offset=0;offset<count;){
    const int remaining=count-offset;
    const int full=remaining/64;
    const uint8_t repeats=(uint8_t)(full>255?255:(full>0?full:1));
    const uint64_t mask=full>0?64:(uint64_t)remaining;
    auto a=z[offset];auto b=t[offset];
    Mul(b,a,a,mask,repeats,binary);PipeBarrier<PIPE_V>();
    Muls(b,b,-0.07135481627260025f,mask,repeats,unary);PipeBarrier<PIPE_V>();
    Adds(b,b,-1.5957691216057308f,mask,repeats,unary);PipeBarrier<PIPE_V>();
    Mul(b,b,a,mask,repeats,binary);PipeBarrier<PIPE_V>();
    Maxs(b,b,-87.0f,mask,repeats,unary);PipeBarrier<PIPE_V>();
    Mins(b,b,87.0f,mask,repeats,unary);PipeBarrier<PIPE_V>();
    Exp(b,b,mask,repeats,unary);PipeBarrier<PIPE_V>();
    Adds(b,b,1.0f,mask,repeats,unary);PipeBarrier<PIPE_V>();
    Div(a,a,b,mask,repeats,binary);PipeBarrier<PIPE_V>();
    offset+=full>0?(int)repeats*64:(int)mask;
  }
}
template<int TM, int TN, bool PADDED, bool TRANSPORT, bool USE_NORMAL = false, bool USE_DIRECT = false>
__global__ __mix__(1, 2) void Compute(
  GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groups,
  GM_ADDR y, GM_ADDR workspace, int M, int N, int K, int E, TCubeTiling tiling)
{
  InitSocState();
  GlobalTensor<int8_t> ag, bg;
  GlobalTensor<int64_t> gg;
  GlobalTensor<int32_t> cg;
  GlobalTensor<float> sg;
  GlobalTensor<half> yg;
  ag.SetGlobalBuffer((__gm__ int8_t*)x);
  bg.SetGlobalBuffer((__gm__ int8_t*)weight);
  gg.SetGlobalBuffer((__gm__ int64_t*)groups);
  cg.SetGlobalBuffer((__gm__ int32_t*)workspace);
  sg.SetGlobalBuffer((__gm__ float*)scale);
  yg.SetGlobalBuffer((__gm__ half*)y);
  const int ka = PADDED ? (K + 31) / 32 * 32 : K;
  const int nb = PADDED ? (N + 31) / 32 * 32 : N;
  if constexpr (PADDED) {
    auto base = workspace + (int64_t)GetBlockNum() * 2 * TM * TN * sizeof(int32_t);
    GlobalTensor<int8_t> ap, bp;
    ap.SetGlobalBuffer((__gm__ int8_t*)base);
    bp.SetGlobalBuffer((__gm__ int8_t*)(base + (ka != K ? (int64_t)M * ka : 0)));
    if ASCEND_IS_AIV {
      if (ka != K) PadRows(ap, ag, M, K, ka);
      if (nb != N) PadRows(bp, bg, (int64_t)E * K, N, nb);
    }
    SyncAll<false>();
    if (ka != K) ag = ap;
    if (nb != N) bg = bp;
  }
  const int nc = (N + TN - 1) / TN;
  const int cores = GetBlockNum();
  const bool shardExperts = M!=1 && E >= 2 * cores && N <= 512 && K <= 512;
  if ASCEND_IS_AIC {
    TPipe pipe;
    typename CubeSelect<TM,TN,USE_NORMAL,USE_DIRECT,typename TransportCallback<TRANSPORT>::Type>::Type mm;
    mm.SetSubBlockIdx(0);
    mm.Init(&tiling, &pipe);
    mm.SetOrgShape(M, TRANSPORT ? (N+31)/32*32 : nb, ka, K, TN);
    uint64_t meta=0;
    if constexpr (TRANSPORT || USE_DIRECT)
      meta=(uint64_t)ka|((uint64_t)nb<<14)|((uint64_t)K<<27)
        |((uint64_t)(tiling.baseM/16)<<41)|((uint64_t)(tiling.baseN/32)<<45)
        |((uint64_t)(tiling.baseK/32)<<50)|((uint64_t)PADDED<<56);
    int taskBase = 0;
    int start = 0;
    int produced = 0;
    const int eFirst = M==1 ? SingleRowExpert(gg,E) : (shardExperts ? GetBlockIdx() : 0);
    const int eStep = M==1 ? E : (shardExperts ? cores : 1);
    for (int e = eFirst; e < E; e += eStep) {
      if (shardExperts) start = e == 0 ? 0 : (int)gg.GetValue(e - 1);
      int end = (int)gg.GetValue(e);
      int tiles = ((end - start + TM - 1) / TM) * nc;
      if(tiles==0){start=end;continue;}
      int first = shardExperts ? 0 : GetBlockIdx()-taskBase;
      if(first<0)first+=cores;
      const int taskStep = shardExperts ? 1 : cores;
      for (int task = first; task < tiles; task += taskStep) {
        const int slot = produced & 1;
        if (produced >= 2) CrossCoreWaitFlag<2>(1 + 2 * slot);
        int mr,nr;TileCoordinates(task,nc,mr,nr);
        int row = start + mr * TM;
        int col = nr * TN;
        int rows = end - row < TM ? end - row : TM;
        int cols = N - col < TN ? N - col : TN;
        if constexpr (TRANSPORT || USE_DIRECT) {
          mm.SetSelfDefineData(meta|((uint64_t)(e==E-1 && nb==N)<<55)
            |((uint64_t)(col/128)<<57)|((uint64_t)(row+rows==M)<<62));
        }
        mm.SetSingleShape(rows, TRANSPORT ? (cols+31)/32*32 : cols, K);
        mm.SetTensorA(ag[(int64_t)row * ka], false);
        mm.SetTensorB(bg[(int64_t)e * K * nb + col], false);
        mm.IterateAll(cg[((int64_t)GetBlockIdx() * 2 + slot) * TM * TN], false);
        CrossCoreSetFlag<2, PIPE_FIX>(2 * slot);
        ++produced;
      }
      if(!shardExperts)taskBase=AdvanceTaskBase(taskBase,tiles,cores);
      start = end;
    }
    if (produced > 1) CrossCoreWaitFlag<2>(1 + 2 * ((produced - 2) & 1));
    if (produced > 0) CrossCoreWaitFlag<2>(1 + 2 * ((produced - 1) & 1));
    mm.End();
  }
  if ASCEND_IS_AIV {
    const int core = GetBlockIdx() / 2;
    const int sub = GetBlockIdx() % 2;
    constexpr int VCOLS = TN / 2;
    constexpr int VCOUNT = TM * VCOLS;
    TPipe pipe;
    TQue<TPosition::VECIN, 1> cq, sq;
    TQue<TPosition::VECOUT, 1> oq;
    TBuf<TPosition::VECCALC> tb;
    pipe.InitBuffer(cq, 1, VCOUNT * sizeof(int32_t));
    pipe.InitBuffer(sq, 1, VCOLS * sizeof(float));
    pipe.InitBuffer(oq, 1, VCOUNT * sizeof(half));
    pipe.InitBuffer(tb, VCOUNT * sizeof(float));
    auto t = tb.Get<float>();
    int consumed = 0;
    int taskBase = 0;
    int start = 0;
    const int eFirst = M==1 ? SingleRowExpert(gg,E) : (shardExperts ? core : 0);
    const int eStep = M==1 ? E : (shardExperts ? cores : 1);
    for (int e = eFirst; e < E; e += eStep) {
      if (shardExperts) start = e == 0 ? 0 : (int)gg.GetValue(e - 1);
      int end = (int)gg.GetValue(e);
      int tiles = ((end - start + TM - 1) / TM) * nc;
      if(tiles==0){start=end;continue;}
      int first = shardExperts ? 0 : core-taskBase;
      if(first<0)first+=cores;
      const int taskStep = shardExperts ? 1 : cores;
      for (int task = first; task < tiles; task += taskStep) {
        int mr,nr;TileCoordinates(task,nc,mr,nr);
        int row = start + mr * TM;
        int col = nr * TN + sub * VCOLS;
        int rows = end - row < TM ? end - row : TM;
        int cols = N - col < VCOLS ? N - col : VCOLS;
        const int slot = consumed & 1;
        CrossCoreWaitFlag<2>(2 * slot);
        if (rows > 0 && cols > 0) {
          auto c = cq.AllocTensor<int32_t>();
          auto s = sq.AllocTensor<float>();
          DataCopyPad(c, cg[((int64_t)core * 2 + slot) * TM * TN + sub * VCOLS],
            DataCopyExtParams{(uint16_t)rows, (uint32_t)(cols * 4),
              (uint32_t)((TN - cols) * 4), (uint32_t)((VCOLS - (cols + 7) / 8 * 8) / 8), 0},
            DataCopyPadExtParams<int32_t>{true, 0, 0, 0});
          DataCopyPad(s, sg[(int64_t)e * N + col],
            DataCopyExtParams{1, (uint32_t)(cols * 4), 0, 0, 0},
            DataCopyPadExtParams<float>{true, 0, 0, 0.0f});
          cq.EnQue(c);
          sq.EnQue(s);
          c = cq.DeQue<int32_t>();
          s = sq.DeQue<float>();
          CrossCoreSetFlag<2, PIPE_MTE2>(1 + 2 * slot);
          auto z = c.ReinterpretCast<float>();
          Cast(z, c, RoundMode::CAST_RINT, rows * VCOLS);
          PipeBarrier<PIPE_V>();
          if constexpr (TM > 255) {
            for(int r0=0;r0<rows;r0+=255){
              const uint8_t repeats=(uint8_t)(rows-r0<255?rows-r0:255);
              for(int c0=0;c0<VCOLS;c0+=64)
                Mul(z[r0*VCOLS+c0],z[r0*VCOLS+c0],s[c0],(uint64_t)64,repeats,
                  BinaryRepeatParams{1,1,1,VCOLS/8,VCOLS/8,0});
            }
          } else {
            for (int c0 = 0; c0 < VCOLS; c0 += 64)
              Mul(z[c0], z[c0], s[c0], (uint64_t)64, (uint8_t)rows,
                BinaryRepeatParams{1, 1, 1, VCOLS / 8, VCOLS / 8, 0});
          }
          PipeBarrier<PIPE_V>();
          GeluBounded(z,t,rows*VCOLS);
          auto out = oq.AllocTensor<half>();
          Cast(out, z, RoundMode::CAST_RINT, rows * VCOLS);
          oq.EnQue(out);
          out = oq.DeQue<half>();
          DataCopyPad(yg[(int64_t)row * N + col], out,
            DataCopyExtParams{(uint16_t)rows, (uint32_t)(cols * 2),
              (uint32_t)((VCOLS - (cols + 15) / 16 * 16) / 16),
              (uint32_t)((N - cols) * 2), 0});
          oq.FreeTensor(out);
          sq.FreeTensor(s);
          cq.FreeTensor(c);
        } else {
          CrossCoreSetFlag<2, PIPE_MTE2>(1 + 2 * slot);
        }
        ++consumed;
      }
      if(!shardExperts)taskBase=AdvanceTaskBase(taskBase,tiles,cores);
      start = end;
    }
  }
}
__aicore__ inline int FindExpert(GlobalTensor<int64_t> gg,int row,int M,int E,int& end)
{
  const int guess=row*E/M;
  end=(int)gg.GetValue(guess);
  const int start=guess==0?0:(int)gg.GetValue(guess-1);
  if(start<=row && row<end)return guess;
  int lo=row>=end?guess+1:0;
  int hi=row>=end?E-1:guess-1;
  while(lo<hi){
    const int mid=(lo+hi)/2;
    if(row<(int)gg.GetValue(mid))hi=mid;
    else lo=mid+1;
  }
  end=(int)gg.GetValue(lo);
  return lo;
}
template<bool ENABLED>struct AdaptiveCallback;
template<>struct AdaptiveCallback<true>{using Type=MatmulCallBackFunc<nullptr,PairA,AdaptiveB>;};
template<>struct AdaptiveCallback<false>{using Type=MatmulCallBackFunc<nullptr,nullptr,nullptr>;};
__aicore__ inline bool NeedsSchedulePlan(GlobalTensor<int64_t> gg,int M,int N,int K,int E,int cores)
{
  const int first=(int)gg.GetValue(0);
  const int last=M-(int)gg.GetValue(E-2);
  const int largest=first>last?first:last;
  return (first==0 && last==0) || largest*cores>2*M
    || (first+last)*E*4<M
    || ((first==0 || last==0) && (K*N>=65536 || K%32 || N%32));
}
template<int TM,int TN>
__aicore__ inline int ChooseSchedule(GM_ADDR groups,GlobalTensor<int32_t> record,
  int M,int N,int E,int cores)
{
  TPipe pipe;
  TBuf<TPosition::VECCALC> gb,hb,ob;
  pipe.InitBuffer(gb,128*8);
  pipe.InitBuffer(hb,64*4);
  pipe.InitBuffer(ob,32);
  auto g=gb.Get<int32_t>();
  auto h=hb.Get<int32_t>();
  auto out=ob.Get<int32_t>();
  GlobalTensor<int32_t> gg;
  gg.SetGlobalBuffer((__gm__ int32_t*)groups);
  DataCopyPad(g,gg,DataCopyExtParams{1,(uint32_t)(E*8),0,0,0},
    DataCopyPadExtParams<int32_t>{true,0,0,0});
  SetFlag<HardEvent::MTE2_S>(EVENT_ID0);
  WaitFlag<HardEvent::MTE2_S>(EVENT_ID0);
  const int nc=(N+TN-1)/TN;
  const int stripes=(M+TM-1)/TM*nc;
  for(int c=0;c<cores;++c){
    h.SetValue(c,0);
    h.SetValue(32+c,(stripes+cores-1-c)/cores);
  }
  int start=0,total=0,owner=0;
  for(int e=0;e<E;++e){
    const int end=g.GetValue(2*e);
    const int tasks=(end-start+TM-1)/TM*nc;
    h.SetValue(owner,h.GetValue(owner)+tasks);
    if(++owner==cores)owner=0;
    total+=tasks;
    if(end>start && start>0 && start%TM){
      const int tile=start/TM*nc;
      for(int col=0;col<nc;++col){
        const int c=(tile+col)%cores;
        h.SetValue(32+c,h.GetValue(32+c)+1);
      }
    }
    start=end;
  }
  int maxExpert=0,maxStripe=0;
  for(int c=0;c<cores;++c){
    const int a=h.GetValue(c),b=h.GetValue(32+c);
    if(a>maxExpert)maxExpert=a;
    if(b>maxStripe)maxStripe=b;
  }
  int mode=maxStripe<maxExpert?1:0;
  const int best=mode?maxStripe:maxExpert;
  const int ideal=(total+cores-1)/cores;
  if(best>ideal+(E+15)/16)mode=2;
  for(int i=0;i<8;++i)out.SetValue(i,mode);
  SetFlag<HardEvent::S_MTE3>(EVENT_ID0);
  WaitFlag<HardEvent::S_MTE3>(EVENT_ID0);
  DataCopy(record,out,8);
  CrossCoreSetFlag<2,PIPE_MTE3>(4);
  SetFlag<HardEvent::MTE3_S>(EVENT_ID0);
  WaitFlag<HardEvent::MTE3_S>(EVENT_ID0);
  return mode;
}
struct ScheduledTile {int expert,row,col,rows,cols;};
template<int TM,int TN>
class TaskSchedule {
  GlobalTensor<int64_t> gg_;
  int M_,N_,E_,cores_,core_,mode_,nc_;
  int e_,start_,end_,tiles_,next_,base_;
  int stripe_,stripeCount_,row_,limit_;
  __aicore__ inline void LoadExpert()
  {
    if(mode_==0)start_=e_==0?0:(int)gg_.GetValue(e_-1);
    end_=(int)gg_.GetValue(e_);
    tiles_=(end_-start_+TM-1)/TM*nc_;
    next_=mode_==0?0:core_-base_;
    if(next_<0)next_+=cores_;
  }
  __aicore__ inline void LoadStripe()
  {
    int mr,nr;TileCoordinates(stripe_,nc_,mr,nr);
    row_=mr*TM;
    limit_=row_+TM<M_?row_+TM:M_;
  }
public:
  __aicore__ inline TaskSchedule(GlobalTensor<int64_t> gg,int M,int N,int E,
    int cores,int core,int mode):gg_(gg),M_(M),N_(N),E_(E),cores_(cores),
    core_(core),mode_(mode),nc_((N+TN-1)/TN),e_(mode==0?core:0),
    start_(0),end_(0),tiles_(0),next_(0),base_(0),stripe_(core),
    stripeCount_((M+TM-1)/TM*nc_),row_(0),limit_(0)
  {
    if(mode_==1)LoadStripe();
    else if(e_<E_)LoadExpert();
  }
  __aicore__ inline bool Next(ScheduledTile& t)
  {
    if(mode_==1){
      if(row_>=limit_){stripe_+=cores_;LoadStripe();}
      if(stripe_>=stripeCount_)return false;
      int end;
      t.expert=FindExpert(gg_,row_,M_,E_,end);
      int mr,nr;TileCoordinates(stripe_,nc_,mr,nr);
      t.row=row_;t.col=nr*TN;
      t.rows=(end<limit_?end:limit_)-row_;
      t.cols=N_-t.col<TN?N_-t.col:TN;
      row_+=t.rows;
      return true;
    }
    while(e_<E_){
      if(next_<tiles_){
        int mr,nr;TileCoordinates(next_,nc_,mr,nr);
        t.expert=e_;t.row=start_+mr*TM;t.col=nr*TN;
        t.rows=end_-t.row<TM?end_-t.row:TM;
        t.cols=N_-t.col<TN?N_-t.col:TN;
        next_+=mode_==0?1:cores_;
        return true;
      }
      if(mode_!=0)base_=AdvanceTaskBase(base_,tiles_,cores_);
      start_=end_;e_+=mode_==0?cores_:1;
      if(e_<E_)LoadExpert();
    }
    return false;
  }
};
template<int TM, int TN, bool PADDED, bool TRANSPORT, bool USE_NORMAL = false, bool USE_DIRECT = false>
__global__ __mix__(1, 2) void ComputeAdaptive(
  GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groups,
  GM_ADDR y, GM_ADDR workspace, int M, int N, int K, int E, TCubeTiling tiling)
{
  InitSocState();
  GlobalTensor<int8_t> ag, bg;
  GlobalTensor<int64_t> gg;
  GlobalTensor<int32_t> cg;
  GlobalTensor<float> sg;
  GlobalTensor<half> yg;
  ag.SetGlobalBuffer((__gm__ int8_t*)x);
  bg.SetGlobalBuffer((__gm__ int8_t*)weight);
  gg.SetGlobalBuffer((__gm__ int64_t*)groups);
  cg.SetGlobalBuffer((__gm__ int32_t*)workspace);
  sg.SetGlobalBuffer((__gm__ float*)scale);
  yg.SetGlobalBuffer((__gm__ half*)y);
  const int ka = PADDED ? (K + 31) / 32 * 32 : K;
  const int nb = PADDED ? (N + 31) / 32 * 32 : N;
  if constexpr (PADDED) {
    auto base = workspace + (int64_t)GetBlockNum() * 2 * TM * TN * sizeof(int32_t);
    GlobalTensor<int8_t> ap, bp;
    ap.SetGlobalBuffer((__gm__ int8_t*)base);
    bp.SetGlobalBuffer((__gm__ int8_t*)(base + (ka != K ? (int64_t)M * ka : 0)));
    if ASCEND_IS_AIV {
      if (ka != K) PadRows(ap, ag, M, K, ka);
      if (nb != N) PadRows(bp, bg, (int64_t)E * K, N, nb);
    }
    SyncAll<false>();
    if (ka != K) ag = ap;
    if (nb != N) bg = bp;
  }
  const int nc = (N + TN - 1) / TN;
  const int cores = GetBlockNum();
  GlobalTensor<int32_t> rg;
  rg.SetGlobalBuffer((__gm__ int32_t*)(workspace
    +(int64_t)cores*2*TM*TN*sizeof(int32_t)));
  const bool plan=NeedsSchedulePlan(gg,M,N,K,E,cores);
  if ASCEND_IS_AIC {
    TPipe pipe;
    typename CubeSelect<TM,TN,USE_NORMAL,USE_DIRECT,typename AdaptiveCallback<TRANSPORT>::Type>::Type mm;
    mm.SetSubBlockIdx(0);
    mm.Init(&tiling, &pipe);
    mm.SetOrgShape(M, TRANSPORT?(N+31)/32*32:nb, ka, K, TN);
    uint64_t meta=0;
    if constexpr (TRANSPORT || USE_DIRECT)
      meta=(uint64_t)ka|((uint64_t)nb<<14)|((uint64_t)K<<27)
        |((uint64_t)(tiling.baseM/16)<<41)|((uint64_t)(tiling.baseN/32)<<45)
        |((uint64_t)(tiling.baseK/32)<<50)|((uint64_t)PADDED<<56);
    int mode=0;
    if(plan){
      CrossCoreWaitFlag<2>(4);
      auto record=rg[GetBlockIdx()*16];
      DataCacheCleanAndInvalid<int32_t,CacheLine::SINGLE_CACHE_LINE,DcciDst::CACHELINE_OUT>(record);
      mode=record.GetValue(0);
    }
    TaskSchedule<TM,TN> schedule(gg,M,N,E,cores,GetBlockIdx(),mode);
    ScheduledTile task;
    int produced=0;
    while(schedule.Next(task)){
      const int slot=produced&1;
      if(produced>=2)CrossCoreWaitFlag<2>(1+2*slot);
      if constexpr(TRANSPORT || USE_DIRECT)
        mm.SetSelfDefineData(meta|((uint64_t)(task.expert==E-1 && nb==N)<<55)
          |((uint64_t)(task.col/128)<<57)|((uint64_t)(task.row+task.rows==M)<<62));
      mm.SetSingleShape(task.rows,TRANSPORT?(task.cols+31)/32*32:task.cols,K);
      mm.SetTensorA(ag[(int64_t)task.row*ka],false);
      mm.SetTensorB(bg[(int64_t)task.expert*K*nb+task.col],false);
      mm.IterateAll(cg[((int64_t)GetBlockIdx()*2+slot)*TM*TN],false);
      CrossCoreSetFlag<2,PIPE_FIX>(2*slot);
      ++produced;
    }
    if (produced > 1) CrossCoreWaitFlag<2>(1 + 2 * ((produced - 2) & 1));
    if (produced > 0) CrossCoreWaitFlag<2>(1 + 2 * ((produced - 1) & 1));
    mm.End();
  }
  if ASCEND_IS_AIV {
    const int core = GetBlockIdx() / 2;
    const int sub = GetBlockIdx() % 2;
    const int mode=plan?ChooseSchedule<TM,TN>(groups,
      rg[core*16+sub*8],M,N,E,cores):0;
    constexpr int VCOLS = TN / 2;
    constexpr int VCOUNT = TM * VCOLS;
    TPipe pipe;
    TQue<TPosition::VECIN, 1> cq, sq;
    TQue<TPosition::VECOUT, 1> oq;
    TBuf<TPosition::VECCALC> tb;
    pipe.InitBuffer(cq, 1, VCOUNT * sizeof(int32_t));
    pipe.InitBuffer(sq, 1, VCOLS * sizeof(float));
    pipe.InitBuffer(oq, 1, VCOUNT * sizeof(half));
    pipe.InitBuffer(tb, VCOUNT * sizeof(float));
    auto t = tb.Get<float>();
    TaskSchedule<TM,TN> schedule(gg,M,N,E,cores,core,mode);
    ScheduledTile task;
    int consumed=0;
    while(schedule.Next(task)){
      const int e=task.expert,row=task.row;
      const int col=task.col+sub*VCOLS;
      const int rows=task.rows;
      const int cols=N-col<VCOLS?N-col:VCOLS;
        const int slot = consumed & 1;
        CrossCoreWaitFlag<2>(2 * slot);
        if (rows > 0 && cols > 0) {
          auto c = cq.AllocTensor<int32_t>();
          auto s = sq.AllocTensor<float>();
          DataCopyPad(c, cg[((int64_t)core * 2 + slot) * TM * TN + sub * VCOLS],
            DataCopyExtParams{(uint16_t)rows, (uint32_t)(cols * 4),
              (uint32_t)((TN - cols) * 4), (uint32_t)((VCOLS - (cols + 7) / 8 * 8) / 8), 0},
            DataCopyPadExtParams<int32_t>{true, 0, 0, 0});
          DataCopyPad(s, sg[(int64_t)e * N + col],
            DataCopyExtParams{1, (uint32_t)(cols * 4), 0, 0, 0},
            DataCopyPadExtParams<float>{true, 0, 0, 0.0f});
          cq.EnQue(c);
          sq.EnQue(s);
          c = cq.DeQue<int32_t>();
          s = sq.DeQue<float>();
          CrossCoreSetFlag<2, PIPE_MTE2>(1 + 2 * slot);
          auto z = c.ReinterpretCast<float>();
          Cast(z, c, RoundMode::CAST_RINT, rows * VCOLS);
          PipeBarrier<PIPE_V>();
          for (int c0 = 0; c0 < VCOLS; c0 += 64)
            Mul(z[c0], z[c0], s[c0], (uint64_t)64, (uint8_t)rows,
              BinaryRepeatParams{1, 1, 1, VCOLS / 8, VCOLS / 8, 0});
          PipeBarrier<PIPE_V>();
          GeluBounded(z,t,rows*VCOLS);
          auto out = oq.AllocTensor<half>();
          Cast(out, z, RoundMode::CAST_RINT, rows * VCOLS);
          oq.EnQue(out);
          out = oq.DeQue<half>();
          DataCopyPad(yg[(int64_t)row * N + col], out,
            DataCopyExtParams{(uint16_t)rows, (uint32_t)(cols * 2),
              (uint32_t)((VCOLS - (cols + 15) / 16 * 16) / 16),
              (uint32_t)((N - cols) * 2), 0});
          oq.FreeTensor(out);
          sq.FreeTensor(s);
          cq.FreeTensor(c);
        } else {
          CrossCoreSetFlag<2, PIPE_MTE2>(1 + 2 * slot);
        }
        ++consumed;
    }
  }
}
template<int TM, int TN, bool PADDED>
void Dispatch(GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR group_list,
  GM_ADDR y, GM_ADDR scratch, int M, int N, int K, int E, int cores,
  aclrtStream stream, TCubeTiling tiling)
{
  if constexpr (!PADDED && TM*TN*sizeof(int32_t)<=128*1024) {
    const int kr=(K+31)/32*32;
    if((int64_t)TM*kr<=64*1024 && (int64_t)TN*kr<=64*1024) {
      if constexpr(TM==64 && (TN==128 || TN==256 || TN==512)) {
        if(cores>1 && E>=2*cores && N<=512 && K<=512 && M>=TM*E && M<128*E) {
          if(K%32!=0 || N%32!=0)
            ComputeAdaptive<TM,TN,false,true,false,true><<<cores,nullptr,stream>>>(
              x,weight,scale,group_list,y,scratch,M,N,K,E,tiling);
          else ComputeAdaptive<TM,TN,false,false,false,true><<<cores,nullptr,stream>>>(
              x,weight,scale,group_list,y,scratch,M,N,K,E,tiling);
          return;
        }
      }
      if(N%32!=0 || (K>=128 && K%32!=0))
        Compute<TM,TN,false,true,false,true><<<cores,nullptr,stream>>>(
          x,weight,scale,group_list,y,scratch,M,N,K,E,tiling);
      else Compute<TM,TN,false,false,false,true><<<cores,nullptr,stream>>>(
          x,weight,scale,group_list,y,scratch,M,N,K,E,tiling);
      return;
    }
  }
  if constexpr(TM==64 && (TN==128 || TN==256 || TN==512) && !PADDED) {
    if(cores>1 && E>=2*cores && N<=512 && K<=512 && M>=TM*E && M<128*E){
      if(K<=tiling.baseK) {
        if(K%32!=0 || N%32!=0)
          ComputeAdaptive<TM,TN,false,true,true><<<cores,nullptr,stream>>>(
            x,weight,scale,group_list,y,scratch,M,N,K,E,tiling);
        else ComputeAdaptive<TM,TN,false,false,true><<<cores,nullptr,stream>>>(
            x,weight,scale,group_list,y,scratch,M,N,K,E,tiling);
      } else {
        if(K%32!=0 || N%32!=0)
          ComputeAdaptive<TM,TN,false,true><<<cores,nullptr,stream>>>(
            x,weight,scale,group_list,y,scratch,M,N,K,E,tiling);
        else ComputeAdaptive<TM,TN,false,false><<<cores,nullptr,stream>>>(
            x,weight,scale,group_list,y,scratch,M,N,K,E,tiling);
      }
      return;
    }
  }
  if constexpr (PADDED) {
    Compute<TM,TN,PADDED,true><<<cores,nullptr,stream>>>(
      x,weight,scale,group_list,y,scratch,M,N,K,E,tiling);
  } else {
    if(K<=tiling.baseK) {
      if(N%32!=0 || (K>=128 && K%32!=0))
        Compute<TM,TN,false,true,true><<<cores,nullptr,stream>>>(
          x,weight,scale,group_list,y,scratch,M,N,K,E,tiling);
      else Compute<TM,TN,false,false,true><<<cores,nullptr,stream>>>(
          x,weight,scale,group_list,y,scratch,M,N,K,E,tiling);
      return;
    }
    if (N%32!=0 || (K>=128 && K%32!=0))
      Compute<TM,TN,PADDED,true><<<cores,nullptr,stream>>>(
        x,weight,scale,group_list,y,scratch,M,N,K,E,tiling);
    else
      Compute<TM,TN,PADDED,false><<<cores,nullptr,stream>>>(
        x,weight,scale,group_list,y,scratch,M,N,K,E,tiling);
  }
}
template<int TM, int TN>
void Launch(GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR group_list,
  GM_ADDR y, int M, int N, int K, int E, int cores, aclrtStream stream)
{
  const int maxTiles = ((M + TM - 1) / TM + E - 1) * ((N + TN - 1) / TN);
  if (cores > maxTiles) cores = maxTiles;
  const int denseTiles = ((M + TM - 1) / TM) * ((N + TN - 1) / TN);
  if (K >= 1024 && N % 128 == 0 && cores > 16 && denseTiles > 16 &&
    (denseTiles + 15) / 16 == (denseTiles + cores - 1) / cores)
    cores = 16;
  const bool padded = M >= 256 * E && K >= 128 && N >= 128
    && K % 32 >= 16 && N % 32 >= 16;
  const int ka = padded ? (K + 31) / 32 * 32 : K;
  const int nb = padded ? (N + 31) / 32 * 32 : N;
  matmul_tiling::MultiCoreMatmulTiling mt;
  mt.SetDim(1);
  mt.SetAType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
    matmul_tiling::DataType::DT_INT8, false);
  mt.SetBType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
    matmul_tiling::DataType::DT_INT8, false);
  mt.SetCType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
    matmul_tiling::DataType::DT_INT32);
  mt.SetShape(TM, TN, K);
  mt.SetOrgShape(M, nb, ka, K);
  mt.SetFixSplit(TM > 128 ? 128 : TM, TN, 128);
  mt.SetBufferSpace(512 * 1024, 128 * 1024, 0);
  TCubeTiling tiling;
  if (mt.GetTiling(tiling) != 0) return;
  if(K>=4096 && N>128 && (K%32!=0 || N%32!=0)) {
    tiling.stepKa=4;tiling.stepKb=4;
    tiling.depthA1=8;tiling.depthB1=8;
  } else if(K>=1024 && K%32==0 && N%128==0 && tiling.stepKa>4) {
    const int bytesA=8*tiling.baseM*tiling.baseK;
    const int bytesB=tiling.depthB1*tiling.baseN*tiling.baseK;
    if(bytesA+bytesB<=512*1024) {
      tiling.stepKa=4;tiling.depthA1=8;
    }
  }
  void* scratch = nullptr;
  const int64_t extra = (ka != K ? (int64_t)M * ka : 0)
    + (nb != N ? (int64_t)E * K * nb : 0);
  if (aclrtMalloc(&scratch, cores * 2 * TM * TN * sizeof(int32_t) + extra + cores*64,
      ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) return;
  if constexpr (TM == 128 && TN == 256) {
    if (padded)
      Dispatch<TM,TN,true>(x,weight,scale,group_list,y,(GM_ADDR)scratch,
        M,N,K,E,cores,stream,tiling);
    else
      Dispatch<TM,TN,false>(x,weight,scale,group_list,y,(GM_ADDR)scratch,
        M,N,K,E,cores,stream,tiling);
  } else {
    Dispatch<TM,TN,false>(x,weight,scale,group_list,y,(GM_ADDR)scratch,
      M,N,K,E,cores,stream,tiling);
  }
  aclrtSynchronizeStream(stream);
  aclrtFree(scratch);
}
}
extern "C" void run_kernel(
GM_ADDR x,const TensorGroupInfo& info_x,GM_ADDR weight,const TensorGroupInfo& info_weight,
GM_ADDR scale,const TensorGroupInfo& info_scale,GM_ADDR group_list,const TensorGroupInfo& info_group_list,
GM_ADDR y,const TensorGroupInfo& info_y,int64_t availableCoreNum,aclrtStream stream)
{
const int M=info_x.tensors[0].shape[0],K=info_x.tensors[0].shape[1];
const int E=info_weight.tensors[0].shape[0],N=info_weight.tensors[0].shape[2];
if(M<=16 && N<=16 && K<=16){
 if(M==1){
 switch(K){
  case 1: TinySingle::LaunchTinyKnownN<1>(x,weight,scale,group_list,y,M,N,E,stream);break;
  case 2: TinySingle::LaunchTinyKnownN<2>(x,weight,scale,group_list,y,M,N,E,stream);break;
  case 3: TinySingle::LaunchTinyKnownN<3>(x,weight,scale,group_list,y,M,N,E,stream);break;
  case 4: TinySingle::LaunchTinyKnownN<4>(x,weight,scale,group_list,y,M,N,E,stream);break;
  case 5: TinySingle::LaunchTinyKnownN<5>(x,weight,scale,group_list,y,M,N,E,stream);break;
  case 6: TinySingle::LaunchTinyKnownN<6>(x,weight,scale,group_list,y,M,N,E,stream);break;
  case 7: TinySingle::LaunchTinyKnownN<7>(x,weight,scale,group_list,y,M,N,E,stream);break;
  case 8: TinySingle::LaunchTinyKnownN<8>(x,weight,scale,group_list,y,M,N,E,stream);break;
  case 9: TinySingle::LaunchTinyKnownN<9>(x,weight,scale,group_list,y,M,N,E,stream);break;
  case 10: TinySingle::LaunchTinyKnownN<10>(x,weight,scale,group_list,y,M,N,E,stream);break;
  case 11: TinySingle::LaunchTinyKnownN<11>(x,weight,scale,group_list,y,M,N,E,stream);break;
  case 12: TinySingle::LaunchTinyKnownN<12>(x,weight,scale,group_list,y,M,N,E,stream);break;
  case 13: TinySingle::LaunchTinyKnownN<13>(x,weight,scale,group_list,y,M,N,E,stream);break;
  case 14: TinySingle::LaunchTinyKnownN<14>(x,weight,scale,group_list,y,M,N,E,stream);break;
  case 15: TinySingle::LaunchTinyKnownN<15>(x,weight,scale,group_list,y,M,N,E,stream);break;
  case 16: TinySingle::LaunchTinyKnownN<16>(x,weight,scale,group_list,y,M,N,E,stream);break;
 }
 }else{
 switch(K){
  case 1: Core::LaunchTinyRows<1>(x,weight,scale,group_list,y,M,N,E,stream);break;
  case 2: Core::LaunchTinyRows<2>(x,weight,scale,group_list,y,M,N,E,stream);break;
  case 3: Core::LaunchTinyRows<3>(x,weight,scale,group_list,y,M,N,E,stream);break;
  case 4: Core::LaunchTinyRows<4>(x,weight,scale,group_list,y,M,N,E,stream);break;
  case 5: Core::LaunchTinyRows<5>(x,weight,scale,group_list,y,M,N,E,stream);break;
  case 6: Core::LaunchTinyRows<6>(x,weight,scale,group_list,y,M,N,E,stream);break;
  case 7: Core::LaunchTinyRows<7>(x,weight,scale,group_list,y,M,N,E,stream);break;
  case 8: Core::LaunchTinyRows<8>(x,weight,scale,group_list,y,M,N,E,stream);break;
  case 9: Core::LaunchTinyRows<9>(x,weight,scale,group_list,y,M,N,E,stream);break;
  case 10: Core::LaunchTinyRows<10>(x,weight,scale,group_list,y,M,N,E,stream);break;
  case 11: Core::LaunchTinyRows<11>(x,weight,scale,group_list,y,M,N,E,stream);break;
  case 12: Core::LaunchTinyRows<12>(x,weight,scale,group_list,y,M,N,E,stream);break;
  case 13: Core::LaunchTinyRows<13>(x,weight,scale,group_list,y,M,N,E,stream);break;
  case 14: Core::LaunchTinyRows<14>(x,weight,scale,group_list,y,M,N,E,stream);break;
  case 15: Core::LaunchTinyRows<15>(x,weight,scale,group_list,y,M,N,E,stream);break;
  case 16: Core::LaunchTinyRows<16>(x,weight,scale,group_list,y,M,N,E,stream);break;
 }
 }
 return;
}
int cores=availableCoreNum>0?(int)availableCoreNum:1;if(cores>20)cores=20;
if(K==1){
 int vc=cores*2;const int experts=E<M?E:M;
 const int tasks=((M+127)/128+experts-1)*((N+127)/128);if(vc>tasks)vc=tasks;
 Core::ComputeVectorK1<128><<<vc,nullptr,stream>>>(x,weight,scale,group_list,y,M,N,E);return;
}
if(N==1 && K>=1024 && M>=256){
 Core::LaunchColumnDots<256>(x,weight,scale,group_list,y,M,K,E,cores,stream);return;
}
if(N==1){
 int vc=cores*2;const int tasks=(M+7)/8+(E<M?E:M)-1;if(vc>tasks)vc=tasks;
 if(K<=64)Core::ComputeVectorN1Short<64><<<vc,nullptr,stream>>>(x,weight,scale,group_list,y,M,K,E);
 else if(K<=128)Core::ComputeVectorN1Short<128><<<vc,nullptr,stream>>>(x,weight,scale,group_list,y,M,K,E);
 else if(K<=256)Core::ComputeVectorN1Alias<256><<<vc,nullptr,stream>>>(x,weight,scale,group_list,y,M,K,E);
 else if(K<=512)Core::ComputeVectorN1Alias<512><<<vc,nullptr,stream>>>(x,weight,scale,group_list,y,M,K,E);
 else if(K<=1024)Core::ComputeVectorN1Wide<<<vc,nullptr,stream>>>(x,weight,scale,group_list,y,M,K,E);
 else{
 int vcLong=cores*2;if(vcLong>M)vcLong=M;
 if(K<=2048)Core::ComputeVectorN1Long<2048><<<vcLong,nullptr,stream>>>(x,weight,scale,group_list,y,M,K,E);
 else if(K<=4096)Core::ComputeVectorN1Long<4096><<<vcLong,nullptr,stream>>>(x,weight,scale,group_list,y,M,K,E);
 else Core::ComputeVectorN1Long<8192><<<vcLong,nullptr,stream>>>(x,weight,scale,group_list,y,M,K,E);
 }
 return;
}
  const int alignedWaveRows = (M + 15) / 16;
  if (E == 1 && N <= 128 && N % 32 == 0 && K % 32 == 0
    && K <= 65536 / 128 && alignedWaveRows <= cores) {
    void* scratch = nullptr;
    if (aclrtMalloc(&scratch, (int64_t)alignedWaveRows * 16 * 128 * sizeof(int32_t),
        ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) return;
    if (N != 128) {
      Expert::ComputeAlignedOneWave<16,128><<<alignedWaveRows,nullptr,stream>>>(
        x,weight,scale,group_list,y,(GM_ADDR)scratch,M,N,K);
    } else {
    if (N == 128 && K == 32)
    {
      if (M % 16 == 0)
        { if(alignedWaveRows>1) Expert::ComputeAlignedUnitReady<16,128,32,true><<<alignedWaveRows,nullptr,stream>>>(x,weight,scale,group_list,y,(GM_ADDR)scratch,M,N,K); else Expert::ComputeAlignedRowSplit<16,128,32,true><<<alignedWaveRows,nullptr,stream>>>(
          x,weight,scale,group_list,y,(GM_ADDR)scratch,M,N,K); }
      else
      { if(alignedWaveRows>1) Expert::ComputeAlignedUnitReady<16,128,32><<<alignedWaveRows,nullptr,stream>>>(x,weight,scale,group_list,y,(GM_ADDR)scratch,M,N,K); else Expert::ComputeAlignedRowSplit<16,128,32><<<alignedWaveRows,nullptr,stream>>>(
        x,weight,scale,group_list,y,(GM_ADDR)scratch,M,N,K); }
