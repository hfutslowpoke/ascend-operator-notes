namespace gmg {
namespace ha36sched2 {
struct Plan {
  Z0 low, high, use;
};
template <Z0 BM, Z0 Extra, Z0 Policy>
__aicore__ __attribute__((noinline)) GMG_HA36_SCHED_CODE inline Plan BuildPlan(GM_ADDR groups, Z0 core, Z0 cores, Z0 e,
                                                                               Z0 m) {
  auto ends = (__gm__ Z3 *)groups;
  Z0 first = 0, total = 0, active = 0, largest = 0;
  Z0 base = 0;
  for (; base + 4 <= e; base += 4) {
#pragma unroll
    for (Z0 lane = 0; lane < 4; ++lane) {
      Z0 ex = base + lane;

      Z0 end = Z0(ends[ex]), rows = end - first;
      if (rows) {
        ++active;
        total += (rows + BM - 1) / BM + Extra;
        largest = largest > rows ? largest : rows;
      }
      first = end;
    }
  }
  for (Z0 ex = base; ex < e; ++ex) {

    Z0 end = Z0(ends[ex]), rows = end - first;
    if (rows) {
      ++active;
      total += (rows + BM - 1) / BM + Extra;
      largest = largest > rows ? largest : rows;
    }
    first = end;
  }
  Z0 ratio = Policy == 2 ? 2 : 4;
  bool use = active > 1 && (Policy == 1 || Z2(largest) * active > Z2(m) * ratio);
  return {Z0(Z2(total) * core / cores), Z0(Z2(total) * (core + 1) / cores), Z0(use)};
}
template <Z0 BM, Z0 BN, Z0 Width, Z0 Extra, Z0 Policy> class Schedule {
public:
  __aicore__ Schedule(GM_ADDR groups, Z0 e, Z0 n, Z0 core, Z0 cores, Z0 k, Z0 m)
      : band_(groups, e, n, core, cores, k, m), experts_(e), ends_((__gm__ Z3 *)groups),
        columns_((n + Width - 1) / Width - (n % Width == 1 && BN >= Width + 32 ? 1 : 0)) {
    auto p = BuildPlan<BM, Extra, Policy>(groups, core, cores, e, m);
    next_ = p.low;
    last_ = p.high;
    use_ = p.use;
  }
  __aicore__ inline bool Next(Z0 &expert, Z0 &row, Z0 &col, Z0 &rows, Z0 &cols, Z0 n) {
    if (!use_)
      return band_.Next(expert, row, col, rows, cols, n);
    while (expert_ < experts_ && next_ < last_) {
      if (!loaded_) {
        end_ = Z0(ends_[expert_]);
        tiles_ = (end_ - begin_ + BM - 1) / BM;
        cost_ = tiles_ + (tiles_ ? Extra : 0);
        loaded_ = true;
      }
      if (next_ < prefix_ + tiles_) {
        expert = expert_;
        row = begin_ + (next_ - prefix_) * BM;
        rows = Min(BM, end_ - row);
        col = column_ * Width;
        cols = column_ + 1 == columns_ ? n - col : Width;
        if (++column_ == columns_) {
          column_ = 0;
          ++next_;
        }
        return true;
      }
      if (next_ < prefix_ + cost_)
        next_ = prefix_ + cost_;
      prefix_ += cost_;
      begin_ = end_;
      ++expert_;
      loaded_ = false;
    }
    return false;
  }

private:
  HaJobs<BM, BN, Width> band_;
  __gm__ Z3 *ends_;
  Z0 experts_, columns_, next_, last_, use_, expert_ = 0, prefix_ = 0, begin_ = 0, end_ = 0, tiles_ = 0, cost_ = 0,
                                             column_ = 0;
  bool loaded_ = false;
};
} // namespace ha36sched2
} // namespace gmg
