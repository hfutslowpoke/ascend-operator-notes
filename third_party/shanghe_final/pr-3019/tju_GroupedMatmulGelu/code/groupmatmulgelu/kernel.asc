namespace host_workspace {
// The caller retains control of launch selection and error-path fallbacks.
// This object owns no destructor work: retirement follows stream completion.
class Parameters {
void *allocation_ = nullptr;

public:
template <class Config>
__attribute__((always_inline)) inline bool Prepare(Z2 extent, const Config &config) {
if (aclrtMalloc(&allocation_, extent, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS)
  return false;
if (aclrtMemcpy(allocation_, extent, &config, sizeof(config), ACL_MEMCPY_HOST_TO_DEVICE) == ACL_SUCCESS)
  return true;
aclrtFree(allocation_);
return false;
}
__attribute__((always_inline)) inline GM_ADDR Data() const {
return (GM_ADDR)allocation_;
}
__attribute__((always_inline)) inline void Retire(aclrtStream stream) {
if (aclrtSynchronizeStream(stream) == ACL_SUCCESS)
  aclrtFree(allocation_);
}
};

template <class Tiler>
__attribute__((always_inline)) inline void SetInt8Operands(Tiler &tiler) {
tiler.SetAType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND, matmul_tiling::DataType::DT_INT8);
tiler.SetBType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND, matmul_tiling::DataType::DT_INT8);
tiler.SetCType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND, matmul_tiling::DataType::DT_INT32);
}
} // namespace host_workspace

namespace reference_backend {
namespace suffixBand {
__aicore__ inline Z8 PositiveMidpoint(Z8, Z0);
__aicore__ inline Z8 NegativeSubnormal(Z8);
} // namespace suffixBand
} // namespace reference_backend
namespace gmg_postprocess {
using namespace AscendC;
__aicore__ __attribute__((noinline, section(".gmg_post_rounding"))) inline Z4 RoundCandidate(Z8 z, Z4 h, Z8 estimate) {
union {
Z8 f;
Z0 u;
} v;
v.f = estimate;
if (z >= 2.0f)
v.f = reference_backend::suffixBand::PositiveMidpoint(z, v.u);
else if (z < -1.0f)
v.f = reference_backend::suffixBand::NegativeSubnormal(z);
else
return current_backend::gmg::p12math::QuickCorrectHalf(z, h);
Z0 sign = (v.u >> 16) & 0x8000U, a = v.u & 0x7fffffffU, exp = a >> 23;
if (exp >= 113)
return Z4(sign | (((a + 0xfffU + ((a >> 13) & 1U)) >> 13) - (112U << 10)));
if (exp < 102)
return Z4(sign);
Z0 shift = 126 - exp, mant = (a & 0x7fffffU) | 0x800000U;
return Z4(sign | ((mant + ((1U << (shift - 1)) - 1U) + ((mant >> shift) & 1U)) >> shift));
}
__aicore__ inline bool Correct(LocalTensor<Z8> z, LocalTensor<Z8> result, LocalTensor<Z8> u, LocalTensor<Z8> den,
                           LocalTensor<Z6> mask, LocalTensor<half> out, Z0 count) {
const Z0 pad = (count + 255) / 256 * 32;
auto second = mask[pad];
Adds(u.ReinterpretCast<Z1>(), result.ReinterpretCast<Z1>(), Z1(1), count);
Duplicate(den.ReinterpretCast<Z1>(), Z1(0x1ffc), count);
PipeBarrier<PIPE_V>();
And(u.ReinterpretCast<Z4>(), u.ReinterpretCast<Z4>(), den.ReinterpretCast<Z4>(), 2 * count);
PipeBarrier<PIPE_V>();
CompareScalar(mask, u.ReinterpretCast<Z1>(), Z1(0x1000), CMPMODE::EQ, count);
CompareScalar(second, z, 2.0f, CMPMODE::GE, count);
PipeBarrier<PIPE_V>();
And(mask.ReinterpretCast<Z4>(), mask.ReinterpretCast<Z4>(), second.ReinterpretCast<Z4>(), count / 16);
PipeBarrier<PIPE_V>();
Cast(out, result, RoundMode::CAST_RINT, count);
Z0 words = count / 32, rounded = (words + 63) / 64 * 64;
Duplicate(u, 0.0f, rounded);
PipeBarrier<PIPE_V>();
Cast(u, mask.ReinterpretCast<Z1>(), RoundMode::CAST_RINT, words);
PipeBarrier<PIPE_V>();
CompareScalar(second, u, 0.0f, CMPMODE::NE, rounded);
PipeBarrier<PIPE_V>();
SetFlag<HardEvent::V_S>(EVENT_ID4);
WaitFlag<HardEvent::V_S>(EVENT_ID4);
bool changed = false;
for (Z0 page = 0; page < (words + 31) / 32; ++page) {
Z0 pages = second.ReinterpretCast<Z0>().GetValue(page);
if (words - page * 32 < 32)
  pages &= (1U << (words - page * 32)) - 1;
while (pages) {
  Z0 word = page * 32 + __builtin_ctz(pages), hits = mask.ReinterpretCast<Z0>().GetValue(word);
  while (hits) {
    Z0 i = word * 32 + __builtin_ctz(hits);
    Z8 zi = z.GetValue(i);
    Z4 previous = out.ReinterpretCast<Z4>().GetValue(i);
    Z0 h = previous & 0x7fffU;
    if ((h >= 0x4000U) && zi != 0.0f && zi > -6.0f && zi < 8.0f) {
      Z4 corrected = RoundCandidate(zi, previous, result.GetValue(i));
      if (corrected != previous) {
        out.ReinterpretCast<Z4>().SetValue(i, corrected);
        changed = true;
      }
    }
    hits &= hits - 1;
  }
  pages &= pages - 1;
}
}
return changed;
}
} // namespace gmg_postprocess
namespace reference_backend {
namespace gmg {
using namespace AscendC;
constexpr Z0 BM = 16;
constexpr Z0 BN = 32;
constexpr Z0 BK = 1024;
constexpr Z0 STAGING_BYTES = BK * BN, VECTOR_BYTES = 4096;
constexpr Z4 INPUT_READY = 8, RESULT_READY = 9, SLOT_FREE = 10;
constexpr Z0 SLOT_COUNT = 2;
constexpr Z0 PANEL_ROWS = 16, PANEL_ELEMS = PANEL_ROWS * 64;
constexpr Z0 PANEL_BYTES = PANEL_ELEMS * 34 + 1024;
constexpr auto MM_CONFIG = GetMDLConfig(false, false, 0, false, false, false, true);
__aicore__ inline Z0 Min(Z0 a, Z0 b) {
return a < b ? a : b;
}
struct Parameters {
Z0 m, n, k, e, kp, workers;
Z0 alignedA, alignedB;
Z0 wideAvailable;
Z2 bOffset, cOffset, slotBytes;
TCubeTiling cube;
TCubeTiling wideCube;
};
template <HardEvent event> __aicore__ inline void Fence() {
SetFlag<event>(EVENT_ID0);
WaitFlag<event>(EVENT_ID0);
}
__aicore__ inline void GeluFromZ(LocalTensor<Z6> vectors_, Z0 vn) {
auto z = vectors_.ReinterpretCast<Z8>()[128];
auto u = vectors_.ReinterpretCast<Z8>()[192];
auto t = vectors_.ReinterpretCast<Z8>()[256];
auto den = vectors_.ReinterpretCast<Z8>()[320];
auto neg = vectors_.ReinterpretCast<Z8>()[384];
auto result = vectors_.ReinterpretCast<Z8>()[448];
auto mask = vectors_.ReinterpretCast<Z6>()[2048];
auto out = vectors_.ReinterpretCast<half>()[1152];
Mul(u, z, z, vn);
PipeBarrier<PIPE_V>();
Duplicate(t, -1.5957691216057308f, vn);
PipeBarrier<PIPE_V>();
Axpy(t, u, -0.071354816275f, vn);
PipeBarrier<PIPE_V>();
Abs(u, z, vn);
PipeBarrier<PIPE_V>();
Mul(t, t, u, vn);
PipeBarrier<PIPE_V>();
CompareScalar(mask, z, 0.0f, CMPMODE::GE, 64);
Exp(t, t, vn);
PipeBarrier<PIPE_V>();
Adds(den, t, 1.0f, vn);
Mul(neg, z, t, vn);
PipeBarrier<PIPE_V>();
Div(t, neg, den, vn);
PipeBarrier<PIPE_V>();
Sub(u, z, t, vn);
PipeBarrier<PIPE_V>();
Sub(den, z, u, vn);
PipeBarrier<PIPE_V>();
Sub(den, den, t, vn);
PipeBarrier<PIPE_V>();
Select(result, mask, u, t, SELMODE::VSEL_TENSOR_TENSOR_MODE, vn);
Fence<HardEvent::V_S>();
auto bits = vectors_.ReinterpretCast<Z0>()[448];
for (Z0 j = 0; j < vn; ++j) {
Z0 value = bits.GetValue(j);
if (z.GetValue(j) >= 0.0f && (value & 0x7f800000U) >= 0x38800000U && (value & 0x1fffU) == 0x1000U) {
  Z8 residual = den.GetValue(j);
  if (residual > 0.0f)
    bits.SetValue(j, value + 1);
  else if (residual < 0.0f)
    bits.SetValue(j, value - 1);
}
}
Fence<HardEvent::S_V>();
Cast(out, result, RoundMode::CAST_RINT, vn);
Fence<HardEvent::V_MTE3>();
}
__aicore__ inline void Gelu(LocalTensor<Z1> ci, LocalTensor<Z8> scale, TBuf<TPosition::VECCALC> &vectors_, Z0 vn) {
auto z = vectors_.Get<Z8>()[128];
Duplicate(z, 0.0f, 64);
PipeBarrier<PIPE_V>();
Cast(z, ci, RoundMode::CAST_RINT, vn);
PipeBarrier<PIPE_V>();
Mul(z, z, scale, vn);
PipeBarrier<PIPE_V>();
GeluFromZ(vectors_.Get<Z6>(), vn);
}
__aicore__ inline void PanelGelu(LocalTensor<Z1> ci, LocalTensor<Z8> scale, TBuf<TPosition::VECCALC> &vectors_,
                             Z0 count) {
auto z = vectors_.Get<Z8>()[2 * PANEL_ELEMS];
auto u = vectors_.Get<Z8>()[3 * PANEL_ELEMS];
auto t = vectors_.Get<Z8>()[4 * PANEL_ELEMS];
auto den = vectors_.Get<Z8>()[5 * PANEL_ELEMS];
auto neg = vectors_.Get<Z8>()[6 * PANEL_ELEMS];
auto result = vectors_.Get<Z8>()[7 * PANEL_ELEMS];
auto mask = vectors_.Get<Z6>()[PANEL_ELEMS * 32];
auto out = vectors_.Get<half>()[(PANEL_ELEMS * 32 + 1024) / 2];
Duplicate(z, 0.0f, count);
PipeBarrier<PIPE_V>();
Cast(z, ci, RoundMode::CAST_RINT, count);
PipeBarrier<PIPE_V>();
Mul(z, z, scale, 64, static_cast<Z6>(count / 64), BinaryRepeatParams(1, 1, 1, 8, 8, 0));
PipeBarrier<PIPE_V>();
Mul(u, z, z, count);
PipeBarrier<PIPE_V>();
Duplicate(t, -1.5957691216057308f, count);
PipeBarrier<PIPE_V>();
Axpy(t, u, -0.071354816275f, count);
PipeBarrier<PIPE_V>();
Abs(u, z, count);
PipeBarrier<PIPE_V>();
Mul(t, t, u, count);
PipeBarrier<PIPE_V>();
CompareScalar(mask, z, 0.0f, CMPMODE::GE, count);
Exp(t, t, count);
PipeBarrier<PIPE_V>();
Adds(den, t, 1.0f, count);
Mul(neg, z, t, count);
PipeBarrier<PIPE_V>();
Div(t, neg, den, count);
PipeBarrier<PIPE_V>();
Sub(u, z, t, count);
PipeBarrier<PIPE_V>();
Sub(den, z, u, count);
PipeBarrier<PIPE_V>();
Sub(den, den, t, count);
PipeBarrier<PIPE_V>();
Select(result, mask, u, t, SELMODE::VSEL_TENSOR_TENSOR_MODE, count);
PipeBarrier<PIPE_V>();
auto bits = result.ReinterpretCast<Z1>();
auto work = ci;
auto constant = scale.ReinterpretCast<Z1>();
auto mid = vectors_.Get<Z6>()[PANEL_ELEMS * 32 + 256];
auto exponent = vectors_.Get<Z6>()[PANEL_ELEMS * 32 + 512];
auto residual = vectors_.Get<Z6>()[PANEL_ELEMS * 32 + 768];
Duplicate(constant, static_cast<Z1>(0x1fff), count);
PipeBarrier<PIPE_V>();
And(work.ReinterpretCast<Z4>(), bits.ReinterpretCast<Z4>(), constant.ReinterpretCast<Z4>(), 2 * count);
PipeBarrier<PIPE_V>();
CompareScalar(mid, work, static_cast<Z1>(0x1000), CMPMODE::EQ, count);
Duplicate(constant, static_cast<Z1>(0x7f800000), count);
PipeBarrier<PIPE_V>();
And(work.ReinterpretCast<Z4>(), bits.ReinterpretCast<Z4>(), constant.ReinterpretCast<Z4>(), 2 * count);
PipeBarrier<PIPE_V>();
Cast(work.ReinterpretCast<Z8>(), work, RoundMode::CAST_RINT, count);
PipeBarrier<PIPE_V>();
CompareScalar(exponent, work.ReinterpretCast<Z8>(), static_cast<Z8>(0x38800000), CMPMODE::GE, count);
PipeBarrier<PIPE_V>();
And(mask.ReinterpretCast<Z4>(), mask.ReinterpretCast<Z4>(), mid.ReinterpretCast<Z4>(), count / 16);
PipeBarrier<PIPE_V>();
And(mask.ReinterpretCast<Z4>(), mask.ReinterpretCast<Z4>(), exponent.ReinterpretCast<Z4>(), count / 16);
PipeBarrier<PIPE_V>();
Duplicate(u, 1.0f, count);
Duplicate(t, 0.0f, count);
PipeBarrier<PIPE_V>();
CompareScalar(residual, den, 0.0f, CMPMODE::GT, count);
PipeBarrier<PIPE_V>();
And(residual.ReinterpretCast<Z4>(), residual.ReinterpretCast<Z4>(), mask.ReinterpretCast<Z4>(), count / 16);
PipeBarrier<PIPE_V>();
Select(neg, residual, u, t, SELMODE::VSEL_TENSOR_TENSOR_MODE, count);
PipeBarrier<PIPE_V>();
Cast(work, neg, RoundMode::CAST_RINT, count);
PipeBarrier<PIPE_V>();
Add(bits, bits, work, count);
PipeBarrier<PIPE_V>();
CompareScalar(residual, den, 0.0f, CMPMODE::LT, count);
PipeBarrier<PIPE_V>();
And(residual.ReinterpretCast<Z4>(), residual.ReinterpretCast<Z4>(), mask.ReinterpretCast<Z4>(), count / 16);
PipeBarrier<PIPE_V>();
Select(neg, residual, u, t, SELMODE::VSEL_TENSOR_TENSOR_MODE, count);
PipeBarrier<PIPE_V>();
Cast(work, neg, RoundMode::CAST_RINT, count);
PipeBarrier<PIPE_V>();
Sub(bits, bits, work, count);
PipeBarrier<PIPE_V>();
Cast(out, result, RoundMode::CAST_RINT, count);
Fence<HardEvent::V_MTE3>();
}
constexpr Z0 TINY_IO_BYTES = 480;
__aicore__ inline void StoreTinyZ(Z1 value, Z8 scale, Z0 index, LocalTensor<Z8> direct, bool &allLarge) {
const Z8 z = static_cast<Z8>(value) * scale;
direct.SetValue(index, z);
if (allLarge && z < 8.0f && z > -6.0f)
allLarge = false;
}
template <Z0 N>
__aicore__ inline void TinyRow(LocalTensor<Z7> lx, LocalTensor<Z7> lw, LocalTensor<Z8> ls, Z0 row, Z0 expert, Z0 k,
                           LocalTensor<Z8> direct, bool &allLarge) {
Z1 c0 = 0, c1 = 0, c2 = 0, c3 = 0, c4 = 0, c5 = 0, c6 = 0, c7 = 0;
for (Z0 feature = 0; feature < k; ++feature) {
const Z1 xv = static_cast<Z1>(lx.GetValue(row * k + feature));
const Z0 at = (expert * k + feature) * N;
c0 += xv * static_cast<Z1>(lw.GetValue(at + 0));
if (N > 1)
  c1 += xv * static_cast<Z1>(lw.GetValue(at + 1));
if (N > 2)
  c2 += xv * static_cast<Z1>(lw.GetValue(at + 2));
if (N > 3)
  c3 += xv * static_cast<Z1>(lw.GetValue(at + 3));
if (N > 4)
  c4 += xv * static_cast<Z1>(lw.GetValue(at + 4));
if (N > 5)
  c5 += xv * static_cast<Z1>(lw.GetValue(at + 5));
if (N > 6)
  c6 += xv * static_cast<Z1>(lw.GetValue(at + 6));
if (N > 7)
  c7 += xv * static_cast<Z1>(lw.GetValue(at + 7));
}
const Z0 index = row * N;
{
StoreTinyZ(c0, ls.GetValue(expert * N + 0), index + 0, direct, allLarge);
}
if (N > 1) {
StoreTinyZ(c1, ls.GetValue(expert * N + 1), index + 1, direct, allLarge);
}
if (N > 2) {
StoreTinyZ(c2, ls.GetValue(expert * N + 2), index + 2, direct, allLarge);
}
if (N > 3) {
StoreTinyZ(c3, ls.GetValue(expert * N + 3), index + 3, direct, allLarge);
}
if (N > 4) {
StoreTinyZ(c4, ls.GetValue(expert * N + 4), index + 4, direct, allLarge);
}
if (N > 5) {
StoreTinyZ(c5, ls.GetValue(expert * N + 5), index + 5, direct, allLarge);
}
if (N > 6) {
StoreTinyZ(c6, ls.GetValue(expert * N + 6), index + 6, direct, allLarge);
}
if (N > 7) {
StoreTinyZ(c7, ls.GetValue(expert * N + 7), index + 7, direct, allLarge);
}
}
__global__ __aicore__ void TinyKernel(GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groupList, GM_ADDR y, Z0 e,
                                  Z0 m, Z0 k, Z0 n) {
KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
LocalTensor<Z6> vectors(TPosition::VECCALC, 0, VECTOR_BYTES);
LocalTensor<Z6> storage(TPosition::VECCALC, VECTOR_BYTES, TINY_IO_BYTES);
auto lx = storage.ReinterpretCast<Z7>();
auto lw = storage.ReinterpretCast<Z7>()[64];
auto ls = storage.ReinterpretCast<Z8>()[320 / sizeof(Z8)];
auto lg = storage.ReinterpretCast<Z3>()[448 / sizeof(Z3)];
GlobalTensor<Z7> gx, gw;
GlobalTensor<Z8> gs;
GlobalTensor<Z3> gg;
GlobalTensor<half> gy;
gx.SetGlobalBuffer(reinterpret_cast<__gm__ Z7 *>(x));
gw.SetGlobalBuffer(reinterpret_cast<__gm__ Z7 *>(weight));
gs.SetGlobalBuffer(reinterpret_cast<__gm__ Z8 *>(scale));
gg.SetGlobalBuffer(reinterpret_cast<__gm__ Z3 *>(groupList));
gy.SetGlobalBuffer(reinterpret_cast<__gm__ half *>(y));
DataCopyPadExtParams<Z7> bp{false, 0, 0, 0};
DataCopyPadExtParams<Z8> sp{false, 0, 0, 0};
DataCopyPadExtParams<Z3> gp{false, 0, 0, 0};
DataCopyExtParams xc{1, m * k, 0, 0, 0}, wc{1, e * k * n, 0, 0, 0};
DataCopyExtParams sc{1, e * n * 4, 0, 0, 0}, gc{1, e * 8, 0, 0, 0};
DataCopyPad(lx, gx, xc, bp);
DataCopyPad(lw, gw, wc, bp);
DataCopyPad(ls, gs, sc, sp);
DataCopyPad(lg, gg, gc, gp);
Fence<HardEvent::MTE2_S>();
auto out = vectors.ReinterpretCast<half>()[1152];
auto direct = vectors.ReinterpretCast<Z8>()[128];
Duplicate(direct, 0.0f, 64);
Fence<HardEvent::V_S>();
bool allLarge = true;
Z0 start = 0;
for (Z0 expert = 0; expert < e; ++expert) {
const Z0 end = static_cast<Z0>(lg.GetValue(expert));
for (Z0 row = start; row < end; ++row) {
  switch (n) {
  case 1:
    TinyRow<1>(lx, lw, ls, row, expert, k, direct, allLarge);
    break;
  case 2:
    TinyRow<2>(lx, lw, ls, row, expert, k, direct, allLarge);
    break;
  case 3:
    TinyRow<3>(lx, lw, ls, row, expert, k, direct, allLarge);
    break;
  case 4:
    TinyRow<4>(lx, lw, ls, row, expert, k, direct, allLarge);
    break;
  case 5:
    TinyRow<5>(lx, lw, ls, row, expert, k, direct, allLarge);
    break;
  case 6:
    TinyRow<6>(lx, lw, ls, row, expert, k, direct, allLarge);
    break;
  case 7:
    TinyRow<7>(lx, lw, ls, row, expert, k, direct, allLarge);
    break;
  case 8:
    TinyRow<8>(lx, lw, ls, row, expert, k, direct, allLarge);
    break;
  }
}
start = end;
}
Fence<HardEvent::S_V>();
if (allLarge) {
Maxs(direct, direct, -0.0f, m * n);
PipeBarrier<PIPE_V>();
Cast(out, direct, RoundMode::CAST_RINT, m * n);
Fence<HardEvent::V_MTE3>();
} else
GeluFromZ(vectors, m * n);
DataCopyExtParams yc{1, m * n * 2, 0, 0, 0};
DataCopyPad(gy, out, yc);
Fence<HardEvent::MTE3_V>();
}
template <unsigned N>
__aicore__ inline void LineDot(LocalTensor<Z7> x, LocalTensor<Z7> w, LocalTensor<Z8> sc, LocalTensor<Z3> g,
                           LocalTensor<Z8> dest, Z0 m, Z0 e, Z0 beg, Z0 stop, bool &large) {
Z0 a = g.GetValue(0), b = e > 1 ? (Z0)g.GetValue(1) : m, d = e > 2 ? (Z0)g.GetValue(2) : m;
for (Z0 row = beg / N; row < (stop + N - 1) / N; ++row) {
Z0 ex = (row >= a) + (row >= b) + (row >= d), wb = ex * 3 * N, ofs = row * N;
Z1 x0 = x.GetValue(row * 3), x1 = x.GetValue(row * 3 + 1), x2 = x.GetValue(row * 3 + 2);
#pragma unroll
for (unsigned col = 0; col < N; ++col) {
  if (ofs + col < beg || ofs + col >= stop)
    continue;
  Z1 c = x0 * w.GetValue(wb + col) + x1 * w.GetValue(wb + N + col) + x2 * w.GetValue(wb + 2 * N + col);
  Z8 val = (Z8)c * sc.GetValue(ex * N + col);
  dest.SetValue(ofs + col - beg, val);
  large = large && !(val < 8.0f && val > -6.0f);
}
}
}
__aicore__ inline void LineGelu(LocalTensor<Z6> vectors_, Z0 vn) {
auto z = vectors_.ReinterpretCast<Z8>()[128];
auto u = vectors_.ReinterpretCast<Z8>()[192];
auto t = vectors_.ReinterpretCast<Z8>()[256];
auto den = vectors_.ReinterpretCast<Z8>()[320];
auto neg = vectors_.ReinterpretCast<Z8>()[384];
auto result = vectors_.ReinterpretCast<Z8>()[448];
auto mask = vectors_.ReinterpretCast<Z6>()[2048];
auto out = vectors_.ReinterpretCast<half>()[1152];
Mul(u, z, z, vn);
PipeBarrier<PIPE_V>();
Duplicate(t, -1.5957691216057308f, vn);
PipeBarrier<PIPE_V>();
Axpy(t, u, -0.071354816275f, vn);
PipeBarrier<PIPE_V>();
Abs(u, z, vn);
PipeBarrier<PIPE_V>();
Mul(t, t, u, vn);
PipeBarrier<PIPE_V>();
CompareScalar(mask, z, 0.0f, CMPMODE::GE, 64);
Exp(t, t, vn);
PipeBarrier<PIPE_V>();
Adds(den, t, 1.0f, vn);
Mul(neg, z, t, vn);
PipeBarrier<PIPE_V>();
Div(t, neg, den, vn);
PipeBarrier<PIPE_V>();
Sub(u, z, t, vn);
PipeBarrier<PIPE_V>();
Select(result, mask, u, t, SELMODE::VSEL_TENSOR_TENSOR_MODE, vn);
PipeBarrier<PIPE_V>();
Cast(out, result, RoundMode::CAST_RINT, vn);
Fence<HardEvent::V_S>();
auto words = result.ReinterpretCast<Z0>();
auto hw = out.ReinterpretCast<Z4>();
for (Z0 j = 0; j < vn; ++j) {
Z0 word = words.GetValue(j);
if (word >= 0x38800000U && word < 0x41000000U && (word & 0x1fffU) == 0x1000U) {
  Z8 zz = z.GetValue(j);
  if (zz >= 7.08934307098388671875f)
    continue;
  Z8 residual = (zz - result.GetValue(j)) - t.GetValue(j);
  Z0 lower = (word >> 13) - (112U << 10);
  if (residual > 0.f)
    hw.SetValue(j, (Z4)(lower + 1));
  else if (residual < 0.f)
    hw.SetValue(j, (Z4)lower);
}
}
Fence<HardEvent::S_MTE3>();
}
template <Z0 N>
__aicore__ inline void OneRow(LocalTensor<Z7> xx, LocalTensor<Z7> ww, LocalTensor<Z8> ss, Z0 xr, Z0 ex,
                          LocalTensor<Z8> out, bool &large) {
Z1 x0 = xx.GetValue(xr), x1 = xx.GetValue(xr + 1), x2 = xx.GetValue(xr + 2);
Z0 w0 = ex * 3 * N, s0 = ex * N;
#pragma unroll
for (Z0 j = 0; j < N; ++j) {
Z1 sum = x0 * ww.GetValue(w0 + j) + x1 * ww.GetValue(w0 + N + j) + x2 * ww.GetValue(w0 + 2 * N + j);
Z8 f = (Z8)sum * ss.GetValue(s0 + j);
out.SetValue(j, f);
large = large && !(f < 7.08934307098388671875f && f > -6.0f);
}
}
__global__ __aicore__ void ShortPanelKernel(GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groupList, GM_ADDR y,
                                        Z0 e, Z0 m, Z0 k, Z0 n) {
KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
LocalTensor<Z6> vectors(TPosition::VECCALC, 0, VECTOR_BYTES);
LocalTensor<Z6> storage(TPosition::VECCALC, VECTOR_BYTES, TINY_IO_BYTES);
auto lx = storage.ReinterpretCast<Z7>();
auto lw = storage.ReinterpretCast<Z7>()[64];
auto ls = storage.ReinterpretCast<Z8>()[320 / sizeof(Z8)];
auto lg = storage.ReinterpretCast<Z3>()[448 / sizeof(Z3)];
GlobalTensor<Z7> gx, gw;
GlobalTensor<Z8> gs;
GlobalTensor<Z3> gg;
GlobalTensor<half> gy;
gx.SetGlobalBuffer(reinterpret_cast<__gm__ Z7 *>(x));
gw.SetGlobalBuffer(reinterpret_cast<__gm__ Z7 *>(weight));
gs.SetGlobalBuffer(reinterpret_cast<__gm__ Z8 *>(scale));
gg.SetGlobalBuffer(reinterpret_cast<__gm__ Z3 *>(groupList));
gy.SetGlobalBuffer(reinterpret_cast<__gm__ half *>(y));
DataCopyPadExtParams<Z7> bp{false, 0, 0, 0};
DataCopyPadExtParams<Z8> sp{false, 0, 0, 0};
DataCopyPadExtParams<Z3> gp{false, 0, 0, 0};
DataCopyExtParams xc{1, m * k, 0, 0, 0}, wc{1, e * k * n, 0, 0, 0};
DataCopyExtParams sc{1, e * n * 4, 0, 0, 0}, gc{1, e * 8, 0, 0, 0};
const bool wholeRow = GetBlockNum() == m;
if (wholeRow) {
DataCopyExtParams one{1, 3, 0, 0, 0};
DataCopyPad(lx, gx[GetBlockIdx() * 3], one, bp);
} else
DataCopyPad(lx, gx, xc, bp);
DataCopyPad(lw, gw, wc, bp);
DataCopyPad(ls, gs, sc, sp);
Z0 ex = 0;
if (!wholeRow || false)
DataCopyPad(lg, gg, gc, gp);
if (wholeRow && !false) {
const Z0 row = GetBlockIdx();
ex = (row >= gg.GetValue(0)) + (e > 1 && row >= gg.GetValue(1)) + (e > 2 && row >= gg.GetValue(2));
}
Fence<HardEvent::MTE2_S>();
if (wholeRow && false) {
const Z0 row = GetBlockIdx();
ex = (row >= lg.GetValue(0)) + (e > 1 && row >= lg.GetValue(1)) + (e > 2 && row >= lg.GetValue(2));
}
auto out = vectors.ReinterpretCast<half>()[1152];
auto direct = vectors.ReinterpretCast<Z8>()[128];
const Z0 tile = GetBlockNum() == 1 ? m * n : n;
const Z0 begin = GetBlockIdx() * tile;
const Z0 count = (m * n - begin < tile) ? m * n - begin : tile;
bool allLarge = true;
if (wholeRow) {
switch (n) {
case 1:
  OneRow<1>(lx, lw, ls, 0, ex, direct, allLarge);
  break;
case 2:
  OneRow<2>(lx, lw, ls, 0, ex, direct, allLarge);
  break;
case 3:
  OneRow<3>(lx, lw, ls, 0, ex, direct, allLarge);
  break;
case 4:
  OneRow<4>(lx, lw, ls, 0, ex, direct, allLarge);
  break;
case 5:
  OneRow<5>(lx, lw, ls, 0, ex, direct, allLarge);
  break;
case 6:
  OneRow<6>(lx, lw, ls, 0, ex, direct, allLarge);
  break;
case 7:
  OneRow<7>(lx, lw, ls, 0, ex, direct, allLarge);
  break;
case 8:
  OneRow<8>(lx, lw, ls, 0, ex, direct, allLarge);
  break;
}
} else
switch (n) {
case 1:
  LineDot<1>(lx, lw, ls, lg, direct, m, e, begin, begin + count, allLarge);
  break;
case 2:
  LineDot<2>(lx, lw, ls, lg, direct, m, e, begin, begin + count, allLarge);
  break;
case 3:
  LineDot<3>(lx, lw, ls, lg, direct, m, e, begin, begin + count, allLarge);
  break;
case 4:
  LineDot<4>(lx, lw, ls, lg, direct, m, e, begin, begin + count, allLarge);
  break;
case 5:
  LineDot<5>(lx, lw, ls, lg, direct, m, e, begin, begin + count, allLarge);
  break;
case 6:
  LineDot<6>(lx, lw, ls, lg, direct, m, e, begin, begin + count, allLarge);
  break;
case 7:
  LineDot<7>(lx, lw, ls, lg, direct, m, e, begin, begin + count, allLarge);
  break;
case 8:
  LineDot<8>(lx, lw, ls, lg, direct, m, e, begin, begin + count, allLarge);
  break;
}
Fence<HardEvent::S_V>();
if (allLarge) {
Maxs(direct, direct, -0.0f, count);
PipeBarrier<PIPE_V>();
Cast(out, direct, RoundMode::CAST_RINT, count);
Fence<HardEvent::V_MTE3>();
} else {
if (count < 64) {
  Z2 inactive[2] = {~Z2(0) << count, 0};
  Duplicate(direct, 0.0f, inactive, 1, 1, 8);
  PipeBarrier<PIPE_V>();
}
LineGelu(vectors, count);
}
DataCopyExtParams yc{1, count * 2, 0, 0, 0};
DataCopyPad(gy[begin], out, yc);
Fence<HardEvent::MTE3_V>();
}
template <Z0 BM, Z0 BN, Z0 BK> class VectorStage {
static_assert(BM % 16 == 0 && BN % 32 == 0 && BK % 32 == 0, "unsupported tile alignment");
static constexpr Z0 STAGING_BYTES = BK * BN;
struct StageParameters {
Z0 n, k, kp, alignedA, alignedB;
Z2 bOffset, cOffset;
};

public:
template <class P>
__aicore__ inline void Init(TPipe &pipe, const P &p, GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR y,
                          GM_ADDR slot) {
p_ = {p.n, p.k, p.kp, p.alignedA, p.alignedB, p.bOffset, p.cOffset};
x_.SetGlobalBuffer(reinterpret_cast<__gm__ Z7 *>(x));
w_.SetGlobalBuffer(reinterpret_cast<__gm__ Z7 *>(weight));
s_.SetGlobalBuffer(reinterpret_cast<__gm__ Z8 *>(scale));
y_.SetGlobalBuffer(reinterpret_cast<__gm__ half *>(y));
Bind(slot, 0);
pipe.InitBuffer(staging_, STAGING_BYTES);
pipe.InitBuffer(vectors_, VECTOR_BYTES);
if (BN == 64)
  pipe.InitBuffer(panel_, PANEL_BYTES);
}
__aicore__ inline void Bind(GM_ADDR slot, Z0 index) {
slotIndex_ = index;
GlobalTensor<Z7> nextA, nextB;
GlobalTensor<Z1> nextC;
nextA.SetGlobalBuffer(reinterpret_cast<__gm__ Z7 *>(slot));
nextB.SetGlobalBuffer(reinterpret_cast<__gm__ Z7 *>(slot + p_.bOffset));
nextC.SetGlobalBuffer(reinterpret_cast<__gm__ Z1 *>(slot + p_.cOffset));
a_ = nextA;
b_ = nextB;
c_ = nextC;
}
__aicore__ inline void Pack(Z0 expert, Z0 row, Z0 col, Z0 vm, Z0 vn) {
auto bytes = staging_.Get<Z7>();
const Z0 sub = GetSubBlockIdx();
const bool directA = p_.alignedA && vm == BM && p_.k == p_.kp;
const bool directB = p_.alignedB && p_.k == p_.kp && (p_.n == BN || (BN == 64 && p_.n % 64 == 0));
const bool reuseA = cachedExpert_[slotIndex_] == expert && cachedRow_[slotIndex_] == row;
const bool reuseB = cachedExpert_[slotIndex_] == expert && cachedCol_[slotIndex_] == col;
for (Z0 i = sub; !directA && !reuseA && i < BM; i += 2) {
  if (i < vm) {
    DataCopyExtParams cp{1, p_.k, 0, 0, 0};
    DataCopyPadExtParams<Z7> pad{true, 0, static_cast<Z6>(p_.kp - p_.k), 0};
    DataCopyPad(bytes, x_[static_cast<Z2>(row + i) * p_.k], cp, pad);
    Fence<HardEvent::MTE2_MTE3>();
  } else {
    Duplicate(staging_.Get<Z5>(), static_cast<Z5>(0), p_.kp / 2);
    Fence<HardEvent::V_MTE3>();
  }
  DataCopy(a_[i * p_.kp], bytes, p_.kp);
  Fence<HardEvent::MTE3_MTE2>();
  Fence<HardEvent::MTE3_V>();
}
for (Z0 k0 = sub * BK; !directB && !reuseB && k0 < p_.k; k0 += 2 * BK) {
  const Z0 rows = Min(BK, p_.kp - k0);
  const Z0 valid = Min(BK, p_.k - k0);
  Duplicate(staging_.Get<Z5>(), static_cast<Z5>(0), rows * BN / 2);
  Fence<HardEvent::V_MTE2>();
  DataCopyExtParams cp{static_cast<Z4>(valid), vn, p_.n - vn, (BN - ((vn + 31) / 32 * 32)) / 32, 0};
  DataCopyPadExtParams<Z7> pad{false, 0, 0, 0};
  DataCopyPad(bytes, w_[(static_cast<Z2>(expert) * p_.k + k0) * p_.n + col], cp, pad);
  Fence<HardEvent::MTE2_MTE3>();
  DataCopy(b_[k0 * BN], bytes, rows * BN);
  Fence<HardEvent::MTE3_V>();
  Fence<HardEvent::MTE3_MTE2>();
}
cachedExpert_[slotIndex_] = expert;
cachedRow_[slotIndex_] = row;
cachedCol_[slotIndex_] = col;
}
__aicore__ inline void Finish(Z0 expert, Z0 row, Z0 col, Z0 vm, Z0 vn) {
const Z0 sub = GetSubBlockIdx();
if (BN == 64 && vn == 64 && vm > 1) {
  auto ci = panel_.Get<Z1>();
  auto scale = panel_.Get<Z8>()[PANEL_ELEMS];
  auto out = panel_.Get<half>()[(PANEL_ELEMS * 32 + 1024) / 2];
  for (Z0 first = sub; first < vm; first += 2 * PANEL_ROWS) {
    const Z0 rows = Min(PANEL_ROWS, (vm - first + 1) / 2);
    DataCopyExtParams cc{static_cast<Z4>(rows), 256, 256, 0, 0};
    DataCopyPadExtParams<Z1> cp{false, 0, 0, 0};
    DataCopyExtParams sc{1, 256, 0, 0, 0};
    DataCopyPadExtParams<Z8> sp{false, 0, 0, 0.0f};
    DataCopyPad(ci, c_[first * BN], cc, cp);
    DataCopyPad(scale, s_[static_cast<Z2>(expert) * p_.n + col], sc, sp);
    Fence<HardEvent::MTE2_V>();
    PanelGelu(ci, scale, panel_, rows * 64);
    DataCopyExtParams oc{static_cast<Z4>(rows), 128, 0, (2 * p_.n - 64) * 2, 0};
    DataCopyPad(y_[static_cast<Z2>(row + first) * p_.n + col], out, oc);
    Fence<HardEvent::MTE3_V>();
    Fence<HardEvent::V_MTE2>();
  }
  return;
}
Z0 firstCol = (vm == 1) ? sub * ((vn + 15) / 16 / 2 * 16) : 0;
Z0 stopCol = (vm == 1 && sub == 0) ? ((vn + 15) / 16 / 2 * 16) : vn;
if (firstCol >= stopCol)
  return;
for (Z0 offset = firstCol; offset < stopCol; offset += 32) {
  FinishSegment(expert, row, col + offset, vm, Min(32, stopCol - offset), offset, vm == 1 ? 0 : sub,
                vm == 1 ? 1 : 2);
}
}
__aicore__ inline void FinishSegment(Z0 expert, Z0 row, Z0 col, Z0 vm, Z0 vn, Z0 cCol, Z0 firstRow, Z0 rowStride) {
auto ci = vectors_.Get<Z1>();
auto scale = vectors_.Get<Z8>()[64];
auto out = vectors_.Get<half>()[1152];
DataCopyExtParams sc{1, vn * 4, 0, 0, 0};
DataCopyPadExtParams<Z8> sp{true, 0, 0, 0.0f};
DataCopyPad(scale, s_[static_cast<Z2>(expert) * p_.n + col], sc, sp);
Fence<HardEvent::MTE2_V>();
for (Z0 i = firstRow; i < vm; i += rowStride) {
  if (p_.k == 1) {
    auto weights = staging_.Get<Z7>();
    auto input = weights[64];
    DataCopyExtParams wc{1, vn, 0, 0, 0}, xc{1, 1, 0, 0, 0};
    DataCopyPadExtParams<Z7> pad{false, 0, 0, 0};
    DataCopyPad(weights, w_[static_cast<Z2>(expert) * p_.n + col], wc, pad);
    DataCopyPad(input, x_[row + i], xc, pad);
    Fence<HardEvent::MTE2_S>();
    const Z1 value = static_cast<Z1>(input.GetValue(0));
    for (Z0 j = 0; j < vn; ++j)
      ci.SetValue(j, value * static_cast<Z1>(weights.GetValue(j)));
    Fence<HardEvent::S_V>();
  } else {
    DataCopyExtParams cc{1, vn * 4, 0, 0, 0};
    DataCopyPadExtParams<Z1> cp{false, 0, 0, 0};
    DataCopyPad(ci, c_[i * BN + cCol], cc, cp);
    Fence<HardEvent::MTE2_V>();
  }
  Gelu(ci, scale, vectors_, vn);
  DataCopyExtParams oc{1, vn * 2, 0, 0, 0};
  DataCopyPad(y_[static_cast<Z2>(row + i) * p_.n + col], out, oc);
  Fence<HardEvent::MTE3_V>();
  Fence<HardEvent::V_MTE2>();
}
}

private:
StageParameters p_;
Z0 slotIndex_ = 0;
Z0 cachedExpert_[2] = {~0U, ~0U}, cachedRow_[2] = {~0U, ~0U}, cachedCol_[2] = {~0U, ~0U};
TBuf<TPosition::VECCALC> staging_, vectors_, panel_;
GlobalTensor<Z7> x_, w_, a_, b_;
GlobalTensor<Z1> c_;
GlobalTensor<Z8> s_;
GlobalTensor<half> y_;
};
__aicore__ inline bool WideExpert(Z0 rows) {
return rows != 0 && (rows <= 2 || rows >= 16);
}
struct StreamParameters {
Z0 m, n, k, e, kp, workers;
Z0 alignedA, alignedB, wideAvailable;
Z2 bOffset, cOffset, slotBytes;
};
static_assert(sizeof(StreamParameters) == offsetof(Parameters, cube), "stream parameter prefix differs");
struct GeneralTask {
Z0 expert, row, col, vm, vn;
};
template <Z0 BM, Z0 BN> class GeneralTaskCursor {
public:
template <class P>
__aicore__ inline GeneralTaskCursor(const P &p, GM_ADDR groupList, Z0 worker, Z0 filter)
  : ends_(reinterpret_cast<__gm__ Z3 *>(groupList)), experts_(p.e), columns_((p.n + BN - 1) / BN), n_(p.n),
    workers_(p.workers), worker_(worker), filter_(filter) {}
__aicore__ inline bool Next(GeneralTask &out) {
while (local_ >= count_) {
  if (expert_ == experts_)
    return false;
  start_ = end_;
  end_ = static_cast<Z0>(ends_[expert_++]);
  const bool wide = WideExpert(end_ - start_);
  if ((filter_ == 1 && wide) || (filter_ == 2 && !wide))
    continue;
  count_ = static_cast<Z2>((end_ - start_ + BM - 1) / BM) * columns_;
  local_ = (worker_ + workers_ - prefix_ % workers_) % workers_;
  prefix_ += count_;
}
out.expert = expert_ - 1;
out.row = start_ + local_ / columns_ * BM;
out.col = local_ % columns_ * BN;
out.vm = Min(BM, end_ - out.row);
out.vn = Min(BN, n_ - out.col);
local_ += workers_;
return true;
}

private:
__gm__ Z3 *ends_;
Z0 experts_, columns_, n_, workers_, worker_, filter_;
Z0 expert_ = 0, start_ = 0, end_ = 0;
Z2 prefix_ = 0, local_ = 0, count_ = 0;
};
template <Z0 BM, Z0 BN, Z0 BK>
__aicore__ inline void ExecuteStream(StreamParameters &p, GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groupList,
                                 GM_ADDR y, GM_ADDR workspace, Z0 filter) {
Z0 worker = GetBlockIdx();
if ASCEND_IS_AIV {
worker /= 2;
}
if (worker >= p.workers)
return;
if ASCEND_IS_AIC {
if (p.k == 1)
  return;
}
GM_ADDR slot = workspace + ((sizeof(Parameters) + 511) / 512) * 512 + worker * p.slotBytes * SLOT_COUNT;
TPipe pipe;
TCubeTiling cube;
VectorStage<BM, BN, BK> vector;
using A = MatmulType<TPosition::GM, CubeFormat::ND, Z7>;
using B = MatmulType<TPosition::GM, CubeFormat::ND, Z7>;
using C = MatmulType<TPosition::GM, CubeFormat::ND, Z1>;
MatmulImpl<A, B, C, C, MM_CONFIG> mm;
GlobalTensor<Z7> a, b;
GlobalTensor<Z1> c;
if ASCEND_IS_AIC {
auto tilingDst = reinterpret_cast<Z0 *>(&cube);
auto tilingSrc = reinterpret_cast<__gm__ Z0 *>(
    workspace + (filter == 2 ? offsetof(Parameters, wideCube) : offsetof(Parameters, cube)));
for (Z0 i = 0; i < sizeof(TCubeTiling) / sizeof(Z0); ++i)
  tilingDst[i] = tilingSrc[i];
a.SetGlobalBuffer(reinterpret_cast<__gm__ Z7 *>(slot));
b.SetGlobalBuffer(reinterpret_cast<__gm__ Z7 *>(slot + p.bOffset));
c.SetGlobalBuffer(reinterpret_cast<__gm__ Z1 *>(slot + p.cOffset));
mm.SetSubBlockIdx(0);
mm.Init(&cube, &pipe);
if (BN == 64 && p.alignedB && p.k == p.kp && p.n % 64 == 0) {
  mm.SetOrgShape(BM, p.n, p.kp, p.kp, BN);
} else
  mm.SetOrgShape(BM, BN, p.kp);
mm.SetSingleShape(BM, BN, p.kp);
}
if ASCEND_IS_AIV {
vector.Init(pipe, p, x, weight, scale, y, slot);
}
GeneralTaskCursor<BM, BN> cursor(p, groupList, worker, filter);
GeneralTask current, next;
bool valid = cursor.Next(current);
Z2 ordinal = 0;
while (valid) {
const bool hasNext = cursor.Next(next);
const Z0 index = ordinal % SLOT_COUNT;
GM_ADDR currentSlot = slot + index * p.slotBytes;
if ASCEND_IS_AIV {
  if (p.k == 1) {
    vector.Finish(current.expert, current.row, current.col, current.vm, current.vn);
  } else {
    if (ordinal == 0) {
      vector.Bind(currentSlot, index);
      vector.Pack(current.expert, current.row, current.col, current.vm, current.vn);
      CrossCoreSetFlag<2, PIPE_MTE3>(INPUT_READY + index * 3);
    }
    if (hasNext) {
      const Z0 ni = index ^ 1;
      vector.Bind(slot + ni * p.slotBytes, ni);
      vector.Pack(next.expert, next.row, next.col, next.vm, next.vn);
      CrossCoreSetFlag<2, PIPE_MTE3>(INPUT_READY + ni * 3);
    }
    CrossCoreWaitFlag(RESULT_READY + index * 3);
    vector.Bind(currentSlot, index);
    vector.Finish(current.expert, current.row, current.col, current.vm, current.vn);
    CrossCoreSetFlag<2, PIPE_MTE3>(SLOT_FREE + index * 3);
  }
}
if ASCEND_IS_AIC {
  if (ordinal >= SLOT_COUNT)
    CrossCoreWaitFlag(SLOT_FREE + index * 3);
  CrossCoreWaitFlag(INPUT_READY + index * 3);
  a.SetGlobalBuffer(reinterpret_cast<__gm__ Z7 *>(currentSlot));
  b.SetGlobalBuffer(reinterpret_cast<__gm__ Z7 *>(currentSlot + p.bOffset));
  c.SetGlobalBuffer(reinterpret_cast<__gm__ Z1 *>(currentSlot + p.cOffset));
  GlobalTensor<Z7> sourceA = a, sourceB = b;
  if (p.alignedA && current.vm == BM && p.k == p.kp)
    sourceA.SetGlobalBuffer(reinterpret_cast<__gm__ Z7 *>(x) + static_cast<Z2>(current.row) * p.k);
  if (p.alignedB && p.k == p.kp && (p.n == BN || (BN == 64 && p.n % 64 == 0)))
    sourceB.SetGlobalBuffer(reinterpret_cast<__gm__ Z7 *>(weight) + static_cast<Z2>(current.expert) * p.k * p.n +
                            current.col);
  mm.SetTensorA(sourceA);
  mm.SetTensorB(sourceB);
  mm.IterateAll(c, 0);
  CrossCoreSetFlag<2, PIPE_FIX>(RESULT_READY + index * 3);
}
if (hasNext)
  current = next;
valid = hasNext;
++ordinal;
}
if ASCEND_IS_AIC {
if (ordinal)
  CrossCoreWaitFlag(SLOT_FREE);
if (ordinal > 1)
  CrossCoreWaitFlag(SLOT_FREE + 3);
}
if ASCEND_IS_AIC {
mm.End();
}
}
template <Z0 BM, Z0 BN, Z0 BK>
__aicore__ inline void Execute(Parameters &p, GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groupList, GM_ADDR y,
                           GM_ADDR workspace, Z0 filter) {
Z0 worker = GetBlockIdx();
if ASCEND_IS_AIV {
worker /= 2;
}
if (worker >= p.workers)
return;
if ASCEND_IS_AIC {
if (p.k == 1)
  return;
}
GM_ADDR slot = workspace + ((sizeof(Parameters) + 511) / 512) * 512 + worker * p.slotBytes * SLOT_COUNT;
TPipe pipe;
VectorStage<BM, BN, BK> vector;
using A = MatmulType<TPosition::GM, CubeFormat::ND, Z7>;
using B = MatmulType<TPosition::GM, CubeFormat::ND, Z7>;
using C = MatmulType<TPosition::GM, CubeFormat::ND, Z1>;
MatmulImpl<A, B, C, C, MM_CONFIG> mm;
GlobalTensor<Z7> a, b;
GlobalTensor<Z1> c;
if ASCEND_IS_AIC {
auto tilingDst = reinterpret_cast<Z0 *>(&p.cube);
auto tilingSrc = reinterpret_cast<__gm__ Z0 *>(
    workspace + (filter == 2 ? offsetof(Parameters, wideCube) : offsetof(Parameters, cube)));
for (Z0 i = 0; i < sizeof(TCubeTiling) / sizeof(Z0); ++i)
  tilingDst[i] = tilingSrc[i];
a.SetGlobalBuffer(reinterpret_cast<__gm__ Z7 *>(slot));
b.SetGlobalBuffer(reinterpret_cast<__gm__ Z7 *>(slot + p.bOffset));
c.SetGlobalBuffer(reinterpret_cast<__gm__ Z1 *>(slot + p.cOffset));
mm.SetSubBlockIdx(0);
mm.Init(&p.cube, &pipe);
if (BN == 64 && p.alignedB && p.k == p.kp && p.n % 64 == 0) {
  mm.SetOrgShape(BM, p.n, p.kp, p.kp, BN);
} else
  mm.SetOrgShape(BM, BN, p.kp);
mm.SetSingleShape(BM, BN, p.kp);
}
if ASCEND_IS_AIV {
vector.Init(pipe, p, x, weight, scale, y, slot);
}
Z2 task = 0;
Z3 start = 0;
const auto ends = reinterpret_cast<__gm__ Z3 *>(groupList);
for (Z0 expert = 0; expert < p.e; ++expert) {
Z3 end = ends[expert];
const bool wide = WideExpert(static_cast<Z0>(end - start));
if ((filter == 1 && wide) || (filter == 2 && !wide)) {
  start = end;
  continue;
}
const Z0 columns = (p.n + BN - 1) / BN;
const Z2 count = ((end - start + BM - 1) / BM) * columns;
const Z2 first = (worker + p.workers - task % p.workers) % p.workers;
const Z0 step = p.workers;
const bool pipeline = first < count && count - first > step;
for (Z2 local = first; local < count; local += step) {
  const Z0 row = static_cast<Z0>(start) + local / columns * BM;
  const Z0 col = local % columns * BN;
  const Z0 vm = Min(BM, static_cast<Z0>(end - row));
  Z0 vn = Min(BN, p.n - col);
  const Z0 index = pipeline ? ((local - first) / step) % 2 : 0;
  GM_ADDR currentSlot = slot + index * p.slotBytes;
  if ASCEND_IS_AIV {
    if (p.k == 1) {
      vector.Finish(expert, row, col, vm, vn);
      continue;
    }
    if (!pipeline || local == first) {
      vector.Bind(currentSlot, index);
      vector.Pack(expert, row, col, vm, vn);
      CrossCoreSetFlag<2, PIPE_MTE3>(INPUT_READY + index * 3);
    }
    if (pipeline && local + step < count) {
      const Z2 next = local + step;
      const Z0 nr = static_cast<Z0>(start) + next / columns * BM;
      const Z0 nc = next % columns * BN, ni = index ^ 1;
      vector.Bind(slot + ni * p.slotBytes, ni);
      vector.Pack(expert, nr, nc, Min(BM, static_cast<Z0>(end - nr)), Min(BN, p.n - nc));
      CrossCoreSetFlag<2, PIPE_MTE3>(INPUT_READY + ni * 3);
    }
    CrossCoreWaitFlag(RESULT_READY + index * 3);
    vector.Bind(currentSlot, index);
    vector.Finish(expert, row, col, vm, vn);
    CrossCoreSetFlag<2, PIPE_MTE3>(SLOT_FREE + index * 3);
  }
  if ASCEND_IS_AIC {
    if (pipeline && local >= first + 2 * step)
      CrossCoreWaitFlag(SLOT_FREE + index * 3);
    CrossCoreWaitFlag(INPUT_READY + index * 3);
    a.SetGlobalBuffer(reinterpret_cast<__gm__ Z7 *>(currentSlot));
    b.SetGlobalBuffer(reinterpret_cast<__gm__ Z7 *>(currentSlot + p.bOffset));
    c.SetGlobalBuffer(reinterpret_cast<__gm__ Z1 *>(currentSlot + p.cOffset));
    GlobalTensor<Z7> sourceA = a, sourceB = b;
    if (p.alignedA && vm == BM && p.k == p.kp)
      sourceA.SetGlobalBuffer(reinterpret_cast<__gm__ Z7 *>(x) + static_cast<Z2>(row) * p.k);
    if (p.alignedB && p.k == p.kp && (p.n == BN || (BN == 64 && p.n % 64 == 0)))
      sourceB.SetGlobalBuffer(reinterpret_cast<__gm__ Z7 *>(weight) + static_cast<Z2>(expert) * p.k * p.n + col);
    mm.SetTensorA(sourceA);
    mm.SetTensorB(sourceB);
    mm.IterateAll(c, 0);
    CrossCoreSetFlag<2, PIPE_FIX>(RESULT_READY + index * 3);
    if (!pipeline)
      CrossCoreWaitFlag(SLOT_FREE);
  }
}
if ASCEND_IS_AIC {
  if (pipeline) {
    const Z2 owned = (count - first + step - 1) / step;
    CrossCoreWaitFlag(SLOT_FREE);
    if (owned > 1)
      CrossCoreWaitFlag(SLOT_FREE + 3);
  }
}
task += count;
start = end;
}
if ASCEND_IS_AIC {
mm.End();
}
}
__global__ __mix__(1, 2) void Kernel(GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groupList, GM_ADDR y,
                                 GM_ADDR workspace) {
Parameters p;
auto dst = reinterpret_cast<Z0 *>(&p);
auto src = reinterpret_cast<__gm__ Z0 *>(workspace);
for (Z0 i = 0; i < offsetof(Parameters, cube) / sizeof(Z0); ++i)
dst[i] = src[i];
if (p.wideAvailable) {
const auto ends = reinterpret_cast<__gm__ Z3 *>(groupList);
Z0 previous = 0;
Z2 wideTasks = 0;
bool baseNeeded = false;
for (Z0 e = 0; e < p.e; ++e) {
  const Z0 end = static_cast<Z0>(ends[e]), rows = end - previous;
  if (WideExpert(rows))
    wideTasks += static_cast<Z2>((rows + 31) / 32) * ((p.n + 63) / 64);
  else if (rows)
    baseNeeded = true;
  previous = end;
}
if (wideTasks >= (p.workers + 1) / 2) {
  if (baseNeeded)
    Execute<16, 32, 1024>(p, x, weight, scale, groupList, y, workspace, 1);
  p.bOffset = (32ULL * p.kp + 511) / 512 * 512;
  p.cOffset = (p.bOffset + 64ULL * p.kp + 511) / 512 * 512;
  Execute<32, 64, 512>(p, x, weight, scale, groupList, y, workspace, 2);
  return;
}
}
Execute<BM, BN, BK>(p, x, weight, scale, groupList, y, workspace, 0);
}
__global__ __mix__(1, 2) void StreamKernel(GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groupList, GM_ADDR y,
                                       GM_ADDR workspace) {
StreamParameters p;
auto dst = reinterpret_cast<Z0 *>(&p);
auto src = reinterpret_cast<__gm__ Z0 *>(workspace);
for (Z0 i = 0; i < sizeof(StreamParameters) / sizeof(Z0); ++i)
dst[i] = src[i];
if (p.wideAvailable) {
const auto ends = reinterpret_cast<__gm__ Z3 *>(groupList);
Z0 previous = 0;
Z2 wideTasks = 0;
bool baseNeeded = false;
for (Z0 e = 0; e < p.e; ++e) {
  const Z0 end = static_cast<Z0>(ends[e]), rows = end - previous;
  if (WideExpert(rows))
    wideTasks += static_cast<Z2>((rows + 31) / 32) * ((p.n + 63) / 64);
  else if (rows)
    baseNeeded = true;
  previous = end;
}
if (wideTasks >= (p.workers + 1) / 2) {
  if (baseNeeded)
    ExecuteStream<16, 32, 1024>(p, x, weight, scale, groupList, y, workspace, 1);
  p.bOffset = (32ULL * p.kp + 511) / 512 * 512;
  p.cOffset = (p.bOffset + 64ULL * p.kp + 511) / 512 * 512;
  ExecuteStream<32, 64, 512>(p, x, weight, scale, groupList, y, workspace, 2);
  return;
}
}
ExecuteStream<BM, BN, BK>(p, x, weight, scale, groupList, y, workspace, 0);
}
} // namespace gmg
static void RunGeneral(GM_ADDR x, const TensorGroupInfo &info_x, GM_ADDR weight, const TensorGroupInfo &info_weight,
                   GM_ADDR scale, const TensorGroupInfo &info_scale, GM_ADDR group_list,
                   const TensorGroupInfo &info_group_list, GM_ADDR y, const TensorGroupInfo &info_y,
                   Z3 availableCoreNum, aclrtStream stream) {
using namespace gmg;
const auto xShape = info_x.tensors[0].shape;
const auto wShape = info_weight.tensors[0].shape;
const Z3 m = xShape[0], k = xShape[1], e = wShape[0], n = wShape[2];
auto platform = platform_ascendc::PlatformAscendCManager::GetInstance();
if (!platform)
return;
Z0 workers = std::min<Z2>(availableCoreNum, platform->GetCoreNumAic());
workers = std::min(workers, platform->GetCoreNumAiv() / 2);
if (!workers)
return;
Z2 ub = 0;
platform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ub);
if (e <= 4 && m <= 8 && n <= 8 && k <= 8) {
if (ub < TINY_IO_BYTES + VECTOR_BYTES)
  return;
if (k == 3) {
  const Z0 blocks = (m * n + n - 1) / n;
  {
    const Z0 use = blocks <= platform->GetCoreNumAiv() && blocks <= static_cast<Z0>(availableCoreNum) ? blocks : 1;
    ShortPanelKernel<<<use, nullptr, stream>>>(x, weight, scale, group_list, y, e, m, k, n);
    aclrtSynchronizeStream(stream);
    return;
  }
}
TinyKernel<<<1, nullptr, stream>>>(x, weight, scale, group_list, y, e, m, k, n);
aclrtSynchronizeStream(stream);
return;
}
Z2 l1 = 0, l0a = 0, l0b = 0, l0c = 0;
platform->GetCoreMemSize(platform_ascendc::CoreMemType::L1, l1);
platform->GetCoreMemSize(platform_ascendc::CoreMemType::L0_A, l0a);
platform->GetCoreMemSize(platform_ascendc::CoreMemType::L0_B, l0b);
platform->GetCoreMemSize(platform_ascendc::CoreMemType::L0_C, l0c);
Parameters p{};
p.m = m;
p.n = n;
p.k = k;
p.e = e;
p.kp = (k + 31) / 32 * 32;
p.alignedA = (reinterpret_cast<uintptr_t>(x) & 31U) == 0;
p.alignedB = (reinterpret_cast<uintptr_t>(weight) & 31U) == 0;
p.workers = workers;
if (ub < STAGING_BYTES + VECTOR_BYTES || l0a < BM * BK || l0b < BK * BN || l0c < BM * BN * 4)
return;
p.bOffset = (BM * p.kp + 511) / 512 * 512;
p.cOffset = (p.bOffset + p.kp * BN + 511) / 512 * 512;
p.slotBytes = (p.cOffset + BM * BN * 4 + 511) / 512 * 512;
matmul_tiling::MatmulApiTiling tiler(*platform);
host_workspace::SetInt8Operands(tiler);
tiler.SetShape(BM, BN, 8192);
tiler.SetOrgShape(BM, BN, 8192);
tiler.SetFixSplit(BM, BN, BK);
tiler.SetBufferSpace(l1, l0c, ub);
if (tiler.GetTiling(p.cube) != 0 || p.cube.baseM != BM || p.cube.baseN != BN || p.cube.baseK != BK ||
  p.cube.shareL1Size > l1 || p.cube.shareL0CSize > l0c || p.cube.shareUbSize > ub)
return;
if (n >= 64 && k >= 32 && ((n % 64 == 0 && k % 32 == 0) || (m >= 32 && n >= 128)) && l0a >= 32 * 512 &&
  l0b >= 512 * 64 && l0c >= 32 * 64 * 4 && ub >= 32768 + VECTOR_BYTES + PANEL_BYTES) {
tiler.SetShape(32, 64, 8192);
tiler.SetOrgShape(32, 64, 8192);
tiler.SetFixSplit(32, 64, 512);
if (tiler.GetTiling(p.wideCube) == 0 && p.wideCube.baseM == 32 && p.wideCube.baseN == 64 &&
    p.wideCube.baseK == 512 && p.wideCube.shareL1Size <= l1 && p.wideCube.shareL0CSize <= l0c &&
    p.wideCube.shareUbSize <= ub) {
  p.wideAvailable = 1;
  const Z2 wideB = (32ULL * p.kp + 511) / 512 * 512;
  const Z2 wideC = (wideB + 64ULL * p.kp + 511) / 512 * 512;
  p.slotBytes = std::max(p.slotBytes, (wideC + 32 * 64 * 4 + 511) / 512 * 512);
}
}
const Z2 bytes = ((sizeof(Parameters) + 511) / 512) * 512 + p.workers * p.slotBytes * SLOT_COUNT;
host_workspace::Parameters workspace;
if (!workspace.Prepare(bytes, p))
return;
const Z2 minTasks = static_cast<Z2>((m + 31) / 32) * ((n + 63) / 64);
if (p.wideAvailable && minTasks > p.workers)
StreamKernel<<<p.workers, nullptr, stream>>>(x, weight, scale, group_list, y, workspace.Data());
else
Kernel<<<p.workers, nullptr, stream>>>(x, weight, scale, group_list, y, workspace.Data());
workspace.Retire(stream);
}
namespace dense {
using namespace AscendC;
using gmg::Fence;
using gmg::Min;
constexpr Z0 BM = 64, BN = 256, BK = 128, PR = 32, PE = PR * BN;
constexpr Z0 MASK_BYTES = (PE / 8 + 255) / 256 * 256;
constexpr Z0 SP = PE + 64;
constexpr Z0 PANEL_BYTES = SP * 20 + 32 + BN * 4 + 4 * MASK_BYTES + PE * 2;
constexpr Z0 C_BYTES = BM * BN * 4;
constexpr Z4 READY = 9, FREE = 10;
struct Parameters {
Z0 m, n, k, e, workers, native;
TCubeTiling cube;
};
template <Z0 PE, Z0 COLS>
__aicore__ inline void PanelGelu(LocalTensor<Z1> ci, LocalTensor<Z8> scale, TBuf<TPosition::VECCALC> &vectors_,
                             Z0 count, Z0 &slowRepairs) {
constexpr Z0 MASK_BYTES = (PE / 8 + 255) / 256 * 256;
constexpr Z0 SP = PE + 64;
auto u = vectors_.Get<Z8>();
auto z = vectors_.Get<Z8>()[SP];
auto t = vectors_.Get<Z8>()[2 * SP];
auto result = t;
auto den = vectors_.Get<Z8>()[3 * SP];
auto neg = vectors_.Get<Z8>()[4 * SP + 8];
auto mask = vectors_.Get<Z6>()[SP * 20 + 32 + COLS * 4];
auto out = vectors_.Get<half>()[(SP * 20 + 32 + COLS * 4 + 4 * MASK_BYTES) / 2];
Cast(z, ci, RoundMode::CAST_RINT, count);
PipeBarrier<PIPE_V>();
for (Z0 col = 0; col < COLS; col += 64)
Mul(z[col], z[col], scale[col], 64, static_cast<Z6>(count / COLS),
    BinaryRepeatParams(1, 1, 1, COLS / 8, COLS / 8, 0));
PipeBarrier<PIPE_V>();
Mul(u, z, z, count);
PipeBarrier<PIPE_V>();
Duplicate(t, -1.5957691216057308f, count);
PipeBarrier<PIPE_V>();
Axpy(t, u, -0.071354816275f, count);
PipeBarrier<PIPE_V>();
Abs(u, z, count);
PipeBarrier<PIPE_V>();
Mul(t, t, u, count);
PipeBarrier<PIPE_V>();
CompareScalar(mask, z, 0.0f, CMPMODE::GE, count);
Exp(t, t, count);
PipeBarrier<PIPE_V>();
Adds(den, t, 1.0f, count);
Mul(neg, z, t, count);
PipeBarrier<PIPE_V>();
Div(neg, neg, den, count);
PipeBarrier<PIPE_V>();
Sub(u, z, neg, count);
PipeBarrier<PIPE_V>();
Sub(den, z, u, count);
PipeBarrier<PIPE_V>();
Sub(den, den, neg, count);
PipeBarrier<PIPE_V>();
Select(result, mask, u, neg, SELMODE::VSEL_TENSOR_TENSOR_MODE, count);
PipeBarrier<PIPE_V>();
auto bits = result.ReinterpretCast<Z1>();
auto work = z.ReinterpretCast<Z1>();
auto constant = u.ReinterpretCast<Z1>();
auto mid = vectors_.Get<Z6>()[SP * 20 + 32 + COLS * 4 + 1 * MASK_BYTES];
auto exponent = vectors_.Get<Z6>()[SP * 20 + 32 + COLS * 4 + 2 * MASK_BYTES];
auto residual = vectors_.Get<Z6>()[SP * 20 + 32 + COLS * 4 + 3 * MASK_BYTES];
Duplicate(constant, static_cast<Z1>(0x1fff), count);
PipeBarrier<PIPE_V>();
And(work.ReinterpretCast<Z4>(), bits.ReinterpretCast<Z4>(), constant.ReinterpretCast<Z4>(), 2 * count);
PipeBarrier<PIPE_V>();
CompareScalar(mid, work, static_cast<Z1>(0x1000), CMPMODE::EQ, count);
PipeBarrier<PIPE_V>();
And(mask.ReinterpretCast<Z4>(), mask.ReinterpretCast<Z4>(), mid.ReinterpretCast<Z4>(), count / 16);
PipeBarrier<PIPE_V>();
if (slowRepairs < 2) {
CompareScalar(residual, den, 0.0f, CMPMODE::NE, count);
PipeBarrier<PIPE_V>();
And(residual.ReinterpretCast<Z4>(), residual.ReinterpretCast<Z4>(), mask.ReinterpretCast<Z4>(), count / 16);
PipeBarrier<PIPE_V>();
auto words = work.ReinterpretCast<Z8>();
Cast(words, residual.ReinterpretCast<Z1>(), RoundMode::CAST_RINT, count / 32);
PipeBarrier<PIPE_V>();
Abs(words, words, count / 32);
PipeBarrier<PIPE_V>();
ReduceMax(neg, words, u, count / 32, false);
Fence<HardEvent::V_S>();
const bool needsRepair = neg.GetValue(0) != 0.0f;
Fence<HardEvent::S_V>();
if (!needsRepair) {
  slowRepairs = 0;
  Cast(out, result, RoundMode::CAST_RINT, count);
  Fence<HardEvent::V_MTE3>();
  return;
}
++slowRepairs;
}
Cast(work.ReinterpretCast<Z8>(), bits, RoundMode::CAST_RINT, count);
PipeBarrier<PIPE_V>();
CompareScalar(exponent, work.ReinterpretCast<Z8>(), static_cast<Z8>(0x38800000), CMPMODE::GE, count);
PipeBarrier<PIPE_V>();
And(mask.ReinterpretCast<Z4>(), mask.ReinterpretCast<Z4>(), exponent.ReinterpretCast<Z4>(), count / 16);
PipeBarrier<PIPE_V>();
CompareScalar(residual, den, 0.0f, CMPMODE::GT, count);
PipeBarrier<PIPE_V>();
And(residual.ReinterpretCast<Z4>(), residual.ReinterpretCast<Z4>(), mask.ReinterpretCast<Z4>(), count / 16);
PipeBarrier<PIPE_V>();
Adds(work, bits, static_cast<Z1>(1), count);
PipeBarrier<PIPE_V>();
Select(result, residual, work.ReinterpretCast<Z8>(), result, SELMODE::VSEL_TENSOR_TENSOR_MODE, count);
PipeBarrier<PIPE_V>();
CompareScalar(residual, den, 0.0f, CMPMODE::LT, count);
PipeBarrier<PIPE_V>();
And(residual.ReinterpretCast<Z4>(), residual.ReinterpretCast<Z4>(), mask.ReinterpretCast<Z4>(), count / 16);
PipeBarrier<PIPE_V>();
Adds(work, bits, static_cast<Z1>(-1), count);
PipeBarrier<PIPE_V>();
Select(result, residual, work.ReinterpretCast<Z8>(), result, SELMODE::VSEL_TENSOR_TENSOR_MODE, count);
PipeBarrier<PIPE_V>();
Cast(out, result, RoundMode::CAST_RINT, count);
Fence<HardEvent::V_MTE3>();
}
class Finish {
Z0 slowRepairs_ = 0;
TBuf<TPosition::VECCALC> panel_;
GlobalTensor<Z8> scale_;
GlobalTensor<half> y_;

public:
__aicore__ inline void Init(TPipe &pipe, GM_ADDR scale, GM_ADDR y) {
pipe.InitBuffer(panel_, PANEL_BYTES);
scale_.SetGlobalBuffer(reinterpret_cast<__gm__ Z8 *>(scale));
y_.SetGlobalBuffer(reinterpret_cast<__gm__ half *>(y));
}
template <class P> __aicore__ inline void Run(const P &p, GM_ADDR slot, Z0 expert, Z0 row, Z0 col, Z0 vm) {
GlobalTensor<Z1> c;
c.SetGlobalBuffer(reinterpret_cast<__gm__ Z1 *>(slot));
auto ci = panel_.Get<Z1>();
auto scale = panel_.Get<Z8>()[5 * SP + 8];
auto out = panel_.Get<half>()[(SP * 20 + 32 + BN * 4 + 4 * MASK_BYTES) / 2];
const Z0 first = GetSubBlockIdx();
if (first >= vm)
  return;
const Z0 rows = Min(PR, (vm - first + 1) / 2);
DataCopyExtParams cp{static_cast<Z4>(rows), BN * 4, BN * 4, 0, 0};
DataCopyPadExtParams<Z1> pad{false, 0, 0, 0};
DataCopyPad(ci, c[first * BN], cp, pad);
DataCopyExtParams sp{1, BN * 4, 0, 0, 0};
DataCopyPadExtParams<Z8> sf{false, 0, 0, 0};
DataCopyPad(scale, scale_[static_cast<Z2>(expert) * p.n + col], sp, sf);
Fence<HardEvent::MTE2_V>();
PanelGelu<PE, BN>(ci, scale, panel_, rows * BN, slowRepairs_);
DataCopyExtParams yp{static_cast<Z4>(rows), BN * 2, 0, (2 * p.n - BN) * 2, 0};
DataCopyPad(y_[static_cast<Z2>(row + first) * p.n + col], out, yp);
Fence<HardEvent::MTE3_MTE2>();
}
};
class NativeCube {
TQue<TPosition::A1, 2> a1_;
TQue<TPosition::B1, 1> b1_;
TQue<TPosition::A2, 2> a2_;
TQue<TPosition::B2, 2> b2_;
TQue<TPosition::CO1, 2> c1_;
LocalTensor<Z7> bFull_;

public:
__aicore__ inline void Init(TPipe &pipe) {
pipe.InitBuffer(a1_, 2, BM * 1024);
pipe.InitBuffer(b1_, 1, 1024 * BN);
pipe.InitBuffer(a2_, 2, BM * BK);
pipe.InitBuffer(b2_, 2, BK * BN);
pipe.InitBuffer(c1_, 2, C_BYTES);
}
__aicore__ inline void Begin(GlobalTensor<Z7> &a, GlobalTensor<Z7> &b, Z0 vm, Z0 pitch) {
auto first = a1_.AllocTensor<Z7>();
DataCopy(first, a, Nd2NzParams(1, static_cast<Z4>(Min(BM, vm)), 1024, 0, 1024, BM, 1, 0));
a1_.EnQue(first);
auto panel = b1_.AllocTensor<Z7>();
DataCopy(panel, b, Nd2NzParams(1, 1024, BN, 0, static_cast<Z4>(pitch), 1024, 1, 0));
b1_.EnQue(panel);
if (vm > BM) {
  auto second = a1_.AllocTensor<Z7>();
  DataCopy(second, a[static_cast<Z2>(BM) * 1024],
           Nd2NzParams(1, static_cast<Z4>(vm - BM), 1024, 0, 1024, BM, 1, 0));
  a1_.EnQue(second);
}
bFull_ = b1_.DeQue<Z7>();
Z6 padding[4] = {0, 0, 0, 0};
Load3DSetFMatrixCal(1, BM, padding);
}
__aicore__ inline void Part(GlobalTensor<Z1> &c, Z0 vm) {
auto a1 = a1_.DeQue<Z7>();
auto c1 = c1_.AllocTensor<Z1>();
const Z0 mAligned = (vm + 15) / 16 * 16;
for (Z0 k0 = 0; k0 < 1024; k0 += BK) {
  auto a2 = a2_.AllocTensor<Z7>();
  auto b2 = b2_.AllocTensor<Z7>();
  LoadData3DParamsV2Pro ap;
  ap.channelSize = 1024;
  ap.extConfig = (static_cast<Z2>(k0) << 32) | (static_cast<Z2>(mAligned) << 16) | BK;
  LoadData(a2, a1, ap);
  LoadData2dTransposeParams bp{0, static_cast<Z6>(BN / 32), 1024 / 32, 1, 0, inc};
  for (Z0 kb = 0; kb < BK / 32; ++kb)
    LoadDataWithTranspose(b2[kb * BN * 32], bFull_[k0 * 32 + kb * 1024], bp);
  a2_.EnQue(a2);
  b2_.EnQue(b2);
  auto ar = a2_.DeQue<Z7>();
  auto br = b2_.DeQue<Z7>();
  MmadParams mp;
  mp.m = static_cast<Z4>(mAligned);
  mp.n = BN;
  mp.k = BK;
  mp.isBias = false;
  mp.cmatrixInitVal = (k0 == 0);
  Mmad(c1, ar, br, mp);
  a2_.FreeTensor(ar);
  b2_.FreeTensor(br);
}
c1_.EnQue(c1);
auto cr = c1_.DeQue<Z1>();
FixpipeParamsV220 fp;
fp.nSize = BN;
fp.mSize = static_cast<Z4>(vm);
fp.srcStride = static_cast<Z4>(mAligned);
fp.dstStride = BN;
fp.quantPre = QuantMode_t::NoQuant;
fp.reluEn = false;
Fixpipe<Z1, Z1, CFG_ROW_MAJOR>(c, cr, fp);
c1_.FreeTensor(cr);
a1_.FreeTensor(a1);
}
__aicore__ inline void End() {
b1_.FreeTensor(bFull_);
}
};
__global__ __mix__(1, 2) void Kernel(GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groups, GM_ADDR y,
                                 GM_ADDR workspace) {
Parameters p;
auto dst = reinterpret_cast<Z0 *>(&p);
auto src = reinterpret_cast<__gm__ Z0 *>(workspace);
for (Z0 i = 0; i < offsetof(Parameters, cube) / 4; ++i)
dst[i] = src[i];
Z0 worker = GetBlockIdx();
if ASCEND_IS_AIV {
worker /= 2;
}
const auto ends = reinterpret_cast<__gm__ Z3 *>(groups);
const Z0 columns = p.n / BN;
constexpr Z0 TASK_M = 2 * BM, MAX_TAILS = 16;
struct Tail {
Z0 expert, row, rows;
};
Tail tails[MAX_TAILS];
Z0 previous = 0, singles = 0, bundles = 0, fullTasks = 0, tailCount = 0;
for (Z0 e = 0; e < p.e; ++e) {
const Z0 end = static_cast<Z0>(ends[e]), rows = end - previous;
singles += (rows + BM - 1) / BM * columns;
bundles += (rows + TASK_M - 1) / TASK_M * columns;
fullTasks += rows / TASK_M * columns;
const Z0 rest = rows % TASK_M;
if (p.native && p.e <= MAX_TAILS && rest) {
  Tail item{e, end - rest, rest};
  Z0 at = tailCount++;
  while (at && tails[at - 1].rows < rest) {
    tails[at] = tails[at - 1];
    --at;
  }
  tails[at] = item;
}
previous = end;
}
p.native = p.native && 4 * bundles <= 3 * singles;
const Z0 tileM = p.native ? TASK_M : BM, total = p.native ? bundles : singles;
const bool orderTail = p.native && p.e <= MAX_TAILS && tailCount && total > p.workers && total <= 4 * p.workers;
TPipe pipe;
Finish finish;
NativeCube native;
using A = MatmulType<TPosition::GM, CubeFormat::ND, Z7>;
using B = MatmulType<TPosition::GM, CubeFormat::ND, Z7>;
using C = MatmulType<TPosition::GM, CubeFormat::ND, Z1>;
MatmulImpl<A, B, C, C, gmg::MM_CONFIG> mm;
if ASCEND_IS_AIC {
if (p.native)
  native.Init(pipe);
else {
  auto cube = reinterpret_cast<Z0 *>(&p.cube);
  auto gm = reinterpret_cast<__gm__ Z0 *>(workspace + offsetof(Parameters, cube));
  for (Z0 i = 0; i < sizeof(TCubeTiling) / 4; ++i)
    cube[i] = gm[i];
  mm.SetSubBlockIdx(0);
  mm.Init(&p.cube, &pipe);
  mm.SetOrgShape(BM, p.n, p.k, p.k, BN);
}
}
if ASCEND_IS_AIV {
finish.Init(pipe, scale, y);
}
GM_ADDR slots = workspace + (sizeof(Parameters) + 511) / 512 * 512 + worker * 2ULL * C_BYTES;
Z0 expert = 0, start = 0, prefix = 0, ordinal = 0;
for (Z0 wave = 0; wave * p.workers < total; ++wave) {
const bool reverse = orderTail && (wave & 1);
const Z0 task = wave * p.workers + (reverse ? p.workers - 1 - worker : worker);
if (task >= total)
  continue;
Z0 row, col, vm;
if (orderTail && task >= fullTasks) {
  const Z0 local = task - fullTasks;
  const Tail item = tails[local / columns];
  expert = item.expert;
  row = item.row;
  vm = item.rows;
  col = local % columns * BN;
} else {
  Z0 end = static_cast<Z0>(ends[expert]);
  Z0 count = (orderTail ? (end - start) / TASK_M : (end - start + tileM - 1) / tileM) * columns;
  while (task >= prefix + count) {
    prefix += count;
    start = end;
    ++expert;
    end = static_cast<Z0>(ends[expert]);
    count = (orderTail ? (end - start) / TASK_M : (end - start + tileM - 1) / tileM) * columns;
  }
  const Z0 local = task - prefix;
  row = start + local / columns * tileM;
  col = local % columns * BN;
  vm = orderTail ? TASK_M : Min(tileM, end - row);
}
if ASCEND_IS_AIC {
  if (p.native) {
    GlobalTensor<Z7> a, b;
    a.SetGlobalBuffer(reinterpret_cast<__gm__ Z7 *>(x) + static_cast<Z2>(row) * p.k);
    b.SetGlobalBuffer(reinterpret_cast<__gm__ Z7 *>(weight) + static_cast<Z2>(expert) * p.k * p.n + col);
    native.Begin(a, b, vm, p.n);
  }
}
for (Z0 off = 0; off < vm; off += BM, ++ordinal) {
  const Z0 part = Min(BM, vm - off), index = ordinal % 2;
  GM_ADDR slot = slots + index * C_BYTES;
  if ASCEND_IS_AIC {
    if (ordinal >= 2)
      CrossCoreWaitFlag(FREE + index * 3);
    GlobalTensor<Z1> c;
    c.SetGlobalBuffer(reinterpret_cast<__gm__ Z1 *>(slot));
    if (p.native)
      native.Part(c, part);
    else {
      GlobalTensor<Z7> a, b;
      a.SetGlobalBuffer(reinterpret_cast<__gm__ Z7 *>(x) + static_cast<Z2>(row + off) * p.k);
      b.SetGlobalBuffer(reinterpret_cast<__gm__ Z7 *>(weight) + static_cast<Z2>(expert) * p.k * p.n + col);
      mm.SetSingleShape(part, BN, p.k);
      mm.SetTensorA(a);
      mm.SetTensorB(b);
      mm.IterateAll(c, 0);
    }
    CrossCoreSetFlag<2, PIPE_FIX>(READY + index * 3);
  }
  if ASCEND_IS_AIV {
    CrossCoreWaitFlag(READY + index * 3);
    finish.Run(p, slot, expert, row + off, col, part);
    CrossCoreSetFlag<2, PIPE_MTE3>(FREE + index * 3);
  }
}
if ASCEND_IS_AIC {
  if (p.native)
    native.End();
}
}
if ASCEND_IS_AIC {
if (ordinal)
  CrossCoreWaitFlag(FREE);
if (ordinal > 1)
  CrossCoreWaitFlag(FREE + 3);
if (!p.native)
  mm.End();
}
}
} // namespace dense
namespace shortk {
using namespace AscendC;
using gmg::Min;
using gmg::Fence;
constexpr Z0 BM = dense::BM, BN = dense::BN, BK = dense::BK, MAX_K = 512;
constexpr Z0 C_BYTES = BM * BN * 4;
constexpr Z4 READY = 9, FREE = 10;
struct Parameters {
Z0 m, n, k, e, workers, descriptorBytes;
};
class Cube {
TQue<TPosition::A1, 1> a1_;
TQue<TPosition::B1, 1> b1_;
TQue<TPosition::A2, 2> a2_;
TQue<TPosition::B2, 2> b2_;
TQue<TPosition::CO1, 1> c1_;
LocalTensor<Z7> bFull_;

public:
__aicore__ inline void Init(TPipe &pipe) {
pipe.InitBuffer(a1_, 1, BM * MAX_K);
pipe.InitBuffer(b1_, 1, MAX_K * BN);
pipe.InitBuffer(a2_, 2, BM * BK);
pipe.InitBuffer(b2_, 2, BK * BN);
pipe.InitBuffer(c1_, 1, C_BYTES);
}
__aicore__ inline void Begin(GlobalTensor<Z7> &a, GlobalTensor<Z7> &b, Z0 vm, Z0 pitch, Z0 k) {
auto first = a1_.AllocTensor<Z7>();
DataCopy(first, a, Nd2NzParams(1, static_cast<Z4>(vm), static_cast<Z4>(k), 0, static_cast<Z4>(k), BM, 1, 0));
a1_.EnQue(first);
auto panel = b1_.AllocTensor<Z7>();
DataCopy(panel, b, Nd2NzParams(1, static_cast<Z4>(k), BN, 0, static_cast<Z4>(pitch), static_cast<Z4>(k), 1, 0));
b1_.EnQue(panel);
bFull_ = b1_.DeQue<Z7>();
Z6 padding[4] = {0, 0, 0, 0};
Load3DSetFMatrixCal(1, BM, padding);
}
__aicore__ inline void Part(GlobalTensor<Z1> &c, Z0 vm, Z0 k) {
auto a1 = a1_.DeQue<Z7>();
auto c1 = c1_.AllocTensor<Z1>();
const Z0 mAligned = (vm + 15) / 16 * 16;
for (Z0 k0 = 0; k0 < k; k0 += BK) {
  auto a2 = a2_.AllocTensor<Z7>();
  auto b2 = b2_.AllocTensor<Z7>();
  LoadData3DParamsV2Pro ap;
  ap.channelSize = k;
  ap.extConfig = (static_cast<Z2>(k0) << 32) | (static_cast<Z2>(mAligned) << 16) | BK;
  LoadData(a2, a1, ap);
  LoadData2dTransposeParams bp{0, static_cast<Z6>(BN / 32), static_cast<Z4>(k / 32), 1, 0, inc};
  for (Z0 kb = 0; kb < BK / 32; ++kb)
    LoadDataWithTranspose(b2[kb * BN * 32], bFull_[k0 * 32 + kb * 1024], bp);
  a2_.EnQue(a2);
  b2_.EnQue(b2);
  auto ar = a2_.DeQue<Z7>();
  auto br = b2_.DeQue<Z7>();
  MmadParams mp;
  mp.m = static_cast<Z4>(mAligned);
  mp.n = BN;
  mp.k = BK;
  mp.isBias = false;
  mp.cmatrixInitVal = (k0 == 0);
  Mmad(c1, ar, br, mp);
  a2_.FreeTensor(ar);
  b2_.FreeTensor(br);
}
c1_.EnQue(c1);
auto cr = c1_.DeQue<Z1>();
FixpipeParamsV220 fp;
fp.nSize = BN;
fp.mSize = static_cast<Z4>(vm);
fp.srcStride = static_cast<Z4>(mAligned);
fp.dstStride = BN;
fp.quantPre = QuantMode_t::NoQuant;
fp.reluEn = false;
Fixpipe<Z1, Z1, CFG_ROW_MAJOR>(c, cr, fp);
c1_.FreeTensor(cr);
a1_.FreeTensor(a1);
}
__aicore__ inline void End() {
b1_.FreeTensor(bFull_);
}
};
__global__ __mix__(1, 2) void Kernel(GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groups, GM_ADDR y,
                                 GM_ADDR workspace) {
Parameters p;
auto dst = reinterpret_cast<Z0 *>(&p);
auto src = reinterpret_cast<__gm__ Z0 *>(workspace);
for (Z0 i = 0; i < sizeof(Parameters) / 4; ++i)
dst[i] = src[i];
Z0 worker = GetBlockIdx();
if ASCEND_IS_AIV {
worker /= 2;
}
const Z0 columns = p.n / BN;
TPipe pipe;
Cube cube;
dense::Finish finish;
TBuf<TPosition::VECCALC> groupBuffer, taskBuffer;
GM_ADDR slots = workspace + (sizeof(Parameters) + 511) / 512 * 512 + worker * 2ULL * C_BYTES;
GM_ADDR descriptor =
  workspace + (sizeof(Parameters) + 511) / 512 * 512 + p.workers * 2ULL * C_BYTES + worker * p.descriptorBytes;
Z0 owned = 0;
if ASCEND_IS_AIC {
cube.Init(pipe);
CrossCoreWaitFlag(gmg::INPUT_READY);
owned = *reinterpret_cast<__gm__ Z0 *>(descriptor);
}
if ASCEND_IS_AIV {
pipe.InitBuffer(groupBuffer, 1024);
pipe.InitBuffer(taskBuffer, p.descriptorBytes);
auto ends = groupBuffer.Get<Z3>();
auto tasks = taskBuffer.Get<Z0>();
GlobalTensor<Z3> groupGm;
groupGm.SetGlobalBuffer(reinterpret_cast<__gm__ Z3 *>(groups));
DataCopyExtParams gc{1, p.e * 8, 0, 0, 0};
DataCopyPadExtParams<Z3> gp{false, 0, 0, 0};
DataCopyPad(ends, groupGm, gc, gp);
Fence<HardEvent::MTE2_S>();
Z0 start = 0, prefix = 0, nextTask = worker;
for (Z0 expert = 0; expert < p.e; ++expert) {
  const Z0 end = static_cast<Z0>(ends.GetValue(expert));
  const Z0 count = (end - start + BM - 1) / BM * columns;
  for (; nextTask < prefix + count; nextTask += p.workers) {
    const Z0 local = nextTask - prefix;
    const Z0 row = start + local / columns * BM;
    const Z0 at = 8 + 4 * owned++;
    tasks.SetValue(at, expert);
    tasks.SetValue(at + 1, row);
    tasks.SetValue(at + 2, local % columns * BN);
    tasks.SetValue(at + 3, Min(BM, end - row));
  }
  prefix += count;
  start = end;
}
tasks.SetValue(0, owned);
Fence<HardEvent::S_MTE3>();
if (GetSubBlockIdx() == 0) {
  GlobalTensor<Z0> plan;
  plan.SetGlobalBuffer(reinterpret_cast<__gm__ Z0 *>(descriptor));
  DataCopy(plan, tasks, 8 + ((4 * owned + 7) / 8) * 8);
}
CrossCoreSetFlag<2, PIPE_MTE3>(gmg::INPUT_READY);
finish.Init(pipe, scale, y);
}
for (Z0 ordinal = 0; ordinal < owned; ++ordinal) {
Z0 expert, row, col, vm;
if ASCEND_IS_AIC {
  const auto task = reinterpret_cast<__gm__ Z0 *>(descriptor) + 8 + 4 * ordinal;
  expert = task[0];
  row = task[1];
  col = task[2];
  vm = task[3];
}
if ASCEND_IS_AIV {
  auto task = taskBuffer.Get<Z0>();
  const Z0 at = 8 + 4 * ordinal;
  expert = task.GetValue(at);
  row = task.GetValue(at + 1);
  col = task.GetValue(at + 2);
  vm = task.GetValue(at + 3);
}
const Z0 index = ordinal % 2;
GM_ADDR slot = slots + index * C_BYTES;
if ASCEND_IS_AIC {
  GlobalTensor<Z7> a, b;
  a.SetGlobalBuffer(reinterpret_cast<__gm__ Z7 *>(x) + static_cast<Z2>(row) * p.k);
  b.SetGlobalBuffer(reinterpret_cast<__gm__ Z7 *>(weight) + static_cast<Z2>(expert) * p.k * p.n + col);
  cube.Begin(a, b, vm, p.n, p.k);
  if (ordinal >= 2)
    CrossCoreWaitFlag(FREE + index * 3);
  GlobalTensor<Z1> c;
  c.SetGlobalBuffer(reinterpret_cast<__gm__ Z1 *>(slot));
  cube.Part(c, vm, p.k);
  cube.End();
  CrossCoreSetFlag<2, PIPE_FIX>(READY + index * 3);
}
if ASCEND_IS_AIV {
  CrossCoreWaitFlag(READY + index * 3);
  finish.Run(p, slot, expert, row, col, vm);
  CrossCoreSetFlag<2, PIPE_MTE3>(FREE + index * 3);
}
}
if ASCEND_IS_AIC {
if (owned)
  CrossCoreWaitFlag(FREE);
if (owned > 1)
  CrossCoreWaitFlag(FREE + 3);
}
}
} // namespace shortk
struct FirstJob {
Z0 active, small, valid, e, row, col, vm;
};
__aicore__ inline FirstJob LocateFirst(GM_ADDR groups, Z0 worker, Z0 workers, Z0 experts, Z0 m, Z0 n) {
FirstJob j{1, 1, 0, 0, 0, 0, 0};
Z0 end[16], start = 0, h = 0, l = 0, active = 0;
for (Z0 e = 0; e < experts; ++e) {
end[e] = static_cast<Z0>(reinterpret_cast<__gm__ Z3 *>(groups)[e]);
const Z0 len = end[e] - start, t = len % 128;
j.small &= len <= 64;
active += (len != 0);
h += (len / 128 + (t > 64)) * (n / 256);
l += (t > 0 && t <= 64) * (n / 256);
start = end[e];
}
j.small &= active * (n / 512) >= workers;
const Z0 rem = h % workers, light = workers - rem, deficit = 2 * light;
const Z0 low = l <= deficit ? (l + light - 1) / light : 2 + (l - deficit + workers - 1) / workers;
const Z0 high = rem ? 2 : 0;
const bool tall =
  !j.small &&
  (((static_cast<Z2>(m) + 127) / 128) * (n / 256) >= 2 * workers ||
   (h && l + h >= workers && 2 * (h / workers) + (low > high ? low : high) <= (2 * h + l + workers - 1) / workers));
const bool tailOnly = tall && worker >= h;
Z0 pos = tailOnly ? (worker >= rem ? worker - rem : deficit + worker) : worker;
const Z0 bn = j.small ? 512 : 256, cols = n / bn;
start = 0;
for (Z0 e = 0; e < experts; ++e) {
const Z0 len = end[e] - start, t = len % 128;
const Z0 blocks = !tall ? (len + 63) / 64 : tailOnly ? (t > 0 && t <= 64) : (len / 128 + (t > 64));
if (pos < blocks * cols) {
  j.valid = 1;
  j.e = e;
  j.col = pos % cols * bn;
  j.row = tailOnly ? end[e] - t : start + pos / cols * (tall ? 128 : 64);
  const Z0 size = end[e] - j.row, limit = tall ? 128 : 64;
  j.vm = size < limit ? size : limit;
  break;
}
pos -= blocks * cols;
start = end[e];
}
return j;
}
namespace streamk {
using namespace AscendC;
using gmg::Min;
using gmg::Fence;
constexpr Z0 BM = 128, BN = dense::BN, BK = dense::BK, MAX_K = 512;
constexpr Z0 C_BYTES = BM * BN * 4;
constexpr Z4 READY = 9, FREE = 10;
struct Parameters {
Z0 m, n, k, e, workers, descriptorBytes, tileM;
};
class Cube {
TQue<TPosition::A1, 2> a1_;
TQue<TPosition::B1, 2> b1_;
TQue<TPosition::A2, 2> a2_;
TQue<TPosition::B2, 2> b2_;
TQue<TPosition::CO1, 1> c1_;

public:
__aicore__ inline void Init(TPipe &pipe) {
pipe.InitBuffer(a1_, 2, BM * MAX_K);
pipe.InitBuffer(b1_, 2, MAX_K * BN);
pipe.InitBuffer(a2_, 2, BM * BK);
pipe.InitBuffer(b2_, 2, BK * BN);
pipe.InitBuffer(c1_, 1, C_BYTES);
}
__aicore__ inline void Load(GlobalTensor<Z7> &a, GlobalTensor<Z7> &b, Z0 vm, Z0 pitch, Z0 k, Z0 base) {
const Z0 span = Min(MAX_K, k - base);
auto aa = a1_.AllocTensor<Z7>();
DataCopy(aa, a[base], Nd2NzParams(1, static_cast<Z4>(vm), static_cast<Z4>(span), 0, static_cast<Z4>(k), BM, 1, 0));
a1_.EnQue(aa);
auto bb = b1_.AllocTensor<Z7>();
DataCopy(bb, b[static_cast<Z2>(base) * pitch],
         Nd2NzParams(1, static_cast<Z4>(span), BN, 0, static_cast<Z4>(pitch), static_cast<Z4>(span), 1, 0));
b1_.EnQue(bb);
}
__aicore__ inline void Run(GlobalTensor<Z1> &c, GlobalTensor<Z7> &a, GlobalTensor<Z7> &b, Z0 vm, Z0 pitch, Z0 k) {
const Z0 mAligned = (vm + 15) / 16 * 16;
Z6 padding[4] = {0, 0, 0, 0};
Load3DSetFMatrixCal(1, BM, padding);
auto c1 = c1_.AllocTensor<Z1>();
Load(a, b, vm, pitch, k, 0);
for (Z0 base = 0; base < k; base += MAX_K) {
  const Z0 span = Min(MAX_K, k - base);
  auto ar1 = a1_.DeQue<Z7>();
  auto br1 = b1_.DeQue<Z7>();
  if (base + MAX_K < k)
    Load(a, b, vm, pitch, k, base + MAX_K);
  for (Z0 kk = 0; kk < span; kk += BK) {
    auto aa2 = a2_.AllocTensor<Z7>();
    auto bb2 = b2_.AllocTensor<Z7>();
    LoadData3DParamsV2Pro ap;
    ap.channelSize = span;
    ap.extConfig = (static_cast<Z2>(kk) << 32) | (static_cast<Z2>(mAligned) << 16) | BK;
    LoadData(aa2, ar1, ap);
    LoadData2dTransposeParams bp{0, static_cast<Z6>(BN / 32), static_cast<Z4>(span / 32), 1, 0, inc};
    for (Z0 kb = 0; kb < BK / 32; ++kb)
      LoadDataWithTranspose(bb2[kb * BN * 32], br1[kk * 32 + kb * 1024], bp);
    a2_.EnQue(aa2);
    b2_.EnQue(bb2);
    auto ar = a2_.DeQue<Z7>();
    auto br = b2_.DeQue<Z7>();
    MmadParams mp;
    mp.m = static_cast<Z4>(mAligned);
    mp.n = BN;
    mp.k = BK;
    mp.isBias = false;
    mp.cmatrixInitVal = (base == 0 && kk == 0);
    Mmad(c1, ar, br, mp);
    a2_.FreeTensor(ar);
    b2_.FreeTensor(br);
  }
  a1_.FreeTensor(ar1);
  b1_.FreeTensor(br1);
}
c1_.EnQue(c1);
auto cr = c1_.DeQue<Z1>();
FixpipeParamsV220 fp;
fp.nSize = BN;
fp.mSize = static_cast<Z4>(vm);
fp.srcStride = static_cast<Z4>(mAligned);
fp.dstStride = BN;
fp.quantPre = QuantMode_t::NoQuant;
fp.reluEn = false;
Fixpipe<Z1, Z1, CFG_ROW_MAJOR>(c, cr, fp);
c1_.FreeTensor(cr);
}
};
using dense::PR;
using dense::PE;
using dense::SP;
using dense::MASK_BYTES;
using dense::PANEL_BYTES;
class Finish {
Z0 slowRepairs_ = 0;
TBuf<TPosition::VECCALC> panel_;
GlobalTensor<Z8> scale_;
GlobalTensor<half> y_;

public:
__aicore__ inline void Init(TPipe &pipe, GM_ADDR scale, GM_ADDR y) {
pipe.InitBuffer(panel_, PANEL_BYTES);
scale_.SetGlobalBuffer(reinterpret_cast<__gm__ Z8 *>(scale));
y_.SetGlobalBuffer(reinterpret_cast<__gm__ half *>(y));
}
template <class P> __aicore__ inline void Run(const P &p, GM_ADDR slot, Z0 expert, Z0 row, Z0 col, Z0 vm) {
GlobalTensor<Z1> c;
c.SetGlobalBuffer(reinterpret_cast<__gm__ Z1 *>(slot));
auto ci = panel_.Get<Z1>();
auto scale = panel_.Get<Z8>()[5 * SP + 8];
auto out = panel_.Get<half>()[(SP * 20 + 32 + BN * 4 + 4 * MASK_BYTES) / 2];
for (Z0 first = GetSubBlockIdx(); first < vm; first += 2 * PR) {
    const Z0 rows = Min(PR, (vm - first + 1) / 2);
    DataCopyExtParams cp{static_cast<Z4>(rows), BN * 4, BN * 4, 0, 0};
    DataCopyPadExtParams<Z1> pad{false, 0, 0, 0};
    DataCopyPad(ci, c[first * BN], cp, pad);
    DataCopyExtParams sp{1, BN * 4, 0, 0, 0};
    DataCopyPadExtParams<Z8> sf{false, 0, 0, 0};
    DataCopyPad(scale, scale_[static_cast<Z2>(expert) * p.n + col], sp, sf);
    Fence<HardEvent::MTE2_V>();
    dense::PanelGelu<PE, BN>(ci, scale, panel_, rows * BN, slowRepairs_);
    DataCopyExtParams yp{static_cast<Z4>(rows), BN * 2, 0, (2 * p.n - BN) * 2, 0};
    DataCopyPad(y_[static_cast<Z2>(row + first) * p.n + col], out, yp);
    Fence<HardEvent::MTE3_MTE2>();
  }
}
};
__global__ __mix__(1, 2) void Kernel(GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groups, GM_ADDR y,
                                   GM_ADDR workspace) {
Parameters p;
auto dst = reinterpret_cast<Z0 *>(&p);
auto src = reinterpret_cast<__gm__ Z0 *>(workspace);
for (Z0 i = 0; i < sizeof(Parameters) / 4; ++i)
  dst[i] = src[i];
Z0 worker = GetBlockIdx();
if ASCEND_IS_AIV {
  worker /= 2;
}
const Z0 columns = p.n / BN;
TPipe pipe;
Cube cube;
Finish finish;
TBuf<TPosition::VECCALC> groupBuffer, taskBuffer;
GM_ADDR slots = workspace + (sizeof(Parameters) + 511) / 512 * 512 + worker * 2ULL * C_BYTES;
GM_ADDR descriptor =
    workspace + (sizeof(Parameters) + 511) / 512 * 512 + p.workers * 2ULL * C_BYTES + worker * p.descriptorBytes;
Z0 owned = 0;
if ASCEND_IS_AIC {
  cube.Init(pipe);
  CrossCoreWaitFlag(gmg::INPUT_READY);
  owned = *reinterpret_cast<__gm__ Z0 *>(descriptor);
}
if ASCEND_IS_AIV {
  pipe.InitBuffer(groupBuffer, 1024);
  pipe.InitBuffer(taskBuffer, p.descriptorBytes);
  auto ends = groupBuffer.Get<Z3>();
  auto tasks = taskBuffer.Get<Z0>();
  GlobalTensor<Z3> groupGm;
  groupGm.SetGlobalBuffer(reinterpret_cast<__gm__ Z3 *>(groups));
  DataCopyExtParams gc{1, p.e * 8, 0, 0, 0};
  DataCopyPadExtParams<Z3> gp{false, 0, 0, 0};
  DataCopyPad(ends, groupGm, gc, gp);
  Fence<HardEvent::MTE2_S>();
  Z0 scanStart = 0, type2 = 0, type1 = 0;
  for (Z0 expert = 0; expert < p.e; ++expert) {
    const Z0 end = static_cast<Z0>(ends.GetValue(expert));
    const Z0 length = end - scanStart, tail = length % BM;
    type2 += (length / BM + (tail > dense::BM)) * columns;
    type1 += (tail > 0 && tail <= dense::BM) * columns;
    scanStart = end;
  }
  const Z0 rem = type2 % p.workers, light = p.workers - rem;
  const Z0 base = 2 * (type2 / p.workers), deficit = 2 * light;
  const Z0 low = type1 <= deficit ? (type1 + light - 1) / light : 2 + (type1 - deficit + p.workers - 1) / p.workers;
  const Z0 high = rem ? 2 : 0;
  const Z0 maxPanels = base + (low > high ? low : high);
  if (p.tileM == dense::BM && type2 && type1 + type2 >= p.workers &&
      maxPanels <= (2 * type2 + type1 + p.workers - 1) / p.workers)
    p.tileM = BM;
  if (p.tileM == dense::BM) {
    Z0 start = 0, prefix = 0, nextTask = worker;
    for (Z0 expert = 0; expert < p.e; ++expert) {
      const Z0 end = static_cast<Z0>(ends.GetValue(expert));
      const Z0 count = (end - start + p.tileM - 1) / p.tileM * columns;
      for (; nextTask < prefix + count; nextTask += p.workers) {
        const Z0 local = nextTask - prefix;
        const Z0 row = start + local / columns * p.tileM;
        const Z0 at = 8 + 4 * owned++;
        tasks.SetValue(at, expert);
        tasks.SetValue(at + 1, row);
        tasks.SetValue(at + 2, local % columns * BN);
        tasks.SetValue(at + 3, Min(p.tileM, end - row));
      }
      prefix += count;
      start = end;
    }
  } else {
    Z0 start = 0, prefix = 0, next = worker;
    for (Z0 expert = 0; expert < p.e; ++expert) {
      const Z0 end = static_cast<Z0>(ends.GetValue(expert));
      const Z0 length = end - start;
      const Z0 count = (length / BM + (length % BM > dense::BM)) * columns;
      for (; next < prefix + count; next += p.workers) {
        const Z0 local = next - prefix, row = start + local / columns * BM;
        const Z0 at = 8 + 4 * owned++;
        tasks.SetValue(at, expert);
        tasks.SetValue(at + 1, row);
        tasks.SetValue(at + 2, local % columns * BN);
        tasks.SetValue(at + 3, Min(BM, end - row));
      }
      prefix += count;
      start = end;
    }
    start = 0;
    prefix = 0;
    next = worker >= rem ? worker - rem : deficit + worker;
    for (Z0 expert = 0; expert < p.e; ++expert) {
      const Z0 end = static_cast<Z0>(ends.GetValue(expert));
      const Z0 tail = (end - start) % BM;
      const Z0 count = (tail > 0 && tail <= dense::BM) * columns;
      while (next < prefix + count) {
        const Z0 at = 8 + 4 * owned++;
        tasks.SetValue(at, expert);
        tasks.SetValue(at + 1, end - tail);
        tasks.SetValue(at + 2, (next - prefix) * BN);
        tasks.SetValue(at + 3, tail);
        if (next < deficit) {
          next += light;
          if (next >= deficit)
            next = deficit + worker;
        } else
          next += p.workers;
      }
      prefix += count;
      start = end;
    }
  }
  tasks.SetValue(0, owned);
  Fence<HardEvent::S_MTE3>();
  if (GetSubBlockIdx() == 0) {
    GlobalTensor<Z0> plan;
    plan.SetGlobalBuffer(reinterpret_cast<__gm__ Z0 *>(descriptor));
    DataCopy(plan, tasks, 8 + ((4 * owned + 7) / 8) * 8);
  }
  CrossCoreSetFlag<2, PIPE_MTE3>(gmg::INPUT_READY);
  finish.Init(pipe, scale, y);
}
for (Z0 ordinal = 0; ordinal < owned; ++ordinal) {
  Z0 expert, row, col, vm;
  if ASCEND_IS_AIC {
    const auto task = reinterpret_cast<__gm__ Z0 *>(descriptor) + 8 + 4 * ordinal;
    expert = task[0];
    row = task[1];
    col = task[2];
    vm = task[3];
  }
  if ASCEND_IS_AIV {
    auto task = taskBuffer.Get<Z0>();
    const Z0 at = 8 + 4 * ordinal;
    expert = task.GetValue(at);
    row = task.GetValue(at + 1);
    col = task.GetValue(at + 2);
    vm = task.GetValue(at + 3);
  }
  const Z0 index = ordinal % 2;
  GM_ADDR slot = slots + index * C_BYTES;
  if ASCEND_IS_AIC {
    GlobalTensor<Z7> a, b;
    a.SetGlobalBuffer(reinterpret_cast<__gm__ Z7 *>(x) + static_cast<Z2>(row) * p.k);
    b.SetGlobalBuffer(reinterpret_cast<__gm__ Z7 *>(weight) + static_cast<Z2>(expert) * p.k * p.n + col);
    if (ordinal >= 2)
      CrossCoreWaitFlag(FREE + index * 3);
    GlobalTensor<Z1> c;
    c.SetGlobalBuffer(reinterpret_cast<__gm__ Z1 *>(slot));
    cube.Run(c, a, b, vm, p.n, p.k);
    CrossCoreSetFlag<2, PIPE_FIX>(READY + index * 3);
  }
  if ASCEND_IS_AIV {
    CrossCoreWaitFlag(READY + index * 3);
    finish.Run(p, slot, expert, row, col, vm);
    CrossCoreSetFlag<2, PIPE_MTE3>(FREE + index * 3);
  }
}
if ASCEND_IS_AIC {
  if (owned)
    CrossCoreWaitFlag(FREE);
  if (owned > 1)
    CrossCoreWaitFlag(FREE + 3);
}
}
__aicore__ inline void Execute(FirstJob first, GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groups, GM_ADDR y,
                             GM_ADDR workspace, Parameters p, TPipe &pipe, TBuf<TPosition::VECCALC> &groupBuffer) {
Z0 worker = GetBlockIdx();
if ASCEND_IS_AIV {
  worker /= 2;
}
const Z0 columns = p.n / BN;
Cube cube;
Finish finish;
TBuf<TPosition::VECCALC> taskBuffer;
GM_ADDR slots = workspace + (sizeof(Parameters) + 511) / 512 * 512 + worker * 2ULL * C_BYTES;
GM_ADDR descriptor =
    workspace + (sizeof(Parameters) + 511) / 512 * 512 + p.workers * 2ULL * C_BYTES + worker * p.descriptorBytes;
Z0 owned = 0;
if ASCEND_IS_AIC {
  cube.Init(pipe);
  if (first.active && first.valid)
    owned = 1;
  else {
    if (first.active) {
      CrossCoreWaitFlag(gmg::INPUT_READY);
    }
    owned = *reinterpret_cast<__gm__ Z0 *>(descriptor);
  }
}
if ASCEND_IS_AIV {
  pipe.InitBuffer(taskBuffer, p.descriptorBytes);
  auto ends = groupBuffer.Get<Z3>();
  auto tasks = taskBuffer.Get<Z0>();
  Z0 scanStart = 0, type2 = 0, type1 = 0;
  for (Z0 expert = 0; expert < p.e; ++expert) {
    const Z0 end = static_cast<Z0>(ends.GetValue(expert));
    const Z0 length = end - scanStart, tail = length % BM;
    type2 += (length / BM + (tail > dense::BM)) * columns;
    type1 += (tail > 0 && tail <= dense::BM) * columns;
    scanStart = end;
  }
  const Z0 rem = type2 % p.workers, light = p.workers - rem;
  const Z0 base = 2 * (type2 / p.workers), deficit = 2 * light;
  const Z0 low = type1 <= deficit ? (type1 + light - 1) / light : 2 + (type1 - deficit + p.workers - 1) / p.workers;
  const Z0 high = rem ? 2 : 0;
  const Z0 maxPanels = base + (low > high ? low : high);
  if (p.tileM == dense::BM && type2 && type1 + type2 >= p.workers &&
      maxPanels <= (2 * type2 + type1 + p.workers - 1) / p.workers)
    p.tileM = BM;
  if (p.tileM == dense::BM) {
    Z0 start = 0, prefix = 0, nextTask = worker;
    for (Z0 expert = 0; expert < p.e; ++expert) {
      const Z0 end = static_cast<Z0>(ends.GetValue(expert));
      const Z0 count = (end - start + p.tileM - 1) / p.tileM * columns;
      for (; nextTask < prefix + count; nextTask += p.workers) {
        const Z0 local = nextTask - prefix;
        const Z0 row = start + local / columns * p.tileM;
        const Z0 at = 8 + 4 * owned++;
        tasks.SetValue(at, expert);
        tasks.SetValue(at + 1, row);
        tasks.SetValue(at + 2, local % columns * BN);
        tasks.SetValue(at + 3, Min(p.tileM, end - row));
      }
      prefix += count;
      start = end;
    }
  } else {
    Z0 start = 0, prefix = 0, next = worker;
    for (Z0 expert = 0; expert < p.e; ++expert) {
      const Z0 end = static_cast<Z0>(ends.GetValue(expert));
      const Z0 length = end - start;
      const Z0 count = (length / BM + (length % BM > dense::BM)) * columns;
      for (; next < prefix + count; next += p.workers) {
        const Z0 local = next - prefix, row = start + local / columns * BM;
        const Z0 at = 8 + 4 * owned++;
        tasks.SetValue(at, expert);
        tasks.SetValue(at + 1, row);
        tasks.SetValue(at + 2, local % columns * BN);
        tasks.SetValue(at + 3, Min(BM, end - row));
      }
      prefix += count;
      start = end;
    }
    start = 0;
    prefix = 0;
    next = worker >= rem ? worker - rem : deficit + worker;
    for (Z0 expert = 0; expert < p.e; ++expert) {
      const Z0 end = static_cast<Z0>(ends.GetValue(expert));
      const Z0 tail = (end - start) % BM;
      const Z0 count = (tail > 0 && tail <= dense::BM) * columns;
      while (next < prefix + count) {
        const Z0 at = 8 + 4 * owned++;
        tasks.SetValue(at, expert);
        tasks.SetValue(at + 1, end - tail);
        tasks.SetValue(at + 2, (next - prefix) * BN);
        tasks.SetValue(at + 3, tail);
        if (next < deficit) {
          next += light;
          if (next >= deficit)
            next = deficit + worker;
        } else
          next += p.workers;
      }
      prefix += count;
      start = end;
    }
  }
  tasks.SetValue(0, owned);
  tasks.SetValue(1, 0);
  Fence<HardEvent::S_MTE3>();
  if (GetSubBlockIdx() == 0) {
    GlobalTensor<Z0> plan;
    plan.SetGlobalBuffer(reinterpret_cast<__gm__ Z0 *>(descriptor));
    DataCopy(plan, tasks, 8 + ((4 * owned + 7) / 8) * 8);
  }
  CrossCoreSetFlag<2, PIPE_MTE3>(gmg::INPUT_READY);
  finish.Init(pipe, scale, y);
}
for (Z0 ordinal = 0; ordinal < owned; ++ordinal) {
  Z0 expert, row, col, vm;
  if ASCEND_IS_AIC {
    const auto task = reinterpret_cast<__gm__ Z0 *>(descriptor) + 8 + 4 * ordinal;
    if (first.active && ordinal == 0 && first.valid) {
      expert = first.e;
      row = first.row;
      col = first.col;
      vm = first.vm;
    } else {
      expert = task[0];
      row = task[1];
      col = task[2];
      vm = task[3];
    }
  }
  if ASCEND_IS_AIV {
    auto task = taskBuffer.Get<Z0>();
    const Z0 at = 8 + 4 * ordinal;
    expert = task.GetValue(at);
    row = task.GetValue(at + 1);
    col = task.GetValue(at + 2);
    vm = task.GetValue(at + 3);
  }
  const Z0 index = ordinal % 2;
  GM_ADDR slot = slots + index * C_BYTES;
  if ASCEND_IS_AIC {
    GlobalTensor<Z7> a, b;
    a.SetGlobalBuffer(reinterpret_cast<__gm__ Z7 *>(x) + static_cast<Z2>(row) * p.k);
    b.SetGlobalBuffer(reinterpret_cast<__gm__ Z7 *>(weight) + static_cast<Z2>(expert) * p.k * p.n + col);
    if (ordinal >= 2)
      CrossCoreWaitFlag(FREE + index * 3);
    GlobalTensor<Z1> c;
    c.SetGlobalBuffer(reinterpret_cast<__gm__ Z1 *>(slot));
    cube.Run(c, a, b, vm, p.n, p.k);
    CrossCoreSetFlag<2, PIPE_FIX>(READY + index * 3);
    if (ordinal == 0 && first.active && first.valid) {
      CrossCoreWaitFlag(gmg::INPUT_READY);
      owned = *reinterpret_cast<__gm__ Z0 *>(descriptor);
    }
  }
  if ASCEND_IS_AIV {
    CrossCoreWaitFlag(READY + index * 3);
    finish.Run(p, slot, expert, row, col, vm);
    CrossCoreSetFlag<2, PIPE_MTE3>(FREE + index * 3);
  }
}
if ASCEND_IS_AIC {
  if (owned)
    CrossCoreWaitFlag(FREE);
  if (owned > 1)
    CrossCoreWaitFlag(FREE + 3);
}
}
} // namespace streamk
namespace columnk {
using namespace AscendC;
using gmg::Min;
using gmg::Fence;
constexpr Z0 BM = 64, BN = 512, BK = 64, MAX_K = 256;
constexpr Z0 PR = 16, PE = PR * BN, SP = PE + 64;
constexpr Z0 MASK_BYTES = (PE / 8 + 255) / 256 * 256;
constexpr Z0 PANEL_BYTES = SP * 20 + 32 + BN * 4 + 4 * MASK_BYTES + PE * 2;
constexpr Z0 C_BYTES = BM * BN * 4;
constexpr Z4 READY = 9, FREE = 10;
struct Parameters {
Z0 m, n, k, e, workers, descriptorBytes;
};
class Cube {
TQue<TPosition::A1, 1> a1_;
TQue<TPosition::B1, 2> b1_;
TQue<TPosition::A2, 2> a2_;
TQue<TPosition::B2, 2> b2_;
TQue<TPosition::CO1, 1> c1_;

public:
__aicore__ inline void Init(TPipe &pipe, Z0 k) {
  pipe.InitBuffer(a1_, 1, BM * k);
  pipe.InitBuffer(b1_, 2, MAX_K * BN);
  pipe.InitBuffer(a2_, 2, BM * BK);
  pipe.InitBuffer(b2_, 2, BK * BN);
  pipe.InitBuffer(c1_, 1, C_BYTES);
}
__aicore__ inline void LoadB(GlobalTensor<Z7> &b, Z0 pitch, Z0 k, Z0 base) {
  const Z0 span = Min(MAX_K, k - base);
  auto bb = b1_.AllocTensor<Z7>();
  DataCopy(bb, b[static_cast<Z2>(base) * pitch],
           Nd2NzParams(1, static_cast<Z4>(span), BN, 0, static_cast<Z4>(pitch), static_cast<Z4>(span), 1, 0));
  b1_.EnQue(bb);
}
__aicore__ inline void Run(GlobalTensor<Z1> &c, GlobalTensor<Z7> &a, GlobalTensor<Z7> &b, Z0 vm, Z0 pitch, Z0 k,
                           Z0 srcK = 0) {
  const Z0 mAligned = (vm + 15) / 16 * 16;
  Z6 padding[4] = {0, 0, 0, 0};
  Load3DSetFMatrixCal(1, BM, padding);
  auto aa = a1_.AllocTensor<Z7>();
  DataCopy(aa, a,
           Nd2NzParams(1, static_cast<Z4>(vm), static_cast<Z4>(k), 0, static_cast<Z4>(srcK ? srcK : k), BM, 1, 0));
  a1_.EnQue(aa);
  auto ar1 = a1_.DeQue<Z7>();
  for (Z0 base = 0; base < k && base < 2 * MAX_K; base += MAX_K)
    LoadB(b, pitch, k, base);
  auto c1 = c1_.AllocTensor<Z1>();
  for (Z0 base = 0; base < k; base += MAX_K) {
    const Z0 span = Min(MAX_K, k - base);
    auto br1 = b1_.DeQue<Z7>();
    for (Z0 kk = 0; kk < span; kk += BK) {
      auto aa2 = a2_.AllocTensor<Z7>();
      auto bb2 = b2_.AllocTensor<Z7>();
      LoadData3DParamsV2Pro ap;
      ap.channelSize = k;
      ap.extConfig = (static_cast<Z2>(base + kk) << 32) | (static_cast<Z2>(mAligned) << 16) | BK;
      LoadData(aa2, ar1, ap);
      LoadData2dTransposeParams bp{0, static_cast<Z6>(BN / 32), static_cast<Z4>(span / 32), 1, 0, inc};
      for (Z0 kb = 0; kb < BK / 32; ++kb)
        LoadDataWithTranspose(bb2[kb * BN * 32], br1[kk * 32 + kb * 1024], bp);
      a2_.EnQue(aa2);
      b2_.EnQue(bb2);
      auto ar = a2_.DeQue<Z7>();
      auto br = b2_.DeQue<Z7>();
      MmadParams mp;
      mp.m = static_cast<Z4>(mAligned);
      mp.n = BN;
      mp.k = BK;
      mp.isBias = false;
      mp.cmatrixInitVal = (base == 0 && kk == 0);
      Mmad(c1, ar, br, mp);
      a2_.FreeTensor(ar);
      b2_.FreeTensor(br);
    }
    b1_.FreeTensor(br1);
    if (base + 2 * MAX_K < k)
      LoadB(b, pitch, k, base + 2 * MAX_K);
  }
  c1_.EnQue(c1);
  auto cr = c1_.DeQue<Z1>();
  FixpipeParamsV220 fp;
  fp.nSize = BN;
  fp.mSize = static_cast<Z4>(vm);
  fp.srcStride = static_cast<Z4>(mAligned);
  fp.dstStride = BN;
  fp.quantPre = QuantMode_t::NoQuant;
  fp.reluEn = false;
  Fixpipe<Z1, Z1, CFG_ROW_MAJOR>(c, cr, fp);
  c1_.FreeTensor(cr);
  a1_.FreeTensor(ar1);
}
};
class Finish {
Z0 slowRepairs_ = 0;
TBuf<TPosition::VECCALC> panel_;
GlobalTensor<Z8> scale_;
GlobalTensor<half> y_;

public:
__aicore__ inline void Init(TPipe &pipe, GM_ADDR scale, GM_ADDR y) {
  pipe.InitBuffer(panel_, PANEL_BYTES);
  scale_.SetGlobalBuffer(reinterpret_cast<__gm__ Z8 *>(scale));
  y_.SetGlobalBuffer(reinterpret_cast<__gm__ half *>(y));
}
template <class P>
__aicore__ inline void Run(const P &p, GM_ADDR slot, Z0 expert, Z0 row, Z0 col, Z0 vm, Z0 pieces = 1) {
  GlobalTensor<Z1> c;
  c.SetGlobalBuffer(reinterpret_cast<__gm__ Z1 *>(slot));
  auto ci = panel_.Get<Z1>();
  auto scale = panel_.Get<Z8>()[5 * SP + 8];
  auto out = panel_.Get<half>()[(SP * 20 + 32 + BN * 4 + 4 * MASK_BYTES) / 2];
  for (Z0 first = GetSubBlockIdx(); first < vm; first += 2 * PR) {
    const Z0 rows = Min(PR, (vm - first + 1) / 2);
    DataCopyExtParams cp{static_cast<Z4>(rows), BN * 4, BN * 4, 0, 0};
    DataCopyPadExtParams<Z1> pad{false, 0, 0, 0};
    DataCopyPad(ci, c[first * BN], cp, pad);
    DataCopyExtParams sp{1, BN * 4, 0, 0, 0};
    DataCopyPadExtParams<Z8> sf{false, 0, 0, 0};
    DataCopyPad(scale, scale_[static_cast<Z2>(expert) * p.n + col], sp, sf);
    Fence<HardEvent::MTE2_V>();
    auto tmp = panel_.Get<Z1>()[SP];
    for (Z0 j = 1; j < pieces; ++j) {
      DataCopyPad(tmp, c[j * BM * BN + first * BN], cp, pad);
      Fence<HardEvent::MTE2_V>();
      Add(ci, ci, tmp, rows * BN);
      PipeBarrier<PIPE_V>();
      Fence<HardEvent::V_MTE2>();
    }
    dense::PanelGelu<PE, BN>(ci, scale, panel_, rows * BN, slowRepairs_);
    DataCopyExtParams yp{static_cast<Z4>(rows), BN * 2, 0, (2 * p.n - BN) * 2, 0};
    DataCopyPad(y_[static_cast<Z2>(row + first) * p.n + col], out, yp);
    Fence<HardEvent::MTE3_MTE2>();
  }
}
};
__aicore__ inline void Execute(GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groups, GM_ADDR y, GM_ADDR workspace,
                             TPipe &pipe, TBuf<TPosition::VECCALC> &groupBuffer) {
Parameters p;
auto dst = reinterpret_cast<Z0 *>(&p);
auto src = reinterpret_cast<__gm__ Z0 *>(workspace);
for (Z0 i = 0; i < sizeof(Parameters) / 4; ++i)
  dst[i] = src[i];
Z0 worker = GetBlockIdx();
if ASCEND_IS_AIV {
  worker /= 2;
}
const Z0 columns = p.n / BN;
Cube cube;
Finish finish;
TBuf<TPosition::VECCALC> taskBuffer;
GM_ADDR slots = workspace + (sizeof(Parameters) + 511) / 512 * 512 + worker * 2ULL * C_BYTES;
GM_ADDR descriptor =
    workspace + (sizeof(Parameters) + 511) / 512 * 512 + p.workers * 2ULL * C_BYTES + worker * p.descriptorBytes;
Z0 owned = 0;
if ASCEND_IS_AIC {
  cube.Init(pipe, p.k);
  owned = *reinterpret_cast<__gm__ Z0 *>(descriptor);
}
if ASCEND_IS_AIV {
  pipe.InitBuffer(taskBuffer, p.descriptorBytes);
  auto ends = groupBuffer.Get<Z3>();
  auto tasks = taskBuffer.Get<Z0>();
  Z0 start = 0, prefix = 0, nextTask = worker;
  for (Z0 expert = 0; expert < p.e; ++expert) {
    const Z0 end = static_cast<Z0>(ends.GetValue(expert));
    const Z0 count = (end - start + BM - 1) / BM * columns;
    for (; nextTask < prefix + count; nextTask += p.workers) {
      const Z0 local = nextTask - prefix;
      const Z0 row = start + local / columns * BM;
      const Z0 at = 8 + 4 * owned++;
      tasks.SetValue(at, expert);
      tasks.SetValue(at + 1, row);
      tasks.SetValue(at + 2, local % columns * BN);
      tasks.SetValue(at + 3, Min(BM, end - row));
    }
    prefix += count;
    start = end;
  }
  tasks.SetValue(0, owned);
  tasks.SetValue(1, 1);
  Fence<HardEvent::S_MTE3>();
  if (GetSubBlockIdx() == 0) {
    GlobalTensor<Z0> plan;
    plan.SetGlobalBuffer(reinterpret_cast<__gm__ Z0 *>(descriptor));
    DataCopy(plan, tasks, 8 + ((4 * owned + 7) / 8) * 8);
  }
  CrossCoreSetFlag<2, PIPE_MTE3>(gmg::INPUT_READY);
  finish.Init(pipe, scale, y);
}
const Z0 tiles = p.e * columns;
if (p.m == BM * p.e && tiles > p.workers && tiles < 2 * p.workers && p.k % MAX_K == 0 &&
    p.k / MAX_K >= p.workers / (tiles - p.workers) + 1) {
  const Z0 tail = tiles - p.workers, parts = p.k / MAX_K, total = tail * parts;
  GM_ADDR partial = workspace + 512 + p.workers * (2ULL * C_BYTES + p.descriptorBytes);
  if ASCEND_IS_AIC {
    GlobalTensor<Z7> a, b;
    GlobalTensor<Z1> c;
    Z0 pos = worker * total / p.workers, lim = (worker + 1) * total / p.workers;
    if (!true) {
      pos = worker * parts;
      lim = worker < tail ? pos + parts : pos;
    }
    while (pos < lim) {
      Z0 tile = pos / parts, id = tile + p.workers, expert = id / columns, col = id % columns * BN;
      Z0 k0 = (pos % parts) * MAX_K, end = Min(lim, (tile + 1) * parts);
      a.SetGlobalBuffer((__gm__ Z7 *)x + Z2(expert) * BM * p.k + k0);
      b.SetGlobalBuffer((__gm__ Z7 *)weight + (Z2(expert) * p.k + k0) * p.n + col);
      c.SetGlobalBuffer((__gm__ Z1 *)partial + Z2(tile + worker) * BM * BN);
      cube.Run(c, a, b, BM, p.n, (end - pos) * MAX_K, p.k);
      pos = end;
    }
    CrossCoreSetFlag<2, PIPE_FIX>(5);
    Z0 e = worker / columns, n0 = worker % columns * BN;
    a.SetGlobalBuffer((__gm__ Z7 *)x + Z2(e) * BM * p.k);
    b.SetGlobalBuffer((__gm__ Z7 *)weight + Z2(e) * p.k * p.n + n0);
    c.SetGlobalBuffer((__gm__ Z1 *)slots);
    cube.Run(c, a, b, BM, p.n, p.k);
    CrossCoreSetFlag<2, PIPE_FIX>(READY);
  }
  if ASCEND_IS_AIV {
    CrossCoreWaitFlag(5);
    SyncAll<true>();
    if (worker < tail) {
      Z0 first = true ? ((worker * parts + 1) * p.workers - 1) / total : worker;
      Z0 last = true ? (((worker + 1) * parts) * p.workers - 1) / total : worker;
      Z0 id = p.workers + worker, e = id / columns;
      finish.Run(p, partial + Z2(worker + first) * C_BYTES, e, e * BM, (id % columns) * BN, BM, last - first + 1);
    }
    CrossCoreWaitFlag(READY);
    finish.Run(p, slots, worker / columns, (worker / columns) * BM, (worker % columns) * BN, BM);
  }
  return;
}
for (Z0 ordinal = 0; ordinal < owned; ++ordinal) {
  Z0 expert, row, col, vm;
  if ASCEND_IS_AIC {
    const auto task = reinterpret_cast<__gm__ Z0 *>(descriptor) + 8 + 4 * ordinal;
    expert = task[0];
    row = task[1];
    col = task[2];
    vm = task[3];
  }
  if ASCEND_IS_AIV {
    auto task = taskBuffer.Get<Z0>();
    const Z0 at = 8 + 4 * ordinal;
    expert = task.GetValue(at);
    row = task.GetValue(at + 1);
    col = task.GetValue(at + 2);
    vm = task.GetValue(at + 3);
  }
  const Z0 index = ordinal % 2;
  GM_ADDR slot = slots + index * C_BYTES;
  if ASCEND_IS_AIC {
    GlobalTensor<Z7> a, b;
    a.SetGlobalBuffer(reinterpret_cast<__gm__ Z7 *>(x) + static_cast<Z2>(row) * p.k);
    b.SetGlobalBuffer(reinterpret_cast<__gm__ Z7 *>(weight) + static_cast<Z2>(expert) * p.k * p.n + col);
    if (ordinal >= 2)
      CrossCoreWaitFlag(FREE + index * 3);
    GlobalTensor<Z1> c;
    c.SetGlobalBuffer(reinterpret_cast<__gm__ Z1 *>(slot));
    cube.Run(c, a, b, vm, p.n, p.k);
    CrossCoreSetFlag<2, PIPE_FIX>(READY + index * 3);
  }
  if ASCEND_IS_AIV {
    CrossCoreWaitFlag(READY + index * 3);
    finish.Run(p, slot, expert, row, col, vm);
    CrossCoreSetFlag<2, PIPE_MTE3>(FREE + index * 3);
  }
}
if ASCEND_IS_AIC {
  if (owned)
    CrossCoreWaitFlag(FREE);
  if (owned > 1)
    CrossCoreWaitFlag(FREE + 3);
}
}
} // namespace columnk
namespace mixedtiles {
using namespace AscendC;
using gmg::Min;
using gmg::Fence;
constexpr Z0 BM = 128, BN = 256, BK = 128, MAX_K = 512;
constexpr Z0 COL_M = 64, COL_N = 512, COL_K = 64, COL_PANEL = 256;
constexpr Z0 PE = 8192, SP = PE + 64, MASK_BYTES = 1024;
constexpr Z0 PANEL_BYTES = SP * 20 + 32 + COL_N * 4 + 4 * MASK_BYTES + PE * 2;
constexpr Z0 C_BYTES = BM * BN * 4;
constexpr Z4 READY = 9, FREE = 10;
struct Parameters {
Z0 m, n, k, e, workers, descriptorBytes;
};
class Cube {
TQue<TPosition::A1, 2> a1_;
TQue<TPosition::B1, 2> b1_;
TQue<TPosition::A2, 2> a2_;
TQue<TPosition::B2, 2> b2_;
TQue<TPosition::CO1, 1> c1_;

public:
__aicore__ inline void Init(TPipe &pipe) {
  pipe.InitBuffer(a1_, 2, BM * MAX_K);
  pipe.InitBuffer(b1_, 2, MAX_K * BN);
  pipe.InitBuffer(a2_, 2, BM * BK);
  pipe.InitBuffer(b2_, 2, BK * BN);
  pipe.InitBuffer(c1_, 1, C_BYTES);
}
template <Z0 TM, Z0 TN, Z0 TK, Z0 KP>
__aicore__ inline void Load(GlobalTensor<Z7> &a, GlobalTensor<Z7> &b, Z0 vm, Z0 pitch, Z0 k, Z0 base) {
  const Z0 span = Min(KP, k - base);
  auto aa = a1_.AllocTensor<Z7>();
  DataCopy(aa, a[base], Nd2NzParams(1, static_cast<Z4>(vm), static_cast<Z4>(span), 0, static_cast<Z4>(k), TM, 1, 0));
  a1_.EnQue(aa);
  auto bb = b1_.AllocTensor<Z7>();
  DataCopy(bb, b[static_cast<Z2>(base) * pitch],
           Nd2NzParams(1, static_cast<Z4>(span), TN, 0, static_cast<Z4>(pitch), static_cast<Z4>(span), 1, 0));
  b1_.EnQue(bb);
}
template <Z0 TM, Z0 TN, Z0 TK, Z0 KP>
__aicore__ inline void Run(GlobalTensor<Z1> &c, GlobalTensor<Z7> &a, GlobalTensor<Z7> &b, Z0 vm, Z0 pitch, Z0 k) {
  const Z0 mAligned = (vm + 15) / 16 * 16;
  Z6 padding[4] = {0, 0, 0, 0};
  Load3DSetFMatrixCal(1, TM, padding);
  auto c1 = c1_.AllocTensor<Z1>();
  Load<TM, TN, TK, KP>(a, b, vm, pitch, k, 0);
  for (Z0 base = 0; base < k; base += KP) {
    const Z0 span = Min(KP, k - base);
    auto ar1 = a1_.DeQue<Z7>();
    auto br1 = b1_.DeQue<Z7>();
    if (base + KP < k)
      Load<TM, TN, TK, KP>(a, b, vm, pitch, k, base + KP);
    for (Z0 kk = 0; kk < span; kk += TK) {
      auto aa2 = a2_.AllocTensor<Z7>();
      auto bb2 = b2_.AllocTensor<Z7>();
      LoadData3DParamsV2Pro ap;
      ap.channelSize = span;
      ap.extConfig = (static_cast<Z2>(kk) << 32) | (static_cast<Z2>(mAligned) << 16) | TK;
      LoadData(aa2, ar1, ap);
      LoadData2dTransposeParams bp{0, static_cast<Z6>(TN / 32), static_cast<Z4>(span / 32), 1, 0, inc};
      for (Z0 kb = 0; kb < TK / 32; ++kb)
        LoadDataWithTranspose(bb2[kb * TN * 32], br1[kk * 32 + kb * 1024], bp);
      a2_.EnQue(aa2);
      b2_.EnQue(bb2);
      auto ar = a2_.DeQue<Z7>();
      auto br = b2_.DeQue<Z7>();
      MmadParams mp;
      mp.m = static_cast<Z4>(mAligned);
      mp.n = TN;
      mp.k = TK;
      mp.isBias = false;
      mp.cmatrixInitVal = (base == 0 && kk == 0);
      Mmad(c1, ar, br, mp);
      a2_.FreeTensor(ar);
      b2_.FreeTensor(br);
    }
    a1_.FreeTensor(ar1);
    b1_.FreeTensor(br1);
  }
  c1_.EnQue(c1);
  auto cr = c1_.DeQue<Z1>();
  FixpipeParamsV220 fp;
  fp.nSize = TN;
  fp.mSize = static_cast<Z4>(vm);
  fp.srcStride = static_cast<Z4>(mAligned);
  fp.dstStride = TN;
  fp.quantPre = QuantMode_t::NoQuant;
  fp.reluEn = false;
  Fixpipe<Z1, Z1, CFG_ROW_MAJOR>(c, cr, fp);
  c1_.FreeTensor(cr);
}
};
class Finish {
Z0 slowRepairs_ = 0;
TBuf<TPosition::VECCALC> panel_;
GlobalTensor<Z8> scale_;
GlobalTensor<half> y_;

public:
__aicore__ inline void Init(TPipe &pipe, GM_ADDR scale, GM_ADDR y) {
  pipe.InitBuffer(panel_, PANEL_BYTES);
  scale_.SetGlobalBuffer(reinterpret_cast<__gm__ Z8 *>(scale));
  y_.SetGlobalBuffer(reinterpret_cast<__gm__ half *>(y));
}
template <Z0 TN, class P> __aicore__ inline void Run(const P &p, GM_ADDR slot, Z0 expert, Z0 row, Z0 col, Z0 vm) {
  constexpr Z0 ROWS = PE / TN;
  GlobalTensor<Z1> c;
  c.SetGlobalBuffer(reinterpret_cast<__gm__ Z1 *>(slot));
  auto ci = panel_.Get<Z1>();
  auto scale = panel_.Get<Z8>()[5 * SP + 8];
  auto out = panel_.Get<half>()[(SP * 20 + 32 + TN * 4 + 4 * MASK_BYTES) / 2];
  for (Z0 first = GetSubBlockIdx(); first < vm; first += 2 * ROWS) {
    const Z0 rows = Min(ROWS, (vm - first + 1) / 2);
    DataCopyExtParams cp{static_cast<Z4>(rows), TN * 4, TN * 4, 0, 0};
    DataCopyPadExtParams<Z1> pad{false, 0, 0, 0};
    DataCopyPad(ci, c[first * TN], cp, pad);
    DataCopyExtParams sp{1, TN * 4, 0, 0, 0};
    DataCopyPadExtParams<Z8> sf{false, 0, 0, 0};
    DataCopyPad(scale, scale_[static_cast<Z2>(expert) * p.n + col], sp, sf);
    Fence<HardEvent::MTE2_V>();
    dense::PanelGelu<PE, TN>(ci, scale, panel_, rows * TN, slowRepairs_);
    DataCopyExtParams yp{static_cast<Z4>(rows), TN * 2, 0, (2 * p.n - TN) * 2, 0};
    DataCopyPad(y_[static_cast<Z2>(row + first) * p.n + col], out, yp);
    Fence<HardEvent::MTE3_MTE2>();
  }
}
};
__global__ __mix__(1, 2) void Kernel(GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groups, GM_ADDR y,
                                   GM_ADDR workspace) {
Parameters p;
auto dst = reinterpret_cast<Z0 *>(&p);
auto src = reinterpret_cast<__gm__ Z0 *>(workspace);
for (Z0 i = 0; i < sizeof(p) / 4; ++i)
  dst[i] = src[i];
Z0 worker = GetBlockIdx();
if ASCEND_IS_AIV {
  worker /= 2;
}
TPipe pipe;
TBuf<TPosition::VECCALC> groupBuffer;
FirstJob first{};
bool smallOnly = false;
if ASCEND_IS_AIV {
  pipe.InitBuffer(groupBuffer, 1024);
  auto local = groupBuffer.Get<Z3>();
  GlobalTensor<Z3> gm;
  gm.SetGlobalBuffer(reinterpret_cast<__gm__ Z3 *>(groups));
  DataCopyExtParams cp{1, p.e * 8, 0, 0, 0};
  DataCopyPadExtParams<Z3> pad{false, 0, 0, 0};
  DataCopyPad(local, gm, cp, pad);
  Fence<HardEvent::MTE2_S>();
  Z0 start = 0, active = 0;
  smallOnly = true;
  for (Z0 i = 0; i < p.e; ++i) {
    const Z0 end = static_cast<Z0>(local.GetValue(i)), length = end - start;
    smallOnly = smallOnly && length <= COL_M;
    active += (length != 0);
    start = end;
  }
  smallOnly = smallOnly && active * (p.n / COL_N) >= p.workers;
}
if ASCEND_IS_AIC {
  if (p.e <= 16) {
    first = LocateFirst(groups, worker, p.workers, p.e, p.m, p.n);
    smallOnly = first.small;
  } else {
    CrossCoreWaitFlag(gmg::INPUT_READY);
    GM_ADDR descriptor =
        workspace + (sizeof(p) + 511) / 512 * 512 + p.workers * 2ULL * C_BYTES + worker * p.descriptorBytes;
    smallOnly = reinterpret_cast<__gm__ Z0 *>(descriptor)[1] != 0;
  }
}
if (smallOnly) {
  if ASCEND_IS_AIC {
    if (first.active)
      CrossCoreWaitFlag(gmg::INPUT_READY);
  }
  columnk::Execute(x, weight, scale, groups, y, workspace, pipe, groupBuffer);
} else {
  const Z0 tileM = static_cast<Z2>((p.m + streamk::BM - 1) / streamk::BM) * (p.n / streamk::BN) >= 2ULL * p.workers
                       ? streamk::BM
                       : dense::BM;
  streamk::Parameters q{p.m, p.n, p.k, p.e, p.workers, p.descriptorBytes, tileM};
  streamk::Execute(first, x, weight, scale, groups, y, workspace, q, pipe, groupBuffer);
}
}
} // namespace mixedtiles
namespace edge {
using namespace AscendC;
using gmg::Fence;
constexpr Z0 BM = dense::BM, BN = dense::BN;
struct Parameters {
Z0 m, n, k, e, workers;
TCubeTiling cube;
};
class Finish {
TBuf<TPosition::VECCALC> panel_;
GlobalTensor<Z8> scales_;
GlobalTensor<half> output_;
Z0 slowRepairs_ = 0;

public:
__aicore__ inline void Init(TPipe &pipe, GM_ADDR scale, GM_ADDR y) {
  pipe.InitBuffer(panel_, dense::PANEL_BYTES);
  scales_.SetGlobalBuffer(reinterpret_cast<__gm__ Z8 *>(scale));
  output_.SetGlobalBuffer(reinterpret_cast<__gm__ half *>(y));
}
__aicore__ inline void Run(const Parameters &p, const gmg::GeneralTask &task, GM_ADDR slot) {
  const Z0 halfRows = (task.vm + 1) / 2;
  const Z0 first = GetSubBlockIdx() * halfRows;
  if (first >= task.vm)
    return;
  const Z0 rows = gmg::Min(halfRows, task.vm - first);
  const Z0 width = task.vn;
  auto ci = panel_.Get<Z1>();
  auto scale = panel_.Get<Z8>()[5 * dense::SP + 8];
  auto out = panel_.Get<half>()[(dense::SP * 20 + 32 + BN * 4 + 4 * dense::MASK_BYTES) / 2];
  GlobalTensor<Z1> c;
  c.SetGlobalBuffer(reinterpret_cast<__gm__ Z1 *>(slot));
  if (width != BN) {
    Duplicate(ci, static_cast<Z1>(0), rows * BN);
    Duplicate(scale, 0.0f, BN);
    Fence<HardEvent::V_MTE2>();
  }
  DataCopyExtParams cp{static_cast<Z4>(rows), width * 4, (BN - width) * 4, (BN - ((width + 7) / 8) * 8) / 8, 0};
  DataCopyPadExtParams<Z1> ip{true, 0, static_cast<Z6>((8 - width % 8) % 8), 0};
  DataCopyPad(ci, c[first * BN], cp, ip);
  DataCopyExtParams sp{1, width * 4, 0, 0, 0};
  DataCopyPadExtParams<Z8> fp{true, 0, static_cast<Z6>((8 - width % 8) % 8), 0};
  DataCopyPad(scale, scales_[static_cast<Z2>(task.expert) * p.n + task.col], sp, fp);
  Fence<HardEvent::MTE2_V>();
  dense::PanelGelu<dense::PE, BN>(ci, scale, panel_, rows * BN, slowRepairs_);
  DataCopyExtParams yp{static_cast<Z4>(rows), width * 2, (BN - ((width + 15) / 16) * 16) / 16, (p.n - width) * 2, 0};
  DataCopyPad(output_[static_cast<Z2>(task.row + first) * p.n + task.col], out, yp);
  Fence<HardEvent::MTE3_MTE2>();
  Fence<HardEvent::MTE3_V>();
}
};
__global__ __mix__(1, 2) void Kernel(GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR g, GM_ADDR y, GM_ADDR ws) {
Parameters p;
auto src = reinterpret_cast<__gm__ Z0 *>(ws);
auto dst = reinterpret_cast<Z0 *>(&p);
for (Z0 i = 0; i < offsetof(Parameters, cube) / 4; ++i)
  dst[i] = src[i];
Z0 worker = GetBlockIdx();
if ASCEND_IS_AIV {
  worker /= 2;
}
TPipe pipe;
using A = MatmulType<TPosition::GM, CubeFormat::ND, Z7>;
using C = MatmulType<TPosition::GM, CubeFormat::ND, Z1>;
MatmulImpl<A, A, C, C, gmg::MM_CONFIG> mm;
Finish finish;
if ASCEND_IS_AIC {
  auto cube = reinterpret_cast<Z0 *>(&p.cube);
  for (Z0 i = 0; i < sizeof(TCubeTiling) / 4; ++i)
    cube[i] = src[offsetof(Parameters, cube) / 4 + i];
  mm.SetSubBlockIdx(0);
  mm.Init(&p.cube, &pipe);
  mm.SetOrgShape(BM, p.n, p.k, p.k, BN);
}
if ASCEND_IS_AIV {
  finish.Init(pipe, s, y);
}
gmg::GeneralTaskCursor<BM, BN> cursor(p, g, worker, 0);
gmg::GeneralTask task;
Z0 ordinal = 0;
GM_ADDR slots = ws + (sizeof(p) + 511) / 512 * 512 + worker * 2ULL * dense::C_BYTES;
while (cursor.Next(task)) {
  const Z0 index = ordinal % 2;
  GM_ADDR slot = slots + index * dense::C_BYTES;
  if ASCEND_IS_AIC {
    if (ordinal >= 2)
      CrossCoreWaitFlag(dense::FREE + index * 3);
    GlobalTensor<Z7> a, b;
    GlobalTensor<Z1> c;
    a.SetGlobalBuffer(reinterpret_cast<__gm__ Z7 *>(x) + static_cast<Z2>(task.row) * p.k);
    b.SetGlobalBuffer(reinterpret_cast<__gm__ Z7 *>(w) + static_cast<Z2>(task.expert) * p.k * p.n + task.col);
    c.SetGlobalBuffer(reinterpret_cast<__gm__ Z1 *>(slot));
    mm.SetSingleShape(task.vm, task.vn, p.k);
    mm.SetTensorA(a);
    mm.SetTensorB(b);
    mm.IterateAll(c, 0);
    CrossCoreSetFlag<2, PIPE_FIX>(dense::READY + index * 3);
  }
  if ASCEND_IS_AIV {
    CrossCoreWaitFlag(dense::READY + index * 3);
    finish.Run(p, task, slot);
    CrossCoreSetFlag<2, PIPE_MTE3>(dense::FREE + index * 3);
  }
  ++ordinal;
}
if ASCEND_IS_AIC {
  if (ordinal)
    CrossCoreWaitFlag(dense::FREE);
  if (ordinal > 1)
    CrossCoreWaitFlag(dense::FREE + 3);
  mm.End();
}
}
} // namespace edge
namespace edgepair {
using namespace AscendC;
using gmg::Min;
constexpr Z0 BM = edge::BM, BN = edge::BN, KP = 256, BK = 128;
constexpr Z0 PAIR = 2 * BN;
constexpr Z0 L1_BYTES = 2 * KP * (BM + PAIR);
class Cube {
TQue<TPosition::A1, 2> a1_;
TQue<TPosition::B1, 2> b1_;
TQue<TPosition::A2, 2> a2_;
TQue<TPosition::B2, 2> b2_;
TQue<TPosition::CO1, 1> c1_;

public:
__aicore__ inline void Init(TPipe &pipe) {
  pipe.InitBuffer(a1_, 2, KP * BM);
  pipe.InitBuffer(b1_, 2, KP * PAIR);
  pipe.InitBuffer(a2_, 2, BK * BM);
  pipe.InitBuffer(b2_, 2, BK * BN);
  pipe.InitBuffer(c1_, 1, 2 * dense::C_BYTES);
}
template <bool Wide>
__aicore__ inline void Load(const edge::Parameters &p, const gmg::GeneralTask &t, GlobalTensor<Z7> a,
                            GlobalTensor<Z7> b, Z0 base) {
  const Z0 span = Min(KP, p.k - base), stride = (span + 31) / 32 * 32;
  auto aa = a1_.AllocTensor<Z7>();
  DataCopy(aa, a[base], Nd2NzParams(1, t.vm, span, 0, p.k, BM, 1, 0));
  a1_.EnQue(aa);
  auto bb = b1_.AllocTensor<Z7>();
  if ((t.vn + 31) / 32 * 32 != (t.vn + BN - 1) / BN * BN) {
    const Z0 strips = (t.vn + BN - 1) / BN * BN / 32;
    InitConstValue(bb.ReinterpretCast<Z0>(), InitConstValueParams<Z0>(1, strips * stride, 0, 0));
    PipeBarrier<PIPE_MTE2>();
  } else if (stride != span) {
    InitConstValue(bb[span * 32].ReinterpretCast<Z0>(),
                   InitConstValueParams<Z0>((t.vn + 31) / 32, stride - span, span, 0));
    PipeBarrier<PIPE_MTE2>();
  }
  auto src = b[static_cast<Z2>(base) * p.n];
  if (Wide) {
    DataCopy(bb, src, Nd2NzParams(1, span, t.vn, 0, p.n, stride, 1, 0));
  } else {
    for (Z0 col = 0; col < t.vn; col += BN) {
      DataCopy(bb[col * stride], src[col], Nd2NzParams(1, span, Min(BN, t.vn - col), 0, p.n, stride, 1, 0));
    }
  }
  b1_.EnQue(bb);
}
template <bool Wide>
__aicore__ inline void Run(const edge::Parameters &p, const gmg::GeneralTask &t, GlobalTensor<Z7> a,
                           GlobalTensor<Z7> b, GlobalTensor<Z1> c) {
  const Z0 rows = (t.vm + 15) / 16 * 16;
  Z6 padding[4] = {};
  Load3DSetFMatrixCal(1, BM, padding);
  auto accum = c1_.AllocTensor<Z1>();
  Load<Wide>(p, t, a, b, 0);
  for (Z0 base = 0; base < p.k; base += KP) {
    const Z0 span = Min(KP, p.k - base), stride = (span + 31) / 32 * 32;
    auto apanel = a1_.DeQue<Z7>();
    auto bpanel = b1_.DeQue<Z7>();
    if (base + KP < p.k)
      Load<Wide>(p, t, a, b, base + KP);
    for (Z0 kk = 0; kk < span; kk += BK) {
      const Z0 depth = Min(BK, stride - kk);
      auto a2 = a2_.AllocTensor<Z7>();
      LoadData3DParamsV2Pro ap;
      ap.channelSize = stride;
      ap.extConfig = (static_cast<Z2>(kk) << 32) | (static_cast<Z2>(rows) << 16) | depth;
      LoadData(a2, apanel, ap);
      a2_.EnQue(a2);
      auto ar = a2_.DeQue<Z7>();
      for (Z0 col = 0; col < t.vn; col += BN) {
        const Z0 cols = BN;
        auto b2 = b2_.AllocTensor<Z7>();
        LoadData2dTransposeParams bp{0, static_cast<Z6>(cols / 32), static_cast<Z4>(stride / 32), 1, 0, inc};
        for (Z0 kb = 0; kb < depth; kb += 32) {
          LoadDataWithTranspose(b2[kb * cols], bpanel[col * stride + (kk + kb) * 32], bp);
        }
        b2_.EnQue(b2);
        auto br = b2_.DeQue<Z7>();
        MmadParams mp;
        mp.m = rows;
        mp.n = cols;
        mp.k = depth;
        mp.isBias = false;
        mp.cmatrixInitVal = (base == 0 && kk == 0);
        Mmad(accum[col * rows], ar, br, mp);
        b2_.FreeTensor(br);
      }
      a2_.FreeTensor(ar);
    }
    a1_.FreeTensor(apanel);
    b1_.FreeTensor(bpanel);
  }
  c1_.EnQue(accum);
  auto result = c1_.DeQue<Z1>();
  for (Z0 col = 0; col < t.vn; col += BN) {
    FixpipeParamsV220 fp;
    fp.nSize = BN;
    fp.mSize = t.vm;
    fp.srcStride = rows;
    fp.dstStride = BN;
    fp.quantPre = QuantMode_t::NoQuant;
    fp.reluEn = false;
    Fixpipe<Z1, Z1, CFG_ROW_MAJOR>(c[col * BM], result[col * rows], fp);
  }
  c1_.FreeTensor(result);
}
};
template <bool Wide>
__global__ __mix__(1, 2) void Kernel(GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR g, GM_ADDR y, GM_ADDR ws) {
edge::Parameters p;
auto config = reinterpret_cast<__gm__ Z0 *>(ws);
p.m = config[0];
p.n = config[1];
p.k = config[2];
p.e = config[3];
p.workers = config[4];
Z0 worker = GetBlockIdx();
if ASCEND_IS_AIV {
  worker /= 2;
}
TPipe pipe;
Cube cube;
edge::Finish finish;
if ASCEND_IS_AIC {
  cube.Init(pipe);
}
if ASCEND_IS_AIV {
  finish.Init(pipe, s, y);
}
gmg::GeneralTaskCursor<BM, PAIR> tasks(p, g, worker, 0);
gmg::GeneralTask t;
Z0 ordinal = 0;
GM_ADDR slots = ws + (sizeof(p) + 511) / 512 * 512 + worker * 4ULL * dense::C_BYTES;
while (tasks.Next(t)) {
  const Z0 index = ordinal % 2;
  GM_ADDR slot = slots + index * 2 * dense::C_BYTES;
  if ASCEND_IS_AIC {
    if (ordinal >= 2)
      CrossCoreWaitFlag(dense::FREE + index * 3);
    GlobalTensor<Z7> a, b;
    GlobalTensor<Z1> c;
    a.SetGlobalBuffer(reinterpret_cast<__gm__ Z7 *>(x) + static_cast<Z2>(t.row) * p.k);
    b.SetGlobalBuffer(reinterpret_cast<__gm__ Z7 *>(w) + static_cast<Z2>(t.expert) * p.k * p.n + t.col);
    c.SetGlobalBuffer(reinterpret_cast<__gm__ Z1 *>(slot));
    cube.Run<Wide>(p, t, a, b, c);
    CrossCoreSetFlag<2, PIPE_FIX>(dense::READY + index * 3);
  }
  if ASCEND_IS_AIV {
    CrossCoreWaitFlag(dense::READY + index * 3);
    for (Z0 col = 0; col < t.vn; col += BN) {
      auto part = t;
      part.col += col;
      part.vn = Min(BN, t.vn - col);
      finish.Run(p, part, slot + col * BM * 4);
    }
    CrossCoreSetFlag<2, PIPE_MTE3>(dense::FREE + index * 3);
  }
  ++ordinal;
}
if ASCEND_IS_AIC {
  if (ordinal)
    CrossCoreWaitFlag(dense::FREE);
  if (ordinal > 1)
    CrossCoreWaitFlag(dense::FREE + 3);
}
}
} // namespace edgepair
namespace move319 {
using namespace AscendC;
using gmg::Fence;
using gmg::Min;
constexpr Z0 BM = 64, BN = 256, BK = 128, PR = 32, PE = PR * BN;
constexpr Z0 MASK_BYTES = (PE / 8 + 255) / 256 * 256;
constexpr Z0 SP = PE + 64;
constexpr Z0 PANEL_BYTES = SP * 20 + 32 + BN * 4 + 4 * MASK_BYTES + PE * 2;
constexpr Z0 C_BYTES = BM * BN * 4;
constexpr Z4 READY = 9, FREE = 10;
struct Parameters {
Z0 m, n, k, e, workers, native;
TCubeTiling cube;
};
template <Z0 PE, Z0 COLS, bool overlap = false, bool pure = false, Z0 storageColumns = COLS>
__aicore__ inline void PanelGelu(LocalTensor<Z1> ci, LocalTensor<Z8> scale, TBuf<TPosition::VECCALC> &vectors_,
                               Z0 count, Z0 &slowRepairs, bool pendingStore = false) {
constexpr Z0 MASK_BYTES = (PE / 8 + 255) / 256 * 256;
constexpr Z0 SP = PE + 64;
auto u = vectors_.Get<Z8>();
auto z = vectors_.Get<Z8>()[SP];
auto t = vectors_.Get<Z8>()[2 * SP];
auto result = t;
auto den = vectors_.Get<Z8>()[3 * SP];
auto neg = (pure && overlap) ? u : vectors_.Get<Z8>()[4 * SP + 8];
auto pos = (pure && overlap) ? t : u;
auto mask = vectors_.Get<Z6>()[SP * 20 + 32 + storageColumns * 4];
auto out = vectors_.Get<half>()[(SP * 20 + 32 + storageColumns * 4 + 4 * MASK_BYTES) / 2];
Cast(z, ci, RoundMode::CAST_RINT, count);
PipeBarrier<PIPE_V>();
for (Z0 col = 0; col < COLS; col += 64)
  Mul(z[col], z[col], scale[col], 64, static_cast<Z6>(count / COLS),
      BinaryRepeatParams(1, 1, 1, COLS / 8, COLS / 8, 0));
PipeBarrier<PIPE_V>();
if constexpr (pure && overlap)
  SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
Mul(u, z, z, count);
PipeBarrier<PIPE_V>();
Duplicate(t, -1.5957691216057308f, count);
PipeBarrier<PIPE_V>();
Axpy(t, u, -0.071354816275f, count);
PipeBarrier<PIPE_V>();
Abs(u, z, count);
PipeBarrier<PIPE_V>();
Mul(t, t, u, count);
PipeBarrier<PIPE_V>();
CompareScalar(mask, z, 0.0f, CMPMODE::GE, count);
Exp(t, t, count);
PipeBarrier<PIPE_V>();
Adds(den, t, 1.0f, count);
Mul(neg, z, t, count);
PipeBarrier<PIPE_V>();
Div(neg, neg, den, count);
PipeBarrier<PIPE_V>();
Sub(pos, z, neg, count);
PipeBarrier<PIPE_V>();
Sub(den, z, pos, count);
PipeBarrier<PIPE_V>();
Sub(den, den, neg, count);
PipeBarrier<PIPE_V>();
Select(result, mask, pos, neg, SELMODE::VSEL_TENSOR_TENSOR_MODE, count);
PipeBarrier<PIPE_V>();
auto bits = result.ReinterpretCast<Z1>();
auto work = z.ReinterpretCast<Z1>();
auto constant = u.ReinterpretCast<Z1>();
if constexpr (pure) {
  auto nonzero = vectors_.Get<Z6>()[SP * 20 + 32 + storageColumns * 4 + MASK_BYTES];
  CompareScalar(nonzero, den, 0.0f, CMPMODE::NE, count);
  CompareScalar(mask, result, 0.00006103515625f, CMPMODE::GE, count);
  ShiftRight(work.ReinterpretCast<Z0>(), den.ReinterpretCast<Z0>(), static_cast<Z0>(31), count);
  Duplicate(constant, static_cast<Z1>(1), count);
  PipeBarrier<PIPE_V>();
  And(mask.ReinterpretCast<Z4>(), mask.ReinterpretCast<Z4>(), nonzero.ReinterpretCast<Z4>(), count / 16);
  Sub(work, bits, work, count);
  PipeBarrier<PIPE_V>();
  Or(work.ReinterpretCast<Z4>(), work.ReinterpretCast<Z4>(), constant.ReinterpretCast<Z4>(), 2 * count);
  PipeBarrier<PIPE_V>();
  Select(result, mask, work.ReinterpretCast<Z8>(), result, SELMODE::VSEL_TENSOR_TENSOR_MODE, count);
  PipeBarrier<PIPE_V>();
  if constexpr (overlap) {
    if (pendingStore)
      WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
  }
  Cast(out, result, RoundMode::CAST_RINT, count);
  Fence<HardEvent::V_MTE3>();
  return;
}
auto mid = vectors_.Get<Z6>()[SP * 20 + 32 + storageColumns * 4 + 1 * MASK_BYTES];
auto exponent = vectors_.Get<Z6>()[SP * 20 + 32 + storageColumns * 4 + 2 * MASK_BYTES];
auto residual = vectors_.Get<Z6>()[SP * 20 + 32 + storageColumns * 4 + 3 * MASK_BYTES];
Duplicate(constant, static_cast<Z1>(0x1fff), count);
PipeBarrier<PIPE_V>();
And(work.ReinterpretCast<Z4>(), bits.ReinterpretCast<Z4>(), constant.ReinterpretCast<Z4>(), 2 * count);
PipeBarrier<PIPE_V>();
CompareScalar(mid, work, static_cast<Z1>(0x1000), CMPMODE::EQ, count);
PipeBarrier<PIPE_V>();
And(mask.ReinterpretCast<Z4>(), mask.ReinterpretCast<Z4>(), mid.ReinterpretCast<Z4>(), count / 16);
PipeBarrier<PIPE_V>();
if (slowRepairs < 2) {
  CompareScalar(residual, den, 0.0f, CMPMODE::NE, count);
  PipeBarrier<PIPE_V>();
  And(residual.ReinterpretCast<Z4>(), residual.ReinterpretCast<Z4>(), mask.ReinterpretCast<Z4>(), count / 16);
  PipeBarrier<PIPE_V>();
  auto words = work.ReinterpretCast<Z8>();
  Cast(words, residual.ReinterpretCast<Z1>(), RoundMode::CAST_RINT, count / 32);
  PipeBarrier<PIPE_V>();
  Abs(words, words, count / 32);
  PipeBarrier<PIPE_V>();
  ReduceMax(neg, words, u, count / 32, false);
  Fence<HardEvent::V_S>();
  const bool needsRepair = neg.GetValue(0) != 0.0f;
  Fence<HardEvent::S_V>();
  if (!needsRepair) {
    slowRepairs = 0;
    if constexpr (overlap) {
      if (pendingStore)
        WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
    }
    Cast(out, result, RoundMode::CAST_RINT, count);
    Fence<HardEvent::V_MTE3>();
    return;
  }
  ++slowRepairs;
}
Cast(work.ReinterpretCast<Z8>(), bits, RoundMode::CAST_RINT, count);
PipeBarrier<PIPE_V>();
CompareScalar(exponent, work.ReinterpretCast<Z8>(), static_cast<Z8>(0x38800000), CMPMODE::GE, count);
PipeBarrier<PIPE_V>();
And(mask.ReinterpretCast<Z4>(), mask.ReinterpretCast<Z4>(), exponent.ReinterpretCast<Z4>(), count / 16);
PipeBarrier<PIPE_V>();
CompareScalar(residual, den, 0.0f, CMPMODE::GT, count);
PipeBarrier<PIPE_V>();
And(residual.ReinterpretCast<Z4>(), residual.ReinterpretCast<Z4>(), mask.ReinterpretCast<Z4>(), count / 16);
PipeBarrier<PIPE_V>();
Adds(work, bits, static_cast<Z1>(1), count);
PipeBarrier<PIPE_V>();
Select(result, residual, work.ReinterpretCast<Z8>(), result, SELMODE::VSEL_TENSOR_TENSOR_MODE, count);
PipeBarrier<PIPE_V>();
CompareScalar(residual, den, 0.0f, CMPMODE::LT, count);
PipeBarrier<PIPE_V>();
And(residual.ReinterpretCast<Z4>(), residual.ReinterpretCast<Z4>(), mask.ReinterpretCast<Z4>(), count / 16);
PipeBarrier<PIPE_V>();
Adds(work, bits, static_cast<Z1>(-1), count);
PipeBarrier<PIPE_V>();
Select(result, residual, work.ReinterpretCast<Z8>(), result, SELMODE::VSEL_TENSOR_TENSOR_MODE, count);
PipeBarrier<PIPE_V>();
if constexpr (overlap) {
  if (pendingStore)
    WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
}
Cast(out, result, RoundMode::CAST_RINT, count);
Fence<HardEvent::V_MTE3>();
}
} // namespace move319
namespace residentBands {
using namespace AscendC;
using gmg::Min;
constexpr Z0 BN = edge::BN, BK = 128;
using gmg::Fence;
class Finish {
TBuf<TPosition::VECCALC> panel_;
GlobalTensor<Z8> scales_;
GlobalTensor<half> output_;
Z0 slowRepairs_ = 0;
bool pendingInput_ = false, pendingStore_ = false;

public:
__aicore__ inline void Init(TPipe &pipe, GM_ADDR scale, GM_ADDR y, Z0 extra = 0) {
  pipe.InitBuffer(panel_, dense::PANEL_BYTES + extra);
  scales_.SetGlobalBuffer(reinterpret_cast<__gm__ Z8 *>(scale));
  output_.SetGlobalBuffer(reinterpret_cast<__gm__ half *>(y));
}
template <Z0 VC = BN, Z0 storageWidth = VC>
__aicore__ inline void Run(const edge::Parameters &p, const gmg::GeneralTask &task, GM_ADDR slot, Z0 pitch = BN) {
  const Z0 halfRows = (task.vm + 1) / 2;
  const Z0 first = GetSubBlockIdx() * halfRows;
  if (first >= task.vm)
    return;
  const Z0 rows = gmg::Min(halfRows, task.vm - first);
  const Z0 width = task.vn;
  if (pendingInput_) {
    WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
    pendingInput_ = false;
  }
  auto ci = panel_.Get<Z1>()[4 * dense::SP + 8];
  auto scale = panel_.Get<Z8>()[5 * dense::SP + 8];
  auto out = panel_.Get<half>()[(dense::SP * 20 + 32 + storageWidth * 4 + 4 * dense::MASK_BYTES) / 2];
  GlobalTensor<Z1> c;
  c.SetGlobalBuffer(reinterpret_cast<__gm__ Z1 *>(slot));
  if (width != VC) {
    Duplicate(ci, static_cast<Z1>(0), rows * VC);
    Duplicate(scale, 0.0f, VC);
    Fence<HardEvent::V_MTE2>();
  }
  DataCopyExtParams cp{static_cast<Z4>(rows), width * 4, (pitch - width) * 4, (VC - ((width + 7) / 8) * 8) / 8, 0};
  DataCopyPadExtParams<Z1> ip{true, 0, static_cast<Z6>((8 - width % 8) % 8), 0};
  DataCopyPad(ci, c[first * pitch], cp, ip);
  DataCopyExtParams sp{1, width * 4, 0, 0, 0};
  DataCopyPadExtParams<Z8> fp{true, 0, static_cast<Z6>((8 - width % 8) % 8), 0};
  DataCopyPad(scale, scales_[static_cast<Z2>(task.expert) * p.n + task.col], sp, fp);
  Fence<HardEvent::MTE2_V>();
  move319::PanelGelu<dense::PE, VC, true, true, storageWidth>(ci, scale, panel_, rows * VC, slowRepairs_,
                                                              pendingStore_);
  pendingInput_ = true;
  DataCopyExtParams yp{static_cast<Z4>(rows), width * 2, (VC - ((width + 15) / 16) * 16) / 16, (p.n - width) * 2, 0};
  DataCopyPad(output_[static_cast<Z2>(task.row + first) * p.n + task.col], out, yp);
  SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
  pendingStore_ = true;
}
__aicore__ inline void Drain() {
  if (pendingInput_)
    WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
  if (pendingStore_)
    WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
}
};
template <Z0 BM, Z0 PAIR> class Cube {
TQue<TPosition::A1, 1> a1_;
TQue<TPosition::B1, 1> b1_;
LocalTensor<Z7> resident_;
TQue<TPosition::A2, 2> a2_;
TQue<TPosition::B2, 2> b2_;
TQue<TPosition::CO1, 1> c1_;

public:
__aicore__ inline void Init(TPipe &pipe, Z0 k) {
  const Z0 paddedK = (k + 31) / 32 * 32;
  pipe.InitBuffer(a1_, 1, paddedK * BM);
  pipe.InitBuffer(b1_, 1, paddedK * PAIR);
  pipe.InitBuffer(a2_, 2, BK * BM);
  pipe.InitBuffer(b2_, 2, BK * BN);
  pipe.InitBuffer(c1_, 1, 2 * dense::C_BYTES);
}
__aicore__ inline void BeginB(const edge::Parameters &p, const gmg::GeneralTask &t, GlobalTensor<Z7> b) {
  const Z0 span = p.k, stride = (span + 31) / 32 * 32;
  auto bb = b1_.AllocTensor<Z7>();
  if ((t.vn + 31) / 32 * 32 != (t.vn + BN - 1) / BN * BN) {
    const Z0 strips = (t.vn + BN - 1) / BN * BN / 32;
    InitConstValue(bb.ReinterpretCast<Z0>(), InitConstValueParams<Z0>(1, strips * stride, 0, 0));
    PipeBarrier<PIPE_MTE2>();
  } else if (stride != span) {
    InitConstValue(bb[span * 32].ReinterpretCast<Z0>(),
                   InitConstValueParams<Z0>((t.vn + 31) / 32, stride - span, span, 0));
    PipeBarrier<PIPE_MTE2>();
  }
  DataCopy(bb, b, Nd2NzParams(1, span, t.vn, 0, p.n, stride, 1, 0));
  b1_.EnQue(bb);
  resident_ = b1_.DeQue<Z7>();
}
__aicore__ inline void EndB() {
  b1_.FreeTensor(resident_);
}
__aicore__ inline void Run(const edge::Parameters &p, const gmg::GeneralTask &t, GlobalTensor<Z7> a,
                           GlobalTensor<Z1> c) {
  const Z0 rows = (t.vm + 15) / 16 * 16;
  Z6 padding[4] = {};
  Load3DSetFMatrixCal(1, BM, padding);
  auto accum = c1_.AllocTensor<Z1>();
  auto aa = a1_.AllocTensor<Z7>();
  DataCopy(aa, a, Nd2NzParams(1, t.vm, p.k, 0, p.k, BM, 1, 0));
  a1_.EnQue(aa);
  {
    const Z0 span = p.k, stride = (span + 31) / 32 * 32;
    auto apanel = a1_.DeQue<Z7>();
    auto bpanel = resident_;
    for (Z0 kk = 0; kk < span; kk += BK) {
      const Z0 depth = Min(BK, stride - kk);
      auto a2 = a2_.AllocTensor<Z7>();
      LoadData3DParamsV2Pro ap;
      ap.channelSize = stride;
      ap.extConfig = (static_cast<Z2>(kk) << 32) | (static_cast<Z2>(rows) << 16) | depth;
      LoadData(a2, apanel, ap);
      a2_.EnQue(a2);
      auto ar = a2_.DeQue<Z7>();
      for (Z0 col = 0; col < t.vn; col += BN) {
        const Z0 cols = BN;
        auto b2 = b2_.AllocTensor<Z7>();
        LoadData2dTransposeParams bp{0, static_cast<Z6>(cols / 32), static_cast<Z4>(stride / 32), 1, 0, inc};
        for (Z0 kb = 0; kb < depth; kb += 32) {
          LoadDataWithTranspose(b2[kb * cols], bpanel[col * stride + (kk + kb) * 32], bp);
        }
        b2_.EnQue(b2);
        auto br = b2_.DeQue<Z7>();
        MmadParams mp;
        mp.m = rows;
        mp.n = cols;
        mp.k = depth;
        mp.isBias = false;
        mp.cmatrixInitVal = (kk == 0);
        Mmad(accum[col * rows], ar, br, mp);
        b2_.FreeTensor(br);
      }
      a2_.FreeTensor(ar);
    }
    a1_.FreeTensor(apanel);
  }
  c1_.EnQue(accum);
  auto result = c1_.DeQue<Z1>();
  for (Z0 col = 0; col < t.vn; col += BN) {
    FixpipeParamsV220 fp;
    fp.nSize = BN;
    fp.mSize = t.vm;
    fp.srcStride = rows;
    fp.dstStride = BN;
    fp.quantPre = QuantMode_t::NoQuant;
    fp.reluEn = false;
    Fixpipe<Z1, Z1, CFG_ROW_MAJOR>(c[col * BM], result[col * rows], fp);
  }
  c1_.FreeTensor(result);
}
};
template <Z0 BM, Z0 PAIR>
__global__ __mix__(1, 2) void ResidentBandsKernel(GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR g, GM_ADDR y, GM_ADDR ws) {
edge::Parameters p;
auto config = reinterpret_cast<__gm__ Z0 *>(ws);
p.m = config[0];
p.n = config[1];
p.k = config[2];
p.e = config[3];
p.workers = config[4];
Z0 worker = GetBlockIdx();
if ASCEND_IS_AIV {
  worker /= 2;
}
const Z0 columns = (p.n + PAIR - 1) / PAIR;
const Z0 column = worker % columns, team = worker / columns, teams = (p.workers + columns - 1 - column) / columns;
const Z0 expertRows = ((p.k + 9) / 10 + 15) / 16 * 16;
const auto ends = reinterpret_cast<__gm__ Z3 *>(g);
Z0 active = 0, prevEnd = 0;
for (Z0 e = 0; e < p.e; ++e) {
  const Z0 next = ends[e];
  active += (next > prevEnd);
  prevEnd = next;
}
const Z2 totalCost = static_cast<Z2>(p.m) + active * expertRows;
const Z0 begin = totalCost * team / teams;
const Z0 end = totalCost * (team + 1) / teams;
TPipe pipe;
Cube<BM, PAIR> cube;
Finish finish;
if ASCEND_IS_AIC {
  cube.Init(pipe, p.k);
}
if ASCEND_IS_AIV {
  finish.Init(pipe, s, y);
}
GM_ADDR slots = ws + (sizeof(p) + 511) / 512 * 512 + worker * 4ULL * dense::C_BYTES;
Z0 ordinal = 0, previous = 0, cost = 0;
for (Z0 expert = 0; expert < p.e && cost < end; ++expert) {
  const Z0 boundary = ends[expert], length = boundary - previous;
  if (!length)
    continue;
  const Z0 rowCostStart = cost + expertRows;
  cost = rowCostStart + length;
  const Z0 start = previous;
  previous = boundary;
  if (cost <= begin || rowCostStart >= end)
    continue;
  Z0 row = start + (begin > rowCostStart ? begin - rowCostStart : 0);
  const Z0 stop = start + Min(length, end - rowCostStart);
  gmg::GeneralTask t;
  t.col = column * PAIR;
  t.vn = Min(PAIR, p.n - t.col);
  t.expert = expert;
  GlobalTensor<Z7> b;
  if ASCEND_IS_AIC {
    b.SetGlobalBuffer(reinterpret_cast<__gm__ Z7 *>(w) + static_cast<Z2>(expert) * p.k * p.n + t.col);
    cube.BeginB(p, t, b);
  }
  for (; row < stop; row += BM, ++ordinal) {
    t.row = row;
    t.vm = Min(BM, stop - row);
    const Z0 index = ordinal % 2;
    GM_ADDR slot = slots + index * 2 * dense::C_BYTES;
    if ASCEND_IS_AIC {
      if (ordinal >= 2)
        CrossCoreWaitFlag(dense::FREE + index * 3);
      GlobalTensor<Z7> a;
      GlobalTensor<Z1> c;
      a.SetGlobalBuffer(reinterpret_cast<__gm__ Z7 *>(x) + static_cast<Z2>(row) * p.k);
      c.SetGlobalBuffer(reinterpret_cast<__gm__ Z1 *>(slot));
      cube.Run(p, t, a, c);
      CrossCoreSetFlag<2, PIPE_FIX>(dense::READY + index * 3);
    }
    if ASCEND_IS_AIV {
      CrossCoreWaitFlag(dense::READY + index * 3);
      for (Z0 col = 0; col < t.vn; col += BN) {
        for (Z0 i = 0; i < t.vm; i += edge::BM) {
          auto part = t;
          part.row += i;
          part.vm = Min(edge::BM, t.vm - i);
          part.col += col;
          part.vn = Min(BN, t.vn - col);
          finish.Run(p, part, slot + (static_cast<Z2>(col) * BM + i * BN) * 4);
        }
      }
      CrossCoreSetFlag<2, PIPE_MTE3>(dense::FREE + index * 3);
    }
  }
  if ASCEND_IS_AIC {
    cube.EndB();
  }
}
if ASCEND_IS_AIV {
  finish.Drain();
}
if ASCEND_IS_AIC {
  if (ordinal)
    CrossCoreWaitFlag(dense::FREE);
  if (ordinal > 1)
    CrossCoreWaitFlag(dense::FREE + 3);
}
}
} // namespace residentBands
namespace longBands {
using namespace AscendC;
using gmg::Fence;
using gmg::Min;
constexpr Z0 BM = 64, BN = edge::BN, BK = 64;
__aicore__ inline void SetColumn(gmg::GeneralTask &t, Z0 n, Z0 col, Z0 teams) {
Z0 strips = (n + 31) / 32;
t.col = (col * strips / teams) * 32;
t.vn = Min(n, ((col + 1) * strips / teams) * 32) - t.col;
}
template <bool Enabled> struct APanelReuse {};
template <> struct APanelReuse<true> {
Z0 groupedDepth_ = 64;
const __gm__ Z7 *cachedA_ = nullptr;
Z0 cachedARows_ = ~0U, cachedASpan_ = ~0U;
};
template <Z0 BM, Z0 BK, bool Prefix = false> class BandCube : private APanelReuse<Prefix && BM == 80 && BK == 64> {
TQue<TPosition::A1, 1> a1_;
TQue<TPosition::B1, Prefix ? 2 : 1> b1_;
TQue<TPosition::B1, 1> tailQ_;
LocalTensor<Z7> tail_, last_;
TQue<TPosition::B1, 1> lastQ_;
Z0 firstTail_ = 0;
bool hasLast_ = false, issueLast_ = false, waitLast_ = false;
Z0 head_ = 0, headBytes_ = 0, activeHead_ = 0;
bool prefetched_ = false, hasTail_ = false;
bool prepareTail_ = false, awaitTail_ = false;
GlobalTensor<Z7> tailSource_;
LocalTensor<Z7> resident_;
TQue<TPosition::A2, 2> a2_;
TQue<TPosition::B2, 2> b2_;
TQue<TPosition::CO1, 1> c1_;

public:
__aicore__ inline void Init(TPipe &pipe, Z0 k, Z0 columns, Z2 l1 = 0, bool moreThanOne = true) {
  const Z0 paddedK = (k + 31) / 32 * 32;
  pipe.InitBuffer(a1_, 1, paddedK * BM);
  head_ = paddedK;
  if constexpr (Prefix) {
    Z0 extra = (l1 - paddedK * BM) / columns - paddedK;
    if (moreThanOne)
      head_ = extra >= paddedK ? paddedK : extra / BK * BK;
    else
      head_ = Min(paddedK, 2 * BK);
  }
  headBytes_ = head_ * columns;
  pipe.InitBuffer(b1_, Prefix && moreThanOne ? 2 : 1, head_ * columns);
  if (Prefix && paddedK > head_) {
    const Z0 rest = paddedK - head_;
    firstTail_ = Min(rest, ((rest / 2 + BK - 1) / BK) * BK);
    pipe.InitBuffer(tailQ_, 1, firstTail_ * columns);
    if (rest > firstTail_)
      pipe.InitBuffer(lastQ_, 1, (rest - firstTail_) * columns);
  }
  if constexpr (Prefix && BM == 80 && BK == 64) {
    this->groupedDepth_ = columns <= 256 ? 128 : 64;
    pipe.InitBuffer(a2_, 2, this->groupedDepth_ * BM);
    pipe.InitBuffer(b2_, 2, this->groupedDepth_ * columns);
  } else {
    pipe.InitBuffer(a2_, 2, BK * BM);
    pipe.InitBuffer(b2_, 2, BK * columns);
  }
  pipe.InitBuffer(c1_, 1, 2 * dense::C_BYTES);
}
__aicore__ inline void LoadPiece(LocalTensor<Z7> bb, const edge::Parameters &p, const gmg::GeneralTask &t,
                                 GlobalTensor<Z7> b, Z0 span) {
  const Z0 stride = (span + 31) / 32 * 32;
  const Z0 strips = (t.vn + 31) / 32;
  if (t.vn % 32) {
    InitConstValue(bb[(strips - 1) * stride * 32].ReinterpretCast<Z0>(), InitConstValueParams<Z0>(1, stride, 0, 0));
    PipeBarrier<PIPE_MTE2>();
  }
  if (stride != span) {
    InitConstValue(bb[span * 32].ReinterpretCast<Z0>(), InitConstValueParams<Z0>(strips, stride - span, span, 0));
    PipeBarrier<PIPE_MTE2>();
  }
  DataCopy(bb, b, Nd2NzParams(1, span, t.vn, 0, p.n, stride, 1, 0));
}
__aicore__ inline Z0 HeadFor(const gmg::GeneralTask &t, Z0 span) const {
  Z0 cap = headBytes_ / ((t.vn + 31) / 32 * 32), full = (span + 31) / 32 * 32;
  return cap >= full ? full : cap / BK * BK;
}
__aicore__ inline void StageHead(const edge::Parameters &p, const gmg::GeneralTask &t, GlobalTensor<Z7> b, Z0 span) {
  LocalTensor<Z7> bb = b1_.template AllocTensor<Z7>();
  LoadPiece(bb, p, t, b, Min(HeadFor(t, span), span));
  b1_.EnQue(bb);
}
__aicore__ inline void BeginB(const edge::Parameters &p, const gmg::GeneralTask &t, GlobalTensor<Z7> b, Z0 span) {
  activeHead_ = HeadFor(t, span);
  if (!prefetched_)
    StageHead(p, t, b, span);
  prefetched_ = false;
  resident_ = b1_.template DeQue<Z7>();
  if constexpr (Prefix) {
    hasTail_ = span > activeHead_;
    if (hasTail_) {
      tailSource_ = b[static_cast<Z2>(activeHead_) * p.n];
      prepareTail_ = true;
    }
  }
}
__aicore__ inline void EndB() {
  b1_.FreeTensor(resident_);
  if (Prefix && hasTail_) {
    tailQ_.FreeTensor(tail_);
    if (hasLast_)
      lastQ_.FreeTensor(last_);
  }
}
__aicore__ inline void QueueLast(const edge::Parameters &p, const gmg::GeneralTask &t, Z0 span) {
  auto last = lastQ_.AllocTensor<Z7>();
  LoadPiece(last, p, t, tailSource_[static_cast<Z2>(firstTail_) * p.n], span - activeHead_ - firstTail_);
  lastQ_.EnQue(last);
  issueLast_ = false;
  waitLast_ = true;
}
__aicore__ inline void LoadMergedB(LocalTensor<Z7> b2, LocalTensor<Z7> bpanel, const edge::Parameters &p,
                                   const gmg::GeneralTask &t, Z0 kk, Z0 depth, Z0 stride, Z0 span, Z0 cols) {
  Z0 done = 0;
  while (done < depth) {
    Z0 logical = kk + done, offset = logical, pitchB = stride, finish = stride;
    auto bb = bpanel;
    if constexpr (Prefix) {
      pitchB = activeHead_;
      finish = activeHead_;
      if (logical >= activeHead_ + firstTail_ && logical >= activeHead_) {
        if (waitLast_) {
          last_ = lastQ_.DeQue<Z7>();
          waitLast_ = false;
        }
        bb = last_;
        pitchB = stride - activeHead_ - firstTail_;
        offset = logical - activeHead_ - firstTail_;
        finish = stride;
      } else if (logical >= activeHead_) {
        if (awaitTail_) {
          tail_ = tailQ_.DeQue<Z7>();
          awaitTail_ = false;
        }
        if (issueLast_)
          QueueLast(p, t, span);
        bb = tail_;
        pitchB = Min(firstTail_, stride - activeHead_);
        offset = logical - activeHead_;
        finish = activeHead_ + pitchB;
      }
    }
    Z0 amount = Min(depth - done, finish - logical);
    LoadData2dTransposeParams bp{0, static_cast<Z6>(cols / 32), static_cast<Z4>(pitchB / 32), 1, 0, inc};
    for (Z0 kb = 0; kb < amount; kb += 32)
      LoadDataWithTranspose(b2[(done + kb) * cols], bb[(offset + kb) * 32], bp);
    done += amount;
  }
}
template <bool guardSmall = false>
__aicore__ inline void Run(const edge::Parameters &p, const gmg::GeneralTask &t, GlobalTensor<Z7> a,
                           GlobalTensor<Z1> c, Z0 span, Z0 pitch, GM_ADDR upcoming = nullptr,
                           const gmg::GeneralTask *upcomingTask = nullptr, int reuse = -1) {
  const Z0 rows = (t.vm + 15) / 16 * 16;
  Z6 padding[4] = {};
  Load3DSetFMatrixCal(1, BM, padding);
  auto accum = c1_.AllocTensor<Z1>();
  auto aa = a1_.AllocTensor<Z7>();
  if constexpr (Prefix && BM == 80 && BK == 64) {
    if (this->cachedA_ != a.GetPhyAddr() || this->cachedARows_ != t.vm || this->cachedASpan_ != span) {
      DataCopy(aa, a, Nd2NzParams(1, t.vm, span, 0, p.k, BM, 1, 0));
      this->cachedA_ = a.GetPhyAddr();
      this->cachedARows_ = t.vm;
      this->cachedASpan_ = span;
    }
  } else {
    DataCopy(aa, a, Nd2NzParams(1, t.vm, span, 0, p.k, BM, 1, 0));
  }
  a1_.EnQue(aa);
  if constexpr (Prefix) {
    if (prepareTail_) {
      auto tb = tailQ_.AllocTensor<Z7>();
      LoadPiece(tb, p, t, tailSource_, Min(firstTail_, span - activeHead_));
      tailQ_.EnQue(tb);
      prepareTail_ = false;
      awaitTail_ = true;
      hasLast_ = span > activeHead_ + firstTail_;
      issueLast_ = hasLast_;
    }
  }
  if constexpr (Prefix) {
    if (upcoming) {
      GlobalTensor<Z7> next;
      next.SetGlobalBuffer(reinterpret_cast<__gm__ Z7 *>(upcoming));
      StageHead(p, upcomingTask ? *upcomingTask : t, next, span);
      prefetched_ = true;
    }
  }
  {
    const Z0 stride = (span + 31) / 32 * 32;
    auto apanel = a1_.DeQue<Z7>();
    auto bpanel = resident_;
    Z0 groupedDepth = BK;
    if constexpr (Prefix && BM == 80 && BK == 64)
      groupedDepth = this->groupedDepth_;
    for (Z0 kk = 0; kk < span; kk += groupedDepth) {
      const Z0 depth = Min(groupedDepth, stride - kk);
      auto a2 = a2_.AllocTensor<Z7>();
      LoadData3DParamsV2Pro ap;
      ap.channelSize = stride;
      ap.extConfig = (static_cast<Z2>(kk) << 32) | (static_cast<Z2>(rows) << 16) | depth;
      LoadData(a2, apanel, ap);
      a2_.EnQue(a2);
      auto ar = a2_.DeQue<Z7>();
      {
        const Z0 cols = (t.vn + 31) / 32 * 32;
        auto b2 = b2_.AllocTensor<Z7>();
        if constexpr (Prefix && BM == 80 && BK == 64) {
          LoadMergedB(b2, bpanel, p, t, kk, depth, stride, span, cols);
        } else {
          auto bb = bpanel;
          Z0 pitchB = stride, offset = kk;
          if constexpr (Prefix) {
            pitchB = activeHead_;
            if (kk >= activeHead_ + firstTail_ && kk >= activeHead_) {
              if (waitLast_) {
                last_ = lastQ_.DeQue<Z7>();
                waitLast_ = false;
              }
              bb = last_;
              pitchB = stride - activeHead_ - firstTail_;
              offset = kk - activeHead_ - firstTail_;
            } else if (kk >= activeHead_) {
              if (awaitTail_) {
                tail_ = tailQ_.DeQue<Z7>();
                awaitTail_ = false;
              }
              if (issueLast_)
                QueueLast(p, t, span);
              bb = tail_;
              pitchB = Min(firstTail_, stride - activeHead_);
              offset = kk - activeHead_;
            }
          }
          LoadData2dTransposeParams bp{0, static_cast<Z6>(cols / 32), static_cast<Z4>(pitchB / 32), 1, 0, inc};
          for (Z0 kb = 0; kb < depth; kb += 32) {
            LoadDataWithTranspose(b2[kb * cols], bb[(offset + kb) * 32], bp);
          }
        }
        b2_.EnQue(b2);
        auto br = b2_.DeQue<Z7>();
        MmadParams mp;
        mp.m = rows;
        mp.n = cols;
        mp.k = depth;
        mp.isBias = false;
        mp.cmatrixInitVal = (kk == 0);
        Mmad(accum, ar, br, mp);
        if (guardSmall && rows * cols <= 16 * 16 * 16 && kk + depth < span)
          PipeBarrier<PIPE_M>();
        b2_.FreeTensor(br);
      }
      a2_.FreeTensor(ar);
    }
    a1_.FreeTensor(apanel);
  }
  c1_.EnQue(accum);
  auto result = c1_.DeQue<Z1>();
  {
    FixpipeParamsV220 fp;
    fp.nSize = static_cast<Z4>((t.vn + 31) / 32 * 32);
    fp.mSize = t.vm;
    fp.srcStride = rows;
    fp.dstStride = pitch;
    fp.quantPre = QuantMode_t::NoQuant;
    fp.reluEn = false;
    if constexpr (guardSmall) {
      if (reuse >= 0)
        CrossCoreWaitFlag(dense::FREE + reuse * 3);
    }
    Fixpipe<Z1, Z1, CFG_ROW_MAJOR>(c, result, fp);
  }
  c1_.FreeTensor(result);
}
};
using Cube = BandCube<BM, BK>;
class SumFinish {
TBuf<TPosition::VECCALC> panel_;
GlobalTensor<Z8> scales_;
GlobalTensor<half> output_;
Z0 slowRepairs_ = 0;

public:
__aicore__ inline void Init(TPipe &pipe, GM_ADDR sc, GM_ADDR y) {
  pipe.InitBuffer(panel_, dense::PANEL_BYTES);
  scales_.SetGlobalBuffer(reinterpret_cast<__gm__ Z8 *>(sc));
  output_.SetGlobalBuffer(reinterpret_cast<__gm__ half *>(y));
}
__aicore__ inline void Run(const edge::Parameters &p, const gmg::GeneralTask &t, GlobalTensor<Z1> partial, Z0 splits,
                           Z2 splitStride, Z0 pitch) {
  const Z0 halfRows = (t.vm + 1) / 2, first = GetSubBlockIdx() * halfRows;
  if (first >= t.vm)
    return;
  const Z0 rows = Min(halfRows, t.vm - first), width = t.vn, count = rows * BN;
  auto ci = panel_.Get<Z1>();
  auto tmp = panel_.Get<Z1>()[dense::SP];
  auto scale = panel_.Get<Z8>()[5 * dense::SP + 8];
  auto out = panel_.Get<half>()[(dense::SP * 20 + 32 + BN * 4 + 4 * dense::MASK_BYTES) / 2];
  Duplicate(ci, static_cast<Z1>(0), count);
  Duplicate(tmp, static_cast<Z1>(0), count);
  Duplicate(scale, 0.0f, BN);
  Fence<HardEvent::V_MTE2>();
  DataCopyExtParams cp{static_cast<Z4>(rows), width * 4, (pitch - width) * 4, (BN - ((width + 7) / 8) * 8) / 8, 0};
  DataCopyPadExtParams<Z1> ip{true, 0, static_cast<Z6>((8 - width % 8) % 8), 0};
  DataCopyPad(ci, partial[first * pitch], cp, ip);
  DataCopyPad(scale, scales_[static_cast<Z2>(t.expert) * p.n + t.col], {1, width * 4, 0, 0, 0},
              {true, 0, static_cast<Z6>((8 - width % 8) % 8), 0});
  Fence<HardEvent::MTE2_V>();
  for (Z0 slice = 1; slice < splits; ++slice) {
    DataCopyPad(tmp, partial[slice * splitStride + first * pitch], cp, ip);
    Fence<HardEvent::MTE2_V>();
    Add(ci, ci, tmp, count);
    Fence<HardEvent::V_MTE2>();
  }
  PipeBarrier<PIPE_V>();
  dense::PanelGelu<dense::PE, BN>(ci, scale, panel_, count, slowRepairs_);
  DataCopyExtParams yp{static_cast<Z4>(rows), width * 2, (BN - ((width + 15) / 16) * 16) / 16, (p.n - width) * 2, 0};
  DataCopyPad(output_[static_cast<Z2>(t.row + first) * p.n + t.col], out, yp);
  Fence<HardEvent::MTE3_V>();
  Fence<HardEvent::MTE3_MTE2>();
}
};
template <Z0 Target>
__global__ __mix__(1, 2) void LongBandsKernel(GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR g, GM_ADDR y, GM_ADDR ws) {
edge::Parameters p;
auto src = reinterpret_cast<__gm__ Z0 *>(ws);
p.m = src[0];
p.n = src[1];
p.k = src[2];
p.e = src[3];
p.workers = src[4];
Z0 worker = GetBlockIdx();
if ASCEND_IS_AIV {
  worker /= 2;
}
const Z0 cols = (p.n + Target - 1) / Target, splits = p.workers / cols;
const Z0 units = (p.k + 31) / 32;
const Z0 pitch = (((p.n + 31) / 32 + cols - 1) / cols) * 32;
const Z2 stride = static_cast<Z2>(cols) * p.m * pitch;
GM_ADDR space = ws + (sizeof(p) + 511) / 512 * 512;
TPipe pipe;
Cube cube;
SumFinish finish;
const Z0 col = worker % cols, slice = worker / cols;
const Z0 base = (slice * units / splits) * 32, span = Min(p.k, ((slice + 1) * units / splits) * 32) - base;
gmg::GeneralTask band;
SetColumn(band, p.n, col, cols);
if ASCEND_IS_AIC {
  cube.Init(pipe, span, (band.vn + 31) / 32 * 32);
}
if ASCEND_IS_AIV {
  finish.Init(pipe, s, y);
}
const auto ends = reinterpret_cast<__gm__ Z3 *>(g);
Z0 first = 0, phase = 0;
for (Z0 e = 0; e < p.e; ++e) {
  const Z0 end = ends[e];
  if (first == end)
    continue;
  band.expert = e;
  if ASCEND_IS_AIC {
    GlobalTensor<Z7> b;
    b.SetGlobalBuffer(reinterpret_cast<__gm__ Z7 *>(w) + (static_cast<Z2>(e) * p.k + base) * p.n + band.col);
    cube.BeginB(p, band, b, span);
  }
  {
    const Z0 head = first, stop = end;
    const Z0 signal = phase % 2 * 3;
    if ASCEND_IS_AIC {
      for (Z0 r = head; r < stop; r += BM) {
        auto t = band;
        t.row = r;
        t.vm = Min(BM, stop - r);
        GlobalTensor<Z7> a;
        GlobalTensor<Z1> c;
        a.SetGlobalBuffer(reinterpret_cast<__gm__ Z7 *>(x) + static_cast<Z2>(r) * p.k + base);
        c.SetGlobalBuffer(reinterpret_cast<__gm__ Z1 *>(space) + slice * stride +
                          (static_cast<Z2>(col) * p.m + r) * pitch);
        cube.Run(p, t, a, c, span, pitch);
      }
      if (phase >= 2)
        CrossCoreWaitFlag(dense::FREE + signal);
      CrossCoreSetFlag<2, PIPE_FIX>(dense::READY + signal);
    }
    if ASCEND_IS_AIV {
      CrossCoreWaitFlag(dense::READY + signal);
      SyncAll<true>();
      CrossCoreSetFlag<2, PIPE_MTE3>(dense::FREE + signal);
      const Z0 from = head + (stop - head) * slice / splits, to = head + (stop - head) * (slice + 1) / splits;
      for (Z0 r = from; r < to; r += BM) {
        for (Z0 i = 0; i < band.vn; i += BN) {
          auto t = band;
          t.row = r;
          t.vm = Min(BM, to - r);
          t.col += i;
          t.vn = Min(BN, band.vn - i);
          GlobalTensor<Z1> all;
          all.SetGlobalBuffer(reinterpret_cast<__gm__ Z1 *>(space) + (static_cast<Z2>(col) * p.m + r) * pitch + i);
          finish.Run(p, t, all, splits, stride, pitch);
        }
      }
    }
    ++phase;
  }
  if ASCEND_IS_AIC {
    cube.EndB();
  }
  first = end;
}
if ASCEND_IS_AIC {
  if (phase)
    CrossCoreWaitFlag(dense::FREE);
  if (phase > 1)
    CrossCoreWaitFlag(dense::FREE + 3);
}
}
} // namespace longBands
namespace fusedKBands {
using namespace AscendC;
using gmg::Fence;
using gmg::Min;
constexpr Z0 BM = 96, BN = edge::BN, BK = 96;
class Cube {
TQue<TPosition::A1, 1> a1_;
TQue<TPosition::B1, 2> headQ_;
TQue<TPosition::B1, 1> tailQ_;
LocalTensor<Z7> tail_;
Z0 head_;
LocalTensor<Z7> building_;
LocalTensor<Z7> resident_;
bool firstFix_ = true;
Z0 tileM_;
TQue<TPosition::A2, 2> a2_;
TQue<TPosition::B2, 2> b2_;
TQue<TPosition::CO1, 1> c1_;

public:
__aicore__ inline void Init(TPipe &pipe, Z0 k, Z0 columns, Z0 tileM, Z2 l1) {
  tileM_ = tileM;
  const Z0 paddedK = (k + 31) / 32 * 32;
  pipe.InitBuffer(a1_, 1, paddedK * tileM_);
  Z0 extra = static_cast<Z0>((l1 - static_cast<Z2>(paddedK) * tileM_) / columns) - paddedK;
  head_ = extra >= paddedK ? paddedK : extra / BK * BK;
  pipe.InitBuffer(headQ_, 2, head_ * columns);
  if (paddedK > head_)
    pipe.InitBuffer(tailQ_, 1, (paddedK - head_) * columns);
  pipe.InitBuffer(a2_, 2, BK * tileM_);
  pipe.InitBuffer(b2_, 2, BK * columns);
  pipe.InitBuffer(c1_, 1, 2 * dense::C_BYTES);
}
__aicore__ inline void Load(const edge::Parameters &p, const gmg::GeneralTask &t, LocalTensor<Z7> bb,
                            GlobalTensor<Z7> src, Z0 span) {
  Z0 stride = (span + 31) / 32 * 32;
  if (stride != span) {
    InitConstValue(bb[span * 32].ReinterpretCast<Z0>(),
                   InitConstValueParams<Z0>((t.vn + 31) / 32, stride - span, span, 0));
    PipeBarrier<PIPE_MTE2>();
  }
  DataCopy(bb, src, Nd2NzParams(1, span, t.vn, 0, p.n, stride, 1, 0));
}
__aicore__ inline void StageHead(const edge::Parameters &p, const gmg::GeneralTask &t, GlobalTensor<Z7> b, Z0 span) {
  auto head = headQ_.AllocTensor<Z7>();
  Load(p, t, head, b, Min(span, head_));
  headQ_.EnQue(head);
}
__aicore__ inline void StagePart(const edge::Parameters &p, const gmg::GeneralTask &t, GlobalTensor<Z7> b, Z0 span,
                                 bool begin, bool done) {
  Z0 total = Min(span, head_), pitch = (total + 31) / 32 * 32;
  Z0 middle = Min(total, ((pitch / 2 + 31) / 32) * 32);
  if (begin)
    building_ = headQ_.AllocTensor<Z7>();
  Z0 start = begin ? 0 : middle, end = done ? total : middle;
  if (done && pitch > total) {
    InitConstValue(building_[total * 32].ReinterpretCast<Z0>(),
                   InitConstValueParams<Z0>((t.vn + 31) / 32, pitch - total, total, 0));
    PipeBarrier<PIPE_MTE2>();
  }
  if (end > start)
    DataCopy(building_[start * 32], b[static_cast<Z2>(start) * p.n],
             Nd2NzParams(1, end - start, t.vn, 0, p.n, pitch, 1, 0));
  if (done)
    headQ_.EnQue(building_);
}
__aicore__ inline void Activate(const edge::Parameters &p, const gmg::GeneralTask &t, GlobalTensor<Z7> b, Z0 span) {
  resident_ = headQ_.DeQue<Z7>();
  if (span > head_) {
    auto tail = tailQ_.AllocTensor<Z7>();
    Load(p, t, tail, b[static_cast<Z2>(head_) * p.n], span - head_);
    tailQ_.EnQue(tail);
    tail_ = tailQ_.DeQue<Z7>();
  }
}
__aicore__ inline void EndB(Z0 span) {
  headQ_.FreeTensor(resident_);
  if (span > head_)
    tailQ_.FreeTensor(tail_);
}
__aicore__ inline void Run(const edge::Parameters &p, const gmg::GeneralTask &t, GlobalTensor<Z7> a,
                           GlobalTensor<Z1> c, Z0 span, Z0 pitch, GlobalTensor<Z7> nextB, bool begin, bool done) {
  const Z0 rows = (t.vm + 15) / 16 * 16;
  Z6 padding[4] = {};
  Load3DSetFMatrixCal(1, tileM_, padding);
  auto accum = c1_.AllocTensor<Z1>();
  auto aa = a1_.AllocTensor<Z7>();
  DataCopy(aa, a, Nd2NzParams(1, t.vm, span, 0, p.k, tileM_, 1, 0));
  a1_.EnQue(aa);
  if (begin || done)
    StagePart(p, t, nextB, span, begin, done);
  {
    const Z0 stride = (span + 31) / 32 * 32;
    auto apanel = a1_.DeQue<Z7>();
    for (Z0 kk = 0; kk < span; kk += BK) {
      const Z0 depth = Min(BK, stride - kk);
      auto a2 = a2_.AllocTensor<Z7>();
      LoadData3DParamsV2Pro ap;
      ap.channelSize = stride;
      ap.extConfig = (static_cast<Z2>(kk) << 32) | (static_cast<Z2>(rows) << 16) | depth;
      LoadData(a2, apanel, ap);
      a2_.EnQue(a2);
      auto ar = a2_.DeQue<Z7>();
      {
        const Z0 cols = (t.vn + 31) / 32 * 32;
        bool front = kk < head_;
        auto bpanel = front ? resident_ : tail_;
        Z0 offset = front ? kk : kk - head_, bstride = front ? head_ : stride - head_;
        auto b2 = b2_.AllocTensor<Z7>();
        LoadData2dTransposeParams bp{0, static_cast<Z6>(cols / 32), static_cast<Z4>(bstride / 32), 1, 0, inc};
        for (Z0 kb = 0; kb < depth; kb += 32) {
          LoadDataWithTranspose(b2[kb * cols], bpanel[(offset + kb) * 32], bp);
        }
        b2_.EnQue(b2);
        auto br = b2_.DeQue<Z7>();
        MmadParams mp;
        mp.m = rows;
        mp.n = cols;
        mp.k = depth;
        mp.isBias = false;
        mp.cmatrixInitVal = (kk == 0);
        Mmad(accum, ar, br, mp);
        b2_.FreeTensor(br);
      }
      a2_.FreeTensor(ar);
    }
    a1_.FreeTensor(apanel);
  }
  c1_.EnQue(accum);
  auto result = c1_.DeQue<Z1>();
  {
    FixpipeParamsV220 fp;
    fp.nSize = static_cast<Z4>((t.vn + 31) / 32 * 32);
    fp.mSize = t.vm;
    fp.srcStride = rows;
    fp.dstStride = pitch;
    fp.quantPre = QuantMode_t::NoQuant;
    fp.reluEn = false;
    if (firstFix_) {
      CrossCoreWaitFlag(gmg::INPUT_READY);
      firstFix_ = false;
    }
    SetAtomicAdd<Z1>();
    Fixpipe<Z1, Z1, CFG_ROW_MAJOR>(c, result, fp);
    SetAtomicNone();
  }
  c1_.FreeTensor(result);
}
};
class SumFinish {
TBuf<TPosition::VECCALC> panel_;
GlobalTensor<Z8> scales_;
GlobalTensor<half> output_;
Z0 slowRepairs_ = 0;

public:
__aicore__ inline void Init(TPipe &pipe, GM_ADDR sc, GM_ADDR y) {
  pipe.InitBuffer(panel_, dense::PANEL_BYTES + (320 - BN) * 4);
  scales_.SetGlobalBuffer(reinterpret_cast<__gm__ Z8 *>(sc));
  output_.SetGlobalBuffer(reinterpret_cast<__gm__ half *>(y));
}
__aicore__ inline void Clear(GM_ADDR space, Z2 elems, Z0 worker, Z0 workers) {
  Z0 lane = worker * 2 + GetSubBlockIdx(), lanes = workers * 2;
  Z2 start = (elems / 8 * lane / lanes) * 8, stop = (elems / 8 * (lane + 1) / lanes) * 8;
  GlobalTensor<Z1> g;
  g.SetGlobalBuffer(reinterpret_cast<__gm__ Z1 *>(space));
  auto zero = panel_.Get<Z1>();
  Duplicate(zero, static_cast<Z1>(0), dense::PE);
  Fence<HardEvent::V_MTE3>();
  for (Z2 r = start; r < stop; r += dense::PE)
    DataCopy(g[r], zero, static_cast<Z0>(stop - r < dense::PE ? stop - r : dense::PE));
  Fence<HardEvent::MTE3_V>();
  SyncAll<true>();
  CrossCoreSetFlag<2, PIPE_MTE3>(gmg::INPUT_READY);
}
template <Z0 VC>
__aicore__ inline void Run(const edge::Parameters &p, const gmg::GeneralTask &t, GlobalTensor<Z1> partial, Z0 pitch) {
  const Z0 halfRows = (t.vm + 1) / 2, first = GetSubBlockIdx() * halfRows;
  if (first >= t.vm)
    return;
  const Z0 rows = Min(halfRows, t.vm - first), width = t.vn, count = rows * VC;
  auto ci = panel_.Get<Z1>();
  auto scale = panel_.Get<Z8>()[5 * dense::SP + 8];
  auto out = panel_.Get<half>()[(dense::SP * 20 + 32 + VC * 4 + 4 * dense::MASK_BYTES) / 2];
  if (width != VC) {
    Duplicate(ci, static_cast<Z1>(0), count);
    Duplicate(scale, 0.0f, VC);
    Fence<HardEvent::V_MTE2>();
  }
  DataCopyExtParams cp{static_cast<Z4>(rows), width * 4, (pitch - width) * 4, (VC - ((width + 7) / 8) * 8) / 8, 0};
  DataCopyPadExtParams<Z1> ip{true, 0, static_cast<Z6>((8 - width % 8) % 8), 0};
  DataCopyPad(ci, partial[first * pitch], cp, ip);
  DataCopyPad(scale, scales_[static_cast<Z2>(t.expert) * p.n + t.col], {1, width * 4, 0, 0, 0},
              {true, 0, static_cast<Z6>((8 - width % 8) % 8), 0});
  Fence<HardEvent::MTE2_V>();
  dense::PanelGelu<dense::PE, VC>(ci, scale, panel_, count, slowRepairs_);
  DataCopyExtParams yp{static_cast<Z4>(rows), width * 2, (VC - ((width + 15) / 16) * 16) / 16, (p.n - width) * 2, 0};
  DataCopyPad(output_[static_cast<Z2>(t.row + first) * p.n + t.col], out, yp);
  Fence<HardEvent::MTE3_V>();
  Fence<HardEvent::MTE3_MTE2>();
}
};
__global__ __mix__(1, 2) void LongBandsKernel(GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR g, GM_ADDR y, GM_ADDR ws, Z0 cut,
                                            Z0 left, Z0 lm, Z0 rm, Z2 l1) {
edge::Parameters p;
auto src = reinterpret_cast<__gm__ Z0 *>(ws);
p.m = src[0];
p.n = src[1];
p.k = src[2];
p.e = src[3];
p.workers = src[4];
Z0 worker = GetBlockIdx();
if ASCEND_IS_AIV {
  worker /= 2;
}
const Z0 col = (worker >= left), splits = col ? p.workers - left : left;
const Z0 units = (p.k + 31) / 32;
const Z0 pitch = (p.n + 31) / 32 * 32;
const Z2 stride = static_cast<Z2>(p.m) * pitch;
GM_ADDR space = ws + (sizeof(p) + 511) / 512 * 512;
TPipe pipe;
Cube cube;
SumFinish finish;
const Z0 slice = col ? worker - left : worker, tileM = col ? rm : lm;
const Z0 base = (slice * units / splits) * 32, span = Min(p.k, ((slice + 1) * units / splits) * 32) - base;
gmg::GeneralTask band;
band.col = col ? cut : 0;
band.vn = col ? p.n - cut : cut;
if ASCEND_IS_AIC {
  cube.Init(pipe, span, (band.vn + 31) / 32 * 32, tileM, l1);
}
if ASCEND_IS_AIV {
  finish.Init(pipe, s, y);
  finish.Clear(space, stride, worker, p.workers);
}
const auto ends = reinterpret_cast<__gm__ Z3 *>(g);
Z0 first = 0, phase = 0;
for (Z0 e = 0; e < p.e; ++e) {
  const Z0 end = ends[e];
  if (first == end)
    continue;
  band.expert = e;
  Z0 next = e + 1;
  while (next < p.e && ends[next] == end)
    ++next;
  if ASCEND_IS_AIC {
    GlobalTensor<Z7> b;
    b.SetGlobalBuffer(reinterpret_cast<__gm__ Z7 *>(w) + (static_cast<Z2>(e) * p.k + base) * p.n + band.col);
    if (!phase)
      cube.StageHead(p, band, b, span);
    cube.Activate(p, band, b, span);
  }
  {
    const Z0 head = first, stop = end;
    const Z0 signal = phase % 2 * 3;
    if ASCEND_IS_AIC {
      for (Z0 r = head; r < stop; r += tileM) {
        auto t = band;
        t.row = r;
        t.vm = Min(tileM, stop - r);
        GlobalTensor<Z7> a;
        GlobalTensor<Z1> c;
        a.SetGlobalBuffer(reinterpret_cast<__gm__ Z7 *>(x) + static_cast<Z2>(r) * p.k + base);
        c.SetGlobalBuffer(reinterpret_cast<__gm__ Z1 *>(space) + static_cast<Z2>(r) * pitch + band.col);
        GlobalTensor<Z7> nextB;
        if (next < p.e)
          nextB.SetGlobalBuffer(reinterpret_cast<__gm__ Z7 *>(w) + (static_cast<Z2>(next) * p.k + base) * p.n +
                                band.col);
        bool last = r + tileM >= stop;
        bool begin = (r + 2 * tileM >= stop && (r == head || !last));
        cube.Run(p, t, a, c, span, pitch, nextB, next < p.e && begin, next < p.e && last);
      }
      if (phase >= 2)
        CrossCoreWaitFlag(dense::FREE + signal);
      CrossCoreSetFlag<2, PIPE_FIX>(dense::READY + signal);
    }
    if ASCEND_IS_AIV {
      CrossCoreWaitFlag(dense::READY + signal);
      SyncAll<true>();
      CrossCoreSetFlag<2, PIPE_MTE3>(dense::FREE + signal);
      const Z0 from = head + (stop - head) * slice / splits, to = head + (stop - head) * (slice + 1) / splits;
      for (Z0 r = from; r < to; r += 2 * (dense::PE / 320)) {
        for (Z0 i = 0; i < band.vn; i += 320) {
          auto t = band;
          t.row = r;
          t.vm = Min(2 * (dense::PE / 320), to - r);
          t.col += i;
          t.vn = Min(320U, band.vn - i);
          GlobalTensor<Z1> all;
          all.SetGlobalBuffer(reinterpret_cast<__gm__ Z1 *>(space) + static_cast<Z2>(r) * pitch + band.col + i);
          if (t.vn <= 64)
            finish.Run<64>(p, t, all, pitch);
          else if (t.vn <= 128)
            finish.Run<128>(p, t, all, pitch);
          else if (t.vn <= 192)
            finish.Run<192>(p, t, all, pitch);
          else if (t.vn <= 256)
            finish.Run<256>(p, t, all, pitch);
          else
            finish.Run<320>(p, t, all, pitch);
        }
      }
    }
    ++phase;
  }
  if ASCEND_IS_AIC {
    cube.EndB(span);
  }
  first = end;
}
if ASCEND_IS_AIC {
  if (phase)
    CrossCoreWaitFlag(dense::FREE);
  if (phase > 1)
    CrossCoreWaitFlag(dense::FREE + 3);
}
}
} // namespace fusedKBands
namespace residentBands {
template <Z0 RowCap> class StripCursor {
const __gm__ Z3 *ends_;
bool useStrips_ = false, reorder_ = false, longTurn_ = true;
Z0 mean_ = 0, shortIndex_ = 0, longIndex_ = 0, sequential_ = 0;
Z0 bandCol_ = 0, bandWidth_ = 0, previous_ = 0;
Z0 experts_, rows_, columns_, strips_, limit_, setup_;
Z0 expert_ = 0, row_ = 0, rowsHere_ = 0, strip_ = 0, stop_ = 0;
Z2 cost_ = 0, begin_, end_;
__aicore__ inline Z0 Cut(Z2 edge, Z0 unit) {
  return edge <= cost_ ? 0 : static_cast<Z0>(Min(strips_, static_cast<Z0>((edge - cost_ + unit / 2) / unit)));
}

public:
__aicore__ inline void Init(const edge::Parameters &p, GM_ADDR g, Z0 worker, Z0 limit, Z0 setup, Z0 bandCol,
                            Z0 bandWidth, Z0 team, Z0 teams) {
  ends_ = reinterpret_cast<const __gm__ Z3 *>(g);
  experts_ = p.e;
  rows_ = p.m;
  columns_ = p.n;
  strips_ = (p.n + 63) / 64;
  limit_ = limit / 2;
  setup_ = setup;
  bandCol_ = bandCol;
  bandWidth_ = bandWidth;
  Z0 last = 0, active = 0, longest = 0, shortest = p.m;
  Z2 range = 0;
  bool previousShort = false, clustered = false;
  for (Z0 e = 0; e < experts_; ++e) {
    Z0 end = ends_[e], length = end - last;
    last = end;
    if (length) {
      const bool shortExpert = length <= RowCap / 8;
      clustered = clustered || (previousShort && shortExpert);
      previousShort = shortExpert;
      ++active;
      range += StripCost(length);
      if (length > longest)
        longest = length;
      if (length < shortest)
        shortest = length;
    }
  }
  useStrips_ = longest <= RowCap && limit_ > 0;
  mean_ = active ? rows_ / active : 0;
  reorder_ = useStrips_ && clustered && longest > shortest + RowCap / 4;
  if (useStrips_) {
    const Z2 total = static_cast<Z2>(strips_) * range;
    begin_ = total * worker / p.workers;
    end_ = total * (worker + 1) / p.workers;
  } else {
    const Z2 total = rows_ + static_cast<Z2>(active) * setup_;
    begin_ = total * team / teams;
    end_ = total * (team + 1) / teams;
  }
}
__aicore__ inline Z0 StripCost(Z0 rows) {
  return 2 * setup_ + ((rows + 15) / 16) * 16 + ((rows + 79) / 80) * 32;
}
__aicore__ inline bool UsesStrips() const {
  return useStrips_;
}
__aicore__ inline bool NextBand(gmg::GeneralTask &t) {
  while (expert_ < experts_ && cost_ < end_) {
    const Z0 e = expert_++, last = ends_[e], length = last - previous_, start = previous_;
    previous_ = last;
    if (!length)
      continue;
    const Z2 first = cost_ + setup_;
    cost_ = first + length;
    if (cost_ <= begin_ || first >= end_)
      continue;
    const Z0 offset = begin_ > first ? static_cast<Z0>(begin_ - first) : 0;
    t.row = start + offset;
    t.vm = Min(length, static_cast<Z0>(end_ - first)) - offset;
    t.expert = e;
    t.col = bandCol_;
    t.vn = bandWidth_;
    return true;
  }
  return false;
}
__aicore__ inline Z0 NextExpert(bool large) {
  Z0 &index = large ? longIndex_ : shortIndex_;
  while (index < experts_) {
    Z0 e = index++;
    Z0 begin = e ? ends_[e - 1] : 0, len = static_cast<Z0>(ends_[e]) - begin;
    if (len && ((len > mean_) == large))
      return e;
  }
  return experts_;
}
__aicore__ inline bool Next(gmg::GeneralTask &t) {
  if (!useStrips_)
    return NextBand(t);
  while (strip_ >= stop_) {
    if (cost_ >= end_)
      return false;
    if (reorder_) {
      expert_ = NextExpert(longTurn_);
      if (expert_ == experts_)
        expert_ = NextExpert(!longTurn_);
      longTurn_ = !longTurn_;
    } else
      expert_ = sequential_++;
    if (expert_ >= experts_)
      return false;
    row_ = expert_ ? ends_[expert_ - 1] : 0;
    rowsHere_ = static_cast<Z0>(ends_[expert_]) - row_;
    if (!rowsHere_)
      continue;
    Z0 unit = StripCost(rowsHere_);
    strip_ = Cut(begin_, unit);
    stop_ = Cut(end_, unit);
    cost_ += static_cast<Z2>(unit) * strips_;
  }
  const Z0 remaining = stop_ - strip_, count = (remaining + limit_ - 1) / limit_;
  const Z0 take = (remaining + count - 1) / count;
  t.row = row_;
  t.vm = rowsHere_;
  t.col = strip_ * 64;
  t.vn = Min(columns_ - t.col, take * 64);
  t.expert = expert_;
  strip_ += take;
  return true;
}
};
template <Z0 BM, Z0 BK, Z0 Target>
__global__ __mix__(1, 2) void BalancedBandsKernel(GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR g, GM_ADDR y, GM_ADDR ws,
                                                Z2 l1) {
edge::Parameters p;
auto config = reinterpret_cast<__gm__ Z0 *>(ws);
p.m = config[0];
p.n = config[1];
p.k = config[2];
p.e = config[3];
p.workers = config[4];
Z0 worker = GetBlockIdx();
if ASCEND_IS_AIV {
  worker /= 2;
}
const Z0 columns = (p.n + Target - 1) / Target;
const Z0 strips = (p.n + 31) / 32;
const Z0 limit = (strips * ((p.workers + columns - 1) / columns) + p.workers - 1) / p.workers;
const Z0 col = worker % columns, team = worker / columns;
const Z0 teams = (p.workers + columns - 1 - col) / columns;
const Z0 before = col * (p.workers / columns) + Min(col, p.workers % columns);
const Z0 bandCol = (before * strips / p.workers) * 32;
const Z0 bandWidth = Min(p.n, ((before + teams) * strips / p.workers) * 32) - bandCol;
StripCursor<4 * BM> cursor;
cursor.Init(p, g, worker, limit, ((p.k + 9) / 10 + 15) / 16 * 16, bandCol, bandWidth, team, teams);
TPipe pipe;
longBands::BandCube<BM, BK, true> cube;
Finish finish;
if ASCEND_IS_AIC {
  auto plan = cursor;
  gmg::GeneralTask assigned;
  Z0 widest = 0, count = 0;
  while (plan.Next(assigned)) {
    Z0 pitch = (assigned.vn + 31) / 32 * 32;
    if (pitch > widest)
      widest = pitch;
    ++count;
  }
  if (count)
    cube.Init(pipe, p.k, widest, l1, count > 1);
}
if ASCEND_IS_AIV {
  finish.Init(pipe, s, y, (384 - residentBands::BN) * sizeof(Z8));
}
GM_ADDR slots = ws + (sizeof(p) + 511) / 512 * 512 + worker * 4ULL * dense::C_BYTES;
Z0 ordinal = 0;
gmg::GeneralTask slab, next;
bool valid = cursor.Next(slab);
while (valid) {
  bool more = cursor.Next(next);
  const Z0 pitch = (slab.vn + 31) / 32 * 32;
  GM_ADDR upcoming = nullptr;
  if ASCEND_IS_AIC {
    GlobalTensor<Z7> weights;
    weights.SetGlobalBuffer(reinterpret_cast<__gm__ Z7 *>(w) + static_cast<Z2>(slab.expert) * p.k * p.n + slab.col);
    cube.BeginB(p, slab, weights, p.k);
    if (more)
      upcoming = w + static_cast<Z2>(next.expert) * p.k * p.n + next.col;
  }
  const Z0 stop = slab.row + slab.vm;
  for (Z0 row = slab.row; row < stop; row += BM, ++ordinal) {
    auto t = slab;
    t.row = row;
    t.vm = Min(BM, stop - row);
    const Z0 index = ordinal % 2;
    GM_ADDR slot = slots + index * 2 * dense::C_BYTES;
    if ASCEND_IS_AIC {
      GlobalTensor<Z7> a;
      GlobalTensor<Z1> c;
      a.SetGlobalBuffer(reinterpret_cast<__gm__ Z7 *>(x) + static_cast<Z2>(row) * p.k);
      c.SetGlobalBuffer(reinterpret_cast<__gm__ Z1 *>(slot));
      cube.template Run<true>(p, t, a, c, p.k, pitch, row + BM >= stop ? upcoming : nullptr, &next,
                              ordinal >= 2 ? static_cast<int>(index) : -1);
      CrossCoreSetFlag<2, PIPE_FIX>(dense::READY + index * 3);
    }
    if ASCEND_IS_AIV {
      CrossCoreWaitFlag(dense::READY + index * 3);
      const Z0 vc = (t.vn + 63) / 64 * 64;
      const Z0 step = 2 * (dense::PE / vc);
      for (Z0 i = 0; i < t.vm; i += step) {
        auto part = t;
        part.row += i;
        part.vm = Min(step, t.vm - i);
        GM_ADDR source = slot + static_cast<Z2>(i) * pitch * 4;
        if (vc == 384)
          finish.Run<384, 384>(p, part, source, pitch);
        else if (vc == 320)
          finish.Run<320, 384>(p, part, source, pitch);
        else if (vc == 256)
          finish.Run<256, 384>(p, part, source, pitch);
        else if (vc == 192)
          finish.Run<192, 384>(p, part, source, pitch);
        else if (vc == 128)
          finish.Run<128, 384>(p, part, source, pitch);
        else
          finish.Run<64, 384>(p, part, source, pitch);
      }
      CrossCoreSetFlag<2, PIPE_MTE3>(dense::FREE + index * 3);
    }
  }
  if ASCEND_IS_AIC {
    cube.EndB();
  }
  valid = more;
  if (more)
    slab = next;
}
if ASCEND_IS_AIV {
  finish.Drain();
}
if ASCEND_IS_AIC {
  if (ordinal)
    CrossCoreWaitFlag(dense::FREE);
  if (ordinal > 1)
    CrossCoreWaitFlag(dense::FREE + 3);
}
}
} // namespace residentBands
namespace hcBand {
static void Launch(GM_ADDR, GM_ADDR, GM_ADDR, GM_ADDR, GM_ADDR, GM_ADDR, Z0, Z2, aclrtStream);
}
static void RunFallback(GM_ADDR x, const TensorGroupInfo &info_x, GM_ADDR weight, const TensorGroupInfo &info_weight,
                      GM_ADDR scale, const TensorGroupInfo &info_scale, GM_ADDR group_list,
                      const TensorGroupInfo &info_group_list, GM_ADDR y, const TensorGroupInfo &info_y,
                      Z3 availableCoreNum, aclrtStream stream) {
const auto xs = info_x.tensors[0].shape, ws = info_weight.tensors[0].shape;
const Z3 m = xs[0], k = xs[1], e = ws[0], n = ws[2];
auto platform = platform_ascendc::PlatformAscendCManager::GetInstance();
if (platform && n >= 128 && m >= 16 && k >= 1) {
  const Z0 workers =
      std::min<Z2>(availableCoreNum, std::min(platform->GetCoreNumAic(), platform->GetCoreNumAiv() / 2));
  const Z2 minTasks = ((m + edge::BM - 1) / edge::BM) * ((n + edge::BN - 1) / edge::BN);
  Z2 l1 = 0, l0a = 0, l0b = 0, l0c = 0, ub = 0;
  platform->GetCoreMemSize(platform_ascendc::CoreMemType::L1, l1);
  platform->GetCoreMemSize(platform_ascendc::CoreMemType::L0_A, l0a);
  platform->GetCoreMemSize(platform_ascendc::CoreMemType::L0_B, l0b);
  platform->GetCoreMemSize(platform_ascendc::CoreMemType::L0_C, l0c);
  platform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ub);
  const Z0 bk = std::min<Z0>(128, (k + 31) / 32 * 32);
  if (workers && (2 * minTasks >= workers || (k >= 1024 && minTasks >= 2)) && l0a >= edge::BM * bk &&
      l0b >= edge::BN * bk && l0c >= dense::C_BYTES && ub >= dense::PANEL_BYTES) {
    edge::Parameters p{};
    p.m = m;
    p.n = n;
    p.k = k;
    p.e = e;
    p.workers = workers;
    matmul_tiling::MatmulApiTiling tiler(*platform);
    host_workspace::SetInt8Operands(tiler);
    tiler.SetShape(edge::BM, edge::BN, k);
    tiler.SetOrgShape(edge::BM, n, k);
    tiler.SetFixSplit(edge::BM, edge::BN, bk);
    tiler.SetBufferSpace(l1, l0c, ub);
    if (tiler.GetTiling(p.cube) == 0 && p.cube.baseM == edge::BM && p.cube.baseN == edge::BN && p.cube.baseK == bk &&
        p.cube.shareL1Size <= l1 && p.cube.shareL0CSize <= l0c && p.cube.shareUbSize <= ub) {
      const Z2 pairTasks = ((m + edge::BM - 1) / edge::BM) * ((n + edgepair::PAIR - 1) / edgepair::PAIR);
      const bool alignedTail = k % 32 == 0 && k >= 2 * edgepair::KP && k <= 4 * edgepair::KP && n % 32 == 0 &&
                               n > 3 * edgepair::PAIR + edge::BN && n < 4 * edgepair::PAIR && m <= e * edge::BM &&
                               pairTasks >= 4ULL * workers;
      const bool pair = k >= edgepair::BK && n >= edgepair::PAIR && (k % 32 || n % 32 || alignedTail) &&
                        pairTasks >= workers && l1 >= edgepair::L1_BYTES && l0a >= 2 * edgepair::BM * edgepair::BK &&
                        l0b >= 2 * edgepair::BN * edgepair::BK && l0c >= 2 * dense::C_BYTES;
      const Z2 paddedK = (k + 31) / 32 * 32;
      const Z2 columnTiles = (n + residentBands::BN - 1) / residentBands::BN;
      const bool fullWidth = n % residentBands::BN == 0 && paddedK * (edge::BM + 2 * residentBands::BN) <= l1;
      const Z2 tileRows = fullWidth ? edge::BM : 2 * edge::BM;
      const Z2 tileColumns = fullWidth ? 2 * residentBands::BN : residentBands::BN;
      const Z2 teams = (n + tileColumns - 1) / tileColumns;
      const bool bands = columnTiles == 2 && workers >= teams && k >= 2 * residentBands::BK &&
                         m >= 2 * tileRows * e && m >= 2 * tileRows * ((workers + teams - 1) / teams) &&
                         paddedK * (tileRows + tileColumns) <= l1 && l0a >= 2 * tileRows * residentBands::BK &&
                         l0b >= 2 * residentBands::BN * residentBands::BK && l0c >= 2 * dense::C_BYTES;
      constexpr Z0 target = 320;
      const Z0 columns = (n + target - 1) / target;
      const Z0 slices = workers / columns;
      const Z2 maxWidth = (((n + 31) / 32 + columns - 1) / columns) * 32;
      const Z2 maxSpan = slices ? ((paddedK / 32 + slices - 1) / slices) * 32 : 0;
      const bool longPath = workers % columns == 0 && columnTiles >= 3 && n % edge::BN > 0 &&
                            n % edge::BN <= edge::BN / 2 && paddedK * (edge::BM + edge::BN) >= 3 * l1 &&
                            e <= workers && m >= e * edge::BM && (m + edge::BM - 1) / edge::BM + e <= 2 * workers &&
                            slices >= 2 && slices <= paddedK / 32 &&
                            maxWidth * longBands::BM * sizeof(Z1) <= 2 * dense::C_BYTES &&
                            maxSpan * (maxWidth + longBands::BM) <= l1 && l0a >= 2 * longBands::BM * longBands::BK &&
                            l0b >= 2 * maxWidth * longBands::BK && l0c >= 2 * dense::C_BYTES;
      const Z0 stripeCount = (n + 31) / 32;
      const Z0 cut = (stripeCount * 5 / 8) * 32;
      const Z0 lw = cut, rw = stripeCount * 32 - cut;
      const auto tile = [](Z0 w) { return std::min<Z0>(112, (2 * dense::C_BYTES / (4 * w)) / 16 * 16); };
      const Z0 lm = tile(lw), rm = tile(rw);
      const auto needed = [&](Z0 w, Z0 h) {
        Z0 units = l1 / ((w + h) * 32);
        return units ? static_cast<Z0>((paddedK / 32 + units - 1) / units) : workers + 1;
      };
      const Z0 minL = needed(lw, lm), minR = needed(rw, rm);
      const Z0 left =
            minL + minR <= workers
                ? std::max(minL, std::min(workers - minR, static_cast<Z0>((workers * lw + (lw + rw) / 2) / (lw + rw))))
                : 0;
        const auto fits = [&](Z0 lanes, Z0 width, Z0 height) {
          if (!lanes)
            return false;
          const Z2 span = (paddedK / 32 + lanes - 1) / lanes * 32;
          const Z2 head = std::min<Z2>(span, ((span / 2 + fusedKBands::BK - 1) / fusedKBands::BK) * fusedKBands::BK);
          return span * height + (2 * head + std::max<Z2>(32, span - head)) * width <= l1;
        };
        const bool atomicPath =
            longPath && fits(left, lw, lm) && fits(workers - left, rw, rm) &&
            ub >= dense::PANEL_BYTES + (320 - edge::BN) * 4 && columnTiles >= 3 && n % edge::BN > 0 &&
            n % edge::BN <= edge::BN / 2 && paddedK * (edge::BM + edge::BN) >= 3 * l1 && e <= workers &&
            m >= e * edge::BM && (m + edge::BM - 1) / edge::BM + e <= 2 * workers && left && left < workers &&
            paddedK / 32 >= workers && cut < n && lm && rm && l0a >= 2 * std::max(lm, rm) * fusedKBands::BK &&
            l0b >= 2 * std::max(lw, rw) * fusedKBands::BK && l0c >= 2 * dense::C_BYTES;
        constexpr Z0 panelTarget = 384, panelRows = 80, panelK = 64;
        const Z2 panelTeams = (n + panelTarget - 1) / panelTarget;
        const Z2 panelWidth = ((stripeCount * ((workers + panelTeams - 1) / panelTeams) + workers - 1) / workers) * 32;
        const bool compact = stripeCount * (workers / panelTeams) >= workers && pair && !bands && !longPath &&
                             columnTiles >= 3 && n % edge::BN > 0 && n % edge::BN <= edge::BN / 4 &&
                             panelTeams <= workers && (m + e - 1) >= e * panelRows &&
                             m >= panelRows * ((workers + panelTeams - 1) / panelTeams) &&
                             paddedK * (panelRows + panelWidth) + panelK * panelWidth <= l1 &&
                             panelRows * panelWidth * 4 <= 2 * dense::C_BYTES && 2 * panelRows * panelK <= l0a &&
                             2 * panelWidth * panelK <= l0b && panelWidth <= 384 &&
                             ub >= dense::PANEL_BYTES + (384 - residentBands::BN) * sizeof(Z8);
        const bool columnOnly =
            workers < panelTeams || panelWidth > 384 || stripeCount * (workers / panelTeams) < workers;
        const bool narrowWorkers = columnOnly && pair && !bands && !longPath && m >= e * panelRows &&
                                   m >= panelRows * ((workers + panelTeams - 1) / panelTeams) &&
                                   paddedK * (96 + 256) + 64 * 256 <= l1 && 2 * 256 * 64 <= l0b &&
                                   l0c >= 2 * dense::C_BYTES;
        const bool hcWindow = (compact || narrowWorkers) && n / edge::BN >= 4 && n % edge::BN > 0 &&
                              n % edge::BN <= edge::BN / 4 && n % 64 > 0 && n % 64 <= 8 && 2 * 96 * 64 <= l0a &&
                              ub >= dense::PANEL_BYTES + (448 - edge::BN) * sizeof(Z8);
        const Z2 bytes =
            (sizeof(p) + 511) / 512 * 512 + (atomicPath ? static_cast<Z2>(m) * stripeCount * 32 * sizeof(Z1)
                                             : longPath ? static_cast<Z2>(slices) * columns * m * maxWidth * sizeof(Z1)
                                                        : ((bands || pair) ? 4ULL : 2ULL) * workers * dense::C_BYTES);
        host_workspace::Parameters workspace;

        if (workspace.Prepare(bytes, p)) {
          if (atomicPath)
            fusedKBands::LongBandsKernel<<<workers, nullptr, stream>>>(x, weight, scale, group_list, y,
                                                                       workspace.Data(), cut, left, lm, rm, l1);
          else if (longPath)
            longBands::LongBandsKernel<320>
                <<<workers, nullptr, stream>>>(x, weight, scale, group_list, y, workspace.Data());
          else if (hcWindow)
            hcBand::Launch(x, weight, scale, group_list, y, workspace.Data(), workers, l1, stream);
          else if (compact)
            residentBands::BalancedBandsKernel<panelRows, panelK, panelTarget>
                <<<workers, nullptr, stream>>>(x, weight, scale, group_list, y, workspace.Data(), l1);
          else if (bands && fullWidth)
            residentBands::ResidentBandsKernel<edge::BM, 2 * residentBands::BN>
                <<<workers, nullptr, stream>>>(x, weight, scale, group_list, y, workspace.Data());
          else if (bands)
            residentBands::ResidentBandsKernel<2 * edge::BM, residentBands::BN>
                <<<workers, nullptr, stream>>>(x, weight, scale, group_list, y, workspace.Data());
          else if (pair)
            edgepair::Kernel<true><<<workers, nullptr, stream>>>(x, weight, scale, group_list, y, workspace.Data());
          else
            edge::Kernel<<<workers, nullptr, stream>>>(x, weight, scale, group_list, y, workspace.Data());
          workspace.Retire(stream);
          return;
        }
      }
    }
  }
  RunGeneral(x, info_x, weight, info_weight, scale, info_scale, group_list, info_group_list, y, info_y,
             availableCoreNum, stream);
}
namespace outer1 {
using namespace AscendC;
using gmg::Min;
using gmg::Fence;
constexpr Z0 R = 16, B = 256, P = R * B, S = P + 64, MASK = (P / 8 + 255) / 256 * 256;
constexpr Z0 PANEL = S * 20 + 32 + B * 4 + 4 * MASK + P * 2;
constexpr Z0 EXTRA = 1024 + 32 + B + 2 * B + 4 * B;
__global__ __aicore__ void Kernel(GM_ADDR xp, GM_ADDR wp, GM_ADDR sp, GM_ADDR gp, GM_ADDR yp, Z0 m, Z0 n, Z0 e,
                                  Z0 workers) {
  KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
  TPipe pipe;
  TBuf<TPosition::VECCALC> panel, aux;
  pipe.InitBuffer(panel, PANEL);
  pipe.InitBuffer(aux, EXTRA);
  auto groups = aux.Get<Z3>();
  auto xv = aux.Get<Z7>()[1024];
  auto wb = aux.Get<Z7>()[1056];
  auto wh = aux.Get<half>()[(1056 + B) / 2];
  auto wf = aux.Get<Z8>()[(1056 + 3 * B) / 4];
  auto ci = panel.Get<Z1>();
  auto sc = panel.Get<Z8>()[5 * S + 8];
  auto out = panel.Get<half>()[(S * 20 + 32 + B * 4 + 4 * MASK) / 2];
  GlobalTensor<Z7> x, w;
  GlobalTensor<Z3> g;
  GlobalTensor<Z8> scale;
  GlobalTensor<half> y;
  x.SetGlobalBuffer(reinterpret_cast<__gm__ Z7 *>(xp));
  w.SetGlobalBuffer(reinterpret_cast<__gm__ Z7 *>(wp));
  g.SetGlobalBuffer(reinterpret_cast<__gm__ Z3 *>(gp));
  scale.SetGlobalBuffer(reinterpret_cast<__gm__ Z8 *>(sp));
  y.SetGlobalBuffer(reinterpret_cast<__gm__ half *>(yp));
  DataCopyPad(groups, g, {1, e * 8, 0, 0, 0}, {false, 0, 0, 0});
  Fence<HardEvent::MTE2_S>();
  Z0 firstExpert = 0, slow = 0;
  const Z0 nt = (n + B - 1) / B, total = (m + R - 1) / R * nt;
  for (Z0 task = GetBlockIdx(); task < total; task += workers) {
    const Z0 row = (task / nt) * R, col = (task % nt) * B;
    const Z0 stop = Min(row + R, m), width = Min(B, n - col);
    while (firstExpert < e && static_cast<Z0>(groups.GetValue(firstExpert)) <= row)
      ++firstExpert;
    Z0 expert = firstExpert;
    DataCopyPad(xv, x[row], {1, stop - row, 0, 0, 0}, {false, 0, 0, 0});
    Fence<HardEvent::MTE2_S>();
    for (Z0 pos = row; pos < stop;) {
      while (expert < e && static_cast<Z0>(groups.GetValue(expert)) <= pos)
        ++expert;
      if (expert == e)
        return;
      const Z0 rows = Min(stop, static_cast<Z0>(groups.GetValue(expert))) - pos;
      if (width != B) {
        Duplicate(wf, 0.0f, B);
        Duplicate(sc, 0.0f, B);
        Duplicate(wb.ReinterpretCast<Z5>(), static_cast<Z5>(0), B / 2);
        Fence<HardEvent::V_MTE2>();
      }
      const Z2 addr = static_cast<Z2>(expert) * n + col;
      DataCopyPad(wb, w[addr], {1, width, 0, 0, 0}, {true, 0, static_cast<Z6>((32 - width % 32) % 32), 0});
      DataCopyPad(sc, scale[addr], {1, width * 4, 0, 0, 0}, {true, 0, static_cast<Z6>((8 - width % 8) % 8), 0});
      Fence<HardEvent::MTE2_V>();
      Cast(wh, wb, RoundMode::CAST_NONE, B);
      PipeBarrier<PIPE_V>();
      Cast(wf, wh, RoundMode::CAST_NONE, B);
      PipeBarrier<PIPE_V>();
      auto prod = panel.Get<Z8>()[S];
      for (Z0 j = 0; j < rows; ++j) {
        const Z8 xvrow = static_cast<Z8>(xv.GetValue(pos - row + j));
        Muls(prod[j * B], wf, xvrow, B);
      }
      PipeBarrier<PIPE_V>();
      Cast(ci, prod, RoundMode::CAST_RINT, rows * B);
      PipeBarrier<PIPE_V>();
      dense::PanelGelu<P, B>(ci, sc, panel, rows * B, slow);
      DataCopyExtParams cp{static_cast<Z4>(rows), width * 2, (B - ((width + 15) / 16) * 16) / 16, (n - width) * 2, 0};
      DataCopyPad(y[static_cast<Z2>(pos) * n + col], out, cp);
      Fence<HardEvent::MTE3_V>();
      Fence<HardEvent::MTE3_MTE2>();
      pos += rows;
    }
    Fence<HardEvent::S_MTE2>();
  }
}
} // namespace outer1
namespace shortdot {
using namespace AscendC;
using gmg::Min;
using gmg::Fence;
constexpr Z0 R = 16, B = 256, P = R * B, S = P + 64, MASK = (P / 8 + 255) / 256 * 256;
constexpr Z0 PANEL = S * 20 + 32 + B * 4 + 4 * MASK + P * 2;
constexpr Z0 EXTRA = 1024 + 64 + 4 * B * (1 + 2 + 4);
template <Z0 K>
__global__ __aicore__ void Kernel(GM_ADDR xp, GM_ADDR wp, GM_ADDR sp, GM_ADDR gp, GM_ADDR yp, Z0 m, Z0 n, Z0 e,
                                  Z0 workers) {
  KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
  TPipe pipe;
  TBuf<TPosition::VECCALC> panel, aux;
  pipe.InitBuffer(panel, PANEL);
  pipe.InitBuffer(aux, EXTRA);
  auto groups = aux.Get<Z3>();
  auto xv = aux.Get<Z7>()[1024];
  auto wb = aux.Get<Z7>()[1088];
  auto wh = aux.Get<half>()[(1088 + 4 * B) / 2];
  auto wf = aux.Get<Z8>()[(1088 + 12 * B) / 4];
  auto ci = panel.Get<Z1>();
  auto sc = panel.Get<Z8>()[5 * S + 8];
  auto out = panel.Get<half>()[(S * 20 + 32 + B * 4 + 4 * MASK) / 2];
  GlobalTensor<Z7> x, w;
  GlobalTensor<Z3> g;
  GlobalTensor<Z8> scale;
  GlobalTensor<half> y;
  x.SetGlobalBuffer(reinterpret_cast<__gm__ Z7 *>(xp));
  w.SetGlobalBuffer(reinterpret_cast<__gm__ Z7 *>(wp));
  g.SetGlobalBuffer(reinterpret_cast<__gm__ Z3 *>(gp));
  scale.SetGlobalBuffer(reinterpret_cast<__gm__ Z8 *>(sp));
  y.SetGlobalBuffer(reinterpret_cast<__gm__ half *>(yp));
  DataCopyPad(groups, g, {1, e * 8, 0, 0, 0}, {false, 0, 0, 0});
  Fence<HardEvent::MTE2_S>();
  Z0 firstExpert = 0, slow = 0;
  const Z0 nt = (n + B - 1) / B, total = (m + R - 1) / R * nt;
  for (Z0 task = GetBlockIdx(); task < total; task += workers) {
    const Z0 row = (task / nt) * R, col = (task % nt) * B;
    const Z0 stop = Min(row + R, m), width = Min(B, n - col);
    while (firstExpert < e && static_cast<Z0>(groups.GetValue(firstExpert)) <= row)
      ++firstExpert;
    Z0 expert = firstExpert;
    DataCopyPad(xv, x[static_cast<Z2>(row) * K], {1, (stop - row) * K, 0, 0, 0}, {false, 0, 0, 0});
    Fence<HardEvent::MTE2_S>();
    for (Z0 pos = row; pos < stop;) {
      while (expert < e && static_cast<Z0>(groups.GetValue(expert)) <= pos)
        ++expert;
      if (expert == e)
        return;
      const Z0 rows = Min(stop, static_cast<Z0>(groups.GetValue(expert))) - pos;
      if (width != B) {
        Duplicate(sc, 0.0f, B);
        Duplicate(wb.ReinterpretCast<Z5>(), static_cast<Z5>(0), K * B / 2);
        Fence<HardEvent::V_MTE2>();
      }
      const Z2 addr = static_cast<Z2>(expert) * n + col;
      DataCopyPad(wb, w[static_cast<Z2>(expert) * K * n + col],
                  {static_cast<Z4>(K), width, n - width, (B - ((width + 31) / 32) * 32) / 32, 0},
                  {true, 0, static_cast<Z6>((32 - width % 32) % 32), 0});
      DataCopyPad(sc, scale[addr], {1, width * 4, 0, 0, 0}, {true, 0, static_cast<Z6>((8 - width % 8) % 8), 0});
      Fence<HardEvent::MTE2_V>();
      Cast(wh, wb, RoundMode::CAST_NONE, K * B);
      PipeBarrier<PIPE_V>();
      Cast(wf, wh, RoundMode::CAST_NONE, K * B);
      PipeBarrier<PIPE_V>();
      auto prod = panel.Get<Z8>()[S];
      for (Z0 d = 0; d < K; ++d) {
        for (Z0 j = 0; j < rows; ++j) {
          const Z8 xval = static_cast<Z8>(xv.GetValue((pos - row + j) * K + d));
          if (d == 0)
            Muls(prod[j * B], wf, xval, B);
          else
            Axpy(prod[j * B], wf[d * B], xval, B);
        }
        PipeBarrier<PIPE_V>();
      }
      Cast(ci, prod, RoundMode::CAST_RINT, rows * B);
      PipeBarrier<PIPE_V>();
      dense::PanelGelu<P, B>(ci, sc, panel, rows * B, slow);
      DataCopyExtParams cp{static_cast<Z4>(rows), width * 2, (B - ((width + 15) / 16) * 16) / 16, (n - width) * 2, 0};
      DataCopyPad(y[static_cast<Z2>(pos) * n + col], out, cp);
      Fence<HardEvent::MTE3_V>();
      Fence<HardEvent::MTE3_MTE2>();
      pos += rows;
    }
    Fence<HardEvent::S_MTE2>();
  }
}
} // namespace shortdot

