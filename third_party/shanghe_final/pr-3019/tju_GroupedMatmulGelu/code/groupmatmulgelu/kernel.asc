namespace quick16Ep {
__aicore__ __attribute__((noinline, section(".gmg_deep16_vec"))) inline Z4 SharedRepairHalf(Z8 z, Z4 h) {
return p12math::QuickCorrectHalf(z, h);
}
template <Z0 BM, Z0 BN, Z0 MODE> class ScreenEpilogue {
public:
static constexpr Z0 HALF_ROWS = (BM + 1) / 2;
static constexpr Z0 SIZE = 8192;
__aicore__ inline void Init(TPipe &pipe, GM_ADDR scale, GM_ADDR y) {
pipe.InitBuffer(rawBuf_, SIZE * 4 + 256);
pipe.InitBuffer(rawNextBuf_, SIZE * 4 + 256);
pipe.InitBuffer(zBuf_, SIZE * 4 + 256);
pipe.InitBuffer(tBuf_, SIZE * 4 + 256);
pipe.InitBuffer(workBuf_, SIZE * 4 + 256);
pipe.InitBuffer(outBuf_, SIZE * 2);
pipe.InitBuffer(maskBuf_, 4 * Up(SIZE / 8, 256));
pipe.InitBuffer(scaleBuf_, Up(BN, 64) * 4);
pipe.InitBuffer(constMaskBuf_, 256);
Duplicate(constMaskBuf_.Get<Z1>(), Z1(MODE >= 2 ? (0x2000 - (1U << (MODE + 2))) : (MODE == 1 ? 0x1ff0 : 0x1ffc)),
          64);
PipeBarrier<PIPE_V>();
pipe.InitBuffer(indexBuf_, Up((SIZE + 31) / 32, 64) * 4);
Duplicate(maskBuf_.Get<Z1>(), Z1(0), 4 * Up(SIZE / 8, 256) / 4);
CreateVecIndex(indexBuf_.Get<Z8>(), 0.0f, Up((SIZE + 31) / 32, 64));
PipeBarrier<PIPE_V>();
ResetMask();
scale_.SetGlobalBuffer(reinterpret_cast<__gm__ Z8 *>(scale));
y_.SetGlobalBuffer(reinterpret_cast<__gm__ half *>(y));
}
__aicore__ inline void Process(const GlobalTensor<Z1> &scratch, Z0 expert, Z0 row, Z0 col, Z0 rows, Z0 cols, Z0 n,
                             Z0 sub) {
Z0 split = (rows + 1) / 2, first = sub * split, active = first < rows ? Min(split, rows - first) : 0;
if (!active) {
  CrossCoreSetFlag<0x2, PIPE_MTE2>(RELEASE);
  return;
}
constexpr Z0 chunk = SIZE / BN;
Z0 take = Min(chunk, active), remaining = active - take;
auto raw = rawBuf_.Get<Z1>(), rawNext = rawNextBuf_.Get<Z1>();
DataCopy(raw, scratch[first * BN], take * BN);
if (remaining)
  DataCopy(rawNext, scratch[(first + take) * BN], remaining * BN);
if (expert != cachedExpert_ || col != cachedCol_) {
  DataCopy(scaleBuf_.Get<Z8>(), scale_[(Z2)expert * n + col], BN);
  cachedExpert_ = expert;
  cachedCol_ = col;
}
CrossCoreSetFlag<0x2, PIPE_MTE2>(RELEASE);
SetFlag<HardEvent::MTE2_V>(EVENT_ID1);
WaitFlag<HardEvent::MTE2_V>(EVENT_ID1);
ProcessPart(raw, expert, row + first, col, take, cols, n, 0, false);
if (remaining)
  ProcessPart(rawNext, expert, row + first + take, col, remaining, cols, n, 0, false);
}
__aicore__ inline void ProcessPart(LocalTensor<Z1> input, Z0 expert, Z0 row, Z0 col, Z0 rows, Z0 cols, Z0 n, Z0 sub,
                                 bool release) {
Z0 split = rows;
Z0 first = sub * split;
Z0 active = first < rows ? Min(split, rows - first) : 0;
if (active == 0) {
  if (release)
    CrossCoreSetFlag<0x2, PIPE_MTE2>(RELEASE);
} else {
  Z0 width = Up(cols, 16);
  Z0 validCount = active * width;
  Z0 count = Up(validCount, 64);
  auto raw = input;
  auto z = zBuf_.Get<Z8>();
  auto t = tBuf_.Get<Z8>();
  auto work = workBuf_.Get<Z8>();
  auto sc = scaleBuf_.Get<Z8>();
  auto out = outBuf_.Get<half>();
  Cast(z, raw, RoundMode::CAST_RINT, count);
  PipeBarrier<PIPE_V>();
  for (Z0 c = 0; c < width; c += 64) {
    Mul(z[c], z[c], sc[c], static_cast<Z2>(Min(64, width - c)), static_cast<Z6>(active),
        BinaryRepeatParams{1, 1, 1, static_cast<Z6>(width / 8), static_cast<Z6>(width / 8), 0});
  }
  PipeBarrier<PIPE_V>();
  ResetMask();
  SetMaskCount();
  SetVectorMask<Z8, MaskMode::COUNTER>(0, count);
  Mul<Z8, false>(t, z, z, Z2(64), 1, BinaryRepeatParams{1, 1, 1, 8, 8, 8});
  Duplicate<Z8, false>(work, -1.5957691216057308f, Z2(64), 1, 1, 8);
  Axpy<Z8, Z8, false>(work, t, -0.071354816275f, Z2(64), 1, UnaryRepeatParams{1, 1, 8, 8});
  Mul<Z8, false>(t, work, z, Z2(64), 1, BinaryRepeatParams{1, 1, 1, 8, 8, 8});
  Exp<Z8, false>(t, t, Z2(64), 1, UnaryRepeatParams{1, 1, 8, 8});
  Adds<Z8, false>(t, t, 1.0f, Z2(64), 1, UnaryRepeatParams{1, 1, 8, 8});
  auto result = raw.ReinterpretCast<Z8>();
  if (MODE == 0) {
    Div<Z8, false>(result, z, t, Z2(64), 1, BinaryRepeatParams{1, 1, 1, 8, 8, 8});
  } else if (MODE == 1) {
    Reciprocal<Z8, false>(t, t, Z2(64), 1, UnaryRepeatParams{1, 1, 8, 8});
    Mul<Z8, false>(result, z, t, Z2(64), 1, BinaryRepeatParams{1, 1, 1, 8, 8, 8});
  } else {
    Mins<Z8, false>(t, t, 3.0e38f, Z2(64), 1, UnaryRepeatParams{1, 1, 8, 8});
    Reciprocal<Z8, false>(work, t, Z2(64), 1, UnaryRepeatParams{1, 1, 8, 8});
    Mul<Z8, false>(result, t, work, Z2(64), 1, BinaryRepeatParams{1, 1, 1, 8, 8, 8});
    Adds<Z8, false>(result, result, -2.0f, Z2(64), 1, UnaryRepeatParams{1, 1, 8, 8});
    Mul<Z8, false>(t, result, work, Z2(64), 1, BinaryRepeatParams{1, 1, 1, 8, 8, 8});
    Muls<Z8, false>(t, t, -1.0f, Z2(64), 1, UnaryRepeatParams{1, 1, 8, 8});
    Mul<Z8, false>(result, z, t, Z2(64), 1, BinaryRepeatParams{1, 1, 1, 8, 8, 8});
  }
  SetMaskNorm();
  ResetMask();
  if (MODE != 0) {
    CompareScalar(maskBuf_.Get<Z6>(), z, 8.0f, CMPMODE::GE, count);
    PipeBarrier<PIPE_V>();
    Select(result, maskBuf_.Get<Z6>(), z, result, SELMODE::VSEL_TENSOR_TENSOR_MODE, count);
    PipeBarrier<PIPE_V>();
  }
  if (outputPending_) {
    SetFlag<HardEvent::MTE3_V>(EVENT_ID5);
    WaitFlag<HardEvent::MTE3_V>(EVENT_ID5);
  }
  Cast(out, result, RoundMode::CAST_RINT, count);
  PipeBarrier<PIPE_V>();
  bool repaired = RepairMidpoints(z, result, t, work, out, validCount, width, cols);
  SetFlag<HardEvent::V_MTE3>(EVENT_ID2);
  WaitFlag<HardEvent::V_MTE3>(EVENT_ID2);
  if (repaired) {
    SetFlag<HardEvent::S_MTE3>(EVENT_ID3);
    WaitFlag<HardEvent::S_MTE3>(EVENT_ID3);
  }
  auto dest = y_[static_cast<Z2>(row + first) * n + col];
  if (cols == n && cols == width)
    DataCopy(dest, out, validCount);
  else
    DataCopyPad(dest, out, DataCopyExtParams{static_cast<Z4>(active), cols * 2, 0, (n - cols) * 2, 0});
  outputPending_ = true;
}
}

private:
__aicore__ inline void MaskOr(LocalTensor<Z6> dst, LocalTensor<Z6> a, LocalTensor<Z6> b, Z0 words) {
auto d = dst.ReinterpretCast<Z5>();
auto x = a.ReinterpretCast<Z5>(), y = b.ReinterpretCast<Z5>();
for (Z0 i = 0; i < words; i += 128)
  Or(d[i], x[i], y[i], static_cast<Z2>(Min(128, words - i)), 1, BinaryRepeatParams{1, 1, 1, 8, 8, 8});
PipeBarrier<PIPE_V>();
ResetMask();
}
__aicore__ inline void MaskAnd(LocalTensor<Z6> dst, LocalTensor<Z6> a, LocalTensor<Z6> b, Z0 words) {
auto d = dst.ReinterpretCast<Z5>();
auto x = a.ReinterpretCast<Z5>(), y = b.ReinterpretCast<Z5>();
for (Z0 i = 0; i < words; i += 128)
  And(d[i], x[i], y[i], static_cast<Z2>(Min(128, words - i)), 1, BinaryRepeatParams{1, 1, 1, 8, 8, 8});
PipeBarrier<PIPE_V>();
ResetMask();
}
__aicore__ inline bool RepairMidpoints(LocalTensor<Z8> z, LocalTensor<Z8> result, LocalTensor<Z8> absolute,
                                     LocalTensor<Z8> work, LocalTensor<half> out, Z0 validCount, Z0 width,
                                     Z0 cols) {
Z0 count = Up(validCount, 64), pad = Up(SIZE / 8, 256);
auto masks = maskBuf_.Get<Z6>(), lower = masks[pad], regions = masks[2 * pad], low = masks[3 * pad];
auto bits32 = work.ReinterpretCast<Z1>();
Adds(bits32, result.ReinterpretCast<Z1>(), Z1(MODE >= 2 ? (1U << (MODE + 1)) : (MODE == 1 ? 8 : 1)), count);
PipeBarrier<PIPE_V>();
And(work.ReinterpretCast<Z5>(), work.ReinterpretCast<Z5>(), constMaskBuf_.Get<Z5>(), Z2(128),
    static_cast<Z6>(count / 64), BinaryRepeatParams{1, 1, 1, 8, 8, 0});
PipeBarrier<PIPE_V>();
CompareScalar(masks, bits32, Z1(0x1000), CMPMODE::EQ, count);
CompareScalar(regions, z, 2.0f, CMPMODE::GE, count);
PipeBarrier<PIPE_V>();
MaskAnd(masks, masks, regions, (count + 15) / 16);
auto words = masks.ReinterpretCast<Z1>();
Z0 wc = (count + 31) / 32;
Cast(work, words, RoundMode::CAST_RINT, Up(wc, 64));
CompareScalar(regions, work, 0.0f, CMPMODE::NE, Up(wc, 64));
Z2 selected = 0;
GatherMask(work, indexBuf_.Get<Z8>(), regions.ReinterpretCast<Z0>(), true, wc, GatherMaskParams{1, 1, 8, 1},
           selected);
ResetMask();
SetFlag<HardEvent::V_S>(EVENT_ID4);
WaitFlag<HardEvent::V_S>(EVENT_ID4);
auto bits = out.ReinterpretCast<Z4>();
bool repaired = false;
for (Z0 j = 0; j < static_cast<Z0>(selected); ++j) {
  Z0 word = static_cast<Z0>(static_cast<Z1>(work.GetValue(j))), candidates = (Z0)words.GetValue(word);
  while (candidates) {
    Z0 bit = (Z0)(63 - ScalarCountLeadingZero((Z2)candidates));
    candidates ^= 1U << bit;
    Z0 i = word * 32 + bit;
    if (i >= validCount || i % width >= cols)
      continue;
    Z4 previous = bits.GetValue(i);
    Z0 h = previous & 0x7fffU;
    if (h < 0x4000U)
      continue;
    Z8 zi = z.GetValue(i);
    if (zi == 0.0f || zi >= 8.0f || zi <= -6.0f)
      continue;
    Z4 corrected = SharedRepairHalf(zi, previous);
    if (corrected != previous) {
      bits.SetValue(i, corrected);
      repaired = true;
    }
  }
}
return repaired;
}
TBuf<TPosition::VECCALC> rawBuf_, rawNextBuf_, zBuf_, tBuf_, workBuf_;
TBuf<TPosition::VECCALC> outBuf_, maskBuf_, scaleBuf_;
TBuf<TPosition::VECCALC> indexBuf_;
TBuf<TPosition::VECCALC> constMaskBuf_;
GlobalTensor<Z8> scale_;
GlobalTensor<half> y_;
Z0 cachedExpert_ = 0xffffffffU, cachedCol_ = 0xffffffffU;
bool outputPending_ = false;
};
} // namespace quick16Ep
} // namespace gmg
#undef GMG_DEEP28_CODE
