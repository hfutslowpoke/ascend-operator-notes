namespace ha36sched2epi {
template <Z0 BM, Z0 BN, Z0 MODE, Z0 PAD> class ScreenEpilogue {
public:
  static constexpr Z0 HALF_ROWS = (BM + 1) / 2;
  static constexpr Z0 SIZE = 8192;
  __aicore__ inline void Init(TPipe &pipe, GM_ADDR scale, GM_ADDR y) {
    pipe.InitBuffer(rawBuf_, SIZE * 4 + 256);
    pipe.InitBuffer(zBuf_, SIZE * 4 + 256);
    pipe.InitBuffer(tBuf_, SIZE * 4 + 256);
    pipe.InitBuffer(outBuf_, SIZE * 2);
    pipe.InitBuffer(outNextBuf_, SIZE * 2);
    pipe.InitBuffer(maskBuf_, 4 * Up(SIZE / 8, 256) + SIZE);
    pipe.InitBuffer(scaleBuf_, Up(BN, 64) * 4);
    pipe.InitBuffer(constMaskBuf_, 256);
    Duplicate(constMaskBuf_.Get<Z1>(), Z1(MODE == 1 ? 0x1ff0 : 0x1ffc), 64);
    pipe.InitBuffer(indexBuf_, Up((SIZE + 31) / 32, 64) * 4);
    Duplicate(maskBuf_.Get<Z1>(), Z1(0), 4 * Up(SIZE / 8, 256) / 4);
    CreateVecIndex(indexBuf_.Get<Z8>(), 0.0f, Up((SIZE + 31) / 32, 64));
    ResetMask();
    pipe.InitBuffer(rawNextBuf_, SIZE * 4 + 256);
    pipe.InitBuffer(scaleNextBuf_, Up(BN, 64) * 4);
    pipe.InitBuffer(scaleAllBuf_, 448 * 4);
    Duplicate(scaleAllBuf_.Get<Z8>(), 0.0f, 448);
    scaleAddress_ = reinterpret_cast<__gm__ Z8 *>(scale);
    outputAddress_ = reinterpret_cast<__gm__ half *>(y);
  }
  template <class ITERATOR>
  __aicore__ inline bool Process(const GlobalTensor<Z1> &scratch, const ha36sched2job::Job &job, Z0 n, Z0 sub,
                                 ITERATOR &jobs, ha36sched2job::Job &next, const GlobalTensor<Z1> &base, Z0 core,
                                 Z0 sequence) {
    Z0 expert = job.expert, row = job.row, col = job.col, rows = job.rows, cols = job.cols;
    Z0 split = (rows + 1) / 2, first = sub * split, active = first < rows ? Min(split, rows - first) : 0;
    Z0 width = Up(cols, 16), validCount = active * width, count = Up(validCount, 64);
    if (!inputReady_)
      LoadInput(scratch, job, n, sub, phase_);
    WaitFlag<HardEvent::MTE2_V>(EVENT_ID1);
    bool hasNext = false;
    if (active) {
      auto raw = (phase_ ? rawNextBuf_ : rawBuf_).template Get<Z1>();
      auto sc = scaleAllBuf_.Get<Z8>()[col];
      auto z = zBuf_.Get<Z8>(), t = tBuf_.Get<Z8>(), work = raw.ReinterpretCast<Z8>();
      auto out = (phase_ ? outNextBuf_ : outBuf_).template Get<half>();
      Cast(z, raw, RoundMode::CAST_RINT, count);
      for (Z0 c = 0; c < width; c += 64) {
        Mul(z[c], z[c], sc[c], static_cast<Z2>(Min(64, width - c)), static_cast<Z6>(active),
            BinaryRepeatParams{1, 1, 1, static_cast<Z6>(width / 8), static_cast<Z6>(width / 8), 0});
      }
      ResetMask();
      SetMaskCount();
      SetVectorMask<Z8, MaskMode::COUNTER>(0, count);
      Mul<Z8, false>(t, z, z, Z2(64), 1, BinaryRepeatParams{1, 1, 1, 8, 8, 8});
      Muls<Z8, false>(t, t, -0.071354816275f, Z2(64), 1, UnaryRepeatParams{1, 1, 8, 8});
      Adds<Z8, false>(t, t, -1.5957691216057308f, Z2(64), 1, UnaryRepeatParams{1, 1, 8, 8});
      Mul<Z8, false>(t, t, z, Z2(64), 1, BinaryRepeatParams{1, 1, 1, 8, 8, 8});
      Exp<Z8, false>(t, t, Z2(64), 1, UnaryRepeatParams{1, 1, 8, 8});
      Adds<Z8, false>(t, t, 1.0f, Z2(64), 1, UnaryRepeatParams{1, 1, 8, 8});
      if (MODE == 0) {
        Div<Z8, false>(t, z, t, Z2(64), 1, BinaryRepeatParams{1, 1, 1, 8, 8, 8});
      } else {
        auto inv = (phase_ ? rawBuf_ : rawNextBuf_).template Get<Z8>();
        Mins<Z8, false>(t, t, 3.0e38f, Z2(64), 1, UnaryRepeatParams{1, 1, 8, 8});
        Reciprocal<Z8, false>(inv, t, Z2(64), 1, UnaryRepeatParams{1, 1, 8, 8});
        for (Z0 nr = 0; nr < 2; ++nr) {
          Mul<Z8, false>(work, t, inv, Z2(64), 1, BinaryRepeatParams{1, 1, 1, 8, 8, 8});
          Adds<Z8, false>(work, work, -2.0f, Z2(64), 1, UnaryRepeatParams{1, 1, 8, 8});
          Mul<Z8, false>(work, work, inv, Z2(64), 1, BinaryRepeatParams{1, 1, 1, 8, 8, 8});
          Muls<Z8, false>(inv, work, -1.0f, Z2(64), 1, UnaryRepeatParams{1, 1, 8, 8});
        }
        Mul<Z8, false>(t, z, inv, Z2(64), 1, BinaryRepeatParams{1, 1, 1, 8, 8, 8});
      }
      SetMaskNorm();
      ResetMask();
      auto result = t;
      if (MODE != 0) {
        CompareScalar(maskBuf_.Get<Z6>(), z, 8.0f, CMPMODE::GE, count);
        Select(result, maskBuf_.Get<Z6>(), z, result, SELMODE::VSEL_TENSOR_TENSOR_MODE, count);
      }
      if (MODE != 0) {
        SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
        WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
      }
      hasNext = Prefetch(jobs, next, base, core, sequence, n, sub);
      if (outReady_[phase_]) {
        WaitFlag<HardEvent::MTE3_V>((event_t)(5 + phase_));
        outReady_[phase_] = false;
      }
      Cast(out, result, RoundMode::CAST_RINT, count);
      bool repaired = RepairMidpoints(z, result, result, work, out, validCount, width, cols);
      SetFlag<HardEvent::V_MTE3>(EVENT_ID2);
      WaitFlag<HardEvent::V_MTE3>(EVENT_ID2);
      if (repaired) {
        SetFlag<HardEvent::S_MTE3>(EVENT_ID3);
        WaitFlag<HardEvent::S_MTE3>(EVENT_ID3);
      }
      GlobalTensor<half> output;
      output.SetGlobalBuffer(outputAddress_);
      auto dest = output[static_cast<Z2>(row + first) * n + col];
      if (cols == n && cols == width)
        DataCopy(dest, out, validCount);
      else
        DataCopyPad(dest, out, DataCopyExtParams{static_cast<Z4>(active), cols * 2, 0, (n - cols) * 2, 0});
      SetFlag<HardEvent::MTE3_V>((event_t)(5 + phase_));
      outReady_[phase_] = true;
    } else
      hasNext = Prefetch(jobs, next, base, core, sequence, n, sub);
    phase_ ^= 1;
    inputReady_ = hasNext;
    return hasNext;
  }
  __aicore__ inline void Finish() {
    for (Z0 p = 0; p < 2; ++p)
      if (outReady_[p]) {
        WaitFlag<HardEvent::MTE3_V>((event_t)(5 + p));
        outReady_[p] = false;
      }
  }

private:

  __aicore__ inline void MaskAnd(LocalTensor<Z6> dst, LocalTensor<Z6> a, LocalTensor<Z6> b, Z0 words) {
    auto d = dst.ReinterpretCast<Z5>();
    auto x = a.ReinterpretCast<Z5>(), y = b.ReinterpretCast<Z5>();
    for (Z0 i = 0; i < words; i += 128)
      And(d[i], x[i], y[i], static_cast<Z2>(Min(128, words - i)), 1, BinaryRepeatParams{1, 1, 1, 8, 8, 8});
    ResetMask();
  }

  __aicore__ inline bool RepairMidpoints(LocalTensor<Z8> z, LocalTensor<Z8> result, LocalTensor<Z8> absolute,
                                         LocalTensor<Z8> work, LocalTensor<half> out, Z0 validCount, Z0 width,
                                         Z0 cols) {
    Z0 count = Up(validCount, 64), pad = Up(SIZE / 8, 256);
    auto masks = maskBuf_.Get<Z6>(), lower = masks[pad], regions = masks[2 * pad], low = masks[3 * pad];
    auto bits32 = work.ReinterpretCast<Z1>();
    Adds(bits32, result.ReinterpretCast<Z1>(), Z1(MODE == 1 ? 8 : 1), count);
    And(work.ReinterpretCast<Z5>(), work.ReinterpretCast<Z5>(), constMaskBuf_.Get<Z5>(), Z2(128),
        static_cast<Z6>(count / 64), BinaryRepeatParams{1, 1, 1, 8, 8, 0});
    CompareScalar(masks, bits32, Z1(0x1000), CMPMODE::EQ, count);
    CompareScalar(regions, z, 2.0f, CMPMODE::GE, count);
    MaskAnd(masks, masks, regions, (count + 15) / 16);
    auto words = masks.ReinterpretCast<Z1>();
    Z0 wc = (count + 31) / 32;
    Cast(work, words, RoundMode::CAST_RINT, Up(wc, 64));
    CompareScalar(regions, work, 0.0f, CMPMODE::NE, Up(wc, 64));
    Z2 selected = 0;
    GatherMask(work, indexBuf_.Get<Z8>(), regions.ReinterpretCast<Z0>(), true, wc, GatherMaskParams{1, 1, 8, 1},
               selected);
    ResetMask();
    SetFlag<HardEvent::V_S>(EVENT_ID4);
    WaitFlag<HardEvent::V_S>(EVENT_ID4);
    if (selected > (wc / 8 > 8 ? wc / 8 : 8)) {
      CompareScalar(regions, z, 8.0f, CMPMODE::LT, count);
      MaskAnd(masks, masks, regions, (count + 15) / 16);
      Cast(work, words, RoundMode::CAST_RINT, Up(wc, 64));
      CompareScalar(regions, work, 0.0f, CMPMODE::NE, Up(wc, 64));
      GatherMask(work, indexBuf_.Get<Z8>(), regions.ReinterpretCast<Z0>(), true, wc, GatherMaskParams{1, 1, 8, 1},
                 selected);
      ResetMask();
      SetFlag<HardEvent::V_S>(EVENT_ID4);
      WaitFlag<HardEvent::V_S>(EVENT_ID4);
    }
    auto bits = out.ReinterpretCast<Z4>();
    bool repaired = false;
    for (Z0 j = 0; j < static_cast<Z0>(selected); ++j) {
      Z0 word = static_cast<Z0>(static_cast<Z1>(work.GetValue(j))), candidates = (Z0)words.GetValue(word);
      while (candidates) {
        Z0 bit = (Z0)(63 - ScalarCountLeadingZero((Z2)candidates));
        candidates ^= 1U << bit;
        Z0 i = word * 32 + bit;
        if (i >= validCount || i % width >= cols)
          continue;
        Z4 previous = bits.GetValue(i);
        Z0 h = previous & 0x7fffU;
        if (h < 0x4000U)
          continue;
        Z8 zi = z.GetValue(i);
        if (zi == 0.0f || zi >= 8.0f || zi <= -6.0f)
          continue;
        Z4 corrected = herl18epi::SharedRepairHalf(zi, previous);
        if (corrected != previous) {
          bits.SetValue(i, corrected);
          repaired = true;
        }
      }
    }
    return repaired;
  }
  __aicore__ inline void LoadInput(const GlobalTensor<Z1> &scratch, const ha36sched2job::Job &job, Z0 n, Z0 sub,
                                   Z0 phase) {
    Z0 split = (job.rows + 1) / 2, first = sub * split, active = first < job.rows ? Min(split, job.rows - first) : 0;
    if (active) {
      auto raw = (phase ? rawNextBuf_ : rawBuf_).template Get<Z1>();
      auto sc = scaleAllBuf_.Get<Z8>();
      Z0 width = Up(job.cols, 16), count = Up(active * width, 64);
      bool clear = job.cols != width || count != active * width, scClear = false;
      if (clear)
        Duplicate(raw, Z1(0), count);
      if (scClear)
        Duplicate(sc, 0.0f, Up(width, 64));
      if (clear || scClear) {
        SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
        WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
      }
      SetFlag<HardEvent::S_MTE2>(EVENT_ID7);
      WaitFlag<HardEvent::S_MTE2>(EVENT_ID7);
      if (job.cols == BN)
        DataCopy(raw, scratch[first * BN], active * width);
      else
        DataCopyPad(raw, scratch[first * BN],
                    DataCopyExtParams{Z4(active), job.cols * 4, (BN - job.cols) * 4, (width - Up(job.cols, 8)) / 8, 0},
                    DataCopyPadExtParams<Z1>{true, 0, Z6(Up(job.cols, 8) - job.cols), 0});
      if (job.expert != scaleExpert_) {
        SetFlag<HardEvent::V_MTE2>(EVENT_ID6);
        WaitFlag<HardEvent::V_MTE2>(EVENT_ID6);
        GlobalTensor<Z8> scales;
        scales.SetGlobalBuffer(scaleAddress_);
        DataCopyPad(sc, scales[(Z2)job.expert * n], DataCopyExtParams{1, n * 4, 0, 0, 0},
                    DataCopyPadExtParams<Z8>{true, 0, Z6(Up(n, 8) - n), 0.0f});
        scaleExpert_ = job.expert;
      }
    }
    CrossCoreSetFlag<0x2, PIPE_MTE2>(RELEASE);
    SetFlag<HardEvent::MTE2_V>(EVENT_ID1);
  }
  template <class ITERATOR>
  __aicore__ inline bool Prefetch(ITERATOR &jobs, ha36sched2job::Job &next, const GlobalTensor<Z1> &base, Z0 core,
                                  Z0 seq, Z0 n, Z0 sub) {
    if (!jobs.Next(next.expert, next.row, next.col, next.rows, next.cols, n))
      return false;
    CrossCoreWaitFlag(READY);
    LoadInput(base[((Z2)core * 2 + (seq + 1) % 2) * (BM * BN + PAD)], next, n, sub, phase_ ^ 1);
    return true;
  }
  TBuf<TPosition::VECCALC> rawBuf_, zBuf_, tBuf_, workBuf_;
  TBuf<TPosition::VECCALC> outBuf_, maskBuf_, scaleBuf_;
  TBuf<TPosition::VECCALC> indexBuf_;
  TBuf<TPosition::VECCALC> constMaskBuf_;
  __gm__ Z8 *scaleAddress_ = nullptr;
  __gm__ half *outputAddress_ = nullptr;
  Z0 cachedExpert_ = 0xffffffffU, cachedCol_ = 0xffffffffU;
  TBuf<TPosition::VECCALC> rawNextBuf_, scaleNextBuf_;
  TBuf<TPosition::VECCALC> scaleAllBuf_;
  Z0 scaleExpert_ = 0xffffffffU;
  TBuf<TPosition::VECCALC> outNextBuf_;
  bool outReady_[2] = {false, false};
  bool inputReady_ = false;
  Z0 phase_ = 0;
  bool outputPending_ = false;
};
} // namespace ha36sched2epi
} // namespace gmg
namespace gmg {
namespace ha36sched2 {
template <Z0 BM, Z0 BN, Z0 BK, Z0 Width, bool PACK = false, Z0 MODE = 0, Z0 EXTRA = 0, Z0 POLICY = 0, Z0 PAD = 0,
          Z0 ResidentK = 0>
__global__ __mix__(1, 2) GMG_HA36_SCHED_CODE
    void Kernel(GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR g, GM_ADDR y, GM_ADDR ws, Z0 e, Z0 m, Z0 n, Z0 k, Z0 cores) {
  InitSocState();
  Z0 core = GetBlockIdx(), sub = 0;
  if ASCEND_IS_AIV {
    sub = core % 2;
    core /= 2;
  }
  constexpr Z0 TILE = BM * BN, FRAME = BM * BN + PAD;
  const Z0 paddedK = ResidentK ? ResidentK : Up(k, 32), AS = BM * paddedK;
  const Z0 BS = PACK ? ((n + Width - 1) / Width - (n % Width == 1 && BN >= Width + 32 ? 1 : 0)) * BN * paddedK
                     : Up(n, 32) * paddedK;
  Schedule<BM, BN, Width, EXTRA, POLICY> jobs(g, e, n, core, cores, k, m);
  GlobalTensor<Z1> scratch;
  scratch.SetGlobalBuffer((__gm__ Z1 *)ws);
  Z0 ex, row, col, rows, cols, seq = 0;
  if ASCEND_IS_AIC {
    static_assert(2 * BM * BK <= 65536 && 2 * BN * BK <= 65536, "HA L0AB");
    static_assert(8 * TILE <= 131072, "HA double L0C");
    LocalTensor<Z7> a1(TPosition::A1, 0, AS), b1(TPosition::B1, AS, BS);
    LocalTensor<Z7> a2(TPosition::A2, 0, 2 * BM * BK), b2(TPosition::B2, 0, 2 * BN * BK);
    LocalTensor<Z1> c0(TPosition::CO1, 0, 2 * TILE);
    InitConstValue(a1.ReinterpretCast<Z4>(), {1, Z4(AS / 32), 0, Z4(0)});
    InitConstValue(b1.ReinterpretCast<Z4>(), {1, Z4(BS / 32), 0, Z4(0)});
    PipeBarrier<PIPE_ALL>();
    GlobalTensor<Z7> ag, bg;
    ag.SetGlobalBuffer((__gm__ Z7 *)x);
    bg.SetGlobalBuffer((__gm__ Z7 *)w);
    Z0 cachedRow = 0xffffffffU, cachedExpert = 0xffffffffU, kp = paddedK;
    while (jobs.Next(ex, row, col, rows, cols, n)) {
      Z0 cs = seq % 2, phys = Up(cols, 32);
      if (seq >= 2)
        WaitFlag<HardEvent::FIX_M>((event_t)cs);
      if (seq)
        WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID1);
      if (row != cachedRow) {
        Nd2NzParams p{};
        p.ndNum = 1;
        p.nValue = rows;
        p.dValue = k;
        p.srcDValue = k;
        p.dstNzC0Stride = BM;
        p.dstNzNStride = 1;
        DataCopy(a1, ag[(Z2)row * k], p);
        cachedRow = row;
      }
      if (ex != cachedExpert) {
        if (PACK) {
          Z0 nt = (n + Width - 1) / Width - (n % Width == 1 && BN >= Width + 32 ? 1 : 0);
          for (Z0 ci = 0; ci < nt; ++ci) {
            Z0 ct = ci * Width, nc = ci + 1 == nt ? n - ct : Width, np = Up(nc, 32);
            Nd2NzParams p{};
            p.ndNum = k / 32;
            p.nValue = 32;
            p.dValue = nc;
            p.srcDValue = n;
            p.srcNdMatrixStride = 32 * n;
            p.dstNzC0Stride = 32;
            p.dstNzNStride = 1;
            p.dstNzMatrixStride = np * 32;
            if (k / 32)
              DataCopy(b1[(ct / Width) * BN * kp], bg[(Z2)ex * k * n + ct], p);
            if (k % 32) {
              p.ndNum = 1;
              p.nValue = k % 32;
              DataCopy(b1[(ct / Width) * BN * kp + (k / 32) * np * 32], bg[(Z2)ex * k * n + (Z2)(k / 32 * 32) * n + ct],
                       p);
            }
          }
        } else {
          Nd2NzParams p{};
          p.ndNum = 1;
          p.nValue = k;
          p.dValue = n;
          p.srcDValue = n;
          p.dstNzC0Stride = kp;
          p.dstNzNStride = 1;
          DataCopy(b1, bg[(Z2)ex * k * n], p);
        }
        cachedExpert = ex;
      }
      SetFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);
      WaitFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);
      Z0 it = 0;
      for (Z0 ki = 0; ki < kp; ki += BK, ++it) {
        Z0 ks = it % 2, kl = Min(BK, kp - ki);
        if (it >= 2)
          WaitFlag<HardEvent::M_MTE1>((event_t)ks);
        LoadData3DParamsV2<Z7> p{};
        p.l1H = 1;
        p.l1W = BM;
        p.channelSize = kp;
        p.kExtension = kl;
        p.mExtension = Up(rows, 16);
        p.kStartPt = ki;
        p.strideH = p.strideW = p.filterH = p.filterW = p.dilationFilterH = p.dilationFilterW = 1;
        LoadData(a2[ks * BM * BK], a1, p);
        if (PACK) {
          LoadData2dTransposeParams q{0, Z6((phys / 32) * (kl / 32)), 1, 1, 0};
          LoadDataWithTranspose(b2[ks * BN * BK], b1[(col / Width) * BN * kp + ki * phys], q);
        } else {
          LoadData2dTransposeParams q{0, Z6(phys / 32), Z4(kp / 32), 1, 0};
          for (Z0 t = 0; t < kl; t += 32)
            LoadDataWithTranspose(b2[ks * BN * BK + t * phys], b1[(Z2)col * kp + (ki + t) * 32], q);
        }
        if (ki + kl == kp)
          SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID1);
        SetFlag<HardEvent::MTE1_M>((event_t)ks);
        WaitFlag<HardEvent::MTE1_M>((event_t)ks);
        MmadParams mp{};
        mp.m = Up(rows, 16);
        mp.n = phys;
        mp.k = kl;
        mp.cmatrixInitVal = it == 0;
        if (it)
          PipeBarrier<PIPE_M>();
        Mmad(c0[cs * TILE], a2[ks * BM * BK], b2[ks * BN * BK], mp);
        SetFlag<HardEvent::M_MTE1>((event_t)ks);
      }
      for (Z0 q = 0; q < Min(it, 2); ++q)
        WaitFlag<HardEvent::M_MTE1>((event_t)q);
      SetFlag<HardEvent::M_FIX>(EVENT_ID2);
      WaitFlag<HardEvent::M_FIX>(EVENT_ID2);
      if (seq >= 2)
        CrossCoreWaitFlag(RELEASE);
      FixpipeParamsV220 fp{};
      fp.mSize = rows;
      fp.nSize = cols;
      fp.srcStride = Up(rows, 16);
      fp.dstStride = BN;
      fp.quantPre = QuantMode_t::NoQuant;
      Fixpipe<Z1, Z1, CFG_ROW_MAJOR>(scratch[((Z2)core * 2 + cs) * FRAME], c0[cs * TILE], fp);
      SetFlag<HardEvent::FIX_M>((event_t)cs);
      CrossCoreSetFlag<0x2, PIPE_FIX>(READY);
      ++seq;
    }
    if (seq)
      WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID1);
    for (Z0 q = 0; q < Min(seq, 2); ++q)
      WaitFlag<HardEvent::FIX_M>((event_t)q);
    for (Z0 q = 0; q < Min(seq, 2); ++q)
      CrossCoreWaitFlag(RELEASE);
    PipeBarrier<PIPE_ALL>();
  }
  if ASCEND_IS_AIV {
    TPipe pipe;
    ha36sched2epi::ScreenEpilogue<BM, BN, MODE, PAD> epi;
    epi.Init(pipe, s, y);
    ha36sched2job::Job cur{}, next{};
    bool available = jobs.Next(cur.expert, cur.row, cur.col, cur.rows, cur.cols, n);
    while (available) {
      if (seq == 0)
        CrossCoreWaitFlag(READY);
      available = epi.Process(scratch[((Z2)core * 2 + seq % 2) * FRAME], cur, n, sub, jobs, next, scratch, core, seq);
      if (available)
        cur = next;
      ++seq;
    }
    epi.Finish();
    PipeBarrier<PIPE_ALL>();
  }
}
template <Z0 BM, Z0 BN, Z0 BK, Z0 Width, bool PACK = false, Z0 MODE = 0, Z0 EXTRA = 0, Z0 POLICY = 0, Z0 PAD = 0,
          Z0 ResidentK = 0>
void Run(GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR g, GM_ADDR y, Z0 e, Z0 m, Z0 n, Z0 k, Z0 cores, aclrtStream st) {
  void *ws = nullptr;
  if (aclrtMalloc(&ws, (size_t)cores * 2 * (BM * BN + PAD) * 4, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS)
    throw std::runtime_error("HA native workspace");
  Kernel<BM, BN, BK, Width, PACK, MODE, EXTRA, POLICY, PAD, ResidentK>
      <<<cores, nullptr, st>>>(x, w, s, g, y, (Z6 *)ws, e, m, n, k, cores);
  auto status = aclrtSynchronizeStream(st), freed = aclrtFree(ws);
  if (status || freed)
    throw std::runtime_error("HA native execution");
}
} // namespace ha36sched2
} // namespace gmg
#undef GMG_HA36_SCHED_CODE
namespace gmg {
__attribute__((noinline)) bool LaunchHA36Sched(GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR g, GM_ADDR y, Z0 e, Z0 m, Z0 n,
                                               Z0 k, Z0 cores, aclrtStream stream) {
  auto *p = platform_ascendc::PlatformAscendCManager::GetInstance();
  if (!p || n <= 256 || n > 448 || k < 128 || cores <= 8 || m < e * 128)
    return false;
  uint64_t l1 = 0;
  p->GetCoreMemSize(platform_ascendc::CoreMemType::L1, l1);
  if ((64ULL + (n + 31) / 32 * 32) * ((k + 31) / 32 * 32) > std::min<uint64_t>(l1, 480 * 1024))
    return false;
  switch ((k + 31) / 32 * 32) {
  case 128:
    ha36sched2::Run<64, 256, 128, 256, false, 0, 1, 1, 0, 128>(x, w, s, g, y, e, m, n, k, cores, stream);
    break;
  case 160:
    ha36sched2::Run<64, 256, 128, 256, false, 0, 1, 1, 0, 160>(x, w, s, g, y, e, m, n, k, cores, stream);
    break;
  case 256:
    ha36sched2::Run<64, 256, 128, 256, false, 0, 1, 1, 0, 256>(x, w, s, g, y, e, m, n, k, cores, stream);
    break;
  case 288:
    ha36sched2::Run<64, 256, 128, 256, false, 0, 1, 1, 0, 288>(x, w, s, g, y, e, m, n, k, cores, stream);
    break;
  case 512:
    ha36sched2::Run<64, 256, 128, 256, false, 0, 1, 1, 0, 512>(x, w, s, g, y, e, m, n, k, cores, stream);
    break;
  case 544:
    ha36sched2::Run<64, 256, 128, 256, false, 0, 1, 1, 0, 544>(x, w, s, g, y, e, m, n, k, cores, stream);
    break;
  case 1024:
    ha36sched2::Run<64, 256, 128, 256, false, 0, 1, 1, 0, 1024>(x, w, s, g, y, e, m, n, k, cores, stream);
    break;
  case 1056:
    ha36sched2::Run<64, 256, 128, 256, false, 0, 1, 1, 0, 1056>(x, w, s, g, y, e, m, n, k, cores, stream);
    break;
  default:
    ha36sched2::Run<64, 256, 128, 256, false, 0, 1, 1, 0>(x, w, s, g, y, e, m, n, k, cores, stream);
    break;
  }
  return true;
}
} // namespace gmg

#define r42AI __aicore__ __attribute__((always_inline)) inline
#define u4 uint32_t
#define u8 uint64_t
#define i4 int32_t
#define i8 int64_t
#define i1 int8_t
#define u2 uint16_t
#define u1 uint8_t
#define ps TPosition
#define gt GlobalTensor
#define lt LocalTensor
#define pb PipeBarrier
#define crw CrossCoreWaitFlag
#define crs CrossCoreSetFlag
#define he HardEvent
#define sf SetFlag
#define wf WaitFlag
#define dc DataCopy
#define tq TQue
#define dcp DataCopyExtParams

#if defined(__DAV_VEC__) || defined(__DAV_C220_VEC__)

#define CONTEST41_ENTRY __attribute__((section(".gmg_round41_vector"), aligned(256)))

#else

#define CONTEST41_ENTRY __attribute__((section(".gmg_round41_cube"), aligned(256)))

#endif
namespace contest41 {
using namespace AscendC;
r42AI u4 smaller(u4 a, u4 b) {
  return a < b ? a : b;
}
r42AI u4 round32(u4 x) {
  return (x + 31) & ~31U;
}
template <he Direction> r42AI void fence() {
  sf<Direction>(EVENT_ID0);
  wf<Direction>(EVENT_ID0);
}
struct Geometry {
  u4 m, n, k, e, cores;
};
struct Tile {
  u4 expert, row, height, col, width;
};
r42AI u4 coreId() {
  u4 i = GetBlockIdx();
  if ASCEND_IS_AIV {
    i /= 2;
  }
  return i;
}
template <u4 Capacity> class FloatOutput {
  TBuf<ps::VECCALC> memory_;
  gt<float> factors_;
  gt<half> destination_;
  bool reading_ = false, writing_ = false;

public:
  r42AI void setup(TPipe &pipe, GM_ADDR scale, GM_ADDR out) {
    pipe.InitBuffer(memory_, Capacity * 18 + 2048);
    factors_.SetGlobalBuffer((__gm__ float *)scale);
    destination_.SetGlobalBuffer((__gm__ half *)out);
  }
  r42AI void drain() {
    if (reading_) {
      wf<he::V_MTE2>(EVENT_ID0);
      reading_ = false;
    }
    if (writing_) {
      wf<he::MTE3_V>(EVENT_ID3);
      writing_ = false;
    }
  }
  r42AI void zero(GM_ADDR address, u8 count, u4 rank, u4 cores, u2 signal) {
    drain();
    auto raw = memory_.Get<i4>();
    Duplicate(raw, i4(0), Capacity);
    fence<he::V_MTE3>();
    gt<i4> output;
    output.SetGlobalBuffer((__gm__ i4 *)address);
    u4 lane = 2 * rank + GetSubBlockIdx(), lanes = 2 * cores;
    u8 blocks = count / 8;
    u8 a = 8 * (blocks * lane / lanes), b = 8 * (blocks * (lane + 1) / lanes);
    while (a < b) {
      u4 length = u4(b - a < Capacity ? b - a : Capacity);
      dc(output[a], raw, length);
      a += length;
    }
    fence<he::MTE3_V>();
    SyncAll<true>();
    crs<2, PIPE_MTE3>(signal);
  }
  template <u4 Width> r42AI void prepare(u4 expert, u4 column, u4 n) {
    if (reading_) {
      wf<he::V_MTE2>(EVENT_ID0);
      reading_ = false;
    }
    auto scale = memory_.Get<float>()[Capacity * 18 / 4];
    dc(scale, factors_[u8(expert) * n + column], Width);
  }
  template <u4 Width, bool Prepared = false>
  r42AI void emit(const Geometry &g, const Tile &tile, GM_ADDR address, u4 pitch) {
    u4 splitRows = (tile.height + 1) / 2, begin = GetSubBlockIdx() * splitRows;
    if (begin >= tile.height)
      return;
    u4 remaining = smaller(splitRows, tile.height - begin);
    gt<i4> input;
    input.SetGlobalBuffer((__gm__ i4 *)address);
    auto raw = memory_.Get<i4>();
    auto z = memory_.Get<float>()[Capacity];
    auto a = memory_.Get<float>()[2 * Capacity];
    auto b = memory_.Get<float>()[3 * Capacity];
    auto h = memory_.Get<half>()[8 * Capacity];
    auto scale = memory_.Get<float>()[Capacity * 18 / 4];
    for (u4 done = 0; done < remaining;) {
      if (reading_) {
        wf<he::V_MTE2>(EVENT_ID0);
        reading_ = false;
      }
      u4 rows = smaller(Capacity / Width, remaining - done), count = rows * Width;
      if (tile.width != Width) {
        Duplicate(raw, i4(0), count);
        Duplicate(scale, 0.0f, Width);
        fence<he::V_MTE2>();
      }
      dcp copy{u2(rows), tile.width * 4, (pitch - tile.width) * 4, (Width - round32(tile.width * 4) / 4) / 8, 0};
      copy.dstStride = (Width - ((tile.width + 7) / 8 * 8)) / 8;
      DataCopyPad(raw, input[u8(begin + done) * pitch], copy,
                  DataCopyPadExtParams<i4>{true, 0, u1((8 - tile.width % 8) % 8), 0});
      if (!Prepared)
        DataCopyPad(scale, factors_[u8(tile.expert) * g.n + tile.col], dcp{1, tile.width * 4, 0, 0, 0},
                    DataCopyPadExtParams<float>{true, 0, u1((8 - tile.width % 8) % 8), 0.0f});
      fence<he::MTE2_V>();
      Cast(z, raw, RoundMode::CAST_RINT, count);
      pb<PIPE_V>();
      for (u4 j = 0; j < Width; j += 64)
        Mul(z[j], z[j], scale[j], u8(64), u1(rows), BinaryRepeatParams{1, 1, 1, Width / 8, Width / 8, 0});
      pb<PIPE_V>();
      sf<he::V_MTE2>(EVENT_ID0);
      reading_ = true;
      Mul(a, z, z, count);
      pb<PIPE_V>();
      Muls(a, a, -0.07135481627260025f, count);
      pb<PIPE_V>();
      Adds(a, a, -1.5957691216057308f, count);
      pb<PIPE_V>();
      Mul(a, a, z, count);
      pb<PIPE_V>();
      Mins(a, a, 64.0f, count);
      pb<PIPE_V>();
      Exp(b, a, count);
      pb<PIPE_V>();
      Adds(a, b, 1.0f, count);
      pb<PIPE_V>();
      Div(b, z, a, count);
      pb<PIPE_V>();
      if (writing_) {
        wf<he::MTE3_V>(EVENT_ID3);
        writing_ = false;
      }
      Cast(h, b, RoundMode::CAST_RINT, count);
      fence<he::V_MTE3>();
      DataCopyPad(
          destination_[u8(tile.row + begin + done) * g.n + tile.col], h,
          dcp{u2(rows), tile.width * 2, (Width - ((tile.width + 15) / 16 * 16)) / 16, (g.n - tile.width) * 2, 0});
      sf<he::MTE3_V>(EVENT_ID3);
      writing_ = true;
      done += rows;
    }
  }
};
class ExpertProduct {
  tq<ps::A1, 1> input_;
  tq<ps::B1, 2> weights_;
  tq<ps::A2, 1> left_;
  tq<ps::B2, 1> right_;
  tq<ps::CO1, 1> accum_;
  lt<i1> current_;

public:
  r42AI void setup(TPipe &p) {
    p.InitBuffer(input_, 1, 80 * 256);
    p.InitBuffer(weights_, 2, 256 * 256);
    p.InitBuffer(left_, 1, 80 * 256);
    p.InitBuffer(right_, 1, 256 * 256);
    p.InitBuffer(accum_, 1, 80 * 256 * 4);
    u1 pad[4] = {};
    Load3DSetFMatrixCal(1, 80, pad);
  }
  r42AI void request(GM_ADDR w, u4 expert) {
    gt<i1> gm;
    gm.SetGlobalBuffer((__gm__ i1 *)w + u8(expert) * 256 * 256);
    auto dst = weights_.AllocTensor<i1>();
    dc(dst, gm, Nd2NzParams(1, 256, 256, 0, 256, 256, 1, 0));
    weights_.EnQue(dst);
  }
  r42AI void enter() {
    auto packed = weights_.DeQue<i1>();
    auto dst = right_.AllocTensor<i1>();
    LoadData2dTransposeParams move{0, 8, 8, 1, 0, inc};
    for (u4 kk = 0; kk < 256; kk += 32)
      LoadDataWithTranspose(dst[kk * 256], packed[kk * 32], move);
    right_.EnQue(dst);
    weights_.FreeTensor(packed);
    current_ = right_.DeQue<i1>();
  }
  r42AI void input(GM_ADDR x, u4 row, u4 height) {
    gt<i1> gm;
    gm.SetGlobalBuffer((__gm__ i1 *)x + u8(row) * 256);
    auto t = input_.AllocTensor<i1>();
    dc(t, gm, Nd2NzParams(1, u2(height), 256, 0, 256, 80, 1, 0));
    input_.EnQue(t);
  }
  r42AI void multiply(GM_ADDR target, u4 height, i4 wait) {
    u4 padded = (height + 15) / 16 * 16;
    auto a = input_.DeQue<i1>();
    auto local = left_.AllocTensor<i1>();
    LoadData3DParamsV2Pro move;
    move.channelSize = 256;
    move.extConfig = (u8(padded) << 16) | 256;
    LoadData(local, a, move);
    left_.EnQue(local);
    input_.FreeTensor(a);
    auto l = left_.DeQue<i1>();
    auto c = accum_.AllocTensor<i4>();
    MmadParams mm;
    mm.m = padded;
    mm.n = 256;
    mm.k = 256;
    mm.isBias = false;
    mm.cmatrixInitVal = true;
    Mmad(c, l, current_, mm);
    accum_.EnQue(c);
    left_.FreeTensor(l);
    auto v = accum_.DeQue<i4>();
    if (wait >= 0)
      crw(u2(wait));
    gt<i4> out;
    out.SetGlobalBuffer((__gm__ i4 *)target);
    FixpipeParamsV220 store;
    store.mSize = height;
    store.nSize = 256;
    store.srcStride = padded;
    store.dstStride = 256;
    store.quantPre = QuantMode_t::NoQuant;
    store.reluEn = false;
    Fixpipe<i4, i4, CFG_ROW_MAJOR>(out, v, store);
    accum_.FreeTensor(v);
  }
  r42AI void leave() {
    right_.FreeTensor(current_);
  }
};
class DeferredOutput {
  static constexpr u4 C = 10240;
  TBuf<ps::VECCALC> storage_;
  gt<float> scale_;
  gt<half> out_;
  bool ready_ = false, busy_[2] = {false, false};
  u4 bank_ = 0, length_ = 0;
  u8 offset_ = 0;
  r42AI lt<i4> raw(u4 b) {
    return storage_.Get<i4>()[b * C];
  }
  r42AI void calculate(u4 bank, u4 length) {
    auto z = storage_.Get<float>()[2 * C];
    auto value = storage_.Get<float>()[3 * C];
    auto work = raw(bank).ReinterpretCast<float>();
    auto factors = storage_.Get<float>()[4 * C + bank * 256];
    Cast(z, raw(bank), RoundMode::CAST_RINT, length);
    pb<PIPE_V>();
    for (u4 j = 0; j < 256; j += 64)
      Mul(z[j], z[j], factors[j], u8(64), u1(length / 256), BinaryRepeatParams{1, 1, 1, 32, 32, 0});
    pb<PIPE_V>();
    Mul(work, z, z, length);
    pb<PIPE_V>();
    Muls(work, work, -0.07135481627260025f, length);
    pb<PIPE_V>();
    Adds(work, work, -1.5957691216057308f, length);
    pb<PIPE_V>();
    Mul(work, work, z, length);
    pb<PIPE_V>();
    Mins(work, work, 64.0f, length);
    pb<PIPE_V>();
    Exp(value, work, length);
    pb<PIPE_V>();
    Adds(work, value, 1.0f, length);
    pb<PIPE_V>();
    Div(value, z, work, length);
    pb<PIPE_V>();
  }
  r42AI void commit() {
    auto h = raw(bank_).ReinterpretCast<half>();
    Cast(h, storage_.Get<float>()[3 * C], RoundMode::CAST_RINT, length_);
    fence<he::V_MTE3>();
    dc(out_[offset_], h, length_);
    sf<he::MTE3_MTE2>(event_t(bank_));
    busy_[bank_] = true;
    ready_ = false;
  }

public:
  r42AI void setup(TPipe &p, GM_ADDR s, GM_ADDR y) {
    p.InitBuffer(storage_, 4 * C * 4 + 2048);
    scale_.SetGlobalBuffer((__gm__ float *)s);
    out_.SetGlobalBuffer((__gm__ half *)y);
  }
  r42AI void push(GM_ADDR memory, u4 expert, u4 row, u4 height, u4 sequence) {
    u4 b = sequence % 2, tag = sequence % 3, half = (height + 1) / 2, first = GetSubBlockIdx() * half,
       rows = first < height ? smaller(half, height - first) : 0;
    if (rows) {
      if (busy_[b]) {
        wf<he::MTE3_MTE2>(event_t(b));
        busy_[b] = false;
      }
      dc(storage_.Get<float>()[4 * C + b * 256], scale_[u8(expert) * 256], 256);
    }
    crw(tag);
    if (rows) {
      gt<i4> gm;
      gm.SetGlobalBuffer((__gm__ i4 *)memory + first * 256);
      dc(raw(b), gm, rows * 256);
      sf<he::MTE2_V>(event_t(b));
    }
    crs<2, PIPE_MTE2>(8 + tag);
    if (ready_)
      commit();
    if (rows) {
      wf<he::MTE2_V>(event_t(b));
      calculate(b, rows * 256);
      bank_ = b;
      length_ = rows * 256;
      offset_ = u8(row + first) * 256;
      ready_ = true;
    }
  }
  r42AI void drain() {
    if (ready_)
      commit();
    for (u4 b = 0; b < 2; ++b)
      if (busy_[b])
        wf<he::MTE3_MTE2>(event_t(b));
  }
};
class Boundaries {
  const __gm__ i8 *global_;
  lt<i8> local_;
  u4 experts_, rows_;

public:
  r42AI void setup(GM_ADDR g, lt<i8> local, u4 experts, u4 rows) {
    global_ = (const __gm__ i8 *)g;
    local_ = local;
    experts_ = experts;
    rows_ = rows;
  }
  r42AI u4 at(u4 i) {
    u4 x = 0;
    if ASCEND_IS_AIC {
      x = u4(global_[i]);
    }
    if ASCEND_IS_AIV {
      x = u4(local_.GetValue(i));
    }
    return x;
  }
  r42AI u4 locate(u4 row, u4 e) {
    u4 lo = 0, hi = e;
    while (lo < hi) {
      u4 mid = (lo + hi) / 2;
      if (at(mid) <= row)
        lo = mid + 1;
      else
        hi = mid;
    }
    return lo;
  }
  r42AI u4 cut(u4 rank, u4 cores, u4 &expert) {
    if (!rank) {
      expert = 0;
      return 0;
    }
    if (rank == cores) {
      expert = experts_;
      return rows_;
    }
    u4 halfway = at(experts_ / 2 - 1), small = smaller(halfway, rows_ - halfway);
    if (small > rows_ / 16 && small < rows_ / 2 - rows_ / 16) {
      u4 quota = u8(rows_ + experts_ * 64) * rank / cores, lo = 0, hi = experts_;
      while (lo < hi) {
        u4 mid = (lo + hi) / 2;
        if (at(mid) + (mid + 1) * 64 <= quota)
          lo = mid + 1;
        else
          hi = mid;
      }
      u4 begin = lo ? at(lo - 1) : 0, end = at(lo), charge = begin + (lo + 1) * 64,
         offset = quota > charge ? quota - charge : 0;
      u4 length = end - begin;
      if (offset <= 24 && offset <= length - offset)
        offset = 0;
      else if (length - offset <= 24)
        offset = length;
      expert = lo + (offset == length);
      return begin + offset;
    }
    u4 q = (experts_ * rank + cores / 2) / cores, end = q ? at(q - 1) : 0;
    u4 ideal = (u8(rows_) * rank / cores + 8) / 16 * 16, low = ideal > 32 ? ideal - 32 : 0,
       high = smaller(rows_, ideal + 32);
    u4 point = end < low ? low : smaller(end, high);
    expert = point == end ? q : locate(point, experts_);
    return point;
  }
};
template <u4 Version>
__global__ __mix__(1, 2) CONTEST41_ENTRY void ShortExpert(GM_ADDR x, GM_ADDR w, GM_ADDR scale, GM_ADDR groups,
                                                          GM_ADDR y, GM_ADDR memory, u4 cores, u4 experts, u4 rows) {
  TPipe p;
  TBuf<ps::VECCALC> buffer;
  lt<i8> local;
  u4 worker = coreId();
  ExpertProduct product;
  DeferredOutput finish;
  if ASCEND_IS_AIC {
    product.setup(p);
  }
  if ASCEND_IS_AIV {
    p.InitBuffer(buffer, 1024);
    local = buffer.Get<i8>();
    gt<i8> gm;
    gm.SetGlobalBuffer((__gm__ i8 *)groups);
    dc(local, gm, experts);
    finish.setup(p, scale, y);
    fence<he::MTE2_S>();
  }
  Boundaries g;
  g.setup(groups, local, experts, rows);
  u4 firstExpert = 0, lastExpert = 0;
  u4 row = g.cut(worker, cores, firstExpert), stop = g.cut(worker + 1, cores, lastExpert), sequence = 0,
     queued = experts;
  for (u4 expert = firstExpert; row < stop && expert < experts; ++expert) {
    u4 end = smaller(stop, g.at(expert));
    bool first = true;
    while (row < end) {
      u4 height = smaller(80, end - row), slot = sequence % 3;
      GM_ADDR address = memory + (u8(worker) * 3 + slot) * (80 * 256 * 4 + 512);
      if ASCEND_IS_AIC {
        product.input(x, row, height);
        if (first) {
          if (queued != expert)
            product.request(w, expert);
          product.enter();
          if (end < stop) {
            u4 next = expert + 1;
            while (next < experts && g.at(next) <= end)
              ++next;
            if (next < experts)
              product.request(w, next);
            queued = next;
          }
        }
        product.multiply(address, height, sequence >= 3 ? i4(8 + slot) : -1);
        if (row + height == end)
          product.leave();
        crs<2, PIPE_FIX>(slot);
      }
      if ASCEND_IS_AIV {
        finish.push(address, expert, row, height, sequence);
      }
      row += height;
      ++sequence;
      first = false;
    }
  }
  if ASCEND_IS_AIC {
    for (u4 i = 0; i < smaller(sequence, 3); ++i)
      crw(8 + i);
  }
  if ASCEND_IS_AIV {
    finish.drain();
  }
}
class CompletePanels {
  tq<ps::A1, 2> a_;
  tq<ps::B1, 2> b_;
  tq<ps::A2, 2> aa_;
  tq<ps::B2, 2> bb_;
  tq<ps::CO1, 1> c_;
  lt<i1> selected_;

public:
  r42AI void setup(TPipe &p) {
    p.InitBuffer(a_, 2, 80 * 512);
    p.InitBuffer(b_, 2, 512 * 256);
    p.InitBuffer(aa_, 2, 80 * 128);
    p.InitBuffer(bb_, 2, 128 * 256);
    p.InitBuffer(c_, 1, 80 * 256 * 4);
  }
  r42AI void fetch(GM_ADDR x, GM_ADDR w, const Tile &t, u4 n) {
    u4 rows = t.height <= 64 ? 64 : 80;
    gt<i1> gx, gw;
    gx.SetGlobalBuffer((__gm__ i1 *)x + u8(t.row) * 512);
    gw.SetGlobalBuffer((__gm__ i1 *)w + u8(t.expert) * 512 * n + t.col);
    auto left = a_.AllocTensor<i1>();
    if (t.height % 16) {
      u4 pad = 16 - t.height % 16;
      InitConstValue(left[t.height * 32].ReinterpretCast<u4>(), InitConstValueParams<u4>(16, pad, rows - pad, 0));
      pb<PIPE_MTE2>();
    }
    dc(left, gx, Nd2NzParams(1, u2(t.height), 512, 0, 512, rows, 1, 0));
    a_.EnQue(left);
    auto right = b_.AllocTensor<i1>();
    dc(right, gw, Nd2NzParams(1, 512, 256, 0, n, 512, 1, 0));
    b_.EnQue(right);
  }
  r42AI void begin(u4 rows) {
    selected_ = b_.DeQue<i1>();
    u1 pad[4] = {};
    Load3DSetFMatrixCal(1, rows <= 64 ? 64 : 80, pad);
  }
  r42AI void product(GM_ADDR target, u4 height, u4 ordinal) {
    auto left = a_.DeQue<i1>();
    auto accum = c_.AllocTensor<i4>();
    u4 padded = (height + 15) / 16 * 16;
    for (u4 k = 0; k < 512; k += 128) {
      auto l = aa_.AllocTensor<i1>();
      auto r = bb_.AllocTensor<i1>();
      LoadData3DParamsV2Pro ap;
      ap.channelSize = 512;
      ap.extConfig = (u8(k) << 32) | (u8(padded) << 16) | 128;
      LoadData(l, left, ap);
      LoadData2dTransposeParams bp{0, 8, 16, 1, 0, inc};
      for (u4 u = 0; u < 128; u += 32)
        LoadDataWithTranspose(r[u * 256], selected_[(k + u) * 32], bp);
      aa_.EnQue(l);
      bb_.EnQue(r);
      auto al = aa_.DeQue<i1>();
      auto br = bb_.DeQue<i1>();
      MmadParams mm;
      mm.m = padded;
      mm.n = 256;
      mm.k = 128;
      mm.isBias = false;
      mm.cmatrixInitVal = (k == 0);
      Mmad(accum, al, br, mm);
      aa_.FreeTensor(al);
      bb_.FreeTensor(br);
    }
    c_.EnQue(accum);
    auto value = c_.DeQue<i4>();
    if (ordinal >= 2)
      crw(10 + 3 * (ordinal % 2));
    gt<i4> gm;
    gm.SetGlobalBuffer((__gm__ i4 *)target);
    FixpipeParamsV220 fp;
    fp.mSize = height;
    fp.nSize = 256;
    fp.srcStride = padded;
    fp.dstStride = 256;
    fp.quantPre = QuantMode_t::NoQuant;
    fp.reluEn = false;
    Fixpipe<i4, i4, CFG_ROW_MAJOR>(gm, value, fp);
    c_.FreeTensor(value);
    a_.FreeTensor(left);
  }
  r42AI void end() {
    b_.FreeTensor(selected_);
  }
};
r42AI Tile readDescriptor(const __gm__ u4 *p, u4 index) {
  const __gm__ u4 *v = p + 8 + 4 * index;
  return Tile{v[0], v[1], v[3], v[2], 256};
}
template <u4 Version, u4 StaticBands = 0>
__global__ __mix__(1, 2) CONTEST41_ENTRY
    void JoinedExperts(GM_ADDR x, GM_ADDR w, GM_ADDR scale, GM_ADDR groups, GM_ADDR y, GM_ADDR memory, u4 cores,
                       u4 planBytes, u4 experts, u4 rows, u4 runtimeN) {
  const u4 n = StaticBands ? StaticBands * 256 : runtimeN;
  u4 rank = coreId();
  TPipe pipe;
  CompletePanels multiply;
  FloatOutput<8192> finish;
  TBuf<ps::VECCALC> groupData, planData;
  u4 owned = 0;
  constexpr u4 Slot = 80 * 256 * 4;
  GM_ADDR scratch = memory + u8(rank) * 2 * Slot;
  GM_ADDR descriptor = memory + u8(cores) * 2 * Slot + u8(rank) * planBytes;
  if ASCEND_IS_AIC {
    multiply.setup(pipe);
    crw(4);
    owned = ((__gm__ u4 *)descriptor)[0];
  }
  if ASCEND_IS_AIV {
    pipe.InitBuffer(groupData, 512);
    pipe.InitBuffer(planData, planBytes);
    auto ends = groupData.Get<i8>();
    auto plan = planData.Get<u4>();
    gt<i8> gg;
    gg.SetGlobalBuffer((__gm__ i8 *)groups);
    dc(ends, gg, experts);
    fence<he::MTE2_S>();
    u4 start = 0, position = rank, bands = StaticBands ? StaticBands : n / 256;
    for (u4 e = 0; e < experts; ++e) {
      u4 end = u4(ends.GetValue(e)), length = end - start, tiles = (length + 63) / 64;
      if (length > 64 && length % 64 && length % 64 <= 16)
        --tiles;
      u4 count = tiles * bands;
      while (position < count) {
        u4 row = start + position / bands * 64;
        u4 height = position / bands + 1 == tiles ? end - row : 64;
        u4 at = 8 + owned * 4;
        plan.SetValue(at, e);
        plan.SetValue(at + 1, row);
        plan.SetValue(at + 2, position % bands * 256);
        plan.SetValue(at + 3, height);
        ++owned;
        position += cores;
      }
      position -= count;
      start = end;
    }
    plan.SetValue(0, owned);
    fence<he::S_MTE3>();
    if (!GetSubBlockIdx()) {
      gt<u4> gm;
      gm.SetGlobalBuffer((__gm__ u4 *)descriptor);
      dc(gm, plan, ((8 + 4 * owned + 7) / 8) * 8);
    }
    crs<2, PIPE_MTE3>(4);
    finish.setup(pipe, scale, y);
  }
  Tile current{};
  if ASCEND_IS_AIC {
    if (owned) {
      current = readDescriptor((__gm__ u4 *)descriptor, 0);
      multiply.fetch(x, w, current, n);
    }
  }
  for (u4 i = 0; i < owned; ++i) {
    Tile task{};
    if ASCEND_IS_AIC {
      task = current;
    }
    if ASCEND_IS_AIV {
      auto plan = planData.Get<u4>();
      u4 at = 8 + 4 * i;
      task = {plan.GetValue(at), plan.GetValue(at + 1), plan.GetValue(at + 3), plan.GetValue(at + 2), 256};
    }
    GM_ADDR slot = scratch + u8(i % 2) * Slot;
    if ASCEND_IS_AIC {
      multiply.begin(task.height);
      if (i + 1 < owned) {
        current = readDescriptor((__gm__ u4 *)descriptor, i + 1);
        multiply.fetch(x, w, current, n);
      }
      multiply.product(slot, task.height, i);
      multiply.end();
      crs<2, PIPE_FIX>(9 + 3 * (i % 2));
    }
    if ASCEND_IS_AIV {
      crw(9 + 3 * (i % 2));
      Geometry g{rows, n, 512, experts, cores};
      for (u4 a = 0; a < task.height; a += 64) {
        Tile part = task;
        part.row += a;
        part.height = smaller(64, task.height - a);
        finish.emit<256>(g, part, slot + u8(a) * 256 * 4, 256);
      }
      crs<2, PIPE_MTE3>(10 + 3 * (i % 2));
    }
  }
  if ASCEND_IS_AIC {
    if (owned)
      crw(10);
    if (owned > 1)
      crw(13);
  }
  if ASCEND_IS_AIV {
    finish.drain();
  }
}
class AtomicSlab {
  tq<ps::A1, 1> a_;
  tq<ps::B1, 2> prefix_;
  tq<ps::B1, 1> suffix_;
  tq<ps::A2, 2> aa_;
  tq<ps::B2, 2> bb_;
  tq<ps::CO1, 1> c_;
  lt<i1> active_, tail_, future_;
  u4 head_, height_, width_, inputStride_, weightStride_, outputStride_;
  bool first_ = true;
  r42AI void pack(lt<i1> dst, gt<i1> src, u4 depth, u4 width) {
    u4 padded = round32(depth);
    if (padded != depth) {
      InitConstValue(dst[depth * 32].ReinterpretCast<u4>(),
                     InitConstValueParams<u4>((width + 31) / 32, padded - depth, depth, 0));
      pb<PIPE_MTE2>();
    }
    dc(dst, src, Nd2NzParams(1, u2(depth), u2(width), 0, weightStride_, padded, 1, 0));
  }

public:
  r42AI void setup(TPipe &p, u4 depth, u4 width, u4 height, u8 l1, u4 k, u4 n, u4 pitch) {
    height_ = height;
    inputStride_ = k;
    weightStride_ = n;
    outputStride_ = pitch;
    width_ = width;
    u4 padded = round32(depth), spare = u4((l1 - u8(padded) * height) / width) - padded;
    head_ = spare >= padded ? padded : spare / 96 * 96;
    p.InitBuffer(a_, 1, padded * height);
    p.InitBuffer(prefix_, 2, head_ * width);
    if (padded > head_)
      p.InitBuffer(suffix_, 1, (padded - head_) * width);
    p.InitBuffer(aa_, 2, 96 * height);
    p.InitBuffer(bb_, 2, 96 * width);
    p.InitBuffer(c_, 1, 131072);
  }
  r42AI void prefetch(gt<i1> b, u4 depth, u4 cols) {
    auto t = prefix_.AllocTensor<i1>();
    pack(t, b, smaller(depth, head_), cols);
    prefix_.EnQue(t);
  }
  r42AI void activate(gt<i1> b, u4 depth, u4 cols) {
    active_ = prefix_.DeQue<i1>();
    if (depth > head_) {
      auto t = suffix_.AllocTensor<i1>();
      pack(t, b[u8(head_) * weightStride_], depth - head_, cols);
      suffix_.EnQue(t);
      tail_ = suffix_.DeQue<i1>();
    }
  }
  r42AI void prefetchPart(gt<i1> b, u4 depth, u4 cols, bool open, bool close) {
    u4 total = smaller(head_, depth), pitch = round32(total), middle = ((pitch / 2 + 31) / 32) * 32;
    if (middle > total)
      middle = total;
    if (open)
      future_ = prefix_.AllocTensor<i1>();
    u4 begin = open ? 0 : middle, end = close ? total : middle;
    if (close && pitch != total) {
      InitConstValue(future_[total * 32].ReinterpretCast<u4>(),
                     InitConstValueParams<u4>((cols + 31) / 32, pitch - total, total, 0));
      pb<PIPE_MTE2>();
    }
    if (end > begin)
      dc(future_[begin * 32], b[u8(begin) * weightStride_],
         Nd2NzParams(1, u2(end - begin), u2(cols), 0, weightStride_, pitch, 1, 0));
    if (close)
      prefix_.EnQue(future_);
  }
  r42AI void rows(gt<i1> input, GM_ADDR target, u4 rows, u4 depth, u4 cols, gt<i1> next, bool begin, bool end) {
    u1 pad[4] = {};
    Load3DSetFMatrixCal(1, height_, pad);
    u4 m = (rows + 15) / 16 * 16, k = round32(depth);
    auto accum = c_.AllocTensor<i4>();
    auto a = a_.AllocTensor<i1>();
    dc(a, input, Nd2NzParams(1, u2(rows), u2(depth), 0, inputStride_, height_, 1, 0));
    a_.EnQue(a);
    if (begin || end)
      prefetchPart(next, depth, cols, begin, end);
    auto left = a_.DeQue<i1>();
    for (u4 base = 0; base < depth; base += 96) {
      u4 count = smaller(96, k - base);
      auto l = aa_.AllocTensor<i1>();
      auto r = bb_.AllocTensor<i1>();
      LoadData3DParamsV2Pro lm;
      lm.channelSize = k;
      lm.extConfig = (u8(base) << 32) | (u8(m) << 16) | count;
      LoadData(l, left, lm);
      bool front = base < head_;
      auto from = front ? active_ : tail_;
      u4 position = front ? base : base - head_, stride = front ? head_ : k - head_;
      LoadData2dTransposeParams rm{0, u1(width_ / 32), u2(stride / 32), 1, 0, inc};
      for (u4 kk = 0; kk < count; kk += 32)
        LoadDataWithTranspose(r[kk * width_], from[(position + kk) * 32], rm);
      aa_.EnQue(l);
      bb_.EnQue(r);
      auto ar = aa_.DeQue<i1>();
      auto br = bb_.DeQue<i1>();
      MmadParams mm;
      mm.m = m;
      mm.n = width_;
      mm.k = count;
      mm.isBias = false;
      mm.cmatrixInitVal = (base == 0);
      Mmad(accum, ar, br, mm);
      aa_.FreeTensor(ar);
      bb_.FreeTensor(br);
    }
    a_.FreeTensor(left);
    c_.EnQue(accum);
    auto value = c_.DeQue<i4>();
    if (first_) {
      crw(6);
      first_ = false;
    }
    gt<i4> out;
    out.SetGlobalBuffer((__gm__ i4 *)target);
    FixpipeParamsV220 fp;
    fp.mSize = rows;
    fp.nSize = width_;
    fp.srcStride = m;
    fp.dstStride = outputStride_;
    fp.quantPre = QuantMode_t::NoQuant;
    fp.reluEn = false;
    SetAtomicAdd<i4>();
    Fixpipe<i4, i4, CFG_ROW_MAJOR>(out, value, fp);
    SetAtomicNone();
    c_.FreeTensor(value);
  }
  r42AI void release(u4 depth) {
    prefix_.FreeTensor(active_);
    if (depth > head_)
      suffix_.FreeTensor(tail_);
  }
};
template <u4 Version, u4 StaticPitch = 0>
__global__ __mix__(1, 2) CONTEST41_ENTRY
    void LongReduction(GM_ADDR x, GM_ADDR w, GM_ADDR scale, GM_ADDR groups, GM_ADDR y, GM_ADDR memory, u4 cores,
                       u4 leftCores, u4 leftRows, u4 rightRows, u8 l1, u4 experts, u4 rows, u4 n, u4 k) {
  u4 rank = coreId();
  bool right = rank >= leftCores;
  u4 team = right ? cores - leftCores : leftCores, lane = right ? rank - leftCores : rank;
  u4 slabs = round32(k) / 32, pitch = StaticPitch ? StaticPitch : round32(n), cut = (pitch / 32 * 5 / 8) * 32;
  u4 k0 = (lane * slabs / team) * 32, k1 = smaller(k, ((lane + 1) * slabs / team) * 32), depth = k1 - k0;
  u4 column = right ? cut : 0, columns = right ? n - cut : cut, height = right ? rightRows : leftRows;
  TPipe pipe;
  AtomicSlab engine;
  FloatOutput<8192> output;
  Geometry g{rows, n, k, experts, cores};
  if ASCEND_IS_AIC {
    engine.setup(pipe, depth, right ? pitch - cut : cut, height, l1, k, n, pitch);
  }
  if ASCEND_IS_AIV {
    output.setup(pipe, scale, y);
    output.zero(memory, u8(rows) * pitch, rank, cores, 6);
  }
  const __gm__ i8 *ends = (const __gm__ i8 *)groups;
  u4 first = 0, sequence = 0;
  for (u4 expert = 0; expert < experts; ++expert) {
    u4 end = u4(ends[expert]);
    if (end == first)
      continue;
    u4 next = expert + 1;
    while (next < experts && u4(ends[next]) == end)
      ++next;
    gt<i1> current, upcoming;
    if ASCEND_IS_AIC {
      current.SetGlobalBuffer((__gm__ i1 *)w + (u8(expert) * k + k0) * n + column);
      if (!sequence)
        engine.prefetch(current, depth, columns);
      engine.activate(current, depth, columns);
      if (next < experts)
        upcoming.SetGlobalBuffer((__gm__ i1 *)w + (u8(next) * k + k0) * n + column);
      for (u4 row = first; row < end; row += height) {
        u4 count = smaller(height, end - row);
        bool last = row + height >= end, opening = row + 2 * height >= end && (row == first || !last);
        gt<i1> a;
        a.SetGlobalBuffer((__gm__ i1 *)x + u8(row) * k + k0);
        engine.rows(a, memory + (u8(row) * pitch + column) * 4, count, depth, columns, upcoming,
                    next < experts && opening, next < experts && last);
      }
      if (sequence >= 2)
        crw(10 + (sequence % 2) * 3);
      crs<2, PIPE_FIX>(9 + (sequence % 2) * 3);
    }
    if ASCEND_IS_AIV {
      crw(9 + (sequence % 2) * 3);
      SyncAll<true>();
      crs<2, PIPE_MTE3>(10 + (sequence % 2) * 3);
      u4 row = first + (end - first) * lane / team, stop = first + (end - first) * (lane + 1) / team;
      while (row < stop) {
        Tile t{expert, row, smaller(50, stop - row), column, columns};
        GM_ADDR address = memory + (u8(row) * pitch + column) * 4;
        if (right)
          output.emit<256>(g, t, address, pitch);
        else
          output.emit<320>(g, t, address, pitch);
        output.drain();
        row += t.height;
      }
    }
    ++sequence;
    if ASCEND_IS_AIC {
      engine.release(depth);
    }
    first = end;
  }
  if ASCEND_IS_AIC {
    if (sequence)
      crw(10);
    if (sequence > 1)
      crw(13);
  }
  if ASCEND_IS_AIV {
    output.drain();
  }
}
template <u4 Rows, u4 Columns, u4 Depth> class FullInput {
  tq<ps::A1, 1> input_;
  tq<ps::B1, 2> weights_;
  tq<ps::A2, 2> left_;
  tq<ps::B2, 2> right_;
  tq<ps::CO1, 1> accum_;
  r42AI void request(gt<i1> w, u4 k, u4 start) {
    u4 span = smaller(256, k - start);
    auto b = weights_.AllocTensor<i1>();
    dc(b, w[u8(start) * 1024], Nd2NzParams(1, u2(span), Columns, 0, 1024, span, 1, 0));
    weights_.EnQue(b);
  }

public:
  r42AI void setup(TPipe &pipe) {
    pipe.InitBuffer(input_, 1, Rows * 2048);
    pipe.InitBuffer(weights_, 2, 256 * Columns);
    pipe.InitBuffer(left_, 2, Rows * Depth);
    pipe.InitBuffer(right_, 2, Columns * Depth);
    pipe.InitBuffer(accum_, 1, Rows * Columns * 4);
  }
  r42AI void run(GM_ADDR x, GM_ADDR w, GM_ADDR target, const Tile &tile, u4 kStart, u4 kSize, u4 rank, bool rotated,
                 bool lead, bool atomic, bool waitZero) {
    gt<i1> a, b;
    a.SetGlobalBuffer((__gm__ i1 *)x + u8(tile.row) * 2048 + kStart);
    b.SetGlobalBuffer((__gm__ i1 *)w + (u8(tile.expert) * 2048 + kStart) * 1024 + tile.col);
    u4 panels = (kSize + 255) / 256, phase = rotated ? (rank * 3) % panels : 0, padded = (tile.height + 15) / 16 * 16;
    if (lead)
      request(b, kSize, phase * 256);
    u1 pad[4] = {};
    Load3DSetFMatrixCal(1, Rows, pad);
    auto in = input_.AllocTensor<i1>();
    dc(in, a, Nd2NzParams(1, u2(tile.height), u2(kSize), 0, 2048, Rows, 1, 0));
    input_.EnQue(in);
    auto stored = input_.DeQue<i1>();
    if (!lead)
      request(b, kSize, phase * 256);
    if (panels > 1)
      request(b, kSize, ((phase + 1) % panels) * 256);
    auto c = accum_.AllocTensor<i4>();
    for (u4 panel = 0; panel < panels; ++panel) {
      u4 base = ((phase + panel) % panels) * 256, span = smaller(256, kSize - base);
      auto weight = weights_.DeQue<i1>();
      for (u4 kk = 0; kk < span; kk += Depth) {
        auto l = left_.AllocTensor<i1>();
        auto r = right_.AllocTensor<i1>();
        LoadData3DParamsV2Pro am;
        am.channelSize = kSize;
        am.extConfig = (u8(base + kk) << 32) | (u8(padded) << 16) | Depth;
        LoadData(l, stored, am);
        LoadData2dTransposeParams bm{0, u1(Columns / 32), u2(span / 32), 1, 0, inc};
        for (u4 z = 0; z < Depth; z += 32)
          LoadDataWithTranspose(r[z * Columns], weight[(kk + z) * 32], bm);
        left_.EnQue(l);
        right_.EnQue(r);
        auto ar = left_.DeQue<i1>();
        auto br = right_.DeQue<i1>();
        MmadParams mm;
        mm.m = padded;
        mm.n = Columns;
        mm.k = Depth;
        mm.isBias = false;
        mm.cmatrixInitVal = (panel == 0 && kk == 0);
        Mmad(c, ar, br, mm);
        left_.FreeTensor(ar);
        right_.FreeTensor(br);
      }
      weights_.FreeTensor(weight);
      if (panel + 2 < panels)
        request(b, kSize, ((phase + panel + 2) % panels) * 256);
    }
    accum_.EnQue(c);
    auto value = accum_.DeQue<i4>();
    gt<i4> out;
    out.SetGlobalBuffer((__gm__ i4 *)target);
    FixpipeParamsV220 fp;
    fp.mSize = tile.height;
    fp.nSize = Columns;
    fp.srcStride = padded;
    fp.dstStride = Columns;
    fp.quantPre = QuantMode_t::NoQuant;
    fp.reluEn = false;
    if (atomic) {
      if (waitZero)
        crw(6);
      SetAtomicAdd<i4>();
    }
    Fixpipe<i4, i4, CFG_ROW_MAJOR>(out, value, fp);
    if (atomic)
      SetAtomicNone();
    accum_.FreeTensor(value);
    input_.FreeTensor(stored);
  }
};
template <u4 StaticExperts = 0> class MixedPlan {
  const __gm__ i8 *global_;
  lt<i8> local_;
  lt<u4> output_;
  u4 rank_, cores_, experts_;
  bool initialBundle_;
  Tile first_{};
  u4 count_ = 0;
  r42AI u4 end(u4 e) {
    u4 v = 0;
    if ASCEND_IS_AIC {
      v = u4(global_[e]);
    }
    if ASCEND_IS_AIV {
      v = u4(local_.GetValue(e));
    }
    return v;
  }
  r42AI void append(u4 expert, u4 row, u4 height, u4 col) {
    if (!count_)
      first_ = {expert, row, height, col, 256};
    if ASCEND_IS_AIV {
      u4 at = 8 + count_ * 4;
      output_.SetValue(at, expert);
      output_.SetValue(at + 1, row);
      output_.SetValue(at + 2, col);
      output_.SetValue(at + 3, height);
    }
    ++count_;
  }

public:
  r42AI void setup(GM_ADDR groups, lt<i8> local, lt<u4> records, u4 rank, u4 cores, u4 experts, u4 rows) {
    setupHint(groups, local, records, rank, cores, experts, ((rows + 127) / 128) * 4 >= 2 * cores);
  }
  r42AI void setupHint(GM_ADDR groups, lt<i8> local, lt<u4> records, u4 rank, u4 cores, u4 experts,
                       bool initialBundle) {
    global_ = (const __gm__ i8 *)groups;
    local_ = local;
    output_ = records;
    rank_ = rank;
    cores_ = cores;
    experts_ = experts;
    initialBundle_ = initialBundle;
  }
  r42AI bool uniform() {
    if (2 * (StaticExperts ? StaticExperts : experts_) < cores_)
      return false;
    u4 previous = 0;
    bool small = true;
    for (u4 e = 0; e < (StaticExperts ? StaticExperts : experts_); ++e) {
      u4 v = end(e);
      small = small && (v - previous == 64);
      previous = v;
    }
    return small;
  }
  r42AI u4 make() {
    u4 heavy = 0, light = 0, previous = 0;
    for (u4 e = 0; e < (StaticExperts ? StaticExperts : experts_); ++e) {
      u4 v = end(e), length = v - previous, tail = length % 128;
      heavy += (length / 128 + (tail > 64)) * 4;
      light += (tail && tail <= 64) * 4;
      previous = v;
    }
    u4 extra = heavy % cores_, idle = cores_ - extra, shortCapacity = 2 * idle;
    u4 lower = light <= shortCapacity ? (light + idle - 1) / idle : 2 + (light - shortCapacity + cores_ - 1) / cores_;
    u4 upper = extra ? 2 : 0, panels = 2 * (heavy / cores_) + (lower > upper ? lower : upper);
    bool bundle = initialBundle_;
    if (!bundle && heavy && heavy + light >= cores_ && panels <= (2 * heavy + light + cores_ - 1) / cores_)
      bundle = true;
    if (!bundle) {
      u4 next = rank_, start = 0;
      for (u4 e = 0; e < (StaticExperts ? StaticExperts : experts_); ++e) {
        u4 stop = end(e), total = (stop - start + 63) / 64 * 4;
        while (next < total) {
          u4 row = start + next / 4 * 64;
          append(e, row, smaller(64, stop - row), next % 4 * 256);
          next += cores_;
        }
        next -= total;
        start = stop;
      }
    } else {
      u4 next = rank_, start = 0;
      for (u4 e = 0; e < (StaticExperts ? StaticExperts : experts_); ++e) {
        u4 stop = end(e), length = stop - start, total = (length / 128 + (length % 128 > 64)) * 4;
        while (next < total) {
          u4 row = start + next / 4 * 128;
          append(e, row, smaller(128, stop - row), next % 4 * 256);
          next += cores_;
        }
        next -= total;
        start = stop;
      }
      u4 index = 0;
      start = 0;
      for (u4 e = 0; e < (StaticExperts ? StaticExperts : experts_); ++e) {
        u4 stop = end(e), tail = (stop - start) % 128, total = (tail && tail <= 64) * 4;
        for (u4 c = 0; c < total; ++c, ++index) {
          u4 owner = index < shortCapacity ? extra + index % idle : (index - shortCapacity) % cores_;
          if (owner == rank_)
            append(e, stop - tail, tail, c * 256);
        }
        start = stop;
      }
    }
    if ASCEND_IS_AIV {
      output_.SetValue(0, count_);
    }
    return count_;
  }
  r42AI Tile first() {
    return first_;
  }
};
template <u4 Version, u4 StaticExperts = 0>
__global__ __mix__(1, 2) CONTEST41_ENTRY
    void WideExperts(GM_ADDR x, GM_ADDR w, GM_ADDR scale, GM_ADDR groups, GM_ADDR y, GM_ADDR memory, u4 cores,
                     u4 planBytes, u8 cacheOffset, u4 experts, u4 rows, u4 initialBundle) {
  const u4 expertCount = StaticExperts ? StaticExperts : experts;
  u4 rank = coreId();
  TPipe pipe;
  TBuf<ps::VECCALC> groupsBuffer, recordsBuffer;
  lt<i8> local;
  lt<u4> records;
  if ASCEND_IS_AIV {
    pipe.InitBuffer(groupsBuffer, 1024);
    local = groupsBuffer.Get<i8>();
    gt<i8> gm;
    gm.SetGlobalBuffer((__gm__ i8 *)groups);
    dc(local, gm, expertCount);
    fence<he::MTE2_S>();
    pipe.InitBuffer(recordsBuffer, planBytes);
    records = recordsBuffer.Get<u4>();
  }
  MixedPlan<StaticExperts> enumerate;
  enumerate.setupHint(groups, local, records, rank, cores, expertCount, initialBundle != 0);
  bool small = enumerate.uniform();
  constexpr u4 C = 128 * 256 * 4;
  GM_ADDR privateSlots = memory + u8(rank) * 2 * C;
  GM_ADDR metadata = memory + u8(cores) * 2 * C + u8(rank) * planBytes;
  GM_ADDR extra = memory + u8(cores) * (2 * C + planBytes);
  if (small) {
    GM_ADDR weights = w;
#if defined(__NPU_ARCH__) && __NPU_ARCH__ == 2201
    u8 address = (u8)w;
    if (cacheOffset && address <= UINT64_MAX - cacheOffset)
      weights = (GM_ADDR)(address + cacheOffset);
#endif
    FullInput<64, 512, 64> cube;
    FloatOutput<8192> finish;
    if ASCEND_IS_AIC {
      cube.setup(pipe);
    }
    if ASCEND_IS_AIV {
      finish.setup(pipe, scale, y);
    }
    u4 totalTiles = 2 * expertCount;
    bool split = totalTiles > cores && totalTiles < 2 * cores && 8 >= cores / (totalTiles - cores) + 1;
    Geometry g{rows, 1024, 2048, expertCount, cores};
    if (split) {
      u4 tails = totalTiles - cores, total = tails * 16;
      if ASCEND_IS_AIV {
        finish.zero(extra, u8(tails) * 64 * 512, rank, cores, 6);
      }
      if ASCEND_IS_AIC {
        u4 a = u8(total) * rank / cores, b = u8(total) * (rank + 1) / cores;
        bool first = true;
        while (a < b) {
          u4 tail = a / 16, original = cores + tail, end = smaller(b, (tail + 1) * 16);
          Tile tile{original / 2, (original / 2) * 64, 64, (original % 2) * 512, 512};
          cube.run(x, weights, extra + u8(tail) * C, tile, (a % 16) * 128, (end - a) * 128, rank, false, true, true,
                   first);
          first = false;
          a = end;
        }
        crs<2, PIPE_FIX>(5);
        Tile full{rank / 2, (rank / 2) * 64, 64, (rank % 2) * 512, 512};
        cube.run(x, weights, privateSlots, full, 0, 2048, rank, false, true, false, false);
        crs<2, PIPE_FIX>(9);
      }
      if ASCEND_IS_AIV {
        crw(5);
        SyncAll<true>();
        for (u4 part = rank; part < 2 * tails; part += cores) {
          u4 index = cores + part / 2, offset = part % 2 * 32;
          Tile t{index / 2, (index / 2) * 64 + offset, 32, (index % 2) * 512, 512};
          finish.emit<512>(g, t, extra + u8(part / 2) * C + offset * 512 * 4, 512);
        }
        crw(9);
        Tile t{rank / 2, (rank / 2) * 64, 64, (rank % 2) * 512, 512};
        finish.emit<512>(g, t, privateSlots, 512);
        finish.drain();
      }
    } else {
      u4 owned = 0;
      if ASCEND_IS_AIV {
        for (u4 task = rank; task < totalTiles; task += cores) {
          u4 at = 8 + 4 * owned++;
          records.SetValue(at, task / 2);
          records.SetValue(at + 1, (task / 2) * 64);
          records.SetValue(at + 2, (task % 2) * 512);
          records.SetValue(at + 3, 64);
        }
        records.SetValue(0, owned);
        fence<he::S_MTE3>();
        if (!GetSubBlockIdx()) {
          gt<u4> gm;
          gm.SetGlobalBuffer((__gm__ u4 *)metadata);
          dc(gm, records, ((8 + 4 * owned + 7) / 8) * 8);
        }
        crs<2, PIPE_MTE3>(8);
      }
      if ASCEND_IS_AIC {
        crw(8);
        owned = ((__gm__ u4 *)metadata)[0];
      }
      for (u4 i = 0; i < owned; ++i) {
        Tile task{};
        if ASCEND_IS_AIC {
          task = readDescriptor((__gm__ u4 *)metadata, i);
          task.width = 512;
        }
        if ASCEND_IS_AIV {
          u4 at = 8 + 4 * i;
          task = {records.GetValue(at), records.GetValue(at + 1), 64, records.GetValue(at + 2), 512};
        }
        GM_ADDR slot = privateSlots + u8(i % 2) * C;
        if ASCEND_IS_AIC {
          if (i >= 2)
            crw(10 + 3 * (i % 2));
          cube.run(x, weights, slot, task, 0, 2048, rank, false, false, false, false);
          crs<2, PIPE_FIX>(9 + 3 * (i % 2));
        }
        if ASCEND_IS_AIV {
          crw(9 + 3 * (i % 2));
          finish.emit<512>(g, task, slot, 512);
          crs<2, PIPE_MTE3>(10 + 3 * (i % 2));
        }
      }
      if ASCEND_IS_AIC {
        if (owned)
          crw(10);
        if (owned > 1)
          crw(13);
      }
      if ASCEND_IS_AIV {
        finish.drain();
      }
    }
  } else {
    FullInput<128, 256, 128> cube;
    FloatOutput<8192> finish;
    u4 owned = enumerate.make();
    Tile first = enumerate.first();
    bool unique = owned <= 15;
    if ASCEND_IS_AIC {
      cube.setup(pipe);
    }
    if ASCEND_IS_AIV {
      fence<he::S_MTE3>();
      if (!GetSubBlockIdx()) {
        gt<u4> gm;
        gm.SetGlobalBuffer((__gm__ u4 *)metadata);
        dc(gm, records, ((8 + 4 * owned + 7) / 8) * 8);
      }
      crs<2, PIPE_MTE3>(8);
      finish.setup(pipe, scale, y);
    }
    if ASCEND_IS_AIC {
      if (!owned)
        crw(8);
    }
    Geometry g{rows, 1024, 2048, expertCount, cores};
    for (u4 i = 0; i < owned; ++i) {
      Tile t{};
      if ASCEND_IS_AIC {
        t = i ? readDescriptor((__gm__ u4 *)metadata, i) : first;
      }
      if ASCEND_IS_AIV {
        u4 at = 8 + 4 * i;
        t = {records.GetValue(at), records.GetValue(at + 1), records.GetValue(at + 3), records.GetValue(at + 2), 256};
      }
      GM_ADDR slot = unique ? extra + (u8(t.row) * 1024 + u8(t.col) * t.height) * 4 : privateSlots + u8(i % 2) * C;
      u4 signal = unique ? (i < 8 ? i : i + 1) : 9 + 3 * (i % 2);
      if ASCEND_IS_AIC {
        if (!unique && i >= 2)
          crw(10 + 3 * (i % 2));
        cube.run(x, w, slot, t, 0, 2048, rank, true, true, false, false);
        crs<2, PIPE_FIX>(signal);
        if (!i) {
          crw(8);
          owned = ((__gm__ u4 *)metadata)[0];
        }
      }
      if ASCEND_IS_AIV {
        crw(signal);
        finish.emit<256>(g, t, slot, 256);
        if (!unique)
          crs<2, PIPE_MTE3>(10 + 3 * (i % 2));
      }
    }
    if ASCEND_IS_AIC {
      if (!unique && owned)
        crw(10);
      if (!unique && owned > 1)
        crw(13);
    }
    if ASCEND_IS_AIV {
      finish.drain();
    }
  }
}
static u4 physical(u4 requested) {
  auto *p = platform_ascendc::PlatformAscendCManager::GetInstance();
  if (!p)
    throw std::runtime_error("platform unavailable");
  return std::min<u4>(requested, std::min<u4>(p->GetCoreNumAic(), p->GetCoreNumAiv() / 2));
}
static bool resources(u8 l1Need, u8 aNeed, u8 bNeed, u8 cNeed, u8 ubNeed) {
  auto *p = platform_ascendc::PlatformAscendCManager::GetInstance();
  if (!p)
    return false;
  const platform_ascendc::CoreMemType kind[] = {platform_ascendc::CoreMemType::L1, platform_ascendc::CoreMemType::L0_A,
                                                platform_ascendc::CoreMemType::L0_B,
                                                platform_ascendc::CoreMemType::L0_C, platform_ascendc::CoreMemType::UB};
  const u8 required[] = {l1Need, aNeed, bNeed, cNeed, ubNeed};
  for (u4 i = 0; i < 5; ++i) {
    if (required[i] == 0)
      continue;
    u8 actual = 0;
    p->GetCoreMemSize(kind[i], actual);
    if (actual < required[i])
      return false;
  }
  return true;
}
static void *workspace(u8 bytes) {
  void *p = nullptr;
  if (aclrtMalloc(&p, bytes, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS)
    throw std::runtime_error("four-path allocation");
  return p;
}
static void release(void *p, aclrtStream stream) {
  auto first = aclrtSynchronizeStream(stream);
  auto second = aclrtFree(p);
  if (first != ACL_SUCCESS || second != ACL_SUCCESS)
    throw std::runtime_error("four-path execution");
}
bool runShort(GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR g, GM_ADDR y, u4 experts, u4 rows, u4 requested,
              aclrtStream stream) {
  u4 cores = physical(requested);
  if (!cores || experts < 4 || experts > 128 || experts % 4 || rows < 16 ||
      !resources((80 + 2 * 256) * 256, 80 * 256, 256 * 256, 80 * 256 * 4, 4 * 10240 * 4 + 2048 + 1024))
    return false;
  void *p = workspace(u8(cores) * 3 * (80 * 256 * 4 + 512));
  ShortExpert<1><<<cores, nullptr, stream>>>(x, w, s, g, y, (u1 *)p, cores, experts, rows);
  release(p, stream);
  return true;
}
bool runJoined(GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR g, GM_ADDR y, u4 experts, u4 rows, u4 n, u4 requested,
               aclrtStream stream) {
  u4 cores = physical(requested);
  if (!cores || experts > 64 || experts % 4 || n % 256)
    return false;
  u4 upper = ((rows + 63) / 64 + experts - 1) * (n / 256);
  u4 maxTasks = (upper + cores - 1) / cores, bytes = (32 + 16 * maxTasks + 255) / 256 * 256;
  if (!resources(2 * (80 + 256) * 512, 2 * 80 * 128, 2 * 128 * 256, 80 * 256 * 4, 8192 * 18 + 2048 + 512 + bytes))
    return false;
  void *p = workspace(u8(cores) * (2 * 80 * 256 * 4 + bytes));
  switch (n / 256) {
  case 3:
    JoinedExperts<1, 3><<<cores, nullptr, stream>>>(x, w, s, g, y, (u1 *)p, cores, bytes, experts, rows, n);
    break;
  case 5:
    JoinedExperts<1, 5><<<cores, nullptr, stream>>>(x, w, s, g, y, (u1 *)p, cores, bytes, experts, rows, n);
    break;
  case 7:
    JoinedExperts<1, 7><<<cores, nullptr, stream>>>(x, w, s, g, y, (u1 *)p, cores, bytes, experts, rows, n);
    break;
  case 9:
    JoinedExperts<1, 9><<<cores, nullptr, stream>>>(x, w, s, g, y, (u1 *)p, cores, bytes, experts, rows, n);
    break;
  case 11:
    JoinedExperts<1, 11><<<cores, nullptr, stream>>>(x, w, s, g, y, (u1 *)p, cores, bytes, experts, rows, n);
    break;
  case 13:
    JoinedExperts<1, 13><<<cores, nullptr, stream>>>(x, w, s, g, y, (u1 *)p, cores, bytes, experts, rows, n);
    break;
  case 15:
    JoinedExperts<1, 15><<<cores, nullptr, stream>>>(x, w, s, g, y, (u1 *)p, cores, bytes, experts, rows, n);
    break;
  default:
    JoinedExperts<1, 0><<<cores, nullptr, stream>>>(x, w, s, g, y, (u1 *)p, cores, bytes, experts, rows, n);
    break;
  }
  release(p, stream);
  return true;
}
bool runLong(GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR g, GM_ADDR y, u4 experts, u4 rows, u4 n, u4 k, u4 requested,
             aclrtStream stream) {
  u4 cores = physical(requested);
  auto *p = platform_ascendc::PlatformAscendCManager::GetInstance();
  u8 l1 = 0;
  p->GetCoreMemSize(platform_ascendc::CoreMemType::L1, l1);
  u4 slabs = (k + 31) / 32, pitch = (n + 31) / 32 * 32, cut = (pitch / 32 * 5 / 8) * 32;
  u4 right = pitch - cut;
  if (!cores || !cut || cut >= n || cut > 320 || right > 256)
    return false;
  u4 leftRows = std::min<u4>(112, 32768 / cut / 16 * 16);
  u4 rightRows = std::min<u4>(112, 32768 / right / 16 * 16);
  u4 capacityL = u4(l1 / ((cut + leftRows) * 32));
  u4 capacityR = u4(l1 / ((right + rightRows) * 32));
  if (!capacityL || !capacityR)
    return false;
  u4 minimumL = (slabs + capacityL - 1) / capacityL;
  u4 minimumR = (slabs + capacityR - 1) / capacityR;
  if (minimumL + minimumR > cores)
    return false;
  u4 left = std::max(minimumL, std::min(cores - minimumR, (cores * cut + pitch / 2) / pitch));
  auto fits = [&](u4 lanes, u4 columns, u4 height) {
    u8 span = u8((slabs + lanes - 1) / lanes) * 32;
    u8 head = std::min(span, ((span / 2 + 95) / 96) * 96);
    return lanes <= slabs && span * height + (2 * head + std::max<u8>(32, span - head)) * columns <= l1;
  };
  if (!left || left == cores || !fits(left, cut, leftRows) || !fits(cores - left, right, rightRows) ||
      !resources(0, 2 * 96 * std::max(leftRows, rightRows), 2 * 96 * std::max(cut, right), 131072, 8192 * 18 + 2048))
    return false;
  void *data = workspace(u8(rows) * pitch * 4);
  switch (pitch) {
  case 288:
    LongReduction<1, 288><<<cores, nullptr, stream>>>(x, w, s, g, y, (u1 *)data, cores, left, leftRows, rightRows, l1,
                                                      experts, rows, n, k);
    break;
  case 320:
    LongReduction<1, 320><<<cores, nullptr, stream>>>(x, w, s, g, y, (u1 *)data, cores, left, leftRows, rightRows, l1,
                                                      experts, rows, n, k);
    break;
  case 352:
    LongReduction<1, 352><<<cores, nullptr, stream>>>(x, w, s, g, y, (u1 *)data, cores, left, leftRows, rightRows, l1,
                                                      experts, rows, n, k);
    break;
  case 384:
    LongReduction<1, 384><<<cores, nullptr, stream>>>(x, w, s, g, y, (u1 *)data, cores, left, leftRows, rightRows, l1,
                                                      experts, rows, n, k);
    break;
  case 416:
    LongReduction<1, 416><<<cores, nullptr, stream>>>(x, w, s, g, y, (u1 *)data, cores, left, leftRows, rightRows, l1,
                                                      experts, rows, n, k);
    break;
  case 448:
    LongReduction<1, 448><<<cores, nullptr, stream>>>(x, w, s, g, y, (u1 *)data, cores, left, leftRows, rightRows, l1,
                                                      experts, rows, n, k);
    break;
  case 480:
    LongReduction<1, 480><<<cores, nullptr, stream>>>(x, w, s, g, y, (u1 *)data, cores, left, leftRows, rightRows, l1,
                                                      experts, rows, n, k);
    break;
  case 512:
    LongReduction<1, 512><<<cores, nullptr, stream>>>(x, w, s, g, y, (u1 *)data, cores, left, leftRows, rightRows, l1,
                                                      experts, rows, n, k);
    break;
  case 544:
    LongReduction<1, 544><<<cores, nullptr, stream>>>(x, w, s, g, y, (u1 *)data, cores, left, leftRows, rightRows, l1,
                                                      experts, rows, n, k);
    break;
  default:
    LongReduction<1, 0><<<cores, nullptr, stream>>>(x, w, s, g, y, (u1 *)data, cores, left, leftRows, rightRows, l1,
                                                    experts, rows, n, k);
    break;
  }
  release(data, stream);
  return true;
}
u8 weightMapping();
bool runWide(GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR g, GM_ADDR y, u4 experts, u4 rows, u4 requested,
             aclrtStream stream) {
  u4 cores = physical(requested);
  if (!cores || experts % 4 || experts > 128)
    return false;
  u4 upper = ((rows + 63) / 64 + experts - 1) * 4;
  u4 maximum = (upper + cores - 1) / cores, bytes = (32 + 20 * maximum + 255) / 256 * 256;
  if (!resources(128 * 2048 + 2 * 256 * 256, 2 * 128 * 128, 2 * 256 * 128, 128 * 256 * 4,
                 8192 * 18 + 2048 + 1024 + bytes))
    return false;
  void *p = workspace(u8(cores) * (2 * 128 * 256 * 4 + bytes) + u8(rows) * 1024 * 4);
  const u8 mapping = weightMapping();
  const u4 initialBundle = ((rows + 127) / 128) * 4 >= 2 * cores;
  switch (experts) {
  case 4:
    WideExperts<1, 4>
        <<<cores, nullptr, stream>>>(x, w, s, g, y, (u1 *)p, cores, bytes, mapping, experts, rows, initialBundle);
    break;
  case 8:
    WideExperts<1, 8>
        <<<cores, nullptr, stream>>>(x, w, s, g, y, (u1 *)p, cores, bytes, mapping, experts, rows, initialBundle);
    break;
  case 16:
    WideExperts<1, 16>
        <<<cores, nullptr, stream>>>(x, w, s, g, y, (u1 *)p, cores, bytes, mapping, experts, rows, initialBundle);
    break;
  case 32:
    WideExperts<1, 32>
        <<<cores, nullptr, stream>>>(x, w, s, g, y, (u1 *)p, cores, bytes, mapping, experts, rows, initialBundle);
    break;
  case 64:
    WideExperts<1, 64>
        <<<cores, nullptr, stream>>>(x, w, s, g, y, (u1 *)p, cores, bytes, mapping, experts, rows, initialBundle);
    break;
  case 128:
    WideExperts<1, 128>
        <<<cores, nullptr, stream>>>(x, w, s, g, y, (u1 *)p, cores, bytes, mapping, experts, rows, initialBundle);
    break;
  default:
    WideExperts<1, 0>
        <<<cores, nullptr, stream>>>(x, w, s, g, y, (u1 *)p, cores, bytes, mapping, experts, rows, initialBundle);
    break;
  }
  release(p, stream);
  return true;
}
} // namespace contest41
extern "C" i4 rtGetL2CacheOffset(u4, u8 *) __attribute__((weak));
namespace contest41 {
u8 weightMapping() {
  u8 offset = 0;
  i4 device = -1;
  if (rtGetL2CacheOffset) {
    if (aclrtGetDevice(&device) == ACL_SUCCESS && device >= 0) {
      if (rtGetL2CacheOffset(u4(device), &offset) == 0)
        return offset;
    }
  }
  return 0;
}
} // namespace contest41
#undef CONTEST41_ENTRY

#if defined(__DAV_VEC__) || defined(__DAV_C220_VEC__)
#define CONTEST42_ENTRY __attribute__((section(".gmg_round42_vector"), aligned(256)))
#else
#define CONTEST42_ENTRY __attribute__((section(".gmg_round42_cube"), aligned(256)))
#endif
namespace contest42 {
using namespace AscendC;
using contest41::Tile;
using contest41::Geometry;
using contest41::FloatOutput;
using contest41::smaller;
using contest41::round32;
using contest41::coreId;
class PairedOrder {
  const __gm__ i8 *ends_;
  u4 experts_, cores_, whole_ = 0, total_ = 0, tails_ = 0;
  struct Suffix {
    u4 expert, row, length;
  };
  Suffix unsorted_[8], ordered_[8];
  bool sorted_;

public:
  r42AI void setup(GM_ADDR groups, u4 cores, u4 experts) {
    ends_ = (const __gm__ i8 *)groups;
    cores_ = cores;
    experts_ = experts;
    u4 begin = 0;
    for (u4 e = 0; e < experts_; ++e) {
      u4 end = u4(ends_[e]), length = end - begin;
      total_ += (length + 127) / 128 * 4;
      whole_ += length / 128 * 4;
      if (length % 128)
        unsorted_[tails_++] = {e, end - length % 128, length % 128};
      begin = end;
    }
    sorted_ = tails_ && total_ > cores_ && total_ <= 4 * cores_;
    if (sorted_)
      for (u4 i = 0; i < tails_; ++i) {
        u4 rank = 0;
        for (u4 j = 0; j < tails_; ++j)
          rank += unsorted_[j].length > unsorted_[i].length || (unsorted_[j].length == unsorted_[i].length && j < i);
        ordered_[rank] = unsorted_[i];
      }
  }
  r42AI u4 waves() {
    return (total_ + cores_ - 1) / cores_;
  }
  r42AI bool locate(u4 wave, u4 worker, Tile &t) {
    u4 index = wave * cores_ + ((sorted_ && (wave % 2)) ? cores_ - 1 - worker : worker);
    if (index >= total_)
      return false;
    if (sorted_ && index >= whole_) {
      u4 tail = index - whole_;
      auto a = ordered_[tail / 4];
      t = {a.expert, a.row, a.length, (tail % 4) * 256, 256};
      return true;
    }
    u4 begin = 0;
    for (u4 e = 0; e < experts_; ++e) {
      u4 end = u4(ends_[e]), length = end - begin, rows = sorted_ ? length / 128 : (length + 127) / 128,
         count = rows * 4;
      if (index < count) {
        u4 row = begin + index / 4 * 128;
        t = {e, row, sorted_ ? 128 : smaller(128, end - row), (index % 4) * 256, 256};
        return true;
      }
      index -= count;
      begin = end;
    }
    return false;
  }
};
class PairedOperands {
  tq<ps::A1, 2> a_;
  tq<ps::B1, 4> b_;
  tq<ps::B1, 2> ahead_;
  tq<ps::A2, 2> aa_;
  tq<ps::B2, 2> bb_;
  tq<ps::CO1, 2> c_;
  lt<i1> resident_[4];
  GM_ADDR second_;
  u4 secondHeight_ = 0, phase_ = 0, loaded_ = 0;
  bool nextReady_ = false, nextMain_ = false, imported_ = false, staged_ = true;
  r42AI void fetchB(gt<i1> source, u4 index, bool look) {
    auto t = look ? ahead_.AllocTensor<i1>() : b_.AllocTensor<i1>();
    dc(t, source[u8((index + phase_) % 4) * 256 * 1024], Nd2NzParams(1, 256, 256, 0, 1024, 256, 1, 0));
    if (look)
      ahead_.EnQue(t);
    else
      b_.EnQue(t);
  }

public:
  r42AI void setup(TPipe &p, bool priv) {
    staged_ = priv;
    if (priv)
      p.InitBuffer(ahead_, 2, 256 * 256);
    p.InitBuffer(a_, priv ? 1 : 2, 64 * 1024);
    p.InitBuffer(b_, 4, 256 * 256);
    p.InitBuffer(aa_, 2, 64 * 128);
    p.InitBuffer(bb_, 2, 256 * 128);
    p.InitBuffer(c_, 2, 64 * 256 * 4);
  }
  r42AI void open(GM_ADDR x, GM_ADDR w, const Tile &t, u4 worker) {
    phase_ = worker % 4;
    auto a = a_.AllocTensor<i1>();
    gt<i1> input, weight;
    input.SetGlobalBuffer((__gm__ i1 *)x + u8(t.row) * 1024);
    weight.SetGlobalBuffer((__gm__ i1 *)w + u8(t.expert) * 1024 * 1024 + t.col);
    dc(a, input, Nd2NzParams(1, u2(smaller(64, t.height)), 1024, 0, 1024, 64, 1, 0));
    a_.EnQue(a);
    bool staged = nextReady_;
    imported_ = staged && !nextMain_;
    nextReady_ = false;
    for (u4 i = staged ? 2 : 0; i < 4; ++i)
      fetchB(weight, i, false);
    second_ = x + u8(t.row + 64) * 1024;
    secondHeight_ = t.height > 64 ? t.height - 64 : 0;
    if (!staged_ && secondHeight_)
      second();
    resident_[0] = imported_ ? ahead_.DeQue<i1>() : b_.DeQue<i1>();
    loaded_ = 1;
    u1 padding[4] = {};
    Load3DSetFMatrixCal(1, 64, padding);
  }
  r42AI void second() {
    auto t = a_.AllocTensor<i1>();
    gt<i1> input;
    input.SetGlobalBuffer((__gm__ i1 *)second_);
    dc(t, input, Nd2NzParams(1, u2(secondHeight_), 1024, 0, 1024, 64, 1, 0));
    a_.EnQue(t);
  }
  r42AI void prefetch(GM_ADDR w, const Tile &next) {
    gt<i1> weight;
    weight.SetGlobalBuffer((__gm__ i1 *)w + u8(next.expert) * 1024 * 1024 + next.col);
    for (u4 i = 0; i < 2; ++i)
      fetchB(weight, i, !imported_);
    nextMain_ = imported_;
    nextReady_ = true;
  }
  r42AI void product(GM_ADDR address, u4 rows) {
    auto left = a_.DeQue<i1>();
    auto sum = c_.AllocTensor<i4>();
    u4 m = (rows + 15) / 16 * 16;
    for (u4 k = 0; k < 1024; k += 128) {
      if (k / 256 == loaded_) {
        resident_[loaded_] = (imported_ && loaded_ < 2) ? ahead_.DeQue<i1>() : b_.DeQue<i1>();
        ++loaded_;
      }
      auto l = aa_.AllocTensor<i1>();
      auto r = bb_.AllocTensor<i1>();
      LoadData3DParamsV2Pro am;
      am.channelSize = 1024;
      am.extConfig = (u8((k + phase_ * 256) % 1024) << 32) | (u8(m) << 16) | 128;
      LoadData(l, left, am);
      LoadData2dTransposeParams bm{0, 8, 8, 1, 0, inc};
      for (u4 q = 0; q < 128; q += 32)
        LoadDataWithTranspose(r[q * 256], resident_[k / 256][(k % 256 + q) * 32], bm);
      aa_.EnQue(l);
      bb_.EnQue(r);
      auto al = aa_.DeQue<i1>();
      auto br = bb_.DeQue<i1>();
      MmadParams mm;
      mm.m = m;
      mm.n = 256;
      mm.k = 128;
      mm.isBias = false;
      mm.cmatrixInitVal = (k == 0);
      Mmad(sum, al, br, mm);
      aa_.FreeTensor(al);
      bb_.FreeTensor(br);
    }
    c_.EnQue(sum);
    auto value = c_.DeQue<i4>();
    gt<i4> output;
    output.SetGlobalBuffer((__gm__ i4 *)address);
    FixpipeParamsV220 fp;
    fp.mSize = rows;
    fp.nSize = 256;
    fp.srcStride = m;
    fp.dstStride = 256;
    fp.quantPre = QuantMode_t::NoQuant;
    fp.reluEn = false;
    Fixpipe<i4, i4, CFG_ROW_MAJOR>(output, value, fp);
    c_.FreeTensor(value);
    a_.FreeTensor(left);
  }
  r42AI void close() {
    for (u4 i = 0; i < 4; ++i) {
      if (imported_ && i < 2)
        ahead_.FreeTensor(resident_[i]);
      else
        b_.FreeTensor(resident_[i]);
    }
  }
};
template <u4 Version, bool Private>
__global__ __mix__(1, 2) CONTEST42_ENTRY void PairedRows(GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR groups, GM_ADDR y,
                                                         GM_ADDR memory, u4 cores, u4 experts, u4 totalRows) {
  u4 rank = coreId(), ordinal = 0;
  PairedOrder plan;
  plan.setup(groups, cores, experts);
  TPipe p;
  PairedOperands cube;
  FloatOutput<8192> out;
  if ASCEND_IS_AIC {
    cube.setup(p, Private);
  }
  if ASCEND_IS_AIV {
    out.setup(p, s, y);
  }
  Geometry shape{totalRows, 1024, 1024, experts, cores};
  for (u4 wave = 0; wave < plan.waves(); ++wave) {
    Tile t{};
    if (!plan.locate(wave, rank, t))
      continue;
    if ASCEND_IS_AIC {
      cube.open(x, w, t, Private ? rank : 0);
    }
    if ASCEND_IS_AIV {
      if (Private)
        out.prepare<256>(t.expert, t.col, 1024);
    }
    for (u4 begin = 0; begin < t.height; begin += 64, ++ordinal) {
      u4 rows = smaller(64, t.height - begin), index = ordinal % 2, ready = Private ? ordinal : 9 + 3 * index;
      GM_ADDR slot = Private ? memory + (u8(t.col / 256) * totalRows + t.row + begin) * 256 * 4
                             : memory + (u8(rank) * 2 + index) * 65536;
      if ASCEND_IS_AIC {
        if (!Private && ordinal >= 2)
          crw(10 + 3 * index);
        if (Private && begin)
          cube.second();
        if (Private && begin + 64 >= t.height) {
          Tile next{};
          if (plan.locate(wave + 1, rank, next))
            cube.prefetch(w, next);
        }
        cube.product(slot, rows);
        crs<2, PIPE_FIX>(ready);
      }
      if ASCEND_IS_AIV {
        crw(ready);
        Tile part = t;
        part.row += begin;
        part.height = rows;
        if (Private)
          out.emit<256, true>(shape, part, slot, 256);
        else {
          out.emit<256>(shape, part, slot, 256);
          crs<2, PIPE_MTE3>(10 + 3 * index);
        }
      }
    }
    if ASCEND_IS_AIC {
      cube.close();
    }
  }
  if ASCEND_IS_AIC {
    if (!Private && ordinal)
      crw(10);
    if (!Private && ordinal > 1)
      crw(13);
  }
  if ASCEND_IS_AIV {
    out.drain();
  }
}
bool runPair(GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR g, GM_ADDR y, u4 experts, u4 rows, u4 requested,
             aclrtStream stream) {
  u4 cores = contest41::physical(requested);
  if (!cores || experts > 8)
    return false;
  u8 l1 = 0;
  auto *p = platform_ascendc::PlatformAscendCManager::GetInstance();
  p->GetCoreMemSize(platform_ascendc::CoreMemType::L1, l1);
  u4 pairs = ((rows + 127) / 128) * 4, singles = ((rows + 63) / 64) * 4;
  u4 upper = ((rows + 127) / 128 + experts - 1) * 4;
  if (2 * ((pairs + cores - 1) / cores) > (singles + cores - 1) / cores || l1 < 393216 ||
      !contest41::resources(393216, 2 * 64 * 128, 2 * 256 * 128, 2 * 64 * 256 * 4, 8192 * 18 + 2048))
    return false;
  bool priv = 2 * ((upper + cores - 1) / cores) <= 16 && l1 >= 458752;
  void *memory = contest41::workspace(priv ? u8(rows) * 1024 * 4 : u8(cores) * 2 * 65536);
  if (priv)
    PairedRows<1, true><<<cores, nullptr, stream>>>(x, w, s, g, y, (u1 *)memory, cores, experts, rows);
  else
    PairedRows<1, false><<<cores, nullptr, stream>>>(x, w, s, g, y, (u1 *)memory, cores, experts, rows);
  contest41::release(memory, stream);
  return true;
}
} // namespace contest42
#undef CONTEST42_ENTRY

#undef r42AI
#undef u4
#undef u8
#undef i4
#undef i8
#undef i1
#undef u2
#undef u1
#undef ps
#undef gt
#undef lt
#undef pb
#undef crw
#undef crs
#undef he
#undef sf
#undef wf
#undef dc
#undef tq
#undef dcp

// A single-expert row wave for complete 128-channel operands.
namespace contest45 {
using namespace AscendC;

// A complete B matrix precedes the padded A tile in L1. Both operands have
// one lifetime, so this route needs no operand queues or buffer recycling.
class FixedProduct {
  LocalTensor<int8_t> weights_, tokens_, left_, right_;
  LocalTensor<int32_t> sums_;

public:
  __aicore__ __attribute__((always_inline)) inline FixedProduct()
      : weights_(TPosition::B1, 0, 16384), tokens_(TPosition::A1, 16384, 2048), left_(TPosition::A2, 0, 2048),
        right_(TPosition::B2, 0, 16384), sums_(TPosition::CO1, 0, 2048) {}

  __aicore__ __attribute__((always_inline)) inline void import(GM_ADDR x, GM_ADDR w, uint32_t row, uint32_t rows) {
    GlobalTensor<int8_t> gm;
    gm.SetGlobalBuffer((__gm__ int8_t *)w);
    DataCopy(weights_, gm, Nd2NzParams(1, 128, 128, 0, 128, 128, 1, 0));
    if (rows != 16) {
      InitConstValue(tokens_.ReinterpretCast<uint32_t>(), InitConstValueParams<uint32_t>{1, 64, 0, 0});
      PipeBarrier<PIPE_MTE2>();
    }
    GlobalTensor<int8_t> input;
    input.SetGlobalBuffer((__gm__ int8_t *)x + row * 128);
    DataCopy(tokens_, input, Nd2NzParams(1, uint16_t(rows), 128, 0, 128, 16, 1, 0));
  }

  __aicore__ __attribute__((always_inline)) inline void materialize() {
    SetFlag<HardEvent::MTE2_MTE1>(EVENT_ID1);
    WaitFlag<HardEvent::MTE2_MTE1>(EVENT_ID1);
    LoadData2dTransposeParams transpose{0, 4, 4, 1, 0, inc};
    for (uint32_t quarter = 0; quarter != 4; ++quarter)
      LoadDataWithTranspose(right_[quarter * 4096], weights_[quarter * 1024], transpose);
    uint8_t border[4] = {};
    Load3DSetFMatrixCal(1, 16, border);
    LoadData3DParamsV2Pro read;
    read.channelSize = 128;
    read.extConfig = (uint64_t(16) << 16) | 128;
    LoadData(left_, tokens_, read);
  }

  __aicore__ __attribute__((always_inline)) inline void publish(GM_ADDR slot, uint32_t rows) {
    SetFlag<HardEvent::MTE1_M>(EVENT_ID2);
    WaitFlag<HardEvent::MTE1_M>(EVENT_ID2);
    MmadParams product;
    product.m = 16;
    product.k = 128;
    product.n = 128;
    product.cmatrixInitVal = true;
    product.isBias = false;
    Mmad(sums_, left_, right_, product);
    SetFlag<HardEvent::M_FIX>(EVENT_ID3);
    WaitFlag<HardEvent::M_FIX>(EVENT_ID3);
    GlobalTensor<int32_t> target;
    target.SetGlobalBuffer((__gm__ int32_t *)slot);
    FixpipeParamsV220 store;
    store.mSize = rows;
    store.srcStride = 16;
    store.nSize = 128;
    store.dstStride = 128;
    store.reluEn = false;
    store.quantPre = QuantMode_t::NoQuant;
    Fixpipe<int32_t, int32_t, CFG_ROW_MAJOR>(target, sums_, store);
  }
};

template <uint32_t Revision, bool CompleteRows = false>
__global__ __mix__(1, 2)
    __attribute__((section(".gmg_ht1_rx"), aligned(256))) void RowWave(GM_ADDR x, GM_ADDR weights, GM_ADDR scales,
                                                                       GM_ADDR y, GM_ADDR scratch, uint32_t height,
                                                                       uint32_t m) {
  uint32_t task = contest41::coreId(), start = task * height,
           rows = CompleteRows ? height : contest41::smaller(height, m - start);
  GM_ADDR partial = scratch + task * 8192;
  if ASCEND_IS_AIV {
    TPipe pipe;
    contest41::FloatOutput<1024> output;
    output.setup(pipe, scales, y);
    output.prepare<128>(0, 0, 128);
    CrossCoreWaitFlag(7);
    contest41::Geometry shape{m, 128, 128, 1, uint32_t(GetBlockNum())};
    contest41::Tile tile{0, start, rows, 0, 128};
    output.emit<128, true>(shape, tile, partial, 128);
    output.drain();
  }
  if ASCEND_IS_AIC {
    FixedProduct product;
    product.import(x, weights, start, rows);
    product.materialize();
    product.publish(partial, rows);
    CrossCoreSetFlag<2, PIPE_FIX>(7);
  }
}

bool launch(GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR y, uint32_t m, uint32_t requested, aclrtStream stream) {
  if ((reinterpret_cast<uintptr_t>(x) | reinterpret_cast<uintptr_t>(w) | reinterpret_cast<uintptr_t>(s) |
       reinterpret_cast<uintptr_t>(y)) &
      31U)
    return false;
  uint32_t capacity = contest41::physical(requested);
  if (capacity < 4 || m > capacity * 16)
    return false;
  auto *platform = platform_ascendc::PlatformAscendCManager::GetInstance();
  const platform_ascendc::CoreMemType kinds[] = {
      platform_ascendc::CoreMemType::L1, platform_ascendc::CoreMemType::L0_A, platform_ascendc::CoreMemType::L0_B,
      platform_ascendc::CoreMemType::L0_C, platform_ascendc::CoreMemType::UB};
  const uint64_t required[] = {18432, 2048, 16384, 8192, 20480};
  for (uint32_t i = 0; i != 5; ++i) {
    uint64_t bytes = 0;
    platform->GetCoreMemSize(kinds[i], bytes);
    if (bytes < required[i])
      return false;
  }
  uint32_t height = 16, jobs = (m + height - 1) / height;
  void *storage = contest41::workspace(uint64_t(jobs) * 8192);
  if (m % height == 0)
    RowWave<1, true><<<jobs, nullptr, stream>>>(x, w, s, y, (uint8_t *)storage, height, m);
  else
    RowWave<1, false><<<jobs, nullptr, stream>>>(x, w, s, y, (uint8_t *)storage, height, m);
  contest41::release(storage, stream);
  return true;
}
} // namespace contest45

// Keep this optional wide-row implementation after the existing kernel definitions.
namespace reference_backend {
namespace tallExperts {
namespace wideRows {
using namespace AscendC;
using gmg::Min;
using hcBand::CheckedFinish;
constexpr Z0 VectorBytes = hcBand::VectorBytes;
template <Z0 BM, Z0 BK>
__global__ __mix__(1, 2)
#if defined(__DAV_VEC__) || defined(__DAV_C220_VEC__)
    __attribute__((section(".gmg_wide_rows_vector"), aligned(256)))
#else
    __attribute__((section(".gmg_wide_rows_cube"), aligned(256)))
#endif
    void RowBandsKernel(GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR g, GM_ADDR y, GM_ADDR ws, Z2 l1, Z0 setup) {
  edge::Parameters p;
  const auto cfg = reinterpret_cast<const __gm__ Config *>(ws);
  p.m = cfg->m;
  p.n = cfg->n;
  p.k = cfg->k;
  p.e = cfg->e;
  p.workers = cfg->workers;
  const Z0 columns = cfg->columns, strips = (p.n + 31) / 32;
  Z0 worker = GetBlockIdx();
  if ASCEND_IS_AIV {
    worker /= 2;
  }
  const auto ends = reinterpret_cast<const __gm__ Z3 *>(g);
  Z0 active = 0, previous = 0;
  for (Z0 e = 0; e < p.e; ++e) {
    const Z0 stop = ends[e];
    active += stop > previous;
    previous = stop;
  }
  const Z0 total = p.m + active * setup, alignedK = (p.k + 31) / 32 * 32;
  Z0 capacity = cfg->capacity;
  if (p.workers >= columns) {
    const Z0 g = worker % columns;
    const Z0 before = g * (p.workers / columns) + Min(g, p.workers % columns);
    const Z0 lanes = (p.workers + columns - 1 - g) / columns;
    Z0 col = (before * strips + p.workers / 2) / p.workers * 32;
    Z0 right = g + 1 == columns ? p.n : ((before + lanes) * strips + p.workers / 2) / p.workers * 32;
    capacity = (right - col + 31) / 32 * 32;
  }
  const Z0 budget = Z0((l1 - Z2(alignedK) * capacity) / alignedK) / 16 * 16;
  const Z0 storage = Min(BM, Min(budget, 2 * dense::C_BYTES / (4 * capacity) / 16 * 16));
  const bool ahead = Z2(alignedK) * (storage + capacity) + BK * capacity <= l1;
  TPipe pipe;
  hcBand::RotatingBandCube<BM, BK, true> cube;
  CheckedFinish<true> finish;
  if ASCEND_IS_AIC {
    cube.SetPhase(worker, p.k);
    cube.Init(pipe, p.k, capacity, l1, ahead, storage);
  }
  if ASCEND_IS_AIV {
    finish.Init(pipe, s, y);
  }
  Z0 ordinal = 0;
  GM_ADDR slots = ws + 512 + worker * 4ULL * dense::C_BYTES;
  for (Z0 group = worker % columns; group < columns; group += p.workers) {
    Z0 teams = (p.workers + columns - 1 - group) / columns, rank = worker / columns;
    Z0 denom = p.workers, before = group * (p.workers / columns) + Min(group, p.workers % columns);
    if (p.workers < columns) {
      teams = 1;
      denom = columns;
      before = group;
    }
    Z0 col = (before * strips + denom / 2) / denom * 32;
    Z0 right = group + 1 == columns ? p.n : ((before + teams) * strips + denom / 2) / denom * 32;
    RowSlice cursor{ends, p.e, setup, total * rank / teams, total * (rank + 1) / teams, col, right - col};
    gmg::GeneralTask slab, next;
    bool valid = cursor.Next(slab);
    while (valid) {
      bool more = cursor.Next(next);
      const Z0 pitch = (slab.vn + 31) / 32 * 32, stop = slab.row + slab.vm;
      GM_ADDR upcoming = nullptr;
      if ASCEND_IS_AIC {
        GlobalTensor<Z7> weights;
        weights.SetGlobalBuffer(reinterpret_cast<__gm__ Z7 *>(w) + Z2(slab.expert) * p.k * p.n + slab.col);
        cube.BeginB(p, slab, weights, alignedK);
        if (more && ahead)
          upcoming = w + Z2(next.expert) * p.k * p.n + next.col;
      }
      for (Z0 row = slab.row; row < stop; row += storage, ++ordinal) {
        auto t = slab;
        t.row = row;
        t.vm = Min(storage, stop - row);
        const Z0 idx = ordinal % 2;
        GM_ADDR slot = slots + idx * 2 * dense::C_BYTES;
        if ASCEND_IS_AIC {
          GlobalTensor<Z7> a;
          GlobalTensor<Z1> c;
          a.SetGlobalBuffer(reinterpret_cast<__gm__ Z7 *>(x) + Z2(row) * p.k);
          c.SetGlobalBuffer(reinterpret_cast<__gm__ Z1 *>(slot));
          cube.template Run<true>(p, t, a, c, alignedK, pitch, row == slab.row ? upcoming : nullptr, &next,
                                  ordinal >= 2 ? int(idx) : -1);
          CrossCoreSetFlag<2, PIPE_FIX>(dense::READY + idx * 3);
        }
        if ASCEND_IS_AIV {
          CrossCoreWaitFlag(dense::READY + idx * 3);
          Z0 step = 2 * (dense::PE / ((t.vn + 15) / 16 * 16));
          for (Z0 off = 0; off < t.vm; off += step) {
            auto part = t;
            part.row += off;
            part.vm = Min(step, t.vm - off);
            finish.Run<448, 448>(p, part, slot + Z2(off) * pitch * 4, pitch,
                                 off + step >= t.vm ? int(dense::FREE + idx * 3) : -1,
                                 off + step < t.vm ? Min(step, t.vm - off - step) : 0, step);
          }
        }
      }
      if ASCEND_IS_AIC {
        cube.EndB();
      }
      valid = more;
      if (more)
        slab = next;
    }
  }
  if ASCEND_IS_AIV {
    finish.Drain();
  }
  if ASCEND_IS_AIC {
    if (ordinal)
      CrossCoreWaitFlag(dense::FREE);
    if (ordinal > 1)
      CrossCoreWaitFlag(dense::FREE + 3);
  }
}
__attribute__((noinline)) static bool TryLaunch(GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR g, GM_ADDR y, Z0 m, Z0 n, Z0 k,
                                                Z0 e, Z0 workers, Z2 l1, Z2 la, Z2 lb, Z2 lc, Z2 ub,
                                                aclrtStream stream) {
  constexpr Z0 BM = 80, BK = 64, Target = 384;
  const Z0 columns = (n + Target - 1) / Target, strips = (n + 31) / 32;
  if (!workers || !columns || workers < columns || lc < 2 * dense::C_BYTES || ub < VectorBytes)
    return false;
  const Z2 paddedK = (k + 31) / 32 * 32;
  Z0 capacity = 0;
  for (Z0 j = 0; j < columns; ++j) {
    const Z0 before = j * (workers / columns) + std::min(j, workers % columns);
    const Z0 teams = (workers + columns - 1 - j) / columns;
    const Z0 left = (before * strips + workers / 2) / workers * 32;
    const Z0 right = j + 1 == columns ? n : ((before + teams) * strips + workers / 2) / workers * 32;
    if (left >= right || right > n)
      return false;
    const Z0 width = (right - left + 31) / 32 * 32;
    if (width > 448 || paddedK * width >= l1)
      return false;
    const Z0 budget = Z0((l1 - paddedK * width) / paddedK) / 16 * 16;
    const Z0 rows = std::min(BM, std::min(budget, 2 * dense::C_BYTES / (4 * width) / 16 * 16));
    const Z0 depth = width <= 256 ? 128 : 64;
    if (rows < 16 || 2 * rows * depth > la || 2 * width * depth > lb)
      return false;
    capacity = std::max(capacity, width);
  }
  Config p{m, n, k, e, workers, columns, capacity};
  void *workspace = nullptr;
  const Z2 bytes = 512 + 4ULL * workers * dense::C_BYTES;
  if (aclrtMalloc(&workspace, bytes, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS)
    return false;
  if (aclrtMemcpy(workspace, bytes, &p, sizeof(p), ACL_MEMCPY_HOST_TO_DEVICE) != ACL_SUCCESS) {
    aclrtFree(workspace);
    return false;
  }
  const Z0 setup = ((k + 9) / 10 + 15) / 16 * 16;
  RowBandsKernel<BM, BK><<<workers, nullptr, stream>>>(x, w, s, g, y, (GM_ADDR)workspace, l1, setup);
  const auto status = aclrtSynchronizeStream(stream);
  const auto freed = aclrtFree(workspace);
  if (status != ACL_SUCCESS || freed != ACL_SUCCESS)
    throw std::runtime_error("wide-row execution failed");
  return true;
}

} // namespace wideRows
}
}

// Confirmed small-E, short-K extension; original paths outside its envelope.
namespace extension49 {
using namespace AscendC;
using U = uint32_t;
using W = uint64_t;
using I = int32_t;
using B = int8_t;
using E = int64_t;
namespace old = reference_backend;
struct Layout {
  U experts, rows, depth, columns, workers, step, stripe, bundle;
};
class Work {
  const __gm__ E *ends_;
  Layout p_;
  U expert_ = 0, begin_ = 0, ordinal_, stripes_;
  LocalTensor<E> cache_;
  bool cached_ = false;
public:
  __aicore__ inline Work(GM_ADDR groups, Layout p, U rank)
      : ends_(reinterpret_cast<const __gm__ E *>(groups)), p_(p), ordinal_(rank),
        stripes_((p.columns + p.stripe - 1) / p.stripe) {}
  __aicore__ inline void cache(LocalTensor<E> entries) { cache_=entries; cached_=true; }
  __aicore__ inline bool next(contest41::Tile &t) {
    while (expert_ != p_.experts) {
      const U end = cached_ ? U(cache_.GetValue(expert_)) : U(ends_[expert_]);
      const U bundles = (end - begin_ + p_.bundle - 1) / p_.bundle;
      const U tasks = bundles * stripes_;
      if (ordinal_ < tasks) {
        t.expert = expert_;
        t.row = begin_ + (ordinal_ / stripes_) * p_.bundle;
        t.col = (ordinal_ % stripes_) * p_.stripe;
        t.height = contest41::smaller(p_.bundle, end - t.row);
        t.width = contest41::smaller(p_.stripe, p_.columns - t.col);
        ordinal_ += p_.workers;
        return true;
      }
      ordinal_ -= tasks;
      begin_ = end;
      ++expert_;
    }
    return false;
  }
};
#if defined(__DAV_VEC__) || defined(__DAV_C220_VEC__)
#define EXTRA49_ENTRY __attribute__((section(".gmg50_vector"), aligned(256)))
#else
#define EXTRA49_ENTRY __attribute__((section(".gmg50_cube"), aligned(256)))
#endif
template <U Tag>
__global__ __mix__(1, 2) EXTRA49_ENTRY void ResidentProduct(
    GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR groups, GM_ADDR y, GM_ADDR scratch, Layout p) {
  constexpr U width = 256;
  constexpr U height = 64;
  constexpr W bytes = W(height) * width * sizeof(I);
  U rank = GetBlockIdx();
  if ASCEND_IS_AIV { rank /= 2; }
  TPipe pipe;
  old::edge::Parameters shape{};
  shape.e = p.experts; shape.m = p.rows; shape.n = p.columns;
  shape.k = p.depth; shape.workers = p.workers;
  old::hcBand::RotatingBandCube<64,64,false> resident;
  contest41::FloatOutput<8192> output;
  if ASCEND_IS_AIC {
    {
      resident.SetPhase(0, p.depth);
      resident.Init(pipe, p.depth, p.stripe, 0, false, p.step);
    }
  }
  if ASCEND_IS_AIV { output.setup(pipe, s, y); }
  Work work(groups, p, rank);
  contest41::Tile bundle{};
  contest41::Geometry geometry{p.rows,p.columns,p.depth,p.experts,p.workers};
  U issued = 0;
  while (work.next(bundle)) {
    GlobalTensor<B> weights;
    if ASCEND_IS_AIC {
      weights.SetGlobalBuffer(reinterpret_cast<__gm__ B *>(w) +
                              W(bundle.expert)*p.depth*p.columns + bundle.col);
      {
        old::gmg::GeneralTask t{bundle.expert,bundle.row,bundle.col,
                                bundle.height,bundle.width};
        resident.BeginB(shape,t,weights,(p.depth+31)/32*32);
      }
    }
    for (U offset = 0; offset < bundle.height; offset += p.step) {
      contest41::Tile tile = bundle;
      tile.row += offset;
      tile.height = contest41::smaller(p.step,bundle.height-offset);
      U slot = issued & 1;
      GM_ADDR address = scratch + (W(rank)*2+slot)*bytes;
      if ASCEND_IS_AIC {
        if (issued >= 2) CrossCoreWaitFlag(6+slot);
        GlobalTensor<B> inputs;
        GlobalTensor<I> result;
        inputs.SetGlobalBuffer(reinterpret_cast<__gm__ B *>(x)+W(tile.row)*p.depth);
        result.SetGlobalBuffer(reinterpret_cast<__gm__ I *>(address));
        old::gmg::GeneralTask t{tile.expert,tile.row,tile.col,tile.height,tile.width};
          resident.Run<true>(shape,t,inputs,result,(p.depth+31)/32*32,p.stripe);
        CrossCoreSetFlag<2,PIPE_FIX>(4+slot);
      }
      if ASCEND_IS_AIV {
        CrossCoreWaitFlag(4+slot);
        U pitch=p.stripe;
        {
          if (tile.width<=64) output.template emit<64>(geometry,tile,address,pitch);
          else if (tile.width<=128) output.template emit<128>(geometry,tile,address,pitch);
          else output.template emit<256>(geometry,tile,address,pitch);
        }
        CrossCoreSetFlag<2,PIPE_MTE3>(6+slot);
      }
      ++issued;
    }
    if ASCEND_IS_AIC {
      resident.EndB();
    }
  }
  if ASCEND_IS_AIV { output.drain(); }
  if ASCEND_IS_AIC {
    for (U slot = 0; slot < contest41::smaller(issued,2); ++slot) CrossCoreWaitFlag(6+slot);
  }
}
template <U Tag>
__global__ __aicore__ EXTRA49_ENTRY void Shallow(
    GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR groups, GM_ADDR y, Layout p) {
  KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
  constexpr U span = Tag ? 512 : 256, panel = 16 * span;
  constexpr U xByte = 2 * span, intByte = xByte + 64;
  constexpr U wByte = intByte + 4 * span, scaleByte = wByte + 8 * span;
  constexpr U sumByte = scaleByte + 4 * span, aByte = sumByte + panel * 4;
  constexpr U bByte = aByte + panel * 4, outByte = bByte + panel * 4;
  constexpr U endsByte = outByte + panel * 2;
  TPipe pipe;
  TBuf<TPosition::VECCALC> memory;
  pipe.InitBuffer(memory, Tag ? 131072 : 65536);
  auto raw = memory.Get<B>();
  auto xv = memory.Get<B>()[xByte];
  auto integers = memory.Get<half>()[intByte / 2];
  auto weights = memory.Get<float>()[wByte / 4];
  auto scale = memory.Get<float>()[scaleByte / 4];
  auto sum = memory.Get<float>()[sumByte / 4];
  auto a = memory.Get<float>()[aByte / 4];
  auto b = memory.Get<float>()[bByte / 4];
  auto out = memory.Get<half>()[outByte / 2];
  GlobalTensor<B> gx,gw;
  GlobalTensor<float> gs;
  GlobalTensor<half> gy;
  gx.SetGlobalBuffer(reinterpret_cast<__gm__ B *>(x));
  gw.SetGlobalBuffer(reinterpret_cast<__gm__ B *>(w));
  gs.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(s));
  gy.SetGlobalBuffer(reinterpret_cast<__gm__ half *>(y));
  GlobalTensor<E> globalEnds;
  globalEnds.SetGlobalBuffer(reinterpret_cast<__gm__ E *>(groups));
  auto localEnds=memory.Get<E>()[endsByte / 8];
  DataCopyPad(localEnds,globalEnds,DataCopyExtParams{1,p.experts*8,0,0,0},
              DataCopyPadExtParams<E>{false,0,0,0});
  contest41::fence<HardEvent::MTE2_S>();
  Work work(groups,p,GetBlockIdx());
  work.cache(localEnds);
  contest41::Tile tile{};
  U cachedExpert = ~U(0), cachedColumn = ~U(0);
  while (work.next(tile)) {
    const bool reload = tile.expert != cachedExpert || tile.col != cachedColumn;
    if (reload) {
      for (U d=0; d<p.depth; ++d)
        DataCopyPad(raw[d*span],gw[(W(tile.expert)*p.depth+d)*p.columns+tile.col],
                    DataCopyExtParams{1,tile.width,0,0,0},DataCopyPadExtParams<B>{false,0,0,0});
      DataCopyPad(scale,gs[W(tile.expert)*p.columns+tile.col],
                  DataCopyExtParams{1,tile.width*4,0,0,0},DataCopyPadExtParams<float>{false,0,0,0});
      cachedExpert = tile.expert; cachedColumn = tile.col;
    }
    DataCopyPad(xv,gx[W(tile.row)*p.depth],DataCopyExtParams{1,tile.height*p.depth,0,0,0},
                DataCopyPadExtParams<B>{false,0,0,0});
    contest41::fence<HardEvent::MTE2_S>();
    contest41::fence<HardEvent::MTE2_V>();
    if (reload) {
      Cast(integers,raw,RoundMode::CAST_NONE,p.depth*span); PipeBarrier<PIPE_V>();
      Cast(weights,integers,RoundMode::CAST_NONE,p.depth*span); PipeBarrier<PIPE_V>();
    }
    for (U r=0;r<tile.height;++r)
      Muls(sum[r*span],weights,float(I(xv.GetValue(r*p.depth))),span);
    U count=tile.height*span;
    if (p.depth==2) {
      for (U r=0;r<tile.height;++r)
        Muls(a[r*span],weights[span],float(I(xv.GetValue(r*p.depth+1))),span);
      PipeBarrier<PIPE_V>();
      Add(sum,sum,a,count);
    }
    PipeBarrier<PIPE_V>();
    for (U c=0;c<span;c+=64)
      Mul(sum[c],sum[c],scale[c],uint64_t(64),uint8_t(tile.height),BinaryRepeatParams{1,1,1,uint8_t(span/8),uint8_t(span/8),0});
    PipeBarrier<PIPE_V>();
    Mul(a,sum,sum,count); PipeBarrier<PIPE_V>();
    Muls(a,a,-0.07135481627260025f,count); PipeBarrier<PIPE_V>();
    Adds(a,a,-1.5957691216057308f,count); PipeBarrier<PIPE_V>();
    Mul(a,a,sum,count); PipeBarrier<PIPE_V>();
    Mins(a,a,64.0f,count); PipeBarrier<PIPE_V>();
    Exp(b,a,count); PipeBarrier<PIPE_V>();
    Adds(a,b,1.0f,count); PipeBarrier<PIPE_V>();
    Div(b,sum,a,count); PipeBarrier<PIPE_V>();
    Cast(out,b,RoundMode::CAST_RINT,count);
    contest41::fence<HardEvent::V_MTE3>();
    DataCopyPad(gy[W(tile.row)*p.columns+tile.col],out,
                DataCopyExtParams{uint16_t(tile.height),tile.width*2,
                  (span-(tile.width+15)/16*16)/16,(p.columns-tile.width)*2,0});
    contest41::fence<HardEvent::MTE3_MTE2>();
    contest41::fence<HardEvent::MTE3_V>();
  }
}
bool launch(GM_ADDR x,GM_ADDR w,GM_ADDR s,GM_ADDR g,GM_ADDR y,
            U e,U m,U k,U n,U requested,aclrtStream stream) {
  if(e>8 || m<=1024 || k>512 || !requested) return false;
  auto *platform=platform_ascendc::PlatformAscendCManager::GetInstance();
  if(!platform) return false;
  W l1=0,a=0,b=0,c=0,ub=0;
  using M=platform_ascendc::CoreMemType;
  platform->GetCoreMemSize(M::L1,l1);platform->GetCoreMemSize(M::L0_A,a);
  platform->GetCoreMemSize(M::L0_B,b);platform->GetCoreMemSize(M::L0_C,c);
  platform->GetCoreMemSize(M::UB,ub);
  Layout p{e,m,k,n,0,64,256,64};
  if(k<=2 && n>=128 && ub>=65536){
    const bool wide = n>256 && ub>=131072;
    p.stripe = wide ? 512 : 256;
    const U stripes = (n+p.stripe-1)/p.stripe;
    p.workers=std::min<U>(2*requested,platform->GetCoreNumAiv());
    p.workers=std::min<U>(p.workers,((m+15)/16+e-1)*stripes);
    if(p.workers>=stripes)p.workers=p.workers/stripes*stripes;
    p.step=p.bundle=16;
    if(!p.workers)return false;
    if(wide)Shallow<1><<<p.workers,nullptr,stream>>>(x,w,s,g,y,p);
    else Shallow<0><<<p.workers,nullptr,stream>>>(x,w,s,g,y,p);
    return true;
  }
  p.workers=std::min<U>(requested,std::min<U>(platform->GetCoreNumAic(),platform->GetCoreNumAiv()/2));
  if(!p.workers || ub<8192*18+2048 || c<131072)return false;
  const U aligned=(k+31)/32*32;bool fit=false;
  for(U stripe=256;stripe>=32;stripe/=2){
    if((stripe>32 && n<=stripe/2)||(stripe<128 && n>stripe))continue;
    U budget=U(l1/aligned);if(budget<=stripe)continue;
    U rows=std::min<U>(64,(budget-stripe)/16*16);
    if(rows<16 || 2ULL*stripe*128>b || 2ULL*rows*128>a)continue;
    p.step=rows;p.stripe=stripe;fit=true;break;
  }
  if(!fit)return false;
  U stripes=(n+p.stripe-1)/p.stripe;
  if(m>=W(p.workers)*p.step*4 && (m+p.step*4-1)/(p.step*4)*stripes>=2*p.workers)p.bundle=4*p.step;
  else p.bundle=p.step;
  W upper=std::min<W>(m,(m+p.bundle-1)/p.bundle+e-1)*stripes;
  p.workers=std::min<W>(p.workers,upper);
  void *memory=nullptr;
  if(aclrtMalloc(&memory,W(p.workers)*2*64*256*4,ACL_MEM_MALLOC_HUGE_FIRST)!=ACL_SUCCESS)return false;
  ResidentProduct<0><<<p.workers,nullptr,stream>>>(x,w,s,g,y,static_cast<uint8_t*>(memory),p);
  auto done=aclrtSynchronizeStream(stream);auto freed=aclrtFree(memory);
  if(done!=ACL_SUCCESS || freed!=ACL_SUCCESS)throw std::runtime_error("case20 execution");
  return true;
}
#undef EXTRA49_ENTRY
} // namespace extension49

namespace persistent_rows {
using namespace AscendC;
using U = uint32_t;
using W = uint64_t;
struct Plan { U e, m, k, n, workers, height; };
#if defined(__DAV_VEC__) || defined(__DAV_C220_VEC__)
#define PERSISTENT_ROWS_ENTRY __attribute__((section(".gmg_persistent_rows_vector"), aligned(256)))
#else
#define PERSISTENT_ROWS_ENTRY __attribute__((section(".gmg_persistent_rows_cube"), aligned(256)))
#endif
template <U BM, U BN>
__global__ __mix__(1, 2) PERSISTENT_ROWS_ENTRY
void Product(GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR groups, GM_ADDR y, GM_ADDR scratch, Plan p) {
namespace ref = reference_backend;
U rank = GetBlockIdx();
if ASCEND_IS_AIV { rank /= 2; }
const U bands = (p.n + BN - 1) / BN, column = rank % bands;
const U teams = (p.workers + bands - 1 - column) / bands, lane = rank / bands;
const U col = column * BN, width = ref::gmg::Min(BN, p.n - col), aligned = (p.k + 31) / 32 * 32;
const auto ends = reinterpret_cast<const __gm__ int64_t *>(groups);
U active = 0, previous = 0;
for (U e = 0; e < p.e; ++e) { U end = U(ends[e]); active += end > previous; previous = end; }
const U total = p.m + active * BN;
ref::tallExperts::RowSlice cursor{ends, p.e, BN, total * lane / teams, total * (lane + 1) / teams, col, width};
ref::edge::Parameters shape{};
shape.m = p.m; shape.n = p.n; shape.k = p.k; shape.e = p.e; shape.workers = p.workers;
contest41::Geometry geometry{p.m, p.n, p.k, p.e, p.workers};
constexpr U vectorWidth = BN < 64 ? 64 : BN;
constexpr U capacity = BM * vectorWidth / 2 < 8192 ? BM * vectorWidth / 2 : 8192;
constexpr U vectorRows = 2 * capacity / vectorWidth;
constexpr W tileBytes = W(BM) * BN * sizeof(int32_t);
TPipe pipe;
ref::hcBand::RotatingBandCube<BM, 64, false> cube;
contest41::FloatOutput<capacity> finish;
if ASCEND_IS_AIC { cube.Init(pipe, p.k, BN, 0, false, p.height); }
if ASCEND_IS_AIV { finish.setup(pipe, s, y); }
U issued = 0;
ref::gmg::GeneralTask slab;
while (cursor.Next(slab)) {
if ASCEND_IS_AIC {
GlobalTensor<int8_t> weights;
weights.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t *>(w) + W(slab.expert) * p.k * p.n + col);
cube.BeginB(shape, slab, weights, aligned);
}
const U stop = slab.row + slab.vm;
for (U row = slab.row; row < stop; row += p.height, ++issued) {
const U bank = issued & 1, rows = ref::gmg::Min(p.height, stop - row);
GM_ADDR slot = scratch + (W(rank) * 2 + bank) * tileBytes;
if ASCEND_IS_AIC {
GlobalTensor<int8_t> input;
GlobalTensor<int32_t> result;
input.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t *>(x) + W(row) * p.k);
result.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t *>(slot));
ref::gmg::GeneralTask task{slab.expert, row, col, rows, width};
cube.template Run<true>(shape, task, input, result, aligned, BN, nullptr, nullptr, issued >= 2 ? int(bank) : -1);
CrossCoreSetFlag<2, PIPE_FIX>(ref::dense::READY + bank * 3);
}
if ASCEND_IS_AIV {
CrossCoreWaitFlag(ref::dense::READY + bank * 3);
for (U off = 0; off < rows; off += vectorRows) {
contest41::Tile task{slab.expert, row + off, ref::gmg::Min(vectorRows, rows - off), col, width};
finish.template emit<vectorWidth>(geometry, task, slot + W(off) * BN * 4, BN);
}
CrossCoreSetFlag<2, PIPE_MTE3>(ref::dense::FREE + bank * 3);
}
}
if ASCEND_IS_AIC { cube.EndB(); }
}
if ASCEND_IS_AIV { finish.drain(); }
if ASCEND_IS_AIC {
if (issued) CrossCoreWaitFlag(ref::dense::FREE);
if (issued > 1) CrossCoreWaitFlag(ref::dense::FREE + 3);
}
}
template <U BM, U BN>
__attribute__((always_inline)) inline bool Attempt(GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR g, GM_ADDR y,
Plan p, W l1, W la, W lb, W lc, W ub, aclrtStream stream) {
constexpr U vectorWidth = BN < 64 ? 64 : BN;
constexpr U capacity = BM * vectorWidth / 2 < 8192 ? BM * vectorWidth / 2 : 8192;
const U aligned = (p.k + 31) / 32 * 32, bands = (p.n + BN - 1) / BN;
const U depth = BN <= 256 ? 128 : 64;
if (p.workers < bands || l1 <= W(aligned) * (BN + 16) || lc < 131072 || ub < capacity * 18 + 2048)
return false;
const U budget = U((l1 - 256) / aligned);
p.height = std::min<U>(BM, (budget - BN) / 16 * 16);
if (p.height < 16 || 2ULL * p.height * depth > la || 2ULL * BN * depth > lb) return false;
void *memory = nullptr;
if (aclrtMalloc(&memory, W(p.workers) * 2 * BM * BN * 4, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) return false;
Product<BM, BN><<<p.workers, nullptr, stream>>>(x, w, s, g, y, (GM_ADDR)memory, p);
auto done = aclrtSynchronizeStream(stream), freed = aclrtFree(memory);
if (done != ACL_SUCCESS || freed != ACL_SUCCESS) throw std::runtime_error("resident row execution");
return true;
}
__attribute__((noinline)) bool Launch(GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR g, GM_ADDR y,
U e, U m, U k, U n, U requested, aclrtStream stream) {
const bool narrow = k > 1024 && n <= 256 && m >= e * 256;
const bool shallow = k >= 3 && k <= 512;
if (!requested || !e || e > 8 || m <= 1024 || (!narrow && !shallow)) return false;
auto platform = platform_ascendc::PlatformAscendCManager::GetInstance();
if (!platform) return false;
Plan p{e, m, k, n, std::min<U>(requested, std::min<U>(platform->GetCoreNumAic(), platform->GetCoreNumAiv() / 2)), 0};
if (!p.workers) return false;
W l1 = 0, la = 0, lb = 0, lc = 0, ub = 0;
using Mem = platform_ascendc::CoreMemType;
platform->GetCoreMemSize(Mem::L1, l1); platform->GetCoreMemSize(Mem::L0_A, la);
platform->GetCoreMemSize(Mem::L0_B, lb); platform->GetCoreMemSize(Mem::L0_C, lc); platform->GetCoreMemSize(Mem::UB, ub);
if (narrow) {
if (n > 32 && Attempt<128, 64>(x,w,s,g,y,p,l1,la,lb,lc,ub,stream)) return true;
return Attempt<128, 32>(x,w,s,g,y,p,l1,la,lb,lc,ub,stream);
}
if (n > 256 && Attempt<64, 512>(x,w,s,g,y,p,l1,la,lb,lc,ub,stream)) return true;
if (n > 128) return Attempt<128, 256>(x,w,s,g,y,p,l1,la,lb,lc,ub,stream);
if (n > 64) return Attempt<128, 128>(x,w,s,g,y,p,l1,la,lb,lc,ub,stream);
return Attempt<128, 64>(x,w,s,g,y,p,l1,la,lb,lc,ub,stream);
}
#undef PERSISTENT_ROWS_ENTRY
}

namespace thin_reduce {
using namespace AscendC;
using U = uint32_t;
using Q = uint64_t;
namespace ref = reference_backend;
constexpr U Height = 64, Width = 16, Chunk = 512;
class DotProduct {
TQue<TPosition::B1, 1> staging_;
TQue<TPosition::B2, 1> retained_;
LocalTensor<int8_t> weights_;
TQue<TPosition::A1, 1> tokens_;
TQue<TPosition::A2, 2> left_;
TQue<TPosition::CO1, 1> sums_;
U padded_;
public:
__aicore__ inline void init(TPipe &pipe, U k) {
padded_ = (k + 31) / 32 * 32;
pipe.InitBuffer(staging_, 1, padded_ * Width);
pipe.InitBuffer(retained_, 1, padded_ * Width);
pipe.InitBuffer(tokens_, 1, padded_ * Height);
pipe.InitBuffer(left_, 2, Chunk * Height);
pipe.InitBuffer(sums_, 1, Height * Width * 4);
}
__aicore__ inline void loadWeights(GlobalTensor<int8_t> src, U k) {
auto packed = staging_.AllocTensor<int8_t>();
InitConstValue(packed.ReinterpretCast<U>(), InitConstValueParams<U>(1, padded_ * Width / 32, 0, 0));
PipeBarrier<PIPE_MTE2>();
DataCopy(packed, src, Nd2NzParams(1, 1, k, 0, k, Width, 1, 0));
staging_.EnQue(packed); packed = staging_.DeQue<int8_t>();
LoadData2dParams load{};
load.repeatTimes = padded_ / 32; load.srcStride = 1; load.ifTranspose = false;
auto operand = retained_.AllocTensor<int8_t>();
LoadData(operand, packed, load);
staging_.FreeTensor(packed);
retained_.EnQue(operand); weights_ = retained_.DeQue<int8_t>();
}
__aicore__ inline void release() { retained_.FreeTensor(weights_); }
__aicore__ inline void run(GlobalTensor<int8_t> src, GlobalTensor<int32_t> dst, U rows, U k, int slot) {
const U rounded = (rows + 15) / 16 * 16;
uint8_t pad[4] = {};
Load3DSetFMatrixCal(1, Height, pad);
auto accum = sums_.AllocTensor<int32_t>();
auto local = tokens_.AllocTensor<int8_t>();
DataCopy(local, src, Nd2NzParams(1, rows, k, 0, k, Height, 1, 0));
tokens_.EnQue(local); local = tokens_.DeQue<int8_t>();
for (U offset = 0; offset < padded_; offset += Chunk) {
const U depth = ref::gmg::Min(Chunk, padded_ - offset);
auto panel = left_.AllocTensor<int8_t>();
LoadData3DParamsV2Pro load;
load.channelSize = padded_;
load.extConfig = (Q(offset) << 32) | (Q(rounded) << 16) | depth;
LoadData(panel, local, load);
left_.EnQue(panel); panel = left_.DeQue<int8_t>();
MmadParams mm;
mm.m = rounded; mm.n = Width; mm.k = depth;
mm.isBias = false; mm.cmatrixInitVal = offset == 0;
Mmad(accum, panel, weights_[offset * Width], mm);
left_.FreeTensor(panel);
if (offset + depth < padded_) PipeBarrier<PIPE_M>();
}
tokens_.FreeTensor(local);
sums_.EnQue(accum); accum = sums_.DeQue<int32_t>();
if (slot >= 0) CrossCoreWaitFlag(ref::dense::FREE + slot * 3);
FixpipeParamsV220 fix;
fix.mSize = rows; fix.nSize = Width; fix.srcStride = rounded; fix.dstStride = Width;
fix.quantPre = QuantMode_t::NoQuant; fix.reluEn = false;
Fixpipe<int32_t, int32_t, CFG_ROW_MAJOR>(dst, accum, fix);
sums_.FreeTensor(accum);
}
};
class CompactOutput {
static constexpr U Count = Height / 2, Words = Count * Width;
TBuf<TPosition::VECCALC> memory_;
GlobalTensor<float> scale_;
GlobalTensor<half> output_;
float multiplier_;
public:
__aicore__ inline void init(TPipe &pipe, GM_ADDR s, GM_ADDR y) {
pipe.InitBuffer(memory_, (Words + 7 * Count) * 4);
scale_.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(s));
output_.SetGlobalBuffer(reinterpret_cast<__gm__ half *>(y));
auto index = memory_.Get<U>()[Words];
for (U row = 0; row < Count; ++row) index.SetValue(row, row * Width * 4);
ref::gmg::Fence<HardEvent::S_V>();
}
__aicore__ inline void select(U expert) {
auto local = memory_.Get<float>()[Words + 6 * Count];
DataCopyPad(local, scale_[expert], DataCopyExtParams{1, 4, 0, 0, 0},
DataCopyPadExtParams<float>{false, 0, 0, 0});
ref::gmg::Fence<HardEvent::MTE2_S>();
multiplier_ = local.GetValue(0);
}
__aicore__ inline void emit(GM_ADDR src, U row, U rows) {
const U halfRows = (rows + 1) / 2, begin = GetSubBlockIdx() * halfRows;
if (begin >= rows) return;
const U count = ref::gmg::Min(halfRows, rows - begin);
GlobalTensor<int32_t> partial;
partial.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t *>(src) + begin * Width);
auto raw = memory_.Get<int32_t>();
auto index = memory_.Get<U>()[Words];
auto dense = memory_.Get<int32_t>()[Words + Count];
auto z = memory_.Get<float>()[Words + 2 * Count];
auto u = memory_.Get<float>()[Words + 3 * Count];
auto t = memory_.Get<float>()[Words + 4 * Count];
auto result = memory_.Get<half>()[2 * (Words + 5 * Count)];
DataCopy(raw, partial, count * Width);
ref::gmg::Fence<HardEvent::MTE2_V>();
Gather(dense, raw, index, 0, count); PipeBarrier<PIPE_V>();
Cast(z, dense, RoundMode::CAST_RINT, count); PipeBarrier<PIPE_V>();
Muls(z, z, multiplier_, count); PipeBarrier<PIPE_V>();
Mul(u, z, z, count); PipeBarrier<PIPE_V>();
Muls(u, u, -0.07135481627260025f, count); PipeBarrier<PIPE_V>();
Adds(u, u, -1.5957691216057308f, count); PipeBarrier<PIPE_V>();
Mul(u, u, z, count); PipeBarrier<PIPE_V>();
Mins(u, u, 64.0f, count); PipeBarrier<PIPE_V>();
Exp(t, u, count); PipeBarrier<PIPE_V>();
Adds(u, t, 1.0f, count); PipeBarrier<PIPE_V>();
Div(t, z, u, count); PipeBarrier<PIPE_V>();
Cast(result, t, RoundMode::CAST_RINT, count);
ref::gmg::Fence<HardEvent::V_MTE3>();
DataCopyPad(output_[row + begin], result, DataCopyExtParams{1, count * 2, 0, 0, 0});
ref::gmg::Fence<HardEvent::MTE3_V>();
ref::gmg::Fence<HardEvent::V_MTE2>();
}
};
__global__ __mix__(1, 2)
#if defined(__DAV_VEC__) || defined(__DAV_C220_VEC__)
__attribute__((section(".thin_reduce_vector"), aligned(256)))
#else
__attribute__((section(".thin_reduce_cube"), aligned(256)))
#endif
void Execute(GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR g, GM_ADDR y, GM_ADDR scratch,
U m, U k, U experts, U workers) {
U rank = GetBlockIdx();
if ASCEND_IS_AIV { rank /= 2; }
const U tiles = (m + Height - 1) / Height;
U row = Q(tiles) * rank / workers * Height;
const U limit = ref::gmg::Min(m, U(Q(tiles) * (rank + 1) / workers * Height));
if (row >= limit) return;
TPipe pipe;
DotProduct math;
CompactOutput output;
if ASCEND_IS_AIC { math.init(pipe, k); }
if ASCEND_IS_AIV { output.init(pipe, s, y); }
const auto ends = reinterpret_cast<const __gm__ int64_t *>(g);
U serial = 0;
for (U expert = 0; expert < experts && row < limit; ++expert) {
const U end = ref::gmg::Min(limit, U(ends[expert]));
if (end <= row) continue;
if ASCEND_IS_AIC {
GlobalTensor<int8_t> weights;
weights.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t *>(w) + Q(expert) * k);
math.loadWeights(weights, k);
}
if ASCEND_IS_AIV { output.select(expert); }
while (row < end) {
const U rows = ref::gmg::Min(Height, end - row), bank = serial & 1;
GM_ADDR slot = scratch + (Q(rank) * 2 + bank) * Height * Width * 4;
if ASCEND_IS_AIC {
GlobalTensor<int8_t> input;
GlobalTensor<int32_t> result;
input.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t *>(x) + Q(row) * k);
result.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t *>(slot));
math.run(input, result, rows, k, serial >= 2 ? int(bank) : -1);
CrossCoreSetFlag<2, PIPE_FIX>(ref::dense::READY + bank * 3);
}
if ASCEND_IS_AIV {
CrossCoreWaitFlag(ref::dense::READY + bank * 3);
output.emit(slot, row, rows);
CrossCoreSetFlag<2, PIPE_MTE3>(ref::dense::FREE + bank * 3);
}
row += rows; ++serial;
}
if ASCEND_IS_AIC { math.release(); }
}
if ASCEND_IS_AIC {
if (serial) CrossCoreWaitFlag(ref::dense::FREE);
if (serial > 1) CrossCoreWaitFlag(ref::dense::FREE + 3);
}
}
}
namespace narrow_stream {
using namespace AscendC;
using U = uint32_t;
using Q = uint64_t;
namespace ref = reference_backend;
constexpr U Columns = 32, Reduction = 256;
template<U H> class OperandStream {
TQue<TPosition::A1, 2> input_;
TQue<TPosition::B1, 1> weights_;
TQue<TPosition::CO1, 1> sums_;
TBuf<TPosition::A2> left_;
TBuf<TPosition::B2> right_;
LocalTensor<int8_t> retained_;
U depth_, capacity_, width_;
public:
__aicore__ inline void setup(TPipe &pipe, U k, U columns) {
capacity_ = columns;
depth_ = (k + 31) / 32 * 32;
pipe.InitBuffer(input_, 2, H * depth_);
pipe.InitBuffer(weights_, 1, capacity_ * depth_);
pipe.InitBuffer(sums_, 1, H * capacity_ * 4);
pipe.InitBuffer(left_, 2 * H * Reduction);
pipe.InitBuffer(right_, 2 * capacity_ * Reduction);
}
__aicore__ inline void retain(GlobalTensor<int8_t> source, U k, U n, U width) {
width_ = (width + 31) / 32 * 32;
auto packed = weights_.AllocTensor<int8_t>();
if ((k & 31) || width != width_) {
InitConstValue(packed.ReinterpretCast<U>(), InitConstValueParams<U>(1, depth_ * width_ / 32, 0, 0));
PipeBarrier<PIPE_MTE2>();
}
DataCopy(packed, source, Nd2NzParams(k / 32, 32, width, 32 * n, n, 32, 1, 32 * width_));
if (k & 31)
DataCopy(packed[(k / 32) * 32 * width_], source[(k / 32) * 32 * n],
Nd2NzParams(1, k & 31, width, 0, n, 32, 1, 0));
weights_.EnQue(packed);
retained_ = weights_.DeQue<int8_t>();
}
__aicore__ inline void release() { weights_.FreeTensor(retained_); }
__aicore__ inline void prefetch(GlobalTensor<int8_t> source, U rows, U k) {
auto packed = input_.AllocTensor<int8_t>();
DataCopy(packed, source, Nd2NzParams(1, rows, k, 0, k, H, 1, 0));
input_.EnQue(packed);
}
__aicore__ inline void multiply(GlobalTensor<int8_t> source, GlobalTensor<int32_t> destination,
U rows, U nextRows, U k, bool first, int recycled) {
if (first) prefetch(source, rows, k);
auto lhs = input_.DeQue<int8_t>();
if (nextRows) prefetch(source[Q(rows) * k], nextRows, k);
auto acc = sums_.AllocTensor<int32_t>();
U roundedRows = (rows + 15) / 16 * 16;
uint8_t pad[4] = {};
Load3DSetFMatrixCal(1, H, pad);
for (U offset = 0; offset < depth_; offset += Reduction) {
U bank = (offset / Reduction) & 1, count = ref::gmg::Min(Reduction, depth_ - offset);
event_t ticket = static_cast<event_t>(4 + bank);
if (offset >= 2 * Reduction) WaitFlag<HardEvent::M_MTE1>(ticket);
auto a = left_.Get<int8_t>()[bank * H * Reduction];
auto b = right_.Get<int8_t>()[bank * capacity_ * Reduction];
LoadData3DParamsV2Pro ld;
ld.channelSize = depth_;
ld.extConfig = (Q(offset) << 32) | (Q(roundedRows) << 16) | count;
LoadData(a, lhs, ld);
LoadDataWithTranspose(b, retained_[offset * width_],
LoadData2dTransposeParams{0, static_cast<uint8_t>((count / 32) * (width_ / 32)), 1, 1, 0, inc});
SetFlag<HardEvent::MTE1_M>(ticket);
WaitFlag<HardEvent::MTE1_M>(ticket);
MmadParams mm;
mm.m = roundedRows; mm.n = width_; mm.k = count;
mm.cmatrixInitVal = offset == 0; mm.isBias = false;
Mmad(acc, a, b, mm);
if (offset + count < depth_) PipeBarrier<PIPE_M>();
SetFlag<HardEvent::M_MTE1>(ticket);
}
for (U bank = 0; bank < ref::gmg::Min(2U, (depth_ + Reduction - 1) / Reduction); ++bank)
WaitFlag<HardEvent::M_MTE1>(static_cast<event_t>(4 + bank));
input_.FreeTensor(lhs);
sums_.EnQue(acc); acc = sums_.DeQue<int32_t>();
if (recycled >= 0) CrossCoreWaitFlag(ref::dense::FREE + recycled * 3);
FixpipeParamsV220 store;
store.mSize = rows; store.nSize = width_;
store.srcStride = roundedRows; store.dstStride = capacity_;
store.quantPre = QuantMode_t::NoQuant; store.reluEn = false;
Fixpipe<int32_t, int32_t, CFG_ROW_MAJOR>(destination, acc, store);
sums_.FreeTensor(acc);
}
};
struct Layout { U m, k, n, e, workers, columns, bands; };
template<U H, bool Packed> struct Engine { using Type = ref::longBands::BandCube<H, Reduction>; };
template<U H> struct Engine<H, true> { using Type = OperandStream<H>; };
template<U H, bool Packed> __global__ __mix__(1, 2)
#if defined(__DAV_VEC__) || defined(__DAV_C220_VEC__)
__attribute__((section(".narrow_columns_vector"), aligned(256)))
#else
__attribute__((section(".narrow_columns_cube"), aligned(256)))
#endif
void Compute(GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR g, GM_ADDR y, GM_ADDR ws, Layout p) {
U rank = GetBlockIdx();
if ASCEND_IS_AIV { rank /= 2; }
const U strips = (p.n + 31) / 32, totalWeight = strips + 2 * p.bands;
U band = 0, beginWorker = 0, endWorker = p.workers;
for (; band + 1 < p.bands; ++band) {
const U prefixWeight = (band + 1) * strips / p.bands + 2 * (band + 1);
endWorker = (prefixWeight * p.workers + totalWeight / 2) / totalWeight;
if (rank < endWorker) break;
beginWorker = endWorker;
}
if (band + 1 == p.bands) endWorker = p.workers;
const U lanes = endWorker - beginWorker;
const U col = band * strips / p.bands * 32;
const U edge = ref::gmg::Min(p.n, (band + 1) * strips / p.bands * 32), width = edge - col;
const U tiles = (p.m + H - 1) / H;
U row = Q(tiles) * (rank - beginWorker) / lanes * H;
const U limit = ref::gmg::Min(p.m, U(Q(tiles) * (rank - beginWorker + 1) / lanes * H));
if (row >= limit) return;
TPipe pipe;
typename Engine<H, Packed>::Type math;
ref::residentBands::Finish finish;
if ASCEND_IS_AIC {
if constexpr (Packed) math.setup(pipe, p.k, p.columns);
else math.Init(pipe, p.k, p.columns);
}
if ASCEND_IS_AIV { finish.Init(pipe, s, y); }
ref::edge::Parameters shape{};
shape.m = p.m; shape.k = p.k; shape.n = p.n; shape.e = p.e; shape.workers = p.workers;
const auto ends = reinterpret_cast<const __gm__ int64_t *>(g);
U serial = 0;
for (U expert = 0; expert < p.e && row < limit; ++expert) {
const U end = ref::gmg::Min(limit, U(ends[expert]));
if (end <= row) continue;
ref::gmg::GeneralTask task{expert, row, col, 0, width};
if ASCEND_IS_AIC {
GlobalTensor<int8_t> weights;
weights.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t *>(w) + Q(expert) * p.k * p.n + col);
if constexpr (Packed) math.retain(weights, p.k, p.n, width);
else math.BeginB(shape, task, weights, p.k);
}
bool first = true;
while (row < end) {
const U rows = ref::gmg::Min(H, end - row), bank = serial & 1;
task.row = row; task.vm = rows;
GM_ADDR buffer = ws + (Q(rank) * 2 + bank) * H * p.columns * 4;
if ASCEND_IS_AIC {
GlobalTensor<int8_t> input;
GlobalTensor<int32_t> result;
input.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t *>(x) + Q(row) * p.k);
result.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t *>(buffer));
if constexpr (Packed)
math.multiply(input, result, rows, ref::gmg::Min(H, end - row - rows), p.k, first,
serial >= 2 ? int(bank) : -1);
else
math.template Run<true>(shape, task, input, result, p.k, p.columns, nullptr, nullptr,
serial >= 2 ? int(bank) : -1);
CrossCoreSetFlag<2, PIPE_FIX>(ref::dense::READY + bank * 3);
}
if ASCEND_IS_AIV {
CrossCoreWaitFlag(ref::dense::READY + bank * 3);
if (width <= 64) finish.template Run<64, 64>(shape, task, buffer, p.columns);
else finish.template Run<128, 128>(shape, task, buffer, p.columns);
CrossCoreSetFlag<2, PIPE_MTE3>(ref::dense::FREE + bank * 3);
}
row += rows; ++serial; first = false;
}
if ASCEND_IS_AIC {
if constexpr (Packed) math.release();
else math.EndB();
}
}
if ASCEND_IS_AIV { finish.Drain(); }
if ASCEND_IS_AIC {
if (serial) CrossCoreWaitFlag(ref::dense::FREE);
if (serial > 1) CrossCoreWaitFlag(ref::dense::FREE + 3);
}
}
bool Launch(GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR g, GM_ADDR y,
U e, U m, U k, U n, U requested, aclrtStream stream) {
if (!requested || !e || e > 8 || k <= 1024 || n > 256 || m < e * 256) return false;
auto platform = platform_ascendc::PlatformAscendCManager::GetInstance();
if (!platform) return false;
U workers = std::min<U>(requested, std::min<U>(platform->GetCoreNumAic(), platform->GetCoreNumAiv() / 2));
if (!workers) return false;
Q l1 = 0, la = 0, lb = 0, lc = 0, ub = 0;
using Mem = platform_ascendc::CoreMemType;
platform->GetCoreMemSize(Mem::L1, l1); platform->GetCoreMemSize(Mem::L0_A, la);
platform->GetCoreMemSize(Mem::L0_B, lb); platform->GetCoreMemSize(Mem::L0_C, lc);
platform->GetCoreMemSize(Mem::UB, ub);
const Q padded = (k + 31) / 32 * 32;
if (n == 1 && m >= 512 * std::max(workers, e) && padded / 32 <= 255 &&
padded * 16 <= lb && 2 * 64 * 512 <= la && padded * 80 <= l1 &&
64 * 16 * 4 <= lc && (32 * 16 + 7 * 32) * 4 <= ub) {
void *storage = nullptr;
if (aclrtMalloc(&storage, Q(workers) * 2 * 64 * 16 * 4, ACL_MEM_MALLOC_HUGE_FIRST) == ACL_SUCCESS) {
thin_reduce::Execute<<<workers, nullptr, stream>>>(x,w,s,g,y,(GM_ADDR)storage,m,k,e,workers);
auto status = aclrtSynchronizeStream(stream), freed = aclrtFree(storage);
if (status != ACL_SUCCESS || freed != ACL_SUCCESS) throw std::runtime_error("thin reduction");
return true;
}
}
const bool packed = n <= 32 || n > 96;
if (n == 1 && (k & 31)) return false;
U rows = 32, columns = (n + 31) / 32 * 32;
if (n <= 96) {
const U copies = packed ? 2 : 1;
if (padded * (copies * 32 + columns) > l1 || 2 * 32 * Reduction > la ||
2 * columns * Reduction > lb || 2 * ref::dense::C_BYTES > lc || ref::dense::PANEL_BYTES > ub)
return false;
if (padded * (copies * 64 + columns) <= l1 && 2 * 64 * Reduction <= la && m >= workers * 64)
rows = 64;
} else {
const Q limit = l1 / padded;
if (limit < 96 || la < 2 * 32 * Reduction || lb < 2 * 32 * Reduction ||
lc < 2 * ref::dense::C_BYTES || ub < ref::dense::PANEL_BYTES) return false;
rows = limit >= 192 && la >= 2 * 64 * Reduction ? 64 : 32;
columns = U(std::min<Q>(128, std::min<Q>(lb / (2 * Reduction), limit - 2 * rows))) / 32 * 32;
if (!columns) return false;
columns = std::min<U>((n + 31) / 32 * 32, columns);
}
Layout p{m,k,n,e,workers,columns,(n + columns - 1) / columns};
if (m < workers * rows || p.bands > workers) return false;
void *storage = nullptr;
if (aclrtMalloc(&storage, Q(workers) * 2 * rows * columns * 4, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS)
return false;
if (packed) {
if (rows == 64) Compute<64,true><<<workers,nullptr,stream>>>(x,w,s,g,y,(GM_ADDR)storage,p);
else Compute<32,true><<<workers,nullptr,stream>>>(x,w,s,g,y,(GM_ADDR)storage,p);
} else {
if (rows == 64) Compute<64,false><<<workers,nullptr,stream>>>(x,w,s,g,y,(GM_ADDR)storage,p);
else Compute<32,false><<<workers,nullptr,stream>>>(x,w,s,g,y,(GM_ADDR)storage,p);
}
auto status = aclrtSynchronizeStream(stream), freed = aclrtFree(storage);
if (status != ACL_SUCCESS || freed != ACL_SUCCESS) throw std::runtime_error("column reduction");
return true;
}
}
