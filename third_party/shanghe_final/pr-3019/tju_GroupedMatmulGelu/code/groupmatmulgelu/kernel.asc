namespace suffixBand {
using namespace AscendC;
using gmg::Min;
using gmg::Fence;
constexpr Z0 BaseRows = dense::BM, BM = BaseRows + 16, BN = dense::BN, BK = dense::BK, MAX_K = 512;
constexpr Z0 C_BYTES = BM * BN * 4;
constexpr Z4 READY = 9, FREE = 10;
struct Parameters {
  Z0 m, n, k, e, workers, descriptorBytes;
};
constexpr Z0 ActiveBytes = ((dense::PE / 256 + 255) / 256) * 256;
constexpr Z0 VectorStride = dense::SP;
constexpr Z0 OutputOffset = VectorStride * 20 + 32 + BN * 4 + 2 * dense::MASK_BYTES + ActiveBytes;
constexpr Z0 VectorBytes = OutputOffset + dense::PE * sizeof(half);
constexpr Z0 ScalarScratchBytes = 8 * 1024;
__aicore__ inline Z2 FractionProduct(Z2 a, Z2 b) {
  constexpr Z2 mask = (1ULL << 22) - 1;
  Z2 ah = a >> 22, al = a & mask, bh = b >> 22, bl = b & mask;
  Z2 cross = ah * bl + al * bh + ((al * bl) >> 22);
  return ah * bh + ((cross + (1ULL << 21)) >> 22);
}
__aicore__ inline Z2 ScaledExp(Z2 x, Z0 &exponent) {
  constexpr Z2 one = 1ULL << 44, ln2 = 12193974156573ULL;
  Z2 cube = FractionProduct(FractionProduct(x, x), x);
  constexpr Z2 cubicQ44 = 786634598976ULL;
  constexpr Z2 logisticQ44 = 28073067271222ULL;
  Z2 a = FractionProduct(x + FractionProduct(cubicQ44, cube), logisticQ44);
  exponent = static_cast<Z0>(a / ln2);
  const Z2 r = a - exponent * ln2;
  Z2 norm = 202ULL;
  norm = 2825ULL - FractionProduct(r, norm);
  norm = 36727ULL - FractionProduct(r, norm);
  norm = 440721ULL - FractionProduct(r, norm);
  norm = 4847935ULL - FractionProduct(r, norm);
  norm = 48479349ULL - FractionProduct(r, norm);
  norm = 436314138ULL - FractionProduct(r, norm);
  norm = 3490513104ULL - FractionProduct(r, norm);
  norm = 24433591728ULL - FractionProduct(r, norm);
  norm = 146601550370ULL - FractionProduct(r, norm);
  norm = 733007751851ULL - FractionProduct(r, norm);
  norm = 2932031007403ULL - FractionProduct(r, norm);
  norm = 8796093022208ULL - FractionProduct(r, norm);
  norm = one - FractionProduct(r, norm);
  norm = one - FractionProduct(r, norm);
  return norm;
}
__aicore__ inline Z2 ToQ44(Z8 x) {
  return static_cast<Z2>(static_cast<Z1>(x * 16777216.0f)) << 20;
}
__aicore__ inline Z8 NegativeSubnormal(Z8 z) {
  constexpr Z2 one = 1ULL << 44;
  Z2 x = ToQ44(-z);
  Z0 exponent;
  Z2 norm = ScaledExp(x, exponent);
  if (exponent >= 50)
    return -0.0f;
  Z2 num = FractionProduct(x, norm);
  num = exponent <= 24 ? num << (24 - exponent) : num >> (exponent - 24);
  Z2 den = one + (norm >> exponent), units = num / den;
  Z2 twice = 2 * (num - units * den);
  units += twice > den || (twice == den && (units & 1));
  return -static_cast<Z8>(static_cast<Z1>(units)) * 0.000000059604644775390625f;
}
__aicore__ inline Z8 PositiveMidpoint(Z8 z, Z0 estimateBits) {
  Z0 lower = estimateBits & ~0x1fffU;
  union FloatBits {
    Z0 bits;
    Z8 number;
  };
  FloatBits mid;
  mid.bits = lower + 0x1000U;
  Z2 x = ToQ44(z), boundary = ToQ44(mid.number);
  Z0 exponent;
  Z2 norm = ScaledExp(x, exponent);
  if (exponent >= 53)
    return z;
  bool above = false;
  if (x > boundary) {
    Z2 distance = x - boundary;
    Z2 rhs = FractionProduct(boundary, norm);
    above = distance > (rhs >> exponent);
    if (distance == (rhs >> exponent) && (rhs & ((1ULL << exponent) - 1)) == 0)
      above = ((lower >> 13) & 1) != 0;
  }
  mid.bits = above ? mid.bits + 1 : mid.bits - 1;
  return mid.number;
}
template <Z0 PE, Z0 COLS>
__aicore__ inline void Gelu(LocalTensor<Z1> ci, LocalTensor<Z8> scale, TBuf<TPosition::VECCALC> &vectors_, Z0 count,
                            bool pendingStore) {
  constexpr Z0 MASK_BYTES = (PE / 8 + 255) / 256 * 256;
  constexpr Z0 SP = VectorStride;
  auto u = vectors_.Get<Z8>();
  auto z = vectors_.Get<Z8>()[SP];
  auto t = vectors_.Get<Z8>()[2 * SP];
  auto result = t;
  auto den = vectors_.Get<Z8>()[3 * SP];
  auto mask = vectors_.Get<Z6>()[SP * 20 + 32 + COLS * 4];
  auto out = vectors_.Get<half>()[OutputOffset / 2];
  Cast(z, ci, RoundMode::CAST_RINT, count);
  PipeBarrier<PIPE_V>();
  for (Z0 col = 0; col < COLS; col += 64)
    Mul(z[col], z[col], scale[col], 64, static_cast<Z6>(count / COLS),
        BinaryRepeatParams(1, 1, 1, COLS / 8, COLS / 8, 0));
  PipeBarrier<PIPE_V>();
  SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
  Mul(u, z, z, count);
  PipeBarrier<PIPE_V>();
  Duplicate(t, -1.5957691216057308f, count);
  PipeBarrier<PIPE_V>();
  Axpy(t, u, -0.071354816275f, count);
  PipeBarrier<PIPE_V>();
  Mul(u, t, z, count);
  PipeBarrier<PIPE_V>();
  Mins(u, u, 64.0f, count);
  PipeBarrier<PIPE_V>();
  Exp(t, u, count);
  PipeBarrier<PIPE_V>();
  Adds(den, t, 1.0f, count);
  PipeBarrier<PIPE_V>();
  Div(result, z, den, count);
  PipeBarrier<PIPE_V>();
  Duplicate(u, 0.0f, count);
  PipeBarrier<PIPE_V>();
  CompareScalar(mask, z, 2.0f, CMPMODE::GE, count);
  PipeBarrier<PIPE_V>();
  Select(den, mask, result, u, SELMODE::VSEL_TENSOR_TENSOR_MODE, count);
  PipeBarrier<PIPE_V>();
  Mins(den, den, 8.0f, count);
  PipeBarrier<PIPE_V>();
  Duplicate(u.ReinterpretCast<Z1>(), Z1(8191), count);
  PipeBarrier<PIPE_V>();
  And(den.ReinterpretCast<Z4>(), den.ReinterpretCast<Z4>(), u.ReinterpretCast<Z4>(), 2 * count);
  PipeBarrier<PIPE_V>();
  Cast(u, den.ReinterpretCast<Z1>(), RoundMode::CAST_RINT, count);
  PipeBarrier<PIPE_V>();
  Adds(u, u, -4096.0f, count);
  PipeBarrier<PIPE_V>();
  Abs(u, u, count);
  PipeBarrier<PIPE_V>();
  CompareScalar(mask, u, 4.0f, CMPMODE::LE, count);
  PipeBarrier<PIPE_V>();
  auto positive = vectors_.Get<Z6>()[SP * 20 + 32 + COLS * 4 + MASK_BYTES];
  CompareScalar(positive, z, 8.0f, CMPMODE::GE, count);
  PipeBarrier<PIPE_V>();
  Select(result, positive, z, result, SELMODE::VSEL_TENSOR_TENSOR_MODE, count);
  PipeBarrier<PIPE_V>();
  const Z0 words = count / 32, roundedWords = (words + 63) / 64 * 64;
  Duplicate(u, 0.0f, roundedWords);
  PipeBarrier<PIPE_V>();
  Cast(u, mask.ReinterpretCast<Z1>(), RoundMode::CAST_RINT, words);
  PipeBarrier<PIPE_V>();
  auto active = vectors_.Get<Z6>()[SP * 20 + 32 + COLS * 4 + 2 * MASK_BYTES];
  CompareScalar(active, u, 0.0f, CMPMODE::NE, roundedWords);
  Fence<HardEvent::V_S>();
  {
    for (Z0 page = 0; page < (words + 31) / 32; ++page) {
      Z0 pages = active.ReinterpretCast<Z0>().GetValue(page);
      while (pages) {
        const Z0 block = page * 32 + __builtin_ctz(pages);
        Z0 hits = mask.ReinterpretCast<Z0>().GetValue(block);
        while (hits) {
          const Z0 index = block * 32 + __builtin_ctz(hits);
          Z8 value = z.GetValue(index);
          if (value >= 1.0f && value < 8.0f) {
            result.SetValue(index, PositiveMidpoint(value, result.ReinterpretCast<Z0>().GetValue(index)));
          }
          hits &= hits - 1;
        }
        pages &= pages - 1;
      }
    }
  }
  Fence<HardEvent::S_V>();
  if (pendingStore)
    WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
  Cast(out, result, RoundMode::CAST_RINT, count);
  Fence<HardEvent::V_MTE3>();
}
class CheckedFinish {
  TBuf<TPosition::VECCALC> panel_;
  GlobalTensor<Z8> scales_;
  GlobalTensor<half> output_;
  bool pendingInput_ = false, pendingStore_ = false;

public:
  __aicore__ inline void Init(TPipe &pipe, GM_ADDR scale, GM_ADDR y, Z0 extra = 0) {
    pipe.InitBuffer(panel_, VectorBytes + extra);
    scales_.SetGlobalBuffer(reinterpret_cast<__gm__ Z8 *>(scale));
    output_.SetGlobalBuffer(reinterpret_cast<__gm__ half *>(y));
  }
  template <Z0 VC, Z0 storageWidth, class Parameters>
  __aicore__ inline void Run(const Parameters &p, const gmg::GeneralTask &task, GM_ADDR slot, Z0 pitch = dense::BN) {
    const Z0 halfRows = (task.vm + 1) / 2;
    const Z0 first = GetSubBlockIdx() * halfRows;
    if (first >= task.vm)
      return;
    const Z0 rows = gmg::Min(halfRows, task.vm - first);
    const Z0 width = task.vn;
    if (pendingInput_) {
      WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
      pendingInput_ = false;
    }
    auto ci = panel_.Get<Z1>()[4 * VectorStride + 8];
    auto scale = panel_.Get<Z8>()[5 * VectorStride + 8];
    auto out = panel_.Get<half>()[OutputOffset / 2];
    GlobalTensor<Z1> c;
    c.SetGlobalBuffer(reinterpret_cast<__gm__ Z1 *>(slot));
    if (width != VC) {
      Duplicate(ci, static_cast<Z1>(0), rows * VC);
      Duplicate(scale, 0.0f, VC);
      Fence<HardEvent::V_MTE2>();
    }
    DataCopyExtParams cp{static_cast<Z4>(rows), width * 4, (pitch - width) * 4, (VC - ((width + 7) / 8) * 8) / 8, 0};
    DataCopyPadExtParams<Z1> ip{true, 0, static_cast<Z6>((8 - width % 8) % 8), 0};
    DataCopyPad(ci, c[first * pitch], cp, ip);
    DataCopyExtParams sp{1, width * 4, 0, 0, 0};
    DataCopyPadExtParams<Z8> fp{true, 0, static_cast<Z6>((8 - width % 8) % 8), 0};
    DataCopyPad(scale, scales_[static_cast<Z2>(task.expert) * p.n + task.col], sp, fp);
    Fence<HardEvent::MTE2_V>();
    Gelu<dense::PE, VC>(ci, scale, panel_, rows * VC, pendingStore_);
    pendingInput_ = true;
    DataCopyExtParams yp{static_cast<Z4>(rows), width * 2, (VC - ((width + 15) / 16) * 16) / 16, (p.n - width) * 2, 0};
    DataCopyPad(output_[static_cast<Z2>(task.row + first) * p.n + task.col], out, yp);
    SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
    pendingStore_ = true;
  }
  __aicore__ inline void Drain() {
    if (pendingInput_)
      WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
    if (pendingStore_)
      WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
  }
};
class Cube {
  TQue<TPosition::A1, 2> a1_;
  TQue<TPosition::B1, 2> b1_;
  TQue<TPosition::A2, 2> a2_;
  TQue<TPosition::B2, 2> b2_;
  TQue<TPosition::CO1, 1> c1_;
  LocalTensor<Z7> bFull_;

public:
  __aicore__ inline void Init(TPipe &pipe) {
    pipe.InitBuffer(a1_, 2, BM * MAX_K);
    pipe.InitBuffer(b1_, 2, MAX_K * BN);
    pipe.InitBuffer(a2_, 2, BM * BK);
    pipe.InitBuffer(b2_, 2, BK * BN);
    pipe.InitBuffer(c1_, 1, C_BYTES);
  }
  __aicore__ inline void Load(GlobalTensor<Z7> &a, GlobalTensor<Z7> &b, Z0 vm, Z0 pitch, Z0 k) {
    const Z0 pitchM = vm <= BaseRows ? BaseRows : BM;
    auto first = a1_.AllocTensor<Z7>();
    if (vm % 16) {
      const Z0 pad = 16 - vm % 16;
      InitConstValue(first[vm * 32].template ReinterpretCast<Z0>(),
                     InitConstValueParams<Z0>(k / 32, pad, pitchM - pad, 0));
      PipeBarrier<PIPE_MTE2>();
    }
    DataCopy(first, a, Nd2NzParams(1, static_cast<Z4>(vm), static_cast<Z4>(k), 0, static_cast<Z4>(k), pitchM, 1, 0));
    a1_.EnQue(first);
    auto panel = b1_.AllocTensor<Z7>();
    DataCopy(panel, b, Nd2NzParams(1, static_cast<Z4>(k), BN, 0, static_cast<Z4>(pitch), static_cast<Z4>(k), 1, 0));
    b1_.EnQue(panel);
  }
  __aicore__ inline void Begin(Z0 vm) {
    const Z0 pitchM = vm <= BaseRows ? BaseRows : BM;
    bFull_ = b1_.DeQue<Z7>();
    Z6 padding[4] = {0, 0, 0, 0};
    Load3DSetFMatrixCal(1, pitchM, padding);
  }
  __aicore__ inline void Part(GlobalTensor<Z1> &c, Z0 vm, Z0 k, Z0 ordinal) {
    auto a1 = a1_.DeQue<Z7>();
    auto c1 = c1_.AllocTensor<Z1>();
    const Z0 mAligned = (vm + 15) / 16 * 16;
    for (Z0 k0 = 0; k0 < k; k0 += BK) {
      auto a2 = a2_.AllocTensor<Z7>();
      auto b2 = b2_.AllocTensor<Z7>();
      LoadData3DParamsV2Pro ap;
      ap.channelSize = k;
      ap.extConfig = (static_cast<Z2>(k0) << 32) | (static_cast<Z2>(mAligned) << 16) | BK;
      LoadData(a2, a1, ap);
      LoadData2dTransposeParams bp{0, static_cast<Z6>(BN / 32), static_cast<Z4>(k / 32), 1, 0, inc};
      for (Z0 kb = 0; kb < BK / 32; ++kb)
        LoadDataWithTranspose(b2[kb * BN * 32], bFull_[k0 * 32 + kb * 1024], bp);
      a2_.EnQue(a2);
      b2_.EnQue(b2);
      auto ar = a2_.DeQue<Z7>();
      auto br = b2_.DeQue<Z7>();
      MmadParams mp;
      mp.m = static_cast<Z4>(mAligned);
      mp.n = BN;
      mp.k = BK;
      mp.isBias = false;
      mp.cmatrixInitVal = (k0 == 0);
      Mmad(c1, ar, br, mp);
      a2_.FreeTensor(ar);
      b2_.FreeTensor(br);
    }
    c1_.EnQue(c1);
    auto cr = c1_.DeQue<Z1>();
    FixpipeParamsV220 fp;
    fp.nSize = BN;
    fp.mSize = static_cast<Z4>(vm);
    fp.srcStride = static_cast<Z4>(mAligned);
    fp.dstStride = BN;
    fp.quantPre = QuantMode_t::NoQuant;
    fp.reluEn = false;
    if (ordinal >= 2)
      CrossCoreWaitFlag(FREE + (ordinal % 2) * 3);
    Fixpipe<Z1, Z1, CFG_ROW_MAJOR>(c, cr, fp);
    c1_.FreeTensor(cr);
    a1_.FreeTensor(a1);
  }
  __aicore__ inline void End() {
    b1_.FreeTensor(bFull_);
  }
};
__aicore__ inline void Preload(Cube &cube, GM_ADDR x, GM_ADDR weight, GM_ADDR descriptor, const Parameters &p,
                               Z0 ordinal) {
  const auto job = reinterpret_cast<__gm__ Z0 *>(descriptor) + 8 + 4 * ordinal;
  GlobalTensor<Z7> a, b;
  a.SetGlobalBuffer(reinterpret_cast<__gm__ Z7 *>(x) + Z2(job[1]) * p.k);
  b.SetGlobalBuffer(reinterpret_cast<__gm__ Z7 *>(weight) + (Z2(job[0]) * p.k) * p.n + job[2]);
  cube.Load(a, b, job[3], p.n, p.k);
}
__global__ __mix__(1, 2) void Kernel(GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groups, GM_ADDR y,
                                     GM_ADDR workspace) {
  Parameters p;
  auto dst = reinterpret_cast<Z0 *>(&p);
  auto src = reinterpret_cast<__gm__ Z0 *>(workspace);
  for (Z0 i = 0; i < sizeof(Parameters) / 4; ++i)
    dst[i] = src[i];
  Z0 worker = GetBlockIdx();
  if ASCEND_IS_AIV {
    worker /= 2;
  }
  const Z0 columns = p.n / BN;
  TPipe pipe;
  Cube cube;
  CheckedFinish finish;
  TBuf<TPosition::VECCALC> groupBuffer, taskBuffer;
  GM_ADDR slots = workspace + (sizeof(Parameters) + 511) / 512 * 512 + worker * 2ULL * C_BYTES;
  GM_ADDR descriptor =
      workspace + (sizeof(Parameters) + 511) / 512 * 512 + p.workers * 2ULL * C_BYTES + worker * p.descriptorBytes;
  Z0 owned = 0;
  if ASCEND_IS_AIC {
    cube.Init(pipe);
    CrossCoreWaitFlag(gmg::INPUT_READY);
    owned = *reinterpret_cast<__gm__ Z0 *>(descriptor);
  }
  if ASCEND_IS_AIV {
    pipe.InitBuffer(groupBuffer, 1024);
    pipe.InitBuffer(taskBuffer, p.descriptorBytes);
    auto ends = groupBuffer.Get<Z3>();
    auto tasks = taskBuffer.Get<Z0>();
    GlobalTensor<Z3> groupGm;
    groupGm.SetGlobalBuffer(reinterpret_cast<__gm__ Z3 *>(groups));
    DataCopyExtParams gc{1, p.e * 8, 0, 0, 0};
    DataCopyPadExtParams<Z3> gp{false, 0, 0, 0};
    DataCopyPad(ends, groupGm, gc, gp);
    Fence<HardEvent::MTE2_S>();
    Z0 start = 0, prefix = 0, nextTask = worker;
    for (Z0 expert = 0; expert < p.e; ++expert) {
      const Z0 end = static_cast<Z0>(ends.GetValue(expert));
      const Z0 length = end - start, tail = length % BaseRows;
      const bool join = length > BaseRows && tail > 0 && tail <= BM - BaseRows;
      const Z0 tiles = (length + BaseRows - 1) / BaseRows - join;
      const Z0 count = tiles * columns;
      for (; nextTask < prefix + count; nextTask += p.workers) {
        const Z0 local = nextTask - prefix;
        const Z0 tile = local / columns, row = start + tile * BaseRows;
        const Z0 valid = tile + 1 == tiles ? end - row : BaseRows;
        const Z0 at = 8 + 4 * owned++;
        tasks.SetValue(at, expert);
        tasks.SetValue(at + 1, row);
        tasks.SetValue(at + 2, local % columns * BN);
        tasks.SetValue(at + 3, valid);
      }
      prefix += count;
      start = end;
    }
    tasks.SetValue(0, owned);
    Fence<HardEvent::S_MTE3>();
    if (GetSubBlockIdx() == 0) {
      GlobalTensor<Z0> plan;
      plan.SetGlobalBuffer(reinterpret_cast<__gm__ Z0 *>(descriptor));
      DataCopy(plan, tasks, 8 + ((4 * owned + 7) / 8) * 8);
    }
    CrossCoreSetFlag<2, PIPE_MTE3>(gmg::INPUT_READY);
    finish.Init(pipe, scale, y);
  }
  if ASCEND_IS_AIC {
    if (owned)
      Preload(cube, x, weight, descriptor, p, 0);
  }
  for (Z0 ordinal = 0; ordinal < owned; ++ordinal) {
    Z0 expert, row, col, vm;
    if ASCEND_IS_AIC {
      const auto task = reinterpret_cast<__gm__ Z0 *>(descriptor) + 8 + 4 * ordinal;
      expert = task[0];
      row = task[1];
      col = task[2];
      vm = task[3];
    }
    if ASCEND_IS_AIV {
      auto task = taskBuffer.Get<Z0>();
      const Z0 at = 8 + 4 * ordinal;
      expert = task.GetValue(at);
      row = task.GetValue(at + 1);
      col = task.GetValue(at + 2);
      vm = task.GetValue(at + 3);
    }
    const Z0 index = ordinal % 2;
    GM_ADDR slot = slots + index * C_BYTES;
    if ASCEND_IS_AIC {
      cube.Begin(vm);
      if (ordinal + 1 < owned)
        Preload(cube, x, weight, descriptor, p, ordinal + 1);
      GlobalTensor<Z1> c;
      c.SetGlobalBuffer(reinterpret_cast<__gm__ Z1 *>(slot));
      cube.Part(c, vm, p.k, ordinal);
      cube.End();
      CrossCoreSetFlag<2, PIPE_FIX>(READY + index * 3);
    }
    if ASCEND_IS_AIV {
      CrossCoreWaitFlag(READY + index * 3);
      for (Z0 offset = 0; offset < vm; offset += BaseRows) {
        gmg::GeneralTask t{};
        t.expert = expert;
        t.row = row + offset;
        t.col = col;
        t.vm = Min(BaseRows, vm - offset);
        t.vn = BN;
        finish.template Run<BN, BN>(p, t, slot + offset * BN * 4, BN);
      }
      CrossCoreSetFlag<2, PIPE_MTE3>(FREE + index * 3);
    }
  }
  if ASCEND_IS_AIV {
    finish.Drain();
  }
  if ASCEND_IS_AIC {
    if (owned)
      CrossCoreWaitFlag(FREE);
    if (owned > 1)
      CrossCoreWaitFlag(FREE + 3);
  }
}
} // namespace suffixBand
namespace tallExperts {
static bool Launch(GM_ADDR, GM_ADDR, GM_ADDR, GM_ADDR, GM_ADDR, Z3, Z3, Z3, Z3, Z3, aclrtStream);
}
static void RunReference(GM_ADDR x, const TensorGroupInfo &info_x, GM_ADDR weight, const TensorGroupInfo &info_weight,
                         GM_ADDR scale, const TensorGroupInfo &info_scale, GM_ADDR group_list,
                         const TensorGroupInfo &info_group_list, GM_ADDR y, const TensorGroupInfo &info_y,
                         Z3 availableCoreNum, aclrtStream stream) {
  const auto xs = info_x.tensors[0].shape, ws = info_weight.tensors[0].shape;
  const Z3 m = xs[0], k = xs[1], e = ws[0], n = ws[2];
  if (microDot::Launch(x, weight, scale, group_list, y, e, m, k, n, availableCoreNum, stream))
    return;
  if (smallWave::Launch(x, weight, scale, y, e, m, n, k, availableCoreNum, stream))
    return;
  if (k == 1 && m >= 1025 && m <= 8192 && n >= 385 && n <= 1024 && e >= 1 && e <= 128 && availableCoreNum > 0) {
    auto plat = platform_ascendc::PlatformAscendCManager::GetInstance();
    if (plat) {
      Z2 ub = 0;
      plat->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ub);
      const Z0 workers = std::min<Z2>(availableCoreNum, plat->GetCoreNumAiv());
      if (workers && ub >= outer1::PANEL + outer1::EXTRA) {
        outer1::Kernel<<<workers, nullptr, stream>>>(x, weight, scale, group_list, y, m, n, e, workers);
        return;
      }
    }
  }
  if (k == 2 && m >= 1025 && m <= 4096 && n >= 385 && n <= 1024 && e >= 1 && e <= 128 && availableCoreNum > 0) {
    auto plat = platform_ascendc::PlatformAscendCManager::GetInstance();
    if (plat) {
      Z2 ub = 0;
      plat->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ub);
      const Z0 workers = std::min<Z2>(availableCoreNum, plat->GetCoreNumAiv());
      if (workers && ub >= shortdot::PANEL + shortdot::EXTRA) {
        shortdot::Kernel<2><<<workers, nullptr, stream>>>(x, weight, scale, group_list, y, m, n, e, workers);
        return;
      }
    }
  }
  if (tallExperts::Launch(x, weight, scale, group_list, y, m, n, k, e, availableCoreNum, stream))
    return;
  const Z2 rowBound = (m + dense::BM - 1) / dense::BM + e - 1;
  if (k < dense::BK || k % 32 || n < dense::BN || n % dense::BN || m < dense::BM ||
      (2ULL * m < rowBound * dense::BM && (k < 256 || n < 512)) || (reinterpret_cast<uintptr_t>(x) & 31U) ||
      (reinterpret_cast<uintptr_t>(weight) & 31U)) {
    RunFallback(x, info_x, weight, info_weight, scale, info_scale, group_list, info_group_list, y, info_y,
                availableCoreNum, stream);
    return;
  }
  auto platform = platform_ascendc::PlatformAscendCManager::GetInstance();
  if (!platform)
    return;
  const Z0 workers = std::min<Z2>(availableCoreNum, std::min(platform->GetCoreNumAic(), platform->GetCoreNumAiv() / 2));
  if (!workers)
    return;
  if (static_cast<Z2>((m + dense::BM - 1) / dense::BM) * (n / dense::BN) < 2ULL * workers) {
    RunFallback(x, info_x, weight, info_weight, scale, info_scale, group_list, info_group_list, y, info_y,
                availableCoreNum, stream);
    return;
  }
  Z2 l1 = 0, l0a = 0, l0b = 0, l0c = 0, ub = 0;
  platform->GetCoreMemSize(platform_ascendc::CoreMemType::L1, l1);
  platform->GetCoreMemSize(platform_ascendc::CoreMemType::L0_A, l0a);
  platform->GetCoreMemSize(platform_ascendc::CoreMemType::L0_B, l0b);
  platform->GetCoreMemSize(platform_ascendc::CoreMemType::L0_C, l0c);
  platform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ub);
  if (l0a < dense::BM * dense::BK || l0b < dense::BK * dense::BN || l0c < dense::C_BYTES || ub < dense::PANEL_BYTES) {
    RunFallback(x, info_x, weight, info_weight, scale, info_scale, group_list, info_group_list, y, info_y,
                availableCoreNum, stream);
    return;
  }
  const Z2 upperTasks = rowBound * (n / shortk::BN);
  const Z2 descriptorBytes = (32 + 16 * ((upperTasks + workers - 1) / workers) + 255) / 256 * 256;
  if (k <= shortk::MAX_K && k % shortk::BK == 0 && n >= 3 * dense::BN && (n / dense::BN) % 2 && e > 1 &&
      e * 8 <= 1024 && m >= e * (dense::BM / 2) && m <= e * dense::BM &&
      l1 >= 2 * (suffixBand::BM + suffixBand::BN) * suffixBand::MAX_K && l0a >= 2 * suffixBand::BM * suffixBand::BK &&
      l0b >= 2 * suffixBand::BN * suffixBand::BK && l0c >= suffixBand::C_BYTES &&
      ub >= suffixBand::VectorBytes + 1024 + descriptorBytes + suffixBand::ScalarScratchBytes) {
    suffixBand::Parameters p{static_cast<Z0>(m),
                             static_cast<Z0>(n),
                             static_cast<Z0>(k),
                             static_cast<Z0>(e),
                             workers,
                             static_cast<Z0>(descriptorBytes)};
    const Z2 bytes = (sizeof(p) + 511) / 512 * 512 + 2ULL * workers * suffixBand::C_BYTES + workers * descriptorBytes;
    host_workspace::Parameters workspace;

    if (workspace.Prepare(bytes, p)) {
      suffixBand::Kernel<<<workers, nullptr, stream>>>(x, weight, scale, group_list, y, workspace.Data());
      workspace.Retire(stream);
      return;
    }
  }
  if (k <= shortk::MAX_K && k % shortk::BK == 0 && dense::PANEL_BYTES + 1024 + descriptorBytes <= ub &&
      l1 >= shortk::BM * shortk::MAX_K + shortk::MAX_K * shortk::BN && l0a >= 2 * shortk::BM * shortk::BK &&
      l0b >= 2 * shortk::BK * shortk::BN) {
    shortk::Parameters p{static_cast<Z0>(m),
                         static_cast<Z0>(n),
                         static_cast<Z0>(k),
                         static_cast<Z0>(e),
                         workers,
                         static_cast<Z0>(descriptorBytes)};
    const Z2 bytes = (sizeof(p) + 511) / 512 * 512 + 2ULL * workers * shortk::C_BYTES + workers * descriptorBytes;
    host_workspace::Parameters workspace;
    if (!workspace.Prepare(bytes, p))
      return;
    shortk::Kernel<<<workers, nullptr, stream>>>(x, weight, scale, group_list, y, workspace.Data());
    workspace.Retire(stream);
    return;
  }
  const Z2 mixedDescriptor = (32 + 20 * ((upperTasks + workers - 1) / workers) + 255) / 256 * 256;
  if (k > shortk::MAX_K && k % mixedtiles::BK == 0 && n % mixedtiles::COL_N == 0 &&
      static_cast<Z2>(k) * (2 * dense::BM + dense::BN) > l1 &&
      static_cast<Z2>((m + mixedtiles::COL_M - 1) / mixedtiles::COL_M) * (n / mixedtiles::COL_N) >= workers &&
      l1 >= 2 * (mixedtiles::BM * mixedtiles::MAX_K + mixedtiles::MAX_K * mixedtiles::BN) &&
      l1 >= columnk::BM * k + 2 * columnk::MAX_K * columnk::BN && l0a >= 2 * mixedtiles::BM * mixedtiles::BK &&
      l0b >= 2 * mixedtiles::BK * mixedtiles::BN && l0c >= mixedtiles::C_BYTES &&
      mixedtiles::PANEL_BYTES + 1024 + mixedDescriptor + 2 * ((e * 12 + 255) / 256 * 256) <= ub) {
    mixedtiles::Parameters p{static_cast<Z0>(m),
                             static_cast<Z0>(n),
                             static_cast<Z0>(k),
                             static_cast<Z0>(e),
                             workers,
                             static_cast<Z0>(mixedDescriptor)};
    const Z2 bytes = (sizeof(p) + 511) / 512 * 512 + 2ULL * workers * mixedtiles::C_BYTES + workers * mixedDescriptor;
    host_workspace::Parameters workspace;
    if (!workspace.Prepare(bytes, p))
      return;
    mixedtiles::Kernel<<<workers, nullptr, stream>>>(x, weight, scale, group_list, y, workspace.Data());
    workspace.Retire(stream);
    return;
  }
  if (k > shortk::MAX_K && k % streamk::BK == 0 && static_cast<Z2>(k) * (2 * dense::BM + dense::BN) > l1 &&
      l0c >= streamk::C_BYTES && dense::PANEL_BYTES + 1024 + descriptorBytes <= ub &&
      l1 >= 2 * (streamk::BM * streamk::MAX_K + streamk::MAX_K * streamk::BN) && l0a >= 2 * streamk::BM * streamk::BK &&
      l0b >= 2 * streamk::BK * streamk::BN) {
    const Z0 tileM = static_cast<Z2>((m + streamk::BM - 1) / streamk::BM) * (n / streamk::BN) >= 2ULL * workers
                         ? streamk::BM
                         : dense::BM;
    streamk::Parameters p{static_cast<Z0>(m),
                          static_cast<Z0>(n),
                          static_cast<Z0>(k),
                          static_cast<Z0>(e),
                          workers,
                          static_cast<Z0>(descriptorBytes),
                          tileM};
    const Z2 bytes = (sizeof(p) + 511) / 512 * 512 + 2ULL * workers * streamk::C_BYTES + workers * descriptorBytes;
    host_workspace::Parameters workspace;
    if (!workspace.Prepare(bytes, p))
      return;
    streamk::Kernel<<<workers, nullptr, stream>>>(x, weight, scale, group_list, y, workspace.Data());
    workspace.Retire(stream);
    return;
  }
  if (n >= 3 * dense::BN && n % dense::BN == 0 && (n / dense::BN) % 2 == 1 && e > 1 && m >= e * (dense::BM / 2) &&
      m <= e * dense::BM &&
      shortBands::Launch(x, weight, scale, group_list, y, m, n, k, e, workers, l1, l0a, l0b, l0c, ub, stream))
    return;
  dense::Parameters p{};
  p.m = m;
  p.n = n;
  p.k = k;
  p.e = e;
  p.workers = workers;
  matmul_tiling::MatmulApiTiling tiler(*platform);
  host_workspace::SetInt8Operands(tiler);
  tiler.SetShape(dense::BM, dense::BN, k);
  tiler.SetOrgShape(dense::BM, dense::BN, k);
  tiler.SetFixSplit(dense::BM, dense::BN, dense::BK);
  tiler.SetBufferSpace(l1, l0c, ub);
  if (tiler.GetTiling(p.cube) != 0 || p.cube.baseM != dense::BM || p.cube.baseN != dense::BN ||
      p.cube.baseK != dense::BK || p.cube.shareL1Size > l1 || p.cube.shareL0CSize > l0c || p.cube.shareUbSize > ub) {
    RunFallback(x, info_x, weight, info_weight, scale, info_scale, group_list, info_group_list, y, info_y,
                availableCoreNum, stream);
    return;
  }
  const Z2 bytes = (sizeof(p) + 511) / 512 * 512 + 2ULL * workers * dense::C_BYTES;
  host_workspace::Parameters workspace;
  if (!workspace.Prepare(bytes, p))
    return;
  dense::Kernel<<<workers, nullptr, stream>>>(x, weight, scale, group_list, y, workspace.Data());
  workspace.Retire(stream);
}

namespace move319 {
} // namespace move319

namespace smallWave {
using namespace AscendC;
using gmg::Min;
using gmg::Fence;
__aicore__ inline Z2 FractionProduct(Z2 a, Z2 b) {
  constexpr Z2 mask = (1ULL << 22) - 1;
  Z2 ah = a >> 22, al = a & mask, bh = b >> 22, bl = b & mask;
  Z2 cross = ah * bl + al * bh + ((al * bl) >> 22);
  return ah * bh + ((cross + (1ULL << 21)) >> 22);
}
__aicore__ inline Z2 ScaledExp(Z2 x, Z0 &exponent) {
  constexpr Z2 one = 1ULL << 44, ln2 = 12193974156573ULL;
  Z2 cube = FractionProduct(FractionProduct(x, x), x);
  constexpr Z2 cubicQ44 = 786634598976ULL;
  constexpr Z2 logisticQ44 = 28073067271222ULL;
  Z2 a = FractionProduct(x + FractionProduct(cubicQ44, cube), logisticQ44);
  exponent = static_cast<Z0>(a / ln2);
  const Z2 r = a - exponent * ln2;
  Z2 norm = 202ULL;
  norm = 2825ULL - FractionProduct(r, norm);
  norm = 36727ULL - FractionProduct(r, norm);
  norm = 440721ULL - FractionProduct(r, norm);
  norm = 4847935ULL - FractionProduct(r, norm);
  norm = 48479349ULL - FractionProduct(r, norm);
  norm = 436314138ULL - FractionProduct(r, norm);
  norm = 3490513104ULL - FractionProduct(r, norm);
  norm = 24433591728ULL - FractionProduct(r, norm);
  norm = 146601550370ULL - FractionProduct(r, norm);
  norm = 733007751851ULL - FractionProduct(r, norm);
  norm = 2932031007403ULL - FractionProduct(r, norm);
  norm = 8796093022208ULL - FractionProduct(r, norm);
  norm = one - FractionProduct(r, norm);
  norm = one - FractionProduct(r, norm);
  return norm;
}
__aicore__ inline Z2 ToQ44(Z8 x) {
  return static_cast<Z2>(static_cast<Z1>(x * 16777216.0f)) << 20;
}
__aicore__ inline Z8 NegativeSubnormal(Z8 z) {
  constexpr Z2 one = 1ULL << 44;
  Z2 x = ToQ44(-z);
  Z0 exponent;
  Z2 norm = ScaledExp(x, exponent);
  if (exponent >= 50)
    return -0.0f;
  Z2 num = FractionProduct(x, norm);
  num = exponent <= 24 ? num << (24 - exponent) : num >> (exponent - 24);
  Z2 den = one + (norm >> exponent), units = num / den;
  Z2 twice = 2 * (num - units * den);
  units += twice > den || (twice == den && (units & 1));
  return -static_cast<Z8>(static_cast<Z1>(units)) * 0.000000059604644775390625f;
}
__aicore__ inline Z8 PositiveMidpoint(Z8 z, Z0 estimateBits) {
  Z0 lower = estimateBits & ~0x1fffU;
  union FloatBits {
    Z0 bits;
    Z8 number;
  };
  FloatBits mid;
  mid.bits = lower + 0x1000U;
  Z2 x = ToQ44(z), boundary = ToQ44(mid.number);
  Z0 exponent;
  Z2 norm = ScaledExp(x, exponent);
  if (exponent >= 53)
    return z;
  bool above = false;
  if (x > boundary) {
    Z2 distance = x - boundary;
    Z2 rhs = FractionProduct(boundary, norm);
    above = distance > (rhs >> exponent);
    if (distance == (rhs >> exponent) && (rhs & ((1ULL << exponent) - 1)) == 0)
      above = ((lower >> 13) & 1) != 0;
  }
  mid.bits = above ? mid.bits + 1 : mid.bits - 1;
  return mid.number;
}
template <Z0 PE, Z0 COLS>
__aicore__ inline void Gelu(LocalTensor<Z1> ci, LocalTensor<Z8> scale, TBuf<TPosition::VECCALC> &vectors_, Z0 count) {
  constexpr Z0 MASK_BYTES = (PE / 8 + 255) / 256 * 256;
  constexpr Z0 SP = PE + 64;
  auto u = vectors_.Get<Z8>();
  auto z = vectors_.Get<Z8>()[SP];
  auto t = vectors_.Get<Z8>()[2 * SP];
  auto result = t;
  auto den = vectors_.Get<Z8>()[3 * SP];
  auto neg = vectors_.Get<Z8>()[4 * SP + 8];
  auto pos = u;
  auto mask = vectors_.Get<Z6>()[SP * 20 + 32 + COLS * 4];
  auto out = vectors_.Get<half>()[(SP * 20 + 32 + COLS * 4 + 2 * MASK_BYTES) / 2];
  Cast(z, ci, RoundMode::CAST_RINT, count);
  PipeBarrier<PIPE_V>();
  for (Z0 col = 0; col < COLS; col += 64)
    Mul(z[col], z[col], scale[col], 64, static_cast<Z6>(count / COLS),
        BinaryRepeatParams(1, 1, 1, COLS / 8, COLS / 8, 0));
  PipeBarrier<PIPE_V>();
  Mul(u, z, z, count);
  PipeBarrier<PIPE_V>();
  Duplicate(t, -1.5957691216057308f, count);
  PipeBarrier<PIPE_V>();
  Axpy(t, u, -0.071354816275f, count);
  PipeBarrier<PIPE_V>();
  Mul(u, t, z, count);
  PipeBarrier<PIPE_V>();
  Mins(u, u, 64.0f, count);
  PipeBarrier<PIPE_V>();
  Exp(t, u, count);
  PipeBarrier<PIPE_V>();
  Adds(den, t, 1.0f, count);
  PipeBarrier<PIPE_V>();
  Div(result, z, den, count);
  PipeBarrier<PIPE_V>();
  bool changed = gmg_postprocess::Correct(z, result, u, den, mask, out, count);
  SetFlag<HardEvent::V_MTE3>(EVENT_ID2);
  WaitFlag<HardEvent::V_MTE3>(EVENT_ID2);
  if (changed) {
    SetFlag<HardEvent::S_MTE3>(EVENT_ID3);
    WaitFlag<HardEvent::S_MTE3>(EVENT_ID3);
  }
}
constexpr Z0 Rows = 16;
constexpr Z0 Columns = 128;
constexpr Z0 MaxPanelK = 256;
constexpr Z0 VecWidth = Columns < 64 ? 64 : Columns;
constexpr Z0 Elements = Rows / 2 * VecWidth;
constexpr Z0 Scratch = Elements + 64;
constexpr Z0 MaskBytes = (Elements / 8 + 255) / 256 * 256;
constexpr Z0 OutputOffset = Scratch * 20 + 32 + VecWidth * 4 + 2 * MaskBytes;
constexpr Z0 UbBytes = OutputOffset + Elements * (sizeof(half) + 2 * sizeof(Z8)) + MaskBytes;
__aicore__ inline void Compute(GM_ADDR x, GM_ADDR w, GM_ADDR slot, Z0 n, Z0 k, Z0 row, Z0 col, Z0 rows, Z0 width) {
  GlobalTensor<Z7> a, b;
  GlobalTensor<Z1> c;
  a.SetGlobalBuffer(reinterpret_cast<__gm__ Z7 *>(x) + Z2(row) * k);
  b.SetGlobalBuffer(reinterpret_cast<__gm__ Z7 *>(w) + col);
  c.SetGlobalBuffer(reinterpret_cast<__gm__ Z1 *>(slot));
  LocalTensor<Z7> a1(TPosition::A1, 0, Rows * k);
  LocalTensor<Z7> b1(TPosition::B1, Rows * k, width * k);
  LocalTensor<Z7> a2(TPosition::A2, 0, Rows * k);
  LocalTensor<Z7> b2(TPosition::B2, 0, width * k);
  LocalTensor<Z1> accum(TPosition::CO1, 0, Rows * width);
  if (rows < Rows) {
    InitConstValue(a1.ReinterpretCast<Z0>(), InitConstValueParams<Z0>(1, Rows * k / 32, 0, 0));
    PipeBarrier<PIPE_MTE2>();
  }
  DataCopy(a1, a, Nd2NzParams(1, rows, k, 0, k, Rows, 1, 0));
  DataCopy(b1, b, Nd2NzParams(1, k, width, 0, n, k, 1, 0));
  Fence<HardEvent::MTE2_MTE1>();
  Z6 pad[4] = {};
  Load3DSetFMatrixCal(1, Rows, pad);
  LoadData3DParamsV2Pro ap;
  ap.channelSize = k;
  ap.extConfig = (Z2(Rows) << 16) | k;
  LoadData(a2, a1, ap);
  LoadData2dTransposeParams bp{0, static_cast<Z6>(width / 32), static_cast<Z4>(k / 32), 1, 0, inc};
  for (Z0 kk = 0; kk < k; kk += 32)
    LoadDataWithTranspose(b2[kk * width], b1[kk * 32], bp);
  Fence<HardEvent::MTE1_M>();
  MmadParams mp;
  mp.m = Rows;
  mp.n = width;
  mp.k = k;
  mp.isBias = false;
  mp.cmatrixInitVal = true;
  Mmad(accum, a2, b2, mp);
  Fence<HardEvent::M_FIX>();
  FixpipeParamsV220 fp;
  fp.nSize = width;
  fp.mSize = rows;
  fp.srcStride = Rows;
  fp.dstStride = Columns;
  fp.quantPre = QuantMode_t::NoQuant;
  fp.reluEn = false;
  Fixpipe<Z1, Z1, CFG_ROW_MAJOR>(c, accum, fp);
}
__aicore__ inline void Finish(GM_ADDR slot, GM_ADDR scales, GM_ADDR output, Z0 n, Z0 row, Z0 col, Z0 rows, Z0 width) {
  const Z0 halfRows = (rows + 1) / 2;
  const Z0 first = GetSubBlockIdx() * halfRows;
  TPipe pipe;
  TBuf<TPosition::VECCALC> panel;
  pipe.InitBuffer(panel, UbBytes);
  auto ci = panel.Get<Z1>();
  auto scale = panel.Get<Z8>()[5 * Scratch + 8];
  GlobalTensor<Z8> sg;
  sg.SetGlobalBuffer(reinterpret_cast<__gm__ Z8 *>(scales) + col);
  if (first < rows) {
    if (width < VecWidth) {
      Duplicate(ci, Z1(0), Elements);
      Duplicate(scale, 0.0f, VecWidth);
      Fence<HardEvent::V_MTE2>();
    }
    DataCopy(scale, sg, width);
  }
  CrossCoreWaitFlag(dense::READY);
  if (first >= rows)
    return;
  const Z0 height = Min(rows - first, halfRows);
  GlobalTensor<Z1> c;
  c.SetGlobalBuffer(reinterpret_cast<__gm__ Z1 *>(slot) + first * Columns);
  DataCopyParams cp{static_cast<Z4>(height), static_cast<Z4>(width / 8), static_cast<Z4>((Columns - width) / 8),
                    static_cast<Z4>((VecWidth - width) / 8)};
  DataCopy(ci, c, cp);
  Fence<HardEvent::MTE2_V>();
  Gelu<Elements, VecWidth>(ci, scale, panel, height * VecWidth);
  GlobalTensor<half> y;
  y.SetGlobalBuffer(reinterpret_cast<__gm__ half *>(output) + Z2(row + first) * n + col);
  DataCopyParams yp{static_cast<Z4>(height), static_cast<Z4>(width / 16), static_cast<Z4>((VecWidth - width) / 16),
                    static_cast<Z4>((n - width) / 16)};
  DataCopy(y, panel.Get<half>()[OutputOffset / 2], yp);
  Fence<HardEvent::MTE3_S>();
}
__global__ __mix__(1, 2) void SmallWaveKernel(GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR y, GM_ADDR ws, Z0 m, Z0 n, Z0 k,
                                              Z0 tileRows) {
  Z0 tile = GetBlockIdx();
  if ASCEND_IS_AIV {
    tile /= 2;
  }
  const Z0 bands = (n + Columns - 1) / Columns;
  const Z0 row = tile / bands * tileRows, col = tile % bands * Columns;
  const Z0 rows = Min(tileRows, m - row), width = Min(Columns, n - col);
  GM_ADDR slot = ws + Z2(tile) * Rows * Columns * sizeof(Z1);
  if ASCEND_IS_AIC {
    Compute(x, w, slot, n, k, row, col, rows, width);
    CrossCoreSetFlag<2, PIPE_FIX>(dense::READY);
  }
  if ASCEND_IS_AIV {
    Finish(slot, s, y, n, row, col, rows, width);
  }
}
static bool Launch(GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR y, Z3 e, Z3 m, Z3 n, Z3 k, Z3 coreLimit,
                   aclrtStream stream) {
  const uintptr_t addresses = reinterpret_cast<uintptr_t>(x) | reinterpret_cast<uintptr_t>(w) |
                              reinterpret_cast<uintptr_t>(s) | reinterpret_cast<uintptr_t>(y);
  if (e != 1 || m <= 0 || n <= 0 || k <= 0 || k > MaxPanelK || k % 32 || n % 32 || (addresses & 31U) != 0)
    return false;
  if (coreLimit <= 0)
    return false;
  auto plat = platform_ascendc::PlatformAscendCManager::GetInstance();
  if (!plat)
    return false;
  const Z0 workers = std::min<Z2>(coreLimit, std::min(plat->GetCoreNumAic(), plat->GetCoreNumAiv() / 2));
  const Z0 bands = (n + Columns - 1) / Columns;
  const Z0 rowWorkers = workers / bands;
  if (!rowWorkers || m > static_cast<Z3>(rowWorkers) * Rows)
    return false;
  constexpr Z0 RowQuantum = 4;
  const Z0 tileRows = ((m + rowWorkers * RowQuantum - 1) / (rowWorkers * RowQuantum)) * RowQuantum;
  const Z2 jobs = ((m + tileRows - 1) / tileRows) * bands;
  Z2 l1 = 0, l0a = 0, l0b = 0, l0c = 0, ub = 0;
  using Memory = platform_ascendc::CoreMemType;
  plat->GetCoreMemSize(Memory::L1, l1);
  plat->GetCoreMemSize(Memory::L0_A, l0a);
  plat->GetCoreMemSize(Memory::L0_B, l0b);
  plat->GetCoreMemSize(Memory::L0_C, l0c);
  plat->GetCoreMemSize(Memory::UB, ub);
  if (l1 < (Rows + Columns) * k || l0a < Rows * k || l0b < Columns * k || l0c < Rows * Columns * sizeof(Z1) ||
      ub < UbBytes)
    return false;
  void *workspace = nullptr;
  if (aclrtMalloc(&workspace, jobs * Rows * Columns * sizeof(Z1), ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS)
    return false;
  SmallWaveKernel<<<static_cast<Z0>(jobs), nullptr, stream>>>(x, w, s, y, (GM_ADDR)workspace, m, n, k, tileRows);
  if (aclrtSynchronizeStream(stream) == ACL_SUCCESS)
    aclrtFree(workspace);
  return true;
}
} // namespace smallWave
namespace shortBands {
using namespace AscendC;
using gmg::Min;
using gmg::Fence;
template <Z0 PE, Z0 COLS>
__aicore__ inline void Gelu(LocalTensor<Z1> ci, LocalTensor<Z8> scale, TBuf<TPosition::VECCALC> &vectors_, Z0 count,
                            bool pendingStore) {
  constexpr Z0 MASK_BYTES = (PE / 8 + 255) / 256 * 256;
  constexpr Z0 SP = PE + 64;
  auto u = vectors_.Get<Z8>();
  auto z = vectors_.Get<Z8>()[SP];
  auto t = vectors_.Get<Z8>()[2 * SP];
  auto result = t;
  auto den = vectors_.Get<Z8>()[3 * SP];
  auto mask = vectors_.Get<Z6>()[SP * 20 + 32 + COLS * 4];
  auto out = vectors_.Get<half>()[(SP * 20 + 32 + COLS * 4 + 4 * MASK_BYTES) / 2];
  Cast(z, ci, RoundMode::CAST_RINT, count);
  PipeBarrier<PIPE_V>();
  for (Z0 col = 0; col < COLS; col += 64)
    Mul(z[col], z[col], scale[col], 64, static_cast<Z6>(count / COLS),
        BinaryRepeatParams(1, 1, 1, COLS / 8, COLS / 8, 0));
  PipeBarrier<PIPE_V>();
  SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
  Mul(u, z, z, count);
  PipeBarrier<PIPE_V>();
  Duplicate(t, -1.5957691216057308f, count);
  PipeBarrier<PIPE_V>();
  Axpy(t, u, -0.071354816275f, count);
  PipeBarrier<PIPE_V>();
  Mul(u, t, z, count);
  PipeBarrier<PIPE_V>();
  Mins(u, u, 64.0f, count);
  PipeBarrier<PIPE_V>();
  Exp(t, u, count);
  PipeBarrier<PIPE_V>();
  Adds(den, t, 1.0f, count);
  PipeBarrier<PIPE_V>();
  Div(result, z, den, count);
  PipeBarrier<PIPE_V>();
  if (pendingStore)
    WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
  bool changed = gmg_postprocess::Correct(z, result, u, den, mask, out, count);
  SetFlag<HardEvent::V_MTE3>(EVENT_ID2);
  WaitFlag<HardEvent::V_MTE3>(EVENT_ID2);
  if (changed) {
    SetFlag<HardEvent::S_MTE3>(EVENT_ID3);
    WaitFlag<HardEvent::S_MTE3>(EVENT_ID3);
  }
}
class CheckedFinish {
  TBuf<TPosition::VECCALC> panel_;
  GlobalTensor<Z8> scales_;
  GlobalTensor<half> output_;
  bool pendingInput_ = false, pendingStore_ = false;

public:
  __aicore__ inline void Init(TPipe &pipe, GM_ADDR scale, GM_ADDR y, Z0 extra = 0) {
    pipe.InitBuffer(panel_, dense::PANEL_BYTES + extra);
    scales_.SetGlobalBuffer(reinterpret_cast<__gm__ Z8 *>(scale));
    output_.SetGlobalBuffer(reinterpret_cast<__gm__ half *>(y));
  }
  template <Z0 VC, Z0 storageWidth, class Parameters>
  __aicore__ inline void Run(const Parameters &p, const gmg::GeneralTask &task, GM_ADDR slot, Z0 pitch = dense::BN) {
    const Z0 halfRows = (task.vm + 1) / 2;
    const Z0 first = GetSubBlockIdx() * halfRows;
    if (first >= task.vm)
      return;
    const Z0 rows = gmg::Min(halfRows, task.vm - first);
    const Z0 width = task.vn;
    if (pendingInput_) {
      WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
      pendingInput_ = false;
    }
    auto ci = panel_.Get<Z1>()[4 * dense::SP + 8];
    auto scale = panel_.Get<Z8>()[5 * dense::SP + 8];
    auto out = panel_.Get<half>()[(dense::SP * 20 + 32 + storageWidth * 4 + 4 * dense::MASK_BYTES) / 2];
    GlobalTensor<Z1> c;
    c.SetGlobalBuffer(reinterpret_cast<__gm__ Z1 *>(slot));
    if (width != VC) {
      Duplicate(ci, static_cast<Z1>(0), rows * VC);
      Duplicate(scale, 0.0f, VC);
      Fence<HardEvent::V_MTE2>();
    }
    DataCopyExtParams cp{static_cast<Z4>(rows), width * 4, (pitch - width) * 4, (VC - ((width + 7) / 8) * 8) / 8, 0};
    DataCopyPadExtParams<Z1> ip{true, 0, static_cast<Z6>((8 - width % 8) % 8), 0};
    DataCopyPad(ci, c[first * pitch], cp, ip);
    DataCopyExtParams sp{1, width * 4, 0, 0, 0};
    DataCopyPadExtParams<Z8> fp{true, 0, static_cast<Z6>((8 - width % 8) % 8), 0};
    DataCopyPad(scale, scales_[static_cast<Z2>(task.expert) * p.n + task.col], sp, fp);
    Fence<HardEvent::MTE2_V>();
    Gelu<dense::PE, VC>(ci, scale, panel_, rows * VC, pendingStore_);
    pendingInput_ = true;
    DataCopyExtParams yp{static_cast<Z4>(rows), width * 2, (VC - ((width + 15) / 16) * 16) / 16, (p.n - width) * 2, 0};
    DataCopyPad(output_[static_cast<Z2>(task.row + first) * p.n + task.col], out, yp);
    SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
    pendingStore_ = true;
  }
  __aicore__ inline void Drain() {
    if (pendingInput_)
      WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
    if (pendingStore_)
      WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
  }
};
template <Z0 BM, Z0 BN, Z0 BK, Z0 MAX_K> class PanelCube {
  TQue<TPosition::A1, 2> a1_;
  TQue<TPosition::B1, 2> b1_;
  TQue<TPosition::A2, 2> a2_;
  TQue<TPosition::B2, 2> b2_;
  TQue<TPosition::CO1, 1> c1_;

public:
  __aicore__ inline void Init(TPipe &pipe) {
    pipe.InitBuffer(a1_, 2, BM * MAX_K);
    pipe.InitBuffer(b1_, 2, MAX_K * BN);
    pipe.InitBuffer(a2_, 2, BM * BK);
    pipe.InitBuffer(b2_, 2, BK * BN);
    pipe.InitBuffer(c1_, 1, BM * BN * sizeof(Z1));
  }
  __aicore__ inline void Load(GlobalTensor<Z7> &a, GlobalTensor<Z7> &b, Z0 vm, Z0 pitch, Z0 k, Z0 base, Z0 aPitch = 0) {
    const Z0 span = Min(MAX_K, k - base);
    auto aa = a1_.AllocTensor<Z7>();
    if (vm % 16) {
      const Z0 pad = 16 - vm % 16;
      InitConstValue(aa[vm * 32].template ReinterpretCast<Z0>(), InitConstValueParams<Z0>(span / 32, pad, BM - pad, 0));
      PipeBarrier<PIPE_MTE2>();
    }
    DataCopy(
        aa, a[base],
        Nd2NzParams(1, static_cast<Z4>(vm), static_cast<Z4>(span), 0, static_cast<Z4>(aPitch ? aPitch : k), BM, 1, 0));
    a1_.EnQue(aa);
    auto bb = b1_.AllocTensor<Z7>();
    DataCopy(bb, b[static_cast<Z2>(base) * pitch],
             Nd2NzParams(1, static_cast<Z4>(span), BN, 0, static_cast<Z4>(pitch), static_cast<Z4>(span), 1, 0));
    b1_.EnQue(bb);
  }
  __aicore__ inline void Run(GlobalTensor<Z1> &c, GlobalTensor<Z7> &a, GlobalTensor<Z7> &b, Z0 vm, Z0 pitch, Z0 k,
                             Z0 aPitch = 0) {
    const Z0 mAligned = (vm + 15) / 16 * 16;
    Z6 padding[4] = {0, 0, 0, 0};
    Load3DSetFMatrixCal(1, BM, padding);
    auto c1 = c1_.AllocTensor<Z1>();
    const Z0 panels = (k + MAX_K - 1) / MAX_K, offset = GetBlockIdx() % panels;
    Load(a, b, vm, pitch, k, offset * MAX_K, aPitch);
    for (Z0 step = 0; step < panels; ++step) {
      const Z0 base = ((offset + step) % panels) * MAX_K;
      const Z0 span = Min(MAX_K, k - base);
      auto ar1 = a1_.DeQue<Z7>();
      auto br1 = b1_.DeQue<Z7>();
      if (step + 1 < panels)
        Load(a, b, vm, pitch, k, ((offset + step + 1) % panels) * MAX_K, aPitch);
      for (Z0 kk = 0; kk < span; kk += BK) {
        auto aa2 = a2_.AllocTensor<Z7>();
        auto bb2 = b2_.AllocTensor<Z7>();
        LoadData3DParamsV2Pro ap;
        ap.channelSize = span;
        ap.extConfig = (static_cast<Z2>(kk) << 32) | (static_cast<Z2>(mAligned) << 16) | BK;
        LoadData(aa2, ar1, ap);
        LoadData2dTransposeParams bp{0, static_cast<Z6>(BN / 32), static_cast<Z4>(span / 32), 1, 0, inc};
        for (Z0 kb = 0; kb < BK / 32; ++kb)
          LoadDataWithTranspose(bb2[kb * BN * 32], br1[kk * 32 + kb * 1024], bp);
        a2_.EnQue(aa2);
        b2_.EnQue(bb2);
        auto ar = a2_.DeQue<Z7>();
        auto br = b2_.DeQue<Z7>();
        MmadParams mp;
        mp.m = static_cast<Z4>(mAligned);
        mp.n = BN;
        mp.k = BK;
        mp.isBias = false;
        mp.cmatrixInitVal = (step == 0 && kk == 0);
        Mmad(c1, ar, br, mp);
        a2_.FreeTensor(ar);
        b2_.FreeTensor(br);
      }
      a1_.FreeTensor(ar1);
      b1_.FreeTensor(br1);
    }
    c1_.EnQue(c1);
    auto cr = c1_.DeQue<Z1>();
    FixpipeParamsV220 fp;
    fp.nSize = BN;
    fp.mSize = static_cast<Z4>(vm);
    fp.srcStride = static_cast<Z4>(mAligned);
    fp.dstStride = BN;
    fp.quantPre = QuantMode_t::NoQuant;
    fp.reluEn = false;
    Fixpipe<Z1, Z1, CFG_ROW_MAJOR>(c, cr, fp);
    c1_.FreeTensor(cr);
  }
};
struct Config {
  Z0 m, n, k, e, workers;
};
template <Z0 Rows, Z0 Columns> class OrderedCursor {
  const __gm__ Z3 *ends_;
  Config cfg_;
  Z0 worker_, wave_ = 0, expert_ = 0, previous_ = 0, phase_ = 0, first_ = 0, rows_ = 0;
  Z2 prefix_ = 0, stop_ = 0;

public:
  __aicore__ inline OrderedCursor(const Config &p, GM_ADDR g, Z0 worker, Z0)
      : ends_(reinterpret_cast<const __gm__ Z3 *>(g)), cfg_(p), worker_(worker) {}
  __aicore__ inline bool Next(gmg::GeneralTask &t) {
    const Z2 id = wave_ * cfg_.workers + ((wave_ % 2) ? cfg_.workers - 1 - worker_ : worker_);
    const Z0 columns = cfg_.n / Columns;
    while (stop_ <= id) {
      if (expert_ == cfg_.e) {
        if (phase_)
          return false;
        phase_ = 1;
        expert_ = 0;
        previous_ = 0;
      }
      Z0 end = ends_[expert_++];
      first_ = previous_;
      rows_ = end - previous_;
      previous_ = end;
      Z0 tiles = (rows_ + Rows - 1) / Rows;
      Z0 tail = rows_ % Rows, shortTile = (tail && tail <= Rows / 2);
      if (phase_) {
        first_ += rows_ - tail;
        rows_ = tail;
        tiles = shortTile;
      } else
        tiles -= shortTile;
      prefix_ = stop_;
      stop_ += Z2(tiles) * columns;
    }
    Z0 local = id - prefix_, off = (local / columns) * Rows;
    t.expert = expert_ - 1;
    t.row = first_ + off;
    t.vm = Min(Rows, rows_ - off);
    t.col = (local % columns) * Columns;
    t.vn = Columns;
    ++wave_;
    return true;
  }
};
template <Z0 Rows, Z0 Columns, Z0 Depth, Z0 Panel>
__global__ __mix__(1, 2) void ShortBandKernel(GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR groups, GM_ADDR y, GM_ADDR space,
                                              Config cfg) {
  Z0 worker = GetBlockIdx();
  if ASCEND_IS_AIV {
    worker /= 2;
  }
  TPipe pipe;
  PanelCube<Rows, Columns, Depth, Panel> cube;
  CheckedFinish finish;
  if ASCEND_IS_AIC {
    cube.Init(pipe);
  }
  if ASCEND_IS_AIV {
    finish.Init(pipe, s, y, (Columns > dense::BN ? Columns - dense::BN : 0) * sizeof(Z8));
  }
  OrderedCursor<Rows, Columns> cursor(cfg, groups, worker, 0);
  gmg::GeneralTask t;
  Z0 ordinal = 0;
  while (cursor.Next(t)) {
    GM_ADDR slot = space + (static_cast<Z2>(t.col) * cfg.m + Z2(t.row) * Columns) * sizeof(Z1);
    if ASCEND_IS_AIC {
      GlobalTensor<Z7> a, b;
      GlobalTensor<Z1> c;
      a.SetGlobalBuffer(reinterpret_cast<__gm__ Z7 *>(x) + Z2(t.row) * cfg.k);
      b.SetGlobalBuffer(reinterpret_cast<__gm__ Z7 *>(w) + (Z2(t.expert) * cfg.k) * cfg.n + t.col);
      c.SetGlobalBuffer(reinterpret_cast<__gm__ Z1 *>(slot));
      cube.Run(c, a, b, t.vm, cfg.n, cfg.k);
      CrossCoreSetFlag<2, PIPE_FIX>(ordinal);
    }
    if ASCEND_IS_AIV {
      CrossCoreWaitFlag(ordinal);
      constexpr Z0 step = 2 * (dense::PE / Columns);
      for (Z0 i = 0; i < t.vm; i += step) {
        auto part = t;
        part.row += i;
        part.vm = Min(step, t.vm - i);
        finish.template Run<Columns, Columns>(cfg, part, slot + Z2(i) * Columns * sizeof(Z1), Columns);
      }
    }
    ++ordinal;
  }
  if ASCEND_IS_AIV {
    finish.Drain();
  }
}
static bool Launch(GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR g, GM_ADDR y, Z3 m, Z3 n, Z3 k, Z3 e, Z0 workers, Z2 l1,
                   Z2 l0a, Z2 l0b, Z2 l0c, Z2 ub, aclrtStream stream) {
  constexpr Z0 rows = 80, cols = 256, depth = 128, panel = 512;
  const Z2 bands = n / cols;
  const Z2 upper = ((m + rows - 1) / rows + e - 1) * bands;
  if (n % cols || k % depth || k <= panel || upper > 16ULL * workers || l1 < 2ULL * (rows + cols) * panel ||
      l0a < 2 * rows * depth || l0b < 2 * cols * depth || l0c < rows * cols * sizeof(Z1) ||
      ub < dense::PANEL_BYTES + (cols > dense::BN ? cols - dense::BN : 0) * sizeof(Z8))
    return false;
  void *space = nullptr;
  if (aclrtMalloc(&space, Z2(m) * n * sizeof(Z1), ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS)
    return false;
  Config cfg{static_cast<Z0>(m), static_cast<Z0>(n), static_cast<Z0>(k), static_cast<Z0>(e), workers};
  ShortBandKernel<rows, cols, depth, panel><<<workers, nullptr, stream>>>(x, w, s, g, y, (GM_ADDR)space, cfg);
  if (aclrtSynchronizeStream(stream) == ACL_SUCCESS)
    aclrtFree(space);
  return true;
}
} // namespace shortBands
namespace microDot {
using namespace AscendC;
using gmg::Fence;
union FloatWord {
  Z8 value;
  Z0 bits;
};
__aicore__ inline Z4 HalfBits(Z8 value) {
  FloatWord word;
  word.value = value;
  const Z0 mag = word.bits & 0x7fffffffU;
  const Z4 sign = static_cast<Z4>((word.bits >> 16) & 0x8000U);
  if (mag < 0x33000000U)
    return sign;
  if (mag < 0x38800000U) {
    const Z0 shift = 126 - (mag >> 23);
    const Z0 mantissa = (mag & 0x7fffffU) | 0x800000U;
    const Z0 round = (1U << (shift - 1)) - 1 + ((mantissa >> shift) & 1U);
    return sign | static_cast<Z4>((mantissa + round) >> shift);
  }
  const Z0 rounded = mag + 0xfffU + ((mag >> 13) & 1U);
  return sign | static_cast<Z4>((rounded >> 13) - (112U << 10));
}
__aicore__ inline Z4 NearOrigin(Z8 z) {
  FloatWord raw;
  raw.value = z;
  const Z4 sign = static_cast<Z4>((raw.bits >> 16) & 0x8000U);
  const Z8 mag = z < 0.0f ? -z : z;
  const Z8 units = mag * 8388608.0f;
  const Z1 whole = static_cast<Z1>(units);
  const Z8 correction = mag * mag * 6693141.0f;
  const Z8 residual = (units - static_cast<Z8>(whole) - 0.5f) + (z < 0.0f ? -correction : correction);
  return static_cast<Z4>(sign | (whole + (residual > 0.0f)));
}
__aicore__ inline Z8 ExpMinus(Z8 a) {
  const Z1 p = static_cast<Z1>(a * 1.44269504089f + 0.5f);
  const Z8 r = (static_cast<Z8>(p) * 0.693145751953125f - a) + static_cast<Z8>(p) * 0.000001428606765330187f;
  Z8 t = 1.0f / 40320.0f;
  t = 1.0f / 5040.0f + r * t;
  t = 1.0f / 720.0f + r * t;
  t = 1.0f / 120.0f + r * t;
  t = 1.0f / 24.0f + r * t;
  t = 1.0f / 6.0f + r * t;
  t = 0.5f + r * t;
  t = 1.0f + r * t;
  FloatWord power;
  power.bits = static_cast<Z0>(127 - p) << 23;
  return (1.0f + r * t) * power.value;
}
__aicore__ inline Z4 GeluBits(Z8 z) {
  if (z >= 7.08934307098388671875f)
    return HalfBits(z);
  if (z <= -6.0f)
    return 0x8000U;
  const Z8 mag = z < 0.0f ? -z : z;
  if (mag <= 0.000125f)
    return NearOrigin(z);
  const Z8 a = 1.5957691216057308f * (mag + 0.044715f * mag * mag * mag);
  const Z8 t = ExpMinus(a);
  FloatWord y;
  y.value = z < 0.0f ? (z * t) / (1.0f + t) : z / (1.0f + t);
  if (z < -1.0f && y.value >= -0.00006103515625f) {
    y.value = smallWave::NegativeSubnormal(z);
  } else if (z >= 1.0f) {
    const Z0 low = y.bits & 8191U;
    if (low >= 3968 && low <= 4224)
      y.value = smallWave::PositiveMidpoint(z, y.bits);
  } else if (z < 0.0f && y.value >= -0.00006103515625f) {
    return NearOrigin(z);
  }
  return HalfBits(y.value);
}
constexpr Z0 XBytes = 32, WBytes = 128, ScaleBytes = 256;
constexpr Z0 WOffset = XBytes, ScaleOffset = WOffset + WBytes;
constexpr Z0 OutOffset = ScaleOffset + ScaleBytes, StorageBytes = OutOffset + 32;
template <bool Outer, bool Scalar>
__global__ __aicore__ void MicroDotKernel(GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR g, GM_ADDR y, Z0 e, Z0 m, Z0 k,
                                          Z0 n) {
  KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
  if constexpr (Scalar) {
    m = 1;
    n = 1;
  }
  if constexpr (Outer)
    k = 1;
  LocalTensor<Z6> buf(TPosition::VECCALC, 0, StorageBytes);
  auto lx = buf.ReinterpretCast<Z7>();
  auto lw = buf[WOffset].ReinterpretCast<Z7>();
  auto ls = buf[ScaleOffset].ReinterpretCast<Z8>();
  auto output = buf[OutOffset].ReinterpretCast<Z4>();
  GlobalTensor<Z7> gx, gw;
  GlobalTensor<Z8> gs;
  GlobalTensor<Z3> gg;
  GlobalTensor<Z4> gy;
  gx.SetGlobalBuffer(reinterpret_cast<__gm__ Z7 *>(x));
  gw.SetGlobalBuffer(reinterpret_cast<__gm__ Z7 *>(w));
  gs.SetGlobalBuffer(reinterpret_cast<__gm__ Z8 *>(s));
  gg.SetGlobalBuffer(reinterpret_cast<__gm__ Z3 *>(g));
  gy.SetGlobalBuffer(reinterpret_cast<__gm__ Z4 *>(y));
  DataCopyPad(lx, gx, {1, m * k, 0, 0, 0}, {false, 0, 0, 0});
  DataCopyPad(lw, gw, {1, e * k * n, 0, 0, 0}, {false, 0, 0, 0});
  DataCopyPad(ls, gs, {1, e * n * 4, 0, 0, 0}, {false, 0, 0, 0});
  Z0 expert = 0;
  if constexpr (Scalar) {
    Z0 hi = e - 1;
    while (expert < hi) {
      const Z0 mid = expert + (hi - expert) / 2;
      if (gg.GetValue(mid) == 0)
        expert = mid + 1;
      else
        hi = mid;
    }
  }
  Fence<HardEvent::MTE2_S>();
  for (Z0 row = 0; row < (Scalar ? 1 : m); ++row) {
    if constexpr (!Scalar)
      while (expert + 1 < e && gg.GetValue(expert) <= row)
        ++expert;
    for (Z0 col = 0; col < (Scalar ? 1 : n); ++col) {
      Z1 total = 0;
      if constexpr (Outer) {
        total = static_cast<Z1>(lx.GetValue(row)) * lw.GetValue(expert * n + col);
      } else {
        for (Z0 d = 0; d < k; ++d)
          total += static_cast<Z1>(lx.GetValue(row * k + d)) * lw.GetValue((expert * k + d) * n + col);
      }
      const Z8 z = static_cast<Z8>(total) * ls.GetValue(expert * n + col);
      output.SetValue(row * n + col, GeluBits(z));
    }
  }
  Fence<HardEvent::S_MTE3>();
  DataCopyPad(gy, output, {1, m * n * 2U, 0, 0, 0});
  Fence<HardEvent::MTE3_S>();
}
static bool Launch(GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR g, GM_ADDR y, Z3 e, Z3 m, Z3 k, Z3 n, Z3 coreLimit,
                   aclrtStream stream) {
  if (coreLimit <= 0 || e <= 0 || m <= 0 || k <= 0 || n <= 0 || m * n > 16 || m * k > XBytes || e * k * n > WBytes ||
      e * n > ScaleBytes / sizeof(Z8))
    return false;
  auto plat = platform_ascendc::PlatformAscendCManager::GetInstance();
  if (!plat || !plat->GetCoreNumAiv())
    return false;
  Z2 ub = 0;
  plat->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ub);
  if (ub < StorageBytes)
    return false;
  if (m * n == 1 && k == 1)
    MicroDotKernel<true, true><<<1, nullptr, stream>>>(x, w, s, g, y, e, m, k, n);
  else if (m * n == 1)
    MicroDotKernel<false, true><<<1, nullptr, stream>>>(x, w, s, g, y, e, m, k, n);
  else if (k == 1)
    MicroDotKernel<true, false><<<1, nullptr, stream>>>(x, w, s, g, y, e, m, k, n);
  else
    MicroDotKernel<false, false><<<1, nullptr, stream>>>(x, w, s, g, y, e, m, k, n);
  return true;
}
} // namespace microDot
namespace hcBand {
using namespace AscendC;
using gmg::Min;
using gmg::Fence;
using suffixBand::NegativeSubnormal;
using suffixBand::PositiveMidpoint;
constexpr Z0 VectorStride = dense::SP;
constexpr Z0 OutputOffset = VectorStride * 20 + 32 + 448 * 4 + 2 * dense::MASK_BYTES + 256;
constexpr Z0 VectorBytes = OutputOffset + dense::PE * sizeof(half);
__aicore__ inline void RepairNearOrigin(LocalTensor<Z8> z, LocalTensor<Z8> result, LocalTensor<Z8> u,
                                        LocalTensor<Z8> den, LocalTensor<Z6> mask, LocalTensor<Z6> second, Z0 count) {
  Abs(u, z, count);
  PipeBarrier<PIPE_V>();
  CompareScalar(second, u, 0.0001220703125f, CMPMODE::LE, count);
  PipeBarrier<PIPE_V>();
  And(mask.ReinterpretCast<Z4>(), mask.ReinterpretCast<Z4>(), second.ReinterpretCast<Z4>(), count / 16);
  Mul(z, z, u, count);
  PipeBarrier<PIPE_V>();
  Muls(z, z, 6693141.0f, count);
  Muls(den, u, 8388608.0f, count);
  PipeBarrier<PIPE_V>();
  Cast(u.ReinterpretCast<Z1>(), den, RoundMode::CAST_TRUNC, count);
  PipeBarrier<PIPE_V>();
  Cast(u, u.ReinterpretCast<Z1>(), RoundMode::CAST_NONE, count);
  PipeBarrier<PIPE_V>();
  Sub(den, den, u, count);
  PipeBarrier<PIPE_V>();
  Adds(den, den, -0.5f, count);
  PipeBarrier<PIPE_V>();
  Add(den, den, z, count);
  PipeBarrier<PIPE_V>();
  CompareScalar(second, den, 0.0f, CMPMODE::GT, count);
  Duplicate(den, 1.0f, count);
  PipeBarrier<PIPE_V>();
  Select(den, second, den, 0.0f, SELMODE::VSEL_TENSOR_SCALAR_MODE, count);
  PipeBarrier<PIPE_V>();
  Add(den, den, u, count);
  PipeBarrier<PIPE_V>();
  Muls(den, den, 0.000000059604644775390625f, count);
  CompareScalar(second, z, 0.0f, CMPMODE::LT, count);
  PipeBarrier<PIPE_V>();
  Muls(u, den, -1.0f, count);
  PipeBarrier<PIPE_V>();
  Select(den, second, u, den, SELMODE::VSEL_TENSOR_TENSOR_MODE, count);
  PipeBarrier<PIPE_V>();
  Select(result, mask, den, result, SELMODE::VSEL_TENSOR_TENSOR_MODE, count);
  PipeBarrier<PIPE_V>();
}
template <Z0 PE, Z0 COLS, bool PrefetchDuringRepair>
__aicore__ inline void Gelu(LocalTensor<Z1> ci, LocalTensor<Z8> scale, TBuf<TPosition::VECCALC> &vectors_, Z0 rows,
                            Z0 vc, bool pendingStore, GM_ADDR nextInput, Z0 nextRows, Z0 width, Z0 pitch,
                            int followingReady) {
  const Z0 count = (rows * vc + 63) / 64 * 64;
  constexpr Z0 MASK_BYTES = (PE / 8 + 255) / 256 * 256;
  constexpr Z0 SP = VectorStride;
  auto u = vectors_.Get<Z8>();
  auto z = vectors_.Get<Z8>()[SP];
  auto t = vectors_.Get<Z8>()[2 * SP];
  auto result = t;
  auto den = vectors_.Get<Z8>()[3 * SP];
  auto mask = vectors_.Get<Z6>()[SP * 20 + 32 + 448 * 4];
  auto out = vectors_.Get<half>()[OutputOffset / 2];
  Cast(z, ci, RoundMode::CAST_RINT, count);
  PipeBarrier<PIPE_V>();
  for (Z0 col = 0; col < vc; col += 64)
    Mul(z[col], z[col], scale[col], gmg::Min(64, vc - col), static_cast<Z6>(rows),
        BinaryRepeatParams(1, 1, 1, static_cast<Z6>(vc / 8), static_cast<Z6>(vc / 8), 0));
  PipeBarrier<PIPE_V>();
  SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
  Mul(u, z, z, count);
  PipeBarrier<PIPE_V>();
  Duplicate(t, -1.5957691216057308f, count);
  PipeBarrier<PIPE_V>();
  Axpy(t, u, -0.071354816275f, count);
  PipeBarrier<PIPE_V>();
  Mul(u, t, z, count);
  PipeBarrier<PIPE_V>();
  Mins(u, u, 64.0f, count);
  PipeBarrier<PIPE_V>();
  Exp(t, u, count);
  PipeBarrier<PIPE_V>();
  Adds(den, t, 1.0f, count);
  PipeBarrier<PIPE_V>();
  Div(result, z, den, count);
  PipeBarrier<PIPE_V>();
  auto second = vectors_.Get<Z6>()[SP * 20 + 32 + 448 * 4 + MASK_BYTES];
  Adds(den.ReinterpretCast<Z1>(), result.ReinterpretCast<Z1>(), Z1(4), count);
  if constexpr (PrefetchDuringRepair) {
    PipeBarrier<PIPE_V>();
    And(den.ReinterpretCast<Z4>(), den.ReinterpretCast<Z4>(), u[PE + 0].ReinterpretCast<Z4>(), 128,
        static_cast<Z6>(count / 64), BinaryRepeatParams(1, 1, 0, 8, 8, 0));
  } else {
    Duplicate(u.ReinterpretCast<Z1>(), static_cast<Z1>(0xff001ff8u), count);
    PipeBarrier<PIPE_V>();
    And(den.ReinterpretCast<Z4>(), den.ReinterpretCast<Z4>(), u.ReinterpretCast<Z4>(), 2 * count);
  }
  PipeBarrier<PIPE_V>();
  CompareScalar(mask, den, 2.0009765625f, CMPMODE::EQ, count);
  PipeBarrier<PIPE_V>();
  const Z0 words = count / 32, roundedWords = (words + 63) / 64 * 64;
  if constexpr (!PrefetchDuringRepair) {
    Duplicate(u, 0.0f, roundedWords);
    PipeBarrier<PIPE_V>();
  }
  Cast(u, mask.ReinterpretCast<Z1>(), RoundMode::CAST_RINT, words);
  PipeBarrier<PIPE_V>();
  auto active = vectors_.Get<Z6>()[SP * 20 + 32 + 448 * 4 + 2 * MASK_BYTES];
  CompareScalar(active, u, 0.0f, CMPMODE::NE, roundedWords);
  if constexpr (PrefetchDuringRepair) {
    if (followingReady >= 0)
      CrossCoreWaitFlag(followingReady);
    if (nextRows) {
      WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
      GlobalTensor<Z1> source;
      source.SetGlobalBuffer(reinterpret_cast<__gm__ Z1 *>(nextInput));
      DataCopyExtParams cp{static_cast<Z4>(nextRows), width * 4, (pitch - width) * 4, (vc - ((width + 7) / 8) * 8) / 8,
                           0};
      DataCopyPadExtParams<Z1> pad{true, 0, static_cast<Z6>((8 - width % 8) % 8), 0};
      DataCopyPad(ci, source, cp, pad);
    }
  }
  Fence<HardEvent::V_S>();
  for (Z0 page = 0; page < (words + 31) / 32; ++page) {
    Z0 pages = active.ReinterpretCast<Z0>().GetValue(page);
    if (words - page * 32 < 32)
      pages &= (1U << (words - page * 32)) - 1;
    while (pages) {
      const Z0 block = page * 32 + __builtin_ctz(pages);
      Z0 hits = mask.ReinterpretCast<Z0>().GetValue(block);
      while (hits) {
        const Z0 index = block * 32 + __builtin_ctz(hits);
        Z8 value = z.GetValue(index);
        if (value >= 1.0f && value < 8.0f) {
          result.SetValue(index, PositiveMidpoint(value, result.ReinterpretCast<Z0>().GetValue(index)));
        }
        hits &= hits - 1;
      }
      pages &= pages - 1;
    }
  }
  Fence<HardEvent::S_V>();
  if (pendingStore)
    WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
  Cast(out, result, RoundMode::CAST_RINT, count);
  Fence<HardEvent::V_MTE3>();
}
template <bool PrefetchDuringRepair = false> class CheckedFinish {
  TBuf<TPosition::VECCALC> panel_;
  GlobalTensor<Z8> scales_;
  GlobalTensor<half> output_;
  bool pendingInput_ = false, pendingStore_ = false, staged_ = false;
  Z2 channel_ = ~Z2(0);
  Z0 cachedWidth_ = 0;

public:
  __aicore__ inline void Init(TPipe &pipe, GM_ADDR scale, GM_ADDR y, Z0 extra = 0) {
    pipe.InitBuffer(panel_, VectorBytes + extra);
    Duplicate(panel_.Get<Z1>()[4 * VectorStride + 8], Z1(0), dense::PE);
    Duplicate(panel_.Get<Z8>()[5 * VectorStride + 8], 0.0f, 448);
    Fence<HardEvent::V_MTE2>();
    if constexpr (PrefetchDuringRepair) {
      auto constants = panel_.Get<Z1>()[dense::PE];
      Duplicate(constants, static_cast<Z1>(0xff001ff8u), 8);
      Duplicate(constants[8], static_cast<Z1>(0xff801f00u), 8);
      PipeBarrier<PIPE_V>();
    }
    scales_.SetGlobalBuffer(reinterpret_cast<__gm__ Z8 *>(scale));
    output_.SetGlobalBuffer(reinterpret_cast<__gm__ half *>(y));
  }
  template <Z0 VC, Z0 storageWidth, class Parameters>
  __aicore__ inline void Run(const Parameters &p, const gmg::GeneralTask &task, GM_ADDR slot, Z0 pitch, int sig,
                             Z0 nextPart = 0, Z0 offsetRows = 0, GM_ADDR followingFrame = nullptr, Z0 followingRows = 0,
                             int followingReady = -1) {
    const Z0 halfRows = (task.vm + 1) / 2;
    const Z0 first = GetSubBlockIdx() * halfRows;
    if (first >= task.vm) {
      if (sig >= 0)
        CrossCoreSetFlag<2, PIPE_MTE2>(sig);
      if (followingReady >= 0)
        CrossCoreWaitFlag(followingReady);
      return;
    }
    const Z0 rows = gmg::Min(halfRows, task.vm - first);
    const Z0 width = task.vn;
    if (pendingInput_) {
      WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
      pendingInput_ = false;
    }
    auto ci = panel_.Get<Z1>()[4 * VectorStride + 8];
    auto scale = panel_.Get<Z8>()[5 * VectorStride + 8];
    auto out = panel_.Get<half>()[OutputOffset / 2];
    GlobalTensor<Z1> c;
    c.SetGlobalBuffer(reinterpret_cast<__gm__ Z1 *>(slot));
    const Z0 vc = (width + 15) / 16 * 16;
    DataCopyExtParams cp{static_cast<Z4>(rows), width * 4, (pitch - width) * 4, (vc - ((width + 7) / 8) * 8) / 8, 0};
    DataCopyPadExtParams<Z1> ip{true, 0, static_cast<Z6>((8 - width % 8) % 8), 0};
    if (!PrefetchDuringRepair || !staged_)
      DataCopyPad(ci, c[first * pitch], cp, ip);
    if (sig >= 0)
      CrossCoreSetFlag<2, PIPE_MTE2>(sig);
    DataCopyExtParams sp{1, width * 4, 0, 0, 0};
    DataCopyPadExtParams<Z8> fp{true, 0, static_cast<Z6>((8 - width % 8) % 8), 0};
    const Z2 channel = static_cast<Z2>(task.expert) * p.n + task.col;
    if (channel_ != channel || cachedWidth_ != width) {
      DataCopyPad(scale, scales_[channel], sp, fp);
      channel_ = channel;
      cachedWidth_ = width;
    }
    Fence<HardEvent::MTE2_V>();
    const Z0 nextCount = followingFrame ? followingRows : nextPart;
    const Z0 nextHalf = (nextCount + 1) / 2, nextFirst = GetSubBlockIdx() * nextHalf;
    const Z0 nextRows = PrefetchDuringRepair && nextFirst < nextCount ? gmg::Min(nextHalf, nextCount - nextFirst) : 0;
    Gelu<dense::PE, VC, PrefetchDuringRepair>(ci, scale, panel_, rows, vc, pendingStore_,
                                              nextRows
                                                  ? (followingFrame ? followingFrame + Z2(nextFirst) * pitch * 4
                                                                    : slot + Z2(offsetRows + nextFirst) * pitch * 4)
                                                  : nullptr,
                                              nextRows, width, pitch, followingReady);
    staged_ = nextRows > 0;
    pendingInput_ = !staged_;
    DataCopyExtParams yp{static_cast<Z4>(rows), width * 2, (vc - ((width + 15) / 16) * 16) / 16, (p.n - width) * 2, 0};
    DataCopyPad(output_[static_cast<Z2>(task.row + first) * p.n + task.col], out, yp);
    SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
    pendingStore_ = true;
  }
  __aicore__ inline void Drain() {
    if (pendingInput_)
      WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
    if (pendingStore_)
      WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
  }
};
using Finish = CheckedFinish<true>;
template <Z0 RowCap> class StripCursor {
  const __gm__ Z3 *ends_;
  bool useStrips_ = false, reorder_ = false, longTurn_ = true;
  bool taller_ = false, foldTail_ = false;
  Z0 mean_ = 0, shortIndex_ = 0, longIndex_ = 0, sequential_ = 0;
  Z0 bandCol_ = 0, bandWidth_ = 0, previous_ = 0;
  Z0 experts_, rows_, columns_, strips_, limit_, setup_;
  Z0 expert_ = 0, row_ = 0, rowsHere_ = 0, strip_ = 0, stop_ = 0;
  Z2 cost_ = 0, begin_, end_;
  __aicore__ inline Z0 Cut(Z2 edge, Z0 unit) {
    return edge <= cost_ ? 0 : static_cast<Z0>(Min(strips_, static_cast<Z0>((edge - cost_ + unit / 2) / unit)));
  }

public:
  __aicore__ inline void Init(const edge::Parameters &p, GM_ADDR g, Z0 worker, Z0 limit, Z0 setup, Z0 bandCol,
                              Z0 bandWidth, Z0 team, Z0 teams, bool columnsOnly) {
    ends_ = reinterpret_cast<const __gm__ Z3 *>(g);
    experts_ = p.e;
    rows_ = p.m;
    columns_ = p.n;
    strips_ = (p.n + 63) / 64;
    limit_ = limit / 2;
    setup_ = setup;
    bandCol_ = bandCol;
    bandWidth_ = bandWidth;
    Z0 last = 0, active = 0, longest = 0, shortest = p.m;
    Z2 range = 0;
    bool previousShort = false, clustered = false;
    Z0 saved = 0;
    for (Z0 e = 0; e < experts_; ++e) {
      Z0 end = ends_[e], length = end - last;
      last = end;
      if (length) {
        const bool shortExpert = length <= RowCap / 8;
        clustered = clustered || (previousShort && shortExpert);
        previousShort = shortExpert;
        saved += (length + 79) / 80 - (length + 95) / 96;
        ++active;
        range += StripCost(length);
        if (length > longest)
          longest = length;
        if (length < shortest)
          shortest = length;
      }
    }
    taller_ = active && longest <= RowCap && longest - shortest <= 16 && 4 * saved >= active;
    foldTail_ = taller_ || (clustered && longest <= RowCap && longest > shortest + RowCap / 4);
    if (foldTail_)
      strips_ = p.n / 64;
    useStrips_ = (columnsOnly || longest <= RowCap) && limit_ > 0;
    mean_ = active ? rows_ / active : 0;
    reorder_ = useStrips_ && clustered && longest > shortest + RowCap / 4;
    if (useStrips_) {
      const Z2 total = static_cast<Z2>(strips_) * range;
      begin_ = total * worker / p.workers;
      end_ = total * (worker + 1) / p.workers;
    } else {
      const Z2 total = rows_ + static_cast<Z2>(active) * setup_;
      begin_ = total * team / teams;
      end_ = total * (team + 1) / teams;
    }
  }
  __aicore__ inline Z0 StripCost(Z0 rows) {
    return 2 * setup_ + ((rows + 15) / 16) * 16 + ((rows + 79) / 80) * 32;
  }
  __aicore__ inline bool Taller() const {
    return taller_;
  }
  __aicore__ inline bool UsesStrips() const {
    return useStrips_;
  }
  __aicore__ inline bool NextBand(gmg::GeneralTask &t) {
    while (expert_ < experts_ && cost_ < end_) {
      const Z0 e = expert_++, last = ends_[e], length = last - previous_, start = previous_;
      previous_ = last;
      if (!length)
        continue;
      const Z2 first = cost_ + setup_;
      cost_ = first + length;
      if (cost_ <= begin_ || first >= end_)
        continue;
      const Z0 offset = begin_ > first ? static_cast<Z0>(begin_ - first) : 0;
      t.row = start + offset;
      t.vm = Min(length, static_cast<Z0>(end_ - first)) - offset;
      t.expert = e;
      t.col = bandCol_;
      t.vn = bandWidth_;
      return true;
    }
    return false;
  }
  __aicore__ inline Z0 NextExpert(bool large) {
    Z0 &index = large ? longIndex_ : shortIndex_;
    while (index < experts_) {
      Z0 e = index++;
      Z0 begin = e ? ends_[e - 1] : 0, len = static_cast<Z0>(ends_[e]) - begin;
      if (len && ((len > mean_) == large))
        return e;
    }
    return experts_;
  }
  __aicore__ inline bool Next(gmg::GeneralTask &t) {
    if (!useStrips_)
      return NextBand(t);
    while (strip_ >= stop_) {
      if (cost_ >= end_)
        return false;
      if (reorder_) {
        expert_ = NextExpert(longTurn_);
        if (expert_ == experts_)
          expert_ = NextExpert(!longTurn_);
        longTurn_ = !longTurn_;
      } else
        expert_ = sequential_++;
      if (expert_ >= experts_)
        return false;
      row_ = expert_ ? ends_[expert_ - 1] : 0;
      rowsHere_ = static_cast<Z0>(ends_[expert_]) - row_;
      if (!rowsHere_)
        continue;
      Z0 unit = StripCost(rowsHere_);
      strip_ = Cut(begin_, unit);
      stop_ = Cut(end_, unit);
      cost_ += static_cast<Z2>(unit) * strips_;
    }
    const Z0 remaining = stop_ - strip_,
             count = (remaining + limit_ - 1 + (foldTail_ && stop_ == strips_ && columns_ % 64 != 0)) / limit_;
    const Z0 take = (remaining + count - 1) / count;
    t.row = row_;
    t.vm = rowsHere_;
    t.col = strip_ * 64;
    t.vn = foldTail_ ? take * 64 + (strip_ + take == strips_ ? columns_ % 64 : 0) : Min(columns_ - t.col, take * 64);
    t.expert = expert_;
    strip_ += take;
    return true;
  }
};
template <Z0 BM, Z0 BK, bool Prefix = false> class RotatingBandCube {
  Z0 groupedDepth_ = BK;
  TQue<TPosition::A1, 1> a1_;
  TQue<TPosition::B1, Prefix ? 2 : 1> b1_;
  TQue<TPosition::B1, 1> tailQ_;
  LocalTensor<Z7> tail_, last_;
  TQue<TPosition::B1, 1> lastQ_;
  Z0 firstTail_ = 0, storageRows_ = BM;
  bool hasLast_ = false, issueLast_ = false, waitLast_ = false;
  Z0 head_ = 0, headBytes_ = 0, activeHead_ = 0;
  bool prefetched_ = false, hasTail_ = false;
  bool prepareTail_ = false, awaitTail_ = false;
  GlobalTensor<Z7> tailSource_;
  LocalTensor<Z7> resident_;
  TQue<TPosition::A2, 2> a2_;
  TQue<TPosition::B2, 2> b2_;
  TQue<TPosition::CO1, 1> c1_;
  Z0 shift_ = 0;

public:
  __aicore__ inline void SetPhase(Z0 worker, Z0 k) {
    const Z0 stride = (k + 31) / 32 * 32;
    const Z0 cut = (stride / BK) * (worker % 4) / 4 * BK;
    shift_ = cut ? stride - cut : 0;
  }
  __aicore__ inline void Init(TPipe &pipe, Z0 k, Z0 columns, Z2 l1 = 0, bool moreThanOne = true, Z0 storageRows = BM) {
    storageRows_ = storageRows;
    const Z0 paddedK = (k + 31) / 32 * 32;
    pipe.InitBuffer(a1_, 1, paddedK * storageRows_);
    head_ = paddedK;
    if constexpr (Prefix) {
      Z0 extra = (l1 - paddedK * storageRows_) / columns - paddedK;
      if (moreThanOne)
        head_ = extra >= paddedK ? paddedK : extra / BK * BK;
      else
        head_ = Min(paddedK, 2 * BK);
    }
    headBytes_ = head_ * columns;
    pipe.InitBuffer(b1_, Prefix && moreThanOne ? 2 : 1, head_ * columns);
    if (Prefix && paddedK > head_) {
      const Z0 rest = paddedK - head_;
      firstTail_ = Min(rest, ((rest / 2 + BK - 1) / BK) * BK);
      pipe.InitBuffer(tailQ_, 1, firstTail_ * columns);
      if (rest > firstTail_)
        pipe.InitBuffer(lastQ_, 1, (rest - firstTail_) * columns);
    }
    groupedDepth_ = columns <= 256 ? 128 : 64;
    pipe.InitBuffer(a2_, 2, groupedDepth_ * storageRows_);
    pipe.InitBuffer(b2_, 2, groupedDepth_ * columns);
    pipe.InitBuffer(c1_, 1, 2 * dense::C_BYTES);
  }
  __aicore__ inline void CopyPart(LocalTensor<Z7> bb, const edge::Parameters &p, const gmg::GeneralTask &t,
                                  GlobalTensor<Z7> b, Z0 logical, Z0 offset, Z0 src, Z0 rows, Z0 pitch) {
    Z0 valid = src < p.k ? Min(rows, p.k - src) : 0;
    if (valid) {
      GlobalTensor<Z7> input;
      input.SetGlobalBuffer(const_cast<__gm__ Z7 *>(b.GetPhyAddr()) + (static_cast<Z3>(src) - logical) * p.n);
      DataCopy(bb[offset * 32], input, Nd2NzParams(1, valid, t.vn, 0, p.n, pitch, 1, 0));
    }
    if (valid < rows) {
      Z0 zeros = rows - valid;
      InitConstValue(bb[(offset + valid) * 32].ReinterpretCast<Z0>(),
                     InitConstValueParams<Z0>((t.vn + 31) / 32, zeros, pitch - zeros, 0));
    }
  }
  __aicore__ inline void LoadPiece(LocalTensor<Z7> bb, const edge::Parameters &p, const gmg::GeneralTask &t,
                                   GlobalTensor<Z7> b, Z0 span, Z0 logical) {
    const Z0 pitch = (span + 31) / 32 * 32, stride = (p.k + 31) / 32 * 32;
    if (t.vn % 32) {
      InitConstValue(bb[((t.vn + 31) / 32 - 1) * pitch * 32].ReinterpretCast<Z0>(),
                     InitConstValueParams<Z0>(1, pitch, 0, 0));
      PipeBarrier<PIPE_MTE2>();
    }
    Z0 src = logical + shift_;
    if (src >= stride)
      src -= stride;
    const Z0 first = Min(span, stride - src);
    CopyPart(bb, p, t, b, logical, 0, src, first, pitch);
    if (first < span)
      CopyPart(bb, p, t, b, logical, first, 0, span - first, pitch);
  }
  __aicore__ inline Z0 HeadFor(const gmg::GeneralTask &t, Z0 span) const {
    Z0 cap = headBytes_ / ((t.vn + 31) / 32 * 32), full = (span + 31) / 32 * 32;
    return cap >= full ? full : cap / BK * BK;
  }
  __aicore__ inline void StageHead(const edge::Parameters &p, const gmg::GeneralTask &t, GlobalTensor<Z7> b, Z0 span) {
    LocalTensor<Z7> bb = b1_.template AllocTensor<Z7>();
    LoadPiece(bb, p, t, b, Min(HeadFor(t, span), span), 0);
    b1_.EnQue(bb);
  }
  __aicore__ inline void BeginB(const edge::Parameters &p, const gmg::GeneralTask &t, GlobalTensor<Z7> b, Z0 span) {
    activeHead_ = HeadFor(t, span);
    if (!prefetched_)
      StageHead(p, t, b, span);
    prefetched_ = false;
    resident_ = b1_.template DeQue<Z7>();
    if constexpr (Prefix) {
      hasTail_ = span > activeHead_;
      if (hasTail_) {
        tailSource_ = b[static_cast<Z2>(activeHead_) * p.n];
        prepareTail_ = true;
      }
    }
  }
  __aicore__ inline void EndB() {
    b1_.FreeTensor(resident_);
    if (Prefix && hasTail_) {
      tailQ_.FreeTensor(tail_);
      if (hasLast_)
        lastQ_.FreeTensor(last_);
    }
  }
  __aicore__ inline void QueueLast(const edge::Parameters &p, const gmg::GeneralTask &t, Z0 span) {
    auto last = lastQ_.AllocTensor<Z7>();
    LoadPiece(last, p, t, tailSource_[static_cast<Z2>(firstTail_) * p.n], span - activeHead_ - firstTail_,
              activeHead_ + firstTail_);
    lastQ_.EnQue(last);
    issueLast_ = false;
    waitLast_ = true;
  }
  __aicore__ inline void LoadMergedB(LocalTensor<Z7> b2, LocalTensor<Z7> bpanel, const edge::Parameters &p,
                                     const gmg::GeneralTask &t, Z0 kk, Z0 depth, Z0 stride, Z0 span, Z0 cols) {
    Z0 done = 0;
    while (done < depth) {
      Z0 logical = kk + done, offset = logical, pitchB = stride, finish = stride;
      auto bb = bpanel;
      if constexpr (Prefix) {
        pitchB = activeHead_;
        finish = activeHead_;
        if (logical >= activeHead_ + firstTail_ && logical >= activeHead_) {
          if (waitLast_) {
            last_ = lastQ_.DeQue<Z7>();
            waitLast_ = false;
          }
          bb = last_;
          pitchB = stride - activeHead_ - firstTail_;
          offset = logical - activeHead_ - firstTail_;
          finish = stride;
        } else if (logical >= activeHead_) {
          if (awaitTail_) {
            tail_ = tailQ_.DeQue<Z7>();
            awaitTail_ = false;
          }
          if (issueLast_)
            QueueLast(p, t, span);
          bb = tail_;
          pitchB = Min(firstTail_, stride - activeHead_);
          offset = logical - activeHead_;
          finish = activeHead_ + pitchB;
        }
      }
      Z0 amount = Min(depth - done, finish - logical);
      LoadData2dTransposeParams bp{0, static_cast<Z6>(cols / 32), static_cast<Z4>(pitchB / 32), 1, 0, inc};
      for (Z0 kb = 0; kb < amount; kb += 32)
        LoadDataWithTranspose(b2[(done + kb) * cols], bb[(offset + kb) * 32], bp);
      done += amount;
    }
  }
  template <bool guardSmall = false>
  __aicore__ inline void Run(const edge::Parameters &p, const gmg::GeneralTask &t, GlobalTensor<Z7> a,
                             GlobalTensor<Z1> c, Z0 span, Z0 pitch, GM_ADDR upcoming = nullptr,
                             const gmg::GeneralTask *upcomingTask = nullptr, int reuse = -1) {
    const Z0 rows = (t.vm + 15) / 16 * 16;
    Z6 padding[4] = {};
    Load3DSetFMatrixCal(1, storageRows_, padding);
    auto accum = c1_.AllocTensor<Z1>();
    auto aa = a1_.AllocTensor<Z7>();
    DataCopy(aa, a, Nd2NzParams(1, t.vm, p.k, 0, p.k, storageRows_, 1, 0));
    a1_.EnQue(aa);
    if constexpr (Prefix) {
      if (prepareTail_) {
        auto tb = tailQ_.AllocTensor<Z7>();
        LoadPiece(tb, p, t, tailSource_, Min(firstTail_, span - activeHead_), activeHead_);
        tailQ_.EnQue(tb);
        prepareTail_ = false;
        awaitTail_ = true;
        hasLast_ = span > activeHead_ + firstTail_;
        issueLast_ = hasLast_;
      }
    }
    if constexpr (Prefix) {
      if (upcoming) {
        GlobalTensor<Z7> next;
        next.SetGlobalBuffer(reinterpret_cast<__gm__ Z7 *>(upcoming));
        StageHead(p, upcomingTask ? *upcomingTask : t, next, span);
        prefetched_ = true;
      }
    }
    {
      const Z0 stride = (span + 31) / 32 * 32;
      auto apanel = a1_.DeQue<Z7>();
      auto bpanel = resident_;
      for (Z0 kk = 0; kk < span;) {
        const Z0 cut = shift_ ? stride - shift_ : stride;
        const Z0 depth = Min(groupedDepth_, Min(stride - kk, kk < cut ? cut - kk : stride - kk));
        auto a2 = a2_.AllocTensor<Z7>();
        LoadData3DParamsV2Pro ap;
        ap.channelSize = stride;
        const Z0 physical = kk + shift_ < stride ? kk + shift_ : kk + shift_ - stride;
        ap.extConfig = (static_cast<Z2>(physical) << 32) | (static_cast<Z2>(rows) << 16) | depth;
        LoadData(a2, apanel, ap);
        a2_.EnQue(a2);
        auto ar = a2_.DeQue<Z7>();
        {
          const Z0 cols = (t.vn + 31) / 32 * 32;
          auto b2 = b2_.AllocTensor<Z7>();
          LoadMergedB(b2, bpanel, p, t, kk, depth, stride, span, cols);
          b2_.EnQue(b2);
          auto br = b2_.DeQue<Z7>();
          MmadParams mp;
          mp.m = rows;
          mp.n = cols;
          mp.k = depth;
          mp.isBias = false;
          mp.cmatrixInitVal = (kk == 0);
          Mmad(accum, ar, br, mp);
          if (guardSmall && rows * cols <= 16 * 16 * 16 && kk + depth < span)
            PipeBarrier<PIPE_M>();
          b2_.FreeTensor(br);
        }
        a2_.FreeTensor(ar);
        kk += depth;
      }
      a1_.FreeTensor(apanel);
    }
    c1_.EnQue(accum);
    auto result = c1_.DeQue<Z1>();
    {
      FixpipeParamsV220 fp;
      fp.nSize = static_cast<Z4>((t.vn + 31) / 32 * 32);
      fp.mSize = t.vm;
      fp.srcStride = rows;
      fp.dstStride = pitch;
      fp.quantPre = QuantMode_t::NoQuant;
      fp.reluEn = false;
      if constexpr (guardSmall) {
        if (reuse >= 0)
          CrossCoreWaitFlag(dense::FREE + reuse * 3);
      }
      Fixpipe<Z1, Z1, CFG_ROW_MAJOR>(c, result, fp);
    }
    c1_.FreeTensor(result);
  }
};
template <Z0 BM, Z0 BK, Z0 Target>
__global__ __mix__(1, 2) void PhasedBandsKernel(GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR g, GM_ADDR y, GM_ADDR ws,
                                                Z2 l1) {
  edge::Parameters p;
  auto config = reinterpret_cast<__gm__ Z0 *>(ws);
  p.m = config[0];
  p.n = config[1];
  p.k = config[2];
  p.e = config[3];
  p.workers = config[4];
  Z0 worker = GetBlockIdx();
  if ASCEND_IS_AIV {
    worker /= 2;
  }
  const Z0 columns = (p.n + Target - 1) / Target;
  const Z0 strips = (p.n + 31) / 32;
  const Z0 originalLimit = (strips * ((p.workers + columns - 1) / columns) + p.workers - 1) / p.workers;
  const bool columnsOnly =
      columns > p.workers || originalLimit * 32 > 384 || strips * (p.workers / columns) < p.workers;
  const Z0 limit = columnsOnly ? 8 : originalLimit;
  const Z0 col = worker % columns, team = worker / columns;
  const Z0 teams = (p.workers + columns - 1 - col) / columns;
  const Z0 before = col * (p.workers / columns) + Min(col, p.workers % columns);
  const Z0 bandCol = (before * strips / p.workers) * 32;
  const Z0 bandWidth = Min(p.n, ((before + teams) * strips / p.workers) * 32) - bandCol;
  StripCursor<4 * 80> cursor;
  cursor.Init(p, g, worker, limit, ((p.k + 9) / 10 + 15) / 16 * 16, bandCol, bandWidth, team, teams, columnsOnly);
  TPipe pipe;
  RotatingBandCube<BM, BK, true> cube;
  Finish finish;
  Z0 padded = (p.k + 31) / 32 * 32;
  const bool tall = cursor.Taller() && Z2(padded) * (96 + limit * 32) <= l1;
  const Z0 storage = tall ? 96 : 80;
  bool ahead = false;
  if ASCEND_IS_AIC {
    auto plan = cursor;
    gmg::GeneralTask assigned;
    Z0 widest = 0, count = 0;
    while (plan.Next(assigned)) {
      Z0 pitch = (assigned.vn + 31) / 32 * 32;
      if (pitch > widest)
        widest = pitch;
      ++count;
    }
    cube.SetPhase(worker, p.k);
    ahead = count > 1 && Z2(padded) * (storage + widest) + BK * widest <= l1;
    if (count)
      cube.Init(pipe, p.k, widest, l1, ahead, storage);
  }
  if ASCEND_IS_AIV {
    finish.Init(pipe, s, y);
  }
  GM_ADDR slots = ws + (sizeof(p) + 511) / 512 * 512 + worker * 4ULL * dense::C_BYTES;
  Z0 ordinal = 0;
  bool prefetchedFrame = false;
  gmg::GeneralTask slab, next;
  bool valid = cursor.Next(slab);
  while (valid) {
    bool more = cursor.Next(next);
    const Z0 pitch = (slab.vn + 31) / 32 * 32;
    GM_ADDR upcoming = nullptr;
    if ASCEND_IS_AIC {
      GlobalTensor<Z7> weights;
      weights.SetGlobalBuffer(reinterpret_cast<__gm__ Z7 *>(w) + static_cast<Z2>(slab.expert) * p.k * p.n + slab.col);
      cube.BeginB(p, slab, weights, (p.k + 31) / 32 * 32);
      if (more && ahead)
        upcoming = w + static_cast<Z2>(next.expert) * p.k * p.n + next.col;
    }
    const Z0 stop = slab.row + slab.vm;
    const Z0 height = Min(storage, (2 * dense::C_BYTES / (4 * pitch)) / 16 * 16);
    for (Z0 row = slab.row; row < stop; row += height, ++ordinal) {
      auto t = slab;
      t.row = row;
      t.vm = Min(height, stop - row);
      const Z0 index = ordinal % 2;
      GM_ADDR slot = slots + index * 2 * dense::C_BYTES;
      if ASCEND_IS_AIC {
        GlobalTensor<Z7> a;
        GlobalTensor<Z1> c;
        a.SetGlobalBuffer(reinterpret_cast<__gm__ Z7 *>(x) + static_cast<Z2>(row) * p.k);
        c.SetGlobalBuffer(reinterpret_cast<__gm__ Z1 *>(slot));
        cube.template Run<true>(p, t, a, c, (p.k + 31) / 32 * 32, pitch,
                                ((tall || !cursor.UsesStrips()) ? row == slab.row : row + height >= stop) ? upcoming
                                                                                                          : nullptr,
                                &next, ordinal >= 2 ? static_cast<int>(index) : -1);
        CrossCoreSetFlag<2, PIPE_FIX>(dense::READY + index * 3);
      }
      if ASCEND_IS_AIV {
        if (!prefetchedFrame)
          CrossCoreWaitFlag(dense::READY + index * 3);
        prefetchedFrame = false;
        const Z0 vc = (t.vn + 15) / 16 * 16;
        const Z0 step = 2 * (dense::PE / vc);
        for (Z0 i = 0; i < t.vm; i += step) {
          auto part = t;
          part.row += i;
          part.vm = Min(step, t.vm - i);
          GM_ADDR source = slot + static_cast<Z2>(i) * pitch * 4;
          bool following = i + step >= t.vm && row + height < stop;
          GM_ADDR nextFrame = following ? slots + Z2(index ^ 1) * 2 * dense::C_BYTES : nullptr;
          Z0 followingCount = following ? Min(step, Min(height, stop - row - height)) : 0;
          finish.Run<448, 448>(p, part, source, pitch, i + step >= t.vm ? int(dense::FREE + index * 3) : -1,
                               i + step < t.vm ? Min(step, t.vm - i - step) : 0, step, nextFrame, followingCount,
                               following ? int(dense::READY + (index ^ 1) * 3) : -1);
          if (following)
            prefetchedFrame = true;
        }
      }
    }
    if ASCEND_IS_AIC {
      cube.EndB();
    }
    valid = more;
    if (more)
      slab = next;
  }
  if ASCEND_IS_AIV {
    finish.Drain();
  }
  if ASCEND_IS_AIC {
    if (ordinal)
      CrossCoreWaitFlag(dense::FREE);
    if (ordinal > 1)
      CrossCoreWaitFlag(dense::FREE + 3);
  }
}
} // namespace hcBand
namespace hcBand {
static void Launch(GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR g, GM_ADDR y, GM_ADDR ws, Z0 workers, Z2 l1,
                   aclrtStream stream) {
  PhasedBandsKernel<96, 64, 384><<<workers, nullptr, stream>>>(x, w, s, g, y, ws, l1);
}
} // namespace hcBand
namespace tallExperts {
using namespace AscendC;
using gmg::Min;
struct RowSlice {
  const __gm__ Z3 *ends;
  Z0 experts, setup, begin, end, col, width;
  Z0 expert = 0, row = 0, cost = 0;
  __aicore__ inline bool Next(gmg::GeneralTask &task) {
    while (expert < experts && cost < end) {
      Z0 index = expert++, start = row;
      row = static_cast<Z0>(ends[index]);
      Z0 length = row - start;
      if (!length)
        continue;
      const Z0 first = cost + setup;
      cost = first + length;
      if (cost <= begin || first >= end)
        continue;
      const Z0 offset = begin > first ? begin - first : 0;
      task.expert = index;
      task.row = start + offset;
      task.vm = Min(length, end - first) - offset;
      task.col = col;
      task.vn = width;
      return true;
    }
    return false;
  }
};
struct Config {
  Z0 m, n, k, e, workers, columns, capacity;
};
template <Z0 BM, Z0 BK>
__global__ __mix__(1, 2) void RowBandsKernel(GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR g, GM_ADDR y, GM_ADDR ws, Z2 l1) {
  edge::Parameters p;
  const auto cfg = reinterpret_cast<const __gm__ Config *>(ws);
  p.m = cfg->m;
  p.n = cfg->n;
  p.k = cfg->k;
  p.e = cfg->e;
  p.workers = cfg->workers;
  const Z0 columns = cfg->columns, strips = p.n / 32;
  Z0 worker = GetBlockIdx();
  if ASCEND_IS_AIV {
    worker /= 2;
  }
  const auto ends = reinterpret_cast<const __gm__ Z3 *>(g);
  Z0 active = 0, previous = 0;
  for (Z0 e = 0; e < p.e; ++e) {
    const Z0 stop = ends[e];
    active += stop > previous;
    previous = stop;
  }
  const Z0 setup = ((p.k + 9) / 10 + 15) / 16 * 16;
  const Z0 total = p.m + active * setup, alignedK = (p.k + 31) / 32 * 32;
  Z0 capacity = cfg->capacity;
  if (p.workers >= columns) {
    const Z0 g = worker % columns;
    const Z0 before = g * (p.workers / columns) + Min(g, p.workers % columns);
    const Z0 lanes = (p.workers + columns - 1 - g) / columns;
    Z0 col = (before * strips + p.workers / 2) / p.workers * 32;
    Z0 right = g + 1 == columns ? p.n : ((before + lanes) * strips + p.workers / 2) / p.workers * 32;
    capacity = (right - col + 31) / 32 * 32;
  }
  const Z0 budget = Z0((l1 - Z2(alignedK) * capacity) / alignedK) / 16 * 16;
  const Z0 storage = Min(BM, Min(budget, 2 * dense::C_BYTES / (4 * capacity) / 16 * 16));
  const bool ahead = Z2(alignedK) * (storage + capacity) + BK * capacity <= l1;
  TPipe pipe;
  hcBand::RotatingBandCube<BM, BK, true> cube;
  hcBand::CheckedFinish<true> finish;
  if ASCEND_IS_AIC {
    cube.SetPhase(worker, p.k);
    cube.Init(pipe, p.k, capacity, l1, ahead, storage);
  }
  if ASCEND_IS_AIV {
    finish.Init(pipe, s, y);
  }
  Z0 ordinal = 0;
  GM_ADDR slots = ws + 512 + worker * 4ULL * dense::C_BYTES;
  for (Z0 group = worker % columns; group < columns; group += p.workers) {
    Z0 teams = (p.workers + columns - 1 - group) / columns, rank = worker / columns;
    Z0 denom = p.workers, before = group * (p.workers / columns) + Min(group, p.workers % columns);
    if (p.workers < columns) {
      teams = 1;
      denom = columns;
      before = group;
    }
    Z0 col = (before * strips + denom / 2) / denom * 32;
    Z0 right = group + 1 == columns ? p.n : ((before + teams) * strips + denom / 2) / denom * 32;
    RowSlice cursor{ends, p.e, setup, total * rank / teams, total * (rank + 1) / teams, col, right - col};
    gmg::GeneralTask slab, next;
    bool valid = cursor.Next(slab);
    while (valid) {
      bool more = cursor.Next(next);
      const Z0 pitch = (slab.vn + 31) / 32 * 32, stop = slab.row + slab.vm;
      GM_ADDR upcoming = nullptr;
      if ASCEND_IS_AIC {
        GlobalTensor<Z7> weights;
        weights.SetGlobalBuffer(reinterpret_cast<__gm__ Z7 *>(w) + Z2(slab.expert) * p.k * p.n + slab.col);
        cube.BeginB(p, slab, weights, alignedK);
        if (more && ahead)
          upcoming = w + Z2(next.expert) * p.k * p.n + next.col;
      }
      for (Z0 row = slab.row; row < stop; row += storage, ++ordinal) {
        auto t = slab;
        t.row = row;
        t.vm = Min(storage, stop - row);
        const Z0 idx = ordinal % 2;
        GM_ADDR slot = slots + idx * 2 * dense::C_BYTES;
        if ASCEND_IS_AIC {
          GlobalTensor<Z7> a;
          GlobalTensor<Z1> c;
          a.SetGlobalBuffer(reinterpret_cast<__gm__ Z7 *>(x) + Z2(row) * p.k);
          c.SetGlobalBuffer(reinterpret_cast<__gm__ Z1 *>(slot));
          cube.template Run<true>(p, t, a, c, alignedK, pitch, row == slab.row ? upcoming : nullptr, &next,
                                  ordinal >= 2 ? int(idx) : -1);
          CrossCoreSetFlag<2, PIPE_FIX>(dense::READY + idx * 3);
        }
        if ASCEND_IS_AIV {
          CrossCoreWaitFlag(dense::READY + idx * 3);
          Z0 step = 2 * (dense::PE / ((t.vn + 15) / 16 * 16));
          for (Z0 off = 0; off < t.vm; off += step) {
            auto part = t;
            part.row += off;
            part.vm = Min(step, t.vm - off);
            finish.Run<448, 448>(p, part, slot + Z2(off) * pitch * 4, pitch,
                                 off + step >= t.vm ? int(dense::FREE + idx * 3) : -1,
                                 off + step < t.vm ? Min(step, t.vm - off - step) : 0, step);
          }
        }
      }
      if ASCEND_IS_AIC {
        cube.EndB();
      }
      valid = more;
      if (more)
        slab = next;
    }
  }
  if ASCEND_IS_AIV {
    finish.Drain();
  }
  if ASCEND_IS_AIC {
    if (ordinal)
      CrossCoreWaitFlag(dense::FREE);
    if (ordinal > 1)
      CrossCoreWaitFlag(dense::FREE + 3);
  }
}
namespace wideRows {
__attribute__((noinline)) static bool TryLaunch(GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR g, GM_ADDR y, Z0 m, Z0 n, Z0 k,
                                                Z0 e, Z0 workers, Z2 l1, Z2 la, Z2 lb, Z2 lc, Z2 ub,
                                                aclrtStream stream);
}
static bool Launch(GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR g, GM_ADDR y, Z3 m, Z3 n, Z3 k, Z3 e, Z3 available,
                   aclrtStream stream) {
  constexpr Z0 BM = 128, BK = 96, Target = 256;
  const Z3 tiles = (n + edge::BN / 2) / edge::BN;
  const Z3 residual = n - tiles * edge::BN;
  if (available <= 0 || e < 1 || tiles != 3 || (k % 32 == 0 && n % edge::BN == 0) || residual < -32 || residual > 32 ||
      m < e * 5 * 80 || k < 2 * edge::BN)
    return false;
  auto platform = platform_ascendc::PlatformAscendCManager::GetInstance();
  if (!platform)
    return false;
  Z0 workers = std::min<Z2>(available, std::min(platform->GetCoreNumAic(), platform->GetCoreNumAiv() / 2));
  if (!workers)
    return false;
  Z2 l1 = 0, la = 0, lb = 0, lc = 0, ub = 0;
  platform->GetCoreMemSize(platform_ascendc::CoreMemType::L1, l1);
  platform->GetCoreMemSize(platform_ascendc::CoreMemType::L0_A, la);
  platform->GetCoreMemSize(platform_ascendc::CoreMemType::L0_B, lb);
  platform->GetCoreMemSize(platform_ascendc::CoreMemType::L0_C, lc);
  platform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ub);
  const bool useWideBands = residual <= 0;
  // Wide columns amortize expert weights; row slices follow the actual group_list.
  if (useWideBands && wideRows::TryLaunch(x, w, s, g, y, Z0(m), Z0(n), Z0(k), Z0(e), workers, l1, la, lb, lc, ub, stream))
    return true;
  const Z0 columns = std::max<Z0>(1, (n + Target / 2) / Target);
  Z0 capacity = 0, denom = std::max(workers, columns), strips = n / 32;
  for (Z0 j = 0; j < columns; ++j) {
    Z0 before = j * (denom / columns) + std::min(j, denom % columns);
    Z0 teams = (denom + columns - 1 - j) / columns;
    Z0 left = (before * strips + denom / 2) / denom * 32;
    Z0 right = j + 1 == columns ? n : ((before + teams) * strips + denom / 2) / denom * 32;
    capacity = std::max(capacity, (right - left + 31) / 32 * 32);
  }
  const Z2 paddedK = (k + 31) / 32 * 32;
  if (useWideBands) {
    const Z0 oldTeams = (n + 383) / 384, stripes = (n + 31) / 32;
    Z0 width = ((stripes * ((workers + oldTeams - 1) / oldTeams) + workers - 1) / workers) * 32;
    if (workers < oldTeams || width > 384 || stripes * (workers / oldTeams) < workers)
      width = 256;
    if (paddedK * (96 + width) > l1 || 2 * 96 * 64 > la || 2 * width * 64 > lb || lc < 2 * dense::C_BYTES ||
        ub < dense::PANEL_BYTES + (448 - edge::BN) * 4)
      return false;
  } else {
    if (capacity > 448 || paddedK * (capacity + 16) > l1 || 2 * BM * BK > la || 2 * capacity * BK > lb ||
        lc < 2 * dense::C_BYTES || ub < dense::PANEL_BYTES + (448 - edge::BN) * 4)
      return false;
  }
  Config p{Z0(m), Z0(n), Z0(k), Z0(e), workers, columns, capacity};
  void *workspace = nullptr;
  Z2 bytes = 512 + 4ULL * workers * dense::C_BYTES;
  if (aclrtMalloc(&workspace, bytes, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS)
    return false;
  if (aclrtMemcpy(workspace, bytes, &p, sizeof(p), ACL_MEMCPY_HOST_TO_DEVICE) != ACL_SUCCESS) {
    aclrtFree(workspace);
    return false;
  }
  if (useWideBands) {
    hcBand::Launch(x, w, s, g, y, (GM_ADDR)workspace, workers, l1, stream);
  } else
    RowBandsKernel<BM, BK><<<workers, nullptr, stream>>>(x, w, s, g, y, (GM_ADDR)workspace, l1);
  if (aclrtSynchronizeStream(stream) == ACL_SUCCESS)
    aclrtFree(workspace);
  return true;
}
} // namespace tallExperts
} // namespace reference_backend
namespace gmg {
bool LaunchHA36Sched(GM_ADDR, GM_ADDR, GM_ADDR, GM_ADDR, GM_ADDR, Z0, Z0, Z0, Z0, Z0, aclrtStream);
}
namespace contest41 {
bool runWide(GM_ADDR, GM_ADDR, GM_ADDR, GM_ADDR, GM_ADDR, uint32_t, uint32_t, uint32_t, aclrtStream);
bool runShort(GM_ADDR, GM_ADDR, GM_ADDR, GM_ADDR, GM_ADDR, uint32_t, uint32_t, uint32_t, aclrtStream);
bool runJoined(GM_ADDR, GM_ADDR, GM_ADDR, GM_ADDR, GM_ADDR, uint32_t, uint32_t, uint32_t, uint32_t, aclrtStream);
bool runLong(GM_ADDR, GM_ADDR, GM_ADDR, GM_ADDR, GM_ADDR, uint32_t, uint32_t, uint32_t, uint32_t, uint32_t,
             aclrtStream);
} // namespace contest41
namespace contest42 {
bool runPair(GM_ADDR, GM_ADDR, GM_ADDR, GM_ADDR, GM_ADDR, uint32_t, uint32_t, uint32_t, aclrtStream);
}
namespace contest45 {
bool launch(GM_ADDR, GM_ADDR, GM_ADDR, GM_ADDR, uint32_t, uint32_t, aclrtStream);
}
namespace extension49 {bool launch(GM_ADDR,GM_ADDR,GM_ADDR,GM_ADDR,GM_ADDR,uint32_t,uint32_t,uint32_t,uint32_t,uint32_t,aclrtStream);}
namespace persistent_rows { bool Launch(GM_ADDR,GM_ADDR,GM_ADDR,GM_ADDR,GM_ADDR,uint32_t,uint32_t,uint32_t,uint32_t,uint32_t,aclrtStream); }
namespace narrow_stream {bool Launch(GM_ADDR,GM_ADDR,GM_ADDR,GM_ADDR,GM_ADDR,uint32_t,uint32_t,uint32_t,uint32_t,uint32_t,aclrtStream);}
extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo &info_x, GM_ADDR weight, const TensorGroupInfo &info_weight,
                           GM_ADDR scale, const TensorGroupInfo &info_scale, GM_ADDR group_list,
                           const TensorGroupInfo &info_group_list, GM_ADDR y, const TensorGroupInfo &info_y,
                           Z3 availableCoreNum, aclrtStream stream) {
  if (info_x.numTensors != 1 || info_weight.numTensors != 1 || info_scale.numTensors != 1 ||
      info_group_list.numTensors != 1 || info_y.numTensors != 1)
    throw std::invalid_argument("GMM expects one tensor per argument");
  const auto &a = info_x.tensors[0], &b = info_weight.tensors[0];
  const auto &s = info_scale.tensors[0], &g = info_group_list.tensors[0];
  const auto &out = info_y.tensors[0];
  if (a.numDims != 2 || b.numDims != 3 || s.numDims != 2 || g.numDims != 1 || out.numDims != 2 || a.dtype != 3 ||
      b.dtype != 3 || s.dtype != 0 || g.dtype != 6 || out.dtype != 1)
    throw std::invalid_argument("GMM rank/dtype mismatch");
  Z3 m = a.shape[0], k = a.shape[1], e = b.shape[0], n = b.shape[2];
  if (m < 1 || m > 65536 || k < 1 || k > 8192 || e < 1 || e > 128 || n < 1 || n > 4096 || b.shape[1] != k ||
      s.shape[0] != e || s.shape[1] != n || g.shape[0] != e || out.shape[0] != m || out.shape[1] != n ||
      availableCoreNum < 1 || e * k * n > 268435456LL ||
      m * k + e * k * n + e * n * 4 + e * 8 + m * n * 2 > 536870912LL)
    throw std::invalid_argument("GMM shape/size mismatch");
  Z0 cores = static_cast<Z0>(availableCoreNum);
  // Select operand layouts, not complete input tuples. Each route consumes the
  // actual row/expert dimensions; group boundaries remain Device-side inputs.
  if(e<=8 && k>1024 && n<=256 && m>=e*256 && narrow_stream::Launch(x,weight,scale,group_list,y,e,m,k,n,cores,stream))return;
  if(e<=8 && m>1024 && ((k>1024 && n<=256 && m>=e*256) || (k>=3 && k<=512)) &&
     persistent_rows::Launch(x,weight,scale,group_list,y,e,m,k,n,cores,stream))return;
  if(e<=8 && m>1024 && k<=512 && extension49::launch(x,weight,scale,group_list,y,e,m,k,n,cores,stream))return;
  if (e == 1 && k == 128 && n == 128 && contest45::launch(x, weight, scale, y, m, cores, stream))
    return;
  if (k == 1024 && n == 1024 && e <= 8 && contest42::runPair(x, weight, scale, group_list, y, e, m, cores, stream))
    return;
  if (k == 2048 && n == 1024 && contest41::runWide(x, weight, scale, group_list, y, e, m, cores, stream))
    return;
  if (k == 256 && n == 256 && m >= e * 16 && m <= e * 128 &&
      contest41::runShort(x, weight, scale, group_list, y, e, m, cores, stream))
    return;
  if (k == 512 && n >= 3 * 256 && n % 256 == 0 && (n / 256) % 2 && m >= e * 32 && m <= e * 64 &&
      contest41::runJoined(x, weight, scale, group_list, y, e, m, n, cores, stream))
    return;
  if (k >= 4096 && n > 256 && n <= 576 && m <= e * 512 &&
      contest41::runLong(x, weight, scale, group_list, y, e, m, n, k, cores, stream))
    return;
  if (n > 256 && n <= 448 && k >= 128 && cores > 8 && m >= e * 128 &&
      gmg::LaunchHA36Sched(x, weight, scale, group_list, y, e, m, n, k, cores, stream))
    return;
  // The tiny dot product fits in one local operand panel for this entire range.
  if (k == 3 && e <= 3 && m <= 8 && n <= 5 && e * 3 * n <= 64 && e * n <= 16) {
    current_backend::gmg::p332ready::Launch<4, 5, false, 7, 1>(x, weight, scale, group_list, y, e, m, n, cores, stream);
    return;
  }
  if (k == 2048 && n >= 512 && n % 256 == 0) {
    current_backend::gmg::p533::Run<128, 256, 128, 4, 8, 8, 0, 128>(x, weight, scale, group_list, y, e, m, n, k,
                                                                    std::min<Z0>(cores, 16), stream);
    return;
  }
  Z0 shortCores = std::min<Z0>(cores, e / 4);
  if (e >= 32 && k >= 128 && k <= 256 && k % 32 == 0 && n >= 256 && n <= 512 && n % 256 == 0 && m >= e * 16 &&
      m <= e * 128 && shortCores > 8 && shortCores * 4 >= cores * 3 &&
      ((m + 63) / 64) * ((n + 255) / 256) >= shortCores * 2) {
    current_backend::gmg::short_control::LaunchDirect<64, 256, 128, 256, true, 0, false, false>(
        x, weight, scale, group_list, y, e, m, n, k, shortCores, stream);
    return;
  }
  reference_backend::RunReference(x, info_x, weight, info_weight, scale, info_scale, group_list, info_group_list, y,
                                  info_y, availableCoreNum, stream);
}
namespace gmg {
using namespace AscendC;
using current_backend::gmg::Min;
using current_backend::gmg::Up;
constexpr Z4 READY = 8, RELEASE = 9;
namespace p12math {
struct Pair {
  Z8 hi, lo;
};
__aicore__ inline Pair AddPair(Pair a, Pair b) {
#pragma clang fp reassociate(off) contract(off)
  Z8 s = a.hi + b.hi;
  Z8 v = s - a.hi;
  Z8 w = s - v;
  Z8 e0 = a.hi - w;
  Z8 e1 = b.hi - v;
  Z8 e2 = e0 + e1;
  Z8 e3 = a.lo + b.lo;
  Z8 e = e2 + e3;
  Z8 h = s + e;
  Z8 t = h - s;
  return {h, e - t};
}
__aicore__ inline Pair NegPair(Pair a) {
#pragma clang fp reassociate(off) contract(off)
  return {-a.hi, -a.lo};
}
__aicore__ inline Pair MulPair(Pair a, Pair b) {
#pragma clang fp reassociate(off) contract(off)
  Z8 p = a.hi * b.hi;
  Z8 sa = a.hi * 4097.0f;
  Z8 sb = b.hi * 4097.0f;
  Z8 ta = sa - a.hi;
  Z8 tb = sb - b.hi;
  Z8 ah = sa - ta;
  Z8 bh = sb - tb;
  Z8 al = a.hi - ah;
  Z8 bl = b.hi - bh;
  Z8 hh = ah * bh;
  Z8 e0 = hh - p;
  Z8 hl = ah * bl;
  Z8 lh = al * bh;
  Z8 ll = al * bl;
  Z8 e1 = e0 + hl;
  Z8 e2 = e1 + lh;
  Z8 e3 = e2 + ll;
  Z8 c0 = a.hi * b.lo;
  Z8 c1 = a.lo * b.hi;
  Z8 c2 = a.lo * b.lo;
  Z8 e4 = e3 + c0;
  Z8 e5 = e4 + c1;
  Z8 e = e5 + c2;
  Z8 h = p + e;
