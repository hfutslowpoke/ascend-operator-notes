namespace gmg {
namespace p332ready {
__aicore__ __attribute__((noinline, section(".text"))) inline Z4 Slow(Z8 z) {
#pragma clang fp reassociate(off) contract(off)
if (z == 0.0f || z >= 7.125f)
return SmallHalf(z);
if (z <= -6.0f)
return 0x8000U;
if (z >= 5.0f && z <= 7.0f)
return PositiveTailHalf(z);
Z8 square = z * z;
Z8 polynomial = 1.0f + 0.044715f * square;
Z8 u = 1.5957691216057308f * z * polynomial;
Z8 x = u < 0.0f ? u : -u;
Z1 power = static_cast<Z1>(x * 1.4426950408889634f - 0.5f);
Z8 pf = static_cast<Z8>(power);
Z8 reduced = x - pf * 0.6931471824645996f;
Z8 r = reduced - pf * (-1.904654323148236e-9f);
Z8 t = 2.48015873015873e-5f;
t = t * r + 1.984126984126984e-4f;
t = t * r + 1.388888888888889e-3f;
t = t * r + 8.333333333333333e-3f;
t = t * r + 4.166666666666667e-2f;
t = t * r + 1.666666666666667e-1f;
t = t * r + 0.5f;
t = t * r + 1.0f;
t = t * r + 1.0f;
union {
Z0 bits;
Z8 value;
} scale;
scale.bits = static_cast<Z0>(power + 127) << 23;
t *= scale.value;
Z8 value = z >= 0.0f ? z / (1.0f + t) : (z * t) / (1.0f + t);
Z4 previous = SmallHalf(value);
Z0 h = previous & 0x7fffU;
if (h >= 1002 && h < 0x4000U)
return previous;
if (h >= 0x4000U) {
union {
  Z8 value;
  Z0 bits;
} rounded;
rounded.value = value;
Z1 distance = static_cast<Z1>(rounded.bits & 0x1fffU) - 4096;
if (distance < 0)
  distance = -distance;
if (distance >= 64)
  return previous;
} else {
Z8 magnitude = value < 0.0f ? -value : value;
Z8 units = magnitude * 16777216.0f;
Z1 floor = static_cast<Z1>(units);
Z8 distance = units - static_cast<Z8>(floor) - 0.5f;
if (distance < 0.0f)
  distance = -distance;
if (distance >= 2.0e-6f * units)
  return previous;
}
return herl18epi::SharedRepairHalf(z, previous);
}
__aicore__ __attribute__((section(".text"))) inline Z4 Poly(Z8 z) {
Z8 q = z * z;
Z8 p = 2.8915911176233382e-07f;
p = p * q + (-8.0971394716631011e-06f);
p = p * q + (0.00011896567759760815f);
p = p * q + (-0.0012435576481023617f);
p = p * q + (0.010201525691596484f);
p = p * q + (-0.066819416723634437f);
p = p * q + (0.3989422767483658f);
Z8 value = 0.5f * z + q * p;
union {
Z8 f;
Z0 u;
} v;
v.f = value;
Z0 rounded = v.u + 0xfffU + ((v.u >> 13) & 1U);
Z0 h = (rounded >> 13) - (112U << 10);
return (Z4)((h & 0x7fffU) | ((v.u >> 16) & 0x8000U));
}
__aicore__ __attribute__((section(".text"))) inline Z4 Fast(Z8 z) {
Z8 az = z < 0 ? -z : z;
if (az > 0.5f) {
if (az <= 2.0f)
  return Poly(z);
if (z >= 7.125f) {
  union {
    Z8 f;
    Z0 u;
  } v;
  v.f = z;
  Z0 r = v.u + 0xfffU + ((v.u >> 13) & 1U);
  return Z4((r >> 13) - (112U << 10));
}
if (z <= -6.0f)
  return 0x8000U;
return Slow(z);
}
Z8 q = z * z, p = (0.010201557106266503f * q - 0.066819477177504583f) * q + 0.3989422804014327f;
Z8 value = 0.5f * z + q * p, mag = value < 0 ? -value : value;
if (mag >= 0.000062f) {
union {
  half h;
  Z4 u;
} v;
v.h = Cast<Z8, half, RoundMode::CAST_ODD>(value);
return v.u;
}
Z4 h = SmallHalf(value);
if ((h & 0x7fffU) >= 1010)
return h;
if (az < 0.000125f) {
if (z == 0)
  return h;
Z8 units = mag * 16777216.0f, d = units - (Z8)(Z1)units - 0.5f;
if (d < 0)
  d = -d;
if (d > 2.0e-6f * units + 1.0e-7f)
  return h;
return herl18epi::SharedRepairHalf(z, h);
}
return Slow(z);
}
template <Z0 IO, Z0 COLS, bool DIRECT, Z0 TUNE = 0, Z0 REFINE = 0>
__global__ __vector__ __aicore__ __attribute__((section(".text"), aligned(256))) void
Kernel(GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR g, GM_ADDR y, Z0 e, Z0 m, Z0 n, Z0 workers) {
#pragma clang fp reassociate(off) contract(off)
if (TUNE & 1)
SetAtomicNone();
else
InitSocState();
LocalTensor<Z7> a(TPosition::VECCALC, 0, 32), b(TPosition::VECCALC, 32, 64), gb(TPosition::VECCALC, 160, 32);
LocalTensor<Z8> sc(TPosition::VECCALC, 96, 16);
LocalTensor<Z4> out(TPosition::VECCALC, 192, 16);
GlobalTensor<Z7> ag, bg, ggb;
GlobalTensor<Z8> sg;
GlobalTensor<Z0> gg;
GlobalTensor<Z4> yg;
ag.SetGlobalBuffer((__gm__ Z7 *)x);
bg.SetGlobalBuffer((__gm__ Z7 *)w);
sg.SetGlobalBuffer((__gm__ Z8 *)s);
gg.SetGlobalBuffer((__gm__ Z0 *)g);
ggb.SetGlobalBuffer((__gm__ Z7 *)g);
yg.SetGlobalBuffer((__gm__ Z4 *)y);
Z0 g0 = m, g1 = m;
if (IO >= 4) {
DataCopyPad(a, ag, DataCopyExtParams{1, m * 3, 0, 0, 0},
            DataCopyPadExtParams<Z7>{true, 0, static_cast<Z6>(32 - m * 3), 0});
DataCopyPad(b, bg, DataCopyExtParams{1, e * 3 * n, 0, 0, 0},
            DataCopyPadExtParams<Z7>{true, 0, static_cast<Z6>((32 - e * 3 * n % 32) % 32), 0});
DataCopyPad(sc, sg, DataCopyExtParams{1, e * n * 4, 0, 0, 0}, DataCopyPadExtParams<Z8>{true, 0, 0, 0.0f});
if (IO == 5)
  DataCopyPad(gb, ggb, DataCopyExtParams{1, e * 8, 0, 0, 0},
              DataCopyPadExtParams<Z7>{true, 0, static_cast<Z6>(32 - e * 8), 0});
else {
  if (e > 1)
    g0 = (Z0)gg.GetValue(0);
  if (e > 2)
    g1 = (Z0)gg.GetValue(2);
}
SetFlag<HardEvent::MTE2_S>(EVENT_ID0);
WaitFlag<HardEvent::MTE2_S>(EVENT_ID0);
if (IO == 5) {
  auto ends = gb.ReinterpretCast<Z3>();
  if (e > 1)
    g0 = (Z0)ends.GetValue(0);
  if (e > 2)
    g1 = (Z0)ends.GetValue(1);
}
} else {
if (e > 1)
  g0 = (Z0)gg.GetValue(0);
if (e > 2)
  g1 = (Z0)gg.GetValue(2);
}
const Z0 NT = (n + COLS - 1) / COLS, JOBS = m * NT;
#pragma unroll
for (Z0 iteration = 0, job = GetBlockIdx(); ((TUNE & 2) ? iteration < 1 : job < JOBS); ++iteration, job += workers) {
Z0 row = job / NT, col = (job % NT) * COLS, ex = (row >= g0) + (row >= g1), cols = Min(COLS, n - col);
if (IO == 0 || IO == 3)
  DataCopyPad(a, ag[row * 3], DataCopyExtParams{1, 3, 0, 0, 0}, DataCopyPadExtParams<Z7>{true, 0, 29, 0});
if (IO == 0 || IO == 2 || IO == 3)
  DataCopyPad(b, bg[ex * (3 * n)], DataCopyExtParams{1, 3 * n, 0, 0, 0},
              DataCopyPadExtParams<Z7>{true, 0, static_cast<Z6>(32 - 3 * n), 0});
if (IO == 0)
  DataCopyPad(sc, sg[ex * n + col], DataCopyExtParams{1, cols * 4, 0, 0, 0},
              DataCopyPadExtParams<Z8>{true, 0, 0, 0.0f});
if (IO == 0 || IO == 2 || IO == 3) {
  SetFlag<HardEvent::MTE2_S>(EVENT_ID0);
  WaitFlag<HardEvent::MTE2_S>(EVENT_ID0);
}
Z1 x0, x1, x2;
if (IO == 1 || IO == 2) {
  x0 = ag.GetValue(row * 3);
  x1 = ag.GetValue(row * 3 + 1);
  x2 = ag.GetValue(row * 3 + 2);
} else {
  Z0 off = IO >= 4 ? row * 3 : 0;
  x0 = a.GetValue(off);
  x1 = a.GetValue(off + 1);
  x2 = a.GetValue(off + 2);
}
bool direct = DIRECT && ((((uintptr_t)((__gm__ Z4 *)y + row * n + col)) & 127) + cols * 2 <= 32);
Z4 packed[6];
#pragma unroll
for (Z0 c = 0; c < COLS; c++)
  if (c < cols) {
    Z1 w0, w1, w2;
    if (IO == 1) {
      w0 = bg.GetValue(ex * (3 * n) + col + c);
      w1 = bg.GetValue(ex * (3 * n) + n + col + c);
      w2 = bg.GetValue(ex * (3 * n) + 2 * n + col + c);
    } else {
      Z0 off = (IO >= 4 ? ex * (3 * n) : 0) + col + c;
      w0 = b.GetValue(off);
      w1 = b.GetValue(off + n);
      w2 = b.GetValue(off + 2 * n);
    }
    Z1 dot = x0 * w0 + x1 * w1 + x2 * w2;
    Z8 scale;
    if (IO == 1 || IO == 2 || IO == 3)
      scale = sg.GetValue(ex * n + col + c);
    else
      scale = sc.GetValue(IO >= 4 ? ex * n + col + c : c);
    Z8 z;
    if (REFINE & 1) {
      z = (Z8)dot * scale;
    } else {
      volatile Z8 rounded = (Z8)dot * scale;
      z = rounded;
    }
    Z4 h = Fast(z);
    if (REFINE & 2)
      packed[c] = h;
    else
      out.SetValue(c, h);
  }
if (REFINE & 2) {
  auto words = out.template ReinterpretCast<Z0>();
  words.SetValue(0, Z0(packed[0]) | (Z0(packed[1]) << 16));
  words.SetValue(1, Z0(packed[2]) | (Z0(packed[3]) << 16));
  out.SetValue(4, packed[4]);
}
if (!direct) {
  SetFlag<HardEvent::S_MTE3>(EVENT_ID1);
  WaitFlag<HardEvent::S_MTE3>(EVENT_ID1);
  DataCopyPad(yg[row * n + col], out, DataCopyExtParams{1, cols * 2, 0, 0, 0});
}
if (!(TUNE & 2) && job + workers < JOBS) {
  SetFlag<HardEvent::MTE3_S>(EVENT_ID2);
  WaitFlag<HardEvent::MTE3_S>(EVENT_ID2);
}
}
if (TUNE & 4) {
SetFlag<HardEvent::MTE3_S>(EVENT_ID2);
WaitFlag<HardEvent::MTE3_S>(EVENT_ID2);
} else
PipeBarrier<PIPE_ALL>();
if (DIRECT)
DataSyncBarrier<MemDsbT::ALL>();
}
template <Z0 IO, Z0 COLS, bool DIRECT, Z0 TUNE = 0, Z0 REFINE = 0>
void Launch(GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR g, GM_ADDR y, Z0 e, Z0 m, Z0 n, Z0 cores, aclrtStream stream) {
const Z0 jobs = m * ((n + COLS - 1) / COLS);
Z0 workers = jobs < cores * 2 ? jobs : cores * 2;
if (workers == jobs)
Kernel<IO, COLS, DIRECT, TUNE, REFINE><<<workers, nullptr, stream>>>(x, w, s, g, y, e, m, n, workers);
else
Kernel<IO, COLS, DIRECT, (TUNE & ~2U), REFINE><<<workers, nullptr, stream>>>(x, w, s, g, y, e, m, n, workers);
if (aclrtSynchronizeStream(stream) != ACL_SUCCESS)
throw std::runtime_error("P3 execution");
}
} // namespace p332ready
} // namespace gmg

namespace gmg {
namespace p533 {
template <Z0 BM, Z0 BN, Z0 SNAP> class RowBandJobs {
public:
__aicore__ RowBandJobs(GM_ADDR g, Z0 e, Z0 n, Z0 core, Z0 cores, Z0 m) : ends_((__gm__ Z3 *)g), e_(e), nt_(n / BN) {
Z0 total = m * nt_;
next_ = ((Z2)total * core / cores / SNAP) * SNAP;
last_ = core + 1 == cores ? total : ((Z2)total * (core + 1) / cores / SNAP) * SNAP;
Z0 lo = 0, hi = e;
while (lo < hi) {
  Z0 mid = (lo + hi) / 2;
  if ((Z0)ends_[mid] * nt_ <= next_)
    lo = mid + 1;
  else
    hi = mid;
}
ex_ = lo;
begin_ = ex_ ? (Z0)ends_[ex_ - 1] : 0;
}
__aicore__ bool Next(Z0 &ex, Z0 &row, Z0 &col, Z0 &rows, Z0 &cols, Z0) {
while (ex_ < e_ && next_ < last_) {
  Z0 end = (Z0)ends_[ex_], length = end - begin_;
  if (!length || next_ >= end * nt_) {
    begin_ = end;
    ++ex_;
    continue;
  }
  Z0 offset = next_ - begin_ * nt_, column = offset / length, within = offset - column * length;
  ex = ex_;
  row = begin_ + within;
  col = column * BN;
  rows = Min(BM, Min(length - within, last_ - next_));
  cols = BN;
  next_ += rows;
  return true;
}
return false;
}

private:
__gm__ Z3 *ends_;
Z0 e_, nt_, next_, last_, ex_ = 0, begin_ = 0;
};
template <Z0 BM, Z0 BN, Z0 BK, Z0 SK, Z0 DA, Z0 DB> struct Policy {
__aicore__ static constexpr MatmulApiStaticTiling Make() {
auto t = DeepStaticPolicy<BM, BN, BK>::Make();
t.M = BM;
t.N = BN;
t.Ka = 2048;
t.Kb = 2048;
t.singleCoreM = BM;
t.singleCoreN = BN;
t.singleCoreK = 2048;
t.iterateOrder = 0;
t.shareMode = 0;
t.depthAL1CacheUB = 0;
t.depthBL1CacheUB = 0;
t.dbL0C = BM * BN <= 16384 ? 2 : 1;
t.cfg.doMTE2Preload = 0;
t.stepKa = SK;
t.stepKb = SK;
t.depthA1 = DA;
t.depthB1 = DB;
return t;
}
static constexpr auto value = Make();
};
#if defined(__DAV_VEC__) || defined(__DAV_C220_VEC__)

#define GMG_DEEP28_CODE __attribute__((section(".text"), aligned(256)))

#else

#define GMG_DEEP28_CODE __attribute__((section(".gmg_tiny16_slow"), aligned(256)))

#endif
template <Z0 BM, Z0 BN, Z0 BK, Z0 SK, Z0 DA, Z0 DB, Z0 EM, Z0 SNAP>
__global__ __mix__(1, 2) GMG_DEEP28_CODE
void Kernel(GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groups, GM_ADDR y, GM_ADDR workspace,
            TCubeTiling tiling, Z0 experts, Z0 n, Z0 k, Z0 cores, Z0 m) {
constexpr Z0 TILE = BM * BN;
InitSocState();
Z0 core = GetBlockIdx();
Z0 sub = 0;
if ASCEND_IS_AIV {
sub = core % 2;
core /= 2;
}
RowBandJobs<BM, BN, SNAP> jobs(groups, experts, n, core, cores, m);
GlobalTensor<Z1> scratch;
scratch.SetGlobalBuffer(reinterpret_cast<__gm__ Z1 *>(workspace));
Z0 expert, row, col, rows, cols, sequence = 0;
if ASCEND_IS_AIC {
TPipe pipe;
MatmulImpl<MatmulType<TPosition::GM, CubeFormat::ND, Z7, false>,
           MatmulType<TPosition::GM, CubeFormat::ND, Z7, false>, MatmulType<TPosition::GM, CubeFormat::ND, Z1>,
           MatmulType<TPosition::GM, CubeFormat::ND, Z1>, Policy<BM, BN, BK, SK, DA, DB>::value>
    mm;
mm.SetSubBlockIdx(0);
mm.Init(static_cast<const TCubeTiling *>(nullptr), &pipe);
GlobalTensor<Z7> a, b;
a.SetGlobalBuffer(reinterpret_cast<__gm__ Z7 *>(x));
b.SetGlobalBuffer(reinterpret_cast<__gm__ Z7 *>(weight));
mm.SetOrgShape(BM, n, 2048, 2048, BN);
while (jobs.Next(expert, row, col, rows, cols, n)) {
  mm.SetSingleShape(rows, cols, 2048);
  mm.SetTensorA(a[static_cast<Z2>(row) * k], false);
  mm.SetTensorB(b[static_cast<Z2>(expert) * k * n + col], false);
  while (mm.Iterate()) {
    if (sequence >= 2)
      CrossCoreWaitFlag(RELEASE);
    auto dest = scratch[(static_cast<Z2>(core) * 2 + sequence % 2) * TILE];
    mm.GetTensorC(dest, 0, rows > BM);
    CrossCoreSetFlag<0x2, PIPE_FIX>(READY);
    ++sequence;
  }
}
for (Z0 i = 0; i < Min(sequence, 2); ++i)
  CrossCoreWaitFlag(RELEASE);
mm.End();
PipeBarrier<PIPE_ALL>();
}
if ASCEND_IS_AIV {
TPipe pipe;
quick16Ep::ScreenEpilogue<BM, BN, EM> epilogue;
epilogue.Init(pipe, scale, y);
while (jobs.Next(expert, row, col, rows, cols, n)) {
  for (Z0 offset = 0; offset < rows; offset += BM) {
    CrossCoreWaitFlag(READY);
    epilogue.Process(scratch[(static_cast<Z2>(core) * 2 + sequence % 2) * TILE], expert, row + offset, col,
                     Min(BM, rows - offset), cols, n, sub);
    ++sequence;
  }
}
PipeBarrier<PIPE_ALL>();
}
}
template <Z0 BM, Z0 BN, Z0 BK, Z0 SK, Z0 DA, Z0 DB, Z0 EM, Z0 SNAP>
void Run(GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groups, GM_ADDR y, Z0 e, Z0 m, Z0 n, Z0 k, Z0 available,
     aclrtStream stream) {
Z0 rowUpper = (m + BM - 1) / BM + e - 1;
if (rowUpper > m)
rowUpper = m;
Z0 upper = rowUpper * ((n + BN - 1) / BN);
Z0 cores = available < upper ? available : upper;
matmul_tiling::MatmulApiTiling api;
api.SetAType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND, matmul_tiling::DataType::DT_INT8, false);
api.SetBType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND, matmul_tiling::DataType::DT_INT8, false);
api.SetCType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND, matmul_tiling::DataType::DT_INT32);
api.SetBiasType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND, matmul_tiling::DataType::DT_INT32);
Z0 planK = (k + 31) / 32 * 32;
Z0 maxMTiles = (m + BM - 1) / BM;
bool canPanel = n % BN == 0 && k * BN <= 256 * 1024 && maxMTiles >= 4 && maxMTiles * ((n + BN - 1) / BN) >= cores * 8;
Z0 planM = BM;
api.SetOrgShape(planM, BN, planK);
api.SetShape(planM, BN, planK);
api.SetFixSplit(BM, BN, planK < BK ? planK : BK);
api.EnableBias(false);
api.SetMatmulConfigParams(0);
api.SetBufferSpace(480 * 1024, 128 * 1024, 0);
TCubeTiling tiling{};
if (api.GetTiling(tiling) != 0)
throw std::runtime_error("GMM INT8 tiling failed");
tiling.stepM = 1;
tiling.stepN = 1;
tiling.stepKa = SK;
tiling.stepKb = SK;
tiling.depthA1 = DA;
tiling.depthB1 = DB;
void *workspace = nullptr;
size_t bytes = static_cast<size_t>(cores) * 2 * BM * BN * sizeof(Z1);
if (aclrtMalloc(&workspace, bytes, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS)
throw std::runtime_error("GMM workspace allocation failed");
Kernel<BM, BN, BK, SK, DA, DB, EM, SNAP><<<cores, nullptr, stream>>>(
  x, weight, scale, groups, y, static_cast<Z6 *>(workspace), tiling, e, n, k, cores, m);
aclError status = aclrtSynchronizeStream(stream);
aclError freed = aclrtFree(workspace);
if (status != ACL_SUCCESS || freed != ACL_SUCCESS)
throw std::runtime_error("GMM execution/workspace release failed");
}
} // namespace p533
} // namespace gmg
#undef GMG_DEEP28_CODE

namespace gmg {
namespace herl33math {
__aicore__ inline Pair FastAddPair(Pair a, Pair b) {
#pragma clang fp reassociate(off) contract(off)
Z8 s = a.hi + b.hi;
Z8 v = s - a.hi;
Z8 w = s - v;
Z8 e0 = a.hi - w;
Z8 e1 = b.hi - v;
Z8 e2 = e0 + e1;
Z8 e3 = a.lo + b.lo;
Z8 e = e2 + e3;
Z8 h = s + e;
Z8 t = h - s;
return {h, e - t};
}
__aicore__ inline Pair FastNegPair(Pair a) {
#pragma clang fp reassociate(off) contract(off)
return {-a.hi, -a.lo};
}
__aicore__ inline Pair QMulPair(Pair a, Pair b) {
#pragma clang fp reassociate(off) contract(off)
Z8 p = a.hi * b.hi;
union {
Z8 value;
Z0 bits;
} aa, bb;
aa.value = a.hi;
bb.value = b.hi;
aa.bits &= 0xfffff000U;
bb.bits &= 0xfffff000U;
Z8 ah = aa.value, bh = bb.value;
Z8 al = a.hi - ah;
Z8 bl = b.hi - bh;
Z8 hh = ah * bh;
Z8 e0 = hh - p;
Z8 hl = ah * bl;
Z8 lh = al * bh;
Z8 ll = al * bl;
Z8 e1 = e0 + hl;
Z8 e2 = e1 + lh;
Z8 e3 = e2 + ll;
Z8 c0 = a.hi * b.lo;
Z8 c1 = a.lo * b.hi;
Z8 c2 = a.lo * b.lo;
Z8 e4 = e3 + c0;
Z8 e5 = e4 + c1;
Z8 e = e5 + c2;
Z8 h = p + e;
Z8 t = h - p;
return {h, e - t};
}
__aicore__ inline Pair QDivPair(Pair a, Pair b) {
#pragma clang fp reassociate(off) contract(off)
Z8 q = a.hi / b.hi;
Pair r = FastAddPair(a, FastNegPair(QMulPair(b, {q, 0.0f})));
Z8 rsum = r.hi + r.lo;
Z8 tail = rsum / b.hi;
return FastAddPair({q, 0.0f}, {tail, 0.0f});
}
__aicore__ inline Pair QExpPair(Pair a) {
#pragma clang fp reassociate(off) contract(off)
Z1 power = static_cast<Z1>(a.hi * 1.4426950408889634f - 0.5f);
Pair r = FastAddPair(
  a, FastNegPair(QMulPair({static_cast<Z8>(power), 0.0f}, {0.6931471824645996f, -1.904654323148236e-9f})));
Z8 high = 2.0876755879584152e-9f;
high = high * r.hi + 2.5052107943679403e-8f;
high = high * r.hi + 2.755731998149713e-7f;
high = high * r.hi + 2.7557318844628753e-6f;
high = high * r.hi + 2.4801587642286904e-5f;
Pair sum{high, 0.0f};
sum = FastAddPair(QMulPair(sum, r), {1.9841270113829523e-4f, -2.7255968207233472e-12f});
sum = FastAddPair(QMulPair(sum, r), {1.3888889225199819e-3f, -3.3631092919220174e-11f});
sum = FastAddPair(QMulPair(sum, r), {8.3333337679505348e-3f, -4.3461720160287154e-10f});
sum = FastAddPair(QMulPair(sum, r), {4.1666667908430099e-2f, -1.2417634351336027e-9f});
sum = FastAddPair(QMulPair(sum, r), {1.6666667163372040e-1f, -4.9670537405344106e-9f});
sum = FastAddPair(QMulPair(sum, r), {0.5f, 0.0f});
sum = FastAddPair(QMulPair(sum, r), {1.0f, 0.0f});
sum = FastAddPair(QMulPair(sum, r), {1.0f, 0.0f});
union {
Z0 bits;
Z8 value;
} scale;
scale.bits = static_cast<Z0>(power + 127) << 23;
return QMulPair(sum, {scale.value, 0.0f});
}
__aicore__ inline Pair QAccurateGelu(Z8 z) {
#pragma clang fp reassociate(off) contract(off)
if (z >= 8.0f)
return {z, 0.0f};
if (z <= -6.0f)
return {0.0f, 0.0f};
Pair a{z, 0.0f};
Pair square = QMulPair(a, a);
Pair p = FastAddPair({1.0f, 0.0f}, QMulPair(square, {0.044714998453855515f, 1.5461444832776117e-9f}));
Pair arg = QMulPair(QMulPair(a, p), {1.5957691669464111f, -4.534068032135963e-8f});
if (z > 0.0f && arg.hi > 36.7368005696771f)
return a;
Pair t = QExpPair(z >= 0.0f ? FastNegPair(arg) : arg);
Pair correction = QDivPair(QMulPair(a, t), FastAddPair({1.0f, 0.0f}, t));
return z >= 0.0f ? FastAddPair(a, FastNegPair(correction)) : correction;
}
__aicore__ inline Z4 QCorrectHalf(Z8 z, Z4 previous) {
#pragma clang fp reassociate(off) contract(off)
if (z == 0.0f || z >= 8.0f)
return previous;
if (z <= -6.0f)
return 0x8000U;
if (z >= 5.0f && z <= 7.0f)
return PositiveTailHalf(z);
Z0 h = previous & 0x7fffU;
if (h >= 1002 && h < 0x4000U)
return previous;
Pair a = QAccurateGelu(z);
if (z < 0.0f)
a = FastNegPair(a);
Z8 center = HalfMagnitude(h);
Z8 lower = h == 0 ? 0.0f : 0.5f * (center + HalfMagnitude(h - 1));
Z8 upper = 0.5f * (center + HalfMagnitude(h + 1));
int lo = ComparePair(a, lower), hi = ComparePair(a, upper);
if (h && (lo < 0 || (lo == 0 && (h & 1))))
--h;
else if (hi > 0 || (hi == 0 && (h & 1)))
++h;
return static_cast<Z4>(h | (z < 0.0f ? 0x8000U : 0U));
}
__aicore__ inline Z4 QuickCorrectHalf(Z8 z, Z4 previous) {
#pragma clang fp reassociate(off) contract(off)
Z0 h = previous & 0x7fffU;
if (z == 0.0f || z >= 8.0f)
return previous;
if (z <= -6.0f)
return 0x8000U;
if (z >= 5.0f && z <= 7.0f)
return PositiveTailHalf(z);
if (h >= 1002 && h < 0x4000U)
return previous;
Z8 magnitude = z < 0.0f ? -z : z;
if (magnitude < 0.000125f) {
Z8 units = magnitude * 8388608.0f;
Z1 whole = static_cast<Z1>(units);
Z8 bend = (magnitude * magnitude) * 6693141.0f;
Z8 distance = ((units - static_cast<Z8>(whole)) - 0.5f) + (z < 0.0f ? -bend : bend);
Z0 rounded = static_cast<Z0>(whole);
rounded += distance > 0.0f || (distance == 0.0f && (rounded & 1U));
return static_cast<Z4>(rounded | (z < 0.0f ? 0x8000U : 0U));
}
if ((z >= 2.0f && z < 5.0f) || (z < -3.0f && h < 1002)) {
Z8 correction = precision43::Tail(magnitude);
if (z < 0.0f) {
  Z8 units = correction * 16777216.0f;
  Z1 whole = static_cast<Z1>(units);
  Z8 distance = (units - static_cast<Z8>(whole)) - 0.5f;
  Z0 rounded = static_cast<Z0>(whole);
  rounded += distance > 0.0f || (distance == 0.0f && (rounded & 1U));
  return static_cast<Z4>(rounded | 0x8000U);
}
Z8 center = HalfMagnitude(h);
Z8 lower = 0.5f * (center + HalfMagnitude(h - 1));
Z8 upper = 0.5f * (center + HalfMagnitude(h + 1));
Z8 dl = (z - lower) - correction, du = (z - upper) - correction;
if (dl < 0.0f || (dl == 0.0f && (h & 1U)))
  --h;
else if (du > 0.0f || (du == 0.0f && (h & 1U)))
  ++h;
return static_cast<Z4>(h);
}
return QCorrectHalf(z, previous);
}
} // namespace herl33math
namespace herl33repair {
__aicore__ __attribute__((noinline, section(".gmg_zzzz_v33_repair_rx"))) inline Z4 FastSharedRepair(Z8 z, Z4 h) {
return herl33math::QuickCorrectHalf(z, h);
}
} // namespace herl33repair
} // namespace gmg
namespace gmg {
namespace integer_post {
template <Z0 BM, Z0 BN, bool COUNTER, bool HANDOFF = true> class Epilogue {
public:
static constexpr Z0 HALF_ROWS = (BM + 1) / 2;
static constexpr Z0 SIZE = HALF_ROWS * BN;
__aicore__ inline void Init(TPipe &pipe, GM_ADDR scale, GM_ADDR y) {
pipe.InitBuffer(rawBuf_, SIZE * 4 + 256);
pipe.InitBuffer(zBuf_, SIZE * 4 + 256);
pipe.InitBuffer(tBuf_, SIZE * 4 + 256);
pipe.InitBuffer(workBuf_, SIZE * 4 + 256);
pipe.InitBuffer(outBuf_, SIZE * 2);
pipe.InitBuffer(maskBuf_, 5 * Up(SIZE / 8, 256));
pipe.InitBuffer(constMaskBuf_, 256);
Duplicate(constMaskBuf_.Get<Z1>(), Z1(0x1ffc), 64);
pipe.InitBuffer(wordIndexBuf_, Up((SIZE * 2 + 31) / 32, 64) * 4);
CreateVecIndex(wordIndexBuf_.Get<Z8>(), 0.0f, Up((SIZE * 2 + 31) / 32, 64));
Duplicate(maskBuf_.Get<Z1>(), Z1(0), 5 * Up(SIZE / 8, 256) / 4);
PipeBarrier<PIPE_V>();
ResetMask();
pipe.InitBuffer(scaleBuf_, Up(BN, 64) * 4);
scale_.SetGlobalBuffer(reinterpret_cast<__gm__ Z8 *>(scale));
y_.SetGlobalBuffer(reinterpret_cast<__gm__ half *>(y));
}
__aicore__ inline void Process(const GlobalTensor<Z1> &scratch, Z0 expert, Z0 row, Z0 col, Z0 rows, Z0 cols, Z0 n,
                             Z0 sub) {
Z0 split = (rows + 1) / 2;
Z0 first = sub * split;
Z0 active = first < rows ? Min(split, rows - first) : 0;
if (active == 0) {
  if constexpr (HANDOFF)
    CrossCoreSetFlag<0x2, PIPE_MTE2>(RELEASE);
} else {
  Z0 width = Up(cols, 16);
  Z0 validCount = active * width;
  Z0 count = Up(validCount, 64);
  auto raw = rawBuf_.Get<Z1>();
  auto z = zBuf_.Get<Z8>();
  auto t = tBuf_.Get<Z8>();
  auto work = workBuf_.Get<Z8>();
  auto sc = scaleBuf_.Get<Z8>();
  auto out = outBuf_.Get<half>();
  bool loadScale = expert != cachedExpert_ || col != cachedCol_;
  bool clearRaw = cols != width || count != validCount;
  bool clearScale = loadScale && (cols != width || width % 64 != 0);
  if (clearRaw)
    Duplicate(raw, Z1(0), count);
  if (clearScale)
    Duplicate(sc, 0.0f, Up(width, 64));
  if (clearRaw || clearScale) {
    SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
    WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
  }
  if (cols == BN) {
    DataCopy(raw, scratch[first * BN], validCount);
  } else {
    DataCopyPad(raw, scratch[first * BN],
                DataCopyExtParams{static_cast<Z4>(active), cols * 4, (BN - cols) * 4, (width - Up(cols, 8)) / 8, 0},
                DataCopyPadExtParams<Z1>{true, 0, static_cast<Z6>(Up(cols, 8) - cols), 0});
  }
  if (loadScale) {
    DataCopyPad(sc, scale_[static_cast<Z2>(expert) * n + col], DataCopyExtParams{1, cols * 4, 0, 0, 0},
                DataCopyPadExtParams<Z8>{true, 0, static_cast<Z6>(Up(cols, 8) - cols), 0.0f});
    cachedExpert_ = expert;
    cachedCol_ = col;
  }
  if constexpr (HANDOFF)
    CrossCoreSetFlag<0x2, PIPE_MTE2>(RELEASE);
  SetFlag<HardEvent::MTE2_V>(EVENT_ID1);
  WaitFlag<HardEvent::MTE2_V>(EVENT_ID1);
  Cast(z, raw, RoundMode::CAST_RINT, count);
  PipeBarrier<PIPE_V>();
  for (Z0 c = 0; c < width; c += 64) {
    Mul(z[c], z[c], sc[c], static_cast<Z2>(Min(64, width - c)), static_cast<Z6>(active),
        BinaryRepeatParams{1, 1, 1, static_cast<Z6>(width / 8), static_cast<Z6>(width / 8), 0});
  }
  PipeBarrier<PIPE_V>();
  ResetMask();
  auto result = raw.ReinterpretCast<Z8>();
  if (COUNTER) {
    SetMaskCount();
    SetVectorMask<Z8, MaskMode::COUNTER>(0, count);
    Mul<Z8, false>(t, z, z, Z2(64), 1, BinaryRepeatParams{1, 1, 1, 8, 8, 8});
    Duplicate<Z8, false>(work, -1.5957691216057308f, Z2(64), 1, 1, 8);
    Axpy<Z8, Z8, false>(work, t, -0.071354816275f, Z2(64), 1, UnaryRepeatParams{1, 1, 8, 8});
    Mul<Z8, false>(t, work, z, Z2(64), 1, BinaryRepeatParams{1, 1, 1, 8, 8, 8});
    Exp<Z8, false>(t, t, Z2(64), 1, UnaryRepeatParams{1, 1, 8, 8});
    Adds<Z8, false>(t, t, 1.0f, Z2(64), 1, UnaryRepeatParams{1, 1, 8, 8});
    Div<Z8, false>(result, z, t, Z2(64), 1, BinaryRepeatParams{1, 1, 1, 8, 8, 8});
    SetMaskNorm();
    ResetMask();
  } else {
    Mul(t, z, z, count);
    Duplicate(work, -1.5957691216057308f, count);
    Axpy(work, t, -0.071354816275f, count);
    Mul(t, work, z, count);
    Exp(t, t, count);
    Adds(t, t, 1.0f, count);
    Div(result, z, t, count);
  }
  if (outputPending_) {
    SetFlag<HardEvent::MTE3_V>(EVENT_ID5);
    WaitFlag<HardEvent::MTE3_V>(EVENT_ID5);
  }
  Cast(out, result, RoundMode::CAST_RINT, count);
  PipeBarrier<PIPE_V>();
  bool repaired = RepairMidpoints(z, result, t, work, out, validCount, width, cols);
  SetFlag<HardEvent::V_MTE3>(EVENT_ID2);
  WaitFlag<HardEvent::V_MTE3>(EVENT_ID2);
  if (repaired) {
    SetFlag<HardEvent::S_MTE3>(EVENT_ID3);
    WaitFlag<HardEvent::S_MTE3>(EVENT_ID3);
  }
  auto dest = y_[static_cast<Z2>(row + first) * n + col];
  if (cols == n && cols == width)
    DataCopy(dest, out, validCount);
  else
    DataCopyPad(dest, out, DataCopyExtParams{static_cast<Z4>(active), cols * 2, 0, (n - cols) * 2, 0});
  outputPending_ = true;
}
}

private:
__aicore__ inline void MaskOr(LocalTensor<Z6> dst, LocalTensor<Z6> a, LocalTensor<Z6> b, Z0 words) {
auto d = dst.ReinterpretCast<Z5>();
auto x = a.ReinterpretCast<Z5>(), y = b.ReinterpretCast<Z5>();
for (Z0 i = 0; i < words; i += 128)
  Or(d[i], x[i], y[i], static_cast<Z2>(Min(128, words - i)), 1, BinaryRepeatParams{1, 1, 1, 8, 8, 8});
PipeBarrier<PIPE_V>();
ResetMask();
}
__aicore__ inline void MaskAnd(LocalTensor<Z6> dst, LocalTensor<Z6> a, LocalTensor<Z6> b, Z0 words) {
auto d = dst.ReinterpretCast<Z5>();
auto x = a.ReinterpretCast<Z5>(), y = b.ReinterpretCast<Z5>();
for (Z0 i = 0; i < words; i += 128)
  And(d[i], x[i], y[i], static_cast<Z2>(Min(128, words - i)), 1, BinaryRepeatParams{1, 1, 1, 8, 8, 8});
PipeBarrier<PIPE_V>();
ResetMask();
}
__aicore__ inline bool RepairMidpoints(LocalTensor<Z8> z, LocalTensor<Z8> result, LocalTensor<Z8> absolute,
                                     LocalTensor<Z8> work, LocalTensor<half> out, Z0 validCount, Z0 width,
                                     Z0 cols) {
return FullRepairMidpoints(z, result, absolute, work, out, validCount, width, cols);
}
__aicore__ inline bool FullRepairMidpoints(LocalTensor<Z8> z, LocalTensor<Z8> result, LocalTensor<Z8> absolute,
                                         LocalTensor<Z8> work, LocalTensor<half> out, Z0 validCount, Z0 width,
                                         Z0 cols) {
Z0 count = Up(validCount, 64), pad = Up(SIZE / 8, 256);
auto masks = maskBuf_.Get<Z6>(), lower = masks[pad], regions = masks[2 * pad], low = masks[3 * pad];
auto bits32 = work.ReinterpretCast<Z1>();
Adds(bits32, result.ReinterpretCast<Z1>(), Z1(1), count);
PipeBarrier<PIPE_V>();
And(work.ReinterpretCast<Z5>(), work.ReinterpretCast<Z5>(), constMaskBuf_.Get<Z5>(), Z2(128),
    static_cast<Z6>(count / 64), BinaryRepeatParams{1, 1, 1, 8, 8, 0});
PipeBarrier<PIPE_V>();
CompareScalar(masks, bits32, Z1(0x1000), CMPMODE::EQ, count);
CompareScalar(regions, z, 2.0f, CMPMODE::GE, count);
PipeBarrier<PIPE_V>();
MaskAnd(masks, masks, regions, (count + 15) / 16);
auto words = masks.ReinterpretCast<Z1>();
Z0 wc = (count + 31) / 32;
Cast(work, words, RoundMode::CAST_RINT, Up(wc, 64));
CompareScalar(regions, work, 0.0f, CMPMODE::NE, Up(wc, 64));
Z2 selected = 0;
GatherMask(work, wordIndexBuf_.Get<Z8>(), regions.ReinterpretCast<Z0>(), true, wc, GatherMaskParams{1, 1, 8, 1},
           selected);
ResetMask();
SetFlag<HardEvent::V_S>(EVENT_ID4);
WaitFlag<HardEvent::V_S>(EVENT_ID4);
auto bits = out.ReinterpretCast<Z4>();
bool repaired = false;
for (Z0 j = 0; j < static_cast<Z0>(selected); ++j) {
  Z0 word = static_cast<Z0>(static_cast<Z1>(work.GetValue(j))), candidates = (Z0)words.GetValue(word);
  while (candidates) {
    Z0 bit = (Z0)(63 - ScalarCountLeadingZero((Z2)candidates));
    candidates ^= 1U << bit;
    Z0 i = word * 32 + bit;
    if (i >= validCount || i % width >= cols)
      continue;
    Z4 previous = bits.GetValue(i);
    Z0 h = previous & 0x7fffU;
    if (h < 0x4000U)
      continue;
    Z8 zi = z.GetValue(i);
    if (zi == 0.0f || zi >= 8.0f || zi <= -6.0f)
      continue;
    Z4 corrected = herl33repair::FastSharedRepair(zi, previous);
    if (corrected != previous) {
      bits.SetValue(i, corrected);
      repaired = true;
    }
  }
}
return repaired;
}
TBuf<TPosition::VECCALC> rawBuf_, zBuf_, tBuf_, workBuf_;
TBuf<TPosition::VECCALC> outBuf_, maskBuf_, scaleBuf_, wordIndexBuf_, constMaskBuf_;
GlobalTensor<Z8> scale_;
GlobalTensor<half> y_;
Z0 cachedExpert_ = 0xffffffffU, cachedCol_ = 0xffffffffU;
bool outputPending_ = false;
};
} // namespace integer_post
} // namespace gmg
namespace gmg {
namespace short_control {
template <Z0 BM, Z0 BN> class FlatJobs {
public:
__aicore__ FlatJobs(GM_ADDR g, Z0 e, Z0 n, Z0 core, Z0 cores, Z0, Z0)
  : ends_(reinterpret_cast<__gm__ Z3 *>(g)), e_(e), nt_((n + BN - 1) / BN), cores_(cores), next_(core) {}
__aicore__ bool Next(Z0 &expert, Z0 &row, Z0 &col, Z0 &rows, Z0 &cols, Z0 n) {
while (expert_ < e_) {
  if (!loaded_) {
    end_ = static_cast<Z0>(ends_[expert_]);
    count_ = ((end_ - begin_ + BM - 1) / BM) * nt_;
    loaded_ = true;
  }
  if (next_ < count_) {
    expert = expert_;
    row = begin_ + (next_ / nt_) * BM;
    col = (next_ % nt_) * BN;
    rows = Min(BM, end_ - row);
    cols = Min(BN, n - col);
    next_ += cores_;
    return true;
  }
  next_ -= count_;
  begin_ = end_;
  ++expert_;
  loaded_ = false;
}
return false;
}

private:
__gm__ Z3 *ends_;
Z0 e_, nt_, cores_, next_, expert_ = 0, begin_ = 0, end_ = 0, count_ = 0;
bool loaded_ = false;
};
template <Z0 BM, Z0 BN> class ColumnBandJobs {
public:
__aicore__ inline ColumnBandJobs(GM_ADDR g, Z0 e, Z0 n, Z0 core, Z0 cores, Z0 k, Z0 m)
  : ends_((__gm__ Z3 *)g), experts_(e) {
Z0 nt = n / BN, c = core % nt, b = core / nt, bands = (cores + nt - 1 - c) / nt;
col_ = c * BN;
row_ = (Z2)m * b / bands;
last_ = (Z2)m * (b + 1) / bands;
Z0 lo = 0, hi = e;
while (lo < hi) {
  Z0 mid = (lo + hi) / 2;
  if (static_cast<Z0>(ends_[mid]) <= row_)
    lo = mid + 1;
  else
    hi = mid;
}
expert_ = lo;
}
__aicore__ inline bool Next(Z0 &expert, Z0 &row, Z0 &col, Z0 &rows, Z0 &cols, Z0 n) {
while (expert_ < experts_ && row_ < last_) {
  Z0 end = static_cast<Z0>(ends_[expert_]);
  if (end <= row_) {
    expert_++;
    continue;
  }
  expert = expert_;
  row = row_;
  col = col_;
  rows = Min(BM, Min(end, last_) - row_);
  cols = BN;
  row_ += rows;
  return true;
}
return false;
}

private:
__gm__ Z3 *ends_;
Z0 experts_, expert_ = 0, row_, last_, col_;
};
template <Z0 J, Z0 BM, Z0 BN> struct JobSelector {
using Type = ColumnBandJobs<BM, BN>;
};
template <Z0 BM, Z0 BN> struct JobSelector<1, BM, BN> {
using Type = FlatJobs<BM, BN>;
};
template <Z0 BM, Z0 BN> struct JobSelector<2, BM, BN> {
using Type = gmg::BandJobs<BM, BN>;
};
#if defined(__DAV_VEC__) || defined(__DAV_C220_VEC__)

#define GMG_SHORT_CONTROL __attribute__((section(".gmg_zzzzzz_short_math_vec"), aligned(4096)))

#else

#define GMG_SHORT_CONTROL __attribute__((section(".gmg_zzzzzz_short_math_cube"), aligned(4096)))

#endif
template <Z0 BM, Z0 BN, Z0 BK, Z0 LK, bool FAST, Z0 JOB = 0, bool LOAD3D = false, bool PACKED = false>
__global__ __mix__(1, 2) GMG_SHORT_CONTROL
void DirectKernel(GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groups, GM_ADDR y, GM_ADDR workspace,
                  Z0 experts, Z0 m, Z0 n, Z0 k, Z0 cores) {
InitSocState();
constexpr Z0 TILE = BM * BN;
Z0 core = GetBlockIdx(), sub = 0;
if ASCEND_IS_AIV {
sub = core % 2;
core /= 2;
}
typename JobSelector<JOB, BM, BN>::Type jobs(groups, experts, n, core, cores, k, m);
GlobalTensor<Z1> scratch;
scratch.SetGlobalBuffer((__gm__ Z1 *)workspace);
Z0 expert, row, col, rows, cols, sequence = 0;
if ASCEND_IS_AIC {
static_assert(BM * 2048 + 2 * BN * LK <= 480 * 1024, "L1");
static_assert(2 * BM * BK <= 65536 && 2 * BN * BK <= 65536, "L0AB");
static_assert(2 * TILE * 4 <= 131072, "L0C");
LocalTensor<Z7> a1(TPosition::A1, 0, BM * 2048), b1(TPosition::B1, BM * 2048, 2 * BN * LK);
LocalTensor<Z7> a2(TPosition::A2, 0, 2 * BM * BK), b2(TPosition::B2, 0, 2 * BN * BK);
LocalTensor<Z1> c0(TPosition::CO1, 0, 2 * TILE);
InitConstValue(a1.ReinterpretCast<Z4>(), {1, static_cast<Z4>(BM * 2048 / 32), 0, Z4(0)});
PipeBarrier<PIPE_ALL>();
GlobalTensor<Z7> ag, bg;
ag.SetGlobalBuffer((__gm__ Z7 *)x);
bg.SetGlobalBuffer((__gm__ Z7 *)weight);
while (jobs.Next(expert, row, col, rows, cols, n)) {
  for (Z0 mo = 0; mo < rows; mo += BM) {
    Z0 mr = Min(BM, rows - mo), cs = sequence % 2;
    if (sequence >= 2)
      WaitFlag<HardEvent::FIX_M>((event_t)cs);
    Z0 kp = (k + LK - 1) / LK, it = 0;
    for (Z0 panel = 0; panel < kp; panel++) {
      Z0 ls = panel % 2, koff = panel * LK, len = Min(LK, k - koff);
      if (panel == 0) {
        Nd2NzParams ap{};
        ap.ndNum = 1;
        ap.nValue = mr;
        ap.dValue = k;
        ap.srcDValue = k;
        ap.dstNzC0Stride = BM;
        ap.dstNzNStride = 1;
        Nd2NzParams bp{};
        bp.ndNum = 1;
        bp.nValue = len;
        bp.dValue = BN;
        bp.srcDValue = n;
        bp.dstNzC0Stride = LK;
        bp.dstNzNStride = 1;
        DataCopy(a1, ag[(Z2)(row + mo) * k], ap);
        if (PACKED) {
          bp.ndNum = len / 32;
          bp.nValue = 32;
          bp.dstNzC0Stride = 32;
          bp.srcNdMatrixStride = 32 * n;
          bp.dstNzMatrixStride = BN * 32;
        }
        DataCopy(b1, bg[(Z2)expert * k * n + col], bp);
        SetFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);
      }
      if (panel + 1 < kp) {
        Z0 ns = (panel + 1) % 2, nk = (panel + 1) * LK, nlen = Min(LK, k - nk);
        if (panel >= 1)
          WaitFlag<HardEvent::MTE1_MTE2>((event_t)ns);
        Nd2NzParams ap{};
        ap.ndNum = 1;
        ap.nValue = mr;
        ap.dValue = nlen;
        ap.srcDValue = k;
        ap.dstNzC0Stride = BM;
        ap.dstNzNStride = 1;
        Nd2NzParams bp{};
        bp.ndNum = 1;
        bp.nValue = nlen;
        bp.dValue = BN;
        bp.srcDValue = n;
        bp.dstNzC0Stride = LK;
        bp.dstNzNStride = 1;
        if (PACKED) {
          bp.ndNum = nlen / 32;
          bp.nValue = 32;
          bp.dstNzC0Stride = 32;
          bp.srcNdMatrixStride = 32 * n;
          bp.dstNzMatrixStride = BN * 32;
        }
        DataCopy(b1[ns * BN * LK], bg[(Z2)expert * k * n + (Z2)nk * n + col], bp);
        SetFlag<HardEvent::MTE2_MTE1>((event_t)ns);
      }
      WaitFlag<HardEvent::MTE2_MTE1>((event_t)ls);
      for (Z0 ki = 0; ki < len; ki += BK, ++it) {
        Z0 ks = it % 2, kl = Min(BK, len - ki);
        if (it >= 2)
          WaitFlag<HardEvent::M_MTE1>((event_t)ks);
        if (LOAD3D) {
          LoadData3DParamsV2<Z7> ap{};
          ap.l1H = 1;
          ap.l1W = BM;
          ap.channelSize = k;
          ap.kExtension = kl;
          ap.mExtension = Up(mr, 16);
          ap.kStartPt = koff + ki;
          ap.strideH = ap.strideW = ap.filterH = ap.filterW = ap.dilationFilterH = ap.dilationFilterW = 1;
          LoadData(a2[ks * BM * BK], a1, ap);
        } else {
          for (Z0 mi = 0; mi < (mr + 15) / 16; mi++) {
            LoadData2DParams ap{};
            ap.startIndex = mi;
            ap.repeatTimes = kl / 32;
            ap.srcStride = BM / 16;
            LoadData(a2[ks * BM * BK + mi * kl * 16], a1[(koff + ki) * BM], ap);
          }
        }
        if (PACKED) {
          LoadData2dTransposeParams bp{0, static_cast<Z6>((BN / 32) * (kl / 32)), 1, 1, 0};
          LoadDataWithTranspose(b2[ks * BN * BK], b1[ls * BN * LK + ki * BN], bp);
        } else {
          LoadData2dTransposeParams bp{0, static_cast<Z6>(BN / 32), static_cast<Z4>(LK / 32), 1, 0};
          for (Z0 ki0 = 0; ki0 < kl; ki0 += 32)
            LoadDataWithTranspose(b2[ks * BN * BK + ki0 * BN], b1[ls * BN * LK + (ki + ki0) * 32], bp);
        }
        if (ki + kl == len)
          SetFlag<HardEvent::MTE1_MTE2>((event_t)ls);
        SetFlag<HardEvent::MTE1_M>((event_t)ks);
        WaitFlag<HardEvent::MTE1_M>((event_t)ks);
        MmadParams mp{};
        mp.m = Up(mr, 16);
        mp.n = BN;
        mp.k = kl;
        mp.cmatrixInitVal = (it == 0);
        if (it)
          PipeBarrier<PIPE_M>();
        Mmad(c0[cs * TILE], a2[ks * BM * BK], b2[ks * BN * BK], mp);
        SetFlag<HardEvent::M_MTE1>((event_t)ks);
      }
    }
    for (Z0 s = 0; s < Min(it, 2); s++)
      WaitFlag<HardEvent::M_MTE1>((event_t)s);
    for (Z0 s = 0; s < Min(kp, 2); s++)
      WaitFlag<HardEvent::MTE1_MTE2>((event_t)s);
    SetFlag<HardEvent::M_FIX>(EVENT_ID2);
    WaitFlag<HardEvent::M_FIX>(EVENT_ID2);
    if (sequence >= 2)
      CrossCoreWaitFlag(RELEASE);
    FixpipeParamsV220 fp{};
    fp.mSize = mr;
    fp.nSize = BN;
    fp.srcStride = Up(mr, 16);
    fp.dstStride = BN;
    Fixpipe<Z1, Z1, CFG_ROW_MAJOR>(scratch[((Z2)core * 2 + cs) * TILE], c0[cs * TILE], fp);
    SetFlag<HardEvent::FIX_M>((event_t)cs);
    CrossCoreSetFlag<0x2, PIPE_FIX>(READY);
    ++sequence;
  }
}
for (Z0 s = 0; s < Min(sequence, 2); s++)
  WaitFlag<HardEvent::FIX_M>((event_t)s);
for (Z0 s = 0; s < Min(sequence, 2); s++)
  CrossCoreWaitFlag(RELEASE);
PipeBarrier<PIPE_ALL>();
}
if ASCEND_IS_AIV {
TPipe pipe;
integer_post::Epilogue<BM, BN, FAST> ep;
ep.Init(pipe, scale, y);
while (jobs.Next(expert, row, col, rows, cols, n)) {
  for (Z0 mo = 0; mo < rows; mo += BM) {
    CrossCoreWaitFlag<0x2, PIPE_MTE2>(READY);
    ep.Process(scratch[((Z2)core * 2 + sequence % 2) * TILE], expert, row + mo, col, Min(BM, rows - mo), BN, n,
               sub);
    ++sequence;
  }
}
PipeBarrier<PIPE_ALL>();
}
}
template <Z0 BM, Z0 BN, Z0 BK, Z0 LK, bool FAST = true, Z0 JOB = 0, bool LOAD3D = false, bool PACKED = false>
void LaunchDirect(GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR g, GM_ADDR y, Z0 e, Z0 m, Z0 n, Z0 k, Z0 cores,
              aclrtStream stream) {
void *workspace = nullptr;
if (aclrtMalloc(&workspace, (size_t)cores * 2 * BM * BN * 4, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS)
throw std::runtime_error("direct malloc");
DirectKernel<BM, BN, BK, LK, FAST, JOB, LOAD3D, PACKED>
  <<<cores, nullptr, stream>>>(x, w, s, g, y, (Z6 *)workspace, e, m, n, k, cores);
auto status = aclrtSynchronizeStream(stream);
auto freed = aclrtFree(workspace);
if (status || freed)
throw std::runtime_error("direct execution");
}
#undef GMG_SHORT_CONTROL
} // namespace short_control
} // namespace gmg

namespace gmg {
namespace short_control {
__attribute__((noinline)) void Run(GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR g, GM_ADDR y, Z0 e, Z0 m, Z0 n, Z0 k,
                               Z0 cores, aclrtStream stream) {
LaunchDirect<64, 256, 128, 256, true, 0, false, false>(x, w, s, g, y, e, m, n, k, cores, stream);
}
