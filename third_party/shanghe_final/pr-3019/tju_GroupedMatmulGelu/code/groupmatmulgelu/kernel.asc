namespace gmg {
namespace ha36sched2 {
template <Z0 BM, Z0 BN, Z0 Width> class HaJobs {
public:
  __aicore__ inline HaJobs(GM_ADDR groups, Z0 e, Z0 n, Z0 core, Z0 cores, Z0 k, Z0 m)
      : ends_(reinterpret_cast<__gm__ Z3 *>(groups)), experts_(e),
        nTiles_((n + Width - 1) / Width - (n % Width == 1 && BN >= Width + 32 ? 1 : 0)) {
    row_ = static_cast<Z2>(m) * core / cores;
    last_ = static_cast<Z2>(m) * (core + 1) / cores;
    Z0 low = 0, high = e;
    while (low < high) {
      Z0 mid = (low + high) / 2;
      if (static_cast<Z0>(ends_[mid]) <= row_)
        low = mid + 1;
      else
        high = mid;
    }
    expert_ = low;
  }
  __aicore__ inline bool Next(Z0 &expert, Z0 &row, Z0 &col, Z0 &rows, Z0 &cols, Z0 n) {
    while (expert_ < experts_ && row_ < last_) {
      Z0 end = static_cast<Z0>(ends_[expert_]);
      if (end <= row_) {
        ++expert_;
        continue;
      }
      expert = expert_;
      row = row_;
      col = column_ * Width;
      rows = Min(BM, Min(end, last_) - row_);
      cols = column_ + 1 == nTiles_ ? n - col : Width;
      if (++column_ == nTiles_) {
        column_ = 0;
        row_ += rows;
      }
      return true;
    }
    return false;
  }

private:
  __gm__ Z3 *ends_;
  Z0 experts_, nTiles_, expert_ = 0, row_ = 0, last_ = 0, column_ = 0;
};
