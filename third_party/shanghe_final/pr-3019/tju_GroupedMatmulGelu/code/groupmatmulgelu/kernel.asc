#include <cstdint>

#include <stdexcept>

#include "acl/acl.h"

#include "kernel_operator.h"

#include "kernel_tiling/kernel_tiling.h"

#include "lib/matmul_intf.h"

#include "tiling/tiling_api.h"

#include <algorithm>

#include <cstddef>

#include "tiling/platform/platform_ascendc.h"

using Z0 = uint32_t;
using Z1 = int32_t;
using Z2 = uint64_t;
using Z3 = int64_t;
using Z4 = uint16_t;
using Z5 = int16_t;
using Z6 = uint8_t;
using Z7 = int8_t;
using Z8 = float;

// V43: direct FP32 tail approximation, without an accuracy-probe/fallback pass.
namespace precision43 {
__aicore__ inline Z8 Tail(Z8 magnitude) {
#pragma clang fp reassociate(off) contract(off)
Z8 square = magnitude * magnitude;
Z8 argument = (1.5957691216057308f * magnitude) * (1.0f + 0.044715f * square);
Z1 power = static_cast<Z1>(argument * 1.4426950408889634f + 0.5f);
Z8 pf = static_cast<Z8>(power);
Z8 r = (pf * 0.693145751953125f - argument) + pf * 1.428606765330187e-6f;
Z8 p = 1.3888888888888889e-3f;
p = 8.3333333333333333e-3f + r * p;
p = 4.1666666666666667e-2f + r * p;
p = 1.6666666666666667e-1f + r * p;
p = 0.5f + r * p;
p = 1.0f + r * p;
union {
Z0 bits;
Z8 value;
} scale;
scale.bits = static_cast<Z0>(127 - power) << 23;
Z8 t = (1.0f + r * p) * scale.value;
return (magnitude * t) / (1.0f + t);
}
} // namespace precision43

namespace current_backend {
namespace gmg {
using namespace AscendC;
using namespace matmul;
constexpr Z4 READY = 8;
constexpr Z4 RELEASE = 9;
__aicore__ inline Z0 Min(Z0 a, Z0 b) {
return a < b ? a : b;
}
__aicore__ inline Z0 Up(Z0 a, Z0 b) {
return (a + b - 1) / b * b;
}
__aicore__ constexpr MatmulConfig CubeConfig() {
MatmulConfig c = CFG_MDL;
c.enableSetBias = false;
c.enableQuantVector = false;
c.enableSetDefineData = false;
return c;
}
constexpr MatmulConfig MM_CONFIG = CubeConfig();
struct Pair {
Z8 hi, lo;
};
__aicore__ inline Pair AddPair(Pair a, Pair b) {
volatile Z8 s = a.hi + b.hi;
volatile Z8 v = s - a.hi;
volatile Z8 w = s - v;
volatile Z8 e0 = a.hi - w;
volatile Z8 e1 = b.hi - v;
volatile Z8 e2 = e0 + e1;
volatile Z8 e3 = a.lo + b.lo;
volatile Z8 e = e2 + e3;
volatile Z8 h = s + e;
volatile Z8 t = h - s;
return {h, e - t};
}
__aicore__ inline Pair NegPair(Pair a) {
return {-a.hi, -a.lo};
}
__aicore__ inline Pair MulPair(Pair a, Pair b) {
volatile Z8 p = a.hi * b.hi;
volatile Z8 sa = a.hi * 4097.0f;
volatile Z8 sb = b.hi * 4097.0f;
volatile Z8 ta = sa - a.hi;
volatile Z8 tb = sb - b.hi;
volatile Z8 ah = sa - ta;
volatile Z8 bh = sb - tb;
volatile Z8 al = a.hi - ah;
volatile Z8 bl = b.hi - bh;
volatile Z8 hh = ah * bh;
volatile Z8 e0 = hh - p;
volatile Z8 hl = ah * bl;
volatile Z8 lh = al * bh;
volatile Z8 ll = al * bl;
volatile Z8 e1 = e0 + hl;
volatile Z8 e2 = e1 + lh;
volatile Z8 e3 = e2 + ll;
volatile Z8 c0 = a.hi * b.lo;
volatile Z8 c1 = a.lo * b.hi;
volatile Z8 c2 = a.lo * b.lo;
volatile Z8 e4 = e3 + c0;
volatile Z8 e5 = e4 + c1;
volatile Z8 e = e5 + c2;
volatile Z8 h = p + e;
volatile Z8 t = h - p;
return {h, e - t};
}
__aicore__ inline Pair DivPair(Pair a, Pair b) {
volatile Z8 q = a.hi / b.hi;
Pair r = AddPair(a, NegPair(MulPair(b, {q, 0.0f})));
volatile Z8 rsum = r.hi + r.lo;
volatile Z8 tail = rsum / b.hi;
return AddPair({q, 0.0f}, {tail, 0.0f});
}
__aicore__ inline Pair ExpPair(Pair a) {
Z1 power = static_cast<Z1>(a.hi * 1.4426950408889634f - 0.5f);
Pair r = AddPair(a, NegPair(MulPair({static_cast<Z8>(power), 0.0f}, {0.6931471824645996f, -1.904654323148236e-9f})));
volatile Z8 high = 2.0876755879584152e-9f;
high = high * r.hi + 2.5052107943679403e-8f;
high = high * r.hi + 2.755731998149713e-7f;
high = high * r.hi + 2.7557318844628753e-6f;
high = high * r.hi + 2.4801587642286904e-5f;
Pair sum{high, 0.0f};
sum = AddPair(MulPair(sum, r), {1.9841270113829523e-4f, -2.7255968207233472e-12f});
sum = AddPair(MulPair(sum, r), {1.3888889225199819e-3f, -3.3631092919220174e-11f});
sum = AddPair(MulPair(sum, r), {8.3333337679505348e-3f, -4.3461720160287154e-10f});
sum = AddPair(MulPair(sum, r), {4.1666667908430099e-2f, -1.2417634351336027e-9f});
sum = AddPair(MulPair(sum, r), {1.6666667163372040e-1f, -4.9670537405344106e-9f});
sum = AddPair(MulPair(sum, r), {0.5f, 0.0f});
sum = AddPair(MulPair(sum, r), {1.0f, 0.0f});
sum = AddPair(MulPair(sum, r), {1.0f, 0.0f});
union {
Z0 bits;
Z8 value;
} scale;
scale.bits = static_cast<Z0>(power + 127) << 23;
return MulPair(sum, {scale.value, 0.0f});
}
__aicore__ inline Pair AccurateGelu(Z8 z) {
if (z >= 8.0f)
return {z, 0.0f};
if (z <= -6.0f)
return {0.0f, 0.0f};
Pair a{z, 0.0f};
Pair square = MulPair(a, a);
Pair p = AddPair({1.0f, 0.0f}, MulPair(square, {0.044714998453855515f, 1.5461444832776117e-9f}));
Pair arg = MulPair(MulPair(a, p), {1.5957691669464111f, -4.534068032135963e-8f});
if (z > 0.0f && arg.hi > 36.7368005696771f)
return a;
Pair t = ExpPair(z >= 0.0f ? NegPair(arg) : arg);
Pair correction = DivPair(MulPair(a, t), AddPair({1.0f, 0.0f}, t));
return z >= 0.0f ? AddPair(a, NegPair(correction)) : correction;
}
__aicore__ inline Z8 HalfMagnitude(Z0 h) {
if (h < 1024)
return static_cast<Z8>(static_cast<Z1>(h)) * 5.9604644775390625e-8f;
union {
Z0 bits;
Z8 value;
} u;
u.bits = (h << 13) + (112U << 23);
return u.value;
}
__aicore__ inline int ComparePair(Pair x, Z8 v) {
Pair d = AddPair(x, {-v, 0.0f});
if (d.hi != 0.0f)
return d.hi < 0.0f ? -1 : 1;
return d.lo < 0.0f ? -1 : (d.lo > 0.0f ? 1 : 0);
}
__aicore__ inline Z4 PositiveTailHalf(Z8 z) {
union {
Z8 value;
Z0 bits;
} u;
u.value = z;
Z0 h = (u.bits >> 13) - (112U << 10);
h += (u.bits & 0x1fffU) > 0x1000U;
return static_cast<Z4>(h);
}
__aicore__ inline Z4 CorrectHalf(Z8 z, Z4 previous) {
if (z == 0.0f || z >= 8.0f)
return previous;
if (z <= -6.0f)
return 0x8000U;
if (z >= 5.0f && z <= 7.0f)
return PositiveTailHalf(z);
Z0 h = previous & 0x7fffU;
if (h >= 1002 && h < 0x4000U)
return previous;
Pair a = AccurateGelu(z);
if (z < 0.0f)
a = NegPair(a);
Z8 center = HalfMagnitude(h);
Z8 lower = h == 0 ? 0.0f : 0.5f * (center + HalfMagnitude(h - 1));
Z8 upper = 0.5f * (center + HalfMagnitude(h + 1));
int lo = ComparePair(a, lower), hi = ComparePair(a, upper);
if (h && (lo < 0 || (lo == 0 && (h & 1))))
--h;
else if (hi > 0 || (hi == 0 && (h & 1)))
++h;
return static_cast<Z4>(h | (z < 0.0f ? 0x8000U : 0U));
}
template <Z0 BM, Z0 BN> class Jobs {
public:
__aicore__ inline Jobs(GM_ADDR groups, Z0 e, Z0 n, Z0 core, Z0 cores, Z0 k, Z0 m)
  : ends_(reinterpret_cast<__gm__ Z3 *>(groups)), experts_(e), nTiles_((n + BN - 1) / BN), cores_(cores),
    next_(core), fullN_(n % BN == 0), k_(k) {
if (!fullN_ && nTiles_ > 1 && n % BN <= BN / 4) {
  Z0 a = cores_, b = nTiles_;
  while (b) {
    Z0 remainder = a % b;
    a = b;
    b = remainder;
  }
  rotateTails_ = a > 1;
}
bandMode_ = m <= e * 4 && n >= 64 && n <= 128 && n % 32 == 0 && static_cast<Z2>(k) * n >= 32768;
if (bandMode_) {
  bandRow_ = static_cast<Z2>(m) * core / cores;
  bandEnd_ = static_cast<Z2>(m) * (core + 1) / cores;
  Z0 low = 0, high = e;
  while (low < high) {
    Z0 mid = (low + high) / 2;
    if (static_cast<Z0>(ends_[mid]) <= bandRow_)
      low = mid + 1;
    else
      high = mid;
  }
  expert_ = low;
}
}
__aicore__ inline bool Next(Z0 &expert, Z0 &row, Z0 &col, Z0 &rows, Z0 &cols, Z0 n) {
if (bandMode_) {
  while (expert_ < experts_ && bandRow_ < bandEnd_) {
    Z0 end = static_cast<Z0>(ends_[expert_]);
    if (end <= bandRow_) {
      ++expert_;
      continue;
    }
    expert = expert_;
    row = bandRow_;
    col = bandCol_ * BN;
    rows = Min(BM, Min(end, bandEnd_) - row);
    cols = Min(BN, n - col);
    if (++bandCol_ == nTiles_) {
      bandCol_ = 0;
      bandRow_ += rows;
    }
    return true;
  }
  return false;
}
while (expert_ < experts_) {
  if (!loaded_) {
    end_ = static_cast<Z0>(ends_[expert_]);
    Z0 mTiles = (end_ - begin_ + BM - 1) / BM;
    panel_ = fullN_ && k_ * BN <= 256 * 1024 && mTiles >= 4 && mTiles * nTiles_ >= cores_ * 8 ? 4 : 1;
    mPanels_ = (mTiles + panel_ - 1) / panel_;
    count_ = mPanels_ * nTiles_;
    loaded_ = true;
  }
  if (next_ < count_) {
    expert = expert_;
    if (panel_ == 1) {
      row = begin_ + (next_ / nTiles_) * BM;
      Z0 columnTile = next_ % nTiles_;
      if (rotateTails_) {
        Z0 waveRows = (cores_ + nTiles_ - 1) / nTiles_;
        Z0 rotation = expert_ + (next_ / nTiles_) / waveRows;
        columnTile = (columnTile + rotation) % nTiles_;
      }
      col = columnTile * BN;
    } else {
      row = begin_ + (next_ % mPanels_) * (BM * panel_);
      col = (next_ / mPanels_) * BN;
    }
    rows = Min(BM * panel_, end_ - row);
    cols = Min(BN, n - col);
    next_ += cores_;
    return true;
  }
  next_ -= count_;
  begin_ = end_;
  ++expert_;
  loaded_ = false;
}
return false;
}

private:
__gm__ Z3 *ends_;
Z0 experts_, nTiles_, cores_, next_;
bool rotateTails_ = false;
bool fullN_;
Z0 k_;
Z0 expert_ = 0, begin_ = 0;
Z0 end_ = 0, count_ = 0, mPanels_ = 0, panel_ = 1;
bool loaded_ = false;
bool bandMode_ = false;
Z0 bandRow_ = 0, bandEnd_ = 0, bandCol_ = 0;
};
template <Z0 BM, Z0 BN> class BandJobs {
public:
__aicore__ inline BandJobs(GM_ADDR groups, Z0 e, Z0 n, Z0 core, Z0 cores, Z0 k, Z0 m)
  : ends_(reinterpret_cast<__gm__ Z3 *>(groups)), experts_(e), nTiles_((n + BN - 1) / BN) {
row_ = static_cast<Z2>(m) * core / cores;
last_ = static_cast<Z2>(m) * (core + 1) / cores;
Z0 low = 0, high = e;
while (low < high) {
  Z0 mid = (low + high) / 2;
  if (static_cast<Z0>(ends_[mid]) <= row_)
    low = mid + 1;
  else
    high = mid;
}
expert_ = low;
}
__aicore__ inline bool Next(Z0 &expert, Z0 &row, Z0 &col, Z0 &rows, Z0 &cols, Z0 n) {
while (expert_ < experts_ && row_ < last_) {
  Z0 end = static_cast<Z0>(ends_[expert_]);
  if (end <= row_) {
    ++expert_;
    continue;
  }
  expert = expert_;
  row = row_;
  col = column_ * BN;
  rows = Min(BM, Min(end, last_) - row_);
  cols = Min(BN, n - col);
  if (++column_ == nTiles_) {
    column_ = 0;
    row_ += rows;
  }
  return true;
}
return false;
}

private:
__gm__ Z3 *ends_;
Z0 experts_, nTiles_, expert_ = 0, row_ = 0, last_ = 0, column_ = 0;
};
template <bool BAND, Z0 BM, Z0 BN> struct JobType {
using Type = Jobs<BM, BN>;
};
template <Z0 BM, Z0 BN> struct JobType<true, BM, BN> {
using Type = BandJobs<BM, BN>;
};
template <Z0 BM, Z0 BN> class Epilogue {
public:
static constexpr Z0 HALF_ROWS = (BM + 1) / 2;
static constexpr Z0 SIZE = HALF_ROWS * BN;
__aicore__ inline void Init(TPipe &pipe, GM_ADDR scale, GM_ADDR y) {
pipe.InitBuffer(rawBuf_, SIZE * 4);
pipe.InitBuffer(zBuf_, SIZE * 4);
pipe.InitBuffer(tBuf_, SIZE * 4);
pipe.InitBuffer(workBuf_, SIZE * 4);
pipe.InitBuffer(outBuf_, SIZE * 2);
pipe.InitBuffer(maskBuf_, 4 * Up(SIZE / 8, 256));
pipe.InitBuffer(scaleBuf_, Up(BN, 64) * 4);
scale_.SetGlobalBuffer(reinterpret_cast<__gm__ Z8 *>(scale));
y_.SetGlobalBuffer(reinterpret_cast<__gm__ half *>(y));
}
__aicore__ inline void Process(const GlobalTensor<Z1> &scratch, Z0 expert, Z0 row, Z0 col, Z0 rows, Z0 cols, Z0 n,
                             Z0 sub) {
Z0 split = (rows + 1) / 2;
Z0 first = sub * split;
Z0 active = first < rows ? Min(split, rows - first) : 0;
if (active == 0) {
  CrossCoreSetFlag<0x2, PIPE_MTE2>(RELEASE);
} else {
  Z0 width = Up(cols, 16);
  Z0 validCount = active * width;
  Z0 count = Up(validCount, 64);
  auto raw = rawBuf_.Get<Z1>();
  auto z = zBuf_.Get<Z8>();
  auto t = tBuf_.Get<Z8>();
  auto work = workBuf_.Get<Z8>();
  auto sc = scaleBuf_.Get<Z8>();
  auto out = outBuf_.Get<half>();
  bool loadScale = expert != cachedExpert_ || col != cachedCol_;
  bool clearRaw = cols != width || count != validCount;
  bool clearScale = loadScale && (cols != width || width % 64 != 0);
  if (clearRaw)
    Duplicate(raw, Z1(0), count);
  if (clearScale)
    Duplicate(sc, 0.0f, Up(width, 64));
  if (clearRaw || clearScale) {
    SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
    WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
  }
  if (cols == BN) {
    DataCopy(raw, scratch[first * BN], validCount);
  } else {
    DataCopyPad(raw, scratch[first * BN],
                DataCopyExtParams{static_cast<Z4>(active), cols * 4, (BN - cols) * 4, (width - Up(cols, 8)) / 8, 0},
                DataCopyPadExtParams<Z1>{true, 0, static_cast<Z6>(Up(cols, 8) - cols), 0});
  }
  if (loadScale) {
    DataCopyPad(sc, scale_[static_cast<Z2>(expert) * n + col], DataCopyExtParams{1, cols * 4, 0, 0, 0},
                DataCopyPadExtParams<Z8>{true, 0, static_cast<Z6>(Up(cols, 8) - cols), 0.0f});
    cachedExpert_ = expert;
    cachedCol_ = col;
  }
  CrossCoreSetFlag<0x2, PIPE_MTE2>(RELEASE);
  SetFlag<HardEvent::MTE2_V>(EVENT_ID1);
  WaitFlag<HardEvent::MTE2_V>(EVENT_ID1);
  Cast(z, raw, RoundMode::CAST_RINT, count);
  PipeBarrier<PIPE_V>();
  for (Z0 c = 0; c < width; c += 64) {
    Mul(z[c], z[c], sc[c], static_cast<Z2>(Min(64, width - c)), static_cast<Z6>(active),
        BinaryRepeatParams{1, 1, 1, static_cast<Z6>(width / 8), static_cast<Z6>(width / 8), 0});
  }
  PipeBarrier<PIPE_V>();
  ResetMask();
  Mul(t, z, z, count);
  PipeBarrier<PIPE_V>();
  Muls(t, t, 0.044715f, count);
  PipeBarrier<PIPE_V>();
  Adds(t, t, 1.0f, count);
  PipeBarrier<PIPE_V>();
  Mul(t, t, z, count);
  PipeBarrier<PIPE_V>();
  Muls(t, t, -1.5957691216057308f, count);
  PipeBarrier<PIPE_V>();
  Maxs(t, t, -80.0f, count);
  PipeBarrier<PIPE_V>();
  Mins(t, t, 80.0f, count);
  PipeBarrier<PIPE_V>();
  Exp(t, t, count);
  PipeBarrier<PIPE_V>();
  Adds(t, t, 1.0f, count);
  PipeBarrier<PIPE_V>();
  auto result = raw.ReinterpretCast<Z8>();
  Div(result, z, t, count);
  PipeBarrier<PIPE_V>();
  if (outputPending_) {
    SetFlag<HardEvent::MTE3_V>(EVENT_ID5);
    WaitFlag<HardEvent::MTE3_V>(EVENT_ID5);
  }
  Cast(out, result, RoundMode::CAST_RINT, count);
  PipeBarrier<PIPE_V>();
  bool repaired = RepairMidpoints(z, result, t, work, out, validCount, width, cols);
  SetFlag<HardEvent::V_MTE3>(EVENT_ID2);
  WaitFlag<HardEvent::V_MTE3>(EVENT_ID2);
  if (repaired) {
    SetFlag<HardEvent::S_MTE3>(EVENT_ID3);
    WaitFlag<HardEvent::S_MTE3>(EVENT_ID3);
  }
  auto dest = y_[static_cast<Z2>(row + first) * n + col];
  if (cols == n && cols == width)
    DataCopy(dest, out, validCount);
  else
    DataCopyPad(dest, out, DataCopyExtParams{static_cast<Z4>(active), cols * 2, 0, (n - cols) * 2, 0});
  outputPending_ = true;
}
}

private:
__aicore__ inline void MaskOr(LocalTensor<Z6> dst, LocalTensor<Z6> a, LocalTensor<Z6> b, Z0 words) {
auto d = dst.ReinterpretCast<Z5>();
auto x = a.ReinterpretCast<Z5>(), y = b.ReinterpretCast<Z5>();
for (Z0 i = 0; i < words; i += 128)
  Or(d[i], x[i], y[i], static_cast<Z2>(Min(128, words - i)), 1, BinaryRepeatParams{1, 1, 1, 8, 8, 8});
PipeBarrier<PIPE_V>();
ResetMask();
}
__aicore__ inline void MaskAnd(LocalTensor<Z6> dst, LocalTensor<Z6> a, LocalTensor<Z6> b, Z0 words) {
auto d = dst.ReinterpretCast<Z5>();
auto x = a.ReinterpretCast<Z5>(), y = b.ReinterpretCast<Z5>();
for (Z0 i = 0; i < words; i += 128)
  And(d[i], x[i], y[i], static_cast<Z2>(Min(128, words - i)), 1, BinaryRepeatParams{1, 1, 1, 8, 8, 8});
PipeBarrier<PIPE_V>();
ResetMask();
}
__aicore__ inline bool RepairMidpoints(LocalTensor<Z8> z, LocalTensor<Z8> result, LocalTensor<Z8> absolute,
                                     LocalTensor<Z8> work, LocalTensor<half> out, Z0 validCount, Z0 width,
                                     Z0 cols) {
Z0 count = Up(validCount, 64);
auto masks = maskBuf_.Get<Z6>();
auto regions = masks[2 * Up(SIZE / 8, 256)];
auto integer = work.ReinterpretCast<Z1>();
Duplicate(integer, Z1(0x1fff), count);
PipeBarrier<PIPE_V>();
And(work.ReinterpretCast<Z5>(), result.ReinterpretCast<Z5>(), work.ReinterpretCast<Z5>(), count * 2);
PipeBarrier<PIPE_V>();
Cast(absolute, integer, RoundMode::CAST_RINT, count);
PipeBarrier<PIPE_V>();
Adds(absolute, absolute, -4096.0f, count);
PipeBarrier<PIPE_V>();
Abs(absolute, absolute, count);
PipeBarrier<PIPE_V>();
CompareScalar(masks, absolute, 2.0f, CMPMODE::LT, count);
PipeBarrier<PIPE_V>();
CompareScalar(regions, z, 2.0f, CMPMODE::GE, count);
PipeBarrier<PIPE_V>();
MaskAnd(masks, masks, regions, (count + 15) / 16);
Z2 selected = 0;
if (count >= 1024) {
  CreateVecIndex(result, 0.0f, count);
  PipeBarrier<PIPE_V>();
  GatherMask(work, result, masks.ReinterpretCast<Z0>(), true, count, GatherMaskParams{1, 1, 8, 1}, selected);
  PipeBarrier<PIPE_V>();
  ResetMask();
}
SetFlag<HardEvent::V_S>(EVENT_ID4);
WaitFlag<HardEvent::V_S>(EVENT_ID4);
auto upperWords = masks.ReinterpretCast<Z0>();
auto bits = out.ReinterpretCast<Z4>();
bool repaired = false;
if (count >= 1024) {
  for (Z0 j = 0; j < static_cast<Z0>(selected); ++j) {
    Z0 i = static_cast<Z0>(static_cast<Z1>(work.GetValue(j)));
    if (i >= validCount || i % width >= cols)
      continue;
    Z4 previous = bits.GetValue(i);
    Z0 h = previous & 0x7fffU;
    if (h < 0x4000U)
      continue;
    Z8 zi = z.GetValue(i);
    if (zi == 0.0f || zi >= 8.0f || zi <= -6.0f)
      continue;
    Z4 corrected = CorrectHalf(zi, previous);
    if (corrected != previous) {
      bits.SetValue(i, corrected);
      repaired = true;
    }
  }
  return repaired;
}
for (Z0 word = 0; word < (count + 31) / 32; ++word) {
  Z0 candidates = upperWords.GetValue(word);
  while (candidates) {
    Z0 bit = static_cast<Z0>(63 - ScalarCountLeadingZero(static_cast<Z2>(candidates)));
    candidates ^= 1U << bit;
    Z0 i = word * 32 + bit;
    if (i >= validCount || i % width >= cols)
      continue;
    Z4 previous = bits.GetValue(i);
    Z0 h = previous & 0x7fffU;
    if (h < 0x4000U)
      continue;
    Z8 zi = z.GetValue(i);
    if (zi == 0.0f || zi >= 8.0f || zi <= -6.0f)
      continue;
    Z4 corrected = CorrectHalf(zi, previous);
    if (corrected != previous) {
      bits.SetValue(i, corrected);
      repaired = true;
    }
  }
}
return repaired;
}
TBuf<TPosition::VECCALC> rawBuf_, zBuf_, tBuf_, workBuf_;
TBuf<TPosition::VECCALC> outBuf_, maskBuf_, scaleBuf_;
GlobalTensor<Z8> scale_;
GlobalTensor<half> y_;
Z0 cachedExpert_ = 0xffffffffU, cachedCol_ = 0xffffffffU;
bool outputPending_ = false;
};
template <Z0 BM, Z0 BN> class FastEpilogue {
public:
static constexpr Z0 HALF_ROWS = (BM + 1) / 2;
static constexpr Z0 SIZE = HALF_ROWS * BN;
__aicore__ inline void Init(TPipe &pipe, GM_ADDR scale, GM_ADDR y) {
pipe.InitBuffer(rawBuf_, SIZE * 4);
pipe.InitBuffer(zBuf_, SIZE * 4);
pipe.InitBuffer(tBuf_, SIZE * 4);
pipe.InitBuffer(workBuf_, SIZE * 4);
pipe.InitBuffer(outBuf_, SIZE * 2);
pipe.InitBuffer(maskBuf_, 4 * Up(SIZE / 8, 256));
pipe.InitBuffer(scaleBuf_, Up(BN, 64) * 4);
scale_.SetGlobalBuffer(reinterpret_cast<__gm__ Z8 *>(scale));
y_.SetGlobalBuffer(reinterpret_cast<__gm__ half *>(y));
}
__aicore__ inline void Process(const GlobalTensor<Z1> &scratch, Z0 expert, Z0 row, Z0 col, Z0 rows, Z0 cols, Z0 n,
                             Z0 sub) {
Z0 split = (rows + 1) / 2;
Z0 first = sub * split;
Z0 active = first < rows ? Min(split, rows - first) : 0;
if (active == 0) {
  CrossCoreSetFlag<0x2, PIPE_MTE2>(RELEASE);
} else {
  Z0 width = Up(cols, 16);
  Z0 validCount = active * width;
  Z0 count = Up(validCount, 64);
  auto raw = rawBuf_.Get<Z1>();
  auto z = zBuf_.Get<Z8>();
  auto t = tBuf_.Get<Z8>();
  auto work = workBuf_.Get<Z8>();
  auto sc = scaleBuf_.Get<Z8>();
  auto out = outBuf_.Get<half>();
  bool loadScale = expert != cachedExpert_ || col != cachedCol_;
  bool clearRaw = cols != width || count != validCount;
  bool clearScale = loadScale && (cols != width || width % 64 != 0);
  if (clearRaw)
    Duplicate(raw, Z1(0), count);
  if (clearScale)
    Duplicate(sc, 0.0f, Up(width, 64));
  if (clearRaw || clearScale) {
    SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
    WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
  }
  if (cols == BN) {
    DataCopy(raw, scratch[first * BN], validCount);
  } else {
    DataCopyPad(raw, scratch[first * BN],
                DataCopyExtParams{static_cast<Z4>(active), cols * 4, (BN - cols) * 4, (width - Up(cols, 8)) / 8, 0},
                DataCopyPadExtParams<Z1>{true, 0, static_cast<Z6>(Up(cols, 8) - cols), 0});
  }
  if (loadScale) {
    DataCopyPad(sc, scale_[static_cast<Z2>(expert) * n + col], DataCopyExtParams{1, cols * 4, 0, 0, 0},
                DataCopyPadExtParams<Z8>{true, 0, static_cast<Z6>(Up(cols, 8) - cols), 0.0f});
    cachedExpert_ = expert;
    cachedCol_ = col;
  }
  CrossCoreSetFlag<0x2, PIPE_MTE2>(RELEASE);
  SetFlag<HardEvent::MTE2_V>(EVENT_ID1);
  WaitFlag<HardEvent::MTE2_V>(EVENT_ID1);
  Cast(z, raw, RoundMode::CAST_RINT, count);
  PipeBarrier<PIPE_V>();
  for (Z0 c = 0; c < width; c += 64) {
    Mul(z[c], z[c], sc[c], static_cast<Z2>(Min(64, width - c)), static_cast<Z6>(active),
        BinaryRepeatParams{1, 1, 1, static_cast<Z6>(width / 8), static_cast<Z6>(width / 8), 0});
  }
  PipeBarrier<PIPE_V>();
  ResetMask();
  Mul(t, z, z, count);
  Duplicate(work, -1.5957691216057308f, count);
  Axpy(work, t, -0.071354816275f, count);
  Mul(t, work, z, count);
  Exp(t, t, count);
  Adds(t, t, 1.0f, count);
  auto result = raw.ReinterpretCast<Z8>();
  Div(result, z, t, count);
  if (outputPending_) {
    SetFlag<HardEvent::MTE3_V>(EVENT_ID5);
    WaitFlag<HardEvent::MTE3_V>(EVENT_ID5);
  }
  Cast(out, result, RoundMode::CAST_RINT, count);
  PipeBarrier<PIPE_V>();
  bool repaired = RepairMidpoints(z, result, t, work, out, validCount, width, cols);
  SetFlag<HardEvent::V_MTE3>(EVENT_ID2);
  WaitFlag<HardEvent::V_MTE3>(EVENT_ID2);
  if (repaired) {
    SetFlag<HardEvent::S_MTE3>(EVENT_ID3);
    WaitFlag<HardEvent::S_MTE3>(EVENT_ID3);
  }
  auto dest = y_[static_cast<Z2>(row + first) * n + col];
  if (cols == n && cols == width)
    DataCopy(dest, out, validCount);
  else
    DataCopyPad(dest, out, DataCopyExtParams{static_cast<Z4>(active), cols * 2, 0, (n - cols) * 2, 0});
  outputPending_ = true;
}
}

private:

__aicore__ inline void MaskAnd(LocalTensor<Z6> dst, LocalTensor<Z6> a, LocalTensor<Z6> b, Z0 words) {
auto d = dst.ReinterpretCast<Z5>();
auto x = a.ReinterpretCast<Z5>(), y = b.ReinterpretCast<Z5>();
for (Z0 i = 0; i < words; i += 128)
  And(d[i], x[i], y[i], static_cast<Z2>(Min(128, words - i)), 1, BinaryRepeatParams{1, 1, 1, 8, 8, 8});
PipeBarrier<PIPE_V>();
ResetMask();
}
__aicore__ inline bool RepairMidpoints(LocalTensor<Z8> z, LocalTensor<Z8> result, LocalTensor<Z8> absolute,
                                     LocalTensor<Z8> work, LocalTensor<half> out, Z0 validCount, Z0 width,
                                     Z0 cols) {
Z0 count = Up(validCount, 64);
auto masks = maskBuf_.Get<Z6>();
auto regions = masks[2 * Up(SIZE / 8, 256)];
auto integer = work.ReinterpretCast<Z1>();
Duplicate(integer, Z1(0x1fff), count);
PipeBarrier<PIPE_V>();
And(work.ReinterpretCast<Z5>(), result.ReinterpretCast<Z5>(), work.ReinterpretCast<Z5>(), count * 2);
PipeBarrier<PIPE_V>();
Cast(absolute, integer, RoundMode::CAST_RINT, count);
PipeBarrier<PIPE_V>();
Adds(absolute, absolute, -4096.0f, count);
PipeBarrier<PIPE_V>();
Abs(absolute, absolute, count);
PipeBarrier<PIPE_V>();
CompareScalar(masks, absolute, 2.0f, CMPMODE::LT, count);
PipeBarrier<PIPE_V>();
CompareScalar(regions, z, 2.0f, CMPMODE::GE, count);
PipeBarrier<PIPE_V>();
MaskAnd(masks, masks, regions, (count + 15) / 16);
Z2 selected = 0;
if (count >= 1024) {
  CreateVecIndex(result, 0.0f, count);
  PipeBarrier<PIPE_V>();
  GatherMask(work, result, masks.ReinterpretCast<Z0>(), true, count, GatherMaskParams{1, 1, 8, 1}, selected);
  PipeBarrier<PIPE_V>();
  ResetMask();
}
SetFlag<HardEvent::V_S>(EVENT_ID4);
WaitFlag<HardEvent::V_S>(EVENT_ID4);
auto upperWords = masks.ReinterpretCast<Z0>();
auto bits = out.ReinterpretCast<Z4>();
bool repaired = false;
if (count >= 1024) {
  for (Z0 j = 0; j < static_cast<Z0>(selected); ++j) {
    Z0 i = static_cast<Z0>(static_cast<Z1>(work.GetValue(j)));
    if (i >= validCount || i % width >= cols)
      continue;
    Z4 previous = bits.GetValue(i);
    Z0 h = previous & 0x7fffU;
    if (h < 0x4000U)
      continue;
    Z8 zi = z.GetValue(i);
    if (zi == 0.0f || zi >= 8.0f || zi <= -6.0f)
      continue;
    Z4 corrected = CorrectHalf(zi, previous);
    if (corrected != previous) {
      bits.SetValue(i, corrected);
      repaired = true;
    }
  }
  return repaired;
}
for (Z0 word = 0; word < (count + 31) / 32; ++word) {
  Z0 candidates = upperWords.GetValue(word);
  while (candidates) {
    Z0 bit = static_cast<Z0>(63 - ScalarCountLeadingZero(static_cast<Z2>(candidates)));
    candidates ^= 1U << bit;
    Z0 i = word * 32 + bit;
    if (i >= validCount || i % width >= cols)
      continue;
    Z4 previous = bits.GetValue(i);
    Z0 h = previous & 0x7fffU;
    if (h < 0x4000U)
      continue;
    Z8 zi = z.GetValue(i);
    if (zi == 0.0f || zi >= 8.0f || zi <= -6.0f)
      continue;
    Z4 corrected = CorrectHalf(zi, previous);
    if (corrected != previous) {
      bits.SetValue(i, corrected);
      repaired = true;
    }
  }
}
return repaired;
}
TBuf<TPosition::VECCALC> rawBuf_, zBuf_, tBuf_, workBuf_;
TBuf<TPosition::VECCALC> outBuf_, maskBuf_, scaleBuf_;
GlobalTensor<Z8> scale_;
GlobalTensor<half> y_;
Z0 cachedExpert_ = 0xffffffffU, cachedCol_ = 0xffffffffU;
bool outputPending_ = false;
};
template <bool FAST, Z0 BM, Z0 BN> struct EpiType {
using Type = FastEpilogue<BM, BN>;
};
template <Z0 BM, Z0 BN> struct EpiType<true, BM, BN> {
using Type = FastEpilogue<BM, BN>;
};
template <Z0 BM, Z0 BN, bool BAND = false>
__global__ __mix__(1, 2) void Kernel(GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groups, GM_ADDR y,
                                 GM_ADDR workspace, TCubeTiling tiling, Z0 experts, Z0 n, Z0 k, Z0 cores, Z0 m) {
constexpr Z0 TILE = BM * BN;
InitSocState();
Z0 core = GetBlockIdx();
Z0 sub = 0;
if ASCEND_IS_AIV {
sub = core % 2;
core /= 2;
}
typename JobType<BAND, BM, BN>::Type jobs(groups, experts, n, core, cores, k, m);
GlobalTensor<Z1> scratch;
scratch.SetGlobalBuffer(reinterpret_cast<__gm__ Z1 *>(workspace));
Z0 expert, row, col, rows, cols, sequence = 0;
if ASCEND_IS_AIC {
TPipe pipe;
MatmulImpl<MatmulType<TPosition::GM, CubeFormat::ND, Z7, false>,
           MatmulType<TPosition::GM, CubeFormat::ND, Z7, false>, MatmulType<TPosition::GM, CubeFormat::ND, Z1>,
           MatmulType<TPosition::GM, CubeFormat::ND, Z1>, MM_CONFIG>
    mm;
mm.SetSubBlockIdx(0);
mm.Init(&tiling, &pipe);
GlobalTensor<Z7> a, b;
a.SetGlobalBuffer(reinterpret_cast<__gm__ Z7 *>(x));
b.SetGlobalBuffer(reinterpret_cast<__gm__ Z7 *>(weight));
mm.SetOrgShape(tiling.M, n, k, k, BN);
while (jobs.Next(expert, row, col, rows, cols, n)) {
  mm.SetSingleShape(rows, cols, k);
  mm.SetTensorA(a[static_cast<Z2>(row) * k], false);
  mm.SetTensorB(b[static_cast<Z2>(expert) * k * n + col], false);
  while (mm.Iterate()) {
    if (sequence >= 2)
      CrossCoreWaitFlag(RELEASE);
    auto dest = scratch[(static_cast<Z2>(core) * 2 + sequence % 2) * TILE];
    mm.GetTensorC(dest, 0, rows > BM);
    CrossCoreSetFlag<0x2, PIPE_FIX>(READY);
    ++sequence;
  }
}
for (Z0 i = 0; i < Min(sequence, 2); ++i)
  CrossCoreWaitFlag(RELEASE);
mm.End();
PipeBarrier<PIPE_ALL>();
}
if ASCEND_IS_AIV {
TPipe pipe;
typename EpiType<BAND, BM, BN>::Type epilogue;
epilogue.Init(pipe, scale, y);
while (jobs.Next(expert, row, col, rows, cols, n)) {
  for (Z0 offset = 0; offset < rows; offset += BM) {
    CrossCoreWaitFlag(READY);
    epilogue.Process(scratch[(static_cast<Z2>(core) * 2 + sequence % 2) * TILE], expert, row + offset, col,
                     Min(BM, rows - offset), cols, n, sub);
    ++sequence;
  }
}
PipeBarrier<PIPE_ALL>();
}
}
template <Z0 BM, Z0 BN, bool BAND = false>
void Launch(GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groups, GM_ADDR y, Z0 e, Z0 m, Z0 n, Z0 k, Z0 available,
        aclrtStream stream) {
Z0 rowUpper = (m + BM - 1) / BM + e - 1;
if (rowUpper > m)
rowUpper = m;
Z0 upper = rowUpper * ((n + BN - 1) / BN);
Z0 cores = available < upper ? available : upper;
matmul_tiling::MatmulApiTiling api;
api.SetAType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND, matmul_tiling::DataType::DT_INT8, false);
api.SetBType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND, matmul_tiling::DataType::DT_INT8, false);
api.SetCType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND, matmul_tiling::DataType::DT_INT32);
api.SetBiasType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND, matmul_tiling::DataType::DT_INT32);
Z0 planK = (k + 31) / 32 * 32;
Z0 maxMTiles = (m + BM - 1) / BM;
bool canPanel =
  !BAND && n % BN == 0 && k * BN <= 256 * 1024 && maxMTiles >= 4 && maxMTiles * ((n + BN - 1) / BN) >= cores * 8;
Z0 planM = BM * (canPanel ? 4 : 1);
api.SetOrgShape(planM, BN, planK);
api.SetShape(planM, BN, planK);
constexpr Z0 largestAxis = BM > BN ? BM : BN;
constexpr Z0 l0K = (32768 / largestAxis / 32) * 32;
api.SetFixSplit(BM, BN, planK < l0K ? planK : l0K);
api.EnableBias(false);
api.SetBufferSpace(480 * 1024, 128 * 1024, 0);
TCubeTiling tiling{};
if (api.GetTiling(tiling) != 0)
throw std::runtime_error("GMM INT8 tiling failed");
void *workspace = nullptr;
size_t bytes = static_cast<size_t>(cores) * 2 * BM * BN * sizeof(Z1);
if (aclrtMalloc(&workspace, bytes, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS)
throw std::runtime_error("GMM workspace allocation failed");
Kernel<BM, BN, BAND><<<cores, nullptr, stream>>>(x, weight, scale, groups, y, static_cast<Z6 *>(workspace), tiling, e,
                                               n, k, cores, m);
aclError status = aclrtSynchronizeStream(stream);
aclError freed = aclrtFree(workspace);
if (status != ACL_SUCCESS || freed != ACL_SUCCESS)
throw std::runtime_error("GMM execution/workspace release failed");
}
__aicore__ inline Z4 SmallHalf(Z8 value) {
union {
Z8 value;
Z0 bits;
} v;
v.value = value;
Z0 sign = (v.bits >> 16) & 0x8000U;
Z1 exponent = static_cast<Z1>((v.bits >> 23) & 255) - 127;
if (exponent < -25)
return static_cast<Z4>(sign);
Z0 mantissa = (v.bits & 0x7fffffU) | 0x800000U;
Z0 shift = exponent < -14 ? static_cast<Z0>(-exponent - 1) : 13;
Z0 kept = mantissa >> shift, lost = mantissa & ((1U << shift) - 1);
Z0 mid = 1U << (shift - 1);
kept += lost > mid || (lost == mid && (kept & 1));
Z0 bits = exponent < -14 ? kept : ((exponent + 14) << 10) + kept;
return static_cast<Z4>(sign | bits);
}
template <Z0 BM, Z0 BN, Z0 BK> struct DeepStaticPolicy {
__aicore__ static constexpr MatmulApiStaticTiling Make() {
MatmulApiStaticTiling t;
t.cfg = MM_CONFIG;
t.cfg.enableL1BankConflictOptimise = true;
t.cfg.enableKdimReorderLoad = true;
t.usedCoreNum = 1;
t.baseM = BM;
t.baseN = BN;
t.baseK = BK;
t.dbL0A = BM * BK <= 32768 ? 2 : 1;
t.dbL0B = BN * BK <= 32768 ? 2 : 1;
t.dbL0C = 2;
t.stepM = 1;
t.stepN = 1;
t.isBias = 0;
t.transLength = 0;
t.stepKa = 2;
t.stepKb = 2;
t.depthA1 = 4;
t.depthB1 = 4;
t.shareL1Size = 491520;
t.shareL0CSize = 131072;
t.shareUbSize = 0;
return t;
}
static constexpr auto value = Make();
};
