namespace gmg {
namespace p12math {
struct Pair {
Z8 hi, lo;
};
__aicore__ inline Pair AddPair(Pair a, Pair b) {
#pragma clang fp reassociate(off) contract(off)
Z8 s = a.hi + b.hi;
Z8 v = s - a.hi;
Z8 w = s - v;
Z8 e0 = a.hi - w;
Z8 e1 = b.hi - v;
Z8 e2 = e0 + e1;
Z8 e3 = a.lo + b.lo;
Z8 e = e2 + e3;
Z8 h = s + e;
Z8 t = h - s;
return {h, e - t};
}
__aicore__ inline Pair NegPair(Pair a) {
#pragma clang fp reassociate(off) contract(off)
return {-a.hi, -a.lo};
}
__aicore__ inline Z8 HalfMagnitude(Z0 h) {
#pragma clang fp reassociate(off) contract(off)
if (h < 1024)
return static_cast<Z8>(static_cast<Z1>(h)) * 5.9604644775390625e-8f;
union {
Z0 bits;
Z8 value;
} u;
u.bits = (h << 13) + (112U << 23);
return u.value;
}
__aicore__ inline int ComparePair(Pair x, Z8 v) {
#pragma clang fp reassociate(off) contract(off)
Pair d = AddPair(x, {-v, 0.0f});
if (d.hi != 0.0f)
return d.hi < 0.0f ? -1 : 1;
return d.lo < 0.0f ? -1 : (d.lo > 0.0f ? 1 : 0);
}
__aicore__ inline Z4 PositiveTailHalf(Z8 z) {
#pragma clang fp reassociate(off) contract(off)
union {
Z8 value;
Z0 bits;
} u;
u.value = z;
Z0 h = (u.bits >> 13) - (112U << 10);
h += (u.bits & 0x1fffU) > 0x1000U;
return static_cast<Z4>(h);
}
__aicore__ inline Pair QMulPair(Pair a, Pair b) {
#pragma clang fp reassociate(off) contract(off)
Z8 p = a.hi * b.hi;
union {
Z8 value;
Z0 bits;
} aa, bb;
aa.value = a.hi;
bb.value = b.hi;
aa.bits &= 0xfffff000U;
bb.bits &= 0xfffff000U;
Z8 ah = aa.value, bh = bb.value;
Z8 al = a.hi - ah;
Z8 bl = b.hi - bh;
Z8 hh = ah * bh;
Z8 e0 = hh - p;
Z8 hl = ah * bl;
Z8 lh = al * bh;
Z8 ll = al * bl;
Z8 e1 = e0 + hl;
Z8 e2 = e1 + lh;
Z8 e3 = e2 + ll;
Z8 c0 = a.hi * b.lo;
Z8 c1 = a.lo * b.hi;
Z8 c2 = a.lo * b.lo;
Z8 e4 = e3 + c0;
Z8 e5 = e4 + c1;
Z8 e = e5 + c2;
Z8 h = p + e;
Z8 t = h - p;
return {h, e - t};
}
__aicore__ inline Pair QDivPair(Pair a, Pair b) {
#pragma clang fp reassociate(off) contract(off)
Z8 q = a.hi / b.hi;
Pair r = AddPair(a, NegPair(QMulPair(b, {q, 0.0f})));
Z8 rsum = r.hi + r.lo;
Z8 tail = rsum / b.hi;
return AddPair({q, 0.0f}, {tail, 0.0f});
}
__aicore__ inline Pair QExpPair(Pair a) {
#pragma clang fp reassociate(off) contract(off)
Z1 power = static_cast<Z1>(a.hi * 1.4426950408889634f - 0.5f);
Pair r = AddPair(a, NegPair(QMulPair({static_cast<Z8>(power), 0.0f}, {0.6931471824645996f, -1.904654323148236e-9f})));
Z8 high = 2.0876755879584152e-9f;
high = high * r.hi + 2.5052107943679403e-8f;
high = high * r.hi + 2.755731998149713e-7f;
high = high * r.hi + 2.7557318844628753e-6f;
high = high * r.hi + 2.4801587642286904e-5f;
Pair sum{high, 0.0f};
sum = AddPair(QMulPair(sum, r), {1.9841270113829523e-4f, -2.7255968207233472e-12f});
sum = AddPair(QMulPair(sum, r), {1.3888889225199819e-3f, -3.3631092919220174e-11f});
sum = AddPair(QMulPair(sum, r), {8.3333337679505348e-3f, -4.3461720160287154e-10f});
sum = AddPair(QMulPair(sum, r), {4.1666667908430099e-2f, -1.2417634351336027e-9f});
sum = AddPair(QMulPair(sum, r), {1.6666667163372040e-1f, -4.9670537405344106e-9f});
sum = AddPair(QMulPair(sum, r), {0.5f, 0.0f});
sum = AddPair(QMulPair(sum, r), {1.0f, 0.0f});
sum = AddPair(QMulPair(sum, r), {1.0f, 0.0f});
union {
Z0 bits;
Z8 value;
} scale;
scale.bits = static_cast<Z0>(power + 127) << 23;
return QMulPair(sum, {scale.value, 0.0f});
}
__aicore__ inline Pair QAccurateGelu(Z8 z) {
#pragma clang fp reassociate(off) contract(off)
if (z >= 8.0f)
return {z, 0.0f};
if (z <= -6.0f)
return {0.0f, 0.0f};
Pair a{z, 0.0f};
Pair square = QMulPair(a, a);
Pair p = AddPair({1.0f, 0.0f}, QMulPair(square, {0.044714998453855515f, 1.5461444832776117e-9f}));
Pair arg = QMulPair(QMulPair(a, p), {1.5957691669464111f, -4.534068032135963e-8f});
if (z > 0.0f && arg.hi > 36.7368005696771f)
return a;
Pair t = QExpPair(z >= 0.0f ? NegPair(arg) : arg);
Pair correction = QDivPair(QMulPair(a, t), AddPair({1.0f, 0.0f}, t));
return z >= 0.0f ? AddPair(a, NegPair(correction)) : correction;
}
__aicore__ inline Z4 QCorrectHalf(Z8 z, Z4 previous) {
#pragma clang fp reassociate(off) contract(off)
if (z == 0.0f || z >= 8.0f)
return previous;
if (z <= -6.0f)
return 0x8000U;
if (z >= 5.0f && z <= 7.0f)
return PositiveTailHalf(z);
Z0 h = previous & 0x7fffU;
if (h >= 1002 && h < 0x4000U)
return previous;
Pair a = QAccurateGelu(z);
if (z < 0.0f)
a = NegPair(a);
Z8 center = HalfMagnitude(h);
Z8 lower = h == 0 ? 0.0f : 0.5f * (center + HalfMagnitude(h - 1));
Z8 upper = 0.5f * (center + HalfMagnitude(h + 1));
int lo = ComparePair(a, lower), hi = ComparePair(a, upper);
if (h && (lo < 0 || (lo == 0 && (h & 1))))
--h;
else if (hi > 0 || (hi == 0 && (h & 1)))
++h;
return static_cast<Z4>(h | (z < 0.0f ? 0x8000U : 0U));
}
__aicore__ inline Z4 QuickCorrectHalf(Z8 z, Z4 previous) {
#pragma clang fp reassociate(off) contract(off)
Z0 h = previous & 0x7fffU;
if (z == 0.0f || z >= 8.0f)
return previous;
if (z <= -6.0f)
return 0x8000U;
if (z >= 5.0f && z <= 7.0f)
return PositiveTailHalf(z);
if (h >= 1002 && h < 0x4000U)
return previous;
Z8 magnitude = z < 0.0f ? -z : z;
if (magnitude < 0.000125f) {
Z8 units = magnitude * 8388608.0f;
Z1 whole = static_cast<Z1>(units);
Z8 bend = (magnitude * magnitude) * 6693141.0f;
Z8 distance = ((units - static_cast<Z8>(whole)) - 0.5f) + (z < 0.0f ? -bend : bend);
Z0 rounded = static_cast<Z0>(whole);
rounded += distance > 0.0f || (distance == 0.0f && (rounded & 1U));
return static_cast<Z4>(rounded | (z < 0.0f ? 0x8000U : 0U));
}
if ((z >= 2.0f && z < 5.0f) || (z < -3.0f && h < 1002)) {
Z8 correction = precision43::Tail(magnitude);
if (z < 0.0f) {
  Z8 units = correction * 16777216.0f;
  Z1 whole = static_cast<Z1>(units);
  Z8 distance = (units - static_cast<Z8>(whole)) - 0.5f;
  Z0 rounded = static_cast<Z0>(whole);
  rounded += distance > 0.0f || (distance == 0.0f && (rounded & 1U));
  return static_cast<Z4>(rounded | 0x8000U);
}
Z8 center = HalfMagnitude(h);
Z8 lower = 0.5f * (center + HalfMagnitude(h - 1));
Z8 upper = 0.5f * (center + HalfMagnitude(h + 1));
Z8 dl = (z - lower) - correction, du = (z - upper) - correction;
if (dl < 0.0f || (dl == 0.0f && (h & 1U)))
  --h;
else if (du > 0.0f || (du == 0.0f && (h & 1U)))
  ++h;
return static_cast<Z4>(h);
}
return QCorrectHalf(z, previous);
}
} // namespace p12math
} // namespace gmg

