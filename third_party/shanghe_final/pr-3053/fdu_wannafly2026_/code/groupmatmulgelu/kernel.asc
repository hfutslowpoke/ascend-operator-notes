// Grouped INT8 matrix multiplication, per-channel FP32 scaling, and FP16 GELU.
// Empty groups and incomplete row, column, and reduction blocks are supported.
// Intermediate workspace is produced and consumed within the current invocation.
#include "kernel_operator.h"
using namespace AscendC;
