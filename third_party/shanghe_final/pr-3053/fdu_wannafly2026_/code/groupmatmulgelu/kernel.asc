// Fixed-point helpers preserve rounding near FP16 boundaries.
__aicore__ inline int64_t GmmFloatToQ(float x) {
#pragma clang fp contract(off)

  union {
    float f;
    uint32_t bits;
  } v;
  v.f = x;
  uint32_t a = v.bits & 0x7fffffffU;
  if (!a)
    return 0;
  int shift = (int)((a >> 23) & 255) - 127 + 27;
  uint64_t mant = (a & 0x7fffffU) | 0x800000U;
  uint64_t q = shift >= 0 ? mant << shift : (shift > -64 ? mant >> -shift : 0);
  return v.bits >> 31 ? -(int64_t)q : (int64_t)q;
}
__aicore__ inline float GmmQToFloat(int64_t x) {
#pragma clang fp contract(off)

  union {
    float f;
    uint32_t bits;
  } v;
  if (!x) {
    v.bits = 0;
    return v.f;
  }
  uint64_t a = x < 0 ? -x : x;
  int top = 63 - __builtin_clzll(a), shift = top - 23;
  uint64_t mant;
  if (shift > 0) {
    mant = a >> shift;
    uint64_t rem = a & ((1ULL << shift) - 1), halfWay = 1ULL << (shift - 1);
    if (rem > halfWay || (rem == halfWay && (mant & 1)))
      ++mant;
    if (mant == (1ULL << 24)) {
      mant >>= 1;
      ++top;
    }
  } else
    mant = a << -shift;
  v.bits =
      (x < 0 ? 0x80000000U : 0) | ((uint32_t)(top - 50 + 127) << 23) | ((uint32_t)mant & 0x7fffffU);
  return v.f;
}
__aicore__ inline int64_t GmmQMul(int64_t a, int64_t b) {
#pragma clang fp contract(off)

  bool neg = (a < 0) != (b < 0);
  uint64_t aa = a < 0 ? -a : a, bb = b < 0 ? -b : b;
  const uint64_t mask = (1ULL << 25) - 1;
  uint64_t ah = aa >> 25, al = aa & mask, bh = bb >> 25, bl = bb & mask;
  uint64_t v = ah * bh + ((ah * bl + al * bh + ((al * bl) >> 25) + (1ULL << 24)) >> 25);
  return neg ? -(int64_t)v : (int64_t)v;
}
__aicore__ inline int64_t GmmQExpNeg(int64_t a) {
#pragma clang fp contract(off)

  const int64_t ln2 = 780414346020670LL;
  int64_t n = (a + ln2 / 2) / ln2, r = a - n * ln2;
  if (n > 53)
    return 0;
  int64_t p = 310267831LL;
  p = 3102678315LL - GmmQMul(r, p);
  p = 27924104832LL - GmmQMul(r, p);
  p = 223392838659LL - GmmQMul(r, p);
  p = 1563749870615LL - GmmQMul(r, p);
  p = 9382499223689LL - GmmQMul(r, p);
  p = 46912496118443LL - GmmQMul(r, p);
  p = 187649984473771LL - GmmQMul(r, p);
  p = 562949953421312LL - GmmQMul(r, p);
  p = 1125899906842624LL - GmmQMul(r, p);
  p = 1125899906842624LL - GmmQMul(r, p);
  return p >> n;
}

struct TinySmallDD {
  float hi, lo;
};
__aicore__ inline TinySmallDD SmallQuick(float a, float b) {
#pragma clang fp contract(off)
  float s = a + b;
  return {s, b - (s - a)};
}
__aicore__ inline TinySmallDD SmallAdd(TinySmallDD a, TinySmallDD b) {
#pragma clang fp contract(off)

  float s = a.hi + b.hi, v = s - a.hi;
  float e = (a.hi - (s - v)) + (b.hi - v) + a.lo + b.lo;
  return SmallQuick(s, e);
}
__aicore__ inline TinySmallDD SmallMul(TinySmallDD a, TinySmallDD b) {
#pragma clang fp contract(off)

  float p = a.hi * b.hi;
  float ac = 4097.0f * a.hi, ah = ac - (ac - a.hi), al = a.hi - ah;
  float bc = 4097.0f * b.hi, bh = bc - (bc - b.hi), bl = b.hi - bh;
  float e = ((ah * bh - p) + ah * bl + al * bh) + al * bl;
  e += a.hi * b.lo + a.lo * b.hi;
  return SmallQuick(p, e);
}
__aicore__ inline float GmmSmallRefine(float z) {
#pragma clang fp contract(off)

                                                        
                                                                              
  TinySmallDD zz = SmallMul({z, 0.0f}, {z, 0.0f});
  TinySmallDD p = SmallAdd({-0x1.11b14c0000000p-4f, -0x1.a6d28a0000000p-29f},
                           SmallMul({0x1.4e48de0000000p-7f, -0x1.dc3d360000000p-32f}, zz));
  p = SmallAdd({0x1.9884540000000p-2f, -0x1.8579360000000p-27f}, SmallMul(p, zz));
  TinySmallDD value = SmallAdd({z * .5f, 0.0f}, SmallMul(p, zz));
  union {
    float f;
    uint32_t u;
  } out;
  out.f = value.hi;
  uint32_t ab = out.u & 0x7fffffffU;
  bool mid = false;
  if (ab >= 0x38800000U)
    mid = (ab & 8191U) == 4096U;
  else if (ab) {
    float units = (out.f < 0.0f ? -out.f : out.f) * 16777216.0f;
    mid = units - (float)((int)units) == .5f;
  }
  if (mid && value.lo != 0.0f) {
    union {
      uint32_t u;
      float f;
    } halfUlp;
    int exponent = (int)((ab >> 23) & 255) - 53;
    halfUlp.u = exponent > 0 ? (uint32_t)exponent << 23 : 0;
    float low = value.lo < 0.0f ? -value.lo : value.lo;
    if (low > halfUlp.f)
      out.u += (value.lo > 0.0f) == (out.f > 0.0f) ? 1 : -1;
  }
  return out.f;
}

__aicore__ inline float GmmRefine(float z) {
#pragma clang fp contract(off)

                                                                     
                                                                         
                                                                       
                                                                  
  if (z >= 6.0f) {
    union {
      float f;
      uint32_t bits;
    } v;
    v.f = z;
    if (z < 0x1.c5b7cc0000000p+2f && (v.bits & 8191U) == 4096U)
      --v.bits;
    return v.f;
  }

  if (z >= -0x1p-8f && z <= 0x1p-8f)
    return GmmSmallRefine(z);
  if (z >= 8.0f)
    return z;
  if (z <= -8.0f)
    return 0.0f;
  const int64_t Q = 1LL << 50;
  int64_t zq = GmmFloatToQ(z);
  int64_t cubic = GmmQMul(GmmQMul(zq, zq), zq);
  int64_t inner = GmmQMul(898338152679114LL, zq + GmmQMul(50344614334468LL, cubic));
  int64_t tail = GmmQExpNeg(2 * (inner < 0 ? -inner : inner));
  int64_t den = Q + tail;
  float df = GmmQToFloat(den);
  int64_t inv = GmmFloatToQ(1.0f / df);
  inv = GmmQMul(inv, 2 * Q - GmmQMul(den, inv));
  inv = GmmQMul(inv, 2 * Q - GmmQMul(den, inv));
  int64_t value = GmmQMul(inner >= 0 ? zq : GmmQMul(zq, tail), inv);
  union {
    float f;
    uint32_t bits;
  } v;
  v.f = GmmQToFloat(value);
  int64_t back = GmmFloatToQ(v.f);
  uint32_t ab = v.bits & 0x7fffffffU;
  uint64_t backAbs = back < 0 ? -back : back;
  bool mid = ab >= 0x38800000U ? ((ab & 8191U) == 4096U)
                               : ((backAbs & ((1ULL << 26) - 1)) == (1ULL << 25));
  if (mid) {
    if (back > value)
      v.bits += v.f > 0 ? -1 : 1;
    else if (back < value)
      v.bits += v.f > 0 ? 1 : -1;
    else if (v.f == z && z > 0.0f && 2 * inner < 53LL * 780414346020670LL)
      --v.bits;
  }
  return v.f;
}

__aicore__ inline bool TinyScalarNeedsRefinement(float z, float f) {
  if (z <= -8.0f || z >= 8.0f)
    return false;
  union {
    float f;
    uint32_t bits;
  } value;
  value.f = f;
  uint32_t ab = value.bits & 0x7fffffffU;
  if (ab >= 0x38800000U) {
    uint32_t low = ab & 8191U;
    return low >= 4032U && low <= 4160U;
  }
  if (ab == 0)
    return false;
  float units = (f < 0.0f ? -f : f) * 16777216.0f;
  float delta = units - (float)((int)units) - 0.5f;
  if (delta < 0.0f)
    delta = -delta;
  return delta <= (units * 0.00002f + 0.000001f);
}

__aicore__ inline void GmmDirectVectorCounter(LocalTensor<float> z, LocalTensor<float> t,
                                              LocalTensor<float> u, int count) {
  SetMaskCount();
  SetVectorMask<float, MaskMode::COUNTER>(0, count);
  Mul<float, false>(t, z, z, MASK_PLACEHOLDER, 1, {1, 1, 1, 8, 8, 8});
  PipeBarrier<PIPE_V>();
  Muls<float, false>(t, t, 0.044715f, MASK_PLACEHOLDER, 1, {1, 1, 8, 8});
  PipeBarrier<PIPE_V>();
  FusedMulAdd<float, false>(t, z, z, MASK_PLACEHOLDER, 1, {1, 1, 1, 8, 8, 8});
  PipeBarrier<PIPE_V>();
  Muls<float, false>(t, t, -1.5957691216057308f, MASK_PLACEHOLDER, 1, {1, 1, 8, 8});
  PipeBarrier<PIPE_V>();

  Exp<float, false>(t, t, MASK_PLACEHOLDER, 1, {1, 1, 8, 8});
  PipeBarrier<PIPE_V>();
  Adds<float, false>(t, t, 1.0f, MASK_PLACEHOLDER, 1, {1, 1, 8, 8});
  PipeBarrier<PIPE_V>();
  Div<float, false>(u, z, t, MASK_PLACEHOLDER, 1, {1, 1, 1, 8, 8, 8});
  PipeBarrier<PIPE_V>();
  SetMaskNorm();
  ResetMask();
}
constexpr int VK = 32;
template <bool FPA, int VN>
__global__ __vector__ void grouped_matmul_gelu_small_tiled(GM_ADDR x, GM_ADDR w, GM_ADDR s,
                                                           GM_ADDR g, GM_ADDR y, int M, int N,
                                                           int K, int E) {
  constexpr int VW = VN * VK;
  using AccType = typename Std::conditional<FPA, float, int32_t>::type;
  TPipe p;
  TBuf<TPosition::VECIN> xb, wb, sb;
  TBuf<TPosition::VECCALC> xhb;
  TBuf<TPosition::VECCALC> hb, ib, ab, tib, zb, tb, ub;
  TBuf<TPosition::VECOUT> ob;
  p.InitBuffer(xb, VK);
  p.InitBuffer(wb, VW);
  p.InitBuffer(sb, VN * 4);
  p.InitBuffer(hb, VW * 2);
  if constexpr (!FPA)
    p.InitBuffer(ib, VW * 4);
  p.InitBuffer(xhb, VK * 2);
  p.InitBuffer(ab, VN * 4);
  p.InitBuffer(tib, VN * 4);
  p.InitBuffer(zb, VN * 4);
  p.InitBuffer(tb, VN * 4);
  p.InitBuffer(ub, VN * 4);
  p.InitBuffer(ob, VN * 2);
  auto xl = xb.Get<int8_t>();
  auto wl = wb.Get<int8_t>();
  auto sl = sb.Get<float>();
  auto wh = hb.Get<half>();
  LocalTensor<int32_t> wi;
  if constexpr (!FPA)
    wi = ib.Get<int32_t>();
  auto xh = xhb.Get<half>();
  auto acc = ab.Get<AccType>();
  auto ti = tib.Get<int32_t>();
  auto z = zb.Get<float>();
  auto t = tb.Get<float>();
  auto u = ub.Get<float>();
  auto o = ob.Get<half>();
  GlobalTensor<int8_t> xx, ww;
  GlobalTensor<float> ss;
  GlobalTensor<int64_t> gg;
  GlobalTensor<half> yy;
  xx.SetGlobalBuffer((__gm__ int8_t *)x);
  ww.SetGlobalBuffer((__gm__ int8_t *)w);
  ss.SetGlobalBuffer((__gm__ float *)s);
  gg.SetGlobalBuffer((__gm__ int64_t *)g);
  yy.SetGlobalBuffer((__gm__ half *)y);
  int nt = (N + VN - 1) / VN, tasks = M * nt, cores = GetBlockNum(), bid = GetBlockIdx();
  for (int task = bid; task < tasks; task += cores) {
    int row = task / nt, col = task % nt * VN, rn = N - col;
    if (rn > VN)
      rn = VN;
    int stride = (rn + 31) / 32 * 32;
    int expert = 0;
    while (expert < E - 1 && row >= gg.GetValue(expert))
      ++expert;
    Duplicate(acc, static_cast<AccType>(0), stride);
    PipeBarrier<PIPE_V>();
    for (int kk = 0; kk < K; kk += VK) {
      int rk = K - kk;
      if (rk > VK)
        rk = VK;
      DataCopyExtParams xp{1, (uint32_t)rk, 0, 0, 0};
      DataCopyPadExtParams<int8_t> pad{true, 0, 0, 0};
      DataCopyPad(xl, xx[row * (int64_t)K + kk], xp, pad);
      DataCopyExtParams wp{(uint16_t)rk, (uint32_t)rn, (uint32_t)(N - rn), 0, 0};
      DataCopyPad(wl, ww[expert * (int64_t)K * N + kk * (int64_t)N + col], wp, pad);
      auto ev = p.FetchEventID(HardEvent::MTE2_V);
      SetFlag<HardEvent::MTE2_V>(ev);
      WaitFlag<HardEvent::MTE2_V>(ev);
      if constexpr (!FPA) {
        auto es = p.FetchEventID(HardEvent::MTE2_S);
        SetFlag<HardEvent::MTE2_S>(es);
        WaitFlag<HardEvent::MTE2_S>(es);
      }
      Cast(wh, wl, RoundMode::CAST_NONE, rk * stride);
      PipeBarrier<PIPE_V>();
      if constexpr (FPA) {
        Cast(xh, xl, RoundMode::CAST_NONE, rk);
        PipeBarrier<PIPE_V>();
        auto es = p.FetchEventID(HardEvent::V_S);
        SetFlag<HardEvent::V_S>(es);
        WaitFlag<HardEvent::V_S>(es);
      }
      if constexpr (!FPA) {
        Cast(wi, wh, RoundMode::CAST_RINT, rk * stride);
        PipeBarrier<PIPE_V>();
      }
      for (int j = 0; j < rk; ++j) {
        if constexpr (FPA) {
          Axpy(acc, wh[j * stride], xh.GetValue(j), stride);
          PipeBarrier<PIPE_V>();
        } else {
          int32_t xv = (int32_t)xl.GetValue(j);
          Muls(ti, wi[j * stride], xv, stride);
          PipeBarrier<PIPE_V>();
          Add(acc, acc, ti, stride);
          PipeBarrier<PIPE_V>();
        }
      }
      auto evback = p.FetchEventID(HardEvent::V_MTE2);
      SetFlag<HardEvent::V_MTE2>(evback);
      WaitFlag<HardEvent::V_MTE2>(evback);
    }
    DataCopyExtParams sp{1, (uint32_t)(rn * 4), 0, 0, 0};
    DataCopyPadExtParams<float> sfpad{true, 0, 0, 0};
    DataCopyPad(sl, ss[expert * (int64_t)N + col], sp, sfpad);
    auto ev = p.FetchEventID(HardEvent::MTE2_V);
    SetFlag<HardEvent::MTE2_V>(ev);
    WaitFlag<HardEvent::MTE2_V>(ev);
    if constexpr (FPA) {
      Mul(z, acc, sl, stride);
      PipeBarrier<PIPE_V>();
    } else {
      Cast(z, acc, RoundMode::CAST_RINT, stride);
      PipeBarrier<PIPE_V>();
      Mul(z, z, sl, stride);
      PipeBarrier<PIPE_V>();
    }
    Mul(t, z, z, stride);
    PipeBarrier<PIPE_V>();
    Muls(t, t, 0.044715f, stride);
    PipeBarrier<PIPE_V>();
    Adds(t, t, 1.0f, stride);
    PipeBarrier<PIPE_V>();
    Mul(t, t, z, stride);
    PipeBarrier<PIPE_V>();
    Muls(t, t, -1.5957691216057308f, stride);
    PipeBarrier<PIPE_V>();
    Mins(t, t, 80.0f, stride);
    PipeBarrier<PIPE_V>();
    Maxs(t, t, -80.0f, stride);
    PipeBarrier<PIPE_V>();
    Exp(t, t, stride);
    PipeBarrier<PIPE_V>();
    Adds(t, t, 1.0f, stride);
    PipeBarrier<PIPE_V>();
    Div(u, z, t, stride);
    PipeBarrier<PIPE_V>();
    Cast(o, u, RoundMode::CAST_RINT, stride);
    PipeBarrier<PIPE_V>();
    auto eo = p.FetchEventID(HardEvent::V_MTE3);
    SetFlag<HardEvent::V_MTE3>(eo);
    WaitFlag<HardEvent::V_MTE3>(eo);
    DataCopyExtParams op{1, (uint32_t)(rn * 2), 0, 0, 0};
    DataCopyPad(yy[row * (int64_t)N + col], o, op);
    auto eb = p.FetchEventID(HardEvent::MTE3_V);
    SetFlag<HardEvent::MTE3_V>(eb);
    WaitFlag<HardEvent::MTE3_V>(eb);
  }
}
template <int VN, int RM>
__global__ __vector__ void grouped_matmul_gelu_small_reuse(GM_ADDR x, GM_ADDR w, GM_ADDR s,
                                                           GM_ADDR g, GM_ADDR y, int M, int N,
                                                           int K, int E) {
  TPipe p;
  TBuf<TPosition::VECIN> xb, wb, sb;
  TBuf<TPosition::VECCALC> xhb, hb, ab, tb, ub;
  TBuf<TPosition::VECOUT> ob;
  p.InitBuffer(xb, RM * 32);
  p.InitBuffer(xhb, RM * 64);
  p.InitBuffer(wb, 32 * VN);
  p.InitBuffer(hb, 64 * VN);
  p.InitBuffer(sb, VN * 4);
  p.InitBuffer(ab, VN * 4);
  p.InitBuffer(tb, VN * 4);
  p.InitBuffer(ub, VN * 4);
  p.InitBuffer(ob, VN * 2);
  auto xl = xb.Get<int8_t>();
  auto xh = xhb.Get<half>();
  auto wl = wb.Get<int8_t>();
  auto wh = hb.Get<half>();
  auto sl = sb.Get<float>();
  auto z = ab.Get<float>();
  auto t = tb.Get<float>();
  auto u = ub.Get<float>();
  auto o = ob.Get<half>();
  GlobalTensor<int8_t> xx, ww;
  GlobalTensor<float> ss;
  GlobalTensor<int64_t> gg;
  GlobalTensor<half> yy;
  xx.SetGlobalBuffer((__gm__ int8_t *)x);
  ww.SetGlobalBuffer((__gm__ int8_t *)w);
  ss.SetGlobalBuffer((__gm__ float *)s);
  gg.SetGlobalBuffer((__gm__ int64_t *)g);
  yy.SetGlobalBuffer((__gm__ half *)y);
  int nt = (N + VN - 1) / VN, tasks = ((M + RM - 1) / RM) * nt, cores = GetBlockNum(),
      bid = GetBlockIdx();
  for (int task = bid; task < tasks; task += cores) {
    int base = task / nt * RM, col = task % nt * VN, rn = N - col;
    if (rn > VN)
      rn = VN;
    int rm = M - base;
    if (rm > RM)
      rm = RM;
    int stride = (rn + 31) / 32 * 32;
    auto eb = p.FetchEventID(HardEvent::V_MTE2);
    SetFlag<HardEvent::V_MTE2>(eb);
    WaitFlag<HardEvent::V_MTE2>(eb);
    DataCopyExtParams xp{(uint16_t)rm, (uint32_t)K, 0, 0, 0};
    DataCopyPadExtParams<int8_t> pad{true, 0, 0, 0};
    DataCopyPad(xl, xx[base * (int64_t)K], xp, pad);
    auto ev = p.FetchEventID(HardEvent::MTE2_V);
    SetFlag<HardEvent::MTE2_V>(ev);
    WaitFlag<HardEvent::MTE2_V>(ev);
    Cast(xh, xl, RoundMode::CAST_NONE, rm * 32);
    PipeBarrier<PIPE_V>();
    auto es = p.FetchEventID(HardEvent::V_S);
    SetFlag<HardEvent::V_S>(es);
    WaitFlag<HardEvent::V_S>(es);
    int cached = -1, expert = 0;
    for (int rr = 0; rr < rm; ++rr) {
      int row = base + rr;
      while (expert < E - 1 && row >= gg.GetValue(expert))
        ++expert;
      if (expert != cached) {
        auto ewb = p.FetchEventID(HardEvent::V_MTE2);
        SetFlag<HardEvent::V_MTE2>(ewb);
        WaitFlag<HardEvent::V_MTE2>(ewb);
        DataCopyExtParams wp{(uint16_t)K, (uint32_t)rn, (uint32_t)(N - rn), 0, 0};
        DataCopyPad(wl, ww[expert * (int64_t)K * N + col], wp, pad);
        DataCopyExtParams sp{1, (uint32_t)(rn * 4), 0, 0, 0};
        DataCopyPadExtParams<float> sfpad{true, 0, 0, 0};
        DataCopyPad(sl, ss[expert * (int64_t)N + col], sp, sfpad);
        auto ewe = p.FetchEventID(HardEvent::MTE2_V);
        SetFlag<HardEvent::MTE2_V>(ewe);
        WaitFlag<HardEvent::MTE2_V>(ewe);
        Cast(wh, wl, RoundMode::CAST_NONE, K * stride);
        PipeBarrier<PIPE_V>();
        cached = expert;
      }
      Duplicate(z, 0.0f, stride);
      PipeBarrier<PIPE_V>();
      for (int j = 0; j < K; ++j) {
        Axpy(z, wh[j * stride], xh.GetValue(rr * 32 + j), stride);
        PipeBarrier<PIPE_V>();
      }
      Mul(z, z, sl, stride);
      PipeBarrier<PIPE_V>();
      Mul(t, z, z, stride);
      PipeBarrier<PIPE_V>();
      Muls(t, t, 0.044715f, stride);
      PipeBarrier<PIPE_V>();
      Adds(t, t, 1.0f, stride);
      PipeBarrier<PIPE_V>();
      Mul(t, t, z, stride);
      PipeBarrier<PIPE_V>();
      Muls(t, t, -1.5957691216057308f, stride);
      PipeBarrier<PIPE_V>();
      Mins(t, t, 80.0f, stride);
      PipeBarrier<PIPE_V>();
      Maxs(t, t, -80.0f, stride);
      PipeBarrier<PIPE_V>();
      Exp(t, t, stride);
      PipeBarrier<PIPE_V>();
      Adds(t, t, 1.0f, stride);
      PipeBarrier<PIPE_V>();
      Div(u, z, t, stride);
      PipeBarrier<PIPE_V>();
      Cast(o, u, RoundMode::CAST_RINT, stride);
      PipeBarrier<PIPE_V>();
      auto eo = p.FetchEventID(HardEvent::V_MTE3);
      SetFlag<HardEvent::V_MTE3>(eo);
      WaitFlag<HardEvent::V_MTE3>(eo);
      DataCopyExtParams op{1, (uint32_t)(rn * 2), 0, 0, 0};
      DataCopyPad(yy[row * (int64_t)N + col], o, op);
      auto eob = p.FetchEventID(HardEvent::MTE3_V);
      SetFlag<HardEvent::MTE3_V>(eob);
      WaitFlag<HardEvent::MTE3_V>(eob);
    }
  }
}
template <bool FPA, int VN>
__global__ __vector__ void grouped_matmul_gelu_small_prefetch(GM_ADDR x, GM_ADDR w, GM_ADDR s,
                                                              GM_ADDR g, GM_ADDR y, int M, int N,
                                                              int K, int E) {
  constexpr int VW = VN * VK;
  using AccType = typename Std::conditional<FPA, float, int32_t>::type;
  TPipe p;
  TBuf<TPosition::VECIN> xb, wb, sb;
  TBuf<TPosition::VECCALC> xhb;
  TBuf<TPosition::VECCALC> hb, ib, ab, tib, zb, tb, ub;
  TBuf<TPosition::VECOUT> ob;
  p.InitBuffer(xb, VK);
  p.InitBuffer(wb, VW);
  p.InitBuffer(sb, VN * 4);
  p.InitBuffer(hb, VW * 2);
  if constexpr (!FPA)
    p.InitBuffer(ib, VW * 4);
  p.InitBuffer(xhb, VK * 2);
  p.InitBuffer(ab, VN * 4);
  p.InitBuffer(tib, VN * 4);
  p.InitBuffer(zb, VN * 4);
  p.InitBuffer(tb, VN * 4);
  p.InitBuffer(ub, VN * 4);
  p.InitBuffer(ob, VN * 2);
  auto xl = xb.Get<int8_t>();
  auto wl = wb.Get<int8_t>();
  auto sl = sb.Get<float>();
  auto wh = hb.Get<half>();
  LocalTensor<int32_t> wi;
  if constexpr (!FPA)
    wi = ib.Get<int32_t>();
  auto xh = xhb.Get<half>();
  auto acc = ab.Get<AccType>();
  auto ti = tib.Get<int32_t>();
  auto z = zb.Get<float>();
  auto t = tb.Get<float>();
  auto u = ub.Get<float>();
  auto o = ob.Get<half>();
  GlobalTensor<int8_t> xx, ww;
  GlobalTensor<float> ss;
  GlobalTensor<int64_t> gg;
  GlobalTensor<half> yy;
  xx.SetGlobalBuffer((__gm__ int8_t *)x);
  ww.SetGlobalBuffer((__gm__ int8_t *)w);
  ss.SetGlobalBuffer((__gm__ float *)s);
  gg.SetGlobalBuffer((__gm__ int64_t *)g);
  yy.SetGlobalBuffer((__gm__ half *)y);
  int nt = (N + VN - 1) / VN, tasks = M * nt, cores = GetBlockNum(), bid = GetBlockIdx();
  for (int task = bid; task < tasks; task += cores) {
    int row = task / nt, col = task % nt * VN, rn = N - col;
    if (rn > VN)
      rn = VN;
    int stride = (rn + 31) / 32 * 32;
    if (task != bid) {
      auto reuse = p.FetchEventID(HardEvent::V_MTE2);
      SetFlag<HardEvent::V_MTE2>(reuse);
      WaitFlag<HardEvent::V_MTE2>(reuse);
    }
    int expert = 0;
    while (expert < E - 1 && row >= gg.GetValue(expert))
      ++expert;
    Duplicate(acc, static_cast<AccType>(0), stride);
    PipeBarrier<PIPE_V>();
    DataCopyExtParams sp{1, (uint32_t)(rn * 4), 0, 0, 0};
    DataCopyPadExtParams<float> sfpad{true, 0, 0, 0};
    DataCopyPad(sl, ss[expert * (int64_t)N + col], sp, sfpad);

    for (int kk = 0; kk < K; kk += VK) {
      int rk = K - kk;
      if (rk > VK)
        rk = VK;
      DataCopyExtParams xp{1, (uint32_t)rk, 0, 0, 0};
      DataCopyPadExtParams<int8_t> pad{true, 0, 0, 0};
      DataCopyPad(xl, xx[row * (int64_t)K + kk], xp, pad);
      DataCopyExtParams wp{(uint16_t)rk, (uint32_t)rn, (uint32_t)(N - rn), 0, 0};
      DataCopyPad(wl, ww[expert * (int64_t)K * N + kk * (int64_t)N + col], wp, pad);
      auto ev = p.FetchEventID(HardEvent::MTE2_V);
      SetFlag<HardEvent::MTE2_V>(ev);
      WaitFlag<HardEvent::MTE2_V>(ev);
      if constexpr (!FPA) {
        auto es = p.FetchEventID(HardEvent::MTE2_S);
        SetFlag<HardEvent::MTE2_S>(es);
        WaitFlag<HardEvent::MTE2_S>(es);
      }
      Cast(wh, wl, RoundMode::CAST_NONE, rk * stride);
      PipeBarrier<PIPE_V>();
      if constexpr (FPA) {
        Cast(xh, xl, RoundMode::CAST_NONE, rk);
        PipeBarrier<PIPE_V>();
        auto es = p.FetchEventID(HardEvent::V_S);
        SetFlag<HardEvent::V_S>(es);
        WaitFlag<HardEvent::V_S>(es);
      }
      if constexpr (!FPA) {
        Cast(wi, wh, RoundMode::CAST_RINT, rk * stride);
        PipeBarrier<PIPE_V>();
      }
      for (int j = 0; j < rk; ++j) {
        if constexpr (FPA) {
          Axpy(acc, wh[j * stride], xh.GetValue(j), stride);
          PipeBarrier<PIPE_V>();
        } else {
          int32_t xv = (int32_t)xl.GetValue(j);
          Muls(ti, wi[j * stride], xv, stride);
          PipeBarrier<PIPE_V>();
          Add(acc, acc, ti, stride);
          PipeBarrier<PIPE_V>();
        }
      }
      if (kk + VK < K) {
        auto evback = p.FetchEventID(HardEvent::V_MTE2);
        SetFlag<HardEvent::V_MTE2>(evback);
        WaitFlag<HardEvent::V_MTE2>(evback);
      }
    }
    if constexpr (FPA) {
      Mul(z, acc, sl, stride);
      PipeBarrier<PIPE_V>();
    } else {
      Cast(z, acc, RoundMode::CAST_RINT, stride);
      PipeBarrier<PIPE_V>();
      Mul(z, z, sl, stride);
      PipeBarrier<PIPE_V>();
    }
    Mul(t, z, z, stride);
    PipeBarrier<PIPE_V>();
    Muls(t, t, 0.044715f, stride);
    PipeBarrier<PIPE_V>();
    Adds(t, t, 1.0f, stride);
    PipeBarrier<PIPE_V>();
    Mul(t, t, z, stride);
    PipeBarrier<PIPE_V>();
    Muls(t, t, -1.5957691216057308f, stride);
    PipeBarrier<PIPE_V>();
    Mins(t, t, 80.0f, stride);
    PipeBarrier<PIPE_V>();
    Maxs(t, t, -80.0f, stride);
    PipeBarrier<PIPE_V>();
    Exp(t, t, stride);
    PipeBarrier<PIPE_V>();
    Adds(t, t, 1.0f, stride);
    PipeBarrier<PIPE_V>();
    Div(u, z, t, stride);
    PipeBarrier<PIPE_V>();
    Cast(o, u, RoundMode::CAST_RINT, stride);
    PipeBarrier<PIPE_V>();
    auto eo = p.FetchEventID(HardEvent::V_MTE3);
    SetFlag<HardEvent::V_MTE3>(eo);
    WaitFlag<HardEvent::V_MTE3>(eo);
    DataCopyExtParams op{1, (uint32_t)(rn * 2), 0, 0, 0};
    DataCopyPad(yy[row * (int64_t)N + col], o, op);
    auto eb = p.FetchEventID(HardEvent::MTE3_V);
    SetFlag<HardEvent::MTE3_V>(eb);
    WaitFlag<HardEvent::MTE3_V>(eb);
  }
}

template <bool FPA, int VN>
__global__ __vector__ void grouped_matmul_gelu_small_gmx(GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR g,
                                                         GM_ADDR y, int M, int N, int K, int E) {
  constexpr int VW = VN * VK;
  using AccType = typename Std::conditional<FPA, float, int32_t>::type;
  TPipe p;
  TBuf<TPosition::VECIN> xb, wb, sb;
  TBuf<TPosition::VECCALC> xhb;
  TBuf<TPosition::VECCALC> hb, ib, ab, tib, zb, tb, ub;
  TBuf<TPosition::VECOUT> ob;
  p.InitBuffer(xb, VK);
  p.InitBuffer(wb, VW);
  p.InitBuffer(sb, VN * 4);
  p.InitBuffer(hb, VW * 2);
  if constexpr (!FPA)
    p.InitBuffer(ib, VW * 4);
  p.InitBuffer(xhb, VK * 2);
  p.InitBuffer(ab, VN * 4);
  p.InitBuffer(tib, VN * 4);
  p.InitBuffer(zb, VN * 4);
  p.InitBuffer(tb, VN * 4);
  p.InitBuffer(ub, VN * 4);
  p.InitBuffer(ob, VN * 2);
  auto xl = xb.Get<int8_t>();
  auto wl = wb.Get<int8_t>();
  auto sl = sb.Get<float>();
  auto wh = hb.Get<half>();
  LocalTensor<int32_t> wi;
  if constexpr (!FPA)
    wi = ib.Get<int32_t>();
  auto xh = xhb.Get<half>();
  auto acc = ab.Get<AccType>();
  auto ti = tib.Get<int32_t>();
  auto z = zb.Get<float>();
  auto t = tb.Get<float>();
  auto u = ub.Get<float>();
  auto o = ob.Get<half>();
  GlobalTensor<int8_t> xx, ww;
  GlobalTensor<float> ss;
  GlobalTensor<int64_t> gg;
  GlobalTensor<half> yy;
  xx.SetGlobalBuffer((__gm__ int8_t *)x);
  ww.SetGlobalBuffer((__gm__ int8_t *)w);
  ss.SetGlobalBuffer((__gm__ float *)s);
  gg.SetGlobalBuffer((__gm__ int64_t *)g);
  yy.SetGlobalBuffer((__gm__ half *)y);
  int nt = (N + VN - 1) / VN, tasks = M * nt, cores = GetBlockNum(), bid = GetBlockIdx();
  for (int task = bid; task < tasks; task += cores) {
    int row = task / nt, col = task % nt * VN, rn = N - col;
    if (rn > VN)
      rn = VN;
    int stride = (rn + 31) / 32 * 32;
    if (task != bid) {
      auto reuse = p.FetchEventID(HardEvent::V_MTE2);
      SetFlag<HardEvent::V_MTE2>(reuse);
      WaitFlag<HardEvent::V_MTE2>(reuse);
    }
    int expert = 0;
    while (expert < E - 1 && row >= gg.GetValue(expert))
      ++expert;
    Duplicate(acc, static_cast<AccType>(0), stride);
    PipeBarrier<PIPE_V>();
    DataCopyExtParams sp{1, (uint32_t)(rn * 4), 0, 0, 0};
    DataCopyPadExtParams<float> sfpad{true, 0, 0, 0};
    DataCopyPad(sl, ss[expert * (int64_t)N + col], sp, sfpad);

    for (int kk = 0; kk < K; kk += VK) {
      int rk = K - kk;
      if (rk > VK)
        rk = VK;
      DataCopyExtParams xp{1, (uint32_t)rk, 0, 0, 0};
      DataCopyPadExtParams<int8_t> pad{true, 0, 0, 0};
      if constexpr (!FPA)
        DataCopyPad(xl, xx[row * (int64_t)K + kk], xp, pad);
      DataCopyExtParams wp{(uint16_t)rk, (uint32_t)rn, (uint32_t)(N - rn), 0, 0};
      DataCopyPad(wl, ww[expert * (int64_t)K * N + kk * (int64_t)N + col], wp, pad);
      auto ev = p.FetchEventID(HardEvent::MTE2_V);
      SetFlag<HardEvent::MTE2_V>(ev);
      WaitFlag<HardEvent::MTE2_V>(ev);
      if constexpr (!FPA) {
        auto es = p.FetchEventID(HardEvent::MTE2_S);
        SetFlag<HardEvent::MTE2_S>(es);
        WaitFlag<HardEvent::MTE2_S>(es);
      }
      Cast(wh, wl, RoundMode::CAST_NONE, rk * stride);
      PipeBarrier<PIPE_V>();

      if constexpr (!FPA) {
        Cast(wi, wh, RoundMode::CAST_RINT, rk * stride);
        PipeBarrier<PIPE_V>();
      }
      for (int j = 0; j < rk; ++j) {
        if constexpr (FPA) {
          Axpy(acc, wh[j * stride],
               static_cast<half>((int32_t)xx.GetValue(row * (int64_t)K + kk + j)), stride);
          PipeBarrier<PIPE_V>();
        } else {
          int32_t xv = (int32_t)xl.GetValue(j);
          Muls(ti, wi[j * stride], xv, stride);
          PipeBarrier<PIPE_V>();
          Add(acc, acc, ti, stride);
          PipeBarrier<PIPE_V>();
        }
      }
      if (kk + VK < K) {
        auto evback = p.FetchEventID(HardEvent::V_MTE2);
        SetFlag<HardEvent::V_MTE2>(evback);
        WaitFlag<HardEvent::V_MTE2>(evback);
      }
    }
    if constexpr (FPA) {
      Mul(z, acc, sl, stride);
      PipeBarrier<PIPE_V>();
    } else {
      Cast(z, acc, RoundMode::CAST_RINT, stride);
      PipeBarrier<PIPE_V>();
      Mul(z, z, sl, stride);
      PipeBarrier<PIPE_V>();
    }
    Mul(t, z, z, stride);
    PipeBarrier<PIPE_V>();
    Muls(t, t, 0.044715f, stride);
    PipeBarrier<PIPE_V>();
    Adds(t, t, 1.0f, stride);
    PipeBarrier<PIPE_V>();
    Mul(t, t, z, stride);
    PipeBarrier<PIPE_V>();
    Muls(t, t, -1.5957691216057308f, stride);
    PipeBarrier<PIPE_V>();
    Mins(t, t, 80.0f, stride);
    PipeBarrier<PIPE_V>();
    Maxs(t, t, -80.0f, stride);
    PipeBarrier<PIPE_V>();
    Exp(t, t, stride);
    PipeBarrier<PIPE_V>();
    Adds(t, t, 1.0f, stride);
    PipeBarrier<PIPE_V>();
    Div(u, z, t, stride);
    PipeBarrier<PIPE_V>();
    Cast(o, u, RoundMode::CAST_RINT, stride);
    PipeBarrier<PIPE_V>();
    auto eo = p.FetchEventID(HardEvent::V_MTE3);
    SetFlag<HardEvent::V_MTE3>(eo);
    WaitFlag<HardEvent::V_MTE3>(eo);
    DataCopyExtParams op{1, (uint32_t)(rn * 2), 0, 0, 0};
    DataCopyPad(yy[row * (int64_t)N + col], o, op);
    auto eb = p.FetchEventID(HardEvent::MTE3_V);
    SetFlag<HardEvent::MTE3_V>(eb);
    WaitFlag<HardEvent::MTE3_V>(eb);
  }
}

                                                                       
                                                                              
template <int VN>
__global__ __vector__ void grouped_matmul_gelu_small_compact(GM_ADDR x, GM_ADDR w, GM_ADDR s,
                                                             GM_ADDR g, GM_ADDR y, int M, int N,
                                                             int K, int E) {
  int task = GetBlockIdx(), nt = (N + VN - 1) / VN;
  if (task >= M * nt)
    return;
  int row = task / nt, col = task % nt * VN, rn = N - col;
  if (rn > VN)
    rn = VN;
  int stride = (rn + 31) / 32 * 32;
  LocalTensor<int8_t> wl(TPosition::VECIN, 0, 4 * VN);
  LocalTensor<half> wh(TPosition::VECCALC, 4 * VN, 4 * VN);
  LocalTensor<float> scale(TPosition::VECIN, 12 * VN, VN), acc(TPosition::VECCALC, 16 * VN, VN);
  LocalTensor<float> z(TPosition::VECCALC, 20 * VN, VN), t(TPosition::VECCALC, 24 * VN, VN),
      u(TPosition::VECCALC, 28 * VN, VN);
  LocalTensor<half> out(TPosition::VECOUT, 32 * VN, VN);
  GlobalTensor<int8_t> xx, ww;
  GlobalTensor<float> ss;
  GlobalTensor<int64_t> gg;
  GlobalTensor<half> yy;
  xx.SetGlobalBuffer((__gm__ int8_t *)x);
  ww.SetGlobalBuffer((__gm__ int8_t *)w);
  ss.SetGlobalBuffer((__gm__ float *)s);
  gg.SetGlobalBuffer((__gm__ int64_t *)g);
  yy.SetGlobalBuffer((__gm__ half *)y);
  int expert = 0;
  while (expert < E - 1 && row >= gg.GetValue(expert))
    ++expert;
  DataCopyExtParams sp{1, (uint32_t)(rn * 4), 0, 0, 0};
  DataCopyPadExtParams<float> sf{true, 0, 0, 0};
  DataCopyPad(scale, ss[expert * (int64_t)N + col], sp, sf);
  DataCopyExtParams wp{(uint16_t)K, (uint32_t)rn, (uint32_t)(N - rn), 0, 0};
  DataCopyPadExtParams<int8_t> ip{true, 0, 0, 0};
  DataCopyPad(wl, ww[expert * (int64_t)K * N + col], wp, ip);
  Duplicate(acc, 0.0f, stride);
  PipeBarrier<PIPE_V>();
  SetFlag<HardEvent::MTE2_V>(0);
  WaitFlag<HardEvent::MTE2_V>(0);
  Cast(wh, wl, RoundMode::CAST_NONE, K * stride);
  PipeBarrier<PIPE_V>();
  for (int j = 0; j < K; ++j) {
    Axpy(acc, wh[j * stride], static_cast<half>((int32_t)xx.GetValue(row * (int64_t)K + j)),
         stride);
    PipeBarrier<PIPE_V>();
  }
  Mul(z, acc, scale, stride);
  PipeBarrier<PIPE_V>();
  Mul(t, z, z, stride);
  PipeBarrier<PIPE_V>();
  Muls(t, t, 0.044715f, stride);
  PipeBarrier<PIPE_V>();
  Adds(t, t, 1.0f, stride);
  PipeBarrier<PIPE_V>();
  Mul(t, t, z, stride);
  PipeBarrier<PIPE_V>();
  Muls(t, t, -1.5957691216057308f, stride);
  PipeBarrier<PIPE_V>();
  Mins(t, t, 80.0f, stride);
  PipeBarrier<PIPE_V>();
  Maxs(t, t, -80.0f, stride);
  PipeBarrier<PIPE_V>();
  Exp(t, t, stride);
  PipeBarrier<PIPE_V>();
  Adds(t, t, 1.0f, stride);
  PipeBarrier<PIPE_V>();
  Div(u, z, t, stride);
  PipeBarrier<PIPE_V>();
  Cast(out, u, RoundMode::CAST_RINT, stride);
  PipeBarrier<PIPE_V>();
  SetFlag<HardEvent::V_MTE3>(0);
  WaitFlag<HardEvent::V_MTE3>(0);
  DataCopyExtParams op{1, (uint32_t)(rn * 2), 0, 0, 0};
  DataCopyPad(yy[row * (int64_t)N + col], out, op);
  SetFlag<HardEvent::MTE3_S>(0);
  WaitFlag<HardEvent::MTE3_S>(0);
}

static __attribute__((noinline)) bool TryTinyFixed(GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR g,
                                                   GM_ADDR y, int M, int N, int K, int E,
                                                   int64_t availableCoreNum, aclrtStream stream);
static void run_small_kernel(GM_ADDR x, const TensorGroupInfo &ix, GM_ADDR w,
                             const TensorGroupInfo &iw, GM_ADDR s, const TensorGroupInfo &is,
                             GM_ADDR g, const TensorGroupInfo &ig, GM_ADDR y,
                             const TensorGroupInfo &iy, int64_t availableCoreNum,
                             aclrtStream stream) {
  int M = ix.tensors[0].shape[0], K = ix.tensors[0].shape[1], E = iw.tensors[0].shape[0],
      N = iw.tensors[0].shape[2];
  int vn = 128, rm = 1;
  if (K <= 64 && M * ((N + 511) / 512) >= 48)
    vn = 512;
  if (K <= 32 && ((M + 3) / 4) * ((N + vn - 1) / vn) >= 48)
    rm = 4;
  int tasks = ((M + rm - 1) / rm) * ((N + vn - 1) / vn), blocks = (int)availableCoreNum * 2;
  if (blocks > tasks)
    blocks = tasks;
  int minBlocks = K <= 8 ? ((int)availableCoreNum * 4 + 4) / 5 : (int)availableCoreNum;
  if (blocks < minBlocks)
    blocks = minBlocks;
  if (TryTinyFixed(x, w, s, g, y, M, N, K, E, availableCoreNum, stream))
    return;
                                                                    
  if (K <= 4 && rm == 1 && tasks <= blocks) {
    blocks = tasks;
    if (vn == 512)
      grouped_matmul_gelu_small_compact<512>
          <<<blocks, nullptr, stream>>>(x, w, s, g, y, M, N, K, E);
    else
      grouped_matmul_gelu_small_compact<128>
          <<<blocks, nullptr, stream>>>(x, w, s, g, y, M, N, K, E);
    return;
  }
  if (K <= 64) {
    if (rm == 1 && tasks <= blocks) {
      if (vn == 512)
        grouped_matmul_gelu_small_prefetch<true, 512>
            <<<blocks, nullptr, stream>>>(x, w, s, g, y, M, N, K, E);
      else
        grouped_matmul_gelu_small_prefetch<true, 128>
            <<<blocks, nullptr, stream>>>(x, w, s, g, y, M, N, K, E);
      return;
    }
    if (rm == 4) {
      if (vn == 512)
        grouped_matmul_gelu_small_reuse<512, 4>
            <<<blocks, nullptr, stream>>>(x, w, s, g, y, M, N, K, E);
      else
        grouped_matmul_gelu_small_reuse<128, 4>
            <<<blocks, nullptr, stream>>>(x, w, s, g, y, M, N, K, E);
    } else if (vn == 512)
      grouped_matmul_gelu_small_tiled<true, 512>
          <<<blocks, nullptr, stream>>>(x, w, s, g, y, M, N, K, E);
    else
      grouped_matmul_gelu_small_tiled<true, 128>
          <<<blocks, nullptr, stream>>>(x, w, s, g, y, M, N, K, E);
  } else
    grouped_matmul_gelu_small_tiled<false, 128>
        <<<blocks, nullptr, stream>>>(x, w, s, g, y, M, N, K, E);
}

#include "kernel_operator.h"
#include "lib/matmul_intf.h"
#include "tiling/tiling_api.h"
using namespace AscendC;
constexpr int RING = 2;
constexpr uint16_t READY_FLAG = 5, FREE_FLAG = 3;
using AT = matmul::MatmulType<TPosition::GM, CubeFormat::ND, int8_t>;
using BType = matmul::MatmulType<TPosition::GM, CubeFormat::ND, int8_t>;
using CT = matmul::MatmulType<TPosition::GM, CubeFormat::ND, int32_t>;
using BIAS = matmul::MatmulType<TPosition::GM, CubeFormat::ND, int32_t>;

template <int BM, int BN> __aicore__ constexpr MatmulConfig fixed_base_config() {
  auto cfg = CFG_MDL;
  cfg.basicM = BM;
  cfg.basicN = BN;
  cfg.basicK = BN == 512 ? 64 : 128;
  cfg.singleCoreM = BM;
  cfg.singleCoreN = BN;
  cfg.singleCoreK = 8192;
  cfg.enableSetTail = true;
  cfg.enableSetBias = false;
  cfg.enableQuantVector = false;
  cfg.enableSetDefineData = false;
  return cfg;
}

template <int BM, int BN> __aicore__ constexpr MatmulApiStaticTiling fixed_max_tile_tiling() {
  auto td = GetMatmulApiTiling<AT, BType, CT, BIAS>(fixed_base_config<BM, BN>());
  td.stepM = 1;
  td.stepN = 1;
  td.stepKa = BN == 512 ? 8 : 4;
  td.stepKb = 4;
  td.depthA1 = 2 * td.stepKa;
  td.depthB1 = 8;
  td.shareL1Size = BM * td.baseK * td.depthA1 + BN * td.baseK * td.depthB1;
  td.dbL0C = 1;
  return td;
}

template <int BM, int BN, bool CONSTANT = false>
__global__ __mix__(1, 2) void grouped_matmul_gelu_stream(GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR g,
                                                         GM_ADDR y, GM_ADDR work, int M, int N,
                                                         int K, int E, int cores, TCubeTiling td) {
  constexpr int BC = BM * BN;
  constexpr int VM = BM / 2;
  TPipe pipe;
  constexpr static auto STATIC_CFG = fixed_max_tile_tiling<BM, BN>();
  using MM =
      typename Std::conditional<CONSTANT, matmul::MatmulImpl<AT, BType, CT, BIAS, STATIC_CFG>,
                                matmul::MatmulImpl<AT, BType, CT, BIAS, CFG_MDL>>::type;
  MM mm;
  TBuf<TPosition::VECIN> cb, sb;
  TBuf<TPosition::VECCALC> zb, tb, ub;
  TBuf<TPosition::VECOUT> ob;
  if ASCEND_IS_AIC {
    mm.SetSubBlockIdx(0);
    mm.Init(&td, &pipe);
  }
  if ASCEND_IS_AIV {
    pipe.InitBuffer(cb, VM * BN * 4);
    pipe.InitBuffer(sb, BN * 4 + 256);
    pipe.InitBuffer(tb, VM * BN * 4 + 256);
    pipe.InitBuffer(ob, VM * BN * 2);
  }
  GlobalTensor<int8_t> xx, ww;
  GlobalTensor<float> ss;
  GlobalTensor<int64_t> gg;
  GlobalTensor<half> yy;
  GlobalTensor<int32_t> cc;
  xx.SetGlobalBuffer((__gm__ int8_t *)x);
  ww.SetGlobalBuffer((__gm__ int8_t *)w);
  ss.SetGlobalBuffer((__gm__ float *)s);
  gg.SetGlobalBuffer((__gm__ int64_t *)g);
  yy.SetGlobalBuffer((__gm__ half *)y);
  cc.SetGlobalBuffer((__gm__ int32_t *)work);
  int bid = GetBlockIdx(), sub = 0;
  if ASCEND_IS_AIV {
    bid = GetBlockIdx() / 2;
    sub = GetSubBlockIdx();
  }
  int tileBase = 0, start = 0, serial = 0;
  for (int e = 0; e < E; ++e) {
    int end = (int)gg.GetValue(e), rows = end - start, nt = (N + BN - 1) / BN,
        mt = (rows + BM - 1) / BM, tasks = mt * nt;
    int local = (bid - tileBase % cores + cores) % cores;
    for (int ti = local; ti < tasks; ti += cores) {
      int ncol = ti % nt;
      if constexpr (BN == 512) {
        if (N % BN && nt > 1 && cores % nt == 0)
          ncol = (ncol + (tileBase + ti) / cores) % nt;
      }
      int mi = (ti / nt) * BM, ni = ncol * BN, rm = rows - mi, rn = N - ni;
      if (rm > BM)
        rm = BM;
      if (rn > BN)
        rn = BN;
      int64_t coff = ((serial % RING) * cores + bid) * (int64_t)BC;
      if ASCEND_IS_AIC {
        if (serial >= RING)
          CrossCoreWaitFlag(FREE_FLAG + serial % RING);
        mm.SetOrgShape(M, N, K, K, BN);
        mm.SetSingleShape(rm, rn, K);
        mm.SetTensorA(xx[(start + mi) * (int64_t)K]);
        mm.SetTensorB(ww[e * (int64_t)K * N + ni]);
        while (mm.Iterate()) {
          mm.GetTensorC(cc[coff], 0, false);
        }
        CrossCoreSetFlag<2, PIPE_FIX>(READY_FLAG + serial % RING);
      }
      if ASCEND_IS_AIV {
        auto ci = cb.Get<int32_t>();
        auto sc = sb.Get<float>()[BN == 512 ? 64 : 0];
        auto z = cb.Get<float>();
        auto t = tb.Get<float>();
        auto u = cb.Get<float>();
        auto o = ob.Get<half>();
        int split = (rm + 1) / 2, vstart = sub * split, vm = rm - vstart;
        if (vm > split)
          vm = split;
        if (vm < 0)
          vm = 0;
        int stride = (rn + 15) / 16 * 16;
        CrossCoreWaitFlag(READY_FLAG + serial % RING);
        int totalVm = vm;
        for (int vr = 0; vr < totalVm; vr += VM) {
          vm = totalVm - vr;
          if (vm > VM)
            vm = VM;
          auto inputReuse = pipe.FetchEventID(HardEvent::V_MTE2);
          SetFlag<HardEvent::V_MTE2>(inputReuse);
          WaitFlag<HardEvent::V_MTE2>(inputReuse);
          DataCopyExtParams cp{(uint16_t)vm, (uint32_t)(rn * 4), (uint32_t)((BN - rn) * 4),
                               (uint32_t)((stride - (rn + 7) / 8 * 8) / 8), 0};
          DataCopyPadExtParams<int32_t> ip{true, 0, 0, 0};
          DataCopyPad(ci, cc[coff + (vstart + vr) * BN], cp, ip);
          DataCopyExtParams sp{1, (uint32_t)(rn * 4), 0, 0, 0};
          DataCopyPadExtParams<float> fp{true, 0, 0, 0};
          DataCopyPad(sc, ss[e * (int64_t)N + ni], sp, fp);
          auto ev = pipe.FetchEventID(HardEvent::MTE2_V);
          SetFlag<HardEvent::MTE2_V>(ev);
          WaitFlag<HardEvent::MTE2_V>(ev);
          if (vr + vm >= totalVm)
            CrossCoreSetFlag<2, PIPE_MTE2>(FREE_FLAG + serial % RING);
          int count = vm * stride;
          Cast(z, ci, RoundMode::CAST_NONE, count);
          PipeBarrier<PIPE_V>();
          for (int c = 0; c < stride; c += 64) {
            uint64_t mask = (stride - c < 64 ? stride - c : 64);
            Mul(z[c], z[c], sc[c], mask, (uint8_t)vm,
                {1, 1, 1, (uint8_t)(stride / 8), (uint8_t)(stride / 8), 0});
          }
          PipeBarrier<PIPE_V>();
          GmmDirectVectorCounter(z, t, u, count);
          Cast(o, u, RoundMode::CAST_RINT, count);
          PipeBarrier<PIPE_V>();
          auto ev2 = pipe.FetchEventID(HardEvent::V_MTE3);
          SetFlag<HardEvent::V_MTE3>(ev2);
          WaitFlag<HardEvent::V_MTE3>(ev2);
          DataCopyExtParams op{(uint16_t)vm, (uint32_t)(rn * 2),
                               (uint32_t)((stride - (rn + 15) / 16 * 16) / 16),
                               (uint32_t)((N - rn) * 2), 0};
          DataCopyPad(yy[(start + mi + vstart + vr) * (int64_t)N + ni], o, op);
          auto ev3 = pipe.FetchEventID(HardEvent::MTE3_V);
          SetFlag<HardEvent::MTE3_V>(ev3);
          WaitFlag<HardEvent::MTE3_V>(ev3);
        }
        if (!totalVm)
          CrossCoreSetFlag<2, PIPE_MTE2>(FREE_FLAG + serial % RING);
      }
      ++serial;
    }
    tileBase += tasks;
    start = end;
  }
  if ASCEND_IS_AIC {
    mm.End();
    for (int i = 0; i < (serial < RING ? serial : RING); ++i)
      CrossCoreWaitFlag(FREE_FLAG + (serial - 1 - i) % RING);
  }
}
template <int BM, int BN, bool CONSTANT = false>
__global__ __mix__(1, 2) void grouped_matmul_gelu_rowgrid(GM_ADDR x, GM_ADDR w, GM_ADDR s,
                                                          GM_ADDR g, GM_ADDR y, GM_ADDR work, int M,
                                                          int N, int K, int E, int cores,
                                                          TCubeTiling td) {
  constexpr int BC = BM * BN;
  TPipe pipe;
  constexpr static auto STATIC_CFG = fixed_max_tile_tiling<BM, BN>();
  using MM =
      typename Std::conditional<CONSTANT, matmul::MatmulImpl<AT, BType, CT, BIAS, STATIC_CFG>,
                                matmul::MatmulImpl<AT, BType, CT, BIAS, CFG_MDL>>::type;
  MM mm;
  TBuf<TPosition::VECIN> cb, sb;
  TBuf<TPosition::VECCALC> zb, tb, ub;
  TBuf<TPosition::VECOUT> ob;
  if ASCEND_IS_AIC {
    mm.SetSubBlockIdx(0);
    mm.Init(&td, &pipe);
  }
  if ASCEND_IS_AIV {
    pipe.InitBuffer(cb, 32 * BN * 4);
    pipe.InitBuffer(sb, BN * 4 + 256);
    if (BN == 256)
      pipe.InitBuffer(zb, 32 * BN * 4 + 256);
    pipe.InitBuffer(tb, 32 * BN * 4 + 256);
    if (BN == 256)
      pipe.InitBuffer(ub, 32 * BN * 4 + 256);
    pipe.InitBuffer(ob, 32 * BN * 2);
  }
  GlobalTensor<int8_t> xx, ww;
  GlobalTensor<float> ss;
  GlobalTensor<int64_t> gg;
  GlobalTensor<half> yy;
  GlobalTensor<int32_t> cc;
  xx.SetGlobalBuffer((__gm__ int8_t *)x);
  ww.SetGlobalBuffer((__gm__ int8_t *)w);
  ss.SetGlobalBuffer((__gm__ float *)s);
  gg.SetGlobalBuffer((__gm__ int64_t *)g);
  yy.SetGlobalBuffer((__gm__ half *)y);
  cc.SetGlobalBuffer((__gm__ int32_t *)work);
  int bid = GetBlockIdx(), sub = 0;
  if ASCEND_IS_AIV {
    bid = GetBlockIdx() / 2;
    sub = GetSubBlockIdx();
  }
  int serial = 0, nt = (N + BN - 1) / BN, mt = (M + BM - 1) / BM;
  for (int task = bid; task < mt * nt; task += cores) {
    int row = (task / nt) * BM, rowEnd = row + BM, ni = (task % nt) * BN;
    if (rowEnd > M)
      rowEnd = M;
                                                                                   
                                                                   
    int e = row * E / M, predictedEnd = (int)gg.GetValue(e),
        predictedBegin = e ? (int)gg.GetValue(e - 1) : 0;
    if (row < predictedBegin || row >= predictedEnd) {
      int lo = row >= predictedEnd ? e + 1 : 0, hi = row < predictedBegin ? e : E;
      while (lo < hi) {
        int mid = (lo + hi) / 2;
        if ((int)gg.GetValue(mid) <= row)
          lo = mid + 1;
        else
          hi = mid;
      }
      e = lo;
    }
    while (row < rowEnd && e < E) {
      int groupEnd = (int)gg.GetValue(e);
      if (groupEnd <= row) {
        ++e;
        continue;
      }
      int start = row, mi = 0, rm = (groupEnd < rowEnd ? groupEnd : rowEnd) - row, rn = N - ni;
      if (rn > BN)
        rn = BN;
      int64_t coff = ((serial % RING) * cores + bid) * (int64_t)BC;
      if ASCEND_IS_AIC {
        if (serial >= RING)
          CrossCoreWaitFlag(FREE_FLAG + serial % RING);
        mm.SetOrgShape(M, N, K, K, BN);
        mm.SetSingleShape(rm, rn, K);
        mm.SetTensorA(xx[(start + mi) * (int64_t)K]);
        mm.SetTensorB(ww[e * (int64_t)K * N + ni]);
        while (mm.Iterate()) {
          mm.GetTensorC(cc[coff], 0, false);
        }
        CrossCoreSetFlag<2, PIPE_FIX>(READY_FLAG + serial % RING);
      }
      if ASCEND_IS_AIV {
        auto ci = cb.Get<int32_t>();
        auto sc = sb.Get<float>()[BN == 512 ? 64 : 0];
        auto z = BN == 512 ? cb.Get<float>() : zb.Get<float>();
        auto t = tb.Get<float>();
        auto u = BN == 512 ? cb.Get<float>() : ub.Get<float>();
        auto o = ob.Get<half>();
        int split = (rm + 1) / 2, vstart = sub * split, vm = rm - vstart;
        if (vm > split)
          vm = split;
        if (vm < 0)
          vm = 0;
        int stride = (rn + 15) / 16 * 16;
        CrossCoreWaitFlag(READY_FLAG + serial % RING);
        int totalVm = vm;
        for (int vr = 0; vr < totalVm; vr += 32) {
          vm = totalVm - vr;
          if (vm > 32)
            vm = 32;
          auto inputReuse = pipe.FetchEventID(HardEvent::V_MTE2);
          SetFlag<HardEvent::V_MTE2>(inputReuse);
          WaitFlag<HardEvent::V_MTE2>(inputReuse);
          DataCopyExtParams cp{(uint16_t)vm, (uint32_t)(rn * 4), (uint32_t)((BN - rn) * 4),
                               (uint32_t)((stride - (rn + 7) / 8 * 8) / 8), 0};
          DataCopyPadExtParams<int32_t> ip{true, 0, 0, 0};
          DataCopyPad(ci, cc[coff + (vstart + vr) * BN], cp, ip);
          DataCopyExtParams sp{1, (uint32_t)(rn * 4), 0, 0, 0};
          DataCopyPadExtParams<float> fp{true, 0, 0, 0};
          DataCopyPad(sc, ss[e * (int64_t)N + ni], sp, fp);
          auto ev = pipe.FetchEventID(HardEvent::MTE2_V);
          SetFlag<HardEvent::MTE2_V>(ev);
          WaitFlag<HardEvent::MTE2_V>(ev);
          if (vr + vm >= totalVm)
            CrossCoreSetFlag<2, PIPE_MTE2>(FREE_FLAG + serial % RING);
          int count = vm * stride;
          Cast(z, ci, RoundMode::CAST_NONE, count);
          PipeBarrier<PIPE_V>();
          for (int c = 0; c < stride; c += 64) {
            uint64_t mask = (stride - c < 64 ? stride - c : 64);
            Mul(z[c], z[c], sc[c], mask, (uint8_t)vm,
                {1, 1, 1, (uint8_t)(stride / 8), (uint8_t)(stride / 8), 0});
          }
          PipeBarrier<PIPE_V>();
          GmmDirectVectorCounter(z, t, u, count);
          Cast(o, u, RoundMode::CAST_RINT, count);
          PipeBarrier<PIPE_V>();
          auto ev2 = pipe.FetchEventID(HardEvent::V_MTE3);
          SetFlag<HardEvent::V_MTE3>(ev2);
          WaitFlag<HardEvent::V_MTE3>(ev2);
          DataCopyExtParams op{(uint16_t)vm, (uint32_t)(rn * 2),
                               (uint32_t)((stride - (rn + 15) / 16 * 16) / 16),
                               (uint32_t)((N - rn) * 2), 0};
          DataCopyPad(yy[(start + mi + vstart + vr) * (int64_t)N + ni], o, op);
          auto ev3 = pipe.FetchEventID(HardEvent::MTE3_V);
          SetFlag<HardEvent::MTE3_V>(ev3);
          WaitFlag<HardEvent::MTE3_V>(ev3);
        }
        if (!totalVm)
          CrossCoreSetFlag<2, PIPE_MTE2>(FREE_FLAG + serial % RING);
      }
      ++serial;
      row += rm;
      if (row >= groupEnd)
        ++e;
    }
  }
  if ASCEND_IS_AIC {
    mm.End();
    for (int i = 0; i < (serial < RING ? serial : RING); ++i)
      CrossCoreWaitFlag(FREE_FLAG + (serial - 1 - i) % RING);
  }
}

                                                                                         
                                                                                         
template <int BN>
__aicore__ inline void PackWeightsThisInvocation(GM_ADDR source, GM_ADDR dest, GM_ADDR groups,
                                                 int E, int K, int N, int NP, TPipe &pipe,
                                                 LocalTensor<int8_t> stage) {
  GlobalTensor<int8_t> input, output;
  GlobalTensor<int64_t> gg;
  input.SetGlobalBuffer((__gm__ int8_t *)source);
  output.SetGlobalBuffer((__gm__ int8_t *)dest);
  gg.SetGlobalBuffer((__gm__ int64_t *)groups);
  constexpr int STAGE_BYTES = 32 * BN * 4;
  int batch = STAGE_BYTES / NP, parts = (K + batch - 1) / batch;
  int id = GetBlockIdx(), workers = GetBlockNum() * 2;
  Duplicate(stage.ReinterpretCast<int32_t>(), int32_t(0), STAGE_BYTES / 4);
  PipeBarrier<PIPE_V>();
  auto zeroReady = pipe.FetchEventID(HardEvent::V_MTE2);
  SetFlag<HardEvent::V_MTE2>(zeroReady);
  WaitFlag<HardEvent::V_MTE2>(zeroReady);
  int previous = 0;
  for (int e = 0; e < E; ++e) {
    int end = (int)gg.GetValue(e), active = end - previous;
    previous = end;
    if (active == 0)
      continue;
    int first = (id - (e * parts) % workers + workers) % workers;
    for (int tile = first; tile < parts; tile += workers) {
      int row = tile * batch, rows = K - row;
      if (rows > batch)
        rows = batch;
      DataCopyExtParams in{(uint16_t)rows, (uint32_t)N, 0,
                           (uint32_t)((NP - (N + 31) / 32 * 32) / 32), 0};
      DataCopyPadExtParams<int8_t> pad{true, 0, 0, 0};
      DataCopyPad(stage, input[(e * (int64_t)K + row) * N], in, pad);
      auto loaded = pipe.FetchEventID(HardEvent::MTE2_MTE3);
      SetFlag<HardEvent::MTE2_MTE3>(loaded);
      WaitFlag<HardEvent::MTE2_MTE3>(loaded);
      DataCopy(output[(e * (int64_t)K + row) * NP], stage, rows * NP);
      auto consumed = pipe.FetchEventID(HardEvent::MTE3_MTE2);
      SetFlag<HardEvent::MTE3_MTE2>(consumed);
      WaitFlag<HardEvent::MTE3_MTE2>(consumed);
    }
  }
}

template <int BM, int BN, bool CONSTANT = false>
__global__ __mix__(1, 2) void grouped_matmul_gelu_packed(GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR g,
                                                         GM_ADDR y, GM_ADDR work,
                                                         GM_ADDR packedWeight, int M, int N, int NP,
                                                         int K, int E, int cores, TCubeTiling td) {
  constexpr int BC = BM * BN;
  constexpr int VM = BM / 2;
  TPipe pipe;
  constexpr static auto STATIC_CFG = fixed_max_tile_tiling<BM, BN>();
  using MM =
      typename Std::conditional<CONSTANT, matmul::MatmulImpl<AT, BType, CT, BIAS, STATIC_CFG>,
                                matmul::MatmulImpl<AT, BType, CT, BIAS, CFG_MDL>>::type;
  MM mm;
  TBuf<TPosition::VECIN> cb, sb;
  TBuf<TPosition::VECCALC> zb, tb, ub;
  TBuf<TPosition::VECOUT> ob;
  if ASCEND_IS_AIC {
    mm.SetSubBlockIdx(0);
    mm.Init(&td, &pipe);
  }
  if ASCEND_IS_AIV {
    pipe.InitBuffer(cb, VM * BN * 4);
    pipe.InitBuffer(sb, BN * 4);
    pipe.InitBuffer(tb, VM * BN * 4);
    pipe.InitBuffer(ob, VM * BN * 2);
  }
  GlobalTensor<int8_t> xx, ww;
  GlobalTensor<float> ss;
  GlobalTensor<int64_t> gg;
  GlobalTensor<half> yy;
  GlobalTensor<int32_t> cc;
  xx.SetGlobalBuffer((__gm__ int8_t *)x);
  ww.SetGlobalBuffer((__gm__ int8_t *)packedWeight);
  ss.SetGlobalBuffer((__gm__ float *)s);
  gg.SetGlobalBuffer((__gm__ int64_t *)g);
  yy.SetGlobalBuffer((__gm__ half *)y);
  cc.SetGlobalBuffer((__gm__ int32_t *)work);
  if ASCEND_IS_AIV {
    PackWeightsThisInvocation<BN>(w, packedWeight, g, E, K, N, NP, pipe, cb.Get<int8_t>());
  }
  SyncAll<false>();
  int bid = GetBlockIdx(), sub = 0;
  if ASCEND_IS_AIV {
    bid = GetBlockIdx() / 2;
    sub = GetSubBlockIdx();
  }
                                                                         
                                                                          
  TEventID outputDone = 0;
  bool outputPending = false;
  if ASCEND_IS_AIV {
    outputDone = pipe.FetchEventID(HardEvent::MTE3_V);
  }
  int tileBase = 0, start = 0, serial = 0;
  for (int e = 0; e < E; ++e) {
    int end = (int)gg.GetValue(e), rows = end - start, nt = (N + BN - 1) / BN,
        mt = (rows + BM - 1) / BM, tasks = mt * nt;
    int local = (bid - tileBase % cores + cores) % cores;
    for (int ti = local; ti < tasks; ti += cores) {
      int mi = (ti / nt) * BM, ni = (ti % nt) * BN, rm = rows - mi, rn = N - ni;
      if (rm > BM)
        rm = BM;
      if (rn > BN)
        rn = BN;
      int cn = BN;
      int64_t coff = ((serial % RING) * cores + bid) * (int64_t)BC;
      if ASCEND_IS_AIC {
        if (serial >= RING)
          CrossCoreWaitFlag(FREE_FLAG + serial % RING);
        mm.SetOrgShape(M, NP, K, K, BN);
        mm.SetSingleShape(rm, cn, K);
        mm.SetTensorA(xx[(start + mi) * (int64_t)K]);
        mm.SetTensorB(ww[e * (int64_t)K * NP + ni]);
        while (mm.Iterate()) {
          mm.GetTensorC(cc[coff], 0, false);
        }
        CrossCoreSetFlag<2, PIPE_FIX>(READY_FLAG + serial % RING);
      }
      if ASCEND_IS_AIV {
        auto ci = cb.Get<int32_t>();
        auto sc = sb.Get<float>();
        auto z = cb.Get<float>();
        auto t = tb.Get<float>();
        auto u = cb.Get<float>();
        auto o = tb.Get<half>();
        int split = (rm + 1) / 2, vstart = sub * split, vm = rm - vstart;
        if (vm > split)
          vm = split;
        if (vm < 0)
          vm = 0;
        int stride = (rn + 15) / 16 * 16;
        CrossCoreWaitFlag(READY_FLAG + serial % RING);
        int totalVm = vm;
        for (int vr = 0; vr < totalVm; vr += VM) {
          vm = totalVm - vr;
          if (vm > VM)
            vm = VM;
          auto inputReuse = pipe.FetchEventID(HardEvent::V_MTE2);
          SetFlag<HardEvent::V_MTE2>(inputReuse);
          WaitFlag<HardEvent::V_MTE2>(inputReuse);
          DataCopyExtParams cp{(uint16_t)vm, (uint32_t)(rn * 4), (uint32_t)((BN - rn) * 4),
                               (uint32_t)((stride - (rn + 7) / 8 * 8) / 8), 0};
          DataCopyPadExtParams<int32_t> ip{true, 0, 0, 0};
          DataCopyPad(ci, cc[coff + (vstart + vr) * BN], cp, ip);
          DataCopyExtParams sp{1, (uint32_t)(rn * 4), 0, 0, 0};
          DataCopyPadExtParams<float> fp{true, 0, 0, 0};
          DataCopyPad(sc, ss[e * (int64_t)N + ni], sp, fp);
          auto ev = pipe.FetchEventID(HardEvent::MTE2_V);
          SetFlag<HardEvent::MTE2_V>(ev);
          WaitFlag<HardEvent::MTE2_V>(ev);
          if (vr + vm >= totalVm)
            CrossCoreSetFlag<2, PIPE_MTE2>(FREE_FLAG + serial % RING);
          int count = vm * stride;
          Cast(z, ci, RoundMode::CAST_NONE, count);
          PipeBarrier<PIPE_V>();
          for (int c = 0; c < stride; c += 64) {
            uint64_t mask = (stride - c < 64 ? stride - c : 64);
            Mul(z[c], z[c], sc[c], mask, (uint8_t)vm,
                {1, 1, 1, (uint8_t)(stride / 8), (uint8_t)(stride / 8), 0});
          }
                                                                          
                                                                              
          if (outputPending) {
            WaitFlag<HardEvent::MTE3_V>(outputDone);
            outputPending = false;
          }
          PipeBarrier<PIPE_V>();
          GmmDirectVectorCounter(z, t, u, count);
          Cast(o, u, RoundMode::CAST_RINT, count);
          PipeBarrier<PIPE_V>();
          auto ev2 = pipe.FetchEventID(HardEvent::V_MTE3);
          SetFlag<HardEvent::V_MTE3>(ev2);
          WaitFlag<HardEvent::V_MTE3>(ev2);
          DataCopyExtParams op{(uint16_t)vm, (uint32_t)(rn * 2),
                               (uint32_t)((stride - (rn + 15) / 16 * 16) / 16),
                               (uint32_t)((N - rn) * 2), 0};
          DataCopyPad(yy[(start + mi + vstart + vr) * (int64_t)N + ni], o, op);
          SetFlag<HardEvent::MTE3_V>(outputDone);
          outputPending = true;
        }
        if (!totalVm)
          CrossCoreSetFlag<2, PIPE_MTE2>(FREE_FLAG + serial % RING);
      }
      ++serial;
    }
    tileBase += tasks;
    start = end;
  }
  if ASCEND_IS_AIV {
    if (outputPending)
      WaitFlag<HardEvent::MTE3_V>(outputDone);
  }
  if ASCEND_IS_AIC {
    mm.End();
    for (int i = 0; i < (serial < RING ? serial : RING); ++i)
      CrossCoreWaitFlag(FREE_FLAG + (serial - 1 - i) % RING);
  }
}
template <int BN>
__aicore__ inline void PackWeightsWithKAlignment(GM_ADDR source, GM_ADDR dest, GM_ADDR groups,
                                                 int E, int K, int KP, int N, int NP, TPipe &pipe,
                                                 LocalTensor<int8_t> stage) {
  GlobalTensor<int8_t> input, output;
  GlobalTensor<int64_t> gg;
  input.SetGlobalBuffer((__gm__ int8_t *)source);
  output.SetGlobalBuffer((__gm__ int8_t *)dest);
  gg.SetGlobalBuffer((__gm__ int64_t *)groups);
  constexpr int STAGE_BYTES = 32 * BN * 4;
  int batch = STAGE_BYTES / NP, parts = (KP + batch - 1) / batch;
  int id = GetBlockIdx(), workers = GetBlockNum() * 2;
  Duplicate(stage.ReinterpretCast<int32_t>(), int32_t(0), STAGE_BYTES / 4);
  PipeBarrier<PIPE_V>();
  auto zeroReady = pipe.FetchEventID(HardEvent::V_MTE2);
  SetFlag<HardEvent::V_MTE2>(zeroReady);
  WaitFlag<HardEvent::V_MTE2>(zeroReady);
  int previous = 0;
  for (int e = 0; e < E; ++e) {
    int end = (int)gg.GetValue(e), active = end - previous;
    previous = end;
    if (active == 0)
      continue;
    int first = (id - (e * parts) % workers + workers) % workers;
    for (int tile = first; tile < parts; tile += workers) {
      int row = tile * batch, rows = KP - row;
      if (rows > batch)
        rows = batch;
      int validRows = K - row;
      if (validRows > rows)
        validRows = rows;
      if (validRows < 0)
        validRows = 0;
      if (validRows < rows) {
        auto freeV = pipe.FetchEventID(HardEvent::MTE3_V);
        SetFlag<HardEvent::MTE3_V>(freeV);
        WaitFlag<HardEvent::MTE3_V>(freeV);
        Duplicate(stage.ReinterpretCast<int32_t>()[validRows * NP / 4], int32_t(0),
                  (rows - validRows) * NP / 4);
        PipeBarrier<PIPE_V>();
        auto padReady = pipe.FetchEventID(HardEvent::V_MTE2);
        SetFlag<HardEvent::V_MTE2>(padReady);
        WaitFlag<HardEvent::V_MTE2>(padReady);
      }
      DataCopyExtParams in{(uint16_t)validRows, (uint32_t)N, 0,
                           (uint32_t)((NP - (N + 31) / 32 * 32) / 32), 0};
      DataCopyPadExtParams<int8_t> pad{true, 0, 0, 0};
      if (validRows)
        DataCopyPad(stage, input[(e * (int64_t)K + row) * N], in, pad);
      auto loaded = pipe.FetchEventID(HardEvent::MTE2_MTE3);
      SetFlag<HardEvent::MTE2_MTE3>(loaded);
      WaitFlag<HardEvent::MTE2_MTE3>(loaded);
      DataCopy(output[(e * (int64_t)KP + row) * NP], stage, rows * NP);
      auto consumed = pipe.FetchEventID(HardEvent::MTE3_MTE2);
      SetFlag<HardEvent::MTE3_MTE2>(consumed);
      WaitFlag<HardEvent::MTE3_MTE2>(consumed);
    }
  }
}

template <int BN>
__aicore__ inline void PackXWithKAlignment(GM_ADDR source, GM_ADDR dest, int M, int K, int KP,
                                           TPipe &pipe, LocalTensor<int8_t> stage) {
  GlobalTensor<int8_t> input, output;
  input.SetGlobalBuffer((__gm__ int8_t *)source);
  output.SetGlobalBuffer((__gm__ int8_t *)dest);
  constexpr int STAGE_BYTES = 32 * BN * 4;
  int batch = STAGE_BYTES / KP, workers = GetBlockNum() * 2, id = GetBlockIdx();
  for (int row = id * batch; row < M; row += workers * batch) {
    int rows = M - row;
    if (rows > batch)
      rows = batch;
    DataCopyExtParams cp{(uint16_t)rows, (uint32_t)K, 0, 0, 0};
    DataCopyPadExtParams<int8_t> pad{true, 0, 0, 0};
    DataCopyPad(stage, input[(int64_t)row * K], cp, pad);
    auto ready = pipe.FetchEventID(HardEvent::MTE2_MTE3);
    SetFlag<HardEvent::MTE2_MTE3>(ready);
    WaitFlag<HardEvent::MTE2_MTE3>(ready);
    DataCopy(output[(int64_t)row * KP], stage, rows * KP);
    auto free = pipe.FetchEventID(HardEvent::MTE3_MTE2);
    SetFlag<HardEvent::MTE3_MTE2>(free);
    WaitFlag<HardEvent::MTE3_MTE2>(free);
  }
}

template <int BM, int BN, bool CONSTANT = false>
__global__ __mix__(1, 2) void grouped_matmul_gelu_packed_kaligned(
    GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR g, GM_ADDR y, GM_ADDR work, GM_ADDR packedWeight,
    GM_ADDR packedX, int M, int N, int NP, int K, int KP, int E, int cores, TCubeTiling td) {
  constexpr int BC = BM * BN;
  constexpr int VM = BM / 2;
  TPipe pipe;
  constexpr static auto STATIC_CFG = fixed_max_tile_tiling<BM, BN>();
  using MM =
      typename Std::conditional<CONSTANT, matmul::MatmulImpl<AT, BType, CT, BIAS, STATIC_CFG>,
                                matmul::MatmulImpl<AT, BType, CT, BIAS, CFG_MDL>>::type;
  MM mm;
  TBuf<TPosition::VECIN> cb, sb;
  TBuf<TPosition::VECCALC> zb, tb, ub;
  TBuf<TPosition::VECOUT> ob;
  if ASCEND_IS_AIC {
    mm.SetSubBlockIdx(0);
    mm.Init(&td, &pipe);
  }
  if ASCEND_IS_AIV {
    pipe.InitBuffer(cb, VM * BN * 4);
    pipe.InitBuffer(sb, BN * 4);
    pipe.InitBuffer(tb, VM * BN * 4);
    pipe.InitBuffer(ob, VM * BN * 2);
  }
  GlobalTensor<int8_t> xx, ww;
  GlobalTensor<float> ss;
  GlobalTensor<int64_t> gg;
  GlobalTensor<half> yy;
  GlobalTensor<int32_t> cc;
  xx.SetGlobalBuffer((__gm__ int8_t *)packedX);
  ww.SetGlobalBuffer((__gm__ int8_t *)packedWeight);
  ss.SetGlobalBuffer((__gm__ float *)s);
  gg.SetGlobalBuffer((__gm__ int64_t *)g);
  yy.SetGlobalBuffer((__gm__ half *)y);
  cc.SetGlobalBuffer((__gm__ int32_t *)work);
  if ASCEND_IS_AIV {
    PackWeightsWithKAlignment<BN>(w, packedWeight, g, E, K, KP, N, NP, pipe, cb.Get<int8_t>());
    PackXWithKAlignment<BN>(x, packedX, M, K, KP, pipe, cb.Get<int8_t>());
  }
  SyncAll<false>();
  int bid = GetBlockIdx(), sub = 0;
  if ASCEND_IS_AIV {
    bid = GetBlockIdx() / 2;
    sub = GetSubBlockIdx();
  }
                                                                         
                                                                          
  TEventID outputDone = 0;
  bool outputPending = false;
  if ASCEND_IS_AIV {
    outputDone = pipe.FetchEventID(HardEvent::MTE3_V);
  }
  int tileBase = 0, start = 0, serial = 0;
  for (int e = 0; e < E; ++e) {
    int end = (int)gg.GetValue(e), rows = end - start, nt = (N + BN - 1) / BN,
        mt = (rows + BM - 1) / BM, tasks = mt * nt;
    int local = (bid - tileBase % cores + cores) % cores;
    for (int ti = local; ti < tasks; ti += cores) {
      int mi = (ti / nt) * BM, ni = (ti % nt) * BN, rm = rows - mi, rn = N - ni;
      if (rm > BM)
        rm = BM;
      if (rn > BN)
        rn = BN;
      int cn = BN;
      int64_t coff = ((serial % RING) * cores + bid) * (int64_t)BC;
      if ASCEND_IS_AIC {
        if (serial >= RING)
          CrossCoreWaitFlag(FREE_FLAG + serial % RING);
        mm.SetOrgShape(M, NP, KP, KP, BN);
        mm.SetSingleShape(rm, cn, KP);
        mm.SetTensorA(xx[(start + mi) * (int64_t)KP]);
        mm.SetTensorB(ww[e * (int64_t)KP * NP + ni]);
        while (mm.Iterate()) {
          mm.GetTensorC(cc[coff], 0, false);
        }
        CrossCoreSetFlag<2, PIPE_FIX>(READY_FLAG + serial % RING);
      }
      if ASCEND_IS_AIV {
        auto ci = cb.Get<int32_t>();
        auto sc = sb.Get<float>();
        auto z = cb.Get<float>();
        auto t = tb.Get<float>();
        auto u = cb.Get<float>();
        auto o = tb.Get<half>();
        int split = (rm + 1) / 2, vstart = sub * split, vm = rm - vstart;
        if (vm > split)
          vm = split;
        if (vm < 0)
          vm = 0;
        int stride = (rn + 15) / 16 * 16;
        CrossCoreWaitFlag(READY_FLAG + serial % RING);
        int totalVm = vm;
        for (int vr = 0; vr < totalVm; vr += VM) {
          vm = totalVm - vr;
          if (vm > VM)
            vm = VM;
          auto inputReuse = pipe.FetchEventID(HardEvent::V_MTE2);
          SetFlag<HardEvent::V_MTE2>(inputReuse);
          WaitFlag<HardEvent::V_MTE2>(inputReuse);
          DataCopyExtParams cp{(uint16_t)vm, (uint32_t)(rn * 4), (uint32_t)((BN - rn) * 4),
                               (uint32_t)((stride - (rn + 7) / 8 * 8) / 8), 0};
          DataCopyPadExtParams<int32_t> ip{true, 0, 0, 0};
          DataCopyPad(ci, cc[coff + (vstart + vr) * BN], cp, ip);
          DataCopyExtParams sp{1, (uint32_t)(rn * 4), 0, 0, 0};
          DataCopyPadExtParams<float> fp{true, 0, 0, 0};
          DataCopyPad(sc, ss[e * (int64_t)N + ni], sp, fp);
          auto ev = pipe.FetchEventID(HardEvent::MTE2_V);
          SetFlag<HardEvent::MTE2_V>(ev);
          WaitFlag<HardEvent::MTE2_V>(ev);
          if (vr + vm >= totalVm)
            CrossCoreSetFlag<2, PIPE_MTE2>(FREE_FLAG + serial % RING);
          int count = vm * stride;
          Cast(z, ci, RoundMode::CAST_NONE, count);
          PipeBarrier<PIPE_V>();
          for (int c = 0; c < stride; c += 64) {
            uint64_t mask = (stride - c < 64 ? stride - c : 64);
            Mul(z[c], z[c], sc[c], mask, (uint8_t)vm,
                {1, 1, 1, (uint8_t)(stride / 8), (uint8_t)(stride / 8), 0});
          }
                                                                          
                                                                              
          if (outputPending) {
            WaitFlag<HardEvent::MTE3_V>(outputDone);
            outputPending = false;
          }
          PipeBarrier<PIPE_V>();
          GmmDirectVectorCounter(z, t, u, count);
          Cast(o, u, RoundMode::CAST_RINT, count);
          PipeBarrier<PIPE_V>();
          auto ev2 = pipe.FetchEventID(HardEvent::V_MTE3);
          SetFlag<HardEvent::V_MTE3>(ev2);
          WaitFlag<HardEvent::V_MTE3>(ev2);
          DataCopyExtParams op{(uint16_t)vm, (uint32_t)(rn * 2),
                               (uint32_t)((stride - (rn + 15) / 16 * 16) / 16),
                               (uint32_t)((N - rn) * 2), 0};
          DataCopyPad(yy[(start + mi + vstart + vr) * (int64_t)N + ni], o, op);
          SetFlag<HardEvent::MTE3_V>(outputDone);
          outputPending = true;
        }
        if (!totalVm)
          CrossCoreSetFlag<2, PIPE_MTE2>(FREE_FLAG + serial % RING);
      }
      ++serial;
    }
    tileBase += tasks;
    start = end;
  }
  if ASCEND_IS_AIV {
    if (outputPending)
      WaitFlag<HardEvent::MTE3_V>(outputDone);
  }
  if ASCEND_IS_AIC {
    mm.End();
    for (int i = 0; i < (serial < RING ? serial : RING); ++i)
      CrossCoreWaitFlag(FREE_FLAG + (serial - 1 - i) % RING);
  }
}
#include "kernel_operator.h"
#include "lib/broadcast/broadcast.h"
using namespace AscendC;
                                                                                 
                                                             
template <int TK, int TN>
__global__ __vector__ void grouped_matmul_gelu_ktree_brcb(GM_ADDR x, GM_ADDR w, GM_ADDR s,
                                                          GM_ADDR g, GM_ADDR y, int M, int N, int K,
                                                          int E) {
  constexpr int TW = TK * TN;
  TPipe p;
  TBuf<TPosition::VECIN> xb, wb, sb;
  TBuf<TPosition::VECCALC> xhb, whb, wfb, tmpb, ab, pib, zb, tb, ub;
  TBuf<TPosition::VECOUT> ob;
  p.InitBuffer(xb, TK);
  p.InitBuffer(xhb, TK * 2);
  p.InitBuffer(wb, TW);
  p.InitBuffer(whb, TW * 2);
  p.InitBuffer(wfb, TW * 4);
  p.InitBuffer(tmpb, TK * 32);
  p.InitBuffer(sb, TN * 4);
  p.InitBuffer(ab, TN * 4);
  p.InitBuffer(pib, TN * 4);
  p.InitBuffer(zb, TN * 4);
  p.InitBuffer(tb, TN * 4);
  p.InitBuffer(ub, TN * 4);
  p.InitBuffer(ob, TN * 2);
  auto xl = xb.Get<int8_t>();
  auto xh = xhb.Get<half>();
  auto wl = wb.Get<int8_t>();
  auto wh = whb.Get<half>();
  auto wf = wfb.Get<float>();
  auto bx = tmpb.Get<half>();
  auto sl = sb.Get<float>();
  auto acc = ab.Get<int32_t>();
  auto partial = pib.Get<int32_t>();
  auto z = zb.Get<float>();
  auto t = tb.Get<float>();
  auto u = ub.Get<float>();
  auto o = ob.Get<half>();
  GlobalTensor<int8_t> xx, ww;
  GlobalTensor<float> ss;
  GlobalTensor<int64_t> gg;
  GlobalTensor<half> yy;
  xx.SetGlobalBuffer((__gm__ int8_t *)x);
  ww.SetGlobalBuffer((__gm__ int8_t *)w);
  ss.SetGlobalBuffer((__gm__ float *)s);
  gg.SetGlobalBuffer((__gm__ int64_t *)g);
  yy.SetGlobalBuffer((__gm__ half *)y);
  int nt = (N + TN - 1) / TN, tasks = M * nt, cores = GetBlockNum(), bid = GetBlockIdx();
  for (int task = bid; task < tasks; task += cores) {
    int row = task / nt, col = task % nt * TN, rn = N - col;
    if (rn > TN)
      rn = TN;
    int stride = (rn + 31) / 32 * 32;
    int expert = 0;
    if (E >= 16) {
      int lo = 0, hi = E;
      while (lo < hi) {
        int mid = (lo + hi) / 2;
        if (gg.GetValue(mid) <= row)
          lo = mid + 1;
        else
          hi = mid;
      }
      expert = lo;
    } else {
      while (expert < E - 1 && row >= gg.GetValue(expert))
        ++expert;
    }
    if (K > TK) {
      Duplicate(acc, 0, stride);
      PipeBarrier<PIPE_V>();
    }
    for (int kk = 0; kk < K; kk += TK) {
      int rk = K - kk;
      if (rk > TK)
        rk = TK;
      auto eback = p.FetchEventID(HardEvent::V_MTE2);
      SetFlag<HardEvent::V_MTE2>(eback);
      WaitFlag<HardEvent::V_MTE2>(eback);
      DataCopyExtParams xp{1, (uint32_t)rk, 0, 0, 0};
      DataCopyPadExtParams<int8_t> pad{true, 0, 0, 0};
      DataCopyPad(xl, xx[row * (int64_t)K + kk], xp, pad);
      DataCopyExtParams wp{(uint16_t)rk, (uint32_t)rn, (uint32_t)(N - rn), 0, 0};
      DataCopyPad(wl, ww[expert * (int64_t)K * N + kk * (int64_t)N + col], wp, pad);
      auto ev = p.FetchEventID(HardEvent::MTE2_V);
      SetFlag<HardEvent::MTE2_V>(ev);
      WaitFlag<HardEvent::MTE2_V>(ev);
      Duplicate(wf, 0.0f, TK * stride);
      if (rk < TK) {
        Duplicate(xh, static_cast<half>(0), TK);
        Duplicate(wh, static_cast<half>(0), TK * stride);
      }
      PipeBarrier<PIPE_V>();
      Cast(xh, xl, RoundMode::CAST_NONE, rk);
      Cast(wh, wl, RoundMode::CAST_NONE, rk * stride);
      PipeBarrier<PIPE_V>();
      Brcb(bx, xh, TK / 8, {1, 8});
      PipeBarrier<PIPE_V>();
      for (int cc = 0; cc < stride; cc += 64) {
        int nc = stride - cc;
        if (nc > 64)
          nc = 64;
        for (int kr = 0; kr < TK; kr += 255) {
          int rep = TK - kr;
          if (rep > 255)
            rep = 255;
          MulAddDst<float, half>(wf[kr * stride + cc], wh[kr * stride + cc], bx[kr * 16],
                                 (uint64_t)nc, (uint8_t)rep,
                                 {1, 1, 0, (uint8_t)(stride / 8), (uint8_t)(stride / 16), 1});
        }
      }
      PipeBarrier<PIPE_V>();
      SetMaskCount();
      for (int width = TK / 2; width > 0; width /= 2) {
        SetVectorMask<float, MaskMode::COUNTER>(0, width * stride);
        Add<float, false>(wf, wf, wf[width * stride], uint64_t(0), 1, {1, 1, 1, 8, 8, 8});
        PipeBarrier<PIPE_V>();
      }
      SetMaskNorm();
      ResetMask();
      if (K > TK) {
        Cast(partial, wf, RoundMode::CAST_RINT, stride);
        PipeBarrier<PIPE_V>();
        Add(acc, acc, partial, stride);
        PipeBarrier<PIPE_V>();
      }
    }
    auto es = p.FetchEventID(HardEvent::V_MTE2);
    SetFlag<HardEvent::V_MTE2>(es);
    WaitFlag<HardEvent::V_MTE2>(es);
    DataCopyExtParams sp{1, (uint32_t)(rn * 4), 0, 0, 0};
    DataCopyPadExtParams<float> fp{true, 0, 0, 0};
    DataCopyPad(sl, ss[expert * (int64_t)N + col], sp, fp);
    auto ev = p.FetchEventID(HardEvent::MTE2_V);
    SetFlag<HardEvent::MTE2_V>(ev);
    WaitFlag<HardEvent::MTE2_V>(ev);
    if (K > TK) {
      Cast(z, acc, RoundMode::CAST_RINT, stride);
      PipeBarrier<PIPE_V>();
      Mul(z, z, sl, stride);
    } else {
      Mul(z, wf, sl, stride);
    }
    PipeBarrier<PIPE_V>();
    Mul(t, z, z, stride);
    PipeBarrier<PIPE_V>();
    Muls(t, t, 0.044715f, stride);
    PipeBarrier<PIPE_V>();
    Adds(t, t, 1.0f, stride);
    PipeBarrier<PIPE_V>();
    Mul(t, t, z, stride);
    PipeBarrier<PIPE_V>();
    Muls(t, t, -1.5957691216057308f, stride);
    PipeBarrier<PIPE_V>();
    Mins(t, t, 80.0f, stride);
    PipeBarrier<PIPE_V>();
    Maxs(t, t, -80.0f, stride);
    PipeBarrier<PIPE_V>();
    Exp(t, t, stride);
    PipeBarrier<PIPE_V>();
    Adds(t, t, 1.0f, stride);
    PipeBarrier<PIPE_V>();
    Div(u, z, t, stride);
    PipeBarrier<PIPE_V>();
    Cast(o, u, RoundMode::CAST_RINT, stride);
    PipeBarrier<PIPE_V>();
    auto eo = p.FetchEventID(HardEvent::V_MTE3);
    SetFlag<HardEvent::V_MTE3>(eo);
    WaitFlag<HardEvent::V_MTE3>(eo);
    DataCopyExtParams op{1, (uint32_t)(rn * 2), 0, 0, 0};
    DataCopyPad(yy[row * (int64_t)N + col], o, op);
    auto eb = p.FetchEventID(HardEvent::MTE3_V);
    SetFlag<HardEvent::MTE3_V>(eb);
    WaitFlag<HardEvent::MTE3_V>(eb);
  }
}
static void run_ktree_kernel(GM_ADDR x, const TensorGroupInfo &ix, GM_ADDR w,
                             const TensorGroupInfo &iw, GM_ADDR s, const TensorGroupInfo &is,
                             GM_ADDR g, const TensorGroupInfo &ig, GM_ADDR y,
                             const TensorGroupInfo &iy, int64_t availableCoreNum,
                             aclrtStream stream) {
  int M = ix.tensors[0].shape[0], K = ix.tensors[0].shape[1], E = iw.tensors[0].shape[0],
      N = iw.tensors[0].shape[2];
  int tn = K <= 128 ? 128 : 64;
  int tasks = M * ((N + tn - 1) / tn), blocks = (int)availableCoreNum * 2;
  if (blocks > tasks)
    blocks = tasks;
  if (blocks < availableCoreNum)
    blocks = availableCoreNum;
  if (K <= 128)
    grouped_matmul_gelu_ktree_brcb<128, 128>
        <<<blocks, nullptr, stream>>>(x, w, s, g, y, M, N, K, E);
  else
    grouped_matmul_gelu_ktree_brcb<256, 64><<<blocks, nullptr, stream>>>(x, w, s, g, y, M, N, K, E);
}

                                                                                  
                                                                                     
__global__ __vector__ void grouped_matmul_gelu_gemv_n1(GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR g,
                                                       GM_ADDR y, int M, int K, int E) {
  TPipe p;
  TBuf<TPosition::VECIN> xb, wb, sb;
  TBuf<TPosition::VECCALC> xhb, whb, pb, tmpb, partsbuf, ab, zb, tb, ub;
  TBuf<TPosition::VECOUT> ob;
  p.InitBuffer(xb, 8192);
  p.InitBuffer(wb, 8192);
  p.InitBuffer(sb, 32);
  p.InitBuffer(xhb, 16384);
  p.InitBuffer(whb, 16384);
  p.InitBuffer(pb, 32768);
  p.InitBuffer(tmpb, 4096);
  p.InitBuffer(partsbuf, 256);
  p.InitBuffer(ab, 32);
  p.InitBuffer(zb, 32);
  p.InitBuffer(tb, 32);
  p.InitBuffer(ub, 32);
  p.InitBuffer(ob, 32);
  auto xl = xb.Get<int8_t>();
  auto wl = wb.Get<int8_t>();
  auto sl = sb.Get<float>();
  auto xh = xhb.Get<half>();
  auto wh = whb.Get<half>();
  auto products = pb.Get<float>();
  auto tmp = tmpb.Get<float>();
  auto parts = partsbuf.Get<float>();
  auto acc = ab.Get<int32_t>();
  auto z = zb.Get<float>();
  auto t = tb.Get<float>();
  auto u = ub.Get<float>();
  auto o = ob.Get<half>();
  GlobalTensor<int8_t> xx, ww;
  GlobalTensor<float> ss;
  GlobalTensor<int64_t> gg;
  GlobalTensor<half> yy;
  xx.SetGlobalBuffer((__gm__ int8_t *)x);
  ww.SetGlobalBuffer((__gm__ int8_t *)w);
  ss.SetGlobalBuffer((__gm__ float *)s);
  gg.SetGlobalBuffer((__gm__ int64_t *)g);
  yy.SetGlobalBuffer((__gm__ half *)y);
  int cores = GetBlockNum(), paddedK = (K + 63) / 64 * 64, nparts = (K + 1023) / 1024;
  for (int row = GetBlockIdx(); row < M; row += cores) {
    int lo = 0, hi = E;
    while (lo < hi) {
      int mid = (lo + hi) / 2;
      if (gg.GetValue(mid) <= row)
        lo = mid + 1;
      else
        hi = mid;
    }
    int expert = lo;
    auto reuse = p.FetchEventID(HardEvent::V_MTE2);
    SetFlag<HardEvent::V_MTE2>(reuse);
    WaitFlag<HardEvent::V_MTE2>(reuse);
    DataCopyExtParams cp{1, (uint32_t)K, 0, 0, 0};
    DataCopyPadExtParams<int8_t> ip{true, 0, 0, 0};
    DataCopyPad(xl, xx[row * (int64_t)K], cp, ip);
    DataCopyPad(wl, ww[expert * (int64_t)K], cp, ip);
    DataCopyExtParams sp{1, 4, 0, 0, 0};
    DataCopyPadExtParams<float> fp{true, 0, 0, 0};
    DataCopyPad(sl, ss[expert], sp, fp);
    auto loaded = p.FetchEventID(HardEvent::MTE2_V);
    SetFlag<HardEvent::MTE2_V>(loaded);
    WaitFlag<HardEvent::MTE2_V>(loaded);
    Cast(xh, xl, RoundMode::CAST_NONE, K);
    Cast(wh, wl, RoundMode::CAST_NONE, K);
    Duplicate(products, 0.0f, paddedK);
    Duplicate(acc, 0, 8);
    PipeBarrier<PIPE_V>();
    MulAddDst<float, half>(products, xh, wh, K);
    PipeBarrier<PIPE_V>();
    for (int i = 0; i < nparts; ++i) {
      int count = paddedK - i * 1024;
      if (count > 1024)
        count = 1024;
      ReduceSum(parts[i * 8], products[i * 1024], tmp, count);
      PipeBarrier<PIPE_V>();
    }
    auto ready = p.FetchEventID(HardEvent::V_S);
    SetFlag<HardEvent::V_S>(ready);
    WaitFlag<HardEvent::V_S>(ready);
    int32_t sum = 0;
    for (int i = 0; i < nparts; ++i)
      sum += (int32_t)parts.GetValue(i * 8);
    acc.SetValue(0, sum);
    auto scalar = p.FetchEventID(HardEvent::S_V);
    SetFlag<HardEvent::S_V>(scalar);
    WaitFlag<HardEvent::S_V>(scalar);
    Cast(z, acc, RoundMode::CAST_RINT, 8);
    PipeBarrier<PIPE_V>();
    Mul(z, z, sl, 8);
    PipeBarrier<PIPE_V>();
    Mul(t, z, z, 8);
    PipeBarrier<PIPE_V>();
    Muls(t, t, 0.044715f, 8);
    PipeBarrier<PIPE_V>();
    Adds(t, t, 1.0f, 8);
    PipeBarrier<PIPE_V>();
    Mul(t, t, z, 8);
    PipeBarrier<PIPE_V>();
    Muls(t, t, -1.5957691216057308f, 8);
    PipeBarrier<PIPE_V>();
    Mins(t, t, 80.0f, 8);
    PipeBarrier<PIPE_V>();
    Maxs(t, t, -80.0f, 8);
    PipeBarrier<PIPE_V>();
    Exp(t, t, 8);
    PipeBarrier<PIPE_V>();
    Adds(t, t, 1.0f, 8);
    PipeBarrier<PIPE_V>();
    Div(u, z, t, 8);
    PipeBarrier<PIPE_V>();
    Cast(o, u, RoundMode::CAST_RINT, 8);
    PipeBarrier<PIPE_V>();
    auto output = p.FetchEventID(HardEvent::V_MTE3);
    SetFlag<HardEvent::V_MTE3>(output);
    WaitFlag<HardEvent::V_MTE3>(output);
    DataCopyExtParams op{1, 2, 0, 0, 0};
    DataCopyPad(yy[row], o, op);
    auto done = p.FetchEventID(HardEvent::MTE3_V);
    SetFlag<HardEvent::MTE3_V>(done);
    WaitFlag<HardEvent::MTE3_V>(done);
  }
}

                                                                                           
__global__ __vector__ void grouped_matmul_gelu_narrow_gather(GM_ADDR x, GM_ADDR w, GM_ADDR s,
                                                             GM_ADDR g, GM_ADDR y, int M, int N,
                                                             int K, int E) {
  constexpr int TK = 1024, MAXN = 16;
  TPipe p;
  TBuf<TPosition::VECIN> xb, wb, sb;
  TBuf<TPosition::VECCALC> xhb, whb, colb, pb, tmpb, indexb, partb, ab, zb, tb, ub;
  TBuf<TPosition::VECOUT> ob;
  p.InitBuffer(xb, TK);
  p.InitBuffer(wb, TK * MAXN);
  p.InitBuffer(sb, MAXN * 4);
  p.InitBuffer(xhb, TK * 2);
  p.InitBuffer(whb, TK * MAXN * 2);
  p.InitBuffer(colb, TK * 2);
  p.InitBuffer(pb, TK * 4);
  p.InitBuffer(tmpb, TK * 4);
  p.InitBuffer(indexb, TK * 4);
  p.InitBuffer(partb, MAXN * 32);
  p.InitBuffer(ab, MAXN * 4);
  p.InitBuffer(zb, MAXN * 4);
  p.InitBuffer(tb, MAXN * 4);
  p.InitBuffer(ub, MAXN * 4);
  p.InitBuffer(ob, MAXN * 2);
  auto xl = xb.Get<int8_t>();
  auto wl = wb.Get<int8_t>();
  auto sc = sb.Get<float>();
  auto xh = xhb.Get<half>();
  auto wh = whb.Get<half>();
  auto column = colb.Get<half>();
  auto products = pb.Get<float>();
  auto tmp = tmpb.Get<float>();
  auto idx = indexb.Get<int32_t>();
  auto parts = partb.Get<float>();
  auto acc = ab.Get<int32_t>();
  auto z = zb.Get<float>();
  auto t = tb.Get<float>();
  auto u = ub.Get<float>();
  auto o = ob.Get<half>();
  GlobalTensor<int8_t> xx, ww;
  GlobalTensor<float> ss;
  GlobalTensor<int64_t> gg;
  GlobalTensor<half> yy;
  xx.SetGlobalBuffer((__gm__ int8_t *)x);
  ww.SetGlobalBuffer((__gm__ int8_t *)w);
  ss.SetGlobalBuffer((__gm__ float *)s);
  gg.SetGlobalBuffer((__gm__ int64_t *)g);
  yy.SetGlobalBuffer((__gm__ half *)y);
  CreateVecIndex(idx, (int32_t)0, TK);
  PipeBarrier<PIPE_V>();
  Muls(idx, idx, (int32_t)(N * 2), TK);
  PipeBarrier<PIPE_V>();
  int cores = GetBlockNum(), nv = (N + 7) / 8 * 8;
  for (int row = GetBlockIdx(); row < M; row += cores) {
    int lo = 0, hi = E;
    while (lo < hi) {
      int mid = (lo + hi) / 2;
      if (gg.GetValue(mid) <= row)
        lo = mid + 1;
      else
        hi = mid;
    }
    int expert = lo;
    for (int n = 0; n < MAXN; ++n)
      acc.SetValue(n, 0);
    for (int kk = 0; kk < K; kk += TK) {
      int rk = K - kk;
      if (rk > TK)
        rk = TK;
      int pk = (rk + 63) / 64 * 64;
      auto reuse = p.FetchEventID(HardEvent::V_MTE2);
      SetFlag<HardEvent::V_MTE2>(reuse);
      WaitFlag<HardEvent::V_MTE2>(reuse);
      DataCopyExtParams xp{1, (uint32_t)rk, 0, 0, 0}, wp{1, (uint32_t)(rk * N), 0, 0, 0};
      DataCopyPadExtParams<int8_t> ip{true, 0, 0, 0};
      DataCopyPad(xl, xx[row * (int64_t)K + kk], xp, ip);
      DataCopyPad(wl, ww[expert * (int64_t)K * N + kk * (int64_t)N], wp, ip);
      auto loaded = p.FetchEventID(HardEvent::MTE2_V);
      SetFlag<HardEvent::MTE2_V>(loaded);
      WaitFlag<HardEvent::MTE2_V>(loaded);
      Cast(xh, xl, RoundMode::CAST_NONE, rk);
      Cast(wh, wl, RoundMode::CAST_NONE, rk * N);
      PipeBarrier<PIPE_V>();
      for (int n = 0; n < N; ++n) {
        Gather(column, wh, idx.ReinterpretCast<uint32_t>(), (uint32_t)(n * 2), (uint32_t)rk);
        Duplicate(products, 0.0f, pk);
        PipeBarrier<PIPE_V>();
        MulAddDst<float, half>(products, xh, column, rk);
        PipeBarrier<PIPE_V>();
        ReduceSum(parts[n * 8], products, tmp, pk);
        PipeBarrier<PIPE_V>();
      }
      auto scalar = p.FetchEventID(HardEvent::V_S);
      SetFlag<HardEvent::V_S>(scalar);
      WaitFlag<HardEvent::V_S>(scalar);
      for (int n = 0; n < N; ++n)
        acc.SetValue(n, acc.GetValue(n) + (int32_t)parts.GetValue(n * 8));
      auto partsRead = p.FetchEventID(HardEvent::S_V);
      SetFlag<HardEvent::S_V>(partsRead);
      WaitFlag<HardEvent::S_V>(partsRead);
    }
    DataCopyExtParams sp{1, (uint32_t)(N * 4), 0, 0, 0};
    DataCopyPadExtParams<float> fp{true, 0, 0, 0};
    DataCopyPad(sc, ss[expert * (int64_t)N], sp, fp);
    auto scaleReady = p.FetchEventID(HardEvent::MTE2_V);
    SetFlag<HardEvent::MTE2_V>(scaleReady);
    WaitFlag<HardEvent::MTE2_V>(scaleReady);
    auto sumReady = p.FetchEventID(HardEvent::S_V);
    SetFlag<HardEvent::S_V>(sumReady);
    WaitFlag<HardEvent::S_V>(sumReady);
    Cast(z, acc, RoundMode::CAST_RINT, nv);
    PipeBarrier<PIPE_V>();
    Mul(z, z, sc, nv);
    PipeBarrier<PIPE_V>();
    Mul(t, z, z, nv);
    PipeBarrier<PIPE_V>();
    Muls(t, t, 0.044715f, nv);
    PipeBarrier<PIPE_V>();
    Adds(t, t, 1.0f, nv);
    PipeBarrier<PIPE_V>();
    Mul(t, t, z, nv);
    PipeBarrier<PIPE_V>();
    Muls(t, t, -1.5957691216057308f, nv);
    PipeBarrier<PIPE_V>();
    Mins(t, t, 80.0f, nv);
    PipeBarrier<PIPE_V>();
    Maxs(t, t, -80.0f, nv);
    PipeBarrier<PIPE_V>();
    Exp(t, t, nv);
    PipeBarrier<PIPE_V>();
    Adds(t, t, 1.0f, nv);
    PipeBarrier<PIPE_V>();
    Div(u, z, t, nv);
    PipeBarrier<PIPE_V>();
    Cast(o, u, RoundMode::CAST_RINT, nv);
    PipeBarrier<PIPE_V>();
    auto output = p.FetchEventID(HardEvent::V_MTE3);
    SetFlag<HardEvent::V_MTE3>(output);
    WaitFlag<HardEvent::V_MTE3>(output);
    DataCopyExtParams op{1, (uint32_t)(N * 2), 0, 0, 0};
    DataCopyPad(yy[row * (int64_t)N], o, op);
    auto done = p.FetchEventID(HardEvent::MTE3_V);
    SetFlag<HardEvent::MTE3_V>(done);
    WaitFlag<HardEvent::MTE3_V>(done);
  }
}

                                                                        
template <int BM, int BN> class DirectInt8Panel {
  TBuf<TPosition::A1> a1b;
  TBuf<TPosition::B1> b1b;
  TBuf<TPosition::A2> a2b;
  TBuf<TPosition::B2> b2b;
  TBuf<TPosition::CO1> c1b;
  TPipe *pipe;
  static constexpr int CDB = 2;
  int serial = 0;
  TEventID l1Free[2], l0Free, cFree[CDB];

public:
  __aicore__ inline void Init(TPipe &p) {
    pipe = &p;
    p.InitBuffer(a1b, 2 * BM * 256);
    p.InitBuffer(b1b, 2 * 256 * BN);
    p.InitBuffer(a2b, BM * 256);
    p.InitBuffer(b2b, 256 * BN);
    p.InitBuffer(c1b, CDB * BM * BN * 4);
    for (int i = 0; i < 2; ++i)
      l1Free[i] = p.AllocEventID<HardEvent::MTE1_MTE2>();
    l0Free = p.AllocEventID<HardEvent::M_MTE1>();
    for (int i = 0; i < CDB; ++i)
      cFree[i] = p.AllocEventID<HardEvent::FIX_M>();
  }
  __aicore__ inline void Compute(GlobalTensor<int8_t> a, GlobalTensor<int8_t> b,
                                 GlobalTensor<int32_t> c, int K, int N, int rm, int rn) {
    int KP = (K + 31) / 32 * 32;
    auto a1 = a1b.template Get<int8_t>()[serial % 2 * BM * 256];
    auto b1 = b1b.template Get<int8_t>()[serial % 2 * 256 * BN];
    auto a2 = a2b.template Get<int8_t>();
    auto b2 = b2b.template Get<int8_t>();
    auto c1 = c1b.template Get<int32_t>()[serial % CDB * BM * BN];
    Nd2NzParams ap;
    ap.ndNum = 1;
    ap.nValue = rm;
    ap.dValue = K;
    ap.srcDValue = K;
    ap.srcNdMatrixStride = 0;
    ap.dstNzC0Stride = BM;
    ap.dstNzNStride = 1;
    ap.dstNzMatrixStride = 0;
    Nd2NzParams bp;
    bp.ndNum = 1;
    bp.nValue = K;
    bp.dValue = rn;
    bp.srcDValue = N;
    bp.srcNdMatrixStride = 0;
    bp.dstNzC0Stride = KP;
    bp.dstNzNStride = 1;
    bp.dstNzMatrixStride = 0;
    if (serial >= 2)
      WaitFlag<HardEvent::MTE1_MTE2>(l1Free[serial % 2]);
    if (KP != K) {
      InitConstValueParams<uint16_t> zero;
      zero.repeatTimes = (rn + 31) / 32;
      zero.blockNum = KP - K;
      zero.dstGap = K;
      zero.initValue = 0;
      InitConstValue(b1.template ReinterpretCast<uint16_t>()[K * 16], zero);
      PipeBarrier<PIPE_MTE2>();
    }
    DataCopy(a1, a, ap);
    DataCopy(b1, b, bp);
    auto in = pipe->FetchEventID(HardEvent::MTE2_MTE1);
    SetFlag<HardEvent::MTE2_MTE1>(in);
    WaitFlag<HardEvent::MTE2_MTE1>(in);
    if (serial)
      WaitFlag<HardEvent::M_MTE1>(l0Free);
    LoadData2DParams al;
    al.startIndex = 0;
    al.repeatTimes = KP / 32;
    al.srcStride = BM / 16;
    al.dstGap = 0;
    al.ifTranspose = false;
    for (int i = 0; i < (rm + 15) / 16; ++i)
      LoadData(a2[i * KP * 16], a1[i * 512], al);
    LoadData2dTransposeParams bl;
    bl.startIndex = 0;
    bl.repeatTimes = (rn + 31) / 32;
    bl.srcStride = KP / 32;
    bl.dstGap = 1;
    bl.dstFracGap = 0;
    int na = (rn + 15) / 16 * 16;
    for (int i = 0; i < KP / 32; ++i)
      LoadDataWithTranspose(b2[i * na * 32], b1[i * 1024], bl);
    SetFlag<HardEvent::MTE1_MTE2>(l1Free[serial % 2]);
    auto loaded = pipe->FetchEventID(HardEvent::MTE1_M);
    SetFlag<HardEvent::MTE1_M>(loaded);
    WaitFlag<HardEvent::MTE1_M>(loaded);
    MmadParams mp;
    mp.m = (rm + 15) / 16 * 16;
    mp.n = na;
    mp.k = KP;
    mp.cmatrixInitVal = true;
    if (serial >= CDB)
      WaitFlag<HardEvent::FIX_M>(cFree[serial % CDB]);
    Mmad(c1, a2, b2, mp);
    SetFlag<HardEvent::M_MTE1>(l0Free);
    auto done = pipe->FetchEventID(HardEvent::M_FIX);
    SetFlag<HardEvent::M_FIX>(done);
    WaitFlag<HardEvent::M_FIX>(done);
    FixpipeParamsV220 fp;
    fp.mSize = rm;
    fp.nSize = rn;
    fp.srcStride = (rm + 15) / 16 * 16;
    fp.dstStride = BN;
    fp.quantPre = QuantMode_t::NoQuant;
    fp.deqScalar = 0;
    Fixpipe<int32_t, int32_t, CFG_ROW_MAJOR>(c, c1, fp);
    SetFlag<HardEvent::FIX_M>(cFree[serial % CDB]);
    ++serial;
  }
  __aicore__ inline void End() {
    if (serial) {
      for (int i = 0; i < 2 && i < serial; ++i)
        WaitFlag<HardEvent::MTE1_MTE2>(l1Free[i]);
      WaitFlag<HardEvent::M_MTE1>(l0Free);
      for (int i = 0; i < CDB && i < serial; ++i)
        WaitFlag<HardEvent::FIX_M>(cFree[i]);
    }
    for (int i = 0; i < 2; ++i)
      pipe->ReleaseEventID<HardEvent::MTE1_MTE2>(l1Free[i]);
    pipe->ReleaseEventID<HardEvent::M_MTE1>(l0Free);
    for (int i = 0; i < CDB; ++i)
      pipe->ReleaseEventID<HardEvent::FIX_M>(cFree[i]);
    PipeBarrier<PIPE_ALL>();
  }
};
template <int BM, int BN>
__global__ __mix__(1, 2) void grouped_matmul_gelu_direct_stream(GM_ADDR x, GM_ADDR w, GM_ADDR s,
                                                                GM_ADDR g, GM_ADDR y, GM_ADDR work,
                                                                int M, int N, int K, int E,
                                                                int cores) {
                                                                   
                                                                         
  constexpr int RING = 4;
  constexpr uint16_t READY_FLAG = 8, FREE_FLAG = 4;
  constexpr int BC = BM * BN;
  TPipe pipe;
  DirectInt8Panel<BM, BN> mm;
  TBuf<TPosition::VECIN> cb, sb;
  TBuf<TPosition::VECCALC> zb, tb, ub;
  TBuf<TPosition::VECOUT> ob;
  if ASCEND_IS_AIC {
    mm.Init(pipe);
  }
  if ASCEND_IS_AIV {
    pipe.InitBuffer(cb, 32 * BN * 4);
    pipe.InitBuffer(sb, BN * 4 + 256);
    if (BN == 256)
      pipe.InitBuffer(zb, 32 * BN * 4 + 256);
    pipe.InitBuffer(tb, 32 * BN * 4 + 256);
    if (BN == 256)
      pipe.InitBuffer(ub, 32 * BN * 4 + 256);
    pipe.InitBuffer(ob, 32 * BN * 2);
  }
  GlobalTensor<int8_t> xx, ww;
  GlobalTensor<float> ss;
  GlobalTensor<int64_t> gg;
  GlobalTensor<half> yy;
  GlobalTensor<int32_t> cc;
  xx.SetGlobalBuffer((__gm__ int8_t *)x);
  ww.SetGlobalBuffer((__gm__ int8_t *)w);
  ss.SetGlobalBuffer((__gm__ float *)s);
  gg.SetGlobalBuffer((__gm__ int64_t *)g);
  yy.SetGlobalBuffer((__gm__ half *)y);
  cc.SetGlobalBuffer((__gm__ int32_t *)work);
  int bid = GetBlockIdx(), sub = 0;
  if ASCEND_IS_AIV {
    bid = GetBlockIdx() / 2;
    sub = GetSubBlockIdx();
  }
  static_assert(BN == 256, "Early input release requires the disjoint short-K UB layout");
  TEventID outputDone = 0, inputConsumed = 0;
  bool outputPending = false, inputPending = false;
  if ASCEND_IS_AIV {
    outputDone = pipe.AllocEventID<HardEvent::MTE3_V>();
    inputConsumed = pipe.AllocEventID<HardEvent::V_MTE2>();
  }

  int tileBase = 0, start = 0, serial = 0;
  for (int e = 0; e < E; ++e) {
    int end = (int)gg.GetValue(e), rows = end - start, nt = (N + BN - 1) / BN,
        mt = (rows + BM - 1) / BM, tasks = mt * nt;
    int local = (bid - tileBase % cores + cores) % cores;
    for (int ti = local; ti < tasks; ti += cores) {
      int mi = (ti / nt) * BM, ni = (ti % nt) * BN, rm = rows - mi, rn = N - ni;
      if (rm > BM)
        rm = BM;
      if (rn > BN)
        rn = BN;
      int64_t coff = ((serial % RING) * cores + bid) * (int64_t)BC;
      if ASCEND_IS_AIC {
        if (serial >= RING)
          CrossCoreWaitFlag(FREE_FLAG + serial % RING);
        mm.Compute(xx[(start + mi) * (int64_t)K], ww[e * (int64_t)K * N + ni], cc[coff], K, N, rm,
                   rn);
        CrossCoreSetFlag<2, PIPE_FIX>(READY_FLAG + serial % RING);
      }
      if ASCEND_IS_AIV {
        auto ci = cb.Get<int32_t>();
        auto sc = sb.Get<float>()[BN == 512 ? 64 : 0];
        auto z = BN == 512 ? cb.Get<float>() : zb.Get<float>();
        auto t = tb.Get<float>();
        auto u = BN == 512 ? cb.Get<float>() : ub.Get<float>();
        auto o = ob.Get<half>();
        int split = (rm + 1) / 2, vstart = sub * split, vm = rm - vstart;
        if (vm > split)
          vm = split;
        if (vm < 0)
          vm = 0;
        int stride = (rn + 15) / 16 * 16;
        CrossCoreWaitFlag(READY_FLAG + serial % RING);
        int totalVm = vm;
        for (int vr = 0; vr < totalVm; vr += 32) {
          vm = totalVm - vr;
          if (vm > 32)
            vm = 32;
          if (inputPending) {
            WaitFlag<HardEvent::V_MTE2>(inputConsumed);
            inputPending = false;
          }
          DataCopyExtParams cp{(uint16_t)vm, (uint32_t)(rn * 4), (uint32_t)((BN - rn) * 4),
                               (uint32_t)((stride - (rn + 7) / 8 * 8) / 8), 0};
          DataCopyPadExtParams<int32_t> ip{true, 0, 0, 0};
          DataCopyPad(ci, cc[coff + (vstart + vr) * BN], cp, ip);
          DataCopyExtParams sp{1, (uint32_t)(rn * 4), 0, 0, 0};
          DataCopyPadExtParams<float> fp{true, 0, 0, 0};
          DataCopyPad(sc, ss[e * (int64_t)N + ni], sp, fp);
          auto ev = pipe.FetchEventID(HardEvent::MTE2_V);
          SetFlag<HardEvent::MTE2_V>(ev);
          WaitFlag<HardEvent::MTE2_V>(ev);
          if (vr + vm >= totalVm)
            CrossCoreSetFlag<2, PIPE_MTE2>(FREE_FLAG + serial % RING);
          int count = vm * stride;
          Cast(z, ci, RoundMode::CAST_NONE, count);
          PipeBarrier<PIPE_V>();
          for (int c = 0; c < stride; c += 64) {
            uint64_t mask = (stride - c < 64 ? stride - c : 64);
            Mul(z[c], z[c], sc[c], mask, (uint8_t)vm,
                {1, 1, 1, (uint8_t)(stride / 8), (uint8_t)(stride / 8), 0});
          }
                                                                               
                                                                            
                                                                           
          SetFlag<HardEvent::V_MTE2>(inputConsumed);
          inputPending = true;
          PipeBarrier<PIPE_V>();
          GmmDirectVectorCounter(z, t, u, count);
                                                                                  
                                                                                
                                                                              
          if (outputPending) {
            WaitFlag<HardEvent::MTE3_V>(outputDone);
            outputPending = false;
          }
          Cast(o, u, RoundMode::CAST_RINT, count);
          PipeBarrier<PIPE_V>();
          auto ev2 = pipe.FetchEventID(HardEvent::V_MTE3);
          SetFlag<HardEvent::V_MTE3>(ev2);
          WaitFlag<HardEvent::V_MTE3>(ev2);
          DataCopyExtParams op{(uint16_t)vm, (uint32_t)(rn * 2),
                               (uint32_t)((stride - (rn + 15) / 16 * 16) / 16),
                               (uint32_t)((N - rn) * 2), 0};
          DataCopyPad(yy[(start + mi + vstart + vr) * (int64_t)N + ni], o, op);
          SetFlag<HardEvent::MTE3_V>(outputDone);
          outputPending = true;
        }
        if (!totalVm)
          CrossCoreSetFlag<2, PIPE_MTE2>(FREE_FLAG + serial % RING);
      }
      ++serial;
    }
    tileBase += tasks;
    start = end;
  }
  if ASCEND_IS_AIV {
    if (inputPending)
      WaitFlag<HardEvent::V_MTE2>(inputConsumed);
    if (outputPending)
      WaitFlag<HardEvent::MTE3_V>(outputDone);
    pipe.ReleaseEventID<HardEvent::V_MTE2>(inputConsumed);
    pipe.ReleaseEventID<HardEvent::MTE3_V>(outputDone);
  }
  if ASCEND_IS_AIC {
    mm.End();
    for (int i = 0; i < (serial < RING ? serial : RING); ++i)
      CrossCoreWaitFlag(FREE_FLAG + (serial - 1 - i) % RING);
  }
}
template <int BM, int BN>
__global__ __mix__(1, 2) void grouped_matmul_gelu_direct_rowgrid(GM_ADDR x, GM_ADDR w, GM_ADDR s,
                                                                 GM_ADDR g, GM_ADDR y, GM_ADDR work,
                                                                 int M, int N, int K, int E,
                                                                 int cores) {
                                                                   
                                                                         
  constexpr int RING = 4;
  constexpr uint16_t READY_FLAG = 8, FREE_FLAG = 4;
  constexpr int BC = BM * BN;
  TPipe pipe;
  DirectInt8Panel<BM, BN> mm;
  TBuf<TPosition::VECIN> cb, sb;
  TBuf<TPosition::VECCALC> zb, tb, ub;
  TBuf<TPosition::VECOUT> ob;
  if ASCEND_IS_AIC {
    mm.Init(pipe);
  }
  if ASCEND_IS_AIV {
    pipe.InitBuffer(cb, 32 * BN * 4);
    pipe.InitBuffer(sb, BN * 4 + 256);
    if (BN == 256)
      pipe.InitBuffer(zb, 32 * BN * 4 + 256);
    pipe.InitBuffer(tb, 32 * BN * 4 + 256);
    if (BN == 256)
      pipe.InitBuffer(ub, 32 * BN * 4 + 256);
    pipe.InitBuffer(ob, 32 * BN * 2);
  }
  GlobalTensor<int8_t> xx, ww;
  GlobalTensor<float> ss;
  GlobalTensor<int64_t> gg;
  GlobalTensor<half> yy;
  GlobalTensor<int32_t> cc;
  xx.SetGlobalBuffer((__gm__ int8_t *)x);
  ww.SetGlobalBuffer((__gm__ int8_t *)w);
  ss.SetGlobalBuffer((__gm__ float *)s);
  gg.SetGlobalBuffer((__gm__ int64_t *)g);
  yy.SetGlobalBuffer((__gm__ half *)y);
  cc.SetGlobalBuffer((__gm__ int32_t *)work);
  int bid = GetBlockIdx(), sub = 0;
  if ASCEND_IS_AIV {
    bid = GetBlockIdx() / 2;
    sub = GetSubBlockIdx();
  }
  static_assert(BN == 256, "Early input release requires the disjoint short-K UB layout");
  TEventID outputDone = 0, inputConsumed = 0;
  bool outputPending = false, inputPending = false;
  if ASCEND_IS_AIV {
    outputDone = pipe.AllocEventID<HardEvent::MTE3_V>();
    inputConsumed = pipe.AllocEventID<HardEvent::V_MTE2>();
  }

  int serial = 0, nt = (N + BN - 1) / BN, mt = (M + BM - 1) / BM;
  for (int task = bid; task < mt * nt; task += cores) {
    int row = (task / nt) * BM, rowEnd = row + BM, ni = (task % nt) * BN;
    if (rowEnd > M)
      rowEnd = M;
                                                                                   
                                                                   
    int e = row * E / M, predictedEnd = (int)gg.GetValue(e),
        predictedBegin = e ? (int)gg.GetValue(e - 1) : 0;
    if (row < predictedBegin || row >= predictedEnd) {
      int lo = row >= predictedEnd ? e + 1 : 0, hi = row < predictedBegin ? e : E;
      while (lo < hi) {
        int mid = (lo + hi) / 2;
        if ((int)gg.GetValue(mid) <= row)
          lo = mid + 1;
        else
          hi = mid;
      }
      e = lo;
    }
    while (row < rowEnd && e < E) {
      int groupEnd = (int)gg.GetValue(e);
      if (groupEnd <= row) {
        ++e;
        continue;
      }
      int start = row, mi = 0, rm = (groupEnd < rowEnd ? groupEnd : rowEnd) - row, rn = N - ni;
      if (rn > BN)
        rn = BN;
      int64_t coff = ((serial % RING) * cores + bid) * (int64_t)BC;
      if ASCEND_IS_AIC {
        if (serial >= RING)
          CrossCoreWaitFlag(FREE_FLAG + serial % RING);
        mm.Compute(xx[(start + mi) * (int64_t)K], ww[e * (int64_t)K * N + ni], cc[coff], K, N, rm,
                   rn);
        CrossCoreSetFlag<2, PIPE_FIX>(READY_FLAG + serial % RING);
      }
      if ASCEND_IS_AIV {
        auto ci = cb.Get<int32_t>();
        auto sc = sb.Get<float>()[BN == 512 ? 64 : 0];
        auto z = BN == 512 ? cb.Get<float>() : zb.Get<float>();
        auto t = tb.Get<float>();
        auto u = BN == 512 ? cb.Get<float>() : ub.Get<float>();
        auto o = ob.Get<half>();
        int split = (rm + 1) / 2, vstart = sub * split, vm = rm - vstart;
        if (vm > split)
          vm = split;
        if (vm < 0)
          vm = 0;
        int stride = (rn + 15) / 16 * 16;
        CrossCoreWaitFlag(READY_FLAG + serial % RING);
        int totalVm = vm;
        for (int vr = 0; vr < totalVm; vr += 32) {
          vm = totalVm - vr;
          if (vm > 32)
            vm = 32;
          if (inputPending) {
            WaitFlag<HardEvent::V_MTE2>(inputConsumed);
            inputPending = false;
          }
          DataCopyExtParams cp{(uint16_t)vm, (uint32_t)(rn * 4), (uint32_t)((BN - rn) * 4),
                               (uint32_t)((stride - (rn + 7) / 8 * 8) / 8), 0};
          DataCopyPadExtParams<int32_t> ip{true, 0, 0, 0};
          DataCopyPad(ci, cc[coff + (vstart + vr) * BN], cp, ip);
          DataCopyExtParams sp{1, (uint32_t)(rn * 4), 0, 0, 0};
          DataCopyPadExtParams<float> fp{true, 0, 0, 0};
          DataCopyPad(sc, ss[e * (int64_t)N + ni], sp, fp);
          auto ev = pipe.FetchEventID(HardEvent::MTE2_V);
          SetFlag<HardEvent::MTE2_V>(ev);
          WaitFlag<HardEvent::MTE2_V>(ev);
          if (vr + vm >= totalVm)
            CrossCoreSetFlag<2, PIPE_MTE2>(FREE_FLAG + serial % RING);
          int count = vm * stride;
          Cast(z, ci, RoundMode::CAST_NONE, count);
          PipeBarrier<PIPE_V>();
          for (int c = 0; c < stride; c += 64) {
            uint64_t mask = (stride - c < 64 ? stride - c : 64);
            Mul(z[c], z[c], sc[c], mask, (uint8_t)vm,
                {1, 1, 1, (uint8_t)(stride / 8), (uint8_t)(stride / 8), 0});
          }
                                                                               
                                                                            
                                                                           
          SetFlag<HardEvent::V_MTE2>(inputConsumed);
          inputPending = true;
          PipeBarrier<PIPE_V>();
          GmmDirectVectorCounter(z, t, u, count);
                                                                                  
                                                                                
                                                                              
          if (outputPending) {
            WaitFlag<HardEvent::MTE3_V>(outputDone);
            outputPending = false;
          }
          Cast(o, u, RoundMode::CAST_RINT, count);
          PipeBarrier<PIPE_V>();
          auto ev2 = pipe.FetchEventID(HardEvent::V_MTE3);
          SetFlag<HardEvent::V_MTE3>(ev2);
          WaitFlag<HardEvent::V_MTE3>(ev2);
          DataCopyExtParams op{(uint16_t)vm, (uint32_t)(rn * 2),
                               (uint32_t)((stride - (rn + 15) / 16 * 16) / 16),
                               (uint32_t)((N - rn) * 2), 0};
          DataCopyPad(yy[(start + mi + vstart + vr) * (int64_t)N + ni], o, op);
          SetFlag<HardEvent::MTE3_V>(outputDone);
          outputPending = true;
        }
        if (!totalVm)
          CrossCoreSetFlag<2, PIPE_MTE2>(FREE_FLAG + serial % RING);
      }
      ++serial;
      row += rm;
      if (row >= groupEnd)
        ++e;
    }
  }
  if ASCEND_IS_AIV {
    if (inputPending)
      WaitFlag<HardEvent::V_MTE2>(inputConsumed);
    if (outputPending)
      WaitFlag<HardEvent::MTE3_V>(outputDone);
    pipe.ReleaseEventID<HardEvent::V_MTE2>(inputConsumed);
    pipe.ReleaseEventID<HardEvent::MTE3_V>(outputDone);
  }
  if ASCEND_IS_AIC {
    mm.End();
    for (int i = 0; i < (serial < RING ? serial : RING); ++i)
      CrossCoreWaitFlag(FREE_FLAG + (serial - 1 - i) % RING);
  }
}

                                                                                     
__global__ __mix__(1, 2) void grouped_matmul_gelu_occupancy_splitk(
    GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR g, GM_ADDR y, GM_ADDR work, int M, int N, int K, int E,
    int NP, int chunks, int chunkK, int cores, TCubeTiling td) {
  constexpr int BM = 128, BN = 256, VM = 16;
  TPipe pipe;
  matmul::MatmulImpl<AT, BType, CT, BIAS, CFG_MDL> mm;
  TBuf<TPosition::VECIN> cb, sb;
  TBuf<TPosition::VECCALC> ab, zb, tb, ub;
  TBuf<TPosition::VECOUT> ob;
  if ASCEND_IS_AIC {
    mm.SetSubBlockIdx(0);
    mm.Init(&td, &pipe);
    mm.SetOrgShape(M, N, K, K, NP);
  }
  if ASCEND_IS_AIV {
    pipe.InitBuffer(cb, VM * BN * 4);
    pipe.InitBuffer(sb, BN * 4);
    pipe.InitBuffer(ab, VM * BN * 4);
    pipe.InitBuffer(zb, VM * BN * 4);
    pipe.InitBuffer(tb, VM * BN * 4);
    pipe.InitBuffer(ub, VM * BN * 4);
    pipe.InitBuffer(ob, VM * BN * 2);
  }
  GlobalTensor<int8_t> xx, ww;
  GlobalTensor<float> ss;
  GlobalTensor<int64_t> gg;
  GlobalTensor<half> yy;
  GlobalTensor<int32_t> cc;
  xx.SetGlobalBuffer((__gm__ int8_t *)x);
  ww.SetGlobalBuffer((__gm__ int8_t *)w);
  ss.SetGlobalBuffer((__gm__ float *)s);
  gg.SetGlobalBuffer((__gm__ int64_t *)g);
  yy.SetGlobalBuffer((__gm__ half *)y);
  cc.SetGlobalBuffer((__gm__ int32_t *)work);
  if ASCEND_IS_AIC {
    int base = 0, start = 0, nt = (N + BN - 1) / BN, bid = GetBlockIdx();
    for (int e = 0; e < E; ++e) {
      int end = (int)gg.GetValue(e), rows = end - start, mt = (rows + BM - 1) / BM,
          tasks = mt * nt * chunks;
      int local = (bid - base % cores + cores) % cores;
      for (int task = local; task < tasks; task += cores) {
        int ki = task % chunks, tile = task / chunks, mi = tile / nt * BM, ni = tile % nt * BN;
        int rm = rows - mi;
        if (rm > BM)
          rm = BM;
        int rn = N - ni;
        if (rn > BN)
          rn = BN;
        int kk = ki * chunkK, rk = K - kk;
        if (rk > chunkK)
          rk = chunkK;
        mm.SetSingleShape(rm, rn, rk);
        mm.SetTensorA(xx[(start + mi) * (int64_t)K + kk]);
        mm.SetTensorB(ww[e * (int64_t)K * N + kk * (int64_t)N + ni]);
        int64_t offset = ((int64_t)ki * M + start + mi) * NP + ni;
        while (mm.Iterate()) {
          mm.GetTensorC(cc[offset], 0, false);
        }
      }
      base += tasks;
      start = end;
    }
    mm.End();
    auto committed = pipe.FetchEventID(HardEvent::FIX_MTE2);
    SetFlag<HardEvent::FIX_MTE2>(committed);
    WaitFlag<HardEvent::FIX_MTE2>(committed);
  }
  SyncAll<false>();
  if ASCEND_IS_AIV {
    auto part = cb.Get<int32_t>();
    auto scale = sb.Get<float>();
    auto acc = ab.Get<int32_t>();
    auto z = zb.Get<float>();
    auto t = tb.Get<float>();
    auto u = ub.Get<float>();
    auto o = ob.Get<half>();
    int nt = (N + BN - 1) / BN, vcores = GetBlockNum() * 2, vid = GetBlockIdx(), base = 0,
        start = 0;
    for (int e = 0; e < E; ++e) {
      int end = (int)gg.GetValue(e), rows = end - start, tiles = (rows + VM - 1) / VM * nt;
      int first = (vid - base % vcores + vcores) % vcores;
      for (int task = first; task < tiles; task += vcores) {
        int mi = task / nt * VM, col = task % nt * BN, vm = rows - mi, rn = N - col;
        if (vm > VM)
          vm = VM;
        if (rn > BN)
          rn = BN;
        int stride = (rn + 15) / 16 * 16, count = vm * stride;
        Duplicate(acc, 0, count);
        PipeBarrier<PIPE_V>();
        for (int ki = 0; ki < chunks; ++ki) {
          auto reuse = pipe.FetchEventID(HardEvent::V_MTE2);
          SetFlag<HardEvent::V_MTE2>(reuse);
          WaitFlag<HardEvent::V_MTE2>(reuse);
          DataCopyExtParams cp{(uint16_t)vm, (uint32_t)(rn * 4), (uint32_t)((NP - rn) * 4),
                               (uint32_t)((stride - (rn + 7) / 8 * 8) / 8), 0};
          DataCopyPadExtParams<int32_t> ip{true, 0, 0, 0};
          DataCopyPad(part, cc[((int64_t)ki * M + start + mi) * NP + col], cp, ip);
          auto ready = pipe.FetchEventID(HardEvent::MTE2_V);
          SetFlag<HardEvent::MTE2_V>(ready);
          WaitFlag<HardEvent::MTE2_V>(ready);
          Add(acc, acc, part, count);
          PipeBarrier<PIPE_V>();
        }
        DataCopyExtParams sp{1, (uint32_t)(rn * 4), 0, 0, 0};
        DataCopyPadExtParams<float> fp{true, 0, 0, 0};
        DataCopyPad(scale, ss[e * (int64_t)N + col], sp, fp);
        auto scaleReady = pipe.FetchEventID(HardEvent::MTE2_V);
        SetFlag<HardEvent::MTE2_V>(scaleReady);
        WaitFlag<HardEvent::MTE2_V>(scaleReady);
        Cast(z, acc, RoundMode::CAST_NONE, count);
        PipeBarrier<PIPE_V>();
        for (int c = 0; c < stride; c += 64) {
          uint64_t mask = (stride - c < 64 ? stride - c : 64);
          Mul(z[c], z[c], scale[c], mask, (uint8_t)vm,
              {1, 1, 1, (uint8_t)(stride / 8), (uint8_t)(stride / 8), 0});
        }
        PipeBarrier<PIPE_V>();
        Mul(t, z, z, count);
        PipeBarrier<PIPE_V>();
        Muls(t, t, 0.044715f, count);
        PipeBarrier<PIPE_V>();
        Adds(t, t, 1.0f, count);
        PipeBarrier<PIPE_V>();
        Mul(t, t, z, count);
        PipeBarrier<PIPE_V>();
        Muls(t, t, -1.5957691216057308f, count);
        PipeBarrier<PIPE_V>();
        Mins(t, t, 80.0f, count);
        PipeBarrier<PIPE_V>();
        Maxs(t, t, -80.0f, count);
        PipeBarrier<PIPE_V>();
        Exp(t, t, count);
        PipeBarrier<PIPE_V>();
        Adds(t, t, 1.0f, count);
        PipeBarrier<PIPE_V>();
        Div(u, z, t, count);
        PipeBarrier<PIPE_V>();
        Cast(o, u, RoundMode::CAST_RINT, count);
        PipeBarrier<PIPE_V>();
        auto output = pipe.FetchEventID(HardEvent::V_MTE3);
        SetFlag<HardEvent::V_MTE3>(output);
        WaitFlag<HardEvent::V_MTE3>(output);
        DataCopyExtParams op{(uint16_t)vm, (uint32_t)(rn * 2), 0, (uint32_t)((N - rn) * 2), 0};
        DataCopyPad(yy[(start + mi) * (int64_t)N + col], o, op);
        auto done = pipe.FetchEventID(HardEvent::MTE3_V);
        SetFlag<HardEvent::MTE3_V>(done);
        WaitFlag<HardEvent::MTE3_V>(done);
      }
      base += tiles;
      start = end;
    }
  }
}

static void run_occupancy_splitk_kernel(GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR g, GM_ADDR y,
                                        int M, int N, int K, int E, int cores, int targetParts,
                                        aclrtStream stream) {
  int chunkK = ((K + targetParts - 1) / targetParts + 31) / 32 * 32,
      chunks = (K + chunkK - 1) / chunkK, NP = (N + 15) / 16 * 16;
  auto plat = platform_ascendc::PlatformAscendCManager::GetInstance();
  matmul_tiling::MatmulApiTiling tiler(*plat);
  tiler.SetAType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
                 matmul_tiling::DataType::DT_INT8);
  tiler.SetBType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
                 matmul_tiling::DataType::DT_INT8);
  tiler.SetCType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
                 matmul_tiling::DataType::DT_INT32);
  tiler.SetShape(128, 256, chunkK);
  tiler.SetOrgShape(M, N, K);
  tiler.SetFixSplit(128, 256, 128);
  tiler.SetBias(false);
  tiler.SetBufferSpace(-1, -1, -1);
  TCubeTiling td;
  tiler.GetTiling(td);
  td.stepKa = 4;
  td.stepKb = 4;
  td.depthA1 = 8;
  td.depthB1 = 8;
  td.shareL1Size = 128 * td.baseK * 8 + 256 * td.baseK * 8;
  void *work = nullptr;
  aclrtMalloc(&work, (uint64_t)chunks * M * NP * 4, ACL_MEM_MALLOC_HUGE_FIRST);
  grouped_matmul_gelu_occupancy_splitk<<<cores, nullptr, stream>>>(
      x, w, s, g, y, (GM_ADDR)work, M, N, K, E, NP, chunks, chunkK, cores, td);
  aclrtSynchronizeStream(stream);
  aclrtFree(work);
}

                                                                             
                                                                               
template <int BM, int BN, int KC> class DirectInt8PanelRes {
  TBuf<TPosition::A1> a1b;
  TBuf<TPosition::B1> b1b;
  TBuf<TPosition::A2> a2b;
  TBuf<TPosition::B2> b2b;
  TBuf<TPosition::CO1> c1b;
  TPipe *pipe;
  int serial = 0, kidx = 0;
  TEventID l1Free[2], bReady[2], l0Free[2], cFree;

public:
  __aicore__ inline void Init(TPipe &p) {
    pipe = &p;
    SetMMRowMajor();
    p.InitBuffer(a1b, BM * 2048);
    p.InitBuffer(b1b, 2 * KC * BN);
    p.InitBuffer(a2b, 2 * BM * KC);
    p.InitBuffer(b2b, 2 * KC * BN);
    p.InitBuffer(c1b, BM * BN * 4);
    for (int i = 0; i < 2; ++i) {
      l1Free[i] = p.AllocEventID<HardEvent::MTE1_MTE2>();
      bReady[i] = p.AllocEventID<HardEvent::MTE2_MTE1>();
    }
    for (int i = 0; i < 2; ++i)
      l0Free[i] = p.AllocEventID<HardEvent::M_MTE1>();
    cFree = p.AllocEventID<HardEvent::FIX_M>();
  }
  __aicore__ inline void LoadA(GlobalTensor<int8_t> a, int K, int rm) {
    auto a1 = a1b.template Get<int8_t>();
    Nd2NzParams ap;
    ap.ndNum = 1;
    ap.nValue = rm;
    ap.dValue = K;
    ap.srcDValue = K;
    ap.srcNdMatrixStride = 0;
    ap.dstNzC0Stride = BM;
    ap.dstNzNStride = 1;
    ap.dstNzMatrixStride = 0;
    auto aConsumed = pipe->FetchEventID(HardEvent::MTE1_MTE2);
    SetFlag<HardEvent::MTE1_MTE2>(aConsumed);
    WaitFlag<HardEvent::MTE1_MTE2>(aConsumed);
    if (rm % 16) {
      InitConstValueParams<int8_t> zero;
      zero.repeatTimes = 1;
      zero.blockNum = BM * K / 32;
      zero.dstGap = 0;
      zero.initValue = 0;
      InitConstValue(a1, zero);
      PipeBarrier<PIPE_MTE2>();
    }
    DataCopy(a1, a, ap);
    auto aReady = pipe->FetchEventID(HardEvent::MTE2_MTE1);
    SetFlag<HardEvent::MTE2_MTE1>(aReady);
    WaitFlag<HardEvent::MTE2_MTE1>(aReady);
  }
  __aicore__ inline void Tile(GlobalTensor<int8_t> b, GlobalTensor<int32_t> c, int K, int N, int rm,
                              int rn) {
    auto a1 = a1b.template Get<int8_t>();
    auto c1 = c1b.template Get<int32_t>();
    int na = (rn + 15) / 16 * 16;
    int rotation = ((GetBlockIdx() * 3) % (K / KC)) * KC;
    for (int done = 0; done < K; done += KC) {
      int kpos = done + rotation;
      if (kpos >= K)
        kpos -= K;
      int rk = K - done;
      if (rk > KC)
        rk = KC;
      int kp = (rk + 31) / 32 * 32;
      int s = kidx % 2;
      auto a2 = a2b.template Get<int8_t>()[s * BM * KC];
      auto b2 = b2b.template Get<int8_t>()[s * KC * BN];
      auto b1 = b1b.template Get<int8_t>()[s * KC * BN];
      if (kidx >= 2)
        WaitFlag<HardEvent::MTE1_MTE2>(l1Free[s]);
      Nd2NzParams bp;
      bp.ndNum = 1;
      bp.nValue = rk;
      bp.dValue = rn;
      bp.srcDValue = N;
      bp.srcNdMatrixStride = 0;
      bp.dstNzC0Stride = KC;
      bp.dstNzNStride = 1;
      bp.dstNzMatrixStride = 0;
      DataCopy(b1, b[kpos * (int64_t)N], bp);
      SetFlag<HardEvent::MTE2_MTE1>(bReady[s]);
      if (kidx >= 2)
        WaitFlag<HardEvent::M_MTE1>(l0Free[s]);
      WaitFlag<HardEvent::MTE2_MTE1>(bReady[s]);
      LoadData2dTransposeParams bl;
      bl.startIndex = 0;
      bl.repeatTimes = (rn + 31) / 32;
      bl.srcStride = kp / 32;
      bl.dstGap = 1;
      bl.dstFracGap = 0;
      for (int i = 0; i < kp / 32; ++i)
        LoadDataWithTranspose(b2[i * na * 32], b1[i * 1024], bl);
      LoadData2DParams al;
      al.startIndex = 0;
      al.repeatTimes = kp / 32;
      al.srcStride = BM / 16;
      al.dstGap = 0;
      al.ifTranspose = false;
      for (int i = 0; i < (rm + 15) / 16; ++i)
        LoadData(a2[i * kp * 16], a1[i * 512 + (kpos / 32) * (BM * 32)], al);
      SetFlag<HardEvent::MTE1_MTE2>(l1Free[s]);
      auto mr = pipe->FetchEventID(HardEvent::MTE1_M);
      SetFlag<HardEvent::MTE1_M>(mr);
      WaitFlag<HardEvent::MTE1_M>(mr);
      MmadParams mp;
      mp.m = (rm + 15) / 16 * 16;
      mp.n = na;
      mp.k = kp;
      mp.cmatrixInitVal = (done == 0);
      mp.unitFlag = (done + rk >= K ? 3 : 2);
      if (done == 0 && serial >= 1)
        WaitFlag<HardEvent::FIX_M>(cFree);
      Mmad(c1, a2, b2, mp);
      SetFlag<HardEvent::M_MTE1>(l0Free[s]);
      ++kidx;
    }
    FixpipeParamsV220 fp;
    fp.unitFlag = 3;
    fp.mSize = (rm + 15) / 16 * 16;
    fp.nSize = na;
    fp.srcStride = (rm + 15) / 16 * 16;
    fp.dstStride = BN;
    fp.quantPre = QuantMode_t::NoQuant;
    Fixpipe<int32_t, int32_t, CFG_ROW_MAJOR>(c, c1, fp);
    SetFlag<HardEvent::FIX_M>(cFree);
    ++serial;
  }
  __aicore__ inline void End() {
    for (int i = 0; i < 2 && i < kidx; ++i)
      WaitFlag<HardEvent::MTE1_MTE2>(l1Free[i]);
    for (int i = 0; i < 2 && i < kidx; ++i)
      WaitFlag<HardEvent::M_MTE1>(l0Free[i]);
    if (serial)
      WaitFlag<HardEvent::FIX_M>(cFree);
    for (int i = 0; i < 2; ++i) {
      pipe->ReleaseEventID<HardEvent::MTE1_MTE2>(l1Free[i]);
      pipe->ReleaseEventID<HardEvent::MTE2_MTE1>(bReady[i]);
    }
    for (int i = 0; i < 2; ++i)
      pipe->ReleaseEventID<HardEvent::M_MTE1>(l0Free[i]);
    pipe->ReleaseEventID<HardEvent::FIX_M>(cFree);
    PipeBarrier<PIPE_ALL>();
  }
};

template <int BM, int BN, int KC>
__global__ __mix__(1, 2) void grouped_matmul_gelu_resident_contiguous(GM_ADDR x, GM_ADDR w,
                                                                      GM_ADDR s, GM_ADDR g,
                                                                      GM_ADDR y, GM_ADDR work,
                                                                      int M, int N, int K, int E,
                                                                      int cores, int nbundle) {
  constexpr int RING = 4;
  constexpr uint16_t READY_FLAG = 8, FREE_FLAG = 4;
  constexpr int BC = BM * BN;
  TPipe pipe;
  DirectInt8PanelRes<BM, BN, KC> mm;
  TBuf<TPosition::VECIN> cb, sb;
  TBuf<TPosition::VECCALC> tb;
  TBuf<TPosition::VECOUT> ob;
  if ASCEND_IS_AIC {
    mm.Init(pipe);
  }
  if ASCEND_IS_AIV {
    pipe.InitBuffer(cb, 64 * BN * 4);
    pipe.InitBuffer(sb, BN * 4 + 256);
    pipe.InitBuffer(tb, 64 * BN * 4 + 256);
    pipe.InitBuffer(ob, 64 * BN * 2);
  }
  GlobalTensor<int8_t> xx, ww;
  GlobalTensor<float> ss;
  GlobalTensor<int64_t> gg;
  GlobalTensor<half> yy;
  GlobalTensor<int32_t> cc;
  xx.SetGlobalBuffer((__gm__ int8_t *)x);
  ww.SetGlobalBuffer((__gm__ int8_t *)w);
  ss.SetGlobalBuffer((__gm__ float *)s);
  gg.SetGlobalBuffer((__gm__ int64_t *)g);
  yy.SetGlobalBuffer((__gm__ half *)y);
  cc.SetGlobalBuffer((__gm__ int32_t *)work);
  int bid = GetBlockIdx(), sub = 0;
  if ASCEND_IS_AIV {
    bid = GetBlockIdx() / 2;
    sub = GetSubBlockIdx();
  }
  TEventID outputDone = 0, inputConsumed = 0;
  bool outputPending = false, inputPending = false;
  if ASCEND_IS_AIV {
    outputDone = pipe.AllocEventID<HardEvent::MTE3_V>();
    inputConsumed = pipe.AllocEventID<HardEvent::V_MTE2>();
  }
                                                                                     
                                                                                
  int actualMtiles = 0, previous = 0;
  for (int e = 0; e < E; ++e) {
    int end = (int)gg.GetValue(e);
    actualMtiles += (end - previous + BM - 1) / BM;
    previous = end;
  }
  int nt = N / BN, totalTiles = actualMtiles * nt;
                                                                                
  int used = cores, waves = (totalTiles + cores - 1) / cores;
  if (waves >= 3) {
    int minimum = (cores * 4 + 4) / 5;
    used = (totalTiles + waves - 1) / waves;
    if (used < minimum)
      used = minimum;
  }
  int ownedFirst = bid < used ? (int)((int64_t)totalTiles * bid / used) : totalTiles;
  int ownedLast = bid < used ? (int)((int64_t)totalTiles * (bid + 1) / used) : totalTiles;
  int serial = 0, start = 0, tileBase = 0;
  for (int e = 0; e < E; ++e) {
    int end = (int)gg.GetValue(e), rows = end - start, mt = (rows + BM - 1) / BM,
        groupTiles = mt * nt;
    int first = ownedFirst - tileBase;
    if (first < 0)
      first = 0;
    int last = ownedLast - tileBase;
    if (last > groupTiles)
      last = groupTiles;
    int loadedMi = -1;
    for (int tile = first; tile < last; ++tile) {
      int mi = (tile / nt) * BM, ni = tile % nt, rm = rows - mi;
      if (rm > BM)
        rm = BM;
      if ASCEND_IS_AIC {
        if (mi != loadedMi) {
          mm.LoadA(xx[(start + mi) * (int64_t)K], K, rm);
          loadedMi = mi;
        }
      }
      {
        int rn = N - ni * BN;
        if (rn > BN)
          rn = BN;
        int64_t coff = ((serial % RING) * cores + bid) * (int64_t)BC;
        if ASCEND_IS_AIC {
          if (serial >= RING)
            CrossCoreWaitFlag(FREE_FLAG + serial % RING);
          mm.Tile(ww[e * (int64_t)K * N + ni * BN], cc[coff], K, N, rm, rn);
          CrossCoreSetFlag<2, PIPE_FIX>(READY_FLAG + serial % RING);
        }
        if ASCEND_IS_AIV {
          auto ci = cb.Get<int32_t>();
          auto sc = sb.Get<float>();
          auto z = cb.Get<float>();
          auto t = tb.Get<float>();
          auto u = cb.Get<float>();
          auto o = ob.Get<half>();
          int split = (rm + 1) / 2, vstart = sub * split, vm = rm - vstart;
          if (vm > split)
            vm = split;
          if (vm < 0)
            vm = 0;
          int stride = (rn + 15) / 16 * 16;
          CrossCoreWaitFlag(READY_FLAG + serial % RING);
          int totalVm = vm;
          for (int vr = 0; vr < totalVm; vr += 64) {
            vm = totalVm - vr;
            if (vm > 64)
              vm = 64;
            if (inputPending) {
              WaitFlag<HardEvent::V_MTE2>(inputConsumed);
              inputPending = false;
            }
            DataCopyExtParams cp{(uint16_t)vm, (uint32_t)(rn * 4), (uint32_t)((BN - rn) * 4),
                                 (uint32_t)((stride - (rn + 7) / 8 * 8) / 8), 0};
            DataCopyPadExtParams<int32_t> ip{true, 0, 0, 0};
            DataCopyPad(ci, cc[coff + (vstart + vr) * BN], cp, ip);
            DataCopyExtParams sp{1, (uint32_t)(rn * 4), 0, 0, 0};
            DataCopyPadExtParams<float> fp{true, 0, 0, 0};
            DataCopyPad(sc, ss[e * (int64_t)N + ni * BN], sp, fp);
            auto ev = pipe.FetchEventID(HardEvent::MTE2_V);
            SetFlag<HardEvent::MTE2_V>(ev);
            WaitFlag<HardEvent::MTE2_V>(ev);
            if (vr + vm >= totalVm)
              CrossCoreSetFlag<2, PIPE_MTE2>(FREE_FLAG + serial % RING);
            int count = vm * stride;
            Cast(z, ci, RoundMode::CAST_NONE, count);
            PipeBarrier<PIPE_V>();
            for (int c = 0; c < stride; c += 64) {
              uint64_t mask = (stride - c < 64 ? stride - c : 64);
              Mul(z[c], z[c], sc[c], mask, (uint8_t)vm,
                  {1, 1, 1, (uint8_t)(stride / 8), (uint8_t)(stride / 8), 0});
            }
            PipeBarrier<PIPE_V>();
            GmmDirectVectorCounter(z, t, u, count);
            if (outputPending) {
              WaitFlag<HardEvent::MTE3_V>(outputDone);
              outputPending = false;
            }
            Cast(o, u, RoundMode::CAST_RINT, count);
            PipeBarrier<PIPE_V>();
                                                                                        
            SetFlag<HardEvent::V_MTE2>(inputConsumed);
            inputPending = true;
            auto ev2 = pipe.FetchEventID(HardEvent::V_MTE3);
            SetFlag<HardEvent::V_MTE3>(ev2);
            WaitFlag<HardEvent::V_MTE3>(ev2);
            DataCopyExtParams op{(uint16_t)vm, (uint32_t)(rn * 2),
                                 (uint32_t)((stride - (rn + 15) / 16 * 16) / 16),
                                 (uint32_t)((N - rn) * 2), 0};
            DataCopyPad(yy[(start + mi + vstart + vr) * (int64_t)N + ni * BN], o, op);
            SetFlag<HardEvent::MTE3_V>(outputDone);
            outputPending = true;
          }
          if (!totalVm)
            CrossCoreSetFlag<2, PIPE_MTE2>(FREE_FLAG + serial % RING);
        }
        ++serial;
      }
    }
    tileBase += groupTiles;
    start = end;
  }
  if ASCEND_IS_AIV {
    if (inputPending)
      WaitFlag<HardEvent::V_MTE2>(inputConsumed);
    if (outputPending)
      WaitFlag<HardEvent::MTE3_V>(outputDone);
    pipe.ReleaseEventID<HardEvent::V_MTE2>(inputConsumed);
    pipe.ReleaseEventID<HardEvent::MTE3_V>(outputDone);
  }
  if ASCEND_IS_AIC {
    mm.End();
    for (int i = 0; i < (serial < RING ? serial : RING); ++i)
      CrossCoreWaitFlag(FREE_FLAG + (serial - 1 - i) % RING);
  }
}

template <int BM, int BN, int KC>
__global__ __mix__(1, 2) void grouped_matmul_gelu_resident_legacy_epi(GM_ADDR x, GM_ADDR w,
                                                                      GM_ADDR s, GM_ADDR g,
                                                                      GM_ADDR y, GM_ADDR work,
                                                                      int M, int N, int K, int E,
                                                                      int cores, int nbundle) {
  constexpr int RING = 4;
  constexpr uint16_t READY_FLAG = 8, FREE_FLAG = 4;
  constexpr int BC = BM * BN;
  TPipe pipe;
  DirectInt8PanelRes<BM, BN, KC> mm;
  TBuf<TPosition::VECIN> cb, sb;
  TBuf<TPosition::VECCALC> zb, tb, ub;
  TBuf<TPosition::VECOUT> ob;
  if ASCEND_IS_AIC {
    mm.Init(pipe);
  }
  if ASCEND_IS_AIV {
    pipe.InitBuffer(cb, 32 * BN * 4);
    pipe.InitBuffer(sb, BN * 4 + 256);
    pipe.InitBuffer(zb, 32 * BN * 4 + 256);
    pipe.InitBuffer(tb, 32 * BN * 4 + 256);
    pipe.InitBuffer(ub, 32 * BN * 4 + 256);
    pipe.InitBuffer(ob, 32 * BN * 2);
  }
  GlobalTensor<int8_t> xx, ww;
  GlobalTensor<float> ss;
  GlobalTensor<int64_t> gg;
  GlobalTensor<half> yy;
  GlobalTensor<int32_t> cc;
  xx.SetGlobalBuffer((__gm__ int8_t *)x);
  ww.SetGlobalBuffer((__gm__ int8_t *)w);
  ss.SetGlobalBuffer((__gm__ float *)s);
  gg.SetGlobalBuffer((__gm__ int64_t *)g);
  yy.SetGlobalBuffer((__gm__ half *)y);
  cc.SetGlobalBuffer((__gm__ int32_t *)work);
  int bid = GetBlockIdx(), sub = 0;
  if ASCEND_IS_AIV {
    bid = GetBlockIdx() / 2;
    sub = GetSubBlockIdx();
  }
  TEventID outputDone = 0, inputConsumed = 0;
  bool outputPending = false, inputPending = false;
  if ASCEND_IS_AIV {
    outputDone = pipe.AllocEventID<HardEvent::MTE3_V>();
    inputConsumed = pipe.AllocEventID<HardEvent::V_MTE2>();
  }
                                                                                     
                                                                                
  int actualMtiles = 0, previous = 0;
  for (int e = 0; e < E; ++e) {
    int end = (int)gg.GetValue(e);
    actualMtiles += (end - previous + BM - 1) / BM;
    previous = end;
  }
  int nt = N / BN, totalTiles = actualMtiles * nt;
  int ownedFirst = (int)((int64_t)totalTiles * bid / cores),
      ownedLast = (int)((int64_t)totalTiles * (bid + 1) / cores);
  int serial = 0, start = 0, tileBase = 0;
  for (int e = 0; e < E; ++e) {
    int end = (int)gg.GetValue(e), rows = end - start, mt = (rows + BM - 1) / BM,
        groupTiles = mt * nt;
    int first = ownedFirst - tileBase;
    if (first < 0)
      first = 0;
    int last = ownedLast - tileBase;
    if (last > groupTiles)
      last = groupTiles;
    int loadedMi = -1;
    for (int tile = first; tile < last; ++tile) {
      int mi = (tile / nt) * BM, ni = tile % nt, rm = rows - mi;
      if (rm > BM)
        rm = BM;
      if ASCEND_IS_AIC {
        if (mi != loadedMi) {
          mm.LoadA(xx[(start + mi) * (int64_t)K], K, rm);
          loadedMi = mi;
        }
      }
      {
        int rn = N - ni * BN;
        if (rn > BN)
          rn = BN;
        int64_t coff = ((serial % RING) * cores + bid) * (int64_t)BC;
        if ASCEND_IS_AIC {
          if (serial >= RING)
            CrossCoreWaitFlag(FREE_FLAG + serial % RING);
          mm.Tile(ww[e * (int64_t)K * N + ni * BN], cc[coff], K, N, rm, rn);
          CrossCoreSetFlag<2, PIPE_FIX>(READY_FLAG + serial % RING);
        }
        if ASCEND_IS_AIV {
          auto ci = cb.Get<int32_t>();
          auto sc = sb.Get<float>();
          auto z = zb.Get<float>();
          auto t = tb.Get<float>();
          auto u = ub.Get<float>();
          auto o = ob.Get<half>();
          int split = (rm + 1) / 2, vstart = sub * split, vm = rm - vstart;
          if (vm > split)
            vm = split;
          if (vm < 0)
            vm = 0;
          int stride = (rn + 15) / 16 * 16;
          CrossCoreWaitFlag(READY_FLAG + serial % RING);
          int totalVm = vm;
          for (int vr = 0; vr < totalVm; vr += 32) {
            vm = totalVm - vr;
            if (vm > 32)
              vm = 32;
            if (inputPending) {
              WaitFlag<HardEvent::V_MTE2>(inputConsumed);
              inputPending = false;
            }
            DataCopyExtParams cp{(uint16_t)vm, (uint32_t)(rn * 4), (uint32_t)((BN - rn) * 4),
                                 (uint32_t)((stride - (rn + 7) / 8 * 8) / 8), 0};
            DataCopyPadExtParams<int32_t> ip{true, 0, 0, 0};
            DataCopyPad(ci, cc[coff + (vstart + vr) * BN], cp, ip);
            DataCopyExtParams sp{1, (uint32_t)(rn * 4), 0, 0, 0};
            DataCopyPadExtParams<float> fp{true, 0, 0, 0};
            DataCopyPad(sc, ss[e * (int64_t)N + ni * BN], sp, fp);
            auto ev = pipe.FetchEventID(HardEvent::MTE2_V);
            SetFlag<HardEvent::MTE2_V>(ev);
            WaitFlag<HardEvent::MTE2_V>(ev);
            if (vr + vm >= totalVm)
              CrossCoreSetFlag<2, PIPE_MTE2>(FREE_FLAG + serial % RING);
            int count = vm * stride;
            Cast(z, ci, RoundMode::CAST_NONE, count);
            PipeBarrier<PIPE_V>();
            for (int c = 0; c < stride; c += 64) {
              uint64_t mask = (stride - c < 64 ? stride - c : 64);
              Mul(z[c], z[c], sc[c], mask, (uint8_t)vm,
                  {1, 1, 1, (uint8_t)(stride / 8), (uint8_t)(stride / 8), 0});
            }
            SetFlag<HardEvent::V_MTE2>(inputConsumed);
            inputPending = true;
            PipeBarrier<PIPE_V>();
            GmmDirectVectorCounter(z, t, u, count);
            if (outputPending) {
              WaitFlag<HardEvent::MTE3_V>(outputDone);
              outputPending = false;
            }
            Cast(o, u, RoundMode::CAST_RINT, count);
            PipeBarrier<PIPE_V>();
            auto ev2 = pipe.FetchEventID(HardEvent::V_MTE3);
            SetFlag<HardEvent::V_MTE3>(ev2);
            WaitFlag<HardEvent::V_MTE3>(ev2);
            DataCopyExtParams op{(uint16_t)vm, (uint32_t)(rn * 2),
                                 (uint32_t)((stride - (rn + 15) / 16 * 16) / 16),
                                 (uint32_t)((N - rn) * 2), 0};
            DataCopyPad(yy[(start + mi + vstart + vr) * (int64_t)N + ni * BN], o, op);
            SetFlag<HardEvent::MTE3_V>(outputDone);
            outputPending = true;
          }
          if (!totalVm)
            CrossCoreSetFlag<2, PIPE_MTE2>(FREE_FLAG + serial % RING);
        }
        ++serial;
      }
    }
    tileBase += groupTiles;
    start = end;
  }
  if ASCEND_IS_AIV {
    if (inputPending)
      WaitFlag<HardEvent::V_MTE2>(inputConsumed);
    if (outputPending)
      WaitFlag<HardEvent::MTE3_V>(outputDone);
    pipe.ReleaseEventID<HardEvent::V_MTE2>(inputConsumed);
    pipe.ReleaseEventID<HardEvent::MTE3_V>(outputDone);
  }
  if ASCEND_IS_AIC {
    mm.End();
    for (int i = 0; i < (serial < RING ? serial : RING); ++i)
      CrossCoreWaitFlag(FREE_FLAG + (serial - 1 - i) % RING);
  }
}

static __attribute__((noinline)) bool TryContiguousResident(GM_ADDR x, GM_ADDR w, GM_ADDR s,
                                                            GM_ADDR g, GM_ADDR y, int M, int N,
                                                            int K, int E, int64_t availableCoreNum,
                                                            bool wide, aclrtStream stream);

static __attribute__((noinline)) bool TryResidentTail(GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR g,
                                                      GM_ADDR y, int M, int N, int K, int E,
                                                      int64_t availableCoreNum, bool wide,
                                                      aclrtStream stream);
__aicore__ inline void PackWeightsNZ(GM_ADDR source, GM_ADDR dest, GM_ADDR groups, int E, int K,
                                     int KP, int N, int NP, TPipe &pipe, LocalTensor<int8_t> stage,
                                     LocalTensor<uint16_t> nzStage) {
  GlobalTensor<int8_t> input, output;
  GlobalTensor<int64_t> gg;
  input.SetGlobalBuffer((__gm__ int8_t *)source);
  output.SetGlobalBuffer((__gm__ int8_t *)dest);
  gg.SetGlobalBuffer((__gm__ int64_t *)groups);
  constexpr int STAGE_BYTES = 65536;
  int batch = STAGE_BYTES / NP / 32 * 32, parts = (KP + batch - 1) / batch, id = GetBlockIdx(),
      workers = GetBlockNum() * 2;
  auto init = pipe.FetchEventID(HardEvent::MTE3_V);
  SetFlag<HardEvent::MTE3_V>(init);
  WaitFlag<HardEvent::MTE3_V>(init);
  Duplicate(stage.ReinterpretCast<int32_t>(), int32_t(0), STAGE_BYTES / 4);
  PipeBarrier<PIPE_V>();
  auto zeroReady = pipe.FetchEventID(HardEvent::V_MTE2);
  SetFlag<HardEvent::V_MTE2>(zeroReady);
  WaitFlag<HardEvent::V_MTE2>(zeroReady);
  int previous = 0;
  for (int e = 0; e < E; ++e) {
    int end = (int)gg.GetValue(e), active = end - previous;
    previous = end;
    if (!active)
      continue;
    int first = (id - (e * parts) % workers + workers) % workers;
    for (int tile = first; tile < parts; tile += workers) {
      int row = tile * batch, rows = KP - row;
      if (rows > batch)
        rows = batch;
      int valid = K - row;
      if (valid > rows)
        valid = rows;
      if (valid < 0)
        valid = 0;
      if (valid < rows) {
        auto free = pipe.FetchEventID(HardEvent::MTE3_V);
        SetFlag<HardEvent::MTE3_V>(free);
        WaitFlag<HardEvent::MTE3_V>(free);
        Duplicate(stage.ReinterpretCast<int32_t>()[valid * NP / 4], int32_t(0),
                  (rows - valid) * NP / 4);
        PipeBarrier<PIPE_V>();
        auto ready = pipe.FetchEventID(HardEvent::V_MTE2);
        SetFlag<HardEvent::V_MTE2>(ready);
        WaitFlag<HardEvent::V_MTE2>(ready);
      }
      DataCopyExtParams cp{(uint16_t)valid, (uint32_t)N, 0, 0, 0};
      DataCopyPadExtParams<int8_t> pad{true, 0, (uint8_t)((32 - N % 32) % 32), 0};
      if (valid)
        DataCopyPad(stage, input[(e * (int64_t)K + row) * N], cp, pad);
      auto loaded = pipe.FetchEventID(HardEvent::MTE2_V);
      SetFlag<HardEvent::MTE2_V>(loaded);
      WaitFlag<HardEvent::MTE2_V>(loaded);
      CopyRepeatParams vp{1, (uint16_t)(NP / 32), 8, (uint16_t)(NP / 4)};
      auto input16 = stage.ReinterpretCast<uint16_t>();
      for (int nb = 0; nb < NP / 32; ++nb)
        Copy(nzStage[nb * rows * 16], input16[nb * 16], uint64_t(128), (uint8_t)(rows / 8), vp);
      PipeBarrier<PIPE_V>();
      auto ready = pipe.FetchEventID(HardEvent::V_MTE3);
      SetFlag<HardEvent::V_MTE3>(ready);
      WaitFlag<HardEvent::V_MTE3>(ready);
      DataCopyParams nz;
      nz.blockCount = NP / 32;
      nz.blockLen = rows;
      nz.srcStride = 0;
      nz.dstStride = KP - rows;
      DataCopy(output[e * (int64_t)NP * KP + row * 32], nzStage.ReinterpretCast<int8_t>(), nz);
      auto consumed = pipe.FetchEventID(HardEvent::MTE3_MTE2);
      SetFlag<HardEvent::MTE3_MTE2>(consumed);
      WaitFlag<HardEvent::MTE3_MTE2>(consumed);
    }
  }
}

template <int BM, int BN, int KC> class DirectInt8PhaseNZ {
  TBuf<TPosition::A1> a1b;
  TBuf<TPosition::B1> b1b;
  TBuf<TPosition::A2> a2b;
  TBuf<TPosition::B2> b2b;
  TBuf<TPosition::CO1> c1b;
  TPipe *pipe;
  int serial = 0, kidx = 0;
  TEventID l1Free[2], bReady[2], l0Free[2], cFree;

public:
  __aicore__ inline void Init(TPipe &p) {
    pipe = &p;
    p.InitBuffer(a1b, BM * 2048);
    p.InitBuffer(b1b, 2 * KC * BN);
    p.InitBuffer(a2b, 2 * BM * KC);
    p.InitBuffer(b2b, 2 * KC * BN);
    p.InitBuffer(c1b, BM * BN * 4);
    for (int i = 0; i < 2; ++i) {
      l1Free[i] = p.AllocEventID<HardEvent::MTE1_MTE2>();
      bReady[i] = p.AllocEventID<HardEvent::MTE2_MTE1>();
    }
    for (int i = 0; i < 2; ++i)
      l0Free[i] = p.AllocEventID<HardEvent::M_MTE1>();
    cFree = p.AllocEventID<HardEvent::FIX_M>();
  }
  __aicore__ inline int NextPackTask(int task, int limit, int workers, int parts,
                                     GlobalTensor<int64_t> gg) {
    for (; task < limit; task += workers) {
      int e = task / parts;
      int start = e ? (int)gg.GetValue(e - 1) : 0;
      if ((int)gg.GetValue(e) > start)
        return task;
    }
    return limit;
  }
  __aicore__ inline void PreloadPackW(GlobalTensor<int8_t> input, int task, int seq, int parts,
                                      int batch, int K, int KP, int N, int NP, TEventID *ready,
                                      TEventID *free) {
    int slot = seq % 2, e = task / parts, row = task % parts * batch, rows = KP - row;
    if (rows > batch)
      rows = batch;
    int valid = K - row;
    if (valid > rows)
      valid = rows;
    if (valid < 0)
      valid = 0;
    auto stage = a1b.template Get<int8_t>()[slot * 65536];
    if (seq >= 2)
      WaitFlag<HardEvent::MTE3_MTE2>(free[slot]);
    if (valid < rows) {
      InitConstValueParams<uint16_t> zero;
      zero.repeatTimes = NP / 32;
      zero.blockNum = rows - valid;
      zero.dstGap = valid;
      zero.initValue = 0;
      InitConstValue(stage.ReinterpretCast<uint16_t>()[valid * 16], zero);
      PipeBarrier<PIPE_MTE2>();
    }
    Nd2NzParams bp;
    bp.ndNum = 1;
    bp.nValue = valid;
    bp.dValue = N;
    bp.srcDValue = N;
    bp.srcNdMatrixStride = 0;
    bp.dstNzC0Stride = rows;
    bp.dstNzNStride = 1;
    bp.dstNzMatrixStride = 0;
    if (valid)
      DataCopy(stage, input[(e * (int64_t)K + row) * N], bp);
    SetFlag<HardEvent::MTE2_MTE3>(ready[slot]);
  }
  __aicore__ inline void PackW(GM_ADDR source, GM_ADDR dest, GM_ADDR groups, int E, int K, int KP,
                               int N, int NP) {
    GlobalTensor<int8_t> input, output;
    GlobalTensor<int64_t> gg;
    input.SetGlobalBuffer((__gm__ int8_t *)source);
    output.SetGlobalBuffer((__gm__ int8_t *)dest);
    gg.SetGlobalBuffer((__gm__ int64_t *)groups);
    constexpr int STAGE_BYTES = 65536;
    int batch = STAGE_BYTES / NP / 32 * 32, parts = (KP + batch - 1) / batch, id = GetBlockIdx(),
        workers = GetBlockNum(), limit = E * parts;
    TEventID ready[2], free[2];
    for (int i = 0; i < 2; ++i) {
      ready[i] = pipe->AllocEventID<HardEvent::MTE2_MTE3>();
      free[i] = pipe->AllocEventID<HardEvent::MTE3_MTE2>();
    }
    int tasks[2];
    tasks[0] = NextPackTask(id, limit, workers, parts, gg);
    tasks[1] = NextPackTask(tasks[0] + workers, limit, workers, parts, gg);
    int last = tasks[1] < limit ? tasks[1] : tasks[0];
    for (int i = 0; i < 2; ++i)
      if (tasks[i] < limit)
        PreloadPackW(input, tasks[i], i, parts, batch, K, KP, N, NP, ready, free);
    int seq = 0;
    while (tasks[seq % 2] < limit) {
      int slot = seq % 2, task = tasks[slot], e = task / parts, row = task % parts * batch,
          rows = KP - row;
      if (rows > batch)
        rows = batch;
      WaitFlag<HardEvent::MTE2_MTE3>(ready[slot]);
      auto stage = a1b.template Get<int8_t>()[slot * STAGE_BYTES];
      DataCopyParams nz;
      nz.blockCount = NP / 32;
      nz.blockLen = rows;
      nz.srcStride = 0;
      nz.dstStride = KP - rows;
      DataCopy(output[e * (int64_t)KP * NP + row * 32], stage, nz);
      SetFlag<HardEvent::MTE3_MTE2>(free[slot]);
      int next = NextPackTask(last + workers, limit, workers, parts, gg);
      tasks[slot] = next;
      if (next < limit) {
        PreloadPackW(input, next, seq + 2, parts, batch, K, KP, N, NP, ready, free);
        last = next;
      }
      ++seq;
    }
    for (int i = 0; i < 2 && i < seq; ++i)
      WaitFlag<HardEvent::MTE3_MTE2>(free[i]);
    for (int i = 0; i < 2; ++i) {
      pipe->ReleaseEventID<HardEvent::MTE2_MTE3>(ready[i]);
      pipe->ReleaseEventID<HardEvent::MTE3_MTE2>(free[i]);
    }
  }
  __aicore__ inline void LoadA(GlobalTensor<int8_t> a, int K, int rm, int strideK) {
    auto a1 = a1b.template Get<int8_t>();
    Nd2NzParams ap;
    ap.ndNum = 1;
    ap.nValue = rm;
    ap.dValue = K;
    ap.srcDValue = strideK;
    ap.srcNdMatrixStride = 0;
    ap.dstNzC0Stride = BM;
    ap.dstNzNStride = 1;
    ap.dstNzMatrixStride = 0;
    auto aConsumed = pipe->FetchEventID(HardEvent::MTE1_MTE2);
    SetFlag<HardEvent::MTE1_MTE2>(aConsumed);
    WaitFlag<HardEvent::MTE1_MTE2>(aConsumed);
                                                                          
                                                                          
    if (rm % 32 || K % 32) {
      InitConstValueParams<int8_t> zero;
      zero.repeatTimes = 1;
      zero.blockNum = BM * ((K + 31) / 32);
      zero.dstGap = 0;
      zero.initValue = 0;
      InitConstValue(a1, zero);
      PipeBarrier<PIPE_MTE2>();
    }
    DataCopy(a1, a, ap);
    auto aReady = pipe->FetchEventID(HardEvent::MTE2_MTE1);
    SetFlag<HardEvent::MTE2_MTE1>(aReady);
    WaitFlag<HardEvent::MTE2_MTE1>(aReady);
  }
  __aicore__ inline void Tile(GlobalTensor<int8_t> b, GlobalTensor<int32_t> c, int K, int N, int rm,
                              int rn, int outStride) {
    auto a1 = a1b.template Get<int8_t>();
    auto c1 = c1b.template Get<int32_t>();
    int na = (rn + 31) / 32 * 32;
    for (int done = 0; done < K; done += KC) {
      int rk = K - done;
      if (rk > KC)
        rk = KC;
      int kp = (rk + 31) / 32 * 32;
      int s = kidx % 2;
      auto a2 = a2b.template Get<int8_t>()[s * BM * KC];
      auto b2 = b2b.template Get<int8_t>()[s * KC * BN];
      auto b1 = b1b.template Get<int8_t>()[s * KC * BN];
      if (kidx >= 2)
        WaitFlag<HardEvent::MTE1_MTE2>(l1Free[s]);
      DataCopyParams nz;
      nz.blockCount = (rn + 31) / 32;
      nz.blockLen = kp;
      nz.srcStride = N - kp;
      nz.dstStride = KC - kp;
      DataCopy(b1, b[done * 32], nz);
      SetFlag<HardEvent::MTE2_MTE1>(bReady[s]);
      if (kidx >= 2)
        WaitFlag<HardEvent::M_MTE1>(l0Free[s]);
      WaitFlag<HardEvent::MTE2_MTE1>(bReady[s]);
      LoadData2dTransposeParams bl;
      bl.startIndex = 0;
      bl.dstFracGap = 0;
      int nblocks = (rn + 31) / 32;
      if (nblocks < kp / 32) {
        bl.repeatTimes = kp / 32;
        bl.srcStride = 1;
        bl.dstGap = na / 16 - 1;
        for (int i = 0; i < nblocks; ++i)
          LoadDataWithTranspose(b2[i * 1024], b1[i * KC * 32], bl);
      } else {
        bl.repeatTimes = nblocks;
        bl.srcStride = KC / 32;
        bl.dstGap = 1;
        for (int i = 0; i < kp / 32; ++i)
          LoadDataWithTranspose(b2[i * na * 32], b1[i * 1024], bl);
      }
      LoadData2DParams al;
      al.startIndex = 0;
      al.ifTranspose = false;
      int mblocks = ((rm + 31) / 32) * 2, kblocks = kp / 32;
      if (kblocks < mblocks) {
        al.repeatTimes = mblocks;
        al.srcStride = 1;
        al.dstGap = kblocks - 1;
        for (int i = 0; i < kblocks; ++i)
          LoadData(a2[i * 512], a1[(done / 32 + i) * (BM * 32)], al);
      } else {
        al.repeatTimes = kblocks;
        al.srcStride = BM / 16;
        al.dstGap = 0;
        for (int i = 0; i < mblocks; ++i)
          LoadData(a2[i * kp * 16], a1[i * 512 + (done / 32) * (BM * 32)], al);
      }
      SetFlag<HardEvent::MTE1_MTE2>(l1Free[s]);
      auto mr = pipe->FetchEventID(HardEvent::MTE1_M);
      SetFlag<HardEvent::MTE1_M>(mr);
      WaitFlag<HardEvent::MTE1_M>(mr);
      MmadParams mp;
      mp.m = (rm + 31) / 32 * 32;
      mp.n = na;
      mp.k = kp;
      mp.cmatrixInitVal = (done == 0);
      if (done == 0 && serial >= 1)
        WaitFlag<HardEvent::FIX_M>(cFree);
      Mmad(c1, a2, b2, mp);
      PipeBarrier<PIPE_M>();
      SetFlag<HardEvent::M_MTE1>(l0Free[s]);
      ++kidx;
    }
    auto doneEv = pipe->FetchEventID(HardEvent::M_FIX);
    SetFlag<HardEvent::M_FIX>(doneEv);
    WaitFlag<HardEvent::M_FIX>(doneEv);
    FixpipeParamsV220 fp;
    fp.mSize = rm;
    fp.nSize = na;
    fp.srcStride = (rm + 31) / 32 * 32;
    fp.dstStride = outStride;
    fp.quantPre = QuantMode_t::NoQuant;
    fp.deqScalar = 0;
    SetAtomicAdd<int32_t>();
    Fixpipe<int32_t, int32_t, CFG_ROW_MAJOR>(c, c1, fp);
    SetAtomicNone();
    SetFlag<HardEvent::FIX_M>(cFree);
    ++serial;
  }
  __aicore__ inline void End() {
    for (int i = 0; i < 2 && i < kidx; ++i)
      WaitFlag<HardEvent::MTE1_MTE2>(l1Free[i]);
    for (int i = 0; i < 2 && i < kidx; ++i)
      WaitFlag<HardEvent::M_MTE1>(l0Free[i]);
    if (serial)
      WaitFlag<HardEvent::FIX_M>(cFree);
    for (int i = 0; i < 2; ++i) {
      pipe->ReleaseEventID<HardEvent::MTE1_MTE2>(l1Free[i]);
      pipe->ReleaseEventID<HardEvent::MTE2_MTE1>(bReady[i]);
    }
    for (int i = 0; i < 2; ++i)
      pipe->ReleaseEventID<HardEvent::M_MTE1>(l0Free[i]);
    pipe->ReleaseEventID<HardEvent::FIX_M>(cFree);
    PipeBarrier<PIPE_ALL>();
  }
};

__global__ __mix__(1, 2) __attribute__((section(".night_phase"))) void phase_nz_aicpack(
    GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR g, GM_ADDR y, GM_ADDR work, GM_ADDR packedWeight,
    GM_ADDR packedX, int M, int N, int K, int KP, int E, int NP, int chunks, int chunkK, int cores,
    TCubeTiling td) {
  constexpr int BM = 128, BN = 256, VM = 16;
  int WP = (N + 31) / 32 * 32;
  TPipe pipe;
  DirectInt8PhaseNZ<BM, BN, 128> mm;
  TBuf<TPosition::VECIN> cb, sb;
  TBuf<TPosition::VECCALC> ab, zb, tb, ub;
  TBuf<TPosition::VECOUT> ob;
  if ASCEND_IS_AIC {
    mm.Init(pipe);
  }
  if ASCEND_IS_AIV {
    pipe.InitBuffer(cb, 32 * BN * 4);
    pipe.InitBuffer(sb, BN * 4);
    pipe.InitBuffer(ab, VM * BN * 4);
    pipe.InitBuffer(zb, VM * BN * 4);
    pipe.InitBuffer(tb, VM * BN * 4);
    pipe.InitBuffer(ub, VM * BN * 4);
    pipe.InitBuffer(ob, VM * BN * 2);
  }
  GlobalTensor<int8_t> xx, ww;
  GlobalTensor<float> ss;
  GlobalTensor<int64_t> gg;
  GlobalTensor<half> yy;
  GlobalTensor<int32_t> cc;
  xx.SetGlobalBuffer((__gm__ int8_t *)packedX);
  ww.SetGlobalBuffer((__gm__ int8_t *)packedWeight);
  ss.SetGlobalBuffer((__gm__ float *)s);
  gg.SetGlobalBuffer((__gm__ int64_t *)g);
  yy.SetGlobalBuffer((__gm__ half *)y);
  cc.SetGlobalBuffer((__gm__ int32_t *)work);
  if ASCEND_IS_AIC {
    mm.PackW(w, packedWeight, g, E, K, KP, N, WP);
  }
  if ASCEND_IS_AIV {
    PackXWithKAlignment<BN>(x, packedX, M, K, KP, pipe, cb.Get<int8_t>());
                                                                                    
    auto zeroFree = pipe.FetchEventID(HardEvent::MTE3_V);
    SetFlag<HardEvent::MTE3_V>(zeroFree);
    WaitFlag<HardEvent::MTE3_V>(zeroFree);
    auto zero = cb.Get<int32_t>();
    constexpr int ZC = 32 * BN;
    Duplicate(zero, int32_t(0), ZC);
    PipeBarrier<PIPE_V>();
    auto zeroReady = pipe.FetchEventID(HardEvent::V_MTE3);
    SetFlag<HardEvent::V_MTE3>(zeroReady);
    WaitFlag<HardEvent::V_MTE3>(zeroReady);
    int64_t total = (int64_t)M * NP;
    int workers = GetBlockNum() * 2, id = GetBlockIdx();
    for (int64_t pos = (int64_t)id * ZC; pos < total; pos += (int64_t)workers * ZC) {
      int count = (int)(total - pos);
      if (count > ZC)
        count = ZC;
      DataCopy(cc[pos], zero, count);
    }
    auto zeroDone = pipe.FetchEventID(HardEvent::MTE3_MTE2);
    SetFlag<HardEvent::MTE3_MTE2>(zeroDone);
    WaitFlag<HardEvent::MTE3_MTE2>(zeroDone);
  }
  SyncAll<false>();
  if ASCEND_IS_AIC {
    int base = 0, bid = GetBlockIdx();
    for (int phase = 0; phase < 2; ++phase) {
      int start = 0, nt = phase == 0 ? N / BN : ((N % BN) != 0 ? 1 : 0);
      if (nt == 0)
        continue;
      for (int e = 0; e < E; ++e) {
        int end = (int)gg.GetValue(e), rows = end - start, mt = (rows + BM - 1) / BM,
            tasks = mt * nt * chunks;
        int local = (bid - base % cores + cores) % cores;
        for (int task = local; task < tasks; task += cores) {
          int ki = task % chunks, tile = task / chunks, mi = tile / nt * BM,
              ni = (phase == 0 ? tile % nt : N / BN) * BN;
          int rm = rows - mi;
          if (rm > BM)
            rm = BM;
          int rn = N - ni;
          if (rn > BN)
            rn = BN;
          int kk = ki * chunkK, rk = KP - kk;
          if (rk > chunkK)
            rk = chunkK;
          mm.LoadA(xx[(start + mi) * (int64_t)KP + kk], rk, rm, KP);
          mm.Tile(ww[e * (int64_t)KP * WP + ni * (int64_t)KP + kk * 32],
                  cc[((int64_t)start + mi) * NP + ni], rk, KP, rm, rn, NP);
        }
        base += tasks;
        start = end;
      }
    }
    mm.End();
    auto committed = pipe.FetchEventID(HardEvent::FIX_MTE2);
    SetFlag<HardEvent::FIX_MTE2>(committed);
    WaitFlag<HardEvent::FIX_MTE2>(committed);
  }
  SyncAll<false>();
  if ASCEND_IS_AIV {
    auto part = cb.Get<int32_t>();
    auto scale = sb.Get<float>();
    auto acc = ab.Get<int32_t>();
    auto z = zb.Get<float>();
    auto t = tb.Get<float>();
    auto u = ub.Get<float>();
    auto o = ob.Get<half>();
    int nt = (N + BN - 1) / BN, vcores = GetBlockNum() * 2, vid = GetBlockIdx(), base = 0,
        start = 0;
    for (int e = 0; e < E; ++e) {
      int end = (int)gg.GetValue(e), rows = end - start, tiles = (rows + VM - 1) / VM * nt;
      int first = (vid - base % vcores + vcores) % vcores;
      for (int task = first; task < tiles; task += vcores) {
        int mi = task / nt * VM, col = task % nt * BN, vm = rows - mi, rn = N - col;
        if (vm > VM)
          vm = VM;
        if (rn > BN)
          rn = BN;
        int stride = (rn + 15) / 16 * 16, count = vm * stride;
        auto reuse = pipe.FetchEventID(HardEvent::V_MTE2);
        SetFlag<HardEvent::V_MTE2>(reuse);
        WaitFlag<HardEvent::V_MTE2>(reuse);
        DataCopyExtParams cp{(uint16_t)vm, (uint32_t)(rn * 4), (uint32_t)((NP - rn) * 4),
                             (uint32_t)((stride - (rn + 7) / 8 * 8) / 8), 0};
        DataCopyPadExtParams<int32_t> ip{true, 0, 0, 0};
        DataCopyPad(acc, cc[((int64_t)start + mi) * NP + col], cp, ip);
        auto ready = pipe.FetchEventID(HardEvent::MTE2_V);
        SetFlag<HardEvent::MTE2_V>(ready);
        WaitFlag<HardEvent::MTE2_V>(ready);
        DataCopyExtParams sp{1, (uint32_t)(rn * 4), 0, 0, 0};
        DataCopyPadExtParams<float> fp{true, 0, 0, 0};
        DataCopyPad(scale, ss[e * (int64_t)N + col], sp, fp);
        auto scaleReady = pipe.FetchEventID(HardEvent::MTE2_V);
        SetFlag<HardEvent::MTE2_V>(scaleReady);
        WaitFlag<HardEvent::MTE2_V>(scaleReady);
        Cast(z, acc, RoundMode::CAST_NONE, count);
        PipeBarrier<PIPE_V>();
        for (int c = 0; c < stride; c += 64) {
          uint64_t mask = (stride - c < 64 ? stride - c : 64);
          Mul(z[c], z[c], scale[c], mask, (uint8_t)vm,
              {1, 1, 1, (uint8_t)(stride / 8), (uint8_t)(stride / 8), 0});
        }
        PipeBarrier<PIPE_V>();
        Mul(t, z, z, count);
        PipeBarrier<PIPE_V>();
        Muls(t, t, 0.044715f, count);
        PipeBarrier<PIPE_V>();
        Adds(t, t, 1.0f, count);
        PipeBarrier<PIPE_V>();
        Mul(t, t, z, count);
        PipeBarrier<PIPE_V>();
        Muls(t, t, -1.5957691216057308f, count);
        PipeBarrier<PIPE_V>();
        Mins(t, t, 80.0f, count);
        PipeBarrier<PIPE_V>();
        Maxs(t, t, -80.0f, count);
        PipeBarrier<PIPE_V>();
        Exp(t, t, count);
        PipeBarrier<PIPE_V>();
        Adds(t, t, 1.0f, count);
        PipeBarrier<PIPE_V>();
        Div(u, z, t, count);
        PipeBarrier<PIPE_V>();
        Cast(o, u, RoundMode::CAST_RINT, count);
        PipeBarrier<PIPE_V>();
        auto output = pipe.FetchEventID(HardEvent::V_MTE3);
        SetFlag<HardEvent::V_MTE3>(output);
        WaitFlag<HardEvent::V_MTE3>(output);
        DataCopyExtParams op{(uint16_t)vm, (uint32_t)(rn * 2), 0, (uint32_t)((N - rn) * 2), 0};
        DataCopyPad(yy[(start + mi) * (int64_t)N + col], o, op);
        auto done = pipe.FetchEventID(HardEvent::MTE3_V);
        SetFlag<HardEvent::MTE3_V>(done);
        WaitFlag<HardEvent::MTE3_V>(done);
      }
      base += tiles;
      start = end;
    }
  }
}

template <int BM, int BN, int KC> class DirectInt8PhaseManual {
  TBuf<TPosition::A1> a1b;
  TBuf<TPosition::B1> b1b;
  TBuf<TPosition::A2> a2b;
  TBuf<TPosition::B2> b2b;
  TBuf<TPosition::CO1> c1b;
  TPipe *pipe;
  int serial = 0, kidx = 0;
  TEventID l1Free[2], bReady[2], l0Free[2], cFree;

public:
  __aicore__ inline void Init(TPipe &p) {
    pipe = &p;
    p.InitBuffer(a1b, BM * 2048);
    p.InitBuffer(b1b, 2 * KC * BN);
    p.InitBuffer(a2b, 2 * BM * KC);
    p.InitBuffer(b2b, 2 * KC * BN);
    p.InitBuffer(c1b, BM * BN * 4);
    for (int i = 0; i < 2; ++i) {
      l1Free[i] = p.AllocEventID<HardEvent::MTE1_MTE2>();
      bReady[i] = p.AllocEventID<HardEvent::MTE2_MTE1>();
    }
    for (int i = 0; i < 2; ++i)
      l0Free[i] = p.AllocEventID<HardEvent::M_MTE1>();
    cFree = p.AllocEventID<HardEvent::FIX_M>();
  }
  __aicore__ inline void LoadA(GlobalTensor<int8_t> a, int K, int rm, int strideK) {
    auto a1 = a1b.template Get<int8_t>();
    Nd2NzParams ap;
    ap.ndNum = 1;
    ap.nValue = rm;
    ap.dValue = K;
    ap.srcDValue = strideK;
    ap.srcNdMatrixStride = 0;
    ap.dstNzC0Stride = BM;
    ap.dstNzNStride = 1;
    ap.dstNzMatrixStride = 0;
    auto aConsumed = pipe->FetchEventID(HardEvent::MTE1_MTE2);
    SetFlag<HardEvent::MTE1_MTE2>(aConsumed);
    WaitFlag<HardEvent::MTE1_MTE2>(aConsumed);
                                                                          
                                                                          
    if (rm % 32 || K % 32) {
      InitConstValueParams<int8_t> zero;
      zero.repeatTimes = 1;
      zero.blockNum = BM * ((K + 31) / 32);
      zero.dstGap = 0;
      zero.initValue = 0;
      InitConstValue(a1, zero);
      PipeBarrier<PIPE_MTE2>();
    }
    DataCopy(a1, a, ap);
    auto aReady = pipe->FetchEventID(HardEvent::MTE2_MTE1);
    SetFlag<HardEvent::MTE2_MTE1>(aReady);
    WaitFlag<HardEvent::MTE2_MTE1>(aReady);
  }
  __aicore__ inline void Tile(GlobalTensor<int8_t> b, GlobalTensor<int32_t> c, int K, int N, int rm,
                              int rn, int outStride) {
    auto a1 = a1b.template Get<int8_t>();
    auto c1 = c1b.template Get<int32_t>();
    int na = (rn + 31) / 32 * 32;
    for (int done = 0; done < K; done += KC) {
      int rk = K - done;
      if (rk > KC)
        rk = KC;
      int kp = (rk + 31) / 32 * 32;
      int s = kidx % 2;
      auto a2 = a2b.template Get<int8_t>()[s * BM * KC];
      auto b2 = b2b.template Get<int8_t>()[s * KC * BN];
      auto b1 = b1b.template Get<int8_t>()[s * KC * BN];
      if (kidx >= 2)
        WaitFlag<HardEvent::MTE1_MTE2>(l1Free[s]);
      Nd2NzParams bp;
      bp.ndNum = 1;
      bp.nValue = rk;
      bp.dValue = rn;
      bp.srcDValue = N;
      bp.srcNdMatrixStride = 0;
      bp.dstNzC0Stride = KC;
      bp.dstNzNStride = 1;
      bp.dstNzMatrixStride = 0;
      if (kp != rk) {
        InitConstValueParams<uint16_t> zero;
        zero.repeatTimes = (rn + 31) / 32;
        zero.blockNum = kp - rk;
        zero.dstGap = KC - (kp - rk);
        zero.initValue = 0;
        InitConstValue(b1.template ReinterpretCast<uint16_t>()[rk * 16], zero);
        PipeBarrier<PIPE_MTE2>();
      }
      DataCopy(b1, b[done * (int64_t)N], bp);
      SetFlag<HardEvent::MTE2_MTE1>(bReady[s]);
      if (kidx >= 2)
        WaitFlag<HardEvent::M_MTE1>(l0Free[s]);
      WaitFlag<HardEvent::MTE2_MTE1>(bReady[s]);
      LoadData2dTransposeParams bl;
      bl.startIndex = 0;
      bl.dstFracGap = 0;
      int nblocks = (rn + 31) / 32;
      if (nblocks < kp / 32) {
        bl.repeatTimes = kp / 32;
        bl.srcStride = 1;
        bl.dstGap = na / 16 - 1;
        for (int i = 0; i < nblocks; ++i)
          LoadDataWithTranspose(b2[i * 1024], b1[i * KC * 32], bl);
      } else {
        bl.repeatTimes = nblocks;
        bl.srcStride = KC / 32;
        bl.dstGap = 1;
        for (int i = 0; i < kp / 32; ++i)
          LoadDataWithTranspose(b2[i * na * 32], b1[i * 1024], bl);
      }
      LoadData2DParams al;
      al.startIndex = 0;
      al.ifTranspose = false;
      int mblocks = ((rm + 31) / 32) * 2, kblocks = kp / 32;
      if (kblocks < mblocks) {
        al.repeatTimes = mblocks;
        al.srcStride = 1;
        al.dstGap = kblocks - 1;
        for (int i = 0; i < kblocks; ++i)
          LoadData(a2[i * 512], a1[(done / 32 + i) * (BM * 32)], al);
      } else {
        al.repeatTimes = kblocks;
        al.srcStride = BM / 16;
        al.dstGap = 0;
        for (int i = 0; i < mblocks; ++i)
          LoadData(a2[i * kp * 16], a1[i * 512 + (done / 32) * (BM * 32)], al);
      }
      SetFlag<HardEvent::MTE1_MTE2>(l1Free[s]);
      auto mr = pipe->FetchEventID(HardEvent::MTE1_M);
      SetFlag<HardEvent::MTE1_M>(mr);
      WaitFlag<HardEvent::MTE1_M>(mr);
      MmadParams mp;
      mp.m = (rm + 31) / 32 * 32;
      mp.n = na;
      mp.k = kp;
      mp.cmatrixInitVal = (done == 0);
      if (done == 0 && serial >= 1)
        WaitFlag<HardEvent::FIX_M>(cFree);
      Mmad(c1, a2, b2, mp);
      PipeBarrier<PIPE_M>();
      SetFlag<HardEvent::M_MTE1>(l0Free[s]);
      ++kidx;
    }
    auto doneEv = pipe->FetchEventID(HardEvent::M_FIX);
    SetFlag<HardEvent::M_FIX>(doneEv);
    WaitFlag<HardEvent::M_FIX>(doneEv);
    FixpipeParamsV220 fp;
    fp.mSize = rm;
    fp.nSize = na;
    fp.srcStride = (rm + 31) / 32 * 32;
    fp.dstStride = outStride;
    fp.quantPre = QuantMode_t::NoQuant;
    fp.deqScalar = 0;
    SetAtomicAdd<int32_t>();
    Fixpipe<int32_t, int32_t, CFG_ROW_MAJOR>(c, c1, fp);
    SetAtomicNone();
    SetFlag<HardEvent::FIX_M>(cFree);
    ++serial;
  }
  __aicore__ inline void End() {
    for (int i = 0; i < 2 && i < kidx; ++i)
      WaitFlag<HardEvent::MTE1_MTE2>(l1Free[i]);
    for (int i = 0; i < 2 && i < kidx; ++i)
      WaitFlag<HardEvent::M_MTE1>(l0Free[i]);
    if (serial)
      WaitFlag<HardEvent::FIX_M>(cFree);
    for (int i = 0; i < 2; ++i) {
      pipe->ReleaseEventID<HardEvent::MTE1_MTE2>(l1Free[i]);
      pipe->ReleaseEventID<HardEvent::MTE2_MTE1>(bReady[i]);
    }
    for (int i = 0; i < 2; ++i)
      pipe->ReleaseEventID<HardEvent::M_MTE1>(l0Free[i]);
    pipe->ReleaseEventID<HardEvent::FIX_M>(cFree);
    PipeBarrier<PIPE_ALL>();
  }
};

__global__ __mix__(1, 2) __attribute__((section(".night_phase"))) void phase_manual_packed(
    GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR g, GM_ADDR y, GM_ADDR work, GM_ADDR packedWeight,
    GM_ADDR packedX, int M, int N, int K, int KP, int E, int NP, int chunks, int chunkK, int cores,
    TCubeTiling td) {
  constexpr int BM = 128, BN = 256, VM = 16;
  TPipe pipe;
  DirectInt8PhaseManual<BM, BN, 128> mm;
  TBuf<TPosition::VECIN> cb, sb;
  TBuf<TPosition::VECCALC> ab, zb, tb, ub;
  TBuf<TPosition::VECOUT> ob;
  if ASCEND_IS_AIC {
    mm.Init(pipe);
  }
  if ASCEND_IS_AIV {
    pipe.InitBuffer(cb, 32 * BN * 4);
    pipe.InitBuffer(sb, BN * 4);
    pipe.InitBuffer(ab, VM * BN * 4);
    pipe.InitBuffer(zb, VM * BN * 4);
    pipe.InitBuffer(tb, VM * BN * 4);
    pipe.InitBuffer(ub, VM * BN * 4);
    pipe.InitBuffer(ob, VM * BN * 2);
  }
  GlobalTensor<int8_t> xx, ww;
  GlobalTensor<float> ss;
  GlobalTensor<int64_t> gg;
  GlobalTensor<half> yy;
  GlobalTensor<int32_t> cc;
  xx.SetGlobalBuffer((__gm__ int8_t *)packedX);
  ww.SetGlobalBuffer((__gm__ int8_t *)packedWeight);
  ss.SetGlobalBuffer((__gm__ float *)s);
  gg.SetGlobalBuffer((__gm__ int64_t *)g);
  yy.SetGlobalBuffer((__gm__ half *)y);
  cc.SetGlobalBuffer((__gm__ int32_t *)work);
  if ASCEND_IS_AIV {
    PackWeightsWithKAlignment<BN>(w, packedWeight, g, E, K, KP, N, NP, pipe, cb.Get<int8_t>());
    auto packed = pipe.FetchEventID(HardEvent::MTE3_V);
    SetFlag<HardEvent::MTE3_V>(packed);
    WaitFlag<HardEvent::MTE3_V>(packed);
    PackXWithKAlignment<BN>(x, packedX, M, K, KP, pipe, cb.Get<int8_t>());
                                                                                    
    auto zeroFree = pipe.FetchEventID(HardEvent::MTE3_V);
    SetFlag<HardEvent::MTE3_V>(zeroFree);
    WaitFlag<HardEvent::MTE3_V>(zeroFree);
    auto zero = cb.Get<int32_t>();
    constexpr int ZC = 32 * BN;
    Duplicate(zero, int32_t(0), ZC);
    PipeBarrier<PIPE_V>();
    auto zeroReady = pipe.FetchEventID(HardEvent::V_MTE3);
    SetFlag<HardEvent::V_MTE3>(zeroReady);
    WaitFlag<HardEvent::V_MTE3>(zeroReady);
    int64_t total = (int64_t)M * NP;
    int workers = GetBlockNum() * 2, id = GetBlockIdx();
    for (int64_t pos = (int64_t)id * ZC; pos < total; pos += (int64_t)workers * ZC) {
      int count = (int)(total - pos);
      if (count > ZC)
        count = ZC;
      DataCopy(cc[pos], zero, count);
    }
    auto zeroDone = pipe.FetchEventID(HardEvent::MTE3_MTE2);
    SetFlag<HardEvent::MTE3_MTE2>(zeroDone);
    WaitFlag<HardEvent::MTE3_MTE2>(zeroDone);
  }
  SyncAll<false>();
  if ASCEND_IS_AIC {
    int base = 0, bid = GetBlockIdx();
    for (int phase = 0; phase < 2; ++phase) {
      int start = 0, nt = phase == 0 ? N / BN : ((N % BN) != 0 ? 1 : 0);
      if (nt == 0)
        continue;
      for (int e = 0; e < E; ++e) {
        int end = (int)gg.GetValue(e), rows = end - start, mt = (rows + BM - 1) / BM,
            tasks = mt * nt * chunks;
        int local = (bid - base % cores + cores) % cores;
        for (int task = local; task < tasks; task += cores) {
          int ki = task % chunks, tile = task / chunks, mi = tile / nt * BM,
              ni = (phase == 0 ? tile % nt : N / BN) * BN;
          int rm = rows - mi;
          if (rm > BM)
            rm = BM;
          int rn = N - ni;
          if (rn > BN)
            rn = BN;
          int kk = ki * chunkK, rk = KP - kk;
          if (rk > chunkK)
            rk = chunkK;
          mm.LoadA(xx[(start + mi) * (int64_t)KP + kk], rk, rm, KP);
          mm.Tile(ww[e * (int64_t)KP * NP + kk * (int64_t)NP + ni],
                  cc[((int64_t)start + mi) * NP + ni], rk, NP, rm, rn, NP);
        }
        base += tasks;
        start = end;
      }
    }
    mm.End();
    auto committed = pipe.FetchEventID(HardEvent::FIX_MTE2);
    SetFlag<HardEvent::FIX_MTE2>(committed);
    WaitFlag<HardEvent::FIX_MTE2>(committed);
  }
  SyncAll<false>();
  if ASCEND_IS_AIV {
    auto part = cb.Get<int32_t>();
    auto scale = sb.Get<float>();
    auto acc = ab.Get<int32_t>();
    auto z = zb.Get<float>();
    auto t = tb.Get<float>();
    auto u = ub.Get<float>();
    auto o = ob.Get<half>();
    int nt = (N + BN - 1) / BN, vcores = GetBlockNum() * 2, vid = GetBlockIdx(), base = 0,
        start = 0;
    for (int e = 0; e < E; ++e) {
      int end = (int)gg.GetValue(e), rows = end - start, tiles = (rows + VM - 1) / VM * nt;
      int first = (vid - base % vcores + vcores) % vcores;
      for (int task = first; task < tiles; task += vcores) {
        int mi = task / nt * VM, col = task % nt * BN, vm = rows - mi, rn = N - col;
        if (vm > VM)
          vm = VM;
        if (rn > BN)
          rn = BN;
        int stride = (rn + 15) / 16 * 16, count = vm * stride;
        auto reuse = pipe.FetchEventID(HardEvent::V_MTE2);
        SetFlag<HardEvent::V_MTE2>(reuse);
        WaitFlag<HardEvent::V_MTE2>(reuse);
        DataCopyExtParams cp{(uint16_t)vm, (uint32_t)(rn * 4), (uint32_t)((NP - rn) * 4),
                             (uint32_t)((stride - (rn + 7) / 8 * 8) / 8), 0};
        DataCopyPadExtParams<int32_t> ip{true, 0, 0, 0};
        DataCopyPad(acc, cc[((int64_t)start + mi) * NP + col], cp, ip);
        auto ready = pipe.FetchEventID(HardEvent::MTE2_V);
        SetFlag<HardEvent::MTE2_V>(ready);
        WaitFlag<HardEvent::MTE2_V>(ready);
        DataCopyExtParams sp{1, (uint32_t)(rn * 4), 0, 0, 0};
        DataCopyPadExtParams<float> fp{true, 0, 0, 0};
        DataCopyPad(scale, ss[e * (int64_t)N + col], sp, fp);
        auto scaleReady = pipe.FetchEventID(HardEvent::MTE2_V);
        SetFlag<HardEvent::MTE2_V>(scaleReady);
        WaitFlag<HardEvent::MTE2_V>(scaleReady);
        Cast(z, acc, RoundMode::CAST_NONE, count);
        PipeBarrier<PIPE_V>();
        for (int c = 0; c < stride; c += 64) {
          uint64_t mask = (stride - c < 64 ? stride - c : 64);
          Mul(z[c], z[c], scale[c], mask, (uint8_t)vm,
              {1, 1, 1, (uint8_t)(stride / 8), (uint8_t)(stride / 8), 0});
        }
        PipeBarrier<PIPE_V>();
        Mul(t, z, z, count);
        PipeBarrier<PIPE_V>();
        Muls(t, t, 0.044715f, count);
        PipeBarrier<PIPE_V>();
        Adds(t, t, 1.0f, count);
        PipeBarrier<PIPE_V>();
        Mul(t, t, z, count);
        PipeBarrier<PIPE_V>();
        Muls(t, t, -1.5957691216057308f, count);
        PipeBarrier<PIPE_V>();
        Mins(t, t, 80.0f, count);
        PipeBarrier<PIPE_V>();
        Maxs(t, t, -80.0f, count);
        PipeBarrier<PIPE_V>();
        Exp(t, t, count);
        PipeBarrier<PIPE_V>();
        Adds(t, t, 1.0f, count);
        PipeBarrier<PIPE_V>();
        Div(u, z, t, count);
        PipeBarrier<PIPE_V>();
        Cast(o, u, RoundMode::CAST_RINT, count);
        PipeBarrier<PIPE_V>();
        auto output = pipe.FetchEventID(HardEvent::V_MTE3);
        SetFlag<HardEvent::V_MTE3>(output);
        WaitFlag<HardEvent::V_MTE3>(output);
        DataCopyExtParams op{(uint16_t)vm, (uint32_t)(rn * 2), 0, (uint32_t)((N - rn) * 2), 0};
        DataCopyPad(yy[(start + mi) * (int64_t)N + col], o, op);
        auto done = pipe.FetchEventID(HardEvent::MTE3_V);
        SetFlag<HardEvent::MTE3_V>(done);
        WaitFlag<HardEvent::MTE3_V>(done);
      }
      base += tiles;
      start = end;
    }
  }
}

__global__ __mix__(1, 2) void grouped_matmul_gelu_packed_phase_split(
    GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR g, GM_ADDR y, GM_ADDR work, GM_ADDR packedWeight,
    GM_ADDR packedX, int M, int N, int K, int KP, int E, int NP, int chunks, int chunkK, int cores,
    TCubeTiling td) {
  constexpr int BM = 128, BN = 256, VM = 16;
  TPipe pipe;
  matmul::MatmulImpl<AT, BType, CT, BIAS, CFG_MDL> mm;
  TBuf<TPosition::VECIN> cb, sb;
  TBuf<TPosition::VECCALC> ab, zb, tb, ub;
  TBuf<TPosition::VECOUT> ob;
  if ASCEND_IS_AIC {
    mm.SetSubBlockIdx(0);
    mm.Init(&td, &pipe);
    mm.SetOrgShape(M, NP, KP, KP, NP);
  }
  if ASCEND_IS_AIV {
    pipe.InitBuffer(cb, 32 * BN * 4);
    pipe.InitBuffer(sb, BN * 4);
    pipe.InitBuffer(ab, VM * BN * 4);
    pipe.InitBuffer(zb, VM * BN * 4);
    pipe.InitBuffer(tb, VM * BN * 4);
    pipe.InitBuffer(ub, VM * BN * 4);
    pipe.InitBuffer(ob, VM * BN * 2);
  }
  GlobalTensor<int8_t> xx, ww;
  GlobalTensor<float> ss;
  GlobalTensor<int64_t> gg;
  GlobalTensor<half> yy;
  GlobalTensor<int32_t> cc;
  xx.SetGlobalBuffer((__gm__ int8_t *)packedX);
  ww.SetGlobalBuffer((__gm__ int8_t *)packedWeight);
  ss.SetGlobalBuffer((__gm__ float *)s);
  gg.SetGlobalBuffer((__gm__ int64_t *)g);
  yy.SetGlobalBuffer((__gm__ half *)y);
  cc.SetGlobalBuffer((__gm__ int32_t *)work);
  if ASCEND_IS_AIV {
    PackWeightsWithKAlignment<BN>(w, packedWeight, g, E, K, KP, N, NP, pipe, cb.Get<int8_t>());
    auto packed = pipe.FetchEventID(HardEvent::MTE3_V);
    SetFlag<HardEvent::MTE3_V>(packed);
    WaitFlag<HardEvent::MTE3_V>(packed);
    PackXWithKAlignment<BN>(x, packedX, M, K, KP, pipe, cb.Get<int8_t>());
                                                                                    
    auto zeroFree = pipe.FetchEventID(HardEvent::MTE3_V);
    SetFlag<HardEvent::MTE3_V>(zeroFree);
    WaitFlag<HardEvent::MTE3_V>(zeroFree);
    auto zero = cb.Get<int32_t>();
    constexpr int ZC = 32 * BN;
    Duplicate(zero, int32_t(0), ZC);
    PipeBarrier<PIPE_V>();
    auto zeroReady = pipe.FetchEventID(HardEvent::V_MTE3);
    SetFlag<HardEvent::V_MTE3>(zeroReady);
    WaitFlag<HardEvent::V_MTE3>(zeroReady);
    int64_t total = (int64_t)M * NP;
    int workers = GetBlockNum() * 2, id = GetBlockIdx();
    for (int64_t pos = (int64_t)id * ZC; pos < total; pos += (int64_t)workers * ZC) {
      int count = (int)(total - pos);
      if (count > ZC)
        count = ZC;
      DataCopy(cc[pos], zero, count);
    }
    auto zeroDone = pipe.FetchEventID(HardEvent::MTE3_MTE2);
    SetFlag<HardEvent::MTE3_MTE2>(zeroDone);
    WaitFlag<HardEvent::MTE3_MTE2>(zeroDone);
  }
  SyncAll<false>();
  if ASCEND_IS_AIC {
    int base = 0, bid = GetBlockIdx();
    for (int phase = 0; phase < 2; ++phase) {
      int start = 0, nt = phase == 0 ? N / BN : ((N % BN) != 0 ? 1 : 0);
      if (nt == 0)
        continue;
      for (int e = 0; e < E; ++e) {
        int end = (int)gg.GetValue(e), rows = end - start, mt = (rows + BM - 1) / BM,
            tasks = mt * nt * chunks;
        int local = (bid - base % cores + cores) % cores;
        for (int task = local; task < tasks; task += cores) {
          int ki = task % chunks, tile = task / chunks, mi = tile / nt * BM,
              ni = (phase == 0 ? tile % nt : N / BN) * BN;
          int rm = rows - mi;
          if (rm > BM)
            rm = BM;
          int rn = N - ni;
          if (rn > BN)
            rn = BN;
          int kk = ki * chunkK, rk = KP - kk;
          if (rk > chunkK)
            rk = chunkK;
          mm.SetSingleShape(rm, (rn + 31) / 32 * 32, rk);
          mm.SetTensorA(xx[(start + mi) * (int64_t)KP + kk]);
          mm.SetTensorB(ww[e * (int64_t)KP * NP + kk * (int64_t)NP + ni]);
          int64_t offset = ((int64_t)start + mi) * NP + ni;
          while (mm.Iterate()) {
            mm.GetTensorC(cc[offset], 1, false);
          }
        }
        base += tasks;
        start = end;
      }
    }
    mm.End();
    auto committed = pipe.FetchEventID(HardEvent::FIX_MTE2);
    SetFlag<HardEvent::FIX_MTE2>(committed);
    WaitFlag<HardEvent::FIX_MTE2>(committed);
  }
  SyncAll<false>();
  if ASCEND_IS_AIV {
    auto part = cb.Get<int32_t>();
    auto scale = sb.Get<float>();
    auto acc = ab.Get<int32_t>();
    auto z = zb.Get<float>();
    auto t = tb.Get<float>();
    auto u = ub.Get<float>();
    auto o = ob.Get<half>();
    int nt = (N + BN - 1) / BN, vcores = GetBlockNum() * 2, vid = GetBlockIdx(), base = 0,
        start = 0;
    for (int e = 0; e < E; ++e) {
      int end = (int)gg.GetValue(e), rows = end - start, tiles = (rows + VM - 1) / VM * nt;
      int first = (vid - base % vcores + vcores) % vcores;
      for (int task = first; task < tiles; task += vcores) {
        int mi = task / nt * VM, col = task % nt * BN, vm = rows - mi, rn = N - col;
        if (vm > VM)
          vm = VM;
        if (rn > BN)
          rn = BN;
        int stride = (rn + 15) / 16 * 16, count = vm * stride;
        auto reuse = pipe.FetchEventID(HardEvent::V_MTE2);
        SetFlag<HardEvent::V_MTE2>(reuse);
        WaitFlag<HardEvent::V_MTE2>(reuse);
        DataCopyExtParams cp{(uint16_t)vm, (uint32_t)(rn * 4), (uint32_t)((NP - rn) * 4),
                             (uint32_t)((stride - (rn + 7) / 8 * 8) / 8), 0};
        DataCopyPadExtParams<int32_t> ip{true, 0, 0, 0};
        DataCopyPad(acc, cc[((int64_t)start + mi) * NP + col], cp, ip);
        auto ready = pipe.FetchEventID(HardEvent::MTE2_V);
        SetFlag<HardEvent::MTE2_V>(ready);
        WaitFlag<HardEvent::MTE2_V>(ready);
        DataCopyExtParams sp{1, (uint32_t)(rn * 4), 0, 0, 0};
        DataCopyPadExtParams<float> fp{true, 0, 0, 0};
        DataCopyPad(scale, ss[e * (int64_t)N + col], sp, fp);
        auto scaleReady = pipe.FetchEventID(HardEvent::MTE2_V);
        SetFlag<HardEvent::MTE2_V>(scaleReady);
        WaitFlag<HardEvent::MTE2_V>(scaleReady);
        Cast(z, acc, RoundMode::CAST_NONE, count);
        PipeBarrier<PIPE_V>();
        for (int c = 0; c < stride; c += 64) {
          uint64_t mask = (stride - c < 64 ? stride - c : 64);
          Mul(z[c], z[c], scale[c], mask, (uint8_t)vm,
              {1, 1, 1, (uint8_t)(stride / 8), (uint8_t)(stride / 8), 0});
        }
        PipeBarrier<PIPE_V>();
        Mul(t, z, z, count);
        PipeBarrier<PIPE_V>();
        Muls(t, t, 0.044715f, count);
        PipeBarrier<PIPE_V>();
        Adds(t, t, 1.0f, count);
        PipeBarrier<PIPE_V>();
        Mul(t, t, z, count);
        PipeBarrier<PIPE_V>();
        Muls(t, t, -1.5957691216057308f, count);
        PipeBarrier<PIPE_V>();
        Mins(t, t, 80.0f, count);
        PipeBarrier<PIPE_V>();
        Maxs(t, t, -80.0f, count);
        PipeBarrier<PIPE_V>();
        Exp(t, t, count);
        PipeBarrier<PIPE_V>();
        Adds(t, t, 1.0f, count);
        PipeBarrier<PIPE_V>();
        Div(u, z, t, count);
        PipeBarrier<PIPE_V>();
        Cast(o, u, RoundMode::CAST_RINT, count);
        PipeBarrier<PIPE_V>();
        auto output = pipe.FetchEventID(HardEvent::V_MTE3);
        SetFlag<HardEvent::V_MTE3>(output);
        WaitFlag<HardEvent::V_MTE3>(output);
        DataCopyExtParams op{(uint16_t)vm, (uint32_t)(rn * 2), 0, (uint32_t)((N - rn) * 2), 0};
        DataCopyPad(yy[(start + mi) * (int64_t)N + col], o, op);
        auto done = pipe.FetchEventID(HardEvent::MTE3_V);
        SetFlag<HardEvent::MTE3_V>(done);
        WaitFlag<HardEvent::MTE3_V>(done);
      }
      base += tiles;
      start = end;
    }
  }
}

static void run_packed_phase_split(GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR g, GM_ADDR y, int M,
                                   int N, int NP, int K, int KP, int E, int cores, int targetParts,
                                   aclrtStream stream) {
  int chunkK = ((KP + targetParts - 1) / targetParts + 31) / 32 * 32,
      chunks = (KP + chunkK - 1) / chunkK;
  auto plat = platform_ascendc::PlatformAscendCManager::GetInstance();
  matmul_tiling::MatmulApiTiling tiler(*plat);
  tiler.SetAType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
                 matmul_tiling::DataType::DT_INT8);
  tiler.SetBType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
                 matmul_tiling::DataType::DT_INT8);
  tiler.SetCType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
                 matmul_tiling::DataType::DT_INT32);
  tiler.SetShape(128, 256, chunkK);
  tiler.SetOrgShape(M, NP, KP);
  tiler.SetFixSplit(128, 256, 128);
  tiler.SetBias(false);
  tiler.SetBufferSpace(-1, -1, -1);
  TCubeTiling td;
  tiler.GetTiling(td);
  td.stepKa = 4;
  td.stepKb = 4;
  td.depthA1 = 8;
  td.depthB1 = 8;
  td.shareL1Size = (128 + 256) * td.baseK * 8;
  uint64_t partialBytes = (uint64_t)M * NP * 4, weightBytes = (uint64_t)E * KP * NP,
           xBytes = (uint64_t)M * KP;
  void *work = nullptr;
  aclrtMalloc(&work, partialBytes + weightBytes + xBytes, ACL_MEM_MALLOC_HUGE_FIRST);
  if (chunkK <= 2048 && N <= 2048) {
    phase_nz_aicpack<<<cores, nullptr, stream>>>(
        x, w, s, g, y, (GM_ADDR)work, (GM_ADDR)((uint8_t *)work + partialBytes),
        (GM_ADDR)((uint8_t *)work + partialBytes + weightBytes), M, N, K, KP, E, NP, chunks, chunkK,
        cores, td);
  } else {
    grouped_matmul_gelu_packed_phase_split<<<cores, nullptr, stream>>>(
        x, w, s, g, y, (GM_ADDR)work, (GM_ADDR)((uint8_t *)work + partialBytes),
        (GM_ADDR)((uint8_t *)work + partialBytes + weightBytes), M, N, K, KP, E, NP, chunks, chunkK,
        cores, td);
  }
  aclrtSynchronizeStream(stream);
  aclrtFree(work);
}

static __attribute__((noinline)) bool TryLowuRaw(GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR g,
                                                 GM_ADDR y, int M, int N, int K, int E,
                                                 int64_t availableCoreNum, aclrtStream stream);
static __attribute__((noinline)) void RunHdNative42(GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR g,
                                                    GM_ADDR y, int M, int N, int K, int E,
                                                    int cores, aclrtStream stream);
static __attribute__((noinline)) void
LaunchNightPackedStatic(GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR g, GM_ADDR y, GM_ADDR work,
                        GM_ADDR packedWeight, GM_ADDR packedX, int M, int N, int NP, int K, int KP,
                        int E, int cores, TCubeTiling td, aclrtStream stream);

static __attribute__((noinline)) void RunShortDotBatched(GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR g,
                                                         GM_ADDR y, int M, int N, int K, int E,
                                                         int cores, aclrtStream stream);

static __attribute__((noinline)) void RunRankOneCurrentLookup(GM_ADDR x, GM_ADDR w, GM_ADDR s,
                                                              GM_ADDR g, GM_ADDR y, int M, int N,
                                                              int E, int cores, aclrtStream stream);

static __attribute__((noinline)) void LaunchNarrowResident32(GM_ADDR x, GM_ADDR w, GM_ADDR s,
                                                             GM_ADDR g, GM_ADDR y, int M, int N,
                                                             int K, int E, int cores,
                                                             aclrtStream stream);

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo &ix, GM_ADDR w,
                           const TensorGroupInfo &iw, GM_ADDR s, const TensorGroupInfo &is,
                           GM_ADDR g, const TensorGroupInfo &ig, GM_ADDR y,
                           const TensorGroupInfo &iy, int64_t availableCoreNum,
                           aclrtStream stream) {
  int M = ix.tensors[0].shape[0], K = ix.tensors[0].shape[1], E = iw.tensors[0].shape[0],
      N = iw.tensors[0].shape[2];
                                                                       
  int activeUpper = M < E ? M : E;
  int64_t tileUpper = (activeUpper + (M - activeUpper) / 128) * (int64_t)((N + 255) / 256);
  if (K > 2048 && N >= 256 && tileUpper * 2 <= availableCoreNum) {
    int parts = 1;
    while (parts * 2 <= 8 && parts * 2 <= availableCoreNum / tileUpper && parts * 2 <= K / 512)
      parts *= 2;
    run_occupancy_splitk_kernel(x, w, s, g, y, M, N, K, E, availableCoreNum, parts, stream);
    return;
  }
  if (N >= 2 && N <= 16 && K > 256 && M <= 2 * availableCoreNum) {
    int blocks = M;
    if (blocks < availableCoreNum)
      blocks = availableCoreNum;
    grouped_matmul_gelu_narrow_gather<<<blocks, nullptr, stream>>>(x, w, s, g, y, M, N, K, E);
    return;
  }
  if (N == 1 && K > 64 && M <= 8 * availableCoreNum) {
    int blocks = M;
    if (blocks > 2 * availableCoreNum)
      blocks = 2 * availableCoreNum;
    if (blocks < availableCoreNum)
      blocks = availableCoreNum;
    grouped_matmul_gelu_gemv_n1<<<blocks, nullptr, stream>>>(x, w, s, g, y, M, K, E);
    return;
  }
  int treeN = K <= 128 ? 128 : 64;
  if (K > 64 && K <= 256 && (int64_t)M * ((N + treeN - 1) / treeN) <= 2 * availableCoreNum) {
    run_ktree_kernel(x, ix, w, iw, s, is, g, ig, y, iy, availableCoreNum, stream);
    return;
  }
                                                                          
                                                                          
                                                                              
                                                                                
  int lookupStride = (N + 15) / 16 * 16;
  uint64_t lookupBytes = (uint64_t)E * 256 * lookupStride * sizeof(half);
  if (K == 1 && N >= 256 && M >= 512LL * E &&
      ((int64_t)M * N > 262144 || (int64_t)M * ((N + 511) / 512) > 4096) &&
      lookupBytes <= 64ULL * 1024 * 1024) {
    RunRankOneCurrentLookup(x, w, s, g, y, M, N, E, (int)availableCoreNum, stream);
    return;
  }
                                                                           
                                                                             
  if (K <= 4 && ((int64_t)M * N > 262144 || (int64_t)M * K * ((N + 511) / 512) > 4096)) {
    RunShortDotBatched(x, w, s, g, y, M, N, K, E, (int)availableCoreNum, stream);
    return;
  }
  if (K <= 64 && (int64_t)M * N <= 262144 && (int64_t)M * K * ((N + 511) / 512) <= 4096) {
    run_small_kernel(x, ix, w, iw, s, is, g, ig, y, iy, availableCoreNum, stream);
    return;
  }
  if (TryLowuRaw(x, w, s, g, y, M, N, K, E, availableCoreNum, stream))
    return;
                                                                          
  if (K > 64 && K <= 256 && N >= 32 && N <= 256 && M >= 32 && (int64_t)M * N <= 32768 && E <= 16 &&
      E + (M - E + 15) / 16 <= availableCoreNum) {
    int upper = E + (M - E + 16 - 1) / 16;
    if (upper < 1)
      upper = 1;
    int blocks = upper;
    if (blocks > availableCoreNum)
      blocks = (int)availableCoreNum;
    int floor = (int)(availableCoreNum + 4) / 5;
    if (blocks < floor)
      blocks = floor;
    if (blocks < 1)
      blocks = 1;
    void *work = nullptr;
    aclrtMalloc(&work, (uint64_t)blocks * 4 * 16 * 256 * 4, ACL_MEM_MALLOC_HUGE_FIRST);
    grouped_matmul_gelu_direct_stream<16, 256>
        <<<blocks, nullptr, stream>>>(x, w, s, g, y, (GM_ADDR)work, M, N, K, E, blocks);
    aclrtSynchronizeStream(stream);
    aclrtFree(work);
    return;
  }
                                                                                 
  int nonemptyUpper = E < M ? E : M;
  int64_t shortTaskUpper = (nonemptyUpper + (M - nonemptyUpper) / 64) * (int64_t)((N + 255) / 256);
  if (K >= 32 && K <= 256 && N >= 32 &&
      (K % 32 == 0 || shortTaskUpper <= 2 * (availableCoreNum > 0 ? availableCoreNum : 1))) {
    int blocks = (int)availableCoreNum;
    if (blocks < 1)
      blocks = 1;
    void *work = nullptr;
    aclrtMalloc(&work, (uint64_t)blocks * 4 * 64 * 256 * 4, ACL_MEM_MALLOC_HUGE_FIRST);
    if (E >= 2 * availableCoreNum && M <= 128 * E)
      grouped_matmul_gelu_direct_rowgrid<64, 256>
          <<<blocks, nullptr, stream>>>(x, w, s, g, y, (GM_ADDR)work, M, N, K, E, blocks);
    else
      grouped_matmul_gelu_direct_stream<64, 256>
          <<<blocks, nullptr, stream>>>(x, w, s, g, y, (GM_ADDR)work, M, N, K, E, blocks);
    aclrtSynchronizeStream(stream);
    aclrtFree(work);
    return;
  }
  bool wide = (K <= 2048 && M <= 64 * E &&
               ((N >= 1024 && N % 512 == 0) ||
                (K <= 1024 && N >= 384 && (N % 512 == 0 || N % 512 >= 256))));
  int paddedN = (N + 255) / 256 * 256, widePaddedN = (N + 511) / 512 * 512;
  wide = wide || (K >= 128 && K <= 2048 && N > 512 && N % 512 != 0 && M >= 32 * E && M <= 128 * E &&
                  (widePaddedN - N) * 8 <= N);
  bool packWide =
      wide && N > 512 && N % 512 != 0 && K >= 128 && M >= 32 * E && (widePaddedN - N) * 8 <= N;
                                                                     
                                                                        
  if (TryContiguousResident(x, w, s, g, y, M, N, K, E, availableCoreNum, wide, stream))
    return;
                                                                         
                                                                            
                                                                              
  if (!wide && (N % 32 != 0 || K % 32 != 0) && N % 256 != 0 && K >= 512 && K <= 2048 &&
      M >= 256LL * E && E <= 64 && N >= 256 && ((N + 255) / 256) * 256 <= 2048 &&
      (((N + 255) / 256 * 256 - N) * 2 <= N) && ((K + 127) / 128 * 128 - K) * 16 <= K) {
    RunHdNative42(x, w, s, g, y, M, N, K, E, (int)availableCoreNum, stream);
    return;
  }
  if (TryResidentTail(x, w, s, g, y, M, N, K, E, availableCoreNum, wide, stream))
    return;
  bool strideAligned = (N % 32 == 0 && K % 32 == 0);
  bool pack = packWide || (!wide && !strideAligned && N % 256 != 0 && N >= 128 && K >= 128 &&
                           (M >= 128 * E || (M >= 32 * E && (paddedN - N) * 8 <= N)));
                                                                      
                                                                         
                                                                           
                                                                
                                                                            
  if (N < 32 && K >= 512 && K <= 4096 && M >= 256LL * E) {
    int cores = (int)availableCoreNum;
    if (cores < 1)
      cores = 1;
    LaunchNarrowResident32(x, w, s, g, y, M, N, K, E, cores, stream);
    return;
  }
  bool narrowPacked = N < 128 && !strideAligned && K >= 32 && M >= 64LL * E;
  pack = pack || narrowPacked;
  int NP = narrowPacked ? 256 : (packWide ? widePaddedN : (pack ? paddedN : N));
                                                                        
                                                                             
                                                                    
                                                                           
  int kGap = (32 - K % 32) % 32;
  bool alignK = narrowPacked || (pack && !wide && K > 2 * 256 && kGap != 0);
  int KP = alignK ? (K + 31) / 32 * 32 : K;
                                                                          
                                                                                
  if (alignK && K >= 512 && K <= 2048 && M >= 256LL * E && E <= 32 && N >= 256 && NP <= 2048 &&
      ((K + 127) / 128 * 128 - K) * 16 <= K) {
    RunHdNative42(x, w, s, g, y, M, N, K, E, (int)availableCoreNum, stream);
    return;
  }

  bool rowgrid = (E >= 2 * availableCoreNum && M <= 128 * E && N <= 512 && K <= 1024);
  if (pack)
    rowgrid = false;
  int bm = (wide || rowgrid) ? 64 : 128, bn = wide ? 512 : 256;
  if (alignK && !narrowPacked && K > 4096 && N % 256 > 0 && N % 256 <= 64 &&
      tileUpper <= availableCoreNum) {
    run_packed_phase_split(x, w, s, g, y, M, N, NP, K, KP, E, (int)availableCoreNum, 4, stream);
    return;
  }
  auto plat = platform_ascendc::PlatformAscendCManager::GetInstance();
  matmul_tiling::MatmulApiTiling tiler(*plat);
  tiler.SetAType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
                 matmul_tiling::DataType::DT_INT8);
  tiler.SetBType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
                 matmul_tiling::DataType::DT_INT8);
  tiler.SetCType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
                 matmul_tiling::DataType::DT_INT32);
  tiler.SetShape(bm, bn, KP);
  tiler.SetOrgShape(M, NP, KP);
  tiler.SetFixSplit(bm, bn, wide ? 128 : 256);
  tiler.SetBias(false);
  tiler.SetBufferSpace(-1, -1, -1);
  TCubeTiling td;
  tiler.GetTiling(td);
  td.stepKa = wide ? 8 : 4;
  td.depthA1 = 2 * td.stepKa;
  td.stepKb = 4;
  td.depthB1 = 8;
  td.shareL1Size = bm * td.baseK * td.depthA1 + bn * td.baseK * td.depthB1;
                                                                    
                                                                
  int64_t idealWideTiles = ((int64_t)M + 63) / 64 * ((N + 511) / 512);
  bool compactWideGrid = wide && K >= 1024 && idealWideTiles <= 2 * availableCoreNum;
  int blocks = compactWideGrid ? (int)((availableCoreNum * 4 + 4) / 5) : (int)availableCoreNum;
  if (blocks < 1)
    blocks = 1;
  uint64_t cubeBytes = (uint64_t)blocks * RING * bm * bn * 4,
           packBytes = pack ? (uint64_t)E * KP * NP : 0, xBytes = alignK ? (uint64_t)M * KP : 0;
  void *work = nullptr;
  aclrtMalloc(&work, cubeBytes + packBytes + xBytes, ACL_MEM_MALLOC_HUGE_FIRST);
  bool fixed = td.baseM == bm && td.baseN == bn && td.baseK == (wide ? 64 : 128);
  if (alignK && KP <= 8192 && !narrowPacked)
    LaunchNightPackedStatic(x, w, s, g, y, (GM_ADDR)work, (GM_ADDR)((uint8_t *)work + cubeBytes),
                            (GM_ADDR)((uint8_t *)work + cubeBytes + packBytes), M, N, NP, K, KP, E,
                            blocks, td, stream);
  else if (alignK)
    grouped_matmul_gelu_packed_kaligned<128, 256><<<blocks, nullptr, stream>>>(
        x, w, s, g, y, (GM_ADDR)work, (GM_ADDR)((uint8_t *)work + cubeBytes),
        (GM_ADDR)((uint8_t *)work + cubeBytes + packBytes), M, N, NP, K, KP, E, blocks, td);
  else if (fixed && packWide)
    grouped_matmul_gelu_packed<64, 512, true><<<blocks, nullptr, stream>>>(
        x, w, s, g, y, (GM_ADDR)work, (GM_ADDR)((uint8_t *)work + cubeBytes), M, N, NP, K, E,
        blocks, td);
  else if (fixed && pack)
    grouped_matmul_gelu_packed<128, 256><<<blocks, nullptr, stream>>>(
        x, w, s, g, y, (GM_ADDR)work, (GM_ADDR)((uint8_t *)work + cubeBytes), M, N, NP, K, E,
        blocks, td);
  else if (packWide)
    grouped_matmul_gelu_packed<64, 512><<<blocks, nullptr, stream>>>(
        x, w, s, g, y, (GM_ADDR)work, (GM_ADDR)((uint8_t *)work + cubeBytes), M, N, NP, K, E,
        blocks, td);
  else if (fixed && wide)
    grouped_matmul_gelu_stream<64, 512, true>
        <<<blocks, nullptr, stream>>>(x, w, s, g, y, (GM_ADDR)work, M, N, K, E, blocks, td);
  else if (fixed && rowgrid)
    grouped_matmul_gelu_rowgrid<64, 256, true>
        <<<blocks, nullptr, stream>>>(x, w, s, g, y, (GM_ADDR)work, M, N, K, E, blocks, td);
  else if (fixed)
    grouped_matmul_gelu_stream<128, 256, true>
        <<<blocks, nullptr, stream>>>(x, w, s, g, y, (GM_ADDR)work, M, N, K, E, blocks, td);
  else if (wide)
    grouped_matmul_gelu_stream<64, 512>
        <<<blocks, nullptr, stream>>>(x, w, s, g, y, (GM_ADDR)work, M, N, K, E, blocks, td);
  else if (pack)
    grouped_matmul_gelu_packed<128, 256><<<blocks, nullptr, stream>>>(
        x, w, s, g, y, (GM_ADDR)work, (GM_ADDR)((uint8_t *)work + cubeBytes), M, N, NP, K, E,
        blocks, td);
  else if (rowgrid)
    grouped_matmul_gelu_rowgrid<64, 256>
        <<<blocks, nullptr, stream>>>(x, w, s, g, y, (GM_ADDR)work, M, N, K, E, blocks, td);
  else
    grouped_matmul_gelu_stream<128, 256>
        <<<blocks, nullptr, stream>>>(x, w, s, g, y, (GM_ADDR)work, M, N, K, E, blocks, td);
  aclrtSynchronizeStream(stream);
  aclrtFree(work);
}

                                                                                        
static __attribute__((noinline)) bool TryContiguousResident(GM_ADDR x, GM_ADDR w, GM_ADDR s,
                                                            GM_ADDR g, GM_ADDR y, int M, int N,
                                                            int K, int E, int64_t availableCoreNum,
                                                            bool wide, aclrtStream stream) {
  if (!wide && (int64_t)(N / 256) * ((M + 127) / 128) >= 2LL * ((availableCoreNum * 4 + 4) / 5) &&
      K % 128 == 0 && K >= 512 && K <= 2048 && N % 256 == 0 && N >= 512 && E <= 32 &&
      M >= 96LL * E && M <= 256LL * E) {
    int blocks = (int)((availableCoreNum * 4 + 4) / 5);
    if (blocks < 1)
      blocks = 1;
    void *work = nullptr;
    aclrtMalloc(&work, (uint64_t)blocks * 4 * 128 * 256 * 4, ACL_MEM_MALLOC_HUGE_FIRST);
    int target = (blocks * 4 + 4) / 5, estimated = (M + 127) / 128, nt = N / 256;
    int nbundle = nt * estimated / target;
    if (nbundle < 1)
      nbundle = 1;
    if (nbundle > nt)
      nbundle = nt;
    if (K <= 1024)
      grouped_matmul_gelu_resident_legacy_epi<128, 256, 128>
          <<<blocks, nullptr, stream>>>(x, w, s, g, y, (GM_ADDR)work, M, N, K, E, blocks, nbundle);
    else
      grouped_matmul_gelu_resident_contiguous<128, 256, 128>
          <<<blocks, nullptr, stream>>>(x, w, s, g, y, (GM_ADDR)work, M, N, K, E, blocks, nbundle);
    aclrtSynchronizeStream(stream);
    aclrtFree(work);
    return true;
  }
  return false;
}

template <int BM, int BN, int KC> class DirectInt8PanelTail {
  TBuf<TPosition::A1> a1b;
  TBuf<TPosition::B1> b1b;
  TBuf<TPosition::A2> a2b;
  TBuf<TPosition::B2> b2b;
  TBuf<TPosition::CO1> c1b;
  TPipe *pipe;
  int serial = 0, kidx = 0;
  TEventID l1Free[2], bReady[2], l0Free[2], cFree;

public:
  __aicore__ inline void Init(TPipe &p) {
    pipe = &p;
    p.InitBuffer(a1b, BM * 1536);
    p.InitBuffer(b1b, 2 * KC * BN);
    p.InitBuffer(a2b, 2 * BM * KC);
    p.InitBuffer(b2b, 2 * KC * BN);
    p.InitBuffer(c1b, 32768 * 4);
    for (int i = 0; i < 2; ++i) {
      l1Free[i] = p.AllocEventID<HardEvent::MTE1_MTE2>();
      bReady[i] = p.AllocEventID<HardEvent::MTE2_MTE1>();
    }
    for (int i = 0; i < 2; ++i)
      l0Free[i] = p.AllocEventID<HardEvent::M_MTE1>();
    cFree = p.AllocEventID<HardEvent::FIX_M>();
  }
  __aicore__ inline void LoadA(GlobalTensor<int8_t> a, int K, int rm) {
    auto a1 = a1b.template Get<int8_t>();
    Nd2NzParams ap;
    ap.ndNum = 1;
    ap.nValue = rm;
    ap.dValue = K;
    ap.srcDValue = K;
    ap.srcNdMatrixStride = 0;
    ap.dstNzC0Stride = BM;
    ap.dstNzNStride = 1;
    ap.dstNzMatrixStride = 0;
    auto aConsumed = pipe->FetchEventID(HardEvent::MTE1_MTE2);
    SetFlag<HardEvent::MTE1_MTE2>(aConsumed);
    WaitFlag<HardEvent::MTE1_MTE2>(aConsumed);
                                                                          
                                                                          
    int paddedM = (rm + 31) / 32 * 32;
    if (paddedM != rm) {
      InitConstValueParams<uint16_t> zero;
      zero.repeatTimes = (K + 31) / 32;
      zero.blockNum = paddedM - rm;
      zero.dstGap = BM - (paddedM - rm);
      zero.initValue = 0;
      InitConstValue(a1.template ReinterpretCast<uint16_t>()[rm * 16], zero);
      PipeBarrier<PIPE_MTE2>();
    }
    DataCopy(a1, a, ap);
    auto aReady = pipe->FetchEventID(HardEvent::MTE2_MTE1);
    SetFlag<HardEvent::MTE2_MTE1>(aReady);
    WaitFlag<HardEvent::MTE2_MTE1>(aReady);
  }
  __aicore__ inline void Tile(GlobalTensor<int8_t> b, GlobalTensor<int32_t> c, int K, int N, int rm,
                              int rn, int cstride) {
    auto a1 = a1b.template Get<int8_t>();
    auto c1 = c1b.template Get<int32_t>();
    int na = (rn + 31) / 32 * 32;
    for (int done = 0; done < K; done += KC) {
      int rk = K - done;
      if (rk > KC)
        rk = KC;
      int kp = (rk + 31) / 32 * 32;
      int s = kidx % 2;
      auto a2 = a2b.template Get<int8_t>()[s * BM * KC];
      auto b2 = b2b.template Get<int8_t>()[s * KC * BN];
      auto b1 = b1b.template Get<int8_t>()[s * KC * BN];
      if (kidx >= 2)
        WaitFlag<HardEvent::MTE1_MTE2>(l1Free[s]);
      Nd2NzParams bp;
      bp.ndNum = 1;
      bp.nValue = rk;
      bp.dValue = rn;
      bp.srcDValue = N;
      bp.srcNdMatrixStride = 0;
      bp.dstNzC0Stride = KC;
      bp.dstNzNStride = 1;
      bp.dstNzMatrixStride = 0;
      if (kp != rk) {
        InitConstValueParams<uint16_t> zero;
        zero.repeatTimes = (rn + 31) / 32;
        zero.blockNum = kp - rk;
        zero.dstGap = KC - (kp - rk);
        zero.initValue = 0;
        InitConstValue(b1.template ReinterpretCast<uint16_t>()[rk * 16], zero);
        PipeBarrier<PIPE_MTE2>();
      }
      DataCopy(b1, b[done * (int64_t)N], bp);
      SetFlag<HardEvent::MTE2_MTE1>(bReady[s]);
      if (kidx >= 2)
        WaitFlag<HardEvent::M_MTE1>(l0Free[s]);
      WaitFlag<HardEvent::MTE2_MTE1>(bReady[s]);
      LoadData2dTransposeParams bl;
      bl.startIndex = 0;
      bl.dstFracGap = 0;
      int nblocks = (rn + 31) / 32;
      if (nblocks < kp / 32) {
        bl.repeatTimes = kp / 32;
        bl.srcStride = 1;
        bl.dstGap = na / 16 - 1;
        for (int i = 0; i < nblocks; ++i)
          LoadDataWithTranspose(b2[i * 1024], b1[i * KC * 32], bl);
      } else {
        bl.repeatTimes = nblocks;
        bl.srcStride = KC / 32;
        bl.dstGap = 1;
        for (int i = 0; i < kp / 32; ++i)
          LoadDataWithTranspose(b2[i * na * 32], b1[i * 1024], bl);
      }
      LoadData2DParams al;
      al.startIndex = 0;
      al.ifTranspose = false;
      int mblocks = ((rm + 31) / 32) * 2, kblocks = kp / 32;
      if (kblocks < mblocks) {
        al.repeatTimes = mblocks;
        al.srcStride = 1;
        al.dstGap = kblocks - 1;
        for (int i = 0; i < kblocks; ++i)
          LoadData(a2[i * 512], a1[(done / 32 + i) * (BM * 32)], al);
      } else {
        al.repeatTimes = kblocks;
        al.srcStride = BM / 16;
        al.dstGap = 0;
        for (int i = 0; i < mblocks; ++i)
          LoadData(a2[i * kp * 16], a1[i * 512 + (done / 32) * (BM * 32)], al);
      }
      SetFlag<HardEvent::MTE1_MTE2>(l1Free[s]);
      auto mr = pipe->FetchEventID(HardEvent::MTE1_M);
      SetFlag<HardEvent::MTE1_M>(mr);
      WaitFlag<HardEvent::MTE1_M>(mr);
      MmadParams mp;
      mp.m = (rm + 31) / 32 * 32;
      mp.n = na;
      mp.k = kp;
      mp.cmatrixInitVal = (done == 0);
      if (done == 0 && serial >= 1)
        WaitFlag<HardEvent::FIX_M>(cFree);
      Mmad(c1, a2, b2, mp);
      PipeBarrier<PIPE_M>();
      SetFlag<HardEvent::M_MTE1>(l0Free[s]);
      ++kidx;
    }
    auto doneEv = pipe->FetchEventID(HardEvent::M_FIX);
    SetFlag<HardEvent::M_FIX>(doneEv);
    WaitFlag<HardEvent::M_FIX>(doneEv);
    FixpipeParamsV220 fp;
    fp.mSize = (rm + 31) / 32 * 32;
    fp.nSize = na;
    fp.srcStride = (rm + 31) / 32 * 32;
    fp.dstStride = cstride;
    fp.quantPre = QuantMode_t::NoQuant;
    fp.deqScalar = 0;
    Fixpipe<int32_t, int32_t, CFG_ROW_MAJOR>(c, c1, fp);
    SetFlag<HardEvent::FIX_M>(cFree);
    ++serial;
  }
  __aicore__ inline void End() {
    for (int i = 0; i < 2 && i < kidx; ++i)
      WaitFlag<HardEvent::MTE1_MTE2>(l1Free[i]);
    for (int i = 0; i < 2 && i < kidx; ++i)
      WaitFlag<HardEvent::M_MTE1>(l0Free[i]);
    if (serial)
      WaitFlag<HardEvent::FIX_M>(cFree);
    for (int i = 0; i < 2; ++i) {
      pipe->ReleaseEventID<HardEvent::MTE1_MTE2>(l1Free[i]);
      pipe->ReleaseEventID<HardEvent::MTE2_MTE1>(bReady[i]);
    }
    for (int i = 0; i < 2; ++i)
      pipe->ReleaseEventID<HardEvent::M_MTE1>(l0Free[i]);
    pipe->ReleaseEventID<HardEvent::FIX_M>(cFree);
    PipeBarrier<PIPE_ALL>();
  }
};

                                                                               
                                                                            
                                                  
template <int Mode> __aicore__ inline int TailPhysicalBandCost(int rm, int N) {
  int pairs = rm <= 128 ? N / 256 : 0;
  int rest = N - pairs * 256, ordinary = (rest + 127) / 128;
  if constexpr (Mode == 0)
    return pairs + ordinary;
  return (N + 31) / 32 * 32 + 256 * (pairs + ordinary);
}
template <int Mode>
__aicore__ inline int TailPhysicalBoundary(int64_t target, int rows, int BM, int N) {
  if (target <= 0 || rows <= 0)
    return 0;
  int nt = (N + 127) / 128, full = rows / BM, tail = rows % BM;
  int wholeCost = TailPhysicalBandCost<Mode>(BM, N);
  int64_t fullCost = (int64_t)full * wholeCost;
  if (target >= fullCost + (tail ? TailPhysicalBandCost<Mode>(tail, N) : 0))
    return (full + (tail != 0)) * nt;
  int mi;
  int rm;
  if (target <= fullCost) {
    mi = (int)((target - 1) / wholeCost);
    target -= (int64_t)mi * wholeCost;
    rm = BM;
  } else {
    mi = full;
    target -= fullCost;
    rm = tail;
  }
  int pairs = rm <= 128 ? N / 256 : 0;
  int pairCost = Mode == 0 ? 1 : 512;
  int64_t paired = (int64_t)pairs * pairCost;
  if (target <= paired)
    return mi * nt + 2 * (int)((target + pairCost - 1) / pairCost);
  target -= paired;
  int ordinaryCost = Mode == 0 ? 1 : 384, fullOrdinary = (N - pairs * 256) / 128;
  if (target <= (int64_t)fullOrdinary * ordinaryCost)
    return mi * nt + 2 * pairs + (int)((target + ordinaryCost - 1) / ordinaryCost);
  return (mi + 1) * nt;
}

template <int BM, int BN, int KC>
__global__ __mix__(1, 2) void grouped_matmul_gelu_resident_tail(GM_ADDR x, GM_ADDR w, GM_ADDR s,
                                                                GM_ADDR g, GM_ADDR y, GM_ADDR work,
                                                                GM_ADDR packedWeight, int M, int N,
                                                                int NP, int K, int E, int cores,
                                                                bool packWeight) {
  constexpr int RING = 4;
  constexpr uint16_t READY_FLAG = 7, FREE_FLAG = 3;
  constexpr int BC = 32768;
  constexpr int VR = 32;
  TPipe pipe;
  DirectInt8PanelTail<BM, BN, KC> mm;
  TBuf<TPosition::VECIN> cb, sb;
  TBuf<TPosition::VECCALC> zb, tb, ub;
  TBuf<TPosition::VECOUT> ob;
  if ASCEND_IS_AIC {
    mm.Init(pipe);
  }
  if ASCEND_IS_AIV {
    pipe.InitBuffer(cb, VR * BN * 4);
    pipe.InitBuffer(sb, BN * 4 + 256);
    pipe.InitBuffer(zb, VR * BN * 4 + 256);
    pipe.InitBuffer(tb, VR * BN * 4 + 256);
    pipe.InitBuffer(ub, VR * BN * 4 + 256);
    pipe.InitBuffer(ob, VR * BN * 2);
  }
  GlobalTensor<int8_t> xx, ww;
  GlobalTensor<float> ss;
  GlobalTensor<int64_t> gg;
  GlobalTensor<half> yy;
  GlobalTensor<int32_t> cc;
  xx.SetGlobalBuffer((__gm__ int8_t *)x);
  ww.SetGlobalBuffer((__gm__ int8_t *)(packWeight ? packedWeight : w));
  ss.SetGlobalBuffer((__gm__ float *)s);
  gg.SetGlobalBuffer((__gm__ int64_t *)g);
  yy.SetGlobalBuffer((__gm__ half *)y);
  cc.SetGlobalBuffer((__gm__ int32_t *)work);
  if (packWeight) {
    if ASCEND_IS_AIV {
      PackWeightsThisInvocation<BN>(w, packedWeight, g, E, K, N, NP, pipe, cb.Get<int8_t>());
    }
    SyncAll<false>();
  }
  int bid = GetBlockIdx(), sub = 0;
  if ASCEND_IS_AIV {
    bid = GetBlockIdx() / 2;
    sub = GetSubBlockIdx();
  }
  TEventID outputDone = 0, inputConsumed = 0;
  bool outputPending = false, inputPending = false;
  if ASCEND_IS_AIV {
    outputDone = pipe.AllocEventID<HardEvent::MTE3_V>();
    inputConsumed = pipe.AllocEventID<HardEvent::V_MTE2>();
  }
                                                                                     
                                                                                
                                                                       
                                                              
  constexpr int CostMode = 1;
  int fullCost = TailPhysicalBandCost<CostMode>(BM, N);
  int shortCost = TailPhysicalBandCost<CostMode>(128, N);
  int actualMtiles = 0, shortMtiles = 0, previous = 0, minRows = 2147483647, maxRows = 0;
  for (int e = 0; e < E; ++e) {
    int end = (int)gg.GetValue(e), rows = end - previous;
    previous = end;
    actualMtiles += (rows + BM - 1) / BM;
    int tail = rows % BM;
    if (tail > 0 && tail <= 128)
      ++shortMtiles;
    if (rows > 0) {
      if (rows < minRows)
        minRows = rows;
      if (rows > maxRows)
        maxRows = rows;
    }
  }
  int nt = (N + 127) / 128, totalTiles = actualMtiles * nt;
  bool weighted = maxRows > 2LL * minRows;
  int64_t totalCost =
              (int64_t)actualMtiles * fullCost - (int64_t)shortMtiles * (fullCost - shortCost),
          costBase = 0;
  int64_t ownedFirst = (weighted ? totalCost : totalTiles) * bid / cores;
  int64_t ownedLast = (weighted ? totalCost : totalTiles) * (bid + 1) / cores;
  int serial = 0, start = 0, tileBase = 0;
  for (int e = 0; e < E; ++e) {
    int end = (int)gg.GetValue(e), rows = end - start, mt = (rows + BM - 1) / BM,
        groupTiles = mt * nt;
    int first, last;
    if (weighted) {
      first = TailPhysicalBoundary<CostMode>(ownedFirst - costBase, rows, BM, N);
      last = TailPhysicalBoundary<CostMode>(ownedLast - costBase, rows, BM, N);
    } else {
      first = (int)ownedFirst - tileBase;
      if (first < 0)
        first = 0;
      last = (int)ownedLast - tileBase;
      if (last > groupTiles)
        last = groupTiles;
    }
    int loadedMi = -1;
    for (int tile = first; tile < last;) {
      int mi = (tile / nt) * BM, ni = (tile % nt) * 128, rm = rows - mi;
      if (rm > BM)
        rm = BM;
      bool pair = rm <= 128 && tile + 1 < last && tile % nt + 1 < nt && ni + 256 <= N;
      int width = pair ? 256 : 128;
      if ASCEND_IS_AIC {
        if (mi != loadedMi) {
          mm.LoadA(xx[(start + mi) * (int64_t)K], K, rm);
          loadedMi = mi;
        }
      }
      {
        int rn = N - ni;
        if (rn > width)
          rn = width;
        int64_t coff = ((serial % RING) * cores + bid) * (int64_t)BC;
        if ASCEND_IS_AIC {
          if (serial >= RING)
            CrossCoreWaitFlag(FREE_FLAG + serial % RING);
          mm.Tile(ww[e * (int64_t)K * NP + ni], cc[coff], K, NP, rm, rn, width);
          CrossCoreSetFlag<2, PIPE_FIX>(READY_FLAG + serial % RING);
        }
        if ASCEND_IS_AIV {
          auto ci = cb.Get<int32_t>();
          auto sc = sb.Get<float>();
          auto z = zb.Get<float>();
          auto t = tb.Get<float>();
          auto u = ub.Get<float>();
          auto o = ob.Get<half>();
          int split = (rm + 1) / 2, vstart = sub * split, vm = rm - vstart;
          if (vm > split)
            vm = split;
          if (vm < 0)
            vm = 0;
          int stride = (rn + 15) / 16 * 16;
          CrossCoreWaitFlag(READY_FLAG + serial % RING);
          int totalVm = vm;
          for (int vr = 0; vr < totalVm; vr += VR) {
            vm = totalVm - vr;
            if (vm > VR)
              vm = VR;
            if (inputPending) {
              WaitFlag<HardEvent::V_MTE2>(inputConsumed);
              inputPending = false;
            }
            DataCopyExtParams cp{(uint16_t)vm, (uint32_t)(rn * 4), (uint32_t)((width - rn) * 4),
                                 (uint32_t)((stride - (rn + 7) / 8 * 8) / 8), 0};
            DataCopyPadExtParams<int32_t> ip{true, 0, 0, 0};
            DataCopyPad(ci, cc[coff + (vstart + vr) * width], cp, ip);
            DataCopyExtParams sp{1, (uint32_t)(rn * 4), 0, 0, 0};
            DataCopyPadExtParams<float> fp{true, 0, 0, 0};
            if (vr == 0)
              DataCopyPad(sc, ss[e * (int64_t)N + ni], sp, fp);
            auto ev = pipe.FetchEventID(HardEvent::MTE2_V);
            SetFlag<HardEvent::MTE2_V>(ev);
            WaitFlag<HardEvent::MTE2_V>(ev);
            if (vr + vm >= totalVm)
              CrossCoreSetFlag<2, PIPE_MTE2>(FREE_FLAG + serial % RING);
            int count = vm * stride;
            Cast(z, ci, RoundMode::CAST_NONE, count);
            PipeBarrier<PIPE_V>();
            for (int c = 0; c < stride; c += 64) {
              uint64_t mask = (stride - c < 64 ? stride - c : 64);
              Mul(z[c], z[c], sc[c], mask, (uint8_t)vm,
                  {1, 1, 1, (uint8_t)(stride / 8), (uint8_t)(stride / 8), 0});
            }
            SetFlag<HardEvent::V_MTE2>(inputConsumed);
            inputPending = true;
            PipeBarrier<PIPE_V>();
            GmmDirectVectorCounter(z, t, u, count);
            if (outputPending) {
              WaitFlag<HardEvent::MTE3_V>(outputDone);
              outputPending = false;
            }
            Cast(o, u, RoundMode::CAST_RINT, count);
            PipeBarrier<PIPE_V>();
            auto ev2 = pipe.FetchEventID(HardEvent::V_MTE3);
            SetFlag<HardEvent::V_MTE3>(ev2);
            WaitFlag<HardEvent::V_MTE3>(ev2);
            DataCopyExtParams op{(uint16_t)vm, (uint32_t)(rn * 2),
                                 (uint32_t)((stride - (rn + 15) / 16 * 16) / 16),
                                 (uint32_t)((N - rn) * 2), 0};
            DataCopyPad(yy[(start + mi + vstart + vr) * (int64_t)N + ni], o, op);
            SetFlag<HardEvent::MTE3_V>(outputDone);
            outputPending = true;
          }
          if (!totalVm)
            CrossCoreSetFlag<2, PIPE_MTE2>(FREE_FLAG + serial % RING);
        }
        ++serial;
        tile += pair ? 2 : 1;
      }
    }
    if (weighted) {
      costBase += (int64_t)mt * fullCost;
      int tail = rows % BM;
      if (tail > 0 && tail <= 128)
        costBase -= fullCost - shortCost;
    }
    tileBase += groupTiles;
    start = end;
                                                                              
    if (weighted ? costBase >= ownedLast : tileBase >= ownedLast)
      break;
  }
  if ASCEND_IS_AIV {
    if (inputPending)
      WaitFlag<HardEvent::V_MTE2>(inputConsumed);
    if (outputPending)
      WaitFlag<HardEvent::MTE3_V>(outputDone);
    pipe.ReleaseEventID<HardEvent::V_MTE2>(inputConsumed);
    pipe.ReleaseEventID<HardEvent::MTE3_V>(outputDone);
  }
  if ASCEND_IS_AIC {
    mm.End();
    for (int i = 0; i < (serial < RING ? serial : RING); ++i)
      CrossCoreWaitFlag(FREE_FLAG + (serial - 1 - i) % RING);
  }
}

static __attribute__((noinline)) bool TryResidentTail(GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR g,
                                                      GM_ADDR y, int M, int N, int K, int E,
                                                      int64_t availableCoreNum, bool wide,
                                                      aclrtStream stream) {
  if (!wide && K >= 257 && K <= 1536 && N >= 256 &&
      ((E <= 32 && M > 128LL * E) || (E <= 128 && M > 64LL * E && (K % 32 != 0 || N % 32 != 0))) &&
      (int64_t)((N + 255) / 256) * ((M + 127) / 128) >= 2 * availableCoreNum) {
    int cores = (int)availableCoreNum;
    bool packWeight = false;
    int NP = packWeight ? (N + 31) / 32 * 32 : N;
    uint64_t cb = (uint64_t)cores * 4 * 128 * 256 * 4;
    void *work = nullptr;
    aclrtMalloc(&work, cb + (packWeight ? (uint64_t)E * K * NP : 0), ACL_MEM_MALLOC_HUGE_FIRST);
    grouped_matmul_gelu_resident_tail<256, 256, 128>
        <<<cores, nullptr, stream>>>(x, w, s, g, y, (GM_ADDR)work, (GM_ADDR)((uint8_t *)work + cb),
                                     M, N, NP, K, E, cores, packWeight);
    aclrtSynchronizeStream(stream);
    aclrtFree(work);
    return true;
  }
  return false;
}

template <int KK>
__global__ __vector__ void grouped_matmul_gelu_tiny_scalar_engine(GM_ADDR x, GM_ADDR w, GM_ADDR s,
                                                                  GM_ADDR g, GM_ADDR y, int E) {
  GlobalTensor<int8_t> xx, ww;
  GlobalTensor<float> ss;
  GlobalTensor<int64_t> gg;
  xx.SetGlobalBuffer((__gm__ int8_t *)x);
  ww.SetGlobalBuffer((__gm__ int8_t *)w);
  ss.SetGlobalBuffer((__gm__ float *)s);
  gg.SetGlobalBuffer((__gm__ int64_t *)g);
                                                     
  GlobalTensor<uint64_t> xc, gc, wc, sc;
  xc.SetGlobalBuffer((__gm__ uint64_t *)x);
  gc.SetGlobalBuffer((__gm__ uint64_t *)g);
  wc.SetGlobalBuffer((__gm__ uint64_t *)w);
  sc.SetGlobalBuffer((__gm__ uint64_t *)s);
  DataCachePreload(xc, (int64_t)0);
  DataCachePreload(gc, (int64_t)0);
                                                                        
  if (E <= 16) {
    DataCachePreload(wc, (int64_t)0);
    DataCachePreload(sc, (int64_t)0);
  }
  int expert = 0;
  while (expert < E - 1 && gg.GetValue(expert) == 0)
    ++expert;
  if (E > 16) {
    DataCachePreload(wc, (int64_t)(expert * KK / 64) * 64);
    DataCachePreload(sc, (int64_t)(expert * 4 / 64) * 64);
  }

  float factor = ss.GetValue(expert);
  int32_t acc = 0;
#pragma unroll
  for (int k = 0; k < KK; ++k)
    acc += (int32_t)xx.GetValue(k) * (int32_t)ww.GetValue(expert * KK + k);
  float z = (float)acc * factor, a = z >= 0.0f ? z : -z, result;
  if (a >= 6.0f)
    result = z >= 0.0f ? z : 0.0f;
  else {
                                                                          
                                                                                 
    float v = -1.5957691216057308f * (a + 0.044715f * a * a * a);
    int n = (int)(v * 1.4426950408889634f - 0.5f);
    float r = v - (float)n * 0.6931471805599453f;
    float p = (((((((((1.0f / 362880.0f) * r + 1.0f / 40320.0f) * r + 1.0f / 5040.0f) * r +
                    1.0f / 720.0f) *
                       r +
                   1.0f / 120.0f) *
                      r +
                  1.0f / 24.0f) *
                     r +
                 1.0f / 6.0f) *
                    r +
                0.5f) *
                   r +
               1.0f) *
                  r +
              1.0f;
    union {
      uint32_t bits;
      float f;
    } two;
    two.bits = (uint32_t)(n + 127) << 23;
    float tail = p * two.f;
    result = z >= 0.0f ? z / (1.0f + tail) : z * tail / (1.0f + tail);
  }
  if (TinyScalarNeedsRefinement(z, result))
    result = GmmRefine(z);
  union {
    half value;
    uint16_t bits;
  } out;
  out.value = static_cast<half>(result);
  WriteGmByPassDCache<uint16_t>(reinterpret_cast<__gm__ uint16_t *>(y), out.bits);
  DataSyncBarrier<MemDsbT::DDR>();
  PipeBarrier<PIPE_ALL>();
}
template <int KK>
__global__ __vector__ void grouped_matmul_gelu_tiny_fixed(GM_ADDR x, GM_ADDR w, GM_ADDR s,
                                                          GM_ADDR g, GM_ADDR y, int M, int N,
                                                          int E) {
  int row = GetBlockIdx();
  if (row >= M)
    return;
  constexpr int VN = 32;
  LocalTensor<int8_t> wl(TPosition::VECIN, 0, 4 * VN);
  LocalTensor<half> wh(TPosition::VECCALC, 4 * VN, 4 * VN);
  LocalTensor<float> scale(TPosition::VECIN, 12 * VN, VN), acc(TPosition::VECCALC, 16 * VN, VN);
  LocalTensor<float> z(TPosition::VECCALC, 20 * VN, VN), t(TPosition::VECCALC, 24 * VN, VN),
      u(TPosition::VECCALC, 28 * VN, VN);
  LocalTensor<half> out(TPosition::VECOUT, 32 * VN, VN);
  GlobalTensor<int8_t> xx, ww;
  GlobalTensor<float> ss;
  GlobalTensor<int64_t> gg;
  GlobalTensor<half> yy;
  xx.SetGlobalBuffer((__gm__ int8_t *)x);
  ww.SetGlobalBuffer((__gm__ int8_t *)w);
  ss.SetGlobalBuffer((__gm__ float *)s);
  gg.SetGlobalBuffer((__gm__ int64_t *)g);
  yy.SetGlobalBuffer((__gm__ half *)y);

                                                                                
  GlobalTensor<uint64_t> xc, gc;
  xc.SetGlobalBuffer((__gm__ uint64_t *)x);
  gc.SetGlobalBuffer((__gm__ uint64_t *)g);
  DataCachePreload(xc, (int64_t)(row * KK / 64) * 64);
  DataCachePreload(gc, (int64_t)0);
                                                                            
  if (E * KK * N <= 64 && E * N <= 16) {
    GlobalTensor<uint64_t> wc, sc;
    wc.SetGlobalBuffer((__gm__ uint64_t *)w);
    sc.SetGlobalBuffer((__gm__ uint64_t *)s);
    DataCachePreload(wc, (int64_t)0);
    DataCachePreload(sc, (int64_t)0);
  }
  int expert = 0;
  while (expert < E - 1 && row >= gg.GetValue(expert))
    ++expert;
  DataCopyPad(scale, ss[(int64_t)expert * N], {1, (uint32_t)(N * 4), 0, 0, 0}, {true, 0, 0, 0});
  DataCopyPad(wl, ww[(int64_t)expert * KK * N], {KK, (uint32_t)N, 0, 0, 0}, {true, 0, 0, 0});
                                                                                   
  half x0 = static_cast<half>((int32_t)xx.GetValue((int64_t)row * KK));
  half x1 = KK > 1 ? static_cast<half>((int32_t)xx.GetValue((int64_t)row * KK + 1)) : half(0);
  half x2 = KK > 2 ? static_cast<half>((int32_t)xx.GetValue((int64_t)row * KK + 2)) : half(0);
  half x3 = KK > 3 ? static_cast<half>((int32_t)xx.GetValue((int64_t)row * KK + 3)) : half(0);
  Duplicate(acc, 0.0f, VN);
  PipeBarrier<PIPE_V>();
  SetFlag<HardEvent::MTE2_V>(0);
  WaitFlag<HardEvent::MTE2_V>(0);
  Cast(wh, wl, RoundMode::CAST_NONE, KK * VN);
  PipeBarrier<PIPE_V>();
  Axpy(acc, wh, x0, VN);
  PipeBarrier<PIPE_V>();
  if constexpr (KK > 1) {
    Axpy(acc, wh[VN], x1, VN);
    PipeBarrier<PIPE_V>();
  }
  if constexpr (KK > 2) {
    Axpy(acc, wh[2 * VN], x2, VN);
    PipeBarrier<PIPE_V>();
  }
  if constexpr (KK > 3) {
    Axpy(acc, wh[3 * VN], x3, VN);
    PipeBarrier<PIPE_V>();
  }
  Mul(z, acc, scale, VN);
  PipeBarrier<PIPE_V>();
  Abs(acc, z, VN);
  Relu(scale, z, VN);
  PipeBarrier<PIPE_V>();
  Mul(t, acc, acc, VN);
  Muls(u, acc, -1.5957691216057308f, VN);
  PipeBarrier<PIPE_V>();
  Muls(t, t, 0.044715f, VN);
  PipeBarrier<PIPE_V>();
  MulAddDst(u, t, u, VN);
  PipeBarrier<PIPE_V>();
  Exp(t, u, VN);
  PipeBarrier<PIPE_V>();
  Adds(u, t, 1.0f, VN);
  PipeBarrier<PIPE_V>();
  Div(t, t, u, VN);
  PipeBarrier<PIPE_V>();
  Mul(t, t, acc, VN);
  PipeBarrier<PIPE_V>();
  Sub(u, scale, t, VN);
  PipeBarrier<PIPE_V>();
  Cast(out, u, RoundMode::CAST_RINT, VN);
  PipeBarrier<PIPE_V>();
  SetFlag<HardEvent::V_MTE3>(0);
  WaitFlag<HardEvent::V_MTE3>(0);
  DataCopyPad(yy[(int64_t)row * N], out, {1, (uint32_t)(N * 2), 0, 0, 0});
  SetFlag<HardEvent::MTE3_S>(0);
  WaitFlag<HardEvent::MTE3_S>(0);
}

static __attribute__((noinline)) bool TryTinyFixed(GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR g,
                                                   GM_ADDR y, int M, int N, int K, int E,
                                                   int64_t availableCoreNum, aclrtStream stream) {
  if (K <= 4 && N <= 32 && M <= 2 * availableCoreNum) {
                                                                   
    if (M == 1 && N == 1 && ((reinterpret_cast<uint64_t>(y) & 127ULL) < 32ULL)) {
      switch (K) {
      case 1:
        grouped_matmul_gelu_tiny_scalar_engine<1><<<1, nullptr, stream>>>(x, w, s, g, y, E);
        break;
      case 2:
        grouped_matmul_gelu_tiny_scalar_engine<2><<<1, nullptr, stream>>>(x, w, s, g, y, E);
        break;
      case 3:
        grouped_matmul_gelu_tiny_scalar_engine<3><<<1, nullptr, stream>>>(x, w, s, g, y, E);
        break;
      case 4:
        grouped_matmul_gelu_tiny_scalar_engine<4><<<1, nullptr, stream>>>(x, w, s, g, y, E);
        break;
      }
      return true;
    }
    int blocks = M;
    switch (K) {
    case 1:
      grouped_matmul_gelu_tiny_fixed<1><<<blocks, nullptr, stream>>>(x, w, s, g, y, M, N, E);
      break;
    case 2:
      grouped_matmul_gelu_tiny_fixed<2><<<blocks, nullptr, stream>>>(x, w, s, g, y, M, N, E);
      break;
    case 3:
      grouped_matmul_gelu_tiny_fixed<3><<<blocks, nullptr, stream>>>(x, w, s, g, y, M, N, E);
      break;
    case 4:
      grouped_matmul_gelu_tiny_fixed<4><<<blocks, nullptr, stream>>>(x, w, s, g, y, M, N, E);
      break;
    }
    return true;
  }
  return false;
}

                                                                               
                                                                              
template <int BM, int BN, bool SINGLE>
__global__ __mix__(1, 2) void grouped_matmul_gelu_lowu_raw(GM_ADDR x, GM_ADDR w, GM_ADDR s,
                                                           GM_ADDR g, GM_ADDR y, GM_ADDR work,
                                                           int M, int N, int K, int E) {
  int bid = GetBlockIdx(), sub = 0;
  if ASCEND_IS_AIV {
    bid = GetBlockIdx() / 2;
    sub = GetSubBlockIdx();
  }
  GlobalTensor<int8_t> xx, ww;
  GlobalTensor<float> ss;
  GlobalTensor<int64_t> gg;
  GlobalTensor<int32_t> cc;
  GlobalTensor<half> yy;
  xx.SetGlobalBuffer((__gm__ int8_t *)x);
  ww.SetGlobalBuffer((__gm__ int8_t *)w);
  ss.SetGlobalBuffer((__gm__ float *)s);
  gg.SetGlobalBuffer((__gm__ int64_t *)g);
  cc.SetGlobalBuffer((__gm__ int32_t *)work);
  yy.SetGlobalBuffer((__gm__ half *)y);
  int nt = (N + BN - 1) / BN, e = 0, start = 0, tile = bid, rows = 0;
  if constexpr (SINGLE) {
    rows = M;
  } else {
    for (; e < E; ++e) {
      int end = (int)gg.GetValue(e);
      rows = end - start;
      int tasks = ((rows + BM - 1) / BM) * nt;
      if (tile < tasks)
        break;
      tile -= tasks;
      start = end;
    }
  }

  if (e == E)
    return;
  int mi = (tile / nt) * BM, ni = (tile % nt) * BN, rm = rows - mi, rn = N - ni;
  if (rm > BM)
    rm = BM;
  if (rn > BN)
    rn = BN;
  int KP = (K + 31) / 32 * 32, na = (rn + 15) / 16 * 16;
  int64_t coff = (int64_t)bid * BM * BN;
  if ASCEND_IS_AIC {
    LocalTensor<int8_t> a1(TPosition::A1, 0, BM * 256), b1(TPosition::B1, BM * 256, 256 * BN);
    LocalTensor<int8_t> a2(TPosition::A2, 0, BM * 256), b2(TPosition::B2, 0, 256 * BN);
    LocalTensor<int32_t> c1(TPosition::CO1, 0, BM * BN);
    Nd2NzParams ap;
    ap.ndNum = 1;
    ap.nValue = rm;
    ap.dValue = K;
    ap.srcDValue = K;
    ap.srcNdMatrixStride = 0;
    ap.dstNzC0Stride = BM;
    ap.dstNzNStride = 1;
    ap.dstNzMatrixStride = 0;
    Nd2NzParams bp;
    bp.ndNum = 1;
    bp.nValue = K;
    bp.dValue = rn;
    bp.srcDValue = N;
    bp.srcNdMatrixStride = 0;
    bp.dstNzC0Stride = KP;
    bp.dstNzNStride = 1;
    bp.dstNzMatrixStride = 0;
    if (KP != K) {
      InitConstValueParams<uint16_t> zero;
      zero.repeatTimes = (rn + 31) / 32;
      zero.blockNum = KP - K;
      zero.dstGap = K;
      zero.initValue = 0;
      InitConstValue(b1.template ReinterpretCast<uint16_t>()[K * 16], zero);
      PipeBarrier<PIPE_MTE2>();
    }
    DataCopy(a1, xx[(int64_t)(start + mi) * K], ap);
    DataCopy(b1, ww[(int64_t)e * K * N + ni], bp);
    SetFlag<HardEvent::MTE2_MTE1>(0);
    WaitFlag<HardEvent::MTE2_MTE1>(0);
    LoadData2DParams al;
    al.startIndex = 0;
    al.repeatTimes = KP / 32;
    al.srcStride = BM / 16;
    al.dstGap = 0;
    al.ifTranspose = false;
    for (int i = 0; i < (rm + 15) / 16; ++i)
      LoadData(a2[i * KP * 16], a1[i * 512], al);
    LoadData2dTransposeParams bl;
    bl.startIndex = 0;
    bl.repeatTimes = (rn + 31) / 32;
    bl.srcStride = KP / 32;
    bl.dstGap = 1;
    bl.dstFracGap = 0;
    for (int i = 0; i < KP / 32; ++i)
      LoadDataWithTranspose(b2[i * na * 32], b1[i * 1024], bl);
    SetFlag<HardEvent::MTE1_M>(0);
    WaitFlag<HardEvent::MTE1_M>(0);
    MmadParams mp;
    mp.m = (rm + 15) / 16 * 16;
    mp.n = na;
    mp.k = KP;
    mp.cmatrixInitVal = true;
    Mmad(c1, a2, b2, mp);
    SetFlag<HardEvent::M_FIX>(0);
    WaitFlag<HardEvent::M_FIX>(0);
    FixpipeParamsV220 fp;
    fp.mSize = rm;
    fp.nSize = rn;
    fp.srcStride = (rm + 15) / 16 * 16;
    fp.dstStride = BN;
    fp.quantPre = QuantMode_t::NoQuant;
    fp.deqScalar = 0;
    Fixpipe<int32_t, int32_t, CFG_ROW_MAJOR>(cc[coff], c1, fp);
    CrossCoreSetFlag<2, PIPE_FIX>(8);
    CrossCoreWaitFlag(4);
  }
  if ASCEND_IS_AIV {
    constexpr int VMAX = (BM / 2) * BN, SBYTES = BN * 4;
    LocalTensor<int32_t> ci(TPosition::VECIN, 0, VMAX);
    LocalTensor<float> sc(TPosition::VECIN, VMAX * 4, BN);
    LocalTensor<float> z(TPosition::VECCALC, VMAX * 4 + SBYTES, VMAX),
        t(TPosition::VECCALC, VMAX * 8 + SBYTES, VMAX),
        u(TPosition::VECCALC, VMAX * 12 + SBYTES, VMAX);
    LocalTensor<half> out(TPosition::VECOUT, VMAX * 16 + SBYTES, VMAX);
    int split = (rm + 1) / 2, vstart = sub * split, vm = rm - vstart;
    if (vm > split)
      vm = split;
    if (vm < 0)
      vm = 0;
    CrossCoreWaitFlag(8);
    if (vm) {
      int stride = (rn + 15) / 16 * 16, count = vm * stride;
      DataCopyPad(ci, cc[coff + vstart * BN],
                  {(uint16_t)vm, (uint32_t)(rn * 4), (uint32_t)((BN - rn) * 4),
                   (uint32_t)((stride - (rn + 7) / 8 * 8) / 8), 0},
                  {true, 0, 0, 0});
      DataCopyPad(sc, ss[(int64_t)e * N + ni], {1, (uint32_t)(rn * 4), 0, 0, 0}, {true, 0, 0, 0});
      CrossCoreSetFlag<2, PIPE_MTE2>(4);
      SetFlag<HardEvent::MTE2_V>(0);
      WaitFlag<HardEvent::MTE2_V>(0);
      Cast(z, ci, RoundMode::CAST_NONE, count);
      PipeBarrier<PIPE_V>();
      for (int c = 0; c < stride; c += 64) {
        uint64_t mask = stride - c < 64 ? stride - c : 64;
        Mul(z[c], z[c], sc[c], mask, (uint8_t)vm,
            {1, 1, 1, (uint8_t)(stride / 8), (uint8_t)(stride / 8), 0});
      }
      PipeBarrier<PIPE_V>();
      GmmDirectVectorCounter(z, t, u, count);
      Cast(out, u, RoundMode::CAST_RINT, count);
      PipeBarrier<PIPE_V>();
      SetFlag<HardEvent::V_MTE3>(0);
      WaitFlag<HardEvent::V_MTE3>(0);
      DataCopyPad(yy[(int64_t)(start + mi + vstart) * N + ni], out,
                  {(uint16_t)vm, (uint32_t)(rn * 2), 0, (uint32_t)((N - rn) * 2), 0});
      SetFlag<HardEvent::MTE3_S>(0);
      WaitFlag<HardEvent::MTE3_S>(0);
    } else
      CrossCoreSetFlag<2, PIPE_MTE2>(4);
  }
}

static __attribute__((noinline)) bool TryLowuRaw(GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR g,
                                                 GM_ADDR y, int M, int N, int K, int E,
                                                 int64_t availableCoreNum, aclrtStream stream) {
  if (!(K > 64 && K <= 256 && N >= 32 && N <= 256 && M >= 32 && (int64_t)M * N <= 32768 && E <= 16))
    return false;
  int active = M < E ? M : E;
  bool aligned = (K % 32 == 0 && N % 32 == 0);
  int bm = aligned ? 16 : 32, bn = aligned ? 128 : 64;
  int64_t upper = (active + (M - active) / bm) * (int64_t)((N + bn - 1) / bn);
  if (upper < 4 || upper > availableCoreNum)
    return false;
  int blocks = (int)upper;
  void *work = nullptr;
  aclrtMalloc(&work, (uint64_t)blocks * bm * bn * 4, ACL_MEM_MALLOC_HUGE_FIRST);
  if (aligned) {
    if (E == 1)
      grouped_matmul_gelu_lowu_raw<16, 128, true>
          <<<blocks, nullptr, stream>>>(x, w, s, g, y, (GM_ADDR)work, M, N, K, E);
    else
      grouped_matmul_gelu_lowu_raw<16, 128, false>
          <<<blocks, nullptr, stream>>>(x, w, s, g, y, (GM_ADDR)work, M, N, K, E);
  } else {
    if (E == 1)
      grouped_matmul_gelu_lowu_raw<32, 64, true>
          <<<blocks, nullptr, stream>>>(x, w, s, g, y, (GM_ADDR)work, M, N, K, E);
    else
      grouped_matmul_gelu_lowu_raw<32, 64, false>
          <<<blocks, nullptr, stream>>>(x, w, s, g, y, (GM_ADDR)work, M, N, K, E);
  }
  aclrtSynchronizeStream(stream);
  aclrtFree(work);
  return true;
}

template <int BM, int BN, bool CONSTANT>
__global__ __mix__(1, 2)
    __attribute__((section(".night_packed_static"))) void grouped_matmul_gelu_packed_static(
        GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR g, GM_ADDR y, GM_ADDR work, GM_ADDR packedWeight,
        GM_ADDR packedX, int M, int N, int NP, int K, int KP, int E, int cores, TCubeTiling td) {
  constexpr int BC = BM * BN;
  constexpr int VM = BM / 2;
  TPipe pipe;
  constexpr static auto STATIC_CFG = fixed_max_tile_tiling<BM, BN>();
  using MM =
      typename Std::conditional<CONSTANT, matmul::MatmulImpl<AT, BType, CT, BIAS, STATIC_CFG>,
                                matmul::MatmulImpl<AT, BType, CT, BIAS, CFG_MDL>>::type;
  MM mm;
  TBuf<TPosition::VECIN> cb, sb;
  TBuf<TPosition::VECCALC> zb, tb, ub;
  TBuf<TPosition::VECOUT> ob;
  if ASCEND_IS_AIC {
    mm.SetSubBlockIdx(0);
    mm.Init(&td, &pipe);
  }
  if ASCEND_IS_AIV {
    pipe.InitBuffer(cb, VM * BN * 4);
    pipe.InitBuffer(sb, BN * 4);
    pipe.InitBuffer(tb, VM * BN * 4);
    pipe.InitBuffer(ob, VM * BN * 2);
  }
  GlobalTensor<int8_t> xx, ww;
  GlobalTensor<float> ss;
  GlobalTensor<int64_t> gg;
  GlobalTensor<half> yy;
  GlobalTensor<int32_t> cc;
  xx.SetGlobalBuffer((__gm__ int8_t *)packedX);
  ww.SetGlobalBuffer((__gm__ int8_t *)packedWeight);
  ss.SetGlobalBuffer((__gm__ float *)s);
  gg.SetGlobalBuffer((__gm__ int64_t *)g);
  yy.SetGlobalBuffer((__gm__ half *)y);
  cc.SetGlobalBuffer((__gm__ int32_t *)work);
  if ASCEND_IS_AIV {
    PackWeightsWithKAlignment<BN>(w, packedWeight, g, E, K, KP, N, NP, pipe, cb.Get<int8_t>());
    PackXWithKAlignment<BN>(x, packedX, M, K, KP, pipe, cb.Get<int8_t>());
  }
  SyncAll<false>();
  int bid = GetBlockIdx(), sub = 0;
  if ASCEND_IS_AIV {
    bid = GetBlockIdx() / 2;
    sub = GetSubBlockIdx();
  }
                                                                         
                                                                          
  TEventID outputDone = 0;
  bool outputPending = false;
  if ASCEND_IS_AIV {
    outputDone = pipe.FetchEventID(HardEvent::MTE3_V);
  }
  int tileBase = 0, start = 0, serial = 0;
  for (int e = 0; e < E; ++e) {
    int end = (int)gg.GetValue(e), rows = end - start, nt = (N + BN - 1) / BN,
        mt = (rows + BM - 1) / BM, tasks = mt * nt;
    int local = (bid - tileBase % cores + cores) % cores;
    for (int ti = local; ti < tasks; ti += cores) {
      int mi = (ti / nt) * BM, ni = (ti % nt) * BN, rm = rows - mi, rn = N - ni;
      if (rm > BM)
        rm = BM;
      if (rn > BN)
        rn = BN;
      int cn = BN;
      int64_t coff = ((serial % RING) * cores + bid) * (int64_t)BC;
      if ASCEND_IS_AIC {
        if (serial >= RING)
          CrossCoreWaitFlag(FREE_FLAG + serial % RING);
        mm.SetOrgShape(M, NP, KP, KP, BN);
        mm.SetSingleShape(rm, cn, KP);
        mm.SetTensorA(xx[(start + mi) * (int64_t)KP]);
        mm.SetTensorB(ww[e * (int64_t)KP * NP + ni]);
        while (mm.Iterate()) {
          mm.GetTensorC(cc[coff], 0, false);
        }
        CrossCoreSetFlag<2, PIPE_FIX>(READY_FLAG + serial % RING);
      }
      if ASCEND_IS_AIV {
        auto ci = cb.Get<int32_t>();
        auto sc = sb.Get<float>();
        auto z = cb.Get<float>();
        auto t = tb.Get<float>();
        auto u = cb.Get<float>();
        auto o = tb.Get<half>();
        int split = (rm + 1) / 2, vstart = sub * split, vm = rm - vstart;
        if (vm > split)
          vm = split;
        if (vm < 0)
          vm = 0;
        int stride = (rn + 15) / 16 * 16;
        CrossCoreWaitFlag(READY_FLAG + serial % RING);
        int totalVm = vm;
        for (int vr = 0; vr < totalVm; vr += VM) {
          vm = totalVm - vr;
          if (vm > VM)
            vm = VM;
          auto inputReuse = pipe.FetchEventID(HardEvent::V_MTE2);
          SetFlag<HardEvent::V_MTE2>(inputReuse);
          WaitFlag<HardEvent::V_MTE2>(inputReuse);
          DataCopyExtParams cp{(uint16_t)vm, (uint32_t)(rn * 4), (uint32_t)((BN - rn) * 4),
                               (uint32_t)((stride - (rn + 7) / 8 * 8) / 8), 0};
          DataCopyPadExtParams<int32_t> ip{true, 0, 0, 0};
          DataCopyPad(ci, cc[coff + (vstart + vr) * BN], cp, ip);
          DataCopyExtParams sp{1, (uint32_t)(rn * 4), 0, 0, 0};
          DataCopyPadExtParams<float> fp{true, 0, 0, 0};
          DataCopyPad(sc, ss[e * (int64_t)N + ni], sp, fp);
          auto ev = pipe.FetchEventID(HardEvent::MTE2_V);
          SetFlag<HardEvent::MTE2_V>(ev);
          WaitFlag<HardEvent::MTE2_V>(ev);
          if (vr + vm >= totalVm)
            CrossCoreSetFlag<2, PIPE_MTE2>(FREE_FLAG + serial % RING);
          int count = vm * stride;
          Cast(z, ci, RoundMode::CAST_NONE, count);
          PipeBarrier<PIPE_V>();
          for (int c = 0; c < stride; c += 64) {
            uint64_t mask = (stride - c < 64 ? stride - c : 64);
            Mul(z[c], z[c], sc[c], mask, (uint8_t)vm,
                {1, 1, 1, (uint8_t)(stride / 8), (uint8_t)(stride / 8), 0});
          }
                                                                          
                                                                              
          if (outputPending) {
            WaitFlag<HardEvent::MTE3_V>(outputDone);
            outputPending = false;
          }
          PipeBarrier<PIPE_V>();
          GmmDirectVectorCounter(z, t, u, count);
          Cast(o, u, RoundMode::CAST_RINT, count);
          PipeBarrier<PIPE_V>();
          auto ev2 = pipe.FetchEventID(HardEvent::V_MTE3);
          SetFlag<HardEvent::V_MTE3>(ev2);
          WaitFlag<HardEvent::V_MTE3>(ev2);
          DataCopyExtParams op{(uint16_t)vm, (uint32_t)(rn * 2),
                               (uint32_t)((stride - (rn + 15) / 16 * 16) / 16),
                               (uint32_t)((N - rn) * 2), 0};
          DataCopyPad(yy[(start + mi + vstart + vr) * (int64_t)N + ni], o, op);
          SetFlag<HardEvent::MTE3_V>(outputDone);
          outputPending = true;
        }
        if (!totalVm)
          CrossCoreSetFlag<2, PIPE_MTE2>(FREE_FLAG + serial % RING);
      }
      ++serial;
    }
    tileBase += tasks;
    start = end;
  }
  if ASCEND_IS_AIV {
    if (outputPending)
      WaitFlag<HardEvent::MTE3_V>(outputDone);
  }
  if ASCEND_IS_AIC {
    mm.End();
    for (int i = 0; i < (serial < RING ? serial : RING); ++i)
      CrossCoreWaitFlag(FREE_FLAG + (serial - 1 - i) % RING);
  }
}

static __attribute__((noinline)) void
LaunchNightPackedStatic(GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR g, GM_ADDR y, GM_ADDR work,
                        GM_ADDR packedWeight, GM_ADDR packedX, int M, int N, int NP, int K, int KP,
                        int E, int cores, TCubeTiling td, aclrtStream stream) {
  grouped_matmul_gelu_packed_static<128, 256, true><<<cores, nullptr, stream>>>(
      x, w, s, g, y, work, packedWeight, packedX, M, N, NP, K, KP, E, cores, td);
}

template <int BN>
__aicore__ inline void PackXHdNative42(GM_ADDR source, GM_ADDR dest, int M, int K, int KP,
                                       TPipe &pipe, LocalTensor<int8_t> stage) {
  GlobalTensor<int8_t> input, output;
  input.SetGlobalBuffer((__gm__ int8_t *)source);
  output.SetGlobalBuffer((__gm__ int8_t *)dest);
  constexpr int SZ = 32 * BN * 4;
  int batch = SZ / KP, workers = GetBlockNum() * 2, id = GetBlockIdx();
  auto prior = pipe.FetchEventID(HardEvent::MTE3_V);
  SetFlag<HardEvent::MTE3_V>(prior);
  WaitFlag<HardEvent::MTE3_V>(prior);
  Duplicate(stage.ReinterpretCast<int32_t>(), int32_t(0), SZ / 4);
  PipeBarrier<PIPE_V>();
  auto z = pipe.FetchEventID(HardEvent::V_MTE2);
  SetFlag<HardEvent::V_MTE2>(z);
  WaitFlag<HardEvent::V_MTE2>(z);
  for (int row = id * batch; row < M; row += workers * batch) {
    int rows = M - row;
    if (rows > batch)
      rows = batch;
    DataCopyExtParams cp{(uint16_t)rows, (uint32_t)K, 0, (uint32_t)((KP - (K + 31) / 32 * 32) / 32),
                         0};
    DataCopyPadExtParams<int8_t> pad{true, 0, 0, 0};
    DataCopyPad(stage, input[(int64_t)row * K], cp, pad);
    auto r = pipe.FetchEventID(HardEvent::MTE2_MTE3);
    SetFlag<HardEvent::MTE2_MTE3>(r);
    WaitFlag<HardEvent::MTE2_MTE3>(r);
    DataCopy(output[(int64_t)row * KP], stage, rows * KP);
    auto f = pipe.FetchEventID(HardEvent::MTE3_MTE2);
    SetFlag<HardEvent::MTE3_MTE2>(f);
    WaitFlag<HardEvent::MTE3_MTE2>(f);
  }
}

template <int BM, int BN, int KC> class DirectResHdNative42 {
  TBuf<TPosition::A1> a1b;
  TBuf<TPosition::B1> b1b;
  TBuf<TPosition::A2> a2b;
  TBuf<TPosition::B2> b2b;
  TBuf<TPosition::CO1> c1b;
  TPipe *pipe;
  int serial = 0, kidx = 0;
  TEventID l1Free[2], bReady[2], l0Free[2], cFree;

public:
  __aicore__ inline void Init(TPipe &p) {
    pipe = &p;
    SetMMRowMajor();
    p.InitBuffer(a1b, BM * 2048);
    p.InitBuffer(b1b, 2 * KC * BN);
    p.InitBuffer(a2b, 2 * BM * KC);
    p.InitBuffer(b2b, 2 * KC * BN);
    p.InitBuffer(c1b, BM * BN * 4);
    for (int i = 0; i < 2; ++i) {
      l1Free[i] = p.AllocEventID<HardEvent::MTE1_MTE2>();
      bReady[i] = p.AllocEventID<HardEvent::MTE2_MTE1>();
    }
    for (int i = 0; i < 2; ++i)
      l0Free[i] = p.AllocEventID<HardEvent::M_MTE1>();
    cFree = p.AllocEventID<HardEvent::FIX_M>();
  }
  __aicore__ inline int NextPackTask(int task, int limit, int workers, int parts,
                                     GlobalTensor<int64_t> gg) {
    for (; task < limit; task += workers) {
      int e = task / parts;
      int start = e ? (int)gg.GetValue(e - 1) : 0;
      if ((int)gg.GetValue(e) > start)
        return task;
    }
    return limit;
  }
  __aicore__ inline void PreloadPackW(GlobalTensor<int8_t> input, int task, int seq, int parts,
                                      int batch, int K, int KP, int N, int NP, TEventID *ready,
                                      TEventID *free) {
    int slot = seq % 2, e = task / parts, row = task % parts * batch, rows = KP - row;
    if (rows > batch)
      rows = batch;
    int valid = K - row;
    if (valid > rows)
      valid = rows;
    if (valid < 0)
      valid = 0;
    auto stage = a1b.template Get<int8_t>()[slot * 65536];
    if (seq >= 2)
      WaitFlag<HardEvent::MTE3_MTE2>(free[slot]);
    if (valid < rows) {
      InitConstValueParams<uint16_t> zero;
      zero.repeatTimes = NP / 32;
      zero.blockNum = rows - valid;
      zero.dstGap = valid;
      zero.initValue = 0;
      InitConstValue(stage.ReinterpretCast<uint16_t>()[valid * 16], zero);
      PipeBarrier<PIPE_MTE2>();
    }
                                                                         
                                                                                
    int validNP = (N + 31) / 32 * 32;
    if (NP > validNP) {
      InitConstValueParams<int8_t> zero;
      zero.repeatTimes = 1;
      zero.blockNum = (NP - validNP) * rows / 32;
      zero.dstGap = 0;
      zero.initValue = 0;
      InitConstValue(stage[validNP * rows], zero);
      PipeBarrier<PIPE_MTE2>();
    }
    Nd2NzParams bp;
    bp.ndNum = 1;
    bp.nValue = valid;
    bp.dValue = N;
    bp.srcDValue = N;
    bp.srcNdMatrixStride = 0;
    bp.dstNzC0Stride = rows;
    bp.dstNzNStride = 1;
    bp.dstNzMatrixStride = 0;
    if (valid)
      DataCopy(stage, input[(e * (int64_t)K + row) * N], bp);
    SetFlag<HardEvent::MTE2_MTE3>(ready[slot]);
  }
  __aicore__ inline void PackW(GM_ADDR source, GM_ADDR dest, GM_ADDR groups, int E, int K, int KP,
                               int N, int NP) {
    GlobalTensor<int8_t> input, output;
    GlobalTensor<int64_t> gg;
    input.SetGlobalBuffer((__gm__ int8_t *)source);
    output.SetGlobalBuffer((__gm__ int8_t *)dest);
    gg.SetGlobalBuffer((__gm__ int64_t *)groups);
    constexpr int STAGE_BYTES = 65536;
    int batch = STAGE_BYTES / NP / 32 * 32, parts = (KP + batch - 1) / batch, id = GetBlockIdx(),
        workers = GetBlockNum(), limit = E * parts;
    TEventID ready[2], free[2];
    for (int i = 0; i < 2; ++i) {
      ready[i] = pipe->AllocEventID<HardEvent::MTE2_MTE3>();
      free[i] = pipe->AllocEventID<HardEvent::MTE3_MTE2>();
    }
    int tasks[2];
    tasks[0] = NextPackTask(id, limit, workers, parts, gg);
    tasks[1] = NextPackTask(tasks[0] + workers, limit, workers, parts, gg);
    int last = tasks[1] < limit ? tasks[1] : tasks[0];
    for (int i = 0; i < 2; ++i)
      if (tasks[i] < limit)
        PreloadPackW(input, tasks[i], i, parts, batch, K, KP, N, NP, ready, free);
    int seq = 0;
    while (tasks[seq % 2] < limit) {
      int slot = seq % 2, task = tasks[slot], e = task / parts, row = task % parts * batch,
          rows = KP - row;
      if (rows > batch)
        rows = batch;
      WaitFlag<HardEvent::MTE2_MTE3>(ready[slot]);
      auto stage = a1b.template Get<int8_t>()[slot * STAGE_BYTES];
      DataCopyParams nz;
      nz.blockCount = NP / 32;
      nz.blockLen = rows;
      nz.srcStride = 0;
      nz.dstStride = KP - rows;
      DataCopy(output[e * (int64_t)KP * NP + row * 32], stage, nz);
      SetFlag<HardEvent::MTE3_MTE2>(free[slot]);
      int next = NextPackTask(last + workers, limit, workers, parts, gg);
      tasks[slot] = next;
      if (next < limit) {
        PreloadPackW(input, next, seq + 2, parts, batch, K, KP, N, NP, ready, free);
        last = next;
      }
      ++seq;
    }
    for (int i = 0; i < 2 && i < seq; ++i)
      WaitFlag<HardEvent::MTE3_MTE2>(free[i]);
    for (int i = 0; i < 2; ++i) {
      pipe->ReleaseEventID<HardEvent::MTE2_MTE3>(ready[i]);
      pipe->ReleaseEventID<HardEvent::MTE3_MTE2>(free[i]);
    }
  }
  __aicore__ inline void LoadA(GlobalTensor<int8_t> a, int K, int rm) {
    auto a1 = a1b.template Get<int8_t>();
    Nd2NzParams ap;
    ap.ndNum = 1;
    ap.nValue = rm;
    ap.dValue = K;
    ap.srcDValue = K;
    ap.srcNdMatrixStride = 0;
    ap.dstNzC0Stride = BM;
    ap.dstNzNStride = 1;
    ap.dstNzMatrixStride = 0;
    auto aConsumed = pipe->FetchEventID(HardEvent::MTE1_MTE2);
    SetFlag<HardEvent::MTE1_MTE2>(aConsumed);
    WaitFlag<HardEvent::MTE1_MTE2>(aConsumed);
    if (rm % 16) {
      InitConstValueParams<int8_t> zero;
      zero.repeatTimes = 1;
      zero.blockNum = BM * K / 32;
      zero.dstGap = 0;
      zero.initValue = 0;
      InitConstValue(a1, zero);
      PipeBarrier<PIPE_MTE2>();
    }
    DataCopy(a1, a, ap);
    auto aReady = pipe->FetchEventID(HardEvent::MTE2_MTE1);
    SetFlag<HardEvent::MTE2_MTE1>(aReady);
    WaitFlag<HardEvent::MTE2_MTE1>(aReady);
  }
  __aicore__ inline void Tile(GlobalTensor<int8_t> b, GlobalTensor<int32_t> c, int K, int N, int rm,
                              int rn) {
    auto a1 = a1b.template Get<int8_t>();
    auto c1 = c1b.template Get<int32_t>();
    int na = (rn + 15) / 16 * 16;
    int rotation = ((GetBlockIdx() * 3) % (K / KC)) * KC;
    for (int done = 0; done < K; done += KC) {
      int kpos = done + rotation;
      if (kpos >= K)
        kpos -= K;
      int rk = K - done;
      if (rk > KC)
        rk = KC;
      int kp = (rk + 31) / 32 * 32;
      int s = kidx % 2;
      auto a2 = a2b.template Get<int8_t>()[s * BM * KC];
      auto b2 = b2b.template Get<int8_t>()[s * KC * BN];
      auto b1 = b1b.template Get<int8_t>()[s * KC * BN];
      if (kidx >= 2)
        WaitFlag<HardEvent::MTE1_MTE2>(l1Free[s]);
      DataCopyParams nz;
      nz.blockCount = (rn + 31) / 32;
      nz.blockLen = kp;
      nz.srcStride = K - kp;
      nz.dstStride = KC - kp;
      DataCopy(b1, b[kpos * 32], nz);
      SetFlag<HardEvent::MTE2_MTE1>(bReady[s]);
      if (kidx >= 2)
        WaitFlag<HardEvent::M_MTE1>(l0Free[s]);
      WaitFlag<HardEvent::MTE2_MTE1>(bReady[s]);
      LoadData2dTransposeParams bl;
      bl.startIndex = 0;
      bl.repeatTimes = (rn + 31) / 32;
      bl.srcStride = kp / 32;
      bl.dstGap = 1;
      bl.dstFracGap = 0;
      for (int i = 0; i < kp / 32; ++i)
        LoadDataWithTranspose(b2[i * na * 32], b1[i * 1024], bl);
      LoadData2DParams al;
      al.startIndex = 0;
      al.repeatTimes = kp / 32;
      al.srcStride = BM / 16;
      al.dstGap = 0;
      al.ifTranspose = false;
      for (int i = 0; i < (rm + 15) / 16; ++i)
        LoadData(a2[i * kp * 16], a1[i * 512 + (kpos / 32) * (BM * 32)], al);
      SetFlag<HardEvent::MTE1_MTE2>(l1Free[s]);
      auto mr = pipe->FetchEventID(HardEvent::MTE1_M);
      SetFlag<HardEvent::MTE1_M>(mr);
      WaitFlag<HardEvent::MTE1_M>(mr);
      MmadParams mp;
      mp.m = (rm + 15) / 16 * 16;
      mp.n = na;
      mp.k = kp;
      mp.cmatrixInitVal = (done == 0);
      mp.unitFlag = (done + rk >= K ? 3 : 2);
      if (done == 0 && serial >= 1)
        WaitFlag<HardEvent::FIX_M>(cFree);
      Mmad(c1, a2, b2, mp);
      SetFlag<HardEvent::M_MTE1>(l0Free[s]);
      ++kidx;
    }
    FixpipeParamsV220 fp;
    fp.unitFlag = 3;
    fp.mSize = (rm + 15) / 16 * 16;
    fp.nSize = na;
    fp.srcStride = (rm + 15) / 16 * 16;
    fp.dstStride = BN;
    fp.quantPre = QuantMode_t::NoQuant;
    Fixpipe<int32_t, int32_t, CFG_ROW_MAJOR>(c, c1, fp);
    SetFlag<HardEvent::FIX_M>(cFree);
    ++serial;
  }
  __aicore__ inline void End() {
    for (int i = 0; i < 2 && i < kidx; ++i)
      WaitFlag<HardEvent::MTE1_MTE2>(l1Free[i]);
    for (int i = 0; i < 2 && i < kidx; ++i)
      WaitFlag<HardEvent::M_MTE1>(l0Free[i]);
    if (serial)
      WaitFlag<HardEvent::FIX_M>(cFree);
    for (int i = 0; i < 2; ++i) {
      pipe->ReleaseEventID<HardEvent::MTE1_MTE2>(l1Free[i]);
      pipe->ReleaseEventID<HardEvent::MTE2_MTE1>(bReady[i]);
    }
    for (int i = 0; i < 2; ++i)
      pipe->ReleaseEventID<HardEvent::M_MTE1>(l0Free[i]);
    pipe->ReleaseEventID<HardEvent::FIX_M>(cFree);
    PipeBarrier<PIPE_ALL>();
  }
};

template <int BM, int BN, int KC>
__global__ __mix__(1, 2)
    __attribute__((section(".night_hd_native42"))) void grouped_matmul_gelu_hd_native42(
        GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR g, GM_ADDR y, GM_ADDR work, GM_ADDR packedWeight,
        GM_ADDR packedX, int M, int N, int NP, int K, int KP, int E, int cores) {
  constexpr int RING = 4;
  constexpr uint16_t READY_FLAG = 7, FREE_FLAG = 3;
  constexpr int BC = BM * BN;
  TPipe pipe;
  DirectResHdNative42<BM, BN, KC> mm;
  TBuf<TPosition::VECIN> cb, sb;
  TBuf<TPosition::VECCALC> tb;
  TBuf<TPosition::VECOUT> ob;
  if ASCEND_IS_AIC {
    mm.Init(pipe);
  }
  if ASCEND_IS_AIV {
    pipe.InitBuffer(cb, 64 * BN * 4);
    pipe.InitBuffer(sb, BN * 4 + 256);
    pipe.InitBuffer(tb, 64 * BN * 4 + 256);
    pipe.InitBuffer(ob, 64 * BN * 2);
  }
  GlobalTensor<int8_t> xx, ww;
  GlobalTensor<float> ss;
  GlobalTensor<int64_t> gg;
  GlobalTensor<half> yy;
  GlobalTensor<int32_t> cc;
  xx.SetGlobalBuffer((__gm__ int8_t *)packedX);
  ww.SetGlobalBuffer((__gm__ int8_t *)packedWeight);
  ss.SetGlobalBuffer((__gm__ float *)s);
  gg.SetGlobalBuffer((__gm__ int64_t *)g);
  yy.SetGlobalBuffer((__gm__ half *)y);
  cc.SetGlobalBuffer((__gm__ int32_t *)work);
  if ASCEND_IS_AIC {
    mm.PackW(w, packedWeight, g, E, K, KP, N, NP);
  }
  if ASCEND_IS_AIV {
    PackXHdNative42<BN>(x, packedX, M, K, KP, pipe, cb.Get<int8_t>());
  }
  SyncAll<false>();
  int bid = GetBlockIdx(), sub = 0;
  if ASCEND_IS_AIV {
    bid = GetBlockIdx() / 2;
    sub = GetSubBlockIdx();
  }
  TEventID outputDone = 0, inputConsumed = 0;
  bool outputPending = false, inputPending = false;
  if ASCEND_IS_AIV {
    outputDone = pipe.AllocEventID<HardEvent::MTE3_V>();
    inputConsumed = pipe.AllocEventID<HardEvent::V_MTE2>();
  }
                                                                                     
                                                                                
  int actualMtiles = 0, previous = 0;
  for (int e = 0; e < E; ++e) {
    int end = (int)gg.GetValue(e);
    actualMtiles += (end - previous + BM - 1) / BM;
    previous = end;
  }
  int nt = (N + BN - 1) / BN, totalTiles = actualMtiles * nt;
                                                                                
  int used = cores, waves = (totalTiles + cores - 1) / cores;
  if (waves >= 3) {
    int minimum = (cores * 4 + 4) / 5;
    used = (totalTiles + waves - 1) / waves;
    if (used < minimum)
      used = minimum;
  }
  int ownedFirst = bid < used ? (int)((int64_t)totalTiles * bid / used) : totalTiles;
  int ownedLast = bid < used ? (int)((int64_t)totalTiles * (bid + 1) / used) : totalTiles;
  int serial = 0, start = 0, tileBase = 0;
  for (int e = 0; e < E; ++e) {
    int end = (int)gg.GetValue(e), rows = end - start, mt = (rows + BM - 1) / BM,
        groupTiles = mt * nt;
    int first = ownedFirst - tileBase;
    if (first < 0)
      first = 0;
    int last = ownedLast - tileBase;
    if (last > groupTiles)
      last = groupTiles;
    int loadedMi = -1;
    for (int tile = first; tile < last; ++tile) {
      int mi = (tile / nt) * BM, ni = tile % nt, rm = rows - mi;
      if (rm > BM)
        rm = BM;
      if ASCEND_IS_AIC {
        if (mi != loadedMi) {
          mm.LoadA(xx[(start + mi) * (int64_t)KP], KP, rm);
          loadedMi = mi;
        }
      }
      {
        int rn = N - ni * BN;
        if (rn > BN)
          rn = BN;
        int64_t coff = ((serial % RING) * cores + bid) * (int64_t)BC;
        if ASCEND_IS_AIC {
          if (serial >= RING)
            CrossCoreWaitFlag(FREE_FLAG + serial % RING);
          mm.Tile(ww[e * (int64_t)KP * NP + ni * (int64_t)BN * KP], cc[coff], KP, NP, rm, BN);
          CrossCoreSetFlag<2, PIPE_FIX>(READY_FLAG + serial % RING);
        }
        if ASCEND_IS_AIV {
          auto ci = cb.Get<int32_t>();
          auto sc = sb.Get<float>();
          auto z = cb.Get<float>();
          auto t = tb.Get<float>();
          auto u = cb.Get<float>();
          auto o = ob.Get<half>();
          int split = (rm + 1) / 2, vstart = sub * split, vm = rm - vstart;
          if (vm > split)
            vm = split;
          if (vm < 0)
            vm = 0;
          int stride = (rn + 15) / 16 * 16;
          CrossCoreWaitFlag(READY_FLAG + serial % RING);
          int totalVm = vm;
          for (int vr = 0; vr < totalVm; vr += 64) {
            vm = totalVm - vr;
            if (vm > 64)
              vm = 64;
            if (inputPending) {
              WaitFlag<HardEvent::V_MTE2>(inputConsumed);
              inputPending = false;
            }
            DataCopyExtParams cp{(uint16_t)vm, (uint32_t)(rn * 4), (uint32_t)((BN - rn) * 4),
                                 (uint32_t)((stride - (rn + 7) / 8 * 8) / 8), 0};
            DataCopyPadExtParams<int32_t> ip{true, 0, 0, 0};
            DataCopyPad(ci, cc[coff + (vstart + vr) * BN], cp, ip);
            DataCopyExtParams sp{1, (uint32_t)(rn * 4), 0, 0, 0};
            DataCopyPadExtParams<float> fp{true, 0, 0, 0};
            DataCopyPad(sc, ss[e * (int64_t)N + ni * BN], sp, fp);
            auto ev = pipe.FetchEventID(HardEvent::MTE2_V);
            SetFlag<HardEvent::MTE2_V>(ev);
            WaitFlag<HardEvent::MTE2_V>(ev);
            if (vr + vm >= totalVm)
              CrossCoreSetFlag<2, PIPE_MTE2>(FREE_FLAG + serial % RING);
            int count = vm * stride;
            Cast(z, ci, RoundMode::CAST_NONE, count);
            PipeBarrier<PIPE_V>();
            for (int c = 0; c < stride; c += 64) {
              uint64_t mask = (stride - c < 64 ? stride - c : 64);
              Mul(z[c], z[c], sc[c], mask, (uint8_t)vm,
                  {1, 1, 1, (uint8_t)(stride / 8), (uint8_t)(stride / 8), 0});
            }
            PipeBarrier<PIPE_V>();
            GmmDirectVectorCounter(z, t, u, count);
            if (outputPending) {
              WaitFlag<HardEvent::MTE3_V>(outputDone);
              outputPending = false;
            }
            Cast(o, u, RoundMode::CAST_RINT, count);
            PipeBarrier<PIPE_V>();
                                                                                        
            SetFlag<HardEvent::V_MTE2>(inputConsumed);
            inputPending = true;
            auto ev2 = pipe.FetchEventID(HardEvent::V_MTE3);
            SetFlag<HardEvent::V_MTE3>(ev2);
            WaitFlag<HardEvent::V_MTE3>(ev2);
            DataCopyExtParams op{(uint16_t)vm, (uint32_t)(rn * 2),
                                 (uint32_t)((stride - (rn + 15) / 16 * 16) / 16),
                                 (uint32_t)((N - rn) * 2), 0};
            DataCopyPad(yy[(start + mi + vstart + vr) * (int64_t)N + ni * BN], o, op);
            SetFlag<HardEvent::MTE3_V>(outputDone);
            outputPending = true;
          }
          if (!totalVm)
            CrossCoreSetFlag<2, PIPE_MTE2>(FREE_FLAG + serial % RING);
        }
        ++serial;
      }
    }
    tileBase += groupTiles;
    start = end;
  }
  if ASCEND_IS_AIV {
    if (inputPending)
      WaitFlag<HardEvent::V_MTE2>(inputConsumed);
    if (outputPending)
      WaitFlag<HardEvent::MTE3_V>(outputDone);
    pipe.ReleaseEventID<HardEvent::V_MTE2>(inputConsumed);
    pipe.ReleaseEventID<HardEvent::MTE3_V>(outputDone);
  }
  if ASCEND_IS_AIC {
    mm.End();
    for (int i = 0; i < (serial < RING ? serial : RING); ++i)
      CrossCoreWaitFlag(FREE_FLAG + (serial - 1 - i) % RING);
  }
}

static __attribute__((noinline)) void RunHdNative42(GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR g,
                                                    GM_ADDR y, int M, int N, int K, int E,
                                                    int cores, aclrtStream stream) {
  int NP = (N + 255) / 256 * 256, KP = (K + 127) / 128 * 128;
  uint64_t cb = (uint64_t)cores * 4 * 128 * 256 * 4, wb = (uint64_t)E * KP * NP,
           xb = (uint64_t)M * KP;
  void *work = nullptr;
  aclrtMalloc(&work, cb + wb + xb, ACL_MEM_MALLOC_HUGE_FIRST);
  grouped_matmul_gelu_hd_native42<128, 256, 128>
      <<<cores, nullptr, stream>>>(x, w, s, g, y, (GM_ADDR)work, (GM_ADDR)((uint8_t *)work + cb),
                                   (GM_ADDR)((uint8_t *)work + cb + wb), M, N, NP, K, KP, E, cores);
  aclrtSynchronizeStream(stream);
  aclrtFree(work);
}

                                                                           
                                                                               
                                                                              
template <int Columns, int Rows, int MaxK = 4>
__global__ __vector__ __attribute__((section(".onsite_shortdot"))) void
grouped_matmul_gelu_short_dot_batched(GM_ADDR x, GM_ADDR w, GM_ADDR scale, GM_ADDR groups,
                                      GM_ADDR y, int M, int N, int K, int E) {
  TPipe pipe;
  TBuf<TPosition::VECIN> inputBytes, weightBytes, scaleBuffer;
  TBuf<TPosition::VECCALC> inputHalf, weightHalf, values, temporary;
  TBuf<TPosition::VECOUT> outputBuffer;
  pipe.InitBuffer(inputBytes, Rows * 32);
  pipe.InitBuffer(inputHalf, Rows * 64);
  pipe.InitBuffer(weightBytes, MaxK * Columns);
  pipe.InitBuffer(weightHalf, 2 * MaxK * Columns);
  pipe.InitBuffer(scaleBuffer, 4 * Columns);
  pipe.InitBuffer(values, Rows * Columns * 4);
  pipe.InitBuffer(temporary, Rows * Columns * 4);
  pipe.InitBuffer(outputBuffer, Rows * Columns * 2);

  auto input = inputBytes.Get<int8_t>();
  auto inputFp16 = inputHalf.Get<half>();
  auto weight = weightBytes.Get<int8_t>();
  auto weightFp16 = weightHalf.Get<half>();
  auto factors = scaleBuffer.Get<float>();
  auto z = values.Get<float>();
  auto t = temporary.Get<float>();
  auto output = outputBuffer.Get<half>();
  GlobalTensor<int8_t> xx, ww;
  GlobalTensor<float> ss;
  GlobalTensor<int64_t> gg;
  GlobalTensor<half> yy;
  xx.SetGlobalBuffer((__gm__ int8_t *)x);
  ww.SetGlobalBuffer((__gm__ int8_t *)w);
  ss.SetGlobalBuffer((__gm__ float *)scale);
  gg.SetGlobalBuffer((__gm__ int64_t *)groups);
  yy.SetGlobalBuffer((__gm__ half *)y);

  int columnTiles = (N + Columns - 1) / Columns;
  int tasks = ((M + Rows - 1) / Rows) * columnTiles;
  for (int task = GetBlockIdx(); task < tasks; task += GetBlockNum()) {
    int rowBase = task / columnTiles * Rows;
    int column = task % columnTiles * Columns;
    int rowCount = M - rowBase;
    if (rowCount > Rows)
      rowCount = Rows;
    int validColumns = N - column;
    if (validColumns > Columns)
      validColumns = Columns;
    int stride = (validColumns + 31) / 32 * 32;

    auto inputFree = pipe.FetchEventID(HardEvent::V_MTE2);
    SetFlag<HardEvent::V_MTE2>(inputFree);
    WaitFlag<HardEvent::V_MTE2>(inputFree);
    DataCopyExtParams inputCopy{(uint16_t)rowCount, (uint32_t)K, 0, 0, 0};
    DataCopyPadExtParams<int8_t> bytePadding{true, 0, 0, 0};
    DataCopyPad(input, xx[(int64_t)rowBase * K], inputCopy, bytePadding);
    auto inputReady = pipe.FetchEventID(HardEvent::MTE2_V);
    SetFlag<HardEvent::MTE2_V>(inputReady);
    WaitFlag<HardEvent::MTE2_V>(inputReady);
    Cast(inputFp16, input, RoundMode::CAST_NONE, rowCount * 32);
    auto scalarReady = pipe.FetchEventID(HardEvent::V_S);
    SetFlag<HardEvent::V_S>(scalarReady);
    WaitFlag<HardEvent::V_S>(scalarReady);

    int expert = 0;
    int first = 0;
    while (first < rowCount) {
      int globalRow = rowBase + first;
      while (expert < E - 1 && globalRow >= gg.GetValue(expert))
        ++expert;
      int segmentRows = (int)gg.GetValue(expert) - globalRow;
      if (segmentRows > rowCount - first)
        segmentRows = rowCount - first;

      auto weightsFree = pipe.FetchEventID(HardEvent::V_MTE2);
      SetFlag<HardEvent::V_MTE2>(weightsFree);
      WaitFlag<HardEvent::V_MTE2>(weightsFree);
      DataCopyExtParams weightCopy{(uint16_t)K, (uint32_t)validColumns,
                                   (uint32_t)(N - validColumns), 0, 0};
      DataCopyPad(weight, ww[(int64_t)expert * K * N + column], weightCopy, bytePadding);
      DataCopyExtParams scaleCopy{1, (uint32_t)(validColumns * 4), 0, 0, 0};
      DataCopyPadExtParams<float> floatPadding{true, 0, 0, 0};
      DataCopyPad(factors, ss[(int64_t)expert * N + column], scaleCopy, floatPadding);
      auto weightsReady = pipe.FetchEventID(HardEvent::MTE2_V);
      SetFlag<HardEvent::MTE2_V>(weightsReady);
      WaitFlag<HardEvent::MTE2_V>(weightsReady);
      Cast(weightFp16, weight, RoundMode::CAST_NONE, K * stride);
      int count = segmentRows * stride;
      Duplicate(z, 0.0f, count);
      PipeBarrier<PIPE_V>();

                                                                         
                                                                         
      for (int k = 0; k < K; ++k) {
        for (int row = 0; row < segmentRows; ++row) {
          half scalar = inputFp16.GetValue((first + row) * 32 + k);
          Axpy(z[row * stride], weightFp16[k * stride], scalar, stride);
        }
        PipeBarrier<PIPE_V>();
      }
      if constexpr (Columns > 1024) {
                                                                 
                                                                
        for (int row = 0; row < segmentRows; ++row) {
          Mul(z[row * stride], z[row * stride], factors, stride);
        }
      } else {
        for (int c = 0; c < stride; c += 64) {
          uint64_t mask = stride - c < 64 ? stride - c : 64;
          Mul(z[c], z[c], factors[c], mask, (uint8_t)segmentRows,
              {1, 1, 1, (uint8_t)(stride / 8), (uint8_t)(stride / 8), 0});
        }
      }
      PipeBarrier<PIPE_V>();
                                                                          
                                                                       
      GmmDirectVectorCounter(z, t, z, count);
      Cast(output, z, RoundMode::CAST_RINT, count);
      PipeBarrier<PIPE_V>();
      auto outputReady = pipe.FetchEventID(HardEvent::V_MTE3);
      SetFlag<HardEvent::V_MTE3>(outputReady);
      WaitFlag<HardEvent::V_MTE3>(outputReady);
      DataCopyExtParams outputCopy{(uint16_t)segmentRows, (uint32_t)(validColumns * 2),
                                   (uint32_t)((stride - (validColumns + 15) / 16 * 16) / 16),
                                   (uint32_t)((N - validColumns) * 2), 0};
      DataCopyPad(yy[(int64_t)globalRow * N + column], output, outputCopy);
      auto outputDone = pipe.FetchEventID(HardEvent::MTE3_V);
      SetFlag<HardEvent::MTE3_V>(outputDone);
      WaitFlag<HardEvent::MTE3_V>(outputDone);
      first += segmentRows;
    }
  }
}

static __attribute__((noinline)) void RunShortDotBatched(GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR g,
                                                         GM_ADDR y, int M, int N, int K, int E,
                                                         int cores, aclrtStream stream) {
  int blocks = cores > 0 ? 2 * cores : 1;
  if (K == 1 && N >= 1024) {
                                                                     
                                                                         
    grouped_matmul_gelu_short_dot_batched<4096, 4, 1>
        <<<blocks, nullptr, stream>>>(x, w, s, g, y, M, N, K, E);
  } else {
    grouped_matmul_gelu_short_dot_batched<512, 32, 4>
        <<<blocks, nullptr, stream>>>(x, w, s, g, y, M, N, K, E);
  }
}

                                                                              
                                                                          
                                                                              
__global__ __vector__ __attribute__((section(".onsite_rank_one"))) void
grouped_matmul_gelu_rank_one_current_lookup_pipeline(GM_ADDR x, GM_ADDR w, GM_ADDR scale,
                                                     GM_ADDR groups, GM_ADDR y, GM_ADDR lookup,
                                                     int M, int N, int E, int NP) {
  constexpr int Columns = 512;
  constexpr int TransformRows = 32;
  constexpr int CopyRows = 8;
  TPipe pipe;
  TBuf<TPosition::VECIN> weightBuffer, scaleBuffer, inputBuffer;
  TBuf<TPosition::VECCALC> halfWeightBuffer, values;
  TBuf<TPosition::VECOUT> outputBuffer;
  pipe.InitBuffer(weightBuffer, Columns);
  pipe.InitBuffer(halfWeightBuffer, Columns * 2);
  pipe.InitBuffer(scaleBuffer, Columns * 4);
  pipe.InitBuffer(inputBuffer, 32);
  pipe.InitBuffer(values, 2 * TransformRows * Columns * 4);
  pipe.InitBuffer(outputBuffer, TransformRows * Columns * 2);
  auto weights = weightBuffer.Get<int8_t>();
  auto halfWeights = halfWeightBuffer.Get<half>();
  auto factors = scaleBuffer.Get<float>();
  auto input = inputBuffer.Get<int8_t>();
  auto z = values.Get<float>();
  auto t = values.Get<float>()[TransformRows * Columns];
  auto output = outputBuffer.Get<half>();
  GlobalTensor<int8_t> xx, ww;
  GlobalTensor<float> ss;
  GlobalTensor<int64_t> gg;
  GlobalTensor<half> yy, table;
  xx.SetGlobalBuffer((__gm__ int8_t *)x);
  ww.SetGlobalBuffer((__gm__ int8_t *)w);
  ss.SetGlobalBuffer((__gm__ float *)scale);
  gg.SetGlobalBuffer((__gm__ int64_t *)groups);
  yy.SetGlobalBuffer((__gm__ half *)y);
  table.SetGlobalBuffer((__gm__ half *)lookup);
  int columnTiles = (N + Columns - 1) / Columns;
  int tasks = E * (256 / TransformRows) * columnTiles;
  for (int task = GetBlockIdx(); task < tasks; task += GetBlockNum()) {
    int expert = task / ((256 / TransformRows) * columnTiles);
    int start = expert ? (int)gg.GetValue(expert - 1) : 0;
    int expertRows = (int)gg.GetValue(expert) - start;
    if (expertRows == 0)
      continue;
                                                                
                                                          
    bool direct = expertRows < 256;
    int valueBase = (task / columnTiles) % (256 / TransformRows) * TransformRows;
    if (direct && valueBase >= expertRows)
      continue;
    int activeRows = direct && expertRows - valueBase < TransformRows
                         ? expertRows - valueBase : TransformRows;
    int column = (task % columnTiles) * Columns;
    int validColumns = N - column;
    if (validColumns > Columns)
      validColumns = Columns;
    int stride = (validColumns + 31) / 32 * 32;
    int count = activeRows * stride;
    auto inputFree = pipe.FetchEventID(HardEvent::V_MTE2);
    SetFlag<HardEvent::V_MTE2>(inputFree);
    WaitFlag<HardEvent::V_MTE2>(inputFree);
    DataCopyPadExtParams<int8_t> bytePadding{true, 0, 0, 0};
    DataCopyExtParams weightCopy{1, (uint32_t)validColumns, 0, 0, 0};
    DataCopyPad(weights, ww[(int64_t)expert * N + column], weightCopy, bytePadding);
    DataCopyPadExtParams<float> floatPadding{true, 0, 0, 0};
    DataCopyExtParams scaleCopy{1, (uint32_t)(validColumns * 4), 0, 0, 0};
    DataCopyPad(factors, ss[(int64_t)expert * N + column], scaleCopy, floatPadding);
    if (direct) {
      DataCopyExtParams actualRows{1, (uint32_t)activeRows, 0, 0, 0};
      DataCopyPad(input, xx[start + valueBase], actualRows, bytePadding);
      auto scalarReady = pipe.FetchEventID(HardEvent::MTE2_S);
      SetFlag<HardEvent::MTE2_S>(scalarReady);
      WaitFlag<HardEvent::MTE2_S>(scalarReady);
    }
    auto inputReady = pipe.FetchEventID(HardEvent::MTE2_V);
    SetFlag<HardEvent::MTE2_V>(inputReady);
    WaitFlag<HardEvent::MTE2_V>(inputReady);
    Cast(halfWeights, weights, RoundMode::CAST_NONE, stride);
    Duplicate(z, 0.0f, count);
    PipeBarrier<PIPE_V>();
    for (int row = 0; row < activeRows; ++row) {
                                                                       
                                                                        
      half value = direct ? static_cast<half>(input.GetValue(row))
                          : static_cast<half>(valueBase + row - 128);
      Axpy(z[row * stride], halfWeights, value, stride);
    }
    PipeBarrier<PIPE_V>();
    for (int c = 0; c < stride; c += 64) {
      uint64_t mask = stride - c < 64 ? stride - c : 64;
      Mul(z[c], z[c], factors[c], mask, activeRows,
          {1, 1, 1, (uint8_t)(stride / 8), (uint8_t)(stride / 8), 0});
    }
    PipeBarrier<PIPE_V>();
    GmmDirectVectorCounter(z, t, z, count);
    Cast(output, z, RoundMode::CAST_RINT, count);
    PipeBarrier<PIPE_V>();
    auto outputReady = pipe.FetchEventID(HardEvent::V_MTE3);
    SetFlag<HardEvent::V_MTE3>(outputReady);
    WaitFlag<HardEvent::V_MTE3>(outputReady);
    int targetStride = direct ? N : NP;
    DataCopyExtParams tableCopy{(uint16_t)activeRows, (uint32_t)(validColumns * 2),
                                (uint32_t)((stride - (validColumns + 15) / 16 * 16) / 16),
                                (uint32_t)((targetStride - validColumns) * 2), 0};
    if (direct)
      DataCopyPad(yy[(int64_t)(start + valueBase) * N + column], output, tableCopy);
    else
      DataCopyPad(table[((int64_t)expert * 256 + valueBase) * NP + column], output, tableCopy);
    auto outputDone = pipe.FetchEventID(HardEvent::MTE3_V);
    SetFlag<HardEvent::MTE3_V>(outputDone);
    WaitFlag<HardEvent::MTE3_V>(outputDone);
  }
                                                                           
  SyncAll<true>();

                                                                        
                                                                           
                                                                        
  auto gathered = values.Get<half>();
  TEventID copyReady[2], copyFree[2];
  for (int slot = 0; slot < 2; ++slot) {
    copyReady[slot] = pipe.AllocEventID<HardEvent::MTE2_MTE3>();
    copyFree[slot] = pipe.AllocEventID<HardEvent::MTE3_MTE2>();
  }
  int copySerial = 0;
  int copyTasks = (M + CopyRows - 1) / CopyRows;
  for (int task = GetBlockIdx(); task < copyTasks; task += GetBlockNum()) {
    int slot = copySerial % 2;
    if (copySerial >= 2)
      WaitFlag<HardEvent::MTE3_MTE2>(copyFree[slot]);
    auto batchOutput = gathered[slot * CopyRows * NP];
    int rowBase = task * CopyRows;
    int rows = M - rowBase;
    if (rows > CopyRows)
      rows = CopyRows;
    DataCopyPadExtParams<int8_t> bytePadding{true, 0, 0, 0};
    DataCopyExtParams inputCopy{1, (uint32_t)rows, 0, 0, 0};
    DataCopyPad(input, xx[rowBase], inputCopy, bytePadding);
    auto scalarReady = pipe.FetchEventID(HardEvent::MTE2_S);
    SetFlag<HardEvent::MTE2_S>(scalarReady);
    WaitFlag<HardEvent::MTE2_S>(scalarReady);
    int expert = 0;
    uint32_t copyMask = 0;
    for (int row = 0; row < rows; ++row) {
      while (expert < E - 1 && rowBase + row >= gg.GetValue(expert))
        ++expert;
      int expertStart = expert ? (int)gg.GetValue(expert - 1) : 0;
      if ((int)gg.GetValue(expert) - expertStart < 256)
        continue;                                                       
      copyMask |= 1U << row;
      int value = (int)input.GetValue(row) + 128;
      DataCopyPadExtParams<half> halfPadding{true, 0, 0, 0};
      DataCopyExtParams readCopy{1, (uint32_t)(N * 2), 0, 0, 0};
      DataCopyPad(batchOutput[row * NP], table[((int64_t)expert * 256 + value) * NP], readCopy,
                  halfPadding);
    }
    SetFlag<HardEvent::MTE2_MTE3>(copyReady[slot]);
    WaitFlag<HardEvent::MTE2_MTE3>(copyReady[slot]);
                                                                      
                                                                       
    for (int row = 0; row < rows;) {
      if ((copyMask & (1U << row)) == 0) {
        ++row;
        continue;
      }
      int begin = row++;
      while (row < rows && (copyMask & (1U << row)))
        ++row;
      DataCopyExtParams writeCopy{(uint16_t)(row - begin), (uint32_t)(N * 2), 0, 0, 0};
      DataCopyPad(yy[(int64_t)(rowBase + begin) * N], batchOutput[begin * NP], writeCopy);
    }
    SetFlag<HardEvent::MTE3_MTE2>(copyFree[slot]);
    ++copySerial;
  }
  for (int slot = 0; slot < 2; ++slot) {
    if (copySerial > slot)
      WaitFlag<HardEvent::MTE3_MTE2>(copyFree[slot]);
    pipe.ReleaseEventID<HardEvent::MTE2_MTE3>(copyReady[slot]);
    pipe.ReleaseEventID<HardEvent::MTE3_MTE2>(copyFree[slot]);
  }
}

static __attribute__((noinline)) void RunRankOneCurrentLookup(GM_ADDR x, GM_ADDR w, GM_ADDR s,
                                                              GM_ADDR g, GM_ADDR y, int M, int N,
                                                              int E, int cores,
                                                              aclrtStream stream) {
  int NP = (N + 15) / 16 * 16;
  uint64_t tableBytes = (uint64_t)E * 256 * NP * sizeof(half);
  void *workspace = nullptr;
  aclrtMalloc(&workspace, tableBytes, ACL_MEM_MALLOC_HUGE_FIRST);
  int blocks = cores > 0 ? 2 * cores : 1;
  grouped_matmul_gelu_rank_one_current_lookup_pipeline<<<blocks, nullptr, stream>>>(
      x, w, s, g, y, (GM_ADDR)workspace, M, N, E, NP);
  aclrtSynchronizeStream(stream);
  aclrtFree(workspace);
}

// The compact 32-column weight panel resides in L1 across row tiles.
template <int BM, int BN, int KC> class DirectInt8NarrowBResident {
  TBuf<TPosition::A1> a1b;
  TBuf<TPosition::B1> b1b;
  TBuf<TPosition::A2> a2b;
  TBuf<TPosition::B2> b2b;
  TBuf<TPosition::CO1> c1b;
  TPipe *pipe;
  int serial = 0, kidx = 0;
  TEventID l0Free[2], cFree;

public:
  __aicore__ inline void Init(TPipe &p) {
    pipe = &p;
    p.InitBuffer(a1b, BM * 4096);
    p.InitBuffer(b1b, 4096 * BN);
    p.InitBuffer(a2b, 2 * BM * KC);
    p.InitBuffer(b2b, 2 * KC * BN);
    p.InitBuffer(c1b, BM * BN * 4);
    for (int i = 0; i < 2; ++i)
      l0Free[i] = p.AllocEventID<HardEvent::M_MTE1>();
    cFree = p.AllocEventID<HardEvent::FIX_M>();
  }
                                                              
                                                                              
  __aicore__ inline void LoadB(GlobalTensor<int8_t> b, int KP) {
    static_assert(BN == 32, "resident B requires one C0 block");
    auto consumed = pipe->FetchEventID(HardEvent::MTE1_MTE2);
    SetFlag<HardEvent::MTE1_MTE2>(consumed);
    WaitFlag<HardEvent::MTE1_MTE2>(consumed);
    DataCopy(b1b.template Get<int8_t>(), b, KP * BN);
    auto ready = pipe->FetchEventID(HardEvent::MTE2_MTE1);
    SetFlag<HardEvent::MTE2_MTE1>(ready);
    WaitFlag<HardEvent::MTE2_MTE1>(ready);
  }
  __aicore__ inline void LoadA(GlobalTensor<int8_t> a, int K, int rm) {
    auto a1 = a1b.template Get<int8_t>();
    Nd2NzParams ap;
    ap.ndNum = 1;
    ap.nValue = rm;
    ap.dValue = K;
    ap.srcDValue = K;
    ap.srcNdMatrixStride = 0;
    ap.dstNzC0Stride = BM;
    ap.dstNzNStride = 1;
    ap.dstNzMatrixStride = 0;
    auto aConsumed = pipe->FetchEventID(HardEvent::MTE1_MTE2);
    SetFlag<HardEvent::MTE1_MTE2>(aConsumed);
    WaitFlag<HardEvent::MTE1_MTE2>(aConsumed);
                                                                          
                                                                          
    int paddedM = (rm + 31) / 32 * 32;
    if (paddedM != rm) {
      InitConstValueParams<uint16_t> zero;
      zero.repeatTimes = (K + 31) / 32;
      zero.blockNum = paddedM - rm;
      zero.dstGap = BM - (paddedM - rm);
      zero.initValue = 0;
      InitConstValue(a1.template ReinterpretCast<uint16_t>()[rm * 16], zero);
      PipeBarrier<PIPE_MTE2>();
    }
    DataCopy(a1, a, ap);
    auto aReady = pipe->FetchEventID(HardEvent::MTE2_MTE1);
    SetFlag<HardEvent::MTE2_MTE1>(aReady);
    WaitFlag<HardEvent::MTE2_MTE1>(aReady);
  }
  __aicore__ inline void Tile(GlobalTensor<int8_t> b, GlobalTensor<int32_t> c, int K, int N, int rm,
                              int rn, int cstride) {
    auto a1 = a1b.template Get<int8_t>();
    auto c1 = c1b.template Get<int32_t>();
    int na = (rn + 31) / 32 * 32;
    for (int done = 0; done < K; done += KC) {
      int rk = K - done;
      if (rk > KC)
        rk = KC;
      int kp = (rk + 31) / 32 * 32;
      int s = kidx % 2;
      auto a2 = a2b.template Get<int8_t>()[s * BM * KC];
      auto b2 = b2b.template Get<int8_t>()[s * KC * BN];
      auto b1 = b1b.template Get<int8_t>()[done * BN];
      if (kidx >= 2)
        WaitFlag<HardEvent::M_MTE1>(l0Free[s]);
      LoadData2dTransposeParams bl;
      bl.startIndex = 0;
      bl.dstFracGap = 0;
      int nblocks = (rn + 31) / 32;
      if (nblocks < kp / 32) {
        bl.repeatTimes = kp / 32;
        bl.srcStride = 1;
        bl.dstGap = na / 16 - 1;
        for (int i = 0; i < nblocks; ++i)
          LoadDataWithTranspose(b2[i * 1024], b1[i * KC * 32], bl);
      } else {
        bl.repeatTimes = nblocks;
        bl.srcStride = KC / 32;
        bl.dstGap = 1;
        for (int i = 0; i < kp / 32; ++i)
          LoadDataWithTranspose(b2[i * na * 32], b1[i * 1024], bl);
      }
      LoadData2DParams al;
      al.startIndex = 0;
      al.ifTranspose = false;
      int mblocks = ((rm + 31) / 32) * 2, kblocks = kp / 32;
      if (kblocks < mblocks) {
        al.repeatTimes = mblocks;
        al.srcStride = 1;
        al.dstGap = kblocks - 1;
        for (int i = 0; i < kblocks; ++i)
          LoadData(a2[i * 512], a1[(done / 32 + i) * (BM * 32)], al);
      } else {
        al.repeatTimes = kblocks;
        al.srcStride = BM / 16;
        al.dstGap = 0;
        for (int i = 0; i < mblocks; ++i)
          LoadData(a2[i * kp * 16], a1[i * 512 + (done / 32) * (BM * 32)], al);
      }
      auto mr = pipe->FetchEventID(HardEvent::MTE1_M);
      SetFlag<HardEvent::MTE1_M>(mr);
      WaitFlag<HardEvent::MTE1_M>(mr);
      MmadParams mp;
      mp.m = (rm + 31) / 32 * 32;
      mp.n = na;
      mp.k = kp;
      mp.cmatrixInitVal = (done == 0);
      if (done == 0 && serial >= 1)
        WaitFlag<HardEvent::FIX_M>(cFree);
      Mmad(c1, a2, b2, mp);
      PipeBarrier<PIPE_M>();
      SetFlag<HardEvent::M_MTE1>(l0Free[s]);
      ++kidx;
    }
    auto doneEv = pipe->FetchEventID(HardEvent::M_FIX);
    SetFlag<HardEvent::M_FIX>(doneEv);
    WaitFlag<HardEvent::M_FIX>(doneEv);
    FixpipeParamsV220 fp;
    fp.mSize = (rm + 31) / 32 * 32;
    fp.nSize = na;
    fp.srcStride = (rm + 31) / 32 * 32;
    fp.dstStride = cstride;
    fp.quantPre = QuantMode_t::NoQuant;
    fp.deqScalar = 0;
    Fixpipe<int32_t, int32_t, CFG_ROW_MAJOR>(c, c1, fp);
    SetFlag<HardEvent::FIX_M>(cFree);
    ++serial;
  }
  __aicore__ inline void End() {
    for (int i = 0; i < 2 && i < kidx; ++i)
      WaitFlag<HardEvent::M_MTE1>(l0Free[i]);
    if (serial)
      WaitFlag<HardEvent::FIX_M>(cFree);
    for (int i = 0; i < 2; ++i)
      pipe->ReleaseEventID<HardEvent::M_MTE1>(l0Free[i]);
    pipe->ReleaseEventID<HardEvent::FIX_M>(cFree);
    PipeBarrier<PIPE_ALL>();
  }
};

template <int BM, int BN>
__global__ __mix__(1, 2)
    __attribute__((section(".onsite_narrow_res_"
                           "bcache"))) void grouped_matmul_gelu_narrow_resident32_bcache(
        GM_ADDR x, GM_ADDR w, GM_ADDR s, GM_ADDR g, GM_ADDR y, GM_ADDR work, GM_ADDR packedWeight,
        GM_ADDR packedX, int M, int N, int NP, int K, int KP, int E, int cores, TCubeTiling td) {
  constexpr int BC = BM * BN;
  constexpr int VM = BM / 2;
  TPipe pipe;
                                                                     
                                                                                  
  DirectInt8NarrowBResident<BM, BN, 1024> mm;
  TBuf<TPosition::VECIN> cb, sb;
  TBuf<TPosition::VECCALC> zb, tb, ub;
  TBuf<TPosition::VECOUT> ob;
  if ASCEND_IS_AIC {
    mm.Init(pipe);
  }
  if ASCEND_IS_AIV {
    pipe.InitBuffer(cb, 32 * 256 * 4);
    pipe.InitBuffer(sb, BN * 4);
    pipe.InitBuffer(tb, VM * BN * 4);
    pipe.InitBuffer(ob, VM * BN * 2);
  }
  GlobalTensor<int8_t> xx, ww;
  GlobalTensor<float> ss;
  GlobalTensor<int64_t> gg;
  GlobalTensor<half> yy;
  GlobalTensor<int32_t> cc;
  xx.SetGlobalBuffer((__gm__ int8_t *)x);
  ww.SetGlobalBuffer((__gm__ int8_t *)packedWeight);
  ss.SetGlobalBuffer((__gm__ float *)s);
  gg.SetGlobalBuffer((__gm__ int64_t *)g);
  yy.SetGlobalBuffer((__gm__ half *)y);
  cc.SetGlobalBuffer((__gm__ int32_t *)work);
  if ASCEND_IS_AIV {
    PackWeightsWithKAlignment<256>(w, packedWeight, g, E, K, KP, N, NP, pipe, cb.Get<int8_t>());
  }
  SyncAll<false>();
  int bid = GetBlockIdx(), sub = 0;
  if ASCEND_IS_AIV {
    bid = GetBlockIdx() / 2;
    sub = GetSubBlockIdx();
  }
                                                                         
                                                                          
  TEventID outputDone = 0;
  bool outputPending = false;
  if ASCEND_IS_AIV {
    outputDone = pipe.FetchEventID(HardEvent::MTE3_V);
  }
  int tileBase = 0, start = 0, serial = 0;
  for (int e = 0; e < E; ++e) {
    int end = (int)gg.GetValue(e), rows = end - start, nt = (N + BN - 1) / BN,
        mt = (rows + BM - 1) / BM, tasks = mt * nt;
    int local = (bid - tileBase % cores + cores) % cores;
    bool expertWeightReady = false;
    for (int ti = local; ti < tasks; ti += cores) {
      int mi = (ti / nt) * BM, ni = (ti % nt) * BN, rm = rows - mi, rn = N - ni;
      if (rm > BM)
        rm = BM;
      if (rn > BN)
        rn = BN;
      int cn = BN;
      int64_t coff = ((serial % RING) * cores + bid) * (int64_t)BC;
      if ASCEND_IS_AIC {
        if (!expertWeightReady) {
          mm.LoadB(ww[e * (int64_t)KP * NP], KP);
          expertWeightReady = true;
        }
        if (serial >= RING)
          CrossCoreWaitFlag(FREE_FLAG + serial % RING);
        mm.LoadA(xx[(start + mi) * (int64_t)K], K, rm);
        mm.Tile(ww[e * (int64_t)KP * NP + ni], cc[coff], K, NP, rm, cn, BN);
        CrossCoreSetFlag<2, PIPE_FIX>(READY_FLAG + serial % RING);
      }
      if ASCEND_IS_AIV {
        auto ci = cb.Get<int32_t>();
        auto sc = sb.Get<float>();
        auto z = cb.Get<float>();
        auto t = tb.Get<float>();
        auto u = cb.Get<float>();
        auto o = tb.Get<half>();
        int split = (rm + 1) / 2, vstart = sub * split, vm = rm - vstart;
        if (vm > split)
          vm = split;
        if (vm < 0)
          vm = 0;
        int stride = (rn + 15) / 16 * 16;
        CrossCoreWaitFlag(READY_FLAG + serial % RING);
        int totalVm = vm;
        for (int vr = 0; vr < totalVm; vr += VM) {
          vm = totalVm - vr;
          if (vm > VM)
            vm = VM;
          auto inputReuse = pipe.FetchEventID(HardEvent::V_MTE2);
          SetFlag<HardEvent::V_MTE2>(inputReuse);
          WaitFlag<HardEvent::V_MTE2>(inputReuse);
          DataCopyExtParams cp{(uint16_t)vm, (uint32_t)(rn * 4), (uint32_t)((BN - rn) * 4),
                               (uint32_t)((stride - (rn + 7) / 8 * 8) / 8), 0};
          DataCopyPadExtParams<int32_t> ip{true, 0, 0, 0};
          DataCopyPad(ci, cc[coff + (vstart + vr) * BN], cp, ip);
          DataCopyExtParams sp{1, (uint32_t)(rn * 4), 0, 0, 0};
          DataCopyPadExtParams<float> fp{true, 0, 0, 0};
          DataCopyPad(sc, ss[e * (int64_t)N + ni], sp, fp);
          auto ev = pipe.FetchEventID(HardEvent::MTE2_V);
          SetFlag<HardEvent::MTE2_V>(ev);
          WaitFlag<HardEvent::MTE2_V>(ev);
          if (vr + vm >= totalVm)
            CrossCoreSetFlag<2, PIPE_MTE2>(FREE_FLAG + serial % RING);
          int count = vm * stride;
          Cast(z, ci, RoundMode::CAST_NONE, count);
          PipeBarrier<PIPE_V>();
          for (int c = 0; c < stride; c += 64) {
            uint64_t mask = (stride - c < 64 ? stride - c : 64);
            Mul(z[c], z[c], sc[c], mask, (uint8_t)vm,
                {1, 1, 1, (uint8_t)(stride / 8), (uint8_t)(stride / 8), 0});
          }
                                                                          
                                                                              
          if (outputPending) {
            WaitFlag<HardEvent::MTE3_V>(outputDone);
            outputPending = false;
          }
          PipeBarrier<PIPE_V>();
          GmmDirectVectorCounter(z, t, u, count);
          Cast(o, u, RoundMode::CAST_RINT, count);
          PipeBarrier<PIPE_V>();
          auto ev2 = pipe.FetchEventID(HardEvent::V_MTE3);
          SetFlag<HardEvent::V_MTE3>(ev2);
          WaitFlag<HardEvent::V_MTE3>(ev2);
          DataCopyExtParams op{(uint16_t)vm, (uint32_t)(rn * 2),
                               (uint32_t)((stride - (rn + 15) / 16 * 16) / 16),
                               (uint32_t)((N - rn) * 2), 0};
          DataCopyPad(yy[(start + mi + vstart + vr) * (int64_t)N + ni], o, op);
          SetFlag<HardEvent::MTE3_V>(outputDone);
          outputPending = true;
        }
        if (!totalVm)
          CrossCoreSetFlag<2, PIPE_MTE2>(FREE_FLAG + serial % RING);
      }
      ++serial;
    }
    tileBase += tasks;
    start = end;
  }
  if ASCEND_IS_AIV {
    if (outputPending)
      WaitFlag<HardEvent::MTE3_V>(outputDone);
  }
  if ASCEND_IS_AIC {
    mm.End();
    for (int i = 0; i < (serial < RING ? serial : RING); ++i)
      CrossCoreWaitFlag(FREE_FLAG + (serial - 1 - i) % RING);
  }
}
static __attribute__((noinline)) void LaunchNarrowResident32(GM_ADDR x, GM_ADDR w, GM_ADDR s,
                                                             GM_ADDR g, GM_ADDR y, int M, int N,
                                                             int K, int E, int cores,
                                                             aclrtStream stream) {
  constexpr int BM = 32, BN = 32;
  int KP = (K + 31) / 32 * 32;
  uint64_t cubeBytes = (uint64_t)cores * RING * BM * BN * 4;
  uint64_t weightBytes = (uint64_t)E * KP * BN;
  void *work = nullptr;
  aclrtMalloc(&work, cubeBytes + weightBytes, ACL_MEM_MALLOC_HUGE_FIRST);
  TCubeTiling unused{};
  grouped_matmul_gelu_narrow_resident32_bcache<BM, BN><<<cores, nullptr, stream>>>(
      x, w, s, g, y, (GM_ADDR)work, (GM_ADDR)((uint8_t *)work + cubeBytes), nullptr, M, N, BN, K,
      KP, E, cores, unused);
  aclrtSynchronizeStream(stream);
  aclrtFree(work);
}
