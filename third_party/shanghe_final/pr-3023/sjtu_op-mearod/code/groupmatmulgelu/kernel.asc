class WideDualFlowPacketCursor{WideResidentCursor owners;Plan p;WorkTile resident{};bool residentReady=false;int pitch=0,rowOffset=0,columnOffset=0;int firstRow=0,rowCapacity=0;public:__aicore__ inline WideDualFlowPacketCursor(GM_ADDR groups,Plan plan,int core):owners(groups,plan,core),p(plan){}__aicore__ inline bool Next(WideDualFlowPacket&packet){if(!residentReady){if(!owners.Next(resident))return false;int panelCol=resident.col;int sub=p.vectors>1?GetSubBlockIdx():0;rowOffset=0;columnOffset=0;if(p.splitN){int splitPitch=p.tn/p.vectors;columnOffset=sub*splitPitch;resident.col+=columnOffset;resident.cols=Min(splitPitch,resident.cols-columnOffset);}else{int rows=(resident.rows+p.vectors-1)/p.vectors;rowOffset=sub*rows;resident.row+=rowOffset;resident.rows=Min(rows,resident.rows-rowOffset);}firstRow=0;if(resident.rows<=0||resident.cols<=0){packet={resident,0,rowOffset,columnOffset,0,true,true,false};return true;}pitch=RoundExtent(resident.cols,32);int chunkCapacity=panelCol+p.tn>=p.n?WideDualFlowCapacity(p):P01WideSmallCapacity(p);rowCapacity=Min(255,chunkCapacity/pitch);residentReady=true;}WorkTile chunk=resident;chunk.row+=firstRow;chunk.rows=Min(rowCapacity,resident.rows-firstRow);bool last=firstRow+chunk.rows==resident.rows;packet={chunk,pitch,rowOffset,columnOffset,firstRow,firstRow==0,last,true};firstRow+=chunk.rows;if(last)residentReady=false;return true;}};
