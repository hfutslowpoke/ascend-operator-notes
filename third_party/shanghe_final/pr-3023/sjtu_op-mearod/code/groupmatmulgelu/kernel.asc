class ShallowOutputScratchDualConsumer{Plan p;ShallowOutputScratchActivationTile activation0,activation1;GlobalTensor<int32_t>exchange;GlobalTensor<half>halfExchange;int transitShift;float transitInverse;GlobalTensor<float>gains;GlobalTensor<half>output;int sequence=0,nextBuffer=0,pendingBuffer=-1;WorkTile heldTile;int heldPitch=0,heldCount=0;__aicore__ inline ShallowOutputScratchActivationTile&Activation(int buffer){return buffer?activation1:activation0;}public:__aicore__ inline ShallowOutputScratchDualConsumer(GM_ADDR scale,GM_ADDR y,GM_ADDR workspace,Plan plan,int core):p(plan),activation0(ShallowOutputScratchCapacity(plan),plan.tn,0,0),activation1(ShallowOutputScratchCapacity(plan),plan.tn,ShallowOutputScratchStride(plan),1){exchange.SetGlobalBuffer((__gm__ int32_t*)workspace+(uint64_t)core*p.ring*p.tm*p.tn);halfExchange.SetGlobalBuffer((__gm__ half*)workspace+static_cast<uint64_t>(2)*core*p.ring*p.tm*p.tn);transitShift=P04HalfTransitShift(p);transitInverse=1.0f;for(int bit=0;bit<transitShift;++bit)transitInverse*=2.0f;gains.SetGlobalBuffer((__gm__ float*)scale);output.SetGlobalBuffer((__gm__ half*)y);}template<typename Cursor>__aicore__ inline void Run(Cursor&cursor){while(true){ShallowOutputScratchPacket packet{};bool real=cursor.Next(packet);int slot=sequence%p.ring;if(real&&packet.active){auto&current=Activation(nextBuffer);WorkTile chunk=packet.tile;current.AwaitInputReuse();LoadLinear(current.scales,gains[(uint64_t)chunk.expert*p.n+chunk.col],chunk.cols);}if(real){if(packet.first)CrossCoreWaitFlag<2>(slot);if(packet.active){auto&current=Activation(nextBuffer);WorkTile chunk=packet.tile;int pitch=packet.pitch;int count=chunk.rows*pitch;uint64_t offset=(uint64_t)slot*p.tm*p.tn+(packet.rowOffset+packet.firstRow)*p.tn+packet.columnOffset;if(transitShift>0){uint64_t halfOffset=static_cast<uint64_t>(2)*slot*p.tm*p.tn+(packet.rowOffset+packet.firstRow)*p.tn+packet.columnOffset;auto packed=current.accum.ReinterpretCast<half>();if(pitch!=p.tn){DataCopyExtParams transfer{static_cast<uint16_t>(chunk.rows),static_cast<uint32_t>(pitch*2),static_cast<uint32_t>((p.tn-pitch)*2),0,0};DataCopyPadExtParams<half>padding{false,0,0,0};DataCopyPad(packed,halfExchange[halfOffset],transfer,padding);}else LoadLinear(packed,halfExchange[halfOffset],count);}else if(pitch!=p.tn){if(p.splitN&&pitch%8==0&&(p.tn-pitch)%8==0){DataCopyParams transfer{static_cast<uint16_t>(chunk.rows),static_cast<uint16_t>(pitch*4/32),static_cast<uint16_t>((p.tn-pitch)*4/32),0};DataCopy(current.accum,exchange[offset],transfer);}else{DataCopyExtParams transfer{static_cast<uint16_t>(chunk.rows),static_cast<uint32_t>(pitch*4),static_cast<uint32_t>((p.tn-pitch)*4),0,0};DataCopyPadExtParams<int32_t>padding{false,0,0,0};DataCopyPad(current.accum,exchange[offset],transfer,padding);}}else{LoadLinear(current.accum,exchange[offset],count);}SetFlag<HardEvent::MTE2_V>(current.eventId);}if(packet.last)CrossCoreSetFlag<2,PIPE_MTE2>(p.ring+slot);if(packet.active){auto&current=Activation(nextBuffer);WorkTile chunk=packet.tile;int pitch=packet.pitch;int count=chunk.rows*pitch;WaitFlag<HardEvent::MTE2_V>(current.eventId);if(transitShift>0){Muls(current.scales,current.scales,transitInverse,chunk.cols);Cast(current.z,current.accum.ReinterpretCast<half>(),RoundMode::CAST_NONE,count);}else Cast(current.z,current.accum,RoundMode::CAST_RINT,count);PipeBarrier<PIPE_V>();BinaryRepeatParams scaleRepeat{1,1,1,static_cast<uint8_t>(pitch/8),static_cast<uint8_t>(pitch/8),0};for(int column=0;column<chunk.cols;column+=64)Mul(current.z[column],current.z[column],current.scales[column],static_cast<uint64_t>(Min(64,chunk.cols-column)),static_cast<uint8_t>(chunk.rows),scaleRepeat);PipeBarrier<PIPE_V>();current.Prepare(count);}}if(pendingBuffer>=0){auto&held=Activation(pendingBuffer);held.CollectSummary(heldCount);held.Repair(heldCount);Plan local=p;local.tn=heldPitch;if(p.splitN)P02StoreAligned(output,held.output,heldTile,local);else StoreTile(output,held.output,heldTile,local);held.outputPending=true;pen