aBytes=Up(p.tm*apitch*(keepA?(twoA?2:1):(aSlots+(prefetchA?1:0))),512);
if(Mode==WideTail && keepB && (p.depth+p.ck-1)/p.ck>1){
splitK=((p.depth+p.ck-1)/p.ck/2)*p.ck;
splitB=splitK>0 && splitK<p.depth;
