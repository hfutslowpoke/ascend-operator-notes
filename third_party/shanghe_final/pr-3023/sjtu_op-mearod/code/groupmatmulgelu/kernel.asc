__aicore__ inline void ReadPacked(const WorkChunk &t,uint32_t stage,uint32_t slot,uint32_t ma,uint32_t stageK) {
uint32_t kp=Up(p.depth,32),mp=Up(p.rows,64),pos=stage*stageK,ka=Up(Min(stageK,p.depth-pos),32);
DataCopyParams da{};da.blockCount=ka/32;da.blockLen=ma;da.srcStride=mp-ma;
