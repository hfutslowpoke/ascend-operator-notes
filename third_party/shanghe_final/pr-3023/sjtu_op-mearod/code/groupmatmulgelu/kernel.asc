__aicore__ inline bool P04IssueInitialInputs(GM_ADDR x,GM_ADDR weight,const Plan&p,int core,int rowHint,WorkTile&hint){int fullK=RoundExtent(p.k,32);if(rowHint<=0||p.m<1||p.k<1||p.n<1||p.e<1||p.cores<1||p.ck!=fullK||p.cacheA!=0||p.cacheB!=1||p.reverseK)return false;if(static_cast<uint64_t>(p.tm)*fullK>65536||static_cast<uint64_t>(p.tn)*fullK>65536||static_cast<uint64_t>(p.tm)*p.tn*4>131072)return false;int begin=static_cast<int>((uint64_t)p.m*core/p.cores);int last=static_cast<int>((uint64_t)p.m*(core+1)/p.cores);int expert=begin/rowHint;if(expert>=p.e||begin>=last)return false;int end=Min(last,Min(p.m,(expert+1)*rowHint));int rows=Min(p.tm,end-begin),cols=Min(p.tn,p.n);if(rows<=0||cols<=0)return false;hint={expert,begin,0,rows,cols};GlobalTensor<int8_t>a,b;a.SetGlobalBuffer((__gm__ int8_t*)x);b.SetGlobalBuffer((__gm__ int8_t*)weight);LocalTensor<int8_t>al(TPosition::A1,0,p.tm*fullK);LocalTensor<int8_t>bl(TPosition::B1,2*p.tm*fullK,p.tn*fullK);Nd2NzParams qa;qa.ndNum=1;qa.nValue=rows;qa.dValue=p.k;qa.srcNdMatrixStride=0;qa.srcDValue=p.k;qa.dstNzC0Stride=RoundExtent(rows,16);qa.dstNzNStride=1;qa.dstNzMatrixStride=0;DataCopy(al,a[(uint64_t)begin*p.k],qa);Nd2NzParams qb;qb.ndNum=1;qb.nValue=p.k;qb.dValue=cols;qb.srcNdMatrixStride=0;qb.srcDValue=p.n;qb.dstNzC0Stride=fullK;qb.dstNzNStride=1;qb.dstNzMatrixStride=0;DataCopy(bl,b[(uint64_t)expert*p.k*p.n],qb);SetFlag<HardEvent::MTE2_MTE1>(6);return true;}
__schedmode__(1)__global__ __mix__(1,2)void ShallowExpertResidentKernel(RuntimePackedPlan packet,GM_ADDR x,GM_ADDR weight,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,GM_ADDR workspace){InitSocState();Plan p=UnpackHintRuntimePlan(packet);int uniformRows=(packet.m&0x80000000u)?p.m/p.e:0;int core=CubeLane(p);if ASCEND_IS_AIV{P04ShallowUbBounds bounds(groups,p,uniformRows);ShallowOutputScratchDualConsumer consumer(scale,y,workspace,p,core);P04ShallowOutputScratchPacketCursor cursor(bounds,p,core);consumer.Run(cursor);return;}if ASCEND_IS_AIC{WorkTile initialHint{};bool initialReady=P04IssueInitialInputs(x,weight,p,core,uniformRows,initialHint);P04ShallowRangedBounds bounds(groups,p.e,uniformRows);ShallowOverlapFusedEngine engine(x,weight,scale,y,workspace,p,core);if(initialReady)engine.AdoptInitialInputs(initialHint);ShallowRowBandCursor cursor(bounds,p,core);WorkTile tile{},nextTile{};bool hasNext=false;if(cursor.Next(tile)){hasNext=cursor.Next(nextTile);while(true){engine.Process(tile,nextTile,hasNext);if(!hasNext)break;tile=nextTile;hasNext=cursor.Next(nextTile);}}engine.Finish();}}
