if(ordinal<waves*shards){uint32_t first=ordinal%shards*columns/shards,last=(ordinal%shards+1)*columns/shards;uint32_t row=begin+(ordinal/shards)*p.tm,col=(first+panel)*p.tn;t={expert,row,col,Min(p.tm,end-row),Min(p.tn,p.cols-col)};if(++panel==last-first){panel=0;ordinal+=p.cores;}return true;}
ordinal-=waves*shards;begin=end;++expert;continue;
}
if(ordinal<jobs){
uint32_t row=begin+(p.resident==2?ordinal%waves:ordinal/columns)*p.tm,col=(p.resident==2?ordinal/waves:ordinal%columns)*p.tn;ordinal+=p.cores;
t={expert,row,col,Min(p.tm,end-row),Min(p.tn,p.cols-col)};return true;
}
ordinal-=jobs;begin=end;++expert;
}
return false;
}
};
__aicore__ inline void PackStreamingInputs(GM_ADDR xs,GM_ADDR ws,GM_ADDR gs,GM_ADDR workspace,ExecutionShape p) {
uint32_t kp=Up(p.depth,32),mp=Up(p.rows,64),np=Up(p.cols,32);
