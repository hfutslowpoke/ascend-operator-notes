}
Nd2NzParams d{}; d.ndNum=1; d.nValue=count; d.dValue=fullB?p.cols:t.cols;
d.srcDValue=p.cols; d.dstNzC0Stride=bpitch; d.dstNzNStride=1;
if(panelPack){d.ndNum=count/32;d.nValue=32;d.srcNdMatrixStride=32*p.cols;d.dstNzC0Stride=32;d.dstNzMatrixStride=p.tn*32;}
DataCopy(b1[slot*p.tn*bpitch],w[((uint64_t)t.expert*p.depth+k)*p.cols+(fullB?0:t.col)],d);
