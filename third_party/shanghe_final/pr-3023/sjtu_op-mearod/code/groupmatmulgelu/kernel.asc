}
__aicore__ inline uint32_t KAt(uint32_t step,uint32_t chunks,uint32_t first) {
return first+(Mode==LongReduction?chunks-1-step:(step+kPhase)%chunks)*p.ck;
}
__aicore__ inline void LoadA(LocalTensor<int8_t> aa,uint32_t ao,uint32_t ma,uint32_t ka) {
if constexpr(Mode==WideDouble || Mode==ColumnResident || Mode==WideTail) {
LoadData2DParams la{};la.repeatTimes=ka/32;la.srcStride=ma/16;
for(uint32_t r=0;r<ma/16;++r)LoadData(aa[r*ka*16],a1[ao+r*512],la);
return;
}
if(featureRows!=ma){uint8_t pads[4]={0,0,0,0};SetFmatrix(1,ma,pads,FmatrixMode::FMATRIX_LEFT);featureRows=ma;}
LoadData3DParamsV2<int8_t> la{};
la.l1H=1;la.l1W=ma;la.channelSize=ka;la.kExtension=ka;la.mExtension=ma;
la.strideW=1;la.strideH=1;la.filterW=1;la.filterH=1;la.dilationFilterW=1;la.dilationFilterH=1;
