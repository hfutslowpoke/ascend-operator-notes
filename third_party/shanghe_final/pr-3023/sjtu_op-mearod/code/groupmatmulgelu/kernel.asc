__aicore__ inline WorkTile P02LocateResidentRowTile(P02GroupBounds&bounds,Plan p,int ordinal){int first=0,prefix=0;for(int expert=0;expert<p.e;++expert){int end=bounds.End(expert);int rows=(end-first+p.tm-1)/p.tm;if(ordinal<prefix+rows){int row=first+(ordinal-prefix)*p.tm;return{expert,row,0,Min(p.tm,end-row),p.n};}first=end;prefix+=rows;}return{0,p.m,0,0,p.n};}
