__aicore__ inline int ShallowOutputScratchCapacity(const Plan&p){return Min(8192,RoundExtent((p.tm+p.vectors-1)/p.vectors*p.tn,512));}
__aicore__ inline int ShallowOutputScratchStride(const Plan&p){int capacity=ShallowOutputScratchCapacity(p);return RoundExtent(capacity*10+3*RoundExtent(capacity/8,256)+RoundExtent(p.tn,8)*4+32+768,256);}
