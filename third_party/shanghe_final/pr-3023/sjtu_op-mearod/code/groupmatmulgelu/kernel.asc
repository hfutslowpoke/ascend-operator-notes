__aicore__ inline bool P01WideChunk4096Fits(const Plan&p){if(p.vectors<1)return false;int base=RoundExtent((p.tm+p.vectors-1)/p.vectors*p.tn,512);int capacity=Min(4096,base);if(capacity<RoundExtent(p.tn,32))return false;int size=RoundExtent(capacity,512),sc=RoundExtent(p.tn,8);uint64_t bank=static_cast<uint64_t>(size)*10+static_cast<uint64_t>(sc)*20;uint64_t stride=RoundExtent(size*10+3*RoundExtent(size/8,256)+sc*4+32+sc*16,256);return stride+bank<=188160;}
