uint32_t first=(uint64_t)packet.rows*GetBlockIdx()/packet.workers,last=(uint64_t)packet.rows*(GetBlockIdx()+1)/packet.workers,previous=0;
bool outputBusy=false;uint32_t padded=Up(packet.depth,32);
Duplicate(input.ReinterpretCast<int32_t>(),0,2*capacity/4);Fence<HardEvent::V_MTE2>(2);
for(uint32_t expert=0;expert<packet.groups;++expert){
uint32_t end=ends.GetValue(expert),lo=first>previous?first:previous,hi=Min(last,end);previous=end;
if(lo<hi){
DataCopyPad(input,w[(uint64_t)expert*packet.depth],DataCopyExtParams{1,packet.depth,0,0,0},DataCopyPadExtParams<int8_t>{true,0,(uint8_t)(padded-packet.depth),0});
Fence<HardEvent::MTE2_V>(2);Cast(converted,input,RoundMode::CAST_NONE,pitch);PipeBarrier<PIPE_V>();Cast(weights,converted,RoundMode::CAST_NONE,pitch);PipeBarrier<PIPE_V>();Fence<HardEvent::V_MTE2>(2);
float factor=scale.GetValue(expert);uint32_t batches=(hi-lo+batch-1)/batch;
