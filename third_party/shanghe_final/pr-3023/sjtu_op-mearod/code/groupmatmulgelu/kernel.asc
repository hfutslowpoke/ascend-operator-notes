uint32_t owned=aTasks>core?(aTasks-1-core)/p.cores+1:0;
bool writes[4]={false,false,false,false};
for(uint32_t i=0;i<Min(2,owned);++i){
uint32_t task=core+i*p.cores,row=task/columnBlocks*32,k=task%columnBlocks*4096,columns=Min(4096,p.depth-k);
Nd2NzParams d{};d.ndNum=1;d.nValue=Min(32,p.rows-row);d.dValue=columns;d.srcDValue=p.depth;d.dstNzC0Stride=32;d.dstNzNStride=1;
DataCopy(local[i*131072],x[(uint64_t)row*p.depth+k],d);SetFlag<HardEvent::MTE2_MTE3>(i);
}
for(uint32_t i=0;i<owned;++i){
uint32_t slot=i%2,task=core+i*p.cores,row=task/columnBlocks*32,k=task%columnBlocks*4096,columns=Min(4096,p.depth-k);
WaitFlag<HardEvent::MTE2_MTE3>(slot);
DataCopyParams d{};d.blockCount=Up(columns,32)/32;d.blockLen=32;d.dstStride=mp-32;
DataCopy(packedA[(uint64_t)k*mp+row*32],local[slot*131072],d);SetFlag<HardEvent::MTE3_MTE2>(slot);writes[slot]=true;
if(i+2<owned){
WaitFlag<HardEvent::MTE3_MTE2>(slot);writes[slot]=false;task=core+(i+2)*p.cores;row=task/columnBlocks*32;k=task%columnBlocks*4096;columns=Min(4096,p.depth-k);
Nd2NzParams q{};q.ndNum=1;q.nValue=Min(32,p.rows-row);q.dValue=columns;q.srcDValue=p.depth;q.dstNzC0Stride=32;q.dstNzNStride=1;
DataCopy(local[slot*131072],x[(uint64_t)row*p.depth+k],q);SetFlag<HardEvent::MTE2_MTE3>(slot);
}
}
for(uint32_t i=0;i<2;++i)if(writes[i]){WaitFlag<HardEvent::MTE3_MTE2>(i);writes[i]=false;}
PackCursor cursor(p,gs,limit,true);PackTask tasks[4];uint32_t live=0,head=0,tail=0;
uint32_t nonempty[128],active=0;
if(!joint){GlobalTensor<int64_t> groupEnds;groupEnds.SetGlobalBuffer((__gm__ int64_t*)gs);DataCacheCleanAndInvalid<int64_t,CacheLine::ENTIRE_DATA_CACHE,DcciDst::CACHELINE_OUT>(groupEnds);uint32_t previous=0;for(uint32_t e=0;e<p.experts;++e){uint32_t end=groupEnds.GetValue(e);if(end>previous)nonempty[active++]=e;previous=end;}}
uint32_t width=1024,nb=(p.cols+width-1)/width,kb=(p.depth+63)/64,bTasks=(joint?p.experts:active)*nb*kb,next=core;
while(true){
while(live<4){
