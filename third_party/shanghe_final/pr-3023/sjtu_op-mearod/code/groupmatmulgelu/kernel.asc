WaitFlag<HardEvent::MTE2_V>(slot);
if(outputBusy[slot]){WaitFlag<HardEvent::MTE3_V>(slot);outputBusy[slot]=false;}
if(padded<inputBytes){Duplicate(input[padded/2],(uint16_t)0,(inputBytes-padded)/2);PipeBarrier<PIPE_V>();}
CopyRepeatParams cp{};cp.dstStride=2;cp.srcStride=1;cp.dstRepeatSize=16;cp.srcRepeatSize=8;
for(uint32_t b=0;b<pitch/32;++b){
Gather(even,input,offsets,b*32,512);
Gather(odd,input,offsets,b*32+p.cols-1,512);
Gather(high,input,offsets,b*32+p.cols+1,512);
PipeBarrier<PIPE_V>();
ShiftRight(odd,odd,(uint16_t)8,512);ShiftLeft(high,high,(uint16_t)8,512);PipeBarrier<PIPE_V>();
Or(odd,odd,high,512);PipeBarrier<PIPE_V>();
Copy(output[b*65*16],even,(uint64_t)128,(uint8_t)4,cp);
Copy(output[b*65*16+16],odd,(uint64_t)128,(uint8_t)4,cp);PipeBarrier<PIPE_V>();
if((b+1)*32>p.cols){And(output[b*65*16],output[b*65*16],tail,1024);PipeBarrier<PIPE_V>();}
}
SetFlag<HardEvent::V_MTE2>(slot);inputBusy[slot]=true;
SetFlag<HardEvent::V_MTE3>(slot);WaitFlag<HardEvent::V_MTE3>(slot);
DataCopyExtParams write{(uint16_t)(pitch/32),(uint32_t)(64*32),1,(uint32_t)((kp-64)*32),0};
DataCopyPad(destination[(uint64_t)t.expert*kp*np+(uint64_t)t.col*kp+t.row*32],local[slot*slotBytes+inputBytes],write);
SetFlag<HardEvent::MTE3_V>(slot);outputBusy[slot]=true;
}
public:
__aicore__ inline VectorWeightPack(TPipe &pipe,ExecutionShape plan,GM_ADDR ws,GM_ADDR gs,GM_ADDR packed,uint32_t limit):p(plan),cursor(plan,gs,limit,false){
source.SetGlobalBuffer((__gm__ int8_t*)ws);destination.SetGlobalBuffer((__gm__ int8_t*)packed);
kp=Up(p.depth,64);np=Up(p.cols,32);inputBytes=Up(64*np,256);outputBytes=Up(65*np,256);slotBytes=inputBytes+outputBytes;
pipe.InitBuffer(memory,2*slotBytes+7168);local=memory.Get<int8_t>();
offsets=local[2*slotBytes].ReinterpretCast<uint32_t>();
even=local[2*slotBytes+2048].ReinterpretCast<uint16_t>();odd=local[2*slotBytes+3072].ReinterpretCast<uint16_t>();
high=local[2*slotBytes+4096].ReinterpretCast<uint16_t>();tail=local[2*slotBytes+5120].ReinterpretCast<uint16_t>();
auto index=offsets.ReinterpretCast<int32_t>();auto rows=even.ReinterpretCast<int32_t>();
for(uint32_t i=0;i<8;++i)index.SetValue(i,i);
Fence<HardEvent::S_V>(7);
for(uint32_t count=8;count<512;count*=2){Adds(index[count],index,(int32_t)count,count);PipeBarrier<PIPE_V>();}
ShiftRight(rows,index,(int32_t)4,512);PipeBarrier<PIPE_V>();
Muls(index,index,(int32_t)2,512);Muls(rows,rows,(int32_t)(2*p.cols-32),512);PipeBarrier<PIPE_V>();
Add(index,index,rows,512);PipeBarrier<PIPE_V>();
uint32_t valid=p.cols%32;
for(uint32_t word=0;word<16;++word)tail.SetValue(word,word*2+1<valid?(uint16_t)0xffff:(word*2<valid?(uint16_t)0xff:(uint16_t)0));
Fence<HardEvent::S_V>(7);
CopyRepeatParams broadcast{};broadcast.dstStride=1;broadcast.srcStride=1;broadcast.dstRepeatSize=1;broadcast.srcRepeatSize=0;
Copy(tail[16],tail,(uint64_t)16,(uint8_t)63,broadcast);PipeBarrier<PIPE_V>();
}
__aicore__ inline void Run(){
if(!cursor.Next(tasks[0]))return;
Read(0);uint32_t slot=0;
while(true){uint32_t next=slot^1;bool more=cursor.Next(tasks[next]);if(more)Read(next);Convert(slot);if(!more)break;slot=next;}
for(uint32_t i=0;i<2;++i){if(inputBusy[i])WaitFlag<HardEvent::V_MTE2>(i);if(outputBusy[i])WaitFlag<HardEvent::MTE3_V>(i);}
}
};

__aicore__ inline void PackLongInputs(GM_ADDR xs,GM_ADDR ws,GM_ADDR gs,GM_ADDR workspace,ExecutionShape p) {
uint32_t kp=Up(p.depth,32),mp=Up(p.rows,64),np=Up(p.cols,32);
uint64_t exchange=(uint64_t)p.cores*p.ring*p.tm*p.tn*4;
GM_ADDR ap=workspace+exchange;GM_ADDR bp=ap+(uint64_t)mp*kp;
uint32_t pitch=Up(Min(p.cols,1024),32);
bool joint=Up(p.depth,64)==kp && (p.cols+1023)/1024==1 && (p.cols&1) && 2*(Up(64*pitch,256)+Up(65*pitch,256))+7168<=184*1024;
uint32_t limit=joint?PackAssistLimit(p):0;
if ASCEND_IS_AIC {
GlobalTensor<int8_t> x,w,packedA,packedB;
x.SetGlobalBuffer((__gm__ int8_t*)xs);w.SetGlobalBuffer((__gm__ int8_t*)ws);
packedA.SetGlobalBuffer((__gm__ int8_t*)ap);packedB.SetGlobalBuffer((__gm__ int8_t*)bp);
TPipe pipe;TBuf<TPosition::A1> memory;pipe.InitBuffer(memory,262144);auto local=memory.Get<int8_t>();
uint32_t core=GetBlockIdx(),columnBlocks=(p.depth+4095)/4096,aTasks=(p.rows+31)/32*columnBlocks;
uint32_t owned=aTasks>core?(aTasks-1-core)/p.cores+1:0;
bool writes[4]={false,false,false,false};
for(uint32_t i=0;i<Min(2,owned);++i){
uint32_t task=core+i*p.cores,row=task/columnBlocks*32,k=task%columnBlocks*4096,columns=Min(4096,p.depth-k);
Nd2NzParams d{};d.ndNum=1;d.nValue=Min(32,p.rows-row);d.dValue=columns;d.srcDValue=p.depth;d.dstNzC0Stride=32;d.dstNzNStride=1;
DataCopy(local[i*131072],x[(uint64_t)row*p.depth+k],d);SetFlag<HardEvent::MTE2_MTE3>(i);
}
for(uint32_t i=0;i<owned;++i){
uint32_t slot=i%2,task=core+i*p.cores,row=task/columnBlocks*32,k=task%columnBlocks*4096,columns=Min(4096,p.depth-k);
WaitFlag<HardEvent::MTE2_MTE3>(slot);
DataCopyParams d{};d.blockCount=Up(columns,32)/32;d.blockLen=32;d.dstStride=mp-32;
DataCopy(packedA[(uint64_t)k*mp+row*32],local[slot*131072],d);SetFlag<HardEvent::MTE3_MTE2>(slot);writes[slot]=true;
if(i+2<owned){
WaitFlag<HardEvent::MTE3_MTE2>(slot);writes[slot]=false;task=core+(i+2)*p.cores;row=task/columnBlocks*32;k=task%columnBlocks*4096;columns=Min(4096,p.depth-k);
Nd2NzParams q{};q.ndNum=1;q.nValue=Min(32,p.rows-row);q.dValue=columns;q.srcDValue=p.depth;q.dstNzC0Stride=32;q.dstNzNStride=1;
DataCopy(local[slot*131072],x[(uint64_t)row*p.depth+k],q);SetFlag<HardEvent::MTE2_MTE3>(slot);
}
}
for(uint32_t i=0;i<2;++i)if(writes[i]){WaitFlag<HardEvent::MTE3_MTE2>(i);writes[i]=false;}
PackCursor cursor(p,gs,limit,true);PackTask tasks[4];uint32_t live=0,head=0,tail=0;
uint32_t width=1024,nb=(p.cols+width-1)/width,kb=(p.depth+63)/64,bTasks=p.experts*nb*kb,next=core;
while(true){
while(live<4){
PackTask t{};bool more;
if(joint)more=cursor.Next(t);
else{more=next<bTasks;if(more){uint32_t task=next;next+=p.cores;t.expert=task/(nb*kb);t.row=(task%kb)*64;t.col=(task/kb)%nb*width;t.rows=Min(64,p.depth-t.row);t.cols=Min(width,p.cols-t.col);}}
if(!more)break;
uint32_t slot=tail;tasks[slot]=t;
if(writes[slot]){WaitFlag<HardEvent::MTE3_MTE2>(slot);writes[slot]=false;}
Nd2NzParams q{};q.ndNum=1;q.nValue=t.rows;q.dValue=t.cols;q.srcDValue=p.cols;q.dstNzC0Stride=64;q.dstNzNStride=1;
DataCopy(local[slot*65536],w[((uint64_t)t.expert*p.depth+t.row)*p.cols+t.col],q);SetFlag<HardEvent::MTE2_MTE3>(slot);
tail=(tail+1)&3;++live;
}
if(!live)break;
uint32_t slot=head;PackTask &t=tasks[slot];WaitFlag<HardEvent::MTE2_MTE3>(slot);
DataCopyParams d{};d.blockCount=Up(t.cols,32)/32;d.blockLen=64;d.dstStride=kp-64;
DataCopy(packedB[(uint64_t)t.expert*kp*np+(uint64_t)t.col*kp+t.row*32],local[slot*65536],d);
SetFlag<HardEvent::MTE3_MTE2>(slot);writes[slot]=true;head=(head+1)&3;--live;
}
for(uint32_t i=0;i<4;++i)if(writes[i])WaitFlag<HardEvent::MTE3_MTE2>(i);
}
if ASCEND_IS_AIV {if(joint){TPipe pipe;VectorWeightPack pack(pipe,p,ws,gs,bp,limit);pack.Run();}}
SyncAll<false>();
}

__aicore__ inline bool CompactSingleEligible(ExecutionShape p){
return p.experts<=1 && p.rows<=p.cores*p.tm && p.rows>(p.cores-1)*p.tm && p.ck==Up(p.depth,32) &&
(uint64_t)p.tm*p.ck<=64*1024 && (uint64_t)p.tn*p.ck<=64*1024 && p.cols<=p.tn;
}
__aicore__ inline void CompactSingleFlow(GM_ADDR xs,GM_ADDR ws,GM_ADDR ss,GM_ADDR ys,GM_ADDR workspace,ExecutionShape p){
uint32_t core=GetBlockIdx();if ASCEND_IS_AIV{core/=2;}
uint32_t row=core*p.tm,rows=Min(p.tm,p.rows-row),ma=Up(rows,16),na=Up(p.cols,32);TPipe pipe;
if ASCEND_IS_AIC{
GlobalTensor<int8_t> x,w;GlobalTensor<half> exchange;
x.SetGlobalBuffer((__gm__ int8_t*)xs);w.SetGlobalBuffer((__gm__ int8_t*)ws);exchange.SetGlobalBuffer((__gm__ half*)workspace);
TBuf<TPosition::A1> l1;TBuf<TPosition::A2> l0a;TBuf<TPosition::B2> l0b;TBuf<TPosition::CO1> l0c;
pipe.InitBuffer(l1,(p.tm+p.tn)*p.ck);pipe.InitBuffer(l0a,p.tm*p.ck);pipe.InitBuffer(l0b,p.tn*p.ck);pipe.InitBuffer(l0c,p.tm*p.tn*4);
auto a1=l1.Get<int8_t>(),b1=a1[p.tm*p.ck],a0=l0a.Get<int8_t>(),b0=l0b.Get<int8_t>();auto c0=l0c.Get<int32_t>();
Nd2NzParams a{};a.ndNum=1;a.nValue=rows;a.dValue=p.depth;a.srcDValue=p.depth;a.dstNzC0Stride=ma;a.dstNzNStride=1;
Nd2NzParams b{};b.ndNum=1;b.nValue=p.depth;b.dValue=p.cols;b.srcDValue=p.cols;b.dstNzC0Stride=p.ck;b.dstNzNStride=1;
DataCopy(a1,x[(uint64_t)row*p.depth],a);DataCopy(b1,w,b);Fence<HardEvent::MTE2_MTE1>();
SetLoadDataRepeat({0,1,0});uint8_t pads[4]={0,0,0,0};SetFmatrix(1,ma,pads,FmatrixMode::FMATRIX_LEFT);
LoadData3DParamsV2<int8_t> la{};la.l1H=1;la.l1W=ma;la.channelSize=p.ck;la.kExtension=p.ck;la.mExtension=ma;
la.strideW=1;la.strideH=1;la.filterW=1;la.filterH=1;la.dilationFilterW=1;la.dilationFilterH=1;LoadData<int8_t,A_LOAD_CONFIG>(a0,a1,la);
LoadData2dTransposeParams lb{};lb.repeatTimes=p.ck/32;lb.srcStride=1;lb.dstGap=na/16-1;
for(uint32_t n=0;n<na/32;++n)LoadDataWithTranspose(b0[n*1024],b1[n*p.ck*32],lb);
Fence<HardEvent::MTE1_M>();MmadParams mm{};mm.m=ma;mm.n=na;mm.k=p.depth;mm.cmatrixInitVal=true;Mmad(c0,a0,b0,mm);
Fence<HardEvent::M_FIX>();FixpipeParamsV220 fp{};fp.mSize=rows;fp.nSize=na;fp.srcStride=ma;fp.dstStride=p.tn;
fp.quantPre=QuantMode_t::DEQF16;fp.deqScalar=(uint64_t)(127-ExchangeScaleShift(p))<<23;
Fixpipe<half,int32_t,CFG_ROW_MAJOR>(exchange[(uint64_t)core*p.tm*p.tn*2],c0,fp);CrossCoreSetFlag<2,PIPE_FIX>(0);Fence<HardEvent::FIX_M>();
}
if ASCEND_IS_AIV{
GlobalTensor<float> gains;GlobalTensor<half> y,exchange;
gains.SetGlobalBuffer((__gm__ float*)ss);y.SetGlobalBuffer((__gm__ half*)ys);exchange.SetGlobalBuffer((__gm__ half*)workspace);
uint32_t split=(rows+1)/2,first=Min(rows,split*(GetBlockIdx()%2)),nr=Min(split,rows-first),capacity=Up((p.tm+1)/2*p.tn,64);
TBuf<TPosition::VECCALC> memory;pipe.InitBuffer(memory,capacity*18+Up(p.tn*4,256)+1024);auto z=memory.Get<float>();
auto u=z[capacity],tail=u[capacity],result=tail[capacity],gain=result[capacity];auto input=result.ReinterpretCast<half>();auto output=gain[Up(p.tn,8)].ReinterpretCast<half>();
DataCopyPad(gain,gains,DataCopyExtParams{1,p.cols*4,0,0,0},DataCopyPadExtParams<float>{false,0,0,0});
Duplicate(tail,-1.5957691669464111f,capacity);PipeBarrier<PIPE_V>();CrossCoreWaitFlag<2>(0);if(!nr)return;
DataCopyPad(input,exchange[(uint64_t)core*p.tm*p.tn*2+first*p.tn],DataCopyExtParams{(uint16_t)nr,na*2,(p.tn-na)*2,0,0},DataCopyPadExtParams<half>{false,0,0,0});
Fence<HardEvent::MTE2_V>();Cast(z,input,RoundMode::CAST_NONE,nr*na);PipeBarrier<PIPE_V>();
union{uint32_t u;float f;} factor;factor.u=(127+ExchangeScaleShift(p))<<23;Muls(gain,gain,factor.f,na);PipeBarrier<PIPE_V>();
for(uint32_t n=0;n<na;n+=64)Mul(z[n],z[n],gain[n],(uint64_t)Min(64,na-n),(uint8_t)nr,{1,1,1,(uint8_t)(na/8),(uint8_t)(na/8),0});
PipeBarrier<PIPE_V>();Mul(u,z,z,nr*na);PipeBarrier<PIPE_V>();Axpy(tail,u,-0.07135481387376785f,nr*na);PipeBarrier<PIPE_V>();
Mul(tail,tail,z,nr*na);PipeBarrier<PIPE_V>();Mins(tail,tail,80.0f,nr*na);PipeBarrier<PIPE_V>();Exp(tail,tail,nr*na);PipeBarrier<PIPE_V>();
Adds(tail,tail,1.0f,nr*na);PipeBarrier<PIPE_V>();Div(result,z,tail,nr*na);PipeBarrier<PIPE_V>();Cast(output,result,RoundMode::CAST_RINT,nr*na);
Fence<HardEvent::V_MTE3>();DataCopyPad(y[(uint64_t)(row+first)*p.cols],output,DataCopyExtParams{(uint16_t)nr,p.cols*2,(na*2-Up(p.cols*2,32))/32,0,0});Fence<HardEvent::MTE3_V>();
}
}

__aicore__ inline ExecutionShape DecodeLaunchDescriptor(LaunchDescriptor q,uint32_t route){
ExecutionShape p{};p.rows=q.extentBits&0x1ffffu;p.depth=(q.extentBits>>17)&0x3fffu;p.cols=(q.extentBits>>31)&0x1fffu;p.experts=(q.extentBits>>44)&255u;
p.cores=(q.extentBits>>52)&63u;p.ring=(q.extentBits>>58)&7u;p.resident=(q.extentBits>>61)&3u;
p.tm=q.scheduleBits&2047u;p.tn=(q.scheduleBits>>11)&8191u;p.ck=(q.scheduleBits>>24)&16383u;p.tailStripe=(q.scheduleBits>>38)&8191u;
p.uniformRows=q.equalGroupRows;p.route=route;return p;
}

template<uint32_t Mode>
__schedmode__(1) __global__ __aicore__ void FusedKernel(LaunchDescriptor packet,GM_ADDR xs,GM_ADDR ws,GM_ADDR ss,GM_ADDR gs,GM_ADDR ys,GM_ADDR workspace) {
KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
ExecutionShape p=DecodeLaunchDescriptor(packet,Mode);InitSocState();
if constexpr(Mode==ColumnResident || Mode==PersistentExpert || Mode==PanelStriped || Mode==ShortGroupWave || Mode==TailPanel || Mode==LongReduction){if ASCEND_IS_AIC{ICachePreLoad(8);}if ASCEND_IS_AIV{ICachePreLoad(6);}}
GlobalTensor<int64_t> invocationGroups;invocationGroups.SetGlobalBuffer((__gm__ int64_t*)gs);DataCacheCleanAndInvalid<int64_t,CacheLine::ENTIRE_DATA_CACHE,DcciDst::CACHELINE_OUT>(invocationGroups);
if constexpr(Mode==PanelStriped){if ASCEND_IS_AIC{ICachePreLoad(4);}if ASCEND_IS_AIV{ICachePreLoad(6);}}
if constexpr(Mode==WideTail){if ASCEND_IS_AIV{ICachePreLoad(4);}}
if constexpr(Mode==ShallowResident){if ASCEND_IS_AIC{ICachePreLoad(4);}if ASCEND_IS_AIV{ICachePreLoad(4);}}
if(Mode==LongReduction)PackLongInputs(xs,ws,gs,workspace,p);
if(Mode==Compact && CompactSingleEligible(p)){
if ASCEND_IS_AIC{int64_t pc=asc_get_program_counter()&0xFFFFFFFFFFFFLL;asc_icache_preload(reinterpret_cast<void*>(pc),3);}
CompactSingleFlow(xs,ws,ss,ys,workspace,p);return;
}
if(Mode==ShallowResident && ShallowFullEligible(p)){ShallowFlow(xs,ws,ss,gs,ys,workspace,p);return;}
if(Mode==ColumnResident && ColumnHelpersEligible(p,gs)) {
ColumnHelperFlow(xs,ws,ss,gs,ys,workspace,p);return;
}
uint32_t core=GetBlockIdx();
if ASCEND_IS_AIV { core/=2; }
WorkIterator<Mode> cursor(p,gs,core); WorkChunk tile; uint32_t serial=0;
GlobalTensor<int32_t> scratch; scratch.SetGlobalBuffer((__gm__ int32_t*)workspace);
TPipe pipe;
if ASCEND_IS_AIC {
CubeExecutor<Mode> matrix(pipe,p,xs,ws,workspace);
if constexpr(Mode==TailStrip){if(cursor.RowAffine()){EmitGroupedPanels(matrix,cursor,p,scratch,core);return;}}
bool available=cursor.Next(tile);
while(available) {
WorkChunk future{};bool hasFuture=false;
if constexpr(Mode==ShallowResident || Mode==WideDouble || Mode==RowResident || Mode==PersistentExpert || Mode==PanelStriped || Mode==WideTail || Mode==TailStrip || Mode==ShortGroupWave)hasFuture=cursor.Next(future);
uint32_t slot=serial%p.ring;
matrix.Compute(tile,0,0,hasFuture?&future:nullptr);
if(serial>=p.ring) CrossCoreWaitFlag<2>(p.ring+slot);
matrix.Publish(tile,scratch,((uint64_t)core*p.ring+slot)*p.tm*p.tn);
CrossCoreSetFlag<2,PIPE_FIX>(slot); ++serial;
if constexpr(Mode==ShallowResident || Mode==WideDouble || Mode==RowResident || Mode==PersistentExpert || Mode==PanelStriped || Mode==WideTail || Mode==TailStrip || Mode==ShortGroupWave){tile=future;available=hasFuture;}
else available=cursor.Next(tile);
}
uint32_t outstanding=Min(serial,p.ring);
for(uint32_t j=serial-outstanding;j<serial;++j) CrossCoreWaitFlag<2>(p.ring+j%p.ring);
matrix.Finish();
}
if ASCEND_IS_AIV {
if constexpr(Mode==Interleaved){ConsumeInterleaved(pipe,cursor,p,ss,ys,workspace,core);return;}
if constexpr(Mode==WideDouble || Mode==RowResident){
ResidentConsumer<Mode> consumer(pipe,p,ss,ys,workspace);
while(cursor.Next(tile)){uint32_t slot=serial%p.ring;consumer.Process(tile,((uint64_t)core*p.ring+slot)*p.tm*p.tn,slot,GetBlockIdx()%2);++serial;}
consumer.Finish();return;
}
VectorEpilogue activation(pipe,p,ss,ys);
if(Mode==Compact || Mode==TailStrip || Mode==WideTail) {
while(cursor.Next(tile)) {
uint32_t slot=serial%p.ring;CrossCoreWaitFlag<2>(slot);
activation.Consume(tile,scratch,((uint64_t)core*p.ring+slot)*p.tm*p.tn,GetBlockIdx()%2,0,0,p.ring+slot);++serial;
}
activation.Drain();
} else {
VectorEpilogue second(pipe,p,ss,ys,1);uint32_t packet=0;
if constexpr(Mode==PersistentExpert)WarmPersistent(pipe,p,xs,ws,gs);
while(cursor.Next(tile)) {
uint32_t slot=serial%p.ring;CrossCoreWaitFlag<2>(slot);
uint64_t offset=((uint64_t)core*p.ring+slot)*p.tm*p.tn;
ConsumeDual(activation,second,p,tile,scratch,offset,GetBlockIdx()%2,packet,p.ring+slot);++serial;
}
activation.Drain();second.Drain();
}
}
}

inline uint32_t HostRoute(uint32_t e,uint32_t m,uint32_t k,uint32_t n) {
uint64_t outputs=(uint64_t)m*n, work=outputs*k, weights=(uint64_t)e*k*n;
if(work<=4096 && outputs<=64) return outputs<=8?Scalar:Tiny;
if(work<=(1ull<<22) && weights<=(1ull<<17)) return Compact;
if(k>=4096) return LongReduction;
uint32_t padding=((k+31)/32*32-k)+((n+31)/32*32-n);
if(padding>0) {
if((uint64_t)m>=256ull*e) return (uint64_t)k*n<=(1ull<<18)?TailStrip:PersistentExpert;
if((uint64_t)m<128ull*e) return ShortGroupWave;
return n>1024?WideTail:TailPanel;
}
if(k<=512) return (uint64_t)k*n<=(1ull<<18)?ShallowResident:PanelStriped;
if((uint64_t)m<=64ull*e) return (uint64_t)k>=2ull*n?WideDouble:Interleaved;
return (uint64_t)k>=2ull*n?ColumnResident:RowResident;
}
inline void ChooseTailGeometry(ExecutionShape &p){
uint32_t fullK=(p.depth+31)/32*32,bestStripe=0,bestK=0,bestMmads=0,bestGroups=0;
for(uint32_t stripe=((p.tn+1)/2+31)/32*32;stripe<=p.tn;stripe+=32){
uint32_t left=(65536/(2*p.tm))/32*32,right=(65536/(2*stripe))/32*32;
uint32_t ck=left<right?left:right;ck=ck<fullK?ck:fullK;if(ck<32)continue;
uint32_t chunks=(p.depth+ck-1)/ck,stripes=0,groups=0;
for(uint32_t col=0;col<p.cols;col+=p.tn){uint32_t width=p.cols-col; width=width<p.tn?width:p.tn;
for(uint32_t at=0;at<width;at+=stripe){uint32_t part=width-at;part=part<stripe?part:stripe;++stripes;groups+=(part+31)/32;}}
uint32_t mmads=stripes*chunks,totalGroups=groups*chunks;
if(!bestStripe || mmads<bestMmads || (mmads==bestMmads && totalGroups<bestGroups) || (mmads==bestMmads && totalGroups==bestGroups && ck>bestK)){
bestStripe=stripe;bestK=ck;bestMmads=mmads;bestGroups=totalGroups;}
}
if(bestStripe){p.ck=bestK;p.tailStripe=bestStripe;}
}
inline ExecutionShape MakePlan(uint32_t e,uint32_t m,uint32_t k,uint32_t n,uint32_t cores) {
ExecutionShape p{m,k,n,e,cores,HostRoute(e,m,k,n),64,256,128,2,1};
switch(p.route) {
case Scalar: p.cores=cores*2<m*n?cores*2:m*n;break;
case Tiny: p.cores=1;break;
case Compact: p.tm=32; p.tn=128; p.ck=128; p.ring=1;
p.cores=cores<2?cores:2; p.resident=0; break;
case LongReduction: p.tm=176; p.tn=128; p.ck=160; p.resident=0; break;
case TailStrip: p.tm=128; p.ck=192; p.resident=2; break;
case PersistentExpert: p.tm=128; p.resident=2; break;
case ShortGroupWave: p.tm=80; p.tn=288; p.ck=192; p.ring=1; p.resident=2; break;
case WideTail: p.tm=64; p.tn=384; p.ck=160; p.resident=2; break;
case TailPanel: p.tm=96; p.tn=320; p.ck=96; p.resident=2; break;
case ShallowResident: p.ck=((k+31)/32)*32; p.ring=4; p.resident=0; break;
case PanelStriped: p.ring=3; break;
case WideDouble: p.tn=512; p.ck=64; p.cores=e<cores?e:cores; break;
case Interleaved: p.tn=512; p.ck=64; break;
case ColumnResident: p.tm=128; p.ring=4; break;
case RowResident: p.tm=128; p.cores=e<cores?(cores/e)*e:cores; break;
}
if(p.route==TailStrip)ChooseTailGeometry(p);
return p;
}

inline LaunchDescriptor EncodeLaunchDescriptor(const ExecutionShape &p){
return {(uint64_t)p.rows|((uint64_t)p.depth<<17)|((uint64_t)p.cols<<31)|((uint64_t)p.experts<<44)|((uint64_t)p.cores<<52)|((uint64_t)p.ring<<58)|((uint64_t)p.resident<<61),
(uint64_t)p.tm|((uint64_t)p.tn<<11)|((uint64_t)p.ck<<24)|((uint64_t)p.tailStripe<<38),p.uniformRows};
}
__global__ __aicore__ void SmallAccurateKernel(GM_ADDR xs,GM_ADDR ws,GM_ADDR ss,GM_ADDR gs,GM_ADDR ys,SmallInvocation packet){
KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
InitSocState();TPipe pipe;TBuf<TPosition::VECCALC> memory;pipe.InitBuffer(memory,1024);
auto z=memory.Get<float>(),u=z[64];auto output=u[64].ReinterpretCast<half>();
GlobalTensor<int8_t> x,w;GlobalTensor<float> scales;GlobalTensor<int64_t> ends;GlobalTensor<half> y;
x.SetGlobalBuffer((__gm__ int8_t*)xs);w.SetGlobalBuffer((__gm__ int8_t*)ws);scales.SetGlobalBuffer((__gm__ float*)ss);
ends.SetGlobalBuffer((__gm__ int64_t*)gs);y.SetGlobalBuffer((__gm__ half*)ys);
DataCacheCleanAndInvalid<int64_t,CacheLine::ENTIRE_DATA_CACHE,DcciDst::CACHELINE_OUT>(ends);
uint32_t begin=0;
for(uint32_t e=0;e<packet.groups;++e){
uint32_t end=ends.GetValue(e);
for(uint32_t r=begin;r<end;++r)for(uint32_t col=0;col<packet.cols;++col){
int32_t sum=0;
for(uint32_t k=0;k<packet.depth;++k)sum+=(int32_t)x.GetValue((uint64_t)r*packet.depth+k)*(int32_t)w.GetValue(((uint64_t)e*packet.depth+k)*packet.cols+col);
z.SetValue(r*packet.cols+col,(float)sum*scales.GetValue((uint64_t)e*packet.cols+col));
}
begin=end;
}
uint32_t count=packet.rows*packet.cols;Fence<HardEvent::S_V>();
Mul(u,z,z,count);PipeBarrier<PIPE_V>();Muls(u,u,-0.07135481387376785f,count);PipeBarrier<PIPE_V>();
Adds(u,u,-1.5957691669464111f,count);PipeBarrier<PIPE_V>();Mul(u,u,z,count);PipeBarrier<PIPE_V>();
Mins(u,u,80.0f,count);PipeBarrier<PIPE_V>();Exp(u,u,count);PipeBarrier<PIPE_V>();
Adds(u,u,1.0f,count);PipeBarrier<PIPE_V>();Div(u,z,u,count);PipeBarrier<PIPE_V>();
Cast(output,u,RoundMode::CAST_RINT,count);Fence<HardEvent::V_MTE3>();
DataCopyPad(y,output,DataCopyExtParams{1,count*2,0,0,0});Fence<HardEvent::MTE3_V>();
}
__global__ __aicore__ void ScalarStreamingKernel(GM_ADDR xs,GM_ADDR ws,GM_ADDR ss,GM_ADDR gs,GM_ADDR ys,SmallInvocation packet){
KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
InitSocState();constexpr uint32_t capacity=4096;TPipe pipe;TBuf<TPosition::VECCALC> memory;pipe.InitBuffer(memory,capacity*13);
auto bytes=memory.Get<uint8_t>();auto input=bytes.ReinterpretCast<int8_t>();auto converted=bytes[capacity].ReinterpretCast<half>();
auto z=bytes[3*capacity].ReinterpretCast<float>(),u=bytes[7*capacity].ReinterpretCast<float>();auto output=bytes[11*capacity].ReinterpretCast<half>();
GlobalTensor<int8_t> x,w;GlobalTensor<float> scales;GlobalTensor<int64_t> ends;GlobalTensor<half> y;
x.SetGlobalBuffer((__gm__ int8_t*)xs);w.SetGlobalBuffer((__gm__ int8_t*)ws);scales.SetGlobalBuffer((__gm__ float*)ss);
ends.SetGlobalBuffer((__gm__ int64_t*)gs);y.SetGlobalBuffer((__gm__ half*)ys);
DataCacheCleanAndInvalid<int64_t,CacheLine::ENTIRE_DATA_CACHE,DcciDst::CACHELINE_OUT>(ends);
