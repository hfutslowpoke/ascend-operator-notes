class P15ShardOwnerCursor{int groupFirst[32];int groupRows[32];int expertWaves[32];Plan p;int lane;int columns;int shardRows;int ownCount;int ownCursor;int jobStep;bool valid;int16_t jobExpert[256];int16_t jobPanel[256];int16_t jobShard[256];int jobRows[256];unsigned char jobColor[256];__aicore__ inline void SortOwnJobs(){for(int i=1;i<ownCount;++i){int j=i;while(j>0&&jobColor[j-1]>jobColor[j]){int16_t te=jobExpert[j-1],tp=jobPanel[j-1],ts=jobShard[j-1];int tr=jobRows[j-1];unsigned char tc=jobColor[j-1];jobExpert[j-1]=jobExpert[j];jobPanel[j-1]=jobPanel[j];jobShard[j-1]=jobShard[j];jobRows[j-1]=jobRows[j];jobColor[j-1]=jobColor[j];jobExpert[j]=te;jobPanel[j]=tp;jobShard[j]=ts;jobRows[j]=tr;jobColor[j]=tc;--j;}}}public:__aicore__ inline P15ShardOwnerCursor(P15WideGroupBounds&bounds,Plan plan,int core,int panelColumns):p(plan),lane(core),columns(panelColumns),shardRows(p.tm),ownCount(0),ownCursor(0),jobStep(0),valid(false){if(p.e>32||p.cores<1||p.cores>64)return;int activeExperts=0;int totalRows=0;int totalWaves=0;int previousEnd=0;for(int e=0;e<p.e;++e){groupFirst[e]=previousEnd;previousEnd=bounds.End(e);groupRows[e]=previousEnd-groupFirst[e];if(groupRows[e]>0){++activeExperts;totalRows+=groupRows[e];expertWaves[e]=(groupRows[e]+p.tm-1)/p.tm;totalWaves+=expertWaves[e];}else{expertWaves[e]=0;}}if(activeExperts<1||totalWaves<1)return;int totalPackets=totalWaves*columns;if(totalPackets<p.cores)return;int averagePackets=(totalPackets+p.cores-1)/p.cores;int averageRows=totalRows/activeExperts;shardRows=(averageRows*2+p.tm-1)/p.tm*p.tm;if(shardRows<p.tm)shardRows=p.tm;int jobCount=0;for(int e=0;e<p.e;++e){if(groupRows[e]<1)continue;int shards=(groupRows[e]+shardRows-1)/shardRows;if(jobCount>256-shards*columns)return;jobCount+=shards*columns;}int loads[64];int oldPackets[64];unsigned char taken[32];unsigned int expertColors[32];unsigned int coreColors[64];for(int c=0;c<p.cores;++c){loads[c]=0;oldPackets[c]=0;coreColors[c]=0;}int oldJobs=columns*p.e;for(int owner=0;owner<old