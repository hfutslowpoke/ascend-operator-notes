WaitFlag<HardEvent::MTE2_V>(slot);Cast(converted,input[slot*capacity],RoundMode::CAST_NONE,count);PipeBarrier<PIPE_V>();Fence<HardEvent::V_MTE2>(slot);
if(row+2*batch<hi)ReadDotPanel(input[slot*capacity],x,row+2*batch,Min(batch,hi-row-2*batch),packet.depth,pitch,slot);
for(uint32_t at=0;at<count;at+=8192)Cast(product[at],converted[at],RoundMode::CAST_NONE,Min(8192,count-at));PipeBarrier<PIPE_V>();
for(uint32_t i=0;i<nr;++i)Mul(product[i*pitch],product[i*pitch],weights,pitch);PipeBarrier<PIPE_V>();
uint32_t shape[2]={nr,pitch};ReduceSum<float,Pattern::Reduce::AR,true>(z,product,temporary,shape,true);PipeBarrier<PIPE_V>();
Muls(z,z,factor,nr);PipeBarrier<PIPE_V>();SetMaskCount();SetVectorMask<float,MaskMode::COUNTER>(nr);
Mul<float,false>(u,z,z,MASK_PLACEHOLDER,1,{1,1,1,8,8,8});PipeBarrier<PIPE_V>();
Muls<float,false>(u,u,-0.07135481387376785f,MASK_PLACEHOLDER,1,{1,1,8,8});PipeBarrier<PIPE_V>();
Adds<float,false>(u,u,-1.5957691669464111f,MASK_PLACEHOLDER,1,{1,1,8,8});PipeBarrier<PIPE_V>();
Mul<float,false>(u,u,z,MASK_PLACEHOLDER,1,{1,1,1,8,8,8});PipeBarrier<PIPE_V>();
Mins<float,false>(u,u,80.0f,MASK_PLACEHOLDER,1,{1,1,8,8});PipeBarrier<PIPE_V>();
Exp<float,false>(u,u,MASK_PLACEHOLDER,1,{1,1,8,8});PipeBarrier<PIPE_V>();
Adds<float,false>(u,u,1.0f,MASK_PLACEHOLDER,1,{1,1,8,8});PipeBarrier<PIPE_V>();
Div<float,false>(u,z,u,MASK_PLACEHOLDER,1,{1,1,1,8,8,8});PipeBarrier<PIPE_V>();SetMaskNorm();ResetMask();
if(outputBusy){Fence<HardEvent::MTE3_V>(0);outputBusy=false;}
Cast(output,u,RoundMode::CAST_RINT,nr);Fence<HardEvent::V_MTE3>(0);
DataCopyPad(y[row],output,DataCopyExtParams{1,nr*2,0,0,0});outputBusy=true;
}
}
if(previous>=last)break;
}
if(outputBusy)Fence<HardEvent::MTE3_V>(0);
}
