#include "kernel_operator.h"
#include "c_api/asc_simd.h"
#include "acl/acl.h"
#include <cstdint>

namespace independent_gmg {
using namespace AscendC;
constexpr IsResetLoad3dConfig A_LOAD_CONFIG={false,false};
enum Route : uint32_t {
Scalar, Tiny, Compact, LongReduction, TailStrip, PersistentExpert,
ShortGroupWave, WideTail, TailPanel, ShallowResident, PanelStriped,
WideDouble, Interleaved, ColumnResident, RowResident, Streamed
};
struct ExecutionShape {
uint32_t rows, depth, cols, experts, cores;
uint32_t route, tm, tn, ck, ring, resident, uniformRows, rowExperts, rowMapValid, tailStripe;
};
struct LaunchDescriptor {uint64_t extentBits,scheduleBits;uint32_t equalGroupRows;};
static_assert(sizeof(LaunchDescriptor)==24);
struct SmallInvocation {uint32_t rows;uint16_t depth,cols;uint32_t groups;uint16_t workers,flags;};
static_assert(sizeof(SmallInvocation)==16);


__aicore__ inline uint32_t Up(uint32_t x, uint32_t a) { return (x+a-1)/a*a; }
__aicore__ inline uint32_t Min(uint32_t a, uint32_t b) { return a < b ? a : b; }
template<HardEvent E> __aicore__ inline void Fence(uint32_t id=0) {
SetFlag<E>(id); WaitFlag<E>(id);
}
struct WorkChunk { uint32_t expert, row, col, rows, cols; };

__aicore__ inline uint32_t ExchangeScaleShift(ExecutionShape p) {
if(p.route==ShortGroupWave || p.route==TailPanel || p.route==Interleaved || p.route==LongReduction || p.route==Scalar || p.route==Tiny)return 0;
if(p.route==WideDouble || (p.route==Compact && p.depth==p.ck))return 9;
uint32_t bound=p.depth*(p.route==PersistentExpert?16256:16384),shift=0;
while(bound>(p.route==PersistentExpert?65504u:60000u)){bound=(bound+1)/2;++shift;}
return shift;
}

template<uint32_t Mode>
class GroupEndpoints {
GlobalTensor<int64_t> ends;
#if defined(__CCE_AICORE__)
LocalTensor<int64_t> cached;
bool staged=false,pending=false;
#endif
public:
__aicore__ inline GroupEndpoints(GM_ADDR address,ExecutionShape p){
ends.SetGlobalBuffer((__gm__ int64_t*)address);
#if defined(__CCE_AICORE__)
if constexpr(Mode==TailStrip){
if ASCEND_IS_AIV{
cached=LocalTensor<int64_t>(TPosition::VECCALC,0,Up(p.experts,4));
DataCopyPad(cached,ends,DataCopyExtParams{1,p.experts*8,0,0,0},DataCopyPadExtParams<int64_t>{false,0,0,0});
SetFlag<HardEvent::MTE2_S>(2);staged=true;pending=true;
}
if ASCEND_IS_AIC{DataCacheCleanAndInvalid<int64_t,CacheLine::ENTIRE_DATA_CACHE,DcciDst::CACHELINE_OUT>(ends);}
}
#endif
}

__aicore__ inline uint32_t GetValue(uint32_t expert){
#if defined(__CCE_AICORE__)
if constexpr(Mode==TailStrip){
if(pending){WaitFlag<HardEvent::MTE2_S>(2);pending=false;}
if(staged)return (uint32_t)cached.GetValue(expert);
}
#endif
return (uint32_t)ends.GetValue(expert);
}
__aicore__ inline void ReleaseStaging(){
#if defined(__CCE_AICORE__)
if constexpr(Mode==TailStrip){if(staged){Fence<HardEvent::S_MTE2>(2);staged=false;}}
#endif
}
};

template<uint32_t Mode>
class WorkIterator {
ExecutionShape p;
uint32_t owner, begin[128], end[128], order[128], mapping[128];
uint32_t expertPos=0,rowOffset=0,panel=0,ordinal=0,totalTasks=0;
uint32_t stripBegin=0,stripEnd=0,dominant=128,dominantCores=0,smallOrdinal=0;
uint32_t spareCount=0,spareOffsets[128],spareOwners[256],shardSpan=1,smallExperts=0;
struct Job { uint32_t expert,row,rows,col,cols,owner,color; };
Job jobs[256]; uint32_t jobCount=0,jobPos=0,jobRow=0;
bool useJobs=false,spares=false;
__aicore__ inline uint32_t Length(uint32_t e) { return end[e]-begin[e]; }
__aicore__ inline uint32_t Panels() { return (p.cols+p.tn-1)/p.tn; }
__aicore__ inline uint32_t Lightest(uint32_t *load) {
uint32_t best=0; for(uint32_t c=1;c<p.cores;++c) if(load[c]<load[best])best=c;
return best;
}
public:
__aicore__ inline bool RowAffine()const{return spares;}
__aicore__ inline WorkIterator(ExecutionShape config,GM_ADDR group,uint32_t core):p(config),owner(core) {
GroupEndpoints<Mode> g(group,p);
uint32_t prev=0,active=0,maxLength=0;
for(uint32_t e=0;e<p.experts;++e) {
begin[e]=prev;end[e]=(uint32_t)g.GetValue(e);prev=end[e];order[e]=e;mapping[e]=e;
uint32_t length=Length(e); active+=length>0;
if(length>maxLength){maxLength=length;dominant=e;}
totalTasks+=(length+p.tm-1)/p.tm*Panels();
}
g.ReleaseStaging();
if(Mode==PersistentExpert || Mode==LongReduction || Mode==WideTail || Mode==TailPanel || Mode==TailStrip) {
for(uint32_t i=1;i<p.experts;++i) {
uint32_t e=order[i],j=i;
while(j>0 && (Length(order[j-1])<Length(e) || (Length(order[j-1])==Length(e)&&order[j-1]>e))) {
order[j]=order[j-1];--j;
}
order[j]=e;
}
}
if(Mode==Interleaved && Panels()==2 && p.experts>p.cores && p.experts<2*p.cores) {
uint32_t extra=p.experts-p.cores;
for(uint32_t i=0;i<p.experts;++i)order[i]=i<extra?p.cores+i:i-extra;
}
stripBegin=(uint64_t)p.rows*owner/p.cores;stripEnd=(uint64_t)p.rows*(owner+1)/p.cores;
if(Mode==PersistentExpert && maxLength*4ull>3ull*p.rows && p.cores>Panels()+2)
dominantCores=(p.cores-2)/Panels()*Panels();
if(Mode==PersistentExpert && dominantCores){
for(uint32_t e=0;e<p.experts;++e)if(e!=dominant && Length(e))mapping[e]=smallExperts++;
}
if(Mode==LongReduction)for(uint32_t e=0;e<p.experts;++e)order[e]=e;
if(Mode==TailPanel) {

uint32_t light=p.experts*Panels()>p.cores?(p.experts*Panels()-p.cores)/Panels():0;
for(uint32_t i=0;i<light;++i) mapping[i]=order[p.experts-light+i];
for(uint32_t i=light;i<p.experts;++i)mapping[i]=order[i-light];
for(uint32_t i=0;i<p.experts;++i)order[i]=mapping[i];
}
if(Mode==TailStrip && p.experts>p.cores && p.cores<=128) {
spareCount=p.experts-p.cores;
uint32_t tasks=0;
for(uint32_t j=p.cores;j<p.experts;++j)tasks+=(Length(order[j])+p.tm-1)/p.tm;
if(tasks<=2*p.cores && tasks<=256) {
spares=true;uint32_t loads[128];for(uint32_t c=0;c<p.cores;++c)loads[c]=0;
for(uint32_t e=0;e<p.experts;++e)mapping[e]=p.cores;
uint32_t assigned=0;
for(uint32_t e=0;e<p.experts;++e) {
bool spare=false;
for(uint32_t j=p.cores;j<p.experts;++j)if(order[j]==e)spare=true;
if(!spare){mapping[e]=assigned;loads[assigned++]=Length(e);}
}
uint32_t at=0;
for(uint32_t j=p.cores;j<p.experts;++j) {
uint32_t e=order[j];spareOffsets[e]=at;
for(uint32_t r=0;r<Length(e);r+=p.tm) {
uint32_t c=Lightest(loads);spareOwners[at++]=c;loads[c]+=Min(p.tm,Length(e)-r);
}
}
uint32_t position=0;
for(uint32_t e=0;e<p.experts;++e)if(mapping[e]<p.cores)order[position++]=e;
for(uint32_t e=0;e<p.experts;++e)if(mapping[e]>=p.cores)order[position++]=e;
}
}
if(Mode==WideTail && active && p.cores<=128) {
uint32_t shard=Up(2*(p.rows/active),p.tm);if(shard<p.tm)shard=p.tm;
uint32_t required=0;
for(uint32_t e=0;e<p.experts;++e)required+=(Length(e)+shard-1)/shard*Panels();
if(required<=256) {
useJobs=true;shardSpan=shard;uint32_t loads[128];uint64_t coreColors[128],expertColors[128];
for(uint32_t c=0;c<p.cores;++c){loads[c]=0;coreColors[c]=0;}
for(uint32_t e=0;e<p.experts;++e)expertColors[e]=0;
for(uint32_t j=0;j<p.experts;++j) {
uint32_t e=order[j];
for(uint32_t r=0;r<Length(e);r+=shard)for(uint32_t col=0;col<p.cols;col+=p.tn) {
uint32_t c=Lightest(loads),nr=Min(shard,Length(e)-r),nc=Min(p.tn,p.cols-col),color=0;
uint64_t blocked=coreColors[c]|expertColors[e];
while(color<63 && ((blocked>>color)&1u))++color;
coreColors[c]|=1ull<<color;expertColors[e]|=1ull<<color;
if(c==owner)jobs[jobCount++]={e,begin[e]+r,nr,col,nc,c,color};loads[c]+=nr+nc;
}
}
for(uint32_t i=1;i<jobCount;++i) {
Job value=jobs[i];uint32_t j=i;
while(j && jobs[j-1].color>value.color){jobs[j]=jobs[j-1];--j;}
jobs[j]=value;
}
}
}
}
__aicore__ inline bool Next(WorkChunk &t) {
if(useJobs) {
while(jobPos<jobCount) {
Job j=jobs[jobPos];
if(j.owner!=owner || jobRow>=j.rows){++jobPos;jobRow=0;continue;}
uint32_t wave=jobRow/p.tm,waves=(j.rows+p.tm-1)/p.tm;
if((j.expert^(j.col/p.tn)^((j.row-begin[j.expert])/shardSpan))&1)wave=waves-1-wave;
uint32_t r=wave*p.tm;
t={j.expert,j.row+r,j.col,Min(p.tm,j.rows-r),j.cols};jobRow+=p.tm;return true;
}
return false;
}
while(expertPos<p.experts) {
uint32_t position=expertPos,e=order[position],first=begin[e],last=end[e];
if(Mode==ShallowResident){first=first>stripBegin?first:stripBegin;last=last<stripEnd?last:stripEnd;}
if(last<=first || (Mode!=ShortGroupWave && rowOffset>=last-first)){++expertPos;rowOffset=0;panel=0;continue;}
uint32_t nPanels=Panels(),width=p.tn;
bool remainder=Mode==ShortGroupWave && e>=p.experts/p.cores*p.cores;
if(remainder) {
width=256;nPanels=(p.cols+width-1)/width;
if(nPanels>1 && p.cols%width>0 && p.cols%width<32)--nPanels;
}
if(Mode==ShortGroupWave && panel>=nPanels){++expertPos;rowOffset=0;panel=0;continue;}
uint32_t thisPanel=panel,wave=rowOffset/p.tm;
t={e,first+rowOffset,thisPanel*width,Min(p.tm,last-first-rowOffset),Min(width,p.cols-thisPanel*width)};
if(remainder && thisPanel+1==nPanels)t.cols=p.cols-t.col;
if(Mode==ShortGroupWave){rowOffset+=p.tm;if(rowOffset>=last-first){rowOffset=0;++panel;}}
else {++panel;if(panel>=nPanels){panel=0;rowOffset+=p.tm;}}
uint32_t job=ordinal++,assigned=job%p.cores;
if(Mode==ShallowResident)return true;
if(Mode==WideDouble || Mode==ColumnResident)assigned=(e+wave*p.experts)%p.cores;
else if(Mode==RowResident) {
uint32_t lanes=p.cores/p.experts;
if(lanes)assigned=e+Min(thisPanel*lanes/nPanels,lanes-1)*p.experts;
} else if(Mode==PanelStriped) {
if(job>=(uint64_t)totalTasks*owner/p.cores && job<(uint64_t)totalTasks*(owner+1)/p.cores)return true;
continue;
} else if(Mode==PersistentExpert && dominantCores) {
uint32_t reserve=p.cores-nPanels-2;
if(e==dominant) {
uint32_t perPanel=dominantCores/nPanels;
uint32_t waves=(last-first+p.tm-1)/p.tm;
assigned=thisPanel*perPanel+Min(((uint64_t)(wave+1)*perPanel-1)/waves,perPanel-1);
if(assigned>=reserve)++assigned;
} else {
uint32_t job=thisPanel*smallExperts+mapping[e];
assigned=job<p.cores?job:reserve;++smallOrdinal;
}
} else if(Mode==TailStrip && spares) {
assigned=mapping[e]<p.cores?mapping[e]:spareOwners[spareOffsets[e]+wave];
} else if(Mode==ShortGroupWave) {
if(!remainder)assigned=e%p.cores;
else {
uint32_t extra=p.experts%p.cores;
uint32_t weight=Up(p.cols,32),offset=(e-p.experts/ p.cores*p.cores)*weight+t.col;
assigned=Min((uint64_t)offset*p.cores/(extra*weight),p.cores-1);
}
uint32_t waves=(last-first+p.tm-1)/p.tm;
if(waves<=3){uint32_t r=(wave+thisPanel)%waves*p.tm;t.row=first+r;t.rows=Min(p.tm,last-first-r);}
} else if(Mode==TailPanel) {
uint32_t sequence=thisPanel;
if((position&1) && position+1<p.experts)sequence=(thisPanel+1)%nPanels;
assigned=(position*nPanels+sequence)%p.cores;
} else if(Mode==Interleaved && nPanels==2 && p.experts>p.cores && p.experts<2*p.cores) {
uint32_t extra=p.experts-p.cores,light=p.cores-extra,logical;
if(e<p.cores)logical=e;
else logical=thisPanel==0?e-p.cores:extra+(e-p.cores)%light;
assigned=logical? p.cores-logical:0;
} else if(Mode==LongReduction) {
uint32_t largeTasks=(Length(dominant)+p.tm-1)/p.tm*nPanels;
if(largeTasks<p.cores) {
uint32_t waves=(Length(dominant)+p.tm-1)/p.tm;
assigned=e==dominant?thisPanel*waves+wave:largeTasks+(thisPanel+wave*nPanels)%(p.cores-largeTasks);
}
}
if(assigned==owner)return true;
}
return false;
}
};

template<>
class WorkIterator<ShallowResident> {
ExecutionShape p;GlobalTensor<int64_t> groups;
uint32_t expert,first,last,edge=0,row=0,col=0;bool active=false;
public:
__aicore__ inline WorkIterator(ExecutionShape plan,GM_ADDR gs,uint32_t core):p(plan){
groups.SetGlobalBuffer((__gm__ int64_t*)gs);
first=(uint64_t)p.rows*core/p.cores;last=(uint64_t)p.rows*(core+1)/p.cores;
if(p.uniformRows)expert=first/p.uniformRows;
else{uint32_t low=0,high=p.experts;while(low<high){uint32_t mid=(low+high)/2;if(groups.GetValue(mid)<=first)low=mid+1;else high=mid;}expert=low;}
}
__aicore__ inline bool Next(WorkChunk &t){
while(expert<p.experts && first<last){
if(!active){edge=Min(last,p.uniformRows?(expert+1)*p.uniformRows:(uint32_t)groups.GetValue(expert));row=first;col=0;active=true;}
if(row<edge){t={expert,row,col,Min(p.tm,edge-row),Min(p.tn,p.cols-col)};row+=p.tm;return true;}
col+=p.tn;
if(col<p.cols){row=first;continue;}
first=edge;++expert;active=false;
}
return false;
}
};

template<>
class WorkIterator<PanelStriped> {
ExecutionShape p;GlobalTensor<int64_t> groups;uint32_t panels,job,last,expert=0,row=0,edge=0,col=0;
public:
__aicore__ inline WorkIterator(ExecutionShape plan,GM_ADDR gs,uint32_t core):p(plan){
groups.SetGlobalBuffer((__gm__ int64_t*)gs);panels=(p.cols+p.tn-1)/p.tn;
uint32_t jobs=p.experts*panels;job=(uint64_t)jobs*core/p.cores;last=(uint64_t)jobs*(core+1)/p.cores;
}
__aicore__ inline bool Next(WorkChunk &t){
while(true){
if(row<edge){t={expert,row,col,Min(p.tm,edge-row),Min(p.tn,p.cols-col)};row+=p.tm;return true;}
if(job>=last)return false;
expert=job/panels;col=job%panels*p.tn;++job;
row=p.uniformRows?expert*p.uniformRows:(expert?(uint32_t)groups.GetValue(expert-1):0);
edge=p.uniformRows?(expert+1)*p.uniformRows:(uint32_t)groups.GetValue(expert);
}
}
};

class ResidentRows {
ExecutionShape p;GlobalTensor<int64_t> groups;uint32_t next,expert=0,begin=0,prefix=0;
public:
__aicore__ inline ResidentRows(ExecutionShape plan,GM_ADDR gs,uint32_t core):p(plan),next(core){groups.SetGlobalBuffer((__gm__ int64_t*)gs);}
__aicore__ inline bool Next(WorkChunk &t){
if(p.uniformRows){
uint32_t waves=(p.uniformRows+p.tm-1)/p.tm;
if(next>=p.experts*waves)return false;
uint32_t e=next/waves,r=next%waves*p.tm;next+=p.cores;
t={e,e*p.uniformRows+r,0,Min(p.tm,p.uniformRows-r),p.cols};return true;
}
while(expert<p.experts){
uint32_t end=groups.GetValue(expert),waves=(end-begin+p.tm-1)/p.tm;
if(next<prefix+waves){uint32_t row=begin+(next-prefix)*p.tm;next+=p.cores;t={expert,row,0,Min(p.tm,end-row),p.cols};return true;}
prefix+=waves;begin=end;++expert;
}
return false;
}
};
template<>
class WorkIterator<WideDouble> {
ExecutionShape p;ResidentRows rows;WorkChunk resident{};uint32_t col=0;bool active=false;
public:
__aicore__ inline WorkIterator(ExecutionShape plan,GM_ADDR gs,uint32_t core):p(plan),rows(plan,gs,core){}
__aicore__ inline bool Next(WorkChunk &t){
if(!active || col>=p.cols){if(!rows.Next(resident))return false;active=true;col=0;}
t=resident;t.col=col;t.cols=Min(p.tn,p.cols-col);col+=p.tn;return true;
}
};
template<>
class WorkIterator<RowResident> {
ExecutionShape p;GlobalTensor<int64_t> groups;uint32_t owners,lane,lanes,expert,row=0,begin=0,end=0,col=0,limit=0;bool active=false;
public:
__aicore__ inline WorkIterator(ExecutionShape plan,GM_ADDR gs,uint32_t core):p(plan){
groups.SetGlobalBuffer((__gm__ int64_t*)gs);owners=Min(p.experts,p.cores);expert=core%owners;lane=core/owners;
lanes=p.cores/owners+(expert<p.cores%owners);
}
__aicore__ inline bool Next(WorkChunk &t){
while(expert<p.experts){
if(!active){
begin=p.uniformRows?expert*p.uniformRows:(expert?(uint32_t)groups.GetValue(expert-1):0);
end=p.uniformRows?(expert+1)*p.uniformRows:(uint32_t)groups.GetValue(expert);row=begin;
uint32_t panels=(p.cols+p.tn-1)/p.tn,whole=panels/lanes,extra=panels%lanes,start=lane*whole+Min(lane,extra);
col=start*p.tn;limit=Min(p.cols,(start+whole+(lane<extra))*p.tn);active=true;
}
if(col<limit && row<end){t={expert,row,col,Min(p.tm,end-row),Min(p.tn,p.cols-col)};row+=p.tm;if(row>=end){row=begin;col+=p.tn;}return true;}
expert+=owners;active=false;
}
return false;
}
};
template<>
class WorkIterator<Interleaved> {
ExecutionShape p;GlobalTensor<int64_t> groups;ResidentRows linear;WorkChunk resident{};
uint32_t logical,extra,light,phase=0,moved,row=0,edge=0,col=0,expert=0,turn=0;bool split=false,loaded=false,linearActive=false;
__aicore__ inline void Load(uint32_t e){expert=e;row=p.uniformRows?e*p.uniformRows:(e?(uint32_t)groups.GetValue(e-1):0);edge=p.uniformRows?(e+1)*p.uniformRows:(uint32_t)groups.GetValue(e);loaded=true;}
public:
__aicore__ inline WorkIterator(ExecutionShape plan,GM_ADDR gs,uint32_t core):p(plan),linear(plan,gs,core){
groups.SetGlobalBuffer((__gm__ int64_t*)gs);logical=core?p.cores-core:0;extra=p.experts>p.cores?p.experts-p.cores:0;light=p.cores-extra;
split=(p.cols+p.tn-1)/p.tn==2 && p.experts>p.cores && p.experts<2*p.cores;moved=logical>=extra?logical-extra:0;
}
__aicore__ inline bool Next(WorkChunk &t){
if(!split){
if(!linearActive || col>=(p.cols+p.tn-1)/p.tn){if(!linear.Next(resident))return false;linearActive=true;col=0;}
uint32_t panel=(col+resident.expert)%((p.cols+p.tn-1)/p.tn);++col;t=resident;t.col=panel*p.tn;t.cols=Min(p.tn,p.cols-t.col);return true;
}
while(phase<2){
if(phase==0){
if(logical<extra){
if(!loaded)Load(p.cores+logical);
if(row<edge){t={expert,row,0,Min(p.tm,edge-row),p.tn};row+=p.tm;return true;}
loaded=false;phase=1;
}else{
if(moved>=extra){loaded=false;phase=1;continue;}
if(!loaded)Load(p.cores+moved);
if(row<edge){t={expert,row,p.tn,Min(p.tm,edge-row),p.cols-p.tn};row+=p.tm;return true;}
moved+=light;loaded=false;
}
}else{
if(!loaded)Load(logical);
if(row<edge){t={expert,row,turn*p.tn,Min(p.tm,edge-row),Min(p.tn,p.cols-turn*p.tn)};turn^=1;if(!turn)row+=p.tm;return true;}
phase=2;
}
}
return false;
}
};

template<>
class WorkIterator<ShortGroupWave> {
ExecutionShape p;GlobalTensor<int64_t> groups;uint32_t owner,base,expert,extraEnd=0,begin=0,end=0,panel=0,wave=0,panels=0,width=0,phase=0;bool loaded=false;
__aicore__ inline void StartExtra(){
phase=1;uint32_t extra=p.experts-base,weight=Up(p.cols,32);uint64_t total=(uint64_t)extra*weight;
uint32_t lo=(total*owner+p.cores-1)/p.cores,hi=(total*(owner+1)+p.cores-1)/p.cores;
expert=base+lo/weight;extraEnd=Min(p.experts,base+(hi+weight-1)/weight);loaded=false;
}
public:
__aicore__ inline WorkIterator(ExecutionShape plan,GM_ADDR gs,uint32_t core):p(plan),owner(core){groups.SetGlobalBuffer((__gm__ int64_t*)gs);base=p.experts/p.cores*p.cores;expert=owner;if(expert>=base)StartExtra();}
__aicore__ inline bool Next(WorkChunk &t){
while(phase<2){
if(expert>=(phase?extraEnd:base)){if(!phase){StartExtra();continue;}phase=2;break;}
if(!loaded){begin=expert?(uint32_t)groups.GetValue(expert-1):0;end=groups.GetValue(expert);panel=0;wave=0;width=phase?256:p.tn;panels=(p.cols+width-1)/width;if(phase && panels>1 && p.cols%width && p.cols%width<32)--panels;loaded=true;}
uint32_t waves=(end-begin+p.tm-1)/p.tm;
while(panel<panels && waves){
if(phase){uint32_t weight=Up(p.cols,32),offset=(expert-base)*weight+panel*width;uint32_t selected=Min((uint64_t)offset*p.cores/((p.experts-base)*weight),p.cores-1);if(selected!=owner){++panel;wave=0;continue;}}
if(wave>=waves){++panel;wave=0;continue;}
uint32_t at=waves<=3?(wave+panel)%waves:wave;uint32_t col=panel*width,n=phase && panel+1==panels?p.cols-col:Min(width,p.cols-col);
