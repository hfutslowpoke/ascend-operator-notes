if(joint)more=cursor.Next(t);
else{more=next<bTasks;if(more){uint32_t task=next;next+=p.cores;t.expert=nonempty[task/(nb*kb)];t.row=(task%kb)*64;t.col=(task/kb)%nb*width;t.rows=Min(64,p.depth-t.row);t.cols=Min(width,p.cols-t.col);}}
if(!more)break;
