l0a.FreeTensor(aa);
Fence<HardEvent::MTE1_MTE2>();
if(fillB && chunk+2<chunks){uint32_t next=KAt(chunk+2,chunks,firstK);FillResidentB(t,next,Min(p.ck,lastK-next),slot);}
if constexpr(Mode==ShortGroupWave){if(keepB && chunks>=3 && chunk+3==chunks && future && (future->expert!=t.expert || future->col!=t.col))StagePanelPrefix(*future);}
if constexpr(Mode==TailStrip){if(rowStageOffset && upcomingGroup && !pendingScratch && t.col+t.cols>=p.cols && !chunk)PrefetchScratch(*upcomingGroup);}
if constexpr(Mode==PersistentExpert){
uint32_t marker=(hitA || useResidentA) && hitB?0:Min(2,chunks-1);
