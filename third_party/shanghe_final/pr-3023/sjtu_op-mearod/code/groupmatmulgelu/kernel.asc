class ShallowRowBandCursor{P04ShallowRangedBounds&bounds;Plan p;int expert,begin,end=0,row=0,col=0,last;bool active=false;public:__aicore__ inline ShallowRowBandCursor(P04ShallowRangedBounds&groups,Plan plan,int core):bounds(groups),p(plan){begin=static_cast<int>((uint64_t)p.m*core/p.cores);last=static_cast<int>((uint64_t)p.m*(core+1)/p.cores);int rowHint=bounds.RowHint();expert=rowHint>0?begin/rowHint:p.e;bool located=expert<p.e&&bounds.Begin(expert)<=begin&&bounds.End(expert)>begin;if(!located){int low=0,high=p.e;while(low<high){int middle=(low+high)/2;if(bounds.End(middle)<=begin)low=middle+1;else high=middle;}expert=low;}}__aicore__ inline bool Next(WorkTile&tile){while(true){if(active){if(row<end){tile={expert,row,col,Min(p.tm,end-row),Min(p.tn,p.n-col)};row+=p.tm;return true;}col+=p.tn;if(col<p.n){row=begin;continue;}begin=end;++expert;active=false;}if(expert>=p.e||begin>=last)return false;end=Min(last,bounds.End(expert));if(end<=begin){begin=end;++expert;continue;}col=0;row=begin;active=true;}}};
