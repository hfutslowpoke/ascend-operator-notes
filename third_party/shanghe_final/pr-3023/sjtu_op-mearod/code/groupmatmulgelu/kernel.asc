__aicore__ inline CubeExecutor(TPipe &pipe, ExecutionShape config, GM_ADDR xs, GM_ADDR ws, GM_ADDR workspace) : p(config) {
x.SetGlobalBuffer((__gm__ int8_t*)xs); w.SetGlobalBuffer((__gm__ int8_t*)ws);
uint32_t kp=Up(p.depth,32);
packed=Mode==LongReduction;
if(packed) {
uint64_t exchange=(uint64_t)p.cores*p.ring*p.tm*p.tn*4;
x.SetGlobalBuffer((__gm__ int8_t*)workspace+exchange);
w.SetGlobalBuffer((__gm__ int8_t*)workspace+exchange+(uint64_t)Up(p.rows,64)*kp);
}
bSlots=(Mode==PanelStriped || Mode==Interleaved)?4:
((Mode==WideDouble || Mode==RowResident || Mode==ColumnResident)?3:2);
bFactor=(Mode==WideDouble || Mode==RowResident)?3:1;
if(bFactor>1)bSlots=2;
keepA=p.resident==1 && (uint64_t)p.tm*kp+bSlots*bFactor*p.tn*p.ck<=496*1024;
keepB=p.resident==2 && (uint64_t)p.tn*kp+2*p.tm*p.ck<=496*1024;
