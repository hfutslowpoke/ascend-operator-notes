__aicore__ inline int P13LongDualFlowCapacity(const Plan&p){int narrow=Min(8192,RoundExtent((p.tm+p.vectors-1)/p.vectors*p.tn,512));int wide=Min(8448,RoundExtent((p.tm+p.vectors-1)/p.vectors*p.tn,512));int size=RoundExtent(wide,512),sc=RoundExtent(p.tn,8);int stride=RoundExtent(size*10+3*RoundExtent(size/8,256)+sc*4+32,256);return 2*stride<=184*1024?wide:narrow;}
