__aicore__ inline void Packed(const WorkChunk &t) {
p.tm=t.rows<=32?32:176;p.ck=t.rows<=32?256:160;
uint32_t ma=t.rows<=32?32:Up(t.rows,16),na=Up(t.cols,32),stageK=2*p.ck,stages=(p.depth+stageK-1)/stageK;
