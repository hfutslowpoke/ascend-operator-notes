MTE2_MTE1>(inputSlot);fullReady=true;}int slot=globalChunk&1;int valid=Min(p.ck,stageValid-innerK),ka=RoundExtent(valid,32);WaitFlag<HardEvent::M_MTE1>(slot);auto ax=a0[slot*p.tm*p.ck],bx=b0[slot*p.tn*p.ck];LoadLeftFractals(ax,a1,ma,ka,(k0+innerK)/32);LoadRightFractals(bx,bl,na,ka,stageK,innerK/32);SetFlag<HardEvent::MTE1_M>(slot);WaitFlag<HardEvent::MTE1_M>(slot);MmadParams mm;mm.m=ma;mm.n=na;mm.k=valid;mm.cmatrixInitVal=globalChunk==0;Mmad(c,ax,bx,mm);if((ma/16)*(na/16)<10)PipeBarrier<PIPE_M>();SetFlag<HardEvent::M_MTE1>(slot);}if(!fullReady)WaitFlag<HardEvent::MTE2_MTE1>(inputSlot);SetFlag<HardEvent::MTE1_MTE2>(inputSlot);if(stage+2<stageCount)FetchStage(tile,stage+2,false);}for(int i=0;i<2;++i){WaitFlag<HardEvent::MTE1_MTE2>(i);SetFlag<HardEvent::MTE1_MTE2>(i);WaitFlag<HardEvent::M_MTE1>(i);SetFlag<HardEvent::M_MTE1>(i);}}__aicore__ inline void SendTile(GlobalTensor<int32_t>dst,int readyFlag){AwaitPipe<HardEvent::M_FIX>();FixpipeParamsV220 q;q.mSize=mv;q.nSize=na;q.srcStride=ma;q.dstStride=p.tn;q.quantPre=QuantMode_t::NoQuant;Fixpipe<int32_t,int32_t,CFG_ROW_MAJOR>(dst,c,q);CrossCoreSetFlag<2,PIPE_FIX>(readyFlag);SetFlag<HardEvent::FIX_M>(0);published=true;}__aicore__ inline void P01SendTileHalf(GlobalTensor<half>dst,int readyFlag){AwaitPipe<HardEvent::M_FIX>();FixpipeParamsV220 q;q.mSize=mv;q.nSize=na;q.srcStride=ma;q.dstStride=p.tn;q.quantPre=QuantMode_t::DEQF16;q.deqScalar=0x3B000000ULL;Fixpipe<half,int32_t,CFG_ROW_MAJOR>(dst,c,q);CrossCoreSetFlag<2,PIPE_FIX>(readyFlag);SetFlag<HardEvent::FIX_M>(0);published=true;}__aicore__ inline void Finish(){if(published)WaitFlag<HardEvent::FIX_M>(0);DropPending();WaitFlag<HardEvent::MTE1_MTE2>(2);for(int i=0;i<2;++i){WaitFlag<HardEvent::MTE1_MTE2>(i);WaitFlag<HardEvent::M_MTE1>(i);}}};
class WideOwnerStageFusedEngine{Plan p;P01RootPrivateWideOwnerStageMatrixPipeline matrix;PrefetchActivationTile activation;GlobalTensor<half>exchange;GlobalTensor<float>gains;GlobalTensor<half>output;int sequence=0;bool pending=false;WorkTile heldTile;int heldPitch=0,heldCount=0;__aicore__ inline void CompletePending(){if(pending){activation.Repair(heldCount);Plan local=p;local.tn=heldPitch;StoreTile(output,activation.output,heldTile,local);activation.outputPending=true;pending=false;}}public:__aicore__ inline WideOwnerStageFusedEngine(GM_ADDR x,GM_ADDR weight,GM_ADDR scale,GM_ADDR y,GM_ADDR workspace,Plan plan,int core):p(plan),matrix(x,weight,plan),activation(8192,plan.tn){exchange.SetGlobalBuffer((__gm__ half*)workspace+(uint64_t)core*p.ring*p.tm*p.tn);gains.SetGlobalBuffer((__gm__ float*)scale);output.SetGlobalBuffer((__gm__ half*)y);}__aicore__ inline void PrimeFirst(int expert,int col,int cols){matrix.PrimeOwnerFirst(expert,col,cols);}__aicore__ inline void Process(WorkTile tile,WorkTile nextTile,bool hasNext){int slot=sequence%p.ring;if ASCEND_IS_AIC{matrix.ExecuteTile(tile.expert,tile.row,tile.col,tile.rows,tile.cols,nextTile,hasNext);if(sequence>=p.ring)CrossCoreWaitFlag<2>(2+slot);matrix.P01SendTileHalf(exchange[(uint64_t)slot*p.tm*p.tn],slot);}if ASCEND_IS_AIV{CrossCoreWaitFlag<2>(slot);int sub=p.vectors>1?GetSubBlockIdx():0;int rowOffset=0,columnOffset=0;if(p.splitN){int splitPitch=p.tn/p.vectors;columnOffset=sub*splitPitch;tile.col+=columnOffset;tile.cols=Min(splitPitch,tile.cols-columnOffset);}else{int rows=(tile.rows+p.vectors-1)/p.vectors;rowOffset=sub*rows;tile.row+=rowOffset;tile.rows=Min(rows,tile.rows-rowOffset);}if(tile.rows>0&&tile.cols>0){int pitch=RoundExtent(tile.cols,32);int rowCapacity=Min(255,8192/pitch);for(int first=0;first<tile.rows;first+=rowCapacity){WorkTile chunk=tile;chunk.row+=first;chunk.rows=Min(rowCapacity,tile.rows-first);int count=chunk.rows*pitch;uint64_t offset=(uint64_t)slot*p.tm*p.tn+(rowOffset+first)*p.tn+columnOffset;if(pending)AwaitPipe<HardEvent::S_MTE2>();if(pitch!=p.tn){DataCopyExtParams transfer{static_cast<uint16_t>(chunk.rows),static_cast<uint32_t>(pitch*2),static_cast<uint32_t>((p.tn-pitch)*2),0,0};DataCopyPadExtParams<half>padding{false,0,0,0};DataCopyPad(activation.accum.ReinterpretCast<half>(),exchange[offset],transfer,padding);}else{LoadLinear(activation.accum.ReinterpretCast<half>(),exchange[offset],count);}LoadLinear(activation.scales,gains[(uint64_t)chunk.expert*p.n+chunk.col],chunk.cols);if(first+chunk.rows==tile.rows)CrossCoreSetFlag<2,PIPE_MTE2>(2+slot);CompletePending();AwaitPipe<HardEvent::MTE2_V>();Cast(activation.z,activation.accum.ReinterpretCast<half>(),RoundMode::CAST_NONE,count);PipeBarrier<PIPE_V>();BinaryRepeatParams scaleRepeat{1,1,1,static_cast<uint8_t>(pitch/8),static_cast<uint8_t>(pitch/8),0};for(int column=0;column<chunk.cols;column+=64)Mul(activation.z[column],activation.z[column],activation.scales[column],static_cast<uint64_t>(Min(64,chunk.cols-column)),static_cast<uint8_t>(chunk.rows),scaleRepeat);PipeBarrier<PIPE_V>();activation.Prepare(count);heldTile=chunk;heldPitch=pitch;heldCount=count;pending=true;}}else{CrossCoreSetFlag<2,PIPE_MTE2>(2+slot);CompletePending();}}++sequence;}__aicore__ inline void Finish(){if ASCEND_IS_AIV{CompletePending();activation.DrainOutput();}if ASCEND_IS_AIC{for(int i=sequence>p.ring?sequence-p.ring:0;i<sequence;++i)CrossCoreWaitFlag<2>(2+i%p.ring);matrix.Finish();}PipeBarrier<PIPE_ALL>();}};
