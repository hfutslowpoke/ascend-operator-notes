bool inputPending=false,outputBusy=false;
for(uint32_t expert=0;expert<packet.groups;++expert){
uint32_t end=ends.GetValue(expert),lo=first>previous?first:previous,hi=Min(last,end);previous=end;
if(lo<hi){
if(inputPending){WaitFlag<HardEvent::V_MTE2>(0);inputPending=false;}
float right=(float)w.GetValue(expert),factor=scales.GetValue(expert);
for(uint32_t row=lo;row<hi;row+=capacity){
if(inputPending){WaitFlag<HardEvent::V_MTE2>(0);inputPending=false;}
uint32_t count=Min(capacity,hi-row);
DataCopyPad(input,x[row],DataCopyExtParams{1,count,0,0,0},DataCopyPadExtParams<int8_t>{false,0,0,0});Fence<HardEvent::MTE2_V>(0);
Cast(converted,input,RoundMode::CAST_NONE,count);PipeBarrier<PIPE_V>();Cast(z,converted,RoundMode::CAST_NONE,count);PipeBarrier<PIPE_V>();
Muls(z,z,right,count);PipeBarrier<PIPE_V>();Muls(z,z,factor,count);PipeBarrier<PIPE_V>();
SetMaskCount();SetVectorMask<float,MaskMode::COUNTER>(count);
Mul<float,false>(u,z,z,MASK_PLACEHOLDER,1,{1,1,1,8,8,8});PipeBarrier<PIPE_V>();
Muls<float,false>(u,u,-0.07135481387376785f,MASK_PLACEHOLDER,1,{1,1,8,8});PipeBarrier<PIPE_V>();
Adds<float,false>(u,u,-1.5957691669464111f,MASK_PLACEHOLDER,1,{1,1,8,8});PipeBarrier<PIPE_V>();
Mul<float,false>(u,u,z,MASK_PLACEHOLDER,1,{1,1,1,8,8,8});PipeBarrier<PIPE_V>();
Mins<float,false>(u,u,80.0f,MASK_PLACEHOLDER,1,{1,1,8,8});PipeBarrier<PIPE_V>();
Exp<float,false>(u,u,MASK_PLACEHOLDER,1,{1,1,8,8});PipeBarrier<PIPE_V>();
Adds<float,false>(u,u,1.0f,MASK_PLACEHOLDER,1,{1,1,8,8});PipeBarrier<PIPE_V>();
Div<float,false>(u,z,u,MASK_PLACEHOLDER,1,{1,1,1,8,8,8});PipeBarrier<PIPE_V>();SetMaskNorm();ResetMask();
if(outputBusy){Fence<HardEvent::MTE3_V>(0);outputBusy=false;}
Cast(output,u,RoundMode::CAST_RINT,count);Fence<HardEvent::V_MTE3>(0);
DataCopyPad(y[row],output,DataCopyExtParams{1,count*2,0,0,0});outputBusy=true;
SetFlag<HardEvent::V_MTE2>(0);inputPending=true;
}
}
if(previous>=last)break;
}
if(inputPending)WaitFlag<HardEvent::V_MTE2>(0);if(outputBusy)Fence<HardEvent::MTE3_V>(0);
}
__aicore__ inline void ReadDotPanel(const LocalTensor<int8_t>&dst,const GlobalTensor<int8_t>&source,uint32_t row,uint32_t rows,uint32_t depth,uint32_t pitch,uint32_t event){
uint32_t padded=Up(depth,32);
DataCopyPad(dst,source[(uint64_t)row*depth],DataCopyExtParams{(uint16_t)rows,depth,0,(pitch-padded)/32,0},DataCopyPadExtParams<int8_t>{true,0,(uint8_t)(padded-depth),0});
SetFlag<HardEvent::MTE2_V>(event);
}
__global__ __aicore__ void DotVectorKernel(GM_ADDR xs,GM_ADDR ws,GM_ADDR ss,GM_ADDR gs,GM_ADDR ys,SmallInvocation packet){
