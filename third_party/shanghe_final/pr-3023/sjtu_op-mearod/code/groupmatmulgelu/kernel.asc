inline int HostRound(int value,int grain){return(value+grain-1)/grain*grain;}
inline bool P09HostTailStageGeometry(const Plan&p,int&stripeOut,int&ckOut){if(p.tn<32||p.tn%32||p.tm<16||p.tm%16||p.k<1||p.n<1)return false;int fullK=HostRound(p.k,32);int first=HostRound((p.tn+1)/2,32);int bestStripe=0,bestCk=0,bestMmads=0,bestGroups=0;for(int stripe=first;stripe<=p.tn;stripe+=32){int ckA=(65536/(2*p.tm))/32*32;int ckB=(65536/(2*stripe))/32*32;int ck=HMin(fullK,HMin(ckA,ckB));if(ck<32||ck%32)continue;int chunks=(p.k+ck-1)/ck;int stripes=0,groups=0;for(int col=0;col<p.n;col+=p.tn){int nv=HMin(p.tn,p.n-col);for(int at=0;at<nv;at+=stripe){int width=HostRound(HMin(stripe,nv-at),32);++stripes;groups+=width/32;}}int mmads=stripes*chunks;int totalGroups=groups*chunks;if(bestStripe==0||mmads<bestMmads||(mmads==bestMmads&&totalGroups<bestGroups)||(mmads==bestMmads&&totalGroups==bestGroups&&ck>bestCk)){bestStripe=stripe;bestCk=ck;bestMmads=mmads;bestGroups=totalGroups;}}stripeOut=bestStripe;ckOut=bestCk;return bestStripe>0;}
inline P09LaunchGeometry P09HostLaunchGeometry(const Plan&p){if(!p.cacheA||p.cacheB!=1||p.reverseK||p.splitN||p.vectors!=2||p.tm<16||p.tm%16||p.tn<32||p.tn%32||p.n<=p.tn||p.k<1||p.n<1||p.n>65535||p.e<1||p.cores<1||p.cores>128||p.ring<1)return{0,0};int fullK=HostRound(p.k,32),fullN=HostRound(p.n,32);int stripe=0,workCK=0;if(!P09HostTailStageGeometry(p,stripe,workCK))return{0,0};if(static_cast<uint64_t>(p.tm+fullN)*fullK>496*1024)return{0,0};if(static_cast<uint64_t>(2)*p.tm*workCK>64*1024)return{0,0};if(static_cast<uint64_t>(2)*stripe*workCK>64*1024)return{0,0};if(static_cast<uint64_t>(p.tm)*p.tn*4>128*1024)return{0,0};return{static_cast<uint16_t>(stripe),static_cast<uint16_t>(workCK)};}
enum class Route{Scalar,Tiny,Compact,ShallowResident,PanelStriped,Interleaved,WideDouble,RowResident,ColumnResident,LongReduction,PersistentExpert,TailStrip,ShortGroupWave,TailPanel,WideTail};
inline int PowerFloor(int value){int result=1;while(result<=value/2)result*=2;return result;}
inline void Configure(Plan&p,Route route,int available){p.vectors=2;p.ring=route==Route::Compact?1:((route==Route::ShallowResident||route==Route::ColumnResident)?4:2);p.cacheA=route==Route::Interleaved||route==Route::WideDouble||route==Route::RowResident||route==Route::TailPanel;p.cacheB=route==Route::ShallowResident||route==Route::PanelStriped||route==Route::ColumnResident||route==Route::PersistentExpert;p.reverseK=route==Route::LongReduction;p.splitN=route==Route::WideTail;int rows=(p.m+p.e-1)/p.e;if(route==Route::Compact)rows=(rows+3)/4;if(route==Route::Interleaved||route==Route::ShortGroupWave)rows=(rows+1)/2;p.tm=HMin(64,PowerFloor(rows>16?rows:16));if(route==Route::TailStrip||route==Route::TailPanel)p.tm=HMin(128,PowerFloor(rows>16?rows:16));int columnLimit=route==Route::LongReduction||route==Route::TailStrip||route==Route::PersistentExpert?128:256;p.tn=HMin(columnLimit,PowerFloor(HostRound(p.n,32)));if(p.tn<32)p.tn=32;while(p.tm*p.tn>8192*p.vectors)p.tn/=2;p.ck=HMin(PowerFloor(HostRound(p.k,32)),32768/(p.tm>p.tn?p.tm:p.tn));int fullK=HostRound(p.k,32);while((p.cacheA?p.tm*fullK:2*p.tm*p.ck)+(p.cacheB?p.tn*fullK:2*p.tn*p.ck)>496*1024){if(p.tn>32)p.tn/=2;else if(p.tm>16)p.tm/=2;else{p.cacheA=0;p.cacheB=0;}p.ck=HMin(PowerFloor(fullK),32768/(p.tm>p.tn?p.tm:p.tn));}if(route==Route::ShortGroupWave&&static_cast<uint64_t>(p.tm+p.tn)*fullK<=496*1024){p.cacheA=1;p.cacheB=1;}if(route==Route::TailStrip&&static_cast<uint64_t>(p.cacheA?p.tm*fullK:2*p.tm*p.ck)+static_cast<uint64_t>(p.tn)*fullK<=496*1024)p.cacheB=1;if(route==Route::WideTail&&static_cast<uint64_t>(p.tm)*(p.cacheA?fullK:2*p.ck)+static_cast<uint64_t>(p.tn)*fullK<=496*1024){p.cacheB=1;}if(route==Route::TailPanel){while(static_cast<uint64_t>(p.tm+2*p.tn)*fullK>496*1024){if(p.tn>32)p.tn/=2;else if(p.tm>16)p.tm/=2;else break;}if(static_cast<uint64_t>(p.tm+2*p.tn)*fullK<=496*1024){p.cacheA=1;p.cacheB=2;}p.ck=HMin(PowerFloor(fullK),32768/(p.tm>p.tn?p.tm:p.tn));}if(route==Route::Interleaved){int expertRows=(p.m+p.e-1)/p.e;p.tm=HMin(128,PowerFloor(expertRows>16?expertRows:16));p.tn=HMin(512,PowerFloor(HostRound(p.n,32)));if(p.tn<32)p.tn=32;while(p.tm*p.tn>32768)p.tn/=2;p.ck=HMin(PowerFloor(fullK),32768/(p.tm>p.tn?p.tm:p.tn));while(static_cast<uint64_t>(p.tm)*fullK+static_cast<uint64_t>(2)*p.tn*p.ck>496*1024){if(p.tn>32)p.tn/=2;else if(p.tm>16)p.tm/=2;else{p.cacheA=0;break;}p.ck=HMin(PowerFloor(fullK),32768/(p.tm>p.tn?p.tm:p.tn));}}if(route==Route::ColumnResident){int expertRows=(p.m+p.e-1)/p.e;p.tm=HMin(128,PowerFloor(expertRows>16?expertRows:16));p.tn=HMin(256,PowerFloor(HostRound(p.n,32)));if(p.tn<32)p.tn=32;p.cacheA=1;p.cacheB=0;p.ck=HMin(PowerFloor(fullK),32768/(p.tm>p.tn?p.tm:p.tn));while(static_cast<uint64_t>(p.tm)*fullK+static_cast<uint64_t>(2)*p.tn*p.ck>496*1024){if(p.tm>16)p.tm/=2;else{p.cacheA=0;break;}p.ck=HMin(PowerFloor(fullK),32768/(p.tm>p.tn?p.tm:p.tn));}}if(route==Route::PersistentExpert){int expertRows=(p.m+p.e-1)/p.e;p.tm=HMin(128,PowerFloor(expertRows>16?expertRows:16));p.tn=HMin(256,PowerFloor(HostRound(p.n,32)));if(p.tn<32)p.tn=32;p.cacheA=1;p.cacheB=1;while(static_cast<uint64_t>(p.tm+p.tn)*fullK>496*1024){if(p.tn>32)p.tn/=2;else if(p.tm>16)p.tm/=2;else{p.cacheA=0;p.cacheB=0;break;}}p.ck=HMin(PowerFloor(fullK),PowerFloor(32768/(p.tm>p.tn?p.tm:p.tn)));}if(route==Route::ShortGroupWave){int expertRows=(p.m+p.e-1)/p.e;p.tm=HMin(2*8192/32,HostRound(expertRows,16));while(p.tm>16&&static_cast<uint64_t>(p.tm+32)*fullK>496*1024)p.tm-=16;int residentColumns=(496*1024/fullK-p.tm)/32*32;int accumulatorColumns=(32768/p.tm)/32*32;p.tn=HMin(256,HMin(residentColumns,accumulatorColumns));p.tn=HMin(p.tn,HostRound(p.n,32));if(p.tn<32)p.tn=32;int side=p.tm>p.tn?p.tm:p.tn;p.ck=HMin(fullK,(32768/side)/32*32);if(p.ck<32)p.ck=32;p.cacheA=1;p.cacheB=1;}if(route==Route::LongReduction){int panels=available/p.e;if(panels<1)panels=1;else if(panels>1)--panels;p.tn=HMin(256,HostRound((p.n+panels-1)/panels,32));if(p.tn<32)p.tn=32;int expertRows=(p.m+p.e-1)/p.e;int rowLimit=(32768/p.tn)/16*16;p.tm=HMin(HostRound(expertRows,16),rowLimit);if(p.tm<16)p.tm=16;int longSide=p.tm>p.tn?p.tm:p.tn;p.ck=HMin(fullK,(32768/longSide)/32*32);if(p.ck<32)p.ck=32;}if(route==Route::TailStrip){int width=HMin(256,HostRound(p.n,32));width=HMin(width,(32768/p.tm)/32*32);int extent=p.tm>width?p.tm:width;int reduction=HMin(PowerFloor(fullK),PowerFloor(32768/extent));uint64_t left=static_cast<uint64_t>(p.tm)*(p.cacheA?fullK:2*reduction);uint64_t right=static_cast<uint64_t>(width)*(p.cacheB?fullK:2*reduction);int panels=p.e*((p.n+width-1)/width);if(width>p.tn&&static_cast<uint64_t>(p.m)>=static_cast<uint64_t>(p.e)*p.tm*2&&panels>=available&&left+right<=496*1024){p.tn=width;p.ck=reduction;}}int jobs=((p.m+p.tm-1)/p.tm+p.e-1)*((p.n+p.tn-1)/p.tn);if(route==Route::TailPanel)jobs=p.e*(((p.n+p.tn-1)/p.tn+1)/2);if(route==Route::ShallowResident)jobs=HMin(p.m,(p.m+p.tm-1)/p.tm+p.e-1);p.cores=HMin(available,jobs);}
inline void P04ConfigureShallowFullK(Plan&p){int fullK=HostRound(p.k,32);if(p.cacheA!=0||p.cacheB!=1||p.reverseK||p.splitN)return;if(p.tm<16||p.tm%16||p.tn<32||p.tn%32)return;if(static_cast<uint64_t>(p.tm)*fullK>64*1024||static_cast<uint64_t>(p.tn)*fullK>64*1024||static_cast<uint64_t>(p.tm)*p.tn*4>128*1024)return;p.ck=fullK;}
inline void ConfigureWideOwnerStage(Plan&p){Plan q=p;int fullK=HostRound(q.k,32);q.tn=HMin(512,PowerFloor(HostRound(q.n,32)));if(q.tn<32)q.tn=32;while(q.tm*q.tn>32768)q.tn/=2;int side=q.tm>q.tn?q.tm:q.tn;q.ck=HMin(PowerFloor(fullK),PowerFloor(32768/side));int stageK=HMin(fullK,3*q.ck);uint64_t l1=static_cast<uint64_t>(q.tm)*fullK+static_cast<uint64_t>(3)*q.tn*stageK;uint64_t l0a=static_cast<uint64_t>(2)*q.tm*q.ck;uint64_t l0b=static_cast<uint64_t>(2)*q.tn*q.ck;uint64_t l0c=static_cast<uint64_t>(q.tm)*q.tn*sizeof(int32_t);uint64_t ub=static_cast<uint64_t>(8192)*22+static_cast<uint64_t>(HostRound(q.tn,8))*4+1024;if(q.cacheA&&!q.cacheB&&!q.splitN&&q.ck>=32&&q.ck%32==0&&stageK>0&&fullK<=16384&&l1<=496*1024&&l0a<=64*1024&&l0b<=64*1024&&l0c<=128*1024&&ub<=192*1024-256-8192){q.cacheA=3;p=q;int rowOwners=(p.m+p.tm-1)/p.tm;if(rowOwners>0&&rowOwners<p.cores)p.cores=rowOwners;if(p.tn%(2*32)==0&&p.n%p.tn==0)p.splitN=1;}}
inline void P01ConfigureWideOwnerPanels(Plan&p,int available){if(p.cacheA!=3||p.vectors!=2||p.ring!=2||p.reverseK||p.splitN)return;if(p.tm<16||p.tm%16!=0||p.k<1||p.n<128||available<=0)return;int fullK=HostRound(p.k,32);int panelWidth=128;int panels=(p.n+panelWidth-1)/panelWidth;int rowOwners=(p.m+p.tm-1)/p.tm;int jobs=rowOwners*panels;if(panels<2||rowOwners<1||available<=rowOwners||jobs<available)return;int side=p.tm>panelWidth?p.tm:panelWidth;int ck=HMin(PowerFloor(fullK),PowerFloor(32768/side));int stageK=HMin(fullK,3*ck);int capacity=HostRound(((p.tm+p.vectors-1)/p.vectors)*panelWidth,512);uint64_t l1=static_cast<uint64_t>(p.tm)*fullK+static_cast<uint64_t>(3)*panelWidth*stageK;uint64_t l0a=static_cast<uint64_t>(2)*p.tm*ck;uint64_t l0b=static_cast<uint64_t>(2)*panelWidth*ck;uint64_t l0c=static_cast<uint64_t>(p.tm)*panelWidth*sizeof(int32_t);uint64_t ub=static_cast<uint64_t>(capacity)*10+static_cast<uint64_t>(3)*HostRound(capacity/8,256)+static_cast<uint64_t>(HostRound(panelWidth,8))*4+32;if(ck<32||ck%32!=0||stageK<=0||fullK>16384||l1>496*1024||l0a>64*1024||l0b>64*1024||l0c>128*1024||ub>192*1024-256-8192)return;p.tn=panelWidth;p.ck=ck;p.splitN=0;p.cores=available;p.cacheA=4;}
inline void ConfigureProgressiveRowSquad(Plan&p){int fullK=HostRound(p.k,32);int capacity=HostRound(((p.tm+p.vectors-1)/p.vectors)*p.tn,64);int scaleCapacity=HostRound(p.tn,8);uint64_t l1=(static_cast<uint64_t>(2)*p.tm+p.tn)*fullK;uint64_t l0a=static_cast<uint64_t>(2)*p.tm*p.ck;uint64_t l0b=static_cast<uint64_t>(2)*p.tn*p.ck;uint64_t l0c=static_cast<uint64_t>(p.tm)*p.tn*sizeof(int32_t);uint64_t ub=static_cast<uint64_t>(capacity)*22+static_cast<uint64_t>(scaleCapacity)*4+HostRound(capacity/8,32);if(!p.splitN&&p.ck>=32&&p.ck%32==0&&fullK<=16384&&capacity<=8192&&l1<=496*1024&&l0a<=64*1024&&l0b<=64*1024&&l0c<=64*1024&&ub<=192*1024-256-8192){p.cacheA=2;p.cacheB=1;int owners=HMin(p.e,p.cores);p.cores=owners*(p.cores/owners);}}
inline void ConfigureWholeExpertWideTail(Plan&p){int fullK=HostRound(p.k,32);int capacity=(496*1024/fullK-p.tn)/16*16;int average=(p.m+p.e-1)/p.e;Plan trial=p;trial.tm=HMin(128,HostRound(average,16));if(trial.tm<p.tm)trial.tm=p.tm;int maximum=trial.tm>trial.tn?trial.tm:trial.tn;trial.ck=HMin(PowerFloor(fullK),32768/maximum);uint64_t l0a=static_cast<uint64_t>(2)*trial.tm*trial.ck;uint64_t l0b=static_cast<uint64_t>(2)*trial.tn*trial.ck;uint64_t l0c=static_cast<uint64_t>(trial.tm)*trial.tn*4;uint64_t l1=static_cast<uint64_t>(capacity+trial.tn)*fullK;uint64_t ub=static_cast<uint64_t>(8192)*22+static_cast<uint64_t>(HostRound(trial.tn,8))*4+1024;if(capacity>=trial.tm&&trial.tm%16==0&&trial.ck>=32&&trial.ck%32==0&&l1<=496*1024&&l0a<=64*1024&&l0b<=64*1024&&l0c<=128*1024&&ub<=192*1024-256-8192){trial.cacheA=capacity;trial.cacheB=1;trial.splitN=0;p=trial;}p.tm=64;p.tn=HMin(384,HostRound(p.n,32));if(p.tn<32)p.tn=32;}
struct WideSuffixCost{uint64_t padded;int packets;};
inline WideSuffixCost EstimateWideSuffixCost(int rows,int width,const Plan&p){WideSuffixCost cost{0,0};int full=width/p.tn,rest=width%p.tn;int fullCapacity=HMin(255,8192/p.tn);int tailPitch=HostRound(rest,32);for(int first=0;first<rows;first+=p.tm){int avRows=(HMin(p.tm,rows-first)+p.vectors-1)/p.vectors;cost.padded+=static_cast<uint64_t>(avRows)*(static_cast<uint64_t>(full)*p.tn+tailPitch);cost.packets+=full*((avRows+fullCapacity-1)/fullCapacity);if(rest>0){int capacity=HMin(255,8192/tailPitch);cost.packets+=(avRows+capacity-1)/capacity;}}return cost;}
inline int P15SelectWideSuffixCut(const Plan&p){if(p.cacheA<=1||p.splitN||p.e<1||p.cores<=p.e||p.tn<32)return 0;int spare=p.cores-p.e;int fanout=(p.e+spare-1)/spare;int rows=(p.m+p.e-1)/p.e;uint64_t ideal=static_cast<uint64_t>(fanout)*(rows+p.n)-rows;ideal/=(fanout+1);int low=static_cast<int>(ideal/32)*32;WideSuffixCost baseline=EstimateWideSuffixCost(rows,p.n,p);uint64_t bestPadded=baseline.padded;uint64_t bestOwner=~static_cast<uint64_t>(0);int bestPackets=baseline.packets,selected=0;for(int side=-1;side<2;++side){int cut=low+side*32;int suffix=p.n-cut;if(cut<32||suffix<1)continue;int pitch=HostRound(suffix,32);if(pitch>p.tn)continue;Plan local=p;local.tn=pitch;uint64_t l1=static_cast<uint64_t>(p.cacheA+pitch)*HostRound(p.k,32);uint64_t l0a=static_cast<uint64_t>(2)*p.tm*p.ck;uint64_t l0b=static_cast<uint64_t>(2)*pitch*p.ck;uint64_t l0c=static_cast<uint64_t>(p.tm)*pitch*4;uint64_t ub=static_cast<uint64_t>(8192)*22+static_cast<uint64_t>(HostRound(pitch,8))*4+1024;if(l1>496*1024||l0a>64*1024||l0b>64*1024||l0c>128*1024||ub>192*1024-256-8192)continue;WideSuffixCost main=EstimateWideSuffixCost(rows,cut,p);WideSuffixCost extra=EstimateWideSuffixCost(rows,suffix,local);extra.padded*=fanout;extra.packets*=fanout;uint64_t padded=main.padded>extra.padded?main.padded:extra.padded;int packets=main.packets>extra.packets?main.packets:extra.packets;if(packets>baseline.packets||padded>=baseline.padded)continue;uint64_t owner=static_cast<uint64_t>(rows)+cut;uint64_t helperOwner=static_cast<uint64_t>(fanout)*(static_cast<uint64_t>(rows)+suffix);if(helperOwner>owner)owner=helperOwner;if(owner<bestOwner||(owner==bestOwner&&(padded<bestPadded||(padded==bestPadded&&packets<bestPackets)))){bestOwner=owner;bestPadded=padded;bestPackets=packets;selected=cut;}}return selected;}
inline int HostTailStripStripePowerFloor(int value){int result=1;while(result<=value/2)result*=2;return result;}
inline int HostTailStripStripeReduction(Plan p){if(p.tm<1||p.tn<1)return 0;int stripe=HostRound((p.tn+1)/2,32);int side=p.tm>stripe?p.tm:stripe;return HMin(HostTailStripStripePowerFloor(HostRound(p.k,32)),HostTailStripStripePowerFloor(32768/side));}
inline bool HostTailStripStripeFits(Plan p){if(!p.cacheA||p.cacheB!=1||p.reverseK||p.splitN||p.vectors!=2||p.tm<16||p.tm>128||p.tm%16||p.tn<64||p.tn>256||p.tn%32||p.k<1||p.n<1||p.n>65535||p.cores<1)return false;int fullK=HostRound(p.k,32);int stripe=HostRound((p.tn+1)/2,32);int side=p.tm>p.tn?p.tm:p.tn;int stockCK=HMin(HostTailStripStripePowerFloor(fullK),HostTailStripStripePowerFloor(32768/side));int boostCK=HostTailStripStripeReduction(p);uint64_t l1=static_cast<uint64_t>(p.tm+p.tn)*fullK;uint64_t a0=static_cast<uint64_t>(2)*p.tm*boostCK;uint64_t b0=static_cast<uint64_t>(2)*stripe*boostCK;uint64_t c0=static_cast<uint64_t>(p.tm)*p.tn*4;uint64_t jobs=static_cast<uint64_t>(p.e)*((p.n+p.tn-1)/p.tn);return boostCK>stockCK&&p.ck==boostCK&&fullK<=16384&&p.ck>=32&&p.ck%32==0&&p.ck/32<=255&&jobs>=p.cores&&l1<=496*1024&&a0<=64*1024&&b0<=64*1024&&c0<=128*1024;}
inline void ConfigureTailStripStripe(Plan&p){Plan trial=p;trial.cacheA=1;trial.ck=HostTailStripStripeReduction(trial);if(HostTailStripStripeFits(trial))p=trial;}
inline bool P06CompactSingleFlightEligible(const Plan&p){if(p.e!=1||p.m<1||p.k<1||p.n<1||p.cores<1||p.vectors<1)return false;if(p.ring!=1||p.splitN!=0||p.cacheA!=0||p.cacheB!=0||p.reverseK!=0)return false;if(p.k>p.ck||p.tm<1||p.tn<1)return false;if(p.vectors!=2||p.k%32!=0||p.tm%16!=0||p.tn%128!=0||p.tm%p.vectors!=0)return false;if(p.n!=p.tn)return false;int rows=(p.m+p.tm-1)/p.tm;int columns=(p.n+p.tn-1)/p.tn;return rows>0&&columns>0&&rows*columns==p.cores&&p.m>=rows*p.tm;}
inline bool P06NarrowCompact(Plan&p){if(p.cores<4||p.cores%2!=0)return false;int lanes=p.cores>>1;if(p.m%lanes!=0)return false;int rows=p.m/lanes;if(rows<16||rows>64||rows%16!=0)return false;Plan q=p;q.cores=lanes;q.tm=rows;if(!P06CompactSingleFlightEligible(q))return false;p=q;return true;}
inline P02PackedLaunch P02PackLaunch(const Plan&p){uint32_t g=static_cast<uint32_t>(p.cores)|(static_cast<uint32_t>(p.tm)<<8)|((static_cast<uint32_t>(p.tn)>>5)<<16)|(static_cast<uint32_t>(p.cacheA)<<20)|(static_cast<uint32_t>(p.cacheB)<<22);return{static_cast<uint32_t>(p.m),static_cast<uint16_t>(p.k),static_cast<uint16_t>(p.n),static_cast<uint16_t>(p.e),static_cast<uint16_t>(p.ck),g};}
inline RuntimePackedPlan PackRuntimePlan(const Plan&p){uint32_t g=static_cast<uint32_t>(p.cores)|(static_cast<uint32_t>(p.tm)<<6)|((static_cast<uint32_t>(p.tn)>>5)<<14)|(static_cast<uint32_t>(p.cacheA)<<20)|(static_cast<uint32_t>(p.cacheB)<<23)|(static_cast<uint32_t>(p.reverseK)<<25)|(static_cast<uint32_t>(p.splitN)<<26)|(static_cast<uint32_t>(p.ring)<<27)|(static_cast<uint32_t>(p.vectors)<<30);return{static_cast<uint32_t>(p.m),static_cast<uint16_t>(p.k),static_cast<uint16_t>(p.n),static_cast<uint16_t>(p.e),static_cast<uint16_t>(p.ck),g};}
inline RuntimePackedPlan PackP04RuntimePlan(const Plan&p){RuntimePackedPlan q=PackRuntimePlan(p);if(p.e>0&&p.m%p.e==0)q.m|=0x80000000u;return q;}
inline BoundedRuntimePacket EncodeBoundedPacket(const Plan&p,uint32_t extra){uint64_t lo=static_cast<uint64_t>(p.m)|(static_cast<uint64_t>(p.k)<<17)|(static_cast<uint64_t>(p.n)<<31)|(static_cast<uint64_t>(p.e)<<44)|(static_cast<uint64_t>(p.cores)<<52)|(static_cast<uint64_t>(p.ring)<<58)|(static_cast<uint64_t>(p.vectors)<<61)|(static_cast<uint64_t>(p.reverseK)<<63);uint64_t hi=static_cast<uint64_t>(p.tm)|((static_cast<uint64_t>(p.tn)>>5)<<11)|((static_cast<uint64_t>(p.ck)>>5)<<19)|(static_cast<uint64_t>(p.cacheA)<<28)|(static_cast<uint64_t>(p.cacheB)<<42)|(static_cast<uint64_t>(p.splitN)<<50)|(static_cast<uint64_t>(extra)<<51);return{lo,hi};}
}
inline bool TryResidentOwnerKernels(GM_ADDR x,GM_ADDR w,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,independent_gmg::ExecutionShape info,int available,aclrtStream stream){
using namespace expert_activation;Plan p{};p.m=info.rows;p.k=info.depth;p.n=info.cols;p.e=info.experts;
if(info.route==independent_gmg::Tiny && p.m<=4 && p.k<=8 && p.n<=8 && p.e<=8 && ((reinterpret_cast<uint64_t>(groups)&63u)+(uint64_t)p.e*8<=64)){
P03PairLaunch packet{p.m,p.k,p.n,p.e,1u};TinyBroadcastKernel<<<1,nullptr,stream>>>(x,w,scale,groups,y,packet);return true;
}
Route route;
bool largePacked=info.route==independent_gmg::LongReduction && p.m>=1024 && p.n>=512 && p.k%64==0;
if(!largePacked && !independent_gmg::ResidentEnvelope(info,available))return false;
if(info.route==independent_gmg::Compact){route=Route::Compact;Configure(p,route,available);if(!P06CompactSingleFlightEligible(p))return false;P06NarrowCompact(p);}
else if(info.route==independent_gmg::WideDouble){route=Route::WideDouble;Configure(p,route,available);ConfigureWideOwnerStage(p);P01ConfigureWideOwnerPanels(p,available);}
else if(info.route==independent_gmg::TailStrip){route=Route::TailStrip;Configure(p,route,available);ConfigureTailStripStripe(p);}
else if(info.route==independent_gmg::WideTail){route=Route::LongReduction;Configure(p,route,available);}
else if(info.route==independent_gmg::ShallowResident){route=Route::ShallowResident;Configure(p,route,available);P04ConfigureShallowFullK(p);if(p.tn<p.n&&p.vectors==2&&p.tn>=64&&p.tn%64==0&&p.n%p.tn==0)p.splitN=1;}
else if(info.route==independent_gmg::RowResident){route=Route::RowResident;Configure(p,route,available);ConfigureProgressiveRowSquad(p);}
else if(largePacked){route=Route::LongReduction;Configure(p,route,available);}
else return false;
void *workspace=nullptr;uint64_t bytes=(uint64_t)p.cores*p.ring*p.tm*p.tn*4;if(route==Route::RowResident)bytes+=(uint64_t)p.m*p.n*4;if(route==Route::LongReduction){uint64_t fullK=HostRound(p.k,64),a=fullK*HostRound(p.m,64);if(((p.n+p.tn-1)/p.tn)>=2 && a<=512ULL*1024*1024)bytes+=a;bytes+=(uint64_t)p.e*fullK*HostRound(p.n,32);if(bytes>512ULL*1024*1024)return false;}if(aclrtMalloc(&workspace,bytes,ACL_MEM_MALLOC_HUGE_FIRST)!=ACL_SUCCESS)return false;
if(route==Route::Compact){RuntimePackedPlan packet=PackRuntimePlan(p);CompactCubeKernel<<<p.cores,nullptr,stream>>>(packet,x,w,scale,groups,y,(GM_ADDR)workspace);}
else if(route==Route::WideDouble){RuntimePackedPlan packet=PackRuntimePlan(p);WideDoubleVectorKernel<<<p.cores,nullptr,stream>>>(packet,x,w,scale,groups,y,(GM_ADDR)workspace);}
else if(route==Route::TailStrip){P09LaunchGeometry layout=P09HostLaunchGeometry(p);BoundedRuntimePacket packet=EncodeBoundedPacket(p,(uint32_t)(layout.stripe/32)|((uint32_t)(layout.ck/32)<<4));TailStripKernel<<<p.cores,nullptr,stream>>>(packet,x,w,scale,groups,y,(GM_ADDR)workspace);}
else if(route==Route::ShallowResident){RuntimePackedPlan packet=PackP04RuntimePlan(p);ShallowExpertResidentKernel<<<p.cores,nullptr,stream>>>(packet,x,w,scale,groups,y,(GM_ADDR)workspace);}
else if(route==Route::RowResident){RowResidentKernel<<<p.cores,nullptr,stream>>>(P02PackLaunch(p),x,w,scale,groups,y,(GM_ADDR)workspace);}
else if(route==Route::LongReduction){BoundedRuntimePacket packet=EncodeBoundedPacket(p,0u);LongReductionKernel<<<p.cores,nullptr,stream>>>(packet,x,w,scale,groups,y,(GM_ADDR)workspace);}
else{BoundedRuntimePacket packet=EncodeBoundedPacket(p,(uint32_t)(P15SelectWideSuffixCut(p)/32));WideTailKernel<<<p.cores,nullptr,stream>>>(packet,x,w,scale,groups,y,(GM_ADDR)workspace);}
aclrtSynchronizeStream(stream);aclrtFree(workspace);return true;
}
inline bool ScalarInputLineFits(GM_ADDR address,uint64_t bytes){return (reinterpret_cast<uint64_t>(address)&63u)+bytes<=64u;}

inline void run_kernel(GM_ADDR x,const TensorGroupInfo &xi,
GM_ADDR w,const TensorGroupInfo &wi,
GM_ADDR scale,const TensorGroupInfo &si,
GM_ADDR group,const TensorGroupInfo &gi,
GM_ADDR y,const TensorGroupInfo &yi,
int64_t availableCoreNum,aclrtStream stream) {
using namespace independent_gmg;
if(xi.numTensors!=1 || wi.numTensors!=1 || si.numTensors!=1 || gi.numTensors!=1 || yi.numTensors!=1)
return;
const auto &a=xi.tensors[0], &b=wi.tensors[0], &s=si.tensors[0], &g=gi.tensors[0], &o=yi.tensors[0];
if(a.numDims!=2 || b.numDims!=3 || s.numDims!=2 || g.numDims!=1 || o.numDims!=2 ||
a.dtype!=3 || b.dtype!=3 || s.dtype!=0 || g.dtype!=6 || o.dtype!=1)
return;
int64_t m=a.shape[0], k=a.shape[1], e=b.shape[0], n=b.shape[2];
if(m<1 || m>65536 || k<1 || k>8192 || e<1 || e>128 || n<1 || n>4096 ||
b.shape[1]!=k || s.shape[0]!=e || s.shape[1]!=n || g.shape[0]!=e || o.shape[0]!=m || o.shape[1]!=n || availableCoreNum<1)
return;
ExecutionShape p=MakePlan(e,m,k,n,availableCoreNum);
if(p.depth>=4096 && p.cols>=1024 && (uint64_t)p.rows>=1024ull*p.experts){
p.tm=160;p.tn=192;p.ck=128;p.resident=3;p.route=LongReduction;
uint64_t bytes=(uint64_t)p.cores*p.ring*p.tm*p.tn*4+(uint64_t)((p.depth+31)/32*32)*((uint64_t)p.experts*((p.cols+31)/32*32));
if(bytes<=512ull*1024*1024){void *workspace=nullptr;if(aclrtMalloc(&workspace,bytes,ACL_MEM_MALLOC_HUGE_FIRST)!=ACL_SUCCESS)return;
LaunchDescriptor packet=EncodeLaunchDescriptor(p);PackedLargeKernel<LongReduction><<<p.cores,nullptr,stream>>>(packet,x,w,scale,group,y,(GM_ADDR)workspace);aclrtSynchronizeStream(stream);aclrtFree(workspace);return;}
}
if(TryResidentOwnerKernels(x,w,scale,group,y,p,availableCoreNum,stream))return;
if(!ResidentEnvelope(p,availableCoreNum)){
RunStreaming(x,w,scale,group,y,MakeStreamingPlan(e,m,k,n,availableCoreNum),stream);return;
}
if(p.route==WideTail){
uint32_t rowLimit=(32768/p.tn)/16*16;
if(rowLimit>p.tm && rowLimit<=128)p.tm=rowLimit;
}
if(p.route==TailStrip){p.ck=256;p.tailStripe=128;}
if(p.route==Scalar && ScalarInputLineFits(group,e*8) && ScalarInputLineFits(x,m*k) && ScalarInputLineFits(w,e*k*n) && ScalarInputLineFits(scale,e*n*4))p.rowMapValid=p.experts;
if(p.route==Tiny && p.rows<=4 && p.depth<=8 && p.cols<=8 && p.experts<=8 && ((reinterpret_cast<uint64_t>(group)&63u)+p.experts*8<=64))p.rowMapValid=1;
if(p.route==Scalar || p.route==Tiny) {
SmallInvocation small{p.rows,static_cast<uint16_t>(p.depth),static_cast<uint16_t>(p.cols),p.experts,static_cast<uint16_t>(p.cores),static_cast<uint16_t>(p.rowMapValid)};
if(p.route==Scalar)TinyKernel<Scalar><<<p.cores,nullptr,stream>>>(x,w,scale,group,y,small);
else TinyKernel<Tiny><<<1,nullptr,stream>>>(x,w,scale,group,y,small);
return;
}
void *workspace=nullptr;
size_t bytes=(uint64_t)p.cores*p.ring*p.tm*p.tn*(p.route==PanelStriped?2:4);
if(p.route==ColumnResident)bytes+=(uint64_t)m*p.tn*4;
if(p.route==LongReduction)bytes+=(uint64_t)((k+31)/32*32)*(((m+63)/64*64)+e*((n+31)/32*32));
if(aclrtMalloc(&workspace,bytes,ACL_MEM_MALLOC_HUGE_FIRST)!=ACL_SUCCESS)
return;
LaunchDescriptor packet=EncodeLaunchDescriptor(p);
#define GMG_LAUNCH(mode) case mode: FusedKernel<mode><<<p.cores,nullptr,stream>>>(packet,x,w,scale,group,y,(GM_ADDR)workspace); break
switch(p.route) {
GMG_LAUNCH(Compact);GMG_LAUNCH(LongReduction);GMG_LAUNCH(TailStrip);GMG_LAUNCH(PersistentExpert);
GMG_LAUNCH(ShortGroupWave);GMG_LAUNCH(WideTail);GMG_LAUNCH(TailPanel);GMG_LAUNCH(ShallowResident);
GMG_LAUNCH(PanelStriped);GMG_LAUNCH(WideDouble);GMG_LAUNCH(Interleaved);GMG_LAUNCH(ColumnResident);GMG_LAUNCH(RowResident);
}
#undef GMG_LAUNCH
auto status=aclrtSynchronizeStream(stream);
aclrtFree(workspace);
if(status!=ACL_SUCCESS) return;
}
