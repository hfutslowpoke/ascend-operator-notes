class StreamingTileCursor {
ExecutionShape p;GlobalTensor<int64_t> ends;uint32_t ordinal,expert=0,begin=0,columns,panel=0,shards=1;
public:
__aicore__ inline StreamingTileCursor(ExecutionShape shape,GM_ADDR groups,uint32_t core):p(shape),ordinal(core){
ends.SetGlobalBuffer((__gm__ int64_t*)groups);columns=(p.cols+p.tn-1)/p.tn;
DataCacheCleanAndInvalid<int64_t,CacheLine::ENTIRE_DATA_CACHE,DcciDst::CACHELINE_OUT>(ends);
if(p.resident==1){uint32_t previous=0,total=0;for(uint32_t e=0;e<p.experts;++e){uint32_t end=ends.GetValue(e);total+=(end-previous+p.tm-1)/p.tm;previous=end;}
uint64_t left=(uint64_t)p.tm*Up(p.depth,32),right=(uint64_t)p.tn*p.depth+(uint64_t)p.tm*p.tn*4;
uint64_t best=((total+p.cores-1)/p.cores)*(left+columns*right);
for(uint32_t pieces=2;pieces<=columns;pieces*=2){uint64_t cost=((uint64_t)total*pieces+p.cores-1)/p.cores*(left+((columns+pieces-1)/pieces)*right);if(cost<best){best=cost;shards=pieces;}}
}
}
__aicore__ inline bool Next(WorkChunk &t){
while(expert<p.experts){
uint32_t end=ends.GetValue(expert),waves=(end-begin+p.tm-1)/p.tm,jobs=waves*columns;
