__aicore__ inline bool P02WideRowEligible(P02GroupBounds&bounds,const Plan&p){if(p.vectors!=2||p.cacheA!=2||p.cacheB!=1||p.e<1||p.e>p.cores||p.k<128||p.n<256)return false;if(static_cast<uint64_t>(p.k)*16384ULL>65504ULL*512ULL)return false;int first=0,maxRows=0;for(int expert=0;expert<p.e;++expert){int end=bounds.End(expert);int rows=end-first;if(rows>maxRows)maxRows=rows;first=end;}if(maxRows<128)return false;int fullK=RoundExtent(p.k,32);int stageK=Min(fullK,3*128);uint64_t l1=(uint64_t)128*fullK+(uint64_t)2*256*stageK+(uint64_t)256*stageK;uint64_t l0a=(uint64_t)2*128*128;uint64_t l0b=(uint64_t)2*256*128;uint64_t l0c=(uint64_t)128*256*4;int capacity=Min(8192,RoundExtent(128*256,512));int stride=RoundExtent(capacity*10+3*RoundExtent(capacity/8,256)+RoundExtent(256,8)*4+32,256);uint64_t workspaceNeeded=(uint64_t)p.cores*p.ring*128*256;uint64_t hostWorkspace=(uint64_t)p.cores*p.ring*p.tm*p.tn+(uint64_t)p.m*p.n;return l1<=496*1024&&l0a<=64*1024&&l0b<=64*1024&&l0c<=128*1024&&workspaceNeeded<=hostWorkspace&&(uint64_t)2*stride<=192*1024-256-8192;}
