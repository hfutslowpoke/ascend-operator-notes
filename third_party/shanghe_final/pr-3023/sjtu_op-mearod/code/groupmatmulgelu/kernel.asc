if constexpr(Mode==Streamed){if(p.tm*p.ck>32768 && p.tn*p.ck>32768)budget=65536;}
uint32_t stripe=Mode==TailStrip && p.tailStripe?Min(na,p.tailStripe):Min(na,(budget/p.ck)/32*32);
if(Mode==ShortGroupWave && na*p.ck>budget)stripe=Up((na+2)/3,32);

if(!keepA)for(uint32_t i=0;i<Min(chunks,2);++i){uint32_t pos=KAt(i,chunks,firstK);ReadA(t,pos,Min(p.ck,lastK-pos),i,ma);}
if(fillB)for(uint32_t i=0;i<Min(chunks,2);++i){if((!i && useScratch) || i<panelPrefixChunks)continue;uint32_t pos=KAt(i,chunks,firstK);FillResidentB(t,pos,Min(p.ck,lastK-pos),i);}
uint32_t bStages=(chunks+bFactor-1)/bFactor;
bool usePending=pendingB && pendingTile.expert==t.expert && pendingTile.col==t.col && pendingTile.cols==t.cols;
bool coldHead=!usePending && bFactor>1 && chunks>bFactor;
if(pendingB && !usePending)WaitFlag<HardEvent::MTE2_MTE1>(2+bSlots);
pendingB=false;
if(!keepB)for(uint32_t i=0;i<Min(bStages,bSlots);++i) {
if(usePending && (panelPack || i==0))continue;
uint32_t pos=KAt(i*bFactor,chunks,firstK);
ReadB(t,pos,Min(p.ck*bFactor,lastK-pos),i,coldHead && !i);
}
