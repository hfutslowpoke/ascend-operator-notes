activation.Consume(tile,exchange,((uint64_t)core*p.ring+slot)*p.tm*p.tn,GetBlockIdx()%2,0,0,p.ring+slot);++sequence;
}
activation.Drain();
}
}
inline ExecutionShape MakeStreamingPlan(uint32_t e,uint32_t m,uint32_t k,uint32_t n,uint32_t cores){
ExecutionShape p{m,k,n,e,cores,Streamed,64,128,128,2,0};
if(n<=64){p.tm=128;p.tn=64;}
else if(n>256){p.tm=32;p.tn=256;}
if(k>=2048){p.tm=32;p.tn=128;p.ck=256;}
uint32_t active=e,maxRows=m;
p.rowExperts=active;
if(n>=128 && k>=1024 && (uint64_t)m>=64ull*active){
p.tm=128;p.tn=256;p.ck=k>=4096?512:256;
p.resident=(uint64_t)p.tm*((k+31)/32*32)+2ull*p.tn*p.ck<=480*1024?1:0;
}
if(m<16*active){
p.tm=16;p.tn=n>128?128:64;p.ck=k>=4096?1024:(k>=2048?512:128);
if((uint64_t)p.tm*((k+31)/32*32)+2ull*p.tn*p.ck<=480*1024)p.resident=1;
}
if(n<=64 && k<=128 && m>=256*active){
p.tn=n<=32?32:64;p.ck=(k+31)/32*32;
p.tm=32768/p.ck;uint32_t capacity=32768/p.tn;if(p.tm>capacity)p.tm=capacity;
if(p.tm>1024)p.tm=1024;p.tm=p.tm/16*16;p.resident=2;
}
if(n<=64 && k>128 && m>=256*active){
uint32_t width=n<=32?32:64,rows=32768/p.ck;if(rows>256)rows=256;
if((uint64_t)width*((k+31)/32*32)+2ull*rows*p.ck<=480*1024){p.tm=rows/16*16;p.tn=width;p.resident=2;}
}
if(n<=64 && m>=256*active){uint32_t fill=((m+cores-1)/cores+15)/16*16;if(p.tm>fill)p.tm=fill;}
uint32_t rowTasks=(m+p.tm-1)/p.tm+e-1;
if(rowTasks*((n+p.tn-1)/p.tn)<cores && n>256 && k>=2048 && maxRows<=32 && p.tm>16){
p.tm=16;rowTasks=(m+p.tm-1)/p.tm+e-1;
}
if(rowTasks*((n+p.tn-1)/p.tn)<cores && n>256 && k>=2048){
uint32_t columns=(cores+rowTasks-1)/rowTasks,width=((n+columns-1)/columns+31)/32*32;
if(width<p.tn)p.tn=width;
}
uint32_t tasks=rowTasks*((n+p.tn-1)/p.tn);
p.cores=p.cores<tasks?p.cores:tasks;return p;
}
__aicore__ inline void K1GeluChain(const LocalTensor<float> &z,const LocalTensor<float> &u,uint32_t count){
SetMaskCount();SetVectorMask<float,MaskMode::COUNTER>(count);
Mul<float,false>(u,z,z,MASK_PLACEHOLDER,1,{1,1,1,8,8,8});PipeBarrier<PIPE_V>();
Muls<float,false>(u,u,-0.07135481387376785f,MASK_PLACEHOLDER,1,{1,1,8,8});PipeBarrier<PIPE_V>();
Adds<float,false>(u,u,-1.5957691669464111f,MASK_PLACEHOLDER,1,{1,1,8,8});PipeBarrier<PIPE_V>();
Mul<float,false>(u,u,z,MASK_PLACEHOLDER,1,{1,1,1,8,8,8});PipeBarrier<PIPE_V>();
Mins<float,false>(u,u,80.0f,MASK_PLACEHOLDER,1,{1,1,8,8});PipeBarrier<PIPE_V>();
Exp<float,false>(u,u,MASK_PLACEHOLDER,1,{1,1,8,8});PipeBarrier<PIPE_V>();
Adds<float,false>(u,u,1.0f,MASK_PLACEHOLDER,1,{1,1,8,8});PipeBarrier<PIPE_V>();
Div<float,false>(z,z,u,MASK_PLACEHOLDER,1,{1,1,1,8,8,8});PipeBarrier<PIPE_V>();
SetMaskNorm();ResetMask();
}
__global__ __aicore__ void K1ValueReuseKernel(GM_ADDR xs,GM_ADDR ws,GM_ADDR ss,GM_ADDR gs,GM_ADDR ys,SmallInvocation packet){
KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
InitSocState();
constexpr uint32_t pitch=4096,smallGate=256,reserve=7;
TPipe pipe;TBuf<TPosition::VECCALC> memory;pipe.InitBuffer(memory,184*1024);
auto bytes=memory.Get<uint8_t>();
auto xbuf=bytes.ReinterpretCast<int8_t>();
auto w8=bytes[8192].ReinterpretCast<int8_t>();
auto wh=bytes[12288].ReinterpretCast<half>();
auto wf=bytes[20480].ReinterpretCast<float>();
auto gain=bytes[36864].ReinterpretCast<float>();
auto z=bytes[53248].ReinterpretCast<float>();
auto u=bytes[69632].ReinterpretCast<float>();
auto output=bytes[86016].ReinterpretCast<half>();
GlobalTensor<int8_t> x,w;GlobalTensor<float> scale;GlobalTensor<int64_t> ends;GlobalTensor<half> y;
x.SetGlobalBuffer((__gm__ int8_t*)xs);w.SetGlobalBuffer((__gm__ int8_t*)ws);scale.SetGlobalBuffer((__gm__ float*)ss);
ends.SetGlobalBuffer((__gm__ int64_t*)gs);y.SetGlobalBuffer((__gm__ half*)ys);
DataCacheCleanAndInvalid<int64_t,CacheLine::ENTIRE_DATA_CACHE,DcciDst::CACHELINE_OUT>(ends);
uint32_t worker=GetBlockIdx(),workers=packet.workers,padCols=Up(packet.cols,32)-packet.cols;
uint32_t previous=0,maxRows=0,largeExpert=0xffffffffu,largeCount=0,smallTotal=0;
for(uint32_t e=0;e<packet.groups;++e){
uint32_t end=ends.GetValue(e),rows=end-previous;
if(rows>=smallGate){++largeCount;if(rows>maxRows){maxRows=rows;largeExpert=e;}}else smallTotal+=rows;
previous=end;
}
uint32_t xpad=Up(packet.rows,32)-packet.rows;
DataCopyPad(xbuf,x,DataCopyExtParams{1,packet.rows,0,0,0},DataCopyPadExtParams<int8_t>{true,0,(uint8_t)xpad,0});
SetFlag<HardEvent::MTE2_S>(1);WaitFlag<HardEvent::MTE2_S>(1);
uint32_t largeWorkers=workers>reserve?workers-reserve:workers;
bool split=largeCount==1 && largeWorkers>=32 && largeWorkers*8u>=256u && smallTotal;
if(split && worker<largeWorkers){
uint32_t vfirst=worker*256u/largeWorkers,vlast=(worker+1u)*256u/largeWorkers,previousRow=0;
for(uint32_t expert=0;expert<packet.groups;++expert){
uint32_t end=ends.GetValue(expert),rows=end-previousRow;
if(expert==largeExpert && rows){
DataCopyPad(w8,w[(uint64_t)expert*packet.depth*packet.cols],DataCopyExtParams{1,packet.cols,0,0,0},DataCopyPadExtParams<int8_t>{true,0,(uint8_t)padCols,0});
DataCopyPad(gain,scale[(uint64_t)expert*packet.cols],DataCopyExtParams{1,(uint32_t)packet.cols*4u,0,0,0},DataCopyPadExtParams<float>{true,0,(uint8_t)padCols,0});
SetFlag<HardEvent::MTE2_V>(0);WaitFlag<HardEvent::MTE2_V>(0);
Cast(wh,w8,RoundMode::CAST_NONE,pitch);PipeBarrier<PIPE_V>();
Cast(wf,wh,RoundMode::CAST_NONE,pitch);PipeBarrier<PIPE_V>();

uint32_t slot=0;
for(uint32_t value=vfirst;value<vlast;++value,++slot){
float left=(float)((int32_t)value-128);
Muls(z,wf,left,pitch);PipeBarrier<PIPE_V>();
Mul(z,z,gain,pitch);PipeBarrier<PIPE_V>();
K1GeluChain(z,u,pitch);
Cast(output[slot*pitch],z,RoundMode::CAST_RINT,pitch);PipeBarrier<PIPE_V>();
}
Fence<HardEvent::V_MTE3>(0);
uint32_t paddedRows=Up(rows,128);
if(paddedRows<=8192u-previousRow){
auto m0=w8.ReinterpretCast<uint8_t>();
auto m1=m0[1024];auto mc=m1[1024];
auto m016=m0.ReinterpretCast<uint16_t>();auto m116=m1.ReinterpretCast<uint16_t>();auto mc16=mc.ReinterpretCast<uint16_t>();
auto xh=z.ReinterpretCast<half>();auto indices=z.ReinterpretCast<int32_t>();
auto temp=bytes[151552].ReinterpretCast<int32_t>();auto pattern=wh.ReinterpretCast<uint32_t>();auto combined=mc.ReinterpretCast<uint32_t>();
Cast(xh,xbuf[previousRow],RoundMode::CAST_NONE,paddedRows);PipeBarrier<PIPE_V>();
Compares<half,uint8_t>(m0,xh,(half)((int32_t)vfirst-128),CMPMODE::GE,paddedRows);
Compares<half,uint8_t>(m1,xh,(half)((int32_t)vlast-128),CMPMODE::LT,paddedRows);
PipeBarrier<PIPE_V>();
uint32_t maskBytes=Up((rows+7)/8,32);
And<uint16_t>(mc16,m016,m116,(int32_t)(maskBytes/2));PipeBarrier<PIPE_V>();
Fence<HardEvent::V_S>(0);
auto words=mc.ReinterpretCast<uint64_t>();
uint32_t chunks=(rows+63)/64,rem=rows%64;
for(uint32_t chunk=0;chunk<chunks;++chunk){
uint64_t active=words.GetValue(chunk);
if(chunk+1==chunks && rem)active&=(1ull<<rem)-1ull;
while(active){uint32_t bit=GetSFFValue<1>(active);active&=active-1;uint32_t row=chunk*64+bit;
uint32_t value=(uint32_t)((int32_t)xbuf.GetValue(previousRow+row)+128);
DataCopyPad(y[(uint64_t)(previousRow+row)*packet.cols],output[(value-vfirst)*pitch],DataCopyExtParams{1,(uint32_t)packet.cols*2u,0,0,0});
}
}
}else{
for(uint32_t row=0;row<rows;++row){
uint32_t value=(uint32_t)((int32_t)xbuf.GetValue(previousRow+row)+128);
if(value>=vfirst && value<vlast)
DataCopyPad(y[(uint64_t)(previousRow+row)*packet.cols],output[(value-vfirst)*pitch],DataCopyExtParams{1,(uint32_t)packet.cols*2u,0,0,0});
}
}
Fence<HardEvent::MTE3_V>(0);Fence<HardEvent::V_MTE2>(0);
}
previousRow=end;
}
}else if(split){
uint32_t sid=worker-largeWorkers,smallWorkers=workers-largeWorkers;
uint32_t smallFirst=(uint64_t)smallTotal*sid/smallWorkers,smallLast=(uint64_t)smallTotal*(sid+1)/smallWorkers;
uint32_t previousRow=0,smallOrdinal=0;
bool busy[2]={false,false};
for(uint32_t expert=0;expert<packet.groups;++expert){
uint32_t end=ends.GetValue(expert),rows=end-previousRow;
if(expert!=largeExpert && rows){
uint32_t globalFirst=smallOrdinal,globalLast=smallOrdinal+rows;
uint32_t first=smallFirst>globalFirst?smallFirst-globalFirst:0u;
uint32_t last=smallLast<globalLast?smallLast-globalFirst:rows;
if(first<last){
DataCopyPad(w8,w[(uint64_t)expert*packet.depth*packet.cols],DataCopyExtParams{1,packet.cols,0,0,0},DataCopyPadExtParams<int8_t>{true,0,(uint8_t)padCols,0});
DataCopyPad(gain,scale[(uint64_t)expert*packet.cols],DataCopyExtParams{1,(uint32_t)packet.cols*4u,0,0,0},DataCopyPadExtParams<float>{true,0,(uint8_t)padCols,0});
SetFlag<HardEvent::MTE2_V>(0);WaitFlag<HardEvent::MTE2_V>(0);
Cast(wh,w8,RoundMode::CAST_NONE,pitch);PipeBarrier<PIPE_V>();
Cast(wf,wh,RoundMode::CAST_NONE,pitch);PipeBarrier<PIPE_V>();

for(uint32_t row=first;row<last;++row){
uint32_t buffer=(row-first)&1;if(busy[buffer]){WaitFlag<HardEvent::MTE3_V>(2+buffer);busy[buffer]=false;}
float left=(float)xbuf.GetValue(previousRow+row);
Muls(z,wf,left,pitch);PipeBarrier<PIPE_V>();
Mul(z,z,gain,pitch);PipeBarrier<PIPE_V>();
K1GeluChain(z,u,pitch);
Cast(output[buffer*pitch],z,RoundMode::CAST_RINT,pitch);
Fence<HardEvent::V_MTE3>(0);
DataCopyPad(y[(uint64_t)(previousRow+row)*packet.cols],output[buffer*pitch],DataCopyExtParams{1,(uint32_t)packet.cols*2u,0,0,0});
SetFlag<HardEvent::MTE3_V>(2+buffer);busy[buffer]=true;
}
for(uint32_t i=0;i<2;++i)if(busy[i]){WaitFlag<HardEvent::MTE3_V>(2+i);busy[i]=false;}
Fence<HardEvent::V_MTE2>(0);
}
smallOrdinal=globalLast;
}
previousRow=end;
}
}else{
uint32_t previousRow=0;bool busy[2]={false,false};
for(uint32_t expert=0;expert<packet.groups;++expert){
uint32_t end=ends.GetValue(expert),rows=end-previousRow;
if(rows){
bool reuse=rows>=smallGate;uint32_t first=0,last=rows;
if(!reuse){first=(uint64_t)rows*worker/workers;last=(uint64_t)rows*(worker+1)/workers;}
if(reuse || first<last){
DataCopyPad(w8,w[(uint64_t)expert*packet.depth*packet.cols],DataCopyExtParams{1,packet.cols,0,0,0},DataCopyPadExtParams<int8_t>{true,0,(uint8_t)padCols,0});
DataCopyPad(gain,scale[(uint64_t)expert*packet.cols],DataCopyExtParams{1,(uint32_t)packet.cols*4u,0,0,0},DataCopyPadExtParams<float>{true,0,(uint8_t)padCols,0});
SetFlag<HardEvent::MTE2_V>(0);WaitFlag<HardEvent::MTE2_V>(0);
Cast(wh,w8,RoundMode::CAST_NONE,pitch);PipeBarrier<PIPE_V>();
Cast(wf,wh,RoundMode::CAST_NONE,pitch);PipeBarrier<PIPE_V>();

if(reuse){
uint32_t vfirst=worker*256u/workers,vlast=(worker+1u)*256u/workers,slot=0;
for(uint32_t value=vfirst;value<vlast;++value,++slot){
float left=(float)((int32_t)value-128);
Muls(z,wf,left,pitch);PipeBarrier<PIPE_V>();
Mul(z,z,gain,pitch);PipeBarrier<PIPE_V>();
K1GeluChain(z,u,pitch);
Cast(output[slot*pitch],z,RoundMode::CAST_RINT,pitch);PipeBarrier<PIPE_V>();
}
Fence<HardEvent::V_MTE3>(0);
for(uint32_t row=0;row<rows;++row){
uint32_t value=(uint32_t)((int32_t)xbuf.GetValue(previousRow+row)+128);
if(value>=vfirst && value<vlast)
DataCopyPad(y[(uint64_t)(previousRow+row)*packet.cols],output[(value-vfirst)*pitch],DataCopyExtParams{1,(uint32_t)packet.cols*2u,0,0,0});
}
Fence<HardEvent::MTE3_V>(0);
}else{
for(uint32_t row=first;row<last;++row){
uint32_t buffer=(row-first)&1;if(busy[buffer]){WaitFlag<HardEvent::MTE3_V>(2+buffer);busy[buffer]=false;}
float left=(float)xbuf.GetValue(previousRow+row);
Muls(z,wf,left,pitch);PipeBarrier<PIPE_V>();
Mul(z,z,gain,pitch);PipeBarrier<PIPE_V>();
K1GeluChain(z,u,pitch);
Cast(output[buffer*pitch],z,RoundMode::CAST_RINT,pitch);
Fence<HardEvent::V_MTE3>(0);
DataCopyPad(y[(uint64_t)(previousRow+row)*packet.cols],output[buffer*pitch],DataCopyExtParams{1,(uint32_t)packet.cols*2u,0,0,0});
SetFlag<HardEvent::MTE3_V>(2+buffer);busy[buffer]=true;
}
for(uint32_t i=0;i<2;++i)if(busy[i]){WaitFlag<HardEvent::MTE3_V>(2+i);busy[i]=false;}
}
Fence<HardEvent::V_MTE2>(0);
}
}
previousRow=end;
}
}
Fence<HardEvent::S_MTE2>(1);
}
inline void RunStreaming(GM_ADDR xs,GM_ADDR ws,GM_ADDR ss,GM_ADDR gs,GM_ADDR ys,ExecutionShape p,aclrtStream stream){
if((uint64_t)p.rows*p.cols<=64 && (uint64_t)p.rows*p.cols*p.depth<=512){
SmallInvocation q{p.rows,(uint16_t)p.depth,(uint16_t)p.cols,p.experts,1,0};
SmallAccurateKernel<<<1,nullptr,stream>>>(xs,ws,ss,gs,ys,q);return;
}
if((uint64_t)p.depth*p.cols<=1){
uint32_t workers=p.cores*2;if(workers>p.rows)workers=p.rows;
SmallInvocation q{p.rows,(uint16_t)p.depth,(uint16_t)p.cols,p.experts,(uint16_t)workers,0};
ScalarStreamingKernel<<<workers,nullptr,stream>>>(xs,ws,ss,gs,ys,q);return;
}
if(p.depth<=1 && p.cols>=32 && (uint64_t)p.rows>=8ull*p.rowExperts && p.rows>=p.cores*2){
uint32_t workers=p.cores*2;
SmallInvocation packet{p.rows,(uint16_t)p.depth,(uint16_t)p.cols,p.experts,(uint16_t)workers,0};
if(p.rows>=32 && p.rows<=8192 && p.cols>=2048 && p.cols<=4096 && p.experts<=8 && workers>=32 && workers<=64)K1ValueReuseKernel<<<workers,nullptr,stream>>>(xs,ws,ss,gs,ys,packet);else OuterVectorKernel<<<workers,nullptr,stream>>>(xs,ws,ss,gs,ys,packet);return;
}
if(p.cols<=1 && p.depth>=32 && (uint64_t)p.rows>=64ull*p.rowExperts){
uint32_t workers=p.cores*2;if(workers>p.rows)workers=p.rows;
SmallInvocation packet{p.rows,(uint16_t)p.depth,(uint16_t)p.cols,p.experts,(uint16_t)workers,0};
DotVectorKernel<<<workers,nullptr,stream>>>(xs,ws,ss,gs,ys,packet);return;
}
uint64_t packedSize=(uint64_t)((p.depth+31)/32*32)*((p.rows+63)/64*64+(uint64_t)p.experts*((p.cols+31)/32*32));
if(p.depth>=1024 && p.depth<4096 && p.cols>=2048 && p.rows>=1024 && packedSize<=512ull*1024*1024){
p.tm=128;p.tn=256;p.ck=128;p.ring=2;p.resident=0;p.tailStripe=1;p.route=LongReduction;
uint64_t bytes=(uint64_t)p.cores*p.ring*p.tm*p.tn*4+packedSize;void *workspace=nullptr;
if(aclrtMalloc(&workspace,bytes,ACL_MEM_MALLOC_HUGE_FIRST)!=ACL_SUCCESS)return;
LaunchDescriptor packet=EncodeLaunchDescriptor(p);PackedStreamingKernel<<<p.cores,nullptr,stream>>>(packet,xs,ws,ss,gs,ys,(GM_ADDR)workspace);
aclrtSynchronizeStream(stream);aclrtFree(workspace);return;
}
size_t bytes=(uint64_t)p.cores*p.ring*p.tm*p.tn*4;void *workspace=nullptr;
if(aclrtMalloc(&workspace,bytes,ACL_MEM_MALLOC_HUGE_FIRST)!=ACL_SUCCESS)return;
LaunchDescriptor packet=EncodeLaunchDescriptor(p);
if(p.cols<=64 && p.tn>=p.cols && p.cols%32 && (uint64_t)p.rows>=64ull*p.rowExperts)
SlimStreamingKernel<<<p.cores,nullptr,stream>>>(packet,xs,ws,ss,gs,ys,(GM_ADDR)workspace);
else
StreamingKernel<<<p.cores,nullptr,stream>>>(packet,xs,ws,ss,gs,ys,(GM_ADDR)workspace);
aclrtSynchronizeStream(stream);aclrtFree(workspace);
}

}

namespace expert_activation{using namespace AscendC;
constexpr IsResetLoad3dConfig P04_SHALLOW_LEFT_LOAD3D_CONFIG={false,false};
struct Plan{int m,k,n,e,cores,tm,tn,ck,ring,vectors,cacheA,cacheB,reverseK,splitN;};
__aicore__ inline bool P13LongPackedAEnabled(const Plan&p);
struct RuntimePackedPlan{uint32_t m;uint16_t k,n,e,ck;uint32_t bits;};
__aicore__ inline Plan UnpackDirectRuntimePlan(RuntimePackedPlan q){Plan p{};uint32_t g=q.bits;p.m=q.m;p.k=q.k;p.n=q.n;p.e=q.e;p.ck=q.ck;p.cores=g&63;p.tm=(g>>6)&255;p.tn=((g>>14)&63)*32;p.cacheA=(g>>20)&7;p.cacheB=(g>>23)&3;p.reverseK=(g>>25)&1;p.splitN=(g>>26)&1;p.ring=(g>>27)&7;p.vectors=(g>>30)&3;return p;}
__aicore__ inline Plan UnpackHintRuntimePlan(RuntimePackedPlan q){Plan p{};uint32_t g=q.bits;p.m=q.m&0x1ffffu;p.k=q.k&0x7fffu;p.n=q.n;p.e=q.e;p.ck=q.ck;p.cores=g&63;p.tm=(g>>6)&255;p.tn=((g>>14)&63)*32;p.cacheA=(g>>20)&7;p.cacheB=(g>>23)&3;p.reverseK=(g>>25)&1;p.splitN=(g>>26)&1;p.ring=(g>>27)&7;p.vectors=(g>>30)&3;return p;}
struct BoundedRuntimePacket{uint64_t lo,hi;};
