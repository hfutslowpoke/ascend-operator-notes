if constexpr(Mode==TailStrip){
if(rowStageOffset && future && future->expert==t.expert && (future->row!=t.row || future->rows!=t.rows)){
Nd2NzParams d{};d.ndNum=1;d.nValue=future->rows;d.dValue=p.depth;d.srcDValue=p.depth;d.dstNzC0Stride=Up(future->rows,16);d.dstNzNStride=1;
DataCopy(a1[rowStageOffset],x[(uint64_t)future->row*p.depth],d);SetFlag<HardEvent::MTE2_MTE1>(6);rowStageTile=*future;rowStageQueued=true;aFirst=0;aLast=p.depth;
}
}
if(twoA){cachedA[aIndex]=t;aValid[aIndex]=true;aAge[aIndex]=++age;}
}
__aicore__ inline void Publish(const WorkChunk &t,GlobalTensor<int32_t> scratch,uint64_t offset,bool atomic=false) {
if(!units && !tileUnits)Fence<HardEvent::M_FIX>();
FixpipeParamsV220 fp{}; fp.mSize=units?(Mode==LongReduction && t.rows<=32?32:Up(t.rows,16)):t.rows;if(units || tileUnits)fp.unitFlag=3; fp.nSize=Up(t.cols,32);
fp.srcStride=(Mode==LongReduction && t.rows<=32)?32:Up(t.rows,16); fp.dstStride=(Mode==TailStrip || Mode==TailPanel)?Up(t.cols,32):p.tn;
uint32_t shift=ExchangeScaleShift(p);
if(shift) {
union{uint32_t u;float f;} inverse;inverse.u=(127-shift)<<23;
fp.quantPre=QuantMode_t::DEQF16;fp.deqScalar=(uint64_t)inverse.u;
