TPipe pipe;TBuf<TPosition::VECCALC> memory;pipe.InitBuffer(memory,8*capacity+pitch*4+2048);
auto bytes=memory.Get<uint8_t>();auto input=bytes.ReinterpretCast<int8_t>();auto converted=bytes[2*capacity+256].ReinterpretCast<half>();
auto product=bytes[4*capacity+512].ReinterpretCast<float>(),weights=bytes[8*capacity+768].ReinterpretCast<float>();
auto temporary=converted.ReinterpretCast<uint8_t>();temporary.SetSize(2*capacity);auto sums=bytes[8*capacity+pitch*4+1024].ReinterpretCast<float>();auto z=sums[64],u=z[64];auto output=u[64].ReinterpretCast<half>();
GlobalTensor<int8_t> x,w;GlobalTensor<float> scale;GlobalTensor<int64_t> ends;GlobalTensor<half> y;
x.SetGlobalBuffer((__gm__ int8_t*)xs);w.SetGlobalBuffer((__gm__ int8_t*)ws);scale.SetGlobalBuffer((__gm__ float*)ss);
ends.SetGlobalBuffer((__gm__ int64_t*)gs);y.SetGlobalBuffer((__gm__ half*)ys);
