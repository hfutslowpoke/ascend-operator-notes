__schedmode__(1)__global__ __mix__(1,2)void WideDoubleVectorKernel(RuntimePackedPlan packet,GM_ADDR x,GM_ADDR weight,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,GM_ADDR workspace){InitSocState();Plan p=UnpackDirectRuntimePlan(packet);int core=CubeLane(p);if ASCEND_IS_AIV{WideDualFlowConsumer consumer(scale,y,workspace,p,core);if(p.e==p.cores){P01OwnerPacketCursor cursor(groups,p,core);consumer.Run(cursor);}else{WideDualFlowPacketCursor cursor(groups,p,core);consumer.Run(cursor);}return;}if ASCEND_IS_AIC{if(p.cacheA==4){WideOwnerStageFusedEngine staged(x,weight,scale,y,workspace,p,core);P01WidePanelCursor cursor(groups,p,core);WorkTile pending{},current{};bool valid=cursor.Next(pending);while(valid){current=pending;valid=cursor.Next(pending);staged.Process(current,pending,valid);}staged.Finish();return;}if(p.cacheA==3){WideOwnerStageFusedEngine staged(x,weight,scale,y,workspace,p,core);if(p.e==p.cores){if(p.n%p.tn==0)staged.PrimeFirst(core,0,p.tn);P01OwnerResidentCursor cursor(groups,p,core);WorkTile pending{},current{};bool valid=cursor.Next(pending);while(valid){current=pending;valid=cursor.Next(pending);staged.Process(current,pending,valid);}staged.Finish();}else{WideResidentCursor cursor(groups,p,core);WorkTile pending{},current{};bool valid=cursor.Next(pending);while(valid){current=pending;valid=cursor.Next(pending);staged.Process(current,pending,valid);}staged.Finish();}return;}PendingNextFusedEngine engine(x,weight,scale,y,workspace,p,core);WideResidentCursor cursor(groups,p,core);WorkTile pending{},current{};bool valid=cursor.Next(pending);while(valid){current=pending;valid=cursor.Next(pending);engine.Process(current,pending,valid);}engine.Finish();}}
class RowDualFlowActivationTile{public:LocalTensor<half>accum;LocalTensor<float>z,raw,scales;LocalTensor<half>output;bool outputPending=false,inputReusePending=false;int eventId;__aicore__ inline void AwaitInputReuse(){if(inputReusePending){WaitFlag<HardEvent::V_MTE2>(eventId);inputReusePending=false;}}__aicore__ inline void DrainOutput(){if(outputPending){AwaitPipe<HardEvent::MTE3_V>(eventId);outputPending=false;}}__aicore__ inline explicit RowDualFlowActivationTile(int capacity,int scaleCapacity,uint32_t base,int event):eventId(event){int size=RoundExtent(capacity,512),sc=RoundExtent(scaleCapacity,8);int saved=3*RoundExtent(size/8,256)-768;uint32_t phaseShift=static_cast<uint32_t>(-base)&511u;uint32_t at=base+(phaseShift<=static_cast<uint32_t>(saved)?phaseShift:0);z=LocalAt<float>(at,size);at+=size*4+256;raw=LocalAt<float>(at,size);at+=size*4+256;accum=raw.ReinterpretCast<half>();output=LocalAt<half>(at,size);at+=size*2+256;scales=LocalAt<float>(at,sc);}__aicore__ inline void Prepare(int count){SetMaskCount();SetVectorMask<float,MaskMode::COUNTER>(count);Mul<float,false>(raw,z,z,MASK_PLACEHOLDER,1,{1,1,1,8,8,8});PipeBarrier<PIPE_V>();Muls<float,false>(raw,raw,-0.07135481387376785f,MASK_PLACEHOLDER,1,{1,1,8,8});PipeBarrier<PIPE_V>();Adds<float,false>(raw,raw,-1.5957691669464111f,MASK_PLACEHOLDER,1,{1,1,8,8});PipeBarrier<PIPE_V>();Mul<float,false>(raw,raw,z,MASK_PLACEHOLDER,1,{1,1,1,8,8,8});PipeBarrier<PIPE_V>();Exp<float,false>(raw,raw,MASK_PLACEHOLDER,1,{1,1,8,8});PipeBarrier<PIPE_V>();Adds<float,false>(raw,raw,1.0f,MASK_PLACEHOLDER,1,{1,1,8,8});PipeBarrier<PIPE_V>();Div<float,false>(raw,z,raw,MASK_PLACEHOLDER,1,{1,1,1,8,8,8});PipeBarrier<PIPE_V>();SetMaskNorm();ResetMask();DrainOutput();uint8_t vectorRepeats=static_cast<uint8_t>((count+63)/64);Cast<half,float,false>(output,raw,RoundMode::CAST_RINT,MASK_PLACEHOLDER,vectorRepeats,{1,1,4,8});SetFlag<HardEvent::V_MTE3>(eventId);SetFlag<HardEvent::V_MTE2>(eventId);inputReusePending=true;}};
__aicore__ inline int RowDualFlowCapacity(const Plan&p){return Min(8192,RoundExtent((p.tm+p.vectors-1)/p.vectors*p.tn,512));}
__aicore__ inline int RowDualFlowStride(const Plan&p){int capacity=RowDualFlowCapacity(p);return RoundExtent(capacity*10+3*RoundExtent(capacity/8,256)+RoundExtent(p.tn,8)*4+32,256);}
