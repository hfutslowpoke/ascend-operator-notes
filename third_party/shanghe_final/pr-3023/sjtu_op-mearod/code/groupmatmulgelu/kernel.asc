}
}
__aicore__ inline void Compute(const WorkChunk &t,uint32_t firstK=0,uint32_t lastK=0,const WorkChunk *future=nullptr) {
if(Mode==ShallowResident){Shallow(t,future);return;}
if(Mode==LongReduction){Packed(t);return;}
if(!lastK)lastK=p.depth;
uint32_t ma=(Mode==LongReduction && t.rows<=32)?32:Up(t.rows,16), na=Up(t.cols,32);
bool hitA=validA && oldA.expert==t.expert && oldA.row==t.row && oldA.rows==t.rows && firstK>=aFirst && lastK<=aLast;
bool hitB=validB && oldB.expert==t.expert && (fullB || (oldB.col==t.col && oldB.cols==t.cols));
uint32_t aIndex=0;
if(twoA) {
bool found=false;for(uint32_t i=0;i<2;++i)if(aValid[i] && cachedA[i].expert==t.expert && cachedA[i].row==t.row && cachedA[i].rows==t.rows){aIndex=i;found=true;}
if(!found)aIndex=!aValid[0]?0:(!aValid[1]?1:(aAge[0]<=aAge[1]?0:1));
hitA=found;
}
bool waitA=keepA&&!hitA,waitB=keepB&&!hitB;
bool fillB=waitB && (Mode==TailStrip || Mode==ShortGroupWave || Mode==TailPanel);
if(waitA){ReadA(t,firstK,lastK-firstK,aIndex,ma);aFirst=firstK;aLast=lastK;}
bool useHead=pendingHead && nextHead.expert==t.expert && nextHead.col==t.col && nextHead.cols==t.cols;
if(pendingHead && !useHead)WaitFlag<HardEvent::MTE2_MTE1>(3);
pendingHead=false;
bool fillSplit=splitB && (waitB || useHead);
if(fillSplit){if(!useHead)ReadSplitB(t,false,7);}
else if (waitB && !fillB) ReadB(t,0,p.depth,0);
uint32_t chunks=(lastK-firstK+p.ck-1)/p.ck;
kPhase=0;
if(Mode==TailPanel)kPhase=((t.col/p.tn)*chunks/((p.cols+p.tn-1)/p.tn)+1)%chunks;
if(Mode==Interleaved)kPhase=t.expert*chunks/p.experts;
uint32_t budget=Mode==ShallowResident?65536:32768;
uint32_t stripe=Mode==TailStrip && p.tailStripe?Min(na,p.tailStripe):Min(na,(budget/p.ck)/32*32);
if(Mode==ShortGroupWave && na*p.ck>budget)stripe=Up((na+1)/2,32);

bool useA=pendingA && nextA.expert==t.expert && nextA.row==t.row && nextA.rows==t.rows;
if(pendingA && !useA)WaitFlag<HardEvent::MTE2_MTE1>(5);
pendingA=false;
if(!keepA)for(uint32_t i=0;i<Min(chunks,aSlots);++i){if(!i && useA)continue;uint32_t pos=KAt(i,chunks,firstK);ReadA(t,pos,Min(p.ck,lastK-pos),i,ma);}
if(fillB)for(uint32_t i=0;i<Min(chunks,2);++i){uint32_t pos=KAt(i,chunks,firstK);FillResidentB(t,pos,Min(p.ck,lastK-pos),i);}
uint32_t bStages=(chunks+bFactor-1)/bFactor;
bool usePending=pendingB && pendingTile.expert==t.expert && pendingTile.col==t.col && pendingTile.cols==t.cols;
bool coldHead=!usePending && bFactor>1 && chunks>bFactor;
if(pendingB && !usePending)WaitFlag<HardEvent::MTE2_MTE1>(2+bSlots);
pendingB=false;
if(!keepB)for(uint32_t i=0;i<Min(bStages,bSlots);++i) {
if(usePending && (panelPack || i==0))continue;
uint32_t pos=KAt(i*bFactor,chunks,firstK);
ReadB(t,pos,Min(p.ck*bFactor,lastK-pos),i,coldHead && !i);
}
for (uint32_t chunk=0; chunk<chunks; ++chunk) {
uint32_t k=KAt(chunk,chunks,firstK), vk=Min(p.ck,lastK-k), ka=Up(vk,32), slot=chunk&1;

auto aa=l0a.AllocTensor<int8_t>();

if(keepA){if(waitA && !chunk)WaitFlag<HardEvent::MTE2_MTE1>(6);}
else WaitFlag<HardEvent::MTE2_MTE1>(useA && !chunk?5:chunk%aSlots);
uint32_t ao=keepA?aOffsets[aIndex]+k*ma:(useA && !chunk?aSlots:chunk%aSlots)*p.tm*p.ck;
LoadA(aa,ao,ma,ka);
l0a.EnQue(aa);aa=l0a.DeQue<int8_t>();
if(!keepA && chunk+aSlots<chunks){Fence<HardEvent::MTE1_MTE2>(1);uint32_t next=KAt(chunk+aSlots,chunks,firstK);ReadA(t,next,Min(p.ck,lastK-next),chunk%aSlots,ma);}
if(prefetchA && future && chunk+1==chunks){
Fence<HardEvent::MTE1_MTE2>(5);Nd2NzParams d{};d.ndNum=1;d.nValue=future->rows;d.dValue=Min(p.ck,p.depth);
d.srcDValue=p.depth;d.dstNzC0Stride=Up(future->rows,16);d.dstNzNStride=1;
DataCopy(a1[aSlots*p.tm*p.ck],x[(uint64_t)future->row*p.depth],d);SetFlag<HardEvent::MTE2_MTE1>(5);nextA=*future;pendingA=true;
}
for (uint32_t col=0; col<na; col+=stripe) {
uint32_t ns=Min(stripe,na-col);

auto bb=l0b.AllocTensor<int8_t>();
LoadData2dTransposeParams lb{}; lb.repeatTimes=ns/32;
lb.srcStride=bpitch/32; lb.dstGap=1; lb.dstFracGap=0;
uint32_t stageSlot=usePending && bFactor>1 && chunk<bFactor?bSlots:chunk/bFactor%bSlots;
if(!col){
if(keepB){
if(fillSplit){if(!chunk)WaitFlag<HardEvent::MTE2_MTE1>(useHead?3:7);if(k==splitK)WaitFlag<HardEvent::MTE2_MTE1>(4);}
else if(fillB)WaitFlag<HardEvent::MTE2_MTE1>(2+slot);else if(waitB && !chunk)WaitFlag<HardEvent::MTE2_MTE1>(7);
}
else if(coldHead && !chunk)WaitFlag<HardEvent::MTE2_MTE1>(5);
else if(coldHead && chunk==1)WaitFlag<HardEvent::MTE2_MTE1>(2);
else if(chunk%bFactor==0)WaitFlag<HardEvent::MTE2_MTE1>(2+stageSlot);
}
uint32_t bo=keepB?(col+(fullB?t.col:0))*bpitch+k*32:stageSlot*p.tn*bpitch+col*bpitch+(chunk%bFactor)*p.ck*32;
uint32_t currentPitch=bpitch;
if(splitB){currentPitch=k<splitK?headPitch:tailPitch;bo=(k<splitK?0:p.tn*headPitch)+col*currentPitch+(k<splitK?k:k-splitK)*32;}
if(panelPack){lb.repeatTimes=ka*ns/1024;lb.srcStride=1;LoadDataWithTranspose(bb,b1[bo],lb);}
else LoadB(bb,b1[bo],ns,ka,currentPitch);
l0b.EnQue(bb);bb=l0b.DeQue<int8_t>();
MmadParams mm{}; mm.m=ma; mm.n=ns; mm.k=vk;
mm.cmatrixInitVal=chunk==0;
Mmad(c0[col*ma],aa,bb,mm);
if((ma/16)*(ns/16)<10)PipeBarrier<PIPE_M>();
if(col+ns==na && !keepB && (chunk+1)%bFactor==0 && chunk/bFactor+bSlots<bStages) {
Fence<HardEvent::MTE1_MTE2>(2);
uint32_t next=KAt((chunk/bFactor+bSlots)*bFactor,chunks,firstK);ReadB(t,next,Min(p.ck*bFactor,lastK-next),chunk/bFactor%bSlots);
}
if(future && col+ns==na && panelPack && chunks==bSlots) {
Fence<HardEvent::MTE1_MTE2>(3);ReadB(*future,k,vk,chunk%bSlots);pendingTile=*future;pendingB=true;
}
if(future && bFactor>1 && keepA && bBytes>(bSlots*p.tn*bpitch) && chunk/bFactor+1==bStages && chunk%bFactor==0 && col+ns==na) {
Fence<HardEvent::MTE1_MTE2>(3);ReadB(*future,0,Min(p.ck*bFactor,p.depth),bSlots);pendingTile=*future;pendingB=true;
}
l0b.FreeTensor(bb);
}
l0a.FreeTensor(aa);
Fence<HardEvent::MTE1_MTE2>();
if(fillSplit && !chunk)ReadSplitB(t,true,4);
if(splitB && future && k+p.ck==splitK && (future->expert!=t.expert || future->col!=t.col || future->cols!=t.cols)){
ReadSplitB(*future,false,3);nextHead=*future;pendingHead=true;
}
if(fillB && chunk+2<chunks){uint32_t next=KAt(chunk+2,chunks,firstK);FillResidentB(t,next,Min(p.ck,lastK-next),slot);}
}
oldA=t; oldB=t; validA=keepA; validB=keepB;
if(twoA){cachedA[aIndex]=t;aValid[aIndex]=true;aAge[aIndex]=++age;}
}
__aicore__ inline void Publish(const WorkChunk &t,GlobalTensor<int32_t> scratch,uint64_t offset,bool atomic=false) {
Fence<HardEvent::M_FIX>();
FixpipeParamsV220 fp{}; fp.mSize=t.rows; fp.nSize=Up(t.cols,32);
fp.srcStride=(Mode==LongReduction && t.rows<=32)?32:Up(t.rows,16); fp.dstStride=(Mode==TailStrip || Mode==TailPanel)?Up(t.cols,32):p.tn;
uint32_t shift=ExchangeScaleShift(p);
if(shift) {
union{uint32_t u;float f;} inverse;inverse.u=(127-shift)<<23;
fp.quantPre=QuantMode_t::DEQF16;fp.deqScalar=(uint64_t)inverse.u;
GlobalTensor<half> compressed;compressed.SetGlobalBuffer((__gm__ half*)scratch.GetPhyAddr());
if(atomic)SetAtomicAdd<half>();
Fixpipe<half,int32_t,CFG_ROW_MAJOR>(compressed[offset],c0,fp);
if(atomic)SetAtomicNone();
} else {
if(atomic)SetAtomicAdd<int32_t>();
Fixpipe<int32_t,int32_t,CFG_ROW_MAJOR>(scratch[offset],c0,fp);
if(atomic)SetAtomicNone();
}
Fence<HardEvent::FIX_M>();
}
__aicore__ inline void Finish(){}
};

__aicore__ inline bool AdvanceRowSpan(WorkIterator<TailStrip>&cursor,ExecutionShape p,WorkChunk &row){
if(!cursor.Next(row))return false;
for(uint32_t col=p.tn;col<p.cols;col+=p.tn){WorkChunk skipped{};if(!cursor.Next(skipped))return false;}
return true;
}
__aicore__ inline void EmitGroupedPanels(CubeExecutor<TailStrip>&matrix,WorkIterator<TailStrip>&cursor,ExecutionShape p,GlobalTensor<int32_t>scratch,uint32_t core){
WorkChunk row{},next{},after{};uint32_t sequence=0;bool valid=AdvanceRowSpan(cursor,p,row),more=valid&&AdvanceRowSpan(cursor,p,next);
while(valid){
bool beyond=more&&AdvanceRowSpan(cursor,p,after);
bool cross=more && beyond && next.expert==row.expert && after.expert!=row.expert && next.rows<=16 && after.rows<=p.tm;
for(uint32_t col=0;col<p.cols;col+=p.tn){
WorkChunk tile=row;tile.col=col;tile.cols=Min(p.tn,p.cols-col);WorkChunk future{};bool hasFuture=false;
if(col+tile.cols<p.cols){future=tile;future.col+=p.tn;future.cols=Min(p.tn,p.cols-future.col);hasFuture=true;}
else if(more){future=next;hasFuture=true;}
uint32_t slot=sequence%p.ring;matrix.Compute(tile,0,0,hasFuture?&future:nullptr,more?&next:nullptr,cross?&after:nullptr);
if(sequence>=p.ring)CrossCoreWaitFlag<2>(p.ring+slot);
matrix.Publish(tile,scratch,((uint64_t)core*p.ring+slot)*p.tm*p.tn);CrossCoreSetFlag<2,PIPE_FIX>(slot);++sequence;
}
row=next;next=after;valid=more;more=beyond;
}
for(uint32_t j=sequence-Min(sequence,p.ring);j<sequence;++j)CrossCoreWaitFlag<2>(p.ring+j%p.ring);
matrix.Finish();
}

class VectorEpilogue {
uint32_t Capacity;
bool outputBusy=false,scaleReady=false,inputPending=false;
WorkChunk scaleTile{};
uint32_t bankId;
ExecutionShape p;
GlobalTensor<float> scale;
GlobalTensor<half> y;
TBuf<TPosition::VECCALC> buf;
LocalTensor<int32_t> raw;
LocalTensor<float> z,u,f,s,tail;
LocalTensor<half> out;
public:
__aicore__ inline VectorEpilogue(TPipe &pipe,ExecutionShape config,GM_ADDR ss,GM_ADDR ys,uint32_t bank=0):p(config),bankId(bank) {
scale.SetGlobalBuffer((__gm__ float*)ss); y.SetGlobalBuffer((__gm__ half*)ys);
Capacity=8192;
if(p.route==WideDouble)Capacity=1024;
if(p.route==Compact || p.route==PersistentExpert)Capacity=2048;
if(p.route==TailStrip)Capacity=16384;
if(p.route==Interleaved)Capacity=4096;
if(p.route==LongReduction)Capacity=8448;
if(p.route==WideTail)Capacity=15360;
if(p.route==ShortGroupWave){
Capacity=(p.tm+1)/2*p.tn;uint32_t limit=(192*1024-256-8192-256)/2;
while(Capacity>2048 && Up(Capacity*8+Up(p.tn,8)*4+32,256)>limit)Capacity-=256;
}

bool alias=p.route==ShortGroupWave;
uint32_t bytes=Capacity*(alias?8:10)+(alias?Up(p.tn*4,256):2048);
if(p.route==PanelStriped || p.route==TailPanel || p.route==TailStrip || p.route==LongReduction || p.route==PersistentExpert || p.route==ShortGroupWave){
uint32_t size=Up(Capacity,p.route==LongReduction || p.route==PersistentExpert?512:(p.route==ShortGroupWave?256:64));
uint32_t pad=p.route==PanelStriped || p.route==TailPanel?256:0;
uint32_t bitmap=p.route==LongReduction || p.route==PersistentExpert?3*Up(size/8,256):(p.route==TailPanel?3*Up(size/8,512):0);
bytes=Up(size*(p.route==ShortGroupWave?8:10)+pad*2+bitmap+Up(p.tn,8)*4+32,256);
if(p.route==PanelStriped)bytes=Up(size*10+Up(p.tn,8)*4+1024+32,256);
}
pipe.InitBuffer(buf,bytes);
raw=buf.Get<int32_t>(); z=raw[Capacity].ReinterpretCast<float>();
u=raw.ReinterpretCast<float>(); f=u;out=(alias?z:z[Capacity]).ReinterpretCast<half>();
s=alias?z[Capacity]:out[Capacity].ReinterpretCast<float>();
if(p.route==PanelStriped || p.route==TailPanel || p.route==TailStrip || p.route==LongReduction || p.route==PersistentExpert || p.route==ShortGroupWave){
uint32_t size=Up(Capacity,p.route==LongReduction || p.route==PersistentExpert?512:(p.route==ShortGroupWave?256:64));
uint32_t pad=p.route==PanelStriped || p.route==TailPanel?64:0;
uint32_t bitmap=p.route==LongReduction || p.route==PersistentExpert?3*Up(size/8,256):(p.route==TailPanel?3*Up(size/8,512):0);
z=buf.Get<float>();
raw=z[size+pad].ReinterpretCast<int32_t>();u=raw.ReinterpretCast<float>();f=u;
out=raw[size+pad].ReinterpretCast<half>();
s=out[size+bitmap/2].ReinterpretCast<float>();
if(p.route==PanelStriped){s=raw[size+pad].ReinterpretCast<float>();out=s[Up(p.tn,8)].ReinterpretCast<half>();}
if(p.route==ShortGroupWave){out=z.ReinterpretCast<half>();s=raw[size].ReinterpretCast<float>();}
}
}
__aicore__ inline void AwaitInputReuse(){if(inputPending){WaitFlag<HardEvent::V_MTE2>(bankId);inputPending=false;}}
__aicore__ inline void Gelu(uint32_t count) {
SetMaskCount();SetVectorMask<float,MaskMode::COUNTER>(count);
Mul<float,false>(u,z,z,MASK_PLACEHOLDER,1,{1,1,1,8,8,8});PipeBarrier<PIPE_V>();
if(p.route==PersistentExpert || p.route==LongReduction){Mins<float,false>(u,u,256.0f,MASK_PLACEHOLDER,1,{1,1,8,8});PipeBarrier<PIPE_V>();}
Muls<float,false>(u,u,-0.07135481387376785f,MASK_PLACEHOLDER,1,{1,1,8,8});PipeBarrier<PIPE_V>();
Adds<float,false>(u,u,-1.5957691669464111f,MASK_PLACEHOLDER,1,{1,1,8,8});PipeBarrier<PIPE_V>();
Mul<float,false>(u,u,z,MASK_PLACEHOLDER,1,{1,1,1,8,8,8});PipeBarrier<PIPE_V>();
if(p.route!=PanelStriped && p.route!=TailPanel && p.route!=TailStrip && p.route!=ShortGroupWave){Mins<float,false>(u,u,80.0f,MASK_PLACEHOLDER,1,{1,1,8,8});PipeBarrier<PIPE_V>();}
Exp<float,false>(u,u,MASK_PLACEHOLDER,1,{1,1,8,8});PipeBarrier<PIPE_V>();
Adds<float,false>(u,u,1.0f,MASK_PLACEHOLDER,1,{1,1,8,8});PipeBarrier<PIPE_V>();
Div<float,false>(f,z,u,MASK_PLACEHOLDER,1,{1,1,1,8,8,8});PipeBarrier<PIPE_V>();SetMaskNorm();ResetMask();
if(outputBusy){Fence<HardEvent::MTE3_V>(bankId);outputBusy=false;}
if(p.route==TailStrip){uint32_t first=Min(count,8192);Cast(out,f,RoundMode::CAST_RINT,first);if(count>first)Cast(out[first],f[first],RoundMode::CAST_RINT,count-first);}
else Cast(out,f,RoundMode::CAST_RINT,count);PipeBarrier<PIPE_V>();
}
__aicore__ inline uint32_t PacketRows(uint32_t pitch) {return Capacity/pitch;}
__aicore__ inline void Consume(const WorkChunk &input,GlobalTensor<int32_t> scratch,uint64_t offset,uint32_t lane,uint32_t packetFirst=0,uint32_t packetLast=0,uint32_t freeFlag=0xffffffffu) {
WorkChunk t=input;
uint32_t halfRows=(t.rows+1)/2,first=Min(t.rows,halfRows*lane),last=Min(t.rows,halfRows*(lane+1)),colOffset=0;
if(p.route==WideDouble) {
uint32_t col=t.cols*lane/2,end=t.cols*(lane+1)/2;
t.col+=col;t.cols=end-col;colOffset=col;first=0;last=t.rows;
}
if(!t.cols || first>=last){if(freeFlag!=0xffffffffu)CrossCoreSetFlag<2,PIPE_MTE2>(freeFlag);return;}
AwaitInputReuse();
uint32_t pitch=Up(t.cols,32),step=Capacity/pitch,cpitch=(p.route==TailStrip || p.route==TailPanel)?Up(input.cols,32):p.tn;
if(packetLast){first=packetFirst;last=packetLast;}
uint32_t shift=ExchangeScaleShift(p);
if(!scaleReady || scaleTile.expert!=t.expert || scaleTile.col!=t.col || scaleTile.cols!=t.cols) {
DataCopyExtParams sc{1,t.cols*4,0,0,0};
DataCopyPad(s,scale[(uint64_t)t.expert*p.cols+t.col],sc,DataCopyPadExtParams<float>{false,0,0,0});
Fence<HardEvent::MTE2_V>(bankId+2);
if(shift){union{uint32_t u;float f;} factor;factor.u=(127+shift)<<23;Muls(s,s,factor.f,pitch);PipeBarrier<PIPE_V>();}
scaleTile=t;scaleReady=true;
}
for (uint32_t r=first;r<last;r+=step) {
if(r>first)AwaitInputReuse();
uint32_t nr=Min(step,last-r), count=nr*pitch;
if(p.route==ShortGroupWave && outputBusy){Fence<HardEvent::MTE3_V>(bankId);outputBusy=false;}
if(shift) {
GlobalTensor<half> compressed;compressed.SetGlobalBuffer((__gm__ half*)scratch.GetPhyAddr());
DataCopyExtParams rd{(uint16_t)nr,pitch*2,(cpitch-pitch)*2,0,0};
DataCopyPad(raw.ReinterpretCast<half>(),compressed[(p.route==WideDouble || p.route==RowResident || p.route==ColumnResident || p.route==WideTail || p.route==PersistentExpert || p.route==PanelStriped || p.route==TailStrip?offset:offset*2)+r*cpitch+colOffset],rd,DataCopyPadExtParams<half>{false,0,0,0});
if(freeFlag!=0xffffffffu && r+nr==last)CrossCoreSetFlag<2,PIPE_MTE2>(freeFlag);
Fence<HardEvent::MTE2_V>(bankId);
if(p.route==TailStrip){uint32_t first=Min(count,8192);Cast(z,raw.ReinterpretCast<half>(),RoundMode::CAST_NONE,first);if(count>first)Cast(z[first],raw.ReinterpretCast<half>()[first],RoundMode::CAST_NONE,count-first);}
else Cast(z,raw.ReinterpretCast<half>(),RoundMode::CAST_NONE,count);PipeBarrier<PIPE_V>();
} else {
DataCopyExtParams rd{(uint16_t)nr,pitch*4,(cpitch-pitch)*4,0,0};
DataCopyPad(raw,scratch[offset+r*cpitch+colOffset],rd,DataCopyPadExtParams<int32_t>{false,0,0,0});
if(freeFlag!=0xffffffffu && r+nr==last)CrossCoreSetFlag<2,PIPE_MTE2>(freeFlag);
Fence<HardEvent::MTE2_V>(bankId);
Cast(z,raw,RoundMode::CAST_NONE,count);PipeBarrier<PIPE_V>();
}
for(uint32_t col=0;col<pitch;col+=64)
Mul(z[col],z[col],s[col],(uint64_t)Min(64,pitch-col),(uint8_t)nr,{1,1,1,(uint8_t)(pitch/8),(uint8_t)(pitch/8),0});
PipeBarrier<PIPE_V>(); Gelu(count);
Fence<HardEvent::V_MTE3>(bankId);
DataCopyExtParams wr{(uint16_t)nr,t.cols*2,(pitch-t.cols)*2/32,(p.cols-t.cols)*2,0};

wr.srcStride=(pitch*2-Up(t.cols*2,32))/32;
DataCopyPad(y[(uint64_t)(t.row+r)*p.cols+t.col],out,wr);
outputBusy=true;
SetFlag<HardEvent::V_MTE2>(bankId);inputPending=true;
}
}
__aicore__ inline void Drain() { AwaitInputReuse();if(outputBusy){Fence<HardEvent::MTE3_V>(bankId);outputBusy=false;} }
__aicore__ inline void BeginTiny(uint32_t count) {
Duplicate(z,0.0f,Up(count,8)); Fence<HardEvent::V_S>(bankId);
}
__aicore__ inline void TinyInputs(uint32_t index,float left,float right) {
u.SetValue(index,left);out.ReinterpretCast<float>().SetValue(index,right);
}
__aicore__ inline void TinyAccumulate(uint32_t count) {
Fence<HardEvent::S_V>(bankId); MulAddDst(z,u,out.ReinterpretCast<float>(),count); Fence<HardEvent::V_S>(bankId);
}
__aicore__ inline void TinyScale(uint32_t index,float value) { u.SetValue(index,value); }
__aicore__ inline void FinishTiny(uint32_t count) {
Fence<HardEvent::S_V>(bankId);Mul(z,z,u,count);PipeBarrier<PIPE_V>();Gelu(Up(count,8));
Fence<HardEvent::V_MTE3>(bankId);DataCopyPad(y,out,DataCopyExtParams{1,count*2,0,0,0});
Fence<HardEvent::MTE3_V>(bankId);
}
__aicore__ inline void ScalarResult(float value,uint64_t index) {
Duplicate(z,0.0f,8); Fence<HardEvent::V_S>(bankId);
z.SetValue(0,value); Fence<HardEvent::S_V>(bankId); Gelu(8);
Fence<HardEvent::V_MTE3>(bankId);
DataCopyPad(y[index],out,DataCopyExtParams{1,2,0,0,0});
Fence<HardEvent::MTE3_V>(bankId);
}
};

__aicore__ inline void ConsumeDual(VectorEpilogue &first,VectorEpilogue &second,ExecutionShape p,const WorkChunk &tile,GlobalTensor<int32_t> scratch,uint64_t offset,uint32_t lane,uint32_t &packet,uint32_t freeFlag) {
uint32_t halfRows=(tile.rows+1)/2,begin=Min(tile.rows,halfRows*lane),end=Min(tile.rows,halfRows*(lane+1)),width=tile.cols;
if(p.route==WideDouble){begin=0;end=tile.rows;width=tile.cols*(lane+1)/2-tile.cols*lane/2;}
if(!width || begin>=end){CrossCoreSetFlag<2,PIPE_MTE2>(freeFlag);return;}
uint32_t step=first.PacketRows(Up(width,32));
for(uint32_t row=begin;row<end;row+=step,++packet) {
uint32_t release=row+step>=end?freeFlag:0xffffffffu;
if(packet&1)second.Consume(tile,scratch,offset,lane,row,Min(row+step,end),release);
else first.Consume(tile,scratch,offset,lane,row,Min(row+step,end),release);
}
}

__aicore__ inline bool ShallowFullEligible(ExecutionShape p){
uint32_t reduction=Up(p.depth,32);
return p.ck==reduction && (uint64_t)p.tm*reduction<=64*1024 && (uint64_t)p.tn*reduction<=64*1024 &&
(uint64_t)p.tm*p.tn*4<=128*1024 && (uint64_t)2*(p.tm+p.tn)*reduction<=496*1024;
}
class ShallowMatrix {
ExecutionShape p;GlobalTensor<int8_t> x,w;GlobalTensor<half> exchange;
TBuf<TPosition::A1> memory;TBuf<TPosition::A2> left;TBuf<TPosition::B2> right;TBuf<TPosition::CO1> result;
LocalTensor<int8_t> a1,b1,a0,b0;LocalTensor<int32_t> c0;
Nd2NzParams fixedA{},fixedB{};MmadParams fixedMmad{};FixpipeParamsV220 fixedFix{};
uint32_t reduction,slot=0,featureRows=0;uint64_t savedCtrl;bool primed=false,published=false;
__aicore__ inline void Issue(const WorkChunk &t,uint32_t at){
WaitFlag<HardEvent::MTE1_MTE2>(at);
Nd2NzParams a=fixedA;
if(t.rows!=p.tm){a.nValue=t.rows;a.dstNzC0Stride=Up(t.rows,16);}
DataCopy(a1[at*p.tm*reduction],x[(uint64_t)t.row*p.depth],a);SetFlag<HardEvent::MTE2_MTE1>(at);
WaitFlag<HardEvent::MTE1_MTE2>(2+at);
Nd2NzParams b=fixedB;b.dValue=t.cols;
DataCopy(b1[at*p.tn*reduction],w[(uint64_t)t.expert*p.depth*p.cols+t.col],b);SetFlag<HardEvent::MTE2_MTE1>(2+at);
}
public:
__aicore__ inline ShallowMatrix(TPipe &pipe,ExecutionShape plan,GM_ADDR xs,GM_ADDR ws,GM_ADDR workspace):p(plan){
x.SetGlobalBuffer((__gm__ int8_t*)xs);w.SetGlobalBuffer((__gm__ int8_t*)ws);exchange.SetGlobalBuffer((__gm__ half*)workspace);
reduction=Up(p.depth,32);savedCtrl=get_ctrl();
pipe.InitBuffer(memory,2*(p.tm+p.tn)*reduction);pipe.InitBuffer(left,p.tm*reduction);
pipe.InitBuffer(right,p.tn*reduction);pipe.InitBuffer(result,p.tm*p.tn*4);
a1=memory.Get<int8_t>();b1=a1[2*p.tm*reduction];a0=left.Get<int8_t>();b0=right.Get<int8_t>();c0=result.Get<int32_t>();
fixedA.ndNum=1;fixedA.nValue=p.tm;fixedA.dValue=p.depth;fixedA.srcDValue=p.depth;fixedA.dstNzC0Stride=p.tm;fixedA.dstNzNStride=1;
fixedB.ndNum=1;fixedB.nValue=p.depth;fixedB.dValue=p.tn;fixedB.srcDValue=p.cols;fixedB.dstNzC0Stride=reduction;fixedB.dstNzNStride=1;
fixedMmad.m=p.tm;fixedMmad.n=p.tn;fixedMmad.k=p.depth;fixedMmad.cmatrixInitVal=true;fixedMmad.unitFlag=3;
fixedFix.mSize=p.tm;fixedFix.nSize=p.tn;fixedFix.srcStride=p.tm;fixedFix.dstStride=p.tn;fixedFix.unitFlag=3;
fixedFix.quantPre=QuantMode_t::DEQF16;fixedFix.deqScalar=(uint64_t)(127-ExchangeScaleShift(p))<<23;
SetLoadDataRepeat({0,1,0});SetLoadDataPaddingValue<int8_t>(0);
SetMMRowMajor();LocalTensor<uint64_t> reset(TPosition::C2PIPE2GM,0,1);SetFixPipeConfig(reset,true);PipeBarrier<PIPE_ALL>();
for(uint32_t i=0;i<2;++i){SetFlag<HardEvent::MTE1_MTE2>(i);SetFlag<HardEvent::MTE1_MTE2>(2+i);}
SetFlag<HardEvent::M_MTE1>(4);
}
__aicore__ inline void Compute(const WorkChunk &t,const WorkChunk *future){
if(!primed){slot=0;Issue(t,slot);primed=true;}
uint32_t ma=Up(t.rows,16),na=Up(t.cols,32);
WaitFlag<HardEvent::MTE2_MTE1>(slot);WaitFlag<HardEvent::MTE2_MTE1>(2+slot);WaitFlag<HardEvent::M_MTE1>(4);
if(featureRows!=ma){uint8_t pads[4]={0,0,0,0};SetFmatrix(1,ma,pads,FmatrixMode::FMATRIX_LEFT);featureRows=ma;}
LoadData3DParamsV2<int8_t> a{};a.l1H=1;a.l1W=ma;a.channelSize=reduction;a.kExtension=reduction;a.mExtension=ma;
a.strideW=1;a.strideH=1;a.filterW=1;a.filterH=1;a.dilationFilterW=1;a.dilationFilterH=1;
LoadData<int8_t,A_LOAD_CONFIG>(a0,a1[slot*p.tm*reduction],a);
LoadData2dTransposeParams b{};b.repeatTimes=reduction/32;b.srcStride=1;b.dstGap=na/16-1;
for(uint32_t n=0;n<na/32;++n)LoadDataWithTranspose(b0[n*1024],b1[slot*p.tn*reduction+n*reduction*32],b);
Fence<HardEvent::MTE1_M>();
MmadParams mm=fixedMmad;mm.m=ma;mm.n=na;Mmad(c0,a0,b0,mm);
if((ma/16)*(na/16)<10)PipeBarrier<PIPE_M>();
SetFlag<HardEvent::M_MTE1>(4);SetFlag<HardEvent::MTE1_MTE2>(slot);SetFlag<HardEvent::MTE1_MTE2>(2+slot);
if(future){slot^=1;Issue(*future,slot);}else primed=false;
}
__aicore__ inline void Publish(const WorkChunk &t,uint64_t offset){
FixpipeParamsV220 fp=fixedFix;fp.mSize=Up(t.rows,16);fp.nSize=Up(t.cols,32);fp.srcStride=Up(t.rows,16);
Fixpipe<half,int32_t,CFG_ROW_MAJOR>(exchange[offset*2],c0,fp);published=true;
}
__aicore__ inline void Finish(){
if(published)Fence<HardEvent::FIX_M>();
WaitFlag<HardEvent::M_MTE1>(4);
for(uint32_t i=0;i<2;++i){WaitFlag<HardEvent::MTE1_MTE2>(i);WaitFlag<HardEvent::MTE1_MTE2>(2+i);}
PipeBarrier<PIPE_ALL>();set_ctrl(savedCtrl);
}
};

class ShallowActivation {
ExecutionShape p;GlobalTensor<float> scales;GlobalTensor<half> y,exchange;
TBuf<TPosition::VECCALC> memory;LocalTensor<float> z,raw,gain;LocalTensor<half> output;
uint32_t capacity,event,rows=0,pitch=0;WorkChunk held{};bool inputBusy=false,outputBusy=false;
public:
__aicore__ inline ShallowActivation(TPipe &pipe,ExecutionShape plan,GM_ADDR ss,GM_ADDR ys,GM_ADDR workspace,uint32_t id):p(plan),event(id){
scales.SetGlobalBuffer((__gm__ float*)ss);y.SetGlobalBuffer((__gm__ half*)ys);exchange.SetGlobalBuffer((__gm__ half*)workspace);
capacity=Min(8192,Up((p.tm+1)/2*p.tn,512));uint32_t bitmap=Up(capacity/8,256);
uint32_t bytes=Up(capacity*10+3*bitmap+Up(p.tn,8)*4+32+768,256);pipe.InitBuffer(memory,bytes);
z=memory.Get<float>();raw=z[capacity+64];output=raw[capacity+64].ReinterpretCast<half>();
gain=output[capacity+(3*bitmap+256)/2].ReinterpretCast<float>();
}
__aicore__ inline uint32_t Rows(uint32_t width){return capacity/Up(width,32);}
__aicore__ inline void Begin(const WorkChunk &t){
if(inputBusy){WaitFlag<HardEvent::V_MTE2>(event);inputBusy=false;}
DataCopyPad(gain,scales[(uint64_t)t.expert*p.cols+t.col],DataCopyExtParams{1,t.cols*4,0,0,0},DataCopyPadExtParams<float>{false,0,0,0});
}
__aicore__ inline void Read(const WorkChunk &t,uint64_t offset,uint32_t first,uint32_t count,uint32_t release){
held=t;held.row+=first;held.rows=count;rows=count;pitch=Up(t.cols,32);
DataCopyExtParams read{(uint16_t)count,pitch*2,(p.tn-pitch)*2,0,0};
DataCopyPad(raw.ReinterpretCast<half>(),exchange[offset*2+first*p.tn],read,DataCopyPadExtParams<half>{false,0,0,0});
SetFlag<HardEvent::MTE2_V>(event);if(release!=0xffffffffu)CrossCoreSetFlag<2,PIPE_MTE2>(release);
}
__aicore__ inline void Prepare(){
WaitFlag<HardEvent::MTE2_V>(event);uint32_t count=rows*pitch;
union{uint32_t u;float f;} multiplier;multiplier.u=(127+ExchangeScaleShift(p))<<23;
Muls(gain,gain,multiplier.f,pitch);Cast(z,raw.ReinterpretCast<half>(),RoundMode::CAST_NONE,count);PipeBarrier<PIPE_V>();
for(uint32_t n=0;n<pitch;n+=64)Mul(z[n],z[n],gain[n],(uint64_t)Min(64,pitch-n),(uint8_t)rows,{1,1,1,(uint8_t)(pitch/8),(uint8_t)(pitch/8),0});
PipeBarrier<PIPE_V>();SetMaskCount();SetVectorMask<float,MaskMode::COUNTER>(count);
Mul<float,false>(raw,z,z,MASK_PLACEHOLDER,1,{1,1,1,8,8,8});PipeBarrier<PIPE_V>();
Muls<float,false>(raw,raw,-0.07135481387376785f,MASK_PLACEHOLDER,1,{1,1,8,8});PipeBarrier<PIPE_V>();
Adds<float,false>(raw,raw,-1.5957691669464111f,MASK_PLACEHOLDER,1,{1,1,8,8});PipeBarrier<PIPE_V>();
Mul<float,false>(raw,raw,z,MASK_PLACEHOLDER,1,{1,1,1,8,8,8});PipeBarrier<PIPE_V>();
Exp<float,false>(raw,raw,MASK_PLACEHOLDER,1,{1,1,8,8});PipeBarrier<PIPE_V>();
Adds<float,false>(raw,raw,1.0f,MASK_PLACEHOLDER,1,{1,1,8,8});PipeBarrier<PIPE_V>();
Div<float,false>(raw,z,raw,MASK_PLACEHOLDER,1,{1,1,1,8,8,8});PipeBarrier<PIPE_V>();SetMaskNorm();ResetMask();
if(outputBusy){WaitFlag<HardEvent::MTE3_V>(event);outputBusy=false;}
Cast(output,raw,RoundMode::CAST_RINT,count);SetFlag<HardEvent::V_MTE3>(event);
SetFlag<HardEvent::V_MTE2>(event);inputBusy=true;
}
__aicore__ inline void Store(){
WaitFlag<HardEvent::V_MTE3>(event);
DataCopyExtParams write{(uint16_t)rows,held.cols*2,(pitch*2-Up(held.cols*2,32))/32,(p.cols-held.cols)*2,0};
DataCopyPad(y[(uint64_t)held.row*p.cols+held.col],output,write);SetFlag<HardEvent::MTE3_V>(event);outputBusy=true;
}
__aicore__ inline void Drain(){if(inputBusy)WaitFlag<HardEvent::V_MTE2>(event);if(outputBusy)WaitFlag<HardEvent::MTE3_V>(event);}
};

__aicore__ inline void ShallowFlow(GM_ADDR xs,GM_ADDR ws,GM_ADDR ss,GM_ADDR gs,GM_ADDR ys,GM_ADDR workspace,ExecutionShape p){
uint32_t core=GetBlockIdx();if ASCEND_IS_AIV{core/=2;}
WorkIterator<ShallowResident> cursor(p,gs,core);WorkChunk tile{};uint32_t serial=0;TPipe pipe;
if ASCEND_IS_AIC{
ShallowMatrix matrix(pipe,p,xs,ws,workspace);
bool active=cursor.Next(tile);
while(active){
WorkChunk future{};bool more=cursor.Next(future);matrix.Compute(tile,more?&future:nullptr);uint32_t slot=serial%p.ring;
if(serial>=p.ring)CrossCoreWaitFlag<2>(p.ring+slot);
matrix.Publish(tile,((uint64_t)core*p.ring+slot)*p.tm*p.tn);CrossCoreSetFlag<2,PIPE_FIX>(slot);++serial;
tile=future;active=more;
}
for(uint32_t i=serial-Min(serial,p.ring);i<serial;++i)CrossCoreWaitFlag<2>(p.ring+i%p.ring);
matrix.Finish();
}
if ASCEND_IS_AIV{
ShallowActivation first(pipe,p,ss,ys,workspace,0),second(pipe,p,ss,ys,workspace,1);
ShallowActivation *held=nullptr;uint32_t packet=0;
while(cursor.Next(tile)){
uint32_t slot=serial%p.ring,halfRows=(tile.rows+1)/2,begin=Min(tile.rows,halfRows*(GetBlockIdx()%2)),end=Min(tile.rows,begin+halfRows);
if(begin>=end){CrossCoreWaitFlag<2>(slot);CrossCoreSetFlag<2,PIPE_MTE2>(p.ring+slot);++serial;continue;}
uint32_t step=first.Rows(tile.cols);
for(uint32_t row=begin;row<end;row+=step,++packet){
ShallowActivation &current=packet&1?second:first;current.Begin(tile);if(row==begin)CrossCoreWaitFlag<2>(slot);
uint32_t nr=Min(step,end-row);current.Read(tile,((uint64_t)core*p.ring+slot)*p.tm*p.tn,row,nr,row+nr==end?p.ring+slot:0xffffffffu);current.Prepare();
if(held)held->Store();held=&current;
}
++serial;
}
if(held)held->Store();first.Drain();second.Drain();
}
}

template<uint32_t Mode>
class ResidentBank {
ExecutionShape p;GlobalTensor<float> scales;GlobalTensor<half> y,exchange;
TBuf<TPosition::VECCALC> memory;LocalTensor<float> z,raw,gain,gain4;LocalTensor<half> output,input;
uint32_t capacity,event,rows=0,pitch=0,sharedEvent=0xffffffffu;WorkChunk held{},cached{};
bool inputBusy=false,outputBusy=false,scaleReady=false,scaleLoad=false;
public:
__aicore__ inline ResidentBank(TPipe &pipe,ExecutionShape plan,GM_ADDR ss,GM_ADDR ys,GM_ADDR workspace,uint32_t id):p(plan),event(id){
scales.SetGlobalBuffer((__gm__ float*)ss);y.SetGlobalBuffer((__gm__ half*)ys);exchange.SetGlobalBuffer((__gm__ half*)workspace);
capacity=Mode==WideDouble?1024:8192;
if constexpr(Mode==ColumnResident){uint32_t stride=Up(capacity*10+Up(p.tn,8)*4+1056,256);if(2*stride+capacity*2+Up(p.experts,4)*8>192*1024-256-8192)capacity=4096;}
uint32_t bytes;
if constexpr(Mode==WideDouble)bytes=Up(capacity*10+3*Up(capacity/8,256)+Up(p.tn,8)*20+32,256);
else if constexpr(Mode==ColumnResident)bytes=Up(capacity*10+Up(p.tn,8)*4+1056,256);
else bytes=Up(capacity*10+3*Up(capacity/8,256)+Up(p.tn,8)*4+32,256);
pipe.InitBuffer(memory,bytes);z=memory.Get<float>();
if constexpr(Mode==ColumnResident){raw=z[capacity+64];gain=raw[capacity+64];output=gain[Up(p.tn,8)].ReinterpretCast<half>();}
else{raw=z[capacity];output=raw[capacity].ReinterpretCast<half>();gain=output[capacity+(Mode==WideDouble?0:3*Up(capacity/8,256)/2)].ReinterpretCast<float>();gain4=gain[Up(p.tn,8)];}
input=raw.ReinterpretCast<half>();
}
__aicore__ inline uint32_t Capacity(){return capacity;}
__aicore__ inline void Shared(LocalTensor<half> source){input=source;sharedEvent=2;}
__aicore__ inline void Begin(const WorkChunk &t){
if(inputBusy){WaitFlag<HardEvent::V_MTE2>(event);inputBusy=false;}
scaleLoad=!scaleReady || cached.expert!=t.expert || cached.col!=t.col || cached.cols!=t.cols;
if(scaleLoad){DataCopyPad(gain,scales[(uint64_t)t.expert*p.cols+t.col],DataCopyExtParams{1,t.cols*4,0,0,0},DataCopyPadExtParams<float>{false,0,0,0});cached=t;}
}
__aicore__ inline void Read(const WorkChunk &t,uint64_t offset,uint32_t first,uint32_t column,uint32_t count,uint32_t release){
held=t;held.row+=first;held.rows=count;rows=count;pitch=Up(t.cols,32);
DataCopyExtParams copy{(uint16_t)count,pitch*2,(p.tn-pitch)*2,0,0};
DataCopyPad(input,exchange[offset+first*p.tn+column],copy,DataCopyPadExtParams<half>{false,0,0,0});
SetFlag<HardEvent::MTE2_V>(event);if(release!=0xffffffffu)CrossCoreSetFlag<2,PIPE_MTE2>(release);
}
__aicore__ inline void Prepare(){
WaitFlag<HardEvent::MTE2_V>(event);uint32_t count=rows*pitch;
Cast(z,input,RoundMode::CAST_NONE,count);PipeBarrier<PIPE_V>();
if(sharedEvent!=0xffffffffu)SetFlag<HardEvent::V_MTE2>(sharedEvent);
if(scaleLoad){
union{uint32_t u;float f;} multiplier;multiplier.u=(127+ExchangeScaleShift(p))<<23;
Muls(gain,gain,multiplier.f,pitch);PipeBarrier<PIPE_V>();
if constexpr(Mode==WideDouble){for(uint32_t r=0;r<4;++r)Adds(gain4[r*pitch],gain,0.0f,pitch);PipeBarrier<PIPE_V>();}
scaleReady=true;scaleLoad=false;
}
if constexpr(Mode==WideDouble){
if(pitch==held.cols && pitch%64==0 && rows<=4 && count/64<=255)Mul(z,z,gain4,(uint64_t)64,(uint8_t)(count/64),{1,1,1,8,8,8});
else for(uint32_t n=0;n<pitch;n+=64)Mul(z[n],z[n],gain[n],(uint64_t)Min(64,pitch-n),(uint8_t)rows,{1,1,1,(uint8_t)(pitch/8),(uint8_t)(pitch/8),0});
}else for(uint32_t n=0;n<pitch;n+=64)Mul(z[n],z[n],gain[n],(uint64_t)Min(64,pitch-n),(uint8_t)rows,{1,1,1,(uint8_t)(pitch/8),(uint8_t)(pitch/8),0});
PipeBarrier<PIPE_V>();SetMaskCount();SetVectorMask<float,MaskMode::COUNTER>(count);
Mul<float,false>(raw,z,z,MASK_PLACEHOLDER,1,{1,1,1,8,8,8});if constexpr(Mode!=WideDouble)PipeBarrier<PIPE_V>();
Muls<float,false>(raw,raw,-0.07135481387376785f,MASK_PLACEHOLDER,1,{1,1,8,8});if constexpr(Mode!=WideDouble)PipeBarrier<PIPE_V>();
Adds<float,false>(raw,raw,-1.5957691669464111f,MASK_PLACEHOLDER,1,{1,1,8,8});if constexpr(Mode!=WideDouble)PipeBarrier<PIPE_V>();
Mul<float,false>(raw,raw,z,MASK_PLACEHOLDER,1,{1,1,1,8,8,8});if constexpr(Mode!=WideDouble)PipeBarrier<PIPE_V>();
Exp<float,false>(raw,raw,MASK_PLACEHOLDER,1,{1,1,8,8});if constexpr(Mode!=WideDouble)PipeBarrier<PIPE_V>();
Adds<float,false>(raw,raw,1.0f,MASK_PLACEHOLDER,1,{1,1,8,8});if constexpr(Mode!=WideDouble)PipeBarrier<PIPE_V>();
Div<float,false>(raw,z,raw,MASK_PLACEHOLDER,1,{1,1,1,8,8,8});if constexpr(Mode!=WideDouble)PipeBarrier<PIPE_V>();SetMaskNorm();ResetMask();
if(outputBusy){WaitFlag<HardEvent::MTE3_V>(event);outputBusy=false;}
Cast(output,raw,RoundMode::CAST_RINT,count);SetFlag<HardEvent::V_MTE3>(event);
SetFlag<HardEvent::V_MTE2>(event);inputBusy=true;
}
__aicore__ inline void Store(){
WaitFlag<HardEvent::V_MTE3>(event);uint32_t step=Mode==ColumnResident?Min(rows,4096/pitch):rows;if(!step)step=1;
for(uint32_t r=0;r<rows;r+=step){uint32_t nr=Min(step,rows-r);DataCopyExtParams copy{(uint16_t)nr,held.cols*2,(pitch*2-Up(held.cols*2,32))/32,(p.cols-held.cols)*2,0};DataCopyPad(y[(uint64_t)(held.row+r)*p.cols+held.col],output[r*pitch],copy);}
SetFlag<HardEvent::MTE3_V>(event);outputBusy=true;
}
__aicore__ inline void Drain(){if(inputBusy)WaitFlag<HardEvent::V_MTE2>(event);if(outputBusy)WaitFlag<HardEvent::MTE3_V>(event);}
};
template<uint32_t Mode>
class ResidentConsumer {
ExecutionShape p;ResidentBank<Mode> first,second;ResidentBank<Mode> *held=nullptr;uint32_t packet=0;
TBuf<TPosition::VECCALC> shared;bool sharedPending=false;
public:
__aicore__ inline ResidentConsumer(TPipe &pipe,ExecutionShape plan,GM_ADDR ss,GM_ADDR ys,GM_ADDR workspace):p(plan),first(pipe,plan,ss,ys,workspace,0),second(pipe,plan,ss,ys,workspace,1){
if constexpr(Mode==ColumnResident){pipe.InitBuffer(shared,first.Capacity()*2);auto input=shared.Get<half>();first.Shared(input);second.Shared(input);}
}
__aicore__ inline void Process(const WorkChunk &tile,uint64_t offset,uint32_t slot,uint32_t lane){
WorkChunk part=tile;uint32_t begin,end,column=0;
if constexpr(Mode==WideDouble){column=tile.cols*lane/2;part.col+=column;part.cols=tile.cols*(lane+1)/2-column;begin=0;end=tile.rows;}
else{uint32_t halfRows=(tile.rows+1)/2;begin=Min(tile.rows,halfRows*lane);end=Min(tile.rows,begin+halfRows);}
if(!part.cols || begin>=end){CrossCoreWaitFlag<2>(slot);CrossCoreSetFlag<2,PIPE_MTE2>(p.ring+slot);return;}
uint32_t step=first.Capacity()/Up(part.cols,32);if(!step)step=1;
for(uint32_t row=begin;row<end;row+=step,++packet){
if constexpr(Mode==WideDouble){if(held){held->Store();held=nullptr;}}
auto &current=packet&1?second:first;current.Begin(part);if(row==begin)CrossCoreWaitFlag<2>(slot);
if constexpr(Mode==ColumnResident){if(sharedPending){WaitFlag<HardEvent::V_MTE2>(2);sharedPending=false;}}
uint32_t count=Min(step,end-row);current.Read(part,offset,row,column,count,row+count==end?p.ring+slot:0xffffffffu);current.Prepare();
if constexpr(Mode==ColumnResident)sharedPending=true;
if(held)held->Store();held=&current;
}
}
__aicore__ inline void Finish(){if(held)held->Store();if constexpr(Mode==ColumnResident){if(sharedPending)WaitFlag<HardEvent::V_MTE2>(2);}first.Drain();second.Drain();}
};

struct InterleavedBank {
LocalTensor<int32_t> accum;LocalTensor<float> z,u,tail,result;LocalTensor<half> output;
uint32_t event;bool inputBusy=false,outputBusy=false;WorkChunk held{};uint32_t pitch=0;
__aicore__ inline void Init(LocalTensor<uint8_t> memory,uint32_t id){
event=id;accum=memory.ReinterpretCast<int32_t>();z=accum[4096].ReinterpretCast<float>();u=z[4096];tail=u[4096];result=tail[4096];output=result[4096+512].ReinterpretCast<half>();
}
__aicore__ inline void AwaitInput(){if(inputBusy){WaitFlag<HardEvent::V_MTE2>(event);inputBusy=false;}}
__aicore__ inline void Prepare(uint32_t count){
SetMaskCount();SetVectorMask<float,MaskMode::COUNTER>(count);
Mul<float,false>(u,z,z,MASK_PLACEHOLDER,1,{1,1,1,8,8,8});Duplicate<float,false>(tail,-1.5957691669464111f,MASK_PLACEHOLDER,1,1,8);PipeBarrier<PIPE_V>();
Axpy<float,float,false>(tail,u,-0.07135481387376785f,MASK_PLACEHOLDER,1,{1,1,8,8});PipeBarrier<PIPE_V>();
Mul<float,false>(tail,tail,z,MASK_PLACEHOLDER,1,{1,1,1,8,8,8});PipeBarrier<PIPE_V>();
Mins<float,false>(tail,tail,80.0f,MASK_PLACEHOLDER,1,{1,1,8,8});PipeBarrier<PIPE_V>();
Exp<float,false>(tail,tail,MASK_PLACEHOLDER,1,{1,1,8,8});PipeBarrier<PIPE_V>();
Adds<float,false>(result,tail,1.0f,MASK_PLACEHOLDER,1,{1,1,8,8});PipeBarrier<PIPE_V>();
Div<float,false>(result,z,result,MASK_PLACEHOLDER,1,{1,1,1,8,8,8});PipeBarrier<PIPE_V>();SetMaskNorm();ResetMask();
if(outputBusy){WaitFlag<HardEvent::MTE3_V>(event);outputBusy=false;}
Cast(output,result,RoundMode::CAST_RINT,count);SetFlag<HardEvent::V_MTE3>(event);
}
__aicore__ inline void Store(GlobalTensor<half> y,ExecutionShape p){
WaitFlag<HardEvent::V_MTE3>(event);
DataCopyPad(y[(uint64_t)held.row*p.cols+held.col],output,DataCopyExtParams{(uint16_t)held.rows,held.cols*2,(pitch*2-Up(held.cols*2,32))/32,(p.cols-held.cols)*2,0});
SetFlag<HardEvent::MTE3_V>(event);outputBusy=true;
}
__aicore__ inline void Drain(){AwaitInput();if(outputBusy)WaitFlag<HardEvent::MTE3_V>(event);}
};
__aicore__ inline void ConsumeInterleaved(TPipe &pipe,WorkIterator<Interleaved> &cursor,ExecutionShape p,GM_ADDR ss,GM_ADDR ys,GM_ADDR workspace,uint32_t core){
GlobalTensor<int32_t> exchange;GlobalTensor<float> scales;GlobalTensor<half> y;
exchange.SetGlobalBuffer((__gm__ int32_t*)workspace);scales.SetGlobalBuffer((__gm__ float*)ss);y.SetGlobalBuffer((__gm__ half*)ys);
uint32_t stride=Up(4096*22+Up(p.tn,8)*4+512+32,256);TBuf<TPosition::VECCALC> memory;pipe.InitBuffer(memory,2*stride+Up(p.tn,8)*4);
