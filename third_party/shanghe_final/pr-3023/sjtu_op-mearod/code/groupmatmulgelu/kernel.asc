__aicore__ inline void Finish(){if(units || Mode==TailStrip){Fence<HardEvent::FIX_M>();PipeBarrier<PIPE_ALL>();set_ctrl(savedMatrixCtrl);}}
};

template<>
class CubeExecutor<WideTail> {
static constexpr uint32_t Mode=WideTail;
