}
__aicore__ inline void ReadA(const WorkChunk &t,uint32_t k,uint32_t count,uint32_t slot,uint32_t ma) {
if(packed) {
uint32_t mp=Up(p.rows,64);
DataCopyParams d{};d.blockCount=Up(count,32)/32;d.blockLen=ma;d.srcStride=mp-ma;
DataCopy(a1[slot*p.tm*p.ck],x[(uint64_t)k*mp+t.row*32],d);return;
}
Nd2NzParams d{}; d.ndNum=1; d.nValue=t.rows; d.dValue=count;
d.srcDValue=p.depth; d.dstNzC0Stride=ma; d.dstNzNStride=1;
