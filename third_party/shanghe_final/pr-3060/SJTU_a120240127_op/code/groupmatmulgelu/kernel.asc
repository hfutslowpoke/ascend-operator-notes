#define K_MAX_SHAPE_DIM 0
#include "kernel_operator.h"
#include "acl/acl.h"
#include <cstdlib>

namespace gmmStream {
using namespace AscendC;
constexpr uint32_t TM = 64, TN = 256, TK = 256;
constexpr uint16_t READY = 4, DONE = 8;
constexpr uint32_t OUTPUT_SLOTS=3;

template <HardEvent event>
__aicore__ inline void Fence()
{
    SetFlag<event>(EVENT_ID0);
    WaitFlag<event>(EVENT_ID0);
}

__aicore__ inline uint32_t Min(uint32_t a, uint32_t b) { return a < b ? a : b; }

__aicore__ inline void LoadPanel(GlobalTensor<int8_t> a, GlobalTensor<int8_t> b,
    uint32_t rows, uint32_t cols, uint32_t k, uint32_t n, uint32_t panel, uint32_t span)
{
    const uint32_t slot = panel % 2;
    const event_t ev = slot ? EVENT_ID3 : EVENT_ID2;
    if (panel >= 2) WaitFlag<HardEvent::MTE1_MTE2>(ev);
    LocalTensor<int8_t> a1(TPosition::A1, slot * 163840, TM * span);
    LocalTensor<int8_t> b1(TPosition::A1, slot * 163840 + 32768, span * TN);
    const uint32_t depth = Min(span, k - panel * span);
    if (depth != span) {
        InitConstValue(a1.ReinterpretCast<uint32_t>(), InitConstValueParams<uint32_t>{1, uint16_t(TM * span / 32), 0, 0});
        InitConstValue(b1.ReinterpretCast<uint32_t>(), InitConstValueParams<uint32_t>{1, uint16_t(span * TN / 32), 0, 0});
        PipeBarrier<PIPE_MTE2>();
    }
    Nd2NzParams ap{1, uint16_t(rows), uint16_t(depth), 0, uint16_t(k), TM, 1, 0};
    Nd2NzParams bp{1, uint16_t(depth), uint16_t(cols), 0, uint16_t(n), uint16_t(span), 1, 0};
    DataCopy(a1, a[panel * span], ap);
    DataCopy(b1, b[uint64_t(panel * span) * n], bp);
    SetFlag<HardEvent::MTE2_MTE1>(ev);
}

__aicore__ inline void ResidentTile(GlobalTensor<int8_t> a, GlobalTensor<int8_t> b,
    GlobalTensor<int32_t> scratch, uint32_t rows, uint32_t cols, uint32_t k, uint32_t n, uint16_t readyFlag)
{
    const uint32_t actualRows=(rows+15)/16*16;
    constexpr uint32_t STEP = 128;
    const uint32_t span = k >= 512 ? 512 : 256;
    const uint32_t panels = (k + span - 1) / span;
    LocalTensor<int32_t> c0(TPosition::CO1, 0, TM * TN);
    LoadPanel(a,b,rows,cols,k,n,0,span);
    for (uint32_t panel = 0; panel < panels; ++panel) {
        const uint32_t bank=panel%2;
        WaitFlag<HardEvent::MTE2_MTE1>(bank ? EVENT_ID3 : EVENT_ID2);
        if (panel + 1 < panels) LoadPanel(a,b,rows,cols,k,n,panel+1,span);
        LocalTensor<int8_t> a1(TPosition::A1, bank * 163840, TM * span);
        LocalTensor<int8_t> b1(TPosition::A1, bank * 163840 + 32768, span * TN);
        for (uint32_t start = 0; start < span; start += STEP) {
            const uint32_t chunk=panel*(span/STEP)+start/STEP;
            const uint32_t slot=chunk%2;
            const event_t ev=slot ? EVENT_ID1 : EVENT_ID0;
            if (chunk >= 2) WaitFlag<HardEvent::M_MTE1>(ev);
            LocalTensor<int8_t> a0(TPosition::A2, slot * TM * STEP, TM * STEP);
            LocalTensor<int8_t> b0(TPosition::B2, slot * STEP * TN, STEP * TN);
            LoadData2DParams loadA;
            loadA.repeatTimes=STEP/32; loadA.srcStride=TM/16;
            for(uint32_t m=0;m<actualRows/16;++m)
                LoadData(a0[m*STEP*16],a1[start*TM+m*512],loadA);
            LoadData2dTransposeParams loadB;
            loadB.repeatTimes=STEP/32; loadB.srcStride=1; loadB.dstGap=TN/16-1;
            for(uint32_t col=0;col<TN/32;++col)
                LoadDataWithTranspose(b0[col*1024],b1[col*span*32+start*32],loadB);
            SetFlag<HardEvent::MTE1_M>(ev); WaitFlag<HardEvent::MTE1_M>(ev);
            MmadParams mm;
            mm.m=actualRows; mm.n=TN; mm.k=STEP; mm.cmatrixInitVal=chunk==0;
            Mmad(c0,a0,b0,mm);
            SetFlag<HardEvent::M_MTE1>(ev);
        }
        SetFlag<HardEvent::MTE1_MTE2>(bank ? EVENT_ID3 : EVENT_ID2);
    }
    WaitFlag<HardEvent::M_MTE1>(EVENT_ID0);
    WaitFlag<HardEvent::M_MTE1>(EVENT_ID1);
    WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID2);
    if(panels>1) WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID3);
    Fence<HardEvent::M_FIX>();
    FixpipeParamsV220 fp;
    fp.mSize=actualRows; fp.nSize=TN; fp.srcStride=actualRows; fp.dstStride=TN;
    Fixpipe<int32_t,int32_t,CFG_ROW_MAJOR>(scratch,c0,fp);
    CrossCoreSetFlag<2,PIPE_FIX>(readyFlag);
    Fence<HardEvent::FIX_M>();
}

__aicore__ inline void SmallPrepare(GlobalTensor<int8_t> a,GlobalTensor<int8_t> b,
    uint32_t rows,uint32_t cols,uint32_t k,uint32_t n,uint32_t sequence)
{
    uint32_t slot=sequence%2; event_t ev=slot?EVENT_ID3:EVENT_ID2;
    if(sequence>=2) WaitFlag<HardEvent::MTE1_MTE2>(ev);
    LocalTensor<int8_t> a1(TPosition::A1,slot*163840,TM*256);
    LocalTensor<int8_t> b1(TPosition::A1,slot*163840+32768,256*TN);
    if(k!=256) {
        InitConstValue(a1.ReinterpretCast<uint32_t>(),InitConstValueParams<uint32_t>{1,TM*256/32,0,0});
        InitConstValue(b1.ReinterpretCast<uint32_t>(),InitConstValueParams<uint32_t>{1,256*TN/32,0,0});
        PipeBarrier<PIPE_MTE2>();
    }
    if(rows%16==0)
        DataCopy(a1,a,Nd2NzParams{uint16_t(rows/16),16,uint16_t(k),uint16_t(16*k),uint16_t(k),16,1,4096});
    else DataCopy(a1,a,Nd2NzParams{1,uint16_t(rows),uint16_t(k),0,uint16_t(k),TM,1,0});
    SetFlag<HardEvent::MTE2_MTE1>(slot ? EVENT_ID7 : EVENT_ID6);
    if(k%32==0 && n<=2047)
        DataCopy(b1,b,Nd2NzParams{uint16_t(k/32),32,uint16_t(cols),uint16_t(32*n),uint16_t(n),32,1,uint16_t(32*TN)});
    else DataCopy(b1,b,Nd2NzParams{1,uint16_t(k),uint16_t(cols),0,uint16_t(n),256,1,0});
    SetFlag<HardEvent::MTE2_MTE1>(ev);
}

__aicore__ inline void SmallCompute(GlobalTensor<int32_t> scratch,uint32_t sequence,uint32_t rows,bool packedB)
{
    const uint32_t actualRows=(rows+15)/16*16;
    uint32_t slot=sequence%2; event_t ev=slot?EVENT_ID3:EVENT_ID2;
    WaitFlag<HardEvent::MTE2_MTE1>(slot ? EVENT_ID7 : EVENT_ID6);
    const uint32_t outputSlot=sequence%OUTPUT_SLOTS;
    if(sequence>=OUTPUT_SLOTS) CrossCoreWaitFlag<2,PIPE_FIX>(DONE+outputSlot);
    LocalTensor<int8_t> a1(TPosition::A1,slot*163840,TM*256);
    LocalTensor<int8_t> b1(TPosition::A1,slot*163840+32768,256*TN);
    LocalTensor<int8_t> a0(TPosition::A2,0,TM*256),b0(TPosition::B2,0,256*TN);
    LocalTensor<int32_t> c0(TPosition::CO1,slot*TM*TN*4,TM*TN);
    LoadData2DParams ap;
    if(rows%16==0) {ap.repeatTimes=uint8_t(actualRows/16*8);ap.srcStride=1;LoadData(a0,a1,ap);}
    else {ap.repeatTimes=8;ap.srcStride=TM/16;
        for(uint32_t m=0;m<actualRows/16;++m) LoadData(a0[m*256*16],a1[m*512],ap);}

    WaitFlag<HardEvent::MTE2_MTE1>(ev);
    LoadData2dTransposeParams bp;bp.srcStride=1;
    if(packedB) {bp.repeatTimes=64;bp.dstGap=1;LoadDataWithTranspose(b0,b1,bp);}
    else {bp.repeatTimes=8;bp.dstGap=TN/16-1;
        for(uint32_t col=0;col<TN/32;++col) LoadDataWithTranspose(b0[col*1024],b1[col*256*32],bp);}

    SetFlag<HardEvent::MTE1_MTE2>(ev);
    Fence<HardEvent::MTE1_M>();
    MmadParams mm;mm.m=actualRows;mm.n=TN;mm.k=256;mm.cmatrixInitVal=true;
    if(sequence>=2) WaitFlag<HardEvent::FIX_M>(slot ? EVENT_ID5 : EVENT_ID4);
    Mmad(c0,a0,b0,mm);
    Fence<HardEvent::M_FIX>();
    FixpipeParamsV220 fp;fp.mSize=actualRows;fp.nSize=TN;fp.srcStride=actualRows;fp.dstStride=TN;
    Fixpipe<int32_t,int32_t,CFG_ROW_MAJOR>(scratch[outputSlot*TM*TN],c0,fp);
    CrossCoreSetFlag<2,PIPE_FIX>(READY+outputSlot);
    SetFlag<HardEvent::FIX_M>(slot ? EVENT_ID5 : EVENT_ID4);
    Fence<HardEvent::M_MTE1>();
}

__aicore__ inline void CubeTile(GlobalTensor<int8_t> a, GlobalTensor<int8_t> b,
    GlobalTensor<int32_t> scratch, uint32_t rows, uint32_t cols, uint32_t k, uint32_t n)
{
    LocalTensor<int8_t> a1(TPosition::A1, 0, TM * TK);
    LocalTensor<int8_t> b1(TPosition::A1, 32768, TK * TN);
    LocalTensor<int8_t> a0(TPosition::A2, 0, TM * TK);
    LocalTensor<int8_t> b0(TPosition::B2, 0, TK * TN);
    LocalTensor<int32_t> c0(TPosition::CO1, 0, TM * TN);
    for (uint32_t start = 0; start < k; start += TK) {
        const uint32_t depth = Min(TK, k - start);
        if (depth != TK) {
        InitConstValue(a1.ReinterpretCast<uint32_t>(), InitConstValueParams<uint32_t>{1, TM * TK / 32, 0, 0});
        InitConstValue(b1.ReinterpretCast<uint32_t>(), InitConstValueParams<uint32_t>{1, TK * TN / 32, 0, 0});
        PipeBarrier<PIPE_MTE2>();
        }
        Nd2NzParams ap{1, uint16_t(rows), uint16_t(depth), 0, uint16_t(k), TM, 1, 0};
        Nd2NzParams bp{1, uint16_t(depth), uint16_t(cols), 0, uint16_t(n), TK, 1, 0};
        DataCopy(a1, a[start], ap);
        DataCopy(b1, b[uint64_t(start) * n], bp);
        Fence<HardEvent::MTE2_MTE1>();
        LoadData2DParams loadA;
        loadA.repeatTimes = TK / 32;
        loadA.srcStride = TM / 16;
        for (uint32_t m = 0; m < TM / 16; ++m)
            LoadData(a0[m * TK * 16], a1[m * 512], loadA);
        LoadData2dTransposeParams loadB;
        loadB.repeatTimes = TK / 32;
        loadB.srcStride = 1;
        loadB.dstGap = TN / 16 - 1;
        for (uint32_t col = 0; col < TN / 32; ++col)
            LoadDataWithTranspose(b0[col * 1024], b1[col * TK * 32], loadB);
        Fence<HardEvent::MTE1_M>();
        MmadParams mm;
        mm.m = TM;
        mm.n = TN;
        mm.k = TK;
        mm.cmatrixInitVal = start == 0;
        Mmad(c0, a0, b0, mm);
        Fence<HardEvent::M_MTE1>();
        Fence<HardEvent::MTE1_MTE2>();
    }
    Fence<HardEvent::M_FIX>();
    FixpipeParamsV220 fp;
    fp.mSize = TM;
    fp.nSize = TN;
    fp.srcStride = TM;
    fp.dstStride = TN;
    Fixpipe<int32_t, int32_t, CFG_ROW_MAJOR>(scratch, c0, fp);
    CrossCoreSetFlag<2, PIPE_FIX>(READY);
    CrossCoreWaitFlag<2, PIPE_FIX>(DONE);
}

__aicore__ inline void Epilogue(GlobalTensor<int32_t> scratch,GlobalTensor<float> scales,
    GlobalTensor<half> out,uint32_t rows,uint32_t cols,uint32_t n,uint32_t slot,bool previousOutput,bool cachedScale,uint32_t scaleIndex,uint32_t sequence)
{
    constexpr uint32_t MAXCOUNT=TM/2*TN;
    const uint32_t H=((rows+15)/16*16)/2,COUNT=H*TN;
    const uint32_t sub=GetSubBlockIdx();
    const event_t inputEvent=sequence%2 ? EVENT_ID5 : EVENT_ID4;
    LocalTensor<int32_t> integers(TPosition::VECIN,122880+(sequence%2)*MAXCOUNT*4,MAXCOUNT);
    LocalTensor<float> z(TPosition::VECCALC,MAXCOUNT*4+256,MAXCOUNT);
    LocalTensor<float> t(TPosition::VECCALC,0,MAXCOUNT);
    LocalTensor<float> scale(TPosition::VECIN,86016+(cachedScale ? scaleIndex : sequence%2)*TN*4,TN);
    LocalTensor<half> result(TPosition::VECOUT,MAXCOUNT*8+512+TN*4,MAXCOUNT);
    CrossCoreWaitFlag<2,PIPE_MTE2>(READY+slot);
    if(sequence>=2) WaitFlag<HardEvent::V_MTE2>(inputEvent);
    DataCopy(integers,scratch[sub*COUNT],COUNT);
    CrossCoreSetFlag<2,PIPE_MTE2>(DONE+slot);
    if(!cachedScale) DataCopyPad(scale,scales,DataCopyExtParams{1,cols*4,0,0,0},DataCopyPadExtParams<float>{true,0,0,0});
    Fence<HardEvent::MTE2_V>();
    Cast(z,integers,RoundMode::CAST_RINT,COUNT);
    PipeBarrier<PIPE_V>();
    for(uint32_t col=0;col<TN;col+=64)
        Mul(z[col],z[col],scale[col],uint64_t(64),uint8_t(H),{1,1,1,TN/8,TN/8,0});
    PipeBarrier<PIPE_V>();
    // The slot owns both integers and any uncached channel scales.
    SetFlag<HardEvent::V_MTE2>(inputEvent);
    Mul(t,z,z,COUNT); PipeBarrier<PIPE_V>();
    Muls(t,t,-0.07135481387376785f,COUNT); PipeBarrier<PIPE_V>();
    Adds(t,t,-1.5957691216057308f,COUNT); PipeBarrier<PIPE_V>();
    Mul(t,t,z,COUNT); PipeBarrier<PIPE_V>();
    Exp(t,t,COUNT); PipeBarrier<PIPE_V>();
    Adds(t,t,1.0f,COUNT); PipeBarrier<PIPE_V>();
    Div(z,z,t,COUNT); PipeBarrier<PIPE_V>();
    if(previousOutput)WaitFlag<HardEvent::MTE3_V>(EVENT_ID7);
    Cast(result,z,RoundMode::CAST_RINT,COUNT);
    Fence<HardEvent::V_MTE3>();
    uint32_t validRows=rows>sub*H ? Min(H,rows-sub*H) : 0;
    DataCopyExtParams cp{uint16_t(validRows),cols*2,(TN-(cols+15)/16*16)/16,(n-cols)*2,0};
    if(validRows) DataCopyPad(out[uint64_t(sub*H)*n],result,cp);
    SetFlag<HardEvent::MTE3_V>(EVENT_ID7);
}

__aicore__ inline uint32_t ReadGroupEnd(const GlobalTensor<int64_t>& ends,uint32_t index)
{
    return uint32_t(ends.GetValue(index));
}

template<bool FullReduction>
__aicore__ inline void Run(GM_ADDR x, GM_ADDR weight,
    GM_ADDR scale, GM_ADDR groups, GM_ADDR y, GM_ADDR workspace, uint32_t runtimeE,
    uint32_t runtimeK, uint32_t runtimeN, uint32_t runtimeW, uint64_t tailDelayTicks)
{
    const uint32_t e=runtimeE,k=FullReduction?TK:runtimeK,n=runtimeN,workers=runtimeW;
    GlobalTensor<int8_t> a, b;
    GlobalTensor<float> scales;
    GlobalTensor<int64_t> ends;
    GlobalTensor<half> out;
    GlobalTensor<int32_t> scratch;
    a.SetGlobalBuffer((__gm__ int8_t*)x);
    b.SetGlobalBuffer((__gm__ int8_t*)weight);
    scales.SetGlobalBuffer((__gm__ float*)scale);
    ends.SetGlobalBuffer((__gm__ int64_t*)groups);
    out.SetGlobalBuffer((__gm__ half*)y);
    uint32_t worker;
    if ASCEND_IS_AIC { worker = GetBlockIdx(); }
    else { worker = GetBlockIdx() / 2; }
    scratch.SetGlobalBuffer((__gm__ int32_t*)workspace + uint64_t(worker) * OUTPUT_SLOTS * TM * TN);
    // Inputs are immutable within the launch. Flush once, then preserve scalar cache lines.
    DataCacheCleanAndInvalid<int64_t,CacheLine::ENTIRE_DATA_CACHE,DcciDst::CACHELINE_OUT>(ends);
    const uint32_t nt = (n + TN - 1) / TN;
    // Contiguous expert ownership batches scales within the per-core UB budget.
    const bool owned=e>=workers && nt==1 && (e+workers-1)/workers<=32;
    const uint32_t firstExpert=owned?e*worker/workers:0,lastExpert=owned?e*(worker+1)/workers:e;
    if ASCEND_IS_AIV {
        if(owned) {
            LocalTensor<float> cached(TPosition::VECIN,86016,32*TN);
            DataCopyPad(cached,scales[uint64_t(firstExpert)*n],
                DataCopyExtParams{uint16_t(lastExpert-firstExpert),n*4,0,(TN-(n+7)/8*8)/8,0},DataCopyPadExtParams<float>{true,0,0,0});
            Fence<HardEvent::MTE2_V>();
        }
    }
    uint32_t previous=firstExpert?ReadGroupEnd(ends,firstExpert-1):0,taskBase=0,produced=0,pendingRows=0;
    for (uint32_t expert=firstExpert;expert<lastExpert;++expert) {
        const uint32_t end = ReadGroupEnd(ends,expert);
        const uint32_t length = end - previous;
        const uint32_t tasks = ((length + TM - 1) / TM) * nt;
        const uint32_t first = owned?0:(worker + workers - taskBase % workers) % workers;
        for (uint32_t task = first; task < tasks; task += owned?1:workers) {
            const uint32_t row = task / nt * TM, col = task % nt * TN;
            const uint32_t rows = Min(TM, length - row), cols = Min(TN, n - col);
            const uint32_t slot = produced % OUTPUT_SLOTS;
            if ASCEND_IS_AIC {
                if(k<=256) {
                    SmallPrepare(a[uint64_t(previous+row)*k],b[uint64_t(expert)*k*n+col],rows,cols,k,n,produced);
                    if(produced) SmallCompute(scratch,produced-1,pendingRows,k%32==0 && n<=2047);
                    pendingRows=rows;
                } else {
                    if(produced >= OUTPUT_SLOTS) CrossCoreWaitFlag<2,PIPE_FIX>(DONE + slot);
                    ResidentTile(a[uint64_t(previous+row)*k],b[uint64_t(expert)*k*n+col],
                        scratch[slot*TM*TN],rows,cols,k,n,READY+slot);
                }
            } else {
                Epilogue(scratch[slot * TM * TN], scales[uint64_t(expert) * n + col],
                    out[uint64_t(previous + row) * n + col], rows, cols, n, slot,produced>0,owned,expert-firstExpert,produced);
            }
            ++produced;
        }
        taskBase += tasks;
        previous = end;
    }
    if ASCEND_IS_AIC {
        if(k<=256 && produced) {
            SmallCompute(scratch,produced-1,pendingRows,k%32==0 && n<=2047);
            WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID2);
            if(produced>1) WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID3);
            WaitFlag<HardEvent::FIX_M>(EVENT_ID4);
            if(produced>1) WaitFlag<HardEvent::FIX_M>(EVENT_ID5);
        }
        for(uint32_t slot=0;slot<Min(produced,OUTPUT_SLOTS);++slot)
            CrossCoreWaitFlag<2,PIPE_FIX>(DONE+slot);
        if(produced) CrossCoreWaitFlag<2,PIPE_S>(12);
        const uint64_t start = GetSystemCycle();
        while (uint64_t(GetSystemCycle()) - start < tailDelayTicks) {}
    }
    else if(produced) {
        WaitFlag<HardEvent::V_MTE2>(EVENT_ID4);
        if(produced>1) WaitFlag<HardEvent::V_MTE2>(EVENT_ID5);
        WaitFlag<HardEvent::MTE3_V>(EVENT_ID7);
        CrossCoreSetFlag<2,PIPE_MTE3>(12);
    }
    PipeBarrier<PIPE_ALL>();
}

// A complete reduction panel exposes constant DMA and MMAD dimensions to the compiler.
__aicore__ inline void GroupedMatmulGeluBaseline(GM_ADDR x,GM_ADDR weight,GM_ADDR scale,
    GM_ADDR groups,GM_ADDR y,GM_ADDR workspace,uint32_t e,uint32_t k,uint32_t n,uint32_t workers,uint64_t delay)
{
    if(k==TK)Run<true>(x,weight,scale,groups,y,workspace,e,k,n,workers,delay);
    else Run<false>(x,weight,scale,groups,y,workspace,e,k,n,workers,delay);
}

__aicore__ inline void SmallVector(GM_ADDR x, GM_ADDR weight, GM_ADDR scale,
    GM_ADDR groups, GM_ADDR y, uint32_t m, uint32_t k, uint32_t e, uint32_t n,
    uint64_t tailDelayTicks)
{

    GlobalTensor<int8_t> a,b;
    GlobalTensor<float> scales;
    GlobalTensor<int64_t> ends;
    GlobalTensor<half> out;
    a.SetGlobalBuffer((__gm__ int8_t*)x);
    b.SetGlobalBuffer((__gm__ int8_t*)weight);
    scales.SetGlobalBuffer((__gm__ float*)scale);
    ends.SetGlobalBuffer((__gm__ int64_t*)groups);
    out.SetGlobalBuffer((__gm__ half*)y);
    if(m*n==1) {
        LocalTensor<int64_t> gv(TPosition::VECIN,0,128);
        LocalTensor<int8_t> ax(TPosition::VECIN,1024,4096),bx(TPosition::VECIN,5120,4096);
        LocalTensor<float> sx(TPosition::VECIN,9216,128);
        DataCopyPad(gv,ends,DataCopyExtParams{1,e*8,0,0,0},DataCopyPadExtParams<int64_t>{false,0,0,0});
        DataCopyPad(ax,a,DataCopyExtParams{1,k,0,0,0},DataCopyPadExtParams<int8_t>{false,0,0,0});
        DataCopyPad(bx,b,DataCopyExtParams{1,e*k,0,0,0},DataCopyPadExtParams<int8_t>{false,0,0,0});
        DataCopyPad(sx,scales,DataCopyExtParams{1,e*4,0,0,0},DataCopyPadExtParams<float>{false,0,0,0});
        Fence<HardEvent::MTE2_S>();
        const auto boundaries=reinterpret_cast<__ubuf__ int64_t*>(gv.GetPhyAddr());
        uint32_t expert=0;while(expert+1<e && boundaries[expert]==0)++expert;
        const auto lhs=reinterpret_cast<__ubuf__ int8_t*>(ax.GetPhyAddr());
        const auto rhs=reinterpret_cast<__ubuf__ int8_t*>(bx.GetPhyAddr())+expert*k;
        int32_t sum=int32_t(lhs[0])*int32_t(rhs[0]);
        for(uint32_t depth=1;depth<k;++depth)sum+=int32_t(lhs[depth])*int32_t(rhs[depth]);
        const float value=float(sum)*reinterpret_cast<__ubuf__ float*>(sx.GetPhyAddr())[expert];
        // The group prefix is dead after ownership is resolved.
        LocalTensor<float> scalarZ(TPosition::VECCALC,0,8),scalarT(TPosition::VECCALC,32,8);
        LocalTensor<half> scalarResult(TPosition::VECOUT,64,16);
        union {float fp32;uint32_t bits;} encoded;encoded.fp32=value;
        const uint32_t magnitude=encoded.bits&0x7fffffffU;
        if(magnitude==0 || uint32_t(magnitude-0x3a800000U)<=0x05000000U) {
            const float square=value*value;
            const float answer=0.5f*value+square*(0.3988894522190094f+
                square*(-0.06617370992898941f+square*0.008526203222572803f));
            *reinterpret_cast<__ubuf__ half*>(scalarResult.GetPhyAddr())=half(answer);
            Fence<HardEvent::S_MTE3>();
        } else {
            *reinterpret_cast<__ubuf__ float*>(scalarZ.GetPhyAddr())=value;
            *reinterpret_cast<__ubuf__ float*>(scalarT.GetPhyAddr())=value*(-1.5957691216057308f-0.07135481387376785f*value*value);
            Fence<HardEvent::S_V>();
            SetVectorMask<float,MaskMode::NORMAL>(0,1);
            Exp<float,false>(scalarT,scalarT,uint64_t(1),1,{1,1,8,8});PipeBarrier<PIPE_V>();
            Adds<float,false>(scalarT,scalarT,1.0f,uint64_t(1),1,{1,1,8,8});PipeBarrier<PIPE_V>();
            Div<float,false>(scalarZ,scalarZ,scalarT,uint64_t(1),1,{1,1,1,8,8,8});PipeBarrier<PIPE_V>();
            Cast<half,float,false>(scalarResult,scalarZ,RoundMode::CAST_RINT,uint64_t(1),1,{1,1,4,8});
            Fence<HardEvent::V_MTE3>();
        }
        DataCopyPad(out,scalarResult,DataCopyExtParams{1,2,0,0,0});
        if(tailDelayTicks) {
            Fence<HardEvent::MTE3_S>();
            const uint64_t start=GetSystemCycle();while(GetSystemCycle()-start<tailDelayTicks){}
        }
        return;
    }
    LocalTensor<int8_t> av(TPosition::VECIN,0,4096), bv(TPosition::VECIN,4096,4096);
    LocalTensor<float> sv(TPosition::VECIN,8192,1024);
    LocalTensor<float> z(TPosition::VECCALC,12288,256), t(TPosition::VECCALC,13312,256);
    LocalTensor<float> denominator(TPosition::VECCALC,14336,256);
    LocalTensor<float> positive(TPosition::VECCALC,15360,256), negative(TPosition::VECCALC,16384,256);
    LocalTensor<half> result(TPosition::VECOUT,17408,256);
    DataCopyExtParams ap{1,m*k,0,0,0},bp{1,e*k*n,0,0,0},sp{1,e*n*4,0,0,0};
    DataCopyPad(av,a,ap,DataCopyPadExtParams<int8_t>{false,0,0,0});
    DataCopyPad(bv,b,bp,DataCopyPadExtParams<int8_t>{false,0,0,0});
    DataCopyPad(sv,scales,sp,DataCopyPadExtParams<float>{false,0,0,0});
    Fence<HardEvent::MTE2_S>();
    uint32_t previous=0;
    for (uint32_t expert=0;expert<e;++expert) {
        const uint32_t end=ends.GetValue(expert);
        for (uint32_t row=previous;row<end;++row) {
            for (uint32_t col=0;col<n;++col) {
                int32_t sum=0;
                for (uint32_t depth=0;depth<k;++depth)
                    sum += int32_t(av.GetValue(row*k+depth))*int32_t(bv.GetValue((expert*k+depth)*n+col));
                z.SetValue(row*n+col,float(sum)*sv.GetValue(expert*n+col));
            }
        }
        previous=end;
    }
    Fence<HardEvent::S_V>();
    const uint32_t count=(m*n+63)/64*64;
    Mul(t,z,z,count); PipeBarrier<PIPE_V>();
    Muls(t,t,-0.07135481387376785f,count); PipeBarrier<PIPE_V>();
    Adds(t,t,-1.5957691216057308f,count); PipeBarrier<PIPE_V>();
    Mul(t,t,z,count); PipeBarrier<PIPE_V>();
    Exp(t,t,count); PipeBarrier<PIPE_V>();
    Adds(t,t,1.0f,count); PipeBarrier<PIPE_V>();
    Div(z,z,t,count); PipeBarrier<PIPE_V>();
    Cast(result,z,RoundMode::CAST_RINT,count); Fence<HardEvent::V_MTE3>();
    DataCopyPad(out,result,DataCopyExtParams{1,m*n*2,0,0,0});
    Fence<HardEvent::MTE3_S>();
    const uint64_t start=GetSystemCycle();
    while(uint64_t(GetSystemCycle())-start<tailDelayTicks) {}
}


template<uint32_t K>
__aicore__ inline void TinyFourBlockVmla(GM_ADDR x,GM_ADDR weight,GM_ADDR scale,
    GM_ADDR groups,GM_ADDR y,uint32_t m,uint32_t e,uint32_t n,uint64_t tailDelayTicks)
{

    constexpr uint32_t k=K,rows=4,count=64;
    const uint32_t first=GetBlockIdx()*rows;
    GlobalTensor<int8_t> a,b;GlobalTensor<float> scales;GlobalTensor<int64_t> ends;GlobalTensor<half> out;
    a.SetGlobalBuffer((__gm__ int8_t*)x);b.SetGlobalBuffer((__gm__ int8_t*)weight);
    scales.SetGlobalBuffer((__gm__ float*)scale);ends.SetGlobalBuffer((__gm__ int64_t*)groups);
    out.SetGlobalBuffer((__gm__ half*)y);
    LocalTensor<int8_t> av(TPosition::VECIN,1024,256),bv(TPosition::VECIN,0,1024);
    LocalTensor<int64_t> gv(TPosition::VECIN,1280,32);
    LocalTensor<half> wh(TPosition::VECCALC,2048,1024),result(TPosition::VECOUT,17408,256);
    LocalTensor<float> wf(TPosition::VECCALC,4096,1024),sv(TPosition::VECIN,8192,256);
    LocalTensor<float> z(TPosition::VECCALC,12288,256),t(TPosition::VECCALC,13312,256);
    LocalTensor<float> affine(TPosition::VECCALC,14336,256);
    LocalTensor<half> compactResult(TPosition::VECOUT,15360,32);
    LocalTensor<uint64_t> outputMask(TPosition::VECCALC,16384,2);
    LocalTensor<half> ah(TPosition::VECCALC,1536,16),broadcast(TPosition::VECCALC,4096,256);
    DataCopyPad(av,a[first*k],DataCopyExtParams{1,rows*k,0,0,0},DataCopyPadExtParams<int8_t>{false,0,0,0});
    DataCopyPad(gv,ends,DataCopyExtParams{1,e*8,0,0,0},DataCopyPadExtParams<int64_t>{false,0,0,0});
    SetFlag<HardEvent::MTE2_S>(EVENT_ID0);
    DataCopyPad(bv,b,DataCopyExtParams{uint16_t(e*k),n,0,0,0},DataCopyPadExtParams<int8_t>{true,0,0,0});
    DataCopyPad(sv,scales,DataCopyExtParams{uint16_t(e),n*4,0,0,0},DataCopyPadExtParams<float>{true,0,0,0});
    const uint64_t mask=(1ULL<<n)-1;
    outputMask.SetValue(0,mask|(mask<<16)|(mask<<32)|(mask<<48));outputMask.SetValue(1,0);
    Fence<HardEvent::S_V>();
    Duplicate(affine,-1.5957691216057308f,count);
    Duplicate(z,0.0f,count);
    WaitFlag<HardEvent::MTE2_S>(EVENT_ID0);
    uint32_t owner[4]={0,0,0,0};
    for(uint32_t expert=0;expert+1<e;++expert) {
        const uint32_t end=gv.GetValue(expert);
        #pragma unroll
        for(uint32_t row=0;row<4;++row)owner[row]+=end<=first+row;
    }
    const uint32_t e0=owner[0],e1=owner[1],e2=owner[2],e3=owner[3];
    Fence<HardEvent::MTE2_V>();
    SetMaskCount();SetVectorMask<float,MaskMode::COUNTER>(0,e*k*32);
    Cast<half,int8_t,false>(wh,bv,RoundMode::CAST_NONE,uint64_t(128),1,{1,1,8,4});
    SetVectorMask<half,MaskMode::COUNTER>(0,rows*k);
    Cast<half,int8_t,false>(ah,av,RoundMode::CAST_NONE,uint64_t(128),1,{1,1,8,4});PipeBarrier<PIPE_V>();
    SetMaskNorm();ResetMask();
    Brcb(broadcast,ah,2,{1,8});PipeBarrier<PIPE_V>();
    if(e0==e1 && e2==e3) {
        SetVectorMask<float,MaskMode::NORMAL>(0,mask|(mask<<16));
        #pragma unroll
        for(uint32_t depth=0;depth<K;++depth) {
            MulAddDst<float,half,false>(z,wh[(e0*K+depth)*32],broadcast[depth*16],uint64_t(64),2,
                {1,0,uint8_t(K),4,uint8_t(2*K*(e2-e0)),uint8_t(2*K)});
            PipeBarrier<PIPE_V>();
        }
        Mul<float,false>(z,z,sv[e0*8],uint64_t(64),2,{1,1,0,4,4,uint8_t(e2-e0)});
    } else {
        SetVectorMask<float,MaskMode::NORMAL>(0,mask);
        #pragma unroll
        for(uint32_t depth=0;depth<K;++depth) {
            MulAddDst<float,half,false>(z,wh[(e0*K+depth)*32],broadcast[depth*16],uint64_t(64),2,
                {1,1,1,2,uint8_t(2*K*(e1-e0)),uint8_t(K)});
            MulAddDst<float,half,false>(z[32],wh[(e2*K+depth)*32],broadcast[(2*K+depth)*16],uint64_t(64),2,
                {1,1,1,2,uint8_t(2*K*(e3-e2)),uint8_t(K)});
            PipeBarrier<PIPE_V>();
        }
        Mul<float,false>(z,z,sv[e0*8],uint64_t(64),2,{1,1,1,2,2,uint8_t(e1-e0)});
        Mul<float,false>(z[32],z[32],sv[e2*8],uint64_t(64),2,{1,1,1,2,2,uint8_t(e3-e2)});
    }
    PipeBarrier<PIPE_V>();SetMaskNorm();ResetMask();
    LocalTensor<float> active=z;
    SetMaskCount();SetVectorMask<float,MaskMode::COUNTER>(0,count);
    Mul<float,false>(t,active,active,uint64_t(64),1,{1,1,1,8,8,8});PipeBarrier<PIPE_V>();
    Axpy<float,float,false>(affine,t,-0.07135481387376785f,uint64_t(64),1,{1,1,8,8});PipeBarrier<PIPE_V>();
    Mul<float,false>(t,affine,active,uint64_t(64),1,{1,1,1,8,8,8});PipeBarrier<PIPE_V>();
    Exp<float,false>(t,t,uint64_t(64),1,{1,1,8,8});PipeBarrier<PIPE_V>();
    Adds<float,false>(t,t,1.0f,uint64_t(64),1,{1,1,8,8});PipeBarrier<PIPE_V>();
    Div<float,false>(active,active,t,uint64_t(64),1,{1,1,1,8,8,8});PipeBarrier<PIPE_V>();
    Cast<half,float,false>(result,active,RoundMode::CAST_RINT,uint64_t(64),1,{1,1,4,8});
    PipeBarrier<PIPE_V>();
    uint64_t retained=0;
    GatherMask(compactResult,result,outputMask.ReinterpretCast<uint16_t>(),true,64,GatherMaskParams{1,1,8,0},retained);
    SetMaskNorm();ResetMask();Fence<HardEvent::V_MTE3>();
    DataCopyPad(out[first*n],compactResult,DataCopyExtParams{1,rows*n*2,0,0,0});Fence<HardEvent::MTE3_S>();
    const uint64_t start=GetSystemCycle();while(uint64_t(GetSystemCycle())-start<tailDelayTicks){}
}


inline void Require(bool condition) { if (!condition) std::abort(); }
inline void CheckAcl(aclError status) { Require(status == ACL_SUCCESS); }
}

namespace gmmPackedMatrix {
using namespace AscendC;
constexpr uint32_t TM=128,TN=256,SLOT=32768;
constexpr uint16_t READY=4,DONE=6;
template<HardEvent event> __aicore__ inline void Fence(){SetFlag<event>(EVENT_ID0);WaitFlag<event>(EVENT_ID0);}
__aicore__ inline uint32_t Min(uint32_t a,uint32_t b){return a<b?a:b;}


struct Packing { uint32_t m,k,n,PK,PN,PM; bool direct; };
__aicore__ inline void IssuePack(GlobalTensor<int8_t> a,GlobalTensor<int8_t> b,
    const uint32_t* activeExperts,uint32_t tile,const Packing& pack)
{
    const uint32_t PK=pack.PK,PN=pack.PN,PM=pack.PM;
    const bool isA=tile<PM/16;
    const uint32_t btile=isA?0:tile-PM/16,row=(isA?tile:btile%(PK/16))*16;
    const uint32_t expert=isA?0:activeExperts[btile/(PK/16)],validRows=isA?pack.m:pack.k,cols=isA?pack.k:pack.n;
    const uint32_t rows=row<validRows?Min(16,validRows-row):0;
    LocalTensor<int8_t> input(TPosition::VECIN,0,16*((PK>PN?PK:PN)+32));
    const uint32_t width=isA?PK:PN,aligned=(cols+31)/32*32;
    if(rows<16 || width>aligned){Duplicate(input.ReinterpretCast<int32_t>(),int32_t(0),16*((PK>PN?PK:PN)+32)/4);Fence<HardEvent::V_MTE2>();}
    if(rows)DataCopyPad(input,isA?a[uint64_t(row)*pack.k]:b[(uint64_t(expert)*pack.k+row)*pack.n],
        DataCopyExtParams{uint16_t(rows),cols,0,(width+32-aligned)/32,0},DataCopyPadExtParams<int8_t>{true,0,uint8_t(aligned-cols),0});
    SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
}
__aicore__ inline void PackAB(GlobalTensor<int8_t> a,GlobalTensor<int8_t> b,const uint32_t* activeExperts,
    GlobalTensor<int8_t> packedA,GlobalTensor<int8_t> packedB,uint32_t active,uint32_t workers,const Packing& pack)
{
    const uint32_t PK=pack.PK,PN=pack.PN,PM=pack.PM;
    const uint32_t bytes=16*((PK>PN?PK:PN)+32);
    const uint32_t id=GetBlockIdx(),cores=workers*2,total=PM/16+active*(PK/16);
    LocalTensor<int32_t> ia(TPosition::VECCALC,2*bytes,PK/2),ib(TPosition::VECCALC,2*bytes+PK*2,PN/2);
    for(uint32_t r=0;r<8;++r){ia.SetValue(r,int32_t(r*(PK+32)));ib.SetValue(r,int32_t(r*(PN+32)));}
    Fence<HardEvent::S_V>();
    for(uint32_t span=8;span<(PK>PN?PK:PN)/2;span*=2) {
        const uint32_t offset=span/16*32;
        if(span<PK/2)Adds(ia[span],ia,int32_t(span<16?span*(PK+32):offset),Min(span,PK/2-span));
        if(span<PN/2)Adds(ib[span],ib,int32_t(span<16?span*(PN+32):offset),Min(span,PN/2-span));PipeBarrier<PIPE_V>();
    }
    if(id<total)IssuePack(a,b,activeExperts,id,pack);
    for(uint32_t tile=id;tile<total;tile+=cores) {
        const bool isA=tile<PM/16;
        const uint32_t btile=isA?0:tile-PM/16,row=(isA?tile:btile%(PK/16))*16;
        const uint32_t expert=isA?0:activeExperts[btile/(PK/16)],width=isA?PK:PN;
        LocalTensor<int8_t> input(TPosition::VECIN,0,bytes),output(TPosition::VECOUT,bytes,bytes);
        WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
        if(tile!=id)WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
        auto idx=(isA?ia:ib).ReinterpretCast<uint32_t>();
        for(uint32_t first=0;first<width/2;first+=1024)
            Gatherb(output[first*32].ReinterpretCast<uint16_t>(),input.ReinterpretCast<uint16_t>(),idx[first],uint8_t(Min(1024,width/2-first)/8),GatherRepeatParams{1,8});
        Fence<HardEvent::V_MTE2>();Fence<HardEvent::V_MTE3>();
        if(isA)DataCopyPad(packedA[row*32],output,DataCopyExtParams{uint16_t(width/32),512,0,(PM-16)*32,0});
        else DataCopyPad(packedB[uint64_t(expert)*PK*PN+row*32],output,DataCopyExtParams{uint16_t(width/32),512,0,(PK-16)*32,0});
        SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
        if(tile+cores<total)IssuePack(a,b,activeExperts,tile+cores,pack);
    }
    if(id<total)WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
    SyncAll<true>();CrossCoreSetFlag<2,PIPE_MTE3>(8);
}

// Both geometries use the same L1 ring, L0 schedule and epilogue.
template<uint32_t Panels,uint32_t M,uint32_t N> struct Geometry {
    static constexpr uint32_t Capacity=(512*1024-M*(Panels*256))/(256*N);
    static constexpr uint32_t RingCapacity=Capacity<4?Capacity:4;
    static constexpr uint32_t B_BANKS=Panels<RingCapacity?Panels:RingCapacity;
    static constexpr uint32_t SingleStep=65536/N<256?65536/N:256;
    static constexpr uint32_t DoubleStep=65536/(2*N)<128?65536/(2*N):128;
    static constexpr uint32_t STEP=Panels==1?SingleStep:DoubleStep;
    static constexpr uint32_t L0_BANKS=Panels==1?1:2;
    static_assert(B_BANKS>0 && M*N*4<=128*1024,"matrix geometry exceeds Cube storage");
    static_assert(L0_BANKS*M*STEP<=64*1024 && L0_BANKS*N*STEP<=64*1024,"matrix geometry exceeds L0 storage");
};

template<uint32_t Panels,bool Direct,uint32_t TM,uint32_t TN>
__aicore__ inline void LoadBPanel(GlobalTensor<int8_t> b,uint32_t cols,uint32_t k,
    uint32_t n,uint32_t panel,uint32_t span,const Packing& pack,uint32_t phase,bool reuse=false)
{
    constexpr uint32_t PK=Panels*256;
    const uint32_t PN=pack.PN,PM=pack.PM;
    constexpr uint32_t B_BANKS=Geometry<Panels,TM,TN>::B_BANKS;
    const uint32_t bank=(phase+panel)%B_BANKS;const event_t ev=event_t(uint32_t(EVENT_ID2)+bank);
    if(reuse || panel>=B_BANKS)WaitFlag<HardEvent::MTE1_MTE2>(ev);
    LocalTensor<int8_t> b1(TPosition::A1,TM*PK+bank*span*TN,span*TN);
    const uint32_t depth=Min(span,k-panel*span);
    if constexpr(Direct) {
        if(depth<span) {
            LocalTensor<uint32_t> tail(TPosition::A1,TM*PK+bank*span*TN+depth*32,(span*TN-depth*32)/4);
            InitConstValue(tail,InitConstValueParams<uint32_t>{uint16_t(TN/32),uint16_t(span-depth),uint16_t(depth),0});
            PipeBarrier<PIPE_MTE2>();
        }
        DataCopy(b1,b[uint64_t(panel)*span*n],Nd2NzParams{1,uint16_t(depth),uint16_t(cols),0,uint16_t(n),uint16_t(span),1,0});
    }else {
        const uint32_t storedDepth=(depth+31)/32*32;
        if(storedDepth<span) {
            LocalTensor<uint32_t> tail(TPosition::A1,TM*PK+bank*span*TN+storedDepth*32,(span*TN-storedDepth*32)/4);
            InitConstValue(tail,InitConstValueParams<uint32_t>{uint16_t(TN/32),uint16_t(span-storedDepth),uint16_t(storedDepth),0});
            PipeBarrier<PIPE_MTE2>();
        }
        DataCopy(b1,b[panel*span*32],DataCopyParams{uint16_t((cols+31)/32),uint16_t(storedDepth),uint16_t(pack.PK-storedDepth),uint16_t(span-storedDepth)});
    }
    SetFlag<HardEvent::MTE2_MTE1>(ev);
}

template<uint32_t Panels,bool Direct,uint32_t TM,uint32_t TN>
__aicore__ inline void ResidentA(GlobalTensor<int8_t> a, GlobalTensor<int8_t> b,
    GlobalTensor<int32_t> scratch, uint32_t rows, uint32_t cols, uint32_t k, uint32_t n, uint16_t readyFlag, bool reloadA, bool prefetchedB,
    GlobalTensor<int8_t> nextB, uint32_t nextCols, bool prefetchNext,uint32_t phase,const Packing& pack)
{
    constexpr uint32_t PK=Panels*256;
    const uint32_t PN=pack.PN,PM=pack.PM;
    const uint32_t actualRows=rows<32?32:(rows+15)/16*16;
    const uint32_t width=(cols+31)/32*32;
    using G=Geometry<Panels,TM,TN>;
    constexpr uint32_t STEP=G::STEP,BANKS=G::L0_BANKS,B_BANKS=G::B_BANKS;
    const uint32_t span = 256;
    constexpr uint32_t panels=Panels;
    LocalTensor<int32_t> c0(TPosition::CO1, 0, TM * TN);
    constexpr uint32_t kp=Panels*256;
    LocalTensor<int8_t> afull(TPosition::A1,0,TM*kp);
    if(reloadA) {
        if constexpr(Direct) {
            if(k<PK) {
                LocalTensor<uint32_t> tail(TPosition::A1,k*TM,TM*(PK-k)/4);
                InitConstValue(tail,InitConstValueParams<uint32_t>{1,uint16_t(TM*(PK-k)/32),0,0});
                PipeBarrier<PIPE_MTE2>();
            }
            DataCopy(afull,a,Nd2NzParams{1,uint16_t(rows),uint16_t(k),0,uint16_t(k),TM,1,0});
        }else {
            if(pack.PK<PK) {
                LocalTensor<uint32_t> tail(TPosition::A1,pack.PK*TM,TM*(PK-pack.PK)/4);
                InitConstValue(tail,InitConstValueParams<uint32_t>{1,uint16_t(TM*(PK-pack.PK)/32),0,0});
                PipeBarrier<PIPE_MTE2>();
            }
            DataCopy(afull,a,DataCopyParams{uint16_t(pack.PK/32),uint16_t(actualRows),uint16_t(PM-actualRows),uint16_t(TM-actualRows)});
        }
        SetFlag<HardEvent::MTE2_MTE1>(EVENT_ID6);
    }
    if(!prefetchedB)for(uint32_t p=0;p<Min(B_BANKS,panels);++p)LoadBPanel<Panels,Direct,TM,TN>(b,cols,k,n,p,span,pack,phase);
    if(reloadA) WaitFlag<HardEvent::MTE2_MTE1>(EVENT_ID6);
    for (uint32_t panel = 0; panel < panels; ++panel) {
        const uint32_t bank=(phase+panel)%B_BANKS;
        const event_t bankEvent=event_t(uint32_t(EVENT_ID2)+bank);
        WaitFlag<HardEvent::MTE2_MTE1>(bankEvent);
        LocalTensor<int8_t> a1(TPosition::A1,0,TM*kp);
        LocalTensor<int8_t> b1(TPosition::A1,TM*PK+bank*span*TN,span*TN);
        for (uint32_t start = 0; start < span && panel*span+start < k; start += STEP) {
            const uint32_t depth=(Min(STEP,k-panel*span-start)+31)/32*32;
            const uint32_t chunk=panel*(span/STEP)+start/STEP;
            const uint32_t slot=chunk%BANKS;
            const event_t ev=slot ? EVENT_ID1 : EVENT_ID0;
            if (chunk >= BANKS) WaitFlag<HardEvent::M_MTE1>(ev);
            LocalTensor<int8_t> a0(TPosition::A2, slot * TM * STEP, TM * STEP);
            LocalTensor<int8_t> b0(TPosition::B2, slot * STEP * TN, STEP * TN);
            LoadData2DParams loadA;
            loadA.repeatTimes=actualRows/16; loadA.srcStride=1;loadA.dstGap=depth/32-1;
            for(uint32_t q=0;q<depth/32;++q)
                LoadData(a0[q*512],a1[(panel*span+start+q*32)*TM],loadA);
            LoadData2dTransposeParams loadB;
            loadB.repeatTimes=width/32; loadB.srcStride=span/32; loadB.dstGap=1;
            for(uint32_t q=0;q<depth/32;++q)
                LoadDataWithTranspose(b0[q*width*32],b1[(start+q*32)*32],loadB);
            SetFlag<HardEvent::MTE1_M>(ev); WaitFlag<HardEvent::MTE1_M>(ev);
            MmadParams mm;
            mm.m=actualRows; mm.n=width; mm.k=depth; mm.cmatrixInitVal=chunk==0;
            PipeBarrier<PIPE_M>();
            Mmad(c0,a0,b0,mm);
            SetFlag<HardEvent::M_MTE1>(ev);
        }
        SetFlag<HardEvent::MTE1_MTE2>(bankEvent);
        if(panel+B_BANKS<panels)LoadBPanel<Panels,Direct,TM,TN>(b,cols,k,n,panel+B_BANKS,span,pack,phase);
        else if(prefetchNext)LoadBPanel<Panels,Direct,TM,TN>(nextB,nextCols,k,n,panel+B_BANKS-panels,span,pack,(phase+panels)%B_BANKS,true);
    }
    WaitFlag<HardEvent::M_MTE1>(EVENT_ID0);
    if constexpr(BANKS>1) {if(k>STEP)WaitFlag<HardEvent::M_MTE1>(EVENT_ID1);}
    if(!prefetchNext)for(uint32_t bank=0;bank<Min(B_BANKS,panels);++bank)
        WaitFlag<HardEvent::MTE1_MTE2>(event_t(uint32_t(EVENT_ID2)+bank));
    Fence<HardEvent::M_FIX>();
    FixpipeParamsV220 fp;
    fp.mSize=actualRows; fp.nSize=width; fp.srcStride=actualRows; fp.dstStride=TN;
    Fixpipe<int32_t,int32_t,CFG_ROW_MAJOR>(scratch,c0,fp);
    CrossCoreSetFlag<2,PIPE_FIX>(readyFlag);
    Fence<HardEvent::FIX_M>();
}

template<uint32_t TM,uint32_t TN>
__aicore__ inline void EpilogueChunks(GlobalTensor<int32_t> scratch,GlobalTensor<float> scales,
    GlobalTensor<half> out,uint32_t rows,uint32_t cols,uint32_t n,uint32_t slot,bool& secondBufferUsed,
    bool previousOutput=false,bool firstTile=true,uint32_t column=0,uint32_t width=TN)
{
    constexpr uint32_t MAXCOUNT=8192;
    const uint32_t CHUNK_ROWS=MAXCOUNT/width;
    const uint32_t H=(rows<32?32:(rows+15)/16*16)/2,sub=GetSubBlockIdx();
    LocalTensor<int32_t> integers(TPosition::VECIN,122880,MAXCOUNT);
    LocalTensor<float> z(TPosition::VECCALC,MAXCOUNT*4+256,MAXCOUNT);
    LocalTensor<float> t(TPosition::VECCALC,0,MAXCOUNT);
    LocalTensor<float> cached(TPosition::VECIN,86016,4096);
    LocalTensor<float> scale(TPosition::VECIN,86016+column*4,TN);

    if(previousOutput) WaitFlag<HardEvent::V_MTE2>(EVENT_ID4);
    if(firstTile) DataCopyPad(cached,scales,DataCopyExtParams{1,n*4,0,0,0},DataCopyPadExtParams<float>{true,0,0,0});
    CrossCoreWaitFlag<2,PIPE_MTE2>(READY+slot);
    for(uint32_t row=0;row<H;row+=CHUNK_ROWS) {
        const uint32_t chunkRows=Min(CHUNK_ROWS,H-row),count=chunkRows*width;
        if(row) WaitFlag<HardEvent::V_MTE2>(EVENT_ID4);
        DataCopy(integers,scratch[(sub*H+row)*width],count);
        if(row+chunkRows==H) CrossCoreSetFlag<2,PIPE_MTE2>(DONE+slot);
        Fence<HardEvent::MTE2_V>();
        Cast(z,integers,RoundMode::CAST_RINT,count); PipeBarrier<PIPE_V>();
        for(uint32_t col=0;col<width;col+=64)
            Mul(z[col],z[col],scale[col],uint64_t(Min(64,width-col)),uint8_t(chunkRows),{1,1,1,uint8_t(width/8),uint8_t(width/8),0});
        PipeBarrier<PIPE_V>();
        SetFlag<HardEvent::V_MTE2>(EVENT_ID4);
        Mul(t,z,z,count); PipeBarrier<PIPE_V>();
        Muls(t,t,-0.07135481387376785f,count); PipeBarrier<PIPE_V>();
        Adds(t,t,-1.5957691216057308f,count); PipeBarrier<PIPE_V>();
        Mul(t,t,z,count); PipeBarrier<PIPE_V>();
        Exp(t,t,count); PipeBarrier<PIPE_V>();
        Adds(t,t,1.0f,count); PipeBarrier<PIPE_V>();
        Div(z,z,t,count); PipeBarrier<PIPE_V>();
        // A tile of at most 32768 elements uses at most two chunks per AIV.
        const bool second=row!=0;
        const event_t outputEvent=second?EVENT_ID6:EVENT_ID7;
        if(second?secondBufferUsed:previousOutput)WaitFlag<HardEvent::MTE3_V>(outputEvent);
        const uint32_t outputBase=second?155648:MAXCOUNT*8+512+TN*4;
        LocalTensor<half> result(TPosition::VECOUT,outputBase,MAXCOUNT);
        Cast(result,z,RoundMode::CAST_RINT,count); Fence<HardEvent::V_MTE3>();
        const uint32_t start=sub*H+row,validRows=rows>start ? Min(chunkRows,rows-start) : 0;
        DataCopyExtParams cp{uint16_t(validRows),cols*2,(width-(cols+15)/16*16)/16,(n-cols)*2,0};
        if(validRows) DataCopyPad(out[uint64_t(start)*n],result,cp);
        SetFlag<HardEvent::MTE3_V>(outputEvent);
        if(second)secondBufferUsed=true;
    }
}

// Reuse full-K A across columns; carry the L1 ring phase between tiles.
template<uint32_t Panels,bool Direct,uint32_t TM,uint32_t TN>
__aicore__ inline void Run(GM_ADDR x,GM_ADDR weight,
    GM_ADDR scale,GM_ADDR groups,GM_ADDR y,GM_ADDR workspace,uint32_t inputE,
    uint32_t inputK,uint32_t inputN,uint32_t workers,uint64_t tailDelayTicks)
{
    const uint32_t e=inputE,k=inputK,n=inputN,nt=(n+TN-1)/TN;
    constexpr bool direct=Direct;
    GlobalTensor<int64_t> ends;ends.SetGlobalBuffer((__gm__ int64_t*)groups);
    const GlobalTensor<int64_t>& actualEnds=ends;
    uint32_t previous=0,total=0,active=0,activeExperts[128];
    for(uint32_t expert=0;expert<e;++expert) {
        const uint32_t end=actualEnds.GetValue(expert),length=end-previous;
        total+=(length+TM-1)/TM*nt;if(length && !direct)activeExperts[active++]=expert;previous=end;
    }
    // GM NZ retains only complete 32-byte blocks; L1 keeps its K256 panel capacity.
    const Packing pack{previous,k,n,(k+31)/32*32,(n+31)/32*32,(previous+63)/32*32,direct};
    constexpr uint32_t PK=Panels*256;
    const uint32_t GPK=pack.PK,PN=pack.PN,PM=pack.PM;
    GlobalTensor<int8_t> a,b;GlobalTensor<float> scales;GlobalTensor<half> out;GlobalTensor<int32_t> scratch;
    a.SetGlobalBuffer((__gm__ int8_t*)x);b.SetGlobalBuffer((__gm__ int8_t*)weight);
    scales.SetGlobalBuffer((__gm__ float*)scale);out.SetGlobalBuffer((__gm__ half*)y);
    uint32_t worker;if ASCEND_IS_AIC {worker=GetBlockIdx();}else{worker=GetBlockIdx()/2;}
    scratch.SetGlobalBuffer((__gm__ int32_t*)workspace+uint64_t(worker)*2*SLOT);
    GlobalTensor<int8_t> packedA,packedB;
    if(!direct) {
        packedA.SetGlobalBuffer((__gm__ int8_t*)workspace+uint64_t(workers)*2*SLOT*4);
        packedB.SetGlobalBuffer((__gm__ int8_t*)workspace+uint64_t(workers)*2*SLOT*4+PM*GPK);
        if ASCEND_IS_AIV {PackAB(a,b,activeExperts,packedA,packedB,active,workers,pack);}else{CrossCoreWaitFlag<2,PIPE_MTE2>(8);}
    }
    uint64_t savedCtrl=0;
    if ASCEND_IS_AIC {savedCtrl=get_ctrl();SetMMRowMajor();}
    const uint32_t begin=total*worker/workers,finish=total*(worker+1)/workers;
    previous=0;uint32_t base=0,produced=0,cachedExpert=0xffffffffU,cachedCol=0xffffffffU,cachedRow=0xffffffffU,cachedRows=0;
    bool pendingB=false,secondBufferUsed=false;uint32_t bPhase=0;
    for(uint32_t expert=0;expert<e;++expert) {
        const uint32_t end=actualEnds.GetValue(expert),length=end-previous,mt=(length+TM-1)/TM,tasks=mt*nt,cost=1;
        const uint32_t first=begin>base?Min(tasks,(begin-base+cost-1)/cost):0,limit=finish>base?Min(tasks,(finish-base+cost-1)/cost):0;
        const uint32_t taskFirst=first,taskLimit=limit,step=1;
        for(uint32_t task=taskFirst;task<taskLimit;task+=step) {
            const uint32_t row=task/nt*TM,col=task%nt*TN,rows=Min(TM,length-row),cols=Min(TN,n-col),slot=produced%2;
            if ASCEND_IS_AIC {
                if(produced>=2)CrossCoreWaitFlag<2,PIPE_FIX>(DONE+slot);
                const uint32_t nextTask=task+step,nextRow=nextTask/nt*TM,nextCol=nextTask%nt*TN;
                // The next tile starts at the bank released by the current K panel.
                const bool next=nextTask<taskLimit && nextRow==row;
                const auto inputA=direct?a[uint64_t(previous+row)*k]:packedA[uint64_t(previous+row)*32];
                const auto inputB=direct?b[uint64_t(expert)*k*n+col]:packedB[uint64_t(expert)*GPK*PN+col*GPK];
                const auto nextInputB=direct?b[uint64_t(expert)*k*n+nextCol]:packedB[uint64_t(expert)*GPK*PN+nextCol*GPK];
                ResidentA<Panels,Direct,TM,TN>(inputA,inputB,scratch[slot*SLOT],
                    rows,cols,k,n,READY+slot,cachedRow!=previous+row || cachedRows!=rows,pendingB,
                    nextInputB,Min(TN,n-nextCol),next,bPhase,pack);
                bPhase=next?(bPhase+Panels)%Geometry<Panels,TM,TN>::B_BANKS:0;
                pendingB=next;cachedRow=previous+row;cachedRows=rows;
                cachedExpert=expert;cachedCol=col;
            } else {
                EpilogueChunks<TM,TN>(scratch[slot*SLOT],scales[uint64_t(expert)*n],out[uint64_t(previous+row)*n+col],
                    rows,cols,n,slot,secondBufferUsed,produced>0,task==taskFirst,col,TN);
            }
            ++produced;
        }
        previous=end;base+=tasks*cost;
    }
    if ASCEND_IS_AIC {
        if(produced)CrossCoreWaitFlag<2,PIPE_FIX>(DONE);
        if(produced>1)CrossCoreWaitFlag<2,PIPE_FIX>(DONE+1);
        if(produced)CrossCoreWaitFlag<2,PIPE_S>(12);
        const uint64_t began=GetSystemCycle();while(uint64_t(GetSystemCycle())-began<tailDelayTicks){}
    } else if(produced) {
        WaitFlag<HardEvent::V_MTE2>(EVENT_ID4);WaitFlag<HardEvent::MTE3_V>(EVENT_ID7);
        if(secondBufferUsed)WaitFlag<HardEvent::MTE3_V>(EVENT_ID6);
        CrossCoreSetFlag<2,PIPE_MTE3>(12);
    }
    PipeBarrier<PIPE_ALL>();
    if ASCEND_IS_AIC {set_ctrl(savedCtrl);}
}

// K capacity fixes the L1 offsets and the inner panel schedule for every shape in its bucket.
__aicore__ inline void GroupedMatmulGeluBaseline(GM_ADDR x,GM_ADDR weight,
    GM_ADDR scale,GM_ADDR groups,GM_ADDR y,GM_ADDR workspace,uint32_t e,
    uint32_t k,uint32_t n,uint32_t workers,uint64_t delay)
{
    const bool direct=k%32==0 && n%32==0;
    GlobalTensor<int64_t> ends;ends.SetGlobalBuffer((__gm__ int64_t*)groups);
    const bool wide=uint32_t(ends.GetValue(e-1))<=e*64 && n>=512;
#define GMM_MATRIX_RUN(P,D) if(wide)Run<P,D,64,512>(x,weight,scale,groups,y,workspace,e,k,n,workers,delay);else Run<P,D,128,256>(x,weight,scale,groups,y,workspace,e,k,n,workers,delay)
#define GMM_MATRIX_CAPACITY(P) case P: if(direct){GMM_MATRIX_RUN(P,true);}else{GMM_MATRIX_RUN(P,false);}break
    switch((k+255)/256) {
        GMM_MATRIX_CAPACITY(1);GMM_MATRIX_CAPACITY(2);GMM_MATRIX_CAPACITY(3);GMM_MATRIX_CAPACITY(4);
        GMM_MATRIX_CAPACITY(5);GMM_MATRIX_CAPACITY(6);GMM_MATRIX_CAPACITY(7);GMM_MATRIX_CAPACITY(8);
    }
#undef GMM_MATRIX_CAPACITY
#undef GMM_MATRIX_RUN
}
}

namespace gmmSingleExpert {
using namespace AscendC;
constexpr uint32_t TM=2,TN=128,BK=128;
constexpr uint32_t B_BYTES=BK*TN,A_BYTES=TM*BK;
constexpr uint32_t WH=B_BYTES,WF=WH+2*B_BYTES,PRODUCTS=WF+4*B_BYTES;
constexpr uint32_t AV=PRODUCTS+4*B_BYTES,AH=AV+A_BYTES,AF=AH+2*A_BYTES;
// Broadcast seeds reuse B's input bytes after its conversion to FP32.
constexpr uint32_t SEEDS=0,TOTAL=AF+4*A_BYTES,PARTIAL=TOTAL+TM*TN*4;
constexpr uint32_t Z=PARTIAL+TN*4,T=Z+TM*TN*4,SCALE=T+TM*TN*4,RESULT=SCALE+TN*4;
constexpr uint32_t UB_BYTES=RESULT+TM*TN*2;
template<HardEvent Event> __aicore__ inline void Fence() {
    SetFlag<Event>(EVENT_ID0);WaitFlag<Event>(EVENT_ID0);
}
__aicore__ inline uint32_t Min(uint32_t a,uint32_t b){return a<b?a:b;}
__aicore__ inline uint32_t Round(uint32_t a,uint32_t b){return (a+b-1)/b*b;}

__aicore__ inline void Resident(GM_ADDR x,GM_ADDR weight,GM_ADDR scale,GM_ADDR y,
    uint32_t m,uint32_t k,uint32_t n,uint32_t workers,uint64_t delay) {
 if ASCEND_IS_AIV {
    GlobalTensor<int8_t> a,b;GlobalTensor<float> scales;GlobalTensor<half> out;
    a.SetGlobalBuffer((__gm__ int8_t*)x);b.SetGlobalBuffer((__gm__ int8_t*)weight);
    scales.SetGlobalBuffer((__gm__ float*)scale);out.SetGlobalBuffer((__gm__ half*)y);
    LocalTensor<int8_t> bv(TPosition::VECIN,0,B_BYTES),av(TPosition::VECIN,AV,A_BYTES);
    LocalTensor<float> sv(TPosition::VECIN,SCALE,TN);
    LocalTensor<half> result(TPosition::VECOUT,RESULT,TM*TN);
    if(k<BK || n<TN)Duplicate(bv.ReinterpretCast<int32_t>(),int32_t(0),B_BYTES/4);
    if(k<BK)Duplicate(av.ReinterpretCast<int32_t>(),int32_t(0),A_BYTES/4);
    if(n<TN)Duplicate(sv,0.0f,TN);
    Fence<HardEvent::V_MTE2>();
    if(n==TN)copy_gm_to_ubuf((__ubuf__ int8_t*)0,(__gm__ int8_t*)weight,0,1,k*TN/32,0,0);
    else DataCopyPad(bv,b,DataCopyExtParams{uint16_t(k),n,0,(TN-Round(n,32))/32,0},
        DataCopyPadExtParams<int8_t>{true,0,uint8_t(Round(n,32)-n),0});
    DataCopyPad(sv,scales,DataCopyExtParams{1,n*4,0,0,0},DataCopyPadExtParams<float>{true,0,uint8_t(Round(n,8)-n),0});
    Fence<HardEvent::MTE2_V>();
    auto wh=(__ubuf__ half*)WH;auto wf=(__ubuf__ float*)WF;
    auto prod=(__ubuf__ float*)PRODUCTS;auto ah=(__ubuf__ half*)AH;
    auto af=(__ubuf__ float*)AF;auto seeds=(__ubuf__ float*)SEEDS;
    auto z=(__ubuf__ float*)Z;auto t=(__ubuf__ float*)T;
    set_vector_mask(~0ULL,~0ULL);
    vconv_s82f16(wh,(__ubuf__ int8_t*)0,BK*TN/128,1,1,8,4);pipe_barrier(PIPE_V);
    set_vector_mask(0,~0ULL);
    vconv_f162f32(wf,wh,BK*TN/128,1,1,8,4);
    vconv_f162f32(wf+BK*TN/2,wh+BK*TN/2,BK*TN/128,1,1,8,4);pipe_barrier(PIPE_V);
    for(uint32_t row=GetBlockIdx()*TM;row<m;row+=workers*TM) {
        const uint32_t rows=Min(TM,m-row);
        if(k==BK)copy_gm_to_ubuf((__ubuf__ int8_t*)AV,(__gm__ int8_t*)x+uint64_t(row)*k,0,1,rows*BK/32,0,0);
        else if(k%32==0)copy_gm_to_ubuf((__ubuf__ int8_t*)AV,(__gm__ int8_t*)x+uint64_t(row)*k,0,rows,k/32,0,(BK-k)/32);
        else DataCopyPad(av,a[uint64_t(row)*k],DataCopyExtParams{uint16_t(rows),k,0,(BK-Round(k,32))/32,0},
            DataCopyPadExtParams<int8_t>{true,0,uint8_t(Round(k,32)-k),0});
        Fence<HardEvent::MTE2_V>();
        set_vector_mask(~0ULL,~0ULL);
        vconv_s82f16(ah,(__ubuf__ int8_t*)AV,rows,1,1,8,4);pipe_barrier(PIPE_V);
        set_vector_mask(0,~0ULL);
        vconv_f162f32(af,ah,rows*2,1,1,8,4);pipe_barrier(PIPE_V);
        vbrcb((__ubuf__ uint32_t*)seeds,(__ubuf__ uint32_t*)af,1,8,rows*BK/8);pipe_barrier(PIPE_V);
        #pragma unroll 1
        for(uint32_t r=0;r<rows;++r) {
            vmul(prod,wf,seeds+r*BK*8,BK/2,1,1,0,TN/8,TN/8,1);
            vmul(prod+64,wf+64,seeds+r*BK*8,BK/2,1,1,0,TN/8,TN/8,1);pipe_barrier(PIPE_V);
            vmla(prod,wf+BK/2*TN,seeds+r*BK*8+BK/2*8,BK/2,1,1,0,TN/8,TN/8,1);
            vmla(prod+64,wf+BK/2*TN+64,seeds+r*BK*8+BK/2*8,BK/2,1,1,0,TN/8,TN/8,1);pipe_barrier(PIPE_V);
            #pragma unroll
            for(uint32_t rem=BK/4;rem;rem/=2){vadd(prod,prod,prod+rem*TN,rem*2,1,1,1,8,8,8);pipe_barrier(PIPE_V);}
            vmul(z+r*TN,prod,(__ubuf__ float*)SCALE,2,1,1,1,8,8,8);pipe_barrier(PIPE_V);
        }
        const uint32_t repeats=rows*TN/64;
        vmul(t,z,z,repeats,1,1,1,8,8,8);pipe_barrier(PIPE_V);
        vmuls(t,t,-0.07135481387376785f,repeats,1,1,8,8);pipe_barrier(PIPE_V);
        vadds(t,t,-1.5957691216057308f,repeats,1,1,8,8);pipe_barrier(PIPE_V);
        vmul(t,t,z,repeats,1,1,1,8,8,8);pipe_barrier(PIPE_V);
        vexp(t,t,repeats,1,1,8,8);pipe_barrier(PIPE_V);
        vadds(t,t,1.f,repeats,1,1,8,8);pipe_barrier(PIPE_V);
        vdiv(z,z,t,repeats,1,1,1,8,8,8);pipe_barrier(PIPE_V);
        vconv_f322f16r((__ubuf__ half*)RESULT,z,repeats,1,1,4,8);
        Fence<HardEvent::V_MTE3>();
        if(n==TN)copy_ubuf_to_gm((__gm__ half*)y+uint64_t(row)*n,(__ubuf__ half*)RESULT,0,1,rows*TN/16,0,0);
        else if(n%16==0)copy_ubuf_to_gm((__gm__ half*)y+uint64_t(row)*n,(__ubuf__ half*)RESULT,0,rows,n/16,(TN-n)/16,0);
        else DataCopyPad(out[uint64_t(row)*n],result,DataCopyExtParams{uint16_t(rows),n*2,(TN-Round(n,16))/16,0,0});
        Fence<HardEvent::MTE3_V>();
    }
    set_vector_mask(~0ULL,~0ULL);
    Fence<HardEvent::MTE3_S>();
    const uint64_t tick=GetSystemCycle();while(GetSystemCycle()-tick<delay){}
    PipeBarrier<PIPE_ALL>();
 }
}

// Each row pair shares B's conversion. K128 sums are exact in FP32;
// multiple K blocks accumulate in INT32 before scaling.
__aicore__ inline void SingleExpert(GM_ADDR x,GM_ADDR weight,GM_ADDR scale,GM_ADDR y,
    uint32_t m,uint32_t k,uint32_t n,uint32_t workers,uint64_t delay) {
    if(k<=BK && n<=TN){Resident(x,weight,scale,y,m,k,n,workers,delay);return;}
    GlobalTensor<int8_t> a,b;GlobalTensor<float> scales;GlobalTensor<half> out;
    a.SetGlobalBuffer((__gm__ int8_t*)x);b.SetGlobalBuffer((__gm__ int8_t*)weight);
    scales.SetGlobalBuffer((__gm__ float*)scale);out.SetGlobalBuffer((__gm__ half*)y);
    LocalTensor<int8_t> bv(TPosition::VECIN,0,BK*TN);
    LocalTensor<half> wh(TPosition::VECCALC,WH,BK*TN);
    LocalTensor<float> wf(TPosition::VECCALC,WF,BK*TN),products(TPosition::VECCALC,PRODUCTS,BK*TN);
    LocalTensor<int8_t> av(TPosition::VECIN,AV,A_BYTES);
    LocalTensor<half> ah(TPosition::VECCALC,AH,A_BYTES);
    LocalTensor<float> af(TPosition::VECCALC,AF,A_BYTES),seeds(TPosition::VECCALC,SEEDS,A_BYTES*8);
    LocalTensor<int32_t> total(TPosition::VECCALC,TOTAL,TM*TN),partial(TPosition::VECCALC,PARTIAL,TN);
    LocalTensor<float> z(TPosition::VECCALC,Z,TM*TN),t(TPosition::VECCALC,T,TM*TN);
    LocalTensor<float> sv(TPosition::VECIN,SCALE,TN);
    LocalTensor<half> result(TPosition::VECOUT,RESULT,TM*TN);
    const uint32_t columns=(n+TN-1)/TN,rowTiles=(m+TM-1)/TM;
    const bool multiBlock=k>BK;
    for(uint64_t task=GetBlockIdx();task<uint64_t(rowTiles)*columns;task+=workers) {
        const uint32_t row=uint32_t(task/columns)*TM,col=uint32_t(task%columns)*TN;
        const uint32_t rows=Min(TM,m-row),cols=Min(TN,n-col),count=rows*TN;
        if(cols<TN)Duplicate(sv,0.0f,TN);
        Fence<HardEvent::V_MTE2>();
        DataCopyPad(sv,scales[col],DataCopyExtParams{1,cols*4,0,0,0},
            DataCopyPadExtParams<float>{true,0,uint8_t(Round(cols,8)-cols),0});
        for(uint32_t begin=0;begin<k;begin+=BK) {
            const uint32_t depth=Min(BK,k-begin),paddedColumns=Round(cols,32),paddedDepth=Round(depth,32);
            if(depth<BK || cols<TN)Duplicate(bv.ReinterpretCast<int32_t>(),int32_t(0),B_BYTES/4);
            if(depth<BK)Duplicate(av.ReinterpretCast<int32_t>(),int32_t(0),A_BYTES/4);
            Fence<HardEvent::V_MTE2>();
            DataCopyPad(bv,b[uint64_t(begin)*n+col],
                DataCopyExtParams{uint16_t(depth),cols,n-cols,(TN-paddedColumns)/32,0},
                DataCopyPadExtParams<int8_t>{true,0,uint8_t(paddedColumns-cols),0});
            DataCopyPad(av,a[uint64_t(row)*k+begin],
                DataCopyExtParams{uint16_t(rows),depth,k-depth,(BK-paddedDepth)/32,0},
                DataCopyPadExtParams<int8_t>{true,0,uint8_t(paddedDepth-depth),0});
            Fence<HardEvent::MTE2_V>();
            Cast(wh,bv,RoundMode::CAST_NONE,BK*TN);
            Cast(ah,av,RoundMode::CAST_NONE,rows*BK);PipeBarrier<PIPE_V>();
            Cast(wf,wh,RoundMode::CAST_NONE,BK*TN);
            Cast(af,ah,RoundMode::CAST_NONE,rows*BK);PipeBarrier<PIPE_V>();
            Brcb(seeds,af,rows*BK/8,{1,8});PipeBarrier<PIPE_V>();
            for(uint32_t r=0;r<rows;++r) {
                Mul(products,wf,seeds[r*BK*8],uint64_t(64),uint8_t(BK),{1,1,0,16,16,1});
                Mul(products[64],wf[64],seeds[r*BK*8],uint64_t(64),uint8_t(BK),{1,1,0,16,16,1});PipeBarrier<PIPE_V>();
                for(uint32_t remaining=BK/2;remaining;remaining/=2) {
                    Add(products,products,products[remaining*TN],remaining*TN);PipeBarrier<PIPE_V>();
                }
                if(!multiBlock)Mul(z[r*TN],products,sv,TN);
                else if(begin==0)Cast(total[r*TN],products,RoundMode::CAST_RINT,TN);
                else {
                    Cast(partial,products,RoundMode::CAST_RINT,TN);PipeBarrier<PIPE_V>();
                    Add(total[r*TN],total[r*TN],partial,TN);
                }
                PipeBarrier<PIPE_V>();
            }
        }
        if(multiBlock) {
            Cast(z,total,RoundMode::CAST_RINT,count);PipeBarrier<PIPE_V>();
            for(uint32_t r=0;r<rows;++r)Mul(z[r*TN],z[r*TN],sv,TN);
            PipeBarrier<PIPE_V>();
        }
        Mul(t,z,z,count);PipeBarrier<PIPE_V>();
        Muls(t,t,-0.07135481387376785f,count);PipeBarrier<PIPE_V>();
        Adds(t,t,-1.5957691216057308f,count);PipeBarrier<PIPE_V>();
        Mul(t,t,z,count);PipeBarrier<PIPE_V>();
        Exp(t,t,count);PipeBarrier<PIPE_V>();
        Adds(t,t,1.0f,count);PipeBarrier<PIPE_V>();
        Div(z,z,t,count);PipeBarrier<PIPE_V>();
        Cast(result,z,RoundMode::CAST_RINT,count);Fence<HardEvent::V_MTE3>();
        DataCopyPad(out[uint64_t(row)*n+col],result,
            DataCopyExtParams{uint16_t(rows),cols*2,(TN-Round(cols,16))/16,(n-cols)*2,0});
        Fence<HardEvent::MTE3_V>();
    }
    Fence<HardEvent::MTE3_S>();
    const uint64_t start=GetSystemCycle();while(uint64_t(GetSystemCycle())-start<delay){}
    PipeBarrier<PIPE_ALL>();
}
}

namespace gmmK1 {
using namespace AscendC;
__aicore__ inline void GroupedMatmulGeluBaseline(GM_ADDR x,GM_ADDR weight,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,uint32_t m,uint32_t e,uint32_t n,uint32_t workers,uint64_t delay) {

    constexpr uint32_t N=4096;
    GlobalTensor<int8_t> a,b;GlobalTensor<float> s;GlobalTensor<int64_t> ends;GlobalTensor<half> out;
    a.SetGlobalBuffer((__gm__ int8_t*)x);b.SetGlobalBuffer((__gm__ int8_t*)weight);
    s.SetGlobalBuffer((__gm__ float*)scale);ends.SetGlobalBuffer((__gm__ int64_t*)groups);out.SetGlobalBuffer((__gm__ half*)y);
    LocalTensor<int8_t> av(TPosition::VECIN,0,8192),bv(TPosition::VECIN,58368,N);
    LocalTensor<half> ah(TPosition::VECCALC,8192,8192),bh(TPosition::VECCALC,62464,N);
    LocalTensor<float> af(TPosition::VECCALC,24576,8192),wf(TPosition::VECCALC,70656,N),sv(TPosition::VECIN,87296,N);
    LocalTensor<uint8_t> mask(TPosition::VECCALC,57344,1024);
    LocalTensor<float> z(TPosition::VECCALC,103936,N),t(TPosition::VECCALC,120576,N);
    LocalTensor<half> result(TPosition::VECOUT,137216,N*2);
    uint32_t start=0,outputSequence=0;
    for(uint32_t expert=0;expert<e;++expert) {
        uint32_t end=uint32_t(ends.GetValue(expert)),length=end-start;
        if(length) {
            const uint32_t padded=(length+63)/64*64;
            DataCopyPad(av,a[start],DataCopyExtParams{1,length,0,0,0},DataCopyPadExtParams<int8_t>{true,0,0,0});
            DataCopyPad(bv,b[uint64_t(expert)*n],DataCopyExtParams{1,n,0,0,0},DataCopyPadExtParams<int8_t>{true,0,0,0});
            DataCopyPad(sv,s[uint64_t(expert)*n],DataCopyExtParams{1,n*4,0,0,0},DataCopyPadExtParams<float>{true,0,0,0});
            gmmStream::Fence<HardEvent::MTE2_V>();
            Cast(ah,av,RoundMode::CAST_NONE,padded);Cast(bh,bv,RoundMode::CAST_NONE,N);PipeBarrier<PIPE_V>();
            Cast(af,ah,RoundMode::CAST_NONE,padded);Cast(wf,bh,RoundMode::CAST_NONE,N);PipeBarrier<PIPE_V>();
            for(uint32_t value=GetBlockIdx();value<256;value+=workers) {
                const float xvalue=float(int32_t(value)-128);
                Compares(mask,af,xvalue,CMPMODE::EQ,padded);
                gmmStream::Fence<HardEvent::V_S>();
                auto present=mask.ReinterpretCast<uint64_t>();
                uint32_t firstWord=0;
                while(firstWord<padded/64 && !present.GetValue(firstWord))++firstWord;
                if(firstWord==padded/64)continue;
                Muls(z,wf,xvalue,N);PipeBarrier<PIPE_V>();Mul(z,z,sv,N);PipeBarrier<PIPE_V>();
                Mul(t,z,z,N);PipeBarrier<PIPE_V>();Muls(t,t,-0.07135481387376785f,N);PipeBarrier<PIPE_V>();
                Adds(t,t,-1.5957691216057308f,N);PipeBarrier<PIPE_V>();Mul(t,t,z,N);PipeBarrier<PIPE_V>();
                Exp(t,t,N);PipeBarrier<PIPE_V>();Adds(t,t,1.f,N);PipeBarrier<PIPE_V>();Div(z,z,t,N);PipeBarrier<PIPE_V>();
                const uint32_t slot=outputSequence%2;
                const event_t released=slot?EVENT_ID3:EVENT_ID2;
                if(outputSequence>=2)WaitFlag<HardEvent::MTE3_V>(released);
                Cast(result[slot*N],z,RoundMode::CAST_RINT,N);gmmStream::Fence<HardEvent::V_MTE3>();
                gmmStream::Fence<HardEvent::V_S>();
                auto bits=mask.ReinterpretCast<uint64_t>();
                for(uint32_t word=firstWord;word<padded/64;++word) {
                    uint64_t matches=bits.GetValue(word);
                    while(matches) {
                        const uint32_t bit=63-uint32_t(CountLeadingZero(matches));
                        const uint32_t row=word*64+bit;
                        if(row<length)DataCopyPad(out[uint64_t(start+row)*n],result[slot*N],DataCopyExtParams{1,n*2,0,0,0});
                        matches^=1ULL<<bit;
                    }
                }
                SetFlag<HardEvent::MTE3_V>(released);++outputSequence;
            }
            gmmStream::Fence<HardEvent::V_MTE2>();
        }
        start=end;
    }
    if(outputSequence)WaitFlag<HardEvent::MTE3_V>(EVENT_ID2);
    if(outputSequence>1)WaitFlag<HardEvent::MTE3_V>(EVENT_ID3);
    gmmStream::Fence<HardEvent::MTE3_S>();
    const uint64_t tick=GetSystemCycle();while(GetSystemCycle()-tick<delay){}
}
}

namespace gmmNarrowColumn {
using namespace AscendC;
constexpr uint32_t TM=64,TN=32,STEP=512,SLOTS=2;
__aicore__ inline void GroupedMatmulGeluBaseline(GM_ADDR x,GM_ADDR weight,GM_ADDR scale,
    GM_ADDR groups,GM_ADDR y,GM_ADDR workspace,uint32_t m,uint32_t k,uint32_t e,uint32_t workers,uint64_t delay) {
    const uint32_t KP=(k+STEP-1)/STEP*STEP;
    GlobalTensor<int8_t> a,b;GlobalTensor<float> s;GlobalTensor<int64_t> ends;
    GlobalTensor<int32_t> scratch;GlobalTensor<half> out;
    a.SetGlobalBuffer((__gm__ int8_t*)x);b.SetGlobalBuffer((__gm__ int8_t*)weight);
    s.SetGlobalBuffer((__gm__ float*)scale);ends.SetGlobalBuffer((__gm__ int64_t*)groups);out.SetGlobalBuffer((__gm__ half*)y);
    uint32_t worker;if ASCEND_IS_AIC {worker=GetBlockIdx();}else{worker=GetBlockIdx()/2;}
    scratch.SetGlobalBuffer((__gm__ int32_t*)workspace+worker*SLOTS*TM*TN);
    GlobalTensor<int8_t> packed;
    packed.SetGlobalBuffer((__gm__ int8_t*)workspace+workers*SLOTS*TM*TN*4);
    if ASCEND_IS_AIV {
        LocalTensor<int8_t> input(TPosition::VECIN,0,KP);
        LocalTensor<uint32_t> expansion(TPosition::VECCALC,8192,KP*8);
        for(uint32_t expert=GetBlockIdx();expert<e;expert+=workers*2) {
            if(uint32_t(ends.GetValue(expert))==(expert?uint32_t(ends.GetValue(expert-1)):0))continue;
            const uint32_t alignedK=(k+31)/32*32;
            if(alignedK<KP) {
                Duplicate(input[alignedK].ReinterpretCast<int32_t>(),int32_t(0),(KP-alignedK)/4);
                gmmStream::Fence<HardEvent::V_MTE2>();
            }
            DataCopyPad(input,b[uint64_t(expert)*k],DataCopyExtParams{1,k,0,0,0},DataCopyPadExtParams<int8_t>{true,0,uint8_t(alignedK-k),0});
            gmmStream::Fence<HardEvent::MTE2_V>();
            Brcb(expansion,input.ReinterpretCast<uint32_t>(),uint8_t(KP/32),{4,32});PipeBarrier<PIPE_V>();
            for(uint32_t phase=1;phase<4;++phase)DataCopy(expansion[phase*8],expansion,DataCopyParams{uint16_t(KP/4),1,3,3});
            PipeBarrier<PIPE_V>();
            for(uint32_t phase=1;phase<4;++phase)for(uint32_t word=0;word<KP/4;word+=128) {
                auto values=expansion[phase*8+word*32];
                ShiftRight(values,values,uint32_t(phase*8),uint64_t(8),uint8_t(gmmStream::Min(128,KP/4-word)),{1,1,4,4});
            }
            gmmStream::Fence<HardEvent::V_MTE3>();
            DataCopy(packed[uint64_t(expert)*KP*TN],expansion.ReinterpretCast<int8_t>(),KP*TN);
            gmmStream::Fence<HardEvent::MTE3_V>();
        }
        SyncAll<true>();CrossCoreSetFlag<2,PIPE_MTE3>(12);
    } else {CrossCoreWaitFlag<2,PIPE_MTE2>(12);}
    LocalTensor<uint32_t> indices(TPosition::VECCALC,6144,64);
    if ASCEND_IS_AIV {
        for(uint32_t i=0;i<64;++i)indices.SetValue(i,(i%32)*TN*4);
        gmmStream::Fence<HardEvent::S_V>();
    }
    uint32_t previous=0,prefix=0,sequence=0;
    for(uint32_t expert=0;expert<e;++expert) {
        const uint32_t end=uint32_t(ends.GetValue(expert)),length=end-previous,tiles=(length+TM-1)/TM;
        uint32_t local=(worker+workers-prefix%workers)%workers;
        if(local<tiles) {
            if ASCEND_IS_AIC {
                LocalTensor<int8_t> b1(TPosition::A1,TM*KP,KP*TN);
                DataCopy(b1,packed[uint64_t(expert)*KP*TN],KP*TN);
                gmmStream::Fence<HardEvent::MTE2_MTE1>();
            }
            for(;local<tiles;local+=workers,++sequence) {
                const uint32_t row=previous+local*TM,rows=gmmStream::Min(TM,end-row),slot=sequence%SLOTS;
                const bool reuse=sequence>=SLOTS;
                if ASCEND_IS_AIC {
                    if(reuse)CrossCoreWaitFlag<2,PIPE_FIX>(8+slot);
                    LocalTensor<int8_t> a1(TPosition::A1,0,TM*KP),b1(TPosition::A1,TM*KP,KP*TN);
                    DataCopy(a1,a[uint64_t(row)*k],Nd2NzParams{1,uint16_t(rows),uint16_t(k),0,uint16_t(k),TM,1,0});
                    gmmStream::Fence<HardEvent::MTE2_MTE1>();
                    LocalTensor<int32_t> c(TPosition::CO1,slot*TM*TN*4,TM*TN);
                    for(uint32_t start=0;start<KP;start+=STEP) {
                        const uint32_t bank=start/STEP%2;const event_t ev=bank?EVENT_ID1:EVENT_ID0;
                        if(start>=2*STEP)WaitFlag<HardEvent::M_MTE1>(ev);
                        LocalTensor<int8_t> a0(TPosition::A2,bank*TM*STEP,TM*STEP),b0(TPosition::B2,bank*STEP*TN,STEP*TN);
                        LoadData2DParams ap;ap.repeatTimes=STEP/32;ap.srcStride=TM/16;
                        for(uint32_t r=0;r<(rows+15)/16;++r)LoadData(a0[r*STEP*16],a1[start*TM+r*512],ap);
                        LoadData2dTransposeParams bp;bp.repeatTimes=STEP/32;bp.srcStride=1;bp.dstGap=TN/16-1;
                        LoadDataWithTranspose(b0,b1[start*TN],bp);
                        SetFlag<HardEvent::MTE1_M>(ev);WaitFlag<HardEvent::MTE1_M>(ev);
                        MmadParams mm;mm.m=(rows+15)/16*16;mm.n=TN;mm.k=STEP;mm.cmatrixInitVal=start==0;
                        Mmad(c,a0,b0,mm);SetFlag<HardEvent::M_MTE1>(ev);
                    }
                    WaitFlag<HardEvent::M_MTE1>(EVENT_ID0);if(KP>STEP)WaitFlag<HardEvent::M_MTE1>(EVENT_ID1);
                    gmmStream::Fence<HardEvent::M_FIX>();
                    FixpipeParamsV220 fp;fp.mSize=(rows+15)/16*16;fp.nSize=TN;fp.srcStride=fp.mSize;fp.dstStride=TN;
                    Fixpipe<int32_t,int32_t,CFG_ROW_MAJOR>(scratch[slot*TM*TN],c,fp);
                    CrossCoreSetFlag<2,PIPE_FIX>(4+slot);gmmStream::Fence<HardEvent::FIX_M>();
                    gmmStream::Fence<HardEvent::MTE1_MTE2>();
                }else{
                    constexpr uint32_t H=TM/2,C=H*TN;
                    const uint32_t sub=GetSubBlockIdx(),take=rows>sub*H?gmmStream::Min(H,rows-sub*H):0;
                    CrossCoreWaitFlag<2,PIPE_MTE2>(4+slot);
                    if(take) {
                        LocalTensor<int32_t> ints(TPosition::VECIN,0,C);
                        LocalTensor<int32_t> dots(TPosition::VECCALC,4096,64);
                        LocalTensor<float> z(TPosition::VECCALC,4352,64),t(TPosition::VECCALC,4864,64);
                        LocalTensor<half> result(TPosition::VECOUT,5376,64);
                        DataCopy(ints,scratch[slot*TM*TN+sub*C],C);gmmStream::Fence<HardEvent::MTE2_V>();
                        Gather(dots,ints,indices,0,64);PipeBarrier<PIPE_V>();
                        Cast(z,dots,RoundMode::CAST_RINT,64);PipeBarrier<PIPE_V>();
                        Muls(z,z,s.GetValue(expert),64);PipeBarrier<PIPE_V>();
                        Mul(t,z,z,64);PipeBarrier<PIPE_V>();Muls(t,t,-0.07135481387376785f,64);PipeBarrier<PIPE_V>();
                        Adds(t,t,-1.5957691216057308f,64);PipeBarrier<PIPE_V>();Mul(t,t,z,64);PipeBarrier<PIPE_V>();
                        Exp(t,t,64);PipeBarrier<PIPE_V>();Adds(t,t,1.0f,64);PipeBarrier<PIPE_V>();Div(z,z,t,64);PipeBarrier<PIPE_V>();
                        Cast(result,z,RoundMode::CAST_RINT,64);gmmStream::Fence<HardEvent::V_MTE3>();
                        DataCopyPad(out[row+sub*H],result,DataCopyExtParams{1,take*2,0,0,0});gmmStream::Fence<HardEvent::MTE3_S>();
                    }
                    CrossCoreSetFlag<2,PIPE_MTE3>(8+slot);
                }
            }
        }
        previous=end;prefix+=tiles;
    }
    if ASCEND_IS_AIC {
        for(uint32_t slot=0;slot<gmmStream::Min(sequence,SLOTS);++slot)CrossCoreWaitFlag<2,PIPE_S>(8+slot);
        const uint64_t start=GetSystemCycle();while(uint64_t(GetSystemCycle())-start<delay){}
    }
    PipeBarrier<PIPE_ALL>();
}
}

// INT8 long-K stream: bounded L1 panel ring, packed tails, exact INT32 sum.
namespace gmmLongKCurrent {
using namespace AscendC;
constexpr uint32_t TM=96,TN=256,SPAN=640,STEP=128,BANKS=2;
constexpr uint32_t PANEL_BYTES=(TM+TN)*SPAN;
constexpr uint32_t OUT_SLOTS=2;
template<HardEvent E> __aicore__ inline void Fence() {
    SetFlag<E>(EVENT_ID0);WaitFlag<E>(EVENT_ID0);
}
__aicore__ inline uint32_t Min(uint32_t a,uint32_t b) {return a<b?a:b;}
__aicore__ inline uint32_t Round(uint32_t a,uint32_t b) {return (a+b-1)/b*b;}

__aicore__ inline void Prepare(GlobalTensor<int8_t> a,GlobalTensor<int8_t> b,
    uint32_t rows,uint32_t cols,uint32_t k,uint32_t n,uint32_t panel) {
    const uint32_t bank=panel%BANKS,depth=Min(SPAN,k-panel*SPAN);
    const event_t ev=event_t(uint32_t(EVENT_ID2)+bank);
    if(panel>=BANKS)WaitFlag<HardEvent::MTE1_MTE2>(ev);
    LocalTensor<int8_t> a1(TPosition::A1,bank*PANEL_BYTES,TM*SPAN);
    LocalTensor<int8_t> b1(TPosition::A1,bank*PANEL_BYTES+TM*SPAN,TN*SPAN);
    if(depth!=SPAN) {
        // Nd2Nz pads a partial C0 only; explicitly clear all consumed K lanes.
        InitConstValue(a1.ReinterpretCast<uint32_t>(),InitConstValueParams<uint32_t>{1,uint16_t(TM*SPAN/32),0,0});
        InitConstValue(b1.ReinterpretCast<uint32_t>(),InitConstValueParams<uint32_t>{1,uint16_t(TN*SPAN/32),0,0});
        PipeBarrier<PIPE_MTE2>();
    }
    DataCopy(a1,a[panel*SPAN],Nd2NzParams{1,uint16_t(rows),uint16_t(depth),0,uint16_t(k),TM,1,0});
    DataCopy(b1,b[uint64_t(panel*SPAN)*n],Nd2NzParams{1,uint16_t(depth),uint16_t(cols),0,uint16_t(n),SPAN,1,0});
    SetFlag<HardEvent::MTE2_MTE1>(ev);
}

__aicore__ inline void Cube(GlobalTensor<int8_t> a,GlobalTensor<int8_t> b,
    GlobalTensor<int32_t> scratch,uint32_t rows,uint32_t cols,uint32_t k,uint32_t n,uint32_t slot) {
    const uint32_t r=Round(rows,16)<32?32:Round(rows,16),c=Round(cols,64);
    const uint32_t panels=(k+SPAN-1)/SPAN;
    LocalTensor<int32_t> acc(TPosition::CO1,0,TM*TN);
    for(uint32_t p=0;p<Min(BANKS,panels);++p)Prepare(a,b,rows,cols,k,n,p);
    uint32_t sequence=0;
    for(uint32_t panel=0;panel<panels;++panel) {
        const uint32_t bank=panel%BANKS;
        const event_t ev=event_t(uint32_t(EVENT_ID2)+bank);
        WaitFlag<HardEvent::MTE2_MTE1>(ev);
        LocalTensor<int8_t> a1(TPosition::A1,bank*PANEL_BYTES,TM*SPAN);
        LocalTensor<int8_t> b1(TPosition::A1,bank*PANEL_BYTES+TM*SPAN,TN*SPAN);
        const uint32_t padded=Round(Min(SPAN,k-panel*SPAN),64);
        for(uint32_t start=0;start<padded;start+=STEP,++sequence) {
            const uint32_t d=Min(STEP,padded-start),l0slot=sequence%2;
            const event_t l0ev=l0slot?EVENT_ID1:EVENT_ID0;
            if(sequence>=2)WaitFlag<HardEvent::M_MTE1>(l0ev);
            LocalTensor<int8_t> a0(TPosition::A2,l0slot*TM*STEP,TM*STEP);
            LocalTensor<int8_t> b0(TPosition::B2,l0slot*TN*STEP,TN*STEP);
            LoadData2DParams ap;ap.repeatTimes=d/32;ap.srcStride=TM/16;
            for(uint32_t m=0;m<r/16;++m)LoadData(a0[m*d*16],a1[start*TM+m*512],ap);
            LoadData2dTransposeParams bp;bp.repeatTimes=d/32;bp.srcStride=1;bp.dstGap=c/16-1;
            for(uint32_t col=0;col<c/32;++col)LoadDataWithTranspose(b0[col*1024],b1[col*SPAN*32+start*32],bp);
            SetFlag<HardEvent::MTE1_M>(l0ev);WaitFlag<HardEvent::MTE1_M>(l0ev);
            MmadParams mm;mm.m=r;mm.n=c;mm.k=d;mm.cmatrixInitVal=sequence==0;
            Mmad(acc,a0,b0,mm);SetFlag<HardEvent::M_MTE1>(l0ev);
        }
        SetFlag<HardEvent::MTE1_MTE2>(ev);
        if(panel+BANKS<panels)Prepare(a,b,rows,cols,k,n,panel+BANKS);
    }
    WaitFlag<HardEvent::M_MTE1>(EVENT_ID0);
    if(sequence>1)WaitFlag<HardEvent::M_MTE1>(EVENT_ID1);
    for(uint32_t bank=0;bank<Min(BANKS,panels);++bank)
        WaitFlag<HardEvent::MTE1_MTE2>(event_t(uint32_t(EVENT_ID2)+bank));
    Fence<HardEvent::M_FIX>();
    FixpipeParamsV220 fp;fp.mSize=r;fp.nSize=c;fp.srcStride=r;fp.dstStride=c;
    Fixpipe<int32_t,int32_t,CFG_ROW_MAJOR>(scratch,acc,fp);
    CrossCoreSetFlag<2,PIPE_FIX>(4+slot);Fence<HardEvent::FIX_M>();
}

__aicore__ inline void Epilogue(GlobalTensor<int32_t> scratch,GlobalTensor<float> scales,
    GlobalTensor<half> out,uint32_t rows,uint32_t cols,uint32_t n,uint32_t slot) {
    constexpr uint32_t CAP=TM/2*TN;
    const uint32_t r=Round(rows,16)<32?32:Round(rows,16),h=r/2,c=Round(cols,64),count=h*c,sub=GetSubBlockIdx();
    LocalTensor<int32_t> ints(TPosition::VECIN,0,CAP);
    LocalTensor<float> z(TPosition::VECCALC,CAP*4+256,CAP),t(TPosition::VECCALC,0,CAP);
    LocalTensor<float> s(TPosition::VECIN,CAP*8+512,TN);
    LocalTensor<half> result(TPosition::VECOUT,CAP*8+512+TN*4,CAP);
    DataCopyPad(s,scales,DataCopyExtParams{1,cols*4,0,0,0},DataCopyPadExtParams<float>{true,0,0,0});
    CrossCoreWaitFlag<2,PIPE_MTE2>(4+slot);
    DataCopy(ints,scratch[sub*count],count);Fence<HardEvent::MTE2_V>();
    Cast(z,ints,RoundMode::CAST_RINT,count);PipeBarrier<PIPE_V>();
    for(uint32_t col=0;col<c;col+=64)
        Mul(z[col],z[col],s[col],uint64_t(64),uint8_t(h),{1,1,1,uint8_t(c/8),uint8_t(c/8),0});
    PipeBarrier<PIPE_V>();
    Mul(t,z,z,count);PipeBarrier<PIPE_V>();
    Muls(t,t,-0.07135481387376785f,count);PipeBarrier<PIPE_V>();
    Adds(t,t,-1.5957691216057308f,count);PipeBarrier<PIPE_V>();
    Mul(t,t,z,count);PipeBarrier<PIPE_V>();
    Exp(t,t,count);PipeBarrier<PIPE_V>();
    Adds(t,t,1.0f,count);PipeBarrier<PIPE_V>();
    Div(z,z,t,count);PipeBarrier<PIPE_V>();
    Cast(result,z,RoundMode::CAST_RINT,count);Fence<HardEvent::V_MTE3>();
    const uint32_t valid=rows>sub*h?Min(h,rows-sub*h):0;
    if(valid)DataCopyPad(out[uint64_t(sub*h)*n],result,DataCopyExtParams{uint16_t(valid),cols*2,(c-Round(cols,16))/16,(n-cols)*2,0});
    Fence<HardEvent::MTE3_S>();CrossCoreSetFlag<2,PIPE_MTE3>(6+slot);
}

__aicore__ inline void Run(GM_ADDR x,GM_ADDR weight,GM_ADDR scale,GM_ADDR y,GM_ADDR workspace,
    uint32_t e,uint32_t k,uint32_t n,uint32_t workers,uint64_t delay,const uint32_t* boundaries) {
    GlobalTensor<int8_t> a,b;GlobalTensor<float> s;
    GlobalTensor<half> out;GlobalTensor<int32_t> scratch;
    a.SetGlobalBuffer((__gm__ int8_t*)x);b.SetGlobalBuffer((__gm__ int8_t*)weight);
    s.SetGlobalBuffer((__gm__ float*)scale);out.SetGlobalBuffer((__gm__ half*)y);
    uint32_t worker;if ASCEND_IS_AIC {worker=GetBlockIdx();}else{worker=GetBlockIdx()/2;}
    scratch.SetGlobalBuffer((__gm__ int32_t*)workspace+uint64_t(worker)*OUT_SLOTS*TM*TN);
    uint32_t previous=0,base=0,produced=0;
    const uint32_t nt=(n+TN-1)/TN;
    for(uint32_t expert=0;expert<e;++expert) {
        const uint32_t end=boundaries[expert],length=end-previous,tasks=(length+TM-1)/TM*nt;
        const uint32_t first=(worker+workers-base%workers)%workers;
        for(uint32_t task=first;task<tasks;task+=workers) {
            const uint32_t row=task/nt*TM,col=task%nt*TN,rows=Min(TM,length-row),cols=Min(TN,n-col),slot=produced%OUT_SLOTS;
            if ASCEND_IS_AIC {
                if(produced>=OUT_SLOTS)CrossCoreWaitFlag<2,PIPE_S>(6+slot);
                Cube(a[uint64_t(previous+row)*k],b[uint64_t(expert)*k*n+col],scratch[slot*TM*TN],rows,cols,k,n,slot);
            }else{
                Epilogue(scratch[slot*TM*TN],s[uint64_t(expert)*n+col],out[uint64_t(previous+row)*n+col],rows,cols,n,slot);
            }
            ++produced;
        }
        base+=tasks;previous=end;
    }
    if ASCEND_IS_AIC {
        for(uint32_t slot=0;slot<Min(produced,OUT_SLOTS);++slot)CrossCoreWaitFlag<2,PIPE_S>(6+slot);
        const uint64_t start=GetSystemCycle();while(uint64_t(GetSystemCycle())-start<delay){}
    }
    PipeBarrier<PIPE_ALL>();
}
}

// INT8 long-K stream: bounded L1 panel ring, packed tails, exact INT32 sum.
namespace gmmLongKSplit {
using namespace AscendC;
constexpr uint32_t TM=192,TN=128,SPAN=768,STEP=128,BANKS=2;
constexpr uint32_t PANEL_BYTES=(TM+TN)*SPAN;
constexpr uint32_t OUT_SLOTS=2,PARTS=4;
template<HardEvent E> __aicore__ inline void Fence() {
    SetFlag<E>(EVENT_ID0);WaitFlag<E>(EVENT_ID0);
}
__aicore__ inline uint32_t Min(uint32_t a,uint32_t b) {return a<b?a:b;}
__aicore__ inline uint32_t Round(uint32_t a,uint32_t b) {return (a+b-1)/b*b;}

__aicore__ inline void Prepare(GlobalTensor<int8_t> a,GlobalTensor<int8_t> b,
    uint32_t rows,uint32_t cols,uint32_t depthK,uint32_t n,uint32_t panel,uint32_t sourceK) {
    const uint32_t bank=panel%BANKS,depth=Min(SPAN,depthK-panel*SPAN);
    const event_t ev=event_t(uint32_t(EVENT_ID2)+bank);
    if(panel>=BANKS)WaitFlag<HardEvent::MTE1_MTE2>(ev);
    LocalTensor<int8_t> a1(TPosition::A1,bank*PANEL_BYTES,TM*SPAN);
    LocalTensor<int8_t> b1(TPosition::A1,bank*PANEL_BYTES+TM*SPAN,TN*SPAN);
    if(depth%64!=0) {
        // Nd2Nz pads a partial C0 only; explicitly clear all consumed K lanes.
        InitConstValue(a1.ReinterpretCast<uint32_t>(),InitConstValueParams<uint32_t>{1,uint16_t(TM*SPAN/32),0,0});
        InitConstValue(b1.ReinterpretCast<uint32_t>(),InitConstValueParams<uint32_t>{1,uint16_t(TN*SPAN/32),0,0});
        PipeBarrier<PIPE_MTE2>();
    }
    DataCopy(a1,a[panel*SPAN],Nd2NzParams{1,uint16_t(rows),uint16_t(depth),0,uint16_t(sourceK),TM,1,0});
    DataCopy(b1,b[uint64_t(panel*SPAN)*n],Nd2NzParams{1,uint16_t(depth),uint16_t(cols),0,uint16_t(n),SPAN,1,0});
    SetFlag<HardEvent::MTE2_MTE1>(ev);
}

__aicore__ inline void Cube(GlobalTensor<int8_t> a,GlobalTensor<int8_t> b,
    GlobalTensor<int32_t> scratch,uint32_t rows,uint32_t cols,uint32_t k,uint32_t n,uint32_t slot,uint32_t part) {
    const uint32_t r=Round(rows,16)<32?32:Round(rows,16),c=Round(cols,64);
    const uint32_t allSteps=(k+STEP-1)/STEP,begin=allSteps*part/PARTS*STEP,end=Min(k,allSteps*(part+1)/PARTS*STEP);
    const uint32_t partK=end-begin,panels=(partK+SPAN-1)/SPAN;
    LocalTensor<int32_t> acc(TPosition::CO1,0,TM*TN);
    for(uint32_t p=0;p<Min(BANKS,panels);++p)Prepare(a[begin],b[uint64_t(begin)*n],rows,cols,partK,n,p,k);
    uint32_t sequence=0;
    for(uint32_t panel=0;panel<panels;++panel) {
        const uint32_t bank=panel%BANKS;
        const event_t ev=event_t(uint32_t(EVENT_ID2)+bank);
        WaitFlag<HardEvent::MTE2_MTE1>(ev);
        LocalTensor<int8_t> a1(TPosition::A1,bank*PANEL_BYTES,TM*SPAN);
        LocalTensor<int8_t> b1(TPosition::A1,bank*PANEL_BYTES+TM*SPAN,TN*SPAN);
        const uint32_t padded=Round(Min(SPAN,partK-panel*SPAN),64);
        for(uint32_t start=0;start<padded;start+=STEP,++sequence) {
            const uint32_t d=Min(STEP,padded-start),l0slot=sequence%2;
            const event_t l0ev=l0slot?EVENT_ID1:EVENT_ID0;
            if(sequence>=2)WaitFlag<HardEvent::M_MTE1>(l0ev);
            LocalTensor<int8_t> a0(TPosition::A2,l0slot*TM*STEP,TM*STEP);
            LocalTensor<int8_t> b0(TPosition::B2,l0slot*TN*STEP,TN*STEP);
            LoadData2DParams ap;ap.repeatTimes=d/32;ap.srcStride=TM/16;
            for(uint32_t m=0;m<r/16;++m)LoadData(a0[m*d*16],a1[start*TM+m*512],ap);
            LoadData2dTransposeParams bp;bp.repeatTimes=d/32;bp.srcStride=1;bp.dstGap=c/16-1;
            for(uint32_t col=0;col<c/32;++col)LoadDataWithTranspose(b0[col*1024],b1[col*SPAN*32+start*32],bp);
            SetFlag<HardEvent::MTE1_M>(l0ev);WaitFlag<HardEvent::MTE1_M>(l0ev);
            MmadParams mm;mm.m=r;mm.n=c;mm.k=d;mm.cmatrixInitVal=sequence==0;
            Mmad(acc,a0,b0,mm);SetFlag<HardEvent::M_MTE1>(l0ev);
        }
        SetFlag<HardEvent::MTE1_MTE2>(ev);
        if(panel+BANKS<panels)Prepare(a[begin],b[uint64_t(begin)*n],rows,cols,partK,n,panel+BANKS,k);
    }
    WaitFlag<HardEvent::M_MTE1>(EVENT_ID0);
    if(sequence>1)WaitFlag<HardEvent::M_MTE1>(EVENT_ID1);
    for(uint32_t bank=0;bank<Min(BANKS,panels);++bank)
        WaitFlag<HardEvent::MTE1_MTE2>(event_t(uint32_t(EVENT_ID2)+bank));
    Fence<HardEvent::M_FIX>();
    FixpipeParamsV220 fp;fp.mSize=r;fp.nSize=c;fp.srcStride=r;fp.dstStride=c;
    Fixpipe<int32_t,int32_t,CFG_ROW_MAJOR>(scratch,acc,fp);
    Fence<HardEvent::FIX_M>();
}

__aicore__ inline void Epilogue(GlobalTensor<int32_t> scratch,GlobalTensor<float> scales,
    GlobalTensor<half> out,uint32_t rows,uint32_t cols,uint32_t n,uint32_t slot) {
    constexpr uint32_t CAP=TM/2*TN;
    const uint32_t r=Round(rows,16)<32?32:Round(rows,16),h=r/2,c=Round(cols,64),count=h*c,sub=GetSubBlockIdx();
    LocalTensor<int32_t> ints(TPosition::VECIN,0,2*CAP);
    LocalTensor<float> z(TPosition::VECCALC,CAP*4+256,CAP),t(TPosition::VECCALC,0,CAP);
    LocalTensor<float> s(TPosition::VECIN,CAP*12+512,TN);
    LocalTensor<half> result(TPosition::VECOUT,CAP*12+512+TN*4,CAP);
    DataCopyPad(s,scales,DataCopyExtParams{1,cols*4,0,0,0},DataCopyPadExtParams<float>{true,0,0,0});
    
    // Merge each pair with one strided DMA, preserving integer accumulation.
    DataCopy(ints,scratch[sub*count],DataCopyParams{2,uint16_t(count/8),uint16_t((TM*TN-count)/8),0});
    Fence<HardEvent::MTE2_V>();
    Add(ints,ints,ints[count],count);Fence<HardEvent::V_MTE2>();
    LocalTensor<int32_t> partial(TPosition::VECIN,CAP*4+256,2*CAP);
    DataCopy(partial,scratch[2*TM*TN+sub*count],DataCopyParams{2,uint16_t(count/8),uint16_t((TM*TN-count)/8),0});
    Fence<HardEvent::MTE2_V>();
    Add(partial,partial,partial[count],count);PipeBarrier<PIPE_V>();
    Add(ints,ints,partial,count);PipeBarrier<PIPE_V>();

    Cast(z,ints,RoundMode::CAST_RINT,count);PipeBarrier<PIPE_V>();
    for(uint32_t col=0;col<c;col+=64)
        Mul(z[col],z[col],s[col],uint64_t(64),uint8_t(h),{1,1,1,uint8_t(c/8),uint8_t(c/8),0});
    PipeBarrier<PIPE_V>();
    Mul(t,z,z,count);PipeBarrier<PIPE_V>();
    Muls(t,t,-0.07135481387376785f,count);PipeBarrier<PIPE_V>();
    Adds(t,t,-1.5957691216057308f,count);PipeBarrier<PIPE_V>();
    Mul(t,t,z,count);PipeBarrier<PIPE_V>();
    Exp(t,t,count);PipeBarrier<PIPE_V>();
    Adds(t,t,1.0f,count);PipeBarrier<PIPE_V>();
    Div(z,z,t,count);PipeBarrier<PIPE_V>();
    Cast(result,z,RoundMode::CAST_RINT,count);Fence<HardEvent::V_MTE3>();
    const uint32_t valid=rows>sub*h?Min(h,rows-sub*h):0;
    if(valid)DataCopyPad(out[uint64_t(sub*h)*n],result,DataCopyExtParams{uint16_t(valid),cols*2,(c-Round(cols,16))/16,(n-cols)*2,0});
    Fence<HardEvent::MTE3_S>();
}

__aicore__ inline void Run(GM_ADDR x,GM_ADDR weight,GM_ADDR scale,GM_ADDR y,GM_ADDR workspace,
    uint32_t e,uint32_t k,uint32_t n,uint32_t workers,uint64_t delay,const uint32_t* boundaries) {
    GlobalTensor<int8_t> a,b;GlobalTensor<float> s;
    GlobalTensor<half> out;GlobalTensor<int32_t> scratch;
    a.SetGlobalBuffer((__gm__ int8_t*)x);b.SetGlobalBuffer((__gm__ int8_t*)weight);
    s.SetGlobalBuffer((__gm__ float*)scale);out.SetGlobalBuffer((__gm__ half*)y);
    uint32_t worker;if ASCEND_IS_AIC {worker=GetBlockIdx();}else{worker=GetBlockIdx()/2;}
    scratch.SetGlobalBuffer((__gm__ int32_t*)workspace);
    if ASCEND_IS_AIC {
        uint32_t previous=0,baseTask=0;
        const uint32_t nt=(n+TN-1)/TN;
        for(uint32_t expert=0;expert<e;++expert) {
            const uint32_t end=boundaries[expert],length=end-previous,tiles=(length+TM-1)/TM*nt;
            const uint32_t first=(worker+workers-(baseTask*PARTS)%workers)%workers;
            for(uint32_t task=first;task<tiles*PARTS;task+=workers) {
                const uint32_t tile=task/PARTS,part=task%PARTS,row=tile/nt*TM,col=tile%nt*TN;
                Cube(a[uint64_t(previous+row)*k],b[uint64_t(expert)*k*n+col],
                    scratch[uint64_t(baseTask*PARTS+task)*TM*TN],Min(TM,length-row),Min(TN,n-col),k,n,0,part);
            }
            baseTask+=tiles;previous=end;
        }
        CrossCoreSetFlag<2,PIPE_FIX>(4);
        CrossCoreWaitFlag<2,PIPE_S>(6);
        const uint64_t start=GetSystemCycle();while(uint64_t(GetSystemCycle())-start<delay){}
    }else{
        CrossCoreWaitFlag<2,PIPE_MTE2>(4);SyncAll<true>();
        uint32_t previous=0,baseTask=0;
        const uint32_t nt=(n+TN-1)/TN;
        for(uint32_t expert=0;expert<e;++expert) {
            const uint32_t end=boundaries[expert],length=end-previous,tiles=(length+TM-1)/TM*nt;
            const uint32_t first=(worker+workers-baseTask%workers)%workers;
            for(uint32_t tile=first;tile<tiles;tile+=workers) {
                const uint32_t row=tile/nt*TM,col=tile%nt*TN;
                Epilogue(scratch[uint64_t(baseTask+tile)*PARTS*TM*TN],s[uint64_t(expert)*n+col],
                    out[uint64_t(previous+row)*n+col],Min(TM,length-row),Min(TN,n-col),n,0);
            }
            baseTask+=tiles;previous=end;
        }
        SyncAll<true>();CrossCoreSetFlag<2,PIPE_MTE3>(6);
    }
    PipeBarrier<PIPE_ALL>();
}
}

namespace gmmPackedTransfer {
using namespace AscendC;
// Preserve INT8 bytes while the DMA groups adjacent columns into 16-bit lanes.
__aicore__ inline void Copy(LocalTensor<int8_t> dst,GlobalTensor<int8_t> src,
    uint32_t rows,uint32_t cols,uint32_t sourceStride,uint32_t destinationStride) {
    const uint32_t paired=cols/2*2;
    if(paired)for(uint32_t parity=0;parity<2;++parity) {
        const uint32_t count=(rows+1-parity)/2;
        if(count){
            GlobalTensor<half> packed;packed.SetGlobalBuffer((__gm__ half*)(src.GetPhyAddr()+uint64_t(parity)*sourceStride));
            DataCopy(dst.ReinterpretCast<half>()[parity*16],packed,
                Nd2NzParams{1,uint16_t(count),uint16_t(paired/2),0,uint16_t(sourceStride),uint16_t(destinationStride),2,0});
        }
    }
    if(cols%2){
        const uint32_t start=cols/32*32;
        DataCopy(dst[uint64_t(start)*destinationStride],src[start],
            Nd2NzParams{1,uint16_t(rows),uint16_t(cols-start),0,uint16_t(sourceStride),uint16_t(destinationStride),1,0});
    }
}
}

namespace gmmAtomicBig {
using namespace AscendC;
constexpr uint32_t TM=512,TN=64,SPAN=256,STEP=64,BANKS=4;
constexpr uint32_t ADEPTH=704,A_BYTES=TM*ADEPTH;
constexpr uint32_t PANEL_BYTES=TN*SPAN;
constexpr uint32_t OUT_SLOTS=2,PARTS=12;
template<HardEvent E> __aicore__ inline void Fence() {
    SetFlag<E>(EVENT_ID0);WaitFlag<E>(EVENT_ID0);
}
__aicore__ inline uint32_t Min(uint32_t a,uint32_t b) {return a<b?a:b;}
__aicore__ inline uint32_t Round(uint32_t a,uint32_t b) {return (a+b-1)/b*b;}

__aicore__ inline void Prepare(GlobalTensor<int8_t> a,GlobalTensor<int8_t> b,
    uint32_t rows,uint32_t cols,uint32_t depthK,uint32_t n,uint32_t panel,uint32_t sourceK,bool reuse=false) {
    const uint32_t bank=panel%BANKS,depth=Min(SPAN,depthK-panel*SPAN);
    const event_t ev=event_t(uint32_t(EVENT_ID2)+bank);
    if(panel>=BANKS || reuse)WaitFlag<HardEvent::MTE1_MTE2>(ev);
    LocalTensor<int8_t> a1(TPosition::A1,0,TM*ADEPTH);
    LocalTensor<int8_t> b1(TPosition::A1,A_BYTES+bank*PANEL_BYTES,TN*SPAN);
    if(depth%64!=0) {
        // Nd2Nz pads a partial C0 only; explicitly clear all consumed K lanes.
        InitConstValue(b1.ReinterpretCast<uint32_t>(),InitConstValueParams<uint32_t>{1,uint16_t(TN*SPAN/32),0,0});
        PipeBarrier<PIPE_MTE2>();
    }
    gmmPackedTransfer::Copy(b1,b[uint64_t(panel*SPAN)*n],depth,cols,n,SPAN);
    SetFlag<HardEvent::MTE2_MTE1>(ev);
}

__aicore__ inline void Cube(GlobalTensor<int8_t> a,GlobalTensor<int8_t> b,
    GlobalTensor<int32_t> scratch,uint32_t rows,uint32_t cols,uint32_t k,uint32_t n,uint32_t slot,uint32_t part,uint32_t nextCols,uint32_t rotation) {
    const uint32_t r=Round(rows,16)<32?32:Round(rows,16),c=Round(cols,32);
    const uint32_t allSteps=(k+STEP-1)/STEP,begin=allSteps*part/PARTS*STEP,end=Min(k,allSteps*(part+1)/PARTS*STEP);
    const uint32_t partK=end-begin,panels=(partK+SPAN-1)/SPAN;
    LocalTensor<int32_t> acc(TPosition::CO1,0,TM*TN);
    const uint32_t turn=0;
    if(slot==0)for(uint32_t i=0;i<Min(panels,BANKS);++i){const uint32_t p=(i+turn)%panels;Prepare(a[begin],b[uint64_t(begin)*n],rows,cols,partK,n,p,k);}
    uint32_t sequence=0;
    for(uint32_t ordinal=0;ordinal<panels;++ordinal) {
        const uint32_t panel=(ordinal+turn)%panels;
        const uint32_t bank=panel%BANKS;
        const event_t ev=event_t(uint32_t(EVENT_ID2)+bank);
        WaitFlag<HardEvent::MTE2_MTE1>(ev);
        LocalTensor<int8_t> a1(TPosition::A1,0,TM*ADEPTH);
        LocalTensor<int8_t> b1(TPosition::A1,A_BYTES+bank*PANEL_BYTES,TN*SPAN);
        const uint32_t padded=Round(Min(SPAN,partK-panel*SPAN),64);
        for(uint32_t start=0;start<padded;start+=STEP,++sequence) {
            const uint32_t d=Min(STEP,padded-start),l0slot=sequence%2;
            const event_t l0ev=l0slot?EVENT_ID1:EVENT_ID0;
            if(sequence>=2)WaitFlag<HardEvent::M_MTE1>(l0ev);
            LocalTensor<int8_t> a0(TPosition::A2,l0slot*TM*STEP,TM*STEP);
            LocalTensor<int8_t> b0(TPosition::B2,l0slot*TN*STEP,TN*STEP);
            LoadData2DParams ap;ap.repeatTimes=d/32;ap.srcStride=TM/16;
            for(uint32_t m=0;m<r/16;++m)LoadData(a0[m*d*16],a1[(panel*SPAN+start)*TM+m*512],ap);
            LoadData2dTransposeParams bp;bp.repeatTimes=d/32;bp.srcStride=1;bp.dstGap=c/16-1;
            for(uint32_t col=0;col<c/32;++col)LoadDataWithTranspose(b0[col*1024],b1[col*SPAN*32+start*32],bp);
            SetFlag<HardEvent::MTE1_M>(l0ev);WaitFlag<HardEvent::MTE1_M>(l0ev);
            MmadParams mm;mm.m=r;mm.n=c;mm.k=d;mm.cmatrixInitVal=sequence==0;mm.unitFlag=panel+1==panels && start+d==padded?3:2;
            Mmad(acc,a0,b0,mm);SetFlag<HardEvent::M_MTE1>(l0ev);
        }
        SetFlag<HardEvent::MTE1_MTE2>(ev);
        if(panel+BANKS<panels)Prepare(a[begin],b[uint64_t(begin)*n],rows,cols,partK,n,panel+BANKS,k);
        else if(nextCols)Prepare(a[begin],b[uint64_t(begin)*n+TN],rows,nextCols,partK,n,panel%BANKS,k,true);
    }
    WaitFlag<HardEvent::M_MTE1>(EVENT_ID0);
    if(sequence>1)WaitFlag<HardEvent::M_MTE1>(EVENT_ID1);
    if(!nextCols)for(uint32_t bank=0;bank<Min(BANKS,panels);++bank)
        WaitFlag<HardEvent::MTE1_MTE2>(event_t(uint32_t(EVENT_ID2)+bank));
    FixpipeParamsV220 fp;fp.mSize=r;fp.nSize=c;fp.srcStride=r;fp.dstStride=c;fp.unitFlag=3;
    if(slot==0)CrossCoreWaitFlag<2,PIPE_S>(8);
    SetAtomicAdd<int32_t>();Fixpipe<int32_t,int32_t,CFG_ROW_MAJOR>(scratch,acc,fp);SetAtomicNone();
    CrossCoreSetFlag<2,PIPE_FIX>(4);
}

__aicore__ inline void Epilogue(GlobalTensor<int32_t> scratch,GlobalTensor<float> scales,
    GlobalTensor<half> out,uint32_t rows,uint32_t cols,uint32_t n,uint32_t slot) {
    constexpr uint32_t CAP=TM/2*TN;
    const uint32_t r=Round(rows,16)<32?32:Round(rows,16),h=r/2,c=Round(cols,32),count=h*c,sub=GetSubBlockIdx();
    LocalTensor<int32_t> ints(TPosition::VECIN,0,CAP);
    LocalTensor<float> z(TPosition::VECCALC,CAP*4+256,CAP),t(TPosition::VECCALC,0,CAP);
    LocalTensor<float> s(TPosition::VECIN,CAP*8+512,TN);
    LocalTensor<half> result(TPosition::VECOUT,CAP*8+512+TN*4,CAP);
    DataCopyPad(s,scales,DataCopyExtParams{1,cols*4,0,0,0},DataCopyPadExtParams<float>{true,0,0,0});
    DataCopy(ints,scratch[sub*count],count);Fence<HardEvent::MTE2_V>();
    Cast(z,ints,RoundMode::CAST_RINT,count);PipeBarrier<PIPE_V>();
    for(uint32_t row=0;row<h;row+=128)for(uint32_t col=0;col<c;col+=64)
        Mul(z[row*c+col],z[row*c+col],s[col],uint64_t(Min(64,c-col)),uint8_t(Min(128,h-row)),{1,1,1,uint8_t(c/8),uint8_t(c/8),0});
    PipeBarrier<PIPE_V>();
    Mul(t,z,z,count);PipeBarrier<PIPE_V>();
    Muls(t,t,-0.07135481387376785f,count);PipeBarrier<PIPE_V>();
    Adds(t,t,-1.5957691216057308f,count);PipeBarrier<PIPE_V>();
    Mul(t,t,z,count);PipeBarrier<PIPE_V>();
    Exp(t,t,count);PipeBarrier<PIPE_V>();
    Adds(t,t,1.0f,count);PipeBarrier<PIPE_V>();
    Div(z,z,t,count);PipeBarrier<PIPE_V>();
    Cast(result,z,RoundMode::CAST_RINT,count);Fence<HardEvent::V_MTE3>();
    const uint32_t valid=rows>sub*h?Min(h,rows-sub*h):0;
    if(valid)DataCopyPad(out[uint64_t(sub*h)*n],result,DataCopyExtParams{uint16_t(valid),cols*2,(c-Round(cols,16))/16,(n-cols)*2,0});
    Fence<HardEvent::MTE3_S>();
}


__aicore__ inline void ProduceOne(GlobalTensor<int8_t> a,GlobalTensor<int8_t> b,GlobalTensor<int32_t> scratch,
    uint32_t rows,uint32_t k,uint32_t n,uint32_t part,uint32_t rotation) {
    const uint32_t allSteps=(k+STEP-1)/STEP,begin=allSteps*part/PARTS*STEP,endK=Min(k,allSteps*(part+1)/PARTS*STEP),depth=endK-begin;
    LocalTensor<int8_t> a1(TPosition::A1,0,TM*ADEPTH);Fence<HardEvent::MTE1_MTE2>();
    if(depth%64){InitConstValue(a1.ReinterpretCast<uint32_t>(),InitConstValueParams<uint32_t>{1,uint16_t(TM*ADEPTH/32),0,0});PipeBarrier<PIPE_MTE2>();}
    DataCopy(a1,a[begin],Nd2NzParams{1,uint16_t(rows),uint16_t(depth),0,uint16_t(k),TM,1,0});Fence<HardEvent::MTE2_MTE1>();
    for(uint32_t col=0;col<n;col+=TN)
        Cube(a,b[col],scratch[uint64_t(col/TN)*TM*TN],rows,Min(TN,n-col),k,n,col/TN,part,col+TN<n?Min(TN,n-col-TN):0,rotation);
}
}



namespace gmmFullSmall {
using namespace AscendC;
constexpr uint32_t TM=32,TN=576,PARTS=4;
template<HardEvent E> __aicore__ inline void Fence(){SetFlag<E>(EVENT_ID0);WaitFlag<E>(EVENT_ID0);}
__aicore__ inline uint32_t Min(uint32_t a,uint32_t b){return a<b?a:b;}
__aicore__ inline uint32_t Round(uint32_t a,uint32_t b){return (a+b-1)/b*b;}
__aicore__ inline void Epilogue(GlobalTensor<int32_t> scratch,GlobalTensor<float> scales,
    GlobalTensor<half> out,uint32_t rows,uint32_t cols,uint32_t n,uint32_t slot) {
    constexpr uint32_t CAP=TM/2*TN;
    const uint32_t r=Round(rows,16),h=r/2,c=Round(cols,32),count=h*c,sub=GetSubBlockIdx();
    LocalTensor<int32_t> ints(TPosition::VECIN,0,2*CAP);
    LocalTensor<float> z(TPosition::VECCALC,CAP*4+256,CAP),t(TPosition::VECCALC,0,CAP);
    LocalTensor<float> s(TPosition::VECIN,CAP*12+512,TN);
    LocalTensor<half> result(TPosition::VECOUT,CAP*12+512+TN*4,CAP);
    DataCopyPad(s,scales,DataCopyExtParams{1,cols*4,0,0,0},DataCopyPadExtParams<float>{true,0,0,0});
    
    // Merge all partials in INT32; the temporary pair is reused only after Add.
    DataCopy(ints,scratch[sub*count],DataCopyParams{2,uint16_t(count/8),uint16_t((TM*TN-count)/8),0});
    Fence<HardEvent::MTE2_V>();
    Add(ints,ints,ints[count],count);PipeBarrier<PIPE_V>();
    LocalTensor<int32_t> partial(TPosition::VECIN,CAP*4+256,2*CAP);
    for(uint32_t pair=2;pair<PARTS;pair+=2) {
        Fence<HardEvent::V_MTE2>();
        DataCopy(partial,scratch[pair*TM*TN+sub*count],DataCopyParams{2,uint16_t(count/8),uint16_t((TM*TN-count)/8),0});
        Fence<HardEvent::MTE2_V>();
        Add(partial,partial,partial[count],count);PipeBarrier<PIPE_V>();
        Add(ints,ints,partial,count);PipeBarrier<PIPE_V>();
    }

    Cast(z,ints,RoundMode::CAST_RINT,count);PipeBarrier<PIPE_V>();
    for(uint32_t col=0;col<c;col+=64)
        Mul(z[col],z[col],s[col],uint64_t(Min(64,c-col)),uint8_t(h),{1,1,1,uint8_t(c/8),uint8_t(c/8),0});
    PipeBarrier<PIPE_V>();
    Mul(t,z,z,count);PipeBarrier<PIPE_V>();
    Muls(t,t,-0.07135481387376785f,count);PipeBarrier<PIPE_V>();
    Adds(t,t,-1.5957691216057308f,count);PipeBarrier<PIPE_V>();
    Mul(t,t,z,count);PipeBarrier<PIPE_V>();
    Exp(t,t,count);PipeBarrier<PIPE_V>();
    Adds(t,t,1.0f,count);PipeBarrier<PIPE_V>();
    Div(z,z,t,count);PipeBarrier<PIPE_V>();
    Cast(result,z,RoundMode::CAST_RINT,count);Fence<HardEvent::V_MTE3>();
    const uint32_t valid=rows>sub*h?Min(h,rows-sub*h):0;
    if(valid)DataCopyPad(out[uint64_t(sub*h)*n],result,DataCopyExtParams{uint16_t(valid),cols*2,(c-Round(cols,16))/16,(n-cols)*2,0});
    Fence<HardEvent::MTE3_S>();
}


constexpr uint32_t KD=2048,SPAN=320,BK=336,AB=TM*KD,BB=TN*BK;
__aicore__ inline void Prepare(GlobalTensor<int8_t> b,uint32_t depth,uint32_t n,uint32_t panel) {
    const uint32_t bank=panel%2,d=Min(SPAN,depth-panel*SPAN);const event_t ev=event_t(2+bank);
    if(panel>=2)WaitFlag<HardEvent::MTE1_MTE2>(ev);
    LocalTensor<int8_t> b1(TPosition::A1,AB+bank*BB,BB);
    if(d%64){InitConstValue(b1.ReinterpretCast<uint32_t>(),InitConstValueParams<uint32_t>{1,uint16_t(BB/32),0,0});PipeBarrier<PIPE_MTE2>();}
    gmmPackedTransfer::Copy(b1,b[uint64_t(panel*SPAN)*n],d,n,n,BK);SetFlag<HardEvent::MTE2_MTE1>(ev);
}
__aicore__ inline void Produce(GlobalTensor<int8_t> a,GlobalTensor<int8_t> b,GlobalTensor<int32_t> scratch,
    uint32_t rows,uint32_t k,uint32_t n,uint32_t part) {
    const uint32_t steps=(k+63)/64,begin=steps*part/PARTS*64,end=Min(k,steps*(part+1)/PARTS*64),depth=end-begin,panels=(depth+SPAN-1)/SPAN,r=Round(rows,16),c=Round(n,32);
    LocalTensor<int8_t> a1(TPosition::A1,0,AB);
    if(depth%64){InitConstValue(a1.ReinterpretCast<uint32_t>(),InitConstValueParams<uint32_t>{1,uint16_t(AB/32),0,0});PipeBarrier<PIPE_MTE2>();}
    DataCopy(a1,a[begin],Nd2NzParams{1,uint16_t(rows),uint16_t(depth),0,uint16_t(k),TM,1,0});SetFlag<HardEvent::MTE2_MTE1>(EVENT_ID4);
    for(uint32_t panel=0;panel<Min(panels,2);++panel)Prepare(b[uint64_t(begin)*n],depth,n,panel);
    WaitFlag<HardEvent::MTE2_MTE1>(EVENT_ID4);uint32_t sequence=0;LocalTensor<int32_t> acc(TPosition::CO1,0,TM*TN);
    for(uint32_t panel=0;panel<panels;++panel) {
        const event_t ev=event_t(2+panel%2);WaitFlag<HardEvent::MTE2_MTE1>(ev);LocalTensor<int8_t> b1(TPosition::A1,AB+panel%2*BB,BB);
        const uint32_t padded=Round(Min(SPAN,depth-panel*SPAN),64);
        for(uint32_t start=0;start<padded;start+=64,++sequence) {
            if(sequence)WaitFlag<HardEvent::M_MTE1>(EVENT_ID0);
            LocalTensor<int8_t> a0(TPosition::A2,0,TM*64),b0(TPosition::B2,0,TN*64);
            LoadData2DParams ap;ap.repeatTimes=2;ap.srcStride=TM/16;
            for(uint32_t m=0;m<r/16;++m)LoadData(a0[m*1024],a1[(panel*SPAN+start)*TM+m*512],ap);
            LoadData2dTransposeParams bp;bp.repeatTimes=2;bp.srcStride=1;bp.dstGap=c/16-1;
            for(uint32_t col=0;col<c/32;++col)LoadDataWithTranspose(b0[col*1024],b1[col*BK*32+start*32],bp);
            SetFlag<HardEvent::MTE1_M>(EVENT_ID0);WaitFlag<HardEvent::MTE1_M>(EVENT_ID0);
            MmadParams mm;mm.m=r;mm.n=c;mm.k=64;mm.cmatrixInitVal=sequence==0;Mmad(acc,a0,b0,mm);SetFlag<HardEvent::M_MTE1>(EVENT_ID0);
        }
        SetFlag<HardEvent::MTE1_MTE2>(ev);if(panel+2<panels)Prepare(b[uint64_t(begin)*n],depth,n,panel+2);
    }
    WaitFlag<HardEvent::M_MTE1>(EVENT_ID0);for(uint32_t bank=0;bank<Min(panels,2);++bank)WaitFlag<HardEvent::MTE1_MTE2>(event_t(2+bank));
    Fence<HardEvent::M_FIX>();FixpipeParamsV220 fp;fp.mSize=r;fp.nSize=c;fp.srcStride=r;fp.dstStride=c;
    Fixpipe<int32_t,int32_t,CFG_ROW_MAJOR>(scratch[part*TM*TN],acc,fp);Fence<HardEvent::FIX_M>();
}
}

namespace gmmAtomicGrouped {
using namespace AscendC;
constexpr uint32_t COUNTER_WORDS=8;
__aicore__ inline void Run(GM_ADDR x,GM_ADDR weight,GM_ADDR scale,GM_ADDR y,GM_ADDR workspace,
    uint32_t e,uint32_t k,uint32_t n,uint32_t workers,uint64_t delay,const uint32_t* boundaries,
    uint32_t large,uint32_t start,uint32_t length,uint32_t smallCount) {
    GlobalTensor<int8_t> a,b;GlobalTensor<float> s;GlobalTensor<half> out;GlobalTensor<int32_t> scratch;
    a.SetGlobalBuffer((__gm__ int8_t*)x);b.SetGlobalBuffer((__gm__ int8_t*)weight);
    s.SetGlobalBuffer((__gm__ float*)scale);out.SetGlobalBuffer((__gm__ half*)y);scratch.SetGlobalBuffer((__gm__ int32_t*)workspace);
    constexpr uint32_t BIG_PARTS=gmmAtomicBig::PARTS,SMALL_PARTS=gmmFullSmall::PARTS;
    constexpr uint32_t BIG_TILE=gmmAtomicBig::TM*gmmAtomicBig::TN,SMALL_TILE=gmmFullSmall::TM*gmmFullSmall::TN;
    const uint32_t nt=(n+gmmAtomicBig::TN-1)/gmmAtomicBig::TN,smallEnd=BIG_PARTS+smallCount*SMALL_PARTS;
    const uint64_t counterBase=uint64_t(nt)*BIG_TILE;
    const uint64_t smallBase=counterBase+gmmAtomicBig::Round((nt+smallCount)*COUNTER_WORDS,64);
    uint32_t worker;if ASCEND_IS_AIC {worker=GetBlockIdx();}else{worker=GetBlockIdx()/2;}
    uint32_t smallExpert=0,smallStart=0,smallRows=0;
    const bool smallRole=worker>=BIG_PARTS && worker<smallEnd;
    const uint32_t smallIndex=smallRole?(worker-BIG_PARTS)/SMALL_PARTS:0;
    if(smallRole) {
        uint32_t previous=0,index=0;
        for(uint32_t expert=0;expert<e;++expert) {
            const uint32_t end=boundaries[expert],rows=end-previous;
            if(rows && expert!=large) {
                if(index==smallIndex){smallExpert=expert;smallStart=previous;smallRows=rows;break;}
                ++index;
            }
            previous=end;
        }
    }
    if ASCEND_IS_AIC {
        if(worker<BIG_PARTS)
            gmmAtomicBig::ProduceOne(a[uint64_t(start)*k],b[uint64_t(large)*k*n],scratch,length,k,n,worker,0);
        else if(smallRole)
            gmmFullSmall::Produce(a[uint64_t(smallStart)*k],b[uint64_t(smallExpert)*k*n],
                scratch[smallBase+uint64_t(smallIndex)*SMALL_PARTS*SMALL_TILE],smallRows,k,n,(worker-BIG_PARTS)%SMALL_PARTS);
        if(worker>=BIG_PARTS)CrossCoreWaitFlag<2,PIPE_S>(8);
        CrossCoreSetFlag<2,PIPE_FIX>(9);CrossCoreWaitFlag<2,PIPE_S>(6);
        const uint64_t tick=GetSystemCycle();while(uint64_t(GetSystemCycle())-tick<delay){}
    }else{
        LocalTensor<int32_t> zeros(TPosition::VECOUT,0,4096);Duplicate(zeros.ReinterpretCast<float>(),0.0f,4096);gmmAtomicBig::Fence<HardEvent::V_MTE3>();
        for(uint64_t offset=uint64_t(GetBlockIdx())*4096;offset<smallBase;offset+=uint64_t(workers)*2*4096)
            DataCopy(scratch[offset],zeros,uint32_t(smallBase-offset<4096?smallBase-offset:4096));
        gmmAtomicBig::Fence<HardEvent::MTE3_S>();SyncAll<true>();CrossCoreSetFlag<2,PIPE_MTE3>(8);
        if(worker<BIG_PARTS)for(uint32_t column=0;column<nt;++column) {
            CrossCoreWaitFlag<2,PIPE_MTE2>(4);
            GlobalTensor<int32_t> counter=scratch[counterBase+uint64_t(column)*COUNTER_WORDS];
            if(GetSubBlockIdx()==0){
                LocalTensor<int32_t> notice(TPosition::VECOUT,0,COUNTER_WORDS);Duplicate(notice,int32_t(1),COUNTER_WORDS);gmmAtomicBig::Fence<HardEvent::V_MTE3>();
                SetAtomicAdd<int32_t>();DataCopy(counter,notice,COUNTER_WORDS);SetAtomicNone();gmmAtomicBig::Fence<HardEvent::MTE3_S>();
            }
            if(worker==column && GetSubBlockIdx()==1){
                do {LocalTensor<int32_t> state(TPosition::VECIN,64,COUNTER_WORDS);DataCopy(state,counter,COUNTER_WORDS);gmmAtomicBig::Fence<HardEvent::MTE2_S>();if(state.GetValue(0)==BIG_PARTS)break;}while(true);
                const uint32_t col=column*gmmAtomicBig::TN;
                gmmAtomicBig::Epilogue(scratch[uint64_t(column)*BIG_TILE],s[uint64_t(large)*n+col],out[uint64_t(start)*n+col],length,gmmAtomicBig::Min(gmmAtomicBig::TN,n-col),n,0);
            }
        }
        if(worker<BIG_PARTS && GetSubBlockIdx()==0 && worker<nt) {
            const uint32_t column=worker,col=column*gmmAtomicBig::TN;
            GlobalTensor<int32_t> counter=scratch[counterBase+uint64_t(column)*COUNTER_WORDS];
            do {LocalTensor<int32_t> state(TPosition::VECIN,64,COUNTER_WORDS);DataCopy(state,counter,COUNTER_WORDS);gmmAtomicBig::Fence<HardEvent::MTE2_S>();if(state.GetValue(0)==BIG_PARTS)break;}while(true);
            gmmAtomicBig::Epilogue(scratch[uint64_t(column)*BIG_TILE],s[uint64_t(large)*n+col],out[uint64_t(start)*n+col],length,gmmAtomicBig::Min(gmmAtomicBig::TN,n-col),n,0);
        }
        CrossCoreWaitFlag<2,PIPE_MTE2>(9);
        if(smallRole) {
            GlobalTensor<int32_t> counter=scratch[counterBase+uint64_t(nt+smallIndex)*COUNTER_WORDS];
            if(GetSubBlockIdx()==0){
                LocalTensor<int32_t> notice(TPosition::VECOUT,0,COUNTER_WORDS);Duplicate(notice,int32_t(1),COUNTER_WORDS);gmmAtomicBig::Fence<HardEvent::V_MTE3>();
                SetAtomicAdd<int32_t>();DataCopy(counter,notice,COUNTER_WORDS);SetAtomicNone();gmmAtomicBig::Fence<HardEvent::MTE3_S>();
            }
            if((worker-BIG_PARTS)%SMALL_PARTS==0) {
                do {LocalTensor<int32_t> state(TPosition::VECIN,64,COUNTER_WORDS);DataCopy(state,counter,COUNTER_WORDS);gmmAtomicBig::Fence<HardEvent::MTE2_S>();if(state.GetValue(0)==SMALL_PARTS)break;}while(true);
                gmmFullSmall::Epilogue(scratch[smallBase+uint64_t(smallIndex)*SMALL_PARTS*SMALL_TILE],s[uint64_t(smallExpert)*n],out[uint64_t(smallStart)*n],smallRows,n,n,0);
            }
        }
        CrossCoreSetFlag<2,PIPE_MTE3>(6);
    }
    PipeBarrier<PIPE_ALL>();
}
}
namespace gmmLongK {
using namespace AscendC;
constexpr uint32_t TM=gmmLongKSplit::TM,TN=gmmLongKSplit::TN,PARTS=gmmLongKSplit::PARTS,OUT_SLOTS=2;
__aicore__ inline void GroupedMatmulGeluBaseline(GM_ADDR x,GM_ADDR weight,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,GM_ADDR workspace,
    uint32_t e,uint32_t k,uint32_t n,uint32_t workers,uint64_t delay) {
    GlobalTensor<int64_t> ends;ends.SetGlobalBuffer((__gm__ int64_t*)groups);
    DataCacheCleanAndInvalid<int64_t,CacheLine::ENTIRE_DATA_CACHE,DcciDst::CACHELINE_OUT>(ends);
    uint32_t boundaries[128],previous=0,maximum=0,minimum=uint32_t(-1);
    uint32_t large=0,start=0,length=0,largeCount=0,smallCount=0;
    for(uint32_t expert=0;expert<e;++expert) {
        const uint32_t end=uint32_t(ends.GetValue(expert)),rows=end-previous;
        boundaries[expert]=end;
        if(rows) {
            maximum=maximum>rows?maximum:rows;minimum=minimum<rows?minimum:rows;
            if(rows<=gmmFullSmall::TM)++smallCount;
            else {large=expert;start=previous;length=rows;++largeCount;}
        }
        previous=end;
    }
    // One resident large-row tile and one four-way K reduction per small tile.
    const bool atomicSelected=largeCount==1 && length>gmmAtomicBig::TM/2 && length<=gmmAtomicBig::TM &&
        k>4096 && gmmAtomicBig::Round(k,64)<=gmmFullSmall::KD*gmmFullSmall::PARTS && n<=gmmFullSmall::TN &&
        workers>=gmmAtomicBig::PARTS+smallCount*gmmFullSmall::PARTS;
    if(atomicSelected)
        gmmAtomicGrouped::Run(x,weight,scale,y,workspace,e,k,n,workers,delay,boundaries,large,start,length,smallCount);
    else if(maximum>gmmLongKSplit::TM || (k>4096 && minimum>gmmLongKCurrent::TM))
        gmmLongKSplit::Run(x,weight,scale,y,workspace,e,k,n,workers,delay,boundaries);
    else
        gmmLongKCurrent::Run(x,weight,scale,y,workspace,e,k,n,workers,delay,boundaries);
}
}

namespace gmmLongRows {
using namespace AscendC;
constexpr uint32_t TM=256,TN=128,SPAN=512,STEP=128,BANKS=2;
constexpr uint32_t PANEL_BYTES=(TM+TN)*SPAN;
constexpr uint32_t OUT_SLOTS=2;
template<HardEvent E> __aicore__ inline void Fence() {
    SetFlag<E>(EVENT_ID0);WaitFlag<E>(EVENT_ID0);
}
__aicore__ inline uint32_t Min(uint32_t a,uint32_t b) {return a<b?a:b;}
__aicore__ inline uint32_t Round(uint32_t a,uint32_t b) {return (a+b-1)/b*b;}

__aicore__ inline void Copy32(LocalTensor<int8_t> dst,GlobalTensor<int8_t> src,
    uint32_t rows,uint32_t cols,uint32_t sourceStride,uint32_t destinationStride) {
    const uint32_t packed=cols/4*4;
    if(packed)for(uint32_t parity=0;parity<4;++parity) {
        const uint32_t count=(rows+3-parity)/4;
        if(count){GlobalTensor<int32_t> words;words.SetGlobalBuffer((__gm__ int32_t*)(src.GetPhyAddr()+uint64_t(parity)*sourceStride));
            DataCopy(dst.ReinterpretCast<int32_t>()[parity*8],words,Nd2NzParams{1,uint16_t(count),uint16_t(packed/4),0,uint16_t(sourceStride),uint16_t(destinationStride),4,0});}
    }
    if(cols%4){const uint32_t start=cols/32*32;DataCopy(dst[uint64_t(start)*destinationStride],src[start],Nd2NzParams{1,uint16_t(rows),uint16_t(cols-start),0,uint16_t(sourceStride),uint16_t(destinationStride),1,0});}
}

__aicore__ inline void Prepare(GlobalTensor<int8_t> a,GlobalTensor<int8_t> b,
    uint32_t rows,uint32_t cols,uint32_t k,uint32_t n,uint32_t panel,bool packedWeights) {
    const uint32_t bank=panel%BANKS,depth=Min(SPAN,k-panel*SPAN);
    const event_t ev=event_t(uint32_t(EVENT_ID2)+bank);
    if(panel>=BANKS)WaitFlag<HardEvent::MTE1_MTE2>(ev);
    LocalTensor<int8_t> a1(TPosition::A1,bank*PANEL_BYTES,TM*SPAN);
    LocalTensor<int8_t> b1(TPosition::A1,bank*PANEL_BYTES+TM*SPAN,TN*SPAN);
    if(depth!=SPAN) {
        // Nd2Nz pads a partial C0 only; explicitly clear all consumed K lanes.
        InitConstValue(a1.ReinterpretCast<uint32_t>(),InitConstValueParams<uint32_t>{1,uint16_t(TM*SPAN/32),0,0});
        InitConstValue(b1.ReinterpretCast<uint32_t>(),InitConstValueParams<uint32_t>{1,uint16_t(TN*SPAN/32),0,0});
        PipeBarrier<PIPE_MTE2>();
    }
    gmmPackedTransfer::Copy(a1,a[panel*SPAN],rows,depth,k,TM);
    if(packedWeights)DataCopy(b1,b[uint64_t(panel*SPAN)*32],DataCopyParams{uint16_t((cols+31)/32),uint16_t(depth),uint16_t(k-depth),uint16_t(SPAN-depth)});
    else Copy32(b1,b[uint64_t(panel*SPAN)*n],depth,cols,n,SPAN);
    SetFlag<HardEvent::MTE2_MTE1>(ev);
}

template<uint32_t FIXED_R=0,uint32_t FIXED_C=0>
__aicore__ inline void Cube(GlobalTensor<int8_t> a,GlobalTensor<int8_t> b,
    GlobalTensor<int32_t> scratch,uint32_t rows,uint32_t cols,uint32_t k,uint32_t n,uint32_t slot,bool packedWeights) {
    const uint32_t r=FIXED_R?FIXED_R:(Round(rows,16)<32?32:Round(rows,16)),c=FIXED_C?FIXED_C:Round(cols,32);
    const uint32_t panels=(k+SPAN-1)/SPAN;
    LocalTensor<int32_t> acc(TPosition::CO1,0,TM*TN);
    for(uint32_t p=0;p<Min(BANKS,panels);++p)Prepare(a,b,rows,cols,k,n,p,packedWeights);
    uint32_t sequence=0;
    for(uint32_t panel=0;panel<panels;++panel) {
        const uint32_t bank=panel%BANKS;
        const event_t ev=event_t(uint32_t(EVENT_ID2)+bank);
        WaitFlag<HardEvent::MTE2_MTE1>(ev);
        LocalTensor<int8_t> a1(TPosition::A1,bank*PANEL_BYTES,TM*SPAN);
        LocalTensor<int8_t> b1(TPosition::A1,bank*PANEL_BYTES+TM*SPAN,TN*SPAN);
        const uint32_t padded=Round(Min(SPAN,k-panel*SPAN),64);
        for(uint32_t start=0;start<padded;start+=STEP,++sequence) {
            const uint32_t d=Min(STEP,padded-start),l0slot=sequence%2;
            const event_t l0ev=l0slot?EVENT_ID1:EVENT_ID0;
            if(sequence>=2)WaitFlag<HardEvent::M_MTE1>(l0ev);
            LocalTensor<int8_t> a0(TPosition::A2,l0slot*TM*STEP,TM*STEP);
            LocalTensor<int8_t> b0(TPosition::B2,l0slot*TN*STEP,TN*STEP);
            LoadData2DParams ap;ap.repeatTimes=r/16;ap.srcStride=1;ap.dstGap=d/32-1;
            for(uint32_t q=0;q<d/32;++q)LoadData(a0[q*512],a1[(start+q*32)*TM],ap);
            LoadData2dTransposeParams bp;bp.repeatTimes=d/32;bp.srcStride=1;bp.dstGap=c/16-1;
            for(uint32_t col=0;col<c/32;++col)LoadDataWithTranspose(b0[col*1024],b1[col*SPAN*32+start*32],bp);
            SetFlag<HardEvent::MTE1_M>(l0ev);WaitFlag<HardEvent::MTE1_M>(l0ev);
            MmadParams mm;mm.m=r;mm.n=c;mm.k=d;mm.cmatrixInitVal=sequence==0;
            Mmad(acc,a0,b0,mm);SetFlag<HardEvent::M_MTE1>(l0ev);
        }
        SetFlag<HardEvent::MTE1_MTE2>(ev);
        if(panel+BANKS<panels)Prepare(a,b,rows,cols,k,n,panel+BANKS,packedWeights);
    }
    WaitFlag<HardEvent::M_MTE1>(EVENT_ID0);
    if(sequence>1)WaitFlag<HardEvent::M_MTE1>(EVENT_ID1);
    for(uint32_t bank=0;bank<Min(BANKS,panels);++bank)
        WaitFlag<HardEvent::MTE1_MTE2>(event_t(uint32_t(EVENT_ID2)+bank));
    Fence<HardEvent::M_FIX>();
    FixpipeParamsV220 fp;fp.mSize=r;fp.nSize=c;fp.srcStride=r;fp.dstStride=c;
    Fixpipe<int32_t,int32_t,CFG_ROW_MAJOR>(scratch,acc,fp);
    CrossCoreSetFlag<2,PIPE_FIX>(4+slot);Fence<HardEvent::FIX_M>();
}

__aicore__ inline void Epilogue(GlobalTensor<int32_t> scratch,GlobalTensor<float> scales,
    GlobalTensor<half> out,uint32_t rows,uint32_t cols,uint32_t n,uint32_t slot) {
    constexpr uint32_t CAP=TM/2*TN;
    const uint32_t r=Round(rows,16)<32?32:Round(rows,16),h=r/2,c=Round(cols,32),count=h*c,sub=GetSubBlockIdx();
    LocalTensor<int32_t> ints(TPosition::VECIN,0,CAP);
    LocalTensor<float> z(TPosition::VECCALC,CAP*4+256,CAP),t(TPosition::VECCALC,0,CAP);
    LocalTensor<float> s(TPosition::VECIN,CAP*8+512,TN);
    LocalTensor<half> result(TPosition::VECOUT,CAP*8+512+TN*4,CAP);
    DataCopyPad(s,scales,DataCopyExtParams{1,cols*4,0,0,0},DataCopyPadExtParams<float>{true,0,0,0});
    CrossCoreWaitFlag<2,PIPE_MTE2>(4+slot);
    DataCopy(ints,scratch[sub*count],count);Fence<HardEvent::MTE2_V>();
    Cast(z,ints,RoundMode::CAST_RINT,count);PipeBarrier<PIPE_V>();
    for(uint32_t col=0;col<c;col+=64)
        Mul(z[col],z[col],s[col],uint64_t(Min(64,c-col)),uint8_t(h),{1,1,1,uint8_t(c/8),uint8_t(c/8),0});
    PipeBarrier<PIPE_V>();
    Mul(t,z,z,count);PipeBarrier<PIPE_V>();
    Muls(t,t,-0.07135481387376785f,count);PipeBarrier<PIPE_V>();
    Adds(t,t,-1.5957691216057308f,count);PipeBarrier<PIPE_V>();
    Mul(t,t,z,count);PipeBarrier<PIPE_V>();
    Exp(t,t,count);PipeBarrier<PIPE_V>();
    Adds(t,t,1.0f,count);PipeBarrier<PIPE_V>();
    Div(z,z,t,count);PipeBarrier<PIPE_V>();
    Cast(result,z,RoundMode::CAST_RINT,count);Fence<HardEvent::V_MTE3>();
    const uint32_t valid=rows>sub*h?Min(h,rows-sub*h):0;
    if(valid)DataCopyPad(out[uint64_t(sub*h)*n],result,DataCopyExtParams{uint16_t(valid),cols*2,(c-Round(cols,16))/16,(n-cols)*2,0});
    Fence<HardEvent::MTE3_S>();CrossCoreSetFlag<2,PIPE_MTE3>(6+slot);
}

__aicore__ inline void GroupedMatmulGeluBaseline(GM_ADDR x,GM_ADDR weight,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,GM_ADDR workspace,
    uint32_t e,uint32_t k,uint32_t n,uint32_t workers,uint64_t delay) {
    GlobalTensor<int8_t> a,b;GlobalTensor<float> s;GlobalTensor<int64_t> ends;
    GlobalTensor<half> out;GlobalTensor<int32_t> scratch;
    a.SetGlobalBuffer((__gm__ int8_t*)x);b.SetGlobalBuffer((__gm__ int8_t*)weight);
    s.SetGlobalBuffer((__gm__ float*)scale);ends.SetGlobalBuffer((__gm__ int64_t*)groups);out.SetGlobalBuffer((__gm__ half*)y);
    DataCacheCleanAndInvalid<int64_t,CacheLine::ENTIRE_DATA_CACHE,DcciDst::CACHELINE_OUT>(ends);
    uint32_t worker;if ASCEND_IS_AIC {worker=GetBlockIdx();}else{worker=GetBlockIdx()/2;}
    scratch.SetGlobalBuffer((__gm__ int32_t*)workspace+uint64_t(worker)*OUT_SLOTS*TM*TN);
    constexpr uint32_t PACK=128;
    const uint32_t np=Round(n,32),chunks=(k+PACK-1)/PACK;
    GlobalTensor<int8_t> packed;
    packed.SetGlobalBuffer((__gm__ int8_t*)workspace+uint64_t(workers)*OUT_SLOTS*TM*TN*4);
    if ASCEND_IS_AIV {
        uint32_t packExperts[128],count=0,previous=0;
        for(uint32_t expert=0;expert<e;++expert) {
            const uint32_t end=uint32_t(ends.GetValue(expert));
            if(end-previous>TM)packExperts[count++]=expert;
            previous=end;
        }
        LocalTensor<int8_t> input(TPosition::VECIN,0,PACK*np),temp(TPosition::VECCALC,PACK*np,PACK*TN);
        for(uint32_t job=GetBlockIdx();job<count*chunks;job+=workers*2) {
            const uint32_t expert=packExperts[job/chunks],start=job%chunks*PACK,rows=Min(PACK,k-start);
            DataCopyPad(input,b[uint64_t(expert)*k*n+uint64_t(start)*n],
                DataCopyExtParams{uint16_t(rows),n,0,0,0},DataCopyPadExtParams<int8_t>{true,0,uint8_t(np-n),0});
            Fence<HardEvent::MTE2_V>();
            for(uint32_t col=0;col<np/32;col+=TN/32) {
                const uint32_t columns=Min(TN/32,np/32-col);
                for(uint32_t part=0;part<columns;++part)
                    DataCopy(temp[part*PACK*32],input[(col+part)*32],
                        DataCopyParams{uint16_t(rows),1,uint16_t(np/32-1),0});
                Fence<HardEvent::V_MTE3>();
                DataCopy(packed[uint64_t(expert)*k*np+uint64_t(col)*k*32+start*32],temp,
                    DataCopyParams{uint16_t(columns),uint16_t(rows),uint16_t(PACK-rows),uint16_t(k-rows)});
                Fence<HardEvent::MTE3_V>();
            }
            Fence<HardEvent::V_MTE2>();
        }
        Fence<HardEvent::MTE3_S>();SyncAll<true>();CrossCoreSetFlag<2,PIPE_MTE3>(8);
    }
    bool packingReady=false;
    uint32_t previous=0,base=0,produced=0;
    const uint32_t nt=(n+TN-1)/TN;
    for(uint32_t expert=0;expert<e;++expert) {
        const uint32_t end=uint32_t(ends.GetValue(expert)),length=end-previous,tasks=(length+TM-1)/TM*nt;
        const uint32_t first=(worker+workers-base%workers)%workers;
        for(uint32_t task=first;task<tasks;task+=workers) {
            const uint32_t row=task/nt*TM,col=task%nt*TN,rows=Min(TM,length-row),cols=Min(TN,n-col),slot=produced%OUT_SLOTS;
            if ASCEND_IS_AIC {
                const bool usePacked=length>TM;
                if(usePacked && !packingReady){CrossCoreWaitFlag<2,PIPE_S>(8);packingReady=true;}
                if(produced>=OUT_SLOTS)CrossCoreWaitFlag<2,PIPE_S>(6+slot);
                const auto tileA=a[uint64_t(previous+row)*k];
                const auto tileB=usePacked?packed[uint64_t(expert)*k*np+uint64_t(col)*k]:b[uint64_t(expert)*k*n+col];
                const bool fullRows=Round(rows,16)==TM;
                // Every 32-column capacity of the N128 tile has the same treatment.
                switch(Round(cols,32)) {
#define GMM_LONG_COLUMNS(width) case width: if(fullRows)Cube<TM,width>(tileA,tileB,scratch[slot*TM*TN],rows,cols,k,n,slot,usePacked); else Cube<0,width>(tileA,tileB,scratch[slot*TM*TN],rows,cols,k,n,slot,usePacked); break
                    GMM_LONG_COLUMNS(32);
                    GMM_LONG_COLUMNS(64);
                    GMM_LONG_COLUMNS(96);
                    GMM_LONG_COLUMNS(128);
#undef GMM_LONG_COLUMNS
                }
            }else{
                Epilogue(scratch[slot*TM*TN],s[uint64_t(expert)*n+col],out[uint64_t(previous+row)*n+col],rows,cols,n,slot);
            }
            ++produced;
        }
        base+=tasks;previous=end;
    }
    if ASCEND_IS_AIC {
        if(!packingReady)CrossCoreWaitFlag<2,PIPE_S>(8);
        for(uint32_t slot=0;slot<Min(produced,OUT_SLOTS);++slot)CrossCoreWaitFlag<2,PIPE_S>(6+slot);
        const uint64_t start=GetSystemCycle();while(uint64_t(GetSystemCycle())-start<delay){}
    }
    PipeBarrier<PIPE_ALL>();
}
}

namespace gmmWideLongRows {
using namespace AscendC;
constexpr uint32_t TM=128,TN=256,SPAN=640,STEP=128,BANKS=2;
constexpr uint32_t PANEL_BYTES=(TM+TN)*SPAN;
constexpr uint32_t OUT_SLOTS=2;
template<HardEvent E> __aicore__ inline void Fence() {
    SetFlag<E>(EVENT_ID0);WaitFlag<E>(EVENT_ID0);
}
__aicore__ inline uint32_t Min(uint32_t a,uint32_t b) {return a<b?a:b;}
__aicore__ inline uint32_t Round(uint32_t a,uint32_t b) {return (a+b-1)/b*b;}


__aicore__ inline void PackWeights(GlobalTensor<int8_t> source,GlobalTensor<int8_t> packed,
    GlobalTensor<int64_t> ends,uint32_t e,uint32_t k,uint32_t n,uint32_t workers) {
    const uint32_t np=Round(n,64),chunks=(k+31)/32;
    LocalTensor<int8_t> input(TPosition::VECIN,0,32*Round(n,64));
    LocalTensor<int8_t> nz(TPosition::VECCALC,98304,32*Round(n,64));
    for(uint32_t job=GetBlockIdx();job<e*chunks;job+=workers*2) {
        const uint32_t expert=job/chunks,begin=job%chunks*32;
        if(uint32_t(ends.GetValue(expert))==(expert?uint32_t(ends.GetValue(expert-1)):0))continue;
        const uint32_t rows=Min(32,k-begin);
        DataCopyPad(input,source[uint64_t(expert)*k*n+uint64_t(begin)*n],
            DataCopyExtParams{uint16_t(rows),n,0,(np-Round(n,32))/32,0},DataCopyPadExtParams<int8_t>{true,0,uint8_t(Round(n,32)-n),0});
        Fence<HardEvent::MTE2_V>();
        for(uint32_t col=0;col<np/32;++col)
            DataCopy(nz[col*rows*32],input[col*32],DataCopyParams{uint16_t(rows),1,uint16_t(np/32-1),0});
        Fence<HardEvent::V_MTE3>();
        for(uint32_t col=0;col<np/32;++col)
            DataCopy(packed[uint64_t(expert)*k*np+uint64_t(col)*k*32+begin*32],nz[col*rows*32],rows*32);
        Fence<HardEvent::MTE3_MTE2>();Fence<HardEvent::MTE3_V>();
    }
    SyncAll<true>();CrossCoreSetFlag<2,PIPE_MTE3>(8);
}

__aicore__ inline void Prepare(GlobalTensor<int8_t> a,GlobalTensor<int8_t> b,
    uint32_t rows,uint32_t cols,uint32_t k,uint32_t n,uint32_t panel) {
    const uint32_t bank=panel%BANKS,depth=Min(SPAN,k-panel*SPAN);
    const event_t ev=event_t(uint32_t(EVENT_ID2)+bank);
    if(panel>=BANKS)WaitFlag<HardEvent::MTE1_MTE2>(ev);
    LocalTensor<int8_t> a1(TPosition::A1,bank*PANEL_BYTES,TM*SPAN);
    LocalTensor<int8_t> b1(TPosition::A1,bank*PANEL_BYTES+TM*SPAN,TN*SPAN);
    if(depth%64!=0) {
        // Nd2Nz pads a partial C0 only; explicitly clear all consumed K lanes.
        InitConstValue(a1.ReinterpretCast<uint32_t>(),InitConstValueParams<uint32_t>{1,uint16_t(TM*SPAN/32),0,0});
        InitConstValue(b1.ReinterpretCast<uint32_t>(),InitConstValueParams<uint32_t>{1,uint16_t(TN*SPAN/32),0,0});
        PipeBarrier<PIPE_MTE2>();
    }
    gmmPackedTransfer::Copy(a1,a[panel*SPAN],rows,depth,k,TM);
    DataCopy(b1,b[uint64_t(panel*SPAN)*32],DataCopyParams{uint16_t(Round(cols,32)/32),uint16_t(depth),uint16_t(k-depth),uint16_t(SPAN-depth)});
    SetFlag<HardEvent::MTE2_MTE1>(ev);
}

__aicore__ inline void Cube(GlobalTensor<int8_t> a,GlobalTensor<int8_t> b,
    GlobalTensor<int32_t> scratch,uint32_t rows,uint32_t cols,uint32_t k,uint32_t n,uint32_t slot) {
    const uint32_t r=Round(rows,16)<32?32:Round(rows,16),c=Round(cols,32);
    const uint32_t panels=(k+SPAN-1)/SPAN;
    LocalTensor<int32_t> acc(TPosition::CO1,0,TM*TN);
    for(uint32_t p=0;p<Min(BANKS,panels);++p)Prepare(a,b,rows,cols,k,n,p);
    uint32_t sequence=0;
    for(uint32_t panel=0;panel<panels;++panel) {
        const uint32_t bank=panel%BANKS;
        const event_t ev=event_t(uint32_t(EVENT_ID2)+bank);
        WaitFlag<HardEvent::MTE2_MTE1>(ev);
        LocalTensor<int8_t> a1(TPosition::A1,bank*PANEL_BYTES,TM*SPAN);
        LocalTensor<int8_t> b1(TPosition::A1,bank*PANEL_BYTES+TM*SPAN,TN*SPAN);
        const uint32_t padded=Round(Min(SPAN,k-panel*SPAN),64);
        for(uint32_t start=0;start<padded;start+=STEP,++sequence) {
            const uint32_t d=Min(STEP,padded-start),l0slot=sequence%2;
            const event_t l0ev=l0slot?EVENT_ID1:EVENT_ID0;
            if(sequence>=2)WaitFlag<HardEvent::M_MTE1>(l0ev);
            LocalTensor<int8_t> a0(TPosition::A2,l0slot*TM*STEP,TM*STEP);
            LocalTensor<int8_t> b0(TPosition::B2,l0slot*TN*STEP,TN*STEP);
            LoadData2DParams ap;ap.repeatTimes=r/16;ap.srcStride=1;ap.dstGap=d/32-1;
            for(uint32_t q=0;q<d/32;++q)LoadData(a0[q*512],a1[(start+q*32)*TM],ap);
            LoadData2dTransposeParams bp;bp.repeatTimes=d/32;bp.srcStride=1;bp.dstGap=c/16-1;
            for(uint32_t col=0;col<c/32;++col)LoadDataWithTranspose(b0[col*1024],b1[col*SPAN*32+start*32],bp);
            SetFlag<HardEvent::MTE1_M>(l0ev);WaitFlag<HardEvent::MTE1_M>(l0ev);
            MmadParams mm;mm.m=r;mm.n=c;mm.k=d;mm.cmatrixInitVal=sequence==0;
            Mmad(acc,a0,b0,mm);SetFlag<HardEvent::M_MTE1>(l0ev);
        }
        SetFlag<HardEvent::MTE1_MTE2>(ev);
        if(panel+BANKS<panels)Prepare(a,b,rows,cols,k,n,panel+BANKS);
    }
    WaitFlag<HardEvent::M_MTE1>(EVENT_ID0);
    if(sequence>1)WaitFlag<HardEvent::M_MTE1>(EVENT_ID1);
    for(uint32_t bank=0;bank<Min(BANKS,panels);++bank)
        WaitFlag<HardEvent::MTE1_MTE2>(event_t(uint32_t(EVENT_ID2)+bank));
    Fence<HardEvent::M_FIX>();
    FixpipeParamsV220 fp;fp.mSize=r;fp.nSize=c;fp.srcStride=r;fp.dstStride=c;
    Fixpipe<int32_t,int32_t,CFG_ROW_MAJOR>(scratch,acc,fp);
    CrossCoreSetFlag<2,PIPE_FIX>(4+slot);Fence<HardEvent::FIX_M>();
}

__aicore__ inline void Epilogue(GlobalTensor<int32_t> scratch,GlobalTensor<float> scales,
    GlobalTensor<half> out,uint32_t rows,uint32_t cols,uint32_t n,uint32_t slot) {
    constexpr uint32_t CAP=TM/2*TN;
    const uint32_t r=Round(rows,16)<32?32:Round(rows,16),h=r/2,c=Round(cols,32),count=h*c,sub=GetSubBlockIdx();
    LocalTensor<int32_t> ints(TPosition::VECIN,0,CAP);
    LocalTensor<float> z(TPosition::VECCALC,CAP*4+256,CAP),t(TPosition::VECCALC,0,CAP);
    LocalTensor<float> s(TPosition::VECIN,CAP*8+512,TN);
    LocalTensor<half> result(TPosition::VECOUT,CAP*8+512+TN*4,CAP);
    DataCopyPad(s,scales,DataCopyExtParams{1,cols*4,0,0,0},DataCopyPadExtParams<float>{true,0,0,0});
    CrossCoreWaitFlag<2,PIPE_MTE2>(4+slot);
    DataCopy(ints,scratch[sub*count],count);Fence<HardEvent::MTE2_V>();
    Cast(z,ints,RoundMode::CAST_RINT,count);PipeBarrier<PIPE_V>();
    for(uint32_t col=0;col<c;col+=64)
        Mul(z[col],z[col],s[col],uint64_t(Min(64,c-col)),uint8_t(h),{1,1,1,uint8_t(c/8),uint8_t(c/8),0});
    PipeBarrier<PIPE_V>();
    Mul(t,z,z,count);PipeBarrier<PIPE_V>();
    Muls(t,t,-0.07135481387376785f,count);PipeBarrier<PIPE_V>();
    Adds(t,t,-1.5957691216057308f,count);PipeBarrier<PIPE_V>();
    Mul(t,t,z,count);PipeBarrier<PIPE_V>();
    Exp(t,t,count);PipeBarrier<PIPE_V>();
    Adds(t,t,1.0f,count);PipeBarrier<PIPE_V>();
    Div(z,z,t,count);PipeBarrier<PIPE_V>();
    Cast(result,z,RoundMode::CAST_RINT,count);Fence<HardEvent::V_MTE3>();
    const uint32_t valid=rows>sub*h?Min(h,rows-sub*h):0;
    if(valid)DataCopyPad(out[uint64_t(sub*h)*n],result,DataCopyExtParams{uint16_t(valid),cols*2,(c-Round(cols,16))/16,(n-cols)*2,0});
    Fence<HardEvent::MTE3_S>();CrossCoreSetFlag<2,PIPE_MTE3>(6+slot);
}

__aicore__ inline void GroupedMatmulGeluBaseline(GM_ADDR x,GM_ADDR weight,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,GM_ADDR workspace,
    uint32_t e,uint32_t k,uint32_t n,uint32_t workers,uint64_t delay) {
    GlobalTensor<int8_t> a,b;GlobalTensor<float> s;GlobalTensor<int64_t> ends;
    GlobalTensor<half> out;GlobalTensor<int32_t> scratch;
    a.SetGlobalBuffer((__gm__ int8_t*)x);b.SetGlobalBuffer((__gm__ int8_t*)weight);
    s.SetGlobalBuffer((__gm__ float*)scale);ends.SetGlobalBuffer((__gm__ int64_t*)groups);out.SetGlobalBuffer((__gm__ half*)y);
    DataCacheCleanAndInvalid<int64_t,CacheLine::ENTIRE_DATA_CACHE,DcciDst::CACHELINE_OUT>(ends);
    GlobalTensor<int8_t> packed;
    packed.SetGlobalBuffer((__gm__ int8_t*)workspace+uint64_t(workers)*OUT_SLOTS*TM*TN*4);
    if ASCEND_IS_AIC {CrossCoreWaitFlag<2,PIPE_S>(8);}else{PackWeights(b,packed,ends,e,k,n,workers);}
    uint32_t worker;if ASCEND_IS_AIC {worker=GetBlockIdx();}else{worker=GetBlockIdx()/2;}
    scratch.SetGlobalBuffer((__gm__ int32_t*)workspace+uint64_t(worker)*OUT_SLOTS*TM*TN);
    uint32_t previous=0,base=0,produced=0;
    const uint32_t nt=(n+TN-1)/TN;
    for(uint32_t expert=0;expert<e;++expert) {
        const uint32_t end=uint32_t(ends.GetValue(expert)),length=end-previous,tasks=(length+TM-1)/TM*nt;
        const uint32_t first=(worker+workers-base%workers)%workers;
        for(uint32_t task=first;task<tasks;task+=workers) {
            const uint32_t row=task/nt*TM,col=task%nt*TN,rows=Min(TM,length-row),cols=Min(TN,n-col),slot=produced%OUT_SLOTS;
            if ASCEND_IS_AIC {
                if(produced>=OUT_SLOTS)CrossCoreWaitFlag<2,PIPE_S>(6+slot);
                Cube(a[uint64_t(previous+row)*k],packed[uint64_t(expert)*k*Round(n,64)+uint64_t(col)*k],scratch[slot*TM*TN],rows,cols,k,n,slot);
            }else{
                Epilogue(scratch[slot*TM*TN],s[uint64_t(expert)*n+col],out[uint64_t(previous+row)*n+col],rows,cols,n,slot);
            }
            ++produced;
        }
        base+=tasks;previous=end;
    }
    if ASCEND_IS_AIC {
        for(uint32_t slot=0;slot<Min(produced,OUT_SLOTS);++slot)CrossCoreWaitFlag<2,PIPE_S>(6+slot);
        const uint64_t start=GetSystemCycle();while(uint64_t(GetSystemCycle())-start<delay){}
    }
    PipeBarrier<PIPE_ALL>();
}
}

namespace gmmPlan {
using namespace AscendC;
enum class Matrix { Stream, Packed, ReduceK, LongRows, WideRows, Column };
enum class Vector { Tiny, SingleExpert, UnitK };
struct Plan { uint32_t m,k,n,e,workers; uint64_t delay; };
template<Matrix method>
__global__ __mix__(1,2) void Grouped(GM_ADDR x,GM_ADDR weight,GM_ADDR scale,GM_ADDR groups,
    GM_ADDR y,GM_ADDR workspace,Plan p) {
    if constexpr(method==Matrix::Stream) gmmStream::GroupedMatmulGeluBaseline(x,weight,scale,groups,y,workspace,p.e,p.k,p.n,p.workers,p.delay);
    if constexpr(method==Matrix::Packed) gmmPackedMatrix::GroupedMatmulGeluBaseline(x,weight,scale,groups,y,workspace,p.e,p.k,p.n,p.workers,p.delay);
    if constexpr(method==Matrix::ReduceK) gmmLongK::GroupedMatmulGeluBaseline(x,weight,scale,groups,y,workspace,p.e,p.k,p.n,p.workers,p.delay);
    if constexpr(method==Matrix::LongRows) gmmLongRows::GroupedMatmulGeluBaseline(x,weight,scale,groups,y,workspace,p.e,p.k,p.n,p.workers,p.delay);
    if constexpr(method==Matrix::WideRows) gmmWideLongRows::GroupedMatmulGeluBaseline(x,weight,scale,groups,y,workspace,p.e,p.k,p.n,p.workers,p.delay);
    if constexpr(method==Matrix::Column) gmmNarrowColumn::GroupedMatmulGeluBaseline(x,weight,scale,groups,y,workspace,p.m,p.k,p.e,p.workers,p.delay);
}
template<Vector method>
__global__ __aicore__ void Degenerate(GM_ADDR x,GM_ADDR weight,GM_ADDR scale,GM_ADDR groups,
    GM_ADDR y,Plan p) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
        if constexpr(method==Vector::SingleExpert) gmmSingleExpert::SingleExpert(x,weight,scale,y,p.m,p.k,p.n,p.workers,p.delay);
        if constexpr(method==Vector::UnitK) gmmK1::GroupedMatmulGeluBaseline(x,weight,scale,groups,y,p.m,p.e,p.n,p.workers,p.delay);
        if constexpr(method==Vector::Tiny) {
        if(p.m%4==0 && p.k<=4 && p.n<=8 && p.e*p.k<=32) {
#define GMM_TINY_DEPTH(K) case K:gmmStream::TinyFourBlockVmla<K>(x,weight,scale,groups,y,p.m,p.e,p.n,p.delay);break
            switch(p.k){GMM_TINY_DEPTH(1);GMM_TINY_DEPTH(2);GMM_TINY_DEPTH(3);GMM_TINY_DEPTH(4);}
#undef GMM_TINY_DEPTH
        }else gmmStream::SmallVector(x,weight,scale,groups,y,p.m,p.k,p.e,p.n,p.delay);
    }
}
inline uint32_t Round(uint32_t value,uint32_t tile){return (value+tile-1)/tile*tile;}
}

extern "C" void run_kernel(GM_ADDR x,const TensorGroupInfo& info_x,
    GM_ADDR weight,const TensorGroupInfo& info_weight,GM_ADDR scale,
    const TensorGroupInfo& info_scale,GM_ADDR group_list,const TensorGroupInfo& info_group_list,
    GM_ADDR y,const TensorGroupInfo& info_y,int64_t availableCoreNum,aclrtStream stream) {
    using namespace gmmStream;
    using namespace gmmPlan;
    Require(info_x.numTensors==1 && info_weight.numTensors==1 && info_scale.numTensors==1 &&
            info_group_list.numTensors==1 && info_y.numTensors==1);
    const auto& a=info_x.tensors[0];const auto& w=info_weight.tensors[0];const auto& s=info_scale.tensors[0];
    const auto& g=info_group_list.tensors[0];const auto& o=info_y.tensors[0];
    Require(a.numDims==2 && w.numDims==3 && s.numDims==2 && g.numDims==1 && o.numDims==2);
    Require(a.dtype==3 && w.dtype==3 && s.dtype==0 && g.dtype==6 && o.dtype==1);
    const int64_t m=a.shape[0],k=a.shape[1],e=w.shape[0],n=w.shape[2];
    Require(m>=1 && m<=65536 && e>=1 && e<=128 && k>=1 && k<=8192 && n>=1 && n<=4096);
    Require(w.shape[1]==k && s.shape[0]==e && s.shape[1]==n && g.shape[0]==e &&
            o.shape[0]==m && o.shape[1]==n && availableCoreNum>0);
    const uint64_t tailDelayTicks = 0ULL;
    Plan plan{uint32_t(m),uint32_t(k),uint32_t(n),uint32_t(e),uint32_t(availableCoreNum),tailDelayTicks};
    // Structural degeneracies use vectors; all dimensions remain runtime values.
    if(e==1) {
        plan.workers=std::min<int64_t>(availableCoreNum*2,((m+gmmSingleExpert::TM-1)/gmmSingleExpert::TM)*((n+gmmSingleExpert::TN-1)/gmmSingleExpert::TN));
        Degenerate<Vector::SingleExpert><<<plan.workers,nullptr,stream>>>(x,weight,scale,group_list,y,plan);return;
    }
    if(m*n<=256 && m*k<=4096 && e*k*n<=4096 && e*n<=1024) {
        plan.workers=(m%4==0 && k<=4 && n<=8 && e*k<=32)?m/4:1;Degenerate<Vector::Tiny><<<plan.workers,nullptr,stream>>>(x,weight,scale,group_list,y,plan);return;
    }
    if(k==1 && m<=8192) {
        plan.workers=availableCoreNum*2;
        Degenerate<Vector::UnitK><<<plan.workers,nullptr,stream>>>(x,weight,scale,group_list,y,plan);return;
    }
    Matrix method=Matrix::Stream;
    uint64_t bytes=uint64_t(plan.workers)*gmmStream::OUTPUT_SLOTS*gmmStream::TM*gmmStream::TN*4;
    const uint32_t columnK=Round(k,gmmNarrowColumn::STEP),kp=Round(k,256),np=Round(n,256);
    if(n==1 && uint64_t(64+32)*columnK<=512*1024 && 8192+uint64_t(columnK)*32<=184*1024) {
        method=Matrix::Column;
        bytes=uint64_t(plan.workers)*2*64*32*4+uint64_t(e)*columnK*32;
    } else if(n>=gmmPackedMatrix::TN &&
              (m>=e*gmmPackedMatrix::TM || (m>=e*(gmmPackedMatrix::TM/2) && n>=2*gmmPackedMatrix::TN)) && m<=65504 &&
              uint64_t(gmmPackedMatrix::TM)*kp+4ULL*256*gmmPackedMatrix::TN<=512*1024) {
        // Reuse full-K A when it fits beside the B ring and enough rows amortize packing.
        method=Matrix::Packed;
        const uint32_t tileRows=(m<=e*64 && n>=512)?64:128,tileCols=32768/tileRows;
        const uint32_t tasks=e*((m+e*tileRows-1)/(e*tileRows))*((n+tileCols-1)/tileCols);
        const uint32_t waves=(tasks+availableCoreNum-1)/availableCoreNum;
        plan.workers=(tasks+waves-1)/waves;
        bytes=uint64_t(plan.workers)*2*gmmPackedMatrix::SLOT*4;
        if(k%32 || n%32)bytes+=uint64_t(Round(m,32)+32)*Round(k,32)+uint64_t(e)*Round(k,32)*Round(n,32);
    } else if(k>2048 && n>=256 && n<=1024) {
        if(m>e*256) {
            method=Matrix::LongRows;
            bytes=uint64_t(plan.workers)*2*32768*4+uint64_t(e)*k*Round(n,32);
        } else {
            method=Matrix::ReduceK;
            const uint64_t split=uint64_t((m+std::min(m,e)*(gmmLongK::TM-1))/gmmLongK::TM)*((n+127)/128)*4*192*128*4;
            const uint64_t columns=(n+63)/64;
            const uint64_t smallCapacity=std::min<int64_t>(e,std::max<int64_t>(0,(int64_t(plan.workers)-12)/4));
            const uint64_t atomic=(columns*512*64+Round((columns+smallCapacity)*8,64)+smallCapacity*4*32*576)*4;
            bytes=std::max(bytes,std::max(split,atomic));
        }
    } else if(k>2048 && n>1024 && m>e*256 && 98304+32*Round(n,64)<=184*1024) {
        method=Matrix::WideRows;
        bytes=uint64_t(plan.workers)*2*32768*4+uint64_t(e)*k*Round(n,64);
    }
    void* workspace=nullptr;CheckAcl(aclrtMalloc(&workspace,bytes,ACL_MEM_MALLOC_HUGE_FIRST));
    #define GMM_LAUNCH_MODE(M) case Matrix::M: Grouped<Matrix::M><<<plan.workers,nullptr,stream>>>(x,weight,scale,group_list,y,(GM_ADDR)workspace,plan);break
    switch(method){GMM_LAUNCH_MODE(Stream);GMM_LAUNCH_MODE(Packed);GMM_LAUNCH_MODE(ReduceK);GMM_LAUNCH_MODE(LongRows);GMM_LAUNCH_MODE(WideRows);GMM_LAUNCH_MODE(Column);}
#undef GMM_LAUNCH_MODE
    CheckAcl(aclrtSynchronizeStream(stream));CheckAcl(aclrtFree(workspace));
}
