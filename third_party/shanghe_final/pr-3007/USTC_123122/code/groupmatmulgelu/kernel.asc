for(i32 e=0;e<E;++e){const i64 end=ends.GetValue(e);const i32 rows=end-start,rt=(rows+15)/16;const i64 count=(i64)rt*nc,lo=count*id/workers,hi=count*(id+1)/workers;int previousCol=-1;
for(i64 tile=lo;tile<hi;++tile){const i32 row=(tile%rt)*16,col=(tile/rt)*256,mr=rows-row<16?rows-row:16,nr=N-col<256?N-col:256;
DataCopyPad(xv,a[start+row],DataCopyExtParams{1,(u32)mr,0,0,0},DataCopyPadExtParams<int8_t>{true,0,0,0});
if(previousCol!=col){DataCopyPad(bv,b[(i64)e*N+col],DataCopyExtParams{1,(u32)nr,0,0,0},DataCopyPadExtParams<int8_t>{true,0,0,0});DataCopyPad(sc,scale[(i64)e*N+col],DataCopyExtParams{1,(u32)nr*4,0,0,0},DataCopyPadExtParams<float>{true,0,0,0});}
auto ms=pipe.FetchEventID(HardEvent::MTE2_S);SetFlag<HardEvent::MTE2_S>(ms);WaitFlag<HardEvent::MTE2_S>(ms);auto mv=pipe.FetchEventID(HardEvent::MTE2_V);SetFlag<HardEvent::MTE2_V>(mv);WaitFlag<HardEvent::MTE2_V>(mv);
if(previousCol!=col){Cast(hv,bv,RoundMode::CAST_NONE,256);PipeBarrier<PIPE_V>();Cast(wf,hv,RoundMode::CAST_NONE,256);PipeBarrier<PIPE_V>();previousCol=col;}
for(i32 r=0;r<mr;++r){const i32 av=(i32)xv.GetValue(r);Muls(z[r*256],wf,(float)av,256);}PipeBarrier<PIPE_V>();for(int c=0;c<4;++c)Mul(z[c*64],z[c*64],sc[c*64],(u64)64,(uint8_t)mr,BinaryRepeatParams{1,1,1,32,32,0});PipeBarrier<PIPE_V>();
AxisGelu(z,u,t,f,p,h,mr*256);auto vo=pipe.FetchEventID(HardEvent::V_MTE3);SetFlag<HardEvent::V_MTE3>(vo);WaitFlag<HardEvent::V_MTE3>(vo);DataCopyPad(out[(start+row)*N+col],h,DataCopyExtParams{(uint16_t)mr,(u32)nr*2,(u32)(16-(nr+15)/16),(u32)(N-nr)*2,0});auto reuse=pipe.FetchEventID(HardEvent::MTE3_MTE2);SetFlag<HardEvent::MTE3_MTE2>(reuse);WaitFlag<HardEvent::MTE3_MTE2>(reuse);
}start=end;}
}
__global__ __aicore__ void AxisN1Dot(GM_ADDR x,GM_ADDR w,GM_ADDR s,GM_ADDR groups,GM_ADDR y,i32 K,i32 E){
KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);TPipe pipe;GlobalTensor<int8_t>a,b;GlobalTensor<float>scale;GlobalTensor<i64>ends;GlobalTensor<half>out;a.SetGlobalBuffer((__gm__ int8_t*)x);b.SetGlobalBuffer((__gm__ int8_t*)w);scale.SetGlobalBuffer((__gm__ float*)s);ends.SetGlobalBuffer((__gm__ i64*)groups);out.SetGlobalBuffer((__gm__ half*)y);
