static void MedSquare_Run(GM_ADDR x,const TensorGroupInfo&ix,GM_ADDR weight,const TensorGroupInfo&iw,GM_ADDR scale,const TensorGroupInfo&isc,GM_ADDR group_list,const TensorGroupInfo&ig,GM_ADDR y,const TensorGroupInfo&iy,i64 acn,aclrtStream stream){
const i32 M=ix.tensors[0].shape[0],K=ix.tensors[0].shape[1];const i32 E=iw.tensors[0].shape[0],N=iw.tensors[0].shape[2];if(N%256!=0){CPCTail64Run(x,ix,weight,iw,scale,isc,group_list,ig,y,iy,acn,stream);return;}
auto platform=platform_ascendc::PlatformAscendCManager::GetInstance();if(!platform||acn<1)throw std::runtime_error("invalid core budget/platform");u64 ubBytes=0;platform->GetCoreMemSize(platform_ascendc::CoreMemType::UB,ubBytes);if(ubBytes<143872){CPCTail64Run(x,ix,weight,iw,scale,isc,group_list,ig,y,iy,acn,stream);return;}
u32 blocks=std::min<i64>(acn,platform->GetCoreNumAic());if(!blocks)throw std::runtime_error("no Cube cores");if(K%256==0&&K>=768&&((reinterpret_cast<u64>(x)|reinterpret_cast<u64>(weight))&31)==0){
u64 l1=0,l0a=0,l0b=0,l0c=0;platform->GetCoreMemSize(platform_ascendc::CoreMemType::L1,l1);platform->GetCoreMemSize(platform_ascendc::CoreMemType::L0_A,l0a);platform->GetCoreMemSize(platform_ascendc::CoreMemType::L0_B,l0b);platform->GetCoreMemSize(platform_ascendc::CoreMemType::L0_C,l0c);if(l1>=245760&&l0a>=16384&&l0b>=65536&&l0c>=65536){
void*cNative=nullptr;const bool wide=K%512==0&&K>=1024&&N%512==0&&l1>=294912&&l0c>=131072;if(aclrtMalloc(&cNative,(size_t)blocks*(wide?65536:32768)*sizeof(i32),ACL_MEM_MALLOC_HUGE_FIRST)==ACL_SUCCESS){
