checkGmm(aclrtMalloc(&workspace,sys,ACL_MEM_MALLOC_HUGE_FIRST));checkGmm(aclrtMalloc(&scratch,blocks*2*4096,ACL_MEM_MALLOC_HUGE_FIRST));GmmGeneral_grouped_matmul_gelu_custom<<<blocks,nullptr,stream>>>(x,weight,scale,group_list,y,(GM_ADDR)workspace,(GM_ADDR)scratch,tiling,M,K,N,E);aclError status=aclrtSynchronizeStream(stream);aclrtFree(scratch);aclrtFree(workspace);checkGmm(status);
