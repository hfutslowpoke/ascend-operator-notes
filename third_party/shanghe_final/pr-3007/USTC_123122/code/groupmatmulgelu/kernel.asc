const size_t sys=platform->GetLibApiWorkSpaceSize();if(sys==0)return false;
void*workspace=nullptr,*scratch=nullptr;aclError status=aclrtMalloc(&workspace,sys,ACL_MEM_MALLOC_HUGE_FIRST);if(status==ACL_SUCCESS)status=aclrtMalloc(&scratch,cBytes,ACL_MEM_MALLOC_HUGE_FIRST);if(status!=ACL_SUCCESS){
if(scratch)aclrtFree(scratch);if(workspace)aclrtFree(workspace);return false;
}
TCubeTiling nativeUnusedTiling{};R32TallLowDirectPairKernel<<<blocks,nullptr,stream>>>(x,weight,scale,group_list,y,(GM_ADDR)workspace,(GM_ADDR)scratch,nativeUnusedTiling,M,K,N,E);status=aclrtSynchronizeStream(stream);aclrtFree(scratch);aclrtFree(workspace);if(status!=ACL_SUCCESS)throw std::runtime_error("TallLow native direct ACL error "+std::to_string(status));
return true;
}
static void TallLow_Run(GM_ADDR x,const TensorGroupInfo&ix,GM_ADDR weight,const TensorGroupInfo&iw,GM_ADDR scale,const TensorGroupInfo&isc,GM_ADDR group_list,const TensorGroupInfo&ig,GM_ADDR y,const TensorGroupInfo&iy,i64 acn,aclrtStream stream,bool wideFallback=false){
const i32 M=ix.tensors[0].shape[0],K=ix.tensors[0].shape[1];const i32 E=iw.tensors[0].shape[0],N=iw.tensors[0].shape[2];if(N%32==0){TallLow_AlignedRun(x,ix,weight,iw,scale,isc,group_list,ig,y,iy,acn,stream,wideFallback);return;}
if(TallLowTryNativeDirectRun(x,ix,weight,iw,scale,isc,group_list,ig,y,iy,acn,stream))return;
auto fallback=[&](){
if(wideFallback)CPCMid64Run(x,ix,weight,iw,scale,isc,group_list,ig,y,iy,acn,stream);else CPCRect256Run(x,ix,weight,iw,scale,isc,group_list,ig,y,iy,acn,stream);
};auto platform=platform_ascendc::PlatformAscendCManager::GetInstance();if(!platform||acn<1)throw std::runtime_error("invalid core budget/platform");u64 ubBytes=0;platform->GetCoreMemSize(platform_ascendc::CoreMemType::UB,ubBytes);if(ubBytes<143872+(((u64)E*8+31)/32*32)){fallback();return;}
