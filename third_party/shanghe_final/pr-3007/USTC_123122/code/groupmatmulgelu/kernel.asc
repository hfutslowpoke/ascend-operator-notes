const i32 id=GetBlockIdx(),workers=GetBlockNum();i64 start=0;for(i32 e=0;e<E;++e){const i64 end=ends.GetValue(e);const i32 rows=end-start,jobs=(rows+rm-1)/rm;if(!jobs){start=end;continue;}const float sf=scale.GetValue(e);
DataCopyPad(bv,b[(i64)e*K],DataCopyExtParams{1,(u32)K,0,0,0},DataCopyPadExtParams<int8_t>{true,0,(uint8_t)(kp-K),0});auto mv=pipe.FetchEventID(HardEvent::MTE2_V);SetFlag<HardEvent::MTE2_V>(mv);WaitFlag<HardEvent::MTE2_V>(mv);Cast(hb,bv,RoundMode::CAST_NONE,kp);PipeBarrier<PIPE_V>();Cast(fb,hb,RoundMode::CAST_NONE,kp);PipeBarrier<PIPE_V>();
for(i32 job=id;job<jobs;job+=workers){const i32 row=job*rm,mr=rows-row<rm?rows-row:rm;DataCopyPad(av,a[(start+row)*K],DataCopyExtParams{(uint16_t)mr,(u32)K,0,0,0},DataCopyPadExtParams<int8_t>{true,0,(uint8_t)(kp-K),0});SetFlag<HardEvent::MTE2_V>(mv);WaitFlag<HardEvent::MTE2_V>(mv);Cast(ha,av,RoundMode::CAST_NONE,mr*kp);PipeBarrier<PIPE_V>();Cast(fa,ha,RoundMode::CAST_NONE,mr*kp);PipeBarrier<PIPE_V>();for(i32 r=0;r<mr;++r)Mul(fa[r*kp],fa[r*kp],fb,kp);PipeBarrier<PIPE_V>();
