TCubeTiling tiling;i32 statusTiling=mt.GetTiling(tiling);if(largeTile&&(statusTiling!=0||tiling.baseM!=32||tiling.baseN!=64)){
largeTile=false;mt.SetShape(16,64,K);mt.SetFixSplit(16,64,64);statusTiling=mt.GetTiling(tiling);
}
if(statusTiling!=0)throw std::runtime_error("INT8 tiling failed");void*workspace=nullptr,*scratch=nullptr;size_t sys=platform->GetLibApiWorkSpaceSize();auto checkGmm=[](aclError err){if(err!=ACL_SUCCESS)throw std::runtime_error("GMM ACL error "+std::to_string(err));};checkGmm(aclrtMalloc(&workspace,sys,ACL_MEM_MALLOC_HUGE_FIRST));checkGmm(aclrtMalloc(&scratch,blocks*2*(largeTile?8192:4096),ACL_MEM_MALLOC_HUGE_FIRST));
if(largeTile){
GmmPart2D_grouped_matmul_gelu_m32<<<blocks,nullptr,stream>>>(x,weight,scale,group_list,y,(GM_ADDR)workspace,(GM_ADDR)scratch,tiling,M,K,N,E);
}else{
GmmPart2D_grouped_matmul_gelu_custom<<<blocks,nullptr,stream>>>(x,weight,scale,group_list,y,(GM_ADDR)workspace,(GM_ADDR)scratch,tiling,M,K,N,E);
}
