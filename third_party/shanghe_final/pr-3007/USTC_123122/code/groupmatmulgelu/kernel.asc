static bool TallLowTryNativeDirectRun(GM_ADDR x,const TensorGroupInfo&ix,GM_ADDR weight,const TensorGroupInfo&iw,GM_ADDR scale,const TensorGroupInfo&isc,GM_ADDR group_list,const TensorGroupInfo&ig,GM_ADDR y,const TensorGroupInfo&iy,i64 acn,aclrtStream stream){
const i32 M=ix.tensors[0].shape[0],K=ix.tensors[0].shape[1];const i32 E=iw.tensors[0].shape[0],N=iw.tensors[0].shape[2];if(M<=0||K<=0||N<=0||E<=0||acn<1||K>65535||N>65535||N%32==0)return false;
const i32 tail=N%256;if(tail>0&&tail<=64)return false;
auto platform=platform_ascendc::PlatformAscendCManager::GetInstance();if(!platform)return false;
const u32 blocks=std::min<i64>(acn,platform->GetCoreNumAic());if(!blocks||platform->GetCoreNumAiv()<2*blocks)return false;
const i64 kp64=((i64)K+63)/64*64;if(kp64<64||kp64/32>255)return false;
u64 ub=0,l1=0,l0a=0,l0b=0,l0c=0;platform->GetCoreMemSize(platform_ascendc::CoreMemType::UB,ub);platform->GetCoreMemSize(platform_ascendc::CoreMemType::L1,l1);platform->GetCoreMemSize(platform_ascendc::CoreMemType::L0_A,l0a);platform->GetCoreMemSize(platform_ascendc::CoreMemType::L0_B,l0b);platform->GetCoreMemSize(platform_ascendc::CoreMemType::L0_C,l0c);if(ub<107520||l1<(u64)kp64*352||l0a<24576||l0b<65536||l0c<98304)return false;
