static void GmmPart2DRun(GM_ADDR x,const TensorGroupInfo&ix,GM_ADDR weight,const TensorGroupInfo&iw,GM_ADDR scale,const TensorGroupInfo&isc,GM_ADDR group_list,const TensorGroupInfo&ig,GM_ADDR y,const TensorGroupInfo&iy,i64 acn,aclrtStream stream){
const i32 M=ix.tensors[0].shape[0],K=ix.tensors[0].shape[1];const i32 E=iw.tensors[0].shape[0],N=iw.tensors[0].shape[2];auto platform=platform_ascendc::PlatformAscendCManager::GetInstance();if(!platform||acn<1)throw std::runtime_error("invalid core budget/platform");u32 blocks=std::min<i64>(acn,platform->GetCoreNumAic());
if(!blocks)throw std::runtime_error("no Cube cores");matmul_tiling::MatmulApiTiling mt(*platform);mt.SetAType(matmul_tiling::TPosition::GM,matmul_tiling::CubeFormat::ND,matmul_tiling::DataType::DT_INT8);mt.SetBType(matmul_tiling::TPosition::GM,matmul_tiling::CubeFormat::ND,matmul_tiling::DataType::DT_INT8);mt.SetCType(matmul_tiling::TPosition::GM,matmul_tiling::CubeFormat::ND,matmul_tiling::DataType::DT_INT32);u64 l0a=0,l0b=0,l0c=0;platform->GetCoreMemSize(platform_ascendc::CoreMemType::L0_A,l0a);
