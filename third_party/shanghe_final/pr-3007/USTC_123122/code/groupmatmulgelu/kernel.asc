}start=end;}
}

static int AddedReserveFamily(i64 M,i64 K,i64 N,i64 E,const GmmResources&r){
if(E>8)return 0;
if(M<=16&&N<=64&&K<=32&&M*N<=64&&M*N*K<=256)return 0;
if(GmmTileUpper(M,N,E)<=2*std::min(r.cube,r.vector/2))return 0;
if(N>1024)return K<=1024?7:K<=2048?16:25;
if(N>512&&K>2048)return 22;
return 0;
}
extern"C" void run_kernel(GM_ADDR x,const TensorGroupInfo&ix,GM_ADDR weight,const TensorGroupInfo&iw,GM_ADDR scale,const TensorGroupInfo&isc,GM_ADDR group_list,const TensorGroupInfo&ig,GM_ADDR y,const TensorGroupInfo&iy,i64 acn,aclrtStream stream){
GmmCheckTensor(ix,2,3);GmmCheckTensor(iw,3,3);GmmCheckTensor(isc,2,0);GmmCheckTensor(ig,1,6);GmmCheckTensor(iy,2,1);const i64 M=ix.tensors[0].shape[0],K=ix.tensors[0].shape[1];const i64 E=iw.tensors[0].shape[0],N=iw.tensors[0].shape[2];if(acn<1||!x||!weight||!scale||!group_list||!y||iw.tensors[0].shape[1]!=K||isc.tensors[0].shape[0]!=E||isc.tensors[0].shape[1]!=N||ig.tensors[0].shape[0]!=E||iy.tensors[0].shape[0]!=M||iy.tensors[0].shape[1]!=N)throw std::runtime_error("inconsistent GMM metadata/budget");
auto platform=platform_ascendc::PlatformAscendCManager::GetInstance();if(!platform)throw std::runtime_error("GMM platform unavailable");GmmResources resources{};resources.cube=platform->GetCoreNumAic();resources.vector=platform->GetCoreNumAiv();platform->GetCoreMemSize(platform_ascendc::CoreMemType::UB,resources.ub);platform->GetCoreMemSize(platform_ascendc::CoreMemType::L1,resources.l1);
platform->GetCoreMemSize(platform_ascendc::CoreMemType::L0_A,resources.l0a);platform->GetCoreMemSize(platform_ascendc::CoreMemType::L0_B,resources.l0b);platform->GetCoreMemSize(platform_ascendc::CoreMemType::L0_C,resources.l0c);const GmmPartition partition=GmmChoosePartition(M,K,N,E,resources);const bool vectorOnly=partition==GmmPartition::TinyMultiple||partition==GmmPartition::TinyScalar;
if(resources.ub>=181504&&resources.vector>0){const u32 vb=std::min<i64>(acn,resources.vector);if(N==1&&M>=256){if(TryAlignedLongKRing(x,ix,weight,iw,scale,group_list,y,acn,stream))return;AxisN1Dot<<<vb,nullptr,stream>>>(x,weight,scale,group_list,y,K,E);return;}if(K==1&&M>=16&&N>=64){AxisK1Outer<<<vb,nullptr,stream>>>(x,weight,scale,group_list,y,N,E);return;}}
const i64 budget=vectorOnly?acn:std::min(acn,std::min(resources.cube,resources.vector/2));switch(AddedReserveFamily(M,K,N,E,resources)){
case 7:CaseR07Run(x,ix,weight,iw,scale,isc,group_list,ig,y,iy,budget,stream);return;
case 16:if(TryAlignedLongKRing(x,ix,weight,iw,scale,group_list,y,budget,stream))return;CaseR16Run(x,ix,weight,iw,scale,isc,group_list,ig,y,iy,budget,stream);return;
case 25:if(TryAlignedLongKRing(x,ix,weight,iw,scale,group_list,y,budget,stream))return;GmmLongNRun(x,ix,weight,iw,scale,isc,group_list,ig,y,iy,budget,stream);return;
case 22:if(TryAlignedLongKRing(x,ix,weight,iw,scale,group_list,y,budget,stream))return;GmmLongNRun(x,ix,weight,iw,scale,isc,group_list,ig,y,iy,budget,stream);return;
default:break;
}switch(partition){
case GmmPartition::TinyMultiple:TinyMultiRun(x,ix,weight,iw,scale,isc,group_list,ig,y,iy,budget,stream);return;
case GmmPartition::TinyScalar:TinyScalarRun(x,ix,weight,iw,scale,isc,group_list,ig,y,iy,budget,stream);return;
case GmmPartition::ShortNarrow:ShortNarrow_Run(x,ix,weight,iw,scale,isc,group_list,ig,y,iy,budget,stream);return;
case GmmPartition::ShortMediumWidth:ShortWide_Run(x,ix,weight,iw,scale,isc,group_list,ig,y,iy,budget,stream);return;
case GmmPartition::ShortMidExperts:ShortMid_Run(x,ix,weight,iw,scale,isc,group_list,ig,y,iy,budget,stream);return;
case GmmPartition::ShortManyExperts:ShortMany_Run(x,ix,weight,iw,scale,isc,group_list,ig,y,iy,budget,stream);return;
case GmmPartition::MediumSquare:MedSquare_Run(x,ix,weight,iw,scale,isc,group_list,ig,y,iy,budget,stream);return;
case GmmPartition::MediumTallAligned:TallAligned_Run(x,ix,weight,iw,scale,isc,group_list,ig,y,iy,budget,stream);return;
case GmmPartition::MediumTallTailLowConcurrency:TallLow_Run(x,ix,weight,iw,scale,isc,group_list,ig,y,iy,budget,stream);return;
case GmmPartition::MediumTallTailHighConcurrency:TallHigh_Run(x,ix,weight,iw,scale,isc,group_list,ig,y,iy,budget,stream);return;
case GmmPartition::MediumWide:MedWide_Run(x,ix,weight,iw,scale,isc,group_list,ig,y,iy,budget,stream,true);return;
case GmmPartition::FewExpertMedium:GmmP2QZeroRun(x,ix,weight,iw,scale,isc,group_list,ig,y,iy,budget,stream);return;
case GmmPartition::LongFewExpert:GmmLongNRun(x,ix,weight,iw,scale,isc,group_list,ig,y,iy,budget,stream);return;
case GmmPartition::FewTiles:SparseTile_Run(x,ix,weight,iw,scale,isc,group_list,ig,y,iy,budget,stream);return;
case GmmPartition::FewExpertShortResidual:GmmResidualDRun(x,ix,weight,iw,scale,isc,group_list,ig,y,iy,budget,stream);return;
case GmmPartition::Failover:GmmGeneralRun(x,ix,weight,iw,scale,isc,group_list,ig,y,iy,budget,stream);return;
default:GmmGeneralRun(x,ix,weight,iw,scale,isc,group_list,ig,y,iy,budget,stream);return;
}}
__aicore__ static __attribute__((noinline,section(".long_k_tail")))bool LongKTailNext(GM_ADDR groups,int E,int Np,int cc,int core,int step,LongKTailTask&j){
GlobalTensor<i64>g;g.SetGlobalBuffer((__gm__ i64*)groups);const int nc=Np/128;int nt=0,cut=0,eq=0,prev=0;u64 hist=0;for(int e=0;e<E;++e){
const int end=g.GetValue(e),r=end-prev,f=r/128,b=r%128;nt+=(f+(b!=0))*nc;hist+=(u64)f<<56;if(b)hist+=1ULL<<(((b-1)/16)*8);prev=end;
}
const int extra=nt-cc;const bool split=extra>0&&2*extra<=cc;if(split){
if(step>1||(step&&core>=2*extra))return false;
eq=extra;for(;cut<7;++cut){
const int n=(hist&255)*nc;if(eq<=n)break;eq-=n;hist>>=8;
}}else if(core+step*cc>=nt)return false;
const int target=split?(step?core%extra:core):core+step*cc;int st=0,base=0,n=0,seen=0;for(int e=0;e<E;++e){
const int end=g.GetValue(e),rs=end-st,count=(rs+127)/128*nc;if(!split){
if(target<base+count){
const int t=target-base;const int r=t/nc*128;j={e,st+r,rs-r<128?rs-r:128,t%nc*128,target,-1};return true;
}}else for(int r=0;r<rs;r+=128){
const int b=(rs-r<128?rs-r-1:127)/16;for(int c=0;c<nc;++c){
const bool take=b<cut||(b==cut&&seen++<eq);if(take==(step!=0)&&n++==target){
j={e,st+r,rs-r<128?rs-r:128,c*128,base+r/128*nc+c,take?(core>=extra?-2:nt+target):-1};return true;
}}}
st=end;base+=count;
}
return false;
}
