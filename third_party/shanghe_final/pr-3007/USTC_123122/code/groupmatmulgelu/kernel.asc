static void TallHigh_Run(GM_ADDR x,const TensorGroupInfo&ix,GM_ADDR weight,const TensorGroupInfo&iw,GM_ADDR scale,const TensorGroupInfo&isc,GM_ADDR group_list,const TensorGroupInfo&ig,GM_ADDR y,const TensorGroupInfo&iy,i64 acn,aclrtStream stream,bool wideFallback=false){
const i32 M=ix.tensors[0].shape[0],K=ix.tensors[0].shape[1];const i32 E=iw.tensors[0].shape[0],N=iw.tensors[0].shape[2];if(N%32==0){TallHigh_AlignedRun(x,ix,weight,iw,scale,isc,group_list,ig,y,iy,acn,stream,wideFallback);return;}
auto fallback=[&](){
