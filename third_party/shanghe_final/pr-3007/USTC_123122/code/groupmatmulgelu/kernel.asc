i32 tileM=(N%32!=0&&(i64)M>64LL*E&&(i64)M<=128LL*E&&(i64)E*((N+255)/256)>=4LL*platform->GetCoreNumAic()?128:64);const bool use96=tileM==64&&(i64)M>128LL*E&&(((i64)M+95)/96)*((N+255)/256)>=2LL*blocks;if(use96)tileM=96;i32 tileCols=256;mt.SetShape(tileM,tileCols,K);mt.SetOrgShape(M,N,K);mt.SetFixSplit(tileM,tileCols,tileCols==384?64:128);
mt.SetBufferSpace(-1,-1,-1);TCubeTiling tiling;if(mt.GetTiling(tiling)!=0||(tileCols==384&&(tiling.baseM!=80||tiling.baseN!=384||tiling.baseK!=64))){
tileM=64;tileCols=256;mt.SetShape(tileM,256,K);mt.SetFixSplit(tileM,256,128);if(mt.GetTiling(tiling)!=0){fallback();return;}}
void*workspace=nullptr,*scratch=nullptr;size_t sys=platform->GetLibApiWorkSpaceSize();auto checkGmm=[](aclError err){if(err!=ACL_SUCCESS)throw std::runtime_error("GMM ACL error "+std::to_string(err));};checkGmm(aclrtMalloc(&workspace,sys,ACL_MEM_MALLOC_HUGE_FIRST));checkGmm(aclrtMalloc(&scratch,blocks*2*2*tileM*tileCols*sizeof(i32),ACL_MEM_MALLOC_HUGE_FIRST));if(use96&&tileM==96)MedWide_TailExpM96Kernel<<<blocks,nullptr,stream>>>(x,weight,scale,group_list,y,(GM_ADDR)workspace,(GM_ADDR)scratch,tiling,M,K,N,E,tileM);
else MedWide_TailActiveRowsKernel<<<blocks,nullptr,stream>>>(x,weight,scale,group_list,y,(GM_ADDR)workspace,(GM_ADDR)scratch,tiling,M,K,N,E,tileM);aclError status=aclrtSynchronizeStream(stream);aclrtFree(scratch);aclrtFree(workspace);checkGmm(status);
}
