#define LongK_REAL_K_STEP \
const int bk=kc&1,lb=(kc/2)%3;const TEventID li=static_cast<TEventID>(EVENT_ID1+lb);\
const TEventID mi=static_cast<TEventID>(EVENT_ID5+bk),bi=static_cast<TEventID>(EVENT_ID4+lb);\
if(!bk)WaitFlag<HardEvent::MTE2_MTE1>(li);WaitFlag<HardEvent::M_MTE1>(mi);\
if(mr==128){\
