static __aicore__ inline void FewResidualDirectPadReadFootprint(LocalTensor<int8_t>dst,i32 physicalHeight,i32 readHeight,i32 readWidth,i32 actualHeight,i32 actualWidth){
const i32 widthC0=(actualWidth+31)/32,readC0=readWidth/32;if(actualHeight<readHeight){
InitConstValueParams<u32>p{};p.repeatTimes=(uint16_t)readC0;p.blockNum=(uint16_t)(readHeight-actualHeight);p.dstGap=(uint16_t)(physicalHeight-(readHeight-actualHeight));p.initValue=0;InitConstValue(dst[actualHeight*32].ReinterpretCast<u32>(),p);
}
if(widthC0<readC0){
InitConstValueParams<u32>p{};p.repeatTimes=(uint16_t)(readC0-widthC0);p.blockNum=(uint16_t)readHeight;p.dstGap=(uint16_t)(physicalHeight-readHeight);p.initValue=0;InitConstValue(dst[(i64)widthC0*physicalHeight*32].ReinterpretCast<u32>(),p);
}}
static __aicore__ inline void FewResidualDirectLoadA(LocalTensor<int8_t>dst,GlobalTensor<int8_t>a,i64 row,i32 K,i32 mr,i32 mMath,i32 kk){
const i32 validK=K-kk<128?K-kk:128;FewResidualDirectPadReadFootprint(dst,128,mMath,128,mr,validK);Nd2NzParams cp{};cp.ndNum=1;cp.nValue=(uint16_t)mr;cp.dValue=(uint16_t)validK;cp.srcNdMatrixStride=0;cp.srcDValue=(uint16_t)K;cp.dstNzC0Stride=128;cp.dstNzNStride=1;cp.dstNzMatrixStride=0;DataCopy(dst,a[row*K+kk],cp);
}
static __aicore__ inline void FewResidualDirectLoadB(LocalTensor<int8_t>dst,GlobalTensor<int8_t>b,i32 e,i32 col,i32 K,i32 N,i32 Kp){
const i32 nr=N-col<256?N-col:256;FewResidualDirectPadReadFootprint(dst,Kp,Kp,256,K,nr);Nd2NzParams cp{};cp.ndNum=1;cp.nValue=(uint16_t)K;cp.dValue=(uint16_t)nr;cp.srcNdMatrixStride=0;cp.srcDValue=(uint16_t)N;cp.dstNzC0Stride=(uint16_t)Kp;cp.dstNzNStride=1;cp.dstNzMatrixStride=0;DataCopy(dst,b[(i64)e*K*N+col],cp);
}
struct FewResidualOwner{
int e=-1,lo=0,hi=0,left=0,right=0,base=0;__aicore__ inline void Init(GlobalTensor<i64>g,int E,int nc,int id,int cores){
if(nc<2||nc>cores)return;
int e0=-1,main=0,shorts=0;i64 prev=0;for(int i=0;i<E;++i){
const i64 end=g.GetValue(i);const int rt=(end-prev+127)/128;prev=end;if(rt>cores){
if(e0>=0)return;
e0=i;main=rt;
}else if(rt>1)return;
else shorts+=rt;
