enum class GmmPartition{
MediumSquare=1,FewExpertMedium=2,TinyMultiple=3,ShortNarrow=4,MediumTallAligned=5,ShortMediumWidth=6,LongFewExpert=7,MediumWide=8,ShortMidExperts=9,ShortManyExperts=10,FewTiles=11,MediumTallTailLowConcurrency=12,MediumTallTailHighConcurrency=13,FewExpertShortResidual=14,TinyScalar=15,Failover=16
};
struct GmmResources{i64 cube,vector;u64 ub,l1,l0a,l0b,l0c;};
static i64 GmmTileUpper(i64 M,i64 N,i64 E){const i64 nonempty=std::min(E,M);return(nonempty+(M-nonempty)/16)*((N+63)/64);}
static GmmPartition GmmChoosePartition(i64 M,i64 K,i64 N,i64 E,const GmmResources&resources){
if(M<1||M>65536||K<1||K>8192||N<1||N>4096||E<1||E>128)throw std::runtime_error("invalid GMM dimensions");const i64 weights=E*K*N;const i64 bytes=M*K+weights+4*E*N+8*E+2*M*N;if(weights>268435456LL||bytes>536870912LL)throw std::runtime_error("GMM memory domain exceeded");if(M<=16&&N<=64&&K<=32&&M*N<=64&&M*N*K<=256&&resources.vector>=1&&resources.ub>=16384)return M*N<=1?GmmPartition::TinyScalar:GmmPartition::TinyMultiple;
const i64 cube=std::min(resources.cube,resources.vector/2);if(cube<1||resources.ub<32768)throw std::runtime_error("insufficient GMM resources");const bool sparseOutput=GmmTileUpper(M,N,E)<=2*cube;if(resources.ub<65536||resources.l0a<32768||resources.l0b<65536||resources.l0c<8192||resources.l1==0)return sparseOutput?GmmPartition::FewTiles:GmmPartition::Failover;
const bool fewExperts=E<=8;const bool midExperts=E<=32;const bool compactRows=M<=1024;const bool shortReduction=2*32*K<=static_cast<i64>(resources.l0a);const bool mediumReduction=32*K<=static_cast<i64>(resources.l0a);const bool streamingReduction=2*(32+64)*K>static_cast<i64>(resources.l1);const i64 columnPanels=(N+255)/256;
if(fewExperts&&compactRows&&mediumReduction&&columnPanels>=3&&columnPanels<=4)return GmmPartition::FewExpertMedium;
if(streamingReduction&&fewExperts&&compactRows)return GmmPartition::LongFewExpert;
if(fewExperts&&!compactRows&&columnPanels>=3)return shortReduction?GmmPartition::FewExpertShortResidual:GmmPartition::Failover;
if(!shortReduction&&mediumReduction&&!fewExperts&&columnPanels<=4){
if(M<=N)return GmmPartition::MediumSquare;
if(N%256==0)return GmmPartition::MediumTallAligned;
return E<=cube?GmmPartition::MediumTallTailLowConcurrency:GmmPartition::MediumTallTailHighConcurrency;
}
if(shortReduction&&!fewExperts&&columnPanels<=2)return columnPanels==1?GmmPartition::ShortNarrow:GmmPartition::ShortMediumWidth;
if(sparseOutput)return GmmPartition::FewTiles;
if(!mediumReduction)return GmmPartition::Failover;
if(shortReduction){
if(columnPanels==1)return GmmPartition::ShortNarrow;
if(columnPanels==2)return GmmPartition::ShortMediumWidth;
if(columnPanels<=4){
if(fewExperts)return GmmPartition::FewExpertShortResidual;
return midExperts?GmmPartition::ShortMidExperts:GmmPartition::ShortManyExperts;
}}else{
if(columnPanels<=4){
if(fewExperts)return compactRows?GmmPartition::FewExpertMedium:GmmPartition::Failover;
if(M<=N)return GmmPartition::MediumSquare;
if(N%256==0)return GmmPartition::MediumTallAligned;
return E<=cube?GmmPartition::MediumTallTailLowConcurrency:GmmPartition::MediumTallTailHighConcurrency;
}
if(columnPanels<=8)return GmmPartition::MediumWide;
}
if(fewExperts)return shortReduction?GmmPartition::FewExpertShortResidual:GmmPartition::Failover;
if(midExperts)return GmmPartition::MediumWide;
return GmmPartition::Failover;
}
static void GmmCheckTensor(const TensorGroupInfo&info,i64 rank,i32 dtype){
if(info.numTensors!=1||!info.tensors||info.tensors[0].numDims!=rank||!info.tensors[0].shape||info.tensors[0].dtype!=dtype)throw std::runtime_error("invalid GMM tensor metadata");
}
