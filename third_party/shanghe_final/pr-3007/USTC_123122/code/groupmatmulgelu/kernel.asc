const i32 M=ix.tensors[0].shape[0],K=ix.tensors[0].shape[1],E=iw.tensors[0].shape[0],N=iw.tensors[0].shape[2];
if(E>8||K<1792||(N<=512&&N!=1)||M<=1024)return false;
auto p=platform_ascendc::PlatformAscendCManager::GetInstance();const char*soc=aclrtGetSocName();
if(!p||!soc||std::strcmp(soc,"Ascend910_9362")!=0)return false;
const u32 blocks=std::min<i64>(budget,std::min(p->GetCoreNumAic(),p->GetCoreNumAiv()/2));if(!blocks)return false;
u64 ub=0,l1=0,a0=0,b0=0,c0=0;
p->GetCoreMemSize(platform_ascendc::CoreMemType::UB,ub);p->GetCoreMemSize(platform_ascendc::CoreMemType::L1,l1);
p->GetCoreMemSize(platform_ascendc::CoreMemType::L0_A,a0);p->GetCoreMemSize(platform_ascendc::CoreMemType::L0_B,b0);p->GetCoreMemSize(platform_ascendc::CoreMemType::L0_C,c0);
const i32 kp=(K+255)/256*256,np=(N+127)/128*128;
if(i64(K)*8<i64(kp)*7)return false;
if(ub<181504||l1<393216||a0<65536||b0<65536||c0<65536||(N!=1&&i64(N)*4<i64(np)*3))return false;
const u64 aBytes=K==kp?0:u64(M)*kp,bBytes=K==kp&&N==np?0:u64(E)*kp*np;if(aBytes+bBytes>256ULL*1024*1024)return false;
void *ws=nullptr,*cs=nullptr,*bp=nullptr,*ap=nullptr;aclError err=aclrtMalloc(&ws,p->GetLibApiWorkSpaceSize(),ACL_MEM_MALLOC_HUGE_FIRST);
if(err==ACL_SUCCESS)err=aclrtMalloc(&cs,blocks*2ULL*16384*sizeof(i32),ACL_MEM_MALLOC_HUGE_FIRST);
if(err==ACL_SUCCESS&&aBytes)err=aclrtMalloc(&ap,aBytes,ACL_MEM_MALLOC_HUGE_FIRST);
if(err==ACL_SUCCESS&&bBytes)err=aclrtMalloc(&bp,bBytes,ACL_MEM_MALLOC_HUGE_FIRST);
if(err!=ACL_SUCCESS){if(ap)aclrtFree(ap);if(bp)aclrtFree(bp);if(cs)aclrtFree(cs);if(ws)aclrtFree(ws);return false;}
GmmD1603_long_native64<false,true><<<blocks,nullptr,stream>>>(x,w,scale,groups,y,(GM_ADDR)ws,(GM_ADDR)cs,M,K,N,E,(GM_ADDR)ap,(GM_ADDR)bp,kp,np);
err=aclrtSynchronizeStream(stream);if(ap)aclrtFree(ap);if(bp)aclrtFree(bp);aclrtFree(cs);aclrtFree(ws);
if(err!=ACL_SUCCESS)throw std::runtime_error("aligned longK ring failed");return true;
}

// Single-axis specializations; all groups and all valid outputs are computed.
__aicore__ inline void AxisGelu(LocalTensor<float>z,LocalTensor<float>u,LocalTensor<float>t,LocalTensor<float>f,LocalTensor<float>p,LocalTensor<half>h,i32 n){
Abs(u,z,n);PipeBarrier<PIPE_V>();Mul(t,u,u,n);PipeBarrier<PIPE_V>();Muls(t,t,0.044715f,n);PipeBarrier<PIPE_V>();Adds(t,t,1.0f,n);PipeBarrier<PIPE_V>();Mul(t,t,u,n);PipeBarrier<PIPE_V>();Muls(t,t,-1.5957691216057308f,n);PipeBarrier<PIPE_V>();Exp(p,t,n);PipeBarrier<PIPE_V>();Adds(t,p,1.0f,n);PipeBarrier<PIPE_V>();Div(p,p,t,n);PipeBarrier<PIPE_V>();Mul(u,u,p,n);Maxs(f,z,0.0f,n);PipeBarrier<PIPE_V>();Sub(f,f,u,n);PipeBarrier<PIPE_V>();Cast(h,f,RoundMode::CAST_RINT,n);PipeBarrier<PIPE_V>();
}
__global__ __aicore__ void AxisK1Outer(GM_ADDR x,GM_ADDR w,GM_ADDR s,GM_ADDR groups,GM_ADDR y,i32 N,i32 E){
KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);TPipe pipe;GlobalTensor<int8_t>a,b;GlobalTensor<float>scale;GlobalTensor<i64>ends;GlobalTensor<half>out;a.SetGlobalBuffer((__gm__ int8_t*)x);b.SetGlobalBuffer((__gm__ int8_t*)w);scale.SetGlobalBuffer((__gm__ float*)s);ends.SetGlobalBuffer((__gm__ i64*)groups);out.SetGlobalBuffer((__gm__ half*)y);
TBuf<TPosition::VECCALC>xb,bb,bh,bf,ss,zz,uu,tt,ff,pp,hh;pipe.InitBuffer(xb,32);pipe.InitBuffer(bb,256);pipe.InitBuffer(bh,512);pipe.InitBuffer(bf,1024);pipe.InitBuffer(ss,1024);pipe.InitBuffer(zz,16384);pipe.InitBuffer(uu,16384);pipe.InitBuffer(tt,16384);pipe.InitBuffer(ff,16384);pipe.InitBuffer(pp,16384);pipe.InitBuffer(hh,8192);auto xv=xb.Get<int8_t>();auto bv=bb.Get<int8_t>();auto hv=bh.Get<half>();auto wf=bf.Get<float>();auto sc=ss.Get<float>();auto z=zz.Get<float>();auto u=uu.Get<float>();auto t=tt.Get<float>();auto f=ff.Get<float>();auto p=pp.Get<float>();auto h=hh.Get<half>();
