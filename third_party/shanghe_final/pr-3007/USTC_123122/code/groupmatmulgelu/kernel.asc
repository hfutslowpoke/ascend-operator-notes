__aicore__ inline void SparseTileNativeConsume(GlobalTensor<i32>c,GlobalTensor<float>scale,GlobalTensor<half>out,LocalTensor<i32>ci,LocalTensor<float>z,LocalTensor<float>u,LocalTensor<float>t,LocalTensor<float>f,LocalTensor<float>sc,LocalTensor<half>h,LocalTensor<float>poly,i64 outOff,i64 scaleOff,i32 mr,i32 tn,i32 N,i32 halfRows){
