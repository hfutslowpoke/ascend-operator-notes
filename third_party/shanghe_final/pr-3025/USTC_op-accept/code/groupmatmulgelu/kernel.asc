#include "kernel_operator.h"
#include "kernel_tiling/kernel_tiling.h"
#include "tiling/platform/platform_ascendc.h"
#include "tiling/tiling_api.h"
#include <algorithm>
#include <cstdint>
#include <stdexcept>
// SDK configuration: select Cube-only Matmul support before including its header.
#define ASCENDC_CUBE_ONLY
#include "lib/matmul_intf.h"

namespace GroupedGelu {
__aicore__ constexpr uint32_t NzPackedRows(uint32_t rows) {
    return (rows + 15) / 16 * 16;
}
}

namespace GroupedGelu {
struct CubePrefetchTask {
    uint32_t expert, row, rows, col, sequence;
};

template <uint32_t TM, uint32_t TN>
struct CubePrefetchCursor {
    uint32_t core, sequence, nTiles, expert, start, end, base, task, tasks;
    bool loaded;

    template <typename P>
    __aicore__ inline void Init(const P &p, uint32_t c) {
        core = c;
        sequence = 0;
        nTiles = (p.n + TN - 1) / TN;
        expert = 0;
        start = 0;
        end = 0;
        base = 0;
        task = 0;
        tasks = 0;
        loaded = false;
    }

    template <typename Ends, typename P>
    __aicore__ inline bool Next(const Ends &ends, const P &p, CubePrefetchTask &out) {
        while (expert < p.e) {
            if (!loaded) {
                end = static_cast<uint32_t>(ends.GetValue(expert));
                tasks = (end - start + TM - 1) / TM * nTiles;
                task = (core + p.cores - base % p.cores) % p.cores;
                loaded = true;
            }
            if (task < tasks) {
                out.expert = expert;
                out.row = start + task / nTiles * TM;
                out.rows = end - out.row < TM ? end - out.row : TM;
                out.col = task % nTiles * TN;
                out.sequence = sequence++;
                task += p.cores;
                return true;
            }
            start = end;
            base += tasks;
            ++expert;
            loaded = false;
        }
        return false;
    }
};

// After exhaustion tasks<=task<tasks+cores, so subtraction preserves cyclic ownership.
template <uint32_t TM, uint32_t TN>
struct MediumCarryCursor {
    uint32_t core, sequence, nTiles, expert, start, end, base, task, tasks;
    bool loaded;

    template <typename P>
    __aicore__ inline void Init(const P &p, uint32_t c) {
        core = c;
        sequence = 0;
        nTiles = (p.n + TN - 1) / TN;
        expert = 0;
        start = 0;
        end = 0;
        base = 0;
        task = c;
        tasks = 0;
        loaded = false;
    }

    template <typename Ends, typename P>
    __aicore__ inline bool Next(const Ends &ends, const P &p, CubePrefetchTask &out) {
        while (expert < p.e) {
            if (!loaded) {
                end = static_cast<uint32_t>(ends.GetValue(expert));
                tasks = (end - start + TM - 1) / TM * nTiles;
                loaded =
                    true; // task is the residual cyclic offset carried from the preceding expert.
            }
            if (task < tasks) {
                out.expert = expert;
                out.row = start + task / nTiles * TM;
                out.rows = end - out.row < TM ? end - out.row : TM;
                out.col = task % nTiles * TN;
                out.sequence = sequence++;
                task += p.cores;
                return true;
            }
            start = end;
            task -= tasks;
            ++expert;
            loaded = false;
        }
        return false;
    }
};

template <uint32_t TM, uint32_t TN, uint32_t SK>
struct MediumCursorChoice {
    using Type = CubePrefetchCursor<TM, TN>;
};

template <>
struct MediumCursorChoice<128, 256, 512> {
    using Type = MediumCarryCursor<128, 256>;
};

template <>
struct MediumCursorChoice<64, 256, 512> {
    using Type = MediumCarryCursor<64, 256>;
};

}

namespace GroupedGelu {
using namespace AscendC;

__aicore__ constexpr MatmulConfig Config() {
    auto c = GetMDLConfig(false, false, 0, false, false, false, true);
    c.enableSetBias = false;
    c.enableQuantVector = false;
    c.enableSetDefineData = false;
    c.iterateMode = IterateMode::ITERATE_MODE_NORMAL;
    return c;
}

constexpr auto MM_CONFIG = Config();

struct Plan {
    TCubeTiling cube;
    uint32_t m, k, n, e, cores, wn, rawK, ka, rawA;
};

// Aligned ND manual capacity: double full A and two K512 B stages share L1.
constexpr uint32_t ND64_TM = 64, ND64_TN = 256, ND64_STAGE = 512, ND64_STEP = 128;
constexpr uint32_t ND64_CAPACITY = (512 * 1024 - 2 * ND64_TN * ND64_STAGE) / (2 * ND64_TM);

inline bool UseNd64(uint32_t m, uint32_t k, uint32_t n, uint32_t e) {
    return e > 0 && k > 0 && n > 0 && k % 32 == 0 && n % 32 == 0 && k <= ND64_CAPACITY &&
           uint64_t(m) <= uint64_t(ND64_TM) * e;
}
// SHAPE_FAMILIES_BEGIN
enum class ShapeFamily {
    NdWideRows,
    NdWideMerged,
    NdShort,
    NdLongMerged,
    SmallOnePass,
    NzFullA1,
    NzStream,
    NdStandard,
    NdMedium,
    TinyGeneric,
    FallbackSmall,
    FallbackND,
    FallbackNZ,
    FallbackWide,
    NdManual64
};

struct ShapeChoice {
    ShapeFamily family;
};

inline uint32_t AlignedExtent(uint32_t value, uint32_t block) {
    return (value + block - 1) / block * block;
}

inline ShapeChoice SelectShapeFamily(uint32_t m, uint32_t k, uint32_t n, uint32_t e) {
    using F = ShapeFamily;
    constexpr uint32_t K_BLOCK = 128, N_UNIT = 256, PACK = 32;

    if (e <= 1 && m <= 64 && k <= 128 && n <= 128 && k % PACK == 0 && n % PACK == 0)
        return {F::SmallOnePass};

    if (m <= 16 && k <= 16 && n <= 16 && uint64_t(m) * k * n <= 4096)
        return {F::TinyGeneric};

    if (uint64_t(m) * k * n <= 2097152)
        return {F::FallbackSmall};

    if (k % PACK == 0 && n % PACK == 0) {
        if (k > 8 * K_BLOCK && k <= 16 * K_BLOCK && n > 3 * N_UNIT && n <= 4 * N_UNIT &&
            m / e <= 64)
            return {F::NdWideRows};
        if (k <= 2 * K_BLOCK && n <= N_UNIT)
            return {F::NdShort};
        if (k > 2 * K_BLOCK && k <= 4 * K_BLOCK && n > 2 * N_UNIT && n <= 3 * N_UNIT)
            return {F::NdMedium};
        // These are genuine N ranges; the merged cursor handles a partial final tile.
        if (k > 4 * K_BLOCK && k <= 8 * K_BLOCK && n > 3 * N_UNIT && n <= 4 * N_UNIT)
            return {F::NdWideMerged};
        if (k > 4 * K_BLOCK && k <= 8 * K_BLOCK && n > 2 * N_UNIT && n <= 3 * N_UNIT) {
            if (UseNd64(m, k, n, e))
                return {F::NdManual64};
            return {F::NdStandard};
        }
        if (k > 8 * K_BLOCK && k <= 16 * K_BLOCK && n > 2 * N_UNIT && n <= 3 * N_UNIT)
            return {F::NdLongMerged};
        if (k >= 16 * K_BLOCK && n >= 4 * N_UNIT && m / e <= 64)
            return {F::FallbackWide};
        return {F::FallbackND};
    }

    // Two full A1 rows and two 512x128 B1 stages share 512 KiB.
    // The whole nonaligned domain uses this capacity rule, independently of N.
    const uint32_t pk = AlignedExtent(k, PACK);
    if (2ULL * 128 * pk + 2ULL * 128 * 512 <= 512 * 1024)
        return {F::NzFullA1};
    return {F::NzStream};
}

// SHAPE_FAMILIES_END
template <HardEvent E>
__aicore__ inline void Sync(TPipe &p) {
    auto id = p.FetchEventID(E);
    SetFlag<E>(id);
    WaitFlag<E>(id);
}

template <uint32_t TM, uint32_t TN, bool NZ, uint32_t SK>
__aicore__ constexpr auto StaticConfig() {
    using A = MatmulType<TPosition::GM, CubeFormat::ND, int8_t, false>;
    using B = MatmulType<TPosition::GM, NZ ? CubeFormat::NZ : CubeFormat::ND, int8_t, false>;
    using C = MatmulType<TPosition::GM, CubeFormat::ND, int32_t>;
    auto c = Config();
    if (SK) {
        c.basicM = TM;
        c.basicN = TN;
        c.basicK = (TM > TN ? 32768 / TM : 32768 / TN);
        if (c.basicK > 256)
            c.basicK = 256;
        c.singleCoreM = TM;
        c.singleCoreN = TN;
        c.singleCoreK = SK;
    }
    if (SK == 2048 && TM == 128 && TN > 512 && TN <= 1024 && !NZ) {
        c.basicN = 256;
        c.basicK = 128;
    }
    if (SK == 2048 && TM == 64 && TN == 1024 && !NZ) {
        c.basicN = 512;
        c.basicK = 64;
    }
    if (SK == 1024 && TM == 128 && TN == 512 && !NZ) {
        c.basicN = 256;
        c.basicK = 128;
    }
    auto t = GetMatmulApiTiling<A, B, C, C>(c);
    if (SK == 1024 && TM == 128 && TN == 512 && !NZ) {
        t.stepM = 1;
        t.stepN = 1;
        t.depthA1 = 8;
        t.stepKa = 8;
        t.depthB1 = 4;
        t.stepKb = 2;
        t.shareL1Size = (t.depthA1 * t.baseM + t.depthB1 * t.baseN) * t.baseK;
    }
    if (SK == 2048 && TM == 128 && TN > 512 && TN <= 1024 && !NZ) {
        t.stepM = 1;
        t.stepN = 1;
        t.depthA1 = 16;
        t.stepKa = 16;
        t.depthB1 = 2;
        t.stepKb = 1;
        t.shareL1Size = (t.depthA1 * t.baseM + t.depthB1 * t.baseN) * t.baseK;
    }
    if (SK == 2048 && TM == 64 && TN == 1024 && !NZ) {
        t.stepM = 1;
        t.stepN = 1;
        t.depthA1 = 32;
        t.stepKa = 32;
        t.depthB1 = 8;
        t.stepKb = 4;
        t.shareL1Size = (t.depthA1 * t.baseM + t.depthB1 * t.baseN) * t.baseK;
    }
    if (SK && TM == 128 && TN == 256) {
        t.stepM = 1;
        t.stepN = 1;
        if (SK == 256) {
            t.depthA1 = 2;
            t.depthB1 = 2;
            t.stepKa = 2;
            t.stepKb = 2;
        }
        if (SK == 512) {
            t.depthA1 = 4;
            t.depthB1 = 4;
            t.stepKa = 4;
            t.stepKb = 4;
        }
        if (SK == 1024) {
            t.depthA1 = 8;
            t.depthB1 = 4;
            t.stepKa = 8;
            t.stepKb = 2;
        }
        if (SK == 2048) {
            t.depthA1 = 16;
            t.depthB1 = 4;
            t.stepKa = 16;
            t.stepKb = 2;
        }
        t.shareL1Size = t.depthA1 * TM * t.baseK + t.depthB1 * TN * t.baseK;
    }
    if (SK && NZ && TM == 128 && TN == 128) {
        t.stepM = 1;
        t.stepN = 1;
        uint32_t depth = SK == 8192 ? 8 : (SK + 255) / 256;
        t.depthA1 = depth;
        t.depthB1 = depth;
        t.stepKa = SK == 8192 ? 4 : depth;
        t.stepKb = t.stepKa;
        t.shareL1Size = (t.depthA1 * TM + t.depthB1 * TN) * t.baseK;
    }
    return t;
}

template <uint32_t TM, uint32_t TN, bool NZ, uint32_t SK>
constexpr auto STATIC_CFG = StaticConfig<TM, TN, NZ, SK>();
template <uint32_t TM, uint32_t TN, bool NZ>
constexpr auto STATIC_CFG<TM, TN, NZ, 0> = MM_CONFIG;

template <uint32_t TM, uint32_t TN, bool NZ, uint32_t SK>
__aicore__ inline void
Cube(GM_ADDR x, GM_ADDR w, GM_ADDR groups, GM_ADDR workspace, const Plan &p) {
    constexpr uint32_t CS = TM * TN;
    const uint32_t k = p.k, n = p.n, wn = p.wn, ka = NZ ? p.ka : p.k;
    TPipe pipe;
    using A = MatmulType<TPosition::GM, CubeFormat::ND, int8_t, false>;
    using B = MatmulType<TPosition::GM, NZ ? CubeFormat::NZ : CubeFormat::ND, int8_t, false>;
    using C = MatmulType<TPosition::GM, CubeFormat::ND, int32_t>;
    Matmul<A, B, C, C, STATIC_CFG<TM, TN, NZ, SK>> mm;
    mm.Init(SK ? nullptr : &p.cube, &pipe);
    mm.SetOrgShape(p.m, wn, ka, k, TN);
    GlobalTensor<int8_t> a, b;
    GlobalTensor<int64_t> ends;
    GlobalTensor<int32_t> ring;
    a.SetGlobalBuffer((__gm__ int8_t *)x);
    b.SetGlobalBuffer((__gm__ int8_t *)w);
    ends.SetGlobalBuffer((__gm__ int64_t *)groups);
    ring.SetGlobalBuffer((__gm__ int32_t *)workspace);
    uint32_t core = GetBlockIdx(), sequence = 0, start = 0, base = 0, nt = (n + TN - 1) / TN;
    for (uint32_t e = 0; e < p.e; e++) {
        uint32_t end = static_cast<uint32_t>(ends.GetValue(e));
        uint32_t mt = (end - start + TM - 1) / TM, tasks = mt * nt;
        uint32_t first = (core + p.cores - base % p.cores) % p.cores;
        for (uint32_t task = first; task < tasks; task += p.cores, sequence++) {
            uint32_t row = start + task / nt * TM, col = task % nt * TN;
            uint32_t rows = end - row < TM ? end - row : TM, cols = n - col < TN ? n - col : TN;
            mm.SetTail(rows, cols, ka);
            mm.SetTensorA(a[uint64_t(row) * ka], false);
            mm.SetTensorB(b[uint64_t(e) * k * wn + (NZ ? uint64_t(col) * k : col)], false);
            mm.Iterate();
            if (sequence >= 2)
                CrossCoreWaitFlag<2>(9);
            mm.GetTensorC(ring[(core * 2 + sequence % 2) * CS]);
            CrossCoreSetFlag<2, PIPE_FIX>(8);
        }
        start = end;
        base += tasks;
    }
    for (uint32_t i = 0; i < (sequence < 2 ? sequence : 2); i++)
        CrossCoreWaitFlag<2>(9);
    mm.End();
}

template <uint32_t TM, uint32_t TN, uint32_t SK>
__aicore__ constexpr auto PrefetchConfig() {
    using A = MatmulType<TPosition::TSCM, CubeFormat::NZ, int8_t, false>;
    using B = MatmulType<TPosition::TSCM, CubeFormat::NZ, int8_t, false>;
    using C = MatmulType<TPosition::GM, CubeFormat::ND, int32_t>;
    auto c = Config();
    c.basicM = TM;
    c.basicN = TN;
    c.basicK = (TM > TN ? 32768 / TM : 32768 / TN);
    if (c.basicK > 256)
        c.basicK = 256;
    c.singleCoreM = TM;
    c.singleCoreN = TN;
    c.singleCoreK = SK;
    return GetMatmulApiTiling<A, B, C, C>(c);
}

template <uint32_t TM, uint32_t TN, uint32_t SK>
constexpr auto PREFETCH_CFG = PrefetchConfig<TM, TN, SK>();

template <uint32_t TM, uint32_t TN, typename QA, typename QB>
__aicore__ inline void PrefetchCubeInputs(QA &aq,
                                          QB &bq,
                                          const CubePrefetchTask &task,
                                          const GlobalTensor<int8_t> &a,
                                          const GlobalTensor<int8_t> &b,
                                          const Plan &p) {
    auto al = aq.template AllocTensor<int8_t>();
    auto bl = bq.template AllocTensor<int8_t>();
    Nd2NzParams acp;
    acp.ndNum = 1;
    acp.nValue = task.rows;
    acp.dValue = p.k;
    acp.srcDValue = p.k;
    acp.dstNzC0Stride = TM;
    acp.dstNzNStride = 1;
    acp.srcNdMatrixStride = 0;
    acp.dstNzMatrixStride = 0;
    DataCopy(al, a[uint64_t(task.row) * p.k], acp);
    aq.EnQue(al);
    const uint32_t cols = p.n - task.col < TN ? p.n - task.col : TN;
    Nd2NzParams bcp;
    bcp.ndNum = 1;
    bcp.nValue = p.k;
    bcp.dValue = cols;
    bcp.srcDValue = p.n;
    bcp.dstNzC0Stride = p.k;
    bcp.dstNzNStride = 1;
    bcp.srcNdMatrixStride = 0;
    bcp.dstNzMatrixStride = 0;
    DataCopy(bl, b[uint64_t(task.expert) * p.k * p.n + task.col], bcp);
    bq.EnQue(bl);
}

template <uint32_t TM, uint32_t TN, uint32_t SK>
__aicore__ inline void
CubePrefetch(GM_ADDR x, GM_ADDR w, GM_ADDR groups, GM_ADDR workspace, const Plan &p) {
    constexpr uint32_t CS = TM * TN;
    static_assert(2ULL * (TM + TN) * SK <= 512 * 1024, "prefetch stages exceed L1");
    static_assert(PREFETCH_CFG<TM, TN, SK>.shareL1Size == 0,
                  "TSCM input must not allocate internal L1");
    TPipe pipe;
    TQue<TPosition::A1, 2> aq;
    TQue<TPosition::B1, 2> bq;
    pipe.InitBuffer(aq, 2, TM * SK);
    pipe.InitBuffer(bq, 2, TN * SK);
    using A = MatmulType<TPosition::TSCM, CubeFormat::NZ, int8_t, false>;
    using B = MatmulType<TPosition::TSCM, CubeFormat::NZ, int8_t, false>;
    using C = MatmulType<TPosition::GM, CubeFormat::ND, int32_t>;
    Matmul<A, B, C, C, PREFETCH_CFG<TM, TN, SK>> mm;
    mm.Init((const TCubeTiling *)nullptr, &pipe);
    // L1 A has TM physical rows. B has actual K physical rows, not SK.
    mm.SetOrgShape(TM, TN, p.k, p.k, TN);
    GlobalTensor<int8_t> a, b;
    GlobalTensor<int64_t> ends;
    GlobalTensor<int32_t> ring;
    a.SetGlobalBuffer((__gm__ int8_t *)x);
    b.SetGlobalBuffer((__gm__ int8_t *)w);
    ends.SetGlobalBuffer((__gm__ int64_t *)groups);
    ring.SetGlobalBuffer((__gm__ int32_t *)workspace);
    const uint32_t core = GetBlockIdx();
    uint32_t completed = 0;
    CubePrefetchCursor<TM, TN> cursor;
    cursor.Init(p, core);
    CubePrefetchTask task, next;
    bool available = cursor.Next(ends, p, task);
    if (available)
        PrefetchCubeInputs<TM, TN>(aq, bq, task, a, b, p);
    while (available) {
        auto al = aq.DeQue<int8_t>();
        auto bl = bq.DeQue<int8_t>();
        const bool more = cursor.Next(ends, p, next);
        // Alternate queues protect GM->L1 writes from preceding L1->L0 reads.
        if (more)
            PrefetchCubeInputs<TM, TN>(aq, bq, next, a, b, p);
        const uint32_t cols = p.n - task.col < TN ? p.n - task.col : TN;
        mm.SetTail(task.rows, cols, p.k);
        mm.SetTensorA(al, false);
        mm.SetTensorB(bl, false);
        mm.Iterate();
        if (task.sequence >= 2)
            CrossCoreWaitFlag<2>(9);
        mm.GetTensorC(ring[(core * 2 + task.sequence % 2) * CS]);
        CrossCoreSetFlag<2, PIPE_FIX>(8);
        aq.FreeTensor(al);
        bq.FreeTensor(bl);
        ++completed;
        if (more)
            task = next;
        available = more;
    }
    for (uint32_t i = 0; i < (completed < 2 ? completed : 2); i++)
        CrossCoreWaitFlag<2>(9);
    mm.End();
}

template <uint32_t TM, uint32_t TN>
__aicore__ inline void
Vector(GM_ADDR scale, GM_ADDR groups, GM_ADDR y, GM_ADDR workspace, const Plan &p) {
    const uint32_t n = p.n;
    constexpr uint32_t CS = TM * TN, VS = CS > 8192 ? 8192 : CS, VR = VS / TN;
    TPipe pipe;
    TBuf<TPosition::VECCALC> rawB, zB, innerB, denB, numB, halfB, scaleB, maskB, groupB;
    pipe.InitBuffer(rawB, VS * 4 + 256);
    pipe.InitBuffer(zB, VS * 4 + 256);
    pipe.InitBuffer(innerB, VS * 4 + 256);
    pipe.InitBuffer(denB, VS * 4 + 256);
    pipe.InitBuffer(numB, VS * 4 + 256);
    pipe.InitBuffer(halfB, VS * 2);
    pipe.InitBuffer(scaleB, TN * 4);
    pipe.InitBuffer(maskB, VS / 8);
    pipe.InitBuffer(groupB, 128 * 8);
    auto raw = rawB.Get<int32_t>();
    auto z = zB.Get<float>();
    auto inner = innerB.Get<float>();
    auto den = denB.Get<float>();
    auto num = numB.Get<float>();
    auto result = halfB.Get<half>();
    auto coeff = scaleB.Get<float>();
    auto mask = maskB.Get<uint8_t>();
    auto localEnds = groupB.Get<int64_t>();
    GlobalTensor<int32_t> ring;
    GlobalTensor<float> sg;
    GlobalTensor<half> out;
    GlobalTensor<int64_t> ends;
    ring.SetGlobalBuffer((__gm__ int32_t *)workspace);
    sg.SetGlobalBuffer((__gm__ float *)scale);
    out.SetGlobalBuffer((__gm__ half *)y);
    ends.SetGlobalBuffer((__gm__ int64_t *)groups);
    DataCopyExtParams gcp{1, p.e * 8U, 0, 0, 0};
    DataCopyPadExtParams<int64_t> gp{false, 0, 0, 0};
    DataCopyPad(localEnds, ends, gcp, gp);
    Sync<HardEvent::MTE2_S>(pipe);
    uint32_t core = GetBlockIdx() / 2, sequence = 0, start = 0, base = 0, nt = (n + TN - 1) / TN;
    for (uint32_t e = 0; e < p.e; e++) {
        uint32_t end = static_cast<uint32_t>(localEnds.GetValue(e));
        uint32_t mt = (end - start + TM - 1) / TM, tasks = mt * nt;
        uint32_t first = (core + p.cores - base % p.cores) % p.cores;
        for (uint32_t task = first; task < tasks; task += p.cores, sequence++) {
            uint32_t row = start + task / nt * TM, col = task % nt * TN;
            uint32_t totalRows = end - row < TM ? end - row : TM,
                     cols = n - col < TN ? n - col : TN;
            uint32_t aligned = (cols + 7) / 8 * 8;
            CrossCoreWaitFlag<2>(8);
            uint32_t halfRows = (totalRows + 1) / 2;
            uint32_t subStart = GetSubBlockIdx() * halfRows;
            uint32_t subEnd = subStart + halfRows < totalRows ? subStart + halfRows : totalRows;
            if (subStart >= subEnd)
                CrossCoreSetFlag<2, PIPE_MTE2>(9);
            for (uint32_t vrow = subStart; vrow < subEnd; vrow += VR) {
                uint32_t rows = subEnd - vrow < VR ? subEnd - vrow : VR;
                if (cols < TN)
                    Duplicate(raw, 0, VS);
                Sync<HardEvent::V_MTE2>(pipe);
                DataCopyExtParams cp{static_cast<uint16_t>(rows),
                                     cols * 4U,
                                     (TN - cols) * 4U,
                                     (TN - aligned) / 8,
                                     0};
                DataCopyPadExtParams<int32_t> pad{true, 0, static_cast<uint8_t>(aligned - cols), 0};
                DataCopyPad(raw, ring[(core * 2 + sequence % 2) * CS + vrow * TN], cp, pad);
                DataCopyExtParams scp{1, cols * 4U, 0, 0, 0};
                DataCopyPadExtParams<float> sp{true, 0, static_cast<uint8_t>(aligned - cols), 0.0f};
                if (vrow == subStart)
                    DataCopyPad(coeff, sg[uint64_t(e) * n + col], scp, sp);
                if (vrow + rows == subEnd)
                    CrossCoreSetFlag<2, PIPE_MTE2>(9);
                Sync<HardEvent::MTE2_V>(pipe);
                Cast(z, raw, RoundMode::CAST_NONE, rows * TN);
                PipeBarrier<PIPE_V>();
                for (uint32_t off = 0; off < cols; off += 64) {
                    Mul(z[off],
                        z[off],
                        coeff[off],
                        cols - off < 64 ? cols - off : 64,
                        rows,
                        {1, 1, 1, TN / 8, TN / 8, 0});
                }
                PipeBarrier<PIPE_V>();
                // Copied padding is zero, so the entire aligned tile is initialized.
                uint32_t count = rows * TN;
                // Algebraically equivalent z/(1+exp(-2*p(z))). FP32 throughout.
                Mul(inner, z, z, count);
                PipeBarrier<PIPE_V>();
                Muls(inner, inner, -0.07135481627330025f, count);
                PipeBarrier<PIPE_V>();
                Adds(inner, inner, -1.5957691216057308f, count);
                PipeBarrier<PIPE_V>();
                Mul(inner, inner, z, count);
                PipeBarrier<PIPE_V>();
                Exp(inner, inner, count);
                PipeBarrier<PIPE_V>();
                Adds(inner, inner, 1.0f, count);
                PipeBarrier<PIPE_V>();
                Div(z, z, inner, count);
                PipeBarrier<PIPE_V>();
                Cast(result, z, RoundMode::CAST_RINT, rows * TN);
                Sync<HardEvent::V_MTE3>(pipe);
                uint32_t ah = (cols + 15) / 16 * 16;
                DataCopyExtParams ocp{
                    static_cast<uint16_t>(rows), cols * 2U, (TN - ah) / 16, (n - cols) * 2U, 0};
                DataCopyPad(out[uint64_t(row + vrow) * n + col], result, ocp);
                Sync<HardEvent::MTE3_V>(pipe);
            }
        }
        start = end;
        base += tasks;
    }
}

template <uint32_t TM, uint32_t TN>
__aicore__ inline void
VectorStatic(GM_ADDR scale, GM_ADDR groups, GM_ADDR y, GM_ADDR workspace, const Plan &p) {
    InitSocState();
    const uint32_t n = p.n;
    constexpr uint32_t CS = TM * TN, VS = CS > 8192 ? 8192 : CS, VR = VS / TN;
    constexpr uint32_t RAW = 0;
    constexpr uint32_t Z = RAW + VS * 4 + 256;
    constexpr uint32_t INNER = Z + VS * 4 + 256;
    constexpr uint32_t DEN = INNER + VS * 4 + 256;
    constexpr uint32_t NUM = DEN + VS * 4 + 256;
    constexpr uint32_t HALF = NUM + VS * 4 + 256;
    constexpr uint32_t SCALE = HALF + VS * 2;
    constexpr uint32_t MASK = SCALE + TN * 4;
    constexpr uint32_t GROUP = MASK + VS / 8;
    constexpr uint32_t END = GROUP + 128 * 8;
    static_assert(END <= 192 * 1024, "generic Vector static UB capacity");
    LocalTensor<int32_t> raw(TPosition::VECCALC, RAW, VS + 64);
    LocalTensor<float> z(TPosition::VECCALC, Z, VS + 64);
    LocalTensor<float> inner(TPosition::VECCALC, INNER, VS + 64);
    LocalTensor<float> den(TPosition::VECCALC, DEN, VS + 64);
    LocalTensor<float> num(TPosition::VECCALC, NUM, VS + 64);
    LocalTensor<half> result(TPosition::VECCALC, HALF, VS);
    LocalTensor<float> coeff(TPosition::VECCALC, SCALE, TN);
    LocalTensor<uint8_t> mask(TPosition::VECCALC, MASK, VS / 8);
    LocalTensor<int64_t> localEnds(TPosition::VECCALC, GROUP, 128);
    // No queue allocates hard events here. Each local event0 is set/wait paired
    // before same-direction reuse; cross-core ring flags8/9 stay independent.
    GlobalTensor<int32_t> ring;
    GlobalTensor<float> sg;
    GlobalTensor<half> out;
    GlobalTensor<int64_t> ends;
    ring.SetGlobalBuffer((__gm__ int32_t *)workspace);
    sg.SetGlobalBuffer((__gm__ float *)scale);
    out.SetGlobalBuffer((__gm__ half *)y);
    ends.SetGlobalBuffer((__gm__ int64_t *)groups);
    DataCopyExtParams gcp{1, p.e * 8U, 0, 0, 0};
    DataCopyPadExtParams<int64_t> gp{false, 0, 0, 0};
    DataCopyPad(localEnds, ends, gcp, gp);
    SetFlag<HardEvent::MTE2_S>(0);
    WaitFlag<HardEvent::MTE2_S>(0);
    uint32_t core = GetBlockIdx() / 2, sequence = 0, start = 0, base = 0, nt = (n + TN - 1) / TN;
    for (uint32_t e = 0; e < p.e; e++) {
        uint32_t end = static_cast<uint32_t>(localEnds.GetValue(e));
        uint32_t mt = (end - start + TM - 1) / TM, tasks = mt * nt;
        uint32_t first = (core + p.cores - base % p.cores) % p.cores;
        for (uint32_t task = first; task < tasks; task += p.cores, sequence++) {
            uint32_t row = start + task / nt * TM, col = task % nt * TN;
            uint32_t totalRows = end - row < TM ? end - row : TM,
                     cols = n - col < TN ? n - col : TN;
            uint32_t aligned = (cols + 7) / 8 * 8;
            CrossCoreWaitFlag<2>(8);
            uint32_t halfRows = (totalRows + 1) / 2;
            uint32_t subStart = GetSubBlockIdx() * halfRows;
            uint32_t subEnd = subStart + halfRows < totalRows ? subStart + halfRows : totalRows;
            if (subStart >= subEnd)
                CrossCoreSetFlag<2, PIPE_MTE2>(9);
            for (uint32_t vrow = subStart; vrow < subEnd; vrow += VR) {
                uint32_t rows = subEnd - vrow < VR ? subEnd - vrow : VR;
                if (cols < TN)
                    Duplicate(raw, 0, VS);
                SetFlag<HardEvent::V_MTE2>(0);
                WaitFlag<HardEvent::V_MTE2>(0);
                DataCopyExtParams cp{static_cast<uint16_t>(rows),
                                     cols * 4U,
                                     (TN - cols) * 4U,
                                     (TN - aligned) / 8,
                                     0};
                DataCopyPadExtParams<int32_t> pad{true, 0, static_cast<uint8_t>(aligned - cols), 0};
                DataCopyPad(raw, ring[(core * 2 + sequence % 2) * CS + vrow * TN], cp, pad);
                DataCopyExtParams scp{1, cols * 4U, 0, 0, 0};
                DataCopyPadExtParams<float> sp{true, 0, static_cast<uint8_t>(aligned - cols), 0.0f};
                if (vrow == subStart)
                    DataCopyPad(coeff, sg[uint64_t(e) * n + col], scp, sp);
                if (vrow + rows == subEnd)
                    CrossCoreSetFlag<2, PIPE_MTE2>(9);
                SetFlag<HardEvent::MTE2_V>(0);
                WaitFlag<HardEvent::MTE2_V>(0);
                Cast(z, raw, RoundMode::CAST_NONE, rows * TN);
                PipeBarrier<PIPE_V>();
                for (uint32_t off = 0; off < cols; off += 64) {
                    Mul(z[off],
                        z[off],
                        coeff[off],
                        cols - off < 64 ? cols - off : 64,
                        rows,
                        {1, 1, 1, TN / 8, TN / 8, 0});
                }
                PipeBarrier<PIPE_V>();
                // Copied padding is zero, so the entire aligned tile is initialized.
                uint32_t count = rows * TN;
                // Algebraically equivalent z/(1+exp(-2*p(z))). FP32 throughout.
                Mul(inner, z, z, count);
                PipeBarrier<PIPE_V>();
                Muls(inner, inner, -0.07135481627330025f, count);
                PipeBarrier<PIPE_V>();
                Adds(inner, inner, -1.5957691216057308f, count);
                PipeBarrier<PIPE_V>();
                Mul(inner, inner, z, count);
                PipeBarrier<PIPE_V>();
                Exp(inner, inner, count);
                PipeBarrier<PIPE_V>();
                Adds(inner, inner, 1.0f, count);
                PipeBarrier<PIPE_V>();
                Div(z, z, inner, count);
                PipeBarrier<PIPE_V>();
                Cast(result, z, RoundMode::CAST_RINT, rows * TN);
                SetFlag<HardEvent::V_MTE3>(0);
                WaitFlag<HardEvent::V_MTE3>(0);
                uint32_t ah = (cols + 15) / 16 * 16;
                DataCopyExtParams ocp{
                    static_cast<uint16_t>(rows), cols * 2U, (TN - ah) / 16, (n - cols) * 2U, 0};
                DataCopyPad(out[uint64_t(row + vrow) * n + col], result, ocp);
                SetFlag<HardEvent::MTE3_V>(0);
                WaitFlag<HardEvent::MTE3_V>(0);
            }
        }
        start = end;
        base += tasks;
    }
    // Match the AIV TPipe destructor after all task and idle paths.
    PipeBarrier<PIPE_ALL>();
}

template <uint32_t TM, uint32_t TN>
__aicore__ inline void
VectorFullChunk(GM_ADDR scale, GM_ADDR groups, GM_ADDR y, GM_ADDR workspace, const Plan &p) {
    const uint32_t n = p.n;
    constexpr uint32_t CS = TM * TN, LIMIT = TN >= 256 ? 16384 : 8192, VS = CS > LIMIT ? LIMIT : CS,
                       VR = VS / TN;
    TPipe pipe;
    TBuf<TPosition::VECCALC> rawB, innerB, halfB, scaleB, groupB;
    pipe.InitBuffer(rawB, VS * 4 + 256);
    pipe.InitBuffer(innerB, VS * 4 + 256);
    pipe.InitBuffer(halfB, VS * 2);
    pipe.InitBuffer(scaleB, TN * 4);
    pipe.InitBuffer(groupB, 128 * 8);
    auto raw = rawB.Get<int32_t>();
    auto z = raw.ReinterpretCast<float>();
    auto inner = innerB.Get<float>();
    auto result = halfB.Get<half>();
    auto coeff = scaleB.Get<float>();
    auto localEnds = groupB.Get<int64_t>();
    GlobalTensor<int32_t> ring;
    GlobalTensor<float> sg;
    GlobalTensor<half> out;
    GlobalTensor<int64_t> ends;
    ring.SetGlobalBuffer((__gm__ int32_t *)workspace);
    sg.SetGlobalBuffer((__gm__ float *)scale);
    out.SetGlobalBuffer((__gm__ half *)y);
    ends.SetGlobalBuffer((__gm__ int64_t *)groups);
    DataCopyExtParams gcp{1, p.e * 8U, 0, 0, 0};
    DataCopyPadExtParams<int64_t> gp{false, 0, 0, 0};
    DataCopyPad(localEnds, ends, gcp, gp);
    Sync<HardEvent::MTE2_S>(pipe);
    uint32_t core = GetBlockIdx() / 2, sequence = 0, start = 0, base = 0, nt = (n + TN - 1) / TN;
    for (uint32_t e = 0; e < p.e; e++) {
        uint32_t end = static_cast<uint32_t>(localEnds.GetValue(e));
        uint32_t mt = (end - start + TM - 1) / TM, tasks = mt * nt;
        uint32_t first = (core + p.cores - base % p.cores) % p.cores;
        for (uint32_t task = first; task < tasks; task += p.cores, sequence++) {
            uint32_t row = start + task / nt * TM, col = task % nt * TN;
            uint32_t totalRows = end - row < TM ? end - row : TM,
                     cols = n - col < TN ? n - col : TN;
            uint32_t aligned = (cols + 7) / 8 * 8;
            CrossCoreWaitFlag<2>(8);
            uint32_t halfRows = (totalRows + 1) / 2;
            uint32_t subStart = GetSubBlockIdx() * halfRows;
            uint32_t subEnd = subStart + halfRows < totalRows ? subStart + halfRows : totalRows;
            if (subStart >= subEnd)
                CrossCoreSetFlag<2, PIPE_MTE2>(9);
            for (uint32_t vrow = subStart; vrow < subEnd; vrow += VR) {
                uint32_t rows = subEnd - vrow < VR ? subEnd - vrow : VR;
                if (cols < TN)
                    Duplicate(raw, 0, VS);
                Sync<HardEvent::V_MTE2>(pipe);
                DataCopyExtParams cp{static_cast<uint16_t>(rows),
                                     cols * 4U,
                                     (TN - cols) * 4U,
                                     (TN - aligned) / 8,
                                     0};
                DataCopyPadExtParams<int32_t> pad{true, 0, static_cast<uint8_t>(aligned - cols), 0};
                DataCopyPad(raw, ring[(core * 2 + sequence % 2) * CS + vrow * TN], cp, pad);
                DataCopyExtParams scp{1, cols * 4U, 0, 0, 0};
                DataCopyPadExtParams<float> sp{true, 0, static_cast<uint8_t>(aligned - cols), 0.0f};
                if (vrow == subStart)
                    DataCopyPad(coeff, sg[uint64_t(e) * n + col], scp, sp);
                if (vrow + rows == subEnd)
                    CrossCoreSetFlag<2, PIPE_MTE2>(9);
                Sync<HardEvent::MTE2_V>(pipe);
                Cast(z, raw, RoundMode::CAST_NONE, rows * TN);
                PipeBarrier<PIPE_V>();
                for (uint32_t off = 0; off < cols; off += 64) {
                    Mul(z[off],
                        z[off],
                        coeff[off],
                        cols - off < 64 ? cols - off : 64,
                        rows,
                        {1, 1, 1, TN / 8, TN / 8, 0});
                }
                PipeBarrier<PIPE_V>();
                // Copied padding is zero, so the entire aligned tile is initialized.
                uint32_t count = rows * TN;
                // Algebraically equivalent z/(1+exp(-2*p(z))). FP32 throughout.
                Mul(inner, z, z, count);
                PipeBarrier<PIPE_V>();
                Muls(inner, inner, -0.07135481627330025f, count);
                PipeBarrier<PIPE_V>();
                Adds(inner, inner, -1.5957691216057308f, count);
                PipeBarrier<PIPE_V>();
                Mul(inner, inner, z, count);
                PipeBarrier<PIPE_V>();
                Exp(inner, inner, count);
                PipeBarrier<PIPE_V>();
                Adds(inner, inner, 1.0f, count);
                PipeBarrier<PIPE_V>();
                Div(z, z, inner, count);
                PipeBarrier<PIPE_V>();
                Cast(result, z, RoundMode::CAST_RINT, rows * TN);
                Sync<HardEvent::V_MTE3>(pipe);
                uint32_t ah = (cols + 15) / 16 * 16;
                DataCopyExtParams ocp{
                    static_cast<uint16_t>(rows), cols * 2U, (TN - ah) / 16, (n - cols) * 2U, 0};
                DataCopyPad(out[uint64_t(row + vrow) * n + col], result, ocp);
                Sync<HardEvent::MTE3_V>(pipe);
            }
        }
        start = end;
        base += tasks;
    }
}

// MERGED_CURSOR_BEGIN
struct MergedTask {
    uint32_t expert, row, rows, col, cols;
};

template <uint32_t TM, uint32_t TN>
struct MergedCursor {
    uint32_t n, nt, position, limit, expert, start, end, base, groupLimit;
    bool loaded;

    template <class Ends>
    __aicore__ inline void Init(const Ends &ends, const Plan &p, uint32_t columns, uint32_t core) {
        n = columns;
        nt = (n + 255) / 256;
        uint32_t previous = 0, total = 0;
        for (uint32_t i = 0; i < p.e; i++) {
            uint32_t finish = static_cast<uint32_t>(ends.GetValue(i));
            total += (finish - previous + TM - 1) / TM * nt;
            previous = finish;
        }
        position = uint64_t(total) * core / p.cores;
        limit = uint64_t(total) * (core + 1) / p.cores;
        expert = 0;
        start = 0;
        end = 0;
        base = 0;
        groupLimit = 0;
        loaded = false;
    }

    template <class Ends>
    __aicore__ inline bool Next(const Ends &ends, const Plan &p, MergedTask &task) {
        if (position >= limit)
            return false;
        while (!loaded || position >= groupLimit) {
            if (loaded) {
                start = end;
                base = groupLimit;
                expert++;
            }
            if (expert >= p.e)
                return false;
            end = static_cast<uint32_t>(ends.GetValue(expert));
            groupLimit = base + (end - start + TM - 1) / TM * nt;
            loaded = true;
        }
        uint32_t local = position - base, unit = local % nt, span = nt - unit;
        if (span > TN / 256)
            span = TN / 256;
        if (span > limit - position)
            span = limit - position;
        task.expert = expert;
        task.row = start + local / nt * TM;
        task.rows = end - task.row;
        if (task.rows > TM)
            task.rows = TM;
        task.col = unit * 256;
        task.cols = span * 256;
        if (task.cols > n - task.col)
            task.cols = n - task.col;
        position += span;
        return true;
    }
};

// MERGED_CURSOR_END

template <uint32_t TM, uint32_t TN>
struct RowShareCursor {
    uint32_t n, nt, position, limit, expert, start, end, base, groupLimit;
    bool loaded, rowShare;
    uint32_t shareExpert, shareRow, shareRows, sharePosition, shareEnd;

    template <class Ends>
    __aicore__ inline void Init(const Ends &ends, const Plan &p, uint32_t columns, uint32_t core) {
        n = columns;
        nt = (n + 255) / 256;
        uint32_t previous = 0, total = 0, rowTiles = 0;
        for (uint32_t i = 0; i < p.e; i++) {
            uint32_t finish = static_cast<uint32_t>(ends.GetValue(i));
            uint32_t tiles = (finish - previous + TM - 1) / TM;
            rowTiles += tiles;
            total += tiles * nt;
            previous = finish;
        }
        position = uint64_t(total) * core / p.cores;
        limit = uint64_t(total) * (core + 1) / p.cores;
        expert = 0;
        start = 0;
        end = 0;
        base = 0;
        groupLimit = 0;
        loaded = false;
        rowShare = false;
        sharePosition = 0;
        shareEnd = 0;
        // Use whole M tiles when enough cores exist and the worst N-unit count stays bounded.
        if (rowTiles && nt && rowTiles <= p.cores) {
            const uint32_t active = total < p.cores ? total : p.cores;
            const uint32_t minShares = active / rowTiles;
            const uint32_t sharedMax = (nt + minShares - 1) / minShares;
            const uint32_t flatMax = (total + active - 1) / active;
            if (sharedMax <= flatMax) {
                rowShare = true;
                if (core >= active)
                    return;
                const uint32_t tile = (uint64_t(core + 1) * rowTiles - 1) / active;
                const uint32_t firstCore = uint64_t(tile) * active / rowTiles;
                const uint32_t lastCore = uint64_t(tile + 1) * active / rowTiles;
                const uint32_t shares = lastCore - firstCore, local = core - firstCore;
                sharePosition = uint64_t(nt) * local / shares;
                shareEnd = uint64_t(nt) * (local + 1) / shares;
                uint32_t tileBase = 0, prior = 0;
                for (uint32_t i = 0; i < p.e; i++) {
                    const uint32_t finish = static_cast<uint32_t>(ends.GetValue(i));
                    const uint32_t tiles = (finish - prior + TM - 1) / TM;
                    if (tile < tileBase + tiles) {
                        shareExpert = i;
                        shareRow = prior + (tile - tileBase) * TM;
                        shareRows = finish - shareRow;
                        if (shareRows > TM)
                            shareRows = TM;
                        return;
                    }
                    tileBase += tiles;
                    prior = finish;
                }
            }
        }
    }

    template <class Ends>
    __aicore__ inline bool Next(const Ends &ends, const Plan &p, MergedTask &task) {
        if (rowShare) {
            if (sharePosition >= shareEnd)
                return false;
            uint32_t span = shareEnd - sharePosition;
            if (span > TN / 256)
                span = TN / 256;
            task.expert = shareExpert;
            task.row = shareRow;
            task.rows = shareRows;
            task.col = sharePosition * 256;
            task.cols = span * 256;
            if (task.cols > n - task.col)
                task.cols = n - task.col;
            sharePosition += span;
            return true;
        }
        if (position >= limit)
            return false;
        while (!loaded || position >= groupLimit) {
            if (loaded) {
                start = end;
                base = groupLimit;
                expert++;
            }
            if (expert >= p.e)
                return false;
            end = static_cast<uint32_t>(ends.GetValue(expert));
            groupLimit = base + (end - start + TM - 1) / TM * nt;
            loaded = true;
        }
        uint32_t local = position - base, unit = local % nt, span = nt - unit;
        if (span > TN / 256)
            span = TN / 256;
        if (span > limit - position)
            span = limit - position;
        task.expert = expert;
        task.row = start + local / nt * TM;
        task.rows = end - task.row;
        if (task.rows > TM)
            task.rows = TM;
        task.col = unit * 256;
        task.cols = span * 256;
        if (task.cols > n - task.col)
            task.cols = n - task.col;
        position += span;
        return true;
    }
};

__aicore__ inline void
CubeNdLongRowShare(GM_ADDR x, GM_ADDR weight, GM_ADDR groups, GM_ADDR workspace, const Plan &p) {
    const uint32_t N = p.n, K = p.k;
    constexpr uint32_t CS = 128 * 256;
    TPipe pipe;
    using A = MatmulType<TPosition::GM, CubeFormat::ND, int8_t, false>;
    using B = MatmulType<TPosition::GM, CubeFormat::ND, int8_t, false>;
    using C = MatmulType<TPosition::GM, CubeFormat::ND, int32_t>;
    Matmul<A, B, C, C, STATIC_CFG<128, 768, false, 2048>> mm;
    mm.Init(static_cast<TCubeTiling *>(nullptr), &pipe);
    mm.SetOrgShape(p.m, N, K, K, N);
    GlobalTensor<int8_t> a, b;
    GlobalTensor<int64_t> ends;
    GlobalTensor<int32_t> ring;
    a.SetGlobalBuffer((__gm__ int8_t *)x);
    b.SetGlobalBuffer((__gm__ int8_t *)weight);
    ends.SetGlobalBuffer((__gm__ int64_t *)groups);
    ring.SetGlobalBuffer((__gm__ int32_t *)workspace);
    uint32_t core = GetBlockIdx(), sequence = 0;
    RowShareCursor<128, 768> cursor;
    cursor.Init(ends, p, N, core);
    MergedTask span{};
    while (cursor.Next(ends, p, span)) {
        mm.SetTail(span.rows, span.cols, K);
        mm.SetTensorA(a[uint64_t(span.row) * K], false);
        mm.SetTensorB(b[uint64_t(span.expert) * K * N + span.col], false);
        while (mm.Iterate()) {
            if (sequence >= 2)
                CrossCoreWaitFlag<2>(9);
            // Sequential mode writes one fullN256 subtile densely into the ring.
            mm.GetTensorC(ring[(core * 2 + sequence % 2) * CS], 0, true);
            CrossCoreSetFlag<2, PIPE_FIX>(8);
            ++sequence;
        }
    }
    for (uint32_t i = 0; i < (sequence < 2 ? sequence : 2); i++)
        CrossCoreWaitFlag<2>(9);
    mm.End();
}

__aicore__ inline void
GeluCounterMask(LocalTensor<float> z, LocalTensor<float> inner, uint32_t count) {
    SetMaskCount();
    SetVectorMask<float, MaskMode::COUNTER>(0, count);
    const UnaryRepeatParams up;
    const BinaryRepeatParams bp;
    Mul<float, false>(inner, z, z, MASK_PLACEHOLDER, 1, bp);
    PipeBarrier<PIPE_V>();
    Muls<float, false>(inner, inner, -0.07135481627330025f, MASK_PLACEHOLDER, 1, up);
    PipeBarrier<PIPE_V>();
    Adds<float, false>(inner, inner, -1.5957691216057308f, MASK_PLACEHOLDER, 1, up);
    PipeBarrier<PIPE_V>();
    Mul<float, false>(inner, inner, z, MASK_PLACEHOLDER, 1, bp);
    PipeBarrier<PIPE_V>();
    Exp<float, false>(inner, inner, MASK_PLACEHOLDER, 1, up);
    PipeBarrier<PIPE_V>();
    Adds<float, false>(inner, inner, 1.0f, MASK_PLACEHOLDER, 1, up);
    PipeBarrier<PIPE_V>();
    Div<float, false>(z, z, inner, MASK_PLACEHOLDER, 1, bp);
    PipeBarrier<PIPE_V>();
    SetMaskNorm();
    ResetMask();
}

__aicore__ inline void
VectorNdLongRowShare(GM_ADDR scale, GM_ADDR groups, GM_ADDR y, GM_ADDR workspace, const Plan &p) {
    constexpr uint32_t TM = 128, TN = 256;
    const uint32_t n = p.n;
    constexpr uint32_t CS = TM * TN, VS = CS > 16384 ? 16384 : CS, VR = VS / TN;
    TPipe pipe;
    TBuf<TPosition::VECCALC> rawB, innerB, halfB, scaleB, groupB;
    static_assert(2 * (VS * 4 + 256) + VS * 2 + 768 * 4 + 128 * 8 <= 192 * 1024,
                  "Long full-chunk UB budget");
    pipe.InitBuffer(rawB, VS * 4 + 256);
    pipe.InitBuffer(innerB, VS * 4 + 256);
    pipe.InitBuffer(halfB, VS * 2);
    pipe.InitBuffer(scaleB, 768 * 4);
    pipe.InitBuffer(groupB, 128 * 8);
    auto raw = rawB.Get<int32_t>();
    auto z = raw.ReinterpretCast<float>();
    auto inner = innerB.Get<float>();
    auto result = halfB.Get<half>();
    auto coeff = scaleB.Get<float>();
    auto localEnds = groupB.Get<int64_t>();
    GlobalTensor<int32_t> ring;
    GlobalTensor<float> sg;
    GlobalTensor<half> out;
    GlobalTensor<int64_t> ends;
    ring.SetGlobalBuffer((__gm__ int32_t *)workspace);
    sg.SetGlobalBuffer((__gm__ float *)scale);
    out.SetGlobalBuffer((__gm__ half *)y);
    ends.SetGlobalBuffer((__gm__ int64_t *)groups);
    DataCopyExtParams gcp{1, p.e * 8U, 0, 0, 0};
    DataCopyPadExtParams<int64_t> gp{false, 0, 0, 0};
    DataCopyPad(localEnds, ends, gcp, gp);
    Sync<HardEvent::MTE2_S>(pipe);
    // Each launch starts with no valid coefficient tile.
    uint32_t loadedExpert = ~uint32_t(0);
    uint32_t core = GetBlockIdx() / 2, sequence = 0;
    RowShareCursor<128, 768> cursor;
    cursor.Init(localEnds, p, n, core);
    MergedTask span{};
    while (cursor.Next(localEnds, p, span)) {
        for (uint32_t unit = 0; unit * TN < span.cols; unit++, sequence++) {
            uint32_t e = span.expert, row = span.row, col = span.col + unit * TN,
                     totalRows = span.rows, cols = n - col < TN ? n - col : TN;
            uint32_t aligned = (cols + 7) / 8 * 8;
            CrossCoreWaitFlag<2>(8);
            uint32_t halfRows = (totalRows + 1) / 2;
            uint32_t subStart = GetSubBlockIdx() * halfRows;
            uint32_t subEnd = subStart + halfRows < totalRows ? subStart + halfRows : totalRows;
            if (subStart >= subEnd)
                CrossCoreSetFlag<2, PIPE_MTE2>(9);
            for (uint32_t vrow = subStart; vrow < subEnd; vrow += VR) {
                uint32_t rows = subEnd - vrow < VR ? subEnd - vrow : VR;
                if (cols < TN)
                    Duplicate(raw, 0, VS);
                Sync<HardEvent::V_MTE2>(pipe);
                // GetTensorC(..., true) packs each GM row to cols; UB rows remain TN wide.
                DataCopyExtParams cp{
                    static_cast<uint16_t>(rows), cols * 4U, 0, (TN - aligned) / 8, 0};
                DataCopyPadExtParams<int32_t> pad{true, 0, static_cast<uint8_t>(aligned - cols), 0};
                DataCopyPad(raw, ring[(core * 2 + sequence % 2) * CS + vrow * cols], cp, pad);
                DataCopyExtParams scp{1, n * 4U, 0, 0, 0};
                DataCopyPadExtParams<float> sp{false, 0, 0, 0.0f};
                if (vrow == subStart && loadedExpert != e) {
                    DataCopyPad(coeff, sg[uint64_t(e) * n], scp, sp);
                    loadedExpert = e;
                }
                if (vrow + rows == subEnd)
                    CrossCoreSetFlag<2, PIPE_MTE2>(9);
                Sync<HardEvent::MTE2_V>(pipe);
                Cast(z, raw, RoundMode::CAST_NONE, rows * TN);
                PipeBarrier<PIPE_V>();
                for (uint32_t off = 0; off < cols; off += 64) {
                    Mul(z[off],
                        z[off],
                        coeff[col + off],
                        cols - off < 64 ? cols - off : 64,
                        rows,
                        {1, 1, 1, TN / 8, TN / 8, 0});
                }
                PipeBarrier<PIPE_V>();
                // Copied padding is zero, so the entire aligned tile is initialized.
                uint32_t count = rows * TN;
                // Algebraically equivalent z/(1+exp(-2*p(z))). FP32 throughout.
                GeluCounterMask(z, inner, count);
                Cast(result, z, RoundMode::CAST_RINT, rows * TN);
                Sync<HardEvent::V_MTE3>(pipe);
                uint32_t ah = (cols + 15) / 16 * 16;
                DataCopyExtParams ocp{
                    static_cast<uint16_t>(rows), cols * 2U, (TN - ah) / 16, (n - cols) * 2U, 0};
                DataCopyPad(out[uint64_t(row + vrow) * n + col], result, ocp);
                Sync<HardEvent::MTE3_V>(pipe);
            }
        }
    }
}

__aicore__ inline void
CubeWideRowsMerged(GM_ADDR x, GM_ADDR weight, GM_ADDR groups, GM_ADDR workspace, const Plan &p) {
    const uint32_t N = p.n, K = p.k;
    constexpr uint32_t CS = 64 * 512;
    TPipe pipe;
    using A = MatmulType<TPosition::GM, CubeFormat::ND, int8_t, false>;
    using B = MatmulType<TPosition::GM, CubeFormat::ND, int8_t, false>;
    using C = MatmulType<TPosition::GM, CubeFormat::ND, int32_t>;
    Matmul<A, B, C, C, STATIC_CFG<64, 1024, false, 2048>> mm;
    mm.Init(static_cast<TCubeTiling *>(nullptr), &pipe);
    mm.SetOrgShape(p.m, N, K, K, N);
    GlobalTensor<int8_t> a, b;
    GlobalTensor<int64_t> ends;
    GlobalTensor<int32_t> ring;
    a.SetGlobalBuffer((__gm__ int8_t *)x);
    b.SetGlobalBuffer((__gm__ int8_t *)weight);
    ends.SetGlobalBuffer((__gm__ int64_t *)groups);
    ring.SetGlobalBuffer((__gm__ int32_t *)workspace);
    uint32_t core = GetBlockIdx(), sequence = 0;
    RowShareCursor<64, 1024> cursor;
    cursor.Init(ends, p, N, core);
    MergedTask span{};
    while (cursor.Next(ends, p, span)) {
        mm.SetTail(span.rows, span.cols, K);
        mm.SetTensorA(a[uint64_t(span.row) * K], false);
        mm.SetTensorB(b[uint64_t(span.expert) * K * N + span.col], false);
        while (mm.Iterate()) {
            if (sequence >= 2)
                CrossCoreWaitFlag<2>(9);
            // Sequential mode writes one physical N512 subtile densely into the ring.
            mm.GetTensorC(ring[(core * 2 + sequence % 2) * CS], 0, true);
            CrossCoreSetFlag<2, PIPE_FIX>(8);
            ++sequence;
        }
    }
    for (uint32_t i = 0; i < (sequence < 2 ? sequence : 2); i++)
        CrossCoreWaitFlag<2>(9);
    mm.End();
}

__aicore__ inline void
VectorWideRowsMerged(GM_ADDR scale, GM_ADDR groups, GM_ADDR y, GM_ADDR workspace, const Plan &p) {
    constexpr uint32_t TM = 64, TN = 512;
    const uint32_t n = p.n;
    constexpr uint32_t CS = TM * TN, VS = CS > 16384 ? 16384 : CS, VR = VS / TN;
    TPipe pipe;
    TBuf<TPosition::VECCALC> rawB, innerB, halfB, scaleB, groupB;
    static_assert(2 * (VS * 4 + 256) + VS * 2 + TN * 4 + 128 * 8 <= 192 * 1024,
                  "Wide merged full-chunk UB budget");
    pipe.InitBuffer(rawB, VS * 4 + 256);
    pipe.InitBuffer(innerB, VS * 4 + 256);
    pipe.InitBuffer(halfB, VS * 2);
    pipe.InitBuffer(scaleB, TN * 4);
    pipe.InitBuffer(groupB, 128 * 8);
    auto raw = rawB.Get<int32_t>();
    auto z = raw.ReinterpretCast<float>();
    auto inner = innerB.Get<float>();
    auto result = halfB.Get<half>();
    auto coeff = scaleB.Get<float>();
    auto localEnds = groupB.Get<int64_t>();
    GlobalTensor<int32_t> ring;
    GlobalTensor<float> sg;
    GlobalTensor<half> out;
    GlobalTensor<int64_t> ends;
    ring.SetGlobalBuffer((__gm__ int32_t *)workspace);
    sg.SetGlobalBuffer((__gm__ float *)scale);
    out.SetGlobalBuffer((__gm__ half *)y);
    ends.SetGlobalBuffer((__gm__ int64_t *)groups);
    DataCopyExtParams gcp{1, p.e * 8U, 0, 0, 0};
    DataCopyPadExtParams<int64_t> gp{false, 0, 0, 0};
    DataCopyPad(localEnds, ends, gcp, gp);
    Sync<HardEvent::MTE2_S>(pipe);
    uint32_t core = GetBlockIdx() / 2, sequence = 0;
    RowShareCursor<64, 1024> cursor;
    cursor.Init(localEnds, p, n, core);
    MergedTask span{};
    while (cursor.Next(localEnds, p, span)) {
        for (uint32_t unit = 0; unit * TN < span.cols; unit++, sequence++) {
            uint32_t e = span.expert, row = span.row, col = span.col + unit * TN,
                     totalRows = span.rows,
                     cols = span.cols - unit * TN < TN ? span.cols - unit * TN : TN;
            uint32_t aligned = (cols + 7) / 8 * 8;
            CrossCoreWaitFlag<2>(8);
            uint32_t halfRows = (totalRows + 1) / 2;
            uint32_t subStart = GetSubBlockIdx() * halfRows;
            uint32_t subEnd = subStart + halfRows < totalRows ? subStart + halfRows : totalRows;
            if (subStart >= subEnd)
                CrossCoreSetFlag<2, PIPE_MTE2>(9);
            for (uint32_t vrow = subStart; vrow < subEnd; vrow += VR) {
                uint32_t rows = subEnd - vrow < VR ? subEnd - vrow : VR;
                if (cols < TN)
                    Duplicate(raw, 0, VS);
                Sync<HardEvent::V_MTE2>(pipe);
                // GetTensorC(..., true) packs each GM row to cols; UB rows remain TN wide.
                DataCopyExtParams cp{
                    static_cast<uint16_t>(rows), cols * 4U, 0, (TN - aligned) / 8, 0};
                DataCopyPadExtParams<int32_t> pad{true, 0, static_cast<uint8_t>(aligned - cols), 0};
                DataCopyPad(raw, ring[(core * 2 + sequence % 2) * CS + vrow * cols], cp, pad);
                DataCopyExtParams scp{1, cols * 4U, 0, 0, 0};
                DataCopyPadExtParams<float> sp{true, 0, static_cast<uint8_t>(aligned - cols), 0.0f};
                if (vrow == subStart)
                    DataCopyPad(coeff, sg[uint64_t(e) * n + col], scp, sp);
                if (vrow + rows == subEnd)
                    CrossCoreSetFlag<2, PIPE_MTE2>(9);
                Sync<HardEvent::MTE2_V>(pipe);
                Cast(z, raw, RoundMode::CAST_NONE, rows * TN);
                PipeBarrier<PIPE_V>();
                for (uint32_t off = 0; off < cols; off += 64) {
                    Mul(z[off],
                        z[off],
                        coeff[off],
                        cols - off < 64 ? cols - off : 64,
                        rows,
                        {1, 1, 1, TN / 8, TN / 8, 0});
                }
                PipeBarrier<PIPE_V>();
                // Copied padding is zero, so the entire aligned tile is initialized.
                uint32_t count = rows * TN;
                // Algebraically equivalent z/(1+exp(-2*p(z))). FP32 throughout.
                Mul(inner, z, z, count);
                PipeBarrier<PIPE_V>();
                Muls(inner, inner, -0.07135481627330025f, count);
                PipeBarrier<PIPE_V>();
                Adds(inner, inner, -1.5957691216057308f, count);
                PipeBarrier<PIPE_V>();
                Mul(inner, inner, z, count);
                PipeBarrier<PIPE_V>();
                Exp(inner, inner, count);
                PipeBarrier<PIPE_V>();
                Adds(inner, inner, 1.0f, count);
                PipeBarrier<PIPE_V>();
                Div(z, z, inner, count);
                PipeBarrier<PIPE_V>();
                Cast(result, z, RoundMode::CAST_RINT, rows * TN);
                Sync<HardEvent::V_MTE3>(pipe);
                uint32_t ah = (cols + 15) / 16 * 16;
                DataCopyExtParams ocp{
                    static_cast<uint16_t>(rows), cols * 2U, (TN - ah) / 16, (n - cols) * 2U, 0};
                DataCopyPad(out[uint64_t(row + vrow) * n + col], result, ocp);
                Sync<HardEvent::MTE3_V>(pipe);
            }
        }
    }
}

