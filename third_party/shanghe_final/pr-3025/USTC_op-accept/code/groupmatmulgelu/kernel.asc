                uint32_t count = rows * TN;
                // Algebraically equivalent z/(1+exp(-2*p(z))). FP32 throughout.
                Mul(inner, z, z, count);
                PipeBarrier<PIPE_V>();
                Muls(inner, inner, -0.07135481627330025f, count);
                PipeBarrier<PIPE_V>();
                Adds(inner, inner, -1.5957691216057308f, count);
                PipeBarrier<PIPE_V>();
                Mul(inner, inner, z, count);
                PipeBarrier<PIPE_V>();
                Exp(inner, inner, count);
                PipeBarrier<PIPE_V>();
                Adds(inner, inner, 1.0f, count);
                PipeBarrier<PIPE_V>();
                Div(z, z, inner, count);
                PipeBarrier<PIPE_V>();
                Cast(result, z, RoundMode::CAST_RINT, rows * TN);
                Sync<HardEvent::V_MTE3>(pipe);
                uint32_t ah = (cols + 15) / 16 * 16;
                DataCopyExtParams ocp{
                    static_cast<uint16_t>(rows), cols * 2U, (TN - ah) / 16, (n - cols) * 2U, 0};
                DataCopyPad(out[uint64_t(row + vrow) * n + col], result, ocp);
                Sync<HardEvent::MTE3_V>(pipe);
            }
        }
    }
}

// NZ_MERGED_CURSOR_BEGIN
struct NZMergedTask {
    uint32_t expert, row, rows, col, cols;
};

template <uint32_t TM, uint32_t TN>
struct NZMergedCursor {
    uint32_t n, runtimeNt, costN, position, limit, expert, start, end, base, groupLimit;
    bool loaded;

    __aicore__ inline uint32_t NUnits() const {
        if constexpr (TN > 0)
            return TN / 128;
        else
            return runtimeNt;
    }

    // A tile has a fixed operand/control cost even for a short row tail.
    // Account for a full operand tile plus the actual 16-row Cube arithmetic quantum.
    __aicore__ inline uint32_t RowWeight(uint32_t rows) {
        uint32_t value = (rows + 15) / 16 * 16;
        return TM + value;
    }

    __aicore__ inline uint32_t GroupWeight(uint32_t rows) {
        return (rows / TM * RowWeight(TM) + (rows % TM ? RowWeight(rows % TM) : 0)) * costN;
    }

    __aicore__ inline uint32_t CutUnit(uint32_t column) {
        uint32_t unit = column / 128;
        // Keep a sub-half-tile N tail with its preceding block on the same core.
        if (NUnits() > 1 && n % 128 && n % 128 < 128 / 2 && unit + 1 == NUnits())
            --unit;
        return unit;
    }

    __aicore__ inline uint32_t Locate(uint32_t cost, uint32_t rows, uint32_t taskBase) {
        uint32_t whole = rows / TM, wholeCost = whole * RowWeight(TM) * costN;
        if (cost < wholeCost) {
            uint32_t rowTile = cost / (RowWeight(TM) * costN),
                     column = (cost % (RowWeight(TM) * costN)) / RowWeight(TM);
            return taskBase + rowTile * NUnits() + CutUnit(column);
        }
        uint32_t column = (cost - wholeCost) / RowWeight(rows % TM);
        return taskBase + whole * NUnits() + CutUnit(column);
    }

    template <class Ends>
    __aicore__ inline void Init(const Ends &ends, const Plan &p, uint32_t columns, uint32_t core) {
        n = columns;
        runtimeNt = (n + 127) / 128;
        // Input int8 transfers use32-byte blocks; keep logical n unchanged for Next.
        costN = (n + 31) / 32 * 32;
        uint32_t previous = 0, total = 0, totalCost = 0;
        for (uint32_t i = 0; i < p.e; i++) {
            uint32_t finish = static_cast<uint32_t>(ends.GetValue(i)), rows = finish - previous;
            total += (rows + TM - 1) / TM * NUnits();
            totalCost += GroupWeight(rows);
            previous = finish;
        }
        uint32_t firstCost = uint64_t(totalCost) * core / p.cores;
        uint32_t lastCost = uint64_t(totalCost) * (core + 1) / p.cores;
        position = total;
        limit = total;
        expert = 0;
        start = 0;
        end = 0;
        base = 0;
        groupLimit = 0;
        loaded = false;
        uint32_t costBase = 0, taskBase = 0;
        previous = 0;
        bool firstFound = false, lastFound = false;
        for (uint32_t i = 0; i < p.e; i++) {
            uint32_t finish = static_cast<uint32_t>(ends.GetValue(i)), rows = finish - previous;
            uint32_t cost = GroupWeight(rows), tasks = (rows + TM - 1) / TM * NUnits();
            if (!firstFound && firstCost < costBase + cost) {
                position = Locate(firstCost - costBase, rows, taskBase);
                expert = i;
                start = previous;
                end = finish;
                base = taskBase;
                groupLimit = taskBase + tasks;
                loaded = true;
                firstFound = true;
            }
            if (!lastFound && lastCost < costBase + cost) {
                limit = Locate(lastCost - costBase, rows, taskBase);
                lastFound = true;
            }
            if (firstFound && (lastFound || lastCost == totalCost))
                break;
            costBase += cost;
            taskBase += tasks;
            previous = finish;
        }
    }

    template <class Ends>
    __aicore__ inline bool Next(const Ends &ends, const Plan &p, NZMergedTask &task) {
        if (position >= limit)
            return false;
        while (!loaded || position >= groupLimit) {
            if (loaded) {
                start = end;
                base = groupLimit;
                expert++;
            }
            if (expert >= p.e)
                return false;
            end = static_cast<uint32_t>(ends.GetValue(expert));
            groupLimit = base + (end - start + TM - 1) / TM * NUnits();
            loaded = true;
        }
        uint32_t local = position - base, unit = local % NUnits(), span = NUnits() - unit;
        // A bound frame has constant NUnits(); retain the core task-limit cap.
        if constexpr (TN > 0) {
            if (span > TN / 128)
                span = TN / 128;
        }
        if (span > limit - position)
            span = limit - position;
        task.expert = expert;
        task.row = start + local / NUnits() * TM;
        task.rows = end - task.row;
        if (task.rows > TM)
            task.rows = TM;
        task.col = unit * 128;
        task.cols = span * 128;
        if (task.cols > n - task.col)
            task.cols = n - task.col;
        position += span;
        return true;
    }
};

// NZ_MERGED_CURSOR_END

// NZ_CURSOR_PLAN_BEGIN
// Bounds from the declared M<=65536, E<=128, N<=4096 domain:
// ceil(M/128)+E-1 <=639 row tiles; <=20448 N128 task positions.
constexpr uint32_t NZ_CURSOR_PACKED_WORDS = 2;
constexpr uint32_t NZ_CURSOR_RECORD_WORDS = 8;

template <uint32_t FrameN, class Ends, class Prefix, class Words>
__aicore__ inline void BuildNzCursorStates(const Ends &ends,
                                           Prefix &costs,
                                           Prefix &tasks,
                                           Words &output,
                                           const Plan &p,
                                           uint32_t columns) {
    NZMergedCursor<128, FrameN> shape;
    shape.n = columns;
    shape.runtimeNt = (columns + 127) / 128;
    shape.costN = (columns + 31) / 32 * 32;
    uint32_t previous = 0, totalCost = 0, totalTasks = 0;
    costs.SetValue(0, 0);
    tasks.SetValue(0, 0);
    for (uint32_t e = 0; e < p.e; e++) {
        const uint32_t finish = static_cast<uint32_t>(ends.GetValue(e)), rows = finish - previous;
        totalCost += shape.GroupWeight(rows);
        totalTasks += (rows + 127) / 128 * shape.NUnits();
        costs.SetValue(e + 1, totalCost);
        tasks.SetValue(e + 1, totalTasks);
        previous = finish;
    }
    // Adjacent cores share a cost boundary. Locate each boundary once in
    // increasing order, walking the expert prefix only forward.
    uint32_t boundaryExpert = 0;
    uint64_t previousWord0 = 0, previousWord1 = 0;
    for (uint32_t boundary = 0; boundary <= p.cores; boundary++) {
        const uint32_t cost = uint64_t(totalCost) * boundary / p.cores;
        uint32_t position = totalTasks;
        uint64_t word0 = totalTasks, word1 = 0;
        if (cost < totalCost) {
            while (costs.GetValue(boundaryExpert + 1) <= cost)
                ++boundaryExpert;
            const uint32_t finish = static_cast<uint32_t>(ends.GetValue(boundaryExpert));
            const uint32_t begin =
                boundaryExpert ? static_cast<uint32_t>(ends.GetValue(boundaryExpert - 1)) : 0;
            const uint32_t taskBase = tasks.GetValue(boundaryExpert);
            position =
                shape.Locate(cost - costs.GetValue(boundaryExpert), finish - begin, taskBase);
            word0 = uint64_t(position) | (uint64_t(boundaryExpert) << 30) | (uint64_t(1) << 37) |
                    (uint64_t(begin) << 38);
            word1 = uint64_t(finish) | (uint64_t(taskBase) << 17) |
                    (uint64_t(tasks.GetValue(boundaryExpert + 1)) << 32);
        }
        if (boundary) {
            const uint32_t record = (boundary - 1) * NZ_CURSOR_RECORD_WORDS;
            output.SetValue(record, previousWord0 | (uint64_t(position) << 15));
            output.SetValue(record + 1, previousWord1);
            for (uint32_t i = 2; i < NZ_CURSOR_RECORD_WORDS; i++)
                output.SetValue(record + i, 0);
        }
        previousWord0 = word0;
        previousWord1 = word1;
    }
}

template <uint32_t FrameN>
__aicore__ inline void RestoreNzCursorWords(NZMergedCursor<128, FrameN> &cursor,
                                            uint64_t word0,
                                            uint64_t word1,
                                            uint32_t columns) {
    constexpr uint64_t TASK_MASK = (uint64_t(1) << 15) - 1, ROW_MASK = (uint64_t(1) << 17) - 1;
    cursor.n = columns;
    cursor.runtimeNt = (columns + 127) / 128;
    cursor.costN = (columns + 31) / 32 * 32;
    cursor.position = word0 & TASK_MASK;
    cursor.limit = (word0 >> 15) & TASK_MASK;
    cursor.expert = (word0 >> 30) & 127;
    cursor.loaded = (word0 >> 37) & 1;
    cursor.start = (word0 >> 38) & ROW_MASK;
    cursor.end = word1 & ROW_MASK;
    cursor.base = (word1 >> 17) & TASK_MASK;
    cursor.groupLimit = (word1 >> 32) & TASK_MASK;
}

// NZ_CURSOR_PLAN_END

// NZ_STAGE_SAVINGS_PLAN_BEGIN
__aicore__ inline uint32_t NzCapacityStageK(uint32_t pk);

// A core owns a contiguous interval of N128 task positions. Within one
// expert, the first touched row is its tallest remaining row; skip the rest.
template <uint32_t FrameN, class Ends>
__aicore__ inline uint32_t NzTaskRangeMaxM(const Ends &ends,
                                           const NZMergedCursor<128, FrameN> &cursor) {
    uint32_t position = cursor.position, base = cursor.base, expert = cursor.expert;
    uint32_t start = cursor.start, end = cursor.end, reserveM = 16;
    const uint32_t nt = cursor.NUnits();
    while (position < cursor.limit) {
        const uint32_t rows = end - start - (position - base) / nt * 128;
        if (rows >= 128)
            return 128;
        const uint32_t packedM = (rows + 15) / 16 * 16;
        if (packedM > reserveM)
            reserveM = packedM;
        base += (end - start + 127) / 128 * nt;
        position = base;
        if (position >= cursor.limit)
            break;
        start = end;
        end = static_cast<uint32_t>(ends.GetValue(++expert));
    }
    return reserveM;
}

__aicore__ inline uint64_t NzStageSavingsWord(uint32_t pk, uint32_t reserveM) {
    constexpr uint32_t TN = 128, STEP_K = 256, L1_BYTES = 512 * 1024;
    const uint32_t baseStage = NzCapacityStageK(pk);
    if (baseStage >= pk || reserveM >= 128)
        return 0;
    const uint32_t capacity = (L1_BYTES - 2 * reserveM * pk) / (2 * TN) / STEP_K * STEP_K;
    const uint32_t full = (pk + STEP_K - 1) / STEP_K * STEP_K;
    const uint32_t stage = full < capacity ? full : capacity;
    // A larger allocation is worthwhile here only if it removes a B stage.
    if ((pk + stage - 1) / stage >= (pk + baseStage - 1) / baseStage)
        return 0;
    return uint64_t(reserveM) | (uint64_t(stage) << 32);
}

template <uint32_t FrameN, class Ends, class Words>
__aicore__ inline void AnnotateNzStageSavings(const Ends &ends, Words &words, const Plan &p) {
    if (p.e + 1 <= NZ_CURSOR_PACKED_WORDS || NzCapacityStageK(p.k) >= p.k)
        return;
    for (uint32_t core = 0; core < p.cores; ++core) {
        NZMergedCursor<128, FrameN> cursor;
        RestoreNzCursorWords<FrameN>(cursor,
                                     words.GetValue(core * NZ_CURSOR_RECORD_WORDS),
                                     words.GetValue(core * NZ_CURSOR_RECORD_WORDS + 1),
                                     p.n);
        if (cursor.position >= cursor.limit)
            continue;
        const uint64_t plan = NzStageSavingsWord(p.k, NzTaskRangeMaxM(ends, cursor));
        if (plan)
            words.SetValue(core * NZ_CURSOR_RECORD_WORDS + 2, plan);
    }
}

// NZ_STAGE_SAVINGS_PLAN_END

// NZ_CURSOR_GPU_BEGIN
__aicore__ inline GM_ADDR NzCursorStateBase(GM_ADDR paddedWorkspace, const Plan &p) {
    const uint64_t packedBytes = uint64_t(p.m) * p.k + uint64_t(p.e) * p.k * p.wn;
    const uint64_t address = reinterpret_cast<uint64_t>(paddedWorkspace) + packedBytes;
    return reinterpret_cast<GM_ADDR>((address + 63) & ~uint64_t(63));
}

template <uint32_t FrameN>
__aicore__ inline void
PrepareNzCursorStates(GM_ADDR groups, GM_ADDR paddedWorkspace, const Plan &p) {
    TPipe pipe;
    TBuf<TPosition::VECCALC> gpBuffer, costBuffer, taskBuffer, wordBuffer;
    pipe.InitBuffer(gpBuffer, (p.e * 8 + 31) / 32 * 32);
    pipe.InitBuffer(costBuffer, ((p.e + 1) * 4 + 31) / 32 * 32);
    pipe.InitBuffer(taskBuffer, ((p.e + 1) * 4 + 31) / 32 * 32);
    pipe.InitBuffer(wordBuffer, p.cores * 64);
    auto ends = gpBuffer.Get<int64_t>();
    auto costs = costBuffer.Get<uint32_t>();
    auto tasks = taskBuffer.Get<uint32_t>();
    auto words = wordBuffer.Get<uint64_t>();
    GlobalTensor<int64_t> input;
    input.SetGlobalBuffer((__gm__ int64_t *)groups);
    DataCopyExtParams cp{1, p.e * 8, 0, 0, 0};
    DataCopyPadExtParams<int64_t> padding{false, 0, 0, 0};
    DataCopyPad(ends, input, cp, padding);
    Sync<HardEvent::MTE2_S>(pipe);
    BuildNzCursorStates<FrameN>(ends, costs, tasks, words, p, p.n);
    AnnotateNzStageSavings<FrameN>(ends, words, p);
    GlobalTensor<uint64_t> output;
    output.SetGlobalBuffer((__gm__ uint64_t *)NzCursorStateBase(paddedWorkspace, p));
    Sync<HardEvent::S_MTE3>(pipe);
    DataCopy(output, words, p.cores * NZ_CURSOR_RECORD_WORDS);
    Sync<HardEvent::MTE3_S>(pipe);
}

template <uint32_t FrameN>
__aicore__ inline void RestoreNzPreparedCursor(NZMergedCursor<128, FrameN> &cursor,
                                               GM_ADDR paddedWorkspace,
                                               const Plan &p,
                                               uint32_t core) {
    GlobalTensor<uint64_t> states;
    states.SetGlobalBuffer((__gm__ uint64_t *)NzCursorStateBase(paddedWorkspace, p));
    auto record = states[core * NZ_CURSOR_RECORD_WORDS];
    // Existing SyncAll orders publication; explicitly invalidate the Scalar cache as well.
    DataCacheCleanAndInvalid<uint64_t, CacheLine::SINGLE_CACHE_LINE, DcciDst::CACHELINE_OUT>(
        record);
    const uint64_t word0 = record.GetValue(0), word1 = record.GetValue(1);
    RestoreNzCursorWords<FrameN>(cursor, word0, word1, p.n);
}

// NZ_CURSOR_GPU_END

// NZ_RING_LAYOUT_BEGIN
template <uint32_t FrameN = 0>
__aicore__ inline uint32_t NzRingData(uint32_t core, uint32_t sequence, const Plan &p) {
    static_assert(FrameN == 0 || (FrameN % 128 == 0 && FrameN >= 128 && FrameN <= 4096),
                  "regular NZ frame");
    // A manual Fixpipe plane is 128-wide; bind the whole-row frame guard uniformly.
    constexpr uint32_t TM = 128, TN = 128, prefix = FrameN ? FrameN - TN : TN,
                       stride = TM * TN + prefix;
    return (core * 2 + sequence % 2) * stride + prefix;
}

// NZ_RING_LAYOUT_END

// NZ_LOCAL_LAYOUT_BEGIN
__aicore__ inline uint32_t NzLocalWidth(uint32_t cols) {
    return cols <= 16 ? 16 : 128;
}

__aicore__ inline uint32_t NzCalcCount(uint32_t rows, uint32_t width) {
    return (rows * width + 63) / 64 * 64;
}

// NZ_LOCAL_LAYOUT_END

// Specialize only the UB row capacity. Logical cols and both GM strides stay runtime.
// A 16-element half row is the minimum 32-byte output transfer quantum.
template <uint32_t WIDTH, uint32_t FrameN = 0, bool SPAN_SCALE = false>
__aicore__ inline void VectorNzPlaneRows(TPipe &pipe,
                                         TQue<TPosition::VECOUT, 2> &halfQ,
                                         const LocalTensor<int32_t> &raw,
                                         const LocalTensor<float> &z,
                                         const LocalTensor<float> &inner,
                                         const LocalTensor<float> &coeff,
                                         const GlobalTensor<int32_t> &ring,
                                         const GlobalTensor<float> &sg,
                                         const GlobalTensor<half> &out,
                                         const Plan &p,
                                         uint32_t core,
                                         uint32_t sequence,
                                         uint32_t e,
                                         uint32_t row,
                                         uint32_t col,
                                         uint32_t cols,
                                         uint32_t subStart,
                                         uint32_t subEnd,
                                         uint32_t scaleLoadCols = 0) {
    static_assert(WIDTH == 16 || WIDTH == 128, "regular local row capacities");
    constexpr uint32_t TN = 128, VR = 64;
    const uint32_t n = p.n, aligned = (cols + 7) / 8 * 8;
    for (uint32_t vrow = subStart; vrow < subEnd; vrow += VR) {
        uint32_t rows = subEnd - vrow < VR ? subEnd - vrow : VR;
        uint32_t count = NzCalcCount(rows, WIDTH);
        if (cols < TN)
            Duplicate(raw, 0, count);
        Sync<HardEvent::V_MTE2>(pipe);
        // Full and tail outputs both use padded128 GM rows at the data origin.
        DataCopyExtParams cp{
            static_cast<uint16_t>(rows), cols * 4U, (TN - cols) * 4U, (WIDTH - aligned) / 8, 0};
        DataCopyPadExtParams<int32_t> pad{true, 0, static_cast<uint8_t>(aligned - cols), 0};
        DataCopyPad(raw, ring[NzRingData<FrameN>(core, sequence, p) + vrow * TN], cp, pad);
        if constexpr (SPAN_SCALE) {
            // Only the first plane loads this span's exact contiguous columns.
            // Its original V_MTE2 wait retires the preceding span's readers.
            if (scaleLoadCols && vrow == subStart) {
                DataCopyExtParams scp{1, scaleLoadCols * 4U, 0, 0, 0};
                DataCopyPadExtParams<float> sp{
                    true,
                    0,
                    static_cast<uint8_t>((scaleLoadCols + 7) / 8 * 8 - scaleLoadCols),
                    0.0f};
                DataCopyPad(coeff, sg[uint64_t(e) * n + col], scp, sp);
            }
        } else {
            DataCopyExtParams scp{1, cols * 4U, 0, 0, 0};
            DataCopyPadExtParams<float> sp{true, 0, static_cast<uint8_t>(aligned - cols), 0.0f};
            if (vrow == subStart)
                DataCopyPad(coeff, sg[uint64_t(e) * n + col], scp, sp);
        }
        if (vrow + rows == subEnd)
            CrossCoreSetFlag<2, PIPE_MTE2>(9);
        Sync<HardEvent::MTE2_V>(pipe);
        Cast(z, raw, RoundMode::CAST_NONE, count);
        PipeBarrier<PIPE_V>();
        for (uint32_t off = 0; off < cols; off += 64) {
            Mul(z[off],
                z[off],
                coeff[off],
                cols - off < 64 ? cols - off : 64,
                rows,
                {1, 1, 1, static_cast<uint8_t>(WIDTH / 8), static_cast<uint8_t>(WIDTH / 8), 0});
        }
        PipeBarrier<PIPE_V>();
        // Copied padding is zero, so the entire aligned tile is initialized.
        // Algebraically equivalent z/(1+exp(-2*p(z))). FP32 throughout.
        Mul(inner, z, z, count);
        PipeBarrier<PIPE_V>();
        Muls(inner, inner, -0.07135481627330025f, count);
        PipeBarrier<PIPE_V>();
        Adds(inner, inner, -1.5957691216057308f, count);
        PipeBarrier<PIPE_V>();
        Mul(inner, inner, z, count);
        PipeBarrier<PIPE_V>();
        Exp(inner, inner, count);
        PipeBarrier<PIPE_V>();
        Adds(inner, inner, 1.0f, count);
        PipeBarrier<PIPE_V>();
        Div(z, z, inner, count);
        PipeBarrier<PIPE_V>();
        auto result = halfQ.AllocTensor<half>();
        Cast(result, z, RoundMode::CAST_RINT, count);
        halfQ.EnQue(result);
        result = halfQ.DeQue<half>();
        uint32_t ah = (cols + 15) / 16 * 16;
        DataCopyExtParams ocp{
            static_cast<uint16_t>(rows), cols * 2U, (WIDTH - ah) / 16, (n - cols) * 2U, 0};
        DataCopyPad(out[uint64_t(row + vrow) * n + col], result, ocp);
        halfQ.FreeTensor(result);
    }
}

template <uint32_t FrameN = 0>
__aicore__ inline void
VectorMergedNzA1(GM_ADDR scale, GM_ADDR groups, GM_ADDR y, GM_ADDR workspace, const Plan &p) {
    constexpr uint32_t TM = 128, TN = 128;
    const uint32_t n = p.n;
    constexpr uint32_t CS = TM * TN, VS = CS > 8192 ? 8192 : CS, VR = VS / TN;
    TPipe pipe;
    TQue<TPosition::VECOUT, 2> halfQ;
    TBuf<TPosition::VECCALC> rawB, zB, innerB, denB, numPadB, halfB, scaleB, maskB, groupB;
    pipe.InitBuffer(rawB, VS * 4 + 256);
    pipe.InitBuffer(zB, VS * 4 + 256);
    pipe.InitBuffer(innerB, VS * 4 + 256);
    pipe.InitBuffer(denB, VS * 4 + 256);
    pipe.InitBuffer(halfQ, 2, VS * 2);
    pipe.InitBuffer(numPadB, 256);
    pipe.InitBuffer(halfB, VS * 2);
    pipe.InitBuffer(scaleB, TN * 4);
    pipe.InitBuffer(maskB, VS / 8);
    pipe.InitBuffer(groupB, 128 * 8);
    auto raw = rawB.Get<int32_t>();
    auto z = zB.Get<float>();
    auto inner = innerB.Get<float>();
    // Reserved regions preserve all arithmetic/coeff/group offsets.
    auto coeff = scaleB.Get<float>();
    auto mask = maskB.Get<uint8_t>();
    auto localEnds = groupB.Get<int64_t>();
    GlobalTensor<int32_t> ring;
    GlobalTensor<float> sg;
    GlobalTensor<half> out;
    GlobalTensor<int64_t> ends;
    ring.SetGlobalBuffer((__gm__ int32_t *)workspace);
    sg.SetGlobalBuffer((__gm__ float *)scale);
    out.SetGlobalBuffer((__gm__ half *)y);
    ends.SetGlobalBuffer((__gm__ int64_t *)groups);
    DataCopyExtParams gcp{1, p.e * 8U, 0, 0, 0};
    DataCopyPadExtParams<int64_t> gp{false, 0, 0, 0};
    DataCopyPad(localEnds, ends, gcp, gp);
    Sync<HardEvent::MTE2_S>(pipe);
    uint32_t core = GetBlockIdx() / 2, sequence = 0;
    NZMergedCursor<128, FrameN> cursor;
    cursor.Init(localEnds, p, n, core);
    NZMergedTask span{};
    while (cursor.Next(localEnds, p, span)) {
        for (uint32_t unit = 0; unit * TN < span.cols; unit++, sequence++) {
            uint32_t e = span.expert, row = span.row, col = span.col + unit * TN,
                     totalRows = span.rows, cols = n - col < TN ? n - col : TN;
            CrossCoreWaitFlag<2>(8);
            uint32_t halfRows = (totalRows + 1) / 2;
            uint32_t subStart = GetSubBlockIdx() * halfRows;
            uint32_t subEnd = subStart + halfRows < totalRows ? subStart + halfRows : totalRows;
            if (subStart >= subEnd)
                CrossCoreSetFlag<2, PIPE_MTE2>(9);
            if (NzLocalWidth(cols) == 16)
                VectorNzPlaneRows<16, FrameN>(pipe,
                                              halfQ,
                                              raw,
                                              z,
                                              inner,
                                              coeff,
                                              ring,
                                              sg,
                                              out,
                                              p,
                                              core,
                                              sequence,
                                              e,
                                              row,
                                              col,
                                              cols,
                                              subStart,
                                              subEnd);
            else
                VectorNzPlaneRows<128, FrameN>(pipe,
                                               halfQ,
                                               raw,
                                               z,
                                               inner,
                                               coeff,
                                               ring,
                                               sg,
                                               out,
                                               p,
                                               core,
                                               sequence,
                                               e,
                                               row,
                                               col,
                                               cols,
                                               subStart,
                                               subEnd);
        }
    }
    Sync<HardEvent::MTE3_V>(pipe);
}

// NZ_VECTOR_PREPARED_BEGIN
template <uint32_t FrameN = 0>
__aicore__ inline void VectorMergedNzPrepared(GM_ADDR scale,
                                              GM_ADDR groups,
                                              GM_ADDR y,
                                              GM_ADDR workspace,
                                              GM_ADDR paddedWorkspace,
                                              const Plan &p) {
    static_assert(FrameN >= 128 && FrameN <= 4096 && FrameN % 128 == 0, "prepared vector frame");
    constexpr uint32_t TM = 128, TN = 128;
    const uint32_t n = p.n;
    constexpr uint32_t CS = TM * TN, VS = CS > 8192 ? 8192 : CS, VR = VS / TN;
    TPipe pipe;
    TQue<TPosition::VECOUT, 2> halfQ;
    TBuf<TPosition::VECCALC> rawB, zB, innerB, denB, numPadB, halfB, scaleB, maskB, groupB;
    pipe.InitBuffer(rawB, VS * 4 + 256);
    pipe.InitBuffer(zB, VS * 4 + 256);
    pipe.InitBuffer(innerB, VS * 4 + 256);
    pipe.InitBuffer(denB, VS * 4 + 256);
    pipe.InitBuffer(halfQ, 2, VS * 2);
    pipe.InitBuffer(numPadB, 256);
    pipe.InitBuffer(halfB, VS * 2);
    pipe.InitBuffer(scaleB, TN * 4);
    pipe.InitBuffer(maskB, VS / 8);
    pipe.InitBuffer(groupB, 128 * 8);
    static_assert(FrameN * 4 <= VS * 4 + 256, "span scale fits reserved den storage");
    auto spanScale = denB.Get<float>();
    auto raw = rawB.Get<int32_t>();
    auto z = zB.Get<float>();
    auto inner = innerB.Get<float>();
    // Reserved regions preserve all arithmetic/coeff/group offsets.
    auto coeff = scaleB.Get<float>();
    auto mask = maskB.Get<uint8_t>();
    auto localEnds = groupB.Get<int64_t>();
    GlobalTensor<int32_t> ring;
    GlobalTensor<float> sg;
    GlobalTensor<half> out;
    GlobalTensor<int64_t> ends;
    ring.SetGlobalBuffer((__gm__ int32_t *)workspace);
    sg.SetGlobalBuffer((__gm__ float *)scale);
    out.SetGlobalBuffer((__gm__ half *)y);
    ends.SetGlobalBuffer((__gm__ int64_t *)groups);
    DataCopyExtParams gcp{1, p.e * 8U, 0, 0, 0};
    DataCopyPadExtParams<int64_t> gp{false, 0, 0, 0};
    uint32_t core = GetBlockIdx() / 2, sequence = 0;
    auto cursorWords = numPadB.Get<uint64_t>();
    DataCopyPad(localEnds, ends, gcp, gp);
    if (p.e + 1 > NZ_CURSOR_PACKED_WORDS) {
        GlobalTensor<uint64_t> states;
        states.SetGlobalBuffer((__gm__ uint64_t *)NzCursorStateBase(paddedWorkspace, p));
        DataCopy(cursorWords, states[core * NZ_CURSOR_RECORD_WORDS], 4);
    }
    Sync<HardEvent::MTE2_S>(pipe);
    NZMergedCursor<128, FrameN> cursor;
    if (p.e + 1 > NZ_CURSOR_PACKED_WORDS)
        RestoreNzCursorWords<FrameN>(cursor, cursorWords.GetValue(0), cursorWords.GetValue(1), n);
    else
        cursor.Init(localEnds, p, n, core);
    NZMergedTask span{};
    while (cursor.Next(localEnds, p, span)) {
        for (uint32_t unit = 0; unit * TN < span.cols; unit++, sequence++) {
            uint32_t e = span.expert, row = span.row, col = span.col + unit * TN,
                     totalRows = span.rows, cols = n - col < TN ? n - col : TN;
            CrossCoreWaitFlag<2>(8);
            uint32_t halfRows = (totalRows + 1) / 2;
            uint32_t subStart = GetSubBlockIdx() * halfRows;
            uint32_t subEnd = subStart + halfRows < totalRows ? subStart + halfRows : totalRows;
            if (subStart >= subEnd)
                CrossCoreSetFlag<2, PIPE_MTE2>(9);
            if (NzLocalWidth(cols) == 16)
                VectorNzPlaneRows<16, FrameN, true>(pipe,
                                                    halfQ,
                                                    raw,
                                                    z,
                                                    inner,
                                                    spanScale[unit * TN],
                                                    ring,
                                                    sg,
                                                    out,
                                                    p,
                                                    core,
                                                    sequence,
                                                    e,
                                                    row,
                                                    col,
                                                    cols,
                                                    subStart,
                                                    subEnd,
                                                    unit == 0 ? span.cols : 0);
            else
                VectorNzPlaneRows<128, FrameN, true>(pipe,
                                                     halfQ,
                                                     raw,
                                                     z,
                                                     inner,
                                                     spanScale[unit * TN],
                                                     ring,
                                                     sg,
                                                     out,
                                                     p,
                                                     core,
                                                     sequence,
                                                     e,
                                                     row,
                                                     col,
                                                     cols,
                                                     subStart,
                                                     subEnd,
                                                     unit == 0 ? span.cols : 0);
        }
    }
    Sync<HardEvent::MTE3_V>(pipe);
}

// NZ_VECTOR_PREPARED_END

struct PadJob {
    uint32_t expert, row, rows, real, stride, cols;
    bool isX;
};

__aicore__ inline PadJob GetPadJob(uint32_t task,
                                   uint32_t xt,
                                   uint32_t wt,
                                   uint32_t xc,
                                   uint32_t wc,
                                   uint32_t m,
                                   uint32_t k,
                                   uint32_t n,
                                   uint32_t pk,
                                   uint32_t pn) {
    PadJob t{};
    t.isX = task < xt;
    t.expert = t.isX ? 0 : (task - xt) / wt;
    t.row = t.isX ? task * xc : (task - xt) % wt * wc;
    t.stride = t.isX ? pk : pn;
    t.cols = t.isX ? k : n;
    uint32_t sourceRows = t.isX ? m : k, targetRows = t.isX ? m : pk, chunk = t.isX ? xc : wc;
    t.rows = targetRows - t.row;
    if (t.rows > chunk)
        t.rows = chunk;
    t.real = sourceRows > t.row ? sourceRows - t.row : 0;
    if (t.real > t.rows)
        t.real = t.rows;
    return t;
}

__aicore__ inline void PadPrefetch(TQue<TPosition::VECIN, 2> &queue,
                                   TPipe &pipe,
                                   const GlobalTensor<int8_t> &xg,
                                   const GlobalTensor<int8_t> &wg,
                                   const PadJob &t,
                                   uint32_t k,
                                   uint32_t n) {
    auto raw = queue.AllocTensor<int8_t>();
    if (t.real < t.rows) {
        Duplicate(raw.ReinterpretCast<int32_t>(), 0, t.rows * t.stride / 4);
        Sync<HardEvent::V_MTE2>(pipe);
    }
    if (t.real) {
        DataCopyExtParams cp{static_cast<uint16_t>(t.real), t.cols, 0, 0, 0};
        DataCopyPadExtParams<int8_t> pad{true, 0, static_cast<uint8_t>(t.stride - t.cols), 0};
        if (t.isX)
            DataCopyPad(raw, xg[uint64_t(t.row) * k], cp, pad);
        else
            DataCopyPad(raw, wg[uint64_t(t.expert) * k * n + uint64_t(t.row) * n], cp, pad);
    }
    queue.EnQue(raw);
}

__aicore__ inline void PadInputsCoreSerial(GM_ADDR x,
                                           GM_ADDR w,
                                           GM_ADDR xp,
                                           GM_ADDR wp,
                                           uint32_t m,
                                           uint32_t k,
                                           uint32_t n,
                                           uint32_t e,
                                           uint32_t pk,
                                           uint32_t pn,
                                           uint32_t rawA) {
    constexpr uint32_t BYTES = 65536;
    TPipe pipe;
    TQue<TPosition::VECIN, 2> rawQ;
    TBuf<TPosition::VECCALC> packedB;
    pipe.InitBuffer(rawQ, 2, BYTES);
    pipe.InitBuffer(packedB, BYTES);
    auto packed = packedB.Get<int32_t>();
    GlobalTensor<int8_t> xg, wg, xo, wo;
    xg.SetGlobalBuffer((__gm__ int8_t *)x);
    wg.SetGlobalBuffer((__gm__ int8_t *)w);
    xo.SetGlobalBuffer((__gm__ int8_t *)xp);
    wo.SetGlobalBuffer((__gm__ int8_t *)wp);
    uint32_t xc = BYTES / pk;
    if (xc > 512)
        xc = 512;
    uint32_t wc = BYTES / pn;
    if (wc > 512)
        wc = 512;
    wc = wc / 16 * 16;
    uint32_t xt = rawA ? 0 : (m + xc - 1) / xc, wt = (pk + wc - 1) / wc, total = xt + e * wt;
    // MIX_AIC_1_2 has two AIV logical indices per configured AIC block.
    uint32_t task = GetBlockIdx(), step = GetBlockNum() * GetTaskRatio();
    if (task >= total)
        return;
    PadPrefetch(rawQ, pipe, xg, wg, GetPadJob(task, xt, wt, xc, wc, m, k, n, pk, pn), k, n);
    bool packedPending = false;
    for (; task < total; task += step) {
        if (task + step < total)
            PadPrefetch(
                rawQ, pipe, xg, wg, GetPadJob(task + step, xt, wt, xc, wc, m, k, n, pk, pn), k, n);
        PadJob t = GetPadJob(task, xt, wt, xc, wc, m, k, n, pk, pn);
        auto raw = rawQ.DeQue<int8_t>();
        if (t.isX) {
            Sync<HardEvent::V_MTE3>(pipe);
            DataCopy(xo[uint64_t(t.row) * pk], raw, t.rows * t.stride);
            // This copy still reads raw; wait before its VECIN slot is freed.
            Sync<HardEvent::MTE3_V>(pipe);
            rawQ.FreeTensor(raw);
        } else {
            if (packedPending)
                Sync<HardEvent::MTE3_V>(pipe);
            auto words = raw.ReinterpretCast<int32_t>();
            for (uint32_t col = 0; col < pn; col += 32) {
                uint32_t dst = col / 32 * t.rows * 8;
                CopyRepeatParams rp{
                    1, static_cast<uint16_t>(pn / 32), 8, static_cast<uint16_t>(pn / 4)};
                if (t.rows >= 8)
                    Copy(packed[dst], words[col / 4], 64, t.rows / 8, rp);
                if (t.rows % 8)
                    Copy(packed[dst + t.rows / 8 * 64],
                         words[col / 4 + t.rows / 8 * 8 * (pn / 4)],
                         t.rows % 8 * 8,
                         1,
                         rp);
            }
            rawQ.FreeTensor(raw);
            Sync<HardEvent::V_MTE3>(pipe);
            DataCopyParams cp{static_cast<uint16_t>(pn / 32),
                              static_cast<uint16_t>(t.rows),
                              0,
                              static_cast<uint16_t>(pk - t.rows)};
            DataCopy(
                wo[uint64_t(t.expert) * pk * pn + uint64_t(t.row) * 32], packedB.Get<int8_t>(), cp);
            packedPending = true;
        }
    }
    if (packedPending)
        Sync<HardEvent::MTE3_V>(pipe);
}

template <uint32_t BYTES>
__aicore__ inline void PadInputsPipeline(GM_ADDR x,
                                         GM_ADDR w,
                                         GM_ADDR xp,
                                         GM_ADDR wp,
                                         uint32_t m,
                                         uint32_t k,
                                         uint32_t n,
                                         uint32_t e,
                                         uint32_t pk,
                                         uint32_t pn,
                                         uint32_t rawA) {
    TPipe pipe;
    TQue<TPosition::VECIN, 2> rawQ;
    TQue<TPosition::VECOUT, 2> packedQ;
    pipe.InitBuffer(rawQ, 2, BYTES);
    pipe.InitBuffer(packedQ, 2, BYTES);
    GlobalTensor<int8_t> xg, wg, xo, wo;
    xg.SetGlobalBuffer((__gm__ int8_t *)x);
    wg.SetGlobalBuffer((__gm__ int8_t *)w);
    xo.SetGlobalBuffer((__gm__ int8_t *)xp);
    wo.SetGlobalBuffer((__gm__ int8_t *)wp);
    uint32_t xc = BYTES / pk;
    if (xc > 512)
        xc = 512;
    uint32_t wc = BYTES / pn;
    if (wc > 512)
        wc = 512;
    wc = wc / 8 * 8;
    uint32_t xt = rawA ? 0 : (m + xc - 1) / xc, wt = (pk + wc - 1) / wc, total = xt + e * wt;
    // MIX_AIC_1_2 has two AIV logical indices per configured AIC block.
    uint32_t task = GetBlockIdx(), step = GetBlockNum() * GetTaskRatio();
    if (task >= total)
        return;
    PadPrefetch(rawQ, pipe, xg, wg, GetPadJob(task, xt, wt, xc, wc, m, k, n, pk, pn), k, n);
    for (; task < total; task += step) {
        if (task + step < total)
            PadPrefetch(
                rawQ, pipe, xg, wg, GetPadJob(task + step, xt, wt, xc, wc, m, k, n, pk, pn), k, n);
        PadJob t = GetPadJob(task, xt, wt, xc, wc, m, k, n, pk, pn);
        auto raw = rawQ.DeQue<int8_t>();
        if (t.isX) {
            Sync<HardEvent::V_MTE3>(pipe);
            DataCopy(xo[uint64_t(t.row) * pk], raw, t.rows * t.stride);
            // This copy still reads raw; wait before its VECIN slot is freed.
            Sync<HardEvent::MTE3_V>(pipe);
            rawQ.FreeTensor(raw);
        } else {
            auto packedTensor = packedQ.AllocTensor<int8_t>();
            auto packed = packedTensor.ReinterpretCast<int32_t>();
            auto words = raw.ReinterpretCast<int32_t>();
            for (uint32_t col = 0; col < pn; col += 32) {
                uint32_t dst = col / 32 * t.rows * 8;
                CopyRepeatParams rp{
                    1, static_cast<uint16_t>(pn / 32), 8, static_cast<uint16_t>(pn / 4)};
                if (t.rows >= 8)
                    Copy(packed[dst], words[col / 4], 64, t.rows / 8, rp);
                if (t.rows % 8)
                    Copy(packed[dst + t.rows / 8 * 64],
                         words[col / 4 + t.rows / 8 * 8 * (pn / 4)],
                         t.rows % 8 * 8,
                         1,
                         rp);
            }
            rawQ.FreeTensor(raw);
            packedQ.EnQue(packedTensor);
            packedTensor = packedQ.DeQue<int8_t>();
            DataCopyParams cp{static_cast<uint16_t>(pn / 32),
                              static_cast<uint16_t>(t.rows),
                              0,
                              static_cast<uint16_t>(pk - t.rows)};
            DataCopy(wo[uint64_t(t.expert) * pk * pn + uint64_t(t.row) * 32], packedTensor, cp);
            packedQ.FreeTensor(packedTensor);
        }
    }
    Sync<HardEvent::MTE3_V>(pipe);
}

__aicore__ inline void PadInputsCore(GM_ADDR x,
                                     GM_ADDR w,
                                     GM_ADDR xp,
                                     GM_ADDR wp,
                                     uint32_t m,
                                     uint32_t k,
                                     uint32_t n,
                                     uint32_t e,
                                     uint32_t pk,
                                     uint32_t pn,
                                     uint32_t rawA) {
    // Two input and two output stages share the existing 192-KiB preprocessing UB budget.
    // A packed weight chunk needs at least one 8-row Copy repeat; wider rows retain the old path.
    constexpr uint32_t STAGE_BYTES = (192 * 1024) / 4;
    constexpr uint32_t COPY_ROWS = 8, C0_BYTES = 32, MIN_STORE_BURST = 2048;
    const uint32_t outputRows = (STAGE_BYTES / pn) / COPY_ROWS * COPY_ROWS;
    if (outputRows * C0_BYTES >= MIN_STORE_BURST)
        PadInputsPipeline<STAGE_BYTES>(x, w, xp, wp, m, k, n, e, pk, pn, rawA);
    else
        PadInputsCoreSerial(x, w, xp, wp, m, k, n, e, pk, pn, rawA);
}

template <typename Q>
__aicore__ inline void
PrefetchNzA(Q &aq, const NZMergedTask &span, const GlobalTensor<int8_t> &a, const Plan &p) {
    auto al = aq.template AllocTensor<int8_t>();
    Nd2NzParams cp;
    cp.ndNum = 1;
    cp.nValue = span.rows;
    cp.dValue = p.ka;
    cp.srcDValue = p.ka;
    cp.dstNzC0Stride = NzPackedRows(span.rows);
    cp.dstNzNStride = 1;
    cp.srcNdMatrixStride = 0;
    cp.dstNzMatrixStride = 0;
    DataCopy(al, a[uint64_t(span.row) * p.ka], cp);
    aq.EnQue(al);
}

template <uint32_t StageK, typename Q>
__aicore__ inline void PrefetchStagedNzB(Q &bq,
                                         const GlobalTensor<int8_t> &b,
                                         const NZMergedTask &span,
                                         uint32_t unit,
                                         uint32_t k0,
                                         const Plan &p) {
    constexpr uint32_t TN = 128;
    const uint32_t col = span.col + unit * TN;
    const uint32_t cols = span.cols - unit * TN < TN ? span.cols - unit * TN : TN;
    const uint32_t paddedCols = (cols + 31) / 32 * 32;
    const uint32_t sliceK = p.k - k0 < StageK ? p.k - k0 : StageK;
    auto bl = bq.template AllocTensor<int8_t>();
    // Copy a few long NZ bursts. The B1 N-block pitch becomes sliceK.
    DataCopyParams cp{static_cast<uint16_t>(paddedCols / 32),
                      static_cast<uint16_t>(sliceK),
                      static_cast<uint16_t>(p.k - sliceK),
                      0};
    DataCopy(
        bl, b[uint64_t(span.expert) * p.k * p.wn + uint64_t(col) * p.k + uint64_t(k0) * 32], cp);
    bq.EnQue(bl);
}

// This adapter is used only where every existing queue has two FIFO slots.
template <TPosition Pos, HardEvent Ready, HardEvent Retire, uint32_t ReadyBase, uint32_t RetireBase>
struct NzStaticQueue {
    uint32_t base, bytes, produced, consumed;

    __aicore__ inline void Init(uint32_t address, uint32_t size) {
        base = address;
        bytes = size;
        produced = 0;
        consumed = 0;
    }

    template <typename T>
    __aicore__ inline LocalTensor<T> AllocTensor() {
        const uint32_t slot = produced & 1;
        if (produced >= 2)
            WaitFlag<Retire>(RetireBase + slot);
        ++produced;
        return LocalTensor<T>(Pos, base + slot * bytes, bytes / sizeof(T));
    }

    template <typename T>
    __aicore__ inline void EnQue(const LocalTensor<T> &tensor) {
        SetFlag<Ready>(ReadyBase + ((produced - 1) & 1));
    }

    template <typename T>
    __aicore__ inline LocalTensor<T> DeQue() {
        const uint32_t slot = consumed++ & 1;
        WaitFlag<Ready>(ReadyBase + slot);
        return LocalTensor<T>(Pos, base + slot * bytes, bytes / sizeof(T));
    }

    template <typename T>
    __aicore__ inline void FreeTensor(const LocalTensor<T> &tensor) {
        SetFlag<Retire>(RetireBase + ((consumed - 1) & 1));
    }

    __aicore__ inline void Drain() {
        for (uint32_t slot = 0; slot < 2 && slot < consumed; ++slot)
            WaitFlag<Retire>(RetireBase + slot);
    }
};

__aicore__ inline uint32_t NzCapacityStageK(uint32_t pk) {
    constexpr uint32_t TM = 128, TN = 128, STEP_K = 256, L1_BYTES = 512 * 1024;
    const uint32_t capacity = (L1_BYTES - 2 * TM * pk) / (2 * TN) / STEP_K * STEP_K;
    const uint32_t full = (pk + STEP_K - 1) / STEP_K * STEP_K;
    return full < capacity ? full : capacity;
}

template <typename Q>
__aicore__ inline void PrefetchCapacityNzB(Q &bq,
                                           const GlobalTensor<int8_t> &b,
                                           const NZMergedTask &span,
                                           uint32_t unit,
                                           uint32_t k0,
                                           const Plan &p,
                                           uint32_t stageK) {
    constexpr uint32_t TN = 128;
    const uint32_t col = span.col + unit * TN;
    const uint32_t cols = span.cols - unit * TN < TN ? span.cols - unit * TN : TN;
    const uint32_t paddedCols = (cols + 31) / 32 * 32;
    const uint32_t sliceK = p.k - k0 < stageK ? p.k - k0 : stageK;
    auto bl = bq.template AllocTensor<int8_t>();
    // Copy a few long NZ bursts. The B1 N-block pitch becomes sliceK.
    DataCopyParams cp{static_cast<uint16_t>(paddedCols / 32),
                      static_cast<uint16_t>(sliceK),
                      static_cast<uint16_t>(p.k - sliceK),
                      0};
    DataCopy(
        bl, b[uint64_t(span.expert) * p.k * p.wn + uint64_t(col) * p.k + uint64_t(k0) * 32], cp);
    bq.EnQue(bl);
}

template <uint32_t FrameN = 0>
__aicore__ inline void
CubeMergedNzStatic(GM_ADDR x, GM_ADDR weight, GM_ADDR groups, GM_ADDR workspace, const Plan &p) {
    constexpr uint32_t TM = 128, TN = 128, CS = TM * TN, BASE_STAGE_K = 512, STEP_K = 256;
    // Admit one regular full-A capacity class from the physical L1 budget.
    // Reserve actual TM*p.k slots; ND2NZ/LoadData extents remain p.ka/p.k.
    constexpr uint32_t L1_BYTES = 512 * 1024;
    constexpr uint32_t A_CAPACITY_K = (L1_BYTES - 2 * TN * BASE_STAGE_K) / (2 * TM);
    static_assert(2 * TM * A_CAPACITY_K + 2 * TN * BASE_STAGE_K == L1_BYTES,
                  "full A/B slots fit L1 exactly");
    static_assert(A_CAPACITY_K % 32 == 0, "int8 K32 capacity alignment");
    static_assert(2 * TM * STEP_K <= 64 * 1024 && 2 * TN * STEP_K <= 64 * 1024,
                  "double L0 input budget");
    static_assert(2 * CS * 4 <= 128 * 1024, "double CO1 budget");
    const uint32_t STAGE_K = NzCapacityStageK(p.k);
    InitSocState();
    NzStaticQueue<TPosition::A1, HardEvent::MTE2_MTE1, HardEvent::MTE1_MTE2, 0, 0> aq;
    NzStaticQueue<TPosition::B1, HardEvent::MTE2_MTE1, HardEvent::MTE1_MTE2, 2, 2> bq;
    NzStaticQueue<TPosition::A2, HardEvent::MTE1_M, HardEvent::M_MTE1, 0, 3> a2q;
    NzStaticQueue<TPosition::B2, HardEvent::MTE1_M, HardEvent::M_MTE1, 2, 5> b2q;
    NzStaticQueue<TPosition::CO1, HardEvent::M_FIX, HardEvent::FIX_M, 0, 0> cq;
    aq.Init(0, TM * p.k);
    bq.Init(2 * TM * p.k, TN * STAGE_K);
    a2q.Init(0, TM * STEP_K);
    b2q.Init(0, TN * STEP_K);
    cq.Init(0, CS * 4);
    GlobalTensor<int8_t> a, b;
    GlobalTensor<int64_t> ends;
    GlobalTensor<int32_t> ring;
    a.SetGlobalBuffer((__gm__ int8_t *)x);
    b.SetGlobalBuffer((__gm__ int8_t *)weight);
    ends.SetGlobalBuffer((__gm__ int64_t *)groups);
    ring.SetGlobalBuffer((__gm__ int32_t *)workspace);
    const uint32_t core = GetBlockIdx();
    uint32_t sequence = 0;
    NZMergedCursor<TM, FrameN> cursor;
    cursor.Init(ends, p, p.n, core);
    NZMergedTask span{}, next{};
    bool available = cursor.Next(ends, p, span);
    if (available) {
        PrefetchNzA(aq, span, a, p);
        PrefetchCapacityNzB(bq, b, span, 0, 0, p, STAGE_K);
    }
    while (available) {
        auto al = aq.DeQue<int8_t>();
        const bool more = cursor.Next(ends, p, next);
        const uint32_t packedM = NzPackedRows(span.rows), planes = (span.cols + TN - 1) / TN;
        for (uint32_t unit = 0; unit < planes; unit++) {
            auto c = cq.AllocTensor<int32_t>();
            const uint32_t cols = span.cols - unit * TN < TN ? span.cols - unit * TN : TN;
            const uint32_t paddedCols = cols <= 16 ? 16 : (cols + 31) / 32 * 32;
            for (uint32_t stage0 = 0; stage0 < p.k; stage0 += STAGE_K) {
                const uint32_t sliceK = p.k - stage0 < STAGE_K ? p.k - stage0 : STAGE_K;
                auto bl = bq.DeQue<int8_t>();
                // Keep the next B slice queued, including across plane/span boundaries.
                if (stage0 + sliceK < p.k)
                    PrefetchCapacityNzB(bq, b, span, unit, stage0 + sliceK, p, STAGE_K);
                else if (unit + 1 < planes)
                    PrefetchCapacityNzB(bq, b, span, unit + 1, 0, p, STAGE_K);
                else if (more)
                    PrefetchCapacityNzB(bq, b, next, 0, 0, p, STAGE_K);
                // Wait until this first plane's B slices are queued before next-row A.
                if (unit == 0 && stage0 + sliceK == p.k && more)
                    PrefetchNzA(aq, next, a, p);
                for (uint32_t localK = 0; localK < sliceK; localK += STEP_K) {
                    const uint32_t innerK = sliceK - localK < STEP_K ? sliceK - localK : STEP_K;
                    const uint32_t globalK = stage0 + localK;
                    auto a2 = a2q.AllocTensor<int8_t>();
                    auto b2 = b2q.AllocTensor<int8_t>();
                    LoadData2DParams la{};
                    la.ifTranspose = false;
                    if (innerK / 32 < packedM / 16) {
                        la.repeatTimes = packedM / 16;
                        la.srcStride = 1;
                        la.dstGap = innerK / 32 - 1;
                        for (uint32_t kb = 0; kb < innerK / 32; kb++)
                            LoadData(a2[kb * 512], al[(globalK + kb * 32) * packedM], la);
                    } else {
                        la.repeatTimes = innerK / 32;
                        la.srcStride = packedM / 16;
                        for (uint32_t mb = 0; mb < packedM / 16; mb++)
                            LoadData(a2[mb * innerK * 16], al[globalK * packedM + mb * 512], la);
                    }
                    LoadData2dTransposeParams lb{};
                    lb.dstFracGap = 0;
                    if (paddedCols == 16) {
                        // Keep the first N16 fractals contiguous; unused N16 halves follow.
                        lb.repeatTimes = innerK / 32;
                        lb.srcStride = 1;
                        lb.dstGap = 0;
                        lb.dstFracGap = innerK / 32 - 1;
                        LoadDataWithTranspose(b2, bl[localK * 32], lb);
                    } else if (innerK > paddedCols) {
                        lb.repeatTimes = innerK / 32;
                        lb.srcStride = 1;
                        lb.dstGap = paddedCols / 16 - 1;
                        for (uint32_t nb = 0; nb < paddedCols / 32; nb++)
                            LoadDataWithTranspose(
                                b2[nb * 1024], bl[localK * 32 + nb * sliceK * 32], lb);
                    } else {
                        lb.repeatTimes = paddedCols / 32;
                        lb.srcStride = sliceK / 32;
                        lb.dstGap = 1;
                        for (uint32_t kb = 0; kb < innerK / 32; kb++)
                            LoadDataWithTranspose(
                                b2[kb * (paddedCols / 32 * 1024)], bl[(localK + kb * 32) * 32], lb);
                    }
                    a2q.EnQue(a2);
                    b2q.EnQue(b2);
                    a2 = a2q.DeQue<int8_t>();
                    b2 = b2q.DeQue<int8_t>();
                    MmadParams mp{};
                    mp.m = packedM;
                    mp.n = paddedCols;
                    mp.k = innerK;
                    mp.cmatrixInitVal = globalK == 0;
                    Mmad(c, a2, b2, mp);
                    // Match the installed Matmul primitive's small-MN pipeline requirement.
                    if ((packedM / 16) * (paddedCols / 16) < 10)
                        PipeBarrier<PIPE_M>();
                    a2q.FreeTensor(a2);
                    b2q.FreeTensor(b2);
                }
                // Free carries MTE1->MTE2 after both L0 chunks have loaded.
                bq.FreeTensor(bl);
            }
            cq.EnQue(c);
            c = cq.DeQue<int32_t>();
            if (sequence >= 2)
                CrossCoreWaitFlag<2>(9);
            FixpipeParamsV220 fp{};
            fp.nSize = paddedCols;
            fp.mSize = span.rows;
            fp.srcStride = packedM;
            fp.dstStride = TN;
            fp.ndNum = 1;
            Fixpipe(ring[NzRingData<FrameN>(core, sequence, p)], c, fp);
            CrossCoreSetFlag<2, PIPE_FIX>(8);
            ++sequence;
            cq.FreeTensor(c);
        }
        aq.FreeTensor(al);
        if (more)
            span = next;
        available = more;
    }
    for (uint32_t i = 0; i < (sequence < 2 ? sequence : 2); i++)
        CrossCoreWaitFlag<2>(9);
    aq.Drain();
    bq.Drain();
    a2q.Drain();
    b2q.Drain();
    cq.Drain();
    PipeBarrier<PIPE_ALL>();
}

// NZ_FULL_A_FIRST_LOAD_BEGIN
__aicore__ inline void LoadNzFullA2Tile(const LocalTensor<int8_t> &a2,
                                        const LocalTensor<int8_t> &al,
                                        uint32_t packedM,
                                        uint32_t globalK,
                                        uint32_t innerK) {
    LoadData2DParams la{};
    la.ifTranspose = false;
    if (innerK / 32 < packedM / 16) {
        la.repeatTimes = packedM / 16;
        la.srcStride = 1;
        la.dstGap = innerK / 32 - 1;
        for (uint32_t kb = 0; kb < innerK / 32; kb++)
            LoadData(a2[kb * 512], al[(globalK + kb * 32) * packedM], la);
    } else {
        la.repeatTimes = innerK / 32;
        la.srcStride = packedM / 16;
        for (uint32_t mb = 0; mb < packedM / 16; mb++)
            LoadData(a2[mb * innerK * 16], al[globalK * packedM + mb * 512], la);
    }
}

// NZ_FULL_A_FIRST_LOAD_END

template <uint32_t FrameN = 0>
__aicore__ inline void CubeMergedNzPrepared(GM_ADDR x,
                                            GM_ADDR weight,
                                            GM_ADDR groups,
                                            GM_ADDR workspace,
                                            GM_ADDR paddedWorkspace,
                                            const Plan &p) {
    constexpr uint32_t TM = 128, TN = 128, CS = TM * TN, BASE_STAGE_K = 512, STEP_K = 256;
    // Admit one regular full-A capacity class from the physical L1 budget.
    // Reserve actual TM*p.k slots; ND2NZ/LoadData extents remain p.ka/p.k.
    constexpr uint32_t L1_BYTES = 512 * 1024;
    constexpr uint32_t A_CAPACITY_K = (L1_BYTES - 2 * TN * BASE_STAGE_K) / (2 * TM);
    static_assert(2 * TM * A_CAPACITY_K + 2 * TN * BASE_STAGE_K == L1_BYTES,
                  "full A/B slots fit L1 exactly");
    static_assert(A_CAPACITY_K % 32 == 0, "int8 K32 capacity alignment");
    static_assert(2 * TM * STEP_K <= 64 * 1024 && 2 * TN * STEP_K <= 64 * 1024,
                  "double L0 input budget");
    static_assert(2 * CS * 4 <= 128 * 1024, "double CO1 budget");
    uint32_t STAGE_K = NzCapacityStageK(p.k), reserveM = TM;
    InitSocState();
    NzStaticQueue<TPosition::A1, HardEvent::MTE2_MTE1, HardEvent::MTE1_MTE2, 0, 0> aq;
    NzStaticQueue<TPosition::B1, HardEvent::MTE2_MTE1, HardEvent::MTE1_MTE2, 2, 2> bq;
    NzStaticQueue<TPosition::A2, HardEvent::MTE1_M, HardEvent::M_MTE1, 0, 3> a2q;
    NzStaticQueue<TPosition::B2, HardEvent::MTE1_M, HardEvent::M_MTE1, 2, 5> b2q;
    NzStaticQueue<TPosition::CO1, HardEvent::M_FIX, HardEvent::FIX_M, 0, 0> cq;
    a2q.Init(0, TM * STEP_K);
    b2q.Init(0, TN * STEP_K);
    cq.Init(0, CS * 4);
    GlobalTensor<int8_t> a, b;
    GlobalTensor<int64_t> ends;
    GlobalTensor<int32_t> ring;
    a.SetGlobalBuffer((__gm__ int8_t *)x);
    b.SetGlobalBuffer((__gm__ int8_t *)weight);
    ends.SetGlobalBuffer((__gm__ int64_t *)groups);
    ring.SetGlobalBuffer((__gm__ int32_t *)workspace);
    const uint32_t core = GetBlockIdx();
    uint32_t sequence = 0;
    NZMergedCursor<TM, FrameN> cursor;
    if (p.e + 1 > NZ_CURSOR_PACKED_WORDS)
        RestoreNzPreparedCursor<FrameN>(cursor, paddedWorkspace, p, core);
    else
        cursor.Init(ends, p, p.n, core);
    // Restore above invalidated this same 64-byte record after SyncAll.
    if (p.e + 1 > NZ_CURSOR_PACKED_WORDS && STAGE_K < p.k) {
        GlobalTensor<uint64_t> plans;
        plans.SetGlobalBuffer((__gm__ uint64_t *)NzCursorStateBase(paddedWorkspace, p));
        const uint64_t plan = plans.GetValue(core * NZ_CURSOR_RECORD_WORDS + 2);
        if (plan) {
            reserveM = static_cast<uint32_t>(plan);
            STAGE_K = static_cast<uint32_t>(plan >> 32);
        }
    }
    aq.Init(0, reserveM * p.k);
    bq.Init(2 * reserveM * p.k, TN * STAGE_K);
    NZMergedTask span{}, next{};
    bool available = cursor.Next(ends, p, span);
    if (available) {
        PrefetchNzA(aq, span, a, p);
        PrefetchCapacityNzB(bq, b, span, 0, 0, p, STAGE_K);
    }
    while (available) {
        auto al = aq.DeQue<int8_t>();
        const bool more = cursor.Next(ends, p, next);
        const uint32_t packedM = NzPackedRows(span.rows), planes = (span.cols + TN - 1) / TN;
        for (uint32_t unit = 0; unit < planes; unit++) {
            auto c = cq.AllocTensor<int32_t>();
            const uint32_t cols = span.cols - unit * TN < TN ? span.cols - unit * TN : TN;
            const uint32_t paddedCols = cols <= 16 ? 16 : (cols + 31) / 32 * 32;
            for (uint32_t stage0 = 0; stage0 < p.k; stage0 += STAGE_K) {
                const uint32_t sliceK = p.k - stage0 < STAGE_K ? p.k - stage0 : STAGE_K;
                // A1 is already ready and independent of the current B1 DMA.
                // Keep its first L0 load ahead of the B1-ready wait.
                const uint32_t firstK = sliceK < STEP_K ? sliceK : STEP_K;
                auto firstA2 = a2q.AllocTensor<int8_t>();
                LoadNzFullA2Tile(firstA2, al, packedM, stage0, firstK);
                auto bl = bq.DeQue<int8_t>();
                // Keep the next B slice queued, including across plane/span boundaries.
                if (stage0 + sliceK < p.k)
                    PrefetchCapacityNzB(bq, b, span, unit, stage0 + sliceK, p, STAGE_K);
                else if (unit + 1 < planes)
                    PrefetchCapacityNzB(bq, b, span, unit + 1, 0, p, STAGE_K);
                else if (more)
                    PrefetchCapacityNzB(bq, b, next, 0, 0, p, STAGE_K);
                // Wait until this first plane's B slices are queued before next-row A.
                if (unit == 0 && stage0 + sliceK == p.k && more)
                    PrefetchNzA(aq, next, a, p);
                for (uint32_t localK = 0; localK < sliceK; localK += STEP_K) {
                    const uint32_t innerK = sliceK - localK < STEP_K ? sliceK - localK : STEP_K;
                    const uint32_t globalK = stage0 + localK;
                    auto a2 = localK == 0 ? firstA2 : a2q.AllocTensor<int8_t>();
                    auto b2 = b2q.AllocTensor<int8_t>();
                    if (localK != 0)
                        LoadNzFullA2Tile(a2, al, packedM, globalK, innerK);
                    LoadData2dTransposeParams lb{};
                    lb.dstFracGap = 0;
                    if (paddedCols == 16) {
                        // Keep the first N16 fractals contiguous; unused N16 halves follow.
                        lb.repeatTimes = innerK / 32;
                        lb.srcStride = 1;
                        lb.dstGap = 0;
                        lb.dstFracGap = innerK / 32 - 1;
                        LoadDataWithTranspose(b2, bl[localK * 32], lb);
                    } else if (innerK > paddedCols) {
                        lb.repeatTimes = innerK / 32;
                        lb.srcStride = 1;
                        lb.dstGap = paddedCols / 16 - 1;
                        for (uint32_t nb = 0; nb < paddedCols / 32; nb++)
                            LoadDataWithTranspose(
                                b2[nb * 1024], bl[localK * 32 + nb * sliceK * 32], lb);
                    } else {
                        lb.repeatTimes = paddedCols / 32;
                        lb.srcStride = sliceK / 32;
                        lb.dstGap = 1;
                        for (uint32_t kb = 0; kb < innerK / 32; kb++)
                            LoadDataWithTranspose(
                                b2[kb * (paddedCols / 32 * 1024)], bl[(localK + kb * 32) * 32], lb);
                    }
                    a2q.EnQue(a2);
                    b2q.EnQue(b2);
                    a2 = a2q.DeQue<int8_t>();
                    b2 = b2q.DeQue<int8_t>();
                    MmadParams mp{};
                    mp.m = packedM;
                    mp.n = paddedCols;
                    mp.k = innerK;
                    mp.cmatrixInitVal = globalK == 0;
                    Mmad(c, a2, b2, mp);
                    // Match the installed Matmul primitive's small-MN pipeline requirement.
                    if ((packedM / 16) * (paddedCols / 16) < 10)
                        PipeBarrier<PIPE_M>();
                    a2q.FreeTensor(a2);
                    b2q.FreeTensor(b2);
                }
                // Free carries MTE1->MTE2 after both L0 chunks have loaded.
                bq.FreeTensor(bl);
            }
            cq.EnQue(c);
            c = cq.DeQue<int32_t>();
            if (sequence >= 2)
                CrossCoreWaitFlag<2>(9);
            FixpipeParamsV220 fp{};
            fp.nSize = paddedCols;
            fp.mSize = span.rows;
            fp.srcStride = packedM;
            fp.dstStride = TN;
            fp.ndNum = 1;
            Fixpipe(ring[NzRingData<FrameN>(core, sequence, p)], c, fp);
            CrossCoreSetFlag<2, PIPE_FIX>(8);
            ++sequence;
            cq.FreeTensor(c);
        }
        aq.FreeTensor(al);
        if (more)
            span = next;
        available = more;
    }
    for (uint32_t i = 0; i < (sequence < 2 ? sequence : 2); i++)
        CrossCoreWaitFlag<2>(9);
    aq.Drain();
    bq.Drain();
    a2q.Drain();
    b2q.Drain();
    cq.Drain();
    PipeBarrier<PIPE_ALL>();
}

template <uint32_t FrameN = 0>
__aicore__ inline void
CubeMergedNzA1(GM_ADDR x, GM_ADDR weight, GM_ADDR groups, GM_ADDR workspace, const Plan &p) {
    constexpr uint32_t TM = 128, TN = 128, CS = TM * TN, STAGE_K = 512, STEP_K = 256;
    // Admit one regular full-A capacity class from the physical L1 budget.
    // Reserve actual TM*p.k slots; ND2NZ/LoadData extents remain p.ka/p.k.
    constexpr uint32_t L1_BYTES = 512 * 1024;
    constexpr uint32_t A_CAPACITY_K = (L1_BYTES - 2 * TN * STAGE_K) / (2 * TM);
    static_assert(2 * TM * A_CAPACITY_K + 2 * TN * STAGE_K == L1_BYTES,
                  "full A/B slots fit L1 exactly");
    static_assert(A_CAPACITY_K % 32 == 0, "int8 K32 capacity alignment");
    static_assert(2 * TM * STEP_K <= 64 * 1024 && 2 * TN * STEP_K <= 64 * 1024,
                  "double L0 input budget");
    static_assert(2 * CS * 4 <= 128 * 1024, "double CO1 budget");
    TPipe pipe;
    TQue<TPosition::A1, 2> aq;
    TQue<TPosition::B1, 2> bq;
    TQue<TPosition::A2, 2> a2q;
    TQue<TPosition::B2, 2> b2q;
    TQue<TPosition::CO1, 2> cq;
    pipe.InitBuffer(aq, 2, TM * p.k);
    pipe.InitBuffer(bq, 2, TN * STAGE_K);
    pipe.InitBuffer(a2q, 2, TM * STEP_K);
    pipe.InitBuffer(b2q, 2, TN * STEP_K);
    pipe.InitBuffer(cq, 2, CS * 4);
    GlobalTensor<int8_t> a, b;
    GlobalTensor<int64_t> ends;
    GlobalTensor<int32_t> ring;
    a.SetGlobalBuffer((__gm__ int8_t *)x);
    b.SetGlobalBuffer((__gm__ int8_t *)weight);
    ends.SetGlobalBuffer((__gm__ int64_t *)groups);
    ring.SetGlobalBuffer((__gm__ int32_t *)workspace);
    const uint32_t core = GetBlockIdx();
    uint32_t sequence = 0;
    NZMergedCursor<TM, FrameN> cursor;
    cursor.Init(ends, p, p.n, core);
    NZMergedTask span{}, next{};
    bool available = cursor.Next(ends, p, span);
    if (available) {
        PrefetchNzA(aq, span, a, p);
        PrefetchStagedNzB<STAGE_K>(bq, b, span, 0, 0, p);
    }
    while (available) {
        auto al = aq.DeQue<int8_t>();
        const bool more = cursor.Next(ends, p, next);
        const uint32_t packedM = NzPackedRows(span.rows), planes = (span.cols + TN - 1) / TN;
        for (uint32_t unit = 0; unit < planes; unit++) {
            auto c = cq.AllocTensor<int32_t>();
            const uint32_t cols = span.cols - unit * TN < TN ? span.cols - unit * TN : TN;
            const uint32_t paddedCols = cols <= 16 ? 16 : (cols + 31) / 32 * 32;
            for (uint32_t stage0 = 0; stage0 < p.k; stage0 += STAGE_K) {
                const uint32_t sliceK = p.k - stage0 < STAGE_K ? p.k - stage0 : STAGE_K;
                auto bl = bq.DeQue<int8_t>();
                // Keep the next B slice queued, including across plane/span boundaries.
                if (stage0 + sliceK < p.k)
                    PrefetchStagedNzB<STAGE_K>(bq, b, span, unit, stage0 + sliceK, p);
                else if (unit + 1 < planes)
                    PrefetchStagedNzB<STAGE_K>(bq, b, span, unit + 1, 0, p);
                else if (more)
                    PrefetchStagedNzB<STAGE_K>(bq, b, next, 0, 0, p);
                // Wait until this first plane's B slices are queued before next-row A.
                if (unit == 0 && stage0 + sliceK == p.k && more)
                    PrefetchNzA(aq, next, a, p);
                for (uint32_t localK = 0; localK < sliceK; localK += STEP_K) {
                    const uint32_t innerK = sliceK - localK < STEP_K ? sliceK - localK : STEP_K;
                    const uint32_t globalK = stage0 + localK;
                    auto a2 = a2q.AllocTensor<int8_t>();
                    auto b2 = b2q.AllocTensor<int8_t>();
                    LoadData2DParams la{};
                    la.ifTranspose = false;
                    if (innerK / 32 < packedM / 16) {
                        la.repeatTimes = packedM / 16;
                        la.srcStride = 1;
                        la.dstGap = innerK / 32 - 1;
                        for (uint32_t kb = 0; kb < innerK / 32; kb++)
                            LoadData(a2[kb * 512], al[(globalK + kb * 32) * packedM], la);
                    } else {
                        la.repeatTimes = innerK / 32;
                        la.srcStride = packedM / 16;
                        for (uint32_t mb = 0; mb < packedM / 16; mb++)
                            LoadData(a2[mb * innerK * 16], al[globalK * packedM + mb * 512], la);
                    }
                    LoadData2dTransposeParams lb{};
                    lb.dstFracGap = 0;
                    if (paddedCols == 16) {
                        // Keep the first N16 fractals contiguous; unused N16 halves follow.
                        lb.repeatTimes = innerK / 32;
                        lb.srcStride = 1;
                        lb.dstGap = 0;
                        lb.dstFracGap = innerK / 32 - 1;
                        LoadDataWithTranspose(b2, bl[localK * 32], lb);
                    } else if (innerK > paddedCols) {
                        lb.repeatTimes = innerK / 32;
                        lb.srcStride = 1;
                        lb.dstGap = paddedCols / 16 - 1;
                        for (uint32_t nb = 0; nb < paddedCols / 32; nb++)
                            LoadDataWithTranspose(
                                b2[nb * 1024], bl[localK * 32 + nb * sliceK * 32], lb);
                    } else {
                        lb.repeatTimes = paddedCols / 32;
                        lb.srcStride = sliceK / 32;
                        lb.dstGap = 1;
                        for (uint32_t kb = 0; kb < innerK / 32; kb++)
                            LoadDataWithTranspose(
                                b2[kb * (paddedCols / 32 * 1024)], bl[(localK + kb * 32) * 32], lb);
                    }
                    a2q.EnQue(a2);
                    b2q.EnQue(b2);
                    a2 = a2q.DeQue<int8_t>();
                    b2 = b2q.DeQue<int8_t>();
                    MmadParams mp{};
                    mp.m = packedM;
                    mp.n = paddedCols;
                    mp.k = innerK;
                    mp.cmatrixInitVal = globalK == 0;
                    Mmad(c, a2, b2, mp);
                    // Match the installed Matmul primitive's small-MN pipeline requirement.
                    if ((packedM / 16) * (paddedCols / 16) < 10)
                        PipeBarrier<PIPE_M>();
                    a2q.FreeTensor(a2);
                    b2q.FreeTensor(b2);
                }
                // Free carries MTE1->MTE2 after both L0 chunks have loaded.
                bq.FreeTensor(bl);
            }
            cq.EnQue(c);
            c = cq.DeQue<int32_t>();
            if (sequence >= 2)
                CrossCoreWaitFlag<2>(9);
            FixpipeParamsV220 fp{};
            fp.nSize = paddedCols;
            fp.mSize = span.rows;
            fp.srcStride = packedM;
            fp.dstStride = TN;
            fp.ndNum = 1;
            Fixpipe(ring[NzRingData<FrameN>(core, sequence, p)], c, fp);
            CrossCoreSetFlag<2, PIPE_FIX>(8);
            ++sequence;
            cq.FreeTensor(c);
        }
        aq.FreeTensor(al);
        if (more)
            span = next;
        available = more;
    }
    for (uint32_t i = 0; i < (sequence < 2 ? sequence : 2); i++)
        CrossCoreWaitFlag<2>(9);
}

__aicore__ inline uint32_t NativePackRows(uint32_t pn) {
    uint32_t rows = (262144 / pn) / 32 * 32;
    return rows < 512 ? rows : 512;
}

__aicore__ inline PadJob NativeBalancedPadJob(
    uint32_t q, uint32_t e, uint32_t chunk, uint32_t k, uint32_t n, uint32_t pk, uint32_t pn) {
    PadJob t{};
    t.isX = false;
    t.expert = q % e;
    t.row = q / e * chunk;
    t.stride = pn;
    t.cols = n;
    t.rows = pk - t.row;
    if (t.rows > chunk)
        t.rows = chunk;
    t.real = k > t.row ? k - t.row : 0;
    if (t.real > t.rows)
        t.real = t.rows;
    return t;
}

template <bool TailOnly>
__aicore__ inline void PrefetchNativeWeightsTuned(const LocalTensor<int8_t> &local,
                                                  const GlobalTensor<int8_t> &input,
                                                  const PadJob &job,
                                                  uint32_t k,
                                                  uint32_t n,
                                                  uint32_t capacityRows,
                                                  uint32_t pn) {
    if (job.real < job.rows) {
        if constexpr (TailOnly) {
            const uint32_t padRows = job.rows - job.real;
            InitConstValue(
                local.ReinterpretCast<uint32_t>()[job.real * 8],
                InitConstValueParams<uint32_t>{static_cast<uint16_t>(pn / 32),
                                               static_cast<uint16_t>(padRows),
                                               static_cast<uint16_t>(capacityRows - padRows),
                                               0U});
        } else {
            InitConstValue(local.ReinterpretCast<uint32_t>(),
                           InitConstValueParams<uint32_t>{
                               1, static_cast<uint16_t>(capacityRows * pn / 32), 0, 0U});
        }
        PipeBarrier<PIPE_MTE2>();
    }
    if (job.real) {
        Nd2NzParams cp{};
        cp.ndNum = 1;
        cp.nValue = job.real;
        cp.dValue = n;
        cp.srcDValue = n;
        cp.dstNzC0Stride = capacityRows;
        cp.dstNzNStride = 1;
        DataCopy(local, input[(uint64_t(job.expert) * k + job.row) * n], cp);
    }
}

template <uint32_t RowsHint, bool TailOnly>
__aicore__ inline void PadWeightsNativeRows(
    GM_ADDR w, GM_ADDR wp, uint32_t k, uint32_t n, uint32_t e, uint32_t pk, uint32_t pn) {
    uint32_t rows = NativePackRows(pn);
    if constexpr (RowsHint > 0) {
        if (rows > RowsHint)
            rows = RowsHint;
    }
    const uint32_t bytes = rows * pn, wt = (pk + rows - 1) / rows, total = e * wt;
    const uint32_t firstTask = GetBlockIdx(), step = GetBlockNum();
    if (firstTask >= total)
        return;
    uint32_t slots = 512 * 1024 / bytes;
    if (slots > 4)
        slots = 4;
    TPipe pipe;
    TBuf<TPosition::B1> arenaB;
    pipe.InitBuffer(arenaB, slots * bytes);
    auto arena = arenaB.Get<int8_t>();
    GlobalTensor<int8_t> input, output;
    input.SetGlobalBuffer((__gm__ int8_t *)w);
    output.SetGlobalBuffer((__gm__ int8_t *)wp);
    TEventID ready[4], retire[4];
    bool used[4] = {false, false, false, false};
    for (uint32_t i = 0; i < slots; i++) {
        ready[i] = pipe.AllocEventID<HardEvent::MTE2_MTE3>();
        retire[i] = pipe.AllocEventID<HardEvent::MTE3_MTE2>();
        const uint32_t task = firstTask + i * step;
        if (task < total) {
            PrefetchNativeWeightsTuned<TailOnly>(arena[i * bytes],
                                                 input,
                                                 NativeBalancedPadJob(task, e, rows, k, n, pk, pn),
                                                 k,
                                                 n,
                                                 rows,
                                                 pn);
            SetFlag<HardEvent::MTE2_MTE3>(ready[i]);
            used[i] = true;
        }
    }
    uint32_t slot = 0;
    for (uint32_t task = firstTask; task < total; task += step) {
        WaitFlag<HardEvent::MTE2_MTE3>(ready[slot]);
        const PadJob job = NativeBalancedPadJob(task, e, rows, k, n, pk, pn);
        DataCopyParams cp{static_cast<uint16_t>(pn / 32),
                          static_cast<uint16_t>(job.rows),
                          static_cast<uint16_t>(rows - job.rows),
                          static_cast<uint16_t>(pk - job.rows)};
        DataCopy(output[uint64_t(job.expert) * pk * pn + uint64_t(job.row) * 32],
                 arena[slot * bytes],
                 cp);
        SetFlag<HardEvent::MTE3_MTE2>(retire[slot]);
        const uint32_t next = task + slots * step;
        if (next < total) {
            WaitFlag<HardEvent::MTE3_MTE2>(retire[slot]);
            PrefetchNativeWeightsTuned<TailOnly>(arena[slot * bytes],
                                                 input,
                                                 NativeBalancedPadJob(next, e, rows, k, n, pk, pn),
                                                 k,
                                                 n,
                                                 rows,
                                                 pn);
            SetFlag<HardEvent::MTE2_MTE3>(ready[slot]);
        }
        if (++slot == slots)
            slot = 0;
    }
    for (uint32_t i = 0; i < slots; i++) {
        if (used[i])
            WaitFlag<HardEvent::MTE3_MTE2>(retire[i]);
        pipe.ReleaseEventID<HardEvent::MTE2_MTE3>(ready[i]);
        pipe.ReleaseEventID<HardEvent::MTE3_MTE2>(retire[i]);
    }
}

__aicore__ inline bool NonemptyExpert(const GlobalTensor<int64_t> &ends, uint32_t expert) {
    const uint32_t end = static_cast<uint32_t>(ends.GetValue(expert));
    const uint32_t start = expert ? static_cast<uint32_t>(ends.GetValue(expert - 1)) : 0;
    return end > start;
}

template <uint32_t RowsHint, bool TailOnly>
__aicore__ inline void PadWeightsNonemptyNativeRows(GM_ADDR w,
                                                    GM_ADDR wp,
                                                    GM_ADDR groups,
                                                    uint32_t k,
                                                    uint32_t n,
                                                    uint32_t e,
                                                    uint32_t pk,
                                                    uint32_t pn) {
    uint32_t rows = NativePackRows(pn);
    if constexpr (RowsHint > 0) {
        if (rows > RowsHint)
            rows = RowsHint;
    }
    const uint32_t bytes = rows * pn, wt = (pk + rows - 1) / rows, total = e * wt;
    const uint32_t firstTask = GetBlockIdx(), step = GetBlockNum();
    if (firstTask >= total)
        return;
    uint32_t slots = 512 * 1024 / bytes;
    if (slots > 4)
        slots = 4;
    TPipe pipe;
    TBuf<TPosition::B1> arenaB;
    pipe.InitBuffer(arenaB, slots * bytes);
    auto arena = arenaB.Get<int8_t>();
    GlobalTensor<int8_t> input, output;
    input.SetGlobalBuffer((__gm__ int8_t *)w);
    output.SetGlobalBuffer((__gm__ int8_t *)wp);
    GlobalTensor<int64_t> ends;
    ends.SetGlobalBuffer((__gm__ int64_t *)groups);
    bool active[4] = {false, false, false, false};
    TEventID ready[4], retire[4];
    bool used[4] = {false, false, false, false};
    for (uint32_t i = 0; i < slots; i++) {
        ready[i] = pipe.AllocEventID<HardEvent::MTE2_MTE3>();
        retire[i] = pipe.AllocEventID<HardEvent::MTE3_MTE2>();
        const uint32_t task = firstTask + i * step;
        if (task < total) {
            const PadJob pending = NativeBalancedPadJob(task, e, rows, k, n, pk, pn);
            active[i] = NonemptyExpert(ends, pending.expert);
            if (active[i])
                PrefetchNativeWeightsTuned<TailOnly>(
                    arena[i * bytes], input, pending, k, n, rows, pn);
            SetFlag<HardEvent::MTE2_MTE3>(ready[i]);
            used[i] = true;
        }
    }
    uint32_t slot = 0;
    for (uint32_t task = firstTask; task < total; task += step) {
        WaitFlag<HardEvent::MTE2_MTE3>(ready[slot]);
        const PadJob job = NativeBalancedPadJob(task, e, rows, k, n, pk, pn);
        DataCopyParams cp{static_cast<uint16_t>(pn / 32),
                          static_cast<uint16_t>(job.rows),
                          static_cast<uint16_t>(rows - job.rows),
                          static_cast<uint16_t>(pk - job.rows)};
        if (active[slot])
            DataCopy(output[uint64_t(job.expert) * pk * pn + uint64_t(job.row) * 32],
                     arena[slot * bytes],
                     cp);
        SetFlag<HardEvent::MTE3_MTE2>(retire[slot]);
        const uint32_t next = task + slots * step;
        if (next < total) {
            WaitFlag<HardEvent::MTE3_MTE2>(retire[slot]);
            const PadJob pending = NativeBalancedPadJob(next, e, rows, k, n, pk, pn);
            active[slot] = NonemptyExpert(ends, pending.expert);
            if (active[slot])
                PrefetchNativeWeightsTuned<TailOnly>(
                    arena[slot * bytes], input, pending, k, n, rows, pn);
            SetFlag<HardEvent::MTE2_MTE3>(ready[slot]);
        }
        if (++slot == slots)
            slot = 0;
    }
    for (uint32_t i = 0; i < slots; i++) {
        if (used[i])
            WaitFlag<HardEvent::MTE3_MTE2>(retire[i]);
        pipe.ReleaseEventID<HardEvent::MTE2_MTE3>(ready[i]);
        pipe.ReleaseEventID<HardEvent::MTE3_MTE2>(retire[i]);
    }
}

// NZ_FRAME_KERNEL_BEGIN
template <uint32_t FrameN>
__global__ __aicore__ void KernelNzFrame(GM_ADDR x,
                                         GM_ADDR w,
                                         GM_ADDR scale,
                                         GM_ADDR groups,
                                         GM_ADDR y,
                                         GM_ADDR workspace,
                                         GM_ADDR paddedWorkspace,
                                         Plan p) {
    static_assert(FrameN >= 128 && FrameN <= 4096 && FrameN % 128 == 0, "all regular NZ frames");
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
    auto *ax = (__gm__ uint8_t *)paddedWorkspace;
    // Raw A does not use its reserved padding region. Let packed B inherit
    // the workspace base alignment; the cursor records keep their old offset.
    auto *aw = ax + (p.rawA ? 0 : uint64_t(p.m) * p.k);
    if ASCEND_IS_AIC {
        PadWeightsNonemptyNativeRows<64, true>(w, (GM_ADDR)aw, groups, p.rawK, p.n, p.e, p.k, p.wn);
    }
    if ASCEND_IS_AIV {
        PadInputsCore(x, w, (GM_ADDR)ax, (GM_ADDR)aw, p.m, p.rawK, p.n, 0, p.k, p.wn, p.rawA);
        if (p.e + 1 > NZ_CURSOR_PACKED_WORDS && GetBlockIdx() == 0)
            PrepareNzCursorStates<FrameN>(groups, paddedWorkspace, p);
    }
    SyncAll<false>();
    if ASCEND_IS_AIC {
        if (!p.rawA)
            x = (GM_ADDR)ax;
        CubeMergedNzPrepared<FrameN>(x, (GM_ADDR)aw, groups, workspace, paddedWorkspace, p);
    } else {
        VectorMergedNzPrepared<FrameN>(scale, groups, y, workspace, paddedWorkspace, p);
    }
}

// NZ_FRAME_KERNEL_END

// ND_CONTIGUOUS_CURSOR_BEGIN
// Physical N256 units, cut on device from actual expert endpoint counts.
// A1 reuse is a separate row-identity decision, never an output-sequence unit.
struct NdContiguousCursor {
    uint32_t nTiles, expert, start, end, sequence;
    uint64_t position, limit, base, groupLimit;
    bool loaded;

    template <class Ends>
    __aicore__ inline void Init(const Ends &ends, const Plan &p, uint32_t core) {
        nTiles = (p.n + 255) / 256;
        uint64_t total = 0;
        uint32_t previous = 0;
        for (uint32_t e = 0; e < p.e; e++) {
            uint32_t finish = static_cast<uint32_t>(ends.GetValue(e));
            total += (uint64_t(finish - previous) + 63) / 64 * nTiles;
            previous = finish;
        }
        position = total * core / p.cores;
        limit = total * (core + 1) / p.cores;
        expert = 0;
        start = 0;
        end = 0;
        sequence = 0;
        base = 0;
        groupLimit = 0;
        loaded = false;
    }

    template <class Ends>
    __aicore__ inline bool Next(const Ends &ends, const Plan &p, CubePrefetchTask &task) {
        if (position >= limit)
            return false;
        while (!loaded || position >= groupLimit) {
            if (loaded) {
                start = end;
                base = groupLimit;
                expert++;
            }
            if (expert >= p.e)
                return false;
            end = static_cast<uint32_t>(ends.GetValue(expert));
            groupLimit = base + (uint64_t(end - start) + 63) / 64 * nTiles;
            loaded = true;
        }
        const uint64_t local = position - base;
        task.expert = expert;
        task.row = start + local / nTiles * 64;
        task.rows = end - task.row < 64 ? end - task.row : 64;
        task.col = local % nTiles * 256;
        task.sequence = sequence++;
        position++;
        return true;
    }
};

__aicore__ inline bool SameNdInputRows(const CubePrefetchTask &a, const CubePrefetchTask &b) {
    return a.expert == b.expert && a.row == b.row && a.rows == b.rows;
}

// ND_CONTIGUOUS_CURSOR_END

__aicore__ inline void
VectorNdContiguous(GM_ADDR scale, GM_ADDR groups, GM_ADDR y, GM_ADDR workspace, const Plan &p) {
    constexpr uint32_t TM = 64, TN = 256;
    const uint32_t n = p.n;
    constexpr uint32_t CS = TM * TN, VS = CS > 8192 ? 8192 : CS, VR = VS / TN;
    TPipe pipe;
    TBuf<TPosition::VECCALC> rawB, zB, innerB, denB, numB, halfB, scaleB, maskB, groupB;
    pipe.InitBuffer(rawB, VS * 4 + 256);
    pipe.InitBuffer(zB, VS * 4 + 256);
    pipe.InitBuffer(innerB, VS * 4 + 256);
    pipe.InitBuffer(denB, VS * 4 + 256);
    pipe.InitBuffer(numB, VS * 4 + 256);
    pipe.InitBuffer(halfB, VS * 2);
    pipe.InitBuffer(scaleB, TN * 4);
    pipe.InitBuffer(maskB, VS / 8);
    pipe.InitBuffer(groupB, 128 * 8);
    auto raw = rawB.Get<int32_t>();
    auto z = zB.Get<float>();
    auto inner = innerB.Get<float>();
    auto den = denB.Get<float>();
    auto num = numB.Get<float>();
    auto result = halfB.Get<half>();
    auto coeff = scaleB.Get<float>();
    auto mask = maskB.Get<uint8_t>();
    auto localEnds = groupB.Get<int64_t>();
    GlobalTensor<int32_t> ring;
    GlobalTensor<float> sg;
    GlobalTensor<half> out;
    GlobalTensor<int64_t> ends;
    ring.SetGlobalBuffer((__gm__ int32_t *)workspace);
    sg.SetGlobalBuffer((__gm__ float *)scale);
    out.SetGlobalBuffer((__gm__ half *)y);
    ends.SetGlobalBuffer((__gm__ int64_t *)groups);
    DataCopyExtParams gcp{1, p.e * 8U, 0, 0, 0};
    DataCopyPadExtParams<int64_t> gp{false, 0, 0, 0};
    DataCopyPad(localEnds, ends, gcp, gp);
    Sync<HardEvent::MTE2_S>(pipe);
    uint32_t core = GetBlockIdx() / 2;
    NdContiguousCursor cursor;
    cursor.Init(localEnds, p, core);
    CubePrefetchTask task{};
    while (cursor.Next(localEnds, p, task)) {
        uint32_t sequence = task.sequence, e = task.expert, row = task.row, col = task.col;
        uint32_t totalRows = task.rows, cols = n - col < TN ? n - col : TN;
        uint32_t aligned = (cols + 7) / 8 * 8;
        CrossCoreWaitFlag<2>(8);
        uint32_t halfRows = (totalRows + 1) / 2;
        uint32_t subStart = GetSubBlockIdx() * halfRows;
        uint32_t subEnd = subStart + halfRows < totalRows ? subStart + halfRows : totalRows;
        if (subStart >= subEnd)
            CrossCoreSetFlag<2, PIPE_MTE2>(9);
        for (uint32_t vrow = subStart; vrow < subEnd; vrow += VR) {
            uint32_t rows = subEnd - vrow < VR ? subEnd - vrow : VR;
            if (cols < TN)
                Duplicate(raw, 0, VS);
            Sync<HardEvent::V_MTE2>(pipe);
            DataCopyExtParams cp{
                static_cast<uint16_t>(rows), cols * 4U, (TN - cols) * 4U, (TN - aligned) / 8, 0};
            DataCopyPadExtParams<int32_t> pad{true, 0, static_cast<uint8_t>(aligned - cols), 0};
            DataCopyPad(raw, ring[(core * 2 + sequence % 2) * CS + vrow * TN], cp, pad);
            DataCopyExtParams scp{1, cols * 4U, 0, 0, 0};
            DataCopyPadExtParams<float> sp{true, 0, static_cast<uint8_t>(aligned - cols), 0.0f};
            if (vrow == subStart)
                DataCopyPad(coeff, sg[uint64_t(e) * n + col], scp, sp);
            if (vrow + rows == subEnd)
                CrossCoreSetFlag<2, PIPE_MTE2>(9);
            Sync<HardEvent::MTE2_V>(pipe);
            Cast(z, raw, RoundMode::CAST_NONE, rows * TN);
            PipeBarrier<PIPE_V>();
            for (uint32_t off = 0; off < cols; off += 64) {
                Mul(z[off],
                    z[off],
                    coeff[off],
                    cols - off < 64 ? cols - off : 64,
                    rows,
                    {1, 1, 1, TN / 8, TN / 8, 0});
            }
            PipeBarrier<PIPE_V>();
            // Copied padding is zero, so the entire aligned tile is initialized.
            uint32_t count = rows * TN;
            // Algebraically equivalent z/(1+exp(-2*p(z))). FP32 throughout.
            Mul(inner, z, z, count);
            PipeBarrier<PIPE_V>();
            Muls(inner, inner, -0.07135481627330025f, count);
            PipeBarrier<PIPE_V>();
            Adds(inner, inner, -1.5957691216057308f, count);
            PipeBarrier<PIPE_V>();
            Mul(inner, inner, z, count);
            PipeBarrier<PIPE_V>();
            Exp(inner, inner, count);
            PipeBarrier<PIPE_V>();
            Adds(inner, inner, 1.0f, count);
            PipeBarrier<PIPE_V>();
            Div(z, z, inner, count);
            PipeBarrier<PIPE_V>();
            Cast(result, z, RoundMode::CAST_RINT, rows * TN);
            Sync<HardEvent::V_MTE3>(pipe);
            uint32_t ah = (cols + 15) / 16 * 16;
            DataCopyExtParams ocp{
                static_cast<uint16_t>(rows), cols * 2U, (TN - ah) / 16, (n - cols) * 2U, 0};
            DataCopyPad(out[uint64_t(row + vrow) * n + col], result, ocp);
            Sync<HardEvent::MTE3_V>(pipe);
        }
    }
}

template <typename Q>
__aicore__ inline void
PrefetchNd64A(Q &aq, const CubePrefetchTask &t, const GlobalTensor<int8_t> &a, const Plan &p) {
    auto local = aq.template AllocTensor<int8_t>();
    Nd2NzParams cp{};
    cp.ndNum = 1;
    cp.nValue = t.rows;
    cp.dValue = p.k;
    cp.srcDValue = p.k;
    cp.dstNzC0Stride = NzPackedRows(t.rows);
    cp.dstNzNStride = 1;
    DataCopy(local, a[uint64_t(t.row) * p.k], cp);
    aq.EnQue(local);
}

template <typename Q>
__aicore__ inline void PrefetchNd64B(Q &bq,
                                     const CubePrefetchTask &t,
                                     uint32_t start,
                                     const GlobalTensor<int8_t> &b,
                                     const Plan &p) {
    constexpr uint32_t TN = 256, STAGE = 512;
    const uint32_t cols = p.n - t.col < TN ? p.n - t.col : TN, np = (cols + 31) / 32 * 32;
    const uint32_t slice = p.k - start < STAGE ? p.k - start : STAGE;
    auto local = bq.template AllocTensor<int8_t>();
    Nd2NzParams cp{};
    cp.ndNum = 1;
    cp.nValue = slice;
    cp.dValue = cols;
    cp.srcDValue = p.n;
    cp.dstNzC0Stride = slice;
    cp.dstNzNStride = 1;
    DataCopy(local, b[(uint64_t(t.expert) * p.k + start) * p.n + t.col], cp);
    bq.EnQue(local);
}

__aicore__ inline void
CubeNd64DoubleC(GM_ADDR x, GM_ADDR weight, GM_ADDR groups, GM_ADDR workspace, const Plan &p) {
    constexpr uint32_t TM = ND64_TM, TN = ND64_TN, CS = TM * TN, STAGE = ND64_STAGE,
                       STEP = ND64_STEP;
    static_assert(2 * TM * ND64_CAPACITY + 2 * TN * STAGE == 512 * 1024,
                  "double full-A and sliced-B L1 budget");
    static_assert(2 * TM * STEP <= 64 * 1024 && 2 * TN * STEP <= 64 * 1024 &&
                      2 * CS * 4 <= 128 * 1024,
                  "double L0 input and output budgets");
    static_assert(5 * (8192 * 4 + 256) + 8192 * 2 + TN * 4 + 8192 / 8 + 128 * 8 <= 192 * 1024,
                  "original generic Vector64x256 UB budget");
    TPipe pipe;
    TQue<TPosition::A1, 2> aq;
    TQue<TPosition::B1, 2> bq;
    TQue<TPosition::A2, 2> a2q;
    TQue<TPosition::B2, 2> b2q;
    TQue<TPosition::CO1, 2> cq;
    pipe.InitBuffer(aq, 2, TM * ND64_CAPACITY);
    pipe.InitBuffer(bq, 2, TN * STAGE);
    pipe.InitBuffer(a2q, 2, TM * STEP);
    pipe.InitBuffer(b2q, 2, TN * STEP);
    pipe.InitBuffer(cq, 2, CS * 4);
    GlobalTensor<int8_t> a, b;
    GlobalTensor<int64_t> ends;
    GlobalTensor<int32_t> ring;
    a.SetGlobalBuffer((__gm__ int8_t *)x);
    b.SetGlobalBuffer((__gm__ int8_t *)weight);
    ends.SetGlobalBuffer((__gm__ int64_t *)groups);
    ring.SetGlobalBuffer((__gm__ int32_t *)workspace);
    const uint32_t core = GetBlockIdx();
    uint32_t completed = 0;
    NdContiguousCursor cursor;
    cursor.Init(ends, p, core);
    CubePrefetchTask task{}, next{};
    bool available = cursor.Next(ends, p, task);
    if (available) {
        PrefetchNd64A(aq, task, a, p);
        PrefetchNd64B(bq, task, 0, b, p);
    }
    bool held = false;
    LocalTensor<int8_t> al;
    while (available) {
        if (!held)
            al = aq.DeQue<int8_t>();
        const bool more = cursor.Next(ends, p, next);
        const bool reuse = more && SameNdInputRows(task, next);
        auto c = cq.AllocTensor<int32_t>();
        const uint32_t mpad = NzPackedRows(task.rows),
                       cols = p.n - task.col < TN ? p.n - task.col : TN;
        const uint32_t npad = (cols + 31) / 32 * 32;
        constexpr uint32_t stepK = STEP;
        for (uint32_t start = 0; start < p.k; start += STAGE) {
            const uint32_t slice = p.k - start < STAGE ? p.k - start : STAGE;
            auto bl = bq.DeQue<int8_t>();
            if (start + slice < p.k)
                PrefetchNd64B(bq, task, start + slice, b, p);
            else if (more) {
                PrefetchNd64B(bq, next, 0, b, p);
            }
            // Queue the B stage required next before advancing next-task A.
            // The alternate A1 slot retains its existing queue reuse fence.
            if (start == 0 && more && !reuse)
                PrefetchNd64A(aq, next, a, p);
            for (uint32_t local = 0; local < slice; local += stepK) {
                const uint32_t inner = slice - local < stepK ? slice - local : stepK,
                               global = start + local;
                auto a2 = a2q.AllocTensor<int8_t>();
                auto b2 = b2q.AllocTensor<int8_t>();
                LoadData2DParams la{};
                la.ifTranspose = false;
                if (inner / 32 < mpad / 16) {
                    la.repeatTimes = mpad / 16;
                    la.srcStride = 1;
                    la.dstGap = inner / 32 - 1;
                    for (uint32_t kb = 0; kb < inner / 32; kb++)
                        LoadData(a2[kb * 512], al[(global + kb * 32) * mpad], la);
                } else {
                    la.repeatTimes = inner / 32;
                    la.srcStride = mpad / 16;
                    for (uint32_t mb = 0; mb < mpad / 16; mb++)
                        LoadData(a2[mb * inner * 16], al[global * mpad + mb * 512], la);
                }
                LoadData2dTransposeParams lb{};
                lb.dstFracGap = 0;
                if (inner > npad) {
                    lb.repeatTimes = inner / 32;
                    lb.srcStride = 1;
                    lb.dstGap = npad / 16 - 1;
                    for (uint32_t nb = 0; nb < npad / 32; nb++)
                        LoadDataWithTranspose(b2[nb * 1024], bl[local * 32 + nb * slice * 32], lb);
                } else {
                    lb.repeatTimes = npad / 32;
                    lb.srcStride = slice / 32;
                    lb.dstGap = 1;
                    for (uint32_t kb = 0; kb < inner / 32; kb++)
                        LoadDataWithTranspose(b2[kb * npad * 32], bl[(local + kb * 32) * 32], lb);
                }
                a2q.EnQue(a2);
                b2q.EnQue(b2);
                a2 = a2q.DeQue<int8_t>();
                b2 = b2q.DeQue<int8_t>();
                MmadParams mm{};
                mm.m = mpad;
                mm.n = npad;
                mm.k = inner;
                mm.cmatrixInitVal = global == 0;
                Mmad(c, a2, b2, mm);
                if ((mpad / 16) * (npad / 16) < 10)
                    PipeBarrier<PIPE_M>();
                a2q.FreeTensor(a2);
                b2q.FreeTensor(b2);
            }
            bq.FreeTensor(bl);
        }
        if (!reuse)
            aq.FreeTensor(al);
        cq.EnQue(c);
        c = cq.DeQue<int32_t>();
        if (task.sequence >= 2)
            CrossCoreWaitFlag<2>(9);
        FixpipeParamsV220 fp{};
        fp.nSize = npad;
        fp.mSize = task.rows;
        fp.srcStride = mpad;
        fp.dstStride = TN;
        fp.ndNum = 1;
        Fixpipe(ring[(core * 2 + task.sequence % 2) * CS], c, fp);
        CrossCoreSetFlag<2, PIPE_FIX>(8);
        cq.FreeTensor(c);
        ++completed;
        held = reuse;
        if (more)
            task = next;
        available = more;
    }
    for (uint32_t i = 0; i < (completed < 2 ? completed : 2); i++)
        CrossCoreWaitFlag<2>(9);
}

struct NdManualPlan {
    uint32_t k, n, e, cores;
};

static_assert(sizeof(NdManualPlan) == 16, "manual runtime metadata");

struct NdCompactCursor {
    uint32_t nTiles, expert, start, end, sequence;
    uint64_t position, limit, base, groupLimit;
    bool loaded;

    template <class Ends>
    __aicore__ inline void Init(const Ends &ends, const NdManualPlan &p, uint32_t core) {
        nTiles = (p.n + 255) / 256;
        uint64_t total = 0;
        uint32_t previous = 0;
        for (uint32_t e = 0; e < p.e; e++) {
            uint32_t finish = static_cast<uint32_t>(ends.GetValue(e));
            total += (uint64_t(finish - previous) + 63) / 64 * nTiles;
            previous = finish;
        }
        position = total * core / p.cores;
        limit = total * (core + 1) / p.cores;
        expert = 0;
        start = 0;
        end = 0;
        sequence = 0;
        base = 0;
        groupLimit = 0;
        loaded = false;
    }

    template <class Ends>
    __aicore__ inline bool Next(const Ends &ends, const NdManualPlan &p, CubePrefetchTask &task) {
        if (position >= limit)
            return false;
        while (!loaded || position >= groupLimit) {
            if (loaded) {
                start = end;
                base = groupLimit;
                expert++;
            }
            if (expert >= p.e)
                return false;
            end = static_cast<uint32_t>(ends.GetValue(expert));
            groupLimit = base + (uint64_t(end - start) + 63) / 64 * nTiles;
            loaded = true;
        }
        const uint64_t local = position - base;
        task.expert = expert;
        task.row = start + local / nTiles * 64;
        task.rows = end - task.row < 64 ? end - task.row : 64;
        task.col = local % nTiles * 256;
        task.sequence = sequence++;
        position++;
        return true;
    }
};

template <typename Q>
__aicore__ inline void PrefetchNdCompactA(Q &aq,
                                          const CubePrefetchTask &t,
                                          const GlobalTensor<int8_t> &a,
                                          const NdManualPlan &p) {
    auto local = aq.template AllocTensor<int8_t>();
    Nd2NzParams cp{};
    cp.ndNum = 1;
    cp.nValue = t.rows;
    cp.dValue = p.k;
    cp.srcDValue = p.k;
    cp.dstNzC0Stride = NzPackedRows(t.rows);
    cp.dstNzNStride = 1;
    DataCopy(local, a[uint64_t(t.row) * p.k], cp);
    aq.EnQue(local);
}

template <typename Q>
__aicore__ inline void PrefetchNdCompactB(Q &bq,
                                          const CubePrefetchTask &t,
                                          uint32_t start,
                                          const GlobalTensor<int8_t> &b,
                                          const NdManualPlan &p) {
    constexpr uint32_t TN = 256, STAGE = 512;
    const uint32_t cols = p.n - t.col < TN ? p.n - t.col : TN, np = (cols + 31) / 32 * 32;
    const uint32_t slice = p.k - start < STAGE ? p.k - start : STAGE;
    auto local = bq.template AllocTensor<int8_t>();
    Nd2NzParams cp{};
    cp.ndNum = 1;
    cp.nValue = slice;
    cp.dValue = cols;
    cp.srcDValue = p.n;
    cp.dstNzC0Stride = slice;
    cp.dstNzNStride = 1;
    DataCopy(local, b[(uint64_t(t.expert) * p.k + start) * p.n + t.col], cp);
    bq.EnQue(local);
}

__aicore__ inline void
CubeNdCompact(GM_ADDR x, GM_ADDR weight, GM_ADDR groups, GM_ADDR workspace, const NdManualPlan &p) {
    constexpr uint32_t TM = ND64_TM, TN = ND64_TN, CS = TM * TN, STAGE = ND64_STAGE,
                       STEP = ND64_STEP;
    static_assert(2 * TM * ND64_CAPACITY + 2 * TN * STAGE == 512 * 1024,
                  "double full-A and sliced-B L1 budget");
    static_assert(2 * TM * STEP <= 64 * 1024 && 2 * TN * STEP <= 64 * 1024 &&
                      2 * CS * 4 <= 128 * 1024,
                  "double L0 input and output budgets");
    static_assert(5 * (8192 * 4 + 256) + 8192 * 2 + TN * 4 + 8192 / 8 + 128 * 8 <= 192 * 1024,
                  "original generic Vector64x256 UB budget");
    TPipe pipe;
    TQue<TPosition::A1, 2> aq;
    TQue<TPosition::B1, 2> bq;
    TQue<TPosition::A2, 2> a2q;
    TQue<TPosition::B2, 2> b2q;
    TQue<TPosition::CO1, 2> cq;
    pipe.InitBuffer(aq, 2, TM * ND64_CAPACITY);
    pipe.InitBuffer(bq, 2, TN * STAGE);
    pipe.InitBuffer(a2q, 2, TM * STEP);
    pipe.InitBuffer(b2q, 2, TN * STEP);
    pipe.InitBuffer(cq, 2, CS * 4);
    GlobalTensor<int8_t> a, b;
    GlobalTensor<int64_t> ends;
    GlobalTensor<int32_t> ring;
    a.SetGlobalBuffer((__gm__ int8_t *)x);
    b.SetGlobalBuffer((__gm__ int8_t *)weight);
    ends.SetGlobalBuffer((__gm__ int64_t *)groups);
    ring.SetGlobalBuffer((__gm__ int32_t *)workspace);
    const uint32_t core = GetBlockIdx();
    uint32_t completed = 0;
    NdCompactCursor cursor;
    cursor.Init(ends, p, core);
    CubePrefetchTask task{}, next{};
    bool available = cursor.Next(ends, p, task);
    if (available) {
        PrefetchNdCompactA(aq, task, a, p);
        PrefetchNdCompactB(bq, task, 0, b, p);
    }
    bool held = false;
    LocalTensor<int8_t> al;
    while (available) {
        if (!held)
            al = aq.DeQue<int8_t>();
        const bool more = cursor.Next(ends, p, next);
        const bool reuse = more && SameNdInputRows(task, next);
        auto c = cq.AllocTensor<int32_t>();
        const uint32_t mpad = NzPackedRows(task.rows),
                       cols = p.n - task.col < TN ? p.n - task.col : TN;
        const uint32_t npad = (cols + 31) / 32 * 32;
        constexpr uint32_t stepK = STEP;
        for (uint32_t start = 0; start < p.k; start += STAGE) {
            const uint32_t slice = p.k - start < STAGE ? p.k - start : STAGE;
            auto bl = bq.DeQue<int8_t>();
            if (start + slice < p.k)
                PrefetchNdCompactB(bq, task, start + slice, b, p);
            else if (more) {
                PrefetchNdCompactB(bq, next, 0, b, p);
            }
            // Queue the B stage required next before advancing next-task A.
            // The alternate A1 slot retains its existing queue reuse fence.
            if (start == 0 && more && !reuse)
                PrefetchNdCompactA(aq, next, a, p);
            for (uint32_t local = 0; local < slice; local += stepK) {
                const uint32_t inner = slice - local < stepK ? slice - local : stepK,
                               global = start + local;
                auto a2 = a2q.AllocTensor<int8_t>();
                auto b2 = b2q.AllocTensor<int8_t>();
                LoadData2DParams la{};
                la.ifTranspose = false;
                if (inner / 32 < mpad / 16) {
                    la.repeatTimes = mpad / 16;
                    la.srcStride = 1;
                    la.dstGap = inner / 32 - 1;
                    for (uint32_t kb = 0; kb < inner / 32; kb++)
                        LoadData(a2[kb * 512], al[(global + kb * 32) * mpad], la);
                } else {
                    la.repeatTimes = inner / 32;
                    la.srcStride = mpad / 16;
                    for (uint32_t mb = 0; mb < mpad / 16; mb++)
                        LoadData(a2[mb * inner * 16], al[global * mpad + mb * 512], la);
                }
                LoadData2dTransposeParams lb{};
                lb.dstFracGap = 0;
                if (inner > npad) {
                    lb.repeatTimes = inner / 32;
                    lb.srcStride = 1;
                    lb.dstGap = npad / 16 - 1;
                    for (uint32_t nb = 0; nb < npad / 32; nb++)
                        LoadDataWithTranspose(b2[nb * 1024], bl[local * 32 + nb * slice * 32], lb);
                } else {
                    lb.repeatTimes = npad / 32;
                    lb.srcStride = slice / 32;
                    lb.dstGap = 1;
                    for (uint32_t kb = 0; kb < inner / 32; kb++)
                        LoadDataWithTranspose(b2[kb * npad * 32], bl[(local + kb * 32) * 32], lb);
                }
                a2q.EnQue(a2);
                b2q.EnQue(b2);
                a2 = a2q.DeQue<int8_t>();
                b2 = b2q.DeQue<int8_t>();
                MmadParams mm{};
                mm.m = mpad;
                mm.n = npad;
                mm.k = inner;
                mm.cmatrixInitVal = global == 0;
                Mmad(c, a2, b2, mm);
                if ((mpad / 16) * (npad / 16) < 10)
                    PipeBarrier<PIPE_M>();
                a2q.FreeTensor(a2);
                b2q.FreeTensor(b2);
            }
            bq.FreeTensor(bl);
        }
        if (!reuse)
            aq.FreeTensor(al);
        cq.EnQue(c);
        c = cq.DeQue<int32_t>();
        if (task.sequence >= 2)
            CrossCoreWaitFlag<2>(9);
        FixpipeParamsV220 fp{};
        fp.nSize = npad;
        fp.mSize = task.rows;
        fp.srcStride = mpad;
        fp.dstStride = TN;
        fp.ndNum = 1;
        Fixpipe(ring[(core * 2 + task.sequence % 2) * CS], c, fp);
        CrossCoreSetFlag<2, PIPE_FIX>(8);
        cq.FreeTensor(c);
        ++completed;
        held = reuse;
        if (more)
            task = next;
        available = more;
    }
    for (uint32_t i = 0; i < (completed < 2 ? completed : 2); i++)
        CrossCoreWaitFlag<2>(9);
}

__aicore__ inline void CubeNd64A2Resident(
    GM_ADDR x, GM_ADDR weight, GM_ADDR groups, GM_ADDR workspace, const NdManualPlan &p) {
    constexpr uint32_t TM = ND64_TM, TN = ND64_TN, CS = TM * TN, STAGE = ND64_STAGE,
                       STEP = ND64_STEP;
    static_assert(2 * TM * ND64_CAPACITY + 2 * TN * STAGE == 512 * 1024,
                  "double full-A and sliced-B L1 budget");
    static_assert(2 * TM * STEP <= 64 * 1024 && 2 * TN * STEP <= 64 * 1024 &&
                      2 * CS * 4 <= 128 * 1024,
                  "double L0 input and output budgets");
    static_assert(5 * (8192 * 4 + 256) + 8192 * 2 + TN * 4 + 8192 / 8 + 128 * 8 <= 192 * 1024,
                  "original generic Vector64x256 UB budget");
    TPipe pipe;
    TQue<TPosition::A1, 2> aq;
    TQue<TPosition::B1, 2> bq;
    TBuf<TPosition::A2> residentAB;
    TQue<TPosition::B2, 2> b2q;
    TQue<TPosition::CO1, 2> cq;
    pipe.InitBuffer(aq, 2, TM * ND64_CAPACITY);
    pipe.InitBuffer(bq, 2, TN * STAGE);
    pipe.InitBuffer(residentAB, 64 * 1024);
    auto residentA = residentAB.Get<int8_t>();
    pipe.InitBuffer(b2q, 2, TN * STEP);
    pipe.InitBuffer(cq, 2, CS * 4);
    GlobalTensor<int8_t> a, b;
    GlobalTensor<int64_t> ends;
    GlobalTensor<int32_t> ring;
    a.SetGlobalBuffer((__gm__ int8_t *)x);
    b.SetGlobalBuffer((__gm__ int8_t *)weight);
    ends.SetGlobalBuffer((__gm__ int64_t *)groups);
    ring.SetGlobalBuffer((__gm__ int32_t *)workspace);
    const uint32_t core = GetBlockIdx();
    uint32_t completed = 0;
    NdCompactCursor cursor;
    cursor.Init(ends, p, core);
    CubePrefetchTask task{}, next{};
    bool available = cursor.Next(ends, p, task);
    if (available) {
        PrefetchNdCompactA(aq, task, a, p);
        PrefetchNdCompactB(bq, task, 0, b, p);
    }
    bool held = false;
    LocalTensor<int8_t> al;
    while (available) {
        if (!held)
            al = aq.DeQue<int8_t>();
        const bool more = cursor.Next(ends, p, next);
        const bool reuse = more && SameNdInputRows(task, next);
        auto c = cq.AllocTensor<int32_t>();
        const uint32_t mpad = NzPackedRows(task.rows),
                       cols = p.n - task.col < TN ? p.n - task.col : TN;
        const uint32_t npad = (cols + 31) / 32 * 32;
        if (!held) {
            Sync<HardEvent::M_MTE1>(pipe);
            for (uint32_t global = 0; global < p.k; global += STEP) {
                const uint32_t inner = p.k - global < STEP ? p.k - global : STEP;
                auto a2 = residentA[global * mpad];
                LoadData2DParams la{};
                la.ifTranspose = false;
                if (inner / 32 < mpad / 16) {
                    la.repeatTimes = mpad / 16;
                    la.srcStride = 1;
                    la.dstGap = inner / 32 - 1;
                    for (uint32_t kb = 0; kb < inner / 32; kb++)
                        LoadData(a2[kb * 512], al[(global + kb * 32) * mpad], la);
                } else {
                    la.repeatTimes = inner / 32;
                    la.srcStride = mpad / 16;
                    for (uint32_t mb = 0; mb < mpad / 16; mb++)
                        LoadData(a2[mb * inner * 16], al[global * mpad + mb * 512], la);
                }
            }
            Sync<HardEvent::MTE1_M>(pipe);
        }
        constexpr uint32_t stepK = STEP;
        for (uint32_t start = 0; start < p.k; start += STAGE) {
            const uint32_t slice = p.k - start < STAGE ? p.k - start : STAGE;
            auto bl = bq.DeQue<int8_t>();
            if (start + slice < p.k)
                PrefetchNdCompactB(bq, task, start + slice, b, p);
            else if (more) {
                PrefetchNdCompactB(bq, next, 0, b, p);
            }
            // Queue the B stage required next before advancing next-task A.
            // The alternate A1 slot retains its existing queue reuse fence.
            if (start == 0 && more && !reuse)
                PrefetchNdCompactA(aq, next, a, p);
            for (uint32_t local = 0; local < slice; local += stepK) {
                const uint32_t inner = slice - local < stepK ? slice - local : stepK,
                               global = start + local;
                auto a2 = residentA[global * mpad];
                auto b2 = b2q.AllocTensor<int8_t>();
                LoadData2dTransposeParams lb{};
                lb.dstFracGap = 0;
                if (inner > npad) {
                    lb.repeatTimes = inner / 32;
                    lb.srcStride = 1;
                    lb.dstGap = npad / 16 - 1;
                    for (uint32_t nb = 0; nb < npad / 32; nb++)
                        LoadDataWithTranspose(b2[nb * 1024], bl[local * 32 + nb * slice * 32], lb);
                } else {
                    lb.repeatTimes = npad / 32;
                    lb.srcStride = slice / 32;
                    lb.dstGap = 1;
                    for (uint32_t kb = 0; kb < inner / 32; kb++)
                        LoadDataWithTranspose(b2[kb * npad * 32], bl[(local + kb * 32) * 32], lb);
                }
                b2q.EnQue(b2);
                b2 = b2q.DeQue<int8_t>();
                MmadParams mm{};
                mm.m = mpad;
                mm.n = npad;
                mm.k = inner;
                mm.cmatrixInitVal = global == 0;
                Mmad(c, a2, b2, mm);
                if ((mpad / 16) * (npad / 16) < 10)
                    PipeBarrier<PIPE_M>();
                b2q.FreeTensor(b2);
            }
            bq.FreeTensor(bl);
        }
        if (!reuse)
            aq.FreeTensor(al);
        cq.EnQue(c);
        c = cq.DeQue<int32_t>();
        if (task.sequence >= 2)
            CrossCoreWaitFlag<2>(9);
        FixpipeParamsV220 fp{};
        fp.nSize = npad;
        fp.mSize = task.rows;
        fp.srcStride = mpad;
        fp.dstStride = TN;
        fp.ndNum = 1;
        Fixpipe(ring[(core * 2 + task.sequence % 2) * CS], c, fp);
        CrossCoreSetFlag<2, PIPE_FIX>(8);
        cq.FreeTensor(c);
        ++completed;
        held = reuse;
        if (more)
            task = next;
        available = more;
    }
    for (uint32_t i = 0; i < (completed < 2 ? completed : 2); i++)
        CrossCoreWaitFlag<2>(9);
}

__aicore__ inline void VectorNdCompact(
    GM_ADDR scale, GM_ADDR groups, GM_ADDR y, GM_ADDR workspace, const NdManualPlan &p) {
    constexpr uint32_t TM = 64, TN = 256;
    const uint32_t n = p.n;
    constexpr uint32_t CS = TM * TN, VS = CS > 8192 ? 8192 : CS, VR = VS / TN;
    TPipe pipe;
    TBuf<TPosition::VECCALC> rawB, zB, innerB, denB, numB, halfB, scaleB, maskB, groupB;
    pipe.InitBuffer(rawB, VS * 4 + 256);
    pipe.InitBuffer(zB, VS * 4 + 256);
    pipe.InitBuffer(innerB, VS * 4 + 256);
    pipe.InitBuffer(denB, VS * 4 + 256);
    pipe.InitBuffer(numB, VS * 4 + 256);
    pipe.InitBuffer(halfB, VS * 2);
    pipe.InitBuffer(scaleB, TN * 4);
    pipe.InitBuffer(maskB, VS / 8);
    pipe.InitBuffer(groupB, 128 * 8);
    auto raw = rawB.Get<int32_t>();
    auto z = zB.Get<float>();
    auto inner = innerB.Get<float>();
    auto den = denB.Get<float>();
    auto num = numB.Get<float>();
    auto result = halfB.Get<half>();
    auto coeff = scaleB.Get<float>();
    auto mask = maskB.Get<uint8_t>();
    auto localEnds = groupB.Get<int64_t>();
    GlobalTensor<int32_t> ring;
    GlobalTensor<float> sg;
    GlobalTensor<half> out;
    GlobalTensor<int64_t> ends;
    ring.SetGlobalBuffer((__gm__ int32_t *)workspace);
    sg.SetGlobalBuffer((__gm__ float *)scale);
    out.SetGlobalBuffer((__gm__ half *)y);
    ends.SetGlobalBuffer((__gm__ int64_t *)groups);
    DataCopyExtParams gcp{1, p.e * 8U, 0, 0, 0};
    DataCopyPadExtParams<int64_t> gp{false, 0, 0, 0};
    DataCopyPad(localEnds, ends, gcp, gp);
    Sync<HardEvent::MTE2_S>(pipe);
    uint32_t core = GetBlockIdx() / 2;
    NdCompactCursor cursor;
    cursor.Init(localEnds, p, core);
    CubePrefetchTask task{};
    while (cursor.Next(localEnds, p, task)) {
        uint32_t sequence = task.sequence, e = task.expert, row = task.row, col = task.col;
        uint32_t totalRows = task.rows, cols = n - col < TN ? n - col : TN;
        uint32_t aligned = (cols + 7) / 8 * 8;
        CrossCoreWaitFlag<2>(8);
        uint32_t halfRows = (totalRows + 1) / 2;
        uint32_t subStart = GetSubBlockIdx() * halfRows;
        uint32_t subEnd = subStart + halfRows < totalRows ? subStart + halfRows : totalRows;
        if (subStart >= subEnd)
            CrossCoreSetFlag<2, PIPE_MTE2>(9);
        for (uint32_t vrow = subStart; vrow < subEnd; vrow += VR) {
            uint32_t rows = subEnd - vrow < VR ? subEnd - vrow : VR;
            if (cols < TN)
                Duplicate(raw, 0, VS);
            Sync<HardEvent::V_MTE2>(pipe);
            DataCopyExtParams cp{
                static_cast<uint16_t>(rows), cols * 4U, (TN - cols) * 4U, (TN - aligned) / 8, 0};
            DataCopyPadExtParams<int32_t> pad{true, 0, static_cast<uint8_t>(aligned - cols), 0};
            DataCopyPad(raw, ring[(core * 2 + sequence % 2) * CS + vrow * TN], cp, pad);
            DataCopyExtParams scp{1, cols * 4U, 0, 0, 0};
            DataCopyPadExtParams<float> sp{true, 0, static_cast<uint8_t>(aligned - cols), 0.0f};
            if (vrow == subStart)
                DataCopyPad(coeff, sg[uint64_t(e) * n + col], scp, sp);
            if (vrow + rows == subEnd)
                CrossCoreSetFlag<2, PIPE_MTE2>(9);
            Sync<HardEvent::MTE2_V>(pipe);
            Cast(z, raw, RoundMode::CAST_NONE, rows * TN);
            PipeBarrier<PIPE_V>();
            for (uint32_t off = 0; off < cols; off += 64) {
                Mul(z[off],
                    z[off],
                    coeff[off],
                    cols - off < 64 ? cols - off : 64,
                    rows,
                    {1, 1, 1, TN / 8, TN / 8, 0});
            }
            PipeBarrier<PIPE_V>();
            // Copied padding is zero, so the entire aligned tile is initialized.
            uint32_t count = rows * TN;
            // Algebraically equivalent z/(1+exp(-2*p(z))). FP32 throughout.
            Mul(inner, z, z, count);
            PipeBarrier<PIPE_V>();
            Muls(inner, inner, -0.07135481627330025f, count);
            PipeBarrier<PIPE_V>();
            Adds(inner, inner, -1.5957691216057308f, count);
            PipeBarrier<PIPE_V>();
            Mul(inner, inner, z, count);
            PipeBarrier<PIPE_V>();
            Exp(inner, inner, count);
            PipeBarrier<PIPE_V>();
            Adds(inner, inner, 1.0f, count);
            PipeBarrier<PIPE_V>();
            Div(z, z, inner, count);
            PipeBarrier<PIPE_V>();
            Cast(result, z, RoundMode::CAST_RINT, rows * TN);
            Sync<HardEvent::V_MTE3>(pipe);
            uint32_t ah = (cols + 15) / 16 * 16;
            DataCopyExtParams ocp{
                static_cast<uint16_t>(rows), cols * 2U, (TN - ah) / 16, (n - cols) * 2U, 0};
            DataCopyPad(out[uint64_t(row + vrow) * n + col], result, ocp);
            Sync<HardEvent::MTE3_V>(pipe);
        }
    }
}

__global__ __aicore__ void Nd64DoubleCKernel(GM_ADDR x,
                                             GM_ADDR w,
                                             GM_ADDR scale,
                                             GM_ADDR groups,
                                             GM_ADDR y,
                                             GM_ADDR workspace,
                                             NdManualPlan p) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
    if ASCEND_IS_AIC {
        if (uint64_t(p.k) * ND64_TM <= 64 * 1024)
            CubeNd64A2Resident(x, w, groups, workspace, p);
        else
            CubeNdCompact(x, w, groups, workspace, p);
    } else {
        VectorNdCompact(scale, groups, y, workspace, p);
    }
}

template <uint32_t TM>
struct ShortPacketRowCursor {
    uint32_t expert, row, limit, groupEnd, sequence;

    template <class Ends>
    __aicore__ inline void Init(const Ends &ends, const Plan &p, uint32_t core) {
        const uint32_t blocks = (p.m + TM - 1) / TM;
        row = uint64_t(blocks) * core / p.cores * TM;
        limit = uint64_t(blocks) * (core + 1) / p.cores * TM;
        if (limit > p.m)
            limit = p.m;
        uint32_t lo = 0, hi = p.e;
        while (lo < hi) {
            const uint32_t mid = (lo + hi) / 2;
            if (static_cast<uint32_t>(ends.GetValue(mid)) <= row)
                lo = mid + 1;
            else
                hi = mid;
        }
        expert = lo;
        groupEnd = expert < p.e ? static_cast<uint32_t>(ends.GetValue(expert)) : p.m;
        sequence = 0;
    }

    template <class Ends, class Task>
    __aicore__ inline bool Next(const Ends &ends, const Plan &p, Task &t) {
        if (row >= limit)
            return false;
        while (expert < p.e && row >= groupEnd) {
            ++expert;
            if (expert < p.e)
                groupEnd = static_cast<uint32_t>(ends.GetValue(expert));
        }
        if (expert >= p.e)
            return false;
        uint32_t rows = groupEnd - row;
        if (rows > limit - row)
            rows = limit - row;
        if (rows > TM)
            rows = TM;
        t.expert = expert;
        t.row = row;
        t.rows = rows;
        t.col = 0;
        t.sequence = sequence++;
        row += rows;
        return true;
    }
};

template <uint32_t TM, uint32_t TN, bool NZ, uint32_t SK>
__aicore__ inline void
CubeShortCarry(GM_ADDR x, GM_ADDR w, GM_ADDR groups, GM_ADDR workspace, const Plan &p) {
    constexpr uint32_t CS = TM * TN;
    const uint32_t k = p.k, n = p.n, wn = p.wn, ka = NZ ? p.ka : p.k;
    TPipe pipe;
    using A = MatmulType<TPosition::GM, CubeFormat::ND, int8_t, false>;
    using B = MatmulType<TPosition::GM, NZ ? CubeFormat::NZ : CubeFormat::ND, int8_t, false>;
    using C = MatmulType<TPosition::GM, CubeFormat::ND, int32_t>;
    Matmul<A, B, C, C, STATIC_CFG<TM, TN, NZ, SK>> mm;
    mm.Init(SK ? nullptr : &p.cube, &pipe);
    mm.SetOrgShape(p.m, wn, ka, k, TN);
    GlobalTensor<int8_t> a, b;
    GlobalTensor<int64_t> ends;
    GlobalTensor<int32_t> ring;
    a.SetGlobalBuffer((__gm__ int8_t *)x);
    b.SetGlobalBuffer((__gm__ int8_t *)w);
    ends.SetGlobalBuffer((__gm__ int64_t *)groups);
    ring.SetGlobalBuffer((__gm__ int32_t *)workspace);
    constexpr uint32_t nt = 1; // Entire admitted Short N fits the existing TN frame.
    uint32_t core = GetBlockIdx(), sequence = 0, start = 0, nextTask = core;
    for (uint32_t e = 0; e < p.e; e++) {
        uint32_t end = static_cast<uint32_t>(ends.GetValue(e));
        uint32_t mt = (end - start + TM - 1) / TM, tasks = mt * nt;
        for (; nextTask < tasks; nextTask += p.cores, sequence++) {
            const uint32_t task = nextTask;
            uint32_t row = start + task / nt * TM, col = task % nt * TN;
            uint32_t rows = end - row < TM ? end - row : TM, cols = n - col < TN ? n - col : TN;
            mm.SetTail(rows, cols, ka);
            mm.SetTensorA(a[uint64_t(row) * ka], false);
            mm.SetTensorB(b[uint64_t(e) * k * wn + (NZ ? uint64_t(col) * k : col)], false);
            mm.Iterate();
            if (sequence >= 2)
                CrossCoreWaitFlag<2>(9);
            mm.GetTensorC(ring[(core * 2 + sequence % 2) * CS]);
            CrossCoreSetFlag<2, PIPE_FIX>(8);
        }
        nextTask -= tasks;
        start = end;
    }
    for (uint32_t i = 0; i < (sequence < 2 ? sequence : 2); i++)
        CrossCoreWaitFlag<2>(9);
    mm.End();
}

template <uint32_t TM, uint32_t TN>
__aicore__ inline void
VectorShortCarry(GM_ADDR scale, GM_ADDR groups, GM_ADDR y, GM_ADDR workspace, const Plan &p) {
    InitSocState();
    const uint32_t n = p.n;
    constexpr uint32_t CS = TM * TN, VS = CS > 8192 ? 8192 : CS, VR = VS / TN;
    constexpr uint32_t RAW = 0, RAW_WORDS = VS + 64;
    constexpr uint32_t Z = RAW + 2 * RAW_WORDS * 4;
    constexpr uint32_t INNER = Z + VS * 4 + 256;
    constexpr uint32_t HALF = INNER + VS * 4 + 256;
    constexpr uint32_t SCALE = HALF + 2 * VS * 2;
    constexpr uint32_t GROUP = SCALE + 2 * TN * 4;
    constexpr uint32_t END = GROUP + 128 * 8;
    static_assert(END <= 192 * 1024, "Short asynchronous static UB capacity");
    LocalTensor<int32_t> rawSpace(TPosition::VECCALC, RAW, 2 * RAW_WORDS);
    LocalTensor<float> z(TPosition::VECCALC, Z, VS + 64);
    LocalTensor<float> inner(TPosition::VECCALC, INNER, VS + 64);
    LocalTensor<half> resultSpace(TPosition::VECCALC, HALF, 2 * VS);
    LocalTensor<float> coeffSpace(TPosition::VECCALC, SCALE, 2 * TN);
    LocalTensor<int64_t> localEnds(TPosition::VECCALC, GROUP, 128);
    // Independent local free/ready events0/1; original ring8/9 stays task based.
    GlobalTensor<int32_t> ring;
    GlobalTensor<float> sg;
    GlobalTensor<half> out;
    GlobalTensor<int64_t> ends;
    ring.SetGlobalBuffer((__gm__ int32_t *)workspace);
    sg.SetGlobalBuffer((__gm__ float *)scale);
    out.SetGlobalBuffer((__gm__ half *)y);
    ends.SetGlobalBuffer((__gm__ int64_t *)groups);
    DataCopyExtParams gcp{1, p.e * 8U, 0, 0, 0};
    DataCopyPadExtParams<int64_t> gp{false, 0, 0, 0};
    DataCopyPad(localEnds, ends, gcp, gp);
    SetFlag<HardEvent::MTE2_S>(0);
    WaitFlag<HardEvent::MTE2_S>(0);
    // ASYNC_SEED_BEGIN
    // Raw padding is never written by Vector after initialization.
    if (n < TN) {
        Duplicate(rawSpace, 0, VS);
        Duplicate(rawSpace[RAW_WORDS], 0, VS);
    }
    for (uint32_t i = 0; i < 2; i++) {
        SetFlag<HardEvent::V_MTE2>(i);
        SetFlag<HardEvent::MTE3_V>(i);
    }
    // ASYNC_SEED_END
    uint32_t chunkSequence = 0;
    constexpr uint32_t nt = 1; // Entire admitted Short N fits the existing TN frame.
    uint32_t core = GetBlockIdx() / 2, sequence = 0, start = 0, nextTask = core;
    for (uint32_t e = 0; e < p.e; e++) {
        uint32_t end = static_cast<uint32_t>(localEnds.GetValue(e));
        uint32_t mt = (end - start + TM - 1) / TM, tasks = mt * nt;
        for (; nextTask < tasks; nextTask += p.cores, sequence++) {
            const uint32_t task = nextTask;
            uint32_t row = start + task / nt * TM, col = task % nt * TN;
            uint32_t totalRows = end - row < TM ? end - row : TM,
                     cols = n - col < TN ? n - col : TN;
            uint32_t aligned = (cols + 7) / 8 * 8;
            CrossCoreWaitFlag<2>(8);
            uint32_t halfRows = (totalRows + 1) / 2;
            uint32_t subStart = GetSubBlockIdx() * halfRows;
            uint32_t subEnd = subStart + halfRows < totalRows ? subStart + halfRows : totalRows;
            if (subStart >= subEnd)
                CrossCoreSetFlag<2, PIPE_MTE2>(9);
            for (uint32_t vrow = subStart; vrow < subEnd; vrow += VR) {
                uint32_t rows = subEnd - vrow < VR ? subEnd - vrow : VR;
                // ASYNC_CHUNK_BEGIN
                const uint32_t slot = chunkSequence++ % 2;
                auto raw = rawSpace[slot * RAW_WORDS];
                auto result = resultSpace[slot * VS];
                auto coeff = coeffSpace[slot * TN];
                WaitFlag<HardEvent::V_MTE2>(slot);
                DataCopyExtParams cp{static_cast<uint16_t>(rows),
                                     cols * 4U,
                                     (TN - cols) * 4U,
                                     (TN - aligned) / 8,
                                     0};
                DataCopyPadExtParams<int32_t> pad{true, 0, static_cast<uint8_t>(aligned - cols), 0};
                DataCopyPad(raw, ring[(core * 2 + sequence % 2) * CS + vrow * TN], cp, pad);
                DataCopyExtParams scp{1, cols * 4U, 0, 0, 0};
                DataCopyPadExtParams<float> sp{true, 0, static_cast<uint8_t>(aligned - cols), 0.0f};
                DataCopyPad(coeff, sg[uint64_t(e) * n + col], scp, sp);
                if (vrow + rows == subEnd)
                    CrossCoreSetFlag<2, PIPE_MTE2>(9);
                SetFlag<HardEvent::MTE2_V>(slot);
                WaitFlag<HardEvent::MTE2_V>(slot);
                Cast(z, raw, RoundMode::CAST_NONE, rows * TN);
                PipeBarrier<PIPE_V>();
                for (uint32_t off = 0; off < cols; off += 64) {
                    Mul(z[off],
                        z[off],
                        coeff[off],
                        cols - off < 64 ? cols - off : 64,
                        rows,
                        {1, 1, 1, TN / 8, TN / 8, 0});
                }
                PipeBarrier<PIPE_V>();
                SetFlag<HardEvent::V_MTE2>(slot);
                // Copied padding is zero, so the entire aligned tile is initialized.
                uint32_t count = rows * TN;
                // Algebraically equivalent z/(1+exp(-2*p(z))). FP32 throughout.
                Mul(inner, z, z, count);
                PipeBarrier<PIPE_V>();
                Muls(inner, inner, -0.07135481627330025f, count);
                PipeBarrier<PIPE_V>();
                Adds(inner, inner, -1.5957691216057308f, count);
                PipeBarrier<PIPE_V>();
                Mul(inner, inner, z, count);
                PipeBarrier<PIPE_V>();
                Exp(inner, inner, count);
                PipeBarrier<PIPE_V>();
                Adds(inner, inner, 1.0f, count);
                PipeBarrier<PIPE_V>();
                Div(z, z, inner, count);
                PipeBarrier<PIPE_V>();
                WaitFlag<HardEvent::MTE3_V>(slot);
                Cast(result, z, RoundMode::CAST_RINT, rows * TN);
                PipeBarrier<PIPE_V>();
                SetFlag<HardEvent::V_MTE3>(slot);
                WaitFlag<HardEvent::V_MTE3>(slot);
                uint32_t ah = (cols + 15) / 16 * 16;
                DataCopyExtParams ocp{
                    static_cast<uint16_t>(rows), cols * 2U, (TN - ah) / 16, (n - cols) * 2U, 0};
                DataCopyPad(out[uint64_t(row + vrow) * n + col], result, ocp);
                SetFlag<HardEvent::MTE3_V>(slot);
                // ASYNC_CHUNK_END
            }
        }
        nextTask -= tasks;
        start = end;
    }
    // ASYNC_DRAIN_BEGIN
    for (uint32_t i = 0; i < 2; i++) {
        WaitFlag<HardEvent::V_MTE2>(i);
        WaitFlag<HardEvent::MTE3_V>(i);
    }
    // ASYNC_DRAIN_END
    // Match the AIV TPipe destructor after all task and idle paths.
    PipeBarrier<PIPE_ALL>();
}

// Public queues fence every producer/consumer pair; two CO1 frames overlap Fixpipe/Mmad.

template <uint32_t TM, uint32_t TN>
__aicore__ inline void
VectorShortPacketRows(GM_ADDR scale, GM_ADDR groups, GM_ADDR y, GM_ADDR workspace, const Plan &p) {
    InitSocState();
    const uint32_t n = p.n;
    constexpr uint32_t CS = TM * TN, VS = CS > 8192 ? 8192 : CS, VR = VS / TN;
    constexpr uint32_t RAW = 0, RAW_WORDS = VS + 64;
    constexpr uint32_t Z = RAW + 2 * RAW_WORDS * 4;
    constexpr uint32_t INNER = Z + VS * 4 + 256;
    constexpr uint32_t HALF = INNER + VS * 4 + 256;
    constexpr uint32_t SCALE = HALF + 2 * VS * 2;
    constexpr uint32_t GROUP = SCALE + 2 * TN * 4;
    constexpr uint32_t END = GROUP + 128 * 8;
    static_assert(END <= 192 * 1024, "Short asynchronous static UB capacity");
    LocalTensor<int32_t> rawSpace(TPosition::VECCALC, RAW, 2 * RAW_WORDS);
    LocalTensor<float> z(TPosition::VECCALC, Z, VS + 64);
    LocalTensor<float> inner(TPosition::VECCALC, INNER, VS + 64);
    LocalTensor<half> resultSpace(TPosition::VECCALC, HALF, 2 * VS);
    LocalTensor<float> coeffSpace(TPosition::VECCALC, SCALE, 2 * TN);
    LocalTensor<int64_t> localEnds(TPosition::VECCALC, GROUP, 128);
    // Independent local free/ready events0/1; original ring8/9 stays task based.
    GlobalTensor<int32_t> ring;
    GlobalTensor<float> sg;
    GlobalTensor<half> out;
    GlobalTensor<int64_t> ends;
    ring.SetGlobalBuffer((__gm__ int32_t *)workspace);
    sg.SetGlobalBuffer((__gm__ float *)scale);
    out.SetGlobalBuffer((__gm__ half *)y);
    ends.SetGlobalBuffer((__gm__ int64_t *)groups);
    DataCopyExtParams gcp{1, p.e * 8U, 0, 0, 0};
    DataCopyPadExtParams<int64_t> gp{false, 0, 0, 0};
    DataCopyPad(localEnds, ends, gcp, gp);
    SetFlag<HardEvent::MTE2_S>(0);
    WaitFlag<HardEvent::MTE2_S>(0);
    // ASYNC_SEED_BEGIN
    // Raw padding is never written by Vector after initialization.
    if (n < TN) {
        Duplicate(rawSpace, 0, VS);
        Duplicate(rawSpace[RAW_WORDS], 0, VS);
    }
    for (uint32_t i = 0; i < 2; i++) {
        SetFlag<HardEvent::V_MTE2>(i);
        SetFlag<HardEvent::MTE3_V>(i);
    }
    // ASYNC_SEED_END
    uint32_t chunkSequence = 0;
    uint32_t core = GetBlockIdx() / 2, sequence = 0;
    ShortPacketRowCursor<TM> cursor;
    cursor.Init(localEnds, p, core);
    CubePrefetchTask task{};
    while (cursor.Next(localEnds, p, task)) {
        uint32_t e = task.expert, row = task.row, col = 0, end = row + task.rows;
        uint32_t totalRows = end - row < TM ? end - row : TM, cols = n - col < TN ? n - col : TN;
        uint32_t aligned = (cols + 7) / 8 * 8;
        CrossCoreWaitFlag<2>(8);
        uint32_t halfRows = (totalRows + 1) / 2;
        uint32_t subStart = GetSubBlockIdx() * halfRows;
        uint32_t subEnd = subStart + halfRows < totalRows ? subStart + halfRows : totalRows;
        if (subStart >= subEnd)
            CrossCoreSetFlag<2, PIPE_MTE2>(9);
        for (uint32_t vrow = subStart; vrow < subEnd; vrow += VR) {
            uint32_t rows = subEnd - vrow < VR ? subEnd - vrow : VR;
            // ASYNC_CHUNK_BEGIN
            const uint32_t slot = chunkSequence++ % 2;
            auto raw = rawSpace[slot * RAW_WORDS];
            auto result = resultSpace[slot * VS];
            auto coeff = coeffSpace[slot * TN];
            WaitFlag<HardEvent::V_MTE2>(slot);
            DataCopyExtParams cp{
                static_cast<uint16_t>(rows), cols * 4U, (TN - cols) * 4U, (TN - aligned) / 8, 0};
            DataCopyPadExtParams<int32_t> pad{true, 0, static_cast<uint8_t>(aligned - cols), 0};
            DataCopyPad(raw, ring[(core * 2 + sequence % 2) * CS + vrow * TN], cp, pad);
            DataCopyExtParams scp{1, cols * 4U, 0, 0, 0};
            DataCopyPadExtParams<float> sp{true, 0, static_cast<uint8_t>(aligned - cols), 0.0f};
            DataCopyPad(coeff, sg[uint64_t(e) * n + col], scp, sp);
            if (vrow + rows == subEnd)
                CrossCoreSetFlag<2, PIPE_MTE2>(9);
            SetFlag<HardEvent::MTE2_V>(slot);
            WaitFlag<HardEvent::MTE2_V>(slot);
            Cast(z, raw, RoundMode::CAST_NONE, rows * TN);
            PipeBarrier<PIPE_V>();
            for (uint32_t off = 0; off < cols; off += 64) {
                Mul(z[off],
                    z[off],
                    coeff[off],
                    cols - off < 64 ? cols - off : 64,
                    rows,
                    {1, 1, 1, TN / 8, TN / 8, 0});
            }
            PipeBarrier<PIPE_V>();
            SetFlag<HardEvent::V_MTE2>(slot);
            // Copied padding is zero, so the entire aligned tile is initialized.
            uint32_t count = rows * TN;
            // Algebraically equivalent z/(1+exp(-2*p(z))). FP32 throughout.
            Mul(inner, z, z, count);
            PipeBarrier<PIPE_V>();
            Muls(inner, inner, -0.07135481627330025f, count);
            PipeBarrier<PIPE_V>();
            Adds(inner, inner, -1.5957691216057308f, count);
            PipeBarrier<PIPE_V>();
            Mul(inner, inner, z, count);
            PipeBarrier<PIPE_V>();
            Exp(inner, inner, count);
            PipeBarrier<PIPE_V>();
            Adds(inner, inner, 1.0f, count);
            PipeBarrier<PIPE_V>();
            Div(z, z, inner, count);
            PipeBarrier<PIPE_V>();
            WaitFlag<HardEvent::MTE3_V>(slot);
            Cast(result, z, RoundMode::CAST_RINT, rows * TN);
            PipeBarrier<PIPE_V>();
            SetFlag<HardEvent::V_MTE3>(slot);
            WaitFlag<HardEvent::V_MTE3>(slot);
            uint32_t ah = (cols + 15) / 16 * 16;
            DataCopyExtParams ocp{
                static_cast<uint16_t>(rows), cols * 2U, (TN - ah) / 16, (n - cols) * 2U, 0};
            DataCopyPad(out[uint64_t(row + vrow) * n + col], result, ocp);
            SetFlag<HardEvent::MTE3_V>(slot);
            // ASYNC_CHUNK_END
        }
        ++sequence;
    }
    // ASYNC_DRAIN_BEGIN
    for (uint32_t i = 0; i < 2; i++) {
        WaitFlag<HardEvent::V_MTE2>(i);
        WaitFlag<HardEvent::MTE3_V>(i);
    }
    // ASYNC_DRAIN_END
    // Match the AIV TPipe destructor after all task and idle paths.
    PipeBarrier<PIPE_ALL>();
}

template <class AQ, class BQ>
__aicore__ inline void PrefetchShortPacket(AQ &aq,
                                           BQ &bq,
                                           const CubePrefetchTask &t,
                                           const GlobalTensor<int8_t> &x,
                                           const GlobalTensor<int8_t> &w,
                                           const Plan &p,
                                           bool loadB) {
    auto al = aq.template AllocTensor<int8_t>();
    Nd2NzParams ac{};
    ac.ndNum = 1;
    ac.nValue = t.rows;
    ac.dValue = p.k;
    ac.srcDValue = p.k;
    ac.dstNzC0Stride = NzPackedRows(t.rows);
    ac.dstNzNStride = 1;
    DataCopy(al, x[uint64_t(t.row) * p.k], ac);
    aq.EnQue(al);
    if (loadB) {
        auto bl = bq.template AllocTensor<int8_t>();
        Nd2NzParams bc{};
        bc.ndNum = 1;
        bc.nValue = p.k;
        bc.dValue = p.n;
        bc.srcDValue = p.n;
        bc.dstNzC0Stride = p.k;
        bc.dstNzNStride = 1;
        DataCopy(bl, w[uint64_t(t.expert) * p.k * p.n], bc);
        bq.EnQue(bl);
    }
}

__aicore__ inline void
ShortPacketPipeline(GM_ADDR x, GM_ADDR weight, GM_ADDR groups, GM_ADDR workspace, const Plan &p) {
    constexpr uint32_t TM = 64, TN = 256, KCAP = 256, CS = TM * TN;
    static_assert(2 * (TM + TN) * KCAP <= 512 * 1024, "Short L1 budget");
    static_assert(TM * KCAP <= 64 * 1024 && TN * KCAP <= 64 * 1024 && 2 * CS * 4 <= 128 * 1024,
                  "Short L0 budgets");
    TPipe pipe;
    TQue<TPosition::A1, 2> aq;
    TQue<TPosition::B1, 2> bq;
    TQue<TPosition::A2, 1> a2q;
    TQue<TPosition::B2, 1> b2q;
    TQue<TPosition::CO1, 2> cq;
    pipe.InitBuffer(aq, 2, TM * KCAP);
    pipe.InitBuffer(bq, 2, TN * KCAP);
    pipe.InitBuffer(a2q, 1, TM * KCAP);
    pipe.InitBuffer(b2q, 1, TN * KCAP);
    pipe.InitBuffer(cq, 2, CS * 4);
    GlobalTensor<int8_t> ag, bg;
    GlobalTensor<int64_t> ends;
    GlobalTensor<int32_t> ring;
    ag.SetGlobalBuffer((__gm__ int8_t *)x);
    bg.SetGlobalBuffer((__gm__ int8_t *)weight);
    ends.SetGlobalBuffer((__gm__ int64_t *)groups);
    ring.SetGlobalBuffer((__gm__ int32_t *)workspace);
    ShortPacketRowCursor<TM> cursor;
    cursor.Init(ends, p, GetBlockIdx());
    CubePrefetchTask task{}, next{};
    bool available = cursor.Next(ends, p, task), heldB = false;
    LocalTensor<int8_t> bl;
    uint32_t completed = 0;
    if (available)
        PrefetchShortPacket(aq, bq, task, ag, bg, p, true);
    while (available) {
        auto al = aq.DeQue<int8_t>();
        if (!heldB)
            bl = bq.DeQue<int8_t>();
        const bool more = cursor.Next(ends, p, next), reuseB = more && next.expert == task.expert;
        if (more)
            PrefetchShortPacket(aq, bq, next, ag, bg, p, !reuseB);
        auto a2 = a2q.AllocTensor<int8_t>();
        auto b2 = b2q.AllocTensor<int8_t>();
        auto c = cq.AllocTensor<int32_t>();
        const uint32_t mpad = NzPackedRows(task.rows), npad = (p.n + 31) / 32 * 32;
        LoadData2DParams la{};
        la.repeatTimes = p.k / 32;
        la.srcStride = mpad / 16;
        la.ifTranspose = false;
        for (uint32_t mb = 0; mb < mpad / 16; mb++)
            LoadData(a2[mb * p.k * 16], al[mb * 512], la);
        LoadData2dTransposeParams lb{};
        lb.repeatTimes = npad / 32;
        lb.srcStride = p.k / 32;
        lb.dstGap = 1;
        lb.dstFracGap = 0;
        for (uint32_t kb = 0; kb < p.k / 32; kb++)
            LoadDataWithTranspose(b2[kb * npad * 32], bl[kb * 1024], lb);
        a2q.EnQue(a2);
        b2q.EnQue(b2);
        a2 = a2q.DeQue<int8_t>();
        b2 = b2q.DeQue<int8_t>();
        aq.FreeTensor(al);
        if (!reuseB)
            bq.FreeTensor(bl);
        MmadParams mm{};
        mm.m = mpad;
        mm.n = npad;
        mm.k = p.k;
        mm.cmatrixInitVal = true;
        Mmad(c, a2, b2, mm);
        if ((mpad / 16) * (npad / 16) < 10)
            PipeBarrier<PIPE_M>();
        a2q.FreeTensor(a2);
        b2q.FreeTensor(b2);
        cq.EnQue(c);
        c = cq.DeQue<int32_t>();
        if (task.sequence >= 2)
            CrossCoreWaitFlag<2>(9);
        FixpipeParamsV220 fp{};
        fp.nSize = npad;
        fp.mSize = task.rows;
        fp.srcStride = mpad;
        fp.dstStride = TN;
        fp.ndNum = 1;
        Fixpipe(ring[(GetBlockIdx() * 2 + task.sequence % 2) * CS], c, fp);
        CrossCoreSetFlag<2, PIPE_FIX>(8);
        cq.FreeTensor(c);
        completed++;
        heldB = reuseB;
        if (more)
            task = next;
        available = more;
    }
    for (uint32_t i = 0; i < (completed < 2 ? completed : 2); i++)
        CrossCoreWaitFlag<2>(9);
}

template <uint32_t TM, uint32_t TN, bool NZ, uint32_t SK, bool MERGED>
__global__ __aicore__ void Kernel(GM_ADDR x,
                                  GM_ADDR w,
                                  GM_ADDR scale,
                                  GM_ADDR groups,
                                  GM_ADDR y,
                                  GM_ADDR workspace,
                                  GM_ADDR paddedWorkspace,
                                  Plan p) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
    if (NZ) {
        auto *ax = (__gm__ uint8_t *)paddedWorkspace;
        auto *aw = ax + uint64_t(p.m) * p.k;
        if ASCEND_IS_AIC {
            // Every expert is freshly packed once, independently of group contents.
            if constexpr (SK == 8192)
                PadWeightsNonemptyNativeRows<64, true>(
                    w, (GM_ADDR)aw, groups, p.rawK, p.n, p.e, p.k, p.wn);
            else
                PadWeightsNativeRows<64, true>(w, (GM_ADDR)aw, p.rawK, p.n, p.e, p.k, p.wn);
        }
        if ASCEND_IS_AIV {
            // Zero weight jobs in this helper; the original X path is unchanged.
            PadInputsCore(x, w, (GM_ADDR)ax, (GM_ADDR)aw, p.m, p.rawK, p.n, 0, p.k, p.wn, p.rawA);
        }
    }
    // Both preprocessing scopes have drained their stores and released TPipe.
    // All AIC W stores and AIV X stores precede the original matrix phase.
    if (NZ)
        SyncAll<false>();
    if ASCEND_IS_AIC {
        if (NZ) {
            auto *ax = (__gm__ uint8_t *)paddedWorkspace;
            auto *aw = ax + uint64_t(p.m) * p.k;
            if (!p.rawA)
                x = (GM_ADDR)ax;
            w = (GM_ADDR)aw;
        }
        if (MERGED && !NZ && SK == 2048 && TM == 64 && TN == 512)
            CubeWideRowsMerged(x, w, groups, workspace, p);
        else if (MERGED && !NZ && SK == 1024 && TM == 128 && TN == 256)
            CubeMergedCase2(x, w, groups, workspace, p);
        else if (MERGED && !NZ && SK == 2048 && TM == 128 && TN == 256)
            CubeNdLongRowShare(x, w, groups, workspace, p);
        else if constexpr (NZ && MERGED)
            CubeMergedNzStatic(x, w, groups, workspace, p);
        else if constexpr (!NZ && !MERGED && SK == 256 && TM == 64 && TN == 256)
            ShortPacketPipeline(x, w, groups, workspace, p);
        else if constexpr (!NZ && !MERGED && SK != 0 && uint64_t(TM) * SK <= 64 * 1024 &&
                           uint64_t(TN) * SK <= 64 * 1024)
            CubeShortCarry<TM, TN, NZ, SK>(x, w, groups, workspace, p);
        // Prefetch only when the bounded input packet is larger than the int32 output tile.
        // Small input packets retain the original Cube path to avoid queue overhead.
        else if constexpr (!NZ && !MERGED && SK != 0 && 2ULL * (TM + TN) * SK <= 512 * 1024 &&
                           uint64_t(TM + TN) * SK > uint64_t(TM) * TN * sizeof(int32_t))
            CubePrefetch<TM, TN, SK>(x, w, groups, workspace, p);
        else
            Cube<TM, TN, NZ, SK>(x, w, groups, workspace, p);
    } else {
        if (MERGED && !NZ && SK == 2048 && TM == 64 && TN == 512)
            VectorWideRowsMerged(scale, groups, y, workspace, p);
        else if (MERGED && !NZ && SK == 1024 && TM == 128 && TN == 256)
            VectorMergedCase2(scale, groups, y, workspace, p);
        else if (MERGED && !NZ && SK == 2048 && TM == 128 && TN == 256)
            VectorNdLongRowShare(scale, groups, y, workspace, p);
        else if constexpr (NZ && MERGED)
            VectorMergedNzA1(scale, groups, y, workspace, p);
        else if constexpr (!NZ && !MERGED && SK == 256 && TM == 64 && TN == 256)
            VectorShortPacketRows<TM, TN>(scale, groups, y, workspace, p);
        else if constexpr (!NZ && !MERGED && SK != 0 && uint64_t(TM) * SK <= 64 * 1024 &&
                           uint64_t(TN) * SK <= 64 * 1024)
            VectorShortCarry<TM, TN>(scale, groups, y, workspace, p);
        else if (SK == 2048 && TM == 64 && TN == 512)
            VectorFullChunk<TM, TN>(scale, groups, y, workspace, p);
        else
            VectorStatic<TM, TN>(scale, groups, y, workspace, p);
    }
}

// Materialize aligned ND rows once, instead of repeating unaligned ND->NZ
// transfers for every matrix tile. Padded K rows and columns are zero.

template <typename T>
__aicore__ inline void LoadSmall(LocalTensor<T> dst, GM_ADDR source, uint32_t count) {
    GlobalTensor<T> gm;
    gm.SetGlobalBuffer((__gm__ T *)source);
    DataCopyExtParams cp{1, count * static_cast<uint32_t>(sizeof(T)), 0, 0, 0};
    DataCopyPadExtParams<T> pad{false, 0, 0, 0};
    DataCopyPad(dst, gm, cp, pad);
}

__global__ __aicore__ void Tiny(GM_ADDR x,
                                GM_ADDR w,
                                GM_ADDR scale,
                                GM_ADDR groups,
                                GM_ADDR y,
                                uint32_t m,
                                uint32_t k,
                                uint32_t n,
                                uint32_t e) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    TPipe pipe;
    TBuf<TPosition::VECCALC> xb, wb, sb, gb, zb, ib, db, nb, hb, mb;
    pipe.InitBuffer(xb, 256);
    pipe.InitBuffer(wb, 32768);
    pipe.InitBuffer(sb, 8192);
    pipe.InitBuffer(gb, 1024);
    pipe.InitBuffer(zb, 1024);
    pipe.InitBuffer(ib, 1024);
    pipe.InitBuffer(db, 1024);
    pipe.InitBuffer(nb, 1024);
    pipe.InitBuffer(hb, 512);
    pipe.InitBuffer(mb, 256);
    auto lx = xb.Get<int8_t>();
    auto lw = wb.Get<int8_t>();
    auto ls = sb.Get<float>();
    auto lg = gb.Get<int64_t>();
    auto z = zb.Get<float>();
    auto inner = ib.Get<float>();
    auto den = db.Get<float>();
    auto num = nb.Get<float>();
    auto result = hb.Get<half>();
    auto mask = mb.Get<uint8_t>();
    uint32_t count = (m * n + 63) / 64 * 64;
    Duplicate(z, 0.0f, count);
    LoadSmall(lx, x, m * k);
    LoadSmall(lw, w, e * k * n);
    LoadSmall(ls, scale, e * n);
    LoadSmall(lg, groups, e);
    Sync<HardEvent::V_S>(pipe);
    Sync<HardEvent::MTE2_S>(pipe);
    uint32_t start = 0;
    for (uint32_t expert = 0; expert < e; expert++) {
        uint32_t end = lg.GetValue(expert);
        for (uint32_t row = start; row < end; row++) {
#pragma unroll
            for (uint32_t col = 0; col < n; col++) {
                int32_t acc = 0;
#pragma unroll
                for (uint32_t kk = 0; kk < k; kk++)
                    acc += static_cast<int32_t>(lx.GetValue(row * k + kk)) *
                           static_cast<int32_t>(lw.GetValue((expert * k + kk) * n + col));
                z.SetValue(row * n + col, static_cast<float>(acc) * ls.GetValue(expert * n + col));
            }
        }
        start = end;
        if (start == m)
            break;
    }
    Sync<HardEvent::S_V>(pipe);
    Abs(num, z, count);
    Mul(inner, z, z, count);
    PipeBarrier<PIPE_V>();
    Muls(inner, inner, -0.07135481627330025f, count);
    PipeBarrier<PIPE_V>();
    Adds(inner, inner, -1.5957691216057308f, count);
    PipeBarrier<PIPE_V>();
    Mul(inner, inner, num, count);
    PipeBarrier<PIPE_V>();
    Exp(inner, inner, count);
    PipeBarrier<PIPE_V>();
    Adds(den, inner, 1.0f, count);
    Mul(num, z, inner, count);
    PipeBarrier<PIPE_V>();
    CompareScalar(mask, z, 0.0f, CMPMODE::GE, count);
    PipeBarrier<PIPE_V>();
    Select(num, mask, z, num, SELMODE::VSEL_TENSOR_TENSOR_MODE, count);
    PipeBarrier<PIPE_V>();
    Div(z, num, den, count);
    PipeBarrier<PIPE_V>();
    Cast(result, z, RoundMode::CAST_RINT, count);
    Sync<HardEvent::V_MTE3>(pipe);
    GlobalTensor<half> out;
    out.SetGlobalBuffer((__gm__ half *)y);
    DataCopyExtParams cp{1, m * n * 2U, 0, 0, 0};
    DataCopyPad(out, result, cp);
}

// TINY_CAPACITY_BEGIN
constexpr uint32_t TINY_REGISTER_WORDS = 32;

struct TinyCapacity {
    uint32_t k, n;
    bool registers;
};

inline TinyCapacity SelectTinyCapacity(uint32_t m, uint32_t k, uint32_t n, uint32_t e) {
    if (m > 16 || uint64_t(m) * k > 256 || uint64_t(e) * k * n > 32768 || uint64_t(e) * n > 2048 ||
        e > 128)
        return {0, 0, false};
    // Capacities bound register storage and span multiple actual K/N pairs.
    uint32_t ck = 1, cn = (n + 1) / 2 * 2;
    while (ck < k)
        ck *= 2;
    return {ck, cn, k > 0 && n > 0 && ck <= 16 && cn <= 16 && ck * cn <= TINY_REGISTER_WORDS};
}

// TINY_CAPACITY_END
template <uint32_t CK, uint32_t CN>
__global__ __aicore__ void TinyCapacityKernel(GM_ADDR x,
                                              GM_ADDR w,
                                              GM_ADDR scale,
                                              GM_ADDR groups,
                                              GM_ADDR y,
                                              uint32_t m,
                                              uint32_t k,
                                              uint32_t n,
                                              uint32_t e) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    static_assert(CK * CN <= TINY_REGISTER_WORDS && CN % 2 == 0 && CN <= 16 && CK <= 16,
                  "Tiny register capacity");
    // Host rounds K upward to a power of two and N upward to a column pair.
    // These are range preconditions; all logical bounds and strides remain k/n.
    __builtin_assume(k > CK / 2 && k <= CK && n > CN - 2 && n <= CN);
    // Static Tensor entry initializes all required AI Core state each call.
    InitSocState();
    constexpr uint32_t X = 0, W = X + 256, S = W + 32768, G = S + 8192;
    constexpr uint32_t Z = G + 1024, I = Z + 1024, D = I + 1024, A = D + 1024, H = A + 1024,
                       MASK = H + 512;
    static_assert(MASK + 256 == 47104 && MASK + 256 <= 192 * 1024, "Tiny static UB capacity");
    LocalTensor<int8_t> lx(TPosition::VECCALC, X, 256), lw(TPosition::VECCALC, W, 32768);
    LocalTensor<float> ls(TPosition::VECCALC, S, 2048);
    LocalTensor<int64_t> lg(TPosition::VECCALC, G, 128);
    LocalTensor<float> z(TPosition::VECCALC, Z, 256), inner(TPosition::VECCALC, I, 256);
    LocalTensor<float> den(TPosition::VECCALC, D, 256), num(TPosition::VECCALC, A, 256);
    LocalTensor<half> result(TPosition::VECCALC, H, 256);
    LocalTensor<uint8_t> mask(TPosition::VECCALC, MASK, 256);
    constexpr uint32_t count = 256 / sizeof(float);
    Duplicate(z, 0.0f, count);
    LoadSmall(lx, x, m * k);
    LoadSmall(lw, w, e * k * n);
    LoadSmall(ls, scale, e * n);
    LoadSmall(lg, groups, e);
    SetFlag<HardEvent::V_S>(0);
    WaitFlag<HardEvent::V_S>(0);
    SetFlag<HardEvent::MTE2_S>(0);
    WaitFlag<HardEvent::MTE2_S>(0);
    const uint32_t row = GetBlockIdx();
    uint32_t expert = 0;
    while (expert < e && static_cast<uint32_t>(lg.GetValue(expert)) <= row)
        ++expert;
    int32_t inputs[CK] = {}, sums[CN] = {};
#pragma unroll
    for (uint32_t kk = 0; kk < CK; kk++)
        if (kk < k)
            inputs[kk] = static_cast<int32_t>(lx.GetValue(row * k + kk));
    if constexpr (CK * CN >= sizeof(uint32_t)) {
        // Reuse only the current invocation's contiguous input word.
        // LoadSmall initializes the DMA alignment bytes; only logical bytes enter sums.
        auto words = lw.ReinterpretCast<uint32_t>();
        uint32_t cachedIndex = ~uint32_t(0), cachedWord = 0;
#pragma unroll
        for (uint32_t kk = 0; kk < CK; kk++)
            if (kk < k) {
#pragma unroll
                for (uint32_t col = 0; col < CN; col++)
                    if (col < n) {
                        const uint32_t index = (expert * k + kk) * n + col,
                                       wordIndex = index / sizeof(uint32_t);
                        if (wordIndex != cachedIndex) {
                            cachedWord = words.GetValue(wordIndex);
                            cachedIndex = wordIndex;
                        }
                        const int32_t byte = static_cast<int32_t>(
                            (cachedWord >> ((index % sizeof(uint32_t)) * 8)) & 255U);
                        const int32_t value = (byte ^ 128) - 128;
                        sums[col] += inputs[kk] * value;
                    }
            }
    } else {
#pragma unroll
        for (uint32_t kk = 0; kk < CK; kk++)
            if (kk < k) {
#pragma unroll
                for (uint32_t col = 0; col < CN; col++)
                    if (col < n)
                        sums[col] += inputs[kk] *
                                     static_cast<int32_t>(lw.GetValue((expert * k + kk) * n + col));
            }
    }
#pragma unroll
    for (uint32_t col = 0; col < CN; col++)
        if (col < n)
            z.SetValue(col, static_cast<float>(sums[col]) * ls.GetValue(expert * n + col));
    SetFlag<HardEvent::S_V>(0);
    WaitFlag<HardEvent::S_V>(0);
    const uint8_t reps = 1;
    Mul<float, false>(inner, z, z, uint64_t(count), reps, {1, 1, 1, 8, 8, 8});
    PipeBarrier<PIPE_V>();
    Muls<float, float, false>(
        inner, inner, -0.07135481627330025f, uint64_t(count), reps, {1, 1, 8, 8});
    PipeBarrier<PIPE_V>();
    Adds<float, float, false>(
        inner, inner, -1.5957691216057308f, uint64_t(count), reps, {1, 1, 8, 8});
    PipeBarrier<PIPE_V>();
    Mul<float, false>(inner, inner, z, uint64_t(count), reps, {1, 1, 1, 8, 8, 8});
    PipeBarrier<PIPE_V>();
    Exp<float, false>(inner, inner, uint64_t(count), reps, {1, 1, 8, 8});
    PipeBarrier<PIPE_V>();
    Adds<float, float, false>(den, inner, 1.0f, uint64_t(count), reps, {1, 1, 8, 8});
    PipeBarrier<PIPE_V>();
    Div<float, false>(z, z, den, uint64_t(count), reps, {1, 1, 1, 8, 8, 8});
    PipeBarrier<PIPE_V>();
    Cast<half, float, false>(result, z, RoundMode::CAST_RINT, uint64_t(count), reps, {1, 1, 4, 8});
    SetFlag<HardEvent::V_MTE3>(0);
    WaitFlag<HardEvent::V_MTE3>(0);
    GlobalTensor<half> out;
    out.SetGlobalBuffer((__gm__ half *)y + uint64_t(row) * n);
    DataCopyExtParams cp{1, n * 2U, 0, 0, 0};
    DataCopyPad(out, result, cp);
    // Match the original TPipe destructor: drain every pipeline before exit.
    PipeBarrier<PIPE_ALL>();
}

inline void LaunchTiny(GM_ADDR x,
                       GM_ADDR weight,
                       GM_ADDR scale,
                       GM_ADDR groups,
                       GM_ADDR y,
                       uint32_t m,
                       uint32_t k,
                       uint32_t n,
                       uint32_t e,
                       aclrtStream stream) {
    const auto cap = SelectTinyCapacity(m, k, n, e);
    if (cap.registers) {
        if (cap.k == 1 && cap.n == 2) {
            TinyCapacityKernel<1, 2>
                <<<m, nullptr, stream>>>(x, weight, scale, groups, y, m, k, n, e);
            return;
        }
        if (cap.k == 1 && cap.n == 4) {
            TinyCapacityKernel<1, 4>
                <<<m, nullptr, stream>>>(x, weight, scale, groups, y, m, k, n, e);
            return;
        }
        if (cap.k == 1 && cap.n == 6) {
            TinyCapacityKernel<1, 6>
                <<<m, nullptr, stream>>>(x, weight, scale, groups, y, m, k, n, e);
            return;
        }
        if (cap.k == 1 && cap.n == 8) {
            TinyCapacityKernel<1, 8>
                <<<m, nullptr, stream>>>(x, weight, scale, groups, y, m, k, n, e);
            return;
        }
        if (cap.k == 1 && cap.n == 10) {
            TinyCapacityKernel<1, 10>
                <<<m, nullptr, stream>>>(x, weight, scale, groups, y, m, k, n, e);
            return;
        }
        if (cap.k == 1 && cap.n == 12) {
            TinyCapacityKernel<1, 12>
                <<<m, nullptr, stream>>>(x, weight, scale, groups, y, m, k, n, e);
            return;
        }
        if (cap.k == 1 && cap.n == 14) {
            TinyCapacityKernel<1, 14>
                <<<m, nullptr, stream>>>(x, weight, scale, groups, y, m, k, n, e);
            return;
        }
        if (cap.k == 1 && cap.n == 16) {
            TinyCapacityKernel<1, 16>
                <<<m, nullptr, stream>>>(x, weight, scale, groups, y, m, k, n, e);
            return;
        }
        if (cap.k == 2 && cap.n == 2) {
            TinyCapacityKernel<2, 2>
                <<<m, nullptr, stream>>>(x, weight, scale, groups, y, m, k, n, e);
            return;
        }
        if (cap.k == 2 && cap.n == 4) {
            TinyCapacityKernel<2, 4>
                <<<m, nullptr, stream>>>(x, weight, scale, groups, y, m, k, n, e);
            return;
        }
        if (cap.k == 2 && cap.n == 6) {
            TinyCapacityKernel<2, 6>
                <<<m, nullptr, stream>>>(x, weight, scale, groups, y, m, k, n, e);
            return;
        }
        if (cap.k == 2 && cap.n == 8) {
            TinyCapacityKernel<2, 8>
                <<<m, nullptr, stream>>>(x, weight, scale, groups, y, m, k, n, e);
            return;
        }
        if (cap.k == 2 && cap.n == 10) {
            TinyCapacityKernel<2, 10>
                <<<m, nullptr, stream>>>(x, weight, scale, groups, y, m, k, n, e);
            return;
        }
        if (cap.k == 2 && cap.n == 12) {
            TinyCapacityKernel<2, 12>
                <<<m, nullptr, stream>>>(x, weight, scale, groups, y, m, k, n, e);
            return;
        }
        if (cap.k == 2 && cap.n == 14) {
            TinyCapacityKernel<2, 14>
                <<<m, nullptr, stream>>>(x, weight, scale, groups, y, m, k, n, e);
            return;
        }
        if (cap.k == 2 && cap.n == 16) {
            TinyCapacityKernel<2, 16>
                <<<m, nullptr, stream>>>(x, weight, scale, groups, y, m, k, n, e);
            return;
        }
        if (cap.k == 4 && cap.n == 2) {
            TinyCapacityKernel<4, 2>
                <<<m, nullptr, stream>>>(x, weight, scale, groups, y, m, k, n, e);
            return;
        }
        if (cap.k == 4 && cap.n == 4) {
            TinyCapacityKernel<4, 4>
                <<<m, nullptr, stream>>>(x, weight, scale, groups, y, m, k, n, e);
            return;
        }
        if (cap.k == 4 && cap.n == 6) {
            TinyCapacityKernel<4, 6>
                <<<m, nullptr, stream>>>(x, weight, scale, groups, y, m, k, n, e);
            return;
        }
        if (cap.k == 4 && cap.n == 8) {
            TinyCapacityKernel<4, 8>
                <<<m, nullptr, stream>>>(x, weight, scale, groups, y, m, k, n, e);
            return;
        }
        if (cap.k == 8 && cap.n == 2) {
            TinyCapacityKernel<8, 2>
                <<<m, nullptr, stream>>>(x, weight, scale, groups, y, m, k, n, e);
            return;
        }
        if (cap.k == 8 && cap.n == 4) {
            TinyCapacityKernel<8, 4>
                <<<m, nullptr, stream>>>(x, weight, scale, groups, y, m, k, n, e);
            return;
        }
        if (cap.k == 16 && cap.n == 2) {
            TinyCapacityKernel<16, 2>
                <<<m, nullptr, stream>>>(x, weight, scale, groups, y, m, k, n, e);
            return;
        }
    }
    Tiny<<<1, nullptr, stream>>>(x, weight, scale, groups, y, m, k, n, e);
}

struct SmallPlan {
    uint32_t m, k, n, e, cores;
};

// Preserve the Small Vector's allocation geometry with public static tensors.
__aicore__ inline void
SmallVectorStatic(GM_ADDR scale, GM_ADDR groups, GM_ADDR y, GM_ADDR workspace, const SmallPlan &p) {
    InitSocState();
    constexpr uint32_t TM = 16, TN = 128;
    const uint32_t n = p.n;
    constexpr uint32_t CS = TM * TN, VS = CS, VR = VS / TN;
    constexpr uint32_t RAW = 0;
    constexpr uint32_t Z = RAW + VS * 4 + 256;
    constexpr uint32_t INNER = Z + VS * 4 + 256;
    constexpr uint32_t DEN = INNER + VS * 4 + 256;
    constexpr uint32_t NUM = DEN + VS * 4 + 256;
    constexpr uint32_t HALF = NUM + VS * 4 + 256;
    constexpr uint32_t SCALE = HALF + VS * 2;
    constexpr uint32_t MASK = SCALE + TN * 4;
    constexpr uint32_t GROUP = MASK + VS / 8;
    constexpr uint32_t END = GROUP + 128 * 8;
    static_assert(END == 48128 && END <= 192 * 1024, "Small static UB capacity");
    LocalTensor<int32_t> raw(TPosition::VECCALC, RAW, VS + 64);
    LocalTensor<float> z(TPosition::VECCALC, Z, VS + 64);
    LocalTensor<float> inner(TPosition::VECCALC, INNER, VS + 64);
    LocalTensor<float> den(TPosition::VECCALC, DEN, VS + 64);
    LocalTensor<float> num(TPosition::VECCALC, NUM, VS + 64);
    LocalTensor<half> result(TPosition::VECCALC, HALF, VS);
    LocalTensor<float> coeff(TPosition::VECCALC, SCALE, TN);
    LocalTensor<uint8_t> mask(TPosition::VECCALC, MASK, VS / 8);
    LocalTensor<int64_t> localEnds(TPosition::VECCALC, GROUP, 128);
    // No queue allocates hard events here. Each local event0 is set/wait paired
    // before same-direction reuse; cross-core ring flags8/9 stay independent.
    GlobalTensor<int32_t> ring;
    GlobalTensor<float> sg;
    GlobalTensor<half> out;
    GlobalTensor<int64_t> ends;
    ring.SetGlobalBuffer((__gm__ int32_t *)workspace);
    sg.SetGlobalBuffer((__gm__ float *)scale);
    out.SetGlobalBuffer((__gm__ half *)y);
    ends.SetGlobalBuffer((__gm__ int64_t *)groups);
    DataCopyExtParams gcp{1, p.e * 8U, 0, 0, 0};
    DataCopyPadExtParams<int64_t> gp{false, 0, 0, 0};
    DataCopyPad(localEnds, ends, gcp, gp);
    SetFlag<HardEvent::MTE2_S>(0);
    WaitFlag<HardEvent::MTE2_S>(0);
    uint32_t core = GetBlockIdx() / 2, sequence = 0, start = 0, base = 0, nt = (n + TN - 1) / TN;
    for (uint32_t e = 0; e < p.e; e++) {
        uint32_t end = static_cast<uint32_t>(localEnds.GetValue(e));
        uint32_t mt = (end - start + TM - 1) / TM, tasks = mt * nt;
        uint32_t first = (core + p.cores - base % p.cores) % p.cores;
        for (uint32_t task = first; task < tasks; task += p.cores, sequence++) {
            uint32_t row = start + task / nt * TM, col = task % nt * TN;
            uint32_t totalRows = end - row < TM ? end - row : TM,
                     cols = n - col < TN ? n - col : TN;
            uint32_t aligned = (cols + 7) / 8 * 8;
            CrossCoreWaitFlag<2>(8);
            uint32_t halfRows = (totalRows + 1) / 2;
            uint32_t subStart = GetSubBlockIdx() * halfRows;
            uint32_t subEnd = subStart + halfRows < totalRows ? subStart + halfRows : totalRows;
            if (subStart >= subEnd)
                CrossCoreSetFlag<2, PIPE_MTE2>(9);
            for (uint32_t vrow = subStart; vrow < subEnd; vrow += VR) {
                uint32_t rows = subEnd - vrow < VR ? subEnd - vrow : VR;
                if (cols < TN)
                    Duplicate(raw, 0, VS);
                SetFlag<HardEvent::V_MTE2>(0);
                WaitFlag<HardEvent::V_MTE2>(0);
                DataCopyExtParams cp{static_cast<uint16_t>(rows),
                                     cols * 4U,
                                     (TN - cols) * 4U,
                                     (TN - aligned) / 8,
                                     0};
                DataCopyPadExtParams<int32_t> pad{true, 0, static_cast<uint8_t>(aligned - cols), 0};
                DataCopyPad(raw, ring[(core * 2 + sequence % 2) * CS + vrow * TN], cp, pad);
                DataCopyExtParams scp{1, cols * 4U, 0, 0, 0};
                DataCopyPadExtParams<float> sp{true, 0, static_cast<uint8_t>(aligned - cols), 0.0f};
                if (vrow == subStart)
                    DataCopyPad(coeff, sg[uint64_t(e) * n + col], scp, sp);
                if (vrow + rows == subEnd)
                    CrossCoreSetFlag<2, PIPE_MTE2>(9);
                SetFlag<HardEvent::MTE2_V>(0);
                WaitFlag<HardEvent::MTE2_V>(0);
                Cast(z, raw, RoundMode::CAST_NONE, rows * TN);
                PipeBarrier<PIPE_V>();
                for (uint32_t off = 0; off < cols; off += 64) {
                    Mul(z[off],
                        z[off],
                        coeff[off],
                        cols - off < 64 ? cols - off : 64,
                        rows,
                        {1, 1, 1, TN / 8, TN / 8, 0});
                }
                PipeBarrier<PIPE_V>();
                // Copied padding is zero, so the entire aligned tile is initialized.
                uint32_t count = rows * TN;
                // Algebraically equivalent z/(1+exp(-2*p(z))). FP32 throughout.
                Mul(inner, z, z, count);
                PipeBarrier<PIPE_V>();
                Muls(inner, inner, -0.07135481627330025f, count);
                PipeBarrier<PIPE_V>();
                Adds(inner, inner, -1.5957691216057308f, count);
                PipeBarrier<PIPE_V>();
                Mul(inner, inner, z, count);
                PipeBarrier<PIPE_V>();
                Exp(inner, inner, count);
                PipeBarrier<PIPE_V>();
                Adds(inner, inner, 1.0f, count);
                PipeBarrier<PIPE_V>();
                Div(z, z, inner, count);
                PipeBarrier<PIPE_V>();
                Cast(result, z, RoundMode::CAST_RINT, rows * TN);
                SetFlag<HardEvent::V_MTE3>(0);
                WaitFlag<HardEvent::V_MTE3>(0);
                uint32_t ah = (cols + 15) / 16 * 16;
                DataCopyExtParams ocp{
                    static_cast<uint16_t>(rows), cols * 2U, (TN - ah) / 16, (n - cols) * 2U, 0};
                DataCopyPad(out[uint64_t(row + vrow) * n + col], result, ocp);
                SetFlag<HardEvent::MTE3_V>(0);
                WaitFlag<HardEvent::MTE3_V>(0);
            }
        }
        start = end;
        base += tasks;
    }
    // Match the AIV TPipe destructor after all task and idle paths.
    PipeBarrier<PIPE_ALL>();
}

// Single K-pass primitive path for the small 64x128 by 128x128 product.
__aicore__ inline void SmallCube(GM_ADDR x, GM_ADDR w, GM_ADDR workspace, const SmallPlan &p) {
    constexpr uint32_t SN = 128, NT = 1, SC = 16 * SN;
    const uint32_t k = p.k, n = p.n, mt = (p.m + 15) / 16;
    InitSocState();
    LocalTensor<int8_t> a1(TPosition::A1, 0, 2048);
    LocalTensor<int8_t> b1(TPosition::B1, 2048, 128 * SN);
    LocalTensor<int8_t> a2(TPosition::A2, 0, 2048);
    LocalTensor<int8_t> b2(TPosition::B2, 0, 128 * SN);
    LocalTensor<int32_t> c(TPosition::CO1, 0, SC);
    GlobalTensor<int8_t> ag, bg;
    GlobalTensor<int32_t> out;
    ag.SetGlobalBuffer((__gm__ int8_t *)x);
    bg.SetGlobalBuffer((__gm__ int8_t *)w);
    out.SetGlobalBuffer((__gm__ int32_t *)workspace);
    uint32_t sequence = 0;
    for (uint32_t task = GetBlockIdx(); task < mt * NT; task += p.cores, sequence++) {
        uint32_t row = task / NT * 16, col = task % NT * SN, rows = p.m - row < 16 ? p.m - row : 16;
        Nd2NzParams ac{};
        ac.ndNum = 1;
        ac.nValue = rows;
        ac.dValue = k;
        ac.srcDValue = k;
        ac.dstNzC0Stride = 16;
        ac.dstNzNStride = 1;
        Nd2NzParams bc{};
        bc.ndNum = 1;
        bc.nValue = k;
        bc.dValue = n;
        bc.srcDValue = n;
        bc.dstNzC0Stride = k;
        bc.dstNzNStride = 1;
        DataCopy(a1, ag[uint64_t(row) * k], ac);
        DataCopy(b1, bg[col], bc);
        SetFlag<HardEvent::MTE2_MTE1>(0);
        WaitFlag<HardEvent::MTE2_MTE1>(0);
        LoadData2DParams la{};
        la.repeatTimes = k / 32;
        la.srcStride = 1;
        la.ifTranspose = false;
        LoadData(a2, a1, la);
        LoadData2dTransposeParams lb{};
        lb.repeatTimes = n / 32;
        lb.srcStride = k / 32;
        lb.dstGap = 1;
        lb.dstFracGap = 0;
        for (uint32_t i = 0; i < k / 32; i++)
            LoadDataWithTranspose(b2[i * (n / 32 * 1024)], b1[i * 1024], lb);
        SetFlag<HardEvent::MTE1_M>(0);
        WaitFlag<HardEvent::MTE1_M>(0);
        MmadParams mp{};
        mp.m = 16;
        mp.n = n;
        mp.k = k;
        mp.cmatrixInitVal = true;
        Mmad(c, a2, b2, mp);
        SetFlag<HardEvent::M_FIX>(0);
        WaitFlag<HardEvent::M_FIX>(0);
        FixpipeParamsV220 fp{};
        fp.nSize = n;
        fp.mSize = rows;
        fp.srcStride = 16;
        fp.dstStride = SN;
        fp.ndNum = 1;
        Fixpipe(out[(GetBlockIdx() * 2 + sequence % 2) * SC], c, fp);
        CrossCoreSetFlag<2, PIPE_FIX>(8);
        CrossCoreWaitFlag<2>(9);
    }
    PipeBarrier<PIPE_ALL>();
}

__global__ __aicore__ void SmallKernel(GM_ADDR x,
                                       GM_ADDR w,
                                       GM_ADDR scale,
                                       GM_ADDR groups,
                                       GM_ADDR y,
                                       GM_ADDR workspace,
                                       uint32_t packed) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
    // Whole family contract: M<=64, K/N<=128, E=1, cores<=4.
    // Transport only shape/launch metadata; no input values or result lookup.
    const SmallPlan p{
        packed & 127U, (packed >> 7) & 255U, (packed >> 15) & 255U, 1U, (packed >> 23) & 31U};
    if ASCEND_IS_AIC {
        SmallCube(x, w, workspace, p);
    } else {
        SmallVectorStatic(scale, groups, y, workspace, p);
    }
}

inline void Check(aclError e) {
    if (e != ACL_SUCCESS)
        throw std::runtime_error("GroupedGelu ACL error " + std::to_string(e));
}

inline void TCheck(int e) {
    if (e != 0)
        throw std::runtime_error("GroupedGelu tiling error");
}

struct Workspace {
    void *ptr = nullptr;
    aclrtStream stream = nullptr;

    ~Workspace() {
        if (ptr) {
            aclrtSynchronizeStream(stream);
            aclrtFree(ptr);
        }
    }
};

inline void LaunchNd64(GM_ADDR x,
                       GM_ADDR weight,
                       GM_ADDR scale,
                       GM_ADDR groups,
                       GM_ADDR y,
                       uint32_t m,
                       uint32_t k,
                       uint32_t n,
                       uint32_t e,
                       int64_t availableCoreNum,
                       aclrtStream stream) {
    auto *platform = platform_ascendc::PlatformAscendCManager::GetInstance();
    if (!platform || availableCoreNum <= 0 || !UseNd64(m, k, n, e))
        throw std::runtime_error("GroupedGelu ND64 resource contract");
    Plan p{};
    p.m = m;
    p.k = k;
    p.rawK = k;
    p.ka = k;
    p.n = n;
    p.wn = n;
    p.e = e;
    p.cores = std::min<int64_t>(availableCoreNum, platform->GetCoreNumAic());
    if (!p.cores)
        throw std::runtime_error("GroupedGelu no Cube cores");
    constexpr uint32_t CS = ND64_TM * ND64_TN;
    Workspace scratch;
    scratch.stream = stream;
    Check(aclrtMalloc(&scratch.ptr, uint64_t(p.cores) * 2 * CS * 4, ACL_MEM_MALLOC_HUGE_FIRST));
    Nd64DoubleCKernel<<<p.cores, nullptr, stream>>>(
        x, weight, scale, groups, y, (GM_ADDR)scratch.ptr, NdManualPlan{p.k, p.n, p.e, p.cores});
}

struct CubeResourceContract {
    static constexpr uint64_t l1Bytes = 512 * 1024, l0InputBytes = 64 * 1024, l0CBytes = 128 * 1024;
};

template <class Q>
inline void CheckCubeResources(const Q &q) {
    if (q.baseM <= 0 || q.baseN <= 0 || q.baseK <= 0)
        throw std::runtime_error("invalid Cube geometry");
    const uint64_t a = uint64_t(q.baseM) * q.baseK, b = uint64_t(q.baseN) * q.baseK;
    const uint64_t c = uint64_t(q.baseM) * q.baseN * sizeof(int32_t);
    const uint64_t da = std::max<int64_t>(1, q.dbL0A), db = std::max<int64_t>(1, q.dbL0B),
                   dc = std::max<int64_t>(1, q.dbL0C);
    const uint64_t l1 = a * q.depthA1 + b * q.depthB1;
    if (a * da > CubeResourceContract::l0InputBytes ||
        b * db > CubeResourceContract::l0InputBytes || c * dc > CubeResourceContract::l0CBytes ||
        l1 > CubeResourceContract::l1Bytes || q.shareL1Size > CubeResourceContract::l1Bytes ||
        q.shareL0CSize > CubeResourceContract::l0CBytes)
        throw std::runtime_error("Cube resource contract exceeded");
}

template <uint32_t TM, uint32_t TN, bool NZ, uint32_t SK, bool MERGED>
inline void CheckSelectedCubeResources(Plan &p) {
    auto inspect = [&](const auto &q) {
        CheckCubeResources(q);
        // Read A directly when already aligned or when one L1 K step holds its full row.
        // This is a tiling/resource predicate; no tensor payload is read on Host.
        const bool fullK = q.stepKa > 0 && uint64_t(q.stepKa) * q.baseK >= p.k;
        p.rawA = NZ && (p.rawK == p.k || fullK);
    };
    inspect(p.cube);
    if constexpr (SK != 0) {
        if (MERGED && !NZ && SK == 2048 && TM == 64 && TN == 512)
            inspect(STATIC_CFG<64, 1024, false, 2048>);
        else if (MERGED && !NZ && SK == 1024 && TM == 128 && TN == 256)
            inspect(STATIC_CFG<128, 512, false, 1024>);
        else if (MERGED && !NZ && SK == 2048 && TM == 128 && TN == 256)
            inspect(STATIC_CFG<128, 768, false, 2048>);
        else
            inspect(STATIC_CFG<TM, TN, NZ, SK>);
    }
    if constexpr (NZ && MERGED) {
        // This manual Cube pipeline owns both A1 slots, not the Matmul SDK.
        if (p.k % 32 || p.k > SK ||
            2ULL * TM * p.k + 2ULL * TN * 512 > CubeResourceContract::l1Bytes)
            throw std::runtime_error("NZ full-A1 resource contract exceeded");
        p.rawA = 1;
    }
}

// NZ_FRAME_DISPATCH_BEGIN
template <uint32_t FrameN = 128, class Launcher>
inline void DispatchNzFrame(uint32_t columns, Launcher &launcher) {
    static_assert(FrameN >= 128 && FrameN <= 4096 && FrameN % 128 == 0, "uniform frame coverage");
    if (columns <= FrameN) {
        launcher.template Run<FrameN>();
    } else if constexpr (FrameN < 4096) {
        DispatchNzFrame<FrameN + 128>(columns, launcher);
    } else {
        throw std::invalid_argument("NZ frame exceeds logical N domain");
    }
}

// NZ_FRAME_DISPATCH_END

// NZ_FRAME_HOST_LAUNCH_BEGIN
struct NzFrameLauncher {
    GM_ADDR x;
    GM_ADDR weight;
    GM_ADDR scale;
    GM_ADDR groups;
    GM_ADDR y;
    GM_ADDR paddedWorkspace;
    Plan p;
    aclrtStream stream;

    template <uint32_t FrameN>
    inline void Run() {
        if (AlignedExtent(p.wn, 128) != FrameN)
            throw std::runtime_error("NZ frame binding mismatch");
        constexpr uint32_t TM = 128, TN = 128, SS = TM * TN + FrameN - TN;
        Workspace scratch;
        scratch.stream = stream;
        Check(aclrtMalloc(&scratch.ptr, uint64_t(p.cores) * 2 * SS * 4, ACL_MEM_MALLOC_HUGE_FIRST));
        KernelNzFrame<FrameN><<<p.cores, nullptr, stream>>>(
            x, weight, scale, groups, y, (GM_ADDR)scratch.ptr, paddedWorkspace, p);
    }
};

// NZ_FRAME_HOST_LAUNCH_END

// NdMedium static tiling consumes only runtime shape and launch metadata.
// Keep the generic Plan ABI and implementations unchanged for all other families.
struct MediumPlan {
    uint32_t k, n, e, cores;
};

template <uint32_t TM, uint32_t TN, typename QA, typename QB>
__aicore__ inline void MediumPrefetchCubeInputs(QA &aq,
                                                QB &bq,
                                                const CubePrefetchTask &task,
                                                const GlobalTensor<int8_t> &a,
                                                const GlobalTensor<int8_t> &b,
                                                const MediumPlan &p) {
    auto al = aq.template AllocTensor<int8_t>();
    auto bl = bq.template AllocTensor<int8_t>();
    Nd2NzParams acp;
    acp.ndNum = 1;
    acp.nValue = task.rows;
    acp.dValue = p.k;
    acp.srcDValue = p.k;
    acp.dstNzC0Stride = TM;
    acp.dstNzNStride = 1;
    acp.srcNdMatrixStride = 0;
    acp.dstNzMatrixStride = 0;
    DataCopy(al, a[uint64_t(task.row) * p.k], acp);
    aq.EnQue(al);
    const uint32_t cols = p.n - task.col < TN ? p.n - task.col : TN;
    Nd2NzParams bcp;
    bcp.ndNum = 1;
    bcp.nValue = p.k;
    bcp.dValue = cols;
    bcp.srcDValue = p.n;
    bcp.dstNzC0Stride = p.k;
    bcp.dstNzNStride = 1;
    bcp.srcNdMatrixStride = 0;
    bcp.dstNzMatrixStride = 0;
    DataCopy(bl, b[uint64_t(task.expert) * p.k * p.n + task.col], bcp);
    bq.EnQue(bl);
}

template <uint32_t TM, uint32_t TN, uint32_t SK>
__aicore__ inline void
MediumCubePrefetch(GM_ADDR x, GM_ADDR w, GM_ADDR groups, GM_ADDR workspace, const MediumPlan &p) {
    constexpr uint32_t CS = TM * TN;
    static_assert(2ULL * (TM + TN) * SK <= 512 * 1024, "prefetch stages exceed L1");
    static_assert(PREFETCH_CFG<TM, TN, SK>.shareL1Size == 0,
                  "TSCM input must not allocate internal L1");
    TPipe pipe;
    TQue<TPosition::A1, 2> aq;
    TQue<TPosition::B1, 2> bq;
    pipe.InitBuffer(aq, 2, TM * SK);
    pipe.InitBuffer(bq, 2, TN * SK);
    using A = MatmulType<TPosition::TSCM, CubeFormat::NZ, int8_t, false>;
    using B = MatmulType<TPosition::TSCM, CubeFormat::NZ, int8_t, false>;
    using C = MatmulType<TPosition::GM, CubeFormat::ND, int32_t>;
    Matmul<A, B, C, C, PREFETCH_CFG<TM, TN, SK>> mm;
    mm.Init((const TCubeTiling *)nullptr, &pipe);
    // L1 A has TM physical rows. B has actual K physical rows, not SK.
    mm.SetOrgShape(TM, TN, p.k, p.k, TN);
    GlobalTensor<int8_t> a, b;
    GlobalTensor<int64_t> ends;
    GlobalTensor<int32_t> ring;
    a.SetGlobalBuffer((__gm__ int8_t *)x);
    b.SetGlobalBuffer((__gm__ int8_t *)w);
    ends.SetGlobalBuffer((__gm__ int64_t *)groups);
    ring.SetGlobalBuffer((__gm__ int32_t *)workspace);
    const uint32_t core = GetBlockIdx();
    uint32_t completed = 0;
    typename MediumCursorChoice<TM, TN, SK>::Type cursor;
    cursor.Init(p, core);
    CubePrefetchTask task, next;
    bool available = cursor.Next(ends, p, task);
    if (available)
        MediumPrefetchCubeInputs<TM, TN>(aq, bq, task, a, b, p);
    while (available) {
        auto al = aq.DeQue<int8_t>();
        auto bl = bq.DeQue<int8_t>();
        const bool more = cursor.Next(ends, p, next);
        // Alternate queues protect GM->L1 writes from preceding L1->L0 reads.
        if (more)
            MediumPrefetchCubeInputs<TM, TN>(aq, bq, next, a, b, p);
        const uint32_t cols = p.n - task.col < TN ? p.n - task.col : TN;
        mm.SetTail(task.rows, cols, p.k);
        mm.SetTensorA(al, false);
        mm.SetTensorB(bl, false);
        mm.Iterate();
        if (task.sequence >= 2)
            CrossCoreWaitFlag<2>(9);
        mm.GetTensorC(ring[(core * 2 + task.sequence % 2) * CS]);
        CrossCoreSetFlag<2, PIPE_FIX>(8);
        aq.FreeTensor(al);
        bq.FreeTensor(bl);
        ++completed;
        if (more)
            task = next;
        available = more;
    }
    for (uint32_t i = 0; i < (completed < 2 ? completed : 2); i++)
        CrossCoreWaitFlag<2>(9);
    mm.End();
}

template <uint32_t TM, uint32_t TN>
__aicore__ inline void MediumVectorStatic(
    GM_ADDR scale, GM_ADDR groups, GM_ADDR y, GM_ADDR workspace, const MediumPlan &p) {
    InitSocState();
    const uint32_t n = p.n;
    constexpr uint32_t CS = TM * TN, VS = CS > 8192 ? 8192 : CS, VR = VS / TN;
    constexpr uint32_t RAW = 0;
    constexpr uint32_t Z = RAW + VS * 4 + 256;
    constexpr uint32_t INNER = Z + VS * 4 + 256;
    constexpr uint32_t DEN = INNER + VS * 4 + 256;
    constexpr uint32_t NUM = DEN + VS * 4 + 256;
    constexpr uint32_t HALF = NUM + VS * 4 + 256;
    constexpr uint32_t SCALE = HALF + VS * 2;
    constexpr uint32_t MASK = SCALE + TN * 4;
    constexpr uint32_t GROUP = MASK + VS / 8;
    constexpr uint32_t END = GROUP + 128 * 8;
    static_assert(END <= 192 * 1024, "generic Vector static UB capacity");
    LocalTensor<int32_t> raw(TPosition::VECCALC, RAW, VS + 64);
    LocalTensor<float> z(TPosition::VECCALC, Z, VS + 64);
    LocalTensor<float> inner(TPosition::VECCALC, INNER, VS + 64);
    LocalTensor<float> den(TPosition::VECCALC, DEN, VS + 64);
    LocalTensor<float> num(TPosition::VECCALC, NUM, VS + 64);
    LocalTensor<half> result(TPosition::VECCALC, HALF, VS);
    LocalTensor<float> coeff(TPosition::VECCALC, SCALE, TN);
    LocalTensor<uint8_t> mask(TPosition::VECCALC, MASK, VS / 8);
    LocalTensor<int64_t> localEnds(TPosition::VECCALC, GROUP, 128);
    // No queue allocates hard events here. Each local event0 is set/wait paired
    // before same-direction reuse; cross-core ring flags8/9 stay independent.
    GlobalTensor<int32_t> ring;
    GlobalTensor<float> sg;
    GlobalTensor<half> out;
    GlobalTensor<int64_t> ends;
    ring.SetGlobalBuffer((__gm__ int32_t *)workspace);
    sg.SetGlobalBuffer((__gm__ float *)scale);
    out.SetGlobalBuffer((__gm__ half *)y);
    ends.SetGlobalBuffer((__gm__ int64_t *)groups);
    DataCopyExtParams gcp{1, p.e * 8U, 0, 0, 0};
    DataCopyPadExtParams<int64_t> gp{false, 0, 0, 0};
    DataCopyPad(localEnds, ends, gcp, gp);
    SetFlag<HardEvent::MTE2_S>(0);
    WaitFlag<HardEvent::MTE2_S>(0);
    uint32_t core = GetBlockIdx() / 2, sequence = 0, start = 0, base = 0, nt = (n + TN - 1) / TN;
    for (uint32_t e = 0; e < p.e; e++) {
        uint32_t end = static_cast<uint32_t>(localEnds.GetValue(e));
        uint32_t mt = (end - start + TM - 1) / TM, tasks = mt * nt;
        uint32_t first = (core + p.cores - base % p.cores) % p.cores;
        for (uint32_t task = first; task < tasks; task += p.cores, sequence++) {
            uint32_t row = start + task / nt * TM, col = task % nt * TN;
            uint32_t totalRows = end - row < TM ? end - row : TM,
                     cols = n - col < TN ? n - col : TN;
            uint32_t aligned = (cols + 7) / 8 * 8;
            CrossCoreWaitFlag<2>(8);
            uint32_t halfRows = (totalRows + 1) / 2;
            uint32_t subStart = GetSubBlockIdx() * halfRows;
            uint32_t subEnd = subStart + halfRows < totalRows ? subStart + halfRows : totalRows;
            if (subStart >= subEnd)
                CrossCoreSetFlag<2, PIPE_MTE2>(9);
            for (uint32_t vrow = subStart; vrow < subEnd; vrow += VR) {
                uint32_t rows = subEnd - vrow < VR ? subEnd - vrow : VR;
                if (cols < TN)
                    Duplicate(raw, 0, VS);
                SetFlag<HardEvent::V_MTE2>(0);
                WaitFlag<HardEvent::V_MTE2>(0);
                DataCopyExtParams cp{static_cast<uint16_t>(rows),
                                     cols * 4U,
                                     (TN - cols) * 4U,
                                     (TN - aligned) / 8,
                                     0};
                DataCopyPadExtParams<int32_t> pad{true, 0, static_cast<uint8_t>(aligned - cols), 0};
                DataCopyPad(raw, ring[(core * 2 + sequence % 2) * CS + vrow * TN], cp, pad);
                DataCopyExtParams scp{1, cols * 4U, 0, 0, 0};
                DataCopyPadExtParams<float> sp{true, 0, static_cast<uint8_t>(aligned - cols), 0.0f};
                if (vrow == subStart)
                    DataCopyPad(coeff, sg[uint64_t(e) * n + col], scp, sp);
                if (vrow + rows == subEnd)
                    CrossCoreSetFlag<2, PIPE_MTE2>(9);
                SetFlag<HardEvent::MTE2_V>(0);
                WaitFlag<HardEvent::MTE2_V>(0);
                Cast(z, raw, RoundMode::CAST_NONE, rows * TN);
                PipeBarrier<PIPE_V>();
                for (uint32_t off = 0; off < cols; off += 64) {
                    Mul(z[off],
                        z[off],
                        coeff[off],
                        cols - off < 64 ? cols - off : 64,
                        rows,
                        {1, 1, 1, TN / 8, TN / 8, 0});
                }
                PipeBarrier<PIPE_V>();
                // Copied padding is zero, so the entire aligned tile is initialized.
                uint32_t count = rows * TN;
                // Algebraically equivalent z/(1+exp(-2*p(z))). FP32 throughout.
                Mul(inner, z, z, count);
                PipeBarrier<PIPE_V>();
                Muls(inner, inner, -0.07135481627330025f, count);
                PipeBarrier<PIPE_V>();
                Adds(inner, inner, -1.5957691216057308f, count);
                PipeBarrier<PIPE_V>();
                Mul(inner, inner, z, count);
                PipeBarrier<PIPE_V>();
                Exp(inner, inner, count);
                PipeBarrier<PIPE_V>();
                Adds(inner, inner, 1.0f, count);
                PipeBarrier<PIPE_V>();
                Div(z, z, inner, count);
                PipeBarrier<PIPE_V>();
                Cast(result, z, RoundMode::CAST_RINT, rows * TN);
                SetFlag<HardEvent::V_MTE3>(0);
                WaitFlag<HardEvent::V_MTE3>(0);
                uint32_t ah = (cols + 15) / 16 * 16;
                DataCopyExtParams ocp{
                    static_cast<uint16_t>(rows), cols * 2U, (TN - ah) / 16, (n - cols) * 2U, 0};
                DataCopyPad(out[uint64_t(row + vrow) * n + col], result, ocp);
                SetFlag<HardEvent::MTE3_V>(0);
                WaitFlag<HardEvent::MTE3_V>(0);
            }
        }
        start = end;
        base += tasks;
    }
    // Match the AIV TPipe destructor after all task and idle paths.
    PipeBarrier<PIPE_ALL>();
}

template <uint32_t TM, uint32_t TN>
__aicore__ inline void VectorMediumRetired(
    GM_ADDR scale, GM_ADDR groups, GM_ADDR y, GM_ADDR workspace, const MediumPlan &p) {
    InitSocState();
    const uint32_t n = p.n;
    bool outputPending = false;
    constexpr uint32_t CS = TM * TN, VS = CS > 8192 ? 8192 : CS, VR = VS / TN;
    constexpr uint32_t RAW = 0;
    constexpr uint32_t Z = RAW + VS * 4 + 256;
    constexpr uint32_t INNER = Z + VS * 4 + 256;
    constexpr uint32_t DEN = INNER + VS * 4 + 256;
    constexpr uint32_t NUM = DEN + VS * 4 + 256;
    constexpr uint32_t HALF = NUM + VS * 4 + 256;
    constexpr uint32_t SCALE = HALF + VS * 2;
    constexpr uint32_t MASK = SCALE + TN * 4;
    constexpr uint32_t GROUP = MASK + VS / 8;
    constexpr uint32_t END = GROUP + 128 * 8;
    static_assert(END <= 192 * 1024, "generic Vector static UB capacity");
    LocalTensor<int32_t> raw(TPosition::VECCALC, RAW, VS + 64);
    LocalTensor<float> z(TPosition::VECCALC, Z, VS + 64);
    LocalTensor<float> inner(TPosition::VECCALC, INNER, VS + 64);
    LocalTensor<float> den(TPosition::VECCALC, DEN, VS + 64);
    LocalTensor<float> num(TPosition::VECCALC, NUM, VS + 64);
    LocalTensor<half> result(TPosition::VECCALC, HALF, VS);
    LocalTensor<float> coeff(TPosition::VECCALC, SCALE, TN);
    LocalTensor<uint8_t> mask(TPosition::VECCALC, MASK, VS / 8);
    LocalTensor<int64_t> localEnds(TPosition::VECCALC, GROUP, 128);
    // No queue allocates hard events here. Each local event0 is set/wait paired
    // before same-direction reuse; cross-core ring flags8/9 stay independent.
    GlobalTensor<int32_t> ring;
    GlobalTensor<float> sg;
    GlobalTensor<half> out;
    GlobalTensor<int64_t> ends;
    ring.SetGlobalBuffer((__gm__ int32_t *)workspace);
    sg.SetGlobalBuffer((__gm__ float *)scale);
    out.SetGlobalBuffer((__gm__ half *)y);
    ends.SetGlobalBuffer((__gm__ int64_t *)groups);
    DataCopyExtParams gcp{1, p.e * 8U, 0, 0, 0};
    DataCopyPadExtParams<int64_t> gp{false, 0, 0, 0};
    DataCopyPad(localEnds, ends, gcp, gp);
    SetFlag<HardEvent::MTE2_S>(0);
    WaitFlag<HardEvent::MTE2_S>(0);
    uint32_t core = GetBlockIdx() / 2, sequence = 0, start = 0, base = 0, nt = (n + TN - 1) / TN;
    for (uint32_t e = 0; e < p.e; e++) {
        uint32_t end = static_cast<uint32_t>(localEnds.GetValue(e));
        uint32_t mt = (end - start + TM - 1) / TM, tasks = mt * nt;
        uint32_t first = (core + p.cores - base % p.cores) % p.cores;
        for (uint32_t task = first; task < tasks; task += p.cores, sequence++) {
            uint32_t row = start + task / nt * TM, col = task % nt * TN;
            uint32_t totalRows = end - row < TM ? end - row : TM,
                     cols = n - col < TN ? n - col : TN;
            uint32_t aligned = (cols + 7) / 8 * 8;
            CrossCoreWaitFlag<2>(8);
            uint32_t halfRows = (totalRows + 1) / 2;
            uint32_t subStart = GetSubBlockIdx() * halfRows;
            uint32_t subEnd = subStart + halfRows < totalRows ? subStart + halfRows : totalRows;
            if (subStart >= subEnd)
                CrossCoreSetFlag<2, PIPE_MTE2>(9);
            for (uint32_t vrow = subStart; vrow < subEnd; vrow += VR) {
                uint32_t rows = subEnd - vrow < VR ? subEnd - vrow : VR;
                if (cols < TN)
                    Duplicate(raw, 0, VS);
                SetFlag<HardEvent::V_MTE2>(0);
                WaitFlag<HardEvent::V_MTE2>(0);
                DataCopyExtParams cp{static_cast<uint16_t>(rows),
                                     cols * 4U,
                                     (TN - cols) * 4U,
                                     (TN - aligned) / 8,
                                     0};
                DataCopyPadExtParams<int32_t> pad{true, 0, static_cast<uint8_t>(aligned - cols), 0};
                DataCopyPad(raw, ring[(core * 2 + sequence % 2) * CS + vrow * TN], cp, pad);
                DataCopyExtParams scp{1, cols * 4U, 0, 0, 0};
                DataCopyPadExtParams<float> sp{true, 0, static_cast<uint8_t>(aligned - cols), 0.0f};
                if (vrow == subStart)
                    DataCopyPad(coeff, sg[uint64_t(e) * n + col], scp, sp);
                if (vrow + rows == subEnd)
                    CrossCoreSetFlag<2, PIPE_MTE2>(9);
                SetFlag<HardEvent::MTE2_V>(0);
                WaitFlag<HardEvent::MTE2_V>(0);
                Cast(z, raw, RoundMode::CAST_NONE, rows * TN);
                PipeBarrier<PIPE_V>();
                for (uint32_t off = 0; off < cols; off += 64) {
                    Mul(z[off],
                        z[off],
                        coeff[off],
                        cols - off < 64 ? cols - off : 64,
                        rows,
                        {1, 1, 1, TN / 8, TN / 8, 0});
                }
                PipeBarrier<PIPE_V>();
                // Copied padding is zero, so the entire aligned tile is initialized.
                uint32_t count = rows * TN;
                // Algebraically equivalent z/(1+exp(-2*p(z))). FP32 throughout.
                Mul(inner, z, z, count);
                PipeBarrier<PIPE_V>();
                Muls(inner, inner, -0.07135481627330025f, count);
                PipeBarrier<PIPE_V>();
                Adds(inner, inner, -1.5957691216057308f, count);
                PipeBarrier<PIPE_V>();
                Mul(inner, inner, z, count);
                PipeBarrier<PIPE_V>();
                Exp(inner, inner, count);
                PipeBarrier<PIPE_V>();
                Adds(inner, inner, 1.0f, count);
                PipeBarrier<PIPE_V>();
                Div(z, z, inner, count);
                PipeBarrier<PIPE_V>();
                // Only result is still owned by the preceding MTE3 output transfer.
                // Raw/cast/GELU use disjoint UB ranges and can proceed before retirement.
                if (outputPending)
                    WaitFlag<HardEvent::MTE3_V>(0);
                Cast(result, z, RoundMode::CAST_RINT, rows * TN);
                SetFlag<HardEvent::V_MTE3>(0);
                WaitFlag<HardEvent::V_MTE3>(0);
                uint32_t ah = (cols + 15) / 16 * 16;
                DataCopyExtParams ocp{
                    static_cast<uint16_t>(rows), cols * 2U, (TN - ah) / 16, (n - cols) * 2U, 0};
                DataCopyPad(out[uint64_t(row + vrow) * n + col], result, ocp);
                SetFlag<HardEvent::MTE3_V>(0);
                outputPending = true;
            }
        }
        start = end;
        base += tasks;
    }
    if (outputPending)
        WaitFlag<HardEvent::MTE3_V>(0);
    // Match the AIV TPipe destructor after all task and idle paths.
    PipeBarrier<PIPE_ALL>();
}

__global__ __aicore__ void KernelMedium(GM_ADDR x,
                                        GM_ADDR w,
                                        GM_ADDR scale,
                                        GM_ADDR groups,
                                        GM_ADDR y,
                                        GM_ADDR workspace,
                                        uint32_t packed) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
    // Whole family has K/N multiples of32 within512/768. Real E and corecount are preserved.
    const MediumPlan p{
        (packed & 255U) * 32U, ((packed >> 8) & 255U) * 32U, (packed >> 16) & 255U, packed >> 24};
    if ASCEND_IS_AIC {
        MediumCubePrefetch<128, 256, 512>(x, w, groups, workspace, p);
    } else {
        VectorMediumRetired<128, 256>(scale, groups, y, workspace, p);
    }
}

__global__ __aicore__ void KernelMediumOneWave(GM_ADDR x,
                                               GM_ADDR w,
                                               GM_ADDR scale,
                                               GM_ADDR groups,
                                               GM_ADDR y,
                                               GM_ADDR workspace,
                                               uint32_t packed) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
    // Whole family has K/N multiples of32 within512/768. Real E and corecount are preserved.
    const MediumPlan p{
        (packed & 255U) * 32U, ((packed >> 8) & 255U) * 32U, (packed >> 16) & 255U, packed >> 24};
    if ASCEND_IS_AIC {
        MediumCubePrefetch<64, 256, 512>(x, w, groups, workspace, p);
    } else {
        VectorMediumRetired<64, 256>(scale, groups, y, workspace, p);
    }
}

template <uint32_t TM, uint32_t TN, bool NZ, uint32_t SK = 0, bool MERGED = false>
inline void Launch(GM_ADDR x,
                   GM_ADDR weight,
                   GM_ADDR scale,
                   GM_ADDR group_list,
                   GM_ADDR y,
                   uint32_t m,
                   uint32_t k,
                   uint32_t n,
                   uint32_t e,
                   int64_t availableCoreNum,
                   aclrtStream stream) {
    auto *platform = platform_ascendc::PlatformAscendCManager::GetInstance();
    if (!platform)
        throw std::runtime_error("GroupedGelu platform unavailable");
    constexpr uint32_t CS = TM * TN;
    Plan p{};
    p.m = m;
    p.k = k;
    p.rawK = k;
    p.n = n;
    p.e = e;
    p.wn = n;
    p.cores = std::min<int64_t>(availableCoreNum, platform->GetCoreNumAic());
    if (!p.cores)
        throw std::runtime_error("GroupedGelu no Cube cores");
    // Metadata estimate only; actual expert endpoints and all task coverage remain Device-side.
    // Bound the heuristic to coarse rows and a short wave count; no exact shape tuple.
    if constexpr (MERGED && !NZ && TM == 128 && TN == 256 && SK == 1024) {
        const uint64_t estimatedRows = (uint64_t(m) + TM - 1) / TM;
        const uint64_t estimatedUnits = estimatedRows * ((uint64_t(n) + TN - 1) / TN);
        if (estimatedRows >= e && estimatedUnits > p.cores &&
            estimatedUnits <= uint64_t(p.cores) * 4) {
            const uint64_t unitsPerCore = (estimatedUnits + p.cores - 1) / p.cores;
            const uint32_t compact = (estimatedUnits + unitsPerCore - 1) / unitsPerCore;
            if (compact && compact < p.cores)
                p.cores = compact;
        }
    }
    Workspace aligned;
    aligned.stream = stream;
    GM_ADDR paddedWorkspace = nullptr;
    if (NZ) {
        p.k = AlignedExtent(k, 32);
        p.wn = AlignedExtent(n, 32);
        uint64_t xb = uint64_t(m) * p.k, wb = uint64_t(e) * p.k * p.wn;
        uint64_t cursorExtra = 0;
        if constexpr (NZ && MERGED) {
            if (e + 1 > NZ_CURSOR_PACKED_WORDS) {
                const uint64_t plannerUb = (uint64_t(e) * 8 + 31) / 32 * 32 +
                                           2 * ((uint64_t(e + 1) * 4 + 31) / 32 * 32) +
                                           uint64_t(p.cores) * 64;
                if (plannerUb > 192 * 1024 - 8 * 1024)
                    throw std::runtime_error("NZ cursor planner exceeds UB budget");
                cursorExtra = 63 + uint64_t(p.cores) * 64;
            }
        }

        Check(aclrtMalloc(&aligned.ptr, xb + wb + cursorExtra, ACL_MEM_MALLOC_HUGE_FIRST));
        paddedWorkspace = (GM_ADDR)aligned.ptr;
    }
    matmul_tiling::MatmulApiTiling t(*platform);
    TCheck(t.SetAType(matmul_tiling::TPosition::GM,
                      matmul_tiling::CubeFormat::ND,
                      matmul_tiling::DataType::DT_INT8,
                      false));
    TCheck(t.SetBType(matmul_tiling::TPosition::GM,
                      NZ ? matmul_tiling::CubeFormat::NZ : matmul_tiling::CubeFormat::ND,
                      matmul_tiling::DataType::DT_INT8,
                      false));
    TCheck(t.SetCType(matmul_tiling::TPosition::GM,
                      matmul_tiling::CubeFormat::ND,
                      matmul_tiling::DataType::DT_INT32));
    if (MERGED && !NZ && SK == 2048 && TM == 64 && TN == 512) {
        TCheck(t.SetOrgShape(64, 1024, p.k));
        TCheck(t.SetShape(64, 1024, p.k));
        TCheck(t.SetFixSplit(64, 512, 64));
    } else if (MERGED && !NZ && SK == 1024 && TM == 128 && TN == 256) {
        TCheck(t.SetOrgShape(128, 512, p.k));
        TCheck(t.SetShape(128, 512, p.k));
        TCheck(t.SetFixSplit(128, 256, 128));
    } else if (MERGED && !NZ && SK == 2048 && TM == 128 && TN == 256) {
        TCheck(t.SetOrgShape(128, 768, p.k));
        TCheck(t.SetShape(128, 768, p.k));
        TCheck(t.SetFixSplit(128, 256, 128));
    } else if (NZ && MERGED) {
        const uint32_t frameN = AlignedExtent(p.wn, TN);
        TCheck(t.SetOrgShape(TM, frameN, p.k));
        TCheck(t.SetShape(TM, frameN, p.k));
        TCheck(t.SetFixSplit(TM, TN, 256));
    } else {
        TCheck(t.SetOrgShape(TM, TN, p.k));
        TCheck(t.SetShape(TM, TN, p.k));
        TCheck(t.SetFixSplit(TM, TN, -1));
    }
    TCheck(t.EnableBias(false));
    TCheck(t.SetBufferSpace(-1, -1, -1));
    TCheck(t.GetTiling(p.cube));
    CheckSelectedCubeResources<TM, TN, NZ, SK, MERGED>(p);
    p.ka = p.rawA ? p.rawK : p.k;
    if constexpr (NZ && MERGED) {
        NzFrameLauncher launcher{x, weight, scale, group_list, y, paddedWorkspace, p, stream};
        DispatchNzFrame<128>(n, launcher);
    } else {
        uint32_t SS = CS;
        Workspace scratch;
        scratch.stream = stream;
        Check(aclrtMalloc(&scratch.ptr, uint64_t(p.cores) * 2 * SS * 4, ACL_MEM_MALLOC_HUGE_FIRST));
        if constexpr (!NZ && !MERGED && TM == 128 && TN == 256 && SK == 512) {
            if (p.cores <= 255) {
                const uint32_t packed =
                    (p.k / 32) | ((p.n / 32) << 8) | (p.e << 16) | (p.cores << 24);
                // Require at least75% useful rows against the worst-case64-row padding budget.
                // Sum_e ceil(M_e/64) <= ceil(M/64)+E-1 for all legal runtime groups.
                const uint64_t taskUpper64 = ((uint64_t(m) + 63) / 64 + e - 1) * ((n + 255) / 256);
                if (m > 64 && taskUpper64 <= p.cores &&
                    uint64_t(m) * 4 >= ((uint64_t(m) + 63) / 64 + e - 1) * 64 * 3) {
                    KernelMediumOneWave<<<p.cores, nullptr, stream>>>(
                        x, weight, scale, group_list, y, (GM_ADDR)scratch.ptr, packed);
                } else {
                    KernelMedium<<<p.cores, nullptr, stream>>>(
                        x, weight, scale, group_list, y, (GM_ADDR)scratch.ptr, packed);
                }
            } else {
                // Preserve the generic ABI for any future platform with a wider corecount.
                Kernel<TM, TN, NZ, SK, MERGED><<<p.cores, nullptr, stream>>>(
                    x, weight, scale, group_list, y, (GM_ADDR)scratch.ptr, paddedWorkspace, p);
            }
        } else
            Kernel<TM, TN, NZ, SK, MERGED><<<p.cores, nullptr, stream>>>(
                x, weight, scale, group_list, y, (GM_ADDR)scratch.ptr, paddedWorkspace, p);
    }
}

// General correctness path; capacities and strides come from actual metadata.
inline void CommonCubeVectorFallback(GM_ADDR x,
                                     GM_ADDR weight,
                                     GM_ADDR scale,
                                     GM_ADDR groups,
                                     GM_ADDR y,
                                     uint32_t m,
                                     uint32_t k,
                                     uint32_t n,
                                     uint32_t e,
                                     int64_t availableCoreNum,
                                     aclrtStream stream) {
    if (uint64_t(m) * n * k <= 2097152)
        Launch<32, 128, false>(x, weight, scale, groups, y, m, k, n, e, availableCoreNum, stream);
    else if (k % 32 == 0 && n % 32 == 0) {
        if (k >= 2048 && n >= 1024 && m / e <= 64)
            Launch<64, 512, false>(
                x, weight, scale, groups, y, m, k, n, e, availableCoreNum, stream);
        else
            Launch<128, 256, false>(
                x, weight, scale, groups, y, m, k, n, e, availableCoreNum, stream);
    } else
        Launch<128, 128, true>(x, weight, scale, groups, y, m, k, n, e, availableCoreNum, stream);
}

// CASE18_19_RANGE_IMPORT_BEGIN
// Generic range implementations imported from kernel多种情况.asc.
// Existing I01 paths and dispatch remain in the enclosing namespace.
namespace AdditionalNzRanges {
template <uint32_t TM, uint32_t TN, bool NZ, uint32_t SK>
__aicore__ constexpr auto ImportedStaticConfig() {
    using A = MatmulType<TPosition::GM, CubeFormat::ND, int8_t, false>;
    using B = MatmulType<TPosition::GM, NZ ? CubeFormat::NZ : CubeFormat::ND, int8_t, false>;
    using C = MatmulType<TPosition::GM, CubeFormat::ND, int32_t>;
    auto c = Config();
    if (SK) {
        c.basicM = TM;
        c.basicN = TN;
        c.basicK = (TM > TN ? 32768 / TM : 32768 / TN);
        if (c.basicK > 256)
            c.basicK = 256;
        c.singleCoreM = TM;
        c.singleCoreN = TN;
        c.singleCoreK = SK;
    }
    if (SK == 2048 && TM == 128 && TN > 512 && TN <= 1024 && !NZ) {
        c.basicN = 256;
        c.basicK = 128;
    }
    if (SK == 1024 && TM == 128 && TN == 512 && !NZ) {
        c.basicN = 256;
        c.basicK = 128;
    }
    auto t = GetMatmulApiTiling<A, B, C, C>(c);
    if (SK == 1024 && TM == 128 && TN == 512 && !NZ) {
        t.stepM = 1;
        t.stepN = 1;
        t.depthA1 = 8;
        t.stepKa = 8;
        t.depthB1 = 4;
        t.stepKb = 2;
        t.shareL1Size = (t.depthA1 * t.baseM + t.depthB1 * t.baseN) * t.baseK;
    }
    if (SK == 2048 && TM == 128 && TN > 512 && TN <= 1024 && !NZ) {
        t.stepM = 1;
        t.stepN = 1;
        t.depthA1 = 16;
        t.stepKa = 16;
        t.depthB1 = 4;
        t.stepKb = 2;
        t.shareL1Size = (t.depthA1 * t.baseM + t.depthB1 * t.baseN) * t.baseK;
    }
    if (SK && TM == 128 && TN == 256) {
        t.stepM = 1;
        t.stepN = 1;
        if (SK == 256) {
            t.depthA1 = 2;
            t.depthB1 = 2;
            t.stepKa = 2;
            t.stepKb = 2;
        }
        if (SK == 512) {
            t.depthA1 = 4;
            t.depthB1 = 4;
            t.stepKa = 4;
            t.stepKb = 4;
        }
        if (SK == 1024) {
            t.depthA1 = 8;
            t.depthB1 = 4;
            t.stepKa = 8;
            t.stepKb = 2;
        }
        if (SK == 2048) {
            t.depthA1 = 16;
            t.depthB1 = 4;
            t.stepKa = 16;
            t.stepKb = 2;
        }
        t.shareL1Size = t.depthA1 * TM * t.baseK + t.depthB1 * TN * t.baseK;
    }
    if (SK && NZ && TM == 128 && TN == 128) {
        t.stepM = 1;
        t.stepN = 1;
        uint32_t depth = SK == 8192 ? 4 : (SK + 255) / 256;
        t.depthA1 = depth;
        t.depthB1 = depth;
        t.stepKa = SK == 8192 ? 2 : depth;
        t.stepKb = t.stepKa;
        t.shareL1Size = (t.depthA1 * TM + t.depthB1 * TN) * t.baseK;
    }
    return t;
}

__aicore__ inline uint32_t ImportedNativePackRows(uint32_t pn) {
    uint32_t rows = (262144 / pn) / 32 * 32;
    return rows < 512 ? rows : 512;
}

__aicore__ inline PadJob ImportedNativeBalancedPadJob(
    uint32_t q, uint32_t e, uint32_t chunk, uint32_t k, uint32_t n, uint32_t pk, uint32_t pn) {
    PadJob t{};
    t.isX = false;
    t.expert = q % e;
    t.row = q / e * chunk;
    t.stride = pn;
    t.cols = n;
    t.rows = pk - t.row;
    if (t.rows > chunk)
        t.rows = chunk;
    t.real = k > t.row ? k - t.row : 0;
    if (t.real > t.rows)
        t.real = t.rows;
    return t;
}

template <bool TailOnly>
__aicore__ inline void ImportedPrefetchNativeWeightsTuned(const LocalTensor<int8_t> &local,
                                                          const GlobalTensor<int8_t> &input,
                                                          const PadJob &job,
                                                          uint32_t k,
                                                          uint32_t n,
                                                          uint32_t capacityRows,
                                                          uint32_t pn) {
    if (job.real < job.rows) {
        if constexpr (TailOnly) {
            const uint32_t padRows = job.rows - job.real;
            InitConstValue(
                local.ReinterpretCast<uint32_t>()[job.real * 8],
                InitConstValueParams<uint32_t>{static_cast<uint16_t>(pn / 32),
                                               static_cast<uint16_t>(padRows),
                                               static_cast<uint16_t>(capacityRows - padRows),
                                               0U});
        } else {
            InitConstValue(local.ReinterpretCast<uint32_t>(),
                           InitConstValueParams<uint32_t>{
                               1, static_cast<uint16_t>(capacityRows * pn / 32), 0, 0U});
        }
        PipeBarrier<PIPE_MTE2>();
    }
    if (job.real) {
        Nd2NzParams cp{};
        cp.ndNum = 1;
        cp.nValue = job.real;
        cp.dValue = n;
        cp.srcDValue = n;
        cp.dstNzC0Stride = capacityRows;
        cp.dstNzNStride = 1;
        DataCopy(local, input[(uint64_t(job.expert) * k + job.row) * n], cp);
    }
}

template <uint32_t RowsHint, bool TailOnly>
__aicore__ inline void ImportedPadWeightsNativeRows(
    GM_ADDR w, GM_ADDR wp, uint32_t k, uint32_t n, uint32_t e, uint32_t pk, uint32_t pn) {
    uint32_t rows = ImportedNativePackRows(pn);
    if constexpr (RowsHint > 0) {
        if (rows > RowsHint)
            rows = RowsHint;
    }
    const uint32_t bytes = rows * pn, wt = (pk + rows - 1) / rows, total = e * wt;
    const uint32_t firstTask = GetBlockIdx(), step = GetBlockNum();
    if (firstTask >= total)
        return;
    uint32_t slots = 512 * 1024 / bytes;
    if (slots > 4)
        slots = 4;
    TPipe pipe;
    TBuf<TPosition::B1> arenaB;
    pipe.InitBuffer(arenaB, slots * bytes);
    auto arena = arenaB.Get<int8_t>();
    GlobalTensor<int8_t> input, output;
    input.SetGlobalBuffer((__gm__ int8_t *)w);
    output.SetGlobalBuffer((__gm__ int8_t *)wp);
    TEventID ready[4], retire[4];
    bool used[4] = {false, false, false, false};
    for (uint32_t i = 0; i < slots; i++) {
        ready[i] = pipe.AllocEventID<HardEvent::MTE2_MTE3>();
        retire[i] = pipe.AllocEventID<HardEvent::MTE3_MTE2>();
        const uint32_t task = firstTask + i * step;
        if (task < total) {
            ImportedPrefetchNativeWeightsTuned<TailOnly>(
                arena[i * bytes],
                input,
                ImportedNativeBalancedPadJob(task, e, rows, k, n, pk, pn),
                k,
                n,
                rows,
                pn);
            SetFlag<HardEvent::MTE2_MTE3>(ready[i]);
            used[i] = true;
        }
    }
    uint32_t slot = 0;
    for (uint32_t task = firstTask; task < total; task += step) {
        WaitFlag<HardEvent::MTE2_MTE3>(ready[slot]);
        const PadJob job = ImportedNativeBalancedPadJob(task, e, rows, k, n, pk, pn);
        DataCopyParams cp{static_cast<uint16_t>(pn / 32),
                          static_cast<uint16_t>(job.rows),
                          static_cast<uint16_t>(rows - job.rows),
                          static_cast<uint16_t>(pk - job.rows)};
        DataCopy(output[uint64_t(job.expert) * pk * pn + uint64_t(job.row) * 32],
                 arena[slot * bytes],
                 cp);
        SetFlag<HardEvent::MTE3_MTE2>(retire[slot]);
        const uint32_t next = task + slots * step;
        if (next < total) {
            WaitFlag<HardEvent::MTE3_MTE2>(retire[slot]);
            ImportedPrefetchNativeWeightsTuned<TailOnly>(
                arena[slot * bytes],
                input,
                ImportedNativeBalancedPadJob(next, e, rows, k, n, pk, pn),
                k,
                n,
                rows,
                pn);
            SetFlag<HardEvent::MTE2_MTE3>(ready[slot]);
        }
        if (++slot == slots)
            slot = 0;
    }
    for (uint32_t i = 0; i < slots; i++) {
        if (used[i])
            WaitFlag<HardEvent::MTE3_MTE2>(retire[i]);
        pipe.ReleaseEventID<HardEvent::MTE2_MTE3>(ready[i]);
        pipe.ReleaseEventID<HardEvent::MTE3_MTE2>(retire[i]);
    }
}

__aicore__ inline GM_ADDR RangeDeepStateBase(GM_ADDR packed, const Plan &p) {
    return (GM_ADDR)((__gm__ uint8_t *)packed + uint64_t(p.e) * p.k * p.wn);
}

__aicore__ inline void PrepareRangeDeepStates(GM_ADDR groups, GM_ADDR packed, const Plan &p) {
    TPipe pipe;
    TBuf<TPosition::VECCALC> gb, pb, wb, ab;
    pipe.InitBuffer(gb, (p.e * 8 + 31) / 32 * 32);
    pipe.InitBuffer(pb, ((p.e + 1) * 4 + 31) / 32 * 32);
    pipe.InitBuffer(wb, p.cores * 64);
    pipe.InitBuffer(ab, 544);
    auto ends = gb.Get<int64_t>();
    auto prefix = pb.Get<uint32_t>();
    auto words = wb.Get<uint64_t>();
    GlobalTensor<int64_t> input;
    input.SetGlobalBuffer((__gm__ int64_t *)groups);
    DataCopyExtParams cp{1, p.e * 8, 0, 0, 0};
    DataCopyPadExtParams<int64_t> pad{false, 0, 0, 0};
    DataCopyPad(ends, input, cp, pad);
    Sync<HardEvent::MTE2_S>(pipe);
    auto active = ab.Get<uint32_t>();
    for (uint32_t i = 0; i < 136; i++)
        active.SetValue(i, 0);
    uint32_t previous = 0, total = 0, activeCount = 0;
    prefix.SetValue(0, 0);
    for (uint32_t expert = 0; expert < p.e; expert++) {
        const uint32_t end = static_cast<uint32_t>(ends.GetValue(expert));
        if (end > previous)
            active.SetValue(8 + activeCount++, expert);
        total += (end - previous + 127) / 128;
        prefix.SetValue(expert + 1, total);
        previous = end;
    }
    for (uint32_t core = 0; core < p.cores; core++) {
        const uint32_t first = total * core / p.cores, limit = total * (core + 1) / p.cores;
        uint32_t lo = 0, hi = p.e;
        while (lo < hi) {
            const uint32_t mid = (lo + hi) / 2;
            if (prefix.GetValue(mid + 1) <= first)
                lo = mid + 1;
            else
                hi = mid;
        }
        uint32_t start = 0, end = 0, local = 0;
        if (lo < p.e) {
            start = lo ? static_cast<uint32_t>(ends.GetValue(lo - 1)) : 0;
            end = static_cast<uint32_t>(ends.GetValue(lo));
            local = first - prefix.GetValue(lo);
        }
        words.SetValue(core * 8, uint64_t(lo) << 32 | start);
        words.SetValue(core * 8 + 1, uint64_t(end) << 32 | local);
        words.SetValue(core * 8 + 2, uint64_t(limit - first));
        for (uint32_t i = 3; i < 8; i++)
            words.SetValue(core * 8 + i, 0);
    }
    GlobalTensor<uint64_t> output;
    output.SetGlobalBuffer((__gm__ uint64_t *)RangeDeepStateBase(packed, p));
    active.SetValue(0, activeCount);
    GlobalTensor<uint32_t> activeOutput;
    activeOutput.SetGlobalBuffer((__gm__ uint32_t *)(RangeDeepStateBase(packed, p) + p.cores * 64));
    Sync<HardEvent::S_MTE3>(pipe);
    DataCopy(output, words, p.cores * 8);
    DataCopy(activeOutput, active, 136);
    Sync<HardEvent::MTE3_S>(pipe);
}

__aicore__ inline PadJob DeepActivePackJob(uint32_t task,
                                           uint32_t experts,
                                           const LocalTensor<uint32_t> &active,
                                           const Plan &p) {
    PadJob job = ImportedNativeBalancedPadJob(task, experts, 512, p.rawK, p.n, p.k, 32);
    job.expert = active.GetValue(8 + job.expert);
    return job;
}

__aicore__ inline void PrefetchDeepActivePack(const LocalTensor<int8_t> &local,
                                              const GlobalTensor<int8_t> &input,
                                              const PadJob &job,
                                              const Plan &p) {
    if (job.real < job.rows) {
        Duplicate(
            local.ReinterpretCast<int32_t>()[job.real * 8], int32_t(0), (job.rows - job.real) * 8);
        SetFlag<HardEvent::V_MTE2>(0);
        WaitFlag<HardEvent::V_MTE2>(0);
    }
    if (job.real) {
        DataCopyExtParams cp{static_cast<uint16_t>(job.real), p.n, 0, 0, 0};
        DataCopyPadExtParams<int8_t> pad{true, 0, static_cast<uint8_t>(32 - p.n), 0};
        DataCopyPad(local, input[(uint64_t(job.expert) * p.rawK + job.row) * p.n], cp, pad);
    }
}

template <uint32_t TM, uint32_t TN>
__aicore__ inline void
DeepRangePackedDeep(GM_ADDR scale, GM_ADDR groups, GM_ADDR y, GM_ADDR workspace, const Plan &p) {
    InitSocState();
    const uint32_t n = p.n;
    constexpr uint32_t CS = TM * TN, VS = CS > 8192 ? 8192 : CS, VR = VS / TN;
    constexpr uint32_t RAW = 0;
    constexpr uint32_t Z = RAW + VS * 4 + 256;
    constexpr uint32_t INNER = Z + VS * 4 + 256;
    constexpr uint32_t DEN = INNER + VS * 4 + 256;
    constexpr uint32_t NUM = DEN + VS * 4 + 256;
    constexpr uint32_t HALF = NUM + VS * 4 + 256;
    constexpr uint32_t SCALE = HALF + VS * 2;
    constexpr uint32_t MASK = SCALE + TN * 4;
    constexpr uint32_t GROUP = MASK + VS / 8;
    constexpr uint32_t END = GROUP + 128 * 8;
    static_assert(END <= 192 * 1024, "generic Deep static UB capacity");
    LocalTensor<int32_t> raw(TPosition::VECCALC, RAW, VS + 64);
    LocalTensor<float> z(TPosition::VECCALC, Z, VS + 64);
    LocalTensor<float> inner(TPosition::VECCALC, INNER, VS + 64);
    LocalTensor<float> den(TPosition::VECCALC, DEN, VS + 64);
    LocalTensor<float> num(TPosition::VECCALC, NUM, VS + 64);
    LocalTensor<half> result(TPosition::VECCALC, HALF, VS);
    LocalTensor<float> coeff(TPosition::VECCALC, SCALE, TN);
    LocalTensor<uint8_t> mask(TPosition::VECCALC, MASK, VS / 8);
    LocalTensor<int64_t> localEnds(TPosition::VECCALC, GROUP, 128);
    // No queue allocates hard events here. Each local event0 is set/wait paired
    // before same-direction reuse; cross-core ring flags8/9 stay independent.
    GlobalTensor<int32_t> ring;
    GlobalTensor<float> sg;
    GlobalTensor<half> out;
    GlobalTensor<int64_t> ends;
    ring.SetGlobalBuffer((__gm__ int32_t *)workspace);
    sg.SetGlobalBuffer((__gm__ float *)scale);
    out.SetGlobalBuffer((__gm__ half *)y);
    ends.SetGlobalBuffer((__gm__ int64_t *)groups);
    DataCopyExtParams gcp{1, p.e * 8U, 0, 0, 0};
    DataCopyPadExtParams<int64_t> gp{false, 0, 0, 0};
    DataCopyPad(localEnds, ends, gcp, gp);
    SetFlag<HardEvent::MTE2_S>(0);
    WaitFlag<HardEvent::MTE2_S>(0);
    uint32_t core = GetBlockIdx() / 2, sequence = 0, start = 0, base = 0, nt = (n + TN - 1) / TN;
    uint32_t total = 0, previous = 0;
    for (uint32_t i = 0; i < p.e; i++) {
        const uint32_t end = static_cast<uint32_t>(localEnds.GetValue(i));
        total += (end - previous + TM - 1) / TM * nt;
        previous = end;
    }
    const uint32_t tileBegin = total * core / p.cores, tileEnd = total * (core + 1) / p.cores;
    for (uint32_t e = 0; e < p.e; e++) {
        uint32_t end = static_cast<uint32_t>(localEnds.GetValue(e));
        uint32_t mt = (end - start + TM - 1) / TM, tasks = mt * nt;
        uint32_t first = tileBegin > base ? tileBegin - base : 0;
        uint32_t limit = tileEnd > base ? ((tileEnd - base < tasks) ? tileEnd - base : tasks) : 0;
        for (uint32_t task = first; task < limit; task++, sequence++) {
            uint32_t row = start + task / nt * TM, col = task % nt * TN;
            uint32_t totalRows = end - row < TM ? end - row : TM,
                     cols = n - col < TN ? n - col : TN;
            uint32_t aligned = (cols + 7) / 8 * 8;
            CrossCoreWaitFlag<2>(8);
            uint32_t halfRows = (totalRows + 1) / 2;
            uint32_t subStart = GetSubBlockIdx() * halfRows;
            uint32_t subEnd = subStart + halfRows < totalRows ? subStart + halfRows : totalRows;
            if (subStart >= subEnd)
                CrossCoreSetFlag<2, PIPE_MTE2>(9);
            for (uint32_t vrow = subStart; vrow < subEnd; vrow += VR) {
                uint32_t rows = subEnd - vrow < VR ? subEnd - vrow : VR;
                if (cols < TN)
                    Duplicate(raw, 0, VS);
                if ((rows * TN) % 64)
                    Duplicate(raw[rows * TN], int32_t(0), 64 - (rows * TN) % 64);
                SetFlag<HardEvent::V_MTE2>(0);
                WaitFlag<HardEvent::V_MTE2>(0);
                DataCopyExtParams cp{static_cast<uint16_t>(rows),
                                     cols * 4U,
                                     (TN - cols) * 4U,
                                     (TN - aligned) / 8,
                                     0};
                DataCopyPadExtParams<int32_t> pad{true, 0, static_cast<uint8_t>(aligned - cols), 0};
                DataCopyPad(raw, ring[(core * 2 + sequence % 2) * CS + vrow * TN], cp, pad);
                DataCopyExtParams scp{1, cols * 4U, 0, 0, 0};
                DataCopyPadExtParams<float> sp{true, 0, static_cast<uint8_t>(aligned - cols), 0.0f};
                if (vrow == subStart)
                    DataCopyPad(coeff, sg[uint64_t(e) * n + col], scp, sp);
                if (vrow + rows == subEnd)
                    CrossCoreSetFlag<2, PIPE_MTE2>(9);
                SetFlag<HardEvent::MTE2_V>(0);
                WaitFlag<HardEvent::MTE2_V>(0);
                const uint32_t count = (rows * TN + 63) / 64 * 64;
                Cast(z, raw, RoundMode::CAST_NONE, count);
                PipeBarrier<PIPE_V>();
                for (uint32_t off = 0; off < cols; off += 64) {
                    Mul(z[off],
                        z[off],
                        coeff[off],
                        cols - off < 64 ? cols - off : 64,
                        rows,
                        {1, 1, 1, TN / 8, TN / 8, 0});
                }
                PipeBarrier<PIPE_V>();
                // Copied padding is zero, so the entire aligned tile is initialized.
                // FP32 stable sigmoid form of tanh GELU; convert to FP16 only after activation.
                Abs(num, z, count);
                PipeBarrier<PIPE_V>();
                Mul(inner, num, num, count);
                PipeBarrier<PIPE_V>();
                Muls(inner, inner, -0.07135481627330025f, count);
                PipeBarrier<PIPE_V>();
                Adds(inner, inner, -1.5957691216057308f, count);
                PipeBarrier<PIPE_V>();
                Mul(inner, inner, num, count);
                PipeBarrier<PIPE_V>();
                Exp(inner, inner, count);
                PipeBarrier<PIPE_V>();
                Adds(den, inner, 1.0f, count);
                PipeBarrier<PIPE_V>();
                Div(num, z, den, count);
                PipeBarrier<PIPE_V>();
                Mul(den, num, inner, count);
                PipeBarrier<PIPE_V>();
                CompareScalar(mask, z, 0.0f, CMPMODE::GE, count);
                PipeBarrier<PIPE_V>();
                Select(z, mask, num, den, SELMODE::VSEL_TENSOR_TENSOR_MODE, count);
                PipeBarrier<PIPE_V>();
                Cast(result, z, RoundMode::CAST_RINT, rows * TN);
                SetFlag<HardEvent::V_MTE3>(0);
                WaitFlag<HardEvent::V_MTE3>(0);

                uint32_t ah = (cols + 15) / 16 * 16;
                DataCopyExtParams ocp{
                    static_cast<uint16_t>(rows), cols * 2U, (TN - ah) / 16, (n - cols) * 2U, 0};
                DataCopyPad(out[uint64_t(row + vrow) * n + col], result, ocp);
                SetFlag<HardEvent::MTE3_V>(0);
                WaitFlag<HardEvent::MTE3_V>(0);
            }
        }
        start = end;
        base += tasks;
    }
    // Match the AIV TPipe destructor after all task and idle paths.
    PipeBarrier<PIPE_ALL>();
}

__aicore__ inline void
PadWeightsMidIssueGroups(GM_ADDR w, GM_ADDR groups, GM_ADDR packed, const Plan &p) {
    constexpr uint32_t ROWS = 512, SLOTS = 4, BYTES = ROWS * 32;
    TPipe pipe;
    TBuf<TPosition::VECCALC> meta, storage, groupBuffer;
    pipe.InitBuffer(groupBuffer, (p.e * 8 + 31) / 32 * 32);
    pipe.InitBuffer(meta, 544);
    pipe.InitBuffer(storage, SLOTS * BYTES);
    auto active = meta.Get<uint32_t>();
    auto arena = storage.Get<int8_t>();
    // All vector cores derive current active IDs locally; packing overlaps AIV0 cursor preparation.
    GlobalTensor<int64_t> endsInput;
    endsInput.SetGlobalBuffer((__gm__ int64_t *)groups);
    auto ends = groupBuffer.Get<int64_t>();
    DataCopyExtParams gc{1, p.e * 8, 0, 0, 0};
    DataCopyPadExtParams<int64_t> gp{false, 0, 0, 0};
    DataCopyPad(ends, endsInput, gc, gp);
    Sync<HardEvent::MTE2_S>(pipe);
    uint32_t experts = 0, previous = 0;
    for (uint32_t expert = 0; expert < p.e; expert++) {
        const uint32_t end = static_cast<uint32_t>(ends.GetValue(expert));
        if (end > previous)
            active.SetValue(8 + experts++, expert);
        previous = end;
    }
    const uint32_t total = experts * ((p.k + ROWS - 1) / ROWS);
    const uint32_t first = GetBlockIdx(), step = p.cores * 2;
    if (first >= total)
        return;
    GlobalTensor<int8_t> input, output;
    input.SetGlobalBuffer((__gm__ int8_t *)w);
    output.SetGlobalBuffer((__gm__ int8_t *)packed);
    TEventID ready[SLOTS], retire[SLOTS], vectorRetire[SLOTS];
    bool used[SLOTS] = {false, false, false, false};
    for (uint32_t i = 0; i < SLOTS; i++) {
        ready[i] = pipe.AllocEventID<HardEvent::MTE2_MTE3>();
        retire[i] = pipe.AllocEventID<HardEvent::MTE3_MTE2>();
        vectorRetire[i] = pipe.AllocEventID<HardEvent::MTE3_V>();
        const uint32_t task = first + i * step;
        if (task < total) {
            const PadJob job = DeepActivePackJob(task, experts, active, p);
            PrefetchDeepActivePack(arena[i * BYTES], input, job, p);
            SetFlag<HardEvent::MTE2_MTE3>(ready[i]);
            used[i] = true;
        }
    }
    uint32_t slot = 0;
    for (uint32_t task = first; task < total; task += step) {
        WaitFlag<HardEvent::MTE2_MTE3>(ready[slot]);
        const PadJob job = DeepActivePackJob(task, experts, active, p);
        DataCopy(output[(uint64_t(job.expert) * p.k + job.row) * 32],
                 arena[slot * BYTES],
                 job.rows * 32);
        SetFlag<HardEvent::MTE3_MTE2>(retire[slot]);
        SetFlag<HardEvent::MTE3_V>(vectorRetire[slot]);
        const uint32_t next = task + SLOTS * step;
        if (next < total) {
            WaitFlag<HardEvent::MTE3_MTE2>(retire[slot]);
            WaitFlag<HardEvent::MTE3_V>(vectorRetire[slot]);
            const PadJob pending = DeepActivePackJob(next, experts, active, p);
            PrefetchDeepActivePack(arena[slot * BYTES], input, pending, p);
            SetFlag<HardEvent::MTE2_MTE3>(ready[slot]);
        }
        if (++slot == SLOTS)
            slot = 0;
    }
    for (uint32_t i = 0; i < SLOTS; i++) {
        if (used[i]) {
            WaitFlag<HardEvent::MTE3_MTE2>(retire[i]);
            WaitFlag<HardEvent::MTE3_V>(vectorRetire[i]);
        }
        pipe.ReleaseEventID<HardEvent::MTE2_MTE3>(ready[i]);
        pipe.ReleaseEventID<HardEvent::MTE3_MTE2>(retire[i]);
        pipe.ReleaseEventID<HardEvent::MTE3_V>(vectorRetire[i]);
    }
}

__aicore__ inline uint32_t RangeMidIssue32Stage(const Plan &p) {
    const uint32_t capacity = ((512U * 1024U - 32U * p.k) / (2U * 128U)) / 32U * 32U;
    return p.k < capacity ? p.k : capacity;
}

template <typename QA>
__aicore__ inline void PrefetchRangeMidIssue32A(QA &aq,
                                                const GlobalTensor<int8_t> &a,
                                                const Plan &p,
                                                uint32_t row,
                                                uint32_t rows,
                                                uint32_t mpad,
                                                uint32_t at) {
    const uint32_t stage = RangeMidIssue32Stage(p);
    const uint32_t slice = p.rawK - at < stage ? p.rawK - at : stage;
    auto al = aq.template AllocTensor<int8_t>();
    Nd2NzParams ac{};
    ac.ndNum = 1;
    ac.nValue = rows;
    ac.dValue = slice;
    ac.srcDValue = p.rawK;
    ac.dstNzC0Stride = mpad;
    ac.dstNzNStride = 1;
    DataCopy(al, a[uint64_t(row) * p.rawK + at], ac);
    aq.EnQue(al);
}

template <uint32_t TN>
__aicore__ inline void CubeRangeMidIssue32(
    GM_ADDR x, GM_ADDR weight, GM_ADDR groups, GM_ADDR workspace, GM_ADDR prepared, const Plan &p) {
    constexpr uint32_t TM = 128, CS = TM * TN, CAP = 4096, STEP = 256;
    const uint32_t STAGE = RangeMidIssue32Stage(p);
    static_assert(TN == 32,
                  "single packed NZ channel plane"); // 2*TM*STAGE+TN*p.k <=512KiB by construction.
    static_assert(2 * TM * STEP <= 64 * 1024 && 2 * TN * STEP <= 64 * 1024 &&
                      2 * CS * 4 <= 128 * 1024,
                  "range reuse L0 budgets");
    TPipe pipe;
    TQue<TPosition::A1, 2> aq;
    TQue<TPosition::B1, 1> bq;
    TQue<TPosition::A2, 2> a2q;
    TQue<TPosition::B2, 2> b2q;
    TQue<TPosition::CO1, 2> cq;
    pipe.InitBuffer(aq, 2, TM * STAGE);
    pipe.InitBuffer(bq, 1, TN * p.k);
    pipe.InitBuffer(a2q, 2, TM * STEP);
    pipe.InitBuffer(b2q, 2, TN * STEP);
    pipe.InitBuffer(cq, 2, CS * 4);
    GlobalTensor<int8_t> a, b;
    GlobalTensor<int64_t> ends;
    GlobalTensor<int32_t> ring;
    a.SetGlobalBuffer((__gm__ int8_t *)x);
    b.SetGlobalBuffer((__gm__ int8_t *)weight);
    ends.SetGlobalBuffer((__gm__ int64_t *)groups);
    ring.SetGlobalBuffer((__gm__ int32_t *)workspace);
    const uint32_t core = GetBlockIdx(), npad = (p.n + 31) / 32 * 32;
    constexpr uint32_t matrixN =
        32; // N16 logical range computes fresh zero N padding to avoid small-matrix issue waits.
    GlobalTensor<uint64_t> states;
    states.SetGlobalBuffer((__gm__ uint64_t *)prepared);
    auto record = states[core * 8];
    DataCacheCleanAndInvalid<uint64_t, CacheLine::SINGLE_CACHE_LINE, DcciDst::CACHELINE_OUT>(
        record);
    const uint64_t w0 = record.GetValue(0), w1 = record.GetValue(1);
    uint32_t remaining = static_cast<uint32_t>(record.GetValue(2));
    uint32_t expert = w0 >> 32, start = static_cast<uint32_t>(w0), end = w1 >> 32;
    uint32_t first = static_cast<uint32_t>(w1), sequence = 0;
    while (remaining && expert < p.e) {
        const uint32_t tasks = (end - start + TM - 1) / TM;
        const uint32_t limit = first + remaining < tasks ? first + remaining : tasks;
        if (first < limit) {
            auto bl = bq.AllocTensor<int8_t>();
            DataCopyParams bc{1, static_cast<uint16_t>(p.k * npad / 32), 0, 0};
            DataCopy(bl, b[uint64_t(expert) * p.k * p.wn], bc);
            bq.EnQue(bl);
            bl = bq.DeQue<int8_t>();
            for (uint32_t task = first; task < limit; task++, sequence++) {
                const uint32_t row = start + task * TM, rows = end - row < TM ? end - row : TM;
                const uint32_t mpad = NzPackedRows(rows);
                PrefetchRangeMidIssue32A(aq, a, p, row, rows, mpad, 0);
                auto c = cq.AllocTensor<int32_t>();
                for (uint32_t at = 0; at < p.k; at += STAGE) {
                    const uint32_t slice = p.k - at < STAGE ? p.k - at : STAGE;
                    auto al = aq.DeQue<int8_t>();
                    if (at + slice < p.k)
                        PrefetchRangeMidIssue32A(aq, a, p, row, rows, mpad, at + slice);
                    for (uint32_t local = 0; local < slice; local += STEP) {
                        const uint32_t inner = slice - local < STEP ? slice - local : STEP,
                                       global = at + local;
                        auto a2 = a2q.AllocTensor<int8_t>();
                        auto b2 = b2q.AllocTensor<int8_t>();
                        LoadData2DParams la{};
                        la.ifTranspose = false;
                        if (inner / 32 < mpad / 16) {
                            la.repeatTimes = mpad / 16;
                            la.srcStride = 1;
                            la.dstGap = inner / 32 - 1;
                            for (uint32_t kb = 0; kb < inner / 32; kb++)
                                LoadData(a2[kb * 512], al[(local + kb * 32) * mpad], la);
                        } else {
                            la.repeatTimes = inner / 32;
                            la.srcStride = mpad / 16;
                            for (uint32_t mb = 0; mb < mpad / 16; mb++)
                                LoadData(a2[mb * inner * 16], al[local * mpad + mb * 512], la);
                        }
                        LoadData2dTransposeParams lb{};
                        lb.dstFracGap = 0;
                        if (matrixN == 16) {
                            lb.repeatTimes = inner / 32;
                            lb.srcStride = 1;
                            lb.dstGap = 0;
                            lb.dstFracGap = inner / 32 - 1;
                            LoadDataWithTranspose(b2, bl[global * 32], lb);
                        } else if (inner > npad) {
                            lb.repeatTimes = inner / 32;
                            lb.srcStride = 1;
                            lb.dstGap = npad / 16 - 1;
                            for (uint32_t nb = 0; nb < npad / 32; nb++)
                                LoadDataWithTranspose(
                                    b2[nb * 1024], bl[global * 32 + nb * p.k * 32], lb);
                        } else {
                            lb.repeatTimes = npad / 32;
                            lb.srcStride = p.k / 32;
                            lb.dstGap = 1;
                            for (uint32_t kb = 0; kb < inner / 32; kb++)
                                LoadDataWithTranspose(
                                    b2[kb * npad * 32], bl[(global + kb * 32) * 32], lb);
                        }
                        a2q.EnQue(a2);
                        b2q.EnQue(b2);
                        a2 = a2q.DeQue<int8_t>();
                        b2 = b2q.DeQue<int8_t>();
                        MmadParams mm{};
                        mm.m = mpad;
                        mm.n = matrixN;
                        mm.k = inner;
                        mm.cmatrixInitVal = global == 0;
                        Mmad(c, a2, b2, mm);
                        if ((mpad / 16) * (matrixN / 16) < 10)
                            PipeBarrier<PIPE_M>();
                        a2q.FreeTensor(a2);
                        b2q.FreeTensor(b2);
                    }
                    aq.FreeTensor(al);
                }
                cq.EnQue(c);
                c = cq.DeQue<int32_t>();
                if (sequence >= 2)
                    CrossCoreWaitFlag<2>(9);
                FixpipeParamsV220 fp{};
                fp.nSize = matrixN;
                fp.mSize = rows;
                fp.srcStride = mpad;
                fp.dstStride = TN;
                fp.ndNum = 1;
                Fixpipe(ring[(core * 2 + sequence % 2) * CS], c, fp);
                CrossCoreSetFlag<2, PIPE_FIX>(8);
                cq.FreeTensor(c);
            }
            bq.FreeTensor(bl);
        }
        remaining -= limit - first;
        start = end;
        ++expert;
        first = 0;
        if (remaining && expert < p.e)
            end = static_cast<uint32_t>(ends.GetValue(expert));
    }
    for (uint32_t i = 0; i < (sequence < 2 ? sequence : 2); i++)
        CrossCoreWaitFlag<2>(9);
}

template <uint32_t TN>
__global__ __aicore__ void RangeMidIssue32Kernel(GM_ADDR x,
                                                 GM_ADDR w,
                                                 GM_ADDR scale,
                                                 GM_ADDR groups,
                                                 GM_ADDR y,
                                                 GM_ADDR workspace,
                                                 GM_ADDR packedWeights,
                                                 Plan p) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
    InitSocState();
    if ASCEND_IS_AIV {
        if (GetBlockIdx() == 0)
            PrepareRangeDeepStates(groups, packedWeights, p);
        PadWeightsMidIssueGroups(w, groups, packedWeights, p);
    }
    SyncAll<false>();
    if ASCEND_IS_AIC {
        CubeRangeMidIssue32<TN>(
            x, packedWeights, groups, workspace, RangeDeepStateBase(packedWeights, p), p);
    } else {
        DeepRangePackedDeep<128, TN>(scale, groups, y, workspace, p);
    }
}

inline void LaunchRangeMidIssue32(GM_ADDR x,
                                  GM_ADDR w,
                                  GM_ADDR scale,
                                  GM_ADDR groups,
                                  GM_ADDR y,
                                  uint32_t m,
                                  uint32_t k,
                                  uint32_t n,
                                  uint32_t e,
                                  int64_t availableCoreNum,
                                  aclrtStream stream) {
    auto *platform = platform_ascendc::PlatformAscendCManager::GetInstance();
    if (!platform || availableCoreNum <= 0)
        throw std::runtime_error("range reuse platform unavailable");
    Plan p{};
    p.m = m;
    p.k = (k + 31) / 32 * 32;
    p.rawK = k;
    p.ka = k;
    p.n = n;
    p.wn = (n + 31) / 32 * 32;
    p.e = e;
    p.cores = std::min<int64_t>(availableCoreNum, platform->GetCoreNumAic());
    if (!p.cores)
        throw std::runtime_error("range reuse no cores");
    Workspace scratch;
    scratch.stream = stream;
    Check(aclrtMalloc(&scratch.ptr,
                      uint64_t(p.cores) * 2 * 128 * (n <= 32 ? 32 : 64) * 4,
                      ACL_MEM_MALLOC_HUGE_FIRST));
    Workspace packed;
    packed.stream = stream;
    Check(aclrtMalloc(
        &packed.ptr, uint64_t(e) * p.k * p.wn + p.cores * 64 + 544, ACL_MEM_MALLOC_HUGE_FIRST));
    RangeMidIssue32Kernel<32><<<p.cores, nullptr, stream>>>(
        x, w, scale, groups, y, (GM_ADDR)scratch.ptr, (GM_ADDR)packed.ptr, p);
}

using u32 = uint32_t;
using u64 = uint64_t;
using i32 = int32_t;
using i64 = int64_t;
using i8 = int8_t;

__aicore__ constexpr auto WideStaticConfig1344() {
    auto q = ImportedStaticConfig<128, 256, true, 8192>();
    q.stepM = 1;
    q.stepN = 1;
    q.depthA1 = 8;
    q.depthB1 = 8;
    q.stepKa = 4;
    q.stepKb = 4;
    q.shareL1Size = (q.depthA1 * 128 + q.depthB1 * 256) * q.baseK;
    return q;
}

constexpr auto WIDE_CFG1344 = WideStaticConfig1344();

__aicore__ constexpr auto NarrowStaticConfig1264() {
    auto q = ImportedStaticConfig<128, 64, true, 8192>();
    q.stepM = 1;
    q.stepN = 1;
    q.depthA1 = 4;
    q.depthB1 = 4;
    q.stepKa = 2;
    q.stepKb = 2;
    q.shareL1Size = (q.depthA1 * 128 + q.depthB1 * 64) * q.baseK;
    return q;
}

constexpr auto NARROW_CFG1264 = NarrowStaticConfig1264();

template <u32 TM, u32 TN> __aicore__ constexpr auto WideNdConfig1676() {
    auto q = ImportedStaticConfig<TM, TN, false, 8192>();
    q.stepM = 1;
    q.stepN = 1;
    q.depthA1 = 8;
    q.depthB1 = 8;
    q.stepKa = 4;
    q.stepKb = 4;
    q.shareL1Size = (q.depthA1 * TM + q.depthB1 * TN) * q.baseK;
    return q;
}

template <u32 TM, u32 TN> constexpr auto WIDE_ND_CFG1676 = WideNdConfig1676<TM, TN>();

template <u32 TM, u32 TN, u32 MODE> __aicore__ constexpr auto RangeCubeConfig1972() {
    if constexpr (MODE == 0)
        return WIDE_CFG1344;
    else if constexpr (MODE == 1)
        return NARROW_CFG1264;
    else
        return WIDE_ND_CFG1676<TM, TN>;
}

template <u32 TM, u32 TN, u32 MODE>
constexpr auto RANGE_CUBE_CFG1972 = RangeCubeConfig1972<TM, TN, MODE>();

inline Plan BuildRangePlan19681(
    u32 m, u32 k, u32 n, u32 e, i64 coreCount, platform_ascendc::PlatformAscendC *platform) {
    Plan p{};
    p.m = m;
    p.k = AlignedExtent(k, 32);
    p.rawK = k;
    p.n = n;
    p.wn = AlignedExtent(n, 32);
    p.e = e;
    p.cores = std::min<i64>(coreCount, platform->GetCoreNumAic());
    return p;
}

template <bool NZ>
inline void ConfigureRangeCube1968(
    platform_ascendc::PlatformAscendC &platform, Plan &p, u32 tm, u32 tn, i32 sm, i32 sn, i32 sk) {
    matmul_tiling::MatmulApiTiling t(platform);
    TCheck(t.SetAType(matmul_tiling::TPosition::GM,
                      matmul_tiling::CubeFormat::ND,
                      matmul_tiling::DataType::DT_INT8,
                      false));
    TCheck(t.SetBType(matmul_tiling::TPosition::GM,
                      NZ ? matmul_tiling::CubeFormat::NZ : matmul_tiling::CubeFormat::ND,
                      matmul_tiling::DataType::DT_INT8,
                      false));
    TCheck(t.SetCType(matmul_tiling::TPosition::GM,
                      matmul_tiling::CubeFormat::ND,
                      matmul_tiling::DataType::DT_INT32));
    TCheck(t.SetOrgShape(tm, tn, p.k));
    TCheck(t.SetShape(tm, tn, p.k));
    TCheck(t.SetFixSplit(sm, sn, sk));
    TCheck(t.EnableBias(false));
    TCheck(t.SetBufferSpace(-1, -1, -1));
    TCheck(t.GetTiling(p.cube));
}

template <u32 TM, u32 TN, bool CONTIGUOUS, bool NARROW_SEED>
__aicore__ inline void
VectorCompactPolicy784(GM_ADDR scale, GM_ADDR groups, GM_ADDR y, GM_ADDR workspace, const Plan &p) {
    InitSocState();
    const u32 n = p.n;
    constexpr u32 CS = TM * TN, VS = CS > 8192 ? 8192 : CS, VR = VS / TN;
    constexpr u32 RAW = 0, RAW_WORDS = VS + 64;
    constexpr u32 Z = RAW + 2 * RAW_WORDS * 4;
    constexpr u32 INNER = Z + VS * 4 + 256;
    constexpr u32 HALF = INNER + VS * 4 + 256;
    constexpr u32 SCALE = HALF + 2 * VS * 2;
    constexpr u32 GROUP = SCALE + 2 * TN * 4;
    constexpr u32 END = GROUP + 128 * 8;
    static_assert(END <= 192 * 1024, "Short asynchronous static UB capacity");
    LocalTensor<i32> rawSpace(TPosition::VECCALC, RAW, 2 * RAW_WORDS);
    LocalTensor<float> z(TPosition::VECCALC, Z, VS + 64);
    LocalTensor<float> inner(TPosition::VECCALC, INNER, VS + 64);
    LocalTensor<half> resultSpace(TPosition::VECCALC, HALF, 2 * VS);
    LocalTensor<float> coeffSpace(TPosition::VECCALC, SCALE, 2 * TN);
    LocalTensor<i64> localEnds(TPosition::VECCALC, GROUP, 128);
    GlobalTensor<i32> ring;
    GlobalTensor<float> sg;
    GlobalTensor<half> out;
    GlobalTensor<i64> ends;
    ring.SetGlobalBuffer((__gm__ i32 *)workspace);
    sg.SetGlobalBuffer((__gm__ float *)scale);
    out.SetGlobalBuffer((__gm__ half *)y);
    ends.SetGlobalBuffer((__gm__ i64 *)groups);
    DataCopyExtParams gcp{1, p.e * 8U, 0, 0, 0};
    DataCopyPadExtParams<i64> gp{false, 0, 0, 0};
    DataCopyPad(localEnds, ends, gcp, gp);
    SetFlag<HardEvent::MTE2_S>(0);
    WaitFlag<HardEvent::MTE2_S>(0);
    if (n % TN || (NARROW_SEED && TN % 64)) {
        Duplicate(rawSpace, 0, VS);
        Duplicate(rawSpace[RAW_WORDS], 0, VS);
    }
    for (u32 i = 0; i < 2; i++) {
        SetFlag<HardEvent::V_MTE2>(i);
        SetFlag<HardEvent::MTE3_V>(i);
    }
    u32 chunkSequence = 0;
    const u32 nt = (n + TN - 1) / TN;
    u32 core = GetBlockIdx() / 2, sequence = 0, start = 0, base = 0, nextTask = core;
    u32 total = 0, previous = 0;
    if constexpr (CONTIGUOUS)
        for (u32 i = 0; i < p.e; i++) {
            const u32 end = static_cast<u32>(localEnds.GetValue(i));
            total += (end - previous + TM - 1) / TM * nt;
            previous = end;
        }
    const u32 tileBegin = total * core / p.cores, tileEnd = total * (core + 1) / p.cores;
    for (u32 e = 0; e < p.e; e++) {
        u32 end = static_cast<u32>(localEnds.GetValue(e));
        u32 mt = (end - start + TM - 1) / TM, tasks = mt * nt;
        const u32 first = CONTIGUOUS ? (tileBegin > base ? tileBegin - base : 0) : nextTask;
        const u32 limit =
            CONTIGUOUS ? (tileEnd > base ? ((tileEnd - base < tasks) ? tileEnd - base : tasks) : 0)
                       : tasks;
        u32 task = first;
        for (; task < limit; task += (CONTIGUOUS ? 1 : p.cores), sequence++) {
            u32 row = start + task / nt * TM, col = task % nt * TN;
            u32 totalRows = end - row < TM ? end - row : TM, cols = n - col < TN ? n - col : TN;
            u32 aligned = (cols + 7) / 8 * 8;
            const u32 localN = (cols + 31) / 32 * 32, rowsPerChunk = VS / localN;
            CrossCoreWaitFlag<2>(8);
            u32 halfRows = (totalRows + 1) / 2;
            u32 subStart = GetSubBlockIdx() * halfRows;
            u32 subEnd = subStart + halfRows < totalRows ? subStart + halfRows : totalRows;
            if (subStart >= subEnd)
                CrossCoreSetFlag<2, PIPE_MTE2>(9);
            for (u32 vrow = subStart; vrow < subEnd; vrow += rowsPerChunk) {
                u32 rows = subEnd - vrow < rowsPerChunk ? subEnd - vrow : rowsPerChunk;
                const u32 slot = chunkSequence++ % 2;
                auto raw = rawSpace[slot * RAW_WORDS];
                auto result = resultSpace[slot * VS];
                auto coeff = coeffSpace[slot * TN];
                WaitFlag<HardEvent::V_MTE2>(slot);
                DataCopyExtParams cp{static_cast<uint16_t>(rows),
                                     cols * 4U,
                                     (TN - cols) * 4U,
                                     (localN - aligned) / 8,
                                     0};
                DataCopyPadExtParams<i32> pad{true, 0, static_cast<uint8_t>(aligned - cols), 0};
                DataCopyPad(raw, ring[(core * 2 + sequence % 2) * CS + vrow * TN], cp, pad);
                DataCopyExtParams scp{1, cols * 4U, 0, 0, 0};
                DataCopyPadExtParams<float> sp{true, 0, static_cast<uint8_t>(aligned - cols), 0.0f};
                DataCopyPad(coeff, sg[u64(e) * n + col], scp, sp);
                if (vrow + rows == subEnd)
                    CrossCoreSetFlag<2, PIPE_MTE2>(9);
                SetFlag<HardEvent::MTE2_V>(slot);
                WaitFlag<HardEvent::MTE2_V>(slot);
                Cast(z, raw, RoundMode::CAST_NONE, (rows * localN + 63) / 64 * 64);
                PipeBarrier<PIPE_V>();
                for (u32 off = 0; off < cols; off += 64) {
                    Mul(z[off],
                        z[off],
                        coeff[off],
                        cols - off < 64 ? cols - off : 64,
                        rows,
                        {1,
                         1,
                         1,
                         static_cast<uint8_t>(localN / 8),
                         static_cast<uint8_t>(localN / 8),
                         0});
                }
                PipeBarrier<PIPE_V>();
                SetFlag<HardEvent::V_MTE2>(slot);
                u32 count = (rows * localN + 63) / 64 * 64;
                Mul(inner, z, z, count);
                PipeBarrier<PIPE_V>();
                Muls(inner, inner, -0.07135481627330025f, count);
                PipeBarrier<PIPE_V>();
                Adds(inner, inner, -1.5957691216057308f, count);
                PipeBarrier<PIPE_V>();
                Mul(inner, inner, z, count);
                PipeBarrier<PIPE_V>();
                Exp(inner, inner, count);
                PipeBarrier<PIPE_V>();
                Adds(inner, inner, 1.0f, count);
                PipeBarrier<PIPE_V>();
                Div(z, z, inner, count);
                PipeBarrier<PIPE_V>();
                WaitFlag<HardEvent::MTE3_V>(slot);
                Cast(result, z, RoundMode::CAST_RINT, rows * localN);
                PipeBarrier<PIPE_V>();
                SetFlag<HardEvent::V_MTE3>(slot);
                WaitFlag<HardEvent::V_MTE3>(slot);
                u32 ah = (cols + 15) / 16 * 16;
                DataCopyExtParams ocp{
                    static_cast<uint16_t>(rows), cols * 2U, (localN - ah) / 16, (n - cols) * 2U, 0};
                DataCopyPad(out[u64(row + vrow) * n + col], result, ocp);
                SetFlag<HardEvent::MTE3_V>(slot);
            }
        }
        if constexpr (CONTIGUOUS)
            base += tasks;
        else
            nextTask = task - tasks;
        start = end;
    }
    for (u32 i = 0; i < 2; i++) {
        WaitFlag<HardEvent::V_MTE2>(i);
        WaitFlag<HardEvent::MTE3_V>(i);
    }
    PipeBarrier<PIPE_ALL>();
}

struct ActiveGroupPlan692 {
    u32 count;
    u32 experts[128];
    u32 stops[128];
};

__aicore__ inline void BuildActiveGroupPlan692(GM_ADDR groups, u32 e, ActiveGroupPlan692 &plan) {
    GlobalTensor<i64> ends;
    ends.SetGlobalBuffer((__gm__ i64 *)groups);
    plan.count = 0;
    u32 previous = 0;
    for (u32 expert = 0; expert < e; expert++) {
        const u32 stop = static_cast<u32>(ends.GetValue(expert));
        if (stop > previous) {
            plan.experts[plan.count] = expert;
            plan.stops[plan.count] = stop;
            ++plan.count;
        }
        previous = stop;
    }
}

__aicore__ inline PadJob ActiveNativePadJob692(
    u32 task, const ActiveGroupPlan692 &active, u32 rows, u32 k, u32 n, u32 pk, u32 pn) {
    PadJob job = ImportedNativeBalancedPadJob(task, active.count, rows, k, n, pk, pn);
    job.expert = active.experts[job.expert];
    return job;
}

template <u32 RowsHint, bool TailOnly>
__aicore__ inline void PadWeightsActiveNative692(
    GM_ADDR w, GM_ADDR wp, u32 k, u32 n, u32 pk, u32 pn, const ActiveGroupPlan692 &active) {
    u32 rows = ImportedNativePackRows(pn);
    if constexpr (RowsHint > 0) {
        if (rows > RowsHint)
            rows = RowsHint;
    }
    const u32 bytes = rows * pn, wt = (pk + rows - 1) / rows, total = active.count * wt;
    const u32 firstTask = GetBlockIdx(), step = GetBlockNum();
    if (firstTask >= total)
        return;
    u32 slots = 512 * 1024 / bytes;
    if (slots > 4)
        slots = 4;
    TPipe pipe;
    TBuf<TPosition::B1> arenaB;
    pipe.InitBuffer(arenaB, slots * bytes);
    auto arena = arenaB.Get<i8>();
    GlobalTensor<i8> input, output;
    input.SetGlobalBuffer((__gm__ i8 *)w);
    output.SetGlobalBuffer((__gm__ i8 *)wp);
    TEventID ready[4], retire[4];
    bool used[4] = {false, false, false, false};
    for (u32 i = 0; i < slots; i++) {
        ready[i] = pipe.AllocEventID<HardEvent::MTE2_MTE3>();
        retire[i] = pipe.AllocEventID<HardEvent::MTE3_MTE2>();
        const u32 task = firstTask + i * step;
        if (task < total) {
            ImportedPrefetchNativeWeightsTuned<TailOnly>(
                arena[i * bytes],
                input,
                ActiveNativePadJob692(task, active, rows, k, n, pk, pn),
                k,
                n,
                rows,
                pn);
            SetFlag<HardEvent::MTE2_MTE3>(ready[i]);
            used[i] = true;
        }
    }
    u32 slot = 0;
    for (u32 task = firstTask; task < total; task += step) {
        WaitFlag<HardEvent::MTE2_MTE3>(ready[slot]);
        const PadJob job = ActiveNativePadJob692(task, active, rows, k, n, pk, pn);
        DataCopyParams cp{static_cast<uint16_t>(pn / 32),
                          static_cast<uint16_t>(job.rows),
                          static_cast<uint16_t>(rows - job.rows),
                          static_cast<uint16_t>(pk - job.rows)};
        DataCopy(output[u64(job.expert) * pk * pn + u64(job.row) * 32], arena[slot * bytes], cp);
        SetFlag<HardEvent::MTE3_MTE2>(retire[slot]);
        const u32 next = task + slots * step;
        if (next < total) {
            WaitFlag<HardEvent::MTE3_MTE2>(retire[slot]);
            ImportedPrefetchNativeWeightsTuned<TailOnly>(
                arena[slot * bytes],
                input,
                ActiveNativePadJob692(next, active, rows, k, n, pk, pn),
                k,
                n,
                rows,
                pn);
            SetFlag<HardEvent::MTE2_MTE3>(ready[slot]);
        }
        if (++slot == slots)
            slot = 0;
    }
    for (u32 i = 0; i < slots; i++) {
        if (used[i])
            WaitFlag<HardEvent::MTE3_MTE2>(retire[i]);
        pipe.ReleaseEventID<HardEvent::MTE2_MTE3>(ready[i]);
        pipe.ReleaseEventID<HardEvent::MTE3_MTE2>(retire[i]);
    }
}

template <u32 TM, u32 TN, bool NZ, u32 SK, u32 MODE = 0>
__aicore__ inline void
CubeWideStatic1344(GM_ADDR x, GM_ADDR w, GM_ADDR groups, GM_ADDR workspace, const Plan &p) {
    constexpr u32 CS = TM * TN;
    const u32 k = p.k, n = p.n, wn = p.wn, ka = NZ ? p.ka : p.k;
    TPipe pipe;
    using A = MatmulType<TPosition::GM, CubeFormat::ND, i8, false>;
    using B = MatmulType<TPosition::GM, NZ ? CubeFormat::NZ : CubeFormat::ND, i8, false>;
    using C = MatmulType<TPosition::GM, CubeFormat::ND, i32>;
    Matmul<A, B, C, C, RANGE_CUBE_CFG1972<TM, TN, MODE>> mm;
    mm.Init(SK ? nullptr : &p.cube, &pipe);
    mm.SetOrgShape(p.m, wn, ka, k, TN);
    GlobalTensor<i8> a, b;
    GlobalTensor<i64> ends;
    GlobalTensor<i32> ring;
    a.SetGlobalBuffer((__gm__ i8 *)x);
    b.SetGlobalBuffer((__gm__ i8 *)w);
    ends.SetGlobalBuffer((__gm__ i64 *)groups);
    ring.SetGlobalBuffer((__gm__ i32 *)workspace);
    u32 core = GetBlockIdx(), sequence = 0, start = 0, base = 0, nt = (n + TN - 1) / TN;
    for (u32 e = 0; e < p.e; e++) {
        u32 end = static_cast<u32>(ends.GetValue(e));
        u32 mt = (end - start + TM - 1) / TM, tasks = mt * nt;
        u32 first = (core + p.cores - base % p.cores) % p.cores;
        for (u32 task = first; task < tasks; task += p.cores, sequence++) {
            u32 row = start + task / nt * TM, col = task % nt * TN;
            u32 rows = end - row < TM ? end - row : TM, cols = n - col < TN ? n - col : TN;
            mm.SetTail(rows, cols, ka);
            mm.SetTensorA(a[u64(row) * ka], false);
            mm.SetTensorB(b[u64(e) * k * wn + (NZ ? u64(col) * k : col)], false);
            mm.Iterate();
            if (sequence >= 2)
                CrossCoreWaitFlag<2>(9);
            mm.GetTensorC(ring[(core * 2 + sequence % 2) * CS]);
            CrossCoreSetFlag<2, PIPE_FIX>(8);
        }
        start = end;
        base += tasks;
    }
    for (u32 i = 0; i < (sequence < 2 ? sequence : 2); i++)
        CrossCoreWaitFlag<2>(9);
    mm.End();
}

__global__ __aicore__ void RangeWideStatic1344Kernel(GM_ADDR x,
                                                     GM_ADDR w,
                                                     GM_ADDR scale,
                                                     GM_ADDR groups,
                                                     GM_ADDR y,
                                                     GM_ADDR workspace,
                                                     GM_ADDR paddedWorkspace,
                                                     Plan p) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
    auto *ax = (__gm__ uint8_t *)paddedWorkspace;
    auto *aw = ax + (p.rawA ? 0 : u64(p.m) * p.k);
    if ASCEND_IS_AIC {
        ActiveGroupPlan692 active;
        BuildActiveGroupPlan692(groups, p.e, active);
        if (active.count == p.e)
            ImportedPadWeightsNativeRows<64, true>(w, (GM_ADDR)aw, p.rawK, p.n, p.e, p.k, p.wn);
        else
            PadWeightsActiveNative692<64, true>(w, (GM_ADDR)aw, p.rawK, p.n, p.k, p.wn, active);
    }
    if ASCEND_IS_AIV {
        if (!p.rawA)
            PadInputsCore(x, w, (GM_ADDR)ax, (GM_ADDR)aw, p.m, p.rawK, p.n, 0, p.k, p.wn, p.rawA);
    }
    SyncAll<false>();
    if ASCEND_IS_AIC {
        CubeWideStatic1344<128, 256, true, 8192>(
            p.rawA ? x : (GM_ADDR)ax, (GM_ADDR)aw, groups, workspace, p);
    } else {
        VectorCompactPolicy784<128, 256, false, false>(scale, groups, y, workspace, p);
    }
}

inline void LaunchRangeWideStatic1344(GM_ADDR x,
                                      GM_ADDR w,
                                      GM_ADDR scale,
                                      GM_ADDR groups,
                                      GM_ADDR y,
                                      u32 m,
                                      u32 k,
                                      u32 n,
                                      u32 e,
                                      i64 coreCount,
                                      aclrtStream stream) {
    auto *platform = platform_ascendc::PlatformAscendCManager::GetInstance();
    if (!platform || coreCount <= 0)
        throw std::runtime_error("moderate stream platform unavailable");
    Plan p = BuildRangePlan19681(m, k, n, e, coreCount, platform);
    if (!p.cores || m < 16384 || m > 65536 || !e || e > 128 || m < 512 * e || k <= 4608 ||
        k > 8192 || k % 32 || n <= 128 || n > 4096)
        throw std::runtime_error("moderate stream capacity");
    ConfigureRangeCube1968<true>(*platform, p, 128, 256, 128, 256, -1);
    CheckSelectedCubeResources<128, 256, true, 8192, false>(p);
    CheckCubeResources(WIDE_CFG1344);
    p.ka = p.rawA ? p.rawK : p.k;
    Workspace packed;
    packed.stream = stream;
    Check(aclrtMalloc(
        &packed.ptr, (p.rawA ? 0 : u64(m) * p.k) + u64(e) * p.k * p.wn, ACL_MEM_MALLOC_HUGE_FIRST));
    Workspace scratch;
    scratch.stream = stream;
    Check(aclrtMalloc(&scratch.ptr, u64(p.cores) * 2 * 128 * 256 * 4, ACL_MEM_MALLOC_HUGE_FIRST));
    RangeWideStatic1344Kernel<<<p.cores, nullptr, stream>>>(
        x, w, scale, groups, y, (GM_ADDR)scratch.ptr, (GM_ADDR)packed.ptr, p);
}

// CASE16_17_MEASURED_RANGE_IMPORT_BEGIN
template <u32 TM, u32 TN, bool NZ, u32 SK>
constexpr auto IMPORTED_TAIL_CFG = ImportedStaticConfig<TM, TN, NZ, SK>();
template <u32 TM, u32 TN, bool NZ, u32 SK, bool MERGED>
inline void CheckImportedTailResources(Plan &p) {
    static_assert(TM == 128 && NZ && SK == 8192 && !MERGED, "imported tail geometry");
    auto inspect = [&](const auto &q) {
        CheckCubeResources(q);
        const bool fullK = q.stepKa > 0 && uint64_t(q.stepKa) * q.baseK >= p.k;
        p.rawA = NZ && (p.rawK == p.k || fullK);
    };
    inspect(p.cube);
    inspect(IMPORTED_TAIL_CFG<TM, TN, NZ, SK>);
}
template <uint32_t TM, uint32_t TN>
__aicore__ inline void
VectorRangeStatic(GM_ADDR scale, GM_ADDR groups, GM_ADDR y, GM_ADDR workspace, const Plan &p) {
    InitSocState();
    const uint32_t n = p.n;
    constexpr uint32_t CS = TM * TN, VS = CS > 8192 ? 8192 : CS, VR = VS / TN;
    constexpr uint32_t RAW = 0;
    constexpr uint32_t Z = RAW + VS * 4 + 256;
    constexpr uint32_t INNER = Z + VS * 4 + 256;
    constexpr uint32_t DEN = INNER + VS * 4 + 256;
    constexpr uint32_t NUM = DEN + VS * 4 + 256;
    constexpr uint32_t HALF = NUM + VS * 4 + 256;
    constexpr uint32_t SCALE = HALF + VS * 2;
    constexpr uint32_t MASK = SCALE + TN * 4;
    constexpr uint32_t GROUP = MASK + VS / 8;
    constexpr uint32_t END = GROUP + 128 * 8;
    static_assert(END <= 192 * 1024, "generic Vector static UB capacity");
    LocalTensor<int32_t> raw(TPosition::VECCALC, RAW, VS + 64);
    LocalTensor<float> z(TPosition::VECCALC, Z, VS + 64);
    LocalTensor<float> inner(TPosition::VECCALC, INNER, VS + 64);
    LocalTensor<float> den(TPosition::VECCALC, DEN, VS + 64);
    LocalTensor<float> num(TPosition::VECCALC, NUM, VS + 64);
    LocalTensor<half> result(TPosition::VECCALC, HALF, VS);
    LocalTensor<float> coeff(TPosition::VECCALC, SCALE, TN);
    LocalTensor<uint8_t> mask(TPosition::VECCALC, MASK, VS / 8);
    LocalTensor<int64_t> localEnds(TPosition::VECCALC, GROUP, 128);
    // No queue allocates hard events here. Each local event0 is set/wait paired
    // before same-direction reuse; cross-core ring flags8/9 stay independent.
    GlobalTensor<int32_t> ring;
    GlobalTensor<float> sg;
    GlobalTensor<half> out;
    GlobalTensor<int64_t> ends;
    ring.SetGlobalBuffer((__gm__ int32_t *)workspace);
    sg.SetGlobalBuffer((__gm__ float *)scale);
    out.SetGlobalBuffer((__gm__ half *)y);
    ends.SetGlobalBuffer((__gm__ int64_t *)groups);
    DataCopyExtParams gcp{1, p.e * 8U, 0, 0, 0};
    DataCopyPadExtParams<int64_t> gp{false, 0, 0, 0};
    DataCopyPad(localEnds, ends, gcp, gp);
    SetFlag<HardEvent::MTE2_S>(0);
    WaitFlag<HardEvent::MTE2_S>(0);
    uint32_t core = GetBlockIdx() / 2, sequence = 0, start = 0, base = 0, nt = (n + TN - 1) / TN;
    for (uint32_t e = 0; e < p.e; e++) {
        uint32_t end = static_cast<uint32_t>(localEnds.GetValue(e));
        uint32_t mt = (end - start + TM - 1) / TM, tasks = mt * nt;
        uint32_t first = (core + p.cores - base % p.cores) % p.cores;
        for (uint32_t task = first; task < tasks; task += p.cores, sequence++) {
            uint32_t row = start + task / nt * TM, col = task % nt * TN;
            uint32_t totalRows = end - row < TM ? end - row : TM,
                     cols = n - col < TN ? n - col : TN;
            uint32_t aligned = (cols + 7) / 8 * 8;
            CrossCoreWaitFlag<2>(8);
            uint32_t halfRows = (totalRows + 1) / 2;
            uint32_t subStart = GetSubBlockIdx() * halfRows;
            uint32_t subEnd = subStart + halfRows < totalRows ? subStart + halfRows : totalRows;
            if (subStart >= subEnd)
                CrossCoreSetFlag<2, PIPE_MTE2>(9);
            for (uint32_t vrow = subStart; vrow < subEnd; vrow += VR) {
                uint32_t rows = subEnd - vrow < VR ? subEnd - vrow : VR;
                if (cols < TN)
                    Duplicate(raw, 0, VS);
                SetFlag<HardEvent::V_MTE2>(0);
                WaitFlag<HardEvent::V_MTE2>(0);
                DataCopyExtParams cp{static_cast<uint16_t>(rows),
                                     cols * 4U,
                                     (TN - cols) * 4U,
                                     (TN - aligned) / 8,
                                     0};
                DataCopyPadExtParams<int32_t> pad{true, 0, static_cast<uint8_t>(aligned - cols), 0};
                DataCopyPad(raw, ring[(core * 2 + sequence % 2) * CS + vrow * TN], cp, pad);
                DataCopyExtParams scp{1, cols * 4U, 0, 0, 0};
                DataCopyPadExtParams<float> sp{true, 0, static_cast<uint8_t>(aligned - cols), 0.0f};
                if (vrow == subStart)
                    DataCopyPad(coeff, sg[uint64_t(e) * n + col], scp, sp);
                if (vrow + rows == subEnd)
                    CrossCoreSetFlag<2, PIPE_MTE2>(9);
                SetFlag<HardEvent::MTE2_V>(0);
                WaitFlag<HardEvent::MTE2_V>(0);
                Cast(z, raw, RoundMode::CAST_NONE, rows * TN);
                PipeBarrier<PIPE_V>();
                for (uint32_t off = 0; off < cols; off += 64) {
                    Mul(z[off],
                        z[off],
                        coeff[off],
                        cols - off < 64 ? cols - off : 64,
                        rows,
                        {1, 1, 1, TN / 8, TN / 8, 0});
                }
                PipeBarrier<PIPE_V>();
                // Copied padding is zero, so the entire aligned tile is initialized.
                uint32_t count = rows * TN;
                // FP32 stable sigmoid form of tanh GELU; convert to FP16 only after activation.
                Abs(num, z, count);
                PipeBarrier<PIPE_V>();
                Mul(inner, num, num, count);
                PipeBarrier<PIPE_V>();
                Muls(inner, inner, -0.07135481627330025f, count);
                PipeBarrier<PIPE_V>();
                Adds(inner, inner, -1.5957691216057308f, count);
                PipeBarrier<PIPE_V>();
                Mul(inner, inner, num, count);
                PipeBarrier<PIPE_V>();
                Exp(inner, inner, count);
                PipeBarrier<PIPE_V>();
                Adds(den, inner, 1.0f, count);
                PipeBarrier<PIPE_V>();
                Div(num, z, den, count);
                PipeBarrier<PIPE_V>();
                Mul(den, num, inner, count);
                PipeBarrier<PIPE_V>();
                CompareScalar(mask, z, 0.0f, CMPMODE::GE, count);
                PipeBarrier<PIPE_V>();
                Select(z, mask, num, den, SELMODE::VSEL_TENSOR_TENSOR_MODE, count);
                PipeBarrier<PIPE_V>();
                Cast(result, z, RoundMode::CAST_RINT, rows * TN);
                SetFlag<HardEvent::V_MTE3>(0);
                WaitFlag<HardEvent::V_MTE3>(0);

                uint32_t ah = (cols + 15) / 16 * 16;
                DataCopyExtParams ocp{
                    static_cast<uint16_t>(rows), cols * 2U, (TN - ah) / 16, (n - cols) * 2U, 0};
                DataCopyPad(out[uint64_t(row + vrow) * n + col], result, ocp);
                SetFlag<HardEvent::MTE3_V>(0);
                WaitFlag<HardEvent::MTE3_V>(0);
            }
        }
        start = end;
        base += tasks;
    }
    // Match the AIV TPipe destructor after all task and idle paths.
    PipeBarrier<PIPE_ALL>();
}

template <u32 TN>
__global__ __aicore__ void RangeThresholdWide1864Kernel(GM_ADDR x,
                                                        GM_ADDR w,
                                                        GM_ADDR scale,
                                                        GM_ADDR groups,
                                                        GM_ADDR y,
                                                        GM_ADDR workspace,
                                                        GM_ADDR paddedWorkspace,
                                                        Plan p) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
    auto *ax = (__gm__ uint8_t *)paddedWorkspace;
    auto *aw = ax + (p.rawA ? 0 : u64(p.m) * p.k);
    if ASCEND_IS_AIC {
        ActiveGroupPlan692 active;
        BuildActiveGroupPlan692(groups, p.e, active);
        if (active.count == p.e)
            ImportedPadWeightsNativeRows<256, true>(w, (GM_ADDR)aw, p.rawK, p.n, p.e, p.k, p.wn);
        else
            PadWeightsActiveNative692<256, true>(w, (GM_ADDR)aw, p.rawK, p.n, p.k, p.wn, active);
    }
    if ASCEND_IS_AIV {
        if (!p.rawA)
            PadInputsCore(x, w, (GM_ADDR)ax, (GM_ADDR)aw, p.m, p.rawK, p.n, 0, p.k, p.wn, p.rawA);
    }
    SyncAll<false>();
    if ASCEND_IS_AIC {
        if constexpr (TN == 256)
            CubeWideStatic1344<128, 256, true, 8192>(
                p.rawA ? x : (GM_ADDR)ax, (GM_ADDR)aw, groups, workspace, p);
        else
            Cube<128, 128, true, 8192>(p.rawA ? x : (GM_ADDR)ax, (GM_ADDR)aw, groups, workspace, p);
    } else {
        Vector<128, TN>(scale, groups, y, workspace, p);
    }
}

template <u32 TN, bool ALT = false>
inline void LaunchRangeThresholdWide1864Tile(GM_ADDR x,
                                             GM_ADDR w,
                                             GM_ADDR scale,
                                             GM_ADDR groups,
                                             GM_ADDR y,
                                             u32 m,
                                             u32 k,
                                             u32 n,
                                             u32 e,
                                             i64 coreCount,
                                             aclrtStream stream) {
    auto *platform = platform_ascendc::PlatformAscendCManager::GetInstance();
    if (!platform || coreCount <= 0)
        throw std::runtime_error("moderate stream platform unavailable");
    Plan p = BuildRangePlan19681(m, k, n, e, coreCount, platform);
    if constexpr (ALT) {
        if (!p.cores || m < 8192 || m < 256 * e ||
            !(((k % 32 != 0 && n > 64 && n <= 128 && k > 7168) || (n > 128 && k > 4608)) &&
              (m < 16384 || m < 512 * e || u64(m) * k < 64ULL * 1024 * 1024)))
            throw std::runtime_error("moderate stream capacity");
    } else {
        if (!p.cores ||
            !(m >= 8192 && m >= 256 * e && k > 1536 && k % 32 != 0 && n > 64 &&
              ((n > 128 && k <= 4608) || (n <= 128 && k <= 7168)) &&
              !((k <= 3072 && n <= 96)
                    ? (m >= 512 * e && u64(m) * k >= 32ULL * 1024 * 1024)
                    : (m >= 16384 && m >= 512 * e && u64(m) * k >= 64ULL * 1024 * 1024))))
            throw std::runtime_error("moderate stream capacity");
    }
    ConfigureRangeCube1968<true>(*platform, p, 128, TN, 128, TN, -1);
    CheckImportedTailResources<128, TN, true, 8192, false>(p);
    if constexpr (TN == 256)
        CheckCubeResources(WIDE_CFG1344);
    p.ka = p.rawA ? p.rawK : p.k;
    Workspace packed;
    packed.stream = stream;
    Check(aclrtMalloc(
        &packed.ptr, (p.rawA ? 0 : u64(m) * p.k) + u64(e) * p.k * p.wn, ACL_MEM_MALLOC_HUGE_FIRST));
    Workspace scratch;
    scratch.stream = stream;
    Check(aclrtMalloc(&scratch.ptr, u64(p.cores) * 2 * 128 * TN * 4, ACL_MEM_MALLOC_HUGE_FIRST));
    RangeThresholdWide1864Kernel<TN><<<p.cores, nullptr, stream>>>(
        x, w, scale, groups, y, (GM_ADDR)scratch.ptr, (GM_ADDR)packed.ptr, p);
}

inline void LaunchRangeThresholdWide1864(GM_ADDR x,
                                         GM_ADDR w,
                                         GM_ADDR scale,
                                         GM_ADDR groups,
                                         GM_ADDR y,
                                         u32 m,
                                         u32 k,
                                         u32 n,
                                         u32 e,
                                         i64 coreCount,
                                         aclrtStream stream) {
    if (n <= 128)
        LaunchRangeThresholdWide1864Tile<128>(
            x, w, scale, groups, y, m, k, n, e, coreCount, stream);
    else
        LaunchRangeThresholdWide1864Tile<256>(
            x, w, scale, groups, y, m, k, n, e, coreCount, stream);
}

template <u32 TN>
__global__ __aicore__ void RangeModerateFrames2016Kernel(GM_ADDR x,
                                                         GM_ADDR w,
                                                         GM_ADDR scale,
                                                         GM_ADDR groups,
                                                         GM_ADDR y,
                                                         GM_ADDR workspace,
                                                         GM_ADDR paddedWorkspace,
                                                         Plan p) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
    auto *ax = (__gm__ uint8_t *)paddedWorkspace;
    auto *aw = ax + (p.rawA ? 0 : u64(p.m) * p.k);
    if ASCEND_IS_AIC {
        ActiveGroupPlan692 active;
        BuildActiveGroupPlan692(groups, p.e, active);
        if (active.count == p.e)
            ImportedPadWeightsNativeRows<256, true>(w, (GM_ADDR)aw, p.rawK, p.n, p.e, p.k, p.wn);
        else
            PadWeightsActiveNative692<256, true>(w, (GM_ADDR)aw, p.rawK, p.n, p.k, p.wn, active);
    }
    if ASCEND_IS_AIV {
        if (!p.rawA)
            PadInputsCore(x, w, (GM_ADDR)ax, (GM_ADDR)aw, p.m, p.rawK, p.n, 0, p.k, p.wn, p.rawA);
    }
    SyncAll<false>();
    if ASCEND_IS_AIC {
        if constexpr (TN == 256)
            CubeWideStatic1344<128, 256, true, 8192>(
                p.rawA ? x : (GM_ADDR)ax, (GM_ADDR)aw, groups, workspace, p);
        else
            Cube<128, TN, true, 8192>(p.rawA ? x : (GM_ADDR)ax, (GM_ADDR)aw, groups, workspace, p);
    } else {
        VectorRangeStatic<128, TN>(scale, groups, y, workspace, p);
    }
}

template <u32 TN, bool DEEP = false>
inline void LaunchRangeModerateFrames2016Tile(GM_ADDR x,
                                              GM_ADDR w,
                                              GM_ADDR scale,
                                              GM_ADDR groups,
                                              GM_ADDR y,
                                              u32 m,
                                              u32 k,
                                              u32 n,
                                              u32 e,
                                              i64 coreCount,
                                              aclrtStream stream) {
    auto *platform = platform_ascendc::PlatformAscendCManager::GetInstance();
    if (!platform || coreCount <= 0)
        throw std::runtime_error("moderate stream platform unavailable");
    Plan p = BuildRangePlan19681(m, k, n, e, coreCount, platform);
    if constexpr (DEEP) {
        if (!p.cores || m < 16384 || m < 512 * e || u64(m) * k < 64ULL * 1024 * 1024 || k <= 4608 ||
            k > 8192 || n <= 128)
            throw std::runtime_error("moderate stream capacity");
    } else {
        if (!p.cores || m <= 64 || m >= 4096 || k <= 1536)
            throw std::runtime_error("moderate stream capacity");
    }
    ConfigureRangeCube1968<true>(*platform, p, 128, TN, 128, TN, -1);
    CheckImportedTailResources<128, TN, true, 8192, false>(p);
    if constexpr (TN == 256)
        CheckCubeResources(WIDE_CFG1344);
    p.ka = p.rawA ? p.rawK : p.k;
    Workspace packed;
    packed.stream = stream;
    Check(aclrtMalloc(
        &packed.ptr, (p.rawA ? 0 : u64(m) * p.k) + u64(e) * p.k * p.wn, ACL_MEM_MALLOC_HUGE_FIRST));
    Workspace scratch;
    scratch.stream = stream;
    Check(aclrtMalloc(&scratch.ptr, u64(p.cores) * 2 * 128 * TN * 4, ACL_MEM_MALLOC_HUGE_FIRST));
    RangeModerateFrames2016Kernel<TN><<<p.cores, nullptr, stream>>>(
        x, w, scale, groups, y, (GM_ADDR)scratch.ptr, (GM_ADDR)packed.ptr, p);
}

inline void LaunchRangeModerateFrames2016(GM_ADDR x,
                                          GM_ADDR w,
                                          GM_ADDR scale,
                                          GM_ADDR groups,
                                          GM_ADDR y,
                                          u32 m,
                                          u32 k,
                                          u32 n,
                                          u32 e,
                                          i64 coreCount,
                                          aclrtStream stream) {
    if (n <= 64)
        LaunchRangeModerateFrames2016Tile<64>(
            x, w, scale, groups, y, m, k, n, e, coreCount, stream);
    else if (n <= 128)
        LaunchRangeModerateFrames2016Tile<128>(
            x, w, scale, groups, y, m, k, n, e, coreCount, stream);
    else
        LaunchRangeModerateFrames2016Tile<256>(
            x, w, scale, groups, y, m, k, n, e, coreCount, stream);
}
// CASE16_17_MEASURED_RANGE_IMPORT_END

inline bool TryLaunch(ShapeChoice choice,
                      GM_ADDR x,
                      GM_ADDR weight,
                      GM_ADDR scale,
                      GM_ADDR groups,
                      GM_ADDR y,
                      uint32_t m,
                      uint32_t k,
                      uint32_t n,
                      uint32_t e,
                      int64_t availableCoreNum,
                      aclrtStream stream) {
    // Wide nonaligned-K range: same donor first-match predicate, physical128x256.
    if (choice.family == ShapeFamily::NzStream && m >= 8192 && m >= 256 * e && k > 1536 &&
        k <= 4608 && k % 32 != 0 && n > 128 &&
        !(m >= 16384 && m >= 512 * e && uint64_t(m) * k >= 64ULL * 1024 * 1024)) {
        LaunchRangeThresholdWide1864(
            x, weight, scale, groups, y, m, k, n, e, availableCoreNum, stream);
        return true;
    }
    // Moderate-M deep-K range: same donor path for wide nonaligned outputs.
    if (choice.family == ShapeFamily::NzStream && m > 64 && m < 4096 && k > 1536 && n > 128) {
        LaunchRangeModerateFrames2016(
            x, weight, scale, groups, y, m, k, n, e, availableCoreNum, stream);
        return true;
    }

    // Long aligned-K, wide-N workloads: donor's first matching range, not a case ID.
    if (choice.family == ShapeFamily::NzStream && m >= 16384 && m >= 512 * e && k % 32 == 0 &&
        k > 4608 && n > 128) {
        LaunchRangeWideStatic1344(
            x, weight, scale, groups, y, m, k, n, e, availableCoreNum, stream);
        return true;
    }
    // Nonaligned-K narrow outputs. Earlier donor clauses cannot intercept
    // this range: its work >=32 MiB and N<=16 exclude their short-work/width tests.
    if ((choice.family == ShapeFamily::NzFullA1 || choice.family == ShapeFamily::NzStream) &&
        m >= 8192 && m >= 256 * e && uint64_t(m) * k >= 32ULL * 1024 * 1024 && k > 1536 &&
        k <= 4096 && k % 32 != 0 && n <= 16) {
        LaunchRangeMidIssue32(x, weight, scale, groups, y, m, k, n, e, availableCoreNum, stream);
        return true;
    }
    return false;
}
} // namespace AdditionalNzRanges
// CASE18_19_RANGE_IMPORT_END

}

// Generic K=1 outer product with an on-chip batch of consecutive output rows.
namespace GroupedGelu {
__global__ __aicore__ void KOneVectorBatchKernel(GM_ADDR x,
                                                 GM_ADDR weight,
                                                 GM_ADDR scale,
                                                 GM_ADDR groups,
                                                 GM_ADDR y,
                                                 uint32_t m,
                                                 uint32_t n,
                                                 uint32_t e,
                                                 uint32_t cores) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    InitSocState();
    constexpr uint32_t MAX_N = 4096, MAX_E = 128, X_CAPACITY = 4096, VECTOR_CAPACITY = 8192;
    constexpr uint32_t X = 0, W = X + X_CAPACITY, WH = W + MAX_N;
    constexpr uint32_t WF = WH + MAX_N * 2, S = WF + MAX_N * 4;
    constexpr uint32_t Z = S + MAX_N * 4, I = Z + VECTOR_CAPACITY * 4;
    constexpr uint32_t AUX = I + VECTOR_CAPACITY * 4, H = AUX + VECTOR_CAPACITY * 4;
    constexpr uint32_t MASK = H + VECTOR_CAPACITY * 2, G = MASK + VECTOR_CAPACITY / 8;
    constexpr uint32_t UB_END = G + MAX_E * 8;
    static_assert(UB_END == 165888 && UB_END <= 192 * 1024, "K=1 batched vector UB capacity");
    LocalTensor<int8_t> lx(TPosition::VECCALC, X, X_CAPACITY);
    LocalTensor<int8_t> lw(TPosition::VECCALC, W, MAX_N);
    LocalTensor<half> wh(TPosition::VECCALC, WH, MAX_N);
    LocalTensor<float> wf(TPosition::VECCALC, WF, MAX_N);
    LocalTensor<float> coeff(TPosition::VECCALC, S, MAX_N);
    LocalTensor<float> z(TPosition::VECCALC, Z, VECTOR_CAPACITY);
    LocalTensor<float> inner(TPosition::VECCALC, I, VECTOR_CAPACITY);
    LocalTensor<float> aux(TPosition::VECCALC, AUX, VECTOR_CAPACITY);
    LocalTensor<half> result(TPosition::VECCALC, H, VECTOR_CAPACITY);
    LocalTensor<uint8_t> mask(TPosition::VECCALC, MASK, VECTOR_CAPACITY / 8);
    LocalTensor<int64_t> ends(TPosition::VECCALC, G, MAX_E);
    GlobalTensor<int8_t> xg, wg;
    GlobalTensor<float> sg;
    GlobalTensor<int64_t> gg;
    GlobalTensor<half> yg;
    xg.SetGlobalBuffer((__gm__ int8_t *)x);
    wg.SetGlobalBuffer((__gm__ int8_t *)weight);
    sg.SetGlobalBuffer((__gm__ float *)scale);
    gg.SetGlobalBuffer((__gm__ int64_t *)groups);
    yg.SetGlobalBuffer((__gm__ half *)y);
    const uint32_t core = GetBlockIdx();
    const uint32_t first = uint64_t(m) * core / cores;
    const uint32_t last = uint64_t(m) * (core + 1) / cores;
    if (first >= last)
        return;
    const uint32_t stride = (n + 63) / 64 * 64;
    const uint32_t rowsPerBatch = VECTOR_CAPACITY / stride;
    const uint32_t alignedHalf = (n + 15) / 16 * 16;
    DataCopyExtParams gcp{1, e * 8U, 0, 0, 0};
    DataCopyPadExtParams<int64_t> gp{false, 0, 0, 0};
    DataCopyPad(ends, gg, gcp, gp);
    SetFlag<HardEvent::MTE2_S>(0);
    WaitFlag<HardEvent::MTE2_S>(0);
    bool pendingOutput = false;
    uint32_t start = 0;
    for (uint32_t expert = 0; expert < e; expert++) {
        const uint32_t end = static_cast<uint32_t>(ends.GetValue(expert));
        const uint32_t rowBegin = first > start ? first : start;
        const uint32_t rowEnd = last < end ? last : end;
        start = end;
        if (rowBegin >= rowEnd)
            continue;
        Duplicate(lw.ReinterpretCast<int32_t>(), int32_t(0), stride / 4);
        Duplicate(coeff, 0.0f, stride);
        SetFlag<HardEvent::V_MTE2>(0);
        WaitFlag<HardEvent::V_MTE2>(0);
        DataCopyExtParams wcp{1, n, 0, 0, 0};
        DataCopyPadExtParams<int8_t> wp{true, 0, static_cast<uint8_t>((n + 31) / 32 * 32 - n), 0};
        DataCopyPad(lw, wg[uint64_t(expert) * n], wcp, wp);
        DataCopyExtParams scp{1, n * 4U, 0, 0, 0};
        DataCopyPadExtParams<float> sp{true, 0, static_cast<uint8_t>((n + 7) / 8 * 8 - n), 0.0f};
        DataCopyPad(coeff, sg[uint64_t(expert) * n], scp, sp);
        SetFlag<HardEvent::MTE2_V>(0);
        WaitFlag<HardEvent::MTE2_V>(0);
        // The half temporary only converts INT8 operands; it performs no arithmetic.
        Cast(wh, lw, RoundMode::CAST_NONE, stride);
        PipeBarrier<PIPE_V>();
        Cast(wf, wh, RoundMode::CAST_NONE, stride);
        PipeBarrier<PIPE_V>();
        for (uint32_t window = rowBegin; window < rowEnd;) {
            const uint32_t windowRows = rowEnd - window < X_CAPACITY ? rowEnd - window : X_CAPACITY;
            DataCopyExtParams xcp{1, windowRows, 0, 0, 0};
            DataCopyPadExtParams<int8_t> xp{false, 0, 0, 0};
            // Retire scalar reads of the preceding X window before MTE2
            // overwrites its UB storage, including across expert boundaries.
            SetFlag<HardEvent::S_MTE2>(0);
            WaitFlag<HardEvent::S_MTE2>(0);
            DataCopyPad(lx, xg[window], xcp, xp);
            SetFlag<HardEvent::MTE2_S>(0);
            WaitFlag<HardEvent::MTE2_S>(0);
            for (uint32_t offset = 0; offset < windowRows;) {
                const uint32_t rows =
                    windowRows - offset < rowsPerBatch ? windowRows - offset : rowsPerBatch;
                const uint32_t count = rows * stride;
                for (uint32_t r = 0; r < rows; r++) {
                    const float xv = static_cast<float>(lx.GetValue(offset + r));
                    Muls(z[r * stride], wf, xv, stride);
                }
                PipeBarrier<PIPE_V>();
                for (uint32_t r = 0; r < rows; r++)
                    Mul(z[r * stride], z[r * stride], coeff, stride);
                PipeBarrier<PIPE_V>();
                // Shared GELU instructions cover the whole initialized row batch.
                // Reuse aux: |z| first, then 1+exp(-2|u|). Reuse inner for the
                // numerator after its exponential has been consumed by aux.
                Abs(aux, z, count);
                Mul(inner, z, z, count);
                PipeBarrier<PIPE_V>();
                Muls(inner, inner, -0.07135481627330025f, count);
                PipeBarrier<PIPE_V>();
                Adds(inner, inner, -1.5957691216057308f, count);
                PipeBarrier<PIPE_V>();
                Mul(inner, inner, aux, count);
                PipeBarrier<PIPE_V>();
                Exp(inner, inner, count);
                PipeBarrier<PIPE_V>();
                Adds(aux, inner, 1.0f, count);
                PipeBarrier<PIPE_V>();
                Mul(inner, z, inner, count);
                PipeBarrier<PIPE_V>();
                CompareScalar(mask, z, 0.0f, CMPMODE::GE, count);
                PipeBarrier<PIPE_V>();
                Select(inner, mask, z, inner, SELMODE::VSEL_TENSOR_TENSOR_MODE, count);
                PipeBarrier<PIPE_V>();
                Div(z, inner, aux, count);
                PipeBarrier<PIPE_V>();
                if (pendingOutput) {
                    SetFlag<HardEvent::MTE3_V>(0);
                    WaitFlag<HardEvent::MTE3_V>(0);
                }
                Cast(result, z, RoundMode::CAST_RINT, count);
                SetFlag<HardEvent::V_MTE3>(0);
                WaitFlag<HardEvent::V_MTE3>(0);
                // Source stride counts 32-byte blocks after the rounded block;
                // destination rows are tightly packed, including odd N tails.
                DataCopyExtParams ycp{
                    static_cast<uint16_t>(rows), n * 2U, (stride - alignedHalf) / 16, 0, 0};
                DataCopyPad(yg[uint64_t(window + offset) * n], result, ycp);
                pendingOutput = true;
                offset += rows;
            }
            window += windowRows;
        }
        if (end >= last)
            break;
    }
    PipeBarrier<PIPE_ALL>();
}

inline uint32_t KOneEffectiveAivCores(uint32_t m, int64_t availableCoreNum) {
    auto *platform = platform_ascendc::PlatformAscendCManager::GetInstance();
    if (!platform || availableCoreNum <= 0)
        return 0;
    const uint32_t aicCount = platform->GetCoreNumAic();
    const uint32_t aivCount = platform->GetCoreNumAiv();
    if (!aicCount)
        return 0;
    // availableCoreNum is an AIC budget in this interface. Clamp it before
    // multiplying, then use the actual platform AIV/AIC ratio.
    const uint64_t aicBudget = std::min<uint64_t>(uint64_t(availableCoreNum), aicCount);
    const uint64_t aivBudget = aicBudget * aivCount / aicCount;
    return std::min<uint32_t>(m, static_cast<uint32_t>(aivBudget));
}

inline bool
UseKOneWideRange(uint32_t m, uint32_t k, uint32_t n, uint32_t e, int64_t availableCoreNum) {
    // At least sixteen FP32 vector repeats per row. Smaller N stays on the
    // existing implementation; no particular M/N/E tuple is recognized.
    if (k != 1 || n < 16 * 64)
        return false;
    const uint32_t cores = KOneEffectiveAivCores(m, availableCoreNum);
    if (!cores)
        return false;
    // Intersecting E expert intervals with C contiguous core intervals creates
    // at most E+C-1 nonempty segments. This metadata-only sufficient condition
    // amortizes each weight/scale load over at least sixteen rows on average.
    return uint64_t(m) >= 16ULL * (uint64_t(e) + cores - 1);
}

inline void LaunchKOneVectorBatch(GM_ADDR x,
                                  GM_ADDR weight,
                                  GM_ADDR scale,
                                  GM_ADDR groups,
                                  GM_ADDR y,
                                  uint32_t m,
                                  uint32_t n,
                                  uint32_t e,
                                  int64_t availableCoreNum,
                                  aclrtStream stream) {
    const uint32_t cores = KOneEffectiveAivCores(m, availableCoreNum);
    if (!cores)
        throw std::runtime_error("K=1 vector no available cores");
    KOneVectorBatchKernel<<<cores, nullptr, stream>>>(x, weight, scale, groups, y, m, n, e, cores);
}
}

extern "C" void run_kernel(GM_ADDR x,
                           const TensorGroupInfo &ix,
                           GM_ADDR weight,
                           const TensorGroupInfo &iw,
                           GM_ADDR scale,
                           const TensorGroupInfo &is,
                           GM_ADDR group_list,
                           const TensorGroupInfo &ig,
                           GM_ADDR y,
                           const TensorGroupInfo &iy,
                           int64_t availableCoreNum,
                           aclrtStream stream) {
    using namespace GroupedGelu;
    const auto &a = ix.tensors[0];
    const auto &b = iw.tensors[0];
    if (a.numDims != 2 || b.numDims != 3 || is.tensors[0].numDims != 2 ||
        ig.tensors[0].numDims != 1 || iy.tensors[0].numDims != 2)
        throw std::invalid_argument("GroupedGelu input ranks");
    int64_t m = a.shape[0], k = a.shape[1], e = b.shape[0], n = b.shape[2];
    if (m < 1 || m > 65536 || k < 1 || k > 8192 || n < 1 || n > 4096 || e < 1 || e > 128 ||
        b.shape[1] != k || is.tensors[0].shape[0] != e || is.tensors[0].shape[1] != n ||
        ig.tensors[0].shape[0] != e || iy.tensors[0].shape[0] != m || iy.tensors[0].shape[1] != n ||
        a.dtype != 3 || b.dtype != 3 || is.tensors[0].dtype != 0 || ig.tensors[0].dtype != 6 ||
        iy.tensors[0].dtype != 1)
        throw std::invalid_argument("GroupedGelu input metadata");
    // Use the K=1 batch implementation only for wide rows with enough reuse.
    if (UseKOneWideRange(m, k, n, e, availableCoreNum)) {
        LaunchKOneVectorBatch(x, weight, scale, group_list, y, m, n, e, availableCoreNum, stream);
        return;
    }
    const auto choice = SelectShapeFamily(m, k, n, e);
    if (AdditionalNzRanges::TryLaunch(
            choice, x, weight, scale, group_list, y, m, k, n, e, availableCoreNum, stream)) {
        return;
    }
    using F = ShapeFamily;
    switch (choice.family) {
        case F::SmallOnePass: {
            SmallPlan p{};
            p.m = m;
            p.k = k;
            p.n = n;
            p.e = e;
            p.cores = std::min<int64_t>(availableCoreNum, 4);
            if (!p.cores)
                throw std::runtime_error("no available cores");
            Workspace scratch;
            scratch.stream = stream;
            Check(aclrtMalloc(
                &scratch.ptr, uint64_t(p.cores) * 2 * 16 * 128 * 4, ACL_MEM_MALLOC_HUGE_FIRST));
            const uint32_t packed = p.m | (p.k << 7) | (p.n << 15) | (p.cores << 23);
            SmallKernel<<<p.cores, nullptr, stream>>>(
                x, weight, scale, group_list, y, (GM_ADDR)scratch.ptr, packed);
            return;
        }
        case F::NdManual64:
            LaunchNd64(x, weight, scale, group_list, y, m, k, n, e, availableCoreNum, stream);
            return;
        case F::TinyGeneric:
            LaunchTiny(x, weight, scale, group_list, y, m, k, n, e, stream);
            return;
        case F::NdWideRows:
            Launch<64, 512, false, 2048, true>(
                x, weight, scale, group_list, y, m, k, n, e, availableCoreNum, stream);
            return;
        case F::NdShort:
            // Full task prefetch is reserved for input packets larger than logical int32 output.
            if (uint64_t(64 + n) * k > uint64_t(64) * n * sizeof(int32_t))
                Launch<64, 256, false, 256, false>(
                    x, weight, scale, group_list, y, m, k, n, e, availableCoreNum, stream);
            else
                Launch<128, 256, false, 256, false>(
                    x, weight, scale, group_list, y, m, k, n, e, availableCoreNum, stream);
            return;
        case F::NdMedium:
            Launch<128, 256, false, 512, false>(
                x, weight, scale, group_list, y, m, k, n, e, availableCoreNum, stream);
            return;
        case F::NdWideMerged:
            Launch<128, 256, false, 1024, true>(
                x, weight, scale, group_list, y, m, k, n, e, availableCoreNum, stream);
            return;
        case F::NdStandard:
            Launch<128, 256, false, 1024, false>(
                x, weight, scale, group_list, y, m, k, n, e, availableCoreNum, stream);
            return;
        case F::NdLongMerged:
            Launch<128, 256, false, 2048, true>(
                x, weight, scale, group_list, y, m, k, n, e, availableCoreNum, stream);
            return;
        case F::NzFullA1:
            Launch<128, 128, true, 1536, true>(
                x, weight, scale, group_list, y, m, k, n, e, availableCoreNum, stream);
            return;
        case F::NzStream:
            Launch<128, 128, true, 8192, false>(
                x, weight, scale, group_list, y, m, k, n, e, availableCoreNum, stream);
            return;
        default:
            CommonCubeVectorFallback(
                x, weight, scale, group_list, y, m, k, n, e, availableCoreNum, stream);
            return;
    }
}
