#define L2_CACHE_HINT 1

#ifndef GMG_BYPASS_X
#define GMG_BYPASS_X 0
#endif
#ifndef GMG_BYPASS_W
#define GMG_BYPASS_W 0
#endif
#ifndef GMG_BYPASS_Y
#define GMG_BYPASS_Y 0
#endif

#ifndef GMG_FLATCOPY
#define GMG_FLATCOPY 1
#endif

#include "kernel_operator.h"

namespace {

constexpr uint32_t kL1Bytes  = 512 * 1024;
constexpr uint32_t kL0ABytes = 64 * 1024;
constexpr uint32_t kL0BBytes = 64 * 1024;
constexpr uint32_t kL0CBytes = 128 * 1024;
constexpr uint32_t kUBBytes  = 192 * 1024;
#ifndef GMG_L1DEPTH
#define GMG_L1DEPTH 2
#endif
#ifndef GMG_AUTOBAL
#define GMG_AUTOBAL 0
#endif
constexpr int32_t  kL1Depth    = GMG_L1DEPTH;
constexpr bool     kAutoBalance = (GMG_AUTOBAL != 0);

#define GMG_RESIDENT_BYTES(K, BM, BN) ((int64_t)(((K) + 31) / 32 * 32) * ((BN) + 2 * (BM)))

#define GMG_RESIDENT_OK(M, K, N, E, BM, BN, CORES) \
    (GMG_RESIDENT_BYTES(K, BM, BN) <= (int64_t)(512 * 1024) - 1024 \
     && (int64_t)(M) >= 3 * (int64_t)(E) * (int64_t)(BM) \
     && (int64_t)(E) * (((int64_t)(N) + (BN) - 1) / (BN)) >= 2 * (int64_t)(CORES))

constexpr int32_t  kAResBytes = 336 * 1024;

constexpr int64_t  kARes64  = 523264 - 2LL * 512 * 256;
constexpr int64_t  kARes128 = 523264 - 2LL * 384 * 256;

#define GMG_TINY_PITCH(N) ((((int64_t)(N)) + 15) / 16 * 16)
#define GMG_TINY_OK(M, K, N) \
    ((int64_t)(K) <= 32 && (int64_t)(M) * GMG_TINY_PITCH(N) <= 256)
constexpr int32_t kTinyUbElems = 256;
constexpr int32_t kTinyKMax    = 32;
constexpr int64_t  kGroupUbMax = 512;
constexpr int32_t  kL1Depth_unused = 2;

constexpr uint16_t kFlagCubeDone0 = 3;
constexpr uint16_t kFlagCubeDone1 = 4;
constexpr uint16_t kFlagRange     = 8;

constexpr int64_t  kPubAreaElems  = 1024;
constexpr int64_t  kPubPerCore    = 16;

constexpr int64_t  kPubMinE       = 48;
constexpr uint16_t kFlagSlotFree0 = 5;
constexpr uint16_t kFlagSlotFree1 = 6;

__aicore__ inline int64_t AlignUp(int64_t v, int64_t a) { return (v + a - 1) / a * a; }
__aicore__ inline int64_t CeilDiv(int64_t v, int64_t a) { return (v + a - 1) / a; }

constexpr float kGeluC    = -1.5957691216057308f;
constexpr float kGeluC044 = -1.5957691216057308f * 0.044715f;
constexpr float kExpCap   = 80.0f;

template <int32_t BM, int32_t BN, int32_t BK, int32_t BKL1, int32_t SLOTS>
class KernelGroupedMatmulGelu {
public:

    static constexpr int32_t kDepth =
        (3 * (int64_t(BM) * BKL1 + int64_t(BKL1) * BN) <= int64_t(kL1Bytes) - 1024)
            ? 3 : kL1Depth;

    __aicore__ inline KernelGroupedMatmulGelu() {}

    bool wPaddedG_ = false;

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groupList,
                                GM_ADDR y, GM_ADDR workspace,
                                int64_t M, int64_t K, int64_t N, int64_t E,
                                bool wPadded = false)
    {

        wPaddedG_ = wPadded && !kAutoBalance;
        static_assert(BM % 16 == 0, "BM must be a multiple of the cube M fractal (16)");
        static_assert(BN % 32 == 0, "BN must be a multiple of 32 so each L0B row is whole");
        static_assert(BK % 32 == 0, "BK must be a multiple of the int8 C0 (32)");
        static_assert(int64_t(BM) * BN * 4 <= kL0CBytes, "accumulator exceeds L0C");

        static_assert(int64_t(BK) * BN * 2 <= kL0BBytes, "double-buffered L0B exceeds L0B");
        static_assert(int64_t(BM) * BK * 2 <= kL0ABytes, "double-buffered L0A exceeds L0A");
        static_assert(BKL1 % BK == 0, "an L1 slab must hold a whole number of Mmad K-steps");
        static_assert(kDepth * (int64_t(BM) * BKL1 + int64_t(BKL1) * BN) <= kL1Bytes - 1024, "L1 budget");
        static_assert(SLOTS == 2, "only the proved 2-slot credit ring is enabled");

        this->M_ = M; this->K_ = K; this->N_ = N; this->E_ = E;

        xGm_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
#if GMG_BYPASS_X
        xGm_.SetL2CacheHint<AscendC::CacheRwMode::READ>(AscendC::CacheMode::CACHE_MODE_DISABLE);
#endif

        wGm_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(weight));
#if GMG_BYPASS_W
        wGm_.SetL2CacheHint<AscendC::CacheRwMode::READ>(AscendC::CacheMode::CACHE_MODE_DISABLE);
#endif
        sGm_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scale));
        gGm_.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groupList));
        gGm32_.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(groupList));

        yGm_.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y));
#if GMG_BYPASS_Y
        yGm_.SetL2CacheHint<AscendC::CacheRwMode::WRITE>(AscendC::CacheMode::CACHE_MODE_DISABLE);
#endif

        pubGm_.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(workspace));
        accGm_.SetGlobalBuffer(
            reinterpret_cast<__gm__ int32_t*>(workspace) + kPubAreaElems);

        this->tilesN_ = CeilDiv(N, BN);
        this->tileN_   = BN;

        int64_t coreIdx = AscendC::GetBlockIdx();
        if ASCEND_IS_AIV { coreIdx = coreIdx / 2; }
        this->coreIdx_ = coreIdx;
        this->coreNum_ = AscendC::GetBlockNum();
        this->taskBegin_ = 0; this->taskEnd_ = 0;
    }

    __aicore__ inline void Process()
    {

        if ASCEND_IS_AIC { CubeProcess(); }
        if ASCEND_IS_AIV { VectorProcess(); }
    }

    __aicore__ inline void ComputeTaskRange()
    {

        int64_t gPrev = 0, totalBlocks = 0;
        for (int64_t e = 0; e < E_; ++e) {
            const int64_t end = GVal(e);
            totalBlocks += CeilDiv(end - gPrev, BM);
            gPrev = end;
        }

        if (kAutoBalance && totalBlocks > 0) {
            const int64_t base = CeilDiv(N_, BN);
            for (int64_t t = base; t <= base + coreNum_; ++t) {
                const int64_t w = AlignUp(CeilDiv(N_, t), 32);
                if (w > BN || w <= 0) continue;
                if (CeilDiv(N_, w) != t) continue;
                if ((totalBlocks * t) % coreNum_ == 0) {
                    tilesN_ = t;
                    tileN_  = static_cast<int32_t>(w);
                    break;
                }
            }
        }
        const int64_t totalTasks = totalBlocks * tilesN_;
        taskBegin_ = totalTasks * coreIdx_ / coreNum_;
        taskEnd_   = totalTasks * (coreIdx_ + 1) / coreNum_;
    }

private:

    __aicore__ inline int64_t GVal(int64_t e)
    {
        if ASCEND_IS_AIV {
            if (gInUb_) { return static_cast<int64_t>(gUb32_.GetValue(e * 2)); }
        }
        return gGm_.GetValue(e);
    }
    __aicore__ inline int64_t RowsOfExpert(int64_t e)
    {
        const int64_t end   = GVal(e);
        const int64_t begin = (e == 0) ? 0 : GVal(e - 1);
        return end - begin;
    }
    __aicore__ inline int64_t FirstRowOfExpert(int64_t e)
    {
        return (e == 0) ? 0 : GVal(e - 1);
    }

    struct Cursor { int64_t e = 0, blockBase = 0, firstRow = 0, rowsE = 0, blocksE = 0,
                            gPrev = 0; bool init = false; };

    __aicore__ inline void CursorSeek(Cursor& cur, int64_t blockIdx)
    {
        if (!cur.init) {
            cur.e = 0; cur.blockBase = 0; cur.firstRow = 0;
            cur.gPrev = GVal(0);
            cur.rowsE = cur.gPrev;
            cur.blocksE = CeilDiv(cur.rowsE, BM);
            cur.init = true;
        }

        while (cur.e + 1 < E_ && cur.blockBase + cur.blocksE <= blockIdx) {
            cur.blockBase += cur.blocksE;
            cur.firstRow  += cur.rowsE;
            const int64_t end = GVal(cur.e + 1);
            cur.rowsE   = end - cur.gPrev;
            cur.gPrev   = end;
            cur.blocksE = CeilDiv(cur.rowsE, BM);
            cur.e      += 1;
        }
    }

    __aicore__ inline void DecodeTask(Cursor& cur, int64_t task, int64_t& e, int64_t& rowBegin,
                                      int32_t& rows, int64_t& nBegin, int32_t& cols)
    {
        const int64_t blockIdx = task / tilesN_;
        const int64_t ntIdx    = task % tilesN_;
        CursorSeek(cur, blockIdx);
        e = cur.e;
        const int64_t mbInExpert = blockIdx - cur.blockBase;
        rowBegin = cur.firstRow + mbInExpert * BM;
        const int64_t r = cur.rowsE - mbInExpert * BM;
        rows = static_cast<int32_t>(r < BM ? r : BM);
        nBegin = ntIdx * tileN_;
        const int64_t c = N_ - nBegin;
        cols = static_cast<int32_t>(c < tileN_ ? c : tileN_);
    }

    template <typename AQ, typename BQ>
    __aicore__ inline void IssueSlab(AQ& aQue, BQ& bQue, int64_t e, int64_t rowBegin, int32_t rows,
                                     int64_t nBegin, int32_t cols, uint16_t mPad, uint16_t nPad,
                                     int32_t sl)
    {
        const int64_t k0    = int64_t(sl) * BKL1;
        const int32_t slabK = static_cast<int32_t>((K_ - k0 < BKL1) ? (K_ - k0) : BKL1);
        const uint16_t kPad = static_cast<uint16_t>(AlignUp(slabK, 32));
        auto a1 = aQue.template AllocTensor<int8_t>();
        auto b1 = bQue.template AllocTensor<int8_t>();
        const bool padA = (rows != mPad) || (slabK != kPad);

        const bool padB = wPaddedG_ ? (slabK != kPad)
                                    : ((cols != nPad) || (slabK != kPad));
        if (padA) {
            AscendC::Fill(a1.template ReinterpretCast<uint32_t>(),
                AscendC::InitConstValueParams<uint32_t>{1,
                    static_cast<uint16_t>(uint32_t(mPad) * kPad / 32), 0, 0U});
        }
        if (padB) {
            AscendC::Fill(b1.template ReinterpretCast<uint32_t>(),
                AscendC::InitConstValueParams<uint32_t>{1,
                    static_cast<uint16_t>(uint32_t(nPad) * kPad / 32), 0, 0U});
        }
        if (padA || padB) { AscendC::PipeBarrier<PIPE_MTE2>(); }
        AscendC::Nd2NzParams pa;
        pa.ndNum = 1; pa.nValue = static_cast<uint16_t>(rows);
        pa.dValue = static_cast<uint16_t>(slabK);
        pa.srcDValue = static_cast<uint16_t>(K_);
        pa.dstNzC0Stride = mPad; pa.dstNzNStride = 1;
        AscendC::DataCopy(a1, xGm_[rowBegin * K_ + k0], pa);
        AscendC::Nd2NzParams pb;
        pb.ndNum = 1; pb.nValue = static_cast<uint16_t>(slabK);
        pb.dstNzC0Stride = kPad; pb.dstNzNStride = 1;
        if (wPaddedG_) {

            const int64_t nt = nBegin / static_cast<int64_t>(BN);
            pb.dValue = static_cast<uint16_t>(BN);
            pb.srcDValue = static_cast<uint16_t>(BN);
            AscendC::DataCopy(b1,
                wGm_[((e * tilesN_ + nt) * K_ + k0) * static_cast<int64_t>(BN)], pb);
        } else {
            pb.dValue = static_cast<uint16_t>(cols);
            pb.srcDValue = static_cast<uint16_t>(N_);
            AscendC::DataCopy(b1, wGm_[(e * K_ + k0) * N_ + nBegin], pb);
        }
        aQue.EnQue(a1); bQue.EnQue(b1);
    }

    __aicore__ inline void PublishRange(const Cursor& cur)
    {
        if (E_ < kPubMinE) { return; }
        if (AscendC::GetSubBlockIdx() == 0) {
            pubUb_.SetValue(0, static_cast<int32_t>(taskBegin_));
            pubUb_.SetValue(1, static_cast<int32_t>(taskEnd_));
            pubUb_.SetValue(2, static_cast<int32_t>(tilesN_));
            pubUb_.SetValue(3, tileN_);
            pubUb_.SetValue(4, static_cast<int32_t>(cur.e));
            pubUb_.SetValue(5, static_cast<int32_t>(cur.blockBase));
            pubUb_.SetValue(6, static_cast<int32_t>(cur.firstRow));
            pubUb_.SetValue(7, static_cast<int32_t>(cur.rowsE));
            pubUb_.SetValue(8, static_cast<int32_t>(cur.blocksE));
            pubUb_.SetValue(9, static_cast<int32_t>(cur.gPrev));
            AscendC::SetFlag<AscendC::HardEvent::S_MTE3>(EVENT_ID3);
            AscendC::WaitFlag<AscendC::HardEvent::S_MTE3>(EVENT_ID3);
            AscendC::DataCopyExtParams cp{
                1, static_cast<uint32_t>(kPubPerCore) * 4u, 0, 0, 0};
            AscendC::DataCopyPad(pubGm_[coreIdx_ * kPubPerCore], pubUb_, cp);
        }

        AscendC::CrossCoreSetFlag<2, PIPE_MTE3>(kFlagRange);
    }

    __aicore__ inline void ConsumeRange(Cursor& cur)
    {
        if (E_ < kPubMinE) {
            ComputeTaskRange();
            CursorSeek(cur, taskBegin_ / (tilesN_ > 0 ? tilesN_ : 1));
            return;
        }
        AscendC::CrossCoreWaitFlag<2, PIPE_FIX>(kFlagRange);
        const int64_t b = coreIdx_ * kPubPerCore;

        AscendC::DataCacheCleanAndInvalid<int32_t,
            AscendC::CacheLine::SINGLE_CACHE_LINE,
            AscendC::DcciDst::CACHELINE_OUT>(pubGm_[b]);
        const int64_t tb = pubGm_.GetValue(b + 0);
        const int64_t te = pubGm_.GetValue(b + 1);
        const int64_t tn = pubGm_.GetValue(b + 2);
        const int32_t tw = pubGm_.GetValue(b + 3);

        const bool sane = (tb >= 0) && (te >= tb) && (tn >= 1) && (tw >= 1)
                       && (tw <= BN) && (te <= M_ * tn + tn);
        if (!sane) {
            ComputeTaskRange();
            CursorSeek(cur, taskBegin_ / (tilesN_ > 0 ? tilesN_ : 1));
            return;
        }
        taskBegin_ = tb; taskEnd_ = te; tilesN_ = tn; tileN_ = tw;
        cur.e         = pubGm_.GetValue(b + 4);
        cur.blockBase = pubGm_.GetValue(b + 5);
        cur.firstRow  = pubGm_.GetValue(b + 6);
        cur.rowsE     = pubGm_.GetValue(b + 7);
        cur.blocksE   = pubGm_.GetValue(b + 8);
        cur.gPrev     = pubGm_.GetValue(b + 9);
        cur.init      = true;
    }

    __aicore__ inline void CubeProcess()
    {
        AscendC::TPipe pipe;
        AscendC::TQue<AscendC::QuePosition::A1, kDepth> aQue;
        AscendC::TQue<AscendC::QuePosition::B1, kDepth> bQue;
        AscendC::TBuf<AscendC::TPosition::A2> a2Buf;
        AscendC::TBuf<AscendC::TPosition::B2> b2Buf;
        AscendC::TBuf<AscendC::TPosition::CO1> cBuf;
        pipe.InitBuffer(aQue, kDepth, BM * BKL1);
        pipe.InitBuffer(bQue, kDepth, BKL1 * BN);
        pipe.InitBuffer(a2Buf, 2 * BM * BK);
        pipe.InitBuffer(b2Buf, 2 * BK * BN);
        pipe.InitBuffer(cBuf, BM * BN * sizeof(int32_t));
        auto a2 = a2Buf.Get<int8_t>();
        auto b2 = b2Buf.Get<int8_t>();
        auto c0 = cBuf.Get<int32_t>();

        AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(6);
        AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(7);

        const int64_t slotElems = int64_t(BM) * BN;
        const int64_t wsBase    = coreIdx_ * SLOTS * slotElems;

        Cursor cur;
        ConsumeRange(cur);
        uint32_t seq = 0;

        const int32_t nSlabs  = static_cast<int32_t>(CeilDiv(K_, BKL1));
        const int64_t nTasks  = taskEnd_ - taskBegin_;
        const int64_t nIssue  = nTasks * nSlabs;
        constexpr int32_t kPrefetch = kDepth - 1;
        Cursor curIss = cur;
        int64_t gi = 0;

        for (; gi < kPrefetch && gi < nIssue; ++gi) {
            int64_t ie, irb, inb; int32_t irows, icols;
            DecodeTask(curIss, taskBegin_ + gi / nSlabs, ie, irb, irows, inb, icols);
            IssueSlab(aQue, bQue, ie, irb, irows, inb, icols,
                      static_cast<uint16_t>(AlignUp(irows, 16)),
                      static_cast<uint16_t>(BN),
                      static_cast<int32_t>(gi % nSlabs));
        }

        for (int64_t t = 0; t < nTasks; ++t) {
            int64_t e, rowBegin, nBegin; int32_t rows, cols;
            DecodeTask(cur, taskBegin_ + t, e, rowBegin, rows, nBegin, cols);
            const uint16_t mPad = static_cast<uint16_t>(AlignUp(rows, 16));

            const uint16_t nPadRaw = static_cast<uint16_t>((cols + 31) / 32 * 32);
            const uint16_t nPadNat = nPadRaw < 160 ? static_cast<uint16_t>(160)
                                   : (nPadRaw > BN ? static_cast<uint16_t>(BN) : nPadRaw);

            const uint16_t nPad = wPaddedG_ ? static_cast<uint16_t>(BN) : nPadNat;

            int32_t kStep = 0;
            for (int32_t sl = 0; sl < nSlabs; ++sl) {
                if (gi < nIssue) {
                    int64_t ie, irb, inb; int32_t irows, icols;
                    DecodeTask(curIss, taskBegin_ + gi / nSlabs, ie, irb, irows, inb, icols);
                    IssueSlab(aQue, bQue, ie, irb, irows, inb, icols,
                              static_cast<uint16_t>(AlignUp(irows, 16)),
                              static_cast<uint16_t>(BN),
                              static_cast<int32_t>(gi % nSlabs));
                    ++gi;
                }
                auto a1 = aQue.template DeQue<int8_t>();
                auto b1 = bQue.template DeQue<int8_t>();
                const int64_t k0      = int64_t(sl) * BKL1;
                const int32_t slabK   = static_cast<int32_t>((K_ - k0 < BKL1) ? (K_ - k0) : BKL1);
                const uint16_t kPadL1 = static_cast<uint16_t>(AlignUp(slabK, 32));

                for (int32_t kOff = 0; kOff < slabK; kOff += BK) {
                    const int32_t kLen  = (slabK - kOff < BK) ? (slabK - kOff) : BK;
                    const uint16_t kPad = static_cast<uint16_t>(AlignUp(kLen, 32));
                    const uint32_t slot = static_cast<uint32_t>(kStep & 1);
                    const uint32_t aOff = slot * BM * BK;
                    const uint32_t bOff = slot * BK * BN;

                    AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(static_cast<uint16_t>(6 + slot));
                    AscendC::LoadData2dParams la;
                    la.repeatTimes = static_cast<uint8_t>(kPad / 32);
                    la.srcStride   = static_cast<uint16_t>(mPad / 16);
                    la.ifTranspose = false;
                    for (uint32_t mb = 0; mb < uint32_t(mPad) / 16; ++mb) {
                        AscendC::LoadData(a2[aOff + mb * uint32_t(kPad) * 16],
                                          a1[(uint32_t(kOff) / 32) * uint32_t(mPad) * 32 + mb * 512], la);
                    }
                    AscendC::LoadData2dTransposeParams lb{
                        0, static_cast<uint8_t>(nPad / 32), static_cast<uint16_t>(kPadL1 / 32), 1, 0, 0};
                    for (uint32_t kb = 0; kb < uint32_t(kPad) / 32; ++kb) {
                        AscendC::LoadDataWithTranspose(b2[bOff + kb * uint32_t(nPad) * 32],
                                                       b1[(uint32_t(kOff) / 32 + kb) * 1024], lb);
                    }
                    AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID0);
                    AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID0);
                    if (kStep == 0 && seq > 0) {
                        AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(EVENT_ID1);
                    }
                    AscendC::MmadParams mad{mPad, nPad, kPad, 0, false, kStep == 0};
                    AscendC::Mmad(c0, a2[aOff], b2[bOff], mad);
                    AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(static_cast<uint16_t>(6 + slot));
                    ++kStep;
                }
                aQue.FreeTensor(a1); bQue.FreeTensor(b1);
            }

            const bool slotA = (seq & 1u) == 0;
            if (seq >= SLOTS) {
                AscendC::CrossCoreWaitFlag<2, PIPE_FIX>(slotA ? kFlagSlotFree0 : kFlagSlotFree1);
            }
            AscendC::SetFlag<AscendC::HardEvent::M_FIX>(EVENT_ID0);
            AscendC::WaitFlag<AscendC::HardEvent::M_FIX>(EVENT_ID0);

            AscendC::FixpipeParamsV220 fx;
            fx.nSize = static_cast<uint16_t>(cols);
            fx.mSize = static_cast<uint16_t>(rows);
            fx.srcStride = mPad;
            fx.dstStride = static_cast<uint32_t>(BN);
            AscendC::Fixpipe(accGm_[wsBase + (slotA ? 0 : slotElems)], c0, fx);

            AscendC::SetFlag<AscendC::HardEvent::FIX_M>(EVENT_ID1);
            AscendC::CrossCoreSetFlag<2, PIPE_FIX>(slotA ? kFlagCubeDone0 : kFlagCubeDone1);
            ++seq;
        }

        if (seq > 0) { AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(EVENT_ID1); }
        AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(6);
        AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(7);
    }

    __aicore__ inline void VectorProcess()
    {
        constexpr int32_t kVecRows = BM / 2;

        constexpr int32_t kUbRowCap    = 12288 / BN;
        constexpr int32_t kVecChunkRows = kVecRows < kUbRowCap ? kVecRows : kUbRowCap;
        constexpr int32_t kVecCnt  = kVecChunkRows * BN;
        static_assert(kVecCnt * 4 * 3 + kVecCnt * 2 + BN * 4 + kGroupUbMax * 8
                      + kPubPerCore * 4 <= kUBBytes, "UB budget");

        AscendC::TPipe pipe;
        AscendC::TBuf<AscendC::TPosition::VECCALC> accBuf, zBuf, tBuf, hBuf,
                                                   sBuf, gBuf, pubBuf;
        pipe.InitBuffer(accBuf, kVecCnt * sizeof(int32_t));
        pipe.InitBuffer(zBuf,   kVecCnt * sizeof(float));
        pipe.InitBuffer(tBuf,   kVecCnt * sizeof(float));
        pipe.InitBuffer(hBuf,   kVecCnt * sizeof(half));
        pipe.InitBuffer(sBuf,   BN * sizeof(float));
        auto acc = accBuf.Get<int32_t>();
        auto z   = zBuf.Get<float>();
        auto t   = tBuf.Get<float>();
        auto h   = hBuf.Get<half>();
        auto sc  = sBuf.Get<float>();

        pipe.InitBuffer(gBuf, kGroupUbMax * 2 * sizeof(int32_t));
        gUb32_ = gBuf.Get<int32_t>();
        if (E_ > 0 && E_ <= kGroupUbMax) {
            AscendC::DataCopyExtParams cg{1, static_cast<uint32_t>(E_ * 8), 0, 0, 0};
            AscendC::DataCopyPad(gUb32_, gGm32_, cg,
                                 AscendC::DataCopyPadExtParams<int32_t>{false, 0, 0, 0});

            AscendC::PipeBarrier<PIPE_ALL>();
            gInUb_ = true;
        }
        ComputeTaskRange();

        pipe.InitBuffer(pubBuf, static_cast<int32_t>(kPubPerCore) * 4);
        pubUb_ = pubBuf.Get<int32_t>();
        Cursor cur;
        CursorSeek(cur, taskBegin_ / (tilesN_ > 0 ? tilesN_ : 1));
        PublishRange(cur);

        bool pendMte3V = false, pendVMte2 = false;
        const int64_t sub      = AscendC::GetSubBlockIdx();
        const int64_t slotElems = int64_t(BM) * BN;
        const int64_t wsBase    = coreIdx_ * SLOTS * slotElems;
        uint32_t seq = 0;

        for (int64_t task = taskBegin_; task < taskEnd_; ++task) {
            int64_t e, rowBegin, nBegin; int32_t rows, cols;
            DecodeTask(cur, task, e, rowBegin, rows, nBegin, cols);

            const bool slotA = (seq & 1u) == 0;
            AscendC::CrossCoreWaitFlag<2, PIPE_MTE2>(slotA ? kFlagCubeDone0 : kFlagCubeDone1);
            ++seq;

            const int32_t myFirst = static_cast<int32_t>(sub) * kVecRows;
            const int32_t myRows  = (rows - myFirst) <= 0 ? 0
                                  : ((rows - myFirst) < kVecRows ? (rows - myFirst) : kVecRows);

            for (int32_t coff = 0; coff < myRows; coff += kVecChunkRows) {
                const int32_t rThis = (myRows - coff) < kVecChunkRows
                                    ? (myRows - coff) : kVecChunkRows;
                const int64_t src = wsBase + (slotA ? 0 : slotElems) + int64_t((myFirst + coff)) * BN;

                const int32_t  pitchUb = (cols + 15) / 16 * 16;
                const uint32_t cnt = (pitchUb == BN)
                    ? static_cast<uint32_t>(rThis) * static_cast<uint32_t>(BN)
                    : static_cast<uint32_t>(rThis) * static_cast<uint32_t>(pitchUb);

                if (pendVMte2) {
                    AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID1);
                    pendVMte2 = false;
                }

                const bool kFlatIn = (GMG_FLATCOPY != 0) && (cols == BN) && (pitchUb == BN);
                const uint16_t kInCnt  = kFlatIn ? static_cast<uint16_t>(1)
                                                 : static_cast<uint16_t>(rThis);
                const uint32_t kInLen  = kFlatIn
                    ? static_cast<uint32_t>(rThis) * static_cast<uint32_t>(BN) * 4u
                    : static_cast<uint32_t>(cols * 4);
                const uint32_t kInSrcS = kFlatIn ? 0u
                                                 : static_cast<uint32_t>((BN - cols) * 4);
                const uint32_t kInDstS = kFlatIn ? 0u
                    : static_cast<uint32_t>((pitchUb - (cols + 7) / 8 * 8) / 8);
                AscendC::DataCopyExtParams ci{kInCnt, kInLen, kInSrcS, kInDstS, 0};
                AscendC::DataCopyPad(acc, accGm_[src], ci,
                                     AscendC::DataCopyPadExtParams<int32_t>{false, 0, 0, 0});
                AscendC::DataCopyExtParams cs{1, static_cast<uint32_t>(cols * 4), 0, 0, 0};
                AscendC::DataCopyPad(sc, sGm_[e * N_ + nBegin], cs,
                                     AscendC::DataCopyPadExtParams<float>{false, 0, 0, 0});
                AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
                AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

                if (pendMte3V) {
                    AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID2);
                    pendMte3V = false;
                }

                AscendC::Cast(z, acc, AscendC::RoundMode::CAST_RINT, cnt);
                AscendC::PipeBarrier<PIPE_V>();

                if (pitchUb == BN) {
                    for (int32_t col = 0; col < BN; col += 64) {
                        const int32_t vlen = (BN - col) < 64 ? (BN - col) : 64;
                        AscendC::Mul(z[col], z[col], sc[col], uint64_t(vlen),
                                     static_cast<uint8_t>(rThis),
                                     AscendC::BinaryRepeatParams{1, 1, 1, BN / 8, BN / 8, 0});
                    }
                } else {
                    for (int32_t col = 0; col < pitchUb; col += 64) {
                        const int32_t vlen = (pitchUb - col) < 64 ? (pitchUb - col) : 64;
                        AscendC::Mul(z[col], z[col], sc[col], uint64_t(vlen),
                                     static_cast<uint8_t>(rThis),
                                     AscendC::BinaryRepeatParams{
                                         1, 1, 1, static_cast<uint8_t>(pitchUb / 8),
                                         static_cast<uint8_t>(pitchUb / 8), 0});
                    }
                }
                AscendC::PipeBarrier<PIPE_V>();

                AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID1);
                pendVMte2 = true;

                AscendC::Mul (t, z, z, cnt);
                AscendC::Muls(t, t, kGeluC044, cnt);
                AscendC::Adds(t, t, kGeluC, cnt);
                AscendC::Mul (t, t, z, cnt);
                AscendC::Exp (t, t, cnt);
                AscendC::Adds(t, t, 1.0f, cnt);
                AscendC::Div (t, z, t, cnt);
                AscendC::Cast(h, t, AscendC::RoundMode::CAST_RINT, cnt);

                AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
                AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);

                const bool kFlatOut = (GMG_FLATCOPY != 0)
                                   && (static_cast<int64_t>(cols) == N_)
                                   && (pitchUb == cols);
                const uint16_t kOutCnt  = kFlatOut ? static_cast<uint16_t>(1)
                                                   : static_cast<uint16_t>(rThis);
                const uint32_t kOutLen  = kFlatOut
                    ? static_cast<uint32_t>(rThis) * static_cast<uint32_t>(cols) * 2u
                    : static_cast<uint32_t>(cols * 2);
                const uint32_t kOutSrcS = kFlatOut ? 0u
                    : static_cast<uint32_t>((pitchUb - (cols + 15) / 16 * 16) / 16);
                const uint32_t kOutDstS = kFlatOut ? 0u
                                                   : static_cast<uint32_t>((N_ - cols) * 2);
                AscendC::DataCopyExtParams co{kOutCnt, kOutLen, kOutSrcS, kOutDstS, 0};
                AscendC::DataCopyPad(yGm_[(rowBegin + (myFirst + coff)) * N_ + nBegin], h, co);
                AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID2);
                pendMte3V = true;
            }

            AscendC::CrossCoreSetFlag<2, PIPE_MTE2>(slotA ? kFlagSlotFree0 : kFlagSlotFree1);
        }

        if (pendVMte2) { AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID1); }
        if (pendMte3V) { AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID2); }
    }

    AscendC::GlobalTensor<int8_t>  xGm_, wGm_;
    AscendC::GlobalTensor<float>   sGm_;
    AscendC::GlobalTensor<int64_t> gGm_;
    AscendC::GlobalTensor<half>    yGm_;
    AscendC::GlobalTensor<int32_t> accGm_;
    AscendC::GlobalTensor<int32_t> pubGm_;

    AscendC::GlobalTensor<int32_t> gGm32_;
    AscendC::LocalTensor<int32_t>  pubUb_;
    AscendC::LocalTensor<int32_t>  gUb32_;
    bool gInUb_ = false;
    int64_t M_ = 0, K_ = 0, N_ = 0, E_ = 0;
    int64_t tilesN_ = 1;
    int32_t tileN_ = BN;
    int64_t coreIdx_ = 0, coreNum_ = 1;
    int64_t taskBegin_ = 0, taskEnd_ = 0;
};

template <int32_t BM, int32_t BN, int32_t BK, int32_t BKL1, int32_t SLOTS,
          int64_t ARESB = kAResBytes>
class KernelGmgAres {
    static constexpr bool ARES = true;

    static constexpr int64_t kABytes = ARES ? (int64_t)ARESB : 2 * (int64_t)BM * BKL1;
public:
    __aicore__ inline KernelGmgAres() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groupList,
                                GM_ADDR y, GM_ADDR workspace,
                                int64_t M, int64_t K, int64_t N, int64_t E,
                                bool wPadded = false)
    {
        static_assert(BM % 16 == 0, "BM must be a multiple of the cube M fractal (16)");
        static_assert(BN % 32 == 0, "BN must be a multiple of 32 so each L0B row is whole");
        static_assert(BK % 32 == 0, "BK must be a multiple of the int8 C0 (32)");
        static_assert(int64_t(BM) * BN * 4 <= kL0CBytes, "accumulator exceeds L0C");

        static_assert(int64_t(BK) * BN * 2 <= kL0BBytes, "double-buffered L0B exceeds L0B");
        static_assert(int64_t(BM) * BK * 2 <= kL0ABytes, "double-buffered L0A exceeds L0A");
        static_assert(BKL1 % BK == 0, "an L1 slab must hold a whole number of Mmad K-steps");
        static_assert(kABytes + kL1Depth * int64_t(BKL1) * BN <= kL1Bytes - 1024, "L1 budget");
        static_assert(int64_t(BM) * BN * 4 <= kL0CBytes, "L0C");
        static_assert(int64_t(BM) * BK * 2 <= kL0ABytes, "L0A");
        static_assert(2 * int64_t(BM) * BKL1 <= kABytes, "A stream needs two half slots");
        static_assert(SLOTS == 2, "only the proved 2-slot credit ring is enabled");

        this->M_ = M; this->K_ = K; this->N_ = N; this->E_ = E;

        xGm_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
#if GMG_BYPASS_X
        xGm_.SetL2CacheHint<AscendC::CacheRwMode::READ>(AscendC::CacheMode::CACHE_MODE_DISABLE);
#endif

        wGm_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(weight));
#if GMG_BYPASS_W
        wGm_.SetL2CacheHint<AscendC::CacheRwMode::READ>(AscendC::CacheMode::CACHE_MODE_DISABLE);
#endif
        sGm_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scale));
        gGm_.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groupList));
        gGm32_.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(groupList));

        yGm_.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y));
#if GMG_BYPASS_Y
        yGm_.SetL2CacheHint<AscendC::CacheRwMode::WRITE>(AscendC::CacheMode::CACHE_MODE_DISABLE);
#endif

        pubGm_.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(workspace));
        accGm_.SetGlobalBuffer(
            reinterpret_cast<__gm__ int32_t*>(workspace) + kPubAreaElems);

        this->tilesN_ = CeilDiv(N, BN);
        this->tileN_   = BN;

        this->kPadK_  = AlignUp(K, 32);

        this->wPadded_ = wPadded && !kAutoBalance;

        this->aOk_ = (int64_t(BM) * this->kPadK_ <= kABytes);

        int64_t coreIdx = AscendC::GetBlockIdx();
        if ASCEND_IS_AIV { coreIdx = coreIdx / 2; }
        this->coreIdx_ = coreIdx;
        this->coreNum_ = AscendC::GetBlockNum();
        this->taskBegin_ = 0; this->taskEnd_ = 0;
    }

    __aicore__ inline void Process()
    {

        if ASCEND_IS_AIC { CubeProcess(); }
        if ASCEND_IS_AIV { VectorProcess(); }
    }

    __aicore__ inline void ComputeTaskRange()
    {

        int64_t gPrev = 0, totalBlocks = 0;
        for (int64_t e = 0; e < E_; ++e) {
            const int64_t end = GVal(e);
            totalBlocks += CeilDiv(end - gPrev, BM);
            gPrev = end;
        }

        if (kAutoBalance && totalBlocks > 0) {
            const int64_t base = CeilDiv(N_, BN);
            for (int64_t t = base; t <= base + coreNum_; ++t) {
                const int64_t w = AlignUp(CeilDiv(N_, t), 32);
                if (w > BN || w <= 0) continue;
                if (CeilDiv(N_, w) != t) continue;
                if ((totalBlocks * t) % coreNum_ == 0) {
                    tilesN_ = t;
                    tileN_  = static_cast<int32_t>(w);
                    break;
                }
            }
        }
        const int64_t totalTasks = totalBlocks * tilesN_;
        taskBegin_ = totalTasks * coreIdx_ / coreNum_;
        taskEnd_   = totalTasks * (coreIdx_ + 1) / coreNum_;
    }

private:

    __aicore__ inline int64_t GVal(int64_t e)
    {
        if ASCEND_IS_AIV {
            if (gInUb_) { return static_cast<int64_t>(gUb32_.GetValue(e * 2)); }
        }
        return gGm_.GetValue(e);
    }
    __aicore__ inline int64_t RowsOfExpert(int64_t e)
    {
        const int64_t end   = GVal(e);
        const int64_t begin = (e == 0) ? 0 : GVal(e - 1);
        return end - begin;
    }
    __aicore__ inline int64_t FirstRowOfExpert(int64_t e)
    {
        return (e == 0) ? 0 : GVal(e - 1);
    }

    struct Cursor { int64_t e = 0, blockBase = 0, firstRow = 0, rowsE = 0, blocksE = 0,
                            gPrev = 0; bool init = false; };

    __aicore__ inline void CursorSeek(Cursor& cur, int64_t blockIdx)
    {
        if (!cur.init) {
            cur.e = 0; cur.blockBase = 0; cur.firstRow = 0;
            cur.gPrev = GVal(0);
            cur.rowsE = cur.gPrev;
            cur.blocksE = CeilDiv(cur.rowsE, BM);
            cur.init = true;
        }

        while (cur.e + 1 < E_ && cur.blockBase + cur.blocksE <= blockIdx) {
            cur.blockBase += cur.blocksE;
            cur.firstRow  += cur.rowsE;
            const int64_t end = GVal(cur.e + 1);
            cur.rowsE   = end - cur.gPrev;
            cur.gPrev   = end;
            cur.blocksE = CeilDiv(cur.rowsE, BM);
            cur.e      += 1;
        }
    }

    __aicore__ inline void DecodeTask(Cursor& cur, int64_t task, int64_t& e, int64_t& rowBegin,
                                      int32_t& rows, int64_t& nBegin, int32_t& cols)
    {
        const int64_t blockIdx = task / tilesN_;
        const int64_t ntIdx    = task % tilesN_;
        CursorSeek(cur, blockIdx);
        e = cur.e;
        const int64_t mbInExpert = blockIdx - cur.blockBase;
        rowBegin = cur.firstRow + mbInExpert * BM;
        const int64_t r = cur.rowsE - mbInExpert * BM;
        rows = static_cast<int32_t>(r < BM ? r : BM);
        nBegin = ntIdx * tileN_;
        const int64_t c = N_ - nBegin;
        cols = static_cast<int32_t>(c < tileN_ ? c : tileN_);
    }

    template <typename AT>
    __aicore__ inline void IssueAStream(AT& a1, int64_t rowBegin, int32_t rows, uint16_t mPad,
                                        int32_t sl, int32_t slot)
    {
        const int64_t  k0    = int64_t(sl) * BKL1;
        const int32_t  slabK = static_cast<int32_t>((K_ - k0 < BKL1) ? (K_ - k0) : BKL1);
        const uint16_t kPadL = static_cast<uint16_t>(AlignUp(slabK, 32));
        const uint32_t base  = static_cast<uint32_t>(slot) * uint32_t(BM) * uint32_t(BKL1);
        if (slot == 0) { AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID3); }
        else           { AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID2); }
        if (rows != mPad || slabK != kPadL) {
            AscendC::Fill(a1[base].template ReinterpretCast<uint32_t>(),
                AscendC::InitConstValueParams<uint32_t>{1,
                    static_cast<uint16_t>(uint32_t(mPad) * uint32_t(kPadL) / 32), 0, 0U});
            AscendC::PipeBarrier<PIPE_MTE2>();
        }
        AscendC::Nd2NzParams pa;
        pa.ndNum = 1; pa.nValue = static_cast<uint16_t>(rows);
        pa.dValue = static_cast<uint16_t>(slabK);
        pa.srcDValue = static_cast<uint16_t>(K_);
        pa.dstNzC0Stride = mPad; pa.dstNzNStride = 1;
        AscendC::DataCopy(a1[base], xGm_[rowBegin * K_ + k0], pa);
        if (slot == 0) { AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(EVENT_ID3); }
        else           { AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(EVENT_ID2); }
    }

    template <typename BQ, typename AT>
    __aicore__ inline void IssueSlab(BQ& bQue, AT& a1, int64_t e, int64_t rowBegin, int32_t rows,
                                     int64_t nBegin, int32_t cols, uint16_t mPad, uint16_t nPad,
                                     int32_t sl, int64_t issIdx)
    {
        if (!ARES) { IssueAStream(a1, rowBegin, rows, mPad, sl, static_cast<int32_t>(issIdx & 1)); }
        const int64_t k0    = int64_t(sl) * BKL1;
        const int32_t slabK = static_cast<int32_t>((K_ - k0 < BKL1) ? (K_ - k0) : BKL1);
        const uint16_t kPad = static_cast<uint16_t>(AlignUp(slabK, 32));
        auto b1 = bQue.template AllocTensor<int8_t>();

        const bool padB = wPadded_ ? (slabK != kPad)
                                   : ((cols != nPad) || (slabK != kPad));
        if (padB) {
            AscendC::Fill(b1.template ReinterpretCast<uint32_t>(),
                AscendC::InitConstValueParams<uint32_t>{1,
                    static_cast<uint16_t>(uint32_t(nPad) * kPad / 32), 0, 0U});
        }
        if (padB) { AscendC::PipeBarrier<PIPE_MTE2>(); }
        (void)rows; (void)rowBegin; (void)mPad;
        AscendC::Nd2NzParams pb;
        pb.ndNum = 1; pb.nValue = static_cast<uint16_t>(slabK);
        pb.dstNzC0Stride = kPad; pb.dstNzNStride = 1;
        if (wPadded_) {

            pb.dValue = static_cast<uint16_t>(BN);
            pb.srcDValue = static_cast<uint16_t>(BN);
            const int64_t nt = nBegin / static_cast<int64_t>(BN);
            AscendC::DataCopy(b1,
                wGm_[((e * tilesN_ + nt) * K_ + k0) * static_cast<int64_t>(BN)], pb);
        } else {
            pb.dValue = static_cast<uint16_t>(cols);
            pb.srcDValue = static_cast<uint16_t>(N_);
            AscendC::DataCopy(b1, wGm_[(e * K_ + k0) * N_ + nBegin], pb);
        }
        bQue.EnQue(b1);
    }

    __aicore__ inline void CubeProcess()
    {
        ComputeTaskRange();
        AscendC::TPipe pipe;
        AscendC::TBuf<AscendC::TPosition::A1> aBuf;
        AscendC::TQue<AscendC::QuePosition::B1, kL1Depth> bQue;
        AscendC::TBuf<AscendC::TPosition::A2> a2Buf;
        AscendC::TBuf<AscendC::TPosition::B2> b2Buf;
        AscendC::TBuf<AscendC::TPosition::CO1> cBuf;
        pipe.InitBuffer(aBuf, (int32_t)kABytes);
        pipe.InitBuffer(bQue, kL1Depth, BKL1 * BN);
        pipe.InitBuffer(a2Buf, 2 * BM * BK);
        pipe.InitBuffer(b2Buf, 2 * BK * BN);
        pipe.InitBuffer(cBuf, BM * BN * sizeof(int32_t));
        auto a1 = aBuf.Get<int8_t>();
        auto a2 = a2Buf.Get<int8_t>();
        auto b2 = b2Buf.Get<int8_t>();
        auto c0 = cBuf.Get<int32_t>();

        AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(6);
        AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(7);

        if (!ARES) {
            AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID3);
            AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID2);
        }

        const int64_t slotElems = int64_t(BM) * BN;
        const int64_t wsBase    = coreIdx_ * SLOTS * slotElems;

        Cursor cur;
        CursorSeek(cur, taskBegin_ / (tilesN_ > 0 ? tilesN_ : 1));
        uint32_t seq = 0;

        const int32_t nSlabs  = static_cast<int32_t>(CeilDiv(K_, BKL1));
        const int64_t nTasks  = taskEnd_ - taskBegin_;
        const int64_t nIssue  = nTasks * nSlabs;
        constexpr int32_t kPrefetch = kL1Depth - 1;
        int64_t aKeyCur = -1;
        Cursor curIss = cur;
        int64_t gi = 0;

        for (; gi < kPrefetch && gi < nIssue; ++gi) {
            int64_t ie, irb, inb; int32_t irows, icols;
            DecodeTask(curIss, taskBegin_ + gi / nSlabs, ie, irb, irows, inb, icols);
            IssueSlab(bQue, a1, ie, irb, irows, inb, icols,
                      static_cast<uint16_t>(AlignUp(irows, 16)),
                      static_cast<uint16_t>(BN),
                      static_cast<int32_t>(gi % nSlabs), gi);
        }

        for (int64_t t = 0; t < nTasks; ++t) {
            int64_t e, rowBegin, nBegin; int32_t rows, cols;
            DecodeTask(cur, taskBegin_ + t, e, rowBegin, rows, nBegin, cols);
            const uint16_t mPad = static_cast<uint16_t>(AlignUp(rows, 16));

            const uint16_t nPadRaw = static_cast<uint16_t>((cols + 31) / 32 * 32);
            const uint16_t nPadNat = nPadRaw < 160 ? static_cast<uint16_t>(160)
                                   : (nPadRaw > BN ? static_cast<uint16_t>(BN) : nPadRaw);

            const uint16_t nPad = wPadded_ ? static_cast<uint16_t>(BN) : nPadNat;

            if (ARES) {
                if (rowBegin != aKeyCur) {

                    AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID3);
                    AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID3);
                    if (rows != mPad || kPadK_ != K_) {
                        AscendC::Fill(a1.template ReinterpretCast<uint32_t>(),
                            AscendC::InitConstValueParams<uint32_t>{1,
                                static_cast<uint16_t>(uint32_t(mPad) * uint32_t(kPadK_) / 32), 0, 0U});
                        AscendC::PipeBarrier<PIPE_MTE2>();
                    }
                    AscendC::Nd2NzParams pa;
                    pa.ndNum = 1; pa.nValue = static_cast<uint16_t>(rows);
                    pa.dValue = static_cast<uint16_t>(K_);
                    pa.srcDValue = static_cast<uint16_t>(K_);
                    pa.dstNzC0Stride = mPad; pa.dstNzNStride = 1;
                    AscendC::DataCopy(a1, xGm_[rowBegin * K_], pa);
                    AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(EVENT_ID3);
                    AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(EVENT_ID3);
                    aKeyCur = rowBegin;
                }
            }

            int32_t kStep = 0;
            for (int32_t sl = 0; sl < nSlabs; ++sl) {
                if (gi < nIssue) {
                    int64_t ie, irb, inb; int32_t irows, icols;
                    DecodeTask(curIss, taskBegin_ + gi / nSlabs, ie, irb, irows, inb, icols);
                    IssueSlab(bQue, a1, ie, irb, irows, inb, icols,
                              static_cast<uint16_t>(AlignUp(irows, 16)),
                              static_cast<uint16_t>(BN),
                              static_cast<int32_t>(gi % nSlabs), gi);
                    ++gi;
                }
                auto b1 = bQue.template DeQue<int8_t>();
                const int64_t k0      = int64_t(sl) * BKL1;
                const int32_t slabK   = static_cast<int32_t>((K_ - k0 < BKL1) ? (K_ - k0) : BKL1);
                const uint16_t kPadL1 = static_cast<uint16_t>(AlignUp(slabK, 32));
                int32_t aSlot = 0;
                if (!ARES) {

                    aSlot = static_cast<int32_t>(((t * nSlabs) + sl) & 1);
                    if (aSlot == 0) { AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(EVENT_ID3); }
                    else            { AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(EVENT_ID2); }
                }

                for (int32_t kOff = 0; kOff < slabK; kOff += BK) {
                    const int32_t kLen  = (slabK - kOff < BK) ? (slabK - kOff) : BK;
                    const uint16_t kPad = static_cast<uint16_t>(AlignUp(kLen, 32));
                    const uint32_t slot = static_cast<uint32_t>(kStep & 1);
                    const uint32_t aOff = slot * BM * BK;

                    const uint32_t aKBlk = static_cast<uint32_t>(
                        (ARES ? (k0 + int64_t(kOff)) : int64_t(kOff)) / 32);
                    const uint32_t aSlotBase = ARES ? 0u
                        : static_cast<uint32_t>(aSlot) * uint32_t(BM) * uint32_t(BKL1);
                    const uint32_t bOff = slot * BK * BN;

                    AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(static_cast<uint16_t>(6 + slot));
                    AscendC::LoadData2dParams la;
                    la.repeatTimes = static_cast<uint8_t>(kPad / 32);
                    la.srcStride   = static_cast<uint16_t>(mPad / 16);
                    la.ifTranspose = false;
                    for (uint32_t mb = 0; mb < uint32_t(mPad) / 16; ++mb) {
                        AscendC::LoadData(a2[aOff + mb * uint32_t(kPad) * 16],
                                          a1[aSlotBase + aKBlk * uint32_t(mPad) * 32 + mb * 512], la);
                    }
                    AscendC::LoadData2dTransposeParams lb{
                        0, static_cast<uint8_t>(nPad / 32), static_cast<uint16_t>(kPadL1 / 32), 1, 0, 0};
                    for (uint32_t kb = 0; kb < uint32_t(kPad) / 32; ++kb) {
                        AscendC::LoadDataWithTranspose(b2[bOff + kb * uint32_t(nPad) * 32],
                                                       b1[(uint32_t(kOff) / 32 + kb) * 1024], lb);
                    }
                    AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID0);
                    AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID0);
                    if (kStep == 0 && seq > 0) {
                        AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(EVENT_ID1);
                    }
                    AscendC::MmadParams mad{mPad, nPad, kPad, 0, false, kStep == 0};
                    AscendC::Mmad(c0, a2[aOff], b2[bOff], mad);
                    AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(static_cast<uint16_t>(6 + slot));
                    ++kStep;
                }
                if (!ARES) {

                    if (aSlot == 0) { AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID3); }
                    else            { AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID2); }
                }
                bQue.FreeTensor(b1);
            }

            const bool slotA = (seq & 1u) == 0;
            if (seq >= SLOTS) {
                AscendC::CrossCoreWaitFlag<2, PIPE_FIX>(slotA ? kFlagSlotFree0 : kFlagSlotFree1);
            }
            AscendC::SetFlag<AscendC::HardEvent::M_FIX>(EVENT_ID0);
            AscendC::WaitFlag<AscendC::HardEvent::M_FIX>(EVENT_ID0);

            AscendC::FixpipeParamsV220 fx;
            fx.nSize = static_cast<uint16_t>(cols);
            fx.mSize = static_cast<uint16_t>(rows);
            fx.srcStride = mPad;
            fx.dstStride = static_cast<uint32_t>(BN);
            AscendC::Fixpipe(accGm_[wsBase + (slotA ? 0 : slotElems)], c0, fx);

            AscendC::SetFlag<AscendC::HardEvent::FIX_M>(EVENT_ID1);
            AscendC::CrossCoreSetFlag<2, PIPE_FIX>(slotA ? kFlagCubeDone0 : kFlagCubeDone1);
            ++seq;
        }

        if (seq > 0) { AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(EVENT_ID1); }
        AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(6);
        AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(7);
        if (!ARES) {
            AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID3);
            AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID2);
        }
    }

    __aicore__ inline void VectorProcess()
    {
        constexpr int32_t kVecRows = BM / 2;

        constexpr int32_t kUbRowCap    = 12288 / BN;
        constexpr int32_t kVecChunkRows = kVecRows < kUbRowCap ? kVecRows : kUbRowCap;
        constexpr int32_t kVecCnt  = kVecChunkRows * BN;
        static_assert(kVecCnt * 4 * 3 + kVecCnt * 2 + BN * 4 + kGroupUbMax * 8 <= kUBBytes,
                      "UB budget");

        AscendC::TPipe pipe;
        AscendC::TBuf<AscendC::TPosition::VECCALC> accBuf, zBuf, tBuf, hBuf, sBuf, gBuf;
        pipe.InitBuffer(accBuf, kVecCnt * sizeof(int32_t));
        pipe.InitBuffer(zBuf,   kVecCnt * sizeof(float));
        pipe.InitBuffer(tBuf,   kVecCnt * sizeof(float));
        pipe.InitBuffer(hBuf,   kVecCnt * sizeof(half));
        pipe.InitBuffer(sBuf,   BN * sizeof(float));
        auto acc = accBuf.Get<int32_t>();
        auto z   = zBuf.Get<float>();
        auto t   = tBuf.Get<float>();
        auto h   = hBuf.Get<half>();
        auto sc  = sBuf.Get<float>();

        pipe.InitBuffer(gBuf, kGroupUbMax * 2 * sizeof(int32_t));
        gUb32_ = gBuf.Get<int32_t>();
        if (E_ > 0 && E_ <= kGroupUbMax) {
            AscendC::DataCopyExtParams cg{1, static_cast<uint32_t>(E_ * 8), 0, 0, 0};
            AscendC::DataCopyPad(gUb32_, gGm32_, cg,
                                 AscendC::DataCopyPadExtParams<int32_t>{false, 0, 0, 0});

            AscendC::PipeBarrier<PIPE_ALL>();
            gInUb_ = true;
        }
        ComputeTaskRange();

        Cursor cur;
        CursorSeek(cur, taskBegin_ / (tilesN_ > 0 ? tilesN_ : 1));

        bool pendMte3V = false, pendVMte2 = false;
        const int64_t sub      = AscendC::GetSubBlockIdx();
        const int64_t slotElems = int64_t(BM) * BN;
        const int64_t wsBase    = coreIdx_ * SLOTS * slotElems;
        uint32_t seq = 0;

        for (int64_t task = taskBegin_; task < taskEnd_; ++task) {
            int64_t e, rowBegin, nBegin; int32_t rows, cols;
            DecodeTask(cur, task, e, rowBegin, rows, nBegin, cols);

            const bool slotA = (seq & 1u) == 0;
            AscendC::CrossCoreWaitFlag<2, PIPE_MTE2>(slotA ? kFlagCubeDone0 : kFlagCubeDone1);
            ++seq;

            const int32_t myFirst = static_cast<int32_t>(sub) * kVecRows;
            const int32_t myRows  = (rows - myFirst) <= 0 ? 0
                                  : ((rows - myFirst) < kVecRows ? (rows - myFirst) : kVecRows);

            for (int32_t coff = 0; coff < myRows; coff += kVecChunkRows) {
                const int32_t rThis = (myRows - coff) < kVecChunkRows
                                    ? (myRows - coff) : kVecChunkRows;
                const int64_t src = wsBase + (slotA ? 0 : slotElems) + int64_t((myFirst + coff)) * BN;

                const int32_t  pitchUb = (cols + 15) / 16 * 16;
                const uint32_t cnt = (pitchUb == BN)
                    ? static_cast<uint32_t>(rThis) * static_cast<uint32_t>(BN)
                    : static_cast<uint32_t>(rThis) * static_cast<uint32_t>(pitchUb);

                if (pendVMte2) {
                    AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID1);
                    pendVMte2 = false;
                }

                const bool kFlatIn = (GMG_FLATCOPY != 0) && (cols == BN) && (pitchUb == BN);
                const uint16_t kInCnt  = kFlatIn ? static_cast<uint16_t>(1)
                                                 : static_cast<uint16_t>(rThis);
                const uint32_t kInLen  = kFlatIn
                    ? static_cast<uint32_t>(rThis) * static_cast<uint32_t>(BN) * 4u
                    : static_cast<uint32_t>(cols * 4);
                const uint32_t kInSrcS = kFlatIn ? 0u
                                                 : static_cast<uint32_t>((BN - cols) * 4);
                const uint32_t kInDstS = kFlatIn ? 0u
                    : static_cast<uint32_t>((pitchUb - (cols + 7) / 8 * 8) / 8);
                AscendC::DataCopyExtParams ci{kInCnt, kInLen, kInSrcS, kInDstS, 0};
                AscendC::DataCopyPad(acc, accGm_[src], ci,
                                     AscendC::DataCopyPadExtParams<int32_t>{false, 0, 0, 0});
                AscendC::DataCopyExtParams cs{1, static_cast<uint32_t>(cols * 4), 0, 0, 0};
                AscendC::DataCopyPad(sc, sGm_[e * N_ + nBegin], cs,
                                     AscendC::DataCopyPadExtParams<float>{false, 0, 0, 0});
                AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
                AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

                if (pendMte3V) {
                    AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID2);
                    pendMte3V = false;
                }

                AscendC::Cast(z, acc, AscendC::RoundMode::CAST_RINT, cnt);
                AscendC::PipeBarrier<PIPE_V>();

                if (pitchUb == BN) {
                    for (int32_t col = 0; col < BN; col += 64) {
                        const int32_t vlen = (BN - col) < 64 ? (BN - col) : 64;
                        AscendC::Mul(z[col], z[col], sc[col], uint64_t(vlen),
                                     static_cast<uint8_t>(rThis),
                                     AscendC::BinaryRepeatParams{1, 1, 1, BN / 8, BN / 8, 0});
                    }
                } else {
                    for (int32_t col = 0; col < pitchUb; col += 64) {
                        const int32_t vlen = (pitchUb - col) < 64 ? (pitchUb - col) : 64;
                        AscendC::Mul(z[col], z[col], sc[col], uint64_t(vlen),
                                     static_cast<uint8_t>(rThis),
                                     AscendC::BinaryRepeatParams{
                                         1, 1, 1, static_cast<uint8_t>(pitchUb / 8),
                                         static_cast<uint8_t>(pitchUb / 8), 0});
                    }
                }
                AscendC::PipeBarrier<PIPE_V>();

                AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID1);
                pendVMte2 = true;

                AscendC::Mul (t, z, z, cnt);
                AscendC::Muls(t, t, kGeluC044, cnt);
                AscendC::Adds(t, t, kGeluC, cnt);
                AscendC::Mul (t, t, z, cnt);
                AscendC::Exp (t, t, cnt);
                AscendC::Adds(t, t, 1.0f, cnt);
                AscendC::Div (t, z, t, cnt);
                AscendC::Cast(h, t, AscendC::RoundMode::CAST_RINT, cnt);

                AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
                AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);

                const bool kFlatOut = (GMG_FLATCOPY != 0)
                                   && (static_cast<int64_t>(cols) == N_)
                                   && (pitchUb == cols);
                const uint16_t kOutCnt  = kFlatOut ? static_cast<uint16_t>(1)
                                                   : static_cast<uint16_t>(rThis);
                const uint32_t kOutLen  = kFlatOut
                    ? static_cast<uint32_t>(rThis) * static_cast<uint32_t>(cols) * 2u
                    : static_cast<uint32_t>(cols * 2);
                const uint32_t kOutSrcS = kFlatOut ? 0u
                    : static_cast<uint32_t>((pitchUb - (cols + 15) / 16 * 16) / 16);
                const uint32_t kOutDstS = kFlatOut ? 0u
                                                   : static_cast<uint32_t>((N_ - cols) * 2);
                AscendC::DataCopyExtParams co{kOutCnt, kOutLen, kOutSrcS, kOutDstS, 0};
                AscendC::DataCopyPad(yGm_[(rowBegin + (myFirst + coff)) * N_ + nBegin], h, co);
                AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID2);
                pendMte3V = true;
            }

            AscendC::CrossCoreSetFlag<2, PIPE_MTE2>(slotA ? kFlagSlotFree0 : kFlagSlotFree1);
        }

        if (pendVMte2) { AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID1); }
        if (pendMte3V) { AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID2); }
    }

    AscendC::GlobalTensor<int8_t>  xGm_, wGm_;
    AscendC::GlobalTensor<float>   sGm_;
    AscendC::GlobalTensor<int64_t> gGm_;
    AscendC::GlobalTensor<half>    yGm_;
    AscendC::GlobalTensor<int32_t> accGm_;
    AscendC::GlobalTensor<int32_t> pubGm_;

    AscendC::GlobalTensor<int32_t> gGm32_;
    AscendC::LocalTensor<int32_t>  gUb32_;
    bool gInUb_ = false;
    int64_t M_ = 0, K_ = 0, N_ = 0, E_ = 0;
    int64_t tilesN_ = 1;
    int64_t kPadK_ = 0;
    bool    aOk_ = false;
    bool    wPadded_ = false;
    int32_t tileN_ = BN;
    int64_t coreIdx_ = 0, coreNum_ = 1;
    int64_t taskBegin_ = 0, taskEnd_ = 0;
};

template <int32_t BM, int32_t BN, int32_t BK, int32_t SLOTS>
class KernelGmgResident {
public:
    __aicore__ inline KernelGmgResident() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groupList,
                                GM_ADDR y, GM_ADDR workspace,
                                int64_t M, int64_t K, int64_t N, int64_t E)
    {
        M_ = M; K_ = K; N_ = N; E_ = E;
        xGm_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
        wGm_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(weight));
#if GMG_BYPASS_W
        wGm_.SetL2CacheHint<AscendC::CacheRwMode::READ>(AscendC::CacheMode::CACHE_MODE_DISABLE);
#endif
#if GMG_BYPASS_X
        xGm_.SetL2CacheHint<AscendC::CacheRwMode::READ>(AscendC::CacheMode::CACHE_MODE_DISABLE);
#endif
        sGm_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scale));
        gGm_.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groupList));
        gGm32_.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(groupList));
        yGm_.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y));
#if GMG_BYPASS_Y
        yGm_.SetL2CacheHint<AscendC::CacheRwMode::WRITE>(AscendC::CacheMode::CACHE_MODE_DISABLE);
#endif
        pubGm_.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(workspace));
        accGm_.SetGlobalBuffer(
            reinterpret_cast<__gm__ int32_t*>(workspace) + kPubAreaElems);

        tilesN_ = CeilDiv(N, BN);
        kPadFull_ = AlignUp(K, 32);
        int64_t coreIdx = AscendC::GetBlockIdx();
        if ASCEND_IS_AIV { coreIdx = coreIdx / 2; }
        coreIdx_ = coreIdx;
        coreNum_ = AscendC::GetBlockNum();

        const int64_t total = E_ * tilesN_;
        taskBegin_ = total * coreIdx_ / coreNum_;
        taskEnd_   = total * (coreIdx_ + 1) / coreNum_;
    }

    __aicore__ inline void Process()
    {
        if ASCEND_IS_AIC { CubeProcess(); }
        if ASCEND_IS_AIV { VectorProcess(); }
    }

private:
    __aicore__ inline void Decode(int64_t task, int64_t& e, int64_t& nBegin, int32_t& cols,
                                  int64_t& firstRow, int64_t& rowsE)
    {
        e = task / tilesN_;
        const int64_t nt = task % tilesN_;
        nBegin = nt * BN;
        const int64_t c = N_ - nBegin;
        cols = static_cast<int32_t>(c < BN ? c : BN);
        const int64_t end = static_cast<int64_t>(gGm_.GetValue(e));
        firstRow = (e == 0) ? 0 : static_cast<int64_t>(gGm_.GetValue(e - 1));
        rowsE = end - firstRow;
    }

    __aicore__ inline void CubeProcess()
    {
        AscendC::TPipe pipe;
        AscendC::TBuf<AscendC::TPosition::B1> b1Buf;
        AscendC::TQue<AscendC::QuePosition::A1, 2> aQue;
        AscendC::TBuf<AscendC::TPosition::A2> a2Buf;
        AscendC::TBuf<AscendC::TPosition::B2> b2Buf;
        AscendC::TBuf<AscendC::TPosition::CO1> cBuf;
        pipe.InitBuffer(b1Buf, static_cast<uint32_t>(kPadFull_ * BN));
        pipe.InitBuffer(aQue, 2, static_cast<uint32_t>(BM * kPadFull_));
        pipe.InitBuffer(a2Buf, 2 * BM * BK);
        pipe.InitBuffer(b2Buf, 2 * BK * BN);
        pipe.InitBuffer(cBuf, BM * BN * sizeof(int32_t));
        auto b1 = b1Buf.Get<int8_t>();
        auto a2 = a2Buf.Get<int8_t>();
        auto b2 = b2Buf.Get<int8_t>();
        auto c0 = cBuf.Get<int32_t>();

        AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(4);
        AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(5);
        AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(6);
        AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(7);

        const int64_t slotElems = int64_t(BM) * BN;
        const int64_t wsBase    = coreIdx_ * SLOTS * slotElems;
        uint32_t seq = 0;
        bool bLoadedOnce = false;

        for (int64_t task = taskBegin_; task < taskEnd_; ++task) {
            int64_t e, nBegin, firstRow, rowsE; int32_t cols;
            Decode(task, e, nBegin, cols, firstRow, rowsE);
            if (rowsE <= 0) { continue; }

            if (bLoadedOnce) {
                AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID3);
            }

            AscendC::Fill(b1.template ReinterpretCast<uint32_t>(),
                AscendC::InitConstValueParams<uint32_t>{1,
                    static_cast<uint16_t>(uint32_t(BN) * uint32_t(kPadFull_) / 32), 0, 0U});
            AscendC::PipeBarrier<PIPE_MTE2>();
            AscendC::Nd2NzParams pb;
            pb.ndNum = 1;
            pb.nValue = static_cast<uint16_t>(K_);
            pb.dValue = static_cast<uint16_t>(cols);
            pb.srcDValue = static_cast<uint16_t>(N_);
            pb.dstNzC0Stride = static_cast<uint16_t>(kPadFull_);
            pb.dstNzNStride = 1;
            AscendC::DataCopy(b1, wGm_[e * K_ * N_ + nBegin], pb);
            AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(EVENT_ID2);
            AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(EVENT_ID2);
            bLoadedOnce = true;

            const int64_t nBlocks = CeilDiv(rowsE, BM);

            int64_t gi = 0;
            if (nBlocks > 0) { IssueA(aQue, firstRow, rowsE, 0); gi = 1; }

            for (int64_t rb = 0; rb < nBlocks; ++rb) {
                if (gi < nBlocks) { IssueA(aQue, firstRow, rowsE, gi); ++gi; }
                auto a1 = aQue.template DeQue<int8_t>();
                const int64_t r = rowsE - rb * BM;
                const int32_t rows = static_cast<int32_t>(r < BM ? r : BM);
                const uint16_t mPad = static_cast<uint16_t>(AlignUp(rows, 16));

                int32_t kStep = 0;
                for (int64_t kOff = 0; kOff < K_; kOff += BK) {
                    const int32_t kLen = static_cast<int32_t>(
                        (K_ - kOff < BK) ? (K_ - kOff) : BK);
                    const uint16_t kPad = static_cast<uint16_t>(AlignUp(kLen, 32));
                    const uint32_t slot = static_cast<uint32_t>(kStep & 1);
                    const uint32_t aOff = slot * BM * BK;
                    const uint32_t bOff = slot * BK * BN;

                    AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(
                        static_cast<uint16_t>(4 + slot));
                    AscendC::LoadData2dParams la;
                    la.repeatTimes = static_cast<uint8_t>(kPad / 32);
                    la.srcStride   = static_cast<uint16_t>(mPad / 16);
                    la.ifTranspose = false;
                    for (uint32_t mb = 0; mb < uint32_t(mPad) / 16; ++mb) {
                        AscendC::LoadData(a2[aOff + mb * uint32_t(kPad) * 16],
                            a1[(kOff / 32) * int64_t(mPad) * 32 + mb * 512], la);
                    }
                    AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(
                        static_cast<uint16_t>(6 + slot));
                    AscendC::LoadData2dTransposeParams lb{
                        0, static_cast<uint8_t>(BN / 32),
                        static_cast<uint16_t>(kPadFull_ / 32), 1, 0, 0};
                    for (uint32_t kb = 0; kb < uint32_t(kPad) / 32; ++kb) {
                        AscendC::LoadDataWithTranspose(b2[bOff + kb * uint32_t(BN) * 32],
                            b1[(kOff / 32 + kb) * 1024], lb);
                    }
                    AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID0);
                    AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID0);
                    if (kStep == 0 && seq > 0) {
                        AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(EVENT_ID1);
                    }
                    AscendC::MmadParams mad{mPad, static_cast<uint16_t>(BN), kPad,
                                            0, false, kStep == 0};
                    AscendC::Mmad(c0, a2[aOff], b2[bOff], mad);
                    AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(
                        static_cast<uint16_t>(4 + slot));
                    AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(
                        static_cast<uint16_t>(6 + slot));
                    ++kStep;
                }
                aQue.FreeTensor(a1);

                const bool slotA = (seq & 1u) == 0;
                if (seq >= SLOTS) {
                    AscendC::CrossCoreWaitFlag<2, PIPE_FIX>(
                        slotA ? kFlagSlotFree0 : kFlagSlotFree1);
                }
                AscendC::SetFlag<AscendC::HardEvent::M_FIX>(EVENT_ID0);
                AscendC::WaitFlag<AscendC::HardEvent::M_FIX>(EVENT_ID0);
                AscendC::FixpipeParamsV220 fx;
                fx.nSize = static_cast<uint16_t>(cols);
                fx.mSize = static_cast<uint16_t>(rows);
                fx.srcStride = mPad;
                fx.dstStride = static_cast<uint32_t>(BN);
                AscendC::Fixpipe(accGm_[wsBase + (slotA ? 0 : slotElems)], c0, fx);
                AscendC::SetFlag<AscendC::HardEvent::FIX_M>(EVENT_ID1);
                AscendC::CrossCoreSetFlag<2, PIPE_FIX>(
                    slotA ? kFlagCubeDone0 : kFlagCubeDone1);
                ++seq;
            }

            AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID3);
        }

        if (bLoadedOnce) { AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(EVENT_ID3); }
        if (seq > 0) { AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(EVENT_ID1); }
        AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(4);
        AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(5);
        AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(6);
        AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(7);
    }

    template <typename AQ>
    __aicore__ inline void IssueA(AQ& aQue, int64_t firstRow, int64_t rowsE, int64_t rb)
    {
        const int64_t r = rowsE - rb * BM;
        const int32_t rows = static_cast<int32_t>(r < BM ? r : BM);
        const uint16_t mPad = static_cast<uint16_t>(AlignUp(rows, 16));
        auto a1 = aQue.template AllocTensor<int8_t>();
        if (rows != mPad || K_ != kPadFull_) {
            AscendC::Fill(a1.template ReinterpretCast<uint32_t>(),
                AscendC::InitConstValueParams<uint32_t>{1,
                    static_cast<uint16_t>(uint32_t(mPad) * uint32_t(kPadFull_) / 32), 0, 0U});
            AscendC::PipeBarrier<PIPE_MTE2>();
        }
        AscendC::Nd2NzParams pa;
        pa.ndNum = 1;
        pa.nValue = static_cast<uint16_t>(rows);
        pa.dValue = static_cast<uint16_t>(K_);
        pa.srcDValue = static_cast<uint16_t>(K_);
        pa.dstNzC0Stride = mPad;
        pa.dstNzNStride = 1;
        AscendC::DataCopy(a1, xGm_[(firstRow + rb * BM) * K_], pa);
        aQue.EnQue(a1);
    }

    __aicore__ inline void VectorProcess()
    {
        constexpr int32_t kVecRows = BM / 2;
        constexpr int32_t kVecCnt  = kVecRows * BN;
        AscendC::TPipe pipe;
        AscendC::TBuf<AscendC::TPosition::VECCALC> accBuf, zBuf, tBuf, hBuf, sBuf;
        pipe.InitBuffer(accBuf, kVecCnt * sizeof(int32_t));
        pipe.InitBuffer(zBuf,   kVecCnt * sizeof(float));
        pipe.InitBuffer(tBuf,   kVecCnt * sizeof(float));
        pipe.InitBuffer(hBuf,   kVecCnt * sizeof(half));
        pipe.InitBuffer(sBuf,   BN * sizeof(float));
        auto acc = accBuf.Get<int32_t>();
        auto z   = zBuf.Get<float>();
        auto t   = tBuf.Get<float>();
        auto h   = hBuf.Get<half>();
        auto sc  = sBuf.Get<float>();

        bool pendMte3V = false, pendVMte2 = false;
        const int64_t sub       = AscendC::GetSubBlockIdx();
        const int64_t slotElems = int64_t(BM) * BN;
        const int64_t wsBase    = coreIdx_ * SLOTS * slotElems;
        uint32_t seq = 0;

        for (int64_t task = taskBegin_; task < taskEnd_; ++task) {
            int64_t e, nBegin, firstRow, rowsE; int32_t cols;
            Decode(task, e, nBegin, cols, firstRow, rowsE);
            if (rowsE <= 0) { continue; }
            const int64_t nBlocks = CeilDiv(rowsE, BM);

            for (int64_t rb = 0; rb < nBlocks; ++rb) {
                const int64_t r = rowsE - rb * BM;
                const int32_t rows = static_cast<int32_t>(r < BM ? r : BM);
                const bool slotA = (seq & 1u) == 0;
                AscendC::CrossCoreWaitFlag<2, PIPE_MTE2>(
                    slotA ? kFlagCubeDone0 : kFlagCubeDone1);
                ++seq;

                const int32_t myFirst = static_cast<int32_t>(sub) * kVecRows;
                const int32_t myRows  = (rows - myFirst) <= 0 ? 0
                                      : ((rows - myFirst) < kVecRows
                                         ? (rows - myFirst) : kVecRows);
                if (myRows > 0) {
                    const int64_t src = wsBase + (slotA ? 0 : slotElems)
                                      + int64_t(myFirst) * BN;

                    const int32_t  pitchUb = (cols + 15) / 16 * 16;
                    const uint32_t cnt = (pitchUb == BN)
                        ? static_cast<uint32_t>(myRows) * static_cast<uint32_t>(BN)
                        : static_cast<uint32_t>(myRows) * static_cast<uint32_t>(pitchUb);
                    if (pendVMte2) {
                        AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID1);
                        pendVMte2 = false;
                    }

                    const bool kFlatIn = (GMG_FLATCOPY != 0) && (cols == BN)
                                      && (pitchUb == BN);
                    const uint16_t kInCnt  = kFlatIn ? static_cast<uint16_t>(1)
                                                     : static_cast<uint16_t>(myRows);
                    const uint32_t kInLen  = kFlatIn
                        ? static_cast<uint32_t>(myRows) * static_cast<uint32_t>(BN) * 4u
                        : static_cast<uint32_t>(cols * 4);
                    const uint32_t kInSrcS = kFlatIn ? 0u
                                                     : static_cast<uint32_t>((BN - cols) * 4);
                    const uint32_t kInDstS = kFlatIn ? 0u
                        : static_cast<uint32_t>((pitchUb - (cols + 7) / 8 * 8) / 8);
                    AscendC::DataCopyExtParams ci{kInCnt, kInLen, kInSrcS, kInDstS, 0};
                    AscendC::DataCopyPad(acc, accGm_[src], ci,
                        AscendC::DataCopyPadExtParams<int32_t>{false, 0, 0, 0});
                    AscendC::DataCopyExtParams cs{1, static_cast<uint32_t>(cols * 4), 0, 0, 0};
                    AscendC::DataCopyPad(sc, sGm_[e * N_ + nBegin], cs,
                        AscendC::DataCopyPadExtParams<float>{false, 0, 0, 0});
                    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
                    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
                    if (pendMte3V) {
                        AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID2);
                        pendMte3V = false;
                    }
                    AscendC::Cast(z, acc, AscendC::RoundMode::CAST_RINT, cnt);
                    AscendC::PipeBarrier<PIPE_V>();
                    if (pitchUb == BN) {
                        for (int32_t col = 0; col < BN; col += 64) {
                            const int32_t vlen = (BN - col) < 64 ? (BN - col) : 64;
                            AscendC::Mul(z[col], z[col], sc[col], uint64_t(vlen),
                                         static_cast<uint8_t>(myRows),
                                         AscendC::BinaryRepeatParams{1, 1, 1, BN / 8, BN / 8, 0});
                        }
                    } else {
                        for (int32_t col = 0; col < pitchUb; col += 64) {
                            const int32_t vlen = (pitchUb - col) < 64 ? (pitchUb - col) : 64;
                            AscendC::Mul(z[col], z[col], sc[col], uint64_t(vlen),
                                         static_cast<uint8_t>(myRows),
                                         AscendC::BinaryRepeatParams{
                                             1, 1, 1, static_cast<uint8_t>(pitchUb / 8),
                                             static_cast<uint8_t>(pitchUb / 8), 0});
                        }
                    }
                    AscendC::PipeBarrier<PIPE_V>();
                    AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID1);
                    pendVMte2 = true;
                    AscendC::Mul (t, z, z, cnt);
                    AscendC::Muls(t, t, kGeluC044, cnt);
                    AscendC::Adds(t, t, kGeluC, cnt);
                    AscendC::Mul (t, t, z, cnt);
                    AscendC::Exp (t, t, cnt);
                    AscendC::Adds(t, t, 1.0f, cnt);
                    AscendC::Div (t, z, t, cnt);
                    AscendC::Cast(h, t, AscendC::RoundMode::CAST_RINT, cnt);
                    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
                    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);

                    const bool kFlatOut = (GMG_FLATCOPY != 0)
                                       && (static_cast<int64_t>(cols) == N_)
                                       && (pitchUb == cols);
                    const uint16_t kOutCnt  = kFlatOut ? static_cast<uint16_t>(1)
                                                       : static_cast<uint16_t>(myRows);
                    const uint32_t kOutLen  = kFlatOut
                        ? static_cast<uint32_t>(myRows) * static_cast<uint32_t>(cols) * 2u
                        : static_cast<uint32_t>(cols * 2);
                    const uint32_t kOutSrcS = kFlatOut ? 0u
                        : static_cast<uint32_t>((pitchUb - (cols + 15) / 16 * 16) / 16);
                    const uint32_t kOutDstS = kFlatOut ? 0u
                                                       : static_cast<uint32_t>((N_ - cols) * 2);
                    AscendC::DataCopyExtParams co{kOutCnt, kOutLen, kOutSrcS, kOutDstS, 0};
                    AscendC::DataCopyPad(
                        yGm_[(firstRow + rb * BM + myFirst) * N_ + nBegin], h, co);
                    AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID2);
                    pendMte3V = true;
                }
                AscendC::CrossCoreSetFlag<2, PIPE_MTE2>(
                    slotA ? kFlagSlotFree0 : kFlagSlotFree1);
            }
        }
        if (pendVMte2) { AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID1); }
        if (pendMte3V) { AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID2); }
    }

    AscendC::GlobalTensor<int8_t>  xGm_, wGm_;
    AscendC::GlobalTensor<float>   sGm_;
    AscendC::GlobalTensor<int64_t> gGm_;
    AscendC::GlobalTensor<int32_t> gGm32_;
    AscendC::GlobalTensor<half>    yGm_;
    AscendC::GlobalTensor<int32_t> accGm_;
    AscendC::GlobalTensor<int32_t> pubGm_;
    int64_t M_ = 0, K_ = 0, N_ = 0, E_ = 0;
    int64_t tilesN_ = 1, kPadFull_ = 0;
    int64_t coreIdx_ = 0, coreNum_ = 1, taskBegin_ = 0, taskEnd_ = 0;
};

template <int32_t BM, int32_t BN, int32_t BK, int32_t BKL1, int32_t SLOTS,
          int64_t ARESB = kAResBytes>
__global__ __aicore__ void GmgAresKernel(
    GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groupList,
    GM_ADDR y, GM_ADDR workspace, int64_t mkPack, int64_t nePack)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);

    const int64_t M = static_cast<int64_t>(static_cast<uint64_t>(mkPack) >> 32);
    const int64_t K = static_cast<int64_t>(static_cast<uint32_t>(mkPack));
    const int64_t N = static_cast<int64_t>(static_cast<uint64_t>(nePack) >> 32);
    const int64_t E = static_cast<int64_t>(static_cast<uint32_t>(nePack));

    const bool wPadded = ((static_cast<uint32_t>(nePack) >> 31) & 1u) != 0u;
    const int64_t Em = E & 0x7FFFFFFFLL;
    KernelGmgAres<BM, BN, BK, BKL1, SLOTS, ARESB> op;
    op.Init(x, weight, scale, groupList, y, workspace, M, K, N, Em, wPadded);
    op.Process();
}

template <int32_t BM, int32_t BN, int32_t BK, int32_t SLOTS>
__global__ __aicore__ void GmgResidentKernel(
    GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groupList,
    GM_ADDR y, GM_ADDR workspace, int64_t mkPack, int64_t nePack)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);

    const int64_t M = static_cast<int64_t>(static_cast<uint64_t>(mkPack) >> 32);
    const int64_t K = static_cast<int64_t>(static_cast<uint32_t>(mkPack));
    const int64_t N = static_cast<int64_t>(static_cast<uint64_t>(nePack) >> 32);
    const int64_t E = static_cast<int64_t>(static_cast<uint32_t>(nePack));
    KernelGmgResident<BM, BN, BK, SLOTS> op;
    op.Init(x, weight, scale, groupList, y, workspace, M, K, N, E);
    op.Process();
}

constexpr int32_t kSkK2Max = 8192;
constexpr int32_t kSkRB    = 16;

__aicore__ inline int32_t SkNextPow2(int32_t v)
{
    int32_t p = 1;
    while (p < v) { p <<= 1; }
    return p;
}

__global__ __aicore__ void GmgGemvKernel(
    GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groupList, GM_ADDR y,
    int64_t mkPack, int64_t nePack)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    const int64_t M = static_cast<int64_t>(static_cast<uint64_t>(mkPack) >> 32);
    const int64_t K = static_cast<int64_t>(static_cast<uint32_t>(mkPack));
    const int64_t N = static_cast<int64_t>(static_cast<uint64_t>(nePack) >> 32);
    const int64_t E = static_cast<int64_t>(static_cast<uint32_t>(nePack));
    (void)N;

    AscendC::GlobalTensor<int8_t>  xGm, wGm;
    AscendC::GlobalTensor<float>   sGm;
    AscendC::GlobalTensor<int64_t> gGm;
    AscendC::GlobalTensor<half>    yGm;
    xGm.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
    wGm.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(weight));
    sGm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scale));
    gGm.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groupList));
    yGm.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y));

    const int32_t kp2    = SkNextPow2(static_cast<int32_t>(K));
    const int32_t alignK = static_cast<int32_t>(AlignUp(K, 32));

    int32_t rb = 49152 / alignK;
    if (rb < 1)      { rb = 1; }
    if (rb > kSkRB)  { rb = kSkRB; }

    AscendC::TPipe pipe;
    AscendC::TBuf<AscendC::TPosition::VECCALC> xiBuf, xi2Buf, wiBuf, xhBuf, xfBuf, wfBuf, pBuf, pbBuf, aBuf, a8Buf, tBuf, hBuf;
    pipe.InitBuffer(xiBuf, static_cast<uint32_t>(rb * alignK));

    pipe.InitBuffer(xi2Buf, static_cast<uint32_t>(rb * alignK));

    pipe.InitBuffer(pbBuf, static_cast<uint32_t>(kp2 * 4 + 32));
    pipe.InitBuffer(wiBuf, static_cast<uint32_t>(alignK));
    pipe.InitBuffer(xhBuf, static_cast<uint32_t>(kp2 * 2));
    pipe.InitBuffer(xfBuf, static_cast<uint32_t>(kp2 * 4));
    pipe.InitBuffer(wfBuf, static_cast<uint32_t>(kp2 * 4));
    pipe.InitBuffer(pBuf,  static_cast<uint32_t>(kp2 * 4));
    pipe.InitBuffer(aBuf,  static_cast<uint32_t>(kSkRB * 4));

    pipe.InitBuffer(a8Buf, static_cast<uint32_t>(128 * 4));
    pipe.InitBuffer(tBuf,  static_cast<uint32_t>(kSkRB * 4));
    pipe.InitBuffer(hBuf,  static_cast<uint32_t>(kSkRB * 2 + 32));
    auto xiA = xiBuf.Get<int8_t>();
    auto xiB = xi2Buf.Get<int8_t>();
    auto prB = pbBuf.Get<float>()[8];
    auto wi = wiBuf.Get<int8_t>();
    auto xh = xhBuf.Get<half>();
    auto xf = xfBuf.Get<float>();
    auto wf = wfBuf.Get<float>();
    auto pr = pBuf.Get<float>();
    auto ac = aBuf.Get<float>();
    auto a8 = a8Buf.Get<float>();
    auto tt = tBuf.Get<float>();
    auto hh = hBuf.Get<half>();

    AscendC::Duplicate(xf, 0.0f, kp2);
    AscendC::Duplicate(wf, 0.0f, kp2);

    AscendC::Duplicate(a8, 0.0f, 128);
    AscendC::PipeBarrier<PIPE_V>();

    const int64_t cores = AscendC::GetBlockNum();
    const int64_t me    = AscendC::GetBlockIdx();
    const int64_t myLo  = M * me / cores;
    const int64_t myHi  = M * (me + 1) / cores;
    if (myLo >= myHi) { return; }

    int64_t rowStart = 0;
    for (int64_t e = 0; e < E; ++e) {
        const int64_t rowEnd = static_cast<int64_t>(gGm.GetValue(e));
        const int64_t lo = rowStart > myLo ? rowStart : myLo;
        const int64_t hi = rowEnd   < myHi ? rowEnd   : myHi;
        rowStart = rowEnd;
        if (lo >= hi) { continue; }

        AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID2);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID2);
        AscendC::DataCopyExtParams wc{1, static_cast<uint32_t>(K), 0, 0, 0};
        AscendC::DataCopyPad(wi, wGm[e * K], wc,
            AscendC::DataCopyPadExtParams<int8_t>{false, 0, 0, 0});
        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

        AscendC::Cast(xh, wi, AscendC::RoundMode::CAST_NONE, static_cast<int32_t>(K));
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Cast(wf, xh, AscendC::RoundMode::CAST_NONE, static_cast<int32_t>(K));
        const float sc = sGm.GetValue(e);
        AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);

        bool firstIssued = false;
        for (int64_t r0 = lo; r0 < hi; r0 += rb) {
            const int32_t nr = static_cast<int32_t>((hi - r0) < rb ? (hi - r0) : rb);
            const bool useA = (((r0 - lo) / rb) & 1) == 0;
            auto xi = useA ? xiA : xiB;

            if (!firstIssued) {
                AscendC::DataCopyExtParams xc0{static_cast<uint16_t>(nr),
                    static_cast<uint32_t>(K), 0, 0, 0};
                AscendC::DataCopyPad(xi, xGm[r0 * K], xc0,
                    AscendC::DataCopyPadExtParams<int8_t>{false, 0, 0, 0});
                AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(useA ? EVENT_ID0 : EVENT_ID3);
                firstIssued = true;
            }

            const int64_t rNext = r0 + rb;
            if (rNext < hi) {
                const int32_t nrN = static_cast<int32_t>((hi - rNext) < rb ? (hi - rNext) : rb);
                auto xiN = useA ? xiB : xiA;
                AscendC::DataCopyExtParams xcN{static_cast<uint16_t>(nrN),
                    static_cast<uint32_t>(K), 0, 0, 0};
                AscendC::DataCopyPad(xiN, xGm[rNext * K], xcN,
                    AscendC::DataCopyPadExtParams<int8_t>{false, 0, 0, 0});
                AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(useA ? EVENT_ID3 : EVENT_ID0);
            }
            AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(useA ? EVENT_ID0 : EVENT_ID3);

            for (int32_t r = 0; r < nr; ++r) {
                AscendC::Cast(xh, xi[static_cast<int64_t>(r) * alignK],
                              AscendC::RoundMode::CAST_NONE, static_cast<int32_t>(K));
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::Cast(xf, xh, AscendC::RoundMode::CAST_NONE, static_cast<int32_t>(K));
                AscendC::Mul(pr, xf, wf, kp2);

                bool toB = true;
                int32_t lvl = kp2 >> 1;
                AscendC::Add(prB, pr, pr[lvl], lvl);
                for (lvl >>= 1; lvl >= 8; lvl >>= 1) {
                    if (toB) { AscendC::Add(pr, prB, prB[lvl], lvl); }
                    else     { AscendC::Add(prB, pr, pr[lvl], lvl); }
                    toB = !toB;
                }

                AscendC::Adds(a8[r * 8], toB ? prB : pr, 0.0f, 8);
            }

            AscendC::PipeBarrier<PIPE_V>();
            AscendC::BlockReduceSum<float>(ac, a8, (nr * 8 + 63) / 64,
                                           64, 1, 1, 8);
            AscendC::PipeBarrier<PIPE_V>();

            AscendC::Muls(ac, ac, sc, nr);
            AscendC::Mul (tt, ac, ac, nr);
            AscendC::Muls(tt, tt, kGeluC044, nr);
            AscendC::Adds(tt, tt, kGeluC, nr);
            AscendC::Mul (tt, tt, ac, nr);
            AscendC::Exp (tt, tt, nr);
            AscendC::Adds(tt, tt, 1.0f, nr);
            AscendC::Div (tt, ac, tt, nr);
            AscendC::Cast(hh, tt, AscendC::RoundMode::CAST_RINT, nr);
            AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
            AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
            AscendC::DataCopyExtParams yc{1, static_cast<uint32_t>(nr * 2), 0, 0, 0};
            AscendC::DataCopyPad(yGm[r0], hh, yc);
            AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
            AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
        }
    }
}

__global__ __aicore__ void GmgOuterKernel(
    GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groupList, GM_ADDR y,
    int64_t mkPack, int64_t nePack)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    const int64_t M = static_cast<int64_t>(static_cast<uint64_t>(mkPack) >> 32);
    const int64_t K = static_cast<int64_t>(static_cast<uint32_t>(mkPack));
    const int64_t N = static_cast<int64_t>(static_cast<uint64_t>(nePack) >> 32);
    const int64_t E = static_cast<int64_t>(static_cast<uint32_t>(nePack));
    (void)K;

    AscendC::GlobalTensor<int8_t>  xGm, wGm;
    AscendC::GlobalTensor<float>   sGm;
    AscendC::GlobalTensor<int64_t> gGm;
    AscendC::GlobalTensor<half>    yGm;
    xGm.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
    wGm.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(weight));
    sGm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scale));
    gGm.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groupList));
    yGm.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y));

    const int32_t nAl = static_cast<int32_t>(AlignUp(N, 64));

    const int32_t yPitch = static_cast<int32_t>(AlignUp(N * 2, 32));
    int32_t kOutR = 98304 / yPitch;
    if (kOutR < 1)  { kOutR = 1; }
    if (kOutR > 16) { kOutR = 16; }

    AscendC::TPipe pipe;
    AscendC::TBuf<AscendC::TPosition::VECCALC> wiBuf, whBuf, vBuf, v2Buf, zBuf, tBuf, hBuf, sfBuf;
    pipe.InitBuffer(wiBuf, static_cast<uint32_t>(AlignUp(N, 32)));
    pipe.InitBuffer(whBuf, static_cast<uint32_t>(nAl * 2));
    pipe.InitBuffer(vBuf,  static_cast<uint32_t>(nAl * 4));
    pipe.InitBuffer(v2Buf, static_cast<uint32_t>(nAl * 4));
    pipe.InitBuffer(zBuf,  static_cast<uint32_t>(nAl * 4));
    pipe.InitBuffer(tBuf,  static_cast<uint32_t>(nAl * 4));

    pipe.InitBuffer(hBuf,  static_cast<uint32_t>(kOutR * yPitch + 32));
    pipe.InitBuffer(sfBuf, static_cast<uint32_t>(nAl * 4));
    auto wi = wiBuf.Get<int8_t>();
    auto wh = whBuf.Get<half>();
    auto vv = vBuf.Get<float>();
    auto v2 = v2Buf.Get<float>();
    auto zz = zBuf.Get<float>();
    auto tt = tBuf.Get<float>();
    auto hh = hBuf.Get<half>();
    auto sf = sfBuf.Get<float>();

    const int64_t cores = AscendC::GetBlockNum();
    const int64_t me    = AscendC::GetBlockIdx();
    const int64_t myLo  = M * me / cores;
    const int64_t myHi  = M * (me + 1) / cores;
    if (myLo >= myHi) { return; }

    int64_t rowStart = 0;
    for (int64_t e = 0; e < E; ++e) {
        const int64_t rowEnd = static_cast<int64_t>(gGm.GetValue(e));
        const int64_t lo = rowStart > myLo ? rowStart : myLo;
        const int64_t hi = rowEnd   < myHi ? rowEnd   : myHi;
        rowStart = rowEnd;
        if (lo >= hi) { continue; }

        AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID2);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID2);
        AscendC::DataCopyExtParams wc{1, static_cast<uint32_t>(N), 0, 0, 0};
        AscendC::DataCopyPad(wi, wGm[e * N], wc,
            AscendC::DataCopyPadExtParams<int8_t>{false, 0, 0, 0});
        AscendC::DataCopyExtParams sc2{1, static_cast<uint32_t>(N * 4), 0, 0, 0};
        AscendC::DataCopyPad(sf, sGm[e * N], sc2,
            AscendC::DataCopyPadExtParams<float>{false, 0, 0, 0});
        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

        AscendC::Cast(wh, wi, AscendC::RoundMode::CAST_NONE, static_cast<int32_t>(N));
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Cast(vv, wh, AscendC::RoundMode::CAST_NONE, static_cast<int32_t>(N));
        AscendC::Mul(vv, vv, sf, static_cast<int32_t>(N));

        AscendC::Mul(v2, vv, vv, static_cast<int32_t>(N));

        for (int64_t m0 = lo; m0 < hi; m0 += kOutR) {
            const int32_t nr = static_cast<int32_t>((hi - m0) < kOutR
                                                    ? (hi - m0) : kOutR);
            for (int32_t rr = 0; rr < nr; ++rr) {
                const float xv = static_cast<float>(xGm.GetValue(m0 + rr));

                AscendC::Muls(zz, vv, xv, static_cast<int32_t>(N));
                AscendC::Muls(tt, v2, kGeluC044 * xv * xv, static_cast<int32_t>(N));
                AscendC::Adds(tt, tt, kGeluC, static_cast<int32_t>(N));
                AscendC::Mul (tt, tt, zz, static_cast<int32_t>(N));
                AscendC::Exp (tt, tt, static_cast<int32_t>(N));
                AscendC::Adds(tt, tt, 1.0f, static_cast<int32_t>(N));
                AscendC::Div (tt, zz, tt, static_cast<int32_t>(N));
                AscendC::Cast(hh[rr * (yPitch / 2)], tt,
                              AscendC::RoundMode::CAST_RINT, static_cast<int32_t>(N));
            }

            AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
            AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
            AscendC::DataCopyExtParams yc{static_cast<uint16_t>(nr),
                                          static_cast<uint32_t>(N * 2), 0, 0, 0};
            AscendC::DataCopyPad(yGm[m0 * N], hh, yc);
            AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
            AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
        }
    }
}

constexpr int32_t kPadWUbBytes = 147456;

__global__ __aicore__ void GmgPadWKernel(GM_ADDR weight, GM_ADDR wPad,
                                         int64_t mkPack, int64_t nePack, int64_t blkPack)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    const int64_t K = static_cast<int64_t>(static_cast<uint32_t>(mkPack));
    const int64_t N = static_cast<int64_t>(static_cast<uint64_t>(nePack) >> 32);
    const int64_t E = static_cast<int64_t>(static_cast<uint32_t>(nePack) & 0x7FFFFFFFu);

    const int64_t BN   = static_cast<int64_t>(static_cast<uint64_t>(blkPack) >> 32);
    const int64_t nBlk = static_cast<int64_t>(static_cast<uint32_t>(blkPack));
    if (K <= 0 || N <= 0 || E <= 0 || nBlk <= 0) { return; }
    if (BN <= 0 || (BN % 32) != 0) { return; }

    const int64_t tilesN = CeilDiv(N, BN);
    const int64_t nAl    = tilesN * BN;
    int64_t rowsPerChunk = static_cast<int64_t>(kPadWUbBytes) / nAl;
    if (rowsPerChunk < 1) { return; }
    if (rowsPerChunk > 4095) { rowsPerChunk = 4095; }
    if (rowsPerChunk > K) { rowsPerChunk = K; }
    const int64_t nChunks = CeilDiv(K, rowsPerChunk);
    const int64_t items   = E * nChunks;

    const int64_t idx     = AscendC::GetBlockIdx();
    const int64_t itBegin = items * idx / nBlk;
    const int64_t itEnd   = items * (idx + 1) / nBlk;
    if (itBegin >= itEnd) { return; }

    AscendC::GlobalTensor<int8_t> wGm, pGm;
    wGm.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(weight));
    pGm.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(wPad));

    AscendC::TPipe pipe;
    AscendC::TBuf<AscendC::TPosition::VECCALC> ubBuf;
    pipe.InitBuffer(ubBuf, kPadWUbBytes);
    auto ub = ubBuf.Get<int8_t>();

    AscendC::Duplicate(ub.template ReinterpretCast<float>(), 0.0f,
                       static_cast<int32_t>(kPadWUbBytes / 4));
    AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID1);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID1);

    const int64_t nAl32 = AlignUp(N, 32);
    const uint8_t rightPad = static_cast<uint8_t>(nAl32 - N);
    AscendC::DataCopyPadExtParams<int8_t> pp{true, 0, rightPad, static_cast<int8_t>(0)};

    for (int64_t it = itBegin; it < itEnd; ++it) {
        const int64_t e  = it / nChunks;
        const int64_t ch = it % nChunks;
        const int64_t k0 = ch * rowsPerChunk;
        const int64_t r  = (K - k0 < rowsPerChunk) ? (K - k0) : rowsPerChunk;

        AscendC::DataCopyExtParams cr{static_cast<uint16_t>(r),
                                      static_cast<uint32_t>(N), 0,
                                      static_cast<uint32_t>((nAl - nAl32) / 32), 0};
        AscendC::DataCopyPad(ub, wGm[(e * K + k0) * N], cr, pp);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE3>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE3>(EVENT_ID0);

        for (int64_t nt = 0; nt < tilesN; ++nt) {
            AscendC::DataCopyExtParams cw{static_cast<uint16_t>(r),
                                          static_cast<uint32_t>(BN),
                                          static_cast<uint32_t>((nAl - BN) / 32), 0, 0};
            AscendC::DataCopyPad(pGm[((e * tilesN + nt) * K + k0) * BN],
                                 ub[static_cast<int32_t>(nt * BN)], cw);
        }
        AscendC::SetFlag<AscendC::HardEvent::MTE3_MTE2>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE3_MTE2>(EVENT_ID0);
    }
}

__global__ __aicore__ void GmgTinyKernel(
    GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groupList, GM_ADDR y,
    int64_t mkPack, int64_t nePack)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);

    const int64_t M = static_cast<int64_t>(static_cast<uint64_t>(mkPack) >> 32);
    const int64_t K = static_cast<int64_t>(static_cast<uint32_t>(mkPack));
    const int64_t N = static_cast<int64_t>(static_cast<uint64_t>(nePack) >> 32);
    const int64_t E = static_cast<int64_t>(static_cast<uint32_t>(nePack));
    AscendC::GlobalTensor<int8_t>  xGm, wGm;
    AscendC::GlobalTensor<float>   sGm;
    AscendC::GlobalTensor<int64_t> gGm;
    AscendC::GlobalTensor<half>    yGm;
    xGm.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
    wGm.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(weight));
    sGm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scale));
    gGm.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groupList));
    yGm.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y));

    {
        AscendC::GlobalTensor<uint64_t> p64;
        p64.SetGlobalBuffer(reinterpret_cast<__gm__ uint64_t*>(x));
        for (int64_t o = 0; o < M * K; o += 64) {
            AscendC::DataCachePreload(p64, o);
        }
        p64.SetGlobalBuffer(reinterpret_cast<__gm__ uint64_t*>(weight));
        for (int64_t o = 0; o < E * K * N; o += 64) {
            AscendC::DataCachePreload(p64, o);
        }
        p64.SetGlobalBuffer(reinterpret_cast<__gm__ uint64_t*>(scale));
        for (int64_t o = 0; o < E * N * 4; o += 64) {
            AscendC::DataCachePreload(p64, o);
        }
        p64.SetGlobalBuffer(reinterpret_cast<__gm__ uint64_t*>(groupList));
        for (int64_t o = 0; o < E * 8; o += 64) {
            AscendC::DataCachePreload(p64, o);
        }
    }

    const int64_t pitch = GMG_TINY_PITCH(N);
    const int64_t rows  = (E > 0) ? static_cast<int64_t>(gGm.GetValue(E - 1)) : 0;
    if (rows <= 0) { return; }

    AscendC::LocalTensor<float> z(AscendC::TPosition::VECCALC, 0U, kTinyUbElems);
    AscendC::LocalTensor<float> t(AscendC::TPosition::VECCALC,
                                  kTinyUbElems * sizeof(float), kTinyUbElems);
    AscendC::LocalTensor<half>  h(AscendC::TPosition::VECCALC,
                                  kTinyUbElems * 2U * sizeof(float), kTinyUbElems);

    const int32_t cnt = static_cast<int32_t>((rows * pitch + 63) / 64 * 64);

    int64_t rowStart = 0;
    for (int64_t e = 0; e < E; ++e) {
        const int64_t rowEnd = static_cast<int64_t>(gGm.GetValue(e));
        for (int64_t row = rowStart; row < rowEnd; ++row) {

            int32_t xv[kTinyKMax];
            for (int64_t k = 0; k < K; ++k) {
                xv[k] = static_cast<int32_t>(xGm.GetValue(row * K + k));
            }
            for (int64_t col = 0; col < N; ++col) {
                int32_t acc = 0;
                for (int64_t k = 0; k < K; ++k) {
                    acc += xv[k] * static_cast<int32_t>(
                        wGm.GetValue(e * K * N + k * N + col));
                }
                z.SetValue(row * pitch + col,
                           static_cast<float>(acc) * sGm.GetValue(e * N + col));
            }
        }
        rowStart = rowEnd;
    }

    AscendC::SetFlag<AscendC::HardEvent::S_V>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::S_V>(EVENT_ID0);

    AscendC::Mul (t, z, z, cnt);
    AscendC::Muls(t, t, kGeluC044, cnt);
    AscendC::Adds(t, t, kGeluC, cnt);
    AscendC::Mul (t, t, z, cnt);
    AscendC::Exp (t, t, cnt);
    AscendC::Adds(t, t, 1.0f, cnt);
    AscendC::Div (t, z, t, cnt);
    AscendC::Cast(h, t, AscendC::RoundMode::CAST_RINT, cnt);

    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);

    AscendC::DataCopyExtParams co{static_cast<uint16_t>(rows),
                                  static_cast<uint32_t>(N * 2), 0, 0, 0};
    AscendC::DataCopyPad(yGm, h, co);

}

template <int32_t BM, int32_t BN, int32_t BK, int32_t BKL1, int32_t SLOTS>
__global__ __aicore__ void GroupedMatmulGeluKernel(
    GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groupList,
    GM_ADDR y, GM_ADDR workspace, int64_t mkPack, int64_t nePack)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);

    const int64_t M = static_cast<int64_t>(static_cast<uint64_t>(mkPack) >> 32);
    const int64_t K = static_cast<int64_t>(static_cast<uint32_t>(mkPack));
    const int64_t N = static_cast<int64_t>(static_cast<uint64_t>(nePack) >> 32);
    const int64_t E = static_cast<int64_t>(static_cast<uint32_t>(nePack));

    const bool wPaddedG = ((static_cast<uint32_t>(nePack) >> 31) & 1u) != 0u;
    const int64_t EmG = E & 0x7FFFFFFFLL;
    KernelGroupedMatmulGelu<BM, BN, BK, BKL1, SLOTS> op;
    op.Init(x, weight, scale, groupList, y, workspace, M, K, N, EmG, wPaddedG);
    op.Process();
}

}

#ifndef GMG_BM

#define GMG_BM 96
#endif
#ifndef GMG_BN
#define GMG_BN 256
#endif
#ifndef GMG_BK
#define GMG_BK 128
#endif
#ifndef GMG_BKL1
#define GMG_BKL1 512
#endif

static inline int64_t GmgAresBlockNum(int64_t tasks, int64_t cores)
{
    if (tasks < 1) { return 1; }
    if (cores < 1) { return 1; }
    if (tasks < cores) { return tasks; }
    const int64_t waves = (tasks + cores - 1) / cores;
    int64_t b = (tasks + waves - 1) / waves;

    const int64_t floorB = cores - 4;
    if (cores - b < 3) { return cores; }
    if (b < floorB) { b = floorB; }
    if (b < 1) { b = 1; }
    if (b > cores) { b = cores; }
    return b;
}

static inline int64_t GmgCheapWaveBlockNum(int64_t tasks, int64_t cores,
                                           int64_t taskBytes, int64_t b0)
{
    if (b0 != cores) { return b0; }
    if (tasks < 1 || cores < 2) { return b0; }
    const int64_t waves = (tasks + cores - 1) / cores;
    if (waves < 2) { return b0; }
    const int64_t b = (tasks + waves) / (waves + 1);
    if (b < 1) { return b0; }
    if (cores - b < 3) { return b0; }
    const double extraWave = 1.744e-6 * static_cast<double>(b)
                                      * static_cast<double>(taskBytes);
    const double saved     = 1.2 * static_cast<double>(cores - b);
    if (!(extraWave < saved)) { return b0; }
    return b;
}

extern "C" void run_kernel(
    GM_ADDR x, const TensorGroupInfo& info_x,
    GM_ADDR weight, const TensorGroupInfo& info_weight,
    GM_ADDR scale, const TensorGroupInfo& info_scale,
    GM_ADDR group_list, const TensorGroupInfo& info_group_list,
    GM_ADDR y, const TensorGroupInfo& info_y,
    int64_t availableCoreNum, aclrtStream stream)
{
    if (info_x.numTensors < 1 || info_weight.numTensors < 1 || info_scale.numTensors < 1 ||
        info_group_list.numTensors < 1 || info_y.numTensors < 1 || availableCoreNum <= 0) {
        return;
    }
    const int64_t M = info_x.tensors[0].shape[0];
    const int64_t K = info_x.tensors[0].shape[1];
    const int64_t E = info_weight.tensors[0].shape[0];
    const int64_t N = info_weight.tensors[0].shape[2];
    if (M <= 0 || K <= 0 || N <= 0 || E <= 0 ||
        info_weight.tensors[0].shape[1] != K ||
        info_scale.tensors[0].shape[0] != E || info_scale.tensors[0].shape[1] != N ||
        info_group_list.tensors[0].shape[0] != E ||
        info_y.tensors[0].shape[0] != M || info_y.tensors[0].shape[1] != N) {
        return;
    }

    constexpr int64_t kBN = GMG_BN, kSlots = 2;

    const int64_t mkPack = (static_cast<int64_t>(M) << 32)
                         | static_cast<int64_t>(static_cast<uint32_t>(K));
    const int64_t nePack = (static_cast<int64_t>(N) << 32)
                         | static_cast<int64_t>(static_cast<uint32_t>(E));
    const int64_t rowsPerE = (M + E - 1) / E;

    const int64_t nSlabsH = (K + GMG_BKL1 - 1) / GMG_BKL1;

    const bool wideFits = (192LL * ((K + 31) / 32 * 32) <= (int64_t)kAResBytes);
    const bool useWide = wideFits
                      && (((rowsPerE + 191) / 192) < ((rowsPerE + 127) / 128))
                      && (nSlabsH <= 4);

    const int64_t kBmGrid[2] = {64, 128};
    int64_t kBM = 64;
    int64_t bestBlocks = (rowsPerE + 63) / 64;
    for (int gi = 1; gi < 2; ++gi) {
        const int64_t b = (rowsPerE + kBmGrid[gi] - 1) / kBmGrid[gi];
        if (b < bestBlocks) { bestBlocks = b; kBM = kBmGrid[gi]; }
    }

    const size_t wsBase = static_cast<size_t>(kPubAreaElems) * sizeof(int32_t)
                         + static_cast<size_t>(availableCoreNum) * kSlots * 128 * kBN
                           * sizeof(int32_t);

    const int64_t padBN    = useWide ? 160 : kBN;
    const int64_t padTiles = (N + padBN - 1) / padBN;
    const int64_t padNal   = padTiles * padBN;
    const int64_t padRb    = useWide ? ((rowsPerE + 191) / 192) : ((rowsPerE + 127) / 128);

    const int64_t padTilesG = (N + kBN - 1) / kBN;
    const int64_t padKPadG  = (K + 31) / 32 * 32;

    const bool padAresPath = (padTilesG >= 2 && kBM == 128
                              && padKPadG * 128 <= kARes128);
    const bool padGenPath  = !useWide && !padAresPath;
    const bool padOnPath = !GMG_TINY_OK(M, K, N)
                        && !GMG_RESIDENT_OK(M, K, N, E, 96, kBN, availableCoreNum)
                        && (useWide || padAresPath || padGenPath);

    const int64_t padWBytes = static_cast<int64_t>(E) * K * padNal;

    bool usePadW = padOnPath && !useWide && N > 1 && K > 1

                && padTiles >= 2 && padRb >= 3
                && padNal <= static_cast<int64_t>(kPadWUbBytes)
                && padWBytes <= (int64_t)256 * 1024 * 1024
                && (GMG_AUTOBAL == 0);
    size_t wsBytes = wsBase + (usePadW ? static_cast<size_t>(padWBytes) : 0);
    void* ws = nullptr;
    if (aclrtMalloc(&ws, wsBytes, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) {

        if (!usePadW) { return; }
        usePadW = false;
        wsBytes = wsBase;
        if (aclrtMalloc(&ws, wsBytes, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) { return; }
    }

    GM_ADDR wUse = weight;
    int64_t nePackW = nePack;
    if (usePadW) {
        void* wsPadBase = (void*)((char*)ws + wsBase);

        wUse = (GM_ADDR)wsPadBase;
        nePackW = nePack | (int64_t)0x80000000LL;
        int64_t padRows = static_cast<int64_t>(kPadWUbBytes) / padNal;
        if (padRows > 4095) { padRows = 4095; }
        if (padRows > K) { padRows = K; }
        const int64_t padItems = (int64_t)E * ((K + padRows - 1) / padRows);
        int64_t padBlk = availableCoreNum * 2;
        if (padItems < padBlk) { padBlk = padItems; }
        if (padBlk < 1) { padBlk = 1; }

        const int64_t blkPack = (padBN << 32) | (padBlk & 0xFFFFFFFFLL);
        GmgPadWKernel<<<static_cast<uint32_t>(padBlk), nullptr, stream>>>(
            weight, wUse, mkPack, nePack, blkPack);
    }

    const int64_t tilesNg = (N + kBN - 1) / kBN;
    const int64_t kPadKg  = (K + 31) / 32 * 32;
    const int64_t blocksUb = (M + kBM - 1) / kBM + E - 1;
    const int64_t tasksUb  = (blocksUb < M ? blocksUb : M) * ((N + kBN - 1) / kBN);

    const int64_t tasksUni = ((rowsPerE + kBM - 1) / kBM) * E * tilesNg;
    const int64_t blkCap   = tasksUb < 1 ? 1
                           : (tasksUb < availableCoreNum ? tasksUb : availableCoreNum);
    int64_t blockNum = GmgAresBlockNum(tasksUni, availableCoreNum);

    const int64_t taskBytesG = kBM * K + K * kBN + kBM * kBN * 2;
    blockNum = GmgCheapWaveBlockNum(tasksUni, availableCoreNum, taskBytesG, blockNum);
    if (blockNum > blkCap) { blockNum = blkCap; }

    if (GMG_TINY_OK(M, K, N)) {

        GmgTinyKernel<<<1, nullptr, stream>>>(x, weight, scale, group_list, y, mkPack, nePack);
    } else if (N == 1 && K <= kSkK2Max && M >= 256) {

        GmgGemvKernel<<<static_cast<uint32_t>(availableCoreNum * 2), nullptr, stream>>>(
            x, weight, scale, group_list, y, mkPack, nePack);
    } else if (K == 1 && M >= 256) {

        GmgOuterKernel<<<static_cast<uint32_t>(availableCoreNum * 2), nullptr, stream>>>(
            x, weight, scale, group_list, y, mkPack, nePack);
    } else if (GMG_RESIDENT_OK(M, K, N, E, 96, kBN, availableCoreNum)) {
        const int64_t resTasks = E * ((N + kBN - 1) / kBN);
        const int64_t resBlk = resTasks < 1 ? 1
                             : (resTasks < availableCoreNum ? resTasks : availableCoreNum);

        GmgResidentKernel<96, GMG_BN, GMG_BK, 2>
            <<<static_cast<uint32_t>(resBlk), nullptr, stream>>>(
                x, weight, scale, group_list, y, (GM_ADDR)ws, mkPack, nePack);
    } else if (useWide) {

        const int64_t wTasks = ((rowsPerE + 191) / 192) * E * ((N + 159) / 160);
        const int64_t wBlk = GmgAresBlockNum(wTasks, availableCoreNum);
        GmgAresKernel<192, 160, GMG_BK, GMG_BKL1, 2>
            <<<static_cast<uint32_t>(wBlk), nullptr, stream>>>(
                x, wUse, scale, group_list, y, (GM_ADDR)ws, mkPack, nePackW);
    } else if (tilesNg >= 2 && kBM == 128 && kPadKg * 128 <= kARes128) {

        const int64_t a2Tasks = ((rowsPerE + 127) / 128) * E * tilesNg;
        const int64_t a2Blk = GmgAresBlockNum(a2Tasks, availableCoreNum);
        GmgAresKernel<128, GMG_BN, GMG_BK, 384, 2, kARes128>
            <<<static_cast<uint32_t>(a2Blk), nullptr, stream>>>(
                x, wUse, scale, group_list, y, (GM_ADDR)ws, mkPack, nePackW);
    } else if (kBM == 128) {
        GroupedMatmulGeluKernel<128, GMG_BN, GMG_BK, GMG_BKL1, 2>
            <<<static_cast<uint32_t>(blockNum), nullptr, stream>>>(
                x, wUse, scale, group_list, y, (GM_ADDR)ws, mkPack, nePackW);
    } else {
        GroupedMatmulGeluKernel<64, GMG_BN, GMG_BK, GMG_BKL1, 2>
            <<<static_cast<uint32_t>(blockNum), nullptr, stream>>>(
                x, wUse, scale, group_list, y, (GM_ADDR)ws, mkPack, nePackW);
    }

    const aclError st = aclrtSynchronizeStream(stream);
    aclrtFree(ws);
    (void)st;
}
