static_cast<uint32_t>((vectorN-CeilDiv(cols,16)*16)/16),
static_cast<uint32_t>((s.n-cols)*2),0};
if(cols==s.n && vectorN==cols) {
outputCopy.blockCount=1;
outputCopy.blockLen=static_cast<uint32_t>(rows*cols*2);
}
DataCopyPad(yg[int64_t(tile.row+rowOffset)*s.n+tile.col+colOffset],
out,outputCopy);
SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
outputPending=true;
SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
}
++ordinal;
}
}
}
start=end; base+=tasks;
}
if ASCEND_IS_AIV {
if(outputPending) WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
}
if ASCEND_IS_AIC {
for(int i=0;i<Min(ordinal,4);++i) CrossCoreWaitFlag(5);
}
}

__aicore__ inline void HCResidentBProduce(Catlass::Arch::Resource<Catlass::Arch::AtlasA2>& resource,
GM_ADDR x, GM_ADDR w, GM_ADDR groups, GM_ADDR scratch,
Shape s, int core, int cores) {
using Policy = Catlass::Gemm::MmadAtlasA2PreloadAsyncWithCallback<1,2,2,2,1,false,false>;
using AType = Catlass::Gemm::GemmType<int8_t,Catlass::layout::RowMajor>;
using BType = Catlass::Gemm::GemmType<int8_t,Catlass::layout::RowMajor>;
using CType = Catlass::Gemm::GemmType<int32_t,Catlass::layout::RowMajor>;
using Block = Catlass::Gemm::Block::HCResidentBMmad<Policy,
Catlass::GemmShape<64,256,1152>,Catlass::GemmShape<64,256,128>,AType,BType,CType>;
Block block(resource);
GlobalTensor<int8_t> ag, bg;
GlobalTensor<int32_t> cg;
GlobalTensor<int64_t> gg;
ag.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
bg.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(w));
cg.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(scratch));
gg.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups));
HDMWaitSlot waits[4];
HDMPublishSlot publishes[4];
int start = 0, base = 0, ordinal = 0;
for (int expert = 0; expert < s.e; ++expert) {
const int end = static_cast<int>(gg.GetValue(expert));
const int tasks = CeilDiv(end-start,256)*CeilDiv(s.n,256);
for (int task = FirstTask(core,cores,base); task < tasks; task += cores) {
const Tile panel = MakeTile(start,end,s.n,task,256,256);
auto bPanel = bg[int64_t(expert)*s.k*s.n+panel.col];
const auto layoutB = Catlass::layout::RowMajor(s.k,s.n);
const Catlass::MatrixCoord bShape{uint32_t(s.k),uint32_t(panel.cols)};
block.PrepareResidentB(bPanel,layoutB.GetTileLayout(bShape));
for (int rowBase = 0; rowBase < panel.rows; rowBase += 64) {
const int rows = Min(64,panel.rows-rowBase);
const int slot = ordinal%4;
Callback before;
if (ordinal>=4) before = MakeCallback(&waits[slot]);
auto after = MakeCallback(&publishes[slot]);
const int64_t offset = (int64_t(slot)*cores+core)*64*256;
block(ag[int64_t(panel.row+rowBase)*s.k],Catlass::layout::RowMajor(rows,s.k),
bPanel,layoutB,cg[offset],Catlass::layout::RowMajor(rows,256),
Catlass::GemmCoord(rows,panel.cols,s.k),before,after);
++ordinal;
}
}
start = end;
base += tasks;
}
block.SynchronizeBlock();
for (int slot = 0; slot < Min(ordinal,4); ++slot) CrossCoreWaitFlag(5);
}

__global__ __aicore__ void HCResidentBGroupedMatmulGelu(
GM_ADDR x,GM_ADDR w,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,
GM_ADDR scratch,GM_ADDR workspace,int64_t workspacePerCore,
GM_ADDR tilingGm,uint64_t syncBase,Shape s,int cores,int macroN) {
KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
SetSyncBaseAddr(syncBase);
int core=GetBlockIdx();
if ASCEND_IS_AIV { core/=2; }
const int sub=GetSubBlockIdx();
Catlass::Arch::Resource<Catlass::Arch::AtlasA2> resource;
if ASCEND_IS_AIC {
HCResidentBProduce(resource,x,w,groups,scratch,s,core,cores);
return;
}
GlobalTensor<int8_t> ag,bg;
GlobalTensor<int32_t> cg;
GlobalTensor<float> sg;
GlobalTensor<int64_t> gg;
GlobalTensor<half> yg;
ag.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
bg.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(w));
cg.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(scratch));
sg.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scale));
gg.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups));
yg.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y));
bool outputPending=false;
int start=0,base=0,ordinal=0;
for(int e=0;e<s.e;++e) {
const int end=static_cast<int>(gg.GetValue(e));
const int tasks=CeilDiv(end-start,256)*CeilDiv(s.n,256);
for(int task=FirstTask(core,cores,base);task<tasks;task+=cores) {
const Tile panel=MakeTile(start,end,s.n,task,256,256);
for (int rowBase=0; rowBase<panel.rows; rowBase+=64) {
Tile tile;
tile.row=panel.row+rowBase; tile.col=panel.col;
tile.rows=Min(64,panel.rows-rowBase); tile.cols=panel.cols;
if ASCEND_IS_AIV {
auto ci=resource.ubBuf.GetBufferByByte<int32_t>(0); auto z=resource.ubBuf.GetBufferByByte<float>(0);
auto u=resource.ubBuf.GetBufferByByte<float>(32768); auto den=resource.ubBuf.GetBufferByByte<float>(32768);
auto sc=resource.ubBuf.GetBufferByByte<float>(65536); auto out=resource.ubBuf.GetBufferByByte<half>(66560);
const int halfRows=(tile.rows+1)/2;
const int rowOffset=sub*halfRows;
const int rows=Min(halfRows,tile.rows-rowOffset);
for(int colOffset=0;colOffset<tile.cols;colOffset+=256) {
const int cols=Min(256,tile.cols-colOffset);
const int vectorN=CeilDiv(cols,64)*64;
const int count=rows*vectorN;
const int slot=ordinal%4;
const int64_t offset=(int64_t(slot)*cores+core)*64*256;
if(rows>0) {
Duplicate(ci,int32_t(0),count);
Duplicate(sc,0.0f,256);
SetFlag<HardEvent::V_MTE2>(EVENT_ID1);
WaitFlag<HardEvent::V_MTE2>(EVENT_ID1);
DataCopyExtParams scaleCopy{1,static_cast<uint32_t>(cols*4),0,0,0};
DataCopyPad(sc,sg[int64_t(e)*s.n+tile.col+colOffset],scaleCopy,
DataCopyPadExtParams<float>{false,0,0,0});
}
CrossCoreWaitFlag(4);
if(rows>0) {
 
const int alignedCols=CeilDiv(cols,8)*8;
DataCopyExtParams inputCopy{static_cast<uint16_t>(rows),
static_cast<uint32_t>(cols*4),static_cast<uint32_t>((256-cols)*4),
static_cast<uint32_t>((vectorN-alignedCols)/8),0};
DataCopyPad(ci,cg[offset+int64_t(rowOffset)*256],inputCopy,
DataCopyPadExtParams<int32_t>{false,0,0,0});
}
 
 
CrossCoreSetFlag<2,PIPE_MTE2>(5);
if(rows>0) {
SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
Cast(z,ci,RoundMode::CAST_NONE,count); PipeBarrier<PIPE_V>();
BinaryRepeatParams br{1,1,1,static_cast<uint8_t>(vectorN/8),
static_cast<uint8_t>(vectorN/8),0};
for(int c=0;c<cols;c+=64)
Mul(z[c],z[c],sc[c],static_cast<uint64_t>(Min(64,cols-c)),
static_cast<uint8_t>(rows),br);
PipeBarrier<PIPE_V>();
#define REF_VEC(call) do { call; PipeBarrier<PIPE_V>(); } while(false)
REF_VEC(Mul(u,z,z,count));
REF_VEC(Muls(u,u,0.044715f,count));
REF_VEC(Adds(u,u,1.0f,count));
REF_VEC(Mul(u,u,z,count));
REF_VEC(Muls(u,u,1.5957691216057308f,count));
REF_VEC(Muls(u,u,-1.0f,count));
REF_VEC(Mins(u,u,80.0f,count));
REF_VEC(Exp(u,u,count));
REF_VEC(Adds(den,u,1.0f,count));
REF_VEC(Div(z,z,den,count));
if(outputPending) { WaitFlag<HardEvent::MTE3_V>(EVENT_ID0); outputPending=false; }
REF_VEC(Cast(out,z,RoundMode::CAST_RINT,count));
#undef REF_VEC
SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
DataCopyExtParams outputCopy{static_cast<uint16_t>(rows),
static_cast<uint32_t>(cols*2),
static_cast<uint32_t>((vectorN-CeilDiv(cols,16)*16)/16),
static_cast<uint32_t>((s.n-cols)*2),0};
if(cols==s.n && vectorN==cols) {
outputCopy.blockCount=1;
outputCopy.blockLen=static_cast<uint32_t>(rows*cols*2);
}
DataCopyPad(yg[int64_t(tile.row+rowOffset)*s.n+tile.col+colOffset],
out,outputCopy);
SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
outputPending=true;
SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
}
++ordinal;
}
}
}
}
start=end; base+=tasks;
}
if ASCEND_IS_AIV {
if(outputPending) WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
}
}using HAHalfFixpipeBase=Catlass::Gemm::Tile::CopyL0CToGm<
Catlass::Arch::AtlasA2,int32_t,
Catlass::Gemm::GemmType<half,Catlass::layout::RowMajor>,
Catlass::Gemm::Tile::ScaleGranularity::PER_TENSOR>;
struct HAHalfFixpipeCopy:HAHalfFixpipeBase {
__aicore__ HAHalfFixpipeCopy():HAHalfFixpipeBase(HAHalfFixpipeBase::Params(0.0009765625f)) {}
};
template<class AType,class BType,class CType>
struct HAHalfTransportTileCopy:Catlass::Gemm::Tile::TileCopy<Catlass::Arch::AtlasA2,AType,BType,CType> {
using CopyL0CToGm=HAHalfFixpipeCopy;
};

__aicore__ inline void HA128AwaitExpertFrames(GM_ADDR readyGm,Shape s,int expert) {
GlobalTensor<int64_t> ready;
ready.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(readyGm));
volatile __gm__ int64_t* flags=reinterpret_cast<volatile __gm__ int64_t*>(readyGm);
const int frames=CeilDiv(CeilDiv(s.k,128)*128,128);
const int index=(s.e*frames+expert)*8;
auto row=ready[index];
while(true) {
DataCacheCleanAndInvalid<int64_t,CacheLine::SINGLE_CACHE_LINE,DcciDst::CACHELINE_OUT>(row);
if(flags[index]==1) break;
}
SetFlag<HardEvent::S_MTE2>(EVENT_ID2);
WaitFlag<HardEvent::S_MTE2>(EVENT_ID2);
}

__aicore__ inline void HA128FinishNZFrame(
const ERSNZFrame& frame,Shape s,const LocalTensor<int8_t>& raw,
const LocalTensor<int8_t>& packed,GlobalTensor<int8_t>& output,bool& outputPending,GM_ADDR readyGm) {
const int kPad=CeilDiv(s.k,128)*128,nPad=CeilDiv(s.n,32)*32;
WaitFlag<HardEvent::MTE2_V>(frame.bank==0?EVENT_ID2:EVENT_ID3);
if(outputPending) {
WaitFlag<HardEvent::MTE3_V>(EVENT_ID2);
outputPending=false;
}
for(int panel=0;panel<nPad/32;++panel) {
DataCopyParams rearrange{128,1,static_cast<uint16_t>(nPad/32-1),0};
DataCopy(packed[panel*128*32],raw[panel*32],rearrange);
}
SetFlag<HardEvent::V_MTE3>(EVENT_ID2);
WaitFlag<HardEvent::V_MTE3>(EVENT_ID2);
const int storeRows=Min(128,kPad-frame.kStart);
DataCopyExtParams store{static_cast<uint16_t>(nPad/32),static_cast<uint32_t>(storeRows*32),static_cast<uint32_t>(128-storeRows),
static_cast<uint32_t>((kPad-storeRows)*32),0};
DataCopyPad(output[int64_t(frame.expert)*kPad*nPad+int64_t(frame.kStart)*32],packed,store);
 
 
SetFlag<HardEvent::MTE3_S>(EVENT_ID2);
WaitFlag<HardEvent::MTE3_S>(EVENT_ID2);
outputPending=false;
GlobalTensor<int64_t> ready;
ready.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(readyGm));
const int frames=CeilDiv(kPad,128);
auto row=ready[(frame.expert*frames+frame.kStart/128)*8];
row.SetValue(0,int64_t(1));
DataCacheCleanAndInvalid<int64_t,CacheLine::SINGLE_CACHE_LINE,DcciDst::CACHELINE_OUT>(row);
 
 
 
 
if(frame.kStart/128==frames-1) {
volatile __gm__ int64_t* flags=reinterpret_cast<volatile __gm__ int64_t*>(readyGm);
for(int f=0;f<frames;++f) {
const int index=(frame.expert*frames+f)*8;
auto inputRow=ready[index];
while(true) {
DataCacheCleanAndInvalid<int64_t,CacheLine::SINGLE_CACHE_LINE,DcciDst::CACHELINE_OUT>(inputRow);
if(flags[index]==1) break;
}
}
auto expertRow=ready[(s.e*frames+frame.expert)*8];
expertRow.SetValue(0,int64_t(1));
DataCacheCleanAndInvalid<int64_t,CacheLine::SINGLE_CACHE_LINE,DcciDst::CACHELINE_OUT>(expertRow);
}
SetFlag<HardEvent::S_V>(EVENT_ID2);
WaitFlag<HardEvent::S_V>(EVENT_ID2);
}
__aicore__ inline void HA128PrepareNZB(
GM_ADDR weights,GM_ADDR packedWeights,GM_ADDR groups,Shape s,int aiv,int aivs,
const LocalTensor<int8_t>& raw0,const LocalTensor<int8_t>& raw1,const LocalTensor<int8_t>& packed,GM_ADDR readyGm) {
GlobalTensor<int8_t> input,output;
GlobalTensor<int64_t> endpoints;
input.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(weights));
output.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(packedWeights));
endpoints.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups));
const int kPad=CeilDiv(s.k,128)*128,nPad=CeilDiv(s.n,32)*32;
const int frames=CeilDiv(kPad,128);
bool outputPending=false,havePrevious=false;
ERSNZFrame previous{};
int ordinal=0;
for(int task=aiv;task<s.e*frames;task+=aivs) {
const int expert=task/frames;
const int end=static_cast<int>(endpoints.GetValue(expert));
const int start=expert==0?0:static_cast<int>(endpoints.GetValue(expert-1));
if(end==start) continue;
const int bank=ordinal%2,kStart=(task%frames)*128;
const int rows=kStart<s.k?Min(128,s.k-kStart):0;
auto raw=bank==0?raw0:raw1;
 
PipeBarrier<PIPE_V>();
Duplicate(raw.ReinterpretCast<int32_t>(),int32_t(0),128*nPad/4);
SetFlag<HardEvent::V_MTE2>(bank==0?EVENT_ID4:EVENT_ID5);
WaitFlag<HardEvent::V_MTE2>(bank==0?EVENT_ID4:EVENT_ID5);
if(rows>0) {
DataCopyExtParams copy{static_cast<uint16_t>(rows),static_cast<uint32_t>(s.n),0,0,0};
DataCopyPad(raw,input[(int64_t(expert)*s.k+kStart)*s.n],copy,
DataCopyPadExtParams<int8_t>{false,0,0,0});
}
SetFlag<HardEvent::MTE2_V>(bank==0?EVENT_ID2:EVENT_ID3);
if(havePrevious) {
HA128FinishNZFrame(previous,s,previous.bank==0?raw0:raw1,packed,output,outputPending,readyGm);
}
previous={expert,kStart,bank};
havePrevious=true;
++ordinal;
}
if(havePrevious) {
HA128FinishNZFrame(previous,s,previous.bank==0?raw0:raw1,packed,output,outputPending,readyGm);
}
if(outputPending) WaitFlag<HardEvent::MTE3_V>(EVENT_ID2);
 
SetFlag<HardEvent::V_MTE2>(EVENT_ID1);
WaitFlag<HardEvent::V_MTE2>(EVENT_ID1);
}

__aicore__ inline void HANZHalfProduce(Catlass::Arch::Resource<Catlass::Arch::AtlasA2>& resource,
GM_ADDR x, GM_ADDR w, GM_ADDR groups, GM_ADDR scratch,
Shape s, int core, int cores,GM_ADDR readyGm) {
using Policy = Catlass::Gemm::MmadAtlasA2PreloadAsyncWithCallback<1,2,2,2,1,false,false>;
using AType = Catlass::Gemm::GemmType<int8_t,Catlass::layout::RowMajor>;
using BType = Catlass::Gemm::GemmType<int8_t,Catlass::layout::zN>;
using CType = Catlass::Gemm::GemmType<half,Catlass::layout::RowMajor>;
using Block = Catlass::Gemm::Block::HCResidentBMmad<Policy,
Catlass::GemmShape<128,256,640>,Catlass::GemmShape<128,256,128>,AType,BType,CType,void,HAHalfTransportTileCopy<AType,BType,CType>>;
Block block(resource);
GlobalTensor<int8_t> ag, bg;
GlobalTensor<half> cg;
GlobalTensor<int64_t> gg;
ag.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
bg.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(w));
cg.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(scratch));
gg.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups));
const int kPad=CeilDiv(s.k,128)*128,nPad=CeilDiv(s.n,32)*32;
HDMWaitSlot waits[4];
HDMPublishSlot publishes[4];
int totalJobs=0,previousEnd=0;
for(int expert=0;expert<s.e;++expert) {
const int end=static_cast<int>(gg.GetValue(expert));
totalJobs+=CeilDiv(end-previousEnd,128)*CeilDiv(s.n,256);
previousEnd=end;
}
const int jobsPerCore=CeilDiv(totalJobs,cores);
const int rangeBegin=core*jobsPerCore;
const int rangeEnd=Min(totalJobs,rangeBegin+jobsPerCore);
int cachedExpert=-1,cachedColumn=-1;
int start=0,base=0,ordinal=0;
for (int expert = 0; expert < s.e; ++expert) {
const int end = static_cast<int>(gg.GetValue(expert));
const int tasks = CeilDiv(end-start,128)*CeilDiv(s.n,256);
bool acquired=false;
for(int task=Max(0,rangeBegin-base);task<Min(tasks,rangeEnd-base);++task) {
if(!acquired) { HA128AwaitExpertFrames(readyGm,s,expert); acquired=true; }
 
const int mTiles=CeilDiv(end-start,128);
Tile panel;
panel.row=start+(task%mTiles)*128;
panel.col=(task/mTiles)*256;
panel.rows=Min(128,end-panel.row);
panel.cols=Min(256,s.n-panel.col);
auto bPanel = bg[int64_t(expert)*kPad*nPad+int64_t(panel.col)*kPad];
const auto layoutB = Catlass::layout::zN::MakeLayout<int8_t>(kPad,nPad);
const Catlass::MatrixCoord bShape{uint32_t(s.k),uint32_t(panel.cols)};
if(expert!=cachedExpert || panel.col!=cachedColumn) {
block.PrepareResidentB(bPanel,layoutB.GetTileLayout(bShape));
cachedExpert=expert;
cachedColumn=panel.col;
}
for (int rowBase = 0; rowBase < panel.rows; rowBase += 128) {
const int rows = Min(128,panel.rows-rowBase);
const int slot = ordinal%4;
Callback before;
if (ordinal>=4) before = MakeCallback(&waits[slot]);
auto after = MakeCallback(&publishes[slot]);
const int64_t offset = (int64_t(slot)*cores+core)*128*256;
block(ag[int64_t(panel.row+rowBase)*s.k],Catlass::layout::RowMajor(rows,s.k),
bPanel,layoutB,cg[offset],Catlass::layout::RowMajor(rows,256),
Catlass::GemmCoord(rows,panel.cols,s.k),before,after);
++ordinal;
}
}
start = end;
base += tasks;
}
block.SynchronizeBlock();
for (int slot = 0; slot < Min(ordinal,4); ++slot) CrossCoreWaitFlag(5);
}

__global__ __aicore__ void HANZHalfGroupedMatmulGelu(
GM_ADDR x,GM_ADDR w,GM_ADDR packedW,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,
GM_ADDR scratch,GM_ADDR workspace,int64_t workspacePerCore,
GM_ADDR tilingGm,uint64_t syncBase,Shape s,int cores,int macroN,GM_ADDR readyGm) {
KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
SetSyncBaseAddr(syncBase);
InitializeReadyInKernel(readyGm,s.e*(CeilDiv(CeilDiv(s.k,128)*128,128)+1)*64,cores);
int core=GetBlockIdx();
if ASCEND_IS_AIV { core/=2; }
const int sub=GetSubBlockIdx();
Catlass::Arch::Resource<Catlass::Arch::AtlasA2> resource;
if ASCEND_IS_AIV {
const int frameBytes=128*CeilDiv(s.n,32)*32;
auto arena=resource.ubBuf.GetBufferByByte<int8_t>(0);
HA128PrepareNZB(w,packedW,groups,s,core*2+sub,cores*2,
arena,arena[frameBytes],arena[2*frameBytes],readyGm);
}
if ASCEND_IS_AIC {
HANZHalfProduce(resource,x,packedW,groups,scratch,s,core,cores,readyGm);
return;
}
GlobalTensor<int8_t> ag,bg;
GlobalTensor<half> cg;
GlobalTensor<float> sg;
GlobalTensor<int64_t> gg;
GlobalTensor<half> yg;
ag.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
bg.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(w));
cg.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(scratch));
sg.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scale));
gg.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups));
yg.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y));
SetFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);
SetFlag<HardEvent::MTE3_MTE2>(EVENT_ID1);
int totalJobs=0,previousEnd=0;
for(int expert=0;expert<s.e;++expert) {
const int end=static_cast<int>(gg.GetValue(expert));
totalJobs+=CeilDiv(end-previousEnd,128)*CeilDiv(s.n,256);
previousEnd=end;
}
const int jobsPerCore=CeilDiv(totalJobs,cores);
const int rangeBegin=core*jobsPerCore;
const int rangeEnd=Min(totalJobs,rangeBegin+jobsPerCore);
int start=0,base=0,ordinal=0;
for(int e=0;e<s.e;++e) {
const int end=static_cast<int>(gg.GetValue(e));
const int tasks=CeilDiv(end-start,128)*CeilDiv(s.n,256);
for(int task=Max(0,rangeBegin-base);task<Min(tasks,rangeEnd-base);++task) {
 
const int mTiles=CeilDiv(end-start,128);
Tile panel;
panel.row=start+(task%mTiles)*128;
panel.col=(task/mTiles)*256;
panel.rows=Min(128,end-panel.row);
panel.cols=Min(256,s.n-panel.col);
for (int rowBase=0; rowBase<panel.rows; rowBase+=128) {
Tile tile;
tile.row=panel.row+rowBase; tile.col=panel.col;
tile.rows=Min(128,panel.rows-rowBase); tile.cols=panel.cols;
if ASCEND_IS_AIV {
auto z=resource.ubBuf.GetBufferByByte<float>(65536);
auto u=resource.ubBuf.GetBufferByByte<float>(131072);
const int halfRows=(tile.rows+1)/2;
const int rowOffset=sub*halfRows;
const int rows=Min(halfRows,tile.rows-rowOffset);
for(int colOffset=0;colOffset<tile.cols;colOffset+=256) {
const int cols=Min(256,tile.cols-colOffset);
const int vectorN=CeilDiv(cols,16)*16;
const int count=rows*vectorN;
const int slot=ordinal%4;
const int bank=ordinal%2;
const event_t bufferEvent=bank==0?EVENT_ID0:EVENT_ID1;
auto ci=resource.ubBuf.GetBufferByByte<half>(bank*32768);
auto out=ci;
auto sc=resource.ubBuf.GetBufferByByte<float>(163840+bank*1024);
const int64_t offset=(int64_t(slot)*cores+core)*128*256;
if(rows>0) {
 
 
WaitFlag<HardEvent::MTE3_MTE2>(bufferEvent);
DataCopyExtParams scaleCopy{1,static_cast<uint32_t>(cols*4),0,0,0};
DataCopyPad(sc,sg[int64_t(e)*s.n+tile.col+colOffset],scaleCopy,
DataCopyPadExtParams<float>{false,0,0,0});
}
CrossCoreWaitFlag(4);
if(rows>0) {
 
const int alignedCols=CeilDiv(cols,16)*16;
DataCopyExtParams inputCopy{static_cast<uint16_t>(rows),
static_cast<uint32_t>(cols*2),static_cast<uint32_t>((256-cols)*2),
static_cast<uint32_t>((vectorN-alignedCols)/16),0};
DataCopyPad(ci,cg[offset+int64_t(rowOffset)*256],inputCopy,
DataCopyPadExtParams<half>{true,0,
static_cast<uint8_t>(vectorN-cols),half(0.0f)});
}
 
 
CrossCoreSetFlag<2,PIPE_MTE2>(5);
if(rows>0) {
SetFlag<HardEvent::MTE2_V>(bufferEvent);
WaitFlag<HardEvent::MTE2_V>(bufferEvent);
Cast(z,ci,RoundMode::CAST_NONE,count); PipeBarrier<PIPE_V>();
 
 
 
Muls(sc,sc,1024.0f,cols); PipeBarrier<PIPE_V>();
BinaryRepeatParams br{1,1,1,static_cast<uint8_t>(vectorN/8),
static_cast<uint8_t>(vectorN/8),0};
for(int c=0;c<cols;c+=64)
Mul(z[c],z[c],sc[c],static_cast<uint64_t>(Min(64,cols-c)),
static_cast<uint8_t>(rows),br);
PipeBarrier<PIPE_V>();
#define REF_VEC(call) do { call; PipeBarrier<PIPE_V>(); } while(false)
 
 
GeluFp32ToHalf(z,u,out,count);
#undef REF_VEC
SetFlag<HardEvent::V_MTE3>(bufferEvent);
WaitFlag<HardEvent::V_MTE3>(bufferEvent);
DataCopyExtParams outputCopy{static_cast<uint16_t>(rows),
static_cast<uint32_t>(cols*2),
static_cast<uint32_t>((vectorN-CeilDiv(cols,16)*16)/16),
static_cast<uint32_t>((s.n-cols)*2),0};
if(cols==s.n && vectorN==cols) {
outputCopy.blockCount=1;
outputCopy.blockLen=static_cast<uint32_t>(rows*cols*2);
}
DataCopyPad(yg[int64_t(tile.row+rowOffset)*s.n+tile.col+colOffset],
out,outputCopy);
SetFlag<HardEvent::MTE3_MTE2>(bufferEvent);
}
++ordinal;
}
}
}
}
start=end; base+=tasks;
}
if ASCEND_IS_AIV {
WaitFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);
WaitFlag<HardEvent::MTE3_MTE2>(EVENT_ID1);
PipeBarrier<PIPE_ALL>();
}
}
__aicore__ inline void HABulkBProduce(Catlass::Arch::Resource<Catlass::Arch::AtlasA2>& resource,
GM_ADDR x, GM_ADDR w, GM_ADDR groups, GM_ADDR scratch,
Shape s, int core, int cores) {
using Policy = Catlass::Gemm::MmadAtlasA2PreloadAsyncWithCallback<1,2,2,2,1,false,false>;
using AType = Catlass::Gemm::GemmType<int8_t,Catlass::layout::RowMajor>;
using BType = Catlass::Gemm::GemmType<int8_t,Catlass::layout::RowMajor>;
using CType = Catlass::Gemm::GemmType<half,Catlass::layout::RowMajor>;
using Block = Catlass::Gemm::Block::HCResidentBMmad<Policy,
Catlass::GemmShape<128,256,640>,Catlass::GemmShape<128,256,128>,AType,BType,CType,void,HAHalfTransportTileCopy<AType,BType,CType>>;
Block block(resource);
GlobalTensor<int8_t> ag, bg;
GlobalTensor<half> cg;
GlobalTensor<int64_t> gg;
ag.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
bg.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(w));
cg.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(scratch));
gg.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups));
HDMWaitSlot waits[4];
HDMPublishSlot publishes[4];
int totalJobs=0,previousEnd=0;
for(int expert=0;expert<s.e;++expert) {
const int end=static_cast<int>(gg.GetValue(expert));
totalJobs+=CeilDiv(end-previousEnd,128)*CeilDiv(s.n,256);
previousEnd=end;
}
const int jobsPerCore=CeilDiv(totalJobs,cores);
const int rangeBegin=core*jobsPerCore;
const int rangeEnd=Min(totalJobs,rangeBegin+jobsPerCore);
int cachedExpert=-1,cachedColumn=-1;
int start=0,base=0,ordinal=0;
for (int expert = 0; expert < s.e; ++expert) {
const int end = static_cast<int>(gg.GetValue(expert));
const int tasks = CeilDiv(end-start,128)*CeilDiv(s.n,256);
for(int task=Max(0,rangeBegin-base);task<Min(tasks,rangeEnd-base);++task) {
 
const int mTiles=CeilDiv(end-start,128);
Tile panel;
panel.row=start+(task%mTiles)*128;
panel.col=(task/mTiles)*256;
panel.rows=Min(128,end-panel.row);
panel.cols=Min(256,s.n-panel.col);
auto bPanel = bg[int64_t(expert)*s.k*s.n+panel.col];
const auto layoutB = Catlass::layout::RowMajor(s.k,s.n);
const Catlass::MatrixCoord bShape{uint32_t(s.k),uint32_t(panel.cols)};
if(expert!=cachedExpert || panel.col!=cachedColumn) {
block.PrepareResidentB(bPanel,layoutB.GetTileLayout(bShape));
cachedExpert=expert;
cachedColumn=panel.col;
}
for (int rowBase = 0; rowBase < panel.rows; rowBase += 128) {
const int rows = Min(128,panel.rows-rowBase);
const int slot = ordinal%4;
Callback before;
if (ordinal>=4) before = MakeCallback(&waits[slot]);
auto after = MakeCallback(&publishes[slot]);
const int64_t offset = (int64_t(slot)*cores+core)*128*256;
block(ag[int64_t(panel.row+rowBase)*s.k],Catlass::layout::RowMajor(rows,s.k),
bPanel,layoutB,cg[offset],Catlass::layout::RowMajor(rows,256),
Catlass::GemmCoord(rows,panel.cols,s.k),before,after);
++ordinal;
}
}
start = end;
base += tasks;
}
block.SynchronizeBlock();
for (int slot = 0; slot < Min(ordinal,4); ++slot) CrossCoreWaitFlag(5);
}

__global__ __aicore__ void HABulkBGroupedMatmulGelu(
GM_ADDR x,GM_ADDR w,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,
GM_ADDR scratch,GM_ADDR workspace,int64_t workspacePerCore,
GM_ADDR tilingGm,uint64_t syncBase,Shape s,int cores,int macroN) {
KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
SetSyncBaseAddr(syncBase);
int core=GetBlockIdx();
if ASCEND_IS_AIV { core/=2; }
const int sub=GetSubBlockIdx();
Catlass::Arch::Resource<Catlass::Arch::AtlasA2> resource;
if ASCEND_IS_AIC {
HABulkBProduce(resource,x,w,groups,scratch,s,core,cores);
return;
}
GlobalTensor<int8_t> ag,bg;
GlobalTensor<half> cg;
GlobalTensor<float> sg;
GlobalTensor<int64_t> gg;
GlobalTensor<half> yg;
ag.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
bg.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(w));
cg.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(scratch));
sg.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scale));
gg.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups));
yg.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y));
SetFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);
SetFlag<HardEvent::MTE3_MTE2>(EVENT_ID1);
int totalJobs=0,previousEnd=0;
for(int expert=0;expert<s.e;++expert) {
const int end=static_cast<int>(gg.GetValue(expert));
totalJobs+=CeilDiv(end-previousEnd,128)*CeilDiv(s.n,256);
previousEnd=end;
}
const int jobsPerCore=CeilDiv(totalJobs,cores);
const int rangeBegin=core*jobsPerCore;
const int rangeEnd=Min(totalJobs,rangeBegin+jobsPerCore);
int start=0,base=0,ordinal=0;
for(int e=0;e<s.e;++e) {
const int end=static_cast<int>(gg.GetValue(e));
const int tasks=CeilDiv(end-start,128)*CeilDiv(s.n,256);
for(int task=Max(0,rangeBegin-base);task<Min(tasks,rangeEnd-base);++task) {
 
const int mTiles=CeilDiv(end-start,128);
Tile panel;
panel.row=start+(task%mTiles)*128;
panel.col=(task/mTiles)*256;
panel.rows=Min(128,end-panel.row);
panel.cols=Min(256,s.n-panel.col);
for (int rowBase=0; rowBase<panel.rows; rowBase+=128) {
Tile tile;
tile.row=panel.row+rowBase; tile.col=panel.col;
tile.rows=Min(128,panel.rows-rowBase); tile.cols=panel.cols;
if ASCEND_IS_AIV {
auto z=resource.ubBuf.GetBufferByByte<float>(65536);
auto u=resource.ubBuf.GetBufferByByte<float>(131072);
const int halfRows=(tile.rows+1)/2;
const int rowOffset=sub*halfRows;
const int rows=Min(halfRows,tile.rows-rowOffset);
for(int colOffset=0;colOffset<tile.cols;colOffset+=256) {
const int cols=Min(256,tile.cols-colOffset);
const int vectorN=CeilDiv(cols,16)*16;
const int count=rows*vectorN;
const int slot=ordinal%4;
const int bank=ordinal%2;
const event_t bufferEvent=bank==0?EVENT_ID0:EVENT_ID1;
auto ci=resource.ubBuf.GetBufferByByte<half>(bank*32768);
auto out=ci;
auto sc=resource.ubBuf.GetBufferByByte<float>(163840+bank*1024);
const int64_t offset=(int64_t(slot)*cores+core)*128*256;
if(rows>0) {
 
 
WaitFlag<HardEvent::MTE3_MTE2>(bufferEvent);
DataCopyExtParams scaleCopy{1,static_cast<uint32_t>(cols*4),0,0,0};
DataCopyPad(sc,sg[int64_t(e)*s.n+tile.col+colOffset],scaleCopy,
DataCopyPadExtParams<float>{false,0,0,0});
}
CrossCoreWaitFlag(4);
if(rows>0) {
 
const int alignedCols=CeilDiv(cols,16)*16;
DataCopyExtParams inputCopy{static_cast<uint16_t>(rows),
static_cast<uint32_t>(cols*2),static_cast<uint32_t>((256-cols)*2),
static_cast<uint32_t>((vectorN-alignedCols)/16),0};
DataCopyPad(ci,cg[offset+int64_t(rowOffset)*256],inputCopy,
DataCopyPadExtParams<half>{true,0,
static_cast<uint8_t>(vectorN-cols),half(0.0f)});
}
 
 
CrossCoreSetFlag<2,PIPE_MTE2>(5);
if(rows>0) {
SetFlag<HardEvent::MTE2_V>(bufferEvent);
WaitFlag<HardEvent::MTE2_V>(bufferEvent);
Cast(z,ci,RoundMode::CAST_NONE,count); PipeBarrier<PIPE_V>();
 
 
 
Muls(sc,sc,1024.0f,cols); PipeBarrier<PIPE_V>();
BinaryRepeatParams br{1,1,1,static_cast<uint8_t>(vectorN/8),
static_cast<uint8_t>(vectorN/8),0};
for(int c=0;c<cols;c+=64)
Mul(z[c],z[c],sc[c],static_cast<uint64_t>(Min(64,cols-c)),
static_cast<uint8_t>(rows),br);
PipeBarrier<PIPE_V>();
#define REF_VEC(call) do { call; PipeBarrier<PIPE_V>(); } while(false)
 
 
GeluFp32ToHalf(z,u,out,count);
#undef REF_VEC
SetFlag<HardEvent::V_MTE3>(bufferEvent);
WaitFlag<HardEvent::V_MTE3>(bufferEvent);
DataCopyExtParams outputCopy{static_cast<uint16_t>(rows),
static_cast<uint32_t>(cols*2),
static_cast<uint32_t>((vectorN-CeilDiv(cols,16)*16)/16),
static_cast<uint32_t>((s.n-cols)*2),0};
if(cols==s.n && vectorN==cols) {
outputCopy.blockCount=1;
outputCopy.blockLen=static_cast<uint32_t>(rows*cols*2);
}
DataCopyPad(yg[int64_t(tile.row+rowOffset)*s.n+tile.col+colOffset],
out,outputCopy);
SetFlag<HardEvent::MTE3_MTE2>(bufferEvent);
}
++ordinal;
}
}
}
}
start=end; base+=tasks;
}
if ASCEND_IS_AIV {
WaitFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);
WaitFlag<HardEvent::MTE3_MTE2>(EVENT_ID1);
PipeBarrier<PIPE_ALL>();
}
}
__aicore__ inline void ERL1MainPrepareNZB(
GM_ADDR weights,GM_ADDR packedWeights,GM_ADDR groups,Shape s,int sourceK,int aiv,int aivs,
const LocalTensor<int8_t>& raw0,const LocalTensor<int8_t>& raw1,const LocalTensor<int8_t>& packed,GM_ADDR readyGm) {
GlobalTensor<int8_t> input,output;
GlobalTensor<int64_t> endpoints;
input.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(weights));
output.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(packedWeights));
endpoints.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups));
const int kPad=CeilDiv(s.k,128)*128,nPad=CeilDiv(s.n,32)*32;
const int frames=CeilDiv(kPad,80);
bool outputPending=false,havePrevious=false;
ERSNZFrame previous{};
int ordinal=0;
for(int task=aiv;task<s.e*frames;task+=aivs) {
const int expert=task/frames;
const int end=static_cast<int>(endpoints.GetValue(expert));
const int start=expert==0?0:static_cast<int>(endpoints.GetValue(expert-1));
if(end==start) continue;
const int bank=ordinal%2,kStart=(task%frames)*80;
const int rows=kStart<s.k?Min(80,s.k-kStart):0;
auto raw=bank==0?raw0:raw1;
 
PipeBarrier<PIPE_V>();
Duplicate(raw.ReinterpretCast<int32_t>(),int32_t(0),80*nPad/4);
SetFlag<HardEvent::V_MTE2>(bank==0?EVENT_ID4:EVENT_ID5);
WaitFlag<HardEvent::V_MTE2>(bank==0?EVENT_ID4:EVENT_ID5);
if(rows>0) {
DataCopyExtParams copy{static_cast<uint16_t>(rows),static_cast<uint32_t>(s.n),0,0,0};
DataCopyPad(raw,input[(int64_t(expert)*sourceK+kStart)*s.n],copy,
DataCopyPadExtParams<int8_t>{false,0,0,0});
}
SetFlag<HardEvent::MTE2_V>(bank==0?EVENT_ID2:EVENT_ID3);
if(havePrevious) {
ERSReadyFinishNZFrame(previous,s,previous.bank==0?raw0:raw1,packed,output,outputPending,readyGm);
}
previous={expert,kStart,bank};
havePrevious=true;
++ordinal;
}
if(havePrevious) {
ERSReadyFinishNZFrame(previous,s,previous.bank==0?raw0:raw1,packed,output,outputPending,readyGm);
}
if(outputPending) WaitFlag<HardEvent::MTE3_V>(EVENT_ID2);
 
SetFlag<HardEvent::V_MTE2>(EVENT_ID1);
WaitFlag<HardEvent::V_MTE2>(EVENT_ID1);
}

using ERL1HalfFixpipeBase=Catlass::Gemm::Tile::CopyL0CToGm<
Catlass::Arch::AtlasA2,int32_t,
Catlass::Gemm::GemmType<half,Catlass::layout::RowMajor>,
Catlass::Gemm::Tile::ScaleGranularity::PER_TENSOR>;
struct ERL1HalfFixpipeCopy:ERL1HalfFixpipeBase {
__aicore__ ERL1HalfFixpipeCopy():ERL1HalfFixpipeBase(ERL1HalfFixpipeBase::Params(0.0009765625f)) {}
};
template<class AType,class BType,class CType>
struct ERL1HalfTransportTileCopy:Catlass::Gemm::Tile::TileCopy<Catlass::Arch::AtlasA2,AType,BType,CType> {
using CopyL0CToGm=ERL1HalfFixpipeCopy;
};

__aicore__ inline void ERL1TailHalfProduce(Catlass::Arch::Resource<Catlass::Arch::AtlasA2>& resource,
GM_ADDR x, GM_ADDR w, GM_ADDR groups, GM_ADDR scratch,
Shape s, int core, int cores,GM_ADDR readyGm) {
using Policy = Catlass::Gemm::MmadAtlasA2PreloadAsyncWithCallback<1,2,2,2,1,false,false>;
using AType = Catlass::Gemm::GemmType<int8_t,Catlass::layout::RowMajor>;
using BType = Catlass::Gemm::GemmType<int8_t,Catlass::layout::zN>;
using CType = Catlass::Gemm::GemmType<half,Catlass::layout::RowMajor>;
using Block = Catlass::Gemm::Block::HCResidentBMmad<Policy,
Catlass::GemmShape<96,192,1024>,Catlass::GemmShape<96,192,128>,AType,BType,CType,void,ERL1HalfTransportTileCopy<AType,BType,CType>>;
Block block(resource);
GlobalTensor<int8_t> ag, bg;
GlobalTensor<half> cg;
GlobalTensor<int64_t> gg;
ag.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
bg.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(w));
cg.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(scratch));
gg.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups));
Shape mainShape=s;
mainShape.k=s.k-1;
const int kPad=CeilDiv(mainShape.k,128)*128,nPad=CeilDiv(s.n,32)*32;
HDMWaitSlot waits[4];
HDMPublishSlot publishes[4];
int start = 0, base = 0, ordinal = 0;
for (int expert = 0; expert < s.e; ++expert) {
const int end = static_cast<int>(gg.GetValue(expert));
const int tasks = CeilDiv(end-start,384)*CeilDiv(s.n,192);
bool acquired=false;
for (int task = FirstTask(core,cores,base); task < tasks; task += cores) {
if(!acquired) { ERSAwaitExpertFrames(readyGm,mainShape,expert); acquired=true; }
const Tile panel = MakeTile(start,end,s.n,task,384,192);
auto bPanel = bg[int64_t(expert)*kPad*nPad+int64_t(panel.col)*kPad];
const auto layoutB = Catlass::layout::zN::MakeLayout<int8_t>(kPad,nPad);
const Catlass::MatrixCoord bShape{uint32_t(mainShape.k),uint32_t(panel.cols)};
block.PrepareResidentB(bPanel,layoutB.GetTileLayout(bShape));
for (int rowBase = 0; rowBase < panel.rows; rowBase += 96) {
const int rows = Min(96,panel.rows-rowBase);
const int slot = ordinal%4;
Callback before;
if (ordinal>=4) before = MakeCallback(&waits[slot]);
auto after = MakeCallback(&publishes[slot]);
const int64_t offset = (int64_t(slot)*cores+core)*96*192;
block(ag[int64_t(panel.row+rowBase)*s.k],Catlass::layout::RowMajor(rows,s.k),
bPanel,layoutB,cg[offset],Catlass::layout::RowMajor(rows,192),
Catlass::GemmCoord(rows,panel.cols,mainShape.k),before,after);
++ordinal;
}
}
start = end;
base += tasks;
}
block.SynchronizeBlock();
for (int slot = 0; slot < Min(ordinal,4); ++slot) CrossCoreWaitFlag(5);
}

__global__ __aicore__ void ERL1TailHalfGroupedMatmulGelu(
GM_ADDR x,GM_ADDR w,GM_ADDR packedW,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,
GM_ADDR scratch,GM_ADDR workspace,int64_t workspacePerCore,
GM_ADDR tilingGm,uint64_t syncBase,Shape s,int cores,int macroN,GM_ADDR readyGm) {
KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
SetSyncBaseAddr(syncBase);
InitializeReadyInKernel(readyGm,s.e*(CeilDiv(CeilDiv(s.k-1,128)*128,80)+1)*64,cores);
int core=GetBlockIdx();
if ASCEND_IS_AIV { core/=2; }
const int sub=GetSubBlockIdx();
Catlass::Arch::Resource<Catlass::Arch::AtlasA2> resource;
Shape mainShape=s;
mainShape.k=s.k-1;
if ASCEND_IS_AIV {
const int frameBytes=80*CeilDiv(s.n,32)*32;
auto arena=resource.ubBuf.GetBufferByByte<int8_t>(0);
ERL1MainPrepareNZB(w,packedW,groups,mainShape,s.k,core*2+sub,cores*2,
arena,arena[frameBytes],arena[2*frameBytes],readyGm);
}
if ASCEND_IS_AIC {
ERL1TailHalfProduce(resource,x,packedW,groups,scratch,s,core,cores,readyGm);
return;
}
GlobalTensor<int8_t> ag,bg;
GlobalTensor<half> cg;
GlobalTensor<float> sg;
GlobalTensor<int64_t> gg;
GlobalTensor<half> yg;
ag.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
bg.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(w));
cg.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(scratch));
sg.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scale));
gg.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups));
yg.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y));
GlobalTensor<int8_t> tailWeights;
tailWeights.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(w));
auto tailRawABanks=resource.ubBuf.GetBufferByByte<int8_t>(165888);
auto tailRawBBanks=resource.ubBuf.GetBufferByByte<int8_t>(169984);
auto tailAHalf=resource.ubBuf.GetBufferByByte<half>(170496);
auto tailACompact=resource.ubBuf.GetBufferByByte<half>(174592);
auto tailABroadcast=resource.ubBuf.GetBufferByByte<half>(174720);
auto tailBHalf=resource.ubBuf.GetBufferByByte<half>(176768);
auto tailOffsets=resource.ubBuf.GetBufferByByte<int32_t>(177280);
Duplicate(tailACompact,half(0.0f),64);
CreateVecIndex(tailOffsets,int32_t(0),uint32_t(64));
PipeBarrier<PIPE_V>();
Muls(tailOffsets,tailOffsets,int32_t(64),64);
PipeBarrier<PIPE_V>();
SetFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);
SetFlag<HardEvent::MTE3_MTE2>(EVENT_ID1);
int start=0,base=0,ordinal=0;
for(int e=0;e<s.e;++e) {
const int end=static_cast<int>(gg.GetValue(e));
const int tasks=CeilDiv(end-start,384)*CeilDiv(s.n,192);
for(int task=FirstTask(core,cores,base);task<tasks;task+=cores) {
const Tile panel=MakeTile(start,end,s.n,task,384,192);
for (int rowBase=0; rowBase<panel.rows; rowBase+=96) {
Tile tile;
tile.row=panel.row+rowBase; tile.col=panel.col;
tile.rows=Min(96,panel.rows-rowBase); tile.cols=panel.cols;
if ASCEND_IS_AIV {
auto z=resource.ubBuf.GetBufferByByte<float>(65536);
auto u=resource.ubBuf.GetBufferByByte<float>(131072);
const int halfRows=(tile.rows+1)/2;
const int rowOffset=sub*halfRows;
const int rows=Min(halfRows,tile.rows-rowOffset);
for(int colOffset=0;colOffset<tile.cols;colOffset+=192) {
const int cols=Min(192,tile.cols-colOffset);
const int vectorN=CeilDiv(cols,16)*16;
const int count=rows*vectorN;
const int slot=ordinal%4;
const int bank=ordinal%2;
const event_t bufferEvent=bank==0?EVENT_ID0:EVENT_ID1;
auto ci=resource.ubBuf.GetBufferByByte<half>(bank*32768);
auto out=ci;
auto sc=resource.ubBuf.GetBufferByByte<float>(163840+bank*1024);
auto tailARaw=tailRawABanks[bank*2048];
auto tailBRaw=tailRawBBanks[bank*256];
const int64_t offset=(int64_t(slot)*cores+core)*96*192;
if(rows>0) {
 
 
WaitFlag<HardEvent::MTE3_MTE2>(bufferEvent);
DataCopyExtParams scaleCopy{1,static_cast<uint32_t>(cols*4),0,0,0};
DataCopyPad(sc,sg[int64_t(e)*s.n+tile.col+colOffset],scaleCopy,
DataCopyPadExtParams<float>{false,0,0,0});
 
 
DataCopyExtParams tailACopy{static_cast<uint16_t>(rows),1,
static_cast<uint32_t>(s.k-1),0,0};
DataCopyPad(tailARaw,ag[int64_t(tile.row+rowOffset)*s.k+s.k-1],tailACopy,
DataCopyPadExtParams<int8_t>{true,0,31,0});
DataCopyExtParams tailBCopy{1,static_cast<uint32_t>(cols),0,0,0};
DataCopyPad(tailBRaw,tailWeights[(int64_t(e)*s.k+s.k-1)*s.n+tile.col+colOffset],
tailBCopy,DataCopyPadExtParams<int8_t>{true,0,
static_cast<uint8_t>(CeilDiv(cols,32)*32-cols),0});
}
CrossCoreWaitFlag(4);
if(rows>0) {
 
const int alignedCols=CeilDiv(cols,16)*16;
DataCopyExtParams inputCopy{static_cast<uint16_t>(rows),
static_cast<uint32_t>(cols*2),static_cast<uint32_t>((192-cols)*2),
static_cast<uint32_t>((vectorN-alignedCols)/16),0};
DataCopyPad(ci,cg[offset+int64_t(rowOffset)*192],inputCopy,
DataCopyPadExtParams<half>{true,0,
static_cast<uint8_t>(vectorN-cols),half(0.0f)});
}
 
 
CrossCoreSetFlag<2,PIPE_MTE2>(5);
if(rows>0) {
SetFlag<HardEvent::MTE2_V>(bufferEvent);
WaitFlag<HardEvent::MTE2_V>(bufferEvent);
Cast(z,ci,RoundMode::CAST_NONE,count); PipeBarrier<PIPE_V>();
Cast(tailAHalf,tailARaw,RoundMode::CAST_NONE,rows*32);
Cast(tailBHalf,tailBRaw,RoundMode::CAST_NONE,CeilDiv(cols,32)*32);
PipeBarrier<PIPE_V>();
 
 
Muls(tailAHalf,tailAHalf,half(0.0009765625f),rows*32);
PipeBarrier<PIPE_V>();
Gather(tailACompact,tailAHalf,tailOffsets.ReinterpretCast<uint32_t>(),uint32_t(0),uint32_t(rows));
PipeBarrier<PIPE_V>();
Brcb(tailABroadcast,tailACompact,static_cast<uint8_t>(CeilDiv(rows,8)),BrcbRepeatParams{1,8});
PipeBarrier<PIPE_V>();
const BinaryRepeatParams rankOne{1,0,1,
static_cast<uint8_t>(vectorN/8),1,0};
for(int c=0;c<cols;c+=64) {
MulAddDst<float,half>(z[c],tailABroadcast,tailBHalf[c],
static_cast<uint64_t>(Min(64,cols-c)),static_cast<uint8_t>(rows),rankOne);
}
PipeBarrier<PIPE_V>();
 
 
 
Muls(sc,sc,1024.0f,cols); PipeBarrier<PIPE_V>();
BinaryRepeatParams br{1,1,1,static_cast<uint8_t>(vectorN/8),
static_cast<uint8_t>(vectorN/8),0};
for(int c=0;c<cols;c+=64)
Mul(z[c],z[c],sc[c],static_cast<uint64_t>(Min(64,cols-c)),
static_cast<uint8_t>(rows),br);
PipeBarrier<PIPE_V>();
#define REF_VEC(call) do { call; PipeBarrier<PIPE_V>(); } while(false)
 
 
GeluFp32ToHalf(z,u,out,count);
#undef REF_VEC
SetFlag<HardEvent::V_MTE3>(bufferEvent);
WaitFlag<HardEvent::V_MTE3>(bufferEvent);
DataCopyExtParams outputCopy{static_cast<uint16_t>(rows),
static_cast<uint32_t>(cols*2),
static_cast<uint32_t>((vectorN-CeilDiv(cols,16)*16)/16),
static_cast<uint32_t>((s.n-cols)*2),0};
if(cols==s.n && vectorN==cols) {
outputCopy.blockCount=1;
outputCopy.blockLen=static_cast<uint32_t>(rows*cols*2);
}
DataCopyPad(yg[int64_t(tile.row+rowOffset)*s.n+tile.col+colOffset],
out,outputCopy);
SetFlag<HardEvent::MTE3_MTE2>(bufferEvent);
}
++ordinal;
}
}
}
}
start=end; base+=tasks;
}
if ASCEND_IS_AIV {
WaitFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);
WaitFlag<HardEvent::MTE3_MTE2>(EVENT_ID1);
PipeBarrier<PIPE_ALL>();
}
}
__aicore__ inline void ERL1ExpertReadyProduce(Catlass::Arch::Resource<Catlass::Arch::AtlasA2>& resource,
GM_ADDR x, GM_ADDR w, GM_ADDR groups, GM_ADDR scratch,
Shape s, int core, int cores,GM_ADDR readyGm) {
using Policy = Catlass::Gemm::MmadAtlasA2PreloadAsyncWithCallback<1,2,2,2,1,false,false>;
using AType = Catlass::Gemm::GemmType<int8_t,Catlass::layout::RowMajor>;
using BType = Catlass::Gemm::GemmType<int8_t,Catlass::layout::zN>;
using CType = Catlass::Gemm::GemmType<int32_t,Catlass::layout::RowMajor>;
using Block = Catlass::Gemm::Block::HCResidentBMmad<Policy,
Catlass::GemmShape<96,192,1152>,Catlass::GemmShape<96,192,128>,AType,BType,CType>;
Block block(resource);
GlobalTensor<int8_t> ag, bg;
GlobalTensor<int32_t> cg;
GlobalTensor<int64_t> gg;
ag.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
bg.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(w));
cg.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(scratch));
gg.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups));
const int kPad=CeilDiv(s.k,128)*128,nPad=CeilDiv(s.n,32)*32;
HDMWaitSlot waits[4];
HDMPublishSlot publishes[4];
int start = 0, base = 0, ordinal = 0;
for (int expert = 0; expert < s.e; ++expert) {
const int end = static_cast<int>(gg.GetValue(expert));
const int tasks = CeilDiv(end-start,384)*CeilDiv(s.n,192);
bool acquired=false;
for (int task = FirstTask(core,cores,base); task < tasks; task += cores) {
if(!acquired) { ERSAwaitExpertFrames(readyGm,s,expert); acquired=true; }
const Tile panel = MakeTile(start,end,s.n,task,384,192);
auto bPanel = bg[int64_t(expert)*kPad*nPad+int64_t(panel.col)*kPad];
const auto layoutB = Catlass::layout::zN::MakeLayout<int8_t>(kPad,nPad);
const Catlass::MatrixCoord bShape{uint32_t(s.k),uint32_t(panel.cols)};
block.PrepareResidentB(bPanel,layoutB.GetTileLayout(bShape));
for (int rowBase = 0; rowBase < panel.rows; rowBase += 96) {
const int rows = Min(96,panel.rows-rowBase);
const int slot = ordinal%4;
Callback before;
if (ordinal>=4) before = MakeCallback(&waits[slot]);
auto after = MakeCallback(&publishes[slot]);
const int64_t offset = (int64_t(slot)*cores+core)*96*192;
block(ag[int64_t(panel.row+rowBase)*s.k],Catlass::layout::RowMajor(rows,s.k),
bPanel,layoutB,cg[offset],Catlass::layout::RowMajor(rows,192),
Catlass::GemmCoord(rows,panel.cols,s.k),before,after);
++ordinal;
}
}
start = end;
base += tasks;
}
block.SynchronizeBlock();
for (int slot = 0; slot < Min(ordinal,4); ++slot) CrossCoreWaitFlag(5);
}

__global__ __aicore__ void ERL1ExpertReadyGroupedMatmulGelu(
GM_ADDR x,GM_ADDR w,GM_ADDR packedW,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,
GM_ADDR scratch,GM_ADDR workspace,int64_t workspacePerCore,
GM_ADDR tilingGm,uint64_t syncBase,Shape s,int cores,int macroN,GM_ADDR readyGm) {
KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
SetSyncBaseAddr(syncBase);
InitializeReadyInKernel(readyGm,s.e*(CeilDiv(CeilDiv(s.k,128)*128,80)+1)*64,cores);
int core=GetBlockIdx();
if ASCEND_IS_AIV { core/=2; }
const int sub=GetSubBlockIdx();
Catlass::Arch::Resource<Catlass::Arch::AtlasA2> resource;
if ASCEND_IS_AIV {
const int frameBytes=80*CeilDiv(s.n,32)*32;
auto arena=resource.ubBuf.GetBufferByByte<int8_t>(0);
ERSReadyPrepareNZB(w,packedW,groups,s,core*2+sub,cores*2,
arena,arena[frameBytes],arena[2*frameBytes],readyGm);
}
if ASCEND_IS_AIC {
ERL1ExpertReadyProduce(resource,x,packedW,groups,scratch,s,core,cores,readyGm);
return;
}
GlobalTensor<int8_t> ag,bg;
GlobalTensor<int32_t> cg;
GlobalTensor<float> sg;
GlobalTensor<int64_t> gg;
GlobalTensor<half> yg;
ag.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
bg.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(w));
cg.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(scratch));
sg.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scale));
gg.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups));
yg.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y));
bool outputPending=false;
int start=0,base=0,ordinal=0;
for(int e=0;e<s.e;++e) {
const int end=static_cast<int>(gg.GetValue(e));
const int tasks=CeilDiv(end-start,384)*CeilDiv(s.n,192);
for(int task=FirstTask(core,cores,base);task<tasks;task+=cores) {
const Tile panel=MakeTile(start,end,s.n,task,384,192);
for (int rowBase=0; rowBase<panel.rows; rowBase+=96) {
Tile tile;
tile.row=panel.row+rowBase; tile.col=panel.col;
tile.rows=Min(96,panel.rows-rowBase); tile.cols=panel.cols;
if ASCEND_IS_AIV {
auto ci=resource.ubBuf.GetBufferByByte<int32_t>(0); auto z=resource.ubBuf.GetBufferByByte<float>(0);
auto u=resource.ubBuf.GetBufferByByte<float>(36864); auto den=resource.ubBuf.GetBufferByByte<float>(36864);
auto sc=resource.ubBuf.GetBufferByByte<float>(73728); auto out=resource.ubBuf.GetBufferByByte<half>(74496);
const int halfRows=(tile.rows+1)/2;
const int rowOffset=sub*halfRows;
const int rows=Min(halfRows,tile.rows-rowOffset);
for(int colOffset=0;colOffset<tile.cols;colOffset+=192) {
const int cols=Min(192,tile.cols-colOffset);
const int vectorN=CeilDiv(cols,64)*64;
const int count=rows*vectorN;
const int slot=ordinal%4;
const int64_t offset=(int64_t(slot)*cores+core)*96*192;
if(rows>0) {
Duplicate(ci,int32_t(0),count);
Duplicate(sc,0.0f,192);
SetFlag<HardEvent::V_MTE2>(EVENT_ID1);
WaitFlag<HardEvent::V_MTE2>(EVENT_ID1);
DataCopyExtParams scaleCopy{1,static_cast<uint32_t>(cols*4),0,0,0};
DataCopyPad(sc,sg[int64_t(e)*s.n+tile.col+colOffset],scaleCopy,
DataCopyPadExtParams<float>{false,0,0,0});
}
CrossCoreWaitFlag(4);
if(rows>0) {
 
const int alignedCols=CeilDiv(cols,8)*8;
DataCopyExtParams inputCopy{static_cast<uint16_t>(rows),
static_cast<uint32_t>(cols*4),static_cast<uint32_t>((192-cols)*4),
static_cast<uint32_t>((vectorN-alignedCols)/8),0};
DataCopyPad(ci,cg[offset+int64_t(rowOffset)*192],inputCopy,
DataCopyPadExtParams<int32_t>{false,0,0,0});
}
 
 
CrossCoreSetFlag<2,PIPE_MTE2>(5);
if(rows>0) {
SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
Cast(z,ci,RoundMode::CAST_NONE,count); PipeBarrier<PIPE_V>();
BinaryRepeatParams br{1,1,1,static_cast<uint8_t>(vectorN/8),
static_cast<uint8_t>(vectorN/8),0};
for(int c=0;c<cols;c+=64)
Mul(z[c],z[c],sc[c],static_cast<uint64_t>(Min(64,cols-c)),
static_cast<uint8_t>(rows),br);
PipeBarrier<PIPE_V>();
#define REF_VEC(call) do { call; PipeBarrier<PIPE_V>(); } while(false)
REF_VEC(Mul(u,z,z,count));
REF_VEC(Muls(u,u,0.044715f,count));
REF_VEC(Adds(u,u,1.0f,count));
REF_VEC(Mul(u,u,z,count));
REF_VEC(Muls(u,u,1.5957691216057308f,count));
REF_VEC(Muls(u,u,-1.0f,count));
REF_VEC(Mins(u,u,80.0f,count));
REF_VEC(Exp(u,u,count));
REF_VEC(Adds(den,u,1.0f,count));
REF_VEC(Div(z,z,den,count));
if(outputPending) { WaitFlag<HardEvent::MTE3_V>(EVENT_ID0); outputPending=false; }
REF_VEC(Cast(out,z,RoundMode::CAST_RINT,count));
#undef REF_VEC
SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
DataCopyExtParams outputCopy{static_cast<uint16_t>(rows),
static_cast<uint32_t>(cols*2),
static_cast<uint32_t>((vectorN-CeilDiv(cols,16)*16)/16),
static_cast<uint32_t>((s.n-cols)*2),0};
if(cols==s.n && vectorN==cols) {
outputCopy.blockCount=1;
outputCopy.blockLen=static_cast<uint32_t>(rows*cols*2);
}
DataCopyPad(yg[int64_t(tile.row+rowOffset)*s.n+tile.col+colOffset],
out,outputCopy);
SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
outputPending=true;
SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
}
++ordinal;
}
}
}
}
start=end; base+=tasks;
}
if ASCEND_IS_AIV {
if(outputPending) WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
}
}
