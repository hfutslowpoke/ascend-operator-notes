namespace gmm {
constexpr int TM=128, TN=512, BR=8;
struct Shape { int32_t m,k,n,e; };
struct Tile { int32_t row,col,rows,cols; };
GMM_INLINE int CeilDiv(int a,int b) { return (a+b-1)/b; }
GMM_INLINE int Min(int a,int b) { return a<b?a:b; }
GMM_INLINE int FirstTask(int core,int cores,int base) {
return (core+cores-base%cores)%cores;
}
GMM_INLINE Tile MakeTile(int start,int end,int n,int task,int tileM=TM,int tileN=512) {
const int nt=CeilDiv(n,tileN);
const int row=start+(task/nt)*tileM, col=(task%nt)*tileN;
return {row,col,Min(tileM,end-row),Min(tileN,n-col)};
}
GMM_INLINE int64_t AOffset(int row,int k) { return int64_t(row)*k; }
GMM_INLINE int64_t BOffset(int e,int k,int n,int col) {
return int64_t(e)*k*n+col;
}
inline bool ValidShape(Shape s) {
if(s.m<1 || s.m>65536 || s.k<1 || s.k>8192 ||
s.n<1 || s.n>4096 || s.e<1 || s.e>128) return false;
const int64_t w=int64_t(s.e)*s.k*s.n;
const int64_t bytes=int64_t(s.m)*s.k+w+int64_t(s.e)*s.n*4+
int64_t(s.e)*8+int64_t(s.m)*s.n*2;
return w<=268435456 && bytes<=536870912;
}
}  

#if !defined(GMM_PORTABLE_TEST)
namespace gmm {
using namespace AscendC;
using MM=matmul::Matmul<
matmul::MatmulType<TPosition::GM,::CubeFormat::ND,int8_t>,
matmul::MatmulType<TPosition::GM,::CubeFormat::ND,int8_t>,
matmul::MatmulType<TPosition::GM,::CubeFormat::ND,int32_t>,
matmul::MatmulType<TPosition::GM,::CubeFormat::ND,int32_t>>;


 
 
 
template<int reductionBound>
__global__ __aicore__ void TinyGroupedMatmulGelu(
GM_ADDR x,GM_ADDR w,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,Shape s) {
KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
TPipe pipe;
const int count=s.m*s.n;
const int capacity=64;
TBuf<TPosition::VECCALC> xb,wb,sb,gb,zb,ub,db,hb;
pipe.InitBuffer(xb,CeilDiv(s.m*s.k,32)*32);
pipe.InitBuffer(wb,CeilDiv(s.e*s.k*s.n,32)*32);
pipe.InitBuffer(sb,CeilDiv(s.e*s.n*4,32)*32);
pipe.InitBuffer(gb,CeilDiv(s.e*8,32)*32);
pipe.InitBuffer(zb,capacity*4); pipe.InitBuffer(ub,capacity*4);
pipe.InitBuffer(db,capacity*4); pipe.InitBuffer(hb,capacity*2);
auto a=xb.Get<int8_t>(); auto b=wb.Get<int8_t>();
auto sc=sb.Get<float>(); auto gr=gb.Get<int64_t>();
auto z=zb.Get<float>(); auto u=ub.Get<float>();
auto den=db.Get<float>(); auto out=hb.Get<half>();
GlobalTensor<int8_t> ag,bg;
GlobalTensor<float> sg;
GlobalTensor<int64_t> gg;
GlobalTensor<half> yg;
ag.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
bg.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(w));
sg.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scale));
gg.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups));
yg.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y));
DataCopyExtParams ac{1,static_cast<uint32_t>(s.m*s.k),0,0,0};
DataCopyExtParams bc{1,static_cast<uint32_t>(s.e*s.k*s.n),0,0,0};
DataCopyExtParams scp{1,static_cast<uint32_t>(s.e*s.n*4),0,0,0};
DataCopyExtParams gc{1,static_cast<uint32_t>(s.e*8),0,0,0};
DataCopyPad(a,ag,ac,DataCopyPadExtParams<int8_t>{false,0,0,0});
DataCopyPad(b,bg,bc,DataCopyPadExtParams<int8_t>{false,0,0,0});
DataCopyPad(sc,sg,scp,DataCopyPadExtParams<float>{false,0,0,0});
DataCopyPad(gr,gg,gc,DataCopyPadExtParams<int64_t>{false,0,0,0});
PipeBarrier<PIPE_ALL>();
int start=0;
for(int e=0;e<s.e;++e) {
const int end=static_cast<int>(gr.GetValue(e));
for(int row=start;row<end;++row) {
for(int col=0;col<s.n;++col) {
int32_t acc=0;
#pragma unroll
for(int k=0;k<reductionBound;++k) {
if(k<s.k)
acc+=int32_t(a.GetValue(row*s.k+k))*
int32_t(b.GetValue((e*s.k+k)*s.n+col));
}
z.SetValue(row*s.n+col,float(acc)*sc.GetValue(e*s.n+col));
}
}
start=end;
}
PipeBarrier<PIPE_ALL>();
#define GMM_SMALL_VEC(call) do { call; PipeBarrier<PIPE_V>(); } while(false)
GMM_SMALL_VEC(Mul(u,z,z,count));
 
GMM_SMALL_VEC(Muls(u,u,-0.0713548162726003f,count));
GMM_SMALL_VEC(Adds(u,u,-1.5957691216057308f,count));
GMM_SMALL_VEC(Mul(u,u,z,count));
GMM_SMALL_VEC(Mins(u,u,80.0f,count));
GMM_SMALL_VEC(Exp(u,u,count));
GMM_SMALL_VEC(Adds(den,u,1.0f,count));
GMM_SMALL_VEC(Div(z,z,den,count));
GMM_SMALL_VEC(Cast(out,z,RoundMode::CAST_RINT,count));
#undef GMM_SMALL_VEC
PipeBarrier<PIPE_ALL>();
DataCopyExtParams oc{1,static_cast<uint32_t>(s.m*s.n*2),0,0,0};
DataCopyPad(yg,out,oc);
PipeBarrier<PIPE_ALL>();
}

 
 
__global__ __aicore__ void SmallGroupedMatmulGelu(
GM_ADDR x,GM_ADDR w,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,Shape s) {
KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
TPipe pipe;
const int count=CeilDiv(s.m*s.n,64)*64;
TBuf<TPosition::VECCALC> xb,wb,sb,gb,zb,ub,tb,db,hb;
pipe.InitBuffer(xb,CeilDiv(s.m*s.k,32)*32);
pipe.InitBuffer(wb,CeilDiv(s.e*s.k*s.n,32)*32);
pipe.InitBuffer(sb,CeilDiv(s.e*s.n*4,32)*32);
pipe.InitBuffer(gb,CeilDiv(s.e*8,32)*32);
pipe.InitBuffer(zb,count*4); pipe.InitBuffer(ub,count*4);
pipe.InitBuffer(tb,count*4); pipe.InitBuffer(db,count*4);
pipe.InitBuffer(hb,count*2);
auto a=xb.Get<int8_t>(); auto b=wb.Get<int8_t>();
auto sc=sb.Get<float>(); auto gr=gb.Get<int64_t>();
auto z=zb.Get<float>(); auto u=ub.Get<float>();
auto t=tb.Get<float>(); auto den=db.Get<float>(); auto out=hb.Get<half>();
GlobalTensor<int8_t> ag,bg;
GlobalTensor<float> sg;
GlobalTensor<int64_t> gg;
GlobalTensor<half> yg;
ag.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
bg.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(w));
sg.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scale));
gg.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups));
yg.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y));
DataCopyExtParams ac{1,static_cast<uint32_t>(s.m*s.k),0,0,0};
DataCopyExtParams bc{1,static_cast<uint32_t>(s.e*s.k*s.n),0,0,0};
DataCopyExtParams scp{1,static_cast<uint32_t>(s.e*s.n*4),0,0,0};
DataCopyExtParams gc{1,static_cast<uint32_t>(s.e*8),0,0,0};
DataCopyPad(a,ag,ac,DataCopyPadExtParams<int8_t>{false,0,0,0});
DataCopyPad(b,bg,bc,DataCopyPadExtParams<int8_t>{false,0,0,0});
DataCopyPad(sc,sg,scp,DataCopyPadExtParams<float>{false,0,0,0});
DataCopyPad(gr,gg,gc,DataCopyPadExtParams<int64_t>{false,0,0,0});
Duplicate(z,0.0f,count);
PipeBarrier<PIPE_ALL>();
int start=0;
for(int e=0;e<s.e;++e) {
const int end=static_cast<int>(gr.GetValue(e));
for(int row=start;row<end;++row) {
for(int col=0;col<s.n;++col) {
int32_t acc=0;
for(int k=0;k<s.k;++k)
acc+=int32_t(a.GetValue(row*s.k+k))*
int32_t(b.GetValue((e*s.k+k)*s.n+col));
z.SetValue(row*s.n+col,float(acc)*sc.GetValue(e*s.n+col));
}
}
start=end;
}
PipeBarrier<PIPE_ALL>();
#define GMM_SMALL_VEC(call) do { call; PipeBarrier<PIPE_V>(); } while(false)
GMM_SMALL_VEC(Mul(u,z,z,count));
GMM_SMALL_VEC(Muls(u,u,0.044715f,count));
GMM_SMALL_VEC(Adds(u,u,1.0f,count));
GMM_SMALL_VEC(Mul(u,u,z,count));
GMM_SMALL_VEC(Muls(u,u,1.5957691216057308f,count));
GMM_SMALL_VEC(Muls(u,u,-1.0f,count));
GMM_SMALL_VEC(Mins(u,u,80.0f,count));
GMM_SMALL_VEC(Exp(u,u,count));
GMM_SMALL_VEC(Adds(den,u,1.0f,count));
GMM_SMALL_VEC(Div(z,z,den,count));
GMM_SMALL_VEC(Cast(out,z,RoundMode::CAST_RINT,count));
#undef GMM_SMALL_VEC
PipeBarrier<PIPE_ALL>();
DataCopyExtParams oc{1,static_cast<uint32_t>(s.m*s.n*2),0,0,0};
DataCopyPad(yg,out,oc);
PipeBarrier<PIPE_ALL>();
}

 
 
__global__ __aicore__ void TinyRoutedVectorGroupedMatmulGelu(
GM_ADDR x,GM_ADDR w,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,Shape s) {
KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
if(GetBlockIdx()!=0) return;
const int count=s.e*16;
LocalTensor<int8_t> packedInputs(TPosition::VECCALC,0,288);
LocalTensor<half> packedHalf(TPosition::VECCALC,512,288);
LocalTensor<half> broadcastA(TPosition::VECCALC,1152,128);
LocalTensor<float> scales(TPosition::VECCALC,1408,64);
LocalTensor<int64_t> endpoints(TPosition::VECCALC,1664,8);
LocalTensor<float> z(TPosition::VECCALC,1728,128);
LocalTensor<float> u(TPosition::VECCALC,2240,128);
LocalTensor<float> denominator(TPosition::VECCALC,2752,128);
LocalTensor<half> output(TPosition::VECCALC,3264,128);
GlobalTensor<int8_t> ag,bg;
GlobalTensor<float> sg;
GlobalTensor<int64_t> gg;
GlobalTensor<half> yg;
ag.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
bg.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(w));
sg.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scale));
gg.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups));
yg.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y));
DataCopyExtParams aCopy{1,1,0,0,0};
DataCopyExtParams bCopy{static_cast<uint16_t>(s.e),static_cast<uint32_t>(s.n),0,0,0};
DataCopyExtParams sCopy{static_cast<uint16_t>(s.e),static_cast<uint32_t>(s.n*4),0,0,0};
DataCopyExtParams gCopy{1,static_cast<uint32_t>(s.e*8),0,0,0};
DataCopyPad(packedInputs,ag,aCopy,DataCopyPadExtParams<int8_t>{true,0,31,0});
DataCopyPad(packedInputs[32],bg,bCopy,
DataCopyPadExtParams<int8_t>{true,0,static_cast<uint8_t>(32-s.n),0});
DataCopyPad(scales,sg,sCopy,
DataCopyPadExtParams<float>{true,0,static_cast<uint8_t>(8-s.n),0});
DataCopyPad(endpoints,gg,gCopy,DataCopyPadExtParams<int64_t>{false,0,0,0});
Duplicate(z,0.0f,count);
SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
#define TINY_EXPERT_VEC(...) do { __VA_ARGS__; PipeBarrier<PIPE_V>(); } while(false)
TINY_EXPERT_VEC(Cast(packedHalf,packedInputs,RoundMode::CAST_NONE,(s.e+1)*32));
TINY_EXPERT_VEC(Brcb(broadcastA,packedHalf,1,BrcbRepeatParams{1,8}));
SetMaskNorm();
SetVectorMask<half>(0,(uint64_t(1)<<s.n)-1);
const BinaryRepeatParams mixedExperts{1,1,1,2,0,2};
TINY_EXPERT_VEC(MulAddDst<float,half,false>(z,broadcastA,packedHalf[32],
uint64_t(s.n),uint8_t(s.e),mixedExperts));
SetVectorMask<float>(0,(uint64_t(1)<<s.n)-1);
const BinaryRepeatParams scaleExperts{1,1,1,2,2,1};
TINY_EXPERT_VEC(Mul<float,false>(z,z,scales,uint64_t(s.n),uint8_t(s.e),scaleExperts));
ResetMask();
SetFlag<HardEvent::MTE2_S>(EVENT_ID0);
WaitFlag<HardEvent::MTE2_S>(EVENT_ID0);
int expert=0;
while(expert<s.e-1 && endpoints.GetValue(expert)==0) ++expert;
auto selected=z[expert*16];
TINY_EXPERT_VEC(Mul(u,selected,selected,16));
TINY_EXPERT_VEC(Muls(u,u,-0.0713548162726003f,16));
TINY_EXPERT_VEC(Adds(u,u,-1.5957691216057308f,16));
TINY_EXPERT_VEC(Mul(u,u,selected,16));
TINY_EXPERT_VEC(Mins(u,u,80.0f,16));
TINY_EXPERT_VEC(Exp(u,u,16));
TINY_EXPERT_VEC(Adds(denominator,u,1.0f,16));
TINY_EXPERT_VEC(Div(selected,selected,denominator,16));
TINY_EXPERT_VEC(Cast(output,selected,RoundMode::CAST_RINT,16));
#undef TINY_EXPERT_VEC
SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
DataCopyExtParams outCopy{1,static_cast<uint32_t>(s.n*2),0,0,0};
DataCopyPad(yg,output,outCopy);
PipeBarrier<PIPE_ALL>();
}

__global__ __aicore__ void TinyOriginalMaskGroupedMatmulGelu(
GM_ADDR x,GM_ADDR w,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,Shape s) {
KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
if(GetBlockIdx()!=0) return;
const int count=s.e*16;
LocalTensor<int8_t> packedInputs(TPosition::VECCALC,0,288);
LocalTensor<half> packedHalf(TPosition::VECCALC,512,288);
LocalTensor<half> broadcastA(TPosition::VECCALC,1152,128);
LocalTensor<float> scales(TPosition::VECCALC,1408,64);
LocalTensor<int64_t> endpoints(TPosition::VECCALC,1664,8);
LocalTensor<float> z(TPosition::VECCALC,1728,128);
LocalTensor<float> u(TPosition::VECCALC,2240,128);
LocalTensor<float> denominator(TPosition::VECCALC,2752,128);
LocalTensor<half> output(TPosition::VECCALC,3264,128);
GlobalTensor<int8_t> ag,bg;
GlobalTensor<float> sg;
GlobalTensor<int64_t> gg;
GlobalTensor<half> yg;
ag.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
bg.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(w));
sg.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scale));
gg.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups));
yg.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y));
DataCopyExtParams aCopy{1,1,0,0,0};
DataCopyExtParams bCopy{static_cast<uint16_t>(s.e),static_cast<uint32_t>(s.n),0,0,0};
DataCopyExtParams sCopy{static_cast<uint16_t>(s.e),static_cast<uint32_t>(s.n*4),0,0,0};
DataCopyExtParams gCopy{1,static_cast<uint32_t>(s.e*8),0,0,0};
DataCopyPad(packedInputs,ag,aCopy,DataCopyPadExtParams<int8_t>{true,0,31,0});
DataCopyPad(packedInputs[32],bg,bCopy,
DataCopyPadExtParams<int8_t>{true,0,static_cast<uint8_t>(32-s.n),0});
DataCopyPad(scales,sg,sCopy,
DataCopyPadExtParams<float>{true,0,static_cast<uint8_t>(8-s.n),0});
DataCopyPad(endpoints,gg,gCopy,DataCopyPadExtParams<int64_t>{false,0,0,0});
Duplicate(z,0.0f,count);
SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
#define TINY_EXPERT_VEC(...) do { __VA_ARGS__; PipeBarrier<PIPE_V>(); } while(false)
TINY_EXPERT_VEC(Cast(packedHalf,packedInputs,RoundMode::CAST_NONE,(s.e+1)*32));
TINY_EXPERT_VEC(Brcb(broadcastA,packedHalf,1,BrcbRepeatParams{1,8}));
SetMaskNorm();
SetVectorMask<half>(0,(uint64_t(1)<<s.n)-1);
const BinaryRepeatParams mixedExperts{1,1,1,2,0,2};
TINY_EXPERT_VEC(MulAddDst<float,half,false>(z,broadcastA,packedHalf[32],
uint64_t(s.n),uint8_t(s.e),mixedExperts));
SetVectorMask<float>(0,(uint64_t(1)<<s.n)-1);
const BinaryRepeatParams scaleExperts{1,1,1,2,2,1};
TINY_EXPERT_VEC(Mul<float,false>(z,z,scales,uint64_t(s.n),uint8_t(s.e),scaleExperts));
ResetMask();
SetFlag<HardEvent::MTE2_S>(EVENT_ID0);
WaitFlag<HardEvent::MTE2_S>(EVENT_ID0);
int expert=0;
while(expert<s.e-1 && endpoints.GetValue(expert)==0) ++expert;
auto selected=z[expert*16];
SetMaskNorm();
SetVectorMask<float>(0,65535);
const UnaryRepeatParams unaryRepeat{1,1,8,8};
const BinaryRepeatParams binaryRepeat{1,1,1,8,8,8};
TINY_EXPERT_VEC(Mul<float,false>(u,selected,selected,uint64_t(16),uint8_t(1),binaryRepeat));
TINY_EXPERT_VEC(Muls<float,false>(u,u,-0.0713548162726003f,uint64_t(16),uint8_t(1),unaryRepeat));
TINY_EXPERT_VEC(Adds<float,false>(u,u,-1.5957691216057308f,uint64_t(16),uint8_t(1),unaryRepeat));
TINY_EXPERT_VEC(Mul<float,false>(u,u,selected,uint64_t(16),uint8_t(1),binaryRepeat));
TINY_EXPERT_VEC(Mins<float,false>(u,u,80.0f,uint64_t(16),uint8_t(1),unaryRepeat));
TINY_EXPERT_VEC(Exp<float,false>(u,u,uint64_t(16),uint8_t(1),unaryRepeat));
TINY_EXPERT_VEC(Adds<float,false>(denominator,u,1.0f,uint64_t(16),uint8_t(1),unaryRepeat));
TINY_EXPERT_VEC(Div<float,false>(selected,selected,denominator,uint64_t(16),uint8_t(1),binaryRepeat));
ResetMask();
TINY_EXPERT_VEC(Cast(output,selected,RoundMode::CAST_RINT,16));
#undef TINY_EXPERT_VEC
SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
DataCopyExtParams outCopy{1,static_cast<uint32_t>(s.n*2),0,0,0};
DataCopyPad(yg,output,outCopy);
PipeBarrier<PIPE_ALL>();
}


__global__ __aicore__ void VectorTinyGroupedMatmulGelu(
GM_ADDR x,GM_ADDR w,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,Shape s) {
KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
if(GetBlockIdx()!=0) return;
const int weightBytes=s.e*s.k*s.n;
const int paddedWeightBytes=CeilDiv(weightBytes,32)*32;
const int count=s.m*16;
 
LocalTensor<int8_t> a(TPosition::VECCALC,0,32);
LocalTensor<int8_t> raw(TPosition::VECCALC,32,4096);
LocalTensor<int8_t> packedInputs(TPosition::VECCALC,0,4128);
LocalTensor<half> packedHalf(TPosition::VECCALC,4128,4128);
auto weightHalf=packedHalf[32];
LocalTensor<float> scales(TPosition::VECCALC,28704,256);
LocalTensor<int64_t> endpoints(TPosition::VECCALC,29728,32);
LocalTensor<half> broadcastA(TPosition::VECCALC,12416,512);
LocalTensor<half> expandedB(TPosition::VECCALC,13440,512);
LocalTensor<float> dots(TPosition::VECCALC,29984,128);
LocalTensor<float> z(TPosition::VECCALC,29984,128);
LocalTensor<float> u(TPosition::VECCALC,30528,128);
LocalTensor<float> denominator(TPosition::VECCALC,31040,128);
LocalTensor<half> output(TPosition::VECCALC,31552,128);
LocalTensor<uint16_t> outputMask(TPosition::VECCALC,32000,16);
LocalTensor<half> packedOutput(TPosition::VECCALC,32032,128);
LocalTensor<int32_t> gatherIndices(TPosition::VECCALC,32288,64);
LocalTensor<uint32_t> gatherOffsets(TPosition::VECCALC,32288,64);
GlobalTensor<int8_t> ag,bg;
GlobalTensor<float> sg;
GlobalTensor<int64_t> gg;
GlobalTensor<half> yg;
ag.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
bg.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(w));
sg.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scale));
gg.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups));
yg.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y));
DataCopyExtParams aCopy{1,static_cast<uint32_t>(s.m*s.k),0,0,0};
DataCopyExtParams bCopy{1,static_cast<uint32_t>(weightBytes),0,0,0};
DataCopyExtParams sCopy{static_cast<uint16_t>(s.e),static_cast<uint32_t>(s.n*4),0,0,0};
DataCopyExtParams gCopy{1,static_cast<uint32_t>(s.e*8),0,0,0};
DataCopyPad(a,ag,aCopy,DataCopyPadExtParams<int8_t>{true,0,static_cast<uint8_t>(32-s.m*s.k),0});
DataCopyPad(raw,bg,bCopy,DataCopyPadExtParams<int8_t>{true,0,static_cast<uint8_t>(paddedWeightBytes-weightBytes),0});
DataCopyPad(scales,sg,sCopy,DataCopyPadExtParams<float>{true,0,static_cast<uint8_t>(8-s.n),0});
DataCopyPad(endpoints,gg,gCopy,DataCopyPadExtParams<int64_t>{false,0,0,0});
Duplicate(dots,0.0f,count);
Duplicate(outputMask,uint16_t((uint32_t(1)<<s.n)-1),16);
Duplicate(expandedB,half(0),s.m*s.k*16);
 
#pragma unroll
for(int lane=0;lane<8;++lane) gatherIndices.SetValue(lane,int32_t(lane*2));
SetFlag<HardEvent::S_V>(EVENT_ID0);
WaitFlag<HardEvent::S_V>(EVENT_ID0);
Adds(gatherIndices[8],gatherIndices,int32_t(16),8);
PipeBarrier<PIPE_V>();
for(int reduction=1;reduction<s.k;++reduction) {
Adds(gatherIndices[reduction*16],gatherIndices,int32_t(reduction*s.n*2),16);
PipeBarrier<PIPE_V>();
}
PipeBarrier<PIPE_ALL>();
#define GMM_TINY_INT_VEC(...) do { __VA_ARGS__; PipeBarrier<PIPE_V>(); } while(false)
 
GMM_TINY_INT_VEC(Cast(packedHalf,packedInputs,RoundMode::CAST_NONE,paddedWeightBytes+32));
 
GMM_TINY_INT_VEC(Brcb(broadcastA,packedHalf,uint8_t((s.m*s.k+7)/8),BrcbRepeatParams{1,8}));
uint64_t gatherMask[2]={0,0};
for(int reduction=0;reduction<s.k;++reduction)
gatherMask[0]|=((uint64_t(1)<<s.n)-1)<<(reduction*16);
int start=0;
for(int expert=0;expert<s.e;++expert) {
const int end=static_cast<int>(endpoints.GetValue(expert));
for(int row=start;row<end;++row) {
Gather(expandedB[row*s.k*16],weightHalf,gatherOffsets,
uint32_t(expert*s.k*s.n*2),gatherMask,1,8);
}
start=end;
}
PipeBarrier<PIPE_ALL>();
SetMaskNorm();
SetVectorMask<half>(0,uint64_t(0xffff));
const BinaryRepeatParams mixedRows{1,1,1,2,uint8_t(s.k),uint8_t(s.k)};
for(int reduction=0;reduction<s.k;++reduction) {
GMM_TINY_INT_VEC(MulAddDst<float,half,false>(dots,broadcastA[reduction*16],
expandedB[reduction*16],uint64_t(16),uint8_t(s.m),mixedRows));
}
SetVectorMask<float>(0,uint64_t(0xff));
const BinaryRepeatParams scaleRows{1,1,1,2,2,0};
start=0;
for(int expert=0;expert<s.e;++expert) {
const int end=static_cast<int>(endpoints.GetValue(expert));
if(start<end)
GMM_TINY_INT_VEC(Mul<float,false>(z[start*16],z[start*16],scales[expert*8],
uint64_t(8),uint8_t(end-start),scaleRows));
start=end;
}
const UnaryRepeatParams sameWidth{1,1,8,8};
const BinaryRepeatParams sameBinary{1,1,1,8,8,8};
SetMaskCount();
SetVectorMask<float,MaskMode::COUNTER>(0,uint64_t(count));
GMM_TINY_INT_VEC(Mul<float,false>(u,z,z,uint64_t(count),1,sameBinary));
GMM_TINY_INT_VEC(Muls<float,false>(u,u,-0.0713548162726003f,uint64_t(count),1,sameWidth));
GMM_TINY_INT_VEC(Adds<float,false>(u,u,-1.5957691216057308f,uint64_t(count),1,sameWidth));
GMM_TINY_INT_VEC(Mul<float,false>(u,u,z,uint64_t(count),1,sameBinary));
GMM_TINY_INT_VEC(Mins<float,false>(u,u,80.0f,uint64_t(count),1,sameWidth));
GMM_TINY_INT_VEC(Exp<float,false>(u,u,uint64_t(count),1,sameWidth));
GMM_TINY_INT_VEC(Adds<float,false>(denominator,u,1.0f,uint64_t(count),1,sameWidth));
GMM_TINY_INT_VEC(Div<float,false>(z,z,denominator,uint64_t(count),1,sameBinary));
SetMaskNorm();
ResetMask();
GMM_TINY_INT_VEC(Cast(output,z,RoundMode::CAST_RINT,count));
uint64_t packedCount=0;
GMM_TINY_INT_VEC(GatherMask(packedOutput,output,outputMask,true,uint32_t(count),
GatherMaskParams{1,1,8,0},packedCount));
#undef GMM_TINY_INT_VEC
PipeBarrier<PIPE_ALL>();
DataCopyExtParams outCopy{1,static_cast<uint32_t>(s.m*s.n*2),0,0,0};
DataCopyPad(yg,packedOutput,outCopy);
PipeBarrier<PIPE_ALL>();
}


 
 
template<int tileM,int tileN>
__global__ __aicore__ void GroupedMatmulGelu(
GM_ADDR x,GM_ADDR w,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,
GM_ADDR scratch,GM_ADDR workspace,int64_t workspacePerCore,
GM_ADDR tilingGm,Shape s,int cores) {
KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);

const int vectorCapacity=8192;
TCubeTiling tiling;
auto* dst=reinterpret_cast<uint32_t*>(&tiling);
auto* src=reinterpret_cast<__gm__ uint32_t*>(tilingGm);
for(uint32_t i=0;i<sizeof(TCubeTiling)/sizeof(uint32_t);++i) dst[i]=src[i];
int core=GetBlockIdx();
if ASCEND_IS_AIV { core/=2; }
GM_ADDR sys=workspace+int64_t(core)*workspacePerCore;
SetSysWorkspaceForce(sys);
clearWorkspace(sys);
TPipe pipe;
MM mm;
REGIST_MATMUL_OBJ(&pipe,sys,mm,&tiling);
 
core=GetBlockIdx();
cores*=2;

GlobalTensor<int8_t> aGm,bGm;
GlobalTensor<int32_t> cGm;
GlobalTensor<float> scaleGm;
GlobalTensor<int64_t> groupGm;
GlobalTensor<half> yGm;
aGm.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
bGm.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(w));
cGm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(scratch)+int64_t(core)*TM*tileN);
scaleGm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scale));
groupGm.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups));
yGm.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y));
TBuf<TPosition::VECCALC> cb,sb,ub,tb,db,hb;
pipe.InitBuffer(cb,vectorCapacity*4); pipe.InitBuffer(sb,vectorCapacity*4);
pipe.InitBuffer(ub,vectorCapacity*4);
pipe.InitBuffer(tb,vectorCapacity*4); pipe.InitBuffer(db,vectorCapacity*4);
pipe.InitBuffer(hb,vectorCapacity*2);
auto ci=cb.Get<int32_t>(); auto sc=sb.Get<float>();
auto z=cb.Get<float>(); auto u=ub.Get<float>();
auto t=tb.Get<float>(); auto den=db.Get<float>();
auto out=hb.Get<half>();
int start=0,base=0;
for(int e=0;e<s.e;++e) {
const int end=static_cast<int>(groupGm.GetValue(e));
const int tasks=CeilDiv(end-start,tileM)*CeilDiv(s.n,tileN);
for(int task=FirstTask(core,cores,base);task<tasks;task+=cores) {
const Tile tile=MakeTile(start,end,s.n,task,tileM,tileN);
const int vectorN=CeilDiv(tile.cols,64)*64;
const int batchRows=vectorCapacity/vectorN;
 
 
mm.SetOrgShape(s.m,s.n,s.k,s.k,tileN);
mm.SetSingleShape(tile.rows,tile.cols,s.k);
mm.SetTensorA(aGm[AOffset(tile.row,s.k)]);
mm.SetTensorB(bGm[BOffset(e,s.k,s.n,tile.col)]);
mm.IterateAll(cGm);
mm.End();
PipeBarrier<PIPE_ALL>();
Duplicate(sc,0.0f,vectorCapacity);
PipeBarrier<PIPE_ALL>();
DataCopyExtParams fpCopy{1,static_cast<uint32_t>(tile.cols*4),0,0,0};
DataCopyPadExtParams<float> fpPad{false,0,0,0};
 
DataCopyPad(sc,scaleGm[int64_t(e)*s.n+tile.col],fpCopy,fpPad);
PipeBarrier<PIPE_ALL>();
for(int row=0;row<tile.rows;row+=batchRows) {
const int rows=Min(batchRows,tile.rows-row);
const int count=rows*vectorN;
Duplicate(ci,int32_t(0),vectorCapacity);
PipeBarrier<PIPE_ALL>();
DataCopyPadExtParams<int32_t> intPad{false,0,0,0};
 
 
const int intAligned=CeilDiv(tile.cols,8)*8;
DataCopyExtParams cCopy{static_cast<uint16_t>(rows),
static_cast<uint32_t>(tile.cols*4),
static_cast<uint32_t>((tileN-tile.cols)*4),
static_cast<uint32_t>((vectorN-intAligned)/8),0};
DataCopyPad(ci,cGm[row*tileN],cCopy,intPad);
PipeBarrier<PIPE_ALL>();
#define GMM_VEC(call) do { call; PipeBarrier<PIPE_V>(); } while(false)
GMM_VEC(Cast(z,ci,RoundMode::CAST_NONE,count));
BinaryRepeatParams broadcastScale{1,1,1,
static_cast<uint8_t>(vectorN/8),static_cast<uint8_t>(vectorN/8),0};
for(int col=0;col<vectorN;col+=64)
Mul(z[col],z[col],sc[col],uint64_t(64),static_cast<uint8_t>(rows),broadcastScale);
PipeBarrier<PIPE_V>();
GMM_VEC(Mul(u,z,z,count));
GMM_VEC(Muls(u,u,0.044715f,count));
GMM_VEC(Adds(u,u,1.0f,count));
GMM_VEC(Mul(u,u,z,count));
GMM_VEC(Muls(u,u,1.5957691216057308f,count));
 
 
GMM_VEC(Muls(u,u,-1.0f,count));
GMM_VEC(Mins(u,u,80.0f,count));
GMM_VEC(Exp(u,u,count));
GMM_VEC(Adds(den,u,1.0f,count));
GMM_VEC(Div(z,z,den,count));
GMM_VEC(Cast(out,z,RoundMode::CAST_RINT,count));
#undef GMM_VEC
PipeBarrier<PIPE_ALL>();
const int halfAligned=CeilDiv(tile.cols,16)*16;
DataCopyExtParams outCopy{static_cast<uint16_t>(rows),
static_cast<uint32_t>(tile.cols*2),
static_cast<uint32_t>((vectorN-halfAligned)/16),
static_cast<uint32_t>((s.n-tile.cols)*2),0};
DataCopyPad(yGm[int64_t(tile.row+row)*s.n+tile.col],out,outCopy);
 
PipeBarrier<PIPE_ALL>();
}
}
base+=tasks; start=end;
}
}

 
struct HCWorkCursor {
int expert=0,start=0,end=0,base=0,task=0,tasks=0;
bool loaded=false;
__aicore__ inline bool Next(const GlobalTensor<int64_t>& groups,Shape s,
int worker,int workers,Tile& tile,int& selectedExpert) {
while(expert<s.e) {
if(!loaded) {
end=static_cast<int>(groups.GetValue(expert));
tasks=CeilDiv(end-start,128)*CeilDiv(s.n,512);
task=FirstTask(worker,workers,base); loaded=true;
}
if(task<tasks) {
tile=MakeTile(start,end,s.n,task,128,512);
selectedExpert=expert; task+=workers; return true;
}
start=end; base+=tasks; ++expert; loaded=false;
}
return false;
}
};

template<bool lookAhead>
__global__ __aicore__ void HCAsyncGroupedMatmulGelu(
GM_ADDR x,GM_ADDR w,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,
GM_ADDR scratch,GM_ADDR workspace,int64_t workspacePerCore,
GM_ADDR tilingGm,Shape s,int cores) {
KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);

constexpr int tileM=128,tileN=512;
const int vectorCapacity=8192;
TCubeTiling tiling;
auto* dst=reinterpret_cast<uint32_t*>(&tiling);
auto* src=reinterpret_cast<__gm__ uint32_t*>(tilingGm);
for(uint32_t i=0;i<sizeof(TCubeTiling)/sizeof(uint32_t);++i) dst[i]=src[i];
int core=GetBlockIdx();
if ASCEND_IS_AIV { core/=2; }
GM_ADDR sys=workspace+int64_t(core)*workspacePerCore;
SetSysWorkspaceForce(sys);
clearWorkspace(sys);
TPipe pipe;
MM mm;
REGIST_MATMUL_OBJ(&pipe,sys,mm,&tiling);
 
core=GetBlockIdx();
cores*=2;

GlobalTensor<int8_t> aGm,bGm;
GlobalTensor<int32_t> cGm;
GlobalTensor<float> scaleGm;
GlobalTensor<int64_t> groupGm;
GlobalTensor<half> yGm;
aGm.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
bGm.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(w));
cGm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(scratch)+int64_t(core)*2*tileM*tileN);
scaleGm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scale));
groupGm.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups));
yGm.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y));
TBuf<TPosition::VECCALC> cb,sb,ub,tb,db,hb;
pipe.InitBuffer(cb,vectorCapacity*4); pipe.InitBuffer(sb,vectorCapacity*4);
pipe.InitBuffer(ub,vectorCapacity*4);
pipe.InitBuffer(tb,vectorCapacity*4); pipe.InitBuffer(db,vectorCapacity*4);
pipe.InitBuffer(hb,vectorCapacity*2);
auto ci=cb.Get<int32_t>(); auto sc=sb.Get<float>();
auto z=cb.Get<float>(); auto u=ub.Get<float>();
auto t=tb.Get<float>(); auto den=db.Get<float>();
auto out=hb.Get<half>();
HCWorkCursor cursor;
Tile current;
int currentExpert=0,currentSlot=0;
if(!cursor.Next(groupGm,s,core,cores,current,currentExpert)) return;
#define HC_SUBMIT(T,E,SLOT) do {     mm.SetOrgShape(s.m,s.n,s.k,s.k,tileN);     mm.SetSingleShape((T).rows,(T).cols,s.k);     mm.SetTensorA(aGm[AOffset((T).row,s.k)]);     mm.SetTensorB(bGm[BOffset((E),s.k,s.n,(T).col)]);     mm.IterateAll<false>(cGm[(SLOT)*tileM*tileN],0,false,true); } while(false)
HC_SUBMIT(current,currentExpert,currentSlot);
while(true) {
mm.WaitIterateAll();
mm.End();
const Tile tile=current;
const int e=currentExpert;
const int vectorN=CeilDiv(tile.cols,64)*64;
const int batchRows=vectorCapacity/vectorN;
Tile next; int nextExpert=0;
const bool hasNext=cursor.Next(groupGm,s,core,cores,next,nextExpert);
if constexpr(lookAhead) {
if(hasNext) HC_SUBMIT(next,nextExpert,currentSlot^1);
}
PipeBarrier<PIPE_ALL>();
Duplicate(sc,0.0f,vectorCapacity);
PipeBarrier<PIPE_ALL>();
DataCopyExtParams fpCopy{1,static_cast<uint32_t>(tile.cols*4),0,0,0};
DataCopyPadExtParams<float> fpPad{false,0,0,0};
 
DataCopyPad(sc,scaleGm[int64_t(e)*s.n+tile.col],fpCopy,fpPad);
PipeBarrier<PIPE_ALL>();
for(int row=0;row<tile.rows;row+=batchRows) {
const int rows=Min(batchRows,tile.rows-row);
const int count=rows*vectorN;
Duplicate(ci,int32_t(0),vectorCapacity);
PipeBarrier<PIPE_ALL>();
DataCopyPadExtParams<int32_t> intPad{false,0,0,0};
 
 
const int intAligned=CeilDiv(tile.cols,8)*8;
DataCopyExtParams cCopy{static_cast<uint16_t>(rows),
static_cast<uint32_t>(tile.cols*4),
static_cast<uint32_t>((tileN-tile.cols)*4),
static_cast<uint32_t>((vectorN-intAligned)/8),0};
DataCopyPad(ci,cGm[currentSlot*tileM*tileN+row*tileN],cCopy,intPad);
PipeBarrier<PIPE_ALL>();
#define GMM_VEC(call) do { call; PipeBarrier<PIPE_V>(); } while(false)
GMM_VEC(Cast(z,ci,RoundMode::CAST_NONE,count));
BinaryRepeatParams broadcastScale{1,1,1,
static_cast<uint8_t>(vectorN/8),static_cast<uint8_t>(vectorN/8),0};
for(int col=0;col<vectorN;col+=64)
Mul(z[col],z[col],sc[col],uint64_t(64),static_cast<uint8_t>(rows),broadcastScale);
PipeBarrier<PIPE_V>();
GMM_VEC(Mul(u,z,z,count));
GMM_VEC(Muls(u,u,0.044715f,count));
GMM_VEC(Adds(u,u,1.0f,count));
GMM_VEC(Mul(u,u,z,count));
GMM_VEC(Muls(u,u,1.5957691216057308f,count));
 
 
GMM_VEC(Muls(u,u,-1.0f,count));
GMM_VEC(Mins(u,u,80.0f,count));
GMM_VEC(Exp(u,u,count));
GMM_VEC(Adds(den,u,1.0f,count));
GMM_VEC(Div(z,z,den,count));
GMM_VEC(Cast(out,z,RoundMode::CAST_RINT,count));
#undef GMM_VEC
PipeBarrier<PIPE_ALL>();
const int halfAligned=CeilDiv(tile.cols,16)*16;
DataCopyExtParams outCopy{static_cast<uint16_t>(rows),
static_cast<uint32_t>(tile.cols*2),
static_cast<uint32_t>((vectorN-halfAligned)/16),
static_cast<uint32_t>((s.n-tile.cols)*2),0};
DataCopyPad(yGm[int64_t(tile.row+row)*s.n+tile.col],out,outCopy);
 
PipeBarrier<PIPE_ALL>();
}
if constexpr(!lookAhead) {
if(hasNext) HC_SUBMIT(next,nextExpert,currentSlot^1);
}
if(!hasNext) break;
current=next; currentExpert=nextExpert; currentSlot^=1;
}
#undef HC_SUBMIT
}

 
template<int tileM,int tileN>
__global__ __aicore__ void NativeSmallGroupedMatmulGelu(
GM_ADDR x,GM_ADDR w,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,
GM_ADDR scratch,uint64_t syncBase,Shape s,int cores) {
KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_1);
SetSyncBaseAddr(syncBase);

const int vectorCapacity=1024;
const int core=GetBlockIdx();
const int paddedK=CeilDiv(s.k,32)*32;
TPipe pipe;
TBuf<TPosition::A1> a1buf;
TBuf<TPosition::B1> b1buf;
TBuf<TPosition::A2> a2buf;
TBuf<TPosition::B2> b2buf;
TBuf<TPosition::CO1> cbuf;
if ASCEND_IS_AIC {
pipe.InitBuffer(a1buf,16*256);
pipe.InitBuffer(b1buf,256*64);
pipe.InitBuffer(a2buf,16*256);
pipe.InitBuffer(b2buf,256*64);
pipe.InitBuffer(cbuf,16*64*4);
}

GlobalTensor<int8_t> aGm,bGm;
GlobalTensor<int32_t> cGm;
GlobalTensor<float> scaleGm;
GlobalTensor<int64_t> groupGm;
GlobalTensor<half> yGm;
aGm.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
bGm.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(w));
cGm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(scratch)+int64_t(core)*2*TM*tileN);
scaleGm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scale));
groupGm.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups));
yGm.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y));
TBuf<TPosition::VECCALC> cb,sb,ub,tb,db,hb;
if ASCEND_IS_AIV {
pipe.InitBuffer(cb,vectorCapacity*4); pipe.InitBuffer(sb,vectorCapacity*4);
pipe.InitBuffer(ub,vectorCapacity*4);
pipe.InitBuffer(tb,vectorCapacity*4); pipe.InitBuffer(db,vectorCapacity*4);
pipe.InitBuffer(hb,vectorCapacity*2);
}
int tileOrdinal=0;
int start=0,base=0;
for(int e=0;e<s.e;++e) {
const int end=static_cast<int>(groupGm.GetValue(e));
const int tasks=CeilDiv(end-start,tileM)*CeilDiv(s.n,tileN);
for(int task=FirstTask(core,cores,base);task<tasks;task+=cores) {
const Tile tile=MakeTile(start,end,s.n,task,tileM,tileN);
const int vectorN=CeilDiv(tile.cols,64)*64;
const int batchRows=vectorCapacity/vectorN;
 
 
const int scratchSlot=tileOrdinal&1;
if ASCEND_IS_AIC {
if(tileOrdinal>=2) CrossCoreWaitFlag(scratchSlot?7:5);
auto a1=a1buf.Get<int8_t>(); auto b1=b1buf.Get<int8_t>();
auto a2=a2buf.Get<int8_t>(); auto b2=b2buf.Get<int8_t>();
auto c=cbuf.Get<int32_t>();
 
InitConstValueParams<uint16_t> zeroA;
zeroA.repeatTimes=1; zeroA.blockNum=16*paddedK/32;
zeroA.dstGap=0; zeroA.initValue=0;
InitConstValue(a1buf.Get<uint16_t>(),zeroA);
InitConstValueParams<uint16_t> zeroB;
zeroB.repeatTimes=1; zeroB.blockNum=paddedK*64/32;
zeroB.dstGap=0; zeroB.initValue=0;
InitConstValue(b1buf.Get<uint16_t>(),zeroB);
PipeBarrier<PIPE_ALL>();
Nd2NzParams ac;
ac.ndNum=1; ac.nValue=tile.rows; ac.dValue=s.k;
ac.srcNdMatrixStride=0; ac.srcDValue=s.k;
ac.dstNzC0Stride=16; ac.dstNzNStride=1; ac.dstNzMatrixStride=0;
DataCopy(a1,aGm[AOffset(tile.row,s.k)],ac);
Nd2NzParams bc;
bc.ndNum=1; bc.nValue=s.k; bc.dValue=tile.cols;
bc.srcNdMatrixStride=0; bc.srcDValue=s.n;
bc.dstNzC0Stride=paddedK; bc.dstNzNStride=1; bc.dstNzMatrixStride=0;
DataCopy(b1,bGm[BOffset(e,s.k,s.n,tile.col)],bc);
PipeBarrier<PIPE_ALL>();
LoadData2dParams la;
la.startIndex=0; la.repeatTimes=paddedK/32;
la.srcStride=1; la.dstGap=0; la.ifTranspose=false;
LoadData(a2,a1,la);
 
 
LoadData2dTransposeParams lb{0,2,static_cast<uint16_t>(paddedK/32),1,0,inc};
for(int kb=0;kb<paddedK/32;++kb)
LoadDataWithTranspose(b2[kb*64*32],b1[kb*32*32],lb);
PipeBarrier<PIPE_ALL>();
MmadParams mad;
mad.m=16; mad.n=64; mad.k=paddedK; mad.cmatrixInitVal=true;
Mmad(c,a2,b2,mad);
PipeBarrier<PIPE_ALL>();
FixpipeParamsV220 fp;
fp.nSize=64; fp.mSize=16; fp.srcStride=16; fp.dstStride=64;
Fixpipe<int32_t,int32_t,CFG_ROW_MAJOR>(cGm[scratchSlot*TM*tileN],c,fp);
CrossCoreSetFlag<2,PIPE_FIX>(scratchSlot?6:4);
}
if ASCEND_IS_AIV {
CrossCoreWaitFlag(scratchSlot?6:4);
auto ci=cb.Get<int32_t>(); auto sc=sb.Get<float>();
auto z=cb.Get<float>(); auto u=ub.Get<float>();
auto t=tb.Get<float>(); auto den=db.Get<float>();
auto out=hb.Get<half>();
PipeBarrier<PIPE_ALL>();
Duplicate(sc,0.0f,vectorCapacity);
PipeBarrier<PIPE_ALL>();
DataCopyExtParams fpCopy{1,static_cast<uint32_t>(tile.cols*4),0,0,0};
DataCopyPadExtParams<float> fpPad{false,0,0,0};
for(int r=0;r<batchRows;++r)
DataCopyPad(sc[r*vectorN],scaleGm[int64_t(e)*s.n+tile.col],fpCopy,fpPad);
PipeBarrier<PIPE_ALL>();
for(int row=0;row<tile.rows;row+=batchRows) {
const int rows=Min(batchRows,tile.rows-row);
const int count=rows*vectorN;
Duplicate(ci,int32_t(0),vectorCapacity);
PipeBarrier<PIPE_ALL>();
DataCopyPadExtParams<int32_t> intPad{false,0,0,0};
for(int r=0;r<rows;++r)
DataCopyPad(ci[r*vectorN],cGm[scratchSlot*TM*tileN+(row+r)*tileN],fpCopy,intPad);
PipeBarrier<PIPE_ALL>();
#define GMM_VEC(call) do { call; PipeBarrier<PIPE_V>(); } while(false)
GMM_VEC(Cast(z,ci,RoundMode::CAST_NONE,count));
GMM_VEC(Mul(z,z,sc,count));
GMM_VEC(Mul(u,z,z,count));
GMM_VEC(Muls(u,u,0.044715f,count));
GMM_VEC(Adds(u,u,1.0f,count));
GMM_VEC(Mul(u,u,z,count));
GMM_VEC(Muls(u,u,1.5957691216057308f,count));
 
 
GMM_VEC(Muls(u,u,-1.0f,count));
GMM_VEC(Mins(u,u,80.0f,count));
GMM_VEC(Exp(u,u,count));
GMM_VEC(Adds(den,u,1.0f,count));
GMM_VEC(Div(z,z,den,count));
GMM_VEC(Cast(out,z,RoundMode::CAST_RINT,count));
#undef GMM_VEC
PipeBarrier<PIPE_ALL>();
DataCopyExtParams outCopy{1,static_cast<uint32_t>(tile.cols*2),0,0,0};
for(int r=0;r<rows;++r)
DataCopyPad(yGm[int64_t(tile.row+row+r)*s.n+tile.col],out[r*vectorN],outCopy);
 
PipeBarrier<PIPE_ALL>();
}
CrossCoreSetFlag<2,PIPE_MTE3>(scratchSlot?7:5);
}
++tileOrdinal;
}
base+=tasks; start=end;
}
if ASCEND_IS_AIC {
if(tileOrdinal>0) CrossCoreWaitFlag(5);
if(tileOrdinal>1) CrossCoreWaitFlag(7);
}
}

 
constexpr auto REF_CONFIG=::CFG_MDL;
using RefMM=matmul::MatmulImpl<
matmul::MatmulType<TPosition::GM,::CubeFormat::ND,int8_t>,
matmul::MatmulType<TPosition::GM,::CubeFormat::ND,int8_t>,
matmul::MatmulType<TPosition::GM,::CubeFormat::ND,int32_t>,
matmul::MatmulType<TPosition::GM,::CubeFormat::ND,int32_t>,REF_CONFIG>;

__global__ __aicore__ void RefFourRingGroupedMatmulGelu(
GM_ADDR x,GM_ADDR w,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,
GM_ADDR scratch,GM_ADDR workspace,int64_t workspacePerCore,
GM_ADDR tilingGm,uint64_t syncBase,Shape s,int cores,int macroN) {
KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
SetSyncBaseAddr(syncBase);
int core=GetBlockIdx();
if ASCEND_IS_AIV { core/=2; }
const int sub=GetSubBlockIdx();
TPipe pipe;
TCubeTiling tiling;
RefMM mm;
if ASCEND_IS_AIC {
auto* dst=reinterpret_cast<uint32_t*>(&tiling);
auto* src=reinterpret_cast<__gm__ uint32_t*>(tilingGm);
for(uint32_t i=0;i<sizeof(TCubeTiling)/sizeof(uint32_t);++i) dst[i]=src[i];
GM_ADDR sys=workspace+int64_t(core)*workspacePerCore;
SetSysWorkspaceForce(sys);
clearWorkspace(sys);
mm.SetSubBlockIdx(0);
mm.Init(&tiling,&pipe);
}
GlobalTensor<int8_t> ag,bg;
GlobalTensor<int32_t> cg;
GlobalTensor<float> sg;
GlobalTensor<int64_t> gg;
GlobalTensor<half> yg;
ag.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
bg.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(w));
cg.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(scratch));
sg.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scale));
gg.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups));
yg.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y));
TBuf<TPosition::VECCALC> cb,zb,ub,db,sb,hb;
if ASCEND_IS_AIV {
pipe.InitBuffer(cb,8192*4); pipe.InitBuffer(zb,8192*4);
pipe.InitBuffer(ub,8192*4); pipe.InitBuffer(db,8192*4);
pipe.InitBuffer(sb,256*4); pipe.InitBuffer(hb,8192*2);
}
bool outputPending=false;
int start=0,base=0,ordinal=0;
for(int e=0;e<s.e;++e) {
const int end=static_cast<int>(gg.GetValue(e));
const int tasks=CeilDiv(end-start,64)*CeilDiv(s.n,macroN);
for(int task=FirstTask(core,cores,base);task<tasks;task+=cores) {
const Tile tile=MakeTile(start,end,s.n,task,64,macroN);
if ASCEND_IS_AIC {
mm.SetOrgShape(s.m,s.n,s.k);
mm.SetSingleShape(tile.rows,tile.cols,s.k);
mm.SetTensorA(ag[AOffset(tile.row,s.k)]);
mm.SetTensorB(bg[BOffset(e,s.k,s.n,tile.col)]);
while(mm.Iterate()) {
const int slot=ordinal%4;
if(ordinal>=4) CrossCoreWaitFlag(5);
const int64_t offset=(int64_t(slot)*cores+core)*64*256;
mm.GetTensorC(cg[offset],0,true);
CrossCoreSetFlag<2,PIPE_FIX>(4);
++ordinal;
}
mm.End();
}
if ASCEND_IS_AIV {
auto ci=cb.Get<int32_t>(); auto z=zb.Get<float>();
auto u=ub.Get<float>(); auto den=db.Get<float>();
auto sc=sb.Get<float>(); auto out=hb.Get<half>();
const int halfRows=(tile.rows+1)/2;
const int rowOffset=sub*halfRows;
const int rows=Min(halfRows,tile.rows-rowOffset);
for(int colOffset=0;colOffset<tile.cols;colOffset+=256) {
const int cols=Min(256,tile.cols-colOffset);
const int count=rows*cols;
const int slot=ordinal%4;
const int64_t offset=(int64_t(slot)*cores+core)*64*256;
if(rows>0) {
DataCopyExtParams scaleCopy{1,static_cast<uint32_t>(cols*4),0,0,0};
DataCopyPad(sc,sg[int64_t(e)*s.n+tile.col+colOffset],scaleCopy,
DataCopyPadExtParams<float>{false,0,0,0});
}
CrossCoreWaitFlag(4);
if(rows>0) {
 
DataCopyExtParams inputCopy{1,static_cast<uint32_t>(rows*cols*4),0,0,0};
DataCopyPad(ci,cg[offset+int64_t(rowOffset)*cols],inputCopy,
DataCopyPadExtParams<int32_t>{false,0,0,0});
}
 
 
CrossCoreSetFlag<2,PIPE_MTE2>(5);
if(rows>0) {
SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
Cast(z,ci,RoundMode::CAST_NONE,count); PipeBarrier<PIPE_V>();
BinaryRepeatParams br{1,1,1,static_cast<uint8_t>(cols/8),
static_cast<uint8_t>(cols/8),0};
for(int c=0;c<cols;c+=64)
Mul(z[c],z[c],sc[c],static_cast<uint64_t>(Min(64,cols-c)),
static_cast<uint8_t>(rows),br);
PipeBarrier<PIPE_V>();
#define REF_VEC(call) do { call; PipeBarrier<PIPE_V>(); } while(false)
REF_VEC(Mul(u,z,z,count));
REF_VEC(Muls(u,u,0.044715f,count));
REF_VEC(Adds(u,u,1.0f,count));
REF_VEC(Mul(u,u,z,count));
REF_VEC(Muls(u,u,1.5957691216057308f,count));
REF_VEC(Muls(u,u,-1.0f,count));
REF_VEC(Mins(u,u,80.0f,count));
REF_VEC(Exp(u,u,count));
REF_VEC(Adds(den,u,1.0f,count));
REF_VEC(Div(z,z,den,count));
if(outputPending) { WaitFlag<HardEvent::MTE3_V>(EVENT_ID0); outputPending=false; }
REF_VEC(Cast(out,z,RoundMode::CAST_RINT,count));
#undef REF_VEC
SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
DataCopyExtParams outputCopy{static_cast<uint16_t>(rows),
static_cast<uint32_t>(cols*2),0,
static_cast<uint32_t>((s.n-cols)*2),0};
if(cols==s.n) {
outputCopy.blockCount=1;
outputCopy.blockLen=static_cast<uint32_t>(rows*cols*2);
}
DataCopyPad(yg[int64_t(tile.row+rowOffset)*s.n+tile.col+colOffset],
out,outputCopy);
SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
outputPending=true;
SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
}
++ordinal;
}
}
}
start=end; base+=tasks;
}
if ASCEND_IS_AIV {
if(outputPending) WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
}
if ASCEND_IS_AIC {
for(int i=0;i<Min(ordinal,4);++i) CrossCoreWaitFlag(5);
}
}

struct HDMWaitSlot {
__aicore__ inline void operator()() const { CrossCoreWaitFlag(5); }
};
struct HDMPublishSlot {
__aicore__ inline void operator()() const { CrossCoreSetFlag<2,PIPE_FIX>(4); }
};
__aicore__ inline void HDMCatlassProduce(Catlass::Arch::Resource<Catlass::Arch::AtlasA2>& resource,
GM_ADDR x,GM_ADDR w,GM_ADDR groups,
GM_ADDR scratch,Shape s,int core,int cores) {
using ArchTag=Catlass::Arch::AtlasA2;
using Policy=Catlass::Gemm::MmadAtlasA2PreloadAsyncWithCallback<1,2,2,2,1,false,true>;
using AType=Catlass::Gemm::GemmType<int8_t,Catlass::layout::RowMajor>;
using BType=Catlass::Gemm::GemmType<int8_t,Catlass::layout::RowMajor>;
using CType=Catlass::Gemm::GemmType<int32_t,Catlass::layout::RowMajor>;
using Block=Catlass::Gemm::Block::BlockMmad<Policy,
Catlass::GemmShape<64,256,512>,Catlass::GemmShape<64,256,128>,AType,BType,CType>;
Block block(resource);
GlobalTensor<int8_t> ag,bg;
GlobalTensor<int32_t> cg;
GlobalTensor<int64_t> gg;
ag.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
bg.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(w));
cg.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(scratch));
gg.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups));
HDMWaitSlot waits[4];
HDMPublishSlot publishes[4];
int start=0,base=0,ordinal=0;
for(int e=0;e<s.e;++e) {
const int end=static_cast<int>(gg.GetValue(e));
const int tasks=CeilDiv(end-start,64);
for(int task=FirstTask(core,cores,base);task<tasks;task+=cores) {
const int row=start+task*64;
const int rows=Min(64,end-row);
for(int col=0;col<s.n;col+=256) {
const int slot=ordinal%4;
Callback before;
if(ordinal>=4) before=MakeCallback(&waits[slot]);
auto after=MakeCallback(&publishes[slot]);
const int64_t offset=(int64_t(slot)*cores+core)*64*256;
block(ag[int64_t(row)*s.k],Catlass::layout::RowMajor(rows,s.k),
bg[int64_t(e)*s.k*s.n+col],Catlass::layout::RowMajor(s.k,s.n),
cg[offset],Catlass::layout::RowMajor(rows,256),
Catlass::GemmCoord(rows,256,s.k),before,after);
++ordinal;
}
}
start=end; base+=tasks;
}
block.SynchronizeBlock();
for(int i=0;i<Min(ordinal,4);++i) CrossCoreWaitFlag(5);
}

__global__ __aicore__ void HDMCatlassGroupedMatmulGelu(
GM_ADDR x,GM_ADDR w,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,
GM_ADDR scratch,GM_ADDR workspace,int64_t workspacePerCore,
GM_ADDR tilingGm,uint64_t syncBase,Shape s,int cores,int macroN) {
KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
SetSyncBaseAddr(syncBase);
int core=GetBlockIdx();
if ASCEND_IS_AIV { core/=2; }
const int sub=GetSubBlockIdx();
Catlass::Arch::Resource<Catlass::Arch::AtlasA2> resource;
if ASCEND_IS_AIC {
HDMCatlassProduce(resource,x,w,groups,scratch,s,core,cores);
return;
}
GlobalTensor<int8_t> ag,bg;
GlobalTensor<int32_t> cg;
GlobalTensor<float> sg;
GlobalTensor<int64_t> gg;
GlobalTensor<half> yg;
ag.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
bg.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(w));
cg.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(scratch));
sg.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scale));
gg.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups));
yg.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y));
bool outputPending=false;
int start=0,base=0,ordinal=0;
for(int e=0;e<s.e;++e) {
const int end=static_cast<int>(gg.GetValue(e));
const int tasks=CeilDiv(end-start,64)*CeilDiv(s.n,macroN);
for(int task=FirstTask(core,cores,base);task<tasks;task+=cores) {
const Tile tile=MakeTile(start,end,s.n,task,64,macroN);
if ASCEND_IS_AIV {
auto ci=resource.ubBuf.GetBufferByByte<int32_t>(0); auto z=resource.ubBuf.GetBufferByByte<float>(32768);
auto u=resource.ubBuf.GetBufferByByte<float>(65536); auto den=resource.ubBuf.GetBufferByByte<float>(98304);
auto sc=resource.ubBuf.GetBufferByByte<float>(131072); auto out=resource.ubBuf.GetBufferByByte<half>(132096);
const int halfRows=(tile.rows+1)/2;
const int rowOffset=sub*halfRows;
const int rows=Min(halfRows,tile.rows-rowOffset);
for(int colOffset=0;colOffset<tile.cols;colOffset+=256) {
const int cols=Min(256,tile.cols-colOffset);
const int count=rows*cols;
const int slot=ordinal%4;
const int64_t offset=(int64_t(slot)*cores+core)*64*256;
if(rows>0) {
DataCopyExtParams scaleCopy{1,static_cast<uint32_t>(cols*4),0,0,0};
DataCopyPad(sc,sg[int64_t(e)*s.n+tile.col+colOffset],scaleCopy,
DataCopyPadExtParams<float>{false,0,0,0});
}
CrossCoreWaitFlag(4);
if(rows>0) {
 
DataCopyExtParams inputCopy{1,static_cast<uint32_t>(rows*cols*4),0,0,0};
DataCopyPad(ci,cg[offset+int64_t(rowOffset)*cols],inputCopy,
DataCopyPadExtParams<int32_t>{false,0,0,0});
}
 
 
CrossCoreSetFlag<2,PIPE_MTE2>(5);
if(rows>0) {
SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
Cast(z,ci,RoundMode::CAST_NONE,count); PipeBarrier<PIPE_V>();
BinaryRepeatParams br{1,1,1,static_cast<uint8_t>(cols/8),
static_cast<uint8_t>(cols/8),0};
for(int c=0;c<cols;c+=64)
Mul(z[c],z[c],sc[c],static_cast<uint64_t>(Min(64,cols-c)),
static_cast<uint8_t>(rows),br);
PipeBarrier<PIPE_V>();
#define REF_VEC(call) do { call; PipeBarrier<PIPE_V>(); } while(false)
REF_VEC(Mul(u,z,z,count));
REF_VEC(Muls(u,u,0.044715f,count));
REF_VEC(Adds(u,u,1.0f,count));
REF_VEC(Mul(u,u,z,count));
REF_VEC(Muls(u,u,1.5957691216057308f,count));
REF_VEC(Muls(u,u,-1.0f,count));
REF_VEC(Mins(u,u,80.0f,count));
REF_VEC(Exp(u,u,count));
REF_VEC(Adds(den,u,1.0f,count));
REF_VEC(Div(z,z,den,count));
if(outputPending) { WaitFlag<HardEvent::MTE3_V>(EVENT_ID0); outputPending=false; }
REF_VEC(Cast(out,z,RoundMode::CAST_RINT,count));
#undef REF_VEC
SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
DataCopyExtParams outputCopy{static_cast<uint16_t>(rows),
static_cast<uint32_t>(cols*2),0,
static_cast<uint32_t>((s.n-cols)*2),0};
if(cols==s.n) {
outputCopy.blockCount=1;
outputCopy.blockLen=static_cast<uint32_t>(rows*cols*2);
}
DataCopyPad(yg[int64_t(tile.row+rowOffset)*s.n+tile.col+colOffset],
out,outputCopy);
SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
outputPending=true;
SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
}
++ordinal;
}
}
}
start=end; base+=tasks;
}
if ASCEND_IS_AIV {
if(outputPending) WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
}
if ASCEND_IS_AIC {
for(int i=0;i<Min(ordinal,4);++i) CrossCoreWaitFlag(5);
}
}

__aicore__ inline void GenericNativeProduce(Catlass::Arch::Resource<Catlass::Arch::AtlasA2>& resource,
GM_ADDR x,GM_ADDR w,GM_ADDR groups,
GM_ADDR scratch,Shape s,int core,int cores) {
using ArchTag=Catlass::Arch::AtlasA2;
using Policy=Catlass::Gemm::MmadAtlasA2PreloadAsyncWithCallback<1,2,2,2,1,false,true>;
using AType=Catlass::Gemm::GemmType<int8_t,Catlass::layout::RowMajor>;
using BType=Catlass::Gemm::GemmType<int8_t,Catlass::layout::RowMajor>;
using CType=Catlass::Gemm::GemmType<int32_t,Catlass::layout::RowMajor>;
using Block=Catlass::Gemm::Block::BlockMmad<Policy,
Catlass::GemmShape<64,256,512>,Catlass::GemmShape<64,256,128>,AType,BType,CType>;
Block block(resource);
GlobalTensor<int8_t> ag,bg;
GlobalTensor<int32_t> cg;
GlobalTensor<int64_t> gg;
ag.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
bg.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(w));
cg.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(scratch));
gg.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups));
HDMWaitSlot waits[4];
HDMPublishSlot publishes[4];
int start=0,base=0,ordinal=0;
for(int e=0;e<s.e;++e) {
const int end=static_cast<int>(gg.GetValue(e));
const int tasks=CeilDiv(end-start,64)*CeilDiv(s.n,256);
for(int task=FirstTask(core,cores,base);task<tasks;task+=cores) {
const Tile tile=MakeTile(start,end,s.n,task,64,256);
const int row=tile.row,rows=tile.rows,col=tile.col,cols=tile.cols;
{
const int slot=ordinal%4;
Callback before;
if(ordinal>=4) before=MakeCallback(&waits[slot]);
auto after=MakeCallback(&publishes[slot]);
const int64_t offset=(int64_t(slot)*cores+core)*64*256;
block(ag[int64_t(row)*s.k],Catlass::layout::RowMajor(rows,s.k),
bg[int64_t(e)*s.k*s.n+col],Catlass::layout::RowMajor(s.k,s.n),
cg[offset],Catlass::layout::RowMajor(rows,256),
Catlass::GemmCoord(rows,cols,s.k),before,after);
++ordinal;
}
}
start=end; base+=tasks;
}
block.SynchronizeBlock();
for(int i=0;i<Min(ordinal,4);++i) CrossCoreWaitFlag(5);
}

__global__ __aicore__ void GenericNativeGroupedMatmulGelu(
GM_ADDR x,GM_ADDR w,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,
GM_ADDR scratch,GM_ADDR workspace,int64_t workspacePerCore,
GM_ADDR tilingGm,uint64_t syncBase,Shape s,int cores,int macroN) {
KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
SetSyncBaseAddr(syncBase);
int core=GetBlockIdx();
if ASCEND_IS_AIV { core/=2; }
const int sub=GetSubBlockIdx();
Catlass::Arch::Resource<Catlass::Arch::AtlasA2> resource;
if ASCEND_IS_AIC {
GenericNativeProduce(resource,x,w,groups,scratch,s,core,cores);
return;
}
GlobalTensor<int8_t> ag,bg;
GlobalTensor<int32_t> cg;
GlobalTensor<float> sg;
GlobalTensor<int64_t> gg;
GlobalTensor<half> yg;
ag.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
bg.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(w));
cg.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(scratch));
sg.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scale));
gg.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups));
yg.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y));
bool outputPending=false;
int start=0,base=0,ordinal=0;
for(int e=0;e<s.e;++e) {
const int end=static_cast<int>(gg.GetValue(e));
const int tasks=CeilDiv(end-start,64)*CeilDiv(s.n,256);
for(int task=FirstTask(core,cores,base);task<tasks;task+=cores) {
const Tile tile=MakeTile(start,end,s.n,task,64,256);
if ASCEND_IS_AIV {
auto ci=resource.ubBuf.GetBufferByByte<int32_t>(0); auto z=resource.ubBuf.GetBufferByByte<float>(32768);
auto u=resource.ubBuf.GetBufferByByte<float>(65536); auto den=resource.ubBuf.GetBufferByByte<float>(98304);
auto sc=resource.ubBuf.GetBufferByByte<float>(131072); auto out=resource.ubBuf.GetBufferByByte<half>(132096);
const int halfRows=(tile.rows+1)/2;
const int rowOffset=sub*halfRows;
const int rows=Min(halfRows,tile.rows-rowOffset);
for(int colOffset=0;colOffset<tile.cols;colOffset+=256) {
const int cols=Min(256,tile.cols-colOffset);
const int count=rows*256;
const int slot=ordinal%4;
const int64_t offset=(int64_t(slot)*cores+core)*64*256;
if(rows>0) {
Duplicate(sc,0.0f,256);
Duplicate(ci,int32_t(0),8192);
SetFlag<HardEvent::V_MTE2>(EVENT_ID1);
WaitFlag<HardEvent::V_MTE2>(EVENT_ID1);
DataCopyExtParams scaleCopy{1,static_cast<uint32_t>(cols*4),0,0,0};
DataCopyPad(sc,sg[int64_t(e)*s.n+tile.col+colOffset],scaleCopy,
DataCopyPadExtParams<float>{false,0,0,0});
}
CrossCoreWaitFlag(4);
if(rows>0) {
 
DataCopyExtParams inputCopy{static_cast<uint16_t>(rows),static_cast<uint32_t>(cols*4),
static_cast<uint32_t>((256-cols)*4),static_cast<uint32_t>((256-CeilDiv(cols,8)*8)/8),0};
DataCopyPad(ci,cg[offset+int64_t(rowOffset)*256],inputCopy,
DataCopyPadExtParams<int32_t>{false,0,0,0});
}
 
 
CrossCoreSetFlag<2,PIPE_MTE2>(5);
if(rows>0) {
SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
Cast(z,ci,RoundMode::CAST_NONE,count); PipeBarrier<PIPE_V>();
BinaryRepeatParams br{1,1,1,static_cast<uint8_t>(256/8),
static_cast<uint8_t>(256/8),0};
for(int c=0;c<256;c+=64)
Mul(z[c],z[c],sc[c],static_cast<uint64_t>(64),
static_cast<uint8_t>(rows),br);
PipeBarrier<PIPE_V>();
#define REF_VEC(call) do { call; PipeBarrier<PIPE_V>(); } while(false)
REF_VEC(Mul(u,z,z,count));
REF_VEC(Muls(u,u,0.044715f,count));
REF_VEC(Adds(u,u,1.0f,count));
REF_VEC(Mul(u,u,z,count));
REF_VEC(Muls(u,u,1.5957691216057308f,count));
REF_VEC(Muls(u,u,-1.0f,count));
REF_VEC(Mins(u,u,80.0f,count));
REF_VEC(Exp(u,u,count));
REF_VEC(Adds(den,u,1.0f,count));
REF_VEC(Div(z,z,den,count));
if(outputPending) { WaitFlag<HardEvent::MTE3_V>(EVENT_ID0); outputPending=false; }
REF_VEC(Cast(out,z,RoundMode::CAST_RINT,count));
#undef REF_VEC
SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
DataCopyExtParams outputCopy{static_cast<uint16_t>(rows),
static_cast<uint32_t>(cols*2),static_cast<uint32_t>((256-CeilDiv(cols,16)*16)/16),
static_cast<uint32_t>((s.n-cols)*2),0};
if(cols==256 && cols==s.n) {
outputCopy.blockCount=1;
outputCopy.blockLen=static_cast<uint32_t>(rows*cols*2);
}
DataCopyPad(yg[int64_t(tile.row+rowOffset)*s.n+tile.col+colOffset],
out,outputCopy);
SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
outputPending=true;
SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
}
++ordinal;
}
}
}
start=end; base+=tasks;
}
if ASCEND_IS_AIV {
if(outputPending) WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
}
if ASCEND_IS_AIC {
for(int i=0;i<Min(ordinal,4);++i) CrossCoreWaitFlag(5);
