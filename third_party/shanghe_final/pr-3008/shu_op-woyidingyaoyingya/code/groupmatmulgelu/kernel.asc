const bool smallGemm=work<=8388608;
const bool deepReduction=s.k>=4096;
const bool expertBatches=s.e>=16;
const bool alignedExperts=expertBatches && s.k%32==0 && s.n%32==0;
const int tileM=smallGemm?32:((deepReduction || alignedExperts)?64:128);
const int tileN=smallGemm?128:(alignedExperts?1024:(deepReduction?256:512));
matmul_tiling::MatmulApiTiling api(*platform);
api.SetAType(matmul_tiling::TPosition::GM,matmul_tiling::CubeFormat::ND,matmul_tiling::DataType::DT_INT8);
api.SetBType(matmul_tiling::TPosition::GM,matmul_tiling::CubeFormat::ND,matmul_tiling::DataType::DT_INT8);
api.SetCType(matmul_tiling::TPosition::GM,matmul_tiling::CubeFormat::ND,matmul_tiling::DataType::DT_INT32);
api.SetOrgShape(s.m,s.n,s.k);
api.SetShape(std::min(s.m,tileM),std::min(s.n,tileN),s.k);
api.SetBias(false);
api.SetBufferSpace(-1,-1,-1);
optiling::TCubeTiling tiling;
Check(api.GetTiling(tiling)!=-1);
std::vector<uint8_t> host(tiling.GetDataSize(),0);
tiling.SaveToBuffer(host.data(),host.size());
Allocation tileData(host.size());
Allocation scratch(size_t(cores)*2*TM*tileN*sizeof(int32_t));
const int64_t perCore=platform->GetLibApiWorkSpaceSize();
Check(perCore>0);
Allocation workspace(size_t(cores)*perCore);
Check(aclrtMemcpy(tileData.ptr,host.size(),host.data(),host.size(),ACL_MEMCPY_HOST_TO_DEVICE)==ACL_SUCCESS);
#define GMM_LAUNCH_FAMILY(M,N) GroupedMatmulGelu<M,N><<<cores,nullptr,stream>>>( \
x,weight,scale,group_list,y,scratch.Address(),workspace.Address(), \
perCore,tileData.Address(),s,cores)
if(tileM==32) {
GMM_LAUNCH_FAMILY(32,128);
} else if(tileN==1024) {
GMM_LAUNCH_FAMILY(64,1024);
} else if(tileM==64) {
GMM_LAUNCH_FAMILY(64,256);
} else {
GMM_LAUNCH_FAMILY(128,512);
}
#undef GMM_LAUNCH_FAMILY
 
const auto status=aclrtSynchronizeStream(stream);
Check(status==ACL_SUCCESS);
}
