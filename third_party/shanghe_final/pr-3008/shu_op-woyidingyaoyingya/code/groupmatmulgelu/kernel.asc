__aicore__ inline void C5FullAProduce(Catlass::Arch::Resource<Catlass::Arch::AtlasA2>& resource,
GM_ADDR x,GM_ADDR w,GM_ADDR groups,
GM_ADDR scratch,Shape s,int core,int cores) {
using ArchTag=Catlass::Arch::AtlasA2;
using Policy=Catlass::Gemm::MmadAtlasA2PreloadAsyncWithCallback<1,2,2,2,1,false,true>;
using AType=Catlass::Gemm::GemmType<int8_t,Catlass::layout::RowMajor>;
using BType=Catlass::Gemm::GemmType<int8_t,Catlass::layout::RowMajor>;
using CType=Catlass::Gemm::GemmType<half,Catlass::layout::RowMajor>;
using Block=Catlass::Gemm::Block::HDMFullCachedAMmad<Policy,
Catlass::GemmShape<128,256,256>,Catlass::GemmShape<128,128,256>,AType,BType,CType,void,C5HalfTransportCopy<AType,BType,CType>>;
Block block(resource);
GlobalTensor<int8_t> ag,bg;
GlobalTensor<half> cg;
GlobalTensor<int64_t> gg;
ag.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
bg.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(w));
cg.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(scratch));
gg.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups));
HDMWaitSlot waits[4];
HDMPublishSlot publishes[4];
int start=0,base=0,ordinal=0;
for(int e=0;e<s.e;++e) {
const int end=static_cast<int>(gg.GetValue(e));
const int tasks=CeilDiv(end-start,128);
for(int task=FirstTask(core,cores,base);task<tasks;task+=cores) {
const int row=start+task*128;
const int rows=Min(128,end-row);
block.PrepareResidentA(ag[int64_t(row)*s.k],Catlass::layout::RowMajor(rows,s.k),rows,s.k);
for(int col=0;col<s.n;col+=256) {
const int slot=ordinal%4;
Callback before;
if(ordinal>=4) before=MakeCallback(&waits[slot]);
auto after=MakeCallback(&publishes[slot]);
const int64_t offset=(int64_t(slot)*cores+core)*128*256;
block(ag[int64_t(row)*s.k],Catlass::layout::RowMajor(rows,s.k),
bg[int64_t(e)*s.k*s.n+col],Catlass::layout::RowMajor(s.k,s.n),
cg[offset],Catlass::layout::RowMajor(rows,256),
Catlass::GemmCoord(rows,256,s.k),false,before,after);
++ordinal;
}
}
start=end; base+=tasks;
}
block.SynchronizeBlock();
for(int i=0;i<Min(ordinal,4);++i) CrossCoreWaitFlag(5);
const int idleCount=cores-base;
if(ordinal==0 && idleCount>0 && idleCount*5>=cores) {
const int idleRank=core-base;
const int kTiles=CeilDiv(s.k,256);
auto preload=resource.l1Buf.GetBufferByByte<int8_t>(0);
int previous=0,rowBase=0;
for(int expert=0;expert<s.e;++expert) {
const int end=int(gg.GetValue(expert));
const int rowTasks=CeilDiv(end-previous,128);
for(int rowTask=0;rowTask<rowTasks;++rowTask) {
const int task=rowBase+rowTask;
if(task%idleCount!=idleRank) continue;
const int firstTile=(task%cores)%kTiles;
for(int lead=0;lead<Min(2,kTiles);++lead) {
const int tile=firstTile+lead<kTiles?firstTile+lead:firstTile+lead-kTiles;
const int kOffset=tile*256;
const int bytes=Min(256,s.k-kOffset)*s.n;
DataCopy(preload,bg[int64_t(expert)*s.k*s.n+int64_t(kOffset)*s.n],bytes);
PipeBarrier<PIPE_MTE2>();
}
}
previous=end;
rowBase+=rowTasks;
}
PipeBarrier<PIPE_ALL>();
}
}

__aicore__ inline void GeluFp32ToHalf(
  const LocalTensor<float>& values,const LocalTensor<float>& work,
  const LocalTensor<half>& output,int count) {
   
  for(int offset=0;offset<count;offset+=4096) {
    const int elements=Min(4096,count-offset);
#define GELU_FP32_VEC(call) do {call;PipeBarrier<PIPE_V>();} while(false)
    GELU_FP32_VEC(Mul(work,values[offset],values[offset],elements));
    GELU_FP32_VEC(Muls(work,work,-0.0713548162726003f,elements));
    GELU_FP32_VEC(Adds(work,work,-1.5957691216057308f,elements));
    GELU_FP32_VEC(Mul(work,work,values[offset],elements));
    GELU_FP32_VEC(Mins(work,work,80.0f,elements));
    GELU_FP32_VEC(Exp(work,work,elements));
    GELU_FP32_VEC(Adds(work,work,1.0f,elements));
    GELU_FP32_VEC(Div(values[offset],values[offset],work,elements));
    GELU_FP32_VEC(Cast(output[offset],values[offset],RoundMode::CAST_RINT,elements));
#undef GELU_FP32_VEC
  }
}

__aicore__ inline void InitializeReadyInKernel(GM_ADDR ready,int bytes,int cores) {
if ASCEND_IS_AIV {
const int lines=bytes/64,span=CeilDiv(lines,cores*2);
const int begin=GetBlockIdx()*span,end=Min(lines,begin+span);
if(begin<end) {
LocalTensor<int32_t> zero(TPosition::VECCALC,0,1024);
GlobalTensor<int32_t> dst;dst.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(ready));
Duplicate(zero,int32_t(0),1024);
SetFlag<HardEvent::V_MTE3>(EVENT_ID0);WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
for(int at=begin*16;at<end*16;at+=1024) DataCopy(dst[at],zero,Min(1024,end*16-at));
}
}
SyncAll<false>();
}

__aicore__ inline void ConsumeC5Panel(
Catlass::Arch::Resource<Catlass::Arch::AtlasA2>& resource,
GlobalTensor<half>& cg,GlobalTensor<float>& sg,GlobalTensor<half>& yg,
Tile tile,Shape s,int core,int cores,int sub,int expert,int ordinal,bool& outputPending) {
auto raw=resource.ubBuf.GetBufferByByte<half>(65536);
auto value=resource.ubBuf.GetBufferByByte<float>(0);
auto work=resource.ubBuf.GetBufferByByte<float>(65536);
auto scales=resource.ubBuf.GetBufferByByte<float>(131072);
auto output=resource.ubBuf.GetBufferByByte<half>(132096);
const int columnOffset=sub*128;
const int rows=tile.rows;
const int count=rows*128;
const int64_t offset=(int64_t(ordinal%4)*cores+core)*128*256;
if(rows>0) {
DataCopyExtParams scaleCopy{1,128*4,0,0,0};
DataCopyPad(scales,sg[int64_t(expert)*s.n+tile.col+columnOffset],scaleCopy,
DataCopyPadExtParams<float>{false,0,0,0});
}
CrossCoreWaitFlag(4);
if(sub==1) CrossCoreWaitFlag(4);
if(rows>0) {
DataCopyExtParams inputCopy{1,uint32_t(count*2),0,0,0};
DataCopyPad(raw,cg[offset+int64_t(sub)*128*128],inputCopy,
DataCopyPadExtParams<half>{false,0,0,0});
}
CrossCoreSetFlag<2,PIPE_MTE2>(5);
if(rows<=0) return;
SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
Cast(value,raw,RoundMode::CAST_NONE,count);
PipeBarrier<PIPE_V>();
Muls(scales,scales,1024.0f,128);
PipeBarrier<PIPE_V>();
BinaryRepeatParams repeat{1,1,1,16,16,0};
for(int column=0;column<128;column+=64)
Mul(value[column],value[column],scales[column],uint64_t(64),uint8_t(rows),repeat);
PipeBarrier<PIPE_V>();
    if(outputPending) WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
    GeluFp32ToHalf(value,work,output,count);
SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
DataCopyExtParams outputCopy{uint16_t(rows),128*2,0,uint32_t((s.n-128)*2),0};
DataCopyPad(yg[int64_t(tile.row)*s.n+tile.col+columnOffset],output,outputCopy);
SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
outputPending=true;
SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
if(sub==0) CrossCoreWaitFlag(4);
}
__global__ __aicore__ void C5FullAGroupedMatmulGelu(
GM_ADDR x,GM_ADDR w,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,
