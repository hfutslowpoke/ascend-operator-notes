Catlass::GemmShape<64,256,512>,Catlass::GemmShape<64,256,128>,AType,BType,CType,void,C2HalfTransportCopy<AType,BType,CType>>;
Block block(resource);
GlobalTensor<int8_t> ag,bg;
GlobalTensor<half> cg;
GlobalTensor<int64_t> gg;
ag.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
bg.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(w));
cg.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(scratch));
gg.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups));
HDMWaitSlot waits[4];
HDMPublishSlot publishes[4];
int start=0,base=0,ordinal=0;
for(int e=0;e<s.e;++e) {
const int end=static_cast<int>(gg.GetValue(e));
const int tasks=CeilDiv(end-start,64)*CeilDiv(s.n,macroN);
for(int task=FirstTask(core,cores,base);task<tasks;task+=cores) {
const Tile tile=MakeTile(start,end,s.n,task,64,macroN);
const int row=tile.row,rows=tile.rows;
for(int col=tile.col;col<tile.col+tile.cols;col+=256) {
const int slot=ordinal%4;
Callback before;
if(ordinal>=4) before=MakeCallback(&waits[slot]);
auto after=MakeCallback(&publishes[slot]);
const int64_t offset=(int64_t(slot)*cores+core)*64*256;
block(ag[int64_t(row)*s.k],Catlass::layout::RowMajor(rows,s.k),
bg[int64_t(e)*s.k*s.n+col],Catlass::layout::RowMajor(s.k,s.n),
cg[offset],Catlass::layout::RowMajor(rows,256),
Catlass::GemmCoord(rows,256,s.k),col==tile.col,before,after);
++ordinal;
}
}
start=end; base+=tasks;
}
block.SynchronizeBlock();
for(int i=0;i<Min(ordinal,4);++i) CrossCoreWaitFlag(5);
}

__global__ __aicore__ void C2BankedHalfGroupedMatmulGelu(
GM_ADDR x,GM_ADDR w,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,
GM_ADDR scratch,uint64_t syncBase,Shape s,int cores,int macroN) {
KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
SetSyncBaseAddr(syncBase);
int core=GetBlockIdx();
if ASCEND_IS_AIV { core/=2; }
const int sub=GetSubBlockIdx();
Catlass::Arch::Resource<Catlass::Arch::AtlasA2> resource;
if ASCEND_IS_AIC {
C2BankedHalfProduce(resource,x,w,groups,scratch,s,core,cores,macroN);
return;
}
GlobalTensor<half> cg,yg;
GlobalTensor<float> sg;
GlobalTensor<int64_t> gg;
cg.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(scratch));
yg.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y));
sg.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scale));
gg.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups));
auto value=resource.ubBuf.GetBufferByByte<float>(32768);
auto nonlinear=resource.ubBuf.GetBufferByByte<float>(65536);
SetFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);
SetFlag<HardEvent::MTE3_MTE2>(EVENT_ID1);
int start=0,base=0,ordinal=0;
for(int expert=0;expert<s.e;++expert) {
const int end=static_cast<int>(gg.GetValue(expert));
const int tasks=CeilDiv(end-start,64)*CeilDiv(s.n,macroN);
for(int task=FirstTask(core,cores,base);task<tasks;task+=cores) {
const Tile tile=MakeTile(start,end,s.n,task,64,macroN);
const int halfRows=(tile.rows+1)/2;
const int rowOffset=sub*halfRows;
const int rows=Min(halfRows,tile.rows-rowOffset);
for(int colOffset=0;colOffset<tile.cols;colOffset+=256) {
const int cols=Min(256,tile.cols-colOffset);
const int count=rows*cols;
const int bank=ordinal%2;
const event_t event=bank?EVENT_ID1:EVENT_ID0;
auto raw=resource.ubBuf.GetBufferByByte<half>(bank*16384);
auto scales=resource.ubBuf.GetBufferByByte<float>(131072+bank*1024);
const int64_t offset=(int64_t(ordinal%4)*cores+core)*64*256;
if(rows>0) {
WaitFlag<HardEvent::MTE3_MTE2>(event);
DataCopyExtParams cp{1,uint32_t(cols*4),0,0,0};
DataCopyPad(scales,sg[int64_t(expert)*s.n+tile.col+colOffset],cp,
DataCopyPadExtParams<float>{false,0,0,0});
}
CrossCoreWaitFlag(4);
if(rows>0) {
DataCopyExtParams cp{1,uint32_t(count*2),0,0,0};
DataCopyPad(raw,cg[offset+int64_t(rowOffset)*cols],cp,
DataCopyPadExtParams<half>{false,0,0,0});
}
CrossCoreSetFlag<2,PIPE_MTE2>(5);
if(rows>0) {
SetFlag<HardEvent::MTE2_V>(event);
WaitFlag<HardEvent::MTE2_V>(event);
Cast(value,raw,RoundMode::CAST_NONE,count);
Muls(scales,scales,1024.0f,cols);
PipeBarrier<PIPE_V>();
const BinaryRepeatParams br{1,1,1,uint8_t(cols/8),uint8_t(cols/8),0};
for(int col=0;col<cols;col+=64)
Mul(value[col],value[col],scales[col],uint64_t(Min(64,cols-col)),uint8_t(rows),br);
PipeBarrier<PIPE_V>();
          GeluFp32ToHalf(value,nonlinear,raw,count);
SetFlag<HardEvent::V_MTE3>(event);
WaitFlag<HardEvent::V_MTE3>(event);
DataCopyExtParams cp{uint16_t(rows),uint32_t(cols*2),0,uint32_t((s.n-cols)*2),0};
DataCopyPad(yg[int64_t(tile.row+rowOffset)*s.n+tile.col+colOffset],raw,cp);
SetFlag<HardEvent::MTE3_MTE2>(event);
}
++ordinal;
}
}
start=end;
base+=tasks;
}
WaitFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);
WaitFlag<HardEvent::MTE3_MTE2>(EVENT_ID1);
PipeBarrier<PIPE_ALL>();
}



