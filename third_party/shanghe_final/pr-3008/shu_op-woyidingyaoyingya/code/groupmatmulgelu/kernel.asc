using ERSNZMM=matmul::MatmulImpl<
matmul::MatmulType<TPosition::GM,::CubeFormat::ND,int8_t>,
matmul::MatmulType<TPosition::GM,::CubeFormat::NZ,int8_t>,
matmul::MatmulType<TPosition::GM,::CubeFormat::ND,int32_t>,
matmul::MatmulType<TPosition::GM,::CubeFormat::ND,int32_t>,REF_CONFIG>;
struct ERSNZFrame { int expert,kStart,bank; };
__aicore__ inline void ERSFinishNZFrame(
const ERSNZFrame& frame,Shape s,const LocalTensor<int8_t>& raw,
const LocalTensor<int8_t>& packed,GlobalTensor<int8_t>& output,bool& outputPending) {
const int kPad=CeilDiv(s.k,128)*128,nPad=CeilDiv(s.n,32)*32;
WaitFlag<HardEvent::MTE2_V>(frame.bank==0?EVENT_ID2:EVENT_ID3);
if(outputPending) {
WaitFlag<HardEvent::MTE3_V>(EVENT_ID2);
outputPending=false;
}
for(int panel=0;panel<nPad/32;++panel) {
DataCopyParams rearrange{64,1,static_cast<uint16_t>(nPad/32-1),0};
DataCopy(packed[panel*64*32],raw[panel*32],rearrange);
}
SetFlag<HardEvent::V_MTE3>(EVENT_ID2);
WaitFlag<HardEvent::V_MTE3>(EVENT_ID2);
DataCopyExtParams store{static_cast<uint16_t>(nPad/32),64*32,0,
static_cast<uint32_t>((kPad-64)*32),0};
DataCopyPad(output[int64_t(frame.expert)*kPad*nPad+int64_t(frame.kStart)*32],packed,store);
SetFlag<HardEvent::MTE3_V>(EVENT_ID2);
outputPending=true;
}
__aicore__ inline void ERSPrepareNZB(
GM_ADDR weights,GM_ADDR packedWeights,GM_ADDR groups,Shape s,int aiv,int aivs,
const LocalTensor<int8_t>& raw0,const LocalTensor<int8_t>& raw1,const LocalTensor<int8_t>& packed) {
GlobalTensor<int8_t> input,output;
GlobalTensor<int64_t> endpoints;
input.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(weights));
output.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(packedWeights));
endpoints.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups));
const int kPad=CeilDiv(s.k,128)*128,nPad=CeilDiv(s.n,32)*32;
const int frames=kPad/64;
bool outputPending=false,havePrevious=false;
ERSNZFrame previous{};
int ordinal=0;
for(int task=aiv;task<s.e*frames;task+=aivs) {
const int expert=task/frames;
const int end=static_cast<int>(endpoints.GetValue(expert));
const int start=expert==0?0:static_cast<int>(endpoints.GetValue(expert-1));
if(end==start) continue;
const int bank=ordinal%2,kStart=(task%frames)*64;
const int rows=kStart<s.k?Min(64,s.k-kStart):0;
auto raw=bank==0?raw0:raw1;
 
PipeBarrier<PIPE_V>();
Duplicate(raw.ReinterpretCast<int32_t>(),int32_t(0),64*nPad/4);
SetFlag<HardEvent::V_MTE2>(bank==0?EVENT_ID4:EVENT_ID5);
WaitFlag<HardEvent::V_MTE2>(bank==0?EVENT_ID4:EVENT_ID5);
if(rows>0) {
DataCopyExtParams copy{static_cast<uint16_t>(rows),static_cast<uint32_t>(s.n),0,0,0};
DataCopyPad(raw,input[(int64_t(expert)*s.k+kStart)*s.n],copy,
DataCopyPadExtParams<int8_t>{false,0,0,0});
}
SetFlag<HardEvent::MTE2_V>(bank==0?EVENT_ID2:EVENT_ID3);
if(havePrevious) {
ERSFinishNZFrame(previous,s,previous.bank==0?raw0:raw1,packed,output,outputPending);
}
previous={expert,kStart,bank};
havePrevious=true;
++ordinal;
}
if(havePrevious) {
ERSFinishNZFrame(previous,s,previous.bank==0?raw0:raw1,packed,output,outputPending);
}
if(outputPending) WaitFlag<HardEvent::MTE3_V>(EVENT_ID2);
 
SetFlag<HardEvent::V_MTE2>(EVENT_ID1);
WaitFlag<HardEvent::V_MTE2>(EVENT_ID1);
}

__global__ __aicore__ void ERSGlobalNZGroupedMatmulGelu(
GM_ADDR x,GM_ADDR w,GM_ADDR packedW,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,
GM_ADDR scratch,GM_ADDR workspace,int64_t workspacePerCore,
GM_ADDR tilingGm,uint64_t syncBase,Shape s,int cores,int macroN) {
KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
SetSyncBaseAddr(syncBase);
int core=GetBlockIdx();
if ASCEND_IS_AIV { core/=2; }
const int sub=GetSubBlockIdx();
TPipe pipe;
TCubeTiling tiling;
ERSNZMM mm;
if ASCEND_IS_AIC {
auto* dst=reinterpret_cast<uint32_t*>(&tiling);
auto* src=reinterpret_cast<__gm__ uint32_t*>(tilingGm);
for(uint32_t i=0;i<sizeof(TCubeTiling)/sizeof(uint32_t);++i) dst[i]=src[i];
GM_ADDR sys=workspace+int64_t(core)*workspacePerCore;
SetSysWorkspaceForce(sys);
clearWorkspace(sys);
mm.SetSubBlockIdx(0);
mm.Init(&tiling,&pipe);
}
GlobalTensor<int8_t> ag,bg;
GlobalTensor<int32_t> cg;
GlobalTensor<float> sg;
GlobalTensor<int64_t> gg;
GlobalTensor<half> yg;
ag.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
bg.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(packedW));
cg.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(scratch));
sg.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scale));
gg.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups));
yg.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y));
 
const int frameBytes=64*CeilDiv(s.n,32)*32;
const int arenaBytes=3*frameBytes>164864?3*frameBytes:164864;
TBuf<TPosition::VECCALC> arena;
if ASCEND_IS_AIV { pipe.InitBuffer(arena,arenaBytes); }
if ASCEND_IS_AIV {
ERSPrepareNZB(w,packedW,groups,s,core*2+sub,cores*2,arena.Get<int8_t>(),arena.Get<int8_t>()[frameBytes],arena.Get<int8_t>()[2*frameBytes]);
}
SyncAll<false>();
const int packedK=CeilDiv(s.k,128)*128;
const int packedN=CeilDiv(s.n,32)*32;
bool outputPending=false;
int start=0,base=0,ordinal=0;
for(int e=0;e<s.e;++e) {
const int end=static_cast<int>(gg.GetValue(e));
const int tasks=CeilDiv(end-start,128)*CeilDiv(s.n,macroN);
for(int task=FirstTask(core,cores,base);task<tasks;task+=cores) {
const Tile tile=MakeTile(start,end,s.n,task,128,macroN);
if ASCEND_IS_AIC {
mm.SetOrgShape(s.m,s.n,s.k,packedK,256);
mm.SetSingleShape(tile.rows,tile.cols,s.k);
mm.SetTensorA(ag[AOffset(tile.row,s.k)]);
mm.SetTensorB(bg[int64_t(e)*packedK*packedN+int64_t(tile.col)*packedK]);
int cColumn=0;
while(mm.Iterate()) {
const int slot=ordinal%4;
if(ordinal>=4) CrossCoreWaitFlag(5);
const int64_t offset=(int64_t(slot)*cores+core)*(128*256+macroN);
 
 
 
mm.GetTensorC(cg[offset+macroN-cColumn*256],0,false);
++cColumn;
CrossCoreSetFlag<2,PIPE_FIX>(4);
++ordinal;
}
mm.End();
}
if ASCEND_IS_AIV {
auto ci=arena.Get<int32_t>(); auto z=arena.Get<float>();
auto u=arena.Get<float>()[16384]; auto den=arena.Get<float>()[16384];
auto sc=arena.Get<float>()[32768]; auto out=arena.Get<half>()[66048];
const int halfRows=(tile.rows+1)/2;
const int rowOffset=sub*halfRows;
const int rows=Min(halfRows,tile.rows-rowOffset);
for(int colOffset=0;colOffset<tile.cols;colOffset+=256) {
const int cols=Min(256,tile.cols-colOffset);
const int vectorN=CeilDiv(cols,64)*64;
const int count=rows*vectorN;
const int slot=ordinal%4;
const int64_t offset=(int64_t(slot)*cores+core)*(128*256+macroN);
if(rows>0) {
Duplicate(ci,int32_t(0),count);
Duplicate(sc,0.0f,256);
SetFlag<HardEvent::V_MTE2>(EVENT_ID1);
WaitFlag<HardEvent::V_MTE2>(EVENT_ID1);
DataCopyExtParams scaleCopy{1,static_cast<uint32_t>(cols*4),0,0,0};
DataCopyPad(sc,sg[int64_t(e)*s.n+tile.col+colOffset],scaleCopy,
DataCopyPadExtParams<float>{false,0,0,0});
}
CrossCoreWaitFlag(4);
if(rows>0) {
 
const int alignedCols=CeilDiv(cols,8)*8;
DataCopyExtParams inputCopy{static_cast<uint16_t>(rows),
static_cast<uint32_t>(cols*4),static_cast<uint32_t>((256-cols)*4),
static_cast<uint32_t>((vectorN-alignedCols)/8),0};
DataCopyPad(ci,cg[offset+macroN+int64_t(rowOffset)*256],inputCopy,
DataCopyPadExtParams<int32_t>{false,0,0,0});
}
 
 
CrossCoreSetFlag<2,PIPE_MTE2>(5);
if(rows>0) {
SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
Cast(z,ci,RoundMode::CAST_NONE,count); PipeBarrier<PIPE_V>();
BinaryRepeatParams br{1,1,1,static_cast<uint8_t>(vectorN/8),
static_cast<uint8_t>(vectorN/8),0};
for(int c=0;c<cols;c+=64)
Mul(z[c],z[c],sc[c],static_cast<uint64_t>(Min(64,cols-c)),
static_cast<uint8_t>(rows),br);
PipeBarrier<PIPE_V>();
#define REF_VEC(call) do { call; PipeBarrier<PIPE_V>(); } while(false)
REF_VEC(Mul(u,z,z,count));
REF_VEC(Muls(u,u,0.044715f,count));
REF_VEC(Adds(u,u,1.0f,count));
REF_VEC(Mul(u,u,z,count));
REF_VEC(Muls(u,u,1.5957691216057308f,count));
REF_VEC(Muls(u,u,-1.0f,count));
REF_VEC(Mins(u,u,80.0f,count));
REF_VEC(Exp(u,u,count));
REF_VEC(Adds(den,u,1.0f,count));
REF_VEC(Div(z,z,den,count));
if(outputPending) { WaitFlag<HardEvent::MTE3_V>(EVENT_ID0); outputPending=false; }
REF_VEC(Cast(out,z,RoundMode::CAST_RINT,count));
#undef REF_VEC
SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
DataCopyExtParams outputCopy{static_cast<uint16_t>(rows),
static_cast<uint32_t>(cols*2),
static_cast<uint32_t>((vectorN-CeilDiv(cols,16)*16)/16),
static_cast<uint32_t>((s.n-cols)*2),0};
if(cols==s.n && vectorN==cols) {
outputCopy.blockCount=1;
outputCopy.blockLen=static_cast<uint32_t>(rows*cols*2);
}
DataCopyPad(yg[int64_t(tile.row+rowOffset)*s.n+tile.col+colOffset],
out,outputCopy);
SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
outputPending=true;
SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
}
++ordinal;
}
}
}
start=end; base+=tasks;
}
if ASCEND_IS_AIV {
if(outputPending) WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
}
if ASCEND_IS_AIC {
for(int i=0;i<Min(ordinal,4);++i) CrossCoreWaitFlag(5);
}
}

__aicore__ inline int HCSelectCacheSpan(const GlobalTensor<int64_t>& groups,Shape s,int cores) {
if(s.n%512==0) return 512;
int start=0;
int64_t rowTasks=0;
for(int expert=0;expert<s.e;++expert) {
const int end=static_cast<int>(groups.GetValue(expert));
rowTasks+=CeilDiv(end-start,256);
start=end;
}
return rowTasks*CeilDiv(s.n,512)<2LL*cores?256:512;
}

__aicore__ inline void HC48AwaitExpertFrames(GM_ADDR readyGm,Shape s,int expert) {
GlobalTensor<int64_t> ready;
ready.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(readyGm));
volatile __gm__ int64_t* flags=reinterpret_cast<volatile __gm__ int64_t*>(readyGm);
const int frames=CeilDiv(CeilDiv(s.k,128)*128,48);
const int index=(s.e*frames+expert)*8;
auto row=ready[index];
while(true) {
DataCacheCleanAndInvalid<int64_t,CacheLine::SINGLE_CACHE_LINE,DcciDst::CACHELINE_OUT>(row);
if(flags[index]==1) break;
}
SetFlag<HardEvent::S_MTE2>(EVENT_ID2);
WaitFlag<HardEvent::S_MTE2>(EVENT_ID2);
}

__aicore__ inline void HC48ReadyFinishNZFrame(
const ERSNZFrame& frame,Shape s,const LocalTensor<int8_t>& raw,
const LocalTensor<int8_t>& packed,GlobalTensor<int8_t>& output,bool& outputPending,GM_ADDR readyGm) {
const int kPad=CeilDiv(s.k,128)*128,nPad=CeilDiv(s.n,32)*32;
WaitFlag<HardEvent::MTE2_V>(frame.bank==0?EVENT_ID2:EVENT_ID3);
if(outputPending) {
WaitFlag<HardEvent::MTE3_V>(EVENT_ID2);
outputPending=false;
}
for(int panel=0;panel<nPad/32;++panel) {
DataCopyParams rearrange{48,1,static_cast<uint16_t>(nPad/32-1),0};
DataCopy(packed[panel*48*32],raw[panel*32],rearrange);
}
SetFlag<HardEvent::V_MTE3>(EVENT_ID2);
WaitFlag<HardEvent::V_MTE3>(EVENT_ID2);
const int storeRows=Min(48,kPad-frame.kStart);
DataCopyExtParams store{static_cast<uint16_t>(nPad/32),static_cast<uint32_t>(storeRows*32),static_cast<uint32_t>(48-storeRows),
static_cast<uint32_t>((kPad-storeRows)*32),0};
DataCopyPad(output[int64_t(frame.expert)*kPad*nPad+int64_t(frame.kStart)*32],packed,store);
 
 
SetFlag<HardEvent::MTE3_S>(EVENT_ID2);
WaitFlag<HardEvent::MTE3_S>(EVENT_ID2);
outputPending=false;
GlobalTensor<int64_t> ready;
ready.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(readyGm));
const int frames=CeilDiv(kPad,48);
auto row=ready[(frame.expert*frames+frame.kStart/48)*8];
row.SetValue(0,int64_t(1));
DataCacheCleanAndInvalid<int64_t,CacheLine::SINGLE_CACHE_LINE,DcciDst::CACHELINE_OUT>(row);
 
 
 
 
const int chunks=CeilDiv(kPad,576);
const int chunk=frame.kStart/576;
const int first=chunk*12,limit=Min(frames,(chunk+1)*12);
if(frame.kStart/48==limit-1) {
volatile __gm__ int64_t* flags=reinterpret_cast<volatile __gm__ int64_t*>(readyGm);
for(int f=first;f<limit;++f) {
const int index=(frame.expert*frames+f)*8;
auto inputRow=ready[index];
while(true) {
DataCacheCleanAndInvalid<int64_t,CacheLine::SINGLE_CACHE_LINE,DcciDst::CACHELINE_OUT>(inputRow);
if(flags[index]==1) break;
}
}
auto expertRow=ready[(s.e*frames+frame.expert*chunks+chunk)*8];
expertRow.SetValue(0,int64_t(1));
DataCacheCleanAndInvalid<int64_t,CacheLine::SINGLE_CACHE_LINE,DcciDst::CACHELINE_OUT>(expertRow);
}
SetFlag<HardEvent::S_V>(EVENT_ID2);
WaitFlag<HardEvent::S_V>(EVENT_ID2);
}
__aicore__ inline void HC48ReadyPrepareNZB(
GM_ADDR weights,GM_ADDR packedWeights,GM_ADDR groups,Shape s,int aiv,int aivs,
const LocalTensor<int8_t>& raw0,const LocalTensor<int8_t>& raw1,const LocalTensor<int8_t>& packed,GM_ADDR readyGm) {
GlobalTensor<int8_t> input,output;
GlobalTensor<int64_t> endpoints;
input.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(weights));
output.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(packedWeights));
endpoints.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups));
const int kPad=CeilDiv(s.k,128)*128,nPad=CeilDiv(s.n,32)*32;
const int frames=CeilDiv(kPad,48);
bool outputPending=false,havePrevious=false;
ERSNZFrame previous{};
int ordinal=0;
for(int task=aiv;task<s.e*frames;task+=aivs) {
const int expert=task/frames;
const int end=static_cast<int>(endpoints.GetValue(expert));
const int start=expert==0?0:static_cast<int>(endpoints.GetValue(expert-1));
if(end==start) continue;
const int bank=ordinal%2,kStart=(task%frames)*48;
const int rows=kStart<s.k?Min(48,s.k-kStart):0;
auto raw=bank==0?raw0:raw1;
 
PipeBarrier<PIPE_V>();
if(rows<48) {
auto tail=raw[rows*nPad].ReinterpretCast<int32_t>();
Duplicate(tail,int32_t(0),(48-rows)*nPad/4);
}
SetFlag<HardEvent::V_MTE2>(bank==0?EVENT_ID4:EVENT_ID5);
WaitFlag<HardEvent::V_MTE2>(bank==0?EVENT_ID4:EVENT_ID5);
if(rows>0) {
DataCopyExtParams copy{static_cast<uint16_t>(rows),static_cast<uint32_t>(s.n),0,0,0};
DataCopyPad(raw,input[(int64_t(expert)*s.k+kStart)*s.n],copy,
DataCopyPadExtParams<int8_t>{true,0,static_cast<uint8_t>(nPad-s.n),0});
}
SetFlag<HardEvent::MTE2_V>(bank==0?EVENT_ID2:EVENT_ID3);
if(havePrevious) {
HC48ReadyFinishNZFrame(previous,s,previous.bank==0?raw0:raw1,packed,output,outputPending,readyGm);
}
previous={expert,kStart,bank};
havePrevious=true;
++ordinal;
}
if(havePrevious) {
HC48ReadyFinishNZFrame(previous,s,previous.bank==0?raw0:raw1,packed,output,outputPending,readyGm);
}
if(outputPending) WaitFlag<HardEvent::MTE3_V>(EVENT_ID2);
 
SetFlag<HardEvent::V_MTE2>(EVENT_ID1);
WaitFlag<HardEvent::V_MTE2>(EVENT_ID1);
}

__aicore__ inline int HCSelectSevenPanelSpan(const GlobalTensor<int64_t>& groups,Shape s,int cores) {
int previous=0;
int64_t rowTasks=0;
for(int expert=0;expert<s.e;++expert) {
const int end=static_cast<int>(groups.GetValue(expert));
rowTasks+=CeilDiv(end-previous,192);
previous=end;
}
return rowTasks*CeilDiv(s.n,480)<2LL*cores?320:480;
}

struct HCK576Readiness {
GM_ADDR readyGm;
int chunkBase;
mutable uint32_t acquiredMask=0;
__aicore__ inline bool IsReady(uint32_t chunk) const {
const uint32_t mask=uint32_t(1)<<chunk;
if(acquiredMask&mask) return true;
GlobalTensor<int64_t> ready;
ready.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(readyGm));
const int64_t index=int64_t(chunkBase+chunk)*8;
auto row=ready[index];
DataCacheCleanAndInvalid<int64_t,CacheLine::SINGLE_CACHE_LINE,DcciDst::CACHELINE_OUT>(row);
volatile __gm__ int64_t* flags=reinterpret_cast<volatile __gm__ int64_t*>(readyGm);
if(flags[index]!=1) return false;
SetFlag<HardEvent::S_MTE2>(EVENT_ID2);
WaitFlag<HardEvent::S_MTE2>(EVENT_ID2);
acquiredMask|=mask;
return true;
}
__aicore__ inline void Wait(uint32_t chunk) const {
while(!IsReady(chunk)) {}
}
};

__aicore__ inline void HCExpertReadyProduce(
Catlass::Arch::Resource<Catlass::Arch::AtlasA2>& resource,
GM_ADDR x,GM_ADDR w,GM_ADDR groups,GM_ADDR scratch,Shape s,int core,int cores,int macroN,GM_ADDR readyGm) {
using Policy=Catlass::Gemm::MmadAtlasA2PreloadAsyncWithCallback<1,2,2,2,1,false,false>;
using AType=Catlass::Gemm::GemmType<int8_t,Catlass::layout::RowMajor>;
using BType=Catlass::Gemm::GemmType<int8_t,Catlass::layout::zN>;
using CType=Catlass::Gemm::GemmType<int32_t,Catlass::layout::RowMajor>;
using Block=Catlass::Gemm::Block::HDMCachedAMmad<Policy,
Catlass::GemmShape<192,160,576>,Catlass::GemmShape<192,160,128>,AType,BType,CType,void,RectangularATileCopy<AType,BType,CType>>;
Block block(resource);
GlobalTensor<int8_t> ag,bg;
GlobalTensor<int32_t> cg;
GlobalTensor<int64_t> gg;
ag.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
bg.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(w));
cg.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(scratch));
gg.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups));
macroN=HCSelectSevenPanelSpan(gg,s,cores);
const int kPad=CeilDiv(s.k,128)*128,nPad=CeilDiv(s.n,32)*32;
HDMWaitSlot waits[4]; HDMPublishSlot publishes[4];
int start=0,base=0,ordinal=0;
for(int expert=0;expert<s.e;++expert) {
const int end=static_cast<int>(gg.GetValue(expert));
const int tasks=CeilDiv(end-start,192)*CeilDiv(s.n,macroN);
HCK576Readiness readiness;
readiness.readyGm=readyGm;
readiness.chunkBase=s.e*CeilDiv(kPad,48)+expert*CeilDiv(kPad,576);
for(int task=FirstTask(core,cores,base);task<tasks;task+=cores) {
const Tile panel=MakeTile(start,end,s.n,task,192,macroN);
for(int colOffset=0;colOffset<panel.cols;colOffset+=160) {
const int cols=Min(160,panel.cols-colOffset),slot=ordinal%4;
Callback before,after=MakeCallback(&publishes[slot]);
if(ordinal>=4) before=MakeCallback(&waits[slot]);
block(ag[int64_t(panel.row)*s.k],Catlass::layout::RowMajor(panel.rows,s.k),
bg[int64_t(expert)*kPad*nPad+int64_t(panel.col+colOffset)*kPad],Catlass::layout::zN::MakeLayout<int8_t>(kPad,nPad),
cg[(int64_t(slot)*cores+core)*192*160],Catlass::layout::RowMajor(panel.rows,160),
Catlass::GemmCoord(panel.rows,cols,s.k),colOffset==0,before,after,readiness);
++ordinal;
}
}
start=end; base+=tasks;
}
block.SynchronizeBlock();
for(int slot=0;slot<Min(ordinal,4);++slot) CrossCoreWaitFlag(5);
}

__global__ __aicore__ void HCExpertReadyGroupedMatmulGelu(
GM_ADDR x,GM_ADDR w,GM_ADDR packedW,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,
GM_ADDR scratch,GM_ADDR workspace,int64_t workspacePerCore,
GM_ADDR tilingGm,uint64_t syncBase,Shape s,int cores,int macroN,GM_ADDR readyGm) {
KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
SetSyncBaseAddr(syncBase);
InitializeReadyInKernel(readyGm,s.e*(CeilDiv(CeilDiv(s.k,128)*128,48)+CeilDiv(CeilDiv(s.k,128)*128,576))*64,cores);
int core=GetBlockIdx();
if ASCEND_IS_AIV { core/=2; }
const int sub=GetSubBlockIdx();
Catlass::Arch::Resource<Catlass::Arch::AtlasA2> resource;
if ASCEND_IS_AIV {
const int frameBytes=48*CeilDiv(s.n,32)*32;
auto arena=resource.ubBuf.GetBufferByByte<int8_t>(0);
HC48ReadyPrepareNZB(w,packedW,groups,s,core*2+sub,cores*2,
arena,arena[frameBytes],arena[2*frameBytes],readyGm);
}
if ASCEND_IS_AIC {
HCExpertReadyProduce(resource,x,packedW,groups,scratch,s,core,cores,macroN,readyGm);
return;
}
GlobalTensor<int8_t> ag,bg;
GlobalTensor<int32_t> cg;
GlobalTensor<float> sg;
GlobalTensor<int64_t> gg;
GlobalTensor<half> yg;
ag.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
bg.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(w));
cg.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(scratch));
sg.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scale));
gg.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups));
macroN=HCSelectSevenPanelSpan(gg,s,cores);
yg.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y));
bool outputPending=false;
int start=0,base=0,ordinal=0;
for(int e=0;e<s.e;++e) {
const int end=static_cast<int>(gg.GetValue(e));
const int tasks=CeilDiv(end-start,192)*CeilDiv(s.n,macroN);
for(int task=FirstTask(core,cores,base);task<tasks;task+=cores) {
const Tile tile=MakeTile(start,end,s.n,task,192,macroN);
if ASCEND_IS_AIV {
auto ci=resource.ubBuf.GetBufferByByte<int32_t>(0); auto z=resource.ubBuf.GetBufferByByte<float>(0);
auto u=resource.ubBuf.GetBufferByByte<float>(65536); auto den=resource.ubBuf.GetBufferByByte<float>(65536);
auto sc=resource.ubBuf.GetBufferByByte<float>(131072); auto out=resource.ubBuf.GetBufferByByte<half>(132096);
const int halfRows=(tile.rows+1)/2;
const int rowOffset=sub*halfRows;
const int rows=Min(halfRows,tile.rows-rowOffset);
for(int colOffset=0;colOffset<tile.cols;colOffset+=160) {
const int cols=Min(160,tile.cols-colOffset);
const int vectorN=CeilDiv(cols,32)*32;
const int count=rows*vectorN;
const int slot=ordinal%4;
const int64_t offset=(int64_t(slot)*cores+core)*192*160;
if(rows>0) {
Duplicate(ci,int32_t(0),count);
Duplicate(sc,0.0f,192);
SetFlag<HardEvent::V_MTE2>(EVENT_ID1);
WaitFlag<HardEvent::V_MTE2>(EVENT_ID1);
DataCopyExtParams scaleCopy{1,static_cast<uint32_t>(cols*4),0,0,0};
DataCopyPad(sc,sg[int64_t(e)*s.n+tile.col+colOffset],scaleCopy,
DataCopyPadExtParams<float>{false,0,0,0});
}
CrossCoreWaitFlag(4);
if(rows>0) {
 
const int alignedCols=CeilDiv(cols,8)*8;
DataCopyExtParams inputCopy{static_cast<uint16_t>(rows),
static_cast<uint32_t>(cols*4),static_cast<uint32_t>((160-cols)*4),
static_cast<uint32_t>((vectorN-alignedCols)/8),0};
DataCopyPad(ci,cg[offset+int64_t(rowOffset)*160],inputCopy,
DataCopyPadExtParams<int32_t>{false,0,0,0});
}
 
 
CrossCoreSetFlag<2,PIPE_MTE2>(5);
if(rows>0) {
SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
Cast(z,ci,RoundMode::CAST_NONE,count); PipeBarrier<PIPE_V>();
BinaryRepeatParams br{1,1,1,static_cast<uint8_t>(vectorN/8),
static_cast<uint8_t>(vectorN/8),0};
for(int c=0;c<cols;c+=64)
Mul(z[c],z[c],sc[c],static_cast<uint64_t>(Min(64,cols-c)),
static_cast<uint8_t>(rows),br);
PipeBarrier<PIPE_V>();
#define REF_VEC(call) do { call; PipeBarrier<PIPE_V>(); } while(false)
REF_VEC(Mul(u,z,z,count));
REF_VEC(Muls(u,u,0.044715f,count));
REF_VEC(Adds(u,u,1.0f,count));
REF_VEC(Mul(u,u,z,count));
REF_VEC(Muls(u,u,1.5957691216057308f,count));
REF_VEC(Muls(u,u,-1.0f,count));
REF_VEC(Mins(u,u,80.0f,count));
REF_VEC(Exp(u,u,count));
REF_VEC(Adds(den,u,1.0f,count));
REF_VEC(Div(z,z,den,count));
if(outputPending) { WaitFlag<HardEvent::MTE3_V>(EVENT_ID0); outputPending=false; }
REF_VEC(Cast(out,z,RoundMode::CAST_RINT,count));
#undef REF_VEC
SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
DataCopyExtParams outputCopy{static_cast<uint16_t>(rows),
static_cast<uint32_t>(cols*2),
static_cast<uint32_t>((vectorN-CeilDiv(cols,16)*16)/16),
static_cast<uint32_t>((s.n-cols)*2),0};
if(cols==s.n && vectorN==cols) {
outputCopy.blockCount=1;
outputCopy.blockLen=static_cast<uint32_t>(rows*cols*2);
}
DataCopyPad(yg[int64_t(tile.row+rowOffset)*s.n+tile.col+colOffset],
out,outputCopy);
SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
outputPending=true;
SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
}
++ordinal;
}
}
}
start=end; base+=tasks;
}
if ASCEND_IS_AIV {
if(outputPending) WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
}
}

__aicore__ inline void HCPartialACacheProduce(
Catlass::Arch::Resource<Catlass::Arch::AtlasA2>& resource,
GM_ADDR x,GM_ADDR w,GM_ADDR groups,GM_ADDR scratch,Shape s,int core,int cores,int macroN) {
using Policy=Catlass::Gemm::MmadAtlasA2PreloadAsyncWithCallback<1,2,2,2,1,false,false>;
using AType=Catlass::Gemm::GemmType<int8_t,Catlass::layout::RowMajor>;
using BType=Catlass::Gemm::GemmType<int8_t,Catlass::layout::RowMajor>;
using CType=Catlass::Gemm::GemmType<int32_t,Catlass::layout::RowMajor>;
using Block=Catlass::Gemm::Block::HDMCachedAMmad<Policy,
Catlass::GemmShape<256,128,576>,Catlass::GemmShape<256,128,128>,AType,BType,CType,void,RectangularATileCopy<AType,BType,CType>>;
Block block(resource);
GlobalTensor<int8_t> ag,bg;
GlobalTensor<int32_t> cg;
GlobalTensor<int64_t> gg;
ag.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
bg.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(w));
cg.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(scratch));
gg.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups));
macroN=HCSelectCacheSpan(gg,s,cores);
HDMWaitSlot waits[4]; HDMPublishSlot publishes[4];
int start=0,base=0,ordinal=0;
for(int expert=0;expert<s.e;++expert) {
const int end=static_cast<int>(gg.GetValue(expert));
const int tasks=CeilDiv(end-start,256)*CeilDiv(s.n,macroN);
for(int task=FirstTask(core,cores,base);task<tasks;task+=cores) {
const Tile panel=MakeTile(start,end,s.n,task,256,macroN);
for(int colOffset=0;colOffset<panel.cols;colOffset+=128) {
const int cols=Min(128,panel.cols-colOffset),slot=ordinal%4;
Callback before,after=MakeCallback(&publishes[slot]);
if(ordinal>=4) before=MakeCallback(&waits[slot]);
block(ag[int64_t(panel.row)*s.k],Catlass::layout::RowMajor(panel.rows,s.k),
bg[(int64_t(expert)*s.k)*s.n+panel.col+colOffset],Catlass::layout::RowMajor(s.k,s.n),
cg[(int64_t(slot)*cores+core)*128*256],Catlass::layout::RowMajor(panel.rows,128),
Catlass::GemmCoord(panel.rows,cols,s.k),colOffset==0,before,after);
++ordinal;
}
}
start=end; base+=tasks;
}
block.SynchronizeBlock();
for(int slot=0;slot<Min(ordinal,4);++slot) CrossCoreWaitFlag(5);
}

__global__ __aicore__ void HCPartialACacheGroupedMatmulGelu(
GM_ADDR x,GM_ADDR w,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,
GM_ADDR scratch,GM_ADDR workspace,int64_t workspacePerCore,
GM_ADDR tilingGm,uint64_t syncBase,Shape s,int cores,int macroN) {
KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
SetSyncBaseAddr(syncBase);
int core=GetBlockIdx();
if ASCEND_IS_AIV { core/=2; }
const int sub=GetSubBlockIdx();
Catlass::Arch::Resource<Catlass::Arch::AtlasA2> resource;
if ASCEND_IS_AIC {
HCPartialACacheProduce(resource,x,w,groups,scratch,s,core,cores,macroN);
return;
}
GlobalTensor<int8_t> ag,bg;
GlobalTensor<int32_t> cg;
GlobalTensor<float> sg;
GlobalTensor<int64_t> gg;
GlobalTensor<half> yg;
ag.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
bg.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(w));
cg.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(scratch));
sg.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scale));
gg.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups));
macroN=HCSelectCacheSpan(gg,s,cores);
yg.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y));
bool outputPending=false;
int start=0,base=0,ordinal=0;
for(int e=0;e<s.e;++e) {
const int end=static_cast<int>(gg.GetValue(e));
const int tasks=CeilDiv(end-start,256)*CeilDiv(s.n,macroN);
for(int task=FirstTask(core,cores,base);task<tasks;task+=cores) {
const Tile tile=MakeTile(start,end,s.n,task,256,macroN);
if ASCEND_IS_AIV {
auto ci=resource.ubBuf.GetBufferByByte<int32_t>(0); auto z=resource.ubBuf.GetBufferByByte<float>(0);
auto u=resource.ubBuf.GetBufferByByte<float>(65536); auto den=resource.ubBuf.GetBufferByByte<float>(65536);
auto sc=resource.ubBuf.GetBufferByByte<float>(131072); auto out=resource.ubBuf.GetBufferByByte<half>(132096);
const int halfRows=(tile.rows+1)/2;
const int rowOffset=sub*halfRows;
const int rows=Min(halfRows,tile.rows-rowOffset);
for(int colOffset=0;colOffset<tile.cols;colOffset+=128) {
const int cols=Min(128,tile.cols-colOffset);
const int vectorN=CeilDiv(cols,64)*64;
const int count=rows*vectorN;
const int slot=ordinal%4;
const int64_t offset=(int64_t(slot)*cores+core)*128*256;
if(rows>0) {
Duplicate(ci,int32_t(0),count);
Duplicate(sc,0.0f,128);
SetFlag<HardEvent::V_MTE2>(EVENT_ID1);
WaitFlag<HardEvent::V_MTE2>(EVENT_ID1);
DataCopyExtParams scaleCopy{1,static_cast<uint32_t>(cols*4),0,0,0};
DataCopyPad(sc,sg[int64_t(e)*s.n+tile.col+colOffset],scaleCopy,
DataCopyPadExtParams<float>{false,0,0,0});
}
CrossCoreWaitFlag(4);
if(rows>0) {
 
const int alignedCols=CeilDiv(cols,8)*8;
DataCopyExtParams inputCopy{static_cast<uint16_t>(rows),
static_cast<uint32_t>(cols*4),static_cast<uint32_t>((128-cols)*4),
static_cast<uint32_t>((vectorN-alignedCols)/8),0};
DataCopyPad(ci,cg[offset+int64_t(rowOffset)*128],inputCopy,
DataCopyPadExtParams<int32_t>{false,0,0,0});
}
 
 
CrossCoreSetFlag<2,PIPE_MTE2>(5);
if(rows>0) {
SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
Cast(z,ci,RoundMode::CAST_NONE,count); PipeBarrier<PIPE_V>();
BinaryRepeatParams br{1,1,1,static_cast<uint8_t>(vectorN/8),
static_cast<uint8_t>(vectorN/8),0};
for(int c=0;c<cols;c+=64)
Mul(z[c],z[c],sc[c],static_cast<uint64_t>(Min(64,cols-c)),
static_cast<uint8_t>(rows),br);
PipeBarrier<PIPE_V>();
#define REF_VEC(call) do { call; PipeBarrier<PIPE_V>(); } while(false)
REF_VEC(Mul(u,z,z,count));
REF_VEC(Muls(u,u,0.044715f,count));
REF_VEC(Adds(u,u,1.0f,count));
REF_VEC(Mul(u,u,z,count));
REF_VEC(Muls(u,u,1.5957691216057308f,count));
REF_VEC(Muls(u,u,-1.0f,count));
REF_VEC(Mins(u,u,80.0f,count));
REF_VEC(Exp(u,u,count));
REF_VEC(Adds(den,u,1.0f,count));
REF_VEC(Div(z,z,den,count));
if(outputPending) { WaitFlag<HardEvent::MTE3_V>(EVENT_ID0); outputPending=false; }
REF_VEC(Cast(out,z,RoundMode::CAST_RINT,count));
#undef REF_VEC
SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
DataCopyExtParams outputCopy{static_cast<uint16_t>(rows),
static_cast<uint32_t>(cols*2),
static_cast<uint32_t>((vectorN-CeilDiv(cols,16)*16)/16),
static_cast<uint32_t>((s.n-cols)*2),0};
if(cols==s.n && vectorN==cols) {
outputCopy.blockCount=1;
outputCopy.blockLen=static_cast<uint32_t>(rows*cols*2);
}
DataCopyPad(yg[int64_t(tile.row+rowOffset)*s.n+tile.col+colOffset],
out,outputCopy);
SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
outputPending=true;
SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
}
++ordinal;
}
}
}
start=end; base+=tasks;
}
if ASCEND_IS_AIV {
if(outputPending) WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
}
}

__aicore__ inline void ERSAwaitExpertFrames(GM_ADDR readyGm,Shape s,int expert) {
GlobalTensor<int64_t> ready;
ready.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(readyGm));
volatile __gm__ int64_t* flags=reinterpret_cast<volatile __gm__ int64_t*>(readyGm);
const int frames=CeilDiv(CeilDiv(s.k,128)*128,80);
const int index=(s.e*frames+expert)*8;
auto row=ready[index];
while(true) {
DataCacheCleanAndInvalid<int64_t,CacheLine::SINGLE_CACHE_LINE,DcciDst::CACHELINE_OUT>(row);
if(flags[index]==1) break;
}
SetFlag<HardEvent::S_MTE2>(EVENT_ID2);
WaitFlag<HardEvent::S_MTE2>(EVENT_ID2);
}

__aicore__ inline void ERSReadyFinishNZFrame(
const ERSNZFrame& frame,Shape s,const LocalTensor<int8_t>& raw,
const LocalTensor<int8_t>& packed,GlobalTensor<int8_t>& output,bool& outputPending,GM_ADDR readyGm) {
const int kPad=CeilDiv(s.k,128)*128,nPad=CeilDiv(s.n,32)*32;
WaitFlag<HardEvent::MTE2_V>(frame.bank==0?EVENT_ID2:EVENT_ID3);
if(outputPending) {
WaitFlag<HardEvent::MTE3_V>(EVENT_ID2);
outputPending=false;
}
for(int panel=0;panel<nPad/32;++panel) {
DataCopyParams rearrange{80,1,static_cast<uint16_t>(nPad/32-1),0};
DataCopy(packed[panel*80*32],raw[panel*32],rearrange);
}
SetFlag<HardEvent::V_MTE3>(EVENT_ID2);
WaitFlag<HardEvent::V_MTE3>(EVENT_ID2);
const int storeRows=Min(80,kPad-frame.kStart);
DataCopyExtParams store{static_cast<uint16_t>(nPad/32),static_cast<uint32_t>(storeRows*32),static_cast<uint32_t>(80-storeRows),
static_cast<uint32_t>((kPad-storeRows)*32),0};
DataCopyPad(output[int64_t(frame.expert)*kPad*nPad+int64_t(frame.kStart)*32],packed,store);
 
 
SetFlag<HardEvent::MTE3_S>(EVENT_ID2);
WaitFlag<HardEvent::MTE3_S>(EVENT_ID2);
outputPending=false;
GlobalTensor<int64_t> ready;
ready.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(readyGm));
const int frames=CeilDiv(kPad,80);
auto row=ready[(frame.expert*frames+frame.kStart/80)*8];
row.SetValue(0,int64_t(1));
DataCacheCleanAndInvalid<int64_t,CacheLine::SINGLE_CACHE_LINE,DcciDst::CACHELINE_OUT>(row);
 
 
 
 
if(frame.kStart/80==frames-1) {
volatile __gm__ int64_t* flags=reinterpret_cast<volatile __gm__ int64_t*>(readyGm);
for(int f=0;f<frames;++f) {
const int index=(frame.expert*frames+f)*8;
auto inputRow=ready[index];
while(true) {
DataCacheCleanAndInvalid<int64_t,CacheLine::SINGLE_CACHE_LINE,DcciDst::CACHELINE_OUT>(inputRow);
if(flags[index]==1) break;
}
}
auto expertRow=ready[(s.e*frames+frame.expert)*8];
expertRow.SetValue(0,int64_t(1));
DataCacheCleanAndInvalid<int64_t,CacheLine::SINGLE_CACHE_LINE,DcciDst::CACHELINE_OUT>(expertRow);
}
SetFlag<HardEvent::S_V>(EVENT_ID2);
WaitFlag<HardEvent::S_V>(EVENT_ID2);
}
__aicore__ inline void ERSReadyPrepareNZB(
GM_ADDR weights,GM_ADDR packedWeights,GM_ADDR groups,Shape s,int aiv,int aivs,
const LocalTensor<int8_t>& raw0,const LocalTensor<int8_t>& raw1,const LocalTensor<int8_t>& packed,GM_ADDR readyGm) {
GlobalTensor<int8_t> input,output;
GlobalTensor<int64_t> endpoints;
input.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(weights));
output.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(packedWeights));
endpoints.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups));
const int kPad=CeilDiv(s.k,128)*128,nPad=CeilDiv(s.n,32)*32;
const int frames=CeilDiv(kPad,80);
bool outputPending=false,havePrevious=false;
ERSNZFrame previous{};
int ordinal=0;
for(int task=aiv;task<s.e*frames;task+=aivs) {
const int expert=task/frames;
const int end=static_cast<int>(endpoints.GetValue(expert));
const int start=expert==0?0:static_cast<int>(endpoints.GetValue(expert-1));
if(end==start) continue;
const int bank=ordinal%2,kStart=(task%frames)*80;
const int rows=kStart<s.k?Min(80,s.k-kStart):0;
auto raw=bank==0?raw0:raw1;
 
PipeBarrier<PIPE_V>();
Duplicate(raw.ReinterpretCast<int32_t>(),int32_t(0),80*nPad/4);
SetFlag<HardEvent::V_MTE2>(bank==0?EVENT_ID4:EVENT_ID5);
WaitFlag<HardEvent::V_MTE2>(bank==0?EVENT_ID4:EVENT_ID5);
if(rows>0) {
DataCopyExtParams copy{static_cast<uint16_t>(rows),static_cast<uint32_t>(s.n),0,0,0};
DataCopyPad(raw,input[(int64_t(expert)*s.k+kStart)*s.n],copy,
DataCopyPadExtParams<int8_t>{false,0,0,0});
}
SetFlag<HardEvent::MTE2_V>(bank==0?EVENT_ID2:EVENT_ID3);
if(havePrevious) {
ERSReadyFinishNZFrame(previous,s,previous.bank==0?raw0:raw1,packed,output,outputPending,readyGm);
}
previous={expert,kStart,bank};
havePrevious=true;
++ordinal;
}
if(havePrevious) {
ERSReadyFinishNZFrame(previous,s,previous.bank==0?raw0:raw1,packed,output,outputPending,readyGm);
}
if(outputPending) WaitFlag<HardEvent::MTE3_V>(EVENT_ID2);
 
SetFlag<HardEvent::V_MTE2>(EVENT_ID1);
WaitFlag<HardEvent::V_MTE2>(EVENT_ID1);
}

using ERSHalfFixpipeBase=Catlass::Gemm::Tile::CopyL0CToGm<
Catlass::Arch::AtlasA2,int32_t,
Catlass::Gemm::GemmType<half,Catlass::layout::RowMajor>,
Catlass::Gemm::Tile::ScaleGranularity::PER_TENSOR>;
struct ERSHalfFixpipeCopy:ERSHalfFixpipeBase {
__aicore__ ERSHalfFixpipeCopy():ERSHalfFixpipeBase(ERSHalfFixpipeBase::Params(0.0009765625f)) {}
};
template<class AType,class BType,class CType>
struct ERSHalfTransportTileCopy:Catlass::Gemm::Tile::TileCopy<Catlass::Arch::AtlasA2,AType,BType,CType> {
using CopyL0CToGm=ERSHalfFixpipeCopy;
};

__aicore__ inline void ERSNativeNZCachedAProduce(
Catlass::Arch::Resource<Catlass::Arch::AtlasA2>& resource,
GM_ADDR x,GM_ADDR w,GM_ADDR groups,GM_ADDR scratch,Shape s,int core,int cores,int macroN,GM_ADDR readyGm) {
using Policy=Catlass::Gemm::MmadAtlasA2PreloadAsyncWithCallback<1,2,2,2,1,false,false>;
using AType=Catlass::Gemm::GemmType<int8_t,Catlass::layout::RowMajor>;
using BType=Catlass::Gemm::GemmType<int8_t,Catlass::layout::zN>;
using CType=Catlass::Gemm::GemmType<half,Catlass::layout::RowMajor>;
using Block=Catlass::Gemm::Block::HDMCachedAMmad<Policy,
Catlass::GemmShape<128,256,640>,Catlass::GemmShape<128,256,128>,AType,BType,CType,void,ERSHalfTransportTileCopy<AType,BType,CType>>;
Block block(resource);
GlobalTensor<int8_t> ag,bg;
GlobalTensor<half> cg;
GlobalTensor<int64_t> gg;
ag.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
bg.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(w));
cg.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(scratch));
gg.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups));
const int kPad=CeilDiv(s.k,128)*128,nPad=CeilDiv(s.n,32)*32;
HDMWaitSlot waits[4]; HDMPublishSlot publishes[4];
int start=0,base=0,ordinal=0;
for(int expert=0;expert<s.e;++expert) {
const int end=static_cast<int>(gg.GetValue(expert));
const int tasks=CeilDiv(end-start,128)*CeilDiv(s.n,macroN);
bool acquired=false;
for(int task=FirstTask(core,cores,base);task<tasks;task+=cores) {
if(!acquired) { ERSAwaitExpertFrames(readyGm,s,expert); acquired=true; }
const Tile panel=MakeTile(start,end,s.n,task,128,macroN);
for(int colOffset=0;colOffset<panel.cols;colOffset+=256) {
const int cols=Min(256,panel.cols-colOffset),slot=ordinal%4;
Callback before,after=MakeCallback(&publishes[slot]);
if(ordinal>=4) before=MakeCallback(&waits[slot]);
block(ag[int64_t(panel.row)*s.k],Catlass::layout::RowMajor(panel.rows,s.k),
bg[int64_t(expert)*kPad*nPad+int64_t(panel.col+colOffset)*kPad],Catlass::layout::zN::MakeLayout<int8_t>(kPad,nPad),
cg[(int64_t(slot)*cores+core)*128*256],Catlass::layout::RowMajor(panel.rows,256),
Catlass::GemmCoord(panel.rows,cols,s.k),colOffset==0,before,after);
++ordinal;
}
}
start=end; base+=tasks;
}
block.SynchronizeBlock();
for(int slot=0;slot<Min(ordinal,4);++slot) CrossCoreWaitFlag(5);
}

__global__ __aicore__ void ERSNativeNZCachedAGroupedMatmulGelu(
GM_ADDR x,GM_ADDR w,GM_ADDR packedW,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,
GM_ADDR scratch,GM_ADDR workspace,int64_t workspacePerCore,
GM_ADDR tilingGm,uint64_t syncBase,Shape s,int cores,int macroN,GM_ADDR readyGm) {
KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
SetSyncBaseAddr(syncBase);
InitializeReadyInKernel(readyGm,s.e*(CeilDiv(CeilDiv(s.k,128)*128,80)+1)*64,cores);
int core=GetBlockIdx();
if ASCEND_IS_AIV { core/=2; }
const int sub=GetSubBlockIdx();
Catlass::Arch::Resource<Catlass::Arch::AtlasA2> resource;
if ASCEND_IS_AIV {
const int frameBytes=80*CeilDiv(s.n,32)*32;
auto arena=resource.ubBuf.GetBufferByByte<int8_t>(0);
ERSReadyPrepareNZB(w,packedW,groups,s,core*2+sub,cores*2,
arena,arena[frameBytes],arena[2*frameBytes],readyGm);
}
 
if ASCEND_IS_AIC {
ERSNativeNZCachedAProduce(resource,x,packedW,groups,scratch,s,core,cores,macroN,readyGm);
return;
}
GlobalTensor<int8_t> ag,bg;
GlobalTensor<half> cg;
GlobalTensor<float> sg;
GlobalTensor<int64_t> gg;
GlobalTensor<half> yg;
ag.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
bg.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(w));
cg.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(scratch));
sg.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scale));
gg.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups));
yg.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y));
bool outputPending=false;
int start=0,base=0,ordinal=0;
for(int e=0;e<s.e;++e) {
const int end=static_cast<int>(gg.GetValue(e));
const int tasks=CeilDiv(end-start,128)*CeilDiv(s.n,macroN);
for(int task=FirstTask(core,cores,base);task<tasks;task+=cores) {
const Tile tile=MakeTile(start,end,s.n,task,128,macroN);
if ASCEND_IS_AIV {
auto ci=resource.ubBuf.GetBufferByByte<half>(65536); auto z=resource.ubBuf.GetBufferByByte<float>(0);
auto u=resource.ubBuf.GetBufferByByte<float>(65536); auto den=resource.ubBuf.GetBufferByByte<float>(65536);
auto sc=resource.ubBuf.GetBufferByByte<float>(131072); auto out=resource.ubBuf.GetBufferByByte<half>(132096);
const int halfRows=(tile.rows+1)/2;
const int rowOffset=sub*halfRows;
const int rows=Min(halfRows,tile.rows-rowOffset);
for(int colOffset=0;colOffset<tile.cols;colOffset+=256) {
const int cols=Min(256,tile.cols-colOffset);
const int vectorN=CeilDiv(cols,64)*64;
const int count=rows*vectorN;
const int slot=ordinal%4;
const int64_t offset=(int64_t(slot)*cores+core)*128*256;
if(rows>0) {
Duplicate(ci,half(0.0f),count);
Duplicate(sc,0.0f,256);
SetFlag<HardEvent::V_MTE2>(EVENT_ID1);
WaitFlag<HardEvent::V_MTE2>(EVENT_ID1);
DataCopyExtParams scaleCopy{1,static_cast<uint32_t>(cols*4),0,0,0};
DataCopyPad(sc,sg[int64_t(e)*s.n+tile.col+colOffset],scaleCopy,
DataCopyPadExtParams<float>{false,0,0,0});
}
CrossCoreWaitFlag(4);
if(rows>0) {
 
const int alignedCols=CeilDiv(cols,16)*16;
DataCopyExtParams inputCopy{static_cast<uint16_t>(rows),
static_cast<uint32_t>(cols*2),static_cast<uint32_t>((256-cols)*2),
static_cast<uint32_t>((vectorN-alignedCols)/16),0};
DataCopyPad(ci,cg[offset+int64_t(rowOffset)*256],inputCopy,
DataCopyPadExtParams<half>{false,0,0,0});
}
 
 
CrossCoreSetFlag<2,PIPE_MTE2>(5);
if(rows>0) {
SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
Cast(z,ci,RoundMode::CAST_NONE,count); PipeBarrier<PIPE_V>();
 
 
 
Muls(sc,sc,1024.0f,256); PipeBarrier<PIPE_V>();
BinaryRepeatParams br{1,1,1,static_cast<uint8_t>(vectorN/8),
static_cast<uint8_t>(vectorN/8),0};
for(int c=0;c<cols;c+=64)
Mul(z[c],z[c],sc[c],static_cast<uint64_t>(Min(64,cols-c)),
static_cast<uint8_t>(rows),br);
PipeBarrier<PIPE_V>();
#define REF_VEC(call) do { call; PipeBarrier<PIPE_V>(); } while(false)
if(outputPending) { WaitFlag<HardEvent::MTE3_V>(EVENT_ID0); outputPending=false; }
 
 
GeluFp32ToHalf(z,u,out,count);
#undef REF_VEC
SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
DataCopyExtParams outputCopy{static_cast<uint16_t>(rows),
static_cast<uint32_t>(cols*2),
static_cast<uint32_t>((vectorN-CeilDiv(cols,16)*16)/16),
static_cast<uint32_t>((s.n-cols)*2),0};
if(cols==s.n && vectorN==cols) {
outputCopy.blockCount=1;
outputCopy.blockLen=static_cast<uint32_t>(rows*cols*2);
}
DataCopyPad(yg[int64_t(tile.row+rowOffset)*s.n+tile.col+colOffset],
out,outputCopy);
SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
outputPending=true;
SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
}
++ordinal;
}
}
}
start=end; base+=tasks;
}
if ASCEND_IS_AIV {
if(outputPending) WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
}
}

__aicore__ inline void ERL0ExpertReadyProduce(
Catlass::Arch::Resource<Catlass::Arch::AtlasA2>& resource,
GM_ADDR x,GM_ADDR w,GM_ADDR groups,GM_ADDR scratch,Shape s,int core,int cores,int macroN,GM_ADDR readyGm) {
using Policy=Catlass::Gemm::MmadAtlasA2PreloadAsyncWithCallback<2,3,2,2,1,false,false>;
using AType=Catlass::Gemm::GemmType<int8_t,Catlass::layout::RowMajor>;
using BType=Catlass::Gemm::GemmType<int8_t,Catlass::layout::zN>;
using CType=Catlass::Gemm::GemmType<int32_t,Catlass::layout::RowMajor>;
using Block=Catlass::Gemm::Block::HDMCachedAMmad<Policy,
Catlass::GemmShape<128,256,384>,Catlass::GemmShape<128,256,128>,AType,BType,CType>;
Block block(resource);
GlobalTensor<int8_t> ag,bg;
GlobalTensor<int32_t> cg;
GlobalTensor<int64_t> gg;
ag.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
bg.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(w));
cg.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(scratch));
gg.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups));
const int kPad=CeilDiv(s.k,128)*128,nPad=CeilDiv(s.n,32)*32;
HDMWaitSlot waits[4]; HDMPublishSlot publishes[4];
int start=0,base=0,ordinal=0;
for(int expert=0;expert<s.e;++expert) {
const int end=static_cast<int>(gg.GetValue(expert));
const int tasks=CeilDiv(end-start,128)*CeilDiv(s.n,macroN);
bool acquired=false;
for(int task=FirstTask(core,cores,base);task<tasks;task+=cores) {
if(!acquired) { ERSAwaitExpertFrames(readyGm,s,expert); acquired=true; }
const Tile panel=MakeTile(start,end,s.n,task,128,macroN);
for(int colOffset=0;colOffset<panel.cols;colOffset+=256) {
const int cols=Min(256,panel.cols-colOffset),slot=ordinal%4;
Callback before,after=MakeCallback(&publishes[slot]);
if(ordinal>=4) before=MakeCallback(&waits[slot]);
block(ag[int64_t(panel.row)*s.k],Catlass::layout::RowMajor(panel.rows,s.k),
bg[int64_t(expert)*kPad*nPad+int64_t(panel.col+colOffset)*kPad],Catlass::layout::zN::MakeLayout<int8_t>(kPad,nPad),
cg[(int64_t(slot)*cores+core)*128*256],Catlass::layout::RowMajor(panel.rows,256),
Catlass::GemmCoord(panel.rows,cols,s.k),colOffset==0,before,after);
++ordinal;
}
}
start=end; base+=tasks;
}
block.SynchronizeBlock();
for(int slot=0;slot<Min(ordinal,4);++slot) CrossCoreWaitFlag(5);
}

__global__ __aicore__ void ERL0ExpertReadyGroupedMatmulGelu(
GM_ADDR x,GM_ADDR w,GM_ADDR packedW,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,
GM_ADDR scratch,GM_ADDR workspace,int64_t workspacePerCore,
GM_ADDR tilingGm,uint64_t syncBase,Shape s,int cores,int macroN,GM_ADDR readyGm) {
KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
SetSyncBaseAddr(syncBase);
InitializeReadyInKernel(readyGm,s.e*(CeilDiv(CeilDiv(s.k,128)*128,80)+1)*64,cores);
int core=GetBlockIdx();
if ASCEND_IS_AIV { core/=2; }
const int sub=GetSubBlockIdx();
Catlass::Arch::Resource<Catlass::Arch::AtlasA2> resource;
if ASCEND_IS_AIV {
const int frameBytes=80*CeilDiv(s.n,32)*32;
auto arena=resource.ubBuf.GetBufferByByte<int8_t>(0);
ERSReadyPrepareNZB(w,packedW,groups,s,core*2+sub,cores*2,
arena,arena[frameBytes],arena[2*frameBytes],readyGm);
}
if ASCEND_IS_AIC {
ERL0ExpertReadyProduce(resource,x,packedW,groups,scratch,s,core,cores,macroN,readyGm);
return;
}
GlobalTensor<int8_t> ag,bg;
GlobalTensor<int32_t> cg;
GlobalTensor<float> sg;
GlobalTensor<int64_t> gg;
GlobalTensor<half> yg;
ag.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
bg.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(w));
cg.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(scratch));
sg.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scale));
gg.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups));
yg.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y));
bool outputPending=false;
int start=0,base=0,ordinal=0;
for(int e=0;e<s.e;++e) {
const int end=static_cast<int>(gg.GetValue(e));
const int tasks=CeilDiv(end-start,128)*CeilDiv(s.n,macroN);
for(int task=FirstTask(core,cores,base);task<tasks;task+=cores) {
const Tile tile=MakeTile(start,end,s.n,task,128,macroN);
if ASCEND_IS_AIV {
auto ci=resource.ubBuf.GetBufferByByte<int32_t>(0); auto z=resource.ubBuf.GetBufferByByte<float>(0);
auto u=resource.ubBuf.GetBufferByByte<float>(65536); auto den=resource.ubBuf.GetBufferByByte<float>(65536);
auto sc=resource.ubBuf.GetBufferByByte<float>(131072); auto out=resource.ubBuf.GetBufferByByte<half>(132096);
const int halfRows=(tile.rows+1)/2;
const int rowOffset=sub*halfRows;
const int rows=Min(halfRows,tile.rows-rowOffset);
for(int colOffset=0;colOffset<tile.cols;colOffset+=256) {
const int cols=Min(256,tile.cols-colOffset);
const int vectorN=CeilDiv(cols,64)*64;
const int count=rows*vectorN;
const int slot=ordinal%4;
const int64_t offset=(int64_t(slot)*cores+core)*128*256;
if(rows>0) {
Duplicate(ci,int32_t(0),count);
Duplicate(sc,0.0f,256);
SetFlag<HardEvent::V_MTE2>(EVENT_ID1);
WaitFlag<HardEvent::V_MTE2>(EVENT_ID1);
DataCopyExtParams scaleCopy{1,static_cast<uint32_t>(cols*4),0,0,0};
DataCopyPad(sc,sg[int64_t(e)*s.n+tile.col+colOffset],scaleCopy,
DataCopyPadExtParams<float>{false,0,0,0});
}
CrossCoreWaitFlag(4);
if(rows>0) {
 
const int alignedCols=CeilDiv(cols,8)*8;
DataCopyExtParams inputCopy{static_cast<uint16_t>(rows),
static_cast<uint32_t>(cols*4),static_cast<uint32_t>((256-cols)*4),
static_cast<uint32_t>((vectorN-alignedCols)/8),0};
DataCopyPad(ci,cg[offset+int64_t(rowOffset)*256],inputCopy,
DataCopyPadExtParams<int32_t>{false,0,0,0});
}
 
 
CrossCoreSetFlag<2,PIPE_MTE2>(5);
if(rows>0) {
SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
Cast(z,ci,RoundMode::CAST_NONE,count); PipeBarrier<PIPE_V>();
BinaryRepeatParams br{1,1,1,static_cast<uint8_t>(vectorN/8),
static_cast<uint8_t>(vectorN/8),0};
for(int c=0;c<cols;c+=64)
Mul(z[c],z[c],sc[c],static_cast<uint64_t>(Min(64,cols-c)),
static_cast<uint8_t>(rows),br);
PipeBarrier<PIPE_V>();
#define REF_VEC(call) do { call; PipeBarrier<PIPE_V>(); } while(false)
REF_VEC(Mul(u,z,z,count));
REF_VEC(Muls(u,u,0.044715f,count));
REF_VEC(Adds(u,u,1.0f,count));
REF_VEC(Mul(u,u,z,count));
REF_VEC(Muls(u,u,1.5957691216057308f,count));
REF_VEC(Muls(u,u,-1.0f,count));
REF_VEC(Mins(u,u,80.0f,count));
REF_VEC(Exp(u,u,count));
REF_VEC(Adds(den,u,1.0f,count));
REF_VEC(Div(z,z,den,count));
if(outputPending) { WaitFlag<HardEvent::MTE3_V>(EVENT_ID0); outputPending=false; }
REF_VEC(Cast(out,z,RoundMode::CAST_RINT,count));
#undef REF_VEC
SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
DataCopyExtParams outputCopy{static_cast<uint16_t>(rows),
static_cast<uint32_t>(cols*2),
static_cast<uint32_t>((vectorN-CeilDiv(cols,16)*16)/16),
static_cast<uint32_t>((s.n-cols)*2),0};
if(cols==s.n && vectorN==cols) {
outputCopy.blockCount=1;
outputCopy.blockLen=static_cast<uint32_t>(rows*cols*2);
}
DataCopyPad(yg[int64_t(tile.row+rowOffset)*s.n+tile.col+colOffset],
out,outputCopy);
SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
outputPending=true;
SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
}
++ordinal;
}
}
}
start=end; base+=tasks;
}
if ASCEND_IS_AIV {
if(outputPending) WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
}
}

struct HDLPanelCursor {
int expert=0,start=0,end=0,base=0,task=0,tasks=0,columnPart=0;
bool loaded=false;
__aicore__ inline bool Next(const GlobalTensor<int64_t>& groups,Shape s,
int worker,int workers,Tile& tile,int& selectedExpert,bool& firstColumns,bool& lastColumns) {
while(expert<s.e) {
if(!loaded) {
end=static_cast<int>(groups.GetValue(expert));
tasks=CeilDiv(end-start,64);
task=FirstTask(worker,workers,base);
loaded=true;
}
if(task<tasks) {
const Tile macro=MakeTile(start,end,s.n,task,64,1024);
tile={macro.row,macro.col+columnPart,macro.rows,Min(256,macro.cols-columnPart)};
selectedExpert=expert;
firstColumns=columnPart==0;
lastColumns=columnPart+tile.cols==macro.cols;
columnPart+=256;
if(columnPart>=macro.cols) {
columnPart=0;
task+=workers;
}
return true;
}
start=end;
base+=tasks;
++expert;
loaded=false;
}
return false;
}
};

using HDLHalfFixpipeBase=Catlass::Gemm::Tile::CopyL0CToGm<
Catlass::Arch::AtlasA2,int32_t,
Catlass::Gemm::GemmType<half,Catlass::layout::RowMajor>,
Catlass::Gemm::Tile::ScaleGranularity::PER_TENSOR>;
struct HDLHalfFixpipeCopy:HDLHalfFixpipeBase {
__aicore__ HDLHalfFixpipeCopy():HDLHalfFixpipeBase(HDLHalfFixpipeBase::Params(0.0009765625f)) {}
};
template<class AType,class BType,class CType>
struct HDLHalfTransportTileCopy:Catlass::Gemm::Tile::TileCopy<Catlass::Arch::AtlasA2,AType,BType,CType> {
using CopyL0CToGm=HDLHalfFixpipeCopy;
};

__aicore__ inline void HDLInputAheadProduce(
Catlass::Arch::Resource<Catlass::Arch::AtlasA2>& resource,
GM_ADDR x,GM_ADDR w,GM_ADDR groups,GM_ADDR scratch,Shape s,int core,int cores) {
using Policy=Catlass::Gemm::MmadAtlasA2PreloadAsyncWithCallback<1,2,2,2,2,false,false>;
using AType=Catlass::Gemm::GemmType<int8_t,Catlass::layout::RowMajor>;
using BType=Catlass::Gemm::GemmType<int8_t,Catlass::layout::RowMajor>;
using CType=Catlass::Gemm::GemmType<half,Catlass::layout::RowMajor>;
using Block=Catlass::Gemm::Block::HCPrefetchBMmad<Policy,
Catlass::GemmShape<64,256,512>,Catlass::GemmShape<64,256,128>,AType,BType,CType,void,HDLHalfTransportTileCopy<AType,BType,CType>>;
Block block(resource);
GlobalTensor<int8_t> ag,bg;
GlobalTensor<half> cg;
GlobalTensor<int64_t> gg;
ag.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
bg.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(w));
cg.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(scratch));
gg.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups));
HDMWaitSlot waits[4];
HDMPublishSlot publishes[4];
HDLPanelCursor cursor;
Tile current;
int expert=0,bank=0,aBank=0,ordinal=0;
bool firstColumns=false,lastColumns=false;
if(!cursor.Next(gg,s,core,cores,current,expert,firstColumns,lastColumns)) return;
const auto layoutB=Catlass::layout::RowMajor(s.k,s.n);
block.PrepareResidentB(bank,bg[int64_t(expert)*s.k*s.n+current.col],
layoutB.GetTileLayout(Catlass::MatrixCoord{uint32_t(s.k),uint32_t(current.cols)}));
block.PrepareResidentA(aBank,ag[int64_t(current.row)*s.k],
Catlass::layout::RowMajor(current.rows,s.k));
while(true) {
Tile next;
int nextExpert=0;
bool nextFirst=false,nextLast=false;
const bool hasNext=cursor.Next(gg,s,core,cores,next,nextExpert,nextFirst,nextLast);
if(hasNext) {
block.PrepareResidentB(bank^1,bg[int64_t(nextExpert)*s.k*s.n+next.col],
layoutB.GetTileLayout(Catlass::MatrixCoord{uint32_t(s.k),uint32_t(next.cols)}));
if(nextFirst) {
block.PrepareResidentA(aBank^1,ag[int64_t(next.row)*s.k],
Catlass::layout::RowMajor(next.rows,s.k));
}
}
const int slot=ordinal%4;
Callback before,after=MakeCallback(&publishes[slot]);
if(ordinal>=4) before=MakeCallback(&waits[slot]);
const int64_t offset=(int64_t(slot)*cores+core)*64*256;
block(cg[offset],Catlass::layout::RowMajor(current.rows,256),
Catlass::GemmCoord(current.rows,current.cols,s.k),
aBank,firstColumns,lastColumns,bank,true,true,before,after);
block.SynchronizeBlock();
++ordinal;
if(!hasNext) break;
if(nextFirst) aBank^=1;
current=next;
expert=nextExpert;
firstColumns=nextFirst;
lastColumns=nextLast;
bank^=1;
}
block.SynchronizeBlock();
for(int slot=0;slot<Min(ordinal,4);++slot) CrossCoreWaitFlag(5);
}

__global__ __aicore__ void HDLInputAheadGroupedMatmulGelu(
GM_ADDR x,GM_ADDR w,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,
GM_ADDR scratch,GM_ADDR workspace,int64_t workspacePerCore,
GM_ADDR tilingGm,uint64_t syncBase,Shape s,int cores,int macroN) {
KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
SetSyncBaseAddr(syncBase);
int core=GetBlockIdx();
if ASCEND_IS_AIV { core/=2; }
const int sub=GetSubBlockIdx();
Catlass::Arch::Resource<Catlass::Arch::AtlasA2> resource;
if ASCEND_IS_AIC {
HDLInputAheadProduce(resource,x,w,groups,scratch,s,core,cores);
return;
}
GlobalTensor<int8_t> ag,bg;
GlobalTensor<half> cg;
GlobalTensor<float> sg;
GlobalTensor<int64_t> gg;
GlobalTensor<half> yg;
ag.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
bg.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(w));
cg.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(scratch));
sg.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scale));
gg.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups));
yg.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y));
SetFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);
SetFlag<HardEvent::MTE3_MTE2>(EVENT_ID1);
int start=0,base=0,ordinal=0;
for(int e=0;e<s.e;++e) {
const int end=static_cast<int>(gg.GetValue(e));
const int tasks=CeilDiv(end-start,64);
for(int task=FirstTask(core,cores,base);task<tasks;task+=cores) {
const Tile panel=MakeTile(start,end,s.n,task,64,1024);
for (int rowBase=0; rowBase<panel.rows; rowBase+=64) {
Tile tile;
tile.row=panel.row+rowBase; tile.col=panel.col;
tile.rows=Min(64,panel.rows-rowBase); tile.cols=panel.cols;
if ASCEND_IS_AIV {
auto z=resource.ubBuf.GetBufferByByte<float>(65536);
auto u=resource.ubBuf.GetBufferByByte<float>(131072);
const int halfRows=(tile.rows+1)/2;
const int rowOffset=sub*halfRows;
const int rows=Min(halfRows,tile.rows-rowOffset);
for(int colOffset=0;colOffset<tile.cols;colOffset+=256) {
const int cols=Min(256,tile.cols-colOffset);
const int vectorN=CeilDiv(cols,16)*16;
const int count=rows*vectorN;
const int slot=ordinal%4;
const int bank=ordinal%2;
const event_t bufferEvent=bank==0?EVENT_ID0:EVENT_ID1;
auto ci=resource.ubBuf.GetBufferByByte<half>(bank*32768);
auto out=ci;
auto sc=resource.ubBuf.GetBufferByByte<float>(163840+bank*1024);
const int64_t offset=(int64_t(slot)*cores+core)*64*256;
if(rows>0) {
 
 
WaitFlag<HardEvent::MTE3_MTE2>(bufferEvent);
DataCopyExtParams scaleCopy{1,static_cast<uint32_t>(cols*4),0,0,0};
DataCopyPad(sc,sg[int64_t(e)*s.n+tile.col+colOffset],scaleCopy,
DataCopyPadExtParams<float>{false,0,0,0});
}
CrossCoreWaitFlag(4);
if(rows>0) {
 
const int alignedCols=CeilDiv(cols,16)*16;
DataCopyExtParams inputCopy{static_cast<uint16_t>(rows),
static_cast<uint32_t>(cols*2),static_cast<uint32_t>((256-cols)*2),
static_cast<uint32_t>((vectorN-alignedCols)/16),0};
DataCopyPad(ci,cg[offset+int64_t(rowOffset)*256],inputCopy,
DataCopyPadExtParams<half>{true,0,
static_cast<uint8_t>(vectorN-cols),half(0.0f)});
}
 
 
CrossCoreSetFlag<2,PIPE_MTE2>(5);
if(rows>0) {
SetFlag<HardEvent::MTE2_V>(bufferEvent);
WaitFlag<HardEvent::MTE2_V>(bufferEvent);
Cast(z,ci,RoundMode::CAST_NONE,count); PipeBarrier<PIPE_V>();
 
 
 
Muls(sc,sc,1024.0f,cols); PipeBarrier<PIPE_V>();
BinaryRepeatParams br{1,1,1,static_cast<uint8_t>(vectorN/8),
static_cast<uint8_t>(vectorN/8),0};
for(int c=0;c<cols;c+=64)
Mul(z[c],z[c],sc[c],static_cast<uint64_t>(Min(64,cols-c)),
static_cast<uint8_t>(rows),br);
PipeBarrier<PIPE_V>();
#define REF_VEC(call) do { call; PipeBarrier<PIPE_V>(); } while(false)
 
 
GeluFp32ToHalf(z,u,out,count);
#undef REF_VEC
SetFlag<HardEvent::V_MTE3>(bufferEvent);
WaitFlag<HardEvent::V_MTE3>(bufferEvent);
DataCopyExtParams outputCopy{static_cast<uint16_t>(rows),
static_cast<uint32_t>(cols*2),
static_cast<uint32_t>((vectorN-CeilDiv(cols,16)*16)/16),
static_cast<uint32_t>((s.n-cols)*2),0};
if(cols==s.n && vectorN==cols) {
outputCopy.blockCount=1;
outputCopy.blockLen=static_cast<uint32_t>(rows*cols*2);
}
DataCopyPad(yg[int64_t(tile.row+rowOffset)*s.n+tile.col+colOffset],
out,outputCopy);
SetFlag<HardEvent::MTE3_MTE2>(bufferEvent);
}
++ordinal;
}
}
}
}
start=end; base+=tasks;
}
if ASCEND_IS_AIV {
WaitFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);
WaitFlag<HardEvent::MTE3_MTE2>(EVENT_ID1);
PipeBarrier<PIPE_ALL>();
}
}

__global__ __aicore__ void CompactResidentGroupedMatmulGelu(
GM_ADDR x,GM_ADDR w,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,
GM_ADDR scratch,GM_ADDR workspace,int64_t workspacePerCore,
GM_ADDR tilingGm,uint64_t syncBase,Shape s,int cores,int macroN) {
KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
SetSyncBaseAddr(syncBase);
int core=GetBlockIdx();
if ASCEND_IS_AIV { core/=2; }
const int sub=GetSubBlockIdx();
TPipe pipe;
TCubeTiling tiling;
RefMM mm;
if ASCEND_IS_AIC {
auto* dst=reinterpret_cast<uint32_t*>(&tiling);
auto* src=reinterpret_cast<__gm__ uint32_t*>(tilingGm);
for(uint32_t i=0;i<sizeof(TCubeTiling)/sizeof(uint32_t);++i) dst[i]=src[i];
GM_ADDR sys=workspace+int64_t(core)*workspacePerCore;
SetSysWorkspaceForce(sys);
clearWorkspace(sys);
mm.SetSubBlockIdx(0);
mm.Init(&tiling,&pipe);
}
GlobalTensor<int8_t> ag,bg;
GlobalTensor<int32_t> cg;
GlobalTensor<float> sg;
GlobalTensor<int64_t> gg;
GlobalTensor<half> yg;
ag.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
bg.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(w));
cg.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(scratch));
sg.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scale));
gg.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups));
yg.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y));
 
TBuf<TPosition::VECCALC> cb,ub,sb,hb;
if ASCEND_IS_AIV {
pipe.InitBuffer(cb,16384*4); pipe.InitBuffer(ub,16384*4);
pipe.InitBuffer(sb,256*4); pipe.InitBuffer(hb,16384*2);
}
bool outputPending=false;
int start=0,base=0,ordinal=0;
for(int e=0;e<s.e;++e) {
const int end=static_cast<int>(gg.GetValue(e));
const int tasks=CeilDiv(end-start,128)*CeilDiv(s.n,macroN);
for(int task=FirstTask(core,cores,base);task<tasks;task+=cores) {
const Tile tile=MakeTile(start,end,s.n,task,128,macroN);
if ASCEND_IS_AIC {
mm.SetOrgShape(s.m,s.n,s.k,s.k,256);
mm.SetSingleShape(tile.rows,tile.cols,s.k);
mm.SetTensorA(ag[AOffset(tile.row,s.k)]);
mm.SetTensorB(bg[BOffset(e,s.k,s.n,tile.col)]);
int cColumn=0;
while(mm.Iterate()) {
const int slot=ordinal%4;
if(ordinal>=4) CrossCoreWaitFlag(5);
const int64_t offset=(int64_t(slot)*cores+core)*(128*256+macroN);
 
 
 
mm.GetTensorC(cg[offset+macroN-cColumn*256],0,false);
++cColumn;
CrossCoreSetFlag<2,PIPE_FIX>(4);
++ordinal;
}
mm.End();
}
if ASCEND_IS_AIV {
auto ci=cb.Get<int32_t>(); auto z=cb.Get<float>();
auto u=ub.Get<float>(); auto den=ub.Get<float>();
auto sc=sb.Get<float>(); auto out=hb.Get<half>();
const int halfRows=(tile.rows+1)/2;
const int rowOffset=sub*halfRows;
const int rows=Min(halfRows,tile.rows-rowOffset);
for(int colOffset=0;colOffset<tile.cols;colOffset+=256) {
const int cols=Min(256,tile.cols-colOffset);
const int vectorN=CeilDiv(cols,64)*64;
const int count=rows*vectorN;
const int slot=ordinal%4;
const int64_t offset=(int64_t(slot)*cores+core)*(128*256+macroN);
if(rows>0) {
Duplicate(ci,int32_t(0),count);
Duplicate(sc,0.0f,256);
SetFlag<HardEvent::V_MTE2>(EVENT_ID1);
WaitFlag<HardEvent::V_MTE2>(EVENT_ID1);
DataCopyExtParams scaleCopy{1,static_cast<uint32_t>(cols*4),0,0,0};
DataCopyPad(sc,sg[int64_t(e)*s.n+tile.col+colOffset],scaleCopy,
DataCopyPadExtParams<float>{false,0,0,0});
}
CrossCoreWaitFlag(4);
if(rows>0) {
 
const int alignedCols=CeilDiv(cols,8)*8;
DataCopyExtParams inputCopy{static_cast<uint16_t>(rows),
static_cast<uint32_t>(cols*4),static_cast<uint32_t>((256-cols)*4),
static_cast<uint32_t>((vectorN-alignedCols)/8),0};
DataCopyPad(ci,cg[offset+macroN+int64_t(rowOffset)*256],inputCopy,
DataCopyPadExtParams<int32_t>{false,0,0,0});
}
 
 
CrossCoreSetFlag<2,PIPE_MTE2>(5);
if(rows>0) {
SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
Cast(z,ci,RoundMode::CAST_NONE,count); PipeBarrier<PIPE_V>();
BinaryRepeatParams br{1,1,1,static_cast<uint8_t>(vectorN/8),
static_cast<uint8_t>(vectorN/8),0};
for(int c=0;c<cols;c+=64)
Mul(z[c],z[c],sc[c],static_cast<uint64_t>(Min(64,cols-c)),
static_cast<uint8_t>(rows),br);
PipeBarrier<PIPE_V>();
#define REF_VEC(call) do { call; PipeBarrier<PIPE_V>(); } while(false)
REF_VEC(Mul(u,z,z,count));
REF_VEC(Muls(u,u,0.044715f,count));
REF_VEC(Adds(u,u,1.0f,count));
REF_VEC(Mul(u,u,z,count));
REF_VEC(Muls(u,u,1.5957691216057308f,count));
REF_VEC(Muls(u,u,-1.0f,count));
REF_VEC(Mins(u,u,80.0f,count));
REF_VEC(Exp(u,u,count));
REF_VEC(Adds(den,u,1.0f,count));
REF_VEC(Div(z,z,den,count));
if(outputPending) { WaitFlag<HardEvent::MTE3_V>(EVENT_ID0); outputPending=false; }
REF_VEC(Cast(out,z,RoundMode::CAST_RINT,count));
#undef REF_VEC
SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
DataCopyExtParams outputCopy{static_cast<uint16_t>(rows),
static_cast<uint32_t>(cols*2),
static_cast<uint32_t>((vectorN-CeilDiv(cols,16)*16)/16),
static_cast<uint32_t>((s.n-cols)*2),0};
if(cols==s.n && vectorN==cols) {
outputCopy.blockCount=1;
outputCopy.blockLen=static_cast<uint32_t>(rows*cols*2);
}
DataCopyPad(yg[int64_t(tile.row+rowOffset)*s.n+tile.col+colOffset],
out,outputCopy);
SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
outputPending=true;
SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
}
++ordinal;
}
}
}
start=end; base+=tasks;
}
if ASCEND_IS_AIV {
if(outputPending) WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
}
if ASCEND_IS_AIC {
for(int i=0;i<Min(ordinal,4);++i) CrossCoreWaitFlag(5);
}
}

__global__ __aicore__ void HBStreamKGroupedMatmulGelu(
GM_ADDR x,GM_ADDR w,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,
GM_ADDR scratch,GM_ADDR workspace,int64_t workspacePerCore,
GM_ADDR tilingGm,uint64_t syncBase,Shape s,int cores,int macroN) {
KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
SetSyncBaseAddr(syncBase);
int core=GetBlockIdx();
if ASCEND_IS_AIV { core/=2; }
const int sub=GetSubBlockIdx();
TPipe pipe;
TCubeTiling tiling;
RefMM mm;
if ASCEND_IS_AIC {
auto* dst=reinterpret_cast<uint32_t*>(&tiling);
auto* src=reinterpret_cast<__gm__ uint32_t*>(tilingGm);
for(uint32_t i=0;i<sizeof(TCubeTiling)/sizeof(uint32_t);++i) dst[i]=src[i];
GM_ADDR sys=workspace+int64_t(core)*workspacePerCore;
SetSysWorkspaceForce(sys);
clearWorkspace(sys);
mm.SetSubBlockIdx(0);
mm.Init(&tiling,&pipe);
}
GlobalTensor<int8_t> ag,bg;
GlobalTensor<int32_t> cg;
GlobalTensor<float> sg;
GlobalTensor<int64_t> gg;
GlobalTensor<half> yg;
ag.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
bg.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(w));
cg.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(scratch));
sg.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scale));
gg.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups));
yg.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y));
 
TBuf<TPosition::VECCALC> cb,ub,sb,hb;
if ASCEND_IS_AIV {
pipe.InitBuffer(cb,8192*4); pipe.InitBuffer(ub,8192*4);
pipe.InitBuffer(sb,256*4); pipe.InitBuffer(hb,8192*2);
}
bool outputPending=false;
int start=0,base=0,ordinal=0;
for(int e=0;e<s.e;++e) {
const int end=static_cast<int>(gg.GetValue(e));
const int tasks=CeilDiv(end-start,64)*CeilDiv(s.n,macroN);
for(int task=FirstTask(core,cores,base);task<tasks;task+=cores) {
const Tile tile=MakeTile(start,end,s.n,task,64,macroN);
if ASCEND_IS_AIC {
mm.SetOrgShape(s.m,s.n,s.k,s.k,256);
mm.SetSingleShape(tile.rows,tile.cols,s.k);
mm.SetTensorA(ag[AOffset(tile.row,s.k)]);
mm.SetTensorB(bg[BOffset(e,s.k,s.n,tile.col)]);
while(mm.Iterate()) {
const int slot=ordinal%4;
if(ordinal>=4) CrossCoreWaitFlag(5);
const int64_t offset=(int64_t(slot)*cores+core)*64*256;
 
mm.GetTensorC(cg[offset],0,false);
CrossCoreSetFlag<2,PIPE_FIX>(4);
++ordinal;
}
mm.End();
}
if ASCEND_IS_AIV {
auto ci=cb.Get<int32_t>(); auto z=cb.Get<float>();
auto u=ub.Get<float>(); auto den=ub.Get<float>();
auto sc=sb.Get<float>(); auto out=hb.Get<half>();
const int halfRows=(tile.rows+1)/2;
const int rowOffset=sub*halfRows;
const int rows=Min(halfRows,tile.rows-rowOffset);
for(int colOffset=0;colOffset<tile.cols;colOffset+=256) {
const int cols=Min(256,tile.cols-colOffset);
const int vectorN=CeilDiv(cols,64)*64;
const int count=rows*vectorN;
const int slot=ordinal%4;
const int64_t offset=(int64_t(slot)*cores+core)*64*256;
if(rows>0) {
Duplicate(ci,int32_t(0),count);
Duplicate(sc,0.0f,256);
SetFlag<HardEvent::V_MTE2>(EVENT_ID1);
WaitFlag<HardEvent::V_MTE2>(EVENT_ID1);
DataCopyExtParams scaleCopy{1,static_cast<uint32_t>(cols*4),0,0,0};
DataCopyPad(sc,sg[int64_t(e)*s.n+tile.col+colOffset],scaleCopy,
DataCopyPadExtParams<float>{false,0,0,0});
}
CrossCoreWaitFlag(4);
if(rows>0) {
 
const int alignedCols=CeilDiv(cols,8)*8;
DataCopyExtParams inputCopy{static_cast<uint16_t>(rows),
static_cast<uint32_t>(cols*4),static_cast<uint32_t>((256-cols)*4),
static_cast<uint32_t>((vectorN-alignedCols)/8),0};
DataCopyPad(ci,cg[offset+int64_t(rowOffset)*256],inputCopy,
DataCopyPadExtParams<int32_t>{false,0,0,0});
}
 
 
CrossCoreSetFlag<2,PIPE_MTE2>(5);
if(rows>0) {
SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
Cast(z,ci,RoundMode::CAST_NONE,count); PipeBarrier<PIPE_V>();
BinaryRepeatParams br{1,1,1,static_cast<uint8_t>(vectorN/8),
static_cast<uint8_t>(vectorN/8),0};
for(int c=0;c<cols;c+=64)
Mul(z[c],z[c],sc[c],static_cast<uint64_t>(Min(64,cols-c)),
static_cast<uint8_t>(rows),br);
PipeBarrier<PIPE_V>();
#define REF_VEC(call) do { call; PipeBarrier<PIPE_V>(); } while(false)
REF_VEC(Mul(u,z,z,count));
REF_VEC(Muls(u,u,0.044715f,count));
REF_VEC(Adds(u,u,1.0f,count));
REF_VEC(Mul(u,u,z,count));
REF_VEC(Muls(u,u,1.5957691216057308f,count));
REF_VEC(Muls(u,u,-1.0f,count));
REF_VEC(Mins(u,u,80.0f,count));
REF_VEC(Exp(u,u,count));
REF_VEC(Adds(den,u,1.0f,count));
REF_VEC(Div(z,z,den,count));
if(outputPending) { WaitFlag<HardEvent::MTE3_V>(EVENT_ID0); outputPending=false; }
REF_VEC(Cast(out,z,RoundMode::CAST_RINT,count));
#undef REF_VEC
SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
DataCopyExtParams outputCopy{static_cast<uint16_t>(rows),
static_cast<uint32_t>(cols*2),
static_cast<uint32_t>((vectorN-CeilDiv(cols,16)*16)/16),
static_cast<uint32_t>((s.n-cols)*2),0};
if(cols==s.n && vectorN==cols) {
outputCopy.blockCount=1;
outputCopy.blockLen=static_cast<uint32_t>(rows*cols*2);
}
DataCopyPad(yg[int64_t(tile.row+rowOffset)*s.n+tile.col+colOffset],
out,outputCopy);
SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
outputPending=true;
SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
}
++ordinal;
}
}
}
start=end; base+=tasks;
}
if ASCEND_IS_AIV {
if(outputPending) WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
}
if ASCEND_IS_AIC {
for(int i=0;i<Min(ordinal,4);++i) CrossCoreWaitFlag(5);
}
}

__aicore__ inline void HBChunkFinishNZFrame(
const ERSNZFrame& frame,Shape s,const LocalTensor<int8_t>& raw,
const LocalTensor<int8_t>& packed,GlobalTensor<int8_t>& output,bool& outputPending,GM_ADDR readyGm) {
const int kPad=CeilDiv(s.k,128)*128,nPad=CeilDiv(s.n,32)*32;
WaitFlag<HardEvent::MTE2_V>(frame.bank==0?EVENT_ID2:EVENT_ID3);
if(outputPending) {
WaitFlag<HardEvent::MTE3_V>(EVENT_ID2);
outputPending=false;
}
for(int panel=0;panel<nPad/32;++panel) {
DataCopyParams rearrange{64,1,static_cast<uint16_t>(nPad/32-1),0};
DataCopy(packed[panel*64*32],raw[panel*32],rearrange);
}
SetFlag<HardEvent::V_MTE3>(EVENT_ID2);
WaitFlag<HardEvent::V_MTE3>(EVENT_ID2);
const int storeRows=Min(64,kPad-frame.kStart);
DataCopyExtParams store{static_cast<uint16_t>(nPad/32),static_cast<uint32_t>(storeRows*32),static_cast<uint32_t>(64-storeRows),
static_cast<uint32_t>((kPad-storeRows)*32),0};
DataCopyPad(output[int64_t(frame.expert)*kPad*nPad+int64_t(frame.kStart)*32],packed,store);
 
 
SetFlag<HardEvent::MTE3_S>(EVENT_ID2);
WaitFlag<HardEvent::MTE3_S>(EVENT_ID2);
outputPending=false;
GlobalTensor<int64_t> ready;
ready.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(readyGm));
const int frames=CeilDiv(kPad,64);
auto row=ready[(frame.expert*frames+frame.kStart/64)*8];
row.SetValue(0,int64_t(1));
DataCacheCleanAndInvalid<int64_t,CacheLine::SINGLE_CACHE_LINE,DcciDst::CACHELINE_OUT>(row);
 
 
 
 
const int chunks=CeilDiv(kPad,896);
const int chunk=frame.kStart/896;
const int first=chunk*14,limit=Min(frames,(chunk+1)*14);
if(frame.kStart/64==limit-1) {
volatile __gm__ int64_t* flags=reinterpret_cast<volatile __gm__ int64_t*>(readyGm);
for(int f=first;f<limit;++f) {
const int index=(frame.expert*frames+f)*8;
auto inputRow=ready[index];
while(true) {
DataCacheCleanAndInvalid<int64_t,CacheLine::SINGLE_CACHE_LINE,DcciDst::CACHELINE_OUT>(inputRow);
if(flags[index]==1) break;
}
}
auto expertRow=ready[(s.e*frames+frame.expert*chunks+chunk)*8];
expertRow.SetValue(0,int64_t(1));
DataCacheCleanAndInvalid<int64_t,CacheLine::SINGLE_CACHE_LINE,DcciDst::CACHELINE_OUT>(expertRow);
}
SetFlag<HardEvent::S_V>(EVENT_ID2);
WaitFlag<HardEvent::S_V>(EVENT_ID2);
}
__aicore__ inline void HBChunkPrepareNZB(
GM_ADDR weights,GM_ADDR packedWeights,GM_ADDR groups,Shape s,int aiv,int aivs,
const LocalTensor<int8_t>& raw0,const LocalTensor<int8_t>& raw1,const LocalTensor<int8_t>& packed,GM_ADDR readyGm) {
GlobalTensor<int8_t> input,output;
GlobalTensor<int64_t> endpoints;
input.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(weights));
output.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(packedWeights));
endpoints.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups));
const int kPad=CeilDiv(s.k,128)*128,nPad=CeilDiv(s.n,32)*32;
const int frames=CeilDiv(kPad,64);
bool outputPending=false,havePrevious=false;
ERSNZFrame previous{};
int ordinal=0;
for(int task=aiv;task<s.e*frames;task+=aivs) {
const int expert=task/frames;
const int end=static_cast<int>(endpoints.GetValue(expert));
const int start=expert==0?0:static_cast<int>(endpoints.GetValue(expert-1));
if(end==start) continue;
const int bank=ordinal%2,kStart=(task%frames)*64;
const int rows=kStart<s.k?Min(64,s.k-kStart):0;
auto raw=bank==0?raw0:raw1;
 
PipeBarrier<PIPE_V>();
Duplicate(raw.ReinterpretCast<int32_t>(),int32_t(0),64*nPad/4);
SetFlag<HardEvent::V_MTE2>(bank==0?EVENT_ID4:EVENT_ID5);
WaitFlag<HardEvent::V_MTE2>(bank==0?EVENT_ID4:EVENT_ID5);
if(rows>0) {
DataCopyExtParams copy{static_cast<uint16_t>(rows),static_cast<uint32_t>(s.n),0,0,0};
DataCopyPad(raw,input[(int64_t(expert)*s.k+kStart)*s.n],copy,
DataCopyPadExtParams<int8_t>{false,0,0,0});
}
SetFlag<HardEvent::MTE2_V>(bank==0?EVENT_ID2:EVENT_ID3);
if(havePrevious) {
HBChunkFinishNZFrame(previous,s,previous.bank==0?raw0:raw1,packed,output,outputPending,readyGm);
}
previous={expert,kStart,bank};
havePrevious=true;
++ordinal;
}
if(havePrevious) {
HBChunkFinishNZFrame(previous,s,previous.bank==0?raw0:raw1,packed,output,outputPending,readyGm);
}
if(outputPending) WaitFlag<HardEvent::MTE3_V>(EVENT_ID2);
 
SetFlag<HardEvent::V_MTE2>(EVENT_ID1);
WaitFlag<HardEvent::V_MTE2>(EVENT_ID1);
}

__aicore__ inline void HBChunkReadyProduce(
Catlass::Arch::Resource<Catlass::Arch::AtlasA2>& resource,
GM_ADDR x,GM_ADDR packedW,GM_ADDR groups,GM_ADDR scratch,
Shape s,int core,int cores,int macroN,GM_ADDR readyGm) {
using Policy=Catlass::Gemm::MmadAtlasA2PreloadAsyncWithCallback<1,2,2,2,1,false,false>;
using AType=Catlass::Gemm::GemmType<int8_t,Catlass::layout::RowMajor>;
using BType=Catlass::Gemm::GemmType<int8_t,Catlass::layout::zN>;
using CType=Catlass::Gemm::GemmType<int32_t,Catlass::layout::RowMajor>;
using Block=Catlass::Gemm::Block::HBChunkReadyMmad<Policy,
Catlass::GemmShape<96,192,896>,Catlass::GemmShape<96,192,128>,AType,BType,CType>;
Block block(resource);
GlobalTensor<int8_t> ag,bg;
GlobalTensor<int32_t> cg;
GlobalTensor<int64_t> gg;
ag.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
bg.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(packedW));
cg.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(scratch));
gg.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups));
const int packedK=CeilDiv(s.k,128)*128;
const int packedN=CeilDiv(s.n,32)*32;
const auto bLayout=Catlass::layout::zN::MakeLayout<int8_t>(packedK,packedN);
HDMWaitSlot waits[4];
HDMPublishSlot publishes[4];
int start=0,base=0,ordinal=0;
for(int e=0;e<s.e;++e) {
const int end=static_cast<int>(gg.GetValue(e));
const int tasks=CeilDiv(end-start,96)*CeilDiv(s.n,macroN);
block.SetReadyContext(reinterpret_cast<__gm__ int64_t*>(readyGm),s.e*(packedK/64)+e*CeilDiv(packedK,896));
for(int task=FirstTask(core,cores,base);task<tasks;task+=cores) {
const Tile tile=MakeTile(start,end,s.n,task,96,macroN);
for(int colOffset=0;colOffset<tile.cols;colOffset+=192) {
const int cols=Min(192,tile.cols-colOffset);
const int slot=ordinal%4;
Callback before;
if(ordinal>=4) before=MakeCallback(&waits[slot]);
auto after=MakeCallback(&publishes[slot]);
const int64_t offset=(int64_t(slot)*cores+core)*96*192;
block(ag[int64_t(tile.row)*s.k],Catlass::layout::RowMajor(tile.rows,s.k),
bg[int64_t(e)*packedK*packedN+int64_t(tile.col+colOffset)*packedK],bLayout,
cg[offset],Catlass::layout::RowMajor(tile.rows,192),
Catlass::GemmCoord(tile.rows,cols,s.k),before,after);
++ordinal;
}
}
start=end; base+=tasks;
}
block.SynchronizeBlock();
for(int i=0;i<Min(ordinal,4);++i) CrossCoreWaitFlag(5);
}

__global__ __aicore__ void HBChunkReadyGroupedMatmulGelu(
GM_ADDR x,GM_ADDR w,GM_ADDR packedW,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,
GM_ADDR scratch,GM_ADDR workspace,int64_t workspacePerCore,
GM_ADDR tilingGm,uint64_t syncBase,Shape s,int cores,int macroN,GM_ADDR readyGm) {
KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
SetSyncBaseAddr(syncBase);
InitializeReadyInKernel(readyGm,s.e*((CeilDiv(s.k,128)*128)/64+CeilDiv(CeilDiv(s.k,128)*128,896))*64,cores);
int core=GetBlockIdx();
if ASCEND_IS_AIV { core/=2; }
const int sub=GetSubBlockIdx();
Catlass::Arch::Resource<Catlass::Arch::AtlasA2> resource;
GlobalTensor<int8_t> ag,bg;
GlobalTensor<int32_t> cg;
GlobalTensor<float> sg;
GlobalTensor<int64_t> gg;
GlobalTensor<half> yg;
ag.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
bg.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(packedW));
cg.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(scratch));
sg.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scale));
gg.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups));
yg.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y));
 
const int packedK=CeilDiv(s.k,128)*128;
const int packedN=CeilDiv(s.n,32)*32;
const int frameBytes=64*packedN;
auto arena=resource.ubBuf.GetBufferByByte<int8_t>(0);
if ASCEND_IS_AIV {
HBChunkPrepareNZB(w,packedW,groups,s,core*2+sub,cores*2,
arena.ReinterpretCast<int8_t>(),arena.ReinterpretCast<int8_t>()[frameBytes],arena.ReinterpretCast<int8_t>()[2*frameBytes],readyGm);
}
 
if ASCEND_IS_AIC {
HBChunkReadyProduce(resource,x,packedW,groups,scratch,s,core,cores,macroN,readyGm);
return;
}
bool outputPending=false;
int start=0,base=0,ordinal=0;
for(int e=0;e<s.e;++e) {
const int end=static_cast<int>(gg.GetValue(e));
const int tasks=CeilDiv(end-start,96)*CeilDiv(s.n,macroN);
for(int task=FirstTask(core,cores,base);task<tasks;task+=cores) {
const Tile tile=MakeTile(start,end,s.n,task,96,macroN);
if ASCEND_IS_AIV {
auto ci=arena.ReinterpretCast<int32_t>(); auto z=arena.ReinterpretCast<float>();
auto u=arena.ReinterpretCast<float>()[16384]; auto den=arena.ReinterpretCast<float>()[16384];
auto sc=arena.ReinterpretCast<float>()[32768]; auto out=arena.ReinterpretCast<half>()[66048];
const int halfRows=(tile.rows+1)/2;
const int rowOffset=sub*halfRows;
const int rows=Min(halfRows,tile.rows-rowOffset);
for(int colOffset=0;colOffset<tile.cols;colOffset+=192) {
const int cols=Min(192,tile.cols-colOffset);
const int vectorN=CeilDiv(cols,64)*64;
const int count=rows*vectorN;
const int slot=ordinal%4;
const int64_t offset=(int64_t(slot)*cores+core)*96*192;
if(rows>0) {
Duplicate(ci,int32_t(0),count);
Duplicate(sc,0.0f,256);
SetFlag<HardEvent::V_MTE2>(EVENT_ID1);
WaitFlag<HardEvent::V_MTE2>(EVENT_ID1);
DataCopyExtParams scaleCopy{1,static_cast<uint32_t>(cols*4),0,0,0};
DataCopyPad(sc,sg[int64_t(e)*s.n+tile.col+colOffset],scaleCopy,
DataCopyPadExtParams<float>{false,0,0,0});
}
CrossCoreWaitFlag(4);
if(rows>0) {
 
const int alignedCols=CeilDiv(cols,8)*8;
DataCopyExtParams inputCopy{static_cast<uint16_t>(rows),
static_cast<uint32_t>(cols*4),static_cast<uint32_t>((192-cols)*4),
static_cast<uint32_t>((vectorN-alignedCols)/8),0};
DataCopyPad(ci,cg[offset+int64_t(rowOffset)*192],inputCopy,
DataCopyPadExtParams<int32_t>{false,0,0,0});
}
 
 
CrossCoreSetFlag<2,PIPE_MTE2>(5);
if(rows>0) {
SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
Cast(z,ci,RoundMode::CAST_NONE,count); PipeBarrier<PIPE_V>();
BinaryRepeatParams br{1,1,1,static_cast<uint8_t>(vectorN/8),
static_cast<uint8_t>(vectorN/8),0};
for(int c=0;c<cols;c+=64)
Mul(z[c],z[c],sc[c],static_cast<uint64_t>(Min(64,cols-c)),
static_cast<uint8_t>(rows),br);
PipeBarrier<PIPE_V>();
#define REF_VEC(call) do { call; PipeBarrier<PIPE_V>(); } while(false)
REF_VEC(Mul(u,z,z,count));
REF_VEC(Muls(u,u,0.044715f,count));
REF_VEC(Adds(u,u,1.0f,count));
REF_VEC(Mul(u,u,z,count));
REF_VEC(Muls(u,u,1.5957691216057308f,count));
REF_VEC(Muls(u,u,-1.0f,count));
REF_VEC(Mins(u,u,80.0f,count));
REF_VEC(Exp(u,u,count));
REF_VEC(Adds(den,u,1.0f,count));
REF_VEC(Div(z,z,den,count));
if(outputPending) { WaitFlag<HardEvent::MTE3_V>(EVENT_ID0); outputPending=false; }
REF_VEC(Cast(out,z,RoundMode::CAST_RINT,count));
#undef REF_VEC
SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
DataCopyExtParams outputCopy{static_cast<uint16_t>(rows),
static_cast<uint32_t>(cols*2),
static_cast<uint32_t>((vectorN-CeilDiv(cols,16)*16)/16),
static_cast<uint32_t>((s.n-cols)*2),0};
if(cols==s.n && vectorN==cols) {
outputCopy.blockCount=1;
outputCopy.blockLen=static_cast<uint32_t>(rows*cols*2);
}
DataCopyPad(yg[int64_t(tile.row+rowOffset)*s.n+tile.col+colOffset],
out,outputCopy);
SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
outputPending=true;
SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
}
++ordinal;
}
}
}
start=end; base+=tasks;
}
if ASCEND_IS_AIV {
if(outputPending) WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
}
}

__aicore__ inline void HBBalancedNativeProduce(
Catlass::Arch::Resource<Catlass::Arch::AtlasA2>& resource,
GM_ADDR x,GM_ADDR packedW,GM_ADDR groups,GM_ADDR scratch,
Shape s,int core,int cores,int macroN) {
using Policy=Catlass::Gemm::MmadAtlasA2PreloadAsyncWithCallback<1,2,2,2,1,false,true>;
using AType=Catlass::Gemm::GemmType<int8_t,Catlass::layout::RowMajor>;
using BType=Catlass::Gemm::GemmType<int8_t,Catlass::layout::zN>;
using CType=Catlass::Gemm::GemmType<int32_t,Catlass::layout::RowMajor>;
using Block=Catlass::Gemm::Block::BlockMmad<Policy,
Catlass::GemmShape<96,192,896>,Catlass::GemmShape<96,192,128>,AType,BType,CType>;
Block block(resource);
GlobalTensor<int8_t> ag,bg;
GlobalTensor<int32_t> cg;
GlobalTensor<int64_t> gg;
ag.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
bg.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(packedW));
cg.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(scratch));
gg.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups));
const int packedK=CeilDiv(s.k,128)*128;
const int packedN=CeilDiv(s.n,32)*32;
const auto bLayout=Catlass::layout::zN::MakeLayout<int8_t>(packedK,packedN);
HDMWaitSlot waits[4];
HDMPublishSlot publishes[4];
int start=0,base=0,ordinal=0;
for(int e=0;e<s.e;++e) {
const int end=static_cast<int>(gg.GetValue(e));
const int tasks=CeilDiv(end-start,96)*CeilDiv(s.n,macroN);
for(int task=FirstTask(core,cores,base);task<tasks;task+=cores) {
const Tile tile=MakeTile(start,end,s.n,task,96,macroN);
for(int colOffset=0;colOffset<tile.cols;colOffset+=192) {
const int cols=Min(192,tile.cols-colOffset);
const int slot=ordinal%4;
Callback before;
if(ordinal>=4) before=MakeCallback(&waits[slot]);
auto after=MakeCallback(&publishes[slot]);
const int64_t offset=(int64_t(slot)*cores+core)*96*192;
block(ag[int64_t(tile.row)*s.k],Catlass::layout::RowMajor(tile.rows,s.k),
bg[int64_t(e)*packedK*packedN+int64_t(tile.col+colOffset)*packedK],bLayout,
cg[offset],Catlass::layout::RowMajor(tile.rows,192),
Catlass::GemmCoord(tile.rows,cols,s.k),before,after);
++ordinal;
}
}
start=end; base+=tasks;
}
block.SynchronizeBlock();
for(int i=0;i<Min(ordinal,4);++i) CrossCoreWaitFlag(5);
}

__global__ __aicore__ void HBBalancedNativeGroupedMatmulGelu(
GM_ADDR x,GM_ADDR w,GM_ADDR packedW,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,
GM_ADDR scratch,GM_ADDR workspace,int64_t workspacePerCore,
GM_ADDR tilingGm,uint64_t syncBase,Shape s,int cores,int macroN) {
KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
SetSyncBaseAddr(syncBase);
int core=GetBlockIdx();
if ASCEND_IS_AIV { core/=2; }
const int sub=GetSubBlockIdx();
Catlass::Arch::Resource<Catlass::Arch::AtlasA2> resource;
GlobalTensor<int8_t> ag,bg;
GlobalTensor<int32_t> cg;
GlobalTensor<float> sg;
GlobalTensor<int64_t> gg;
GlobalTensor<half> yg;
ag.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
bg.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(packedW));
cg.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(scratch));
sg.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scale));
gg.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups));
yg.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y));
 
const int packedK=CeilDiv(s.k,128)*128;
const int packedN=CeilDiv(s.n,32)*32;
const int frameBytes=64*packedN;
auto arena=resource.ubBuf.GetBufferByByte<int8_t>(0);
if ASCEND_IS_AIV {
ERSPrepareNZB(w,packedW,groups,s,core*2+sub,cores*2,
arena.ReinterpretCast<int8_t>(),arena.ReinterpretCast<int8_t>()[frameBytes],arena.ReinterpretCast<int8_t>()[2*frameBytes]);
}
SyncAll<false>();
if ASCEND_IS_AIC {
HBBalancedNativeProduce(resource,x,packedW,groups,scratch,s,core,cores,macroN);
return;
}
bool outputPending=false;
int start=0,base=0,ordinal=0;
for(int e=0;e<s.e;++e) {
const int end=static_cast<int>(gg.GetValue(e));
const int tasks=CeilDiv(end-start,96)*CeilDiv(s.n,macroN);
for(int task=FirstTask(core,cores,base);task<tasks;task+=cores) {
const Tile tile=MakeTile(start,end,s.n,task,96,macroN);
if ASCEND_IS_AIV {
auto ci=arena.ReinterpretCast<int32_t>(); auto z=arena.ReinterpretCast<float>();
auto u=arena.ReinterpretCast<float>()[16384]; auto den=arena.ReinterpretCast<float>()[16384];
auto sc=arena.ReinterpretCast<float>()[32768]; auto out=arena.ReinterpretCast<half>()[66048];
const int halfRows=(tile.rows+1)/2;
const int rowOffset=sub*halfRows;
const int rows=Min(halfRows,tile.rows-rowOffset);
for(int colOffset=0;colOffset<tile.cols;colOffset+=192) {
const int cols=Min(192,tile.cols-colOffset);
const int vectorN=CeilDiv(cols,64)*64;
const int count=rows*vectorN;
const int slot=ordinal%4;
const int64_t offset=(int64_t(slot)*cores+core)*96*192;
if(rows>0) {
Duplicate(ci,int32_t(0),count);
Duplicate(sc,0.0f,256);
SetFlag<HardEvent::V_MTE2>(EVENT_ID1);
WaitFlag<HardEvent::V_MTE2>(EVENT_ID1);
DataCopyExtParams scaleCopy{1,static_cast<uint32_t>(cols*4),0,0,0};
DataCopyPad(sc,sg[int64_t(e)*s.n+tile.col+colOffset],scaleCopy,
DataCopyPadExtParams<float>{false,0,0,0});
}
CrossCoreWaitFlag(4);
if(rows>0) {
 
const int alignedCols=CeilDiv(cols,8)*8;
DataCopyExtParams inputCopy{static_cast<uint16_t>(rows),
static_cast<uint32_t>(cols*4),static_cast<uint32_t>((192-cols)*4),
static_cast<uint32_t>((vectorN-alignedCols)/8),0};
DataCopyPad(ci,cg[offset+int64_t(rowOffset)*192],inputCopy,
DataCopyPadExtParams<int32_t>{false,0,0,0});
}
 
 
CrossCoreSetFlag<2,PIPE_MTE2>(5);
if(rows>0) {
SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
Cast(z,ci,RoundMode::CAST_NONE,count); PipeBarrier<PIPE_V>();
BinaryRepeatParams br{1,1,1,static_cast<uint8_t>(vectorN/8),
static_cast<uint8_t>(vectorN/8),0};
for(int c=0;c<cols;c+=64)
Mul(z[c],z[c],sc[c],static_cast<uint64_t>(Min(64,cols-c)),
static_cast<uint8_t>(rows),br);
PipeBarrier<PIPE_V>();
#define REF_VEC(call) do { call; PipeBarrier<PIPE_V>(); } while(false)
REF_VEC(Mul(u,z,z,count));
REF_VEC(Muls(u,u,0.044715f,count));
REF_VEC(Adds(u,u,1.0f,count));
REF_VEC(Mul(u,u,z,count));
REF_VEC(Muls(u,u,1.5957691216057308f,count));
REF_VEC(Muls(u,u,-1.0f,count));
REF_VEC(Mins(u,u,80.0f,count));
REF_VEC(Exp(u,u,count));
REF_VEC(Adds(den,u,1.0f,count));
REF_VEC(Div(z,z,den,count));
if(outputPending) { WaitFlag<HardEvent::MTE3_V>(EVENT_ID0); outputPending=false; }
REF_VEC(Cast(out,z,RoundMode::CAST_RINT,count));
#undef REF_VEC
SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
DataCopyExtParams outputCopy{static_cast<uint16_t>(rows),
static_cast<uint32_t>(cols*2),
static_cast<uint32_t>((vectorN-CeilDiv(cols,16)*16)/16),
static_cast<uint32_t>((s.n-cols)*2),0};
if(cols==s.n && vectorN==cols) {
outputCopy.blockCount=1;
outputCopy.blockLen=static_cast<uint32_t>(rows*cols*2);
}
DataCopyPad(yg[int64_t(tile.row+rowOffset)*s.n+tile.col+colOffset],
out,outputCopy);
SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
outputPending=true;
SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
}
++ordinal;
}
}
}
start=end; base+=tasks;
}
if ASCEND_IS_AIV {
if(outputPending) WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
}
}

