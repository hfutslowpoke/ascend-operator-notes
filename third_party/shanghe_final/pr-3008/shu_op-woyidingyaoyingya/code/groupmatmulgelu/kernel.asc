__aicore__ inline void BulkResidentBProduce(Catlass::Arch::Resource<Catlass::Arch::AtlasA2>& resource,
GM_ADDR x,GM_ADDR w,GM_ADDR groups,
GM_ADDR scratch,Shape s,int core,int cores) {
using ArchTag=Catlass::Arch::AtlasA2;
using Policy=Catlass::Gemm::MmadAtlasA2PreloadAsyncWithCallback<1,2,2,2,1,false,true>;
using AType=Catlass::Gemm::GemmType<int8_t,Catlass::layout::RowMajor>;
using BType=Catlass::Gemm::GemmType<int8_t,Catlass::layout::RowMajor>;
using CType=Catlass::Gemm::GemmType<int32_t,Catlass::layout::RowMajor>;
using Block=Catlass::Gemm::Block::BulkResidentBStreamAMmad<Policy,
Catlass::GemmShape<128,192,256>,Catlass::GemmShape<128,192,128>,AType,BType,CType>;
Block block(resource);
GlobalTensor<int8_t> ag,bg;
GlobalTensor<int32_t> cg;
GlobalTensor<int64_t> gg;
ag.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
bg.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(w));
cg.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(scratch));
gg.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups));
HDMWaitSlot waits[4];
HDMPublishSlot publishes[4];
int start=0,base=0,ordinal=0;
for(int e=0;e<s.e;++e) {
const int end=static_cast<int>(gg.GetValue(e));
const int rowPanels=CeilDiv(end-start,1024);
const int tasks=rowPanels*CeilDiv(s.n,192);
for(int task=FirstTask(core,cores,base);task<tasks;task+=cores) {
const int panelStart=start+(task%rowPanels)*1024;
const int panelEnd=Min(end,panelStart+1024),col=(task/rowPanels)*192;
const int cols=Min(192,s.n-col);
block.PrepareResidentB(bg[int64_t(e)*s.k*s.n+col],Catlass::layout::RowMajor(s.k,cols,s.n));
for(int row=panelStart;row<panelEnd;row+=128) {
const int rows=Min(128,panelEnd-row);
const int slot=ordinal%4;
Callback before;
if(ordinal>=4) before=MakeCallback(&waits[slot]);
auto after=MakeCallback(&publishes[slot]);
const int64_t offset=(int64_t(slot)*cores+core)*128*256;
block(ag[int64_t(row)*s.k],Catlass::layout::RowMajor(rows,s.k),
bg[int64_t(e)*s.k*s.n+col],Catlass::layout::RowMajor(s.k,s.n),
cg[offset],Catlass::layout::RowMajor(rows,256),
Catlass::GemmCoord(rows,cols,s.k),before,after);
++ordinal;
}
}
start=end; base+=tasks;
}
block.SynchronizeBlock();
for(int i=0;i<Min(ordinal,4);++i) CrossCoreWaitFlag(5);
}

__global__ __aicore__ void BulkResidentBGroupedMatmulGelu(
GM_ADDR x,GM_ADDR w,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,
GM_ADDR scratch,GM_ADDR workspace,int64_t workspacePerCore,
GM_ADDR tilingGm,uint64_t syncBase,Shape s,int cores,int macroN) {
KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
SetSyncBaseAddr(syncBase);
int core=GetBlockIdx();
if ASCEND_IS_AIV { core/=2; }
const int sub=GetSubBlockIdx();
Catlass::Arch::Resource<Catlass::Arch::AtlasA2> resource;
if ASCEND_IS_AIC {
BulkResidentBProduce(resource,x,w,groups,scratch,s,core,cores);
return;
}
GlobalTensor<int8_t> ag,bg;
GlobalTensor<int32_t> cg;
GlobalTensor<float> sg;
GlobalTensor<int64_t> gg;
GlobalTensor<half> yg;
ag.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
bg.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(w));
cg.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(scratch));
sg.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scale));
gg.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups));
yg.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y));
bool outputPending=false;
int start=0,base=0,ordinal=0;
for(int e=0;e<s.e;++e) {
const int end=static_cast<int>(gg.GetValue(e));
const int rowPanels=CeilDiv(end-start,1024);
const int tasks=rowPanels*CeilDiv(s.n,192);
for(int task=FirstTask(core,cores,base);task<tasks;task+=cores) {
const int panelStart=start+(task%rowPanels)*1024;
const int panelEnd=Min(end,panelStart+1024),panelCol=(task/rowPanels)*192;
for(int panelRow=panelStart;panelRow<panelEnd;panelRow+=128) {
const Tile tile{panelRow,panelCol,Min(128,panelEnd-panelRow),Min(192,s.n-panelCol)};
if ASCEND_IS_AIV {
auto ci=resource.ubBuf.GetBufferByByte<int32_t>(0); auto z=resource.ubBuf.GetBufferByByte<float>(32768);
auto u=resource.ubBuf.GetBufferByByte<float>(65536); auto den=resource.ubBuf.GetBufferByByte<float>(98304);
auto sc=resource.ubBuf.GetBufferByByte<float>(131072); auto out=resource.ubBuf.GetBufferByByte<half>(132096);
const int halfRows=(tile.rows+1)/2;
const int subRowOffset=sub*halfRows;
const int subRows=Min(halfRows,tile.rows-subRowOffset);
for(int colOffset=0;colOffset<tile.cols;colOffset+=256) {
const int cols=Min(256,tile.cols-colOffset);
CrossCoreWaitFlag(4);
 
for(int part=0;part<(subRows>0?CeilDiv(subRows,32):1);++part) {
const int rowOffset=subRowOffset+part*32;
const int rows=Min(32,subRows-part*32);
const int count=rows*256;
const int slot=ordinal%4;
const int64_t offset=(int64_t(slot)*cores+core)*128*256;
if(rows>0) {
Duplicate(sc,0.0f,256);
Duplicate(ci,int32_t(0),8192);
SetFlag<HardEvent::V_MTE2>(EVENT_ID1);
WaitFlag<HardEvent::V_MTE2>(EVENT_ID1);
DataCopyExtParams scaleCopy{1,static_cast<uint32_t>(cols*4),0,0,0};
DataCopyPad(sc,sg[int64_t(e)*s.n+tile.col+colOffset],scaleCopy,
DataCopyPadExtParams<float>{false,0,0,0});
}
if(rows>0) {
 
DataCopyExtParams inputCopy{static_cast<uint16_t>(rows),static_cast<uint32_t>(cols*4),
static_cast<uint32_t>((256-cols)*4),static_cast<uint32_t>((256-CeilDiv(cols,8)*8)/8),0};
DataCopyPad(ci,cg[offset+int64_t(rowOffset)*256],inputCopy,
DataCopyPadExtParams<int32_t>{false,0,0,0});
}
 
 
if((part+1)*32>=subRows) CrossCoreSetFlag<2,PIPE_MTE2>(5);
if(rows>0) {
SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
Cast(z,ci,RoundMode::CAST_NONE,count); PipeBarrier<PIPE_V>();
BinaryRepeatParams br{1,1,1,static_cast<uint8_t>(256/8),
static_cast<uint8_t>(256/8),0};
for(int c=0;c<256;c+=64)
Mul(z[c],z[c],sc[c],static_cast<uint64_t>(64),
static_cast<uint8_t>(rows),br);
PipeBarrier<PIPE_V>();
#define REF_VEC(call) do { call; PipeBarrier<PIPE_V>(); } while(false)
REF_VEC(Mul(u,z,z,count));
REF_VEC(Muls(u,u,0.044715f,count));
REF_VEC(Adds(u,u,1.0f,count));
REF_VEC(Mul(u,u,z,count));
REF_VEC(Muls(u,u,1.5957691216057308f,count));
REF_VEC(Muls(u,u,-1.0f,count));
REF_VEC(Mins(u,u,80.0f,count));
REF_VEC(Exp(u,u,count));
REF_VEC(Adds(den,u,1.0f,count));
REF_VEC(Div(z,z,den,count));
if(outputPending) { WaitFlag<HardEvent::MTE3_V>(EVENT_ID0); outputPending=false; }
REF_VEC(Cast(out,z,RoundMode::CAST_RINT,count));
#undef REF_VEC
SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
DataCopyExtParams outputCopy{static_cast<uint16_t>(rows),
static_cast<uint32_t>(cols*2),static_cast<uint32_t>((256-CeilDiv(cols,16)*16)/16),
static_cast<uint32_t>((s.n-cols)*2),0};
if(cols==256 && cols==s.n) {
outputCopy.blockCount=1;
outputCopy.blockLen=static_cast<uint32_t>(rows*cols*2);
}
DataCopyPad(yg[int64_t(tile.row+rowOffset)*s.n+tile.col+colOffset],
out,outputCopy);
SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
outputPending=true;
SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
}
}  
++ordinal;
}
}
}
}  
start=end; base+=tasks;
}
if ASCEND_IS_AIV {
if(outputPending) WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
}
if ASCEND_IS_AIC {
for(int i=0;i<Min(ordinal,4);++i) CrossCoreWaitFlag(5);
}
}



struct RectangularLoadA {
using LayoutSrc=Catlass::layout::zN;
using LayoutDst=Catlass::layout::zZ;
__aicore__ inline void operator()(const LocalTensor<int8_t>& destination,
const LocalTensor<int8_t>& source,const LayoutDst& dst,const LayoutSrc& src) {
constexpr uint8_t padding[4]={0,0,0,0};
const uint16_t l1M=src.shape(0)*src.shape(1);
const uint16_t l1K=src.shape(2)*src.shape(3);
const uint16_t l0M=dst.shape(0)*dst.shape(1);
const uint16_t l0K=dst.shape(2)*dst.shape(3);
SetFmatrix(1,l1M,padding,FmatrixMode::FMATRIX_LEFT);
LoadData3DParamsV2<int8_t> params;
params.kExtension=l0K;
params.mExtension=l0M;
params.channelSize=l1K;
LoadData<int8_t,Catlass::Gemm::Tile::LOAD3DV2_DEFAULT_CONFIG>(destination,source,params);
}
};

template<class AType,class BType,class CType>
struct RectangularATileCopy : Catlass::Gemm::Tile::TileCopy<Catlass::Arch::AtlasA2,AType,BType,CType> {
using CopyL1ToL0A=RectangularLoadA;
};

__aicore__ inline void HDMCachedAProduce(Catlass::Arch::Resource<Catlass::Arch::AtlasA2>& resource,
GM_ADDR x,GM_ADDR w,GM_ADDR groups,
GM_ADDR scratch,Shape s,int core,int cores,int macroN) {
using ArchTag=Catlass::Arch::AtlasA2;
using Policy=Catlass::Gemm::MmadAtlasA2PreloadAsyncWithCallback<1,2,2,2,2,false,true>;
using AType=Catlass::Gemm::GemmType<int8_t,Catlass::layout::RowMajor>;
using BType=Catlass::Gemm::GemmType<int8_t,Catlass::layout::RowMajor>;
using CType=Catlass::Gemm::GemmType<int32_t,Catlass::layout::RowMajor>;
using Block=Catlass::Gemm::Block::HDMCachedAMmad<Policy,
Catlass::GemmShape<64,256,512>,Catlass::GemmShape<64,256,128>,AType,BType,CType,void,RectangularATileCopy<AType,BType,CType>>;
Block block(resource);
GlobalTensor<int8_t> ag,bg;
GlobalTensor<int32_t> cg;
GlobalTensor<int64_t> gg;
ag.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
bg.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(w));
cg.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(scratch));
gg.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups));
HDMWaitSlot waits[4];
HDMPublishSlot publishes[4];
int start=0,base=0,ordinal=0;
for(int e=0;e<s.e;++e) {
const int end=static_cast<int>(gg.GetValue(e));
const int tasks=CeilDiv(end-start,64)*CeilDiv(s.n,macroN);
for(int task=FirstTask(core,cores,base);task<tasks;task+=cores) {
const Tile tile=MakeTile(start,end,s.n,task,64,macroN);
const int row=tile.row,rows=tile.rows;
for(int col=tile.col;col<tile.col+tile.cols;col+=256) {
const int slot=ordinal%4;
Callback before;
if(ordinal>=4) before=MakeCallback(&waits[slot]);
auto after=MakeCallback(&publishes[slot]);
const int64_t offset=(int64_t(slot)*cores+core)*64*256;
block(ag[int64_t(row)*s.k],Catlass::layout::RowMajor(rows,s.k),
bg[int64_t(e)*s.k*s.n+col],Catlass::layout::RowMajor(s.k,s.n),
cg[offset],Catlass::layout::RowMajor(rows,256),
Catlass::GemmCoord(rows,256,s.k),col==tile.col,before,after);
++ordinal;
}
}
start=end; base+=tasks;
}
block.SynchronizeBlock();
for(int i=0;i<Min(ordinal,4);++i) CrossCoreWaitFlag(5);
}

