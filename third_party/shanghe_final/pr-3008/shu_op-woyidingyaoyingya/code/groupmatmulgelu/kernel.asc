__global__ __aicore__ void WideNGroupedMatmulGelu(
GM_ADDR x,GM_ADDR w,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,
GM_ADDR scratch,GM_ADDR workspace,int64_t workspacePerCore,
GM_ADDR tilingGm,uint64_t syncBase,Shape s,int cores,int macroN) {
KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
SetSyncBaseAddr(syncBase);
int core=GetBlockIdx();
if ASCEND_IS_AIV { core/=2; }
const int sub=GetSubBlockIdx();
TPipe pipe;
TCubeTiling tiling;
RefMM mm;
if ASCEND_IS_AIC {
auto* dst=reinterpret_cast<uint32_t*>(&tiling);
auto* src=reinterpret_cast<__gm__ uint32_t*>(tilingGm);
for(uint32_t i=0;i<sizeof(TCubeTiling)/sizeof(uint32_t);++i) dst[i]=src[i];
GM_ADDR sys=workspace+int64_t(core)*workspacePerCore;
SetSysWorkspaceForce(sys);
clearWorkspace(sys);
mm.SetSubBlockIdx(0);
mm.Init(&tiling,&pipe);
}
GlobalTensor<int8_t> ag,bg;
GlobalTensor<int32_t> cg;
GlobalTensor<float> sg;
GlobalTensor<int64_t> gg;
GlobalTensor<half> yg;
ag.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
bg.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(w));
cg.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(scratch));
sg.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scale));
gg.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups));
yg.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y));
TBuf<TPosition::VECCALC> cb,ub,sb,hb;
if ASCEND_IS_AIV {
pipe.InitBuffer(cb,16384*4); pipe.InitBuffer(ub,16384*4);
pipe.InitBuffer(sb,512*4); pipe.InitBuffer(hb,16384*2);
}
int start=0,base=0,ordinal=0;
for(int e=0;e<s.e;++e) {
const int end=static_cast<int>(gg.GetValue(e));
const int tasks=CeilDiv(end-start,64)*CeilDiv(s.n,macroN);
for(int task=FirstTask(core,cores,base);task<tasks;task+=cores) {
const Tile tile=MakeTile(start,end,s.n,task,64,macroN);
if ASCEND_IS_AIC {
mm.SetOrgShape(s.m,s.n,s.k);
mm.SetSingleShape(tile.rows,tile.cols,s.k);
mm.SetTensorA(ag[AOffset(tile.row,s.k)]);
mm.SetTensorB(bg[BOffset(e,s.k,s.n,tile.col)]);
while(mm.Iterate()) {
const int slot=ordinal%4;
if(ordinal>=4) CrossCoreWaitFlag(5);
const int64_t offset=(int64_t(slot)*cores+core)*64*512;
mm.GetTensorC(cg[offset],0,true);
CrossCoreSetFlag<2,PIPE_FIX>(4);
++ordinal;
}
mm.End();
}
if ASCEND_IS_AIV {
auto ci=cb.Get<int32_t>(); auto z=cb.Get<float>();
auto u=ub.Get<float>(); auto den=ub.Get<float>();
auto sc=sb.Get<float>(); auto out=hb.Get<half>();
const int halfRows=(tile.rows+1)/2;
const int rowOffset=sub*halfRows;
const int rows=Min(halfRows,tile.rows-rowOffset);
for(int colOffset=0;colOffset<tile.cols;colOffset+=512) {
const int cols=Min(512,tile.cols-colOffset);
const int count=rows*cols;
const int slot=ordinal%4;
const int64_t offset=(int64_t(slot)*cores+core)*64*512;
if(rows>0) {
DataCopyExtParams scaleCopy{1,static_cast<uint32_t>(cols*4),0,0,0};
DataCopyPad(sc,sg[int64_t(e)*s.n+tile.col+colOffset],scaleCopy,
DataCopyPadExtParams<float>{false,0,0,0});
}
CrossCoreWaitFlag(4);
if(rows>0) {
 
DataCopyExtParams inputCopy{1,static_cast<uint32_t>(rows*cols*4),0,0,0};
DataCopyPad(ci,cg[offset+int64_t(rowOffset)*cols],inputCopy,
DataCopyPadExtParams<int32_t>{false,0,0,0});
}
 
 
CrossCoreSetFlag<2,PIPE_MTE2>(5);
if(rows>0) {
SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
Cast(z,ci,RoundMode::CAST_NONE,count); PipeBarrier<PIPE_V>();
BinaryRepeatParams br{1,1,1,static_cast<uint8_t>(cols/8),
static_cast<uint8_t>(cols/8),0};
for(int c=0;c<cols;c+=64)
Mul(z[c],z[c],sc[c],static_cast<uint64_t>(Min(64,cols-c)),
static_cast<uint8_t>(rows),br);
PipeBarrier<PIPE_V>();
#define REF_VEC(call) do { call; PipeBarrier<PIPE_V>(); } while(false)
REF_VEC(Mul(u,z,z,count));
REF_VEC(Muls(u,u,-0.0713548162726003f,count));
REF_VEC(Adds(u,u,-1.5957691216057308f,count));
REF_VEC(Mul(u,u,z,count));
REF_VEC(Mins(u,u,80.0f,count));
REF_VEC(Exp(u,u,count));
REF_VEC(Adds(den,u,1.0f,count));
REF_VEC(Div(z,z,den,count));
REF_VEC(Cast(out,z,RoundMode::CAST_RINT,count));
#undef REF_VEC
SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
DataCopyExtParams outputCopy{static_cast<uint16_t>(rows),
static_cast<uint32_t>(cols*2),0,
static_cast<uint32_t>((s.n-cols)*2),0};
if(cols==s.n) {
outputCopy.blockCount=1;
outputCopy.blockLen=static_cast<uint32_t>(rows*cols*2);
}
DataCopyPad(yg[int64_t(tile.row+rowOffset)*s.n+tile.col+colOffset],
out,outputCopy);
SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
}
++ordinal;
}
}
}
start=end; base+=tasks;
}
if ASCEND_IS_AIC {
for(int i=0;i<Min(ordinal,4);++i) CrossCoreWaitFlag(5);
}
}
__global__ __aicore__ void WideMGroupedMatmulGelu(
GM_ADDR x,GM_ADDR w,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,
GM_ADDR scratch,GM_ADDR workspace,int64_t workspacePerCore,
GM_ADDR tilingGm,uint64_t syncBase,Shape s,int cores,int macroN) {
KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
SetSyncBaseAddr(syncBase);
int core=GetBlockIdx();
if ASCEND_IS_AIV { core/=2; }
const int sub=GetSubBlockIdx();
TPipe pipe;
TCubeTiling tiling;
RefMM mm;
if ASCEND_IS_AIC {
auto* dst=reinterpret_cast<uint32_t*>(&tiling);
auto* src=reinterpret_cast<__gm__ uint32_t*>(tilingGm);
for(uint32_t i=0;i<sizeof(TCubeTiling)/sizeof(uint32_t);++i) dst[i]=src[i];
GM_ADDR sys=workspace+int64_t(core)*workspacePerCore;
SetSysWorkspaceForce(sys);
clearWorkspace(sys);
mm.SetSubBlockIdx(0);
mm.Init(&tiling,&pipe);
}
GlobalTensor<int8_t> ag,bg;
GlobalTensor<int32_t> cg;
GlobalTensor<float> sg;
GlobalTensor<int64_t> gg;
GlobalTensor<half> yg;
ag.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
bg.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(w));
cg.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(scratch));
sg.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scale));
gg.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups));
yg.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y));
TBuf<TPosition::VECCALC> cb,ub,sb,hb;
if ASCEND_IS_AIV {
pipe.InitBuffer(cb,16384*4); pipe.InitBuffer(ub,16384*4);
pipe.InitBuffer(sb,256*4); pipe.InitBuffer(hb,16384*2);
}
int start=0,base=0,ordinal=0;
for(int e=0;e<s.e;++e) {
const int end=static_cast<int>(gg.GetValue(e));
const int tasks=CeilDiv(end-start,128)*CeilDiv(s.n,macroN);
for(int task=FirstTask(core,cores,base);task<tasks;task+=cores) {
const Tile tile=MakeTile(start,end,s.n,task,128,macroN);
if ASCEND_IS_AIC {
mm.SetOrgShape(s.m,s.n,s.k);
mm.SetSingleShape(tile.rows,tile.cols,s.k);
mm.SetTensorA(ag[AOffset(tile.row,s.k)]);
mm.SetTensorB(bg[BOffset(e,s.k,s.n,tile.col)]);
while(mm.Iterate()) {
const int slot=ordinal%4;
if(ordinal>=4) CrossCoreWaitFlag(5);
const int64_t offset=(int64_t(slot)*cores+core)*128*256;
mm.GetTensorC(cg[offset],0,true);
CrossCoreSetFlag<2,PIPE_FIX>(4);
++ordinal;
}
mm.End();
}
if ASCEND_IS_AIV {
auto ci=cb.Get<int32_t>(); auto z=cb.Get<float>();
auto u=ub.Get<float>(); auto den=ub.Get<float>();
auto sc=sb.Get<float>(); auto out=hb.Get<half>();
for(int colOffset=0;colOffset<tile.cols;colOffset+=256) {
const int cols=Min(256,tile.cols-colOffset);
 
 
for(int rowBase=0;rowBase<tile.rows;rowBase+=128) {
const int baseRows=Min(128,tile.rows-rowBase);
const int halfRows=(baseRows+1)/2;
const int rowOffset=sub*halfRows;
const int rows=Min(halfRows,baseRows-rowOffset);
const int count=rows*cols;
const int slot=ordinal%4;
const int64_t offset=(int64_t(slot)*cores+core)*128*256;
if(rows>0) {
DataCopyExtParams scaleCopy{1,static_cast<uint32_t>(cols*4),0,0,0};
DataCopyPad(sc,sg[int64_t(e)*s.n+tile.col+colOffset],scaleCopy,
DataCopyPadExtParams<float>{false,0,0,0});
}
CrossCoreWaitFlag(4);
if(rows>0) {
 
DataCopyExtParams inputCopy{1,static_cast<uint32_t>(rows*cols*4),0,0,0};
DataCopyPad(ci,cg[offset+int64_t(rowOffset)*cols],inputCopy,
DataCopyPadExtParams<int32_t>{false,0,0,0});
}
 
 
CrossCoreSetFlag<2,PIPE_MTE2>(5);
if(rows>0) {
SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
Cast(z,ci,RoundMode::CAST_NONE,count); PipeBarrier<PIPE_V>();
BinaryRepeatParams br{1,1,1,static_cast<uint8_t>(cols/8),
static_cast<uint8_t>(cols/8),0};
for(int c=0;c<cols;c+=64)
Mul(z[c],z[c],sc[c],static_cast<uint64_t>(Min(64,cols-c)),
static_cast<uint8_t>(rows),br);
PipeBarrier<PIPE_V>();
#define REF_VEC(call) do { call; PipeBarrier<PIPE_V>(); } while(false)
REF_VEC(Mul(u,z,z,count));
REF_VEC(Muls(u,u,-0.0713548162726003f,count));
REF_VEC(Adds(u,u,-1.5957691216057308f,count));
REF_VEC(Mul(u,u,z,count));
REF_VEC(Mins(u,u,80.0f,count));
REF_VEC(Exp(u,u,count));
REF_VEC(Adds(den,u,1.0f,count));
REF_VEC(Div(z,z,den,count));
REF_VEC(Cast(out,z,RoundMode::CAST_RINT,count));
#undef REF_VEC
SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
DataCopyExtParams outputCopy{static_cast<uint16_t>(rows),
static_cast<uint32_t>(cols*2),0,
static_cast<uint32_t>((s.n-cols)*2),0};
if(cols==s.n) {
outputCopy.blockCount=1;
outputCopy.blockLen=static_cast<uint32_t>(rows*cols*2);
}
DataCopyPad(yg[int64_t(tile.row+rowBase+rowOffset)*s.n+tile.col+colOffset],
out,outputCopy);
SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
}
++ordinal;
}
}
}
}
start=end; base+=tasks;
}
if ASCEND_IS_AIC {
for(int i=0;i<Min(ordinal,4);++i) CrossCoreWaitFlag(5);
}
}

template<int tileM,int tileN>
__aicore__ inline void CopyC4FullMatrixInputs(
LocalTensor<int8_t> a1,LocalTensor<int8_t> b1,
GlobalTensor<int8_t>& aGm,GlobalTensor<int8_t>& bGm,
Tile tile,int expert,Shape s,int paddedK) {
if(tile.rows<tileM) {
InitConstValueParams<uint16_t> zero;
zero.repeatTimes=1;
zero.blockNum=tileM*paddedK/32;
zero.dstGap=0;
zero.initValue=0;
InitConstValue(a1.template ReinterpretCast<uint16_t>(),zero);
PipeBarrier<PIPE_MTE2>();
}
Nd2NzParams ac;
ac.ndNum=1;ac.nValue=tile.rows;ac.dValue=s.k;
ac.srcNdMatrixStride=0;ac.srcDValue=s.k;
ac.dstNzC0Stride=tileM;ac.dstNzNStride=1;ac.dstNzMatrixStride=0;
DataCopy(a1,aGm[AOffset(tile.row,s.k)],ac);
Nd2NzParams bc;
bc.ndNum=1;bc.nValue=s.k;bc.dValue=tileN;
bc.srcNdMatrixStride=0;bc.srcDValue=s.n;
bc.dstNzC0Stride=paddedK;bc.dstNzNStride=1;bc.dstNzMatrixStride=0;
DataCopy(b1,bGm[BOffset(expert,s.k,s.n,tile.col)],bc);
}

template<int tileM,int tileN,int reductionK>
__global__ __aicore__ void C4FullMatrixRawGroupedMatmulGelu(
GM_ADDR x,GM_ADDR w,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,
GM_ADDR scratch,uint64_t syncBase,Shape s,int cores) {

KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
SetSyncBaseAddr(syncBase);

const int vectorCapacity=8192;
int core=GetBlockIdx();
if ASCEND_IS_AIV { core/=2; }
const int sub=GetSubBlockIdx();
const int paddedK=reductionK;
TPipe pipe;
TBuf<TPosition::A1> a1buf;
TBuf<TPosition::B1> b1buf;
TBuf<TPosition::A2> a2buf;
TBuf<TPosition::B2> b2buf;
TBuf<TPosition::CO1> cbuf;
if ASCEND_IS_AIC {
pipe.InitBuffer(a1buf,2*tileM*paddedK);
pipe.InitBuffer(b1buf,2*paddedK*tileN);
pipe.InitBuffer(a2buf,2*tileM*128);
pipe.InitBuffer(b2buf,2*128*tileN);
pipe.InitBuffer(cbuf,tileM*tileN*4);
SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);
SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID1);
SetFlag<HardEvent::FIX_M>(EVENT_ID0);
}

GlobalTensor<int8_t> aGm,bGm;
GlobalTensor<half> cGm;
GlobalTensor<float> scaleGm;
GlobalTensor<int64_t> groupGm;
GlobalTensor<half> yGm;
aGm.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
bGm.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(w));
cGm.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(scratch));
scaleGm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scale));
groupGm.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups));
yGm.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y));
TBuf<TPosition::VECCALC> cb,sb,zb,ub,db,hb,groupBuffer;
LocalTensor<int64_t> endpoints;
if ASCEND_IS_AIV {
pipe.InitBuffer(cb,vectorCapacity*4); pipe.InitBuffer(sb,256*4);
pipe.InitBuffer(zb,vectorCapacity*4);
pipe.InitBuffer(ub,vectorCapacity*4);
pipe.InitBuffer(db,vectorCapacity*4);
pipe.InitBuffer(hb,vectorCapacity*2);
pipe.InitBuffer(groupBuffer,128*8);
endpoints=groupBuffer.Get<int64_t>();
DataCopyExtParams groupCopy{1,uint32_t(s.e*8),0,0,0};
DataCopyPad(endpoints,groupGm,groupCopy,DataCopyPadExtParams<int64_t>{false,0,0,0});
SetFlag<HardEvent::MTE2_S>(EVENT_ID0);
WaitFlag<HardEvent::MTE2_S>(EVENT_ID0);
}
bool outputPending=false;
int tileOrdinal=0;
const int pageCount=CeilDiv(s.m,tileM);
const int firstPage=pageCount*core/cores;
const int lastPage=pageCount*(core+1)/cores;
 
const int pagesPerChunk=1+(lastPage-firstPage)/8;
int e=0,boundary=s.m;
if(firstPage<lastPage) {
const int firstRow=firstPage*tileM;
int low=0,high=s.e-1;
while(low<high) {
const int midpoint=(low+high)/2;
int midpointEnd=0;
if ASCEND_IS_AIC {midpointEnd=int(groupGm.GetValue(midpoint));}
if ASCEND_IS_AIV {midpointEnd=int(endpoints.GetValue(midpoint));}
if(firstRow>=midpointEnd) low=midpoint+1;
else {high=midpoint;boundary=midpointEnd;}
}
e=low;
}
const int firstRow=firstPage*tileM;
const int rangeEnd=Min(s.m,lastPage*tileM);
const int chunkRows=pagesPerChunk*tileM;
int chunkOrdinal=0,chunkEnd=Min(rangeEnd,firstRow+chunkRows);
bool needReady=true;
for(int start=firstRow;start<rangeEnd;) {
if ASCEND_IS_AIV {
if(needReady) {
CrossCoreWaitFlag((chunkOrdinal&1)?6:4);
needReady=false;
}
}
while(boundary<=start && e+1<s.e) {
++e;
if ASCEND_IS_AIC {boundary=int(groupGm.GetValue(e));}
if ASCEND_IS_AIV {boundary=int(endpoints.GetValue(e));}
}
const int end=Min(Min(rangeEnd,start+tileM),boundary);
for(int col=0;col<s.n;col+=tileN) {
const Tile tile{start,col,end-start,Min(tileN,s.n-col)};
const int vectorN=CeilDiv(tile.cols,64)*64;
const int batchRows=vectorCapacity/vectorN;
const int scratchSlot=tileOrdinal&1;
if ASCEND_IS_AIC {
const event_t inputEvent=scratchSlot?EVENT_ID1:EVENT_ID0;
auto a1=a1buf.Get<int8_t>()[scratchSlot*tileM*paddedK];

auto a2=a2buf.Get<int8_t>();
auto b2=b2buf.Get<int8_t>();
auto c=cbuf.Get<int32_t>();
if(tileOrdinal==0) {
WaitFlag<HardEvent::MTE1_MTE2>(inputEvent);
auto firstB=b1buf.Get<int8_t>();
CopyC4FullMatrixInputs<tileM,tileN>(a1,firstB,aGm,bGm,tile,e,s,paddedK);
SetFlag<HardEvent::MTE2_MTE1>(inputEvent);
}
WaitFlag<HardEvent::MTE2_MTE1>(inputEvent);
auto b1=b1buf.Get<int8_t>()[scratchSlot*paddedK*tileN];
int nextRow=tile.row,nextCol=tile.col+tileN;
if(nextCol>=s.n) {nextCol=0;nextRow=end;}
if(nextRow<rangeEnd) {
int nextExpert=e,nextBoundary=boundary;
while(nextBoundary<=nextRow && nextExpert+1<s.e)
nextBoundary=int(groupGm.GetValue(++nextExpert));
const int nextEnd=Min(Min(rangeEnd,nextRow+tileM),nextBoundary);
const Tile nextTile{nextRow,nextCol,nextEnd-nextRow,Min(tileN,s.n-nextCol)};
const int nextSlot=1-scratchSlot;
const event_t nextEvent=nextSlot?EVENT_ID1:EVENT_ID0;
WaitFlag<HardEvent::MTE1_MTE2>(nextEvent);
auto nextA=a1buf.Get<int8_t>()[nextSlot*tileM*paddedK];
auto nextB=b1buf.Get<int8_t>()[nextSlot*paddedK*tileN];
CopyC4FullMatrixInputs<tileM,tileN>(nextA,nextB,aGm,bGm,nextTile,nextExpert,s,paddedK);
SetFlag<HardEvent::MTE2_MTE1>(nextEvent);
}
WaitFlag<HardEvent::FIX_M>(EVENT_ID0);
for(int kBase=0;kBase<paddedK;kBase+=128) {
const int stage=(tileOrdinal*(paddedK/128)+kBase/128)&1;
const event_t operandEvent=stage?EVENT_ID1:EVENT_ID0;
LoadData2dParams la;
la.startIndex=0;la.repeatTimes=4;
la.srcStride=tileM/16;la.dstGap=0;la.ifTranspose=false;
for(int rowFractal=0;rowFractal<tileM/16;++rowFractal)
LoadData(a2[stage*tileM*128+rowFractal*128*16],
a1[(kBase/32)*tileM*32+rowFractal*16*32],la);
LoadData2dTransposeParams lb{0,uint8_t(tileN/32),uint16_t(paddedK/32),1,0,inc};
for(int kb=0;kb<4;++kb)
LoadDataWithTranspose(b2[stage*128*tileN+kb*tileN*32],
b1[(kBase/32+kb)*32*32],lb);
SetFlag<HardEvent::MTE1_M>(operandEvent);
WaitFlag<HardEvent::MTE1_M>(operandEvent);
MmadParams mad;
mad.m=tileM;mad.n=tileN;mad.k=128;
mad.cmatrixInitVal=(kBase==0);
Mmad(c,a2[stage*tileM*128],b2[stage*128*tileN],mad);
SetFlag<HardEvent::M_MTE1>(EVENT_ID0);
WaitFlag<HardEvent::M_MTE1>(EVENT_ID0);
}
 
SetFlag<HardEvent::MTE1_MTE2>(inputEvent);
SetFlag<HardEvent::M_FIX>(EVENT_ID0);
WaitFlag<HardEvent::M_FIX>(EVENT_ID0);
C5HalfFixpipeCopy copyResult;
copyResult(cGm[int64_t(tile.row)*s.n+tile.col],c,
Catlass::layout::RowMajor(tile.rows,tileN,s.n),
Catlass::layout::zN::MakeLayoutInL0C(Catlass::MatrixCoord(uint32_t(tileM),uint32_t(tileN))));
SetFlag<HardEvent::FIX_M>(EVENT_ID0);
}
if ASCEND_IS_AIV {
auto ci=cb.Get<half>(); auto sc=sb.Get<float>();
auto z=zb.Get<float>(); auto u=ub.Get<float>();
auto den=db.Get<float>(); auto out=hb.Get<half>();
const int halfRows=(tile.rows+1)/2;
const int rowOffset=sub*halfRows;
const int rows=Min(halfRows,tile.rows-rowOffset);
const int count=rows*tileN;
if(rows>0) {
DataCopyExtParams cp{1,uint32_t(tileN*4),0,0,0};
DataCopyPad(sc,scaleGm[int64_t(e)*s.n+tile.col],cp,DataCopyPadExtParams<float>{false,0,0,0});
}
if(rows>0) {
DataCopyExtParams cp{uint16_t(rows),uint32_t(tileN*2),uint32_t((s.n-tileN)*2),0,0};
if(s.n==tileN) {cp.blockCount=1;cp.blockLen=uint32_t(count*2);}
DataCopyPad(ci,cGm[int64_t(tile.row+rowOffset)*s.n+tile.col],cp,DataCopyPadExtParams<half>{false,0,0,0});
}
if(rows>0) {
SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
Cast(z,ci,RoundMode::CAST_NONE,count); PipeBarrier<PIPE_V>();
Muls(sc,sc,1024.0f,tileN); PipeBarrier<PIPE_V>();
BinaryRepeatParams br{1,1,1,uint8_t(tileN/8),uint8_t(tileN/8),0};
for(int c=0;c<tileN;c+=64)
Mul(z[c],z[c],sc[c],uint64_t(64),uint8_t(rows),br);
PipeBarrier<PIPE_V>();
 
SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
if(outputPending) {
WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
outputPending=false;
}
          GeluFp32ToHalf(z,u,out,count);
SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
DataCopyExtParams cp{uint16_t(rows),uint32_t(tileN*2),0,uint32_t((s.n-tileN)*2),0};
if(s.n==tileN) {cp.blockCount=1;cp.blockLen=uint32_t(count*2);}
DataCopyPad(yGm[int64_t(tile.row+rowOffset)*s.n+tile.col],out,cp);
SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
outputPending=true;

}
}
++tileOrdinal;
}
start=end;
if(start>=chunkEnd || start==rangeEnd) {
if ASCEND_IS_AIC { CrossCoreSetFlag<2,PIPE_FIX>((chunkOrdinal&1)?6:4); }
++chunkOrdinal;
chunkEnd=Min(rangeEnd,chunkEnd+chunkRows);
needReady=true;
}
}
if ASCEND_IS_AIV {
if(outputPending) WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
}
if ASCEND_IS_AIC {
WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);
WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID1);
WaitFlag<HardEvent::FIX_M>(EVENT_ID0);
PipeBarrier<PIPE_ALL>();
}
}

template<class AType,class BType,class CType>
struct C2HalfTransportCopy:RectangularATileCopy<AType,BType,CType> {
using CopyL0CToGm=C5HalfFixpipeCopy;
};

__aicore__ inline void C2BankedHalfProduce(Catlass::Arch::Resource<Catlass::Arch::AtlasA2>& resource,
GM_ADDR x,GM_ADDR w,GM_ADDR groups,
GM_ADDR scratch,Shape s,int core,int cores,int macroN) {
using ArchTag=Catlass::Arch::AtlasA2;
using Policy=Catlass::Gemm::MmadAtlasA2PreloadAsyncWithCallback<1,2,2,2,2,false,true>;
using AType=Catlass::Gemm::GemmType<int8_t,Catlass::layout::RowMajor>;
using BType=Catlass::Gemm::GemmType<int8_t,Catlass::layout::RowMajor>;
using CType=Catlass::Gemm::GemmType<half,Catlass::layout::RowMajor>;
