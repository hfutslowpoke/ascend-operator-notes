CrossCoreWaitFlag(4);
if(count>0)DataCopyPad(ci,cg[(int64_t(ordinal%4)*cores+core)*256+begin],DataCopyExtParams{1,uint32_t(count*4),0,0,0},DataCopyPadExtParams<int32_t>{false,0,0,0});
CrossCoreSetFlag<2,PIPE_MTE2>(5);
