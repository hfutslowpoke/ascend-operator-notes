}
CrossCoreSetFlag<2,PIPE_MTE2>(5);
if(rows<=0) return;
SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
Cast(value,raw,RoundMode::CAST_NONE,count);
PipeBarrier<PIPE_V>();
BinaryRepeatParams repeat{1,1,1,64,64,0};
for(int column=0;column<512;column+=64)
Mul(value[column],value[column],scales[column],uint64_t(64),uint8_t(rows),repeat);
PipeBarrier<PIPE_V>();
#define C2_ROW_VEC(call) do {call;PipeBarrier<PIPE_V>();} while(false)
C2_ROW_VEC(Mul(work,value,value,count));
C2_ROW_VEC(Muls(work,work,-0.0713548162726003f,count));
C2_ROW_VEC(Adds(work,work,-1.5957691216057308f,count));
C2_ROW_VEC(Mul(work,work,value,count));
C2_ROW_VEC(Mins(work,work,80.0f,count));
C2_ROW_VEC(Exp(work,work,count));
C2_ROW_VEC(Adds(work,work,1.0f,count));
C2_ROW_VEC(Div(value,value,work,count));
if(outputPending) WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
C2_ROW_VEC(Cast(output,value,RoundMode::CAST_RINT,count));
#undef C2_ROW_VEC
SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
DataCopyExtParams outputCopy{uint16_t(rows),512*2,0,uint32_t((s.n-512)*2),0};
DataCopyPad(yg[int64_t(tile.row+rowOffset)*s.n+tile.col],output,outputCopy);
SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
outputPending=true;
SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
}
__global__ __aicore__ void C1WideFullAGroupedMatmulGelu(
GM_ADDR x,GM_ADDR w,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,
