for(int task=FirstTask(core,cores,base);task<tasks;task+=cores) {
const int row=start+task*128;
for(int column=0;column<s.n;column+=256) {
const Tile tile{row,column,Min(128,end-row),256};
ConsumeC5Panel(resource,cg,sg,yg,tile,s,core,cores,sub,expert,ordinal,outputPending);
++ordinal;
}
}
start=end;
base+=tasks;
}
if(outputPending) WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
}
__aicore__ inline void HDMDeepCachedAProduce(Catlass::Arch::Resource<Catlass::Arch::AtlasA2>& resource,
GM_ADDR x,GM_ADDR w,GM_ADDR groups,
GM_ADDR scratch,Shape s,int core,int cores) {
using ArchTag=Catlass::Arch::AtlasA2;
using Policy=Catlass::Gemm::MmadAtlasA2PreloadAsyncWithCallback<1,2,2,2,1,false,true>;
using AType=Catlass::Gemm::GemmType<int8_t,Catlass::layout::RowMajor>;
using BType=Catlass::Gemm::GemmType<int8_t,Catlass::layout::RowMajor>;
using CType=Catlass::Gemm::GemmType<int32_t,Catlass::layout::RowMajor>;
using Block=Catlass::Gemm::Block::HDMDeepCachedAMmad<Policy,
Catlass::GemmShape<64,256,512>,Catlass::GemmShape<64,256,128>,AType,BType,CType>;
Block block(resource);
GlobalTensor<int8_t> ag,bg;
GlobalTensor<int32_t> cg;
GlobalTensor<int64_t> gg;
ag.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
bg.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(w));
cg.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(scratch));
gg.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups));
HDMWaitSlot waits[4];
HDMPublishSlot publishes[4];
int start=0,base=0,ordinal=0;
for(int e=0;e<s.e;++e) {
const int end=static_cast<int>(gg.GetValue(e));
const int tasks=CeilDiv(end-start,64);
for(int task=FirstTask(core,cores,base);task<tasks;task+=cores) {
const int row=start+task*64;
const int rows=Min(64,end-row);
for(int col=0;col<s.n;col+=256) {
const int slot=ordinal%4;
Callback before;
if(ordinal>=4) before=MakeCallback(&waits[slot]);
auto after=MakeCallback(&publishes[slot]);
const int64_t offset=(int64_t(slot)*cores+core)*64*256;
block(ag[int64_t(row)*s.k],Catlass::layout::RowMajor(rows,s.k),
bg[int64_t(e)*s.k*s.n+col],Catlass::layout::RowMajor(s.k,s.n),
cg[offset],Catlass::layout::RowMajor(rows,256),
Catlass::GemmCoord(rows,256,s.k),col==0,before,after);
++ordinal;
}
}
start=end; base+=tasks;
}
block.SynchronizeBlock();
for(int i=0;i<Min(ordinal,4);++i) CrossCoreWaitFlag(5);
}

__global__ __aicore__ void HDMDeepCachedAGroupedMatmulGelu(
GM_ADDR x,GM_ADDR w,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,
GM_ADDR scratch,GM_ADDR workspace,int64_t workspacePerCore,
GM_ADDR tilingGm,uint64_t syncBase,Shape s,int cores,int macroN) {
KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
SetSyncBaseAddr(syncBase);
int core=GetBlockIdx();
if ASCEND_IS_AIV { core/=2; }
const int sub=GetSubBlockIdx();
Catlass::Arch::Resource<Catlass::Arch::AtlasA2> resource;
if ASCEND_IS_AIC {
HDMDeepCachedAProduce(resource,x,w,groups,scratch,s,core,cores);
return;
}
GlobalTensor<int8_t> ag,bg;
GlobalTensor<int32_t> cg;
GlobalTensor<float> sg;
GlobalTensor<int64_t> gg;
GlobalTensor<half> yg;
ag.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
bg.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(w));
cg.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(scratch));
sg.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scale));
gg.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups));
yg.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y));
bool outputPending=false;
int start=0,base=0,ordinal=0;
for(int e=0;e<s.e;++e) {
const int end=static_cast<int>(gg.GetValue(e));
const int tasks=CeilDiv(end-start,64)*CeilDiv(s.n,macroN);
for(int task=FirstTask(core,cores,base);task<tasks;task+=cores) {
const Tile tile=MakeTile(start,end,s.n,task,64,macroN);
if ASCEND_IS_AIV {
auto ci=resource.ubBuf.GetBufferByByte<int32_t>(0); auto z=resource.ubBuf.GetBufferByByte<float>(32768);
auto u=resource.ubBuf.GetBufferByByte<float>(65536); auto den=resource.ubBuf.GetBufferByByte<float>(98304);
auto sc=resource.ubBuf.GetBufferByByte<float>(131072); auto out=resource.ubBuf.GetBufferByByte<half>(132096);
const int halfRows=(tile.rows+1)/2;
const int rowOffset=sub*halfRows;
const int rows=Min(halfRows,tile.rows-rowOffset);
for(int colOffset=0;colOffset<tile.cols;colOffset+=256) {
const int cols=Min(256,tile.cols-colOffset);
const int count=rows*cols;
const int slot=ordinal%4;
const int64_t offset=(int64_t(slot)*cores+core)*64*256;
if(rows>0) {
DataCopyExtParams scaleCopy{1,static_cast<uint32_t>(cols*4),0,0,0};
DataCopyPad(sc,sg[int64_t(e)*s.n+tile.col+colOffset],scaleCopy,
DataCopyPadExtParams<float>{false,0,0,0});
}
CrossCoreWaitFlag(4);
if(rows>0) {
 
DataCopyExtParams inputCopy{1,static_cast<uint32_t>(rows*cols*4),0,0,0};
DataCopyPad(ci,cg[offset+int64_t(rowOffset)*cols],inputCopy,
DataCopyPadExtParams<int32_t>{false,0,0,0});
}
 
 
CrossCoreSetFlag<2,PIPE_MTE2>(5);
if(rows>0) {
SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
Cast(z,ci,RoundMode::CAST_NONE,count); PipeBarrier<PIPE_V>();
BinaryRepeatParams br{1,1,1,static_cast<uint8_t>(cols/8),
static_cast<uint8_t>(cols/8),0};
for(int c=0;c<cols;c+=64)
Mul(z[c],z[c],sc[c],static_cast<uint64_t>(Min(64,cols-c)),
static_cast<uint8_t>(rows),br);
PipeBarrier<PIPE_V>();
#define REF_VEC(call) do { call; PipeBarrier<PIPE_V>(); } while(false)
REF_VEC(Mul(u,z,z,count));
REF_VEC(Muls(u,u,-0.0713548162726003f,count));
REF_VEC(Adds(u,u,-1.5957691216057308f,count));
REF_VEC(Mul(u,u,z,count));
REF_VEC(Mins(u,u,80.0f,count));
REF_VEC(Exp(u,u,count));
REF_VEC(Adds(den,u,1.0f,count));
REF_VEC(Div(z,z,den,count));
if(outputPending) { WaitFlag<HardEvent::MTE3_V>(EVENT_ID0); outputPending=false; }
REF_VEC(Cast(out,z,RoundMode::CAST_RINT,count));
#undef REF_VEC
SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
DataCopyExtParams outputCopy{static_cast<uint16_t>(rows),
static_cast<uint32_t>(cols*2),0,
static_cast<uint32_t>((s.n-cols)*2),0};
if(cols==s.n) {
outputCopy.blockCount=1;
outputCopy.blockLen=static_cast<uint32_t>(rows*cols*2);
}
DataCopyPad(yg[int64_t(tile.row+rowOffset)*s.n+tile.col+colOffset],
out,outputCopy);
SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
outputPending=true;
SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
}
++ordinal;
}
}
}
start=end; base+=tasks;
}
if ASCEND_IS_AIV {
if(outputPending) WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
}
if ASCEND_IS_AIC {
for(int i=0;i<Min(ordinal,4);++i) CrossCoreWaitFlag(5);
}
}


template<bool enableUnitFlag>
__global__ __aicore__ void ELLOneShotGroupedMatmulGelu(
GM_ADDR x,GM_ADDR w,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,
GM_ADDR scratch,uint64_t syncBase,Shape s) {
KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
SetSyncBaseAddr(syncBase);
int core=GetBlockIdx();
if ASCEND_IS_AIV { core/=2; }
const int sub=GetSubBlockIdx();
const Tile tile=MakeTile(0,s.m,s.n,core,16,128);
Catlass::Arch::Resource<Catlass::Arch::AtlasA2> resource;
if ASCEND_IS_AIC {
using AType=Catlass::Gemm::GemmType<int8_t,Catlass::layout::RowMajor>;
using BType=Catlass::Gemm::GemmType<int8_t,Catlass::layout::RowMajor>;
using CType=Catlass::Gemm::GemmType<int32_t,Catlass::layout::RowMajor>;
using Copies=Catlass::Gemm::Tile::TileCopy<Catlass::Arch::AtlasA2,AType,BType,CType>;
using A1Layout=typename Copies::CopyL1ToL0A::LayoutSrc;
using B1Layout=typename Copies::CopyL1ToL0B::LayoutSrc;
using A0Layout=typename Copies::CopyL1ToL0A::LayoutDst;
using B0Layout=typename Copies::CopyL1ToL0B::LayoutDst;
typename Copies::CopyGmToL1A loadA;
typename Copies::CopyGmToL1B loadB;
typename Copies::CopyL1ToL0A stageA;
typename Copies::CopyL1ToL0B stageB;
typename Copies::CopyL0CToGm storeC;
Catlass::Gemm::Tile::TileMmad<Catlass::Arch::AtlasA2,AType,BType,void> multiply;
GlobalTensor<int8_t> ag,bg;
GlobalTensor<int32_t> cg;
ag.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
bg.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(w));
cg.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(scratch));
