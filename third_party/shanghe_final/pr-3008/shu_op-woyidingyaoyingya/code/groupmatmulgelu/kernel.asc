auto bPanel = bg[int64_t(expert)*s.k*s.n+panel.col];
const auto layoutB = Catlass::layout::RowMajor(s.k,s.n);
const Catlass::MatrixCoord bShape{uint32_t(s.k),uint32_t(panel.cols)};
block.PrepareResidentB(bPanel,layoutB.GetTileLayout(bShape));
for (int rowBase = 0; rowBase < panel.rows; rowBase += 96) {
const int rows = Min(96,panel.rows-rowBase);
const int slot = ordinal%4;
