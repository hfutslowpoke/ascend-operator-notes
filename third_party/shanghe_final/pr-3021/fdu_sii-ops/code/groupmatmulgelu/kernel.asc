            throw std::runtime_error("GroupedMatmulGelu device execution failed");
        return;
    }
    // Stage only the odd-K input row pitch in this deep-reduction region.
    // N192 keeps the same number of column tasks as N256 here, while
    // permitting K160 L0 steps and reducing the widest task's operand load.
    // Every actual expert boundary and tail is still handled on device.
    const bool alignDeepX=wideLongReduction && !residentB && !packedB &&
        k>4*1024 && k<=8*1024 && k%32!=0;
    if(alignDeepX){
        // Deep odd-K: stage the reused expert weights instead of the input rows;
        // N256 keeps five N32 planes per L0B step and measured faster than N192.
        const int kp=(k+31)/32*32,np=(n+255)/256*256;
        GmgHost::Buffer alignedWorkspace(static_cast<size_t>(workers)*Gmg::Slots*128*256*sizeof(int32_t));
        GmgHost::Buffer packedW(static_cast<size_t>(e)*kp*np);
        grouped_matmul_gelu_deep_continuous_k<<<workers,nullptr,stream>>>(
            x,weight,scale,group_list,y,alignedWorkspace.ptr,x,packedW.ptr,m,n,k,e,workers);
