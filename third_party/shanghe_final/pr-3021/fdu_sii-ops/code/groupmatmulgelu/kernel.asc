    }
    const int ntiles=(n+tileN-1)/tileN;
    const int microK=65536/(2*(tileM>tileN?tileM:tileN))/32*32;
    const int residentPanelK=2*microK;
    const bool residentB=2*tileM*residentPanelK+((k+31)/32*32)*tileN<=524288 &&
        k>microK && workers%ntiles==0 &&
        static_cast<int64_t>(m)*ntiles>static_cast<int64_t>(tileM)*workers*activeExpertBound;
    // A narrow unaligned INT8 row makes on-the-fly ND2NZ inefficient.
    // Explore a full-K device-local packing path only beyond one L0 step.
    const bool fullWeightFitsL1=2*tileM*residentPanelK+((k+31)/32*32)*tileN<=524288;
    // Four N32 planes need more preparation work: require enough K to
    // amortize setup, bounded weight storage, and row reuse potential.
    const bool packingTaskCoverage=(m+tileM-1)/tileM>=workers;
    const bool packingAmortized=n<=2*32 || (packingTaskCoverage &&
        ((n<=3*32 && k>2*microK) ||
         (k>=4*microK && fullWeightFitsL1 &&
          static_cast<int64_t>(m)>static_cast<int64_t>(tileM)*activeExpertBound)));
    const bool packedNarrow=n<64 && k>=1;
    // DS extension: long reductions amortize N32 packing even without row reuse.
    const bool packedB=n<=128 && n%32!=0 && (k>microK || packedNarrow) &&
        (packingAmortized || k>=4*microK);
    // Nonaligned source pitches repeatedly penalize ND2NZ. Stage once only
    // in a wide-output region with repeated unaligned input reads; every actual group is still routed and computed on device.
    // Require four K microsteps and five complete N tiles to amortize
    // staging and the mixed barrier; narrow-column counterexamples fall back.
    // 32 input rows of K<=4096 fit the staging buffer's 128 KiB UB budget.
    // Retain the validated reuse domain. Lower reuse did not pay for
    // staging, even after overlapping its two transfer directions.
    const bool originalAligned=tileM==128 && tileN==128 && !residentB && !packedB &&
        k>3*microK && k<=4096 && k%32!=0 && n/tileN>=5 && n%32!=0 &&
        static_cast<int64_t>(m)>=2ll*tileM*activeExpertBound;
    const bool extendedAligned=!residentB && !packedB && k>=512 && k<=4096 &&
        k%32!=0 && n>512 && n<=2048 && n%256>0 && n%256<=32 &&
        static_cast<int64_t>(m)>=128ll*activeExpertBound;
    const bool alignCurrentInputs=originalAligned || extendedAligned;
    if(alignCurrentInputs){
        const int kp=(k+31)/32*32,np=(n+255)/256*256;
        // Current-input staging removes the original unaligned source
        // pitches. Re-evaluate output tiling without changing that domain:
        // N256 must not add padded columns and must retain enough tasks.
        const bool wideAligned=((m+127)/128)*((n+255)/256)>=workers;
        const int nominal=(m+activeExpertBound-1)/activeExpertBound;
        const int tasks256=((nominal+127)/128)*((n+255)/256);
        const int tasks384=((nominal+79)/80)*((n+383)/384);
        const bool subWide=false; // M128/N256 faster on extended-aligned fixtures
        const int alignedN=subWide?384:(wideAligned?256:128),alignedM=subWide?80:128;
        GmgHost::Buffer alignedWorkspace(static_cast<size_t>(workers)*Gmg::Slots*alignedM*alignedN*sizeof(int32_t));
        // X is read directly from this invocation; only W is prepared.
        GmgHost::Buffer packedW(static_cast<size_t>(e)*kp*np);
        if(subWide)grouped_matmul_gelu_aligned_input<384,80><<<workers,nullptr,stream>>>(
            x,weight,scale,group_list,y,alignedWorkspace.ptr,x,packedW.ptr,m,n,k,e,workers);
        else if(wideAligned)grouped_matmul_gelu_aligned_input<256><<<workers,nullptr,stream>>>(
            x,weight,scale,group_list,y,alignedWorkspace.ptr,x,packedW.ptr,m,n,k,e,workers);
        else grouped_matmul_gelu_aligned_input<128><<<workers,nullptr,stream>>>(
            x,weight,scale,group_list,y,alignedWorkspace.ptr,x,packedW.ptr,m,n,k,e,workers);
