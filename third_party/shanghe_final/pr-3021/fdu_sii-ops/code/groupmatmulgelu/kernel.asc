__global__ __mix__(1,2) void grouped_matmul_gelu_combined_tail(
    GM_ADDR x,GM_ADDR w,GM_ADDR s,GM_ADDR g,GM_ADDR y,GM_ADDR ws,
    int m,int n,int k,int e,int workers)
{
    AscendC::InitSocState();
    // Skewed groups (any group longer than two BM=64 rows) measured faster on
    // the adaptive wide scheduler, which reuses one A panel across N subtiles.
    // Complete short rows keep the tail-row-wave scheduler. Group data is read
    // here on device, inside the single kernel invocation.
    AscendC::GlobalTensor<int64_t> groupBounds;
    groupBounds.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(g));
    int previous=0;bool shortRows=true;
    for(int expert=0;expert<e;++expert){
        const int end=static_cast<int>(groupBounds.GetValue(expert));
        if(end-previous>128){shortRows=false;break;}
        previous=end;
    }
    if(shortRows)Gmg::RunTailRowWave(x,w,s,g,y,ws,m,n,k,e,workers);
    else Gmg::RunAdaptiveWide(x,w,s,g,y,ws,m,n,k,e,workers);
}

template<bool Enabled>
__global__ __mix__(1,2) void grouped_matmul_gelu_subcolumns512(
    GM_ADDR x,GM_ADDR w,GM_ADDR s,GM_ADDR g,GM_ADDR y,GM_ADDR ws,
    int m,int n,int k,int e,int workers)
{
    AscendC::InitSocState();
    AscendC::GlobalTensor<int64_t> groups;
    groups.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(g));
    int previous=0;bool wholeRows=true;
    for(int expert=0;expert<e;++expert){
        const int end=static_cast<int>(groups.GetValue(expert));
        // Preserve v304128-row B reuse for larger current groups. The wide
        // path replaces only complete short-row tiles, not a reused128-row tile.
        if((end-previous)%64!=0 || end-previous>64){wholeRows=false;break;}
        previous=end;
    }
    if(wholeRows){
        const int tasks=(m/64)*((n+511)/512),waves=(tasks+workers-1)/workers;
        const int active=(tasks+waves-1)/waves;
        const int worker=AscendC::GetBlockIdx()/AscendC::GetTaskRation();
        if(worker<active)Gmg::RunWideColumnOrder(x,w,s,g,y,ws,m,n,k,e,active);
    }
    else Gmg::RunAdaptiveWide(x,w,s,g,y,ws,m,n,k,e,workers);
}

