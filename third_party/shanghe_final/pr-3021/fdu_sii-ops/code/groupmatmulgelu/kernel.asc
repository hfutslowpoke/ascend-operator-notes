    // In complete-column medium K, small actual experts benefit from N512;
    // larger ones keep M128 reuse. The device selects using current groups.
    if(rowReuse && mediumDepthReuse && n%512==0 && k%256==0){
        grouped_matmul_gelu_adaptive_complete_columns<true><<<workers,nullptr,stream>>>(
            x,weight,scale,group_list,y,workspace.ptr,m,n,k,e,workers);
    }else if(shortAhead){
        if(n==tileN && k==65536/tileN)
            grouped_matmul_gelu_combined_short<true><<<workers,nullptr,stream>>>(
                x,weight,scale,group_list,y,workspace.ptr,m,n,k,e,workers);
        else grouped_matmul_gelu_combined_short<false><<<workers,nullptr,stream>>>(
            x,weight,scale,group_list,y,workspace.ptr,m,n,k,e,workers);
    }else if(longMicro){
        grouped_matmul_gelu_long_micro<true><<<workers,nullptr,stream>>>(
            x,weight,scale,group_list,y,workspace.ptr,m,n,k,e,workers);
    }else if(staggerK){
        if(widerColumns)
            grouped_matmul_gelu_subcolumns512<true><<<workers,nullptr,stream>>>(
                x,weight,scale,group_list,y,workspace.ptr,m,n,k,e,workers);
        else if(boundedGroupTail)
            grouped_matmul_gelu_shift_k<true><<<workers,nullptr,stream>>>(
                x,weight,scale,group_list,y,workspace.ptr,m,n,k,e,workers);
        else grouped_matmul_gelu_combined_tail<<<workers,nullptr,stream>>>(
            x,weight,scale,group_list,y,workspace.ptr,m,n,k,e,workers);
    }else if(boundedGroupTail){
        grouped_matmul_gelu_bounded_group_tail<true><<<workers,nullptr,stream>>>(
            x,weight,scale,group_list,y,workspace.ptr,m,n,k,e,workers);
    }else if(fifthColumnTail){
        grouped_matmul_gelu<160,128><<<workers,nullptr,stream>>>(
            x,weight,scale,group_list,y,workspace.ptr,m,n,k,e,workers);
    }else if(wideLongReduction){
        grouped_matmul_gelu<256,128><<<workers,nullptr,stream>>>(
            x,weight,scale,group_list,y,workspace.ptr,m,n,k,e,workers);
    }else if(thirdColumnTail || longReductionColumns){
        grouped_matmul_gelu<192,128><<<workers,nullptr,stream>>>(
            x,weight,scale,group_list,y,workspace.ptr,m,n,k,e,workers);
    }else if(rowReuse){
        grouped_matmul_gelu<256,128><<<workers,nullptr,stream>>>(
            x,weight,scale,group_list,y,workspace.ptr,m,n,k,e,workers);
    }else if(rowPartition){
        if(n==32)grouped_matmul_gelu<128,64,false,false,true,true><<<workers,nullptr,stream>>>(
            x,weight,scale,group_list,y,workspace.ptr,m,n,k,e,workers);
        else if(tileN==128)grouped_matmul_gelu<128,64,false,false,false,true><<<workers,nullptr,stream>>>(
            x,weight,scale,group_list,y,workspace.ptr,m,n,k,e,workers);
        else grouped_matmul_gelu<256,64,false,false,false,true><<<workers,nullptr,stream>>>(
            x,weight,scale,group_list,y,workspace.ptr,m,n,k,e,workers);
    }else if(n>=512 && k<=256){
        // Wide/shallow fallback: the compact epilogue halves the task count.
        const int wideBound=((m+127)/128+activeExpertBound-1)*((n+255)/256);
        const int wideWorkers=availableCoreNum<wideBound?static_cast<int>(availableCoreNum):wideBound;
        GmgHost::Buffer wideWorkspace(
            static_cast<size_t>(wideWorkers)*Gmg::Slots*128*256*sizeof(int32_t));
        grouped_matmul_gelu<256,128><<<wideWorkers,nullptr,stream>>>(
            x,weight,scale,group_list,y,wideWorkspace.ptr,m,n,k,e,wideWorkers);
        if(aclrtSynchronizeStream(stream)!=ACL_SUCCESS)
            throw std::runtime_error("GroupedMatmulGelu device execution failed");
        return;
    }else if(n==32){
        if(tileM==128){
            if(residentB)grouped_matmul_gelu<128,128,true,false,true><<<workers,nullptr,stream>>>(
                x,weight,scale,group_list,y,workspace.ptr,m,n,k,e,workers);
            else grouped_matmul_gelu<128,128,false,false,true><<<workers,nullptr,stream>>>(
                x,weight,scale,group_list,y,workspace.ptr,m,n,k,e,workers);
        }else{
            if(residentB)grouped_matmul_gelu<128,64,true,false,true><<<workers,nullptr,stream>>>(
                x,weight,scale,group_list,y,workspace.ptr,m,n,k,e,workers);
            else grouped_matmul_gelu<128,64,false,false,true><<<workers,nullptr,stream>>>(
                x,weight,scale,group_list,y,workspace.ptr,m,n,k,e,workers);
        }
    }else if(packedB){
        if(tileM==128){
            if(residentB)grouped_matmul_gelu<128,128,true,true><<<workers,nullptr,stream>>>(
                x,weight,scale,group_list,y,workspace.ptr,m,n,k,e,workers);
            else grouped_matmul_gelu<128,128,false,true><<<workers,nullptr,stream>>>(
                x,weight,scale,group_list,y,workspace.ptr,m,n,k,e,workers);
        }else{
            if(residentB)grouped_matmul_gelu<128,64,true,true><<<workers,nullptr,stream>>>(
                x,weight,scale,group_list,y,workspace.ptr,m,n,k,e,workers);
            else grouped_matmul_gelu<128,64,false,true><<<workers,nullptr,stream>>>(
                x,weight,scale,group_list,y,workspace.ptr,m,n,k,e,workers);
        }
    }else if(residentB){
        if(tileM==128)
            grouped_matmul_gelu<128,128,true><<<workers,nullptr,stream>>>(x,weight,scale,group_list,y,
                workspace.ptr,m,n,k,e,workers);
        else if(tileN==128)
            grouped_matmul_gelu<128,64,true><<<workers,nullptr,stream>>>(x,weight,scale,group_list,y,
                workspace.ptr,m,n,k,e,workers);
        else
            grouped_matmul_gelu<256,64,true><<<workers,nullptr,stream>>>(x,weight,scale,group_list,y,
                workspace.ptr,m,n,k,e,workers);
    }else if(tileM==128){
        if(deepFallbackN256)
            grouped_matmul_gelu<256,128><<<workers,nullptr,stream>>>(x,weight,scale,group_list,y,
                workspace.ptr,m,n,k,e,workers);
        else grouped_matmul_gelu<128,128><<<workers,nullptr,stream>>>(x,weight,scale,group_list,y,
            workspace.ptr,m,n,k,e,workers);
    }else{
        if(tileN==128)
            grouped_matmul_gelu<128,64><<<workers,nullptr,stream>>>(x,weight,scale,group_list,y,
                workspace.ptr,m,n,k,e,workers);
        else
            grouped_matmul_gelu<256,64><<<workers,nullptr,stream>>>(x,weight,scale,group_list,y,
                workspace.ptr,m,n,k,e,workers);
    }
    // aclrtFree has no implicit stream synchronization: retain the workspace
    // until this invocation's producer/consumer handoffs have all completed.
    if(aclrtSynchronizeStream(stream)!=ACL_SUCCESS)
        throw std::runtime_error("GroupedMatmulGelu device execution failed");
}
