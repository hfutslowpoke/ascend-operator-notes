            throw std::runtime_error("GroupedMatmulGelu device execution failed");
        return;
    }
    // Narrow the large-deep strategy to the original generic M128/N128
    // fallback. Earlier specialized returns and their allocations are unchanged.
    const bool deepFallbackN256=tileM==128 && tileN==128 && !residentB && !packedB &&
        k>=4096 && n>=256 && m>=128ll*availableCoreNum;
    const size_t outputBytes=static_cast<size_t>(workers)*Gmg::Slots*tileM*
