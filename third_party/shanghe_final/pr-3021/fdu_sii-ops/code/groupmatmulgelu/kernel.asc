    Gmg::RunShortAhead<256,64,false,false,false,true>(x,w,s,g,y,ws,m,n,k,e,workers);
}

// Mechanism: device staging followed by mixed barrier, as in CANN grouped
// matmul preprocessing. See experiment report for exact source/version.
// Current-input aligned staging, followed by complete compute in the same kernel.
#ifdef __DAV_C220_VEC__
template<bool Load>
__aicore__ inline void StageAlignedChunk(AscendC::LocalTensor<int8_t> raw,
    AscendC::GlobalTensor<int8_t>& gx,AscendC::GlobalTensor<int8_t>& gw,
    AscendC::GlobalTensor<int8_t>& ax,AscendC::GlobalTensor<int8_t>& aw,
    int task,int slot,int m,int n,int k,int kp,int np,int rowsPerChunk,int xTasks,int wChunks)
{
    using namespace AscendC;
    const int event=6+slot;
    const bool isX=task<xTasks;
    const int wt=task-xTasks;
    const int expert=isX?0:wt/wChunks;
    const int first=isX?task*rowsPerChunk:(wt%wChunks)*rowsPerChunk;
    const int rows=Gmg::Min(rowsPerChunk,(isX?m:kp)-first);
    const int valid=isX?rows:Gmg::Min(rows,k-first);
    const int pitch=isX?kp:np;
    if constexpr(Load){
        WaitFlag<HardEvent::MTE3_MTE2>(event);
        if(valid<rows || (!isX && np>(n+31)/32*32)){
            // Slot release -> MTE2 -> V orders zero fill after old GM writes.
            SetFlag<HardEvent::MTE2_V>(event);WaitFlag<HardEvent::MTE2_V>(event);
            const int fillStart=(!isX && np==(n+31)/32*32 && valid>0)?valid:0;
            Duplicate(raw.ReinterpretCast<uint16_t>()[fillStart*pitch/2],uint16_t(0),(rows-fillStart)*pitch/2);
            SetFlag<HardEvent::V_MTE2>(event);WaitFlag<HardEvent::V_MTE2>(event);
        }
        if(isX)
            DataCopyPad(raw,gx[static_cast<int64_t>(first)*k],
                DataCopyExtParams{uint16_t(rows),uint32_t(k),0,0,0},
                DataCopyPadExtParams<int8_t>{true,0,uint8_t(kp-k),0});
        else if(valid>0)
            DataCopyPad(raw,gw[(static_cast<int64_t>(expert)*k+first)*n],
                DataCopyExtParams{uint16_t(valid),uint32_t(n),0,uint32_t((np-(n+31)/32*32)/32),0},
                DataCopyPadExtParams<int8_t>{true,0,uint8_t((32-n%32)%32),0});
        SetFlag<HardEvent::MTE2_MTE3>(event);
    }else{
        WaitFlag<HardEvent::MTE2_MTE3>(event);
        if(isX)DataCopy(ax[static_cast<int64_t>(first)*kp],raw,rows*pitch);
        else DataCopy(aw[(static_cast<int64_t>(expert)*kp+first)*np],raw,rows*pitch);
        SetFlag<HardEvent::MTE3_MTE2>(event);
    }
}
#endif

template<int BN,int BM=128>
__global__ __mix__(1,2) void grouped_matmul_gelu_aligned_input(
    GM_ADDR x,GM_ADDR w,GM_ADDR s,GM_ADDR g,GM_ADDR y,GM_ADDR ws,
    GM_ADDR px,GM_ADDR pw,int m,int n,int k,int e,int workers)
{
    using namespace AscendC;
    InitSocState();
    const int kp=(k+31)/32*32,np=(n+255)/256*256;
#ifdef __DAV_C220_VEC__
    const int worker=GetBlockIdx()/GetTaskRation();
    const int lane=worker*2+GetSubBlockIdx(),lanes=workers*2;
    // Two 64KiB slots fit the original128KiB staging budget. Use16rows
    // only when a physical row exceeds2048bytes; all tails stay exact.
    constexpr int SlotBytes=64*1024;
    const int Rows=(kp>2048 || np>2048)?16:32;
    LocalTensor<int8_t> raw(TPosition::VECIN,0,2*SlotBytes);
    GlobalTensor<int8_t> gx,gw,ax,aw;
    gx.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
    gw.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(w));
    ax.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(px));
    aw.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(pw));
    const int xTasks=0,wChunks=(kp+Rows-1)/Rows;
    const int tasks=xTasks+e*wChunks;
    for(int slot=0;slot<2;++slot)SetFlag<HardEvent::MTE3_MTE2>(6+slot);
    GlobalTensor<int64_t> groups;groups.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(g));
    uint64_t eligibleLow=0,eligibleHigh=0;
    int previous=0,eligibleCount=0;
    for(int expert=0;expert<e;++expert){
        const int end=static_cast<int>(groups.GetValue(expert));
        if(end-previous>=128){
            if(expert<64)eligibleLow|=uint64_t(1)<<expert;
            else eligibleHigh|=uint64_t(1)<<(expert-64);
            ++eligibleCount;
        }
        previous=end;
    }
    const bool selective=eligibleCount<e;
    int task=lane;
    while(task<tasks && selective){
        const int expert=task/wChunks;
        if(((expert<64?eligibleLow:eligibleHigh)>>(expert%64))&1)break;
        task+=lanes;
    }
    if(task<tasks){
        StageAlignedChunk<true>(raw,gx,gw,ax,aw,task,0,m,n,k,kp,np,Rows,xTasks,wChunks);
        int sequence=0;
        while(task<tasks){
            const int slot=sequence%2,next=1-slot;
            int nextTask=task+lanes;
            while(nextTask<tasks && selective){
                const int expert=nextTask/wChunks;
                if(((expert<64?eligibleLow:eligibleHigh)>>(expert%64))&1)break;
                nextTask+=lanes;
            }
            if(nextTask<tasks)
                StageAlignedChunk<true>(raw[next*SlotBytes],gx,gw,ax,aw,nextTask,next,m,n,k,kp,np,Rows,xTasks,wChunks);
            StageAlignedChunk<false>(raw[slot*SlotBytes],gx,gw,ax,aw,task,slot,m,n,k,kp,np,Rows,xTasks,wChunks);
            task=nextTask;++sequence;
        }
    }
    // Consume both release tokens before the mixed barrier and UB reuse;
    // idle lanes also drain their initialized tokens and reach the barrier.
    for(int slot=0;slot<2;++slot)WaitFlag<HardEvent::MTE3_MTE2>(6+slot);
#endif
    // SDK owns flags11..13 here, fully completes before Run initializes them.
    SyncAll<false>();
    Gmg::Run<BN,BM,false,false,false,false,true,false>(x,pw,s,g,y,ws,m,n,k,e,workers,w);
}



// Copy only this invocation's X; weights keep their original logical stride.
// A common mixed barrier precedes the complete unchanged grouped computation.
template<int BN>
__global__ __mix__(1,2) void grouped_matmul_gelu_aligned_x(
    GM_ADDR x,GM_ADDR w,GM_ADDR s,GM_ADDR g,GM_ADDR y,GM_ADDR ws,
    GM_ADDR px,int m,int n,int k,int e,int workers)
{
    using namespace AscendC;
    InitSocState();
    const int kp=(k+31)/32*32;
#ifdef __DAV_C220_VEC__
    const int lane=(GetBlockIdx()/GetTaskRation())*2+GetSubBlockIdx(),lanes=workers*2;
    constexpr int SlotBytes=64*1024;
    const int Rows=Gmg::Min(32,SlotBytes/kp); // each slot must hold complete padded rows
    LocalTensor<int8_t> raw(TPosition::VECIN,0,2*SlotBytes);
    GlobalTensor<int8_t> gx,gw,ax,aw;
    gx.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
    gw.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(w));
    ax.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(px));
    // The shared helper selects X for every task in this entry. aw is never used.
    aw.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(px));
    const int tasks=(m+Rows-1)/Rows;
    for(int slot=0;slot<2;++slot)SetFlag<HardEvent::MTE3_MTE2>(6+slot);
    if(lane<tasks){
        StageAlignedChunk<true>(raw,gx,gw,ax,aw,lane,0,m,n,k,kp,n,Rows,tasks,1);
        int sequence=0;
        for(int task=lane;task<tasks;task+=lanes,++sequence){
            const int slot=sequence%2,next=1-slot;
            if(task+lanes<tasks)
                StageAlignedChunk<true>(raw[next*SlotBytes],gx,gw,ax,aw,task+lanes,next,
                    m,n,k,kp,n,Rows,tasks,1);
            StageAlignedChunk<false>(raw[slot*SlotBytes],gx,gw,ax,aw,task,slot,
                m,n,k,kp,n,Rows,tasks,1);
        }
    }
    for(int slot=0;slot<2;++slot)WaitFlag<HardEvent::MTE3_MTE2>(6+slot);
#endif
    SyncAll<false>();
    // Logical K is retained: the original W has exactly K rows. Only A's
    // physical row pitch changes; the normal L1 tail initialization remains.
    Gmg::Run<BN,128,false,false,false,false,false,true>(px,w,s,g,y,ws,m,n,k,e,workers);
}

template<int K,int N=1>
inline void DispatchTinyColumns(GM_ADDR x,GM_ADDR w,GM_ADDR s,GM_ADDR g,GM_ADDR y,
    int m,int n,int experts,aclrtStream stream,bool staged){
    if(n==N)grouped_matmul_gelu_tiny_k4<K,N><<<m,nullptr,stream>>>(x,w,s,g,y,m,n,K,experts,staged);
    else if constexpr(N<16 && (N+1)*K<=32)
        DispatchTinyColumns<K,N+1>(x,w,s,g,y,m,n,experts,stream,staged);
}

// Deep-only source probe; all preceding entries remain unchanged.
__global__ __mix__(1,2) void grouped_matmul_gelu_deep_continuous_k(
    GM_ADDR x,GM_ADDR w,GM_ADDR s,GM_ADDR g,GM_ADDR y,GM_ADDR ws,
    GM_ADDR px,GM_ADDR pw,int m,int n,int k,int e,int workers)
{
    using namespace AscendC;
    InitSocState();
    const int kp=(k+31)/32*32,np=(n+255)/256*256;
#ifdef __DAV_C220_VEC__
    const int worker=GetBlockIdx()/GetTaskRation();
    const int lane=worker*2+GetSubBlockIdx(),lanes=workers*2;
    // Two 64KiB slots fit the original128KiB staging budget. Use16rows
    // only when a physical row exceeds2048bytes; all tails stay exact.
    constexpr int SlotBytes=64*1024;
    const int Rows=(kp>2048 || np>2048)?16:32;
    LocalTensor<int8_t> raw(TPosition::VECIN,0,2*SlotBytes);
    GlobalTensor<int8_t> gx,gw,ax,aw;
    gx.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
    gw.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(w));
    ax.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(px));
    aw.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(pw));
    const int xTasks=0,wChunks=(kp+Rows-1)/Rows;
    const int tasks=xTasks+e*wChunks;
    for(int slot=0;slot<2;++slot)SetFlag<HardEvent::MTE3_MTE2>(6+slot);
    GlobalTensor<int64_t> groups;groups.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(g));
    uint64_t eligibleLow=0,eligibleHigh=0;
    int previous=0,eligibleCount=0;
    for(int expert=0;expert<e;++expert){
        const int end=static_cast<int>(groups.GetValue(expert));
        if(end-previous>=128){
            if(expert<64)eligibleLow|=uint64_t(1)<<expert;
            else eligibleHigh|=uint64_t(1)<<(expert-64);
            ++eligibleCount;
        }
        previous=end;
    }
    const bool selective=eligibleCount<e;
    int task=lane;
    while(task<tasks && selective){
        const int expert=task/wChunks;
        if(((expert<64?eligibleLow:eligibleHigh)>>(expert%64))&1)break;
        task+=lanes;
    }
    if(task<tasks){
        StageAlignedChunk<true>(raw,gx,gw,ax,aw,task,0,m,n,k,kp,np,Rows,xTasks,wChunks);
        int sequence=0;
        while(task<tasks){
            const int slot=sequence%2,next=1-slot;
            int nextTask=task+lanes;
            while(nextTask<tasks && selective){
                const int expert=nextTask/wChunks;
                if(((expert<64?eligibleLow:eligibleHigh)>>(expert%64))&1)break;
                nextTask+=lanes;
            }
            if(nextTask<tasks)
                StageAlignedChunk<true>(raw[next*SlotBytes],gx,gw,ax,aw,nextTask,next,m,n,k,kp,np,Rows,xTasks,wChunks);
            StageAlignedChunk<false>(raw[slot*SlotBytes],gx,gw,ax,aw,task,slot,m,n,k,kp,np,Rows,xTasks,wChunks);
            task=nextTask;++sequence;
        }
    }
    // Consume both release tokens before the mixed barrier and UB reuse;
    // idle lanes also drain their initialized tokens and reach the barrier.
    for(int slot=0;slot<2;++slot)WaitFlag<HardEvent::MTE3_MTE2>(6+slot);
#endif
    // SDK owns flags11..13 here, fully completes before Run initializes them.
    SyncAll<false>();
    Gmg::RunDeepContinuousK(x,pw,s,g,y,ws,m,n,k,e,workers,w);
}

__global__ __vector__ void grouped_matmul_gelu_shallow_tiled(
    GM_ADDR x,GM_ADDR w,GM_ADDR s,GM_ADDR g,GM_ADDR y,
    int m,int n,int k,int experts,int workers)
{
    AscendC::InitSocState();
    AscendC::ICachePreLoad(7);
    Gmg::RunShallowTiled(x,w,s,g,y,m,n,k,experts,workers);
}

extern "C" void run_kernel(
    GM_ADDR x, const TensorGroupInfo& info_x,
    GM_ADDR weight, const TensorGroupInfo& info_weight,
    GM_ADDR scale, const TensorGroupInfo& info_scale,
    GM_ADDR group_list, const TensorGroupInfo& info_group_list,
    GM_ADDR y, const TensorGroupInfo& info_y,
    int64_t availableCoreNum, aclrtStream stream)
{
    GmgHost::Validate(info_x,info_weight,info_scale,info_group_list,info_y);
    const int m=info_x.tensors[0].shape[0],k=info_x.tensors[0].shape[1];
    const int e=info_weight.tensors[0].shape[0],n=info_weight.tensors[0].shape[2];
    if(availableCoreNum<=0)throw std::invalid_argument("no available Cube cores");
    // Below a minimum INT8 Cube fractal, bound each row's scalar MAC work
    // and keep all rows in one wave. This covers a range of legal metadata.
    if(m<=16 && n<=16 && k<=32 && n*k<=32 && m<=availableCoreNum){
        // The staged window holds this invocation's complete W and scale
        // tables, so the flag stays a property of the current metadata only.
        const bool tinyStage=static_cast<int64_t>(e)*k*n<=4096 &&
            static_cast<int64_t>(e)*n*static_cast<int64_t>(sizeof(float))<=8192 && e<=128;
        if(n==1){
            if(k<=4)grouped_matmul_gelu_tiny_scalar<true><<<m,nullptr,stream>>>(x,weight,scale,group_list,y,m,n,k,e,tinyStage);
            else grouped_matmul_gelu_tiny_scalar<false><<<m,nullptr,stream>>>(x,weight,scale,group_list,y,m,n,k,e,tinyStage);
        }
        else if(k==1)DispatchTinyColumns<1>(x,weight,scale,group_list,y,m,n,e,stream,tinyStage);
        else if(k==2)DispatchTinyColumns<2>(x,weight,scale,group_list,y,m,n,e,stream,tinyStage);
        else if(k==3)DispatchTinyColumns<3>(x,weight,scale,group_list,y,m,n,e,stream,tinyStage);
        else if(k==4)DispatchTinyColumns<4>(x,weight,scale,group_list,y,m,n,e,stream,tinyStage);
        else grouped_matmul_gelu_tiny<<<m,nullptr,stream>>>(x,weight,scale,group_list,y,m,n,k,e);
        if(aclrtSynchronizeStream(stream)!=ACL_SUCCESS)
            throw std::runtime_error("GroupedMatmulGelu device execution failed");
        return;
    }
    // Shallow reductions are exact in FP32 for K<=16; a tiled Vector GEMV
    // avoids the per-tile Cube/Vector handshake on wide tiny-K shapes.
    if(k<=16 && n>=2048){
        const int shallowChunks=(n+1023)/1024;
        // Pure-Vector route on this platform: AIV instances = 2 x AIC core budget.
        const int64_t shallowVectorBudget=2*availableCoreNum;
        const int shallowGroups=shallowVectorBudget/shallowChunks>0?static_cast<int>(shallowVectorBudget/shallowChunks):1;
        const int shallowWorkers=shallowChunks*shallowGroups;
        grouped_matmul_gelu_shallow_tiled<<<shallowWorkers,nullptr,stream>>>(
            x,weight,scale,group_list,y,m,n,k,e,shallowWorkers);
        if(aclrtSynchronizeStream(stream)!=ACL_SUCCESS)
            throw std::runtime_error("GroupedMatmulGelu device execution failed");
        return;
    }
    // Sum ceil(groupRows/64) <= ceil(M/64)+min(E,M)-1. This
    // metadata bound covers skew and empty experts without reading inputs.
    // Parallelize K only while the complete output bound underfills cores.
    const int splitColumns=(n+127)/128;
    const int nonemptyBound=e<m?e:m;
    const int splitTasks=((m+63)/64+nonemptyBound-1)*splitColumns;
    const int coreBudget=static_cast<int>(availableCoreNum/splitTasks);
    const int depthBudget=k/(2*256);
    const int parts=coreBudget<depthBudget?coreBudget:depthBudget;
    // At least four useful slices amortize the full mixed barrier in
    // independent first-call tests; fewer slices retain the original path.
    if(k>=4*256 && parts>=4){
        const int splitWorkers=splitTasks*parts;
        GmgHost::Buffer partials(static_cast<size_t>(splitWorkers)*64*128*sizeof(int32_t));
        grouped_matmul_gelu_grouped_split_k<true><<<splitWorkers,nullptr,stream>>>(
            x,weight,scale,group_list,y,partials.ptr,m,n,k,e,parts);
        if(aclrtSynchronizeStream(stream)!=ACL_SUCCESS)
            throw std::runtime_error("GroupedMatmulGelu device execution failed");
        return;
    }
    // For short reductions that fit one N128 L0 step, use finer
    // output tasks only while their complete expert-aware bound fits one wave.
    // M16 is the INT8 Cube row fractal, independent of a full problem Shape.
    constexpr int FineM=16,FineN=128;
    const int fineTasks=((m+FineM-1)/FineM+nonemptyBound-1)*((n+FineN-1)/FineN);
    // Require more than half of an N128 column tile and at least two
    // M16 fractals per expert on average. Already-small experts and narrow
    // columns have too little epilogue work to amortize extra block setup.
    if(k<=65536/(2*128) && n>FineN/2 && n<=FineN &&
        m>=2*FineM*nonemptyBound && fineTasks>splitTasks &&
        fineTasks<=availableCoreNum){
        GmgHost::Buffer fineWorkspace(static_cast<size_t>(fineTasks)*FineM*FineN*sizeof(int32_t));
        grouped_matmul_gelu_single_wave<FineN,FineM><<<fineTasks,nullptr,stream>>>(
            x,weight,scale,group_list,y,fineWorkspace.ptr,m,n,k,e);
        if(aclrtSynchronizeStream(stream)!=ACL_SUCCESS)
            throw std::runtime_error("GroupedMatmulGelu device execution failed");
        return;
    }
    // Integer cumulative groups contain at most min(E,M) nonempty experts.
    // Sum ceil(rows/BM) <= ceil(M/BM) + nonemptyExperts - 1.
    const int activeExpertBound=e<m?e:m;
    // More column tasks help only while the complete upper-bound workload
    // still fits a single hardware wave; otherwise prefer input reuse.
    const int narrowBound=((m+Gmg::BaseBM-1)/Gmg::BaseBM+activeExpertBound-1)*((n+127)/128);
    // In this capacity interval N128 fits all K in one double-buffered
    // L0 step, while N256 needs two. Evaluate the finer output task grain.
    const bool narrowerReads=((n+127)/128)*(Gmg::BaseBM+128)<=
        ((n+255)/256)*(Gmg::BaseBM+256);
    const bool oneNarrowStep=k>65536/(2*256) && k<=65536/(2*128) &&
        ((n+127)/128)*128 < ((n+255)/256)*256 &&
        narrowerReads;
    const int baseTileN=n<=128 || narrowBound<=availableCoreNum || oneNarrowStep?128:256;
    const int columns128=(n+127)/128,columns256=(n+255)/256;
    const int rowBound=(m+127)/128+activeExpertBound-1;
    const int64_t waves128=(rowBound*columns128+availableCoreNum-1)/availableCoreNum;
    const int64_t waves256=(rowBound*columns256+availableCoreNum-1)/availableCoreNum;
    const bool lessColumnWaste=columns128*128<columns256*256 && waves128*128<waves256*256;
    // Compare conservative operand-read counts for the two legal layouts.
    // The common K factor cancels. Merely having more than one row tile
    // does not ensure that the square layout offsets extra column traffic.
    const int baseRowBound=(m+Gmg::BaseBM-1)/Gmg::BaseBM+activeExpertBound-1;
    const int baseColumns=(n+baseTileN-1)/baseTileN;
    const int64_t baseReads=static_cast<int64_t>(baseRowBound)*baseColumns*(Gmg::BaseBM+baseTileN);
    const int64_t squareReads=static_cast<int64_t>(rowBound)*columns128*(128+128);
    const bool rowReusePotential=squareReads<baseReads;
    const int balancedTaskLowerBound=((m+127)/128)*columns128;
    const bool balanced=k>65536/(2*128) && balancedTaskLowerBound>=availableCoreNum &&
        (rowReusePotential || lessColumnWaste);
    // Retain the original layout outside a multi-shape weight-reuse region.
    constexpr int ReuseM=128,ReuseN=256,ReuseMicroK=128,ReusePanelK=512;
    const int reuseNominal=((m+ReuseM-1)/ReuseM)*columns256;
    const int baseNominal=((m+Gmg::BaseBM-1)/Gmg::BaseBM)*columns256;
    const int64_t reuseWaves=(reuseNominal+availableCoreNum-1)/availableCoreNum;
    const int64_t baseWaves=(baseNominal+availableCoreNum-1)/availableCoreNum;
    // A bandwidth-bound region can offset one extra half-tile compute wave
    // if the predicted operand traffic per critical worker is smaller.
    const bool nominalWaves=2*reuseWaves<=baseWaves+1 &&
        reuseWaves*(ReuseM+ReuseN)<baseWaves*(Gmg::BaseBM+ReuseN);
    // Preserve an existing full-weight L1 strategy where it already applies.
    const bool oldResidentB=2*Gmg::BaseBM*(2*128)+((k+31)/32*32)*256<=524288 &&
        k>128 && availableCoreNum%columns256==0 &&
        static_cast<int64_t>(m)*columns256>
            static_cast<int64_t>(Gmg::BaseBM)*availableCoreNum*activeExpertBound;
    // Medium reduction depth still benefits from row reuse when the
    // resource/traffic model retains at least one wave of output tasks.
    const bool mediumDepthReuse=k>=2*ReusePanelK && k<3*ReusePanelK &&
        reuseNominal>=availableCoreNum;
    const bool rowReuse=!oldResidentB && !balanced && baseTileN==256 && n>ReuseN && n%ReuseN==0 &&
        ((k>=3*ReusePanelK && reuseNominal>=2*availableCoreNum) || mediumDepthReuse) &&
        static_cast<int64_t>(k)*n>=2*524288 &&
        m>=ReuseM*activeExpertBound && nominalWaves;
    // Extend to smaller nominal groups, but bound the row growth of each
    // current device submatrix instead of assuming uniformly long experts.
    const bool boundedGroupTail=!rowReuse && !oldResidentB && !balanced && baseTileN==256 &&
        n>ReuseN && n%ReuseN==0 && k>=3*ReusePanelK &&
        static_cast<int64_t>(k)*n>=2*524288 && m>=Gmg::BaseBM*activeExpertBound &&
        reuseNominal>=availableCoreNum && nominalWaves;
    // A narrow final column slab executes only its actual N16 pitch in
    // Mmad and Vector. Whole-BN padding overestimates that tail's compute;
    // wider logical columns can instead avoid repeated unaligned A copies.
    // At least three complete N256 slabs amortize the wider tile's setup;
    // smaller-column counterexamples retain the original implementation.
    const bool compactColumnTail=balanced && !oldResidentB && n%ReuseN>0 && n%ReuseN<=ReuseN/4 &&
        columns256>=4 && k>2*ReusePanelK && k<=4*ReusePanelK &&
        k%32!=0 && m>=ReuseM*activeExpertBound;
    // N192 admits aligned K160 double buffering: four microsteps form
    // K640 panels. Select it only when it removes an L1 panel and reduces
    // conservative critical-worker column work relative to N256.
    constexpr int ThirdN=192,ThirdMicroK=65536/(2*ThirdN)/32*32;
    constexpr int ThirdPanelK=4*ThirdMicroK;
    const int64_t thirdWaves=(static_cast<int64_t>(rowBound)*((n+ThirdN-1)/ThirdN)+availableCoreNum-1)/availableCoreNum;
    const bool thirdColumnTail=compactColumnTail &&
        (k+ThirdPanelK-1)/ThirdPanelK<(k+ReusePanelK-1)/ReusePanelK &&
        thirdWaves*ThirdN<waves256*ReuseN;
    const int tileM=rowReuse||boundedGroupTail||balanced?128:Gmg::BaseBM;
    // Five N32 fractals admit K192 double buffering (61440 B L0B).
    // Only use it when column task count does not grow and the number of
    // reduction microsteps shrinks relative to the existing N192/K160 path.
    constexpr int FifthN=160,FifthMicroK=65536/(2*FifthN)/32*32;
    const bool fifthColumnTail=thirdColumnTail &&
        (n+FifthN-1)/FifthN<=(n+ThirdN-1)/ThirdN &&
        (k+FifthMicroK-1)/FifthMicroK<(k+ThirdMicroK-1)/ThirdMicroK;
    // Deep reductions amplify repeated A panels and the second task wave.
    // A wider existing tile can fit the nominal output in one wave while
    // the narrow layout needs more; actual groups are still handled on device.
    const int deepColumns=(n+ThirdN-1)/ThirdN;
    const int deepNominal=((m+ReuseM-1)/ReuseM)*deepColumns;
    // Bound fragmentation by the real expert-count upper bound: permit less
    // than one additional row tile beyond a single wave, never assume uniform groups.
    const bool longReductionColumns=balanced && !oldResidentB && k>4*ReusePanelK &&
        balancedTaskLowerBound>availableCoreNum &&
        deepColumns<columns128 && deepNominal<=availableCoreNum &&
        rowBound*deepColumns<availableCoreNum+deepColumns &&
        m>=ReuseM*activeExpertBound;
    // Keep the established task-fragmentation bound. N256's power-of-two
    // K128/K512 layout reduces transfer cost only while it preserves the
    // number of column tasks; otherwise retain N192's greater parallelism.
    const bool wideLongReduction=longReductionColumns && columns256==deepColumns;
    const int tileN=wideLongReduction?ReuseN:(longReductionColumns?ThirdN:(fifthColumnTail?FifthN:(thirdColumnTail?ThirdN:(balanced?128:baseTileN))));
    // Group boundaries are read exclusively on device.
    const int bound=((m+tileM-1)/tileM+activeExpertBound-1)*((n+tileN-1)/tileN);
    const int fullWorkers=static_cast<int>(availableCoreNum<bound?availableCoreNum:bound);
    // A small number of nominal waves can have many idle lanes. Retain the
    // same nominal wave count while reducing participating workers in the
    // medium-depth M128 reuse region; actual groups remain entirely dynamic.
    const int poolWaves=(reuseNominal+fullWorkers-1)/fullWorkers;
    const int filledPool=(reuseNominal+poolWaves-1)/poolWaves;
    int workers=rowReuse && mediumDepthReuse && poolWaves<=2 && filledPool<fullWorkers?
        filledPool:fullWorkers;
    // A very light output task (small K*N) is dominated by the per-tile
    // pipeline cold start; on devices offering more blocks than twice the
    // task count, trade cores for two tasks per block. Heavy tasks keep all
    // cores because splitting them further only lengthens the serial chain.
    {
