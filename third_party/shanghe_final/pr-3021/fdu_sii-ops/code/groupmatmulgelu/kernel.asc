    const int rowPanelK=4*microK<1024?4*microK:1024;
    const bool longRowRange=n%32==0 && k<=2*rowPanelK && m>=16*activeExpertBound;
    const bool rowPartition=(k<=256 || longRowRange) &&
        !packedB && ntiles==1 && tileM==Gmg::BaseBM &&
        m>=tileM*workers && m<=tileM*activeExpertBound;
    // Resource-derived K512 panels of the compact layout are all complete.
    // Shorter complete reductions need not rotate their first K panel.
    // Evaluate sequential current-input panels while retaining M128 reuse.
    const bool staggerK=!mediumDepthReuse && (rowReuse || boundedGroupTail) &&
        k>=2*ReusePanelK && k%ReusePanelK==0;
    const int64_t wideTasks=static_cast<int64_t>(m/64)*(n/512);
    const int64_t narrowTasks=static_cast<int64_t>(m/64)*(n/256);
    const int64_t wideWaves=(wideTasks+workers-1)/workers;
    const int64_t narrowWaves=(narrowTasks+workers-1)/workers;
    const bool widerColumns=boundedGroupTail && n%512==0 && m%64==0 &&
