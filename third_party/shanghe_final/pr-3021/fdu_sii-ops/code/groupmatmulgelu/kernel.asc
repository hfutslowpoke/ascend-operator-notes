__global__ __vector__ void grouped_matmul_gelu_tiny(
    GM_ADDR x,GM_ADDR weight,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,
    int m,int n,int k,int experts)
{
    AscendC::InitSocState();
    // Request this invocation's instruction stream inside the complete
    // timed kernel. Every call still reads and computes all current inputs.
    AscendC::ICachePreLoad(7);
    Gmg::RunTiny(x,weight,scale,groups,y,m,n,k,experts);
}

