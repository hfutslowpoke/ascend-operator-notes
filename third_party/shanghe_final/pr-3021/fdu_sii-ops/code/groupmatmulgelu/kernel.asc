template<int TileN,int TileM,bool ResidentB=false,bool PackedB=false,bool DirectB=false,bool RowPartition=false>
__global__ __mix__(1, 2) void grouped_matmul_gelu(
    GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groups, GM_ADDR y,
    GM_ADDR workspace, int m, int n, int k, int experts, int workers)
{
    AscendC::InitSocState();
    Gmg::Run<TileN,TileM,ResidentB,PackedB,DirectB,RowPartition>(x,weight,scale,groups,y,workspace,m,n,k,experts,workers);
}

