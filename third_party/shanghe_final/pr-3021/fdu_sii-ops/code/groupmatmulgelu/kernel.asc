            throw std::runtime_error("GroupedMatmulGelu device execution failed");
        return;
    }
    // M192/N160 fits120KiB L0C with double K160 operands. Here the
    // complete K fits one K640 L1 panel, unlike the previously slower deep-K
    // use of this tile. Three N160 slabs replace four N128 slabs, while
    // larger M reduces repeated weight transfers for multi-row experts.
    const bool tallShort=balanced && !residentB && !packedB &&
        k>2*256 && k<=4*160 && n>3*128 && n<=3*160 &&
        static_cast<int64_t>(m)>=192ll*activeExpertBound;
    if(tallShort){
        const int tallBound=((m+191)/192+activeExpertBound-1)*((n+159)/160);
        const int tallWorkers=availableCoreNum<tallBound?availableCoreNum:tallBound;
        GmgHost::Buffer tallWorkspace(static_cast<size_t>(tallWorkers)*Gmg::Slots*192*160*sizeof(int32_t));
        grouped_matmul_gelu_tall_short<true><<<tallWorkers,nullptr,stream>>>(
            x,weight,scale,group_list,y,tallWorkspace.ptr,m,n,k,e,tallWorkers);
        if(aclrtSynchronizeStream(stream)!=ACL_SUCCESS)
            throw std::runtime_error("GroupedMatmulGelu device execution failed");
        return;
    }
    // Wide unaligned rows penalize repeated ND2NZ commands. Four N128
    // L0 subtiles share an A panel without any full-input staging. Require
    // at least five K256 panels and nominal M64 work per active expert;
    // actual groups, empty experts and every tail remain device-driven.
    const bool wideUnaligned=balanced && !residentB && !packedB &&
        n>512 && n%32!=0 && k>4*256 && k<=4*1024 &&
        static_cast<int64_t>(m)>=64ll*activeExpertBound;
    if(wideUnaligned){
        // Estimate nominal fragmentation and operand traffic using public
        // dimensions only. M96 must remove a row tile without adding total
        // tasks, and its smaller operand rectangle must reduce modeled reads.
        // This is a dispatch heuristic: actual expert rows are still arbitrary
        // and are handled completely on device, including empty/skewed groups.
        const int64_t rows64=(static_cast<int64_t>(m)+64ll*activeExpertBound-1)/(64ll*activeExpertBound);
        const int64_t rows96=(static_cast<int64_t>(m)+96ll*activeExpertBound-1)/(96ll*activeExpertBound);
        const int64_t tasks64=rows64*((n+511)/512),tasks96=rows96*((n+319)/320);
        // A <=half-width final N512 slab is cheaper than a full task;
        // the nominal task model overestimates its cost. Preserve that layout
        // when extending beyond the already validated single-M96-row region.
        const bool mediumRows=rows96<rows64 && tasks96<=tasks64 &&
            tasks96*(96+320)<tasks64*(64+512) &&
            (rows96==1 || n%512>512/2);
        const int nominalRows=(m+activeExpertBound-1)/activeExpertBound;
        const int selectedM=mediumRows?96:64,selectedN=mediumRows?320:512;
        const int selectedRows=(nominalRows+selectedM-1)/selectedM;
        const int selectedTiles=selectedRows*((n+selectedN-1)/selectedN);
        // M80/N384 uses120KiB L0C and an independent N32 pitch384 for B.
        // Select only when it cuts task count/operand traffic without
        // increasing nominal padded rows. Actual group tails stay dynamic.
        const int candidateRows=(nominalRows+79)/80;
        const int candidateTiles=candidateRows*((n+383)/384);
        const bool mediumWide=candidateRows*80<=selectedRows*selectedM &&
            candidateTiles<selectedTiles &&
            candidateTiles*(80+384)<selectedTiles*(selectedM+selectedN);
        const int wideM=mediumWide?80:selectedM,wideN=mediumWide?384:selectedN;
        const int wideBound=((m+wideM-1)/wideM+activeExpertBound-1)*((n+wideN-1)/wideN);
        const int wideWorkers=availableCoreNum<wideBound?availableCoreNum:wideBound;
        // The adaptive small-expert path shares one invariant GM stride.
        const int workspaceTile=mediumRows && !mediumWide?64*512:wideM*wideN;
        GmgHost::Buffer wideWorkspace(static_cast<size_t>(wideWorkers)*Gmg::Slots*workspaceTile*sizeof(int32_t));
        if(mediumWide)grouped_matmul_gelu_medium_wide<true><<<wideWorkers,nullptr,stream>>>(
            x,weight,scale,group_list,y,wideWorkspace.ptr,m,n,k,e,wideWorkers);
        else if(mediumRows)grouped_matmul_gelu_small_expert_columns<true><<<wideWorkers,nullptr,stream>>>(
            x,weight,scale,group_list,y,wideWorkspace.ptr,m,n,k,e,wideWorkers);
        else grouped_matmul_gelu_wide_unaligned<true><<<wideWorkers,nullptr,stream>>>(
            x,weight,scale,group_list,y,wideWorkspace.ptr,m,n,k,e,wideWorkers);
