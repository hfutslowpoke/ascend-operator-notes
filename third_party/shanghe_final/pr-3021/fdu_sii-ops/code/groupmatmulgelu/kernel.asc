    // Complete K fits one full L0B capacity, but needs two double-buffered
    // microsteps. One column tile and the existing weighted row partition.
    const bool shortAhead=rowPartition && tileN==256 && k>65536/(2*256) && k<=65536/256;
    // A complete M64/K512 panel fits a double-buffered L0A slot.
    // Narrow L0B to N64 and reuse A across four N pieces, preserving each
    // original M64/N256 output task and its full Vector epilogue.
    const bool longMicro=tileM==64 && tileN==256 && !residentB && !packedB &&
