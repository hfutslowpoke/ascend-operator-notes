}


// Invocation-local deferred rounding corrections. Output patches use MTE3
// byte-count stores, never scalar GM writes (which could race on a cache line).
__aicore__ inline void flush_pending(PackedDD &pd,LocalTensor<float> packed,
 int *indices,int size,LocalTensor<half> patch,GlobalTensor<half> yg){
 // A small actual refinement batch can use the existing full scalar
 // mathematical implementation instead of launching a64-lane DD batch.
 // Initial FP32 GELU, refinement predicate and final patch stores are unchanged.
 if(size<=4){
  for(int i=0;i<size;++i)pd.q.h.SetValue(i,precise_gelu(packed.GetValue(i)));
 }else{
 for(int i=size;i<((size+63)/64)*64;++i)packed.SetValue(i,0.0f);
 SetFlag<HardEvent::S_V>(EVENT_ID1);WaitFlag<HardEvent::S_V>(EVENT_ID1);
 pd.gelu(packed,size);
 SetFlag<HardEvent::V_S>(EVENT_ID1);WaitFlag<HardEvent::V_S>(EVENT_ID1);
 for(int i=0;i<size;++i){float z=packed.GetValue(i),h=pd.q.h.GetValue(i);
  pd.q.h.SetValue(i,refined_ambiguous(h)?precise_gelu(z):midpoint_adjust(z,h,pd.q.l.GetValue(i),pd.tail.h.GetValue(i)));}
 }
 SetFlag<HardEvent::S_V>(EVENT_ID1);WaitFlag<HardEvent::S_V>(EVENT_ID1);
 Cast(patch,pd.q.h,RoundMode::CAST_RINT,size);
 SetFlag<HardEvent::V_S>(EVENT_ID1);WaitFlag<HardEvent::V_S>(EVENT_ID1);
 for(int i=0;i<size;++i)patch.SetValue(256+i*16,patch.GetValue(i));
 // All approximate output DMA writes must finish before correction stores.
 SetFlag<HardEvent::MTE3_S>(EVENT_ID2);WaitFlag<HardEvent::MTE3_S>(EVENT_ID2);
 SetFlag<HardEvent::S_MTE3>(EVENT_ID2);WaitFlag<HardEvent::S_MTE3>(EVENT_ID2);
 DataCopyExtParams one{1,2,0,0,0};
 for(int i=0;i<size;++i)DataCopyPad(yg[indices[i]],patch[256+i*16],one);
