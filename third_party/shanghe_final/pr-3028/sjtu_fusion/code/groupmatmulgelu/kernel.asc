// General low-work path, selected only by total multiply-add work.
// Device computes every dot product, reads runtime groups and applies the same GELU.
namespace TallNativePipeline {

constexpr bool kEnableExpertTall=true;

struct TileShape {
 int m,n;
};

__aicore__ inline TileShape ChooseGeometry(int64_t rows,int64_t N){
 if constexpr(kEnableExpertTall){
  if(rows>128){
   const int64_t nativeRows=(rows+127)/128,tallRows=(rows+255)/256;
   const int64_t nativeCols=(N+255)/256,tallCols=(N+127)/128;
   const int64_t nativeTraffic=rows*nativeCols+N*nativeRows;
   const int64_t tallTraffic=rows*tallCols+N*tallRows;
   // Logical INT8 traffic in units of K; also limit extra output tiles.
   // These estimates guide tiling and make no assumption about input values.
   if(4*tallRows<=3*nativeRows&&3*tallRows*tallCols<=4*nativeRows*nativeCols&&
      16*tallTraffic<=17*nativeTraffic)return {256,128};
  }
 }
 return {128,256};
}

#ifdef __DAV_CUBE__
using L1AliasPool = AscendC::TBufPool<AscendC::TPosition::A1,4>;
constexpr int kPoolL1Bytes=393216;

struct RegionL1Queues {
 L1AliasPool alias;
 AscendC::TQue<AscendC::TPosition::A1,2> aq;
 AscendC::TQue<AscendC::TPosition::B1,2> bq;

 __aicore__ inline void Init(AscendC::TPipe& pipe,L1AliasPool& anchor,int rows,int cols){
  // The anchor carries no tensors and stays valid for every rebind.
  pipe.InitBufPool(alias,kPoolL1Bytes,anchor);
  alias.InitBuffer(aq,2,rows*512);
  alias.InitBuffer(bq,2,512*cols);
 }

 __aicore__ inline void Finish(){alias.Reset();}
};

class SharedL0GeometryCube {
 AscendC::TQue<AscendC::TPosition::A2,2> a2;
 AscendC::TQue<AscendC::TPosition::B2,2> b2;
 AscendC::TQue<AscendC::TPosition::CO1,1> cq;

public:
 __aicore__ inline void Init(AscendC::TPipe& pipe){
  pipe.InitBuffer(a2,2,256*128);pipe.InitBuffer(b2,2,128*256);pipe.InitBuffer(cq,1,32768*4);
 }
 __aicore__ inline void Stage(RegionL1Queues& region,AscendC::GlobalTensor<int8_t>& a,AscendC::GlobalTensor<int8_t>& b,
  int64_t e,int64_t r0,int64_t c0,int rm,int cn,int64_t K,int64_t bStride,int k0,int kp){
  using namespace AscendC;const int mp=(rm+15)/16*16;
  auto la=region.aq.AllocTensor<int8_t>(),lb=region.bq.AllocTensor<int8_t>();
  Nd2NzParams ap{1,(uint16_t)rm,(uint16_t)kp,0,(uint16_t)K,(uint16_t)mp,1,0};
  Nd2NzParams bp{1,(uint16_t)kp,(uint16_t)cn,0,(uint16_t)bStride,(uint16_t)kp,1,0};
  DataCopy(la,a[r0*K+k0],ap);DataCopy(lb,b[e*K*bStride+(int64_t)k0*bStride+c0],bp);
  region.aq.EnQue(la);region.bq.EnQue(lb);
 }
 __aicore__ inline void Compute(RegionL1Queues& region,AscendC::GlobalTensor<int8_t>& a,AscendC::GlobalTensor<int8_t>& b,
  AscendC::GlobalTensor<int32_t> dst,int64_t e,int64_t r0,int64_t c0,int rm,int cn,int64_t K,int64_t bStride,int tilePitch,int fullPanels,int tail,int firstPanel){
  using namespace AscendC;const int mp=(rm+15)/16*16,bn=(cn+31)/32*32;
  const int panelCount=fullPanels+(tail!=0);
  int panel=firstPanel;
  auto acc=cq.AllocTensor<int32_t>();
  Stage(region,a,b,e,r0,c0,rm,cn,K,bStride,panel*512,fullPanels?512:tail);
  for(int ordinal=0;ordinal<panelCount;++ordinal){
   const int kp=panel<fullPanels?512:tail;
   auto la=region.aq.DeQue<int8_t>(),lb=region.bq.DeQue<int8_t>();
   // Keep the short K tail after all full panels.
   if(ordinal+1<panelCount){
    if(ordinal+1==fullPanels)panel=fullPanels;
    else if(++panel==fullPanels)panel=0;
    Stage(region,a,b,e,r0,c0,rm,cn,K,bStride,panel*512,panel<fullPanels?512:tail);
   }
   for(int kk=0;kk<kp;kk+=128){
    const int kc=kp-kk<128?kp-kk:128;
    // The rectangular accumulator uses each B L0 panel across all active rows.
    auto aa=a2.AllocTensor<int8_t>(),bb=b2.AllocTensor<int8_t>();
    LoadData2dParams pa{};pa.repeatTimes=kc/32;pa.srcStride=mp/16;
    for(int mr=0;mr<mp/16;++mr)LoadData(aa[mr*kc*16],la[mr*16*32+kk*mp],pa);
    LoadData2dTransposeParams pb{};pb.repeatTimes=bn/32;pb.srcStride=kp/32;pb.dstGap=1;
    for(int kr=0;kr<kc/32;++kr)LoadDataWithTranspose(bb[kr*((cn+15)/16)*16*32],lb[(kk+kr*32)*32],pb);
    a2.EnQue(aa);b2.EnQue(bb);aa=a2.DeQue<int8_t>();bb=b2.DeQue<int8_t>();
    MmadParams mm{};mm.m=mp;mm.n=cn;mm.k=kc;mm.cmatrixInitVal=(ordinal==0&&kk==0);Mmad(acc,aa,bb,mm);
    if((mp/16)*(cn/16)<10)PipeBarrier<PIPE_M>();
    a2.FreeTensor(aa);b2.FreeTensor(bb);
   }
   region.aq.FreeTensor(la);region.bq.FreeTensor(lb);
  }
  // Complete the full K reduction before a single final output Fixpipe.
  cq.EnQue(acc);acc=cq.DeQue<int32_t>();
  FixpipeParamsV220 fp{};fp.mSize=rm;fp.nSize=cn;fp.srcStride=mp;fp.dstStride=tilePitch;
  Fixpipe<int32_t,int32_t,CFG_ROW_MAJOR>(dst,acc,fp);cq.FreeTensor(acc);
 }
};
#endif

#ifndef __DAV_CUBE__
__aicore__ inline void PackWeightRows(AscendC::LocalTensor<int8_t> ub, GM_ADDR weight, GM_ADDR packed,
 int rows, int n, int stride) {
 using namespace AscendC;
 constexpr int packBytes=64*1024;
 static_assert(8*ES*4>=packBytes);
 const int batch=stride<=512?128:(stride<=1024?64:32);
 const int ubRow=(n+31)&~31;
 const int first=(int)GetBlockIdx()*batch,step=2*(int)GetBlockNum()*batch;
 GlobalTensor<int8_t> src,dst;
 src.SetGlobalBuffer((__gm__ int8_t*)weight);
 dst.SetGlobalBuffer((__gm__ int8_t*)packed);
 // The DMA writes each valid row and its first zero pad without changing the row gap.
 // The gap is initialized once and stays zero through all batches.
 Duplicate(ub.ReinterpretCast<int16_t>(),(int16_t)0,packBytes/2);
 SetFlag<HardEvent::V_MTE2>(EVENT_ID0);WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
 const DataCopyPadExtParams<int8_t> pad{true,0,(uint8_t)(ubRow-n),0};
 DataCopyExtParams copy{(uint16_t)batch,(uint32_t)n,0,(uint32_t)((stride-ubRow)/32),0};
 for(int row=first;row<rows;row+=step){
  const int remain=rows-row;
  const int count=remain<batch?remain:batch;
  copy.blockCount=(uint16_t)count;
  DataCopyPad(ub,src[row*n],copy,pad);
  SetFlag<HardEvent::MTE2_MTE3>(EVENT_ID0);WaitFlag<HardEvent::MTE2_MTE3>(EVENT_ID0);
  DataCopy(dst[row*stride],ub,(uint32_t)(count*stride));
  SetFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);WaitFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);
 }
}
#endif

__global__ __mix__(1,2) __schedmode__(1) void grouped_matmul_gelu_tall(
 GM_ADDR x,GM_ADDR weight,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,GM_ADDR scratch,
 int64_t M,int64_t N,int64_t K,int64_t E,int64_t bStride){
 using namespace AscendC;
 TPipe pipe;
#ifdef __DAV_CUBE__
 static_assert(128*256==TM*TN && 256*128==TM*TN);
 static_assert(2*(128*512+512*256)==393216);
#else
 static_assert(256*128==TM*TN);
#endif
 const int64_t cores=GetBlockNum();
 const bool shouldPack=bStride!=N;
 GM_ADDR packed=shouldPack?scratch+cores*4*TM*TN*sizeof(int32_t):nullptr;
#ifdef __DAV_CUBE__
 const int64_t core=GetBlockIdx();
#else
 const int64_t core=GetBlockIdx()/2,sub=GetSubBlockIdx();
#endif
 GlobalTensor<int64_t> ends;
 ends.SetGlobalBuffer((__gm__ int64_t*)groups);
 GlobalTensor<int32_t> cg;
 cg.SetGlobalBuffer((__gm__ int32_t*)scratch+core*4*TM*TN);
#ifdef __DAV_CUBE__
 GlobalTensor<int8_t> a,b;
 a.SetGlobalBuffer((__gm__ int8_t*)x);
 b.SetGlobalBuffer((__gm__ int8_t*)(shouldPack?packed:weight));
 L1AliasPool anchor;
 pipe.InitBufPool(anchor,kPoolL1Bytes);
 SharedL0GeometryCube panel;
 panel.Init(pipe);
 const int fullPanels=(int)(K/512),tail=(int)(K%512);
 const int firstPanel=fullPanels>1?(int)core%fullPanels:0;
#else
 PackedGeluThresholds table;table.Init();
 TQue<TPosition::VECIN,2> cq,sq;TQue<TPosition::VECOUT,1> oq;TBuf<TPosition::VECCALC> calc,glBuf,indexBuf;
 pipe.InitBuffer(cq,2,ES*4);pipe.InitBuffer(sq,2,TN*4);
 pipe.InitBuffer(oq,1,ES*2);pipe.InitBuffer(calc,8*ES*4+3*MB+kMidpointWords*4);
 if(shouldPack)PackWeightRows(calc.Get<int8_t>(),weight,packed,(int)(E*K),(int)N,(int)bStride);
 auto midpointBits=calc.Get<uint16_t>()[((8*ES*4+3*MB)/2)];
 Duplicate(midpointBits.ReinterpretCast<int32_t>(),(int32_t)kMidpointMask,kMidpointWords);
 pipe.InitBuffer(indexBuf,ES*sizeof(int16_t));auto indexValues=indexBuf.Get<int16_t>();
 CreateVecIndex(indexValues,(int16_t)0,ES);
 // Two full z/u/pos banks preserve every candidate; no bounded candidate queue.
 // The held input queue remains arithmetic scratch after dequantization Cast.
 auto bankStorage=calc.Get<float>();int stripBank=0;bool pendingStrip=false;
 LocalTensor<float> pendingZ,pendingIndices,pendingPos;
 int pendingCount=0,pendingRows=0,pendingCols=0,pendingPitch=0;
 int64_t pendingR0=0,pendingC0=0;
 GlobalTensor<float> sg;sg.SetGlobalBuffer((__gm__ float*)scale);
 GlobalTensor<half> yg;yg.SetGlobalBuffer((__gm__ half*)y);
 // group_list lives in UB: the per-expert loop below runs on every core, so
 // reading it from GM costs E scalar loads per core (E can be 128).
 pipe.InitBuffer(glBuf,128*8);auto glv=glBuf.Get<int64_t>();
 {DataCopyExtParams gp{1,(uint32_t)(E*8),0,0,0};DataCopyPadExtParams<int64_t> lp{false,0,0,0};
  DataCopyPad(glv,ends,gp,lp);SetFlag<HardEvent::MTE2_S>(EVENT_ID2);WaitFlag<HardEvent::MTE2_S>(EVENT_ID2);}
#endif
 if(shouldPack){
#ifdef __DAV_CUBE__
  CrossCoreWaitFlag<2>(0);
  CrossCoreSetFlag<0,PIPE_FIX>(1);
  CrossCoreWaitFlag<0>(1);
  CrossCoreSetFlag<2,PIPE_FIX>(2);
#else
  CrossCoreSetFlag<2,PIPE_MTE3>(0);
  CrossCoreWaitFlag<2>(2);
#endif
 }
 int64_t begin=0,prefix=0,produced=0;
#ifdef __DAV_CUBE__
 int64_t e=0;
 while(e<E){
  const TileShape runShape=ChooseGeometry(ends.GetValue(e)-begin,N);
  RegionL1Queues region;
  bool bound=false;
  for(;e<E;++e){
#else
 for(int64_t e=0;e<E;++e){
#endif
#ifdef __DAV_CUBE__
  const int64_t end=ends.GetValue(e);
#else
  const int64_t end=glv.GetValue(e);
#endif
  const TileShape geometry=ChooseGeometry(end-begin,N);
  const int tileM=geometry.m,tileN=geometry.n,stripRows=ES/(((tileN+63)/64)*64);
  const int64_t nt=(N+tileN-1)/tileN;
  const int64_t tasks=((end-begin+tileM-1)/tileM)*nt;
  const int64_t first=(core-prefix%cores+cores)%cores;
#ifdef __DAV_CUBE__
  if(tileM!=runShape.m||tileN!=runShape.n)break;
  if(first<tasks&&!bound){
   region.Init(pipe,anchor,tileM,tileN);
   bound=true;
  }
#endif
  for(int64_t task=first;task<tasks;task+=cores){
   const int64_t r0=begin+(task/nt)*tileM,c0=(task%nt)*tileN;
   const int rm=(int)(end-r0<tileM?end-r0:tileM),cn=(int)(N-c0<tileN?N-c0:tileN);
   const int64_t ordinal=produced++;
   const int slot=(int)(ordinal&3);
   const uint16_t readyFlag=8+2*slot,ackFlag=readyFlag+1;
#ifdef __DAV_CUBE__
   if(ordinal>=4)CrossCoreWaitFlag<2>(ackFlag);
   panel.Compute(region,a,b,cg[slot*TM*TN],e,r0,c0,rm,cn,K,bStride,tileN,fullPanels,tail,firstPanel);
   CrossCoreSetFlag<2,PIPE_FIX>(readyFlag);
#else
   // AIV: drain this slot in fixed4096-element strips using the actual producer row pitch.
   CrossCoreWaitFlag<2>(readyFlag);
   // Split the live rows evenly between the two vector cores. The old "sub*VM" split gave
   // the second AIV zero rows whenever rm < TM, so raising TM used to be a net loss.
   int myRm=(sub==0)?((rm+1)/2):(rm/2);const int64_t myR0=r0+(sub?((rm+1)/2):0);
   if(myRm<=0){CrossCoreSetFlag<2,PIPE_MTE2>(ackFlag);continue;}
   auto slotCgA=cg[slot*TM*TN+(int64_t)(myR0-r0)*tileN];
   const AivEpiloguePitch layout(cn);
   {auto scales=sq.AllocTensor<float>();layout.ReadScale(scales,sg[e*N+c0]);sq.EnQue(scales);}
   auto sc=sq.DeQue<float>();
   layout.ClearScaleTail(sc);
   bool ciQueued=false;
   for(int m0=0;m0<myRm;m0+=stripRows){
    const int rm=(myRm-m0<stripRows)?(myRm-m0):stripRows;const int64_t r0=myR0+m0;const int pitch=layout.pitch;
    if(!ciQueued){
     auto first=cq.AllocTensor<int32_t>();
     layout.ReadC(first,slotCgA[(int64_t)m0*tileN],rm,tileN);cq.EnQue(first);
    }
    auto ci=cq.DeQue<int32_t>();ciQueued=false;
    // Compact padding writes only unused input lanes after DeQue.
    // Current strip owns one queue buffer; the other receives the next strip
    // while current FP32 math and scalar repair run. The existing final-strip
    // DeQue precedes ACK, so Cube cannot reuse the GM slot before all reads finish.
    if(m0+stripRows<myRm){
     const int nm=m0+stripRows,nr=(myRm-nm<stripRows)?(myRm-nm):stripRows;
     auto future=cq.AllocTensor<int32_t>();
     layout.ReadC(future,slotCgA[(int64_t)nm*tileN],nr,tileN);cq.EnQue(future);ciQueued=true;
    }
    if(m0+stripRows>=myRm)CrossCoreSetFlag<2,PIPE_MTE2>(ackFlag);
    // Two retained z/pos banks, common arithmetic scratch, two index banks.
    // No arithmetic scratch aliases the int32 input or either pending bank.
    auto z=bankStorage[stripBank*2*ES],pos=z[ES];
    auto u=bankStorage[4*ES],den=bankStorage[5*ES],neg=bankStorage[6*ES];
    auto compactIndices=bankStorage[7*ES+stripBank*(ES/2)];
    layout.ClearCTail(ci,rm);
    const int count=rm*pitch;
    Cast(z,ci,RoundMode::CAST_RINT,count);
    for(int col=0;col<pitch;col+=64)Mul(z[col],z[col],sc[col],(uint64_t)64,(uint8_t)rm,BinaryRepeatParams{1,1,1,(uint8_t)(pitch/8),(uint8_t)(pitch/8),0});
    // Lean FP32 main path, with explicit midpoint repair below.
    Mul(u,z,z,count);Muls(u,u,0.044715f,count);Adds(u,u,1.0f,count);
    Mul(u,u,z,count);Muls(u,u,-1.5957691216057308f,count);
    Exp(den,u,count);Adds(u,den,1.0f,count);
    Div(pos,z,u,count);
    // The coarse mask includes every lane admitted by the existing fine predicate.
    // Adds/CompareScalar int32 EQ are supported by the dav_c220 public API.
    // No case table, cross-call state or omitted mathematical stage.
    auto mask0=calc.Get<uint8_t>()[8*ES*4];
    Abs(u,pos,count);
    Adds(u,u,0x1p-14f,count);
    Adds(neg.ReinterpretCast<int32_t>(),u.ReinterpretCast<int32_t>(),(int32_t)32,count);
    // The same power-of-two bias shifts normal mantissas by 256 or 128. Ignoring those two bits includes both shifts. The original scalar fine predicate filters additional matches.
    auto neg16=neg.ReinterpretCast<uint16_t>();
    And(neg16,neg16,midpointBits,(uint64_t)128,(uint8_t)(count/64),BinaryRepeatParams{1,1,1,8,8,0});
    CompareScalar(mask0,neg.ReinterpretCast<int32_t>(),(int32_t)kMidpointMatch,CMPMODE::EQ,count);
    // exact_repair_needed still checks the original z range before any patch.
    // Explicitly initialized tail lanes produce zero and fail the unchanged coarse predicate.
    // One compact index stream replaces the two-stream deferred patch path.
    // Unlike v3, no scalar scan over all mask words in full-column tiles.
    // Current vector math/screen has been issued. Only now repair/write the
    // previous bank; its z/pos/index tensors are distinct from current storage.
    // Emit before GatherMask: reading its reserved count may interlock Scalar.
    if(pendingStrip)EmitPendingFullBank(oq,yg,table,pendingZ,pendingIndices,pendingPos,
      pendingCount,pendingRows,pendingCols,pendingPitch,pendingR0,pendingC0,N);
    uint64_t compactCount=0;
    GatherMask(compactIndices.ReinterpretCast<int16_t>(),indexValues,mask0.ReinterpretCast<uint16_t>(),true,count,{1,1,8,0},compactCount);
    SetFlag<HardEvent::V_S>(EVENT_ID1);WaitFlag<HardEvent::V_S>(EVENT_ID1);
    pendingZ=z;pendingIndices=compactIndices;pendingPos=pos;pendingCount=(int)compactCount;
    pendingRows=rm;pendingCols=cn;pendingPitch=pitch;pendingR0=r0;pendingC0=c0;
    pendingStrip=true;stripBank^=1;
    // All current vector reads are complete; pending z/pos/indices are retained separately.
    cq.FreeTensor(ci);
   }
   sq.FreeTensor(sc);
#endif
  }
  begin=end;
  prefix+=tasks;
 }
#ifdef __DAV_CUBE__
  if(bound)region.Finish();
 }

 for(int64_t i=produced>4?produced-4:0;i<produced;++i)
  CrossCoreWaitFlag<2>((uint16_t)(9+2*(i&3)));
#else
 if(pendingStrip)EmitPendingFullBank(oq,yg,table,pendingZ,pendingIndices,pendingPos,
  pendingCount,pendingRows,pendingCols,pendingPitch,pendingR0,pendingC0,N);
#endif
}

}

__aicore__ inline void PublishStrictMicro(AscendC::TQue<AscendC::TPosition::VECOUT,1>& oq,
 AscendC::GlobalTensor<half>& output,AscendC::LocalTensor<float> values,int count){
 using namespace AscendC;
 auto out=oq.AllocTensor<half>();Cast(out,values,RoundMode::CAST_RINT,count);
 oq.EnQue(out);out=oq.DeQue<half>();
 DataCopyExtParams p{1,(uint32_t)(count*2),0,0,0};
 DataCopyPad(output,out,p);
 oq.FreeTensor(out);
}

__global__ __vector__ void grouped_micro_direct(GM_ADDR x,GM_ADDR weight,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,
 int64_t M,int64_t N,int64_t K,int64_t E){
 using namespace AscendC;TPipe pipe;TBuf<TPosition::VECCALC> buf;TQue<TPosition::VECOUT,1> oq;
 pipe.InitBuffer(buf,6*256*4);pipe.InitBuffer(oq,1,256*2);auto result=buf.Get<float>();auto z=result,u=z[256],tail=z[512],den=z[768],pos=z[1024],neg=z[1280];
 GlobalTensor<int8_t> a,b;a.SetGlobalBuffer((__gm__ int8_t*)x);b.SetGlobalBuffer((__gm__ int8_t*)weight);
 GlobalTensor<float> sc;sc.SetGlobalBuffer((__gm__ float*)scale);
 GlobalTensor<int64_t> ends;ends.SetGlobalBuffer((__gm__ int64_t*)groups);

 const int64_t lane=GetBlockIdx();
 const int32_t blocks=GetBlockNum();
 const int32_t shift=blocks>=4?2:(blocks>=2?1:0);
 const int64_t whole=M>>shift, extra=M-(whole<<shift);
 const int64_t begin=lane*whole+(lane<extra?lane:extra);
 const int64_t rows=whole+(lane<extra);
 GlobalTensor<half> outg;outg.SetGlobalBuffer((__gm__ half*)y+begin*N);
 int64_t e=0,end=ends.GetValue(0);
 for(int64_t m=begin;m<begin+rows;++m){
  while(m>=end&&e+1<E){++e;end=ends.GetValue(e);}
  const int64_t xRow=m*K,wExpert=e*K*N,scaleRow=e*N,outputRow=(m-begin)*N;
  int64_t n=0;
  // Reuse one scalar A load across a complete four-column dot block.
  for(;n+4<=N;n+=4){
   int32_t d0=0,d1=0,d2=0,d3=0;
   for(int64_t k=0;k<K;++k){
    const int32_t av=(int32_t)a.GetValue(xRow+k);
    const int64_t w=wExpert+k*N+n;
    d0+=av*(int32_t)b.GetValue(w);d1+=av*(int32_t)b.GetValue(w+1);
    d2+=av*(int32_t)b.GetValue(w+2);d3+=av*(int32_t)b.GetValue(w+3);
   }
   result.SetValue(outputRow+n,(float)d0*sc.GetValue(scaleRow+n));
   result.SetValue(outputRow+n+1,(float)d1*sc.GetValue(scaleRow+n+1));
   result.SetValue(outputRow+n+2,(float)d2*sc.GetValue(scaleRow+n+2));
   result.SetValue(outputRow+n+3,(float)d3*sc.GetValue(scaleRow+n+3));
  }
  for(;n<N;++n){
   int32_t dot=0;
   for(int64_t k=0;k<K;++k)dot+=(int32_t)a.GetValue(xRow+k)*(int32_t)b.GetValue(wExpert+k*N+n);
   result.SetValue(outputRow+n,(float)dot*sc.GetValue(scaleRow+n));
  }
 }
 SetFlag<HardEvent::S_V>(EVENT_ID0);WaitFlag<HardEvent::S_V>(EVENT_ID0);
 int count=(int)(rows*N);
 // Keep numerator and 1+t apart, take one Newton step, then round with the exact
 // midpoint test: at 20 elements the extra vector ops are free, and this removes two
 // whole-pipeline drains plus the scalar correction scan.
 Mul(u,z,z,count);Muls(u,u,0.044715f,count);Adds(u,u,1.0f,count);
 Mul(u,u,z,count);Abs(u,u,count);Muls(u,u,-1.5957691216057308f,count);
 Exp(tail,u,count);Adds(u,tail,1.0f,count);
 Maxs(pos,z,0.0f,count);Mins(neg,z,0.0f,count);
 Mul(neg,neg,tail,count);Add(pos,pos,neg,count);
 Div(den,pos,u,count);
 // Send the complete fast result while the strict scalar predicate is checked.
 // A required repair publishes the fully corrected row-major output again.
 PublishStrictMicro(oq,outg,den,count);
 SetFlag<HardEvent::V_S>(EVENT_ID0);WaitFlag<HardEvent::V_S>(EVENT_ID0);
 bool dirty=false;
 for(int c=0;c<count;++c){
  const float q=den.GetValue(c);
  union {float f;uint32_t u;} bits;
  bits.f=q;
  const uint32_t mag=bits.u&0x7fffffffu;
  const uint32_t exponent=mag>>23;
  if(exponent<101u)continue;
  // Every allowed normal-lane guard is at most 128 low mantissa units.
  if(exponent>=113u&&((mag&8191u)-3968u)>256u)continue;
  const float input=z.GetValue(c);
  if(initial_ambiguous(q,input)){
   den.SetValue(c,precise_gelu(input));
   dirty=true;
  }
 }
 if(dirty){
  SetFlag<HardEvent::S_V>(EVENT_ID0);WaitFlag<HardEvent::S_V>(EVENT_ID0);
  PublishStrictMicro(oq,outg,den,count);
 }
}


struct R94Tile {
 int64_t expert, row, column;
 int rows, columns;
};

template<class Ends>
class WaveCursor {
 Ends& ends_;
 const int64_t groups_, n_, core_, cores_, columnTiles_;
 int64_t expert_=-1, begin_=0, end_=0, prefix_=0;
 int64_t index_=0, limit_=0, residue_=0;

 __aicore__ inline void Step() {
  if(residue_==0){
   residue_=cores_-1;
   index_+=2*cores_-1;
  }else{
   --residue_;
   index_+=cores_-1;
  }
 }

public:
 __aicore__ inline WaveCursor(Ends& ends,int64_t groups,int64_t n,int64_t core,int64_t cores,int64_t,int64_t)
  :ends_(ends),groups_(groups),n_(n),core_(core),cores_(cores),columnTiles_((n+TN-1)/TN) {}

 __aicore__ inline bool Next(R94Tile& tile) {
  while(index_>=limit_){
   if(++expert_>=groups_)return false;
   begin_=end_;
   end_=ends_.GetValue(expert_);
   if(begin_==end_)continue;
   limit_=((end_-begin_+TM-1)/TM)*columnTiles_;
   const int64_t wave=prefix_/cores_;
   residue_=core_-wave%cores_;
   if(residue_<0)residue_+=cores_;
   index_=wave*cores_+residue_-prefix_;
   if(index_<0)Step();
   prefix_+=limit_;
  }
  tile.expert=expert_;
  tile.row=begin_+(index_/columnTiles_)*TM;
  tile.column=(index_%columnTiles_)*TN;
  const int64_t rows=end_-tile.row,cols=n_-tile.column;
  tile.rows=(int)(rows<TM?rows:TM);
  tile.columns=(int)(cols<TN?cols:TN);
  Step();
  return true;
 }
};


// Assign disjoint row intervals. Both sides derive the same interval from this call's group ends.
template<class Ends>
class RowBandCursor {
 Ends& ends_;
 const int64_t n_,extra_;
 int64_t row_=0,limit_=0,column_=0,nextExpert_=0,expert_=0,groupEnd_=0;

 struct Cut { int64_t row,expert,end; };

 // Weight traffic in units of a row of A, C, Y, and amortized full B tiles.
 __aicore__ inline static int64_t GroupWeight(int64_t k,int64_t n) {
  const int64_t bytes=k*n;
  return bytes/(k+6*n+(bytes+TM-1)/TM);
 }

 __aicore__ inline Cut FindCut(int64_t target,int64_t groups,int64_t total,int64_t work) {
  if(target==work)return {total,groups,total};
  int64_t lo=0,hi=groups;
  while(lo<hi){
   const int64_t mid=lo+(hi-lo)/2;
   const int64_t boundary=ends_.GetValue(mid)+extra_*(mid+1);
   if(boundary<=target)lo=mid+1;else hi=mid;
  }
  const int64_t high=ends_.GetValue(lo);
  const int64_t low=lo?ends_.GetValue(lo-1):0;
  const int64_t len=high-low;
  const int64_t offset=target-low-extra_*lo;
  // Empty experts still cost metadata; their virtual weight maps to a single row cut.
  const int64_t row=low+(len ? offset*len/(len+extra_) : 0);
  return {row,lo,high};
 }

public:
 __aicore__ inline RowBandCursor(Ends& ends,int64_t groups,int64_t n,int64_t core,
                                 int64_t cores,int64_t total,int64_t k)
  :ends_(ends),n_(n),extra_(GroupWeight(k,n)) {
  const int64_t work=total+extra_*groups;
  const int64_t perCore=work/cores,remainder=work%cores;
  const int64_t start=core*perCore+(core*remainder)/cores;
  const int64_t stop=(core+1)*perCore+((core+1)*remainder)/cores;
  const Cut cut=FindCut(start,groups,total,work);
  row_=cut.row;expert_=cut.expert;groupEnd_=cut.end;
  nextExpert_=expert_+(cut.row<cut.end?1:0);
  limit_=FindCut(stop,groups,total,work).row;
 }

 __aicore__ inline bool Next(R94Tile& tile) {
  if(row_>=limit_)return false;
  while(row_>=groupEnd_){expert_=nextExpert_++;groupEnd_=ends_.GetValue(expert_);}
  const int64_t remaining=(groupEnd_<limit_?groupEnd_:limit_)-row_;
  const int rows=(int)(remaining<TM?remaining:TM);
  const int64_t left=n_-column_;
  const int columns=(int)(left<TN?left:TN);
  tile={expert_,row_,column_,rows,columns};
  column_+=columns;
  if(column_==n_){column_=0;row_+=rows;}
  return true;
 }
};

template<template<class> class Cursor>
__global__ __mix__(1,2) void shortk_wave_rotation(
 GM_ADDR x,GM_ADDR weight,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,GM_ADDR scratch,
 int64_t M,int64_t N,int64_t K,int64_t E){
 using namespace AscendC;
 TPipe pipe;
 const int64_t cores=GetBlockNum();
#ifdef __DAV_CUBE__
 const int64_t core=GetBlockIdx();
#else
 const int64_t core=GetBlockIdx()/2,sub=GetSubBlockIdx();
#endif
 GlobalTensor<int64_t> ends;
 ends.SetGlobalBuffer((__gm__ int64_t*)groups);
 GlobalTensor<int32_t> cg;
 cg.SetGlobalBuffer((__gm__ int32_t*)scratch+core*4*TM*TN);
 int64_t produced=0;
#ifdef __DAV_CUBE__
 GlobalTensor<int8_t> a,b;
 a.SetGlobalBuffer((__gm__ int8_t*)x);
 b.SetGlobalBuffer((__gm__ int8_t*)weight);
 CrossTileCube direct;
 direct.Init(pipe);
 Cursor<GlobalTensor<int64_t>> cursor(ends,E,N,core,cores,M,K);
 R94Tile tile{},next{};
 bool has=cursor.Next(tile);
 if(has)direct.Stage(a,b,tile.expert,tile.row,tile.column,tile.rows,tile.columns,K,N);
 while(has){
  const int64_t ordinal=produced++;
  const int slot=(int)(ordinal&3);
  const uint16_t readyFlag=8+2*slot,ackFlag=readyFlag+1;
  const bool queued=cursor.Next(next);
  if(queued)direct.Stage(a,b,next.expert,next.row,next.column,next.rows,next.columns,K,N);
  if(ordinal>=4)CrossCoreWaitFlag<2>(ackFlag);
  direct.Compute(cg[slot*TM*TN],tile.rows,tile.columns,(int)K);
  CrossCoreSetFlag<2,PIPE_FIX>(readyFlag);
  if(queued)tile=next;
  has=queued;
 }
 for(int64_t i=produced>4?produced-4:0;i<produced;++i)
  CrossCoreWaitFlag<2>((uint16_t)(9+2*(i&3)));
#else
 PackedGeluThresholds table;table.Init();
 TQue<TPosition::VECIN,2> cq,sq;TQue<TPosition::VECOUT,1> oq;TBuf<TPosition::VECCALC> calc,glBuf,indexBuf;
 pipe.InitBuffer(cq,2,ES*4);pipe.InitBuffer(sq,2,TN*4);bool prefetched=false;
 pipe.InitBuffer(oq,1,ES*2);pipe.InitBuffer(calc,8*ES*4+3*MB+kMidpointWords*4);
 auto midpointBits=calc.Get<uint16_t>()[((8*ES*4+3*MB)/2)];
 Duplicate(midpointBits.ReinterpretCast<int32_t>(),(int32_t)kMidpointMask,kMidpointWords);
 pipe.InitBuffer(indexBuf,ES*sizeof(int16_t));auto indexValues=indexBuf.Get<int16_t>();
 CreateVecIndex(indexValues,(int16_t)0,ES);
 // Two full z/u/pos banks preserve every candidate; no bounded candidate queue.
 // The held input queue remains arithmetic scratch after dequantization Cast.
 auto bankStorage=calc.Get<float>();int stripBank=0;bool pendingStrip=false;
 LocalTensor<float> pendingZ,pendingIndices,pendingPos;
 int pendingCount=0,pendingRows=0,pendingCols=0,pendingPitch=0;
 int64_t pendingR0=0,pendingC0=0;
 GlobalTensor<float> sg;sg.SetGlobalBuffer((__gm__ float*)scale);
 GlobalTensor<half> yg;yg.SetGlobalBuffer((__gm__ half*)y);
 // group_list lives in UB: the per-expert loop below runs on every core, so
 // reading it from GM costs E scalar loads per core (E can be 128).
 pipe.InitBuffer(glBuf,128*8);auto glv=glBuf.Get<int64_t>();
 {DataCopyExtParams gp{1,(uint32_t)(E*8),0,0,0};DataCopyPadExtParams<int64_t> lp{false,0,0,0};
  DataCopyPad(glv,ends,gp,lp);SetFlag<HardEvent::MTE2_S>(EVENT_ID2);WaitFlag<HardEvent::MTE2_S>(EVENT_ID2);}
 Cursor<LocalTensor<int64_t>> cursor(glv,E,N,core,cores,M,K);
 for(R94Tile tile{};cursor.Next(tile);){
   const int64_t ordinal=produced++;
   const int slot=(int)(ordinal&3);
   const uint16_t readyFlag=8+2*slot,ackFlag=readyFlag+1;
   const int64_t e=tile.expert,r0=tile.row,c0=tile.column;
   const int rm=tile.rows,cn=tile.columns;
   // AIV: drain this slot in EM-row strips so UB no longer scales with TM.
   CrossCoreWaitFlag<2>(readyFlag);
   // Split the live rows evenly between the two vector cores. The old "sub*VM" split gave
   // the second AIV zero rows whenever rm < TM, so raising TM used to be a net loss.
   int myRm=(sub==0)?((rm+1)/2):(rm/2);const int64_t myR0=r0+(sub?((rm+1)/2):0);
   if(myRm<=0){CrossCoreSetFlag<2,PIPE_MTE2>(ackFlag);continue;}
   auto slotCgA=cg[slot*TM*TN+(int64_t)(myR0-r0)*TN];
   const AivEpiloguePitch layout(cn);
   {auto scales=sq.AllocTensor<float>();layout.ReadScale(scales,sg[e*N+c0]);sq.EnQue(scales);}
   auto sc=sq.DeQue<float>();
   layout.ClearScaleTail(sc);
   bool ciQueued=false;
   for(int m0=0;m0<myRm;m0+=EM){
    const int rm=(myRm-m0<EM)?(myRm-m0):EM;const int64_t r0=myR0+m0;const int pitch=layout.pitch;
    if(!ciQueued){
     auto first=cq.AllocTensor<int32_t>();
     layout.ReadC(first,slotCgA[(int64_t)m0*TN],rm,TN);cq.EnQue(first);
    }
    auto ci=cq.DeQue<int32_t>();ciQueued=false;
    // Compact padding writes only unused input lanes after DeQue.
    // Current strip owns one queue buffer; the other receives the next strip
    // while current FP32 math and scalar repair run. The existing final-strip
    // DeQue precedes ACK, so Cube cannot reuse the GM slot before all reads finish.
    if(m0+EM<myRm){
     const int nm=m0+EM,nr=(myRm-nm<EM)?(myRm-nm):EM;
     auto future=cq.AllocTensor<int32_t>();
     layout.ReadC(future,slotCgA[(int64_t)nm*TN],nr,TN);cq.EnQue(future);ciQueued=true;
    }
    if(m0+EM>=myRm)CrossCoreSetFlag<2,PIPE_MTE2>(ackFlag);
    // Two retained z/pos banks, common arithmetic scratch, two index banks.
    // No arithmetic scratch aliases the int32 input or either pending bank.
    auto z=bankStorage[stripBank*2*ES],pos=z[ES];
    auto u=bankStorage[4*ES],den=bankStorage[5*ES],neg=bankStorage[6*ES];
    auto compactIndices=bankStorage[7*ES+stripBank*(ES/2)];
    layout.ClearCTail(ci,rm);
    const int count=rm*pitch;
    Cast(z,ci,RoundMode::CAST_RINT,count);
    for(int col=0;col<pitch;col+=64)Mul(z[col],z[col],sc[col],(uint64_t)64,(uint8_t)rm,BinaryRepeatParams{1,1,1,(uint8_t)(pitch/8),(uint8_t)(pitch/8),0});
    // Lean FP32 main path, with explicit midpoint repair below.
    Mul(u,z,z,count);Muls(u,u,0.044715f,count);Adds(u,u,1.0f,count);
    Mul(u,u,z,count);Muls(u,u,-1.5957691216057308f,count);
    Exp(den,u,count);Adds(u,den,1.0f,count);
    Div(pos,z,u,count);
    // The coarse mask includes every lane admitted by the existing fine predicate.
    // Adds/CompareScalar int32 EQ are supported by the dav_c220 public API.
    // No case table, cross-call state or omitted mathematical stage.
    auto mask0=calc.Get<uint8_t>()[8*ES*4];
    Abs(u,pos,count);
    Adds(u,u,0x1p-14f,count);
    Adds(neg.ReinterpretCast<int32_t>(),u.ReinterpretCast<int32_t>(),(int32_t)32,count);
    // The same power-of-two bias shifts normal mantissas by 256 or 128. Ignoring those two bits includes both shifts. The original scalar fine predicate filters additional matches.
    auto neg16=neg.ReinterpretCast<uint16_t>();
    And(neg16,neg16,midpointBits,(uint64_t)128,(uint8_t)(count/64),BinaryRepeatParams{1,1,1,8,8,0});
    CompareScalar(mask0,neg.ReinterpretCast<int32_t>(),(int32_t)kMidpointMatch,CMPMODE::EQ,count);
    // exact_repair_needed still checks the original z range before any patch.
    // Explicitly initialized tail lanes produce zero and fail the unchanged coarse predicate.
    // One compact index stream replaces the two-stream deferred patch path.
    // Unlike v3, no scalar scan over all mask words in full-column tiles.
    // Current vector math/screen has been issued. Only now repair/write the
    // previous bank; its z/pos/index tensors are distinct from current storage.
    // Emit before GatherMask: reading its reserved count may interlock Scalar.
    if(pendingStrip)EmitPendingFullBank(oq,yg,table,pendingZ,pendingIndices,pendingPos,
      pendingCount,pendingRows,pendingCols,pendingPitch,pendingR0,pendingC0,N);
    uint64_t compactCount=0;
    GatherMask(compactIndices.ReinterpretCast<int16_t>(),indexValues,mask0.ReinterpretCast<uint16_t>(),true,count,{1,1,8,0},compactCount);
    SetFlag<HardEvent::V_S>(EVENT_ID1);WaitFlag<HardEvent::V_S>(EVENT_ID1);
    pendingZ=z;pendingIndices=compactIndices;pendingPos=pos;pendingCount=(int)compactCount;
    pendingRows=rm;pendingCols=cn;pendingPitch=pitch;pendingR0=r0;pendingC0=c0;
    pendingStrip=true;stripBank^=1;
    // All current vector reads are complete; pending z/pos/indices are retained separately.
    cq.FreeTensor(ci);
   }
   sq.FreeTensor(sc);
 }
 if(pendingStrip)EmitPendingFullBank(oq,yg,table,pendingZ,pendingIndices,pendingPos,
   pendingCount,pendingRows,pendingCols,pendingPitch,pendingR0,pendingC0,N);
#endif
}

static inline int64_t EstimateUnalignedRowBytes(int64_t n,int64_t tileColumns) {
 const int64_t step=n&-n;
 const int64_t full=n/tileColumns,tail=n%tileColumns;
 const int64_t tailRoom=(-tail)&127;
 return full*(128-step)+(tail?128-step-(tailRoom/step)*step:0);
}

static inline bool CanAmortizeWeightRows(int64_t m,int64_t n,int64_t e,int64_t aligned) {
 const int64_t rows=(m+e-1)/e;
 const int64_t copyBytes=n+aligned;
 const int64_t native=EstimateUnalignedRowBytes(n,256)*((rows+127)/128);
 const int64_t tall=EstimateUnalignedRowBytes(n,128)*((rows+255)/256);
 return native>copyBytes&&tall>copyBytes;
}


// ===================== merged: our kernel, for the shapes where it is faster =====
namespace MYV {
struct DD { float h,l; };
__aicore__ inline DD ddnorm(float h,float l){float s=h+l;return {s,l-(s-h)};}
__aicore__ inline DD ddadd(DD a,DD b){
 float s=a.h+b.h,v=s-a.h;
 float e=(a.h-(s-v))+(b.h-v);e=e+a.l;e=e+b.l;
 return ddnorm(s,e);
}
__aicore__ inline DD ddneg(DD a){return {-a.h,-a.l};}
__aicore__ inline DD ddmul(DD a,DD b){
 float p=a.h*b.h;
 float ca=4097.0f*a.h,cb=4097.0f*b.h;
 float ah=ca-(ca-a.h),al=a.h-ah,bh=cb-(cb-b.h),bl=b.h-bh;
 float e=((ah*bh-p)+ah*bl+al*bh)+al*bl;
 e=e+a.h*b.l;e=e+a.l*b.h;
 return ddnorm(p,e);
}
__aicore__ inline DD dddiv(DD a,DD b){
 float q=a.h/b.h;DD r=ddadd(a,ddneg(ddmul(b,{q,0})));
 float q2=(r.h+r.l)/b.h;DD s=ddadd({q,0},{q2,0});
 r=ddadd(a,ddneg(ddmul(b,s)));return ddadd(s,{(r.h+r.l)/b.h,0});
}
// The coefficients below are mathematical exp Taylor coefficients, not input/output tables.
__aicore__ inline DD ddexp(DD a){
 int n=(int)(a.h*1.4426950408889634f-0.5f);
 DD r=ddadd(a,ddneg(ddmul({(float)n,0},DD{0x1.62e4300000000p-1f,-0x1.05c6100000000p-29f})));
 DD p=DD{0x1.ae7f3e0000000p-45f,0x1.ccee080000000p-71f};
 p=ddadd(ddmul(p,r),DD{0x1.ae7f3e0000000p-41f,0x1.ccee080000000p-67f});
p=ddadd(ddmul(p,r),DD{0x1.93974a0000000p-37f,0x1.180f940000000p-62f});
p=ddadd(ddmul(p,r),DD{0x1.6124620000000p-33f,-0x1.8af25e0000000p-58f});
p=ddadd(ddmul(p,r),DD{0x1.1eed8e0000000p-29f,0x1.ff1b120000000p-54f});
p=ddadd(ddmul(p,r),DD{0x1.ae64560000000p-26f,0x1.fd51380000000p-52f});
p=ddadd(ddmul(p,r),DD{0x1.27e4fc0000000p-22f,-0x1.10ec140000000p-47f});
p=ddadd(ddmul(p,r),DD{0x1.71de3a0000000p-19f,0x1.55b1cc0000000p-45f});
p=ddadd(ddmul(p,r),DD{0x1.a01a020000000p-16f,-0x1.7f97fa0000000p-42f});
p=ddadd(ddmul(p,r),DD{0x1.a01a020000000p-13f,-0x1.7f97fa0000000p-39f});
p=ddadd(ddmul(p,r),DD{0x1.6c16c20000000p-10f,-0x1.27d27e0000000p-35f});
p=ddadd(ddmul(p,r),DD{0x1.1111120000000p-7f,-0x1.ddddde0000000p-32f});
p=ddadd(ddmul(p,r),DD{0x1.5555560000000p-5f,-0x1.5555560000000p-30f});
p=ddadd(ddmul(p,r),DD{0x1.5555560000000p-3f,-0x1.5555560000000p-28f});
p=ddadd(ddmul(p,r),DD{0x1.0000000000000p-1f,0x0.0p+0f});
p=ddadd(ddmul(p,r),DD{0x1.0000000000000p+0f,0x0.0p+0f});
p=ddadd(ddmul(p,r),DD{0x1.0000000000000p+0f,0x0.0p+0f});
 union {uint32_t u;float f;} two;two.u=(uint32_t)(n+127)<<23;
 return ddmul(p,{two.f,0});
}
__aicore__ inline float precise_gelu(float z){
 if(z>=8.0f)return z;
 if(z<=-8.0f)return -0.0f;
 DD a={z,0};DD u=ddmul(DD{0x1.9884540000000p-1f,-0x1.8579360000000p-26f},ddadd(a,ddmul(DD{0x1.6e4e260000000p-5f,0x1.a9003e0000000p-30f},ddmul(ddmul(a,a),a))));
 if(z>0)u=ddneg(u);
 DD tail=ddexp(ddmul(u,{2,0}));
 // The reference rounds (1+tail) to binary64 before reciprocal.
 if(z>0 && tail.h<0x1p-53f)return z;
 DD value=dddiv(z<0?ddmul(a,tail):a,ddadd({1,0},tail));
 // Preserve which side of a half midpoint the extended result lies on.
 // Prevent FP32 -> FP16 double rounding, including FP16 subnormals.
 union{float f;uint32_t u;} bits;bits.f=value.h;
 uint32_t mag=bits.u&0x7fffffffu;int exp=(int)(mag>>23);
 int shift=exp>=113?13:126-exp;
 if(shift>0&&shift<=24){
  uint32_t mask=(1u<<shift)-1u;
  uint32_t mant=(mag&0x7fffffu)|0x800000u;
  if((mant&mask)==(1u<<(shift-1))&&value.l!=0){
   bool away=(value.h<0)?value.l<0:value.l>0;
   bits.u=away?bits.u+1:bits.u-1;
  }
 }
 return bits.f;
}

__aicore__ inline bool near_half_midpoint(float q){
 union{float f;uint32_t u;} b;b.f=q;
 uint32_t mag=b.u&0x7fffffffu;int e=(int)(mag>>23);
 uint32_t mant=(mag&0x7fffffu)|0x800000u;
 if(e<101)return false;
 if(e==101)return (0x1000000u-mant)<=128;
 int shift=e>=113?13:126-e;
 int residual=(int)(mant&((1u<<shift)-1u))-(1<<(shift-1));
 return residual>=-128&&residual<=128;
}


__aicore__ inline bool refined_ambiguous(float q){
 union{float f;uint32_t u;} b;b.f=q;
 uint32_t mag=b.u&0x7fffffffu;int e=(int)(mag>>23);
 uint32_t mant=(mag&0x7fffffu)|0x800000u;
 if(e<101)return false;
 if(e==101)return (0x1000000u-mant)<=0;
 int shift=e>=113?13:126-e;
 int residual=(int)(mant&((1u<<shift)-1u))-(1<<(shift-1));
 return residual>=0&&residual<=0;
}



__aicore__ inline bool initial_ambiguous(float q,float z){
 union{float f;uint32_t u;} b;b.f=q;
 int guard=z>=0.0f?16:(z>=-1.0f?32:128);
 uint32_t mag=b.u&0x7fffffffu;int e=(int)(mag>>23);
 uint32_t mant=(mag&0x7fffffu)|0x800000u;
 if(e<101)return false;
 if(e==101)return (0x1000000u-mant)<=guard;
 int shift=e>=113?13:126-e;
 int residual=(int)(mant&((1u<<shift)-1u))-(1<<(shift-1));
 return residual>=-guard&&residual<=guard;
}



using namespace AscendC;
struct VDD { LocalTensor<float> h,l; };
class PackedDD {
 public:
 int length;
 LocalTensor<float> mem,t[12];VDD c,a,b,r,p,tail,num,den,q,v,w;
 __aicore__ inline void Init(LocalTensor<float> buf){
  mem=buf;for(int i=0;i<12;++i)t[i]=mem[i*256];
  c={mem[12*256],mem[13*256]};a={mem[14*256],mem[15*256]};b={mem[16*256],mem[17*256]};
  r={mem[18*256],mem[19*256]};p={mem[20*256],mem[21*256]};tail={mem[22*256],mem[23*256]};
  num={mem[24*256],mem[25*256]};den={mem[26*256],mem[27*256]};q={mem[28*256],mem[29*256]};
  v={mem[30*256],mem[31*256]};w={mem[32*256],mem[33*256]};
 }
 __aicore__ inline void constant(VDD x,float h,float l=0){Duplicate(x.h,h,length);Duplicate(x.l,l,length);}
 __aicore__ inline void add(VDD o,VDD x,VDD y){
  Add(t[0],x.h,y.h,length);Sub(t[1],t[0],x.h,length);Sub(t[2],t[0],t[1],length);
  Sub(t[3],x.h,t[2],length);Sub(t[4],y.h,t[1],length);Add(t[3],t[3],t[4],length);
  Add(t[3],t[3],x.l,length);Add(t[3],t[3],y.l,length);
  Add(t[5],t[0],t[3],length);Sub(t[6],t[5],t[0],length);Sub(t[6],t[3],t[6],length);
  Adds(o.h,t[5],0.0f,length);Adds(o.l,t[6],0.0f,length);
 }
 __aicore__ inline void mul(VDD o,VDD x,VDD y){
  Mul(t[0],x.h,y.h,length);Muls(t[1],x.h,4097.0f,length);Muls(t[2],y.h,4097.0f,length);
  Sub(t[3],t[1],x.h,length);Sub(t[3],t[1],t[3],length);Sub(t[4],x.h,t[3],length);
  Sub(t[5],t[2],y.h,length);Sub(t[5],t[2],t[5],length);Sub(t[6],y.h,t[5],length);
  Mul(t[7],t[3],t[5],length);Sub(t[7],t[7],t[0],length);
  Mul(t[8],t[3],t[6],length);Add(t[7],t[7],t[8],length);
  Mul(t[8],t[4],t[5],length);Add(t[7],t[7],t[8],length);
  Mul(t[8],t[4],t[6],length);Add(t[7],t[7],t[8],length);
  Mul(t[8],x.h,y.l,length);Add(t[7],t[7],t[8],length);
  Mul(t[8],x.l,y.h,length);Add(t[7],t[7],t[8],length);
  Add(t[9],t[0],t[7],length);Sub(t[10],t[9],t[0],length);Sub(t[10],t[7],t[10],length);
  Adds(o.h,t[9],0.0f,length);Adds(o.l,t[10],0.0f,length);
 }
 __aicore__ inline void mc(VDD o,VDD x,float h,float l=0){
  // Split a mathematical constant once; retain the same Dekker error terms.
  float ch=4097.0f*h,bh=ch-(ch-h),bl=h-bh;
  Muls(t[0],x.h,h,length);Muls(t[1],x.h,4097.0f,length);
  Sub(t[3],t[1],x.h,length);Sub(t[3],t[1],t[3],length);Sub(t[4],x.h,t[3],length);
  Muls(t[7],t[3],bh,length);Sub(t[7],t[7],t[0],length);
  Muls(t[8],t[3],bl,length);Add(t[7],t[7],t[8],length);
  Muls(t[8],t[4],bh,length);Add(t[7],t[7],t[8],length);
  Muls(t[8],t[4],bl,length);Add(t[7],t[7],t[8],length);
  Muls(t[8],x.h,l,length);Add(t[7],t[7],t[8],length);
