// B is [E][K][N] int8 => row stride N bytes.  The ND->NZ load of a column band then
// crosses a 128-byte boundary on every fractal whenever N%128!=0, which measured
// 2.2~3.2x slower for identical work.  The padded copy has row stride Np%128==0.
// Batched copy: `n` whole rows per DMA.  On the UB side the framework packs each block
// at align32(blockLen), so the UB->GM pass uses srcStride=0 (blocks are already
// back to back) and dstStride=(Np-Nr) bytes (the GM-side row gap).
__global__ __vector__ void grouped_pad_b(GM_ADDR src,GM_ADDR dst,int64_t E,int64_t K,int64_t Nr,int64_t Np){
 if(Np<=Nr||Nr<=0)return;
 using namespace AscendC;TPipe pipe;
 TBuf<TPosition::VECIN> ub0,ub1;pipe.InitBuffer(ub0,65536);pipe.InitBuffer(ub1,65536);
 auto u=ub0.Get<int8_t>(),ub2=ub1.Get<int8_t>();
 GlobalTensor<int8_t> s_,d_;s_.SetGlobalBuffer((__gm__ int8_t*)src);d_.SetGlobalBuffer((__gm__ int8_t*)dst);
 const int64_t rows=E*K,cores=GetBlockNum(),core=GetBlockIdx();
 const int64_t fp=((Nr+31)/32)*32;                       // UB footprint per row, 32B aligned
 // UB rows sit at stride Np (see the note above), so the store writes whole Np-byte rows.
 const int64_t ubGap=(Np-fp)/32;
