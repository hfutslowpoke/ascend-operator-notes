__aicore__ inline float midpoint_adjust(float z,float h,float l,float tail){
 // CurrentliteralCPUtorch reference castsFP64->FP32->FP16; do not nudgehalf ties.
 if(z>0&&tail<0x1p-53f)return z;
 return h;
}
__aicore__ inline void flush_precise(PackedDD &pd,LocalTensor<float> packed,LocalTensor<float> pos,int *indices,int size){
 SetFlag<HardEvent::S_V>(EVENT_ID1);WaitFlag<HardEvent::S_V>(EVENT_ID1);
 pd.gelu(packed,size);
 SetFlag<HardEvent::V_S>(EVENT_ID1);WaitFlag<HardEvent::V_S>(EVENT_ID1);
 for(int i=0;i<size;++i){
  float z=packed.GetValue(i),h=pd.q.h.GetValue(i);
  pos.SetValue(indices[i],refined_ambiguous(h)?precise_gelu(z):midpoint_adjust(z,h,pd.q.l.GetValue(i),pd.tail.h.GetValue(i)));
 }
}


// Invocation-local deferred rounding corrections. Output patches use MTE3
// byte-count stores, never scalar GM writes (which could race on a cache line).
__aicore__ inline void flush_pending(PackedDD &pd,LocalTensor<float> packed,
 int *indices,int size,LocalTensor<half> patch,GlobalTensor<half> yg){
 // A small actual refinement batch can use the existing full scalar
 // mathematical implementation instead of launching a64-lane DD batch.
 // Initial FP32 GELU, refinement predicate and final patch stores are unchanged.
 if(size<=4){
  for(int i=0;i<size;++i)pd.q.h.SetValue(i,precise_gelu(packed.GetValue(i)));
 }else{
 for(int i=size;i<((size+63)/64)*64;++i)packed.SetValue(i,0.0f);
 SetFlag<HardEvent::S_V>(EVENT_ID1);WaitFlag<HardEvent::S_V>(EVENT_ID1);
 pd.gelu(packed,size);
 SetFlag<HardEvent::V_S>(EVENT_ID1);WaitFlag<HardEvent::V_S>(EVENT_ID1);
 for(int i=0;i<size;++i){float z=packed.GetValue(i),h=pd.q.h.GetValue(i);
  pd.q.h.SetValue(i,refined_ambiguous(h)?precise_gelu(z):midpoint_adjust(z,h,pd.q.l.GetValue(i),pd.tail.h.GetValue(i)));}
 }
 SetFlag<HardEvent::S_V>(EVENT_ID1);WaitFlag<HardEvent::S_V>(EVENT_ID1);
 Cast(patch,pd.q.h,RoundMode::CAST_RINT,size);
 SetFlag<HardEvent::V_S>(EVENT_ID1);WaitFlag<HardEvent::V_S>(EVENT_ID1);
 for(int i=0;i<size;++i)patch.SetValue(256+i*16,patch.GetValue(i));
 // All approximate output DMA writes must finish before correction stores.
 SetFlag<HardEvent::MTE3_S>(EVENT_ID2);WaitFlag<HardEvent::MTE3_S>(EVENT_ID2);
 SetFlag<HardEvent::S_MTE3>(EVENT_ID2);WaitFlag<HardEvent::S_MTE3>(EVENT_ID2);
 DataCopyExtParams one{1,2,0,0,0};
 for(int i=0;i<size;++i)DataCopyPad(yg[indices[i]],patch[256+i*16],one);
 SetFlag<HardEvent::MTE3_S>(EVENT_ID2);WaitFlag<HardEvent::MTE3_S>(EVENT_ID2);
}

constexpr int TM=128,TN=256,EM=16,VM=TM/2,SZ=VM*TN,ES=EM*TN,MB=((ES+255)/256)*32;
constexpr int kMidpointWords=64,kMidpointMask=0x07001e40,kMidpointMatch=0x00001000;

#ifdef __DAV_CUBE__
// Invocation-local full-input staging and independent half-tile accumulators.
// Public basic APIs; validated INT32 layout from cross_tile_cube_r14_v1.
class CrossTileCube {
 AscendC::TQue<AscendC::TPosition::A1,2> aq;
 AscendC::TQue<AscendC::TPosition::B1,2> bq;
 AscendC::TQue<AscendC::TPosition::A2,2> a2;
 AscendC::TQue<AscendC::TPosition::B2,2> b2;
 AscendC::TQue<AscendC::TPosition::CO1,2> cq;
public:
 __aicore__ inline void Init(AscendC::TPipe& pipe){
  pipe.InitBuffer(aq,2,128*512);pipe.InitBuffer(bq,2,512*256);
  pipe.InitBuffer(a2,2,64*128);pipe.InitBuffer(b2,2,128*256);pipe.InitBuffer(cq,2,64*256*4);
 }
 __aicore__ inline void Stage(AscendC::GlobalTensor<int8_t>& a,AscendC::GlobalTensor<int8_t>& b,
  int64_t e,int64_t r0,int64_t c0,int rm,int cn,int64_t K,int64_t N){
  using namespace AscendC;int mp=(rm+15)/16*16;
  auto la=aq.AllocTensor<int8_t>(),lb=bq.AllocTensor<int8_t>();
  Nd2NzParams ap{1,(uint16_t)rm,(uint16_t)K,0,(uint16_t)K,(uint16_t)mp,1,0};
  Nd2NzParams bp{1,(uint16_t)K,(uint16_t)cn,0,(uint16_t)N,(uint16_t)K,1,0};
  DataCopy(la,a[r0*K],ap);DataCopy(lb,b[e*K*N+c0],bp);aq.EnQue(la);bq.EnQue(lb);
 }
 __aicore__ inline void Compute(AscendC::GlobalTensor<int32_t> dst,int rm,int cn,int K){
  using namespace AscendC;int mp=(rm+15)/16*16,bn=(cn+31)/32*32;
  auto la=aq.DeQue<int8_t>(),lb=bq.DeQue<int8_t>();
  for(int mo=0;mo<rm;mo+=64){
   int rows=rm-mo<64?rm-mo:64,am=(rows+15)/16*16;auto acc=cq.AllocTensor<int32_t>();
   for(int kk=0;kk<K;kk+=128){
    int kc=K-kk<128?K-kk:128;auto aa=a2.AllocTensor<int8_t>(),bb=b2.AllocTensor<int8_t>();
    LoadData2dParams pa{};pa.repeatTimes=kc/32;pa.srcStride=mp/16;
    for(int mr=0;mr<am/16;++mr)LoadData(aa[mr*kc*16],la[(mo+mr*16)*32+kk*mp],pa);
    LoadData2dTransposeParams pb{};pb.repeatTimes=bn/32;pb.srcStride=K/32;pb.dstGap=1;
    for(int kr=0;kr<kc/32;++kr)LoadDataWithTranspose(bb[kr*((cn+15)/16)*16*32],lb[(kk+kr*32)*32],pb);
    a2.EnQue(aa);b2.EnQue(bb);aa=a2.DeQue<int8_t>();bb=b2.DeQue<int8_t>();
    MmadParams mm{};mm.m=am;mm.n=cn;mm.k=kc;mm.cmatrixInitVal=(kk==0);Mmad(acc,aa,bb,mm);
    if((am/16)*(cn/16)<10)PipeBarrier<PIPE_M>();
    a2.FreeTensor(aa);b2.FreeTensor(bb);
   }
   cq.EnQue(acc);acc=cq.DeQue<int32_t>();FixpipeParamsV220 fp{};
   fp.mSize=rows;fp.nSize=cn;fp.srcStride=am;fp.dstStride=256;
   Fixpipe<int32_t,int32_t,CFG_ROW_MAJOR>(dst[mo*256],acc,fp);cq.FreeTensor(acc);
  }
  aq.FreeTensor(la);bq.FreeTensor(lb);
 }
};
// One full128-row INT32 accumulator and two bounded512-column K panels in L1.
// Complete one output tile before Fixpipe; no partial-K scaling or activation.
class LongKPanelCube {
 AscendC::TQue<AscendC::TPosition::A1,2> aq;
 AscendC::TQue<AscendC::TPosition::B1,2> bq;
 AscendC::TQue<AscendC::TPosition::A2,2> a2;
 AscendC::TQue<AscendC::TPosition::B2,2> b2;
 AscendC::TQue<AscendC::TPosition::CO1,1> cq;
public:
 __aicore__ inline void Init(AscendC::TPipe& pipe){
  pipe.InitBuffer(aq,2,128*512);pipe.InitBuffer(bq,2,512*256);
  pipe.InitBuffer(a2,2,128*128);pipe.InitBuffer(b2,2,128*256);pipe.InitBuffer(cq,1,128*256*4);
 }
 __aicore__ inline void Stage(AscendC::GlobalTensor<int8_t>& a,AscendC::GlobalTensor<int8_t>& b,
  int64_t e,int64_t r0,int64_t c0,int rm,int cn,int64_t K,int64_t N,int k0,int kp){
  using namespace AscendC;const int mp=(rm+15)/16*16;
  auto la=aq.AllocTensor<int8_t>(),lb=bq.AllocTensor<int8_t>();
  Nd2NzParams ap{1,(uint16_t)rm,(uint16_t)kp,0,(uint16_t)K,(uint16_t)mp,1,0};
  Nd2NzParams bp{1,(uint16_t)kp,(uint16_t)cn,0,(uint16_t)N,(uint16_t)kp,1,0};
  DataCopy(la,a[r0*K+k0],ap);DataCopy(lb,b[e*K*N+(int64_t)k0*N+c0],bp);
  aq.EnQue(la);bq.EnQue(lb);
 }
 template<bool Reorder=false>
 __aicore__ inline void Compute(AscendC::GlobalTensor<int8_t>& a,AscendC::GlobalTensor<int8_t>& b,
  AscendC::GlobalTensor<int32_t> dst,int64_t e,int64_t r0,int64_t c0,int rm,int cn,int64_t K,int64_t N,
  int firstK=0){
  using namespace AscendC;const int mp=(rm+15)/16*16,bn=(cn+31)/32*32;
  auto acc=cq.AllocTensor<int32_t>();
  int stagedK=0;
  if constexpr(Reorder)stagedK=firstK;
  // The host selects the reordered native entry only for K >= six panels.
  const int firstWidth=Reorder?512:(int)(K<512?K:512);
  Stage(a,b,e,r0,c0,rm,cn,K,N,stagedK,firstWidth);
  for(int issuedK=0;issuedK<K;issuedK+=512){
   const int kp=(int)(K-issuedK<512?K-issuedK:512);
   auto la=aq.DeQue<int8_t>(),lb=bq.DeQue<int8_t>();
   // An aligned K can start anywhere on the ring. A partial panel starts at zero.
   if(issuedK+kp<K){
    const int nextOrdinal=issuedK+kp,nkp=(int)(K-nextOrdinal<512?K-nextOrdinal:512);
    int nk=nextOrdinal;
    if constexpr(Reorder){
     nk=stagedK+512;
     if(nk==K)nk=0;
     stagedK=nk;
    }
    Stage(a,b,e,r0,c0,rm,cn,K,N,nk,nkp);
   }
   for(int kk=0;kk<kp;kk+=128){
    const int kc=kp-kk<128?kp-kk:128;
    // One128-row accumulator reuses each B L0 panel across all active rows.
    auto aa=a2.AllocTensor<int8_t>(),bb=b2.AllocTensor<int8_t>();
    LoadData2dParams pa{};pa.repeatTimes=kc/32;pa.srcStride=mp/16;
    for(int mr=0;mr<mp/16;++mr)LoadData(aa[mr*kc*16],la[mr*16*32+kk*mp],pa);
    LoadData2dTransposeParams pb{};pb.repeatTimes=bn/32;pb.srcStride=kp/32;pb.dstGap=1;
    for(int kr=0;kr<kc/32;++kr)LoadDataWithTranspose(bb[kr*((cn+15)/16)*16*32],lb[(kk+kr*32)*32],pb);
    a2.EnQue(aa);b2.EnQue(bb);aa=a2.DeQue<int8_t>();bb=b2.DeQue<int8_t>();
    MmadParams mm{};mm.m=mp;mm.n=cn;mm.k=kc;mm.cmatrixInitVal=(issuedK==0&&kk==0);Mmad(acc,aa,bb,mm);
    if((mp/16)*(cn/16)<10)PipeBarrier<PIPE_M>();
    a2.FreeTensor(aa);b2.FreeTensor(bb);
   }
   aq.FreeTensor(la);bq.FreeTensor(lb);
  }
  // Complete the full K reduction before a single final output Fixpipe.
  cq.EnQue(acc);acc=cq.DeQue<int32_t>();
  FixpipeParamsV220 fp{};fp.mSize=rm;fp.nSize=cn;fp.srcStride=mp;fp.dstStride=256;
  Fixpipe<int32_t,int32_t,CFG_ROW_MAJOR>(dst,acc,fp);cq.FreeTensor(acc);
 }
 __aicore__ inline void ComputePartial(AscendC::GlobalTensor<int8_t>& a,AscendC::GlobalTensor<int8_t>& b,
  AscendC::GlobalTensor<int32_t> dst,int64_t e,int64_t r0,int64_t c0,int rm,int cn,int64_t K,int64_t N,int kb,int ke){
  using namespace AscendC;const int mp=(rm+15)/16*16,bn=(cn+31)/32*32;
  auto acc=cq.AllocTensor<int32_t>();
  Stage(a,b,e,r0,c0,rm,cn,K,N,kb,ke-kb<512?ke-kb:512);
  for(int k0=kb;k0<ke;k0+=512){
   const int kp=ke-k0<512?ke-k0:512;
   auto la=aq.DeQue<int8_t>(),lb=bq.DeQue<int8_t>();
   // Queue depth2: preserve the active panel while next-panel MTE2 is issued.
   if(k0+kp<ke){const int nk=k0+kp,nkp=ke-nk<512?ke-nk:512;Stage(a,b,e,r0,c0,rm,cn,K,N,nk,nkp);}
   for(int kk=0;kk<kp;kk+=128){
    const int kc=kp-kk<128?kp-kk:128;
    // One128-row accumulator reuses each B L0 panel across all active rows.
    auto aa=a2.AllocTensor<int8_t>(),bb=b2.AllocTensor<int8_t>();
    LoadData2dParams pa{};pa.repeatTimes=kc/32;pa.srcStride=mp/16;
    for(int mr=0;mr<mp/16;++mr)LoadData(aa[mr*kc*16],la[mr*16*32+kk*mp],pa);
    LoadData2dTransposeParams pb{};pb.repeatTimes=bn/32;pb.srcStride=kp/32;pb.dstGap=1;
    for(int kr=0;kr<kc/32;++kr)LoadDataWithTranspose(bb[kr*((cn+15)/16)*16*32],lb[(kk+kr*32)*32],pb);
    a2.EnQue(aa);b2.EnQue(bb);aa=a2.DeQue<int8_t>();bb=b2.DeQue<int8_t>();
    MmadParams mm{};mm.m=mp;mm.n=cn;mm.k=kc;mm.cmatrixInitVal=(k0==kb&&kk==0);Mmad(acc,aa,bb,mm);
    if((mp/16)*(cn/16)<10)PipeBarrier<PIPE_M>();
    a2.FreeTensor(aa);b2.FreeTensor(bb);
   }
   aq.FreeTensor(la);bq.FreeTensor(lb);
  }
  // Publish one bounded INT32 K range, which the tail AIVs merge before scaling.
  cq.EnQue(acc);acc=cq.DeQue<int32_t>();
  FixpipeParamsV220 fp{};fp.mSize=rm;fp.nSize=cn;fp.srcStride=mp;fp.dstStride=256;
  Fixpipe<int32_t,int32_t,CFG_ROW_MAJOR>(dst,acc,fp);cq.FreeTensor(acc);
 }
};
__aicore__ inline bool NextCubeTask(AscendC::GlobalTensor<int64_t>& ends,int64_t E,
 int64_t core,int64_t cores,int64_t e,int64_t begin,int64_t end,int64_t prefix,
 int64_t task,int64_t tasks,int64_t nt,int64_t N,
 int64_t& ne,int64_t& nr,int64_t& nc,int& nm,int& nn){
 ne=e;int64_t nb=begin,en=end,np=prefix,tt=task+cores,tas=tasks;
 while(tt>=tas){
  if(ne+1>=E)return false;
  nb=en;np+=tas;en=ends.GetValue(++ne);tas=((en-nb+TM-1)/TM)*nt;
  tt=(core-np%cores+cores)%cores;
 }
 nr=nb+(tt/nt)*TM;nc=(tt%nt)*TN;nm=(en-nr<TM)?en-nr:TM;nn=(N-nc<TN)?N-nc:TN;
 return true;
}
#endif

#ifndef __DAV_CUBE__
// The packed table represents the original FP32 GELU rounding thresholds exactly.
struct PackedGeluThresholds {
 AscendC::GlobalTensor<uint32_t> packed;

 __aicore__ inline void Init() {
  packed.SetGlobalBuffer(const_cast<__gm__ uint32_t*>(kPackedGeluThresholds));
 }

 __aicore__ inline float GetValue(int key) {
  const uint32_t index=(uint32_t)key,block=index>>5,lane=index&31u;
  const uint32_t meta=packed.GetValue(2*block+1);
  const uint32_t tag=(meta>>19)&7u;
  const uint32_t payload=320+(meta>>22);
  union {uint32_t bits;float value;} decoded;
  if(tag==4){
   decoded.bits=packed.GetValue(payload+lane);
  }else{
   const uint32_t width=2u<<tag,bit=lane*width;
   const uint32_t data=packed.GetValue(payload+(bit>>5));
   const uint32_t residual=(data>>(bit&31u))&((1u<<width)-1u);
   const int32_t slope=(int32_t)((meta&0x7ffffu)^0x40000u)-0x40000;
   const int32_t product=(int32_t)lane*slope;
   const uint32_t base=packed.GetValue(2*block);
   decoded.bits=base+(uint32_t)product+residual;
  }
  return decoded.value;
 }
};

// Full previous strip remains in its own bank. No candidate packing or GM patch.
__aicore__ inline float SparseRound(float q,float z,PackedGeluThresholds& table){
 union{float f;uint32_t u;} b;b.f=q;uint32_t sign=b.u&0x80000000u,mag=b.u&0x7fffffffu;b.u=mag;
 int h,key;const bool tail=z<-1.f;
 if(b.f<0x1p-14f){h=(int)(b.f*0x1p24f);key=h+(z<0.f?1024:0)+(tail?1024:0);}
 else if(b.f>=2.f&&b.f<8.f){h=(int)(mag>>13)-0x1c000;key=3072+h-0x4000;}
 else return q;
 float threshold=table.GetValue(key),az=z<0.f?-z:z;
 h+=(tail?az<threshold:az>=threshold)?1:0;
 if(h<1024){b.f=(float)h*0x1p-24f;b.u|=sign;}
 else b.u=((uint32_t)(h+0x1c000)<<13)|sign;
 return b.f;
}
// Initialize only the invalid lanes in a partial final column tile.
struct AivEpiloguePitch {
 int cols;
 int pitch;
 int roundedCols;

 __aicore__ inline explicit AivEpiloguePitch(int cn)
  : cols(cn),pitch(((cn+63)/64)*64),roundedCols(((cn+7)/8)*8) {}

 __aicore__ inline void ReadScale(AscendC::LocalTensor<float> dst,AscendC::GlobalTensor<float> src) const {
  using namespace AscendC;
  DataCopyExtParams p{1,(uint32_t)(cols*4),0,0,0};
  DataCopyPadExtParams<float> pad{cols!=pitch,0,(uint8_t)(roundedCols-cols),0.0f};
  DataCopyPad(dst,src,p,pad);
 }

 __aicore__ inline void ReadC(AscendC::LocalTensor<int32_t> dst,AscendC::GlobalTensor<int32_t> src,
                             int rows,int sourcePitch) const {
  using namespace AscendC;
  DataCopyExtParams p{(uint16_t)rows,(uint32_t)(cols*4),(uint32_t)((sourcePitch-cols)*4),
                      (uint32_t)((pitch-roundedCols)/8),0};
  DataCopyPadExtParams<int32_t> pad{cols!=pitch,0,(uint8_t)(roundedCols-cols),0};
  DataCopyPad(dst,src,p,pad);
 }

 __aicore__ inline void ClearScaleTail(AscendC::LocalTensor<float> sc) const {
  if(roundedCols<pitch)AscendC::Duplicate(sc[roundedCols],0.0f,pitch-roundedCols);
 }

 __aicore__ inline void ClearCTail(AscendC::LocalTensor<int32_t> ci,int rows) const {
  using namespace AscendC;
  if(roundedCols<pitch){
   const int gap=pitch-roundedCols;
   Duplicate(ci[roundedCols],(int32_t)0,(uint64_t)gap,(uint8_t)rows,1,pitch/8);
  }
 }
};

__aicore__ inline void EmitPendingFullBank(AscendC::TQue<AscendC::TPosition::VECOUT,1>& oq,
 AscendC::GlobalTensor<half>& yg,PackedGeluThresholds& table,AscendC::LocalTensor<float> z,
 AscendC::LocalTensor<float> indices,AscendC::LocalTensor<float> pos,
 int coarseCount,int rows,int cn,int pitch,int64_t r0,int64_t c0,int64_t N){
 using namespace AscendC;
 // The previous bank completed V_S immediately after its GatherMask.
 // Current vector instructions use the opposite bank. Keep these scalar
 // accesses under that explicit dependency rather than aliasing LocalTensors.
 // Each z/pos bank spans2*4096 floats; each retained index bank spans4096 int16.
 auto previousIndices=reinterpret_cast<__ubuf__ int16_t*>(indices.GetPhyAddr());
 auto previousPos=reinterpret_cast<__ubuf__ float*>(pos.GetPhyAddr());
 auto previousZ=reinterpret_cast<__ubuf__ float*>(z.GetPhyAddr());
 for(int i=0;i<coarseCount;++i){
  const int at=(int)previousIndices[i];
  const float q=previousPos[at],zz=previousZ[at];
  if(exact_repair_needed(q,zz))previousPos[at]=SparseRound(q,zz,table);
 }
 SetFlag<HardEvent::S_V>(EVENT_ID1);WaitFlag<HardEvent::S_V>(EVENT_ID1);
 auto out=oq.AllocTensor<half>();Cast(out,pos,RoundMode::CAST_RINT,rows*pitch);
 oq.EnQue(out);out=oq.DeQue<half>();
 DataCopyExtParams yp{(uint16_t)rows,(uint32_t)(cn*2),(uint32_t)((pitch-((cn+15)/16)*16)/16),(uint32_t)((N-cn)*2),0};
 DataCopyPad(yg[r0*N+c0],out,yp);oq.FreeTensor(out);
}


#endif

struct TailPartition {
 bool columns;
 int step;
};

__aicore__ inline TailPartition ChooseTailPartition(int rows,int cols,int64_t workers) {
 // Keep at least as many live slices as the row policy. A column partition
 // reads each B element once but rereads A, so choose it when that trade saves bytes.
 const int rowStep=(int)((rows+workers*EM-1)/(workers*EM))*EM;
 constexpr int kColumnAlign=64;
 const int colStep=(int)((cols+workers*kColumnAlign-1)/(workers*kColumnAlign))*kColumnAlign;
 const int rowPieces=(rows+rowStep-1)/rowStep,colPieces=(cols+colStep-1)/colStep;
 const bool columns=rowPieces>=2&&colPieces>=rowPieces&&(colPieces-1)*rows<(rowPieces-1)*cols;
 return TailPartition{columns,columns?colStep:rowStep};
}

constexpr bool kEnablePipelinedTailK=true;

struct PipelinedTailTile {
 int64_t expert,row,col;
 int rows,cols;
};

template<class Ends>
__aicore__ inline PipelinedTailTile FindPipelinedTailTile(Ends& ends,int64_t E,int64_t N,int64_t index){
 const int64_t nt=(N+TN-1)/TN;
 int64_t begin=0;
 for(int64_t e=0;e<E;++e){
  const int64_t end=ends.GetValue(e),rows=end-begin;
  const int64_t tasks=((rows+TM-1)/TM)*nt;
  if(index<tasks){
   const int64_t row=begin+(index/nt)*TM,col=(index%nt)*TN;
   return {e,row,col,(int)(end-row<TM?end-row:TM),(int)(N-col<TN?N-col:TN)};
  }
  index-=tasks;
  begin=end;
 }
 return {0,0,0,0,0};
}

namespace PanelSdk {
constexpr int TNC=2048;
constexpr int CSlots=4;

#ifndef __DAV_CUBE__
class StrictWideConsumer {
 using DmaQueue=AscendC::TQue<AscendC::TPosition::VECIN,2>;
 DmaQueue cq;
 AscendC::TQue<AscendC::TPosition::VECIN,1> sq;
 AscendC::TQue<AscendC::TPosition::VECOUT,1> oq;
 AscendC::TBuf<AscendC::TPosition::VECCALC> calc,indexBuf;
 AscendC::GlobalTensor<float> sg;
 PackedGeluThresholds table;
 AscendC::GlobalTensor<half> yg;
 AscendC::LocalTensor<float> pendingZ,pendingIndices,pendingPos;
 int stripBank=0,pendingCount=0,pendingRows=0,pendingCols=0,pendingPitch=0;
 int64_t pendingR0=0,pendingC0=0;
 bool pendingStrip=false;

 __aicore__ inline void ReadC(AscendC::GlobalTensor<int32_t> src,int rows,int cn,int pitch){
  auto ci=cq.AllocTensor<int32_t>();
  AivEpiloguePitch(cn).ReadC(ci,src,rows,pitch);
  cq.EnQue(ci);
 }

public:
 __aicore__ inline void Init(AscendC::TPipe& pipe,GM_ADDR scale,GM_ADDR y){
  using namespace AscendC;
  sg.SetGlobalBuffer((__gm__ float*)scale);
  yg.SetGlobalBuffer((__gm__ half*)y);
  table.Init();
  pipe.InitBuffer(cq,2,ES*4);pipe.InitBuffer(sq,1,TNC*4);
  pipe.InitBuffer(oq,1,ES*2);pipe.InitBuffer(calc,8*ES*4+3*MB+kMidpointWords*4);
  auto midpointBits=calc.Get<uint16_t>()[((8*ES*4+3*MB)/2)];
  Duplicate(midpointBits.ReinterpretCast<int32_t>(),(int32_t)kMidpointMask,kMidpointWords);
  pipe.InitBuffer(indexBuf,ES*sizeof(int16_t));
  CreateVecIndex(indexBuf.Get<int16_t>(),(int16_t)0,ES);
