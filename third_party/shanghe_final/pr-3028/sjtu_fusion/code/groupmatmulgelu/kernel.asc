 __aicore__ inline void Finish(int64_t N){
  if(pendingStrip)EmitPendingFullBank(oq,yg,table,pendingZ,pendingIndices,pendingPos,
    pendingCount,pendingRows,pendingCols,pendingPitch,pendingR0,pendingC0,N);
 }

 __aicore__ inline void Consume(AscendC::GlobalTensor<int32_t> slotCg,uint16_t readyFlag,uint16_t ackFlag,
  int64_t sub,int64_t expert,int64_t r0,int64_t c0,int rm,int cn,int pitchC,int64_t N){
  using namespace AscendC;
  CrossCoreWaitFlag<2>(readyFlag);
  const int firstRows=(rm+1)/2;
  const int myRows=sub?rm/2:firstRows;
  const int64_t myR0=r0+(sub?firstRows:0);
  if(myRows==0){CrossCoreSetFlag<2,PIPE_MTE2>(ackFlag);return;}
  auto c=slotCg[(myR0-r0)*pitchC];
  auto scale=sq.AllocTensor<float>();
  const int padded=(cn+7)/8*8;
  const int rounded=(cn+63)/64*64;
  DataCopyExtParams sp{1,(uint32_t)(cn*4),0,0,0};
  DataCopyPadExtParams<float> pad{cn!=padded,0,(uint8_t)(padded-cn),0.0f};
  DataCopyPad(scale,sg[expert*N+c0],sp,pad);
  sq.EnQue(scale);scale=sq.DeQue<float>();
  if(padded<rounded)Duplicate(scale[padded],0.0f,rounded-padded);
  auto storage=calc.Get<float>();
  auto midpointBits=calc.Get<uint16_t>()[((8*ES*4+3*MB)/2)];
  auto indexValues=indexBuf.Get<int16_t>();
  auto mask0=calc.Get<uint8_t>()[8*ES*4];
  ReadC(c,myRows<EM?myRows:EM,cn<TN?cn:TN,pitchC);
  for(int cb=0;cb<cn;cb+=TN){
   const int cw=cn-cb<TN?cn-cb:TN;
   const AivEpiloguePitch layout(cw);
   const int pitch=layout.pitch;
   auto sc=scale[cb];
   for(int m0=0;m0<myRows;m0+=EM){
    const int rows=myRows-m0<EM?myRows-m0:EM;
    auto ci=cq.DeQue<int32_t>();
    const int nr=m0+EM;
    const int nc=cb+TN;
    if(nr<myRows){
     ReadC(c[(int64_t)nr*pitchC+cb],myRows-nr<EM?myRows-nr:EM,cw,pitchC);
    }else if(nc<cn){
     ReadC(c[nc],myRows<EM?myRows:EM,cn-nc<TN?cn-nc:TN,pitchC);
    }else{
     CrossCoreSetFlag<2,PIPE_MTE2>(ackFlag);
    }
    auto z=storage[stripBank*2*ES],pos=z[ES];
    auto u=storage[4*ES],den=storage[5*ES],neg=storage[6*ES];
    auto compactIndices=storage[7*ES+stripBank*(ES/2)];
    layout.ClearCTail(ci,rows);
    const int count=rows*pitch;
    Cast(z,ci,RoundMode::CAST_RINT,count);
    for(int col=0;col<pitch;col+=64)Mul(z[col],z[col],sc[col],(uint64_t)64,(uint8_t)rows,
      BinaryRepeatParams{1,1,1,(uint8_t)(pitch/8),(uint8_t)(pitch/8),0});
    Mul(u,z,z,count);Muls(u,u,0.044715f,count);Adds(u,u,1.0f,count);
    Mul(u,u,z,count);Muls(u,u,-1.5957691216057308f,count);
    Exp(den,u,count);Adds(u,den,1.0f,count);
    Div(pos,z,u,count);
    Abs(u,pos,count);Adds(u,u,0x1p-14f,count);
    Adds(neg.ReinterpretCast<int32_t>(),u.ReinterpretCast<int32_t>(),(int32_t)32,count);
    auto neg16=neg.ReinterpretCast<uint16_t>();
    And(neg16,neg16,midpointBits,(uint64_t)128,(uint8_t)(count/64),BinaryRepeatParams{1,1,1,8,8,0});
    CompareScalar(mask0,neg.ReinterpretCast<int32_t>(),(int32_t)kMidpointMatch,CMPMODE::EQ,count);
    Finish(N);
    uint64_t compactCount=0;
    GatherMask(compactIndices.ReinterpretCast<int16_t>(),indexValues,mask0.ReinterpretCast<uint16_t>(),
      true,count,{1,1,8,0},compactCount);
    SetFlag<HardEvent::V_S>(EVENT_ID1);WaitFlag<HardEvent::V_S>(EVENT_ID1);
    pendingZ=z;pendingIndices=compactIndices;pendingPos=pos;pendingCount=(int)compactCount;
    pendingRows=rows;pendingCols=cw;pendingPitch=pitch;pendingR0=myR0+m0;pendingC0=c0+cb;
    pendingStrip=true;stripBank^=1;
    cq.FreeTensor(ci);
   }
  }
  sq.FreeTensor(scale);
 }
};
#endif
__aicore__ inline void RunWide(
 GM_ADDR x,GM_ADDR weight,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,
 GM_ADDR scratch,AscendC::tiling::TCubeTiling tl,int64_t M,int64_t N,int64_t K,int64_t E,
 int64_t tnc){
 using namespace AscendC;TPipe pipe;
 const int64_t cores=GetBlockNum();
#ifdef __DAV_CUBE__
 const int64_t core=GetBlockIdx(),sub=0;
#else
 const int64_t core=GetBlockIdx()/2,sub=GetSubBlockIdx();
#endif
 GlobalTensor<int64_t> ends;ends.SetGlobalBuffer((__gm__ int64_t*)groups);
 GlobalTensor<int32_t> cg;cg.SetGlobalBuffer((__gm__ int32_t*)scratch+core*CSlots*TM*tnc);
#ifdef __DAV_CUBE__
 matmul::MatmulImpl<matmul::MatmulType<TPosition::GM,CubeFormat::ND,int8_t>,
 matmul::MatmulType<TPosition::GM,CubeFormat::ND,int8_t>,
 matmul::MatmulType<TPosition::GM,CubeFormat::ND,int32_t>,
 matmul::MatmulType<TPosition::GM,CubeFormat::ND,int32_t>,CFG_NORM> mm;
 GlobalTensor<int8_t> a,b;a.SetGlobalBuffer((__gm__ int8_t*)x);b.SetGlobalBuffer((__gm__ int8_t*)weight);
 mm.Init(&tl,&pipe);
#else
 StrictWideConsumer consume;
 consume.Init(pipe,scale,y);
 TBuf<TPosition::VECCALC> glBuf;
 pipe.InitBuffer(glBuf,128*8);auto glv=glBuf.Get<int64_t>();
 {DataCopyExtParams gp{1,(uint32_t)(E*8),0,0,0};DataCopyPadExtParams<int64_t> lp{false,0,0,0};
  DataCopyPad(glv,ends,gp,lp);SetFlag<HardEvent::MTE2_S>(EVENT_ID2);WaitFlag<HardEvent::MTE2_S>(EVENT_ID2);}
#endif
 int64_t begin=0,prefix=0,produced=0;const int64_t nt=(N+tnc-1)/tnc;
#ifdef __DAV_CUBE__
#define GLENDS ends
#else
#define GLENDS glv
#endif
 // Last-round row split. units is the total tile count, so the final round holds
 // surplus = units-cores*(rounds-1) tiles and only `surplus` cores work in it. Each of
 // those tiles is cut into sr = cores/surplus row pieces (multiples of EM rows) and the
 // pieces are ordinary tiles: same slot/readyFlag/ack protocol, no barrier. Gated on K,
 // because the extra group_list pass costs ~44 ns per expert on the AIC.
 int64_t cut=((int64_t)1)<<62;int64_t surplus=0;int64_t sr=1;
 if(K>=1024){
  int64_t units=0;{int64_t b0=0;for(int64_t e=0;e<E;++e){const int64_t en=GLENDS.GetValue(e);
   const int64_t ro=en-b0;units+=(ro>0?((ro+TM-1)/TM):0)*nt;b0=en;}}
  const int64_t rounds=units>0?((units+cores-1)/cores):0;
  const int64_t cut0=cores*(rounds>0?rounds-1:0);
  surplus=units-cut0;
  sr=(surplus>0&&surplus<cores)?(cores/surplus):1;
  {const int64_t smax=TM/EM;if(sr>smax)sr=smax;if(sr<2)sr=1;}
  if(sr>1)cut=cut0;
 }
 for(int64_t e=0;e<E;++e){
#ifdef __DAV_CUBE__
  const int64_t end=ends.GetValue(e);
#else
  const int64_t end=glv.GetValue(e);
#endif
  const int64_t rows=end-begin,tasks=((rows+TM-1)/TM)*nt;
  const int64_t first=(core-prefix%cores+cores)%cores;
  const int64_t lim=(cut-prefix<tasks)?(cut-prefix<0?0:cut-prefix):tasks;
  for(int64_t task=first;task<lim;task+=cores){
   // Every participant advances even when an AIV has zero live rows.
   const int64_t ordinal=produced++;const int slot=(int)(ordinal&(CSlots-1));
   const uint16_t readyFlag=8+2*slot,ackFlag=readyFlag+1;
   auto slotCg=cg[slot*TM*tnc];
   int64_t r0=begin+(task/nt)*TM,c0=(task%nt)*tnc;
   int rm=(end-r0<TM)?end-r0:TM,cn=(N-c0<tnc)?N-c0:(int)tnc;
#ifdef __DAV_CUBE__
   if(ordinal>=CSlots)CrossCoreWaitFlag<2>(ackFlag);
   mm.SetOrgShape(M,N,K,K,(int)tnc);mm.SetTensorA(a[r0*K]);mm.SetTensorB(b[e*K*N+c0]);
   mm.SetTail(rm,cn,K);mm.IterateAll(slotCg,false);mm.End();
   CrossCoreSetFlag<2,PIPE_FIX>(readyFlag);
#else
   consume.Consume(slotCg,readyFlag,ackFlag,sub,e,r0,c0,rm,cn,tnc,N);
#endif
  }
  begin=end;prefix+=tasks;
 }
#ifdef __DAV_CUBE__
 // Tail round, piece by piece, in the same pipeline: the matmul issue rate and the slot
 // rotation continue from the loop above, so nothing drains and nothing waits globally.
 const int64_t ntail=(sr>1)?(surplus*sr):0;
 for(int64_t c=(int64_t)core;c<ntail;c+=(int64_t)cores){
  const int64_t j=c/sr;const int qp=(int)(c%sr);
  int64_t pE=0,pR0=0,pC0=0;int pRm=0,pCn=0;
  {int64_t b0=0,pf=0;
   for(int64_t e=0;e<E;++e){const int64_t en=GLENDS.GetValue(e);const int64_t ro=en-b0;
    const int64_t tas=(ro>0?((ro+TM-1)/TM):0)*nt;
    if(cut+j<pf+tas){const int64_t tk=cut+j-pf;pE=e;pR0=b0+(tk/nt)*TM;pC0=(tk%nt)*tnc;
     pRm=(int)((en-pR0<TM)?(en-pR0):TM);pCn=(int)((N-pC0<tnc)?(N-pC0):tnc);break;}
    pf+=tas;b0=en;}}
  int rStep=(int)((((pRm+sr-1)/sr)+EM-1)/EM)*EM;if(rStep<EM)rStep=EM;
  const int64_t pOff=(int64_t)qp*rStep;
  if(pOff<pRm){
   const int64_t PE=pE,PR0=pR0+pOff,PC0=pC0;
   const int left=pRm-(int)pOff;
   const int PRM=(qp==sr-1)?left:((left<rStep)?left:rStep),PCN=pCn;
   // Every participant advances even when an AIV has zero live rows.
   const int64_t ordinal=produced++;const int slot=(int)(ordinal&(CSlots-1));
   const uint16_t readyFlag=8+2*slot,ackFlag=readyFlag+1;
   auto slotCg=cg[slot*TM*tnc];
   int64_t r0=PR0,c0=PC0;
   int rm=PRM,cn=PCN;
#ifdef __DAV_CUBE__
   if(ordinal>=CSlots)CrossCoreWaitFlag<2>(ackFlag);
   mm.SetOrgShape(M,N,K,K,(int)tnc);mm.SetTensorA(a[r0*K]);mm.SetTensorB(b[PE*K*N+c0]);
   mm.SetTail(rm,cn,K);mm.IterateAll(slotCg,false);mm.End();
   CrossCoreSetFlag<2,PIPE_FIX>(readyFlag);
#else
   consume.Consume(slotCg,readyFlag,ackFlag,sub,PE,r0,c0,rm,cn,tnc,N);
#endif
  }
 }
 // Drain each outstanding slot exactly once. No events survive this invocation.
 for(int64_t q=produced>CSlots?produced-CSlots:0;q<produced;++q)CrossCoreWaitFlag<2>((uint16_t)(9+2*(q&(CSlots-1))));
#else
  // Same chunk list as the AIC of this core; the two vector subblocks split the rows.
 const int64_t ntail=(sr>1)?(surplus*sr):0;
 for(int64_t c=(int64_t)core;c<ntail;c+=(int64_t)cores){
  const int64_t j=c/sr;const int qp=(int)(c%sr);
  int64_t pE=0,pR0=0,pC0=0;int pRm=0,pCn=0;
  {int64_t b0=0,pf=0;
   for(int64_t e=0;e<E;++e){const int64_t en=GLENDS.GetValue(e);const int64_t ro=en-b0;
    const int64_t tas=(ro>0?((ro+TM-1)/TM):0)*nt;
    if(cut+j<pf+tas){const int64_t tk=cut+j-pf;pE=e;pR0=b0+(tk/nt)*TM;pC0=(tk%nt)*tnc;
     pRm=(int)((en-pR0<TM)?(en-pR0):TM);pCn=(int)((N-pC0<tnc)?(N-pC0):tnc);break;}
    pf+=tas;b0=en;}}
  int rStep=(int)((((pRm+sr-1)/sr)+EM-1)/EM)*EM;if(rStep<EM)rStep=EM;
  const int64_t pOff=(int64_t)qp*rStep;
  if(pOff<pRm){
   const int64_t PE=pE,PR0=pR0+pOff,PC0=pC0;
   const int left=pRm-(int)pOff;
   const int PRM=(qp==sr-1)?left:((left<rStep)?left:rStep),PCN=pCn;
   // Every participant advances even when an AIV has zero live rows.
   const int64_t ordinal=produced++;const int slot=(int)(ordinal&(CSlots-1));
   const uint16_t readyFlag=8+2*slot,ackFlag=readyFlag+1;
   auto slotCg=cg[slot*TM*tnc];
   int64_t r0=PR0,c0=PC0;
   int rm=PRM,cn=PCN;
#ifdef __DAV_CUBE__
   if(ordinal>=CSlots)CrossCoreWaitFlag<2>(ackFlag);
   mm.SetOrgShape(M,N,K,K,(int)tnc);mm.SetTensorA(a[r0*K]);mm.SetTensorB(b[PE*K*N+c0]);
   mm.SetTail(rm,cn,K);mm.IterateAll(slotCg,false);mm.End();
   CrossCoreSetFlag<2,PIPE_FIX>(readyFlag);
#else
   consume.Consume(slotCg,readyFlag,ackFlag,sub,PE,r0,c0,rm,cn,tnc,N);
#endif
  }
 }
 consume.Finish(N);
#endif
}

#undef GLENDS
}

template<bool Direct,bool Panel=false,bool PipelinedTail=false>
__global__ __mix__(1,2) void grouped_matmul_gelu_custom(
 GM_ADDR x,GM_ADDR weight,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,
 GM_ADDR scratch,AscendC::tiling::TCubeTiling tl,int64_t M,int64_t N,int64_t K,int64_t E){
 // The same Panel ABI carries the SDK column pitch in this call's tiling.
 if constexpr(!Direct&&Panel&&!PipelinedTail){
  if(K>4*512&&tl.singleCoreN==3*TN){
   PanelSdk::RunWide(x,weight,scale,groups,y,scratch,tl,M,N,K,E,tl.singleCoreN);
   return;
  }
 }
 using namespace AscendC;TPipe pipe;
 const int64_t cores=GetBlockNum();
#ifdef __DAV_CUBE__
 const int64_t core=GetBlockIdx(),sub=0;
#else
 const int64_t core=GetBlockIdx()/2,sub=GetSubBlockIdx();
#endif
 GlobalTensor<int64_t> ends;ends.SetGlobalBuffer((__gm__ int64_t*)groups);
 GlobalTensor<int32_t> cg;cg.SetGlobalBuffer((__gm__ int32_t*)scratch+core*4*TM*TN);
#ifdef __DAV_CUBE__
 matmul::MatmulImpl<matmul::MatmulType<TPosition::GM,CubeFormat::ND,int8_t>,
 matmul::MatmulType<TPosition::GM,CubeFormat::ND,int8_t>,
 matmul::MatmulType<TPosition::GM,CubeFormat::ND,int32_t>,
 matmul::MatmulType<TPosition::GM,CubeFormat::ND,int32_t>,CFG_NORM> mm;
 GlobalTensor<int8_t> a,b;a.SetGlobalBuffer((__gm__ int8_t*)x);b.SetGlobalBuffer((__gm__ int8_t*)weight);
 CrossTileCube direct;LongKPanelCube panel;bool cubeQueued=false;
 bool phaseFirstWave=false;
 // Direct and the SDK fallback publish the same C slots to their shared AIV.
 const bool useDirect=Direct||(!Panel&&K<=512&&K%32==0&&N<=65535);
 if constexpr(Panel)panel.Init(pipe);
 else if(useDirect)direct.Init(pipe);
 else mm.Init(&tl,&pipe);
 // L1 staging for the SDK's own next load on its short, non-direct path.
 TBuf<TPosition::A1> pfbuf;
 LocalTensor<int8_t> pfb;
 if(!useDirect&&!Panel){
  pipe.InitBuffer(pfbuf,98304);
  pfb=pfbuf.Get<int8_t>();
 }
 const bool warm=(!useDirect&&!Panel&&K<=512);
#else
 PackedGeluThresholds table;table.Init();
 TQue<TPosition::VECIN,2> cq,sq;TQue<TPosition::VECOUT,1> oq;TBuf<TPosition::VECCALC> calc,glBuf,indexBuf;
 pipe.InitBuffer(cq,2,ES*4);pipe.InitBuffer(sq,2,TN*4);bool prefetched=false;
 pipe.InitBuffer(oq,1,ES*2);pipe.InitBuffer(calc,8*ES*4+3*MB+kMidpointWords*4);
 auto midpointBits=calc.Get<uint16_t>()[((8*ES*4+3*MB)/2)];
 Duplicate(midpointBits.ReinterpretCast<int32_t>(),(int32_t)kMidpointMask,kMidpointWords);
 pipe.InitBuffer(indexBuf,ES*sizeof(int16_t));auto indexValues=indexBuf.Get<int16_t>();
 CreateVecIndex(indexValues,(int16_t)0,ES);
 // Two full z/u/pos banks preserve every candidate; no bounded candidate queue.
 // The held input queue remains arithmetic scratch after dequantization Cast.
 auto bankStorage=calc.Get<float>();int stripBank=0;bool pendingStrip=false;
 LocalTensor<float> pendingZ,pendingIndices,pendingPos;
 int pendingCount=0,pendingRows=0,pendingCols=0,pendingPitch=0;
 int64_t pendingR0=0,pendingC0=0;
 GlobalTensor<float> sg;sg.SetGlobalBuffer((__gm__ float*)scale);
 GlobalTensor<half> yg;yg.SetGlobalBuffer((__gm__ half*)y);
 // group_list lives in UB: the per-expert loop below runs on every core, so
 // reading it from GM costs E scalar loads per core (E can be 128).
 pipe.InitBuffer(glBuf,128*8);auto glv=glBuf.Get<int64_t>();
 {DataCopyExtParams gp{1,(uint32_t)(E*8),0,0,0};DataCopyPadExtParams<int64_t> lp{false,0,0,0};
  DataCopyPad(glv,ends,gp,lp);SetFlag<HardEvent::MTE2_S>(EVENT_ID2);WaitFlag<HardEvent::MTE2_S>(EVENT_ID2);}
#endif
 int64_t begin=0,prefix=0,produced=0;const int64_t nt=(N+TN-1)/TN;
#ifdef __DAV_CUBE__
#define GLENDS ends
#else
#define GLENDS glv
#endif
 // Last-round row split. units is the total tile count, so the final round holds
 // surplus = units-cores*(rounds-1) tiles and only `surplus` cores work in it. Each of
 // those tiles is cut into sr = cores/surplus row pieces (multiples of EM rows) and the
 // pieces are ordinary tiles: same slot/readyFlag/ack protocol, no barrier. Gated on K,
 // because the extra group_list pass costs ~44 ns per expert on the AIC.
 int64_t cut=((int64_t)1)<<62;int64_t surplus=0;int64_t sr=1;int tailKParts=0;
#ifdef __DAV_CUBE__
 if((Panel&&PipelinedTail)||K>=1024){
  bool oneBandPerExpert=true;
#else
 if(K>=1024){
#endif
  int64_t units=0;{int64_t b0=0;for(int64_t e=0;e<E;++e){const int64_t en=GLENDS.GetValue(e);
   const int64_t ro=en-b0;units+=(ro>0?((ro+TM-1)/TM):0)*nt;b0=en;
#ifdef __DAV_CUBE__
   if constexpr(Panel&&PipelinedTail)oneBandPerExpert&=ro<=TM;
#endif
  }}
#ifdef __DAV_CUBE__
  if constexpr(Panel&&PipelinedTail)
   phaseFirstWave=oneBandPerExpert&&units>cores/2&&units<cores&&nt>1&&K%512==0;
