   // the buffer we are about to read was last written two iterations ago; that wait must NOT
   // sit next to its own SetFlag, or the two DMAs would never overlap.
   if(curA){if(pend1>0){WaitFlag<HardEvent::MTE3_MTE2>(EVENT_ID1);--pend1;}}
   else{if(pend0>0){WaitFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);--pend0;}}
   const int64_t nn=(rows-rn<per)?(rows-rn):per;
   auto uN=curA?uB:uA;
   DataCopyExtParams rp{(uint16_t)nn,(uint32_t)Nr,0,(uint32_t)ubGap,0};
   DataCopyPad(uN,s_[rn*Nr],rp,pp);
   SetFlag<HardEvent::MTE2_MTE3>(curA?EVENT_ID1:EVENT_ID0);
