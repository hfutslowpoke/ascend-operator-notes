   // Split the live rows evenly between the two vector cores. The old "sub*VM" split gave
   // the second AIV zero rows whenever rm < TM, so raising TM used to be a net loss.
   int myRm=(sub==0)?((rm+1)/2):(rm/2);const int64_t myR0=r0+(sub?((rm+1)/2):0);
   if(myRm<=0){CrossCoreSetFlag<2,PIPE_MTE2>(ackFlag);continue;}
   auto slotCgA=cg[slot*TM*TN+(int64_t)(myR0-r0)*TN];
   const AivEpiloguePitch layout(cn);
   {auto scales=sq.AllocTensor<float>();layout.ReadScale(scales,sg[PE*N+c0]);sq.EnQue(scales);}
   auto sc=sq.DeQue<float>();
   layout.ClearScaleTail(sc);
   bool ciQueued=false;
   for(int m0=0;m0<myRm;m0+=EM){
    const int rm=(myRm-m0<EM)?(myRm-m0):EM;const int64_t r0=myR0+m0;const int pitch=layout.pitch;
    if(!ciQueued){
     auto first=cq.AllocTensor<int32_t>();
     layout.ReadC(first,slotCgA[(int64_t)m0*TN],rm,TN);cq.EnQue(first);
    }
    auto ci=cq.DeQue<int32_t>();ciQueued=false;
    // Compact padding writes only unused input lanes after DeQue.
    // Current strip owns one queue buffer; the other receives the next strip
    // while current FP32 math and scalar repair run. The existing final-strip
    // DeQue precedes ACK, so Cube cannot reuse the GM slot before all reads finish.
    if(m0+EM<myRm){
     const int nm=m0+EM,nr=(myRm-nm<EM)?(myRm-nm):EM;
     auto future=cq.AllocTensor<int32_t>();
     layout.ReadC(future,slotCgA[(int64_t)nm*TN],nr,TN);cq.EnQue(future);ciQueued=true;
    }
    if(m0+EM>=myRm)CrossCoreSetFlag<2,PIPE_MTE2>(ackFlag);
    // Two retained z/pos banks, common arithmetic scratch, two index banks.
    // No arithmetic scratch aliases the int32 input or either pending bank.
    auto z=bankStorage[stripBank*2*ES],pos=z[ES];
    auto u=bankStorage[4*ES],den=bankStorage[5*ES],neg=bankStorage[6*ES];
    auto compactIndices=bankStorage[7*ES+stripBank*(ES/2)];
    layout.ClearCTail(ci,rm);
    const int count=rm*pitch;
    Cast(z,ci,RoundMode::CAST_RINT,count);
    for(int col=0;col<pitch;col+=64)Mul(z[col],z[col],sc[col],(uint64_t)64,(uint8_t)rm,BinaryRepeatParams{1,1,1,(uint8_t)(pitch/8),(uint8_t)(pitch/8),0});
    // Lean FP32 main path, with explicit midpoint repair below.
    Mul(u,z,z,count);Muls(u,u,0.044715f,count);Adds(u,u,1.0f,count);
    Mul(u,u,z,count);Muls(u,u,-1.5957691216057308f,count);
    Exp(den,u,count);Adds(u,den,1.0f,count);
    Div(pos,z,u,count);
    // The coarse mask includes every lane admitted by the existing fine predicate.
    // Adds/CompareScalar int32 EQ are supported by the dav_c220 public API.
    // No case table, cross-call state or omitted mathematical stage.
    auto mask0=calc.Get<uint8_t>()[8*ES*4];
    Abs(u,pos,count);
    Adds(u,u,0x1p-14f,count);
    Adds(neg.ReinterpretCast<int32_t>(),u.ReinterpretCast<int32_t>(),(int32_t)32,count);
    // The same power-of-two bias shifts normal mantissas by 256 or 128. Ignoring those two bits includes both shifts. The original scalar fine predicate filters additional matches.
    auto neg16=neg.ReinterpretCast<uint16_t>();
    And(neg16,neg16,midpointBits,(uint64_t)128,(uint8_t)(count/64),BinaryRepeatParams{1,1,1,8,8,0});
    CompareScalar(mask0,neg.ReinterpretCast<int32_t>(),(int32_t)kMidpointMatch,CMPMODE::EQ,count);
    // exact_repair_needed still checks the original z range before any patch.
    // Explicitly initialized tail lanes produce zero and fail the unchanged coarse predicate.
    // One compact index stream replaces the two-stream deferred patch path.
    // Unlike v3, no scalar scan over all mask words in full-column tiles.
    // Current vector math/screen has been issued. Only now repair/write the
    // previous bank; its z/pos/index tensors are distinct from current storage.
    // Emit before GatherMask: reading its reserved count may interlock Scalar.
    if(pendingStrip)EmitPendingFullBank(oq,yg,table,pendingZ,pendingIndices,pendingPos,
      pendingCount,pendingRows,pendingCols,pendingPitch,pendingR0,pendingC0,N);
    uint64_t compactCount=0;
    GatherMask(compactIndices.ReinterpretCast<int16_t>(),indexValues,mask0.ReinterpretCast<uint16_t>(),true,count,{1,1,8,0},compactCount);
    SetFlag<HardEvent::V_S>(EVENT_ID1);WaitFlag<HardEvent::V_S>(EVENT_ID1);
    pendingZ=z;pendingIndices=compactIndices;pendingPos=pos;pendingCount=(int)compactCount;
    pendingRows=rm;pendingCols=cn;pendingPitch=pitch;pendingR0=r0;pendingC0=c0;
    pendingStrip=true;stripBank^=1;
    // All current vector reads are complete; pending z/pos/indices are retained separately.
    cq.FreeTensor(ci);
   }
   sq.FreeTensor(sc);
#endif
  }
 }
#endif
#ifndef __DAV_CUBE__
 if(pendingStrip)EmitPendingFullBank(oq,yg,table,pendingZ,pendingIndices,pendingPos,
   pendingCount,pendingRows,pendingCols,pendingPitch,pendingR0,pendingC0,N);
#endif
}

// Compose the audited flexible Cubegeometry with v48's explicitbank AIVpipeline.
namespace FlexiblePipelineAspect {

// Diagnostic candidate toggle. Both arms use the same eligible task scanner.
constexpr bool kColumnMajorExpertOrder = true;

#ifdef __DAV_CUBE__
constexpr int kPanelPhaseMode=2;
template<bool Flexible=false>
class LongKPanelCube {
 AscendC::TQue<AscendC::TPosition::A1,2> aq;
 AscendC::TQue<AscendC::TPosition::B1,2> bq;
 AscendC::TQue<AscendC::TPosition::A2,2> a2;
 AscendC::TQue<AscendC::TPosition::B2,2> b2;
 AscendC::TQue<AscendC::TPosition::CO1,1> cq;
public:
 __aicore__ inline void Init(AscendC::TPipe& pipe){
  pipe.InitBuffer(aq,2,128*512);pipe.InitBuffer(bq,2,512*256);
  pipe.InitBuffer(a2,2,128*128);pipe.InitBuffer(b2,2,128*256);pipe.InitBuffer(cq,1,128*256*4);
 }
 __aicore__ inline void Stage(AscendC::GlobalTensor<int8_t>& a,AscendC::GlobalTensor<int8_t>& b,
  int64_t e,int64_t r0,int64_t c0,int rm,int cn,int64_t K,int64_t bStride,
  int k0,int kp,bool nativeB1){
  using namespace AscendC;const int mp=(rm+15)/16*16;
  auto la=aq.AllocTensor<int8_t>(),lb=bq.AllocTensor<int8_t>();
  Nd2NzParams ap{1,(uint16_t)rm,(uint16_t)kp,0,(uint16_t)K,(uint16_t)mp,1,0};
  DataCopy(la,a[r0*K+k0],ap);
  if(nativeB1){
   // The physical representation is the canonical 512-K B1 layout even
   // when a wide Flexible tile issues a 256-K computational panel.
   const int storedK0=(k0/512)*512;
   const int storedK=(int)(K-storedK0<512?K-storedK0:512);
   const int within=k0-storedK0;
   const int blocks=(cn+31)/32;
   const int64_t offset=(e*K+storedK0)*bStride+(c0/32)*storedK*32+(int64_t)within*32;
   if(within==0&&kp==storedK){
    DataCopy(lb,b[offset],(uint32_t)(blocks*kp*32));
   }else{
    // DataCopyParams lengths and gaps are in 32-byte blocks for GM -> B1.
    // Collapse each column block's selected K rows into the original L1 pitch.
    const DataCopyParams copy{(uint16_t)blocks,(uint16_t)kp,(uint16_t)(storedK-kp),0};
    DataCopy(lb,b[offset],copy);
   }
  }else{
   Nd2NzParams bp{1,(uint16_t)kp,(uint16_t)cn,0,(uint16_t)bStride,(uint16_t)kp,1,0};
   DataCopy(lb,b[e*K*bStride+(int64_t)k0*bStride+c0],bp);
  }
  aq.EnQue(la);bq.EnQue(lb);
 }
 __aicore__ __attribute__((noinline)) void Compute(AscendC::GlobalTensor<int8_t>& a,AscendC::GlobalTensor<int8_t>& b,
  AscendC::GlobalTensor<int32_t> dst,int64_t e,int64_t r0,int64_t c0,int rm,int cn,int64_t K,
  int64_t bStride,int dstPitch,bool nativeB1){
  using namespace AscendC;const int mp=(rm+15)/16*16,bn=(cn+31)/32*32;
  // Both aspects retain the same32768-element accumulator and original L1/L0 capacities.
  // Wider short-row tiles reduce K blocking only when their actual columns require it.
  const int panelK=(Flexible&&cn>256)?256:512;
  const int microK=(Flexible&&cn>256)?64:128;
  const int fullPanels=(int)(K/panelK),tail=(int)(K%panelK);
  const int panelCount=fullPanels+(tail!=0);
  int panel=0;
  // Rotate full K panels on the native 256-column C pitch.
  if(dstPitch==256&&fullPanels>=3){
   if constexpr(kPanelPhaseMode==1)panel=1;
   else panel=(int)GetBlockIdx()%fullPanels;
  }
  auto acc=cq.AllocTensor<int32_t>();
  Stage(a,b,e,r0,c0,rm,cn,K,bStride,panel*panelK,fullPanels?panelK:tail,nativeB1);
  for(int ordinal=0;ordinal<panelCount;++ordinal){
   const int kp=panel<fullPanels?panelK:tail;
   auto la=aq.DeQue<int8_t>(),lb=bq.DeQue<int8_t>();
   if(ordinal+1<panelCount){
    if(ordinal+1==fullPanels)panel=fullPanels;
    else if(++panel==fullPanels)panel=0;
    const int nextK=panel<fullPanels?panelK:tail;
    Stage(a,b,e,r0,c0,rm,cn,K,bStride,panel*panelK,nextK,nativeB1);
   }
   for(int kk=0;kk<kp;kk+=microK){
    const int kc=kp-kk<microK?kp-kk:microK;
    // One128-row accumulator reuses each B L0 panel across all active rows.
    auto aa=a2.AllocTensor<int8_t>(),bb=b2.AllocTensor<int8_t>();
    LoadData2dParams pa{};pa.repeatTimes=kc/32;pa.srcStride=mp/16;
    for(int mr=0;mr<mp/16;++mr)LoadData(aa[mr*kc*16],la[mr*16*32+kk*mp],pa);
    LoadData2dTransposeParams pb{};pb.repeatTimes=bn/32;pb.srcStride=kp/32;pb.dstGap=1;
    for(int kr=0;kr<kc/32;++kr)LoadDataWithTranspose(bb[kr*((cn+15)/16)*16*32],lb[(kk+kr*32)*32],pb);
    a2.EnQue(aa);b2.EnQue(bb);aa=a2.DeQue<int8_t>();bb=b2.DeQue<int8_t>();
    MmadParams mm{};mm.m=mp;mm.n=cn;mm.k=kc;mm.cmatrixInitVal=(ordinal==0&&kk==0);Mmad(acc,aa,bb,mm);
    if((mp/16)*(cn/16)<10)PipeBarrier<PIPE_M>();
    a2.FreeTensor(aa);b2.FreeTensor(bb);
   }
   aq.FreeTensor(la);bq.FreeTensor(lb);
  }
  // Complete the full K reduction before a single final output Fixpipe.
  cq.EnQue(acc);acc=cq.DeQue<int32_t>();
  FixpipeParamsV220 fp{};fp.mSize=rm;fp.nSize=cn;fp.srcStride=mp;fp.dstStride=dstPitch;
  Fixpipe<int32_t,int32_t,CFG_ROW_MAJOR>(dst,acc,fp);cq.FreeTensor(acc);
 }
};
#endif
struct ExpertPackMask {
 uint64_t low=0,high=0;

 __aicore__ inline void Set(int expert){
  const uint64_t bit=uint64_t(1)<<(expert&63);
  if(expert<64)low|=bit;else high|=bit;
 }
 __aicore__ inline bool Has(int expert) const {
  return ((expert<64?low:high)>>(expert&63))&1;
 }
 __aicore__ inline bool Any() const {return low!=0||high!=0;}
};

template<class Ends>
__aicore__ inline ExpertPackMask BuildExpertPackMask(Ends& groups,int E,int64_t n,int64_t stride){
 ExpertPackMask mask;
 int64_t begin=0,rowBands=0,count=0;
 for(int expert=0;expert<E;++expert){
  const int64_t end=groups.GetValue(expert),rows=end-begin;
  begin=end;
  if(rows<=TM)continue;
  mask.Set(expert);
  rowBands+=rows/TM+(rows%TM!=0);
  ++count;
 }
 // Require enough repeated W reads across the selected row bands to
 // amortize a full raw read and padded write of the selected expert slots.
 // Division gives the exact ceiling and avoids multiplying unbounded M.
 const int64_t required=(3*count*(n+stride)+2*n-1)/(2*n);
 if(rowBands<required)return {};
 return mask;
}

#ifndef __DAV_CUBE__
__aicore__ inline void PackNativeB1(AscendC::LocalTensor<int8_t> ub,GM_ADDR weight,GM_ADDR packed,
                                   int experts,int k,int n,int stride,const ExpertPackMask& selected){
 using namespace AscendC;
 constexpr int packBytes=64*1024;
 static_assert(8*ES*4>=2*packBytes);
 const int batch=stride<=512?128:(stride<=1024?64:32);
 const int fullBatches=512/batch;
 const int expertBatches=(k/512)*fullBatches+(k%512+batch-1)/batch;
 const int step=2*(int)GetBlockNum();
 int first=(int)GetBlockIdx();
 const int ubRow=(n+31)&~31;

 GlobalTensor<int8_t> src,dst;
 src.SetGlobalBuffer((__gm__ int8_t*)weight);
 dst.SetGlobalBuffer((__gm__ int8_t*)packed);
 // MTE2 writes logical columns and their first right padding. The remaining
 // aligned pitch gap stays zero across batches and is scattered as part of B1.
 Duplicate(ub.ReinterpretCast<int16_t>(),(int16_t)0,packBytes/2);
 SetFlag<HardEvent::V_MTE2>(EVENT_ID0);WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
 const DataCopyPadExtParams<int8_t> pad{true,0,(uint8_t)(ubRow-n),0};
 DataCopyExtParams read{0,(uint32_t)n,0,(uint32_t)((stride-ubRow)/32),0};
 // Compact selected expert batches onto a single modulo step sequence.
 for(int expert=0;expert<experts;++expert){
  if(!selected.Has(expert))continue;
  int local=first;
  for(;local<expertBatches;local+=step){
   const int k0=(local/fullBatches)*512,within=(local%fullBatches)*batch;
   const int kp=k-k0<512?k-k0:512;
   const int count=kp-within<batch?kp-within:batch;
   const int64_t panelRow=(int64_t)expert*k+k0;
   read.blockCount=(uint16_t)count;
   DataCopyPad(ub,src[(panelRow+within)*n],read,pad);
   SetFlag<HardEvent::MTE2_V>(EVENT_ID0);WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
   auto repacked=ub[packBytes];
   auto from=ub.ReinterpretCast<int16_t>(),to=repacked.ReinterpretCast<int16_t>();
   // Ascend C CopyRepeatParams: destination/source block stride, then
   // destination/source repeat stride, all in 32-byte blocks.
   const CopyRepeatParams rows{1,1,1,(uint16_t)(stride/32)};
   for(int col=0;col<stride;col+=32)
    Copy(to[(col/2)*count],from[col/2],(uint64_t)16,(uint8_t)count,rows);
   SetFlag<HardEvent::V_MTE3>(EVENT_ID0);WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
   const int64_t panelOffset=panelRow*stride+(int64_t)within*32;
   const DataCopyExtParams output{(uint16_t)(stride/32),(uint32_t)(count*32),0,
                                  (uint32_t)((kp-count)*32),0};
   DataCopyPad(dst[panelOffset],repacked,output);
   // The following MTE2 read and its subsequent vector copy cannot reuse
   // either UB bank until the preceding store is complete.
   SetFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);WaitFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);
  }
  first=local-expertBatches;
 }
}
#endif

__global__ __mix__(1,2) __schedmode__(1) void grouped_matmul_gelu_custom(
 GM_ADDR x,GM_ADDR weight,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,
 GM_ADDR scratch,AscendC::tiling::TCubeTiling tl,int64_t M,int64_t N,int64_t K,int64_t E,
 int64_t bStride){
 using namespace AscendC;TPipe pipe;
 constexpr bool Flexible=true;
 constexpr int MaxScaleN=Flexible?512:TN;
 const int64_t cores=GetBlockNum();
 // The host reserves the packed suffix only when stride differs.
 const bool online=bStride>N;
 GM_ADDR packed=online?scratch+cores*4*TM*TN*sizeof(int32_t):nullptr;
#ifdef __DAV_CUBE__
 const int64_t core=GetBlockIdx(),sub=0;
#else
 const int64_t core=GetBlockIdx()/2,sub=GetSubBlockIdx();
#endif
 GlobalTensor<int64_t> ends;ends.SetGlobalBuffer((__gm__ int64_t*)groups);
 GlobalTensor<int32_t> cg;cg.SetGlobalBuffer((__gm__ int32_t*)scratch+core*4*TM*TN);
#ifdef __DAV_CUBE__
 GlobalTensor<int8_t> a,b,b1;
 a.SetGlobalBuffer((__gm__ int8_t*)x);
 b.SetGlobalBuffer((__gm__ int8_t*)weight);
 ExpertPackMask selected;
 if(online)selected=BuildExpertPackMask(ends,(int)E,N,bStride);
 const bool publish=selected.Any();
 b1.SetGlobalBuffer((__gm__ int8_t*)(publish?packed:weight));
 LongKPanelCube<Flexible> panel;panel.Init(pipe);
 if(publish){
  CrossCoreWaitFlag<2>(0);
  CrossCoreSetFlag<0,PIPE_FIX>(1);
  CrossCoreWaitFlag<0>(1);
  CrossCoreSetFlag<2,PIPE_FIX>(2);
 }
#else
 TQue<TPosition::VECIN,2> cq,sq;TQue<TPosition::VECOUT,1> oq;TBuf<TPosition::VECCALC> calc,glBuf,indexBuf;
 pipe.InitBuffer(cq,2,ES*4);pipe.InitBuffer(sq,2,MaxScaleN*4);bool prefetched=false;
 pipe.InitBuffer(oq,1,ES*2);pipe.InitBuffer(calc,8*ES*4+3*MB+kMidpointWords*4);
 pipe.InitBuffer(indexBuf,ES*sizeof(int16_t));
 // group_list lives in UB: the per-expert loop below runs on every core, so
 // reading it from GM costs E scalar loads per core (E can be 128).
 pipe.InitBuffer(glBuf,128*8);auto glv=glBuf.Get<int64_t>();
 {DataCopyExtParams gp{1,(uint32_t)(E*8),0,0,0};DataCopyPadExtParams<int64_t> lp{false,0,0,0};
  DataCopyPad(glv,ends,gp,lp);SetFlag<HardEvent::MTE2_S>(EVENT_ID2);WaitFlag<HardEvent::MTE2_S>(EVENT_ID2);}
 ExpertPackMask selected;
 if(online)selected=BuildExpertPackMask(glv,(int)E,N,bStride);
 const bool publish=selected.Any();
 if(publish){
  PackNativeB1(calc.Get<int8_t>(),weight,packed,(int)E,(int)K,(int)N,(int)bStride,selected);
  CrossCoreSetFlag<2,PIPE_MTE3>(0);
 }
 PackedGeluThresholds table;table.Init();
 auto midpointBits=calc.Get<uint16_t>()[((8*ES*4+3*MB)/2)];
 Duplicate(midpointBits.ReinterpretCast<int32_t>(),(int32_t)0x07001f40,kMidpointWords);
 auto indexValues=indexBuf.Get<int16_t>();
 CreateVecIndex(indexValues,(int16_t)0,ES);
 // Two full z/u/pos banks preserve every candidate; no bounded candidate queue.
 // The held input queue remains arithmetic scratch after dequantization Cast.
 auto bankStorage=calc.Get<float>();int stripBank=0;bool pendingStrip=false;
 LocalTensor<float> pendingZ,pendingIndices,pendingPos;
 int pendingCount=0,pendingRows=0,pendingCols=0,pendingPitch=0;
 int64_t pendingR0=0,pendingC0=0;
 GlobalTensor<float> sg;sg.SetGlobalBuffer((__gm__ float*)scale);
 GlobalTensor<half> yg;yg.SetGlobalBuffer((__gm__ half*)y);
 if(publish)CrossCoreWaitFlag<2>(2);
#endif
 int64_t begin=0,prefix=0,produced=0;const int64_t nt=(N+TN-1)/TN;
#ifdef __DAV_CUBE__
#define GLENDS ends
#else
#define GLENDS glv
#endif
 // Last-round row split. units is the total tile count, so the final round holds
 // surplus = units-cores*(rounds-1) tiles and only `surplus` cores work in it. Each of
 // those tiles is cut into sr = cores/surplus row pieces (multiples of EM rows) and the
 // pieces are ordinary tiles: same slot/readyFlag/ack protocol, no barrier. Gated on K,
 // because the extra group_list pass costs ~44 ns per expert on the AIC.
 int64_t cut=((int64_t)1)<<62;int64_t surplus=0;int64_t sr=1;
 bool orderEligible=false;
 int64_t fullOrderBands=0, partialOrderCols=0;
 if(K>=1024){
  int64_t units=0;
  int uniformCols=0;
  bool singleBand=true;
  {int64_t b0=0;for(int64_t e=0;e<E;++e){const int64_t en=GLENDS.GetValue(e);
   const int64_t ro=en-b0;const bool wide=Flexible&&ro<=64&&N>TN;
   const int tm=wide?64:TM,tn=wide?512:TN;const int64_t tilesN=(N+tn-1)/tn;
   if constexpr(Flexible){
    if(ro>0){
     if(uniformCols==0)uniformCols=tn;
     singleBand=singleBand&&ro<=tm&&uniformCols==tn;
    }
   }
   units+=(ro>0?((ro+tm-1)/tm):0)*tilesN;b0=en;}}
  const int64_t rounds=units>0?((units+cores-1)/cores):0;
  const int64_t cut0=cores*(rounds>0?rounds-1:0);
  surplus=units-cut0;
  sr=(surplus>0&&surplus<cores)?(cores/surplus):1;
  {const int64_t smax=TM/EM;if(sr>smax)sr=smax;if(sr<2)sr=1;}
  if(sr>1)cut=cut0;
  if constexpr(Flexible){
   if(singleBand&&uniformCols>TN&&N>uniformCols&&N<=2*uniformCols&&units>=cores){
    const int64_t columns=(N+uniformCols-1)/uniformCols;
    const int64_t nativePrefix=(sr>1)?cut0:units;
    fullOrderBands=nativePrefix/columns;
    partialOrderCols=nativePrefix%columns;
    orderEligible=fullOrderBands>1;
   }
  }
 }
 for(int64_t e=0;e<E;++e){
#ifdef __DAV_CUBE__
  const int64_t end=ends.GetValue(e);
#else
  const int64_t end=glv.GetValue(e);
#endif
  const int64_t rows=end-begin;const bool wide=Flexible&&rows<=64&&N>TN;
  const int tileM=wide?64:TM,tileN=wide?512:TN,stripRows=ES/tileN;
#ifdef __DAV_CUBE__
  const bool nativeB1=selected.Has((int)e);
  auto& activeW=nativeB1?b1:b;
  const int64_t weightStride=nativeB1?bStride:N;
#endif
  const int64_t nt=(N+tileN-1)/tileN,tasks=((rows+tileM-1)/tileM)*nt;
  const int64_t first=(core-prefix%cores+cores)%cores;
  const int64_t lim=(cut-prefix<tasks)?(cut-prefix<0?0:cut-prefix):tasks;
  const int64_t scanStart=orderEligible?0:first;
  const int64_t scanStep=orderEligible?1:cores;
  for(int64_t task=scanStart;task<lim;task+=scanStep){
   if(orderEligible){
    // Eligible groups contribute one row band and a common number of columns.
    // The partial final band belongs to its first partialOrderCols columns.
    const int64_t band=prefix/nt;
    const int64_t colRank=task*fullOrderBands+(task<partialOrderCols?task:partialOrderCols)+band;
    const int64_t rank=kColumnMajorExpertOrder?colRank:prefix+task;
    if(rank%cores!=core)continue;
   }
   // Every participant advances even when an AIV has zero live rows.
   const int64_t ordinal=produced++;const int slot=(int)(ordinal&3);
   const uint16_t readyFlag=8+2*slot,ackFlag=readyFlag+1;
   auto slotCg=cg[slot*TM*TN];
   int64_t r0=begin+(task/nt)*tileM,c0=(task%nt)*tileN;
   int rm=(end-r0<tileM)?end-r0:tileM,cn=(N-c0<tileN)?N-c0:tileN;
#ifdef __DAV_CUBE__
   if(ordinal>=4)CrossCoreWaitFlag<2>(ackFlag);
   panel.Compute(a,activeW,slotCg,e,r0,c0,rm,cn,K,weightStride,tileN,nativeB1);
