  const int64_t rounds=units>0?((units+cores-1)/cores):0;
  const int64_t cut0=cores*(rounds>0?rounds-1:0);
  surplus=units-cut0;
  sr=(surplus>0&&surplus<cores)?(cores/surplus):1;
  {const int64_t smax=TM/EM;if(sr>smax)sr=smax;if(sr<2)sr=1;}
  if(sr>1)cut=cut0;
  if constexpr(Panel&&PipelinedTail){
   // Six native panels are the minimum amortization target. Only the first
   // full natural wave is retained and the remaining count must admit >=2 parts.
#ifdef __DAV_CUBE__
   if(units>cores&&surplus<=cores/2&&surplus>0&&cut0==cores){
#else
   if(K>=6*512&&K<=8192&&K%32==0&&units>cores&&surplus<=cores/2&&surplus>0&&cut0==cores){
#endif
    const int budget=(int)(cores/surplus);
    tailKParts=kEnablePipelinedTailK?(budget<4?budget:4):1;
    cut=cores;
   }
  }
 }
 for(int64_t e=0;e<E;++e){
#ifdef __DAV_CUBE__
  const int64_t end=ends.GetValue(e);
#else
  const int64_t end=glv.GetValue(e);
#endif
  const int64_t rows=end-begin,tasks=((rows+TM-1)/TM)*nt;
  const int64_t first=(core-prefix%cores+cores)%cores;
  const int64_t lim=(cut-prefix<tasks)?(cut-prefix<0?0:cut-prefix):tasks;
  for(int64_t task=first;task<lim;task+=cores){
   // Every participant advances even when an AIV has zero live rows.
   const int64_t ordinal=produced++;const int slot=(int)(ordinal&3);
   const uint16_t readyFlag=8+2*slot,ackFlag=readyFlag+1;
   auto slotCg=cg[slot*TM*TN];
   int64_t r0=begin+(task/nt)*TM,c0=(task%nt)*TN;
   int rm=(end-r0<TM)?end-r0:TM,cn=(N-c0<TN)?N-c0:TN;
#ifdef __DAV_CUBE__
   if(useDirect){
    if(!cubeQueued)direct.Stage(a,b,e,r0,c0,rm,cn,K,N);
    int64_t ne=0,nr=0,nc=0;int nm=0,nn=0;
    bool next=NextCubeTask(ends,E,core,cores,e,begin,end,prefix,task,tasks,nt,N,ne,nr,nc,nm,nn);
    if(next)direct.Stage(a,b,ne,nr,nc,nm,nn,K,N);
    if(ordinal>=4)CrossCoreWaitFlag<2>(ackFlag);
    direct.Compute(slotCg,rm,cn,(int)K);cubeQueued=next;
   }else{
   if(warm){const int64_t na=(rm*K<32768)?(rm*K):32768;
    const int64_t nb=(K*N-c0<65536)?(K*N-c0):65536;
    DataCopy(pfb,a[r0*K],na);DataCopy(pfb[32768],b[e*K*N+c0],nb);}
   if(ordinal>=4)CrossCoreWaitFlag<2>(ackFlag);
   if constexpr(Panel&&PipelinedTail){
    // Four phase positions always fit; use eight when eight full panels fit.
    const unsigned phaseMask=K>=8*512?7u:3u;
    const int firstK=phaseFirstWave?(int)(((unsigned)core&phaseMask)*512):0;
    panel.Compute<true>(a,b,slotCg,e,r0,c0,rm,cn,K,N,firstK);
   }else if constexpr(Panel)panel.Compute(a,b,slotCg,e,r0,c0,rm,cn,K,N);
   else{mm.SetOrgShape(M,N,K,K,TN);mm.SetTensorA(a[r0*K]);mm.SetTensorB(b[e*K*N+c0]);
   mm.SetTail(rm,cn,K);mm.IterateAll(slotCg,false);mm.End();}
   }
   CrossCoreSetFlag<2,PIPE_FIX>(readyFlag);
#else
   // AIV: drain this slot in EM-row strips so UB no longer scales with TM.
   CrossCoreWaitFlag<2>(readyFlag);
