constexpr int TM=128,TN=256,EM=16,VM=TM/2,SZ=VM*TN,ES=EM*TN,MB=((ES+255)/256)*32;
// TN stays 256: it is the L0C block width (baseN) and the UB chunk width, so L0C holds
// exactly TM x TN int32 = 128 KB and no vector pass is wasted on padding.
// TNC is the widest legal singleCoreN; the actual per-shape value arrives as `tnc`.
// Raising it was worth 13 pct on cold p1: one call then loads twice the B bytes at
// once, and the first-touch path is limited by bytes in flight, not by the total.
constexpr int TNC=2048;
