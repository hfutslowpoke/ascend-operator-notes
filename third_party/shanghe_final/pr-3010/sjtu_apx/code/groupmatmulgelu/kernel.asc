    float r=exponent-(float)sh*0.6931471805599453f;
    float t=2.755731922398589e-7f;
    t=t*r+2.7557319223985893e-6f;
    t=t*r+2.48015873015873e-5f;
    t=t*r+1.984126984126984e-4f;
    t=t*r+1.388888888888889e-3f;
    t=t*r+8.333333333333333e-3f;
    t=t*r+4.1666666666666664e-2f;
    t=t*r+1.6666666666666666e-1f;
    t=t*r+0.5f;t=t*r+1.0f;t=t*r+1.0f;
    union Bits {float f;uint32_t u;} power,bits,unit;
