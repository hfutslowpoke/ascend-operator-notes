    And(mask.ReinterpretCast<uint16_t>(),mask.ReinterpretCast<uint16_t>(),m1.ReinterpretCast<uint16_t>(),(count+15)/16);PipeBarrier<PIPE_V>();
    And(mask.ReinterpretCast<uint16_t>(),mask.ReinterpretCast<uint16_t>(),m2.ReinterpretCast<uint16_t>(),(count+15)/16);PipeBarrier<PIPE_V>();
    Maxs(a,out,-0.0001220703125f,count);PipeBarrier<PIPE_V>();
    Mins(a,a,0.0001220703125f,count);PipeBarrier<PIPE_V>();
    Muls(a,a,16777216.0f,count);PipeBarrier<PIPE_V>();
    Cast(b.ReinterpretCast<int32_t>(),a,RoundMode::CAST_RINT,count);PipeBarrier<PIPE_V>();
    Cast(tmp,b.ReinterpretCast<int32_t>(),RoundMode::CAST_NONE,count);PipeBarrier<PIPE_V>();
    Sub(a,a,tmp,count);PipeBarrier<PIPE_V>();Abs(a,a,count);PipeBarrier<PIPE_V>();
    CompareScalar(m1,a,0.49609375f,CMPMODE::GE,count);PipeBarrier<PIPE_V>();
    int words=(count+15)/16;
    Or(mask.ReinterpretCast<uint16_t>(),mask.ReinterpretCast<uint16_t>(),m1.ReinterpretCast<uint16_t>(),words);PipeBarrier<PIPE_ALL>();
    }
