        LocalTensor<float> z(TPosition::VECCALC,(sequence%2)*16*Q,Q),a(TPosition::VECCALC,4*Q,Q),b(TPosition::VECCALC,8*Q,Q),coefficients(TPosition::VECCALC,COEFF,32),scales(TPosition::VECCALC,COEFF+128,(N+7)/8*8);
        LocalTensor<half> out(TPosition::VECCALC,12*Q,Q);LocalTensor<int16_t> ramp(TPosition::VECCALC,14*Q,Q/32);
        LocalTensor<uint8_t> m1(TPosition::VECCALC,MASK_BASE,Q/8),m2(TPosition::VECCALC,MASK_BASE+MASK_BYTES,Q/8);
        GlobalTensor<int32_t> cg;GlobalTensor<float> sg;GlobalTensor<half> yg;cg.SetGlobalBuffer((__gm__ int32_t*)partial);sg.SetGlobalBuffer((__gm__ float*)scale);yg.SetGlobalBuffer((__gm__ half*)y);
        auto tieBits=coefficients[16].ReinterpretCast<uint16_t>(),nearBits=coefficients[24].ReinterpretCast<uint16_t>();
        if(!initialized){initialized=true;SetFlag<HardEvent::MTE3_V>(EVENT_ID3);
        Duplicate(z.ReinterpretCast<int32_t>(),0,Q);Duplicate(scales,0.0f,(N+7)/8*8);Duplicate(coefficients,-0.07135481627260025f,8);Duplicate(coefficients[8],-1.5957691216057308f,8);PipeBarrier<PIPE_V>();
Duplicate(tieBits.ReinterpretCast<uint32_t>(),(uint32_t)0xff001ffe,8);Duplicate(nearBits.ReinterpretCast<uint32_t>(),(uint32_t)0xff8000ff,8);
        for(int i=0;i<16;++i)ramp.SetValue(i,i);SetFlag<HardEvent::S_V>(EVENT_ID2);WaitFlag<HardEvent::S_V>(EVENT_ID2);
        for(int span=16;span<Q/32;span*=2){int count=Q/32-span<span?Q/32-span:span;Adds(ramp[span],ramp,(int16_t)span,count);PipeBarrier<PIPE_V>();}
        }
        SetFlag<HardEvent::V_MTE2>(EVENT_ID0);WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
        if(scaleExpert!=e){scaleExpert=e;DataCopyPad(scales,sg[(int64_t)e*N],DataCopyExtParams{1,(uint32_t)(N*4),0,0,0},DataCopyPadExtParams<float>{true,0,(uint8_t)((8-N%8)%8),0});}
        int pitch=(cols+31)/32*32;int aligned=(cols+7)/8*8;
        if(sequence==0){
            CrossCoreWaitFlag<2>(8);
            if (rows > 0)
                DataCopyPad(z.ReinterpretCast<int32_t>(), cg[(int64_t)task * BM * BN + sub * Q],
                            DataCopyExtParams{(uint16_t)rows, (uint32_t)(cols * 4), (uint32_t)((BN - cols) * 4),
                                              (uint32_t)((pitch - aligned) / 8), 0},
                            DataCopyPadExtParams<int32_t>{true, 0, (uint8_t)(aligned - cols), 0});
            CrossCoreSetFlag<2,PIPE_MTE2>(9);
        }else WaitFlag<HardEvent::MTE2_V>(EVENT_ID4);
        SetFlag<HardEvent::MTE2_V>(EVENT_ID0);WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
        if(rows<=0){
        if(hasNext){
            int nr=nextRows-sub*(BM/2);nr=nr<BM/2?nr:BM/2;
            int np=(nextCols+31)/32*32,na=(nextCols+7)/8*8;
            LocalTensor<int32_t> nextZ(TPosition::VECCALC,((sequence+1)%2)*16*Q,Q);
            CrossCoreWaitFlag<2>(8+2*((sequence+1)%2));
            if (nr > 0)
                DataCopyPad(nextZ, cg[(int64_t)((task / 2) * 2 + (sequence + 1) % 2) * BM * BN + sub * Q],
                            DataCopyExtParams{(uint16_t)nr, (uint32_t)(nextCols * 4), (uint32_t)((BN - nextCols) * 4),
                                              (uint32_t)((np - na) / 8), 0},
                            DataCopyPadExtParams<int32_t>{true, 0, (uint8_t)(na - nextCols), 0});
            CrossCoreSetFlag<2,PIPE_MTE2>(9+2*((sequence+1)%2));
            SetFlag<HardEvent::MTE2_V>(EVENT_ID4);
        }
return;}
        int count=(rows*pitch+63)/64*64;Cast(z,z.ReinterpretCast<int32_t>(),RoundMode::CAST_RINT,count);PipeBarrier<PIPE_V>();
        for(int c=0;c<pitch;c+=64)Mul(z[c],z[c],scales[col+c],(uint64_t)(pitch-c<64?pitch-c:64),(uint8_t)rows,BinaryRepeatParams{1,1,1,(uint8_t)(pitch/8),(uint8_t)(pitch/8),0});PipeBarrier<PIPE_V>();
        int n=count;
    Mul(a,z,z,n);PipeBarrier<PIPE_V>();
    Muls(a,a,-0.07135481627260025f,n);PipeBarrier<PIPE_V>();
    Adds(a,a,-1.5957691216057308f,n);PipeBarrier<PIPE_V>();
    Mul(a,a,z,n);PipeBarrier<PIPE_V>();

    Exp(b,a,n);PipeBarrier<PIPE_V>();
    Adds(a,b,1.0f,n);PipeBarrier<PIPE_V>();
    Div(b,z,a,n);PipeBarrier<PIPE_V>();
    Adds(a.ReinterpretCast<int32_t>(),b.ReinterpretCast<int32_t>(),(int32_t)1,n);PipeBarrier<PIPE_V>();
    And(a.ReinterpretCast<uint16_t>(),a.ReinterpretCast<uint16_t>(),tieBits,(uint64_t)128,(uint8_t)(n/64),BinaryRepeatParams{1,1,0,8,8,0});PipeBarrier<PIPE_V>();
    CompareScalar(m1,a.ReinterpretCast<int32_t>(),(int32_t)0x40001000,CMPMODE::EQ,n);PipeBarrier<PIPE_V>();




    uint64_t selectedCount=0;
    CompareScalar(m2,m1.ReinterpretCast<int32_t>(),(int32_t)0,CMPMODE::EQ,n/32);PipeBarrier<PIPE_V>();
    Not(m2.ReinterpretCast<uint16_t>(),m2.ReinterpretCast<uint16_t>(),(n+511)/512);PipeBarrier<PIPE_V>();
    SetMaskCount();SetVectorMask<int16_t,MaskMode::COUNTER>(0,n/32);
    GatherMask(a.ReinterpretCast<int16_t>(),ramp,m2.ReinterpretCast<int16_t>(),(uint8_t)0,GatherMaskParams{1,1,8,0});
    SetMaskNorm();ResetMask();
        if(hasNext){
            int nr=nextRows-sub*(BM/2);nr=nr<BM/2?nr:BM/2;
            int np=(nextCols+31)/32*32,na=(nextCols+7)/8*8;
            LocalTensor<int32_t> nextZ(TPosition::VECCALC,((sequence+1)%2)*16*Q,Q);
            CrossCoreWaitFlag<2>(8+2*((sequence+1)%2));
            if (nr > 0)
                DataCopyPad(nextZ, cg[(int64_t)((task / 2) * 2 + (sequence + 1) % 2) * BM * BN + sub * Q],
                            DataCopyExtParams{(uint16_t)nr, (uint32_t)(nextCols * 4), (uint32_t)((BN - nextCols) * 4),
                                              (uint32_t)((np - na) / 8), 0},
                            DataCopyPadExtParams<int32_t>{true, 0, (uint8_t)(na - nextCols), 0});
            CrossCoreSetFlag<2,PIPE_MTE2>(9+2*((sequence+1)%2));
            SetFlag<HardEvent::MTE2_V>(EVENT_ID4);
        }
    WaitFlag<HardEvent::MTE3_V>(EVENT_ID3);
    Cast(out,b,RoundMode::CAST_RINT,n);PipeBarrier<PIPE_V>();

        SetFlag<HardEvent::V_S>(EVENT_ID2);WaitFlag<HardEvent::V_S>(EVENT_ID2);selectedCount=GetGatherMaskRemainCount();
        for (uint64_t j = 0; j < selectedCount; ++j) {
            int wordIndex = a.ReinterpretCast<int16_t>().GetValue(j);
            uint32_t word = m1.ReinterpretCast<uint32_t>().GetValue(wordIndex);
            while (word) {
                int bit = __builtin_ctz(word);
                word &= word - 1;
                int index = wordIndex * 32 + bit;

                union {
                    float f;
                    uint32_t u;
                } v;

                v.f = z.GetValue(index);
                if (v.f >= 0.0f) {
                    out.SetValue(index, (half)MacroMidpointRounded(v.f));
                } else if (v.f < 0.0f && b.GetValue(index) > -0.00006103515625f)
                    out.SetValue(index, (half)MacroMidpointRounded(v.f));
            }
        }
        SetFlag<HardEvent::S_MTE3>(EVENT_ID2);WaitFlag<HardEvent::S_MTE3>(EVENT_ID2);
        DataCopyPad(yg[(int64_t)row*N+col],out,DataCopyExtParams{(uint16_t)rows,(uint32_t)(cols*2),(uint32_t)((pitch-(cols+15)/16*16)/16),(uint32_t)((N-cols)*2),0});
        SetFlag<HardEvent::MTE3_V>(EVENT_ID3);
}

__aicore__ inline void PackMacroWeight(GM_ADDR w,GM_ADDR packed,int E,int K,int N,int cores,int begin,int finish){int pk=(K+31)/32*32,pn=(N+31)/32*32;
        constexpr int PR=64,PC=768;
        LocalTensor<int8_t> storage(TPosition::VECCALC,0,4*PR*PC);
        GlobalTensor<int8_t> wg,pg;wg.SetGlobalBuffer((__gm__ int8_t*)w);pg.SetGlobalBuffer((__gm__ int8_t*)packed);
        int nk=(finish-begin+PR-1)/PR,nn=(N+PC-1)/PC,seq=0;
        for(int task=GetBlockIdx();task<E*nk*nn;task+=2*cores){
            int slot=seq%2,e=task/(nk*nn),local=task%(nk*nn),k0=begin+local/nn*PR,n0=local%nn*PC;
            int rows=K-k0<PR?K-k0:PR,cols=N-n0<PC?N-n0:PC,blocks=(cols+31)/32;
            if(seq>=2)WaitFlag<HardEvent::MTE3_MTE2>((TEventID)slot);
            auto raw=storage[slot*2*PR*PC],dst=raw[PR*PC];
            if(rows<PR){Duplicate(raw[rows*PC].ReinterpretCast<int32_t>(),0,(PR-rows)*(PC/4));SetFlag<HardEvent::V_MTE2>(EVENT_ID2);WaitFlag<HardEvent::V_MTE2>(EVENT_ID2);}
            DataCopyPad(raw,wg[((int64_t)e*K+k0)*N+n0],DataCopyExtParams{(uint16_t)rows,(uint32_t)cols,(uint32_t)(N-cols),(uint32_t)(PC/32-blocks),0},DataCopyPadExtParams<int8_t>{true,0,(uint8_t)(blocks*32-cols),0});
            SetFlag<HardEvent::MTE2_V>(EVENT_ID0);WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
            for (int block = 0; block < (cols + 255) / 256; ++block) {
                int width = blocks * 32 - block * 256;
                width = width < 256 ? width : 256;
                Adds(dst[block * PR * 256].ReinterpretCast<int32_t>(), raw[block * 256].ReinterpretCast<int32_t>(), 0,
                     (uint64_t)(width / 4), (uint8_t)PR, UnaryRepeatParams{PR, 1, 1, PC / 32});
            }
            SetFlag<HardEvent::V_MTE3>(EVENT_ID0);WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
            DataCopyPad(pg[(int64_t)e*pk*pn+(int64_t)n0*pk+k0*32],dst,DataCopyExtParams{(uint16_t)blocks,(uint32_t)(((rows+31)/32*32)*32),(uint32_t)(PR-(rows+31)/32*32),(uint32_t)((pk-(rows+31)/32*32)*32),0});
            SetFlag<HardEvent::MTE3_MTE2>((TEventID)slot);++seq;
        }
        for(int slot=0;slot<2 && slot<seq;++slot)WaitFlag<HardEvent::MTE3_MTE2>((TEventID)slot);

}
__aicore__ inline int PreloadResidentMacro(GM_ADDR x,GM_ADDR groups,int E,int K,int cores){
 GlobalTensor<int64_t> ends;ends.SetGlobalBuffer((__gm__ int64_t*)groups);GlobalTensor<int8_t> ax;ax.SetGlobalBuffer((__gm__ int8_t*)x);LocalTensor<int8_t> a1(TPosition::A1,0,262144);
 int offset=0,first=0,core=GetBlockIdx();
 for(int e=0;e<E;++e){int last=(int)ends.GetValue(e),chunks=(last-first+255)/256,chunk=(core-offset%cores+cores)%cores;if(chunk<chunks){int start=first+chunk*256,rows=last-start<256?last-start:256,ar=(rows+15)/16*16;if(ar<32)ar=32;
         Nd2NzParams p;
         p.ndNum = 1;
         p.nValue = rows;
         p.dValue = K;
         p.srcNdMatrixStride = 0;
         p.srcDValue = K;
         p.dstNzC0Stride = ar;
         p.dstNzNStride = 1;
         p.dstNzMatrixStride = 0;
         DataCopy(a1, ax[(int64_t)start * K], p);
         SetFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);
         WaitFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);
         return start;
     }
     offset += chunks;
     first = last;
 }
 return -1;
}
struct MacroTile {int expert,row,rows,col,cols;
};

template <int BM, int BN>
__aicore__ inline MacroTile ResolveMacroTile(GlobalTensor<int64_t> &ends, int E, int N, int task) {
    int first = 0, nc = (N + BN - 1) / BN;
    for (int e = 0; e < E; ++e) {
        int last = (int)ends.GetValue(e), nr = (last - first + BM - 1) / BM, count = nr * nc;
        if (task < count) {
            int col = (task / nr) * BN, row = first + (task % nr) * BM;
            return MacroTile{e, row, last - row < BM ? last - row : BM, col, N - col < BN ? N - col : BN};
        }
        task -= count;
        first = last;
    }
    return MacroTile{0, 0, 0, 0, 0};
}
template<int BM,int BN,int PK>
__global__ __aicore__ void grouped_gelu_macro_resident(GM_ADDR x,GM_ADDR w,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,GM_ADDR partial,GM_ADDR packed,int E,int M,int K,int N,int cores){
 KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
 int pk=(K+31)/32*32,pn=(N+31)/32*32,nc=(N+BN-1)/BN;
 if ASCEND_IS_AIV {PackMacroWeight(w,packed,E,K,N,cores,0,K);SyncAll<true>();CrossCoreSetFlag<2,PIPE_MTE3>(6);}

 GlobalTensor<int64_t> ends;ends.SetGlobalBuffer((__gm__ int64_t*)groups);
 int total=0,first=0;for(int e=0;e<E;++e){int last=(int)ends.GetValue(e);total+=(last-first+BM-1)/BM*nc;first=last;}
 int core=GetBlockIdx();if ASCEND_IS_AIV {core/=2;}
 int lower=total*core/cores,upper=total*(core+1)/cores,sequence=0,scaleExpert=-1;bool initialized=false;
 if ASCEND_IS_AIC {
 GlobalTensor<int8_t> ax,bw;GlobalTensor<int32_t> cg;ax.SetGlobalBuffer((__gm__ int8_t*)x);bw.SetGlobalBuffer((__gm__ int8_t*)packed);cg.SetGlobalBuffer((__gm__ int32_t*)partial);
 LocalTensor<int8_t> a1(TPosition::A1,0,131072),b1(TPosition::B1,131072,262144),a2(TPosition::A2,0,2*BM*PK),b2(TPosition::B2,0,2*BN*PK);LocalTensor<int32_t> cc(TPosition::CO1,0,2*BM*BN);
 for(int q=0;q<2;++q){SetFlag<HardEvent::M_MTE1>((TEventID)q);SetFlag<HardEvent::FIX_M>((TEventID)q);}
 int previousExpert=-1,previousCol=-1;
 Nd2NzParams ap;ap.ndNum=1;ap.dValue=K;ap.srcNdMatrixStride=0;ap.srcDValue=K;ap.dstNzC0Stride=BM;ap.dstNzNStride=1;ap.dstNzMatrixStride=0;
 if(lower<upper){auto tile=ResolveMacroTile<BM,BN>(ends,E,N,lower);ap.nValue=tile.rows;DataCopy(a1,ax[(int64_t)tile.row*K],ap);SetFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);}
 CrossCoreWaitFlag<2>(6);
 for(int task=lower;task<upper;++task){auto tile=ResolveMacroTile<BM,BN>(ends,E,N,task);int an=(tile.cols+31)/32*32,slot=sequence%2;
 WaitFlag<HardEvent::MTE2_MTE1>((TEventID)slot);
 if(previousExpert!=tile.expert||previousCol!=tile.col){DataCopy(b1,bw[(int64_t)tile.expert*pk*pn+(int64_t)tile.col*pk],an*pk);previousExpert=tile.expert;previousCol=tile.col;}
 SetFlag<HardEvent::MTE2_MTE1>(EVENT_ID2);WaitFlag<HardEvent::MTE2_MTE1>(EVENT_ID2);
 if(task+1<upper){auto next=ResolveMacroTile<BM,BN>(ends,E,N,task+1);ap.nValue=next.rows;DataCopy(a1[(1-slot)*BM*pk],ax[(int64_t)next.row*K],ap);SetFlag<HardEvent::MTE2_MTE1>((TEventID)(1-slot));}
 WaitFlag<HardEvent::FIX_M>((TEventID)slot);
 for(int k0=0,j=0;k0<K;k0+=PK,++j){int q=j%2,kl=K-k0<PK?K-k0:PK,ak=(kl+31)/32*32;if(ak<PK){SetFlag<HardEvent::M_MTE1>(EVENT_ID2);WaitFlag<HardEvent::M_MTE1>(EVENT_ID2);}WaitFlag<HardEvent::M_MTE1>((TEventID)q);
     LoadData3DParamsV2<int8_t> al;
     al.l1H = 1;
     al.l1W = BM;
     al.channelSize = pk;
     al.kExtension = ak;
     al.mExtension = BM;
     al.kStartPt = k0;
     al.mStartPt = 0;
     al.strideW = 1;
     al.strideH = 1;
     al.filterW = 1;
     al.filterH = 1;
     al.dilationFilterW = 1;
     al.dilationFilterH = 1;
     al.padList[0] = 0;
     al.padList[1] = 0;
     al.padList[2] = 0;
     al.padList[3] = 0;
     al.enTranspose = false;
     al.enSmallK = false;
     al.padValue = 0;
     LoadData(a2[q * BM * PK], a1[slot * BM * pk], al);
     LoadData2dTransposeParams bl;
     bl.startIndex = 0;
     bl.repeatTimes = an / 32;
     bl.srcStride = pk / 32;
     bl.dstGap = 1;
     bl.dstFracGap = 0;
     for (int kk = 0; kk < ak; kk += 32)
         LoadDataWithTranspose(b2[q * BN * PK + kk * an], b1[(k0 + kk) * 32], bl);
     SetFlag<HardEvent::MTE1_M>(EVENT_ID0);
     WaitFlag<HardEvent::MTE1_M>(EVENT_ID0);
     MmadParams mp;
     mp.m = BM;
     mp.n = an;
     mp.k = kl;
     mp.cmatrixInitVal = k0 == 0;
     Mmad(cc[slot * BM * BN], a2[q * BM * PK], b2[q * BN * PK], mp);
     SetFlag<HardEvent::M_MTE1>((TEventID)q);
 }
 SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);SetFlag<HardEvent::M_FIX>(EVENT_ID0);WaitFlag<HardEvent::M_FIX>(EVENT_ID0);
 if (sequence >= 2)
     CrossCoreWaitFlag<2>(9 + 2 * slot);
 FixpipeParamsV220 fp;
 fp.nSize = an;
 fp.mSize = tile.rows;
 fp.srcStride = BM;
 fp.dstStride = BN;
 fp.ndNum = 1;
 fp.srcNdStride = 0;
 fp.dstNdStride = 0;
 Fixpipe(cg[(core * 2 + slot) * BM * BN], cc[slot * BM * BN], fp);
 CrossCoreSetFlag<2, PIPE_FIX>(8 + 2 * slot);
 ++sequence;
 SetFlag<HardEvent::FIX_M>((TEventID)slot);
 }
 for(int q=sequence>2?sequence-2:0;q<sequence;++q)CrossCoreWaitFlag<2>(9+2*(q%2));for(int q=0;q<2;++q){WaitFlag<HardEvent::M_MTE1>((TEventID)q);WaitFlag<HardEvent::FIX_M>((TEventID)q);}
 }else{
     for (int task = lower; task < upper; ++task) {
         auto tile = ResolveMacroTile<BM, BN>(ends, E, N, task);
         bool hasNext = task + 1 < upper;
         MacroTile next = hasNext ? ResolveMacroTile<BM, BN>(ends, E, N, task + 1) : MacroTile{0, 0, 0, 0, 0};
         FinishMacroResident<BM, BN>(partial, scale, y, tile.expert, tile.row, tile.rows, tile.col, N,
                                     core * 2 + sequence % 2, sequence, initialized, scaleExpert, hasNext, next.rows,
                                     next.cols);
         ++sequence;
     }
 if(initialized)WaitFlag<HardEvent::MTE3_V>(EVENT_ID3);
 }
 PipeBarrier<PIPE_ALL>();
}
static void LaunchMacroResident(GM_ADDR x,const TensorGroupInfo& info_x,
    GM_ADDR weight,const TensorGroupInfo& info_weight,GM_ADDR scale,const TensorGroupInfo& info_scale,
    GM_ADDR group_list,const TensorGroupInfo& info_group_list,GM_ADDR y,const TensorGroupInfo& info_y,
    int64_t availableCoreNum,aclrtStream stream){
    int E=info_weight.tensors[0].shape[0],M=info_x.tensors[0].shape[0],K=info_x.tensors[0].shape[1],N=info_weight.tensors[0].shape[2];
    auto platform=platform_ascendc::PlatformAscendCManager::GetInstance();
    int cores=std::min<int64_t>(20,std::min<int64_t>(availableCoreNum,platform->GetCoreNumAic()));
    constexpr int BM=64,BN=256,PK=128;
    void* memory=nullptr;
    size_t cbytes=(size_t)cores*2*BM*BN*4;
    if(aclrtMalloc(&memory,cbytes+(size_t)E*((K+31)/32*32)*((N+31)/32*32),ACL_MEM_MALLOC_HUGE_FIRST)!=0)throw std::runtime_error("allocation failed");
    grouped_gelu_macro_resident<BM,BN,PK><<<cores,nullptr,stream>>>(x,weight,scale,group_list,y,(GM_ADDR)memory,(GM_ADDR)((uint8_t*)memory+cbytes),E,M,K,N,cores);
    auto status=aclrtSynchronizeStream(stream);aclrtFree(memory);
    if(status!=0)throw std::runtime_error("kernel failed");
}

}

namespace ColumnEpilogue {
template <int BM, int BN, bool SUBNORMAL_REPAIR = true, bool FUSED_POLYNOMIAL = false>
__aicore__ inline void FinishTile(GM_ADDR partial, GM_ADDR scale, GM_ADDR y, int e, int start, int expertRows, int col,
                                  int N, int task, int sequence, bool &initialized, bool &outputPending) {
    constexpr int Q=BM*BN/2;

        int sub=GetBlockIdx()%2;
        int row=start+sub*(BM/2);
        int rows=expertRows-sub*(BM/2);rows=rows<BM/2?rows:BM/2;int cols=N-col<BN?N-col:BN;if(rows<=0){CrossCoreWaitFlag<2>(8+2*(sequence%2));CrossCoreSetFlag<2,PIPE_MTE2>(9+2*(sequence%2));return;}
        constexpr int MASK_BYTES=(Q/8+31)/32*32;
        constexpr int INDEX_BYTES=(Q/16+31)/32*32;
        constexpr int MASK_BASE=12*Q+2*INDEX_BYTES;
        constexpr int COEFF=MASK_BASE+2*MASK_BYTES;
        LocalTensor<float> z(TPosition::VECCALC,0,Q),a(TPosition::VECCALC,4*Q,Q),b(TPosition::VECCALC,8*Q,Q),coefficients(TPosition::VECCALC,COEFF,32),scales(TPosition::VECCALC,COEFF+128,BN);
        LocalTensor<half> out(TPosition::VECCALC,4*Q,Q);LocalTensor<int16_t> ramp(TPosition::VECCALC,12*Q,Q/32),selected(TPosition::VECCALC,12*Q+INDEX_BYTES,Q/32);
        LocalTensor<uint8_t> m1(TPosition::VECCALC,MASK_BASE,Q/8),m2(TPosition::VECCALC,MASK_BASE+MASK_BYTES,Q/8);
        GlobalTensor<int32_t> cg;GlobalTensor<float> sg;GlobalTensor<half> yg;cg.SetGlobalBuffer((__gm__ int32_t*)partial);sg.SetGlobalBuffer((__gm__ float*)scale);yg.SetGlobalBuffer((__gm__ half*)y);
        auto tieBits=coefficients[16].ReinterpretCast<uint16_t>(),nearBits=coefficients[24].ReinterpretCast<uint16_t>();
        if(!initialized){initialized=true;
        Duplicate(z.ReinterpretCast<int32_t>(),0,Q);Duplicate(scales,0.0f,BN);Duplicate(coefficients,-0.07135481627260025f,8);Duplicate(coefficients[8],-1.5957691216057308f,8);PipeBarrier<PIPE_V>();
Duplicate(tieBits.ReinterpretCast<uint32_t>(),(uint32_t)0xff001ff8,8);Duplicate(nearBits.ReinterpretCast<uint32_t>(),(uint32_t)0xff8000ff,8);
        for(int i=0;i<16;++i)ramp.SetValue(i,i);SetFlag<HardEvent::S_V>(EVENT_ID2);WaitFlag<HardEvent::S_V>(EVENT_ID2);
        for(int span=16;span<Q/32;span*=2){int count=Q/32-span<span?Q/32-span:span;Adds(ramp[span],ramp,(int16_t)span,count);PipeBarrier<PIPE_V>();}
        }
        SetFlag<HardEvent::V_MTE2>(EVENT_ID0);WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
        DataCopyPad(scales,sg[(int64_t)e*N+col],DataCopyExtParams{1,(uint32_t)(cols*4),0,0,0},DataCopyPadExtParams<float>{true,0,(uint8_t)((8-cols%8)%8),0});
        CrossCoreWaitFlag<2>(8+2*(sequence%2));
        int pitch=(cols+31)/32*32;int aligned=(cols+7)/8*8;
        DataCopyPad(z.ReinterpretCast<int32_t>(), cg[(int64_t)task * BM * BN + sub * Q],
                    DataCopyExtParams{(uint16_t)rows, (uint32_t)(cols * 4), (uint32_t)((BN - cols) * 4),
                                      (uint32_t)((pitch - aligned) / 8), 0},
                    DataCopyPadExtParams<int32_t>{true, 0, (uint8_t)(aligned - cols), 0});
        CrossCoreSetFlag<2,PIPE_MTE2>(9+2*(sequence%2));
        SetFlag<HardEvent::MTE2_V>(EVENT_ID0);WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
        int count=(rows*pitch+63)/64*64;Cast(z,z.ReinterpretCast<int32_t>(),RoundMode::CAST_RINT,count);PipeBarrier<PIPE_V>();
        for(int c=0;c<pitch;c+=64)Mul(z[c],z[c],scales[c],(uint64_t)(pitch-c<64?pitch-c:64),(uint8_t)rows,BinaryRepeatParams{1,1,1,(uint8_t)(pitch/8),(uint8_t)(pitch/8),0});PipeBarrier<PIPE_V>();
        int n=count;
    if(outputPending) {WaitFlag<HardEvent::MTE3_V>(EVENT_ID3);outputPending=false;}
    Mul(a,z,z,n);PipeBarrier<PIPE_V>();
    if constexpr(FUSED_POLYNOMIAL){FusedMulAdd(a,coefficients,coefficients[8],(uint64_t)64,(uint8_t)(n/64),BinaryRepeatParams{1,0,0,8,0,0});PipeBarrier<PIPE_V>();}else{Muls(a,a,-0.07135481627260025f,n);PipeBarrier<PIPE_V>();
    Adds(a,a,-1.5957691216057308f,n);PipeBarrier<PIPE_V>();}
    Mul(a,a,z,n);PipeBarrier<PIPE_V>();

    Exp(b,a,n);PipeBarrier<PIPE_V>();
    Adds(a,b,1.0f,n);PipeBarrier<PIPE_V>();
    Div(b,z,a,n);PipeBarrier<PIPE_V>();
    Adds(a.ReinterpretCast<int32_t>(),b.ReinterpretCast<int32_t>(),(int32_t)4,n);PipeBarrier<PIPE_V>();
    And(a.ReinterpretCast<uint16_t>(),a.ReinterpretCast<uint16_t>(),tieBits,(uint64_t)128,(uint8_t)(n/64),BinaryRepeatParams{1,1,0,8,8,0});PipeBarrier<PIPE_V>();
    CompareScalar(m1,a.ReinterpretCast<int32_t>(),(int32_t)0x40001000,CMPMODE::EQ,n);PipeBarrier<PIPE_V>();
    if constexpr(SUBNORMAL_REPAIR){
    Adds(a,b,-0.001953125f,n);PipeBarrier<PIPE_V>();
    And(a.ReinterpretCast<uint16_t>(),a.ReinterpretCast<uint16_t>(),nearBits,(uint64_t)128,(uint8_t)(n/64),BinaryRepeatParams{1,1,0,8,8,0});PipeBarrier<PIPE_V>();
    CompareScalar(m2,a.ReinterpretCast<int32_t>(),(int32_t)0xbb000080,CMPMODE::EQ,n);PipeBarrier<PIPE_V>();
    Or(m1.ReinterpretCast<uint16_t>(),m1.ReinterpretCast<uint16_t>(),m2.ReinterpretCast<uint16_t>(),n/16);PipeBarrier<PIPE_V>();
    }
    uint64_t selectedCount=0;
    CompareScalar(m2,m1.ReinterpretCast<int32_t>(),(int32_t)0,CMPMODE::EQ,n/32);PipeBarrier<PIPE_V>();
    Not(m2.ReinterpretCast<uint16_t>(),m2.ReinterpretCast<uint16_t>(),(n+511)/512);PipeBarrier<PIPE_V>();
    SetMaskCount();SetVectorMask<int16_t,MaskMode::COUNTER>(0,n/32);
    GatherMask(selected,ramp,m2.ReinterpretCast<int16_t>(),(uint8_t)0,GatherMaskParams{1,1,8,0});
    SetMaskNorm();ResetMask();
    Cast(out,b,RoundMode::CAST_RINT,n);PipeBarrier<PIPE_V>();

        SetFlag<HardEvent::V_S>(EVENT_ID2);WaitFlag<HardEvent::V_S>(EVENT_ID2);selectedCount=GetGatherMaskRemainCount();
        for (uint64_t j = 0; j < selectedCount; ++j) {
            int wordIndex = selected.GetValue(j);
            uint32_t word = m1.ReinterpretCast<uint32_t>().GetValue(wordIndex);
            while (word) {
                int bit = __builtin_ctz(word);
                word &= word - 1;
                int index = wordIndex * 32 + bit;

                union {
                    float f;
                    uint32_t u;
                } v;

                v.f = z.GetValue(index);
                if (v.f >= 0.0f) {
                    out.SetValue(index, (half)DirectResidentMath::MidpointGeluRounded(v.f));
                } else if (v.f < 0.0f && b.GetValue(index) > -0.00006103515625f)
                    out.SetValue(index, (half)DirectResidentMath::MidpointGeluRounded(v.f));
            }
        }
        SetFlag<HardEvent::S_MTE3>(EVENT_ID2);WaitFlag<HardEvent::S_MTE3>(EVENT_ID2);
        DataCopyPad(yg[(int64_t)row*N+col],out,DataCopyExtParams{(uint16_t)rows,(uint32_t)(cols*2),(uint32_t)((pitch-(cols+15)/16*16)/16),(uint32_t)((N-cols)*2),0});
        SetFlag<HardEvent::MTE3_V>(EVENT_ID3);outputPending=true;
}
}
namespace ColumnStreaming {
__aicore__ inline void WarmWeight(GM_ADDR w,int E,int K,int N,int workers,int worker){
 constexpr int STEP=512,BATCH=2048;int64_t lines=(int64_t)E*K*N/STEP;
 LocalTensor<int8_t> temp(TPosition::VECCALC,0,BATCH*32);GlobalTensor<int8_t> src;src.SetGlobalBuffer((__gm__ int8_t*)w);
 int64_t first=lines*worker/workers,last=lines*(worker+1)/workers;
 for(int64_t line=first;line<last;line+=BATCH){int count=last-line<BATCH?(int)(last-line):BATCH;DataCopyPad(temp,src[line*STEP],DataCopyExtParams{(uint16_t)count,32,STEP-32,0,0},DataCopyPadExtParams<int8_t>{false,0,0,0});}
 SetFlag<HardEvent::MTE2_V>(EVENT_ID6);WaitFlag<HardEvent::MTE2_V>(EVENT_ID6);
}
__aicore__ inline void StageWeight(LocalTensor<int8_t> dst,GlobalTensor<int8_t> src,int expert,int col,int width,int offset,int depth,int K,int N){
    Nd2NzParams p;p.ndNum=1;p.nValue=depth;p.dValue=width;p.srcNdMatrixStride=0;p.srcDValue=N;p.dstNzC0Stride=64;p.dstNzNStride=1;p.dstNzMatrixStride=0;
    if(depth%2==0){p.ndNum=2;p.nValue=depth/2;p.srcNdMatrixStride=N;p.srcDValue=2*N;p.dstNzNStride=2;p.dstNzMatrixStride=32;}
    DataCopy(dst,src[((int64_t)expert*K+offset)*N+col],p);
}

template<int BM,int BN,int PK,int CORES>
__global__ __aicore__ void grouped_gelu_column_pipeline(GM_ADDR x,GM_ADDR w,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,GM_ADDR partial,int E,int M,int K,int N){
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
    int KP=(K+31)/32*32,NC=(N+BN-1)/BN;
    int AB=BM*KP;constexpr int WB=BN*64;
    constexpr int VK=64;
    int core=GetBlockIdx();if ASCEND_IS_AIV {core/=2;}
    GlobalTensor<int64_t> ends;ends.SetGlobalBuffer((__gm__ int64_t*)groups);
    int workRows=0,previous=0;
    for(int i=0;i<E;++i){int next=(int)ends.GetValue(i);workRows+=(next-previous+BM-1)/BM;previous=next;}
    int sequence=0;bool initialized=false,outputPending=false;
    if ASCEND_IS_AIV {int worker=GetBlockIdx()/2;if(GetBlockIdx()%2)WarmWeight(x,1,M,K,CORES,worker);else WarmWeight(w,E,K,N,CORES,worker);}
    if ASCEND_IS_AIC {
        GlobalTensor<int8_t> ag,bg;GlobalTensor<int32_t> cg;
        ag.SetGlobalBuffer((__gm__ int8_t*)x);bg.SetGlobalBuffer((__gm__ int8_t*)w);cg.SetGlobalBuffer((__gm__ int32_t*)partial);
        LocalTensor<int8_t> al(TPosition::A1,0,AB),bl(TPosition::B1,AB,2*WB);
        LocalTensor<int8_t> a0(TPosition::A2,0,2*BM*PK),b0(TPosition::B2,0,2*BN*PK);
        LocalTensor<int32_t> acc(TPosition::CO1,0,BM*BN);
        SetFlag<HardEvent::M_MTE1>(EVENT_ID0);SetFlag<HardEvent::M_MTE1>(EVENT_ID1);
        SetFlag<HardEvent::FIX_M>(EVENT_ID0);
        int cachedRow=-1;
        for(int strip=workRows*NC*core/CORES;strip<workRows*NC*(core+1)/CORES;++strip){
            int chunk=strip/NC,col=strip%NC*BN,width=N-col<BN?N-col:BN,aw=(width+31)/32*32;
            int expert=0,begin=0,end=0;
            for(;expert<E;++expert){end=(int)ends.GetValue(expert);int count=(end-begin+BM-1)/BM;if(chunk<count)break;chunk-=count;begin=end;}
            begin+=chunk*BM;end=end-begin>BM?begin+BM:end;
            for(int row=begin;row<end;row+=BM){
                int rows=end-row<BM?end-row:BM;
                if(cachedRow!=row){
                SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);
                Nd2NzParams p;p.ndNum=1;p.nValue=rows;p.dValue=K;p.srcNdMatrixStride=0;p.srcDValue=K;p.dstNzC0Stride=BM;p.dstNzNStride=1;p.dstNzMatrixStride=0;
                DataCopy(al,ag[(int64_t)row*K],p);cachedRow=row;
                SetFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);WaitFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);
                }
                StageWeight(bl,bg,expert,col,width,0,VK,K,N);SetFlag<HardEvent::MTE2_MTE1>(EVENT_ID2);
                StageWeight(bl[WB],bg,expert,col,width,VK,VK,K,N);SetFlag<HardEvent::MTE2_MTE1>(EVENT_ID3);
                WaitFlag<HardEvent::FIX_M>(EVENT_ID0);
                #pragma unroll(2)
                for(int k0=0,ki=0;k0<K;k0+=PK,++ki){
                    int slot=ki%2,depth=K-k0<PK?K-k0:PK,ak=(depth+31)/32*32;
                    WaitFlag<HardEvent::M_MTE1>((TEventID)slot);
                    LoadData3DParamsV2<int8_t> p;
                    p.l1H = 1;
                    p.l1W = BM;
                    p.channelSize = KP;
                    p.kExtension = ak;
                    p.mExtension = BM;
                    p.kStartPt = k0;
                    p.mStartPt = 0;
                    p.strideW = 1;
                    p.strideH = 1;
                    p.filterW = 1;
                    p.filterH = 1;
                    p.dilationFilterW = 1;
                    p.dilationFilterH = 1;
                    p.padList[0] = 0;
                    p.padList[1] = 0;
                    p.padList[2] = 0;
                    p.padList[3] = 0;
                    p.enTranspose = false;
                    p.enSmallK = false;
                    p.padValue = 0;
                    LoadData(a0[slot*BM*PK],al,p);
                    if(depth>0){
                        WaitFlag<HardEvent::MTE2_MTE1>((TEventID)2);
                        LoadData2dTransposeParams t;t.startIndex=0;t.repeatTimes=aw/32;t.srcStride=VK/32;t.dstGap=1;t.dstFracGap=0;
                        LoadDataWithTranspose(b0[slot*BN*PK+0*aw],bl[0*WB],t);
                        if(ak>32)LoadDataWithTranspose(b0[slot*BN*PK+32*aw],bl[0*WB+1024],t);
                        if(k0+PK+0<K){
                            SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID2);WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID2);
                            int off=k0+PK+0,dep=K-off<VK?K-off:VK;
                            StageWeight(bl[0*WB],bg,expert,col,width,off,dep,K,N);SetFlag<HardEvent::MTE2_MTE1>((TEventID)2);
                        }
                    }
                    if(depth>64){
                        WaitFlag<HardEvent::MTE2_MTE1>((TEventID)3);
                        LoadData2dTransposeParams t;t.startIndex=0;t.repeatTimes=aw/32;t.srcStride=VK/32;t.dstGap=1;t.dstFracGap=0;
                        LoadDataWithTranspose(b0[slot*BN*PK+64*aw],bl[1*WB],t);
                        if(ak>96)LoadDataWithTranspose(b0[slot*BN*PK+96*aw],bl[1*WB+1024],t);
                        if(k0+PK+64<K){
                            SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID2);WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID2);
                            int off=k0+PK+64,dep=K-off<VK?K-off:VK;
                            StageWeight(bl[1*WB],bg,expert,col,width,off,dep,K,N);SetFlag<HardEvent::MTE2_MTE1>((TEventID)3);
                        }
                    }
                    SetFlag<HardEvent::MTE1_M>(EVENT_ID0);WaitFlag<HardEvent::MTE1_M>(EVENT_ID0);
                    MmadParams mm;mm.m=BM;mm.n=aw;mm.k=depth;mm.cmatrixInitVal=k0==0;
                    Mmad(acc,a0[slot*BM*PK],b0[slot*BN*PK],mm);
                    SetFlag<HardEvent::M_MTE1>((TEventID)slot);

                }
                SetFlag<HardEvent::M_FIX>(EVENT_ID0);WaitFlag<HardEvent::M_FIX>(EVENT_ID0);
                int out=sequence%2;
                if(sequence>=2)CrossCoreWaitFlag<2>(9+2*out);
                FixpipeParamsV220 f;f.nSize=aw;f.mSize=rows;f.srcStride=BM;f.dstStride=BN;f.ndNum=1;f.srcNdStride=0;f.dstNdStride=0;
                Fixpipe(cg[(core*2+out)*BM*BN],acc,f);
                CrossCoreSetFlag<2,PIPE_FIX>(8+2*out);++sequence;
                SetFlag<HardEvent::FIX_M>(EVENT_ID0);
            }
            SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);
        }
        for(int q=sequence>2?sequence-2:0;q<sequence;++q)CrossCoreWaitFlag<2>(9+2*(q%2));
        WaitFlag<HardEvent::M_MTE1>(EVENT_ID0);WaitFlag<HardEvent::M_MTE1>(EVENT_ID1);WaitFlag<HardEvent::FIX_M>(EVENT_ID0);
    }else{
        for(int strip=workRows*NC*core/CORES;strip<workRows*NC*(core+1)/CORES;++strip){
            int chunk=strip/NC,col=strip%NC*BN,expert=0,begin=0,end=0;
            for(;expert<E;++expert){end=(int)ends.GetValue(expert);int count=(end-begin+BM-1)/BM;if(chunk<count)break;chunk-=count;begin=end;}
            begin+=chunk*BM;end=end-begin>BM?begin+BM:end;
            for(int row=begin;row<end;row+=BM){
                int rows=end-row<BM?end-row:BM;
                ColumnEpilogue::FinishTile<BM,BN,false,true>(partial,scale,y,expert,row,rows,col,N,core*2+sequence%2,sequence,initialized,outputPending);
                ++sequence;
            }
        }
    }
    if ASCEND_IS_AIV {if(outputPending)WaitFlag<HardEvent::MTE3_V>(EVENT_ID3);}
    PipeBarrier<PIPE_ALL>();
}
void Launch(GM_ADDR x,GM_ADDR w,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,int E,int M,int K,int N,aclrtStream stream){
    constexpr int BM=176,BN=128,PK=128,CORES=20;
    void* memory=nullptr;if(aclrtMalloc(&memory,CORES*2*BM*BN*4,ACL_MEM_MALLOC_HUGE_FIRST)!=0)throw std::runtime_error("allocation failed");
    grouped_gelu_column_pipeline<BM,BN,PK,CORES><<<CORES,nullptr,stream>>>(x,w,scale,groups,y,(GM_ADDR)memory,E,M,K,N);
    auto status=aclrtSynchronizeStream(stream);aclrtFree(memory);if(status!=0)throw std::runtime_error("kernel failed");
}

}
namespace InterleavedStreaming {
__aicore__ inline void StageWeight(LocalTensor<int8_t> dst,GlobalTensor<int8_t> src,int expert,int col,int width,int offset,int depth,int K,int N){
    Nd2NzParams p;p.ndNum=1;p.nValue=depth;p.dValue=width;p.srcNdMatrixStride=0;p.srcDValue=N;p.dstNzC0Stride=192;p.dstNzNStride=1;p.dstNzMatrixStride=0;
    if(depth%2==0){p.ndNum=2;p.nValue=depth/2;p.srcNdMatrixStride=N;p.srcDValue=2*N;p.dstNzNStride=2;p.dstNzMatrixStride=32;}
    DataCopy(dst,src[((int64_t)expert*K+offset)*N+col],p);
}


__aicore__ inline int ScheduledCount(int core,int E,int cores,int N){
    int full=(2*E+cores-1-core)/cores,remainder=2*E%cores,lower=cores-remainder;
    int tailWidth=(N-640+31)/32*32,initial=(320/tailWidth)*lower;initial=initial<E?initial:E;
    int rank=core-remainder,early=rank>=0?(initial+lower-1-rank)/lower:0;
    return full+early+(E-initial+cores-1-core)/cores;
}
__aicore__ inline int ScheduledColumn(int core,int task,int E,int cores,int N){
    int full=(2*E+cores-1-core)/cores;
    if(task<full){int i=core+task*cores;return (i/2)*3+i%2;}
    int remainder=2*E%cores,lower=cores-remainder,tailWidth=(N-640+31)/32*32;
    int initial=(320/tailWidth)*lower;initial=initial<E?initial:E;
    int rank=core-remainder,early=rank>=0?(initial+lower-1-rank)/lower:0;
    int t=task-full,index=t<early?rank+t*lower:initial+core+(t-early)*cores;
    return index*3+2;
}
__aicore__ inline void StreamWeightRead(GM_ADDR weights,int E,int K,int N,int cores){
    int TOTAL=E*K*N;constexpr int CHUNK=32768;
    LocalTensor<int8_t> scratch(TPosition::VECCALC,0,CHUNK);
    GlobalTensor<int8_t> src;src.SetGlobalBuffer((__gm__ int8_t*)weights);
    int BLOCKS=(TOTAL+CHUNK-1)/CHUNK;
    for(int i=BLOCKS*GetBlockIdx()/(2*cores);i<BLOCKS*(GetBlockIdx()+1)/(2*cores);++i){
        int offset=i*CHUNK;
        int count=TOTAL-offset<CHUNK?TOTAL-offset:CHUNK;
        DataCopyPad(scratch,src[offset],DataCopyExtParams{1,(uint32_t)count,0,0,0},DataCopyPadExtParams<int8_t>{true,0,(uint8_t)((32-count%32)%32),0});
    }
    SetFlag<HardEvent::MTE2_V>(EVENT_ID0);WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
}

template<int BM,int BN,int PK,int CORES>
__global__ __aicore__ void grouped_gelu_column_pipeline(GM_ADDR x,GM_ADDR w,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,GM_ADDR partial,int E,int M,int K,int N){
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
    int KP=(K+31)/32*32,NC=(N+BN-1)/BN;
    int AB=BM*KP;int WB=(524288-AB)/64*32;
    constexpr int VK=192;
    int core=GetBlockIdx();if ASCEND_IS_AIV {core/=2;}
    if ASCEND_IS_AIV {StreamWeightRead(w,E,K,N,CORES);}
    GlobalTensor<int64_t> ends;ends.SetGlobalBuffer((__gm__ int64_t*)groups);
    int workRows=0,previous=0;
    for(int i=0;i<E;++i){int next=(int)ends.GetValue(i);workRows+=(next-previous+BM-1)/BM;previous=next;}
    int sequence=0;bool initialized=false,outputPending=false;
    if ASCEND_IS_AIC {
        GlobalTensor<int8_t> ag,bg;GlobalTensor<int32_t> cg;
        ag.SetGlobalBuffer((__gm__ int8_t*)x);bg.SetGlobalBuffer((__gm__ int8_t*)w);cg.SetGlobalBuffer((__gm__ int32_t*)partial);
        LocalTensor<int8_t> al(TPosition::A1,0,AB),bl(TPosition::B1,AB,2*WB);
        LocalTensor<int8_t> a0(TPosition::A2,0,2*BM*PK),b0(TPosition::B2,0,2*BN*PK);
        LocalTensor<int32_t> acc(TPosition::CO1,0,BM*BN);
        SetFlag<HardEvent::M_MTE1>(EVENT_ID0);SetFlag<HardEvent::M_MTE1>(EVENT_ID1);
        SetFlag<HardEvent::FIX_M>(EVENT_ID0);
        int cachedRow=-1;
        for(int task=0;task<ScheduledCount(core,workRows,CORES,N);++task){
            int strip=ScheduledColumn(core,task,workRows,CORES,N);
            int chunk=strip/NC,col=strip%NC*BN,width=N-col<BN?N-col:BN,aw=(width+31)/32*32;
            int expert=0,begin=0,end=0;
            for(;expert<E;++expert){end=(int)ends.GetValue(expert);int count=(end-begin+BM-1)/BM;if(chunk<count)break;chunk-=count;begin=end;}
            begin+=chunk*BM;end=end-begin>BM?begin+BM:end;
            for(int row=begin;row<end;row+=BM){
                int rows=end-row<BM?end-row:BM;
                if(cachedRow!=row){
                SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);
                Nd2NzParams p;p.ndNum=1;p.nValue=rows;p.dValue=K;p.srcNdMatrixStride=0;p.srcDValue=K;p.dstNzC0Stride=BM;p.dstNzNStride=1;p.dstNzMatrixStride=0;
                DataCopy(al,ag[(int64_t)row*K],p);cachedRow=row;
                SetFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);WaitFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);
                }
                StageWeight(bl,bg,expert,col,width,0,VK,K,N);SetFlag<HardEvent::MTE2_MTE1>(EVENT_ID2);
                StageWeight(bl[WB],bg,expert,col,width,VK,VK,K,N);SetFlag<HardEvent::MTE2_MTE1>(EVENT_ID3);
                WaitFlag<HardEvent::FIX_M>(EVENT_ID0);
                for(int k0=0,ki=0;k0<K;k0+=PK,++ki){
                    int band=k0/VK,bank=band%2;
                    if(k0%VK==0)WaitFlag<HardEvent::MTE2_MTE1>((TEventID)(2+bank));
                    int slot=ki%2,depth=K-k0<PK?K-k0:PK,ak=(depth+31)/32*32;
                    WaitFlag<HardEvent::M_MTE1>((TEventID)slot);
                    LoadData3DParamsV2<int8_t> p;
                    p.l1H = 1;
                    p.l1W = BM;
                    p.channelSize = KP;
                    p.kExtension = ak;
                    p.mExtension = BM;
                    p.kStartPt = k0;
                    p.mStartPt = 0;
                    p.strideW = 1;
                    p.strideH = 1;
                    p.filterW = 1;
                    p.filterH = 1;
                    p.dilationFilterW = 1;
                    p.dilationFilterH = 1;
                    p.padList[0] = 0;
                    p.padList[1] = 0;
                    p.padList[2] = 0;
                    p.padList[3] = 0;
                    p.enTranspose = false;
                    p.enSmallK = false;
                    p.padValue = 0;
                    LoadData(a0[slot*BM*PK],al,p);
                    LoadData2dTransposeParams t;t.startIndex=0;t.repeatTimes=aw/32;t.srcStride=VK/32;t.dstGap=1;t.dstFracGap=0;
                    for(int kk=0;kk<ak;kk+=32)LoadDataWithTranspose(b0[slot*BN*PK+kk*aw],bl[bank*WB+((k0%VK)+kk)*32],t);
                    SetFlag<HardEvent::MTE1_M>(EVENT_ID0);WaitFlag<HardEvent::MTE1_M>(EVENT_ID0);
                    MmadParams mm;mm.m=BM;mm.n=aw;mm.k=depth;mm.cmatrixInitVal=k0==0;
                    Mmad(acc,a0[slot*BM*PK],b0[slot*BN*PK],mm);
                    SetFlag<HardEvent::M_MTE1>((TEventID)slot);
                    if((k0+PK)%VK==0 && (band+2)*VK<K){
                        SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID2);WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID2);
                        int off=(band+2)*VK,dep=K-off<VK?K-off:VK;
                        StageWeight(bl[bank*WB],bg,expert,col,width,off,dep,K,N);SetFlag<HardEvent::MTE2_MTE1>((TEventID)(2+bank));
                    }
                }
                SetFlag<HardEvent::M_FIX>(EVENT_ID0);WaitFlag<HardEvent::M_FIX>(EVENT_ID0);
                int out=sequence%2;
                if(sequence>=2)CrossCoreWaitFlag<2>(9+2*out);
                FixpipeParamsV220 f;f.nSize=aw;f.mSize=rows;f.srcStride=BM;f.dstStride=BN;f.ndNum=1;f.srcNdStride=0;f.dstNdStride=0;
                Fixpipe(cg[(core*2+out)*BM*BN],acc,f);
                CrossCoreSetFlag<2,PIPE_FIX>(8+2*out);++sequence;
                SetFlag<HardEvent::FIX_M>(EVENT_ID0);
            }
            SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);
        }
        for(int q=sequence>2?sequence-2:0;q<sequence;++q)CrossCoreWaitFlag<2>(9+2*(q%2));
        WaitFlag<HardEvent::M_MTE1>(EVENT_ID0);WaitFlag<HardEvent::M_MTE1>(EVENT_ID1);WaitFlag<HardEvent::FIX_M>(EVENT_ID0);
    }else{
        for(int task=0;task<ScheduledCount(core,workRows,CORES,N);++task){
            int strip=ScheduledColumn(core,task,workRows,CORES,N);
            int chunk=strip/NC,col=strip%NC*BN,expert=0,begin=0,end=0;
            for(;expert<E;++expert){end=(int)ends.GetValue(expert);int count=(end-begin+BM-1)/BM;if(chunk<count)break;chunk-=count;begin=end;}
            begin+=chunk*BM;end=end-begin>BM?begin+BM:end;
            for(int row=begin;row<end;row+=BM){
                int rows=end-row<BM?end-row:BM;
                ColumnEpilogue::FinishTile<BM,BN>(partial,scale,y,expert,row,rows,col,N,core*2+sequence%2,sequence,initialized,outputPending);
                ++sequence;
            }
        }
    }
    if ASCEND_IS_AIV {if(outputPending)WaitFlag<HardEvent::MTE3_V>(EVENT_ID3);}
    PipeBarrier<PIPE_ALL>();
}
void Launch(GM_ADDR x,GM_ADDR w,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,int E,int M,int K,int N,aclrtStream stream){
    constexpr int BM=80,BN=320,PK=96,CORES=20;
    void* memory=nullptr;if(aclrtMalloc(&memory,CORES*2*BM*BN*4,ACL_MEM_MALLOC_HUGE_FIRST)!=0)throw std::runtime_error("allocation failed");
    grouped_gelu_column_pipeline<BM,BN,PK,CORES><<<CORES,nullptr,stream>>>(x,w,scale,groups,y,(GM_ADDR)memory,E,M,K,N);
    auto status=aclrtSynchronizeStream(stream);aclrtFree(memory);if(status!=0)throw std::runtime_error("kernel failed");
}

}
extern "C" void run_kernel(GM_ADDR x,const TensorGroupInfo& info_x,
    GM_ADDR weight,const TensorGroupInfo& info_weight,
    GM_ADDR scale,const TensorGroupInfo& info_scale,
    GM_ADDR group_list,const TensorGroupInfo& info_group_list,
    GM_ADDR y,const TensorGroupInfo& info_y,int64_t availableCoreNum,aclrtStream stream) {
    if(info_x.numTensors!=1 || info_weight.numTensors!=1 || info_scale.numTensors!=1 ||
       info_group_list.numTensors!=1 || info_y.numTensors!=1) throw std::runtime_error("invalid tensor count");
    const auto &xi=info_x.tensors[0], &wi=info_weight.tensors[0], &si=info_scale.tensors[0],
               &gi=info_group_list.tensors[0], &yi=info_y.tensors[0];
    if(xi.numDims!=2 || wi.numDims!=3 || si.numDims!=2 || gi.numDims!=1 || yi.numDims!=2 ||
       xi.dtype!=3 || wi.dtype!=3 || si.dtype!=0 || gi.dtype!=6 || yi.dtype!=1)
        throw std::runtime_error("invalid tensor metadata");
    int64_t e=wi.shape[0],m=xi.shape[0],k=xi.shape[1],n=wi.shape[2];
    if(e<1 || e>128 || m<1 || m>65536 || k<1 || k>8192 || n<1 || n>4096 ||
       wi.shape[1]!=k || si.shape[0]!=e || si.shape[1]!=n || gi.shape[0]!=e || yi.shape[0]!=m || yi.shape[1]!=n ||
       e*k*n*sizeof(int8_t)>GmmMemoryBudget::WeightBytesLimit ||
       (m*k+e*k*n)*sizeof(int8_t)+e*n*sizeof(float)+e*sizeof(int64_t)+m*n*sizeof(half)>GmmMemoryBudget::TotalTensorBytesLimit || availableCoreNum<1)
        throw std::runtime_error("invalid dimensions or resources");

    auto dispatchPlatform=platform_ascendc::PlatformAscendCManager::GetInstance();
    int dispatchCores=(int)std::min<int64_t>(availableCoreNum,dispatchPlatform->GetCoreNumAic());
    int64_t columnDepth=(k+31)/32*32;
    if(dispatchCores>=20 && k>1024 && 176*columnDepth+2*128*64<=524288 && n>6*128 && n<=8*128 && m>128*e && m<=176*e && e*((n+127)/128)>=20){
        ColumnStreaming::Launch(x,weight,scale,group_list,y,(int)e,(int)m,(int)k,(int)n,stream);return;
    }
    if(dispatchCores>=20 && k>1024 && 80*columnDepth+2*320*192<=524288 && n>2*320 && n<=3*320 && m>40*e && m<=80*e && e*((n+319)/320)>=20){
        InterleavedStreaming::Launch(x,weight,scale,group_list,y,(int)e,(int)m,(int)k,(int)n,stream);return;
    }
    constexpr int macroRows=256,macroColumns=256,macroPacket=128;
    int64_t macroDepth=(k+31)/32*32;
    if(dispatchCores>=16 && k>4*macroPacket && macroRows*macroDepth<=262144 && macroColumns*macroDepth<=262144 &&
       n>2*macroColumns && n<=4*macroColumns && m>macroRows*e &&
       (m+macroRows-1)/macroRows>=16){
        MacroResident::LaunchMacroResident(x,info_x,weight,info_weight,scale,info_scale,group_list,info_group_list,y,info_y,availableCoreNum,stream);return;
    }
    constexpr int compactRows=32,compactColumns=128;
    int64_t compactDepth=(k+31)/32*32;
    if(e==1 && k>=32 && compactColumns*compactDepth<=GmmMemoryBudget::L0BBytes &&
       n>compactColumns/2 && 32*n<=UINT16_MAX && ((m+compactRows-1)/compactRows)*((n+compactColumns-1)/compactColumns)<=dispatchCores){
        LaunchCompactResident(x,info_x,weight,info_weight,scale,info_scale,group_list,info_group_list,y,info_y,availableCoreNum,stream);return;
    }
    constexpr int stationaryRows=128,stationaryColumns=256,stationaryBand=256;
    int64_t stationaryK=(k+31)/32*32;
    if(k>4*stationaryBand && stationaryRows*stationaryK<=262144 &&
       n>2*stationaryColumns && n<=3*stationaryColumns && m>=stationaryRows/2*e && m<=2*stationaryRows*e &&
       e*((n+stationaryColumns-1)/stationaryColumns)>=std::min(16,dispatchCores)){
        LaunchRowResident(x,info_x,weight,info_weight,scale,info_scale,group_list,info_group_list,y,info_y,availableCoreNum,stream);return;
    }
    constexpr int pairRows=64,pairColumns=256,pairPacket=128;
    int64_t pairDepth=(k+31)/32*32;
    if(pairRows*pairDepth>65536 && pairRows*pairDepth<=131072 &&
       n>3*pairColumns && n<=8*pairColumns && m>=pairRows/2*e && m<=2*pairRows*e &&
       e*((n+2*pairColumns-1)/(2*pairColumns))>=std::min(16,dispatchCores)){
        LaunchPairedColumns(x,info_x,weight,info_weight,scale,info_scale,group_list,info_group_list,y,info_y,availableCoreNum,stream);return;
    }
    constexpr int queuedRows=64,queuedColumns=256,queuedPacket=128;
    int64_t queuedDepth=(k+31)/32*32;
    if(k>2*queuedPacket && queuedRows*queuedDepth<=65536 && queuedColumns*queuedDepth<=196608 &&
       n>2*queuedColumns && n<=4*queuedColumns && m>=queuedRows/2*e && m<=4*queuedRows*e &&
       e*((n+queuedColumns-1)/queuedColumns)>=std::min(20,dispatchCores)){
        LaunchQueuedResident(x,info_x,weight,info_weight,scale,info_scale,group_list,info_group_list,y,info_y,availableCoreNum,stream);return;
    }
    constexpr int residentRows=160,residentColumns=128,residentPacket=128;
    int64_t residentDepth=(k+31)/32*32;
    if(k>8*residentPacket && residentRows*residentDepth<=196608 && residentColumns*residentDepth<=163840 &&
       n>4*residentColumns && n<=16*residentColumns && m>=residentRows/2*e && m<=2*residentRows*e &&
       e*((n+residentColumns-1)/residentColumns)>=std::min(20,dispatchCores)){
        LaunchDualResident(x,info_x,weight,info_weight,scale,info_scale,group_list,info_group_list,y,info_y,availableCoreNum,stream);return;
    }
    if(k>512 && k<=1024 && n>768 && n<=2048 && m>=64*e && m<=256*e && e*((n+255)/256)>=std::min(16,dispatchCores)){
        LaunchStreamedResident(x,info_x,weight,info_weight,scale,info_scale,group_list,info_group_list,y,info_y,availableCoreNum,stream);return;
    }
    if(k>256 && k<=1024 && n>128 && n<=512 && m>=256*e && e*((n+127)/128)>=dispatchCores){
        LaunchDirectResident(x,info_x,weight,info_weight,scale,info_scale,group_list,info_group_list,y,info_y,availableCoreNum,stream);return;
    }
    int denseKind=DenseKind(e,m,k,n,dispatchCores);
    size_t denseBytes=0;
    if(denseKind==1||denseKind==2)denseBytes=(size_t)e*((m/e+63)/64)*64*n*4;
    else if(denseKind==3)denseBytes=(size_t)((m+95)/96+e-1)*((n+191)/192)*96*192*4+(size_t)e*((k+31)/32*32)*((n+31)/32*32)+(size_t)(m+15*e)*((k+31)/32*32);
    denseBytes=std::max(denseBytes,(size_t)dispatchCores*16*32*4)+((dispatchCores*128+511)/512)*512+1024;
    TemporaryWorkspace denseWorkspace(stream);
    if(k<=3 && n>=128 && m>=32*e && m*n>=32768) {
        auto vectorPlatform=platform_ascendc::PlatformAscendCManager::GetInstance();
        int vectorCores=(int)std::min<int64_t>(2*availableCoreNum,vectorPlatform->GetCoreNumAiv());
        bool larger=(m/32)*((n+255)/256)>=2*vectorCores;
        int rows=larger?32:8;
        int blocks=(int)std::min<int64_t>(vectorCores,((m+rows-1)/rows+e-1)*((n+255)/256));
        if (larger) {
            if (m * n >= 65536) {
                int denseCores = dispatchCores;
                if (denseKind && DenseKind(e, m, k, n, denseCores) == denseKind)
                    LaunchDense(denseKind, denseCores, stream, x, weight, scale, group_list, y,
                                denseWorkspace.Get(denseBytes), (int)e, (int)m, (int)k, (int)n);
                else
                    grouped_gelu_shallow<32, true>
                        <<<blocks, nullptr, stream>>>(x, weight, scale, group_list, y, (int)e, (int)m, (int)k, (int)n);
            } else {
                int denseCores = dispatchCores;
                if (denseKind && DenseKind(e, m, k, n, denseCores) == denseKind)
                    LaunchDense(denseKind, denseCores, stream, x, weight, scale, group_list, y,
                                denseWorkspace.Get(denseBytes), (int)e, (int)m, (int)k, (int)n);
                else
                    grouped_gelu_shallow<32, false>
                        <<<blocks, nullptr, stream>>>(x, weight, scale, group_list, y, (int)e, (int)m, (int)k, (int)n);
            }
        } else {
            if (m * n >= 65536) {
                int denseCores = dispatchCores;
                if (denseKind && DenseKind(e, m, k, n, denseCores) == denseKind)
                    LaunchDense(denseKind, denseCores, stream, x, weight, scale, group_list, y,
                                denseWorkspace.Get(denseBytes), (int)e, (int)m, (int)k, (int)n);
                else
                    grouped_gelu_shallow<8, true>
                        <<<blocks, nullptr, stream>>>(x, weight, scale, group_list, y, (int)e, (int)m, (int)k, (int)n);
            } else {
                int denseCores = dispatchCores;
                if (denseKind && DenseKind(e, m, k, n, denseCores) == denseKind)
                    LaunchDense(denseKind, denseCores, stream, x, weight, scale, group_list, y,
                                denseWorkspace.Get(denseBytes), (int)e, (int)m, (int)k, (int)n);
                else
                    grouped_gelu_shallow<8, false>
                        <<<blocks, nullptr, stream>>>(x, weight, scale, group_list, y, (int)e, (int)m, (int)k, (int)n);
            }
        }
        return;
    }
    auto vectorFallback=[&](){
        int64_t tasks=m*((n+GroupedGeluVector<>::NC-1)/GroupedGeluVector<>::NC);
        int blocks=(int)std::min(tasks,availableCoreNum);
        if(n<=4) {
            if (k <= 1024) {
                int denseCores = dispatchCores;
                if (denseKind && DenseKind(e, m, k, n, denseCores) == denseKind)
                    LaunchDense(denseKind, denseCores, stream, x, weight, scale, group_list, y,
                                denseWorkspace.Get(denseBytes), (int)e, (int)m, (int)k, (int)n);
                else
                    grouped_gelu_vector<true, true>
                        <<<blocks, nullptr, stream>>>(x, weight, scale, group_list, y, (int)e, (int)m, (int)k, (int)n);
            } else {
                int denseCores = dispatchCores;
                if (denseKind && DenseKind(e, m, k, n, denseCores) == denseKind)
                    LaunchDense(denseKind, denseCores, stream, x, weight, scale, group_list, y,
                                denseWorkspace.Get(denseBytes), (int)e, (int)m, (int)k, (int)n);
                else
                    grouped_gelu_vector<false, true>
                        <<<blocks, nullptr, stream>>>(x, weight, scale, group_list, y, (int)e, (int)m, (int)k, (int)n);
            }
        }else {
            if (k <= 1024) {
                int denseCores = dispatchCores;
                if (denseKind && DenseKind(e, m, k, n, denseCores) == denseKind)
                    LaunchDense(denseKind, denseCores, stream, x, weight, scale, group_list, y,
                                denseWorkspace.Get(denseBytes), (int)e, (int)m, (int)k, (int)n);
                else
                    grouped_gelu_vector<true>
                        <<<blocks, nullptr, stream>>>(x, weight, scale, group_list, y, (int)e, (int)m, (int)k, (int)n);
            } else {
                int denseCores = dispatchCores;
                if (denseKind && DenseKind(e, m, k, n, denseCores) == denseKind)
                    LaunchDense(denseKind, denseCores, stream, x, weight, scale, group_list, y,
                                denseWorkspace.Get(denseBytes), (int)e, (int)m, (int)k, (int)n);
                else
                    grouped_gelu_vector<false>
                        <<<blocks, nullptr, stream>>>(x, weight, scale, group_list, y, (int)e, (int)m, (int)k, (int)n);
            }
        }
    };
    if(e<=8 && m<=16 && k<=32 && n<=32 && m*n<=64 && m*k*n<=256) {
        int blocks=(int)std::min<int64_t>(m,2*availableCoreNum);
        if (k == 1)
            grouped_gelu_tiny_product<<<blocks, nullptr, stream>>>(x, weight, scale, group_list, y, (int)e, (int)m,
                                                                   (int)k, (int)n);
        else
            grouped_gelu_tiny_row_gm<<<blocks, nullptr, stream>>>(x, weight, scale, group_list, y, (int)e, (int)m,
                                                                  (int)k, (int)n);
        return;
    }
    if(e<=8 && m<=16 && k<=32 && n<=32) {
        int blocks=(int)std::min<int64_t>(m,availableCoreNum);
        {
            int denseCores = dispatchCores;
            if (denseKind && DenseKind(e, m, k, n, denseCores) == denseKind)
                LaunchDense(denseKind, denseCores, stream, x, weight, scale, group_list, y,
                            denseWorkspace.Get(denseBytes), (int)e, (int)m, (int)k, (int)n);
            else
                grouped_gelu_tiny_vector_dot<<<blocks, nullptr, stream>>>(x, weight, scale, group_list, y, (int)e,
                                                                          (int)m, (int)k, (int)n);
        }
        return;
    }
    if(m*k*n<=32768){vectorFallback();return;}
    auto platform=platform_ascendc::PlatformAscendCManager::GetInstance();
    int capacityCores=(int)std::min<int64_t>(availableCoreNum,platform->GetCoreNumAic());

    if(n<=8 && k>=32 && k<=256 && n*k<=512 && m>=128*e && m/128>=2*capacityCores) {
        int vectorCores=(int)std::min<int64_t>(2*availableCoreNum,platform->GetCoreNumAiv());
        if (k <= 64) {
            int denseCores = dispatchCores;
            if (denseKind && DenseKind(e, m, k, n, denseCores) == denseKind)
                LaunchDense(denseKind, denseCores, stream, x, weight, scale, group_list, y,
                            denseWorkspace.Get(denseBytes), (int)e, (int)m, (int)k, (int)n);
            else
                grouped_gelu_dot<64>
                    <<<vectorCores, nullptr, stream>>>(x, weight, scale, group_list, y, (int)e, (int)m, (int)k, (int)n);
        } else if (k <= 128) {
            int denseCores = dispatchCores;
            if (denseKind && DenseKind(e, m, k, n, denseCores) == denseKind)
                LaunchDense(denseKind, denseCores, stream, x, weight, scale, group_list, y,
                            denseWorkspace.Get(denseBytes), (int)e, (int)m, (int)k, (int)n);
            else
                grouped_gelu_dot<128>
                    <<<vectorCores, nullptr, stream>>>(x, weight, scale, group_list, y, (int)e, (int)m, (int)k, (int)n);
        } else {
            int denseCores = dispatchCores;
            if (denseKind && DenseKind(e, m, k, n, denseCores) == denseKind)
                LaunchDense(denseKind, denseCores, stream, x, weight, scale, group_list, y,
                            denseWorkspace.Get(denseBytes), (int)e, (int)m, (int)k, (int)n);
            else
                grouped_gelu_dot<256>
                    <<<vectorCores, nullptr, stream>>>(x, weight, scale, group_list, y, (int)e, (int)m, (int)k, (int)n);
        }
        return;
    }
    int64_t splitTaskBound=std::min<int64_t>(m,(m+31)/32+e-1)*((n+127)/128);
    if(k>=2048 && n>=32 && n%32!=0 && splitTaskBound<=capacityCores/2) {
        int limit=(int)std::min<int64_t>(capacityCores/splitTaskBound,k/256);
        int chunk=(int)((k+limit-1)/limit+31)/32*32,splits=(int)((k+chunk-1)/chunk);
        matmul_tiling::MatmulApiTiling splitPlanner(*platform);
        splitPlanner.SetAType(matmul_tiling::TPosition::GM,matmul_tiling::CubeFormat::ND,matmul_tiling::DataType::DT_INT8,false);
        splitPlanner.SetBType(matmul_tiling::TPosition::GM,matmul_tiling::CubeFormat::ND,matmul_tiling::DataType::DT_INT8,false);
        splitPlanner.SetCType(matmul_tiling::TPosition::GM,matmul_tiling::CubeFormat::ND,matmul_tiling::DataType::DT_INT32);
        splitPlanner.SetShape(32,128,chunk);splitPlanner.SetOrgShape((int)m,(int)n,(int)k,(int)k);
        splitPlanner.SetBias(false);splitPlanner.SetBufferSpace(-1,-1,-1);splitPlanner.SetFixSplit(32,128,64);
        optiling::TCubeTiling splitTiling;
        if(splitPlanner.GetTiling(splitTiling)==0) {
