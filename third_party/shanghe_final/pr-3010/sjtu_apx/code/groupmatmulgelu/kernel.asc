            if (denseKind && DenseKind(e, m, k, n, denseCores) == denseKind)
                LaunchDense(denseKind, denseCores, stream, x, weight, scale, group_list, y,
                            denseWorkspace.Get(denseBytes), (int)e, (int)m, (int)k, (int)n);
            else
                grouped_gelu_cube<64, 256, false, false><<<cores, nullptr, stream>>>(
                    x, weight, scale, group_list, y, (GM_ADDR)mem, (GM_ADDR)(mem + tileOffset),
                    (GM_ADDR)(mem + libOffset), (GM_ADDR)(mem + workOffset), PaddedN, PaddedK, (int)e, (int)m, (int)k,
                    (int)n, cores);
        }
    } else if (BN == 64) {
        if (m * n >= 65536) {
            int denseCores = cores;
            if (denseKind && DenseKind(e, m, k, n, denseCores) == denseKind)
                LaunchDense(denseKind, denseCores, stream, x, weight, scale, group_list, y,
                            denseWorkspace.Get(denseBytes), (int)e, (int)m, (int)k, (int)n);
            else
                grouped_gelu_cube<128, 64, false, true><<<cores, nullptr, stream>>>(
                    x, weight, scale, group_list, y, (GM_ADDR)mem, (GM_ADDR)(mem + tileOffset),
                    (GM_ADDR)(mem + libOffset), (GM_ADDR)(mem + workOffset), PaddedN, PaddedK, (int)e, (int)m, (int)k,
                    (int)n, cores);
        } else {
            int denseCores = cores;
            if (denseKind && DenseKind(e, m, k, n, denseCores) == denseKind)
                LaunchDense(denseKind, denseCores, stream, x, weight, scale, group_list, y,
                            denseWorkspace.Get(denseBytes), (int)e, (int)m, (int)k, (int)n);
            else
                grouped_gelu_cube<128, 32, false, true, false, false, false, false, false, false, false, false, true,
                                  true, NativeResidency::StreamAResidentB><<<cores, nullptr, stream>>>(
                    x, weight, scale, group_list, y, (GM_ADDR)mem, (GM_ADDR)(mem + tileOffset),
                    (GM_ADDR)(mem + libOffset), (GM_ADDR)(mem + workOffset), PaddedN, PaddedK, (int)e, (int)m, (int)k,
                    (int)n, cores);
        }
    } else if (BN == 256 && BM == 16) {
        if (m * n >= 65536) {
            int denseCores = cores;
            if (denseKind && DenseKind(e, m, k, n, denseCores) == denseKind)
                LaunchDense(denseKind, denseCores, stream, x, weight, scale, group_list, y,
                            denseWorkspace.Get(denseBytes), (int)e, (int)m, (int)k, (int)n);
            else
                grouped_gelu_cube<16, 256, false, true><<<cores, nullptr, stream>>>(
                    x, weight, scale, group_list, y, (GM_ADDR)mem, (GM_ADDR)(mem + tileOffset),
                    (GM_ADDR)(mem + libOffset), (GM_ADDR)(mem + workOffset), PaddedN, PaddedK, (int)e, (int)m, (int)k,
                    (int)n, cores);
        } else {
            int denseCores = cores;
            if (denseKind && DenseKind(e, m, k, n, denseCores) == denseKind)
                LaunchDense(denseKind, denseCores, stream, x, weight, scale, group_list, y,
                            denseWorkspace.Get(denseBytes), (int)e, (int)m, (int)k, (int)n);
            else
                grouped_gelu_cube<16, 256, false, false><<<cores, nullptr, stream>>>(
                    x, weight, scale, group_list, y, (GM_ADDR)mem, (GM_ADDR)(mem + tileOffset),
                    (GM_ADDR)(mem + libOffset), (GM_ADDR)(mem + workOffset), PaddedN, PaddedK, (int)e, (int)m, (int)k,
                    (int)n, cores);
        }
    } else if (BN == 256) {
        if (m * n >= 65536) {
            int denseCores = cores;
            if (denseKind && DenseKind(e, m, k, n, denseCores) == denseKind)
                LaunchDense(denseKind, denseCores, stream, x, weight, scale, group_list, y,
                            denseWorkspace.Get(denseBytes), (int)e, (int)m, (int)k, (int)n);
            else
                grouped_gelu_cube<32, 256, false, true, false, false, false, false, false, false, false, false, true>
                    <<<cores, nullptr, stream>>>(x, weight, scale, group_list, y, (GM_ADDR)mem,
                                                 (GM_ADDR)(mem + tileOffset), (GM_ADDR)(mem + libOffset),
                                                 (GM_ADDR)(mem + workOffset), PaddedN, PaddedK, (int)e, (int)m, (int)k,
                                                 (int)n, cores);
        } else {
            int denseCores = cores;
            if (denseKind && DenseKind(e, m, k, n, denseCores) == denseKind)
                LaunchDense(denseKind, denseCores, stream, x, weight, scale, group_list, y,
                            denseWorkspace.Get(denseBytes), (int)e, (int)m, (int)k, (int)n);
            else
                grouped_gelu_cube<32, 256, false, false><<<cores, nullptr, stream>>>(
                    x, weight, scale, group_list, y, (GM_ADDR)mem, (GM_ADDR)(mem + tileOffset),
                    (GM_ADDR)(mem + libOffset), (GM_ADDR)(mem + workOffset), PaddedN, PaddedK, (int)e, (int)m, (int)k,
                    (int)n, cores);
        }
    } else if (BM == 64) {
        if (m * n >= 65536) {
            int denseCores = cores;
            if (denseKind && DenseKind(e, m, k, n, denseCores) == denseKind)
                LaunchDense(denseKind, denseCores, stream, x, weight, scale, group_list, y,
                            denseWorkspace.Get(denseBytes), (int)e, (int)m, (int)k, (int)n);
            else
                grouped_gelu_cube<64, 128, false, true><<<cores, nullptr, stream>>>(
                    x, weight, scale, group_list, y, (GM_ADDR)mem, (GM_ADDR)(mem + tileOffset),
                    (GM_ADDR)(mem + libOffset), (GM_ADDR)(mem + workOffset), PaddedN, PaddedK, (int)e, (int)m, (int)k,
                    (int)n, cores);
        } else {
            int denseCores = cores;
            if (denseKind && DenseKind(e, m, k, n, denseCores) == denseKind)
                LaunchDense(denseKind, denseCores, stream, x, weight, scale, group_list, y,
                            denseWorkspace.Get(denseBytes), (int)e, (int)m, (int)k, (int)n);
            else
                grouped_gelu_cube<64, 128, false, false><<<cores, nullptr, stream>>>(
                    x, weight, scale, group_list, y, (GM_ADDR)mem, (GM_ADDR)(mem + tileOffset),
                    (GM_ADDR)(mem + libOffset), (GM_ADDR)(mem + workOffset), PaddedN, PaddedK, (int)e, (int)m, (int)k,
                    (int)n, cores);
        }
    } else {
        if (m * n >= 65536) {
            int denseCores = cores;
            if (denseKind && DenseKind(e, m, k, n, denseCores) == denseKind)
                LaunchDense(denseKind, denseCores, stream, x, weight, scale, group_list, y,
                            denseWorkspace.Get(denseBytes), (int)e, (int)m, (int)k, (int)n);
            else
                grouped_gelu_cube<32, 128, false, true><<<cores, nullptr, stream>>>(
                    x, weight, scale, group_list, y, (GM_ADDR)mem, (GM_ADDR)(mem + tileOffset),
                    (GM_ADDR)(mem + libOffset), (GM_ADDR)(mem + workOffset), PaddedN, PaddedK, (int)e, (int)m, (int)k,
                    (int)n, cores);
        } else if (PaddedK == k && PaddedN == n && !resourceStreaming && !tallStreaming &&
                   ht.get_stepKa() >= allKBlocks && ht.get_stepKb() >= allKBlocks && ht.get_iterateOrder() == 0) {
            if (e == 1 && k <= 256 && ((m + 15) / 16) * ((n + 63) / 64) <= capacityCores) {
                int tileCores = (int)(((m + 15) / 16) * ((n + 63) / 64));
                grouped_gelu_singlewave_tile<<<tileCores, nullptr, stream>>>(x, weight, scale, y, (GM_ADDR)mem, (int)m,
                                                                             (int)k, (int)n);
            } else {
                int tileCores = std::min(cores, (int)(((m + 15) / 16 + e - 1) * ((n + 63) / 64)));
                {
                    int denseCores = tileCores;
                    if (denseKind && DenseKind(e, m, k, n, denseCores) == denseKind)
                        LaunchDense(denseKind, denseCores, stream, x, weight, scale, group_list, y,
                                    denseWorkspace.Get(denseBytes), (int)e, (int)m, (int)k, (int)n);
                    else
                        grouped_gelu_resident_tile<<<tileCores, nullptr, stream>>>(
                            x, weight, scale, group_list, y, (GM_ADDR)mem, (int)e, (int)m, (int)k, (int)n, tileCores);
                }
            }
        } else {
            int denseCores = cores;
            if (denseKind && DenseKind(e, m, k, n, denseCores) == denseKind)
                LaunchDense(denseKind, denseCores, stream, x, weight, scale, group_list, y,
                            denseWorkspace.Get(denseBytes), (int)e, (int)m, (int)k, (int)n);
            else
                grouped_gelu_cube<32, 128, false, false><<<cores, nullptr, stream>>>(
                    x, weight, scale, group_list, y, (GM_ADDR)mem, (GM_ADDR)(mem + tileOffset),
                    (GM_ADDR)(mem + libOffset), (GM_ADDR)(mem + workOffset), PaddedN, PaddedK, (int)e, (int)m, (int)k,
                    (int)n, cores);
        }
    }
    status=aclrtSynchronizeStream(stream);aclrtFree(allocation);
    if(status!=0)throw std::runtime_error("kernel failed");
}
