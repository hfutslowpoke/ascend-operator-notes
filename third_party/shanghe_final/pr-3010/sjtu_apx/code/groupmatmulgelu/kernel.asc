            }
        }else {
        auto indices=CACHED?cached:tmp.ReinterpretCast<int32_t>();
        if constexpr(!CACHED) {
        for(int i=0;i<8;++i)indices.SetValue(i,i);
        SetFlag<HardEvent::S_V>(EVENT_ID0);WaitFlag<HardEvent::S_V>(EVENT_ID0);
        for(int span=8;span<count;span*=2) {
            int length=count-span<span?count-span:span;
            Adds(indices[span],indices,(int32_t)span,length);PipeBarrier<PIPE_V>();
        }
        }
        auto selected=a.ReinterpretCast<int32_t>();uint64_t selectedCount=0;
        GatherMask(selected,indices,mask.ReinterpretCast<uint32_t>(),true,(uint32_t)count,GatherMaskParams{1,1,8,0},selectedCount);
        PipeBarrier<PIPE_ALL>();
        for(uint64_t i=0;i<selectedCount;++i) {
            int j=selected.GetValue(i);
            if(j<count) {
                float value=z.GetValue(j);
                if(value> -8.0f&&value<8.0f)out.SetValue(j,SHARED_REPAIR?ScalarGeluRepair(value):(COMPLEMENT_ROUND?ComplementGeluRounded(value):GeluRounded(value)));
            }
        }
        }
    }else {
    auto flags=mask.ReinterpretCast<uint64_t>();
    for(int chunk=0;chunk<(count+63)/64;++chunk) {
        uint64_t f=flags.GetValue(chunk);
        for(int bit=0;f;f>>=1,++bit) if(f&1) {
            int j=chunk*64+bit;
            if(j<count) {
                float value=z.GetValue(j);
                if(value> -8.0f&&value<8.0f) out.SetValue(j,SHARED_REPAIR?ScalarGeluRepair(value):(COMPLEMENT_ROUND?ComplementGeluRounded(value):GeluRounded(value)));
            }
        }
    }
    }
    PipeBarrier<PIPE_ALL>();
}

__aicore__ inline void DenseFloatGelu(LocalTensor<float> z,LocalTensor<float> a,LocalTensor<float> b,LocalTensor<float> out,LocalTensor<float> tmp,LocalTensor<uint8_t> mask,LocalTensor<uint8_t> m1,LocalTensor<uint8_t> m2,int count) {
    Mul(a,z,z,count);PipeBarrier<PIPE_V>();
    Muls(a,a,0.044715f,count);PipeBarrier<PIPE_V>();
    Adds(a,a,1.0f,count);PipeBarrier<PIPE_V>();
    Mul(a,a,z,count);PipeBarrier<PIPE_V>();
    
        Muls(a,a,-1.5957691216057308f,count);PipeBarrier<PIPE_V>();
        Mins(a,a,80.0f,count);PipeBarrier<PIPE_V>();
        Exp(b,a,count);PipeBarrier<PIPE_V>();
        Adds(a,b,1.0f,count);PipeBarrier<PIPE_V>();
        Div(out,z,a,count);PipeBarrier<PIPE_V>();
    
    
        Abs(a,out,count);PipeBarrier<PIPE_V>();
        CompareScalar(m2,a,0.0001220703125f,CMPMODE::LT,count);PipeBarrier<PIPE_V>();
        Muls(a,a,5.9604644775390625e-7f,count);PipeBarrier<PIPE_V>();
        Maxs(a,a,2.9103830456733704e-10f,count);PipeBarrier<PIPE_V>();
        Sub(b,out,a,count);PipeBarrier<PIPE_V>();
        
        Add(a,out,a,count);PipeBarrier<PIPE_V>();
        Cast(tmp.ReinterpretCast<half>(),b,RoundMode::CAST_RINT,count);PipeBarrier<PIPE_V>();
        Cast(b.ReinterpretCast<half>(),a,RoundMode::CAST_RINT,count);PipeBarrier<PIPE_V>();
        Compare(mask,tmp.ReinterpretCast<half>(),b.ReinterpretCast<half>(),CMPMODE::NE,(count+127)/128*128);PipeBarrier<PIPE_V>();
        
        CompareScalar(m1,z,2.0f,CMPMODE::GE,count);PipeBarrier<PIPE_V>();
        Or(m1.ReinterpretCast<uint16_t>(),m1.ReinterpretCast<uint16_t>(),m2.ReinterpretCast<uint16_t>(),(count+15)/16);PipeBarrier<PIPE_V>();
        And(mask.ReinterpretCast<uint16_t>(),mask.ReinterpretCast<uint16_t>(),m1.ReinterpretCast<uint16_t>(),(count+15)/16);PipeBarrier<PIPE_V>();
    
}

__aicore__ inline void DenseHalfGelu(LocalTensor<float> z,LocalTensor<float> a,LocalTensor<float> b,LocalTensor<half> output,LocalTensor<half> tmp,LocalTensor<uint8_t> mask,LocalTensor<uint8_t> m1,LocalTensor<uint8_t> m2,int count) {
