        Cast(a.ReinterpretCast<half>(),b,RoundMode::CAST_RINT,count);PipeBarrier<PIPE_V>();
        Cast(b.ReinterpretCast<half>(),tmp,RoundMode::CAST_RINT,count);PipeBarrier<PIPE_V>();
