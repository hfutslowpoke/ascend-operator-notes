    Muls(a,a,-1.5957691216057308f,count);PipeBarrier<PIPE_V>();
    Mins(a,a,80.0f,count);PipeBarrier<PIPE_V>();
    Exp(b,a,count);PipeBarrier<PIPE_V>();
    Adds(a,b,1.0f,count);PipeBarrier<PIPE_V>();
    Div(b,z,a,count);PipeBarrier<PIPE_V>();
    Cast(output,b,RoundMode::CAST_RINT,count);PipeBarrier<PIPE_V>();
    Abs(a,b,count);PipeBarrier<PIPE_V>();
    CompareScalar(m2,a,0.0001220703125f,CMPMODE::LT,count);PipeBarrier<PIPE_V>();
    Muls(a,a,8.94069671630859375e-7f,count);PipeBarrier<PIPE_V>();
    Maxs(a,a,4.3655745685100555e-10f,count);PipeBarrier<PIPE_V>();
    Sub(a,b,a,count);PipeBarrier<PIPE_V>();
    Cast(tmp,a,RoundMode::CAST_RINT,count);PipeBarrier<PIPE_V>();
    Muls(a,a,-1.0f,count);PipeBarrier<PIPE_V>();
    Axpy(a,b,2.0f,count);PipeBarrier<PIPE_V>();
    Cast(a.ReinterpretCast<half>(),a,RoundMode::CAST_RINT,count);PipeBarrier<PIPE_V>();
    Compare(mask,tmp,a.ReinterpretCast<half>(),CMPMODE::NE,(count+127)/128*128);PipeBarrier<PIPE_V>();
    CompareScalar(m1,z,2.0f,CMPMODE::GE,count);PipeBarrier<PIPE_V>();
    Or(m1.ReinterpretCast<uint16_t>(),m1.ReinterpretCast<uint16_t>(),m2.ReinterpretCast<uint16_t>(),(count+15)/16);PipeBarrier<PIPE_V>();
    And(mask.ReinterpretCast<uint16_t>(),mask.ReinterpretCast<uint16_t>(),m1.ReinterpretCast<uint16_t>(),(count+15)/16);PipeBarrier<PIPE_V>();
}

__aicore__ inline void NormalizedMidpointGelu(LocalTensor<float> z, LocalTensor<float> a, LocalTensor<float> b,
                                              LocalTensor<half> output, LocalTensor<half> tmp,
                                              LocalTensor<uint8_t> mask, LocalTensor<uint8_t> m1,
                                              LocalTensor<uint8_t> m2, int count) {
    Mul(a,z,z,count);PipeBarrier<PIPE_V>();
    Muls(a,a,0.044715f,count);PipeBarrier<PIPE_V>();
    Adds(a,a,1.0f,count);PipeBarrier<PIPE_V>();
    Mul(a,a,z,count);PipeBarrier<PIPE_V>();
    Muls(a,a,-1.5957691216057308f,count);PipeBarrier<PIPE_V>();
    Mins(a,a,80.0f,count);PipeBarrier<PIPE_V>();
    Exp(b,a,count);PipeBarrier<PIPE_V>();
    Adds(a,b,1.0f,count);PipeBarrier<PIPE_V>();
    Div(b,z,a,count);PipeBarrier<PIPE_V>();
    Cast(output,b,RoundMode::CAST_RINT,count);PipeBarrier<PIPE_V>();
    Abs(a,b,count);PipeBarrier<PIPE_V>();
    CompareScalar(m2,a,0.0001220703125f,CMPMODE::LT,count);PipeBarrier<PIPE_V>();
    Maxs(b,a,0.00006103515625f,count);PipeBarrier<PIPE_V>();
    Add(a,a,b,count);PipeBarrier<PIPE_V>();
    Adds(a.ReinterpretCast<int32_t>(),a.ReinterpretCast<int32_t>(),(int32_t)64,count);PipeBarrier<PIPE_V>();
    Duplicate(b.ReinterpretCast<int32_t>(),(int32_t)8064,count);PipeBarrier<PIPE_V>();
    And(a.ReinterpretCast<uint16_t>(),a.ReinterpretCast<uint16_t>(),b.ReinterpretCast<uint16_t>(),count*2);PipeBarrier<PIPE_V>();
    CompareScalar(mask,a.ReinterpretCast<int32_t>(),(int32_t)4096,CMPMODE::EQ,count);PipeBarrier<PIPE_V>();
    CompareScalar(m1,z,2.0f,CMPMODE::GE,count);PipeBarrier<PIPE_V>();
    Or(m1.ReinterpretCast<uint16_t>(),m1.ReinterpretCast<uint16_t>(),m2.ReinterpretCast<uint16_t>(),(count+15)/16);PipeBarrier<PIPE_V>();
    And(mask.ReinterpretCast<uint16_t>(),mask.ReinterpretCast<uint16_t>(),m1.ReinterpretCast<uint16_t>(),(count+15)/16);PipeBarrier<PIPE_V>();
}
__aicore__ inline float MidpointGeluRounded(float z) {
#pragma clang fp reassociate(off) contract(off)
    float az=z>=0.0f?z:-z;
    if(az<0.03125f)return AccurateGeluRounded(z);
    union Bits {float f;uint32_t u;} input,result,unit,power;input.f=az;
    if(z>=5.25f) {
        if(input.u<0x40e2dbe6u && (input.u&8191u)==4096u)--input.u;
        return input.f;
    }
    uint64_t x=uint64_t((input.u&0x7fffffu)|0x800000u)<<(((input.u>>23)&255)-122);
    uint64_t square=(x*x+(1ULL<<29))>>30;
    uint64_t term=(square*3072791402ULL+(1ULL<<31))>>32;
    uint64_t cubic=(x*(term+(1ULL<<30))+(1ULL<<25))>>26;
    uint64_t expHigh=((cubic>>32)*1713444047ULL)<<2;
    uint64_t expLow=(((cubic&0xffffffffULL)*1713444047ULL)+(1ULL<<29))>>30;
    int64_t exponent=(int64_t)(expHigh+expLow);
    int64_t sh=-(exponent+1488522236LL)/2977044472LL;
    int64_t r=(-exponent-sh*2977044472LL+1)>>1;
    int64_t t=592;
    t=((t*r+(1LL<<30))>>31)+5918LL;
    t=((t*r+(1LL<<30))>>31)+53261LL;
    t=((t*r+(1LL<<30))>>31)+426088LL;
    t=((t*r+(1LL<<30))>>31)+2982616LL;
    t=((t*r+(1LL<<30))>>31)+17895697LL;
    t=((t*r+(1LL<<30))>>31)+89478485LL;
    t=((t*r+(1LL<<30))>>31)+357913941LL;
    t=((t*r+(1LL<<30))>>31)+1073741824LL;
    t=((t*r+(1LL<<30))>>31)+2147483648LL;
    t=((t*r+(1LL<<30))>>31)+2147483648LL;
    power.u=(uint32_t)(sh-30+127)<<23;
    float e=(float)(int32_t)(t>>1)*power.f;
    float d=(az*e)/(1.0f+e),low=0.0f;
    if(z>=0.0f){result.f=z-d;low=(z-result.f)-d;}else result.f=-d;
    int exponentY=(result.u>>23)&255,shift=exponentY>=113?13:126-exponentY;
    if(shift<=0 || shift>=25)return result.f;
    uint32_t mant=(result.u&0x7fffffu)|0x800000u;
    int32_t rem=(int32_t)(mant&((1u<<shift)-1u)),mid=1u<<(shift-1);
    unit.u=(uint32_t)(exponentY-23)<<23;
    float distance=(float)(rem-mid)*unit.f+(result.f>=0.0f?low:-low);
    float absolute=distance>=0.0f?distance:-distance;
    if(absolute<=2.0e-7f*d)return AccurateGeluRounded(z);
    if(rem==mid && low!=0.0f)result.u=((low>0.0f)==(result.f>0.0f))?result.u+1:result.u-1;
    return result.f;
}

__aicore__ inline void HalfSummaryRepairGelu(LocalTensor<float> z,LocalTensor<half> out,LocalTensor<uint8_t> mask,LocalTensor<uint8_t> summary,int count) {
    auto blocks=summary.ReinterpretCast<uint64_t>();auto words=mask.ReinterpretCast<uint16_t>();
    int wordCount=(count+15)/16;
    for(int block=0;block<(wordCount+63)/64;++block) {
        uint64_t selected=blocks.GetValue(block);
        while(selected) {
            int word=block*64+(int)GetSFFValue<1>(selected);selected&=selected-1;
            if(word<wordCount) {
                uint64_t flags=words.GetValue(word);
                while(flags) {
                    int j=word*16+(int)GetSFFValue<1>(flags);flags&=flags-1;
                    if(j<count) {
                        float value=z.GetValue(j);
                        if(value> -8.0f && value<8.0f)out.SetValue(j,(half)MidpointGeluRounded(value));
                    }
                }
            }
        }
    }
}

__aicore__ inline void HalfMidpointRepairGelu(LocalTensor<float> z,LocalTensor<half> out,LocalTensor<uint8_t> mask,LocalTensor<uint8_t> summary,int count) {
    auto blocks=summary.ReinterpretCast<uint64_t>();auto words=mask.ReinterpretCast<uint16_t>();
    int wordCount=(count+15)/16;
    for(int block=0;block<(wordCount+63)/64;++block) {
        uint64_t selected=blocks.GetValue(block);
        while(selected) {
            int word=block*64+(int)GetSFFValue<1>(selected);selected&=selected-1;
            if(word<wordCount) {
                uint64_t flags=words.GetValue(word);
                while(flags) {
                    int j=word*16+(int)GetSFFValue<1>(flags);flags&=flags-1;
                    if(j<count) {
                        float value=z.GetValue(j);
                        if(value> -8.0f && value<8.0f)out.SetValue(j,(half)MidpointGeluRounded(value));
                    }
                }
            }
        }
    }
}



__aicore__ inline void QueueRepairIndices(LocalTensor<int16_t> selected,LocalTensor<int16_t> indices,LocalTensor<uint8_t> mask,int count) {
    SetMaskCount();SetVectorMask<int16_t,MaskMode::COUNTER>(0,count);
    vreducev2((__ubuf__ uint16_t*)selected.GetPhyAddr(),(__ubuf__ uint16_t*)indices.GetPhyAddr(),(__ubuf__ uint16_t*)mask.GetPhyAddr(),1,1,0,8,0);
    SetMaskNorm();ResetMask();
}
__aicore__ inline void IndexedRepairGelu(LocalTensor<float> z,LocalTensor<float> out,LocalTensor<int16_t> selected,uint64_t count) {
    for(uint64_t i=0;i<count;++i) {
        int j=selected.GetValue(i);
        float value=z.GetValue(j);
        if(value> -8.0f && value<8.0f)out.SetValue(j,ComplementGeluRounded(value));
    }
}

template<bool FLOAT_ACC=false,bool SCALAR_GELU=false,int COLUMN_TILE=256>
class GroupedGeluVector {
public:
    static constexpr int NC = COLUMN_TILE;
    static constexpr int KC = 32;
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR w, GM_ADDR scale, GM_ADDR groups,
                               GM_ADDR y, int e, int m, int k, int n) {
        E=e; M=m; K=k; N=n;
        xg.SetGlobalBuffer((__gm__ int8_t*)x);
        wg.SetGlobalBuffer((__gm__ int8_t*)w);
        sg.SetGlobalBuffer((__gm__ float*)scale);
        gg.SetGlobalBuffer((__gm__ int64_t*)groups);
        yg.SetGlobalBuffer((__gm__ half*)y);
        pipe.InitBuffer(groupsBuf,128*sizeof(int64_t));
        pipe.InitBuffer(xBuf,KC);
        pipe.InitBuffer(wBuf,KC*NC);
        pipe.InitBuffer(halfBuf,KC*NC*sizeof(half));
        pipe.InitBuffer(floatBuf,KC*NC*sizeof(float));
        pipe.InitBuffer(accBuf,NC*sizeof(int32_t));
        pipe.InitBuffer(prodBuf,NC*sizeof(float));
        pipe.InitBuffer(intBuf,NC*sizeof(int32_t));
        pipe.InitBuffer(scaleBuf,NC*sizeof(float));
        pipe.InitBuffer(zBuf,NC*sizeof(float));
        pipe.InitBuffer(uBuf,NC*sizeof(float));
        pipe.InitBuffer(tBuf,NC*sizeof(float));
        pipe.InitBuffer(outBuf,NC*sizeof(half));
        if constexpr(!SCALAR_GELU){pipe.InitBuffer(maskBuf,32);pipe.InitBuffer(m1Buf,32);pipe.InitBuffer(m2Buf,32);}
    }

    __aicore__ inline void Process() {
        auto ends=groupsBuf.Get<int64_t>();
        auto ax=xBuf.Get<int8_t>(); auto wb=wBuf.Get<int8_t>();
        auto wh=halfBuf.Get<half>(); auto wf=floatBuf.Get<float>();
        auto acc=accBuf.Get<int32_t>(); auto prod=prodBuf.Get<float>();
        auto ip=intBuf.Get<int32_t>(); auto scales=scaleBuf.Get<float>();
        auto z=zBuf.Get<float>(); auto u=uBuf.Get<float>(); auto t=tBuf.Get<float>();
        auto out=outBuf.Get<half>();
        DataCopyPad(ends,gg,DataCopyExtParams{1,(uint32_t)(E*8),0,0,0},DataCopyPadExtParams<int64_t>{false,0,0,0});
        PipeBarrier<PIPE_ALL>();
        int columns=(N+NC-1)/NC;
        int64_t tasks=(int64_t)M*columns;
        for(int64_t task=GetBlockIdx(); task<tasks; task+=GetBlockNum()) {
            int row=task/columns;
            int n0=(task%columns)*NC;
            int count=N-n0<NC?N-n0:NC;
            int stride=(count+31)/32*32;
            int expert=0;
            while(expert<E && row>=ends.GetValue(expert)) ++expert;
            
            Duplicate(acc,(int32_t)0,NC);
            PipeBarrier<PIPE_ALL>();
            for(int k0=0;k0<K;k0+=KC) {
                int kk=K-k0<KC?K-k0:KC;
                DataCopyPad(ax,xg[(int64_t)row*K+k0],DataCopyExtParams{1,(uint32_t)kk,0,0,0},DataCopyPadExtParams<int8_t>{false,0,0,0});
                DataCopyPad(wb,wg[((int64_t)expert*K+k0)*N+n0],
                            DataCopyExtParams{(uint16_t)kk,(uint32_t)count,(uint32_t)(N-count),0,0},
                            DataCopyPadExtParams<int8_t>{false,0,0,0});
                PipeBarrier<PIPE_ALL>();
                Cast(wh,wb,RoundMode::CAST_NONE,kk*stride);
                PipeBarrier<PIPE_V>();
                Cast(wf,wh,RoundMode::CAST_NONE,kk*stride);
                PipeBarrier<PIPE_ALL>();
                for(int j=0;j<kk;++j) {
                    float xv=(float)ax.GetValue(j);
                    Muls(prod,wf[j*stride],xv,count);
                    PipeBarrier<PIPE_V>();
                    if constexpr(FLOAT_ACC) {
                        Add(acc.ReinterpretCast<float>(),acc.ReinterpretCast<float>(),prod,count);
                    }else {
                        Cast(ip,prod,RoundMode::CAST_RINT,count);
                        PipeBarrier<PIPE_V>();
                        Add(acc,acc,ip,count);
                    }
                    PipeBarrier<PIPE_V>();
                }
                PipeBarrier<PIPE_ALL>();
            }
            DataCopyPad(scales,sg[(int64_t)expert*N+n0],DataCopyExtParams{1,(uint32_t)(count*4),0,0,0},DataCopyPadExtParams<float>{false,0,0,0});
            PipeBarrier<PIPE_ALL>();
            if constexpr(!SCALAR_GELU){Duplicate(z,0.0f,NC);PipeBarrier<PIPE_V>();}
            if constexpr(FLOAT_ACC)Adds(z,acc.ReinterpretCast<float>(),0.0f,count);
            else Cast(z,acc,RoundMode::CAST_RINT,count);
            PipeBarrier<PIPE_V>();
            Mul(z,z,scales,count);
            PipeBarrier<PIPE_V>();
            PipeBarrier<PIPE_ALL>();
            if constexpr(SCALAR_GELU){for(int j=0;j<count;++j)prod.SetValue(j,ShortGeluRounded(z.GetValue(j)));}
            else GeluVector(z,u,t,prod,floatBuf.Get<float>(),maskBuf.Get<uint8_t>(),m1Buf.Get<uint8_t>(),m2Buf.Get<uint8_t>(),(count+63)/64*64);
            PipeBarrier<PIPE_ALL>();
            Cast(out,prod,RoundMode::CAST_RINT,count);
            PipeBarrier<PIPE_ALL>();
            
            
            DataCopyPad(yg[(int64_t)row*N+n0],out,DataCopyExtParams{1,(uint32_t)(count*2),0,0,0});
            PipeBarrier<PIPE_ALL>();
        }
    }
private:
    int E,M,K,N;
    TPipe pipe;
    GlobalTensor<int8_t> xg,wg;
    GlobalTensor<float> sg;
    GlobalTensor<int64_t> gg;
    GlobalTensor<half> yg;
    TBuf<TPosition::VECCALC> groupsBuf,xBuf,wBuf,halfBuf,floatBuf,accBuf,prodBuf,intBuf,scaleBuf,zBuf,uBuf,tBuf,outBuf,maskBuf,m1Buf,m2Buf;
};

template<bool FLOAT_ACC,bool SCALAR_GELU=false,int COLUMN_TILE=256>
__global__ __aicore__ void grouped_gelu_vector(GM_ADDR x,GM_ADDR w,GM_ADDR scale,GM_ADDR groups,
                                             GM_ADDR y,int e,int m,int k,int n) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    GroupedGeluVector<FLOAT_ACC,SCALAR_GELU,COLUMN_TILE> op;
    op.Init(x,w,scale,groups,y,e,m,k,n);
    op.Process();
}


constexpr MatmulConfig GMM_CFG=GetMDLConfig(false,false,0,false,false,false,true);

template<int KP>
__global__ __aicore__ void grouped_gelu_dot(GM_ADDR x,GM_ADDR weight,GM_ADDR scale,GM_ADDR groups,
    GM_ADDR y,int E,int M,int K,int N) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    constexpr int BM=KP<=256?32:(KP==512?16:8),XS=BM*KP,S=KP/64,OS=BM*8;
    TPipe pipe;
    TBuf<TPosition::VECCALC> gb,xrb,xhb,xfb,pb,wrb,wfb,wcb,wib,cb,rb,oib,sb,zb,ab,bb,ob,tb,hb,mb,m1b,m2b;
    pipe.InitBuffer(gb,1024);pipe.InitBuffer(xrb,XS);pipe.InitBuffer(xhb,(XS>KP*8?XS:KP*8)*2);
    pipe.InitBuffer(xfb,XS*4);pipe.InitBuffer(pb,XS*4);pipe.InitBuffer(wrb,KP*8);pipe.InitBuffer(wfb,KP*8*4);
    pipe.InitBuffer(wcb,KP*4);pipe.InitBuffer(wib,KP*4);pipe.InitBuffer(cb,OS*4);pipe.InitBuffer(rb,BM*(S<8?8:S)*4);
    pipe.InitBuffer(oib,OS*4);pipe.InitBuffer(sb,32);pipe.InitBuffer(zb,OS*4);pipe.InitBuffer(ab,OS*4);
    pipe.InitBuffer(bb,OS*4);pipe.InitBuffer(ob,OS*4);pipe.InitBuffer(tb,OS*4);pipe.InitBuffer(hb,OS*2);
    pipe.InitBuffer(mb,32);pipe.InitBuffer(m1b,32);pipe.InitBuffer(m2b,32);
    auto ends=gb.Get<int64_t>();auto xr=xrb.Get<int8_t>();auto xh=xhb.Get<half>();auto xf=xfb.Get<float>();auto prod=pb.Get<float>();
    auto wr=wrb.Get<int8_t>();auto wf=wfb.Get<float>();auto wc=wcb.Get<float>();auto wi=wib.Get<int32_t>();
    auto column=cb.Get<float>();auto partial=rb.Get<float>();auto oi=oib.Get<uint32_t>();auto scales=sb.Get<float>();
    auto z=zb.Get<float>();auto a=ab.Get<float>();auto b=bb.Get<float>();auto out=ob.Get<float>();auto tmp=tb.Get<float>();auto halfOut=hb.Get<half>();
    GlobalTensor<int8_t> xg,wg;GlobalTensor<float> sg;GlobalTensor<half> yg;GlobalTensor<int64_t> gg;
    xg.SetGlobalBuffer((__gm__ int8_t*)x);wg.SetGlobalBuffer((__gm__ int8_t*)weight);sg.SetGlobalBuffer((__gm__ float*)scale);
    yg.SetGlobalBuffer((__gm__ half*)y);gg.SetGlobalBuffer((__gm__ int64_t*)groups);
    DataCopyPad(ends,gg,DataCopyExtParams{1,(uint32_t)(E*8),0,0,0},DataCopyPadExtParams<int64_t>{false,0,0,0});
    SetFlag<HardEvent::MTE2_S>(EVENT_ID0);WaitFlag<HardEvent::MTE2_S>(EVENT_ID0);
    for(int i=0;i<8;++i)wi.SetValue(i,i*N*4);
    for(int i=0;i<OS;++i)oi.SetValue(i,i<BM*N?(uint32_t)(((i%N)*BM+i/N)*4):0);
    SetFlag<HardEvent::S_V>(EVENT_ID0);WaitFlag<HardEvent::S_V>(EVENT_ID0);
    for(int span=8;span<KP;span*=2){Adds(wi[span],wi,(int32_t)(span*N*4),span);PipeBarrier<PIPE_V>();}
    int task=GetBlockIdx(),offset=0,start=0;
    for(int e=0;e<E;++e) {
        int end=(int)ends.GetValue(e),length=end-start,tiles=(length+BM-1)/BM;
        if(task<offset+tiles) {
            Duplicate(wr.ReinterpretCast<int32_t>(),(int32_t)0,KP*N/4);PipeBarrier<PIPE_ALL>();
            DataCopyPad(wr,wg[(int64_t)e*K*N],DataCopyExtParams{1,(uint32_t)(K*N),0,0,0},DataCopyPadExtParams<int8_t>{false,0,0,0});
            DataCopyPad(scales,sg[(int64_t)e*N],DataCopyExtParams{1,(uint32_t)(N*4),0,0,0},DataCopyPadExtParams<float>{false,0,0,0});
            PipeBarrier<PIPE_ALL>();Cast(xh,wr,RoundMode::CAST_NONE,KP*N);PipeBarrier<PIPE_V>();Cast(wf,xh,RoundMode::CAST_NONE,KP*N);PipeBarrier<PIPE_ALL>();
            while(task<offset+tiles) {
                int row=(task-offset)*BM,rows=length-row<BM?length-row:BM;
                Duplicate(xr.ReinterpretCast<int32_t>(),(int32_t)0,rows*KP/4);PipeBarrier<PIPE_ALL>();
                DataCopyPad(xr,xg[(int64_t)(start+row)*K],DataCopyExtParams{(uint16_t)rows,(uint32_t)K,0,(uint32_t)((KP-(K+31)/32*32)/32),0},DataCopyPadExtParams<int8_t>{true,0,(uint8_t)((32-K%32)%32),0});
                PipeBarrier<PIPE_ALL>();Cast(xh,xr,RoundMode::CAST_NONE,rows*KP);PipeBarrier<PIPE_V>();Cast(xf,xh,RoundMode::CAST_NONE,rows*KP);PipeBarrier<PIPE_V>();
                Duplicate(column,0.0f,OS);PipeBarrier<PIPE_V>();
                for(int c=0;c<N;++c) {
                    Gather(wc,wf,wi.ReinterpretCast<uint32_t>(),(uint32_t)(c*4),(uint32_t)KP);PipeBarrier<PIPE_V>();
                    for(int q=0;q<S;++q)Mul(prod[q*64],xf[q*64],wc[q*64],(uint64_t)64,(uint8_t)rows,BinaryRepeatParams{1,1,1,(uint8_t)(KP/8),(uint8_t)(KP/8),0});
                    PipeBarrier<PIPE_V>();
                    if constexpr(S==1)WholeReduceSum(column[c*BM],prod,64,rows,1,1,8);
                    else {
                        WholeReduceSum(partial,prod,64,rows*S,S<8?8/S:1,1,8);PipeBarrier<PIPE_V>();
                        if constexpr(S==2){uint64_t bits[2]={0x11ULL,0};WholeReduceSum(column[c*BM],partial,bits,rows,1,1,1);}
                        else if constexpr(S==4){uint64_t bits[2]={0x55ULL,0};WholeReduceSum(column[c*BM],partial,bits,rows,1,1,1);}
                        else WholeReduceSum(column[c*BM],partial,S,rows,1,1,S/8);
                    }
                    PipeBarrier<PIPE_V>();Muls(column[c*BM],column[c*BM],scales.GetValue(c),rows);PipeBarrier<PIPE_V>();
                }
                int count=(rows*N+63)/64*64;
                Gather(z,column,oi,(uint32_t)0,(uint32_t)count);PipeBarrier<PIPE_V>();
                GeluVector(z,a,b,out,tmp,mb.Get<uint8_t>(),m1b.Get<uint8_t>(),m2b.Get<uint8_t>(),count);
                Cast(halfOut,out,RoundMode::CAST_RINT,count);PipeBarrier<PIPE_ALL>();
                DataCopyPad(yg[(int64_t)(start+row)*N],halfOut,DataCopyExtParams{1,(uint32_t)(rows*N*2),0,0,0});PipeBarrier<PIPE_ALL>();
                task+=GetBlockNum();
            }
        }
        offset+=tiles;start=end;
    }
}

struct ColumnTaskCursor {
    int64_t total,base;
    int expert,begin,end,columns,wave,core,cores;
    template<class Ends>
    __aicore__ inline void Init(Ends ends,int E,int N,int coreIndex,int coreCount) {
        columns=(N+255)/256;core=coreIndex;cores=coreCount;
        int previous=0;total=0;
        for(int e=0;e<E;++e) {
            int next=(int)ends.GetValue(e);
            total+=(int64_t)((next-previous+127)/128)*columns;
            previous=next;
        }
        base=0;expert=0;begin=0;end=E>0?(int)ends.GetValue(0):0;wave=0;
    }
    template<class Ends>
    __aicore__ inline bool Next(Ends ends,int E,int N,int& e,int& globalRow,int& col,int& rows,int& cols) {
        while((int64_t)wave*cores<total) {
            int remaining=total-(int64_t)wave*cores<cores?(int)(total-(int64_t)wave*cores):cores;
            int lanes=1;
            while(lanes*remaining*2<=cores)lanes*=2;
            if(core>=remaining*lanes){++wave;continue;}
            int parent=core/lanes,lane=core%lanes;
            int64_t target=(int64_t)wave*cores+parent;++wave;
            while(expert<E && target>=base+(int64_t)((end-begin+127)/128)*columns) {
                base+=(int64_t)((end-begin+127)/128)*columns;
                begin=end;++expert;
                if(expert<E)end=(int)ends.GetValue(expert);
            }
            if(expert>=E)return false;
            int64_t local=target-base;
            int row=(int)(local/columns)*128,parentCol=(int)(local%columns)*256;
            int parentCols=N-parentCol<256?N-parentCol:256,units=(parentCols+31)/32;
            int unitBegin=units*lane/lanes,unitEnd=units*(lane+1)/lanes;
            if(unitBegin==unitEnd)continue;
            e=expert;globalRow=begin+row;col=parentCol+unitBegin*32;
            rows=end-globalRow<128?end-globalRow:128;
            cols=parentCols-unitBegin*32<(unitEnd-unitBegin)*32?parentCols-unitBegin*32:(unitEnd-unitBegin)*32;
            return true;
        }
        return false;
    }
};

enum class CubePipeline { None, StreamBQueuedRepair, ResidentBHalfOutput, ResidentABHalfOutput, StreamBHalfOutput, StreamBColumnCursor };
enum class NativeResidency { Automatic, FullAB, ResidentAStreamB, StreamAResidentB
};

template <int BM, int BN, bool COLUMN_ORDER = false, bool COMPACT = false, bool PACK_NZ = false, bool PACK_A_NZ = false,
          bool CACHE_INDEX = PACK_NZ, bool LARGE_PACK = false, bool NATIVE_TALL = false, bool NATIVE_SEGMENT = false,
          bool NATIVE_REUSE = false, bool HYBRID_ND = false, bool NATIVE_ND = false, bool TAIL_PACK = true,
          NativeResidency RESIDENCY = NativeResidency::Automatic, CubePipeline PIPELINE = CubePipeline::None,
          bool WIDE_PACK = false>
__global__ __aicore__ void grouped_gelu_cube(GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groups, GM_ADDR y,
                                             GM_ADDR partial, GM_ADDR tilingGM, GM_ADDR workspace, GM_ADDR packedWeight,
                                             int PaddedN, int PaddedK, int E, int M, int K, int N, int cores,
                                             GM_ADDR ndTiling = nullptr) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
    constexpr bool DOUBLE_RESULT=BM==64 && BN==512 && PACK_NZ && !PACK_A_NZ && CACHE_INDEX && !LARGE_PACK && !NATIVE_TALL && !NATIVE_SEGMENT && !NATIVE_REUSE && !HYBRID_ND && !NATIVE_ND && !WIDE_PACK;
    constexpr bool LARGEST_PARENT=BM==128 && BN==128 && !COLUMN_ORDER && COMPACT && PACK_NZ && !PACK_A_NZ && CACHE_INDEX && !LARGE_PACK && !NATIVE_TALL && !NATIVE_SEGMENT && NATIVE_REUSE && !HYBRID_ND && !NATIVE_ND && TAIL_PACK;
    TPipe pipe;
    constexpr int PACK_SIZE=WIDE_PACK?131072:(BM*BN>16384?32768:65536);
    constexpr bool PHASE_PACK=LARGE_PACK && PACK_NZ && !PACK_A_NZ && BM==128 && BN==256;
    constexpr bool PIPELINED_PACK=PACK_NZ && !WIDE_PACK && ((BM==128 && BN==256 && LARGE_PACK && !NATIVE_SEGMENT) || (BM==256 && BN==128 && !NATIVE_TALL && !NATIVE_SEGMENT) || (BM==64 && BN==512) || PACK_A_NZ);
    int paddedM=(M+30)/16*16;
    GM_ADDR packedInput=packedWeight+(int64_t)E*((K+15)/16*16)*PaddedN;
    GlobalTensor<int64_t> gg;gg.SetGlobalBuffer((__gm__ int64_t*)groups);
    TBuf<TPosition::VECCALC> groupBuf,packStorage;
    LocalTensor<int64_t> ends;
    bool usePacked=true;
    if ASCEND_IS_AIV {
        pipe.InitBuffer(groupBuf,1024);ends=groupBuf.Get<int64_t>();
        DataCopyPad(ends,gg,DataCopyExtParams{1,(uint32_t)(E*8),0,0,0},DataCopyPadExtParams<int64_t>{false,0,0,0});
        SetFlag<HardEvent::MTE2_S>(EVENT_ID0);WaitFlag<HardEvent::MTE2_S>(EVENT_ID0);
    }
    if constexpr(PACK_NZ) {
        if ASCEND_IS_AIV {
            TBuf<TPosition::VECCALC> activeBuf;
            pipe.InitBuffer(packStorage,PHASE_PACK?131072:PACK_SIZE);pipe.InitBuffer(activeBuf,512);
            constexpr int PACK_N=PHASE_PACK?512:(WIDE_PACK?1024:256),PACK_K=(PHASE_PACK?131072:PACK_SIZE)/(((WIDE_PACK || PIPELINED_PACK)?4:2)*PACK_N),PACK_BYTES=PACK_K*PACK_N;
            auto raw=packStorage.Get<int8_t>();auto packed=raw[PACK_A_NZ?16384:PACK_BYTES];
            auto active=activeBuf.Get<int32_t>();
            int activeCount=0,previous=0;
            int maximumRows=0;
            for (int expert = 0; expert < E; ++expert) {
                int end = (int)ends.GetValue(expert);
                if (end > previous)
                    active.SetValue(activeCount++, expert);
                if constexpr (HYBRID_ND) {
                    int length = end - previous;
                    if (length > maximumRows)
                        maximumRows = length;
                }
                previous = end;
            }
            if constexpr(HYBRID_ND) {
                usePacked=maximumRows>2*BM;
                TBuf<TPosition::VECCALC> layoutBuf;pipe.InitBuffer(layoutBuf,32);
                if(GetBlockIdx()%2==0) {
                    int core=GetBlockIdx()/2,nc=(N+BN-1)/BN;
                    int maxTasks=((((M+BM-1)/BM+E-1)*nc)+cores-1)/cores;
                    int descriptorStride=((maxTasks+2)*32+127)/128*128;
                    GlobalTensor<int32_t> layout;
                    layout.SetGlobalBuffer((__gm__ int32_t*)((__gm__ uint8_t*)partial+(int64_t)cores*BM*BN*4*(DOUBLE_RESULT?2:1)+(int64_t)core*descriptorStride+(maxTasks+1)*32));
                    auto localLayout=layoutBuf.Get<int32_t>();localLayout.SetValue(0,usePacked?1:0);
                    SetFlag<HardEvent::S_MTE3>(EVENT_ID0);WaitFlag<HardEvent::S_MTE3>(EVENT_ID0);
                    DataCopy(layout,localLayout,8);
                    SetFlag<HardEvent::MTE3_S>(EVENT_ID0);WaitFlag<HardEvent::MTE3_S>(EVENT_ID0);
                }
                CrossCoreSetFlag<2,PIPE_MTE3>(12);
            }
            GlobalTensor<int8_t> original,target;
            original.SetGlobalBuffer((__gm__ int8_t*)weight);target.SetGlobalBuffer((__gm__ int8_t*)packedWeight);
            if constexpr(PACK_A_NZ) {
                GlobalTensor<int8_t> ax,az;
                ax.SetGlobalBuffer((__gm__ int8_t*)x);az.SetGlobalBuffer((__gm__ int8_t*)packedInput);
                int mr=(paddedM+31)/32,kc=(K+511)/512;
                for(int task=GetBlockIdx();task<mr*kc;task+=2*cores) {
                    int row=(task/kc)*32,col=(task%kc)*512;
                    int rows=M>row?(M-row<32?M-row:32):0;
                    int cols=K-col<512?K-col:512,blocks=(cols+31)/32;
                    int height=paddedM-row<32?paddedM-row:32;
                    Duplicate(raw.ReinterpretCast<int32_t>(),(int32_t)0,4096);PipeBarrier<PIPE_ALL>();
                    if(rows>0)DataCopyPad(raw,ax[(int64_t)row*K+col],DataCopyExtParams{(uint16_t)rows,(uint32_t)cols,(uint32_t)(K-cols),(uint32_t)(16-blocks),0},DataCopyPadExtParams<int8_t>{true,0,(uint8_t)(blocks*32-cols),0});
                    SetFlag<HardEvent::MTE2_V>(EVENT_ID0);WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
                    for(int block=0;block<512/256;++block)Adds(packed[block*8192].ReinterpretCast<int32_t>(),raw[block*256].ReinterpretCast<int32_t>(),(int32_t)0,(uint64_t)64,(uint8_t)32,UnaryRepeatParams{32,1,1,512/32});
                    SetFlag<HardEvent::V_MTE3>(EVENT_ID0);WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
                    DataCopyPad(az[(int64_t)col*paddedM+row*32],packed,DataCopyExtParams{(uint16_t)blocks,(uint32_t)(height*32),(uint32_t)(32-height),(uint32_t)((paddedM-height)*32),0});
                    PipeBarrier<PIPE_ALL>();
                }
            }
            int nk=(K+PACK_K-1)/PACK_K,nn=(N+PACK_N-1)/PACK_N,pk=(K+15)/16*16;
            int tasks=usePacked?activeCount*nk*nn:0;
            int packSequence=0;TEventID packFree[2]={EVENT_ID0,EVENT_ID1};
            if constexpr(WIDE_PACK || PIPELINED_PACK){packFree[0]=pipe.AllocEventID<HardEvent::MTE3_MTE2>();packFree[1]=pipe.AllocEventID<HardEvent::MTE3_MTE2>();}
            for(int task=GetBlockIdx();task<tasks;task+=2*cores) {
                int packSlot=packSequence%2;
                if constexpr(WIDE_PACK || PIPELINED_PACK)if(packSequence>=2)WaitFlag<HardEvent::MTE3_MTE2>(packFree[packSlot]);
                auto raw=packStorage.Get<int8_t>()[(WIDE_PACK || PIPELINED_PACK)?2*packSlot*PACK_BYTES:0];auto packed=raw[PACK_BYTES];
                int expert=active.GetValue(task/(nk*nn)),local=task%(nk*nn);
                int k0=(local/nn)*PACK_K,n0=(local%nn)*PACK_N;
                int kk=K-k0<PACK_K?K-k0:PACK_K,cols=N-n0<PACK_N?N-n0:PACK_N;
                int blocks=(cols+31)/32,height=(kk+15)/16*16;
                if constexpr((BM==128 && BN==256 && TAIL_PACK) || WIDE_PACK || PIPELINED_PACK) {
                    if (height > kk) {
                        Duplicate(raw[kk * PACK_N].ReinterpretCast<int32_t>(), (int32_t)0, (height - kk) * PACK_N / 4);
                        if constexpr (PIPELINED_PACK) {
                            SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
                            WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
                        } else
                            PipeBarrier<PIPE_ALL>();
                    }
                }else {
                Duplicate(raw.ReinterpretCast<int32_t>(),(int32_t)0,PACK_BYTES/4);PipeBarrier<PIPE_ALL>();
                }
                DataCopyPad(raw,original[((int64_t)expert*K+k0)*N+n0],DataCopyExtParams{(uint16_t)kk,(uint32_t)cols,(uint32_t)(N-cols),(uint32_t)(PACK_N/32-blocks),0},DataCopyPadExtParams<int8_t>{true,0,(uint8_t)(blocks*32-cols),0});
                SetFlag<HardEvent::MTE2_V>(EVENT_ID0);WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
                for (int block = 0; block < (WIDE_PACK ? (cols + 255) / 256 : PACK_N / 256); ++block)
                    Adds(packed[block * PACK_K * 256].ReinterpretCast<int32_t>(),
                         raw[block * 256].ReinterpretCast<int32_t>(), (int32_t)0, (uint64_t)64, (uint8_t)PACK_K,
                         UnaryRepeatParams{PACK_K, 1, 1, PACK_N / 32});
                SetFlag<HardEvent::V_MTE3>(EVENT_ID0);WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
                DataCopyPad(target[(int64_t)expert*pk*PaddedN+(int64_t)n0*pk+k0*32],packed,DataCopyExtParams{(uint16_t)blocks,(uint32_t)(height*32),(uint32_t)(PACK_K-height),(uint32_t)((pk-height)*32),0});
                if constexpr(WIDE_PACK || PIPELINED_PACK)SetFlag<HardEvent::MTE3_MTE2>(packFree[packSlot]);else PipeBarrier<PIPE_ALL>();
                ++packSequence;
            }
            if constexpr(WIDE_PACK || PIPELINED_PACK)for(int slot=0;slot<2;++slot){if(packSequence>slot)WaitFlag<HardEvent::MTE3_MTE2>(packFree[slot]);pipe.ReleaseEventID<HardEvent::MTE3_MTE2>(packFree[slot]);}
        }
        SyncAll<false>();
    }else {
    if((!NATIVE_ND || (BM==128 && BN==32 && RESIDENCY==NativeResidency::StreamAResidentB)) && (PaddedN!=N || PaddedK!=K)) {
        if ASCEND_IS_AIV {
            TBuf<TPosition::VECCALC> packBuf;
            pipe.InitBuffer(packBuf,PACK_SIZE);
            auto packed=packBuf.Get<int8_t>();
            if(PaddedK!=K) {
                GlobalTensor<int8_t> original,target;
                original.SetGlobalBuffer((__gm__ int8_t*)x);
                target.SetGlobalBuffer((__gm__ int8_t*)packedWeight);
                int share=(M+2*cores-1)/(2*cores),capacity=PACK_SIZE/PaddedK;
                int start=GetBlockIdx()*share,stop=start+share<M?start+share:M;
                for(int row=start;row<stop;) {
                    int count=stop-row<capacity?stop-row:capacity;
                    DataCopyPad(packed,original[(int64_t)row*K],DataCopyExtParams{(uint16_t)count,(uint32_t)K,0,0,0},DataCopyPadExtParams<int8_t>{true,0,(uint8_t)(PaddedK-K),0});
                    SetFlag<HardEvent::MTE2_MTE3>(EVENT_ID0);WaitFlag<HardEvent::MTE2_MTE3>(EVENT_ID0);
                    DataCopyPad(target[(int64_t)row*PaddedK],packed,DataCopyExtParams{1,(uint32_t)(count*PaddedK),0,0,0});
                    SetFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);WaitFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);
                    row+=count;
                }
            }else {
                GlobalTensor<int8_t> original,target;
                original.SetGlobalBuffer((__gm__ int8_t*)weight);
                target.SetGlobalBuffer((__gm__ int8_t*)packedWeight);
                TBuf<TPosition::VECCALC> activeBuf;
                pipe.InitBuffer(activeBuf,512);auto active=activeBuf.Get<int32_t>();
                int activeCount=0,previous=0;
                for(int expert=0;expert<E;++expert) {
                    int end=(int)ends.GetValue(expert);
                    if(end>previous)active.SetValue(activeCount++,expert);
                    previous=end;
                }
                if constexpr(BM==128 && BN==32 && NATIVE_ND && RESIDENCY==NativeResidency::StreamAResidentB) {
                    constexpr int R=512;
                    auto raw=packBuf.Get<int8_t>();
                    auto out=raw[8192].ReinterpretCast<uint32_t>();
                    auto high=raw[12288].ReinterpretCast<uint32_t>();
                    auto index=raw[16384].ReinterpretCast<int32_t>();
                    auto masks=raw[20480].ReinterpretCast<int32_t>();
                    for(int word=0;word<8;++word) {
                        index.SetValue(word,word*4);
                        int remaining=N-4*word;
                        uint32_t bits=remaining>=4?0xffffffffu:(remaining<=0?0u:((1u<<(remaining*8))-1));
                        masks.SetValue(word,(int32_t)bits);
                    }
                    SetFlag<HardEvent::S_V>(EVENT_ID0);WaitFlag<HardEvent::S_V>(EVENT_ID0);
                    for(int rows=1;rows<R/4;rows*=2) {
                        Adds(index[rows*8],index,rows*4*N,rows*8);
                        Adds(masks[rows*8],masks,(int32_t)0,rows*8);PipeBarrier<PIPE_V>();
                    }
                    int length=activeCount*K,share=(length+2*cores-1)/(2*cores);
                    int start=GetBlockIdx()*share,stop=start+share<length?start+share:length;
                    for(int logical=start;logical<stop;) {
                        int count=stop-logical<R?stop-logical:R,first=logical;
                        if(activeCount!=E){int row=logical%K;count=count<K-row?count:K-row;first=active.GetValue(logical/K)*K+row;}
                        logical+=count;
                        SetFlag<HardEvent::V_MTE2>(EVENT_ID0);WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
                        DataCopyPad(raw,original[(int64_t)first*N],DataCopyExtParams{1,(uint32_t)(count*N),0,0,0},DataCopyPadExtParams<int8_t>{false,0,0,0});
                        SetFlag<HardEvent::MTE2_V>(EVENT_ID0);WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
                        for(int phase=0;phase<4;++phase) {
                            int rows=(count+3-phase)/4;if(rows<=0)continue;
                            int words=rows*8,shift=(phase*N%4)*8;uint32_t offset=(phase*N/4)*4;
                            Gather(out,raw.ReinterpretCast<uint32_t>(),index.ReinterpretCast<uint32_t>(),offset,(uint32_t)words);
                            if(shift)Gather(high,raw.ReinterpretCast<uint32_t>(),index.ReinterpretCast<uint32_t>(),offset+4,(uint32_t)words);
                            PipeBarrier<PIPE_V>();
                            if (shift) {
                                ShiftRight(out, out, (uint32_t)shift, words);
                                ShiftLeft(high, high, (uint32_t)(32 - shift), words);
                                PipeBarrier<PIPE_V>();
                                Or(out.ReinterpretCast<uint16_t>(), out.ReinterpretCast<uint16_t>(),
                                   high.ReinterpretCast<uint16_t>(), words * 2);
                                PipeBarrier<PIPE_V>();
                            }
                            And(out.ReinterpretCast<uint16_t>(),out.ReinterpretCast<uint16_t>(),masks.ReinterpretCast<uint16_t>(),words*2);
                            SetFlag<HardEvent::V_MTE3>(EVENT_ID0);WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
                            DataCopyPad(target[(int64_t)(first+phase)*32],out.ReinterpretCast<int8_t>(),DataCopyExtParams{(uint16_t)rows,32,0,96,0});
                            SetFlag<HardEvent::MTE3_V>(EVENT_ID0);WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
                        }
                    }
                }else {
                int length=activeCount*K,share=(length+2*cores-1)/(2*cores);
                int start=GetBlockIdx()*share,stop=start+share<length?start+share:length;
                int capacity=PACK_SIZE/PaddedN;
                for(int logical=start;logical<stop;) {
                    int count=stop-logical<capacity?stop-logical:capacity;
                    int first=logical;
                    if(activeCount!=E) {
                        int row=logical%K;
                        count=count<K-row?count:K-row;
                        first=active.GetValue(logical/K)*K+row;
                    }
                    logical+=count;
                    DataCopyPad(packed,original[(int64_t)first*N],DataCopyExtParams{(uint16_t)count,(uint32_t)N,0,0,0},DataCopyPadExtParams<int8_t>{true,0,(uint8_t)(PaddedN-N),0});
                    SetFlag<HardEvent::MTE2_MTE3>(EVENT_ID0);WaitFlag<HardEvent::MTE2_MTE3>(EVENT_ID0);
                    DataCopyPad(target[(int64_t)first*PaddedN],packed,DataCopyExtParams{1,(uint32_t)(count*PaddedN),0,0,0});
                    SetFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);WaitFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);
                }
                }
            }
        }
        SyncAll<false>();
    }
    }
    if ASCEND_IS_AIC {
        bool directLayout=false;
        if constexpr(HYBRID_ND) {
            static_assert(PACK_NZ && !PACK_A_NZ && !COLUMN_ORDER);
            int core=GetBlockIdx(),nc=(N+BN-1)/BN;
            int maxTasks=((((M+BM-1)/BM+E-1)*nc)+cores-1)/cores;
            int descriptorStride=((maxTasks+(HYBRID_ND?2:1))*32+127)/128*128;
            GlobalTensor<int32_t> layout;
            layout.SetGlobalBuffer((__gm__ int32_t*)((__gm__ uint8_t*)partial+(int64_t)cores*BM*BN*4*(DOUBLE_RESULT?2:1)+(int64_t)core*descriptorStride+(maxTasks+1)*32));
            CrossCoreWaitFlag<2>(12);
            directLayout=layout.GetValue(0)==0;
            if(directLayout) {
        TCubeTiling tile;auto src=reinterpret_cast<__gm__ uint32_t*>(ndTiling);auto dst=reinterpret_cast<uint32_t*>(&tile);
        for(int i=0;i<sizeof(TCubeTiling)/sizeof(uint32_t);++i)dst[i]=src[i];
        using AT=MatmulType<TPosition::GM,false?CubeFormat::NZ:CubeFormat::ND,int8_t,false>;
        using BT=MatmulType<TPosition::GM,false?CubeFormat::NZ:CubeFormat::ND,int8_t,false>;
        using CT=MatmulType<TPosition::GM,CubeFormat::ND,int32_t>;
        Matmul<AT,BT,CT,CT,GMM_CFG> mm;REGIST_MATMUL_OBJ(&pipe,workspace,mm,&tile);
        GlobalTensor<int8_t> ag,bg;GlobalTensor<int32_t> cg;
        ag.SetGlobalBuffer((__gm__ int8_t*)x);bg.SetGlobalBuffer((__gm__ int8_t*)weight);
        int core=GetBlockIdx(),task=core,offset=0,start=0,nc=(N+BN-1)/BN;
        cg.SetGlobalBuffer((__gm__ int32_t*)partial+(int64_t)core*BM*BN);
        int maxTasks=((((M+BM-1)/BM+E-1)*nc)+cores-1)/cores;
