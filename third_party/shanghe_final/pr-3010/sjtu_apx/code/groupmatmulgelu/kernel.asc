    DataCopyPad(bw,bwg,DataCopyExtParams{1,(uint32_t)(E*K*N),0,0,0},DataCopyPadExtParams<int8_t>{false,0,0,0});
    DataCopyPad(sg,sgg,DataCopyExtParams{1,(uint32_t)(E*N*4),0,0,0},DataCopyPadExtParams<float>{false,0,0,0});
    DataCopyPad(gg,ggg,DataCopyExtParams{1,(uint32_t)(E*8),0,0,0},DataCopyPadExtParams<int64_t>{false,0,0,0});
