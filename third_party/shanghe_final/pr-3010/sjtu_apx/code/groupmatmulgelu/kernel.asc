template<int BM,bool COMPACT=false>
__global__ __aicore__ void grouped_gelu_shallow(GM_ADDR x,GM_ADDR weight,GM_ADDR scale,GM_ADDR groups,
    GM_ADDR y,int E,int M,int K,int N) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    constexpr int BN=256,SIZE=BM*BN;
    TPipe pipe;
    TBuf<TPosition::VECCALC> gb,xb,wb,whb,wfb,sb,zb,ab,bb,ob,tb,hb,mb,m1b,m2b;
    pipe.InitBuffer(gb,1024);pipe.InitBuffer(xb,BM*4);pipe.InitBuffer(wb,4*BN);
    pipe.InitBuffer(whb,4*BN*2);pipe.InitBuffer(wfb,4*BN*4);pipe.InitBuffer(sb,BN*4);
    pipe.InitBuffer(zb,SIZE*4);pipe.InitBuffer(ab,SIZE*4);pipe.InitBuffer(bb,SIZE*4);
    pipe.InitBuffer(ob,SIZE*4);pipe.InitBuffer(tb,SIZE*4);pipe.InitBuffer(hb,SIZE*2);
    pipe.InitBuffer(mb,SIZE/8);pipe.InitBuffer(m1b,SIZE/8);pipe.InitBuffer(m2b,SIZE/8);
    auto ends=gb.Get<int64_t>();auto ax=xb.Get<int8_t>();auto w=wb.Get<int8_t>();
    auto wh=whb.Get<half>();auto wf=wfb.Get<float>();auto scales=sb.Get<float>();
    auto z=zb.Get<float>();auto a=ab.Get<float>();auto b=bb.Get<float>();
    auto out=ob.Get<float>();auto tmp=tb.Get<float>();auto h=hb.Get<half>();
    GlobalTensor<int8_t> xg,wg;GlobalTensor<float> sg;GlobalTensor<int64_t> gg;GlobalTensor<half> yg;
    xg.SetGlobalBuffer((__gm__ int8_t*)x);wg.SetGlobalBuffer((__gm__ int8_t*)weight);
    sg.SetGlobalBuffer((__gm__ float*)scale);gg.SetGlobalBuffer((__gm__ int64_t*)groups);yg.SetGlobalBuffer((__gm__ half*)y);
    DataCopyPad(ends,gg,DataCopyExtParams{1,(uint32_t)(E*8),0,0,0},DataCopyPadExtParams<int64_t>{false,0,0,0});
    PipeBarrier<PIPE_ALL>();
    int task=GetBlockIdx(),offset=0,start=0,nc=(N+BN-1)/BN;
    for(int e=0;e<E;++e) {
        int end=(int)ends.GetValue(e),length=end-start,tiles=((length+BM-1)/BM)*nc;
        while(task<offset+tiles) {
            int local=task-offset,row=(local/nc)*BM,col=(local%nc)*BN;
            int rows=length-row<BM?length-row:BM,cols=N-col<BN?N-col:BN;
            int stride=(cols+15)/16*16,ws=(cols+31)/32*32,elements=(rows*stride+63)/64*64;
            DataCopyPad(ax,xg[(int64_t)(start+row)*K],DataCopyExtParams{1,(uint32_t)(rows*K),0,0,0},DataCopyPadExtParams<int8_t>{false,0,0,0});
            DataCopyPad(w,wg[(int64_t)e*K*N+col],DataCopyExtParams{(uint16_t)K,(uint32_t)cols,(uint32_t)(N-cols),0,0},DataCopyPadExtParams<int8_t>{false,0,0,0});
            DataCopyPad(scales,sg[(int64_t)e*N+col],DataCopyExtParams{1,(uint32_t)(cols*4),0,0,0},DataCopyPadExtParams<float>{false,0,0,0});
            PipeBarrier<PIPE_ALL>();
            Cast(wh,w,RoundMode::CAST_NONE,K*ws);PipeBarrier<PIPE_V>();
            Cast(wf,wh,RoundMode::CAST_NONE,K*ws);Duplicate(z,0.0f,elements);PipeBarrier<PIPE_ALL>();
            for(int kk=0;kk<K;++kk)for(int rr=0;rr<rows;++rr) {
                float xv=(float)ax.GetValue(rr*K+kk);
                Muls(tmp,wf[kk*ws],xv,cols);PipeBarrier<PIPE_V>();
                Add(z[rr*stride],z[rr*stride],tmp,cols);PipeBarrier<PIPE_V>();
            }
            for(int rr=0;rr<rows;++rr)Mul(z[rr*stride],z[rr*stride],scales,cols);
            PipeBarrier<PIPE_V>();
            GeluVector<COMPACT>(z,a,b,out,tmp,mb.Get<uint8_t>(),m1b.Get<uint8_t>(),m2b.Get<uint8_t>(),elements);
            Cast(h,out,RoundMode::CAST_RINT,elements);PipeBarrier<PIPE_ALL>();
            DataCopyPad(yg[(int64_t)(start+row)*N+col],h,DataCopyExtParams{(uint16_t)rows,(uint32_t)(cols*2),0,(uint32_t)((N-cols)*2),0});
            PipeBarrier<PIPE_ALL>();
            task+=GetBlockNum();
        }
        offset+=tiles;start=end;
    }
}


__aicore__ inline bool ResolveSplitTile(LocalTensor<int64_t> ends,int E,int N,int task,int& expert,int& row,int& col,int& rows,int& cols) {
    int previous=0,nc=(N+127)/128;
    for(int e=0;e<E;++e) {
        int end=(int)ends.GetValue(e),length=end-previous,tiles=((length+31)/32)*nc;
        if(task<tiles) {
            int localRow=(task/nc)*32;
            expert=e;row=previous+localRow;col=(task%nc)*128;
            rows=length-localRow<32?length-localRow:32;cols=N-col<128?N-col:128;
            return true;
        }
        task-=tiles;previous=end;
    }
    return false;
}

__global__ __aicore__ void grouped_gelu_splitk(GM_ADDR x,GM_ADDR weight,GM_ADDR scale,GM_ADDR groups,
    GM_ADDR y,GM_ADDR partial,GM_ADDR descriptorsGM,GM_ADDR tilingGM,GM_ADDR workspace,int E,int M,int K,int N,int cores,int splits,int chunkK) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
    TPipe pipe;
    TBuf<TPosition::VECCALC> groupBuf,descriptorBuf;
    LocalTensor<int64_t> ends;
    if ASCEND_IS_AIV {
        pipe.InitBuffer(groupBuf,1024);pipe.InitBuffer(descriptorBuf,32);
        ends=groupBuf.Get<int64_t>();auto descriptor=descriptorBuf.Get<int32_t>();
        GlobalTensor<int64_t> gg;gg.SetGlobalBuffer((__gm__ int64_t*)groups);
        DataCopyPad(ends,gg,DataCopyExtParams{1,(uint32_t)(E*8),0,0,0},DataCopyPadExtParams<int64_t>{false,0,0,0});
        SetFlag<HardEvent::MTE2_S>(EVENT_ID0);WaitFlag<HardEvent::MTE2_S>(EVENT_ID0);
        int core=GetBlockIdx()/2,sub=GetBlockIdx()%2;
        if(sub==0) {
            int expert=0,row=0,col=0,rows=0,cols=0;
            bool valid=ResolveSplitTile(ends,E,N,core/splits,expert,row,col,rows,cols);
            for(int i=0;i<8;++i)descriptor.SetValue(i,0);
            descriptor.SetValue(0,valid?expert:-1);descriptor.SetValue(1,row);descriptor.SetValue(2,col);
            descriptor.SetValue(3,rows);descriptor.SetValue(4,cols);
            GlobalTensor<int32_t> dg;dg.SetGlobalBuffer((__gm__ int32_t*)descriptorsGM+core*8);
            SetFlag<HardEvent::S_MTE3>(EVENT_ID0);WaitFlag<HardEvent::S_MTE3>(EVENT_ID0);
            DataCopy(dg,descriptor,8);
            SetFlag<HardEvent::MTE3_S>(EVENT_ID0);WaitFlag<HardEvent::MTE3_S>(EVENT_ID0);
        }
        CrossCoreSetFlag<2,PIPE_MTE3>(10);
    }
    if ASCEND_IS_AIC {
        TCubeTiling tile;auto src=reinterpret_cast<__gm__ uint32_t*>(tilingGM);auto dst=reinterpret_cast<uint32_t*>(&tile);
        for(int i=0;i<sizeof(TCubeTiling)/sizeof(uint32_t);++i)dst[i]=src[i];
        using AT=MatmulType<TPosition::GM,CubeFormat::ND,int8_t,false>;
        using BT=MatmulType<TPosition::GM,CubeFormat::ND,int8_t,false>;
        using CT=MatmulType<TPosition::GM,CubeFormat::ND,int32_t>;
        Matmul<AT,BT,CT,CT,GMM_CFG> mm;REGIST_MATMUL_OBJ(&pipe,workspace,mm,&tile);
        int core=GetBlockIdx(),startK=(core%splits)*chunkK,kCount=K-startK<chunkK?K-startK:chunkK;
        GlobalTensor<int32_t> dg;dg.SetGlobalBuffer((__gm__ int32_t*)descriptorsGM+core*8);
        CrossCoreWaitFlag<2>(10);
        int expert=dg.GetValue(0);
        if(expert>=0) {
            int row=dg.GetValue(1),col=dg.GetValue(2),rows=dg.GetValue(3),cols=dg.GetValue(4);
            GlobalTensor<int8_t> ag,bg;GlobalTensor<int32_t> cg;
            ag.SetGlobalBuffer((__gm__ int8_t*)x+(int64_t)row*K+startK);
            bg.SetGlobalBuffer((__gm__ int8_t*)weight+(int64_t)expert*K*N+(int64_t)startK*N+col);
            cg.SetGlobalBuffer((__gm__ int32_t*)partial+(int64_t)core*4096);
            mm.SetOrgShape(M,N,K,K,128);mm.SetSingleShape(rows,cols,kCount);
            mm.SetTensorA(ag,false);mm.SetTensorB(bg,false);mm.IterateAll(cg);mm.End();
        }
        PipeBarrier<PIPE_ALL>();
    }
    SyncAll<false>();
    if ASCEND_IS_AIV {
        int core=GetBlockIdx()/2,sub=GetBlockIdx()%2,expert=0,row=0,col=0,rows=0,cols=0;
        if(!ResolveSplitTile(ends,E,N,core,expert,row,col,rows,cols))return;
        int first=sub*((rows+1)/2),count=sub==0?(rows+1)/2:rows/2;
        if(count==0)return;
        constexpr int SIZE=2048;
        TBuf<TPosition::VECCALC> inBuf,accBuf,zBuf,aBuf,bBuf,outBuf,tmpBuf,halfBuf,scaleBuf,maskBuf,m1Buf,m2Buf;
        pipe.InitBuffer(inBuf,SIZE*4);pipe.InitBuffer(accBuf,SIZE*4);pipe.InitBuffer(zBuf,SIZE*4);
        pipe.InitBuffer(aBuf,SIZE*4);pipe.InitBuffer(bBuf,SIZE*4);pipe.InitBuffer(outBuf,SIZE*4);pipe.InitBuffer(tmpBuf,SIZE*4);
        pipe.InitBuffer(halfBuf,SIZE*2);pipe.InitBuffer(scaleBuf,512);
        pipe.InitBuffer(maskBuf,SIZE/8);pipe.InitBuffer(m1Buf,SIZE/8);pipe.InitBuffer(m2Buf,SIZE/8);
        auto input=inBuf.Get<int32_t>();auto acc=accBuf.Get<int32_t>();auto z=zBuf.Get<float>();
        auto a=aBuf.Get<float>();auto b=bBuf.Get<float>();auto result=outBuf.Get<float>();auto scales=scaleBuf.Get<float>();auto output=halfBuf.Get<half>();
        int stride=(cols+15)/16*16,elements=(count*stride+63)/64*64;
        Duplicate(acc,(int32_t)0,elements);PipeBarrier<PIPE_ALL>();
        GlobalTensor<int32_t> cg;cg.SetGlobalBuffer((__gm__ int32_t*)partial);
        for(int split=0;split<splits;++split) {
            Duplicate(input,(int32_t)0,elements);PipeBarrier<PIPE_ALL>();
            DataCopyPad(input,cg[(int64_t)(core*splits+split)*4096+first*128],DataCopyExtParams{(uint16_t)count,(uint32_t)(cols*4),(uint32_t)((128-cols)*4),(uint32_t)((stride-(cols+7)/8*8)/8),0},DataCopyPadExtParams<int32_t>{false,0,0,0});
            PipeBarrier<PIPE_ALL>();Add(acc,acc,input,elements);PipeBarrier<PIPE_ALL>();
        }
        GlobalTensor<float> sg;sg.SetGlobalBuffer((__gm__ float*)scale);
        Duplicate(scales,0.0f,stride);PipeBarrier<PIPE_ALL>();
        DataCopyPad(scales,sg[(int64_t)expert*N+col],DataCopyExtParams{1,(uint32_t)(cols*4),0,0,0},DataCopyPadExtParams<float>{false,0,0,0});
        PipeBarrier<PIPE_ALL>();Cast(z,acc,RoundMode::CAST_RINT,elements);PipeBarrier<PIPE_V>();
        for(int rr=0;rr<count;++rr)Mul(z[rr*stride],z[rr*stride],scales,stride);
        PipeBarrier<PIPE_V>();GeluVector(z,a,b,result,tmpBuf.Get<float>(),maskBuf.Get<uint8_t>(),m1Buf.Get<uint8_t>(),m2Buf.Get<uint8_t>(),elements);
        Cast(output,result,RoundMode::CAST_RINT,elements);PipeBarrier<PIPE_ALL>();
        GlobalTensor<half> yg;yg.SetGlobalBuffer((__gm__ half*)y);
        DataCopyPad(yg[(int64_t)(row+first)*N+col],output,DataCopyExtParams{(uint16_t)count,(uint32_t)(cols*2),(uint32_t)((stride-(cols+15)/16*16)/16),(uint32_t)((N-cols)*2),0});
        PipeBarrier<PIPE_ALL>();
    }
}


__global__ __aicore__ void grouped_gelu_singlewave_tile(GM_ADDR x,GM_ADDR weight,GM_ADDR scale,GM_ADDR y,GM_ADDR partial,int M,int K,int N) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
    constexpr int BM=16,BN=64,PK=256,Q=512,U=64;
    int core=0,sub=0;
    if ASCEND_IS_AIC {core=GetBlockIdx();}
    if ASCEND_IS_AIV {core=GetBlockIdx()/2;sub=GetBlockIdx()%2;}
    int nc=(N+BN-1)/BN,row=(core/nc)*BM,col=(core%nc)*BN;
    int rows=M-row<BM?M-row:BM,cols=N-col<BN?N-col:BN,fullK=(K+31)/32*32,an=(cols+31)/32*32;
    if ASCEND_IS_AIC {
        LocalTensor<int8_t> a1(TPosition::A1,0,BM*PK),b1(TPosition::A1,BM*PK,BN*PK);
        LocalTensor<int8_t> a2(TPosition::A2,0,BM*PK),b2(TPosition::B2,0,BN*PK);
        LocalTensor<int32_t> c(TPosition::CO1,0,BM*BN);
        GlobalTensor<int8_t> ax,bw;GlobalTensor<int32_t> cg;
        ax.SetGlobalBuffer((__gm__ int8_t*)x);bw.SetGlobalBuffer((__gm__ int8_t*)weight);cg.SetGlobalBuffer((__gm__ int32_t*)partial+core*BM*BN);
        Nd2NzParams ap;ap.ndNum=1;ap.nValue=rows;ap.dValue=K;ap.srcNdMatrixStride=0;ap.srcDValue=K;ap.dstNzC0Stride=BM;ap.dstNzNStride=1;ap.dstNzMatrixStride=0;
        DataCopy(a1,ax[(int64_t)row*K],ap);
        Nd2NzParams bp;bp.ndNum=1;bp.nValue=K;bp.dValue=cols;bp.srcNdMatrixStride=0;bp.srcDValue=N;bp.dstNzC0Stride=fullK;bp.dstNzNStride=1;bp.dstNzMatrixStride=0;
        DataCopy(b1,bw[col],bp);
        if(fullK>K){
            auto pad=b1.ReinterpretCast<uint16_t>();InitConstValueParams<uint16_t> zero;
            zero.repeatTimes=an/32;zero.blockNum=fullK-K;zero.dstGap=K;zero.initValue=0;InitConstValue(pad[K*16],zero);
        }
        SetFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);WaitFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);
        LoadData2DParams al;al.startIndex=0;al.repeatTimes=fullK/32;al.srcStride=1;al.dstGap=0;al.ifTranspose=false;
        LoadData(a2,a1,al);
        LoadData2dTransposeParams bl;bl.startIndex=0;bl.repeatTimes=an/32;bl.srcStride=fullK/32;bl.dstGap=1;bl.dstFracGap=0;
        for(int kk=0;kk<fullK/32;++kk)LoadDataWithTranspose(b2[kk*an*32],b1[kk*1024],bl);
        SetFlag<HardEvent::MTE1_M>(EVENT_ID0);WaitFlag<HardEvent::MTE1_M>(EVENT_ID0);
        MmadParams mp;mp.m=BM;mp.n=an;mp.k=K;mp.cmatrixInitVal=true;Mmad(c,a2,b2,mp);
        SetFlag<HardEvent::M_FIX>(EVENT_ID0);WaitFlag<HardEvent::M_FIX>(EVENT_ID0);
        FixpipeParamsV220 fp;fp.nSize=cols;fp.mSize=rows;fp.srcStride=BM;fp.dstStride=BN;fp.ndNum=1;fp.srcNdStride=0;fp.dstNdStride=0;
        Fixpipe(cg,c,fp);CrossCoreSetFlag<2,PIPE_FIX>(8);PipeBarrier<PIPE_ALL>();
    }
    if ASCEND_IS_AIV {
        LocalTensor<int32_t> raw(TPosition::VECCALC,U,Q);
        LocalTensor<float> z(TPosition::VECCALC,U+Q*4,Q),a(TPosition::VECCALC,U+Q*8,Q),b(TPosition::VECCALC,U+Q*12,Q),out(TPosition::VECCALC,U+Q*16,Q),tmp(TPosition::VECCALC,U+Q*20,Q);
        LocalTensor<half> h(TPosition::VECCALC,U+Q*24,Q);
        LocalTensor<float> sc(TPosition::VECCALC,U+Q*26,BN);
        LocalTensor<uint8_t> mask(TPosition::VECCALC,U+Q*26+BN*4,Q/8),m1(TPosition::VECCALC,U+Q*26+BN*4+Q/8,Q/8),m2(TPosition::VECCALC,U+Q*26+BN*4+Q/4,Q/8);
        GlobalTensor<int32_t> cg;GlobalTensor<float> sg;GlobalTensor<half> yg;
        cg.SetGlobalBuffer((__gm__ int32_t*)partial+core*BM*BN);sg.SetGlobalBuffer((__gm__ float*)scale);yg.SetGlobalBuffer((__gm__ half*)y);
        int stride=(cols+15)/16*16,first=sub*8,count=rows-first;
        if(count>8)count=8;
        DataCopyPad(sc,sg[col],DataCopyExtParams{1,(uint32_t)(cols*4),0,0,0},DataCopyPadExtParams<float>{true,0,(uint8_t)((cols+7)/8*8-cols),0});
        CrossCoreWaitFlag<2>(8);
        if(count>0) {
            int elements=(count*stride+63)/64*64;
            if(elements>count*stride || cols!=stride){Duplicate(raw,(int32_t)0,elements);SetFlag<HardEvent::V_MTE2>(EVENT_ID0);WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);}
            DataCopyPad(raw,cg[first*BN],DataCopyExtParams{(uint16_t)count,(uint32_t)(cols*4),(uint32_t)((BN-cols)*4),(uint32_t)((stride-(cols+7)/8*8)/8),0},DataCopyPadExtParams<int32_t>{true,0,(uint8_t)((cols+7)/8*8-cols),0});
            SetFlag<HardEvent::MTE2_V>(EVENT_ID0);WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
            Cast(z,raw,RoundMode::CAST_RINT,elements);PipeBarrier<PIPE_V>();
            Mul(z,z,sc,(uint64_t)stride,(uint8_t)count,BinaryRepeatParams{1,1,1,(uint8_t)(stride/8),(uint8_t)(stride/8),0});PipeBarrier<PIPE_V>();
            GeluVector<false,false,true,false,true,false,0,0,false,true,true>(z,a,b,out,tmp,mask,m1,m2,elements);
            Cast(h,out,RoundMode::CAST_RINT,elements);SetFlag<HardEvent::V_MTE3>(EVENT_ID0);WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
            DataCopyPad(yg[(int64_t)(row+first)*N+col],h,DataCopyExtParams{(uint16_t)count,(uint32_t)(cols*2),0,(uint32_t)((N-cols)*2),0});PipeBarrier<PIPE_ALL>();
        }
    }
}

__global__ __aicore__ void grouped_gelu_resident_tile(GM_ADDR x,GM_ADDR weight,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,GM_ADDR partial,int E,int M,int K,int N,int cores) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
    constexpr int BM=16,BN=64,PK=256,Q=512,U=1024;
    int fullK=(K+31)/32*32,nc=(N+BN-1)/BN,core=0,sub=0;
    GlobalTensor<int64_t> gg;gg.SetGlobalBuffer((__gm__ int64_t*)groups);
    if ASCEND_IS_AIC {core=GetBlockIdx();DataCacheCleanAndInvalid<int64_t,CacheLine::ENTIRE_DATA_CACHE,DcciDst::CACHELINE_OUT>(gg);}
    if ASCEND_IS_AIV {
        core=GetBlockIdx()/2;sub=GetBlockIdx()%2;
        DataCacheCleanAndInvalid<int64_t,CacheLine::ENTIRE_DATA_CACHE,DcciDst::CACHELINE_OUT>(gg);
    }
    int totalTasks=0,previous=0;
    for(int e=0;e<E;++e){
        int end=e+1==E?M:(int)gg.GetValue(e);
        totalTasks+=((end-previous+BM-1)/BM)*nc;previous=end;
    }
    if ASCEND_IS_AIC {
        LocalTensor<int8_t> a1(TPosition::A1,0,BM*fullK),b1(TPosition::A1,BM*fullK,BN*fullK);
        LocalTensor<int8_t> a2(TPosition::A2,0,BM*PK),b2(TPosition::B2,0,BN*PK);
        LocalTensor<int32_t> c(TPosition::CO1,0,BM*BN);
        GlobalTensor<int8_t> ax,bw;GlobalTensor<int32_t> cg;
        ax.SetGlobalBuffer((__gm__ int8_t*)x);bw.SetGlobalBuffer((__gm__ int8_t*)weight);cg.SetGlobalBuffer((__gm__ int32_t*)partial+core*BM*BN);
        int task=core,offset=0,start=0,published=0;
        for(int e=0;e<E;++e) {
            int end=e+1==E?M:(int)gg.GetValue(e),tiles=((end-start+BM-1)/BM)*nc;
            while(task<offset+tiles) {
                int local=task-offset,row=start+(local/nc)*BM,col=(local%nc)*BN;
                int rows=end-row<BM?end-row:BM,cols=N-col<BN?N-col:BN,an=(cols+31)/32*32;
                Nd2NzParams ap;ap.ndNum=1;ap.nValue=rows;ap.dValue=K;ap.srcNdMatrixStride=0;ap.srcDValue=K;ap.dstNzC0Stride=BM;ap.dstNzNStride=1;ap.dstNzMatrixStride=0;
                DataCopy(a1,ax[(int64_t)row*K],ap);
                Nd2NzParams bp;bp.ndNum=1;bp.nValue=K;bp.dValue=cols;bp.srcNdMatrixStride=0;bp.srcDValue=N;bp.dstNzC0Stride=fullK;bp.dstNzNStride=1;bp.dstNzMatrixStride=0;
                DataCopy(b1,bw[(int64_t)e*K*N+col],bp);
                if(fullK>K){
                    auto pad=b1.ReinterpretCast<uint16_t>();InitConstValueParams<uint16_t> zero;
                    zero.repeatTimes=an/32;zero.blockNum=fullK-K;zero.dstGap=K;zero.initValue=0;InitConstValue(pad[K*16],zero);
                }
                SetFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);WaitFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);
                for(int k0=0;k0<K;k0+=PK){
                    int kl=K-k0<PK?K-k0:PK,pk=(kl+31)/32*32;
                    LoadData2DParams al;al.startIndex=0;al.repeatTimes=pk/32;al.srcStride=1;al.dstGap=0;al.ifTranspose=false;
                    LoadData(a2,a1[k0*BM],al);
                    LoadData2dTransposeParams bl;bl.startIndex=0;bl.repeatTimes=an/32;bl.srcStride=fullK/32;bl.dstGap=1;bl.dstFracGap=0;
                    for(int kk=0;kk<pk/32;++kk)LoadDataWithTranspose(b2[kk*an*32],b1[k0*32+kk*1024],bl);
                    SetFlag<HardEvent::MTE1_M>(EVENT_ID0);WaitFlag<HardEvent::MTE1_M>(EVENT_ID0);
                    MmadParams mp;mp.m=BM;mp.n=an;mp.k=kl;mp.cmatrixInitVal=k0==0;Mmad(c,a2,b2,mp);
                    if(k0+PK<K){SetFlag<HardEvent::M_MTE1>(EVENT_ID0);WaitFlag<HardEvent::M_MTE1>(EVENT_ID0);}
                }
                SetFlag<HardEvent::M_FIX>(EVENT_ID0);WaitFlag<HardEvent::M_FIX>(EVENT_ID0);
                if(published)CrossCoreWaitFlag<2>(9);
                FixpipeParamsV220 fp;fp.nSize=cols;fp.mSize=rows;fp.srcStride=BM;fp.dstStride=BN;fp.ndNum=1;fp.srcNdStride=0;fp.dstNdStride=0;
                Fixpipe(cg,c,fp);CrossCoreSetFlag<2,PIPE_FIX>(8);
                PipeBarrier<PIPE_ALL>();++published;task+=cores;
            }
            offset+=tiles;start=end;
        }
    }
    if ASCEND_IS_AIV {
        LocalTensor<int32_t> raw(TPosition::VECCALC,U,Q);
        LocalTensor<float> z(TPosition::VECCALC,U+Q*4,Q),a(TPosition::VECCALC,U+Q*8,Q),b(TPosition::VECCALC,U+Q*12,Q),out(TPosition::VECCALC,U+Q*16,Q),tmp(TPosition::VECCALC,U+Q*20,Q);
        LocalTensor<half> h(TPosition::VECCALC,U+Q*24,Q);
        LocalTensor<float> sc(TPosition::VECCALC,U+Q*26,BN);
        LocalTensor<uint8_t> mask(TPosition::VECCALC,U+Q*26+BN*4,Q/8),m1(TPosition::VECCALC,U+Q*26+BN*4+Q/8,Q/8),m2(TPosition::VECCALC,U+Q*26+BN*4+Q/4,Q/8);
        GlobalTensor<int32_t> cg;GlobalTensor<float> sg;GlobalTensor<half> yg;
        cg.SetGlobalBuffer((__gm__ int32_t*)partial+core*BM*BN);sg.SetGlobalBuffer((__gm__ float*)scale);yg.SetGlobalBuffer((__gm__ half*)y);
        int task=core,offset=0,start=0;
        for(int e=0;e<E;++e) {
            int end=e+1==E?M:(int)gg.GetValue(e),tiles=((end-start+BM-1)/BM)*nc;
            while(task<offset+tiles) {
                int local=task-offset,row=start+(local/nc)*BM,col=(local%nc)*BN;
                int rows=end-row<BM?end-row:BM,cols=N-col<BN?N-col:BN,stride=(cols+15)/16*16,first=sub*8,count=rows-first;
                if(count>8)count=8;
                DataCopyPad(sc,sg[e*N+col],DataCopyExtParams{1,(uint32_t)(cols*4),0,0,0},DataCopyPadExtParams<float>{true,0,(uint8_t)((cols+7)/8*8-cols),0});
                CrossCoreWaitFlag<2>(8);
                if(count>0) {
                    int elements=(count*stride+63)/64*64;
                    if(elements>count*stride || cols!=stride){Duplicate(raw,(int32_t)0,elements);SetFlag<HardEvent::V_MTE2>(EVENT_ID0);WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);}
                    DataCopyPad(raw,cg[first*BN],DataCopyExtParams{(uint16_t)count,(uint32_t)(cols*4),(uint32_t)((BN-cols)*4),(uint32_t)((stride-(cols+7)/8*8)/8),0},DataCopyPadExtParams<int32_t>{true,0,(uint8_t)((cols+7)/8*8-cols),0});
                    SetFlag<HardEvent::MTE2_V>(EVENT_ID0);WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
                    Cast(z,raw,RoundMode::CAST_RINT,elements);PipeBarrier<PIPE_V>();
