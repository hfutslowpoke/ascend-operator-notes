    Mul(a,out,b,count);PipeBarrier<PIPE_V>();
    CompareScalar(mask,z,0.0f,CMPMODE::GE,count);PipeBarrier<PIPE_V>();
    Select(out,mask,out,a,SELMODE::VSEL_TENSOR_TENSOR_MODE,count);PipeBarrier<PIPE_V>();
    }
    if constexpr(INTERVAL_MASK) {
        Abs(a,out,count);PipeBarrier<PIPE_V>();
        CompareScalar(m2,a,0.0001220703125f,CMPMODE::LT,count);PipeBarrier<PIPE_V>();
        Muls(a,a,5.9604644775390625e-7f,count);PipeBarrier<PIPE_V>();
        Maxs(a,a,2.9103830456733704e-10f,count);PipeBarrier<PIPE_V>();
        Sub(b,out,a,count);PipeBarrier<PIPE_V>();
        if constexpr(HALF_SCRATCH) {
        Add(a,out,a,count);PipeBarrier<PIPE_V>();
        if constexpr(QUEUE_OUTPUT)WaitFlag<HardEvent::MTE3_V>(freeOutput);
        Cast(tmp.ReinterpretCast<half>(),b,RoundMode::CAST_RINT,count);PipeBarrier<PIPE_V>();
        Cast(b.ReinterpretCast<half>(),a,RoundMode::CAST_RINT,count);PipeBarrier<PIPE_V>();
        Compare(mask,tmp.ReinterpretCast<half>(),b.ReinterpretCast<half>(),CMPMODE::NE,(count+127)/128*128);PipeBarrier<PIPE_V>();
        }else {
