__aicore__ inline void GeluVector(LocalTensor<float> z, LocalTensor<float> a, LocalTensor<float> b,
                                  LocalTensor<float> out, LocalTensor<float> tmp, LocalTensor<uint8_t> mask,
                                  LocalTensor<uint8_t> m1, LocalTensor<uint8_t> m2, int count,
