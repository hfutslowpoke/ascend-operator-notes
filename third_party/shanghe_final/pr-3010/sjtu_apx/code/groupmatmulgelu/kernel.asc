    static constexpr int64_t L0ABytes=64LL*1024;
    static constexpr int64_t L0BBytes=64LL*1024;
    static constexpr int64_t L0CBytes=128LL*1024;
    static constexpr int64_t WeightBytesLimit=256LL*1024*1024;
    static constexpr int64_t TotalTensorBytesLimit=512LL*1024*1024;
    static constexpr int64_t PaddedWeightBytesLimit=128LL*1024*1024;
    static constexpr int64_t PackedInputBytesLimit=256LL*1024*1024;
    static constexpr int64_t MinimumWorkspaceBytes=16LL*1024*1024;
};
template<int BM,int BN,int PK>
struct NativeCubeBudget {
    static constexpr int64_t ABytesPerK=int64_t(BM)*sizeof(int8_t);
    static constexpr int64_t BBytesPerK=int64_t(BN)*sizeof(int8_t);
    static constexpr int64_t ABBytesPerK=ABytesPerK+BBytesPerK;
    static constexpr int64_t StreamABytes=2*ABytesPerK*PK;
    static constexpr int64_t StreamBBytes=2*BBytesPerK*PK;
    static constexpr int64_t AccumulatorBytes=int64_t(BM)*BN*sizeof(int32_t);
    static constexpr int SegmentK=(GmmMemoryBudget::L1Bytes-StreamBBytes)/ABytesPerK/PK*PK;
};
struct WideFloat { float hi, lo; };
__aicore__ inline WideFloat WideAdd(WideFloat a, WideFloat b) {
#pragma clang fp reassociate(off) contract(off)
    float s=a.hi+b.hi;
    float v=s-a.hi;
    float p=s-v;
    float e1=a.hi-p;
    float e2=b.hi-v;
    float e=e1+e2;
    float l=a.lo+b.lo;
    float t=e+l;
    float h=s+t;
    float d=h-s;
    return {h,t-d};
}
__aicore__ inline WideFloat WideNeg(WideFloat a) { return {-a.hi,-a.lo}; }
__aicore__ inline WideFloat WideMul(WideFloat a, WideFloat b) {
#pragma clang fp reassociate(off) contract(off)
    union Bits { float f; uint32_t u; } aa,bb;
    aa.f=a.hi; bb.f=b.hi; aa.u&=0xfffff000u; bb.u&=0xfffff000u;
    float al=a.hi-aa.f, bl=b.hi-bb.f;
    float p=a.hi*b.hi;
    float hh=aa.f*bb.f;
    float hl=aa.f*bl;
    float lh=al*bb.f;
    float ll=al*bl;
    float e0=hh-p;
    float e1=e0+hl;
    float e2=e1+lh;
    float e3=e2+ll;
    float c1=a.hi*b.lo;
    float c2=a.lo*b.hi;
    float c3=a.lo*b.lo;
    float e4=e3+c1;
    float e5=e4+c2;
    float e=e5+c3;
    float h=p+e;
    float d=h-p;
    return {h,e-d};
}
__aicore__ inline WideFloat WideDiv(WideFloat a, WideFloat b) {
    float q=a.hi/b.hi;
    WideFloat rem=WideAdd(a,WideNeg(WideMul(b,{q,0.0f})));
    return WideAdd({q,0.0f},{(rem.hi+rem.lo)/b.hi,0.0f});
}
__aicore__ inline float GeluRounded(float z) {
    if(z>=8.0f) return z;
    if(z<=-8.0f) return 0.0f;
    float az=z>=0.0f?z:-z;
    WideFloat x={az,0.0f};
    WideFloat cube=WideMul(WideMul(x,x),x);
    WideFloat u=WideMul(WideAdd(x,WideMul(cube,{0.044714998453855515f,1.5461444347053543e-09f})),{0.79788458347320557f,-2.2670340271702116e-08f});
    WideFloat exponentValue=WideMul(u,{-2.0f,0.0f});
    int exponentShift=(int)(exponentValue.hi*1.4426950408889634f-0.5f);
    WideFloat r=WideAdd(exponentValue,WideMul({(float)exponentShift,0.0f},{-0.69314718246459961f,1.904654323148236e-09f}));
    WideFloat t={2.755731998149713e-07f,-7.575112209051195e-15f};
