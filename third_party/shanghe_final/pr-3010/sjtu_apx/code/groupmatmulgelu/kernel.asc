struct GroupTileMap {
 GlobalTensor<int64_t> ends;
 uint64_t d0,d1,d2,d3,d4,d5,d6,d7;int expert,lastExpert,beginTicket,endTicket,columns,start,finish,rowTile,column,firstColumn,lastColumn;
 int workspaceBase,capacity;bool loaded;
 __aicore__ inline void Init(GM_ADDR groups,int E,int M,int nc,int cores){
  ends.SetGlobalBuffer((__gm__ int64_t*)groups);columns=nc;int core=GetBlockIdx();if ASCEND_IS_AIV {core/=2;}
  int nominal = M / 64 * nc;
  capacity = nominal / cores + (core < nominal % cores);
  workspaceBase = core * (nominal / cores) + (core < nominal % cores ? core : nominal % cores);
  int tickets = E * nc, count = tickets / cores + (core < tickets % cores);
  beginTicket = core * (tickets / cores) + (core < tickets % cores ? core : tickets % cores);
  endTicket = beginTicket + count;
  expert=beginTicket/nc;lastExpert=count?(endTicket-1)/nc+1:expert;start=expert&&count?(int)ends.GetValue(expert-1):0;loaded=false;
 }
 __aicore__ inline void Put(int i,uint64_t word){
  switch(i){case 0:d0=word;break;case 1:d1=word;break;case 2:d2=word;break;case 3:d3=word;break;case 4:d4=word;break;case 5:d5=word;break;case 6:d6=word;break;default:d7=word;break;}
 }
 __aicore__ inline uint64_t Word(int i){
  switch(i){case 0:return d0;case 1:return d1;case 2:return d2;case 3:return d3;case 4:return d4;case 5:return d5;case 6:return d6;default:return d7;}
 }
 __aicore__ inline int Prepare(int limit){
  int count=0;
  while(count<limit&&expert<lastExpert){
   if(!loaded){finish=(int)ends.GetValue(expert);firstColumn=beginTicket>expert*columns?beginTicket-expert*columns:0;lastColumn=endTicket<(expert+1)*columns?endTicket-expert*columns:columns;rowTile=0;column=firstColumn;loaded=true;}
   int row=start+rowTile*64;
   if(row>=finish){start=finish;++expert;loaded=false;continue;}
   int rows=finish-row;rows=rows<64?rows:64;Put(count++,(uint64_t)expert|((uint64_t)row<<7)|((uint64_t)column<<23)|((uint64_t)rows<<26));
   if(++column==lastColumn){column=firstColumn;++rowTile;if(start+rowTile*64>=finish){start=finish;++expert;loaded=false;}}
  }
  return count;
 }
 __aicore__ inline int Get(int task,int nc,int& e,int& row,int& col,int& rows){uint64_t word=Word(task);e=word&127;row=(word>>7)&65535;int column=(word>>23)&7;col=column*256;rows=(word>>26)&127;return workspaceBase+task;}
 __aicore__ inline int Row(int task,int nc){return (Word(task)>>7)&65535;}
 __aicore__ inline bool More(){return expert<lastExpert;}
};
__global__ __aicore__ void grouped_gelu_full_k(GM_ADDR x,GM_ADDR w,GM_ADDR scale,GM_ADDR y,GM_ADDR partial,int E,int M,int K,int N,int cores,GM_ADDR groups) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
    constexpr int BM=64,BN=256,Q=8192;
    int nc=N/BN;GroupTileMap map;map.Init(groups,E,M,nc,cores);
    int batchLimit=map.capacity;
    while(map.More()){
    int count=map.Prepare(batchLimit),offset=0;if(count==0)break;
    if ASCEND_IS_AIC {
        int core=GetBlockIdx();
        LocalTensor<int8_t> a1All(TPosition::A1,448*1024,BM*256*3),b1All(TPosition::B1,0,448*1024);
        LocalTensor<int8_t> a2(TPosition::A2,0,BM*256),b2(TPosition::B2,0,BN*256);
        LocalTensor<int32_t> cAll(TPosition::CO1,0,BM*BN*2);
        GlobalTensor<int8_t> ax,bw;GlobalTensor<int32_t> cg;
        ax.SetGlobalBuffer((__gm__ int8_t*)x);bw.SetGlobalBuffer((__gm__ int8_t*)w);cg.SetGlobalBuffer((__gm__ int32_t*)partial);
        int published=0;
        for(int slot=0;slot<3;++slot)SetFlag<HardEvent::MTE1_MTE2>((TEventID)slot);
        SetFlag<HardEvent::FIX_M>(EVENT_ID0);SetFlag<HardEvent::FIX_M>(EVENT_ID1);
        SetFlag<HardEvent::M_MTE1>(EVENT_ID0);SetFlag<HardEvent::M_MTE1>(EVENT_ID1);

        
        for(int preload=0;preload<3 && preload<count;++preload) {int loadTask=core+preload*cores,buffer=preload;loadTask=offset+loadTask/cores;int e,row,col,rows;map.Get(loadTask,nc,e,row,col,rows);
                auto a1=a1All[buffer*BM*256],b1=b1All[262144+buffer*BN*K];
                WaitFlag<HardEvent::MTE1_MTE2>((TEventID)buffer);
            Nd2NzParams ap;ap.ndNum=1;ap.nValue=rows;ap.dValue=K;ap.srcNdMatrixStride=0;ap.srcDValue=K;ap.dstNzC0Stride=BM;ap.dstNzNStride=1;ap.dstNzMatrixStride=0;
            DataCopy(a1,ax[(int64_t)row*K],ap);
            Nd2NzParams bp;bp.ndNum=K/32;bp.nValue=32;bp.dValue=BN;bp.srcNdMatrixStride=32*N;bp.srcDValue=N;bp.dstNzC0Stride=32;bp.dstNzNStride=1;bp.dstNzMatrixStride=32*BN;
            DataCopy(b1,bw[(int64_t)e*K*N+col],bp);
            SetFlag<HardEvent::MTE2_MTE1>((TEventID)buffer);
        }
        for(int first=3;first<count;){
            int task=offset+first,e,row,col,rows;map.Get(task,nc,e,row,col,rows);
            int64_t source=(int64_t)e*K*N+col;int run=1;
            while(first+run<count){int next=offset+first+run,ne,nrow,ncol,nrows;map.Get(next,nc,ne,nrow,ncol,nrows);int64_t addr=(int64_t)ne*K*N+ncol;if(addr!=source+(int64_t)run*K*N)break;++run;}
            Nd2NzParams bp;bp.ndNum=run*(K/32);bp.nValue=32;bp.dValue=BN;bp.srcNdMatrixStride=32*N;bp.srcDValue=N;bp.dstNzC0Stride=32;bp.dstNzNStride=1;bp.dstNzMatrixStride=32*BN;
            DataCopy(b1All[(first-3)*BN*K],bw[source],bp);first+=run;
        }

        for(int task=core;task/cores<count;task+=cores) {
            int mapped=offset+task/cores,e,row,col,rows;int storage=map.Get(mapped,nc,e,row,col,rows);int slot=published%2;
            auto event=(TEventID)slot;int inputSlot=published%3;WaitFlag<HardEvent::MTE2_MTE1>((TEventID)inputSlot);
            auto a1=a1All[inputSlot*BM*256],b1=b1All[published<3?262144+published*BN*K:(published-3)*BN*K];auto c=cAll[slot*BM*BN];

            
            if(task/cores+2<count && published>=1) {int loadTask=task+2*cores,buffer=(published+2)%3;loadTask=offset+loadTask/cores;int e,row,col,rows;map.Get(loadTask,nc,e,row,col,rows);
                auto a1=a1All[buffer*BM*256];
                WaitFlag<HardEvent::MTE1_MTE2>((TEventID)buffer);
            Nd2NzParams ap;ap.ndNum=1;ap.nValue=rows;ap.dValue=K;ap.srcNdMatrixStride=0;ap.srcDValue=K;ap.dstNzC0Stride=BM;ap.dstNzNStride=1;ap.dstNzMatrixStride=0;
            DataCopy(a1,ax[(int64_t)row*K],ap);
            SetFlag<HardEvent::MTE2_MTE1>((TEventID)buffer);
            }
            WaitFlag<HardEvent::FIX_M>(event);
            for(int k0=0,j=0;k0<K;k0+=256,++j) {
                int packet=K-k0<256?K-k0:256;
                WaitFlag<HardEvent::M_MTE1>((TEventID)j);
                LoadData3DParamsV2<int8_t> al;
                al.l1H = 1;
                al.l1W = BM;
                al.channelSize = K;
                al.kExtension = packet;
                al.mExtension = BM;
                al.kStartPt = k0;
                al.mStartPt = 0;
                al.strideW = 1;
                al.strideH = 1;
                al.filterW = 1;
                al.filterH = 1;
                al.dilationFilterW = 1;
                al.dilationFilterH = 1;
                al.padList[0] = 0;
                al.padList[1] = 0;
                al.padList[2] = 0;
                al.padList[3] = 0;
                al.enTranspose = false;
                al.enSmallK = false;
                al.padValue = 0;
                LoadData(a2[j * BM * 128], a1, al);
                LoadData2dTransposeParams bl;
                bl.startIndex = 0;
                bl.repeatTimes = packet * BN / 1024;
                bl.srcStride = 1;
                bl.dstGap = 1;
                bl.dstFracGap = 0;
                LoadDataWithTranspose(b2[j * BN * 128], b1[k0 * BN], bl);
                SetFlag<HardEvent::MTE1_M>(EVENT_ID0);
                WaitFlag<HardEvent::MTE1_M>(EVENT_ID0);
                MmadParams mp;
                mp.m = BM;
                mp.n = BN;
                mp.k = packet;
                mp.cmatrixInitVal = k0 == 0;
                Mmad(c, a2[j * BM * 128], b2[j * BN * 128], mp);
                SetFlag<HardEvent::M_MTE1>((TEventID)j);
            }
            SetFlag<HardEvent::MTE1_MTE2>((TEventID)inputSlot);
            SetFlag<HardEvent::M_FIX>(EVENT_ID0);WaitFlag<HardEvent::M_FIX>(EVENT_ID0);

            FixpipeParamsV220 fp;fp.nSize=BN;fp.mSize=BM;fp.srcStride=BM;fp.dstStride=BN;fp.ndNum=1;fp.srcNdStride=0;fp.dstNdStride=0;
            Fixpipe(cg[storage*BM*BN],c,fp);SetFlag<HardEvent::FIX_M>(event);CrossCoreSetFlag<2,PIPE_FIX>(8+published);++published;
        }
        

        WaitFlag<HardEvent::FIX_M>(EVENT_ID0);WaitFlag<HardEvent::FIX_M>(EVENT_ID1);
        WaitFlag<HardEvent::M_MTE1>(EVENT_ID0);WaitFlag<HardEvent::M_MTE1>(EVENT_ID1);
        for(int slot=0;slot<3;++slot)WaitFlag<HardEvent::MTE1_MTE2>((TEventID)slot);
    } else {
        int core=GetBlockIdx()/2,sub=GetBlockIdx()%2;
        LocalTensor<float> zAll(TPosition::VECCALC,0,Q*2),a(TPosition::VECCALC,65792,Q),b(TPosition::VECCALC,98816,Q),scaleAll(TPosition::VECCALC,164608,BN*2+32);
        LocalTensor<half> out(TPosition::VECCALC,131584,Q*2);
        LocalTensor<uint8_t> m1(TPosition::VECCALC,166784,Q/8),m2(TPosition::VECCALC,167808,Q/8);
        LocalTensor<int16_t> ramp(TPosition::VECCALC,168832,Q/32);
        GlobalTensor<int32_t> cg;GlobalTensor<float> sg;GlobalTensor<half> yg;
        cg.SetGlobalBuffer((__gm__ int32_t*)partial);sg.SetGlobalBuffer((__gm__ float*)scale);yg.SetGlobalBuffer((__gm__ half*)y);
        SetFlag<HardEvent::MTE3_V>(EVENT_ID0);SetFlag<HardEvent::MTE3_V>(EVENT_ID1);SetFlag<HardEvent::V_MTE2>(EVENT_ID0);SetFlag<HardEvent::V_MTE2>(EVENT_ID1);
        auto coefficients=scaleAll[2*BN];
        Duplicate(coefficients,-0.07135481627260025f,8);Duplicate(coefficients[8],-1.5957691216057308f,8);PipeBarrier<PIPE_V>();
        auto tieBits=coefficients[16].ReinterpretCast<uint16_t>(),nearBits=coefficients[24].ReinterpretCast<uint16_t>();
        Duplicate(tieBits.ReinterpretCast<uint32_t>(),(uint32_t)0xff001ffc,8);Duplicate(nearBits.ReinterpretCast<uint32_t>(),(uint32_t)0xff8000ff,8);PipeBarrier<PIPE_V>();
        for(int j=0;j<16;++j)ramp.SetValue(j,j);
        SetFlag<HardEvent::S_V>(EVENT_ID2);WaitFlag<HardEvent::S_V>(EVENT_ID2);
        for(int span=16;span<Q/32;span*=2){Adds(ramp[span],ramp,(int16_t)span,span);PipeBarrier<PIPE_V>();}
        LocalTensor<int32_t> pendingIndices(TPosition::VECCALC,185216,32);LocalTensor<float> pendingValues(TPosition::VECCALC,185344,32);
        int pendingCount=-1,pendingSlot=0,pendingRow=0,pendingCol=0,pendingRows=0;
        int sequence=0;
        for(int task=core;task/cores<count;task+=cores) {
            int mapped=offset+task/cores,e,row,col,rows;int storage=map.Get(mapped,nc,e,row,col,rows);row+=sub*32;rows-=sub*32;rows=rows<0?0:(rows>32?32:rows);int slot=sequence%2,n=Q;
            auto z=zAll[slot*Q],scales=scaleAll[slot*BN];
            if(sequence==0) {
                WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
                DataCopy(scales,sg[(int64_t)e*N+col],BN);
                CrossCoreWaitFlag<2>(8);DataCopy(z.ReinterpretCast<int32_t>(),cg[storage*BM*BN+sub*Q],Q);
                SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
            }
            WaitFlag<HardEvent::MTE2_V>((TEventID)slot);
            Cast(z,z.ReinterpretCast<int32_t>(),RoundMode::CAST_RINT,Q);PipeBarrier<PIPE_V>();
            for(int col0=0;col0<BN;col0+=64)Mul(z[col0],z[col0],scales[col0],(uint64_t)64,(uint8_t)32,BinaryRepeatParams{1,1,1,32,32,0});
            PipeBarrier<PIPE_V>();WaitFlag<HardEvent::MTE3_V>(slot?EVENT_ID1:EVENT_ID0);
            
    Mul(a,z,z,n);PipeBarrier<PIPE_V>();
    Muls(a,a,-0.07135481627260025f,n);PipeBarrier<PIPE_V>();
    Adds(a,a,-1.5957691216057308f,n);PipeBarrier<PIPE_V>();
    Mul(a,a,z,n);PipeBarrier<PIPE_V>();
    Exp(a,a,n);PipeBarrier<PIPE_V>();
    Adds(a,a,1.0f,n);PipeBarrier<PIPE_V>();
    Div(a,z,a,n);PipeBarrier<PIPE_V>();
    Cast(out[slot*Q],a,RoundMode::CAST_RINT,n);
    if(task/cores+1<count) {
        int next=offset+task/cores+1,nextSlot=1-slot,nextExpert,nextRow,nextCol,nextRows;int nextStorage=map.Get(next,nc,nextExpert,nextRow,nextCol,nextRows);
        WaitFlag<HardEvent::V_MTE2>((TEventID)nextSlot);
        CrossCoreWaitFlag<2>(9+sequence);
        DataCopy(scaleAll[nextSlot*BN],sg[(int64_t)nextExpert*N+nextCol],BN);
        DataCopy(zAll[nextSlot*Q].ReinterpretCast<int32_t>(),cg[nextStorage*BM*BN+sub*Q],Q);
        SetFlag<HardEvent::MTE2_V>((TEventID)nextSlot);
    }
    SetFlag<HardEvent::V_MTE3>(EVENT_ID2);WaitFlag<HardEvent::V_MTE3>(EVENT_ID2);
    if(rows>0)DataCopyPad(yg[(int64_t)row*N+col],out[slot*Q],DataCopyExtParams{(uint16_t)rows,BN*2,0,(uint32_t)((N-BN)*2),0});
    SetFlag<HardEvent::MTE3_V>((TEventID)slot);
            SetFlag<HardEvent::V_MTE2>(slot?EVENT_ID1:EVENT_ID0);++sequence;
        }
        WaitFlag<HardEvent::V_MTE2>(EVENT_ID1);WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);WaitFlag<HardEvent::MTE3_V>(EVENT_ID1);
    }
    PipeBarrier<PIPE_ALL>();
    if(map.More()){if ASCEND_IS_AIV {CrossCoreSetFlag<2,PIPE_MTE3>(2);}else {CrossCoreWaitFlag<2>(2);}}
    }
}

__global__ __aicore__ void grouped_gelu_resident_a(GM_ADDR x,GM_ADDR w,GM_ADDR scale,GM_ADDR y,GM_ADDR partial,int E,int M,int K,int N,int cores,GM_ADDR groups) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
    if ASCEND_IS_AIV {
        LocalTensor<int8_t> sws(TPosition::VECCALC, 0, 32768);
        GlobalTensor<int8_t> swt;
        swt.SetGlobalBuffer((__gm__ int8_t *)w);
        int tot = E * K * N;
        int blk = (tot + 32767) / 32768;
        for (int i = GetBlockIdx(); i < blk / 8; i += 40) {
            int off = i * 32768;
            int cnt = tot - off < 32768 ? tot - off : 32768;
            DataCopyPad(sws, swt[off], DataCopyExtParams{1, (uint32_t)cnt, 0, 0, 0},
                        DataCopyPadExtParams<int8_t>{false, 0, 0, 0});
        }
    }
    constexpr int BM=64,BN=256,Q=8192;
    int nc=N/BN;GroupTileMap map;map.Init(groups,E,M,nc,cores);
    int batchLimit=map.capacity;
    while(map.More()){
    int count=map.Prepare(batchLimit),offset=0;if(count==0)break;
    if ASCEND_IS_AIC {
        constexpr int LK=512;
        int core=GetBlockIdx(),published=0,previousRow=-1;
        LocalTensor<int8_t> a1(TPosition::A1,0,262144),b1(TPosition::B1,262144,2*BN*LK);
        LocalTensor<int8_t> a2(TPosition::A2,0,BM*256),b2(TPosition::B2,0,BN*256);
        LocalTensor<int32_t> cAll(TPosition::CO1,0,BM*BN*2);
        GlobalTensor<int8_t> ax,bw;GlobalTensor<int32_t> cg;
        ax.SetGlobalBuffer((__gm__ int8_t*)x);bw.SetGlobalBuffer((__gm__ int8_t*)w);cg.SetGlobalBuffer((__gm__ int32_t*)partial);
        SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID1);SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID2);
        SetFlag<HardEvent::FIX_M>(EVENT_ID0);SetFlag<HardEvent::FIX_M>(EVENT_ID1);
        SetFlag<HardEvent::M_MTE1>(EVENT_ID0);SetFlag<HardEvent::M_MTE1>(EVENT_ID1);
        if(count>0){
            int e,row,col,rows;map.Get(offset,nc,e,row,col,rows);
            WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID2);
            Nd2NzParams ap;ap.ndNum=1;ap.nValue=rows;ap.dValue=K;ap.srcNdMatrixStride=0;ap.srcDValue=K;ap.dstNzC0Stride=BM;ap.dstNzNStride=1;ap.dstNzMatrixStride=0;
            DataCopy(a1,ax[(int64_t)row*K],ap);SetFlag<HardEvent::MTE2_MTE1>(EVENT_ID2);
            WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);
            int firstK=K<LK?K:LK;
            Nd2NzParams bp;bp.ndNum=firstK/32;bp.nValue=32;bp.dValue=BN;bp.srcNdMatrixStride=32*N;bp.srcDValue=N;bp.dstNzC0Stride=32;bp.dstNzNStride=1;bp.dstNzMatrixStride=32*BN;
            DataCopy(b1,bw[(int64_t)e*K*N+col],bp);SetFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);
            }

        for(int task=offset;task<offset+count;++task) {
            int e,row,col,rows;int storage=map.Get(task,nc,e,row,col,rows);int slot=published%2;
            auto event=(TEventID)slot;auto c=cAll[slot*BM*BN];
            WaitFlag<HardEvent::FIX_M>(event);if(task==offset || row!=previousRow)WaitFlag<HardEvent::MTE2_MTE1>(EVENT_ID2);
            for(int g=0,base=0;base<K;base+=LK,++g) {
                int buf=g%2,groupK=K-base<LK?K-base:LK;
                WaitFlag<HardEvent::MTE2_MTE1>((TEventID)buf);
                if(base+LK<K) {
                    int next=1-buf,len=K-base-LK<LK?K-base-LK:LK;
                    WaitFlag<HardEvent::MTE1_MTE2>((TEventID)next);
                    Nd2NzParams np;np.ndNum=len/32;np.nValue=32;np.dValue=BN;np.srcNdMatrixStride=32*N;np.srcDValue=N;np.dstNzC0Stride=32;np.dstNzNStride=1;np.dstNzMatrixStride=32*BN;
                    DataCopy(b1[next*BN*LK],bw[(int64_t)e*K*N+(int64_t)(base+LK)*N+col],np);SetFlag<HardEvent::MTE2_MTE1>((TEventID)next);
                }
                if(base+LK>=K && task+1<offset+count) {
                    int nextTask=task+1,ne,nrow,ncol,nrows;map.Get(nextTask,nc,ne,nrow,ncol,nrows);
                    WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);
                    Nd2NzParams nb;nb.ndNum=(K<LK?K:LK)/32;nb.nValue=32;nb.dValue=BN;nb.srcNdMatrixStride=32*N;nb.srcDValue=N;nb.dstNzC0Stride=32;nb.dstNzNStride=1;nb.dstNzMatrixStride=32*BN;
                    DataCopy(b1,bw[(int64_t)ne*K*N+ncol],nb);SetFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);
                }
                for(int p=0;p<groupK;p+=128) {
                    int k0=base+p,j=(k0/128)%2,packet=groupK-p<128?groupK-p:128;
                    WaitFlag<HardEvent::M_MTE1>((TEventID)j);
                    LoadData3DParamsV2<int8_t> al;
                    al.l1H = 1;
                    al.l1W = BM;
                    al.channelSize = K;
                    al.kExtension = packet;
                    al.mExtension = BM;
                    al.kStartPt = k0;
                    al.mStartPt = 0;
                    al.strideW = 1;
                    al.strideH = 1;
                    al.filterW = 1;
                    al.filterH = 1;
                    al.dilationFilterW = 1;
                    al.dilationFilterH = 1;
                    al.padList[0] = 0;
                    al.padList[1] = 0;
                    al.padList[2] = 0;
                    al.padList[3] = 0;
                    al.enTranspose = false;
                    al.enSmallK = false;
                    al.padValue = 0;
                    LoadData(a2[j*BM*128],a1,al);
                    LoadData2dTransposeParams bl;bl.startIndex=0;bl.repeatTimes=packet*BN/1024;bl.srcStride=1;bl.dstGap=1;bl.dstFracGap=0;
                    LoadDataWithTranspose(b2[j*BN*128],b1[buf*BN*LK+p*BN],bl);
                    SetFlag<HardEvent::MTE1_M>(EVENT_ID0);WaitFlag<HardEvent::MTE1_M>(EVENT_ID0);
                    MmadParams mp;mp.m=BM;mp.n=BN;mp.k=packet;mp.cmatrixInitVal=k0==0;Mmad(c,a2[j*BM*128],b2[j*BN*128],mp);SetFlag<HardEvent::M_MTE1>((TEventID)j);
                }
                SetFlag<HardEvent::MTE1_MTE2>((TEventID)buf);
            }
            if(task+1==offset+count || map.Row(task+1,nc)!=row)SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID2);
            if(task+1<offset+count && map.Row(task+1,nc)!=row) {
                int nextTask=task+1,ne,nrow,ncol,nrows;map.Get(nextTask,nc,ne,nrow,ncol,nrows);
                WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID2);
                Nd2NzParams na;na.ndNum=1;na.nValue=nrows;na.dValue=K;na.srcNdMatrixStride=0;na.srcDValue=K;na.dstNzC0Stride=BM;na.dstNzNStride=1;na.dstNzMatrixStride=0;
                DataCopy(a1,ax[(int64_t)nrow*K],na);SetFlag<HardEvent::MTE2_MTE1>(EVENT_ID2);
            }
            SetFlag<HardEvent::M_FIX>(EVENT_ID0);WaitFlag<HardEvent::M_FIX>(EVENT_ID0);
            FixpipeParamsV220 fp;fp.nSize=BN;fp.mSize=BM;fp.srcStride=BM;fp.dstStride=BN;fp.ndNum=1;fp.srcNdStride=0;fp.dstNdStride=0;
            Fixpipe(cg[storage*BM*BN],c,fp);SetFlag<HardEvent::FIX_M>(event);CrossCoreSetFlag<2,PIPE_FIX>(8+published);++published;previousRow=row;
        }
        WaitFlag<HardEvent::FIX_M>(EVENT_ID0);WaitFlag<HardEvent::FIX_M>(EVENT_ID1);
        WaitFlag<HardEvent::M_MTE1>(EVENT_ID0);WaitFlag<HardEvent::M_MTE1>(EVENT_ID1);
        WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID1);WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID2);
    } else {
        int core=GetBlockIdx()/2,sub=GetBlockIdx()%2;
        LocalTensor<float> zAll(TPosition::VECCALC,0,Q*2),a(TPosition::VECCALC,65792,Q),b(TPosition::VECCALC,98688,Q),scaleAll(TPosition::VECCALC,164608,BN*2+32);
        LocalTensor<half> out(TPosition::VECCALC,131584,Q*2);
        LocalTensor<uint8_t> m1(TPosition::VECCALC,166784,Q/8),m2(TPosition::VECCALC,167808,Q/8);
        LocalTensor<int16_t> ramp(TPosition::VECCALC,168832,Q);
        GlobalTensor<int32_t> cg;GlobalTensor<float> sg;GlobalTensor<half> yg;
        cg.SetGlobalBuffer((__gm__ int32_t*)partial);sg.SetGlobalBuffer((__gm__ float*)scale);yg.SetGlobalBuffer((__gm__ half*)y);
        SetFlag<HardEvent::MTE3_V>(EVENT_ID0);SetFlag<HardEvent::MTE3_V>(EVENT_ID1);SetFlag<HardEvent::V_MTE2>(EVENT_ID0);SetFlag<HardEvent::V_MTE2>(EVENT_ID1);
        auto coefficients=scaleAll[2*BN];
        Duplicate(coefficients,-0.07135481627260025f,8);Duplicate(coefficients[8],-1.5957691216057308f,8);PipeBarrier<PIPE_V>();
        auto tieBits=coefficients[16].ReinterpretCast<uint16_t>(),nearBits=coefficients[24].ReinterpretCast<uint16_t>();
        Duplicate(tieBits.ReinterpretCast<uint32_t>(),(uint32_t)0xff001ff8,8);Duplicate(nearBits.ReinterpretCast<uint32_t>(),(uint32_t)0xff8000ff,8);PipeBarrier<PIPE_V>();
        for(int j=0;j<16;++j)ramp.SetValue(j,j);
        SetFlag<HardEvent::S_V>(EVENT_ID2);WaitFlag<HardEvent::S_V>(EVENT_ID2);
        for(int span=16;span<Q;span*=2){Adds(ramp[span],ramp,(int16_t)span,span);PipeBarrier<PIPE_V>();}
        LocalTensor<int32_t> pendingIndices(TPosition::VECCALC,185216,32);LocalTensor<float> pendingValues(TPosition::VECCALC,185344,32);
        int pendingCount=-1,pendingSlot=0,pendingRow=0,pendingCol=0,pendingRows=0;
        int sequence=0;
        for(int task=offset;task<offset+count;++task) {
            int e,row,col,rows;int storage=map.Get(task,nc,e,row,col,rows);row+=sub*32;rows-=sub*32;rows=rows<0?0:(rows>32?32:rows);int slot=sequence%2,n=Q;
            auto z=zAll[slot*Q],scales=scaleAll[slot*BN];
            if(sequence==0) {
                WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
                DataCopy(scales,sg[(int64_t)e*N+col],BN);
                CrossCoreWaitFlag<2>(8);DataCopy(z.ReinterpretCast<int32_t>(),cg[storage*BM*BN+sub*Q],Q);
                SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
            }
            WaitFlag<HardEvent::MTE2_V>((TEventID)slot);
            Cast(z,z.ReinterpretCast<int32_t>(),RoundMode::CAST_RINT,Q);PipeBarrier<PIPE_V>();
            for(int col0=0;col0<BN;col0+=64)Mul(z[col0],z[col0],scales[col0],(uint64_t)64,(uint8_t)32,BinaryRepeatParams{1,1,1,32,32,0});
            PipeBarrier<PIPE_V>();WaitFlag<HardEvent::MTE3_V>(slot?EVENT_ID1:EVENT_ID0);
            
    Mul(a,z,z,n);PipeBarrier<PIPE_V>();
    FusedMulAdd(a,coefficients,coefficients[8],(uint64_t)64,(uint8_t)(Q/64),BinaryRepeatParams{1,0,0,8,0,0});PipeBarrier<PIPE_V>();
    Mul(a,a,z,n);PipeBarrier<PIPE_V>();

    Exp(b,a,n);PipeBarrier<PIPE_V>();
    Adds(a,b,1.0f,n);PipeBarrier<PIPE_V>();
    Div(b,z,a,n);PipeBarrier<PIPE_V>();
    Adds(a.ReinterpretCast<int32_t>(),b.ReinterpretCast<int32_t>(),(int32_t)4,n);PipeBarrier<PIPE_V>();
    And(a.ReinterpretCast<uint16_t>(),a.ReinterpretCast<uint16_t>(),tieBits,(uint64_t)128,(uint8_t)(Q/64),BinaryRepeatParams{1,1,0,8,8,0});PipeBarrier<PIPE_V>();
    CompareScalar(m1,a.ReinterpretCast<int32_t>(),(int32_t)0x40001000,CMPMODE::EQ,n);PipeBarrier<PIPE_V>();
    Adds(a,b,-0.001953125f,n);PipeBarrier<PIPE_V>();
    And(a.ReinterpretCast<uint16_t>(),a.ReinterpretCast<uint16_t>(),nearBits,(uint64_t)128,(uint8_t)(Q/64),BinaryRepeatParams{1,1,0,8,8,0});PipeBarrier<PIPE_V>();
    CompareScalar(m2,a.ReinterpretCast<int32_t>(),(int32_t)0xbb000080,CMPMODE::EQ,n);PipeBarrier<PIPE_V>();
    Or(m1.ReinterpretCast<uint16_t>(),m1.ReinterpretCast<uint16_t>(),m2.ReinterpretCast<uint16_t>(),n/16);PipeBarrier<PIPE_V>();
    uint64_t selectedCount=0;
    SetMaskCount();SetVectorMask<int16_t,MaskMode::COUNTER>(0,n);
    GatherMask(a.ReinterpretCast<int16_t>(),ramp,m1.ReinterpretCast<int16_t>(),(uint8_t)0,GatherMaskParams{1,1,8,0});
    SetMaskNorm();ResetMask();
    Cast(out[slot*Q],b,RoundMode::CAST_RINT,n);PipeBarrier<PIPE_V>();
    if(task+1<offset+count) {
        int next=task+1,nextSlot=1-slot,nextExpert,nextRow,nextCol,nextRows;int nextStorage=map.Get(next,nc,nextExpert,nextRow,nextCol,nextRows);
        WaitFlag<HardEvent::V_MTE2>((TEventID)nextSlot);
        CrossCoreWaitFlag<2>(9+sequence);
        DataCopy(scaleAll[nextSlot*BN],sg[(int64_t)nextExpert*N+nextCol],BN);
        DataCopy(zAll[nextSlot*Q].ReinterpretCast<int32_t>(),cg[nextStorage*BM*BN+sub*Q],Q);
        SetFlag<HardEvent::MTE2_V>((TEventID)nextSlot);
    }
    {if(pendingCount>=0){
            for(int j=0;j<pendingCount;++j) {
                int index=pendingIndices.GetValue(j);union {float f;uint32_t u;} v;v.f=pendingValues.GetValue(j);
                if(v.f>=0.0f){out[pendingSlot*Q].SetValue(index,(half)DenseMath::MidpointGeluRounded(v.f));}
                else out[pendingSlot*Q].SetValue(index,(half)DenseMath::MidpointGeluRounded(v.f));
            }
            SetFlag<HardEvent::S_MTE3>(EVENT_ID2);WaitFlag<HardEvent::S_MTE3>(EVENT_ID2);
            if(pendingRows>0)DataCopyPad(yg[(int64_t)pendingRow*N+pendingCol],out[pendingSlot*Q],DataCopyExtParams{(uint16_t)pendingRows,BN*2,0,(uint32_t)((N-BN)*2),0});
            SetFlag<HardEvent::MTE3_V>((TEventID)pendingSlot);pendingCount=-1;

}}
    SetFlag<HardEvent::V_S>(EVENT_ID2);WaitFlag<HardEvent::V_S>(EVENT_ID2);
    selectedCount=(uint64_t)GetGatherMaskRemainCount();
    if(selectedCount<=32) {
        pendingCount=0;pendingSlot=slot;pendingRow=row;pendingCol=col;pendingRows=rows;
        for(uint64_t j=0;j<selectedCount;++j) {
            int index=a.ReinterpretCast<int16_t>().GetValue(j);float value=z.GetValue(index);
            if((value>=0.0f) || (value<0.0f && b.GetValue(index)>-0.00006103515625f)) {
                pendingIndices.SetValue(pendingCount,index);pendingValues.SetValue(pendingCount,value);++pendingCount;
            }
        }
    } else {
    for(uint64_t j=0;j<selectedCount;++j) {
        int index=a.ReinterpretCast<int16_t>().GetValue(j);
        union {float f;uint32_t u;} v;v.f=z.GetValue(index);
        if(v.f>=0.0f){out[slot*Q].SetValue(index,(half)DenseMath::MidpointGeluRounded(v.f));}
        else if(v.f<0.0f && b.GetValue(index)>-0.00006103515625f)out[slot*Q].SetValue(index,(half)DenseMath::MidpointGeluRounded(v.f));
    }
        SetFlag<HardEvent::S_MTE3>(EVENT_ID2);WaitFlag<HardEvent::S_MTE3>(EVENT_ID2);
        if(rows>0)DataCopyPad(yg[(int64_t)row*N+col],out[slot*Q],DataCopyExtParams{(uint16_t)rows,BN*2,0,(uint32_t)((N-BN)*2),0});
        SetFlag<HardEvent::MTE3_V>((TEventID)slot);
    }



            
            SetFlag<HardEvent::V_MTE2>(slot?EVENT_ID1:EVENT_ID0);++sequence;
        }
        {if(pendingCount>=0){
            for(int j=0;j<pendingCount;++j) {
                int index=pendingIndices.GetValue(j);union {float f;uint32_t u;} v;v.f=pendingValues.GetValue(j);
                if(v.f>=0.0f){out[pendingSlot*Q].SetValue(index,(half)DenseMath::MidpointGeluRounded(v.f));}
                else out[pendingSlot*Q].SetValue(index,(half)DenseMath::MidpointGeluRounded(v.f));
            }
            SetFlag<HardEvent::S_MTE3>(EVENT_ID2);WaitFlag<HardEvent::S_MTE3>(EVENT_ID2);
            if(pendingRows>0)DataCopyPad(yg[(int64_t)pendingRow*N+pendingCol],out[pendingSlot*Q],DataCopyExtParams{(uint16_t)pendingRows,BN*2,0,(uint32_t)((N-BN)*2),0});
            SetFlag<HardEvent::MTE3_V>((TEventID)pendingSlot);pendingCount=-1;

}}
        WaitFlag<HardEvent::V_MTE2>(EVENT_ID1);WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);WaitFlag<HardEvent::MTE3_V>(EVENT_ID1);
    }
    PipeBarrier<PIPE_ALL>();
    if(map.More()){if ASCEND_IS_AIV {CrossCoreSetFlag<2,PIPE_MTE3>(2);}else {CrossCoreWaitFlag<2>(2);}}
    }
}

namespace VariablePacked {
template<int BM,int BN> __aicore__ inline void FinishDirect(GM_ADDR partial,GM_ADDR scale,GM_ADDR y,int e,int start,int expertRows,int col,int N,int task,int sequence){
    constexpr int Q=BM*BN/2;

        int sub=GetBlockIdx()%2;
        int row=start+sub*(BM/2);
        int rows=expertRows-sub*(BM/2);rows=rows<BM/2?rows:BM/2;int cols=N-col<BN?N-col:BN;if(rows<=0){CrossCoreWaitFlag<2>(8+2*(sequence%2));CrossCoreSetFlag<2,PIPE_MTE2>(9+2*(sequence%2));return;}
        LocalTensor<float> z(TPosition::VECCALC,0,Q),a(TPosition::VECCALC,37120,Q),b(TPosition::VECCALC,74240,Q),coefficients(TPosition::VECCALC,151040,32),scales(TPosition::VECCALC,151296,BN);
        LocalTensor<half> out(TPosition::VECCALC,111360,Q);LocalTensor<int16_t> ramp(TPosition::VECCALC,130048,Q);
        LocalTensor<uint8_t> m1(TPosition::VECCALC,148736,Q/8),m2(TPosition::VECCALC,149888,Q/8);
        GlobalTensor<int32_t> cg;GlobalTensor<float> sg;GlobalTensor<half> yg;cg.SetGlobalBuffer((__gm__ int32_t*)partial);sg.SetGlobalBuffer((__gm__ float*)scale);yg.SetGlobalBuffer((__gm__ half*)y);
        auto tieBits=coefficients[16].ReinterpretCast<uint16_t>(),nearBits=coefficients[24].ReinterpretCast<uint16_t>();
        {
        Duplicate(z.ReinterpretCast<int32_t>(),0,Q);Duplicate(scales,0.0f,BN);Duplicate(coefficients,-0.07135481627260025f,8);Duplicate(coefficients[8],-1.5957691216057308f,8);PipeBarrier<PIPE_V>();
Duplicate(tieBits.ReinterpretCast<uint32_t>(),(uint32_t)0xff001ff8,8);Duplicate(nearBits.ReinterpretCast<uint32_t>(),(uint32_t)0xff8000ff,8);
        for(int i=0;i<16;++i)ramp.SetValue(i,i);SetFlag<HardEvent::S_V>(EVENT_ID2);WaitFlag<HardEvent::S_V>(EVENT_ID2);
        for(int span=16;span<Q/32;span*=2){int count=Q/32-span<span?Q/32-span:span;Adds(ramp[span],ramp,(int16_t)span,count);PipeBarrier<PIPE_V>();}
        }
        SetFlag<HardEvent::V_MTE2>(EVENT_ID0);WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
        DataCopyPad(scales,sg[(int64_t)e*N+col],DataCopyExtParams{1,(uint32_t)(cols*4),0,0,0},DataCopyPadExtParams<float>{true,0,(uint8_t)((8-cols%8)%8),0});
        CrossCoreWaitFlag<2>(8+2*(sequence%2));
        int pitch=(cols+31)/32*32;int aligned=(cols+7)/8*8;
        DataCopyPad(z.ReinterpretCast<int32_t>(), cg[(int64_t)task * BM * BN + sub * Q],
                    DataCopyExtParams{(uint16_t)rows, (uint32_t)(cols * 4), (uint32_t)((BN - cols) * 4),
                                      (uint32_t)((pitch - aligned) / 8), 0},
                    DataCopyPadExtParams<int32_t>{true, 0, (uint8_t)(aligned - cols), 0});
        CrossCoreSetFlag<2,PIPE_MTE2>(9+2*(sequence%2));
        SetFlag<HardEvent::MTE2_V>(EVENT_ID0);WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
        int count=(rows*pitch+63)/64*64;Cast(z,z.ReinterpretCast<int32_t>(),RoundMode::CAST_RINT,count);PipeBarrier<PIPE_V>();
        for(int c=0;c<pitch;c+=64)Mul(z[c],z[c],scales[c],(uint64_t)(pitch-c<64?pitch-c:64),(uint8_t)rows,BinaryRepeatParams{1,1,1,(uint8_t)(pitch/8),(uint8_t)(pitch/8),0});PipeBarrier<PIPE_V>();
        int n=count;
    Mul(a,z,z,n);PipeBarrier<PIPE_V>();
    Muls(a,a,-0.07135481627260025f,n);PipeBarrier<PIPE_V>();
    Adds(a,a,-1.5957691216057308f,n);PipeBarrier<PIPE_V>();
    Mul(a,a,z,n);PipeBarrier<PIPE_V>();

    Exp(b,a,n);PipeBarrier<PIPE_V>();
    Adds(a,b,1.0f,n);PipeBarrier<PIPE_V>();
    Div(b,z,a,n);PipeBarrier<PIPE_V>();
    Cast(out,b,RoundMode::CAST_RINT,n);PipeBarrier<PIPE_V>();
 SetFlag<HardEvent::V_MTE3>(EVENT_ID2);WaitFlag<HardEvent::V_MTE3>(EVENT_ID2);
 uint64_t selectedCount=0;
        SetFlag<HardEvent::S_MTE3>(EVENT_ID2);WaitFlag<HardEvent::S_MTE3>(EVENT_ID2);
        DataCopyPad(yg[(int64_t)row*N+col],out,DataCopyExtParams{(uint16_t)rows,(uint32_t)(cols*2),(uint32_t)((pitch-(cols+15)/16*16)/16),(uint32_t)((N-cols)*2),0});
    
}


__aicore__ inline void ReadWeightRows(LocalTensor<int8_t> raw,GlobalTensor<int8_t> src,int task,int nk,int R,int K,int N,int begin,int finish){
 int e=task/nk,k0=begin+(task%nk)*R,valid=finish-k0<R?finish-k0:R;
 if(valid<R){Duplicate(raw.ReinterpretCast<int32_t>(),0,69888/4);SetFlag<HardEvent::V_MTE2>(EVENT_ID3);WaitFlag<HardEvent::V_MTE2>(EVENT_ID3);}
 for(int offset=0;offset<4;++offset)if(valid*N>offset)DataCopyPad(raw[offset*17472],src[((int64_t)e*K+k0)*N+offset],DataCopyExtParams{1,(uint32_t)(valid*N-offset),0,0,0},DataCopyPadExtParams<int8_t>{false,0,0,0});
}
__aicore__ inline void PackWeight(GM_ADDR w,GM_ADDR packed,int E,int M,int K,int N,int cores,int begin,int finish){
 int pk=(K+31)/32*32,pn=(N+31)/32*32,R=32;
 while(R*N>17408)R/=2;
 int nk=(finish-begin+R-1)/R,total=E*nk,stride=1,count=R*pn/4;
 LocalTensor<int8_t> raw(TPosition::VECCALC,0,139776);
 LocalTensor<uint32_t> index(TPosition::VECCALC,139776,4608);
 LocalTensor<uint32_t> out(TPosition::VECCALC,158208,9216);
 for(int j=0;j<8;++j)index.SetValue(j,j*4);
 SetFlag<HardEvent::S_V>(EVENT_ID3);WaitFlag<HardEvent::S_V>(EVENT_ID3);
 for(int r=1;r<R && r<4;++r)Adds(index.ReinterpretCast<int32_t>()[r*8],index.ReinterpretCast<int32_t>(),(int32_t)(r*N/4*4+(r*N%4)*17472),8);PipeBarrier<PIPE_V>();
 for(int r=4;r<R;r*=2){Adds(index.ReinterpretCast<int32_t>()[r*8],index.ReinterpretCast<int32_t>(),(int32_t)(r*N),r*8);PipeBarrier<PIPE_V>();}
 for(int col=1;col<pn/32;col*=2){int width=pn/32-col<col?pn/32-col:col;Adds(index.ReinterpretCast<int32_t>()[col*R*8],index.ReinterpretCast<int32_t>(),(int32_t)(col*32),width*R*8);PipeBarrier<PIPE_V>();}
 GlobalTensor<int8_t> src,dst;src.SetGlobalBuffer((__gm__ int8_t*)w);dst.SetGlobalBuffer((__gm__ int8_t*)packed);
 for(int q=0;q<2;++q){SetFlag<HardEvent::V_MTE2>((TEventID)q);SetFlag<HardEvent::MTE3_V>((TEventID)q);}
 int first=total*GetBlockIdx()/(2*cores);total=total*(GetBlockIdx()+1)/(2*cores);
 if(first<total){WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);ReadWeightRows(raw,src,first,nk,R,K,N,begin,finish);SetFlag<HardEvent::MTE2_V>(EVENT_ID0);}
 for(int task=first,i=0;task<total;task+=stride,++i){
  int q=i%2,next=1-q,e=task/nk,k0=begin+(task%nk)*R;
  if(task+stride<total){WaitFlag<HardEvent::V_MTE2>((TEventID)next);ReadWeightRows(raw[next*69888],src,task+stride,nk,R,K,N,begin,finish);SetFlag<HardEvent::MTE2_V>((TEventID)next);}
  WaitFlag<HardEvent::MTE2_V>((TEventID)q);WaitFlag<HardEvent::MTE3_V>((TEventID)q);
  Gather(out[q*4608],raw[q*69888].ReinterpretCast<uint32_t>(),index,(uint32_t)0,(uint32_t)count);PipeBarrier<PIPE_V>();
  SetFlag<HardEvent::V_MTE2>((TEventID)q);
  SetFlag<HardEvent::V_MTE3>((TEventID)q);WaitFlag<HardEvent::V_MTE3>((TEventID)q);
  DataCopyPad(dst[(int64_t)e*pk*pn+(int64_t)(k0/32)*32*pn+(k0%32)*32],out[q*4608].ReinterpretCast<int8_t>(),DataCopyExtParams{(uint16_t)(R==32?1:pn/32),(uint32_t)(R==32?R*pn:R*32),0,(uint32_t)((32-R)*32),0});
  SetFlag<HardEvent::MTE3_V>((TEventID)q);
 }
 for(int q=0;q<2;++q){WaitFlag<HardEvent::V_MTE2>((TEventID)q);WaitFlag<HardEvent::MTE3_V>((TEventID)q);}
}

template <int BM, int BN, int LK, int PK>
__aicore__ inline void MultiplyTile(GM_ADDR partial, GM_ADDR packed, GM_ADDR packedX, int K, int N, int task,
                                    int sequence, int e, int localRow, int aOffset, int pm, int rows, int cols,
                                    int col) {
    int pk = (K + 31) / 32 * 32, pn = (N + 31) / 32 * 32, begin = 0, finish = K;
    int ar = (rows + 15) / 16 * 16, an = (cols + 31) / 32 * 32;
    LocalTensor<int8_t> a1All(TPosition::A1, 0, 262144 + BM * LK), b1All(TPosition::B1, BM * LK, 262144 + BN * LK);
    LocalTensor<int8_t> a2(TPosition::A2, 0, 2 * BM * PK), b2(TPosition::B2, 0, 2 * BN * PK);
    LocalTensor<int32_t> c(TPosition::CO1, 0, BM * BN);
    GlobalTensor<int8_t> ax, bw;
    GlobalTensor<int32_t> cg;
    ax.SetGlobalBuffer((__gm__ int8_t *)packedX);
    bw.SetGlobalBuffer((__gm__ int8_t *)packed);
    cg.SetGlobalBuffer((__gm__ int32_t *)partial);
    if (begin == 0) {
        SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);
        SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID1);
        SetFlag<HardEvent::M_MTE1>(EVENT_ID0);SetFlag<HardEvent::M_MTE1>(EVENT_ID1);}
        int groups=(finish-begin+LK-1)/LK;
        for(int group=0;group<groups;++group){
            int slot=group%2,base=begin+group*LK,len=finish-base<LK?finish-base:LK,ak=(len+31)/32*32;
            if(group==0){
                WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);
                Nd2NzParams ap;ap.ndNum=1;ap.nValue=rows;ap.dValue=len;ap.srcNdMatrixStride=0;ap.srcDValue=K;ap.dstNzC0Stride=ar;ap.dstNzNStride=1;ap.dstNzMatrixStride=0;
                DataCopy(a1All,ax[(int64_t)aOffset*pk+(int64_t)begin*pm+(int64_t)localRow*32],DataCopyParams{(uint16_t)(ak/32),(uint16_t)ar,(uint16_t)(pm-ar),0});
                DataCopy(b1All,bw[(int64_t)e*pk*pn+(int64_t)begin*pn+col*32],DataCopyParams{(uint16_t)(ak/32),(uint16_t)an,(uint16_t)(pn-an),0});
                SetFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);
            }
            WaitFlag<HardEvent::MTE2_MTE1>((TEventID)slot);
            if(group+1<groups){
                int next=1-slot,k0=begin+(group+1)*LK,nextLen=finish-k0<LK?finish-k0:LK,nextAk=(nextLen+31)/32*32;
                WaitFlag<HardEvent::MTE1_MTE2>((TEventID)next);
                Nd2NzParams ap;ap.ndNum=1;ap.nValue=rows;ap.dValue=nextLen;ap.srcNdMatrixStride=0;ap.srcDValue=K;ap.dstNzC0Stride=ar;ap.dstNzNStride=1;ap.dstNzMatrixStride=0;
                DataCopy(a1All[next*262144],ax[(int64_t)aOffset*pk+(int64_t)k0*pm+(int64_t)localRow*32],DataCopyParams{(uint16_t)(nextAk/32),(uint16_t)ar,(uint16_t)(pm-ar),0});
                DataCopy(b1All[next*262144],bw[(int64_t)e*pk*pn+(int64_t)k0*pn+col*32],DataCopyParams{(uint16_t)(nextAk/32),(uint16_t)an,(uint16_t)(pn-an),0});
                SetFlag<HardEvent::MTE2_MTE1>((TEventID)next);
            }
            auto a1=a1All[slot*262144],b1=b1All[slot*262144];
            for(int inner=0;inner<len;inner+=PK){
                int j=(base+inner)/PK%2,kl=len-inner<PK?len-inner:PK,padded=(kl+31)/32*32;
                WaitFlag<HardEvent::M_MTE1>((TEventID)j);
                LoadData3DParamsV2<int8_t> al;
                al.l1H = 1;
                al.l1W = ar;
                al.channelSize = ak;
                al.kExtension = padded;
                al.mExtension = ar;
                al.kStartPt = inner;
                al.mStartPt = 0;
                al.strideW = 1;
                al.strideH = 1;
                al.filterW = 1;
                al.filterH = 1;
                al.dilationFilterW = 1;
                al.dilationFilterH = 1;
                al.padList[0] = 0;
                al.padList[1] = 0;
                al.padList[2] = 0;
                al.padList[3] = 0;
                al.enTranspose = false;
                al.enSmallK = false;
                al.padValue = 0;
                LoadData(a2[j*BM*PK],a1,al);
                LoadData2dTransposeParams bl;bl.startIndex=0;bl.repeatTimes=padded*an/1024;bl.srcStride=1;bl.dstGap=1;bl.dstFracGap=0;
                LoadDataWithTranspose(b2[j*BN*PK],b1[inner*an],bl);
                SetFlag<HardEvent::MTE1_M>(EVENT_ID0);WaitFlag<HardEvent::MTE1_M>(EVENT_ID0);
                MmadParams mp;mp.m=ar;mp.n=an;mp.k=kl;mp.cmatrixInitVal=base+inner==0;Mmad(c,a2[j*BM*PK],b2[j*BN*PK],mp);SetFlag<HardEvent::M_MTE1>((TEventID)j);
            }
            SetFlag<HardEvent::MTE1_MTE2>((TEventID)slot);
        }

        if(finish==K){
        SetFlag<HardEvent::M_FIX>(EVENT_ID0);WaitFlag<HardEvent::M_FIX>(EVENT_ID0);
        FixpipeParamsV220 fp;fp.nSize=cols;fp.mSize=rows;fp.srcStride=ar;fp.dstStride=BN;fp.ndNum=1;fp.srcNdStride=0;fp.dstNdStride=0;Fixpipe(cg[(int64_t)task*BM*BN],c,fp);CrossCoreSetFlag<2,PIPE_FIX>(8+2*(sequence%2));
        WaitFlag<HardEvent::M_MTE1>(EVENT_ID0);WaitFlag<HardEvent::M_MTE1>(EVENT_ID1);WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID1);

        CrossCoreWaitFlag<2>(9+2*(sequence%2));
        }
}

struct MatrixTile { int expert,start,localRow,rows,col,cols,packedRow,pitch; };
template<int BM,int BN> __aicore__ inline bool ResolveTile(GlobalTensor<int64_t>& ends,int E,int M,int N,int task,MatrixTile& tile){
 int first=0,packedRow=0,nc=(N+BN-1)/BN;
 for(int e=0;e<E;++e){int end=(int)ends.GetValue(e),rows=end-first,pm=(rows+15)/16*16,count=((rows+BM-1)/BM)*nc;
  if(task<count){int localRow=task/nc*BM,col=task%nc*BN;tile={e,first+localRow,localRow,rows-localRow<BM?rows-localRow:BM,col,N-col<BN?N-col:BN,packedRow,pm};return true;}
  task-=count;first=end;packedRow+=pm;
 }
 return false;
}
__aicore__ inline void PackVariableInput(GM_ADDR x,GM_ADDR packedX,GlobalTensor<int64_t>& ends,int E,int K,int cores){
 constexpr int PR=16;int pk=(K+31)/32*32,first=0,packedRow=0,offset=0;
 LocalTensor<int8_t> temp(TPosition::A1,0,PR*16384);
 GlobalTensor<int8_t> xg,xp;xg.SetGlobalBuffer((__gm__ int8_t*)x);xp.SetGlobalBuffer((__gm__ int8_t*)packedX);
 for(int e=0;e<E;++e){int end=(int)ends.GetValue(e),size=end-first,pm=(size+15)/16*16,mt=pm/PR;
  int firstTask=(GetBlockIdx()-offset%cores+cores)%cores;
  for(int task=firstTask;task<mt;task+=cores){int row=task*PR,rows=size-row<PR?size-row:PR;
   Nd2NzParams ap;ap.ndNum=1;ap.nValue=rows;ap.dValue=K;ap.srcNdMatrixStride=0;ap.srcDValue=K;ap.dstNzC0Stride=PR;ap.dstNzNStride=1;ap.dstNzMatrixStride=0;
   DataCopy(temp,xg[(int64_t)(first+row)*K],ap);
   SetFlag<HardEvent::MTE2_MTE3>(EVENT_ID0);WaitFlag<HardEvent::MTE2_MTE3>(EVENT_ID0);
   DataCopy(xp[(int64_t)packedRow*pk+row*32],temp,DataCopyParams{(uint16_t)(pk/32),PR,0,(uint16_t)(pm-PR)});
   SetFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);WaitFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);
  }
  offset+=mt;first=end;packedRow+=pm;
 }
}
template<int BM,int BN,int LK,int PK> __global__ __aicore__ void grouped_gelu_variable_packed(GM_ADDR x,GM_ADDR w,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,GM_ADDR partial,GM_ADDR packed,GM_ADDR packedX,int E,int M,int K,int N,int cores){
 KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
 GlobalTensor<int64_t> ends;ends.SetGlobalBuffer((__gm__ int64_t*)groups);
 if ASCEND_IS_AIV {PackWeight(w,packed,E,M,K,N,cores,0,K);}
 if ASCEND_IS_AIC {PackVariableInput(x,packedX,ends,E,K,cores);}
 SyncAll<false>();
 int core=GetBlockIdx();if ASCEND_IS_AIV {core/=2;}
 int sequence=0;MatrixTile tile;
 for(int task=core;ResolveTile<BM,BN>(ends,E,M,N,task,tile);task+=cores,++sequence){
  if ASCEND_IS_AIC {MultiplyTile<BM,BN,LK,PK>(partial,packed,packedX,K,N,task,sequence,tile.expert,tile.localRow,tile.packedRow,tile.pitch,tile.rows,tile.cols,tile.col);}
  else {FinishDirect<BM,BN>(partial,scale,y,tile.expert,tile.start,tile.rows,tile.col,N,task,sequence);}
  PipeBarrier<PIPE_ALL>();
 }
}
}
struct TemporaryWorkspace {
 void* address=nullptr;aclrtStream stream;
 explicit TemporaryWorkspace(aclrtStream s):stream(s){}
 GM_ADDR Get(size_t bytes){if(!address&&aclrtMalloc(&address,bytes,ACL_MEM_MALLOC_HUGE_FIRST)!=0)throw std::runtime_error("workspace allocation failed");return (GM_ADDR)address;}
 ~TemporaryWorkspace(){if(address){aclrtSynchronizeStream(stream);aclrtFree(address);}}
};
inline int DenseKind(int64_t E,int64_t M,int64_t K,int64_t N,int cores){
 if(M%E||cores<=0)return 0;
 int64_t rows=M/E,tasks=E*((rows+63)/64)*((N+255)/256);
 if(rows%64==0&&K%32==0&&K<=256&&N%256==0&&N<2048&&tasks<=cores*std::min<int64_t>(8,3+262144/(256*K)))return 1;
 if(rows%64==0&&K%32==0&&K<=4096&&N%256==0&&N<2048&&tasks<=cores*(((K+511)/512)%2?1:8))return 2;
 if((rows%96==0||rows%96>16)&&E*((rows+95)/96)*((N+191)/192)<=8*cores)return 3;
 return 0;
}
void LaunchDense(int kind,int cores,aclrtStream stream,GM_ADDR x,GM_ADDR w,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,GM_ADDR mem,int E,int M,int K,int N){
 if(kind==3){
  size_t cbytes=(size_t)((M+95)/96+E-1)*((N+191)/192)*96*192*4,xoffset=cbytes+(size_t)E*((K+31)/32*32)*((N+31)/32*32);
  VariablePacked::grouped_gelu_variable_packed<96,192,896,128><<<cores,nullptr,stream>>>(x,w,scale,groups,y,mem,mem+cbytes,mem+xoffset,E,M,K,N,cores);
  return;
 }
 if(kind==1)grouped_gelu_full_k<<<cores,nullptr,stream>>>(x,w,scale,y,mem,E,M,K,N,cores,groups);
 else if(kind==2)grouped_gelu_resident_a<<<cores,nullptr,stream>>>(x,w,scale,y,mem,E,M,K,N,cores,groups);
}
namespace DirectResidentMath {
struct WideFloat { float hi, lo; };
__aicore__ inline WideFloat WideAdd(WideFloat a, WideFloat b) {
#pragma clang fp reassociate(off) contract(off)
    float s=a.hi+b.hi;
    float v=s-a.hi;
    float p=s-v;
    float e1=a.hi-p;
    float e2=b.hi-v;
    float e=e1+e2;
    float l=a.lo+b.lo;
    float t=e+l;
    float h=s+t;
    float d=h-s;
    return {h,t-d};
}
__aicore__ inline WideFloat WideNeg(WideFloat a) { return {-a.hi,-a.lo}; }
__aicore__ inline WideFloat WideMul(WideFloat a, WideFloat b) {
#pragma clang fp reassociate(off) contract(off)
    union Bits { float f; uint32_t u; } aa,bb;
    aa.f=a.hi; bb.f=b.hi; aa.u&=0xfffff000u; bb.u&=0xfffff000u;
    float al=a.hi-aa.f, bl=b.hi-bb.f;
    float p=a.hi*b.hi;
    float hh=aa.f*bb.f;
    float hl=aa.f*bl;
    float lh=al*bb.f;
    float ll=al*bl;
    float e0=hh-p;
    float e1=e0+hl;
    float e2=e1+lh;
    float e3=e2+ll;
    float c1=a.hi*b.lo;
    float c2=a.lo*b.hi;
    float c3=a.lo*b.lo;
    float e4=e3+c1;
    float e5=e4+c2;
    float e=e5+c3;
    float h=p+e;
    float d=h-p;
    return {h,e-d};
}
__aicore__ inline WideFloat WideDiv(WideFloat a, WideFloat b) {
    float q=a.hi/b.hi;
    WideFloat rem=WideAdd(a,WideNeg(WideMul(b,{q,0.0f})));
    return WideAdd({q,0.0f},{(rem.hi+rem.lo)/b.hi,0.0f});
}
__aicore__ static __attribute__((noinline)) float AccurateGeluRounded(float z) {
    if(z>=8.0f) return z;
    if(z<=-8.0f) return 0.0f;
    float az=z>=0.0f?z:-z;
    WideFloat x={az,0.0f};
    WideFloat cube=WideMul(WideMul(x,x),x);
    WideFloat u=WideMul(WideAdd(x,WideMul(cube,{0.044714998453855515f,1.5461444347053543e-09f})),{0.79788458347320557f,-2.2670340271702116e-08f});
    WideFloat exponentValue=WideMul(u,{-2.0f,0.0f});
    int exponentShift=(int)(exponentValue.hi*1.4426950408889634f-0.5f);
    WideFloat r=WideAdd(exponentValue,WideMul({(float)exponentShift,0.0f},{-0.69314718246459961f,1.904654323148236e-09f}));
    WideFloat t={2.755731998149713e-07f,-7.575112209051195e-15f};
    t=WideAdd(WideMul(t,r),{2.7557318844628753e-06f,3.793571224297229e-14f});
    t=WideAdd(WideMul(t,r),{2.4801587642286904e-05f,-3.40699609366682e-13f});
    t=WideAdd(WideMul(t,r),{0.00019841270113829523f,-2.725596874933456e-12f});
    t=WideAdd(WideMul(t,r),{0.0013888889225199819f,-3.3631094437103215e-11f});
    t=WideAdd(WideMul(t,r),{0.008333333767950535f,-4.34617203337595e-10f});
    t=WideAdd(WideMul(t,r),{0.0416666679084301f,-1.2417634698280722e-09f});
    t=WideAdd(WideMul(t,r),{0.1666666716337204f,-4.967053879312289e-09f});
    t=WideAdd(WideMul(t,r),{0.5f,0.0f});
    t=WideAdd(WideMul(t,r),{1.0f,0.0f});
    t=WideAdd(WideMul(t,r),{1.0f,0.0f});
    union ScaleBits { float f; uint32_t u; } power;
    power.u=(uint32_t)(exponentShift+127)<<23;
    t={t.hi*power.f,t.lo*power.f};
    if(z>=0.0f && t.hi<=1.1102230246251565e-16f) return z;
    WideFloat numerator=z>=0.0f?WideFloat{z,0.0f}:WideMul({z,0.0f},t);
    WideFloat y=WideDiv(numerator,WideAdd({1.0f,0.0f},t));
    union Bits { float f; uint32_t u; } bits;
    bits.f=y.hi;
    int exponent=(bits.u>>23)&255;
    int shift=exponent>=113?13:126-exponent;
    if(shift>0 && shift<25 && (((bits.u&0x7fffffu)|0x800000u)&((1u<<shift)-1u))==(1u<<(shift-1)) && y.lo!=0.0f) {
        bool increase=(y.lo>0.0f)==(y.hi>0.0f);
        bits.u=increase?bits.u+1:bits.u-1;
    }
    return bits.f;
}
__aicore__ inline float MidpointGeluRounded(float z) {
#pragma clang fp reassociate(off) contract(off)
    float az=z>=0.0f?z:-z;
    if(az<0.03125f)return AccurateGeluRounded(z);
    union Bits {float f;uint32_t u;} input,result,unit,power;input.f=az;
    if(z>=5.25f) {
        if(input.u<0x40e2dbe6u && (input.u&8191u)==4096u)--input.u;
        return input.f;
    }
    uint64_t x=uint64_t((input.u&0x7fffffu)|0x800000u)<<(((input.u>>23)&255)-122);
    uint64_t square=(x*x+(1ULL<<29))>>30;
    uint64_t term=(square*3072791402ULL+(1ULL<<31))>>32;
    uint64_t cubic=(x*(term+(1ULL<<30))+(1ULL<<25))>>26;
    uint64_t expHigh=((cubic>>32)*1713444047ULL)<<2;
    uint64_t expLow=(((cubic&0xffffffffULL)*1713444047ULL)+(1ULL<<29))>>30;
    int64_t exponent=(int64_t)(expHigh+expLow);
    int64_t sh=-(exponent+1488522236LL)/2977044472LL;
    int64_t r=(-exponent-sh*2977044472LL+1)>>1;
    int64_t t=592;
    t=((t*r+(1LL<<30))>>31)+5918LL;
    t=((t*r+(1LL<<30))>>31)+53261LL;
    t=((t*r+(1LL<<30))>>31)+426088LL;
    t=((t*r+(1LL<<30))>>31)+2982616LL;
    t=((t*r+(1LL<<30))>>31)+17895697LL;
    t=((t*r+(1LL<<30))>>31)+89478485LL;
    t=((t*r+(1LL<<30))>>31)+357913941LL;
    t=((t*r+(1LL<<30))>>31)+1073741824LL;
    t=((t*r+(1LL<<30))>>31)+2147483648LL;
    t=((t*r+(1LL<<30))>>31)+2147483648LL;
    power.u=(uint32_t)(sh-30+127)<<23;
    float e=(float)(int32_t)(t>>1)*power.f;
    float d=(az*e)/(1.0f+e),low=0.0f;
    if(z>=0.0f){result.f=z-d;low=(z-result.f)-d;}else result.f=-d;
    int exponentY=(result.u>>23)&255,shift=exponentY>=113?13:126-exponentY;
    if(shift<=0 || shift>=25)return result.f;
    uint32_t mant=(result.u&0x7fffffu)|0x800000u;
    int32_t rem=(int32_t)(mant&((1u<<shift)-1u)),mid=1u<<(shift-1);
    unit.u=(uint32_t)(exponentY-23)<<23;
    float distance=(float)(rem-mid)*unit.f+(result.f>=0.0f?low:-low);
    float absolute=distance>=0.0f?distance:-distance;
    if(absolute<=2.0e-7f*d)return AccurateGeluRounded(z);
    if(rem==mid && low!=0.0f)result.u=((low>0.0f)==(result.f>0.0f))?result.u+1:result.u-1;
    return result.f;
}
__aicore__ static __attribute__((noinline)) float RoundedPositive(float z){return MidpointGeluRounded(z);}
}
struct ResidentOutputState {
    bool initialized=false,pending=false;
    int row=0,rows=0,col=0,cols=0,pitch=0,slot=0;
};
template<int BM,int BN> __aicore__ inline void FinishDirect(GM_ADDR partial,GM_ADDR scale,GM_ADDR y,int e,int start,int expertRows,int col,int N,int task,int sequence,ResidentOutputState& state,bool flush=false){
    constexpr int Q=BM*BN/2;
    int sub=GetBlockIdx()%2,slot=sequence%2;
    LocalTensor<float> input(TPosition::VECCALC,0,2*Q),a(TPosition::VECCALC,65792,Q),b(TPosition::VECCALC,98816,Q),scales(TPosition::VECCALC,164864,2*BN);
    LocalTensor<half> outputs(TPosition::VECCALC,131840,2*Q);
    GlobalTensor<int32_t> cg;GlobalTensor<float> sg;GlobalTensor<half> yg;
    cg.SetGlobalBuffer((__gm__ int32_t*)partial);sg.SetGlobalBuffer((__gm__ float*)scale);yg.SetGlobalBuffer((__gm__ half*)y);
    if (!state.initialized) {
        state.initialized = true;
        Duplicate(input, 0.0f, 2 * Q);
        Duplicate(scales, 0.0f, 2 * BN);
        SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
        SetFlag<HardEvent::V_MTE2>(EVENT_ID1);
        SetFlag<HardEvent::MTE3_V>(EVENT_ID2);
        SetFlag<HardEvent::MTE3_V>(EVENT_ID3);
    }
    int row=start+sub*(BM/2),rows=expertRows-sub*(BM/2),cols=N-col<BN?N-col:BN;
    rows=rows<BM/2?rows:BM/2;int pitch=(cols+31)/32*32;
    if(state.pending&&state.rows>0){
        auto z=input[state.slot*Q],sc=scales[state.slot*BN];auto out=outputs[state.slot*Q];
        WaitFlag<HardEvent::MTE2_V>((TEventID)state.slot);
        int count=(state.rows*state.pitch+63)/64*64;
        Cast(z,z.ReinterpretCast<int32_t>(),RoundMode::CAST_RINT,count);PipeBarrier<PIPE_V>();
        for(int c=0;c<state.pitch;c+=64)Mul(z[c],z[c],sc[c],(uint64_t)(state.pitch-c<64?state.pitch-c:64),(uint8_t)state.rows,BinaryRepeatParams{1,1,1,(uint8_t)(state.pitch/8),(uint8_t)(state.pitch/8),0});PipeBarrier<PIPE_V>();
        Mul(a,z,z,count);PipeBarrier<PIPE_V>();
        Muls(a,a,-0.07135481627260025f,count);PipeBarrier<PIPE_V>();
        Adds(a,a,-1.5957691216057308f,count);PipeBarrier<PIPE_V>();
        Mul(a,a,z,count);PipeBarrier<PIPE_V>();
        Exp(b,a,count);PipeBarrier<PIPE_V>();
        Adds(a,b,1.0f,count);PipeBarrier<PIPE_V>();
        Div(b,z,a,count);PipeBarrier<PIPE_V>();
        SetFlag<HardEvent::V_MTE2>((TEventID)state.slot);
        WaitFlag<HardEvent::MTE3_V>((TEventID)(state.slot+2));
        Cast(out,b,RoundMode::CAST_RINT,count);PipeBarrier<PIPE_V>();
        SetFlag<HardEvent::V_MTE3>(EVENT_ID2);WaitFlag<HardEvent::V_MTE3>(EVENT_ID2);
        DataCopyPad(yg[(int64_t)state.row*N+state.col],out,DataCopyExtParams{(uint16_t)state.rows,(uint32_t)(state.cols*2),(uint32_t)((state.pitch-(state.cols+15)/16*16)/16),(uint32_t)((N-state.cols)*2),0});
        SetFlag<HardEvent::MTE3_V>((TEventID)(state.slot+2));
    }
    if(!flush){
        WaitFlag<HardEvent::V_MTE2>((TEventID)slot);
        if(rows>0)DataCopyPad(scales[slot*BN],sg[(int64_t)e*N+col],DataCopyExtParams{1,(uint32_t)(cols*4),0,0,0},DataCopyPadExtParams<float>{true,0,(uint8_t)((8-cols%8)%8),0});
        CrossCoreWaitFlag<2>(8+2*(sequence%4));
        if(rows>0){DataCopy(input[slot*Q].ReinterpretCast<int32_t>(),cg[(int64_t)task*BM*BN+sub*(BM/2)*pitch],rows*pitch);SetFlag<HardEvent::MTE2_V>((TEventID)slot);}
        else SetFlag<HardEvent::V_MTE2>((TEventID)slot);
        CrossCoreSetFlag<2,PIPE_MTE2>(9+2*(sequence%4));
    }
    state.pending=!flush;state.row=row;state.rows=rows;state.col=col;state.cols=cols;state.pitch=pitch;state.slot=slot;
}

__aicore__ inline int WeightedTileBoundary(int threshold,int base,int rows,int gs,int ge,int alignedN,int BM,int BN){
    int columns=ge-gs,full=rows/BM,rem=rows%BM;
    int tail=rem;
    int width=((ge*BN<alignedN?ge*BN:alignedN)-gs*BN)/32;
    int totalRows=full+(rem!=0),totalWeight=(full*(BM)+tail)*width;
    if(threshold<=2*base)return 0;
    if(threshold>=2*(base+totalWeight))return totalRows*columns;
    int row=(threshold-2*base)/(2*(BM)*width);
    if(row>full)row=full;
    int ar=row<full?BM:tail;
    int prefix=base+row*(BM)*width;
    for(int c=gs;c<ge;++c){
        int cols=alignedN-c*BN<BN?alignedN-c*BN:BN;
        int weight=(ar)*(cols/32);
        if(2*prefix+weight>=threshold)return row*columns+c-gs;
        prefix+=weight;
    }
    return (row+1)*columns;
}
template<int ROWS> __aicore__ inline void StageResidentWeights(GM_ADDR w,GM_ADDR packed,int e,int E,int K,int N,int core,int begin,int end,bool& mapped){
    int sub=GetBlockIdx()%2,pitch=(N+31)/32*32,pk=(K+31)/32*32,count=ROWS*pitch/2;
    LocalTensor<int8_t> raw(TPosition::VECCALC,0,65792);
    LocalTensor<uint32_t> index(TPosition::VECCALC,65792,8192);
    LocalTensor<uint16_t> out(TPosition::VECCALC,98560,16384);
    if(!mapped){
        mapped=true;
        for(int j=0;j<32/2;++j)index.SetValue(j,j*2);
        SetFlag<HardEvent::S_V>(EVENT_ID3);WaitFlag<HardEvent::S_V>(EVENT_ID3);
        for(int r=1;r<ROWS;++r)Adds(index.ReinterpretCast<int32_t>()[r*(32/2)],index.ReinterpretCast<int32_t>(),(int32_t)(r*N/2*2+(r*N%2)*16448),32/2);
        PipeBarrier<PIPE_V>();
        for(int col=1;col<pitch/32;++col){Adds(index.ReinterpretCast<int32_t>()[col*ROWS*(32/2)],index.ReinterpretCast<int32_t>()[(col-1)*ROWS*(32/2)],(int32_t)32,ROWS*(32/2));PipeBarrier<PIPE_V>();}
    }
    GlobalTensor<int8_t> src,dst;src.SetGlobalBuffer((__gm__ int8_t*)w);dst.SetGlobalBuffer((__gm__ int8_t*)packed);
    for(int q=0;q<2;++q){SetFlag<HardEvent::V_MTE2>((TEventID)q);SetFlag<HardEvent::MTE3_V>((TEventID)q);}
    if(begin<end){
        int valid=end-begin<ROWS?end-begin:ROWS;
        WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
        for(int offset=0;offset<2;++offset)DataCopyPad(raw[offset*16448],src[((int64_t)e*K+begin)*N+offset],DataCopyExtParams{1,(uint32_t)(valid*N-offset),0,0,0},DataCopyPadExtParams<int8_t>{false,0,0,0});
        SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
    }
    for(int row=begin,i=0;row<end;row+=ROWS,++i){
        int q=i%2,next=1-q;
        if(row+ROWS<end){
            int valid=end-row-ROWS<ROWS?end-row-ROWS:ROWS;
            WaitFlag<HardEvent::V_MTE2>((TEventID)next);
            for(int offset=0;offset<2;++offset)DataCopyPad(raw[next*32896+offset*16448],src[((int64_t)e*K+row+ROWS)*N+offset],DataCopyExtParams{1,(uint32_t)(valid*N-offset),0,0,0},DataCopyPadExtParams<int8_t>{false,0,0,0});
            SetFlag<HardEvent::MTE2_V>((TEventID)next);
        }
        WaitFlag<HardEvent::MTE2_V>((TEventID)q);WaitFlag<HardEvent::MTE3_V>((TEventID)q);
        Gather(out[q*8192],raw[q*32896].ReinterpretCast<uint16_t>(),index,(uint32_t)0,(uint32_t)count);PipeBarrier<PIPE_V>();
        SetFlag<HardEvent::V_MTE2>((TEventID)q);
        SetFlag<HardEvent::V_MTE3>((TEventID)q);WaitFlag<HardEvent::V_MTE3>((TEventID)q);
        DataCopyPad(dst[(int64_t)e*pk*pitch+row*32],out[q*8192].ReinterpretCast<int8_t>(),DataCopyExtParams{(uint16_t)(pitch/32),(uint32_t)(ROWS*32),0,(uint32_t)((pk-ROWS)*32),0});
        SetFlag<HardEvent::MTE3_V>((TEventID)q);
    }
    for(int q=0;q<2;++q){WaitFlag<HardEvent::V_MTE2>((TEventID)q);WaitFlag<HardEvent::MTE3_V>((TEventID)q);}
}
template<int BM,int BN,int PK>
__global__ __aicore__ void grouped_gelu_direct_resident(GM_ADDR x,GM_ADDR w,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,GM_ADDR partial,int E,int M,int K,int N,int cores){
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
    int nc=(N+BN-1)/BN,pk=(K+31)/32*32,alignedN=(N+31)/32*32;
    GlobalTensor<int64_t> ends;ends.SetGlobalBuffer((__gm__ int64_t*)groups);
    int core=GetBlockIdx();if ASCEND_IS_AIV {core/=2;}
    GM_ADDR packed=partial+(size_t)cores*4*BM*BN*4;bool weightsReady=false;
    if ASCEND_IS_AIV {
        bool mapped=false;int blocks=(K+31)/32,total=E*blocks,vec=GetBlockIdx();
        int first=(int)((int64_t)total*vec/(2*cores)),last=(int)((int64_t)total*(vec+1)/(2*cores));
        for(int at=first;at<last;){int e=at/blocks,stop=(e+1)*blocks<last?(e+1)*blocks:last;int begin=(at-e*blocks)*32,end=(stop-e*blocks)*32;end=end<K?end:K;
            StageResidentWeights<32>(w,packed,e,E,K,N,core,begin,end,mapped);at=stop;}
        SyncAll<true>();CrossCoreSetFlag<2,PIPE_MTE3>(0);PipeBarrier<PIPE_ALL>();
    }
    int weight=M*(alignedN/32);
    int lower=(int)(((int64_t)2*weight*core+cores-1)/cores),upper=(int)(((int64_t)2*weight*(core+1)+cores-1)/cores);
    int expertBegin=0,expertLimit=E;
    while(expertBegin<expertLimit){int mid=(expertBegin+expertLimit)/2;if((int64_t)2*(int)ends.GetValue(mid)*(alignedN/32)<=lower)expertBegin=mid+1;else expertLimit=mid;}
    int initialStart=expertBegin?(int)ends.GetValue(expertBegin-1):0,initialPrefix=initialStart*(alignedN/32);
    int sequence=0;
    if ASCEND_IS_AIC {
        GlobalTensor<int8_t> ax,bw;GlobalTensor<int32_t> cg;
        ax.SetGlobalBuffer((__gm__ int8_t*)x);bw.SetGlobalBuffer((__gm__ int8_t*)packed);cg.SetGlobalBuffer((__gm__ int32_t*)partial);
        LocalTensor<int8_t> a1(TPosition::A1,0,262144),b1(TPosition::B1,262144,262144);
        LocalTensor<int8_t> a2(TPosition::A2,0,2*BM*PK),b2(TPosition::B2,0,2*BN*PK);
        LocalTensor<int32_t> cc(TPosition::CO1,0,2*BM*BN);
        SetFlag<HardEvent::M_MTE1>(EVENT_ID0);SetFlag<HardEvent::M_MTE1>(EVENT_ID1);
        SetFlag<HardEvent::FIX_M>(EVENT_ID0);SetFlag<HardEvent::FIX_M>(EVENT_ID1);
        SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID1);SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID2);
        int prefix=initialPrefix,start=initialStart;
        for(int e=expertBegin;e<E;++e){
            int end=(int)ends.GetValue(e),expertRows=end-start;
            int remainder=expertRows%BM;
            int rowUnits=expertRows;
            int expertWeight=rowUnits*(alignedN/32);
            if(2*(prefix+expertWeight)<=lower){prefix+=expertWeight;start=end;continue;}
            if(2*prefix>=upper)break;
            for(int gs=0;gs<nc;){
                int ge=gs,sumColumns=0;
                while(ge<nc){int count=alignedN-ge*BN<BN?alignedN-ge*BN:BN;
                    if((sumColumns+count)*pk>262144)break;
                    sumColumns+=count;++ge;}
                int groupWeight=rowUnits*(sumColumns/32),columns=ge-gs;
                int begin=WeightedTileBoundary(lower,prefix,expertRows,gs,ge,alignedN,BM,BN);
                int finish=WeightedTileBoundary(upper,prefix,expertRows,gs,ge,alignedN,BM,BN);
                prefix+=groupWeight;
                if(begin<finish){
                    int firstRow=begin/columns,lastRow=(finish-1)/columns;
                    int ctLo=firstRow==lastRow?gs+begin%columns:gs;
                    int ctHi=firstRow==lastRow?gs+(finish-1)%columns+1:ge;
                    WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID2);
                    int firstAbsolute=start+firstRow*BM,firstCount=end-firstAbsolute<BM?end-firstAbsolute:BM;
                    int firstAligned=BM;
                    WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);
                    Nd2NzParams ap;ap.ndNum=1;ap.nValue=firstCount;ap.dValue=K;ap.srcNdMatrixStride=0;ap.srcDValue=K;ap.dstNzC0Stride=firstAligned;ap.dstNzNStride=1;ap.dstNzMatrixStride=0;
                    DataCopy(a1,ax[(int64_t)firstAbsolute*K],ap);
                    SetFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);
                    int weightCol=ctLo*BN,weightCols=N-weightCol<(ctHi-ctLo)*BN?N-weightCol:(ctHi-ctLo)*BN;
                    int weightPitch=(weightCols+31)/32*32;
                    if(!weightsReady){CrossCoreWaitFlag<2>(0);weightsReady=true;}
                    int firstDepth=pk<PK?pk:PK;
                    int64_t base=(int64_t)e*pk*alignedN+weightCol*pk;
                    DataCopy(b1,bw[base],DataCopyParams{(uint16_t)(weightPitch/32),(uint16_t)firstDepth,(uint16_t)(pk-firstDepth),(uint16_t)(pk-firstDepth)});
                    SetFlag<HardEvent::MTE2_MTE1>(EVENT_ID1);
                    bool remainingWeights=pk>PK;
                    if(remainingWeights){DataCopy(b1[PK*32],bw[base+PK*32],DataCopyParams{(uint16_t)(weightPitch/32),(uint16_t)(pk-PK),(uint16_t)PK,(uint16_t)PK});SetFlag<HardEvent::MTE2_MTE1>(EVENT_ID3);}
                    WaitFlag<HardEvent::MTE2_MTE1>(EVENT_ID1);
                    for(int rb=firstRow;rb<=lastRow;++rb){
                        int row=start+rb*BM,rows=end-row<BM?end-row:BM;
                        int ar=BM;
                        int cb=rb==firstRow?gs+begin%columns:gs;
                        int ce=rb==lastRow?gs+(finish-1)%columns+1:ge;
                        int aslot=(rb-firstRow)%2;
                        WaitFlag<HardEvent::MTE2_MTE1>((TEventID)(aslot?2:0));
                        if(rb<lastRow){
                            int next=1-aslot,nextRow=row+BM,nextRows=end-nextRow<BM?end-nextRow:BM;
                            int nextAr=BM;
                            WaitFlag<HardEvent::MTE1_MTE2>((TEventID)next);
                            ap.nValue=nextRows;ap.dstNzC0Stride=nextAr;
                            DataCopy(a1[next*BM*pk],ax[(int64_t)nextRow*K],ap);
                            SetFlag<HardEvent::MTE2_MTE1>((TEventID)(next?2:0));
                        }
                        for(int ct=cb;ct<ce;++ct){
                            int col=ct*BN,cols=N-col<BN?N-col:BN,an=(cols+31)/32*32;
                            int slot=sequence%2;
                            
                            WaitFlag<HardEvent::FIX_M>((TEventID)slot);
                            auto c=cc[slot*BM*BN];
                            for(int k0=0,j=0;k0<K;k0+=PK,++j){
                                int q=j%2,kl=K-k0<PK?K-k0:PK,ak=(kl+31)/32*32;
                                WaitFlag<HardEvent::M_MTE1>((TEventID)q);
                                LoadData3DParamsV2<int8_t> al;
                                al.l1H = 1;
                                al.l1W = ar;
                                al.channelSize = pk;
                                al.kExtension = ak;
                                al.mExtension = ar;
                                al.kStartPt = k0;
                                al.mStartPt = 0;
                                al.strideW = 1;
                                al.strideH = 1;
                                al.filterW = 1;
                                al.filterH = 1;
                                al.dilationFilterW = 1;
                                al.dilationFilterH = 1;
                                al.padList[0] = 0;
                                al.padList[1] = 0;
                                al.padList[2] = 0;
                                al.padList[3] = 0;
                                al.enTranspose = false;
                                al.enSmallK = false;
                                al.padValue = 0;
                                LoadData(a2[q * BM * PK], a1[aslot * BM * pk], al);
                                if (remainingWeights && k0 >= PK) {
                                    WaitFlag<HardEvent::MTE2_MTE1>(EVENT_ID3);
                                    remainingWeights = false;
                                }
                    LoadData2dTransposeParams bl;bl.startIndex=0;bl.repeatTimes=ak/32;bl.srcStride=1;bl.dstGap=an/16-1;bl.dstFracGap=0;
                    for(int nb=0;nb<an;nb+=32)LoadDataWithTranspose(b2[q*BN*PK+nb*32],b1[(col-weightCol+nb)*pk+k0*32],bl);
                    SetFlag<HardEvent::MTE1_M>(EVENT_ID0);WaitFlag<HardEvent::MTE1_M>(EVENT_ID0);
                    MmadParams mp;mp.m=ar;mp.n=an;mp.k=kl;mp.cmatrixInitVal=k0==0;
                    Mmad(c,a2[q*BM*PK],b2[q*BN*PK],mp);SetFlag<HardEvent::M_MTE1>((TEventID)q);
                }

                            SetFlag<HardEvent::M_FIX>(EVENT_ID0);WaitFlag<HardEvent::M_FIX>(EVENT_ID0);
                            FixpipeParamsV220 fp;fp.nSize=an;fp.mSize=rows;fp.srcStride=ar;fp.dstStride=an;fp.ndNum=1;fp.srcNdStride=0;fp.dstNdStride=0;
                            if(sequence>=4)CrossCoreWaitFlag<2>(9+2*(sequence%4));
                Fixpipe(cg[(core*4+sequence%4)*BM*BN],c,fp);SetFlag<HardEvent::FIX_M>((TEventID)slot);CrossCoreSetFlag<2,PIPE_FIX>(8+2*(sequence%4));++sequence;
                        }
                        SetFlag<HardEvent::MTE1_MTE2>((TEventID)aslot);
                    }
                    SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID2);
                }
                gs=ge;
            }
            start=end;
        }
        for(int q=sequence>4?sequence-4:0;q<sequence;++q)CrossCoreWaitFlag<2>(9+2*(q%4));
        WaitFlag<HardEvent::M_MTE1>(EVENT_ID0);WaitFlag<HardEvent::M_MTE1>(EVENT_ID1);
        WaitFlag<HardEvent::FIX_M>(EVENT_ID0);WaitFlag<HardEvent::FIX_M>(EVENT_ID1);
        WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID1);WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID2);
    }else{
        ResidentOutputState initialized;
        int prefix=initialPrefix,start=initialStart;
        for(int e=expertBegin;e<E;++e){
            int end=(int)ends.GetValue(e),expertRows=end-start;
            int remainder=expertRows%BM;
            int rowUnits=expertRows;
            int expertWeight=rowUnits*(alignedN/32);
            if(2*(prefix+expertWeight)<=lower){prefix+=expertWeight;start=end;continue;}
            if(2*prefix>=upper)break;
            for(int gs=0;gs<nc;){
                int ge=gs,sumColumns=0;
                while(ge<nc){int count=alignedN-ge*BN<BN?alignedN-ge*BN:BN;
                    if((sumColumns+count)*pk>262144)break;
                    sumColumns+=count;++ge;}
                int groupWeight=rowUnits*(sumColumns/32),columns=ge-gs;
                int begin=WeightedTileBoundary(lower,prefix,expertRows,gs,ge,alignedN,BM,BN);
                int finish=WeightedTileBoundary(upper,prefix,expertRows,gs,ge,alignedN,BM,BN);
                prefix+=groupWeight;
                if(begin<finish){
                    int firstRow=begin/columns,lastRow=(finish-1)/columns;
                    int ctLo=firstRow==lastRow?gs+begin%columns:gs;
                    int ctHi=firstRow==lastRow?gs+(finish-1)%columns+1:ge;

                    for(int rb=firstRow;rb<=lastRow;++rb){
                        int row=start+rb*BM,rows=end-row<BM?end-row:BM;
                        int ar=BM;
                        int cb=rb==firstRow?gs+begin%columns:gs;
                        int ce=rb==lastRow?gs+(finish-1)%columns+1:ge;

                        for(int ct=cb;ct<ce;++ct){
                            int col=ct*BN,cols=N-col<BN?N-col:BN,an=(cols+31)/32*32;
                            FinishDirect<BM,BN>(partial,scale,y,e,row,rows,col,N,core*4+sequence%4,sequence,initialized);
                            ++sequence;
                        }

                    }

                }
                gs=ge;
            }
            start=end;
        }
        if (initialized.initialized) {
            FinishDirect<BM, BN>(partial, scale, y, 0, 0, 0, 0, N, 0, sequence, initialized, true);
            WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
            WaitFlag<HardEvent::V_MTE2>(EVENT_ID1);
            WaitFlag<HardEvent::MTE3_V>(EVENT_ID2);
            WaitFlag<HardEvent::MTE3_V>(EVENT_ID3);
        }
    }
    PipeBarrier<PIPE_ALL>();
}
static void LaunchDirectResident(GM_ADDR x,const TensorGroupInfo& info_x,
    GM_ADDR weight,const TensorGroupInfo& info_weight,GM_ADDR scale,const TensorGroupInfo& info_scale,
    GM_ADDR group_list,const TensorGroupInfo& info_group_list,GM_ADDR y,const TensorGroupInfo& info_y,
    int64_t availableCoreNum,aclrtStream stream){
    int E=info_weight.tensors[0].shape[0],M=info_x.tensors[0].shape[0],K=info_x.tensors[0].shape[1],N=info_weight.tensors[0].shape[2];
    auto platform=platform_ascendc::PlatformAscendCManager::GetInstance();
    int cores=std::min<int64_t>(availableCoreNum,platform->GetCoreNumAic());
    constexpr int BM=128,BN=128,PK=256;
    void* memory=nullptr;
    if(aclrtMalloc(&memory,(size_t)cores*4*BM*BN*4+(size_t)E*((K+31)/32*32)*((N+31)/32*32),ACL_MEM_MALLOC_HUGE_FIRST)!=0)throw std::runtime_error("allocation failed");
    grouped_gelu_direct_resident<BM,BN,PK><<<cores,nullptr,stream>>>(x,weight,scale,group_list,y,(GM_ADDR)memory,E,M,K,N,cores);
    auto status=aclrtSynchronizeStream(stream);aclrtFree(memory);
    if(status!=0)throw std::runtime_error("kernel failed");
}

template<int BM,int BN> __aicore__ inline void FinishStreamed(GM_ADDR partial,GM_ADDR scale,GM_ADDR y,int e,int start,int expertRows,int col,int N,int task,int sequence,bool& initialized){
    constexpr int Q=BM*BN/2;

        int sub=GetBlockIdx()%2;
        int row=start+sub*(BM/2);
        int rows=expertRows-sub*(BM/2);rows=rows<BM/2?rows:BM/2;int cols=N-col<BN?N-col:BN;if(rows<=0){CrossCoreWaitFlag<2>(8+2*(sequence%2));CrossCoreSetFlag<2,PIPE_MTE2>(9+2*(sequence%2));return;}
        LocalTensor<float> z(TPosition::VECCALC,0,Q),a(TPosition::VECCALC,37120,Q),b(TPosition::VECCALC,74240,Q),coefficients(TPosition::VECCALC,151040,32),scales(TPosition::VECCALC,151296,BN);
        LocalTensor<half> out(TPosition::VECCALC,111360,Q);LocalTensor<int16_t> ramp(TPosition::VECCALC,130048,Q);
        LocalTensor<uint8_t> m1(TPosition::VECCALC,148736,Q/8),m2(TPosition::VECCALC,149888,Q/8);
        GlobalTensor<int32_t> cg;GlobalTensor<float> sg;GlobalTensor<half> yg;cg.SetGlobalBuffer((__gm__ int32_t*)partial);sg.SetGlobalBuffer((__gm__ float*)scale);yg.SetGlobalBuffer((__gm__ half*)y);
        auto tieBits=coefficients[16].ReinterpretCast<uint16_t>(),nearBits=coefficients[24].ReinterpretCast<uint16_t>();
        if(!initialized){initialized=true;SetFlag<HardEvent::MTE3_V>(EVENT_ID3);
        Duplicate(z.ReinterpretCast<int32_t>(),0,Q);Duplicate(scales,0.0f,BN);Duplicate(coefficients,-0.07135481627260025f,8);Duplicate(coefficients[8],-1.5957691216057308f,8);PipeBarrier<PIPE_V>();
Duplicate(tieBits.ReinterpretCast<uint32_t>(),(uint32_t)0xff001ff8,8);Duplicate(nearBits.ReinterpretCast<uint32_t>(),(uint32_t)0xff8000ff,8);
        for(int i=0;i<16;++i)ramp.SetValue(i,i);SetFlag<HardEvent::S_V>(EVENT_ID2);WaitFlag<HardEvent::S_V>(EVENT_ID2);
        for(int span=16;span<Q/32;span*=2){int count=Q/32-span<span?Q/32-span:span;Adds(ramp[span],ramp,(int16_t)span,count);PipeBarrier<PIPE_V>();}
        }
        SetFlag<HardEvent::V_MTE2>(EVENT_ID0);WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
        DataCopyPad(scales,sg[(int64_t)e*N+col],DataCopyExtParams{1,(uint32_t)(cols*4),0,0,0},DataCopyPadExtParams<float>{true,0,(uint8_t)((8-cols%8)%8),0});
        CrossCoreWaitFlag<2>(8+2*(sequence%2));
        int pitch=(cols+31)/32*32;int aligned=(cols+7)/8*8;
        DataCopyPad(z.ReinterpretCast<int32_t>(), cg[(int64_t)task * BM * BN + sub * Q],
                    DataCopyExtParams{(uint16_t)rows, (uint32_t)(cols * 4), (uint32_t)((BN - cols) * 4),
                                      (uint32_t)((pitch - aligned) / 8), 0},
                    DataCopyPadExtParams<int32_t>{true, 0, (uint8_t)(aligned - cols), 0});
        CrossCoreSetFlag<2,PIPE_MTE2>(9+2*(sequence%2));
        SetFlag<HardEvent::MTE2_V>(EVENT_ID0);WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
        int count=(rows*pitch+63)/64*64;Cast(z,z.ReinterpretCast<int32_t>(),RoundMode::CAST_RINT,count);PipeBarrier<PIPE_V>();
        for(int c=0;c<pitch;c+=64)Mul(z[c],z[c],scales[c],(uint64_t)(pitch-c<64?pitch-c:64),(uint8_t)rows,BinaryRepeatParams{1,1,1,(uint8_t)(pitch/8),(uint8_t)(pitch/8),0});PipeBarrier<PIPE_V>();
        int n=count;
    Mul(a,z,z,n);PipeBarrier<PIPE_V>();
    Muls(a,a,-0.07135481627260025f,n);PipeBarrier<PIPE_V>();
    Adds(a,a,-1.5957691216057308f,n);PipeBarrier<PIPE_V>();
    Mul(a,a,z,n);PipeBarrier<PIPE_V>();

    Exp(b,a,n);PipeBarrier<PIPE_V>();
    Adds(a,b,1.0f,n);PipeBarrier<PIPE_V>();
    Div(b,z,a,n);PipeBarrier<PIPE_V>();
    WaitFlag<HardEvent::MTE3_V>(EVENT_ID3);
    Cast(out,b,RoundMode::CAST_RINT,n);PipeBarrier<PIPE_V>();
        SetFlag<HardEvent::V_MTE3>(EVENT_ID2);WaitFlag<HardEvent::V_MTE3>(EVENT_ID2);
        DataCopyPad(yg[(int64_t)row*N+col],out,DataCopyExtParams{(uint16_t)rows,(uint32_t)(cols*2),(uint32_t)((pitch-(cols+15)/16*16)/16),(uint32_t)((N-cols)*2),0});
        SetFlag<HardEvent::MTE3_V>(EVENT_ID3);
    
}

template<int VK,int BN> __aicore__ inline void CopyWeightSlice(LocalTensor<int8_t> b1,GlobalTensor<int8_t> bw,int e,int K,int N,int col,int cols,int an,int band){
                    int offset=band*VK,depth=K-offset<VK?K-offset:VK;
                    Nd2NzParams bp;bp.ndNum=depth/32;bp.nValue=32;bp.dValue=cols;bp.srcNdMatrixStride=32*N;bp.srcDValue=N;bp.dstNzC0Stride=32;bp.dstNzNStride=1;bp.dstNzMatrixStride=32*an;
                    int matrices=depth/32,pack=32*N<=65535?matrices:1;
                    for(int i=0;i<matrices;i+=pack){bp.ndNum=pack;DataCopy(b1[band*VK*BN+i*32*an],bw[((int64_t)e*K+offset+i*32)*N+col],bp);}
                    if(depth%32){bp.ndNum=1;bp.nValue=depth%32;DataCopy(b1[band*VK*BN+(depth/32)*32*an],bw[((int64_t)e*K+offset+depth/32*32)*N+col],bp);}
                    SetFlag<HardEvent::MTE2_MTE1>((TEventID)(2+band));
}
template<int BM,int BN,int PK>
__global__ __aicore__ void grouped_gelu_streamed_resident(GM_ADDR x,GM_ADDR w,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,GM_ADDR partial,int E,int M,int K,int N,int cores){
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
    constexpr int VK=256;
    int nc=(N+BN-1)/BN,pk=(K+31)/32*32;
    GlobalTensor<int64_t> ends;ends.SetGlobalBuffer((__gm__ int64_t*)groups);
    int core=GetBlockIdx();if ASCEND_IS_AIV {core/=2;}
    int sequence=0;bool initialized=false;
    if ASCEND_IS_AIC {
        GlobalTensor<int8_t> ax,bw;GlobalTensor<int32_t> cg;
        ax.SetGlobalBuffer((__gm__ int8_t*)x);bw.SetGlobalBuffer((__gm__ int8_t*)w);cg.SetGlobalBuffer((__gm__ int32_t*)partial);
        LocalTensor<int8_t> a1(TPosition::A1,0,262144),b1(TPosition::B1,262144,262144);
        LocalTensor<int8_t> a2(TPosition::A2,0,2*BM*PK),b2(TPosition::B2,0,2*BN*PK);
        LocalTensor<int32_t> cc(TPosition::CO1,0,BM*BN);
        SetFlag<HardEvent::M_MTE1>(EVENT_ID0);SetFlag<HardEvent::M_MTE1>(EVENT_ID1);
        SetFlag<HardEvent::FIX_M>(EVENT_ID0);
        int cachedExpert=-1,cachedStart=-1,cachedEnd=-1;bool prefetched=false;
        int capacityRows=(262144/pk/128)*128;
        for(int strip=core;strip<E*nc;strip+=cores){
            int e=strip%E,col=strip/E*BN,start=e?(int)ends.GetValue(e-1):0,end=(int)ends.GetValue(e);
            if(start==end)continue;
            int cols=N-col<BN?N-col:BN,an=(cols+31)/32*32;
            int aRows=0;
            for(int row=start;row<end;row+=BM){
                int rows=end-row<BM?end-row:BM,ar=BM,slot=sequence%2;
                WaitFlag<HardEvent::FIX_M>(EVENT_ID0);
                if(cachedExpert!=e || row<cachedStart || row>=cachedEnd){
                cachedStart=row;cachedEnd=end<row+capacityRows?end:row+capacityRows;aRows=(cachedEnd-cachedStart+127)/128*128;
                Nd2NzParams ap;ap.ndNum=1;ap.nValue=cachedEnd-cachedStart;ap.dValue=K;ap.srcNdMatrixStride=0;ap.srcDValue=K;ap.dstNzC0Stride=aRows;ap.dstNzNStride=1;ap.dstNzMatrixStride=0;
                DataCopy(a1,ax[(int64_t)cachedStart*K],ap);
                SetFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);WaitFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);
                cachedExpert=e;}else aRows=(cachedEnd-cachedStart+127)/128*128;
                int bands=(K+VK-1)/VK;
                if(!prefetched)for(int band=0;band<bands;++band)CopyWeightSlice<VK,BN>(b1,bw,e,K,N,col,cols,an,band);
                prefetched=false;
                int nextStrip=-1;
                if(row+BM<end)nextStrip=strip;
                else for(int ns=strip+cores;ns<E*nc;ns+=cores){int ne=ns%E,nb=ne?(int)ends.GetValue(ne-1):0;if((int)ends.GetValue(ne)>nb){nextStrip=ns;break;}}
                int nextExpert=0,nextColumn=0,nextWidth=0,nextAligned=0;
                if(nextStrip>=0){nextExpert=nextStrip%E;nextColumn=nextStrip/E*BN;nextWidth=N-nextColumn<BN?N-nextColumn:BN;nextAligned=(nextWidth+31)/32*32;}
                auto c=cc;
                for(int k0=0,j=0;k0<K;k0+=PK,++j){
                    int band=k0/VK; if(k0%VK==0)WaitFlag<HardEvent::MTE2_MTE1>((TEventID)(2+band));
                    int q=j%2,kl=K-k0<PK?K-k0:PK,ak=(kl+31)/32*32;
                    WaitFlag<HardEvent::M_MTE1>((TEventID)q);
                    LoadData3DParamsV2<int8_t> al;
                    al.l1H = 1;
                    al.l1W = aRows;
                    al.channelSize = pk;
                    al.kExtension = ak;
                    al.mExtension = ar;
                    al.kStartPt = k0;
                    al.mStartPt = row - cachedStart;
                    al.strideW = 1;
                    al.strideH = 1;
                    al.filterW = 1;
                    al.filterH = 1;
                    al.dilationFilterW = 1;
                    al.dilationFilterH = 1;
                    al.padList[0] = 0;
                    al.padList[1] = 0;
                    al.padList[2] = 0;
                    al.padList[3] = 0;
                    al.enTranspose = false;
                    al.enSmallK = false;
                    al.padValue = 0;
                    LoadData(a2[q*BM*PK],a1,al);
                    LoadData2dTransposeParams bl;bl.startIndex=0;bl.repeatTimes=ak*an/1024;bl.srcStride=1;bl.dstGap=1;bl.dstFracGap=0;
                    LoadDataWithTranspose(b2[q*BN*PK],b1[band*VK*BN+(k0%VK)*an],bl);
                    SetFlag<HardEvent::MTE1_M>(EVENT_ID0);WaitFlag<HardEvent::MTE1_M>(EVENT_ID0);
                    MmadParams mp;mp.m=ar;mp.n=an;mp.k=kl;mp.cmatrixInitVal=k0==0;
                    Mmad(c,a2[q*BM*PK],b2[q*BN*PK],mp);SetFlag<HardEvent::M_MTE1>((TEventID)q);
                    if(nextStrip>=0 && ((k0+PK)%VK==0 || k0+PK>=K)){
                        SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID2);WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID2);
                        CopyWeightSlice<VK,BN>(b1,bw,nextExpert,K,N,nextColumn,nextWidth,nextAligned,band);prefetched=true;
                    }
                }
                SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);
                SetFlag<HardEvent::M_FIX>(EVENT_ID0);WaitFlag<HardEvent::M_FIX>(EVENT_ID0);
                for(int half=0;half<2 && half*(BM/2)<rows;++half){
                    int slot=sequence%2,part=rows-half*(BM/2);if(part>BM/2)part=BM/2;
                    if(sequence>=2)CrossCoreWaitFlag<2>(9+2*slot);
                    FixpipeParamsV220 fp;fp.nSize=an;fp.mSize=part;fp.srcStride=ar;fp.dstStride=BN;fp.ndNum=1;fp.srcNdStride=0;fp.dstNdStride=0;
                    Fixpipe(cg[(core*2+slot)*(BM/2)*BN],c[half*(BM/2)*16],fp);
                    CrossCoreSetFlag<2,PIPE_FIX>(8+2*slot);++sequence;
                }
                SetFlag<HardEvent::FIX_M>(EVENT_ID0);
            }
        }
        for(int q=sequence>2?sequence-2:0;q<sequence;++q)CrossCoreWaitFlag<2>(9+2*(q%2));
        WaitFlag<HardEvent::M_MTE1>(EVENT_ID0);WaitFlag<HardEvent::M_MTE1>(EVENT_ID1);
        WaitFlag<HardEvent::FIX_M>(EVENT_ID0);
    }else{
        for(int strip=core;strip<E*nc;strip+=cores){
            int e=strip%E,col=strip/E*BN,start=e?(int)ends.GetValue(e-1):0,end=(int)ends.GetValue(e);
            for(int row=start;row<end;row+=BM/2){
                int rows=end-row<BM/2?end-row:BM/2;
                FinishStreamed<BM/2,BN>(partial,scale,y,e,row,rows,col,N,core*2+sequence%2,sequence,initialized);
                ++sequence;
            }
        }
        if(initialized)WaitFlag<HardEvent::MTE3_V>(EVENT_ID3);
    }
    PipeBarrier<PIPE_ALL>();
}
static void LaunchStreamedResident(GM_ADDR x,const TensorGroupInfo& info_x,
    GM_ADDR weight,const TensorGroupInfo& info_weight,GM_ADDR scale,const TensorGroupInfo& info_scale,
    GM_ADDR group_list,const TensorGroupInfo& info_group_list,GM_ADDR y,const TensorGroupInfo& info_y,
    int64_t availableCoreNum,aclrtStream stream){
    int E=info_weight.tensors[0].shape[0],M=info_x.tensors[0].shape[0],K=info_x.tensors[0].shape[1],N=info_weight.tensors[0].shape[2];
    auto platform=platform_ascendc::PlatformAscendCManager::GetInstance();
    int cores=std::min<int64_t>(16,std::min<int64_t>(availableCoreNum,platform->GetCoreNumAic()));
    constexpr int BM=128,BN=256,PK=128;
    void* memory=nullptr;
    if(aclrtMalloc(&memory,(size_t)cores*2*BM*BN*4,ACL_MEM_MALLOC_HUGE_FIRST)!=0)throw std::runtime_error("allocation failed");
    grouped_gelu_streamed_resident<BM,BN,PK><<<cores,nullptr,stream>>>(x,weight,scale,group_list,y,(GM_ADDR)memory,E,M,K,N,cores);
    auto status=aclrtSynchronizeStream(stream);aclrtFree(memory);
    if(status!=0)throw std::runtime_error("kernel failed");
}

template<int BM,int BN> __aicore__ inline void FinishDualResident(GM_ADDR partial,GM_ADDR scale,GM_ADDR y,int e,int start,int expertRows,int col,int N,int task,int sequence,bool& initialized){
    constexpr int Q=BM*BN/2;

        int sub=GetBlockIdx()%2;
        int row=start+sub*(BM/2);
        int rows=expertRows-sub*(BM/2);rows=rows<BM/2?rows:BM/2;int cols=N-col<BN?N-col:BN;if(rows<=0){CrossCoreWaitFlag<2>(8+2*(sequence%2));CrossCoreSetFlag<2,PIPE_MTE2>(9+2*(sequence%2));return;}
        constexpr int MASK_BYTES=(Q/8+31)/32*32;
        constexpr int COEFF=16*Q+2*MASK_BYTES;
        LocalTensor<float> z(TPosition::VECCALC,0,Q),a(TPosition::VECCALC,4*Q,Q),b(TPosition::VECCALC,8*Q,Q),coefficients(TPosition::VECCALC,COEFF,32),scales(TPosition::VECCALC,COEFF+128,BN);
        LocalTensor<half> out(TPosition::VECCALC,12*Q,Q);LocalTensor<int16_t> ramp(TPosition::VECCALC,14*Q,Q);
        LocalTensor<uint8_t> m1(TPosition::VECCALC,16*Q,Q/8),m2(TPosition::VECCALC,16*Q+MASK_BYTES,Q/8);
        GlobalTensor<int32_t> cg;GlobalTensor<float> sg;GlobalTensor<half> yg;cg.SetGlobalBuffer((__gm__ int32_t*)partial);sg.SetGlobalBuffer((__gm__ float*)scale);yg.SetGlobalBuffer((__gm__ half*)y);
        auto tieBits=coefficients[16].ReinterpretCast<uint16_t>(),nearBits=coefficients[24].ReinterpretCast<uint16_t>();
        if(!initialized){initialized=true;
        Duplicate(z.ReinterpretCast<int32_t>(),0,Q);Duplicate(scales,0.0f,BN);Duplicate(coefficients,-0.07135481627260025f,8);Duplicate(coefficients[8],-1.5957691216057308f,8);PipeBarrier<PIPE_V>();
Duplicate(tieBits.ReinterpretCast<uint32_t>(),(uint32_t)0xff001ff8,8);Duplicate(nearBits.ReinterpretCast<uint32_t>(),(uint32_t)0xff8000ff,8);
        for(int i=0;i<16;++i)ramp.SetValue(i,i);SetFlag<HardEvent::S_V>(EVENT_ID2);WaitFlag<HardEvent::S_V>(EVENT_ID2);
        for(int span=16;span<Q/32;span*=2){int count=Q/32-span<span?Q/32-span:span;Adds(ramp[span],ramp,(int16_t)span,count);PipeBarrier<PIPE_V>();}
        }
        SetFlag<HardEvent::V_MTE2>(EVENT_ID0);WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
        DataCopyPad(scales,sg[(int64_t)e*N+col],DataCopyExtParams{1,(uint32_t)(cols*4),0,0,0},DataCopyPadExtParams<float>{true,0,(uint8_t)((8-cols%8)%8),0});
        CrossCoreWaitFlag<2>(8+2*(sequence%2));
        int pitch=(cols+31)/32*32;int aligned=(cols+7)/8*8;
        DataCopyPad(z.ReinterpretCast<int32_t>(), cg[(int64_t)task * BM * BN + sub * Q],
                    DataCopyExtParams{(uint16_t)rows, (uint32_t)(cols * 4), (uint32_t)((BN - cols) * 4),
                                      (uint32_t)((pitch - aligned) / 8), 0},
                    DataCopyPadExtParams<int32_t>{true, 0, (uint8_t)(aligned - cols), 0});
        CrossCoreSetFlag<2,PIPE_MTE2>(9+2*(sequence%2));
        SetFlag<HardEvent::MTE2_V>(EVENT_ID0);WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
        int count=(rows*pitch+63)/64*64;Cast(z,z.ReinterpretCast<int32_t>(),RoundMode::CAST_RINT,count);PipeBarrier<PIPE_V>();
        for(int c=0;c<pitch;c+=64)Mul(z[c],z[c],scales[c],(uint64_t)(pitch-c<64?pitch-c:64),(uint8_t)rows,BinaryRepeatParams{1,1,1,(uint8_t)(pitch/8),(uint8_t)(pitch/8),0});PipeBarrier<PIPE_V>();
        int n=count;
    Mul(a,z,z,n);PipeBarrier<PIPE_V>();
    Muls(a,a,-0.07135481627260025f,n);PipeBarrier<PIPE_V>();
    Adds(a,a,-1.5957691216057308f,n);PipeBarrier<PIPE_V>();
    Mul(a,a,z,n);PipeBarrier<PIPE_V>();

    Exp(b,a,n);PipeBarrier<PIPE_V>();
    Adds(a,b,1.0f,n);PipeBarrier<PIPE_V>();
    Div(b,z,a,n);PipeBarrier<PIPE_V>();
    Adds(a.ReinterpretCast<int32_t>(),b.ReinterpretCast<int32_t>(),(int32_t)4,n);PipeBarrier<PIPE_V>();
    And(a.ReinterpretCast<uint16_t>(),a.ReinterpretCast<uint16_t>(),tieBits,(uint64_t)128,(uint8_t)(n/64),BinaryRepeatParams{1,1,0,8,8,0});PipeBarrier<PIPE_V>();
    CompareScalar(m1,a.ReinterpretCast<int32_t>(),(int32_t)0x40001000,CMPMODE::EQ,n);PipeBarrier<PIPE_V>();
    Adds(a,b,-0.001953125f,n);PipeBarrier<PIPE_V>();
    And(a.ReinterpretCast<uint16_t>(),a.ReinterpretCast<uint16_t>(),nearBits,(uint64_t)128,(uint8_t)(n/64),BinaryRepeatParams{1,1,0,8,8,0});PipeBarrier<PIPE_V>();
    CompareScalar(m2,a.ReinterpretCast<int32_t>(),(int32_t)0xbb000080,CMPMODE::EQ,n);PipeBarrier<PIPE_V>();
    Or(m1.ReinterpretCast<uint16_t>(),m1.ReinterpretCast<uint16_t>(),m2.ReinterpretCast<uint16_t>(),n/16);PipeBarrier<PIPE_V>();
    uint64_t selectedCount=0;
    CompareScalar(m2,m1.ReinterpretCast<int32_t>(),(int32_t)0,CMPMODE::EQ,n/32);PipeBarrier<PIPE_V>();
    Not(m2.ReinterpretCast<uint16_t>(),m2.ReinterpretCast<uint16_t>(),(n+511)/512);PipeBarrier<PIPE_V>();
    SetMaskCount();SetVectorMask<int16_t,MaskMode::COUNTER>(0,n/32);
    GatherMask(a.ReinterpretCast<int16_t>(),ramp,m2.ReinterpretCast<int16_t>(),(uint8_t)0,GatherMaskParams{1,1,8,0});
    SetMaskNorm();ResetMask();
    Cast(out,b,RoundMode::CAST_RINT,n);PipeBarrier<PIPE_V>();

        SetFlag<HardEvent::V_S>(EVENT_ID2);WaitFlag<HardEvent::V_S>(EVENT_ID2);selectedCount=GetGatherMaskRemainCount();
        for (uint64_t j = 0; j < selectedCount; ++j) {
            int wordIndex = a.ReinterpretCast<int16_t>().GetValue(j);
            uint32_t word = m1.ReinterpretCast<uint32_t>().GetValue(wordIndex);
            while (word) {
                int bit = __builtin_ctz(word);
                word &= word - 1;
                int index = wordIndex * 32 + bit;

                union {
                    float f;
                    uint32_t u;
                } v;

                v.f = z.GetValue(index);
                if (v.f >= 0.0f) {
                    out.SetValue(index, (half)DirectResidentMath::MidpointGeluRounded(v.f));
                } else if (v.f < 0.0f && b.GetValue(index) > -0.00006103515625f)
                    out.SetValue(index, (half)DirectResidentMath::MidpointGeluRounded(v.f));
            }
        }
        SetFlag<HardEvent::S_MTE3>(EVENT_ID2);WaitFlag<HardEvent::S_MTE3>(EVENT_ID2);
        DataCopyPad(yg[(int64_t)row*N+col],out,DataCopyExtParams{(uint16_t)rows,(uint32_t)(cols*2),(uint32_t)((pitch-(cols+15)/16*16)/16),(uint32_t)((N-cols)*2),0});
    
}


template<int BN> __aicore__ inline void LoadColumn(LocalTensor<int8_t> b1,GlobalTensor<int8_t> bw,int e,int K,int N,int col){
    int cols=N-col<BN?N-col:BN,an=(cols+31)/32*32;
            Nd2NzParams bp;bp.ndNum=1;bp.nValue=K;bp.dValue=cols;bp.srcNdMatrixStride=0;bp.srcDValue=N;bp.dstNzC0Stride=(K+31)/32*32;bp.dstNzNStride=1;bp.dstNzMatrixStride=0;
            DataCopy(b1,bw[(int64_t)e*K*N+col],bp);

}
template<int BM,int BN,int PK>
__global__ __aicore__ void grouped_gelu_dual_resident(GM_ADDR x,GM_ADDR w,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,GM_ADDR partial,int E,int M,int K,int N,int cores){
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
    int nc=(N+BN-1)/BN,pk=(K+31)/32*32;
    GlobalTensor<int64_t> ends;ends.SetGlobalBuffer((__gm__ int64_t*)groups);
    int core=GetBlockIdx();if ASCEND_IS_AIV {core/=2;}
    int sequence=0;bool initialized=false;
    int width=(N+31)/32,lo=(E*width*core+cores-1)/cores,hi=(E*width*(core+1)+cores-1)/cores;
    int begin=lo/width*nc+((lo%width)+(BN/32)-1)/(BN/32),limit=hi/width*nc+((hi%width)+(BN/32)-1)/(BN/32);
    if ASCEND_IS_AIC {
        GlobalTensor<int8_t> ax,bw;GlobalTensor<int32_t> cg;
        ax.SetGlobalBuffer((__gm__ int8_t*)x);bw.SetGlobalBuffer((__gm__ int8_t*)w);cg.SetGlobalBuffer((__gm__ int32_t*)partial);
        LocalTensor<int8_t> a1(TPosition::A1,0,196608),b1(TPosition::B1,196608,327680);
        LocalTensor<int8_t> a2(TPosition::A2,0,2*BM*PK),b2(TPosition::B2,0,2*BN*PK);
        LocalTensor<int32_t> cc(TPosition::CO1,0,BM*BN);
        SetFlag<HardEvent::M_MTE1>(EVENT_ID0);SetFlag<HardEvent::M_MTE1>(EVENT_ID1);
        SetFlag<HardEvent::FIX_M>(EVENT_ID0);
        int cachedRow=-1,columnSequence=0;
        if(begin<limit){LoadColumn<BN>(b1,bw,begin/nc,K,N,begin%nc*BN);SetFlag<HardEvent::MTE2_MTE1>(EVENT_ID2);}
        for(int strip=begin;strip<limit;++strip,++columnSequence){
            int e=strip/nc,col=strip%nc*BN,start=e?(int)ends.GetValue(e-1):0,end=(int)ends.GetValue(e);
            int cols=N-col<BN?N-col:BN,an=(cols+31)/32*32;
            int aRows=BM;
            if(start<end && cachedRow!=start){
                PipeBarrier<PIPE_ALL>();
                int headRows=end-start<BM?end-start:BM;
                Nd2NzParams ap;ap.ndNum=1;ap.nValue=headRows;ap.dValue=K;ap.srcNdMatrixStride=0;ap.srcDValue=K;ap.dstNzC0Stride=BM;ap.dstNzNStride=1;ap.dstNzMatrixStride=0;
                DataCopy(a1,ax[(int64_t)start*K],ap);cachedRow=start;SetFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);WaitFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);
            }
            WaitFlag<HardEvent::MTE2_MTE1>((TEventID)(2+columnSequence%2));
            if(strip+1<limit){
                int next=strip+1;
                LoadColumn<BN>(b1[((columnSequence+1)%2)*163840],bw,next/nc,K,N,next%nc*BN);
                SetFlag<HardEvent::MTE2_MTE1>((TEventID)(2+(columnSequence+1)%2));
            }
            for(int row=start;row<end;row+=BM){
                int rows=end-row<BM?end-row:BM,ar=BM,slot=sequence%2;
                if(row!=start){
                    PipeBarrier<PIPE_ALL>();
                    Nd2NzParams ap;ap.ndNum=1;ap.nValue=rows;ap.dValue=K;ap.srcNdMatrixStride=0;ap.srcDValue=K;ap.dstNzC0Stride=BM;ap.dstNzNStride=1;ap.dstNzMatrixStride=0;
                    DataCopy(a1,ax[(int64_t)row*K],ap);cachedRow=row;
                    SetFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);WaitFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);
                }
                WaitFlag<HardEvent::FIX_M>(EVENT_ID0);
                for(int k0=0,j=0;k0<K;k0+=PK,++j){
                    int q=j%2,kl=K-k0<PK?K-k0:PK,ak=(kl+31)/32*32;
                    WaitFlag<HardEvent::M_MTE1>((TEventID)q);
                    LoadData3DParamsV2<int8_t> al;
                    al.l1H = 1;
                    al.l1W = aRows;
                    al.channelSize = pk;
                    al.kExtension = ak;
                    al.mExtension = ar;
                    al.kStartPt = k0;
                    al.mStartPt = 0;
                    al.strideW = 1;
                    al.strideH = 1;
                    al.filterW = 1;
                    al.filterH = 1;
                    al.dilationFilterW = 1;
                    al.dilationFilterH = 1;
                    al.padList[0] = 0;
                    al.padList[1] = 0;
                    al.padList[2] = 0;
                    al.padList[3] = 0;
                    al.enTranspose = false;
                    al.enSmallK = false;
                    al.padValue = 0;
                    LoadData(a2[q*BM*PK],a1,al);
                    LoadData2dTransposeParams bl;bl.startIndex=0;bl.repeatTimes=an/32;bl.srcStride=pk/32;bl.dstGap=1;bl.dstFracGap=0;
                    for(int ki=0;ki<ak;ki+=32)LoadDataWithTranspose(b2[q*BN*PK+ki*an],b1[(columnSequence%2)*163840+(k0+ki)*32],bl);
                    SetFlag<HardEvent::MTE1_M>(EVENT_ID0);WaitFlag<HardEvent::MTE1_M>(EVENT_ID0);
                    MmadParams mp;mp.m=ar;mp.n=an;mp.k=kl;mp.cmatrixInitVal=k0==0;
                    Mmad(cc,a2[q*BM*PK],b2[q*BN*PK],mp);SetFlag<HardEvent::M_MTE1>((TEventID)q);
                }
                SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);
                SetFlag<HardEvent::M_FIX>(EVENT_ID0);WaitFlag<HardEvent::M_FIX>(EVENT_ID0);
                if(sequence>=2)CrossCoreWaitFlag<2>(9+2*slot);
                FixpipeParamsV220 fp;fp.nSize=an;fp.mSize=rows;fp.srcStride=ar;fp.dstStride=BN;fp.ndNum=1;fp.srcNdStride=0;fp.dstNdStride=0;
                Fixpipe(cg[(core*2+slot)*BM*BN],cc,fp);
                CrossCoreSetFlag<2,PIPE_FIX>(8+2*slot);++sequence;
                SetFlag<HardEvent::FIX_M>(EVENT_ID0);
            }
        }
        for(int q=sequence>2?sequence-2:0;q<sequence;++q)CrossCoreWaitFlag<2>(9+2*(q%2));
        WaitFlag<HardEvent::M_MTE1>(EVENT_ID0);WaitFlag<HardEvent::M_MTE1>(EVENT_ID1);
        WaitFlag<HardEvent::FIX_M>(EVENT_ID0);
    }else{
        for(int strip=begin;strip<limit;++strip){
            int e=strip/nc,col=strip%nc*BN,start=e?(int)ends.GetValue(e-1):0,end=(int)ends.GetValue(e);
            for(int row=start;row<end;row+=BM){
                int rows=end-row<BM?end-row:BM;
                FinishDualResident<BM,BN>(partial,scale,y,e,row,rows,col,N,core*2+sequence%2,sequence,initialized);
                PipeBarrier<PIPE_ALL>();++sequence;
            }
        }
    }
    PipeBarrier<PIPE_ALL>();
}
static void LaunchDualResident(GM_ADDR x,const TensorGroupInfo& info_x,
    GM_ADDR weight,const TensorGroupInfo& info_weight,GM_ADDR scale,const TensorGroupInfo& info_scale,
    GM_ADDR group_list,const TensorGroupInfo& info_group_list,GM_ADDR y,const TensorGroupInfo& info_y,
    int64_t availableCoreNum,aclrtStream stream){
    int E=info_weight.tensors[0].shape[0],M=info_x.tensors[0].shape[0],K=info_x.tensors[0].shape[1],N=info_weight.tensors[0].shape[2];
    auto platform=platform_ascendc::PlatformAscendCManager::GetInstance();
    int cores=std::min<int64_t>(20,std::min<int64_t>(availableCoreNum,platform->GetCoreNumAic()));
    constexpr int BM=160,BN=128,PK=128;
    void* memory=nullptr;
    if(aclrtMalloc(&memory,(size_t)cores*2*BM*BN*4,ACL_MEM_MALLOC_HUGE_FIRST)!=0)throw std::runtime_error("allocation failed");
    grouped_gelu_dual_resident<BM,BN,PK><<<cores,nullptr,stream>>>(x,weight,scale,group_list,y,(GM_ADDR)memory,E,M,K,N,cores);
    auto status=aclrtSynchronizeStream(stream);aclrtFree(memory);
    if(status!=0)throw std::runtime_error("kernel failed");
}

namespace QueuedResidentMath {
using DirectResidentMath::AccurateGeluRounded;
__aicore__ static __attribute__((noinline)) float MidpointGeluRounded(float z) {
#pragma clang fp reassociate(off) contract(off)
    float az=z>=0.0f?z:-z;
    if(az<0.03125f)return AccurateGeluRounded(z);
    union Bits {float f;uint32_t u;} input,result,unit,power;input.f=az;
    if(z>=5.25f) {
        if(input.u<0x40e2dbe6u && (input.u&8191u)==4096u)--input.u;
        return input.f;
    }
    uint64_t x=uint64_t((input.u&0x7fffffu)|0x800000u)<<(((input.u>>23)&255)-122);
    uint64_t square=(x*x+(1ULL<<29))>>30;
    uint64_t term=(square*3072791402ULL+(1ULL<<31))>>32;
    uint64_t cubic=(x*(term+(1ULL<<30))+(1ULL<<25))>>26;
    uint64_t expHigh=((cubic>>32)*1713444047ULL)<<2;
    uint64_t expLow=(((cubic&0xffffffffULL)*1713444047ULL)+(1ULL<<29))>>30;
    int64_t exponent=(int64_t)(expHigh+expLow);
    int64_t sh=-(exponent+1488522236LL)/2977044472LL;
    int64_t r=(-exponent-sh*2977044472LL+1)>>1;
    int64_t t=592;
    t=((t*r+(1LL<<30))>>31)+5918LL;
    t=((t*r+(1LL<<30))>>31)+53261LL;
    t=((t*r+(1LL<<30))>>31)+426088LL;
    t=((t*r+(1LL<<30))>>31)+2982616LL;
    t=((t*r+(1LL<<30))>>31)+17895697LL;
    t=((t*r+(1LL<<30))>>31)+89478485LL;
    t=((t*r+(1LL<<30))>>31)+357913941LL;
    t=((t*r+(1LL<<30))>>31)+1073741824LL;
    t=((t*r+(1LL<<30))>>31)+2147483648LL;
    t=((t*r+(1LL<<30))>>31)+2147483648LL;
    power.u=(uint32_t)(sh-30+127)<<23;
    float e=(float)(int32_t)(t>>1)*power.f;
    float d=(az*e)/(1.0f+e),low=0.0f;
    if(z>=0.0f){result.f=z-d;low=(z-result.f)-d;}else result.f=-d;
    int exponentY=(result.u>>23)&255,shift=exponentY>=113?13:126-exponentY;
    if(shift<=0 || shift>=25)return result.f;
    uint32_t mant=(result.u&0x7fffffu)|0x800000u;
    int32_t rem=(int32_t)(mant&((1u<<shift)-1u)),mid=1u<<(shift-1);
    unit.u=(uint32_t)(exponentY-23)<<23;
    float distance=(float)(rem-mid)*unit.f+(result.f>=0.0f?low:-low);
    float absolute=distance>=0.0f?distance:-distance;
    if(absolute<=2.0e-7f*d)return AccurateGeluRounded(z);
    if(rem==mid && low!=0.0f)result.u=((low>0.0f)==(result.f>0.0f))?result.u+1:result.u-1;
    return result.f;
}
}

template <int BM, int BN, bool SUBNORMAL_REPAIR = true>
__aicore__ inline void FinishQueuedResident(GM_ADDR partial, GM_ADDR scale, GM_ADDR y, int e, int start, int expertRows,
                                            int col, int N, int task, int sequence, bool &initialized, int &scaleExpert,
                                            bool hasNext, int nextRows, int nextCols) {
    constexpr int Q=BM*BN/2;

        int sub=GetBlockIdx()%2;
        int row=start+sub*(BM/2);
        int rows=expertRows-sub*(BM/2);rows=rows<BM/2?rows:BM/2;int cols=N-col<BN?N-col:BN;
        constexpr int MASK_BYTES=(Q/8+31)/32*32;
        constexpr int RAMP_BYTES=(Q/16+31)/32*32;
        constexpr int MASK_BASE=14*Q+RAMP_BYTES;
        constexpr int COEFF=MASK_BASE+2*MASK_BYTES;
        LocalTensor<float> z(TPosition::VECCALC,(sequence%2)*16*Q,Q),a(TPosition::VECCALC,4*Q,Q),b(TPosition::VECCALC,8*Q,Q),coefficients(TPosition::VECCALC,COEFF,32),scales(TPosition::VECCALC,COEFF+128,(N+7)/8*8);
        LocalTensor<half> out(TPosition::VECCALC,12*Q,Q);LocalTensor<int16_t> ramp(TPosition::VECCALC,14*Q,Q/32);
        LocalTensor<uint8_t> m1(TPosition::VECCALC,MASK_BASE,Q/8),m2(TPosition::VECCALC,MASK_BASE+MASK_BYTES,Q/8);
        GlobalTensor<int32_t> cg;GlobalTensor<float> sg;GlobalTensor<half> yg;cg.SetGlobalBuffer((__gm__ int32_t*)partial);sg.SetGlobalBuffer((__gm__ float*)scale);yg.SetGlobalBuffer((__gm__ half*)y);
        auto tieBits=coefficients[16].ReinterpretCast<uint16_t>(),nearBits=coefficients[24].ReinterpretCast<uint16_t>();
        if(!initialized){initialized=true;SetFlag<HardEvent::MTE3_V>(EVENT_ID3);
        Duplicate(z.ReinterpretCast<int32_t>(),0,Q);Duplicate(scales,0.0f,(N+7)/8*8);Duplicate(coefficients,-0.07135481627260025f,8);Duplicate(coefficients[8],-1.5957691216057308f,8);PipeBarrier<PIPE_V>();
Duplicate(tieBits.ReinterpretCast<uint32_t>(),(uint32_t)0xff001ff8,8);Duplicate(nearBits.ReinterpretCast<uint32_t>(),(uint32_t)0xff8000ff,8);
        for(int i=0;i<16;++i)ramp.SetValue(i,i);SetFlag<HardEvent::S_V>(EVENT_ID2);WaitFlag<HardEvent::S_V>(EVENT_ID2);
        for(int span=16;span<Q/32;span*=2){int count=Q/32-span<span?Q/32-span:span;Adds(ramp[span],ramp,(int16_t)span,count);PipeBarrier<PIPE_V>();}
        }
        SetFlag<HardEvent::V_MTE2>(EVENT_ID0);WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
        if(scaleExpert!=e){scaleExpert=e;DataCopyPad(scales,sg[(int64_t)e*N],DataCopyExtParams{1,(uint32_t)(N*4),0,0,0},DataCopyPadExtParams<float>{true,0,(uint8_t)((8-N%8)%8),0});}
        int pitch=(cols+31)/32*32;int aligned=(cols+7)/8*8;
        if(sequence==0){
            CrossCoreWaitFlag<2>(8);
            if (rows > 0)
                DataCopyPad(z.ReinterpretCast<int32_t>(), cg[(int64_t)task * BM * BN + sub * Q],
                            DataCopyExtParams{(uint16_t)rows, (uint32_t)(cols * 4), (uint32_t)((BN - cols) * 4),
                                              (uint32_t)((pitch - aligned) / 8), 0},
                            DataCopyPadExtParams<int32_t>{true, 0, (uint8_t)(aligned - cols), 0});
            CrossCoreSetFlag<2,PIPE_MTE2>(9);
        }else WaitFlag<HardEvent::MTE2_V>(EVENT_ID4);
        SetFlag<HardEvent::MTE2_V>(EVENT_ID0);WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
        if(rows<=0){
        if(hasNext){
            int nr=nextRows-sub*(BM/2);nr=nr<BM/2?nr:BM/2;
            int np=(nextCols+31)/32*32,na=(nextCols+7)/8*8;
            LocalTensor<int32_t> nextZ(TPosition::VECCALC,((sequence+1)%2)*16*Q,Q);
            CrossCoreWaitFlag<2>(8+2*((sequence+1)%4));
            if (nr > 0)
                DataCopyPad(nextZ, cg[(int64_t)((task / 4) * 4 + (sequence + 1) % 4) * BM * BN + sub * Q],
                            DataCopyExtParams{(uint16_t)nr, (uint32_t)(nextCols * 4), (uint32_t)((BN - nextCols) * 4),
                                              (uint32_t)((np - na) / 8), 0},
                            DataCopyPadExtParams<int32_t>{true, 0, (uint8_t)(na - nextCols), 0});
            CrossCoreSetFlag<2,PIPE_MTE2>(9+2*((sequence+1)%4));
            SetFlag<HardEvent::MTE2_V>(EVENT_ID4);
        }
return;}
        int count=(rows*pitch+63)/64*64;Cast(z,z.ReinterpretCast<int32_t>(),RoundMode::CAST_RINT,count);PipeBarrier<PIPE_V>();
        for(int c=0;c<pitch;c+=64)Mul(z[c],z[c],scales[col+c],(uint64_t)(pitch-c<64?pitch-c:64),(uint8_t)rows,BinaryRepeatParams{1,1,1,(uint8_t)(pitch/8),(uint8_t)(pitch/8),0});PipeBarrier<PIPE_V>();
        int n=count;
    Mul(a,z,z,n);PipeBarrier<PIPE_V>();
    Muls(a,a,-0.07135481627260025f,n);PipeBarrier<PIPE_V>();
    Adds(a,a,-1.5957691216057308f,n);PipeBarrier<PIPE_V>();
    Mul(a,a,z,n);PipeBarrier<PIPE_V>();

    Exp(b,a,n);PipeBarrier<PIPE_V>();
    Adds(a,b,1.0f,n);PipeBarrier<PIPE_V>();
    Div(b,z,a,n);PipeBarrier<PIPE_V>();
    Adds(a.ReinterpretCast<int32_t>(),b.ReinterpretCast<int32_t>(),(int32_t)4,n);PipeBarrier<PIPE_V>();
    And(a.ReinterpretCast<uint16_t>(),a.ReinterpretCast<uint16_t>(),tieBits,(uint64_t)128,(uint8_t)(n/64),BinaryRepeatParams{1,1,0,8,8,0});PipeBarrier<PIPE_V>();
    CompareScalar(m1,a.ReinterpretCast<int32_t>(),(int32_t)0x40001000,CMPMODE::EQ,n);PipeBarrier<PIPE_V>();
    if constexpr(SUBNORMAL_REPAIR){
    Adds(a,b,-0.001953125f,n);PipeBarrier<PIPE_V>();
    And(a.ReinterpretCast<uint16_t>(),a.ReinterpretCast<uint16_t>(),nearBits,(uint64_t)128,(uint8_t)(n/64),BinaryRepeatParams{1,1,0,8,8,0});PipeBarrier<PIPE_V>();
    CompareScalar(m2,a.ReinterpretCast<int32_t>(),(int32_t)0xbb000080,CMPMODE::EQ,n);PipeBarrier<PIPE_V>();
    Or(m1.ReinterpretCast<uint16_t>(),m1.ReinterpretCast<uint16_t>(),m2.ReinterpretCast<uint16_t>(),n/16);PipeBarrier<PIPE_V>();
    }
    uint64_t selectedCount=0;
    CompareScalar(m2,m1.ReinterpretCast<int32_t>(),(int32_t)0,CMPMODE::EQ,n/32);PipeBarrier<PIPE_V>();
    Not(m2.ReinterpretCast<uint16_t>(),m2.ReinterpretCast<uint16_t>(),(n+511)/512);PipeBarrier<PIPE_V>();
    SetMaskCount();SetVectorMask<int16_t,MaskMode::COUNTER>(0,n/32);
    GatherMask(a.ReinterpretCast<int16_t>(),ramp,m2.ReinterpretCast<int16_t>(),(uint8_t)0,GatherMaskParams{1,1,8,0});
    SetMaskNorm();ResetMask();
        if(hasNext){
            int nr=nextRows-sub*(BM/2);nr=nr<BM/2?nr:BM/2;
            int np=(nextCols+31)/32*32,na=(nextCols+7)/8*8;
            LocalTensor<int32_t> nextZ(TPosition::VECCALC,((sequence+1)%2)*16*Q,Q);
            CrossCoreWaitFlag<2>(8+2*((sequence+1)%4));
            if (nr > 0)
                DataCopyPad(nextZ, cg[(int64_t)((task / 4) * 4 + (sequence + 1) % 4) * BM * BN + sub * Q],
                            DataCopyExtParams{(uint16_t)nr, (uint32_t)(nextCols * 4), (uint32_t)((BN - nextCols) * 4),
                                              (uint32_t)((np - na) / 8), 0},
                            DataCopyPadExtParams<int32_t>{true, 0, (uint8_t)(na - nextCols), 0});
            CrossCoreSetFlag<2,PIPE_MTE2>(9+2*((sequence+1)%4));
            SetFlag<HardEvent::MTE2_V>(EVENT_ID4);
        }
    WaitFlag<HardEvent::MTE3_V>(EVENT_ID3);
    Cast(out,b,RoundMode::CAST_RINT,n);PipeBarrier<PIPE_V>();

        SetFlag<HardEvent::V_S>(EVENT_ID2);WaitFlag<HardEvent::V_S>(EVENT_ID2);selectedCount=GetGatherMaskRemainCount();
        for (uint64_t j = 0; j < selectedCount; ++j) {
            int wordIndex = a.ReinterpretCast<int16_t>().GetValue(j);
            uint32_t word = m1.ReinterpretCast<uint32_t>().GetValue(wordIndex);
            while (word) {
                int bit = __builtin_ctz(word);
                word &= word - 1;
                int index = wordIndex * 32 + bit;

                union {
                    float f;
                    uint32_t u;
                } v;

                v.f = z.GetValue(index);
                if (v.f >= 0.0f) {
                    out.SetValue(index, (half)QueuedResidentMath::MidpointGeluRounded(v.f));
                } else if (v.f < 0.0f && b.GetValue(index) > -0.00006103515625f)
                    out.SetValue(index, (half)QueuedResidentMath::MidpointGeluRounded(v.f));
            }
        }
        SetFlag<HardEvent::S_MTE3>(EVENT_ID2);WaitFlag<HardEvent::S_MTE3>(EVENT_ID2);
        DataCopyPad(yg[(int64_t)row*N+col],out,DataCopyExtParams{(uint16_t)rows,(uint32_t)(cols*2),(uint32_t)((pitch-(cols+15)/16*16)/16),(uint32_t)((N-cols)*2),0});
        SetFlag<HardEvent::MTE3_V>(EVENT_ID3);
}

template<int BN> __aicore__ inline void CopyQueuedWeightColumn(LocalTensor<int8_t> dst,GlobalTensor<int8_t> src,int e,int K,int N,int col){
    int cols=N-col<BN?N-col:BN,an=(cols+31)/32*32;
    Nd2NzParams p;p.ndNum=K/32;p.nValue=32;p.dValue=cols;p.srcNdMatrixStride=32*N;p.srcDValue=N;p.dstNzC0Stride=32;p.dstNzNStride=1;p.dstNzMatrixStride=32*an;
    if(K/32)DataCopy(dst,src[(int64_t)e*K*N+col],p);
    if(K%32){p.ndNum=1;p.nValue=K%32;DataCopy(dst[(K/32)*32*an],src[((int64_t)e*K+K/32*32)*N+col],p);}
}
template<int BM,int BN,int PK>
__global__ __aicore__ void grouped_gelu_queued_resident(GM_ADDR x,GM_ADDR w,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,GM_ADDR partial,int E,int M,int K,int N,int cores){
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
    constexpr int BSlots=2*BN*PK<=65536?2:1;
    int nc=(N+BN-1)/BN,pk=(K+31)/32*32;
    GlobalTensor<int64_t> ends;ends.SetGlobalBuffer((__gm__ int64_t*)groups);
    int core=GetBlockIdx();if ASCEND_IS_AIV {core/=2;}
    int chunk=(E*nc+cores-1)/cores,begin=core*chunk,limit=(core+1)*chunk;limit=limit<E*nc?limit:E*nc;
    int sequence=0,scaleExpert=-1,boundsExpert=-1,boundsStart=0,boundsEnd=0;bool initialized=false;
    if ASCEND_IS_AIC {
        GlobalTensor<int8_t> ax,bw;GlobalTensor<int32_t> cg;
        ax.SetGlobalBuffer((__gm__ int8_t*)x);bw.SetGlobalBuffer((__gm__ int8_t*)w);cg.SetGlobalBuffer((__gm__ int32_t*)partial);
        LocalTensor<int8_t> a1(TPosition::A1,0,131072),b1(TPosition::B1,131072,393216);
        LocalTensor<int8_t> a2(TPosition::A2,0,65536),b2(TPosition::B2,0,BSlots*BN*PK);
        LocalTensor<int32_t> cc(TPosition::CO1,0,2*BM*BN);
        for(int i=0;i<BSlots;++i)SetFlag<HardEvent::M_MTE1>((TEventID)i);
        for(int c=0;c<2;++c)SetFlag<HardEvent::FIX_M>((TEventID)c);
        int cachedRow=-1,columnSequence=0;
        if(begin<limit){CopyQueuedWeightColumn<BN>(b1,bw,begin/nc,K,N,begin%nc*BN);SetFlag<HardEvent::MTE2_MTE1>(EVENT_ID2);}
        for(int strip=begin;strip<limit;++strip,++columnSequence){
            int e=strip/nc,col=strip%nc*BN;if(boundsExpert!=e){boundsExpert=e;boundsStart=e?(int)ends.GetValue(e-1):0;boundsEnd=(int)ends.GetValue(e);}int start=boundsStart,end=boundsEnd;
            int cols=N-col<BN?N-col:BN,an=(cols+31)/32*32;
            WaitFlag<HardEvent::MTE2_MTE1>((TEventID)(2+columnSequence%2));
            if(start==end && strip+1<limit){int next=strip+1;CopyQueuedWeightColumn<BN>(b1[((columnSequence+1)%2)*196608],bw,next/nc,K,N,next%nc*BN);SetFlag<HardEvent::MTE2_MTE1>((TEventID)(2+(columnSequence+1)%2));}
            for(int row=start;row<end;row+=BM){
                int rows=end-row<BM?end-row:BM,slot=sequence%2;
                WaitFlag<HardEvent::FIX_M>((TEventID)slot);
                if(cachedRow!=row){
                    Nd2NzParams ap;ap.ndNum=1;ap.nValue=rows;ap.dValue=K;ap.srcNdMatrixStride=0;ap.srcDValue=K;ap.dstNzC0Stride=BM;ap.dstNzNStride=1;ap.dstNzMatrixStride=0;
                    DataCopy(a1,ax[(int64_t)row*K],ap);
                    SetFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);WaitFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);
                    for(int k0=0;k0<K;k0+=PK){
                        int kl=K-k0<PK?K-k0:PK,ak=(kl+31)/32*32;
                        LoadData3DParamsV2<int8_t> al;
                        al.l1H = 1;
                        al.l1W = BM;
                        al.channelSize = pk;
                        al.kExtension = ak;
                        al.mExtension = BM;
                        al.kStartPt = k0;
                        al.mStartPt = 0;
                        al.strideW = 1;
                        al.strideH = 1;
                        al.filterW = 1;
                        al.filterH = 1;
                        al.dilationFilterW = 1;
                        al.dilationFilterH = 1;
                        al.padList[0] = 0;
                        al.padList[1] = 0;
                        al.padList[2] = 0;
                        al.padList[3] = 0;
                        al.enTranspose = false;
                        al.enSmallK = false;
                        al.padValue = 0;
                        LoadData(a2[k0*BM],a1,al);
                    }
                    cachedRow=row;
                }
                if(row==start && strip+1<limit){int next=strip+1;CopyQueuedWeightColumn<BN>(b1[((columnSequence+1)%2)*196608],bw,next/nc,K,N,next%nc*BN);SetFlag<HardEvent::MTE2_MTE1>((TEventID)(2+(columnSequence+1)%2));}
                for(int k0=0,j=0;k0<K;k0+=PK,++j){
                    int q=j%BSlots,kl=K-k0<PK?K-k0:PK,ak=(kl+31)/32*32;
                    WaitFlag<HardEvent::M_MTE1>((TEventID)q);
                    LoadData2dTransposeParams bl;bl.startIndex=0;bl.repeatTimes=ak*an/1024;bl.srcStride=1;bl.dstGap=1;bl.dstFracGap=0;
                    LoadDataWithTranspose(b2[q*BN*PK],b1[(columnSequence%2)*196608+k0*an],bl);
                    SetFlag<HardEvent::MTE1_M>(EVENT_ID0);WaitFlag<HardEvent::MTE1_M>(EVENT_ID0);
                    MmadParams mp;mp.m=BM;mp.n=an;mp.k=kl;mp.cmatrixInitVal=k0==0;
                    Mmad(cc[slot*BM*BN],a2[k0*BM],b2[q*BN*PK],mp);if((BM/16)*(an/16)<10)PipeBarrier<PIPE_M>();SetFlag<HardEvent::M_MTE1>((TEventID)q);
                }
                SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);
                SetFlag<HardEvent::M_FIX>(EVENT_ID0);WaitFlag<HardEvent::M_FIX>(EVENT_ID0);
                if(sequence>=4)CrossCoreWaitFlag<2>(9+2*(sequence%4));
                FixpipeParamsV220 fp;fp.nSize=an;fp.mSize=BM;fp.srcStride=BM;fp.dstStride=BN;fp.ndNum=1;fp.srcNdStride=0;fp.dstNdStride=0;
                Fixpipe(cg[(core*4+sequence%4)*BM*BN],cc[slot*BM*BN],fp);CrossCoreSetFlag<2,PIPE_FIX>(8+2*(sequence%4));++sequence;
                SetFlag<HardEvent::FIX_M>((TEventID)slot);
            }
        }
        for(int q=sequence>4?sequence-4:0;q<sequence;++q)CrossCoreWaitFlag<2>(9+2*(q%4));
        for(int i=0;i<BSlots;++i)WaitFlag<HardEvent::M_MTE1>((TEventID)i);
        for(int c=0;c<2;++c)WaitFlag<HardEvent::FIX_M>((TEventID)c);
    }else{
        for(int strip=begin;strip<limit;++strip){
            int e=strip/nc,col=strip%nc*BN;if(boundsExpert!=e){boundsExpert=e;boundsStart=e?(int)ends.GetValue(e-1):0;boundsEnd=(int)ends.GetValue(e);}int start=boundsStart,end=boundsEnd;
            for(int row=start;row<end;row+=BM){
                int rows=end-row<BM?end-row:BM;
                bool hasNext=false;int nextRows=0,nextCols=0;
                if(row+BM<end){hasNext=true;nextRows=end-row-BM;nextRows=nextRows<BM?nextRows:BM;nextCols=N-col<BN?N-col:BN;}
                else if(strip+1<limit){
                    int ns=strip+1;
                    while(ns<limit){int ne=ns/nc,nb=ne==e?start:(ne?(int)ends.GetValue(ne-1):0),nn=ne==e?end:(int)ends.GetValue(ne);
                        if(nn>nb){hasNext=true;nextRows=nn-nb;nextRows=nextRows<BM?nextRows:BM;int ncol=ns%nc*BN;nextCols=N-ncol<BN?N-ncol:BN;break;}ns=(ne+1)*nc;
                    }
                }
                FinishQueuedResident<BM,BN,false>(partial,scale,y,e,row,rows,col,N,core*4+sequence%4,sequence,initialized,scaleExpert,hasNext,nextRows,nextCols);
                ++sequence;
            }
        }
        if(initialized)WaitFlag<HardEvent::MTE3_V>(EVENT_ID3);
    }
    PipeBarrier<PIPE_ALL>();
}
static void LaunchQueuedResident(GM_ADDR x,const TensorGroupInfo& info_x,
    GM_ADDR weight,const TensorGroupInfo& info_weight,GM_ADDR scale,const TensorGroupInfo& info_scale,
    GM_ADDR group_list,const TensorGroupInfo& info_group_list,GM_ADDR y,const TensorGroupInfo& info_y,
    int64_t availableCoreNum,aclrtStream stream){
    int E=info_weight.tensors[0].shape[0],M=info_x.tensors[0].shape[0],K=info_x.tensors[0].shape[1],N=info_weight.tensors[0].shape[2];
    auto platform=platform_ascendc::PlatformAscendCManager::GetInstance();
    int cores=std::min<int64_t>(20,std::min<int64_t>(availableCoreNum,platform->GetCoreNumAic()));
    constexpr int BM=64,BN=256,PK=128;
    void* memory=nullptr;
    if(aclrtMalloc(&memory,(size_t)cores*4*BM*BN*4,ACL_MEM_MALLOC_HUGE_FIRST)!=0)throw std::runtime_error("allocation failed");
    grouped_gelu_queued_resident<BM,BN,PK><<<cores,nullptr,stream>>>(x,weight,scale,group_list,y,(GM_ADDR)memory,E,M,K,N,cores);
    auto status=aclrtSynchronizeStream(stream);aclrtFree(memory);
    if(status!=0)throw std::runtime_error("kernel failed");
}

template<int VK,int BN> __aicore__ inline void LoadPairedBand(LocalTensor<int8_t> b1,GlobalTensor<int8_t> bw,int e,int K,int N,int col,int cols,int an,int band,int phase){
                    int offset=band*VK,depth=K-offset<VK?K-offset:VK,bs=(band+phase)%2;
                    Nd2NzParams bp;bp.ndNum=1;bp.nValue=depth;bp.dValue=cols;bp.srcNdMatrixStride=0;bp.srcDValue=N;bp.dstNzC0Stride=VK;bp.dstNzNStride=1;bp.dstNzMatrixStride=0;
                    DataCopy(b1[bs*VK*BN],bw[((int64_t)e*K+offset)*N+col],bp);
                    SetFlag<HardEvent::MTE2_MTE1>((TEventID)(2+bs));
}

template<int BM,int BN,int PK,int VK>
__global__ __aicore__ void grouped_gelu_paired_columns(GM_ADDR x,GM_ADDR w,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,GM_ADDR partial,int E,int M,int K,int N,int cores){
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
    constexpr int L0Slots=2*BN*PK<=65536?2:1;
    constexpr int WN=2*BN;int nc=(N+WN-1)/WN,pk=(K+31)/32*32;
    GlobalTensor<int64_t> ends;ends.SetGlobalBuffer((__gm__ int64_t*)groups);
    int core=GetBlockIdx();if ASCEND_IS_AIV {core/=2;}
    int begin=E*nc*core/cores,limit=E*nc*(core+1)/cores;
    int sequence=0,scaleExpert=-1;bool initialized=false;
    if ASCEND_IS_AIC {
        GlobalTensor<int8_t> ax,bw;GlobalTensor<int32_t> cg;
        ax.SetGlobalBuffer((__gm__ int8_t*)x);bw.SetGlobalBuffer((__gm__ int8_t*)w);cg.SetGlobalBuffer((__gm__ int32_t*)partial);
        LocalTensor<int8_t> a1(TPosition::A1,0,131072),b1(TPosition::B1,131072,393216);
        LocalTensor<int8_t> a2(TPosition::A2,0,L0Slots*BM*PK),b2(TPosition::B2,0,L0Slots*BN*PK);
        LocalTensor<int32_t> cc(TPosition::CO1,0,2*BM*BN);
        for(int i=0;i<L0Slots;++i)SetFlag<HardEvent::M_MTE1>((TEventID)i);
        SetFlag<HardEvent::FIX_M>(EVENT_ID0);
        int cachedRow=-1,phase=0;bool prefetched=false;
        for(int strip=begin;strip<limit;++strip){
            int e=strip/nc,col=strip%nc*WN,start=e?(int)ends.GetValue(e-1):0,end=(int)ends.GetValue(e);
            int cols=N-col<WN?N-col:WN,an=(cols+31)/32*32;
            for(int row=start;row<end;row+=BM){
                int rows=end-row<BM?end-row:BM;
                WaitFlag<HardEvent::FIX_M>(EVENT_ID0);
                if(cachedRow!=row){
                    SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);
                    Nd2NzParams ap;ap.ndNum=1;ap.nValue=rows;ap.dValue=K;ap.srcNdMatrixStride=0;ap.srcDValue=K;ap.dstNzC0Stride=BM;ap.dstNzNStride=1;ap.dstNzMatrixStride=0;
                    DataCopy(a1,ax[(int64_t)row*K],ap);
                    SetFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);WaitFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);cachedRow=row;
                }
                if(!prefetched){LoadPairedBand<VK,WN>(b1,bw,e,K,N,col,cols,an,0,phase);if(K>VK)LoadPairedBand<VK,WN>(b1,bw,e,K,N,col,cols,an,1,phase);}prefetched=false;
                int nextStrip=-1,nextExpert=0,nextColumn=0,nextWidth=0;
                if(row+BM<end)nextStrip=strip;
                else for(int ns=strip+1;ns<limit;++ns){int ne=ns/nc,nb=ne?(int)ends.GetValue(ne-1):0;if((int)ends.GetValue(ne)>nb){nextStrip=ns;break;}}
                if(nextStrip>=0){nextExpert=nextStrip/nc;nextColumn=nextStrip%nc*WN;nextWidth=N-nextColumn<WN?N-nextColumn:WN;}
                int bands=(K+VK-1)/VK,nextPhase=(phase+bands)%2;
                for(int k0=0,j=0;k0<K;k0+=PK,++j){
                    int band=k0/VK,bs=(band+phase)%2;if(k0%VK==0)WaitFlag<HardEvent::MTE2_MTE1>((TEventID)(2+bs));
                    int q=j%L0Slots,kl=K-k0<PK?K-k0:PK,ak=(kl+31)/32*32;
                    WaitFlag<HardEvent::M_MTE1>(EVENT_ID0);
                    LoadData3DParamsV2<int8_t> al;
                    al.l1H = 1;
                    al.l1W = BM;
                    al.channelSize = pk;
                    al.kExtension = ak;
                    al.mExtension = BM;
                    al.kStartPt = k0;
                    al.mStartPt = 0;
                    al.strideW = 1;
                    al.strideH = 1;
                    al.filterW = 1;
                    al.filterH = 1;
                    al.dilationFilterW = 1;
                    al.dilationFilterH = 1;
                    al.padList[0] = 0;
                    al.padList[1] = 0;
                    al.padList[2] = 0;
                    al.padList[3] = 0;
                    al.enTranspose = false;
                    al.enSmallK = false;
                    al.padValue = 0;
                    LoadData(a2[q*BM*PK],a1,al);
                    for(int c=0;c<cols;c+=BN){
                        int width=cols-c<BN?cols-c:BN,aw=(width+31)/32*32,bs2=c/BN;
                        if(bs2)WaitFlag<HardEvent::M_MTE1>(EVENT_ID1);
                        LoadData2dTransposeParams bl;bl.startIndex=0;bl.repeatTimes=aw/32;bl.srcStride=VK/32;bl.dstGap=1;bl.dstFracGap=0;
                        for(int ki=0;ki<ak;ki+=32)LoadDataWithTranspose(b2[bs2*BN*PK+ki*aw],b1[bs*VK*WN+((k0%VK)+ki)*32+c*VK],bl);
                        SetFlag<HardEvent::MTE1_M>(EVENT_ID0);WaitFlag<HardEvent::MTE1_M>(EVENT_ID0);
                        MmadParams mp;mp.m=BM;mp.n=aw;mp.k=kl;mp.cmatrixInitVal=k0==0;
                        if((BM/16)*(aw/16)<10)PipeBarrier<PIPE_M>();
                        Mmad(cc[bs2*BM*BN],a2[q*BM*PK],b2[bs2*BN*PK],mp);SetFlag<HardEvent::M_MTE1>((TEventID)bs2);
                    }
                    if(((k0+PK)%VK==0 || k0+PK>=K) && (band+2)*VK<K){SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID2);WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID2);LoadPairedBand<VK,WN>(b1,bw,e,K,N,col,cols,an,band+2,phase);}
                    else if(((k0+PK)%VK==0 || k0+PK>=K) && nextStrip>=0){
                        int nb=band+2-bands;
                        SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID2);WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID2);
                        LoadPairedBand<VK,WN>(b1,bw,nextExpert,K,N,nextColumn,nextWidth,(nextWidth+31)/32*32,nb,nextPhase);prefetched=true;
                    }

                }
                SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);
                SetFlag<HardEvent::M_FIX>(EVENT_ID0);WaitFlag<HardEvent::M_FIX>(EVENT_ID0);
                for(int c=0;c<cols;c+=BN){
                    int width=cols-c<BN?cols-c:BN;
                    if(sequence>=4)CrossCoreWaitFlag<2>(9+2*(sequence%4));
                    FixpipeParamsV220 fp;fp.nSize=(width+31)/32*32;fp.mSize=BM;fp.srcStride=BM;fp.dstStride=BN;fp.ndNum=1;fp.srcNdStride=0;fp.dstNdStride=0;
                    Fixpipe(cg[(core*4+sequence%4)*BM*BN],cc[(c/BN)*BM*BN],fp);CrossCoreSetFlag<2,PIPE_FIX>(8+2*(sequence%4));++sequence;
                }
                SetFlag<HardEvent::FIX_M>(EVENT_ID0);phase=nextPhase;
            }
        }
        for(int q=sequence>4?sequence-4:0;q<sequence;++q)CrossCoreWaitFlag<2>(9+2*(q%4));
        for(int i=0;i<L0Slots;++i)WaitFlag<HardEvent::M_MTE1>((TEventID)i);
        WaitFlag<HardEvent::FIX_M>(EVENT_ID0);
    }else{
        for(int strip=begin;strip<limit;++strip){
            int e=strip/nc,col=strip%nc*WN,start=e?(int)ends.GetValue(e-1):0,end=(int)ends.GetValue(e);
            int width=N-col<WN?N-col:WN;
            for(int row=start;row<end;row+=BM){
                int rows=end-row<BM?end-row:BM;
                for(int c=0;c<width;c+=BN){
                    bool hasNext=false;int nextRows=0,nextCols=0;
                    if(c+BN<width){hasNext=true;nextRows=rows;nextCols=width-c-BN<BN?width-c-BN:BN;}
                    else if(row+BM<end){hasNext=true;nextRows=end-row-BM;nextRows=nextRows<BM?nextRows:BM;nextCols=width<BN?width:BN;
                    } else
                        for (int ns = strip + 1; ns < limit; ++ns) {
                            int ne = ns / nc, nb = ne ? (int)ends.GetValue(ne - 1) : 0, nn = (int)ends.GetValue(ne);
                            if (nn > nb) {
                                hasNext = true;
                                nextRows = nn - nb;
                                nextRows = nextRows < BM ? nextRows : BM;
                                int ncol = ns % nc * WN;
                                nextCols = N - ncol < BN ? N - ncol : BN;
                                break;
                            }
                        }
                    FinishQueuedResident<BM,BN>(partial,scale,y,e,row,rows,col+c,N,core*4+sequence%4,sequence,initialized,scaleExpert,hasNext,nextRows,nextCols);++sequence;
                }
            }
        }
        if(initialized)WaitFlag<HardEvent::MTE3_V>(EVENT_ID3);
    }
    PipeBarrier<PIPE_ALL>();
}
static void LaunchPairedColumns(GM_ADDR x,const TensorGroupInfo& info_x,
    GM_ADDR weight,const TensorGroupInfo& info_weight,GM_ADDR scale,const TensorGroupInfo& info_scale,
    GM_ADDR group_list,const TensorGroupInfo& info_group_list,GM_ADDR y,const TensorGroupInfo& info_y,
    int64_t availableCoreNum,aclrtStream stream){
    int E=info_weight.tensors[0].shape[0],M=info_x.tensors[0].shape[0],K=info_x.tensors[0].shape[1],N=info_weight.tensors[0].shape[2];
    auto platform=platform_ascendc::PlatformAscendCManager::GetInstance();
    int cores=std::min<int64_t>(16,std::min<int64_t>(availableCoreNum,platform->GetCoreNumAic()));
    constexpr int BM=64,BN=256,PK=128,VK=256;
    void* memory=nullptr;
    if(aclrtMalloc(&memory,(size_t)cores*4*BM*BN*4,ACL_MEM_MALLOC_HUGE_FIRST)!=0)throw std::runtime_error("allocation failed");
    grouped_gelu_paired_columns<BM,BN,PK,VK><<<cores,nullptr,stream>>>(x,weight,scale,group_list,y,(GM_ADDR)memory,E,M,K,N,cores);
    auto status=aclrtSynchronizeStream(stream);aclrtFree(memory);
    if(status!=0)throw std::runtime_error("kernel failed");
}

template<int BN,int VK> __aicore__ inline void LoadStationaryBand(LocalTensor<int8_t> dst,GlobalTensor<int8_t> src,int e,int K,int N,int col,int cols,int band,int phase){
    int off=band*VK,depth=K-off<VK?K-off:VK,an=(cols+31)/32*32;
    Nd2NzParams p;p.ndNum=depth/32;p.nValue=32;p.dValue=cols;p.srcNdMatrixStride=32*N;p.srcDValue=N;p.dstNzC0Stride=32;p.dstNzNStride=1;p.dstNzMatrixStride=32*an;
    if(depth/32)DataCopy(dst[((band+phase)%4)*VK*BN],src[((int64_t)e*K+off)*N+col],p);
    if(depth%32){p.ndNum=1;p.nValue=depth%32;DataCopy(dst[((band+phase)%4)*VK*BN+(depth/32)*32*an],src[((int64_t)e*K+off+depth/32*32)*N+col],p);}
    SetFlag<HardEvent::MTE2_MTE1>((TEventID)(2+(band+phase)%4));
}
template<int BM,int BN,int PK,int VK>
__global__ __aicore__ void grouped_gelu_row_resident(GM_ADDR x,GM_ADDR w,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,GM_ADDR partial,int E,int M,int K,int N,int cores){
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
    constexpr int RM=64,LS=(2*BM*PK<=65536 && 2*BN*PK<=65536)?2:1;
    int nc=(N+BN-1)/BN,pk=(K+31)/32*32,core=GetBlockIdx();if ASCEND_IS_AIV {core/=2;}
    GlobalTensor<int64_t> ends;ends.SetGlobalBuffer((__gm__ int64_t*)groups);
    int sequence=0,scaleExpert=-1;bool initialized=false;
    if ASCEND_IS_AIC {
        GlobalTensor<int8_t> ax,bw;GlobalTensor<int32_t> cg;
        ax.SetGlobalBuffer((__gm__ int8_t*)x);bw.SetGlobalBuffer((__gm__ int8_t*)w);cg.SetGlobalBuffer((__gm__ int32_t*)partial);
        LocalTensor<int8_t> a1(TPosition::A1,0,262144),b1(TPosition::B1,262144,262144);
        LocalTensor<int8_t> a2(TPosition::A2,0,LS*BM*PK),b2(TPosition::B2,0,LS*BN*PK);
        LocalTensor<int32_t> cc(TPosition::CO1,0,BM*BN);
        for(int i=0;i<LS;++i)SetFlag<HardEvent::M_MTE1>((TEventID)i);
        SetFlag<HardEvent::FIX_M>(EVENT_ID0);int cachedRow=-1,phase=0;bool prefetched=false;
        for(int strip=core;strip<E*nc;strip+=cores){
            int e=strip%E,col=strip/E*BN,start=e?(int)ends.GetValue(e-1):0,end=(int)ends.GetValue(e);
            if(start==end)continue;
            int cols=N-col<BN?N-col:BN,an=(cols+31)/32*32;
            constexpr int aRows=BM;
            SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);
            for(int row=start;row<end;row+=BM){
                int rows=end-row<BM?end-row:BM;
                WaitFlag<HardEvent::FIX_M>(EVENT_ID0);
                if(cachedRow!=row){
                    SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);
                    Nd2NzParams p;p.ndNum=1;p.nValue=rows;p.dValue=K;p.srcDValue=K;p.dstNzC0Stride=aRows;p.dstNzNStride=1;
                    DataCopy(a1,ax[(int64_t)row*K],p);
                    SetFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);WaitFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);cachedRow=row;
                }
                {if(!prefetched){LoadStationaryBand<BN,VK>(b1,bw,e,K,N,col,cols,0,phase);for(int b=1;b<4 && b*VK<K;++b)LoadStationaryBand<BN,VK>(b1,bw,e,K,N,col,cols,b,phase);}prefetched=false;}
                int nextStrip=-1;if(row+BM<end)nextStrip=strip;else for(int ns=strip+cores;ns<E*nc;ns+=cores){int ne=ns%E,nb=ne?(int)ends.GetValue(ne-1):0;if((int)ends.GetValue(ne)>nb){nextStrip=ns;break;}}
                int bands=(K+VK-1)/VK,nextPhase=(phase+bands)%4;
                for(int k0=0,j=0;k0<K;k0+=PK,++j){
                    int q=j%LS,kl=K-k0<PK?K-k0:PK,ak=(kl+31)/32*32,band=k0/VK;
                    {if(k0%VK==0)WaitFlag<HardEvent::MTE2_MTE1>((TEventID)(2+(band+phase)%4));}
                    WaitFlag<HardEvent::M_MTE1>((TEventID)q);
                    LoadData3DParamsV2<int8_t> al;
                    al.l1H = 1;
                    al.l1W = aRows;
                    al.channelSize = pk;
                    al.kExtension = ak;
                    al.mExtension = BM;
                    al.kStartPt = k0;
                    al.mStartPt = 0;
                    al.strideW = 1;
                    al.strideH = 1;
                    al.filterW = 1;
                    al.filterH = 1;
                    al.dilationFilterW = 1;
                    al.dilationFilterH = 1;
                    al.padList[0] = 0;
                    al.padList[1] = 0;
                    al.padList[2] = 0;
                    al.padList[3] = 0;
                    al.enTranspose = false;
                    al.enSmallK = false;
                    al.padValue = 0;
                    LoadData(a2[q*BM*PK],a1,al);
                    LoadData2dTransposeParams bl;bl.startIndex=0;bl.repeatTimes=ak*an/1024;bl.srcStride=1;bl.dstGap=1;bl.dstFracGap=0;
                    int bo=((band+phase)%4)*VK*BN+(k0%VK)*an;
                    LoadDataWithTranspose(b2[q*BN*PK],b1[bo],bl);
                    SetFlag<HardEvent::MTE1_M>(EVENT_ID0);WaitFlag<HardEvent::MTE1_M>(EVENT_ID0);
                    MmadParams mp;mp.m=BM;mp.n=an;mp.k=kl;mp.cmatrixInitVal=k0==0;
                    Mmad(cc,a2[q*BM*PK],b2[q*BN*PK],mp);SetFlag<HardEvent::M_MTE1>((TEventID)q);
                    {if(((k0+PK)%VK==0 || k0+PK>=K) && (band+4)*VK<K){SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID2);WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID2);LoadStationaryBand<BN,VK>(b1,bw,e,K,N,col,cols,band+4,phase);
                        } else if (((k0 + PK) % VK == 0 || k0 + PK >= K) && nextStrip >= 0) {
                            int ne = nextStrip % E, ncol = nextStrip / E * BN, nwidth = N - ncol < BN ? N - ncol : BN,
                                nb = band + 4 - (K + VK - 1) / VK;
                            SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID2);
                            WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID2);
                            LoadStationaryBand<BN, VK>(b1, bw, ne, K, N, ncol, nwidth, nb, nextPhase);
                            prefetched = true;
                        }
                    }
                }
                SetFlag<HardEvent::M_FIX>(EVENT_ID0);WaitFlag<HardEvent::M_FIX>(EVENT_ID0);
                for(int off=0;off<rows;off+=RM){
                    if(sequence>=4)CrossCoreWaitFlag<2>(9+2*(sequence%4));
                    FixpipeParamsV220 fp;fp.nSize=an;fp.mSize=RM;fp.srcStride=BM;fp.dstStride=BN;fp.ndNum=1;
                    Fixpipe(cg[(core*4+sequence%4)*RM*BN],cc[off*16],fp);CrossCoreSetFlag<2,PIPE_FIX>(8+2*(sequence%4));++sequence;
                }
                SetFlag<HardEvent::FIX_M>(EVENT_ID0);phase=nextPhase;
            }
        }
        for(int q=sequence>4?sequence-4:0;q<sequence;++q)CrossCoreWaitFlag<2>(9+2*(q%4));
        for(int i=0;i<LS;++i)WaitFlag<HardEvent::M_MTE1>((TEventID)i);WaitFlag<HardEvent::FIX_M>(EVENT_ID0);
    }else{
        for(int strip=core;strip<E*nc;strip+=cores){
            int e=strip%E,col=strip/E*BN,start=e?(int)ends.GetValue(e-1):0,end=(int)ends.GetValue(e);
            for(int row=start;row<end;row+=RM){
                int rows=end-row<RM?end-row:RM;bool hasNext=false;int nextRows=0,nextCols=0;
                if(row+RM<end){hasNext=true;nextRows=end-row-RM<RM?end-row-RM:RM;nextCols=N-col<BN?N-col:BN;}
                else for(int ns=strip+cores;ns<E*nc;ns+=cores){int ne=ns%E,nb=ne?(int)ends.GetValue(ne-1):0,nn=(int)ends.GetValue(ne);if(nn>nb){hasNext=true;nextRows=nn-nb<RM?nn-nb:RM;int ncol=ns/E*BN;nextCols=N-ncol<BN?N-ncol:BN;break;}}
                FinishQueuedResident<RM,BN>(partial,scale,y,e,row,rows,col,N,core*4+sequence%4,sequence,initialized,scaleExpert,hasNext,nextRows,nextCols);++sequence;
            }
        }
        if(initialized)WaitFlag<HardEvent::MTE3_V>(EVENT_ID3);
    }
    PipeBarrier<PIPE_ALL>();
}

static void LaunchRowResident(GM_ADDR x, const TensorGroupInfo &info_x, GM_ADDR weight,
                              const TensorGroupInfo &info_weight, GM_ADDR scale, const TensorGroupInfo &info_scale,
                              GM_ADDR group_list, const TensorGroupInfo &info_group_list, GM_ADDR y,
                              const TensorGroupInfo &info_y, int64_t availableCoreNum, aclrtStream stream) {
    int E=info_weight.tensors[0].shape[0],M=info_x.tensors[0].shape[0],K=info_x.tensors[0].shape[1],N=info_weight.tensors[0].shape[2];
    auto platform=platform_ascendc::PlatformAscendCManager::GetInstance();
    int cores=std::min<int64_t>(16,std::min<int64_t>(availableCoreNum,platform->GetCoreNumAic()));
    constexpr int BM=128,BN=256,PK=128,VK=256;
    void* memory=nullptr;if(aclrtMalloc(&memory,(size_t)cores*4*64*BN*4,ACL_MEM_MALLOC_HUGE_FIRST)!=0)throw std::runtime_error("allocation failed");
    grouped_gelu_row_resident<BM,BN,PK,VK><<<cores,nullptr,stream>>>(x,weight,scale,group_list,y,(GM_ADDR)memory,E,M,K,N,cores);
    auto status=aclrtSynchronizeStream(stream);aclrtFree(memory);if(status!=0)throw std::runtime_error("kernel failed");
}

__aicore__ static __attribute__((noinline)) float CompactRounded(float z){return DenseMath::MidpointGeluRounded(z);}
template<int BM,int BN> __global__ __aicore__ void grouped_gelu_compact_resident(GM_ADDR x,GM_ADDR w,GM_ADDR s,GM_ADDR y,GM_ADDR partial,int M,int K,int N){
 KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
 constexpr int PK=512,Q=BM*BN/2;
 int nc=(N+BN-1)/BN,pk=(K+31)/32*32;
 int core=GetBlockIdx();if ASCEND_IS_AIV {core/=2;}
 if(core>=((M+BM-1)/BM)*nc)return;
 int row=core/nc*BM,col=core%nc*BN;
 int rows=M-row<BM?M-row:BM,cols=N-col<BN?N-col:BN,an=(cols+31)/32*32;
 if ASCEND_IS_AIC {
  LocalTensor<int8_t> a1(TPosition::A1,0,BM*PK),b1(TPosition::B1,BM*PK,BN*PK),a2(TPosition::A2,0,BM*PK),b2(TPosition::B2,0,BN*PK);
  LocalTensor<int32_t> cc(TPosition::CO1,0,BM*BN);
  GlobalTensor<int8_t> ax,bw;GlobalTensor<int32_t> cg;ax.SetGlobalBuffer((__gm__ int8_t*)x);bw.SetGlobalBuffer((__gm__ int8_t*)w);cg.SetGlobalBuffer((__gm__ int32_t*)partial+core*BM*BN);
  Nd2NzParams ap;ap.ndNum=1;ap.nValue=rows;ap.dValue=K;ap.srcNdMatrixStride=0;ap.srcDValue=K;ap.dstNzC0Stride=BM;ap.dstNzNStride=1;ap.dstNzMatrixStride=0;
  DataCopy(a1,ax[row*K],ap);
  Nd2NzParams bp;bp.ndNum=K/32;bp.nValue=32;bp.dValue=cols;bp.srcNdMatrixStride=32*N;bp.srcDValue=N;bp.dstNzC0Stride=32;bp.dstNzNStride=1;bp.dstNzMatrixStride=32*an;
  if(K/32)DataCopy(b1,bw[col],bp);
  if(K%32){bp.ndNum=1;bp.nValue=K%32;DataCopy(b1[(K/32)*32*an],bw[col+(K/32)*32*N],bp);}
  SetFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);WaitFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);
  if constexpr(BM==16){LoadData2DParams al;al.startIndex=0;al.repeatTimes=K/32;al.srcStride=1;al.dstGap=0;al.ifTranspose=false;LoadData(a2,a1,al);
  } else {
      LoadData3DParamsV2<int8_t> al;
      al.l1H = 1;
      al.l1W = BM;
      al.channelSize = pk;
      al.kExtension = pk;
      al.mExtension = BM;
      al.kStartPt = 0;
      al.mStartPt = 0;
      al.strideW = 1;
      al.strideH = 1;
      al.filterW = 1;
      al.filterH = 1;
      al.dilationFilterW = 1;
      al.dilationFilterH = 1;
      al.padList[0] = 0;
      al.padList[1] = 0;
      al.padList[2] = 0;
      al.padList[3] = 0;
      al.enTranspose = false;
      al.enSmallK = false;
      al.padValue = 0;
      LoadData(a2, a1, al);
  }
  LoadData2dTransposeParams bl;bl.startIndex=0;bl.repeatTimes=pk*an/1024;bl.srcStride=1;bl.dstGap=1;bl.dstFracGap=0;LoadDataWithTranspose(b2,b1,bl);
  SetFlag<HardEvent::MTE1_M>(EVENT_ID0);WaitFlag<HardEvent::MTE1_M>(EVENT_ID0);
  MmadParams mp;mp.m=BM;mp.n=an;mp.k=K;mp.cmatrixInitVal=true;Mmad(cc,a2,b2,mp);
  SetFlag<HardEvent::M_FIX>(EVENT_ID0);WaitFlag<HardEvent::M_FIX>(EVENT_ID0);
  FixpipeParamsV220 fp;fp.nSize=an;fp.mSize=BM;fp.srcStride=BM;fp.dstStride=BN;fp.ndNum=1;fp.srcNdStride=0;fp.dstNdStride=0;Fixpipe(cg,cc,fp);
  CrossCoreSetFlag<2,PIPE_FIX>(8);
 }else{
  int sub=GetBlockIdx()%2;
  LocalTensor<float> z(TPosition::VECCALC,0,Q),a(TPosition::VECCALC,Q*4,Q),b(TPosition::VECCALC,Q*8,Q);
  LocalTensor<half> out(TPosition::VECCALC,Q*12,Q);
  LocalTensor<uint8_t> m1(TPosition::VECCALC,Q*14,Q/8),m2(TPosition::VECCALC,Q*14+Q/8,Q/8);
  constexpr int SC=(Q*14+Q/4+31)/32*32;
  LocalTensor<float> scales(TPosition::VECCALC,SC,BN),bits(TPosition::VECCALC,SC+BN*4,16);
  LocalTensor<int16_t> ramp(TPosition::VECCALC,SC+BN*4+64,Q);
  LocalTensor<float> coeff(TPosition::VECCALC,65536,16);
  auto tie=bits.ReinterpretCast<uint16_t>(),near=bits[8].ReinterpretCast<uint16_t>();
  GlobalTensor<int32_t> cg;GlobalTensor<float> sg;GlobalTensor<half> yg;cg.SetGlobalBuffer((__gm__ int32_t*)partial+core*BM*BN+sub*Q);sg.SetGlobalBuffer((__gm__ float*)s);yg.SetGlobalBuffer((__gm__ half*)y);
  Duplicate(scales,0.0f,BN);SetFlag<HardEvent::V_MTE2>(EVENT_ID3);WaitFlag<HardEvent::V_MTE2>(EVENT_ID3);
  DataCopyPad(scales,sg[col],DataCopyExtParams{1,(uint32_t)(cols*4),0,0,0},DataCopyPadExtParams<float>{true,0,(uint8_t)((8-cols%8)%8),0});
  Duplicate(tie.ReinterpretCast<uint32_t>(),(uint32_t)0xff001ff8,8);Duplicate(near.ReinterpretCast<uint32_t>(),(uint32_t)0xff8000ff,8);
  for(int i=0;i<16;++i)ramp.SetValue(i,i);SetFlag<HardEvent::S_V>(EVENT_ID2);WaitFlag<HardEvent::S_V>(EVENT_ID2);
  for(int span=16;span<Q/32;span*=2){Adds(ramp[span],ramp,(int16_t)span,span);PipeBarrier<PIPE_V>();}
  Duplicate(coeff,-0.07135481627260025f,8);Duplicate(coeff[8],-1.5957691216057308f,8);PipeBarrier<PIPE_V>();
  CrossCoreWaitFlag<2>(8);
  int vr=rows-sub*(BM/2);if(vr<=0)return;if(vr>BM/2)vr=BM/2;
  DataCopy(z.ReinterpretCast<int32_t>(),cg,Q);
  SetFlag<HardEvent::MTE2_V>(EVENT_ID0);WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
  Cast(z,z.ReinterpretCast<int32_t>(),RoundMode::CAST_RINT,Q);PipeBarrier<PIPE_V>();
  for(int c=0;c<BN;c+=64)Mul(z[c],z[c],scales[c],(uint64_t)64,(uint8_t)(BM/2),BinaryRepeatParams{1,1,1,BN/8,BN/8,0});PipeBarrier<PIPE_V>();
  Mul(a,z,z,Q);PipeBarrier<PIPE_V>();FusedMulAdd(a,coeff,coeff[8],(uint64_t)64,(uint8_t)(Q/64),BinaryRepeatParams{1,0,0,8,0,0});PipeBarrier<PIPE_V>();Mul(a,a,z,Q);PipeBarrier<PIPE_V>();
  Exp(b,a,Q);PipeBarrier<PIPE_V>();Adds(a,b,1.0f,Q);PipeBarrier<PIPE_V>();Div(b,z,a,Q);PipeBarrier<PIPE_V>();
  Adds(a.ReinterpretCast<int32_t>(), b.ReinterpretCast<int32_t>(), (int32_t)4, Q);
  PipeBarrier<PIPE_V>();
  And(a.ReinterpretCast<uint16_t>(), a.ReinterpretCast<uint16_t>(), tie, (uint64_t)128, (uint8_t)(Q / 64),
      BinaryRepeatParams{1, 1, 0, 8, 8, 0});
  PipeBarrier<PIPE_V>();
  CompareScalar(m1, a.ReinterpretCast<int32_t>(), (int32_t)0x40001000, CMPMODE::EQ, Q);
  PipeBarrier<PIPE_V>();
  Adds(a, b, -0.001953125f, Q);
  PipeBarrier<PIPE_V>();
  And(a.ReinterpretCast<uint16_t>(), a.ReinterpretCast<uint16_t>(), near, (uint64_t)128, (uint8_t)(Q / 64),
      BinaryRepeatParams{1, 1, 0, 8, 8, 0});
  PipeBarrier<PIPE_V>();
  CompareScalar(m2, a.ReinterpretCast<int32_t>(), (int32_t)0xbb000080, CMPMODE::EQ, Q);
  PipeBarrier<PIPE_V>();
  Or(m1.ReinterpretCast<uint16_t>(), m1.ReinterpretCast<uint16_t>(), m2.ReinterpretCast<uint16_t>(), Q / 16);
  PipeBarrier<PIPE_V>();
  CompareScalar(m2,m1.ReinterpretCast<int32_t>(),(int32_t)0,CMPMODE::EQ,Q/32);PipeBarrier<PIPE_V>();Not(m2.ReinterpretCast<uint16_t>(),m2.ReinterpretCast<uint16_t>(),Q/512);PipeBarrier<PIPE_V>();
  SetMaskCount();SetVectorMask<int16_t,MaskMode::COUNTER>(0,Q/32);
  GatherMask(a.ReinterpretCast<int16_t>(),ramp,m2.ReinterpretCast<int16_t>(),(uint8_t)0,GatherMaskParams{1,1,8,0});SetMaskNorm();ResetMask();
  Cast(out,b,RoundMode::CAST_RINT,Q);
  SetFlag<HardEvent::V_S>(EVENT_ID0);WaitFlag<HardEvent::V_S>(EVENT_ID0);
  uint64_t count = GetGatherMaskRemainCount();
  for (uint64_t q = 0; q < count; ++q) {
      int j = a.ReinterpretCast<int16_t>().GetValue(q);
      uint32_t word = m1.ReinterpretCast<uint32_t>().GetValue(j);
      while (word) {
          int i = j * 32 + __builtin_ctz(word);
          word &= word - 1;
          float v = z.GetValue(i);
          if (v >= 0.0f || (v < 0.0f && b.GetValue(i) > -0.00006103515625f))
              out.SetValue(i, (half)CompactRounded(v));
      }
  }
  SetFlag<HardEvent::S_MTE3>(EVENT_ID0);WaitFlag<HardEvent::S_MTE3>(EVENT_ID0);
  DataCopyPad(yg[(row+sub*(BM/2))*N+col],out,DataCopyExtParams{(uint16_t)vr,(uint32_t)(cols*2),(uint32_t)((BN-(cols+15)/16*16)/16),(uint32_t)((N-cols)*2),0});
 }
 PipeBarrier<PIPE_ALL>();
}

static void LaunchCompactResident(GM_ADDR x, const TensorGroupInfo &ix, GM_ADDR w, const TensorGroupInfo &iw, GM_ADDR s,
                                  const TensorGroupInfo &is, GM_ADDR g, const TensorGroupInfo &ig, GM_ADDR y,
                                  const TensorGroupInfo &iy, int64_t availableCoreNum, aclrtStream stream) {
    int M = ix.tensors[0].shape[0], K = ix.tensors[0].shape[1], N = iw.tensors[0].shape[2];
    int tasks = ((M + 31) / 32) * ((N + 127) / 128),
        cores = std::min<int64_t>(availableCoreNum,
                                  platform_ascendc::PlatformAscendCManager::GetInstance()->GetCoreNumAic());
    int slots = std::max(std::min(5, cores), tasks);
    void *work = nullptr;
    if (aclrtMalloc(&work, (size_t)tasks * 32 * 128 * 4, ACL_MEM_MALLOC_HUGE_FIRST) != 0)
        throw std::runtime_error("allocation failed");
    grouped_gelu_compact_resident<32, 128><<<slots, nullptr, stream>>>(x, w, s, y, (GM_ADDR)work, M, K, N);
    auto status = aclrtSynchronizeStream(stream);
    aclrtFree(work);
    if (status != 0)
        throw std::runtime_error("kernel failed");
}

