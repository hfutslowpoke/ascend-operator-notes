template <bool COMPACT = false, bool CACHED = false, bool LOGISTIC = false, bool ZERO_ACTIVE = false,
          bool INTERVAL_MASK = false, bool HALF_SCRATCH = false, int INDEX_CHUNK = 0, int FIXED_COUNT = 0,
