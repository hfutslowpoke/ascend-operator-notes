    Duplicate(b.ReinterpretCast<int32_t>(),(int32_t)8191,count);PipeBarrier<PIPE_V>();
    And(b.ReinterpretCast<uint16_t>(),out.ReinterpretCast<uint16_t>(),b.ReinterpretCast<uint16_t>(),count*2);PipeBarrier<PIPE_V>();
