    float d=(az*t)/(1.0f+t),low=0.0f;
    if(z>=0.0f){bits.f=z-d;low=(z-bits.f)-d;}else bits.f=-d;
    int e=(bits.u>>23)&255,shift=e>=113?13:126-e;
    if(shift<=0 || shift>=25)return bits.f;
    uint32_t mant=(bits.u&0x7fffffu)|0x800000u;
    int32_t rem=(int32_t)(mant&((1u<<shift)-1u)),mid=(int32_t)(1u<<(shift-1));
