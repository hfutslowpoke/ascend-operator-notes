    if(absolute<=2.0e-7f*d)return AccurateGeluRounded(z);
    if(rem==mid && low!=0.0f)result.u=((low>0.0f)==(result.f>0.0f))?result.u+1:result.u-1;
    return result.f;
}
__aicore__ static __attribute__((noinline)) float RoundedPositive(float z){return MidpointGeluRounded(z);}
