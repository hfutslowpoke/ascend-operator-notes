__aicore__ inline float ComplementGeluRounded(float z) {
#pragma clang fp reassociate(off) contract(off)
    if(z==0.0f || z>=8.0f)return z;
    if(z<=-8.0f)return 0.0f;
    float az=z>=0.0f?z:-z;
    float u=0.7978845608028654f*(az+0.044715f*((az*az)*az));
    float exponent=-2.0f*u;
