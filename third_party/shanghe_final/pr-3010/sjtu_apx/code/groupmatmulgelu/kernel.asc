    WideFloat exponentValue=WideMul(u,{-2.0f,0.0f});
    int exponentShift=(int)(exponentValue.hi*1.4426950408889634f-0.5f);
    WideFloat r=WideAdd(exponentValue,WideMul({(float)exponentShift,0.0f},{-0.69314718246459961f,1.904654323148236e-09f}));
    WideFloat t={2.755731998149713e-07f,-7.575112209051195e-15f};
    t=WideAdd(WideMul(t,r),{2.7557318844628753e-06f,3.793571224297229e-14f});
    t=WideAdd(WideMul(t,r),{2.4801587642286904e-05f,-3.40699609366682e-13f});
    t=WideAdd(WideMul(t,r),{0.00019841270113829523f,-2.725596874933456e-12f});
    t=WideAdd(WideMul(t,r),{0.0013888889225199819f,-3.3631094437103215e-11f});
    t=WideAdd(WideMul(t,r),{0.008333333767950535f,-4.34617203337595e-10f});
    t=WideAdd(WideMul(t,r),{0.0416666679084301f,-1.2417634698280722e-09f});
    t=WideAdd(WideMul(t,r),{0.1666666716337204f,-4.967053879312289e-09f});
    t=WideAdd(WideMul(t,r),{0.5f,0.0f});
    t=WideAdd(WideMul(t,r),{1.0f,0.0f});
    t=WideAdd(WideMul(t,r),{1.0f,0.0f});
    union ScaleBits { float f; uint32_t u; } power;
    power.u=(uint32_t)(exponentShift+127)<<23;
    t={t.hi*power.f,t.lo*power.f};
    if(z>=0.0f && t.hi<=1.1102230246251565e-16f) return z;
    WideFloat numerator=z>=0.0f?WideFloat{z,0.0f}:WideMul({z,0.0f},t);
