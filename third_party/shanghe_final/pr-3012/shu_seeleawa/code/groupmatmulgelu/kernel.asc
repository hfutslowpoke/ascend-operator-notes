}

template <bool Major>
__aicore__ inline void DotFull(__cbuf__ int8_t *a1,__cbuf__ int8_t *b1,__ca__ int8_t *a,__cb__ int8_t *b,
__cc__ int32_t *c,uint32_t tm,uint32_t mp,uint32_t np,uint32_t K){
