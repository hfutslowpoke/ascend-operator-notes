asc_duplicate((__ubuf__ int32_t *)z,int32_t(0),rows * BN);
asc_sync_pipe(PIPE_V);
asc_sync_notify(PIPE_V,PIPE_MTE2,EVENT_ID5);
asc_sync_wait(PIPE_V,PIPE_MTE2,EVENT_ID5);
}
if(nr == BN)
asc_copy_gm2ub_align((__ubuf__ int32_t *)z,slot + local * BN,1,rows * BN * 4,0,0,0,0);
else
for(uint32_t r = 0;r < rows;++r)
asc_copy_gm2ub_align(
(__ubuf__ int32_t *)z + r * BN,slot +(local + r)* BN,1,nr * 4,0,0,0,0);
}
asc_sync_notify(PIPE_MTE2,PIPE_V,EVENT_ID7);
ffts_cross_core_sync(PIPE_MTE2,0x21ULL |(uint64_t(9 + 2 * si)<< 8));
asc_sync_wait(PIPE_MTE2,PIPE_V,EVENT_ID7);
if(rows){
const uint32_t count = rows * BN;
asc_int322float_rn(z,(__ubuf__ int32_t *)z,count);
asc_sync_pipe(PIPE_V);
asc_set_mask_norm();
asc_set_vector_mask(uint64_t(0),~uint64_t(0));
for(uint32_t n = 0;n < BN;n += 64)
asc_mul(z + n,z + n,sc + n,uint8_t(rows),1,1,1,BN / 8,BN / 8,0);
asc_sync_pipe(PIPE_V);
asc_set_vector_mask(~uint64_t(0),~uint64_t(0));
Frame f ={};
f.dst = y + uint64_t(row + micro + local)* N + col;
f.rows = rows;
f.N = N;
f.nr = nr;
f.bn = BN;
if(Direct){
if(nr == BN && count % 2048 == 0){
if(Defer)
QueueCompact<Resident>(s,z,f,count);
else{
Finish(s);
f.bank = s.next;
s.next ^= 1;
Wait(s,f.bank);
auto p =(__ubuf__ float *)98304;
cp6_c38::CompactMidpoint<false,false,true>(z,(__ubuf__ float *)32768,
(__ubuf__ float *)65536,p,Out(f.bank),(__ubuf__ uint8_t *)172032,count);
Emit(s,f);
}
}else{
Prepare<true>(s,z,f);
if(Defer)
s.short_curve = false;
}
++ordinal;
continue;
}
const uint32_t sample = Min(count,128U),
nonsat = cp6_gmg_opt::PackNonSaturated33(z,(__ubuf__ float *)32768,(__ubuf__ float *)65536,
(__ubuf__ uint8_t *)169984,(__ubuf__ float *)98304,sample);
if(nonsat <= sample / 4)
Legacy(s,z,f,true);
else{
asc_abs((__ubuf__ float *)32768,z,sample);
asc_sync_pipe(PIPE_V);
asc_shiftright((__ubuf__ uint32_t *)65536,(__ubuf__ uint32_t *)32768,24,sample);
asc_sync_pipe(PIPE_V);
asc_eq_scalar((__ubuf__ uint8_t *)169984,(__ubuf__ int32_t *)65536,64,sample / 64,1,1,8,8);
asc_sync_pipe(PIPE_V);
asc_reduce((__ubuf__ uint32_t *)32768,(__ubuf__ uint32_t *)z,(__ubuf__ uint32_t *)169984,sample);
asc_sync_notify(PIPE_V,PIPE_S,EVENT_ID5);
asc_sync_wait(PIPE_V,PIPE_S,EVENT_ID5);
if(uint32_t(asc_get_rsvd_count())> sample / 4)
Legacy(s,z,f,false);
else
Prepare(s,z,f);
}
}
++ordinal;
}
}

__aicore__ inline void End(State &s){
Finish(s);
Wait(s,0);
Wait(s,1);
asc_sync();
ffts_cross_core_sync(PIPE_MTE3,0x21ULL |(uint64_t(12)<< 8));
}
}// namespace cp6_sv59

namespace cp6_sv59{
template <bool Curve = false>
__aicore__ inline void LargeTile(State &s,__gm__ float *scale,__gm__ half *y,__gm__ int32_t *scratch,
uint32_t worker,uint32_t sub,uint32_t e,uint32_t row,uint32_t col,uint32_t mr,uint32_t nr,uint32_t N,
uint32_t &ordinal);
}// namespace cp6_sv59

namespace cp6_large39{
__aicore__ inline void CLease(uint32_t slot,bool wait){
if(!slot){
if(wait)
asc_sync_wait(PIPE_FIX,PIPE_M,EVENT_ID6);
else
asc_sync_notify(PIPE_FIX,PIPE_M,EVENT_ID6);
}else{
if(wait)
asc_sync_wait(PIPE_FIX,PIPE_M,EVENT_ID7);
else
asc_sync_notify(PIPE_FIX,PIPE_M,EVENT_ID7);
}
}
}// namespace cp6_large39

namespace cp6_goal{
struct ShortFrame{
uint32_t e,row,m;
};

template <class G> __aicore__ inline uint32_t FindExpert(G groups,uint32_t row,uint32_t E){
uint32_t guess = cp6_c38::Min(row / 64,E - 1),lo = 0,hi = E;
uint32_t end = uint32_t(groups[guess]),before = guess ? uint32_t(groups[guess - 1]): 0;
if(before <= row && row < end)
return guess;
if(uint32_t(groups[0])> row)
return 0;
if(E > 1 && uint32_t(groups[E - 2])<= row)
return E - 1;
if(row < before){
for(uint32_t j = 0;j < 4 && guess;++j){
--guess;
before = guess ? uint32_t(groups[guess - 1]): 0;
if(row >= before)
return guess;
}
hi = guess;
}else{
lo = guess + 1;
for(uint32_t j = 0;j < 4 && lo < E;++j){
if(row < uint32_t(groups[lo]))
return lo;
++lo;
}
}
while(lo < hi){
const uint32_t mid =(lo + hi)/ 2;
if(uint32_t(groups[mid])<= row)
lo = mid + 1;
else
hi = mid;
}
return lo;
}

struct OwnedCursor{
uint32_t expert,row,end,stop;
};

template <class G> __aicore__ inline uint32_t OwnedCut(G groups,uint32_t index,uint32_t E,uint32_t W){
const uint32_t guess = index * E / W,row = guess * 64;
if(guess == 0 || guess == E)
return row;
const uint32_t boundary = uint32_t(groups[guess - 1]);
const int32_t delta = int32_t(boundary)- int32_t(row);
return delta >= -32 && delta <= 32 ? boundary : row;
}

template <class G> __aicore__ inline OwnedCursor StartOwned(G groups,uint32_t worker,uint32_t E,uint32_t W){
const uint32_t guess = worker * E / W;
uint32_t start = guess * 64;
bool atBoundary = guess == 0;
if(guess){
const uint32_t boundary = uint32_t(groups[guess - 1]);
const int32_t delta = int32_t(boundary)- int32_t(start);
atBoundary = delta >= -32 && delta <= 32;
if(atBoundary)
start = boundary;
}
const uint32_t stop = worker + 1 == W ? uint32_t(groups[E - 1]): OwnedCut(groups,worker + 1,E,W);
if(start == stop)
return OwnedCursor{0,start,stop,stop};
// A cut snapped to an expert boundary already identifies the next expert.
// NextOwned skips any empty experts at that same boundary.
const uint32_t expert = atBoundary ? guess : FindExpert(groups,start,E);
return OwnedCursor{expert,start,uint32_t(groups[expert]),stop};
}

template <class G> __aicore__ inline ShortFrame NextOwned(OwnedCursor &it,G groups){
if(it.row >= it.stop)
return ShortFrame{};
while(it.row >= it.end)
it.end = uint32_t(groups[++it.expert]);
const uint32_t remaining = cp6_c38::Min(it.end,it.stop)- it.row;
const uint32_t m = remaining <= 80 ? remaining : 64;
const ShortFrame frame{it.expert,it.row,m};
it.row += m;
return frame;
}

__aicore__ inline void PrefetchShort(
__gm__ int8_t *x,__gm__ int8_t *w,ShortFrame f,uint32_t bank,bool weights = true){
__cbuf__ int8_t *l1 =(__cbuf__ int8_t *)static_cast<uint64_t>(bank * 86016);
asc_copy_gm2l1_nd2nz(l1,x + uint64_t(f.row)* 256,1,f.m,256,0,256,80,1,0);
if(weights)
asc_copy_gm2l1_nd2nz(l1 + 20480,w + uint64_t(f.e)* 65536,8,32,256,8192,256,32,1,8192);
cp6_c38_fulla47::BR(bank,false);
}

__aicore__ inline void LoadShort(uint32_t mp,uint32_t bank,bool weights = true){
__cbuf__ int8_t *l1 =(__cbuf__ int8_t *)static_cast<uint64_t>(bank * 86016);
__ca__ int8_t *a =(__ca__ int8_t *)0;
__cb__ int8_t *b =(__cb__ int8_t *)0;
cp6_c38_fulla47::BR(bank,true);
for(uint32_t i = 0;i < 8;++i)
asc_copy_l12l0a(a + i * 512,l1 + i * 2560,0,mp / 16,1,7);
if(weights)
asc_copy_l12l0b_trans(b,l1 + 20480,0,64,1,1,false,uint64_t(0));
cp6_c38::LR(0,false);
}

__aicore__ inline void ShortCube(
__gm__ int8_t *x,__gm__ int8_t *w,__gm__ int64_t *groups,__gm__ int32_t *scratch,uint32_t E,uint32_t W){
const uint32_t worker = asc_get_block_idx();
OwnedCursor it = StartOwned(groups,worker,E,W);
ShortFrame f = NextOwned(it,groups),next = NextOwned(it,groups);
if(f.m){
PrefetchShort(x,w,f,0);
LoadShort(cp6_c38::Up(f.m,16),0);
if(next.m)
PrefetchShort(x,w,next,1,next.e != f.e);
}
bool pending[2] ={false,false};
bool lastWide = false;
__ca__ int8_t *a =(__ca__ int8_t *)0;
__cb__ int8_t *b =(__cb__ int8_t *)0;
__cc__ int32_t *c =(__cc__ int32_t *)0;
for(uint32_t step = 0;f.m;++step){
const uint32_t slot = step % 2,mp = cp6_c38::Up(f.m,16);
const bool wide = mp > 64;
const uint32_t cBank = wide ? 0 : slot;
__cc__ int32_t *cc = c + cBank * 16384;
const ShortFrame future = NextOwned(it,groups);
cp6_c38::LR(0,true);
// A wide result overlaps both 64-row L0C banks.
if(pending[0] &&(!cBank || lastWide)){
cp6_large39::CLease(0,true);
pending[0] = false;
}
if(pending[1] &&(cBank || wide)){
cp6_large39::CLease(1,true);
pending[1] = false;
}
asc_mmad(cc,a,b,mp,256,256,0,false,false,true);
if(next.m)
cp6_c38::LF(0,false);
asc_sync_notify(PIPE_M,PIPE_FIX,EVENT_ID5);
asc_sync_wait(PIPE_M,PIPE_FIX,EVENT_ID5);
if(step >= 2)
asc_sync_block_wait(9 + 2 * slot);
asc_set_l0c_copy_params(1,0,0);
asc_copy_l0c2gm(scratch +(uint64_t(worker)* 2 + slot)* 20480,cc,256,f.m,256,mp,0,0,0,false,true);
ffts_cross_core_sync(PIPE_FIX,0x21ULL |(uint64_t(8 + 2 * slot)<< 8));
cp6_large39::CLease(cBank,false);
pending[cBank] = true;
lastWide = wide;
if(future.m){
cp6_c38_fulla47::BF(slot,false);
cp6_c38_fulla47::BF(slot,true);
PrefetchShort(x,w,future,slot,future.e != next.e);
}
if(next.m){
cp6_c38::LF(0,true);
LoadShort(cp6_c38::Up(next.m,16),1 - slot,next.e != f.e);
}
f = next;
next = future;
}
if(pending[0])
cp6_large39::CLease(0,true);
if(pending[1])
cp6_large39::CLease(1,true);
}

__aicore__ inline void ReadShort(ShortFrame f,__gm__ float *scale,__gm__ int32_t *scratch,__ubuf__ float *z,
uint32_t worker,uint32_t sub,uint32_t slot,bool reuse,bool wait_input = false){
if(wait_input){
if(!slot)
asc_sync_wait(PIPE_V,PIPE_MTE2,EVENT_ID0);
else
asc_sync_wait(PIPE_V,PIPE_MTE2,EVENT_ID1);
}
auto sc =(__ubuf__ float *)static_cast<uint64_t>(181760 + slot * 1024);
const uint32_t split =(f.m + 1)/ 2,local = sub * split,rows = sub ? f.m - split : split;
if(rows)
asc_copy_gm2ub_align(sc,scale + uint64_t(f.e)* 256,1,1024,0,0,0,0);
asc_sync_block_wait(8 + 2 * slot);
if(rows)
asc_copy_gm2ub_align((__ubuf__ int32_t *)z,scratch +(uint64_t(worker)* 2 + slot)* 20480 + local * 256,1,
rows * 1024,0,0,0,0);
asc_sync_notify(PIPE_MTE2,PIPE_V,EVENT_ID7);
if(reuse)
ffts_cross_core_sync(PIPE_MTE2,0x21ULL |(uint64_t(9 + 2 * slot)<< 8));
}

__aicore__ inline __ubuf__ half *P4Out(uint32_t bank){
return(__ubuf__ half *)static_cast<uint64_t>(123648 + bank * 20992);
}

__aicore__ inline void EmitP4(cp6_sv59::State &s,const cp6_sv59::Frame &f){
if(!f.bank){
asc_sync_notify(PIPE_V,PIPE_MTE3,EVENT_ID0);
asc_sync_wait(PIPE_V,PIPE_MTE3,EVENT_ID0);
}else{
asc_sync_notify(PIPE_V,PIPE_MTE3,EVENT_ID1);
asc_sync_wait(PIPE_V,PIPE_MTE3,EVENT_ID1);
}
asc_copy_ub2gm_align(f.dst,P4Out(f.bank),f.rows,f.bn * 2,0,0,0,(f.N - f.bn)* 2);
if(!f.bank)
asc_sync_notify(PIPE_MTE3,PIPE_S,EVENT_ID6);
else
asc_sync_notify(PIPE_MTE3,PIPE_S,EVENT_ID7);
s.lease[f.bank] = true;
}

__aicore__ inline void LaunchP4(
cp6_sv59::State &s,__ubuf__ float *z,cp6_sv59::Frame &f,uint32_t count,__ubuf__ float *t){
f.bank = s.next;
s.next ^= 1;
cp6_sv59::Wait(s,f.bank);
if(!s.short_curve){
asc_duplicate((__ubuf__ float *)171008,-.071354814f,uint32_t(64));
asc_duplicate((__ubuf__ float *)171520,-1.5957692f,uint32_t(64));
s.short_curve = true;
}
auto u =(__ubuf__ float *)41216;
const uint8_t repeats = uint8_t(count / 64);
asc_set_mask_norm();
asc_set_vector_mask(~uint64_t(0),~uint64_t(0));
asc_mul(u,z,z,repeats,1,1,1,8,8,8);
asc_sync_pipe(PIPE_V);
asc_mul_add(u,(__ubuf__ float *)171008,(__ubuf__ float *)171520,repeats,1,1,1,8,0,0);
asc_sync_pipe(PIPE_V);
asc_mul(u,u,z,repeats,1,1,1,8,8,8);
asc_sync_pipe(PIPE_V);
asc_exp(u,u,repeats,1,1,8,8);
asc_sync_pipe(PIPE_V);
asc_add_scalar(u,u,1.0f,repeats,1,1,8,8);
asc_sync_pipe(PIPE_V);
asc_div(u,z,u,repeats,1,1,1,8,8,8);
asc_sync_pipe(PIPE_V);
asc_float2half_rn(P4Out(f.bank),u,repeats,1,1,4,8);
}

template <bool Cube>
__aicore__ inline void Short(__gm__ int8_t *,__gm__ int8_t *,__gm__ float *scale,__gm__ int64_t *groups,
__gm__ half *y,__gm__ int32_t *scratch,uint32_t E,uint32_t W){
const uint32_t worker = asc_get_block_idx(),sub = asc_get_sub_block_id();
auto localGroups =(__ubuf__ int64_t *)184320;
asc_copy_gm2ub_align((__ubuf__ int8_t *)localGroups,(__gm__ int8_t *)groups,1,E * 8,0,0,0,0);
asc_sync_notify(PIPE_MTE2,PIPE_S,EVENT_ID5);
asc_sync_wait(PIPE_MTE2,PIPE_S,EVENT_ID5);
OwnedCursor it = StartOwned(localGroups,worker,E,W);
cp6_sv59::State state ={};
uint32_t ordinal = 0,bank = 0;
bool preloaded = false;
ShortFrame f = NextOwned(it,localGroups),next = NextOwned(it,localGroups),future = NextOwned(it,localGroups);
while(f.m){
const ShortFrame after = NextOwned(it,localGroups);
auto z =(__ubuf__ float *)static_cast<uint64_t>(bank * 82432);
auto temp =(__ubuf__ float *)static_cast<uint64_t>((bank ^ 1)* 82432);
if(!preloaded)
ReadShort(f,scale,scratch,z,worker,sub,ordinal % 2,future.m != 0);
asc_sync_wait(PIPE_MTE2,PIPE_V,EVENT_ID7);
const uint32_t split =(f.m + 1)/ 2,local = sub * split,rows = sub ? f.m - split : split,count = rows * 256;
cp6_sv59::Frame frame ={};
if(rows){
auto sc =(__ubuf__ float *)static_cast<uint64_t>(181760 + bank * 1024);
asc_int322float_rn(z,(__ubuf__ int32_t *)z,count);
asc_sync_pipe(PIPE_V);
asc_set_mask_norm();
asc_set_vector_mask(uint64_t(0),~uint64_t(0));
for(uint32_t n = 0;n < 256;n += 64)
asc_mul(z + n,z + n,sc + n,uint8_t(rows),1,1,1,32,32,0);
asc_sync_pipe(PIPE_V);
asc_set_vector_mask(~uint64_t(0),~uint64_t(0));
frame.dst = y + uint64_t(f.row + local)* 256;
frame.rows = rows;
frame.N = 256;
frame.nr = 256;
frame.bn = 256;
LaunchP4(state,z,frame,count,temp);
}
if(future.m){
if(!(ordinal % 2))
asc_sync_notify(PIPE_V,PIPE_MTE2,EVENT_ID0);
else
asc_sync_notify(PIPE_V,PIPE_MTE2,EVENT_ID1);
}
preloaded = next.m != 0;
if(preloaded){
ReadShort(next,scale,scratch,temp,worker,sub,(ordinal + 1)% 2,after.m != 0,ordinal >= 1);
bank ^= 1;
}
if(rows){
EmitP4(state,frame);
}
++ordinal;
f = next;
next = future;
future = after;
}
cp6_sv59::Finish(state);
cp6_sv59::Wait(state,0);
cp6_sv59::Wait(state,1);
asc_sync();
}

template <uint32_t TM,uint32_t BN,bool Ranked = false>
__aicore__ inline void OwnedVector(
__gm__ float *scale,__gm__ half *y,__gm__ int32_t *scratch,uint32_t E,uint32_t N,uint32_t W){
const uint32_t worker = asc_get_block_idx(),sub = asc_get_sub_block_id();
const uint32_t ranks = Ranked ? cp6_c38::Min(2U,W / E): 1,active = Ranked ? E * ranks : cp6_c38::Min(E,W);
if(worker >= active)
return;
cp6_sv59::State v ={};
uint32_t ordinal = 0;
for(uint32_t e = Ranked ? worker / ranks : worker;e < E;e += Ranked ? E : active)
for(uint32_t t = Ranked ? worker % ranks : 0;t < N / BN;t += ranks)
cp6_sv59::Tile<BN,true>(v,scale,y,scratch,worker,sub,e,e * TM,t * BN,TM,BN,N,ordinal);
cp6_sv59::End(v);
}
}// namespace cp6_goal

namespace cp6_c38{
template <bool Deferred = false,bool Curve = true,bool Padded = false,bool MidWide = false>
static __aicore__ __attribute__((noinline))void LargeMidpoint(__ubuf__ float *z,__ubuf__ float *u,__ubuf__ float *t,
__ubuf__ float *p,__ubuf__ half *out,__ubuf__ uint8_t *mask,uint32_t count,bool waitOut = false);
}// namespace cp6_c38

namespace cp9_large_pipe{
constexpr uint32_t N = 768,BN = 256,Slots = 3,WeightBytes = 131072,SlotBytes = 172032;

struct DeferredFrame{
__gm__ half *dst;
uint32_t rows,bank,hard;
};

__aicore__ inline __ubuf__ float *SavedZ(uint32_t bank){
return(__ubuf__ float *)static_cast<uint64_t>(184320 + bank * 2048);
}

__aicore__ inline __ubuf__ uint32_t *SavedIndex(uint32_t bank){
return(__ubuf__ uint32_t *)static_cast<uint64_t>(185344 + bank * 2048);
}

__aicore__ inline void FinishFrame(DeferredFrame &f,cp6_sv59::State &state){
if(!f.rows)
return;
auto out =(__ubuf__ half *)static_cast<uint64_t>(135168 + f.bank * 16896);
auto bits =(__ubuf__ uint16_t *)out;
for(uint32_t i = 0;i < f.hard;++i){
const uint32_t lane = SavedIndex(f.bank)[i];
bits[lane] = cp6_c38::GoalRefineLane(SavedZ(f.bank)[i],bits[lane]);
}
asc_sync_notify(PIPE_S,PIPE_MTE3,EVENT_ID0);
asc_sync_wait(PIPE_S,PIPE_MTE3,EVENT_ID0);
asc_copy_ub2gm_align(f.dst,out,f.rows,BN * 2,0,0,0,(N - BN)* 2);
if(f.bank)
asc_sync_notify(PIPE_MTE3,PIPE_S,EVENT_ID7);
else
asc_sync_notify(PIPE_MTE3,PIPE_S,EVENT_ID6);
state.lease[f.bank] = true;
f.rows = 0;
}
}// namespace cp9_large_pipe

namespace cp6_column_stream{
using cp6_c38_fulla47::BF;

using cp6_c38_fulla47::BR;

using cp6_c38_fulla47::LF;

using cp6_c38_fulla47::LR;

__aicore__ inline void Ready(uint32_t slot,bool wait){
if(slot < 2)
BR(slot,wait);
else if(wait)
asc_sync_wait(PIPE_MTE2,PIPE_MTE1,EVENT_ID6);
else
asc_sync_notify(PIPE_MTE2,PIPE_MTE1,EVENT_ID6);
}

__aicore__ inline void Free(uint32_t slot){
if(slot < 2){
BF(slot,false);
BF(slot,true);
}else{
asc_sync_notify(PIPE_MTE1,PIPE_MTE2,EVENT_ID6);
asc_sync_wait(PIPE_MTE1,PIPE_MTE2,EVENT_ID6);
}
}

template <uint32_t TM,uint32_t BN,uint32_t CK,uint32_t LK,uint32_t Slots>
__aicore__ inline void Prefetch(__gm__ int8_t *w,__cbuf__ int8_t *b1,uint32_t panel,uint32_t K,uint32_t N){
const uint32_t panels_per_tile = K / CK;
const uint32_t k =(panel % panels_per_tile)* CK,col =(panel / panels_per_tile)* BN,slot = panel % Slots;
asc_copy_gm2l1_nd2nz(b1 + slot * BN * CK,w + uint64_t(k)* N + col,CK / 32,32,BN,32 * N,N,32,1,32 * BN);
Ready(slot,false);
}

template <uint32_t TM,uint32_t BN,uint32_t CK,uint32_t LK,uint32_t Slots>
__aicore__ inline void Load(__gm__ int8_t *w,__cbuf__ int8_t *a1,__cbuf__ int8_t *b1,__ca__ int8_t *a,
__cb__ int8_t *b,uint32_t j,uint32_t panels,uint32_t K,uint32_t N){
constexpr uint32_t micros = CK / LK;
const uint32_t panel = j / micros,inside = j % micros,l0 = j % 2,slot = panel % Slots,k =(j * LK)% K;
if(!inside)
Ready(slot,true);
if(k + LK < K)
for(uint32_t i = 0;i < LK / 32;++i)
asc_copy_l12l0a(a + l0 * TM * LK + i * 512,a1 +(k + i * 32)* TM,0,TM / 16,1,LK / 32 - 1);
asc_copy_l12l0b_trans(
b + l0 * BN * LK,b1 + slot * BN * CK + inside * BN * LK,0,(LK / 32)*(BN / 32),1,1,false,uint64_t(0));
LR(l0,false);
if(inside + 1 == micros && panel + Slots < panels){
Free(slot);
Prefetch<TM,BN,CK,LK,Slots>(w,b1,panel + Slots,K,N);
}
}

template <uint32_t TM,uint32_t BN,uint32_t CK,uint32_t LK,uint32_t Slots,bool Local = false>
__aicore__ inline void Cube(__gm__ int8_t *x,__gm__ int8_t *weight,__gm__ int32_t *scratch,uint32_t E,uint32_t K,
uint32_t N,uint32_t W,uint32_t start = 0){
const uint32_t worker = asc_get_block_idx(),active = cp6_c38::Min(E,W);
if(worker >= active)
return;
const uint32_t panels =(N / BN)*(K / CK),total =(N / BN)*(K / LK);
__cbuf__ int8_t *a1 =(__cbuf__ int8_t *)0;
__cbuf__ int8_t *b1 = a1 + TM *(K - LK);
__cbuf__ int8_t *tail1 = b1 +(Slots - 1)* BN * CK;
__ca__ int8_t *a =(__ca__ int8_t *)0;
__cb__ int8_t *b =(__cb__ int8_t *)0;
__cc__ int32_t *c =(__cc__ int32_t *)0;
uint32_t ordinal = 0;
bool lease = false;
for(uint32_t e = worker;e < E;e += active){
__gm__ int8_t *src = x + uint64_t(Local ? start : e * TM)* K;
__gm__ int8_t *w = weight + uint64_t(e)* K * N;
asc_copy_gm2l1_nd2nz(a1,src,1,TM,K - LK,0,K,TM,1,0);
asc_copy_gm2l1_nd2nz(tail1,src + K - LK,1,TM,LK,0,K,TM,1,0);
asc_sync_notify(PIPE_MTE2,PIPE_MTE1,EVENT_ID7);
for(uint32_t panel = 0;panel < Slots - 1;++panel)
Prefetch<TM,BN,CK,LK,Slots>(w,b1,panel,K,N);
asc_sync_wait(PIPE_MTE2,PIPE_MTE1,EVENT_ID7);
for(uint32_t i = 0;i < LK / 32;++i)
asc_copy_l12l0a(a + 2 * TM * LK + i * 512,tail1 + i * 32 * TM,0,TM / 16,1,LK / 32 - 1);
asc_sync_notify(PIPE_MTE1,PIPE_MTE2,EVENT_ID7);
asc_sync_wait(PIPE_MTE1,PIPE_MTE2,EVENT_ID7);
Prefetch<TM,BN,CK,LK,Slots>(w,b1,Slots - 1,K,N);
Load<TM,BN,CK,LK,Slots>(w,a1,b1,a,b,0,panels,K,N);
for(uint32_t j = 0;j < total;++j){
const uint32_t l0 = j % 2,k =(j * LK)% K;
LR(l0,true);
if(k == 0 && lease){
cp6_large39::CLease(0,true);
lease = false;
}
asc_mmad(c,a +(k + LK == K ? 2 : l0)* TM * LK,b + l0 * BN * LK,TM,LK,BN,0,false,false,k == 0);
if(j + 2 < total)
LF(l0,false);
if(j + 1 < total){
if(j)
LF((j + 1)% 2,true);
Load<TM,BN,CK,LK,Slots>(w,a1,b1,a,b,j + 1,panels,K,N);
}
if(k + LK == K){
asc_sync_notify(PIPE_M,PIPE_FIX,EVENT_ID5);
asc_sync_wait(PIPE_M,PIPE_FIX,EVENT_ID5);
cp6_c38::StoreC<BN>(c,scratch,worker,TM,TM,BN,ordinal,true);
lease = j + 1 < total || e + active < E;
if(lease)
cp6_large39::CLease(0,false);
}
}
if(e + active < E)
asc_sync();
}
cp6_c38::Drain(ordinal);
}
}// namespace cp6_column_stream

namespace cp6_local_groups{
using cp6_c38::Min;

using cp6_c38::Up;

template <uint32_t Profile,uint32_t K = 2048>
__aicore__ inline void RaggedCube(__gm__ int8_t *x,__gm__ int8_t *w,__gm__ int32_t *scratch,uint32_t expert,
uint32_t start,uint32_t length,uint32_t n){
constexpr uint32_t Micros = K / 128;
auto base =(__cbuf__ int8_t *)0;
auto a =(__ca__ int8_t *)0;
auto b =(__cb__ int8_t *)0;
auto c =(__cc__ int32_t *)0;
const uint32_t worker = asc_get_block_idx(),tm = cp6_c38::TileM<Profile>(length);
uint32_t ordinal = 0;
for(uint32_t offset = 0;offset < length;offset += tm){
const uint32_t rows = Min(tm,length - offset),mp = Up(rows,16),row = start + offset;
for(uint32_t col = 0;col < n;col += 256){
for(uint32_t j = 0;j < 3;++j)
cp6_c38::StreamPrefetch<Profile>(x,w,base,expert,row,col,tm,rows,256,K,n,j,j);
cp6_c38::StreamLoad<Profile>(x,w,base,a,b,expert,row,col,tm,rows,mp,256,K,n,0);
for(uint32_t j = 0;j < Micros;++j){
const uint32_t slot = j % 2;
cp6_c38::LR(slot,true);
asc_mmad(c,a + slot * tm * 128,b + slot * 32768,mp,128,256,0,false,false,j == 0);
if(j + 2 < Micros)
cp6_c38::LF(slot,false);
if(j + 1 < Micros){
if(j)
cp6_c38::LF((j + 1)% 2,true);
cp6_c38::StreamLoad<Profile>(x,w,base,a,b,expert,row,col,tm,rows,mp,256,K,n,j + 1);
}
}
asc_sync();
cp6_c38::StoreC<256>(c,scratch,worker,rows,mp,256,ordinal);
}
}
cp6_c38::Drain(ordinal);
}

template <uint32_t Profile,uint32_t TM,uint32_t BN>
__aicore__ inline void Vector(__gm__ float *scale,__gm__ half *y,__gm__ int32_t *scratch,uint32_t expert,
uint32_t start,uint32_t length,uint32_t n){
const uint32_t worker = asc_get_block_idx(),sub = asc_get_sub_block_id();
uint32_t ordinal = 0;
if(length == TM){
cp6_sv59::State state ={};
for(uint32_t col = 0;col < n;col += BN)
cp6_sv59::Tile<BN,true>(state,scale,y,scratch,worker,sub,expert,start,col,TM,BN,n,ordinal);
cp6_sv59::End(state);
}else{
const uint32_t tm = cp6_c38::TileM<Profile>(length);
uint32_t idx = 0;
for(uint32_t offset = 0;offset < length;offset += tm)
for(uint32_t col = 0;col < n;col += 256)
idx = cp6_c38::VectorTile<256>(scale,y,scratch,worker,sub,expert,start + offset,col,
Min(tm,length - offset),256,n,ordinal,idx);
asc_sync();
ffts_cross_core_sync(PIPE_MTE3,0x21ULL |(uint64_t(12)<< 8));
}
}
}// namespace cp6_local_groups

namespace cp6_staged_a{
using cp6_c38::Min;

using cp6_column_stream::Free;

using cp6_column_stream::LF;

using cp6_column_stream::LR;

using cp6_column_stream::Ready;

constexpr uint32_t K = 2048,Half = 1024;

__aicore__ inline void WeightReady(uint32_t slot,bool wait){
if(slot < 3)
Ready(slot,wait);
else if(slot == 3){
if(wait)
asc_sync_wait(PIPE_MTE2,PIPE_MTE1,EVENT_ID0);
else
asc_sync_notify(PIPE_MTE2,PIPE_MTE1,EVENT_ID0);
}else{
if(wait)
asc_sync_wait(PIPE_MTE2,PIPE_MTE1,EVENT_ID1);
else
asc_sync_notify(PIPE_MTE2,PIPE_MTE1,EVENT_ID1);
}
}

__aicore__ inline void WeightFree(uint32_t slot){
if(slot < 3)
Free(slot);
else if(slot == 3){
asc_sync_notify(PIPE_MTE1,PIPE_MTE2,EVENT_ID0);
asc_sync_wait(PIPE_MTE1,PIPE_MTE2,EVENT_ID0);
}else{
asc_sync_notify(PIPE_MTE1,PIPE_MTE2,EVENT_ID1);
asc_sync_wait(PIPE_MTE1,PIPE_MTE2,EVENT_ID1);
}
}

template <uint32_t BN,uint32_t CK,uint32_t N,uint32_t Slots>
__aicore__ inline void Prefetch(__gm__ int8_t *w,__cbuf__ int8_t *b1,uint32_t panel){
constexpr uint32_t Panels =(K + CK - 1)/ CK;
const uint32_t k =(panel % Panels)* CK,col =(panel / Panels)* BN,slot = panel % Slots;
const uint32_t rows = Min(CK,K - k);
asc_copy_gm2l1_nd2nz(b1 + slot * BN * CK,w + uint64_t(k)* N + col,rows / 32,32,BN,32 * N,N,32,1,32 * BN);
WeightReady(slot,false);
}

template <uint32_t TM,uint32_t BN,uint32_t CK,uint32_t LK,uint32_t N,uint32_t Slots>
__aicore__ inline void Load(
__gm__ int8_t *w,__cbuf__ int8_t *a1,__cbuf__ int8_t *b1,__ca__ int8_t *a,__cb__ int8_t *b,uint32_t j){
constexpr uint32_t Micros = K / LK,Panels =(K + CK - 1)/ CK;
const uint32_t k = j % Micros * LK,inside =(k % CK)/ LK,panel =(j / Micros)* Panels + k / CK;
const uint32_t slot = panel % Slots,l0 = j % 2;
if(j == 0)
asc_sync_wait(PIPE_MTE2,PIPE_MTE1,EVENT_ID3);
if(j == Half / LK)
asc_sync_wait(PIPE_MTE2,PIPE_MTE1,EVENT_ID7);
if(!inside)
WeightReady(slot,true);
constexpr bool KeepHead = TM == 128 && BN == 256 && LK == 128 && N == 768;
const bool cached = KeepHead && k < 256;
auto aa = cached ? a + 32768 + k * 128 : a + l0 * TM * LK;
if(!cached || j < Micros)
for(uint32_t i = 0;i < LK / 32;++i)
asc_copy_l12l0a(aa + i * 512,a1 +(k + i * 32)* TM,0,TM / 16,1,LK / 32 - 1);
asc_copy_l12l0b_trans(
b + l0 * BN * LK,b1 + slot * BN * CK + inside * BN * LK,0,(LK / 32)*(BN / 32),1,1,false,uint64_t(0));
LR(l0,false);
if((inside + 1 == CK / LK || k + LK == K)&& panel + Slots <(N / BN)* Panels){
WeightFree(slot);
Prefetch<BN,CK,N,Slots>(w,b1,panel + Slots);
}
}

template <uint32_t TM,uint32_t BN,uint32_t CK,uint32_t LK,uint32_t N,bool Staged,uint32_t Slots = 3>
__aicore__ inline void Cube(__gm__ int8_t *x,__gm__ int8_t *weight,__gm__ int32_t *scratch,uint32_t row){
constexpr uint32_t Total =(N / BN)*(K / LK);
const uint32_t worker = asc_get_block_idx();
if(worker >= 16)
return;
auto a1 =(__cbuf__ int8_t *)0;
auto b1 = a1 + TM * K;
auto a =(__ca__ int8_t *)0;
auto b =(__cb__ int8_t *)0;
auto c =(__cc__ int32_t *)0;
auto w = weight + uint64_t(worker)* K * N;
auto src = x + uint64_t(row)* K;
if(Staged){
asc_copy_gm2l1_nd2nz(a1,src,1,TM,Half,0,K,TM,1,0);
asc_sync_notify(PIPE_MTE2,PIPE_MTE1,EVENT_ID3);
for(uint32_t panel = 0;panel < Slots;++panel)
Prefetch<BN,CK,N,Slots>(w,b1,panel);
asc_copy_gm2l1_nd2nz(a1 + Half * TM,src + Half,1,TM,Half,0,K,TM,1,0);
asc_sync_notify(PIPE_MTE2,PIPE_MTE1,EVENT_ID7);
}else{
asc_copy_gm2l1_nd2nz(a1,src,1,TM,K,0,K,TM,1,0);
asc_sync_notify(PIPE_MTE2,PIPE_MTE1,EVENT_ID3);
asc_sync_notify(PIPE_MTE2,PIPE_MTE1,EVENT_ID7);
for(uint32_t panel = 0;panel < Slots;++panel)
Prefetch<BN,CK,N,Slots>(w,b1,panel);
}
Load<TM,BN,CK,LK,N,Slots>(w,a1,b1,a,b,0);
uint32_t ordinal = 0;
for(uint32_t j = 0;j < Total;++j){
const uint32_t l0 = j % 2,k = j %(K / LK);
LR(l0,true);
if(!k && j)
cp6_large39::CLease(0,true);
constexpr bool KeepHead = TM == 128 && BN == 256 && LK == 128 && N == 768;
auto aa = KeepHead && k < 2 ? a + 32768 + k * 16384 : a + l0 * TM * LK;
asc_mmad(c,aa,b + l0 * BN * LK,TM,LK,BN,0,false,false,!k);
if(j + 2 < Total)
LF(l0,false);
if(j + 1 < Total){
if(j)
LF((j + 1)% 2,true);
Load<TM,BN,CK,LK,N,Slots>(w,a1,b1,a,b,j + 1);
}
if(k + 1 == K / LK){
asc_sync_notify(PIPE_M,PIPE_FIX,EVENT_ID5);
asc_sync_wait(PIPE_M,PIPE_FIX,EVENT_ID5);
cp6_c38::StoreC<BN>(c,scratch,worker,TM,TM,BN,ordinal,true);
if(j + 1 < Total)
cp6_large39::CLease(0,false);
}
}
cp6_c38::Drain(ordinal);
}
}// namespace cp6_staged_a

__global__ __mix__(1,2)void grouped_matmul_gelu_cp8_local_r64_wide(__gm__ int8_t *x,__gm__ int8_t *w,
__gm__ float *scale,__gm__ int64_t *groups,__gm__ half *y,__gm__ int32_t *scratch,uint64_t sync_base){
set_ffts_base_addr(sync_base);
asc_init();
const uint32_t expert = asc_get_block_idx();
const uint32_t end = uint32_t(groups[expert]);
const uint32_t row = expert ? uint32_t(groups[expert - 1]): 0,length = end - row;
if(!length)
return;
if ASC_IS_AIC{
if(length == 64)
cp6_staged_a::Cube<64,512,128,64,1024,false,5>(x,w,scratch,row);
else
cp6_local_groups::RaggedCube<0>(x,w,scratch,expert,row,length,1024);
}
if ASC_IS_AIV{
cp6_local_groups::Vector<0,64,512>(scale,y,scratch,expert,row,length,1024);
}
asc_sync();
}

__global__ __mix__(1,2)void grouped_matmul_gelu_cp6_c38_r64_wide(__gm__ int8_t *x,__gm__ int8_t *w,
__gm__ float *scale,__gm__ int64_t *groups,__gm__ half *y,__gm__ int32_t *scratch,uint32_t E,uint32_t K,
uint32_t N,uint32_t W,uint64_t sync_base){
set_ffts_base_addr(sync_base);
asc_init();
const bool wave_ok = uint64_t((E + W - 1)/ W)*(N / 256)<=((uint64_t(E)*(N / 256)+ W - 1)/ W);
const bool owned = wave_ok && cp6_c38::Uniform<64>(groups,E,W);
if ASC_IS_AIC{
if(owned && N % 512 == 0 && K % 256 == 0 && K / 256 >= 3 && 64ULL *(K - 64)+ 3ULL * 256 * 512 <= 523264)
cp6_column_stream::Cube<64,512,256,64,3>(x,w,scratch,E,K,N,W);
else if(owned)
cp6_c38_fulla47::CubeC<64,512,256,64>(x,w,groups,scratch,E,K,N,W,1,0);
else
cp6_c38::CubeStreamGrouped<0>(x,w,groups,scratch,E,K,N,W);
}
if ASC_IS_AIV{
if(owned && K == 2048 && N == 1024)
cp6_goal::OwnedVector<64,512>(scale,y,scratch,E,N,W);
else if(owned)
cp6_c38::VectorOwned<64,512>(scale,y,scratch,E,N,W);
else
cp6_c38::VectorGrouped<0>(scale,groups,y,scratch,E,N,W);
}
asc_sync();
}

namespace cp6_resident{
using namespace cp6_c38_fulla47;

__aicore__ inline void ResidentReady(uint32_t slot,bool wait){
if(slot < 3)
cp6_column_stream::Ready(slot,wait);
else if(slot == 3){
if(wait)
asc_sync_wait(PIPE_MTE2,PIPE_MTE1,EVENT_ID7);
else
asc_sync_notify(PIPE_MTE2,PIPE_MTE1,EVENT_ID7);
}else if(slot == 4){
if(wait)
asc_sync_wait(PIPE_MTE2,PIPE_MTE1,EVENT_ID0);
else
asc_sync_notify(PIPE_MTE2,PIPE_MTE1,EVENT_ID0);
}else{
if(wait)
asc_sync_wait(PIPE_MTE2,PIPE_MTE1,EVENT_ID1);
else
asc_sync_notify(PIPE_MTE2,PIPE_MTE1,EVENT_ID1);
}
}

__aicore__ inline void ResidentFree(uint32_t slot){
if(slot < 3)
cp6_column_stream::Free(slot);
else if(slot == 3){
asc_sync_notify(PIPE_MTE1,PIPE_MTE2,EVENT_ID7);
asc_sync_wait(PIPE_MTE1,PIPE_MTE2,EVENT_ID7);
}else if(slot == 4){
asc_sync_notify(PIPE_MTE1,PIPE_MTE2,EVENT_ID0);
asc_sync_wait(PIPE_MTE1,PIPE_MTE2,EVENT_ID0);
}else{
asc_sync_notify(PIPE_MTE1,PIPE_MTE2,EVENT_ID1);
asc_sync_wait(PIPE_MTE1,PIPE_MTE2,EVENT_ID1);
}
}

template <uint32_t Slots>
__aicore__ inline void Prefetch(__gm__ int8_t *w,__cbuf__ int8_t *base,uint32_t e,uint32_t panel,uint32_t rank){
constexpr uint32_t CK = Slots >= 4 ? 256 : 512,Panels = 1024 / CK;
const uint32_t k =((panel % Panels)^(rank *(Panels / 2)))* CK;
const uint32_t col =(panel / Panels)* 256,slot = panel % Slots;
asc_copy_gm2l1_nd2nz(
base + slot * CK * 256,w +(uint64_t(e)* 1024 + k)* 1024 + col,CK / 32,32,256,32768,1024,32,1,8192);
ResidentReady(slot,false);
}

template <uint32_t Slots>
__aicore__ inline void Load(
__gm__ int8_t *w,__cbuf__ int8_t *base,__cb__ int8_t *b,uint32_t e,uint32_t j,uint32_t rank){
constexpr uint32_t CK = Slots >= 4 ? 256 : 512,Micros = CK / 128,Panels = 4096 / CK;
const uint32_t panel = j / Micros,slot = panel % Slots,inside = j % Micros;
if(!inside)
ResidentReady(slot,true);
asc_copy_l12l0b_trans(
b +(j % 2)* 32768,base + slot * CK * 256 + inside * 32768,0,32,1,1,false,uint64_t(0));
LR(j % 2,false);
if(inside + 1 == Micros && panel + Slots < Panels){
ResidentFree(slot);
Prefetch<Slots>(w,base,e,panel + Slots,rank);
}
}

template <uint32_t Slots = 2,bool Overlap = false,bool Local = false>
__aicore__ inline void Cube(
__gm__ int8_t *x,__gm__ int8_t *w,__gm__ int32_t *scratch,uint32_t E,uint32_t start = 0){
const uint32_t worker = asc_get_block_idx();
if(!Local && worker >= 2 * E)
return;
const uint32_t e = worker / 2,row = Local ? start : worker * 64;
__cbuf__ int8_t *base =(__cbuf__ int8_t *)0;
__ca__ int8_t *a =(__ca__ int8_t *)0;
__cb__ int8_t *b =(__cb__ int8_t *)0;
__cc__ int32_t *c =(__cc__ int32_t *)0;
auto a1 = Overlap ? base + Slots *(Slots >= 4 ? 65536 : 131072): base;
asc_copy_gm2l1_nd2nz(a1,x + uint64_t(row)* 1024,1,64,1024,0,1024,64,1,0);
asc_sync_notify(PIPE_MTE2,PIPE_MTE1,EVENT_ID3);
if(Overlap)
for(uint32_t panel = 0;panel < Slots;++panel)
Prefetch<Slots>(w,base,e,panel,worker % 2);
asc_sync_wait(PIPE_MTE2,PIPE_MTE1,EVENT_ID3);
for(uint32_t j = 0;j < 8;++j)
for(uint32_t k = 0;k < 4;++k)
asc_copy_l12l0a(a + j * 8192 + k * 512,a1 + j * 8192 + k * 2048,0,4,1,3);
if(!Overlap){
asc_sync_notify(PIPE_MTE1,PIPE_MTE2,EVENT_ID3);
asc_sync_wait(PIPE_MTE1,PIPE_MTE2,EVENT_ID3);
for(uint32_t panel = 0;panel < Slots;++panel)
Prefetch<Slots>(w,base,e,panel,worker % 2);
}
Load<Slots>(w,base,b,e,0,worker % 2);
uint32_t ordinal = 0;
for(uint32_t j = 0;j < 32;++j){
const uint32_t k = j % 8,t = j / 8,slot = t % 2;
LR(j % 2,true);
if(!k && t >= 2)
cp6_large39::CLease(slot,true);
asc_mmad(c + slot * 16384,a +(k ^((worker % 2)* 4))* 8192,b +(j % 2)* 32768,64,128,256,0,false,
false,!k);
if(j + 2 < 32)
LF(j % 2,false);
if(j + 1 < 32){
if(j)
LF((j + 1)% 2,true);
Load<Slots>(w,base,b,e,j + 1,worker % 2);
}
if(k == 7){
asc_sync_notify(PIPE_M,PIPE_FIX,EVENT_ID5);
asc_sync_wait(PIPE_M,PIPE_FIX,EVENT_ID5);
cp6_c38::StoreC<256>(c + slot * 16384,scratch,worker,64,64,256,ordinal,true);
cp6_large39::CLease(slot,false);
}
}
cp6_large39::CLease(0,true);
cp6_large39::CLease(1,true);
if(Local)
asc_sync_block_wait(cp6_c38::FINAL);
else
cp6_c38::Drain(ordinal);
}

__aicore__ inline __ubuf__ float *ResidentInput(uint32_t bank){
return(__ubuf__ float *)static_cast<uint64_t>(bank * 32768);
}

__aicore__ inline void ReadResidentInput(__gm__ int32_t *scratch,uint32_t worker,uint32_t sub,uint32_t tile){
constexpr uint32_t Slice = 32 * 256,Slot = 2 * Slice;
const uint32_t bank = tile % 2;
if(tile >= 2){
if(bank)
asc_sync_wait(PIPE_V,PIPE_MTE2,EVENT_ID1);
else
asc_sync_wait(PIPE_V,PIPE_MTE2,EVENT_ID0);
}
asc_sync_block_wait(8 + 2 * bank);
asc_copy_gm2ub_align((__ubuf__ int32_t *)ResidentInput(bank),
scratch +(uint64_t(worker)* 2 + bank)* Slot + sub * Slice,1,Slice * sizeof(int32_t),0,0,0,0);
asc_sync_notify(PIPE_MTE2,PIPE_V,EVENT_ID7);
if(tile < 2)
ffts_cross_core_sync(PIPE_MTE2,0x21ULL |(uint64_t(9 + 2 * bank)<< 8));
}

__aicore__ inline void Vector64(__gm__ float *scale,__gm__ half *y,__gm__ int32_t *scratch,uint32_t row){
constexpr uint32_t Rows = 32,Width = 256,Columns = 1024,Count = Rows * Width;
const uint32_t worker = asc_get_block_idx(),sub = asc_get_sub_block_id();
auto scales =(__ubuf__ float *)181760;
auto work =(__ubuf__ float *)65536;
auto output = y + uint64_t(row + sub * Rows)* Columns;
asc_copy_gm2ub_align(scales,scale + uint64_t(worker / 2)* Columns,1,Columns * sizeof(float),0,0,0,0);
cp6_c38::InitShortCurve();
ReadResidentInput(scratch,worker,sub,0);
for(uint32_t tile = 0;tile < Columns / Width;++tile){
const uint32_t bank = tile % 2,column = tile * Width;
auto z = ResidentInput(bank);
auto out = cp6_sv59::Out(bank);
asc_sync_wait(PIPE_MTE2,PIPE_V,EVENT_ID7);
asc_int322float_rn(z,(__ubuf__ int32_t *)z,Count);
asc_sync_pipe(PIPE_V);
asc_set_mask_norm();
asc_set_vector_mask(uint64_t(0),~uint64_t(0));
for(uint32_t offset = 0;offset < Width;offset += 64)
asc_mul(z + offset,z + offset,scales + column + offset,uint8_t(Rows),1,1,1,Width / 8,Width / 8,0);
asc_sync_pipe(PIPE_V);
if(tile >= 2){
if(bank)
asc_sync_wait(PIPE_MTE3,PIPE_V,EVENT_ID5);
else
asc_sync_wait(PIPE_MTE3,PIPE_V,EVENT_ID4);
}
// Each GELU intermediate is dead by the time the next one is written.
cp6_c38::CompactMidpoint<true,true,true>(z,work,work,work,out,nullptr,Count);
if(tile < 2){
if(bank)
asc_sync_notify(PIPE_V,PIPE_MTE2,EVENT_ID1);
else
asc_sync_notify(PIPE_V,PIPE_MTE2,EVENT_ID0);
}
if(tile + 1 < Columns / Width)
ReadResidentInput(scratch,worker,sub,tile + 1);
asc_sync_notify(PIPE_V,PIPE_MTE3,EVENT_ID0);
asc_sync_wait(PIPE_V,PIPE_MTE3,EVENT_ID0);
asc_copy_ub2gm_align(
output + column,out,Rows,Width * sizeof(half),0,0,0,(Columns - Width)* sizeof(half));
if(tile < 2){
if(bank)
asc_sync_notify(PIPE_MTE3,PIPE_V,EVENT_ID5);
else
asc_sync_notify(PIPE_MTE3,PIPE_V,EVENT_ID4);
}
}
asc_sync();
ffts_cross_core_sync(PIPE_MTE3,0x21ULL |(uint64_t(12)<< 8));
}

template <bool SingleFrame>
__aicore__ inline void ReadFastTail(
__gm__ int32_t *scratch,uint32_t worker,uint32_t sub,uint32_t splitRows,uint32_t count,uint32_t tile){
const uint32_t bank = tile % 2;
if(tile >= 2){
if(bank)
asc_sync_wait(PIPE_V,PIPE_MTE2,EVENT_ID1);
else
asc_sync_wait(PIPE_V,PIPE_MTE2,EVENT_ID0);
}
asc_sync_block_wait(SingleFrame ? 8 : 8 + 2 * bank);
auto input =(__ubuf__ float *)static_cast<uint64_t>(bank * 33792);
auto packet = scratch +(SingleFrame ? uint64_t(worker)* 32768 :(uint64_t(worker)* 2 + bank)* 16384);
asc_copy_gm2ub_align((__ubuf__ int32_t *)input,packet + sub * splitRows * 256,1,count * 4,0,0,0,0);
asc_sync_notify(PIPE_MTE2,PIPE_V,EVENT_ID7);
ffts_cross_core_sync(PIPE_MTE2,0x21ULL |(uint64_t(SingleFrame ? 9 : 9 + 2 * bank)<< 8));
}

template <bool SingleFrame>
__aicore__ __attribute__((always_inline))inline void FastResidentTail(
__gm__ float *scale,__gm__ half *y,__gm__ int32_t *scratch,uint32_t row,uint32_t actualRows){
constexpr uint32_t Tiles = 4;
const uint32_t worker = asc_get_block_idx(),sub = asc_get_sub_block_id();
const uint32_t splitRows = SingleFrame ? actualRows / 2 :(actualRows + 1)/ 2;
const uint32_t rows = sub ? actualRows - splitRows : splitRows,count = rows * 256;
auto sc =(__ubuf__ float *)181760;
auto work =(__ubuf__ float *)67584;
asc_copy_gm2ub_align(sc,scale + uint64_t(worker / 2)* 1024,1,4096,0,0,0,0);
cp6_c38::InitShortCurve();
ReadFastTail<SingleFrame>(scratch,worker,sub,splitRows,count,0);
for(uint32_t tile = 0;tile < Tiles;++tile){
const uint32_t bank = tile % 2,col = tile * 256;
auto z =(__ubuf__ float *)static_cast<uint64_t>(bank * 33792);
auto out =(__ubuf__ half *)static_cast<uint64_t>(135168 + bank * 16896);
asc_sync_wait(PIPE_MTE2,PIPE_V,EVENT_ID7);
asc_int322float_rn(z,(__ubuf__ int32_t *)z,count);
asc_sync_pipe(PIPE_V);
asc_set_mask_norm();
asc_set_vector_mask(uint64_t(0),~uint64_t(0));
for(uint32_t n = 0;n < 256;n += 64)
asc_mul(z + n,z + n,sc + col + n,uint8_t(rows),1,1,1,32,32,0);
asc_sync_pipe(PIPE_V);
asc_set_vector_mask(~uint64_t(0),~uint64_t(0));
if(tile >= 2){
if(bank)
asc_sync_wait(PIPE_MTE3,PIPE_V,EVENT_ID5);
else
asc_sync_wait(PIPE_MTE3,PIPE_V,EVENT_ID4);
}
cp6_c38::CompactMidpoint<true,true,true>(z,work,work,work,out,nullptr,count);
if(tile < 2){
if(bank)
asc_sync_notify(PIPE_V,PIPE_MTE2,EVENT_ID1);
else
asc_sync_notify(PIPE_V,PIPE_MTE2,EVENT_ID0);
}
if(tile + 1 < Tiles)
ReadFastTail<SingleFrame>(scratch,worker,sub,splitRows,count,tile + 1);
asc_sync_notify(PIPE_V,PIPE_MTE3,EVENT_ID0);
asc_sync_wait(PIPE_V,PIPE_MTE3,EVENT_ID0);
asc_copy_ub2gm_align(y + uint64_t(row + sub * splitRows)* 1024 + col,out,rows,512,0,0,0,1536);
if(tile < 2){
if(bank)
asc_sync_notify(PIPE_MTE3,PIPE_V,EVENT_ID5);
else
asc_sync_notify(PIPE_MTE3,PIPE_V,EVENT_ID4);
}
}
asc_sync();
ffts_cross_core_sync(PIPE_MTE3,0x21ULL |(uint64_t(12)<< 8));
}

static __aicore__ __attribute__((noinline))void TailVector63(
__gm__ float *scale,__gm__ half *y,__gm__ int32_t *scratch,uint32_t row){
FastResidentTail<false>(scale,y,scratch,row,63);
}

template <bool Local = false>
__aicore__ inline void Vector(
__gm__ float *scale,__gm__ half *y,__gm__ int32_t *scratch,uint32_t E,uint32_t start = 0){
const uint32_t worker = asc_get_block_idx();
if(!Local && worker >= 2 * E)
return;
cp6_sv59::State v ={};
uint32_t ordinal = 0;
for(uint32_t col = 0;col < 1024;col += 256)
cp6_sv59::Tile<256,true,true,true>(v,scale,y,scratch,worker,asc_get_sub_block_id(),worker / 2,
Local ? start : worker * 64,col,64,256,1024,ordinal);
cp6_sv59::End(v);
}
}// namespace cp6_resident

__global__ __mix__(1,2)void grouped_matmul_gelu_cp6_c38_r128_fullk(__gm__ int8_t *x,__gm__ int8_t *w,
__gm__ float *scale,__gm__ int64_t *groups,__gm__ half *y,__gm__ int32_t *scratch,uint32_t E,uint32_t K,
uint32_t N,uint32_t W,uint64_t sync_base){
set_ffts_base_addr(sync_base);
asc_init();
const uint32_t ranks = E <= W ? cp6_c38::Min(2U,W / E): 1;
const bool wave_ok =(N / 256 + ranks - 1)/ ranks <=(uint64_t(E)*(N / 256)+ W - 1)/ W;
const bool owned = wave_ok && cp6_c38::Uniform<128>(groups,E,W);
if(owned && K == 1024 && N == 1024 && W >= 2 * E){
if ASC_IS_AIC{
cp6_resident::Cube(x,w,scratch,E);
}
if ASC_IS_AIV{
cp6_resident::Vector(scale,y,scratch,E);
}
asc_sync();
return;
}
if ASC_IS_AIC{
if(owned)
cp6_c38::CubeFullOwned(x,w,scratch,E,K,N,W);
else
cp6_c38::CubeFullGrouped<1,false>(x,w,groups,scratch,E,K,N,W);
}
if ASC_IS_AIV{
if(owned && K == 1024 && N == 1024)
cp6_c38::VectorOwned<128,256,true,true>(scale,y,scratch,E,N,W);
else if(owned)
cp6_c38::VectorOwned<128,256,true>(scale,y,scratch,E,N,W);
else
cp6_c38::VectorGrouped<1>(scale,groups,y,scratch,E,N,W);
}
asc_sync();
}

template <class T> __aicore__ inline __gm__ T *P4NoAllocate(__gm__ T *pointer){
AscendC::GlobalTensor<T> tensor;
tensor.SetGlobalBuffer(pointer);
tensor.SetL2CacheHint(AscendC::CacheMode::CACHE_MODE_DISABLE);
return const_cast<__gm__ T *>(tensor.GetPhyAddr());
}

__global__ __mix__(1,2)__attribute__((aligned(4096)))void grouped_matmul_gelu_expert_short_k(__gm__ int8_t *x,
__gm__ int8_t *w,__gm__ float *scale,__gm__ int64_t *groups,__gm__ half *y,__gm__ int32_t *scratch,uint32_t E,
uint32_t W,uint64_t sync_base){
set_ffts_base_addr(sync_base);
asc_init();
if ASC_IS_AIC{
cp6_goal::ShortCube(P4NoAllocate(x),P4NoAllocate(w),groups,scratch,E,W);
}
if ASC_IS_AIV{
cp6_goal::Short<false>(x,w,scale,groups,P4NoAllocate(y),scratch,E,W);
}
asc_sync();
}

__global__ __mix__(1,2)void grouped_matmul_gelu_cp8_local_r128_streamk(__gm__ int8_t *x,__gm__ int8_t *w,
__gm__ float *scale,__gm__ int64_t *groups,__gm__ half *y,__gm__ int32_t *scratch,uint64_t sync_base){
set_ffts_base_addr(sync_base);
asc_init();
const uint32_t expert = asc_get_block_idx();
const uint32_t end = uint32_t(groups[expert]);
const uint32_t row = expert ? uint32_t(groups[expert - 1]): 0,length = end - row;
if(!length)
return;
if ASC_IS_AIC{
if(length == 128)
cp6_staged_a::Cube<128,256,128,128,768,false,5>(x,w,scratch,row);
else
cp6_local_groups::RaggedCube<1>(x,w,scratch,expert,row,length,768);
}
if ASC_IS_AIV{
cp6_local_groups::Vector<1,128,256>(scale,y,scratch,expert,row,length,768);
}
asc_sync();
}

namespace cp6_mid_focus{
__aicore__ inline bool Eligible(__gm__ int64_t *groups,uint32_t E,uint32_t K,uint32_t N,uint32_t W){
if(E != 32 ||(K != 992 && K != 1024)|| N != 768 || W != 20)
return false;

return true;
}
}// namespace cp6_mid_focus

namespace cp6_c38{
template <bool Deferred,bool Curve,bool Padded,bool MidWide>
static __aicore__ __attribute__((noinline))void LargeMidpoint(__ubuf__ float *z,__ubuf__ float *u,__ubuf__ float *t,
__ubuf__ float *p,__ubuf__ half *out,__ubuf__ uint8_t *mask,uint32_t count,bool waitOut){
auto cmp =(__ubuf__ uint8_t *)(MidWide ? 184320 : 169216);
auto tiny =(__ubuf__ uint8_t *)(MidWide ? 185600 : 171008);
auto denominator = t;
const uint8_t repeats = uint8_t(count / 64);
asc_set_mask_norm();
asc_set_vector_mask(~uint64_t(0),~uint64_t(0));
asc_duplicate((__ubuf__ float *)(MidWide ? 188160 : 175104),-.071354814f,uint32_t(64));
asc_duplicate((__ubuf__ float *)(MidWide ? 188416 : 175424),-1.5957692f,uint32_t(64));
asc_set_mask_norm();
asc_set_vector_mask(~uint64_t(0),~uint64_t(0));
if(Curve){
asc_mul(u,z,z,repeats,1,1,1,8,8,8);
asc_sync_pipe(PIPE_V);
asc_mul_add(u,(__ubuf__ float *)(MidWide ? 188160 : 175104),(__ubuf__ float *)(MidWide ? 188416 : 175424),
uint8_t(count / 64),1,1,1,8,0,0);
asc_sync_pipe(PIPE_V);
asc_mul(t,u,z,repeats,1,1,1,8,8,8);
asc_sync_pipe(PIPE_V);
}else{
asc_mul(u,z,z,repeats,1,1,1,8,8,8);
asc_sync_pipe(PIPE_V);
asc_mul(u,u,z,repeats,1,1,1,8,8,8);
asc_sync_pipe(PIPE_V);
asc_mul_scalar(u,u,.044715f,repeats,1,1,8,8);
asc_sync_pipe(PIPE_V);
asc_add(u,u,z,repeats,1,1,1,8,8,8);
asc_sync_pipe(PIPE_V);
asc_mul_scalar(u,u,.7978846f,repeats,1,1,8,8);
asc_sync_pipe(PIPE_V);
asc_mul_scalar(t,u,-2.0f,repeats,1,1,8,8);
asc_sync_pipe(PIPE_V);
}
asc_min_scalar(t,t,8e1f,repeats,1,1,8,8);
asc_sync_pipe(PIPE_V);
asc_exp(t,t,repeats,1,1,8,8);
asc_sync_pipe(PIPE_V);
asc_add_scalar(denominator,t,1.0f,repeats,1,1,8,8);
asc_sync_pipe(PIPE_V);
asc_div(p,z,denominator,repeats,1,1,1,8,8,8);
asc_sync_pipe(PIPE_V);
if(MidWide && waitOut)
asc_sync_wait(PIPE_MTE3,PIPE_V,EVENT_ID4);
asc_float2half_rn(out,p,repeats,1,1,4,8);
asc_sync_pipe(PIPE_V);
if(Deferred){
const uint32_t blocks =(count + 2047)/ 2048;
asc_duplicate((__ubuf__ int32_t *)cmp,int32_t(-1),blocks * 2);
asc_sync_pipe(PIPE_V);
}else{
asc_sync_notify(PIPE_V,PIPE_S,EVENT_ID1);
asc_sync_wait(PIPE_V,PIPE_S,EVENT_ID1);
}
}
}// namespace cp6_c38

namespace cp6_sv59{
template <bool Curve>
__aicore__ inline void LargeTile(State &s,__gm__ float *scale,__gm__ half *y,__gm__ int32_t *scratch,
uint32_t worker,uint32_t sub,uint32_t e,uint32_t row,uint32_t col,uint32_t mr,uint32_t nr,uint32_t N,
uint32_t &ordinal){
constexpr uint32_t BN = 256,sr = 64;
auto z =(__ubuf__ float *)0;
auto sc =(__ubuf__ float *)181760;
asc_copy_gm2ub_align(sc,scale + uint64_t(e)* N + col,1,nr * 4,0,0,0,0);
for(uint32_t micro = 0;micro < mr;micro += sr){
const uint32_t tail = Min(sr,mr - micro),split =(tail + 1)/ 2,local = sub * split;
const uint32_t rows = tail > local ? Min(split,tail - local): 0,slot = ordinal % 2;
asc_sync_block_wait(8 + 2 * slot);
if(rows)
asc_copy_gm2ub_align((__ubuf__ int32_t *)z,scratch +(uint64_t(worker)* 2 + slot)* 16384 + local * BN,1,
rows * BN * 4,0,0,0,0);
asc_sync_notify(PIPE_MTE2,PIPE_V,EVENT_ID7);
ffts_cross_core_sync(PIPE_MTE2,0x21ULL |(uint64_t(9 + 2 * slot)<< 8));
asc_sync_wait(PIPE_MTE2,PIPE_V,EVENT_ID7);
if(rows){
const uint32_t count = rows * BN;
asc_int322float_rn(z,(__ubuf__ int32_t *)z,count);
asc_sync_pipe(PIPE_V);
asc_set_mask_norm();
asc_set_vector_mask(uint64_t(0),~uint64_t(0));
for(uint32_t n = 0;n < BN;n += 64)
asc_mul(z + n,z + n,sc + n,uint8_t(rows),1,1,1,BN / 8,BN / 8,0);
asc_sync_pipe(PIPE_V);
asc_set_vector_mask(~uint64_t(0),~uint64_t(0));
Frame f ={};
f.dst = y + uint64_t(row + micro + local)* N + col;
f.rows = rows;
f.N = N;
f.nr = nr;
f.bn = BN;
f.bank = s.next;
s.next ^= 1;
Wait(s,f.bank);
cp6_c38::LargeMidpoint<false,Curve,true>(z,(__ubuf__ float *)32768,(__ubuf__ float *)65536,
(__ubuf__ float *)98304,Out(f.bank),(__ubuf__ uint8_t *)172032,count);
Emit(s,f);
}
++ordinal;
}
}
}// namespace cp6_sv59

namespace gmg_base{
constexpr uint32_t BM = 64,BN = 128,BK = 128,VM = 32,VQ = VM * BN;

constexpr int READY = 8,DONE = 9;

__aicore__ inline uint32_t Min(uint32_t a,uint32_t b){return a < b ? a : b;}

__aicore__ inline uint32_t Up(uint32_t x,uint32_t a){return(x + a - 1)/ a * a;}

__aicore__ inline uint16_t PreciseGeluHalf(float z){return fast_gmg::PreciseGeluHalfLeaf(z);}

__aicore__ inline void ZeroL1(__cbuf__ int8_t *p,uint32_t bytes){
asc_fill_value_config cfg;
cfg.config = 0;
cfg.repeat = 1;
cfg.blk_num = bytes / 32;
cfg.dst_gap = 0;
asc_fill_l1_sync((__cbuf__ uint16_t *)p,uint32_t(0),cfg);
}

__aicore__ inline void Cube(__gm__ int8_t *x,__gm__ int8_t *w,__gm__ int64_t *groups,__gm__ int32_t *scratch,
uint32_t E,uint32_t K,uint32_t N,uint32_t workers){
__cbuf__ int8_t *a1 =(__cbuf__ int8_t *)0;
__cbuf__ int8_t *b1 =(__cbuf__ int8_t *)(BM * BK);
__ca__ int8_t *a0 =(__ca__ int8_t *)0;
__cb__ int8_t *b0 =(__cb__ int8_t *)0;
__cc__ int32_t *c0 =(__cc__ int32_t *)0;
const uint32_t worker = asc_get_block_idx(),nt =(N + BN - 1)/ BN;
__gm__ int32_t *slot = scratch + uint64_t(worker)* BM * BN;
uint32_t start = 0,prefix = 0;
for(uint32_t e = 0;e < E;++e){
const uint32_t end = static_cast<uint32_t>(groups[e]),me = end - start;
const uint32_t tasks =((me + BM - 1)/ BM)* nt;
const uint32_t first =(worker + workers - prefix % workers)% workers;
for(uint32_t task = first;task < tasks;task += workers){
const uint32_t row = start +(task / nt)* BM,col =(task % nt)* BN;
const uint32_t mr = Min(BM,end - row),nr = Min(BN,N - col);
const uint32_t mp = Up(mr,16),np = Up(nr,32);
for(uint32_t k0 = 0;k0 < K;k0 += BK){
const uint32_t kr = Min(BK,K - k0),kp = Up(kr,32);
ZeroL1(a1,BM * BK);
ZeroL1(b1,BK * BN);
asc_copy_gm2l1_nd2nz_sync(a1,x + uint64_t(row)* K + k0,1,mr,kr,0,K,BM,1,0);
asc_copy_gm2l1_nd2nz_sync(b1,w +(uint64_t(e)* K + k0)* N + col,1,kr,nr,0,N,kp,1,0);
for(uint32_t mi = 0;mi < mp / 16;++mi)
asc_copy_l12l0a_sync(a0 + mi * kp * 16,a1 + mi * 512,0,kp / 32,BM / 16,0);
for(uint32_t ki = 0;ki < kp / 32;++ki)
asc_copy_l12l0b_trans_sync(
b0 + ki * np * 32,b1 + ki * 1024,0,np / 32,kp / 32,1,false,uint64_t(0));
asc_mmad_sync(c0,a0,b0,mp,kp,np,0,false,false,k0 == 0);
}
asc_set_l0c_copy_params(1,0,0);
asc_copy_l0c2gm_sync(slot,c0,np,mr,BN,mp,0,0,0,false,true);
ffts_cross_core_sync(PIPE_FIX,0x21ULL |(uint64_t(READY)<< 8));
asc_sync_block_wait(DONE);
}
prefix += tasks;
start = end;
}
}

__aicore__ inline void Vector(__gm__ float *scale,__gm__ int64_t *groups,__gm__ half *y,__gm__ int32_t *scratch,
uint32_t E,uint32_t N,uint32_t workers){
__ubuf__ int32_t *c =(__ubuf__ int32_t *)0;
__ubuf__ float *z =(__ubuf__ float *)(4 * VQ);
__ubuf__ float *u =(__ubuf__ float *)(8 * VQ);
__ubuf__ float *t =(__ubuf__ float *)(12 * VQ);
__ubuf__ float *d =(__ubuf__ float *)(16 * VQ);
__ubuf__ float *p =(__ubuf__ float *)(20 * VQ);
__ubuf__ float *s =(__ubuf__ float *)(24 * VQ);
__ubuf__ half *out =(__ubuf__ half *)(24 * VQ + 4 * BN);
__ubuf__ uint8_t *refine_mask =(__ubuf__ uint8_t *)(26 * VQ + 4 * BN);
const uint32_t worker = asc_get_block_idx(),sub = asc_get_sub_block_id();
const uint32_t nt =(N + BN - 1)/ BN;
__gm__ int32_t *slot = scratch + uint64_t(worker)* BM * BN;
uint32_t start = 0,prefix = 0;
for(uint32_t e = 0;e < E;++e){
const uint32_t end = static_cast<uint32_t>(groups[e]),me = end - start;
const uint32_t tasks =((me + BM - 1)/ BM)* nt;
const uint32_t first =(worker + workers - prefix % workers)% workers;
for(uint32_t task = first;task < tasks;task += workers){
const uint32_t row0 = start +(task / nt)* BM,col =(task % nt)* BN;
const uint32_t mr = Min(BM,end - row0),nr = Min(BN,N - col);
const uint32_t local_row = sub * VM;
const uint32_t rows = mr > local_row ? Min(VM,mr - local_row): 0;
asc_sync_block_wait(READY);
if(rows){
const uint32_t count = rows * BN,np = Up(nr,32);
asc_duplicate_sync(c,int32_t(0),count);
asc_copy_gm2ub_align(c,slot + local_row * BN,rows,np * 4,0,0,(BN - np)* 4,(BN - np)/ 8);
asc_sync();
asc_duplicate_sync(s,0.0f,BN);
asc_copy_gm2ub_align_sync(s,scale + uint64_t(e)* N + col,nr * 4);
asc_int322float_rn_sync(z,c,count);
for(uint32_t r = 0;r < rows;++r)
asc_mul_sync(z + r * BN,z + r * BN,s,BN);
asc_mul_sync(u,z,z,count);
asc_mul_sync(u,u,z,count);
asc_mul_scalar_sync(u,u,.044715f,count);
asc_add_sync(u,u,z,count);
asc_mul_scalar_sync(u,u,.7978846f,count);
asc_abs_sync(t,u,count);
asc_mul_scalar_sync(t,t,-2.0f,count);
asc_exp_sync(t,t,count);
asc_add_scalar_sync(d,t,1.0f,count);
asc_min_scalar_sync(u,z,0.0f,count);
asc_mul_sync(u,u,t,count);
asc_max_scalar_sync(p,z,0.0f,count);
asc_add_sync(p,p,u,count);
asc_div_sync(p,p,d,count);
asc_float2half_rn_sync(out,p,count);
asc_abs_sync(t,z,count);
asc_add_scalar_sync(u,t,-2.0f,count);
asc_mul_scalar_sync(d,t,-1.0f,count);
asc_add_scalar_sync(d,d,8.0f,count);
asc_mul_sync(u,u,d,count);
asc_add_scalar_sync(p,t,-2e-8f,count);
asc_mul_scalar_sync(d,t,-1.0f,count);
asc_add_scalar_sync(d,d,.00013f,count);
asc_mul_sync(p,p,d,count);
asc_max_sync(u,u,p,count);
asc_set_mask_norm();
asc_set_vector_mask(~uint64_t(0),~uint64_t(0));
asc_gt_scalar_sync(refine_mask,u,0.0f,count / 64,1,1,8,8);
asc_sync_notify(PIPE_V,PIPE_S,EVENT_ID0);
asc_sync_wait(PIPE_V,PIPE_S,EVENT_ID0);
for(uint32_t word = 0;word < count / 64;++word){
uint64_t selected =((__ubuf__ uint64_t *)refine_mask)[word];
while(selected){
const uint32_t bit = __builtin_ctzll(selected),i = word * 64 + bit;
((__ubuf__ uint16_t *)out)[i] = PreciseGeluHalf(z[i]);
selected &= selected - 1;
}
}
asc_sync_notify(PIPE_S,PIPE_MTE3,EVENT_ID0);
asc_sync_wait(PIPE_S,PIPE_MTE3,EVENT_ID0);
asc_copy_ub2gm_align(y + uint64_t(row0 + local_row)* N + col,out,rows,nr * 2,0,0,
(BN - Up(nr,16))/ 16,(N - nr)* 2);
asc_sync();
}
ffts_cross_core_sync(PIPE_MTE3,0x21ULL |(uint64_t(DONE)<< 8));
}
prefix += tasks;
start = end;
}
}
}// namespace gmg_base

namespace gmg_b{
constexpr uint32_t BM = 64,BN = 128,BK = 128,VM = 32,VQ = VM * BN;

constexpr int READY = 8,DONE = 9;

__aicore__ inline uint32_t Min(uint32_t a,uint32_t b){return a < b ? a : b;}

__aicore__ inline uint32_t Up(uint32_t x,uint32_t a){return(x + a - 1)/ a * a;}

__aicore__ inline uint16_t PreciseGeluHalf(float z){return fast_gmg::PreciseGeluHalfLeaf(z);}

__aicore__ inline void ZeroL1(__cbuf__ int8_t *p,uint32_t bytes){
asc_fill_value_config cfg;
cfg.config = 0;
cfg.repeat = 1;
cfg.blk_num = bytes / 32;
cfg.dst_gap = 0;
asc_fill_l1_sync((__cbuf__ uint16_t *)p,uint32_t(0),cfg);
}

template <uint32_t TM,uint32_t TK,bool ADAPT = false>
__aicore__ inline void Cube(__gm__ int8_t *x,__gm__ int8_t *w,__gm__ int64_t *groups,__gm__ int32_t *scratch,
uint32_t E,uint32_t K,uint32_t N,uint32_t workers){
constexpr uint32_t BM = TM,BK = TK;
__cbuf__ int8_t *a1 =(__cbuf__ int8_t *)0;
__cbuf__ int8_t *b1 =(__cbuf__ int8_t *)(BM * BK);
__ca__ int8_t *a0 =(__ca__ int8_t *)0;
__cb__ int8_t *b0 =(__cb__ int8_t *)0;
__cc__ int32_t *c0 =(__cc__ int32_t *)0;
const uint32_t worker = asc_get_block_idx(),nt =(N + BN - 1)/ BN;
__gm__ int32_t *slot = scratch + uint64_t(worker)* BM * BN;
uint32_t start = 0,prefix = 0;
for(uint32_t e = 0;e < E;++e){
const uint32_t end = static_cast<uint32_t>(groups[e]),me = end - start;
const uint32_t BM = ADAPT && me <= 32 ? 32 : TM;
const uint32_t tasks =((me + BM - 1)/ BM)* nt;
const uint32_t first =(worker + workers - prefix % workers)% workers;
for(uint32_t task = first;task < tasks;task += workers){
const uint32_t row = start +(task / nt)* BM,col =(task % nt)* BN;
const uint32_t mr = Min(BM,end - row),nr = Min(BN,N - col);
const uint32_t mp = Up(mr,16),np = Up(nr,32);
for(uint32_t k0 = 0;k0 < K;k0 += BK){
const uint32_t kr = Min(BK,K - k0),kp = Up(kr,32);
ZeroL1(a1,BM *(ADAPT ? kp : BK));
ZeroL1(b1,(ADAPT ? kp : BK)* BN);
asc_copy_gm2l1_nd2nz_sync(a1,x + uint64_t(row)* K + k0,1,mr,kr,0,K,BM,1,0);
asc_copy_gm2l1_nd2nz_sync(b1,w +(uint64_t(e)* K + k0)* N + col,1,kr,nr,0,N,kp,1,0);
for(uint32_t mi = 0;mi < mp / 16;++mi)
asc_copy_l12l0a_sync(a0 + mi * kp * 16,a1 + mi * 512,0,kp / 32,BM / 16,0);
for(uint32_t ki = 0;ki < kp / 32;++ki)
asc_copy_l12l0b_trans_sync(
b0 + ki * np * 32,b1 + ki * 1024,0,np / 32,kp / 32,1,false,uint64_t(0));
asc_mmad_sync(c0,a0,b0,mp,kp,np,0,false,false,k0 == 0);
}
asc_set_l0c_copy_params(1,0,0);
asc_copy_l0c2gm_sync(slot,c0,np,mr,BN,mp,0,0,0,false,true);
ffts_cross_core_sync(PIPE_FIX,0x21ULL |(uint64_t(READY)<< 8));
asc_sync_block_wait(DONE);
}
prefix += tasks;
start = end;
}
}

template <uint32_t TM,bool ADAPT = false>
__aicore__ inline void Vector(__gm__ float *scale,__gm__ int64_t *groups,__gm__ half *y,__gm__ int32_t *scratch,
uint32_t E,uint32_t N,uint32_t workers){
constexpr uint32_t BM = TM,VM = TM / 2,VQ = VM * BN;
__ubuf__ int32_t *c =(__ubuf__ int32_t *)0;
__ubuf__ float *z =(__ubuf__ float *)(4 * VQ);
__ubuf__ float *u =(__ubuf__ float *)(8 * VQ);
__ubuf__ float *t =(__ubuf__ float *)(12 * VQ);
__ubuf__ float *d =(__ubuf__ float *)(16 * VQ);
__ubuf__ float *p =(__ubuf__ float *)(20 * VQ);
__ubuf__ float *s =(__ubuf__ float *)(24 * VQ);
__ubuf__ half *out =(__ubuf__ half *)(24 * VQ + 4 * BN);
__ubuf__ uint8_t *refine_mask =(__ubuf__ uint8_t *)(26 * VQ + 4 * BN);
const uint32_t worker = asc_get_block_idx(),sub = asc_get_sub_block_id();
const uint32_t nt =(N + BN - 1)/ BN;
__gm__ int32_t *slot = scratch + uint64_t(worker)* BM * BN;
uint32_t start = 0,prefix = 0;
for(uint32_t e = 0;e < E;++e){
const uint32_t end = static_cast<uint32_t>(groups[e]),me = end - start;
const uint32_t BM = ADAPT && me <= 32 ? 32 : TM,VM = BM / 2;
const uint32_t tasks =((me + BM - 1)/ BM)* nt;
const uint32_t first =(worker + workers - prefix % workers)% workers;
for(uint32_t task = first;task < tasks;task += workers){
const uint32_t row0 = start +(task / nt)* BM,col =(task % nt)* BN;
const uint32_t mr = Min(BM,end - row0),nr = Min(BN,N - col);
const uint32_t local_row = sub * VM;
const uint32_t rows = mr > local_row ? Min(VM,mr - local_row): 0;
asc_sync_block_wait(READY);
if(rows){
const uint32_t count = rows * BN,np = Up(nr,32);
asc_duplicate_sync(c,int32_t(0),count);
asc_copy_gm2ub_align(c,slot + local_row * BN,rows,np * 4,0,0,(BN - np)* 4,(BN - np)/ 8);
asc_sync();
asc_duplicate_sync(s,0.0f,BN);
asc_copy_gm2ub_align_sync(s,scale + uint64_t(e)* N + col,nr * 4);
asc_int322float_rn_sync(z,c,count);
for(uint32_t r = 0;r < rows;++r)
asc_mul_sync(z + r * BN,z + r * BN,s,BN);
asc_mul_sync(u,z,z,count);
asc_mul_sync(u,u,z,count);
asc_mul_scalar_sync(u,u,.044715f,count);
asc_add_sync(u,u,z,count);
asc_mul_scalar_sync(u,u,.7978846f,count);
asc_abs_sync(t,u,count);
asc_mul_scalar_sync(t,t,-2.0f,count);
asc_exp_sync(t,t,count);
asc_add_scalar_sync(d,t,1.0f,count);
asc_min_scalar_sync(u,z,0.0f,count);
asc_mul_sync(u,u,t,count);
asc_max_scalar_sync(p,z,0.0f,count);
asc_add_sync(p,p,u,count);
asc_div_sync(p,p,d,count);
asc_float2half_rn_sync(out,p,count);
asc_abs_sync(t,p,count);
asc_mul_scalar_sync(t,t,2e-5f,count);
asc_add_scalar_sync(t,t,1e-10f,count);
asc_sub_sync(u,p,t,count);
asc_add_sync(d,p,t,count);
asc_float2half_rn_sync((__ubuf__ half *)c,u,count);
asc_float2half_rn_sync(((__ubuf__ half *)c)+ VQ,d,count);
asc_abs_sync(t,z,count);
asc_add_scalar_sync(u,t,-2.0f,count);
asc_mul_scalar_sync(d,t,-1.0f,count);
asc_add_scalar_sync(d,d,8.0f,count);
asc_mul_sync(u,u,d,count);
asc_add_scalar_sync(p,t,-2e-8f,count);
asc_mul_scalar_sync(d,t,-1.0f,count);
asc_add_scalar_sync(d,d,.00013f,count);
asc_mul_sync(p,p,d,count);
asc_max_sync(u,u,p,count);
asc_set_mask_norm();
asc_set_vector_mask(~uint64_t(0),~uint64_t(0));
asc_ne_sync(refine_mask,(__ubuf__ half *)c,((__ubuf__ half *)c)+ VQ,count / 128,1,1,1,8,8,8);
asc_gt_scalar_sync(refine_mask + VQ / 8,u,0.0f,count / 64,1,1,8,8);
asc_sync_notify(PIPE_V,PIPE_S,EVENT_ID0);
asc_sync_wait(PIPE_V,PIPE_S,EVENT_ID0);
for(uint32_t word = 0;word < count / 64;++word){
uint64_t selected =((__ubuf__ uint64_t *)refine_mask)[word];
selected &=((__ubuf__ uint64_t *)(refine_mask + VQ / 8))[word];
while(selected){
const uint32_t bit = __builtin_ctzll(selected),i = word * 64 + bit;
((__ubuf__ uint16_t *)out)[i] = PreciseGeluHalf(z[i]);
selected &= selected - 1;
}
}
asc_sync_notify(PIPE_S,PIPE_MTE3,EVENT_ID0);
asc_sync_wait(PIPE_S,PIPE_MTE3,EVENT_ID0);
asc_copy_ub2gm_align(y + uint64_t(row0 + local_row)* N + col,out,rows,nr * 2,0,0,
(BN - Up(nr,16))/ 16,(N - nr)* 2);
asc_sync();
}
ffts_cross_core_sync(PIPE_MTE3,0x21ULL |(uint64_t(DONE)<< 8));
}
prefix += tasks;
start = end;
}
}
}// namespace gmg_b

__global__ __mix__(1,2)void grouped_matmul_gelu_base(__gm__ int8_t *x,__gm__ int8_t *weight,__gm__ float *scale,
__gm__ int64_t *groups,__gm__ half *y,__gm__ int32_t *scratch,uint32_t E,uint32_t K,uint32_t N,
uint32_t workers,uint64_t sync_base){
set_ffts_base_addr(sync_base);
asc_init();
if ASC_IS_AIC{
gmg_base::Cube(x,weight,groups,scratch,E,K,N,workers);
}
if ASC_IS_AIV{
gmg_base::Vector(scale,groups,y,scratch,E,N,workers);
}
asc_sync();
}

__global__ __mix__(1,2)void grouped_matmul_gelu_b(__gm__ int8_t *x,__gm__ int8_t *weight,__gm__ float *scale,
__gm__ int64_t *groups,__gm__ half *y,__gm__ int32_t *scratch,uint32_t E,uint32_t K,uint32_t N,
uint32_t workers,uint64_t sync_base){
set_ffts_base_addr(sync_base);
asc_init();
if ASC_IS_AIC{
gmg_b::Cube<64,512,true>(x,weight,groups,scratch,E,K,N,workers);
}
if ASC_IS_AIV{
gmg_b::Vector<64,true>(scale,groups,y,scratch,E,N,workers);
}
asc_sync();
}

namespace gmg_an{

__aicore__ inline uint16_t PreciseGeluHalf(float z){return fast_gmg::PreciseGeluHalfLeaf(z);}

__aicore__ inline float ScalarDequant(int32_t c,float scale){
union{
float f;
uint32_t u;
}s,r;
s.f = scale;
const uint32_t sign =((s.u >> 31)^(c < 0))<< 31;
if(!c || !(s.u & 0x7fffffffU)){
r.u = sign;
return r.f;
}
const uint32_t ef =(s.u >> 23)& 255;
const uint64_t mant =(s.u & 0x7fffffU)|(ef ? 0x800000U : 0);
const uint64_t product = uint64_t(c < 0 ? -c : c)* mant;
const int top = 63 - __builtin_clzll(product),power = ef ? int(ef)- 150 : -149;
int exponent = top + power;
if(exponent < -126){
r.u = sign | uint32_t(product <<(power + 149));
return r.f;
}
const uint32_t shift = uint32_t(top - 23);
uint64_t rounded = product >> shift;
if(shift){
const uint64_t remainder = product &((1ULL << shift)- 1),mid = 1ULL <<(shift - 1);
rounded +=(remainder > mid ||(remainder == mid &&(rounded & 1)));
}
if(rounded ==(1ULL << 24)){
rounded >>= 1;
++exponent;
}
r.u = sign |(uint32_t(exponent + 127)<< 23)|(uint32_t(rounded)& 0x7fffffU);
return r.f;
}

__aicore__ inline uint16_t ScalarNormalHalf(float value){
union{
float f;
uint32_t u;
}b;
b.f = value;
const uint32_t sign =(b.u >> 16)& 0x8000U;
uint32_t code =((((b.u >> 23)& 255)- 112)<< 10)|((b.u >> 13)& 1023);
const uint32_t remainder = b.u & 8191;
code +=(remainder > 4096 ||(remainder == 4096 &&(code & 1)));
return uint16_t(sign | code);
}

__aicore__ inline uint16_t ScalarGelu(float z){
union{
float f;
uint32_t u;
}bits,ab;
bits.f = z;
ab.u = bits.u & 0x7fffffffU;
const float a = ab.f;
if(a < 2e-8f)
return uint16_t(bits.u >> 16)& 0x8000U;
if(a >= 8.0f)
return z > 0 ? ScalarNormalHalf(z): uint16_t(0x8000U);
if(a < .00013f || a >= 2.0f)
return PreciseGeluHalf(z);
const float u =(z * z)* .25f;
float p = -6.276196e-5f;
p = p * u +(.00042200374f);
p = p * u +(-.0012744827f);
p = p * u +(.0020808585f);
p = p * u +(-.00074650644f);
p = p * u +(-.0072786743f);
p = p * u +(.030176412f);
p = p * u +(-.07955691f);
p = p * u +(.16322513f);
p = p * u +(-.26727793f);
p = p * u +(.3989423f);
return ScalarNormalHalf(z *(.5f + z * p));
}
}// namespace gmg_an

namespace gmg_dn{
constexpr uint32_t BM = 64,BN = 128,BK = 128,VM = 32,VQ = VM * BN;

constexpr int READY = 8,DONE = 9;

__aicore__ inline uint32_t Min(uint32_t a,uint32_t b){return a < b ? a : b;}

__aicore__ inline uint32_t Up(uint32_t x,uint32_t a){return(x + a - 1)/ a * a;}

__aicore__ inline uint16_t PreciseGeluHalf(float z){return fast_gmg::PreciseGeluHalfLeaf(z);}

__aicore__ inline void ZeroL1(__cbuf__ int8_t *p,uint32_t bytes){
asc_fill_value_config cfg;
cfg.config = 0;
cfg.repeat = 1;
cfg.blk_num = bytes / 32;
cfg.dst_gap = 0;
asc_fill_l1_sync((__cbuf__ uint16_t *)p,uint32_t(0),cfg);
}

__aicore__ inline void CubeUnified(__gm__ int8_t *x,__gm__ int8_t *w,__gm__ int64_t *groups,__gm__ int32_t *scratch,
uint32_t cfg,uint32_t K,uint32_t N,uint32_t workers){
constexpr bool TailZero = true;
const bool CacheWeights = bool(cfg & 0x10000000U);
const uint32_t full_kp = Up(K,32);
const bool Pipeline = bool(cfg & 0x40000000U);
const uint32_t E = cfg & 255U,mlog =(cfg >> 12)& 15U,nlog =(cfg >> 8)& 7U;
const uint32_t BM = 1U << mlog,BN = 1U << nlog;
const uint32_t BK = BN == 32 ?(K <= 128 ? 128 : 256):(K < 256 ? 256 :(BN == 64 ? 1024 : 512));
__cbuf__ int8_t *a1 =(__cbuf__ int8_t *)0;
__cbuf__ int8_t *b1 =(__cbuf__ int8_t *)static_cast<uint64_t>(BM * BK);
__ca__ int8_t *a0 =(__ca__ int8_t *)0;
__cb__ int8_t *b0 =(__cb__ int8_t *)0;
__cc__ int32_t *c0 =(__cc__ int32_t *)0;
const uint32_t worker = asc_get_block_idx(),nt =(N + BN - 1)>> nlog;
__gm__ int32_t *slots = scratch + uint64_t(worker)* BM * BN *(Pipeline ? 2 : 1);
uint32_t ticket = 0;
uint32_t start = 0,prefix = 0;
for(uint32_t e = 0;e < E;++e){
const uint32_t end = static_cast<uint32_t>(groups[e]),me = end - start;
const uint32_t mt =(me + BM - 1)>> mlog,tasks = mt * nt;
const uint32_t first =(worker + workers - prefix % workers)% workers;
uint32_t task_begin = first,task_end = tasks,task_step = workers;
if(CacheWeights){
const uint32_t q = tasks / workers,r = tasks % workers;
task_begin = first * q + Min(first,r);
task_end = task_begin + q +(first < r);
task_step = 1;
}
uint32_t last_col = ~0U;
for(uint32_t task = task_begin;task < task_end;task += task_step){
if(Pipeline && ticket >= 2){
if(ticket & 1)
asc_sync_block_wait(DONE + 2);
else
asc_sync_block_wait(DONE);
}
__gm__ int32_t *slot = slots +(Pipeline ?(ticket & 1)* BM * BN : 0);
const uint32_t row = start +((CacheWeights ? task % mt : task / nt)<< mlog);
const uint32_t col =(CacheWeights ? task / mt : task % nt)* BN;
const uint32_t mr = Min(BM,end - row),nr = Min(BN,N - col);
const uint32_t mp = Up(mr,16),np = Up(nr,32);
const bool new_column = col != last_col;
if(CacheWeights && new_column){
const uint32_t padded_n = nr % 32 ? 1 : 0,nblocks = np / 32;
if(padded_n)
ZeroL1(b1 +(np - 32)* full_kp,full_kp * 32);
if(K % 32){
for(uint32_t nb = 0;nb < nblocks - padded_n;++nb)
ZeroL1(b1 + nb * full_kp * 32 +(full_kp - 32)* 32,1024);
}
asc_copy_gm2l1_nd2nz_sync(b1,w + uint64_t(e)* K * N + col,1,K,nr,0,N,full_kp,1,0);
last_col = col;
}
for(uint32_t k0 = 0;k0 < K;k0 += BK){
const uint32_t kr = Min(BK,K - k0),kp = Up(kr,32);
if(!TailZero || mr % 16 || kr % 32)
ZeroL1(a1,BM * BK);
if(!CacheWeights &&(!TailZero || nr % 32 || kr % 32))
ZeroL1(b1,BK * BN);
asc_copy_gm2l1_nd2nz_sync(a1,x + uint64_t(row)* K + k0,1,mr,kr,0,K,BM,1,0);
if(!CacheWeights)
asc_copy_gm2l1_nd2nz_sync(b1,w +(uint64_t(e)* K + k0)* N + col,1,kr,nr,0,N,kp,1,0);
for(uint32_t mi = 0;mi < mp / 16;++mi)
asc_copy_l12l0a_sync(a0 + mi * kp * 16,a1 + mi * 512,0,kp / 32,BM / 16,0);
if(!CacheWeights || new_column || K > BK){
for(uint32_t ki = 0;ki < kp / 32;++ki)
asc_copy_l12l0b_trans_sync(b0 + ki * np * 32,b1 +(CacheWeights ? k0 * 32 : 0)+ ki * 1024,0,
np / 32,(CacheWeights ? full_kp : kp)/ 32,1,false,uint64_t(0));
}
asc_mmad_sync(c0,a0,b0,mp,kp,np,0,false,false,k0 == 0);
}
asc_set_l0c_copy_params(1,0,0);
asc_copy_l0c2gm_sync(slot,c0,np,mr,BN,mp,0,0,0,false,true);
if(Pipeline &&(ticket & 1))
ffts_cross_core_sync(PIPE_FIX,0x21ULL |(uint64_t(READY + 2)<< 8));
else
ffts_cross_core_sync(PIPE_FIX,0x21ULL |(uint64_t(READY)<< 8));
if(!Pipeline)
asc_sync_block_wait(DONE);
++ticket;
}
prefix += tasks;
start = end;
}
if(Pipeline && ticket){
asc_sync_block_wait(DONE);
if(ticket >= 2)
asc_sync_block_wait(DONE + 2);
}
}

__aicore__ inline void VectorUnified(__gm__ int8_t *x,__gm__ int8_t *w,__gm__ float *scale,__gm__ int64_t *groups,
__gm__ half *y,__gm__ int32_t *scratch,uint32_t cfg,uint32_t N,uint32_t workers){
constexpr uint32_t VQ = 4096;
constexpr bool Filter = true;
const bool Pipeline = bool(cfg & 0x40000000U);
const bool VectorOnly = bool(cfg & 0x20000000U);
const bool CacheWeights = bool(cfg & 0x10000000U);
const uint32_t E = cfg & 255U,nlog =(cfg >> 8)& 7U,mlog =(cfg >> 12)& 15U;
const uint32_t BN = 1U << nlog,BM = 1U << mlog,VM = BM / 2;
__ubuf__ int32_t *c =(__ubuf__ int32_t *)0;
__ubuf__ float *z =(__ubuf__ float *)(4 * VQ);
__ubuf__ float *u =(__ubuf__ float *)(8 * VQ);
__ubuf__ float *t =(__ubuf__ float *)(12 * VQ);
__ubuf__ float *d =(__ubuf__ float *)(16 * VQ);
__ubuf__ float *p =(__ubuf__ float *)(20 * VQ);
__ubuf__ float *s =(__ubuf__ float *)(24 * VQ);
__ubuf__ half *out =(__ubuf__ half *)(24 * VQ + 512);
__ubuf__ uint8_t *refine_mask =(__ubuf__ uint8_t *)(26 * VQ + 512);
__ubuf__ uint64_t *refined_mask =(__ubuf__ uint64_t *)110592;
__ubuf__ uint16_t *refined =(__ubuf__ uint16_t *)110624;
__ubuf__ int8_t *raw_x =(__ubuf__ int8_t *)111136;
__ubuf__ uint32_t *precise_keys =(__ubuf__ uint32_t *)114688;
__ubuf__ uint16_t *precise_results =(__ubuf__ uint16_t *)116736;
if(!VectorOnly)
asc_duplicate_sync((__ubuf__ int32_t *)precise_keys,int32_t(0x7fc00000),512);
const uint32_t worker = asc_get_block_idx(),sub = asc_get_sub_block_id();
const uint32_t sw = VectorOnly ? 2 * worker + sub : worker;
const uint32_t nw = VectorOnly ? 2 * workers : workers;
const uint32_t nt = VectorOnly ? 1 :(N + BN - 1)>> nlog;
__gm__ int32_t *slots = scratch;
if(!VectorOnly)
slots += uint64_t(worker)* BM * BN *(Pipeline ? 2 : 1);
uint32_t ticket = 0,start = 0,prefix = 0;
for(uint32_t e = 0;e < E;++e){
const uint32_t end = uint32_t(groups[e]),me = end - start;
const uint32_t mt =(me + BM - 1)>> mlog,tasks = mt * nt;
const uint32_t first =(sw + nw - prefix % nw)% nw;
uint32_t task_begin = first,task_end = tasks,task_step = nw;
if(CacheWeights){
const uint32_t q = tasks / nw,r = tasks % nw;
task_begin = first * q + Min(first,r);
task_end = task_begin + q +(first < r);
task_step = 1;
}
int32_t previous_key = -1;
uint16_t previous_result = 0;
if(VectorOnly && first < tasks){
refined_mask[0] = 0;
refined_mask[1] = 0;
refined_mask[2] = 0;
refined_mask[3] = 0;
}
for(uint32_t task = task_begin;task < task_end;task += task_step){
__gm__ int32_t *slot = slots;
if(!VectorOnly && Pipeline)
slot +=(ticket & 1)* BM * BN;
const uint32_t row0 = start +((CacheWeights ? task % mt : task / nt)<< mlog);
const uint32_t col =(CacheWeights ? task / mt : task % nt)* BN;
const uint32_t mr = Min(BM,end - row0),nr = Min(BN,N - col);
const uint32_t local_row = VectorOnly ? 0 : sub * VM;
const uint32_t rows = mr > local_row ? Min(VectorOnly ? BM : VM,mr - local_row): 0;
if(!VectorOnly){
if(Pipeline &&(ticket & 1))
asc_sync_block_wait(READY + 2);
else
asc_sync_block_wait(READY);
}
if(rows){
const uint32_t count = Up(rows * BN,128),np = Up(nr,32);
if(VectorOnly){
asc_duplicate_sync((__ubuf__ int32_t *)raw_x,int32_t(0),count / 4);
asc_copy_gm2ub_align_sync(raw_x,x + row0,rows);
asc_int82half_sync((__ubuf__ half *)z,raw_x,count);
asc_half2int32_rn_sync(c,(__ubuf__ half *)z,count);
asc_mul_scalar_sync(c,c,int32_t(w[e]),count);
}else{
if(!Filter || np != BN || count != rows * BN)
asc_duplicate_sync(c,int32_t(0),count);
asc_copy_gm2ub_align(c,slot + local_row * BN,rows,np * 4,0,0,(BN - np)* 4,(BN - np)/ 8);
asc_sync();
if(!Filter || nr != BN)
asc_duplicate_sync(s,0.0f,BN);
asc_copy_gm2ub_align_sync(s,scale + uint64_t(e)* N + col,nr * 4);
}
asc_int322float_rn_sync(z,c,count);
if(VectorOnly)
asc_mul_scalar_sync(z,z,scale[e],count);
else if(Filter){
asc_set_mask_norm();
asc_set_vector_mask(uint64_t(0),BN == 32 ? uint64_t(0xffffffffULL): ~uint64_t(0));
for(uint32_t col64 = 0;col64 < BN;col64 += 64)
asc_mul(z + col64,z + col64,s + col64,uint8_t(rows),1,1,1,BN / 8,BN / 8,0);
asc_sync();
}else{
for(uint32_t r = 0;r < rows;++r)
asc_mul_sync(z + r * BN,z + r * BN,s,BN);
}
asc_mul_sync(u,z,z,count);
asc_mul_sync(u,u,z,count);
asc_mul_scalar_sync(u,u,.044715f,count);
asc_add_sync(u,u,z,count);
asc_mul_scalar_sync(u,u,.7978846f,count);
asc_abs_sync(t,u,count);
asc_mul_scalar_sync(t,t,-2.0f,count);
asc_exp_sync(t,t,count);
asc_add_scalar_sync(d,t,1.0f,count);
asc_min_scalar_sync(u,z,0.0f,count);
asc_mul_sync(u,u,t,count);
asc_max_scalar_sync(p,z,0.0f,count);
asc_add_sync(p,p,u,count);
asc_div_sync(p,p,d,count);
asc_float2half_rn_sync(out,p,count);
if(Filter){
asc_abs_sync(t,p,count);
asc_mul_scalar_sync(t,t,2e-5f,count);
asc_add_scalar_sync(t,t,1e-10f,count);
asc_sub_sync(u,p,t,count);
asc_add_sync(d,p,t,count);
asc_float2half_rn_sync((__ubuf__ half *)c,u,count);
asc_float2half_rn_sync(((__ubuf__ half *)c)+ VQ,d,count);
}
asc_abs_sync(t,z,count);
asc_add_scalar_sync(u,t,-2.0f,count);
asc_mul_scalar_sync(d,t,-1.0f,count);
asc_add_scalar_sync(d,d,8.0f,count);
asc_mul_sync(u,u,d,count);
asc_add_scalar_sync(p,t,-2e-8f,count);
asc_mul_scalar_sync(d,t,-1.0f,count);
asc_add_scalar_sync(d,d,.00013f,count);
asc_mul_sync(p,p,d,count);
asc_max_sync(u,u,p,count);
asc_set_mask_norm();
asc_set_vector_mask(~uint64_t(0),~uint64_t(0));
if(Filter){
asc_ne_sync(
refine_mask,(__ubuf__ half *)c,((__ubuf__ half *)c)+ VQ,count / 128,1,1,1,8,8,8);
asc_gt_scalar_sync(refine_mask + VQ / 8,u,0.0f,count / 64,1,1,8,8);
asc_and_sync((__ubuf__ uint16_t *)refine_mask,(__ubuf__ uint16_t *)refine_mask,
(__ubuf__ uint16_t *)(refine_mask + VQ / 8),count / 16);
}else{
asc_gt_scalar_sync(refine_mask,u,0.0f,count / 64,1,1,8,8);
}
asc_sync_notify(PIPE_V,PIPE_S,EVENT_ID0);
asc_sync_wait(PIPE_V,PIPE_S,EVENT_ID0);
for(uint32_t word = 0;word < count / 64;++word){
uint64_t selected =((__ubuf__ uint64_t *)refine_mask)[word];
while(selected){
const uint32_t bit = __builtin_ctzll(selected),i = word * 64 + bit;
uint16_t result = 0;
uint32_t key = 0,precise_index = 0,precise_word = 0;
bool hit = false;
if(VectorOnly){
key = uint32_t(int32_t(raw_x[i])+ 128);
if(int32_t(key)== previous_key){
result = previous_result;
hit = true;
}else if(refined_mask[key >> 6] &(uint64_t(1)<<(key & 63))){
result = refined[key];
hit = true;
}
}else{
union{
float f;
uint32_t u;
}zbits;
zbits.f = z[i];
precise_word = zbits.u;
precise_index =(precise_word * 0x9e3779b1U)>> 23;
if(precise_keys[precise_index] == precise_word){
result = precise_results[precise_index];
hit = true;
}
}
if(!hit){
result = PreciseGeluHalf(z[i]);
if(VectorOnly){
refined[key] = result;
refined_mask[key >> 6] |= uint64_t(1)<<(key & 63);
}else{
precise_results[precise_index] = result;
precise_keys[precise_index] = precise_word;
}
}
if(VectorOnly){
previous_key = int32_t(key);
previous_result = result;
}
((__ubuf__ uint16_t *)out)[i] = result;
selected &= selected - 1;
}
}
asc_sync_notify(PIPE_S,PIPE_MTE3,EVENT_ID0);
asc_sync_wait(PIPE_S,PIPE_MTE3,EVENT_ID0);
if(VectorOnly)
asc_copy_ub2gm_align_sync(y + row0,out,rows * 2);
else{
asc_copy_ub2gm_align(y + uint64_t(row0 + local_row)* N + col,out,rows,nr * 2,0,0,
(BN - Up(nr,16))/ 16,(N - nr)* 2);
asc_sync();
}
}
if(!VectorOnly){
if(Pipeline &&(ticket & 1))
ffts_cross_core_sync(PIPE_MTE3,0x21ULL |(uint64_t(DONE + 2)<< 8));
else
ffts_cross_core_sync(PIPE_MTE3,0x21ULL |(uint64_t(DONE)<< 8));
}
++ticket;
}
prefix += tasks;
start = end;
}
if(VectorOnly)
ffts_cross_core_sync(PIPE_MTE3,0x21ULL |(uint64_t(12)<< 8));
}
}// namespace gmg_dn

__vector__ __global__ __aicore__ void grouped_matmul_gelu_an_scalar(__gm__ int8_t *x,__gm__ int8_t *weight,
__gm__ float *scale,__gm__ int64_t *groups,__gm__ half *y,uint32_t E,uint32_t K){
asc_init();
uint32_t lo = 0,hi = E;
while(lo < hi){
const uint32_t mid = lo +(hi - lo)/ 2;
if(groups[mid] == 0)
lo = mid + 1;
else
hi = mid;
}
int32_t c = 0;
for(uint32_t k = 0;k < K;++k)
c += int32_t(x[k])* int32_t(weight[uint64_t(lo)* K + k]);
((__gm__ uint16_t *)y)[0] = gmg_an::ScalarGelu(gmg_an::ScalarDequant(c,scale[lo]));
asc_sync();
}

__global__ __mix__(1,2)void grouped_matmul_gelu_dn(__gm__ int8_t *x,__gm__ int8_t *weight,__gm__ float *scale,
__gm__ int64_t *groups,__gm__ half *y,__gm__ int32_t *scratch,uint32_t cfg,uint32_t K,uint32_t N,
uint32_t workers,uint64_t sync_base){
set_ffts_base_addr(sync_base);
asc_init();
if ASC_IS_AIC{
if(cfg & 0x20000000U)
asc_sync_block_wait(12);
else
gmg_dn::CubeUnified(x,weight,groups,scratch,cfg,K,N,workers);
}
if ASC_IS_AIV{
gmg_dn::VectorUnified(x,weight,scale,groups,y,scratch,cfg,N,workers);
}
asc_sync();
}

namespace d6_density{
using namespace cp6_index37;

static __aicore__ __attribute__((noinline))uint32_t GeluDense(__ubuf__ float *z,__ubuf__ float *u,__ubuf__ float *t,
__ubuf__ float *d,__ubuf__ float *p,__ubuf__ half *out,__ubuf__ uint8_t *refine_mask,uint32_t count,
uint32_t nr,uint32_t bn,uint32_t ready){
__ubuf__ half *packed_out =(__ubuf__ half *)(d + 4096);
__ubuf__ uint8_t *margin_mask =(__ubuf__ uint8_t *)d;
__ubuf__ uint8_t *tiny_mask =(__ubuf__ uint8_t *)d + 2048;
asc_mul(u,z,z,count);
asc_sync_pipe(PIPE_V);
asc_mul(u,u,z,count);
asc_sync_pipe(PIPE_V);
asc_mul_scalar(u,u,.044715f,count);
asc_sync_pipe(PIPE_V);
asc_add(u,u,z,count);
asc_sync_pipe(PIPE_V);
asc_mul_scalar(u,u,.7978846f,count);
asc_sync_pipe(PIPE_V);
asc_mul_scalar(t,u,-2.0f,count);
asc_sync_pipe(PIPE_V);
asc_min_scalar(t,t,8e1f,count);
asc_sync_pipe(PIPE_V);
asc_exp(t,t,count);
asc_sync_pipe(PIPE_V);
asc_add_scalar(d,t,1.0f,count);
asc_sync_pipe(PIPE_V);
asc_div(p,z,d,count);
asc_sync_pipe(PIPE_V);
asc_float2half_rn(out,p,count);
asc_sync_pipe(PIPE_V);
asc_sync_notify(PIPE_V,PIPE_S,EVENT_ID1);
asc_sync_wait(PIPE_V,PIPE_S,EVENT_ID1);
return ready;
}

static __aicore__ __attribute__((noinline))uint32_t Gelu(__ubuf__ float *z,__ubuf__ float *u,__ubuf__ float *t,
__ubuf__ float *d,__ubuf__ float *p,__ubuf__ half *out,__ubuf__ uint8_t *mask,uint32_t count,uint32_t nr,
uint32_t bn,uint32_t ready){
return GeluDense(z,u,t,d,p,out,mask,count,nr,bn,ready);
}
}// namespace d6_density

namespace dfocus{
using cp6_gmg_opt::Min;

using cp6_gmg_opt::Up;

constexpr uint32_t VQ = 8192,READY = 8,DONE = 9,FINAL = 12;

__aicore__ inline void LR(uint32_t s,bool wait){
if(!s){
if(wait)
asc_sync_wait(PIPE_MTE1,PIPE_M,EVENT_ID0);
else
asc_sync_notify(PIPE_MTE1,PIPE_M,EVENT_ID0);
}else{
if(wait)
asc_sync_wait(PIPE_MTE1,PIPE_M,EVENT_ID2);
else
asc_sync_notify(PIPE_MTE1,PIPE_M,EVENT_ID2);
}
}

__aicore__ inline void LF(uint32_t s,bool wait){
if(!s){
if(wait)
asc_sync_wait(PIPE_M,PIPE_MTE1,EVENT_ID1);
else
asc_sync_notify(PIPE_M,PIPE_MTE1,EVENT_ID1);
}else{
if(wait)
asc_sync_wait(PIPE_M,PIPE_MTE1,EVENT_ID3);
else
asc_sync_notify(PIPE_M,PIPE_MTE1,EVENT_ID3);
}
}

template <uint32_t BN,uint32_t SR = 16384 / BN>
__aicore__ inline void Store(__cc__ int32_t *c,__gm__ int32_t *scratch,uint32_t worker,uint32_t mr,uint32_t mp,
uint32_t np,uint32_t &ordinal){
constexpr uint32_t sr = SR;
asc_set_l0c_copy_params(1,0,0);
for(uint32_t r = 0;r < mr;r += sr){
const uint32_t s = ordinal % 2;
if(ordinal >= 2)
asc_sync_block_wait(DONE + 2 * s);
asc_copy_l0c2gm_sync(scratch +(uint64_t(worker)* 2 + s)* 16384,c + r * 16,np,Min(sr,mr - r),BN,mp,0,
0,0,false,true);
ffts_cross_core_sync(PIPE_FIX,0x21ULL |(uint64_t(READY + 2 * s)<< 8));
++ordinal;
}
asc_sync_notify(PIPE_FIX,PIPE_M,EVENT_ID6);
asc_sync_wait(PIPE_FIX,PIPE_M,EVENT_ID6);
}

__aicore__ inline void Drain(uint32_t ordinal){
for(uint32_t i = ordinal > 2 ? ordinal - 2 : 0;i < ordinal;++i)
asc_sync_block_wait(DONE + 2 *(i % 2));
asc_sync_block_wait(FINAL);
}

template <uint32_t BN,uint32_t SR = 16384 / BN>
__aicore__ inline uint32_t VecTile(__gm__ float *scale,__gm__ half *y,__gm__ int32_t *scratch,uint32_t worker,
uint32_t sub,uint32_t e,uint32_t row,uint32_t col,uint32_t mr,uint32_t nr,uint32_t N,uint32_t &ordinal,
uint32_t idx){
constexpr uint32_t sr = SR;
__ubuf__ int32_t *c =(__ubuf__ int32_t *)0;
__ubuf__ float *z =(__ubuf__ float *)0;
__ubuf__ float *u =(__ubuf__ float *)(4 * VQ);
__ubuf__ float *t =(__ubuf__ float *)(8 * VQ);
__ubuf__ float *d =(__ubuf__ float *)(12 * VQ);
__ubuf__ float *p =(__ubuf__ float *)(16 * VQ);
__ubuf__ float *sc =(__ubuf__ float *)(20 * VQ);
__ubuf__ half *out =(__ubuf__ half *)(20 * VQ + 4 * BN);
__ubuf__ uint8_t *mask =(__ubuf__ uint8_t *)(22 * VQ + 4 * BN);
asc_duplicate(sc,0.0f,Up(BN,64));
asc_sync();
asc_copy_gm2ub_align_sync(sc,scale + uint64_t(e)* N + col,nr * 4);
for(uint32_t micro = 0;micro < mr;micro += sr){
const uint32_t tail = Min(sr,mr - micro),split =(tail + 1)/ 2,local = sub * split,
rows = tail > local ? Min(split,tail - local): 0,s = ordinal % 2;
asc_sync_block_wait(READY + 2 * s);
if(rows){
const uint32_t count = Up(rows * BN,64),np = Up(nr,32);
if(np != BN || count != rows * BN){
asc_duplicate(c,int32_t(0),count);
asc_sync();
}
asc_copy_gm2ub_align(c,scratch +(uint64_t(worker)* 2 + s)* 16384 + local * BN,rows,np * 4,0,0,
(BN - np)* 4,(BN - np)/ 8);
asc_sync();
}
ffts_cross_core_sync(PIPE_MTE2,0x21ULL |(uint64_t(DONE + 2 * s)<< 8));
if(rows){
const uint32_t count = Up(rows * BN,64);
asc_int322float_rn_sync(z,c,count);
asc_set_mask_norm();
asc_set_vector_mask(uint64_t(0),BN == 32 ? uint64_t(0xffffffffULL): ~uint64_t(0));
for(uint32_t n = 0;n < BN;n += 64){
if(BN % 64 && BN != 32)
asc_set_vector_mask(uint64_t(0),BN - n < 64 ? uint64_t(0xffffffffULL): ~uint64_t(0));
asc_mul(z + n,z + n,sc + n,uint8_t(rows),1,1,1,BN / 8,BN / 8,0);
}
asc_sync();
asc_set_vector_mask(~uint64_t(0),~uint64_t(0));
idx = d6_density::Gelu(z,u,t,d,p,out,mask,count,nr,BN,idx);
asc_sync_notify(PIPE_S,PIPE_MTE3,EVENT_ID0);
asc_sync_wait(PIPE_S,PIPE_MTE3,EVENT_ID0);
asc_copy_ub2gm_align(y + uint64_t(row + micro + local)* N + col,out,rows,nr * 2,0,0,
(BN - Up(nr,16))/ 16,(N - nr)* 2);
asc_sync();
}
++ordinal;
}
return idx;
}
}// namespace dfocus

namespace dfocus_stream{
using dfocus::Min;

using dfocus::Up;

__aicore__ inline void BR(uint32_t s,bool wait){
if(!s){
if(wait)
asc_sync_wait(PIPE_MTE2,PIPE_MTE1,EVENT_ID4);
else
asc_sync_notify(PIPE_MTE2,PIPE_MTE1,EVENT_ID4);
}else{
if(wait)
asc_sync_wait(PIPE_MTE2,PIPE_MTE1,EVENT_ID5);
else
asc_sync_notify(PIPE_MTE2,PIPE_MTE1,EVENT_ID5);
}
}

__aicore__ inline void BF(uint32_t s,bool wait){
if(!s){
if(wait)
asc_sync_wait(PIPE_MTE1,PIPE_MTE2,EVENT_ID4);
else
asc_sync_notify(PIPE_MTE1,PIPE_MTE2,EVENT_ID4);
}else{
if(wait)
asc_sync_wait(PIPE_MTE1,PIPE_MTE2,EVENT_ID5);
else
asc_sync_notify(PIPE_MTE1,PIPE_MTE2,EVENT_ID5);
}
}

__aicore__ inline void Zero(__cbuf__ int8_t *p,uint32_t bytes){
asc_fill_value_config cfg;
cfg.config = 0;
cfg.repeat = 1;
cfg.blk_num = bytes / 32;
cfg.dst_gap = 0;
asc_fill_l1_sync((__cbuf__ uint16_t *)p,uint32_t(0),cfg);
}

template <uint32_t TM,uint32_t BN,uint32_t BK,uint32_t LK,bool RawW = false>
__aicore__ inline void Prefetch(__gm__ int8_t *x,__gm__ int8_t *w,__cbuf__ int8_t *base,uint32_t e,uint32_t row,
uint32_t col,uint32_t tm,uint32_t mr,uint32_t nr,uint32_t np,uint32_t K,uint32_t N,uint32_t outer,
uint32_t stage,uint32_t actualK = 0,uint32_t actualN = 0){
const uint32_t k0 = outer * BK,kr = Min(BK,K - k0),kp = Up(kr,32),span =(TM + BN)* BK;
__cbuf__ int8_t *a1 = base + stage * span;
__cbuf__ int8_t *b1 = a1 + TM * BK;
if(mr % 16 || kr % 32)
Zero(a1,TM * BK);
if(nr % 32 || kr % 32)
Zero(b1,BN * BK);
asc_copy_gm2l1_nd2nz(a1,x + uint64_t(row)* K + k0,1,mr,kr,0,K,tm,1,0);
if constexpr(RawW){
asc_copy_gm2l1_nd2nz(b1,w +(uint64_t(e)* actualK + k0)* actualN + col,1,Min(kr,actualK - k0),
Min(nr,actualN - col),0,actualN,kp,1,0);
BR(stage,false);
}else{
asc_copy_gm2l1_nd2nz(b1,w +(uint64_t(e)* K + k0)* N + col,1,kr,nr,0,N,kp,1,0);
BR(stage,false);
}
}

template <uint32_t TM,uint32_t BN,uint32_t BK,uint32_t LK,bool RawW = false>
__aicore__ inline void Load(__gm__ int8_t *x,__gm__ int8_t *w,__cbuf__ int8_t *base,__ca__ int8_t *a,
__cb__ int8_t *b,uint32_t e,uint32_t row,uint32_t col,uint32_t tm,uint32_t mr,uint32_t mp,uint32_t nr,
uint32_t np,uint32_t K,uint32_t N,uint32_t micro,uint32_t actualK = 0,uint32_t actualN = 0){
const uint32_t k0 = micro * LK,outer = k0 / BK,inside = k0 % BK,stage = outer % 2,slot = micro % 2,
kr = Min(BK,K - outer * BK),outerkp = Up(kr,32),kp = Up(Min(LK,K - k0),32);
if(!inside)
BR(stage,true);
__cbuf__ int8_t *a1 = base + stage *(TM + BN)* BK;
__cbuf__ int8_t *b1 = a1 + TM * BK;
for(uint32_t mi = 0;mi < mp / 16;++mi)
asc_copy_l12l0a(a + slot * TM * LK + mi * kp * 16,a1 + inside * tm + mi * 512,0,kp / 32,tm / 16,0);
for(uint32_t ni = 0;ni < np / 32;++ni)
asc_copy_l12l0b_trans(b + slot * BN * LK + ni * 1024,b1 +(ni *(outerkp / 32)+ inside / 32)* 1024,0,
kp / 32,1,2 *(np / 32)- 1,false,uint64_t(0));
dfocus::LR(slot,false);
if(inside + kp >= kr && outer + 2 <(K + BK - 1)/ BK){
BF(stage,false);
BF(stage,true);
Prefetch<TM,BN,BK,LK,RawW>(
x,w,base,e,row,col,tm,mr,nr,np,K,N,outer + 2,stage,actualK,actualN);
}
}
}// namespace dfocus_stream

namespace d6_l0{
using cp6_gmg_opt::Min;

__aicore__ inline void Load(__cbuf__ int8_t *a1,__cbuf__ int8_t *b1,__ca__ int8_t *a,__cb__ int8_t *b,uint32_t tm,
uint32_t mp,uint32_t np,uint32_t kp,uint32_t step,uint32_t index){
const uint32_t k0 = index * step,k = Min(step,kp - k0),s = index % 2;
for(uint32_t m = 0;m < mp / 16;++m)
asc_copy_l12l0a(a + s * tm * step + m * k * 16,a1 + k0 * tm + m * 512,0,k / 32,tm / 16,0);
for(uint32_t n = 0;n < np / 32;++n)
asc_copy_l12l0b_trans(b + s * np * step + n * 1024,b1 +(n *(kp / 32)+ k0 / 32)* 1024,0,k / 32,1,
2 *(np / 32)- 1,false,uint64_t(0));
dfocus::LR(s,false);
}

__aicore__ inline void Multiply(__cbuf__ int8_t *a1,__cbuf__ int8_t *b1,__ca__ int8_t *a,__cb__ int8_t *b,
__cc__ int32_t *c,uint32_t tm,uint32_t mp,uint32_t np,uint32_t kp){
const uint32_t width = tm > np ? tm : np;
const uint32_t step = Min(512U,(1024 / width)* 32),total =(kp + step - 1)/ step;
Load(a1,b1,a,b,tm,mp,np,kp,step,0);
for(uint32_t i = 0;i < total;++i){
const uint32_t s = i % 2,k = Min(step,kp - i * step);
dfocus::LR(s,true);
if(i && k == 32)
asc_sync_pipe(PIPE_M);
if(mp < 64 || mp % 32 || np < 64)
asc_mmad_sync(c,a + s * tm * step,b + s * np * step,mp,k,np,0,false,false,i == 0);
else
asc_mmad(c,a + s * tm * step,b + s * np * step,mp,k,np,0,false,false,i == 0);
if(i + 2 < total)
dfocus::LF(s,false);
if(i + 1 < total){
if(i + 1 >= 2)
dfocus::LF((i + 1)% 2,true);
Load(a1,b1,a,b,tm,mp,np,kp,step,i + 1);
}
}
asc_sync();
}
}// namespace d6_l0

namespace unique_tail{
template <bool Allow192>
__aicore__ inline void Store(__cc__ int32_t *c,__gm__ int32_t *scratch,uint32_t worker,uint32_t mr,uint32_t mp,
uint32_t np,uint32_t nr,uint32_t &ordinal){
if(nr <= 32)
dfocus::Store<32>(c,scratch,worker,mr,mp,np,ordinal);
else if(nr <= 64)
dfocus::Store<64>(c,scratch,worker,mr,mp,np,ordinal);
else if(nr <= 128)
dfocus::Store<128>(c,scratch,worker,mr,mp,np,ordinal);
else if(Allow192 && nr <= 192)
dfocus::Store<192,64>(c,scratch,worker,mr,mp,np,ordinal);
else
dfocus::Store<256>(c,scratch,worker,mr,mp,np,ordinal);
}

template <bool Allow192>
__aicore__ inline uint32_t Vec(__gm__ float *scale,__gm__ half *y,__gm__ int32_t *scratch,uint32_t worker,
uint32_t sub,uint32_t e,uint32_t row,uint32_t col,uint32_t mr,uint32_t nr,uint32_t N,uint32_t &ordinal,
uint32_t idx){
if(nr <= 32)
return dfocus::VecTile<32>(scale,y,scratch,worker,sub,e,row,col,mr,nr,N,ordinal,idx);
if(nr <= 64)
return dfocus::VecTile<64>(scale,y,scratch,worker,sub,e,row,col,mr,nr,N,ordinal,idx);
if(nr <= 128)
return dfocus::VecTile<128>(scale,y,scratch,worker,sub,e,row,col,mr,nr,N,ordinal,idx);
if(Allow192 && nr <= 192)
return dfocus::VecTile<192,64>(scale,y,scratch,worker,sub,e,row,col,mr,nr,N,ordinal,idx);
return dfocus::VecTile<256>(scale,y,scratch,worker,sub,e,row,col,mr,nr,N,ordinal,idx);
}
}// namespace unique_tail

namespace unique_hers_global{
using cp6_gmg_opt::Min;

using cp6_gmg_opt::Up;

__aicore__ inline bool PreferGlobal(__gm__ int64_t *groups,uint32_t E,uint32_t N,uint32_t W){
uint32_t end = uint32_t(groups[E - 1]);
const uint32_t nt =(N + 255)/ 256;
for(uint32_t e = E;e > 0;--e){
const uint32_t start = e > 1 ? uint32_t(groups[e - 2]): 0,me = end - start,
tm = me ? Min(128U,Up(me,16)): 16;
if(((me + tm - 1)/ tm)* nt >= W)
return false;
end = start;
}
return true;
}
}// namespace unique_hers_global

namespace d6_ha_owned{
constexpr uint32_t TM = 96,SlotCount = 4;

__aicore__ inline uint32_t RowTiles(__gm__ int64_t *groups,uint32_t E){
uint32_t start = 0,tiles = 0;
for(uint32_t e = 0;e < E;++e){
const uint32_t end = uint32_t(groups[e]);
tiles +=(end - start + TM - 1)/ TM;
start = end;
}
return tiles;
}

struct PanelCursor{
uint32_t expert,start,prefix,tile,col;
};
}// namespace d6_ha_owned

namespace d6_hb_pack{
using dfocus::Min;

using dfocus::Up;

template <uint32_t XRows,uint32_t BRows,uint32_t KAlign,uint32_t NAlign,bool PackW = true>
__aicore__ inline void Prepare(__gm__ int8_t *x,__gm__ int8_t *w,__gm__ int8_t *px,__gm__ int8_t *pw,uint32_t M,
uint32_t E,uint32_t K,uint32_t N,uint32_t W,__gm__ int64_t *groups){
const uint32_t rank = asc_get_block_idx()* 2 + asc_get_sub_block_id(),workers = W * 2;
const uint32_t ka = Up(K,32),na = Up(N,32),kp = Up(K,KAlign),np = Up(N,NAlign);
__ubuf__ int8_t *buf =(__ubuf__ int8_t *)0;
set_mov_pad_val(uint32_t(0));
for(uint32_t row = rank * XRows;row < M;row += workers * XRows){
const uint32_t rows = Min(XRows,M - row);
if(kp != ka)
asc_duplicate_sync((__ubuf__ int32_t *)buf,int32_t(0),rows * kp / 4);
asc_copy_gm2ub_align(buf,x + uint64_t(row)* K,rows,K,0,ka - K,0,(kp - ka)/ 32);
asc_sync();
asc_copy_ub2gm_align_sync(px + uint64_t(row)* kp,buf,rows * kp);
}
if constexpr(PackW){
uint32_t active = 0,activeMask = 0,previous = 0;
for(uint32_t e = 0;e < E;++e){
const uint32_t end = uint32_t(groups[e]);
if(end != previous){
activeMask |= 1U << e;
++active;
}
previous = end;
}
const uint32_t chunks =(kp + BRows - 1)/ BRows;
for(uint32_t task = rank;task < active * chunks;task += workers){
uint32_t e = task / chunks;
if(active != E){
uint32_t mask = activeMask;
for(uint32_t i = 0;i < e;++i)
mask &= mask - 1;
e = uint32_t(__builtin_ctz(mask));
}
const uint32_t row =(task % chunks)* BRows;
const uint32_t rows = Min(BRows,kp - row),valid = row < K ? Min(rows,K - row): 0;
if(np != na)
asc_duplicate_sync((__ubuf__ int32_t *)buf,int32_t(0),rows * np / 4);
else if(valid < rows)
asc_duplicate_sync((__ubuf__ int32_t *)(buf + valid * np),int32_t(0),(rows - valid)* np / 4);
if(valid){
asc_copy_gm2ub_align(buf,w +(uint64_t(e)* K + row)* N,valid,N,0,na - N,0,(np - na)/ 32);
asc_sync();
}
asc_copy_ub2gm_align_sync(pw +(uint64_t(e)* kp + row)* np,buf,rows * np);
}
}
ffts_cross_core_sync(PIPE_MTE3,0x1ULL |(uint64_t(14)<< 8));
asc_sync_block_wait(14);
ffts_cross_core_sync(PIPE_MTE3,0x21ULL |(uint64_t(13)<< 8));
asc_sync();
}
}// namespace d6_hb_pack

namespace d6_hb_tiles{
using dfocus::FINAL;

using dfocus_stream::Load;

using dfocus_stream::Min;

using dfocus_stream::Prefetch;

using dfocus_stream::Up;

template <uint32_t TM,uint32_t BN,uint32_t BK = 1024,uint32_t LK = 256,bool RawW = false>
__aicore__ inline void Cube(__gm__ int8_t *x,__gm__ int8_t *w,__gm__ int64_t *groups,__gm__ int32_t *scratch,
uint32_t E,uint32_t K,uint32_t N,uint32_t W,uint32_t actualN,uint32_t actualK){
const uint32_t worker = asc_get_block_idx(),nt =(actualN + BN - 1)/ BN,total =(K + LK - 1)/ LK,
outers =(K + BK - 1)/ BK;
__cbuf__ int8_t *base =(__cbuf__ int8_t *)0;
__ca__ int8_t *a =(__ca__ int8_t *)0;
__cb__ int8_t *b =(__cb__ int8_t *)0;
__cc__ int32_t *c =(__cc__ int32_t *)0;
uint32_t start = 0,prefix = 0,ordinal = 0;
for(uint32_t e = 0;e < E;++e){
const uint32_t end = uint32_t(groups[e]),me = end - start,tm = me ? Min(Up(me,16),TM): 16,
mt =(me + tm - 1)/ tm,tasks = mt * nt;
const uint32_t rank =(worker + W - prefix % W)% W,q = tasks / W,rem = tasks % W,
begin = rank * q + Min(rank,rem),finish = begin + q +(rank < rem);
for(uint32_t task = begin;task < finish;++task){
const uint32_t row = start +(task % mt)* tm,col =(task / mt)* BN,mr = Min(tm,end - row),
mp = Up(mr,16),nr = Min(BN,Up(actualN - col,32)),np = Up(nr,32);
if(mp < 64){
for(uint32_t k0 = 0;k0 < K;k0 += 256){
const uint32_t kr = Min(256U,K - k0),kp = Up(kr,32);
__cbuf__ int8_t *a1 = base;
__cbuf__ int8_t *b1 = base + TM * 256;
if(mr % 16 || kr % 32)
cp6_gmg_opt::ZeroL1(a1,TM * 256);
if(nr % 32 || kr % 32)
cp6_gmg_opt::ZeroL1(b1,BN * 256);
asc_copy_gm2l1_nd2nz(a1,x + uint64_t(row)* K + k0,1,mr,kr,0,K,tm,1,0);
if constexpr(RawW){
asc_copy_gm2l1_nd2nz(b1,w +(uint64_t(e)* actualK + k0)* actualN + col,1,
Min(kr,actualK - k0),Min(nr,actualN - col),0,actualN,kp,1,0);
asc_sync();
}else{
asc_copy_gm2l1_nd2nz(b1,w +(uint64_t(e)* K + k0)* N + col,1,kr,nr,0,N,kp,1,0);
asc_sync();
}
for(uint32_t mi = 0;mi < mp / 16;++mi)
asc_copy_l12l0a(a + mi * kp * 16,a1 + mi * 512,0,kp / 32,tm / 16,0);
for(uint32_t ni = 0;ni < np / 32;++ni)
asc_copy_l12l0b_trans(b + ni * 1024,b1 + ni *(kp / 32)* 1024,0,kp / 32,1,
2 *(np / 32)- 1,false,uint64_t(0));
asc_sync();
asc_mmad_sync(c,a,b,mp,kp,np,0,false,false,k0 == 0);
}
unique_tail::Store<true>(c,scratch,worker,mr,mp,np,nr,ordinal);
continue;
}
for(uint32_t j = 0;j < Min(2U,outers);++j)
Prefetch<TM,BN,BK,LK,RawW>(x,w,base,e,row,col,tm,mr,nr,np,K,N,j,j,actualK,actualN);
Load<TM,BN,BK,LK,RawW>(x,w,base,a,b,e,row,col,tm,mr,mp,nr,np,K,N,0,actualK,actualN);
for(uint32_t i = 0;i < total;++i){
const uint32_t s = i % 2,kp = Up(Min(LK,K - i * LK),32);
dfocus::LR(s,true);
if(i && kp == 32)
asc_sync_pipe(PIPE_M);
asc_mmad(c,a + s * TM * LK,b + s * BN * LK,mp,kp,np,0,false,false,i == 0);
if(i + 2 < total)
dfocus::LF(s,false);
if(i + 1 < total){
if(i + 1 >= 2)
dfocus::LF((i + 1)% 2,true);
Load<TM,BN,BK,LK,RawW>(
x,w,base,a,b,e,row,col,tm,mr,mp,nr,np,K,N,i + 1,actualK,actualN);
}
}
asc_sync();
unique_tail::Store<true>(c,scratch,worker,mr,mp,np,nr,ordinal);
}
prefix += tasks;
start = end;
}
dfocus::Drain(ordinal);
}

template <uint32_t TM,uint32_t BN,bool ColMajor = true>
__aicore__ inline void Vector(__gm__ float *scale,__gm__ int64_t *groups,__gm__ half *y,__gm__ int32_t *scratch,
uint32_t E,uint32_t N,uint32_t W){
const uint32_t worker = asc_get_block_idx(),sub = asc_get_sub_block_id(),nt =(N + BN - 1)/ BN;
uint32_t start = 0,prefix = 0,ordinal = 0,idx = 0;
for(uint32_t e = 0;e < E;++e){
const uint32_t end = uint32_t(groups[e]),me = end - start,tm = me ? Min(Up(me,16),TM): 16,
mt =(me + tm - 1)/ tm,tasks = mt * nt;
const uint32_t rank =(worker + W - prefix % W)% W,q = tasks / W,rem = tasks % W,
begin = rank * q + Min(rank,rem),finish = begin + q +(rank < rem);
for(uint32_t task = begin;task < finish;++task){
const uint32_t row = start +(ColMajor ? task % mt : task / nt)* tm,
col =(ColMajor ? task / mt : task % nt)* BN;
idx = unique_tail::Vec<true>(
scale,y,scratch,worker,sub,e,row,col,Min(tm,end - row),Min(BN,N - col),N,ordinal,idx);
}
prefix += tasks;
start = end;
}
asc_sync();
ffts_cross_core_sync(PIPE_MTE3,0x21ULL |(uint64_t(FINAL)<< 8));
}
}// namespace d6_hb_tiles

__global__ __mix__(1,2)void grouped_matmul_gelu_df_hb(__gm__ int8_t *x,__gm__ int8_t *w,__gm__ float *scale,
__gm__ int64_t *groups,__gm__ half *y,__gm__ int32_t *scratch,uint32_t E,uint32_t K,uint32_t N,uint32_t W,
uint64_t sync_base){
set_ffts_base_addr(sync_base);
asc_init();
bool raw = K <= 8160 && N <= 536;
uint32_t previous = 0;
for(uint32_t e = 0;e < E && raw;++e){
const uint32_t end = uint32_t(groups[e]),rows = end - previous;
raw = rows <= 224 && rows % 16 != 0 && rows * N <= 114688;
previous = end;
}
const uint32_t kp = dfocus::Up(K,256),np = dfocus::Up(N,128),M = uint32_t(groups[E - 1]);
__gm__ int8_t *px =(__gm__ int8_t *)scratch + uint64_t(W)* 131072;
__gm__ int8_t *pw = px + uint64_t(M)* kp;
if ASC_IS_AIC{
asc_sync_block_wait(13);
if(raw)
d6_hb_tiles::Cube<256,128,512,128,true>(px,w,groups,scratch,E,kp,np,W,N,K);
else
d6_hb_tiles::Cube<256,128,512,128>(px,pw,groups,scratch,E,kp,np,W,N,K);
}
if ASC_IS_AIV{
if(raw)
d6_hb_pack::Prepare<8,128,256,128,false>(x,w,px,pw,M,E,K,N,W,groups);
else
d6_hb_pack::Prepare<8,128,256,128>(x,w,px,pw,M,E,K,N,W,groups);
d6_hb_tiles::Vector<256,128>(scale,groups,y,scratch,E,N,W);
}
asc_sync();
}

namespace d6_next_pipe{
using dfocus::Min;

using dfocus::Up;

__aicore__ inline uint32_t ReadyId(uint32_t slot){return 8 + 2 * slot;}

constexpr uint32_t VecLanes = 6144;

constexpr uint32_t VecPanel = 256;

constexpr uint32_t VecFloat = VecLanes * sizeof(float);

constexpr uint32_t VecHalf = VecLanes * sizeof(half);

struct Frame{
uint32_t expert,row,col,rows,nr,bn,local;
};

struct TileFrame : Frame{
uint32_t tile = 0,tileRow = 0;
bool firstFrame = false,lastFrame = false;
};

template <bool Bulk> struct ExchangeFrame{
using Type = Frame;
};

template <> struct ExchangeFrame<true>{
using Type = TileFrame;
};

__aicore__ inline __ubuf__ float *InputBank(uint32_t bank){
return(__ubuf__ float *)static_cast<uint64_t>(bank * VecFloat);
}

__aicore__ inline __ubuf__ half *OutputBank(uint32_t bank){
return(__ubuf__ half *)static_cast<uint64_t>(6 * VecFloat + bank * VecHalf);
}

template <uint32_t ScaleWidth = VecPanel> __aicore__ inline __ubuf__ float *ScaleBank(uint32_t bank){
return(__ubuf__ float *)static_cast<uint64_t>(6 * VecFloat + 2 * VecHalf + bank * ScaleWidth * 4);
}

__aicore__ inline void WaitOutput(uint32_t bank){
if(bank)
asc_sync_wait(PIPE_MTE3,PIPE_V,EVENT_ID5);
else
asc_sync_wait(PIPE_MTE3,PIPE_V,EVENT_ID4);
}

template <uint32_t Slots,uint32_t ScaleWidth = VecPanel,bool TileExchange = false>
__aicore__ inline void LoadFrame(const typename ExchangeFrame<TileExchange>::Type &frame,__gm__ float *scale,
__gm__ int32_t *scratch,uint32_t worker,uint32_t N,uint32_t ticket){
uint32_t slot = ticket % Slots,row = frame.local;
const uint32_t bank = ticket % 2;
bool first = true,last = true;
if constexpr(TileExchange){
slot = frame.tile % Slots;
row = frame.tileRow;
first = frame.firstFrame;
last = frame.lastFrame;
}
if(first)
asc_sync_block_wait(ReadyId(slot));
if(frame.rows){
const uint32_t bytes = frame.rows * frame.bn * 4,tail = Up(frame.nr,8)- frame.nr;
if(ticket >= 2){
asc_sync_notify(PIPE_V,PIPE_MTE2,EVENT_ID6);
asc_sync_wait(PIPE_V,PIPE_MTE2,EVENT_ID6);
}
const uint32_t words = TileExchange ? 24576 : 16384;
asc_copy_gm2ub_align((__ubuf__ int32_t *)InputBank(bank),
scratch +(uint64_t(worker)* Slots + slot)* words + row * frame.bn,1,bytes,0,0,0,0);
asc_copy_gm2ub_align(ScaleBank<ScaleWidth>(bank),scale + uint64_t(frame.expert)* N + frame.col,1,
frame.nr * 4,0,tail,0,0);
if(bank)
asc_sync_notify(PIPE_MTE2,PIPE_V,EVENT_ID3);
else
asc_sync_notify(PIPE_MTE2,PIPE_V,EVENT_ID2);
}
if(last)
ffts_cross_core_sync(PIPE_MTE2,0x21ULL |(uint64_t(ReadyId(slot)+ 1)<< 8));
}

template <typename Cursor,uint32_t ScaleWidth = VecPanel,bool Late = false,bool TileExchange = false>
__aicore__ inline void VectorPipeline(__gm__ float *scale,__gm__ int64_t *groups,__gm__ half *y,
__gm__ int32_t *scratch,uint32_t N,uint32_t worker,Cursor cursor){
const uint32_t sub = asc_get_sub_block_id();
using FrameType = typename ExchangeFrame<TileExchange>::Type;
FrameType current{};
bool live = cursor.Next(current,groups,N,sub);
bool pending[2] ={false,false};
uint32_t index = 0;
set_mov_pad_val(uint32_t(0));
if(live)
LoadFrame<2,ScaleWidth,TileExchange>(current,scale,scratch,worker,N,0);
for(uint32_t ticket = 0;live;++ticket){
const uint32_t bank = ticket % 2;
__ubuf__ float *z = InputBank(bank);
__ubuf__ float *sc = ScaleBank<ScaleWidth>(bank);
const uint32_t count = Up(current.rows * current.bn,64);
if(current.rows){
if(bank)
asc_sync_wait(PIPE_MTE2,PIPE_V,EVENT_ID3);
else
asc_sync_wait(PIPE_MTE2,PIPE_V,EVENT_ID2);
const uint32_t valid = current.rows * current.bn,scValid = Up(current.nr,8);
if(count != valid)
asc_duplicate((__ubuf__ int32_t *)z + valid,int32_t(0),count - valid);
if(scValid < current.bn)
asc_duplicate(sc + scValid,0.0f,current.bn - scValid);
asc_sync_pipe(PIPE_V);
asc_int322float_rn(z,(__ubuf__ int32_t *)z,count);
asc_sync_pipe(PIPE_V);
asc_set_mask_norm();
asc_set_vector_mask(uint64_t(0),current.bn == 32 ? uint64_t(0xffffffff): ~uint64_t(0));
for(uint32_t c = 0;c < current.bn;c += 64){
asc_set_vector_mask(uint64_t(0),current.bn - c < 64 ? uint64_t(0xffffffff): ~uint64_t(0));
asc_mul(z + c,z + c,sc + c,uint8_t(current.rows),1,1,1,current.bn / 8,current.bn / 8,0);
}
asc_sync_pipe(PIPE_V);
asc_set_vector_mask(~uint64_t(0),~uint64_t(0));
}
FrameType next{};
const bool nextLive = cursor.Next(next,groups,N,sub);
bool after = Late;
if constexpr(TileExchange)
after = after || current.lastFrame;
if(!after && nextLive)
LoadFrame<2,ScaleWidth,TileExchange>(next,scale,scratch,worker,N,ticket + 1);
if(current.rows){
if(pending[bank])
WaitOutput(bank);
__ubuf__ float *u =(__ubuf__ float *)(2 * VecFloat);
__ubuf__ float *t =(__ubuf__ float *)(3 * VecFloat);
__ubuf__ float *d =(__ubuf__ float *)(4 * VecFloat);
__ubuf__ float *p =(__ubuf__ float *)(5 * VecFloat);
__ubuf__ uint8_t *mask =(__ubuf__ uint8_t *)(6 * VecFloat + 2 * VecHalf + 2 * ScaleWidth * 4);
__ubuf__ half *out = OutputBank(bank);
index = d6_density::GeluDense(z,u,t,d,p,out,mask,count,current.nr,current.bn,index);
asc_sync_notify(PIPE_S,PIPE_MTE3,EVENT_ID0);
asc_sync_wait(PIPE_S,PIPE_MTE3,EVENT_ID0);
asc_copy_ub2gm_align(y + uint64_t(current.row)* N + current.col,out,current.rows,current.nr * 2,0,0,
(current.bn - Up(current.nr,16))/ 16,(N - current.nr)* 2);
if(bank)
asc_sync_notify(PIPE_MTE3,PIPE_V,EVENT_ID5);
else
asc_sync_notify(PIPE_MTE3,PIPE_V,EVENT_ID4);
pending[bank] = true;
}
if(after && nextLive)
LoadFrame<2,ScaleWidth,TileExchange>(next,scale,scratch,worker,N,ticket + 1);
current = next;
live = nextLive;
}
for(uint32_t bank = 0;bank < 2;++bank)
if(pending[bank])
WaitOutput(bank);
asc_sync();
ffts_cross_core_sync(PIPE_MTE3,0x21ULL |(uint64_t(dfocus::FINAL)<< 8));
}

template <uint32_t TM,uint32_t BN,uint32_t SR,bool Whole,bool TileExchange = false> struct Cursor{
uint32_t expert,start,prefix,task,last,offset;
uint32_t localTile = 0;
__aicore__ inline bool Next(
typename ExchangeFrame<TileExchange>::Type &frame,__gm__ int64_t *groups,uint32_t N,uint32_t sub){
if(task >= last)
return false;
const uint32_t nt =(N + BN - 1)/ BN;
while(true){
const uint32_t end = uint32_t(groups[expert]),me = end - start;
const uint32_t mt = Whole ? uint32_t(me != 0):(me + TM - 1)/ TM,tasks = mt * nt;
if(task < prefix + tasks){
const uint32_t index = task - prefix;
const uint32_t row = Whole ? start : start +(index % mt)* TM,col = index / mt * BN;
const uint32_t mr = Whole ? me : Min(TM,end - row),nr = Min(BN,N - col),bn = Up(nr,32);
const uint32_t rows = Min(SR,mr - offset),split =(rows + 1)/ 2,local = sub * split;
static_cast<Frame &>(frame)={
expert,row + offset + local,col,rows > local ? Min(split,rows - local): 0,nr,bn,local};
if constexpr(TileExchange){
frame.tile = localTile;
frame.tileRow = offset + local;
frame.firstFrame = offset == 0;
frame.lastFrame = offset + rows == mr;
localTile += frame.lastFrame;
}
offset += rows;
if(offset == mr){
offset = 0;
++task;
}
return true;
}
++expert;
start = end;
prefix += tasks;
}
}
};

template <uint32_t TM,uint32_t BN,uint32_t SR,bool Whole,bool Late = false,bool TileExchange = false>
__aicore__ inline void Execute(__gm__ float *scale,__gm__ int64_t *groups,__gm__ half *y,__gm__ int32_t *scratch,
uint32_t E,uint32_t N,uint32_t W,uint32_t active = 0){
const uint32_t worker = asc_get_block_idx(),nt =(N + BN - 1)/ BN;
uint32_t previous = 0,total = active * nt;
if(!active)
for(uint32_t expert = 0;expert < E;++expert){
const uint32_t end = uint32_t(groups[expert]),me = end - previous;
total +=(Whole ? uint32_t(me != 0):(me + TM - 1)/ TM)* nt;
previous = end;
}
const uint32_t q = total / W,rem = total % W,first = worker * q + Min(worker,rem),
last = first + q +(worker < rem);
Cursor<TM,BN,SR,Whole,TileExchange> cursor{0,0,0,first,last,0};
VectorPipeline<Cursor<TM,BN,SR,Whole,TileExchange>,VecPanel,Late,TileExchange>(
scale,groups,y,scratch,N,worker,cursor);
}
}// namespace d6_next_pipe

namespace d12_exchange{
__aicore__ inline void Store(__cc__ int32_t *c,__gm__ int32_t *scratch,uint32_t worker,uint32_t mr,uint32_t mp,
uint32_t np,uint32_t &ordinal){
const uint32_t s = ordinal % 2,ready = 8 + 2 * s;
if(ordinal >= 2)
asc_sync_block_wait(ready + 1);
asc_set_l0c_copy_params(1,0,0);
asc_copy_l0c2gm_sync(scratch +(uint64_t(worker)* 2 + s)* 24576,c,np,mr,np,mp,0,0,0,false,true);
ffts_cross_core_sync(PIPE_FIX,0x21ULL |(uint64_t(ready)<< 8));
++ordinal;
asc_sync_notify(PIPE_FIX,PIPE_M,EVENT_ID6);
asc_sync_wait(PIPE_FIX,PIPE_M,EVENT_ID6);
}
}// namespace d12_exchange

namespace d6_hc_stream{
using dfocus::Drain;

using dfocus::Min;

using dfocus::Up;

template <uint32_t TM,uint32_t BN,uint32_t LK = 128,bool CacheX = false,bool Bulk = false,bool Async = false>
__aicore__ inline void CubeFull(__gm__ int8_t *x,__gm__ int8_t *w,__gm__ int64_t *groups,__gm__ int32_t *scratch,
uint32_t E,uint32_t K,uint32_t N,uint32_t W,uint32_t capacity = 458752){
const uint32_t worker = asc_get_block_idx(),nt =(N + BN - 1)/ BN,kp = Up(K,32),total =(kp + LK - 1)/ LK;
__cbuf__ int8_t *a1 =(__cbuf__ int8_t *)0;
__ca__ int8_t *a =(__ca__ int8_t *)0;
__cb__ int8_t *b =(__cb__ int8_t *)0;
__cc__ int32_t *c =(__cc__ int32_t *)0;
uint32_t all_tasks = 0,previous = 0;
for(uint32_t e = 0;e < E;++e){
const uint32_t end = uint32_t(groups[e]),me = end - previous,tm = me ? Min(Up(me,16),TM): 16;
all_tasks +=((me + tm - 1)/ tm)* nt;
previous = end;
}
const uint32_t per = all_tasks / W,remainder = all_tasks % W,own_begin = worker * per + Min(worker,remainder),
own_end = own_begin + per +(worker < remainder);
uint32_t start = 0,prefix = 0,ordinal = 0;
for(uint32_t e = 0;e < E;++e){
const uint32_t end = uint32_t(groups[e]),me = end - start,tm = me ? Min(Up(me,16),TM): 16,
mt =(me + tm - 1)/ tm,tasks = mt * nt;
const uint32_t begin = own_begin > prefix ? Min(tasks,own_begin - prefix): 0,
finish = own_end > prefix ? Min(tasks,own_end - prefix): 0;
constexpr bool asyncTail = CacheX && !Bulk && Async;
const uint32_t whole = Up(me,asyncTail ? 32 : 16);
const bool resident = CacheX && finish > begin + 1 && Up(whole * kp,1024)+ BN * kp <= capacity;
const uint32_t pitch = resident ? whole :(asyncTail ? Up(tm,32): tm);
__cbuf__ int8_t *b1 = a1 + Up(pitch * kp,1024);
uint32_t cacheCol = N;
if(resident){
if(K != kp)
cp6_gmg_opt::ZeroL1(a1 +(kp - 32)* pitch,pitch * 32);
asc_copy_gm2l1_nd2nz(a1,x + uint64_t(start)* K,1,me,K,0,K,pitch,1,0);
}
if constexpr(CacheX){
if(asyncTail && !resident && begin < finish && K != kp)
cp6_gmg_opt::ZeroL1(a1 +(kp - 32)* pitch,pitch * 32);
}
for(uint32_t task = begin;task < finish;++task){
const uint32_t row = start +(task % mt)* tm,col =(task / mt)* BN,mr = Min(tm,end - row),
mp = Up(mr,16),nr = Min(BN,N - col),np = Up(nr,32);
if(!resident){
if constexpr(CacheX){
if(!asyncTail && K != kp)
cp6_gmg_opt::ZeroL1(a1 +(kp - 32)* tm,tm * 32);
}else{
if(K % 32 || mr % 16)
cp6_gmg_opt::ZeroL1(a1,tm * kp);
}
}
if(cacheCol != col){
if constexpr(!CacheX){
if(K % 32 || nr % 32)
cp6_gmg_opt::ZeroL1(b1,kp * np);
}
asc_copy_gm2l1_nd2nz(b1,w + uint64_t(e)* K * N + col,1,K,nr,0,N,kp,1,0);
cacheCol = col;
}
if(!resident)
asc_copy_gm2l1_nd2nz(a1,x + uint64_t(row)* K,1,mr,K,0,K,pitch,1,0);
asc_sync();
const uint32_t cubeRows = asyncTail && mp >= 48 ? Up(mr,32): mp;
d6_l0::Multiply(resident ? a1 +(row - start)* 32 : a1,b1,a,b,c,pitch,cubeRows,np,kp);
if constexpr(Bulk)
d12_exchange::Store(c,scratch,worker,mr,cubeRows,np,ordinal);
else if(nr <= 32)
dfocus::Store<32,48>(c,scratch,worker,mr,cubeRows,np,ordinal);
else
dfocus::Store<BN,48>(c,scratch,worker,mr,cubeRows,np,ordinal);
}
prefix += tasks;
start = end;
}
Drain(ordinal);
}
}// namespace d6_hc_stream

__global__ __mix__(1,2)void grouped_matmul_gelu_df_hc(__gm__ int8_t *x,__gm__ int8_t *w,__gm__ float *scale,
__gm__ int64_t *groups,__gm__ half *y,__gm__ int32_t *scratch,uint32_t E,uint32_t K,uint32_t N,uint32_t W,
uint64_t sync_base,bool roomy){
set_ffts_base_addr(sync_base);
asc_init();
bool tail = K <= 1055 && N <= 1032,high = K > 1056;
if(tail || high){
uint32_t end = uint32_t(groups[E - 1]);
for(uint32_t e = E;e &&(tail || high);--e){
const uint32_t start = e > 1 ? uint32_t(groups[e - 2]): 0,rows = end - start;
tail = tail &&(rows <= 96 ||(rows > 128 && rows <= 192));
high = high && rows > 128 && rows <= 192;
end = start;
}
}
if ASC_IS_AIC{
if(tail)
d6_hc_stream::CubeFull<96,256,128,true,true>(x,w,groups,scratch,E,K,N,W);
else if(high)
d6_hc_stream::CubeFull<128,256,128,true,false,true>(
x,w,groups,scratch,E,K,N,W,roomy ? 524032 : 458752);
else
d6_hc_stream::CubeFull<128,256,128,true>(x,w,groups,scratch,E,K,N,W);
}
if ASC_IS_AIV{
if(tail)
d6_next_pipe::Execute<96,256,48,false,false,true>(scale,groups,y,scratch,E,N,W);
else
d6_next_pipe::Execute<128,256,48,false>(scale,groups,y,scratch,E,N,W);
}
asc_sync();
}

namespace d6_hers_pipe{
using dfocus::Drain;

using dfocus::Min;

using dfocus::Up;

template <bool OldPadding>
__aicore__ inline void LoadX(__gm__ int8_t *x,__cbuf__ int8_t *a1,uint32_t K,uint32_t kp,uint32_t row,uint32_t mr,
uint32_t tm,uint32_t stage){
__cbuf__ int8_t *dst = a1 + stage * tm * kp;
if constexpr(OldPadding)
if(K != kp || mr % 16)
cp6_gmg_opt::ZeroL1(dst,tm * kp);
asc_copy_gm2l1_nd2nz(dst,x + uint64_t(row)* K,1,mr,K,0,K,tm,1,0);
dfocus_stream::BR(stage,false);
}

template <uint32_t TM,uint32_t BN,uint32_t LK = 128,uint32_t SR = 64,bool Bulk = false>
__aicore__ inline void CubeFull(__gm__ int8_t *x,__gm__ int8_t *w,__gm__ int64_t *groups,__gm__ int32_t *scratch,
uint32_t E,uint32_t K,uint32_t N,uint32_t W){
const uint32_t worker = asc_get_block_idx(),nt =(N + BN - 1)/ BN,kp = Up(K,32),total =(kp + LK - 1)/ LK;
__cbuf__ int8_t *a1 =(__cbuf__ int8_t *)0;
__ca__ int8_t *a =(__ca__ int8_t *)0;
__cb__ int8_t *b =(__cb__ int8_t *)0;
__cc__ int32_t *c =(__cc__ int32_t *)0;
uint32_t all_tasks = 0,previous = 0;
for(uint32_t e = 0;e < E;++e){
const uint32_t end = uint32_t(groups[e]),me = end - previous,tm = me ? Min(Up(me,16),TM): 16;
all_tasks +=((me + tm - 1)/ tm)* nt;
previous = end;
}
const uint32_t per = all_tasks / W,remainder = all_tasks % W,own_begin = worker * per + Min(worker,remainder),
own_end = own_begin + per +(worker < remainder);
uint32_t start = 0,prefix = 0,ordinal = 0;
for(uint32_t e = 0;e < E;++e){
const uint32_t end = uint32_t(groups[e]),me = end - start,tm = me ? Min(Up(me,16),TM): 16,
mt =(me + tm - 1)/ tm,tasks = mt * nt;
const uint32_t begin = own_begin > prefix ? Min(tasks,own_begin - prefix): 0,
finish = own_end > prefix ? Min(tasks,own_end - prefix): 0;
__cbuf__ int8_t *b1 = a1 + Up(2 * tm * kp,1024);
uint32_t cacheCol = N;
if(begin < finish){
if constexpr(BN == 192)
if(K != kp){
cp6_gmg_opt::ZeroL1(a1 +(kp - 32)* tm,32 * tm);
cp6_gmg_opt::ZeroL1(a1 +(2 * kp - 32)* tm,32 * tm);
}
const uint32_t row = start +(begin % mt)* tm;
LoadX<BN != 192>(x,a1,K,kp,row,Min(tm,end - row),tm,0);
}
for(uint32_t task = begin;task < finish;++task){
const uint32_t row = start +(task % mt)* tm,col =(task / mt)* BN,mr = Min(tm,end - row),
mp = Up(mr,16),nr = Min(BN,N - col),np = Up(nr,32);
const uint32_t stage =(task - begin)% 2;
dfocus_stream::BR(stage,true);
if(cacheCol != col){
if constexpr(BN != 192)
if(K % 32 || nr % 32)
cp6_gmg_opt::ZeroL1(b1,kp * np);
asc_copy_gm2l1_nd2nz_sync(b1,w + uint64_t(e)* K * N + col,1,K,nr,0,N,kp,1,0);
cacheCol = col;
}
if(task + 1 < finish){
const uint32_t next = start +((task + 1)% mt)* tm;
LoadX<BN != 192>(x,a1,K,kp,next,Min(tm,end - next),tm,1 - stage);
}
d6_l0::Multiply(a1 + stage * tm * kp,b1,a,b,c,tm,mp,np,kp);
if constexpr(Bulk)
d12_exchange::Store(c,scratch,worker,mr,mp,np,ordinal);
else
dfocus::Store<BN,SR>(c,scratch,worker,mr,mp,np,ordinal);
}
prefix += tasks;
start = end;
}
Drain(ordinal);
}
}// namespace d6_hers_pipe

__global__ __mix__(1,2)void grouped_matmul_gelu_df_hers(__gm__ int8_t *x,__gm__ int8_t *w,__gm__ float *scale,
__gm__ int64_t *groups,__gm__ half *y,__gm__ int32_t *scratch,uint32_t E,uint32_t K,uint32_t N,uint32_t W,
uint64_t sync_base){
set_ffts_base_addr(sync_base);
asc_init();
const bool wide = N == 768 && unique_hers_global::PreferGlobal(groups,E,N,W);
if ASC_IS_AIC{
if(wide)
d6_hers_pipe::CubeFull<96,256,128,48>(x,w,groups,scratch,E,K,N,W);
else if(N < 768 && K <= 976)
d6_hers_pipe::CubeFull<128,192,128,64,true>(x,w,groups,scratch,E,K,N,W);
else
d6_hers_pipe::CubeFull<128,192>(x,w,groups,scratch,E,K,N,W);
}
if ASC_IS_AIV{
if(wide)
d6_next_pipe::Execute<96,256,48,false>(scale,groups,y,scratch,E,N,W);
else if(N < 768 && K <= 976)
d6_next_pipe::Execute<128,192,64,false,false,true>(scale,groups,y,scratch,E,N,W);
else
d6_next_pipe::Execute<128,192,64,false>(scale,groups,y,scratch,E,N,W);
}
asc_sync();
}

namespace d7_tiny_fast{
static __aicore__ __attribute__((always_inline))inline void GeluWide(__ubuf__ float *z,__ubuf__ float *u,
__ubuf__ float *p,__ubuf__ half *out,uint32_t count,uint32_t nr,uint32_t np){
__ubuf__ uint8_t *positive =(__ubuf__ uint8_t *)188160;
