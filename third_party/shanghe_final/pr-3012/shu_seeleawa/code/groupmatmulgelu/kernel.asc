}// namespace smallmat

template <bool Fixed>
static __aicore__ __attribute__((always_inline))inline void WideFamily(__gm__ int8_t *__restrict__ x,
__gm__ int8_t *__restrict__ w,__gm__ float *__restrict__ scale,__gm__ int64_t *__restrict__ groups,
__gm__ half *__restrict__ y,uint32_t experts,uint32_t secondEndOffset){
asc_set_atomic_none();
asc_datacache_preload((__gm__ uint64_t *)groups,0);
asc_datacache_preload((__gm__ uint64_t *)x,0);
asc_datacache_preload((__gm__ uint64_t *)w,0);
asc_datacache_preload((__gm__ uint64_t *)scale,0);
const uint32_t block = asc_get_block_idx();
const uint32_t first = 2 * block;
const auto g =(__gm__ uint8_t *)groups;
uint32_t end0 = 0,end1 = 0;
if constexpr(Fixed){
end0 = g[0];
end1 = g[secondEndOffset];
}
const uint32_t r0 = first / 5,r1 =(first + 1)/ 5,c0 = first % 5,c1 =(first + 1)% 5;
uint32_t e0 = 0,e1 = 0;
if constexpr(Fixed){
e0 = uint32_t(r0 >= end0)+ uint32_t(r0 >= end1);
e1 = uint32_t(r1 >= end0)+ uint32_t(r1 >= end1);
}else{
while(e0 + 1 < experts && r0 >= g[e0 * 8])
++e0;
while(e1 + 1 < experts && r1 >= g[e1 * 8])
++e1;
}
const auto x0 = smallmat::ReadX(x,r0),x1 = r1 == r0 ? x0 : smallmat::ReadX(x,r1);
const float a = smallmat::Dot(x0,smallmat::ReadW(w,scale,e0,c0));
const float b = smallmat::Dot(x1,smallmat::ReadW(w,scale,e1,c1));
const uint32_t left = smallmat::Pair(a,b);
((__ubuf__ uint32_t *)0)[0] = left;
asc_sync_notify(PIPE_S,PIPE_MTE3,EVENT_ID0);
asc_sync_wait(PIPE_S,PIPE_MTE3,EVENT_ID0);
asc_copy_ub2gm_align(y + first,(__ubuf__ half *)0,4);
asc_sync();
}

