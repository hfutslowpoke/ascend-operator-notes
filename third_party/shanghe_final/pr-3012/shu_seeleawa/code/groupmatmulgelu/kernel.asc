__cbuf__ int8_t *aa = base + stage * span;
for(uint32_t ki = 0;ki < kp / 32;++ki)
asc_copy_l12l0a(a + slot * tm * 128 + ki * 512,aa +(inside + ki * 32)* tm,0,mp / 16,1,kp / 32 - 1);
asc_copy_l12l0b_trans(
b + slot * nr * 128,aa + tm * 256 + inside * nr,0,(kp / 32)*(nr / 32),1,1,false,uint64_t(0));
LR(slot,false);
if(inside + kp == kr && outer + 3 <(K + 255)/ 256){
L1F(stage,false);
L1F(stage,true);
