const int64_t a = 2 *(u < 0 ? -u : u);
const uint32_t power = uint32_t(a / ln2);
const int64_t r = -a + int64_t(power)* ln2;
int64_t v = 150432888;
v = 1805194656LL + QMul(v,r);
v = 19857141214LL + QMul(v,r);
v = 198571412142LL + QMul(v,r);
v = 1787142709274LL + QMul(v,r);
v = 14297141674192LL + QMul(v,r);
v = 100079991719344LL + QMul(v,r);
v = 600479950316066LL + QMul(v,r);
v = 3002399751580331LL + QMul(v,r);
v = 12009599006321323LL + QMul(v,r);
v = 36028797018963968LL + QMul(v,r);
v = one + QMul(v,r);
v = one + QMul(v,r);
const int64_t t = power >= 56 ? 0 :(v >> power),denom = one + t;
int64_t inv = one / 2;
for(uint32_t j = 0;j < 7;++j)
inv = QMul(inv,2 * one - QMul(denom,inv));
