namespace smallmat{
struct Row{
int32_t a,b,c;
};

struct Column{
int32_t a,b,c;
float s;
};

__aicore__ __attribute__((always_inline))inline Row ReadX(__gm__ int8_t *x,uint32_t r){
return{x[r * 3],x[r * 3 + 1],x[r * 3 + 2]};
}

__aicore__ __attribute__((always_inline))inline Column ReadW(
__gm__ int8_t *w,__gm__ float *s,uint32_t e,uint32_t n){
const uint32_t i = e * 15 + n;
return{w[i],w[i + 5],w[i + 10],s[e * 5 + n]};
}

__aicore__ __attribute__((always_inline))inline float Dot(Row x,Column w){
return float(x.a * w.a + x.b * w.b + x.c * w.c)* w.s;
}

__aicore__ __attribute__((always_inline))inline uint32_t Pair(float a,float b){
const uint32_t x = Magnitude(a),y = Magnitude(b);
if((x - 0x390022d0U < 0x40028f5cU - 0x390022d0U)&(y - 0x390022d0U < 0x40028f5cU - 0x390022d0U))
