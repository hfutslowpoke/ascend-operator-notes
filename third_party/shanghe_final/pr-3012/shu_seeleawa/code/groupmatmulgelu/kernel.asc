}
if(ordinal >= 2)
asc_sync_block_wait(9 + 2 * slot);
asc_sync_notify(PIPE_M,PIPE_FIX,EVENT_ID5);
asc_sync_wait(PIPE_M,PIPE_FIX,EVENT_ID5);
asc_set_l0c_copy_params(1,0,0);
asc_copy_l0c2gm(ws +(2 * worker + slot)* 32768,c,np,rows,np,mp,0,0,0,false,true);
ffts_cross_core_sync(PIPE_FIX,0x21ULL |(uint64_t(8 + 2 * slot)<< 8));
cp6_large39::CLease(0,false);
row = nextRow;
}
}
for(uint32_t i = phase > 2 ? phase - 2 : 0;i < phase;++i)
cp6_c38::LF(i % 2,true);
if constexpr(Packed)
if(!phase)
asc_sync_block_wait(0);
if(ordinal)
cp6_large39::CLease(0,true);
cp6_c38::Drain(ordinal);
}
}// namespace other6_hers_chunk_full

__aicore__ __attribute__((always_inline))inline void Other6HersLongGroups(__gm__ int8_t *x,__gm__ int8_t *w,
__gm__ float *scale,__gm__ int64_t *groups,__gm__ half *y,__gm__ int32_t *scratch,uint32_t E,uint32_t K,
uint32_t N,uint32_t workers,uint32_t l1){
if ASC_IS_AIC
other6_hers_chunk_full::Cube<false>(x,w,groups,scratch,E,K,N,workers,l1);
if ASC_IS_AIV{
const uint32_t active = other6_group_meta::Build(E);
other6_group_meta::Warm<1>(w,active,K,N,workers);
other6_hers_chunk_full::Frames frames{other6_hers_chunk_rect::Schedule(groups,E,N,workers)};
hers_post::Vector<2,32768,false>(frames,scale,groups,y,scratch,N);
}
asc_sync();
}

template <bool Packed, bool Odd = false, uint32_t ReadAhead = 0, bool ReadActivation = false, bool BoundedRead = false,
bool AdaptiveDispatch = false>
__aicore__ __attribute__((always_inline)) inline void Other6GroupHersBody(__gm__ int8_t *x, __gm__ int8_t *w,
__gm__ float *scale, __gm__ int64_t *groups, __gm__ half *y, __gm__ int32_t *scratch, uint32_t E, uint32_t K,
uint32_t N, uint32_t workers, uint64_t sync_base, uint32_t l1) {
set_ffts_base_addr(sync_base);
asc_init();
uint32_t previous = 0, minRows = uint32_t(-1), maxRows = 0, active = 0;
for (uint32_t e = 0; e < E; ++e) {
const uint32_t end = uint32_t(groups[e]), rows = end - previous;
if ASC_IS_AIV
other6_group_meta::Ends()[e] = end;
active += rows != 0;
minRows = hers_full::Min(minRows, rows);
maxRows = rows > maxRows ? rows : maxRows;
previous = end;
}
if constexpr (AdaptiveDispatch) {
if (maxRows - minRows > 128 && l1 >= 520192 &&
((E % 2 == 0 && 2 * E <= workers && minRows && maxRows <= 1152) ||
(E <= 32 && maxRows > 1152 && active > E / 2 && active * 5 > workers))) {
HersSkewWaves(x, w, scale, groups, y, scratch, E, K, N, workers);
return;
}
const bool empty = !minRows && maxRows <= 1152;
const bool crossed =
minRows && maxRows - minRows <= 128 && hers_full::Up(minRows, 128) != hers_full::Up(maxRows, 128);
if (2 * E <= workers && (empty || crossed)) {
Other6GroupHersAdaptive(x, w, scale, groups, y, scratch, E, K, N, workers, sync_base, l1, !minRows);
return;
}
}
if constexpr (AdaptiveDispatch) {
if (maxRows > 1152 && active * 5 <= workers) {
Other6HersLongGroups(x, w, scale, groups, y, scratch, E, K, N, workers, l1);
return;
}
}
if (!minRows || maxRows - minRows > 128) {
if constexpr (Odd) {
if (l1 >= 520192 && maxRows <= 6U * 192) {
HersSkewWaves(x, w, scale, groups, y, scratch, E, K, N, workers);
return;
}
}
if ASC_IS_AIC {
if (K <= 976)
d6_hers_pipe::CubeFull<128, 192, 128, 64, true>(x, w, groups, scratch, E, K, N, workers);
else
d6_hers_pipe::CubeFull<128, 192>(x, w, groups, scratch, E, K, N, workers);
}
if ASC_IS_AIV {
if (maxRows > 1152) {
const uint32_t count = other6_group_meta::Build(E);
other6_group_meta::Warm<1>(w, count, K, N, workers);
}
if (K <= 976)
d6_next_pipe::Execute<128, 192, 64, false, false, true>(scale, groups, y, scratch, E, N, workers);
else
d6_next_pipe::Execute<128, 192, 64, false>(scale, groups, y, scratch, E, N, workers);
}
asc_sync();
return;
}
if constexpr (Packed) {
auto packed = (__gm__ int8_t *)(scratch + uint64_t(workers) * 65536);
if ASC_IS_AIC {
hers_full::Cube<true>(x, packed, groups, scratch, E, K, N, workers, l1);
}
if ASC_IS_AIV {
if constexpr (Odd) {
hers_parity::Init(N);
hers_parity::Pack(w, packed, groups, K, N, workers, 0, E);
} else {
wave_overlap::InitPackOffsetsFast(N);
wave_overlap::Pack(w, packed, groups, K, N, workers, 0, E);
}
ffts_cross_core_sync(PIPE_MTE3, 0x1ULL | (14ULL << 8));
asc_sync_block_wait(14);
ffts_cross_core_sync(PIPE_MTE3, 0x21ULL);
other6_group_hfull::Frames frames{other6_group_hrect::Schedule(groups, E, N, workers)};
hers_post::Vector<2, 32768, false>(frames, scale, groups, y, scratch, N);
}
} else {
if ASC_IS_AIC
hers_full::Cube<false>(x, w, groups, scratch, E, K, N, workers, l1);
if ASC_IS_AIV {
if constexpr (ReadActivation)
shared_weight_prefetch::Read<1, false, BoundedRead>(x, 1, previous, K, workers);
if constexpr (ReadAhead)
shared_weight_prefetch::Read<ReadAhead, false, BoundedRead>(w, E, K, N, workers);
other6_group_hfull::Frames frames{other6_group_hrect::Schedule(groups, E, N, workers)};
hers_post::Vector<2, 32768, false>(frames, scale, groups, y, scratch, N);
}
}
asc_sync();
}
static __aicore__ __attribute__((noinline,aligned(4096),section(".zzzzzzzzzzzz_hers_cold_fallback")))void
OwnedHersCold(__gm__ int8_t *x,__gm__ int8_t *w,__gm__ float *scale,__gm__ int64_t *groups,__gm__ half *y,
__gm__ int32_t *scratch,uint32_t E,uint32_t K,uint32_t N,uint32_t workers,uint64_t sync_base,uint32_t l1){
Other6GroupHersBody<false,false,1,false,true,true>(
x,w,scale,groups,y,scratch,E,K,N,workers,sync_base,l1);
}
static __aicore__ __attribute__((noinline,aligned(4096),section(".zzzzzzzzzzzz_hers_generic_uncached")))void
OwnedHersGeneric(__gm__ int8_t *x,__gm__ int8_t *w,__gm__ float *scale,__gm__ int64_t *groups,__gm__ half *y,
__gm__ int32_t *scratch,uint32_t E,uint32_t K,uint32_t N,uint32_t workers,uint64_t sync_base,uint32_t l1){
HersBody<false,false,1,false,true,true>(x,w,scale,groups,y,scratch,E,K,N,workers,sync_base,l1);
}
__global__ __mix__(1,2)__attribute__((section(".zzzzzzzzzz_runtime_hers_isolated")))
__attribute__((aligned(4096)))void grouped_matmul_gelu_hers_dispatch_isolated(__gm__ int8_t *x,__gm__ int8_t *w,
__gm__ float *scale,__gm__ int64_t *groups,__gm__ half *y,__gm__ int32_t *scratch,uint32_t E,uint32_t K,
uint32_t N,uint32_t workers,uint64_t sync_base,uint32_t l1){
if(E > 32){
OwnedHersGeneric(x,w,scale,groups,y,scratch,E,K,N,workers,sync_base,l1);
return;
}

set_ffts_base_addr(sync_base);
asc_init();
uint32_t previous = 0,minRows = uint32_t(-1),maxRows = 0;
for(uint32_t e = 0;e < E;++e){
const uint32_t end = uint32_t(groups[e]),rows = end - previous;
if ASC_IS_AIV
other6_group_meta::Ends()[e] = end;
minRows = hers_full::Min(minRows,rows);
maxRows = rows > maxRows ? rows : maxRows;
previous = end;
}
const bool dense = minRows && maxRows - minRows <= 128 &&
(2 * E > workers || hers_full::Up(minRows,128)== hers_full::Up(maxRows,128))&&
(maxRows <= 1152 || E * 5 > workers);
if(!dense){
OwnedHersCold(x,w,scale,groups,y,scratch,E,K,N,workers,sync_base,l1);
return;
}
if ASC_IS_AIC
hers_full::Cube<false>(x,w,groups,scratch,E,K,N,workers,l1);
if ASC_IS_AIV{
shared_weight_prefetch::Read<1,false,true>(w,E,K,N,workers);
other6_group_hfull::Frames frames{other6_group_hrect::Schedule(groups,E,N,workers)};
hers_post::Vector<2,32768,false>(frames,scale,groups,y,scratch,N);
}
asc_sync();
}

namespace hb_rescue{
template <uint32_t Rows, uint32_t Cols>
__aicore__ __attribute__((noinline, section(".zzzzzzzzzz_hb_rescue_run"))) void Run(__gm__ int8_t *x, __gm__ int8_t *w,
__gm__ float *scale, __gm__ int64_t *groups, __gm__ half *y, __gm__ int32_t *scratch, uint32_t E, uint32_t K,
uint32_t N, uint32_t workers, uint64_t sync_base, hb_fractal::Shape shape) {
constexpr uint32_t ActualRows = Rows;
constexpr bool WideK = Rows == 128 && Cols == 192;
constexpr uint32_t KTile = WideK ? 768 : 512, Head = WideK ? 5120 : 6144, Slab = WideK ? 1024 : 2048;
set_ffts_base_addr(sync_base);
asc_init();
auto packed = (__gm__ int8_t *)(scratch + uint64_t(workers) * 2 * ActualRows * Cols);
auto pb = packed + uint64_t(shape.packed[3]) * 8192;
if ASC_IS_AIC
hb_fractal_stream::Cube<ActualRows, Cols, KTile, 128, true, true, true, Head, 512>(
packed, pb, groups, scratch, E, K, N, workers, shape.packed[3], x, w);
if ASC_IS_AIV {
hb_fractal::Prepare<Head, Slab, 64, 512>(x, packed, shape, K, workers, w, pb, N);
hb_fractal_stream::Vector<ActualRows, Cols>(scale, groups, y, scratch, E, N, workers);
}
asc_sync();
}
template <uint32_t Rows,uint32_t Cols>
__aicore__ __attribute__((always_inline))inline uint32_t Jobs(hb_fractal::Shape shape,uint32_t N){
return((shape.packed[1] + Rows - 1)/ Rows +(shape.packed[2] - shape.packed[1] + Rows - 1)/ Rows +
(shape.packed[3] - shape.packed[2] + Rows - 1)/ Rows)*
((N + Cols - 1)/ Cols);
}
}// namespace hb_rescue

namespace tail_hb_m16{
using dfocus::Min;

using dfocus::Up;

__aicore__ __attribute__((always_inline))inline uint32_t Mpad(uint32_t rows){return Up(rows,rows <= 64 ? 32 : 16);}
__aicore__ __attribute__((always_inline))inline uint32_t GroupPad(uint32_t rows){
const uint32_t tail = rows % 256;
return rows - tail +(tail ? Mpad(tail): 0);
}

struct Tile{
uint32_t expert,row,col,rows,cols,packed;
};

template <uint32_t M,uint32_t N> struct Cursor{
uint32_t expert = 0,start = 0,row = 0,col = 0,left = 0,packed = 0;
__aicore__ __attribute__((always_inline))inline Tile Next(__gm__ int64_t *groups,uint32_t width){
if(!left)
return{};
while(true){
const uint32_t end = uint32_t(groups[expert]);
if(row < end){
const Tile t{expert,row,col,Min(M,end - row),Min(N,width - col),packed + row - start};
col += N;
if(col >= width){
col = 0;
row += M;
}
--left;
return t;
}
++expert;
packed += GroupPad(end - start);
row = start = end;
}
}
};

template <uint32_t M,uint32_t N,bool OwnRows = false>
__aicore__ __attribute__((always_inline))inline Cursor<M,N> Schedule(
__gm__ int64_t *groups,uint32_t E,uint32_t width,uint32_t workers){
uint32_t ends[32];
uint32_t total = 0,prev = 0;
const uint32_t panels =(width + N - 1)/ N;
for(uint32_t e = 0;e < E;++e){
const uint32_t end = uint32_t(groups[e]);
total +=((end - prev + M - 1)/ M)*(OwnRows ? 1 : panels);
ends[e] = end;
prev = end;
}
const uint32_t worker = asc_get_block_idx(),extra = total % workers,base = total / workers;
uint32_t first = worker * base + Min(worker,extra);
Cursor<M,N> cur{};
cur.left = base + uint32_t(worker < extra);
if constexpr(OwnRows){
first *= panels;
cur.left *= panels;
}
for(uint32_t e = 0;cur.left && e < E;++e){
const uint32_t tiles =((ends[e] - cur.start + M - 1)/ M)* panels;
if(first < tiles){
cur.expert = e;
cur.row = cur.start + first / panels * M;
cur.col = first % panels * N;
break;
}
first -= tiles;
cur.packed += GroupPad(ends[e] - cur.start);
cur.start = ends[e];
}
return cur;
}

struct Chunk{
Tile tile;
uint32_t k;
};

template <uint32_t M,uint32_t N,uint32_t BK,bool Long,bool Packed,bool Compact>
__aicore__ __attribute__((always_inline))inline void Fetch(
__gm__ int8_t *x,__gm__ int8_t *w,Chunk job,uint32_t K,uint32_t width,uint32_t slot,uint32_t xStride){
auto a =(__cbuf__ int8_t *)0;
auto b = a +(Long ? 2 * M * BK : M * Up(K,32))+ slot * N * BK;
const Tile t = job.tile;
const uint32_t k = Min(BK,K - job.k),full = k / 32;
const uint32_t mp = Mpad(t.rows),tail = k % 32,np = Compact ? Up(t.cols,32): N;
if constexpr(Long){
a += slot * M * BK;
asc_copy_gm2l1(
a,x + uint64_t(job.k)* xStride + t.packed * 128,BK / 128,mp * 128 / 32,(xStride - mp)* 128 / 32,0);
}
asc_copy_gm2l1(b,w +(uint64_t(t.expert)* 8192 + job.k)* 544 + t.col * 32,Up(k,32)/ 32,np,544 - np,0);
cp6_c38::L1R(slot,false);
}

template <uint32_t M,uint32_t N,uint32_t BK,uint32_t LK,bool Long,bool Packed = true,bool Compact = false,
uint32_t HeadK = 4096,uint32_t Prefix = 0>
__aicore__ __attribute__((always_inline))inline void Cube(__gm__ int8_t *x,__gm__ int8_t *w,__gm__ int64_t *groups,
__gm__ int32_t *scratch,uint32_t E,uint32_t K,uint32_t width,uint32_t workers,uint32_t xStride,
__gm__ int8_t *rawX = nullptr,__gm__ int8_t *rawW = nullptr){
static_assert(2 * N * BK +(Long ? 2 * M * BK : M * 1088)<= 458752);
static_assert(M * N <= 32768 && M * LK <= 32768 && N * LK <= 32768);
auto cursor = Schedule<M,N>(groups,E,width,workers);
const uint32_t worker = asc_get_block_idx(),kp = Up(K,32);
bool secondWave = false;
Chunk next{cursor.Next(groups,width),Prefix},queue[2];
if constexpr(Prefix){
const auto t = next.tile;
if(t.rows){
const uint32_t mp = Mpad(t.rows),np = Up(t.cols,32);
auto a1 =(__cbuf__ int8_t *)0,b1 = a1 + mp * Prefix;
asc_copy_gm2l1_nd2nz(a1,rawX + uint64_t(t.row)* K,1,t.rows,Prefix,0,K,mp,1,0);
asc_copy_gm2l1_nd2nz(
b1,rawW + uint64_t(t.expert)* K * width + t.col,1,Prefix,t.cols,0,width,Prefix,1,0);
asc_sync_notify(PIPE_MTE2,PIPE_MTE1,EVENT_ID7);
asc_sync_wait(PIPE_MTE2,PIPE_MTE1,EVENT_ID7);
d6_l0::Multiply(a1,b1,(__ca__ int8_t *)0,(__cb__ int8_t *)0,(__cc__ int32_t *)0,mp,mp,np,Prefix);
}
asc_sync_block_wait(13);
}
for(uint32_t slot = 0;slot < 2;++slot){
queue[slot] = next;
if(next.tile.rows){
Fetch<M,N,BK,Long,Packed,Compact>(x,w,next,K,width,slot,xStride);
next.k += BK;
if(next.k >= K)
next ={cursor.Next(groups,width),0};
}
}
uint32_t ordinal = 0,phase = 0,currentRow = uint32_t(-1);
for(uint32_t i = 0;queue[i % 2].tile.rows;++i){
const uint32_t slot = i % 2,output = ordinal % 2;
const Chunk job = queue[slot];
const Tile t = job.tile;
const uint32_t span = Min(BK,kp - job.k),mp = Mpad(t.rows);
const uint32_t np = Up(t.cols,32);
const uint32_t cubeCols = Compact ? np : N;
auto a1 =(__cbuf__ int8_t *)0;
auto b1 = a1 +(Long ? 2 * M * BK : M * kp)+ slot * N * BK;
if constexpr(Long)
a1 += slot * M * BK;
else if(t.row != currentRow){
if(phase){
asc_sync_notify(PIPE_MTE1,PIPE_MTE2,EVENT_ID7);
asc_sync_wait(PIPE_MTE1,PIPE_MTE2,EVENT_ID7);
}
if(K != kp)
cp6_gmg_opt::ZeroL1(a1 +(kp - 32)* mp,32 * mp);
asc_copy_gm2l1_nd2nz(a1,x + uint64_t(t.row)* K,1,t.rows,K,0,K,mp,1,0);
asc_sync_notify(PIPE_MTE2,PIPE_MTE1,EVENT_ID7);
asc_sync_wait(PIPE_MTE2,PIPE_MTE1,EVENT_ID7);
currentRow = t.row;
}
auto cc =(__cc__ int32_t *)0;
cp6_c38::L1R(slot,true);
for(uint32_t off = 0;off < span;off += LK,++phase){
const uint32_t k = Min(LK,span - off),bank = phase % 2;
auto a =(__ca__ int8_t *)static_cast<uint64_t>(bank * 32768);
auto b =(__cb__ int8_t *)static_cast<uint64_t>(bank * 32768);
if(phase >= 2)
cp6_c38::LF(bank,true);
const uint32_t ka = Long ? off : job.k + off;
auto packedA = a1 + ka * mp;
if(k == 128)
asc_copy_l12l0a(a,packedA,0,mp / 4,1,0);
else
for(uint32_t m = 0;m < mp / 16;++m)
asc_copy_l12l0a(a + m * k * 16,packedA + m * 2048,0,k / 32,1,0);
if constexpr(Packed){
asc_copy_l12l0b_trans(b,b1 + off * cubeCols,0,k / 32 *(cubeCols / 32),1,1,false,uint64_t(0));
}else{
for(uint32_t i = 0;i < k / 32;++i)
asc_copy_l12l0b_trans(
b + i * cubeCols * 32,b1 +(off + i * 32)* 32,0,np / 32,span / 32,1,false,uint64_t(0));
}
cp6_c38::LR(bank,false);
if(off + k == span && next.tile.rows){
cp6_c38::L1F(slot,false);
cp6_c38::L1F(slot,true);
if(!secondWave && next.k >= HeadK){
asc_sync_block_wait(7);
secondWave = true;
}
Fetch<M,N,BK,Long,Packed,Compact>(x,w,next,K,width,slot,xStride);
}
cp6_c38::LR(bank,true);
const bool first = job.k + off == 0;
if(first && ordinal)
cp6_large39::CLease(0,true);
if(!first && k == 32)
asc_sync_pipe(PIPE_M);
if constexpr(Compact){
if(cubeCols < 64)
asc_mmad_sync(cc,a,b,mp,k,cubeCols,0,false,false,first);
else
asc_mmad(cc,a,b,mp,k,cubeCols,0,false,false,first);
}else
asc_mmad(cc,a,b,mp,k,cubeCols,0,false,false,first);
cp6_c38::LF(bank,false);
}
if(job.k + span == kp){
if(ordinal >= 2)
asc_sync_block_wait(9 + 2 * output);
asc_sync_notify(PIPE_M,PIPE_FIX,EVENT_ID5);
asc_sync_wait(PIPE_M,PIPE_FIX,EVENT_ID5);
asc_set_l0c_copy_params(1,0,0);
asc_copy_l0c2gm(scratch +(2 * worker + output)* M * N,cc,np,t.rows,np,mp,0,0,0,false,true);
ffts_cross_core_sync(PIPE_FIX,0x21ULL |(uint64_t(8 + 2 * output)<< 8));
cp6_large39::CLease(0,false);
++ordinal;
}
queue[slot] = next;
if(next.tile.rows){
next.k += BK;
if(next.k >= K)
next ={cursor.Next(groups,width),0};
}
}
for(uint32_t i = phase > 2 ? phase - 2 : 0;i < phase;++i)
cp6_c38::LF(i % 2,true);
if(ordinal)
cp6_large39::CLease(0,true);
if(!secondWave)
asc_sync_block_wait(7);
cp6_c38::Drain(ordinal);
}

template <uint32_t M,uint32_t N,bool OwnRows = false>
__aicore__ __attribute__((always_inline))inline void Vector(__gm__ float *scale,__gm__ int64_t *groups,
__gm__ half *y,__gm__ int32_t *scratch,uint32_t E,uint32_t width,uint32_t workers){
auto cursor = Schedule<M,N,OwnRows>(groups,E,width,workers);
hb_fractal_stream::VectorFromCursor<M,N>(cursor,scale,groups,y,scratch,E,width,workers);
}
}// namespace tail_hb_m16
namespace tail_hb_pack16{
using tail_hb_m16::Min;

using tail_hb_m16::Up;

constexpr uint32_t Rows = 16,Chunk = 512,Micro = 128,Bytes = Rows * Chunk;

using Shape = hb_fractal::Shape;

__aicore__ __attribute__((always_inline))inline Shape ReadShape(__gm__ int64_t *groups){
Shape shape{};
uint32_t start = 0;
for(uint32_t e = 0;e < 3;++e){
const uint32_t end = uint32_t(groups[e]);
shape.ends[e] = end;
shape.packed[e + 1] = shape.packed[e] + tail_hb_m16::GroupPad(end - start);
start = end;
}
return shape;
}

using hb_fractal::PackWeights;

using hb_fractal::Prepare;
}// namespace tail_hb_pack16
namespace tail_hb_m16_run{
static __aicore__ __attribute__((noinline, aligned(4096), section(".zzzzzzzzzzzzzzzzzz_hb_fast_outline"))) void Run(__gm__ int8_t *x, __gm__ int8_t *w, __gm__ float *scale,
__gm__ int64_t *g, __gm__ half *y, __gm__ int32_t *scratch, uint32_t E, uint32_t K, uint32_t N, uint32_t W,
uint64_t sync) {
set_ffts_base_addr(sync);
asc_init();
const auto shape = tail_hb_pack16::ReadShape(g);
auto packed = (__gm__ int8_t *)(scratch + uint64_t(W) * 49152);
auto pw = packed + uint64_t(shape.packed[3]) * 8192;
if ASC_IS_AIC
tail_hb_m16::Cube<256, 96, 512, 128, true, true, true, 6144, 512>(
packed, pw, g, scratch, E, K, N, W, shape.packed[3], x, w);
if ASC_IS_AIV {
tail_hb_pack16::Prepare<6144, 2048, 64, 512>(x, packed, shape, K, W, w, pw, N);
tail_hb_m16::Vector<256, 96>(scale, g, y, scratch, E, N, W);
}
asc_sync();
}
}// namespace tail_hb_m16_run

static __aicore__ __attribute__((noinline,aligned(4096),section(".zzzzzzzzzzzz_hb_cold_fallback")))void OwnedHBCold(
__gm__ int8_t *x,__gm__ int8_t *w,__gm__ float *scale,__gm__ int64_t *groups,__gm__ half *y,
__gm__ int32_t *scratch,uint32_t E,uint32_t K,uint32_t N,uint32_t workers,uint64_t sync_base){
const auto shape = hb_fractal::ReadShape(groups);

if(hb_rescue::Jobs<256,96>(shape,N)> workers){
if(hb_rescue::Jobs<192,128>(shape,N)<= workers){
hb_rescue::Run<192,128>(x,w,scale,groups,y,scratch,E,K,N,workers,sync_base,shape);
return;
}
if(hb_rescue::Jobs<128,192>(shape,N)<= workers){
hb_rescue::Run<128,192>(x,w,scale,groups,y,scratch,E,K,N,workers,sync_base,shape);
return;
}
}
HBPackBody<true>(x,w,scale,groups,y,scratch,E,K,N,workers,sync_base);
}
__global__ __mix__(1,2)__attribute__((section(".zzzzzzzzzz_hb_rescue_outline")))
__attribute__((aligned(4096)))void grouped_matmul_gelu_hb_rescue_outline(__gm__ int8_t *x,__gm__ int8_t *w,
__gm__ float *scale,__gm__ int64_t *groups,__gm__ half *y,__gm__ int32_t *scratch,uint32_t E,uint32_t K,
uint32_t N,uint32_t workers,uint64_t sync_base){
const auto shape = hb_fractal::ReadShape(groups);
if(hb_rescue::Jobs<256,96>(shape,N)<= workers){
tail_hb_m16_run::Run(x,w,scale,groups,y,scratch,E,K,N,workers,sync_base);
return;
}
OwnedHBCold(x,w,scale,groups,y,scratch,E,K,N,workers,sync_base);
}

static __aicore__ __attribute__((noinline,aligned(4096),section(".zzzzzzzzzzzz_owned_shadow")))void
OwnedAlignedWeight(__gm__ int8_t *source,__gm__ int8_t *target,uint64_t bytes,uint32_t workers){
constexpr uint32_t Burst = 65536;
const uint32_t rank = 2 * asc_get_block_idx()+ asc_get_sub_block_id(),threads = 2 * workers;
const uint32_t tasks = uint32_t((bytes + Burst - 1)/ Burst);
uint32_t issued = 0;
for(uint32_t task = rank;task < tasks;task += threads,++issued){
const uint32_t bank = issued % 2;
auto ub =(__ubuf__ int8_t *)(uint64_t(4096 + bank * Burst));
if(issued >= 2){
if(bank)
asc_sync_wait(PIPE_MTE3,PIPE_MTE2,EVENT_ID5);
else
asc_sync_wait(PIPE_MTE3,PIPE_MTE2,EVENT_ID4);
}
const uint64_t offset = uint64_t(task)* Burst;
const uint32_t length = uint32_t(bytes - offset < Burst ? bytes - offset : Burst);
asc_copy_gm2ub_align(ub,source + offset,1,length,0,(32 - length % 32)% 32,0,0);
if(bank){
asc_sync_notify(PIPE_MTE2,PIPE_MTE3,EVENT_ID5);
asc_sync_wait(PIPE_MTE2,PIPE_MTE3,EVENT_ID5);
}else{
asc_sync_notify(PIPE_MTE2,PIPE_MTE3,EVENT_ID4);
asc_sync_wait(PIPE_MTE2,PIPE_MTE3,EVENT_ID4);
}
asc_copy_ub2gm_align(target + offset,ub,length);
if(bank)
asc_sync_notify(PIPE_MTE3,PIPE_MTE2,EVENT_ID5);
else
asc_sync_notify(PIPE_MTE3,PIPE_MTE2,EVENT_ID4);
}
for(uint32_t i = issued > 2 ? issued - 2 : 0;i < issued;++i){
if(i % 2)
asc_sync_wait(PIPE_MTE3,PIPE_MTE2,EVENT_ID5);
else
asc_sync_wait(PIPE_MTE3,PIPE_MTE2,EVENT_ID4);
}
ffts_cross_core_sync(PIPE_MTE3,0x1ULL |(14ULL << 8));
asc_sync_block_wait(14);
ffts_cross_core_sync(PIPE_MTE3,0x21ULL |(15ULL << 8));
}

__global__ __mix__(1,2)__attribute__((aligned(4096),
section(
".zzzzzzzzzzzz_owned_shadow_owned_mid_aligned_w")))void grouped_matmul_gelu_owned_mid_aligned_w(__gm__ int8_t
*x,
__gm__ int8_t *w,__gm__ float *scale,__gm__ int64_t *groups,__gm__ half *y,__gm__ int32_t *scratch,uint32_t K,
uint64_t sync_base){
set_ffts_base_addr(sync_base);
asc_init();
const uint32_t shadowWorkers = asc_get_block_num();
auto alignedW =(__gm__ int8_t *)((uint64_t(scratch)+ uint64_t(shadowWorkers)* 163872 + 511)& ~uint64_t(511));
if ASC_IS_AIV
OwnedAlignedWeight(w,alignedW,uint64_t(32)* K * 768,shadowWorkers);
if ASC_IS_AIC
asc_sync_block_wait(15);
w = alignedW;

constexpr uint32_t E = 32,N = 768,W = 20;
const bool owner = cp6_mid_focus::Eligible(groups,E,K,N,W);

if ASC_IS_AIC{
if(owner){
const uint32_t worker = asc_get_block_idx();
other_mid::Fetch initial{other_mid::Init(worker),other_mid::Frame{},0};
other_mid::Panel queue[other_mid::Slots];
for(uint32_t slot = 0;slot < other_mid::Slots;++slot){
queue[slot] = other_mid::NextPanel(initial,groups,worker,K);
if(queue[slot].f.rows)
other_mid::Prefetch(x,w,queue[slot],K,slot);
}
auto cur = breakthrough_mid_balance::ReadCursor(scratch,worker);
const bool wide = cur.wide;
if(cur.balanced){
for(uint32_t slot = 0;slot < other_mid::Slots;++slot)
if(queue[slot].f.rows)
cp6_staged_a::WeightReady(slot,true);
asc_sync_notify(PIPE_MTE1,PIPE_MTE2,EVENT_ID7);
asc_sync_wait(PIPE_MTE1,PIPE_MTE2,EVENT_ID7);
if(wide)
breakthrough_mid_balance::Cube<true>(x,w,groups,scratch,K,cur);
else
breakthrough_mid_balance::Cube<false>(x,w,groups,scratch,K,cur);
}else{
if(wide)
breakthrough_mid_balance::StaticCubeReady<true>(x,w,groups,scratch,K,initial,queue);
else
breakthrough_mid_balance::StaticCubeReady<false>(x,w,groups,scratch,K,initial,queue);
}
}else
cp6_c38::CubeFullGrouped<2,true>(x,w,groups,scratch,E,K,N,W);
}
if ASC_IS_AIV{
if(owner){
auto cur = breakthrough_mid_balance::PrepareCursor(w,groups,scratch,asc_get_block_idx(),K);
const bool wide = cur.wide;
if(cur.balanced){
if(wide)
breakthrough_mid_balance::VectorWideTail(scale,groups,y,scratch,cur);
else
breakthrough_mid_balance::VectorTail(scale,groups,y,scratch,cur);
}else{
if(wide)
other_mid::VectorWideTail(scale,groups,y,scratch);
else
other_mid::VectorTail(scale,groups,y,scratch);
}
}else
cp6_c38::VectorGrouped<2>(scale,groups,y,scratch,E,N,W);
}
asc_sync();
}
__global__ __mix__(1,2)__attribute__((aligned(4096),
section(
".zzzzzzzzzzzz_owned_shadow_owned_large_aligned_w")))void grouped_matmul_gelu_owned_large_aligned_w(__gm__ int8_t
*x,
__gm__ int8_t *w,__gm__ float *scale,__gm__ int64_t *groups,__gm__ half *y,__gm__ int32_t *scratch,uint32_t k,
uint64_t sync_base){
set_ffts_base_addr(sync_base);
asc_init();
const uint32_t shadowWorkers = asc_get_block_num();
auto alignedW =(__gm__ int8_t *)((uint64_t(scratch)+ uint64_t(shadowWorkers)* 135200 + 511)& ~uint64_t(511));
if ASC_IS_AIV
OwnedAlignedWeight(w,alignedW,uint64_t(64)* k * 768,shadowWorkers);
if ASC_IS_AIC
asc_sync_block_wait(15);
w = alignedW;

if ASC_IS_AIC{
const uint32_t worker = asc_get_block_idx();
other_large::Cursor initial{};
other_large::Frame queue[other_large::Slots];
for(uint32_t slot = 0;slot < 1;++slot){
queue[slot] = other_large::Next(initial,groups,worker);
if(queue[slot].rows)
other_large::Prefetch(x,w,queue[slot],k,slot);
}
auto cur = breakthrough_large_balance::ReadCursor(scratch,worker);
if(cur.initialized){
for(uint32_t slot = 0;slot < 1;++slot)
if(queue[slot].rows)
cp6_c38::L1R(slot,true);
asc_sync_notify(PIPE_MTE1,PIPE_MTE2,EVENT_ID7);
asc_sync_wait(PIPE_MTE1,PIPE_MTE2,EVENT_ID7);
breakthrough_large_balance::Cube(x,w,groups,scratch,k,cur);
}else{
for(uint32_t slot = 1;slot < other_large::Slots;++slot){
queue[slot] = other_large::Next(initial,groups,worker);
if(queue[slot].rows)
other_large::Prefetch(x,w,queue[slot],k,slot);
}
breakthrough_large_balance::StaticCubeReady(x,w,groups,scratch,k,initial,queue);
}
}
if ASC_IS_AIV{
auto cur = breakthrough_large_balance::PrepareCursor(groups,scratch,asc_get_block_idx());
if(cur.initialized)
breakthrough_large_balance::VectorTail<true>(scale,groups,y,scratch,cur);
else
other_large::VectorTail<true>(scale,groups,y,scratch);
}
asc_sync();
}
namespace compact_mid{
static __aicore__ __attribute__((noinline,aligned(4096),section(".zzzzzzzzzzzz_hd_half_mid_cube")))void Cube(
__gm__ int8_t *x,__gm__ int8_t *w,__gm__ int64_t *groups,__gm__ int32_t *scratch,uint32_t k,
other_mid::Fetch fetch,other_mid::Panel(&queue)[other_mid::Slots]){
breakthrough_mid_balance::StaticCubeReady<false,true>(x,w,groups,scratch,k,fetch,queue);
}
}

namespace compact_large{
static __aicore__ __attribute__((noinline,aligned(4096),section(".zzzzzzzzzzzz_hd_half_large_cube")))void Cube(
__gm__ int8_t *x,__gm__ int8_t *w,__gm__ int64_t *groups,__gm__ int32_t *scratch,uint32_t k,
other_large::Cursor cursor,other_large::Frame(&queue)[other_large::Slots]){
breakthrough_large_balance::StaticCubeReady<true>(x,w,groups,scratch,k,cursor,queue);
}
}

namespace compact_rows_post{
struct Frame{
uint32_t expert,row,rows,col;
};

struct MidFrames{
other_mid::Cursor cursor;
__aicore__ inline Frame Next(__ubuf__ int64_t *ends,uint32_t worker){
const auto f = other_mid::Next(cursor,ends,worker);
return{f.expert,f.row,f.rows,f.col};
}
};

struct LargeFrames{
other_large::Cursor cursor;
__aicore__ inline Frame Next(__ubuf__ int64_t *ends,uint32_t worker){
const auto f = other_large::Next(cursor,ends,worker);
return{f.expert,f.row,f.rows,f.col};
}
};

template <class Frames,uint32_t Experts,uint32_t Words>
__aicore__ __attribute__((always_inline))inline void Run(
Frames frames,__ubuf__ int64_t *currentEnds,__gm__ float *scale,__gm__ half *y,__gm__ int32_t *scratch){
constexpr uint32_t Columns = 768,TileColumns = 256;
const uint32_t worker = asc_get_block_idx(),sub = asc_get_sub_block_id();
auto ends =(__ubuf__ int64_t *)194560;
asc_copy_ub2ub((__ubuf__ uint8_t *)ends,(__ubuf__ uint8_t *)currentEnds,Experts * 8);
cp6_c38::InitShortCurve();
asc_sync_notify(PIPE_V,PIPE_S,EVENT_ID5);
asc_sync_wait(PIPE_V,PIPE_S,EVENT_ID5);
auto z =(__ubuf__ float *)0;
auto sc =(__ubuf__ float *)181760;
bool pending[2] ={false,false};
uint32_t ordinal = 0;
for(Frame f = frames.Next(ends,worker);f.rows;f = frames.Next(ends,worker),++ordinal){
const uint32_t bank = ordinal % 2,split =(f.rows + 1)/ 2,local = sub * split;
const uint32_t rows = sub ? f.rows - split : split,count = rows * TileColumns;
if(rows)
asc_copy_gm2ub_align(sc,scale + uint64_t(f.expert)* Columns + f.col,TileColumns * 4);
asc_sync_block_wait(8 + 2 * bank);
if(rows){
const auto input =(__gm__ half *)(scratch +(uint64_t(worker)* 2 + bank)* Words);
asc_copy_gm2ub_align((__ubuf__ half *)67584,input + local * TileColumns,count * 2);
asc_sync_notify(PIPE_MTE2,PIPE_V,EVENT_ID7);
}
ffts_cross_core_sync(PIPE_MTE2,0x21ULL |(uint64_t(9 + 2 * bank)<< 8));
if(!rows)
continue;
asc_sync_wait(PIPE_MTE2,PIPE_V,EVENT_ID7);
asc_half2float(z,(__ubuf__ half *)67584,count);
asc_sync_pipe(PIPE_V);
asc_set_mask_norm();
asc_set_vector_mask(uint64_t(0),~uint64_t(0));
asc_mul_scalar(sc,sc,4096.0f,uint8_t(4),1,1,8,8);
asc_sync_pipe(PIPE_V);
for(uint32_t col = 0;col < TileColumns;col += 64)
asc_mul(z + col,z + col,sc + col,uint8_t(rows),1,1,1,32,32,0);
asc_sync_pipe(PIPE_V);
if(pending[bank]){
if(bank)
asc_sync_wait(PIPE_MTE3,PIPE_V,EVENT_ID5);
else
asc_sync_wait(PIPE_MTE3,PIPE_V,EVENT_ID4);
}
auto out =(__ubuf__ half *)(135168 + uint64_t(bank)* 16896);
auto work =(__ubuf__ float *)33792;
cp6_c38::CompactMidpoint<true,true,true>(z,work,work,work,out,nullptr,count);
asc_sync_notify(PIPE_V,PIPE_MTE3,EVENT_ID0);
asc_sync_wait(PIPE_V,PIPE_MTE3,EVENT_ID0);
asc_copy_ub2gm_align(y + uint64_t(f.row + local)* Columns + f.col,out,rows,TileColumns * 2,0,0,0,
(Columns - TileColumns)* 2);
if(bank)
asc_sync_notify(PIPE_MTE3,PIPE_V,EVENT_ID5);
else
asc_sync_notify(PIPE_MTE3,PIPE_V,EVENT_ID4);
pending[bank] = true;
asc_sync_notify(PIPE_V,PIPE_MTE2,EVENT_ID6);
asc_sync_wait(PIPE_V,PIPE_MTE2,EVENT_ID6);
}
if(pending[0])
asc_sync_wait(PIPE_MTE3,PIPE_V,EVENT_ID4);
if(pending[1])
asc_sync_wait(PIPE_MTE3,PIPE_V,EVENT_ID5);
asc_sync();
ffts_cross_core_sync(PIPE_MTE3,0x21ULL |(uint64_t(12)<< 8));
}

static __aicore__ __attribute__((noinline,aligned(4096),section(".zzzzzzzzzzzz_hd_half_vec_mid")))void Mid(
__ubuf__ int64_t *ends,__gm__ float *scale,__gm__ half *y,__gm__ int32_t *scratch){
Run<MidFrames,32,16384>({other_mid::Init(asc_get_block_idx())},ends,scale,y,scratch);
}

static __aicore__ __attribute__((noinline,aligned(4096),section(".zzzzzzzzzzzz_hd_half_vec_large")))void Large(
__ubuf__ int64_t *ends,__gm__ float *scale,__gm__ half *y,__gm__ int32_t *scratch){
Run<LargeFrames,64,16896>({other_large::Cursor{}},ends,scale,y,scratch);
}
}
