template <uint32_t TM,uint32_t BN,uint32_t CK,uint32_t LK>
__aicore__ inline void Prefetch(__gm__ int8_t *w,__cbuf__ int8_t *base,uint32_t e,uint32_t col,uint32_t outer,
uint32_t stage,uint32_t K,uint32_t N){
const uint32_t k0 = outer * CK,kr = Min(CK,K - k0);
asc_copy_gm2l1_nd2nz(base + TM * K + stage * BN * CK,w +(uint64_t(e)* K + k0)* N + col,kr / 32,32,BN,32 * N,
N,32,1,32 * BN);
BR(stage,false);
}

template <uint32_t TM,uint32_t BN,uint32_t CK,uint32_t LK>
__aicore__ inline void Load(__gm__ int8_t *w,__cbuf__ int8_t *base,__ca__ int8_t *a,__cb__ int8_t *b,uint32_t e,
uint32_t col,uint32_t micro,uint32_t K,uint32_t N){
const uint32_t outer_count =(K + CK - 1)/ CK;
const uint32_t slot = micro % 2,k0 = micro * LK,kp = Min(LK,K - k0),outer = k0 / CK,inside = k0 % CK,
stage = outer % 2;
if(!inside)
BR(stage,true);
for(uint32_t ki = 0;ki < kp / 32;++ki)
asc_copy_l12l0a(a + slot * TM * LK + ki * 512,base +(k0 + ki * 32)* TM,0,TM / 16,1,kp / 32 - 1);
asc_copy_l12l0b_trans(b + slot * BN * LK,base + TM * K + stage * BN * CK + inside * BN,0,(kp / 32)*(BN / 32),
1,1,false,uint64_t(0));
LR(slot,false);
const uint32_t kr = Min(CK,K - outer * CK);
if(inside + kp == kr && outer + 2 < outer_count){
BF(stage,false);
BF(stage,true);
Prefetch<TM,BN,CK,LK>(w,base,e,col,outer + 2,stage,K,N);
}
}

template <uint32_t TM,uint32_t BN,uint32_t CK,uint32_t LK>
__aicore__ inline void Dot(__gm__ int8_t *w,__cbuf__ int8_t *base,__ca__ int8_t *a,__cb__ int8_t *b,
__cc__ int32_t *c,uint32_t e,uint32_t col,uint32_t K,uint32_t N,bool preloaded,bool needsLease){
const uint32_t total =(K + LK - 1)/ LK;
if(!preloaded)
for(uint32_t j = 0;j < 2;++j)
Prefetch<TM,BN,CK,LK>(w,base,e,col,j,j,K,N);
Load<TM,BN,CK,LK>(w,base,a,b,e,col,0,K,N);
for(uint32_t micro = 0;micro < total;++micro){
const uint32_t slot = micro % 2,k0 = micro * LK,kp = Min(LK,K - k0);
LR(slot,true);
if(needsLease && micro == 0)
asc_sync_wait(PIPE_FIX,PIPE_M,EVENT_ID6);
asc_mmad(c,a + slot * TM * LK,b + slot * BN * LK,TM,kp,BN,0,false,false,micro == 0);
if(micro + 2 < total)
LF(slot,false);
if(micro + 1 < total){
if(micro + 1 >= 2)
LF((micro + 1)% 2,true);
Load<TM,BN,CK,LK>(w,base,a,b,e,col,micro + 1,K,N);
}
}
asc_sync();
}

template <uint32_t TM,uint32_t BN,uint32_t CK,uint32_t LK>
__aicore__ inline void CubeC(__gm__ int8_t *x,__gm__ int8_t *w,__gm__ int64_t *groups,__gm__ int32_t *scratch,
