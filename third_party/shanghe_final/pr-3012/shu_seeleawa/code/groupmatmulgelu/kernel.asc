asc_float2half_rn(out,p,count);
}

using dfocus::Min;

using dfocus::Up;

template <uint32_t TM,uint32_t BN,bool Balanced = false>
__aicore__ inline void Cube(__gm__ int8_t *x,__gm__ int8_t *w,__gm__ int32_t *scratch,uint32_t worker,uint32_t M,
uint32_t K,uint32_t N,uint32_t span = TM){
const uint32_t nt = Balanced ? 2 :(N + BN - 1)/ BN,row = worker / nt *(Balanced ? span : TM),
col = worker % nt * BN;
const uint32_t mr = Min(Balanced ? span : TM,M - row),nr = Min(BN,N - col),mp = Up(mr,16),kp = Up(K,32),
np = Up(nr,32);
__cbuf__ int8_t *a1 =(__cbuf__ int8_t *)0;
__cbuf__ int8_t *b1 = a1 + Up(TM * kp,1024);
__ca__ int8_t *a =(__ca__ int8_t *)0;
__cb__ int8_t *b =(__cb__ int8_t *)0;
__cc__ int32_t *c =(__cc__ int32_t *)0;
const bool padA = K != kp || mr != mp,padB = K != kp || nr != np;
asc_fill_value_config fill;
fill.config = 0;
fill.repeat = 1;
fill.dst_gap = 0;
if(padA){
fill.blk_num = TM * kp / 32;
asc_fill_l1((__cbuf__ uint16_t *)a1,0U,fill);
}
if(padB){
fill.blk_num = kp * np / 32;
asc_fill_l1((__cbuf__ uint16_t *)b1,0U,fill);
}
if(padA || padB)
asc_sync_pipe(PIPE_MTE2);
asc_copy_gm2l1_nd2nz(a1,x + uint64_t(row)* K,1,mr,K,0,K,TM,1,0);
asc_copy_gm2l1_nd2nz(b1,w + col,1,K,nr,0,N,kp,1,0);
asc_sync_notify(PIPE_MTE2,PIPE_MTE1,EVENT_ID0);
asc_sync_wait(PIPE_MTE2,PIPE_MTE1,EVENT_ID0);
for(uint32_t m = 0;m < mp / 16;++m)
asc_copy_l12l0a(a + m * kp * 16,a1 + m * 512,0,kp / 32,TM / 16,0);
for(uint32_t k = 0;k < kp / 32;++k)
asc_copy_l12l0b_trans(b + k * np * 32,b1 + k * 1024,0,np / 32,kp / 32,1,false,uint64_t(0));
asc_sync_notify(PIPE_MTE1,PIPE_M,EVENT_ID0);
asc_sync_wait(PIPE_MTE1,PIPE_M,EVENT_ID0);
asc_mmad(c,a,b,mp,kp,np,0,false,false,true);
asc_sync_notify(PIPE_M,PIPE_FIX,EVENT_ID0);
asc_sync_wait(PIPE_M,PIPE_FIX,EVENT_ID0);
asc_set_l0c_copy_params(1,0,0);
asc_copy_l0c2gm(scratch + uint64_t(worker)* TM * BN,c,np,mr,BN,mp,0,0,0,false,true);
ffts_cross_core_sync(PIPE_FIX,0x21ULL |(uint64_t(8)<< 8));
}

template <uint32_t TM,uint32_t BN,bool Balanced = false>
__aicore__ inline void Vector(__gm__ float *scale,__gm__ half *y,__gm__ int32_t *scratch,uint32_t worker,uint32_t M,
uint32_t N,uint32_t span,bool mergePrecise){
const uint32_t nt = Balanced ? 2 :(N + BN - 1)/ BN,row = worker / nt *(Balanced ? span : TM),
col = worker % nt * BN;
const uint32_t mr = Min(Balanced ? span : TM,M - row),nr = Min(BN,N - col),halfRows =(mr + 1)/ 2;
const uint32_t local = asc_get_sub_block_id()* halfRows;
const uint32_t rows = mr > local ? Min(halfRows,mr - local): 0,count = Up(rows * BN,64);
__ubuf__ float *z =(__ubuf__ float *)static_cast<uint64_t>(mergePrecise ? 4 * fast_gmg::VQ : 0);
__ubuf__ float *u =(__ubuf__ float *)8192;
__ubuf__ float *p =(__ubuf__ float *)16384;
__ubuf__ half *out =(__ubuf__ half *)24576;
__ubuf__ float *sc =(__ubuf__ float *)28672;
if(!rows){
asc_sync_block_wait(8);
return;
}
if(nr != BN)
asc_duplicate(sc,0.0f,BN);
if(count != rows * BN)
asc_duplicate((__ubuf__ int32_t *)z,int32_t(0),count);
if(nr != BN || count != rows * BN){
asc_sync_notify(PIPE_V,PIPE_MTE2,EVENT_ID1);
asc_sync_wait(PIPE_V,PIPE_MTE2,EVENT_ID1);
}
asc_copy_gm2ub_align(sc,scale + col,nr * 4);
asc_sync_block_wait(8);
asc_copy_gm2ub_align((__ubuf__ int32_t *)z,scratch +(uint64_t(worker)* TM + local)* BN,rows * BN * 4);
asc_sync_notify(PIPE_MTE2,PIPE_V,EVENT_ID1);
asc_sync_wait(PIPE_MTE2,PIPE_V,EVENT_ID1);
asc_int322float_rn(z,(__ubuf__ int32_t *)z,count);
asc_sync_pipe(PIPE_V);
asc_set_mask_norm();
asc_set_vector_mask(uint64_t(0),BN == 32 ? uint64_t(0xffffffff): ~uint64_t(0));
asc_mul(z,z,sc,uint8_t(rows),1,1,1,BN / 8,BN / 8,0);
if constexpr(BN == 128)
asc_mul(z + 64,z + 64,sc + 64,uint8_t(rows),1,1,1,BN / 8,BN / 8,0);
asc_sync_pipe(PIPE_V);
asc_set_vector_mask(~uint64_t(0),~uint64_t(0));
if(mergePrecise){
gmg16::FinishGelu(count);
out =(__ubuf__ half *)(24 * fast_gmg::VQ + 512);
}else
GeluWide(z,u,p,out,count,nr,BN);
asc_sync_notify(PIPE_V,PIPE_MTE3,EVENT_ID0);
asc_sync_wait(PIPE_V,PIPE_MTE3,EVENT_ID0);
asc_copy_ub2gm_align(
y + uint64_t(row + local)* N + col,out,rows,nr * 2,0,0,(BN - Up(nr,16))/ 16,(N - nr)* 2);
}
}// namespace d7_tiny_fast

__global__ __mix__(1,2)__attribute__((section(".zsmall_held")))void grouped_matmul_gelu_df_held_fast(
__gm__ int8_t *x,__gm__ int8_t *w,__gm__ float *scale,__gm__ half *y,__gm__ int32_t *scratch,uint32_t M,
uint32_t K,uint32_t N,uint64_t sync_base,bool mergePrecise){
set_ffts_base_addr(sync_base);
asc_init();
const uint32_t worker = asc_get_block_idx(),span =(M + 1)/ 2;
if ASC_IS_AIC
d7_tiny_fast::Cube<32,64,true>(x,w,scratch,worker,M,K,N,span);
if ASC_IS_AIV
d7_tiny_fast::Vector<32,64,true>(scale,y,scratch,worker,M,N,span,mergePrecise);
asc_sync();
}

namespace other_ha_cube{
using dfocus::Min;

using dfocus::Up;

constexpr uint32_t BlockM = 96,BlockN = 128;

__aicore__ inline uint32_t PackedColumns(uint32_t width,uint32_t col){return col == 256 ? width - col : 128;}

__aicore__ __attribute__((always_inline))inline void LoadX(
__cbuf__ int8_t *dst,__gm__ int8_t *x,uint32_t row,uint32_t rows,uint32_t k,uint32_t kp){
const uint32_t mp = Up(rows,32);
asc_copy_gm2l1_nd2nz(dst,x + uint64_t(row)* k,1,rows,k,0,k,mp,1,0);
}

template <uint32_t Slots,bool Prefetch = false,bool Packed = false,bool Direct = false>
__aicore__ __attribute__((always_inline))inline void Cube(__gm__ int8_t *x,__gm__ int8_t *w,__gm__ int64_t *groups,
__gm__ int32_t *scratch,uint32_t E,uint32_t K,uint32_t N,uint32_t workers){
constexpr uint32_t StepK = Packed ? 192 : 256;
static_assert(!Direct || Packed);
const uint32_t worker = asc_get_block_idx(),kp = Up(K,32),np = Up(N,32);
const uint32_t tiles = d6_ha_owned::RowTiles(groups,E),quotient = tiles / workers,remainder = tiles % workers;
const uint32_t first = worker * quotient + Min(worker,remainder),last = first + quotient +(worker < remainder);
auto a1 =(__cbuf__ int8_t *)0;
auto b1 = a1 +(Prefetch ? 2 : 1)* BlockM * kp;
auto a =(__ca__ int8_t *)0;
uint32_t prefix = 0,start = 0,phase = 0,ordinal = 0;
const uint32_t parts =(kp + StepK - 1)/ StepK;
for(uint32_t expert = 0;expert < E && prefix < last;++expert){
const uint32_t end = uint32_t(groups[expert]),count =(end - start + BlockM - 1)/ BlockM;
const uint32_t begin = first > prefix ? Min(first - prefix,count): 0;
const uint32_t stop = Min(last - prefix,count);
for(uint32_t tile = begin;tile < stop;++tile){
const uint32_t row = start + tile * BlockM,rows = Min(BlockM,end - row),mp = Up(rows,32);
const uint32_t input = Prefetch ?(tile - begin)% 2 : 0;
auto localA = a1 + input * BlockM * kp;
if(!Prefetch || tile == begin){
if(phase){
asc_sync_notify(PIPE_MTE1,PIPE_MTE2,EVENT_ID7);
asc_sync_wait(PIPE_MTE1,PIPE_MTE2,EVENT_ID7);
}
LoadX(localA,x,row,rows,K,kp);
if(tile == begin){
if constexpr(Packed){
if constexpr(!Direct)
if(!phase)
asc_sync_block_wait(0);
for(uint32_t col = 0;col < N;){
const uint32_t cols = PackedColumns(N,col),padded = Up(cols,32);
if constexpr(Direct){
auto src = w + uint64_t(expert)* K * N + col;
auto dst = b1 + col * kp;
const uint32_t full = K / 32,tail = K % 32;
asc_copy_gm2l1_nd2nz(dst,src,full,32,cols,32 * N,N,32,1,padded * 32);
if(tail)
asc_copy_gm2l1_nd2nz(
dst + full * 32 * padded,src + full * 32 * N,1,tail,cols,0,N,32,1,0);
}else
asc_copy_gm2l1(b1 + col * kp,w + uint64_t(expert)* kp * np + col * 32,kp / 32,
padded,np - padded,0);
col += cols;
}
}else
asc_copy_gm2l1_nd2nz(b1,w + uint64_t(expert)* K * N,1,K,N,0,N,kp,1,0);
}
cp6_c38::L1R(input,false);
}
cp6_c38::L1R(input,true);
if(phase)
asc_sync_wait(PIPE_M,PIPE_MTE1,EVENT_ID7);
for(uint32_t kk = 0;kk < kp;kk += StepK){
const uint32_t k = Min(StepK,kp - kk);
for(uint32_t i = 0;i < k / 32;++i)
asc_copy_l12l0a(a + kk * mp + i * 512,localA +(kk + i * 32)* mp,0,mp / 16,1,k / 32 - 1);
}
if constexpr(Prefetch)
if(tile + 1 < stop){
if(tile != begin){
asc_sync_notify(PIPE_MTE1,PIPE_MTE2,EVENT_ID7);
asc_sync_wait(PIPE_MTE1,PIPE_MTE2,EVENT_ID7);
}
const uint32_t nextRow = row + BlockM;
LoadX(a1 +(1 - input)* BlockM * kp,x,nextRow,Min(BlockM,end - nextRow),K,kp);
cp6_c38::L1R(1 - input,false);
}
for(uint32_t col = 0;col < N;++ordinal){
const uint32_t cols = Packed ? PackedColumns(N,col): Min(BlockN,N - col),width = Up(cols,32);
const uint32_t cbank = ordinal % 2,slot = ordinal % Slots;
const uint32_t ready =(Slots == 4 ? 0 : 8)+ 2 * slot;
auto c =(__cc__ int32_t *)(uint64_t(cbank)* 65536);
for(uint32_t part = 0;part < parts;++part,++phase){
const uint32_t kk = part * StepK,k = Min(StepK,kp - kk),bank = phase % 2;
auto b =(__cb__ int8_t *)(uint64_t(bank)* 32768);
if(phase >= 2)
cp6_c38::LF(bank,true);
if constexpr(Packed)
asc_copy_l12l0b_trans(
b,b1 + col * kp + kk * width,0,k / 32 *(width / 32),1,1,false,uint64_t(0));
else
for(uint32_t n = 0;n < width / 32;++n)
asc_copy_l12l0b_trans(b + n * 1024,b1 +(col + n * 32)* kp + kk * 32,0,k / 32,1,
2 *(width / 32)- 1,false,uint64_t(0));
cp6_c38::LR(bank,false);
cp6_c38::LR(bank,true);
if(!part && ordinal >= 2)
cp6_large39::CLease(cbank,true);
if(part && k == 32)
asc_sync_pipe(PIPE_M);
if(width < 64 || mp < 64)
asc_mmad_sync(c,a + kk * mp,b,mp,k,width,0,false,false,!part);
else
asc_mmad(c,a + kk * mp,b,mp,k,width,0,false,false,!part);
cp6_c38::LF(bank,false);
}
if(Packed ? col + cols == N : col + BlockN >= N)
asc_sync_notify(PIPE_M,PIPE_MTE1,EVENT_ID7);
if(ordinal >= Slots)
asc_sync_block_wait(ready + 1);
asc_sync_notify(PIPE_M,PIPE_FIX,EVENT_ID5);
asc_sync_wait(PIPE_M,PIPE_FIX,EVENT_ID5);
asc_set_l0c_copy_params(1,0,0);
asc_copy_l0c2gm(scratch +(uint64_t(worker)* Slots + slot)* 16384,c,width,rows,width,mp,0,0,0,
false,true);
ffts_cross_core_sync(PIPE_FIX,0x21ULL |(uint64_t(ready)<< 8));
cp6_large39::CLease(cbank,false);
col += Packed ? cols : BlockN;
}
}
prefix += count;
start = end;
}
if constexpr(Packed && !Direct)
if(!phase)
asc_sync_block_wait(0);
if(phase)
asc_sync_wait(PIPE_M,PIPE_MTE1,EVENT_ID7);
for(uint32_t i = phase > 2 ? phase - 2 : 0;i < phase;++i)
cp6_c38::LF(i % 2,true);
for(uint32_t i = ordinal > 2 ? ordinal - 2 : 0;i < ordinal;++i)
cp6_large39::CLease(i % 2,true);
for(uint32_t i = ordinal > Slots ? ordinal - Slots : 0;i < ordinal;++i)
asc_sync_block_wait((Slots == 4 ? 1 : 9)+ 2 *(i % Slots));
asc_sync_block_wait(12);
}
}// namespace other_ha_cube

namespace other_post{
using dfocus::Up;

struct Frame{
uint32_t expert,row,col,rows,nr,bn,tile,offset;
bool first,last;
};

}// namespace other_post

namespace wave_overlap{
__aicore__ __attribute__((always_inline))inline void Pack(
__gm__ int8_t *,__gm__ int8_t *,__gm__ int64_t *,uint32_t,uint32_t,uint32_t,uint32_t,uint32_t);
}// namespace wave_overlap

namespace wave_overlap{
__aicore__ inline void InitPackOffsetsFast(uint32_t n){
const uint32_t pitch = dfocus::Up(n,32),blocks = pitch / 32,shift = n % 32;
auto even =(__ubuf__ int32_t *)186368;
auto odd = even + pitch / 2;
for(uint32_t r = 0;r < 16;++r){
even[r] = 2 * r * n;
odd[r] =(2 * r + 1)* n + shift;
}
asc_sync_notify(PIPE_S,PIPE_V,EVENT_ID7);
asc_sync_wait(PIPE_S,PIPE_V,EVENT_ID7);
for(uint32_t used = 1;used < blocks;used *= 2){
const uint32_t count = 16 * dfocus::Min(used,blocks - used);
asc_add_scalar(even + used * 16,even,int32_t(used * 32),count);
asc_add_scalar(odd + used * 16,odd,int32_t(used * 32),count);
asc_sync_pipe(PIPE_V);
}
}
}// namespace wave_overlap

namespace hers_post{
using dfocus::Up;

struct Frame{
uint32_t expert,row,col,rows,nr,bn,tile,offset;
bool first,last;
};

template <uint32_t Slots,uint32_t Words,bool Fma,typename Cursor>
__aicore__ __attribute__((always_inline))inline void Vector(
Cursor cursor,__gm__ float *scale,__gm__ int64_t *groups,__gm__ half *y,__gm__ int32_t *scratch,uint32_t n){
const uint32_t worker = asc_get_block_idx(),sub = asc_get_sub_block_id();
bool pending[2] ={};
uint32_t batch = 0,scaleKey = uint32_t(-1);
set_mov_pad_val(uint32_t(0));
auto coeff =(__ubuf__ float *)194816;
if constexpr(true){
asc_duplicate(coeff,-0.07135481627260025f,uint32_t(64));
asc_duplicate(coeff + 64,-1.5957691216057308f,uint32_t(64));
asc_sync_pipe(PIPE_V);
}
for(Frame f{};cursor.Next(f,groups,n,sub);){
const uint32_t slot = f.tile % Slots,ready =(Slots == 4 ? 0 : 8)+ 2 * slot;
const bool odd =(batch & 1)!= 0;
auto z =(__ubuf__ float *)static_cast<uint64_t>(odd ? 38912 : 0);
auto u =(__ubuf__ float *)77824;
auto sc =(__ubuf__ float *)116736;
auto out =(__ubuf__ half *)static_cast<uint64_t>(odd ? 139264 : 119808);
if(f.rows){
if(batch >= 2){
if(odd)
asc_sync_wait(PIPE_V,PIPE_MTE2,EVENT_ID3);
else
asc_sync_wait(PIPE_V,PIPE_MTE2,EVENT_ID2);
}
const uint32_t key = f.expert * n + f.col;
if(key != scaleKey){
if(batch){
asc_sync_notify(PIPE_V,PIPE_MTE2,EVENT_ID7);
asc_sync_wait(PIPE_V,PIPE_MTE2,EVENT_ID7);
}
asc_copy_gm2ub_align(sc,scale + key,1,f.nr * 4,0,Up(f.nr,8)- f.nr,0,0);
scaleKey = key;
}
}
if(f.first)
asc_sync_block_wait(ready);
if(f.rows){
const uint32_t size = f.rows * f.bn,count = Up(size,64);
const auto src = scratch +(uint64_t(worker)* Slots + slot)* Words + f.offset * f.bn;
asc_copy_gm2ub_align((__ubuf__ int32_t *)z,src,1,size * 4,0,0,0,0);
asc_sync_notify(PIPE_MTE2,PIPE_V,EVENT_ID0);
asc_sync_wait(PIPE_MTE2,PIPE_V,EVENT_ID0);
asc_int322float_rn(z,(__ubuf__ int32_t *)z,count);
asc_sync_pipe(PIPE_V);
asc_set_mask_norm();
for(uint32_t col = 0;col < f.bn;col += 64){
asc_set_vector_mask(uint64_t(0),f.bn - col >= 64 ? ~uint64_t(0): uint64_t(0xffffffff));
asc_mul(z + col,z + col,sc + col,uint8_t(f.rows),1,1,1,f.bn / 8,f.bn / 8,0);
}
asc_sync_pipe(PIPE_V);
asc_set_vector_mask(~uint64_t(0),~uint64_t(0));
if constexpr(true){
const uint8_t repeat = uint8_t(count / 64);
asc_mul(u,z,z,repeat,1,1,1,8,8,8);
asc_sync_pipe(PIPE_V);
asc_mul_add(u,coeff,coeff + 64,repeat,1,1,1,8,0,0);
asc_sync_pipe(PIPE_V);
asc_mul(u,u,z,repeat,1,1,1,8,8,8);
asc_sync_pipe(PIPE_V);
asc_min_scalar(u,u,80.0f,repeat,1,1,8,8);
asc_sync_pipe(PIPE_V);
asc_exp(u,u,repeat,1,1,8,8);
asc_sync_pipe(PIPE_V);
asc_add_scalar(u,u,1.0f,repeat,1,1,8,8);
asc_sync_pipe(PIPE_V);
asc_div(z,z,u,repeat,1,1,1,8,8,8);
asc_sync_pipe(PIPE_V);
}else{
asc_mul(u,z,z,count);
asc_sync_pipe(PIPE_V);
asc_mul(u,u,z,count);
asc_sync_pipe(PIPE_V);
asc_mul_scalar(u,u,0.044715f,count);
asc_sync_pipe(PIPE_V);
asc_add(u,u,z,count);
asc_sync_pipe(PIPE_V);
asc_mul_scalar(u,u,0.7978845608028654f,count);
asc_sync_pipe(PIPE_V);
asc_mul_scalar(u,u,-2.0f,count);
asc_sync_pipe(PIPE_V);
asc_min_scalar(u,u,80.0f,count);
asc_sync_pipe(PIPE_V);
asc_exp(u,u,count);
asc_sync_pipe(PIPE_V);
asc_add_scalar(u,u,1.0f,count);
asc_sync_pipe(PIPE_V);
asc_div(z,z,u,count);
asc_sync_pipe(PIPE_V);
}
if(pending[odd]){
if(odd)
asc_sync_wait(PIPE_MTE3,PIPE_V,EVENT_ID3);
else
asc_sync_wait(PIPE_MTE3,PIPE_V,EVENT_ID2);
}
asc_float2half_rn(out,z,count);
asc_sync_notify(PIPE_V,PIPE_MTE3,EVENT_ID0);
asc_sync_wait(PIPE_V,PIPE_MTE3,EVENT_ID0);
asc_copy_ub2gm_align(y + uint64_t(f.row)* n + f.col,out,f.rows,f.nr * 2,0,0,
(f.bn - Up(f.nr,16))/ 16,(n - f.nr)* 2);
if(odd){
asc_sync_notify(PIPE_MTE3,PIPE_V,EVENT_ID3);
asc_sync_notify(PIPE_V,PIPE_MTE2,EVENT_ID3);
}else{
asc_sync_notify(PIPE_MTE3,PIPE_V,EVENT_ID2);
asc_sync_notify(PIPE_V,PIPE_MTE2,EVENT_ID2);
}
pending[odd] = true;
++batch;
}
if(f.last)
ffts_cross_core_sync(PIPE_MTE2,0x21ULL |(uint64_t(ready + 1)<< 8));
}
if(pending[0]){
asc_sync_wait(PIPE_MTE3,PIPE_V,EVENT_ID2);
asc_sync_wait(PIPE_V,PIPE_MTE2,EVENT_ID2);
}
if(pending[1]){
asc_sync_wait(PIPE_MTE3,PIPE_V,EVENT_ID3);
asc_sync_wait(PIPE_V,PIPE_MTE2,EVENT_ID3);
}
ffts_cross_core_sync(PIPE_MTE3,0x21ULL |(12ULL << 8));
}
}// namespace hers_post

namespace hers_parity{
using dfocus::Min;

using dfocus::Up;

__aicore__ __attribute__((always_inline))inline void Pack(__gm__ int8_t *w,__gm__ int8_t *packed,
__gm__ int64_t *groups,uint32_t k,uint32_t n,uint32_t workers,uint32_t first,uint32_t last){
const uint32_t rank = 2 * asc_get_block_idx()+ asc_get_sub_block_id(),stride = 2 * workers;
const uint32_t kp = Up(k,32),pitch = Up(n,32),shift = n % 32,parts = kp / 32;
constexpr uint32_t BankBytes = 35840;
auto dst =(__ubuf__ int8_t *)(4 * BankBytes);
auto offsets =(__ubuf__ uint32_t *)186368;
set_mov_pad_val(uint32_t(0));
asc_set_mask_norm();
asc_set_vector_mask(~uint64_t(0),~uint64_t(0));
uint32_t batch = 0;
for(uint32_t tile = rank;tile <(last - first)* parts;tile += stride){
const uint32_t expert = first + tile / parts,row =(tile % parts)* 32;
if(expert && groups[expert] == groups[expert - 1])
continue;
if(!expert && !groups[0])
continue;
const bool odd = batch % 2;
auto src =(__ubuf__ int8_t *)static_cast<uint64_t>(odd ? 2 * BankBytes : 0);
auto alternate = src + BankBytes;
if(batch >= 2){
if(odd)
asc_sync_wait(PIPE_V,PIPE_MTE2,EVENT_ID6);
else
asc_sync_wait(PIPE_V,PIPE_MTE2,EVENT_ID5);
}
const uint32_t rows = Min(32U,k - row),bytes = rows * n;
if(rows < 32){
asc_duplicate((__ubuf__ int32_t *)src,int32_t(0),uint32_t(BankBytes / 4));
if(shift)
asc_duplicate((__ubuf__ int32_t *)alternate,int32_t(0),uint32_t(BankBytes / 4));
asc_sync_notify(PIPE_V,PIPE_MTE2,EVENT_ID0);
asc_sync_wait(PIPE_V,PIPE_MTE2,EVENT_ID0);
}
auto raw = w +(uint64_t(expert)* k + row)* n;
if(shift % 16 == 0){
asc_copy_gm2ub_align(src,raw,1,bytes,0,Up(bytes,32)- bytes,0,0);
if(shift)
asc_copy_gm2ub_align(alternate,raw,1,bytes,shift,Up(bytes + shift,32)- bytes - shift,0,0);
}else{
asc_copy_gm2ub_align(src,raw,(rows + 1)/ 2,n,0,pitch - n,n,0);
if(rows > 1)
asc_copy_gm2ub_align(alternate,raw + n,rows / 2,n,0,pitch - n,n,0);
}
asc_sync_notify(PIPE_MTE2,PIPE_V,EVENT_ID0);
asc_sync_wait(PIPE_MTE2,PIPE_V,EVENT_ID0);
if(batch)
asc_sync_wait(PIPE_MTE3,PIPE_V,EVENT_ID4);
asc_gather_datablock((__ubuf__ uint32_t *)dst,(__ubuf__ uint32_t *)src,offsets,16,2,pitch / 16);
asc_gather_datablock((__ubuf__ uint32_t *)(dst + 32),(__ubuf__ uint32_t *)(shift ? alternate : src),
offsets + pitch / 2,16,2,pitch / 16);
asc_sync_notify(PIPE_V,PIPE_MTE3,EVENT_ID0);
asc_sync_wait(PIPE_V,PIPE_MTE3,EVENT_ID0);
asc_copy_ub2gm_align(packed +(uint64_t(expert - first)* kp + row)* pitch,dst,pitch * 32);
asc_sync_notify(PIPE_MTE3,PIPE_V,EVENT_ID4);
if(odd)
asc_sync_notify(PIPE_V,PIPE_MTE2,EVENT_ID6);
else
asc_sync_notify(PIPE_V,PIPE_MTE2,EVENT_ID5);
++batch;
}
if(batch){
asc_sync_wait(PIPE_MTE3,PIPE_V,EVENT_ID4);
asc_sync_wait(PIPE_V,PIPE_MTE2,EVENT_ID5);
}
if(batch >= 2)
asc_sync_wait(PIPE_V,PIPE_MTE2,EVENT_ID6);
asc_sync();
}

__aicore__ inline void Init(uint32_t n){
const uint32_t pitch = Up(n,32),blocks = pitch / 32;
auto offsets =(__ubuf__ int32_t *)186368;
const bool contiguous = n % 16 == 0;
auto odd = offsets + pitch / 2;
for(uint32_t r = 0;r < 16;++r){
offsets[r] = r *(contiguous ? 2 * n : pitch);
odd[r] = offsets[r] +(contiguous ? n + n % 32 : 0);
}
asc_sync_notify(PIPE_S,PIPE_V,EVENT_ID7);
asc_sync_wait(PIPE_S,PIPE_V,EVENT_ID7);
for(uint32_t used = 1;used < blocks;used *= 2){
const uint32_t count = 16 * Min(used,blocks - used);
asc_add_scalar(offsets + used * 16,offsets,int32_t(used * 32),count);
asc_add_scalar(odd + used * 16,odd,int32_t(used * 32),count);
asc_sync_pipe(PIPE_V);
}
}
}// namespace hers_parity

namespace hers_rect{
using dfocus::Min;

struct Rect{
uint32_t expert,row,rows,col,cols;
};

struct Rects{
uint32_t expert = 0,row = 0,col = 0,left = 0;
__aicore__ __attribute__((always_inline))inline Rect Next(__gm__ int64_t *groups,uint32_t width){
const uint32_t blocks =(width + 31)/ 32;
while(left){
const uint32_t end = uint32_t(groups[expert]);
if(end != row){
const uint32_t take = Min(Min(blocks - col,left),10U);
Rect rect{expert,row,end - row,col * 32,Min(take * 32,width - col * 32)};
left -= take;
col += take;
if(col == blocks){
++expert;
row = end;
col = 0;
}
return rect;
}
++expert;
}
return{};
}
};

__aicore__ __attribute__((always_inline))inline uint32_t RectCost(uint32_t rows){
return rows ? dfocus::Up(rows,128)+ 512 : 0;
}

__aicore__ __attribute__((always_inline))inline Rects Schedule(
__gm__ int64_t *groups,uint32_t E,uint32_t width,uint32_t workers){
uint32_t weight = 0,previous = 0;
const uint32_t blocks =(width + 31)/ 32,worker = asc_get_block_idx();
for(uint32_t e = 0;e < E;++e){
const uint32_t end = uint32_t(groups[e]);
weight += blocks * RectCost(end - previous);
previous = end;
}
const uint32_t lower = weight * worker / workers,upper = weight *(worker + 1)/ workers;
uint32_t prefix = 0,ordinal = 0,first = 0,last = 0;
bool found = false;
Rects result{};
previous = 0;
for(uint32_t e = 0;e < E;++e){
const uint32_t end = uint32_t(groups[e]),cost = RectCost(end - previous);
if(cost){
const uint32_t limit = prefix + blocks * cost;
if(!found && lower < limit){
result.expert = e;
result.row = previous;
result.col =(lower - prefix)/ cost;
first = ordinal + result.col;
found = true;
}
if(upper <= limit){
last = ordinal +(upper - prefix)/ cost;
break;
}
ordinal += blocks;
prefix = limit;
}
previous = end;
}
if(found)
result.left = last - first;
return result;
}
}// namespace hers_rect

namespace shared_weight_prefetch{
template <uint32_t Divisor,bool Later = false,bool Bounded = false>
__aicore__ __attribute__((always_inline))inline void Read(
__gm__ int8_t *w,uint32_t experts,uint32_t k,uint32_t n,uint32_t workers){
constexpr uint32_t BurstBytes = 65536;
static_assert(!Later || Divisor > 1);
const uint32_t rank = 2 * asc_get_block_idx()+ asc_get_sub_block_id();
const uint32_t stride = 2 * workers,expertBytes = k * n;
const uint32_t start = Later ?(k / Divisor)* n : 0;
const uint32_t prefix =(expertBytes + Divisor - 1)/ Divisor;
const uint32_t parts =(prefix + BurstBytes - 1)/ BurstBytes;
// Bound the extra work before the first C slab becomes ready.
if constexpr(Bounded)
if(experts * parts > stride * 4)
return;
auto ub =(__ubuf__ int8_t *)0;
uint32_t issued = 0;
for(uint32_t task = rank;task < experts * parts;task += stride){
const uint32_t offset =(task % parts)* BurstBytes;
const uint32_t left = prefix - offset,bytes = left < BurstBytes ? left : BurstBytes;
asc_copy_gm2ub_align(ub +(issued % 2)* BurstBytes,w + uint64_t(task / parts)* expertBytes + start + offset,
1,bytes,0,(32 - bytes % 32)% 32,0,0);
++issued;
if(issued % 2 == 0)
asc_sync_pipe(PIPE_MTE2);
}
if(issued % 2)
asc_sync_pipe(PIPE_MTE2);
}
}// namespace shared_weight_prefetch

namespace hers_full{
__aicore__ __attribute__((always_inline))inline void LoadNZ(
__cbuf__ int8_t *dst,__gm__ int8_t *raw,uint32_t rows,uint32_t cols,uint32_t stride,uint32_t pitch){
if(stride % 32 == 16 && rows >= 2){
asc_copy_gm2l1_nd2nz(dst,raw,1,(rows + 1)/ 2,cols,0,2 * stride,pitch,2,0);
asc_copy_gm2l1_nd2nz(dst + 32,raw + stride,1,rows / 2,cols,0,2 * stride,pitch,2,0);
}else
asc_copy_gm2l1_nd2nz(dst,raw,1,rows,cols,0,stride,pitch,1,0);
}

using dfocus::Min;

using dfocus::Up;

__aicore__ __attribute__((always_inline))inline uint32_t RowTile(uint32_t cols){
return Min(128U,(1024 / Up(cols,32))* 32);
}

struct RowSplit{
uint32_t parts,blocks,extra;
};

__aicore__ __attribute__((always_inline))inline RowSplit SplitRows(uint32_t rows,uint32_t cap){
const uint32_t blocks = Up(rows,32)/ 32,capacity = cap / 32;
const uint32_t parts =(blocks + capacity - 1)/ capacity;
return{parts,blocks / parts,blocks % parts};
}

__aicore__ __attribute__((always_inline))inline uint32_t BlockRows(RowSplit split,uint32_t index,uint32_t left){
return Min(left,(split.blocks +(index < split.extra))* 32);
}

struct Frames{
hers_rect::Rects rects;
hers_rect::Rect rect{};
uint32_t row = 0,offset = 0,tile = 0,part = 0;
__aicore__ __attribute__((always_inline))inline bool Next(
hers_post::Frame &frame,__gm__ int64_t *groups,uint32_t n,uint32_t sub){
if(!rect.rows)
rect = rects.Next(groups,n);
if(!rect.rows)
return false;
const RowSplit plan = SplitRows(rect.rows,RowTile(rect.cols));
const uint32_t rows = BlockRows(plan,part,rect.rows - row),chunk = Min(56U,rows - offset);
const uint32_t split =(chunk + 1)/ 2,local = split * sub;
frame ={rect.expert,rect.row + row + offset + local,rect.col,sub ? chunk - split : split,rect.cols,
Up(rect.cols,32),tile,offset + local,!offset,offset + chunk == rows};
offset += chunk;
if(frame.last){
++tile;
row += rows;
++part;
offset = 0;
if(row == rect.rows){
row = 0;
part = 0;
rect ={};
}
}
return true;
}
};

template <bool Packed,bool Notify = true>
__aicore__ __attribute__((always_inline))inline void LoadX(
__cbuf__ int8_t *a1,__gm__ int8_t *x,uint32_t row,uint32_t rows,uint32_t k,uint32_t kp,uint32_t slot){
const uint32_t mp = Up(rows,32);
if constexpr(Packed)
LoadNZ(a1,x + uint64_t(row)* k,rows,k,k,mp);
else
asc_copy_gm2l1_nd2nz(a1,x + uint64_t(row)* k,1,rows,k,0,k,mp,1,0);
if constexpr(Notify)
cp6_c38::L1R(slot,false);
}

template <bool Packed>
__aicore__ __attribute__((always_inline))inline void Cube(__gm__ int8_t *x,__gm__ int8_t *w,__gm__ int64_t *groups,
__gm__ int32_t *ws,uint32_t E,uint32_t K,uint32_t N,uint32_t W,uint32_t l1){
auto rects = hers_rect::Schedule(groups,E,N,W);
const uint32_t kp = Up(K,32),worker = asc_get_block_idx();
auto a1 =(__cbuf__ int8_t *)0;
auto c =(__cc__ int32_t *)0;
uint32_t phase = 0,ordinal = 0;
for(auto rect = rects.Next(groups,N);rect.rows;rect = rects.Next(groups,N)){
const uint32_t tm = RowTile(rect.cols),np = Up(rect.cols,32);
const uint32_t step = Min(256U,(1024 /(tm > np ? tm : np))* 32);
const bool doubleA =(2 * tm + np)* kp <= l1;
auto b1 = a1 +(doubleA ? 2 : 1)* tm * kp;
if(phase){
asc_sync_notify(PIPE_MTE1,PIPE_MTE2,EVENT_ID7);
asc_sync_wait(PIPE_MTE1,PIPE_MTE2,EVENT_ID7);
}
const RowSplit plan = SplitRows(rect.rows,tm);
const uint32_t firstRows = BlockRows(plan,0,rect.rows);
if constexpr(Packed){
LoadX<Packed,false>(a1,x,rect.row,firstRows,K,kp,0);
if(!phase)
asc_sync_block_wait(0);
const uint32_t pitch = Up(N,32);
asc_copy_gm2l1(b1,w + uint64_t(rect.expert)* kp * pitch + rect.col * 32,kp / 32,np,pitch - np,0);
cp6_c38::L1R(0,false);
}else{
asc_copy_gm2l1_nd2nz(b1,w + uint64_t(rect.expert)* K * N + rect.col,1,K,rect.cols,0,N,kp,1,0);
LoadX<Packed>(a1,x,rect.row,firstRows,K,kp,0);
}
for(uint32_t row = 0,part = 0;part < plan.parts;++part,++ordinal){
const uint32_t rows = BlockRows(plan,part,rect.rows - row),mp = Up(rows,32),slot = ordinal % 2;
const uint32_t nextRow = row + rows;
const bool hasNext = part + 1 < plan.parts;
const uint32_t nextRows = hasNext ? BlockRows(plan,part + 1,rect.rows - nextRow): 0;
const uint32_t input = doubleA ? part % 2 : 0;
auto localA = a1 + input * tm * kp;
cp6_c38::L1R(input,true);
if(doubleA && hasNext){
if(part){
cp6_c38::L1F(1 - input,false);
cp6_c38::L1F(1 - input,true);
}
LoadX<Packed>(a1 +(1 - input)* tm * kp,x,rect.row + nextRow,nextRows,K,kp,1 - input);
}
for(uint32_t off = 0;off < kp;off += step,++phase){
const uint32_t k = Min(step,kp - off),bank = phase % 2;
auto a =(__ca__ int8_t *)(uint64_t(bank)* 32768);
auto b =(__cb__ int8_t *)(uint64_t(bank)* 32768);
if(phase >= 2)
cp6_c38::LF(bank,true);
for(uint32_t p = 0;p < k / 32;++p){
asc_copy_l12l0a(a + p * 512,localA +(off + p * 32)* mp,0,mp / 16,1,k / 32 - 1);
if constexpr(!Packed)
asc_copy_l12l0b_trans(
b + p * np * 32,b1 +(off + p * 32)* 32,0,np / 32,kp / 32,1,false,uint64_t(0));
}
if constexpr(Packed)
asc_copy_l12l0b_trans(b,b1 + off * np,0,k / 32 *(np / 32),1,1,false,uint64_t(0));
cp6_c38::LR(bank,false);
if(!doubleA && off + k == kp && hasNext){
cp6_c38::L1F(0,false);
cp6_c38::L1F(0,true);
LoadX<Packed>(a1,x,rect.row + nextRow,nextRows,K,kp,0);
}
cp6_c38::LR(bank,true);
if(!off && ordinal)
cp6_large39::CLease(0,true);
if(off && k == 32)
asc_sync_pipe(PIPE_M);
if(mp < 64 || np < 64)
asc_mmad_sync(c,a,b,mp,k,np,0,false,false,!off);
else
asc_mmad(c,a,b,mp,k,np,0,false,false,!off);
cp6_c38::LF(bank,false);
}
if(ordinal >= 2)
asc_sync_block_wait(9 + 2 * slot);
asc_sync_notify(PIPE_M,PIPE_FIX,EVENT_ID5);
asc_sync_wait(PIPE_M,PIPE_FIX,EVENT_ID5);
asc_set_l0c_copy_params(1,0,0);
asc_copy_l0c2gm(ws +(2 * worker + slot)* 32768,c,np,rows,np,mp,0,0,0,false,true);
ffts_cross_core_sync(PIPE_FIX,0x21ULL |(uint64_t(8 + 2 * slot)<< 8));
cp6_large39::CLease(0,false);
row = nextRow;
}
}
for(uint32_t i = phase > 2 ? phase - 2 : 0;i < phase;++i)
cp6_c38::LF(i % 2,true);
if constexpr(Packed)
if(!phase)
asc_sync_block_wait(0);
if(ordinal)
cp6_large39::CLease(0,true);
cp6_c38::Drain(ordinal);
}
}// namespace hers_full

static __aicore__ __attribute__((noinline,aligned(4096),section(".zzz_hers_skew")))void HersSkewWaves(
__gm__ int8_t *x,__gm__ int8_t *w,__gm__ float *scale,__gm__ int64_t *groups,__gm__ half *y,__gm__ int32_t *c,
uint32_t E,uint32_t K,uint32_t N,uint32_t W);

static __aicore__ __attribute__((noinline,section(".zzzzzzzzzz_hers_adaptive_run")))void HersRunAdaptive(
__gm__ int8_t *x,__gm__ int8_t *w,__gm__ float *scale,__gm__ int64_t *groups,__gm__ half *y,
__gm__ int32_t *scratch,uint32_t E,uint32_t K,uint32_t N,uint32_t workers,uint64_t sync_base,uint32_t l1);

template <bool Packed,bool Odd = false,uint32_t ReadAhead = 0,bool ReadActivation = false,bool BoundedRead = false,
bool AdaptiveDispatch = false>
__aicore__ __attribute__((always_inline))inline void HersBody(__gm__ int8_t *x,__gm__ int8_t *w,__gm__ float *scale,
__gm__ int64_t *groups,__gm__ half *y,__gm__ int32_t *scratch,uint32_t E,uint32_t K,uint32_t N,
uint32_t workers,uint64_t sync_base,uint32_t l1){
set_ffts_base_addr(sync_base);
asc_init();
uint32_t previous = 0,minRows = uint32_t(-1),maxRows = 0;
for(uint32_t e = 0;e < E;++e){
const uint32_t end = uint32_t(groups[e]),rows = end - previous;
minRows = hers_full::Min(minRows,rows);
maxRows = rows > maxRows ? rows : maxRows;
previous = end;
}
if constexpr(AdaptiveDispatch){
if(2 * E <= workers && E % 2 == 0 && minRows && maxRows - minRows > 128 && maxRows <= 1152 && l1 >= 520192){
HersSkewWaves(x,w,scale,groups,y,scratch,E,K,N,workers);
return;
}
const bool empty = !minRows && maxRows <= 1152;
const bool crossed =
minRows && maxRows - minRows <= 128 && hers_full::Up(minRows,128)!= hers_full::Up(maxRows,128);
if(2 * E <= workers &&(empty || crossed)){
HersRunAdaptive(x,w,scale,groups,y,scratch,E,K,N,workers,sync_base,l1);
return;
}
}
if(!minRows || maxRows - minRows > 128){
if constexpr(Odd){
if(l1 >= 520192 && maxRows <= 6U * 192){
HersSkewWaves(x,w,scale,groups,y,scratch,E,K,N,workers);
return;
}
}
if ASC_IS_AIC{
if(K <= 976)
d6_hers_pipe::CubeFull<128,192,128,64,true>(x,w,groups,scratch,E,K,N,workers);
else
d6_hers_pipe::CubeFull<128,192>(x,w,groups,scratch,E,K,N,workers);
}
if ASC_IS_AIV{
if(K <= 976)
d6_next_pipe::Execute<128,192,64,false,false,true>(scale,groups,y,scratch,E,N,workers);
else
d6_next_pipe::Execute<128,192,64,false>(scale,groups,y,scratch,E,N,workers);
}
asc_sync();
return;
}
if constexpr(Packed){
auto packed =(__gm__ int8_t *)(scratch + uint64_t(workers)* 65536);
if ASC_IS_AIC{
hers_full::Cube<true>(x,packed,groups,scratch,E,K,N,workers,l1);
}
if ASC_IS_AIV{
if constexpr(Odd){
hers_parity::Init(N);
hers_parity::Pack(w,packed,groups,K,N,workers,0,E);
}else{
wave_overlap::InitPackOffsetsFast(N);
wave_overlap::Pack(w,packed,groups,K,N,workers,0,E);
}
ffts_cross_core_sync(PIPE_MTE3,0x1ULL |(14ULL << 8));
asc_sync_block_wait(14);
ffts_cross_core_sync(PIPE_MTE3,0x21ULL);
hers_full::Frames frames{hers_rect::Schedule(groups,E,N,workers)};
hers_post::Vector<2,32768,false>(frames,scale,groups,y,scratch,N);
}
}else{
if ASC_IS_AIC
hers_full::Cube<false>(x,w,groups,scratch,E,K,N,workers,l1);
if ASC_IS_AIV{
if constexpr(ReadActivation)
shared_weight_prefetch::Read<1,false,BoundedRead>(x,1,previous,K,workers);
if constexpr(ReadAhead)
shared_weight_prefetch::Read<ReadAhead,false,BoundedRead>(w,E,K,N,workers);
hers_full::Frames frames{hers_rect::Schedule(groups,E,N,workers)};
hers_post::Vector<2,32768,false>(frames,scale,groups,y,scratch,N);
}
}
asc_sync();
}

namespace e32_stream{
using dfocus::Min;

using dfocus::Up;

struct Tile{
uint32_t expert,row,col,rows,cols;
};

template <uint32_t M,uint32_t N,bool OwnRows = false> struct Cursor{
uint32_t expert = 0,row = 0,col = 0,left = 0;
__aicore__ __attribute__((always_inline))inline Tile Next(
__gm__ int64_t *groups,uint32_t width,uint32_t tileCols = N){
if(!left)
return{};
const uint32_t blocks =(width + 31)/ 32;
while(true){
const uint32_t end = uint32_t(groups[expert]);
if(row < end){
const uint32_t available = Min(blocks - col,left);
const uint32_t panels = tileCols == 320 ?(available + 9)/ 10 :(available + 8)/ 9;
const uint32_t take =(available + panels - 1)/ panels;
const Tile t{expert,row,col * 32,Min(M,end - row),Min(take * 32,width - col * 32)};
col += take;
if(col == blocks){
col = 0;
row += M;
}
left -= take;
return t;
}
++expert;
row = end;
}
}
};

template <uint32_t M,uint32_t N,bool OwnRows = false>
__aicore__ __attribute__((always_inline))inline Cursor<M,N> Schedule(
__gm__ int64_t *groups,uint32_t E,uint32_t width,uint32_t workers){
const uint32_t blocks =(width + 31)/ 32,worker = asc_get_block_idx();
uint32_t tiles = 0,previous = 0;
for(uint32_t e = 0;e < E;++e){
const uint32_t end = uint32_t(groups[e]);
tiles +=(end - previous + M - 1)/ M;
previous = end;
}
const uint32_t total = tiles * blocks,base = total / workers,extra = total % workers;
uint32_t first = worker * base + Min(worker,extra);
Cursor<M,N> cursor{};
cursor.left = base +(worker < extra);
previous = 0;
for(uint32_t e = 0;cursor.left && e < E;++e){
const uint32_t end = uint32_t(groups[e]),entries =((end - previous + M - 1)/ M)* blocks;
if(first < entries){
cursor.expert = e;
cursor.row = previous +(first / blocks)* M;
cursor.col = first % blocks;
break;
}
first -= entries;
previous = end;
}
return cursor;
}

__aicore__ inline void WeightReady(uint32_t slot,bool wait){
if(slot != 2)
cp6_c38::L1R(slot,wait);
else if(wait)
asc_sync_wait(PIPE_MTE2,PIPE_MTE1,EVENT_ID3);
else
asc_sync_notify(PIPE_MTE2,PIPE_MTE1,EVENT_ID3);
}

__aicore__ inline void RecycleWeight(uint32_t slot){
if(slot != 2){
cp6_c38::L1F(slot,false);
cp6_c38::L1F(slot,true);
}else{
asc_sync_notify(PIPE_MTE1,PIPE_MTE2,EVENT_ID3);
asc_sync_wait(PIPE_MTE1,PIPE_MTE2,EVENT_ID3);
}
}

struct Chunk{
Tile tile;
uint32_t k,aBank = 0;
};

template <uint32_t M,uint32_t N,uint32_t BK,bool Long,bool Packed,bool Compact>
__aicore__ __attribute__((always_inline))inline void Fetch(__gm__ int8_t *x,__gm__ int8_t *w,Chunk job,uint32_t K,
uint32_t width,uint32_t slot,uint32_t xStride,uint32_t tileCols,uint32_t panelK){
auto a =(__cbuf__ int8_t *)0;
auto b = a +(Long ? 2 * M * BK : 2 * M * Up(K,32))+ slot * tileCols * panelK;
const Tile t = job.tile;
const uint32_t k = Min(panelK,K - job.k),full = k / 32;
const uint32_t mp = Up(t.rows,32),tail = k % 32,np = Compact ? Up(t.cols,32): tileCols;
if constexpr(Long){
a += slot * M * BK;
if(tail)
cp6_gmg_opt::ZeroL1(a + full * 32 * mp,mp * 32);
asc_copy_gm2l1_nd2nz(a,x + uint64_t(t.row)* xStride + job.k,1,t.rows,k,0,xStride,mp,1,0);
}
auto src = w +(uint64_t(t.expert)* K + job.k)* width + t.col;
if constexpr(Packed){
if(full)
asc_copy_gm2l1_nd2nz(b,src,full,32,t.cols,32 * width,width,32,1,np * 32);
if(tail)
asc_copy_gm2l1_nd2nz(b + full * np * 32,src + full * 32 * width,1,tail,t.cols,0,width,32,1,0);
}else{
asc_copy_gm2l1_nd2nz(b,src,1,k,t.cols,0,width,Up(k,32),1,0);
}
WeightReady(slot,false);
}

__aicore__ __attribute__((always_inline))inline void AEvent(uint32_t bank,bool wait,bool input){
if(input){
if(bank){
if(wait)
asc_sync_wait(PIPE_MTE2,PIPE_MTE1,EVENT_ID7);
else
asc_sync_notify(PIPE_MTE2,PIPE_MTE1,EVENT_ID7);
}else{
if(wait)
asc_sync_wait(PIPE_MTE2,PIPE_MTE1,EVENT_ID6);
else
asc_sync_notify(PIPE_MTE2,PIPE_MTE1,EVENT_ID6);
}
}else{
if(bank){
if(wait)
asc_sync_wait(PIPE_MTE1,PIPE_MTE2,EVENT_ID7);
else
asc_sync_notify(PIPE_MTE1,PIPE_MTE2,EVENT_ID7);
}else{
if(wait)
asc_sync_wait(PIPE_MTE1,PIPE_MTE2,EVENT_ID6);
else
asc_sync_notify(PIPE_MTE1,PIPE_MTE2,EVENT_ID6);
}
}
}

template <uint32_t M>
__aicore__ __attribute__((always_inline))inline void PrefetchA(
__gm__ int8_t *x,const Chunk &job,uint32_t k,uint32_t kp){
auto a1 =(__cbuf__ int8_t *)(uint64_t(job.aBank)* M * kp);
const uint32_t mp = Up(job.tile.rows,32);
if(k != kp){
asc_fill_value_config fill{};
fill.repeat = 1;
fill.blk_num = mp;
asc_fill_l1((__cbuf__ uint16_t *)(a1 +(kp - 32)* mp),uint32_t(0),fill);
asc_sync_pipe(PIPE_MTE2);
}
asc_copy_gm2l1_nd2nz(a1,x + uint64_t(job.tile.row)* k,1,job.tile.rows,k,0,k,mp,1,0);
AEvent(job.aBank,false,true);
}

struct AQueue{
uint32_t prefetched = 0,lastRow = uint32_t(-1),aBank = 1;
template <uint32_t M>
__aicore__ __attribute__((always_inline))inline void Enqueue(
__gm__ int8_t *x,Chunk &chunk,uint32_t K,uint32_t kp){
if(chunk.tile.row != lastRow){
aBank ^= 1;
if(prefetched >= 2){
AEvent(aBank,false,false);
AEvent(aBank,true,false);
}
chunk.aBank = aBank;
PrefetchA<M>(x,chunk,K,kp);
lastRow = chunk.tile.row;
++prefetched;
}else
chunk.aBank = aBank;
}
};

template <uint32_t M,uint32_t N,uint32_t BK,uint32_t LK,bool Long,bool Packed = true,bool Compact = false>
__aicore__ __attribute__((always_inline))inline void Cube(__gm__ int8_t *x,__gm__ int8_t *w,__gm__ int64_t *groups,
__gm__ int32_t *scratch,uint32_t E,uint32_t K,uint32_t width,uint32_t workers,uint32_t xStride,
uint32_t tileCols = N,uint32_t queueSlots = 2,uint32_t panelK = BK){
static_assert(2 * N * BK +(Long ? 2 * M * BK : 2 * M * 1088)<= 524032);
static_assert(M * N <= 32768 && M * LK <= 32768 && N * LK <= 32768);
auto cursor = Schedule<M,N>(groups,E,width,workers);
const uint32_t worker = asc_get_block_idx(),kp = Up(K,32);
Chunk next{cursor.Next(groups,width,tileCols),0},queue[3];
AQueue aQueue;
for(uint32_t slot = 0;slot < queueSlots;++slot){
if(next.tile.rows)
aQueue.Enqueue<M>(x,next,K,kp);
queue[slot] = next;
if(next.tile.rows){
Fetch<M,N,BK,Long,Packed,Compact>(x,w,next,K,width,slot,xStride,tileCols,panelK);
next.k += panelK;
if(next.k >= K)
next ={cursor.Next(groups,width,tileCols),0};
}
}
uint32_t ordinal = 0,phase = 0,currentRow = uint32_t(-1);
for(uint32_t slot = 0;queue[slot].tile.rows;slot = slot + 1 == queueSlots ? 0 : slot + 1){
const uint32_t output = ordinal % 2;
const Chunk job = queue[slot];
const Tile t = job.tile;
const uint32_t span = Min(panelK,kp - job.k),mp = Up(t.rows,32);
const uint32_t np = Up(t.cols,32);
const uint32_t cubeCols = Compact ? np : tileCols;
auto a1 =(__cbuf__ int8_t *)0;
auto b1 = a1 +(Long ? 2 * M * BK : 2 * M * kp)+ slot * tileCols * panelK;
a1 += job.aBank * M * kp;
if(t.row != currentRow){
AEvent(job.aBank,true,true);
currentRow = t.row;
}
auto cc =(__cc__ int32_t *)0;
WeightReady(slot,true);
for(uint32_t off = 0;off < span;off += LK,++phase){
const uint32_t k = Min(LK,span - off),bank = phase % 2;
auto a =(__ca__ int8_t *)static_cast<uint64_t>(bank * 32768);
auto b =(__cb__ int8_t *)static_cast<uint64_t>(bank * 32768);
if(phase >= 2)
cp6_c38::LF(bank,true);
const uint32_t ka = Long ? off : job.k + off;
for(uint32_t p = 0;p < k / 32;++p)
asc_copy_l12l0a(a + p * 512,a1 +(ka + p * 32)* mp,0,mp / 16,1,k / 32 - 1);
if constexpr(Packed){
asc_copy_l12l0b_trans(b,b1 + off * cubeCols,0,k / 32 *(cubeCols / 32),1,1,false,uint64_t(0));
}else{
for(uint32_t i = 0;i < k / 32;++i)
asc_copy_l12l0b_trans(
b + i * cubeCols * 32,b1 +(off + i * 32)* 32,0,np / 32,span / 32,1,false,uint64_t(0));
}
cp6_c38::LR(bank,false);
if(off + k == span && next.tile.rows){
RecycleWeight(slot);
aQueue.Enqueue<M>(x,next,K,kp);
Fetch<M,N,BK,Long,Packed,Compact>(x,w,next,K,width,slot,xStride,tileCols,panelK);
}
cp6_c38::LR(bank,true);
const bool first = job.k + off == 0;
if(first && ordinal)
cp6_large39::CLease(0,true);
if(!first && k == 32)
asc_sync_pipe(PIPE_M);
if constexpr(Compact){
if(cubeCols < 64)
asc_mmad_sync(cc,a,b,mp,k,cubeCols,0,false,false,first);
else
asc_mmad(cc,a,b,mp,k,cubeCols,0,false,false,first);
}else
asc_mmad(cc,a,b,mp,k,cubeCols,0,false,false,first);
cp6_c38::LF(bank,false);
}
if(job.k + span == kp){
if(ordinal >= 2)
asc_sync_block_wait(9 + 2 * output);
asc_sync_notify(PIPE_M,PIPE_FIX,EVENT_ID5);
asc_sync_wait(PIPE_M,PIPE_FIX,EVENT_ID5);
asc_set_l0c_copy_params(1,0,0);
asc_copy_l0c2gm(
scratch +(2 * worker + output)* M * tileCols,cc,np,t.rows,np,mp,0,0,0,false,true);
ffts_cross_core_sync(PIPE_FIX,0x21ULL |(uint64_t(8 + 2 * output)<< 8));
cp6_large39::CLease(0,false);
++ordinal;
}
queue[slot] = next;
if(next.tile.rows){
next.k += panelK;
if(next.k >= K)
next ={cursor.Next(groups,width,tileCols),0};
}
}
for(uint32_t i = phase > 2 ? phase - 2 : 0;i < phase;++i)
cp6_c38::LF(i % 2,true);
if(ordinal)
cp6_large39::CLease(0,true);
cp6_c38::Drain(ordinal);
}

template <uint32_t M,uint32_t N,class Cursor>
__aicore__ __attribute__((always_inline))inline void VectorFromCursor(Cursor cursor,__gm__ float *scale,
__gm__ int64_t *groups,__gm__ half *y,__gm__ int32_t *scratch,uint32_t E,uint32_t width,uint32_t workers,
uint32_t tileCols = N){

const uint32_t worker = asc_get_block_idx(),sub = asc_get_sub_block_id();
auto z =(__ubuf__ float *)0;
auto u =(__ubuf__ float *)45056;
auto d =(__ubuf__ float *)90112;
auto sc =(__ubuf__ float *)135168;
uint32_t ordinal = 0,batch = 0;
set_mov_pad_val(uint32_t(0));
for(auto t = cursor.Next(groups,width,tileCols);t.rows;t = cursor.Next(groups,width,tileCols),++ordinal){
const uint32_t slot = ordinal % 2,np = Up(t.cols,32),halfRows =(t.rows + 1)/ 2;
const uint32_t start = sub * halfRows,length = Min(halfRows,t.rows - start);
asc_copy_gm2ub_align(
sc,scale + uint64_t(t.expert)* width + t.col,1,t.cols * 4,0,Up(t.cols,8)- t.cols,0,0);
asc_sync_block_wait(8 + 2 * slot);
const uint32_t Rows = tileCols == 320 ? 35 : 39;
for(uint32_t row = 0;row < length;row += Rows){
const uint32_t rows = Min(Rows,length - row),elems = rows * np,count = Up(elems,64);
const uint32_t event = batch % 2;
auto out =(__ubuf__ half *)static_cast<uint64_t>(139264 + event * 22528);
auto src = scratch +(2 * worker + slot)* M * tileCols +(start + row)* np;
asc_copy_gm2ub_align((__ubuf__ int32_t *)z,src,1,elems * 4,0,0,0,0);
if(row + rows == length)
ffts_cross_core_sync(PIPE_MTE2,0x21ULL |(uint64_t(9 + 2 * slot)<< 8));
asc_sync_notify(PIPE_MTE2,PIPE_V,EVENT_ID0);
asc_sync_wait(PIPE_MTE2,PIPE_V,EVENT_ID0);
asc_int322float_rn(z,(__ubuf__ int32_t *)z,count);
asc_sync_pipe(PIPE_V);
asc_set_mask_norm();
for(uint32_t col = 0;col < np;col += 64){
asc_set_vector_mask(uint64_t(0),np - col >= 64 ? ~uint64_t(0): uint64_t(0xffffffff));
asc_mul(z + col,z + col,sc + col,uint8_t(rows),1,1,1,np / 8,np / 8,0);
}
asc_sync_pipe(PIPE_V);
asc_set_vector_mask(~uint64_t(0),~uint64_t(0));
asc_mul(u,z,z,count);
asc_sync_pipe(PIPE_V);
asc_mul(u,u,z,count);
asc_sync_pipe(PIPE_V);
asc_mul_scalar(u,u,0.044715f,count);
asc_sync_pipe(PIPE_V);
asc_add(u,u,z,count);
asc_sync_pipe(PIPE_V);
asc_mul_scalar(u,u,0.7978845608028654f,count);
asc_sync_pipe(PIPE_V);
asc_mul_scalar(d,u,-2.0f,count);
asc_sync_pipe(PIPE_V);
asc_min_scalar(d,d,80.0f,count);
asc_sync_pipe(PIPE_V);
asc_exp(d,d,count);
asc_sync_pipe(PIPE_V);
asc_add_scalar(d,d,1.0f,count);
asc_sync_pipe(PIPE_V);
asc_div(u,z,d,count);
asc_sync_pipe(PIPE_V);
if(batch >= 2){
if(event)
asc_sync_wait(PIPE_MTE3,PIPE_V,EVENT_ID3);
else
asc_sync_wait(PIPE_MTE3,PIPE_V,EVENT_ID2);
}
asc_float2half_rn(out,u,count);
asc_sync_notify(PIPE_V,PIPE_MTE3,EVENT_ID0);
asc_sync_wait(PIPE_V,PIPE_MTE3,EVENT_ID0);
asc_copy_ub2gm_align(y + uint64_t(t.row + start + row)* width + t.col,out,rows,t.cols * 2,0,0,
(np - Up(t.cols,16))/ 16,(width - t.cols)* 2);
if(event)
asc_sync_notify(PIPE_MTE3,PIPE_V,EVENT_ID3);
else
asc_sync_notify(PIPE_MTE3,PIPE_V,EVENT_ID2);
asc_sync_notify(PIPE_V,PIPE_MTE2,EVENT_ID0);
asc_sync_wait(PIPE_V,PIPE_MTE2,EVENT_ID0);
++batch;
}
if(!length)
ffts_cross_core_sync(PIPE_MTE2,0x21ULL |(uint64_t(9 + 2 * slot)<< 8));
}
if(batch >= 1)
asc_sync_wait(PIPE_MTE3,PIPE_V,EVENT_ID2);
if(batch >= 2)
asc_sync_wait(PIPE_MTE3,PIPE_V,EVENT_ID3);
ffts_cross_core_sync(PIPE_MTE3,0x21ULL |(uint64_t(12)<< 8));
}

template <uint32_t M,uint32_t N,bool OwnRows = false>
__aicore__ __attribute__((always_inline))inline void Vector(__gm__ float *scale,__gm__ int64_t *groups,
__gm__ half *y,__gm__ int32_t *scratch,uint32_t E,uint32_t width,uint32_t workers,uint32_t tileCols = N){
auto cursor = Schedule<M,N,OwnRows>(groups,E,width,workers);
VectorFromCursor<M,N>(cursor,scale,groups,y,scratch,E,width,workers,tileCols);
}
}// namespace e32_stream

namespace other6_group_meta{
__aicore__ __attribute__((always_inline))inline __ubuf__ int64_t *Ends(){return(__ubuf__ int64_t *)194560;}
__aicore__ __attribute__((always_inline))inline __ubuf__ uint32_t *Ids(){return(__ubuf__ uint32_t *)193536;}
__aicore__ __attribute__((always_inline))inline int64_t End(__gm__ int64_t *groups,uint32_t e){
if ASC_IS_AIV
return Ends()[e];
else
return groups[e];
}
__aicore__ __attribute__((always_inline))inline void Begin(__gm__ int64_t *groups,uint32_t E){
asc_copy_gm2ub_align((__ubuf__ uint8_t *)Ends(),(__gm__ uint8_t *)groups,1,E * 8,0,0,0,0);
}
__aicore__ __attribute__((always_inline))inline uint32_t Build(uint32_t E){
uint32_t active = 0,previous = 0;
for(uint32_t e = 0;e < E;++e){
const uint32_t end = uint32_t(Ends()[e]);
if(end > previous)
Ids()[active++] = e;
previous = end;
}
return active;
}
__aicore__ __attribute__((always_inline))inline uint32_t Finish(uint32_t E){
asc_sync_notify(PIPE_MTE2,PIPE_S,EVENT_ID5);
asc_sync_wait(PIPE_MTE2,PIPE_S,EVENT_ID5);
return Build(E);
}
template <uint32_t Divisor,uint32_t Offset = 0>
__aicore__ __attribute__((always_inline))inline void Warm(
__gm__ int8_t *w,uint32_t active,uint32_t K,uint32_t N,uint32_t W){
constexpr uint32_t Burst = 65536;
const uint32_t bytes = K * N,prefix =(bytes + Divisor - 1)/ Divisor,parts =(prefix + Burst - 1)/ Burst,
rank = 2 * asc_get_block_idx()+ asc_get_sub_block_id(),threads = 2 * W;
if(active * parts > threads * 4)
return;
auto ub =(__ubuf__ int8_t *)(uint64_t(Offset));
auto ids = Ids();
uint32_t issued = 0;
for(uint32_t task = rank;task < active * parts;task += threads){
const uint32_t offset = task % parts * Burst,length = prefix - offset < Burst ? prefix - offset : Burst,
e = ids[task / parts];
asc_copy_gm2ub_align(
ub +(issued % 2)* Burst,w + uint64_t(e)* bytes + offset,1,length,0,(32 - length % 32)% 32,0,0);
++issued;
if(!(issued % 2))
asc_sync_pipe(PIPE_MTE2);
}
if(issued % 2)
asc_sync_pipe(PIPE_MTE2);
}
}// namespace other6_group_meta

namespace other6_group_e32{
using dfocus::Min;
using dfocus::Up;
struct Tile{
uint32_t expert,row,col,rows,cols;
};
template <uint32_t M,uint32_t N,bool OwnRows = false> struct Cursor{
uint32_t expert = 0,row = 0,col = 0,left = 0;
__aicore__ __attribute__((always_inline))inline Tile Next(
__gm__ int64_t *groups,uint32_t width,uint32_t tileCols = N){
if(!left)
return{};
const uint32_t blocks =(width + 31)/ 32;
while(true){
const uint32_t end = uint32_t(other6_group_meta::End(groups,expert));
if(row < end){
const uint32_t available = Min(blocks - col,left);
const uint32_t panels = tileCols == 320 ?(available + 9)/ 10 :(available + 8)/ 9;
const uint32_t take =(available + panels - 1)/ panels;
const Tile t{expert,row,col * 32,Min(M,end - row),Min(take * 32,width - col * 32)};
col += take;
if(col == blocks){
col = 0;
row += M;
}
left -= take;
return t;
}
++expert;
row = end;
}
}
};
template <uint32_t M,uint32_t N,bool OwnRows = false>
__aicore__ __attribute__((always_inline))inline Cursor<M,N> Schedule(
__gm__ int64_t *groups,uint32_t E,uint32_t width,uint32_t workers){
const uint32_t blocks =(width + 31)/ 32,worker = asc_get_block_idx();
uint32_t tiles = 0,previous = 0;
for(uint32_t e = 0;e < E;++e){
const uint32_t end = uint32_t(other6_group_meta::End(groups,e));
tiles +=(end - previous + M - 1)/ M;
previous = end;
}
const uint32_t total = tiles * blocks,base = total / workers,extra = total % workers;
uint32_t first = worker * base + Min(worker,extra);
Cursor<M,N> cursor{};
cursor.left = base +(worker < extra);
previous = 0;
for(uint32_t e = 0;cursor.left && e < E;++e){
const uint32_t end = uint32_t(other6_group_meta::End(groups,e)),
entries =((end - previous + M - 1)/ M)* blocks;
if(first < entries){
cursor.expert = e;
cursor.row = previous +(first / blocks)* M;
cursor.col = first % blocks;
break;
}
first -= entries;
previous = end;
}
return cursor;
}
using e32_stream::Cube;
template <uint32_t M,uint32_t N,bool OwnRows = false>
__aicore__ __attribute__((always_inline))inline void Vector(__gm__ float *scale,__gm__ int64_t *groups,
__gm__ half *y,__gm__ int32_t *scratch,uint32_t E,uint32_t width,uint32_t workers,uint32_t tileCols = N){
auto cursor = Schedule<M,N,OwnRows>(groups,E,width,workers);
e32_stream::VectorFromCursor<M,N>(cursor,scale,groups,y,scratch,E,width,workers,tileCols);
}
}// namespace other6_group_e32

namespace other6_group_direct{
using dfocus::Min;

using dfocus::Up;

struct Tile{
uint32_t expert,row,col,rows,cols;
};

template <uint32_t M,uint32_t N,bool OwnRows = false> struct Cursor{
uint32_t expert = 0,row = 0,col = 0,left = 0;
__aicore__ __attribute__((always_inline))inline Tile Next(__gm__ int64_t *groups,uint32_t width){
if(!left)
return{};
const uint32_t blocks =(width + 31)/ 32;
while(true){
const uint32_t end = uint32_t(other6_group_meta::End(groups,expert));
if(row < end){
const uint32_t available = Min(blocks - col,left);
const uint32_t panels =(available + N / 32 - 1)/(N / 32);
const uint32_t take =(available + panels - 1)/ panels;
const Tile t{expert,row,col * 32,Min(M,end - row),Min(take * 32,width - col * 32)};
col += take;
if(col == blocks){
col = 0;
row += M;
}
left -= take;
return t;
}
++expert;
row = end;
}
}
};

template <uint32_t M,uint32_t N,bool OwnRows = false>
__aicore__ __attribute__((always_inline))inline Cursor<M,N> Schedule(
__gm__ int64_t *groups,uint32_t E,uint32_t width,uint32_t workers,uint32_t knownTiles = 0){
const uint32_t blocks =(width + 31)/ 32,worker = asc_get_block_idx();
uint32_t tiles = knownTiles,previous = 0;
if(!knownTiles)
for(uint32_t e = 0;e < E;++e){
const uint32_t end = uint32_t(other6_group_meta::End(groups,e));
tiles +=(end - previous + M - 1)/ M;
previous = end;
}
const uint32_t total = tiles * blocks,base = total / workers,extra = total % workers;
uint32_t first = worker * base + Min(worker,extra);
Cursor<M,N> cursor{};
cursor.left = base +(worker < extra);
previous = 0;
for(uint32_t e = 0;cursor.left && e < E;++e){
const uint32_t end = uint32_t(other6_group_meta::End(groups,e)),
entries =((end - previous + M - 1)/ M)* blocks;
if(first < entries){
cursor.expert = e;
cursor.row = previous +(first / blocks)* M;
cursor.col = first % blocks;
break;
}
first -= entries;
previous = end;
}
return cursor;
}

struct Chunk{
Tile tile;
uint32_t k,aBank = 0;
};

template <uint32_t M,uint32_t N,uint32_t BK,bool Long,bool Packed,bool Compact>
__aicore__ __attribute__((always_inline))inline void Fetch(
__gm__ int8_t *x,__gm__ int8_t *w,Chunk job,uint32_t K,uint32_t width,uint32_t slot,uint32_t xStride){
auto a =(__cbuf__ int8_t *)0;
auto b = a +(Long ? 2 * M * BK : 2 * M * Up(K,32))+ slot * N * BK;
const Tile t = job.tile;
const uint32_t k = Min(BK,K - job.k),full = k / 32;
const uint32_t mp = Up(t.rows,32),tail = k % 32,np = Compact ? Up(t.cols,32): N;
if constexpr(Long){
a += slot * M * BK;
if(tail)
cp6_gmg_opt::ZeroL1(a + full * 32 * mp,mp * 32);
asc_copy_gm2l1_nd2nz(a,x + uint64_t(t.row)* xStride + job.k,1,t.rows,k,0,xStride,mp,1,0);
}
auto src = w +(uint64_t(t.expert)* K + job.k)* width + t.col;
if constexpr(Packed){
if(full)
asc_copy_gm2l1_nd2nz(b,src,full,32,t.cols,32 * width,width,32,1,np * 32);
if(tail)
asc_copy_gm2l1_nd2nz(b + full * np * 32,src + full * 32 * width,1,tail,t.cols,0,width,32,1,0);
}else{
asc_copy_gm2l1_nd2nz(b,src,1,k,t.cols,0,width,Up(k,32),1,0);
}
cp6_c38::L1R(slot,false);
}

__aicore__ __attribute__((always_inline))inline void AEvent(uint32_t bank,bool wait,bool input){
if(input){
if(bank){
if(wait)
asc_sync_wait(PIPE_MTE2,PIPE_MTE1,EVENT_ID7);
else
asc_sync_notify(PIPE_MTE2,PIPE_MTE1,EVENT_ID7);
}else{
if(wait)
asc_sync_wait(PIPE_MTE2,PIPE_MTE1,EVENT_ID6);
else
asc_sync_notify(PIPE_MTE2,PIPE_MTE1,EVENT_ID6);
}
}else{
if(bank){
if(wait)
asc_sync_wait(PIPE_MTE1,PIPE_MTE2,EVENT_ID7);
else
asc_sync_notify(PIPE_MTE1,PIPE_MTE2,EVENT_ID7);
}else{
if(wait)
asc_sync_wait(PIPE_MTE1,PIPE_MTE2,EVENT_ID6);
else
asc_sync_notify(PIPE_MTE1,PIPE_MTE2,EVENT_ID6);
}
}
}

template <uint32_t M>
__aicore__ __attribute__((always_inline))inline void PrefetchA(
__gm__ int8_t *x,const Chunk &job,uint32_t k,uint32_t kp){
auto a1 =(__cbuf__ int8_t *)(uint64_t(job.aBank)* M * kp);
const uint32_t mp = Up(job.tile.rows,32);
if(k != kp){
asc_fill_value_config fill{};
fill.repeat = 1;
fill.blk_num = mp;
asc_fill_l1((__cbuf__ uint16_t *)(a1 +(kp - 32)* mp),uint32_t(0),fill);
asc_sync_pipe(PIPE_MTE2);
}
asc_copy_gm2l1_nd2nz(a1,x + uint64_t(job.tile.row)* k,1,job.tile.rows,k,0,k,mp,1,0);
AEvent(job.aBank,false,true);
}

struct AQueue{
uint32_t prefetched = 0,lastRow = uint32_t(-1),aBank = 1;
template <uint32_t M>
__aicore__ __attribute__((always_inline))inline void Enqueue(
__gm__ int8_t *x,Chunk &chunk,uint32_t K,uint32_t kp){
if(chunk.tile.row != lastRow){
aBank ^= 1;
if(prefetched >= 2){
AEvent(aBank,false,false);
AEvent(aBank,true,false);
}
chunk.aBank = aBank;
PrefetchA<M>(x,chunk,K,kp);
lastRow = chunk.tile.row;
++prefetched;
}else
chunk.aBank = aBank;
}
};

template <uint32_t M,uint32_t N,uint32_t BK,uint32_t LK,bool Long,bool Packed = true,bool Compact = false>
__aicore__ __attribute__((always_inline))inline void Cube(__gm__ int8_t *x,__gm__ int8_t *w,__gm__ int64_t *groups,
__gm__ int32_t *scratch,uint32_t E,uint32_t K,uint32_t width,uint32_t workers,uint32_t xStride,
uint32_t knownTiles = 0){
static_assert(2 * N * BK +(Long ? 2 * M * BK : 2 * M * 1088)<= 524032);
static_assert(M * N <= 32768 && M * LK <= 32768 && N * LK <= 32768);
auto cursor = Schedule<M,N>(groups,E,width,workers,knownTiles);
const uint32_t worker = asc_get_block_idx(),kp = Up(K,32);
Chunk next{cursor.Next(groups,width),0},queue[2];
AQueue aQueue;
for(uint32_t slot = 0;slot < 2;++slot){
if(next.tile.rows)
aQueue.Enqueue<M>(x,next,K,kp);
queue[slot] = next;
if(next.tile.rows){
Fetch<M,N,BK,Long,Packed,Compact>(x,w,next,K,width,slot,xStride);
next.k += BK;
if(next.k >= K)
next ={cursor.Next(groups,width),0};
}
}
uint32_t ordinal = 0,phase = 0,currentRow = uint32_t(-1);
for(uint32_t i = 0;queue[i % 2].tile.rows;++i){
const uint32_t slot = i % 2,output = ordinal % 2;
const Chunk job = queue[slot];
const Tile t = job.tile;
const uint32_t span = Min(BK,kp - job.k),mp = Up(t.rows,32);
const uint32_t np = Up(t.cols,32);
const uint32_t cubeCols = Compact ? np : N;
auto a1 =(__cbuf__ int8_t *)0;
auto b1 = a1 +(Long ? 2 * M * BK : 2 * M * kp)+ slot * N * BK;
a1 += job.aBank * M * kp;
if(t.row != currentRow){
AEvent(job.aBank,true,true);
currentRow = t.row;
}
auto cc =(__cc__ int32_t *)0;
cp6_c38::L1R(slot,true);
const uint32_t step = Min(256U,(1024 /(mp > cubeCols ? mp : cubeCols))* 32);
for(uint32_t off = 0;off < span;off += step,++phase){
const uint32_t k = Min(step,span - off),bank = phase % 2;
auto a =(__ca__ int8_t *)static_cast<uint64_t>(bank * 32768);
auto b =(__cb__ int8_t *)static_cast<uint64_t>(bank * 32768);
if(phase >= 2)
cp6_c38::LF(bank,true);
const uint32_t ka = Long ? off : job.k + off;
for(uint32_t p = 0;p < k / 32;++p)
asc_copy_l12l0a(a + p * 512,a1 +(ka + p * 32)* mp,0,mp / 16,1,k / 32 - 1);
if constexpr(Packed){
asc_copy_l12l0b_trans(b,b1 + off * cubeCols,0,k / 32 *(cubeCols / 32),1,1,false,uint64_t(0));
}else{
for(uint32_t i = 0;i < k / 32;++i)
asc_copy_l12l0b_trans(
b + i * cubeCols * 32,b1 +(off + i * 32)* 32,0,np / 32,span / 32,1,false,uint64_t(0));
}
cp6_c38::LR(bank,false);
if(off + k == span && next.tile.rows){
cp6_c38::L1F(slot,false);
cp6_c38::L1F(slot,true);
aQueue.Enqueue<M>(x,next,K,kp);
Fetch<M,N,BK,Long,Packed,Compact>(x,w,next,K,width,slot,xStride);
}
cp6_c38::LR(bank,true);
const bool first = job.k + off == 0;
if(first && ordinal)
cp6_large39::CLease(0,true);
if(!first && k == 32)
asc_sync_pipe(PIPE_M);
if constexpr(Compact){
if(cubeCols < 64)
asc_mmad_sync(cc,a,b,mp,k,cubeCols,0,false,false,first);
else
asc_mmad(cc,a,b,mp,k,cubeCols,0,false,false,first);
}else
asc_mmad(cc,a,b,mp,k,cubeCols,0,false,false,first);
cp6_c38::LF(bank,false);
}
if(job.k + span == kp){
if(ordinal >= 2)
asc_sync_block_wait(9 + 2 * output);
asc_sync_notify(PIPE_M,PIPE_FIX,EVENT_ID5);
asc_sync_wait(PIPE_M,PIPE_FIX,EVENT_ID5);
asc_set_l0c_copy_params(1,0,0);
asc_copy_l0c2gm(scratch +(2 * worker + output)* M * N,cc,np,t.rows,np,mp,0,0,0,false,true);
ffts_cross_core_sync(PIPE_FIX,0x21ULL |(uint64_t(8 + 2 * output)<< 8));
cp6_large39::CLease(0,false);
++ordinal;
}
queue[slot] = next;
if(next.tile.rows){
next.k += BK;
if(next.k >= K)
next ={cursor.Next(groups,width),0};
}
}
for(uint32_t i = phase > 2 ? phase - 2 : 0;i < phase;++i)
cp6_c38::LF(i % 2,true);
if(ordinal)
cp6_large39::CLease(0,true);
cp6_c38::Drain(ordinal);
}
}// namespace other6_group_direct

__global__ __mix__(1,2)__attribute__((section(".zz_e32_ahead")))void grouped_matmul_gelu_e32_ahead(__gm__ int8_t *x,
__gm__ int8_t *w,__gm__ float *scale,__gm__ int64_t *groups,__gm__ half *y,__gm__ int32_t *scratch,uint32_t E,
uint32_t K,uint32_t N,uint32_t workers,uint32_t tileCols,uint64_t sync_base){
set_ffts_base_addr(sync_base);
asc_init();
if ASC_IS_AIV{
other6_group_meta::Begin(groups,E);
const uint32_t active = other6_group_meta::Finish(E);
if(E >= 8 && active < E)
other6_group_meta::Warm<1>(w,active,K,N,workers);
}
if ASC_IS_AIC
other6_group_e32::Cube<96,320,480,96,false,false,true>(
x,w,groups,scratch,E,K,N,workers,K,tileCols,tileCols == 320 ? 3 : 2,tileCols == 320 ? 320 : 480);
if ASC_IS_AIV
other6_group_e32::Vector<96,320>(scale,groups,y,scratch,E,N,workers,tileCols);
asc_sync();
}

namespace owned_large_trim{
template <bool Deferred,bool Curve,bool Padded,bool MidWide,bool VectorOnly>
static __aicore__ __attribute__((noinline))void VectorMidpoint(__ubuf__ float *z,__ubuf__ float *u,__ubuf__ float *t,
__ubuf__ float *p,__ubuf__ half *out,__ubuf__ uint8_t *mask,uint32_t count,bool waitOut = false){
auto cmp =(__ubuf__ uint8_t *)(MidWide ? 184320 : 169216);
auto tiny =(__ubuf__ uint8_t *)(MidWide ? 185600 : 171008);
auto denominator = t;
const uint8_t repeats = uint8_t(count / 64);
asc_set_mask_norm();
asc_set_vector_mask(~uint64_t(0),~uint64_t(0));
if constexpr(!VectorOnly){
asc_duplicate((__ubuf__ float *)(MidWide ? 188160 : 175104),-.071354814f,uint32_t(64));
asc_duplicate((__ubuf__ float *)(MidWide ? 188416 : 175424),-1.5957692f,uint32_t(64));
}
asc_set_mask_norm();
asc_set_vector_mask(~uint64_t(0),~uint64_t(0));
if(Curve){
asc_mul(u,z,z,repeats,1,1,1,8,8,8);
asc_sync_pipe(PIPE_V);
asc_mul_add(u,(__ubuf__ float *)(MidWide ? 188160 : 175104),(__ubuf__ float *)(MidWide ? 188416 : 175424),
uint8_t(count / 64),1,1,1,8,0,0);
asc_sync_pipe(PIPE_V);
asc_mul(t,u,z,repeats,1,1,1,8,8,8);
asc_sync_pipe(PIPE_V);
}else{
asc_mul(u,z,z,repeats,1,1,1,8,8,8);
asc_sync_pipe(PIPE_V);
asc_mul(u,u,z,repeats,1,1,1,8,8,8);
asc_sync_pipe(PIPE_V);
asc_mul_scalar(u,u,.044715f,repeats,1,1,8,8);
asc_sync_pipe(PIPE_V);
asc_add(u,u,z,repeats,1,1,1,8,8,8);
asc_sync_pipe(PIPE_V);
asc_mul_scalar(u,u,.7978846f,repeats,1,1,8,8);
asc_sync_pipe(PIPE_V);
asc_mul_scalar(t,u,-2.0f,repeats,1,1,8,8);
asc_sync_pipe(PIPE_V);
}
asc_min_scalar(t,t,8e1f,repeats,1,1,8,8);
asc_sync_pipe(PIPE_V);
asc_exp(t,t,repeats,1,1,8,8);
asc_sync_pipe(PIPE_V);
asc_add_scalar(denominator,t,1.0f,repeats,1,1,8,8);
asc_sync_pipe(PIPE_V);
asc_div(p,z,denominator,repeats,1,1,1,8,8,8);
asc_sync_pipe(PIPE_V);
if(MidWide && waitOut)
asc_sync_wait(PIPE_MTE3,PIPE_V,EVENT_ID4);
asc_float2half_rn(out,p,repeats,1,1,4,8);
asc_sync_pipe(PIPE_V);
if constexpr(!VectorOnly){
if(Deferred){
const uint32_t blocks =(count + 2047)/ 2048;
asc_duplicate((__ubuf__ int32_t *)cmp,int32_t(-1),blocks * 2);
asc_sync_pipe(PIPE_V);
}else{
asc_sync_notify(PIPE_V,PIPE_S,EVENT_ID1);
asc_sync_wait(PIPE_V,PIPE_S,EVENT_ID1);
}
}
}
}// namespace owned_large_trim
namespace other_large{
using cp6_c38::Min;

using cp6_c38::Up;

constexpr uint32_t N = 768,BN = 256,Slots = 3,WeightBytes = 131072,SlotBytes = 172032;

__aicore__ __attribute__((always_inline))inline uint32_t RowCap(uint32_t rows){
return(rows + 63)/ 64 ==(rows + 65)/ 66 ? 64U : 66U;
}

struct Frame{
uint32_t expert,row,rows,col;
bool first;
};

struct Cursor{
uint32_t stage,row,end,col,rowCap;
bool initialized;
};

template <class Groups>
__aicore__ __attribute__((always_inline))inline Frame Next(Cursor &cur,Groups groups,uint32_t worker){
const uint32_t stages = worker < 12 ? 4 : 3;
while(cur.stage < stages){
const bool early = worker < 12,tail = early ? cur.stage == 0 : cur.stage == 3;
const uint32_t expert = tail ? 60 + worker / 3 : worker +(cur.stage - uint32_t(early))* 20;
const uint32_t first = tail ? worker % 3 * BN : 0,stop = tail ? first + BN : N;
if(!cur.initialized){
cur.row = expert ? uint32_t(groups[expert - 1]): 0;
cur.end = uint32_t(groups[expert]);
cur.rowCap = RowCap(cur.end - cur.row);
cur.col = first;
cur.initialized = true;
}
if(cur.row < cur.end){
Frame frame{expert,cur.row,Min(cur.rowCap,cur.end - cur.row),cur.col,cur.col == first};
cur.col += BN;
if(cur.col == stop){
cur.row += frame.rows;
cur.col = first;
}
return frame;
}
++cur.stage;
cur.initialized = false;
}
return Frame{};
}

__aicore__ __attribute__((always_inline))inline void Prefetch(
__gm__ int8_t *x,__gm__ int8_t *w,Frame f,uint32_t k,uint32_t slot,bool weights = true){
auto base =(__cbuf__ int8_t *)static_cast<uint64_t>(slot * SlotBytes);
if(f.first)
asc_copy_gm2l1_nd2nz(base + WeightBytes,x + uint64_t(f.row)* k,1,f.rows,k,0,k,Up(f.rows,16),1,0);
if(weights)
asc_copy_gm2l1_nd2nz(base,w + uint64_t(f.expert)* k * N + f.col,1,k,BN,0,N,k,1,0);
cp6_c38::L1R(slot,false);
}

using cp9_large_pipe::DeferredFrame;

using cp9_large_pipe::FinishFrame;

using cp9_large_pipe::SavedIndex;

using cp9_large_pipe::SavedZ;

template <bool Curve>
__aicore__ inline void VectorTail(
__gm__ float *scale,__gm__ int64_t *groups,__gm__ half *y,__gm__ int32_t *scratch){
const uint32_t worker = asc_get_block_idx(),sub = asc_get_sub_block_id();
uint32_t ordinal = 0;
Cursor cur{};
cp6_sv59::State state{};
auto z =(__ubuf__ float *)0;
auto sc =(__ubuf__ float *)181760;
cp6_c38::InitShortCurve();
for(Frame f = Next(cur,groups,worker);f.rows;f = Next(cur,groups,worker)){
const uint32_t bank = ordinal % 2,split =(f.rows + 1)/ 2,local = sub * split;
const uint32_t rows = sub ? f.rows - split : split,count = rows * BN;
if(rows)
asc_copy_gm2ub_align(sc,scale + uint64_t(f.expert)* N + f.col,1,BN * 4,0,0,0,0);
asc_sync_block_wait(8 + 2 * bank);
if(rows)
asc_copy_gm2ub_align((__ubuf__ int32_t *)z,scratch +(uint64_t(worker)* 2 + bank)* 16896 + local * BN,1,
count * 4,0,0,0,0);
if(rows)
asc_sync_notify(PIPE_MTE2,PIPE_V,EVENT_ID7);
ffts_cross_core_sync(PIPE_MTE2,0x21ULL |(uint64_t(9 + 2 * bank)<< 8));
if(rows){
asc_sync_wait(PIPE_MTE2,PIPE_V,EVENT_ID7);
asc_int322float_rn(z,(__ubuf__ int32_t *)z,count);
asc_sync_pipe(PIPE_V);
asc_set_mask_norm();
asc_set_vector_mask(0,~uint64_t(0));
for(uint32_t n = 0;n < BN;n += 64)
asc_mul(z + n,z + n,sc + n,uint8_t(rows),1,1,1,32,32,0);
asc_sync_pipe(PIPE_V);
asc_set_vector_mask(~uint64_t(0),~uint64_t(0));
cp6_sv59::Wait(state,bank);
auto out =(__ubuf__ half *)static_cast<uint64_t>(135168 + bank * 16896);
owned_large_trim::VectorMidpoint<false,Curve,true,false,true>(
z,(__ubuf__ float *)33792,(__ubuf__ float *)67584,(__ubuf__ float *)101376,out,nullptr,count);
asc_sync_notify(PIPE_V,PIPE_MTE3,EVENT_ID0);
asc_sync_wait(PIPE_V,PIPE_MTE3,EVENT_ID0);
asc_copy_ub2gm_align(y + uint64_t(f.row + local)* N + f.col,out,rows,BN * 2,0,0,0,(N - BN)* 2);
if(bank)
asc_sync_notify(PIPE_MTE3,PIPE_S,EVENT_ID7);
else
asc_sync_notify(PIPE_MTE3,PIPE_S,EVENT_ID6);
state.lease[bank] = true;
asc_sync_notify(PIPE_V,PIPE_MTE2,EVENT_ID6);
asc_sync_wait(PIPE_V,PIPE_MTE2,EVENT_ID6);
}
++ordinal;
}
cp6_sv59::End(state);
}
}// namespace other_large

namespace compact_rows{
template <uint32_t Words>
__aicore__ __attribute__((always_inline))inline void StoreHalf(__cc__ int32_t *c,__gm__ int32_t *scratch,
uint32_t worker,uint32_t rows,uint32_t paddedRows,uint32_t &ordinal){
const uint32_t bank = ordinal % 2;
if(ordinal >= 2)
asc_sync_block_wait(9 + 2 * bank);
asc_set_l0c_copy_params(1,0,0);
asc_copy_l0c2gm((__gm__ half *)(scratch +(uint64_t(worker)* 2 + bank)* Words),c,256,rows,256,paddedRows,0,
uint64_t(QuantMode_t::DEQF16),0,false,true);
ffts_cross_core_sync(PIPE_FIX,0x21ULL |(uint64_t(8 + 2 * bank)<< 8));
++ordinal;
}
}

namespace breakthrough_large_balance{
using cp6_c38::Min;

using cp6_c38::Up;

constexpr uint32_t N = 768,BN = 256,Slots = 3,WeightBytes = 131072,SlotBytes = 172032;

struct Frame{
uint32_t expert,row,rows,col;
bool first;
};

struct Cursor{
uint32_t expert = 0,row = 0,end = 0,col = 0,left = 0,firstCol = 0;
uint32_t rowCap = 66;
bool initialized = false,compactRows = false;
};

__aicore__ __attribute__((always_inline))inline __gm__ uint64_t *MetaRecord(
__gm__ int32_t *scratch,uint32_t worker,uint32_t workers){
return(__gm__ uint64_t *)(scratch + uint64_t(workers)* 2 * 16896)+ uint64_t(worker)* 4;
}
__aicore__ __attribute__((always_inline))inline Cursor PrepareCursor(
__gm__ int64_t *groups,__gm__ int32_t *scratch,uint32_t worker){
const uint32_t workers = asc_get_block_num();
auto ends =(__ubuf__ int64_t *)0;
asc_copy_gm2ub_align((__ubuf__ uint8_t *)ends,(__gm__ uint8_t *)groups,1,64 * 8,0,0,0,0);
asc_sync_notify(PIPE_MTE2,PIPE_S,EVENT_ID5);
asc_sync_wait(PIPE_MTE2,PIPE_S,EVENT_ID5);
auto costs =(__ubuf__ uint32_t *)2048;
for(uint32_t i = 0;i < 20;++i)
costs[i] = 0;
uint32_t total = 0,previous = 0;
bool compactRows = true;
for(uint32_t e = 0;e < 64;++e){
const uint32_t end = uint32_t(ends[e]),tiles =(end - previous + 65)/ 66;
total += tiles * 3;
compactRows &= end - previous <= 64;
previous = end;
if(e < 60){
const uint32_t owner = e < 20 ? e :(e < 40 ? e - 20 : e - 40);
costs[owner] += tiles * 3;
}else{
const uint32_t owner =(e - 60)* 3;
costs[owner] += tiles;
costs[owner + 1] += tiles;
costs[owner + 2] += tiles;
}
}
uint32_t maximum = 0;
for(uint32_t i = 0;i < 20;++i)
if(costs[i] > maximum)
maximum = costs[i];
const uint32_t per = total / workers,extra = total % workers;
const bool useBalanced = maximum > per + uint32_t(extra != 0)+ 1;
Cursor cur{};
cur.compactRows = compactRows;
cur.initialized = useBalanced;
if(useBalanced){
uint32_t first = worker * per + Min(worker,extra);
cur.left = per + uint32_t(worker < extra);
if(cur.left){
previous = 0;
for(uint32_t e = 0;e < 64;++e){
const uint32_t end = uint32_t(ends[e]),jobs =((end - previous + 65)/ 66)* 3;
if(first < jobs){
cur.expert = e;
cur.end = end;
cur.rowCap = other_large::RowCap(end - previous);
cur.row = previous +(first / 3)* cur.rowCap;
cur.col = first % 3 * BN;
cur.firstCol = cur.col;
break;
}
first -= jobs;
previous = end;
}
}
}
const uint64_t word = uint64_t(cur.expert)|(uint64_t(cur.row)<< 6)|(uint64_t(cur.end)<< 22)|
(uint64_t(cur.col / BN)<< 39)|(uint64_t(cur.left)<< 41)|(uint64_t(cur.compactRows)<< 61)|
(uint64_t(cur.rowCap == 64)<< 62)|(uint64_t(useBalanced)<< 63);
if(!asc_get_sub_block_id()){
auto record =(__ubuf__ uint64_t *)1024;
record[0] = word;
record[1] = record[2] = record[3] = 0;
asc_sync_notify(PIPE_S,PIPE_MTE3,EVENT_ID5);
asc_sync_wait(PIPE_S,PIPE_MTE3,EVENT_ID5);
asc_copy_ub2gm_align(MetaRecord(scratch,worker,workers),record,32);
asc_sync_notify(PIPE_MTE3,PIPE_S,EVENT_ID5);
asc_sync_wait(PIPE_MTE3,PIPE_S,EVENT_ID5);
}
ffts_cross_core_sync(PIPE_MTE3,0x21ULL);
return cur;
}
__aicore__ __attribute__((always_inline))inline Cursor ReadCursor(__gm__ int32_t *scratch,uint32_t worker){
asc_sync_block_wait(0);
auto meta = MetaRecord(scratch,worker,asc_get_block_num());
asc_dcci_single((__gm__ void *)meta);
const uint64_t word = *(__gm__ volatile uint64_t *)meta;
Cursor cur{};
cur.initialized = bool(word >> 63);
cur.compactRows = bool(word &(uint64_t(1)<< 61));
cur.rowCap = word &(uint64_t(1)<< 62)? 64U : 66U;
cur.expert = uint32_t(word & 63);
cur.row = uint32_t((word >> 6)& 65535);
cur.end = uint32_t((word >> 22)& 131071);
cur.col = uint32_t((word >> 39)& 3)* BN;
cur.firstCol = cur.col;
cur.left = uint32_t((word >> 41)& 1023);
return cur;
}

__aicore__ __attribute__((always_inline))inline Frame Next(Cursor &cur,__gm__ int64_t *groups,uint32_t worker){

if(!cur.left)
return{};
while(cur.row >= cur.end){
++cur.expert;
cur.row = cur.end;
cur.end = uint32_t(groups[cur.expert]);
cur.rowCap = other_large::RowCap(cur.end - cur.row);
cur.col = cur.firstCol = 0;
}
const uint32_t rows = Min(cur.rowCap,cur.end - cur.row);
const Frame f{cur.expert,cur.row,rows,cur.col,cur.col == cur.firstCol};
cur.col += BN;
if(cur.col == N){
cur.col = cur.firstCol = 0;
cur.row += rows;
}
--cur.left;
return f;
}

__aicore__ __attribute__((always_inline))inline void Prefetch(__gm__ int8_t *x,__gm__ int8_t *w,Frame f,uint32_t k,
uint32_t slot,uint32_t &cachedExpert,uint32_t &cachedCol){
auto base =(__cbuf__ int8_t *)static_cast<uint64_t>(slot * SlotBytes);
if(f.first)
asc_copy_gm2l1_nd2nz(base + WeightBytes,x + uint64_t(f.row)* k,1,f.rows,k,0,k,Up(f.rows,16),1,0);
if(cachedExpert != f.expert || cachedCol != f.col){
asc_copy_gm2l1_nd2nz(base,w + uint64_t(f.expert)* k * N + f.col,1,k,BN,0,N,k,1,0);
cachedExpert = f.expert;
cachedCol = f.col;
}
cp6_c38::L1R(slot,false);
}

__aicore__ __attribute__((always_inline))inline void Cube(
__gm__ int8_t *x,__gm__ int8_t *w,__gm__ int64_t *groups,__gm__ int32_t *scratch,uint32_t k,Cursor cur){
const uint32_t worker = asc_get_block_idx(),micros =(k + 127)/ 128;
auto a =(__ca__ int8_t *)0;
auto b =(__cb__ int8_t *)0;
auto c =(__cc__ int32_t *)0;
Frame queue[Slots];
uint32_t cachedExpert[Slots] ={uint32_t(-1),uint32_t(-1),uint32_t(-1)};
uint32_t cachedCol[Slots] ={uint32_t(-1),uint32_t(-1),uint32_t(-1)};
for(uint32_t slot = 0;slot < Slots;++slot){
queue[slot] = Next(cur,groups,worker);
if(queue[slot].rows)
Prefetch(x,w,queue[slot],k,slot,cachedExpert[slot],cachedCol[slot]);
}
uint32_t ordinal = 0;
bool pending[2] ={false,false},wide_pending = false;
for(uint32_t tile = 0;queue[tile % Slots].rows;++tile){
const uint32_t slot = tile % Slots;
const Frame f = queue[slot],next = Next(cur,groups,worker);
const uint32_t tm = Up(f.rows,16),bank = tm <= 64 ? tile % 2 : 0;
auto base =(__cbuf__ int8_t *)static_cast<uint64_t>(slot * SlotBytes);
auto cc = c + bank * 16384;
cp6_c38::L1R(slot,true);
if(f.first){
auto a1 = base + WeightBytes;
for(uint32_t kk = 0;kk < k;kk += 128){
const uint32_t kp = Min(128U,k - kk);
for(uint32_t i = 0;i < kp / 32;++i)
asc_copy_l12l0a(a + kk * tm + i * 512,a1 +(kk + i * 32)* tm,0,tm / 16,1,kp / 32 - 1);
}
}
for(uint32_t j = 0;j < micros;++j){
const uint32_t l0 = j % 2,kk = j * 128,kp = Min(128U,k - kk);
if(j >= 2)
cp6_c38::LF(l0,true);
for(uint32_t i = 0;i < kp / 32;++i)
asc_copy_l12l0b_trans(
b + l0 * 32768 + i * 32 * BN,base +(kk + i * 32)* 32,0,BN / 32,k / 32,1,false,uint64_t(0));
cp6_c38::LR(l0,false);
if(j + 1 == micros && next.rows){
cp6_c38::L1F(slot,false);
cp6_c38::L1F(slot,true);
Prefetch(x,w,next,k,slot,cachedExpert[slot],cachedCol[slot]);
}
cp6_c38::LR(l0,true);
if(!j){
if((tm > 64 || wide_pending || bank == 0)&& pending[0]){
cp6_large39::CLease(0,true);
pending[0] = false;
}
if((tm > 64 || bank == 1)&& pending[1]){
cp6_large39::CLease(1,true);
pending[1] = false;
}
wide_pending = false;
}
asc_mmad(cc,a + kk * tm,b + l0 * 32768,tm,kp,BN,0,false,false,j == 0);
cp6_c38::LF(l0,false);
}
for(uint32_t j = micros - 2;j < micros;++j)
cp6_c38::LF(j % 2,true);
asc_sync_notify(PIPE_M,PIPE_FIX,EVENT_ID5);
asc_sync_wait(PIPE_M,PIPE_FIX,EVENT_ID5);
const uint32_t output = ordinal % 2;
if(ordinal >= 2)
asc_sync_block_wait(9 + 2 * output);
asc_set_l0c_copy_params(1,0,0);
asc_copy_l0c2gm(
scratch +(uint64_t(worker)* 2 + output)* 16896,cc,BN,f.rows,BN,tm,0,0,0,false,true);
ffts_cross_core_sync(PIPE_FIX,0x21ULL |(uint64_t(8 + 2 * output)<< 8));
++ordinal;
cp6_large39::CLease(bank,false);
pending[bank] = true;
wide_pending = tm > 64;
queue[slot] = next;
}
if(pending[0])
cp6_large39::CLease(0,true);
if(pending[1])
cp6_large39::CLease(1,true);
cp6_c38::Drain(ordinal);
}

using cp9_large_pipe::DeferredFrame;

using cp9_large_pipe::FinishFrame;

using cp9_large_pipe::SavedIndex;

using cp9_large_pipe::SavedZ;

template <bool Curve>
__aicore__ inline void VectorTail(
__gm__ float *scale,__gm__ int64_t *groups,__gm__ half *y,__gm__ int32_t *scratch,Cursor cur){
const uint32_t worker = asc_get_block_idx(),sub = asc_get_sub_block_id();
uint32_t ordinal = 0;
cp6_sv59::State state{};
DeferredFrame pending{};
auto z =(__ubuf__ float *)0;
auto sc =(__ubuf__ float *)181760;
for(Frame f = Next(cur,groups,worker);f.rows;f = Next(cur,groups,worker)){
const uint32_t bank = ordinal % 2,split =(f.rows + 1)/ 2,local = sub * split;
const uint32_t rows = sub ? f.rows - split : split,count = rows * BN;
if(rows)
asc_copy_gm2ub_align(sc,scale + uint64_t(f.expert)* N + f.col,1,BN * 4,0,0,0,0);
asc_sync_block_wait(8 + 2 * bank);
if(rows)
asc_copy_gm2ub_align((__ubuf__ int32_t *)z,scratch +(uint64_t(worker)* 2 + bank)* 16896 + local * BN,1,
count * 4,0,0,0,0);
if(rows)
asc_sync_notify(PIPE_MTE2,PIPE_V,EVENT_ID7);
ffts_cross_core_sync(PIPE_MTE2,0x21ULL |(uint64_t(9 + 2 * bank)<< 8));
if(rows){
asc_sync_wait(PIPE_MTE2,PIPE_V,EVENT_ID7);
asc_int322float_rn(z,(__ubuf__ int32_t *)z,count);
asc_sync_pipe(PIPE_V);
asc_set_mask_norm();
asc_set_vector_mask(0,~uint64_t(0));
for(uint32_t n = 0;n < BN;n += 64)
asc_mul(z + n,z + n,sc + n,uint8_t(rows),1,1,1,32,32,0);
asc_sync_pipe(PIPE_V);
asc_set_vector_mask(~uint64_t(0),~uint64_t(0));
cp6_sv59::Wait(state,bank);
auto out =(__ubuf__ half *)static_cast<uint64_t>(135168 + bank * 16896);
cp6_c38::LargeMidpoint<true,Curve,true>(z,(__ubuf__ float *)33792,(__ubuf__ float *)67584,
(__ubuf__ float *)101376,out,(__ubuf__ uint8_t *)172064,count);
asc_sync_notify(PIPE_V,PIPE_S,EVENT_ID2);
FinishFrame(pending,state);
asc_sync_wait(PIPE_V,PIPE_S,EVENT_ID2);
auto nonzero =(__ubuf__ uint64_t *)169216;
auto mask =(__ubuf__ uint32_t *)172064;
auto bits =(__ubuf__ uint16_t *)out;
uint32_t hard = 0;
for(uint32_t block = 0;block <(count + 2047)/ 2048;++block){
uint64_t active = ~nonzero[block];
while(active){
const uint32_t word = block * 64 + __builtin_ctzll(active);
active &= active - 1;
uint32_t lanes = mask[word];
while(lanes){
const uint32_t lane = word * 32 + __builtin_ctz(lanes);
lanes &= lanes - 1;
if(hard < 256){
SavedIndex(bank)[hard] = lane;
SavedZ(bank)[hard++] = z[lane];
}else
bits[lane] = cp6_c38::GoalRefineLane(z[lane],bits[lane]);
}
}
}
pending ={y + uint64_t(f.row + local)* N + f.col,rows,bank,hard};
}else
FinishFrame(pending,state);
++ordinal;
}
FinishFrame(pending,state);
cp6_sv59::End(state);
}
template <bool Half = false>
__aicore__ __attribute__((always_inline))inline void StaticCubeReady(__gm__ int8_t *x,__gm__ int8_t *w,
__gm__ int64_t *groups,__gm__ int32_t *scratch,uint32_t k,other_large::Cursor cur,
other_large::Frame(&queue)[Slots]){
if constexpr(Half)
asc_set_l0c_copy_prequant(uint64_t(0x39800000U));
const uint32_t worker = asc_get_block_idx(),micros =(k + 127)/ 128;
auto a =(__ca__ int8_t *)0;
auto b =(__cb__ int8_t *)0;
auto c =(__cc__ int32_t *)0;

uint32_t cachedExpert[Slots],cachedCol[Slots];
for(uint32_t q = 0;q < Slots;++q){
cachedExpert[q] = queue[q].expert;
cachedCol[q] = queue[q].col;
}
uint32_t ordinal = 0;
bool pending[2] ={false,false},wide_pending = false;
for(uint32_t tile = 0;queue[tile % Slots].rows;++tile){
const uint32_t slot = tile % Slots;
const other_large::Frame f = queue[slot],next = other_large::Next(cur,groups,worker);
const uint32_t tm = Up(f.rows,16),bank = tm <= 64 ? tile % 2 : 0;
auto base =(__cbuf__ int8_t *)static_cast<uint64_t>(slot * SlotBytes);
auto cc = c + bank * 16384;
cp6_c38::L1R(slot,true);
if(f.first){
auto a1 = base + WeightBytes;
for(uint32_t kk = 0;kk < k;kk += 128){
const uint32_t kp = Min(128U,k - kk);
for(uint32_t i = 0;i < kp / 32;++i)
asc_copy_l12l0a(a + kk * tm + i * 512,a1 +(kk + i * 32)* tm,0,tm / 16,1,kp / 32 - 1);
}
}
for(uint32_t j = 0;j < micros;++j){
const uint32_t l0 = j % 2,kk = j * 128,kp = Min(128U,k - kk);
if(j >= 2)
cp6_c38::LF(l0,true);
for(uint32_t i = 0;i < kp / 32;++i)
asc_copy_l12l0b_trans(
b + l0 * 32768 + i * 32 * BN,base +(kk + i * 32)* 32,0,BN / 32,k / 32,1,false,uint64_t(0));
cp6_c38::LR(l0,false);
if(j + 1 == micros && next.rows){
cp6_c38::L1F(slot,false);
cp6_c38::L1F(slot,true);
other_large::Prefetch(
x,w,next,k,slot,cachedExpert[slot] != next.expert || cachedCol[slot] != next.col);
cachedExpert[slot] = next.expert;
cachedCol[slot] = next.col;
}
cp6_c38::LR(l0,true);
if(!j){
if((tm > 64 || wide_pending || bank == 0)&& pending[0]){
cp6_large39::CLease(0,true);
pending[0] = false;
}
if((tm > 64 || bank == 1)&& pending[1]){
cp6_large39::CLease(1,true);
pending[1] = false;
}
wide_pending = false;
}
asc_mmad(cc,a + kk * tm,b + l0 * 32768,tm,kp,BN,0,false,false,j == 0);
cp6_c38::LF(l0,false);
}
for(uint32_t j = micros - 2;j < micros;++j)
cp6_c38::LF(j % 2,true);
asc_sync_notify(PIPE_M,PIPE_FIX,EVENT_ID5);
asc_sync_wait(PIPE_M,PIPE_FIX,EVENT_ID5);
if constexpr(Half)
compact_rows::StoreHalf<16896>(cc,scratch,worker,f.rows,tm,ordinal);
else{
const uint32_t output = ordinal % 2;
if(ordinal >= 2)
asc_sync_block_wait(9 + 2 * output);
asc_set_l0c_copy_params(1,0,0);
asc_copy_l0c2gm(
scratch +(uint64_t(worker)* 2 + output)* 16896,cc,BN,f.rows,BN,tm,0,0,0,false,true);
ffts_cross_core_sync(PIPE_FIX,0x21ULL |(uint64_t(8 + 2 * output)<< 8));
++ordinal;
}
cp6_large39::CLease(bank,false);
pending[bank] = true;
wide_pending = tm > 64;
queue[slot] = next;
}
if(pending[0])
cp6_large39::CLease(0,true);
if(pending[1])
cp6_large39::CLease(1,true);
cp6_c38::Drain(ordinal);
}
}// namespace breakthrough_large_balance
namespace compact_large{
static __aicore__ __attribute__((noinline,aligned(4096),section(".zzzzzzzzzzzz_hd_half_large_cube")))void Cube(
__gm__ int8_t *,__gm__ int8_t *,__gm__ int64_t *,__gm__ int32_t *,uint32_t,other_large::Cursor,
other_large::Frame(&)[other_large::Slots]);
}
namespace compact_rows_post{
static __aicore__ __attribute__((noinline,aligned(4096),section(".zzzzzzzzzzzz_hd_half_vec_mid")))void Mid(
__ubuf__ int64_t *,__gm__ float *,__gm__ half *,__gm__ int32_t *);
static __aicore__ __attribute__((noinline,aligned(4096),section(".zzzzzzzzzzzz_hd_half_vec_large")))void Large(
__ubuf__ int64_t *,__gm__ float *,__gm__ half *,__gm__ int32_t *);
}
__global__ __mix__(1,2)__attribute__((section(".zz_other_large")))void grouped_matmul_gelu_other_large(
__gm__ int8_t *x,__gm__ int8_t *w,__gm__ float *scale,__gm__ int64_t *groups,__gm__ half *y,
__gm__ int32_t *scratch,uint32_t k,uint64_t sync_base){
set_ffts_base_addr(sync_base);
asc_init();
if ASC_IS_AIC{
const uint32_t worker = asc_get_block_idx();
other_large::Cursor initial{};
other_large::Frame queue[other_large::Slots];
for(uint32_t slot = 0;slot < 1;++slot){
queue[slot] = other_large::Next(initial,groups,worker);
if(queue[slot].rows)
other_large::Prefetch(x,w,queue[slot],k,slot);
}
auto cur = breakthrough_large_balance::ReadCursor(scratch,worker);
if(cur.compactRows && !(uint64_t(x)& 31U)&& !(uint64_t(w)& 255U)&& !(uint64_t(y)& 31U)){
for(uint32_t slot = 1;slot < other_large::Slots;++slot){
queue[slot] = other_large::Next(initial,groups,worker);
if(queue[slot].rows)
other_large::Prefetch(x,w,queue[slot],k,slot);
}
compact_large::Cube(x,w,groups,scratch,k,initial,queue);
}else if(cur.initialized){
for(uint32_t slot = 0;slot < 1;++slot)
if(queue[slot].rows)
cp6_c38::L1R(slot,true);
asc_sync_notify(PIPE_MTE1,PIPE_MTE2,EVENT_ID7);
asc_sync_wait(PIPE_MTE1,PIPE_MTE2,EVENT_ID7);
breakthrough_large_balance::Cube(x,w,groups,scratch,k,cur);
}else{
for(uint32_t slot = 1;slot < other_large::Slots;++slot){
queue[slot] = other_large::Next(initial,groups,worker);
if(queue[slot].rows)
other_large::Prefetch(x,w,queue[slot],k,slot);
}
breakthrough_large_balance::StaticCubeReady(x,w,groups,scratch,k,initial,queue);
}
}
if ASC_IS_AIV{
auto cur = breakthrough_large_balance::PrepareCursor(groups,scratch,asc_get_block_idx());
if(cur.compactRows && !(uint64_t(x)& 31U)&& !(uint64_t(w)& 255U)&& !(uint64_t(y)& 31U)){
compact_rows_post::Large((__ubuf__ int64_t *)0,scale,y,scratch);
}else if(cur.initialized)
breakthrough_large_balance::VectorTail<true>(scale,groups,y,scratch,cur);
else
other_large::VectorTail<true>(scale,groups,y,scratch);
}
asc_sync();
}

namespace other_mid{
using cp6_c38::Min;

using cp6_c38::Up;

constexpr uint32_t N = 768,BN = 256,CK = 256,LK = 128,Slots = 4,ABytes = 81920,BBytes = BN * CK;

struct Frame{
uint32_t expert,row,rows,col,abank;
bool first;
};

struct Cursor{
uint32_t start,stop,expert,row,end,first_col,stop_col,col,abank;
bool main;
bool active;
};

__aicore__ __attribute__((always_inline))inline Cursor Init(uint32_t worker){
const uint32_t first = worker + Min(worker,16U);
return Cursor{first,Min(36U,first +(worker < 16 ? 2U : 1U)),0,0,0,0,0,0,1,true,false};
}

template <class Groups>
__aicore__ __attribute__((always_inline))inline Frame Next(Cursor &cur,Groups groups,uint32_t worker){
for(;;){
if(!cur.active){
if(cur.main && cur.start >= cur.stop){
cur.expert = worker;
cur.first_col = 0;
cur.stop_col = N;
cur.main = false;
}else{
if(cur.start >= cur.stop)
return Frame{};
const uint32_t t = cur.start,count = Min(3 - t % 3,cur.stop - t);
cur.expert = 20 + t / 3;
cur.first_col = t % 3 * BN;
cur.stop_col = cur.first_col + count * BN;
cur.start += count;
}
cur.row = cur.expert ? uint32_t(groups[cur.expert - 1]): 0;
cur.end = uint32_t(groups[cur.expert]);
cur.col = cur.first_col;
cur.active = true;
}
if(cur.row < cur.end){
const bool first = cur.col == cur.first_col;
if(first)
cur.abank ^= 1;
Frame f{cur.expert,cur.row,Min(80U,cur.end - cur.row),cur.col,cur.abank,first};
cur.col += BN;
if(cur.col == cur.stop_col){
cur.row += f.rows;
cur.col = cur.first_col;
}
return f;
}
cur.active = false;
}
}

struct Panel{
Frame f;
uint32_t k0;
};

struct Fetch{
Cursor work;
Frame frame;
uint32_t k0;
};

__aicore__ __attribute__((always_inline))inline Panel NextPanel(
Fetch &fetch,__gm__ int64_t *groups,uint32_t worker,uint32_t k){
if(!fetch.k0)
fetch.frame = Next(fetch.work,groups,worker);
const Panel panel{fetch.frame,fetch.k0};
if(panel.f.rows){
fetch.k0 += CK;
if(fetch.k0 >= k)
fetch.k0 = 0;
}
return panel;
}

__aicore__ __attribute__((always_inline))inline void Prefetch(
__gm__ int8_t *x,__gm__ int8_t *w,Panel p,uint32_t k,uint32_t slot){
auto b1 =(__cbuf__ int8_t *)static_cast<uint64_t>(slot * BBytes);
const Frame f = p.f;
if(f.first && !p.k0){
auto a1 =(__cbuf__ int8_t *)static_cast<uint64_t>(Slots * BBytes + f.abank * ABytes);
asc_copy_gm2l1_nd2nz(a1,x + uint64_t(f.row)* k,1,f.rows,k,0,k,Up(f.rows,16),1,0);
}
const uint32_t span = Min(CK,k - p.k0);
asc_copy_gm2l1_nd2nz(
b1,w +(uint64_t(f.expert)* k + p.k0)* N + f.col,span / 32,32,BN,32 * N,N,32,1,32 * BN);
cp6_staged_a::WeightReady(slot,false);
}

__aicore__ inline void VectorTail(
__gm__ float *scale,__gm__ int64_t *groups,__gm__ half *y,__gm__ int32_t *scratch){
const uint32_t worker = asc_get_block_idx(),sub = asc_get_sub_block_id();
Cursor cur = Init(worker);
cp6_sv59::State state{};
uint32_t ordinal = 0;
for(Frame f = Next(cur,groups,worker);f.rows;f = Next(cur,groups,worker))
cp6_sv59::LargeTile<true>(
state,scale,y,scratch,worker,sub,f.expert,f.row,f.col,f.rows,BN,N,ordinal);
cp6_sv59::End(state);
}

__aicore__ inline void VectorWideTail(
__gm__ float *scale,__gm__ int64_t *groups,__gm__ half *y,__gm__ int32_t *scratch){
const uint32_t worker = asc_get_block_idx(),sub = asc_get_sub_block_id();
Cursor cur = Init(worker);
uint32_t ordinal = 0;
bool hasOut = false;
auto z =(__ubuf__ float *)0;
auto sc =(__ubuf__ float *)188672;
auto out =(__ubuf__ half *)163840;
for(Frame f = Next(cur,groups,worker);f.rows;f = Next(cur,groups,worker)){
const uint32_t slot = ordinal % 2,half =(f.rows + 1)/ 2,local = sub * half;
const uint32_t rows = sub ? f.rows - half : half,count = rows * BN;
if(rows)
asc_copy_gm2ub_align(sc,scale + uint64_t(f.expert)* N + f.col,1,1024,0,0,0,0);
asc_sync_block_wait(8 + 2 * slot);
if(rows){
asc_copy_gm2ub_align((__ubuf__ int32_t *)z,scratch +(uint64_t(worker)* 2 + slot)* 20480 + local * BN,1,
count * 4,0,0,0,0);
asc_sync_notify(PIPE_MTE2,PIPE_V,EVENT_ID7);
}
ffts_cross_core_sync(PIPE_MTE2,0x21ULL |(uint64_t(9 + 2 * slot)<< 8));
if(rows){
asc_sync_wait(PIPE_MTE2,PIPE_V,EVENT_ID7);
asc_int322float_rn(z,(__ubuf__ int32_t *)z,count);
asc_sync_pipe(PIPE_V);
asc_set_mask_norm();
asc_set_vector_mask(0,~uint64_t(0));
for(uint32_t n = 0;n < BN;n += 64)
asc_mul(z + n,z + n,sc + n,uint8_t(rows),1,1,1,32,32,0);
asc_sync_pipe(PIPE_V);
asc_set_vector_mask(~uint64_t(0),~uint64_t(0));
cp6_c38::LargeMidpoint<false,true,true,true>(z,(__ubuf__ float *)40960,(__ubuf__ float *)81920,
(__ubuf__ float *)122880,out,(__ubuf__ uint8_t *)186880,count,hasOut);
asc_sync_notify(PIPE_S,PIPE_MTE3,EVENT_ID0);
asc_sync_wait(PIPE_S,PIPE_MTE3,EVENT_ID0);
asc_copy_ub2gm_align(y + uint64_t(f.row + local)* N + f.col,out,rows,512,0,0,0,(N - BN)* 2);
asc_sync_notify(PIPE_MTE3,PIPE_V,EVENT_ID4);
hasOut = true;
}
++ordinal;
}
if(hasOut)
asc_sync_wait(PIPE_MTE3,PIPE_V,EVENT_ID4);
asc_sync();
ffts_cross_core_sync(PIPE_MTE3,0x21ULL |(uint64_t(12)<< 8));
}
}// namespace other_mid

__global__ __mix__(1,2)
__attribute__((section(".zzzzzzzz_other_mid_read_ahead")))void grouped_matmul_gelu_other_mid_read_ahead(
__gm__ int8_t *x,__gm__ int8_t *w,__gm__ float *scale,__gm__ int64_t *groups,__gm__ half *y,
__gm__ int32_t *scratch,uint32_t K,uint64_t sync_base);

namespace hb_fractal_stream{
using dfocus::Min;

using dfocus::Up;

struct Tile{
uint32_t expert,row,col,rows,cols,packed;
};

template <uint32_t M,uint32_t N> struct Cursor{
uint32_t expert = 0,start = 0,row = 0,col = 0,left = 0,packed = 0;
__aicore__ __attribute__((always_inline))inline Tile Next(__gm__ int64_t *groups,uint32_t width){
if(!left)
return{};
while(true){
const uint32_t end = uint32_t(groups[expert]);
if(row < end){
const Tile t{expert,row,col,Min(M,end - row),Min(N,width - col),packed + row - start};
col += N;
if(col >= width){
col = 0;
row += M;
}
--left;
return t;
}
++expert;
packed += Up(end - start,32);
row = start = end;
}
}
};

template <uint32_t M,uint32_t N,bool OwnRows = false>
__aicore__ __attribute__((always_inline))inline Cursor<M,N> Schedule(
__gm__ int64_t *groups,uint32_t E,uint32_t width,uint32_t workers){
uint32_t ends[32];
uint32_t total = 0,prev = 0;
const uint32_t panels =(width + N - 1)/ N;
for(uint32_t e = 0;e < E;++e){
const uint32_t end = uint32_t(groups[e]);
total +=((end - prev + M - 1)/ M)*(OwnRows ? 1 : panels);
ends[e] = end;
prev = end;
}
const uint32_t worker = asc_get_block_idx(),extra = total % workers,base = total / workers;
uint32_t first = worker * base + Min(worker,extra);
Cursor<M,N> cur{};
cur.left = base + uint32_t(worker < extra);
if constexpr(OwnRows){
first *= panels;
cur.left *= panels;
}
for(uint32_t e = 0;cur.left && e < E;++e){
const uint32_t tiles =((ends[e] - cur.start + M - 1)/ M)* panels;
if(first < tiles){
cur.expert = e;
cur.row = cur.start + first / panels * M;
cur.col = first % panels * N;
break;
}
first -= tiles;
cur.packed += Up(ends[e] - cur.start,32);
cur.start = ends[e];
}
return cur;
}

struct Chunk{
Tile tile;
uint32_t k;
};

template <uint32_t M,uint32_t N,uint32_t BK,bool Long,bool Packed,bool Compact>
__aicore__ __attribute__((always_inline))inline void Fetch(
__gm__ int8_t *x,__gm__ int8_t *w,Chunk job,uint32_t K,uint32_t width,uint32_t slot,uint32_t xStride){
auto a =(__cbuf__ int8_t *)0;
auto b = a +(Long ? 2 * M * BK : M * Up(K,32))+ slot * N * BK;
const Tile t = job.tile;
const uint32_t k = Min(BK,K - job.k),full = k / 32;
const uint32_t mp = Up(t.rows,32),tail = k % 32,np = Compact ? Up(t.cols,32): N;
if constexpr(Long){
a += slot * M * BK;
asc_copy_gm2l1(
a,x + uint64_t(job.k)* xStride + t.packed * 128,BK / 128,mp * 128 / 32,(xStride - mp)* 128 / 32,0);
}
asc_copy_gm2l1(b,w +(uint64_t(t.expert)* 8192 + job.k)* 544 + t.col * 32,Up(k,32)/ 32,np,544 - np,0);
cp6_c38::L1R(slot,false);
}

template <uint32_t M, uint32_t N, uint32_t BK, uint32_t LK, bool Long, bool Packed = true, bool Compact = false,
uint32_t HeadK = 4096, uint32_t Prefix = 0>
__aicore__ __attribute__((always_inline)) inline void Cube(__gm__ int8_t *x, __gm__ int8_t *w, __gm__ int64_t *groups,
__gm__ int32_t *scratch, uint32_t E, uint32_t K, uint32_t width, uint32_t workers, uint32_t xStride,
__gm__ int8_t *rawX = nullptr, __gm__ int8_t *rawW = nullptr) {
static_assert(2 * N * BK + (Long ? 2 * M * BK : M * 1088) <= 524032);
static_assert(M * N <= 32768 && M * LK <= 32768 && N * LK <= 32768);
auto cursor = Schedule<M, N>(groups, E, width, workers);
const uint32_t worker = asc_get_block_idx(), kp = Up(K, 32);
bool secondWave = false;
Chunk next{cursor.Next(groups, width), Prefix}, queue[2];
if constexpr (Prefix) {
const auto t = next.tile;
if (t.rows) {
const uint32_t mp = Up(t.rows, 32), np = Up(t.cols, 32);
auto a1 = (__cbuf__ int8_t *)0, b1 = a1 + mp * Prefix;
asc_copy_gm2l1_nd2nz(a1, rawX + uint64_t(t.row) * K, 1, t.rows, Prefix, 0, K, mp, 1, 0);
asc_copy_gm2l1_nd2nz(
b1, rawW + uint64_t(t.expert) * K * width + t.col, 1, Prefix, t.cols, 0, width, Prefix, 1, 0);
asc_sync_notify(PIPE_MTE2, PIPE_MTE1, EVENT_ID7);
asc_sync_wait(PIPE_MTE2, PIPE_MTE1, EVENT_ID7);
d6_l0::Multiply(a1, b1, (__ca__ int8_t *)0, (__cb__ int8_t *)0, (__cc__ int32_t *)0, mp, mp, np, Prefix);
}
asc_sync_block_wait(13);
}
for (uint32_t slot = 0; slot < 2; ++slot) {
queue[slot] = next;
if (next.tile.rows) {
Fetch<M, N, BK, Long, Packed, Compact>(x, w, next, K, width, slot, xStride);
next.k += BK;
if (next.k >= K)
next = {cursor.Next(groups, width), 0};
}
}
uint32_t ordinal = 0, phase = 0, currentRow = uint32_t(-1);
for (uint32_t i = 0; queue[i % 2].tile.rows; ++i) {
const uint32_t slot = i % 2, output = ordinal % 2;
const Chunk job = queue[slot];
const Tile t = job.tile;
const uint32_t span = Min(BK, kp - job.k), mp = Up(t.rows, 32);
const uint32_t np = Up(t.cols, 32);
const uint32_t cubeCols = Compact ? np : N;
auto a1 = (__cbuf__ int8_t *)0;
auto b1 = a1 + (Long ? 2 * M * BK : M * kp) + slot * N * BK;
if constexpr (Long)
a1 += slot * M * BK;
else if (t.row != currentRow) {
if (phase) {
asc_sync_notify(PIPE_MTE1, PIPE_MTE2, EVENT_ID7);
asc_sync_wait(PIPE_MTE1, PIPE_MTE2, EVENT_ID7);
}
if (K != kp)
cp6_gmg_opt::ZeroL1(a1 + (kp - 32) * mp, 32 * mp);
asc_copy_gm2l1_nd2nz(a1, x + uint64_t(t.row) * K, 1, t.rows, K, 0, K, mp, 1, 0);
asc_sync_notify(PIPE_MTE2, PIPE_MTE1, EVENT_ID7);
asc_sync_wait(PIPE_MTE2, PIPE_MTE1, EVENT_ID7);
currentRow = t.row;
}
auto cc = (__cc__ int32_t *)0;
cp6_c38::L1R(slot, true);
for (uint32_t off = 0; off < span; off += LK, ++phase) {
const uint32_t k = Min(LK, span - off), bank = phase % 2;
auto a = (__ca__ int8_t *)static_cast<uint64_t>(bank * 32768);
auto b = (__cb__ int8_t *)static_cast<uint64_t>(bank * 32768);
if (phase >= 2)
cp6_c38::LF(bank, true);
const uint32_t ka = Long ? off : job.k + off;
auto packedA = a1 + ka * mp;
if (k == 128)
asc_copy_l12l0a(a, packedA, 0, mp / 4, 1, 0);
else
for (uint32_t m = 0; m < mp / 16; ++m)
asc_copy_l12l0a(a + m * k * 16, packedA + m * 2048, 0, k / 32, 1, 0);
if constexpr (Packed) {
asc_copy_l12l0b_trans(b, b1 + off * cubeCols, 0, k / 32 * (cubeCols / 32), 1, 1, false, uint64_t(0));
} else {
for (uint32_t i = 0; i < k / 32; ++i)
asc_copy_l12l0b_trans(
b + i * cubeCols * 32, b1 + (off + i * 32) * 32, 0, np / 32, span / 32, 1, false, uint64_t(0));
}
cp6_c38::LR(bank, false);
if (off + k == span && next.tile.rows) {
cp6_c38::L1F(slot, false);
cp6_c38::L1F(slot, true);
if (!secondWave && next.k >= HeadK) {
asc_sync_block_wait(7);
secondWave = true;
}
Fetch<M, N, BK, Long, Packed, Compact>(x, w, next, K, width, slot, xStride);
}
cp6_c38::LR(bank, true);
const bool first = job.k + off == 0;
if (first && ordinal)
cp6_large39::CLease(0, true);
if (!first && k == 32)
asc_sync_pipe(PIPE_M);
if constexpr (Compact) {
if (cubeCols < 64)
asc_mmad_sync(cc, a, b, mp, k, cubeCols, 0, false, false, first);
else
asc_mmad(cc, a, b, mp, k, cubeCols, 0, false, false, first);
} else
asc_mmad(cc, a, b, mp, k, cubeCols, 0, false, false, first);
cp6_c38::LF(bank, false);
}
if (job.k + span == kp) {
if (ordinal >= 2)
asc_sync_block_wait(9 + 2 * output);
asc_sync_notify(PIPE_M, PIPE_FIX, EVENT_ID5);
asc_sync_wait(PIPE_M, PIPE_FIX, EVENT_ID5);
asc_set_l0c_copy_params(1, 0, 0);
asc_copy_l0c2gm(scratch + (2 * worker + output) * M * N, cc, np, t.rows, np, mp, 0, 0, 0, false, true);
ffts_cross_core_sync(PIPE_FIX, 0x21ULL | (uint64_t(8 + 2 * output) << 8));
cp6_large39::CLease(0, false);
++ordinal;
}
queue[slot] = next;
if (next.tile.rows) {
next.k += BK;
if (next.k >= K)
next = {cursor.Next(groups, width), 0};
}
}
for (uint32_t i = phase > 2 ? phase - 2 : 0; i < phase; ++i)
cp6_c38::LF(i % 2, true);
if (ordinal)
cp6_large39::CLease(0, true);
if (!secondWave)
asc_sync_block_wait(7);
cp6_c38::Drain(ordinal);
}

template <uint32_t M,uint32_t N,class Cursor>
__aicore__ __attribute__((always_inline))inline void VectorFromCursor(Cursor cursor,__gm__ float *scale,
__gm__ int64_t *groups,__gm__ half *y,__gm__ int32_t *scratch,uint32_t E,uint32_t width,uint32_t workers){

const uint32_t worker = asc_get_block_idx(),sub = asc_get_sub_block_id();
auto z =(__ubuf__ float *)0;
auto u =(__ubuf__ float *)49152;
auto sc =(__ubuf__ float *)98304;
uint32_t ordinal = 0,batch = 0;
set_mov_pad_val(uint32_t(0));
for(auto t = cursor.Next(groups,width);t.rows;t = cursor.Next(groups,width),++ordinal){
const uint32_t slot = ordinal % 2,np = Up(t.cols,32),halfRows =(t.rows + 1)/ 2;
const uint32_t start = sub * halfRows,length = Min(halfRows,t.rows - start);
asc_copy_gm2ub_align(
sc,scale + uint64_t(t.expert)* width + t.col,1,t.cols * 4,0,Up(t.cols,8)- t.cols,0,0);
asc_sync_block_wait(8 + 2 * slot);
constexpr uint32_t Rows = 12288 / N;
for(uint32_t row = 0;row < length;row += Rows){
const uint32_t rows = Min(Rows,length - row),elems = rows * np,count = Up(elems,64);
const uint32_t event = batch % 2;
auto out =(__ubuf__ half *)static_cast<uint64_t>(100352 + event * 24576);
auto src = scratch +(2 * worker + slot)* M * N +(start + row)* np;
asc_copy_gm2ub_align((__ubuf__ int32_t *)z,src,1,elems * 4,0,0,0,0);
if(row + rows == length)
ffts_cross_core_sync(PIPE_MTE2,0x21ULL |(uint64_t(9 + 2 * slot)<< 8));
asc_sync_notify(PIPE_MTE2,PIPE_V,EVENT_ID0);
asc_sync_wait(PIPE_MTE2,PIPE_V,EVENT_ID0);
asc_int322float_rn(z,(__ubuf__ int32_t *)z,count);
asc_sync_pipe(PIPE_V);
asc_set_mask_norm();
for(uint32_t col = 0;col < np;col += 64){
asc_set_vector_mask(uint64_t(0),np - col >= 64 ? ~uint64_t(0): uint64_t(0xffffffff));
asc_mul(z + col,z + col,sc + col,uint8_t(rows),1,1,1,np / 8,np / 8,0);
}
asc_sync_pipe(PIPE_V);
asc_set_vector_mask(~uint64_t(0),~uint64_t(0));
asc_mul(u,z,z,count);
asc_sync_pipe(PIPE_V);
asc_mul(u,u,z,count);
asc_sync_pipe(PIPE_V);
asc_mul_scalar(u,u,0.044715f,count);
asc_sync_pipe(PIPE_V);
asc_add(u,u,z,count);
asc_sync_pipe(PIPE_V);
asc_mul_scalar(u,u,-1.5957691216057308f,count);
asc_sync_pipe(PIPE_V);
asc_min_scalar(u,u,80.0f,count);
asc_sync_pipe(PIPE_V);
asc_exp(u,u,count);
asc_sync_pipe(PIPE_V);
asc_add_scalar(u,u,1.0f,count);
asc_sync_pipe(PIPE_V);
asc_div(z,z,u,count);
asc_sync_pipe(PIPE_V);
if(batch >= 2){
if(event)
asc_sync_wait(PIPE_MTE3,PIPE_V,EVENT_ID3);
else
asc_sync_wait(PIPE_MTE3,PIPE_V,EVENT_ID2);
}
asc_float2half_rn(out,z,count);
asc_sync_notify(PIPE_V,PIPE_MTE3,EVENT_ID0);
asc_sync_wait(PIPE_V,PIPE_MTE3,EVENT_ID0);
asc_copy_ub2gm_align(y + uint64_t(t.row + start + row)* width + t.col,out,rows,t.cols * 2,0,0,
(np - Up(t.cols,16))/ 16,(width - t.cols)* 2);
if(event)
asc_sync_notify(PIPE_MTE3,PIPE_V,EVENT_ID3);
else
asc_sync_notify(PIPE_MTE3,PIPE_V,EVENT_ID2);
asc_sync_notify(PIPE_V,PIPE_MTE2,EVENT_ID0);
asc_sync_wait(PIPE_V,PIPE_MTE2,EVENT_ID0);
++batch;
}
if(!length)
ffts_cross_core_sync(PIPE_MTE2,0x21ULL |(uint64_t(9 + 2 * slot)<< 8));
}
if(batch >= 1)
asc_sync_wait(PIPE_MTE3,PIPE_V,EVENT_ID2);
if(batch >= 2)
asc_sync_wait(PIPE_MTE3,PIPE_V,EVENT_ID3);
ffts_cross_core_sync(PIPE_MTE3,0x21ULL |(uint64_t(12)<< 8));
}

template <uint32_t M,uint32_t N,bool OwnRows = false>
__aicore__ __attribute__((always_inline))inline void Vector(__gm__ float *scale,__gm__ int64_t *groups,
__gm__ half *y,__gm__ int32_t *scratch,uint32_t E,uint32_t width,uint32_t workers){
auto cursor = Schedule<M,N,OwnRows>(groups,E,width,workers);
VectorFromCursor<M,N>(cursor,scale,groups,y,scratch,E,width,workers);
}
}// namespace hb_fractal_stream

namespace hb_fractal{
using hb_fractal_stream::Min;

using hb_fractal_stream::Up;

constexpr uint32_t Rows = 32,Chunk = 512,Micro = 128,Bytes = Rows * Chunk;

struct Shape{
uint32_t ends[3],packed[4];
};

__aicore__ __attribute__((always_inline))inline Shape ReadShape(__gm__ int64_t *groups){
Shape shape{};
uint32_t start = 0;
for(uint32_t e = 0;e < 3;++e){
const uint32_t end = uint32_t(groups[e]);
shape.ends[e] = end;
shape.packed[e + 1] = shape.packed[e] + Up(end - start,Rows);
start = end;
}
return shape;
}

template <uint32_t PackRows,uint32_t HeadK,uint32_t Prefix = 0>
__aicore__ __attribute__((always_inline))inline void PackWeights(__gm__ int8_t *w,__gm__ int8_t *packed,uint32_t k,
uint32_t n,uint32_t rank,uint32_t workers,uint32_t wave,uint32_t activeMask){
constexpr uint32_t Width = 544,Rows = PackRows;
const uint32_t Slice = wave ? 8192 - HeadK : HeadK - Prefix;
constexpr uint32_t OffsetsPerParity = Width * Rows / 64;
constexpr uint32_t InputBytes = 17920,OutputBytes = Width * Rows;
auto offsets =(__ubuf__ uint32_t *)180224;
const uint32_t shift = n % 32;
if(!wave){
constexpr uint32_t Blocks = Width / 32;
for(uint32_t parity = 0;parity < 2;++parity)
for(uint32_t half = 0;half < Rows / 32;++half)
for(uint32_t r = 0;r < 16;++r)
offsets[parity * OffsetsPerParity + half * Width / 2 + r] =
n % 16 ?(half * 16 + r)* Width :(half * 32 + 2 * r + parity)* n + parity * shift;
asc_sync_notify(PIPE_S,PIPE_V,EVENT_ID7);
asc_sync_wait(PIPE_S,PIPE_V,EVENT_ID7);
for(uint32_t used = 1;used < Blocks;used *= 2){
const uint32_t count = Min(used,Blocks - used)* 16;
for(uint32_t parity = 0;parity < 2;++parity)
for(uint32_t half = 0;half < Rows / 32;++half){
auto segment =(__ubuf__ int32_t *)(offsets + parity * OffsetsPerParity + half * Width / 2);
asc_add_scalar(segment + used * 16,segment,int32_t(used * 32),count);
}
asc_sync_pipe(PIPE_V);
}
}
set_mov_pad_val(uint32_t(0));
asc_set_mask_norm();
asc_set_vector_mask(~uint64_t(0),~uint64_t(0));
const uint32_t active = __builtin_popcount(activeMask);
uint32_t batch = 0;
for(uint32_t tile = rank;tile < active *(Slice / Rows);tile += 2 * workers,++batch){
const bool odd = batch % 2;
auto src =(__ubuf__ int8_t *)static_cast<uint64_t>(odd ? 2 * InputBytes : 0);
auto alternate = src + InputBytes;
auto dst =(__ubuf__ int8_t *)static_cast<uint64_t>(4 * InputBytes +(odd ? OutputBytes : 0));
if(batch >= 2){
if(odd)
asc_sync_wait(PIPE_V,PIPE_MTE2,EVENT_ID6);
else
asc_sync_wait(PIPE_V,PIPE_MTE2,EVENT_ID5);
}
uint32_t mask = activeMask;
for(uint32_t i = 0;i < tile /(Slice / Rows);++i)
mask &= mask - 1;
const uint32_t expert = __builtin_ctz(mask),row =(wave ? HeadK : Prefix)+ tile %(Slice / Rows)* Rows;
const uint32_t rows = row < k ? Min(Rows,k - row): 0,bytes = rows * n;
if(rows < Rows){
asc_duplicate((__ubuf__ int32_t *)src,int32_t(0),uint32_t(InputBytes / 4));
if(shift)
asc_duplicate((__ubuf__ int32_t *)alternate,int32_t(0),uint32_t(InputBytes / 4));
asc_sync_notify(PIPE_V,PIPE_MTE2,EVENT_ID0);
asc_sync_wait(PIPE_V,PIPE_MTE2,EVENT_ID0);
}
if(bytes){
auto raw = w +(uint64_t(expert)* k + row)* n;
if(n % 16){
asc_copy_gm2ub_align(src,raw,(rows + 1)/ 2,n,0,Width - n,n,0);
if(rows > 1)
asc_copy_gm2ub_align(alternate,raw + n,rows / 2,n,0,Width - n,n,0);
}else{
asc_copy_gm2ub_align(src,raw,1,bytes,0,Up(bytes,32)- bytes,0,0);
if(shift)
asc_copy_gm2ub_align(alternate,raw,1,bytes,shift,Up(bytes + shift,32)- bytes - shift,0,0);
}
asc_sync_notify(PIPE_MTE2,PIPE_V,EVENT_ID0);
asc_sync_wait(PIPE_MTE2,PIPE_V,EVENT_ID0);
}
if(batch >= 2){
if(odd)
asc_sync_wait(PIPE_MTE3,PIPE_V,EVENT_ID5);
else
asc_sync_wait(PIPE_MTE3,PIPE_V,EVENT_ID4);
}
asc_gather_datablock((__ubuf__ uint32_t *)dst,(__ubuf__ uint32_t *)src,offsets,16,2,OffsetsPerParity / 8);
asc_gather_datablock((__ubuf__ uint32_t *)(dst + 32),(__ubuf__ uint32_t *)(shift ? alternate : src),
offsets + OffsetsPerParity,16,2,OffsetsPerParity / 8);
asc_sync_notify(PIPE_V,PIPE_MTE3,EVENT_ID0);
asc_sync_wait(PIPE_V,PIPE_MTE3,EVENT_ID0);
asc_copy_ub2gm_align(packed +(uint64_t(expert)* 8192 + row)* Width,dst,Width * Rows);
if(odd)
asc_sync_notify(PIPE_MTE3,PIPE_V,EVENT_ID5);
else
asc_sync_notify(PIPE_MTE3,PIPE_V,EVENT_ID4);
if(odd)
asc_sync_notify(PIPE_V,PIPE_MTE2,EVENT_ID6);
else
asc_sync_notify(PIPE_V,PIPE_MTE2,EVENT_ID5);
}
if(batch){
asc_sync_wait(PIPE_MTE3,PIPE_V,EVENT_ID4);
asc_sync_wait(PIPE_V,PIPE_MTE2,EVENT_ID5);
}
if(batch >= 2){
asc_sync_wait(PIPE_MTE3,PIPE_V,EVENT_ID5);
asc_sync_wait(PIPE_V,PIPE_MTE2,EVENT_ID6);
}
asc_sync();
}

template <uint32_t HeadK = 4096,uint32_t Slab = 4096,uint32_t PackRows = 32,uint32_t Prefix = 0>
__aicore__ __attribute__((always_inline))inline void Prepare(__gm__ int8_t *x,__gm__ int8_t *packed,
const Shape &shape,uint32_t k,uint32_t workers,__gm__ int8_t *w,__gm__ int8_t *pb,uint32_t n){
constexpr uint32_t RowCount = 16,Area = RowCount * Slab;
constexpr uint32_t Pattern = RowCount * 128 / 32,Repeats = Area / 256;
const uint32_t rank = 2 * asc_get_block_idx()+ asc_get_sub_block_id();
const uint32_t stride = shape.packed[3],rowTiles = stride / RowCount;
auto seed =(__ubuf__ int32_t *)185344;
auto offsets =(__ubuf__ uint32_t *)186368;
auto src =(__ubuf__ int8_t *)0;
auto dst = src + Area;
for(uint32_t i = 0;i < Pattern;++i)
seed[i] = int32_t(i % RowCount * Slab + i / RowCount * 32);
asc_sync_notify(PIPE_S,PIPE_V,EVENT_ID7);
asc_sync_wait(PIPE_S,PIPE_V,EVENT_ID7);
asc_copy_ub2ub(offsets,seed,Pattern * 4);
asc_sync_pipe(PIPE_V);
for(uint32_t used = 1;used < Slab / 128;used *= 2){
const uint32_t count = Min(used,Slab / 128 - used)* Pattern;
auto table =(__ubuf__ int32_t *)offsets;
asc_add_scalar(table + used * Pattern,table,int32_t(used * 128),count);
asc_sync_pipe(PIPE_V);
}
const uint32_t activeMask =(shape.ends[0] != 0)|(uint32_t(shape.ends[1] != shape.ends[0])<< 1)|
(uint32_t(shape.ends[2] != shape.ends[1])<< 2);
for(uint32_t wave = 0;wave < 2;++wave){
set_mov_pad_val(uint32_t(0));
asc_set_mask_norm();
asc_set_vector_mask(~uint64_t(0),~uint64_t(0));
const uint32_t waveParts =(wave ? 8192 - HeadK : HeadK)/ Slab;
for(uint32_t task = rank;task < waveParts * rowTiles;task += 2 * workers){
const uint32_t part =(wave ? HeadK / Slab : 0)+ task / rowTiles,pRow = task % rowTiles * RowCount;
const uint32_t expert = pRow < shape.packed[1] ? 0 :(pRow < shape.packed[2] ? 1 : 2);
const uint32_t row =(expert ? shape.ends[expert - 1] : 0)+ pRow - shape.packed[expert];
const uint32_t nr = row < shape.ends[expert] ? Min(RowCount,shape.ends[expert] - row): 0;
const uint32_t nk = Min(Slab,k - part * Slab),padded = Up(nk,32);
if(nr < RowCount || nk < Slab){
asc_duplicate((__ubuf__ int32_t *)src,int32_t(0),uint32_t(Area / 4));
asc_sync_notify(PIPE_V,PIPE_MTE2,EVENT_ID0);
asc_sync_wait(PIPE_V,PIPE_MTE2,EVENT_ID0);
}
if(nr){
asc_copy_gm2ub_align(
src,x + uint64_t(row)* k + part * Slab,nr,nk,0,padded - nk,k - nk,(Slab - padded)/ 32);
asc_sync_notify(PIPE_MTE2,PIPE_V,EVENT_ID0);
asc_sync_wait(PIPE_MTE2,PIPE_V,EVENT_ID0);
}
asc_gather_datablock((__ubuf__ uint32_t *)dst,(__ubuf__ uint32_t *)src,offsets,8,1,Repeats / 2);
asc_gather_datablock((__ubuf__ uint32_t *)(dst + Area / 2),(__ubuf__ uint32_t *)src,offsets + Area / 64,
8,1,Repeats / 2);
asc_sync_notify(PIPE_V,PIPE_MTE3,EVENT_ID0);
asc_sync_wait(PIPE_V,PIPE_MTE3,EVENT_ID0);
asc_copy_ub2gm_align(packed + uint64_t(part)* stride * Slab + pRow * 128,dst,Slab / 128,RowCount * 128,
0,0,0,(stride - RowCount)* 128);
asc_sync();
}
const uint32_t threads = 2 * workers,moreX = waveParts * rowTiles % threads;
const uint32_t weightRank =(rank + threads - moreX)% threads;
PackWeights<PackRows,HeadK,Prefix>(w,pb,k,n,weightRank,workers,wave,activeMask);
const uint32_t barrier = 14 + wave;
ffts_cross_core_sync(PIPE_MTE3,0x1ULL |(uint64_t(barrier)<< 8));
asc_sync_block_wait(barrier);
ffts_cross_core_sync(PIPE_MTE3,0x21ULL |(uint64_t(wave ? 7 : 13)<< 8));
}
asc_sync();
}
}// namespace hb_fractal

template <bool LongHead>
__aicore__ __attribute__((always_inline))inline void HBPackBody(__gm__ int8_t *x,__gm__ int8_t *w,
__gm__ float *scale,__gm__ int64_t *groups,__gm__ half *y,__gm__ int32_t *scratch,uint32_t E,uint32_t K,
uint32_t N,uint32_t workers,uint64_t sync_base){
set_ffts_base_addr(sync_base);
asc_init();
const auto shape = hb_fractal::ReadShape(groups);
const uint32_t tiles =(shape.packed[1] + 255)/ 256 +(shape.packed[2] - shape.packed[1] + 255)/ 256 +
(shape.packed[3] - shape.packed[2] + 255)/ 256;
if(tiles *((N + 95)/ 96)> workers){
const uint32_t kp = hb_fractal_stream::Up(K,256),np = hb_fractal_stream::Up(N,128);
auto px =(__gm__ int8_t *)scratch + uint64_t(workers)* 131072;
auto pw = px + uint64_t(shape.ends[2])* kp;
if ASC_IS_AIC{
asc_sync_block_wait(13);
d6_hb_tiles::Cube<256,128,512,128>(px,pw,groups,scratch,E,kp,np,workers,N,K);
}
if ASC_IS_AIV{
d6_hb_pack::Prepare<8,128,256,128>(x,w,px,pw,shape.ends[2],E,K,N,workers,groups);
d6_hb_tiles::Vector<256,128>(scale,groups,y,scratch,E,N,workers);
}
asc_sync();
return;
}
auto packed =(__gm__ int8_t *)(scratch + uint64_t(workers)* 49152);
auto pb = packed + uint64_t(shape.packed[3])* 8192;
if ASC_IS_AIC{
if constexpr(!LongHead)
asc_sync_block_wait(13);
if constexpr(LongHead)
hb_fractal_stream::Cube<256,96,512,128,true,true,true,6144,512>(
packed,pb,groups,scratch,E,K,N,workers,shape.packed[3],x,w);
else
hb_fractal_stream::Cube<256,96,512,128,true,true,true>(
packed,pb,groups,scratch,E,K,N,workers,shape.packed[3]);
}
if ASC_IS_AIV{
if constexpr(LongHead)
hb_fractal::Prepare<6144,2048,64,512>(x,packed,shape,K,workers,w,pb,N);
else
hb_fractal::Prepare(x,packed,shape,K,workers,w,pb,N);
hb_fractal_stream::Vector<256,96>(scale,groups,y,scratch,E,N,workers);
}
asc_sync();
}

__global__ __mix__(1,2)__attribute__((section(".zzz_hb_aligned")))void grouped_matmul_gelu_hb_aligned(
__gm__ int8_t *x,__gm__ int8_t *w,__gm__ float *scale,__gm__ int64_t *groups,__gm__ half *y,
__gm__ int32_t *scratch,uint32_t E,uint32_t K,uint32_t N,uint32_t workers,uint64_t sync_base){
HBPackBody<false>(x,w,scale,groups,y,scratch,E,K,N,workers,sync_base);
}

namespace wide_post{
using dfocus::Up;

template <uint32_t M,uint32_t N,typename Cursor>
__aicore__ __attribute__((always_inline))inline void Vector(
Cursor cursor,__gm__ float *scale,__gm__ int64_t *groups,__gm__ half *y,__gm__ int32_t *ws,uint32_t width){
static_assert((M / 2)* N <= 15360);
const uint32_t worker = asc_get_block_idx(),sub = asc_get_sub_block_id();
auto z =(__ubuf__ float *)0;
auto u =(__ubuf__ float *)61440;
auto sc =(__ubuf__ float *)122880;
bool pending[2] ={false,false};
uint32_t ordinal = 0,batch = 0;
set_mov_pad_val(uint32_t(0));
for(auto t = cursor.Next(groups,width);t.rows;t = cursor.Next(groups,width),++ordinal){
const uint32_t slot = ordinal % 2,ready = 8 + 2 * slot,split =(t.rows + 1)/ 2;
const uint32_t start = sub * split,rows = sub ? t.rows - split : split,np = Up(t.cols,32);
if(rows)
asc_copy_gm2ub_align(
sc,scale + uint64_t(t.expert)* width + t.col,1,t.cols * 4,0,Up(t.cols,8)- t.cols,0,0);
asc_sync_block_wait(ready);
if(rows)
asc_copy_gm2ub_align(
(__ubuf__ int32_t *)z,ws +(2 * worker + slot)* M * N + start * np,1,rows * np * 4,0,0,0,0);
ffts_cross_core_sync(PIPE_MTE2,0x21ULL |(uint64_t(ready + 1)<< 8));
if(!rows)
continue;
asc_sync_notify(PIPE_MTE2,PIPE_V,EVENT_ID0);
asc_sync_wait(PIPE_MTE2,PIPE_V,EVENT_ID0);
const uint32_t count = Up(rows * np,64);
asc_int322float_rn(z,(__ubuf__ int32_t *)z,count);
asc_sync_pipe(PIPE_V);
asc_set_mask_norm();
for(uint32_t col = 0;col < np;col += 64){
asc_set_vector_mask(uint64_t(0),np - col >= 64 ? ~uint64_t(0): uint64_t(0xffffffff));
asc_mul(z + col,z + col,sc + col,uint8_t(rows),1,1,1,np / 8,np / 8,0);
}
asc_sync_pipe(PIPE_V);
asc_set_vector_mask(~uint64_t(0),~uint64_t(0));
asc_mul(u,z,z,count);
asc_sync_pipe(PIPE_V);
asc_mul(u,u,z,count);
asc_sync_pipe(PIPE_V);
asc_mul_scalar(u,u,0.044715f,count);
asc_sync_pipe(PIPE_V);
asc_add(u,u,z,count);
asc_sync_pipe(PIPE_V);
asc_mul_scalar(u,u,0.7978845608028654f,count);
asc_sync_pipe(PIPE_V);
asc_mul_scalar(u,u,-2.0f,count);
asc_sync_pipe(PIPE_V);
asc_min_scalar(u,u,80.0f,count);
asc_sync_pipe(PIPE_V);
asc_exp(u,u,count);
asc_sync_pipe(PIPE_V);
asc_add_scalar(u,u,1.0f,count);
asc_sync_pipe(PIPE_V);
asc_div(z,z,u,count);
asc_sync_pipe(PIPE_V);
const uint32_t event = batch % 2;
auto out =(__ubuf__ half *)static_cast<uint64_t>(event ? 155648 : 124928);
if(pending[event]){
if(event)
asc_sync_wait(PIPE_MTE3,PIPE_V,EVENT_ID3);
else
asc_sync_wait(PIPE_MTE3,PIPE_V,EVENT_ID2);
}
asc_float2half_rn(out,z,count);
asc_sync_notify(PIPE_V,PIPE_MTE3,EVENT_ID0);
asc_sync_wait(PIPE_V,PIPE_MTE3,EVENT_ID0);
asc_copy_ub2gm_align(y + uint64_t(t.row + start)* width + t.col,out,rows,t.cols * 2,0,0,
(np - Up(t.cols,16))/ 16,(width - t.cols)* 2);
if(event)
asc_sync_notify(PIPE_MTE3,PIPE_V,EVENT_ID3);
else
asc_sync_notify(PIPE_MTE3,PIPE_V,EVENT_ID2);
pending[event] = true;
asc_sync_notify(PIPE_V,PIPE_MTE2,EVENT_ID0);
asc_sync_wait(PIPE_V,PIPE_MTE2,EVENT_ID0);
++batch;
}
if(pending[0])
asc_sync_wait(PIPE_MTE3,PIPE_V,EVENT_ID2);
if(pending[1])
asc_sync_wait(PIPE_MTE3,PIPE_V,EVENT_ID3);
ffts_cross_core_sync(PIPE_MTE3,0x21ULL |(12ULL << 8));
}
}// namespace wide_post

__global__ __mix__(1,2)__attribute__((section(".zzzz_direct_post")))
__attribute__((aligned(4096)))void grouped_matmul_gelu_direct_3(__gm__ int8_t *x,__gm__ int8_t *w,
__gm__ float *scale,__gm__ int64_t *groups,__gm__ half *y,__gm__ int32_t *c,uint32_t E,uint32_t K,uint32_t N,
uint32_t W,uint64_t sync){
set_ffts_base_addr(sync);
asc_init();
uint32_t previous = 0,tiles = 0,largest = 0,active = 0;
for(uint32_t expert = 0;expert < E;++expert){
uint32_t endRow = uint32_t(groups[expert]),rows = endRow - previous;
if ASC_IS_AIV{
other6_group_meta::Ends()[expert] = endRow;
if(rows)
other6_group_meta::Ids()[active++] = expert;
}
tiles +=(rows + 191)/ 192;
largest = rows > largest ? rows : largest;
previous = endRow;
}
if ASC_IS_AIV{
if(E >= 8 && active < E)
other6_group_meta::Warm<1>(w,active,K,N,W);
}
if(largest <= 160){
if ASC_IS_AIC
other6_group_direct::Cube<160,192,320,160,false,true,true>(x,w,groups,c,E,K,N,W,K,tiles);
if ASC_IS_AIV{
auto cursor = other6_group_direct::Schedule<160,192>(groups,E,N,W,tiles);
wide_post::Vector<160,192>(cursor,scale,groups,y,c,N);
}
asc_sync();
return;
}
if ASC_IS_AIC
other6_group_direct::Cube<192,160,320,160,false,true,true>(x,w,groups,c,E,K,N,W,K,tiles);
if ASC_IS_AIV{
auto cursor = other6_group_direct::Schedule<192,160>(groups,E,N,W,tiles);
wide_post::Vector<192,160>(cursor,scale,groups,y,c,N);
}
asc_sync();
}

__global__ __mix__(1,2)
__attribute__((section(".zzzzzzzz_direct_6_read_ahead")))void grouped_matmul_gelu_direct_6_read_ahead(
__gm__ int8_t *x,__gm__ int8_t *w,__gm__ float *scale,__gm__ int64_t *groups,__gm__ half *y,
__gm__ int32_t *c,uint32_t E,uint32_t K,uint32_t N,uint32_t W,uint64_t sync);

namespace wave_overlap{
using dfocus::Min;

using dfocus::Up;

__aicore__ __attribute__((always_inline))inline void Pack(__gm__ int8_t *w,__gm__ int8_t *packed,
__gm__ int64_t *groups,uint32_t k,uint32_t n,uint32_t workers,uint32_t first,uint32_t last){
const uint32_t rank = 2 * asc_get_block_idx()+ asc_get_sub_block_id(),stride = 2 * workers;
const uint32_t kp = Up(k,32),pitch = Up(n,32),shift = n % 32,parts = kp / 32;
constexpr uint32_t BankBytes = 35840;
auto dst =(__ubuf__ int8_t *)(4 * BankBytes);
auto offsets =(__ubuf__ uint32_t *)186368;
set_mov_pad_val(uint32_t(0));
asc_set_mask_norm();
asc_set_vector_mask(~uint64_t(0),~uint64_t(0));
uint32_t batch = 0;
for(uint32_t tile = rank;tile <(last - first)* parts;tile += stride){
const uint32_t expert = first + tile / parts,row =(tile % parts)* 32;
if(expert && groups[expert] == groups[expert - 1])
continue;
if(!expert && !groups[0])
continue;
const bool odd = batch % 2;
auto src =(__ubuf__ int8_t *)static_cast<uint64_t>(odd ? 2 * BankBytes : 0);
auto alternate = src + BankBytes;
if(batch >= 2){
if(odd)
asc_sync_wait(PIPE_V,PIPE_MTE2,EVENT_ID6);
else
asc_sync_wait(PIPE_V,PIPE_MTE2,EVENT_ID5);
}
const uint32_t rows = Min(32U,k - row),bytes = rows * n;
if(rows < 32){
asc_duplicate((__ubuf__ int32_t *)src,int32_t(0),uint32_t(BankBytes / 4));
if(shift)
asc_duplicate((__ubuf__ int32_t *)alternate,int32_t(0),uint32_t(BankBytes / 4));
asc_sync_notify(PIPE_V,PIPE_MTE2,EVENT_ID0);
asc_sync_wait(PIPE_V,PIPE_MTE2,EVENT_ID0);
}
auto raw = w +(uint64_t(expert)* k + row)* n;
asc_copy_gm2ub_align(src,raw,1,bytes,0,Up(bytes,32)- bytes,0,0);
if(shift)
asc_copy_gm2ub_align(alternate,raw,1,bytes,shift,Up(bytes + shift,32)- bytes - shift,0,0);
asc_sync_notify(PIPE_MTE2,PIPE_V,EVENT_ID0);
asc_sync_wait(PIPE_MTE2,PIPE_V,EVENT_ID0);
if(batch)
asc_sync_wait(PIPE_MTE3,PIPE_V,EVENT_ID4);
asc_gather_datablock((__ubuf__ uint32_t *)dst,(__ubuf__ uint32_t *)src,offsets,16,2,pitch / 16);
asc_gather_datablock((__ubuf__ uint32_t *)(dst + 32),(__ubuf__ uint32_t *)(shift ? alternate : src),
offsets + pitch / 2,16,2,pitch / 16);
asc_sync_notify(PIPE_V,PIPE_MTE3,EVENT_ID0);
asc_sync_wait(PIPE_V,PIPE_MTE3,EVENT_ID0);
asc_copy_ub2gm_align(packed +(uint64_t(expert - first)* kp + row)* pitch,dst,pitch * 32);
asc_sync_notify(PIPE_MTE3,PIPE_V,EVENT_ID4);
if(odd)
asc_sync_notify(PIPE_V,PIPE_MTE2,EVENT_ID6);
else
asc_sync_notify(PIPE_V,PIPE_MTE2,EVENT_ID5);
++batch;
}
if(batch){
asc_sync_wait(PIPE_MTE3,PIPE_V,EVENT_ID4);
asc_sync_wait(PIPE_V,PIPE_MTE2,EVENT_ID5);
}
if(batch >= 2)
asc_sync_wait(PIPE_V,PIPE_MTE2,EVENT_ID6);
asc_sync();
}

template <uint32_t Bank = 26112> __aicore__ __attribute__((always_inline))inline void InitWordOffsets(uint32_t n){
const uint32_t blocks = Up(n,32)/ 32;
auto offsets =(__ubuf__ int32_t *)(4 * Bank);
for(uint32_t word = 0;word < 8;++word)
offsets[word] = word * 4;
asc_sync_notify(PIPE_S,PIPE_V,EVENT_ID7);
asc_sync_wait(PIPE_S,PIPE_V,EVENT_ID7);
for(uint32_t used = 1;used < 32;used *= 2){
asc_add_scalar(offsets + used * 8,offsets,int32_t(used * n),used * 8);
asc_sync_pipe(PIPE_V);
}
for(uint32_t used = 1;used < blocks;used *= 2){
const uint32_t count = 256 * Min(used,blocks - used);
asc_add_scalar(offsets + used * 256,offsets,int32_t(used * 32),count);
asc_sync_pipe(PIPE_V);
}
}

template <uint32_t Bank = 26112,bool ShortPad = false>
__aicore__ __attribute__((always_inline))inline void PackWords(__gm__ int8_t *w,__gm__ int8_t *packed,
__gm__ int64_t *groups,uint32_t k,uint32_t n,uint32_t workers,uint32_t first,uint32_t last){
const uint32_t rank = 2 * asc_get_block_idx()+ asc_get_sub_block_id(),threads = 2 * workers;
const uint32_t kp = Up(k,32),pitch = Up(n,32),parts = kp / 32;
auto offsets =(__ubuf__ uint32_t *)(4 * Bank);
set_mov_pad_val(uint32_t(0));
asc_set_mask_norm();
asc_set_vector_mask(~uint64_t(0),~uint64_t(0));
if constexpr(ShortPad)
if(n % 32){
asc_duplicate((__ubuf__ int32_t *)static_cast<uint64_t>(32 * n),int32_t(0),uint32_t(8));
asc_duplicate((__ubuf__ int32_t *)static_cast<uint64_t>(Bank + 32 * n),int32_t(0),uint32_t(8));
asc_sync_pipe(PIPE_V);
}
uint32_t batch = 0;
for(uint32_t tile = rank;tile <(last - first)* parts;tile += threads){
const uint32_t expert = first + tile / parts,row = tile % parts * 32;
if(groups[expert] ==(expert ? groups[expert - 1] : 0))
continue;
const bool odd = batch % 2;
auto src =(__ubuf__ int8_t *)static_cast<uint64_t>(odd ? Bank : 0);
auto dst =(__ubuf__ int8_t *)static_cast<uint64_t>((odd ? 3 : 2)* Bank);
if(batch >= 2){
if(odd)
asc_sync_wait(PIPE_V,PIPE_MTE2,EVENT_ID6);
else
asc_sync_wait(PIPE_V,PIPE_MTE2,EVENT_ID5);
}
const uint32_t rows = Min(32U,k - row),bytes = rows * n,padded = Up(bytes,32);
if(!ShortPad || rows < 32){
asc_duplicate((__ubuf__ int32_t *)(src + padded),int32_t(0),(Bank - padded)/ 4);
asc_sync_pipe(PIPE_V);
}
asc_copy_gm2ub_align(src,w +(uint64_t(expert)* k + row)* n,1,bytes,0,padded - bytes,0,0);
asc_sync_notify(PIPE_MTE2,PIPE_V,EVENT_ID0);
asc_sync_wait(PIPE_MTE2,PIPE_V,EVENT_ID0);
if(batch >= 2){
if(odd)
asc_sync_wait(PIPE_MTE3,PIPE_V,EVENT_ID3);
else
asc_sync_wait(PIPE_MTE3,PIPE_V,EVENT_ID2);
}
asc_gather((__ubuf__ uint32_t *)dst,(__ubuf__ uint32_t *)src,offsets,pitch * 8);
asc_sync_notify(PIPE_V,PIPE_MTE3,EVENT_ID0);
asc_sync_wait(PIPE_V,PIPE_MTE3,EVENT_ID0);
asc_copy_ub2gm_align(packed +(uint64_t(expert - first)* kp + row)* pitch,dst,32 * pitch);
if(odd){
asc_sync_notify(PIPE_V,PIPE_MTE2,EVENT_ID6);
asc_sync_notify(PIPE_MTE3,PIPE_V,EVENT_ID3);
}else{
asc_sync_notify(PIPE_V,PIPE_MTE2,EVENT_ID5);
asc_sync_notify(PIPE_MTE3,PIPE_V,EVENT_ID2);
}
++batch;
}
if(batch){
asc_sync_wait(PIPE_V,PIPE_MTE2,EVENT_ID5);
asc_sync_wait(PIPE_MTE3,PIPE_V,EVENT_ID2);
}
if(batch >= 2){
asc_sync_wait(PIPE_V,PIPE_MTE2,EVENT_ID6);
asc_sync_wait(PIPE_MTE3,PIPE_V,EVENT_ID3);
}
asc_sync();
}

struct Tile{
uint32_t expert,row,col,rows,cols;
};

template <uint32_t M,uint32_t N,bool OwnRows = false> struct Cursor{
uint32_t expert = 0,row = 0,col = 0,left = 0;
__aicore__ __attribute__((always_inline))inline Tile Next(__gm__ int64_t *groups,uint32_t width){
if(!left)
return{};
const uint32_t blocks =(width + 31)/ 32;
while(true){
const uint32_t end = uint32_t(groups[expert]);
if(row < end){
const uint32_t available = Min(blocks - col,left);
const uint32_t panels =(available + N / 32 - 1)/(N / 32);
const uint32_t take =(available + panels - 1)/ panels;
const Tile t{expert,row,col * 32,Min(M,end - row),Min(take * 32,width - col * 32)};
col += take;
if(col == blocks){
col = 0;
row += M;
}
left -= take;
return t;
}
++expert;
row = end;
}
}
};

template <uint32_t M,uint32_t N,bool OwnRows = false>
__aicore__ __attribute__((always_inline))inline Cursor<M,N> Schedule(
__gm__ int64_t *groups,uint32_t firstE,uint32_t E,uint32_t width,uint32_t workers){
const uint32_t blocks =(width + 31)/ 32,worker = asc_get_block_idx();
const uint32_t row0 = firstE ? uint32_t(groups[firstE - 1]): 0;
uint32_t tiles = 0,previous = row0;
for(uint32_t e = firstE;e < E;++e){
const uint32_t end = uint32_t(groups[e]);
tiles +=(end - previous + M - 1)/ M;
previous = end;
}
const uint32_t total = tiles * blocks,base = total / workers,extra = total % workers;
uint32_t first = worker * base + Min(worker,extra);
Cursor<M,N> cursor{};
cursor.left = base +(worker < extra);
previous = row0;
for(uint32_t e = firstE;cursor.left && e < E;++e){
const uint32_t end = uint32_t(groups[e]),entries =((end - previous + M - 1)/ M)* blocks;
if(first < entries){
cursor.expert = e;
cursor.row = previous +(first / blocks)* M;
cursor.col = first % blocks;
break;
}
first -= entries;
previous = end;
}
return cursor;
}

template <uint32_t M,uint32_t N,bool OwnRows = false> struct WaveCursor{
Cursor<M,N,OwnRows> first,second;
__aicore__ inline Tile Next(__gm__ int64_t *groups,uint32_t width){
if(first.left)
return first.Next(groups,width);
return second.Next(groups,width);
}
};

struct Chunk{
Tile tile;
uint32_t k,aBank = 0;
};

template <uint32_t M,uint32_t N,uint32_t BK,bool Long,bool Packed,bool Compact>
__aicore__ __attribute__((always_inline))inline void Fetch(__gm__ int8_t *x,__gm__ int8_t *w,Chunk job,uint32_t K,
uint32_t width,uint32_t slot,uint32_t xStride,uint32_t firstE){
auto a =(__cbuf__ int8_t *)0;
auto b = a +(Long ? 2 * M * BK : 2 * M * Up(K,32))+ slot * N * BK;
const Tile t = job.tile;
const uint32_t k = Min(BK,K - job.k),full = k / 32;
const uint32_t mp = Up(t.rows,32),tail = k % 32,np = Compact ? Up(t.cols,32): N;
if constexpr(Long){
a += slot * M * BK;
if(tail)
cp6_gmg_opt::ZeroL1(a + full * 32 * mp,mp * 32);
asc_copy_gm2l1_nd2nz(a,x + uint64_t(t.row)* xStride + job.k,1,t.rows,k,0,xStride,mp,1,0);
}
const uint32_t wp = Up(width,32),kp = Up(K,32);
asc_copy_gm2l1(b,w +(uint64_t(t.expert - firstE)* kp + job.k)* wp + t.col * 32,Up(k,32)/ 32,np,wp - np,0);
cp6_c38::L1R(slot,false);
}

__aicore__ __attribute__((always_inline))inline void AEvent(uint32_t bank,bool wait,bool input){
if(input){
if(bank){
if(wait)
asc_sync_wait(PIPE_MTE2,PIPE_MTE1,EVENT_ID7);
else
asc_sync_notify(PIPE_MTE2,PIPE_MTE1,EVENT_ID7);
}else{
if(wait)
asc_sync_wait(PIPE_MTE2,PIPE_MTE1,EVENT_ID6);
else
asc_sync_notify(PIPE_MTE2,PIPE_MTE1,EVENT_ID6);
}
}else{
if(bank){
if(wait)
asc_sync_wait(PIPE_MTE1,PIPE_MTE2,EVENT_ID7);
else
asc_sync_notify(PIPE_MTE1,PIPE_MTE2,EVENT_ID7);
}else{
if(wait)
asc_sync_wait(PIPE_MTE1,PIPE_MTE2,EVENT_ID6);
else
asc_sync_notify(PIPE_MTE1,PIPE_MTE2,EVENT_ID6);
}
}
}

template <uint32_t M>
__aicore__ __attribute__((always_inline))inline void PrefetchA(
__gm__ int8_t *x,const Chunk &job,uint32_t k,uint32_t kp){
auto a1 =(__cbuf__ int8_t *)(uint64_t(job.aBank)* M * kp);
const uint32_t mp = Up(job.tile.rows,32);
if(k != kp){
asc_fill_value_config fill{};
fill.repeat = 1;
fill.blk_num = mp;
asc_fill_l1((__cbuf__ uint16_t *)(a1 +(kp - 32)* mp),uint32_t(0),fill);
asc_sync_pipe(PIPE_MTE2);
}
asc_copy_gm2l1_nd2nz(a1,x + uint64_t(job.tile.row)* k,1,job.tile.rows,k,0,k,mp,1,0);
AEvent(job.aBank,false,true);
}

struct AQueue{
uint32_t prefetched = 0,lastRow = uint32_t(-1),aBank = 1;
template <uint32_t M>
__aicore__ __attribute__((always_inline))inline void Enqueue(
__gm__ int8_t *x,Chunk &chunk,uint32_t K,uint32_t kp){
if(chunk.tile.row != lastRow){
aBank ^= 1;
if(prefetched >= 2){
AEvent(aBank,false,false);
AEvent(aBank,true,false);
}
chunk.aBank = aBank;
PrefetchA<M>(x,chunk,K,kp);
lastRow = chunk.tile.row;
++prefetched;
}else
chunk.aBank = aBank;
}
};

template <uint32_t M, uint32_t N, uint32_t BK, uint32_t LK, bool Long, bool Packed = true, bool Compact = false,
uint32_t CSlots = 2>
__aicore__ __attribute__((always_inline)) inline void Cube(__gm__ int8_t *x, __gm__ int8_t *w, __gm__ int64_t *groups,
__gm__ int32_t *scratch, uint32_t E, uint32_t K, uint32_t width, uint32_t workers, uint32_t xStride,
uint32_t split, bool reverse = false) {
static_assert(2 * N * BK + (Long ? 2 * M * BK : 2 * M * 1088) <= 524032);
static_assert(M * N <= 32768 && M * LK <= 32768 && N * LK <= 32768);
WaveCursor<M, N> cursor{
Schedule<M, N>(groups, reverse ? split : 0, reverse ? E : split, width, workers), Schedule<M, N>(groups, reverse ? 0 : split, reverse ? split : E, width, workers)};
bool secondReady = false;
uint32_t ordinal = 0;
const uint32_t worker = asc_get_block_idx(), kp = Up(K, 32);
Chunk next{cursor.Next(groups, width), 0}, queue[2];
AQueue aQueue;
for (uint32_t slot = 0; slot < 2; ++slot) {
if (next.tile.rows)
aQueue.Enqueue<M>(x, next, K, kp);
if (!slot)
asc_sync_block_wait(0);
queue[slot] = next;
if (next.tile.rows) {
if (!secondReady && (reverse ? next.tile.expert < split : next.tile.expert >= split)) {
asc_sync_block_wait(1);
secondReady = true;
}
Fetch<M, N, BK, Long, Packed, Compact>(x, w, next, K, width, slot, xStride, 0);
next.k += BK;
if (next.k >= K)
next = {cursor.Next(groups, width), 0};
}
}
uint32_t phase = 0, currentRow = uint32_t(-1);
for (uint32_t i = 0; queue[i % 2].tile.rows; ++i) {
const uint32_t slot = i % 2, output = ordinal % CSlots;
const Chunk job = queue[slot];
const Tile t = job.tile;
const bool crosses = next.tile.rows && !secondReady && (reverse ? next.tile.expert < split : next.tile.expert >= split);
const uint32_t span = Min(BK, kp - job.k), mp = Up(t.rows, 32);
const uint32_t np = Up(t.cols, 32);
const uint32_t cubeCols = Compact ? np : N;
auto a1 = (__cbuf__ int8_t *)0;
auto b1 = a1 + (Long ? 2 * M * BK : 2 * M * kp) + slot * N * BK;
a1 += job.aBank * M * kp;
if (t.row != currentRow) {
AEvent(job.aBank, true, true);
currentRow = t.row;
}
auto cc = (__cc__ int32_t *)0;
cp6_c38::L1R(slot, true);
const uint32_t step = Min(256U, (1024 / (mp > cubeCols ? mp : cubeCols)) * 32);
for (uint32_t off = 0; off < span; off += step, ++phase) {
const uint32_t k = Min(step, span - off), bank = phase % 2;
auto a = (__ca__ int8_t *)static_cast<uint64_t>(bank * 32768);
auto b = (__cb__ int8_t *)static_cast<uint64_t>(bank * 32768);
if (phase >= 2)
cp6_c38::LF(bank, true);
const uint32_t ka = Long ? off : job.k + off;
for (uint32_t p = 0; p < k / 32; ++p)
asc_copy_l12l0a(a + p * 512, a1 + (ka + p * 32) * mp, 0, mp / 16, 1, k / 32 - 1);
if constexpr (Packed) {
asc_copy_l12l0b_trans(b, b1 + off * cubeCols, 0, k / 32 * (cubeCols / 32), 1, 1, false, uint64_t(0));
} else {
for (uint32_t i = 0; i < k / 32; ++i)
asc_copy_l12l0b_trans(
b + i * cubeCols * 32, b1 + (off + i * 32) * 32, 0, np / 32, span / 32, 1, false, uint64_t(0));
}
cp6_c38::LR(bank, false);
if (off + k == span && next.tile.rows && !crosses) {
cp6_c38::L1F(slot, false);
cp6_c38::L1F(slot, true);
aQueue.Enqueue<M>(x, next, K, kp);
Fetch<M, N, BK, Long, Packed, Compact>(x, w, next, K, width, slot, xStride, 0);
}
cp6_c38::LR(bank, true);
const bool first = job.k + off == 0;
if (first && ordinal)
cp6_large39::CLease(0, true);
if (!first && k == 32)
asc_sync_pipe(PIPE_M);
if constexpr (Compact) {
if (cubeCols < 64)
asc_mmad_sync(cc, a, b, mp, k, cubeCols, 0, false, false, first);
else
asc_mmad(cc, a, b, mp, k, cubeCols, 0, false, false, first);
} else
asc_mmad(cc, a, b, mp, k, cubeCols, 0, false, false, first);
cp6_c38::LF(bank, false);
}
if (job.k + span == kp) {
if (ordinal >= CSlots)
asc_sync_block_wait(13 - 2 * CSlots + 2 * output);
asc_sync_notify(PIPE_M, PIPE_FIX, EVENT_ID5);
asc_sync_wait(PIPE_M, PIPE_FIX, EVENT_ID5);
asc_set_l0c_copy_params(1, 0, 0);
asc_copy_l0c2gm(scratch + (CSlots * worker + output) * M * N, cc, np, t.rows, np, mp, 0, 0, 0, false, true);
ffts_cross_core_sync(PIPE_FIX, 0x21ULL | (uint64_t(12 - 2 * CSlots + 2 * output) << 8));
cp6_large39::CLease(0, false);
++ordinal;
}
if (crosses) {
cp6_c38::L1F(slot, false);
cp6_c38::L1F(slot, true);
aQueue.Enqueue<M>(x, next, K, kp);
asc_sync_block_wait(1);
secondReady = true;
Fetch<M, N, BK, Long, Packed, Compact>(x, w, next, K, width, slot, xStride, 0);
}
queue[slot] = next;
if (next.tile.rows) {
next.k += BK;
if (next.k >= K)
next = {cursor.Next(groups, width), 0};
}
}
for (uint32_t i = phase > 2 ? phase - 2 : 0; i < phase; ++i)
cp6_c38::LF(i % 2, true);
if (ordinal)
cp6_large39::CLease(0, true);
if (!secondReady)
asc_sync_block_wait(1);
for (uint32_t j = ordinal > CSlots ? ordinal - CSlots : 0; j < ordinal; ++j)
asc_sync_block_wait(13 - 2 * CSlots + 2 * (j % CSlots));
asc_sync_block_wait(12);
}

__aicore__ __attribute__((always_inline))inline void GoalMidpoint(__ubuf__ float *z,__ubuf__ float *u,
__ubuf__ float *t,__ubuf__ float *d,__ubuf__ float *p,__ubuf__ half *out,__ubuf__ uint8_t *mask,
uint32_t count){
auto cmp =(__ubuf__ uint8_t *)t,tiny =(__ubuf__ uint8_t *)d;
if constexpr(true){
asc_duplicate((__ubuf__ float *)183616,-.071354814f,uint32_t(64));
asc_duplicate((__ubuf__ float *)183936,-1.5957692f,uint32_t(64));
asc_mul(u,z,z,count);
asc_sync_pipe(PIPE_V);
asc_set_mask_norm();
asc_set_vector_mask(~uint64_t(0),~uint64_t(0));
asc_mul_add(u,(__ubuf__ float *)183616,(__ubuf__ float *)183936,uint8_t(count / 64),1,1,1,8,0,0);
asc_sync_pipe(PIPE_V);
asc_mul(t,u,z,count);
asc_sync_pipe(PIPE_V);
}else{
asc_mul(u,z,z,count);
asc_sync_pipe(PIPE_V);
asc_mul(u,u,z,count);
asc_sync_pipe(PIPE_V);
asc_mul_scalar(u,u,.044715f,count);
asc_sync_pipe(PIPE_V);
asc_add(u,u,z,count);
asc_sync_pipe(PIPE_V);
asc_mul_scalar(u,u,.7978846f,count);
asc_sync_pipe(PIPE_V);
asc_mul_scalar(t,u,-2.0f,count);
asc_sync_pipe(PIPE_V);
}
asc_min_scalar(t,t,8e1f,count);
asc_sync_pipe(PIPE_V);
asc_exp(t,t,count);
asc_sync_pipe(PIPE_V);
asc_add_scalar(d,t,1.0f,count);
asc_sync_pipe(PIPE_V);
asc_div(p,z,d,count);
asc_sync_pipe(PIPE_V);
asc_float2half_rn(out,p,count);
asc_sync_pipe(PIPE_V);
asc_add_scalar((__ubuf__ int32_t *)u,(__ubuf__ int32_t *)p,-4090,count);
asc_sync_pipe(PIPE_V);
asc_shiftleft((__ubuf__ uint32_t *)u,(__ubuf__ uint32_t *)u,19,count);
asc_sync_pipe(PIPE_V);
asc_shiftright((__ubuf__ uint32_t *)u,(__ubuf__ uint32_t *)u,19,count);
asc_shiftright((__ubuf__ uint32_t *)d,(__ubuf__ uint32_t *)z,24,count);
asc_sync_pipe(PIPE_V);
asc_int322float_rn(u,(__ubuf__ int32_t *)u,count);
asc_sync_pipe(PIPE_V);
asc_set_mask_norm();
asc_set_vector_mask(~uint64_t(0),~uint64_t(0));
const uint8_t repeats = uint8_t(count / 64);
asc_lt_scalar(mask,u,13.0f,repeats,1,1,8,8);
asc_eq_scalar(cmp,(__ubuf__ int32_t *)d,64,repeats,1,1,8,8);
asc_sync_pipe(PIPE_V);
asc_and((__ubuf__ uint16_t *)mask,(__ubuf__ uint16_t *)mask,(__ubuf__ uint16_t *)cmp,count / 16);
asc_half2float(t,out,count);
asc_sync_pipe(PIPE_V);
asc_sub(t,p,t,count);
asc_abs(u,p,count);
asc_sync_pipe(PIPE_V);
asc_abs(t,t,count);
asc_sync_pipe(PIPE_V);
asc_gt_scalar(tiny,t,2.9672323e-8f,repeats,1,1,8,8);
asc_lt_scalar(cmp,u,6.2e-5f,repeats,1,1,8,8);
asc_sync_pipe(PIPE_V);
asc_and((__ubuf__ uint16_t *)tiny,(__ubuf__ uint16_t *)tiny,(__ubuf__ uint16_t *)cmp,count / 16);
asc_sync_pipe(PIPE_V);
asc_or((__ubuf__ uint16_t *)mask,(__ubuf__ uint16_t *)mask,(__ubuf__ uint16_t *)tiny,count / 16);
asc_sync_pipe(PIPE_V);
asc_eq_scalar(cmp,(__ubuf__ int32_t *)mask,0,uint8_t(count / 2048),1,1,8,8);
asc_sync_notify(PIPE_V,PIPE_S,EVENT_ID1);
asc_sync_wait(PIPE_V,PIPE_S,EVENT_ID1);
auto result =(__ubuf__ uint16_t *)out;
for(uint32_t block = 0;block < count / 2048;++block){
uint64_t words = ~((__ubuf__ uint64_t *)cmp)[block];
while(words){
const uint32_t word = block * 64 + __builtin_ctzll(words);
words &= words - 1;
uint32_t bits =((__ubuf__ uint32_t *)mask)[word];
while(bits){
const uint32_t i = word * 32 + __builtin_ctz(bits);
bits &= bits - 1;
const float zi = z[i];
if(zi >= 5.0f){
union{
float f;
uint32_t u;
}v;
v.f = zi;
if((v.u & 8191U)== 4096U && zi < 7.089343f && float(out[i])> zi)
--result[i];
}else{
const uint32_t fast = cp6_gmg_opt::TryGeluQ30(zi);
result[i] = fast < 65536U ? uint16_t(fast): cp6_gmg_opt::PreciseGeluHalfC(zi);
}
}
}
}
}

template <uint32_t M, uint32_t N, bool OwnRows = false, uint32_t CSlots = 2, bool Exact = false, bool PolyFma = false>
__aicore__ __attribute__((always_inline)) inline void Vector(__gm__ float *scale, __gm__ int64_t *groups,
__gm__ half *y, __gm__ int32_t *scratch, uint32_t E, uint32_t width, uint32_t workers, uint32_t splitE, bool reverse = false) {
WaveCursor<M, N, OwnRows> cursor{Schedule<M, N, OwnRows>(groups, reverse ? splitE : 0, reverse ? E : splitE, width, workers),
Schedule<M, N, OwnRows>(groups, reverse ? 0 : splitE, reverse ? splitE : E, width, workers)};
uint32_t ordinal = 0;
const uint32_t worker = asc_get_block_idx(), sub = asc_get_sub_block_id();
auto z = (__ubuf__ float *)0;
auto u = (__ubuf__ float *)(Exact ? 32768 : 61440);
auto sc = (__ubuf__ float *)(Exact ? 180224 : 122880);
uint32_t batch = 0;
set_mov_pad_val(uint32_t(0));
auto cf = (__ubuf__ float *)188416;
if constexpr (PolyFma) {
asc_duplicate(cf, -0.07135481627260025f, uint32_t(64));
asc_duplicate(cf + 64, -1.5957691216057308f, uint32_t(64));
asc_sync_pipe(PIPE_V);
}
for (Tile t = cursor.Next(groups, width); t.rows; t = cursor.Next(groups, width), ++ordinal) {
const uint32_t slot = ordinal % CSlots, np = Up(t.cols, 32), halfRows = (t.rows + 1) / 2;
const uint32_t start = sub * halfRows, length = Min(halfRows, t.rows - start);
if (length)
asc_copy_gm2ub_align(
sc, scale + uint64_t(t.expert) * width + t.col, 1, t.cols * 4, 0, Up(t.cols, 8) - t.cols, 0, 0);
asc_sync_block_wait(12 - 2 * CSlots + 2 * slot);
constexpr uint32_t Rows = (Exact ? 8192 : 15360) / N;
for (uint32_t row = 0; row < length; row += Rows) {
const uint32_t rows = Min(Rows, length - row), elems = rows * np, count = Up(elems, 64);
const uint32_t event = Exact ? 0 : batch % 2;
auto out = (__ubuf__ half *)static_cast<uint64_t>(Exact ? 163840 : 124928 + event * 30720);
auto src = scratch + (CSlots * worker + slot) * M * N + (start + row) * np;
asc_copy_gm2ub_align((__ubuf__ int32_t *)z, src, 1, elems * 4, 0, 0, 0, 0);
if (row + rows == length)
ffts_cross_core_sync(PIPE_MTE2, 0x21ULL | (uint64_t(13 - 2 * CSlots + 2 * slot) << 8));
asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
asc_int322float_rn(z, (__ubuf__ int32_t *)z, count);
asc_sync_pipe(PIPE_V);
asc_set_mask_norm();
asc_set_vector_mask(uint64_t(0), ~uint64_t(0));
const uint32_t full = np / 64 * 64;
for (uint32_t col = 0; col < full; col += 64)
asc_mul(z + col, z + col, sc + col, uint8_t(rows), 1, 1, 1, np / 8, np / 8, 0);
if (full != np) {
asc_set_vector_mask(uint64_t(0), uint64_t(0xffffffff));
asc_mul(z + full, z + full, sc + full, uint8_t(rows), 1, 1, 1, np / 8, np / 8, 0);
}
asc_sync_pipe(PIPE_V);
asc_set_vector_mask(~uint64_t(0), ~uint64_t(0));
if constexpr (Exact) {
if (batch)
asc_sync_wait(PIPE_MTE3, PIPE_V, EVENT_ID2);
const uint32_t guarded = Up(elems, 2048);
if (guarded != elems) {
asc_duplicate(z + elems, 0.0f, guarded - elems);
asc_sync_pipe(PIPE_V);
}
GoalMidpoint(z, u, (__ubuf__ float *)65536, (__ubuf__ float *)98304, (__ubuf__ float *)131072, out,
(__ubuf__ uint8_t *)181248, guarded);
} else {
if constexpr (PolyFma) {
const uint8_t repeat = uint8_t(count / 64);
asc_mul(u, z, z, repeat, 1, 1, 1, 8, 8, 8);
asc_sync_pipe(PIPE_V);
asc_mul_add(u, cf, cf + 64, repeat, 1, 1, 1, 8, 0, 0);
asc_sync_pipe(PIPE_V);
asc_mul(u, u, z, repeat, 1, 1, 1, 8, 8, 8);
asc_sync_pipe(PIPE_V);
} else {
asc_mul(u, z, z, count);
asc_sync_pipe(PIPE_V);
asc_mul(u, u, z, count);
asc_sync_pipe(PIPE_V);
asc_mul_scalar(u, u, 0.044715f, count);
asc_sync_pipe(PIPE_V);
asc_add(u, u, z, count);
asc_sync_pipe(PIPE_V);
asc_mul_scalar(u, u, -1.5957691216057308f, count);
asc_sync_pipe(PIPE_V);
}
asc_min_scalar(u, u, 80.0f, count);
asc_sync_pipe(PIPE_V);
asc_exp(u, u, count);
asc_sync_pipe(PIPE_V);
asc_add_scalar(u, u, 1.0f, count);
asc_sync_pipe(PIPE_V);
asc_div(z, z, u, count);
asc_sync_pipe(PIPE_V);
if (batch >= 2) {
if (event)
asc_sync_wait(PIPE_MTE3, PIPE_V, EVENT_ID3);
else
asc_sync_wait(PIPE_MTE3, PIPE_V, EVENT_ID2);
}
asc_float2half_rn(out, z, count);
}
asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
asc_copy_ub2gm_align(y + uint64_t(t.row + start + row) * width + t.col, out, rows, t.cols * 2, 0, 0,
(np - Up(t.cols, 16)) / 16, (width - t.cols) * 2);
if (event)
asc_sync_notify(PIPE_MTE3, PIPE_V, EVENT_ID3);
else
asc_sync_notify(PIPE_MTE3, PIPE_V, EVENT_ID2);
asc_sync_notify(PIPE_V, PIPE_MTE2, EVENT_ID0);
asc_sync_wait(PIPE_V, PIPE_MTE2, EVENT_ID0);
++batch;
}
if (!length)
ffts_cross_core_sync(PIPE_MTE2, 0x21ULL | (uint64_t(13 - 2 * CSlots + 2 * slot) << 8));
}
if (batch >= 1)
asc_sync_wait(PIPE_MTE3, PIPE_V, EVENT_ID2);
if (!Exact && batch >= 2)
asc_sync_wait(PIPE_MTE3, PIPE_V, EVENT_ID3);
}

template <uint32_t Waves>
__aicore__ __attribute__((always_inline))inline void Produce(__gm__ int8_t *w,__gm__ int8_t *packed,
__gm__ int64_t *groups,uint32_t E,uint32_t K,uint32_t N,uint32_t W,uint32_t wave,uint64_t stride){
PackWords<26112,true>(
w,packed + uint64_t(E * wave / Waves)* stride,groups,K,N,W,E * wave / Waves,E *(wave + 1)/ Waves);
const uint32_t barrier = 14 + wave % 2;
ffts_cross_core_sync(PIPE_MTE3,0x1ULL |(uint64_t(barrier)<< 8));
asc_sync_block_wait(barrier);
ffts_cross_core_sync(PIPE_MTE3,0x21ULL |(uint64_t(wave)<< 8));
}
}// namespace wave_overlap

__global__ __mix__(1,2)__attribute__((section(".zzzz_wave_overlap")))void grouped_matmul_gelu_wave_overlap(
__gm__ int8_t *x,__gm__ int8_t *w,__gm__ float *scale,__gm__ int64_t *groups,__gm__ half *y,__gm__ int32_t *c,
uint32_t E,uint32_t K,uint32_t N,uint32_t W,uint64_t sync){
set_ffts_base_addr(sync);
asc_init();
uint32_t previous = 0,active = 0,largest = 0;
for(uint32_t e = 0;e < E;++e){
const uint32_t end = uint32_t(groups[e]),rows = end - previous;
active += rows != 0;
largest = rows > largest ? rows : largest;
previous = end;
}
if(active < E / 2 || largest > 192){
if ASC_IS_AIC
e32_stream::Cube<96,288,480,96,false,false,true>(x,w,groups,c,E,K,N,W,K);
if ASC_IS_AIV
e32_stream::Vector<96,288>(scale,groups,y,c,E,N,W);
asc_sync();
return;
}
constexpr uint32_t Waves = 2;
const uint32_t np = wave_overlap::Up(N,32),kp = wave_overlap::Up(K,32);
const uint64_t stride = uint64_t(kp)* np;
auto packed =(__gm__ int8_t *)(c + uint64_t(W)* 2 * 96 * 320);
if ASC_IS_AIC{
wave_overlap::Cube<96,320,480,96,false,true,true>(x,packed,groups,c,E,K,N,W,K,E / Waves);
}
if ASC_IS_AIV{
wave_overlap::InitWordOffsets(N);
wave_overlap::Produce<Waves>(w,packed,groups,E,K,N,W,0,stride);
wave_overlap::Produce<Waves>(w,packed,groups,E,K,N,W,1,stride);
wave_overlap::Vector<96,320>(scale,groups,y,c,E,N,W,E / Waves);
ffts_cross_core_sync(PIPE_MTE3,0x21ULL |(12ULL << 8));
}
asc_sync();
}

__global__ __mix__(1,2)__attribute__((section(".zzzzz_hers_pack")))void grouped_matmul_gelu_hers_full_packed(
__gm__ int8_t *x,__gm__ int8_t *w,__gm__ float *scale,__gm__ int64_t *groups,__gm__ half *y,
__gm__ int32_t *scratch,uint32_t E,uint32_t K,uint32_t N,uint32_t workers,uint64_t sync_base,uint32_t l1){
HersBody<true>(x,w,scale,groups,y,scratch,E,K,N,workers,sync_base,l1);
}

__global__ __mix__(1,2)__attribute__((section(".zzzzz_hers_odd")))void grouped_matmul_gelu_hers_odd(__gm__ int8_t *x,
__gm__ int8_t *w,__gm__ float *scale,__gm__ int64_t *groups,__gm__ half *y,__gm__ int32_t *scratch,uint32_t E,
uint32_t K,uint32_t N,uint32_t workers,uint64_t sync_base,uint32_t l1){
HersBody<true,true>(x,w,scale,groups,y,scratch,E,K,N,workers,sync_base,l1);
}

namespace other_ha_cube{
struct HaCursor{
d6_ha_owned::PanelCursor cursor;
uint32_t remaining,ordinal = 0;
__aicore__ __attribute__((always_inline))inline bool Next(
other_post::Frame &frame,__gm__ int64_t *groups,uint32_t n,uint32_t sub){
if(!remaining)
return false;
uint32_t end = uint32_t(groups[cursor.expert]);
while(cursor.tile >= cursor.prefix +(end - cursor.start + 95)/ 96){
cursor.prefix +=(end - cursor.start + 95)/ 96;
cursor.start = end;
end = uint32_t(groups[++cursor.expert]);
}
const uint32_t row = cursor.start +(cursor.tile - cursor.prefix)* 96;
const uint32_t rows = Min(96U,end - row),split =(rows + 1)/ 2,local = sub * split;
const uint32_t cols = PackedColumns(n,cursor.col);
frame ={cursor.expert,row + local,cursor.col,sub ? rows - split : split,cols,Up(cols,32),ordinal++,
local,true,true};
cursor.col += cols;
if(cursor.col == n){
cursor.col = 0;
++cursor.tile;
}
--remaining;
return true;
}
};
}// namespace other_ha_cube

namespace own_ha_earlyfree{
using dfocus::Up;

using other_post::Frame;

template <uint32_t Slots,uint32_t Words,typename Cursor>
__aicore__ __attribute__((always_inline))inline void Vector(
Cursor cursor,__gm__ float *scale,__gm__ int64_t *groups,__gm__ half *y,__gm__ int32_t *scratch,uint32_t n){
const uint32_t worker = asc_get_block_idx(),sub = asc_get_sub_block_id();
bool pending[2] ={};
uint32_t batch = 0;
set_mov_pad_val(uint32_t(0));
asc_set_mask_norm();
asc_set_vector_mask(~uint64_t(0),~uint64_t(0));
for(Frame f{};cursor.Next(f,groups,n,sub);){
const uint32_t slot = f.tile % Slots,ready =(Slots == 4 ? 0 : 8)+ 2 * slot;
const bool odd =(batch & 1)!= 0;
auto z =(__ubuf__ float *)static_cast<uint64_t>(odd ? 38912 : 0);
auto u =(__ubuf__ float *)77824;
auto sc =(__ubuf__ float *)static_cast<uint64_t>(odd ? 117760 : 116736);
auto out =(__ubuf__ half *)static_cast<uint64_t>(odd ? 139264 : 119808);
if(f.rows){
if(batch >= 2){
if(odd)
asc_sync_wait(PIPE_V,PIPE_MTE2,EVENT_ID3);
else
asc_sync_wait(PIPE_V,PIPE_MTE2,EVENT_ID2);
}
asc_copy_gm2ub_align(sc,scale + uint64_t(f.expert)* n + f.col,1,f.nr * 4,0,Up(f.nr,8)- f.nr,0,0);
}
if(f.first)
asc_sync_block_wait(ready);
if(f.rows){
const uint32_t size = f.rows * f.bn,count = Up(size,64);
const uint8_t reps = uint8_t(count / 64);
const auto src = scratch +(uint64_t(worker)* Slots + slot)* Words + f.offset * f.bn;
asc_copy_gm2ub_align((__ubuf__ int32_t *)z,src,1,size * 4,0,0,0,0);
if(f.last)
ffts_cross_core_sync(PIPE_MTE2,0x21ULL |(uint64_t(ready + 1)<< 8));
asc_sync_notify(PIPE_MTE2,PIPE_V,EVENT_ID0);
asc_sync_wait(PIPE_MTE2,PIPE_V,EVENT_ID0);
asc_int322float_rn(z,(__ubuf__ int32_t *)z,reps,1,1,8,8);
asc_sync_pipe(PIPE_V);
asc_set_mask_norm();
for(uint32_t col = 0;col < f.bn;col += 64){
asc_set_vector_mask(uint64_t(0),f.bn - col >= 64 ? ~uint64_t(0): uint64_t(0xffffffff));
asc_mul(z + col,z + col,sc + col,uint8_t(f.rows),1,1,1,f.bn / 8,f.bn / 8,0);
}
asc_sync_pipe(PIPE_V);
asc_set_vector_mask(~uint64_t(0),~uint64_t(0));
asc_mul(u,z,z,reps,1,1,1,8,8,8);
asc_sync_pipe(PIPE_V);
asc_mul(u,u,z,reps,1,1,1,8,8,8);
asc_sync_pipe(PIPE_V);
asc_mul_scalar(u,u,0.044715f,reps,1,1,8,8);
asc_sync_pipe(PIPE_V);
asc_add(u,u,z,reps,1,1,1,8,8,8);
asc_sync_pipe(PIPE_V);
asc_mul_scalar(u,u,0.7978845608028654f,reps,1,1,8,8);
asc_sync_pipe(PIPE_V);
asc_mul_scalar(u,u,-2.0f,reps,1,1,8,8);
asc_sync_pipe(PIPE_V);
asc_min_scalar(u,u,80.0f,reps,1,1,8,8);
asc_sync_pipe(PIPE_V);
asc_exp(u,u,reps,1,1,8,8);
asc_sync_pipe(PIPE_V);
asc_add_scalar(u,u,1.0f,reps,1,1,8,8);
asc_sync_pipe(PIPE_V);
asc_div(z,z,u,reps,1,1,1,8,8,8);
asc_sync_pipe(PIPE_V);
if(pending[odd]){
if(odd)
asc_sync_wait(PIPE_MTE3,PIPE_V,EVENT_ID3);
else
asc_sync_wait(PIPE_MTE3,PIPE_V,EVENT_ID2);
}
asc_float2half_rn(out,z,reps,1,1,4,8);
asc_sync_notify(PIPE_V,PIPE_MTE3,EVENT_ID0);
asc_sync_wait(PIPE_V,PIPE_MTE3,EVENT_ID0);
asc_copy_ub2gm_align(y + uint64_t(f.row)* n + f.col,out,f.rows,f.nr * 2,0,0,
(f.bn - Up(f.nr,16))/ 16,(n - f.nr)* 2);
if(odd){
asc_sync_notify(PIPE_MTE3,PIPE_V,EVENT_ID3);
asc_sync_notify(PIPE_V,PIPE_MTE2,EVENT_ID3);
}else{
asc_sync_notify(PIPE_MTE3,PIPE_V,EVENT_ID2);
asc_sync_notify(PIPE_V,PIPE_MTE2,EVENT_ID2);
}
pending[odd] = true;
++batch;
}
if(f.last && !f.rows)
ffts_cross_core_sync(PIPE_MTE2,0x21ULL |(uint64_t(ready + 1)<< 8));
}
if(pending[0]){
asc_sync_wait(PIPE_MTE3,PIPE_V,EVENT_ID2);
asc_sync_wait(PIPE_V,PIPE_MTE2,EVENT_ID2);
}
if(pending[1]){
asc_sync_wait(PIPE_MTE3,PIPE_V,EVENT_ID3);
asc_sync_wait(PIPE_V,PIPE_MTE2,EVENT_ID3);
}
ffts_cross_core_sync(PIPE_MTE3,0x21ULL |(12ULL << 8));
}
}
__global__ __mix__(1,2)__attribute__((section(".zzzzzz_ha_pack")))
__attribute__((aligned(4096)))void grouped_matmul_gelu_ha_gmpack(__gm__ int8_t *x,__gm__ int8_t *w,
__gm__ float *scale,__gm__ int64_t *groups,__gm__ half *y,__gm__ int32_t *scratch,uint32_t E,uint32_t K,
uint32_t N,uint32_t workers,uint64_t sync_base){
set_ffts_base_addr(sync_base);
asc_init();
auto packed =(__gm__ int8_t *)(scratch + uint64_t(workers)* 65536);
if ASC_IS_AIC{
other_ha_cube::Cube<4,true,true>(x,packed,groups,scratch,E,K,N,workers);
}
if ASC_IS_AIV{
hers_parity::Init(N);
hers_parity::Pack(w,packed,groups,K,N,workers,0,E);
ffts_cross_core_sync(PIPE_MTE3,0x1ULL |(14ULL << 8));
asc_sync_block_wait(14);
ffts_cross_core_sync(PIPE_MTE3,0x21ULL);
const uint32_t tiles = d6_ha_owned::RowTiles(groups,E),worker = asc_get_block_idx();
const uint32_t base = tiles / workers,extra = tiles % workers;
const uint32_t first = worker * base + other_ha_cube::Min(worker,extra);
other_ha_cube::HaCursor cursor{{0,0,0,first,0},(base +(worker < extra))* 3};
own_ha_earlyfree::Vector<4,16384>(cursor,scale,groups,y,scratch,N);
}
asc_sync();
}

__global__ __mix__(1,2)__attribute__((section(".zzzzzz_join_d")))void grouped_matmul_gelu_join_d_two(
__gm__ int8_t *x,__gm__ int8_t *w,__gm__ float *scale,__gm__ int64_t *groups,__gm__ half *y,__gm__ int32_t *c,
uint32_t E,uint32_t K,uint32_t N,uint32_t W,uint64_t sync,bool exact){
set_ffts_base_addr(sync);
asc_init();
auto packed =(__gm__ int8_t *)(c + uint64_t(W)* 61440);
const uint32_t split =(3 * E + 4)/ 8;
if ASC_IS_AIC
wave_overlap::Cube<192,160,320,160,false,true,true,2>(x,packed,groups,c,E,K,N,W,K,split);
if ASC_IS_AIV{
wave_overlap::InitWordOffsets<35840>(N);
const uint64_t stride = uint64_t(dfocus::Up(K,32))* dfocus::Up(N,32);
for(uint32_t wave = 0;wave < 2;++wave){
const uint32_t first = wave ? split : 0,last = wave ? E : split,barrier = 14 + wave;
wave_overlap::PackWords<35840,true>(w,packed + uint64_t(first)* stride,groups,K,N,W,first,last);
ffts_cross_core_sync(PIPE_MTE3,0x1ULL |(uint64_t(barrier)<< 8));
asc_sync_block_wait(barrier);
ffts_cross_core_sync(PIPE_MTE3,0x21ULL |(uint64_t(wave)<< 8));
}
if(exact)
wave_overlap::Vector<192,160,false,2,true>(scale,groups,y,c,E,N,W,split);
else
wave_overlap::Vector<192,160,false,2>(scale,groups,y,c,E,N,W,split);
ffts_cross_core_sync(PIPE_MTE3,0x21ULL |(12ULL << 8));
}
asc_sync();
}

static __aicore__ __attribute__((noinline, aligned(4096), section(".zzz_hers_skew"))) void HersSkewWaves(
__gm__ int8_t *x, __gm__ int8_t *w, __gm__ float *scale, __gm__ int64_t *groups, __gm__ half *y, __gm__ int32_t *c,
uint32_t E, uint32_t K, uint32_t N, uint32_t W) {
auto packed = (__gm__ int8_t *)(c + uint64_t(W) * 61440);
uint32_t split = E / 2;
bool reverse = false;
if (E > 1 && E <= 32) {
uint32_t previous = 0, active = 0;
for (uint32_t expert = 0; expert < E; ++expert) {
const uint32_t finish = uint32_t(groups[expert]);
active += finish != previous;
previous = finish;
}
const uint32_t total = previous, half = (total + 1) / 2;
uint32_t lowerActive = 0, bestActive = active + 1, bestRows = 0, bestExperts = E + 1;
previous = 0;
for (uint32_t cut = 1; cut < E; ++cut) {
const uint32_t lower = uint32_t(groups[cut - 1]), upper = total - lower;
lowerActive += lower != previous;
previous = lower;
const uint32_t upperActive = active - lowerActive;
if (lower >= half &&
(lowerActive < bestActive || (lowerActive == bestActive &&
(lower > bestRows || (lower == bestRows && cut < bestExperts))))) {
split = cut; reverse = false;
bestActive = lowerActive; bestRows = lower; bestExperts = cut;
}
if (upper >= half &&
(upperActive < bestActive || (upperActive == bestActive &&
(upper > bestRows || (upper == bestRows && E - cut < bestExperts))))) {
split = cut; reverse = true;
bestActive = upperActive; bestRows = upper; bestExperts = E - cut;
}
}
}
if ASC_IS_AIC
wave_overlap::Cube<192, 160, 320, 160, false, true, true, 2>(x, packed, groups, c, E, K, N, W, K, split, reverse);
if ASC_IS_AIV {
hers_parity::Init(N);
const uint64_t stride = uint64_t(dfocus::Up(K, 32)) * dfocus::Up(N, 32);
for (uint32_t wave = 0; wave < 2; ++wave) {
const bool upper = (wave != 0) != reverse;
const uint32_t first = upper ? split : 0, last = upper ? E : split, barrier = 14 + wave;
hers_parity::Pack(w, packed + uint64_t(first) * stride, groups, K, N, W, first, last);
ffts_cross_core_sync(PIPE_MTE3, 0x1ULL | (uint64_t(barrier) << 8));
asc_sync_block_wait(barrier);
ffts_cross_core_sync(PIPE_MTE3, 0x21ULL | (uint64_t(wave) << 8));
}
wave_overlap::Vector<192, 160, false, 2, false, true>(scale, groups, y, c, E, N, W, split, reverse);
ffts_cross_core_sync(PIPE_MTE3, 0x21ULL | (12ULL << 8));
}
asc_sync();
}

namespace resident_tail_tiles{
using namespace cp6_resident;

template <uint32_t Slots>
__aicore__ inline void MergeLoadTail80(__gm__ int8_t *w,__cbuf__ int8_t *base,__cbuf__ int8_t *input,
__ca__ int8_t *a,__cb__ int8_t *b,uint32_t expert,uint32_t micro,uint32_t rank){
const uint32_t panel = micro / 2,bank = panel % Slots,slot = micro % 2;
const uint32_t k =((micro % 8)^(rank * 4))* 128;
if(!slot)
ResidentReady(bank,true);
// L0A holds six 80x128 slabs. Keep four across column tiles
// and use the first two slabs to stream the remaining K slices.
const uint32_t activationSlice = micro % 8;
if(activationSlice >= 4 || micro < 8){
const uint32_t activationSlot = activationSlice < 4 ? 2 + activationSlice : slot;
for(uint32_t chunk = 0;chunk < 4;++chunk)
asc_copy_l12l0a(a + activationSlot * 10240 + chunk * 512,input +(k + chunk * 32)* 80,0,5,1,3);
}
asc_copy_l12l0b_trans(b + slot * 32768,base + bank * 65536 + slot * 32768,0,32,1,1,false,uint64_t(0));
LR(slot,false);
if(slot && panel + Slots < 16){
ResidentFree(bank);
Prefetch<Slots>(w,base,expert,panel + Slots,rank);
}
}

template <uint32_t Rows,uint32_t Slots,bool GeneralRows = false,bool CompactFrame =(Rows == 65 && !GeneralRows)>
static __aicore__ __attribute__((noinline,section(".resident_tail_tiles")))void MergeTailCube(
__gm__ int8_t *x,__gm__ int8_t *w,__gm__ int32_t *scratch,uint32_t row,uint32_t actualRows = Rows){
constexpr bool SingleFrame = CompactFrame;
const uint32_t outputRows = GeneralRows ? actualRows : Rows;
constexpr uint32_t MP = Rows == 63 ? 64 : 80;
const uint32_t worker = asc_get_block_idx(),expert = worker / 2,rank = worker % 2;
auto base =(__cbuf__ int8_t *)0;
auto input = base + Slots * 65536;
auto a =(__ca__ int8_t *)0;
auto b =(__cb__ int8_t *)0;
auto c =(__cc__ int32_t *)0;
asc_copy_gm2l1_nd2nz(input,x + uint64_t(row)* 1024,1,outputRows,1024,0,1024,MP,1,0);
asc_sync_notify(PIPE_MTE2,PIPE_MTE1,EVENT_ID3);
for(uint32_t panel = 0;panel < Slots;++panel)
Prefetch<Slots>(w,base,expert,panel,rank);
asc_sync_wait(PIPE_MTE2,PIPE_MTE1,EVENT_ID3);
if(MP == 64){
for(uint32_t j = 0;j < 8;++j)
for(uint32_t k = 0;k < 4;++k)
asc_copy_l12l0a(a + j * 8192 + k * 512,input + j * 8192 + k * 2048,0,4,1,3);
Load<Slots>(w,base,b,expert,0,rank);
}else{
MergeLoadTail80<Slots>(w,base,input,a,b,expert,0,rank);
}
uint32_t ordinal = 0;
for(uint32_t j = 0;j < 32;++j){
const uint32_t k = j % 8,tile = j / 8,slot = j % 2;
const uint32_t bank = MP == 64 ? tile % 2 : 0;
auto cc = c + bank * 16384;
LR(slot,true);
if(!k && tile >=(MP == 64 ? 2U : 1U))
cp6_large39::CLease(bank,true);
const uint32_t activationSlot = k < 4 ? 2 + k : slot;
auto aa = MP == 64 ? a +(k ^(rank * 4))* 8192 : a + activationSlot * 10240;
asc_mmad(cc,aa,b + slot * 32768,MP,128,256,0,false,false,!k);
if(j + 2 < 32)
LF(slot,false);
if(j + 1 < 32){
if(j)
LF(1 - slot,true);
if(MP == 64)
Load<Slots>(w,base,b,expert,j + 1,rank);
else
MergeLoadTail80<Slots>(w,base,input,a,b,expert,j + 1,rank);
}
if(k == 7){
asc_sync_notify(PIPE_M,PIPE_FIX,EVENT_ID5);
asc_sync_wait(PIPE_M,PIPE_FIX,EVENT_ID5);
if constexpr(SingleFrame){
if(ordinal)
asc_sync_block_wait(9);
asc_set_l0c_copy_params(1,0,0);
asc_copy_l0c2gm(scratch + uint64_t(worker)* 32768,cc,256,outputRows,256,MP,0,0,0,false,true);
ffts_cross_core_sync(PIPE_FIX,0x21ULL |(uint64_t(8)<< 8));
++ordinal;
}else{
cp6_c38::StoreC<256>(cc,scratch,worker,outputRows,MP,256,ordinal,true);
}
cp6_large39::CLease(bank,false);
}
}
cp6_large39::CLease(0,true);
if(MP == 64)
cp6_large39::CLease(1,true);
if constexpr(SingleFrame){
asc_sync_block_wait(9);
asc_sync_block_wait(12);
}else
cp6_c38::Drain(ordinal);
}

static __aicore__ __attribute__((noinline,section(".resident_tail_tiles")))void MergeTailFrame(
__gm__ float *scale,__gm__ half *y,__gm__ int32_t *scratch,uint32_t row,uint32_t actualRows = 65){
cp6_resident::FastResidentTail<true>(scale,y,scratch,row,actualRows);
}
}// namespace resident_tail_tiles

__global__ __mix__(1,2)__attribute__((section(".resident_tail_tiles")))void grouped_matmul_gelu_resident_k1024(
__gm__ int8_t *x,__gm__ int8_t *w,__gm__ float *scale,__gm__ int64_t *groups,__gm__ half *y,
__gm__ int32_t *scratch,uint64_t sync_base,uint32_t experts){
set_ffts_base_addr(sync_base);
asc_init();
const uint32_t worker = asc_get_block_idx(),expert = worker / 2,rank = worker % 2;
const uint32_t end = uint32_t(groups[expert]);
const uint32_t begin = expert ? uint32_t(groups[expert - 1]): 0,rows = end - begin;
const uint32_t split =(rows + 1)/ 2,row = begin + rank * split,length = rank ? rows - split : split;
if(!length)
return;
if ASC_IS_AIC{
if(length == 64)
cp6_resident::Cube<5,true,true>(x,w,scratch,experts,row);
else if(length == 63)
resident_tail_tiles::MergeTailCube<63,5>(x,w,scratch,row);
else if(length == 65)
resident_tail_tiles::MergeTailCube<65,5>(x,w,scratch,row);
// These row counts fit in a single 64- or 80-row Cube tile.
// StoreC uses the generic vector consumer's original slab protocol.
else if(length > 48 && length < 64)
resident_tail_tiles::MergeTailCube<63,5,true,true>(x,w,scratch,row,length);
else if(length > 65 && length <= 2 * 33)
resident_tail_tiles::MergeTailCube<65,5,true,true>(x,w,scratch,row,length);
else if(length > 2 * 33 && length <= 80)
resident_tail_tiles::MergeTailCube<65,5,true>(x,w,scratch,row,length);
else
cp6_local_groups::RaggedCube<1,1024>(x,w,scratch,expert,row,length,1024);
}
if ASC_IS_AIV{
if(length == 64)
cp6_resident::Vector64(scale,y,scratch,row);
else if(length == 63)
cp6_resident::TailVector63(scale,y,scratch,row);
else if(length == 65)
resident_tail_tiles::MergeTailFrame(scale,y,scratch,row);
else if(length > 48 && length <= 2 * 33)
resident_tail_tiles::MergeTailFrame(scale,y,scratch,row,length);
else
cp6_local_groups::Vector<1,64,256>(scale,y,scratch,expert,row,length,1024);
}
asc_sync();
}

static __aicore__ __attribute__((always_inline))inline uint16_t RelaxedScalar(float z){
#pragma clang fp contract(fast)
const float a = z < 0 ? -z : z;
const float t = a * a;
float p = -4.8781237182993209e-07f;
p = p * t + 2.6831879949895665e-05f;
p = p * t + -0.00061634130543097854f;
p = p * t + 0.0078285634517669678f;
p = p * t + -0.062429491430521011f;
p = p * t + 0.39612686634063721f;
float g = a * p;
g = g > .5f ? .5f : g;
return __builtin_bit_cast(uint16_t,half(z * .5f + a * g));
}
__cube__ __global__ __aicore__ __attribute__((aligned(4096),section(".zmerge_e5")))void
grouped_matmul_gelu_single_product(__gm__ int8_t *x,__gm__ int8_t *weight,__gm__ float *scale,__gm__ int64_t *groups,
__gm__ half *y,uint32_t experts){
const uint64_t pc = uint64_t(asc_get_program_counter())& 0xFFFFFFFFFFFFULL;
asc_icache_preload(reinterpret_cast<const void *>(pc),1);

asc_datacache_preload((__gm__ uint64_t *)groups,0);
asc_datacache_preload((__gm__ uint64_t *)x,0);
asc_datacache_preload((__gm__ uint64_t *)weight,0);
asc_datacache_preload((__gm__ uint64_t *)scale,0);
const auto ends =(__gm__ int64_t *)groups;
uint32_t low = 0,high = experts - 1U;
while(low < high){
const uint32_t middle =(low + high)>> 1U;
if(ends[middle] == 0U)
low = middle + 1U;
else
high = middle;
}
const int32_t xv =((volatile __gm__ int8_t *)x)[0];
const int32_t wv =((volatile __gm__ int8_t *)weight)[low];
const float sv =((volatile __gm__ float *)scale)[low];
const float z = float(xv * wv)* sv;
const float magnitude = z < 0 ? -z : z;
uint16_t h;
if(magnitude <= .34f)
h = __builtin_bit_cast(uint16_t,half(z *(.5f + .3989423f * z)));
else if(z <= -3.5f)
h = 0x8000U;
else if(z >= 3.0f)
h = __builtin_bit_cast(uint16_t,half(z));
else
h = RelaxedScalar(z);
if((uint64_t(y)& 511U)== 0)
st_dev(h,(__gm__ uint16_t *)y,0);
else
((__gm__ uint16_t *)y)[0] = h;
asc_sync();
}

namespace small_row_pairs{
using smallmat::ReadX;

using smallmat::ReadW;

using smallmat::Dot;

typedef uint16_t PairWeight __attribute__((may_alias));

typedef uint64_t PairScale __attribute__((may_alias));

struct DequantPair{
float first,second;
};

__aicore__ __attribute__((always_inline))inline uint16_t TwoBytes(__gm__ int8_t *p){
return uint8_t(p[0])|(uint16_t(uint8_t(p[1]))<< 8);
}

__aicore__ __attribute__((always_inline))inline DequantPair ReadPair(
smallmat::Row row,__gm__ int8_t *weight,__gm__ float *scale,uint32_t expert,uint32_t column){
auto p = weight + 15 * expert + column;
auto s = scale + 5 * expert + column;
const bool even =(uint64_t(p)& 1U)== 0;
const uint16_t a = even ? *((__gm__ PairWeight *)p): TwoBytes(p);
const uint16_t b = even ? TwoBytes(p + 5): *((__gm__ PairWeight *)(p + 5));
const uint16_t c = even ? *((__gm__ PairWeight *)(p + 10)): TwoBytes(p + 10);
float s0,s1;
if((uint64_t(s)& 7U)== 0){
union{
uint64_t word;
float lane[2];
}v;
v.word = *((__gm__ PairScale *)s);
s0 = v.lane[0];
s1 = v.lane[1];
}else{
s0 = s[0];
s1 = s[1];
}
return{float(row.a * int8_t(a)+ row.b * int8_t(b)+ row.c * int8_t(c))* s0,
float(row.a * int8_t(a >> 8)+ row.b * int8_t(b >> 8)+ row.c * int8_t(c >> 8))* s1};
}

__aicore__ __attribute__((always_inline))inline void RowTile(__gm__ int8_t *x,__gm__ int8_t *w,__gm__ float *scales,
__gm__ int64_t *groups,__gm__ half *y,uint32_t rows,uint32_t experts){
asc_set_atomic_none();
asc_datacache_preload((__gm__ uint64_t *)groups,0);
asc_datacache_preload((__gm__ uint64_t *)x,0);
asc_datacache_preload((__gm__ uint64_t *)w,0);
asc_datacache_preload((__gm__ uint64_t *)scales,0);
const uint32_t rank = asc_get_block_idx();
const bool wide = rank < rows;
const uint32_t rowIndex = wide ? rank : rank - rows;
const uint32_t column = wide ? 0U : 3U;
const auto ends =(__gm__ uint8_t *)groups;
uint32_t expert = 0;
while(expert + 1 < experts && rowIndex >= ends[8 * expert])
++expert;
const auto row = ReadX(x,rowIndex);
const auto pair = ReadPair(row,w,scales,expert,column);
const uint32_t third = wide ? matrix_tail::One(Dot(row,ReadW(w,scales,expert,2))): 0;
((__ubuf__ uint32_t *)0)[0] = smallmat::Pair(pair.first,pair.second);
if(wide)
((__ubuf__ uint32_t *)0)[1] = third;
asc_sync_notify(PIPE_S,PIPE_MTE3,EVENT_ID0);
asc_sync_wait(PIPE_S,PIPE_MTE3,EVENT_ID0);
asc_copy_ub2gm_align(y + rowIndex * 5 + column,(__ubuf__ half *)0,wide ? 6 : 4);
asc_sync();
}
}// namespace small_row_pairs

__vector__ __global__ __aicore__ __attribute__((aligned(4096),section(".zmerge_p3_rows")))void
grouped_matmul_gelu_row_pairs(__gm__ int8_t *x,__gm__ int8_t *w,__gm__ float *scale,__gm__ int64_t *groups,
__gm__ half *y,uint32_t rows,uint32_t experts){
small_row_pairs::RowTile(x,w,scale,groups,y,rows,experts);
}

static __aicore__ __attribute__((always_inline))inline void Held64Epilogue(
__gm__ float *scale,__gm__ half *y,__gm__ int32_t *scratch,uint32_t tile){
const uint32_t row = 32 * tile + 16 * asc_get_sub_block_id();
constexpr uint32_t count = 16 * 128;
auto z =(__ubuf__ float *)0;
auto u =(__ubuf__ float *)8192;
auto p =(__ubuf__ float *)16384;
auto out =(__ubuf__ half *)24576;
auto sc =(__ubuf__ float *)28672;
asc_copy_gm2ub_align(sc,scale,128 * sizeof(float));
asc_sync_block_wait(8);
asc_copy_gm2ub_align((__ubuf__ int32_t *)z,scratch + row * 128,count * sizeof(int32_t));
asc_sync_notify(PIPE_MTE2,PIPE_V,EVENT_ID1);
asc_sync_wait(PIPE_MTE2,PIPE_V,EVENT_ID1);
asc_int322float_rn(z,(__ubuf__ int32_t *)z,count);
asc_sync_pipe(PIPE_V);
asc_set_mask_norm();
asc_set_vector_mask(uint64_t(0),~uint64_t(0));
asc_mul(z,z,sc,uint8_t(16),1,1,1,16,16,0);
asc_mul(z + 64,z + 64,sc + 64,uint8_t(16),1,1,1,16,16,0);
asc_sync_pipe(PIPE_V);
asc_set_vector_mask(~uint64_t(0),~uint64_t(0));
asc_mul(u,z,z,count);
asc_sync_pipe(PIPE_V);
asc_mul(u,u,z,count);
asc_sync_pipe(PIPE_V);
asc_mul_scalar(u,u,.044715f,count);
asc_sync_pipe(PIPE_V);
asc_add(u,u,z,count);
asc_sync_pipe(PIPE_V);
asc_mul_scalar(p,u,-1.5957692f,count);
asc_sync_pipe(PIPE_V);
asc_min_scalar(p,p,80.0f,count);
asc_sync_pipe(PIPE_V);
asc_exp(p,p,count);
asc_sync_pipe(PIPE_V);
asc_add_scalar(p,p,1.0f,count);
asc_sync_pipe(PIPE_V);
asc_div(u,z,p,count);
asc_sync_pipe(PIPE_V);
asc_float2half_rn(out,u,count);
asc_sync_notify(PIPE_V,PIPE_MTE3,EVENT_ID0);
asc_sync_wait(PIPE_V,PIPE_MTE3,EVENT_ID0);
asc_copy_ub2gm_align(y + row * 128,out,count * sizeof(half));
}

template <uint32_t Rows>
__global__ __mix__(1,2)__attribute__((section(".zzheld64")))void grouped_matmul_gelu_full_row_tile(
__gm__ int8_t *x,__gm__ int8_t *w,__gm__ float *s,__gm__ half *y,__gm__ int32_t *scratch,uint64_t sync){
set_ffts_base_addr(sync);
asc_init();
const uint32_t tile = asc_get_block_idx();
if ASC_IS_AIC
d7_tiny_fast::Cube<32,128>(x,w,scratch,tile,Rows,128,128);
if ASC_IS_AIV
Held64Epilogue(s,y,scratch,tile);
asc_sync();
}

