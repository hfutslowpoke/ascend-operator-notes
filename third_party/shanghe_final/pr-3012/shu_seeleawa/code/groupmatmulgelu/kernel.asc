namespace cp6_sv59{
using cp6_c38::Min;

struct Frame{
__gm__ half *dst;
uint32_t rows,N,nr,bn,bank,hard,done;
bool deferred;
};

struct State{
Frame prev;
bool pending,lease[2],cache,short_curve;
uint32_t next,ready;
};

__aicore__ inline __ubuf__ half *Out(uint32_t b){return(__ubuf__ half *)static_cast<uint64_t>(131072 + b * 16384);}

__aicore__ inline __ubuf__ float *HZ(uint32_t b){return(__ubuf__ float *)static_cast<uint64_t>(163840 + b * 2560);}

__aicore__ inline __ubuf__ uint32_t *HI(uint32_t b){
return(__ubuf__ uint32_t *)static_cast<uint64_t>(164864 + b * 2560);
}

__aicore__ inline __ubuf__ half *HH(uint32_t b){return(__ubuf__ half *)static_cast<uint64_t>(165888 + b * 2560);}

__aicore__ inline void Wait(State &s,uint32_t b){
if(s.lease[b]){
if(!b)
asc_sync_wait(PIPE_MTE3,PIPE_S,EVENT_ID6);
else
asc_sync_wait(PIPE_MTE3,PIPE_S,EVENT_ID7);
s.lease[b] = false;
}
}

__aicore__ inline void Emit(State &s,const Frame &f){
asc_sync_notify(PIPE_S,PIPE_MTE3,EVENT_ID0);
asc_sync_wait(PIPE_S,PIPE_MTE3,EVENT_ID0);
if(f.nr == f.bn)
asc_copy_ub2gm_align(f.dst,Out(f.bank),f.rows,f.bn * 2,0,0,0,(f.N - f.bn)* 2);
else
for(uint32_t r = 0;r < f.rows;++r)
asc_copy_ub2gm_align(f.dst + uint64_t(r)* f.N,Out(f.bank)+ r * f.bn,1,f.nr * 2,0,0,0,0);
if(!f.bank)
asc_sync_notify(PIPE_MTE3,PIPE_S,EVENT_ID6);
else
asc_sync_notify(PIPE_MTE3,PIPE_S,EVENT_ID7);
s.lease[f.bank] = true;
}

__aicore__ inline void Refine(State &s,uint32_t stop){
if(!s.pending)
return;
Frame &f = s.prev;
__ubuf__ uint16_t *out =(__ubuf__ uint16_t *)Out(f.bank);
__ubuf__ uint32_t *keys =(__ubuf__ uint32_t *)184320;
__ubuf__ uint16_t *initials =(__ubuf__ uint16_t *)188416;
__ubuf__ uint16_t *values =(__ubuf__ uint16_t *)190464;
for(;f.done < stop;++f.done){
const uint32_t q = f.done,lane = HI(f.bank)[q];
if(lane >= f.rows * f.bn){

continue;
}
const float zi = HZ(f.bank)[q];
if(f.deferred){
out[lane] = cp6_c38::GoalRefineLane(zi,out[lane]);
continue;
}
const uint16_t initial =((__ubuf__ uint16_t *)HH(f.bank))[q];
if(zi >= 5.0f){
out[lane] = initial;
continue;
}
union{
float f;
uint32_t u;
}key;
key.f = zi;
const uint32_t k =(key.u ^(key.u >> 8)^(key.u >> 16)^(key.u >> 24))& 1023U;
if(keys[k] == key.u && initials[k] == initial){
out[lane] = values[k];
continue;
}
const uint32_t quick = cp6_gmg_opt::TryGeluQ30(zi);
const uint16_t value = quick < 65536U ? uint16_t(quick): cp6_gmg_opt::PreciseGeluHalfC(zi);
out[lane] = value;
keys[k] = key.u;
initials[k] = initial;
values[k] = value;
}
if(f.done == f.hard){
Emit(s,f);
s.pending = false;
}
}

__aicore__ inline void Finish(State &s){
if(s.pending)
Refine(s,s.prev.hard);
}

static __aicore__ __attribute__((noinline))uint32_t GeluKnownLow59(__ubuf__ float *z,__ubuf__ float *u,
__ubuf__ float *t,__ubuf__ float *d,__ubuf__ float *p,__ubuf__ half *out,__ubuf__ uint8_t *mask,uint32_t count,
uint32_t nr,uint32_t bn,uint32_t ready){
const uint32_t selected = cp6_gmg_opt::PackNonSaturated33(z,u,t,mask,d,count);
if(selected > count / 4){
ready = cp6_index37::GeluPositiveCache37(z,u,t,d,p,out,mask,count,nr,bn,ready);
return ready;
}
asc_mul_scalar(p,z,0.0f,count);
asc_sync_pipe(PIPE_V);
asc_max(p,p,z,count);
asc_sync_pipe(PIPE_V);
asc_float2half_rn(out,p,count);
asc_sync_pipe(PIPE_V);
if(!selected){
asc_sync_notify(PIPE_V,PIPE_S,EVENT_ID1);
asc_sync_wait(PIPE_V,PIPE_S,EVENT_ID1);
return ready;
}
const uint32_t packed =(selected + 63)/ 64 * 64,rem = selected % 64;
if(rem){
asc_set_mask_norm();
asc_set_vector_mask(uint64_t(0),~uint64_t(0)<< rem);
asc_duplicate(t + selected - rem,0.0f,uint8_t(1),uint16_t(1),uint16_t(8));
asc_sync_pipe(PIPE_V);
asc_set_vector_mask(~uint64_t(0),~uint64_t(0));
}
__ubuf__ half *packed_out =(__ubuf__ half *)(p + 6144);
__ubuf__ uint8_t *packed_mask =(__ubuf__ uint8_t *)(p + 7168);
ready = cp6_index37::GeluPositiveCache37(t,u,z,d,p,packed_out,packed_mask,packed,64,64,ready);
ready = cp6_index37::Scatter(out,packed_out,mask,z,u,t,count,selected,ready);
return ready;
}

__aicore__ inline void Legacy(State &s,__ubuf__ float *z,const Frame &f,bool low){
Finish(s);
Wait(s,0);
Wait(s,1);
__ubuf__ float *u =(__ubuf__ float *)32768;
__ubuf__ float *t =(__ubuf__ float *)65536;
__ubuf__ float *d =(__ubuf__ float *)98304;
__ubuf__ float *p =(__ubuf__ float *)131072;
__ubuf__ half *out =(__ubuf__ half *)163840;
__ubuf__ uint8_t *mask =(__ubuf__ uint8_t *)180224;
s.ready = low ? GeluKnownLow59(z,u,t,d,p,out,mask,f.rows * f.bn,f.nr,f.bn,s.ready)
: cp6_index37::GeluPositiveCache37(z,u,t,d,p,out,mask,f.rows * f.bn,f.nr,f.bn,s.ready);
asc_sync_notify(PIPE_S,PIPE_MTE3,EVENT_ID0);
asc_sync_wait(PIPE_S,PIPE_MTE3,EVENT_ID0);
if(f.nr == f.bn)
asc_copy_ub2gm_align(f.dst,out,f.rows,f.bn * 2,0,0,0,(f.N - f.bn)* 2);
else
for(uint32_t r = 0;r < f.rows;++r)
asc_copy_ub2gm_align(f.dst + uint64_t(r)* f.N,out + r * f.bn,1,f.nr * 2,0,0,0,0);
asc_sync();
s.cache = false;
}

template <bool FastCurve = false> __aicore__ inline void Prepare(State &s,__ubuf__ float *z,Frame f){
const uint32_t count = f.rows * f.bn,b = s.next;
s.next ^= 1;
f.bank = b;
Wait(s,b);
__ubuf__ float *u =(__ubuf__ float *)32768;
__ubuf__ float *t =(__ubuf__ float *)65536;
__ubuf__ float *d =(__ubuf__ float *)98304;
__ubuf__ half *out = Out(b);
__ubuf__ uint8_t *range =(__ubuf__ uint8_t *)169984;
__ubuf__ uint8_t *margin =(__ubuf__ uint8_t *)171008;
__ubuf__ uint8_t *saved =(__ubuf__ uint8_t *)172032;
__ubuf__ uint8_t *pos =(__ubuf__ uint8_t *)173056;
__ubuf__ uint8_t *cmp =(__ubuf__ uint8_t *)174080;
