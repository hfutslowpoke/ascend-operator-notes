namespace general_math{
__aicore__ inline void Gelu(__ubuf__ float *z,__ubuf__ float *u,__ubuf__ float *t,
__ubuf__ float *p,__ubuf__ half *out,uint32_t count){
asc_mul(u,z,z,count);asc_sync_pipe(PIPE_V);
asc_mul_scalar(u,u,.044715f,count);asc_sync_pipe(PIPE_V);
asc_add_scalar(u,u,1.0f,count);asc_sync_pipe(PIPE_V);
asc_mul(u,u,z,count);asc_sync_pipe(PIPE_V);
asc_mul_scalar(u,u,-1.5957691216057308f,count);asc_sync_pipe(PIPE_V);
asc_min_scalar(u,u,80.0f,count);asc_sync_pipe(PIPE_V);
asc_exp(t,u,count);asc_sync_pipe(PIPE_V);
asc_add_scalar(t,t,1.0f,count);asc_sync_pipe(PIPE_V);
asc_div(p,z,t,count);asc_sync_pipe(PIPE_V);
asc_float2half_rn(out,p,count);asc_sync_pipe(PIPE_V);
}
__aicore__ inline void Scale(__ubuf__ float *z,__ubuf__ float *s,uint32_t rows,uint32_t bn){
asc_set_mask_norm();asc_set_vector_mask(0ULL,bn==32?0xffffffffULL:~0ULL);
for(uint32_t col=0;col<bn;col+=64)
asc_mul(z+col,z+col,s+col,uint8_t(rows),1,1,1,bn/8,bn/8,0);
asc_sync_pipe(PIPE_V);
}
}

namespace general_aligned{
using cp6_gmg::Min;using cp6_gmg::Up;using cp6_gmg::TileM;
constexpr uint32_t BM=64,BN=128,SM=32,VM=32,VQ=VM*BN;
constexpr int READY=8,DONE=9,FINAL_DONE=12;
__aicore__ inline void VectorC(__gm__ float *scale,__gm__ int64_t *groups,__gm__ half *y,
__gm__ int32_t *scratch,uint32_t E,uint32_t N,uint32_t workers,
uint32_t fast_path,uint32_t deep_path){
const uint32_t slot_rows = fast_path ? SM : BM;
const uint32_t slot_count =(fast_path || deep_path)? 2 : 1;
__ubuf__ int32_t *c =(__ubuf__ int32_t *)0;
__ubuf__ float *z =(__ubuf__ float *)(4 * VQ);
__ubuf__ float *u =(__ubuf__ float *)(8 * VQ);
__ubuf__ float *t =(__ubuf__ float *)(12 * VQ);
__ubuf__ float *d =(__ubuf__ float *)(16 * VQ);
__ubuf__ float *p =(__ubuf__ float *)(20 * VQ);
__ubuf__ float *s =(__ubuf__ float *)(24 * VQ);
__ubuf__ half *out =(__ubuf__ half *)(24 * VQ + 4 * BN);
__ubuf__ uint8_t *refine_mask =(__ubuf__ uint8_t *)(26 * VQ + 4 * BN);
__ubuf__ float *near_zero =(__ubuf__ float *)c;
const uint32_t worker = asc_get_block_idx(),sub = asc_get_sub_block_id();
const uint32_t nt =(N + BN - 1)/ BN;
uint32_t ordinal = 0;
uint32_t start = 0,prefix = 0;
for(uint32_t e = 0;e < E;++e){
const uint32_t end = static_cast<uint32_t>(groups[e]),me = end - start;
const uint32_t tm = fast_path ? TileM(me): BM;
const uint32_t tasks =((me + tm - 1)/ tm)* nt;
const uint32_t first =(worker + workers - prefix % workers)% workers;
for(uint32_t task = first;task < tasks;task += workers){
const uint32_t row0 = start +(task / nt)* tm,col =(task % nt)* BN;
const uint32_t mr = Min(tm,end - row0),nr = Min(BN,N - col);
if(fast_path){
asc_duplicate_sync(s,0.0f,BN);
asc_copy_gm2ub_align_sync(s,scale + uint64_t(e)* N + col,nr * 4);
}
for(uint32_t micro = 0;micro < mr;micro += slot_rows){
const uint32_t micro_mr = Min(slot_rows,mr - micro),
split = fast_path ?(micro_mr + 1)/ 2 : VM;
const uint32_t local_row = sub * split;
const uint32_t rows = micro_mr > local_row ? Min(split,micro_mr - local_row): 0;
const uint32_t slot_index = slot_count == 2 ?(ordinal % 2): 0;
__gm__ int32_t *slot =
scratch +(uint64_t(worker)* slot_count + slot_index)* slot_rows * BN;
asc_sync_block_wait(READY + 2 * slot_index);
const uint32_t count = rows * BN,np = Up(nr,32);
if(rows){
asc_duplicate_sync(c,int32_t(0),count);
asc_copy_gm2ub_align(c,slot + local_row * BN,rows,np * 4,0,0,(BN - np)* 4,
(BN - np)/ 8);
asc_sync();
}
if(fast_path)
ffts_cross_core_sync(PIPE_MTE2,0x21ULL |(uint64_t(DONE + 2 * slot_index)<< 8));
if(rows){
if(!fast_path){
asc_duplicate_sync(s,0.0f,BN);
asc_copy_gm2ub_align_sync(s,scale + uint64_t(e)* N + col,nr * 4);
}
asc_int322float_rn(z,c,count);asc_sync_pipe(PIPE_V);
general_math::Scale(z,s,rows,BN);
general_math::Gelu(z,u,t,p,out,count);
asc_sync_notify(PIPE_V,PIPE_MTE3,EVENT_ID0);
asc_sync_wait(PIPE_V,PIPE_MTE3,EVENT_ID0);
asc_copy_ub2gm_align(y + uint64_t(row0 + micro + local_row)* N + col,out,rows,nr * 2,
0,0,(BN - Up(nr,16))/ 16,(N - nr)* 2);
asc_sync();
}
if(!fast_path)
ffts_cross_core_sync(PIPE_MTE3,0x21ULL |(uint64_t(DONE + 2 * slot_index)<< 8));
++ordinal;
}
}
prefix += tasks;
start = end;
}
asc_sync();
if(fast_path)
ffts_cross_core_sync(PIPE_MTE3,0x21ULL |(uint64_t(FINAL_DONE)<< 8));
}

}
__global__ __mix__(1,2)__attribute__((section(".zzzzzzzzzzz_general_aligned")))
void grouped_matmul_gelu_general_aligned(__gm__ int8_t *x,__gm__ int8_t *w,__gm__ float *scale,
__gm__ int64_t *groups,__gm__ half *y,__gm__ int32_t *scratch,uint32_t E,uint32_t K,
uint32_t cfg,uint32_t workers,uint64_t sync){
const uint32_t fast=(cfg>>30)&1,deep=!fast&&((cfg>>29)&1),N=cfg&0x1fffffffU;
set_ffts_base_addr(sync);asc_init();
if ASC_IS_AIC cp6_gmg::CubeC(x,w,groups,scratch,E,K,N,workers,fast,deep);
if ASC_IS_AIV general_aligned::VectorC(scale,groups,y,scratch,E,N,workers,fast,deep);
asc_sync();
}
namespace general_tail{
using dfocus::Min;using dfocus::Up;using cp6_gmg::ZeroL1;
constexpr int READY=8,DONE=9;
__aicore__ inline void CubeUnified(__gm__ int8_t *x,__gm__ int8_t *w,__gm__ int64_t *groups,
__gm__ int32_t *scratch,uint32_t cfg,uint32_t K,uint32_t N,
uint32_t workers){
constexpr bool TailZero = true;
const bool CacheWeights = bool(cfg & 0x10000000U);
const uint32_t full_kp = Up(K,32);
const bool Pipeline = bool(cfg & 0x40000000U);
const uint32_t E = cfg & 255U,mlog =(cfg >> 12)& 15U,nlog =(cfg >> 8)& 7U;
const uint32_t BM = 1U << mlog,BN = 1U << nlog;
const uint32_t BK = BN == 32 ?(K <= 128 ? 128 : 256):(K < 256 ? 256 :(BN == 64 ? 1024 : 512));
__cbuf__ int8_t *a1 =(__cbuf__ int8_t *)0;
__cbuf__ int8_t *b1 =(__cbuf__ int8_t *)static_cast<uint64_t>(BM * BK);
__ca__ int8_t *a0 =(__ca__ int8_t *)0;
__cb__ int8_t *b0 =(__cb__ int8_t *)0;
__cc__ int32_t *c0 =(__cc__ int32_t *)0;
const uint32_t worker = asc_get_block_idx(),nt =(N + BN - 1)>> nlog;
__gm__ int32_t *slots = scratch + uint64_t(worker)* BM * BN *(Pipeline ? 2 : 1);
uint32_t ticket = 0;
uint32_t start = 0,prefix = 0;
for(uint32_t e = 0;e < E;++e){
const uint32_t end = static_cast<uint32_t>(groups[e]),me = end - start;
const uint32_t mt =(me + BM - 1)>> mlog,tasks = mt * nt;
const uint32_t first =(worker + workers - prefix % workers)% workers;
uint32_t task_begin = first,task_end = tasks,task_step = workers;
if(CacheWeights){
const uint32_t q = tasks / workers,r = tasks % workers;
task_begin = first * q + Min(first,r);
task_end = task_begin + q +(first < r);
task_step = 1;
}
uint32_t last_col = ~0U;
for(uint32_t task = task_begin;task < task_end;task += task_step){
if(Pipeline && ticket >= 2){
if(ticket & 1)
asc_sync_block_wait(DONE + 2);
else
asc_sync_block_wait(DONE);
}
__gm__ int32_t *slot = slots +(Pipeline ?(ticket & 1)* BM * BN : 0);
const uint32_t row = start +((CacheWeights ? task % mt : task / nt)<< mlog);
const uint32_t col =(CacheWeights ? task / mt : task % nt)* BN;
const uint32_t mr = Min(BM,end - row),nr = Min(BN,N - col);
const uint32_t mp = Up(mr,16),np = Up(nr,32);
const bool new_column = col != last_col;
if(CacheWeights && new_column){
const uint32_t padded_n = nr % 32 ? 1 : 0,nblocks = np / 32;
if(padded_n)
ZeroL1(b1 +(np - 32)* full_kp,full_kp * 32);
if(K % 32){
for(uint32_t nb = 0;nb < nblocks - padded_n;++nb)
ZeroL1(b1 + nb * full_kp * 32 +(full_kp - 32)* 32,1024);
}
asc_copy_gm2l1_nd2nz_sync(b1,w + uint64_t(e)* K * N + col,1,K,nr,0,N,full_kp,1,0);
last_col = col;
}
for(uint32_t k0 = 0;k0 < K;k0 += BK){
const uint32_t kr = Min(BK,K - k0),kp = Up(kr,32);
if(!TailZero || mr % 16 || kr % 32)
ZeroL1(a1,BM * BK);
if(!CacheWeights &&(!TailZero || nr % 32 || kr % 32))
ZeroL1(b1,BK * BN);
asc_copy_gm2l1_nd2nz_sync(a1,x + uint64_t(row)* K + k0,1,mr,kr,0,K,BM,1,0);
if(!CacheWeights)
asc_copy_gm2l1_nd2nz_sync(b1,w +(uint64_t(e)* K + k0)* N + col,1,kr,nr,0,N,kp,
1,0);
for(uint32_t mi = 0;mi < mp / 16;++mi)
asc_copy_l12l0a_sync(a0 + mi * kp * 16,a1 + mi * 512,0,kp / 32,BM / 16,0);
if(!CacheWeights || new_column || K > BK){
for(uint32_t ki = 0;ki < kp / 32;++ki)
asc_copy_l12l0b_trans_sync(b0 + ki * np * 32,
b1 +(CacheWeights ? k0 * 32 : 0)+ ki * 1024,0,np / 32,
(CacheWeights ? full_kp : kp)/ 32,1,false,uint64_t(0));
}
asc_mmad_sync(c0,a0,b0,mp,kp,np,0,false,false,k0 == 0);
}
asc_set_l0c_copy_params(1,0,0);
asc_copy_l0c2gm_sync(slot,c0,np,mr,BN,mp,0,0,0,false,true);
if(Pipeline &&(ticket & 1))
ffts_cross_core_sync(PIPE_FIX,0x21ULL |(uint64_t(READY + 2)<< 8));
else
ffts_cross_core_sync(PIPE_FIX,0x21ULL |(uint64_t(READY)<< 8));
if(!Pipeline)
asc_sync_block_wait(DONE);
++ticket;
}
prefix += tasks;
start = end;
}
if(Pipeline && ticket){
asc_sync_block_wait(DONE);
if(ticket >= 2)
asc_sync_block_wait(DONE + 2);
}
}

__aicore__ inline void VectorUnified(__gm__ int8_t *x,__gm__ int8_t *w,__gm__ float *scale,
__gm__ int64_t *groups,__gm__ half *y,__gm__ int32_t *scratch,
uint32_t cfg,uint32_t N,uint32_t workers){
constexpr uint32_t VQ = 4096;
constexpr bool Filter = true;
const bool Pipeline = bool(cfg & 0x40000000U);
const bool VectorOnly = bool(cfg & 0x20000000U);
const bool CacheWeights = bool(cfg & 0x10000000U);
const uint32_t E = cfg & 255U,nlog =(cfg >> 8)& 7U,mlog =(cfg >> 12)& 15U;
const uint32_t BN = 1U << nlog,BM = 1U << mlog,VM = BM / 2;
__ubuf__ int32_t *c =(__ubuf__ int32_t *)0;
__ubuf__ float *z =(__ubuf__ float *)(4 * VQ);
__ubuf__ float *u =(__ubuf__ float *)(8 * VQ);
__ubuf__ float *t =(__ubuf__ float *)(12 * VQ);
__ubuf__ float *d =(__ubuf__ float *)(16 * VQ);
__ubuf__ float *p =(__ubuf__ float *)(20 * VQ);
__ubuf__ float *s =(__ubuf__ float *)(24 * VQ);
__ubuf__ half *out =(__ubuf__ half *)(24 * VQ + 512);
__ubuf__ uint8_t *refine_mask =(__ubuf__ uint8_t *)(26 * VQ + 512);
__ubuf__ uint64_t *refined_mask =(__ubuf__ uint64_t *)110592;
__ubuf__ uint16_t *refined =(__ubuf__ uint16_t *)110624;
__ubuf__ int8_t *raw_x =(__ubuf__ int8_t *)111136;
__ubuf__ uint32_t *precise_keys =(__ubuf__ uint32_t *)114688;
__ubuf__ uint16_t *precise_results =(__ubuf__ uint16_t *)116736;

const uint32_t worker = asc_get_block_idx(),sub = asc_get_sub_block_id();
const uint32_t sw = VectorOnly ? 2 * worker + sub : worker;
const uint32_t nw = VectorOnly ? 2 * workers : workers;
const uint32_t nt = VectorOnly ? 1 :(N + BN - 1)>> nlog;
__gm__ int32_t *slots = scratch;
if(!VectorOnly)
slots += uint64_t(worker)* BM * BN *(Pipeline ? 2 : 1);
uint32_t ticket = 0,start = 0,prefix = 0;
for(uint32_t e = 0;e < E;++e){
const uint32_t end = uint32_t(groups[e]),me = end - start;
const uint32_t mt =(me + BM - 1)>> mlog,tasks = mt * nt;
const uint32_t first =(sw + nw - prefix % nw)% nw;
uint32_t task_begin = first,task_end = tasks,task_step = nw;
if(CacheWeights){
const uint32_t q = tasks / nw,r = tasks % nw;
task_begin = first * q + Min(first,r);
task_end = task_begin + q +(first < r);
task_step = 1;
}
int32_t previous_key = -1;
uint16_t previous_result = 0;
if(VectorOnly && first < tasks){
refined_mask[0] = 0;
refined_mask[1] = 0;
refined_mask[2] = 0;
refined_mask[3] = 0;
}
for(uint32_t task = task_begin;task < task_end;task += task_step){
__gm__ int32_t *slot = slots;
if(!VectorOnly && Pipeline)
slot +=(ticket & 1)* BM * BN;
const uint32_t row0 = start +((CacheWeights ? task % mt : task / nt)<< mlog);
const uint32_t col =(CacheWeights ? task / mt : task % nt)* BN;
const uint32_t mr = Min(BM,end - row0),nr = Min(BN,N - col);
const uint32_t local_row = VectorOnly ? 0 : sub * VM;
const uint32_t rows = mr > local_row ? Min(VectorOnly ? BM : VM,mr - local_row): 0;
if(!VectorOnly){
if(Pipeline &&(ticket & 1))
asc_sync_block_wait(READY + 2);
else
asc_sync_block_wait(READY);
}
if(rows){
const uint32_t count = Up(rows * BN,128),np = Up(nr,32);
if(VectorOnly){
asc_duplicate_sync((__ubuf__ int32_t *)raw_x,int32_t(0),count / 4);
asc_copy_gm2ub_align_sync(raw_x,x + row0,rows);
asc_int82half_sync((__ubuf__ half *)z,raw_x,count);
asc_half2int32_rn_sync(c,(__ubuf__ half *)z,count);
asc_mul_scalar_sync(c,c,int32_t(w[e]),count);
}else{
if(!Filter || np != BN || count != rows * BN)
asc_duplicate_sync(c,int32_t(0),count);
asc_copy_gm2ub_align(c,slot + local_row * BN,rows,np * 4,0,0,(BN - np)* 4,
(BN - np)/ 8);
asc_sync();
if(!Filter || nr != BN)
asc_duplicate_sync(s,0.0f,BN);
asc_copy_gm2ub_align_sync(s,scale + uint64_t(e)* N + col,nr * 4);
}
asc_int322float_rn(z,c,count);asc_sync_pipe(PIPE_V);
if(VectorOnly)
asc_mul_scalar_sync(z,z,scale[e],count);
else if(Filter){
asc_set_mask_norm();
asc_set_vector_mask(uint64_t(0),BN == 32 ? uint64_t(0xffffffffULL): ~uint64_t(0));
for(uint32_t col64 = 0;col64 < BN;col64 += 64)
asc_mul(z + col64,z + col64,s + col64,uint8_t(rows),1,1,1,BN / 8,BN / 8,0);
asc_sync();
}else{
for(uint32_t r = 0;r < rows;++r)
asc_mul_sync(z + r * BN,z + r * BN,s,BN);
}
general_math::Gelu(z,u,t,p,out,count);
asc_sync_notify(PIPE_V,PIPE_MTE3,EVENT_ID0);
asc_sync_wait(PIPE_V,PIPE_MTE3,EVENT_ID0);
if(VectorOnly)
asc_copy_ub2gm_align_sync(y + row0,out,rows * 2);
else{
asc_copy_ub2gm_align(y + uint64_t(row0 + local_row)* N + col,out,rows,nr * 2,0,0,
(BN - Up(nr,16))/ 16,(N - nr)* 2);
asc_sync();
}
}
if(!VectorOnly){
if(Pipeline &&(ticket & 1))
ffts_cross_core_sync(PIPE_MTE3,0x21ULL |(uint64_t(DONE + 2)<< 8));
else
ffts_cross_core_sync(PIPE_MTE3,0x21ULL |(uint64_t(DONE)<< 8));
}
++ticket;
}
prefix += tasks;
start = end;
}
if(VectorOnly)
ffts_cross_core_sync(PIPE_MTE3,0x21ULL |(uint64_t(12)<< 8));
}

}
__global__ __mix__(1,2)__attribute__((section(".zzzzzzzzzzz_general_tail")))
void grouped_matmul_gelu_general_tail(__gm__ int8_t *x,__gm__ int8_t *w,__gm__ float *scale,
__gm__ int64_t *groups,__gm__ half *y,__gm__ int32_t *scratch,uint32_t cfg,uint32_t K,
uint32_t N,uint32_t workers,uint64_t sync){
set_ffts_base_addr(sync);asc_init();
if ASC_IS_AIC{
if(cfg&0x20000000U)asc_sync_block_wait(12);
else general_tail::CubeUnified(x,w,groups,scratch,cfg,K,N,workers);
}
if ASC_IS_AIV general_tail::VectorUnified(x,w,scale,groups,y,scratch,cfg,N,workers);
asc_sync();
}
namespace general_tiles{
using dfocus::Min;
using dfocus::Up;

__aicore__ inline void Multiply(__cbuf__ int8_t *a1,__cbuf__ int8_t *b1,
__ca__ int8_t *a,__cb__ int8_t *b,__cc__ int32_t *c,
uint32_t tm,uint32_t mp,uint32_t np,uint32_t kp,bool first){
const uint32_t width=tm>np?tm:np;
const uint32_t step=Min(512U,(1024/width)*32),total=(kp+step-1)/step;
d6_l0::Load(a1,b1,a,b,tm,mp,np,kp,step,0);
for(uint32_t i=0;i<total;++i){
const uint32_t slot=i&1,k=Min(step,kp-i*step);
dfocus::LR(slot,true);
if(i && k==32)asc_sync_pipe(PIPE_M);
if(mp<64 || mp%32 || np<64)
asc_mmad_sync(c,a+slot*tm*step,b+slot*np*step,mp,k,np,0,false,false,first&&i==0);
else
asc_mmad(c,a+slot*tm*step,b+slot*np*step,mp,k,np,0,false,false,first&&i==0);
if(i+2<total)dfocus::LF(slot,false);
if(i+1<total){
if(i+1>=2)dfocus::LF((i+1)&1,true);
d6_l0::Load(a1,b1,a,b,tm,mp,np,kp,step,i+1);
}
}
asc_sync();
}

template<uint32_t TM,uint32_t TN>
__aicore__ inline void Stage(__gm__ int8_t *x,__gm__ int8_t *w,__cbuf__ int8_t *base,
uint32_t e,uint32_t row,uint32_t col,uint32_t mr,uint32_t nr,uint32_t np,
uint32_t K,uint32_t N,uint32_t k0,uint32_t slot){
constexpr uint32_t TK=(TM+TN>512)?256:512,SPAN=(TM+TN)*TK;
const uint32_t kr=Min(TK,K-k0),kp=Up(kr,32);
auto a1=base+slot*SPAN,b1=a1+TM*TK;
if(mr%16 || kr%32)cp6_gmg::ZeroL1(a1,TM*kp);
if(nr%32 || kr%32)cp6_gmg::ZeroL1(b1,np*kp);
asc_copy_gm2l1_nd2nz(a1,x+uint64_t(row)*K+k0,1,mr,kr,0,K,TM,1,0);
asc_copy_gm2l1_nd2nz(b1,w+(uint64_t(e)*K+k0)*N+col,1,kr,nr,0,N,kp,1,0);
if(slot)asc_sync_notify(PIPE_MTE2,PIPE_MTE1,EVENT_ID5);
else asc_sync_notify(PIPE_MTE2,PIPE_MTE1,EVENT_ID4);
}

template<uint32_t TM,uint32_t TN>
__aicore__ inline void Cube(__gm__ int8_t *x,__gm__ int8_t *w,__gm__ int64_t *groups,
__gm__ int32_t *scratch,uint32_t E,uint32_t K,uint32_t N,uint32_t workers){
constexpr uint32_t TK=(TM+TN>512)?256:512,WORDS=TM*TN;
const uint32_t worker=asc_get_block_idx(),nt=(N+TN-1)/TN,kp=Up(K,32);
auto a1=(__cbuf__ int8_t *)0;
auto a0=(__ca__ int8_t *)0;
auto b0=(__cb__ int8_t *)0;
auto c0=(__cc__ int32_t *)0;
uint32_t ticket=0,start=0,prefix=0;
for(uint32_t e=0;e<E;++e){
const uint32_t end=uint32_t(groups[e]),me=end-start,mt=(me+TM-1)/TM,tasks=mt*nt;
const uint32_t first=(worker+workers-prefix%workers)%workers;
const bool resident=uint64_t(TM+TN)*kp<=523264;
uint32_t begin=first,limit=tasks,step=workers;
if(resident){
const uint32_t q=tasks/workers,r=tasks%workers;
begin=first*q+Min(first,r);limit=begin+q+(first<r);step=1;
}
uint32_t previous=~0U;
for(uint32_t task=begin;task<limit;task+=step){
const uint32_t row=start+(resident?task%mt:task/nt)*TM;
const uint32_t col=(resident?task/mt:task%nt)*TN;
const uint32_t mr=Min(TM,end-row),nr=Min(TN,N-col),mp=Up(mr,16),np=Up(nr,32);
if(resident){
auto b1=a1+TM*kp;
if(mr%16 || K%32)cp6_gmg::ZeroL1(a1,TM*kp);
asc_copy_gm2l1_nd2nz(a1,x+uint64_t(row)*K,1,mr,K,0,K,TM,1,0);
if(col!=previous){
if(nr%32 || K%32)cp6_gmg::ZeroL1(b1,np*kp);
asc_copy_gm2l1_nd2nz(b1,w+uint64_t(e)*K*N+col,1,K,nr,0,N,kp,1,0);
previous=col;
}
asc_sync();
Multiply(a1,b1,a0,b0,c0,TM,mp,np,kp,true);
}else{
constexpr uint32_t SPAN=(TM+TN)*TK;
const uint32_t stages=(K+TK-1)/TK;
Stage<TM,TN>(x,w,a1,e,row,col,mr,nr,np,K,N,0,0);
for(uint32_t stage=0;stage<stages;++stage){
const uint32_t slot=stage&1,k0=stage*TK,padded=Up(Min(TK,K-k0),32);
if(slot)asc_sync_wait(PIPE_MTE2,PIPE_MTE1,EVENT_ID5);
else asc_sync_wait(PIPE_MTE2,PIPE_MTE1,EVENT_ID4);
if(stage+1<stages)
Stage<TM,TN>(x,w,a1,e,row,col,mr,nr,np,K,N,k0+TK,slot^1);
auto aa=a1+slot*SPAN,bb=aa+TM*TK;
Multiply(aa,bb,a0,b0,c0,TM,mp,np,padded,stage==0);
}
}
const uint32_t slot=ticket&1;
if(ticket>=2)asc_sync_block_wait(9+2*slot);
auto dst=scratch+(uint64_t(worker)*2+slot)*WORDS;
asc_set_l0c_copy_params(1,0,0);
asc_copy_l0c2gm_sync(dst,c0,np,mr,TN,mp,0,0,0,false,true);
ffts_cross_core_sync(PIPE_FIX,0x21ULL|(uint64_t(8+2*slot)<<8));
++ticket;
}
start=end;prefix+=tasks;
}
for(uint32_t i=ticket>2?ticket-2:0;i<ticket;++i)asc_sync_block_wait(9+2*(i&1));
asc_sync_block_wait(12);
}

template<uint32_t TM,uint32_t TN>
__aicore__ inline void Vector(__gm__ float *scale,__gm__ int64_t *groups,__gm__ half *y,
__gm__ int32_t *scratch,uint32_t E,uint32_t K,uint32_t N,uint32_t workers){
constexpr uint32_t CHUNK=TN>256?16:TN==256?32:TN==128?64:128,VQ=CHUNK*TN,WORDS=TM*TN;
auto z=(__ubuf__ float *)0;
auto u=(__ubuf__ float *)(4*VQ);
auto t=(__ubuf__ float *)(8*VQ);
auto sc=(__ubuf__ float *)(12*VQ);
auto out=(__ubuf__ half *)(12*VQ+4*TN);
const uint32_t worker=asc_get_block_idx(),sub=asc_get_sub_block_id(),nt=(N+TN-1)/TN,kp=Up(K,32);
uint32_t ticket=0,start=0,prefix=0;
for(uint32_t e=0;e<E;++e){
const uint32_t end=uint32_t(groups[e]),me=end-start,mt=(me+TM-1)/TM,tasks=mt*nt;
const uint32_t first=(worker+workers-prefix%workers)%workers;
const bool resident=uint64_t(TM+TN)*kp<=523264;
uint32_t begin=first,limit=tasks,step=workers;
if(resident){
const uint32_t q=tasks/workers,r=tasks%workers;
begin=first*q+Min(first,r);limit=begin+q+(first<r);step=1;
}
for(uint32_t task=begin;task<limit;task+=step){
const uint32_t row=start+(resident?task%mt:task/nt)*TM;
const uint32_t col=(resident?task/mt:task%nt)*TN;
const uint32_t mr=Min(TM,end-row),nr=Min(TN,N-col),np=Up(nr,32),slot=ticket&1;
if(nr!=TN)asc_duplicate_sync(sc,0.0f,TN);
asc_copy_gm2ub_align_sync(sc,scale+uint64_t(e)*N+col,nr*4);
asc_sync_block_wait(8+2*slot);
for(uint32_t micro=0;micro<TM/2;micro+=CHUNK){
const uint32_t local=sub*(TM/2)+micro;
const uint32_t rows=mr>local?Min(Min(CHUNK,TM/2-micro),mr-local):0;
if(rows){
const uint32_t count=rows*TN;
if(np!=TN)asc_duplicate_sync((__ubuf__ int32_t *)z,0,count);
auto src=scratch+(uint64_t(worker)*2+slot)*WORDS+local*TN;
asc_copy_gm2ub_align((__ubuf__ int32_t *)z,src,rows,np*4,0,0,(TN-np)*4,(TN-np)/8);
asc_sync_notify(PIPE_MTE2,PIPE_V,EVENT_ID0);
asc_sync_wait(PIPE_MTE2,PIPE_V,EVENT_ID0);
asc_int322float_rn(z,(__ubuf__ int32_t *)z,count);asc_sync_pipe(PIPE_V);
general_math::Scale(z,sc,rows,TN);
general_math::Gelu(z,u,t,z,out,count);
asc_sync_notify(PIPE_V,PIPE_MTE3,EVENT_ID0);
asc_sync_wait(PIPE_V,PIPE_MTE3,EVENT_ID0);
asc_copy_ub2gm_align(y+uint64_t(row+local)*N+col,out,rows,nr*2,0,0,(TN-Up(nr,16))/16,(N-nr)*2);
asc_sync();
}
}
ffts_cross_core_sync(PIPE_MTE2,0x21ULL|(uint64_t(9+2*slot)<<8));
++ticket;
}
start=end;prefix+=tasks;
}
ffts_cross_core_sync(PIPE_MTE3,0x21ULL|(12ULL<<8));
}
}

template<uint32_t TM,uint32_t TN>
__global__ __mix__(1,2)__attribute__((section(".zzzzzzzzzzz_general_tiles")))
void grouped_matmul_gelu_general_tiles(__gm__ int8_t *x,__gm__ int8_t *w,__gm__ float *scale,
__gm__ int64_t *groups,__gm__ half *y,__gm__ int32_t *scratch,
uint32_t E,uint32_t K,uint32_t N,uint32_t workers,uint64_t sync){
set_ffts_base_addr(sync);asc_init();
if ASC_IS_AIC general_tiles::Cube<TM,TN>(x,w,groups,scratch,E,K,N,workers);
if ASC_IS_AIV general_tiles::Vector<TM,TN>(scale,groups,y,scratch,E,K,N,workers);
asc_sync();
}
namespace general_pack{
template<uint32_t Rows>
__aicore__ inline void Matrix(__gm__ int8_t *src,__gm__ int8_t *dst,
__gm__ int64_t *groups,uint32_t E,uint32_t rows,uint32_t cols,uint32_t paddedRows,
uint32_t paddedCols,uint32_t rank,uint32_t workers,bool grouped){
const uint32_t per=(paddedRows+Rows-1)/Rows,total=E*per;
uint32_t ordinal=0;
set_mov_pad_val(0);
for(uint32_t task=rank;task<total;task+=2*workers){
const uint32_t expert=task/per,row=task%per*Rows;
if(grouped && groups[expert]==(expert?groups[expert-1]:0))continue;
const uint32_t count=dfocus::Min(Rows,paddedRows-row);
const uint32_t valid=row<rows?dfocus::Min(count,rows-row):0,slot=ordinal&1;
auto local=(__ubuf__ int8_t *)uint64_t(slot*65536);
if(ordinal>=2){
if(slot)asc_sync_wait(PIPE_MTE3,PIPE_MTE2,EVENT_ID5);
else asc_sync_wait(PIPE_MTE3,PIPE_MTE2,EVENT_ID4);
}
if(valid<count){
asc_sync();
asc_duplicate_sync((__ubuf__ int32_t *)local,0,count*paddedCols/4);
}
if(valid)asc_copy_gm2ub_align(local,src+(uint64_t(expert)*rows+row)*cols,
valid,cols,0,paddedCols-cols,0,0);
if(slot){
asc_sync_notify(PIPE_MTE2,PIPE_MTE3,EVENT_ID1);
asc_sync_wait(PIPE_MTE2,PIPE_MTE3,EVENT_ID1);
}else{
asc_sync_notify(PIPE_MTE2,PIPE_MTE3,EVENT_ID0);
asc_sync_wait(PIPE_MTE2,PIPE_MTE3,EVENT_ID0);
}
asc_copy_ub2gm_align(dst+(uint64_t(expert)*paddedRows+row)*paddedCols,local,count*paddedCols);
if(slot)asc_sync_notify(PIPE_MTE3,PIPE_MTE2,EVENT_ID5);
else asc_sync_notify(PIPE_MTE3,PIPE_MTE2,EVENT_ID4);
++ordinal;
}
if(ordinal)asc_sync_wait(PIPE_MTE3,PIPE_MTE2,EVENT_ID4);
if(ordinal>=2)asc_sync_wait(PIPE_MTE3,PIPE_MTE2,EVENT_ID5);
asc_sync();
}
}

template<uint32_t TM,uint32_t TN>
__global__ __mix__(1,2)__attribute__((section(".zzzzzzzzzzz_general_pack")))
void grouped_matmul_gelu_general_pack(__gm__ int8_t *x,__gm__ int8_t *w,__gm__ float *scale,
__gm__ int64_t *groups,__gm__ half *y,__gm__ int32_t *scratch,
uint32_t E,uint32_t K,uint32_t N,uint32_t workers,uint64_t sync){
set_ffts_base_addr(sync);asc_init();
const uint32_t kp=dfocus::Up(K,32),np=dfocus::Up(N,32),m=uint32_t(groups[E-1]);
auto xp=K==kp?x:(__gm__ int8_t *)(scratch+uint64_t(workers)*2*TM*TN);
auto wp=(__gm__ int8_t *)(scratch+uint64_t(workers)*2*TM*TN)+(K==kp?0:uint64_t(m)*kp);
if ASC_IS_AIC{
asc_sync_block_wait(0);
general_tiles::Cube<TM,TN>(xp,wp,groups,scratch,E,kp,np,workers);
}
if ASC_IS_AIV{
const uint32_t rank=2*asc_get_block_idx()+asc_get_sub_block_id();
general_pack::Matrix<16>(w,wp,groups,E,K,N,kp,np,rank,workers,true);
if(K!=kp)general_pack::Matrix<8>(x,xp,groups,1,m,K,m,kp,rank,workers,false);
ffts_cross_core_sync(PIPE_MTE3,0x1ULL|(14ULL<<8));
asc_sync_block_wait(14);
ffts_cross_core_sync(PIPE_MTE3,0x21ULL);
general_tiles::Vector<TM,TN>(scale,groups,y,scratch,E,kp,N,workers);
}
asc_sync();
}
__vector__ __global__ __aicore__ __attribute__((section(".zzzzzzzzzzz_general_small_k")))
void grouped_matmul_gelu_general_small_k(__gm__ int8_t *x,__gm__ int8_t *w,__gm__ float *scale,
__gm__ int64_t *groups,__gm__ half *y,uint32_t E,uint32_t K,uint32_t N,uint32_t workers){
asc_init();set_mov_pad_val(0);
constexpr uint32_t TM=16,TN=256;
auto raw=(__ubuf__ int8_t *)0;
auto wr=(__ubuf__ int8_t *)4096;
auto wh=(__ubuf__ half *)8192;
auto wi=(__ubuf__ int32_t *)16384;
auto c=(__ubuf__ int32_t *)32768;
auto temp=(__ubuf__ int32_t *)49152;
auto dense=(__ubuf__ int32_t *)65536;
auto broad=(__ubuf__ int32_t *)65664;
auto sc=(__ubuf__ float *)66560;
auto z=(__ubuf__ float *)c;
auto u=(__ubuf__ float *)81920;
auto t=(__ubuf__ float *)98304;
auto out=(__ubuf__ half *)114688;
const uint32_t worker=asc_get_block_idx(),nt=(N+TN-1)/TN;
uint32_t start=0,prefix=0;
for(uint32_t e=0;e<E;++e){
const uint32_t end=uint32_t(groups[e]),me=end-start,tasks=((me+TM-1)/TM)*nt;
const uint32_t first=(worker+workers-prefix%workers)%workers;
uint32_t previous=~0U;
for(uint32_t task=first;task<tasks;task+=workers){
const uint32_t row=start+task/nt*TM,col=task%nt*TN;
const uint32_t mr=dfocus::Min(TM,end-row),nr=dfocus::Min(TN,N-col),np=dfocus::Up(nr,32);
asc_copy_gm2ub_align(raw,x+uint64_t(row)*K,mr,K,0,32-K,0,0);
asc_sync();
if(col!=previous){
if(nr!=np)asc_duplicate_sync(sc,0.0f,np);
asc_copy_gm2ub_align(wr,w+uint64_t(e)*K*N+col,K,nr,0,np-nr,N-nr,0);
asc_copy_gm2ub_align(sc,scale+uint64_t(e)*N+col,1,nr*4,0,dfocus::Up(nr,8)-nr,0,0);
asc_sync_notify(PIPE_MTE2,PIPE_V,EVENT_ID0);
asc_sync_wait(PIPE_MTE2,PIPE_V,EVENT_ID0);
asc_int82half(wh,wr,K*np);asc_sync_pipe(PIPE_V);
asc_half2int32_rn(wi,wh,K*np);asc_sync_pipe(PIPE_V);
previous=col;
}
asc_duplicate_sync(dense,0,TM);
for(uint32_t k=0;k<K;++k){
asc_sync_notify(PIPE_V,PIPE_S,EVENT_ID1);
asc_sync_wait(PIPE_V,PIPE_S,EVENT_ID1);
for(uint32_t r=0;r<mr;++r)dense[r]=int32_t(raw[r*32+k]);
asc_sync_notify(PIPE_S,PIPE_V,EVENT_ID1);
asc_sync_wait(PIPE_S,PIPE_V,EVENT_ID1);
asc_brcb((__ubuf__ uint32_t *)broad,(__ubuf__ uint32_t *)dense,1,8,uint8_t((mr+7)/8));
asc_sync_pipe(PIPE_V);
auto dst=k?temp:c;
asc_set_mask_norm();
for(uint32_t offset=0;offset<np;offset+=64){
asc_set_vector_mask(0ULL,np-offset>=64?~0ULL:0xffffffffULL);
asc_mul(dst+offset,broad,wi+k*np+offset,uint8_t(mr),1,0,1,np/8,1,0);
}
asc_sync_pipe(PIPE_V);
if(k){asc_add(c,c,temp,mr*np);asc_sync_pipe(PIPE_V);}
}
const uint32_t count=mr*np;
asc_int322float_rn(z,c,count);asc_sync_pipe(PIPE_V);
asc_set_mask_norm();
for(uint32_t offset=0;offset<np;offset+=64){
asc_set_vector_mask(0ULL,np-offset>=64?~0ULL:0xffffffffULL);
asc_mul(z+offset,z+offset,sc+offset,uint8_t(mr),1,1,1,np/8,np/8,0);
}
asc_sync_pipe(PIPE_V);
general_math::Gelu(z,u,t,z,out,count);
asc_sync_notify(PIPE_V,PIPE_MTE3,EVENT_ID0);
asc_sync_wait(PIPE_V,PIPE_MTE3,EVENT_ID0);
asc_copy_ub2gm_align(y+uint64_t(row)*N+col,out,mr,nr*2,0,0,(np-dfocus::Up(nr,16))/16,(N-nr)*2);
asc_sync();
}
start=end;prefix+=tasks;
}
asc_sync();
}

namespace general_small_groups{
using dfocus::Min;using dfocus::Up;using general_tiles::Stage;using general_tiles::Multiply;
template<uint32_t TM,uint32_t TN>
__aicore__ inline void Cube(__gm__ int8_t *x,__gm__ int8_t *w,__gm__ int64_t *groups,
__gm__ int32_t *scratch,uint32_t E,uint32_t K,uint32_t N,uint32_t workers){
constexpr uint32_t TK=512,WORDS=TM*TN;
const uint32_t worker=asc_get_block_idx(),nt=(N+TN-1)/TN,kp=Up(K,32);
auto a1=(__cbuf__ int8_t *)0;
auto a0=(__ca__ int8_t *)0;
auto b0=(__cb__ int8_t *)0;
auto c0=(__cc__ int32_t *)0;
uint32_t ticket=0,start=0,prefix=0;
for(uint32_t e=0;e<E;++e){
const uint32_t end=uint32_t(groups[e]),me=end-start,mt=(me+TM-1)/TM,tasks=mt*nt;
const uint32_t first=(worker+workers-prefix%workers)%workers;
const bool resident=uint64_t(TM+TN)*kp<=523264;
uint32_t begin=first,limit=tasks,step=workers;
if(resident){
const uint32_t q=tasks/workers,r=tasks%workers;
begin=first*q+Min(first,r);limit=begin+q+(first<r);step=1;
}
uint32_t previous=~0U;
for(uint32_t task=begin;task<limit;task+=step){
const uint32_t row=start+(resident?task%mt:task/nt)*TM;
const uint32_t col=(resident?task/mt:task%nt)*TN;
const uint32_t mr=Min(TM,end-row),nr=Min(TN,N-col),mp=Up(mr,16),np=Up(nr,32);
if(resident){
auto b1=a1+TM*kp;
if(mr%16 || K%32)cp6_gmg::ZeroL1(a1,TM*kp);
asc_copy_gm2l1_nd2nz(a1,x+uint64_t(row)*K,1,mr,K,0,K,TM,1,0);
if(col!=previous){
if(nr%32 || K%32)cp6_gmg::ZeroL1(b1,np*kp);
asc_copy_gm2l1_nd2nz(b1,w+uint64_t(e)*K*N+col,1,K,nr,0,N,kp,1,0);
previous=col;
}
asc_sync();
if(np<=128)cp6_gmg::FullKPipeline(a1,b1,a0,b0,c0,TM,mp,np,kp);
else Multiply(a1,b1,a0,b0,c0,TM,mp,np,kp,true);
}else{
constexpr uint32_t SPAN=(TM+TN)*TK;
const uint32_t stages=(K+TK-1)/TK;
Stage<TM,TN>(x,w,a1,e,row,col,mr,nr,np,K,N,0,0);
for(uint32_t stage=0;stage<stages;++stage){
const uint32_t slot=stage&1,k0=stage*TK,padded=Up(Min(TK,K-k0),32);
if(slot)asc_sync_wait(PIPE_MTE2,PIPE_MTE1,EVENT_ID5);
else asc_sync_wait(PIPE_MTE2,PIPE_MTE1,EVENT_ID4);
if(stage+1<stages)
Stage<TM,TN>(x,w,a1,e,row,col,mr,nr,np,K,N,k0+TK,slot^1);
auto aa=a1+slot*SPAN,bb=aa+TM*TK;
Multiply(aa,bb,a0,b0,c0,TM,mp,np,padded,stage==0);
}
}
const uint32_t slot=ticket&1;
if(ticket>=2)asc_sync_block_wait(9+2*slot);
auto dst=scratch+(uint64_t(worker)*2+slot)*WORDS;
asc_set_l0c_copy_params(1,0,0);
asc_copy_l0c2gm_sync(dst,c0,np,mr,TN,mp,0,0,0,false,true);
ffts_cross_core_sync(PIPE_FIX,0x21ULL|(uint64_t(8+2*slot)<<8));
++ticket;
}
start=end;prefix+=tasks;
}
for(uint32_t i=ticket>2?ticket-2:0;i<ticket;++i)asc_sync_block_wait(9+2*(i&1));
asc_sync_block_wait(12);
}

template<uint32_t TM,uint32_t TN>
__aicore__ inline void Vector(__gm__ float *scale,__gm__ int64_t *groups,__gm__ half *y,
__gm__ int32_t *scratch,uint32_t E,uint32_t K,uint32_t N,uint32_t workers){
constexpr uint32_t HALF=TN/2,VQ=TM*HALF,WORDS=TM*TN;
auto z=(__ubuf__ float *)0;
auto u=(__ubuf__ float *)(4*VQ);
auto t=(__ubuf__ float *)(8*VQ);
auto sc=(__ubuf__ float *)(12*VQ);
auto out=(__ubuf__ half *)(12*VQ+4*HALF);
const uint32_t worker=asc_get_block_idx(),sub=asc_get_sub_block_id(),nt=(N+TN-1)/TN,kp=Up(K,32);
uint32_t ticket=0,start=0,prefix=0;
set_mov_pad_val(0);
for(uint32_t e=0;e<E;++e){
const uint32_t end=uint32_t(groups[e]),me=end-start,mt=(me+TM-1)/TM,tasks=mt*nt;
const uint32_t first=(worker+workers-prefix%workers)%workers;
const bool resident=uint64_t(TM+TN)*kp<=523264;
uint32_t begin=first,limit=tasks,step=workers;
if(resident){
const uint32_t q=tasks/workers,r=tasks%workers;
begin=first*q+Min(first,r);limit=begin+q+(first<r);step=1;
}
uint32_t previous=~0U;
for(uint32_t task=begin;task<limit;task+=step){
const uint32_t row=start+(resident?task%mt:task/nt)*TM;
const uint32_t col=(resident?task/mt:task%nt)*TN+sub*HALF;
const uint32_t mr=Min(TM,end-row),nr=col<N?Min(HALF,N-col):0,slot=ticket&1;
if(nr && col!=previous){
if(nr!=HALF)asc_duplicate_sync(sc,0.0f,HALF);
asc_copy_gm2ub_align_sync(sc,scale+uint64_t(e)*N+col,nr*4);
previous=col;
}
asc_sync_block_wait(8+2*slot);
if(nr){
const uint32_t count=mr*HALF,np=Up(nr,8);
if(np!=HALF)asc_duplicate_sync((__ubuf__ int32_t *)z,0,count);
auto src=scratch+(uint64_t(worker)*2+slot)*WORDS+sub*HALF;
asc_copy_gm2ub_align((__ubuf__ int32_t *)z,src,mr,np*4,0,0,(TN-np)*4,(HALF-np)/8);
asc_sync_notify(PIPE_MTE2,PIPE_V,EVENT_ID0);
asc_sync_wait(PIPE_MTE2,PIPE_V,EVENT_ID0);
ffts_cross_core_sync(PIPE_MTE2,0x21ULL|(uint64_t(9+2*slot)<<8));
asc_int322float_rn(z,(__ubuf__ int32_t *)z,count);asc_sync_pipe(PIPE_V);
asc_set_mask_norm();
for(uint32_t offset=0;offset<HALF;offset+=64){
const uint32_t valid=Min(64U,HALF-offset);
asc_set_vector_mask(0ULL,valid==64?~0ULL:(uint64_t(1)<<valid)-1);
asc_mul(z+offset,z+offset,sc+offset,uint8_t(mr),1,1,1,HALF/8,HALF/8,0);
}
asc_sync_pipe(PIPE_V);
general_math::Gelu(z,u,t,z,out,count);
asc_sync_notify(PIPE_V,PIPE_MTE3,EVENT_ID0);
asc_sync_wait(PIPE_V,PIPE_MTE3,EVENT_ID0);
asc_copy_ub2gm_align(y+uint64_t(row)*N+col,out,mr,nr*2,0,0,(HALF-Up(nr,16))/16,(N-nr)*2);
asc_sync();
}else ffts_cross_core_sync(PIPE_MTE2,0x21ULL|(uint64_t(9+2*slot)<<8));
++ticket;
}
start=end;prefix+=tasks;
}
ffts_cross_core_sync(PIPE_MTE3,0x21ULL|(12ULL<<8));
}
}

template<uint32_t TN>
__global__ __mix__(1,2)__attribute__((section(".zzzzzzzzzzz_general_small_groups")))
void grouped_matmul_gelu_general_small_groups(__gm__ int8_t *x,__gm__ int8_t *w,__gm__ float *scale,
__gm__ int64_t *groups,__gm__ half *y,__gm__ int32_t *scratch,
uint32_t E,uint32_t K,uint32_t N,uint32_t workers,uint64_t sync){
set_ffts_base_addr(sync);asc_init();
if ASC_IS_AIC general_small_groups::Cube<32,TN>(x,w,groups,scratch,E,K,N,workers);
if ASC_IS_AIV general_small_groups::Vector<32,TN>(scale,groups,y,scratch,E,K,N,workers);
asc_sync();
}

namespace general_matvec{
using dfocus::Min;using dfocus::Up;

template<uint32_t TM>
__aicore__ inline void FetchX(__gm__ int8_t *x,__cbuf__ int8_t *base,uint32_t row,
uint32_t mr,uint32_t K,uint32_t k0,uint32_t slot){
constexpr uint32_t TK=512;
auto dst=base+slot*TM*TK;
const uint32_t kr=Min(TK,K-k0),kp=Up(kr,32);
if(mr%32 || kr%32)cp6_gmg::ZeroL1(dst,TM*kp);
asc_copy_gm2l1_nd2nz(dst,x+uint64_t(row)*K+k0,1,mr,kr,0,K,TM,1,0);
if(slot)asc_sync_notify(PIPE_MTE2,PIPE_MTE1,EVENT_ID5);
else asc_sync_notify(PIPE_MTE2,PIPE_MTE1,EVENT_ID4);
}

template<uint32_t TM>
__aicore__ inline void Load(__cbuf__ int8_t *wa,__cbuf__ int8_t *xx,__ca__ int8_t *a,
__cb__ int8_t *b,uint32_t np,uint32_t kp,uint32_t globalK,uint32_t lk,uint32_t i){
const uint32_t local=i*lk,k=Min(lk,kp-local),slot=i&1;
auto aa=a+slot*16*lk;
auto bb=b+slot*np*lk;
asc_copy_l12l0a(aa,wa+(globalK+local)*16,0,k/32,1,0);
if(np==TM)
asc_copy_l12l0b(bb,xx+local*TM,0,uint8_t((k/32)*(np/16)),1,0);
else for(uint32_t kk=0;kk<k;kk+=32)
asc_copy_l12l0b(bb+kk*np,xx+(local+kk)*TM,0,np/16,1,0);
dfocus::LR(slot,false);
}

template<uint32_t TM>
__aicore__ inline void Multiply(__cbuf__ int8_t *wa,__cbuf__ int8_t *xx,__ca__ int8_t *a,
__cb__ int8_t *b,__cc__ int32_t *c,uint32_t np,uint32_t kp,uint32_t globalK){
const uint32_t lk=Min(512U,(1024/np)*32),parts=(kp+lk-1)/lk;
Load<TM>(wa,xx,a,b,np,kp,globalK,lk,0);
for(uint32_t i=0;i<parts;++i){
const uint32_t slot=i&1,k=Min(lk,kp-i*lk);
dfocus::LR(slot,true);
asc_mmad_sync(c,a+slot*16*lk,b+slot*np*lk,16,k,np,0,false,false,globalK==0&&i==0);
if(i+2<parts)dfocus::LF(slot,false);
if(i+1<parts){
if(i+1>=2)dfocus::LF((i+1)&1,true);
Load<TM>(wa,xx,a,b,np,kp,globalK,lk,i+1);
}
}
asc_sync();
}

template<uint32_t TM>
__aicore__ inline void Cube(__gm__ int8_t *x,__gm__ int8_t *w,__gm__ int64_t *groups,
__gm__ int32_t *scratch,uint32_t E,uint32_t K,uint32_t workers){
constexpr uint32_t TK=512;
const uint32_t worker=asc_get_block_idx(),kp=Up(K,32),stages=(K+TK-1)/TK;
auto wa=(__cbuf__ int8_t *)0;
auto xx=wa+16*kp;
auto a=(__ca__ int8_t *)0;
auto b=(__cb__ int8_t *)0;
auto c=(__cc__ int32_t *)0;
uint32_t start=0,prefix=0,ticket=0;
for(uint32_t e=0;e<E;++e){
const uint32_t end=uint32_t(groups[e]),me=end-start,tiles=(me+TM-1)/TM;
const uint32_t first=(worker+workers-prefix%workers)%workers;
if(first<tiles){
cp6_gmg::ZeroL1(wa,16*kp);
asc_copy_gm2l1_nd2nz(wa,w+uint64_t(e)*K,1,1,K,0,K,16,1,0);
}
for(uint32_t tile=first;tile<tiles;tile+=workers){
const uint32_t row=start+tile*TM,mr=Min(TM,end-row),np=Up(mr,32);
FetchX<TM>(x,xx,row,mr,K,0,0);
for(uint32_t stage=0;stage<stages;++stage){
const uint32_t slot=stage&1,k0=stage*TK,localK=Up(Min(TK,K-k0),32);
if(slot)asc_sync_wait(PIPE_MTE2,PIPE_MTE1,EVENT_ID5);
else asc_sync_wait(PIPE_MTE2,PIPE_MTE1,EVENT_ID4);
if(stage+1<stages)FetchX<TM>(x,xx,row,mr,K,k0+TK,slot^1);
Multiply<TM>(wa,xx+slot*TM*TK,a,b,c,np,localK,k0);
}
const uint32_t slot=ticket&1;
if(ticket>=2)asc_sync_block_wait(9+2*slot);
asc_set_l0c_copy_params(1,0,0);
asc_copy_l0c2gm_sync(scratch+(uint64_t(worker)*2+slot)*TM,c,np,1,TM,16,0,0,0,false,true);
ffts_cross_core_sync(PIPE_FIX,0x21ULL|(uint64_t(8+2*slot)<<8));
++ticket;
}
start=end;prefix+=tiles;
}
for(uint32_t i=ticket>2?ticket-2:0;i<ticket;++i)asc_sync_block_wait(9+2*(i&1));
asc_sync_block_wait(12);
}

template<uint32_t TM>
__aicore__ inline void Vector(__gm__ float *scale,__gm__ int64_t *groups,__gm__ half *y,
__gm__ int32_t *scratch,uint32_t E,uint32_t workers){
const uint32_t worker=asc_get_block_idx(),sub=asc_get_sub_block_id();
auto z=(__ubuf__ float *)0;
auto u=(__ubuf__ float *)(4*TM);
auto t=(__ubuf__ float *)(8*TM);
auto out=(__ubuf__ half *)(12*TM);
uint32_t start=0,prefix=0,ticket=0;
set_mov_pad_val(0);
for(uint32_t e=0;e<E;++e){
const uint32_t end=uint32_t(groups[e]),me=end-start,tiles=(me+TM-1)/TM;
const uint32_t first=(worker+workers-prefix%workers)%workers;
const float factor=(!sub&&first<tiles)?scale[e]:0.0f;
for(uint32_t tile=first;tile<tiles;tile+=workers){
const uint32_t row=start+tile*TM,mr=Min(TM,end-row),slot=ticket&1,count=Up(mr,8);
asc_sync_block_wait(8+2*slot);
if(!sub){
asc_copy_gm2ub_align((__ubuf__ int32_t *)z,scratch+(uint64_t(worker)*2+slot)*TM,
1,mr*4,0,count-mr,0,0);
asc_sync_notify(PIPE_MTE2,PIPE_V,EVENT_ID0);
asc_sync_wait(PIPE_MTE2,PIPE_V,EVENT_ID0);
ffts_cross_core_sync(PIPE_MTE2,0x21ULL|(uint64_t(9+2*slot)<<8));
asc_int322float_rn(z,(__ubuf__ int32_t *)z,count);asc_sync_pipe(PIPE_V);
asc_mul_scalar(z,z,factor,count);asc_sync_pipe(PIPE_V);
general_math::Gelu(z,u,t,z,out,count);
asc_sync_notify(PIPE_V,PIPE_MTE3,EVENT_ID0);
asc_sync_wait(PIPE_V,PIPE_MTE3,EVENT_ID0);
asc_copy_ub2gm_align(y+row,out,mr*2);asc_sync();
}else ffts_cross_core_sync(PIPE_MTE2,0x21ULL|(uint64_t(9+2*slot)<<8));
++ticket;
}
start=end;prefix+=tiles;
}
ffts_cross_core_sync(PIPE_MTE3,0x21ULL|(12ULL<<8));
}
}

template<uint32_t TM>
__global__ __mix__(1,2)__attribute__((section(".zzzzzzzzzzz_general_matvec")))
void grouped_matmul_gelu_general_matvec(__gm__ int8_t *x,__gm__ int8_t *w,__gm__ float *scale,
__gm__ int64_t *groups,__gm__ half *y,__gm__ int32_t *scratch,
uint32_t E,uint32_t K,uint32_t workers,uint64_t sync){
set_ffts_base_addr(sync);asc_init();
if ASC_IS_AIC general_matvec::Cube<TM>(x,w,groups,scratch,E,K,workers);
if ASC_IS_AIV general_matvec::Vector<TM>(scale,groups,y,scratch,E,workers);
asc_sync();
}

namespace general_small_n{
using dfocus::Min;using dfocus::Up;using general_matvec::FetchX;
__aicore__ inline void Pack(__gm__ int8_t *w,__gm__ int8_t *packed,__gm__ int64_t *groups,
uint32_t E,uint32_t K,uint32_t N,uint32_t workers){
constexpr uint32_t CHUNK=512;
const uint32_t rank=2*asc_get_block_idx()+asc_get_sub_block_id(),kp=Up(K,32),parts=(kp+CHUNK-1)/CHUNK;
auto raw=(__ubuf__ int8_t *)0;
auto values=(__ubuf__ half *)16384;
auto transposed=(__ubuf__ half *)49152;
auto output=(__ubuf__ int8_t *)81920;
auto offsets=(__ubuf__ uint32_t *)98304;
for(uint32_t i=0;i<8;++i)offsets[i]=i*N*2;
asc_sync_notify(PIPE_S,PIPE_V,EVENT_ID1);
asc_sync_wait(PIPE_S,PIPE_V,EVENT_ID1);
for(uint32_t used=8;used<CHUNK;used*=2){
asc_add_scalar((__ubuf__ int32_t *)offsets+used,(__ubuf__ int32_t *)offsets,int32_t(used*N*2),used);
asc_sync_pipe(PIPE_V);
}
for(uint32_t col=1;col<N;++col)
asc_add_scalar((__ubuf__ int32_t *)offsets+col*CHUNK,(__ubuf__ int32_t *)offsets,int32_t(col*2),CHUNK);
asc_sync_pipe(PIPE_V);
set_mov_pad_val(0);
for(uint32_t task=rank;task<E*parts;task+=2*workers){
const uint32_t e=task/parts,k0=task%parts*CHUNK;
if(groups[e]==(e?groups[e-1]:0))continue;
const uint32_t valid=Min(CHUNK,K-k0),stored=Min(CHUNK,kp-k0),bytes=valid*N;
if(valid<CHUNK)asc_duplicate_sync((__ubuf__ int32_t *)raw,0,CHUNK*N/4);
asc_copy_gm2ub_align(raw,w+(uint64_t(e)*K+k0)*N,1,bytes,0,Up(bytes,32)-bytes,0,0);
asc_sync_notify(PIPE_MTE2,PIPE_V,EVENT_ID0);
asc_sync_wait(PIPE_MTE2,PIPE_V,EVENT_ID0);
asc_int82half(values,raw,CHUNK*N);asc_sync_pipe(PIPE_V);
asc_gather(transposed,values,offsets,CHUNK*N);asc_sync_pipe(PIPE_V);
asc_half2int8(output,transposed,CHUNK*N);asc_sync_pipe(PIPE_V);
asc_sync_notify(PIPE_V,PIPE_MTE3,EVENT_ID0);
asc_sync_wait(PIPE_V,PIPE_MTE3,EVENT_ID0);
asc_copy_ub2gm_align(packed+uint64_t(e)*N*kp+k0,output,N,stored,0,0,(CHUNK-stored)/32,kp-stored);
asc_sync();
}
}

template<uint32_t TM>
__aicore__ inline void Load(__cbuf__ int8_t *wa,__cbuf__ int8_t *xx,__ca__ int8_t *a,
__cb__ int8_t *b,uint32_t np,uint32_t kp,uint32_t globalK,uint32_t lk,uint32_t i,uint32_t mp){
const uint32_t local=i*lk,k=Min(lk,kp-local),slot=i&1;
auto aa=a+slot*mp*lk;
auto bb=b+slot*np*lk;
for(uint32_t mi=0;mi<mp/16;++mi)
asc_copy_l12l0a(aa+mi*k*16,wa+(globalK+local)*mp+mi*512,0,k/32,mp/16,0);
if(np==TM)
asc_copy_l12l0b(bb,xx+local*TM,0,uint8_t((k/32)*(np/16)),1,0);
else for(uint32_t kk=0;kk<k;kk+=32)
asc_copy_l12l0b(bb+kk*np,xx+(local+kk)*TM,0,np/16,1,0);
dfocus::LR(slot,false);
}

template<uint32_t TM>
__aicore__ inline void Multiply(__cbuf__ int8_t *wa,__cbuf__ int8_t *xx,__ca__ int8_t *a,
__cb__ int8_t *b,__cc__ int32_t *c,uint32_t np,uint32_t kp,uint32_t globalK,uint32_t mp){
const uint32_t width=mp>np?mp:np,lk=Min(512U,(1024/width)*32),parts=(kp+lk-1)/lk;
Load<TM>(wa,xx,a,b,np,kp,globalK,lk,0,mp);
for(uint32_t i=0;i<parts;++i){
const uint32_t slot=i&1,k=Min(lk,kp-i*lk);
dfocus::LR(slot,true);
asc_mmad_sync(c,a+slot*mp*lk,b+slot*np*lk,mp,k,np,0,false,false,globalK==0&&i==0);
if(i+2<parts)dfocus::LF(slot,false);
if(i+1<parts){
if(i+1>=2)dfocus::LF((i+1)&1,true);
Load<TM>(wa,xx,a,b,np,kp,globalK,lk,i+1,mp);
}
}
asc_sync();
}

template<uint32_t TM>
__aicore__ inline void Cube(__gm__ int8_t *x,__gm__ int8_t *w,__gm__ int64_t *groups,
__gm__ int32_t *scratch,uint32_t E,uint32_t K,uint32_t N,uint32_t workers){
constexpr uint32_t TK=512;
const uint32_t worker=asc_get_block_idx(),kp=Up(K,32),mp=Up(N,16),stages=(K+TK-1)/TK;
auto wa=(__cbuf__ int8_t *)0;
auto xx=wa+mp*kp;
auto a=(__ca__ int8_t *)0;
auto b=(__cb__ int8_t *)0;
auto c=(__cc__ int32_t *)0;
uint32_t start=0,prefix=0,ticket=0;
for(uint32_t e=0;e<E;++e){
const uint32_t end=uint32_t(groups[e]),me=end-start,tiles=(me+TM-1)/TM;
const uint32_t first=(worker+workers-prefix%workers)%workers;
if(first<tiles){
cp6_gmg::ZeroL1(wa,mp*kp);
asc_copy_gm2l1_nd2nz(wa,w+uint64_t(e)*N*kp,1,N,kp,0,kp,mp,1,0);
}
for(uint32_t tile=first;tile<tiles;tile+=workers){
const uint32_t row=start+tile*TM,mr=Min(TM,end-row),np=Up(mr,32);
FetchX<TM>(x,xx,row,mr,K,0,0);
for(uint32_t stage=0;stage<stages;++stage){
const uint32_t slot=stage&1,k0=stage*TK,localK=Up(Min(TK,K-k0),32);
if(slot)asc_sync_wait(PIPE_MTE2,PIPE_MTE1,EVENT_ID5);
else asc_sync_wait(PIPE_MTE2,PIPE_MTE1,EVENT_ID4);
if(stage+1<stages)FetchX<TM>(x,xx,row,mr,K,k0+TK,slot^1);
Multiply<TM>(wa,xx+slot*TM*TK,a,b,c,np,localK,k0,mp);
}
const uint32_t slot=ticket&1;
if(ticket>=2)asc_sync_block_wait(9+2*slot);
asc_set_l0c_copy_params(1,0,0);
asc_copy_l0c2gm_sync(scratch+(uint64_t(worker)*2+slot)*TM*N,c,np,N,TM,mp,0,0,0,false,true);
ffts_cross_core_sync(PIPE_FIX,0x21ULL|(uint64_t(8+2*slot)<<8));
++ticket;
}
start=end;prefix+=tiles;
}
for(uint32_t i=ticket>2?ticket-2:0;i<ticket;++i)asc_sync_block_wait(9+2*(i&1));
asc_sync_block_wait(12);
}

template<uint32_t TM>
__aicore__ inline void Vector(__gm__ float *scale,__gm__ int64_t *groups,__gm__ half *y,
__gm__ int32_t *scratch,uint32_t E,uint32_t N,uint32_t workers){
const uint32_t worker=asc_get_block_idx(),sub=asc_get_sub_block_id(),words=TM*N;
auto z=(__ubuf__ float *)0;
auto u=(__ubuf__ float *)32768;
auto t=(__ubuf__ float *)65536;
auto output=(__ubuf__ half *)98304;
auto offsets=(__ubuf__ uint32_t *)163840;
auto packed=(__ubuf__ half *)180224;
auto scales=(__ubuf__ float *)114688;
uint32_t previousRows=0;
uint32_t start=0,prefix=0,ticket=0;
set_mov_pad_val(0);
for(uint32_t e=0;e<E;++e){
const uint32_t end=uint32_t(groups[e]),me=end-start,tiles=(me+TM-1)/TM;
const uint32_t first=(worker+workers-prefix%workers)%workers;
if(!sub && first<tiles)asc_copy_gm2ub_align_sync(scales,scale+uint64_t(e)*N,N*4);
for(uint32_t tile=first;tile<tiles;tile+=workers){
const uint32_t row=start+tile*TM,mr=Min(TM,end-row),slot=ticket&1,np=Up(mr,8);
asc_sync_block_wait(8+2*slot);
if(!sub){
if(mr!=previousRows){
for(uint32_t r=0;r<mr;++r)
for(uint32_t col=0;col<N;++col)offsets[r*N+col]=2*(col*np+r);
asc_sync_notify(PIPE_S,PIPE_V,EVENT_ID1);
asc_sync_wait(PIPE_S,PIPE_V,EVENT_ID1);
previousRows=mr;
}
asc_copy_gm2ub_align((__ubuf__ int32_t *)z,scratch+(uint64_t(worker)*2+slot)*words,
N,np*4,0,0,(TM-np)*4,0);
asc_sync_notify(PIPE_MTE2,PIPE_V,EVENT_ID0);
asc_sync_wait(PIPE_MTE2,PIPE_V,EVENT_ID0);
ffts_cross_core_sync(PIPE_MTE2,0x21ULL|(uint64_t(9+2*slot)<<8));
asc_int322float_rn(z,(__ubuf__ int32_t *)z,np*N);asc_sync_pipe(PIPE_V);
asc_sync_notify(PIPE_MTE2,PIPE_S,EVENT_ID1);
asc_sync_wait(PIPE_MTE2,PIPE_S,EVENT_ID1);
for(uint32_t col=0;col<N;++col)asc_mul_scalar(z+col*np,z+col*np,scales[col],np);
asc_sync_pipe(PIPE_V);
general_math::Gelu(z,u,t,z,output,np*N);
asc_gather(packed,output,offsets,mr*N);asc_sync_pipe(PIPE_V);
asc_sync_notify(PIPE_V,PIPE_MTE3,EVENT_ID0);
asc_sync_wait(PIPE_V,PIPE_MTE3,EVENT_ID0);
asc_copy_ub2gm_align(y+uint64_t(row)*N,packed,mr*N*2);asc_sync();
}else ffts_cross_core_sync(PIPE_MTE2,0x21ULL|(uint64_t(9+2*slot)<<8));
++ticket;
}
start=end;prefix+=tiles;
}
ffts_cross_core_sync(PIPE_MTE3,0x21ULL|(12ULL<<8));
}
}

template<uint32_t TM>
__global__ __mix__(1,2)__attribute__((section(".zzzzzzzzzzz_general_small_n")))
void grouped_matmul_gelu_general_small_n(__gm__ int8_t *x,__gm__ int8_t *w,__gm__ float *scale,
__gm__ int64_t *groups,__gm__ half *y,__gm__ int32_t *scratch,
uint32_t E,uint32_t K,uint32_t N,uint32_t workers,uint64_t sync){
set_ffts_base_addr(sync);asc_init();
auto packed=(__gm__ int8_t *)(scratch+uint64_t(workers)*2*TM*N);
if ASC_IS_AIC{
asc_sync_block_wait(0);
general_small_n::Cube<TM>(x,packed,groups,scratch,E,K,N,workers);
}
if ASC_IS_AIV{
general_small_n::Pack(w,packed,groups,E,K,N,workers);
ffts_cross_core_sync(PIPE_MTE3,0x1ULL|(14ULL<<8));
asc_sync_block_wait(14);
ffts_cross_core_sync(PIPE_MTE3,0x21ULL);
general_small_n::Vector<TM>(scale,groups,y,scratch,E,N,workers);
}
asc_sync();
}




template<uint32_t TM,uint32_t TN>
__global__ __mix__(1,2) __attribute__((section(".zzzzzzzzzzz_general_npack")))
void grouped_matmul_gelu_general_npack(__gm__ int8_t *x,__gm__ int8_t *w,__gm__ float *scale,
 __gm__ int64_t *groups,__gm__ half *y,__gm__ int32_t *scratch,
 uint32_t E,uint32_t K,uint32_t N,uint32_t workers,uint64_t sync){
 set_ffts_base_addr(sync);asc_init();
 const uint32_t np=dfocus::Up(N,32);
 auto wp=(__gm__ int8_t *)(scratch+uint64_t(workers)*2*TM*TN);
 if ASC_IS_AIC {
  asc_sync_block_wait(0);
  general_tiles::Cube<TM,TN>(x,wp,groups,scratch,E,K,np,workers);
 }
 if ASC_IS_AIV {
  const uint32_t rank=2*asc_get_block_idx()+asc_get_sub_block_id();
  general_pack::Matrix<16>(w,wp,groups,E,K,N,K,np,rank,workers,true);
  ffts_cross_core_sync(PIPE_MTE3,0x1ULL|(14ULL<<8));
  asc_sync_block_wait(14);
  ffts_cross_core_sync(PIPE_MTE3,0x21ULL);
  general_tiles::Vector<TM,TN>(scale,groups,y,scratch,E,K,N,workers);
 }
 asc_sync();
}
namespace {

enum class Kernel{
Base,
SmallGroups,
Aligned,
Tail,
Scalar,
SingleProduct,
SmallPairs,
SmallRows,
SmallRowDot,
FullRowTile,
SplitRowTile,
LocalWide,
GroupedWide,
LocalResident,
GroupedResident,
LocalStream,
ShortK,
MidPanels,
LargePanels,
PackedRows,
LongK,
PaddedLongK,
PackedWaves,
DirectWide,
DirectNarrow,
NarrowPanels,
StreamPanels,
WidePanels,
ExpertWaves,
ExpertStream,
OwnedMidAlignedW,
OwnedLargeAlignedW
,
GeneralAligned,
GeneralTail,
GeneralTiles,
GeneralPacked,
GeneralSmallK,
GeneralSmallGroups,
GeneralMatvec,
GeneralSmallN
,
GeneralNPacked
};

struct Plan{
Kernel kernel;
uint32_t blocks;
size_t workspace;
uint32_t config = 0;
bool flag = false;
};

uint32_t CeilDiv(uint32_t value,uint32_t divisor){return(value + divisor - 1)/ divisor;}

bool AverageRowsInRange(uint32_t rows,uint32_t experts,uint32_t tileRows){
return rows >= experts * tileRows / 2 && rows <= experts * tileRows * 3 / 2;
}

Plan SelectPlan(uint32_t m,uint32_t k,uint32_t n,uint32_t e,uint32_t cores,uint32_t vectorCores,
platform_ascendc::PlatformAscendC &platform,uint64_t &l1,GM_ADDR y){
// A pair owns two consecutive outputs, or a row is split into 3 and 2 columns.
if(m == 1 && k == 1 && n == 1 && e <= 8)
return{Kernel::SingleProduct,1,0};
if(m == 1 && n == 1 && k <= 4)
return{Kernel::Scalar,1,0};
if(k == 3 && n == 5 && m * n <= 255){
const uint32_t pairs = m * n / 2;
if(m % 2 == 0 && pairs <= vectorCores &&(uint64_t(y)& 3U)== 0)
return{Kernel::SmallPairs,pairs,0};
if(2 * m <= vectorCores)
return{Kernel::SmallRows,2 * m,0};
}

if(k >= 2 && k <= 4 && n == 5 && m <= vectorCores)
return{Kernel::SmallRowDot,m,0};

using platform_ascendc::CoreMemType;
uint64_t ub = 0,l0b = 0,l0c = 0;
platform.GetCoreMemSize(CoreMemType::UB,ub);
platform.GetCoreMemSize(CoreMemType::L1,l1);
platform.GetCoreMemSize(CoreMemType::L0_B,l0b);
platform.GetCoreMemSize(CoreMemType::L0_C,l0c);
const bool fullLocalMemory = ub >= 196352 && l1 >= 458752 && l0b >= 65536 && l0c >= 131072;
if(fullLocalMemory && e == 1 && m <= 64 && k <= 128 && n <= 128){
// For one expert, the valid endpoint is M. Use full or ragged row tiles.
if(k == 128 && n == 128 && m % 32 == 0 && cores >= m / 32)
return{Kernel::FullRowTile,m / 32,size_t(m)* n * sizeof(int32_t)};
if(m > 32 && k > 64 && n > 64 && cores >= 4)
return{Kernel::SplitRowTile,4,4 * 8192,0,true};
}

const bool aligned = k >= 256 && k % 32 == 0 && n % 32 == 0 && m > 32 * e;
const size_t cTile = 64 * 128 * sizeof(int32_t);
const size_t perCore = size_t(cores)* cTile;
const size_t packedWeights = size_t(e)* CeilDiv(k,32)* 32 * CeilDiv(n,32)* 32;
if(fullLocalMemory && l1 >= 524032 && aligned){
// K/N select the resident layouts. Work is divided by the actual expert endpoints.
if(k == 2048 && n == 1024 && e <= 16 && e <= cores && AverageRowsInRange(m,e,64))
return{Kernel::LocalWide,e,size_t(e)* 131072};
if(k >= 1792 && k <= 2304 && n >= 512 && n <= 1536 && n % 512 == 0 && AverageRowsInRange(m,e,64))
return{Kernel::GroupedWide,cores,size_t(cores)* 131072};
if(k == 1024 && n == 1024 && 2 * e <= cores && AverageRowsInRange(m,e,128))
return{Kernel::LocalResident,2 * e,size_t(2 * e)* 131072};
// The panel ownership schedules have fixed expert counts and 20 Cube workers.
if(cores == 20 && n == 768 && AverageRowsInRange(m,e,64)){
if(e == 32 && k > 768 && k <= 1024)
return{Kernel::MidPanels,cores,size_t(cores)*(163840 + 32)};
if(e == 64 && k > 256 && k <= 512)
return{Kernel::LargePanels,cores,size_t(cores)*(135168 + 32)};
}
if(k >= 768 && k <= 1280 && n >= 768 && n <= 1280 && n % 256 == 0 && AverageRowsInRange(m,e,128))
return{Kernel::GroupedResident,cores,size_t(cores)* 131072};
if(k == 2048 && n == 768 && e <= 16 && e <= cores && AverageRowsInRange(m,e,128))
return{Kernel::LocalStream,e,size_t(e)* 131072};
if(k == 256 && n == 256 && e >= cores && m >= 64 * e && m <= 96 * e){
// Amortize the smaller core budget over at least six 80-row waves.
const uint32_t rowWaves = CeilDiv(CeilDiv(m,80),cores);
const uint32_t shortWorkers = cores;
return{Kernel::ShortK,shortWorkers,size_t(shortWorkers)* 163840};
}
}

if(fullLocalMemory && m > 32 * e){
if(k > 8192 - 256 && n > 512 && n <= 544){
const size_t ragged = size_t(cores)* 131072 +(size_t(m)+ size_t(e)* CeilDiv(n,128)* 128)* 8192;
if(e == 3 && cores >= 18 && l1 >= 524032){
const size_t packed = size_t(cores)* 245760 + size_t(m + 31 * e)* 8192 + size_t(e)* 8192 * 544;
return{Kernel::LongK,cores,packed > ragged ? packed : ragged,0,n % 16 != 0};
}
return{Kernel::PaddedLongK,cores,ragged};
}
// The packed-row cursor uses three column tiles. Keep all three nonempty.
if(!aligned && k > 512 && k <= 576 && n > 384 && n <= 416 && cores >= 20)
return{Kernel::PackedRows,cores,size_t(cores)* 262144 + packedWeights};

const bool widePacking = k >= 1024 && k <= 1088 && n > 768 && n <= 1056;
const bool longExpertPacking = aligned && k >= 960 && k <= 1024 && n == 768 && m >= 256 * e;
if(e >= 2 &&(widePacking || longExpertPacking)&& cores >= 20 && l1 >= 520192){
if((n % 16 == 0 &&(aligned || n > 800 || m > 128 * e))||(n > 1024 && n % 4 == 0))
return{Kernel::PackedWaves,cores,size_t(cores)* 245760 + packedWeights,0,aligned};
if(!aligned && n > 1024)
return{Kernel::DirectWide,cores,size_t(cores)* 245760};
if(!aligned && n <= 800 && m >= 128 * e)
return{Kernel::DirectNarrow,cores,size_t(cores)* 245760};
}

if(!aligned && k > 960 && k <= 1024 && n > 736 && n <= 768){
if(cores >= 20 && l1 >= 524032 &&(n % 16 != 0 || n % 32 == 16))
return{Kernel::NarrowPanels,cores,size_t(cores)* 262144 + packedWeights};
const size_t stride = n < 768 && k <= 976 ? 196608 : 131072;
return{Kernel::StreamPanels,cores,size_t(cores)* stride};
}
if(!aligned && k > 1024 && k <= 1088 && n > 1024 && n <= 1056){
const size_t stride = k <= 1055 && n <= 1032 ? 196608 : 131072;
return{Kernel::WidePanels,cores,size_t(cores)* stride,0,l1 >= 524032};
}
if(!aligned && k > 1024 && k <= 1088 && n > 768 && n <= 800 && m <= 128 * e && l1 >= 485376){
if(e >= 2 && cores >= 20 && n % 16 == 0 && l1 >= 516096)
return{Kernel::ExpertWaves,cores,size_t(cores)* 245760 + packedWeights};
const bool wide = n % 16 != 0 && l1 >= 516096;
return{Kernel::ExpertStream,cores,size_t(cores)*(wide ? 245760 : 221184),wide ? 320U : 288U};
}
}

if(aligned){
const bool fast = n > 128 ||(k >= 2048 &&(m <= 128 * e || k >= 4096));
const bool deep = !fast && CeilDiv(m,64)+ e - 1 > cores;
const uint32_t cfg = n |(1U << 31)|(uint32_t(fast)<< 30)|(uint32_t(deep)<< 29);
return{Kernel::Aligned,cores,perCore *(deep ? 2 : 1),cfg};
}
if(m <= 32 * e && k > 128)
return{Kernel::SmallGroups,cores,perCore};

const bool vector = k == 1 && n == 1;
const bool pipe = n > 32 && uint64_t(CeilDiv(m,64))* CeilDiv(n,128)> cores;
const bool panel = k >= 1024 &&(n <= 64 || k <= 3072);
if(vector ||(m > 32 * e && n > 32 &&(pipe || panel))){
const uint32_t nLog = vector ? 0 : n <= 32 ? 5 : n <= 64 ? 6 : 7;
const uint32_t mLog = vector ? 11 : n <= 32 ? 8 : 6;
const bool cache = !vector &&(n <= 32 || CeilDiv(k,32)* 32 <=(n <= 64 ? 6144U : 3072U));
const uint32_t cfg = e |(nLog << 8)|(mLog << 12)| 0x80000000U |(uint32_t(pipe)<< 30)|
(uint32_t(vector)<< 29)|(uint32_t(cache)<< 28);
const size_t bytes = vector ? 0 :(size_t(cores)<<(nLog + mLog))* sizeof(int32_t)*(pipe ? 2 : 1);
return{Kernel::Tail,cores,bytes,cfg};
}

const uint32_t nonempty = m < e ? m : e;
const uint32_t maxTiles =(nonempty +(m - nonempty)/ 64)* CeilDiv(n,128);
const uint32_t blocks = cores < maxTiles ? cores : maxTiles;
return{Kernel::Base,blocks,size_t(blocks)* cTile};
}

Plan SelectGeneralPlan(Plan previous,uint32_t m,uint32_t k,uint32_t n,uint32_t e,
uint32_t cores,uint32_t vectors,platform_ascendc::PlatformAscendC &platform,uint64_t l1){
if(previous.kernel!=Kernel::Base && previous.kernel!=Kernel::SmallGroups &&
previous.kernel!=Kernel::Aligned && previous.kernel!=Kernel::Tail)return previous;
using platform_ascendc::CoreMemType;
uint64_t ub=0,l0b=0,l0c=0;
platform.GetCoreMemSize(CoreMemType::UB,ub);
platform.GetCoreMemSize(CoreMemType::L0_B,l0b);
platform.GetCoreMemSize(CoreMemType::L0_C,l0c);
if(ub<196352 || l1<524032 || l0b<65536 || l0c<131072)return previous;
if(n>1 && n<=32 &&((n<=16 &&(k>=256 || uint64_t(m)*n>=512))||
(n>16 &&(k>=1024 || uint64_t(m)*n>=2048)))){
const uint32_t rows=m<=32*e?32:m<=64*e?64:128,kp=CeilDiv(k,32)*32;
return{Kernel::GeneralSmallN,cores,size_t(cores)*2*rows*n*sizeof(int32_t)+size_t(e)*n*kp,rows};
}
if(n==1 && k>=17){
const uint32_t rows=m<=32*e?32:m<=64*e?64:128;
return{Kernel::GeneralMatvec,cores,size_t(cores)*2*rows*sizeof(int32_t),rows};
}
if(m<=32*e && k>=17 && k<=6144){
const uint32_t kp=CeilDiv(k,32)*32;
uint32_t cols=n>128?256:n>64?128:n>32?64:32;
while(cols>32 && uint64_t(32+cols)*kp>523264)cols/=2;
const uint32_t active=m<e?m:e,jobs=(active+(m-active)/32)*CeilDiv(n,cols);
const uint32_t workers=cores<jobs?cores:jobs;
return{Kernel::GeneralSmallGroups,workers,size_t(workers)*2*32*cols*sizeof(int32_t),cols};
}
if(k<=16 && !(k==1&&n==1)&&(m<=32*e || uint64_t(m)*n*k<=65536)){
const uint32_t active=m<e?m:e,tasks=(active+(m-active)/16)*CeilDiv(n,256);
return{Kernel::GeneralSmallK,vectors<tasks?vectors:tasks,0};
}
if(m>32*e && k<=16 && n>=128){
const uint32_t kp=CeilDiv(k,32)*32,np=CeilDiv(n,32)*32;
const size_t bytes=size_t(cores)*2*128*256*sizeof(int32_t)+size_t(m)*kp+size_t(e)*kp*np;
return{Kernel::GeneralPacked,cores,bytes};
}
if(m>32*e && k>=32){
uint32_t rows=128,cols=256;
if(n<=32){rows=k<=1536?256:128;cols=32;}
else if(n<=64){rows=256;cols=64;}
else if(n<=128 ||((k%32 || n%32)&& k>=1024))cols=128;
if(m>128*e && m<=256*e && n>128 && n%256 && k>=1024 && CeilDiv(n,128)*e>=cores){
rows=256;cols=128;
}
const uint32_t alignedK=CeilDiv(k,32)*32;
uint32_t nr=rows,nc=cols;
if(n>64){nr=256;nc=128;}
else if(n>32){nr=512;nc=64;}
if(uint64_t(CeilDiv(m,nr))*CeilDiv(n,nc)>=cores &&
(uint64_t(rows+cols)*alignedK>523264 || uint64_t(nr+nc)*alignedK<=523264)){
rows=nr;cols=nc;
}
if(n>=128 && n%32 && k>=256 && m>=64*e){
 const uint32_t paddedN=CeilDiv(n,32)*32;
 const size_t bytes=size_t(cores)*2*rows*cols*sizeof(int32_t)+size_t(e)*k*paddedN;
 return{Kernel::GeneralNPacked,cores,bytes,(rows<<16)|cols};
}
return{Kernel::GeneralTiles,cores,size_t(cores)*2*rows*cols*sizeof(int32_t),(rows<<16)|cols};
}
if(k>=32 && k%32==0 && n%32==0){
const bool fast=n>128 ||(k>=2048 &&(m<=128*e || k>=4096));
const bool deep=!fast && CeilDiv(m,64)+e-1>cores;
const uint32_t cfg=n|(1U<<31)|(uint32_t(fast)<<30)|(uint32_t(deep)<<29);
return{Kernel::GeneralAligned,cores,size_t(cores)*64*128*sizeof(int32_t)*(deep?2:1),cfg};
}
const bool vector=k==1 && n==1;
const uint32_t nl=vector?0:n<=32?5:n<=64?6:7;
const uint32_t ml=vector?11:m<=32*e?4:n<=32?8:6;
const uint32_t tm=1U<<ml,tn=1U<<nl,active=m<e?m:e;
const uint32_t jobs=(active+(m-active)/tm)*CeilDiv(n,tn),workers=cores<jobs?cores:jobs;
const bool pipe=!vector&&jobs>workers;
const uint32_t bk=tn==32?(k<=128?128:256):k<256?256:tn==64?1024:512;
const bool cache=!vector&&uint64_t(CeilDiv(k,32))*32*tn+tm*bk+1024<=l1;
const uint32_t cfg=e|(nl<<8)|(ml<<12)|0x80000000U|(uint32_t(pipe)<<30)|
(uint32_t(vector)<<29)|(uint32_t(cache)<<28);
return{Kernel::GeneralTail,workers,vector?0:size_t(workers)*tm*tn*sizeof(int32_t)*(pipe?2:1),cfg};
}

}// namespace

extern "C" __attribute__((visibility("protected"))) void run_kernel(GM_ADDR x, const TensorGroupInfo &info_x,
	GM_ADDR weight, const TensorGroupInfo &info_weight, GM_ADDR scale, const TensorGroupInfo &info_scale,
	GM_ADDR group_list, const TensorGroupInfo &info_group_list, GM_ADDR y, const TensorGroupInfo &info_y,
	int64_t availableCoreNum, aclrtStream stream) {
const int64_t rows = info_x.tensors[0].shape[0],reduction = info_x.tensors[0].shape[1];
const int64_t experts = info_weight.tensors[0].shape[0],columns = info_weight.tensors[0].shape[2];
if(rows < 1 || rows > 65536 || reduction < 1 || reduction > 8192 || experts < 1 || experts > 128 || columns < 1 ||
columns > 4096)
throw std::runtime_error("GroupedMatmulGelu: invalid shape");

auto *platform = platform_ascendc::PlatformAscendCManager::GetInstance();
if(!platform || availableCoreNum <= 0)
throw std::runtime_error("GroupedMatmulGelu: no available cores");

const int64_t cubeCores = platform->GetCoreNumAic();
const int64_t aivCores = platform->GetCoreNumAiv();
const uint32_t cores = uint32_t(availableCoreNum < cubeCores ? availableCoreNum : cubeCores);
const uint32_t vectorCores = uint32_t(availableCoreNum < aivCores ? availableCoreNum : aivCores);
if(!cores)
throw std::runtime_error("GroupedMatmulGelu: no Cube cores");

uint64_t l1 = 0;
const uint32_t m = uint32_t(rows),k = uint32_t(reduction);
const uint32_t n = uint32_t(columns),e = uint32_t(experts);
Plan plan = SelectPlan(m,k,n,e,cores,vectorCores,*platform,l1,y);
if((uint64_t(weight)& 255ULL)!= 0){
if(plan.kernel == Kernel::MidPanels){
plan.kernel = Kernel::OwnedMidAlignedW;
plan.workspace += 511 + size_t(e)* k * n;
}else if(plan.kernel == Kernel::LargePanels &&(uint64_t(weight)& 127ULL)!= 0){
plan.kernel = Kernel::OwnedLargeAlignedW;
plan.workspace += 511 + size_t(e)* k * n;
}
}

plan = SelectGeneralPlan(plan,m,k,n,e,cores,vectorCores,*platform,l1);
const uint32_t blocks = plan.blocks;
uint64_t sync = 0;
uint32_t syncLength = 0;
const bool mixed = plan.kernel != Kernel::Scalar && plan.kernel != Kernel::SingleProduct &&
plan.kernel != Kernel::SmallPairs && plan.kernel != Kernel::SmallRows && plan.kernel != Kernel::SmallRowDot && plan.kernel != Kernel::GeneralSmallK;
if(mixed &&(rtGetC2cCtrlAddr(&sync,&syncLength)!= 0 || sync == 0))
throw std::runtime_error("GroupedMatmulGelu: synchronization configuration failed");

void *scratch = nullptr;
if(plan.workspace && aclrtMalloc(&scratch,plan.workspace,ACL_MEM_MALLOC_HUGE_FIRST)!= ACL_SUCCESS)
throw std::runtime_error("GroupedMatmulGelu: workspace allocation failed");

auto *input =(__gm__ int8_t *)x;
auto *weights =(__gm__ int8_t *)weight;
auto *scales =(__gm__ float *)scale;
auto *groups =(__gm__ int64_t *)group_list;
auto *output =(__gm__ half *)y;
auto *workspace =(__gm__ int32_t *)scratch;
switch(plan.kernel){
case Kernel::GeneralSmallN:
if(plan.config==32)
grouped_matmul_gelu_general_small_n<32><<<blocks,nullptr,stream>>>(input,weights,scales,groups,output,workspace,e,k,n,blocks,sync);
else if(plan.config==64)
grouped_matmul_gelu_general_small_n<64><<<blocks,nullptr,stream>>>(input,weights,scales,groups,output,workspace,e,k,n,blocks,sync);
else
grouped_matmul_gelu_general_small_n<128><<<blocks,nullptr,stream>>>(input,weights,scales,groups,output,workspace,e,k,n,blocks,sync);
break;

case Kernel::GeneralMatvec:
if(plan.config==32)
grouped_matmul_gelu_general_matvec<32><<<blocks,nullptr,stream>>>(input,weights,scales,groups,output,workspace,e,k,blocks,sync);
else if(plan.config==64)
grouped_matmul_gelu_general_matvec<64><<<blocks,nullptr,stream>>>(input,weights,scales,groups,output,workspace,e,k,blocks,sync);
else
grouped_matmul_gelu_general_matvec<128><<<blocks,nullptr,stream>>>(input,weights,scales,groups,output,workspace,e,k,blocks,sync);
break;

case Kernel::GeneralSmallGroups:
if(plan.config==256)
grouped_matmul_gelu_general_small_groups<256><<<blocks,nullptr,stream>>>(input,weights,scales,groups,output,workspace,e,k,n,blocks,sync);
else if(plan.config==128)
grouped_matmul_gelu_general_small_groups<128><<<blocks,nullptr,stream>>>(input,weights,scales,groups,output,workspace,e,k,n,blocks,sync);
else if(plan.config==64)
grouped_matmul_gelu_general_small_groups<64><<<blocks,nullptr,stream>>>(input,weights,scales,groups,output,workspace,e,k,n,blocks,sync);
else
grouped_matmul_gelu_general_small_groups<32><<<blocks,nullptr,stream>>>(input,weights,scales,groups,output,workspace,e,k,n,blocks,sync);
break;

case Kernel::GeneralSmallK:
grouped_matmul_gelu_general_small_k<<<blocks,nullptr,stream>>>(input,weights,scales,groups,output,e,k,n,blocks);
break;
case Kernel::GeneralPacked:
grouped_matmul_gelu_general_pack<128,256><<<blocks,nullptr,stream>>>(input,weights,scales,groups,output,workspace,e,k,n,blocks,sync);
break;
case Kernel::GeneralAligned:
grouped_matmul_gelu_general_aligned<<<blocks,nullptr,stream>>>(input,weights,scales,groups,output,workspace,e,k,plan.config,blocks,sync);
break;
case Kernel::GeneralTail:
grouped_matmul_gelu_general_tail<<<blocks,nullptr,stream>>>(input,weights,scales,groups,output,workspace,plan.config,k,n,blocks,sync);
break;
case Kernel::GeneralNPacked:
 if(plan.config==((256U<<16)|128U))
 grouped_matmul_gelu_general_npack<256,128><<<blocks,nullptr,stream>>>(input,weights,scales,groups,output,workspace,e,k,n,blocks,sync);
 else if(plan.config==((128U<<16)|128U))
 grouped_matmul_gelu_general_npack<128,128><<<blocks,nullptr,stream>>>(input,weights,scales,groups,output,workspace,e,k,n,blocks,sync);
 else
 grouped_matmul_gelu_general_npack<128,256><<<blocks,nullptr,stream>>>(input,weights,scales,groups,output,workspace,e,k,n,blocks,sync);
 break;
case Kernel::GeneralTiles:

if(plan.config==((512U<<16)|64U))
grouped_matmul_gelu_general_tiles<512,64><<<blocks,nullptr,stream>>>(input,weights,scales,groups,output,workspace,e,k,n,blocks,sync);
else if(plan.config==((256U<<16)|32U))
grouped_matmul_gelu_general_tiles<256,32><<<blocks,nullptr,stream>>>(input,weights,scales,groups,output,workspace,e,k,n,blocks,sync);
else if(plan.config==((128U<<16)|32U))
grouped_matmul_gelu_general_tiles<128,32><<<blocks,nullptr,stream>>>(input,weights,scales,groups,output,workspace,e,k,n,blocks,sync);
else if(plan.config==((256U<<16)|64U))
grouped_matmul_gelu_general_tiles<256,64><<<blocks,nullptr,stream>>>(input,weights,scales,groups,output,workspace,e,k,n,blocks,sync);
else if(plan.config==((128U<<16)|128U))
grouped_matmul_gelu_general_tiles<128,128><<<blocks,nullptr,stream>>>(input,weights,scales,groups,output,workspace,e,k,n,blocks,sync);
else if(plan.config==((256U<<16)|128U))
grouped_matmul_gelu_general_tiles<256,128><<<blocks,nullptr,stream>>>(input,weights,scales,groups,output,workspace,e,k,n,blocks,sync);
else
grouped_matmul_gelu_general_tiles<128,256><<<blocks,nullptr,stream>>>(input,weights,scales,groups,output,workspace,e,k,n,blocks,sync);
break;

case Kernel::Scalar:
grouped_matmul_gelu_an_scalar<<<1,nullptr,stream>>>(input,weights,scales,groups,output,e,k);
break;
case Kernel::SingleProduct:
grouped_matmul_gelu_single_product<<<1,nullptr,stream>>>(input,weights,scales,groups,output,e);
break;
case Kernel::SmallPairs:
if(e <= 3)
grouped_matmul_gelu_A_p3_fetch<<<blocks,nullptr,stream>>>(
input,weights,scales,groups,output,e > 1 ? 8U : 0U);
else
grouped_matmul_gelu_A_pack2_family<<<blocks,nullptr,stream>>>(
input,weights,scales,groups,output,e,m * n);
break;
case Kernel::SmallRows:
grouped_matmul_gelu_row_pairs<<<blocks,nullptr,stream>>>(input,weights,scales,groups,output,m,e);
break;
case Kernel::SmallRowDot:
if(k == 2)
grouped_matmul_gelu_A_row5<2><<<blocks,nullptr,stream>>>(input,weights,scales,groups,output,e);
else if(k == 3)
grouped_matmul_gelu_A_row5<3><<<blocks,nullptr,stream>>>(input,weights,scales,groups,output,e);
else
grouped_matmul_gelu_A_row5<4><<<blocks,nullptr,stream>>>(input,weights,scales,groups,output,e);
break;
case Kernel::FullRowTile:
if(m == 32)
grouped_matmul_gelu_full_row_tile<32>
<<<blocks,nullptr,stream>>>(input,weights,scales,output,workspace,sync);
else
grouped_matmul_gelu_full_row_tile<64>
<<<blocks,nullptr,stream>>>(input,weights,scales,output,workspace,sync);
break;
case Kernel::SplitRowTile:
grouped_matmul_gelu_df_held_fast<<<blocks,nullptr,stream>>>(
input,weights,scales,output,workspace,m,k,n,sync,plan.flag);
break;
case Kernel::LocalWide:
grouped_matmul_gelu_cp8_local_r64_wide<<<blocks,nullptr,stream>>>(
input,weights,scales,groups,output,workspace,sync);
break;
case Kernel::GroupedWide:
grouped_matmul_gelu_cp6_c38_r64_wide<<<blocks,nullptr,stream>>>(
input,weights,scales,groups,output,workspace,e,k,n,blocks,sync);
break;
case Kernel::LocalResident:
grouped_matmul_gelu_resident_k1024<<<blocks,nullptr,stream>>>(
input,weights,scales,groups,output,workspace,sync,e);
break;
case Kernel::GroupedResident:
grouped_matmul_gelu_cp6_c38_r128_fullk<<<blocks,nullptr,stream>>>(
input,weights,scales,groups,output,workspace,e,k,n,blocks,sync);
break;
case Kernel::LocalStream:
grouped_matmul_gelu_cp8_local_r128_streamk<<<blocks,nullptr,stream>>>(
input,weights,scales,groups,output,workspace,sync);
break;
case Kernel::ShortK:
grouped_matmul_gelu_expert_short_k<<<blocks,nullptr,stream>>>(
input,weights,scales,groups,output,workspace,e,blocks,sync);
break;
case Kernel::OwnedMidAlignedW:
grouped_matmul_gelu_owned_mid_aligned_w<<<blocks,nullptr,stream>>>(
input,weights,scales,groups,output,workspace,k,sync);
break;
case Kernel::OwnedLargeAlignedW:
grouped_matmul_gelu_owned_large_aligned_w<<<blocks,nullptr,stream>>>(
input,weights,scales,groups,output,workspace,k,sync);
break;
case Kernel::MidPanels:
grouped_matmul_gelu_other_mid_read_ahead<<<blocks,nullptr,stream>>>(
input,weights,scales,groups,output,workspace,k,sync);
break;
case Kernel::LargePanels:
grouped_matmul_gelu_other_large<<<blocks,nullptr,stream>>>(
input,weights,scales,groups,output,workspace,k,sync);
break;
case Kernel::PackedRows:
grouped_matmul_gelu_ha_gmpack<<<blocks,nullptr,stream>>>(
input,weights,scales,groups,output,workspace,e,k,n,blocks,sync);
break;
case Kernel::LongK:
if(plan.flag)
grouped_matmul_gelu_hb_rescue_outline<<<blocks,nullptr,stream>>>(
input,weights,scales,groups,output,workspace,e,k,n,blocks,sync);
else
grouped_matmul_gelu_hb_aligned<<<blocks,nullptr,stream>>>(
input,weights,scales,groups,output,workspace,e,k,n,blocks,sync);
break;
case Kernel::PaddedLongK:
grouped_matmul_gelu_df_hb<<<blocks,nullptr,stream>>>(
input,weights,scales,groups,output,workspace,e,k,n,blocks,sync);
break;
case Kernel::PackedWaves:
grouped_matmul_gelu_join_d_two<<<blocks,nullptr,stream>>>(
input,weights,scales,groups,output,workspace,e,k,n,blocks,sync,plan.flag);
break;
case Kernel::DirectWide:
grouped_matmul_gelu_direct_3<<<blocks,nullptr,stream>>>(
input,weights,scales,groups,output,workspace,e,k,n,blocks,sync);
break;
case Kernel::DirectNarrow:
grouped_matmul_gelu_direct_6_read_ahead<<<blocks,nullptr,stream>>>(
input,weights,scales,groups,output,workspace,e,k,n,blocks,sync);
break;
case Kernel::NarrowPanels:
if(n % 2 != 0)
grouped_matmul_gelu_hers_dispatch_isolated<<<blocks,nullptr,stream>>>(
input,weights,scales,groups,output,workspace,e,k,n,blocks,sync,uint32_t(l1));
else if(n % 16 != 0)
grouped_matmul_gelu_hers_odd<<<blocks,nullptr,stream>>>(
input,weights,scales,groups,output,workspace,e,k,n,blocks,sync,uint32_t(l1));
else
grouped_matmul_gelu_hers_full_packed<<<blocks,nullptr,stream>>>(
input,weights,scales,groups,output,workspace,e,k,n,blocks,sync,uint32_t(l1));
break;
case Kernel::StreamPanels:
grouped_matmul_gelu_df_hers<<<blocks,nullptr,stream>>>(
input,weights,scales,groups,output,workspace,e,k,n,blocks,sync);
break;
case Kernel::WidePanels:
grouped_matmul_gelu_df_hc<<<blocks,nullptr,stream>>>(
input,weights,scales,groups,output,workspace,e,k,n,blocks,sync,plan.flag);
break;
case Kernel::ExpertWaves:
grouped_matmul_gelu_wave_overlap<<<blocks,nullptr,stream>>>(
input,weights,scales,groups,output,workspace,e,k,n,blocks,sync);
break;
case Kernel::ExpertStream:
grouped_matmul_gelu_e32_ahead<<<blocks,nullptr,stream>>>(
input,weights,scales,groups,output,workspace,e,k,n,blocks,plan.config,sync);
break;
case Kernel::Aligned:
grouped_matmul_gelu_cp6_b0_copt<<<blocks,nullptr,stream>>>(
input,weights,scales,groups,output,workspace,e,k,plan.config,blocks,sync);
break;
case Kernel::SmallGroups:
grouped_matmul_gelu_b<<<blocks,nullptr,stream>>>(
input,weights,scales,groups,output,workspace,e,k,n,blocks,sync);
break;
case Kernel::Tail:
grouped_matmul_gelu_dn<<<blocks,nullptr,stream>>>(
input,weights,scales,groups,output,workspace,plan.config,k,n,blocks,sync);
break;
case Kernel::Base:
grouped_matmul_gelu_base<<<blocks,nullptr,stream>>>(
input,weights,scales,groups,output,workspace,e,k,n,blocks,sync);
break;
}

const aclError status = aclrtSynchronizeStream(stream);
const aclError freed = scratch ? aclrtFree(scratch): ACL_SUCCESS;
if(status != ACL_SUCCESS || freed != ACL_SUCCESS)
throw std::runtime_error("GroupedMatmulGelu: device execution failed");
}

__global__ __mix__(1,2)
__attribute__((section(".zzzzzzzz_direct_6_read_ahead")))void grouped_matmul_gelu_direct_6_read_ahead(
__gm__ int8_t *x,__gm__ int8_t *w,__gm__ float *scale,__gm__ int64_t *groups,__gm__ half *y,
__gm__ int32_t *c,uint32_t E,uint32_t K,uint32_t N,uint32_t W,uint64_t sync){
set_ffts_base_addr(sync);
asc_init();
if ASC_IS_AIV{
other6_group_meta::Begin(groups,E);
const uint32_t active = other6_group_meta::Finish(E);
other6_group_meta::Warm<1>(w,active,K,N,W);
}
if ASC_IS_AIC
other6_group_direct::Cube<192,160,320,160,false,true,true>(x,w,groups,c,E,K,N,W,K);
if ASC_IS_AIV{
auto cursor = other6_group_direct::Schedule<192,160>(groups,E,N,W);
wide_post::Vector<192,160>(cursor,scale,groups,y,c,N);
}
asc_sync();
}

namespace breakthrough_mid_balance{
using cp6_c38::Min;

using cp6_c38::Up;

constexpr uint32_t N = 768,BN = 256,CK = 256,LK = 128,Slots = 4,ABytes = 81920,BBytes = BN * CK;

struct Frame{
uint32_t expert,row,rows,col,abank;
bool first;
};

struct Cursor{
uint32_t expert = 0,start = 0,row = 0,end = 0,col = 0,left = 0,abank = 1,lastRow = uint32_t(-1);
bool balanced = false,wide = false,compactRows = false;
};

template <uint32_t Divisor,bool Later = false,bool Bounded = false>
__aicore__ __attribute__((always_inline))inline void WarmAsync(
__gm__ int8_t *w,uint32_t experts,uint32_t k,uint32_t n,uint32_t workers){
constexpr uint32_t BurstBytes = 65536;
static_assert(!Later || Divisor > 1);
const uint32_t rank = 2 * asc_get_block_idx()+ asc_get_sub_block_id();
const uint32_t stride = 2 * workers,expertBytes = k * n;
const uint32_t start = Later ?(k / Divisor)* n : 0;
const uint32_t prefix =(expertBytes + Divisor - 1)/ Divisor;
const uint32_t parts =(prefix + BurstBytes - 1)/ BurstBytes;
// Bound the extra work before the first C slab becomes ready.
if constexpr(Bounded)
if(experts * parts > stride * 4)
return;
auto ub =(__ubuf__ int8_t *)4096;
uint32_t issued = 0;
for(uint32_t task = rank;task < experts * parts;task += stride){
const uint32_t offset =(task % parts)* BurstBytes;
const uint32_t left = prefix - offset,bytes = left < BurstBytes ? left : BurstBytes;
asc_copy_gm2ub_align(ub +(issued % 2)* BurstBytes,w + uint64_t(task / parts)* expertBytes + start + offset,
1,bytes,0,(32 - bytes % 32)% 32,0,0);
++issued;
if(issued % 2 == 0)
asc_sync_pipe(PIPE_MTE2);
}
if(issued % 2)
asc_sync_pipe(PIPE_MTE2);
}

__aicore__ __attribute__((always_inline))inline __gm__ uint64_t *MetaRecord(__gm__ int32_t *scratch,uint32_t worker){
return(__gm__ uint64_t *)(scratch + uint64_t(asc_get_block_num())* 2 * 20480)+ uint64_t(worker)* 4;
}
__aicore__ __attribute__((always_inline))inline Cursor PrepareCursor(
__gm__ int8_t *w,__gm__ int64_t *groups,__gm__ int32_t *scratch,uint32_t worker,uint32_t k){
const uint32_t workers = asc_get_block_num();
auto ends =(__ubuf__ int64_t *)0;
asc_copy_gm2ub_align((__ubuf__ uint8_t *)ends,(__gm__ uint8_t *)groups,1,32 * 8,0,0,0,0);
asc_sync_notify(PIPE_MTE2,PIPE_S,EVENT_ID5);
asc_sync_wait(PIPE_MTE2,PIPE_S,EVENT_ID5);
// This uses only UB[4096,135168). Metadata uses UB[0,2128); no scalar wait for warming.
WarmAsync<4,false,true>(w,32,k,N,workers);
auto costs =(__ubuf__ uint32_t *)2048;
for(uint32_t i = 0;i < 20;++i)
costs[i] = 0;
uint32_t total = 0,previous = 0;
bool compactRows = true;
bool needsWide = false;
for(uint32_t e = 0;e < 32;++e){
const uint32_t end = uint32_t(ends[e]),tiles =(end - previous + 79)/ 80;
needsWide |= end - previous > 64;
compactRows &= end - previous <= 64;
previous = end;
total += tiles * 3;
if(e < 20)
costs[e] += tiles * 3;
else
for(uint32_t n = 0;n < 3;++n){
const uint32_t t =(e - 20)* 3 + n,owner = t < 32 ? t / 2 : t - 16;
costs[owner] += tiles;
}
}
uint32_t maximum = 0;
for(uint32_t i = 0;i < 20;++i)
if(costs[i] > maximum)
maximum = costs[i];
const uint32_t per = total / workers,extra = total % workers;
Cursor cur{};
cur.compactRows = compactRows;
cur.balanced = maximum > per + uint32_t(extra != 0)+ 1;
cur.wide = needsWide;
if(cur.balanced){
uint32_t first = worker * per + Min(worker,extra);
cur.left = per + uint32_t(worker < extra);
if(cur.left){
previous = 0;
for(uint32_t e = 0;e < 32;++e){
const uint32_t end = uint32_t(ends[e]),rows =(end - previous + 79)/ 80,jobs = rows * 3;
if(first < jobs){
cur.expert = e;
cur.start = previous;
cur.end = end;
cur.col =(first / rows)* BN;
cur.row = previous +(first % rows)* 80;
break;
}
first -= jobs;
previous = end;
}
}
}
const uint64_t word = uint64_t(cur.expert)|(uint64_t(cur.row)<< 6)|(uint64_t(cur.end)<< 22)|
(uint64_t(cur.col / BN)<< 39)|(uint64_t(cur.left)<< 41)|(uint64_t(cur.compactRows)<< 61)|
(uint64_t(cur.wide)<< 62)|(uint64_t(cur.balanced)<< 63);
if(!asc_get_sub_block_id()){
auto record =(__ubuf__ uint64_t *)1024;
record[0] = word;
record[1] = cur.start;
record[2] = record[3] = 0;
asc_sync_notify(PIPE_S,PIPE_MTE3,EVENT_ID5);
asc_sync_wait(PIPE_S,PIPE_MTE3,EVENT_ID5);
asc_copy_ub2gm_align(MetaRecord(scratch,worker),record,32);
asc_sync_notify(PIPE_MTE3,PIPE_S,EVENT_ID5);
asc_sync_wait(PIPE_MTE3,PIPE_S,EVENT_ID5);
}
ffts_cross_core_sync(PIPE_MTE3,0x21ULL);
return cur;
}
__aicore__ __attribute__((always_inline))inline Cursor ReadCursor(__gm__ int32_t *scratch,uint32_t worker){
asc_sync_block_wait(0);
auto meta = MetaRecord(scratch,worker);
asc_dcci_single((__gm__ void *)meta);
const uint64_t word = *(__gm__ volatile uint64_t *)meta,start = *(__gm__ volatile uint64_t *)(meta + 1);
Cursor cur{};
cur.balanced = bool(word >> 63);
cur.compactRows = bool(word &(uint64_t(1)<< 61));
cur.wide = bool(word &(uint64_t(1)<< 62));
cur.expert = uint32_t(word & 63);
cur.row = uint32_t((word >> 6)& 65535);
cur.end = uint32_t((word >> 22)& 131071);
cur.col = uint32_t((word >> 39)& 3)* BN;
cur.left = uint32_t((word >> 41)& 1023);
cur.start = uint32_t(start);
return cur;
}

__aicore__ __attribute__((always_inline))inline Frame Next(Cursor &cur,__gm__ int64_t *groups,uint32_t){
if(!cur.left)
return{};
while(cur.row >= cur.end){
if(cur.start < cur.end && cur.col + BN < N){
cur.col += BN;
cur.row = cur.start;
}else{
++cur.expert;
cur.start = cur.row = cur.end;
cur.end = uint32_t(groups[cur.expert]);
cur.col = 0;
}
}
const bool first = cur.row != cur.lastRow;
if(first)
cur.abank ^= 1;
const Frame f{cur.expert,cur.row,Min(80U,cur.end - cur.row),cur.col,cur.abank,first};
cur.lastRow = cur.row;
cur.row += f.rows;
--cur.left;
return f;
}

struct Panel{
Frame f;
uint32_t k0;
};

struct Fetch{
Cursor work;
Frame frame;
uint32_t k0;
};

__aicore__ __attribute__((always_inline))inline Panel NextPanel(
Fetch &fetch,__gm__ int64_t *groups,uint32_t worker,uint32_t k){
if(!fetch.k0)
fetch.frame = Next(fetch.work,groups,worker);
const Panel panel{fetch.frame,fetch.k0};
if(panel.f.rows){
fetch.k0 += CK;
if(fetch.k0 >= k)
fetch.k0 = 0;
}
return panel;
}

__aicore__ __attribute__((always_inline))inline void Prefetch(
__gm__ int8_t *x,__gm__ int8_t *w,Panel p,uint32_t k,uint32_t slot,uint32_t &ce,uint32_t &cn,uint32_t &ck){
auto b1 =(__cbuf__ int8_t *)static_cast<uint64_t>(slot * BBytes);
const Frame f = p.f;
if(f.first && !p.k0){
auto a1 =(__cbuf__ int8_t *)static_cast<uint64_t>(Slots * BBytes + f.abank * ABytes);
asc_copy_gm2l1_nd2nz(a1,x + uint64_t(f.row)* k,1,f.rows,k,0,k,Up(f.rows,16),1,0);
}
const uint32_t span = Min(CK,k - p.k0);
if(ce != f.expert || cn != f.col || ck != p.k0){
asc_copy_gm2l1_nd2nz(
b1,w +(uint64_t(f.expert)* k + p.k0)* N + f.col,span / 32,32,BN,32 * N,N,32,1,32 * BN);
ce = f.expert;
cn = f.col;
ck = p.k0;
}
cp6_staged_a::WeightReady(slot,false);
}

template <bool Wide = false>
__aicore__ __attribute__((always_inline))inline void Cube(
__gm__ int8_t *x,__gm__ int8_t *w,__gm__ int64_t *groups,__gm__ int32_t *scratch,uint32_t k,Cursor initial){
const uint32_t worker = asc_get_block_idx();
auto a =(__ca__ int8_t *)0;
auto b =(__cb__ int8_t *)0;
auto c =(__cc__ int32_t *)0;
Fetch fetch{initial,Frame{},0};
Panel queue[Slots];
uint32_t ce[Slots] ={uint32_t(-1),uint32_t(-1),uint32_t(-1),uint32_t(-1)},
cn[Slots] ={uint32_t(-1),uint32_t(-1),uint32_t(-1),uint32_t(-1)},
ck[Slots] ={uint32_t(-1),uint32_t(-1),uint32_t(-1),uint32_t(-1)};
for(uint32_t slot = 0;slot < Slots;++slot){
queue[slot] = NextPanel(fetch,groups,worker,k);
if(queue[slot].f.rows)
Prefetch(x,w,queue[slot],k,slot,ce[slot],cn[slot],ck[slot]);
}
bool leased[2] ={false,false},pending[2] ={false,false},wide_pending = false;
uint32_t ordinal = 0,tile = 0,step = 0;
for(uint32_t index = 0;queue[index % Slots].f.rows;++index){
const uint32_t slot = index % Slots;
const Panel p = queue[slot],next = NextPanel(fetch,groups,worker,k);
const Frame f = p.f;
const uint32_t tm = Up(f.rows,16),span = Min(CK,k - p.k0),bank = tm <= 64 ? tile % 2 : 0;
auto a1 =(__cbuf__ int8_t *)static_cast<uint64_t>(Slots * BBytes + f.abank * ABytes);
auto b1 =(__cbuf__ int8_t *)static_cast<uint64_t>(slot * BBytes);
auto cc = c + bank * 16384;
cp6_staged_a::WeightReady(slot,true);
for(uint32_t offset = 0;offset < span;offset += LK,++step){
const uint32_t kk = p.k0 + offset,kp = Min(LK,k - kk),l0 = step % 2;
if(leased[l0])
cp6_c38::LF(l0,true);
for(uint32_t i = 0;i < kp / 32;++i)
asc_copy_l12l0a(a + l0 * 80 * LK + i * 512,a1 +(kk + i * 32)* tm,0,tm / 16,1,kp / 32 - 1);
asc_copy_l12l0b_trans(b + l0 * 32768,b1 + offset * BN,0,kp / 32 *(BN / 32),1,1,false,uint64_t(0));
cp6_c38::LR(l0,false);
if(offset + kp == span && next.f.rows){
cp6_staged_a::WeightFree(slot);
Prefetch(x,w,next,k,slot,ce[slot],cn[slot],ck[slot]);
}
cp6_c38::LR(l0,true);
if(!kk){
if((tm > 64 || wide_pending || bank == 0)&& pending[0]){
cp6_large39::CLease(0,true);
pending[0] = false;
}
if((tm > 64 || bank == 1)&& pending[1]){
cp6_large39::CLease(1,true);
pending[1] = false;
}
wide_pending = false;
}
asc_mmad(cc,a + l0 * 80 * LK,b + l0 * 32768,tm,kp,BN,0,false,false,!kk);
cp6_c38::LF(l0,false);
leased[l0] = true;
}
if(p.k0 + span == k){
asc_sync_notify(PIPE_M,PIPE_FIX,EVENT_ID5);
asc_sync_wait(PIPE_M,PIPE_FIX,EVENT_ID5);
if(Wide){
const uint32_t slot = ordinal % 2;
if(ordinal >= 2)
asc_sync_block_wait(9 + 2 * slot);
asc_set_l0c_copy_params(1,0,0);
asc_copy_l0c2gm(
scratch +(uint64_t(worker)* 2 + slot)* 20480,cc,BN,f.rows,BN,tm,0,0,0,false,true);
ffts_cross_core_sync(PIPE_FIX,0x21ULL |(uint64_t(8 + 2 * slot)<< 8));
++ordinal;
}else
cp6_c38::StoreC<BN>(cc,scratch,worker,f.rows,tm,BN,ordinal,true);
cp6_large39::CLease(bank,false);
pending[bank] = true;
wide_pending = tm > 64;
++tile;
}
queue[slot] = next;
}
if(leased[0])
cp6_c38::LF(0,true);
if(leased[1])
cp6_c38::LF(1,true);
if(pending[0])
cp6_large39::CLease(0,true);
if(pending[1])
cp6_large39::CLease(1,true);
cp6_c38::Drain(ordinal);
}

__aicore__ inline void VectorTail(
__gm__ float *scale,__gm__ int64_t *groups,__gm__ half *y,__gm__ int32_t *scratch,Cursor cur){
const uint32_t worker = asc_get_block_idx(),sub = asc_get_sub_block_id();
cp6_sv59::State state{};
uint32_t ordinal = 0;
for(Frame f = Next(cur,groups,worker);f.rows;f = Next(cur,groups,worker))
cp6_sv59::LargeTile<true>(
state,scale,y,scratch,worker,sub,f.expert,f.row,f.col,f.rows,BN,N,ordinal);
cp6_sv59::End(state);
}

__aicore__ inline void VectorWideTail(
__gm__ float *scale,__gm__ int64_t *groups,__gm__ half *y,__gm__ int32_t *scratch,Cursor cur){
const uint32_t worker = asc_get_block_idx(),sub = asc_get_sub_block_id();
uint32_t ordinal = 0;
bool hasOut = false;
auto z =(__ubuf__ float *)0;
auto sc =(__ubuf__ float *)188672;
auto out =(__ubuf__ half *)163840;
for(Frame f = Next(cur,groups,worker);f.rows;f = Next(cur,groups,worker)){
const uint32_t slot = ordinal % 2,half =(f.rows + 1)/ 2,local = sub * half;
const uint32_t rows = sub ? f.rows - half : half,count = rows * BN;
if(rows)
asc_copy_gm2ub_align(sc,scale + uint64_t(f.expert)* N + f.col,1,1024,0,0,0,0);
asc_sync_block_wait(8 + 2 * slot);
if(rows){
asc_copy_gm2ub_align((__ubuf__ int32_t *)z,scratch +(uint64_t(worker)* 2 + slot)* 20480 + local * BN,1,
count * 4,0,0,0,0);
asc_sync_notify(PIPE_MTE2,PIPE_V,EVENT_ID7);
}
ffts_cross_core_sync(PIPE_MTE2,0x21ULL |(uint64_t(9 + 2 * slot)<< 8));
if(rows){
asc_sync_wait(PIPE_MTE2,PIPE_V,EVENT_ID7);
asc_int322float_rn(z,(__ubuf__ int32_t *)z,count);
asc_sync_pipe(PIPE_V);
asc_set_mask_norm();
asc_set_vector_mask(0,~uint64_t(0));
for(uint32_t n = 0;n < BN;n += 64)
asc_mul(z + n,z + n,sc + n,uint8_t(rows),1,1,1,32,32,0);
asc_sync_pipe(PIPE_V);
asc_set_vector_mask(~uint64_t(0),~uint64_t(0));
cp6_c38::LargeMidpoint<false,true,true,true>(z,(__ubuf__ float *)40960,(__ubuf__ float *)81920,
(__ubuf__ float *)122880,out,(__ubuf__ uint8_t *)186880,count,hasOut);
asc_sync_notify(PIPE_S,PIPE_MTE3,EVENT_ID0);
asc_sync_wait(PIPE_S,PIPE_MTE3,EVENT_ID0);
asc_copy_ub2gm_align(y + uint64_t(f.row + local)* N + f.col,out,rows,512,0,0,0,(N - BN)* 2);
asc_sync_notify(PIPE_MTE3,PIPE_V,EVENT_ID4);
hasOut = true;
}
++ordinal;
}
if(hasOut)
asc_sync_wait(PIPE_MTE3,PIPE_V,EVENT_ID4);
asc_sync();
ffts_cross_core_sync(PIPE_MTE3,0x21ULL |(uint64_t(12)<< 8));
}
template <bool Wide = false,bool Half = false>
__aicore__ __attribute__((always_inline))inline void StaticCubeReady(__gm__ int8_t *x,__gm__ int8_t *w,
__gm__ int64_t *groups,__gm__ int32_t *scratch,uint32_t k,other_mid::Fetch fetch,
other_mid::Panel(&queue)[Slots]){
if constexpr(Half)
asc_set_l0c_copy_prequant(uint64_t(0x39800000U));
const uint32_t worker = asc_get_block_idx();
auto a =(__ca__ int8_t *)0;
auto b =(__cb__ int8_t *)0;
auto c =(__cc__ int32_t *)0;

bool leased[2] ={false,false},pending[2] ={false,false},wide_pending = false;
uint32_t ordinal = 0,tile = 0,step = 0;
for(uint32_t index = 0;queue[index % Slots].f.rows;++index){
const uint32_t slot = index % Slots;
const other_mid::Panel p = queue[slot],next = other_mid::NextPanel(fetch,groups,worker,k);
const other_mid::Frame f = p.f;
const uint32_t tm = Up(f.rows,16),span = Min(CK,k - p.k0),bank = tm <= 64 ? tile % 2 : 0;
auto a1 =(__cbuf__ int8_t *)static_cast<uint64_t>(Slots * BBytes + f.abank * ABytes);
auto b1 =(__cbuf__ int8_t *)static_cast<uint64_t>(slot * BBytes);
auto cc = c + bank * 16384;
cp6_staged_a::WeightReady(slot,true);
for(uint32_t offset = 0;offset < span;offset += LK,++step){
const uint32_t kk = p.k0 + offset,kp = Min(LK,k - kk),l0 = step % 2;
if(leased[l0])
cp6_c38::LF(l0,true);
for(uint32_t i = 0;i < kp / 32;++i)
asc_copy_l12l0a(a + l0 * 80 * LK + i * 512,a1 +(kk + i * 32)* tm,0,tm / 16,1,kp / 32 - 1);
asc_copy_l12l0b_trans(b + l0 * 32768,b1 + offset * BN,0,kp / 32 *(BN / 32),1,1,false,uint64_t(0));
cp6_c38::LR(l0,false);
if(offset + kp == span && next.f.rows){
cp6_staged_a::WeightFree(slot);
other_mid::Prefetch(x,w,next,k,slot);
}
cp6_c38::LR(l0,true);
if(!kk){
if((tm > 64 || wide_pending || bank == 0)&& pending[0]){
cp6_large39::CLease(0,true);
pending[0] = false;
}
if((tm > 64 || bank == 1)&& pending[1]){
cp6_large39::CLease(1,true);
pending[1] = false;
}
wide_pending = false;
}
asc_mmad(cc,a + l0 * 80 * LK,b + l0 * 32768,tm,kp,BN,0,false,false,!kk);
cp6_c38::LF(l0,false);
leased[l0] = true;
}
if(p.k0 + span == k){
asc_sync_notify(PIPE_M,PIPE_FIX,EVENT_ID5);
asc_sync_wait(PIPE_M,PIPE_FIX,EVENT_ID5);
if constexpr(Half)
compact_rows::StoreHalf<16384>(cc,scratch,worker,f.rows,tm,ordinal);
else if(Wide){
const uint32_t slot = ordinal % 2;
if(ordinal >= 2)
asc_sync_block_wait(9 + 2 * slot);
asc_set_l0c_copy_params(1,0,0);
asc_copy_l0c2gm(
scratch +(uint64_t(worker)* 2 + slot)* 20480,cc,BN,f.rows,BN,tm,0,0,0,false,true);
ffts_cross_core_sync(PIPE_FIX,0x21ULL |(uint64_t(8 + 2 * slot)<< 8));
++ordinal;
}else
cp6_c38::StoreC<BN>(cc,scratch,worker,f.rows,tm,BN,ordinal,true);
cp6_large39::CLease(bank,false);
pending[bank] = true;
wide_pending = tm > 64;
++tile;
}
queue[slot] = next;
}
if(leased[0])
cp6_c38::LF(0,true);
if(leased[1])
cp6_c38::LF(1,true);
if(pending[0])
cp6_large39::CLease(0,true);
if(pending[1])
cp6_large39::CLease(1,true);
cp6_c38::Drain(ordinal);
}
}// namespace breakthrough_mid_balance
namespace compact_mid{
static __aicore__ __attribute__((noinline,aligned(4096),section(".zzzzzzzzzzzz_hd_half_mid_cube")))void Cube(
__gm__ int8_t *,__gm__ int8_t *,__gm__ int64_t *,__gm__ int32_t *,uint32_t,other_mid::Fetch,
other_mid::Panel(&)[other_mid::Slots]);
}
__global__ __mix__(1,2)
__attribute__((section(".zzzzzzzz_other_mid_read_ahead")))void grouped_matmul_gelu_other_mid_read_ahead(
__gm__ int8_t *x,__gm__ int8_t *w,__gm__ float *scale,__gm__ int64_t *groups,__gm__ half *y,
__gm__ int32_t *scratch,uint32_t K,uint64_t sync_base){
set_ffts_base_addr(sync_base);
asc_init();
constexpr uint32_t E = 32,N = 768,W = 20;
const bool owner = cp6_mid_focus::Eligible(groups,E,K,N,W);

if ASC_IS_AIC{
if(owner){
const uint32_t worker = asc_get_block_idx();
other_mid::Fetch initial{other_mid::Init(worker),other_mid::Frame{},0};
other_mid::Panel queue[other_mid::Slots];
for(uint32_t slot = 0;slot < other_mid::Slots;++slot){
queue[slot] = other_mid::NextPanel(initial,groups,worker,K);
if(queue[slot].f.rows)
other_mid::Prefetch(x,w,queue[slot],K,slot);
}
auto cur = breakthrough_mid_balance::ReadCursor(scratch,worker);
const bool wide = cur.wide;
if(cur.compactRows && !(uint64_t(x)& 31U)&& !(uint64_t(w)& 255U)&& !(uint64_t(y)& 31U)){
compact_mid::Cube(x,w,groups,scratch,K,initial,queue);
}else if(cur.balanced){
for(uint32_t slot = 0;slot < other_mid::Slots;++slot)
if(queue[slot].f.rows)
cp6_staged_a::WeightReady(slot,true);
asc_sync_notify(PIPE_MTE1,PIPE_MTE2,EVENT_ID7);
asc_sync_wait(PIPE_MTE1,PIPE_MTE2,EVENT_ID7);
if(wide)
breakthrough_mid_balance::Cube<true>(x,w,groups,scratch,K,cur);
else
breakthrough_mid_balance::Cube<false>(x,w,groups,scratch,K,cur);
}else{
if(wide)
breakthrough_mid_balance::StaticCubeReady<true>(x,w,groups,scratch,K,initial,queue);
else
breakthrough_mid_balance::StaticCubeReady<false>(x,w,groups,scratch,K,initial,queue);
}
}else
cp6_c38::CubeFullGrouped<2,true>(x,w,groups,scratch,E,K,N,W);
}
if ASC_IS_AIV{
if(owner){
auto cur = breakthrough_mid_balance::PrepareCursor(w,groups,scratch,asc_get_block_idx(),K);
const bool wide = cur.wide;
if(cur.compactRows && !(uint64_t(x)& 31U)&& !(uint64_t(w)& 255U)&& !(uint64_t(y)& 31U)){
compact_rows_post::Mid((__ubuf__ int64_t *)0,scale,y,scratch);
}else if(cur.balanced){
if(wide)
breakthrough_mid_balance::VectorWideTail(scale,groups,y,scratch,cur);
else
breakthrough_mid_balance::VectorTail(scale,groups,y,scratch,cur);
}else{
if(wide)
other_mid::VectorWideTail(scale,groups,y,scratch);
else
other_mid::VectorTail(scale,groups,y,scratch);
}
}else
cp6_c38::VectorGrouped<2>(scale,groups,y,scratch,E,N,W);
}
asc_sync();
}

namespace hers_smooth_rect{
using dfocus::Min;

struct Rect{
uint32_t expert,row,rows,col,cols;
};

struct Rects{
uint32_t expert = 0,row = 0,col = 0,left = 0;
__aicore__ __attribute__((always_inline))inline Rect Next(__gm__ int64_t *groups,uint32_t width){
const uint32_t blocks =(width + 31)/ 32;
while(left){
const uint32_t end = uint32_t(groups[expert]);
if(end != row){
const uint32_t take = Min(Min(blocks - col,left),10U);
Rect rect{expert,row,end - row,col * 32,Min(take * 32,width - col * 32)};
left -= take;
col += take;
if(col == blocks){
++expert;
row = end;
col = 0;
}
return rect;
}
++expert;
}
return{};
}
};

__aicore__ __attribute__((always_inline))inline uint32_t RectCost(uint32_t rows){
return rows ? dfocus::Up(rows,32)+ 512 : 0;
}

__aicore__ __attribute__((always_inline))inline Rects Schedule(
__gm__ int64_t *groups,uint32_t E,uint32_t width,uint32_t workers){
uint32_t weight = 0,previous = 0;
const uint32_t blocks =(width + 31)/ 32,worker = asc_get_block_idx();
for(uint32_t e = 0;e < E;++e){
const uint32_t end = uint32_t(groups[e]);
weight += blocks * RectCost(end - previous);
previous = end;
}
const uint32_t lower = weight * worker / workers,upper = weight *(worker + 1)/ workers;
uint32_t prefix = 0,ordinal = 0,first = 0,last = 0;
bool found = false;
Rects result{};
previous = 0;
for(uint32_t e = 0;e < E;++e){
const uint32_t end = uint32_t(groups[e]),cost = RectCost(end - previous);
if(cost){
const uint32_t limit = prefix + blocks * cost;
if(!found && lower < limit){
result.expert = e;
result.row = previous;
result.col =(lower - prefix)/ cost;
first = ordinal + result.col;
found = true;
}
if(upper <= limit){
last = ordinal +(upper - prefix)/ cost;
break;
}
ordinal += blocks;
prefix = limit;
}
previous = end;
}
if(found)
result.left = last - first;
return result;
}
}// namespace hers_smooth_rect

namespace hers_adaptive_full{
__aicore__ __attribute__((always_inline))inline void LoadNZ(
__cbuf__ int8_t *dst,__gm__ int8_t *raw,uint32_t rows,uint32_t cols,uint32_t stride,uint32_t pitch){
if(stride % 32 == 16 && rows >= 2){
asc_copy_gm2l1_nd2nz(dst,raw,1,(rows + 1)/ 2,cols,0,2 * stride,pitch,2,0);
asc_copy_gm2l1_nd2nz(dst + 32,raw + stride,1,rows / 2,cols,0,2 * stride,pitch,2,0);
}else
asc_copy_gm2l1_nd2nz(dst,raw,1,rows,cols,0,stride,pitch,1,0);
}

using dfocus::Min;

using dfocus::Up;

__aicore__ __attribute__((always_inline))inline uint32_t RowTile(uint32_t cols,uint32_t rows){
const uint32_t np = Up(cols,32),blocks = Up(rows,32)/ 32;
const bool fewer =(blocks + 4)/ 5 <(blocks + 3)/ 4 &&(blocks + 4)/ 5 <= 4;
return Min(np >= 160 && np <= 192 && fewer ? 160U : 128U,(1024 / np)* 32);
}

struct RowSplit{
uint32_t parts,blocks,extra;
};

__aicore__ __attribute__((always_inline))inline RowSplit SplitRows(uint32_t rows,uint32_t cap){
const uint32_t blocks = Up(rows,32)/ 32,capacity = cap / 32;
const uint32_t parts =(blocks + capacity - 1)/ capacity;
return{parts,blocks / parts,blocks % parts};
}

__aicore__ __attribute__((always_inline))inline uint32_t BlockRows(RowSplit split,uint32_t index,uint32_t left){
return Min(left,(split.blocks +(index < split.extra))* 32);
}

struct Frames{
hers_smooth_rect::Rects rects;
hers_smooth_rect::Rect rect{};
uint32_t row = 0,offset = 0,tile = 0,part = 0;
__aicore__ __attribute__((always_inline))inline bool Next(
hers_post::Frame &frame,__gm__ int64_t *groups,uint32_t n,uint32_t sub){
if(!rect.rows)
rect = rects.Next(groups,n);
if(!rect.rows)
return false;
const RowSplit plan = SplitRows(rect.rows,RowTile(rect.cols,rect.rows));
const uint32_t rows = BlockRows(plan,part,rect.rows - row),chunk = Min(56U,rows - offset);
const uint32_t split =(chunk + 1)/ 2,local = split * sub;
frame ={rect.expert,rect.row + row + offset + local,rect.col,sub ? chunk - split : split,rect.cols,
Up(rect.cols,32),tile,offset + local,!offset,offset + chunk == rows};
offset += chunk;
if(frame.last){
++tile;
row += rows;
++part;
offset = 0;
if(row == rect.rows){
row = 0;
part = 0;
rect ={};
}
}
return true;
}
};

template <bool Packed,bool Notify = true>
__aicore__ __attribute__((always_inline))inline void LoadX(
__cbuf__ int8_t *a1,__gm__ int8_t *x,uint32_t row,uint32_t rows,uint32_t k,uint32_t kp,uint32_t slot){
const uint32_t mp = Up(rows,32);
if constexpr(Packed)
LoadNZ(a1,x + uint64_t(row)* k,rows,k,k,mp);
else
asc_copy_gm2l1_nd2nz(a1,x + uint64_t(row)* k,1,rows,k,0,k,mp,1,0);
if constexpr(Notify)
cp6_c38::L1R(slot,false);
}

template <bool Packed>
__aicore__ __attribute__((always_inline))inline void Cube(__gm__ int8_t *x,__gm__ int8_t *w,__gm__ int64_t *groups,
__gm__ int32_t *ws,uint32_t E,uint32_t K,uint32_t N,uint32_t W,uint32_t l1){
auto rects = hers_smooth_rect::Schedule(groups,E,N,W);
const uint32_t kp = Up(K,32),worker = asc_get_block_idx();
auto a1 =(__cbuf__ int8_t *)0;
auto c =(__cc__ int32_t *)0;
uint32_t phase = 0,ordinal = 0;
for(auto rect = rects.Next(groups,N);rect.rows;rect = rects.Next(groups,N)){
const uint32_t tm = RowTile(rect.cols,rect.rows),np = Up(rect.cols,32);
const uint32_t step = Min(256U,(1024 /(tm > np ? tm : np))* 32);
const bool doubleA =(2 * tm + np)* kp <= l1;
auto b1 = a1 +(doubleA ? 2 : 1)* tm * kp;
if(phase){
asc_sync_notify(PIPE_MTE1,PIPE_MTE2,EVENT_ID7);
asc_sync_wait(PIPE_MTE1,PIPE_MTE2,EVENT_ID7);
}
const RowSplit plan = SplitRows(rect.rows,tm);
const uint32_t firstRows = BlockRows(plan,0,rect.rows);
if constexpr(Packed){
LoadX<Packed,false>(a1,x,rect.row,firstRows,K,kp,0);
if(!phase)
asc_sync_block_wait(0);
const uint32_t pitch = Up(N,32);
asc_copy_gm2l1(b1,w + uint64_t(rect.expert)* kp * pitch + rect.col * 32,kp / 32,np,pitch - np,0);
cp6_c38::L1R(0,false);
}else{
asc_copy_gm2l1_nd2nz(b1,w + uint64_t(rect.expert)* K * N + rect.col,1,K,rect.cols,0,N,kp,1,0);
LoadX<Packed>(a1,x,rect.row,firstRows,K,kp,0);
}
for(uint32_t row = 0,part = 0;part < plan.parts;++part,++ordinal){
const uint32_t rows = BlockRows(plan,part,rect.rows - row),mp = Up(rows,32),slot = ordinal % 2;
const uint32_t nextRow = row + rows;
const bool hasNext = part + 1 < plan.parts;
const uint32_t nextRows = hasNext ? BlockRows(plan,part + 1,rect.rows - nextRow): 0;
const uint32_t input = doubleA ? part % 2 : 0;
auto localA = a1 + input * tm * kp;
cp6_c38::L1R(input,true);
if(doubleA && hasNext){
if(part){
cp6_c38::L1F(1 - input,false);
cp6_c38::L1F(1 - input,true);
}
LoadX<Packed>(a1 +(1 - input)* tm * kp,x,rect.row + nextRow,nextRows,K,kp,1 - input);
}
for(uint32_t off = 0;off < kp;off += step,++phase){
const uint32_t k = Min(step,kp - off),bank = phase % 2;
auto a =(__ca__ int8_t *)(uint64_t(bank)* 32768);
auto b =(__cb__ int8_t *)(uint64_t(bank)* 32768);
if(phase >= 2)
cp6_c38::LF(bank,true);
for(uint32_t p = 0;p < k / 32;++p){
asc_copy_l12l0a(a + p * 512,localA +(off + p * 32)* mp,0,mp / 16,1,k / 32 - 1);
if constexpr(!Packed)
asc_copy_l12l0b_trans(
b + p * np * 32,b1 +(off + p * 32)* 32,0,np / 32,kp / 32,1,false,uint64_t(0));
}
if constexpr(Packed)
asc_copy_l12l0b_trans(b,b1 + off * np,0,k / 32 *(np / 32),1,1,false,uint64_t(0));
cp6_c38::LR(bank,false);
if(!doubleA && off + k == kp && hasNext){
cp6_c38::L1F(0,false);
cp6_c38::L1F(0,true);
LoadX<Packed>(a1,x,rect.row + nextRow,nextRows,K,kp,0);
}
cp6_c38::LR(bank,true);
if(!off && ordinal)
cp6_large39::CLease(0,true);
if(off && k == 32)
asc_sync_pipe(PIPE_M);
if(mp < 64 || np < 64)
asc_mmad_sync(c,a,b,mp,k,np,0,false,false,!off);
else
asc_mmad(c,a,b,mp,k,np,0,false,false,!off);
cp6_c38::LF(bank,false);
}
if(ordinal >= 2)
asc_sync_block_wait(9 + 2 * slot);
asc_sync_notify(PIPE_M,PIPE_FIX,EVENT_ID5);
asc_sync_wait(PIPE_M,PIPE_FIX,EVENT_ID5);
asc_set_l0c_copy_params(1,0,0);
asc_copy_l0c2gm(ws +(2 * worker + slot)* 32768,c,np,rows,np,mp,0,0,0,false,true);
ffts_cross_core_sync(PIPE_FIX,0x21ULL |(uint64_t(8 + 2 * slot)<< 8));
cp6_large39::CLease(0,false);
row = nextRow;
}
}
for(uint32_t i = phase > 2 ? phase - 2 : 0;i < phase;++i)
cp6_c38::LF(i % 2,true);
if constexpr(Packed)
if(!phase)
asc_sync_block_wait(0);
if(ordinal)
cp6_large39::CLease(0,true);
cp6_c38::Drain(ordinal);
}
}// namespace hers_adaptive_full

static __aicore__ __attribute__((noinline,section(".zzzzzzzzzz_hers_adaptive_run")))void HersRunAdaptive(
__gm__ int8_t *x,__gm__ int8_t *w,__gm__ float *scale,__gm__ int64_t *groups,__gm__ half *y,
__gm__ int32_t *scratch,uint32_t E,uint32_t K,uint32_t N,uint32_t workers,uint64_t sync_base,uint32_t l1){
if ASC_IS_AIC
hers_adaptive_full::Cube<false>(x,w,groups,scratch,E,K,N,workers,l1);
if ASC_IS_AIV{
shared_weight_prefetch::Read<1,false,true>(w,E,K,N,workers);
hers_adaptive_full::Frames frames{hers_smooth_rect::Schedule(groups,E,N,workers)};
hers_post::Vector<2,32768,false>(frames,scale,groups,y,scratch,N);
}
asc_sync();
}

namespace other6_group_hrect{
using dfocus::Min;

struct Rect{
uint32_t expert,row,rows,col,cols;
};

struct Rects{
uint32_t expert = 0,row = 0,col = 0,left = 0;
__aicore__ __attribute__((always_inline))inline Rect Next(__gm__ int64_t *groups,uint32_t width){
const uint32_t blocks =(width + 31)/ 32;
while(left){
const uint32_t end = uint32_t(other6_group_meta::End(groups,expert));
if(end != row){
const uint32_t take = Min(Min(blocks - col,left),10U);
Rect rect{expert,row,end - row,col * 32,Min(take * 32,width - col * 32)};
left -= take;
col += take;
if(col == blocks){
++expert;
row = end;
col = 0;
}
return rect;
}
++expert;
}
return{};
}
};

__aicore__ __attribute__((always_inline))inline uint32_t RectCost(uint32_t rows){
return rows ? dfocus::Up(rows,128)+ 512 : 0;
}

__aicore__ __attribute__((always_inline))inline Rects Schedule(
__gm__ int64_t *groups,uint32_t E,uint32_t width,uint32_t workers){
uint32_t weight = 0,previous = 0;
const uint32_t blocks =(width + 31)/ 32,worker = asc_get_block_idx();
for(uint32_t e = 0;e < E;++e){
const uint32_t end = uint32_t(other6_group_meta::End(groups,e));
weight += blocks * RectCost(end - previous);
previous = end;
}
const uint32_t lower = weight * worker / workers,upper = weight *(worker + 1)/ workers;
uint32_t prefix = 0,ordinal = 0,first = 0,last = 0;
bool found = false;
Rects result{};
previous = 0;
for(uint32_t e = 0;e < E;++e){
const uint32_t end = uint32_t(other6_group_meta::End(groups,e)),cost = RectCost(end - previous);
if(cost){
const uint32_t limit = prefix + blocks * cost;
if(!found && lower < limit){
result.expert = e;
result.row = previous;
result.col =(lower - prefix)/ cost;
first = ordinal + result.col;
found = true;
}
if(upper <= limit){
last = ordinal +(upper - prefix)/ cost;
break;
}
ordinal += blocks;
prefix = limit;
}
previous = end;
}
if(found)
result.left = last - first;
return result;
}
}// namespace other6_group_hrect

