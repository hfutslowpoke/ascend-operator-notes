asc_sync_pipe(PIPE_V);
asc_mul(t,u,z,count);
asc_sync_pipe(PIPE_V);
}else{
asc_mul(u,z,z,count);
asc_sync_pipe(PIPE_V);
asc_mul(u,u,z,count);
asc_sync_pipe(PIPE_V);
asc_mul_scalar(u,u,.044715f,count);
asc_sync_pipe(PIPE_V);
asc_add(u,u,z,count);
asc_sync_pipe(PIPE_V);
asc_mul_scalar(u,u,.7978846f,count);
asc_sync_pipe(PIPE_V);
asc_mul_scalar(t,u,-2.0f,count);
asc_sync_pipe(PIPE_V);
}
asc_min_scalar(t,t,8e1f,count);
asc_sync_pipe(PIPE_V);
asc_exp(t,t,count);
asc_sync_pipe(PIPE_V);
asc_add_scalar(t,t,1.0f,count);
asc_sync_pipe(PIPE_V);
asc_div(d,z,t,count);
asc_sync_pipe(PIPE_V);
asc_float2half_rn(out,d,count);
asc_sync_pipe(PIPE_V);
Finish(s);
asc_sync_notify(PIPE_V,PIPE_S,EVENT_ID2);
asc_sync_wait(PIPE_V,PIPE_S,EVENT_ID2);
