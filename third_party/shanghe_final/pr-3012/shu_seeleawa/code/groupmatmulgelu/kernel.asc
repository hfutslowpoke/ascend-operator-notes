if(mag >=(1ULL << 42)){
const uint32_t top = 63 - __builtin_clzll(mag);
shift_out = top - 10;
exp_field = top - 56 + 15;
}
uint32_t rounded = uint32_t(mag >> shift_out);
const uint64_t rem = mag &((1ULL << shift_out)- 1),halfway = 1ULL <<(shift_out - 1);
