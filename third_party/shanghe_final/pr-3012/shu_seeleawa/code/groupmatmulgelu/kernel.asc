}

template <uint32_t P>
__aicore__ inline void StreamLoad(__gm__ int8_t *x,__gm__ int8_t *w,__cbuf__ int8_t *base,__ca__ int8_t *a,
__cb__ int8_t *b,uint32_t e,uint32_t row,uint32_t col,uint32_t tm,uint32_t mr,uint32_t mp,uint32_t nr,
uint32_t K,uint32_t N,uint32_t micro){
const uint32_t k0 = micro * 128,kp = Min(128U,K - k0),outer = k0 / 256,inside = k0 % 256,stage = outer % 3,
slot = micro % 2,span =(tm + 256)* 256,kr = Min(256U,K - outer * 256);
if(!inside)
