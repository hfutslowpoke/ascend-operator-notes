template <uint32_t BN,bool Fast = false,bool FastCurve = true>
__aicore__ inline uint32_t VectorTile(__gm__ float *scale,__gm__ half *y,__gm__ int32_t *scratch,uint32_t worker,
uint32_t sub,uint32_t e,uint32_t row,uint32_t col,uint32_t mr,uint32_t nr,uint32_t N,uint32_t &ordinal,
uint32_t idx){
constexpr uint32_t sr = 16384 / BN;
__ubuf__ int32_t *c =(__ubuf__ int32_t *)0;
__ubuf__ float *z =(__ubuf__ float *)0;
__ubuf__ float *u =(__ubuf__ float *)(4 * VQ + 64);
__ubuf__ float *t =(__ubuf__ float *)(8 * VQ + 128);
__ubuf__ float *d =(__ubuf__ float *)(12 * VQ + 192);
__ubuf__ float *p =(__ubuf__ float *)(16 * VQ + 256);
__ubuf__ float *sc =(__ubuf__ float *)(20 * VQ + 320);
__ubuf__ half *out =(__ubuf__ half *)(20 * VQ + 4 * BN + 320);
__ubuf__ uint8_t *mask =(__ubuf__ uint8_t *)(22 * VQ + 4 * BN + 320);
if(nr < BN){
asc_duplicate(sc,0.0f,BN);
asc_sync();
}
asc_copy_gm2ub_align_sync(sc,scale + uint64_t(e)* N + col,nr * 4);
for(uint32_t micro = 0;micro < mr;micro += sr){
const uint32_t tail = Min(sr,mr - micro),split =(tail + 1)/ 2,local = sub * split,
rows = tail > local ? Min(split,tail - local): 0,si = ordinal % 2;
__gm__ int32_t *slot = scratch +(uint64_t(worker)* 2 + si)* 16384;
asc_sync_block_wait(READY + 2 * si);
if(rows){
if(nr < BN){
asc_duplicate(c,int32_t(0),rows * BN);
asc_sync();
}
if(nr == BN)
asc_copy_gm2ub_align(c,slot + local * BN,1,rows * BN * 4,0,0,0,0);
else
for(uint32_t r = 0;r < rows;++r)
asc_copy_gm2ub_align(c + r * BN,slot +(local + r)* BN,1,nr * 4,0,0,0,0);
asc_sync();
}
ffts_cross_core_sync(PIPE_MTE2,0x21ULL |(uint64_t(DONE + 2 * si)<< 8));
if(rows){
const uint32_t count = rows * BN;
asc_int322float_rn_sync(z,c,count);
asc_set_mask_norm();
asc_set_vector_mask(uint64_t(0),~uint64_t(0));
for(uint32_t n = 0;n < BN;n += 64)
asc_mul(z + n,z + n,sc + n,uint8_t(rows),1,1,1,BN / 8,BN / 8,0);
asc_sync();
asc_set_vector_mask(~uint64_t(0),~uint64_t(0));
if(Fast && nr == BN && count % 2048 == 0)
GoalMidpoint<FastCurve>(z,u,t,d,p,out,mask,count);
else
idx = cp6_index37::GeluTailSparse37(z,u,t,d,p,out,mask,count,nr,BN,idx);
asc_sync_notify(PIPE_S,PIPE_MTE3,EVENT_ID0);
asc_sync_wait(PIPE_S,PIPE_MTE3,EVENT_ID0);
if(nr == BN)
asc_copy_ub2gm_align(
y + uint64_t(row + micro + local)* N + col,out,rows,BN * 2,0,0,0,(N - BN)* 2);
else
for(uint32_t r = 0;r < rows;++r)
asc_copy_ub2gm_align(
y + uint64_t(row + micro + local + r)* N + col,out + r * BN,1,nr * 2,0,0,0,0);
asc_sync();
}
++ordinal;
}
return idx;
}

template <uint32_t P>
__aicore__ inline void VectorGrouped(__gm__ float *scale,__gm__ int64_t *groups,__gm__ half *y,
__gm__ int32_t *scratch,uint32_t E,uint32_t N,uint32_t W){
const uint32_t worker = asc_get_block_idx(),sub = asc_get_sub_block_id(),nt =(N + 255)/ 256;
uint32_t ordinal = 0,start = 0,first = worker,idx = 0;
for(uint32_t e = 0;e < E;++e){
const uint32_t end = uint32_t(groups[e]),me = end - start,tm = TileM<P>(me),
tasks =((me + tm - 1)/ tm)* nt;
uint32_t task = first;
for(;task < tasks;task += W){
const uint32_t row = start +(task / nt)* tm,col =(task % nt)* 256;
idx = VectorTile<256>(
scale,y,scratch,worker,sub,e,row,col,Min(tm,end - row),Min(256U,N - col),N,ordinal,idx);
}
first = task - tasks;
start = end;
}
asc_sync();
ffts_cross_core_sync(PIPE_MTE3,0x21ULL |(uint64_t(FINAL)<< 8));
}

template <uint32_t TM,uint32_t BN,bool Ranked = false,bool Fast = false>
__aicore__ inline void VectorOwned(
__gm__ float *scale,__gm__ half *y,__gm__ int32_t *scratch,uint32_t E,uint32_t N,uint32_t W){
const uint32_t worker = asc_get_block_idx(),sub = asc_get_sub_block_id(),ranks = Ranked ? Min(2U,W / E): 1,
active = Ranked ? E * ranks : Min(E,W);
if(worker >= active)
return;
uint32_t ordinal = 0,idx = 0;
for(uint32_t e = Ranked ? worker / ranks : worker;e < E;e += Ranked ? E : active){
const uint32_t rank = Ranked ? worker % ranks : 0;
for(uint32_t tile = rank;tile < N / BN;tile += ranks)
idx = VectorTile<BN,Fast>(scale,y,scratch,worker,sub,e,e * TM,tile * BN,TM,BN,N,ordinal,idx);
}
asc_sync();
