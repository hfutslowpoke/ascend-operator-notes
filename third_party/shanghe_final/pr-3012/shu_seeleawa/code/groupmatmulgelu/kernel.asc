static __aicore__ __attribute__((noinline))uint16_t GoalRefineLane(float z,uint16_t initial){
if(z >= 5.0f){
union{
float f;
uint32_t u;
}bits;
bits.f = z;
union{
half f;
uint16_t u;
}rounded;
rounded.u = initial;
if((bits.u & 8191U)== 4096U && z < 7.089343f && float(rounded.f)> z)
--initial;
return initial;
}
const uint32_t fast = cp6_gmg_opt::TryGeluQ30(z);
return fast < 65536U ? uint16_t(fast): cp6_gmg_opt::PreciseGeluHalfC(z);
}

template <bool FastCurve = true>
static __aicore__ __attribute__((noinline))void GoalMidpoint(__ubuf__ float *z,__ubuf__ float *u,__ubuf__ float *t,
