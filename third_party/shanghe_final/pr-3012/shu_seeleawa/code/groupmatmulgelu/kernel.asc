}
}// namespace cp6_c38

namespace cp6_c38{
__aicore__ inline void LoadMajor(__cbuf__ int8_t *a1,__cbuf__ int8_t *b1,__ca__ int8_t *a,__cb__ int8_t *b,
uint32_t tm,uint32_t mp,uint32_t np,uint32_t K,uint32_t micro){
