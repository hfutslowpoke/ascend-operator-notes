const uint32_t input = doubleA ? part % 2 : 0;
auto localA = a1 + input * tm * kp;
cp6_c38::L1R(input,true);
if(doubleA && hasNext){
if(part){
cp6_c38::L1F(1 - input,false);
cp6_c38::L1F(1 - input,true);
}
LoadX<Packed>(a1 +(1 - input)* tm * kp,x,rect.row + nextRow,nextRows,K,kp,1 - input);
}
for(uint32_t off = 0;off < kp;off += step,++phase){
