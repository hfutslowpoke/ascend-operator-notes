}
}
}

static __aicore__ __attribute__((noinline))void GeluShared(__ubuf__ float *z,__ubuf__ float *u,__ubuf__ float *t,
__ubuf__ float *d,__ubuf__ float *p,__ubuf__ float *near_zero,__ubuf__ half *out,__ubuf__ uint8_t *refine_mask,
uint32_t count,uint32_t nr,uint32_t bn){
asc_mul_sync(u,z,z,count);
asc_mul_sync(u,u,z,count);
asc_mul_scalar_sync(u,u,.044715f,count);
asc_add_sync(u,u,z,count);
asc_mul_scalar_sync(u,u,.7978846f,count);
asc_mul_scalar_sync(t,u,-2.0f,count);
asc_min_scalar_sync(t,t,8e1f,count);
asc_exp_sync(t,t,count);
asc_add_scalar_sync(d,t,1.0f,count);
asc_div_sync(p,z,d,count);
asc_float2half_rn_sync(out,p,count);
asc_abs_sync(t,z,count);
asc_add_scalar_sync(u,t,-2.0f,count);
asc_mul_scalar_sync(d,t,-1.0f,count);
asc_add_scalar_sync(d,d,8.0f,count);
asc_mul_sync(u,u,d,count);
asc_add_scalar_sync(near_zero,t,-2e-8f,count);
asc_mul_scalar_sync(d,t,-1.0f,count);
asc_add_scalar_sync(d,d,.00013f,count);
asc_mul_sync(near_zero,near_zero,d,count);
asc_max_sync(u,u,near_zero,count);
asc_set_mask_norm();
asc_set_vector_mask(~uint64_t(0),~uint64_t(0));
asc_gt_scalar_sync(refine_mask,u,0.0f,count / 64,1,1,8,8);
asc_sync_notify(PIPE_V,PIPE_S,EVENT_ID0);
asc_sync_wait(PIPE_V,PIPE_S,EVENT_ID0);
bool scalar_work = false;
for(uint32_t word = 0;word < count / 64;word +=((bn == 128 && nr <= 64)? 2 : 1)){
if(((__ubuf__ uint64_t *)refine_mask)[word]){
scalar_work = true;
break;
}
}
if(scalar_work){
asc_half2float_sync(t,out,count);
asc_sub_sync(d,p,t,count);
asc_abs_sync(d,d,count);
asc_abs_sync(t,p,count);
asc_mul_scalar_sync(near_zero,t,2e-5f,count);
asc_add_scalar_sync(near_zero,near_zero,1e-12f,count);
asc_shiftright_sync((__ubuf__ uint32_t *)t,(__ubuf__ uint32_t *)t,23,count);
asc_max_scalar_sync((__ubuf__ int32_t *)t,(__ubuf__ int32_t *)t,113,count);
asc_add_scalar_sync((__ubuf__ int32_t *)t,(__ubuf__ int32_t *)t,-11,count);
asc_shiftleft_sync((__ubuf__ uint32_t *)t,(__ubuf__ uint32_t *)t,23,count);
asc_sub_sync(d,t,d,count);
asc_sub_sync(d,near_zero,d,count);
asc_min_sync(u,u,d,count);
asc_set_mask_norm();
asc_set_vector_mask(~uint64_t(0),~uint64_t(0));
asc_gt_scalar_sync(refine_mask,u,0.0f,count / 64,1,1,8,8);
asc_sync_notify(PIPE_V,PIPE_S,EVENT_ID0);
asc_sync_wait(PIPE_V,PIPE_S,EVENT_ID0);
SharedRefineSelected(z,p,out,refine_mask,count,nr,bn);
}
}

__aicore__ inline void VectorC(__gm__ float *scale,__gm__ int64_t *groups,__gm__ half *y,__gm__ int32_t *scratch,
uint32_t E,uint32_t N,uint32_t workers,uint32_t fast_path,uint32_t deep_path){
const uint32_t slot_rows = fast_path ? SM : BM;
const uint32_t slot_count =(fast_path || deep_path)? 2 : 1;
__ubuf__ int32_t *c =(__ubuf__ int32_t *)0;
__ubuf__ float *z =(__ubuf__ float *)(4 * VQ);
__ubuf__ float *u =(__ubuf__ float *)(8 * VQ);
__ubuf__ float *t =(__ubuf__ float *)(12 * VQ);
__ubuf__ float *d =(__ubuf__ float *)(16 * VQ);
__ubuf__ float *p =(__ubuf__ float *)(20 * VQ);
__ubuf__ float *s =(__ubuf__ float *)(24 * VQ);
__ubuf__ half *out =(__ubuf__ half *)(24 * VQ + 4 * BN);
__ubuf__ uint8_t *refine_mask =(__ubuf__ uint8_t *)(26 * VQ + 4 * BN);
__ubuf__ float *near_zero =(__ubuf__ float *)c;
const uint32_t worker = asc_get_block_idx(),sub = asc_get_sub_block_id();
const uint32_t nt =(N + BN - 1)/ BN;
uint32_t ordinal = 0;
uint32_t start = 0,prefix = 0;
for(uint32_t e = 0;e < E;++e){
const uint32_t end = static_cast<uint32_t>(groups[e]),me = end - start;
const uint32_t tm = fast_path ? TileM(me): BM;
const uint32_t tasks =((me + tm - 1)/ tm)* nt;
const uint32_t first =(worker + workers - prefix % workers)% workers;
for(uint32_t task = first;task < tasks;task += workers){
const uint32_t row0 = start +(task / nt)* tm,col =(task % nt)* BN;
const uint32_t mr = Min(tm,end - row0),nr = Min(BN,N - col);
if(fast_path){
asc_duplicate_sync(s,0.0f,BN);
asc_copy_gm2ub_align_sync(s,scale + uint64_t(e)* N + col,nr * 4);
}
for(uint32_t micro = 0;micro < mr;micro += slot_rows){
const uint32_t micro_mr = Min(slot_rows,mr - micro),split = fast_path ?(micro_mr + 1)/ 2 : VM;
const uint32_t local_row = sub * split;
const uint32_t rows = micro_mr > local_row ? Min(split,micro_mr - local_row): 0;
const uint32_t slot_index = slot_count == 2 ?(ordinal % 2): 0;
__gm__ int32_t *slot = scratch +(uint64_t(worker)* slot_count + slot_index)* slot_rows * BN;
asc_sync_block_wait(READY + 2 * slot_index);
const uint32_t count = rows * BN,np = Up(nr,32);
if(rows){
asc_duplicate_sync(c,int32_t(0),count);
asc_copy_gm2ub_align(c,slot + local_row * BN,rows,np * 4,0,0,(BN - np)* 4,(BN - np)/ 8);
asc_sync();
}
if(fast_path)
ffts_cross_core_sync(PIPE_MTE2,0x21ULL |(uint64_t(DONE + 2 * slot_index)<< 8));
if(rows){
if(!fast_path){
asc_duplicate_sync(s,0.0f,BN);
asc_copy_gm2ub_align_sync(s,scale + uint64_t(e)* N + col,nr * 4);
}
asc_int322float_rn_sync(z,c,count);
for(uint32_t r = 0;r < rows;++r)
asc_mul(z + r * BN,z + r * BN,s,BN);
asc_sync();
cp6_gmg::GeluShared(z,u,t,d,p,near_zero,out,refine_mask,count,nr,BN);
asc_sync_notify(PIPE_S,PIPE_MTE3,EVENT_ID0);
asc_sync_wait(PIPE_S,PIPE_MTE3,EVENT_ID0);
asc_copy_ub2gm_align(y + uint64_t(row0 + micro + local_row)* N + col,out,rows,nr * 2,0,0,
(BN - Up(nr,16))/ 16,(N - nr)* 2);
asc_sync();
}
if(!fast_path)
ffts_cross_core_sync(PIPE_MTE3,0x21ULL |(uint64_t(DONE + 2 * slot_index)<< 8));
++ordinal;
}
}
prefix += tasks;
start = end;
}
asc_sync();
if(fast_path)
ffts_cross_core_sync(PIPE_MTE3,0x21ULL |(uint64_t(FINAL_DONE)<< 8));
}

constexpr uint32_t CK = 512;

__aicore__ inline void LoadFullKSlot(__cbuf__ int8_t *a1,__cbuf__ int8_t *b1,__ca__ int8_t *a0,__cb__ int8_t *b0,
uint32_t tm,uint32_t mp,uint32_t np,uint32_t K,uint32_t k0,uint32_t pck,uint32_t slot){
const uint32_t kp = Min(pck,K - k0);
__ca__ int8_t *aa = a0 + slot * tm * pck;
__cb__ int8_t *bb = b0 + slot * np * pck;
for(uint32_t mi = 0;mi < mp / 16;++mi)
asc_copy_l12l0a(aa + mi * kp * 16,a1 + k0 * tm + mi * 512,0,kp / 32,tm / 16,0);
for(uint32_t ni = 0;ni < np / 32;++ni)
asc_copy_l12l0b_trans(bb + ni * 1024,b1 +(ni *(K / 32)+ k0 / 32)* 1024,0,kp / 32,1,2 *(np / 32)- 1,
false,uint64_t(0));
}

__aicore__ inline void FullKPipeline(__cbuf__ int8_t *a1,__cbuf__ int8_t *b1,__ca__ int8_t *a0,__cb__ int8_t *b0,
__cc__ int32_t *c0,uint32_t tm,uint32_t mp,uint32_t np,uint32_t K){
const uint32_t pck =(tm <= 64 && np <= 64)? 512 : 256;
LoadFullKSlot(a1,b1,a0,b0,tm,mp,np,K,0,pck,0);
asc_sync();
for(uint32_t k0 = 0,slot = 0;k0 < K;k0 += pck,slot ^= 1){
const uint32_t kp = Min(pck,K - k0);
if(k0 + pck < K)
LoadFullKSlot(a1,b1,a0,b0,tm,mp,np,K,k0 + pck,pck,slot ^ 1);
asc_mmad(c0,a0 + slot * tm * pck,b0 + slot * np * pck,mp,kp,np,0,false,false,k0 == 0);
asc_sync();
}
}

__aicore__ inline void WidePrefetch(__gm__ int8_t *x,__gm__ int8_t *w,__cbuf__ int8_t *base,uint32_t e,uint32_t row,
uint32_t col,uint32_t tm,uint32_t mr,uint32_t nr,uint32_t np,uint32_t K,uint32_t N,uint32_t k0,
uint32_t slot){
const uint32_t kr = Min(256,K - k0),span =(tm + np)* 256;
__cbuf__ int8_t *aa = base + slot * span;
__cbuf__ int8_t *bb = aa + tm * 256;
asc_copy_gm2l1_nd2nz(aa,x + uint64_t(row)* K + k0,1,mr,kr,0,K,tm,1,0);
asc_copy_gm2l1_nd2nz(bb,w +(uint64_t(e)* K + k0)* N + col,1,kr,nr,0,N,kr,1,0);
}

__aicore__ inline void StreamWideK(__gm__ int8_t *x,__gm__ int8_t *w,__cbuf__ int8_t *base,__ca__ int8_t *a0,
__cb__ int8_t *b0,__cc__ int32_t *c0,uint32_t e,uint32_t row,uint32_t col,uint32_t tm,uint32_t mr,
uint32_t mp,uint32_t nr,uint32_t np,uint32_t K,uint32_t N){
const uint32_t span =(tm + np)* 256;
if(mr % 16){
ZeroL1(base,tm * 256);
ZeroL1(base + span,tm * 256);
}
WidePrefetch(x,w,base,e,row,col,tm,mr,nr,np,K,N,0,0);
asc_sync();
for(uint32_t k0 = 0,slot = 0;k0 < K;k0 += 256,slot ^= 1){
const uint32_t kp = Min(256,K - k0);
if(k0 + 256 < K)
WidePrefetch(x,w,base,e,row,col,tm,mr,nr,np,K,N,k0 + 256,slot ^ 1);
__cbuf__ int8_t *aa = base + slot * span;
__cbuf__ int8_t *bb = aa + tm * 256;
for(uint32_t mi = 0;mi < mp / 16;++mi)
asc_copy_l12l0a(a0 + mi * kp * 16,aa + mi * 512,0,kp / 32,tm / 16,0);
for(uint32_t ni = 0;ni < np / 32;++ni)
asc_copy_l12l0b_trans(
b0 + ni * 1024,bb + ni *(kp / 32)* 1024,0,kp / 32,1,2 *(np / 32)- 1,false,uint64_t(0));
asc_sync_notify(PIPE_MTE1,PIPE_M,EVENT_ID3);
asc_sync_wait(PIPE_MTE1,PIPE_M,EVENT_ID3);
asc_mmad(c0,a0,b0,mp,kp,np,0,false,false,k0 == 0);
asc_sync();
}
}

__aicore__ inline void CubeC(__gm__ int8_t *x,__gm__ int8_t *w,__gm__ int64_t *groups,__gm__ int32_t *scratch,
uint32_t E,uint32_t K,uint32_t N,uint32_t workers,uint32_t fast_path,uint32_t deep_path){
const uint32_t slot_rows = fast_path ? SM : BM;
const uint32_t slot_count =(fast_path || deep_path)? 2 : 1;
__cbuf__ int8_t *a1 =(__cbuf__ int8_t *)0;
__cbuf__ int8_t *b1 =(__cbuf__ int8_t *)static_cast<uint64_t>((fast_path ? CM : BM)* CK);
__ca__ int8_t *a0 =(__ca__ int8_t *)0;
__cb__ int8_t *b0 =(__cb__ int8_t *)0;
__cc__ int32_t *c0 =(__cc__ int32_t *)0;
const uint32_t worker = asc_get_block_idx(),nt =(N + BN - 1)/ BN;
uint32_t ordinal = 0;
uint32_t start = 0,prefix = 0;
for(uint32_t e = 0;e < E;++e){
const uint32_t end = static_cast<uint32_t>(groups[e]),me = end - start;
const uint32_t tm = fast_path ? TileM(me): BM;
const uint32_t tasks =((me + tm - 1)/ tm)* nt;
const uint32_t first =(worker + workers - prefix % workers)% workers;
const uint32_t full_a_bytes = Up(tm * K,1024);
const bool full_stage = uint64_t(full_a_bytes)+ uint64_t(K)* Min(N,BN)<= 523264ULL;
b1 =(__cbuf__ int8_t *)static_cast<uint64_t>(full_stage ? full_a_bytes :((fast_path ? CM : BM)* CK));
const uint32_t cache_col =(first % nt)* BN,cache_nr = Min(BN,N - cache_col);
const bool cache_b = first + workers < tasks &&
(full_stage ?(nt == 1 || workers % nt == 0):(N <= BN && uint64_t(K)* N <= 448ULL * 1024));
if(cache_b){
asc_copy_gm2l1_nd2nz_sync(b1,w + uint64_t(e)* K * N + cache_col,1,K,cache_nr,0,N,K,1,0);
}
for(uint32_t task = first;task < tasks;task += workers){
const uint32_t row = start +(task / nt)* tm,col =(task % nt)* BN;
const uint32_t mr = Min(tm,end - row),nr = Min(BN,N - col);
const uint32_t mp = Up(mr,16),np = Up(nr,32);
if(full_stage){
if(mr % 16)
ZeroL1(a1,tm * K);
if(fast_path){
asc_copy_gm2l1_nd2nz(a1,x + uint64_t(row)* K,1,mr,K,0,K,tm,1,0);
if(!cache_b)
asc_copy_gm2l1_nd2nz(b1,w + uint64_t(e)* K * N + col,1,K,nr,0,N,K,1,0);
asc_sync();
}else{
asc_copy_gm2l1_nd2nz_sync(a1,x + uint64_t(row)* K,1,mr,K,0,K,tm,1,0);
if(!cache_b)
asc_copy_gm2l1_nd2nz_sync(b1,w + uint64_t(e)* K * N + col,1,K,nr,0,N,K,1,0);
}
}
if(!full_stage && !cache_b && BN == 256 && K >= 1024){
StreamWideK(x,w,a1,a0,b0,c0,e,row,col,tm,mr,mp,nr,np,K,N);
}else{
if(full_stage && K >= 2048 &&((tm <= 64 && np <= 64)||(tm == 96 && np == 128))){
FullKPipeline(a1,b1,a0,b0,c0,tm,mp,np,K);
}else{
for(uint32_t k0 = 0;k0 < K;k0 += CK){
const uint32_t kr = Min(CK,K - k0),kp = Up(kr,32);
const uint32_t b_k_base =(cache_b || full_stage)? k0 / 32 : 0;
const uint32_t b_stride =(cache_b || full_stage)? K / 32 : kp / 32;
if(!full_stage && mr % 16)
ZeroL1(a1,tm * CK);
if(fast_path){
if(!full_stage){
asc_copy_gm2l1_nd2nz(a1,x + uint64_t(row)* K + k0,1,mr,kr,0,K,tm,1,0);
if(!cache_b)
asc_copy_gm2l1_nd2nz(
b1,w +(uint64_t(e)* K + k0)* N + col,1,kr,nr,0,N,kp,1,0);
asc_sync();
}
for(uint32_t mi = 0;mi < mp / 16;++mi)
asc_copy_l12l0a(a0 + mi * kp * 16,a1 +(full_stage ? k0 * tm : 0)+ mi * 512,0,
kp / 32,tm / 16,0);
for(uint32_t ni = 0;ni < np / 32;++ni)
asc_copy_l12l0b_trans(b0 + ni * 1024,b1 +(ni * b_stride + b_k_base)* 1024,0,
kp / 32,1,2 *(np / 32)- 1,false,uint64_t(0));
asc_sync();
}else{
if(!full_stage){
asc_copy_gm2l1_nd2nz_sync(a1,x + uint64_t(row)* K + k0,1,mr,kr,0,K,tm,1,0);
if(!cache_b)
asc_copy_gm2l1_nd2nz_sync(
b1,w +(uint64_t(e)* K + k0)* N + col,1,kr,nr,0,N,kp,1,0);
}
for(uint32_t mi = 0;mi < mp / 16;++mi)
asc_copy_l12l0a_sync(a0 + mi * kp * 16,a1 +(full_stage ? k0 * tm : 0)+ mi * 512,0,
kp / 32,tm / 16,0);
for(uint32_t ni = 0;ni < np / 32;++ni)
asc_copy_l12l0b_trans_sync(b0 + ni * 1024,b1 +(ni * b_stride + b_k_base)* 1024,0,
kp / 32,1,2 *(np / 32)- 1,false,uint64_t(0));
}
asc_mmad_sync(c0,a0,b0,mp,kp,np,0,false,false,k0 == 0);
}
}
}
asc_set_l0c_copy_params(1,0,0);
for(uint32_t micro = 0;micro < mr;micro += slot_rows){
const uint32_t slot_index = slot_count == 2 ?(ordinal % 2): 0;
__gm__ int32_t *slot = scratch +(uint64_t(worker)* slot_count + slot_index)* slot_rows * BN;
if(ordinal >= slot_count)
asc_sync_block_wait(DONE + 2 * slot_index);
asc_copy_l0c2gm_sync(
slot,c0 + micro * 16,np,Min(slot_rows,mr - micro),BN,mp,0,0,0,false,true);
ffts_cross_core_sync(PIPE_FIX,0x21ULL |(uint64_t(READY + 2 * slot_index)<< 8));
++ordinal;
}
}
prefix += tasks;
start = end;
}
for(uint32_t j = ordinal > slot_count ? ordinal - slot_count : 0;j < ordinal;++j)
asc_sync_block_wait(DONE + 2 *(slot_count == 2 ?(j % 2): 0));
if(fast_path)
asc_sync_block_wait(FINAL_DONE);
}
}// namespace cp6_gmg

__global__ __mix__(1,2)void grouped_matmul_gelu_cp6_b0_copt(__gm__ int8_t *x,__gm__ int8_t *weight,
__gm__ float *scale,__gm__ int64_t *group_list,__gm__ half *y,__gm__ int32_t *scratch,uint32_t E,uint32_t K,
uint32_t N,uint32_t workers,uint64_t sync_base){
const uint32_t fast_path =(N >> 30)& 1U;
const uint32_t deep_path = !fast_path &&((N >> 29)& 1U);
N &= 0x1fffffffU;
set_ffts_base_addr(sync_base);
asc_init();
if ASC_IS_AIC{
cp6_gmg::CubeC(x,weight,group_list,scratch,E,K,N,workers,fast_path,deep_path);
}
if ASC_IS_AIV{
cp6_gmg::VectorC(scale,group_list,y,scratch,E,N,workers,fast_path,deep_path);
}
asc_sync();
}

namespace cp6_gmg_opt{
__aicore__ inline uint32_t Min(uint32_t a,uint32_t b){return a < b ? a : b;}

__aicore__ inline uint32_t Up(uint32_t x,uint32_t a){return(x + a - 1)/ a * a;}

__aicore__ inline int64_t QMul(int64_t a,int64_t b){return fast_gmg::QMul(a,b);}

__aicore__ inline void ZeroL1(__cbuf__ int8_t *p,uint32_t bytes){
asc_fill_value_config cfg;
cfg.config = 0;
cfg.repeat = 1;
cfg.blk_num = bytes / 32;
cfg.dst_gap = 0;
asc_fill_l1_sync((__cbuf__ uint16_t *)p,uint32_t(0),cfg);
}

__aicore__ inline uint16_t PreciseGeluHalfC(float z){return cp6_gmg::PreciseGeluHalfC(z);}

static __aicore__ __attribute__((always_inline))inline uint32_t TryGeluQ30(float z){
union{
float f;
uint32_t u;
}bits;
bits.f = z;
const uint32_t ab = bits.u & 0x7fffffffU,sign = bits.u >> 31;
if(ab <= 0x40000000U || ab >= 0x41000000U)
return 65536U;
const uint64_t zn = uint64_t((ab & 0x7fffffU)| 0x800000U)<<((ab >> 23)- 126);
const uint64_t sq36 =(zn * zn +(1ULL << 17))>> 18;
const uint64_t cube31 =(sq36 * zn +(1ULL << 31))>> 32;
const uint64_t a =(zn * 6853776189ULL + cube31 * 1225866409ULL +(1ULL << 25))>> 26;
const uint32_t power = uint32_t(a / 744261118ULL);
const int64_t rr = int64_t(a - uint64_t(power)* 744261118ULL);
int64_t v = 296LL;
v = -2959LL +((v * rr +(1LL << 29))>> 30);
v = 26631LL +((v * rr +(1LL << 29))>> 30);
v = -213044LL +((v * rr +(1LL << 29))>> 30);
v = 1491308LL +((v * rr +(1LL << 29))>> 30);
v = -8947849LL +((v * rr +(1LL << 29))>> 30);
v = 44739243LL +((v * rr +(1LL << 29))>> 30);
v = -178956971LL +((v * rr +(1LL << 29))>> 30);
v = 536870912LL +((v * rr +(1LL << 29))>> 30);
v = -1073741824LL +((v * rr +(1LL << 29))>> 30);
v = 1073741824LL +((v * rr +(1LL << 29))>> 30);
const uint64_t tail = power < 31 ? uint64_t(v)>> power : 0;
const uint64_t denom =(1ULL << 30)+ tail;
const uint64_t factor = sign ?(uint64_t(v)<< 30)/ denom :(1ULL << 60)/ denom;
const uint64_t mag = zn * factor;
const int exponent = -54 -(sign ? int(power): 0);
const uint32_t top = 63 - __builtin_clzll(mag);
const int e = int(top)+ exponent;
const uint32_t shift = e >= -14 ? top - 10 : uint32_t(-exponent - 24);
if(shift >= 63)
return sign << 15;
const uint64_t mask =(1ULL << shift)- 1,halfway = 1ULL <<(shift - 1),rem = mag & mask;
const uint64_t distance = rem > halfway ? rem - halfway : halfway - rem;
if(distance <=(mag >> 22)+ 8)
return 65536U;
uint32_t rounded = uint32_t(mag >> shift);
rounded +=(rem > halfway ||(rem == halfway &&(rounded & 1)));
const uint32_t field = e >= -14 ? uint32_t(e + 15): 0;
return(sign << 15)|(field ?(field - 1)* 1024 + rounded : rounded);
}

static __aicore__ inline bool AnyMaskNonzero(
__ubuf__ uint8_t *mask,__ubuf__ float *temp,__ubuf__ float *maxima,uint32_t count){
const uint32_t words = count / 32,parts =(words + 63)/ 64;
asc_int322float_rn(temp,(__ubuf__ int32_t *)mask,words);
asc_sync_pipe(PIPE_V);
asc_abs(temp,temp,words);
asc_sync_pipe(PIPE_V);
for(uint32_t j = 0;j < parts;++j){
const uint32_t left = words - j * 64,n = left < 64 ? left : 64;
asc_repeat_reduce_max_only_value(maxima + j * 8,temp + j * 64,n);
}
asc_sync_notify(PIPE_V,PIPE_S,EVENT_ID1);
asc_sync_wait(PIPE_V,PIPE_S,EVENT_ID1);
for(uint32_t j = 0;j < parts;++j)
if(maxima[j * 8] > 0.0f)
return true;
return false;
}

static __aicore__ inline void SharedRefineCached33(__ubuf__ float *z,__ubuf__ float *p,__ubuf__ half *out,
__ubuf__ uint8_t *refine_mask,uint32_t count,uint32_t nr,uint32_t bn){
__ubuf__ uint32_t *cache_keys =(__ubuf__ uint32_t *)184320;
__ubuf__ uint16_t *cache_initial =(__ubuf__ uint16_t *)188416;
__ubuf__ uint16_t *cache_values =(__ubuf__ uint16_t *)190464;
uint32_t visits = 0;
bool cache_active = false;
const uint32_t fast_refine = 0;
const uint32_t word_step =(bn == 128 && nr <= 64)? 2 : 1;
for(uint32_t word = 0;word < count / 64;word += word_step){
uint64_t selected =((__ubuf__ uint64_t *)refine_mask)[word];
while(selected){
const uint32_t bit = __builtin_ctzll(selected),i = word * 64 + bit;
const float zi = z[i];
union{
float f;
uint32_t u;
}key;
key.f = zi;
const uint16_t initial_bits =((__ubuf__ uint16_t *)out)[i];
const uint32_t mixed = key.u ^(key.u >> 8)^(key.u >> 16)^(key.u >> 24);
const uint32_t cache_slot = mixed & 1023U;
if(!cache_active && ++visits == 4){
asc_sync_notify(PIPE_S,PIPE_V,EVENT_ID0);
asc_sync_wait(PIPE_S,PIPE_V,EVENT_ID0);
asc_duplicate((__ubuf__ int32_t *)cache_keys,int32_t(0x7fc00000U),uint32_t(1024));
asc_sync_notify(PIPE_V,PIPE_S,EVENT_ID1);
asc_sync_wait(PIPE_V,PIPE_S,EVENT_ID1);
cache_active = true;
}
if(cache_active && cache_keys[cache_slot] == key.u && cache_initial[cache_slot] == initial_bits){
((__ubuf__ uint16_t *)out)[i] = cache_values[cache_slot];
selected &= selected - 1;
continue;
}
if(zi >= 5.0f){
union{
float f;
uint32_t u;
}value_bits;
value_bits.f = zi;
if((value_bits.u & 8191U)== 4096U && zi < 7.089343f && float(out[i])> zi)
--((__ubuf__ uint16_t *)out)[i];
if(cache_active){
cache_keys[cache_slot] = key.u;
cache_initial[cache_slot] = initial_bits;
cache_values[cache_slot] =((__ubuf__ uint16_t *)out)[i];
}
selected &= selected - 1;
continue;
}
float distance = 1.0f;
if(fast_refine && zi > 2.0f && zi < 8.0f){
const float delta = p[i] - float(out[i]);
distance = delta < 0.0f ? -delta : delta;
}
if(!fast_refine || !(zi > 2.0f && zi < 8.0f && distance <= .00075f)){
const uint32_t fast = TryGeluQ30(zi);
((__ubuf__ uint16_t *)out)[i] = fast < 65536U ? uint16_t(fast): PreciseGeluHalfC(zi);
}
if(cache_active){
cache_keys[cache_slot] = key.u;
cache_initial[cache_slot] = initial_bits;
cache_values[cache_slot] =((__ubuf__ uint16_t *)out)[i];
}
selected &= selected - 1;
}
}
}

static __aicore__ inline void GeluMargin48(__ubuf__ float *approx,__ubuf__ half *out,__ubuf__ float *delta,
__ubuf__ float *exponent,__ubuf__ float *guard,__ubuf__ uint8_t *mask,uint32_t count){
asc_half2float(delta,out,count);
asc_sync_pipe(PIPE_V);
asc_sub(delta,approx,delta,count);
asc_sync_pipe(PIPE_V);
asc_abs(delta,delta,count);
asc_sync_pipe(PIPE_V);
asc_abs(exponent,approx,count);
asc_sync_pipe(PIPE_V);
asc_mul_scalar(guard,exponent,1.15e-6f,count);
asc_sync_pipe(PIPE_V);
asc_mul_scalar(approx,approx,-8.5e-7f,count);
asc_sync_pipe(PIPE_V);
