namespace r6_row{
using namespace fast_gmg;

__aicore__ inline uint16_t Half(float v){
union{
float f;
uint32_t u;
}b;
b.f = v;
const uint32_t mag = b.u & 0x7fffffffU,sign =(b.u >> 16)& 0x8000U;
const uint32_t rounded = mag + 4095U +((mag >> 13)& 1U);
return uint16_t(sign |((rounded >> 13)- 0x1c000U));
}

__aicore__ inline uint16_t Micro(float z){
union{
float f;
uint32_t u;
}bits,ab;
bits.f = z;
ab.u = bits.u & 0x7fffffffU;
const float a = ab.f;
if(a < 2e-8f)
return uint16_t(bits.u >> 16)& 0x8000U;
if(z <= -5.3125f)
return uint16_t(0x8000U);
if(z >= 7.125f)
return Half(z);
const float u =(z * z)* .25f;
float p = .001174664f;
p = p * u +(-.008261726f);
p = p * u +(.0304206f);
p = p * u +(-.07956864f);
p = p * u +(.16321944f);
p = p * u +(-.26727712f);
p = p * u +(.39894226f);
return Half(z *(.5f + z * p));
}
}// namespace r6_row

template <uint32_t KF>
__vector__ __global__ __aicore__ __attribute__((section(".text.extra_tiny")))void grouped_matmul_gelu_A_row5(
__gm__ int8_t *x,__gm__ int8_t *weight,__gm__ float *scale,__gm__ int64_t *groups,__gm__ half *y,uint32_t E){
asc_init();
asc_datacache_preload((__gm__ uint64_t *)groups,0);
asc_datacache_preload((__gm__ uint64_t *)x,0);
asc_datacache_preload((__gm__ uint64_t *)weight,0);
asc_datacache_preload((__gm__ uint64_t *)scale,0);
constexpr uint32_t K = KF,VQ = 4096,N = 5;
const uint32_t row = asc_get_block_idx();
uint32_t lo = 0,hi = E - 1;
if(E == 3){
const uint32_t e0 = uint32_t(groups[0]),e1 = uint32_t(groups[1]);
lo = uint32_t(row >= e0)+ uint32_t(row >= e1);
}else
while(lo < hi){
const uint32_t mid = lo +(hi - lo)/ 2;
if(groups[mid] <= int64_t(row))
lo = mid + 1;
else
hi = mid;
}
__gm__ int8_t *xp = x + row * K;
__gm__ int8_t *w = weight + uint64_t(lo)* K * N;
const int32_t a0 = int32_t(xp[0]),a1 = int32_t(xp[1]),a2 = K > 2 ? int32_t(xp[2]): 0,
a3 = K > 3 ? int32_t(xp[3]): 0;
float zs[5] ={0,0,0,0,0};
bool unsafe = false,all_centre = true;
#pragma unroll
for(uint32_t n = 0;n < 5;++n)
if(n < N){
int32_t c = a0 * int32_t(w[n])+ a1 * int32_t(w[N + n]);
if(K > 2)
c += a2 * int32_t(w[2 * N + n]);
if(K > 3)
c += a3 * int32_t(w[3 * N + n]);
const float z = float(c)* scale[uint64_t(lo)* N + n];
zs[n] = z;
union{
float f;
uint32_t u;
}b;
b.f = z;
const uint32_t a = b.u & 0x7fffffffU;
const bool centre = uint32_t(a - 0x390022d0U)< uint32_t(0x40028f5cU - 0x390022d0U);
all_centre = all_centre && centre;
unsafe = unsafe ||(!centre && a >= 0x32abcc77U && z > -5.3125f && z < 7.125f);
}
__ubuf__ half *source;
if(unsafe){
__ubuf__ float *z =(__ubuf__ float *)(4 * VQ);
asc_duplicate_sync(z,0.0f,64);
asc_sync_notify(PIPE_V,PIPE_S,EVENT_ID0);
asc_sync_wait(PIPE_V,PIPE_S,EVENT_ID0);
#pragma unroll
for(uint32_t n = 0;n < 5;++n)
if(n < N)
z[n] = zs[n];
asc_sync_notify(PIPE_S,PIPE_V,EVENT_ID0);
asc_sync_wait(PIPE_S,PIPE_V,EVENT_ID0);
gmg16::FinishGelu(64);
source =(__ubuf__ half *)(24 * VQ + 512);
}else{
uint16_t codes[5];
if(all_centre){
const float u0 =(zs[0] * zs[0])* .25f,u1 =(zs[1] * zs[1])* .25f,u2 =(zs[2] * zs[2])* .25f,
u3 =(zs[3] * zs[3])* .25f,u4 =(zs[4] * zs[4])* .25f;
float p0 = .001174664f,p1 = p0,p2 = p0,p3 = p0,p4 = p0;
p0 = p0 * u0 +(-.008261726f);
p1 = p1 * u1 +(-.008261726f);
p2 = p2 * u2 +(-.008261726f);
p3 = p3 * u3 +(-.008261726f);
p4 = p4 * u4 +(-.008261726f);
p0 = p0 * u0 +(.0304206f);
p1 = p1 * u1 +(.0304206f);
p2 = p2 * u2 +(.0304206f);
p3 = p3 * u3 +(.0304206f);
p4 = p4 * u4 +(.0304206f);
p0 = p0 * u0 +(-.07956864f);
p1 = p1 * u1 +(-.07956864f);
p2 = p2 * u2 +(-.07956864f);
p3 = p3 * u3 +(-.07956864f);
p4 = p4 * u4 +(-.07956864f);
p0 = p0 * u0 +(.16321944f);
p1 = p1 * u1 +(.16321944f);
p2 = p2 * u2 +(.16321944f);
p3 = p3 * u3 +(.16321944f);
p4 = p4 * u4 +(.16321944f);
p0 = p0 * u0 +(-.26727712f);
p1 = p1 * u1 +(-.26727712f);
p2 = p2 * u2 +(-.26727712f);
p3 = p3 * u3 +(-.26727712f);
p4 = p4 * u4 +(-.26727712f);
p0 = p0 * u0 +(.39894226f);
p1 = p1 * u1 +(.39894226f);
p2 = p2 * u2 +(.39894226f);
p3 = p3 * u3 +(.39894226f);
p4 = p4 * u4 +(.39894226f);
codes[0] = r6_row::Half(zs[0] *(.5f + zs[0] * p0));
codes[1] = r6_row::Half(zs[1] *(.5f + zs[1] * p1));
codes[2] = r6_row::Half(zs[2] *(.5f + zs[2] * p2));
codes[3] = r6_row::Half(zs[3] *(.5f + zs[3] * p3));
codes[4] = r6_row::Half(zs[4] *(.5f + zs[4] * p4));
}else{
#pragma unroll
for(uint32_t n = 0;n < 5;++n)
codes[n] = r6_row::Micro(zs[n]);
}
const uint64_t packed0 = uint64_t(codes[0])|(uint64_t(codes[1])<< 16)|(uint64_t(codes[2])<< 32)|
(uint64_t(codes[3])<< 48),
packed1 = codes[4];
__ubuf__ uint64_t *out =(__ubuf__ uint64_t *)0;
out[0] = packed0;
out[1] = packed1;
out[2] = 0;
out[3] = 0;
asc_sync_notify(PIPE_S,PIPE_MTE3,EVENT_ID0);
asc_sync_wait(PIPE_S,PIPE_MTE3,EVENT_ID0);
source =(__ubuf__ half *)0;
}
asc_copy_ub2gm_align(y + uint64_t(row)* N,source,N * 2);
asc_sync();
}

namespace a23_r5_rne{
using namespace fast_gmg;

__aicore__ inline uint16_t Half(float v){
union{
float f;
uint32_t u;
}b;
b.f = v;
const uint32_t mag = b.u & 0x7fffffffU,sign =(b.u >> 16)& 0x8000U;
const uint32_t rounded = mag + 4095U +((mag >> 13)& 1U);
return uint16_t(sign |((rounded >> 13)- 0x1c000U));
}

static __aicore__ __attribute__((always_inline))inline uint16_t NegativeNormal(float z){
const float x = -z;
const float a = 1.5957692f *(x + .044715f *(x * x)* x);
const int32_t n = int32_t(a * 1.442695f + .5f);
const float nf = float(n);
const float r =(-a + nf * .69314575f)+ nf * 1.4286068e-6f;
float p = 1.0f / 5040.0f;
p = p * r + 1.0f / 720.0f;
p = p * r + 1.0f / 120.0f;
p = p * r + 1.0f / 24.0f;
p = p * r + 1.0f / 6.0f;
p = p * r + .5f;
p = p * r + 1.0f;
p = p * r + 1.0f;
union{
uint32_t u;
float f;
}power;
power.u = uint32_t(127 - n)<< 23;
const float t = p * power.f;
float inv = 1.0f - t;
inv = inv *(2.0f -(1.0f + t)* inv);
return Half((z * t)* inv);
}
}// namespace a23_r5_rne

