grouped_matmul_gelu_A_pack2_family(__gm__ int8_t *__restrict__ x,__gm__ int8_t *__restrict__ w,
__gm__ float *__restrict__ scale,__gm__ int64_t *__restrict__ groups,__gm__ half *__restrict__ y,
uint32_t experts,uint32_t outputs){
WideFamily<false>(x,w,scale,groups,y,experts,0);
}

