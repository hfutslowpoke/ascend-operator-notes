__aicore__ inline void CubeFullOwned(
__gm__ int8_t *x,__gm__ int8_t *w,__gm__ int32_t *scratch,uint32_t E,uint32_t K,uint32_t N,uint32_t W){
constexpr uint32_t tm = 128;
