__aicore__ __attribute__((always_inline))inline void Other6GroupHersAdaptive(__gm__ int8_t *x,__gm__ int8_t *w,
__gm__ float *scale,__gm__ int64_t *groups,__gm__ half *y,__gm__ int32_t *scratch,uint32_t E,uint32_t K,
uint32_t N,uint32_t workers,uint64_t sync_base,uint32_t l1,bool empty){
if ASC_IS_AIC
hers_adaptive_full::Cube<false>(x,w,groups,scratch,E,K,N,workers,l1);
if ASC_IS_AIV{
if(empty){
const uint32_t active = other6_group_meta::Build(E);
other6_group_meta::Warm<1>(w,active,K,N,workers);
}else
shared_weight_prefetch::Read<1,false,true>(w,E,K,N,workers);
other6_group_hadapt::Frames frames{other6_group_hsmooth::Schedule(groups,E,N,workers)};
hers_post::Vector<2,32768,false>(frames,scale,groups,y,scratch,N);
}
asc_sync();
}

namespace other6_hers_chunk_rect{
using dfocus::Min;
using dfocus::Up;
constexpr uint32_t RowCap = 512;
struct Rect{
uint32_t expert,row,rows,col,cols;
};
struct Rects{
uint32_t expert = 0,row = 0,col = 0,left = 0;
__aicore__ __attribute__((always_inline))inline Rect Next(__gm__ int64_t *groups,uint32_t width){
const uint32_t blocks =(width + 31)/ 32;
while(left){
const uint32_t end = uint32_t(other6_group_meta::End(groups,expert));
if(row < end){
const uint32_t rows = Min(RowCap,end - row),take = Min(Min(blocks - col,left),10U);
Rect r{expert,row,rows,col * 32,Min(take * 32,width - col * 32)};
left -= take;
col += take;
if(col == blocks){
col = 0;
row += rows;
if(row == end)
++expert;
}
return r;
}
++expert;
}
return{};
}
};
__aicore__ __attribute__((always_inline))inline uint32_t Cost(uint32_t rows){return Up(rows,128)+ 512;}
__aicore__ __attribute__((always_inline))inline Rects Schedule(
__gm__ int64_t *groups,uint32_t E,uint32_t width,uint32_t workers){
const uint32_t blocks =(width + 31)/ 32,worker = asc_get_block_idx();
uint32_t weight = 0,previous = 0;
for(uint32_t e = 0;e < E;++e){
const uint32_t end = uint32_t(other6_group_meta::End(groups,e));
for(uint32_t row = previous;row < end;row += RowCap)
weight += blocks * Cost(Min(RowCap,end - row));
previous = end;
}
const uint32_t lower = weight * worker / workers,upper = weight *(worker + 1)/ workers;
uint32_t prefix = 0,ordinal = 0,first = 0,last = 0;
bool found = false,done = false;
Rects result{};
previous = 0;
for(uint32_t e = 0;e < E && !done;++e){
const uint32_t end = uint32_t(other6_group_meta::End(groups,e));
for(uint32_t row = previous;row < end;row += RowCap){
const uint32_t cost = Cost(Min(RowCap,end - row)),limit = prefix + blocks * cost;
if(!found && lower < limit){
result.expert = e;
result.row = row;
result.col =(lower - prefix)/ cost;
first = ordinal + result.col;
found = true;
}
if(upper <= limit){
last = ordinal +(upper - prefix)/ cost;
done = true;
break;
}
ordinal += blocks;
prefix = limit;
}
previous = end;
}
if(found)
result.left = last - first;
return result;
}
}// namespace other6_hers_chunk_rect

