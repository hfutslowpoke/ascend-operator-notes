namespace matrix_tail{
static __aicore__ __attribute__((noinline,section(".zleaf_mat")))uint32_t TinyFixed(uint32_t bits){
const uint32_t e =(bits >> 23)& 255U;
const uint64_t m =(bits & 0x7fffffU)| 0x800000U;
const uint64_t base = m <<(e - 95U),square =(m * m)>>(244U - 2U * e);
const uint64_t corr =(square * 1713444047ULL)>> 32;
const bool neg = bits >> 31;
const uint64_t v = neg ? base - corr : base + corr;
if(uint32_t(v)- 0x7ffffff8U <= 16U)
return 0;
return 0x10000U |(neg ? 0x8000U : 0U)| uint32_t((v + 2147483647ULL +((v >> 32)& 1U))>> 32);
}

static __aicore__ __attribute__((noinline,section(".zleaf_mat")))uint64_t Eval(uint32_t mag,uint32_t &guard){
const uint32_t offset = mag - 0x40800000U,segment = offset >> 20;
const int64_t d = int64_t(offset & 0xfffffU)- 524288LL;
int64_t a;
if(segment == 0){
a = -1817061LL;
a =((a * d)>> 19)+(-143463305LL);
a =((a * d)>> 19)+(2227856915LL);
a =((a * d)>> 19)+(-18915221908LL);
a =((a * d)>> 19)+(108193859886LL);
a =((a * d)>> 19)+(-430152588778LL);
a =((a * d)>> 19)+(1154140937117LL);
a =((a * d)>> 19)+(-1896595270786LL);
a =((a * d)>> 19)+(1451386642012LL);
guard = 5990U;
}else if(segment == 1){
a = 5955635LL;
a =((a * d)>> 19)+(-72342173LL);
a =((a * d)>> 19)+(569831812LL);
a =((a * d)>> 19)+(-3283363350LL);
a =((a * d)>> 19)+(14034833123LL);
a =((a * d)>> 19)+(-43829477560LL);
a =((a * d)>> 19)+(95288590845LL);
a =((a * d)>> 19)+(-129628219750LL);
a =((a * d)>> 19)+(83428324238LL);
guard = 826U;
}else{
a = 1685390LL;
a =((a * d)>> 19)+(-12398436LL);
a =((a * d)>> 19)+(67290319LL);
a =((a * d)>> 19)+(-294193647LL);
a =((a * d)>> 19)+(995685569LL);
a =((a * d)>> 19)+(-2527449075LL);
a =((a * d)>> 19)+(4553596634LL);
a =((a * d)>> 19)+(-5209458424LL);
a =((a * d)>> 19)+(2852373791LL);
guard = 712U;
}
