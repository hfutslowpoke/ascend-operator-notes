namespace cp6_c38{
template <uint32_t P>
__aicore__ inline void StreamPrefetch(__gm__ int8_t *x,__gm__ int8_t *w,__cbuf__ int8_t *base,uint32_t e,
uint32_t row,uint32_t col,uint32_t tm,uint32_t mr,uint32_t nr,uint32_t K,uint32_t N,uint32_t outer,
uint32_t stage){
