// Device helpers for tiled INT8 accumulation and FP16 GELU rounding.
namespace fast_gmg{
constexpr uint32_t BM = 64,BN = 128,BK = 128,VM = 32,VQ = VM * BN;

__aicore__ inline int64_t QMul(int64_t a,int64_t b){
const bool neg =(a < 0)!=(b < 0);
const uint64_t ua = a < 0 ? uint64_t(-a): uint64_t(a);
const uint64_t ub = b < 0 ? uint64_t(-b): uint64_t(b);
constexpr uint64_t mask =(1ULL << 28)- 1;
const uint64_t ah = ua >> 28,al = ua & mask,bh = ub >> 28,bl = ub & mask;
const uint64_t cross = ah * bl + al * bh;
const uint64_t low =((cross & mask)<< 28)+ al * bl;
uint64_t v = ah * bh +(cross >> 28)+(low >> 56);
v +=((low &((1ULL << 56)- 1))>=(1ULL << 55));
return neg ? -int64_t(v): int64_t(v);
}

__aicore__ inline uint32_t TryFastGeluHalf(float z){
union{
float f;
uint32_t u;
}b;
b.f = z;
const uint32_t mag = b.u & 0x7fffffffU;
if((b.u >> 31)&& mag >= 0x40b00000U)
return 0x18000U;
if(!(b.u >> 31)&& mag >= 0x40800000U && mag < 0x41000000U){
const uint32_t code =((((mag >> 23)& 255)- 112)<< 10)|((mag >> 13)& 1023),r = mag & 8191;
if(r < 4096)
return 0x10000U | code;
if(r >= 4352 ||(mag >= 0x40a00000U && r > 4096))
return 0x10000U |(code + 1);
if(r == 4096 && mag < 0x40c00000U)
return 0x10000U | code;
}
return 0;
}

__aicore__ inline uint16_t PreciseGeluHalf(float z){
const uint32_t fast = TryFastGeluHalf(z);
if(fast & 0x10000U)
return uint16_t(fast);
constexpr int64_t one = 72057594037927936LL,ln2 = 49946518145322874LL;
union{
float f;
uint32_t u;
}bits;
bits.f = z;
const uint32_t sign = bits.u >> 31;
const int shift = int((bits.u >> 23)& 255)- 127 + 33;
const uint64_t mant =(bits.u & 0x7fffffU)| 0x800000U;
int64_t x = shift >= 0 ? int64_t(mant << shift): int64_t(mant >>(-shift));
if(sign)
x = -x;
int64_t u = QMul(57493641771463300LL,QMul(x,one + QMul(3222055317405948LL,QMul(x,x))));
const int64_t a = 2 *(u < 0 ? -u : u);
const uint32_t power = uint32_t(a / ln2);
const int64_t r = -a + int64_t(power)* ln2;
int64_t v = 1;
v = 11 + QMul(v,r);
v = 203 + QMul(v,r);
v = 3444 + QMul(v,r);
v = 55104 + QMul(v,r);
v = 826554 + QMul(v,r);
v = 11571761 + QMul(v,r);
v = 150432888 + QMul(v,r);
v = 1805194656LL + QMul(v,r);
v = 19857141214LL + QMul(v,r);
v = 198571412142LL + QMul(v,r);
v = 1787142709274LL + QMul(v,r);
v = 14297141674192LL + QMul(v,r);
v = 100079991719344LL + QMul(v,r);
v = 600479950316066LL + QMul(v,r);
v = 3002399751580331LL + QMul(v,r);
v = 12009599006321323LL + QMul(v,r);
v = 36028797018963968LL + QMul(v,r);
v = one + QMul(v,r);
v = one + QMul(v,r);
const int64_t t = power >= 56 ? 0 :(v >> power),denom = one + t;
int64_t inv = one / 2;
for(uint32_t j = 0;j < 7;++j)
inv = QMul(inv,2 * one - QMul(denom,inv));
const int64_t val =(!sign && a >= 53 * ln2)? x : QMul(sign ? QMul(x,t): x,inv);
const uint64_t mag = val < 0 ? uint64_t(-val): uint64_t(val);
if(!mag)
return uint16_t(sign << 15);
uint32_t shift_out = 32,exp_field = 0;
if(mag >=(1ULL << 42)){
const uint32_t top = 63 - __builtin_clzll(mag);
shift_out = top - 10;
exp_field = top - 56 + 15;
}
uint32_t rounded = uint32_t(mag >> shift_out);
const uint64_t rem = mag &((1ULL << shift_out)- 1),halfway = 1ULL <<(shift_out - 1);
rounded +=(rem > halfway ||(rem == halfway &&(rounded & 1)));
uint32_t code = exp_field ?((exp_field - 1)* 1024 + rounded): rounded;
return uint16_t((sign << 15)| code);
}

__aicore__ inline uint16_t PreciseGeluHalfLeaf(float z){
constexpr int64_t one = 72057594037927936LL,ln2 = 49946518145322874LL;
union{
float f;
uint32_t u;
}bits;
bits.f = z;
const uint32_t sign = bits.u >> 31;
const int shift = int((bits.u >> 23)& 255)- 127 + 33;
const uint64_t mant =(bits.u & 0x7fffffU)| 0x800000U;
int64_t x = shift >= 0 ? int64_t(mant << shift): int64_t(mant >>(-shift));
if(sign)
x = -x;
int64_t u = QMul(57493641771463300LL,QMul(x,one + QMul(3222055317405948LL,QMul(x,x))));
const int64_t a = 2 *(u < 0 ? -u : u);
const uint32_t power = uint32_t(a / ln2);
const int64_t r = -a + int64_t(power)* ln2;
int64_t v = 1;
v = 11 + QMul(v,r);
v = 203 + QMul(v,r);
v = 3444 + QMul(v,r);
v = 55104 + QMul(v,r);
v = 826554 + QMul(v,r);
v = 11571761 + QMul(v,r);
v = 150432888 + QMul(v,r);
v = 1805194656LL + QMul(v,r);
v = 19857141214LL + QMul(v,r);
v = 198571412142LL + QMul(v,r);
v = 1787142709274LL + QMul(v,r);
v = 14297141674192LL + QMul(v,r);
v = 100079991719344LL + QMul(v,r);
v = 600479950316066LL + QMul(v,r);
v = 3002399751580331LL + QMul(v,r);
v = 12009599006321323LL + QMul(v,r);
v = 36028797018963968LL + QMul(v,r);
v = one + QMul(v,r);
v = one + QMul(v,r);
const int64_t t = power >= 56 ? 0 :(v >> power),denom = one + t;
int64_t inv = one / 2;
for(uint32_t j = 0;j < 7;++j)
inv = QMul(inv,2 * one - QMul(denom,inv));
const int64_t val =(!sign && a >= 53 * ln2)? x : QMul(sign ? QMul(x,t): x,inv);
const uint64_t mag = val < 0 ? uint64_t(-val): uint64_t(val);
if(!mag)
return uint16_t(sign << 15);
uint32_t shift_out = 32,exp_field = 0;
if(mag >=(1ULL << 42)){
const uint32_t top = 63 - __builtin_clzll(mag);
shift_out = top - 10;
exp_field = top - 56 + 15;
}
uint32_t rounded = uint32_t(mag >> shift_out);
const uint64_t rem = mag &((1ULL << shift_out)- 1),halfway = 1ULL <<(shift_out - 1);
rounded +=(rem > halfway ||(rem == halfway &&(rounded & 1)));
uint32_t code = exp_field ?((exp_field - 1)* 1024 + rounded): rounded;
return uint16_t((sign << 15)| code);
}
