template <uint32_t P> __aicore__ inline uint32_t TileM(uint32_t me){
if(P == 2)
return me == 0 ? 16 : Min(Up(me,16),128U);
if(P == 1)
return me <= 16 ? 16 :(me <= 32 ? 32 :(me <= 64 ? 64 :(me <= 96 ? Up(me,16): 128)));
return me <= 16 ? 16 :(me <= 32 ? 32 :(me > 64 && me <= 96 ? Up(me,16): 64));
}

template <uint32_t TM> __aicore__ inline bool Uniform(__gm__ int64_t *g,uint32_t E,uint32_t W){
if(W < 16)
return false;
for(uint32_t e = 0;e < E;++e)
if(g[e] != int64_t(e + 1)* TM)
return false;
return true;
}

