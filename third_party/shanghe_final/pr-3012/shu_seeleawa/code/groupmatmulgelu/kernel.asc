Dot<TM,BN,CK,LK>(w,base,a,b,c,e,col,K,N,tile != 0,lease);
const bool hasnext = tile + 1 < N / BN;
if(hasnext)
for(uint32_t j = 0;j < 2;++j)
Prefetch<TM,BN,CK,LK>(w,base,e,(tile + 1)* BN,j,j,K,N);
asc_set_l0c_copy_params(1,0,0);
constexpr uint32_t sr = 16384 / BN;
for(uint32_t m = 0;m < TM;m += sr){
const uint32_t si = ordinal % 2;
__gm__ int32_t *dst = scratch +(uint64_t(worker)* 2 + si)* 16384;
if(ordinal >= 2)
asc_sync_block_wait(9 + 2 * si);
asc_copy_l0c2gm(dst,c + m * 16,BN,sr,BN,TM,0,0,0,false,true);
