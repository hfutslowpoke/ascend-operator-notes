}
}

template <uint32_t P>
__aicore__ inline void CubeStreamGrouped(__gm__ int8_t *x,__gm__ int8_t *w,__gm__ int64_t *groups,
__gm__ int32_t *scratch,uint32_t E,uint32_t K,uint32_t N,uint32_t W){
__cbuf__ int8_t *base =(__cbuf__ int8_t *)0;
__ca__ int8_t *a =(__ca__ int8_t *)0;
__cb__ int8_t *b =(__cb__ int8_t *)0;
__cc__ int32_t *c =(__cc__ int32_t *)0;
const uint32_t worker = asc_get_block_idx(),nt =(N + 255)/ 256,outers =(K + 255)/ 256,
total =(K + 127)/ 128;
uint32_t start = 0,first = worker,ordinal = 0;
for(uint32_t e = 0;e < E;++e){
const uint32_t end = uint32_t(groups[e]),me = end - start,tm = TileM<P>(me),
tasks =((me + tm - 1)/ tm)* nt;
uint32_t task = first;
for(;task < tasks;task += W){
const uint32_t row = start +(task / nt)* tm,col =(task % nt)* 256,mr = Min(tm,end - row),
mp = Up(mr,16),nr = Min(256U,N - col);
for(uint32_t j = 0;j < Min(3U,outers);++j)
StreamPrefetch<P>(x,w,base,e,row,col,tm,mr,nr,K,N,j,j);
StreamLoad<P>(x,w,base,a,b,e,row,col,tm,mr,mp,nr,K,N,0);
for(uint32_t i = 0;i < total;++i){
const uint32_t slot = i % 2,kp = Min(128U,K - i * 128);
LR(slot,true);
asc_mmad(c,a + slot * tm * 128,b + slot * nr * 128,mp,kp,nr,0,false,false,i == 0);
if(i + 2 < total)
LF(slot,false);
if(i + 1 < total){
if(i + 1 >= 2)
LF((i + 1)% 2,true);
StreamLoad<P>(x,w,base,a,b,e,row,col,tm,mr,mp,nr,K,N,i + 1);
}
}
asc_sync();
StoreC<256>(c,scratch,worker,mr,mp,nr,ordinal);
}
first = task - tasks;
start = end;
}
