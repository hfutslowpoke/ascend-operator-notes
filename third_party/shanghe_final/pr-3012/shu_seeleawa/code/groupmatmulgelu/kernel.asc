asc_mul(u,u,z,count);
asc_sync_pipe(PIPE_V);
asc_mul_scalar(u,u,.044715f,count);
asc_sync_pipe(PIPE_V);
asc_add(u,u,z,count);
asc_sync_pipe(PIPE_V);
asc_mul_scalar(u,u,.7978846f,count);
asc_sync_pipe(PIPE_V);
asc_mul_scalar(p,u,-2.0f,count);
asc_sync_pipe(PIPE_V);
asc_min_scalar(p,p,8e1f,count);
asc_sync_pipe(PIPE_V);
asc_exp(p,p,count);
asc_sync_pipe(PIPE_V);
asc_add_scalar(p,p,1.0f,count);
asc_sync_pipe(PIPE_V);
asc_div(u,z,p,count);
asc_sync_pipe(PIPE_V);
