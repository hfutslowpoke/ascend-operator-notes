asc_copy_l12l0b_trans(b + ni * 1024,b1 +(ni *(K / 32)+ k0 / 32)* 1024,0,kp / 32,1,
2 *(np / 32)- 1,false,uint64_t(0));
asc_sync();
asc_mmad_sync(c,a,b,mp,kp,np,0,false,false,k0 == 0);
}
}
}

template <uint32_t P,bool Major>
__aicore__ inline void CubeFullGrouped(__gm__ int8_t *x,__gm__ int8_t *w,__gm__ int64_t *groups,
__gm__ int32_t *scratch,uint32_t E,uint32_t K,uint32_t N,uint32_t W){
__cbuf__ int8_t *a1 =(__cbuf__ int8_t *)0;
__ca__ int8_t *a =(__ca__ int8_t *)0;
__cb__ int8_t *b =(__cb__ int8_t *)0;
