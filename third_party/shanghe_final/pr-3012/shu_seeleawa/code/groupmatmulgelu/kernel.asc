template <uint32_t BN,bool Direct = false,bool Defer = false,bool Resident = false>
__aicore__ inline void Tile(State &s,__gm__ float *scale,__gm__ half *y,__gm__ int32_t *scratch,uint32_t worker,
uint32_t sub,uint32_t e,uint32_t row,uint32_t col,uint32_t mr,uint32_t nr,uint32_t N,uint32_t &ordinal){
constexpr uint32_t sr = 16384 / BN;
__ubuf__ float *z =(__ubuf__ float *)0;
__ubuf__ float *sc =(__ubuf__ float *)181760;
if(nr < BN){
asc_duplicate(sc,0.0f,BN);
asc_sync_pipe(PIPE_V);
asc_sync_notify(PIPE_V,PIPE_MTE2,EVENT_ID4);
asc_sync_wait(PIPE_V,PIPE_MTE2,EVENT_ID4);
}
asc_copy_gm2ub_align(sc,scale + uint64_t(e)* N + col,1,nr * 4,0,0,0,0);
for(uint32_t micro = 0;micro < mr;micro += sr){
const uint32_t tail = Min(sr,mr - micro),split =(tail + 1)/ 2,local = sub * split,
rows = tail > local ? Min(split,tail - local): 0,si = ordinal % 2;
