}
__aicore__ inline LocalTensor<int64_t> Groups()const{return groups_;}
struct Packet{TaskDesc task;uint32_t first,row,rows;};
__aicore__ inline void Prefetch(const Packet& packet,uint32_t slot,bool last){
const TaskDesc& task = packet.task;
const uint32_t p8 =(task.validN + 7)/ 8 * 8;
const uint64_t offset =(static_cast<uint64_t>(producer_)* slots_ + slot)* bm_ * width_
+(packet.first + packet.row)* width_;
auto acc = qC_.AllocTensor<int32_t>();
DataCopyPad(acc,ringGm_[offset],
{static_cast<uint16_t>(packet.rows),task.validN * 4,
(width_ - task.validN)* 4,0,0},
{true,0,static_cast<uint8_t>(p8 - task.validN),0});
qC_.EnQue(acc);
if(!singleShot_ && last)CrossCoreSetFlag<2,PIPE_MTE2>(FREE_BASE + slot);
}
__aicore__ inline void Compute(const Packet& packet,const LocalTensor<float>& scales,uint32_t lanes){
const TaskDesc& task = packet.task;
const uint32_t p8 =(task.validN + 7)/ 8 * 8;
const uint32_t p16 =(task.validN + 15)/ 16 * 16;
auto acc = qC_.DeQue<int32_t>();
auto z = z_.Get<float>();
auto y = y_.Get<float>();
const uint32_t active = packet.rows * p8;
Cast(z,acc,RoundMode::CAST_RINT,active);PipeBarrier<PIPE_V>();
if(broadcastScale_){
const BinaryRepeatParams stride ={1,1,1,
static_cast<uint8_t>(p8 / 8),static_cast<uint8_t>(p8 / 8),0};
for(uint32_t col = 0;col < p8;col += 64){
const uint64_t live = p8 - col < 64 ? p8 - col : 64;
Mul<float>(z[col],z[col],scales[col],live,
static_cast<uint8_t>(packet.rows),stride);
}
PipeBarrier<PIPE_V>();
}else{
Mul(z,z,scales,active);PipeBarrier<PIPE_V>();
}
gmg::Gelu7Count(z,y,active);
auto output = qY_.AllocTensor<half>();
if(p8 == p16){
Cast(output,y,RoundMode::CAST_RINT,packet.rows * p8);
}else{
Duplicate(output,half(0),packet.rows * p16);PipeBarrier<PIPE_V>();
const UnaryRepeatParams stride ={1,1,
static_cast<uint8_t>(p16 / 16),static_cast<uint8_t>(p8 / 8)};
for(uint32_t col = 0;col < p8;col += 64){
const uint64_t live = p8 - col < 64 ? p8 - col : 64;
Cast<half,float>(output[col],y[col],RoundMode::CAST_RINT,
live,static_cast<uint8_t>(packet.rows),stride);
}
}
qY_.EnQue(output);
output = qY_.DeQue<half>();
DataCopyPad(yGm_[static_cast<uint64_t>(task.row + packet.first + packet.row)* n_ + task.col],
output,{static_cast<uint16_t>(packet.rows),task.validN * 2,
0,(n_ - task.validN)* 2,0});
qY_.FreeTensor(output);
qC_.FreeTensor(acc);
}
__aicore__ inline void Submit(const TaskDesc& task,uint32_t sequence){
const uint32_t slot = sequence % slots_;
uint32_t firstHalf =(task.validM + 1)/ 2;
uint32_t part = sub_;
if(task.validM > bm_ - CUBE_ROW_ALIGN){
firstHalf = maxLanes_ / width_;
part ^= longSequence_++ % 2;
}
const uint32_t first = part == 0 ? 0 : firstHalf;
const uint32_t rows = part == 0 ? firstHalf : task.validM - firstHalf;
if(rows == 0){
CrossCoreWaitFlag<2>(READY_BASE + slot);
if(!singleShot_)CrossCoreSetFlag<2,PIPE_MTE2>(FREE_BASE + slot);
return;
}
const uint32_t p8 =(task.validN + 7)/ 8 * 8;
const uint32_t p16 =(task.validN + 15)/ 16 * 16;
const uint32_t outputRows = maxLanes_ / p16;
uint32_t packetRows = 1;
while(packetRows < rows && 2 * packetRows <= outputRows && packetRows < 128)packetRows *= 2;
const uint32_t lanes = packetRows * p8;
auto scales = qScale_.AllocTensor<float>();
DataCopyPad(scales,scaleGm_[static_cast<uint64_t>(task.expert)* n_ + task.col],
{1,task.validN * 4,0,0,0},{true,0,static_cast<uint8_t>(p8 - task.validN),0.0f});
qScale_.EnQue(scales);
scales = qScale_.DeQue<float>();
for(uint32_t copies = 1;!broadcastScale_ && copies < packetRows;copies *= 2){
Adds(scales[copies * p8],scales,0.0f,copies * p8);PipeBarrier<PIPE_V>();
}
CrossCoreWaitFlag<2>(READY_BASE + slot);
Packet current ={task,first,0,rows < packetRows ? rows : packetRows};
Prefetch(current,slot,current.rows == rows);
for(;;){
const uint32_t nextRow = current.row + current.rows;
Packet next ={task,first,nextRow,rows - nextRow < packetRows ? rows - nextRow : packetRows};
if(!singleShot_ && nextRow < rows)Prefetch(next,slot,nextRow + next.rows == rows);
Compute(current,scales,lanes);
if(nextRow == rows)break;
if(singleShot_)Prefetch(next,slot,nextRow + next.rows == rows);
current = next;
}
qScale_.FreeTensor(scales);
}
__aicore__ inline void PostCompute(uint32_t){
qGroup_.FreeTensor(groups_);
PipeBarrier<PIPE_ALL>();
}
private:
TPipe& pipe_;
TQue<TPosition::VECIN,2> qC_;
TQue<TPosition::VECIN,2> qScale_;
TQue<TPosition::VECIN,1> qGroup_;
TQue<TPosition::VECOUT,2> qY_;
TBuf<TPosition::VECCALC> z_,y_;
GlobalTensor<float> scaleGm_;
GlobalTensor<half> yGm_;
GlobalTensor<int32_t> ringGm_;
LocalTensor<int64_t> groups_;
uint32_t n_,producer_,sub_,bm_,width_,slots_,maxLanes_;
uint32_t longSequence_;
bool singleShot_,broadcastScale_;
};
class ExplicitOutputConsumer{
public:
__aicore__ inline ExplicitOutputConsumer(TPipe& pipe): pipe_(pipe){}
__aicore__ inline void Init(GM_ADDR scale,GM_ADDR y,GM_ADDR ring,GM_ADDR groups,
uint32_t e,uint32_t n,uint32_t producer,uint32_t bm,uint32_t width,
bool singleShot,bool broadcastScale = false){
scaleGm_.SetGlobalBuffer((__gm__ float*)scale);
yGm_.SetGlobalBuffer((__gm__ half*)y);
ringGm_.SetGlobalBuffer((__gm__ int32_t*)ring);
n_ = n;producer_ = producer;sub_ = GetSubBlockIdx();
bm_ = bm;width_ = width;singleShot_ = singleShot;
longSequence_ = 0;
slots_ = singleShot ? 1 : 4;
broadcastScale_ = broadcastScale;
maxLanes_ = broadcastScale ? 8192 :(singleShot ? 2048 : 4096);
cBanks_ = singleShot ? 1 : 2;
pipe_.InitBuffer(cInput_,cBanks_ * maxLanes_ * sizeof(int32_t));
for(uint32_t bank = 0;bank < cBanks_;++bank){
cReady_[bank]= pipe_.AllocEventID<HardEvent::MTE2_V>();
cFree_[bank]= pipe_.AllocEventID<HardEvent::V_MTE2>();
SetFlag<HardEvent::V_MTE2>(cFree_[bank]);
}
pipe_.InitBuffer(output_,2 * maxLanes_ * sizeof(half));
for(uint32_t bank = 0;bank < 2;++bank){
yReady_[bank]= pipe_.AllocEventID<HardEvent::V_MTE3>();
yFree_[bank]= pipe_.AllocEventID<HardEvent::MTE3_V>();
SetFlag<HardEvent::MTE3_V>(yFree_[bank]);
}
const uint32_t scalePad = broadcastScale ?(384 -(width * 4)% 256)% 256 : 0;
pipe_.InitBuffer(qScale_,2,(broadcastScale ? width : maxLanes_)* sizeof(float)+ scalePad);
pipe_.InitBuffer(z_,maxLanes_ * sizeof(float)+(broadcastScale ? 256 : 0));
pipe_.InitBuffer(y_,maxLanes_ * sizeof(float));
pipe_.InitBuffer(qGroup_,1,(e * 8 + 31)/ 32 * 32);
GlobalTensor<int64_t> groupGm;
groupGm.SetGlobalBuffer((__gm__ int64_t*)groups);
auto group = qGroup_.AllocTensor<int64_t>();
DataCopyPad(group,groupGm,{1,e * 8,0,0,0},{false,0,0,0});
qGroup_.EnQue(group);
groups_ = qGroup_.DeQue<int64_t>();
auto event = pipe_.FetchEventID(HardEvent::MTE2_S);
SetFlag<HardEvent::MTE2_S>(event);
WaitFlag<HardEvent::MTE2_S>(event);
}
__aicore__ inline LocalTensor<int64_t> Groups()const{return groups_;}
struct Packet{TaskDesc task;uint32_t first,row,rows;};
__aicore__ inline void Prefetch(const Packet& packet,uint32_t slot,bool last){
const TaskDesc& task = packet.task;
const uint32_t p8 =(task.validN + 7)/ 8 * 8;
const uint64_t offset =(static_cast<uint64_t>(producer_)* slots_ + slot)* bm_ * width_
+(packet.first + packet.row)* width_;
const uint32_t bank = singleShot_ ? 0 : cWrite_++ % 2;
WaitFlag<HardEvent::V_MTE2>(cFree_[bank]);
auto acc = cInput_.Get<int32_t>()[bank * maxLanes_];
DataCopyPad(acc,ringGm_[offset],
{static_cast<uint16_t>(packet.rows),task.validN * 4,
(width_ - task.validN)* 4,0,0},
{true,0,static_cast<uint8_t>(p8 - task.validN),0});
SetFlag<HardEvent::MTE2_V>(cReady_[bank]);
if(!singleShot_ && last)CrossCoreSetFlag<2,PIPE_MTE2>(FREE_BASE + slot);
}
__aicore__ inline void Compute(const Packet& packet,const LocalTensor<float>& scales,uint32_t lanes){
const TaskDesc& task = packet.task;
const uint32_t p8 =(task.validN + 7)/ 8 * 8;
const uint32_t p16 =(task.validN + 15)/ 16 * 16;
const uint32_t bank = singleShot_ ? 0 : cRead_++ % 2;
WaitFlag<HardEvent::MTE2_V>(cReady_[bank]);
auto acc = cInput_.Get<int32_t>()[bank * maxLanes_];
auto z = z_.Get<float>();
auto y = y_.Get<float>();
const uint32_t active = packet.rows * p8;
Cast(z,acc,RoundMode::CAST_RINT,active);PipeBarrier<PIPE_V>();
if(broadcastScale_){
auto expanded = acc.ReinterpretCast<float>();
SetMaskCount();
SetVectorMask<float,MaskMode::COUNTER>(p8);
Copy<float,false>(expanded,scales,MASK_PLACEHOLDER,
static_cast<uint8_t>(packet.rows),
{1,1,static_cast<uint16_t>(p8 / 8),0});
PipeBarrier<PIPE_V>();
SetMaskNorm();
ResetMask();
Mul(z,z,expanded,active);
PipeBarrier<PIPE_V>();
}else{
Mul(z,z,scales,active);PipeBarrier<PIPE_V>();
}
gmg::Gelu7Count(z,y,active);
const uint32_t yBank = yNext_++ % 2;
WaitFlag<HardEvent::MTE3_V>(yFree_[yBank]);
auto output = output_.Get<half>()[yBank * maxLanes_];
if(p8 == p16){
Cast(output,y,RoundMode::CAST_RINT,packet.rows * p8);
}else{
Duplicate(output,half(0),packet.rows * p16);PipeBarrier<PIPE_V>();
const UnaryRepeatParams stride ={1,1,
static_cast<uint8_t>(p16 / 16),static_cast<uint8_t>(p8 / 8)};
for(uint32_t col = 0;col < p8;col += 64){
const uint64_t live = p8 - col < 64 ? p8 - col : 64;
Cast<half,float>(output[col],y[col],RoundMode::CAST_RINT,
live,static_cast<uint8_t>(packet.rows),stride);
}
}
SetFlag<HardEvent::V_MTE3>(yReady_[yBank]);
WaitFlag<HardEvent::V_MTE3>(yReady_[yBank]);
DataCopyPad(yGm_[static_cast<uint64_t>(task.row + packet.first + packet.row)* n_ + task.col],
output,{static_cast<uint16_t>(packet.rows),task.validN * 2,
0,(n_ - task.validN)* 2,0});
SetFlag<HardEvent::MTE3_V>(yFree_[yBank]);
SetFlag<HardEvent::V_MTE2>(cFree_[bank]);
}
__aicore__ inline void Submit(const TaskDesc& task,uint32_t sequence){
const uint32_t slot = sequence % slots_;
uint32_t firstHalf =(task.validM + 1)/ 2;
uint32_t part = sub_;
if(task.validM > bm_ - CUBE_ROW_ALIGN){
firstHalf = maxLanes_ / width_;
part ^= longSequence_++ % 2;
}
const uint32_t first = part == 0 ? 0 : firstHalf;
const uint32_t rows = part == 0 ? firstHalf : task.validM - firstHalf;
if(rows == 0){
CrossCoreWaitFlag<2>(READY_BASE + slot);
if(!singleShot_)CrossCoreSetFlag<2,PIPE_MTE2>(FREE_BASE + slot);
return;
}
const uint32_t p8 =(task.validN + 7)/ 8 * 8;
const uint32_t p16 =(task.validN + 15)/ 16 * 16;
const uint32_t outputRows = maxLanes_ / p16;
uint32_t packetRows = 1;
while(packetRows < rows && 2 * packetRows <= outputRows && packetRows < 128)packetRows *= 2;
const uint32_t lanes = packetRows * p8;
auto scales = qScale_.AllocTensor<float>();
DataCopyPad(scales,scaleGm_[static_cast<uint64_t>(task.expert)* n_ + task.col],
{1,task.validN * 4,0,0,0},{true,0,static_cast<uint8_t>(p8 - task.validN),0.0f});
qScale_.EnQue(scales);
scales = qScale_.DeQue<float>();
for(uint32_t copies = 1;!broadcastScale_ && copies < packetRows;copies *= 2){
Adds(scales[copies * p8],scales,0.0f,copies * p8);PipeBarrier<PIPE_V>();
}
CrossCoreWaitFlag<2>(READY_BASE + slot);
Packet current ={task,first,0,rows < packetRows ? rows : packetRows};
Prefetch(current,slot,current.rows == rows);
for(;;){
const uint32_t nextRow = current.row + current.rows;
Packet next ={task,first,nextRow,rows - nextRow < packetRows ? rows - nextRow : packetRows};
if(!singleShot_ && nextRow < rows)Prefetch(next,slot,nextRow + next.rows == rows);
Compute(current,scales,lanes);
if(nextRow == rows)break;
if(singleShot_)Prefetch(next,slot,nextRow + next.rows == rows);
current = next;
}
qScale_.FreeTensor(scales);
}
__aicore__ inline void PostCompute(uint32_t){
qGroup_.FreeTensor(groups_);
for(uint32_t bank = 0;bank < cBanks_;++bank){
WaitFlag<HardEvent::V_MTE2>(cFree_[bank]);
pipe_.ReleaseEventID<HardEvent::MTE2_V>(cReady_[bank]);
pipe_.ReleaseEventID<HardEvent::V_MTE2>(cFree_[bank]);
}
for(uint32_t bank = 0;bank < 2;++bank){
WaitFlag<HardEvent::MTE3_V>(yFree_[bank]);
pipe_.ReleaseEventID<HardEvent::V_MTE3>(yReady_[bank]);
pipe_.ReleaseEventID<HardEvent::MTE3_V>(yFree_[bank]);
}
PipeBarrier<PIPE_ALL>();
}
private:
TPipe& pipe_;
TBuf<TPosition::VECCALC> cInput_;
TEventID cReady_[2],cFree_[2];
uint32_t cBanks_,cWrite_ = 0,cRead_ = 0;
TQue<TPosition::VECIN,2> qScale_;
TQue<TPosition::VECIN,1> qGroup_;
TBuf<TPosition::VECCALC> output_;
TEventID yReady_[2],yFree_[2];
uint32_t yNext_ = 0;
TBuf<TPosition::VECCALC> z_,y_;
GlobalTensor<float> scaleGm_;
GlobalTensor<half> yGm_;
GlobalTensor<int32_t> ringGm_;
LocalTensor<int64_t> groups_;
uint32_t n_,producer_,sub_,bm_,width_,slots_,maxLanes_;
uint32_t longSequence_;
bool singleShot_,broadcastScale_;
};
template <bool PADDED = false, bool REUSE_SCALE = false>
class WholePacketConsumer : private ScaleReuseState<REUSE_SCALE> {
public:
	static constexpr uint32_t kLanes = WHOLE_PACKET_LANES;
	__aicore__ inline WholePacketConsumer(TPipe &pipe)
			: pipe_(pipe) {}
	__aicore__ inline void Init(GM_ADDR scale, GM_ADDR y, GM_ADDR ring, GM_ADDR groups,
		uint32_t e, uint32_t n, uint32_t producer, uint32_t bm, uint32_t width) {
		scaleGm_.SetGlobalBuffer((__gm__ float *)scale);
		yGm_.SetGlobalBuffer((__gm__ half *)y);
		ringGm_.SetGlobalBuffer((__gm__ int32_t *)ring);
		n_ = n;
		producer_ = producer;
		sub_ = GetSubBlockIdx();
		bm_ = bm;
		width_ = width;
		if constexpr (REUSE_SCALE) this->scaleValid_ = false;
		pipe_.InitBuffer(qC_, 1, kLanes * sizeof(int32_t));
		pipe_.InitBuffer(qY_, 1, kLanes * sizeof(half) + 256);
		pipe_.InitBuffer(qScale_, 1, width * sizeof(float));
		pipe_.InitBuffer(y_, kLanes * sizeof(float));
		pipe_.InitBuffer(qGroup_, 1, (e * 8 + 31) / 32 * 32);
		GlobalTensor<int64_t> groupGm;
		groupGm.SetGlobalBuffer((__gm__ int64_t *)groups);
		auto group = qGroup_.AllocTensor<int64_t>();
		DataCopyPad(group, groupGm, {1, e * 8, 0, 0, 0}, {false, 0, 0, 0});
		qGroup_.EnQue(group);
		groups_ = qGroup_.DeQue<int64_t>();
		auto event = pipe_.FetchEventID(HardEvent::MTE2_S);
		SetFlag<HardEvent::MTE2_S>(event);
		WaitFlag<HardEvent::MTE2_S>(event);
	}
	__aicore__ inline LocalTensor<int64_t> Groups() const { return groups_; }
	__aicore__ inline void Submit(const TaskDesc &task, uint32_t sequence) {
		const uint32_t slot = sequence % SLOTS;
		const uint32_t firstHalf = (task.validM + 1) / 2;
		const uint32_t first = sub_ == 0 ? 0 : firstHalf;
		const uint32_t rows = sub_ == 0 ? firstHalf : task.validM - firstHalf;
		if (rows == 0) {
			CrossCoreWaitFlag<2>(READY_BASE + slot);
			CrossCoreSetFlag<2, PIPE_MTE2>(FREE_BASE + slot);
			return;
		}
		const uint32_t p8 = PADDED ? (task.validN + 7) / 8 * 8 : task.validN;
		const uint32_t p16 = PADDED ? (task.validN + 15) / 16 * 16 : task.validN;
		bool scaleHit = false;
		if constexpr (REUSE_SCALE) scaleHit = this->scaleValid_ && this->scaleExpert_ == task.expert && this->scaleCol_ == task.col;
		LocalTensor<float> scales;
		if constexpr (REUSE_SCALE) {
			if (scaleHit) scales = this->cachedScale_;
		}
		if (!scaleHit) {
			if constexpr (REUSE_SCALE) {
				if (this->scaleValid_) qScale_.FreeTensor(this->cachedScale_);
			}
			scales = qScale_.AllocTensor<float>();
			DataCopyPad(scales, scaleGm_[static_cast<uint64_t>(task.expert) * n_ + task.col],
				{1, task.validN * 4, 0, 0, 0}, {PADDED, 0, static_cast<uint8_t>(p8 - task.validN), 0.0f});
			qScale_.EnQue(scales);
			scales = qScale_.DeQue<float>();
			if constexpr (REUSE_SCALE) {
				this->cachedScale_ = scales;
				this->scaleValid_ = true;
				this->scaleExpert_ = task.expert;
				this->scaleCol_ = task.col;
			}
		}
		CrossCoreWaitFlag<2>(READY_BASE + slot);
		const uint64_t offset = (static_cast<uint64_t>(producer_) * SLOTS + slot) * bm_ * width_ + first * width_;
		auto acc = qC_.AllocTensor<int32_t>();
		DataCopyPad(acc, ringGm_[offset],
			{static_cast<uint16_t>(rows), task.validN * 4,
				(width_ - task.validN) * 4, 0, 0},
			{PADDED, 0, static_cast<uint8_t>(p8 - task.validN), 0});
		qC_.EnQue(acc);
		CrossCoreSetFlag<2, PIPE_MTE2>(FREE_BASE + slot);
		acc = qC_.DeQue<int32_t>();
		auto z = acc.ReinterpretCast<float>();
		auto y = y_.Get<float>();
		const uint32_t active = rows * p8;
		Cast(z, acc, RoundMode::CAST_RINT, active);
		PipeBarrier<PIPE_V>();
		const BinaryRepeatParams stride = {1, 1, 1,
			static_cast<uint8_t>(p8 / 8), static_cast<uint8_t>(p8 / 8), 0};
		for (uint32_t col = 0; col < p8; col += 64) {
			const uint64_t live = p8 - col < 64 ? p8 - col : 64;
			Mul<float>(z[col], z[col], scales[col], live, static_cast<uint8_t>(rows), stride);
		}
		PipeBarrier<PIPE_V>();
		gmg::Gelu7Count(z, y, active);
		auto output = qY_.AllocTensor<half>();
		if (p8 == p16) {
			Cast(output, y, RoundMode::CAST_RINT, active);
		} else {
			Duplicate(output, half(0), rows * p16);
			PipeBarrier<PIPE_V>();
			const UnaryRepeatParams outputStride = {1, 1,
				static_cast<uint8_t>(p16 / 16), static_cast<uint8_t>(p8 / 8)};
			for (uint32_t col = 0; col < p8; col += 64) {
				const uint64_t live = p8 - col < 64 ? p8 - col : 64;
				Cast<half, float>(output[col], y[col], RoundMode::CAST_RINT,
					live, static_cast<uint8_t>(rows), outputStride);
			}
		}
		qY_.EnQue(output);
		output = qY_.DeQue<half>();
		DataCopyPad(yGm_[static_cast<uint64_t>(task.row + first) * n_ + task.col], output,
			{static_cast<uint16_t>(rows), task.validN * 2, 0, (n_ - task.validN) * 2, 0});
		qY_.FreeTensor(output);
		qC_.FreeTensor(acc);
		if constexpr (!REUSE_SCALE) qScale_.FreeTensor(scales);
	}
	__aicore__ inline void PostCompute(uint32_t) {
		if constexpr (REUSE_SCALE) {
			if (this->scaleValid_) qScale_.FreeTensor(this->cachedScale_);
		}
		qGroup_.FreeTensor(groups_);
		PipeBarrier<PIPE_ALL>();
	}

private:
	TPipe &pipe_;
	TQue<TPosition::VECIN, 1> qC_, qScale_, qGroup_;
	TQue<TPosition::VECOUT, 1> qY_;
	TBuf<TPosition::VECCALC> y_;
	GlobalTensor<float> scaleGm_;
	GlobalTensor<half> yGm_;
	GlobalTensor<int32_t> ringGm_;
	LocalTensor<int64_t> groups_;
	uint32_t n_, producer_, sub_, bm_, width_;
};
class CompactStaticConsumer{
public:
__aicore__ inline void Init(GM_ADDR scale,GM_ADDR y,GM_ADDR ring,
uint32_t n,uint32_t bm,uint32_t width){
scaleGm_.SetGlobalBuffer((__gm__ float*)scale);
yGm_.SetGlobalBuffer((__gm__ half*)y);
ringGm_.SetGlobalBuffer((__gm__ int32_t*)ring);
n_ = n;sub_ = GetSubBlockIdx();width_ = width;
}
__aicore__ inline void Submit(const TaskDesc& task,uint32_t){
const uint32_t firstHalf =(task.validM + 1)/ 2;
const uint32_t first = sub_ == 0 ? 0 : firstHalf;
const uint32_t rows = sub_ == 0 ? firstHalf : task.validM - firstHalf;
if(rows == 0){
CrossCoreWaitFlag<2>(READY_BASE);
return;
}
LocalTensor<int32_t> acc(TPosition::VECCALC,0,4096);
LocalTensor<half> output(TPosition::VECCALC,16384,4096);
LocalTensor<float> scales(TPosition::VECCALC,24832,width_);
LocalTensor<float> y(TPosition::VECCALC,24832 + width_ * 4,4096);
DataCopyPad(scales,scaleGm_[static_cast<uint64_t>(task.expert)* n_ + task.col],
{1,task.validN * 4,0,0,0},{false,0,0,0});
CrossCoreWaitFlag<2>(READY_BASE);
DataCopyPad(acc,ringGm_[first * width_],
{static_cast<uint16_t>(rows),task.validN * 4,
(width_ - task.validN)* 4,0,0},{false,0,0,0});
SetFlag<HardEvent::MTE2_V>(0);WaitFlag<HardEvent::MTE2_V>(0);
auto z = acc.ReinterpretCast<float>();
const uint32_t active = rows * task.validN;
Cast(z,acc,RoundMode::CAST_RINT,active);PipeBarrier<PIPE_V>();
const BinaryRepeatParams stride ={1,1,1,
static_cast<uint8_t>(task.validN / 8),static_cast<uint8_t>(task.validN / 8),0};
for(uint32_t col = 0;col < task.validN;col += 64){
const uint64_t live = task.validN - col < 64 ? task.validN - col : 64;
Mul<float>(z[col],z[col],scales[col],live,static_cast<uint8_t>(rows),stride);
}
PipeBarrier<PIPE_V>();
gmg::Gelu7Count(z,y,active);
Cast(output,y,RoundMode::CAST_RINT,active);
SetFlag<HardEvent::V_MTE3>(0);WaitFlag<HardEvent::V_MTE3>(0);
DataCopyPad(yGm_[static_cast<uint64_t>(task.row + first)* n_ + task.col],output,
{static_cast<uint16_t>(rows),task.validN * 2,0,(n_ - task.validN)* 2,0});
}
__aicore__ inline void PostCompute(uint32_t){PipeBarrier<PIPE_ALL>();}
private:
GlobalTensor<float> scaleGm_;
GlobalTensor<half> yGm_;
GlobalTensor<int32_t> ringGm_;
uint32_t n_,sub_,width_;
};
class CompactMatrixConsumer{
public:
static constexpr uint32_t kLanes = 4096;
__aicore__ inline CompactMatrixConsumer(TPipe& pipe): pipe_(pipe){}
__aicore__ inline void Init(GM_ADDR scale,GM_ADDR y,GM_ADDR ring,uint32_t n,uint32_t bm,uint32_t width){
scaleGm_.SetGlobalBuffer((__gm__ float*)scale);
yGm_.SetGlobalBuffer((__gm__ half*)y);
ringGm_.SetGlobalBuffer((__gm__ int32_t*)ring);
n_ = n;producer_ = 0;sub_ = GetSubBlockIdx();bm_ = bm;width_ = width;
pipe_.InitBuffer(qC_,1,kLanes * sizeof(int32_t));
pipe_.InitBuffer(qY_,1,kLanes * sizeof(half)+ 256);
pipe_.InitBuffer(qScale_,1,width * sizeof(float));
pipe_.InitBuffer(y_,kLanes * sizeof(float));
}
__aicore__ inline void Submit(const TaskDesc& task,uint32_t sequence){
const uint32_t slot = 0;
const uint32_t firstHalf =(task.validM + 1)/ 2;
const uint32_t first = sub_ == 0 ? 0 : firstHalf;
const uint32_t rows = sub_ == 0 ? firstHalf : task.validM - firstHalf;
if(rows == 0){
CrossCoreWaitFlag<2>(READY_BASE + slot);
return;
}
auto scales = qScale_.AllocTensor<float>();
DataCopyPad(scales,scaleGm_[static_cast<uint64_t>(task.expert)* n_ + task.col],
{1,task.validN * 4,0,0,0},{false,0,0,0});
qScale_.EnQue(scales);
scales = qScale_.DeQue<float>();
CrossCoreWaitFlag<2>(READY_BASE + slot);
const uint64_t offset =(static_cast<uint64_t>(producer_)* SLOTS + slot)
* bm_ * width_ + first * width_;
auto acc = qC_.AllocTensor<int32_t>();
DataCopyPad(acc,ringGm_[offset],
{static_cast<uint16_t>(rows),task.validN * 4,
(width_ - task.validN)* 4,0,0},{false,0,0,0});
qC_.EnQue(acc);
acc = qC_.DeQue<int32_t>();
auto z = acc.ReinterpretCast<float>();
auto y = y_.Get<float>();
const uint32_t active = rows * task.validN;
Cast(z,acc,RoundMode::CAST_RINT,active);PipeBarrier<PIPE_V>();
const BinaryRepeatParams stride ={1,1,1,
static_cast<uint8_t>(task.validN / 8),static_cast<uint8_t>(task.validN / 8),0};
for(uint32_t col = 0;col < task.validN;col += 64){
const uint64_t live = task.validN - col < 64 ? task.validN - col : 64;
Mul<float>(z[col],z[col],scales[col],live,static_cast<uint8_t>(rows),stride);
}
PipeBarrier<PIPE_V>();
gmg::Gelu7Count(z,y,active);
auto output = qY_.AllocTensor<half>();
Cast(output,y,RoundMode::CAST_RINT,active);
qY_.EnQue(output);
output = qY_.DeQue<half>();
DataCopyPad(yGm_[static_cast<uint64_t>(task.row + first)* n_ + task.col],output,
{static_cast<uint16_t>(rows),task.validN * 2,0,(n_ - task.validN)* 2,0});
qY_.FreeTensor(output);
qC_.FreeTensor(acc);
qScale_.FreeTensor(scales);
}
__aicore__ inline void PostCompute(uint32_t){
PipeBarrier<PIPE_ALL>();
}
private:
TPipe& pipe_;
TQue<TPosition::VECIN,1> qC_,qScale_;
TQue<TPosition::VECOUT,1> qY_;
TBuf<TPosition::VECCALC> y_;
GlobalTensor<float> scaleGm_;
GlobalTensor<half> yGm_;
GlobalTensor<int32_t> ringGm_;
uint32_t n_,producer_,sub_,bm_,width_;
};
class DequantConsumer{
public:
__aicore__ inline DequantConsumer(TPipe& pipe): pipe_(pipe){}
__aicore__ inline void Init(GM_ADDR scale,GM_ADDR y,GM_ADDR ring,GM_ADDR groups,
uint32_t e,uint32_t n,uint32_t producer,uint32_t bm,uint32_t width,
bool singleShot){
scaleGm_.SetGlobalBuffer((__gm__ float*)scale);
yGm_.SetGlobalBuffer((__gm__ half*)y);
ringGm_.SetGlobalBuffer((__gm__ int32_t*)ring);
n_ = n;producer_ = producer;sub_ = GetSubBlockIdx();
bm_ = bm;width_ = width;singleShot_ = singleShot;
slots_ = singleShot ? 1 : 4;
maxLanes_ = singleShot ? 2048 : 4096;
pipe_.InitBuffer(qC_,singleShot ? 1 : 2,maxLanes_ * sizeof(int32_t));
pipe_.InitBuffer(qScale_,1,maxLanes_ * sizeof(float));
pipe_.InitBuffer(qY_,2,maxLanes_ * sizeof(half));
pipe_.InitBuffer(z_,maxLanes_ * sizeof(float));
pipe_.InitBuffer(y_,maxLanes_ * sizeof(float));
pipe_.InitBuffer(qGroup_,1,(e * 8 + 31)/ 32 * 32);
GlobalTensor<int64_t> groupGm;
groupGm.SetGlobalBuffer((__gm__ int64_t*)groups);
auto group = qGroup_.AllocTensor<int64_t>();
DataCopyPad(group,groupGm,{1,e * 8,0,0,0},{false,0,0,0});
qGroup_.EnQue(group);
groups_ = qGroup_.DeQue<int64_t>();
auto event = pipe_.FetchEventID(HardEvent::MTE2_S);
SetFlag<HardEvent::MTE2_S>(event);
WaitFlag<HardEvent::MTE2_S>(event);
}
__aicore__ inline LocalTensor<int64_t> Groups()const{return groups_;}
__aicore__ inline void Retile(uint32_t bm,uint32_t width,uint32_t){
bm_ = bm;width_ = width;
}
struct Packet{TaskDesc task;uint32_t first,row,rows;};
__aicore__ inline void Prefetch(const Packet& packet,uint32_t slot,bool last){
const TaskDesc& task = packet.task;
const uint32_t p8 =(task.validN + 15)/ 16 * 16;
const uint64_t offset =(static_cast<uint64_t>(producer_)* slots_ + slot)* bm_ * width_
+(packet.first + packet.row)* width_;
auto acc = qC_.AllocTensor<int32_t>();
DataCopyPad(acc,ringGm_[offset],
{static_cast<uint16_t>(packet.rows),task.validN * 4,
(width_ - task.validN)* 4,(p8 -(task.validN + 7)/ 8 * 8)/ 8,0},
{true,0,static_cast<uint8_t>((task.validN + 7)/ 8 * 8 - task.validN),0});
qC_.EnQue(acc);
if(!singleShot_ && last)CrossCoreSetFlag<2,PIPE_MTE2>(FREE_BASE + slot);
}
__aicore__ inline void Compute(const Packet& packet,const LocalTensor<float>& scales,uint32_t lanes){
const TaskDesc& task = packet.task;
const uint32_t pitch =(task.validN + 15)/ 16 * 16;
const uint32_t active = packet.rows * pitch;
auto acc = qC_.DeQue<int32_t>();
auto z = z_.Get<float>();
auto y = y_.Get<float>();
// Only final GELU output is converted to FP16. The INT32 ring
// keeps every K contribution until this FP32 dequantization.
const uint32_t aligned8=(task.validN+7)/8*8;
if(aligned8<pitch){
Duplicate<int32_t>(acc[aligned8],int32_t(0),uint64_t(8),
static_cast<uint8_t>(packet.rows),1,static_cast<uint8_t>(pitch/8));
PipeBarrier<PIPE_V>();
}
Cast(z,acc,RoundMode::CAST_RINT,active);PipeBarrier<PIPE_V>();
Mul(z,z,scales,active);PipeBarrier<PIPE_V>();
gmg::Gelu7Count(z,y,active);
auto output = qY_.AllocTensor<half>();
Cast(output,y,RoundMode::CAST_RINT,active);
qY_.EnQue(output);
output = qY_.DeQue<half>();
DataCopyPad(yGm_[static_cast<uint64_t>(task.row + packet.first + packet.row)* n_ + task.col],
output,{static_cast<uint16_t>(packet.rows),task.validN * 2,
0,(n_ - task.validN)* 2,0});
qY_.FreeTensor(output);
qC_.FreeTensor(acc);
}
__aicore__ inline void Submit(const TaskDesc& task,uint32_t sequence){
const uint32_t slot = sequence % slots_;
const uint32_t firstHalf =(task.validM + 1)/ 2;
const uint32_t first = sub_ == 0 ? 0 : firstHalf;
const uint32_t rows = sub_ == 0 ? firstHalf : task.validM - firstHalf;
if(rows == 0){
CrossCoreWaitFlag<2>(READY_BASE + slot);
if(!singleShot_)CrossCoreSetFlag<2,PIPE_MTE2>(FREE_BASE + slot);
return;
}
const uint32_t p8 =(task.validN + 15)/ 16 * 16;
const uint32_t p16 =(task.validN + 15)/ 16 * 16;
const uint32_t outputRows = maxLanes_ / p16;
uint32_t packetRows = 1;
while(packetRows < rows && 2 * packetRows <= outputRows && packetRows < 128)packetRows *= 2;
const uint32_t lanes = packetRows * p8;
const uint32_t scalePitch =(task.validN + 7)/ 8 * 8;
auto scales = qScale_.AllocTensor<float>();
DataCopyPad(scales,scaleGm_[static_cast<uint64_t>(task.expert)* n_ + task.col],
{1,task.validN * 4,0,0,0},
{true,0,static_cast<uint8_t>(scalePitch - task.validN),0.0f});
qScale_.EnQue(scales);
scales = qScale_.DeQue<float>();
if(p16 > scalePitch){
Duplicate(scales[scalePitch],0.0f,p16 - scalePitch);
PipeBarrier<PIPE_V>();
}
for(uint32_t copies = 1;copies < packetRows;copies *= 2){
Adds(scales[copies * p16],scales,0.0f,copies * p16);
PipeBarrier<PIPE_V>();
}
CrossCoreWaitFlag<2>(READY_BASE + slot);
Packet current ={task,first,0,rows < packetRows ? rows : packetRows};
Prefetch(current,slot,current.rows == rows);
for(;;){
const uint32_t nextRow = current.row + current.rows;
Packet next ={task,first,nextRow,rows - nextRow < packetRows ? rows - nextRow : packetRows};
if(!singleShot_ && nextRow < rows)Prefetch(next,slot,nextRow + next.rows == rows);
Compute(current,scales,lanes);
if(nextRow == rows)break;
if(singleShot_)Prefetch(next,slot,nextRow + next.rows == rows);
current = next;
}
qScale_.FreeTensor(scales);
}
__aicore__ inline void PostCompute(uint32_t){
qGroup_.FreeTensor(groups_);
PipeBarrier<PIPE_ALL>();
}
private:
TPipe& pipe_;
TQue<TPosition::VECIN,2> qC_;
TQue<TPosition::VECIN,1> qGroup_,qScale_;
TQue<TPosition::VECOUT,2> qY_;
TBuf<TPosition::VECCALC> z_,y_;
GlobalTensor<half> yGm_;
GlobalTensor<int32_t> ringGm_;
GlobalTensor<float> scaleGm_;
LocalTensor<int64_t> groups_;
uint32_t n_,producer_,sub_,bm_,width_,slots_,maxLanes_;
bool singleShot_;
};
class AtomicPartialConsumer{
public:
__aicore__ inline AtomicPartialConsumer(TPipe& pipe): pipe_(pipe){}
__aicore__ inline void SetParts(uint32_t parts){parts_ = parts;}
__aicore__ inline void Init(GM_ADDR scale,GM_ADDR y,GM_ADDR ring,GM_ADDR groups,
uint32_t e,uint32_t n,uint32_t producer,uint32_t bm,uint32_t width,
bool singleShot,bool broadcastScale = false){
scaleGm_.SetGlobalBuffer((__gm__ float*)scale);
yGm_.SetGlobalBuffer((__gm__ half*)y);
ringGm_.SetGlobalBuffer((__gm__ int32_t*)ring);
n_ = n;producer_ = producer;sub_ = GetSubBlockIdx();
bm_ = bm;width_ = width;singleShot_ = singleShot;
slots_ = singleShot ? 1 : 4;
broadcastScale_ = broadcastScale;
maxLanes_ = broadcastScale ? 8192 :(singleShot ? 2048 : 4096);
pipe_.InitBuffer(qC_,singleShot ? 1 : 2,maxLanes_ * sizeof(int32_t));
pipe_.InitBuffer(qY_,2,maxLanes_ * sizeof(half));
const uint32_t scalePad = broadcastScale ?(384 -(width * 4)% 256)% 256 : 0;
pipe_.InitBuffer(qScale_,2,(broadcastScale ? width : maxLanes_)* sizeof(float)+ scalePad);
pipe_.InitBuffer(z_,maxLanes_ * sizeof(float)+(broadcastScale ? 256 : 0));
pipe_.InitBuffer(y_,maxLanes_ * sizeof(float));
pipe_.InitBuffer(qGroup_,1,(e * 8 + 31)/ 32 * 32);
GlobalTensor<int64_t> groupGm;
groupGm.SetGlobalBuffer((__gm__ int64_t*)groups);
auto group = qGroup_.AllocTensor<int64_t>();
DataCopyPad(group,groupGm,{1,e * 8,0,0,0},{false,0,0,0});
qGroup_.EnQue(group);
groups_ = qGroup_.DeQue<int64_t>();
auto event = pipe_.FetchEventID(HardEvent::MTE2_S);
SetFlag<HardEvent::MTE2_S>(event);
WaitFlag<HardEvent::MTE2_S>(event);
}
__aicore__ inline void InitializePartials(uint32_t tiles,uint32_t producers){
DisableDmaAtomic();
auto zeros = y_.Get<int32_t>();
Duplicate(zeros,int32_t(0),maxLanes_);
const auto ready = pipe_.FetchEventID(HardEvent::V_MTE3);
SetFlag<HardEvent::V_MTE3>(ready);
WaitFlag<HardEvent::V_MTE3>(ready);
const uint32_t tileElements = bm_ * width_;
const uint32_t worker = producer_ * 2 + sub_;
for(uint32_t tile = worker;tile < tiles;tile += producers * 2){
const uint64_t base = static_cast<uint64_t>(tile)* parts_ * tileElements;
for(uint32_t offset = 0;offset < tileElements;offset += maxLanes_){
const uint32_t remaining = tileElements - offset;
const uint32_t count = remaining < maxLanes_ ? remaining : maxLanes_;
DataCopy(ringGm_[base + offset],zeros,count);
}
}
PipeBarrier<PIPE_ALL>();
SyncAll();
CrossCoreSetFlag<2,PIPE_MTE3>(0);
}
__aicore__ inline LocalTensor<int64_t> Groups()const{return groups_;}
struct Packet{TaskDesc task;uint32_t first,row,rows;};
__aicore__ inline void Prefetch(const Packet& packet,uint32_t slot,bool last){
const TaskDesc& task = packet.task;
const uint32_t p8 =(task.validN + 7)/ 8 * 8;
const uint64_t offset = static_cast<uint64_t>(slot)* parts_ * bm_ * width_
+(packet.first + packet.row)* width_;
auto acc = qC_.AllocTensor<int32_t>();
DataCopyPad(acc,ringGm_[offset],
{static_cast<uint16_t>(packet.rows),task.validN * 4,
(width_ - task.validN)* 4,0,0},
{true,0,static_cast<uint8_t>(p8 - task.validN),0});
qC_.EnQue(acc);
}
__aicore__ inline void Compute(const Packet& packet,const LocalTensor<float>& scales,uint32_t lanes){
const TaskDesc& task = packet.task;
const uint32_t p8 =(task.validN + 7)/ 8 * 8;
const uint32_t p16 =(task.validN + 15)/ 16 * 16;
auto acc = qC_.DeQue<int32_t>();
auto z = z_.Get<float>();
auto y = y_.Get<float>();
const uint32_t active = packet.rows * p8;
Cast(z,acc,RoundMode::CAST_RINT,active);PipeBarrier<PIPE_V>();
if(broadcastScale_){
const BinaryRepeatParams stride ={1,1,1,
static_cast<uint8_t>(p8 / 8),static_cast<uint8_t>(p8 / 8),0};
for(uint32_t col = 0;col < p8;col += 64){
const uint64_t live = p8 - col < 64 ? p8 - col : 64;
Mul<float>(z[col],z[col],scales[col],live,
static_cast<uint8_t>(packet.rows),stride);
}
PipeBarrier<PIPE_V>();
}else{
Mul(z,z,scales,active);PipeBarrier<PIPE_V>();
}
gmg::Gelu7Count(z,y,active);
auto output = qY_.AllocTensor<half>();
if(p8 == p16){
Cast(output,y,RoundMode::CAST_RINT,packet.rows * p8);
}else{
Duplicate(output,half(0),packet.rows * p16);PipeBarrier<PIPE_V>();
const UnaryRepeatParams stride ={1,1,
static_cast<uint8_t>(p16 / 16),static_cast<uint8_t>(p8 / 8)};
for(uint32_t col = 0;col < p8;col += 64){
const uint64_t live = p8 - col < 64 ? p8 - col : 64;
Cast<half,float>(output[col],y[col],RoundMode::CAST_RINT,
live,static_cast<uint8_t>(packet.rows),stride);
}
}
qY_.EnQue(output);
output = qY_.DeQue<half>();
DataCopyPad(yGm_[static_cast<uint64_t>(task.row + packet.first + packet.row)* n_ + task.col],
output,{static_cast<uint16_t>(packet.rows),task.validN * 2,
0,(n_ - task.validN)* 2,0});
qY_.FreeTensor(output);
qC_.FreeTensor(acc);
}
__aicore__ inline void Submit(const TaskDesc& task,uint32_t sequence){
const uint32_t slot = sequence;
const uint32_t rowLanes = parts_ * 2;
const uint32_t rowsPerLane =(task.validM + rowLanes - 1)/ rowLanes;
const uint32_t lane =(producer_ % parts_)* 2 + sub_;
const uint32_t first = lane * rowsPerLane;
const uint32_t rows = first < task.validM
?(task.validM - first < rowsPerLane ? task.validM - first : rowsPerLane): 0;
if(rows == 0){
return;
}
const uint32_t p8 =(task.validN + 7)/ 8 * 8;
const uint32_t p16 =(task.validN + 15)/ 16 * 16;
const uint32_t outputRows = maxLanes_ / p16;
uint32_t packetRows = 1;
while(packetRows < rows && 2 * packetRows <= outputRows && packetRows < 128)packetRows *= 2;
const uint32_t lanes = packetRows * p8;
auto scales = qScale_.AllocTensor<float>();
DataCopyPad(scales,scaleGm_[static_cast<uint64_t>(task.expert)* n_ + task.col],
{1,task.validN * 4,0,0,0},{true,0,static_cast<uint8_t>(p8 - task.validN),0.0f});
qScale_.EnQue(scales);
scales = qScale_.DeQue<float>();
for(uint32_t copies = 1;!broadcastScale_ && copies < packetRows;copies *= 2){
Adds(scales[copies * p8],scales,0.0f,copies * p8);PipeBarrier<PIPE_V>();
}
Packet current ={task,first,0,rows < packetRows ? rows : packetRows};
Prefetch(current,slot,current.rows == rows);
for(;;){
const uint32_t nextRow = current.row + current.rows;
Packet next ={task,first,nextRow,rows - nextRow < packetRows ? rows - nextRow : packetRows};
Compute(current,scales,lanes);
if(nextRow == rows)break;
if(nextRow < rows)Prefetch(next,slot,nextRow + next.rows == rows);
current = next;
}
qScale_.FreeTensor(scales);
}
__aicore__ inline void PostCompute(uint32_t){
qGroup_.FreeTensor(groups_);
PipeBarrier<PIPE_ALL>();
}
private:
TPipe& pipe_;
TQue<TPosition::VECIN,2> qC_;
TQue<TPosition::VECIN,2> qScale_;
TQue<TPosition::VECIN,1> qGroup_;
TQue<TPosition::VECOUT,2> qY_;
TBuf<TPosition::VECCALC> z_,y_;
GlobalTensor<float> scaleGm_;
GlobalTensor<half> yGm_;
GlobalTensor<int32_t> ringGm_;
LocalTensor<int64_t> groups_;
uint32_t n_,producer_,sub_,bm_,width_,slots_,maxLanes_;
bool singleShot_,broadcastScale_;
uint32_t parts_;
};
class PrefetchedPartialConsumer{
public:
__aicore__ inline PrefetchedPartialConsumer(TPipe& pipe): pipe_(pipe){}
__aicore__ inline void SetParts(uint32_t parts){parts_ = parts;}
__aicore__ inline void Init(GM_ADDR scale,GM_ADDR y,GM_ADDR ring,GM_ADDR groups,
uint32_t e,uint32_t n,uint32_t producer,uint32_t bm,uint32_t width,
bool singleShot,bool broadcastScale = false){
scaleGm_.SetGlobalBuffer((__gm__ float*)scale);
yGm_.SetGlobalBuffer((__gm__ half*)y);
ringGm_.SetGlobalBuffer((__gm__ int32_t*)ring);
n_ = n;producer_ = producer;sub_ = GetSubBlockIdx();
bm_ = bm;width_ = width;singleShot_ = singleShot;
slots_ = singleShot ? 1 : 4;
broadcastScale_ = broadcastScale;
maxLanes_ = broadcastScale ? 8192 :(singleShot ? 2048 : 4096);
pipe_.InitBuffer(qC_,singleShot ? 1 : 2,maxLanes_ * sizeof(int32_t));
pipe_.InitBuffer(qY_,2,maxLanes_ * sizeof(half));
const uint32_t scalePad = broadcastScale ?(384 -(width * 4)% 256)% 256 : 0;
pipe_.InitBuffer(qScale_,2,(broadcastScale ? width : maxLanes_)* sizeof(float)+ scalePad);
pipe_.InitBuffer(z_,maxLanes_ * sizeof(float)+(broadcastScale ? 256 : 0));
pipe_.InitBuffer(y_,maxLanes_ * sizeof(float));
pipe_.InitBuffer(qGroup_,1,(e * 8 + 31)/ 32 * 32);
GlobalTensor<int64_t> groupGm;
groupGm.SetGlobalBuffer((__gm__ int64_t*)groups);
auto group = qGroup_.AllocTensor<int64_t>();
DataCopyPad(group,groupGm,{1,e * 8,0,0,0},{false,0,0,0});
qGroup_.EnQue(group);
groups_ = qGroup_.DeQue<int64_t>();
auto event = pipe_.FetchEventID(HardEvent::MTE2_S);
SetFlag<HardEvent::MTE2_S>(event);
WaitFlag<HardEvent::MTE2_S>(event);
partialReady_[0]= pipe_.AllocEventID<HardEvent::MTE2_V>();
partialReady_[1]= pipe_.AllocEventID<HardEvent::MTE2_V>();
}
__aicore__ inline LocalTensor<int64_t> Groups()const{return groups_;}
struct Packet{TaskDesc task;uint32_t first,row,rows;};
__aicore__ inline void Prefetch(const Packet& packet,uint32_t slot,bool last){
const TaskDesc& task = packet.task;
const uint32_t p8 =(task.validN + 7)/ 8 * 8;
const uint64_t offset = static_cast<uint64_t>(slot)* parts_ * bm_ * width_
+(packet.first + packet.row)* width_;
auto acc = qC_.AllocTensor<int32_t>();
DataCopyPad(acc,ringGm_[offset],
{static_cast<uint16_t>(packet.rows),task.validN * 4,
(width_ - task.validN)* 4,0,0},
{true,0,static_cast<uint8_t>(p8 - task.validN),0});
qC_.EnQue(acc);
}
__aicore__ inline void PrefetchPart(const Packet& packet,uint32_t part,uint32_t bank){
const TaskDesc& task = packet.task;
const uint32_t p8 =(task.validN + 7)/ 8 * 8;
const uint64_t offset =(static_cast<uint64_t>(activeTile_)* parts_ + part)* bm_ * width_
+(packet.first + packet.row)* width_;
auto extra = bank == 0 ? z_.Get<int32_t>(): y_.Get<int32_t>();
const auto reusable = pipe_.FetchEventID(HardEvent::V_MTE2);
SetFlag<HardEvent::V_MTE2>(reusable);
WaitFlag<HardEvent::V_MTE2>(reusable);
DataCopyPad(extra,ringGm_[offset],
{static_cast<uint16_t>(packet.rows),task.validN * 4,
(width_ - task.validN)* 4,0,0},
{true,0,static_cast<uint8_t>(p8 - task.validN),0});
SetFlag<HardEvent::MTE2_V>(partialReady_[bank]);
}
__aicore__ inline void Compute(const Packet& packet,const LocalTensor<float>& scales,uint32_t lanes){
const TaskDesc& task = packet.task;
const uint32_t p8 =(task.validN + 7)/ 8 * 8;
const uint32_t p16 =(task.validN + 15)/ 16 * 16;
auto acc = qC_.DeQue<int32_t>();
auto z = z_.Get<float>();
auto y = y_.Get<float>();
const uint32_t active = packet.rows * p8;
if(parts_ > 1)PrefetchPart(packet,1,0);
for(uint32_t part = 1;part < parts_;++part){
const uint32_t bank =(part - 1)& 1;
WaitFlag<HardEvent::MTE2_V>(partialReady_[bank]);
if(part + 1 < parts_)PrefetchPart(packet,part + 1,bank ^ 1);
auto extra = bank == 0 ? z_.Get<int32_t>(): y_.Get<int32_t>();
Add(acc,acc,extra,active);
PipeBarrier<PIPE_V>();
}
Cast(z,acc,RoundMode::CAST_RINT,active);PipeBarrier<PIPE_V>();
if(broadcastScale_){
const BinaryRepeatParams stride ={1,1,1,
static_cast<uint8_t>(p8 / 8),static_cast<uint8_t>(p8 / 8),0};
for(uint32_t col = 0;col < p8;col += 64){
const uint64_t live = p8 - col < 64 ? p8 - col : 64;
Mul<float>(z[col],z[col],scales[col],live,
static_cast<uint8_t>(packet.rows),stride);
}
PipeBarrier<PIPE_V>();
}else{
Mul(z,z,scales,active);PipeBarrier<PIPE_V>();
}
gmg::Gelu7Count(z,y,active);
auto output = qY_.AllocTensor<half>();
if(p8 == p16){
Cast(output,y,RoundMode::CAST_RINT,packet.rows * p8);
}else{
Duplicate(output,half(0),packet.rows * p16);PipeBarrier<PIPE_V>();
const UnaryRepeatParams stride ={1,1,
static_cast<uint8_t>(p16 / 16),static_cast<uint8_t>(p8 / 8)};
for(uint32_t col = 0;col < p8;col += 64){
const uint64_t live = p8 - col < 64 ? p8 - col : 64;
Cast<half,float>(output[col],y[col],RoundMode::CAST_RINT,
live,static_cast<uint8_t>(packet.rows),stride);
}
}
qY_.EnQue(output);
output = qY_.DeQue<half>();
DataCopyPad(yGm_[static_cast<uint64_t>(task.row + packet.first + packet.row)* n_ + task.col],
output,{static_cast<uint16_t>(packet.rows),task.validN * 2,
0,(n_ - task.validN)* 2,0});
qY_.FreeTensor(output);
qC_.FreeTensor(acc);
}
__aicore__ inline void Submit(const TaskDesc& task,uint32_t sequence){
const uint32_t slot = sequence;
activeTile_ = sequence;
const uint32_t firstHalf =(task.validM + 1)/ 2;
const uint32_t first = sub_ == 0 ? 0 : firstHalf;
const uint32_t rows = sub_ == 0 ? firstHalf : task.validM - firstHalf;
if(rows == 0){
return;
}
const uint32_t p8 =(task.validN + 7)/ 8 * 8;
const uint32_t p16 =(task.validN + 15)/ 16 * 16;
const uint32_t outputRows = maxLanes_ / p16;
uint32_t packetRows = 1;
while(packetRows < rows && 2 * packetRows <= outputRows && packetRows < 128)packetRows *= 2;
const uint32_t lanes = packetRows * p8;
auto scales = qScale_.AllocTensor<float>();
DataCopyPad(scales,scaleGm_[static_cast<uint64_t>(task.expert)* n_ + task.col],
{1,task.validN * 4,0,0,0},{true,0,static_cast<uint8_t>(p8 - task.validN),0.0f});
qScale_.EnQue(scales);
scales = qScale_.DeQue<float>();
for(uint32_t copies = 1;!broadcastScale_ && copies < packetRows;copies *= 2){
Adds(scales[copies * p8],scales,0.0f,copies * p8);PipeBarrier<PIPE_V>();
}
Packet current ={task,first,0,rows < packetRows ? rows : packetRows};
Prefetch(current,slot,current.rows == rows);
for(;;){
const uint32_t nextRow = current.row + current.rows;
Packet next ={task,first,nextRow,rows - nextRow < packetRows ? rows - nextRow : packetRows};
if(!singleShot_ && nextRow < rows)Prefetch(next,slot,nextRow + next.rows == rows);
Compute(current,scales,lanes);
if(nextRow == rows)break;
if(singleShot_)Prefetch(next,slot,nextRow + next.rows == rows);
current = next;
}
qScale_.FreeTensor(scales);
}
__aicore__ inline void PostCompute(uint32_t){
qGroup_.FreeTensor(groups_);
PipeBarrier<PIPE_ALL>();
pipe_.ReleaseEventID<HardEvent::MTE2_V>(partialReady_[0]);
pipe_.ReleaseEventID<HardEvent::MTE2_V>(partialReady_[1]);
}
private:
TEventID partialReady_[2];
TPipe& pipe_;
TQue<TPosition::VECIN,2> qC_;
TQue<TPosition::VECIN,2> qScale_;
TQue<TPosition::VECIN,1> qGroup_;
TQue<TPosition::VECOUT,2> qY_;
TBuf<TPosition::VECCALC> z_,y_;
GlobalTensor<float> scaleGm_;
GlobalTensor<half> yGm_;
GlobalTensor<int32_t> ringGm_;
LocalTensor<int64_t> groups_;
uint32_t n_,producer_,sub_,bm_,width_,slots_,maxLanes_;
bool singleShot_,broadcastScale_;
uint32_t parts_,activeTile_;
};
class RawAtomicFinalConsumer{
public:
__aicore__ inline RawAtomicFinalConsumer(TPipe& pipe): pipe_(pipe){}
__aicore__ inline void SetParts(uint32_t parts){parts_ = parts;}
__aicore__ inline void Init(GM_ADDR scale,GM_ADDR y,GM_ADDR ring,GM_ADDR groups,
uint32_t e,uint32_t n,uint32_t producer,uint32_t bm,uint32_t width,
bool singleShot,bool broadcastScale = false){
scaleGm_.SetGlobalBuffer((__gm__ float*)scale);
yGm_.SetGlobalBuffer((__gm__ half*)y);
ringGm_.SetGlobalBuffer((__gm__ int32_t*)ring);
n_ = n;producer_ = producer;sub_ = GetSubBlockIdx();
bm_ = bm;width_ = width;singleShot_ = singleShot;
slots_ = singleShot ? 1 : 4;
broadcastScale_ = broadcastScale;
maxLanes_ = broadcastScale ? 8192 :(singleShot ? 2048 : 4096);
pipe_.InitBuffer(qC_,singleShot ? 1 : 2,maxLanes_ * sizeof(int32_t));
pipe_.InitBuffer(qY_,2,maxLanes_ * sizeof(half));
const uint32_t scalePad = broadcastScale ?(384 -(width * 4)% 256)% 256 : 0;
pipe_.InitBuffer(qScale_,2,(broadcastScale ? width : maxLanes_)* sizeof(float)+ scalePad);
pipe_.InitBuffer(z_,maxLanes_ * sizeof(float)+(broadcastScale ? 256 : 0));
pipe_.InitBuffer(y_,maxLanes_ * sizeof(float));
pipe_.InitBuffer(qGroup_,1,(e * 8 + 31)/ 32 * 32);
GlobalTensor<int64_t> groupGm;
groupGm.SetGlobalBuffer((__gm__ int64_t*)groups);
auto group = qGroup_.AllocTensor<int64_t>();
DataCopyPad(group,groupGm,{1,e * 8,0,0,0},{false,0,0,0});
qGroup_.EnQue(group);
groups_ = qGroup_.DeQue<int64_t>();
auto event = pipe_.FetchEventID(HardEvent::MTE2_S);
SetFlag<HardEvent::MTE2_S>(event);
WaitFlag<HardEvent::MTE2_S>(event);
partialReady_[0]= pipe_.AllocEventID<HardEvent::MTE2_V>();
partialReady_[1]= pipe_.AllocEventID<HardEvent::MTE2_V>();
}
__aicore__ inline void InitializePartials(uint32_t tiles,uint32_t producers){
DisableDmaAtomic();
auto zeros = y_.Get<int32_t>();
Duplicate(zeros,int32_t(0),maxLanes_);
const auto ready = pipe_.FetchEventID(HardEvent::V_MTE3);
SetFlag<HardEvent::V_MTE3>(ready);
WaitFlag<HardEvent::V_MTE3>(ready);
const uint32_t tileElements = bm_ * width_;
const uint32_t worker = producer_ * 2 + sub_;
for(uint32_t tile = worker;tile < tiles;tile += producers * 2){
const uint64_t base = static_cast<uint64_t>(tile)* parts_ * tileElements;
for(uint32_t offset = 0;offset < tileElements;offset += maxLanes_){
const uint32_t remaining = tileElements - offset;
const uint32_t count = remaining < maxLanes_ ? remaining : maxLanes_;
DataCopy(ringGm_[base + offset],zeros,count);
}
}
PipeBarrier<PIPE_ALL>();
SyncAll();
CrossCoreSetFlag<2,PIPE_MTE3>(0);
}
__aicore__ inline LocalTensor<int64_t> Groups()const{return groups_;}
struct Packet{TaskDesc task;uint32_t first,row,rows;};
__aicore__ inline void Prefetch(const Packet& packet,uint32_t slot,bool last){
const TaskDesc& task = packet.task;
const uint32_t p8 =(task.validN + 7)/ 8 * 8;
const uint64_t offset = static_cast<uint64_t>(slot)* parts_ * bm_ * width_
+(packet.first + packet.row)* width_;
auto acc = qC_.AllocTensor<int32_t>();
DataCopyPad(acc,ringGm_[offset],
{static_cast<uint16_t>(packet.rows),task.validN * 4,
(width_ - task.validN)* 4,0,0},
{true,0,static_cast<uint8_t>(p8 - task.validN),0});
qC_.EnQue(acc);
}
__aicore__ inline void PrefetchPart(const Packet& packet,uint32_t part,uint32_t bank){
const TaskDesc& task = packet.task;
const uint32_t p8 =(task.validN + 7)/ 8 * 8;
const uint64_t offset =(static_cast<uint64_t>(activeTile_)* parts_ + part)* bm_ * width_
+(packet.first + packet.row)* width_;
auto extra = bank == 0 ? z_.Get<int32_t>(): y_.Get<int32_t>();
const auto reusable = pipe_.FetchEventID(HardEvent::V_MTE2);
SetFlag<HardEvent::V_MTE2>(reusable);
WaitFlag<HardEvent::V_MTE2>(reusable);
DataCopyPad(extra,ringGm_[offset],
{static_cast<uint16_t>(packet.rows),task.validN * 4,
(width_ - task.validN)* 4,0,0},
{true,0,static_cast<uint8_t>(p8 - task.validN),0});
SetFlag<HardEvent::MTE2_V>(partialReady_[bank]);
}
__aicore__ inline void Compute(const Packet& packet,const LocalTensor<float>& scales,uint32_t lanes){
const TaskDesc& task = packet.task;
const uint32_t p8 =(task.validN + 7)/ 8 * 8;
const uint32_t p16 =(task.validN + 15)/ 16 * 16;
auto acc = qC_.DeQue<int32_t>();
auto z = z_.Get<float>();
auto y = y_.Get<float>();
const uint32_t active = packet.rows * p8;
Cast(z,acc,RoundMode::CAST_RINT,active);PipeBarrier<PIPE_V>();
if(broadcastScale_){
const BinaryRepeatParams stride ={1,1,1,
static_cast<uint8_t>(p8 / 8),static_cast<uint8_t>(p8 / 8),0};
for(uint32_t col = 0;col < p8;col += 64){
const uint64_t live = p8 - col < 64 ? p8 - col : 64;
Mul<float>(z[col],z[col],scales[col],live,
static_cast<uint8_t>(packet.rows),stride);
}
PipeBarrier<PIPE_V>();
}else{
Mul(z,z,scales,active);PipeBarrier<PIPE_V>();
}
gmg::Gelu7Count(z,y,active);
auto output = qY_.AllocTensor<half>();
if(p8 == p16){
Cast(output,y,RoundMode::CAST_RINT,packet.rows * p8);
}else{
Duplicate(output,half(0),packet.rows * p16);PipeBarrier<PIPE_V>();
const UnaryRepeatParams stride ={1,1,
static_cast<uint8_t>(p16 / 16),static_cast<uint8_t>(p8 / 8)};
for(uint32_t col = 0;col < p8;col += 64){
const uint64_t live = p8 - col < 64 ? p8 - col : 64;
Cast<half,float>(output[col],y[col],RoundMode::CAST_RINT,
live,static_cast<uint8_t>(packet.rows),stride);
}
}
qY_.EnQue(output);
output = qY_.DeQue<half>();
DataCopyPad(yGm_[static_cast<uint64_t>(task.row + packet.first + packet.row)* n_ + task.col],
output,{static_cast<uint16_t>(packet.rows),task.validN * 2,
0,(n_ - task.validN)* 2,0});
qY_.FreeTensor(output);
qC_.FreeTensor(acc);
}
__aicore__ inline void Submit(const TaskDesc& task,uint32_t sequence){
const uint32_t slot = sequence;
activeTile_ = sequence;
const uint32_t firstHalf =(task.validM + 1)/ 2;
const uint32_t first = sub_ == 0 ? 0 : firstHalf;
const uint32_t rows = sub_ == 0 ? firstHalf : task.validM - firstHalf;
if(rows == 0){
return;
}
const uint32_t p8 =(task.validN + 7)/ 8 * 8;
const uint32_t p16 =(task.validN + 15)/ 16 * 16;
const uint32_t outputRows = maxLanes_ / p16;
uint32_t packetRows = 1;
while(packetRows < rows && 2 * packetRows <= outputRows && packetRows < 128)packetRows *= 2;
const uint32_t lanes = packetRows * p8;
auto scales = qScale_.AllocTensor<float>();
DataCopyPad(scales,scaleGm_[static_cast<uint64_t>(task.expert)* n_ + task.col],
{1,task.validN * 4,0,0,0},{true,0,static_cast<uint8_t>(p8 - task.validN),0.0f});
qScale_.EnQue(scales);
scales = qScale_.DeQue<float>();
for(uint32_t copies = 1;!broadcastScale_ && copies < packetRows;copies *= 2){
Adds(scales[copies * p8],scales,0.0f,copies * p8);PipeBarrier<PIPE_V>();
}
Packet current ={task,first,0,rows < packetRows ? rows : packetRows};
Prefetch(current,slot,current.rows == rows);
for(;;){
const uint32_t nextRow = current.row + current.rows;
Packet next ={task,first,nextRow,rows - nextRow < packetRows ? rows - nextRow : packetRows};
Compute(current,scales,lanes);
if(nextRow == rows)break;
if(nextRow < rows)Prefetch(next,slot,nextRow + next.rows == rows);
current = next;
}
qScale_.FreeTensor(scales);
}
__aicore__ inline void PostCompute(uint32_t){
qGroup_.FreeTensor(groups_);
PipeBarrier<PIPE_ALL>();
pipe_.ReleaseEventID<HardEvent::MTE2_V>(partialReady_[0]);
pipe_.ReleaseEventID<HardEvent::MTE2_V>(partialReady_[1]);
}
private:
TEventID partialReady_[2];
TPipe& pipe_;
TQue<TPosition::VECIN,2> qC_;
TQue<TPosition::VECIN,2> qScale_;
TQue<TPosition::VECIN,1> qGroup_;
TQue<TPosition::VECOUT,2> qY_;
TBuf<TPosition::VECCALC> z_,y_;
GlobalTensor<float> scaleGm_;
GlobalTensor<half> yGm_;
GlobalTensor<int32_t> ringGm_;
LocalTensor<int64_t> groups_;
uint32_t n_,producer_,sub_,bm_,width_,slots_,maxLanes_;
bool singleShot_,broadcastScale_;
uint32_t parts_,activeTile_;
};
__aicore__ inline void PadWeightColumns(TPipe& pipe,GM_ADDR weight,GM_ADDR image,
const LocalTensor<int64_t>& groups,uint32_t e,uint32_t k,uint32_t n,
uint32_t producers){
GlobalTensor<int8_t> src,dst;
src.SetGlobalBuffer((__gm__ int8_t*)weight);
dst.SetGlobalBuffer((__gm__ int8_t*)image);
const uint32_t pitch =(n + 31)/ 32 * 32;
const uint32_t band = 32768 / pitch;
TBuf<TPosition::VECCALC> buffers;
pipe.InitBuffer(buffers,65536);
TEventID ready[2],free[2];
for(uint32_t i = 0;i < 2;++i){
ready[i]= pipe.AllocEventID<HardEvent::MTE2_MTE3>();
free[i]= pipe.AllocEventID<HardEvent::MTE3_MTE2>();
SetFlag<HardEvent::MTE3_MTE2>(free[i]);
}
const uint32_t lane =(GetBlockIdx()/ 2)* 2 + GetSubBlockIdx();
const uint32_t lanes = producers * 2;
const uint32_t bandsPerExpert =(k + band - 1)/ band;
uint32_t bandPrefix = 0,previous = 0,work = 0;
for(uint32_t expert = 0;expert < e;++expert){
const uint32_t end = static_cast<uint32_t>(groups.GetValue(expert));
if(end != previous){
const uint32_t firstBand =(lane + lanes - bandPrefix % lanes)% lanes;
for(uint32_t index = firstBand;index < bandsPerExpert;index += lanes){
const uint32_t row = index * band;
const uint32_t count = k - row < band ? k - row : band;
const uint32_t bank = work++ % 2;
auto stage = buffers.Get<int8_t>()[bank * 32768];
WaitFlag<HardEvent::MTE3_MTE2>(free[bank]);
DataCopyPad(stage,src[static_cast<uint64_t>(expert)* k * n
+ static_cast<uint64_t>(row)* n],
{static_cast<uint16_t>(count),n,0,0,0},
{true,0,static_cast<uint8_t>(pitch - n),0});
SetFlag<HardEvent::MTE2_MTE3>(ready[bank]);
WaitFlag<HardEvent::MTE2_MTE3>(ready[bank]);
DataCopy(dst[static_cast<uint64_t>(expert)* k * pitch
+ static_cast<uint64_t>(row)* pitch],stage,count * pitch);
SetFlag<HardEvent::MTE3_MTE2>(free[bank]);
}
bandPrefix += bandsPerExpert;
}
previous = end;
}
for(uint32_t i = 0;i < 2;++i){
WaitFlag<HardEvent::MTE3_MTE2>(free[i]);
pipe.ReleaseEventID<HardEvent::MTE2_MTE3>(ready[i]);
pipe.ReleaseEventID<HardEvent::MTE3_MTE2>(free[i]);
}
SyncAll();
CrossCoreSetFlag<2,PIPE_MTE3>(5);
}
#endif
template<class Stage>
__aicore__ inline void ScheduleResidentByInputCost(Stage& stage,GM_ADDR groups,uint32_t e,
uint32_t n,uint32_t producer,uint32_t producers,uint32_t bm,uint32_t width,
uint32_t rows,uint32_t live,bool wholePanels,bool tileCost = false);
template<class Stage>
__aicore__ inline bool TryScheduleLongResidentPanels(Stage& stage,GM_ADDR groups,uint32_t e,
uint32_t n,uint32_t producer,uint32_t producers,uint32_t bm,uint32_t width){
#if defined(__DAV_C220_CUBE__)
GlobalTensor<int64_t> endpoints;endpoints.SetGlobalBuffer((__gm__ int64_t*)groups);
#else
const auto endpoints=stage.Groups();
#endif
const uint32_t columns=(n+width-1)/width;
const uint32_t rows=static_cast<uint32_t>(endpoints.GetValue(e-1));
if(static_cast<uint64_t>(rows)*columns<24ULL*bm*producers)return false;
uint32_t previous=0,live=0,tiles=0,maxRows=0;
uint64_t oldRefills=0;
for(uint32_t expert=0;expert<e;++expert){
const uint32_t end=static_cast<uint32_t>(endpoints.GetValue(expert)),count=end-previous;
const uint32_t whole=count/(3*bm),tail=count%(3*bm);
const bool merge=whole!=0&&tail!=0&&tail<=bm/8;
const uint32_t owners=(whole+(tail!=0&&!merge?1:0))*columns;
oldRefills+=producers%columns==0?(owners<producers?owners:producers):owners;
live+=(count!=0);tiles+=(count+bm-1)/bm;if(count>maxRows)maxRows=count;previous=end;
}
const uint64_t panels=static_cast<uint64_t>(live)*columns;
const bool whole=panels>=producers&&(panels+producers-1)/producers*((maxRows+bm-1)/bm)
<=(static_cast<uint64_t>(tiles)*columns+producers-1)/producers;
const uint64_t refills=panels+(whole?0:producers-1);
if(4*refills>3*oldRefills)return false;
    const bool tileCost = static_cast<uint64_t>(tiles) * bm > rows + rows / 16;
    const uint32_t costRows = tileCost ? tiles * bm : rows;
    ScheduleResidentByInputCost(stage,groups,e,n,producer,producers,bm,width,
                                costRows,live,whole,tileCost);
return true;
}
template<class Stage>
__aicore__ inline void ScheduleResidentB(Stage& stage,GM_ADDR groups,uint32_t e,
uint32_t n,uint32_t producer,uint32_t producers,uint32_t bm,uint32_t width){
if(TryScheduleLongResidentPanels(stage,groups,e,n,producer,producers,bm,width))return;
GlobalTensor<int64_t> groupGm;
groupGm.SetGlobalBuffer((__gm__ int64_t*)groups);
#if !defined(__DAV_C220_CUBE__)
auto localGroups = stage.Groups();
#endif
const uint32_t nTiles =(n + width - 1)/ width;
const uint32_t rowsPerOwner = 3 * bm;
uint32_t start = 0,prefix = 0,sequence = 0;
for(uint32_t expert = 0;expert < e;++expert){
#if defined(__DAV_C220_CUBE__)
const uint32_t end = static_cast<uint32_t>(groupGm.GetValue(expert));
#else
const uint32_t end = static_cast<uint32_t>(localGroups.GetValue(expert));
#endif
const uint32_t owners =((end - start + rowsPerOwner - 1)/ rowsPerOwner)* nTiles;
const uint32_t first =(producer + producers - prefix % producers)% producers;
for(uint32_t ordinal = first;ordinal < owners;ordinal += producers){
const uint32_t owner =(expert & 1)? owners - 1 - ordinal : ordinal;
const uint32_t firstRow = start + owner / nTiles * rowsPerOwner;
const uint32_t stop = end - firstRow < rowsPerOwner ? end : firstRow + rowsPerOwner;
const uint32_t col = owner % nTiles * width;
const uint32_t validN = n - col < width ? n - col : width;
for(uint32_t row = firstRow;row < stop;row += bm){
const uint32_t validM = stop - row < bm ? stop - row : bm;
const TaskDesc task ={expert,row,col,validM,validN};
#if defined(__DAV_C220_CUBE__)
stage.BeginOwner(row,validM);
stage.Produce(task,sequence,true);
#else
stage.Submit(task,sequence);
#endif
++sequence;
}
}
prefix += owners;
start = end;
}
stage.PostCompute(sequence);
}
template<class Stage>
__aicore__ inline void ScheduleResidentTailRows(Stage& stage,GM_ADDR groups,uint32_t e,
uint32_t n,uint32_t producer,uint32_t producers,uint32_t bm,uint32_t width){
if(TryScheduleLongResidentPanels(stage,groups,e,n,producer,producers,bm,width))return;
GlobalTensor<int64_t> groupGm;
groupGm.SetGlobalBuffer((__gm__ int64_t*)groups);
#if !defined(__DAV_C220_CUBE__)
auto localGroups = stage.Groups();
#endif
const uint32_t nTiles =(n + width - 1)/ width;
const uint32_t rowsPerOwner = 3 * bm;
uint32_t start = 0,prefix = 0,sequence = 0;
for(uint32_t expert = 0;expert < e;++expert){
#if defined(__DAV_C220_CUBE__)
const uint32_t end = static_cast<uint32_t>(groupGm.GetValue(expert));
#else
const uint32_t end = static_cast<uint32_t>(localGroups.GetValue(expert));
#endif
const uint32_t rows = end - start;
const uint32_t wholeOwners = rows / rowsPerOwner;
const uint32_t tailRows = rows - wholeOwners * rowsPerOwner;
const bool mergeTail = wholeOwners != 0 && tailRows != 0 && tailRows <= bm / 8;
const uint32_t rowOwners = wholeOwners +(tailRows != 0 && !mergeTail ? 1 : 0);
const uint32_t owners = rowOwners * nTiles;
const uint32_t first =(producer + producers - prefix % producers)% producers;
for(uint32_t ordinal = first;ordinal < owners;ordinal += producers){
const uint32_t owner =(expert & 1)? owners - 1 - ordinal : ordinal;
const uint32_t rowOwner = owner / nTiles;
const uint32_t firstRow = start + rowOwner * rowsPerOwner;
const uint32_t span = rowsPerOwner
+(mergeTail && rowOwner + 1 == rowOwners ? tailRows : 0);
const uint32_t stop = end - firstRow < span ? end : firstRow + span;
const uint32_t col = owner % nTiles * width;
const uint32_t validN = n - col < width ? n - col : width;
for(uint32_t row = firstRow;row < stop;row += bm){
const uint32_t validM = stop - row < bm ? stop - row : bm;
const TaskDesc task ={expert,row,col,validM,validN};
#if defined(__DAV_C220_CUBE__)
stage.BeginOwner(row,validM);
stage.Produce(task,sequence,true);
#else
stage.Submit(task,sequence);
#endif
++sequence;
}
}
prefix += owners;
start = end;
}
stage.PostCompute(sequence);
}
template<class Stage>
__aicore__ inline void ScheduleResidentTailWave(Stage& stage,GM_ADDR groups,uint32_t e,
uint32_t n,uint32_t producer,uint32_t producers,uint32_t bm,uint32_t width){
if(TryScheduleLongResidentPanels(stage,groups,e,n,producer,producers,bm,width))return;
GlobalTensor<int64_t> groupGm;
groupGm.SetGlobalBuffer((__gm__ int64_t*)groups);
#if !defined(__DAV_C220_CUBE__)
auto localGroups = stage.Groups();
#endif
const uint32_t nTiles =(n + width - 1)/ width;
const uint32_t rowsPerOwner = 3 * bm;
uint32_t fullOwners = 0,tailOwners = 0,checkedBoundary = 0;
bool tailKnown = false,shareTail = false;
uint32_t start = 0,prefix = 0,sequence = 0;
for(uint32_t expert = 0;expert < e;++expert){
#if defined(__DAV_C220_CUBE__)
const uint32_t end = static_cast<uint32_t>(groupGm.GetValue(expert));
#else
const uint32_t end = static_cast<uint32_t>(localGroups.GetValue(expert));
#endif
const uint32_t rows = end - start;
const uint32_t wholeOwners = rows / rowsPerOwner;
const uint32_t tailRows = rows - wholeOwners * rowsPerOwner;
const bool mergeTail = wholeOwners != 0 && tailRows != 0 && tailRows <= bm / 8;
const uint32_t rowOwners = wholeOwners +(tailRows != 0 && !mergeTail ? 1 : 0);
const uint32_t owners = rowOwners * nTiles;
if(!tailKnown && owners != 0){
const uint32_t boundary =(prefix + owners - 1)/ producers * producers;
if(boundary > checkedBoundary){
checkedBoundary = boundary;
uint32_t remaining = prefix + owners - boundary;
uint32_t previousEnd = end;
for(uint32_t next = expert + 1;next < e && remaining < producers;++next){
#if defined(__DAV_C220_CUBE__)
const uint32_t nextEnd = static_cast<uint32_t>(groupGm.GetValue(next));
#else
const uint32_t nextEnd = static_cast<uint32_t>(localGroups.GetValue(next));
#endif
const uint32_t nextRows = nextEnd - previousEnd;
const uint32_t whole = nextRows / rowsPerOwner;
const uint32_t tailRows = nextRows - whole * rowsPerOwner;
const bool merge = whole != 0 && tailRows != 0 && tailRows <= bm / 8;
remaining +=(whole +(tailRows != 0 && !merge ? 1 : 0))* nTiles;
previousEnd = nextEnd;
}
if(remaining < producers){
tailKnown = true;
fullOwners = boundary;
tailOwners = remaining;
shareTail = tailOwners != 0 && 2 * tailOwners <= producers;
}
}
}
for(uint32_t ordinal = 0;ordinal < owners;++ordinal){
const uint32_t ticket = prefix + ordinal;
const bool suffixOwner = shareTail && ticket >= fullOwners;
const uint32_t tail = suffixOwner ? ticket - fullOwners : 0;
if(!suffixOwner && ticket % producers != producer)continue;
if(suffixOwner && producer != tail && producer != tailOwners + tail)continue;
const uint32_t owner =(expert & 1)? owners - 1 - ordinal : ordinal;
const uint32_t rowOwner = owner / nTiles;
uint32_t firstRow = start + rowOwner * rowsPerOwner;
const uint32_t span = rowsPerOwner
+(mergeTail && rowOwner + 1 == rowOwners ? tailRows : 0);
uint32_t stop = end - firstRow < span ? end : firstRow + span;
if(suffixOwner){
const uint32_t splitRow = firstRow + 2 * bm;
if(producer == tail){
if(splitRow < stop)stop = splitRow;
}else{
if(splitRow >= stop)continue;
firstRow = splitRow;
}
}
const uint32_t col = owner % nTiles * width;
const uint32_t validN = n - col < width ? n - col : width;
for(uint32_t row = firstRow;row < stop;row += bm){
const uint32_t validM = stop - row < bm ? stop - row : bm;
const TaskDesc task ={expert,row,col,validM,validN};
#if defined(__DAV_C220_CUBE__)
stage.BeginOwner(row,validM);
stage.Produce(task,sequence,true);
#else
stage.Submit(task,sequence);
#endif
++sequence;
}
}
prefix += owners;
start = end;
}
stage.PostCompute(sequence);
}
template<class Stage>
__aicore__ inline void ScheduleTailWeightedColumns(Stage& stage,GM_ADDR groups,
uint32_t e,uint32_t n,uint32_t producer,uint32_t producers,
uint32_t bm,uint32_t width,uint32_t ownerG){
GlobalTensor<int64_t> groupGm;
groupGm.SetGlobalBuffer((__gm__ int64_t*)groups);
#if !defined(__DAV_C220_CUBE__)
const auto localGroups = stage.Groups();
#endif
uint32_t previous = 0,longRows = 0,shortRows = 0,largestShort = 0;
bool allAligned = true;
for(uint32_t expert = 0;expert < e;++expert){
#if defined(__DAV_C220_CUBE__)
const uint32_t end = static_cast<uint32_t>(groupGm.GetValue(expert));
#else
const uint32_t end = static_cast<uint32_t>(localGroups.GetValue(expert));
#endif
const uint32_t rows = end - previous;
longRows += rows / bm;
const uint32_t tail = rows % bm;
if(tail >=(bm + 1)/ 2)++longRows;
else if(tail != 0){
++shortRows;
if(tail > largestShort)largestShort = tail;
}
allAligned = allAligned && tail == 0;
previous = end;
}
const uint32_t nTiles =(n + width - 1)/ width;
const uint32_t longTasks = longRows * nTiles;
const uint32_t remainder = longTasks % producers;
const uint32_t shortWorkers = producers - remainder;
const uint32_t shortWaves =(shortRows * nTiles + shortWorkers - 1)/ shortWorkers;
const uint32_t baseLong = longTasks / producers;
const uint32_t paddedShort =(largestShort + 15)/ 16 * 16;
const bool balance = remainder != 0 && baseLong != 0 && shortRows != 0
&& shortWaves <= 2 && shortWaves * paddedShort <= bm;
if(!balance){
Schedule(stage,groups,e,n,producer,producers,bm,width,
allAligned ? ownerG : 1,false);
return;
}
uint32_t start = 0,longPrefix = 0,shortPrefix = 0,sequence = 0;
for(uint32_t expert = 0;expert < e;++expert){
#if defined(__DAV_C220_CUBE__)
const uint32_t end = static_cast<uint32_t>(groupGm.GetValue(expert));
#else
const uint32_t end = static_cast<uint32_t>(localGroups.GetValue(expert));
#endif
for(uint32_t row = start;row < end;row += bm){
const uint32_t validM = end - row < bm ? end - row : bm;
const bool shortBlock = validM <(bm + 1)/ 2;
const uint32_t prefix = shortBlock ? shortPrefix : longPrefix;
for(uint32_t column = 0;column < nTiles;++column){
const uint32_t owner = shortBlock
? remainder +(prefix + column)% shortWorkers
:(prefix + column)% producers;
if(owner != producer)continue;
const uint32_t col = column * width;
const uint32_t validN = n - col < width ? n - col : width;
const TaskDesc task ={expert,row,col,validM,validN};
#if defined(__DAV_C220_CUBE__)
stage.BeginOwner(row,validM);
stage.Produce(task,sequence,true);
#else
stage.Submit(task,sequence);
#endif
++sequence;
}
if(shortBlock)shortPrefix += nTiles;
else longPrefix += nTiles;
}
start = end;
}
stage.PostCompute(sequence);
}
struct GroupResidencyPlan{
uint32_t rows=0,live=0,tiles=0,compactTiles=0,width=0,minRows=~0u,maxRows=0;
bool resident=false,wholePanels=false;
};
template<class Groups>
__aicore__ inline GroupResidencyPlan PlanGroupResidency(const Groups& groups,uint32_t e,
uint32_t n,uint32_t k,uint32_t bm,uint32_t width,uint32_t bk,uint32_t producers){
GroupResidencyPlan p;
for(uint32_t expert=0;expert<e;++expert){
const uint32_t end=static_cast<uint32_t>(groups.GetValue(expert)),rows=end-p.rows;
if(rows && rows<p.minRows)p.minRows=rows;
if(rows>p.maxRows)p.maxRows=rows;
p.live+=(rows!=0);p.tiles+=(rows+bm-1)/bm;p.compactTiles+=(rows+95)/96;p.rows=end;
}
p.width=width;
if(p.compactTiles<=p.tiles || p.minRows<2*bm)return p;
const uint32_t columns=(n+width-1)/width;
// Each core boundary can add at most one B-panel refill. Require two
// full M panels of useful work per refill, including those extra loads.
const uint64_t refills=static_cast<uint64_t>(p.live)*columns+producers-1;
const bool splitReusable=static_cast<uint64_t>(p.rows)*columns>=2ULL*bm*refills;
p.width=((n+columns-1)/columns+31)/32*32;
const uint32_t reserveK=4*192>2*bk?4*192:2*bk;
const uint64_t originalInput=p.rows+static_cast<uint64_t>(p.tiles)*n;
const uint64_t residentInput=static_cast<uint64_t>(p.rows)*columns+static_cast<uint64_t>(p.live)*n;
p.resident=splitReusable && residentInput<originalInput
&& static_cast<uint64_t>((k+31)/32*32)*p.width<=static_cast<uint64_t>(reserveK)*320;
const uint64_t panels=static_cast<uint64_t>(p.live)*columns;
const uint64_t wholePeak=(panels+producers-1)/producers*(p.maxRows+p.width);
p.wholePanels=panels>=producers && wholePeak<=(residentInput+producers-1)/producers+p.width;
uint32_t divisor=p.live,other=producers;
while(other){const uint32_t rest=divisor%other;divisor=other;other=rest;}
const uint32_t step=producers/divisor;
const uint32_t targetColumns=(columns+step-1)/step*step;
const uint32_t candidateWidth=((n+targetColumns-1)/targetColumns+31)/32*32;
const uint32_t actualColumns=(n+candidateWidth-1)/candidateWidth;
const uint64_t candidatePanels=static_cast<uint64_t>(p.live)*actualColumns;
const uint64_t candidateInput=static_cast<uint64_t>(p.rows)*actualColumns+static_cast<uint64_t>(p.live)*n;
const uint64_t candidatePeak=candidatePanels/producers*(p.maxRows+candidateWidth);
const uint64_t referencePeak=p.resident?(p.wholePanels?wholePeak:
(residentInput+producers-1)/producers+p.width):(originalInput+producers-1)/producers;
if(actualColumns==targetColumns && candidatePanels>=producers && candidateInput<originalInput
&& candidatePeak<referencePeak && candidateWidth<=width
&& static_cast<uint64_t>((k+31)/32*32)*candidateWidth<=static_cast<uint64_t>(reserveK)*320){
p.resident=true;p.wholePanels=true;p.width=candidateWidth;
}
return p;
}
template<class Stage>
__aicore__ inline void ScheduleResidentByInputCost(Stage& stage,GM_ADDR groups,uint32_t e,
uint32_t n,uint32_t producer,uint32_t producers,uint32_t bm,uint32_t width,
uint32_t rows,uint32_t live,bool wholePanels,bool tileCost){
#if defined(__DAV_C220_CUBE__)
GlobalTensor<int64_t> endpoints;endpoints.SetGlobalBuffer((__gm__ int64_t*)groups);
#else
const auto endpoints=stage.Groups();
#endif
const uint32_t columns=(n+width-1)/width;
    const uint64_t panelCost = tileCost ? 0 : static_cast<uint64_t>(live) * n;
    const uint64_t total = wholePanels ? static_cast<uint64_t>(live) * columns
                                     : static_cast<uint64_t>(rows) * columns + panelCost;
const uint64_t first=total*producer/producers,stop=total*(producer+1)/producers;
uint64_t prefix=0;uint32_t start=0,sequence=0;
for(uint32_t expert=0;expert<e;++expert){
const uint32_t end=static_cast<uint32_t>(endpoints.GetValue(expert)),m=end-start;
if(m)for(uint32_t col=0;col<n;col+=width){
const uint32_t validN=n-col<width?n-col:width,tiles=(m+bm-1)/bm;
        const uint32_t rowCost = tileCost ? tiles * bm : m;
        const uint64_t aStart = prefix + (tileCost ? 0 : validN);
        const uint64_t next = wholePanels ? prefix + 1 : aStart + rowCost;
if(first<next && stop>prefix){
const uint32_t begin=wholePanels?0:(first>aStart?static_cast<uint32_t>((first-aStart)/bm):0);
const uint32_t limit=wholePanels?tiles:(stop>=next?tiles:(stop>aStart?static_cast<uint32_t>((stop-aStart)/bm):0));
for(uint32_t position=begin;position<limit;++position){
const uint32_t tile=wholePanels?(position+col/width)%tiles:position;
const uint32_t row=start+tile*bm;
const TaskDesc task={expert,row,col,end-row<bm?end-row:bm,validN};
#if defined(__DAV_C220_CUBE__)
stage.BeginOwner(task.row,task.validM);stage.Produce(task,sequence,true);
#else
stage.Submit(task,sequence);
#endif
++sequence;
}
}
prefix=next;
}
start=end;
}
stage.PostCompute(sequence);
}
template<class Stage>
__aicore__ inline void SchedulePlannedStrips(Stage& stage,GM_ADDR groups,uint32_t e,
uint32_t n,uint32_t producer,uint32_t producers,uint32_t bm,uint32_t width,const GroupResidencyPlan& plan){
GlobalTensor<int64_t> groupGm;
groupGm.SetGlobalBuffer((__gm__ int64_t*)groups);
#if !defined(__DAV_C220_CUBE__)
auto localGroups = stage.Groups();
#endif
const uint32_t strips =(n + 31)/ 32;
uint64_t rowTiles=plan.tiles;
if(plan.compactTiles<=rowTiles){
bm=96;width=320;rowTiles=plan.compactTiles;stage.Retile(bm,width,96);
}
const uint64_t total = rowTiles * strips;
const uint64_t first = total * producer / producers;
const uint64_t stop = total *(producer + 1)/ producers;
uint32_t start = 0,sequence = 0;
uint64_t prefix = 0;
for(uint32_t expert = 0;expert < e;++expert){
#if defined(__DAV_C220_CUBE__)
const uint32_t end = static_cast<uint32_t>(groupGm.GetValue(expert));
#else
const uint32_t end = static_cast<uint32_t>(localGroups.GetValue(expert));
#endif
const uint64_t next = prefix + static_cast<uint64_t>((end - start + bm - 1)/ bm)* strips;
uint64_t cursor = first > prefix ? first : prefix;
const uint64_t limit = stop < next ? stop : next;
while(cursor < limit){
const uint32_t tile = static_cast<uint32_t>((cursor - prefix)/ strips);
const uint32_t row = start + tile * bm;
const uint32_t validM = end - row < bm ? end - row : bm;
const uint64_t rowEnd = prefix + static_cast<uint64_t>(tile + 1)* strips;
const uint64_t pieceEnd = limit < rowEnd ? limit : rowEnd;
uint32_t col = static_cast<uint32_t>((cursor - prefix)% strips)* 32;
#if defined(__DAV_C220_CUBE__)
stage.BeginOwner(row,validM);
#endif
while(cursor < pieceEnd){
const uint32_t count = pieceEnd - cursor < width / 32
? static_cast<uint32_t>(pieceEnd - cursor): width / 32;
const uint32_t validN = n - col < count * 32 ? n - col : count * 32;
const TaskDesc task ={expert,row,col,validM,validN};
#if defined(__DAV_C220_CUBE__)
stage.Produce(task,sequence,cursor + count == pieceEnd);
#else
stage.Submit(task,sequence);
#endif
++sequence;
cursor += count;
col += count * 32;
}
}
prefix = next;
start = end;
}
stage.PostCompute(sequence);
}
template<class Stage>
__aicore__ inline void ScheduleTransferWeightedStrips(Stage& stage,GM_ADDR groups,uint32_t e,
uint32_t n,uint32_t producer,uint32_t producers,uint32_t bm,uint32_t width,bool weighted=true){
GlobalTensor<int64_t> gg;gg.SetGlobalBuffer((__gm__ int64_t*)groups);
#if !defined(__DAV_C220_CUBE__)
auto lg=stage.Groups();
#endif
const uint32_t strips=(n+31)/32,bias=4*(bm/16),fullWeight=weighted?bm/16+bias:1;
uint64_t total=0;uint32_t previous=0;
for(uint32_t expert=0;expert<e;++expert){
#if defined(__DAV_C220_CUBE__)
const uint32_t end=gg.GetValue(expert);
#else
const uint32_t end=lg.GetValue(expert);
#endif
const uint32_t rows=end-previous,tail=rows%bm;
total+=static_cast<uint64_t>(rows/bm)*fullWeight*strips;
if(tail)total+=static_cast<uint64_t>(weighted?(tail+15)/16+bias:1)*strips;
previous=end;
}
const uint64_t first=total*producer/producers,stop=total*(producer+1)/producers;
uint64_t prefix=0;uint32_t start=0,sequence=0;
for(uint32_t expert=0;expert<e;++expert){
#if defined(__DAV_C220_CUBE__)
const uint32_t end=gg.GetValue(expert);
#else
const uint32_t end=lg.GetValue(expert);
#endif
for(uint32_t row=start;row<end;row+=bm){
const uint32_t vm=end-row<bm?end-row:bm,weight=weighted?(vm+15)/16+bias:1;
const uint64_t span=static_cast<uint64_t>(weight)*strips,next=prefix+span;
if(first<next && stop>prefix){
uint32_t cursor=first>prefix?static_cast<uint32_t>((first-prefix+weight-1)/weight):0;
const uint32_t limit=stop>=next?strips:static_cast<uint32_t>((stop-prefix+weight-1)/weight);
if(cursor<limit){
#if defined(__DAV_C220_CUBE__)
stage.BeginOwner(row,vm);
#endif
while(cursor<limit){
const uint32_t count=limit-cursor<width/32?limit-cursor:width/32,col=cursor*32;
const uint32_t vn=n-col<count*32?n-col:count*32;
const TaskDesc task={expert,row,col,vm,vn};
#if defined(__DAV_C220_CUBE__)
stage.Produce(task,sequence,cursor+count==limit);
#else
stage.Submit(task,sequence);
#endif
++sequence;cursor+=count;
}
}
}
prefix=next;
}
start=end;
}
stage.PostCompute(sequence);
}
template<bool ADAPT_COLUMNS = false,class Stage>
__aicore__ inline void ScheduleStrips(Stage& stage,GM_ADDR groups,uint32_t e,
uint32_t n,uint32_t producer,uint32_t producers,uint32_t bm,uint32_t width){
GlobalTensor<int64_t> groupGm;
groupGm.SetGlobalBuffer((__gm__ int64_t*)groups);
#if !defined(__DAV_C220_CUBE__)
auto localGroups = stage.Groups();
#endif
const uint32_t strips =(n + 31)/ 32;
uint32_t previous = 0;
uint64_t rowTiles = 0,compactRowTiles = 0;
for(uint32_t expert = 0;expert < e;++expert){
#if defined(__DAV_C220_CUBE__)
const uint32_t end = static_cast<uint32_t>(groupGm.GetValue(expert));
#else
const uint32_t end = static_cast<uint32_t>(localGroups.GetValue(expert));
#endif
rowTiles +=(end - previous + bm - 1)/ bm;
if constexpr(ADAPT_COLUMNS)compactRowTiles +=(end - previous + 95)/ 96;
previous = end;
}
if constexpr(ADAPT_COLUMNS){
if(compactRowTiles <= rowTiles){
bm = 96;width = 320;rowTiles = compactRowTiles;
stage.Retile(bm,width,96);
}
}
const uint64_t total = rowTiles * strips;
const uint64_t first = total * producer / producers;
const uint64_t stop = total *(producer + 1)/ producers;
uint32_t start = 0,sequence = 0;
uint64_t prefix = 0;
for(uint32_t expert = 0;expert < e;++expert){
#if defined(__DAV_C220_CUBE__)
const uint32_t end = static_cast<uint32_t>(groupGm.GetValue(expert));
#else
const uint32_t end = static_cast<uint32_t>(localGroups.GetValue(expert));
#endif
const uint64_t next = prefix + static_cast<uint64_t>((end - start + bm - 1)/ bm)* strips;
uint64_t cursor = first > prefix ? first : prefix;
const uint64_t limit = stop < next ? stop : next;
while(cursor < limit){
const uint32_t tile = static_cast<uint32_t>((cursor - prefix)/ strips);
const uint32_t row = start + tile * bm;
const uint32_t validM = end - row < bm ? end - row : bm;
const uint64_t rowEnd = prefix + static_cast<uint64_t>(tile + 1)* strips;
const uint64_t pieceEnd = limit < rowEnd ? limit : rowEnd;
uint32_t col = static_cast<uint32_t>((cursor - prefix)% strips)* 32;
#if defined(__DAV_C220_CUBE__)
stage.BeginOwner(row,validM);
#endif
while(cursor < pieceEnd){
const uint32_t count = pieceEnd - cursor < width / 32
? static_cast<uint32_t>(pieceEnd - cursor): width / 32;
const uint32_t validN = n - col < count * 32 ? n - col : count * 32;
const TaskDesc task ={expert,row,col,validM,validN};
#if defined(__DAV_C220_CUBE__)
stage.Produce(task,sequence,cursor + count == pieceEnd);
#else
stage.Submit(task,sequence);
#endif
++sequence;
cursor += count;
col += count * 32;
}
}
prefix = next;
start = end;
}
stage.PostCompute(sequence);
}
template<class Stage>
__aicore__ inline void ScheduleSkewAware(Stage& stage,GM_ADDR groups,uint32_t e,
uint32_t n,uint32_t producer,uint32_t producers,uint32_t bm,
uint32_t width,uint32_t ownerG,bool checkOwnerAlignment){
GlobalTensor<int64_t> groupGm;
groupGm.SetGlobalBuffer((__gm__ int64_t*)groups);
#if !defined(__DAV_C220_CUBE__)
auto localGroups = stage.Groups();
#endif
bool rotateColumns = false;
uint32_t splitOwnerG = 1;
if(ownerG > 1 && n % width != 0){
uint32_t previous = 0,rowTiles = 0,largestRows = 0,live = 0;
for(uint32_t expert = 0;expert < e;++expert){
#if defined(__DAV_C220_CUBE__)
const uint32_t end = static_cast<uint32_t>(groupGm.GetValue(expert));
#else
const uint32_t end = static_cast<uint32_t>(localGroups.GetValue(expert));
#endif
const uint32_t rows = end - previous;
rowTiles +=(rows + bm - 1)/ bm;
if(rows > largestRows)largestRows = rows;
if(rows != 0)++live;
previous = end;
}
const uint32_t nTiles =(n + width - 1)/ width;
const uint32_t columnGroups =(nTiles + ownerG - 1)/ ownerG;
const uint32_t largestTiles =(largestRows + bm - 1)/ bm;
rotateColumns = columnGroups == 1
? rowTiles > producers && largestRows > previous / 2 && largestTiles < producers
: live == 1 && rowTiles < producers;
if(rotateColumns){
const uint32_t targetOwners =(3 * producers + 1)/ 2;
const uint32_t minGroups =(targetOwners + largestTiles - 1)/ largestTiles;
const uint32_t reuse =(nTiles - 1)/(minGroups - 1);
splitOwnerG = reuse > 0 ? reuse : 1;
}
}
if(rotateColumns)ownerG = splitOwnerG;
if(checkOwnerAlignment){
uint32_t previous = 0;
for(uint32_t expert = 0;expert < e;++expert){
#if defined(__DAV_C220_CUBE__)
const uint32_t end = static_cast<uint32_t>(groupGm.GetValue(expert));
#else
const uint32_t end = static_cast<uint32_t>(localGroups.GetValue(expert));
#endif
if((end - previous)% bm != 0){
ownerG = 1;
break;
}
previous = end;
}
}
const uint32_t nTiles =(n + width - 1)/ width;
const uint32_t columnGroups =(nTiles + ownerG - 1)/ ownerG;
const uint32_t columnsPerGroup = columnGroups == 0 ? 0 : nTiles / columnGroups;
const uint32_t colRemainder = columnGroups == 0 ? 0 : nTiles % columnGroups;
uint32_t start = 0,prefix = 0,sequence = 0;
for(uint32_t expert = 0;expert < e;++expert){
#if defined(__DAV_C220_CUBE__)
const uint32_t end = static_cast<uint32_t>(groupGm.GetValue(expert));
#else
const uint32_t end = static_cast<uint32_t>(localGroups.GetValue(expert));
#endif
const uint32_t owners =((end - start + bm - 1)/ bm)* columnGroups;
const uint32_t first =(producer + producers - prefix % producers)% producers;
for(uint32_t owner = first;owner < owners;owner += producers){
const uint32_t row = start + owner / columnGroups * bm;
const uint32_t validM = end - row < bm ? end - row : bm;
const uint32_t rawGroup = owner % columnGroups;
const uint32_t group = rotateColumns
?(rawGroup + expert + owner / columnGroups)% columnGroups : rawGroup;
const uint32_t firstColumn = group * columnsPerGroup
+(group < colRemainder ? group : colRemainder);
const uint32_t columns = columnsPerGroup +(group < colRemainder ? 1 : 0);
#if defined(__DAV_C220_CUBE__)
stage.BeginOwner(row,validM);
#endif
for(uint32_t column = 0;column < columns;++column){
const uint32_t col =(firstColumn + column)* width;
const uint32_t validN = n - col < width ? n - col : width;
const TaskDesc task ={expert,row,col,validM,validN};
#if defined(__DAV_C220_CUBE__)
stage.Produce(task,sequence,column + 1 == columns);
#else
stage.Submit(task,sequence);
#endif
++sequence;
}
}
prefix += owners;
start = end;
}
stage.PostCompute(sequence);
}
template<bool GROUP_B = false,class Stage>
__aicore__ inline void ScheduleUnderfilledRows(Stage& stage,GM_ADDR groups,uint32_t e,
uint32_t n,uint32_t producer,uint32_t producers,uint32_t bm,
uint32_t width,uint32_t ownerG,uint32_t k=0,uint32_t bk=0){
GlobalTensor<int64_t> groupGm;
groupGm.SetGlobalBuffer((__gm__ int64_t*)groups);
#if !defined(__DAV_C220_CUBE__)
auto localGroups = stage.Groups();
#endif
const uint32_t nTiles =(n + width - 1)/ width;
const uint32_t columnGroups =(nTiles + ownerG - 1)/ ownerG;
if(columnGroups == 1){
uint32_t previous = 0,rowTiles = 0,live = 0,paddedRows=0,maxRows=0;
for(uint32_t expert = 0;expert < e;++expert){
#if defined(__DAV_C220_CUBE__)
const uint32_t end = static_cast<uint32_t>(groupGm.GetValue(expert));
#else
const uint32_t end = static_cast<uint32_t>(localGroups.GetValue(expert));
#endif
const uint32_t rows = end - previous;
rowTiles +=(rows + bm - 1)/ bm;
if constexpr(GROUP_B){
paddedRows+=(rows+15)/16*16;if(rows>maxRows)maxRows=rows;
}
if(rows != 0)++live;
previous = end;
}
if constexpr(GROUP_B){
const uint64_t panels=static_cast<uint64_t>(live)*nTiles;
const uint64_t wholePeak=(panels+producers-1)/producers*((maxRows+bm-1)/bm);
const uint64_t splitPeak=(static_cast<uint64_t>(rowTiles)*nTiles+producers-1)/producers;
const bool whole=panels>=producers && wholePeak<=splitPeak;
const uint64_t refills=panels+(whole?0:producers-1);
if(live && static_cast<uint64_t>(paddedRows)*nTiles>=2ULL*bm*refills &&(k+31)/32*32<=4*bk){
#if defined(__DAV_C220_CUBE__)
stage.EnableResidentB();
#endif
ScheduleResidentByInputCost(stage,groups,e,n,producer,producers,bm,width,previous,live,whole);
return;
}
}
if(live > 1 &&(rowTiles == live || GROUP_B)&& rowTiles < producers){
if constexpr(GROUP_B){
const uint64_t bias=4*(bm/16),totalWeight=paddedRows/16+bias*rowTiles;
const uint32_t maxPadded=maxRows>=bm?bm:(maxRows+15)/16*16;
const uint64_t excess=(maxPadded/16+bias)*rowTiles-totalWeight;
const bool weighted=static_cast<uint64_t>(rowTiles)*((n+31)/32)*excess>=producers*totalWeight;
ScheduleTransferWeightedStrips(stage,groups,e,n,producer,producers,bm,width,weighted);
}else
ScheduleStrips(stage,groups,e,n,producer,producers,bm,width);
return;
}
}
ScheduleSkewAware(stage,groups,e,n,producer,producers,bm,width,ownerG,false);
}
template<class Stage>
__aicore__ inline void ScheduleSingleRowBlockActivation(Stage& stage,GM_ADDR groups,uint32_t e,
uint32_t n,uint32_t producer,uint32_t producers,uint32_t bm,
uint32_t width,uint32_t ownerG){
GlobalTensor<int64_t> groupGm;
groupGm.SetGlobalBuffer((__gm__ int64_t*)groups);
#if !defined(__DAV_C220_CUBE__)
auto localGroups = stage.Groups();
#endif
const uint32_t nTiles =(n + width - 1)/ width;
const uint32_t columnGroups =(nTiles + ownerG - 1)/ ownerG;
const uint32_t columnsPerGroup = columnGroups == 0 ? 0 : nTiles / columnGroups;
const uint32_t colRemainder = columnGroups == 0 ? 0 : nTiles % columnGroups;
uint32_t start = 0,prefix = 0,sequence = 0;
for(uint32_t expert = 0;expert < e;++expert){
#if defined(__DAV_C220_CUBE__)
const uint32_t end = static_cast<uint32_t>(groupGm.GetValue(expert));
#else
const uint32_t end = static_cast<uint32_t>(localGroups.GetValue(expert));
#endif
const uint32_t owners =((end - start + bm - 1)/ bm)* columnGroups;
const uint32_t first =(producer + producers - prefix % producers)% producers;
for(uint32_t owner = first;owner < owners;owner += producers){
const uint32_t row = start + owner / columnGroups * bm;
const uint32_t validM = end - row < bm ? end - row : bm;
const uint32_t rawGroup = owner % columnGroups;
const uint32_t group = rawGroup;
const uint32_t firstColumn = group * columnsPerGroup
+(group < colRemainder ? group : colRemainder);
const uint32_t columns = columnsPerGroup +(group < colRemainder ? 1 : 0);
#if defined(__DAV_C220_CUBE__)
stage.BeginOwner(row,validM);
#endif
for(uint32_t column = 0;column < columns;++column){
const uint32_t col =(firstColumn + column)* width;
const uint32_t validN = n - col < width ? n - col : width;
const TaskDesc task ={expert,row,col,validM,validN};
#if defined(__DAV_C220_CUBE__)
stage.Produce(task,sequence,column + 1 == columns);
#else
stage.Submit(task,sequence);
#endif
++sequence;
}
}
prefix += owners;
start = end;
}
stage.PostCompute(sequence);
}
template<class Stage>
__aicore__ inline void ScheduleBalancedRows(Stage& stage,GM_ADDR groups,uint32_t e,
uint32_t n,uint32_t producer,uint32_t producers,uint32_t bm,
uint32_t width,uint32_t ownerG,uint32_t largeColumnGroups,bool checkOwnerAlignment){
GlobalTensor<int64_t> groupGm;
groupGm.SetGlobalBuffer((__gm__ int64_t*)groups);
#if !defined(__DAV_C220_CUBE__)
auto localGroups = stage.Groups();
#endif
if(checkOwnerAlignment){
uint32_t previous = 0;
for(uint32_t expert = 0;expert < e;++expert){
#if defined(__DAV_C220_CUBE__)
const uint32_t end = static_cast<uint32_t>(groupGm.GetValue(expert));
#else
const uint32_t end = static_cast<uint32_t>(localGroups.GetValue(expert));
#endif
if((end - previous)% bm != 0){
ownerG = 1;
break;
}
previous = end;
}
}
const uint32_t nTiles =(n + width - 1)/ width;
const uint32_t baseColumnGroups =(nTiles + ownerG - 1)/ ownerG;
uint32_t start = 0,prefix = 0,sequence = 0;
for(uint32_t expert = 0;expert < e;++expert){
#if defined(__DAV_C220_CUBE__)
const uint32_t end = static_cast<uint32_t>(groupGm.GetValue(expert));
#else
const uint32_t end = static_cast<uint32_t>(localGroups.GetValue(expert));
#endif
const uint32_t smallM = bm / 2;
const uint32_t smallRowTiles =(end - start + smallM - 1)/ smallM;
const bool shortTail = smallRowTiles > 2 && smallRowTiles % 2 != 0
&& largeColumnGroups == 2 * baseColumnGroups;
const uint32_t regularRowTile = smallRowTiles % 2 == 0 || shortTail ? bm : smallM;
const uint32_t regularEnd = shortTail ? start +(smallRowTiles / 2)* bm : end;
uint32_t segmentStart = start;
while(segmentStart < end){
const bool finalShort = segmentStart == regularEnd;
const uint32_t segmentEnd = finalShort ? end : regularEnd;
const uint32_t rowTile = finalShort ? smallM : regularRowTile;
const uint32_t columnGroups = rowTile == bm ? largeColumnGroups : baseColumnGroups;
const uint32_t columnsPerGroup = nTiles / columnGroups;
const uint32_t colRemainder = nTiles % columnGroups;
const uint32_t owners =((segmentEnd - segmentStart + rowTile - 1)/ rowTile)* columnGroups;
const uint32_t first =(producer + producers - prefix % producers)% producers;
for(uint32_t owner = first;owner < owners;owner += producers){
const uint32_t row = segmentStart + owner / columnGroups * rowTile;
const uint32_t validM = segmentEnd - row < rowTile ? segmentEnd - row : rowTile;
const uint32_t rowFirstOwner = prefix + owner - owner % columnGroups;
const uint32_t group =(owner % columnGroups
+ rowFirstOwner / producers)% columnGroups;
const uint32_t firstColumn = group * columnsPerGroup
+(group < colRemainder ? group : colRemainder);
const uint32_t columns = columnsPerGroup +(group < colRemainder ? 1 : 0);
#if defined(__DAV_C220_CUBE__)
stage.BeginOwner(row,validM);
#endif
for(uint32_t column = 0;column < columns;++column){
const uint32_t col =(firstColumn + column)* width;
const uint32_t validN = n - col < width ? n - col : width;
const TaskDesc task ={expert,row,col,validM,validN};
#if defined(__DAV_C220_CUBE__)
stage.Produce(task,sequence,column + 1 == columns);
#else
stage.Submit(task,sequence);
#endif
++sequence;
}
}
prefix += owners;
segmentStart = segmentEnd;
}
start = end;
}
stage.PostCompute(sequence);
}
template<class Stage>
__aicore__ inline void ScheduleBoundedPartialOwnerRows(Stage& stage,GM_ADDR groups,uint32_t e,
uint32_t n,uint32_t producer,uint32_t producers,uint32_t bm,
uint32_t width,uint32_t ownerG,uint32_t largeColumnGroups,uint32_t meanRows,bool checkOwnerAlignment){
GlobalTensor<int64_t> groupGm;
groupGm.SetGlobalBuffer((__gm__ int64_t*)groups);
#if !defined(__DAV_C220_CUBE__)
auto localGroups = stage.Groups();
#endif
if(checkOwnerAlignment){
uint32_t previous = 0;
for(uint32_t expert = 0;expert < e;++expert){
#if defined(__DAV_C220_CUBE__)
const uint32_t end = static_cast<uint32_t>(groupGm.GetValue(expert));
#else
const uint32_t end = static_cast<uint32_t>(localGroups.GetValue(expert));
#endif
if((end - previous)% bm != 0){
ownerG = 1;
break;
}
previous = end;
}
}
const uint32_t lowerRows =(meanRows + 1)/ 2;
const uint32_t upperRows = meanRows + meanRows / 2;
bool coalescePartials = true;
uint32_t previousEnd = 0;
for(uint32_t expert = 0;expert < e;++expert){
#if defined(__DAV_C220_CUBE__)
const uint32_t end = static_cast<uint32_t>(groupGm.GetValue(expert));
#else
const uint32_t end = static_cast<uint32_t>(localGroups.GetValue(expert));
#endif
const uint32_t rows = end - previousEnd;
if(rows < lowerRows || rows > upperRows){
coalescePartials = false;
break;
}
previousEnd = end;
}
const uint32_t nTiles =(n + width - 1)/ width;
const uint32_t baseColumnGroups =(nTiles + ownerG - 1)/ ownerG;
uint32_t start = 0,prefix = 0,sequence = 0;
for(uint32_t expert = 0;expert < e;++expert){
#if defined(__DAV_C220_CUBE__)
const uint32_t end = static_cast<uint32_t>(groupGm.GetValue(expert));
#else
const uint32_t end = static_cast<uint32_t>(localGroups.GetValue(expert));
#endif
const bool partialOwner = coalescePartials && end - start < bm;
const uint32_t smallM = bm / 2;
const uint32_t smallRowTiles =(end - start + smallM - 1)/ smallM;
const bool shortTail = smallRowTiles > 2 && smallRowTiles % 2 != 0
&& largeColumnGroups == 2 * baseColumnGroups;
const uint32_t regularRowTile = partialOwner || smallRowTiles % 2 == 0 || shortTail ? bm : smallM;
const uint32_t regularEnd = shortTail ? start +(smallRowTiles / 2)* bm : end;
uint32_t segmentStart = start;
while(segmentStart < end){
const bool finalShort = segmentStart == regularEnd;
const uint32_t segmentEnd = finalShort ? end : regularEnd;
const uint32_t rowTile = finalShort ? smallM : regularRowTile;
const uint32_t columnGroups = !partialOwner && rowTile == bm ? largeColumnGroups : baseColumnGroups;
const uint32_t columnsPerGroup = nTiles / columnGroups;
const uint32_t colRemainder = nTiles % columnGroups;
const uint32_t owners =((segmentEnd - segmentStart + rowTile - 1)/ rowTile)* columnGroups;
const uint32_t first =(producer + producers - prefix % producers)% producers;
for(uint32_t owner = first;owner < owners;owner += producers){
const uint32_t row = segmentStart + owner / columnGroups * rowTile;
const uint32_t validM = segmentEnd - row < rowTile ? segmentEnd - row : rowTile;
const uint32_t rowFirstOwner = prefix + owner - owner % columnGroups;
const uint32_t group =(owner % columnGroups
+ rowFirstOwner / producers)% columnGroups;
const uint32_t firstColumn = group * columnsPerGroup
+(group < colRemainder ? group : colRemainder);
const uint32_t columns = columnsPerGroup +(group < colRemainder ? 1 : 0);
#if defined(__DAV_C220_CUBE__)
stage.BeginOwner(row,validM);
#endif
for(uint32_t column = 0;column < columns;++column){
const uint32_t col =(firstColumn + column)* width;
const uint32_t validN = n - col < width ? n - col : width;
const TaskDesc task ={expert,row,col,validM,validN};
#if defined(__DAV_C220_CUBE__)
stage.Produce(task,sequence,column + 1 == columns);
#else
stage.Submit(task,sequence);
#endif
++sequence;
}
}
prefix += owners;
segmentStart = segmentEnd;
}
start = end;
}
stage.PostCompute(sequence);
}
