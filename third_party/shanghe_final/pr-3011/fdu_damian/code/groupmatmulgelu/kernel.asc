__global__ __aicore__ void grouped_matmul_gelu_adaptive_columns(
GM_ADDR x,GM_ADDR weight,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,
GM_ADDR ring,GM_ADDR packedScale,uint32_t k,uint32_t n,uint32_t e,
uint32_t producers,uint32_t bm,uint32_t width,uint32_t l0k,uint32_t bk,uint32_t a1Reserve){
using namespace AscendC;
KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
#if defined(__NPU_ARCH__)&& __NPU_ARCH__ == 2201
TPipe pipe;
#if defined(__DAV_C220_CUBE__)
const uint32_t producer = GetBlockIdx();
GlobalTensor<int64_t> endpoints;endpoints.SetGlobalBuffer((__gm__ int64_t*)groups);
const auto plan=gmg_native::PlanGroupResidency(endpoints,e,n,k,bm,width,bk,producers);
if(plan.resident){
gmg_native::ResidentBProducer stage(pipe);
stage.Init(x,weight,ring,k,n,producer,bm,plan.width,l0k,(k+31)/32*32,gmg_native::FULL_A,a1Reserve);
gmg_native::ScheduleResidentByInputCost(stage,groups,e,n,producer,producers,bm,plan.width,plan.rows,plan.live,plan.wholePanels);
}else{
gmg_native::DequantProducer<true> stage(pipe);
stage.Init(x,weight,ring,k,n,producer,bm,width,l0k,bk,gmg_native::FULL_A,320,a1Reserve);
gmg_native::SchedulePlannedStrips(stage,groups,e,n,producer,producers,bm,width,plan);
}
#else
const uint32_t producer = GetBlockIdx()/ 2;
gmg_native::DequantConsumer stage(pipe);
stage.Init(scale,y,ring,groups,e,n,producer,bm,width,false);
const auto plan=gmg_native::PlanGroupResidency(stage.Groups(),e,n,k,bm,width,bk,producers);
if(plan.resident){
stage.Retile(bm,plan.width,l0k);
gmg_native::ScheduleResidentByInputCost(stage,groups,e,n,producer,producers,bm,plan.width,plan.rows,plan.live,plan.wholePanels);
}else gmg_native::SchedulePlannedStrips(stage,groups,e,n,producer,producers,bm,width,plan);
#endif
#endif
}
