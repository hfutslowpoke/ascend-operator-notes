			grouped_matmul_gelu_underfilled_row_strips<<<config.producers, nullptr, stream>>>(x, weight, scale,
				group_list, y, (GM_ADDR)ring, k, n, e, config.producers,
				config.bm, config.width, config.l0k, config.bk, config.ownerG);
		}
	} else if (paddedWeight) {
		const uint64_t aBytes = static_cast<uint64_t>(config.bm) * ((k + 31) / 32 * 32);
		const uint32_t maxBk = (l1 - aBytes) / (2 * config.width) / config.l0k * config.l0k;
		const uint32_t doubledBk = config.bk * 2 < maxBk ? config.bk * 2 : maxBk;
		const uint32_t weightGroup = doubledBk < (k + 31) / 32 * 32 ? doubledBk : (k + 31) / 32 * 32;
		const uint32_t shortWeightGroup = weightGroup / 2;
		const bool fourWeightGroups = weightGroup % (4 * config.l0k) == 0 && k > weightGroup && aBytes + 4ULL * shortWeightGroup * config.width <= l1;
		if (fourWeightGroups) {
			grouped_matmul_gelu_four_weight_groups<<<config.producers, nullptr, stream>>>(x, weight, scale,
				group_list, y, (GM_ADDR)ring, (GM_ADDR)paddedImage, k, n, e, config.producers,
				config.bm, config.width, config.l0k, shortWeightGroup, config.ownerG);
		} else {
			grouped_matmul_gelu_grouped_weight_load<<<config.producers, nullptr, stream>>>(x, weight, scale,
				group_list, y, (GM_ADDR)ring, (GM_ADDR)paddedImage, k, n, e, config.producers,
				config.bm, config.width, config.l0k, weightGroup, config.ownerG);
		}
	} else if (residentB && static_cast<uint64_t>(kp) * (2ULL * config.bm + config.width) <= l1) {
		if (config.bm == 128 && config.width == 256 && config.l0k == 128) {
			if (e > config.producers && e % config.producers != 0) {
				grouped_matmul_gelu_resident_row_tail_wave<128, 256, 128><<<config.producers, nullptr, stream>>>(x, weight, scale,
					group_list, y, (GM_ADDR)ring, k, n, e, config.producers);
			} else {
				grouped_matmul_gelu_constant_resident_tile<128, 256, 128><<<config.producers, nullptr, stream>>>(x, weight, scale,
					group_list, y, (GM_ADDR)ring, k, n, e, config.producers);
			}
		} else {
			grouped_matmul_gelu_resident_tail_groups<<<config.producers, nullptr, stream>>>(x, weight, scale,
				group_list, y, (GM_ADDR)ring, k, n, e, config.producers,
				config.bm, config.width, config.l0k);
		}
	} else if (residentB || striped) {
		grouped_matmul_gelu_resident_b<<<config.producers, nullptr, stream>>>(x, weight, scale,
			group_list, y, (GM_ADDR)ring, k, n, e, config.producers, config.bm, config.width, config.l0k,
			config.bk, striped);
	} else if (config.mode == gmg_native::FULL_A && !config.singleShot && n % 32 == 0 && config.bm >= 64 && config.width >= 256 && static_cast<uint64_t>((config.bm + 1) / 2) * config.width <= gmg_native::WHOLE_PACKET_LANES) {
		const uint64_t cyclicL1 = 2ULL * (4ULL * config.l0k) * (config.bm + config.width);
		const bool columnWorkgroups = config.bm == 128 && config.width == 256 && config.l0k == 128 && config.bk == 2 * config.l0k && config.ownerG > 1 && (m + config.bm - 1) / config.bm < config.producers && cyclicL1 > l1Bytes;
		if (columnWorkgroups) {
			const bool shortInputGroup = config.mode == gmg_native::FULL_A && config.bm == 128 && config.width == 256 && config.l0k == 128 && k % 128 == 0;
			if (shortInputGroup) {
				if (static_cast<uint64_t>(config.bm) * kp + 4ULL * 128 * config.width <= l1) {
					const uint32_t nTiles = (n + config.width - 1) / config.width;
					const uint32_t columnGroups = (nTiles + config.ownerG - 1) / config.ownerG;
					const uint32_t flatRows = (m + config.bm - 1) / config.bm;
					const uint32_t nonemptyUpper = m < e ? m : e;
					const uint32_t groupedRows = nonemptyUpper + (m - nonemptyUpper) / config.bm;
					const uint32_t launchRows = nonemptyUpper > flatRows ? groupedRows : flatRows;
					const uint64_t ownerWave = static_cast<uint64_t>(launchRows) * columnGroups;
					const uint32_t launchProducers = ownerWave < config.producers
																						 ? static_cast<uint32_t>(ownerWave)
																						 : config.producers;
					grouped_matmul_gelu_owner_wave_cores<<<launchProducers, nullptr, stream>>>(x, weight, scale,
						group_list, y, (GM_ADDR)ring, (GM_ADDR)weightNz, m, k, n, e, launchProducers,
						config.bm, config.width, config.l0k, 128, config.ownerG, config.mode,
						config.slots, config.singleShot, 0u);
				} else {
					grouped_matmul_gelu_short_input_group<<<config.producers, nullptr, stream>>>(x, weight, scale,
						group_list, y, (GM_ADDR)ring, (GM_ADDR)weightNz, m, k, n, e, config.producers,
						config.bm, config.width, config.l0k, 128, config.ownerG, config.mode,
						config.slots, config.singleShot, 0u);
				}
			} else {
				grouped_matmul_gelu_single_wave_columns<<<config.producers, nullptr, stream>>>(x, weight, scale,
					group_list, y, (GM_ADDR)ring, (GM_ADDR)weightNz, m, k, n, e, config.producers,
					config.bm, config.width, config.l0k, config.bk, config.ownerG, config.mode,
					config.slots, config.singleShot, 0u);
			}
		} else if (2ULL * config.bm * kp + 2ULL * config.l0k * config.width > l1) {
			const uint32_t packetK = 2 * config.l0k;
			const bool packetFits = static_cast<uint64_t>(config.bm) * kp + 2ULL * packetK * config.width <= l1;
			if (packetFits) {
				if (static_cast<uint64_t>(config.bm) * kp + 3ULL * packetK * config.width <= l1) {
					grouped_matmul_gelu_three_scalar_input<<<config.producers, nullptr, stream>>>(x, weight, scale,
						group_list, y, (GM_ADDR)ring, (GM_ADDR)weightNz, m, k, n, e, config.producers,
						config.bm, config.width, config.l0k, packetK, config.ownerG, config.mode,
						config.slots, config.singleShot, 0u);
				} else {
					grouped_matmul_gelu_compact_scalar_events<<<config.producers, nullptr, stream>>>(x, weight, scale,
						group_list, y, (GM_ADDR)ring, (GM_ADDR)weightNz, m, k, n, e, config.producers,
						config.bm, config.width, config.l0k, packetK, config.ownerG, config.mode,
						config.slots, config.singleShot, 0u);
				}
			} else {
				grouped_matmul_gelu_guarded_tail_columns<<<config.producers, nullptr, stream>>>(x, weight, scale,
					group_list, y, (GM_ADDR)ring, (GM_ADDR)weightNz, m, k, n, e, config.producers,
					config.bm, config.width, config.l0k, config.bk, config.ownerG, config.mode,
					config.slots, config.singleShot, 0u);
			}
		} else {
			const uint32_t launchBk = config.mode == gmg_native::FULL_A && !config.singleShot && config.bm == 64 && config.width == 512 && config.l0k == 64
																	? (config.bk < 4 * config.l0k ? config.bk : 4 * config.l0k)
																	: config.bk;
			const uint32_t nTiles = (n + config.width - 1) / config.width;
			const uint32_t columnGroups = (nTiles + config.ownerG - 1) / config.ownerG;
			const uint32_t flatRows = (m + config.bm - 1) / config.bm;
			const uint32_t nonemptyUpper = m < e ? m : e;
			const uint32_t groupedRows = nonemptyUpper + (m - nonemptyUpper) / config.bm;
			const uint32_t launchRows = nonemptyUpper > flatRows ? groupedRows : flatRows;
			const uint64_t ownerWave = static_cast<uint64_t>(launchRows) * columnGroups;
			const uint32_t launchProducers = ownerWave < config.producers
																				 ? static_cast<uint32_t>(ownerWave)
																				 : config.producers;
			grouped_matmul_gelu_activation_owner_wave<<<launchProducers, nullptr, stream>>>(x, weight, scale,
				group_list, y, (GM_ADDR)ring, (GM_ADDR)weightNz, m, k, n, e, launchProducers,
				config.bm, config.width, config.l0k, launchBk, config.ownerG, config.mode,
				config.slots, config.singleShot, 0u, config.producers);
		}
	} else {
		grouped_matmul_gelu_native_unified<<<config.producers, nullptr, stream>>>(x, weight, scale,
			group_list, y, (GM_ADDR)ring, (GM_ADDR)weightNz, m, k, n, e, config.producers, config.bm,
			config.width, config.l0k, config.bk, config.ownerG, config.mode, config.slots,
			config.singleShot, tcOn ? 1u : 0u, 0u);
	}
	aclrtSynchronizeStream(stream);
	aclrtFree(ring);
	if (weightNz != nullptr) aclrtFree(weightNz);
	if (packedScale != nullptr) aclrtFree(packedScale);
	if (paddedImage != nullptr) aclrtFree(paddedImage);
	if (activationImage != nullptr) aclrtFree(activationImage);
}
