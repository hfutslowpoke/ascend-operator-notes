if(produced != 0){
SetFlag<HardEvent::FIX_M>(cFree_);
WaitFlag<HardEvent::FIX_M>(cFree_);
}
if(!singleShot_){
WaitFlag<HardEvent::MTE1_MTE2>(l1Free_);
WaitFlag<HardEvent::M_MTE1>(abFree_);
const uint32_t first = produced > slots_ ? produced - slots_ : 0;
for(uint32_t sequence = first;sequence < produced;++sequence)
