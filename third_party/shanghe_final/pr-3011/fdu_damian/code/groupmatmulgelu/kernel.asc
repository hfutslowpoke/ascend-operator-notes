__global__ __aicore__ void grouped_matmul_gelu_overlap_group_classification(
GM_ADDR x,GM_ADDR weight,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,GM_ADDR ring,
uint32_t k,uint32_t n,uint32_t e,uint32_t producers){
using namespace AscendC;
