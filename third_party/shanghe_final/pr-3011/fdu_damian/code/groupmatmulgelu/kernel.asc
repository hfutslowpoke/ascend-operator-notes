const uint32_t first = sub_ == 0 ? 0 : firstHalf;
const uint32_t rows = sub_ == 0 ? firstHalf : task.validM - firstHalf;
if(rows == 0){
CrossCoreWaitFlag<2>(READY_BASE + slot);
if(!singleShot_)CrossCoreSetFlag<2,PIPE_MTE2>(FREE_BASE + slot);
return;
}
const uint32_t p8 =(task.validN + 7)/ 8 * 8;
const uint32_t p16 =(task.validN + 15)/ 16 * 16;
const uint32_t outputRows = maxLanes_ / p16;
uint32_t packetRows = 1;
while(packetRows < rows && 2 * packetRows <= outputRows && packetRows < 128)packetRows *= 2;
const uint32_t lanes = packetRows * p8;
