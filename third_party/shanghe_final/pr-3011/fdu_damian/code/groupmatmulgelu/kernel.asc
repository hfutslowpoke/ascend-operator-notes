class SingleTaskLookaheadProducer{
public:
__aicore__ inline SingleTaskLookaheadProducer(TPipe& pipe): pipe_(pipe){}
__aicore__ inline void Init(GM_ADDR x,GM_ADDR weight,GM_ADDR ring,
uint32_t k,uint32_t n,uint32_t producer,uint32_t bm,uint32_t width,
bool singleShot){
xGm_.SetGlobalBuffer((__gm__ int8_t*)x);
wGm_.SetGlobalBuffer((__gm__ int8_t*)weight);
ringGm_.SetGlobalBuffer((__gm__ int32_t*)ring);
k_ = k;n_ = n;kPad_ =(k + 31)/ 32 * 32;
producer_ = producer;bm_ = bm;width_ = width;
singleShot_ = singleShot;slots_ = singleShot ? 1 : 4;
SetMMRowMajor();
pipe_.InitBuffer(a1_,2 * bm_ * kPad_);
pipe_.InitBuffer(b1_,2 * kPad_ * width_);
pipe_.InitBuffer(a2_,bm_ * kPad_);
pipe_.InitBuffer(b2_,kPad_ * width_);
pipe_.InitBuffer(c_,bm_ * width_ * sizeof(int32_t));
for(uint32_t bank = 0;bank < 2;++bank){
l1Ready_[bank]= pipe_.AllocEventID<HardEvent::MTE2_MTE1>();
l1Free_[bank]= pipe_.AllocEventID<HardEvent::MTE1_MTE2>();
SetFlag<HardEvent::MTE1_MTE2>(l1Free_[bank]);
}
abReady_ = pipe_.AllocEventID<HardEvent::MTE1_M>();
cFree_ = pipe_.AllocEventID<HardEvent::FIX_M>();
if(!singleShot_){
abFree_ = pipe_.AllocEventID<HardEvent::M_MTE1>();
SetFlag<HardEvent::M_MTE1>(abFree_);
}
}
__aicore__ inline void BeginOwner(uint32_t,uint32_t){}
__aicore__ inline void Produce(const TaskDesc& task,uint32_t sequence,bool){
Prefetch(task,sequence % 2);
if(pending_)ComputeTask(pendingTask_,pendingSequence_,pendingSequence_ % 2);
pendingTask_ = task;pendingSequence_ = sequence;pending_ = true;
}
__aicore__ inline void Prefetch(const TaskDesc& task,uint32_t bank){
WaitFlag<HardEvent::MTE1_MTE2>(l1Free_[bank]);
const uint32_t mpad =(task.validM + 15)/ 16 * 16;
const uint32_t npad =(task.validN + 31)/ 32 * 32;
Nd2NzParams a;
a.ndNum = 1;a.nValue = task.validM;a.dValue = k_;
a.srcNdMatrixStride = 0;a.srcDValue = k_;
a.dstNzC0Stride = mpad;a.dstNzNStride = 1;a.dstNzMatrixStride = 0;
DataCopy(a1_.Get<int8_t>()[bank * bm_ * kPad_],xGm_[static_cast<uint64_t>(task.row)* k_],a);
if(mpad > task.validM){
Fill<uint32_t>(a1_.Get<uint32_t>()[bank * bm_ * kPad_ / 4 + task.validM * 8],
{static_cast<uint16_t>(kPad_ / 32),static_cast<uint16_t>(mpad - task.validM),
static_cast<uint16_t>(task.validM),0u});
}
Nd2NzParams b;
b.ndNum = 1;b.nValue = k_;b.dValue = task.validN;
b.srcNdMatrixStride = 0;b.srcDValue = n_;
b.dstNzC0Stride = kPad_;b.dstNzNStride = 1;b.dstNzMatrixStride = 0;
DataCopy(b1_.Get<int8_t>()[bank * kPad_ * width_],
wGm_[static_cast<uint64_t>(task.expert)* k_ * n_ + task.col],b);
if(kPad_ > k_){
Fill<uint32_t>(b1_.Get<uint32_t>()[bank * kPad_ * width_ / 4 + k_ * 8],
{static_cast<uint16_t>(npad / 32),static_cast<uint16_t>(kPad_ - k_),
static_cast<uint16_t>(k_),0u});
}
SetFlag<HardEvent::MTE2_MTE1>(l1Ready_[bank]);
}
__aicore__ inline void ComputeTask(const TaskDesc& task,uint32_t sequence,uint32_t bank){
const uint32_t mpad =(task.validM + 15)/ 16 * 16;
const uint32_t npad =(task.validN + 31)/ 32 * 32;
WaitFlag<HardEvent::MTE2_MTE1>(l1Ready_[bank]);
if(!singleShot_)WaitFlag<HardEvent::M_MTE1>(abFree_);
LoadData2DParams ap;
ap.startIndex = 0;ap.repeatTimes = kPad_ / 32;ap.srcStride = mpad / 16;
ap.dstGap = 0;ap.ifTranspose = false;ap.sid = 0;ap.addrMode = 0;
for(uint32_t j = 0;j < mpad / 16;++j)
LoadData<int8_t>(a2_.Get<int8_t>()[j * 16 * kPad_],a1_.Get<int8_t>()[bank * bm_ * kPad_ + j * 512],ap);
LoadData2dTransposeParams bp;
bp.startIndex = 0;bp.repeatTimes = npad / 32;bp.srcStride = kPad_ / 32;
bp.dstGap = 1;bp.dstFracGap = 0;bp.addrMode = 0;
for(uint32_t i = 0;i < kPad_ / 32;++i)
LoadDataWithTranspose<int8_t>(b2_.Get<int8_t>()[i * 32 * npad],b1_.Get<int8_t>()[bank * kPad_ * width_ + i * 1024],bp);
SetFlag<HardEvent::MTE1_MTE2>(l1Free_[bank]);
SetFlag<HardEvent::MTE1_M>(abReady_);
WaitFlag<HardEvent::MTE1_M>(abReady_);
MmadParams mm;
mm.m = mpad;mm.n = npad;mm.k = kPad_;
mm.unitFlag = 3;mm.cmatrixSource = false;mm.cmatrixInitVal = true;
mm.isBias = false;mm.kDirectionAlign = false;
mm.fmOffset = 0;mm.enSsparse = false;
mm.enWinogradA = false;mm.enWinogradB = false;
Mmad<int32_t,int8_t,int8_t>(c_.Get<int32_t>(),a2_.Get<int8_t>(),b2_.Get<int8_t>(),mm);
if(!singleShot_)SetFlag<HardEvent::M_MTE1>(abFree_);
const uint32_t slot = sequence % slots_;
if(!singleShot_ && sequence >= slots_)CrossCoreWaitFlag<2>(FREE_BASE + slot);
FixpipeParamsV220 fp;
fp.nSize = npad;fp.mSize = mpad;
fp.srcStride = mpad;fp.dstStride = width_;
fp.quantPre = QuantMode_t::NoQuant;fp.deqScalar = 0;
fp.ndNum = 1;fp.srcNdStride = 0;fp.dstNdStride = 0;
fp.reluEn = false;fp.unitFlag = 3;fp.isChannelSplit = false;
const uint64_t offset =(static_cast<uint64_t>(producer_)* slots_ + slot)* bm_ * width_;
Fixpipe<int32_t,int32_t,CFG_ROW_MAJOR>(ringGm_[offset],c_.Get<int32_t>(),fp);
CrossCoreSetFlag<2,PIPE_FIX>(READY_BASE + slot);
}
__aicore__ inline void PostCompute(uint32_t produced){
if(pending_){
ComputeTask(pendingTask_,pendingSequence_,pendingSequence_ % 2);
pending_ = false;
}
if(produced != 0){
SetFlag<HardEvent::FIX_M>(cFree_);
WaitFlag<HardEvent::FIX_M>(cFree_);
}
if(!singleShot_){
for(uint32_t bank = 0;bank < 2;++bank)
WaitFlag<HardEvent::MTE1_MTE2>(l1Free_[bank]);
WaitFlag<HardEvent::M_MTE1>(abFree_);
const uint32_t first = produced > slots_ ? produced - slots_ : 0;
for(uint32_t sequence = first;sequence < produced;++sequence)
CrossCoreWaitFlag<2>(FREE_BASE + sequence % slots_);
}
PipeBarrier<PIPE_ALL>();
SetMMColumnMajor();
for(uint32_t bank = 0;bank < 2;++bank){
pipe_.ReleaseEventID<HardEvent::MTE2_MTE1>(l1Ready_[bank]);
pipe_.ReleaseEventID<HardEvent::MTE1_MTE2>(l1Free_[bank]);
}
pipe_.ReleaseEventID<HardEvent::MTE1_M>(abReady_);
pipe_.ReleaseEventID<HardEvent::FIX_M>(cFree_);
if(!singleShot_){
pipe_.ReleaseEventID<HardEvent::M_MTE1>(abFree_);
}
}
private:
TPipe& pipe_;
TBuf<TPosition::A1> a1_;
TBuf<TPosition::B1> b1_;
TBuf<TPosition::A2> a2_;
TBuf<TPosition::B2> b2_;
TBuf<TPosition::CO1> c_;
GlobalTensor<int8_t> xGm_,wGm_;
GlobalTensor<int32_t> ringGm_;
TEventID l1Ready_[2],l1Free_[2],abReady_,abFree_,cFree_;
uint32_t k_,n_,kPad_,producer_,bm_,width_,slots_;
bool singleShot_;
bool pending_ = false;
TaskDesc pendingTask_;
uint32_t pendingSequence_ = 0;
};
class SeparatedL1LookaheadProducer{
public:
__aicore__ inline SeparatedL1LookaheadProducer(TPipe& pipe): pipe_(pipe){}
__aicore__ inline void Init(GM_ADDR x,GM_ADDR weight,GM_ADDR ring,
uint32_t k,uint32_t n,uint32_t producer,uint32_t bm,uint32_t width,
bool singleShot){
xGm_.SetGlobalBuffer((__gm__ int8_t*)x);
wGm_.SetGlobalBuffer((__gm__ int8_t*)weight);
ringGm_.SetGlobalBuffer((__gm__ int32_t*)ring);
k_ = k;n_ = n;kPad_ =(k + 31)/ 32 * 32;
producer_ = producer;bm_ = bm;width_ = width;
singleShot_ = singleShot;slots_ = singleShot ? 1 : 4;
SetMMRowMajor();
pipe_.InitBuffer(a1_,L1_BANK_BYTES);
pipe_.InitBuffer(b1_,2 * kPad_ * width_);
pipe_.InitBuffer(a2_,bm_ * kPad_);
pipe_.InitBuffer(b2_,kPad_ * width_);
pipe_.InitBuffer(c_,bm_ * width_ * sizeof(int32_t));
for(uint32_t bank = 0;bank < 2;++bank){
l1Ready_[bank]= pipe_.AllocEventID<HardEvent::MTE2_MTE1>();
l1Free_[bank]= pipe_.AllocEventID<HardEvent::MTE1_MTE2>();
SetFlag<HardEvent::MTE1_MTE2>(l1Free_[bank]);
}
abReady_ = pipe_.AllocEventID<HardEvent::MTE1_M>();
cFree_ = pipe_.AllocEventID<HardEvent::FIX_M>();
if(!singleShot_){
abFree_ = pipe_.AllocEventID<HardEvent::M_MTE1>();
SetFlag<HardEvent::M_MTE1>(abFree_);
}
}
__aicore__ inline void BeginOwner(uint32_t,uint32_t){}
__aicore__ inline void Produce(const TaskDesc& task,uint32_t sequence,bool){
Prefetch(task,sequence % 2);
if(pending_)ComputeTask(pendingTask_,pendingSequence_,pendingSequence_ % 2);
pendingTask_ = task;pendingSequence_ = sequence;pending_ = true;
}
__aicore__ inline void Prefetch(const TaskDesc& task,uint32_t bank){
WaitFlag<HardEvent::MTE1_MTE2>(l1Free_[bank]);
const uint32_t mpad =(task.validM + 15)/ 16 * 16;
const uint32_t npad =(task.validN + 31)/ 32 * 32;
Nd2NzParams a;
a.ndNum = 1;a.nValue = task.validM;a.dValue = k_;
a.srcNdMatrixStride = 0;a.srcDValue = k_;
a.dstNzC0Stride = mpad;a.dstNzNStride = 1;a.dstNzMatrixStride = 0;
DataCopy(a1_.Get<int8_t>()[bank * bm_ * kPad_],xGm_[static_cast<uint64_t>(task.row)* k_],a);
if(mpad > task.validM){
Fill<uint32_t>(a1_.Get<uint32_t>()[bank * bm_ * kPad_ / 4 + task.validM * 8],
{static_cast<uint16_t>(kPad_ / 32),static_cast<uint16_t>(mpad - task.validM),
static_cast<uint16_t>(task.validM),0u});
}
Nd2NzParams b;
b.ndNum = 1;b.nValue = k_;b.dValue = task.validN;
b.srcNdMatrixStride = 0;b.srcDValue = n_;
b.dstNzC0Stride = kPad_;b.dstNzNStride = 1;b.dstNzMatrixStride = 0;
DataCopy(b1_.Get<int8_t>()[bank * kPad_ * width_],
wGm_[static_cast<uint64_t>(task.expert)* k_ * n_ + task.col],b);
if(kPad_ > k_){
Fill<uint32_t>(b1_.Get<uint32_t>()[bank * kPad_ * width_ / 4 + k_ * 8],
{static_cast<uint16_t>(npad / 32),static_cast<uint16_t>(kPad_ - k_),
static_cast<uint16_t>(k_),0u});
}
SetFlag<HardEvent::MTE2_MTE1>(l1Ready_[bank]);
}
__aicore__ inline void ComputeTask(const TaskDesc& task,uint32_t sequence,uint32_t bank){
const uint32_t mpad =(task.validM + 15)/ 16 * 16;
const uint32_t npad =(task.validN + 31)/ 32 * 32;
WaitFlag<HardEvent::MTE2_MTE1>(l1Ready_[bank]);
if(!singleShot_)WaitFlag<HardEvent::M_MTE1>(abFree_);
LoadData2DParams ap;
ap.startIndex = 0;ap.repeatTimes = kPad_ / 32;ap.srcStride = mpad / 16;
ap.dstGap = 0;ap.ifTranspose = false;ap.sid = 0;ap.addrMode = 0;
for(uint32_t j = 0;j < mpad / 16;++j)
LoadData<int8_t>(a2_.Get<int8_t>()[j * 16 * kPad_],a1_.Get<int8_t>()[bank * bm_ * kPad_ + j * 512],ap);
LoadData2dTransposeParams bp;
bp.startIndex = 0;bp.repeatTimes = npad / 32;bp.srcStride = kPad_ / 32;
bp.dstGap = 1;bp.dstFracGap = 0;bp.addrMode = 0;
for(uint32_t i = 0;i < kPad_ / 32;++i)
LoadDataWithTranspose<int8_t>(b2_.Get<int8_t>()[i * 32 * npad],b1_.Get<int8_t>()[bank * kPad_ * width_ + i * 1024],bp);
SetFlag<HardEvent::MTE1_MTE2>(l1Free_[bank]);
SetFlag<HardEvent::MTE1_M>(abReady_);
WaitFlag<HardEvent::MTE1_M>(abReady_);
MmadParams mm;
mm.m = mpad;mm.n = npad;mm.k = kPad_;
mm.unitFlag = 3;mm.cmatrixSource = false;mm.cmatrixInitVal = true;
mm.isBias = false;mm.kDirectionAlign = false;
mm.fmOffset = 0;mm.enSsparse = false;
mm.enWinogradA = false;mm.enWinogradB = false;
Mmad<int32_t,int8_t,int8_t>(c_.Get<int32_t>(),a2_.Get<int8_t>(),b2_.Get<int8_t>(),mm);
if(!singleShot_)SetFlag<HardEvent::M_MTE1>(abFree_);
const uint32_t slot = sequence % slots_;
if(!singleShot_ && sequence >= slots_)CrossCoreWaitFlag<2>(FREE_BASE + slot);
FixpipeParamsV220 fp;
fp.nSize = npad;fp.mSize = mpad;
fp.srcStride = mpad;fp.dstStride = width_;
fp.quantPre = QuantMode_t::NoQuant;fp.deqScalar = 0;
fp.ndNum = 1;fp.srcNdStride = 0;fp.dstNdStride = 0;
fp.reluEn = false;fp.unitFlag = 3;fp.isChannelSplit = false;
const uint64_t offset =(static_cast<uint64_t>(producer_)* slots_ + slot)* bm_ * width_;
Fixpipe<int32_t,int32_t,CFG_ROW_MAJOR>(ringGm_[offset],c_.Get<int32_t>(),fp);
CrossCoreSetFlag<2,PIPE_FIX>(READY_BASE + slot);
}
__aicore__ inline void PostCompute(uint32_t produced){
if(pending_){
ComputeTask(pendingTask_,pendingSequence_,pendingSequence_ % 2);
pending_ = false;
}
if(produced != 0){
SetFlag<HardEvent::FIX_M>(cFree_);
WaitFlag<HardEvent::FIX_M>(cFree_);
}
if(!singleShot_){
for(uint32_t bank = 0;bank < 2;++bank)
WaitFlag<HardEvent::MTE1_MTE2>(l1Free_[bank]);
WaitFlag<HardEvent::M_MTE1>(abFree_);
const uint32_t first = produced > slots_ ? produced - slots_ : 0;
for(uint32_t sequence = first;sequence < produced;++sequence)
CrossCoreWaitFlag<2>(FREE_BASE + sequence % slots_);
}
PipeBarrier<PIPE_ALL>();
SetMMColumnMajor();
for(uint32_t bank = 0;bank < 2;++bank){
pipe_.ReleaseEventID<HardEvent::MTE2_MTE1>(l1Ready_[bank]);
pipe_.ReleaseEventID<HardEvent::MTE1_MTE2>(l1Free_[bank]);
}
pipe_.ReleaseEventID<HardEvent::MTE1_M>(abReady_);
pipe_.ReleaseEventID<HardEvent::FIX_M>(cFree_);
if(!singleShot_){
pipe_.ReleaseEventID<HardEvent::M_MTE1>(abFree_);
}
}
private:
static constexpr uint32_t L1_BANK_BYTES = 262144;
TPipe& pipe_;
TBuf<TPosition::A1> a1_;
TBuf<TPosition::B1> b1_;
TBuf<TPosition::A2> a2_;
TBuf<TPosition::B2> b2_;
TBuf<TPosition::CO1> c_;
GlobalTensor<int8_t> xGm_,wGm_;
GlobalTensor<int32_t> ringGm_;
TEventID l1Ready_[2],l1Free_[2],abReady_,abFree_,cFree_;
uint32_t k_,n_,kPad_,producer_,bm_,width_,slots_;
bool singleShot_;
bool pending_ = false;
TaskDesc pendingTask_;
uint32_t pendingSequence_ = 0;
};
template<bool ENABLED> struct StreamTurnState{};
template<> struct StreamTurnState<true>{
bool turnOn_=false,reverseK_=false,bValid_[2]={false,false};
uint32_t bExpert_[2],bCol_[2],bQ_[2],bN_[2];
};
template <bool PARTIAL = false, bool RESIDENT_A = false, bool PADDED_A = false, bool BOOTSTRAP_B = false, bool SMALL_A3D = false, bool STREAM_TURN = false, bool FULL_B = false>
class MultiProducer : private StreamTurnState<STREAM_TURN || FULL_B> {
public:
	__aicore__ inline MultiProducer(TPipe &pipe)
			: pipe_(pipe) {}
	__aicore__ inline void Init(GM_ADDR x, GM_ADDR weight, GM_ADDR ring,
		uint32_t k, uint32_t n, uint32_t producerId, uint32_t bm, uint32_t width,
		uint32_t l0k, uint32_t bk, uint32_t mode, uint32_t fullK = 0) {
		xGm_.SetGlobalBuffer((__gm__ int8_t *)x);
		wGm_.SetGlobalBuffer((__gm__ int8_t *)weight);
		ringGm_.SetGlobalBuffer((__gm__ int32_t *)ring);
		constexpr uint32_t kAlignment = PADDED_A ? 256 : 32;
		k_ = k;
		kPad_ = (k + kAlignment - 1) / kAlignment * kAlignment;
		n_ = n;
		producerId_ = producerId;
		bk_ = bk;
		bm_ = bm;
		width_ = width;
		l0k_ = l0k;
		mode_ = mode;
		aPending_ = false;
		tcChunks_ = gmg_tc::ChunksOf(k_, bk_);
		tcNPad_ = gmg_tc::NPadOf(n_);
		if (PARTIAL) fullK_ = fullK;
		SetMMRowMajor();
		if (bm_ >= (SMALL_A3D ? 128 : 256)) {
			SetLoadDataRepeat({0, 1, 0});
			SetLoadDataPaddingValue(int8_t(0));
		}
		pipe_.InitBuffer(bA1_, mode_ == FULL_A ? bm_ * kPad_ : 2 * bm_ * bk_);
		pipe_.InitBuffer(bB1_, FULL_B ? kPad_ * width_ : 2 * bk_ * width_);
		pipe_.InitBuffer(bA2_, RESIDENT_A ? bm_ * kPad_ : 2 * bm_ * l0k_);
		pipe_.InitBuffer(bB2_, 2 * l0k_ * width_);
		pipe_.InitBuffer(bC_, bm_ * width_ * sizeof(int32_t));
		if (mode_ == FULL_A) {
			aReady_ = pipe_.AllocEventID<HardEvent::MTE2_MTE1>();
			aFree_ = pipe_.AllocEventID<HardEvent::MTE1_MTE2>();
			SetFlag<HardEvent::MTE1_MTE2>(aFree_);
		}
		for (uint32_t bank = 0; bank < 2; ++bank) {
			bReady_[bank] = pipe_.AllocEventID<HardEvent::MTE2_MTE1>();
			bFree_[bank] = pipe_.AllocEventID<HardEvent::MTE1_MTE2>();
			abReady_[bank] = pipe_.AllocEventID<HardEvent::MTE1_M>();
			abFree_[bank] = pipe_.AllocEventID<HardEvent::M_MTE1>();
			SetFlag<HardEvent::MTE1_MTE2>(bFree_[bank]);
			SetFlag<HardEvent::M_MTE1>(abFree_[bank]);
		}
		cFree_ = pipe_.AllocEventID<HardEvent::FIX_M>();
	}
	__aicore__ inline void SelectPartition(GM_ADDR x, GM_ADDR weight, uint32_t length) {
		xGm_.SetGlobalBuffer((__gm__ int8_t *)x);
		wGm_.SetGlobalBuffer((__gm__ int8_t *)weight);
		k_ = length;
		kPad_ = (length + 31) / 32 * 32;
		if constexpr (FULL_B) this->bValid_[0] = false;
	}
	__aicore__ inline void SetTranscode(GM_ADDR image, uint32_t on) {
		tcOn_ = (on != 0) && (mode_ == STREAM);
		nzGm_.SetGlobalBuffer((__gm__ int8_t *)image);
	}
	__aicore__ inline bool TranscodeOn() const { return tcOn_; }
	__aicore__ inline void EnableStreamTurns(bool on) {
		if constexpr (STREAM_TURN) this->turnOn_ = on;
	}
	__aicore__ inline void BeginOwner(uint32_t row, uint32_t validM) {
		if (mode_ != FULL_A) return;
		WaitFlag<HardEvent::MTE1_MTE2>(aFree_);
		const uint32_t mpad = (validM + 15) / 16 * 16;
		Nd2NzParams a;
		a.ndNum = 1;
		a.nValue = validM;
		a.dValue = PADDED_A ? kPad_ : k_;
		a.srcNdMatrixStride = 0;
		a.srcDValue = PARTIAL ? fullK_ : (PADDED_A ? kPad_ : k_);
		a.dstNzC0Stride = mpad;
		a.dstNzNStride = 1;
		a.dstNzMatrixStride = 0;
		DataCopy(bA1_.Get<int8_t>(), xGm_[static_cast<uint64_t>(row) * (PARTIAL ? fullK_ : (PADDED_A ? kPad_ : k_))], a);
		if (mpad > validM) {
			Fill<uint32_t>(bA1_.Get<uint32_t>()[validM * 8],
				{static_cast<uint16_t>(kPad_ / 32), static_cast<uint16_t>(mpad - validM),
					static_cast<uint16_t>(validM), 0u});
		}
		SetFlag<HardEvent::MTE2_MTE1>(aReady_);
		aPending_ = true;
	}
	__aicore__ inline void Prefetch(const TaskDesc &task, uint32_t q, uint32_t bank) {
		WaitFlag<HardEvent::MTE1_MTE2>(bFree_[bank]);
		const uint32_t remaining = k_ - q * bk_;
		const uint32_t qActual = remaining < bk_ ? remaining : bk_;
		const uint32_t qPadK = (qActual + 31) / 32 * 32;
		const uint32_t npad = (task.validN + 31) / 32 * 32;
		if (mode_ == STREAM) {
			const uint32_t mpad = (task.validM + 15) / 16 * 16;
			Nd2NzParams a;
			a.ndNum = 1;
			a.nValue = task.validM;
			a.dValue = qActual;
			a.srcNdMatrixStride = 0;
			a.srcDValue = PARTIAL ? fullK_ : k_;
			a.dstNzC0Stride = mpad;
			a.dstNzNStride = 1;
			a.dstNzMatrixStride = 0;
			DataCopy(bA1_.Get<int8_t>()[bank * bm_ * bk_],
				xGm_[static_cast<uint64_t>(task.row) * (PARTIAL ? fullK_ : k_) + static_cast<uint64_t>(q) * bk_], a);
			if (mpad > task.validM) {
				Fill<uint32_t>(bA1_.Get<uint32_t>()[bank * bm_ * bk_ / 4 + task.validM * 8],
					{static_cast<uint16_t>(qPadK / 32), static_cast<uint16_t>(mpad - task.validM),
						static_cast<uint16_t>(task.validM), 0u});
			}
		}
		if constexpr (FULL_B) {
			if (!this->turnOn_) {
				SetFlag<HardEvent::MTE2_MTE1>(bReady_[bank]);
				return;
			}
		}
		if constexpr (STREAM_TURN) {
			if (this->turnOn_ && this->bValid_[bank] && this->bExpert_[bank] == task.expert && this->bCol_[bank] == task.col && this->bN_[bank] == task.validN && this->bQ_[bank] == q) {
				SetFlag<HardEvent::MTE2_MTE1>(bReady_[bank]);
				return;
			}
		}
		if (tcOn_) {
			const uint32_t npadT = (task.validN + 31) / 32 * 32;
			const uint32_t qPadKt = (qActual + 31) / 32 * 32;
			const uint64_t base = static_cast<uint64_t>(task.expert) * tcChunks_ * bk_ * tcNPad_ + static_cast<uint64_t>(q) * bk_ * tcNPad_ + static_cast<uint64_t>(task.col) * qPadKt;
			DataCopy(bB1_.Get<int8_t>()[bank * bk_ * width_], nzGm_[base], qPadKt * npadT);
			if (qPadKt > qActual) {
				Fill<uint32_t>(bB1_.Get<uint32_t>()[bank * bk_ * width_ / 4 + qActual * 8],
					{static_cast<uint16_t>(npadT / 32), static_cast<uint16_t>(qPadKt - qActual),
						static_cast<uint16_t>(qActual), 0u});
			}
			SetFlag<HardEvent::MTE2_MTE1>(bReady_[bank]);
			return;
		}
		Nd2NzParams b;
		b.ndNum = 1;
		b.nValue = qActual;
		b.dValue = task.validN;
		b.srcNdMatrixStride = 0;
		b.srcDValue = n_;
		b.dstNzC0Stride = FULL_B ? kPad_ : qPadK;
		b.dstNzNStride = 1;
		b.dstNzMatrixStride = 0;
		auto destination = bB1_.Get<int8_t>()[FULL_B ? q * bk_ * 32 : bank * bk_ * width_];
		const uint64_t offset = static_cast<uint64_t>(task.expert) * (PARTIAL ? fullK_ : k_) * n_ + static_cast<uint64_t>(q) * bk_ * n_ + task.col;
		if (n_ == 32) {
			DataCopy(destination, wGm_[offset], {1, static_cast<uint16_t>(qActual), 0, 0});
		} else {
			DataCopy(destination, wGm_[offset], b);
		}
		if (qPadK > qActual) {
			Fill<uint32_t>(bB1_.Get<uint32_t>()[FULL_B ? (q * bk_ + qActual) * 8 : bank * bk_ * width_ / 4 + qActual * 8],
				{static_cast<uint16_t>(npad / 32), static_cast<uint16_t>(qPadK - qActual),
					static_cast<uint16_t>(FULL_B ? kPad_ - (qPadK - qActual) : qActual), 0u});
		}
		if constexpr (STREAM_TURN) {
			if (this->turnOn_) {
				this->bValid_[bank] = true;
				this->bExpert_[bank] = task.expert;
				this->bCol_[bank] = task.col;
				this->bN_[bank] = task.validN;
				this->bQ_[bank] = q;
			}
		}
		SetFlag<HardEvent::MTE2_MTE1>(bReady_[bank]);
	}
	__aicore__ inline void Produce(const TaskDesc &task, uint32_t sequence, bool lastInOwner) {
		if constexpr (FULL_B) {
			this->turnOn_ = !this->bValid_[0] || this->bExpert_[0] != task.expert || this->bCol_[0] != task.col || this->bQ_[0] != k_;
			this->bValid_[0] = true;
			this->bExpert_[0] = task.expert;
			this->bCol_[0] = task.col;
			this->bQ_[0] = k_;
		}
		const uint32_t ringSlot = sequence % SLOTS;
		const bool loadA = aPending_;
		const uint32_t mpad = (task.validM + 15) / 16 * 16;
		const uint8_t pad[4] = {0, 0, 0, 0};
		if (PADDED_A || mpad >= (SMALL_A3D ? 128 : 256)) SetFmatrix(1, static_cast<uint16_t>(mpad), pad, FmatrixMode::FMATRIX_LEFT);
		const uint32_t npad = (task.validN + 31) / 32 * 32;
		const uint32_t chunks = (k_ + bk_ - 1) / bk_;
		const uint32_t initial = chunks < 2 ? chunks : 2;
		bool reverse = false;
		if constexpr (STREAM_TURN) reverse = this->turnOn_ && this->reverseK_;
		if (!BOOTSTRAP_B || sequence != 0) {
			for (uint32_t i = 0; i < initial; ++i) {
				const uint32_t q = reverse ? chunks - 1 - i : i;
				Prefetch(task, q, q % 2);
			}
		}
		if (aPending_) {
			WaitFlag<HardEvent::MTE2_MTE1>(aReady_);
			aPending_ = false;
		}
		for (uint32_t step = 0; step < chunks; ++step) {
			const uint32_t q = reverse ? chunks - 1 - step : step;
			const uint32_t bBank = q % 2;
			const uint32_t remaining = k_ - q * bk_;
			const uint32_t qActual = remaining < bk_ ? remaining : bk_;
			WaitFlag<HardEvent::MTE2_MTE1>(bReady_[bBank]);
			const uint32_t qPadK = (qActual + 31) / 32 * 32;
			const uint32_t slices = (qActual + l0k_ - 1) / l0k_;
			for (uint32_t s = 0; s < slices; ++s) {
				const uint32_t remainingSlice = qActual - s * l0k_;
				const uint32_t validSlice = remainingSlice < l0k_ ? remainingSlice : l0k_;
				const uint32_t kPad = (validSlice + 31) / 32 * 32;
				const uint32_t globalKstart = q * bk_ + s * l0k_;
				const uint32_t abBank = (globalKstart / l0k_) % 2;
				WaitFlag<HardEvent::M_MTE1>(abFree_[abBank]);
				const uint32_t a2Offset = RESIDENT_A
																		? globalKstart * bm_
																		: abBank * bm_ * l0k_;
				const uint64_t aOffset = mode_ == FULL_A
																	 ? static_cast<uint64_t>(globalKstart) * mpad
																	 : static_cast<uint64_t>(bBank) * bm_ * bk_ + static_cast<uint64_t>(s) * l0k_ * mpad;
				if (!RESIDENT_A || loadA) {
					if (PADDED_A || mpad >= (SMALL_A3D ? 128 : 256)) {
						LoadData3DParamsV2<int8_t> ap;
						ap.l1H = 1;
						ap.l1W = mpad;
						ap.channelSize = kPad;
						ap.kExtension = kPad;
						ap.mExtension = mpad;
						LoadData<int8_t, kALoad3dConfig>(bA2_.Get<int8_t>()[a2Offset],
							bA1_.Get<int8_t>()[aOffset], ap);
					} else {
						LoadData2DParams ap;
						ap.startIndex = 0;
						ap.repeatTimes = kPad / 32;
						ap.srcStride = mpad / 16;
						ap.dstGap = 0;
						ap.ifTranspose = false;
						ap.sid = 0;
						ap.addrMode = 0;
						for (uint32_t j = 0; j < mpad / 16; ++j)
							LoadData<int8_t>(bA2_.Get<int8_t>()[a2Offset + j * 16 * kPad],
								bA1_.Get<int8_t>()[aOffset + j * 512], ap);
					}
				}
				LoadData2dTransposeParams bp;
				bp.startIndex = 0;
				bp.repeatTimes = npad / 32;
				bp.srcStride = (FULL_B ? kPad_ : qPadK) / 32;
				bp.dstGap = 1;
				bp.dstFracGap = 0;
				bp.addrMode = 0;
				for (uint32_t i = 0; i < kPad / 32; ++i)
					LoadDataWithTranspose<int8_t>(bB2_.Get<int8_t>()[abBank * l0k_ * width_ + i * 32 * npad],
						bB1_.Get<int8_t>()[(FULL_B ? q * bk_ * 32 : bBank * bk_ * width_) + s * l0k_ * 32 + i * 1024], bp);
				if (s + 1 == slices) SetFlag<HardEvent::MTE1_MTE2>(bFree_[bBank]);
				if (mode_ == FULL_A && lastInOwner && q + 1 == chunks && s + 1 == slices)
					SetFlag<HardEvent::MTE1_MTE2>(aFree_);
				SetFlag<HardEvent::MTE1_M>(abReady_[abBank]);
				WaitFlag<HardEvent::MTE1_M>(abReady_[abBank]);
				MmadParams mm;
				mm.m = mpad;
				mm.n = npad;
				mm.k = kPad;
				mm.unitFlag = (step + 1 == chunks && s + 1 == slices) ? 3 : 2;
				mm.cmatrixSource = false;
				mm.cmatrixInitVal = (step == 0 && s == 0);
				mm.isBias = false;
				mm.kDirectionAlign = false;
				mm.fmOffset = 0;
				mm.enSsparse = false;
				mm.enWinogradA = false;
				mm.enWinogradB = false;
				if ((step != 0 || s != 0) && (mpad / 16) * (npad / 16) < 10) PipeBarrier<PIPE_M>();
				Mmad<int32_t, int8_t, int8_t>(bC_.Get<int32_t>(),
					bA2_.Get<int8_t>()[a2Offset],
					bB2_.Get<int8_t>()[abBank * l0k_ * width_], mm);
				SetFlag<HardEvent::M_MTE1>(abFree_[abBank]);
			}
			if (reverse) {
				if (q >= 2) Prefetch(task, q - 2, bBank);
			} else if (q + 2 < chunks)
				Prefetch(task, q + 2, bBank);
		}
		if constexpr (STREAM_TURN) {
			if (this->turnOn_) this->reverseK_ = !this->reverseK_;
		}
		if (!PARTIAL && sequence >= SLOTS) CrossCoreWaitFlag<2>(FREE_BASE + ringSlot);
		FixpipeParamsV220 fp;
		fp.nSize = npad;
		fp.mSize = mpad;
		fp.srcStride = mpad;
		fp.dstStride = width_;
		fp.quantPre = QuantMode_t::NoQuant;
		fp.deqScalar = 0;
		fp.ndNum = 1;
		fp.srcNdStride = 0;
		fp.dstNdStride = 0;
		fp.reluEn = false;
		fp.unitFlag = 3;
		fp.isChannelSplit = false;
		const uint64_t slotBase = PARTIAL ? static_cast<uint64_t>(sequence) * bm_ * width_
																			: (static_cast<uint64_t>(producerId_) * SLOTS + ringSlot) * bm_ * width_;
		Fixpipe<int32_t, int32_t, CFG_ROW_MAJOR>(ringGm_[slotBase], bC_.Get<int32_t>(), fp);
		if (!PARTIAL) CrossCoreSetFlag<2, PIPE_FIX>(READY_BASE + ringSlot);
	}
	__aicore__ inline void PostCompute(uint32_t produced) {
		if (mode_ == FULL_A) WaitFlag<HardEvent::MTE1_MTE2>(aFree_);
		for (uint32_t bank = 0; bank < 2; ++bank) {
			WaitFlag<HardEvent::MTE1_MTE2>(bFree_[bank]);
			WaitFlag<HardEvent::M_MTE1>(abFree_[bank]);
		}
		if (produced != 0) {
			SetFlag<HardEvent::FIX_M>(cFree_);
			WaitFlag<HardEvent::FIX_M>(cFree_);
		}
		if (!PARTIAL) {
			const uint32_t first = produced > SLOTS ? produced - SLOTS : 0;
			for (uint32_t sequence = first; sequence < produced; ++sequence)
				CrossCoreWaitFlag<2>(FREE_BASE + sequence % SLOTS);
		}
		PipeBarrier<PIPE_ALL>();
		SetMMColumnMajor();
		if (mode_ == FULL_A) {
			pipe_.ReleaseEventID<HardEvent::MTE2_MTE1>(aReady_);
			pipe_.ReleaseEventID<HardEvent::MTE1_MTE2>(aFree_);
		}
		for (uint32_t bank = 0; bank < 2; ++bank) {
			pipe_.ReleaseEventID<HardEvent::MTE2_MTE1>(bReady_[bank]);
			pipe_.ReleaseEventID<HardEvent::MTE1_MTE2>(bFree_[bank]);
			pipe_.ReleaseEventID<HardEvent::MTE1_M>(abReady_[bank]);
			pipe_.ReleaseEventID<HardEvent::M_MTE1>(abFree_[bank]);
		}
		pipe_.ReleaseEventID<HardEvent::FIX_M>(cFree_);
	}

private:
	TPipe &pipe_;
	TBuf<TPosition::A1> bA1_;
	TBuf<TPosition::B1> bB1_;
	TBuf<TPosition::A2> bA2_;
	TBuf<TPosition::B2> bB2_;
	TBuf<TPosition::CO1> bC_;
	GlobalTensor<int8_t> xGm_, wGm_;
	GlobalTensor<int8_t> nzGm_;
	GlobalTensor<int32_t> ringGm_;
	TEventID aReady_, aFree_, bReady_[2], bFree_[2], abReady_[2], abFree_[2], cFree_;
	uint32_t k_, kPad_, n_, producerId_, bk_, bm_, width_, l0k_, mode_;
	union {
		uint32_t tcChunks_;
		uint32_t fullK_;
	};
	uint32_t tcNPad_;
	bool aPending_;
	bool tcOn_ = false;
};
template<bool PARTIAL = false,bool RESIDENT_A = false,bool PADDED_A = false,bool BOOTSTRAP_B = false,bool SMALL_A3D = false,bool FULL_B=false>
class RawAtomicProducer{
public:
__aicore__ inline RawAtomicProducer(TPipe& pipe): pipe_(pipe){}
__aicore__ inline void Init(GM_ADDR x,GM_ADDR weight,GM_ADDR ring,
uint32_t k,uint32_t n,uint32_t producerId,uint32_t bm,uint32_t width,
uint32_t l0k,uint32_t bk,uint32_t mode,uint32_t fullK = 0,bool resident=false){
xGm_.SetGlobalBuffer((__gm__ int8_t*)x);
wGm_.SetGlobalBuffer((__gm__ int8_t*)weight);
ringGm_.SetGlobalBuffer((__gm__ int32_t*)ring);
constexpr uint32_t kAlignment = PADDED_A ? 256 : 32;
k_ = k;kPad_ =(k + kAlignment - 1)/ kAlignment * kAlignment;
n_ = n;producerId_ = producerId;bk_ = bk;
bm_ = bm;width_ = width;l0k_ = l0k;mode_ = mode;aPending_ = false;
tcChunks_ = gmg_tc::ChunksOf(k_,bk_);
tcNPad_ = gmg_tc::NPadOf(n_);
if(PARTIAL)fullK_ = fullK;
if constexpr(FULL_B)resident_=resident;
SetMMRowMajor();
SetAtomicAdd<int32_t>();
if(bm_ >=(SMALL_A3D?128:256)){
SetLoadDataRepeat({0,1,0});
SetLoadDataPaddingValue(int8_t(0));
}
pipe_.InitBuffer(bA1_,mode_ == FULL_A ? bm_ * kPad_ : 2 * bm_ * bk_);
pipe_.InitBuffer(bB1_,FULL_B&&resident_?kPad_*width_:2*bk_*width_);
pipe_.InitBuffer(bA2_,RESIDENT_A ? bm_ * kPad_ : 2 * bm_ * l0k_);
pipe_.InitBuffer(bB2_,2 * l0k_ * width_);
pipe_.InitBuffer(bC_,bm_ * width_ * sizeof(int32_t));
if(mode_ == FULL_A){
aReady_ = pipe_.AllocEventID<HardEvent::MTE2_MTE1>();
aFree_ = pipe_.AllocEventID<HardEvent::MTE1_MTE2>();
SetFlag<HardEvent::MTE1_MTE2>(aFree_);
}
for(uint32_t bank = 0;bank < 2;++bank){
bReady_[bank]= pipe_.AllocEventID<HardEvent::MTE2_MTE1>();
bFree_[bank]= pipe_.AllocEventID<HardEvent::MTE1_MTE2>();
abReady_[bank]= pipe_.AllocEventID<HardEvent::MTE1_M>();
abFree_[bank]= pipe_.AllocEventID<HardEvent::M_MTE1>();
SetFlag<HardEvent::MTE1_MTE2>(bFree_[bank]);
SetFlag<HardEvent::M_MTE1>(abFree_[bank]);
}
cFree_ = pipe_.AllocEventID<HardEvent::FIX_M>();
}
__aicore__ inline void SelectPartition(GM_ADDR x,GM_ADDR weight,uint32_t length,uint32_t part=0){
if constexpr(FULL_B)part_=part;
xGm_.SetGlobalBuffer((__gm__ int8_t*)x);
wGm_.SetGlobalBuffer((__gm__ int8_t*)weight);
k_ = length;kPad_ =(length + 31)/ 32 * 32;
}
__aicore__ inline void SetTranscode(GM_ADDR image,uint32_t on){
tcOn_ =(on != 0)&&(mode_ == STREAM);
nzGm_.SetGlobalBuffer((__gm__ int8_t*)image);
}
__aicore__ inline bool TranscodeOn()const{return tcOn_;}
__aicore__ inline void BeginOwner(uint32_t row,uint32_t validM){
if(mode_ != FULL_A)return;
WaitFlag<HardEvent::MTE1_MTE2>(aFree_);
const uint32_t mpad =(validM + 15)/ 16 * 16;
Nd2NzParams a;
a.ndNum = 1;a.nValue = validM;a.dValue = PADDED_A ? kPad_ : k_;
a.srcNdMatrixStride = 0;a.srcDValue = PARTIAL ? fullK_ :(PADDED_A ? kPad_ : k_);
a.dstNzC0Stride = mpad;a.dstNzNStride = 1;a.dstNzMatrixStride = 0;
DataCopy(bA1_.Get<int8_t>(),xGm_[static_cast<uint64_t>(row)*(PARTIAL ? fullK_ :(PADDED_A ? kPad_ : k_))],a);
if(mpad > validM){
Fill<uint32_t>(bA1_.Get<uint32_t>()[validM * 8],
{static_cast<uint16_t>(kPad_ / 32),static_cast<uint16_t>(mpad - validM),
static_cast<uint16_t>(validM),0u});
}
SetFlag<HardEvent::MTE2_MTE1>(aReady_);
aPending_ = true;
}
__aicore__ inline void Prefetch(const TaskDesc& task,uint32_t q,uint32_t bank){
if(!FULL_B||!resident_)WaitFlag<HardEvent::MTE1_MTE2>(bFree_[bank]);
const uint32_t remaining = k_ - q * bk_;
const uint32_t qActual=remaining<bk_?remaining:bk_;
const uint32_t qPadK =(qActual + 31)/ 32 * 32;
const uint32_t npad =(task.validN + 31)/ 32 * 32;
if(mode_ == STREAM){
const uint32_t mpad =(task.validM + 15)/ 16 * 16;
Nd2NzParams a;
a.ndNum = 1;a.nValue = task.validM;a.dValue = qActual;
a.srcNdMatrixStride = 0;a.srcDValue = PARTIAL ? fullK_ : k_;
a.dstNzC0Stride = mpad;a.dstNzNStride = 1;a.dstNzMatrixStride = 0;
DataCopy(bA1_.Get<int8_t>()[bank * bm_ * bk_],
xGm_[static_cast<uint64_t>(task.row)*(PARTIAL ? fullK_ : k_)+ static_cast<uint64_t>(q)* bk_],a);
if(mpad > task.validM){
Fill<uint32_t>(bA1_.Get<uint32_t>()[bank * bm_ * bk_ / 4 + task.validM * 8],
{static_cast<uint16_t>(qPadK / 32),static_cast<uint16_t>(mpad - task.validM),
static_cast<uint16_t>(task.validM),0u});
}
}
if(tcOn_){
const uint32_t npadT =(task.validN + 31)/ 32 * 32;
const uint32_t qPadKt =(qActual + 31)/ 32 * 32;
const uint64_t base = static_cast<uint64_t>(task.expert)* tcChunks_ * bk_ * tcNPad_
+ static_cast<uint64_t>(q)* bk_ * tcNPad_
+ static_cast<uint64_t>(task.col)* qPadKt;
DataCopy(bB1_.Get<int8_t>()[bank * bk_ * width_],nzGm_[base],qPadKt * npadT);
if(qPadKt > qActual){
Fill<uint32_t>(bB1_.Get<uint32_t>()[bank * bk_ * width_ / 4 + qActual * 8],
{static_cast<uint16_t>(npadT / 32),static_cast<uint16_t>(qPadKt - qActual),
static_cast<uint16_t>(qActual),0u});
}
SetFlag<HardEvent::MTE2_MTE1>(bReady_[bank]);
return;
}
Nd2NzParams b;
b.ndNum = 1;b.nValue = qActual;b.dValue = task.validN;
b.srcNdMatrixStride = 0;b.srcDValue = n_;
b.dstNzC0Stride = FULL_B&&resident_?kPad_:qPadK;b.dstNzNStride = 1;b.dstNzMatrixStride = 0;
auto destination=bB1_.Get<int8_t>()[FULL_B&&resident_?q*bk_*32:bank*bk_*width_];
const uint64_t offset = static_cast<uint64_t>(task.expert)*(PARTIAL ? fullK_ : k_)* n_
+ static_cast<uint64_t>(q)* bk_ * n_ + task.col;
if(n_ == 32){
DataCopy(destination,wGm_[offset],{1,static_cast<uint16_t>(qActual),0,0});
}else{
DataCopy(destination,wGm_[offset],b);
}
if(qPadK > qActual){
Fill<uint32_t>(bB1_.Get<uint32_t>()[FULL_B&&resident_?(q*bk_+qActual)*8:bank*bk_*width_/4+qActual*8],
{static_cast<uint16_t>(npad / 32),static_cast<uint16_t>(qPadK - qActual),
static_cast<uint16_t>(FULL_B&&resident_?kPad_-(qPadK-qActual):qActual),0u});
}
SetFlag<HardEvent::MTE2_MTE1>(bReady_[bank]);
}
__aicore__ inline void Produce(const TaskDesc& task,uint32_t sequence,bool lastInOwner){
const uint32_t ringSlot = sequence % SLOTS;
const bool residentB=FULL_B&&resident_;bool fillB=true;
if constexpr(FULL_B){if(residentB){fillB=!cached_||expert_!=task.expert||col_!=task.col||cachedPart_!=part_;
if(fillB){WaitFlag<HardEvent::MTE1_MTE2>(bFree_[0]);cached_=true;expert_=task.expert;col_=task.col;cachedPart_=part_;}}}
const bool loadA = aPending_;
const uint32_t mpad =(task.validM + 15)/ 16 * 16;
const uint8_t pad[4]={0,0,0,0};
if(PADDED_A || mpad >=(SMALL_A3D?128:256))SetFmatrix(1,static_cast<uint16_t>(mpad),pad,FmatrixMode::FMATRIX_LEFT);
const uint32_t npad =(task.validN + 31)/ 32 * 32;
const uint32_t chunks=(k_+bk_-1)/bk_;
const uint32_t initial = chunks < 2 ? chunks : 2;
if(fillB&&(!BOOTSTRAP_B||sequence!=0)){
for(uint32_t q = 0;q < initial;++q)Prefetch(task,q,q);
}
if(aPending_){
WaitFlag<HardEvent::MTE2_MTE1>(aReady_);
aPending_ = false;
}
for(uint32_t q = 0;q < chunks;++q){
const uint32_t bBank = q % 2;
const uint32_t remaining = k_ - q * bk_;
const uint32_t qActual=remaining<bk_?remaining:bk_;
if(fillB)WaitFlag<HardEvent::MTE2_MTE1>(bReady_[bBank]);
const uint32_t qPadK =(qActual + 31)/ 32 * 32;
const uint32_t b1Packet=residentB?q*bk_*32:bBank*bk_*width_,b1Pitch=residentB?kPad_:qPadK;
const uint32_t slices =(qActual + l0k_ - 1)/ l0k_;
for(uint32_t s = 0;s < slices;++s){
const uint32_t remainingSlice = qActual - s * l0k_;
const uint32_t validSlice = remainingSlice < l0k_ ? remainingSlice : l0k_;
const uint32_t kPad =(validSlice + 31)/ 32 * 32;
const uint32_t globalKstart = q * bk_ + s * l0k_;
const uint32_t abBank =(globalKstart / l0k_)% 2;
WaitFlag<HardEvent::M_MTE1>(abFree_[abBank]);
const uint32_t a2Offset = RESIDENT_A
? globalKstart * bm_ : abBank * bm_ * l0k_;
const uint64_t aOffset = mode_ == FULL_A
? static_cast<uint64_t>(globalKstart)* mpad
: static_cast<uint64_t>(bBank)* bm_ * bk_ + static_cast<uint64_t>(s)* l0k_ * mpad;
if(!RESIDENT_A || loadA){
if(PADDED_A || mpad >=(SMALL_A3D?128:256)){
LoadData3DParamsV2<int8_t> ap;
ap.l1H = 1;ap.l1W = mpad;
ap.channelSize = kPad;ap.kExtension = kPad;ap.mExtension = mpad;
LoadData<int8_t,kALoad3dConfig>(bA2_.Get<int8_t>()[a2Offset],
bA1_.Get<int8_t>()[aOffset],ap);
}else{
LoadData2DParams ap;
ap.startIndex = 0;ap.repeatTimes = kPad / 32;ap.srcStride = mpad / 16;
ap.dstGap = 0;ap.ifTranspose = false;ap.sid = 0;ap.addrMode = 0;
for(uint32_t j = 0;j < mpad / 16;++j)
LoadData<int8_t>(bA2_.Get<int8_t>()[a2Offset + j * 16 * kPad],
bA1_.Get<int8_t>()[aOffset + j * 512],ap);
}
}
if(FULL_B&&residentB&&kPad>npad){
LoadData2dTransposeParams bp;
bp.startIndex=0;bp.repeatTimes=kPad/32;bp.srcStride=1;
bp.dstGap=npad/16-1;bp.dstFracGap=0;bp.addrMode=0;
for(uint32_t j=0;j<npad/32;++j)
LoadDataWithTranspose<int8_t>(bB2_.Get<int8_t>()[abBank*l0k_*width_+j*1024],
bB1_.Get<int8_t>()[b1Packet+s*l0k_*32+j*b1Pitch*32],bp);
}else{
LoadData2dTransposeParams bp;
bp.startIndex = 0;bp.repeatTimes = npad / 32;bp.srcStride = b1Pitch / 32;
bp.dstGap = 1;bp.dstFracGap = 0;bp.addrMode = 0;
for(uint32_t i = 0;i < kPad / 32;++i)
LoadDataWithTranspose<int8_t>(bB2_.Get<int8_t>()[abBank * l0k_ * width_ + i * 32 * npad],
bB1_.Get<int8_t>()[b1Packet+s*l0k_*32+i*1024],bp);
}
if(s+1==slices){if(residentB){if(lastInOwner&&q+1==chunks)SetFlag<HardEvent::MTE1_MTE2>(bFree_[0]);}else SetFlag<HardEvent::MTE1_MTE2>(bFree_[bBank]);}
if(mode_==FULL_A&&(lastInOwner||residentB)&&q+1==chunks&&s+1==slices)
SetFlag<HardEvent::MTE1_MTE2>(aFree_);
SetFlag<HardEvent::MTE1_M>(abReady_[abBank]);
WaitFlag<HardEvent::MTE1_M>(abReady_[abBank]);
MmadParams mm;
mm.m = mpad;mm.n = npad;mm.k = kPad;
mm.unitFlag =(q + 1 == chunks && s + 1 == slices)? 3 : 2;
mm.cmatrixSource = false;mm.cmatrixInitVal =(globalKstart == 0);
mm.isBias = false;mm.kDirectionAlign = false;
mm.fmOffset = 0;mm.enSsparse = false;
mm.enWinogradA = false;mm.enWinogradB = false;
if(globalKstart != 0 &&(mpad / 16)*(npad / 16)< 10)PipeBarrier<PIPE_M>();
Mmad<int32_t,int8_t,int8_t>(bC_.Get<int32_t>(),
bA2_.Get<int8_t>()[a2Offset],
bB2_.Get<int8_t>()[abBank * l0k_ * width_],mm);
SetFlag<HardEvent::M_MTE1>(abFree_[abBank]);
}
if(fillB&&q+2<chunks)Prefetch(task,q+2,bBank);
}
if(initializationPending_){
CrossCoreWaitFlag<2>(0);initializationPending_=false;
}
if(!PARTIAL && sequence >= SLOTS)CrossCoreWaitFlag<2>(FREE_BASE + ringSlot);
FixpipeParamsV220 fp;
fp.nSize = npad;fp.mSize = mpad;
fp.srcStride = mpad;fp.dstStride = width_;
fp.quantPre = QuantMode_t::NoQuant;fp.deqScalar = 0;
fp.ndNum = 1;fp.srcNdStride = 0;fp.dstNdStride = 0;
fp.reluEn = false;fp.unitFlag = 3;fp.isChannelSplit = false;
const uint64_t slotBase = PARTIAL ? static_cast<uint64_t>(sequence/4)* 4 * bm_ * width_
:(static_cast<uint64_t>(producerId_)* SLOTS + ringSlot)* bm_ * width_;
Fixpipe<int32_t,int32_t,CFG_ROW_MAJOR>(ringGm_[slotBase],bC_.Get<int32_t>(),fp);
if(!PARTIAL)CrossCoreSetFlag<2,PIPE_FIX>(READY_BASE + ringSlot);
}
__aicore__ inline void PostCompute(uint32_t produced){
if(initializationPending_){CrossCoreWaitFlag<2>(0);initializationPending_=false;}
if(mode_ == FULL_A)WaitFlag<HardEvent::MTE1_MTE2>(aFree_);
for(uint32_t bank = 0;bank < 2;++bank){
WaitFlag<HardEvent::MTE1_MTE2>(bFree_[bank]);
WaitFlag<HardEvent::M_MTE1>(abFree_[bank]);
}
if(produced != 0){
SetFlag<HardEvent::FIX_M>(cFree_);
WaitFlag<HardEvent::FIX_M>(cFree_);
}
if(!PARTIAL){
const uint32_t first = produced > SLOTS ? produced - SLOTS : 0;
for(uint32_t sequence = first;sequence < produced;++sequence)
CrossCoreWaitFlag<2>(FREE_BASE + sequence % SLOTS);
}
PipeBarrier<PIPE_ALL>();
DisableDmaAtomic();
SetMMColumnMajor();
if(mode_ == FULL_A){
pipe_.ReleaseEventID<HardEvent::MTE2_MTE1>(aReady_);
pipe_.ReleaseEventID<HardEvent::MTE1_MTE2>(aFree_);
}
for(uint32_t bank = 0;bank < 2;++bank){
pipe_.ReleaseEventID<HardEvent::MTE2_MTE1>(bReady_[bank]);
pipe_.ReleaseEventID<HardEvent::MTE1_MTE2>(bFree_[bank]);
pipe_.ReleaseEventID<HardEvent::MTE1_M>(abReady_[bank]);
pipe_.ReleaseEventID<HardEvent::M_MTE1>(abFree_[bank]);
}
pipe_.ReleaseEventID<HardEvent::FIX_M>(cFree_);
}
private:
TPipe& pipe_;
TBuf<TPosition::A1> bA1_;
TBuf<TPosition::B1> bB1_;
TBuf<TPosition::A2> bA2_;
TBuf<TPosition::B2> bB2_;
TBuf<TPosition::CO1> bC_;
GlobalTensor<int8_t> xGm_,wGm_;
GlobalTensor<int8_t> nzGm_;
GlobalTensor<int32_t> ringGm_;
TEventID aReady_,aFree_,bReady_[2],bFree_[2],abReady_[2],abFree_[2],cFree_;
uint32_t k_,kPad_,n_,producerId_,bk_,bm_,width_,l0k_,mode_;
union{uint32_t tcChunks_;uint32_t fullK_;};
uint32_t tcNPad_;
bool aPending_;
bool tcOn_ = false;
bool initializationPending_=true;
bool resident_=false,cached_=false;uint32_t part_,expert_,col_,cachedPart_;
};
template<bool PARTIAL = false,bool RESIDENT_A = false,bool PADDED_A = false,bool BOOTSTRAP_B = false,bool PAIR_N = false>
class TwoGroupColumnPrefetchProducer{
public:
__aicore__ inline TwoGroupColumnPrefetchProducer(TPipe& pipe): pipe_(pipe){}
__aicore__ inline void Init(GM_ADDR x,GM_ADDR weight,GM_ADDR ring,
uint32_t k,uint32_t n,uint32_t producerId,uint32_t bm,uint32_t width,
uint32_t l0k,uint32_t bk,uint32_t mode,uint32_t fullK = 0){
xGm_.SetGlobalBuffer((__gm__ int8_t*)x);
wGm_.SetGlobalBuffer((__gm__ int8_t*)weight);
ringGm_.SetGlobalBuffer((__gm__ int32_t*)ring);
constexpr uint32_t kAlignment = PADDED_A ? 256 : 32;
k_ = k;kPad_ =(k + kAlignment - 1)/ kAlignment * kAlignment;
n_ = n;producerId_ = producerId;bk_ = bk;
bm_ = bm;width_ = width;l0k_ = l0k;aPending_ = false;
if(PARTIAL)fullK_ = fullK;
SetMMRowMajor();
if(bm_ >= 256){
SetLoadDataRepeat({0,1,0});
SetLoadDataPaddingValue(int8_t(0));
}
pipe_.InitBuffer(bA1_,bm_ * kPad_);
const uint32_t packetBytes = bk_ * width_ *(PAIR_N ? 2 : 1);
const uint32_t aBytes = bm_ * kPad_;
bBankStride_ = packetBytes;
if(aBytes <= 65536 && packetBytes <=(PAIR_N ? 131072 : 65536))
bBankStride_ =(1u << 18)- aBytes;
pipe_.InitBuffer(bB1_,bBankStride_ + packetBytes);
pipe_.InitBuffer(bA2_,RESIDENT_A ? bm_ * kPad_ : 2 * bm_ * l0k_);
pipe_.InitBuffer(bB2_,2 * l0k_ * width_);
pipe_.InitBuffer(bC_,(PAIR_N ? 2 : 1)* bm_ * width_ * sizeof(int32_t));

aReady_ = pipe_.AllocEventID<HardEvent::MTE2_MTE1>();
aFree_ = pipe_.AllocEventID<HardEvent::MTE1_MTE2>();
SetFlag<HardEvent::MTE1_MTE2>(aFree_);

for(uint32_t bank = 0;bank < 2;++bank){
bReady_[bank]= pipe_.AllocEventID<HardEvent::MTE2_MTE1>();
bFree_[bank]= pipe_.AllocEventID<HardEvent::MTE1_MTE2>();
abReady_[bank]= pipe_.AllocEventID<HardEvent::MTE1_M>();
abFree_[bank]= pipe_.AllocEventID<HardEvent::M_MTE1>();
SetFlag<HardEvent::MTE1_MTE2>(bFree_[bank]);
SetFlag<HardEvent::M_MTE1>(abFree_[bank]);
}
cFree_ = pipe_.AllocEventID<HardEvent::FIX_M>();
}
__aicore__ inline void SelectPartition(GM_ADDR x,GM_ADDR weight,uint32_t length){
xGm_.SetGlobalBuffer((__gm__ int8_t*)x);
wGm_.SetGlobalBuffer((__gm__ int8_t*)weight);
k_ = length;kPad_ =(length + 31)/ 32 * 32;
}


__aicore__ inline void BeginOwner(uint32_t row,uint32_t validM){
WaitFlag<HardEvent::MTE1_MTE2>(aFree_);
const uint32_t mpad =(validM + 15)/ 16 * 16;
Nd2NzParams a;
a.ndNum = 1;a.nValue = validM;a.dValue = PADDED_A ? kPad_ : k_;
a.srcNdMatrixStride = 0;a.srcDValue = PARTIAL ? fullK_ :(PADDED_A ? kPad_ : k_);
a.dstNzC0Stride = mpad;a.dstNzNStride = 1;a.dstNzMatrixStride = 0;
DataCopy(bA1_.Get<int8_t>(),xGm_[static_cast<uint64_t>(row)*(PARTIAL ? fullK_ :(PADDED_A ? kPad_ : k_))],a);
if(mpad > validM){
Fill<uint32_t>(bA1_.Get<uint32_t>()[validM * 8],
{static_cast<uint16_t>(kPad_ / 32),static_cast<uint16_t>(mpad - validM),
static_cast<uint16_t>(validM),0u});
}
SetFlag<HardEvent::MTE2_MTE1>(aReady_);
aPending_ = true;
}
__aicore__ inline void Prefetch(const TaskDesc& task,uint32_t q,uint32_t bank){
WaitFlag<HardEvent::MTE1_MTE2>(bFree_[bank]);
const uint32_t remaining = k_ - q * bk_;
const uint32_t qActual = remaining < bk_ ? remaining : bk_;
const uint32_t qPadK =(qActual + 31)/ 32 * 32;
const uint32_t npad =(task.validN + 31)/ 32 * 32;


Nd2NzParams b;
b.ndNum = 1;b.nValue = qActual;b.dValue = task.validN;
b.srcNdMatrixStride = 0;b.srcDValue = n_;
b.dstNzC0Stride = qPadK;b.dstNzNStride = 1;b.dstNzMatrixStride = 0;
DataCopy(bB1_.Get<int8_t>()[bank * bBankStride_],
wGm_[static_cast<uint64_t>(task.expert)*(PARTIAL ? fullK_ : k_)* n_
+ static_cast<uint64_t>(q)* bk_ * n_ + task.col],b);
if(qPadK > qActual){
Fill<uint32_t>(bB1_.Get<uint32_t>()[bank * bBankStride_ / 4 + qActual * 8],
{static_cast<uint16_t>(npad / 32),static_cast<uint16_t>(qPadK - qActual),
static_cast<uint16_t>(qActual),0u});
}
SetFlag<HardEvent::MTE2_MTE1>(bReady_[bank]);
}
__aicore__ inline void Produce(const TaskDesc& task,uint32_t sequence,bool lastInOwner){
if constexpr(!PAIR_N){
ProduceSingle(task,sequence,lastInOwner);
}else{
if(pairPending_){
ProducePair(pairTask_,task,sequence - 1,lastInOwner);
pairPending_ = false;
}else if(!lastInOwner){
pairTask_ = task;
pairPending_ = true;
}else{
ProduceSingle(task,sequence,true);
}
}
}
__aicore__ inline void ProduceSingle(const TaskDesc& task,uint32_t sequence,bool lastInOwner){
const uint32_t ringSlot = sequence % SLOTS;
const bool loadA = aPending_;
const uint32_t mpad =(task.validM + 15)/ 16 * 16;
const uint8_t pad[4]={0,0,0,0};
if(PADDED_A || mpad >= 256)SetFmatrix(1,static_cast<uint16_t>(mpad),pad,FmatrixMode::FMATRIX_LEFT);
const uint32_t npad =(task.validN + 31)/ 32 * 32;
const uint32_t chunks =(k_ + bk_ - 1)/ bk_;
const uint32_t initial = chunks < 2 ? chunks : 2;
if(!BOOTSTRAP_B || sequence != 0){
for(uint32_t q = prefetched_;q < initial;++q)Prefetch(task,q,q);
}
prefetched_ = 0;
if(aPending_){
WaitFlag<HardEvent::MTE2_MTE1>(aReady_);
aPending_ = false;
}
for(uint32_t q = 0;q < chunks;++q){
const uint32_t bBank = q % 2;
const uint32_t remaining = k_ - q * bk_;
const uint32_t qActual = remaining < bk_ ? remaining : bk_;
WaitFlag<HardEvent::MTE2_MTE1>(bReady_[bBank]);
const uint32_t qPadK =(qActual + 31)/ 32 * 32;
const uint32_t slices =(qActual + l0k_ - 1)/ l0k_;
for(uint32_t s = 0;s < slices;++s){
const uint32_t remainingSlice = qActual - s * l0k_;
const uint32_t validSlice = remainingSlice < l0k_ ? remainingSlice : l0k_;
const uint32_t kPad =(validSlice + 31)/ 32 * 32;
const uint32_t globalKstart = q * bk_ + s * l0k_;
const uint32_t abBank =(globalKstart / l0k_)% 2;
WaitFlag<HardEvent::M_MTE1>(abFree_[abBank]);
const uint32_t a2Offset = RESIDENT_A
? globalKstart * bm_ : abBank * bm_ * l0k_;
const uint64_t aOffset = static_cast<uint64_t>(globalKstart)* mpad;
if(!RESIDENT_A || loadA){
if(PADDED_A || mpad >= 256){
LoadData3DParamsV2<int8_t> ap;
ap.l1H = 1;ap.l1W = mpad;
ap.channelSize = kPad;ap.kExtension = kPad;ap.mExtension = mpad;
LoadData<int8_t,kALoad3dConfig>(bA2_.Get<int8_t>()[a2Offset],
bA1_.Get<int8_t>()[aOffset],ap);
}else{
LoadData2DParams ap;
ap.startIndex = 0;ap.repeatTimes = kPad / 32;ap.srcStride = mpad / 16;
ap.dstGap = 0;ap.ifTranspose = false;ap.sid = 0;ap.addrMode = 0;
for(uint32_t j = 0;j < mpad / 16;++j)
LoadData<int8_t>(bA2_.Get<int8_t>()[a2Offset + j * 16 * kPad],
bA1_.Get<int8_t>()[aOffset + j * 512],ap);
}
}
LoadData2dTransposeParams bp;
bp.startIndex = 0;bp.repeatTimes = npad / 32;bp.srcStride = qPadK / 32;
bp.dstGap = 1;bp.dstFracGap = 0;bp.addrMode = 0;
for(uint32_t i = 0;i < kPad / 32;++i)
LoadDataWithTranspose<int8_t>(bB2_.Get<int8_t>()[abBank * l0k_ * width_ + i * 32 * npad],
bB1_.Get<int8_t>()[bBank * bBankStride_ + s * l0k_ * 32 + i * 1024],bp);
if(s + 1 == slices)SetFlag<HardEvent::MTE1_MTE2>(bFree_[bBank]);
if(lastInOwner && q + 1 == chunks && s + 1 == slices)
SetFlag<HardEvent::MTE1_MTE2>(aFree_);
SetFlag<HardEvent::MTE1_M>(abReady_[abBank]);
WaitFlag<HardEvent::MTE1_M>(abReady_[abBank]);
MmadParams mm;
mm.m = mpad;mm.n = npad;mm.k = kPad;
mm.unitFlag =(q + 1 == chunks && s + 1 == slices)? 3 : 2;
mm.cmatrixSource = false;mm.cmatrixInitVal =(globalKstart == 0);
mm.isBias = false;mm.kDirectionAlign = false;
mm.fmOffset = 0;mm.enSsparse = false;
mm.enWinogradA = false;mm.enWinogradB = false;
if(globalKstart != 0 &&(mpad / 16)*(npad / 16)< 10)PipeBarrier<PIPE_M>();
Mmad<int32_t,int8_t,int8_t>(bC_.Get<int32_t>(),
bA2_.Get<int8_t>()[a2Offset],
bB2_.Get<int8_t>()[abBank * l0k_ * width_],mm);
SetFlag<HardEvent::M_MTE1>(abFree_[abBank]);
}
if(q + 2 < chunks){
Prefetch(task,q + 2,bBank);
}else if(!lastInOwner && chunks <= 2){
const uint32_t nextCol = task.col + width_;
const uint32_t nextN = n_ - nextCol < width_ ? n_ - nextCol : width_;
const TaskDesc nextTask ={task.expert,task.row,nextCol,task.validM,nextN};
Prefetch(nextTask,q,bBank);
++prefetched_;
}
}
if(!PARTIAL && sequence >= SLOTS)CrossCoreWaitFlag<2>(FREE_BASE + ringSlot);
FixpipeParamsV220 fp;
fp.nSize = npad;fp.mSize = mpad;
fp.srcStride = mpad;fp.dstStride = width_;
fp.quantPre = QuantMode_t::NoQuant;fp.deqScalar = 0;
fp.ndNum = 1;fp.srcNdStride = 0;fp.dstNdStride = 0;
fp.reluEn = false;fp.unitFlag = 3;fp.isChannelSplit = false;
const uint64_t slotBase = PARTIAL ? static_cast<uint64_t>(sequence)* bm_ * width_
:(static_cast<uint64_t>(producerId_)* SLOTS + ringSlot)* bm_ * width_;
Fixpipe<int32_t,int32_t,CFG_ROW_MAJOR>(ringGm_[slotBase],bC_.Get<int32_t>(),fp);
if(!PARTIAL)CrossCoreSetFlag<2,PIPE_FIX>(READY_BASE + ringSlot);
}
__aicore__ inline void ProducePair(const TaskDesc& task,const TaskDesc& second,uint32_t firstSequence,bool lastInOwner){
const TaskDesc wideTask ={task.expert,task.row,task.col,task.validM,task.validN + second.validN};
const bool loadA = aPending_;
const uint32_t mpad =(task.validM + 15)/ 16 * 16;
const uint8_t pad[4]={0,0,0,0};
if(PADDED_A || mpad >= 256)SetFmatrix(1,static_cast<uint16_t>(mpad),pad,FmatrixMode::FMATRIX_LEFT);
const uint32_t chunks =(k_ + bk_ - 1)/ bk_;
const uint32_t initial = chunks < 2 ? chunks : 2;
for(uint32_t q = 0;q < initial;++q)Prefetch(wideTask,q,q);
if(aPending_){
WaitFlag<HardEvent::MTE2_MTE1>(aReady_);
aPending_ = false;
}
for(uint32_t q = 0;q < chunks;++q){
const uint32_t bBank = q % 2;
const uint32_t remaining = k_ - q * bk_;
const uint32_t qActual = remaining < bk_ ? remaining : bk_;
WaitFlag<HardEvent::MTE2_MTE1>(bReady_[bBank]);
const uint32_t qPadK =(qActual + 31)/ 32 * 32;
const uint32_t slices =(qActual + l0k_ - 1)/ l0k_;
for(uint32_t s = 0;s < slices;++s){
const uint32_t remainingSlice = qActual - s * l0k_;
const uint32_t validSlice = remainingSlice < l0k_ ? remainingSlice : l0k_;
const uint32_t kPad =(validSlice + 31)/ 32 * 32;
const uint32_t globalKstart = q * bk_ + s * l0k_;
for(uint32_t column = 0;column < 2;++column){
const uint32_t npad =((column == 0 ? task.validN : second.validN)+ 31)/ 32 * 32;
const uint32_t abBank =((globalKstart / l0k_)* 2 + column)% 2;
WaitFlag<HardEvent::M_MTE1>(abFree_[abBank]);
const uint32_t a2Offset = RESIDENT_A
? globalKstart * bm_ : abBank * bm_ * l0k_;
const uint64_t aOffset = static_cast<uint64_t>(globalKstart)* mpad;
if(column == 0 &&(!RESIDENT_A || loadA)){
if(PADDED_A || mpad >= 256){
LoadData3DParamsV2<int8_t> ap;
ap.l1H = 1;ap.l1W = mpad;
ap.channelSize = kPad;ap.kExtension = kPad;ap.mExtension = mpad;
LoadData<int8_t,kALoad3dConfig>(bA2_.Get<int8_t>()[a2Offset],
bA1_.Get<int8_t>()[aOffset],ap);
}else{
LoadData2DParams ap;
ap.startIndex = 0;ap.repeatTimes = kPad / 32;ap.srcStride = mpad / 16;
ap.dstGap = 0;ap.ifTranspose = false;ap.sid = 0;ap.addrMode = 0;
for(uint32_t j = 0;j < mpad / 16;++j)
LoadData<int8_t>(bA2_.Get<int8_t>()[a2Offset + j * 16 * kPad],
bA1_.Get<int8_t>()[aOffset + j * 512],ap);
}
}
LoadData2dTransposeParams bp;
bp.startIndex = 0;bp.repeatTimes = npad / 32;bp.srcStride = qPadK / 32;
bp.dstGap = 1;bp.dstFracGap = 0;bp.addrMode = 0;
for(uint32_t i = 0;i < kPad / 32;++i)
LoadDataWithTranspose<int8_t>(bB2_.Get<int8_t>()[abBank * l0k_ * width_ + i * 32 * npad],
bB1_.Get<int8_t>()[bBank * bBankStride_ + column * width_ * qPadK + s * l0k_ * 32 + i * 1024],bp);
if(column == 1 && s + 1 == slices)SetFlag<HardEvent::MTE1_MTE2>(bFree_[bBank]);
if(column == 1 && lastInOwner && q + 1 == chunks && s + 1 == slices)
SetFlag<HardEvent::MTE1_MTE2>(aFree_);
SetFlag<HardEvent::MTE1_M>(abReady_[abBank]);
WaitFlag<HardEvent::MTE1_M>(abReady_[abBank]);
MmadParams mm;
mm.m = mpad;mm.n = npad;mm.k = kPad;
mm.unitFlag =(q + 1 == chunks && s + 1 == slices)? 3 : 2;
mm.cmatrixSource = false;mm.cmatrixInitVal =(globalKstart == 0);
mm.isBias = false;mm.kDirectionAlign = false;
mm.fmOffset = 0;mm.enSsparse = false;
mm.enWinogradA = false;mm.enWinogradB = false;
if(globalKstart != 0 &&(mpad / 16)*(npad / 16)< 10)PipeBarrier<PIPE_M>();
Mmad<int32_t,int8_t,int8_t>(bC_.Get<int32_t>()[column * bm_ * width_],
bA2_.Get<int8_t>()[a2Offset],
bB2_.Get<int8_t>()[abBank * l0k_ * width_],mm);
SetFlag<HardEvent::M_MTE1>(abFree_[abBank]);
if(column == 0 && q + 1 == chunks && s + 1 == slices)
PublishPairColumn(firstSequence,0,mpad,npad);
}
}
if(q + 2 < chunks)Prefetch(wideTask,q + 2,bBank);
else if(!lastInOwner && chunks <= 2 && n_ -(second.col + width_)<= width_){
const uint32_t nextCol = second.col + width_;
const TaskDesc nextTask ={task.expert,task.row,nextCol,task.validM,n_ - nextCol};
Prefetch(nextTask,q,bBank);
++prefetched_;
}
}
PublishPairColumn(firstSequence,1,mpad,(second.validN + 31)/ 32 * 32);
}
__aicore__ inline void PublishPairColumn(uint32_t firstSequence,uint32_t column,uint32_t mpad,uint32_t npad){
const uint32_t sequence = firstSequence + column,ringSlot = sequence % SLOTS;
if(!PARTIAL && sequence >= SLOTS)CrossCoreWaitFlag<2>(FREE_BASE + ringSlot);
FixpipeParamsV220 fp;
fp.nSize = npad;fp.mSize = mpad;
fp.srcStride = mpad;fp.dstStride = width_;
fp.quantPre = QuantMode_t::NoQuant;fp.deqScalar = 0;
fp.ndNum = 1;fp.srcNdStride = 0;fp.dstNdStride = 0;
fp.reluEn = false;fp.unitFlag = 3;fp.isChannelSplit = false;
const uint64_t slotBase = PARTIAL ? static_cast<uint64_t>(sequence)* bm_ * width_
:(static_cast<uint64_t>(producerId_)* SLOTS + ringSlot)* bm_ * width_;
Fixpipe<int32_t,int32_t,CFG_ROW_MAJOR>(ringGm_[slotBase],bC_.Get<int32_t>()[column * bm_ * width_],fp);
if(!PARTIAL)CrossCoreSetFlag<2,PIPE_FIX>(READY_BASE + ringSlot);
}
__aicore__ inline void PostCompute(uint32_t produced){
WaitFlag<HardEvent::MTE1_MTE2>(aFree_);
for(uint32_t bank = 0;bank < 2;++bank){
WaitFlag<HardEvent::MTE1_MTE2>(bFree_[bank]);
WaitFlag<HardEvent::M_MTE1>(abFree_[bank]);
}
if(produced != 0){
SetFlag<HardEvent::FIX_M>(cFree_);
WaitFlag<HardEvent::FIX_M>(cFree_);
}
if(!PARTIAL){
const uint32_t first = produced > SLOTS ? produced - SLOTS : 0;
for(uint32_t sequence = first;sequence < produced;++sequence)
CrossCoreWaitFlag<2>(FREE_BASE + sequence % SLOTS);
}
PipeBarrier<PIPE_ALL>();
SetMMColumnMajor();

pipe_.ReleaseEventID<HardEvent::MTE2_MTE1>(aReady_);
pipe_.ReleaseEventID<HardEvent::MTE1_MTE2>(aFree_);

for(uint32_t bank = 0;bank < 2;++bank){
pipe_.ReleaseEventID<HardEvent::MTE2_MTE1>(bReady_[bank]);
pipe_.ReleaseEventID<HardEvent::MTE1_MTE2>(bFree_[bank]);
pipe_.ReleaseEventID<HardEvent::MTE1_M>(abReady_[bank]);
pipe_.ReleaseEventID<HardEvent::M_MTE1>(abFree_[bank]);
}
pipe_.ReleaseEventID<HardEvent::FIX_M>(cFree_);
}
private:
TPipe& pipe_;
TBuf<TPosition::A1> bA1_;
TBuf<TPosition::B1> bB1_;
TBuf<TPosition::A2> bA2_;
TBuf<TPosition::B2> bB2_;
TBuf<TPosition::CO1> bC_;
GlobalTensor<int8_t> xGm_,wGm_;
GlobalTensor<int32_t> ringGm_;
TEventID aReady_,aFree_,bReady_[2],bFree_[2],abReady_[2],abFree_[2],cFree_;
uint32_t k_,kPad_,n_,producerId_,bk_,bm_,width_,l0k_;
uint32_t fullK_;
bool aPending_;
uint32_t prefetched_ = 0;
uint32_t bBankStride_ = 0;
bool pairPending_ = false;
TaskDesc pairTask_;
};
template<bool PARTIAL = false,bool RESIDENT_A = false,bool PADDED_A = false,bool PREFETCH_N = true,bool GROUP_B = false>
class CyclicResidentWeightProducer{
public:
__aicore__ inline CyclicResidentWeightProducer(TPipe& pipe): pipe_(pipe){}
__aicore__ inline void Init(GM_ADDR x,GM_ADDR weight,GM_ADDR ring,
uint32_t k,uint32_t n,uint32_t producerId,uint32_t bm,uint32_t width,
uint32_t l0k,uint32_t bk,uint32_t mode,uint32_t fullK = 0){
xGm_.SetGlobalBuffer((__gm__ int8_t*)x);
wGm_.SetGlobalBuffer((__gm__ int8_t*)weight);
ringGm_.SetGlobalBuffer((__gm__ int32_t*)ring);
constexpr uint32_t kAlignment = PADDED_A ? 256 : 32;
k_ = k;kPad_ =(k + kAlignment - 1)/ kAlignment * kAlignment;
n_ = n;producerId_ = producerId;bk_ = bk;
bm_ = bm;width_ = width;l0k_ = l0k;mode_ = mode;aPending_ = false;
if(PARTIAL)fullK_ = fullK;
SetMMRowMajor();
if(bm_ >= 256){
SetLoadDataRepeat({0,1,0});
SetLoadDataPaddingValue(int8_t(0));
}
pipe_.InitBuffer(bA1_,bm_ * kPad_);
pipe_.InitBuffer(bB1_,4 * bk_ * width_);
pipe_.InitBuffer(bA2_,RESIDENT_A ? bm_ * kPad_ : 2 * bm_ * l0k_);
pipe_.InitBuffer(bB2_,2 * l0k_ * width_);
pipe_.InitBuffer(bC_,bm_ * width_ * sizeof(int32_t));

aReady_ = pipe_.AllocEventID<HardEvent::MTE2_MTE1>();
aFree_ = pipe_.AllocEventID<HardEvent::MTE1_MTE2>();
SetFlag<HardEvent::MTE1_MTE2>(aFree_);

for(uint32_t bank = 0;bank < 4;++bank){
bReady_[bank]= pipe_.AllocEventID<HardEvent::MTE2_MTE1>();
bFree_[bank]= pipe_.AllocEventID<HardEvent::MTE1_MTE2>();
SetFlag<HardEvent::MTE1_MTE2>(bFree_[bank]);
}
for(uint32_t bank = 0;bank < 2;++bank){
abReady_[bank]= pipe_.AllocEventID<HardEvent::MTE1_M>();
abFree_[bank]= pipe_.AllocEventID<HardEvent::M_MTE1>();
SetFlag<HardEvent::M_MTE1>(abFree_[bank]);
}
cFree_ = pipe_.AllocEventID<HardEvent::FIX_M>();
}
__aicore__ inline void EnableResidentB(){
if constexpr(GROUP_B){residentB_=true;bk_=kPad_;}
}
__aicore__ inline void SelectPartition(GM_ADDR x,GM_ADDR weight,uint32_t length){
xGm_.SetGlobalBuffer((__gm__ int8_t*)x);
wGm_.SetGlobalBuffer((__gm__ int8_t*)weight);
k_ = length;kPad_ =(length + 31)/ 32 * 32;
}


__aicore__ inline void BeginOwner(uint32_t row,uint32_t validM){
WaitFlag<HardEvent::MTE1_MTE2>(aFree_);
const uint32_t mpad =(validM + 15)/ 16 * 16;
Nd2NzParams a;
a.ndNum = 1;a.nValue = validM;a.dValue = PADDED_A ? kPad_ : k_;
a.srcNdMatrixStride = 0;a.srcDValue = PARTIAL ? fullK_ :(PADDED_A ? kPad_ : k_);
a.dstNzC0Stride = mpad;a.dstNzNStride = 1;a.dstNzMatrixStride = 0;
DataCopy(bA1_.Get<int8_t>(),xGm_[static_cast<uint64_t>(row)*(PARTIAL ? fullK_ :(PADDED_A ? kPad_ : k_))],a);
if(mpad > validM){
Fill<uint32_t>(bA1_.Get<uint32_t>()[validM * 8],
{static_cast<uint16_t>(kPad_ / 32),static_cast<uint16_t>(mpad - validM),
static_cast<uint16_t>(validM),0u});
}
SetFlag<HardEvent::MTE2_MTE1>(aReady_);
aPending_ = true;
}
__aicore__ inline void Prefetch(const TaskDesc& task,uint32_t q,uint32_t bank){
WaitFlag<HardEvent::MTE1_MTE2>(bFree_[bank]);
if constexpr(GROUP_B){
if(residentB_ && cachedB_ && cachedExpert_==task.expert && cachedCol_==task.col){
SetFlag<HardEvent::MTE2_MTE1>(bReady_[bank]);return;
}
}
const uint32_t remaining = k_ - q * bk_;
const uint32_t qActual = remaining < bk_ ? remaining : bk_;
const uint32_t qPadK =(qActual + 31)/ 32 * 32;
const uint32_t npad =(task.validN + 31)/ 32 * 32;


Nd2NzParams b;
b.ndNum = 1;b.nValue = qActual;b.dValue = task.validN;
b.srcNdMatrixStride = 0;b.srcDValue = n_;
b.dstNzC0Stride = qPadK;b.dstNzNStride = 1;b.dstNzMatrixStride = 0;
DataCopy(bB1_.Get<int8_t>()[bank * bk_ * width_],
wGm_[static_cast<uint64_t>(task.expert)*(PARTIAL ? fullK_ : k_)* n_
+ static_cast<uint64_t>(q)* bk_ * n_ + task.col],b);
if(qPadK > qActual){
Fill<uint32_t>(bB1_.Get<uint32_t>()[bank * bk_ * width_ / 4 + qActual * 8],
{static_cast<uint16_t>(npad / 32),static_cast<uint16_t>(qPadK - qActual),
static_cast<uint16_t>(qActual),0u});
}
if constexpr(GROUP_B){
if(residentB_){cachedB_=true;cachedExpert_=task.expert;cachedCol_=task.col;}
}
SetFlag<HardEvent::MTE2_MTE1>(bReady_[bank]);
}
__aicore__ inline void Produce(const TaskDesc& task,uint32_t sequence,bool lastInOwner){
const uint32_t ringSlot = sequence % SLOTS;
const bool loadA = aPending_;
const uint32_t mpad =(task.validM + 15)/ 16 * 16;
const uint8_t pad[4]={0,0,0,0};
if(PADDED_A || mpad >= 256)SetFmatrix(1,static_cast<uint16_t>(mpad),pad,FmatrixMode::FMATRIX_LEFT);
const uint32_t npad =(task.validN + 31)/ 32 * 32;
const uint32_t chunks =(k_ + bk_ - 1)/ bk_;
const uint32_t initial = chunks < 4 ? chunks : 4;
for(uint32_t q = prefetched_;q < initial;++q)Prefetch(task,q,q);
prefetched_ = 0;
if(aPending_){
WaitFlag<HardEvent::MTE2_MTE1>(aReady_);
aPending_ = false;
}
for(uint32_t q = 0;q < chunks;++q){
const uint32_t bBank = q % 4;
const uint32_t remaining = k_ - q * bk_;
const uint32_t qActual = remaining < bk_ ? remaining : bk_;
WaitFlag<HardEvent::MTE2_MTE1>(bReady_[bBank]);
const uint32_t qPadK =(qActual + 31)/ 32 * 32;
const uint32_t slices =(qActual + l0k_ - 1)/ l0k_;
for(uint32_t s = 0;s < slices;++s){
const uint32_t remainingSlice = qActual - s * l0k_;
const uint32_t validSlice = remainingSlice < l0k_ ? remainingSlice : l0k_;
const uint32_t kPad =(validSlice + 31)/ 32 * 32;
const uint32_t globalKstart = q * bk_ + s * l0k_;
const uint32_t abBank =(globalKstart / l0k_)% 2;
WaitFlag<HardEvent::M_MTE1>(abFree_[abBank]);
const uint32_t a2Offset = RESIDENT_A
? globalKstart * bm_ : abBank * bm_ * l0k_;
const uint64_t aOffset = static_cast<uint64_t>(globalKstart)* mpad;
if(!RESIDENT_A || loadA){
if(PADDED_A || mpad >= 256){
LoadData3DParamsV2<int8_t> ap;
ap.l1H = 1;ap.l1W = mpad;
ap.channelSize = kPad;ap.kExtension = kPad;ap.mExtension = mpad;
LoadData<int8_t,kALoad3dConfig>(bA2_.Get<int8_t>()[a2Offset],
bA1_.Get<int8_t>()[aOffset],ap);
}else{
LoadData2DParams ap;
ap.startIndex = 0;ap.repeatTimes = kPad / 32;ap.srcStride = mpad / 16;
ap.dstGap = 0;ap.ifTranspose = false;ap.sid = 0;ap.addrMode = 0;
for(uint32_t j = 0;j < mpad / 16;++j)
LoadData<int8_t>(bA2_.Get<int8_t>()[a2Offset + j * 16 * kPad],
bA1_.Get<int8_t>()[aOffset + j * 512],ap);
}
}
LoadData2dTransposeParams bp;
bp.startIndex = 0;bp.repeatTimes = npad / 32;bp.srcStride = qPadK / 32;
bp.dstGap = 1;bp.dstFracGap = 0;bp.addrMode = 0;
for(uint32_t i = 0;i < kPad / 32;++i)
LoadDataWithTranspose<int8_t>(bB2_.Get<int8_t>()[abBank * l0k_ * width_ + i * 32 * npad],
bB1_.Get<int8_t>()[bBank * bk_ * width_ + s * l0k_ * 32 + i * 1024],bp);
if(s + 1 == slices)SetFlag<HardEvent::MTE1_MTE2>(bFree_[bBank]);
if(lastInOwner && q + 1 == chunks && s + 1 == slices)
SetFlag<HardEvent::MTE1_MTE2>(aFree_);
SetFlag<HardEvent::MTE1_M>(abReady_[abBank]);
WaitFlag<HardEvent::MTE1_M>(abReady_[abBank]);
MmadParams mm;
mm.m = mpad;mm.n = npad;mm.k = kPad;
mm.unitFlag =(q + 1 == chunks && s + 1 == slices)? 3 : 2;
mm.cmatrixSource = false;mm.cmatrixInitVal =(globalKstart == 0);
mm.isBias = false;mm.kDirectionAlign = false;
mm.fmOffset = 0;mm.enSsparse = false;
mm.enWinogradA = false;mm.enWinogradB = false;
if(globalKstart != 0 &&(mpad / 16)*(npad / 16)< 10)PipeBarrier<PIPE_M>();
Mmad<int32_t,int8_t,int8_t>(bC_.Get<int32_t>(),
bA2_.Get<int8_t>()[a2Offset],
bB2_.Get<int8_t>()[abBank * l0k_ * width_],mm);
SetFlag<HardEvent::M_MTE1>(abFree_[abBank]);
}
if(q + 4 < chunks){
Prefetch(task,q + 4,bBank);
}else if constexpr(PREFETCH_N){
if(!lastInOwner && chunks <= 4){
const uint32_t nextCol = task.col + width_;
const uint32_t nextN = n_ - nextCol < width_ ? n_ - nextCol : width_;
const TaskDesc nextTask ={task.expert,task.row,nextCol,task.validM,nextN};
Prefetch(nextTask,q,bBank);
++prefetched_;
}
}
}
if(!PARTIAL && sequence >= SLOTS)CrossCoreWaitFlag<2>(FREE_BASE + ringSlot);
FixpipeParamsV220 fp;
fp.nSize = npad;fp.mSize = mpad;
fp.srcStride = mpad;fp.dstStride = width_;
fp.quantPre = QuantMode_t::NoQuant;fp.deqScalar = 0;
fp.ndNum = 1;fp.srcNdStride = 0;fp.dstNdStride = 0;
fp.reluEn = false;fp.unitFlag = 3;fp.isChannelSplit = false;
const uint64_t slotBase = PARTIAL ? static_cast<uint64_t>(sequence)* bm_ * width_
:(static_cast<uint64_t>(producerId_)* SLOTS + ringSlot)* bm_ * width_;
Fixpipe<int32_t,int32_t,CFG_ROW_MAJOR>(ringGm_[slotBase],bC_.Get<int32_t>(),fp);
if(!PARTIAL)CrossCoreSetFlag<2,PIPE_FIX>(READY_BASE + ringSlot);
}
__aicore__ inline void PostCompute(uint32_t produced){
WaitFlag<HardEvent::MTE1_MTE2>(aFree_);
for(uint32_t bank = 0;bank < 4;++bank)
WaitFlag<HardEvent::MTE1_MTE2>(bFree_[bank]);
for(uint32_t bank = 0;bank < 2;++bank)
WaitFlag<HardEvent::M_MTE1>(abFree_[bank]);
if(produced != 0){
SetFlag<HardEvent::FIX_M>(cFree_);
WaitFlag<HardEvent::FIX_M>(cFree_);
}
if(!PARTIAL){
const uint32_t first = produced > SLOTS ? produced - SLOTS : 0;
for(uint32_t sequence = first;sequence < produced;++sequence)
CrossCoreWaitFlag<2>(FREE_BASE + sequence % SLOTS);
}
PipeBarrier<PIPE_ALL>();
SetMMColumnMajor();

pipe_.ReleaseEventID<HardEvent::MTE2_MTE1>(aReady_);
pipe_.ReleaseEventID<HardEvent::MTE1_MTE2>(aFree_);

for(uint32_t bank = 0;bank < 4;++bank){
pipe_.ReleaseEventID<HardEvent::MTE2_MTE1>(bReady_[bank]);
pipe_.ReleaseEventID<HardEvent::MTE1_MTE2>(bFree_[bank]);
}
for(uint32_t bank = 0;bank < 2;++bank){
pipe_.ReleaseEventID<HardEvent::MTE1_M>(abReady_[bank]);
pipe_.ReleaseEventID<HardEvent::M_MTE1>(abFree_[bank]);
}
pipe_.ReleaseEventID<HardEvent::FIX_M>(cFree_);
}
private:
TPipe& pipe_;
TBuf<TPosition::A1> bA1_;
TBuf<TPosition::B1> bB1_;
TBuf<TPosition::A2> bA2_;
TBuf<TPosition::B2> bB2_;
TBuf<TPosition::CO1> bC_;
GlobalTensor<int8_t> xGm_,wGm_;
GlobalTensor<int32_t> ringGm_;
TEventID aReady_,aFree_,bReady_[4],bFree_[4],abReady_[2],abFree_[2],cFree_;
uint32_t prefetched_ = 0;
uint32_t k_,kPad_,n_,producerId_,bk_,bm_,width_,l0k_,mode_;
uint32_t fullK_;
bool aPending_;
bool residentB_=false,cachedB_=false;
uint32_t cachedExpert_=0,cachedCol_=0;
};
template<bool PARTIAL = false,bool RESIDENT_A = false,bool PADDED_A = false,bool PREFETCH_N = true>
class BankCyclicResidentProducer{
public:
__aicore__ inline BankCyclicResidentProducer(TPipe& pipe): pipe_(pipe){}
__aicore__ inline void Init(GM_ADDR x,GM_ADDR weight,GM_ADDR ring,
uint32_t k,uint32_t n,uint32_t producerId,uint32_t bm,uint32_t width,
uint32_t l0k,uint32_t bk,uint32_t mode,uint32_t fullK = 0){
xGm_.SetGlobalBuffer((__gm__ int8_t*)x);
wGm_.SetGlobalBuffer((__gm__ int8_t*)weight);
ringGm_.SetGlobalBuffer((__gm__ int32_t*)ring);
constexpr uint32_t kAlignment = PADDED_A ? 256 : 32;
k_ = k;kPad_ =(k + kAlignment - 1)/ kAlignment * kAlignment;
n_ = n;producerId_ = producerId;bk_ = bk;
bm_ = bm;width_ = width;l0k_ = l0k;mode_ = mode;aPending_ = false;
if(PARTIAL)fullK_ = fullK;
SetMMRowMajor();
if(bm_ >= 256){
SetLoadDataRepeat({0,1,0});
SetLoadDataPaddingValue(int8_t(0));
}
pipe_.InitBuffer(bA1_,bm_ * kPad_);
constexpr uint32_t physicalBankBytes = 1u << 18;
const uint32_t packetBytes = bk_ * width_;
const uint32_t aBytes = bm_ * kPad_;
const bool paddedCycle = 4 * packetBytes == physicalBankBytes && aBytes <= physicalBankBytes / 2;
bankCycle_ = paddedCycle || aBytes + 2 * packetBytes == physicalBankBytes;
if(paddedCycle && aBytes < physicalBankBytes / 2)
pipe_.InitBuffer(bankGap_,physicalBankBytes / 2 - aBytes);
pipe_.InitBuffer(bB1_,4 * bk_ * width_);
pipe_.InitBuffer(bA2_,RESIDENT_A ? bm_ * kPad_ : 2 * bm_ * l0k_);
pipe_.InitBuffer(bB2_,2 * l0k_ * width_);
pipe_.InitBuffer(bC_,bm_ * width_ * sizeof(int32_t));

aReady_ = pipe_.AllocEventID<HardEvent::MTE2_MTE1>();
aFree_ = pipe_.AllocEventID<HardEvent::MTE1_MTE2>();
SetFlag<HardEvent::MTE1_MTE2>(aFree_);

for(uint32_t bank = 0;bank < 4;++bank){
bReady_[bank]= pipe_.AllocEventID<HardEvent::MTE2_MTE1>();
bFree_[bank]= pipe_.AllocEventID<HardEvent::MTE1_MTE2>();
SetFlag<HardEvent::MTE1_MTE2>(bFree_[bank]);
}
for(uint32_t bank = 0;bank < 2;++bank){
abReady_[bank]= pipe_.AllocEventID<HardEvent::MTE1_M>();
abFree_[bank]= pipe_.AllocEventID<HardEvent::M_MTE1>();
SetFlag<HardEvent::M_MTE1>(abFree_[bank]);
}
cFree_ = pipe_.AllocEventID<HardEvent::FIX_M>();
}
__aicore__ inline void SelectPartition(GM_ADDR x,GM_ADDR weight,uint32_t length){
xGm_.SetGlobalBuffer((__gm__ int8_t*)x);
wGm_.SetGlobalBuffer((__gm__ int8_t*)weight);
k_ = length;kPad_ =(length + 31)/ 32 * 32;
}


__aicore__ inline void BeginOwner(uint32_t row,uint32_t validM){
WaitFlag<HardEvent::MTE1_MTE2>(aFree_);
const uint32_t mpad =(validM + 15)/ 16 * 16;
Nd2NzParams a;
a.ndNum = 1;a.nValue = validM;a.dValue = PADDED_A ? kPad_ : k_;
a.srcNdMatrixStride = 0;a.srcDValue = PARTIAL ? fullK_ :(PADDED_A ? kPad_ : k_);
a.dstNzC0Stride = mpad;a.dstNzNStride = 1;a.dstNzMatrixStride = 0;
DataCopy(bA1_.Get<int8_t>(),xGm_[static_cast<uint64_t>(row)*(PARTIAL ? fullK_ :(PADDED_A ? kPad_ : k_))],a);
if(mpad > validM){
Fill<uint32_t>(bA1_.Get<uint32_t>()[validM * 8],
{static_cast<uint16_t>(kPad_ / 32),static_cast<uint16_t>(mpad - validM),
static_cast<uint16_t>(validM),0u});
}
SetFlag<HardEvent::MTE2_MTE1>(aReady_);
aPending_ = true;
}
__aicore__ inline void Prefetch(const TaskDesc& task,uint32_t q,uint32_t bank){
WaitFlag<HardEvent::MTE1_MTE2>(bFree_[bank]);
const uint32_t remaining = k_ - q * bk_;
const uint32_t qActual = remaining < bk_ ? remaining : bk_;
const uint32_t qPadK =(qActual + 31)/ 32 * 32;
const uint32_t npad =(task.validN + 31)/ 32 * 32;


Nd2NzParams b;
b.ndNum = 1;b.nValue = qActual;b.dValue = task.validN;
b.srcNdMatrixStride = 0;b.srcDValue = n_;
b.dstNzC0Stride = qPadK;b.dstNzNStride = 1;b.dstNzMatrixStride = 0;
if((n_&511)==256&&(qActual&1)==0){
b.ndNum=2;b.nValue=qActual/2;b.srcNdMatrixStride=n_;b.srcDValue=2*n_;
b.dstNzNStride=2;b.dstNzMatrixStride=32;
}
DataCopy(bB1_.Get<int8_t>()[BSlotOffset(bank)],
wGm_[static_cast<uint64_t>(task.expert)*(PARTIAL ? fullK_ : k_)* n_
+ static_cast<uint64_t>(q)* bk_ * n_ + task.col],b);
if(qPadK > qActual){
Fill<uint32_t>(bB1_.Get<uint32_t>()[BSlotOffset(bank)/ 4 + qActual * 8],
{static_cast<uint16_t>(npad / 32),static_cast<uint16_t>(qPadK - qActual),
static_cast<uint16_t>(qActual),0u});
}
SetFlag<HardEvent::MTE2_MTE1>(bReady_[bank]);
}
__aicore__ inline void Produce(const TaskDesc& task,uint32_t sequence,bool lastInOwner){
const uint32_t ringSlot = sequence % SLOTS;
const bool loadA = aPending_;
const uint32_t mpad =(task.validM + 15)/ 16 * 16;
const uint8_t pad[4]={0,0,0,0};
if(PADDED_A || mpad >= 256)SetFmatrix(1,static_cast<uint16_t>(mpad),pad,FmatrixMode::FMATRIX_LEFT);
const uint32_t npad =(task.validN + 31)/ 32 * 32;
const uint32_t chunks =(k_ + bk_ - 1)/ bk_;
const uint32_t initial = chunks < 4 ? chunks : 4;
for(uint32_t q = prefetched_;q < initial;++q)Prefetch(task,q,(weightBase_ + q)& 3);
prefetched_ = 0;
if(aPending_){
WaitFlag<HardEvent::MTE2_MTE1>(aReady_);
aPending_ = false;
}
for(uint32_t q = 0;q < chunks;++q){
const uint32_t bBank =(weightBase_ + q)& 3;
const uint32_t remaining = k_ - q * bk_;
const uint32_t qActual = remaining < bk_ ? remaining : bk_;
WaitFlag<HardEvent::MTE2_MTE1>(bReady_[bBank]);
const uint32_t qPadK =(qActual + 31)/ 32 * 32;
const uint32_t slices =(qActual + l0k_ - 1)/ l0k_;
for(uint32_t s = 0;s < slices;++s){
const uint32_t remainingSlice = qActual - s * l0k_;
const uint32_t validSlice = remainingSlice < l0k_ ? remainingSlice : l0k_;
const uint32_t kPad =(validSlice + 31)/ 32 * 32;
const uint32_t globalKstart = q * bk_ + s * l0k_;
const uint32_t abBank =(globalKstart / l0k_)% 2;
WaitFlag<HardEvent::M_MTE1>(abFree_[abBank]);
const uint32_t a2Offset = RESIDENT_A
? globalKstart * bm_ : abBank * bm_ * l0k_;
const uint64_t aOffset = static_cast<uint64_t>(globalKstart)* mpad;
if(!RESIDENT_A || loadA){
if(PADDED_A || mpad >= 256){
LoadData3DParamsV2<int8_t> ap;
ap.l1H = 1;ap.l1W = mpad;
ap.channelSize = kPad;ap.kExtension = kPad;ap.mExtension = mpad;
LoadData<int8_t,kALoad3dConfig>(bA2_.Get<int8_t>()[a2Offset],
bA1_.Get<int8_t>()[aOffset],ap);
}else{
LoadData2DParams ap;
ap.startIndex = 0;ap.repeatTimes = kPad / 32;ap.srcStride = mpad / 16;
ap.dstGap = 0;ap.ifTranspose = false;ap.sid = 0;ap.addrMode = 0;
for(uint32_t j = 0;j < mpad / 16;++j)
LoadData<int8_t>(bA2_.Get<int8_t>()[a2Offset + j * 16 * kPad],
bA1_.Get<int8_t>()[aOffset + j * 512],ap);
}
}
LoadData2dTransposeParams bp;
bp.startIndex = 0;bp.repeatTimes = npad / 32;bp.srcStride = qPadK / 32;
bp.dstGap = 1;bp.dstFracGap = 0;bp.addrMode = 0;
for(uint32_t i = 0;i < kPad / 32;++i)
LoadDataWithTranspose<int8_t>(bB2_.Get<int8_t>()[abBank * l0k_ * width_ + i * 32 * npad],
bB1_.Get<int8_t>()[BSlotOffset(bBank)+ s * l0k_ * 32 + i * 1024],bp);
if(s + 1 == slices)SetFlag<HardEvent::MTE1_MTE2>(bFree_[bBank]);
if(lastInOwner && q + 1 == chunks && s + 1 == slices)
SetFlag<HardEvent::MTE1_MTE2>(aFree_);
SetFlag<HardEvent::MTE1_M>(abReady_[abBank]);
WaitFlag<HardEvent::MTE1_M>(abReady_[abBank]);
MmadParams mm;
mm.m = mpad;mm.n = npad;mm.k = kPad;
mm.unitFlag =(q + 1 == chunks && s + 1 == slices)? 3 : 2;
mm.cmatrixSource = false;mm.cmatrixInitVal =(globalKstart == 0);
mm.isBias = false;mm.kDirectionAlign = false;
mm.fmOffset = 0;mm.enSsparse = false;
mm.enWinogradA = false;mm.enWinogradB = false;
if(globalKstart != 0 &&(mpad / 16)*(npad / 16)< 10)PipeBarrier<PIPE_M>();
Mmad<int32_t,int8_t,int8_t>(bC_.Get<int32_t>(),
bA2_.Get<int8_t>()[a2Offset],
bB2_.Get<int8_t>()[abBank * l0k_ * width_],mm);
SetFlag<HardEvent::M_MTE1>(abFree_[abBank]);
}
if(q + 4 < chunks){
Prefetch(task,q + 4,bBank);
}else if constexpr(PREFETCH_N){
if(!lastInOwner){
const uint32_t nextCol = task.col + width_;
const uint32_t nextN = n_ - nextCol < width_ ? n_ - nextCol : width_;
const TaskDesc nextTask ={task.expert,task.row,nextCol,task.validM,nextN};
Prefetch(nextTask,q + initial - chunks,bBank);
++prefetched_;
}
}
}
weightBase_ = lastInOwner || chunks < 4 ? 0 : weightBase_ + chunks;
if(!PARTIAL && sequence >= SLOTS)CrossCoreWaitFlag<2>(FREE_BASE + ringSlot);
FixpipeParamsV220 fp;
fp.nSize = npad;fp.mSize = mpad;
fp.srcStride = mpad;fp.dstStride = width_;
fp.quantPre = QuantMode_t::NoQuant;fp.deqScalar = 0;
fp.ndNum = 1;fp.srcNdStride = 0;fp.dstNdStride = 0;
fp.reluEn = false;fp.unitFlag = 3;fp.isChannelSplit = false;
const uint64_t slotBase = PARTIAL ? static_cast<uint64_t>(sequence)* bm_ * width_
:(static_cast<uint64_t>(producerId_)* SLOTS + ringSlot)* bm_ * width_;
Fixpipe<int32_t,int32_t,CFG_ROW_MAJOR>(ringGm_[slotBase],bC_.Get<int32_t>(),fp);
if(!PARTIAL)CrossCoreSetFlag<2,PIPE_FIX>(READY_BASE + ringSlot);
}
__aicore__ inline void PostCompute(uint32_t produced){
WaitFlag<HardEvent::MTE1_MTE2>(aFree_);
for(uint32_t bank = 0;bank < 4;++bank)
WaitFlag<HardEvent::MTE1_MTE2>(bFree_[bank]);
for(uint32_t bank = 0;bank < 2;++bank)
WaitFlag<HardEvent::M_MTE1>(abFree_[bank]);
if(produced != 0){
SetFlag<HardEvent::FIX_M>(cFree_);
WaitFlag<HardEvent::FIX_M>(cFree_);
}
if(!PARTIAL){
const uint32_t first = produced > SLOTS ? produced - SLOTS : 0;
for(uint32_t sequence = first;sequence < produced;++sequence)
CrossCoreWaitFlag<2>(FREE_BASE + sequence % SLOTS);
}
PipeBarrier<PIPE_ALL>();
SetMMColumnMajor();

pipe_.ReleaseEventID<HardEvent::MTE2_MTE1>(aReady_);
pipe_.ReleaseEventID<HardEvent::MTE1_MTE2>(aFree_);

for(uint32_t bank = 0;bank < 4;++bank){
pipe_.ReleaseEventID<HardEvent::MTE2_MTE1>(bReady_[bank]);
pipe_.ReleaseEventID<HardEvent::MTE1_MTE2>(bFree_[bank]);
}
for(uint32_t bank = 0;bank < 2;++bank){
pipe_.ReleaseEventID<HardEvent::MTE1_M>(abReady_[bank]);
pipe_.ReleaseEventID<HardEvent::M_MTE1>(abFree_[bank]);
}
pipe_.ReleaseEventID<HardEvent::FIX_M>(cFree_);
}
private:
__aicore__ inline uint32_t BSlotOffset(uint32_t bank)const{
const uint32_t physical = bankCycle_ ?(bank % 2)* 2 + bank / 2 : bank;
return physical * bk_ * width_;
}
TBuf<TPosition::A1> bankGap_;
bool bankCycle_ = false;
TPipe& pipe_;
TBuf<TPosition::A1> bA1_;
TBuf<TPosition::B1> bB1_;
TBuf<TPosition::A2> bA2_;
TBuf<TPosition::B2> bB2_;
TBuf<TPosition::CO1> bC_;
GlobalTensor<int8_t> xGm_,wGm_;
GlobalTensor<int32_t> ringGm_;
TEventID aReady_,aFree_,bReady_[4],bFree_[4],abReady_[2],abFree_[2],cFree_;
uint32_t prefetched_ = 0,weightBase_ = 0;
uint32_t k_,kPad_,n_,producerId_,bk_,bm_,width_,l0k_,mode_;
uint32_t fullK_;
bool aPending_;
};
template<bool PARTIAL = false,bool RESIDENT_A = false,bool PADDED_A = false>
class ReaderPhasedRowsProducer{
public:
__aicore__ inline ReaderPhasedRowsProducer(TPipe& pipe): pipe_(pipe){}
__aicore__ inline void Init(GM_ADDR x,GM_ADDR weight,GM_ADDR ring,
uint32_t k,uint32_t n,uint32_t producerId,uint32_t bm,uint32_t width,
uint32_t l0k,uint32_t bk,uint32_t mode,uint32_t fullK = 0){
xGm_.SetGlobalBuffer((__gm__ int8_t*)x);
wGm_.SetGlobalBuffer((__gm__ int8_t*)weight);
ringGm_.SetGlobalBuffer((__gm__ int32_t*)ring);
constexpr uint32_t kAlignment = PADDED_A ? 256 : 32;
k_ = k;kPad_ =(k + kAlignment - 1)/ kAlignment * kAlignment;
n_ = n;producerId_ = producerId;bk_ = bk;
bm_ = bm;width_ = width;l0k_ = l0k;mode_ = mode;aPending_ = false;
if(PARTIAL)fullK_ = fullK;
SetMMRowMajor();
SetAtomicAdd<int32_t>();
if(bm_ >= 256){
SetLoadDataRepeat({0,1,0});
SetLoadDataPaddingValue(int8_t(0));
}
pipe_.InitBuffer(bA1_,bm_ * kPad_);
pipe_.InitBuffer(bB1_,2 * bk_ * width_);
pipe_.InitBuffer(bA2_,RESIDENT_A ? bm_ * kPad_ : 2 * bm_ * l0k_);
pipe_.InitBuffer(bB2_,2 * l0k_ * width_);
pipe_.InitBuffer(bC_,bm_ * width_ * sizeof(int32_t));

aReady_ = pipe_.AllocEventID<HardEvent::MTE2_MTE1>();
aFree_ = pipe_.AllocEventID<HardEvent::MTE1_MTE2>();
SetFlag<HardEvent::MTE1_MTE2>(aFree_);

for(uint32_t bank = 0;bank < 2;++bank){
bReady_[bank]= pipe_.AllocEventID<HardEvent::MTE2_MTE1>();
bFree_[bank]= pipe_.AllocEventID<HardEvent::MTE1_MTE2>();
abReady_[bank]= pipe_.AllocEventID<HardEvent::MTE1_M>();
abFree_[bank]= pipe_.AllocEventID<HardEvent::M_MTE1>();
SetFlag<HardEvent::MTE1_MTE2>(bFree_[bank]);
SetFlag<HardEvent::M_MTE1>(abFree_[bank]);
}
cFree_ = pipe_.AllocEventID<HardEvent::FIX_M>();
}
__aicore__ inline void SelectPartition(GM_ADDR x,GM_ADDR weight,uint32_t length){
xGm_.SetGlobalBuffer((__gm__ int8_t*)x);
wGm_.SetGlobalBuffer((__gm__ int8_t*)weight);
k_ = length;kPad_ =(length + 31)/ 32 * 32;
}


__aicore__ inline void BeginOwner(uint32_t row,uint32_t validM){
WaitFlag<HardEvent::MTE1_MTE2>(aFree_);
ownerRow_ = row;
ownerRows_ = validM;
ownerPending_ = true;
}
__aicore__ inline void LoadOwnerRows(const TaskDesc& task){
const uint32_t blocks =(ownerRows_ + 15)/ 16;
const uint32_t columns =(n_ + width_ - 1)/ width_;
const uint32_t parallelColumns = GetBlockNum()/ 4;
const uint32_t readers = columns < parallelColumns ? columns : parallelColumns;
const uint32_t sections = blocks < readers ? blocks : readers;
const uint32_t quotient = blocks / sections;
const uint32_t remainder = blocks % sections;
const uint32_t phase =(task.col / width_)% sections;
const uint32_t mpad = blocks * 16;
const uint32_t rowStride = PARTIAL ? fullK_ :(PADDED_A ? kPad_ : k_);
for(uint32_t step = 0;step < sections;++step){
uint32_t section = phase + step;
if(section >= sections)section -= sections;
const uint32_t firstBlock = section * quotient
+(section < remainder ? section : remainder);
const uint32_t first = firstBlock * 16;
const uint32_t capacity =(quotient +(section < remainder ? 1 : 0))* 16;
const uint32_t rows = ownerRows_ - first < capacity ? ownerRows_ - first : capacity;
Nd2NzParams a;
a.ndNum = 1;a.nValue = rows;a.dValue = PADDED_A ? kPad_ : k_;
a.srcNdMatrixStride = 0;a.srcDValue = rowStride;
a.dstNzC0Stride = mpad;a.dstNzNStride = 1;a.dstNzMatrixStride = 0;
DataCopy(bA1_.Get<int8_t>()[first * 32],
xGm_[static_cast<uint64_t>(ownerRow_ + first)* rowStride],a);
}
if(mpad > ownerRows_){
Fill<uint32_t>(bA1_.Get<uint32_t>()[ownerRows_ * 8],
{static_cast<uint16_t>(kPad_ / 32),static_cast<uint16_t>(mpad - ownerRows_),
static_cast<uint16_t>(ownerRows_),0u});
}
SetFlag<HardEvent::MTE2_MTE1>(aReady_);
aPending_ = true;
ownerPending_ = false;
}
__aicore__ inline void Prefetch(const TaskDesc& task,uint32_t q,uint32_t bank){
WaitFlag<HardEvent::MTE1_MTE2>(bFree_[bank]);
const uint32_t remaining = k_ - q * bk_;
const uint32_t qActual = remaining < bk_ ? remaining : bk_;
const uint32_t qPadK =(qActual + 31)/ 32 * 32;
const uint32_t npad =(task.validN + 31)/ 32 * 32;


Nd2NzParams b;
b.ndNum = 1;b.nValue = qActual;b.dValue = task.validN;
b.srcNdMatrixStride = 0;b.srcDValue = n_;
b.dstNzC0Stride = qPadK;b.dstNzNStride = 1;b.dstNzMatrixStride = 0;
DataCopy(bB1_.Get<int8_t>()[bank * bk_ * width_],
wGm_[static_cast<uint64_t>(task.expert)*(PARTIAL ? fullK_ : k_)* n_
+ static_cast<uint64_t>(q)* bk_ * n_ + task.col],b);
if(qPadK > qActual){
Fill<uint32_t>(bB1_.Get<uint32_t>()[bank * bk_ * width_ / 4 + qActual * 8],
{static_cast<uint16_t>(npad / 32),static_cast<uint16_t>(qPadK - qActual),
static_cast<uint16_t>(qActual),0u});
}
SetFlag<HardEvent::MTE2_MTE1>(bReady_[bank]);
}
__aicore__ inline void Produce(const TaskDesc& task,uint32_t sequence,bool lastInOwner){
const uint32_t ringSlot = sequence % SLOTS;
if(ownerPending_)LoadOwnerRows(task);
const bool loadA = aPending_;
const uint32_t mpad =(task.validM + 15)/ 16 * 16;
const uint8_t pad[4]={0,0,0,0};
if(mpad >= 256)SetFmatrix(1,static_cast<uint16_t>(mpad),pad,FmatrixMode::FMATRIX_LEFT);
const uint32_t npad =(task.validN + 31)/ 32 * 32;
const uint32_t chunks =(k_ + bk_ - 1)/ bk_;
const uint32_t initial = chunks < 2 ? chunks : 2;
for(uint32_t q = 0;q < initial;++q)Prefetch(task,q,q);
if(aPending_){
WaitFlag<HardEvent::MTE2_MTE1>(aReady_);
aPending_ = false;
}
for(uint32_t q = 0;q < chunks;++q){
const uint32_t bBank = q % 2;
const uint32_t remaining = k_ - q * bk_;
const uint32_t qActual = remaining < bk_ ? remaining : bk_;
WaitFlag<HardEvent::MTE2_MTE1>(bReady_[bBank]);
const uint32_t qPadK =(qActual + 31)/ 32 * 32;
const uint32_t slices =(qActual + l0k_ - 1)/ l0k_;
for(uint32_t s = 0;s < slices;++s){
const uint32_t remainingSlice = qActual - s * l0k_;
const uint32_t validSlice = remainingSlice < l0k_ ? remainingSlice : l0k_;
const uint32_t kPad =(validSlice + 31)/ 32 * 32;
const uint32_t globalKstart = q * bk_ + s * l0k_;
const uint32_t abBank =(globalKstart / l0k_)% 2;
WaitFlag<HardEvent::M_MTE1>(abFree_[abBank]);
const uint32_t a2Offset = RESIDENT_A
? globalKstart * bm_ : abBank * bm_ * l0k_;
const uint64_t aOffset = static_cast<uint64_t>(globalKstart)* mpad;
if(!RESIDENT_A || loadA){
if(mpad >= 256){
LoadData3DParamsV2<int8_t> ap;
ap.l1H = 1;ap.l1W = mpad;
ap.channelSize = kPad;ap.kExtension = kPad;ap.mExtension = mpad;
LoadData<int8_t,kALoad3dConfig>(bA2_.Get<int8_t>()[a2Offset],
bA1_.Get<int8_t>()[aOffset],ap);
}else{
LoadData2DParams ap;
ap.startIndex = 0;ap.repeatTimes = kPad / 32;ap.srcStride = mpad / 16;
ap.dstGap = 0;ap.ifTranspose = false;ap.sid = 0;ap.addrMode = 0;
for(uint32_t j = 0;j < mpad / 16;++j)
LoadData<int8_t>(bA2_.Get<int8_t>()[a2Offset + j * 16 * kPad],
bA1_.Get<int8_t>()[aOffset + j * 512],ap);
}
}
LoadData2dTransposeParams bp;
bp.startIndex = 0;bp.repeatTimes = npad / 32;bp.srcStride = qPadK / 32;
bp.dstGap = 1;bp.dstFracGap = 0;bp.addrMode = 0;
for(uint32_t i = 0;i < kPad / 32;++i)
LoadDataWithTranspose<int8_t>(bB2_.Get<int8_t>()[abBank * l0k_ * width_ + i * 32 * npad],
bB1_.Get<int8_t>()[bBank * bk_ * width_ + s * l0k_ * 32 + i * 1024],bp);
if(s + 1 == slices)SetFlag<HardEvent::MTE1_MTE2>(bFree_[bBank]);
if(lastInOwner && q + 1 == chunks && s + 1 == slices)
SetFlag<HardEvent::MTE1_MTE2>(aFree_);
SetFlag<HardEvent::MTE1_M>(abReady_[abBank]);
WaitFlag<HardEvent::MTE1_M>(abReady_[abBank]);
MmadParams mm;
mm.m = mpad;mm.n = npad;mm.k = kPad;
mm.unitFlag =(q + 1 == chunks && s + 1 == slices)? 3 : 2;
mm.cmatrixSource = false;mm.cmatrixInitVal =(globalKstart == 0);
mm.isBias = false;mm.kDirectionAlign = false;
mm.fmOffset = 0;mm.enSsparse = false;
mm.enWinogradA = false;mm.enWinogradB = false;
if(globalKstart != 0 &&(mpad / 16)*(npad / 16)< 10)PipeBarrier<PIPE_M>();
Mmad<int32_t,int8_t,int8_t>(bC_.Get<int32_t>(),
bA2_.Get<int8_t>()[a2Offset],
bB2_.Get<int8_t>()[abBank * l0k_ * width_],mm);
SetFlag<HardEvent::M_MTE1>(abFree_[abBank]);
}
if(q + 2 < chunks)Prefetch(task,q + 2,bBank);
}
if(initializationPending_){
CrossCoreWaitFlag<2>(0);
initializationPending_ = false;
}
if(!PARTIAL && sequence >= SLOTS)CrossCoreWaitFlag<2>(FREE_BASE + ringSlot);
FixpipeParamsV220 fp;
fp.nSize = npad;fp.mSize = mpad;
fp.srcStride = mpad;fp.dstStride = width_;
fp.quantPre = QuantMode_t::NoQuant;fp.deqScalar = 0;
fp.ndNum = 1;fp.srcNdStride = 0;fp.dstNdStride = 0;
fp.reluEn = false;fp.unitFlag = 3;fp.isChannelSplit = false;
const uint64_t slotBase = PARTIAL ? static_cast<uint64_t>(sequence / 4)* 4 * bm_ * width_
:(static_cast<uint64_t>(producerId_)* SLOTS + ringSlot)* bm_ * width_;
Fixpipe<int32_t,int32_t,CFG_ROW_MAJOR>(ringGm_[slotBase],bC_.Get<int32_t>(),fp);
if(!PARTIAL)CrossCoreSetFlag<2,PIPE_FIX>(READY_BASE + ringSlot);
}
__aicore__ inline void PostCompute(uint32_t produced){
if(initializationPending_){
CrossCoreWaitFlag<2>(0);
initializationPending_ = false;
}
WaitFlag<HardEvent::MTE1_MTE2>(aFree_);
for(uint32_t bank = 0;bank < 2;++bank){
WaitFlag<HardEvent::MTE1_MTE2>(bFree_[bank]);
WaitFlag<HardEvent::M_MTE1>(abFree_[bank]);
}
if(produced != 0){
SetFlag<HardEvent::FIX_M>(cFree_);
WaitFlag<HardEvent::FIX_M>(cFree_);
}
if(!PARTIAL){
const uint32_t first = produced > SLOTS ? produced - SLOTS : 0;
for(uint32_t sequence = first;sequence < produced;++sequence)
CrossCoreWaitFlag<2>(FREE_BASE + sequence % SLOTS);
}
PipeBarrier<PIPE_ALL>();
DisableDmaAtomic();
SetMMColumnMajor();

pipe_.ReleaseEventID<HardEvent::MTE2_MTE1>(aReady_);
pipe_.ReleaseEventID<HardEvent::MTE1_MTE2>(aFree_);

for(uint32_t bank = 0;bank < 2;++bank){
pipe_.ReleaseEventID<HardEvent::MTE2_MTE1>(bReady_[bank]);
pipe_.ReleaseEventID<HardEvent::MTE1_MTE2>(bFree_[bank]);
pipe_.ReleaseEventID<HardEvent::MTE1_M>(abReady_[bank]);
pipe_.ReleaseEventID<HardEvent::M_MTE1>(abFree_[bank]);
}
pipe_.ReleaseEventID<HardEvent::FIX_M>(cFree_);
}
private:
TPipe& pipe_;
TBuf<TPosition::A1> bA1_;
TBuf<TPosition::B1> bB1_;
TBuf<TPosition::A2> bA2_;
TBuf<TPosition::B2> bB2_;
TBuf<TPosition::CO1> bC_;
GlobalTensor<int8_t> xGm_,wGm_;
GlobalTensor<int32_t> ringGm_;
TEventID aReady_,aFree_,bReady_[2],bFree_[2],abReady_[2],abFree_[2],cFree_;
uint32_t k_,kPad_,n_,producerId_,bk_,bm_,width_,l0k_,mode_;
uint32_t fullK_;
bool aPending_;
bool initializationPending_ = true;
bool ownerPending_ = false;
uint32_t ownerRow_,ownerRows_;
};
template<bool PARTIAL = false,bool RESIDENT_A = false,bool PADDED_A = false>
class PreloadedPitchedActivationProducer{
public:
__aicore__ inline PreloadedPitchedActivationProducer(TPipe& pipe): pipe_(pipe){}
__aicore__ inline void Init(GM_ADDR x,GM_ADDR weight,GM_ADDR ring,
uint32_t k,uint32_t n,uint32_t producerId,uint32_t bm,uint32_t width,
uint32_t l0k,uint32_t bk,uint32_t mode,uint32_t fullK = 0){
xGm_.SetGlobalBuffer((__gm__ int8_t*)x);
wGm_.SetGlobalBuffer((__gm__ int8_t*)weight);
ringGm_.SetGlobalBuffer((__gm__ int32_t*)ring);
constexpr uint32_t kAlignment = PADDED_A ? 256 : 32;
k_ = k;kPad_ =(k + kAlignment - 1)/ kAlignment * kAlignment;
n_ = n;producerId_ = producerId;bk_ = bk;
bm_ = bm;width_ = width;l0k_ = l0k;mode_ = mode;aPending_ = false;
if(PARTIAL)fullK_ = fullK;
activationPitch_ = PARTIAL ? fullK :(PADDED_A ? kPad_ : k_);
SetMMRowMajor();
SetAtomicAdd<int32_t>();
if(bm_ >= 256){
SetLoadDataRepeat({0,1,0});
SetLoadDataPaddingValue(int8_t(0));
}
pipe_.InitBuffer(bA1_,bm_ * kPad_);
pipe_.InitBuffer(bB1_,2 * bk_ * width_);
pipe_.InitBuffer(bA2_,RESIDENT_A ? bm_ * kPad_ : 2 * bm_ * l0k_);
pipe_.InitBuffer(bB2_,2 * l0k_ * width_);
pipe_.InitBuffer(bC_,bm_ * width_ * sizeof(int32_t));

aReady_ = pipe_.AllocEventID<HardEvent::MTE2_MTE1>();
aFree_ = pipe_.AllocEventID<HardEvent::MTE1_MTE2>();
SetFlag<HardEvent::MTE1_MTE2>(aFree_);

for(uint32_t bank = 0;bank < 2;++bank){
bReady_[bank]= pipe_.AllocEventID<HardEvent::MTE2_MTE1>();
bFree_[bank]= pipe_.AllocEventID<HardEvent::MTE1_MTE2>();
abReady_[bank]= pipe_.AllocEventID<HardEvent::MTE1_M>();
abFree_[bank]= pipe_.AllocEventID<HardEvent::M_MTE1>();
SetFlag<HardEvent::MTE1_MTE2>(bFree_[bank]);
SetFlag<HardEvent::M_MTE1>(abFree_[bank]);
}
cFree_ = pipe_.AllocEventID<HardEvent::FIX_M>();
}
__aicore__ inline void SetActivationPitch(uint32_t pitch){activationPitch_ = pitch;}
__aicore__ inline void SelectPartition(GM_ADDR x,GM_ADDR weight,uint32_t length){
xGm_.SetGlobalBuffer((__gm__ int8_t*)x);
wGm_.SetGlobalBuffer((__gm__ int8_t*)weight);
k_ = length;kPad_ =(length + 31)/ 32 * 32;
}


__aicore__ inline void BeginOwner(uint32_t row,uint32_t validM){
WaitFlag<HardEvent::MTE1_MTE2>(aFree_);
ownerRow_ = row;
ownerRows_ = validM;
ownerPending_ = true;
}
__aicore__ inline void LoadOwnerRows(const TaskDesc& task){
const uint32_t blocks =(ownerRows_ + 15)/ 16;
const uint32_t columns =(n_ + width_ - 1)/ width_;
const uint32_t parallelColumns = GetBlockNum()/ 4;
const uint32_t readers = columns < parallelColumns ? columns : parallelColumns;
const uint32_t sections = blocks < readers ? blocks : readers;
const uint32_t quotient = blocks / sections;
const uint32_t remainder = blocks % sections;
const uint32_t phase =(task.col / width_)% sections;
const uint32_t mpad = blocks * 16;
const uint32_t rowStride = activationPitch_;
for(uint32_t step = 0;step < sections;++step){
uint32_t section = phase + step;
if(section >= sections)section -= sections;
const uint32_t firstBlock = section * quotient
+(section < remainder ? section : remainder);
const uint32_t first = firstBlock * 16;
const uint32_t capacity =(quotient +(section < remainder ? 1 : 0))* 16;
const uint32_t rows = ownerRows_ - first < capacity ? ownerRows_ - first : capacity;
Nd2NzParams a;
a.ndNum = 1;a.nValue = rows;a.dValue = PADDED_A ? kPad_ : k_;
a.srcNdMatrixStride = 0;a.srcDValue = rowStride;
a.dstNzC0Stride = mpad;a.dstNzNStride = 1;a.dstNzMatrixStride = 0;
DataCopy(bA1_.Get<int8_t>()[first * 32],
xGm_[static_cast<uint64_t>(ownerRow_ + first)* rowStride],a);
}
if(mpad > ownerRows_){
Fill<uint32_t>(bA1_.Get<uint32_t>()[ownerRows_ * 8],
{static_cast<uint16_t>(kPad_ / 32),static_cast<uint16_t>(mpad - ownerRows_),
static_cast<uint16_t>(ownerRows_),0u});
}
SetFlag<HardEvent::MTE2_MTE1>(aReady_);
aPending_ = true;
ownerPending_ = false;
}
__aicore__ inline void Prefetch(const TaskDesc& task,uint32_t q,uint32_t bank){
WaitFlag<HardEvent::MTE1_MTE2>(bFree_[bank]);
const uint32_t remaining = k_ - q * bk_;
const uint32_t qActual = remaining < bk_ ? remaining : bk_;
const uint32_t qPadK =(qActual + 31)/ 32 * 32;
const uint32_t npad =(task.validN + 31)/ 32 * 32;


Nd2NzParams b;
b.ndNum = 1;b.nValue = qActual;b.dValue = task.validN;
b.srcNdMatrixStride = 0;b.srcDValue = n_;
b.dstNzC0Stride = qPadK;b.dstNzNStride = 1;b.dstNzMatrixStride = 0;
DataCopy(bB1_.Get<int8_t>()[bank * bk_ * width_],
wGm_[static_cast<uint64_t>(task.expert)*(PARTIAL ? fullK_ : k_)* n_
+ static_cast<uint64_t>(q)* bk_ * n_ + task.col],b);
if(qPadK > qActual){
Fill<uint32_t>(bB1_.Get<uint32_t>()[bank * bk_ * width_ / 4 + qActual * 8],
{static_cast<uint16_t>(npad / 32),static_cast<uint16_t>(qPadK - qActual),
static_cast<uint16_t>(qActual),0u});
}
SetFlag<HardEvent::MTE2_MTE1>(bReady_[bank]);
}
__aicore__ inline void Produce(const TaskDesc& task,uint32_t sequence,bool lastInOwner){
const uint32_t ringSlot = sequence % SLOTS;
const bool firstImageTask = imagePending_;
if(firstImageTask){
const uint32_t firstChunks =(k_ + bk_ - 1)/ bk_;
const uint32_t firstInitial = firstChunks < 2 ? firstChunks : 2;
for(uint32_t q = 0;q < firstInitial;++q)Prefetch(task,q,q);
CrossCoreWaitFlag<2>(5);
imagePending_ = false;
}
if(ownerPending_)LoadOwnerRows(task);
const bool loadA = aPending_;
const uint32_t mpad =(task.validM + 15)/ 16 * 16;
const uint8_t pad[4]={0,0,0,0};
if(mpad >= 256)SetFmatrix(1,static_cast<uint16_t>(mpad),pad,FmatrixMode::FMATRIX_LEFT);
const uint32_t npad =(task.validN + 31)/ 32 * 32;
const uint32_t chunks =(k_ + bk_ - 1)/ bk_;
const uint32_t initial = chunks < 2 ? chunks : 2;
for(uint32_t q = firstImageTask ? initial : 0;q < initial;++q)Prefetch(task,q,q);
if(aPending_){
WaitFlag<HardEvent::MTE2_MTE1>(aReady_);
aPending_ = false;
}
for(uint32_t q = 0;q < chunks;++q){
const uint32_t bBank = q % 2;
const uint32_t remaining = k_ - q * bk_;
const uint32_t qActual = remaining < bk_ ? remaining : bk_;
WaitFlag<HardEvent::MTE2_MTE1>(bReady_[bBank]);
const uint32_t qPadK =(qActual + 31)/ 32 * 32;
const uint32_t slices =(qActual + l0k_ - 1)/ l0k_;
for(uint32_t s = 0;s < slices;++s){
const uint32_t remainingSlice = qActual - s * l0k_;
const uint32_t validSlice = remainingSlice < l0k_ ? remainingSlice : l0k_;
const uint32_t kPad =(validSlice + 31)/ 32 * 32;
const uint32_t globalKstart = q * bk_ + s * l0k_;
const uint32_t abBank =(globalKstart / l0k_)% 2;
WaitFlag<HardEvent::M_MTE1>(abFree_[abBank]);
const uint32_t a2Offset = RESIDENT_A
? globalKstart * bm_ : abBank * bm_ * l0k_;
const uint64_t aOffset = static_cast<uint64_t>(globalKstart)* mpad;
if(!RESIDENT_A || loadA){
if(mpad >= 256){
LoadData3DParamsV2<int8_t> ap;
ap.l1H = 1;ap.l1W = mpad;
ap.channelSize = kPad;ap.kExtension = kPad;ap.mExtension = mpad;
LoadData<int8_t,kALoad3dConfig>(bA2_.Get<int8_t>()[a2Offset],
bA1_.Get<int8_t>()[aOffset],ap);
}else{
LoadData2DParams ap;
ap.startIndex = 0;ap.repeatTimes = kPad / 32;ap.srcStride = mpad / 16;
ap.dstGap = 0;ap.ifTranspose = false;ap.sid = 0;ap.addrMode = 0;
for(uint32_t j = 0;j < mpad / 16;++j)
LoadData<int8_t>(bA2_.Get<int8_t>()[a2Offset + j * 16 * kPad],
bA1_.Get<int8_t>()[aOffset + j * 512],ap);
}
}
LoadData2dTransposeParams bp;
bp.startIndex = 0;bp.repeatTimes = npad / 32;bp.srcStride = qPadK / 32;
bp.dstGap = 1;bp.dstFracGap = 0;bp.addrMode = 0;
for(uint32_t i = 0;i < kPad / 32;++i)
LoadDataWithTranspose<int8_t>(bB2_.Get<int8_t>()[abBank * l0k_ * width_ + i * 32 * npad],
bB1_.Get<int8_t>()[bBank * bk_ * width_ + s * l0k_ * 32 + i * 1024],bp);
if(s + 1 == slices)SetFlag<HardEvent::MTE1_MTE2>(bFree_[bBank]);
if(lastInOwner && q + 1 == chunks && s + 1 == slices)
SetFlag<HardEvent::MTE1_MTE2>(aFree_);
SetFlag<HardEvent::MTE1_M>(abReady_[abBank]);
WaitFlag<HardEvent::MTE1_M>(abReady_[abBank]);
MmadParams mm;
mm.m = mpad;mm.n = npad;mm.k = kPad;
mm.unitFlag =(q + 1 == chunks && s + 1 == slices)? 3 : 2;
mm.cmatrixSource = false;mm.cmatrixInitVal =(globalKstart == 0);
mm.isBias = false;mm.kDirectionAlign = false;
mm.fmOffset = 0;mm.enSsparse = false;
mm.enWinogradA = false;mm.enWinogradB = false;
if(globalKstart != 0 &&(mpad / 16)*(npad / 16)< 10)PipeBarrier<PIPE_M>();
Mmad<int32_t,int8_t,int8_t>(bC_.Get<int32_t>(),
bA2_.Get<int8_t>()[a2Offset],
bB2_.Get<int8_t>()[abBank * l0k_ * width_],mm);
SetFlag<HardEvent::M_MTE1>(abFree_[abBank]);
}
if(q + 2 < chunks)Prefetch(task,q + 2,bBank);
}
if(initializationPending_){
CrossCoreWaitFlag<2>(0);
initializationPending_ = false;
}
if(!PARTIAL && sequence >= SLOTS)CrossCoreWaitFlag<2>(FREE_BASE + ringSlot);
FixpipeParamsV220 fp;
fp.nSize = npad;fp.mSize = mpad;
fp.srcStride = mpad;fp.dstStride = width_;
fp.quantPre = QuantMode_t::NoQuant;fp.deqScalar = 0;
fp.ndNum = 1;fp.srcNdStride = 0;fp.dstNdStride = 0;
fp.reluEn = false;fp.unitFlag = 3;fp.isChannelSplit = false;
const uint64_t slotBase = PARTIAL ? static_cast<uint64_t>(sequence / 4)* 4 * bm_ * width_
:(static_cast<uint64_t>(producerId_)* SLOTS + ringSlot)* bm_ * width_;
Fixpipe<int32_t,int32_t,CFG_ROW_MAJOR>(ringGm_[slotBase],bC_.Get<int32_t>(),fp);
if(!PARTIAL)CrossCoreSetFlag<2,PIPE_FIX>(READY_BASE + ringSlot);
}
__aicore__ inline void PostCompute(uint32_t produced){
if(imagePending_){CrossCoreWaitFlag<2>(5);imagePending_ = false;}
if(initializationPending_){
CrossCoreWaitFlag<2>(0);
initializationPending_ = false;
}
WaitFlag<HardEvent::MTE1_MTE2>(aFree_);
for(uint32_t bank = 0;bank < 2;++bank){
WaitFlag<HardEvent::MTE1_MTE2>(bFree_[bank]);
WaitFlag<HardEvent::M_MTE1>(abFree_[bank]);
}
if(produced != 0){
SetFlag<HardEvent::FIX_M>(cFree_);
WaitFlag<HardEvent::FIX_M>(cFree_);
}
if(!PARTIAL){
const uint32_t first = produced > SLOTS ? produced - SLOTS : 0;
for(uint32_t sequence = first;sequence < produced;++sequence)
CrossCoreWaitFlag<2>(FREE_BASE + sequence % SLOTS);
}
PipeBarrier<PIPE_ALL>();
DisableDmaAtomic();
SetMMColumnMajor();

pipe_.ReleaseEventID<HardEvent::MTE2_MTE1>(aReady_);
pipe_.ReleaseEventID<HardEvent::MTE1_MTE2>(aFree_);

for(uint32_t bank = 0;bank < 2;++bank){
pipe_.ReleaseEventID<HardEvent::MTE2_MTE1>(bReady_[bank]);
pipe_.ReleaseEventID<HardEvent::MTE1_MTE2>(bFree_[bank]);
pipe_.ReleaseEventID<HardEvent::MTE1_M>(abReady_[bank]);
pipe_.ReleaseEventID<HardEvent::M_MTE1>(abFree_[bank]);
}
pipe_.ReleaseEventID<HardEvent::FIX_M>(cFree_);
}
private:
TPipe& pipe_;
TBuf<TPosition::A1> bA1_;
TBuf<TPosition::B1> bB1_;
TBuf<TPosition::A2> bA2_;
TBuf<TPosition::B2> bB2_;
TBuf<TPosition::CO1> bC_;
GlobalTensor<int8_t> xGm_,wGm_;
GlobalTensor<int32_t> ringGm_;
TEventID aReady_,aFree_,bReady_[2],bFree_[2],abReady_[2],abFree_[2],cFree_;
bool imagePending_ = true;
uint32_t activationPitch_;
uint32_t k_,kPad_,n_,producerId_,bk_,bm_,width_,l0k_,mode_;
uint32_t fullK_;
bool aPending_;
bool initializationPending_ = true;
bool ownerPending_ = false;
uint32_t ownerRow_,ownerRows_;
};
template<bool PARTIAL = false,bool RESIDENT_A = false,bool PADDED_A = false,bool SPLIT_B = false>
class ScalarEventProducer{
public:
__aicore__ inline ScalarEventProducer(TPipe& pipe): pipe_(pipe){}
__aicore__ inline void Init(GM_ADDR x,GM_ADDR weight,GM_ADDR ring,
uint32_t k,uint32_t n,uint32_t producerId,uint32_t bm,uint32_t width,
uint32_t l0k,uint32_t bk,uint32_t mode,uint32_t fullK = 0){
xGm_.SetGlobalBuffer((__gm__ int8_t*)x);
wGm_.SetGlobalBuffer((__gm__ int8_t*)weight);
ringGm_.SetGlobalBuffer((__gm__ int32_t*)ring);
constexpr uint32_t kAlignment = PADDED_A ? 256 : 32;
if constexpr(SPLIT_B){
bDepth_ = mode == FULL_A && bk %(2 * l0k)== 0 ? 4 : 2;
if(bDepth_ == 4)bk /= 2;
}
k_ = k;kPad_ =(k + kAlignment - 1)/ kAlignment * kAlignment;
n_ = n;producerId_ = producerId;bk_ = bk;
bm_ = bm;width_ = width;l0k_ = l0k;mode_ = mode;aPending_ = false;
tcChunks_ = gmg_tc::ChunksOf(k_,bk_);
tcNPad_ = gmg_tc::NPadOf(n_);
if(PARTIAL)fullK_ = fullK;
SetMMRowMajor();
if(bm_ >= 256){
SetLoadDataRepeat({0,1,0});
SetLoadDataPaddingValue(int8_t(0));
}
pipe_.InitBuffer(bA1_,mode_ == FULL_A ? bm_ * kPad_ : 2 * bm_ * bk_);
pipe_.InitBuffer(bB1_,(SPLIT_B ? bDepth_ : 2)* bk_ * width_);
pipe_.InitBuffer(bA2_,RESIDENT_A ? bm_ * kPad_ : 2 * bm_ * l0k_);
pipe_.InitBuffer(bB2_,2 * l0k_ * width_);
pipe_.InitBuffer(bC_,bm_ * width_ * sizeof(int32_t));
if(mode_ == FULL_A){
aReady_ = pipe_.AllocEventID<HardEvent::MTE2_MTE1>();
aFree_ = pipe_.AllocEventID<HardEvent::MTE1_MTE2>();
SetFlag<HardEvent::MTE1_MTE2>(aFree_);
}
bReady0_ = pipe_.AllocEventID<HardEvent::MTE2_MTE1>();
bFree0_ = pipe_.AllocEventID<HardEvent::MTE1_MTE2>();
abReady0_ = pipe_.AllocEventID<HardEvent::MTE1_M>();
abFree0_ = pipe_.AllocEventID<HardEvent::M_MTE1>();
SetFlag<HardEvent::MTE1_MTE2>(bFree0_);
SetFlag<HardEvent::M_MTE1>(abFree0_);
bReady1_ = pipe_.AllocEventID<HardEvent::MTE2_MTE1>();
bFree1_ = pipe_.AllocEventID<HardEvent::MTE1_MTE2>();
abReady1_ = pipe_.AllocEventID<HardEvent::MTE1_M>();
abFree1_ = pipe_.AllocEventID<HardEvent::M_MTE1>();
SetFlag<HardEvent::MTE1_MTE2>(bFree1_);
SetFlag<HardEvent::M_MTE1>(abFree1_);
if constexpr(SPLIT_B){
bReady2_ = pipe_.AllocEventID<HardEvent::MTE2_MTE1>();
bReady3_ = pipe_.AllocEventID<HardEvent::MTE2_MTE1>();
bFree2_ = pipe_.AllocEventID<HardEvent::MTE1_MTE2>();
bFree3_ = pipe_.AllocEventID<HardEvent::MTE1_MTE2>();
SetFlag<HardEvent::MTE1_MTE2>(bFree2_);
SetFlag<HardEvent::MTE1_MTE2>(bFree3_);
}
cFree_ = pipe_.AllocEventID<HardEvent::FIX_M>();
}
__aicore__ inline void SelectPartition(GM_ADDR x,GM_ADDR weight,uint32_t length){
xGm_.SetGlobalBuffer((__gm__ int8_t*)x);
wGm_.SetGlobalBuffer((__gm__ int8_t*)weight);
k_ = length;kPad_ =(length + 31)/ 32 * 32;
}
__aicore__ inline void SetTranscode(GM_ADDR image,uint32_t on){
tcOn_ =(on != 0)&&(mode_ == STREAM);
nzGm_.SetGlobalBuffer((__gm__ int8_t*)image);
}
__aicore__ inline bool TranscodeOn()const{return tcOn_;}
__aicore__ inline void BeginOwner(uint32_t row,uint32_t validM){
if(mode_ != FULL_A)return;
WaitFlag<HardEvent::MTE1_MTE2>(aFree_);
const uint32_t mpad =(validM + 15)/ 16 * 16;
Nd2NzParams a;
a.ndNum = 1;a.nValue = validM;a.dValue = PADDED_A ? kPad_ : k_;
a.srcNdMatrixStride = 0;a.srcDValue = PARTIAL ? fullK_ :(PADDED_A ? kPad_ : k_);
a.dstNzC0Stride = mpad;a.dstNzNStride = 1;a.dstNzMatrixStride = 0;
DataCopy(bA1_.Get<int8_t>(),xGm_[static_cast<uint64_t>(row)*(PARTIAL ? fullK_ :(PADDED_A ? kPad_ : k_))],a);
if(mpad > validM){
Fill<uint32_t>(bA1_.Get<uint32_t>()[validM * 8],
{static_cast<uint16_t>(kPad_ / 32),static_cast<uint16_t>(mpad - validM),
static_cast<uint16_t>(validM),0u});
}
SetFlag<HardEvent::MTE2_MTE1>(aReady_);
aPending_ = true;
}
__aicore__ inline void Prefetch(const TaskDesc& task,uint32_t q,uint32_t bank){
const TEventID bFree =(SPLIT_B && bank >= 2)?(bank == 2 ? bFree2_ : bFree3_):(bank == 0 ? bFree0_ : bFree1_);
const TEventID bReady =(SPLIT_B && bank >= 2)?(bank == 2 ? bReady2_ : bReady3_):(bank == 0 ? bReady0_ : bReady1_);
WaitFlag<HardEvent::MTE1_MTE2>(bFree);
const uint32_t remaining = k_ - q * bk_;
const uint32_t qActual = remaining < bk_ ? remaining : bk_;
const uint32_t qPadK =(qActual + 31)/ 32 * 32;
const uint32_t npad =(task.validN + 31)/ 32 * 32;
if(mode_ == STREAM){
const uint32_t mpad =(task.validM + 15)/ 16 * 16;
Nd2NzParams a;
a.ndNum = 1;a.nValue = task.validM;a.dValue = qActual;
a.srcNdMatrixStride = 0;a.srcDValue = PARTIAL ? fullK_ : k_;
a.dstNzC0Stride = mpad;a.dstNzNStride = 1;a.dstNzMatrixStride = 0;
DataCopy(bA1_.Get<int8_t>()[bank * bm_ * bk_],
xGm_[static_cast<uint64_t>(task.row)*(PARTIAL ? fullK_ : k_)+ static_cast<uint64_t>(q)* bk_],a);
if(mpad > task.validM){
Fill<uint32_t>(bA1_.Get<uint32_t>()[bank * bm_ * bk_ / 4 + task.validM * 8],
{static_cast<uint16_t>(qPadK / 32),static_cast<uint16_t>(mpad - task.validM),
static_cast<uint16_t>(task.validM),0u});
}
}
if(tcOn_){
const uint32_t npadT =(task.validN + 31)/ 32 * 32;
const uint32_t qPadKt =(qActual + 31)/ 32 * 32;
const uint64_t base = static_cast<uint64_t>(task.expert)* tcChunks_ * bk_ * tcNPad_
+ static_cast<uint64_t>(q)* bk_ * tcNPad_
+ static_cast<uint64_t>(task.col)* qPadKt;
DataCopy(bB1_.Get<int8_t>()[bank * bk_ * width_],nzGm_[base],qPadKt * npadT);
if(qPadKt > qActual){
Fill<uint32_t>(bB1_.Get<uint32_t>()[bank * bk_ * width_ / 4 + qActual * 8],
{static_cast<uint16_t>(npadT / 32),static_cast<uint16_t>(qPadKt - qActual),
static_cast<uint16_t>(qActual),0u});
}
SetFlag<HardEvent::MTE2_MTE1>(bReady);
return;
}
Nd2NzParams b;
b.ndNum = 1;b.nValue = qActual;b.dValue = task.validN;
b.srcNdMatrixStride = 0;b.srcDValue = n_;
b.dstNzC0Stride = qPadK;b.dstNzNStride = 1;b.dstNzMatrixStride = 0;
DataCopy(bB1_.Get<int8_t>()[bank * bk_ * width_],
wGm_[static_cast<uint64_t>(task.expert)*(PARTIAL ? fullK_ : k_)* n_
+ static_cast<uint64_t>(q)* bk_ * n_ + task.col],b);
if(qPadK > qActual){
Fill<uint32_t>(bB1_.Get<uint32_t>()[bank * bk_ * width_ / 4 + qActual * 8],
{static_cast<uint16_t>(npad / 32),static_cast<uint16_t>(qPadK - qActual),
static_cast<uint16_t>(qActual),0u});
}
SetFlag<HardEvent::MTE2_MTE1>(bReady);
}
__aicore__ inline void Produce(const TaskDesc& task,uint32_t sequence,bool lastInOwner){
const uint32_t ringSlot = sequence % SLOTS;
const bool loadA = aPending_;
const uint32_t mpad =(task.validM + 15)/ 16 * 16;
const uint8_t pad[4]={0,0,0,0};
if(mpad >= 256)SetFmatrix(1,static_cast<uint16_t>(mpad),pad,FmatrixMode::FMATRIX_LEFT);
const uint32_t npad =(task.validN + 31)/ 32 * 32;
const uint32_t chunks =(k_ + bk_ - 1)/ bk_;
const uint32_t depth = SPLIT_B ? bDepth_ : 2;
const uint32_t initial = chunks < depth ? chunks : depth;
for(uint32_t q = 0;q < initial;++q)Prefetch(task,q,q);
if(aPending_){
WaitFlag<HardEvent::MTE2_MTE1>(aReady_);
aPending_ = false;
}
for(uint32_t q = 0;q < chunks;++q){
const uint32_t bBank = q % depth;
const uint32_t remaining = k_ - q * bk_;
const uint32_t qActual = remaining < bk_ ? remaining : bk_;
const TEventID bReady =(SPLIT_B && bBank >= 2)?(bBank == 2 ? bReady2_ : bReady3_):(bBank == 0 ? bReady0_ : bReady1_);
const TEventID bFree =(SPLIT_B && bBank >= 2)?(bBank == 2 ? bFree2_ : bFree3_):(bBank == 0 ? bFree0_ : bFree1_);
WaitFlag<HardEvent::MTE2_MTE1>(bReady);
const uint32_t qPadK =(qActual + 31)/ 32 * 32;
const uint32_t slices =(qActual + l0k_ - 1)/ l0k_;
for(uint32_t s = 0;s < slices;++s){
const uint32_t remainingSlice = qActual - s * l0k_;
const uint32_t validSlice = remainingSlice < l0k_ ? remainingSlice : l0k_;
const uint32_t kPad =(validSlice + 31)/ 32 * 32;
const uint32_t globalKstart = q * bk_ + s * l0k_;
const uint32_t abBank =(globalKstart / l0k_)% 2;
const TEventID abReady = abBank == 0 ? abReady0_ : abReady1_;
const TEventID abFree = abBank == 0 ? abFree0_ : abFree1_;
WaitFlag<HardEvent::M_MTE1>(abFree);
const uint32_t a2Offset = RESIDENT_A
? globalKstart * bm_ : abBank * bm_ * l0k_;
const uint64_t aOffset = mode_ == FULL_A
? static_cast<uint64_t>(globalKstart)* mpad
: static_cast<uint64_t>(bBank)* bm_ * bk_ + static_cast<uint64_t>(s)* l0k_ * mpad;
if(!RESIDENT_A || loadA){
if(mpad >= 256){
LoadData3DParamsV2<int8_t> ap;
ap.l1H = 1;ap.l1W = mpad;
ap.channelSize = kPad;ap.kExtension = kPad;ap.mExtension = mpad;
LoadData<int8_t,kALoad3dConfig>(bA2_.Get<int8_t>()[a2Offset],
bA1_.Get<int8_t>()[aOffset],ap);
}else{
LoadData2DParams ap;
ap.startIndex = 0;ap.repeatTimes = kPad / 32;ap.srcStride = mpad / 16;
ap.dstGap = 0;ap.ifTranspose = false;ap.sid = 0;ap.addrMode = 0;
for(uint32_t j = 0;j < mpad / 16;++j)
LoadData<int8_t>(bA2_.Get<int8_t>()[a2Offset + j * 16 * kPad],
bA1_.Get<int8_t>()[aOffset + j * 512],ap);
}
}
LoadData2dTransposeParams bp;
bp.startIndex = 0;bp.repeatTimes = npad / 32;bp.srcStride = qPadK / 32;
bp.dstGap = 1;bp.dstFracGap = 0;bp.addrMode = 0;
for(uint32_t i = 0;i < kPad / 32;++i)
LoadDataWithTranspose<int8_t>(bB2_.Get<int8_t>()[abBank * l0k_ * width_ + i * 32 * npad],
bB1_.Get<int8_t>()[bBank * bk_ * width_ + s * l0k_ * 32 + i * 1024],bp);
if(s + 1 == slices)SetFlag<HardEvent::MTE1_MTE2>(bFree);
if(mode_ == FULL_A && lastInOwner && q + 1 == chunks && s + 1 == slices)
SetFlag<HardEvent::MTE1_MTE2>(aFree_);
SetFlag<HardEvent::MTE1_M>(abReady);
WaitFlag<HardEvent::MTE1_M>(abReady);
MmadParams mm;
mm.m = mpad;mm.n = npad;mm.k = kPad;
mm.unitFlag =(q + 1 == chunks && s + 1 == slices)? 3 : 2;
mm.cmatrixSource = false;mm.cmatrixInitVal =(globalKstart == 0);
mm.isBias = false;mm.kDirectionAlign = false;
mm.fmOffset = 0;mm.enSsparse = false;
mm.enWinogradA = false;mm.enWinogradB = false;
if(globalKstart != 0 &&(mpad / 16)*(npad / 16)< 10)PipeBarrier<PIPE_M>();
Mmad<int32_t,int8_t,int8_t>(bC_.Get<int32_t>(),
bA2_.Get<int8_t>()[a2Offset],
bB2_.Get<int8_t>()[abBank * l0k_ * width_],mm);
SetFlag<HardEvent::M_MTE1>(abFree);
}
if(q + depth < chunks)Prefetch(task,q + depth,bBank);
}
if(!PARTIAL && sequence >= SLOTS)CrossCoreWaitFlag<2>(FREE_BASE + ringSlot);
FixpipeParamsV220 fp;
fp.nSize = npad;fp.mSize = mpad;
fp.srcStride = mpad;fp.dstStride = width_;
fp.quantPre = QuantMode_t::NoQuant;fp.deqScalar = 0;
fp.ndNum = 1;fp.srcNdStride = 0;fp.dstNdStride = 0;
fp.reluEn = false;fp.unitFlag = 3;fp.isChannelSplit = false;
const uint64_t slotBase = PARTIAL ? static_cast<uint64_t>(sequence)* bm_ * width_
:(static_cast<uint64_t>(producerId_)* SLOTS + ringSlot)* bm_ * width_;
Fixpipe<int32_t,int32_t,CFG_ROW_MAJOR>(ringGm_[slotBase],bC_.Get<int32_t>(),fp);
if(!PARTIAL)CrossCoreSetFlag<2,PIPE_FIX>(READY_BASE + ringSlot);
}
__aicore__ inline void PostCompute(uint32_t produced){
if(mode_ == FULL_A)WaitFlag<HardEvent::MTE1_MTE2>(aFree_);
if constexpr(SPLIT_B){
WaitFlag<HardEvent::MTE1_MTE2>(bFree2_);
WaitFlag<HardEvent::MTE1_MTE2>(bFree3_);
}
WaitFlag<HardEvent::MTE1_MTE2>(bFree0_);
WaitFlag<HardEvent::M_MTE1>(abFree0_);
WaitFlag<HardEvent::MTE1_MTE2>(bFree1_);
WaitFlag<HardEvent::M_MTE1>(abFree1_);
if(produced != 0){
SetFlag<HardEvent::FIX_M>(cFree_);
WaitFlag<HardEvent::FIX_M>(cFree_);
}
if(!PARTIAL){
const uint32_t first = produced > SLOTS ? produced - SLOTS : 0;
for(uint32_t sequence = first;sequence < produced;++sequence)
CrossCoreWaitFlag<2>(FREE_BASE + sequence % SLOTS);
}
PipeBarrier<PIPE_ALL>();
SetMMColumnMajor();
if(mode_ == FULL_A){
pipe_.ReleaseEventID<HardEvent::MTE2_MTE1>(aReady_);
pipe_.ReleaseEventID<HardEvent::MTE1_MTE2>(aFree_);
}
pipe_.ReleaseEventID<HardEvent::MTE2_MTE1>(bReady0_);
pipe_.ReleaseEventID<HardEvent::MTE1_MTE2>(bFree0_);
pipe_.ReleaseEventID<HardEvent::MTE1_M>(abReady0_);
pipe_.ReleaseEventID<HardEvent::M_MTE1>(abFree0_);
pipe_.ReleaseEventID<HardEvent::MTE2_MTE1>(bReady1_);
pipe_.ReleaseEventID<HardEvent::MTE1_MTE2>(bFree1_);
pipe_.ReleaseEventID<HardEvent::MTE1_M>(abReady1_);
pipe_.ReleaseEventID<HardEvent::M_MTE1>(abFree1_);
if constexpr(SPLIT_B){
pipe_.ReleaseEventID<HardEvent::MTE2_MTE1>(bReady2_);
pipe_.ReleaseEventID<HardEvent::MTE2_MTE1>(bReady3_);
pipe_.ReleaseEventID<HardEvent::MTE1_MTE2>(bFree2_);
pipe_.ReleaseEventID<HardEvent::MTE1_MTE2>(bFree3_);
}
pipe_.ReleaseEventID<HardEvent::FIX_M>(cFree_);
}
private:
TPipe& pipe_;
TBuf<TPosition::A1> bA1_;
TBuf<TPosition::B1> bB1_;
TBuf<TPosition::A2> bA2_;
TBuf<TPosition::B2> bB2_;
TBuf<TPosition::CO1> bC_;
GlobalTensor<int8_t> xGm_,wGm_;
GlobalTensor<int8_t> nzGm_;
GlobalTensor<int32_t> ringGm_;
TEventID aReady_,aFree_,bReady0_,bReady1_,bFree0_,bFree1_;
TEventID abReady0_,abReady1_,abFree0_,abFree1_,cFree_;
uint32_t k_,kPad_,n_,producerId_,bk_,bm_,width_,l0k_,mode_;
union{uint32_t tcChunks_;uint32_t fullK_;};
uint32_t tcNPad_;
bool aPending_;
bool tcOn_ = false;
TEventID bReady2_,bReady3_,bFree2_,bFree3_;
uint32_t bDepth_;
};
template<bool PARTIAL = false,bool RESIDENT_A = false,bool PADDED_A = false>
class ThreeScalarInputProducer{
public:
__aicore__ inline ThreeScalarInputProducer(TPipe& pipe): pipe_(pipe){}
__aicore__ inline void Init(GM_ADDR x,GM_ADDR weight,GM_ADDR ring,
uint32_t k,uint32_t n,uint32_t producerId,uint32_t bm,uint32_t width,
uint32_t l0k,uint32_t bk,uint32_t mode,uint32_t fullK = 0){
xGm_.SetGlobalBuffer((__gm__ int8_t*)x);
wGm_.SetGlobalBuffer((__gm__ int8_t*)weight);
ringGm_.SetGlobalBuffer((__gm__ int32_t*)ring);
constexpr uint32_t kAlignment = PADDED_A ? 256 : 32;
k_ = k;kPad_ =(k + kAlignment - 1)/ kAlignment * kAlignment;
n_ = n;producerId_ = producerId;bk_ = bk;
bm_ = bm;width_ = width;l0k_ = l0k;mode_ = mode;aPending_ = false;
tcChunks_ = gmg_tc::ChunksOf(k_,bk_);
tcNPad_ = gmg_tc::NPadOf(n_);
if(PARTIAL)fullK_ = fullK;
SetMMRowMajor();
if(bm_ >= 256){
SetLoadDataRepeat({0,1,0});
SetLoadDataPaddingValue(int8_t(0));
}
pipe_.InitBuffer(bA1_,mode_ == FULL_A ? bm_ * kPad_ : 2 * bm_ * bk_);
pipe_.InitBuffer(bB1_,3 * bk_ * width_);
pipe_.InitBuffer(bA2_,RESIDENT_A ? bm_ * kPad_ : 2 * bm_ * l0k_);
pipe_.InitBuffer(bB2_,2 * l0k_ * width_);
pipe_.InitBuffer(bC_,bm_ * width_ * sizeof(int32_t));
if(mode_ == FULL_A){
aReady_ = pipe_.AllocEventID<HardEvent::MTE2_MTE1>();
aFree_ = pipe_.AllocEventID<HardEvent::MTE1_MTE2>();
SetFlag<HardEvent::MTE1_MTE2>(aFree_);
}
bReady0_ = pipe_.AllocEventID<HardEvent::MTE2_MTE1>();
bFree0_ = pipe_.AllocEventID<HardEvent::MTE1_MTE2>();
abReady0_ = pipe_.AllocEventID<HardEvent::MTE1_M>();
abFree0_ = pipe_.AllocEventID<HardEvent::M_MTE1>();
SetFlag<HardEvent::MTE1_MTE2>(bFree0_);
SetFlag<HardEvent::M_MTE1>(abFree0_);
bReady1_ = pipe_.AllocEventID<HardEvent::MTE2_MTE1>();
bFree1_ = pipe_.AllocEventID<HardEvent::MTE1_MTE2>();
abReady1_ = pipe_.AllocEventID<HardEvent::MTE1_M>();
abFree1_ = pipe_.AllocEventID<HardEvent::M_MTE1>();
SetFlag<HardEvent::MTE1_MTE2>(bFree1_);
SetFlag<HardEvent::M_MTE1>(abFree1_);
bReady2_ = pipe_.AllocEventID<HardEvent::MTE2_MTE1>();
bFree2_ = pipe_.AllocEventID<HardEvent::MTE1_MTE2>();
SetFlag<HardEvent::MTE1_MTE2>(bFree2_);
cFree_ = pipe_.AllocEventID<HardEvent::FIX_M>();
}
__aicore__ inline void SelectPartition(GM_ADDR x,GM_ADDR weight,uint32_t length){
xGm_.SetGlobalBuffer((__gm__ int8_t*)x);
wGm_.SetGlobalBuffer((__gm__ int8_t*)weight);
k_ = length;kPad_ =(length + 31)/ 32 * 32;
}
__aicore__ inline void SetTranscode(GM_ADDR image,uint32_t on){
tcOn_ =(on != 0)&&(mode_ == STREAM);
nzGm_.SetGlobalBuffer((__gm__ int8_t*)image);
}
__aicore__ inline bool TranscodeOn()const{return tcOn_;}
__aicore__ inline void BeginOwner(uint32_t row,uint32_t validM){
if(mode_ != FULL_A)return;
WaitFlag<HardEvent::MTE1_MTE2>(aFree_);
const uint32_t mpad =(validM + 15)/ 16 * 16;
Nd2NzParams a;
a.ndNum = 1;a.nValue = validM;a.dValue = PADDED_A ? kPad_ : k_;
a.srcNdMatrixStride = 0;a.srcDValue = PARTIAL ? fullK_ :(PADDED_A ? kPad_ : k_);
a.dstNzC0Stride = mpad;a.dstNzNStride = 1;a.dstNzMatrixStride = 0;
DataCopy(bA1_.Get<int8_t>(),xGm_[static_cast<uint64_t>(row)*(PARTIAL ? fullK_ :(PADDED_A ? kPad_ : k_))],a);
if(mpad > validM){
Fill<uint32_t>(bA1_.Get<uint32_t>()[validM * 8],
{static_cast<uint16_t>(kPad_ / 32),static_cast<uint16_t>(mpad - validM),
static_cast<uint16_t>(validM),0u});
}
SetFlag<HardEvent::MTE2_MTE1>(aReady_);
aPending_ = true;
}
__aicore__ inline void Prefetch(const TaskDesc& task,uint32_t q,uint32_t bank){
const TEventID bFree = bank == 0 ? bFree0_ :(bank == 1 ? bFree1_ : bFree2_);
const TEventID bReady = bank == 0 ? bReady0_ :(bank == 1 ? bReady1_ : bReady2_);
WaitFlag<HardEvent::MTE1_MTE2>(bFree);
const uint32_t remaining = k_ - q * bk_;
const uint32_t qActual = remaining < bk_ ? remaining : bk_;
const uint32_t qPadK =(qActual + 31)/ 32 * 32;
const uint32_t npad =(task.validN + 31)/ 32 * 32;
if(mode_ == STREAM){
const uint32_t mpad =(task.validM + 15)/ 16 * 16;
Nd2NzParams a;
a.ndNum = 1;a.nValue = task.validM;a.dValue = qActual;
a.srcNdMatrixStride = 0;a.srcDValue = PARTIAL ? fullK_ : k_;
a.dstNzC0Stride = mpad;a.dstNzNStride = 1;a.dstNzMatrixStride = 0;
DataCopy(bA1_.Get<int8_t>()[bank * bm_ * bk_],
xGm_[static_cast<uint64_t>(task.row)*(PARTIAL ? fullK_ : k_)+ static_cast<uint64_t>(q)* bk_],a);
if(mpad > task.validM){
Fill<uint32_t>(bA1_.Get<uint32_t>()[bank * bm_ * bk_ / 4 + task.validM * 8],
{static_cast<uint16_t>(qPadK / 32),static_cast<uint16_t>(mpad - task.validM),
static_cast<uint16_t>(task.validM),0u});
}
}
if(tcOn_){
const uint32_t npadT =(task.validN + 31)/ 32 * 32;
const uint32_t qPadKt =(qActual + 31)/ 32 * 32;
const uint64_t base = static_cast<uint64_t>(task.expert)* tcChunks_ * bk_ * tcNPad_
+ static_cast<uint64_t>(q)* bk_ * tcNPad_
+ static_cast<uint64_t>(task.col)* qPadKt;
DataCopy(bB1_.Get<int8_t>()[bank * bk_ * width_],nzGm_[base],qPadKt * npadT);
if(qPadKt > qActual){
Fill<uint32_t>(bB1_.Get<uint32_t>()[bank * bk_ * width_ / 4 + qActual * 8],
{static_cast<uint16_t>(npadT / 32),static_cast<uint16_t>(qPadKt - qActual),
static_cast<uint16_t>(qActual),0u});
}
SetFlag<HardEvent::MTE2_MTE1>(bReady);
return;
}
Nd2NzParams b;
b.ndNum = 1;b.nValue = qActual;b.dValue = task.validN;
b.srcNdMatrixStride = 0;b.srcDValue = n_;
b.dstNzC0Stride = qPadK;b.dstNzNStride = 1;b.dstNzMatrixStride = 0;
if((n_&511)==256&&(qActual&1)==0){
b.ndNum=2;b.nValue=qActual/2;b.srcNdMatrixStride=n_;b.srcDValue=2*n_;
b.dstNzNStride=2;b.dstNzMatrixStride=32;
}
DataCopy(bB1_.Get<int8_t>()[bank * bk_ * width_],
wGm_[static_cast<uint64_t>(task.expert)*(PARTIAL ? fullK_ : k_)* n_
+ static_cast<uint64_t>(q)* bk_ * n_ + task.col],b);
if(qPadK > qActual){
Fill<uint32_t>(bB1_.Get<uint32_t>()[bank * bk_ * width_ / 4 + qActual * 8],
{static_cast<uint16_t>(npad / 32),static_cast<uint16_t>(qPadK - qActual),
static_cast<uint16_t>(qActual),0u});
}
SetFlag<HardEvent::MTE2_MTE1>(bReady);
}
__aicore__ inline void Produce(const TaskDesc& task,uint32_t sequence,bool lastInOwner){
const uint32_t ringSlot = sequence % SLOTS;
const bool loadA = aPending_;
const uint32_t mpad =(task.validM + 15)/ 16 * 16;
const uint8_t pad[4]={0,0,0,0};
if(mpad >= 256)SetFmatrix(1,static_cast<uint16_t>(mpad),pad,FmatrixMode::FMATRIX_LEFT);
const uint32_t npad =(task.validN + 31)/ 32 * 32;
const uint32_t chunks =(k_ + bk_ - 1)/ bk_;
const uint32_t initial = chunks < 2 ? chunks : 2;
for(uint32_t q = 0;q < initial;++q)Prefetch(task,q,q);
if(aPending_){
WaitFlag<HardEvent::MTE2_MTE1>(aReady_);
aPending_ = false;
}
for(uint32_t q = 0;q < chunks;++q){
const uint32_t bBank = q % 3;
const uint32_t remaining = k_ - q * bk_;
const uint32_t qActual = remaining < bk_ ? remaining : bk_;
const TEventID bReady = bBank == 0 ? bReady0_ :(bBank == 1 ? bReady1_ : bReady2_);
const TEventID bFree = bBank == 0 ? bFree0_ :(bBank == 1 ? bFree1_ : bFree2_);
WaitFlag<HardEvent::MTE2_MTE1>(bReady);
if(q + 2 < chunks)Prefetch(task,q + 2,(q + 2)% 3);
const uint32_t qPadK =(qActual + 31)/ 32 * 32;
const uint32_t slices =(qActual + l0k_ - 1)/ l0k_;
for(uint32_t s = 0;s < slices;++s){
const uint32_t remainingSlice = qActual - s * l0k_;
const uint32_t validSlice = remainingSlice < l0k_ ? remainingSlice : l0k_;
const uint32_t kPad =(validSlice + 31)/ 32 * 32;
const uint32_t globalKstart = q * bk_ + s * l0k_;
const uint32_t abBank =(globalKstart / l0k_)% 2;
const TEventID abReady = abBank == 0 ? abReady0_ : abReady1_;
const TEventID abFree = abBank == 0 ? abFree0_ : abFree1_;
WaitFlag<HardEvent::M_MTE1>(abFree);
const uint32_t a2Offset = RESIDENT_A
? globalKstart * bm_ : abBank * bm_ * l0k_;
const uint64_t aOffset = mode_ == FULL_A
? static_cast<uint64_t>(globalKstart)* mpad
: static_cast<uint64_t>(bBank)* bm_ * bk_ + static_cast<uint64_t>(s)* l0k_ * mpad;
if(!RESIDENT_A || loadA){
if(mpad >= 256){
LoadData3DParamsV2<int8_t> ap;
ap.l1H = 1;ap.l1W = mpad;
ap.channelSize = kPad;ap.kExtension = kPad;ap.mExtension = mpad;
LoadData<int8_t,kALoad3dConfig>(bA2_.Get<int8_t>()[a2Offset],
bA1_.Get<int8_t>()[aOffset],ap);
}else{
LoadData2DParams ap;
ap.startIndex = 0;ap.repeatTimes = kPad / 32;ap.srcStride = mpad / 16;
ap.dstGap = 0;ap.ifTranspose = false;ap.sid = 0;ap.addrMode = 0;
for(uint32_t j = 0;j < mpad / 16;++j)
LoadData<int8_t>(bA2_.Get<int8_t>()[a2Offset + j * 16 * kPad],
bA1_.Get<int8_t>()[aOffset + j * 512],ap);
}
}
LoadData2dTransposeParams bp;
bp.startIndex = 0;bp.repeatTimes = npad / 32;bp.srcStride = qPadK / 32;
bp.dstGap = 1;bp.dstFracGap = 0;bp.addrMode = 0;
for(uint32_t i = 0;i < kPad / 32;++i)
LoadDataWithTranspose<int8_t>(bB2_.Get<int8_t>()[abBank * l0k_ * width_ + i * 32 * npad],
bB1_.Get<int8_t>()[bBank * bk_ * width_ + s * l0k_ * 32 + i * 1024],bp);
if(s + 1 == slices)SetFlag<HardEvent::MTE1_MTE2>(bFree);
if(mode_ == FULL_A && lastInOwner && q + 1 == chunks && s + 1 == slices)
SetFlag<HardEvent::MTE1_MTE2>(aFree_);
SetFlag<HardEvent::MTE1_M>(abReady);
WaitFlag<HardEvent::MTE1_M>(abReady);
MmadParams mm;
mm.m = mpad;mm.n = npad;mm.k = kPad;
mm.unitFlag =(q + 1 == chunks && s + 1 == slices)? 3 : 2;
mm.cmatrixSource = false;mm.cmatrixInitVal =(globalKstart == 0);
mm.isBias = false;mm.kDirectionAlign = false;
mm.fmOffset = 0;mm.enSsparse = false;
mm.enWinogradA = false;mm.enWinogradB = false;
if(globalKstart != 0 &&(mpad / 16)*(npad / 16)< 10)PipeBarrier<PIPE_M>();
Mmad<int32_t,int8_t,int8_t>(bC_.Get<int32_t>(),
bA2_.Get<int8_t>()[a2Offset],
bB2_.Get<int8_t>()[abBank * l0k_ * width_],mm);
SetFlag<HardEvent::M_MTE1>(abFree);
}
}
if(!PARTIAL && sequence >= SLOTS)CrossCoreWaitFlag<2>(FREE_BASE + ringSlot);
FixpipeParamsV220 fp;
fp.nSize = npad;fp.mSize = mpad;
fp.srcStride = mpad;fp.dstStride = width_;
fp.quantPre = QuantMode_t::NoQuant;fp.deqScalar = 0;
fp.ndNum = 1;fp.srcNdStride = 0;fp.dstNdStride = 0;
fp.reluEn = false;fp.unitFlag = 3;fp.isChannelSplit = false;
const uint64_t slotBase = PARTIAL ? static_cast<uint64_t>(sequence)* bm_ * width_
:(static_cast<uint64_t>(producerId_)* SLOTS + ringSlot)* bm_ * width_;
Fixpipe<int32_t,int32_t,CFG_ROW_MAJOR>(ringGm_[slotBase],bC_.Get<int32_t>(),fp);
if(!PARTIAL)CrossCoreSetFlag<2,PIPE_FIX>(READY_BASE + ringSlot);
}
__aicore__ inline void PostCompute(uint32_t produced){
if(mode_ == FULL_A)WaitFlag<HardEvent::MTE1_MTE2>(aFree_);
WaitFlag<HardEvent::MTE1_MTE2>(bFree0_);
WaitFlag<HardEvent::M_MTE1>(abFree0_);
WaitFlag<HardEvent::MTE1_MTE2>(bFree1_);
WaitFlag<HardEvent::M_MTE1>(abFree1_);
WaitFlag<HardEvent::MTE1_MTE2>(bFree2_);
if(produced != 0){
SetFlag<HardEvent::FIX_M>(cFree_);
WaitFlag<HardEvent::FIX_M>(cFree_);
}
if(!PARTIAL){
const uint32_t first = produced > SLOTS ? produced - SLOTS : 0;
for(uint32_t sequence = first;sequence < produced;++sequence)
CrossCoreWaitFlag<2>(FREE_BASE + sequence % SLOTS);
}
PipeBarrier<PIPE_ALL>();
SetMMColumnMajor();
if(mode_ == FULL_A){
pipe_.ReleaseEventID<HardEvent::MTE2_MTE1>(aReady_);
pipe_.ReleaseEventID<HardEvent::MTE1_MTE2>(aFree_);
}
pipe_.ReleaseEventID<HardEvent::MTE2_MTE1>(bReady0_);
pipe_.ReleaseEventID<HardEvent::MTE1_MTE2>(bFree0_);
pipe_.ReleaseEventID<HardEvent::MTE1_M>(abReady0_);
pipe_.ReleaseEventID<HardEvent::M_MTE1>(abFree0_);
pipe_.ReleaseEventID<HardEvent::MTE2_MTE1>(bReady1_);
pipe_.ReleaseEventID<HardEvent::MTE1_MTE2>(bFree1_);
pipe_.ReleaseEventID<HardEvent::MTE1_M>(abReady1_);
pipe_.ReleaseEventID<HardEvent::M_MTE1>(abFree1_);
pipe_.ReleaseEventID<HardEvent::MTE2_MTE1>(bReady2_);
pipe_.ReleaseEventID<HardEvent::MTE1_MTE2>(bFree2_);
pipe_.ReleaseEventID<HardEvent::FIX_M>(cFree_);
}
private:
TPipe& pipe_;
TBuf<TPosition::A1> bA1_;
TBuf<TPosition::B1> bB1_;
TBuf<TPosition::A2> bA2_;
TBuf<TPosition::B2> bB2_;
TBuf<TPosition::CO1> bC_;
GlobalTensor<int8_t> xGm_,wGm_;
GlobalTensor<int8_t> nzGm_;
GlobalTensor<int32_t> ringGm_;
TEventID aReady_,aFree_,bReady0_,bReady1_,bReady2_,bFree0_,bFree1_,bFree2_;
TEventID abReady0_,abReady1_,abFree0_,abFree1_,cFree_;
uint32_t k_,kPad_,n_,producerId_,bk_,bm_,width_,l0k_,mode_;
union{uint32_t tcChunks_;uint32_t fullK_;};
uint32_t tcNPad_;
bool aPending_;
bool tcOn_ = false;
};
template<bool PARTIAL = false,bool RESIDENT_A = false,bool PADDED_A = false>
class OpposedActivationInputProducer{
public:
__aicore__ inline OpposedActivationInputProducer(TPipe& pipe): pipe_(pipe){}
__aicore__ inline void Init(GM_ADDR x,GM_ADDR weight,GM_ADDR ring,
uint32_t k,uint32_t n,uint32_t producerId,uint32_t bm,uint32_t width,
uint32_t l0k,uint32_t bk,uint32_t mode,uint32_t fullK = 0){
xGm_.SetGlobalBuffer((__gm__ int8_t*)x);
wGm_.SetGlobalBuffer((__gm__ int8_t*)weight);
ringGm_.SetGlobalBuffer((__gm__ int32_t*)ring);
constexpr uint32_t kAlignment = PADDED_A ? 256 : 32;
k_ = k;kPad_ =(k + kAlignment - 1)/ kAlignment * kAlignment;
n_ = n;producerId_ = producerId;bk_ = bk;
bm_ = bm;width_ = width;l0k_ = l0k;mode_ = mode;aPending_ = false;primed_ = false;reusePrime_ = false;
tcChunks_ = gmg_tc::ChunksOf(k_,bk_);
tcNPad_ = gmg_tc::NPadOf(n_);
if(PARTIAL)fullK_ = fullK;
SetMMRowMajor();
if(bm_ >= 256){
SetLoadDataRepeat({0,1,0});
SetLoadDataPaddingValue(int8_t(0));
}
pipe_.InitBuffer(bA1_,mode_ == FULL_A ? bm_ * kPad_ : 2 * bm_ * bk_);
pipe_.InitBuffer(bB1_,4 * bk_ * width_);
pipe_.InitBuffer(bA2_,RESIDENT_A ? bm_ * kPad_ : 2 * bm_ * l0k_);
pipe_.InitBuffer(bB2_,2 * l0k_ * width_);
pipe_.InitBuffer(bC_,bm_ * width_ * sizeof(int32_t));
if(mode_ == FULL_A){
aReady_ = pipe_.AllocEventID<HardEvent::MTE2_MTE1>();
aFree_ = pipe_.AllocEventID<HardEvent::MTE1_MTE2>();
SetFlag<HardEvent::MTE1_MTE2>(aFree_);
}
for(uint32_t bank = 0;bank < 4;++bank){
bReady_[bank]= pipe_.AllocEventID<HardEvent::MTE2_MTE1>();
bFree_[bank]= pipe_.AllocEventID<HardEvent::MTE1_MTE2>();
SetFlag<HardEvent::MTE1_MTE2>(bFree_[bank]);
}
for(uint32_t bank = 0;bank < 2;++bank){
abReady_[bank]= pipe_.AllocEventID<HardEvent::MTE1_M>();
abFree_[bank]= pipe_.AllocEventID<HardEvent::M_MTE1>();
SetFlag<HardEvent::M_MTE1>(abFree_[bank]);
}
cFree_ = pipe_.AllocEventID<HardEvent::FIX_M>();
}
__aicore__ inline void SelectPartition(GM_ADDR x,GM_ADDR weight,uint32_t length){
xGm_.SetGlobalBuffer((__gm__ int8_t*)x);
wGm_.SetGlobalBuffer((__gm__ int8_t*)weight);
k_ = length;kPad_ =(length + 31)/ 32 * 32;
}
__aicore__ inline void SetTranscode(GM_ADDR image,uint32_t on){
tcOn_ =(on != 0)&&(mode_ == STREAM);
nzGm_.SetGlobalBuffer((__gm__ int8_t*)image);
}
__aicore__ inline bool TranscodeOn()const{return tcOn_;}
__aicore__ inline void PrimeActivation(GM_ADDR groups,uint32_t e,uint32_t ownerG){
if(mode_ != FULL_A)return;
const uint32_t nTiles =(n_ + width_ - 1)/ width_;
const uint32_t owners =(nTiles + ownerG - 1)/ ownerG;
const uint32_t expert = producerId_ / owners;
if(expert >= e)return;
GlobalTensor<int64_t> endpoints;
endpoints.SetGlobalBuffer((__gm__ int64_t*)groups);
const uint32_t start = expert == 0 ? 0 : static_cast<uint32_t>(endpoints.GetValue(expert - 1));
const uint32_t end = static_cast<uint32_t>(endpoints.GetValue(expert));
if(end - start != bm_)return;
const uint32_t col =(producerId_ % owners)* ownerG * width_;
const TaskDesc task ={expert,start,col,bm_,n_ - col < width_ ? n_ - col : width_};
WaitFlag<HardEvent::MTE1_MTE2>(aFree_);
PrefetchActivation(task);
primedRow_ = start;primedRows_ = bm_;primed_ = true;
}
__aicore__ inline void DropUnusedPrime(){
if(!primed_)return;
WaitFlag<HardEvent::MTE2_MTE1>(aReady_);
SetFlag<HardEvent::MTE1_MTE2>(aFree_);
primed_ = false;
}
__aicore__ inline void BeginOwner(uint32_t row,uint32_t rows){
if(mode_ != FULL_A)return;
if(primed_ && primedRow_ == row && primedRows_ == rows){
primed_ = false;reusePrime_ = true;aPending_ = true;
return;
}
DropUnusedPrime();
WaitFlag<HardEvent::MTE1_MTE2>(aFree_);
aPending_ = true;
}
__aicore__ inline void PrefetchActivation(const TaskDesc& task){
const uint32_t mpad =(task.validM + 15)/ 16 * 16;
const uint32_t cut =((task.validM + 1)/ 2 + 15)/ 16 * 16;
const uint32_t pitch = PARTIAL ? fullK_ :(PADDED_A ? kPad_ : k_);
Nd2NzParams a;
a.ndNum = 1;a.dValue = PADDED_A ? kPad_ : k_;
a.srcNdMatrixStride = 0;a.srcDValue = pitch;
a.dstNzC0Stride = mpad;a.dstNzNStride = 1;a.dstNzMatrixStride = 0;
if(cut >= task.validM){
a.nValue = task.validM;
DataCopy(bA1_.Get<int8_t>(),xGm_[static_cast<uint64_t>(task.row)* pitch],a);
}else{
const bool reverse = task.col >= n_ / 2;
for(uint32_t step = 0;step < 2;++step){
const bool upper =(step != 0)!= reverse;
const uint32_t first = upper ? cut : 0;
a.nValue = upper ? task.validM - cut : cut;
DataCopy(bA1_.Get<int8_t>()[first * 32],
xGm_[static_cast<uint64_t>(task.row + first)* pitch],a);
}
}
if(mpad > task.validM){
Fill<uint32_t>(bA1_.Get<uint32_t>()[task.validM * 8],
{static_cast<uint16_t>(kPad_ / 32),static_cast<uint16_t>(mpad - task.validM),
static_cast<uint16_t>(task.validM),0u});
}
SetFlag<HardEvent::MTE2_MTE1>(aReady_);
}
__aicore__ inline void Prefetch(const TaskDesc& task,uint32_t q,uint32_t bank){
WaitFlag<HardEvent::MTE1_MTE2>(bFree_[bank]);
const uint32_t remaining = k_ - q * bk_;
const uint32_t qActual = remaining < bk_ ? remaining : bk_;
const uint32_t qPadK =(qActual + 31)/ 32 * 32;
const uint32_t npad =(task.validN + 31)/ 32 * 32;
if(mode_ == STREAM){
const uint32_t mpad =(task.validM + 15)/ 16 * 16;
Nd2NzParams a;
a.ndNum = 1;a.nValue = task.validM;a.dValue = qActual;
a.srcNdMatrixStride = 0;a.srcDValue = PARTIAL ? fullK_ : k_;
a.dstNzC0Stride = mpad;a.dstNzNStride = 1;a.dstNzMatrixStride = 0;
DataCopy(bA1_.Get<int8_t>()[bank * bm_ * bk_],
xGm_[static_cast<uint64_t>(task.row)*(PARTIAL ? fullK_ : k_)+ static_cast<uint64_t>(q)* bk_],a);
if(mpad > task.validM){
Fill<uint32_t>(bA1_.Get<uint32_t>()[bank * bm_ * bk_ / 4 + task.validM * 8],
{static_cast<uint16_t>(qPadK / 32),static_cast<uint16_t>(mpad - task.validM),
static_cast<uint16_t>(task.validM),0u});
}
}
if(tcOn_){
const uint32_t npadT =(task.validN + 31)/ 32 * 32;
const uint32_t qPadKt =(qActual + 31)/ 32 * 32;
const uint64_t base = static_cast<uint64_t>(task.expert)* tcChunks_ * bk_ * tcNPad_
+ static_cast<uint64_t>(q)* bk_ * tcNPad_
+ static_cast<uint64_t>(task.col)* qPadKt;
DataCopy(bB1_.Get<int8_t>()[bank * bk_ * width_],nzGm_[base],qPadKt * npadT);
if(qPadKt > qActual){
Fill<uint32_t>(bB1_.Get<uint32_t>()[bank * bk_ * width_ / 4 + qActual * 8],
{static_cast<uint16_t>(npadT / 32),static_cast<uint16_t>(qPadKt - qActual),
static_cast<uint16_t>(qActual),0u});
}
SetFlag<HardEvent::MTE2_MTE1>(bReady_[bank]);
return;
}
Nd2NzParams b;
b.ndNum = 1;b.nValue = qActual;b.dValue = task.validN;
b.srcNdMatrixStride = 0;b.srcDValue = n_;
b.dstNzC0Stride = qPadK;b.dstNzNStride = 1;b.dstNzMatrixStride = 0;
DataCopy(bB1_.Get<int8_t>()[bank * bk_ * width_],
wGm_[static_cast<uint64_t>(task.expert)*(PARTIAL ? fullK_ : k_)* n_
+ static_cast<uint64_t>(q)* bk_ * n_ + task.col],b);
if(qPadK > qActual){
Fill<uint32_t>(bB1_.Get<uint32_t>()[bank * bk_ * width_ / 4 + qActual * 8],
{static_cast<uint16_t>(npad / 32),static_cast<uint16_t>(qPadK - qActual),
static_cast<uint16_t>(qActual),0u});
}
SetFlag<HardEvent::MTE2_MTE1>(bReady_[bank]);
}
__aicore__ inline void Produce(const TaskDesc& task,uint32_t sequence,bool lastInOwner){
const uint32_t ringSlot = sequence % SLOTS;
const bool loadA = aPending_;
const uint32_t mpad =(task.validM + 15)/ 16 * 16;
const uint8_t pad[4]={0,0,0,0};
if(mpad >= 256)SetFmatrix(1,static_cast<uint16_t>(mpad),pad,FmatrixMode::FMATRIX_LEFT);
const uint32_t npad =(task.validN + 31)/ 32 * 32;
const uint32_t chunks =(k_ + bk_ - 1)/ bk_;
if(aPending_ && !reusePrime_)PrefetchActivation(task);
const uint32_t initial = chunks < 4 ? chunks : 4;
for(uint32_t q = 0;q < initial;++q)Prefetch(task,q,q);
if(aPending_){
WaitFlag<HardEvent::MTE2_MTE1>(aReady_);
aPending_ = false;reusePrime_ = false;
}
for(uint32_t q = 0;q < chunks;++q){
const uint32_t bBank = q % 4;
const uint32_t remaining = k_ - q * bk_;
const uint32_t qActual = remaining < bk_ ? remaining : bk_;
WaitFlag<HardEvent::MTE2_MTE1>(bReady_[bBank]);
const uint32_t qPadK =(qActual + 31)/ 32 * 32;
const uint32_t slices =(qActual + l0k_ - 1)/ l0k_;
for(uint32_t s = 0;s < slices;++s){
const uint32_t remainingSlice = qActual - s * l0k_;
const uint32_t validSlice = remainingSlice < l0k_ ? remainingSlice : l0k_;
const uint32_t kPad =(validSlice + 31)/ 32 * 32;
const uint32_t globalKstart = q * bk_ + s * l0k_;
const uint32_t abBank =(globalKstart / l0k_)% 2;
WaitFlag<HardEvent::M_MTE1>(abFree_[abBank]);
const uint32_t a2Offset = RESIDENT_A
? globalKstart * bm_ : abBank * bm_ * l0k_;
const uint64_t aOffset = mode_ == FULL_A
? static_cast<uint64_t>(globalKstart)* mpad
: static_cast<uint64_t>(bBank)* bm_ * bk_ + static_cast<uint64_t>(s)* l0k_ * mpad;
if(!RESIDENT_A || loadA){
if(mpad >= 256){
LoadData3DParamsV2<int8_t> ap;
ap.l1H = 1;ap.l1W = mpad;
ap.channelSize = kPad;ap.kExtension = kPad;ap.mExtension = mpad;
LoadData<int8_t,kALoad3dConfig>(bA2_.Get<int8_t>()[a2Offset],
bA1_.Get<int8_t>()[aOffset],ap);
}else{
LoadData2DParams ap;
ap.startIndex = 0;ap.repeatTimes = kPad / 32;ap.srcStride = mpad / 16;
ap.dstGap = 0;ap.ifTranspose = false;ap.sid = 0;ap.addrMode = 0;
for(uint32_t j = 0;j < mpad / 16;++j)
LoadData<int8_t>(bA2_.Get<int8_t>()[a2Offset + j * 16 * kPad],
bA1_.Get<int8_t>()[aOffset + j * 512],ap);
}
}
LoadData2dTransposeParams bp;
bp.startIndex = 0;bp.repeatTimes = npad / 32;bp.srcStride = qPadK / 32;
bp.dstGap = 1;bp.dstFracGap = 0;bp.addrMode = 0;
for(uint32_t i = 0;i < kPad / 32;++i)
LoadDataWithTranspose<int8_t>(bB2_.Get<int8_t>()[abBank * l0k_ * width_ + i * 32 * npad],
bB1_.Get<int8_t>()[bBank * bk_ * width_ + s * l0k_ * 32 + i * 1024],bp);
if(s + 1 == slices)SetFlag<HardEvent::MTE1_MTE2>(bFree_[bBank]);
if(mode_ == FULL_A && lastInOwner && q + 1 == chunks && s + 1 == slices)
SetFlag<HardEvent::MTE1_MTE2>(aFree_);
SetFlag<HardEvent::MTE1_M>(abReady_[abBank]);
WaitFlag<HardEvent::MTE1_M>(abReady_[abBank]);
MmadParams mm;
mm.m = mpad;mm.n = npad;mm.k = kPad;
mm.unitFlag =(q + 1 == chunks && s + 1 == slices)? 3 : 2;
mm.cmatrixSource = false;mm.cmatrixInitVal =(globalKstart == 0);
mm.isBias = false;mm.kDirectionAlign = false;
mm.fmOffset = 0;mm.enSsparse = false;
mm.enWinogradA = false;mm.enWinogradB = false;
if(globalKstart != 0 &&(mpad / 16)*(npad / 16)< 10)PipeBarrier<PIPE_M>();
Mmad<int32_t,int8_t,int8_t>(bC_.Get<int32_t>(),
bA2_.Get<int8_t>()[a2Offset],
bB2_.Get<int8_t>()[abBank * l0k_ * width_],mm);
SetFlag<HardEvent::M_MTE1>(abFree_[abBank]);
}
if(q + 4 < chunks)Prefetch(task,q + 4,bBank);
}
if(!PARTIAL && sequence >= SLOTS)CrossCoreWaitFlag<2>(FREE_BASE + ringSlot);
FixpipeParamsV220 fp;
fp.nSize = npad;fp.mSize = mpad;
fp.srcStride = mpad;fp.dstStride = width_;
fp.quantPre = QuantMode_t::NoQuant;fp.deqScalar = 0;
fp.ndNum = 1;fp.srcNdStride = 0;fp.dstNdStride = 0;
fp.reluEn = false;fp.unitFlag = 3;fp.isChannelSplit = false;
const uint64_t slotBase = PARTIAL ? static_cast<uint64_t>(sequence)* bm_ * width_
:(static_cast<uint64_t>(producerId_)* SLOTS + ringSlot)* bm_ * width_;
Fixpipe<int32_t,int32_t,CFG_ROW_MAJOR>(ringGm_[slotBase],bC_.Get<int32_t>(),fp);
if(!PARTIAL)CrossCoreSetFlag<2,PIPE_FIX>(READY_BASE + ringSlot);
}
__aicore__ inline void PostCompute(uint32_t produced){
DropUnusedPrime();
if(mode_ == FULL_A)WaitFlag<HardEvent::MTE1_MTE2>(aFree_);
for(uint32_t bank = 0;bank < 4;++bank)
WaitFlag<HardEvent::MTE1_MTE2>(bFree_[bank]);
for(uint32_t bank = 0;bank < 2;++bank)
WaitFlag<HardEvent::M_MTE1>(abFree_[bank]);
if(produced != 0){
SetFlag<HardEvent::FIX_M>(cFree_);
WaitFlag<HardEvent::FIX_M>(cFree_);
}
if(!PARTIAL){
const uint32_t first = produced > SLOTS ? produced - SLOTS : 0;
for(uint32_t sequence = first;sequence < produced;++sequence)
CrossCoreWaitFlag<2>(FREE_BASE + sequence % SLOTS);
}
PipeBarrier<PIPE_ALL>();
SetMMColumnMajor();
if(mode_ == FULL_A){
pipe_.ReleaseEventID<HardEvent::MTE2_MTE1>(aReady_);
pipe_.ReleaseEventID<HardEvent::MTE1_MTE2>(aFree_);
}
for(uint32_t bank = 0;bank < 4;++bank){
pipe_.ReleaseEventID<HardEvent::MTE2_MTE1>(bReady_[bank]);
pipe_.ReleaseEventID<HardEvent::MTE1_MTE2>(bFree_[bank]);
}
for(uint32_t bank = 0;bank < 2;++bank){
pipe_.ReleaseEventID<HardEvent::MTE1_M>(abReady_[bank]);
pipe_.ReleaseEventID<HardEvent::M_MTE1>(abFree_[bank]);
}
pipe_.ReleaseEventID<HardEvent::FIX_M>(cFree_);
}
private:
TPipe& pipe_;
TBuf<TPosition::A1> bA1_;
TBuf<TPosition::B1> bB1_;
TBuf<TPosition::A2> bA2_;
TBuf<TPosition::B2> bB2_;
TBuf<TPosition::CO1> bC_;
GlobalTensor<int8_t> xGm_,wGm_;
GlobalTensor<int8_t> nzGm_;
GlobalTensor<int32_t> ringGm_;
TEventID aReady_,aFree_,bReady_[4],bFree_[4],abReady_[2],abFree_[2],cFree_;
uint32_t k_,kPad_,n_,producerId_,bk_,bm_,width_,l0k_,mode_;
union{uint32_t tcChunks_;uint32_t fullK_;};
uint32_t tcNPad_;
uint32_t primedRow_,primedRows_;
bool aPending_,primed_,reusePrime_;
bool tcOn_ = false;
};
class OwnerLookaheadProducer{
public:
__aicore__ inline OwnerLookaheadProducer(TPipe& pipe): pipe_(pipe){}
__aicore__ inline void Init(GM_ADDR x,GM_ADDR weight,GM_ADDR ring,
uint32_t k,uint32_t n,uint32_t producerId,uint32_t bm,uint32_t width,
uint32_t l0k,uint32_t bk){
xGm_.SetGlobalBuffer((__gm__ int8_t*)x);
wGm_.SetGlobalBuffer((__gm__ int8_t*)weight);
ringGm_.SetGlobalBuffer((__gm__ int32_t*)ring);
k_ = k;kPad_ =(k + 31)/ 32 * 32;n_ = n;producerId_ = producerId;
bm_ = bm;width_ = width;l0k_ = l0k;bk_ = bk;
SetMMRowMajor();
if(bm_ >= 256){
SetLoadDataRepeat({0,1,0});
SetLoadDataPaddingValue(int8_t(0));
}
pipe_.InitBuffer(bA1_,2 * bm_ * kPad_);
pipe_.InitBuffer(bB1_,2 * bk_ * width_);
pipe_.InitBuffer(bA2_,2 * bm_ * l0k_);
pipe_.InitBuffer(bB2_,2 * l0k_ * width_);
pipe_.InitBuffer(bC_,bm_ * width_ * sizeof(int32_t));
for(uint32_t bank = 0;bank < 2;++bank){
aReady_[bank]= pipe_.AllocEventID<HardEvent::MTE2_MTE1>();
aFree_[bank]= pipe_.AllocEventID<HardEvent::MTE1_MTE2>();
bReady_[bank]= pipe_.AllocEventID<HardEvent::MTE2_MTE1>();
bFree_[bank]= pipe_.AllocEventID<HardEvent::MTE1_MTE2>();
abReady_[bank]= pipe_.AllocEventID<HardEvent::MTE1_M>();
abFree_[bank]= pipe_.AllocEventID<HardEvent::M_MTE1>();
SetFlag<HardEvent::MTE1_MTE2>(aFree_[bank]);
SetFlag<HardEvent::MTE1_MTE2>(bFree_[bank]);
SetFlag<HardEvent::M_MTE1>(abFree_[bank]);
}
cFree_ = pipe_.AllocEventID<HardEvent::FIX_M>();
}
__aicore__ inline void BeginOwner(uint32_t,uint32_t){startsOwner_ = true;}
__aicore__ inline void Produce(const TaskDesc& task,uint32_t sequence,bool lastInOwner){
if(hasPending_){
Compute(&task,startsOwner_);
}else{
PrefetchA(task,aBank_);
Prefetch(task,0,0);
Prefetch(task,1,1);
}
pending_ = task;
pendingSequence_ = sequence;
pendingLast_ = lastInOwner;
pendingStartsOwner_ = startsOwner_;
startsOwner_ = false;
hasPending_ = true;
}
__aicore__ inline void PostCompute(uint32_t produced){
if(hasPending_)Compute(nullptr,false);
for(uint32_t bank = 0;bank < 2;++bank){
WaitFlag<HardEvent::MTE1_MTE2>(aFree_[bank]);
WaitFlag<HardEvent::MTE1_MTE2>(bFree_[bank]);
WaitFlag<HardEvent::M_MTE1>(abFree_[bank]);
}
if(produced != 0){
SetFlag<HardEvent::FIX_M>(cFree_);
WaitFlag<HardEvent::FIX_M>(cFree_);
}
const uint32_t first = produced > SLOTS ? produced - SLOTS : 0;
for(uint32_t sequence = first;sequence < produced;++sequence)
CrossCoreWaitFlag<2>(FREE_BASE + sequence % SLOTS);
PipeBarrier<PIPE_ALL>();
SetMMColumnMajor();
for(uint32_t bank = 0;bank < 2;++bank){
pipe_.ReleaseEventID<HardEvent::MTE2_MTE1>(aReady_[bank]);
pipe_.ReleaseEventID<HardEvent::MTE1_MTE2>(aFree_[bank]);
pipe_.ReleaseEventID<HardEvent::MTE2_MTE1>(bReady_[bank]);
pipe_.ReleaseEventID<HardEvent::MTE1_MTE2>(bFree_[bank]);
pipe_.ReleaseEventID<HardEvent::MTE1_M>(abReady_[bank]);
pipe_.ReleaseEventID<HardEvent::M_MTE1>(abFree_[bank]);
}
pipe_.ReleaseEventID<HardEvent::FIX_M>(cFree_);
}
private:
__aicore__ inline void PrefetchA(const TaskDesc& task,uint32_t bank){
WaitFlag<HardEvent::MTE1_MTE2>(aFree_[bank]);
const uint32_t mpad =(task.validM + 15)/ 16 * 16;
Nd2NzParams a;
a.ndNum = 1;a.nValue = task.validM;a.dValue = k_;
a.srcNdMatrixStride = 0;a.srcDValue = k_;
a.dstNzC0Stride = mpad;a.dstNzNStride = 1;a.dstNzMatrixStride = 0;
DataCopy(bA1_.Get<int8_t>()[bank * bm_ * kPad_],
xGm_[static_cast<uint64_t>(task.row)* k_],a);
if(mpad > task.validM){
Fill<uint32_t>(bA1_.Get<uint32_t>()[bank * bm_ * kPad_ / 4 + task.validM * 8],
{static_cast<uint16_t>(kPad_ / 32),static_cast<uint16_t>(mpad - task.validM),
static_cast<uint16_t>(task.validM),0u});
}
SetFlag<HardEvent::MTE2_MTE1>(aReady_[bank]);
}
__aicore__ inline void Prefetch(const TaskDesc& task,uint32_t q,uint32_t bank){
WaitFlag<HardEvent::MTE1_MTE2>(bFree_[bank]);
const uint32_t remaining = k_ - q * bk_;
const uint32_t qActual = remaining < bk_ ? remaining : bk_;
const uint32_t qPadK =(qActual + 31)/ 32 * 32;
const uint32_t npad =(task.validN + 31)/ 32 * 32;
Nd2NzParams b;
b.ndNum = 1;b.nValue = qActual;b.dValue = task.validN;
b.srcNdMatrixStride = 0;b.srcDValue = n_;
b.dstNzC0Stride = qPadK;b.dstNzNStride = 1;b.dstNzMatrixStride = 0;
DataCopy(bB1_.Get<int8_t>()[bank * bk_ * width_],
wGm_[static_cast<uint64_t>(task.expert)* k_ * n_
+ static_cast<uint64_t>(q)* bk_ * n_ + task.col],b);
if(qPadK > qActual){
Fill<uint32_t>(bB1_.Get<uint32_t>()[bank * bk_ * width_ / 4 + qActual * 8],
{static_cast<uint16_t>(npad / 32),static_cast<uint16_t>(qPadK - qActual),
static_cast<uint16_t>(qActual),0u});
}
SetFlag<HardEvent::MTE2_MTE1>(bReady_[bank]);
}
__aicore__ inline void Compute(const TaskDesc* next,bool nextStartsOwner){
const TaskDesc& task = pending_;
const uint32_t sequence = pendingSequence_;
const bool lastInOwner = pendingLast_;
const uint32_t ringSlot = sequence % SLOTS;
const uint32_t mpad =(task.validM + 15)/ 16 * 16;
const uint8_t pad[4]={0,0,0,0};
if(mpad >= 256)SetFmatrix(1,static_cast<uint16_t>(mpad),pad,FmatrixMode::FMATRIX_LEFT);
const uint32_t npad =(task.validN + 31)/ 32 * 32;
const uint32_t chunks =(k_ + bk_ - 1)/ bk_;
if(pendingStartsOwner_)WaitFlag<HardEvent::MTE2_MTE1>(aReady_[aBank_]);
if(nextStartsOwner && chunks == 2)PrefetchA(*next,aBank_ ^ 1);
for(uint32_t q = 0;q < chunks;++q){
const uint32_t bBank = q % 2;
const uint32_t remaining = k_ - q * bk_;
const uint32_t qActual = remaining < bk_ ? remaining : bk_;
WaitFlag<HardEvent::MTE2_MTE1>(bReady_[bBank]);
const uint32_t qPadK =(qActual + 31)/ 32 * 32;
const uint32_t slices =(qActual + l0k_ - 1)/ l0k_;
for(uint32_t s = 0;s < slices;++s){
const uint32_t remainingSlice = qActual - s * l0k_;
const uint32_t validSlice = remainingSlice < l0k_ ? remainingSlice : l0k_;
const uint32_t kPad =(validSlice + 31)/ 32 * 32;
const uint32_t globalKstart = q * bk_ + s * l0k_;
const uint32_t abBank =(globalKstart / l0k_)% 2;
WaitFlag<HardEvent::M_MTE1>(abFree_[abBank]);
const uint64_t aOffset = static_cast<uint64_t>(aBank_)* bm_ * kPad_
+ static_cast<uint64_t>(globalKstart)* mpad;
if(mpad >= 256){
LoadData3DParamsV2<int8_t> ap;
ap.l1H = 1;ap.l1W = mpad;
ap.channelSize = kPad;ap.kExtension = kPad;ap.mExtension = mpad;
LoadData<int8_t,kALoad3dConfig>(bA2_.Get<int8_t>()[abBank * bm_ * l0k_],
bA1_.Get<int8_t>()[aOffset],ap);
}else{
LoadData2DParams ap;
ap.startIndex = 0;ap.repeatTimes = kPad / 32;ap.srcStride = mpad / 16;
ap.dstGap = 0;ap.ifTranspose = false;ap.sid = 0;ap.addrMode = 0;
for(uint32_t j = 0;j < mpad / 16;++j)
LoadData<int8_t>(bA2_.Get<int8_t>()[abBank * bm_ * l0k_ + j * 16 * kPad],
bA1_.Get<int8_t>()[aOffset + j * 512],ap);
}
LoadData2dTransposeParams bp;
bp.startIndex = 0;bp.repeatTimes = npad / 32;bp.srcStride = qPadK / 32;
bp.dstGap = 1;bp.dstFracGap = 0;bp.addrMode = 0;
for(uint32_t i = 0;i < kPad / 32;++i)
LoadDataWithTranspose<int8_t>(bB2_.Get<int8_t>()[abBank * l0k_ * width_ + i * 32 * npad],
bB1_.Get<int8_t>()[bBank * bk_ * width_ + s * l0k_ * 32 + i * 1024],bp);
if(s + 1 == slices)SetFlag<HardEvent::MTE1_MTE2>(bFree_[bBank]);
if(lastInOwner && q + 1 == chunks && s + 1 == slices)
SetFlag<HardEvent::MTE1_MTE2>(aFree_[aBank_]);
SetFlag<HardEvent::MTE1_M>(abReady_[abBank]);
WaitFlag<HardEvent::MTE1_M>(abReady_[abBank]);
MmadParams mm;
mm.m = mpad;mm.n = npad;mm.k = kPad;
mm.unitFlag =(q + 1 == chunks && s + 1 == slices)? 3 : 2;
mm.cmatrixSource = false;mm.cmatrixInitVal =(globalKstart == 0);
mm.isBias = false;mm.kDirectionAlign = false;
mm.fmOffset = 0;mm.enSsparse = false;
mm.enWinogradA = false;mm.enWinogradB = false;
if(globalKstart != 0 &&(mpad / 16)*(npad / 16)< 10)PipeBarrier<PIPE_M>();
Mmad<int32_t,int8_t,int8_t>(bC_.Get<int32_t>(),
bA2_.Get<int8_t>()[abBank * bm_ * l0k_],
bB2_.Get<int8_t>()[abBank * l0k_ * width_],mm);
SetFlag<HardEvent::M_MTE1>(abFree_[abBank]);
}
if(q + 2 < chunks){
Prefetch(task,q + 2,bBank);
}else if(next != nullptr){
Prefetch(*next,q + 2 - chunks,bBank);
}
if(nextStartsOwner && q + 3 == chunks)PrefetchA(*next,aBank_ ^ 1);
}
if(sequence >= SLOTS)CrossCoreWaitFlag<2>(FREE_BASE + ringSlot);
FixpipeParamsV220 fp;
fp.nSize = npad;fp.mSize = mpad;
fp.srcStride = mpad;fp.dstStride = width_;
fp.quantPre = QuantMode_t::NoQuant;fp.deqScalar = 0;
fp.ndNum = 1;fp.srcNdStride = 0;fp.dstNdStride = 0;
fp.reluEn = false;fp.unitFlag = 3;fp.isChannelSplit = false;
const uint64_t slotBase =(static_cast<uint64_t>(producerId_)* SLOTS
+ ringSlot)* bm_ * width_;
Fixpipe<int32_t,int32_t,CFG_ROW_MAJOR>(ringGm_[slotBase],bC_.Get<int32_t>(),fp);
CrossCoreSetFlag<2,PIPE_FIX>(READY_BASE + ringSlot);
if(nextStartsOwner)aBank_ ^= 1;
}
private:
TPipe& pipe_;
TBuf<TPosition::A1> bA1_;
TBuf<TPosition::B1> bB1_;
TBuf<TPosition::A2> bA2_;
TBuf<TPosition::B2> bB2_;
TBuf<TPosition::CO1> bC_;
GlobalTensor<int8_t> xGm_,wGm_;
GlobalTensor<int32_t> ringGm_;
TEventID aReady_[2],aFree_[2],bReady_[2],bFree_[2],abReady_[2],abFree_[2],cFree_;
uint32_t k_,kPad_,n_,producerId_,bk_,bm_,width_,l0k_;
TaskDesc pending_;
uint32_t pendingSequence_,aBank_ = 0;
bool pendingLast_,pendingStartsOwner_;
bool hasPending_ = false,startsOwner_ = false;
};
template<bool PARTIAL = false,bool FOUR_B = false>
class PaddedWeightProducer{
public:
static constexpr uint32_t kWeightGroups = FOUR_B ? 4 : 2;
__aicore__ inline PaddedWeightProducer(TPipe& pipe): pipe_(pipe){}
__aicore__ inline void Init(GM_ADDR x,GM_ADDR weight,GM_ADDR ring,
uint32_t k,uint32_t n,uint32_t producerId,uint32_t bm,uint32_t width,
uint32_t l0k,uint32_t bk,uint32_t mode,uint32_t fullK = 0){
xGm_.SetGlobalBuffer((__gm__ int8_t*)x);
wGm_.SetGlobalBuffer((__gm__ int8_t*)weight);
ringGm_.SetGlobalBuffer((__gm__ int32_t*)ring);
weightPitch_ =(n + 31)/ 32 * 32;
k_ = k;kPad_ =(k + 31)/ 32 * 32;n_ = n;producerId_ = producerId;bk_ = bk;
bm_ = bm;width_ = width;l0k_ = l0k;aPending_ = false;weightReadyPending_ = true;
if(PARTIAL)fullK_ = fullK;
SetMMRowMajor();
if(bm_ >= 256){
SetLoadDataRepeat({0,1,0});
SetLoadDataPaddingValue(int8_t(0));
}
pipe_.InitBuffer(bA1_,bm_ * kPad_);
pipe_.InitBuffer(bB1_,kWeightGroups * bk_ * width_);
pipe_.InitBuffer(bA2_,2 * bm_ * l0k_);
pipe_.InitBuffer(bB2_,2 * l0k_ * width_);
pipe_.InitBuffer(bC_,bm_ * width_ * sizeof(int32_t));

aReady_ = pipe_.AllocEventID<HardEvent::MTE2_MTE1>();
aFree_ = pipe_.AllocEventID<HardEvent::MTE1_MTE2>();
SetFlag<HardEvent::MTE1_MTE2>(aFree_);

for(uint32_t bank = 0;bank < 2;++bank){
bReady_[bank]= pipe_.AllocEventID<HardEvent::MTE2_MTE1>();
bFree_[bank]= pipe_.AllocEventID<HardEvent::MTE1_MTE2>();
abReady_[bank]= pipe_.AllocEventID<HardEvent::MTE1_M>();
abFree_[bank]= pipe_.AllocEventID<HardEvent::M_MTE1>();
SetFlag<HardEvent::MTE1_MTE2>(bFree_[bank]);
SetFlag<HardEvent::M_MTE1>(abFree_[bank]);
}
if constexpr(FOUR_B){
for(uint32_t bank = 2;bank < kWeightGroups;++bank){
bReady_[bank]= pipe_.AllocEventID<HardEvent::MTE2_MTE1>();
bFree_[bank]= pipe_.AllocEventID<HardEvent::MTE1_MTE2>();
SetFlag<HardEvent::MTE1_MTE2>(bFree_[bank]);
}
}
cFree_ = pipe_.AllocEventID<HardEvent::FIX_M>();
}
__aicore__ inline void SetDirectWeight(GM_ADDR weight){
wGm_.SetGlobalBuffer((__gm__ int8_t*)weight);weightPitch_=n_;weightReadyPending_=false;
}
__aicore__ inline void SelectPartition(GM_ADDR x,GM_ADDR weight,uint32_t length){
xGm_.SetGlobalBuffer((__gm__ int8_t*)x);
wGm_.SetGlobalBuffer((__gm__ int8_t*)weight);
k_ = length;kPad_ =(length + 31)/ 32 * 32;
}


__aicore__ inline void BeginOwner(uint32_t row,uint32_t validM){
WaitFlag<HardEvent::MTE1_MTE2>(aFree_);
const uint32_t mpad =(validM + 15)/ 16 * 16;
Nd2NzParams a;
a.ndNum = 1;a.nValue = validM;a.dValue = k_;
a.srcNdMatrixStride = 0;a.srcDValue = PARTIAL ? fullK_ : k_;
a.dstNzC0Stride = mpad;a.dstNzNStride = 1;a.dstNzMatrixStride = 0;
DataCopy(bA1_.Get<int8_t>(),xGm_[static_cast<uint64_t>(row)*(PARTIAL ? fullK_ : k_)],a);
if(mpad > validM){
Fill<uint32_t>(bA1_.Get<uint32_t>()[validM * 8],
{static_cast<uint16_t>(kPad_ / 32),static_cast<uint16_t>(mpad - validM),
static_cast<uint16_t>(validM),0u});
}
SetFlag<HardEvent::MTE2_MTE1>(aReady_);
aPending_ = true;
if(weightReadyPending_){
CrossCoreWaitFlag<2>(5);
weightReadyPending_ = false;
}
}
__aicore__ inline void Prefetch(const TaskDesc& task,uint32_t q,uint32_t bank){
WaitFlag<HardEvent::MTE1_MTE2>(bFree_[bank]);
const uint32_t remaining = k_ - q * bk_;
const uint32_t qActual = remaining < bk_ ? remaining : bk_;
const uint32_t qPadK =(qActual + 31)/ 32 * 32;
const uint32_t npad =(task.validN + 31)/ 32 * 32;


Nd2NzParams b;
b.ndNum = 1;b.nValue = qActual;b.dValue = task.validN;
b.srcNdMatrixStride = 0;b.srcDValue = weightPitch_;
b.dstNzC0Stride = qPadK;b.dstNzNStride = 1;b.dstNzMatrixStride = 0;
DataCopy(bB1_.Get<int8_t>()[bank * bk_ * width_],
wGm_[static_cast<uint64_t>(task.expert)*(PARTIAL ? fullK_ : k_)* weightPitch_
+ static_cast<uint64_t>(q)* bk_ * weightPitch_ + task.col],b);
if(qPadK > qActual){
Fill<uint32_t>(bB1_.Get<uint32_t>()[bank * bk_ * width_ / 4 + qActual * 8],
{static_cast<uint16_t>(npad / 32),static_cast<uint16_t>(qPadK - qActual),
static_cast<uint16_t>(qActual),0u});
}
SetFlag<HardEvent::MTE2_MTE1>(bReady_[bank]);
}
__aicore__ inline void Produce(const TaskDesc& task,uint32_t sequence,bool lastInOwner){
const uint32_t ringSlot = sequence % SLOTS;
const uint32_t mpad =(task.validM + 15)/ 16 * 16;
const uint8_t pad[4]={0,0,0,0};
if(mpad >= 256)SetFmatrix(1,static_cast<uint16_t>(mpad),pad,FmatrixMode::FMATRIX_LEFT);
const uint32_t npad =(task.validN + 31)/ 32 * 32;
const uint32_t chunks =(k_ + bk_ - 1)/ bk_;
const uint32_t initial = chunks < kWeightGroups ? chunks : kWeightGroups;
for(uint32_t q = 0;q < initial;++q)Prefetch(task,q,q);
if(aPending_){
WaitFlag<HardEvent::MTE2_MTE1>(aReady_);
aPending_ = false;
}
for(uint32_t q = 0;q < chunks;++q){
const uint32_t bBank = q % kWeightGroups;
const uint32_t remaining = k_ - q * bk_;
const uint32_t qActual = remaining < bk_ ? remaining : bk_;
WaitFlag<HardEvent::MTE2_MTE1>(bReady_[bBank]);
const uint32_t qPadK =(qActual + 31)/ 32 * 32;
const uint32_t slices =(qActual + l0k_ - 1)/ l0k_;
for(uint32_t s = 0;s < slices;++s){
const uint32_t remainingSlice = qActual - s * l0k_;
const uint32_t validSlice = remainingSlice < l0k_ ? remainingSlice : l0k_;
const uint32_t kPad =(validSlice + 31)/ 32 * 32;
const uint32_t globalKstart = q * bk_ + s * l0k_;
const uint32_t abBank =(globalKstart / l0k_)% 2;
WaitFlag<HardEvent::M_MTE1>(abFree_[abBank]);
const uint64_t aOffset = static_cast<uint64_t>(globalKstart)* mpad;
if(mpad >= 256){
LoadData3DParamsV2<int8_t> ap;
ap.l1H = 1;ap.l1W = mpad;
ap.channelSize = kPad;ap.kExtension = kPad;ap.mExtension = mpad;
LoadData<int8_t,kALoad3dConfig>(bA2_.Get<int8_t>()[abBank * bm_ * l0k_],
bA1_.Get<int8_t>()[aOffset],ap);
}else{
LoadData2DParams ap;
ap.startIndex = 0;ap.repeatTimes = kPad / 32;ap.srcStride = mpad / 16;
ap.dstGap = 0;ap.ifTranspose = false;ap.sid = 0;ap.addrMode = 0;
for(uint32_t j = 0;j < mpad / 16;++j)
LoadData<int8_t>(bA2_.Get<int8_t>()[abBank * bm_ * l0k_ + j * 16 * kPad],
bA1_.Get<int8_t>()[aOffset + j * 512],ap);
}
LoadData2dTransposeParams bp;
bp.startIndex = 0;bp.repeatTimes = npad / 32;bp.srcStride = qPadK / 32;
bp.dstGap = 1;bp.dstFracGap = 0;bp.addrMode = 0;
for(uint32_t i = 0;i < kPad / 32;++i)
LoadDataWithTranspose<int8_t>(bB2_.Get<int8_t>()[abBank * l0k_ * width_ + i * 32 * npad],
bB1_.Get<int8_t>()[bBank * bk_ * width_ + s * l0k_ * 32 + i * 1024],bp);
if(s + 1 == slices)SetFlag<HardEvent::MTE1_MTE2>(bFree_[bBank]);
if(lastInOwner && q + 1 == chunks && s + 1 == slices)
SetFlag<HardEvent::MTE1_MTE2>(aFree_);
SetFlag<HardEvent::MTE1_M>(abReady_[abBank]);
WaitFlag<HardEvent::MTE1_M>(abReady_[abBank]);
MmadParams mm;
mm.m = mpad;mm.n = npad;mm.k = kPad;
mm.unitFlag =(q + 1 == chunks && s + 1 == slices)? 3 : 2;
mm.cmatrixSource = false;mm.cmatrixInitVal =(globalKstart == 0);
mm.isBias = false;mm.kDirectionAlign = false;
mm.fmOffset = 0;mm.enSsparse = false;
mm.enWinogradA = false;mm.enWinogradB = false;
if(globalKstart != 0 &&(mpad / 16)*(npad / 16)< 10)PipeBarrier<PIPE_M>();
Mmad<int32_t,int8_t,int8_t>(bC_.Get<int32_t>(),
bA2_.Get<int8_t>()[abBank * bm_ * l0k_],
bB2_.Get<int8_t>()[abBank * l0k_ * width_],mm);
SetFlag<HardEvent::M_MTE1>(abFree_[abBank]);
}
if(q + kWeightGroups < chunks)Prefetch(task,q + kWeightGroups,bBank);
}
if(!PARTIAL && sequence >= SLOTS)CrossCoreWaitFlag<2>(FREE_BASE + ringSlot);
FixpipeParamsV220 fp;
fp.nSize = npad;fp.mSize = mpad;
fp.srcStride = mpad;fp.dstStride = width_;
fp.quantPre = QuantMode_t::NoQuant;fp.deqScalar = 0;
fp.ndNum = 1;fp.srcNdStride = 0;fp.dstNdStride = 0;
fp.reluEn = false;fp.unitFlag = 3;fp.isChannelSplit = false;
const uint64_t slotBase = PARTIAL ? static_cast<uint64_t>(sequence)* bm_ * width_
:(static_cast<uint64_t>(producerId_)* SLOTS + ringSlot)* bm_ * width_;
Fixpipe<int32_t,int32_t,CFG_ROW_MAJOR>(ringGm_[slotBase],bC_.Get<int32_t>(),fp);
if(!PARTIAL)CrossCoreSetFlag<2,PIPE_FIX>(READY_BASE + ringSlot);
}
__aicore__ inline void PostCompute(uint32_t produced){
if(weightReadyPending_){
CrossCoreWaitFlag<2>(5);
weightReadyPending_ = false;
}
WaitFlag<HardEvent::MTE1_MTE2>(aFree_);
for(uint32_t bank = 0;bank < 2;++bank){
WaitFlag<HardEvent::MTE1_MTE2>(bFree_[bank]);
WaitFlag<HardEvent::M_MTE1>(abFree_[bank]);
}
if constexpr(FOUR_B){
for(uint32_t bank = 2;bank < kWeightGroups;++bank)
WaitFlag<HardEvent::MTE1_MTE2>(bFree_[bank]);
}
if(produced != 0){
SetFlag<HardEvent::FIX_M>(cFree_);
WaitFlag<HardEvent::FIX_M>(cFree_);
}
if(!PARTIAL){
const uint32_t first = produced > SLOTS ? produced - SLOTS : 0;
for(uint32_t sequence = first;sequence < produced;++sequence)
CrossCoreWaitFlag<2>(FREE_BASE + sequence % SLOTS);
}
PipeBarrier<PIPE_ALL>();
SetMMColumnMajor();

pipe_.ReleaseEventID<HardEvent::MTE2_MTE1>(aReady_);
pipe_.ReleaseEventID<HardEvent::MTE1_MTE2>(aFree_);

for(uint32_t bank = 0;bank < 2;++bank){
pipe_.ReleaseEventID<HardEvent::MTE2_MTE1>(bReady_[bank]);
pipe_.ReleaseEventID<HardEvent::MTE1_MTE2>(bFree_[bank]);
pipe_.ReleaseEventID<HardEvent::MTE1_M>(abReady_[bank]);
pipe_.ReleaseEventID<HardEvent::M_MTE1>(abFree_[bank]);
}
if constexpr(FOUR_B){
for(uint32_t bank = 2;bank < kWeightGroups;++bank){
pipe_.ReleaseEventID<HardEvent::MTE2_MTE1>(bReady_[bank]);
pipe_.ReleaseEventID<HardEvent::MTE1_MTE2>(bFree_[bank]);
}
}
pipe_.ReleaseEventID<HardEvent::FIX_M>(cFree_);
}
private:
TPipe& pipe_;
TBuf<TPosition::A1> bA1_;
TBuf<TPosition::B1> bB1_;
TBuf<TPosition::A2> bA2_;
TBuf<TPosition::B2> bB2_;
TBuf<TPosition::CO1> bC_;
GlobalTensor<int8_t> xGm_,wGm_;
GlobalTensor<int32_t> ringGm_;
TEventID aReady_,aFree_,bReady_[kWeightGroups],bFree_[kWeightGroups],abReady_[2],abFree_[2],cFree_;
uint32_t k_,kPad_,n_,producerId_,bk_,bm_,width_,l0k_;
uint32_t fullK_;
uint32_t weightPitch_;
bool aPending_,weightReadyPending_;
};
template<bool ENABLED> struct DequantWeightState{};
template<> struct DequantWeightState<true>{uint32_t weightGroups_;};
template<bool FOUR_B = false>
class DequantProducer : private DequantWeightState<FOUR_B>{
public:
__aicore__ inline DequantProducer(TPipe& pipe): pipe_(pipe){}
__aicore__ inline void Init(GM_ADDR x,GM_ADDR weight,GM_ADDR ring,
uint32_t k,uint32_t n,uint32_t producerId,uint32_t bm,uint32_t width,
uint32_t l0k,uint32_t bk,uint32_t mode,uint32_t reservedWidth = 0,uint32_t a1Reserve = 0){
xGm_.SetGlobalBuffer((__gm__ int8_t*)x);
wGm_.SetGlobalBuffer((__gm__ int8_t*)weight);
ringGm_.SetGlobalBuffer((__gm__ int32_t*)ring);
k_ = k;kPad_ =(k + 31)/ 32 * 32;n_ = n;producerId_ = producerId;bk_ = bk;
bm_ = bm;width_ = width;l0k_ = l0k;mode_ = mode;aPending_ = false;
if constexpr(FOUR_B)this->weightGroups_ = 2;
SetMMRowMajor();
if(bm_ >= 256){
SetLoadDataRepeat({0,1,0});
SetLoadDataPaddingValue(int8_t(0));
}
pipe_.InitBuffer(bA1_,a1Reserve != 0 ? a1Reserve :(bm_ * kPad_));
const uint32_t reservedK = FOUR_B && 4 * 192 > 2 * bk_ ? 4 * 192 : 2 * bk_;
pipe_.InitBuffer(bB1_,reservedK *(reservedWidth != 0 ? reservedWidth : width_));
pipe_.InitBuffer(bA2_,2 * bm_ * l0k_);
pipe_.InitBuffer(bB2_,2 * l0k_ * width_);
pipe_.InitBuffer(bC_,bm_ * width_ * sizeof(int32_t));

aReady_ = pipe_.AllocEventID<HardEvent::MTE2_MTE1>();
aFree_ = pipe_.AllocEventID<HardEvent::MTE1_MTE2>();
SetFlag<HardEvent::MTE1_MTE2>(aFree_);

for(uint32_t bank = 0;bank < 2;++bank){
bReady_[bank]= pipe_.AllocEventID<HardEvent::MTE2_MTE1>();
bFree_[bank]= pipe_.AllocEventID<HardEvent::MTE1_MTE2>();
abReady_[bank]= pipe_.AllocEventID<HardEvent::MTE1_M>();
abFree_[bank]= pipe_.AllocEventID<HardEvent::M_MTE1>();
SetFlag<HardEvent::MTE1_MTE2>(bFree_[bank]);
SetFlag<HardEvent::M_MTE1>(abFree_[bank]);
}
if constexpr(FOUR_B){
for(uint32_t bank = 2;bank < 4;++bank){
bReady_[bank]= pipe_.AllocEventID<HardEvent::MTE2_MTE1>();
bFree_[bank]= pipe_.AllocEventID<HardEvent::MTE1_MTE2>();
SetFlag<HardEvent::MTE1_MTE2>(bFree_[bank]);
}
}
cFree_ = pipe_.AllocEventID<HardEvent::FIX_M>();
}
__aicore__ inline void Retile(uint32_t bm,uint32_t width,uint32_t l0k){
bm_ = bm;width_ = width;l0k_ = l0k;
if constexpr(FOUR_B){bk_ = 192;this->weightGroups_ = 4;}
}


__aicore__ inline void BeginOwner(uint32_t row,uint32_t validM){
WaitFlag<HardEvent::MTE1_MTE2>(aFree_);
const uint32_t mpad =(validM + 15)/ 16 * 16;
Nd2NzParams a;
a.ndNum = 1;a.nValue = validM;a.dValue = k_;
a.srcNdMatrixStride = 0;a.srcDValue = k_;
a.dstNzC0Stride = mpad;a.dstNzNStride = 1;a.dstNzMatrixStride = 0;
DataCopy(bA1_.Get<int8_t>(),xGm_[static_cast<uint64_t>(row)* k_],a);
if(mpad > validM){
Fill<uint32_t>(bA1_.Get<uint32_t>()[validM * 8],
{static_cast<uint16_t>(kPad_ / 32),static_cast<uint16_t>(mpad - validM),
static_cast<uint16_t>(validM),0u});
}
SetFlag<HardEvent::MTE2_MTE1>(aReady_);
aPending_ = true;
}
__aicore__ inline void Prefetch(const TaskDesc& task,uint32_t q,uint32_t bank){
WaitFlag<HardEvent::MTE1_MTE2>(bFree_[bank]);
const uint32_t remaining = k_ - q * bk_;
const uint32_t qActual = remaining < bk_ ? remaining : bk_;
const uint32_t qPadK =(qActual + 31)/ 32 * 32;
const uint32_t npad =(task.validN + 31)/ 32 * 32;


Nd2NzParams b;
b.ndNum = 1;b.nValue = qActual;b.dValue = task.validN;
b.srcNdMatrixStride = 0;b.srcDValue = n_;
b.dstNzC0Stride = qPadK;b.dstNzNStride = 1;b.dstNzMatrixStride = 0;
DataCopy(bB1_.Get<int8_t>()[bank * bk_ * width_],
wGm_[static_cast<uint64_t>(task.expert)* k_ * n_
+ static_cast<uint64_t>(q)* bk_ * n_ + task.col],b);
if(qPadK > qActual){
Fill<uint32_t>(bB1_.Get<uint32_t>()[bank * bk_ * width_ / 4 + qActual * 8],
{static_cast<uint16_t>(npad / 32),static_cast<uint16_t>(qPadK - qActual),
static_cast<uint16_t>(qActual),0u});
}
SetFlag<HardEvent::MTE2_MTE1>(bReady_[bank]);
}
__aicore__ inline void Produce(const TaskDesc& task,uint32_t sequence,bool lastInOwner){
const uint32_t ringSlot = sequence % SLOTS;
const uint32_t mpad =(task.validM + 15)/ 16 * 16;
const uint8_t pad[4]={0,0,0,0};
if(mpad >= 256)SetFmatrix(1,static_cast<uint16_t>(mpad),pad,FmatrixMode::FMATRIX_LEFT);
const uint32_t npad =(task.validN + 31)/ 32 * 32;
const uint32_t chunks =(k_ + bk_ - 1)/ bk_;
uint32_t weightGroups = 2;
if constexpr(FOUR_B)weightGroups = this->weightGroups_;
const uint32_t initial = chunks < weightGroups ? chunks : weightGroups;
for(uint32_t q = 0;q < initial;++q)Prefetch(task,q,q);
if(aPending_){
WaitFlag<HardEvent::MTE2_MTE1>(aReady_);
aPending_ = false;
}
for(uint32_t q = 0;q < chunks;++q){
const uint32_t bBank = q &(weightGroups - 1);
const uint32_t remaining = k_ - q * bk_;
const uint32_t qActual = remaining < bk_ ? remaining : bk_;
WaitFlag<HardEvent::MTE2_MTE1>(bReady_[bBank]);
const uint32_t qPadK =(qActual + 31)/ 32 * 32;
const uint32_t slices =(qActual + l0k_ - 1)/ l0k_;
for(uint32_t s = 0;s < slices;++s){
const uint32_t remainingSlice = qActual - s * l0k_;
const uint32_t validSlice = remainingSlice < l0k_ ? remainingSlice : l0k_;
const uint32_t kPad =(validSlice + 31)/ 32 * 32;
const uint32_t globalKstart = q * bk_ + s * l0k_;
const uint32_t abBank =(globalKstart / l0k_)% 2;
WaitFlag<HardEvent::M_MTE1>(abFree_[abBank]);
const uint64_t aOffset = static_cast<uint64_t>(globalKstart)* mpad;
if(mpad >= 256){
LoadData3DParamsV2<int8_t> ap;
ap.l1H = 1;ap.l1W = mpad;
ap.channelSize = kPad;ap.kExtension = kPad;ap.mExtension = mpad;
LoadData<int8_t,kALoad3dConfig>(bA2_.Get<int8_t>()[abBank * bm_ * l0k_],
bA1_.Get<int8_t>()[aOffset],ap);
}else{
LoadData2DParams ap;
ap.startIndex = 0;ap.repeatTimes = kPad / 32;ap.srcStride = mpad / 16;
ap.dstGap = 0;ap.ifTranspose = false;ap.sid = 0;ap.addrMode = 0;
for(uint32_t j = 0;j < mpad / 16;++j)
LoadData<int8_t>(bA2_.Get<int8_t>()[abBank * bm_ * l0k_ + j * 16 * kPad],
bA1_.Get<int8_t>()[aOffset + j * 512],ap);
}
LoadData2dTransposeParams bp;
bp.startIndex = 0;bp.repeatTimes = npad / 32;bp.srcStride = qPadK / 32;
bp.dstGap = 1;bp.dstFracGap = 0;bp.addrMode = 0;
for(uint32_t i = 0;i < kPad / 32;++i)
LoadDataWithTranspose<int8_t>(bB2_.Get<int8_t>()[abBank * l0k_ * width_ + i * 32 * npad],
bB1_.Get<int8_t>()[bBank * bk_ * width_ + s * l0k_ * 32 + i * 1024],bp);
if(s + 1 == slices)SetFlag<HardEvent::MTE1_MTE2>(bFree_[bBank]);
if(lastInOwner && q + 1 == chunks && s + 1 == slices)
SetFlag<HardEvent::MTE1_MTE2>(aFree_);
SetFlag<HardEvent::MTE1_M>(abReady_[abBank]);
WaitFlag<HardEvent::MTE1_M>(abReady_[abBank]);
MmadParams mm;
mm.m = mpad;mm.n = npad;mm.k = kPad;
mm.unitFlag =(q + 1 == chunks && s + 1 == slices)? 3 : 2;
mm.cmatrixSource = false;mm.cmatrixInitVal =(globalKstart == 0);
mm.isBias = false;mm.kDirectionAlign = false;
mm.fmOffset = 0;mm.enSsparse = false;
mm.enWinogradA = false;mm.enWinogradB = false;
if(globalKstart != 0 &&(mpad / 16)*(npad / 16)< 10)PipeBarrier<PIPE_M>();
Mmad<int32_t,int8_t,int8_t>(bC_.Get<int32_t>(),
bA2_.Get<int8_t>()[abBank * bm_ * l0k_],
bB2_.Get<int8_t>()[abBank * l0k_ * width_],mm);
SetFlag<HardEvent::M_MTE1>(abFree_[abBank]);
}
if(q + weightGroups < chunks)Prefetch(task,q + weightGroups,bBank);
}
if(sequence >= SLOTS)CrossCoreWaitFlag<2>(FREE_BASE + ringSlot);
FixpipeParamsV220 fp;
fp.nSize = npad;fp.mSize = mpad;
fp.srcStride = mpad;fp.dstStride = width_;
fp.quantPre = QuantMode_t::NoQuant;fp.deqScalar = 0;
fp.ndNum = 1;fp.srcNdStride = 0;fp.dstNdStride = 0;
fp.reluEn = false;fp.unitFlag = 3;fp.isChannelSplit = false;
const uint64_t slotBase =(static_cast<uint64_t>(producerId_)* SLOTS + ringSlot)* bm_ * width_;
Fixpipe<int32_t,int32_t,CFG_ROW_MAJOR>(ringGm_[slotBase],bC_.Get<int32_t>(),fp);
CrossCoreSetFlag<2,PIPE_FIX>(READY_BASE + ringSlot);
}
__aicore__ inline void PostCompute(uint32_t produced){
WaitFlag<HardEvent::MTE1_MTE2>(aFree_);
for(uint32_t bank = 0;bank < 2;++bank){
WaitFlag<HardEvent::MTE1_MTE2>(bFree_[bank]);
WaitFlag<HardEvent::M_MTE1>(abFree_[bank]);
}
if constexpr(FOUR_B){
for(uint32_t bank = 2;bank < 4;++bank)
WaitFlag<HardEvent::MTE1_MTE2>(bFree_[bank]);
}
if(produced != 0){
SetFlag<HardEvent::FIX_M>(cFree_);
WaitFlag<HardEvent::FIX_M>(cFree_);
}
const uint32_t first = produced > SLOTS ? produced - SLOTS : 0;
for(uint32_t sequence = first;sequence < produced;++sequence)
CrossCoreWaitFlag<2>(FREE_BASE + sequence % SLOTS);
PipeBarrier<PIPE_ALL>();
SetMMColumnMajor();

pipe_.ReleaseEventID<HardEvent::MTE2_MTE1>(aReady_);
pipe_.ReleaseEventID<HardEvent::MTE1_MTE2>(aFree_);

for(uint32_t bank = 0;bank < 2;++bank){
pipe_.ReleaseEventID<HardEvent::MTE2_MTE1>(bReady_[bank]);
pipe_.ReleaseEventID<HardEvent::MTE1_MTE2>(bFree_[bank]);
pipe_.ReleaseEventID<HardEvent::MTE1_M>(abReady_[bank]);
pipe_.ReleaseEventID<HardEvent::M_MTE1>(abFree_[bank]);
}
if constexpr(FOUR_B){
for(uint32_t bank = 2;bank < 4;++bank){
pipe_.ReleaseEventID<HardEvent::MTE2_MTE1>(bReady_[bank]);
pipe_.ReleaseEventID<HardEvent::MTE1_MTE2>(bFree_[bank]);
}
}
pipe_.ReleaseEventID<HardEvent::FIX_M>(cFree_);
}
private:
TPipe& pipe_;
TBuf<TPosition::A1> bA1_;
TBuf<TPosition::B1> bB1_;
TBuf<TPosition::A2> bA2_;
TBuf<TPosition::B2> bB2_;
TBuf<TPosition::CO1> bC_;
GlobalTensor<int8_t> xGm_,wGm_;
GlobalTensor<int32_t> ringGm_;
TEventID aReady_,aFree_,bReady_[FOUR_B ? 4 : 2],bFree_[FOUR_B ? 4 : 2],abReady_[2],abFree_[2],cFree_;
uint32_t k_,kPad_,n_,producerId_,bk_,bm_,width_,l0k_,mode_;
bool aPending_;
};
class ResidentBProducer{
public:
static constexpr bool ResidentB = true;
__aicore__ inline ResidentBProducer(TPipe& pipe): pipe_(pipe){}
__aicore__ inline void Init(GM_ADDR x,GM_ADDR weight,GM_ADDR ring,
uint32_t k,uint32_t n,uint32_t producerId,uint32_t bm,uint32_t width,
uint32_t l0k,uint32_t bk,uint32_t mode,uint32_t a1Reserve = 0){
xGm_.SetGlobalBuffer((__gm__ int8_t*)x);
wGm_.SetGlobalBuffer((__gm__ int8_t*)weight);
ringGm_.SetGlobalBuffer((__gm__ int32_t*)ring);
k_ = k;kPad_ =(k + 31)/ 32 * 32;n_ = n;producerId_ = producerId;bk_ = bk;
bm_ = bm;width_ = width;l0k_ = l0k;mode_ = mode;aPending_ = false;
tcChunks_ = gmg_tc::ChunksOf(k_,bk_);
tcNPad_ = gmg_tc::NPadOf(n_);
SetMMRowMajor();
pipe_.InitBuffer(bA1_,a1Reserve ? a1Reserve :(mode_ == FULL_A ? bm_ * kPad_ : 2 * bm_ * bk_));
pipe_.InitBuffer(bB1_,ResidentB ? kPad_ * width_ : 2 * bk_ * width_);
pipe_.InitBuffer(bA2_,2 * bm_ * l0k_);
pipe_.InitBuffer(bB2_,2 * l0k_ * width_);
pipe_.InitBuffer(bC_,bm_ * width_ * sizeof(int32_t));
if(mode_ == FULL_A){
aReady_ = pipe_.AllocEventID<HardEvent::MTE2_MTE1>();
aFree_ = pipe_.AllocEventID<HardEvent::MTE1_MTE2>();
SetFlag<HardEvent::MTE1_MTE2>(aFree_);
}
for(uint32_t bank = 0;bank < 2;++bank){
bReady_[bank]= pipe_.AllocEventID<HardEvent::MTE2_MTE1>();
bFree_[bank]= pipe_.AllocEventID<HardEvent::MTE1_MTE2>();
abReady_[bank]= pipe_.AllocEventID<HardEvent::MTE1_M>();
abFree_[bank]= pipe_.AllocEventID<HardEvent::M_MTE1>();
SetFlag<HardEvent::MTE1_MTE2>(bFree_[bank]);
SetFlag<HardEvent::M_MTE1>(abFree_[bank]);
}
cFree_ = pipe_.AllocEventID<HardEvent::FIX_M>();
}
__aicore__ inline void SetTranscode(GM_ADDR image,uint32_t on){
tcOn_ =(on != 0)&&(mode_ == STREAM);
nzGm_.SetGlobalBuffer((__gm__ int8_t*)image);
}
__aicore__ inline bool TranscodeOn()const{return tcOn_;}
__aicore__ inline void BeginOwner(uint32_t row,uint32_t validM){
if(mode_ != FULL_A)return;
WaitFlag<HardEvent::MTE1_MTE2>(aFree_);
const uint32_t mpad =(validM + 15)/ 16 * 16;
Nd2NzParams a;
a.ndNum = 1;a.nValue = validM;a.dValue = k_;
a.srcNdMatrixStride = 0;a.srcDValue = k_;
a.dstNzC0Stride = mpad;a.dstNzNStride = 1;a.dstNzMatrixStride = 0;
DataCopy(bA1_.Get<int8_t>(),xGm_[static_cast<uint64_t>(row)* k_],a);
if(mpad > validM){
Fill<uint32_t>(bA1_.Get<uint32_t>()[validM * 8],
{static_cast<uint16_t>(kPad_ / 32),static_cast<uint16_t>(mpad - validM),
static_cast<uint16_t>(validM),0u});
}
SetFlag<HardEvent::MTE2_MTE1>(aReady_);
aPending_ = true;
}
__aicore__ inline void Prefetch(const TaskDesc& task,uint32_t q,uint32_t bank){
WaitFlag<HardEvent::MTE1_MTE2>(bFree_[bank]);
if(ResidentB && cacheValid_ && cachedExpert_ == task.expert && cachedCol_ == task.col){
SetFlag<HardEvent::MTE2_MTE1>(bReady_[bank]);
return;
}
const uint32_t remaining = k_ - q * bk_;
const uint32_t qActual = remaining < bk_ ? remaining : bk_;
const uint32_t qPadK =(qActual + 31)/ 32 * 32;
const uint32_t npad =(task.validN + 31)/ 32 * 32;
if(mode_ == STREAM){
const uint32_t mpad =(task.validM + 15)/ 16 * 16;
Nd2NzParams a;
a.ndNum = 1;a.nValue = task.validM;a.dValue = qActual;
a.srcNdMatrixStride = 0;a.srcDValue = k_;
a.dstNzC0Stride = mpad;a.dstNzNStride = 1;a.dstNzMatrixStride = 0;
DataCopy(bA1_.Get<int8_t>()[bank * bm_ * bk_],
xGm_[static_cast<uint64_t>(task.row)* k_ + static_cast<uint64_t>(q)* bk_],a);
if(mpad > task.validM){
Fill<uint32_t>(bA1_.Get<uint32_t>()[bank * bm_ * bk_ / 4 + task.validM * 8],
{static_cast<uint16_t>(qPadK / 32),static_cast<uint16_t>(mpad - task.validM),
static_cast<uint16_t>(task.validM),0u});
}
}
if(tcOn_){
const uint32_t npadT =(task.validN + 31)/ 32 * 32;
const uint32_t qPadKt =(qActual + 31)/ 32 * 32;
const uint64_t base = static_cast<uint64_t>(task.expert)* tcChunks_ * bk_ * tcNPad_
+ static_cast<uint64_t>(q)* bk_ * tcNPad_
+ static_cast<uint64_t>(task.col)* qPadKt;
DataCopy(bB1_.Get<int8_t>()[bank * bk_ * width_],nzGm_[base],qPadKt * npadT);
if(qPadKt > qActual){
Fill<uint32_t>(bB1_.Get<uint32_t>()[bank * bk_ * width_ / 4 + qActual * 8],
{static_cast<uint16_t>(npadT / 32),static_cast<uint16_t>(qPadKt - qActual),
static_cast<uint16_t>(qActual),0u});
}
SetFlag<HardEvent::MTE2_MTE1>(bReady_[bank]);
return;
}
Nd2NzParams b;
b.ndNum = 1;b.nValue = qActual;b.dValue = task.validN;
b.srcNdMatrixStride = 0;b.srcDValue = n_;
b.dstNzC0Stride = qPadK;b.dstNzNStride = 1;b.dstNzMatrixStride = 0;
DataCopy(bB1_.Get<int8_t>()[bank * bk_ * width_],
wGm_[static_cast<uint64_t>(task.expert)* k_ * n_
+ static_cast<uint64_t>(q)* bk_ * n_ + task.col],b);
if(qPadK > qActual){
Fill<uint32_t>(bB1_.Get<uint32_t>()[bank * bk_ * width_ / 4 + qActual * 8],
{static_cast<uint16_t>(npad / 32),static_cast<uint16_t>(qPadK - qActual),
static_cast<uint16_t>(qActual),0u});
}
if(ResidentB){cacheValid_ = true;cachedExpert_ = task.expert;cachedCol_ = task.col;}
SetFlag<HardEvent::MTE2_MTE1>(bReady_[bank]);
}
__aicore__ inline void Produce(const TaskDesc& task,uint32_t sequence,bool lastInOwner){
const uint32_t ringSlot = sequence % SLOTS;
const uint32_t mpad =(task.validM + 15)/ 16 * 16;
const uint32_t npad =(task.validN + 31)/ 32 * 32;
const uint32_t chunks =(k_ + bk_ - 1)/ bk_;
const uint32_t initial = chunks < 2 ? chunks : 2;
for(uint32_t q = 0;q < initial;++q)Prefetch(task,q,q);
if(aPending_){
WaitFlag<HardEvent::MTE2_MTE1>(aReady_);
aPending_ = false;
}
for(uint32_t q = 0;q < chunks;++q){
const uint32_t bBank = q % 2;
const uint32_t remaining = k_ - q * bk_;
const uint32_t qActual = remaining < bk_ ? remaining : bk_;
WaitFlag<HardEvent::MTE2_MTE1>(bReady_[bBank]);
const uint32_t qPadK =(qActual + 31)/ 32 * 32;
const uint32_t slices =(qActual + l0k_ - 1)/ l0k_;
for(uint32_t s = 0;s < slices;++s){
const uint32_t remainingSlice = qActual - s * l0k_;
const uint32_t validSlice = remainingSlice < l0k_ ? remainingSlice : l0k_;
const uint32_t kPad =(validSlice + 31)/ 32 * 32;
const uint32_t globalKstart = q * bk_ + s * l0k_;
const uint32_t abBank =(globalKstart / l0k_)% 2;
WaitFlag<HardEvent::M_MTE1>(abFree_[abBank]);
LoadData2DParams ap;
ap.startIndex = 0;ap.repeatTimes = kPad / 32;ap.srcStride = mpad / 16;
ap.dstGap = 0;ap.ifTranspose = false;ap.sid = 0;ap.addrMode = 0;
const uint64_t aOffset = mode_ == FULL_A
? static_cast<uint64_t>(globalKstart)* mpad
: static_cast<uint64_t>(bBank)* bm_ * bk_ + static_cast<uint64_t>(s)* l0k_ * mpad;
for(uint32_t j = 0;j < mpad / 16;++j)
LoadData<int8_t>(bA2_.Get<int8_t>()[abBank * bm_ * l0k_ + j * 16 * kPad],
bA1_.Get<int8_t>()[aOffset + j * 512],ap);
LoadData2dTransposeParams bp;
bp.startIndex = 0;bp.repeatTimes = npad / 32;bp.srcStride = qPadK / 32;
bp.dstGap = 1;bp.dstFracGap = 0;bp.addrMode = 0;
for(uint32_t i = 0;i < kPad / 32;++i)
LoadDataWithTranspose<int8_t>(bB2_.Get<int8_t>()[abBank * l0k_ * width_ + i * 32 * npad],
bB1_.Get<int8_t>()[bBank * bk_ * width_ + s * l0k_ * 32 + i * 1024],bp);
if(s + 1 == slices)SetFlag<HardEvent::MTE1_MTE2>(bFree_[bBank]);
if(mode_ == FULL_A && lastInOwner && q + 1 == chunks && s + 1 == slices)
SetFlag<HardEvent::MTE1_MTE2>(aFree_);
SetFlag<HardEvent::MTE1_M>(abReady_[abBank]);
WaitFlag<HardEvent::MTE1_M>(abReady_[abBank]);
MmadParams mm;
mm.m = mpad;mm.n = npad;mm.k = kPad;
mm.unitFlag =(q + 1 == chunks && s + 1 == slices)? 3 : 2;
mm.cmatrixSource = false;mm.cmatrixInitVal =(globalKstart == 0);
mm.isBias = false;mm.kDirectionAlign = false;
mm.fmOffset = 0;mm.enSsparse = false;
mm.enWinogradA = false;mm.enWinogradB = false;
if(globalKstart != 0 &&(mpad / 16)*(npad / 16)< 10)PipeBarrier<PIPE_M>();
Mmad<int32_t,int8_t,int8_t>(bC_.Get<int32_t>(),
bA2_.Get<int8_t>()[abBank * bm_ * l0k_],
bB2_.Get<int8_t>()[abBank * l0k_ * width_],mm);
SetFlag<HardEvent::M_MTE1>(abFree_[abBank]);
}
if(q + 2 < chunks)Prefetch(task,q + 2,bBank);
}
if(sequence >= SLOTS)CrossCoreWaitFlag<2>(FREE_BASE + ringSlot);
FixpipeParamsV220 fp;
fp.nSize = npad;fp.mSize = mpad;
fp.srcStride = mpad;fp.dstStride = width_;
fp.quantPre = QuantMode_t::NoQuant;fp.deqScalar = 0;
fp.ndNum = 1;fp.srcNdStride = 0;fp.dstNdStride = 0;
fp.reluEn = false;fp.unitFlag = 3;fp.isChannelSplit = false;
const uint64_t slotBase =(static_cast<uint64_t>(producerId_)* SLOTS + ringSlot)* bm_ * width_;
Fixpipe<int32_t,int32_t,CFG_ROW_MAJOR>(ringGm_[slotBase],bC_.Get<int32_t>(),fp);
CrossCoreSetFlag<2,PIPE_FIX>(READY_BASE + ringSlot);
}
__aicore__ inline void PostCompute(uint32_t produced){
if(mode_ == FULL_A)WaitFlag<HardEvent::MTE1_MTE2>(aFree_);
for(uint32_t bank = 0;bank < 2;++bank){
WaitFlag<HardEvent::MTE1_MTE2>(bFree_[bank]);
WaitFlag<HardEvent::M_MTE1>(abFree_[bank]);
}
if(produced != 0){
SetFlag<HardEvent::FIX_M>(cFree_);
WaitFlag<HardEvent::FIX_M>(cFree_);
}
const uint32_t first = produced > SLOTS ? produced - SLOTS : 0;
for(uint32_t sequence = first;sequence < produced;++sequence)
CrossCoreWaitFlag<2>(FREE_BASE + sequence % SLOTS);
PipeBarrier<PIPE_ALL>();
SetMMColumnMajor();
if(mode_ == FULL_A){
pipe_.ReleaseEventID<HardEvent::MTE2_MTE1>(aReady_);
pipe_.ReleaseEventID<HardEvent::MTE1_MTE2>(aFree_);
}
for(uint32_t bank = 0;bank < 2;++bank){
pipe_.ReleaseEventID<HardEvent::MTE2_MTE1>(bReady_[bank]);
pipe_.ReleaseEventID<HardEvent::MTE1_MTE2>(bFree_[bank]);
pipe_.ReleaseEventID<HardEvent::MTE1_M>(abReady_[bank]);
pipe_.ReleaseEventID<HardEvent::M_MTE1>(abFree_[bank]);
}
pipe_.ReleaseEventID<HardEvent::FIX_M>(cFree_);
}
private:
TPipe& pipe_;
TBuf<TPosition::A1> bA1_;
TBuf<TPosition::B1> bB1_;
TBuf<TPosition::A2> bA2_;
TBuf<TPosition::B2> bB2_;
TBuf<TPosition::CO1> bC_;
GlobalTensor<int8_t> xGm_,wGm_;
GlobalTensor<int8_t> nzGm_;
GlobalTensor<int32_t> ringGm_;
TEventID aReady_,aFree_,bReady_[2],bFree_[2],abReady_[2],abFree_[2],cFree_;
uint32_t k_,kPad_,n_,producerId_,bk_,bm_,width_,l0k_,mode_;
uint32_t tcChunks_,tcNPad_;
bool aPending_;
bool tcOn_ = false;
bool cacheValid_ = false;
uint32_t cachedExpert_,cachedCol_;
};
template<bool ROW_PHASED = false,bool FULL_N = false,bool LOAD_A3D = false,bool HEAD_B = false>
class ResidentActivationPrefetchProducer{
public:
__aicore__ inline ResidentActivationPrefetchProducer(TPipe& pipe): pipe_(pipe){}
__aicore__ inline void Init(GM_ADDR x,GM_ADDR weight,GM_ADDR ring,
uint32_t k,uint32_t n,uint32_t producerId,uint32_t bm,uint32_t width,
uint32_t l0k,uint32_t bk){
xGm_.SetGlobalBuffer((__gm__ int8_t*)x);
wGm_.SetGlobalBuffer((__gm__ int8_t*)weight);
ringGm_.SetGlobalBuffer((__gm__ int32_t*)ring);
k_ = k;kPad_ =(k + 31)/ 32 * 32;n_ = n;producerId_ = producerId;bk_ = bk;
bm_ = bm;width_ = width;l0k_ = l0k;
SetMMRowMajor();
if constexpr(LOAD_A3D){
SetLoadDataRepeat({0,1,0});
SetLoadDataPaddingValue(int8_t(0));
}
pipe_.InitBuffer(bA1_,2 * bm_ * kPad_);
pipe_.InitBuffer(bB1_,kPad_ * width_);
pipe_.InitBuffer(bA2_,2 * bm_ * l0k_);
pipe_.InitBuffer(bB2_,2 * l0k_ * width_);
pipe_.InitBuffer(bC_,bm_ * width_ * sizeof(int32_t));
for(uint32_t bank = 0;bank < 2;++bank){
aReady_[bank]= pipe_.AllocEventID<HardEvent::MTE2_MTE1>();
aFree_[bank]= pipe_.AllocEventID<HardEvent::MTE1_MTE2>();
SetFlag<HardEvent::MTE1_MTE2>(aFree_[bank]);
bReady_[bank]= pipe_.AllocEventID<HardEvent::MTE2_MTE1>();
bFree_[bank]= pipe_.AllocEventID<HardEvent::MTE1_MTE2>();
abReady_[bank]= pipe_.AllocEventID<HardEvent::MTE1_M>();
abFree_[bank]= pipe_.AllocEventID<HardEvent::M_MTE1>();
SetFlag<HardEvent::MTE1_MTE2>(bFree_[bank]);
SetFlag<HardEvent::M_MTE1>(abFree_[bank]);
}
cFree_ = pipe_.AllocEventID<HardEvent::FIX_M>();
}
__aicore__ inline void BeginOwner(uint32_t,uint32_t){}
__aicore__ inline void PrefetchA(const TaskDesc& task,uint32_t bank){
WaitFlag<HardEvent::MTE1_MTE2>(aFree_[bank]);
const uint32_t mpad =(task.validM + 15)/ 16 * 16;
Nd2NzParams a;
a.ndNum = 1;a.nValue = task.validM;a.dValue = k_;
a.srcNdMatrixStride = 0;a.srcDValue = k_;
a.dstNzC0Stride = mpad;a.dstNzNStride = 1;a.dstNzMatrixStride = 0;
if constexpr(ROW_PHASED){
const uint32_t split = task.validM / 32 * 16;
if(split == 0){
DataCopy(bA1_.Get<int8_t>()[bank * bm_ * kPad_],
xGm_[static_cast<uint64_t>(task.row)* k_],a);
}else{
const uint32_t first = task.col / width_ % 2 == 0 ? 0 : split;
a.nValue = first == 0 ? split : task.validM - split;
DataCopy(bA1_.Get<int8_t>()[bank * bm_ * kPad_ + first * 32],
xGm_[static_cast<uint64_t>(task.row + first)* k_],a);
const uint32_t next = split - first;
a.nValue = next == 0 ? split : task.validM - split;
DataCopy(bA1_.Get<int8_t>()[bank * bm_ * kPad_ + next * 32],
xGm_[static_cast<uint64_t>(task.row + next)* k_],a);
}
}else{
DataCopy(bA1_.Get<int8_t>()[bank * bm_ * kPad_],
xGm_[static_cast<uint64_t>(task.row)* k_],a);
}
if(mpad > task.validM){
Fill<uint32_t>(bA1_.Get<uint32_t>()[bank * bm_ * kPad_ / 4 + task.validM * 8],
{static_cast<uint16_t>(kPad_ / 32),static_cast<uint16_t>(mpad - task.validM),
static_cast<uint16_t>(task.validM),0u});
}
SetFlag<HardEvent::MTE2_MTE1>(aReady_[bank]);
}
__aicore__ inline void PrefetchHeadWeight(const TaskDesc& task,uint32_t bank){
WaitFlag<HardEvent::MTE1_MTE2>(bFree_[bank]);
if(cacheValid_ && cachedExpert_ == task.expert && cachedCol_ == task.col){
SetFlag<HardEvent::MTE2_MTE1>(bReady_[bank]);
if(k_ > l0k_)SetFlag<HardEvent::MTE2_MTE1>(bReady_[1]);
return;
}
const uint32_t head = k_ < l0k_ ? k_ : l0k_;
const uint32_t npad =(task.validN + 31)/ 32 * 32;
Nd2NzParams b;
b.ndNum = 1;b.nValue = head;b.dValue = task.validN;
b.srcNdMatrixStride = 0;b.srcDValue = n_;
b.dstNzC0Stride = kPad_;b.dstNzNStride = 1;b.dstNzMatrixStride = 0;
const uint64_t base = static_cast<uint64_t>(bank)* bk_ * width_;
const uint64_t source = static_cast<uint64_t>(task.expert)* k_ * n_ + task.col;
DataCopy(bB1_.Get<int8_t>()[base],wGm_[source],b);
if constexpr(FULL_N){
if(npad < width_){
Fill<uint32_t>(bB1_.Get<uint32_t>()[base / 4 + npad * kPad_ / 4],
{1,static_cast<uint16_t>((width_ - npad)* kPad_ / 32),0,0u});
}
}
if(k_ > head){
SetFlag<HardEvent::MTE2_MTE1>(bReady_[bank]);
b.nValue = k_ - head;
DataCopy(bB1_.Get<int8_t>()[base + head * 32],
wGm_[source + static_cast<uint64_t>(head)* n_],b);
}
if(kPad_ > k_){
Fill<uint32_t>(bB1_.Get<uint32_t>()[base / 4 + k_ * 8],
{static_cast<uint16_t>(npad / 32),static_cast<uint16_t>(kPad_ - k_),
static_cast<uint16_t>(k_),0u});
}
if(k_ > head)SetFlag<HardEvent::MTE2_MTE1>(bReady_[1]);
else SetFlag<HardEvent::MTE2_MTE1>(bReady_[bank]);
cacheValid_ = true;cachedExpert_ = task.expert;cachedCol_ = task.col;
}
__aicore__ inline void Prefetch(const TaskDesc& task,uint32_t q,uint32_t bank){
if constexpr(HEAD_B){
PrefetchHeadWeight(task,bank);
return;
}
WaitFlag<HardEvent::MTE1_MTE2>(bFree_[bank]);
if(cacheValid_ && cachedExpert_ == task.expert && cachedCol_ == task.col){
SetFlag<HardEvent::MTE2_MTE1>(bReady_[bank]);
return;
}
const uint32_t remaining = k_ - q * bk_;
const uint32_t qActual = remaining < bk_ ? remaining : bk_;
const uint32_t qPadK =(qActual + 31)/ 32 * 32;
const uint32_t npad =(task.validN + 31)/ 32 * 32;
Nd2NzParams b;
b.ndNum = 1;b.nValue = qActual;b.dValue = task.validN;
b.srcNdMatrixStride = 0;b.srcDValue = n_;
b.dstNzC0Stride = qPadK;b.dstNzNStride = 1;b.dstNzMatrixStride = 0;
DataCopy(bB1_.Get<int8_t>()[bank * bk_ * width_],
wGm_[static_cast<uint64_t>(task.expert)* k_ * n_
+ static_cast<uint64_t>(q)* bk_ * n_ + task.col],b);
if(qPadK > qActual){
Fill<uint32_t>(bB1_.Get<uint32_t>()[bank * bk_ * width_ / 4 + qActual * 8],
{static_cast<uint16_t>(npad / 32),static_cast<uint16_t>(qPadK - qActual),
static_cast<uint16_t>(qActual),0u});
}
if constexpr(FULL_N){
if(npad < width_){
Fill<uint32_t>(bB1_.Get<uint32_t>()[bank * bk_ * width_ / 4 + npad * qPadK / 4],
{1,static_cast<uint16_t>((width_ - npad)* qPadK / 32),0,0u});
}
}
{cacheValid_ = true;cachedExpert_ = task.expert;cachedCol_ = task.col;}
SetFlag<HardEvent::MTE2_MTE1>(bReady_[bank]);
}
__aicore__ inline void Produce(const TaskDesc& task,uint32_t sequence,bool){
if(hasPending_)Compute(&task);
else PrefetchA(task,aBank_);
pending_ = task;
pendingSequence_ = sequence;
hasPending_ = true;
}
__aicore__ inline void Compute(const TaskDesc* next){
const TaskDesc task = pending_;
const uint32_t sequence = pendingSequence_;
const bool lastInOwner = true;
if constexpr(LOAD_A3D){
const uint8_t pad[4]={0,0,0,0};
SetFmatrix(1,static_cast<uint16_t>((task.validM + 15)/ 16 * 16),pad,FmatrixMode::FMATRIX_LEFT);
}
const uint32_t ringSlot = sequence % SLOTS;
const uint32_t mpad =(task.validM + 15)/ 16 * 16;
const uint32_t npad = FULL_N ? width_ :(task.validN + 31)/ 32 * 32;
const uint32_t chunks =(k_ + bk_ - 1)/ bk_;
const uint32_t initial = chunks < 2 ? chunks : 2;
for(uint32_t q = 0;q < initial;++q)Prefetch(task,q,q);
if(next != nullptr)PrefetchA(*next,aBank_ ^ 1);
WaitFlag<HardEvent::MTE2_MTE1>(aReady_[aBank_]);
for(uint32_t q = 0;q < chunks;++q){
const uint32_t bBank = q % 2;
const uint32_t remaining = k_ - q * bk_;
const uint32_t qActual = remaining < bk_ ? remaining : bk_;
WaitFlag<HardEvent::MTE2_MTE1>(bReady_[bBank]);
const uint32_t qPadK =(qActual + 31)/ 32 * 32;
const uint32_t slices =(qActual + l0k_ - 1)/ l0k_;
for(uint32_t s = 0;s < slices;++s){
const uint32_t remainingSlice = qActual - s * l0k_;
const uint32_t validSlice = remainingSlice < l0k_ ? remainingSlice : l0k_;
const uint32_t kPad =(validSlice + 31)/ 32 * 32;
const uint32_t globalKstart = q * bk_ + s * l0k_;
const uint32_t abBank =(globalKstart / l0k_)% 2;
WaitFlag<HardEvent::M_MTE1>(abFree_[abBank]);
if constexpr(LOAD_A3D){
const uint64_t aOffset = static_cast<uint64_t>(aBank_)* bm_ * kPad_
+ static_cast<uint64_t>(globalKstart)* mpad;
LoadData3DParamsV2<int8_t> ap;
ap.l1H = 1;ap.l1W = mpad;
ap.channelSize = kPad;ap.kExtension = kPad;ap.mExtension = mpad;
LoadData<int8_t,kALoad3dConfig>(bA2_.Get<int8_t>()[abBank * bm_ * l0k_],
bA1_.Get<int8_t>()[aOffset],ap);
}else{
LoadData2DParams ap;
ap.startIndex = 0;ap.repeatTimes = kPad / 32;ap.srcStride = mpad / 16;
ap.dstGap = 0;ap.ifTranspose = false;ap.sid = 0;ap.addrMode = 0;
const uint64_t aOffset = static_cast<uint64_t>(aBank_)* bm_ * kPad_
+ static_cast<uint64_t>(globalKstart)* mpad;
for(uint32_t j = 0;j < mpad / 16;++j)
LoadData<int8_t>(bA2_.Get<int8_t>()[abBank * bm_ * l0k_ + j * 16 * kPad],
bA1_.Get<int8_t>()[aOffset + j * 512],ap);
}
if constexpr(HEAD_B){
if(s == 1)WaitFlag<HardEvent::MTE2_MTE1>(bReady_[1]);
}
LoadData2dTransposeParams bp;
bp.startIndex = 0;bp.repeatTimes = npad / 32;bp.srcStride = qPadK / 32;
bp.dstGap = 1;bp.dstFracGap = 0;bp.addrMode = 0;
for(uint32_t i = 0;i < kPad / 32;++i)
LoadDataWithTranspose<int8_t>(bB2_.Get<int8_t>()[abBank * l0k_ * width_ + i * 32 * npad],
bB1_.Get<int8_t>()[bBank * bk_ * width_ + s * l0k_ * 32 + i * 1024],bp);
if(s + 1 == slices)SetFlag<HardEvent::MTE1_MTE2>(bFree_[bBank]);
if(lastInOwner && q + 1 == chunks && s + 1 == slices)
SetFlag<HardEvent::MTE1_MTE2>(aFree_[aBank_]);
SetFlag<HardEvent::MTE1_M>(abReady_[abBank]);
WaitFlag<HardEvent::MTE1_M>(abReady_[abBank]);
MmadParams mm;
mm.m = mpad;mm.n = npad;mm.k = kPad;
mm.unitFlag =(q + 1 == chunks && s + 1 == slices)? 3 : 2;
mm.cmatrixSource = false;mm.cmatrixInitVal =(globalKstart == 0);
mm.isBias = false;mm.kDirectionAlign = false;
mm.fmOffset = 0;mm.enSsparse = false;
mm.enWinogradA = false;mm.enWinogradB = false;
if(globalKstart != 0 &&(mpad / 16)*(npad / 16)< 10)PipeBarrier<PIPE_M>();
Mmad<int32_t,int8_t,int8_t>(bC_.Get<int32_t>(),
bA2_.Get<int8_t>()[abBank * bm_ * l0k_],
bB2_.Get<int8_t>()[abBank * l0k_ * width_],mm);
SetFlag<HardEvent::M_MTE1>(abFree_[abBank]);
}
if(q + 2 < chunks)Prefetch(task,q + 2,bBank);
}
if(sequence >= SLOTS)CrossCoreWaitFlag<2>(FREE_BASE + ringSlot);
FixpipeParamsV220 fp;
fp.nSize = npad;fp.mSize = mpad;
fp.srcStride = mpad;fp.dstStride = width_;
fp.quantPre = QuantMode_t::NoQuant;fp.deqScalar = 0;
fp.ndNum = 1;fp.srcNdStride = 0;fp.dstNdStride = 0;
fp.reluEn = false;fp.unitFlag = 3;fp.isChannelSplit = false;
const uint64_t slotBase =(static_cast<uint64_t>(producerId_)* SLOTS + ringSlot)* bm_ * width_;
Fixpipe<int32_t,int32_t,CFG_ROW_MAJOR>(ringGm_[slotBase],bC_.Get<int32_t>(),fp);
CrossCoreSetFlag<2,PIPE_FIX>(READY_BASE + ringSlot);
if(next != nullptr)aBank_ ^= 1;
}
__aicore__ inline void PostCompute(uint32_t produced){
if(hasPending_)Compute(nullptr);
for(uint32_t bank = 0;bank < 2;++bank){
WaitFlag<HardEvent::MTE1_MTE2>(aFree_[bank]);
WaitFlag<HardEvent::MTE1_MTE2>(bFree_[bank]);
WaitFlag<HardEvent::M_MTE1>(abFree_[bank]);
}
if(produced != 0){
SetFlag<HardEvent::FIX_M>(cFree_);
WaitFlag<HardEvent::FIX_M>(cFree_);
}
const uint32_t first = produced > SLOTS ? produced - SLOTS : 0;
for(uint32_t sequence = first;sequence < produced;++sequence)
CrossCoreWaitFlag<2>(FREE_BASE + sequence % SLOTS);
PipeBarrier<PIPE_ALL>();
SetMMColumnMajor();
for(uint32_t bank = 0;bank < 2;++bank){
pipe_.ReleaseEventID<HardEvent::MTE2_MTE1>(aReady_[bank]);
pipe_.ReleaseEventID<HardEvent::MTE1_MTE2>(aFree_[bank]);
pipe_.ReleaseEventID<HardEvent::MTE2_MTE1>(bReady_[bank]);
pipe_.ReleaseEventID<HardEvent::MTE1_MTE2>(bFree_[bank]);
pipe_.ReleaseEventID<HardEvent::MTE1_M>(abReady_[bank]);
pipe_.ReleaseEventID<HardEvent::M_MTE1>(abFree_[bank]);
}
pipe_.ReleaseEventID<HardEvent::FIX_M>(cFree_);
}
private:
TPipe& pipe_;
TBuf<TPosition::A1> bA1_;
TBuf<TPosition::B1> bB1_;
TBuf<TPosition::A2> bA2_;
TBuf<TPosition::B2> bB2_;
TBuf<TPosition::CO1> bC_;
GlobalTensor<int8_t> xGm_,wGm_;
GlobalTensor<int32_t> ringGm_;
TEventID aReady_[2],aFree_[2],bReady_[2],bFree_[2],abReady_[2],abFree_[2],cFree_;
uint32_t k_,kPad_,n_,producerId_,bk_,bm_,width_,l0k_;
TaskDesc pending_;
uint32_t pendingSequence_,aBank_ = 0;
bool hasPending_ = false;
bool cacheValid_ = false;
uint32_t cachedExpert_,cachedCol_;
};
template<uint32_t BM,uint32_t W,uint32_t L1K,uint32_t L0K>
class CyclicProducer{
public:
__aicore__ inline CyclicProducer(TPipe& pipe): pipe_(pipe){}
__aicore__ inline void Init(GM_ADDR x,GM_ADDR weight,GM_ADDR ring,
uint32_t k,uint32_t n,uint32_t producerId){
xGm_.SetGlobalBuffer((__gm__ int8_t*)x);
wGm_.SetGlobalBuffer((__gm__ int8_t*)weight);
ringGm_.SetGlobalBuffer((__gm__ int32_t*)ring);
k_ = k;n_ = n;producerId_ = producerId;
cacheValid_ = false;
pipe_.InitBuffer(bA1_,2 * BM * L1K);
pipe_.InitBuffer(bB1_,2 * L1K * W);
pipe_.InitBuffer(bA2_,2 * BM * L0K);
pipe_.InitBuffer(bB2_,2 * L0K * W);
pipe_.InitBuffer(bC_,BM * W * sizeof(int32_t));
for(uint32_t bank = 0;bank < 2;++bank){
l1Ready_[bank]= pipe_.AllocEventID<HardEvent::MTE2_MTE1>();
l1Free_[bank]= pipe_.AllocEventID<HardEvent::MTE1_MTE2>();
abReady_[bank]= pipe_.AllocEventID<HardEvent::MTE1_M>();
abFree_[bank]= pipe_.AllocEventID<HardEvent::M_MTE1>();
SetFlag<HardEvent::MTE1_MTE2>(l1Free_[bank]);
SetFlag<HardEvent::M_MTE1>(abFree_[bank]);
}
cReady_ = pipe_.AllocEventID<HardEvent::M_FIX>();
cFree_ = pipe_.AllocEventID<HardEvent::FIX_M>();
}
__aicore__ inline void Prefetch(const TaskDesc& task,uint32_t q,
uint32_t bank,uint32_t mpad){
WaitFlag<HardEvent::MTE1_MTE2>(l1Free_[bank]);
Nd2NzParams a;
a.ndNum = 1;a.nValue = task.validM;a.dValue = L1K;
a.srcNdMatrixStride = 0;a.srcDValue = k_;
a.dstNzC0Stride = mpad;a.dstNzNStride = 1;a.dstNzMatrixStride = 0;
DataCopy(bA1_.Get<int8_t>()[bank * BM * L1K],
xGm_[static_cast<uint64_t>(task.row)* k_ + static_cast<uint64_t>(q)* L1K],a);
if(needB_){
Nd2NzParams b;
b.ndNum = 1;b.nValue = L1K;b.dValue = W;
b.srcNdMatrixStride = 0;b.srcDValue = n_;
b.dstNzC0Stride = L1K;b.dstNzNStride = 1;b.dstNzMatrixStride = 0;
DataCopy(bB1_.Get<int8_t>()[bank * L1K * W],
wGm_[static_cast<uint64_t>(task.expert)* k_ * n_
+ static_cast<uint64_t>(q)* L1K * n_ + task.col],b);
}
SetFlag<HardEvent::MTE2_MTE1>(l1Ready_[bank]);
}
__aicore__ inline void BeginOwner(uint32_t,uint32_t){}
__aicore__ inline void Produce(const TaskDesc& task,uint32_t sequence,bool){
Produce(task,sequence);
}
__aicore__ inline void Produce(const TaskDesc& task,uint32_t sequence){
const uint32_t ringSlot = sequence % SLOTS;
const uint32_t mpad =(task.validM + 15)/ 16 * 16;
const uint32_t chunks = k_ / L1K;
needB_ = chunks > 2 || !cacheValid_
|| task.expert != cachedExpert_ || task.col != cachedCol_;
const uint32_t initial = chunks < 2 ? chunks : 2;
for(uint32_t q = 0;q < initial;++q)Prefetch(task,q,q,mpad);
for(uint32_t q = 0;q < chunks;++q){
const uint32_t l1Bank = q % 2;
WaitFlag<HardEvent::MTE2_MTE1>(l1Ready_[l1Bank]);
for(uint32_t s = 0;s < L1K / L0K;++s){
const uint32_t t = q *(L1K / L0K)+ s;
const uint32_t abBank = t % 2;
const uint32_t kStart = s * L0K;
WaitFlag<HardEvent::M_MTE1>(abFree_[abBank]);
LoadData2DParams ap;
ap.startIndex = 0;ap.repeatTimes = L0K / 32;ap.srcStride = mpad / 16;
ap.dstGap = 0;ap.ifTranspose = false;ap.sid = 0;ap.addrMode = 0;
for(uint32_t j = 0;j < mpad / 16;++j)
LoadData<int8_t>(bA2_.Get<int8_t>()[abBank * BM * L0K + j * 16 * L0K],
bA1_.Get<int8_t>()[l1Bank * BM * L1K + kStart * mpad + j * 512],ap);
LoadData2dTransposeParams bp;
bp.startIndex = 0;bp.repeatTimes = W / 32;bp.srcStride = L1K / 32;
bp.dstGap = 1;bp.dstFracGap = 0;bp.addrMode = 0;
for(uint32_t i = 0;i < L0K / 32;++i)
LoadDataWithTranspose<int8_t>(bB2_.Get<int8_t>()[abBank * L0K * W + i * 32 * W],
bB1_.Get<int8_t>()[l1Bank * L1K * W + kStart * 32 + i * 1024],bp);
if(s + 1 == L1K / L0K)SetFlag<HardEvent::MTE1_MTE2>(l1Free_[l1Bank]);
SetFlag<HardEvent::MTE1_M>(abReady_[abBank]);
WaitFlag<HardEvent::MTE1_M>(abReady_[abBank]);
if(t == 0 && sequence != 0)WaitFlag<HardEvent::FIX_M>(cFree_);
MmadParams mm;
mm.m = mpad;mm.n = W;mm.k = L0K;
mm.unitFlag = 0;mm.cmatrixSource = false;mm.cmatrixInitVal =(t == 0);
mm.isBias = false;mm.kDirectionAlign = false;
mm.fmOffset = 0;mm.enSsparse = false;
mm.enWinogradA = false;mm.enWinogradB = false;
Mmad<int32_t,int8_t,int8_t>(bC_.Get<int32_t>(),
bA2_.Get<int8_t>()[abBank * BM * L0K],
bB2_.Get<int8_t>()[abBank * L0K * W],mm);
SetFlag<HardEvent::M_MTE1>(abFree_[abBank]);
}
if(q + 2 < chunks)Prefetch(task,q + 2,l1Bank,mpad);
}
if(chunks <= 2){
cachedExpert_ = task.expert;cachedCol_ = task.col;cacheValid_ = true;
}else{
cacheValid_ = false;
}
if(sequence >= SLOTS)CrossCoreWaitFlag<2>(FREE_BASE + ringSlot);
SetFlag<HardEvent::M_FIX>(cReady_);
WaitFlag<HardEvent::M_FIX>(cReady_);
FixpipeParamsV220 fp;
fp.nSize = W;fp.mSize = task.validM;
fp.srcStride = mpad;fp.dstStride = W;
fp.quantPre = QuantMode_t::NoQuant;fp.deqScalar = 0;
fp.ndNum = 1;fp.srcNdStride = 0;fp.dstNdStride = 0;
fp.reluEn = false;fp.unitFlag = 0;fp.isChannelSplit = false;
const uint64_t slotBase =(static_cast<uint64_t>(producerId_)* SLOTS + ringSlot)* BM * W;
Fixpipe<int32_t,int32_t,CFG_ROW_MAJOR>(ringGm_[slotBase],bC_.Get<int32_t>(),fp);
CrossCoreSetFlag<2,PIPE_FIX>(READY_BASE + ringSlot);
SetFlag<HardEvent::FIX_M>(cFree_);
}
__aicore__ inline void PostCompute(uint32_t produced){
for(uint32_t bank = 0;bank < 2;++bank){
WaitFlag<HardEvent::MTE1_MTE2>(l1Free_[bank]);
WaitFlag<HardEvent::M_MTE1>(abFree_[bank]);
}
if(produced != 0)WaitFlag<HardEvent::FIX_M>(cFree_);
const uint32_t first = produced > SLOTS ? produced - SLOTS : 0;
for(uint32_t sequence = first;sequence < produced;++sequence)
CrossCoreWaitFlag<2>(FREE_BASE + sequence % SLOTS);
PipeBarrier<PIPE_ALL>();
for(uint32_t bank = 0;bank < 2;++bank){
pipe_.ReleaseEventID<HardEvent::MTE2_MTE1>(l1Ready_[bank]);
pipe_.ReleaseEventID<HardEvent::MTE1_MTE2>(l1Free_[bank]);
pipe_.ReleaseEventID<HardEvent::MTE1_M>(abReady_[bank]);
pipe_.ReleaseEventID<HardEvent::M_MTE1>(abFree_[bank]);
}
pipe_.ReleaseEventID<HardEvent::M_FIX>(cReady_);
pipe_.ReleaseEventID<HardEvent::FIX_M>(cFree_);
}
private:
TPipe& pipe_;
TBuf<TPosition::A1> bA1_;
TBuf<TPosition::B1> bB1_;
TBuf<TPosition::A2> bA2_;
TBuf<TPosition::B2> bB2_;
TBuf<TPosition::CO1> bC_;
GlobalTensor<int8_t> xGm_,wGm_;
GlobalTensor<int32_t> ringGm_;
TEventID l1Ready_[2],l1Free_[2],abReady_[2],abFree_[2],cReady_,cFree_;
uint32_t k_,n_,producerId_;
uint32_t cachedExpert_,cachedCol_;
bool cacheValid_,needB_;
};
#else
__aicore__ inline void PadActivationRows(TPipe& pipe,GM_ADDR x,GM_ADDR image,
uint32_t m,uint32_t k,uint32_t producers,uint32_t bankBytes,
const LocalTensor<int8_t>& input0,const LocalTensor<int8_t>& input1){
GlobalTensor<int8_t> source,destination;
source.SetGlobalBuffer((__gm__ int8_t*)x);
destination.SetGlobalBuffer((__gm__ int8_t*)image);
const uint32_t pitch =(k + 255)/ 256 * 256;
const uint32_t compactPitch =(k + 31)/ 32 * 32;
const uint32_t gap =(pitch - compactPitch)/ 32;
const uint32_t band = bankBytes / pitch;
auto cleared = pipe.AllocEventID<HardEvent::V_MTE2>();
Duplicate(input0.ReinterpretCast<uint32_t>(),0u,bankBytes / 4);
Duplicate(input1.ReinterpretCast<uint32_t>(),0u,bankBytes / 4);
SetFlag<HardEvent::V_MTE2>(cleared);
WaitFlag<HardEvent::V_MTE2>(cleared);
pipe.ReleaseEventID<HardEvent::V_MTE2>(cleared);
TEventID ready[2],free[2];
for(uint32_t bank = 0;bank < 2;++bank){
ready[bank]= pipe.AllocEventID<HardEvent::MTE2_MTE3>();
free[bank]= pipe.AllocEventID<HardEvent::MTE3_MTE2>();
SetFlag<HardEvent::MTE3_MTE2>(free[bank]);
}
const uint32_t lane =(GetBlockIdx()/ 2)* 2 + GetSubBlockIdx();
const uint32_t lanes = producers * 2;
const uint32_t bands =(m + band - 1)/ band;
uint32_t work = 0;
for(uint32_t index = lane;index < bands;index += lanes){
const uint32_t row = index * band;
const uint32_t count = m - row < band ? m - row : band;
const uint32_t bank = work++ % 2;
const auto buffer = bank == 0 ? input0 : input1;
WaitFlag<HardEvent::MTE3_MTE2>(free[bank]);
DataCopyPad(buffer,source[static_cast<uint64_t>(row)* k],
{static_cast<uint16_t>(count),k,0,gap,0},
{true,0,static_cast<uint8_t>(compactPitch - k),0});
SetFlag<HardEvent::MTE2_MTE3>(ready[bank]);
WaitFlag<HardEvent::MTE2_MTE3>(ready[bank]);
DataCopy(destination[static_cast<uint64_t>(row)* pitch],buffer,count * pitch);
SetFlag<HardEvent::MTE3_MTE2>(free[bank]);
}
for(uint32_t bank = 0;bank < 2;++bank){
WaitFlag<HardEvent::MTE3_MTE2>(free[bank]);
pipe.ReleaseEventID<HardEvent::MTE2_MTE3>(ready[bank]);
pipe.ReleaseEventID<HardEvent::MTE3_MTE2>(free[bank]);
}
SyncAll();
CrossCoreSetFlag<2,PIPE_MTE3>(5);
}
template<bool ENABLED> struct ScaleReuseState{};
template<> struct ScaleReuseState<true>{
LocalTensor<float> cachedScale_;
uint32_t scaleExpert_,scaleCol_;
bool scaleValid_;
};
template<bool REUSE_SCALE = false,bool SEPARATE_BANKS = false,bool REPEAT_SCALE = false>
class Consumer : private ScaleReuseState<REUSE_SCALE>{
public:
__aicore__ inline Consumer(TPipe& pipe): pipe_(pipe){}
__aicore__ inline void Init(GM_ADDR scale,GM_ADDR y,GM_ADDR ring,GM_ADDR groups,
uint32_t e,uint32_t n,uint32_t producer,uint32_t bm,uint32_t width,
bool singleShot,bool broadcastScale = false){
scaleGm_.SetGlobalBuffer((__gm__ float*)scale);
yGm_.SetGlobalBuffer((__gm__ half*)y);
ringGm_.SetGlobalBuffer((__gm__ int32_t*)ring);
n_ = n;producer_ = producer;sub_ = GetSubBlockIdx();
bm_ = bm;width_ = width;singleShot_ = singleShot;
slots_ = singleShot ? 1 : 4;
broadcastScale_ = broadcastScale;
if constexpr(REUSE_SCALE)this->scaleValid_ = false;
maxLanes_ = broadcastScale ? 8192 :(singleShot ? 2048 : 4096);
pipe_.InitBuffer(qC_,singleShot ? 1 : 2,maxLanes_ * sizeof(int32_t));
pipe_.InitBuffer(qY_,2,maxLanes_ * sizeof(half));
if constexpr(SEPARATE_BANKS){
pipe_.InitBuffer(qScale_,2,(broadcastScale ? width : maxLanes_)* sizeof(float)+ 128);
pipe_.InitBuffer(z_,maxLanes_ * sizeof(float)+ 256);
}else{
const uint32_t scalePad = broadcastScale ?(384 -(width * 4)% 256)% 256 : 0;
pipe_.InitBuffer(qScale_,2,(broadcastScale ? width : maxLanes_)* sizeof(float)+ scalePad);
pipe_.InitBuffer(z_,maxLanes_ * sizeof(float)+(broadcastScale ? 256 : 0));
}
pipe_.InitBuffer(y_,maxLanes_ * sizeof(float));
pipe_.InitBuffer(qGroup_,1,(e * 8 + 31)/ 32 * 32);
GlobalTensor<int64_t> groupGm;
groupGm.SetGlobalBuffer((__gm__ int64_t*)groups);
auto group = qGroup_.AllocTensor<int64_t>();
DataCopyPad(group,groupGm,{1,e * 8,0,0,0},{false,0,0,0});
qGroup_.EnQue(group);
groups_ = qGroup_.DeQue<int64_t>();
auto event = pipe_.FetchEventID(HardEvent::MTE2_S);
SetFlag<HardEvent::MTE2_S>(event);
WaitFlag<HardEvent::MTE2_S>(event);
}
__aicore__ inline LocalTensor<int64_t> Groups()const{return groups_;}
__aicore__ inline void PrepareActivation(GM_ADDR x,GM_ADDR image,
uint32_t m,uint32_t k,uint32_t producers){
auto input0 = qC_.AllocTensor<int32_t>();
auto input1 = qC_.AllocTensor<int32_t>();
PadActivationRows(pipe_,x,image,m,k,producers,maxLanes_ * sizeof(int32_t),
input0.ReinterpretCast<int8_t>(),input1.ReinterpretCast<int8_t>());
qC_.FreeTensor(input0);
qC_.FreeTensor(input1);
}
struct Packet{TaskDesc task;uint32_t first,row,rows;};
__aicore__ inline void Prefetch(const Packet& packet,uint32_t slot,bool last){
const TaskDesc& task = packet.task;
const uint32_t p8 =(task.validN + 7)/ 8 * 8;
const uint64_t offset =(static_cast<uint64_t>(producer_)* slots_ + slot)* bm_ * width_
+(packet.first + packet.row)* width_;
auto acc = qC_.AllocTensor<int32_t>();
DataCopyPad(acc,ringGm_[offset],
{static_cast<uint16_t>(packet.rows),task.validN * 4,
(width_ - task.validN)* 4,0,0},
{true,0,static_cast<uint8_t>(p8 - task.validN),0});
qC_.EnQue(acc);
if(!singleShot_ && last)CrossCoreSetFlag<2,PIPE_MTE2>(FREE_BASE + slot);
}
__aicore__ inline void Compute(const Packet& packet,const LocalTensor<float>& scales,uint32_t lanes){
const TaskDesc& task = packet.task;
const uint32_t p8 =(task.validN + 7)/ 8 * 8;
const uint32_t p16 =(task.validN + 15)/ 16 * 16;
auto acc = qC_.DeQue<int32_t>();
auto z = z_.Get<float>();
auto y = y_.Get<float>();
const uint32_t active = packet.rows * p8;
Cast(z,acc,RoundMode::CAST_RINT,active);PipeBarrier<PIPE_V>();
if(broadcastScale_){
const BinaryRepeatParams stride ={1,1,1,
static_cast<uint8_t>(p8 / 8),static_cast<uint8_t>(p8 / 8),0};
for(uint32_t col = 0;col < p8;col += 64){
const uint64_t live = p8 - col < 64 ? p8 - col : 64;
Mul<float>(z[col],z[col],scales[col],live,
static_cast<uint8_t>(packet.rows),stride);
}
PipeBarrier<PIPE_V>();
}else{
Mul(z,z,scales,active);PipeBarrier<PIPE_V>();
}
gmg::Gelu7Count(z,y,active);
auto output = qY_.AllocTensor<half>();
if(p8 == p16){
Cast(output,y,RoundMode::CAST_RINT,packet.rows * p8);
}else{
Duplicate(output,half(0),packet.rows * p16);PipeBarrier<PIPE_V>();
const UnaryRepeatParams stride ={1,1,
static_cast<uint8_t>(p16 / 16),static_cast<uint8_t>(p8 / 8)};
for(uint32_t col = 0;col < p8;col += 64){
const uint64_t live = p8 - col < 64 ? p8 - col : 64;
Cast<half,float>(output[col],y[col],RoundMode::CAST_RINT,
live,static_cast<uint8_t>(packet.rows),stride);
}
}
qY_.EnQue(output);
output = qY_.DeQue<half>();
DataCopyPad(yGm_[static_cast<uint64_t>(task.row + packet.first + packet.row)* n_ + task.col],
output,{static_cast<uint16_t>(packet.rows),task.validN * 2,
0,(n_ - task.validN)* 2,0});
qY_.FreeTensor(output);
qC_.FreeTensor(acc);
}
__aicore__ inline void Submit(const TaskDesc& task,uint32_t sequence){
const uint32_t slot = sequence % slots_;
const uint32_t firstHalf =(task.validM + 1)/ 2;
const uint32_t first = sub_ == 0 ? 0 : firstHalf;
const uint32_t rows = sub_ == 0 ? firstHalf : task.validM - firstHalf;
if(rows == 0){
CrossCoreWaitFlag<2>(READY_BASE + slot);
if(!singleShot_)CrossCoreSetFlag<2,PIPE_MTE2>(FREE_BASE + slot);
return;
}
const uint32_t p8 =(task.validN + 7)/ 8 * 8;
const uint32_t p16 =(task.validN + 15)/ 16 * 16;
const uint32_t outputRows = maxLanes_ / p16;
uint32_t packetRows = 1;
while(packetRows < rows && 2 * packetRows <= outputRows && packetRows < 128)packetRows *= 2;
const uint32_t lanes = packetRows * p8;
bool scaleHit = false;
if constexpr(REUSE_SCALE)scaleHit = broadcastScale_ && this->scaleValid_
&& this->scaleExpert_ == task.expert && this->scaleCol_ == task.col;
LocalTensor<float> scales;
if constexpr(REUSE_SCALE){
if(scaleHit)scales = this->cachedScale_;
}
if(!scaleHit){
if constexpr(REUSE_SCALE){
if(this->scaleValid_)qScale_.FreeTensor(this->cachedScale_);
}
scales = qScale_.AllocTensor<float>();
DataCopyPad(scales,scaleGm_[static_cast<uint64_t>(task.expert)* n_ + task.col],
{1,task.validN * 4,0,0,0},{true,0,static_cast<uint8_t>(p8 - task.validN),0.0f});
qScale_.EnQue(scales);
scales = qScale_.DeQue<float>();
if constexpr(REUSE_SCALE){
this->cachedScale_ = scales;this->scaleValid_ = true;
this->scaleExpert_ = task.expert;this->scaleCol_ = task.col;
}
}
if constexpr(REPEAT_SCALE){
if(!broadcastScale_ && packetRows > 1){
SetMaskCount();
SetVectorMask<float,MaskMode::COUNTER>(p8);
Copy<float,false>(scales[p8],scales,MASK_PLACEHOLDER,
static_cast<uint8_t>(packetRows-1),{1,1,static_cast<uint16_t>(p8/8),0});
PipeBarrier<PIPE_V>();
SetMaskNorm();ResetMask();
}
}else{
for(uint32_t copies = 1;!broadcastScale_ && copies < packetRows;copies *= 2){
Adds(scales[copies * p8],scales,0.0f,copies * p8);PipeBarrier<PIPE_V>();
}
}
CrossCoreWaitFlag<2>(READY_BASE + slot);
Packet current ={task,first,0,rows < packetRows ? rows : packetRows};
Prefetch(current,slot,current.rows == rows);
for(;;){
const uint32_t nextRow = current.row + current.rows;
Packet next ={task,first,nextRow,rows - nextRow < packetRows ? rows - nextRow : packetRows};
if(!singleShot_ && nextRow < rows)Prefetch(next,slot,nextRow + next.rows == rows);
Compute(current,scales,lanes);
if(nextRow == rows)break;
if(singleShot_)Prefetch(next,slot,nextRow + next.rows == rows);
current = next;
}
if constexpr(!REUSE_SCALE)qScale_.FreeTensor(scales);
}
__aicore__ inline void PostCompute(uint32_t){
if constexpr(REUSE_SCALE){
if(this->scaleValid_)qScale_.FreeTensor(this->cachedScale_);
}
qGroup_.FreeTensor(groups_);
PipeBarrier<PIPE_ALL>();
}
private:
TPipe& pipe_;
TQue<TPosition::VECIN,2> qC_;
TQue<TPosition::VECIN,2> qScale_;
TQue<TPosition::VECIN,1> qGroup_;
TQue<TPosition::VECOUT,2> qY_;
TBuf<TPosition::VECCALC> z_,y_;
GlobalTensor<float> scaleGm_;
GlobalTensor<half> yGm_;
GlobalTensor<int32_t> ringGm_;
LocalTensor<int64_t> groups_;
uint32_t n_,producer_,sub_,bm_,width_,slots_,maxLanes_;
bool singleShot_,broadcastScale_;
};
