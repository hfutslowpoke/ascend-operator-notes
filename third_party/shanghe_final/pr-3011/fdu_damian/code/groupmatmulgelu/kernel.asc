if(!singleShot_){
l1Free_ = pipe_.AllocEventID<HardEvent::MTE1_MTE2>();
abFree_ = pipe_.AllocEventID<HardEvent::M_MTE1>();
SetFlag<HardEvent::MTE1_MTE2>(l1Free_);
SetFlag<HardEvent::M_MTE1>(abFree_);
}
}
__aicore__ inline void BeginOwner(uint32_t,uint32_t){}
__aicore__ inline void Produce(const TaskDesc& task,uint32_t sequence,bool){
