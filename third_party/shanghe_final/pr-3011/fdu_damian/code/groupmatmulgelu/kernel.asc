b.srcNdMatrixStride = 0;b.srcDValue = n_;
b.dstNzC0Stride = kPad_;b.dstNzNStride = 1;b.dstNzMatrixStride = 0;
DataCopy(b1_.Get<int8_t>(),
wGm_[static_cast<uint64_t>(task.expert)* k_ * n_ + task.col],b);
if(kPad_ > k_){
Fill<uint32_t>(b1_.Get<uint32_t>()[k_ * 8],
{static_cast<uint16_t>(npad / 32),static_cast<uint16_t>(kPad_ - k_),
static_cast<uint16_t>(k_),0u});
}
SetFlag<HardEvent::MTE2_MTE1>(l1Ready_);
WaitFlag<HardEvent::MTE2_MTE1>(l1Ready_);
if(!singleShot_)WaitFlag<HardEvent::M_MTE1>(abFree_);
LoadData2DParams ap;
ap.startIndex = 0;ap.repeatTimes = kPad_ / 32;ap.srcStride = mpad / 16;
ap.dstGap = 0;ap.ifTranspose = false;ap.sid = 0;ap.addrMode = 0;
for(uint32_t j = 0;j < mpad / 16;++j)
LoadData<int8_t>(a2_.Get<int8_t>()[j * 16 * kPad_],a1_.Get<int8_t>()[j * 512],ap);
LoadData2dTransposeParams bp;
bp.startIndex = 0;bp.repeatTimes = npad / 32;bp.srcStride = kPad_ / 32;
bp.dstGap = 1;bp.dstFracGap = 0;bp.addrMode = 0;
for(uint32_t i = 0;i < kPad_ / 32;++i)
LoadDataWithTranspose<int8_t>(b2_.Get<int8_t>()[i * 32 * npad],b1_.Get<int8_t>()[i * 1024],bp);
if(!singleShot_)SetFlag<HardEvent::MTE1_MTE2>(l1Free_);
SetFlag<HardEvent::MTE1_M>(abReady_);
WaitFlag<HardEvent::MTE1_M>(abReady_);
MmadParams mm;
mm.m = mpad;mm.n = npad;mm.k = kPad_;
mm.unitFlag = 3;mm.cmatrixSource = false;mm.cmatrixInitVal = true;
mm.isBias = false;mm.kDirectionAlign = false;
mm.fmOffset = 0;mm.enSsparse = false;
mm.enWinogradA = false;mm.enWinogradB = false;
Mmad<int32_t,int8_t,int8_t>(c_.Get<int32_t>(),a2_.Get<int8_t>(),b2_.Get<int8_t>(),mm);
if(!singleShot_)SetFlag<HardEvent::M_MTE1>(abFree_);
const uint32_t slot = sequence % slots_;
if(!singleShot_ && sequence >= slots_)CrossCoreWaitFlag<2>(FREE_BASE + slot);
FixpipeParamsV220 fp;
fp.nSize = npad;fp.mSize = mpad;
fp.srcStride = mpad;fp.dstStride = width_;
fp.quantPre = QuantMode_t::NoQuant;fp.deqScalar = 0;
fp.ndNum = 1;fp.srcNdStride = 0;fp.dstNdStride = 0;
fp.reluEn = false;fp.unitFlag = 3;fp.isChannelSplit = false;
const uint64_t offset =(static_cast<uint64_t>(producer_)* slots_ + slot)* bm_ * width_;
Fixpipe<int32_t,int32_t,CFG_ROW_MAJOR>(ringGm_[offset],c_.Get<int32_t>(),fp);
CrossCoreSetFlag<2,PIPE_FIX>(READY_BASE + slot);
}
