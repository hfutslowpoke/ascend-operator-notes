__global__ __aicore__ void grouped_matmul_gelu_single_row_activation_image(
GM_ADDR x,GM_ADDR weight,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,
GM_ADDR ring,GM_ADDR activation,uint32_t m,uint32_t k,uint32_t n,uint32_t e,uint32_t producers,
uint32_t bm,uint32_t width,uint32_t l0k,uint32_t bk,uint32_t ownerG){
using namespace AscendC;
KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
#if defined(__NPU_ARCH__)&& __NPU_ARCH__ == 2201
TPipe pipe;
const uint32_t columnGroups =((n + width - 1)/ width + ownerG - 1)/ ownerG;
#if defined(__DAV_C220_CUBE__)
const uint32_t producer = GetBlockIdx();
GlobalTensor<int64_t> currentGroups;
currentGroups.SetGlobalBuffer((__gm__ int64_t*)groups);
#else
const uint32_t producer = GetBlockIdx()/ 2;
gmg_native::Consumer stage(pipe);
stage.Init(scale,y,ring,groups,e,n,producer,bm,width,false);
const auto currentGroups = stage.Groups();
#endif
uint32_t previous = 0,largestRows = 0,live = 0;
for(uint32_t expert = 0;expert < e;++expert){
const uint32_t end = static_cast<uint32_t>(currentGroups.GetValue(expert));
const uint32_t rows = end - previous;
if(rows > largestRows)largestRows = rows;
if(rows != 0)++live;
previous = end;
}
const bool aligned = live > 1 && largestRows <= bm && live * columnGroups >= producers;
#if defined(__DAV_C220_CUBE__)
if(aligned){
gmg_native::MultiProducer<false,false,true> stage(pipe);
stage.Init(activation,weight,ring,k,n,producer,bm,width,l0k,bk,gmg_native::FULL_A);
CrossCoreWaitFlag<2>(5);
gmg_native::ScheduleSingleRowBlockActivation(stage,groups,e,n,producer,producers,bm,width,ownerG);
}else{
gmg_native::MultiProducer<> stage(pipe);
stage.Init(x,weight,ring,k,n,producer,bm,width,l0k,bk,gmg_native::FULL_A);
gmg_native::ScheduleSkewAware(stage,groups,e,n,producer,producers,bm,width,ownerG,false);
}
#else
if(aligned){
stage.PrepareActivation(x,activation,m,k,producers);
gmg_native::ScheduleSingleRowBlockActivation(stage,groups,e,n,producer,producers,bm,width,ownerG);
}else{
gmg_native::ScheduleSkewAware(stage,groups,e,n,producer,producers,bm,width,ownerG,false);
}
#endif
#endif
}
__global__ __aicore__ void grouped_matmul_gelu_separated_vector_banks(
GM_ADDR x,GM_ADDR weight,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,
GM_ADDR ring,GM_ADDR activation,uint32_t m,uint32_t k,uint32_t n,uint32_t e,uint32_t producers,
uint32_t bm,uint32_t width,uint32_t l0k,uint32_t bk,uint32_t ownerG){
using namespace AscendC;
KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
#if defined(__NPU_ARCH__)&& __NPU_ARCH__ == 2201
TPipe pipe;
const uint32_t columnGroups =((n + width - 1)/ width + ownerG - 1)/ ownerG;
#if defined(__DAV_C220_CUBE__)
const uint32_t producer = GetBlockIdx();
GlobalTensor<int64_t> currentGroups;
currentGroups.SetGlobalBuffer((__gm__ int64_t*)groups);
#else
const uint32_t producer = GetBlockIdx()/ 2;
gmg_native::Consumer<false,true> stage(pipe);
stage.Init(scale,y,ring,groups,e,n,producer,bm,width,false);
const auto currentGroups = stage.Groups();
#endif
uint32_t previous = 0,largestRows = 0,live = 0;
for(uint32_t expert = 0;expert < e;++expert){
const uint32_t end = static_cast<uint32_t>(currentGroups.GetValue(expert));
const uint32_t rows = end - previous;
if(rows > largestRows)largestRows = rows;
if(rows != 0)++live;
previous = end;
}
const bool aligned = live > 1 && largestRows <= bm && live * columnGroups >= producers;
#if defined(__DAV_C220_CUBE__)
if(aligned){
gmg_native::MultiProducer<false,false,true,true> stage(pipe);
stage.Init(activation,weight,ring,k,n,producer,bm,width,l0k,bk,gmg_native::FULL_A);
gmg_native::TaskDesc bootstrap;
uint32_t startRow = 0,ownerPrefix = 0;
const uint32_t nTiles =(n + width - 1)/ width;
const uint32_t columnsPerGroup = nTiles / columnGroups;
const uint32_t extraColumns = nTiles % columnGroups;
for(uint32_t expert = 0;expert < e;++expert){
const uint32_t end = static_cast<uint32_t>(currentGroups.GetValue(expert));
const uint32_t rows = end - startRow;
if(rows != 0){
const uint32_t firstOwner =(producer + producers - ownerPrefix % producers)% producers;
if(firstOwner < columnGroups){
const uint32_t column = firstOwner * columnsPerGroup
+(firstOwner < extraColumns ? firstOwner : extraColumns);
const uint32_t col = column * width;
bootstrap ={expert,startRow,col,rows,n - col < width ? n - col : width};
break;
}
ownerPrefix += columnGroups;
}
startRow = end;
}
const uint32_t chunks =(k + bk - 1)/ bk;
for(uint32_t q = 0;q <(chunks < 2 ? chunks : 2);++q)stage.Prefetch(bootstrap,q,q);
CrossCoreWaitFlag<2>(5);
gmg_native::ScheduleSingleRowBlockActivation(stage,groups,e,n,producer,producers,bm,width,ownerG);
}else{
gmg_native::MultiProducer<false,false,false,false,true> stage(pipe);
stage.Init(x,weight,ring,k,n,producer,bm,width,l0k,bk,gmg_native::FULL_A);
gmg_native::ScheduleTransferWeightedStrips(stage,groups,e,n,producer,producers,bm,width);
}
#else
if(aligned){
stage.PrepareActivation(x,activation,m,k,producers);
gmg_native::ScheduleSingleRowBlockActivation(stage,groups,e,n,producer,producers,bm,width,ownerG);
}else{
gmg_native::ScheduleTransferWeightedStrips(stage,groups,e,n,producer,producers,bm,width);
}
#endif
#endif
}
