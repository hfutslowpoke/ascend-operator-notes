__global__ __aicore__ void grouped_matmul_gelu_grouped_weight_load(
GM_ADDR x,GM_ADDR weight,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,
GM_ADDR ring,GM_ADDR padded,uint32_t k,uint32_t n,
uint32_t e,uint32_t producers,uint32_t bm,uint32_t width,
uint32_t l0k,uint32_t bk,uint32_t ownerG){
using namespace AscendC;
KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
#if defined(__NPU_ARCH__)&& __NPU_ARCH__ == 2201
const bool directWeight=static_cast<uint64_t>(e)*k*((n+31)/32*32)>=gmg_tc::kBudgetBytes/4;
TPipe pipe;
#if defined(__DAV_C220_CUBE__)
const uint32_t producer = GetBlockIdx();
gmg_native::PaddedWeightProducer<> stage(pipe);
stage.Init(x,padded,ring,k,n,producer,bm,width,l0k,bk,gmg_native::FULL_A);
if(directWeight)stage.SetDirectWeight(weight);
#else
const uint32_t producer = GetBlockIdx()/ 2;
gmg_native::Consumer stage(pipe);
stage.Init(scale,y,ring,groups,e,n,producer,bm,width,false);
if(!directWeight)gmg_native::PadWeightColumns(pipe,weight,padded,stage.Groups(),e,k,n,producers);
#endif
gmg_native::Schedule(stage,groups,e,n,producer,producers,bm,width,ownerG,false);
#endif
}
