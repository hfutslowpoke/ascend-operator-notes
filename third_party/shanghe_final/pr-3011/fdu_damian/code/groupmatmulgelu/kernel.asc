gmg_native::ScheduleResidentB(stage,groups,e,n,producer,producers,bm,width);
}
#else
const uint32_t producer = GetBlockIdx()/ 2;
gmg_native::Consumer stage(pipe);
stage.Init(scale,y,ring,groups,e,n,producer,bm,width,false,!striped);
if(striped)
gmg_native::ScheduleStrips(stage,groups,e,n,producer,producers,bm,width);
else
gmg_native::ScheduleResidentB(stage,groups,e,n,producer,producers,bm,width);
#endif
#endif
}
__global__ __aicore__ void grouped_matmul_gelu_phased_atomic_rows(
GM_ADDR x,GM_ADDR weight,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,GM_ADDR partial,
uint32_t fullK,uint32_t n,uint32_t e,uint32_t producers,
uint32_t bm,uint32_t width,uint32_t l0k,uint32_t bk,uint32_t segmentK,uint32_t parts,uint32_t rectangularBk){
using namespace AscendC;
KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
#if defined(__NPU_ARCH__)&& __NPU_ARCH__ == 2201
bool rectangularTile = false;
uint32_t rectangularRows = 0;
if(rectangularBk != 0){
GlobalTensor<int64_t> currentGroups;
currentGroups.SetGlobalBuffer((__gm__ int64_t*)groups);
uint32_t previous = 0;
bool oneMBlock = true,removesBRepeat = false;
for(uint32_t expert = 0;expert < e;++expert){
const uint32_t end = static_cast<uint32_t>(currentGroups.GetValue(expert));
const uint32_t rows = end - previous;
rectangularRows += rows != 0;
oneMBlock = oneMBlock && rows <= 192;
removesBRepeat = removesBRepeat || rows > 128;
previous = end;
}
if(oneMBlock && removesBRepeat){
bm = 192;width = 128;bk = rectangularBk;rectangularTile = true;
}
}
TPipe pipe;
const uint32_t nTiles =(n + width - 1)/ width;
const uint32_t groupsPerWave = parts == 4 ? producers / parts : 0;
const uint32_t outputTiles = rectangularRows * nTiles;
const uint32_t mergeWaves = groupsPerWave != 0
?(outputTiles + groupsPerWave - 1)/ groupsPerWave : 0;
const bool waveMerge = rectangularTile && parts == 4 && producers % parts == 0
&& groupsPerWave != 0 && mergeWaves <= 10 && fullK <= 131071;
if(waveMerge){
#if defined(__DAV_C220_CUBE__)
const uint32_t producer = GetBlockIdx();
GlobalTensor<int64_t> groupGm;
groupGm.SetGlobalBuffer((__gm__ int64_t*)groups);
gmg_native::ReaderPhasedRowsProducer<true> stage(pipe);
stage.Init(x,weight,partial,segmentK,n,producer,bm,width,l0k,bk,
gmg_native::FULL_A,fullK);
uint32_t start = 0,prefix = 0,produced = 0;
for(uint32_t expert = 0;expert < e;++expert){
const uint32_t end = static_cast<uint32_t>(groupGm.GetValue(expert));
const uint32_t tiles =((end - start + bm - 1)/ bm)* nTiles;
const uint32_t first =(producer + producers -(prefix * parts)% producers)% producers;
bool newOwner = true;
for(uint32_t item = first;item < tiles * parts;item += producers){
const uint32_t tile = item / parts,part = item % parts;
const uint32_t row = start + tile / nTiles * bm;
const uint32_t col = tile % nTiles * width;
const uint32_t validM = end - row < bm ? end - row : bm;
const uint32_t validN = n - col < width ? n - col : width;
const uint32_t beginK = part * segmentK;
const uint32_t length = fullK - beginK < segmentK ? fullK - beginK : segmentK;
if(newOwner){
stage.SelectPartition(x + beginK,weight + static_cast<uint64_t>(beginK)* n,length);
stage.BeginOwner(row,validM);
}
const bool lastOwner = producers % parts != 0 || item + producers >= tiles * parts
|| (item + producers) / parts / nTiles != tile / nTiles;
const gmg_native::TaskDesc task ={expert,row,col,validM,validN};
stage.Produce(task,(prefix + tile)* parts + part,lastOwner);
newOwner = lastOwner;
CrossCoreSetFlag<2,PIPE_FIX>(4 +(prefix + tile)/ groupsPerWave);
++produced;
}
prefix += tiles;start = end;
}
stage.PostCompute(produced);
for(uint32_t wave = produced;wave < mergeWaves;++wave)
CrossCoreSetFlag<2,PIPE_FIX>(4 + wave);
#else
const uint32_t producer = GetBlockIdx()/ 2;
gmg_native::AtomicPartialConsumer stage(pipe);
stage.Init(scale,y,partial,groups,e,n,producer,bm,width,false,true);
stage.SetParts(parts);
stage.InitializePartials(outputTiles,producers);
auto localGroups = stage.Groups();
for(uint32_t wave = 0;wave < mergeWaves;++wave){
CrossCoreWaitFlag<2>(4 + wave);
SyncAll();
const uint32_t targetTile = wave * groupsPerWave + producer / parts;
if(targetTile >= outputTiles)continue;
uint32_t start = 0,prefix = 0;
for(uint32_t expert = 0;expert < e;++expert){
const uint32_t end = static_cast<uint32_t>(localGroups.GetValue(expert));
const uint32_t tiles =((end - start + bm - 1)/ bm)* nTiles;
if(targetTile < prefix + tiles){
const uint32_t tile = targetTile - prefix;
const uint32_t row = start + tile / nTiles * bm;
const uint32_t col = tile % nTiles * width;
const uint32_t validM = end - row < bm ? end - row : bm;
const uint32_t validN = n - col < width ? n - col : width;
const gmg_native::TaskDesc task ={expert,row,col,validM,validN};
stage.Submit(task,targetTile);
break;
}
prefix += tiles;start = end;
}
}
stage.PostCompute(0);
#endif
}else{
#if defined(__DAV_C220_CUBE__)
const uint32_t producer = GetBlockIdx();
GlobalTensor<int64_t> groupGm;
groupGm.SetGlobalBuffer((__gm__ int64_t*)groups);
gmg_native::MultiProducer<true> stage(pipe);
stage.Init(x,weight,partial,segmentK,n,producer,bm,width,l0k,bk,
gmg_native::FULL_A,fullK);
uint32_t start = 0,prefix = 0,produced = 0;
for(uint32_t expert = 0;expert < e;++expert){
const uint32_t end = static_cast<uint32_t>(groupGm.GetValue(expert));
const uint32_t tiles =((end - start + bm - 1)/ bm)* nTiles;
const uint32_t first =(producer + producers -(prefix * parts)% producers)% producers;
bool newOwner = true;
for(uint32_t item = first;item < tiles * parts;item += producers){
const uint32_t tile = item / parts,part = item % parts;
const uint32_t row = start + tile / nTiles * bm;
const uint32_t col = tile % nTiles * width;
const uint32_t validM = end - row < bm ? end - row : bm;
const uint32_t validN = n - col < width ? n - col : width;
const uint32_t beginK = part * segmentK;
const uint32_t length = fullK - beginK < segmentK ? fullK - beginK : segmentK;
if(newOwner){
stage.SelectPartition(x + beginK,weight + static_cast<uint64_t>(beginK)* n,length);
stage.BeginOwner(row,validM);
}
const bool lastOwner = producers % parts != 0 || item + producers >= tiles * parts
|| (item + producers) / parts / nTiles != tile / nTiles;
const gmg_native::TaskDesc task ={expert,row,col,validM,validN};
stage.Produce(task,(prefix + tile)* parts + part,lastOwner);
newOwner = lastOwner;
++produced;
}
prefix += tiles;start = end;
}
stage.PostCompute(produced);
CrossCoreSetFlag<2,PIPE_FIX>(4);
#else
const uint32_t producer = GetBlockIdx()/ 2;
gmg_native::PrefetchedPartialConsumer stage(pipe);
stage.Init(scale,y,partial,groups,e,n,producer,bm,width,false,true);
stage.SetParts(parts);
auto localGroups = stage.Groups();
// Each pair first waits for its own AIC's final Fixpipe. Only then does
// the unconditional AIV barrier establish that all producers have finished.
CrossCoreWaitFlag<2>(4);
SyncAll();
uint32_t start = 0,prefix = 0;
for(uint32_t expert = 0;expert < e;++expert){
const uint32_t end = static_cast<uint32_t>(localGroups.GetValue(expert));
const uint32_t tiles =((end - start + bm - 1)/ bm)* nTiles;
const uint32_t first =(producer + producers - prefix % producers)% producers;
for(uint32_t tile = first;tile < tiles;tile += producers){
const uint32_t row = start + tile / nTiles * bm;
const uint32_t col = tile % nTiles * width;
const uint32_t validM = end - row < bm ? end - row : bm;
const uint32_t validN = n - col < width ? n - col : width;
const gmg_native::TaskDesc task ={expert,row,col,validM,validN};
stage.Submit(task,prefix + tile);
}
prefix += tiles;start = end;
}
stage.PostCompute(0);
#endif
}
#endif
}
