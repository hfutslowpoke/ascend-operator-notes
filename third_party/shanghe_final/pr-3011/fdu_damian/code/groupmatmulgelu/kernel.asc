DataCopyPad(acc,ringGm_[offset],
{static_cast<uint16_t>(packet.rows),task.validN * 4,
(width_ - task.validN)* 4,0,0},
{true,0,static_cast<uint8_t>(p8 - task.validN),0});
qC_.EnQue(acc);
if(!singleShot_ && last)CrossCoreSetFlag<2,PIPE_MTE2>(FREE_BASE + slot);
