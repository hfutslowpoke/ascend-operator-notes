+ 2ULL * bk * width;
const bool cyclicDomain = checkOwnerAlignment && bm == 128 && width == 256
&& l0k == 128 && k % 512 == 0 && cyclicL1 <= oldFullAL1;
if(cyclicDomain){
const auto currentGroups = stage.Groups();
uint32_t previous = 0;
bool partial = false;
bool singleRows = true;
for(uint32_t expert = 0;expert < e;++expert){
const uint32_t end = static_cast<uint32_t>(currentGroups.GetValue(expert));
const uint32_t rows = end - previous;
singleRows = singleRows && rows == bm;
if(rows % bm != 0){
partial = true;
break;
}
previous = end;
}
if(partial)
gmg_native::ScheduleTailWeightedColumns(stage,groups,e,n,producer,producers,bm,width,ownerG);
