const uint32_t rowTile = rows <= bm || rows % bm == 0 ? bm : bm / 2;
const uint32_t owners =((end - start + rowTile - 1)/ rowTile)* columnGroups;
const uint32_t first =(producer + producers - prefix % producers)% producers;
for(uint32_t owner = first;owner < owners;owner += producers){
const uint32_t row = start + owner / columnGroups * rowTile;
const uint32_t validM = end - row < rowTile ? end - row : rowTile;
const uint32_t group = owner % columnGroups;
const uint32_t firstColumn = group * columnsPerGroup
+(group < colRemainder ? group : colRemainder);
const uint32_t columns = columnsPerGroup +(group < colRemainder ? 1 : 0);
#if defined(__DAV_C220_CUBE__)
stage.BeginOwner(row,validM);
#endif
for(uint32_t column = 0;column < columns;++column){
const uint32_t col =(firstColumn + column)* width;
const uint32_t validN = n - col < width ? n - col : width;
const TaskDesc task ={expert,row,col,validM,validN};
#if defined(__DAV_C220_CUBE__)
stage.Produce(task,sequence,column + 1 == columns);
#else
stage.Submit(task,sequence);
#endif
++sequence;
}
}
prefix += owners;
start = end;
}
stage.PostCompute(sequence);
}
template<class Stage>
__aicore__ inline void ScheduleDeferredTailSplit(Stage& stage,GM_ADDR groups,uint32_t e,
uint32_t n,uint32_t producer,uint32_t producers,uint32_t bm,
uint32_t width,uint32_t ownerG,bool checkOwnerAlignment){
GlobalTensor<int64_t> groupGm;
groupGm.SetGlobalBuffer((__gm__ int64_t*)groups);
#if !defined(__DAV_C220_CUBE__)
auto localGroups = stage.Groups();
#endif
if(checkOwnerAlignment){
uint32_t previous = 0;
for(uint32_t expert = 0;expert < e;++expert){
#if defined(__DAV_C220_CUBE__)
const uint32_t end = static_cast<uint32_t>(groupGm.GetValue(expert));
#else
const uint32_t end = static_cast<uint32_t>(localGroups.GetValue(expert));
#endif
if((end - previous)% bm != 0){
ownerG = 1;
break;
}
previous = end;
}
}
const uint32_t nTiles =(n + width - 1)/ width;
const uint32_t columnGroups =(nTiles + ownerG - 1)/ ownerG;
const uint32_t columnsPerGroup = columnGroups == 0 ? 0 : nTiles / columnGroups;
const uint32_t colRemainder = columnGroups == 0 ? 0 : nTiles % columnGroups;
#if defined(__DAV_C220_CUBE__)
const uint32_t totalRows = static_cast<uint32_t>(groupGm.GetValue(e - 1));
#else
const uint32_t totalRows = static_cast<uint32_t>(localGroups.GetValue(e - 1));
#endif
const uint32_t lowerOwners =(totalRows + bm - 1)/ bm;
const uint32_t fullOwners = lowerOwners / producers * producers;
const bool tailCandidate = nTiles == 2 && columnGroups == 1
&& fullOwners != 0 && lowerOwners % producers != 0;
bool suffixKnown = false,splitTail = false;
uint32_t tailOwners = 0;
uint32_t start = 0,prefix = 0,sequence = 0;
for(uint32_t expert = 0;expert < e;++expert){
#if defined(__DAV_C220_CUBE__)
const uint32_t end = static_cast<uint32_t>(groupGm.GetValue(expert));
#else
const uint32_t end = static_cast<uint32_t>(localGroups.GetValue(expert));
#endif
const uint32_t rows = end - start;
const uint32_t rowTile = rows <= bm || rows % bm == 0 ? bm : bm / 2;
const uint32_t owners =((end - start + rowTile - 1)/ rowTile)* columnGroups;
if(tailCandidate && !suffixKnown && prefix + owners > fullOwners){
uint32_t totalOwners = prefix + owners,previousEnd = end;
for(uint32_t nextExpert = expert + 1;nextExpert < e;++nextExpert){
#if defined(__DAV_C220_CUBE__)
const uint32_t nextEnd = static_cast<uint32_t>(groupGm.GetValue(nextExpert));
#else
const uint32_t nextEnd = static_cast<uint32_t>(localGroups.GetValue(nextExpert));
#endif
const uint32_t nextRows = nextEnd - previousEnd;
const uint32_t step = nextRows <= bm || nextRows % bm == 0 ? bm : bm / 2;
totalOwners +=(nextRows + step - 1)/ step;
previousEnd = nextEnd;
}
tailOwners = totalOwners - fullOwners;
splitTail = tailOwners < producers && tailOwners <= producers - tailOwners;
suffixKnown = true;
}
const uint32_t first = splitTail ? 0 :(producer + producers - prefix % producers)% producers;
const uint32_t ownerStep = splitTail ? 1 : producers;
for(uint32_t owner = first;owner < owners;owner += ownerStep){
const uint32_t row = start + owner / columnGroups * rowTile;
const uint32_t validM = end - row < rowTile ? end - row : rowTile;
const uint32_t group = owner % columnGroups;
uint32_t firstColumn = group * columnsPerGroup
+(group < colRemainder ? group : colRemainder);
uint32_t columns = columnsPerGroup +(group < colRemainder ? 1 : 0);
if(splitTail){
const uint32_t globalOwner = prefix + owner;
if(globalOwner < fullOwners){
if(globalOwner % producers != producer)continue;
}else{
const uint32_t tail = globalOwner - fullOwners;
if(producer < tailOwners){
if(producer != tail)continue;
firstColumn = 0;
}else{
if(producer - tailOwners != tail)continue;
firstColumn = 1;
}
columns = 1;
}
}
#if defined(__DAV_C220_CUBE__)
stage.BeginOwner(row,validM);
#endif
for(uint32_t column = 0;column < columns;++column){
const uint32_t col =(firstColumn + column)* width;
const uint32_t validN = n - col < width ? n - col : width;
const TaskDesc task ={expert,row,col,validM,validN};
#if defined(__DAV_C220_CUBE__)
stage.Produce(task,sequence,column + 1 == columns);
#else
stage.Submit(task,sequence);
#endif
++sequence;
}
}
prefix += owners;
start = end;
}
stage.PostCompute(sequence);
}
template<bool FULL_ROWS = false,bool FINE_TAIL = false,class Stage>
__aicore__ inline void ScheduleColumnTailWave(Stage& stage,GM_ADDR groups,uint32_t e,
uint32_t n,uint32_t producer,uint32_t producers,uint32_t bm,
uint32_t width,uint32_t ownerG,bool checkOwnerAlignment){
GlobalTensor<int64_t> groupGm;
groupGm.SetGlobalBuffer((__gm__ int64_t*)groups);
#if !defined(__DAV_C220_CUBE__)
auto localGroups = stage.Groups();
#endif
if(checkOwnerAlignment){
uint32_t previous = 0;
for(uint32_t expert = 0;expert < e;++expert){
#if defined(__DAV_C220_CUBE__)
const uint32_t end = static_cast<uint32_t>(groupGm.GetValue(expert));
#else
const uint32_t end = static_cast<uint32_t>(localGroups.GetValue(expert));
#endif
if((end - previous)% bm != 0){
ownerG = 1;
break;
}
previous = end;
}
}
const uint32_t nTiles =(n + width - 1)/ width;
const uint32_t columnGroups =(nTiles + ownerG - 1)/ ownerG;
const uint32_t columnsPerGroup = columnGroups == 0 ? 0 : nTiles / columnGroups;
const uint32_t colRemainder = columnGroups == 0 ? 0 : nTiles % columnGroups;
#if defined(__DAV_C220_CUBE__)
const uint32_t totalRows = static_cast<uint32_t>(groupGm.GetValue(e - 1));
#else
const uint32_t totalRows = static_cast<uint32_t>(localGroups.GetValue(e - 1));
#endif
const uint32_t lowerOwners =(totalRows + bm - 1)/ bm;
const bool fullRows = FULL_ROWS && lowerOwners >= producers;
const uint32_t fullOwners = lowerOwners / producers * producers;
const bool tailCandidate = nTiles >= 2 && columnGroups == 1
&& fullOwners != 0 && lowerOwners % producers != 0;
bool suffixKnown = false,splitTail = false;
uint32_t tailOwners = 0;
uint32_t start = 0,prefix = 0,sequence = 0;
for(uint32_t expert = 0;expert < e;++expert){
#if defined(__DAV_C220_CUBE__)
const uint32_t end = static_cast<uint32_t>(groupGm.GetValue(expert));
#else
const uint32_t end = static_cast<uint32_t>(localGroups.GetValue(expert));
#endif
const uint32_t rows = end - start;
const uint32_t rowTile = fullRows || rows <= bm || rows % bm == 0 ? bm : bm / 2;
const uint32_t owners =((end - start + rowTile - 1)/ rowTile)* columnGroups;
if(tailCandidate && !suffixKnown && prefix + owners > fullOwners){
uint32_t totalOwners = prefix + owners,previousEnd = end;
for(uint32_t nextExpert = expert + 1;nextExpert < e;++nextExpert){
#if defined(__DAV_C220_CUBE__)
const uint32_t nextEnd = static_cast<uint32_t>(groupGm.GetValue(nextExpert));
#else
const uint32_t nextEnd = static_cast<uint32_t>(localGroups.GetValue(nextExpert));
#endif
const uint32_t nextRows = nextEnd - previousEnd;
const uint32_t step = fullRows || nextRows <= bm || nextRows % bm == 0 ? bm : bm / 2;
totalOwners +=(nextRows + step - 1)/ step;
previousEnd = nextEnd;
}
tailOwners = totalOwners - fullOwners;
splitTail = tailOwners != 0 && tailOwners <= producers / nTiles;
suffixKnown = true;
}
const uint32_t first = splitTail ? 0 :(producer + producers - prefix % producers)% producers;
const uint32_t ownerStep = splitTail ? 1 : producers;
for(uint32_t owner = first;owner < owners;owner += ownerStep){
const uint32_t row = start + owner / columnGroups * rowTile;
const uint32_t validM = end - row < rowTile ? end - row : rowTile;
const uint32_t group = owner % columnGroups;
uint32_t firstColumn = group * columnsPerGroup
+(group < colRemainder ? group : colRemainder);
uint32_t columns = columnsPerGroup +(group < colRemainder ? 1 : 0);
firstColumn *= width;
uint32_t columnWidth = width;
if(splitTail){
const uint32_t globalOwner = prefix + owner;
if(globalOwner < fullOwners){
if(globalOwner % producers != producer)continue;
}else{
const uint32_t tail = globalOwner - fullOwners;
const uint32_t columnOwner = producer / tailOwners;
if(producer % tailOwners != tail)continue;
if constexpr(FINE_TAIL){
const uint32_t strips =(n + 31)/ 32;
uint32_t parts =(producers - 1 - tail)/ tailOwners + 1;
if(parts > strips)parts = strips;
if(columnOwner >= parts)continue;
const uint32_t per = strips / parts,extra = strips % parts;
firstColumn =(columnOwner * per +(columnOwner < extra ? columnOwner : extra))* 32;
columnWidth =(per +(columnOwner < extra ? 1 : 0))* 32;
}else{
if(columnOwner >= nTiles)continue;
firstColumn = columnOwner * width;
}
columns = 1;
}
}
#if defined(__DAV_C220_CUBE__)
stage.BeginOwner(row,validM);
#endif
for(uint32_t column = 0;column < columns;++column){
const uint32_t col =firstColumn + column * width;
const uint32_t validN = n - col < columnWidth ? n - col : columnWidth;
const TaskDesc task ={expert,row,col,validM,validN};
#if defined(__DAV_C220_CUBE__)
stage.Produce(task,sequence,column + 1 == columns);
#else
stage.Submit(task,sequence);
#endif
++sequence;
}
}
prefix += owners;
start = end;
}
stage.PostCompute(sequence);
}
template<class Stage>
__aicore__ inline void ScheduleSingleMOwners(Stage& stage,uint32_t e,
uint32_t n,uint32_t producer,uint32_t producers,uint32_t bm,
uint32_t width,uint32_t ownerG){
const uint32_t nTiles =(n + width - 1)/ width;
const uint32_t columnGroups =(nTiles + ownerG - 1)/ ownerG;
const uint32_t columnsPerGroup = columnGroups == 0 ? 0 : nTiles / columnGroups;
const uint32_t colRemainder = columnGroups == 0 ? 0 : nTiles % columnGroups;
uint32_t sequence = 0;
for(uint32_t owner = producer;owner < e * columnGroups;owner += producers){
const uint32_t expert = owner / columnGroups;
const uint32_t group = owner % columnGroups;
const uint32_t row = expert * bm;
const uint32_t firstColumn = group * columnsPerGroup
+(group < colRemainder ? group : colRemainder);
const uint32_t columns = columnsPerGroup +(group < colRemainder ? 1 : 0);
#if defined(__DAV_C220_CUBE__)
stage.BeginOwner(row,bm);
#endif
for(uint32_t column = 0;column < columns;++column){
const uint32_t col =(firstColumn + column)* width;
const uint32_t validN = n - col < width ? n - col : width;
const TaskDesc task ={expert,row,col,bm,validN};
#if defined(__DAV_C220_CUBE__)
stage.Produce(task,sequence,column + 1 == columns);
#else
stage.Submit(task,sequence);
#endif
++sequence;
}
}
stage.PostCompute(sequence);
}
template<class Stage>
__aicore__ inline void ScheduleTailPairedOwners(Stage& stage,GM_ADDR groups,uint32_t e,
uint32_t n,uint32_t producer,uint32_t producers,uint32_t bm,uint32_t width,uint32_t ownerG){
GlobalTensor<int64_t> gg;gg.SetGlobalBuffer((__gm__ int64_t*)groups);
#if defined(__DAV_C220_CUBE__)
const auto endpoints=gg;
#else
const auto endpoints=stage.Groups();
#endif
uint32_t bins[16]={},previous=0,rowTiles=0,maxRows=0,fullTiles=0;
for(uint32_t expert=0;expert<e;++expert){
const uint32_t end=endpoints.GetValue(expert),rows=end-previous,tail=rows%bm;
rowTiles+=(rows+bm-1)/bm;fullTiles+=rows/bm;
if(rows>maxRows)maxRows=rows;
if(bm<=256 && tail)++bins[(tail+15)/16-1];
previous=end;
}
const uint32_t nt=(n+width-1)/width,paddedM=((maxRows<bm?maxRows:bm)+15)/16*16;
const uint32_t originalG=ownerG,tails=rowTiles-fullTiles;
uint64_t best=~uint64_t(0);
for(uint32_t split=1;split<=3;++split){
const uint32_t candidate=(originalG+split-1)/split,cg=(nt+candidate-1)/candidate;
const uint64_t waves=(static_cast<uint64_t>(rowTiles)*cg+producers-1)/producers;
const uint64_t peak=waves*(paddedM+static_cast<uint64_t>((nt+cg-1)/cg)*width);
if(peak<best){best=peak;ownerG=candidate;}
}
bool paired=false;
if(bm<=256 && tails<=16 && fullTiles<producers && rowTiles>producers && rowTiles<=producers+tails/2){
uint32_t heights[16],rank=0;
for(int32_t bin=15;bin>=0;--bin){
const uint32_t count=bins[bin];bins[bin]=rank;
for(uint32_t j=0;j<count;++j)heights[rank++]=(bin+1)*16;
}
uint64_t peak=paddedM+static_cast<uint64_t>(nt)*width;
const uint32_t extra=rowTiles-producers,firstWave=producers-fullTiles;
for(uint32_t i=0;i<extra;++i){
const uint64_t cost=2ULL*nt*width+heights[firstWave-1-i]+heights[firstWave+i];
if(cost>peak)peak=cost;
}
paired=peak<best;
}
const uint32_t cg=paired?1:(nt+ownerG-1)/ownerG,cols=nt/cg,remainder=nt%cg;
uint32_t start=0,prefix=0,fullPrefix=0,sequence=0;
for(uint32_t expert=0;expert<e;++expert){
const uint32_t end=endpoints.GetValue(expert),rows=end-start,whole=rows/bm,tiles=(rows+bm-1)/bm;
for(uint32_t mr=0;mr<tiles;++mr){
const uint32_t row=start+mr*bm,vm=end-row<bm?end-row:bm;
uint32_t assigned=0;
if(paired){
const uint32_t ticket=mr<whole?fullPrefix+mr:fullTiles+bins[(vm+15)/16-1]++;
assigned=ticket<producers?ticket:2*producers-1-ticket;
}
for(uint32_t group=0;group<cg;++group){
if((paired?assigned:(prefix+mr*cg+group)%producers)!=producer)continue;
const uint32_t first=group*cols+(group<remainder?group:remainder),count=cols+(group<remainder);
#if defined(__DAV_C220_CUBE__)
stage.BeginOwner(row,vm);
#endif
for(uint32_t j=0;j<count;++j){
const uint32_t col=(first+j)*width,vn=n-col<width?n-col:width;
const TaskDesc task={expert,row,col,vm,vn};
#if defined(__DAV_C220_CUBE__)
stage.Produce(task,sequence,j+1==count);
#else
stage.Submit(task,sequence);
#endif
++sequence;
}
}
}
fullPrefix+=whole;prefix+=tiles*cg;start=end;
}
stage.PostCompute(sequence);
}
template<bool STREAM_COLUMNS = false,class Stage>
__aicore__ inline void Schedule(Stage& stage,GM_ADDR groups,uint32_t e,
uint32_t n,uint32_t producer,uint32_t producers,uint32_t bm,
uint32_t width,uint32_t ownerG,bool checkOwnerAlignment,bool columnMajor=false,
uint32_t rowGroup=0){
GlobalTensor<int64_t> groupGm;
groupGm.SetGlobalBuffer((__gm__ int64_t*)groups);
#if !defined(__DAV_C220_CUBE__)
auto localGroups = stage.Groups();
#endif
if(checkOwnerAlignment){
uint32_t previous = 0;
for(uint32_t expert = 0;expert < e;++expert){
#if defined(__DAV_C220_CUBE__)
const uint32_t end = static_cast<uint32_t>(groupGm.GetValue(expert));
#else
const uint32_t end = static_cast<uint32_t>(localGroups.GetValue(expert));
#endif
if((end - previous)% bm != 0){
ownerG = 1;
break;
}
previous = end;
}
}
const uint32_t nTiles =(n + width - 1)/ width;
const uint32_t columnGroups =(nTiles + ownerG - 1)/ ownerG;
const uint32_t columnsPerGroup = columnGroups == 0 ? 0 : nTiles / columnGroups;
const uint32_t colRemainder = columnGroups == 0 ? 0 : nTiles % columnGroups;
uint32_t start = 0,prefix = 0,sequence = 0;
for(uint32_t expert = 0;expert < e;++expert){
#if defined(__DAV_C220_CUBE__)
const uint32_t end = static_cast<uint32_t>(groupGm.GetValue(expert));
#else
const uint32_t end = static_cast<uint32_t>(localGroups.GetValue(expert));
#endif
const uint32_t rowTiles=(end-start+bm-1)/bm;
const uint32_t owners=rowTiles*columnGroups;
const uint32_t first =(producer + producers - prefix % producers)% producers;
for(uint32_t owner = first;owner < owners;owner += producers){
uint32_t rowIndex=owner/columnGroups,group=owner%columnGroups;
if constexpr (STREAM_COLUMNS) {
    if (columnMajor && (rowGroup == 0 || rowTiles > producers)) {
        uint32_t firstRow = 0, span = rowTiles, offset = owner;
        if (rowGroup != 0) {
            firstRow = owner / (rowGroup * columnGroups) * rowGroup;
            span = rowTiles - firstRow < rowGroup ? rowTiles - firstRow : rowGroup;
            offset = owner - firstRow * columnGroups;
        }
        rowIndex = firstRow + offset % span;
        group = offset / span;
    }
}
const uint32_t row=start+rowIndex*bm;
const uint32_t validM=end-row<bm?end-row:bm;
const uint32_t firstColumn = group * columnsPerGroup
+(group < colRemainder ? group : colRemainder);
const uint32_t columns = columnsPerGroup +(group < colRemainder ? 1 : 0);
#if defined(__DAV_C220_CUBE__)
stage.BeginOwner(row,validM);
#endif
for(uint32_t column = 0;column < columns;++column){
const uint32_t col =(firstColumn + column)* width;
const uint32_t validN = n - col < width ? n - col : width;
const TaskDesc task ={expert,row,col,validM,validN};
#if defined(__DAV_C220_CUBE__)
stage.Produce(task,sequence,column + 1 == columns);
#else
stage.Submit(task,sequence);
#endif
++sequence;
}
}
prefix += owners;
start = end;
}
stage.PostCompute(sequence);
}
template<class Stage>
__aicore__ inline void ScheduleTailPrefix(Stage& stage,GM_ADDR groups,uint32_t e,
uint32_t n,uint32_t producer,uint32_t producers,uint32_t bm,
uint32_t width,uint32_t ownerG,bool checkOwnerAlignment){
GlobalTensor<int64_t> groupGm;
groupGm.SetGlobalBuffer((__gm__ int64_t*)groups);
#if !defined(__DAV_C220_CUBE__)
auto localGroups = stage.Groups();
#endif
if(checkOwnerAlignment){
uint32_t previous = 0;
for(uint32_t expert = 0;expert < e;++expert){
#if defined(__DAV_C220_CUBE__)
const uint32_t end = static_cast<uint32_t>(groupGm.GetValue(expert));
#else
const uint32_t end = static_cast<uint32_t>(localGroups.GetValue(expert));
#endif
if((end - previous)% bm != 0){
ownerG = 1;
break;
}
previous = end;
}
}
const uint32_t nTiles =(n + width - 1)/ width;
const uint32_t columnGroups =(nTiles + ownerG - 1)/ ownerG;
const uint32_t columnsPerGroup = columnGroups == 0 ? 0 : nTiles / columnGroups;
const uint32_t colRemainder = columnGroups == 0 ? 0 : nTiles % columnGroups;
bool splitTail = false;
uint32_t fullOwners = 0,tailOwners = 0,tailWorkers = 0;
uint32_t mainColumns = 0,suffixColumns = 0;
if(ownerG >= nTiles && n % width == 0 && nTiles > 1){
uint32_t previous = 0,totalOwners = 0;
bool aligned = true;
for(uint32_t expert = 0;expert < e;++expert){
#if defined(__DAV_C220_CUBE__)
const uint32_t end = static_cast<uint32_t>(groupGm.GetValue(expert));
#else
const uint32_t end = static_cast<uint32_t>(localGroups.GetValue(expert));
#endif
const uint32_t rows = end - previous;
if(rows % bm != 0){
aligned = false;
break;
}
totalOwners += rows / bm;
previous = end;
}
fullOwners = totalOwners / producers * producers;
tailOwners = totalOwners % producers;
if(aligned && fullOwners != 0 && tailOwners != 0){
tailWorkers = producers - tailOwners;
uint32_t bestPeak = nTiles;
for(uint32_t columns = 1;columns < nTiles;++columns){
const uint32_t suffix = nTiles - columns;
if(suffix > tailWorkers)continue;
const uint32_t sharedPeak =(tailOwners * suffix + tailWorkers - 1)/ tailWorkers;
const uint32_t peak = columns > sharedPeak ? columns : sharedPeak;
if(peak <= bestPeak){
bestPeak = peak;
mainColumns = columns;
}
}
splitTail = bestPeak < nTiles;
suffixColumns = nTiles - mainColumns;
}
}
uint32_t start = 0,prefix = 0,sequence = 0;
for(uint32_t expert = 0;expert < e;++expert){
#if defined(__DAV_C220_CUBE__)
const uint32_t end = static_cast<uint32_t>(groupGm.GetValue(expert));
#else
const uint32_t end = static_cast<uint32_t>(localGroups.GetValue(expert));
#endif
const uint32_t owners =((end - start + bm - 1)/ bm)* columnGroups;
const uint32_t first = splitTail ? 0 :(producer + producers - prefix % producers)% producers;
const uint32_t ownerStep = splitTail ? 1 : producers;
for(uint32_t owner = first;owner < owners;owner += ownerStep){
const uint32_t row = start + owner / columnGroups * bm;
const uint32_t validM = end - row < bm ? end - row : bm;
const uint32_t group = owner % columnGroups;
uint32_t firstColumn = group * columnsPerGroup
+(group < colRemainder ? group : colRemainder);
uint32_t columns = columnsPerGroup +(group < colRemainder ? 1 : 0);
if(splitTail){
const uint32_t globalOwner = prefix + owner;
if(globalOwner < fullOwners){
if(globalOwner % producers != producer)continue;
}else{
const uint32_t tail = globalOwner - fullOwners;
if(producer < tailOwners){
if(producer != tail)continue;
columns = mainColumns;
}else{
const uint32_t suffix =(producer - tailOwners + tailWorkers
-(tail * suffixColumns)% tailWorkers)% tailWorkers;
if(suffix >= suffixColumns)continue;
firstColumn = mainColumns + suffix;
columns = 1;
}
}
}
#if defined(__DAV_C220_CUBE__)
stage.BeginOwner(row,validM);
#endif
for(uint32_t column = 0;column < columns;++column){
const uint32_t col =(firstColumn + column)* width;
const uint32_t validN = n - col < width ? n - col : width;
const TaskDesc task ={expert,row,col,validM,validN};
#if defined(__DAV_C220_CUBE__)
stage.Produce(task,sequence,column + 1 == columns);
#else
stage.Submit(task,sequence);
#endif
++sequence;
}
}
prefix += owners;
start = end;
}
stage.PostCompute(sequence);
}
template<class Stage>
__aicore__ inline void SchedulePaddedTailWave(Stage& stage,GM_ADDR groups,uint32_t e,
uint32_t n,uint32_t producer,uint32_t producers,uint32_t bm,uint32_t width,uint32_t ownerG){
GlobalTensor<int64_t> groupGm;
groupGm.SetGlobalBuffer((__gm__ int64_t*)groups);
#if !defined(__DAV_C220_CUBE__)
auto localGroups=stage.Groups();
#endif
const uint32_t nTiles=(n+width-1)/width;
const uint32_t columnGroups=(nTiles+ownerG-1)/ownerG;
const uint32_t perGroup=nTiles/columnGroups,extra=nTiles%columnGroups;
uint32_t totalOwners=0,previous=0;
for(uint32_t expert=0;expert<e;++expert){
#if defined(__DAV_C220_CUBE__)
const uint32_t end=static_cast<uint32_t>(groupGm.GetValue(expert));
#else
const uint32_t end=static_cast<uint32_t>(localGroups.GetValue(expert));
#endif
totalOwners+=((end-previous+bm-1)/bm)*columnGroups;
previous=end;
}
const uint32_t full=totalOwners/producers*producers,tail=totalOwners%producers;
const uint32_t helpers=producers-tail;
uint32_t cut=0;
if(columnGroups==1 && full && tail && n>width && n<=2*width && n%32==0 && width%32==0){
const uint32_t jobs=(tail+helpers-1)/helpers,units=n/32;
uint32_t best=units;
for(uint32_t left=units/2;left<units;++left){
const uint32_t right=units-left;
if(left*32>width || right*32>width)continue;
const uint32_t shared=jobs*right,peak=left>shared?left:shared;
if(peak<best){best=peak;cut=left*32;}
}
}
uint32_t ticket=producer,prefix=0,start=0,sequence=0;
for(uint32_t expert=0;expert<e;++expert){
#if defined(__DAV_C220_CUBE__)
const uint32_t end=static_cast<uint32_t>(groupGm.GetValue(expert));
#else
const uint32_t end=static_cast<uint32_t>(localGroups.GetValue(expert));
#endif
const uint32_t owners=((end-start+bm-1)/bm)*columnGroups;
while(ticket<prefix+owners){
const uint32_t owner=ticket-prefix,row=start+owner/columnGroups*bm;
const uint32_t vm=end-row<bm?end-row:bm,group=owner%columnGroups;
const uint32_t first=group*perGroup+(group<extra?group:extra);
uint32_t begin=first*width,limit=n-begin<(perGroup+(group<extra))*width?n:begin+(perGroup+(group<extra))*width;
const bool shared=cut && ticket>=full;
if(shared){begin=producer<tail?0:cut;limit=producer<tail?cut:n;}
#if defined(__DAV_C220_CUBE__)
stage.BeginOwner(row,vm);
#endif
for(uint32_t col=begin;col<limit;col+=width){
const uint32_t vn=limit-col<width?limit-col:width;
const TaskDesc task={expert,row,col,vm,vn};
#if defined(__DAV_C220_CUBE__)
stage.Produce(task,sequence,col+width>=limit);
#else
stage.Submit(task,sequence);
#endif
++sequence;
}
if(shared)ticket=producer<tail?totalOwners:ticket+helpers;
else{
ticket+=producers;
if(cut && ticket>=full)ticket=full+(producer<tail?producer:producer-tail);
}
}
prefix+=owners;start=end;
}
stage.PostCompute(sequence);
}
template<class Stage>
__aicore__ inline void ScheduleAlignedSingleMOwners(Stage& stage,GM_ADDR groups,
uint32_t e,uint32_t n,uint32_t producer,uint32_t producers,
uint32_t bm,uint32_t width,uint32_t ownerG,bool checkOwnerAlignment){
if(!checkOwnerAlignment){
Schedule(stage,groups,e,n,producer,producers,bm,width,ownerG,false);
return;
}
GlobalTensor<int64_t> groupGm;
groupGm.SetGlobalBuffer((__gm__ int64_t*)groups);
#if !defined(__DAV_C220_CUBE__)
auto localGroups = stage.Groups();
#endif
uint32_t previous = 0;
bool singleRows = true;
for(uint32_t expert = 0;expert < e;++expert){
#if defined(__DAV_C220_CUBE__)
const uint32_t end = static_cast<uint32_t>(groupGm.GetValue(expert));
#else
const uint32_t end = static_cast<uint32_t>(localGroups.GetValue(expert));
#endif
const uint32_t rows = end - previous;
singleRows = singleRows && rows == bm;
if(rows % bm != 0){
ownerG = 1;
break;
}
previous = end;
}
if(singleRows)
ScheduleSingleMOwners(stage,e,n,producer,producers,bm,width,ownerG);
else
Schedule(stage,groups,e,n,producer,producers,bm,width,ownerG,false);
}
template<bool SINGLE_M_OWNERS = false,class Stage>
__aicore__ inline void ScheduleColumnWorkgroups(Stage& stage,GM_ADDR groups,
uint32_t e,uint32_t n,uint32_t producer,uint32_t producers,
uint32_t bm,uint32_t width,uint32_t ownerG,bool checkOwnerAlignment){
GlobalTensor<int64_t> groupGm;
groupGm.SetGlobalBuffer((__gm__ int64_t*)groups);
#if !defined(__DAV_C220_CUBE__)
auto localGroups = stage.Groups();
#endif
uint32_t previous = 0,rowBlocks = 0,longBlocks = 0,shortBlocks = 0,largestShortPad = 0;
bool allAligned = true;
bool singleRows = true;
for(uint32_t expert = 0;expert < e;++expert){
#if defined(__DAV_C220_CUBE__)
const uint32_t end = static_cast<uint32_t>(groupGm.GetValue(expert));
#else
const uint32_t end = static_cast<uint32_t>(localGroups.GetValue(expert));
#endif
const uint32_t rows = end - previous;
if constexpr(SINGLE_M_OWNERS)singleRows = singleRows && rows == bm;
rowBlocks +=(rows + bm - 1)/ bm;
longBlocks += rows / bm;
const uint32_t tail = rows % bm;
if(tail != 0){
if(tail >=(bm + 1)/ 2)++longBlocks;
else{
++shortBlocks;
const uint32_t padded =(tail + 15)/ 16 * 16;
if(padded > largestShortPad)largestShortPad = padded;
}
}
allAligned = allAligned && rows % bm == 0;
previous = end;
}
const uint32_t nTiles =(n + width - 1)/ width;
const uint32_t columnsPerOwner =(rowBlocks * nTiles + producers - 1)/ producers;
if(longBlocks != 0 && shortBlocks != 0){
const uint32_t longColumns =(longBlocks * nTiles + producers - 1)/ producers;
const uint32_t longGroups =(nTiles + longColumns - 1)/ longColumns;
const uint32_t longWorkers = longBlocks * longGroups;
if(longWorkers < producers && longColumns < columnsPerOwner){
const uint32_t shortWorkers = producers - longWorkers;
const uint32_t shortWaves =(shortBlocks + shortWorkers - 1)/ shortWorkers;
if(shortBlocks <= shortWorkers
&& static_cast<uint64_t>(shortWaves)* largestShortPad * nTiles
<= static_cast<uint64_t>(bm)* longColumns){
const bool longWorker = producer < longWorkers;
const uint32_t ownedLong = longWorker ? producer / longGroups : 0;
const uint32_t firstColumn = longWorker ? producer % longGroups * longColumns : 0;
const uint32_t columns = longWorker
?(nTiles - firstColumn < longColumns ? nTiles - firstColumn : longColumns)
: nTiles;
uint32_t start = 0,longIndex = 0,shortIndex = 0,sequence = 0;
for(uint32_t expert = 0;expert < e;++expert){
#if defined(__DAV_C220_CUBE__)
const uint32_t end = static_cast<uint32_t>(groupGm.GetValue(expert));
#else
const uint32_t end = static_cast<uint32_t>(localGroups.GetValue(expert));
#endif
for(uint32_t row = start;row < end;row += bm){
const uint32_t validM = end - row < bm ? end - row : bm;
const bool shortBlock = validM <(bm + 1)/ 2;
const uint32_t index = shortBlock ? shortIndex++ : longIndex++;
const bool owned = longWorker
? !shortBlock && index == ownedLong
: shortBlock && index % shortWorkers == producer - longWorkers;
if(!owned)continue;
#if defined(__DAV_C220_CUBE__)
stage.BeginOwner(row,validM);
#endif
for(uint32_t column = 0;column < columns;++column){
const uint32_t col =(firstColumn + column)* width;
const uint32_t validN = n - col < width ? n - col : width;
const TaskDesc task ={expert,row,col,validM,validN};
#if defined(__DAV_C220_CUBE__)
stage.Produce(task,sequence,column + 1 == columns);
#else
stage.Submit(task,sequence);
#endif
++sequence;
}
}
start = end;
}
stage.PostCompute(sequence);
return;
}
}
}
const uint32_t fullColumnGroups = nTiles / columnsPerOwner;
const uint32_t tailColumns = nTiles % columnsPerOwner;
const uint32_t mainOwners = rowBlocks * fullColumnGroups;
const bool useGroups = mainOwners <= producers &&(tailColumns == 0
||(mainOwners < producers
&&((rowBlocks + producers - mainOwners - 1)/(producers - mainOwners))
* tailColumns < columnsPerOwner));
if(!useGroups){
if(checkOwnerAlignment && !allAligned)ownerG = 1;
Schedule(stage,groups,e,n,producer,producers,bm,width,ownerG,false);
return;
}
if constexpr(SINGLE_M_OWNERS){
if(singleRows && tailColumns == 0){
ScheduleSingleMOwners(stage,e,n,producer,producers,bm,width,columnsPerOwner);
return;
}
}
const bool mainWorker = producer < mainOwners;
if(!mainWorker && tailColumns == 0){
stage.PostCompute(0);
return;
}
const uint32_t tailWorkers = producers - mainOwners;
const uint32_t firstColumn = mainWorker
? producer % fullColumnGroups * columnsPerOwner : fullColumnGroups * columnsPerOwner;
const uint32_t columns = mainWorker ? columnsPerOwner : tailColumns;
uint32_t start = 0,rowPrefix = 0,sequence = 0;
for(uint32_t expert = 0;expert < e;++expert){
#if defined(__DAV_C220_CUBE__)
const uint32_t end = static_cast<uint32_t>(groupGm.GetValue(expert));
#else
const uint32_t end = static_cast<uint32_t>(localGroups.GetValue(expert));
#endif
const uint32_t expertRows =(end - start + bm - 1)/ bm;
uint32_t firstRow,rowStep;
if(mainWorker){
const uint32_t ownedRow = producer / fullColumnGroups;
firstRow = ownedRow >= rowPrefix ? ownedRow - rowPrefix : expertRows;
rowStep = expertRows;
}else{
firstRow =(producer - mainOwners + tailWorkers - rowPrefix % tailWorkers)% tailWorkers;
rowStep = tailWorkers;
}
for(uint32_t block = firstRow;block < expertRows;block += rowStep){
const uint32_t row = start + block * bm;
const uint32_t validM = end - row < bm ? end - row : bm;
#if defined(__DAV_C220_CUBE__)
stage.BeginOwner(row,validM);
#endif
for(uint32_t column = 0;column < columns;++column){
const uint32_t col =(firstColumn + column)* width;
const uint32_t validN = n - col < width ? n - col : width;
const TaskDesc task ={expert,row,col,validM,validN};
#if defined(__DAV_C220_CUBE__)
stage.Produce(task,sequence,column + 1 == columns);
#else
stage.Submit(task,sequence);
#endif
++sequence;
}
}
rowPrefix += expertRows;
start = end;
}
stage.PostCompute(sequence);
}
template<class Stage>
__aicore__ inline void ScheduleNearUniform(Stage& stage,GM_ADDR groups,
uint32_t e,uint32_t n,uint32_t producer,uint32_t producers,
uint32_t rowTile){
GlobalTensor<int64_t> groupGm;
groupGm.SetGlobalBuffer((__gm__ int64_t*)groups);
#if !defined(__DAV_C220_CUBE__)
auto localGroups = stage.Groups();
#endif
const uint32_t rowCapacity = rowTile + CUBE_ROW_ALIGN;
const uint32_t longPhase = producers / 2;
uint32_t start = 0,normalPrefix = 0,longPrefix = 0,sequence = 0;
for(uint32_t expert = 0;expert < e;++expert){
#if defined(__DAV_C220_CUBE__)
const uint32_t end = static_cast<uint32_t>(groupGm.GetValue(expert));
#else
const uint32_t end = static_cast<uint32_t>(localGroups.GetValue(expert));
#endif
const uint32_t rows = end - start;
if(rows > rowTile && rows <= rowCapacity){
if((longPrefix + longPhase)% producers == producer){
const TaskDesc task ={expert,start,0,rows,n};
#if defined(__DAV_C220_CUBE__)
stage.BeginOwner(start,rows);
stage.Produce(task,sequence,true);
#else
stage.Submit(task,sequence);
#endif
++sequence;
}
++longPrefix;
}else{
const uint32_t owners =(rows + rowTile - 1)/ rowTile;
const uint32_t first =(producer + producers - normalPrefix % producers)% producers;
for(uint32_t owner = first;owner < owners;owner += producers){
const uint32_t row = start + owner * rowTile;
const uint32_t validM = end - row < rowTile ? end - row : rowTile;
const TaskDesc task ={expert,row,0,validM,n};
#if defined(__DAV_C220_CUBE__)
stage.BeginOwner(row,validM);
stage.Produce(task,sequence,true);
#else
stage.Submit(task,sequence);
#endif
++sequence;
}
normalPrefix += owners;
}
start = end;
}
stage.PostCompute(sequence);
}
template<uint32_t ROW_TILE,class Stage>
__aicore__ inline void ScheduleShortExpertsFirst(Stage& stage,GM_ADDR groups,
uint32_t e,uint32_t n,uint32_t producer,uint32_t producers,GM_ADDR controlAddress,
uint32_t vectorMaximum){
GlobalTensor<int64_t> groupGm;
groupGm.SetGlobalBuffer((__gm__ int64_t*)groups);
#if !defined(__DAV_C220_CUBE__)
auto localGroups=stage.Groups();
#endif
constexpr uint32_t capacity=ROW_TILE+CUBE_ROW_ALIGN;
uint32_t phase=0,sequence=0;
for(uint32_t base=0;base<e;base+=producers){
uint32_t lane=producer+phase;
if(lane>=producers)lane-=producers;
++phase;
if(phase==producers)phase=0;
const uint32_t expert=base+lane;
if(expert>=e)continue;
#if defined(__DAV_C220_CUBE__)
const uint32_t end=static_cast<uint32_t>(groupGm.GetValue(expert));
const uint32_t start=expert==0?0:static_cast<uint32_t>(groupGm.GetValue(expert-1));
#else
const uint32_t end=static_cast<uint32_t>(localGroups.GetValue(expert));
const uint32_t start=expert==0?0:static_cast<uint32_t>(localGroups.GetValue(expert-1));
#endif
const uint32_t rows=end-start;
if(rows==0 || rows>capacity)continue;
const TaskDesc task={expert,start,0,rows,n};
#if defined(__DAV_C220_CUBE__)
stage.BeginOwner(start,rows);
stage.Produce(task,sequence,true);
#else
stage.Submit(task,sequence);
#endif
++sequence;
}
#if defined(__DAV_C220_CUBE__)
GlobalTensor<uint32_t> control;
control.SetGlobalBuffer((__gm__ uint32_t*)controlAddress);
CrossCoreWaitFlag<2>(4);
DataCacheCleanAndInvalid<uint32_t,CacheLine::SINGLE_CACHE_LINE>(control);
const uint32_t maximum=control.GetValue(0);
#else
const uint32_t maximum=vectorMaximum;
#endif
if(maximum>capacity){
uint32_t previous=0,prefix=0;
for(uint32_t expert=0;expert<e;++expert){
#if defined(__DAV_C220_CUBE__)
const uint32_t end=static_cast<uint32_t>(groupGm.GetValue(expert));
#else
const uint32_t end=static_cast<uint32_t>(localGroups.GetValue(expert));
#endif
const uint32_t rows=end-previous;
if(rows>capacity){
const uint32_t owners=(rows+ROW_TILE-1)/ROW_TILE;
const uint32_t first=(producer+producers-prefix%producers)%producers;
for(uint32_t owner=first;owner<owners;owner+=producers){
const uint32_t row=previous+owner*ROW_TILE;
const uint32_t live=end-row<ROW_TILE?end-row:ROW_TILE;
const TaskDesc task={expert,row,0,live,n};
#if defined(__DAV_C220_CUBE__)
stage.BeginOwner(row,live);
stage.Produce(task,sequence,true);
#else
stage.Submit(task,sequence);
#endif
++sequence;
}
prefix+=owners;
}
previous=end;
}
}
stage.PostCompute(sequence);
}
#if !defined(__DAV_C220_CUBE__)
__aicore__ inline uint32_t PublishMaximumExpertRows(TPipe& pipe,
const LocalTensor<int64_t>& groups,GM_ADDR control,uint32_t e){
const uint32_t count =(e + 63)/ 64 * 64;
TBuf<TPosition::VECCALC> work;
pipe.InitBuffer(work,3 * count * sizeof(uint32_t)+ 32);
auto indices = work.Get<uint32_t>();
auto current = work.Get<int32_t>()[count];
auto previous = work.Get<int32_t>()[2 * count];
auto maximum = work.Get<float>()[3 * count];
auto words = groups.ReinterpretCast<int32_t>();
auto mte2ToVector = pipe.FetchEventID(HardEvent::MTE2_V);
SetFlag<HardEvent::MTE2_V>(mte2ToVector);
WaitFlag<HardEvent::MTE2_V>(mte2ToVector);
CreateVecIndex(indices.ReinterpretCast<int32_t>(),int32_t(0),count);PipeBarrier<PIPE_V>();
ShiftLeft(indices,indices,uint32_t(3),count);PipeBarrier<PIPE_V>();
Mins(indices.ReinterpretCast<int32_t>(),indices.ReinterpretCast<int32_t>(),
static_cast<int32_t>((e - 1)* 8),count);PipeBarrier<PIPE_V>();
Gather(current,words,indices,uint32_t(0),count);PipeBarrier<PIPE_V>();
Adds(indices.ReinterpretCast<int32_t>(),indices.ReinterpretCast<int32_t>(),int32_t(-8),count);
PipeBarrier<PIPE_V>();
Maxs(indices.ReinterpretCast<int32_t>(),indices.ReinterpretCast<int32_t>(),int32_t(0),count);
PipeBarrier<PIPE_V>();
Gather(previous,words,indices,uint32_t(0),count);PipeBarrier<PIPE_V>();
Sub(current,current,previous,count);PipeBarrier<PIPE_V>();
auto values = current.ReinterpretCast<float>();
Cast(values,current,RoundMode::CAST_RINT,count);PipeBarrier<PIPE_V>();
Duplicate(maximum,0.0f,8);PipeBarrier<PIPE_V>();
WholeReduceMax(maximum,values,64,count / 64,1,1,8,ReduceOrder::ORDER_ONLY_VALUE);
PipeBarrier<PIPE_V>();
auto vectorToScalar = pipe.FetchEventID(HardEvent::V_S);
SetFlag<HardEvent::V_S>(vectorToScalar);
WaitFlag<HardEvent::V_S>(vectorToScalar);
uint32_t result = static_cast<uint32_t>(groups.GetValue(0));
for(uint32_t repeat = 0;repeat < count / 64;++repeat){
const uint32_t value = static_cast<int32_t>(maximum.GetValue(repeat));
if(value > result)result = value;
}
maximum.ReinterpretCast<uint32_t>().SetValue(0,result);
auto scalarToDma = pipe.FetchEventID(HardEvent::S_MTE3);
SetFlag<HardEvent::S_MTE3>(scalarToDma);
WaitFlag<HardEvent::S_MTE3>(scalarToDma);
if(GetSubBlockIdx()== 0){
GlobalTensor<uint32_t> output;
output.SetGlobalBuffer((__gm__ uint32_t*)control);
DataCopy(output,maximum.ReinterpretCast<uint32_t>(),8);
}
CrossCoreSetFlag<2,PIPE_MTE3>(4);
return result;
}
#endif
#endif
}
namespace gmg_tc = gmg_native::gmg_tc;
extern "C" __global__ __aicore__ void grouped_matmul_gelu_native_unified(
	GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groups, GM_ADDR y, GM_ADDR ring,
	GM_ADDR weightNz,
	uint32_t m, uint32_t k, uint32_t n, uint32_t e, uint32_t producers,
	uint32_t bm, uint32_t width, uint32_t l0k, uint32_t bk, uint32_t ownerG,
	uint32_t mode, uint32_t slots, bool singleShot, uint32_t tcOn, uint32_t planL1) {
	using namespace AscendC;
	KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
#if defined(__NPU_ARCH__) && __NPU_ARCH__ == 2201
	if (planL1 != 0) {
		const uint32_t tiles[8][3] = {
			{64, 256, 128}, {64, 512, 64}, {128, 256, 128}, {256, 128, 128},
			{512, 64, 64}, {96, 320, 96}, {160, 192, 128}, {192, 160, 128}};
		uint64_t rows[8] = {}, loads[8] = {}, padded = 0, selectedRows = 0;
		uint32_t previous = 0, largestRows = 0;
		GlobalTensor<int64_t> ends;
		ends.SetGlobalBuffer((__gm__ int64_t *)groups);
		for (uint32_t expert = 0; expert < e; ++expert) {
			const uint32_t end = ends.GetValue(expert), count = end - previous;
			if (count > largestRows) largestRows = count;
			padded += (uint64_t(count) + 15) / 16 * 16;
			for (uint32_t i = 0; i < 8; ++i) {
				const uint32_t tile = tiles[i][0], tail = count % tile;
				rows[i] += (uint64_t(count) + tile - 1) / tile;
				loads[i] += count / tile * (tile >= 256 ? 1 : tile / 16) + (tail == 0 ? 0 : (tail >= 241 ? 1 : (tail + 15) / 16));
			}
			previous = end;
		}
		const uint32_t kp = (k + 31) / 32 * 32;
		const uint64_t macs = padded * ((uint64_t(n) + 31) / 32 * 32) * kp;
		uint64_t best = ~0ULL;
		for (uint32_t i = 0; i < 8; ++i) {
			if (i != 3) continue;
			const uint32_t tm = tiles[i][0] < largestRows ? tiles[i][0] : (largestRows + 15) / 16 * 16, tn = tiles[i][1], tk = tiles[i][2];
			const bool full = uint64_t(tm) * kp + 2ULL * tn * tk <= planL1;
			uint32_t depth = full ? (planL1 - uint64_t(tm) * kp) / (2 * tn) / tk * tk
														: planL1 / (2 * (tm + tn)) / tk * tk;
			if (depth > 4 * tk) depth = 4 * tk;
			if (depth == 0) continue;
			const uint32_t nt = (n + tn - 1) / tn;
			for (uint32_t q = 0; q < (full ? 3u : 1u); ++q) {
				uint32_t g = q == 0 ? 1 : (q == 1 ? nt : uint64_t(nt) * rows[i] / producers);
				if (g < 1) g = 1;
				if (g > nt) g = nt;
				const uint32_t cg = (nt + g - 1) / g;
				const uint64_t owners = rows[i] * cg, waves = (owners + producers - 1) / producers;
				const uint64_t bytes = uint64_t(previous) * k * cg + rows[i] * k * n;
				const uint64_t tasks = rows[i] * nt, peak = waves * ((nt + cg - 1) / cg);
				const uint64_t issues = loads[i] * nt * ((kp + tk - 1) / tk) + tasks * (kp / 32);
				const uint64_t score = bytes * 25 + 8 * peak * macs / tasks + 400000 * tasks + 4096 * issues;
				if (score < best) {
					best = score;
					bm = tm;
					width = tn;
					l0k = tk;
					bk = depth;
					ownerG = g;
					selectedRows = rows[i];
					mode = full ? gmg_native::FULL_A : gmg_native::STREAM;
				}
			}
		}
		if (mode == gmg_native::FULL_A && ownerG > 1) {
			const uint32_t nt = (n + width - 1) / width;
			const uint32_t cg = (nt + ownerG - 1) / ownerG;
			const uint32_t columns = (nt + cg - 1) / cg;
			const uint64_t owners = selectedRows * cg;
			const uint64_t waves = (owners + producers - 1) / producers;
			const uint64_t finePeak = (selectedRows * nt + producers - 1) / producers;
			const bool uneven = owners < producers || (2ULL * largestRows >= previous && owners % producers != 0);
			if (uneven && finePeak < waves * columns && finePeak * (bm + width) <= waves * (bm + uint64_t(columns) * width))
				ownerG = 1;
		}
	}
	const bool fullB = mode == 3;
	if (fullB) mode = gmg_native::STREAM;
	const bool tcRun = (tcOn != 0) && (mode == gmg_native::STREAM);
	const bool rawStream = !fullB && mode == gmg_native::STREAM && !tcRun && ownerG == 1;
	const bool fullColumns = rawStream && (n <= 2 * width || uint64_t(k) * bm <= 2ULL * bk * width);
	// Bound the A stripe by eight aggregate double-buffer packet working sets.
	const uint32_t rowGroup = rawStream && !fullColumns && uint64_t(k) * bm <= 8ULL * bk * (bm + width) ? 2 * producers : 0;
	const bool streamTurn = fullColumns || rowGroup != 0;
	const bool checkOwnerAlignment = mode == gmg_native::FULL_A && ownerG > 1 && m % bm == 0 && n % width == 0 && k % l0k == 0 && m / bm < producers;
	TPipe pipe;
#if defined(__DAV_C220_CUBE__)
	const uint32_t producer = GetBlockIdx();
	const uint64_t cyclicL1 = 2ULL * (4ULL * l0k) * (bm + width);
	const uint64_t oldFullAL1 = static_cast<uint64_t>(bm) * ((k + 31) / 32 * 32) + 2ULL * bk * width;
	const bool cyclicDomain = checkOwnerAlignment && bm == 128 && width == 256 && l0k == 128 && k % 512 == 0 && cyclicL1 <= oldFullAL1;
	if (fullB) {
		gmg_native::MultiProducer<false, false, false, false, false, false, true> stage(pipe);
		stage.Init(x, weight, ring, k, n, producer, bm, width, l0k, bk, mode);
		gmg_native::Schedule(stage, groups, e, n, producer, producers, bm, width, 1, false);
	} else if (cyclicDomain) {
		GlobalTensor<int64_t> groupGm;
		groupGm.SetGlobalBuffer((__gm__ int64_t *)groups);
		uint32_t previous = 0;
		bool partial = false;
		for (uint32_t expert = 0; expert < e; ++expert) {
			const uint32_t end = static_cast<uint32_t>(groupGm.GetValue(expert));
			if ((end - previous) % bm != 0) {
				partial = true;
				break;
			}
			previous = end;
		}
		if (partial) {
			gmg_native::CyclicProducer<128, 256, 512, 128> stage(pipe);
			stage.Init(x, weight, ring, k, n, producer);
			gmg_native::Schedule(stage, groups, e, n, producer, producers, bm, width, 1, false);
		} else {
			gmg_native::MultiProducer<> stage(pipe);
			stage.Init(x, weight, ring, k, n, producer, bm, width, l0k, bk, mode);
			gmg_native::Schedule(stage, groups, e, n, producer, producers, bm, width, ownerG, false);
		}
	} else if (mode == gmg_native::SINGLE) {
		gmg_native::SingleProducer stage(pipe);
		stage.Init(x, weight, ring, k, n, producer, bm, width, singleShot);
		gmg_native::Schedule(stage, groups, e, n, producer, producers, bm, width, ownerG, checkOwnerAlignment);
	} else {
		gmg_native::MultiProducer<false, false, false, false, false, true> stage(pipe);
		stage.Init(x, weight, ring, k, n, producer, bm, width, l0k, bk, mode);
		stage.EnableStreamTurns(streamTurn);
		if (tcRun) {
			stage.SetTranscode(weightNz, 1);
			if (stage.TranscodeOn()) CrossCoreWaitFlag<2>(gmg_tc::kFlag);
		}
		gmg_native::Schedule<true>(stage, groups, e, n, producer, producers, bm, width,
			ownerG, checkOwnerAlignment, streamTurn, rowGroup);
	}
#else
	const uint32_t producer = GetBlockIdx() / 2;
	const bool wholeLarge = !tcRun && !singleShot && k > 256 && bm <= 256 && uint64_t((bm + 1) / 2) * width <= gmg_native::WHOLE_PACKET_LANES && uint64_t(m) * n >= 4194304 && uint64_t(m) * n >= 8ULL * producers * 32768;
	if (wholeLarge) {
		gmg_native::WholePacketConsumer<true, true> stage(pipe);
		stage.Init(scale, y, ring, groups, e, n, producer, bm, width);
		gmg_native::Schedule<true>(stage, groups, e, n, producer, producers, bm, width,
			ownerG, checkOwnerAlignment, streamTurn, rowGroup);
	} else {
		gmg_native::Consumer stage(pipe);
		stage.Init(scale, y, ring, groups, e, n, producer, bm, width, singleShot,
			!singleShot && bm >= 64 && width >= 256 && (mode == gmg_native::SINGLE || (mode == gmg_native::FULL_A && n % 32 == 0 && static_cast<uint64_t>(bm) * width <= 2ULL * 8192)));
		if (tcRun) {
			gmg_tc::TranscodeAiv(pipe, weight, weightNz, k, n, e, bk, producers);
		}
		gmg_native::Schedule<true>(stage, groups, e, n, producer, producers, bm, width, ownerG, checkOwnerAlignment, streamTurn, rowGroup);
	}
#endif
#endif
}
__global__ __aicore__ void grouped_matmul_gelu_activation_owner_wave(
	GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groups, GM_ADDR y, GM_ADDR ring,
	GM_ADDR weightNz,
	uint32_t m, uint32_t k, uint32_t n, uint32_t e, uint32_t producers,
	uint32_t bm, uint32_t width, uint32_t l0k, uint32_t bk, uint32_t ownerG,
	uint32_t mode, uint32_t slots, bool singleShot, uint32_t tcOn, uint32_t routingProducers) {
	using namespace AscendC;
	KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
#if defined(__NPU_ARCH__) && __NPU_ARCH__ == 2201
	const bool tcRun = (tcOn != 0) && (mode == gmg_native::STREAM);
	const bool checkOwnerAlignment = mode == gmg_native::FULL_A && ownerG > 1 && m % bm == 0 && n % width == 0 && k % l0k == 0 && m / bm < routingProducers;
	TPipe pipe;
#if defined(__DAV_C220_CUBE__)
	const uint32_t producer = GetBlockIdx();
	const uint64_t cyclicL1 = 2ULL * (4ULL * l0k) * (bm + width);
	const uint64_t oldFullAL1 = static_cast<uint64_t>(bm) * ((k + 31) / 32 * 32) + 2ULL * bk * width;
	const bool cyclicDomain = checkOwnerAlignment && bm == 128 && width == 256 && l0k == 128 && k % 512 == 0 && cyclicL1 <= oldFullAL1;
	if (cyclicDomain) {
		GlobalTensor<int64_t> groupGm;
		groupGm.SetGlobalBuffer((__gm__ int64_t *)groups);
		uint32_t previous = 0;
		bool partial = false;
		for (uint32_t expert = 0; expert < e; ++expert) {
			const uint32_t end = static_cast<uint32_t>(groupGm.GetValue(expert));
			if ((end - previous) % bm != 0) {
				partial = true;
				break;
			}
			previous = end;
		}
		if (partial) {
			gmg_native::CyclicProducer<128, 256, 512, 128> stage(pipe);
			stage.Init(x, weight, ring, k, n, producer);
			gmg_native::Schedule(stage, groups, e, n, producer, producers, bm, width, 1, false);
		} else {
			gmg_native::ScalarEventProducer<false, false, false, true> stage(pipe);
			stage.Init(x, weight, ring, k, n, producer, bm, width, l0k, bk, mode);
			gmg_native::Schedule(stage, groups, e, n, producer, producers, bm, width, ownerG, false);
		}
	} else if (mode == gmg_native::SINGLE) {
		gmg_native::SingleProducer stage(pipe);
		stage.Init(x, weight, ring, k, n, producer, bm, width, singleShot);
		gmg_native::Schedule(stage, groups, e, n, producer, producers, bm, width, ownerG, checkOwnerAlignment);
	} else {
		gmg_native::ScalarEventProducer<false, false, false, true> stage(pipe);
		stage.Init(x, weight, ring, k, n, producer, bm, width, l0k, bk, mode);
		if (tcRun) {
			stage.SetTranscode(weightNz, 1);
			if (stage.TranscodeOn()) CrossCoreWaitFlag<2>(gmg_tc::kFlag);
		}
		gmg_native::ScheduleAlignedSingleMOwners(stage, groups, e, n, producer, producers, bm, width, ownerG, checkOwnerAlignment);
	}
#else
	const uint32_t producer = GetBlockIdx() / 2;
	if (mode == gmg_native::SINGLE && n % 32 != 0) {
		gmg_native::WholePacketConsumer<true> stage(pipe);
		stage.Init(scale, y, ring, groups, e, n, producer, bm, width);
		gmg_native::ScheduleAlignedSingleMOwners(stage, groups, e, n, producer,
			producers, bm, width, ownerG, checkOwnerAlignment);
		return;
	}
	gmg_native::WholePacketConsumer stage(pipe);
	stage.Init(scale, y, ring, groups, e, n, producer, bm, width);
	gmg_native::ScheduleAlignedSingleMOwners(stage, groups, e, n, producer, producers, bm, width, ownerG, checkOwnerAlignment);
#endif
#endif
}
__global__ __aicore__ void grouped_matmul_gelu_guarded_tail_columns(
GM_ADDR x,GM_ADDR weight,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,GM_ADDR ring,
GM_ADDR weightNz,
uint32_t m,uint32_t k,uint32_t n,uint32_t e,uint32_t producers,
uint32_t bm,uint32_t width,uint32_t l0k,uint32_t bk,uint32_t ownerG,
uint32_t mode,uint32_t slots,bool singleShot,uint32_t tcOn){
using namespace AscendC;
KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
#if defined(__NPU_ARCH__)&& __NPU_ARCH__ == 2201
const bool tcRun =(tcOn != 0)&&(mode == gmg_native::STREAM);
const bool checkOwnerAlignment = mode == gmg_native::FULL_A && ownerG > 1
&& m % bm == 0 && n % width == 0 && k % l0k == 0
&& m / bm < producers;
TPipe pipe;
#if defined(__DAV_C220_CUBE__)
const uint32_t producer = GetBlockIdx();
const uint64_t cyclicL1 = 2ULL *(4ULL * l0k)*(bm + width);
const uint64_t oldFullAL1 = static_cast<uint64_t>(bm)*((k + 31)/ 32 * 32)
+ 2ULL * bk * width;
const bool cyclicDomain = checkOwnerAlignment && bm == 128 && width == 256
&& l0k == 128 && k % 512 == 0 && cyclicL1 <= oldFullAL1;
if(cyclicDomain){
GlobalTensor<int64_t> groupGm;
groupGm.SetGlobalBuffer((__gm__ int64_t*)groups);
uint32_t previous = 0;
bool partial = false;
for(uint32_t expert = 0;expert < e;++expert){
const uint32_t end = static_cast<uint32_t>(groupGm.GetValue(expert));
if((end - previous)% bm != 0){
partial = true;
break;
}
previous = end;
}
if(partial){
gmg_native::CyclicProducer<128,256,512,128> stage(pipe);
stage.Init(x,weight,ring,k,n,producer);
gmg_native::ScheduleTailWeightedColumns(stage,groups,e,n,producer,producers,bm,width,1);
}else{
gmg_native::MultiProducer<> stage(pipe);
stage.Init(x,weight,ring,k,n,producer,bm,width,l0k,bk,mode);
gmg_native::Schedule(stage,groups,e,n,producer,producers,bm,width,ownerG,false);
}
}else if(mode == gmg_native::SINGLE){
gmg_native::SingleProducer stage(pipe);
stage.Init(x,weight,ring,k,n,producer,bm,width,singleShot);
gmg_native::Schedule(stage,groups,e,n,producer,producers,bm,width,ownerG,checkOwnerAlignment);
}else{
gmg_native::MultiProducer<> stage(pipe);
stage.Init(x,weight,ring,k,n,producer,bm,width,l0k,bk,mode);
if(tcRun){
stage.SetTranscode(weightNz,1);
if(stage.TranscodeOn())CrossCoreWaitFlag<2>(gmg_tc::kFlag);
}
gmg_native::Schedule(stage,groups,e,n,producer,producers,bm,width,ownerG,checkOwnerAlignment);
}
#else
const uint32_t producer = GetBlockIdx()/ 2;
gmg_native::WholePacketConsumer stage(pipe);
stage.Init(scale,y,ring,groups,e,n,producer,bm,width);
const uint64_t cyclicL1 = 2ULL *(4ULL * l0k)*(bm + width);
const uint64_t oldFullAL1 = static_cast<uint64_t>(bm)*((k + 31)/ 32 * 32)
