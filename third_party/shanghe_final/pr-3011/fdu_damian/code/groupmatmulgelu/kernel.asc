Cast(z,acc,RoundMode::CAST_RINT,active);PipeBarrier<PIPE_V>();
if(broadcastScale_){
auto expanded = acc.ReinterpretCast<float>();
SetMaskCount();
SetVectorMask<float,MaskMode::COUNTER>(p8);
