template<bool PACK_GELU>
__aicore__ inline void RunRowVectorPackets(
GM_ADDR x,GM_ADDR weight,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,
uint32_t m,uint32_t k,uint32_t n,uint32_t e,uint32_t cores,uint32_t R,uint32_t kCapacity,uint32_t P){
using namespace AscendC;
#if defined(__NPU_ARCH__)&& __NPU_ARCH__ == 2201
const uint32_t L = R * P;
TPipe pipe;
GlobalTensor<int8_t> xGm,wGm;GlobalTensor<float> sGm;
GlobalTensor<int64_t> gGm;GlobalTensor<half> yGm;
xGm.SetGlobalBuffer((__gm__ int8_t*)x);wGm.SetGlobalBuffer((__gm__ int8_t*)weight);
sGm.SetGlobalBuffer((__gm__ float*)scale);gGm.SetGlobalBuffer((__gm__ int64_t*)groups);
yGm.SetGlobalBuffer((__gm__ half*)y);
TQue<TPosition::VECIN,1> qX,qW,qS,qG;
TQue<TPosition::VECOUT,1> qY;
TBuf<TPosition::VECCALC> h,a,columns,rowOffsets,offsets,index,aux,accum,product,zbuf;
pipe.InitBuffer(qX,1,R * kCapacity);pipe.InitBuffer(qW,1,(kCapacity * P + 31)/ 32 * 32);pipe.InitBuffer(qS,1,(P * 4 + 31)/ 32 * 32);
pipe.InitBuffer(qG,1,(e * 8 + 31)/ 32 * 32);pipe.InitBuffer(qY,1,L * 2 + 256);
pipe.InitBuffer(h,R * kCapacity * 2);pipe.InitBuffer(a,R * kCapacity * 4);
pipe.InitBuffer(columns,R * kCapacity * 4);pipe.InitBuffer(rowOffsets,R * 4);
pipe.InitBuffer(offsets,L * 4);pipe.InitBuffer(index,L * 4);pipe.InitBuffer(aux,L * 4);
pipe.InitBuffer(accum,R * 4);pipe.InitBuffer(product,R * 4);pipe.InitBuffer(zbuf,R * 4);
auto event = pipe.FetchEventID(HardEvent::MTE2_S);
auto g = qG.AllocTensor<int64_t>();
DataCopyPad(g,gGm,{1,e * 8,0,0,0},{false,0,0,0});
qG.EnQue(g);g = qG.DeQue<int64_t>();
SetFlag<HardEvent::MTE2_S>(event);WaitFlag<HardEvent::MTE2_S>(event);
auto nd = index.Get<int32_t>();auto off = offsets.Get<int32_t>();auto scratch = aux.Get<float>();
CreateVecIndex(nd,int32_t(0),R * n);PipeBarrier<PIPE_V>();
Cast(scratch,nd,RoundMode::CAST_RINT,R * n);PipeBarrier<PIPE_V>();
Muls(scratch,scratch,1.0f / n,R * n);PipeBarrier<PIPE_V>();
// For i<4096,n<=8,1/256 covers FP32 quotient error and is below the1/8 fractional gap.
Adds(scratch,scratch,0.00390625f,R * n);PipeBarrier<PIPE_V>();
Cast(off,scratch,RoundMode::CAST_FLOOR,R * n);PipeBarrier<PIPE_V>();
auto tmpIndex = aux.Get<int32_t>();
Muls(tmpIndex,off,static_cast<int32_t>(n),R * n);PipeBarrier<PIPE_V>();
Sub(nd,nd,tmpIndex,R * n);PipeBarrier<PIPE_V>();
Muls(nd,nd,int32_t(R * 4),R * n);PipeBarrier<PIPE_V>();
Muls(off,off,int32_t(4),R * n);PipeBarrier<PIPE_V>();
Add(off,off,nd,R * n);PipeBarrier<PIPE_V>();
auto rowIndex = rowOffsets.Get<int32_t>();
CreateVecIndex(rowIndex,int32_t(0),R);PipeBarrier<PIPE_V>();
Muls(rowIndex,rowIndex,static_cast<int32_t>(k * 4),R);PipeBarrier<PIPE_V>();
auto planar = aux.Get<float>();
uint32_t start = 0,prefix = 0;
for(uint32_t expert = 0;expert < e;++expert){
const uint32_t end = static_cast<uint32_t>(g.GetValue(expert));
const uint32_t bands =(end - start + R - 1)/ R;
const uint32_t first =(GetBlockIdx()+ cores - prefix % cores)% cores;
if(first < bands){
auto w = qW.AllocTensor<int8_t>();auto s = qS.AllocTensor<float>();
DataCopyPad(w,wGm[static_cast<uint64_t>(expert)* k * n],
{1,k * n,0,0,0},{true,0,static_cast<uint8_t>((32 - k * n % 32)% 32),0});
DataCopyPad(s,sGm[static_cast<uint64_t>(expert)* n],
{1,n * 4,0,0,0},{true,0,static_cast<uint8_t>(PACK_GELU ?(8 - n % 8)% 8 : 8 - n),0});
qW.EnQue(w);qS.EnQue(s);w = qW.DeQue<int8_t>();s = qS.DeQue<float>();
SetFlag<HardEvent::MTE2_S>(event);WaitFlag<HardEvent::MTE2_S>(event);
for(uint32_t band = first;band < bands;band += cores){
const uint32_t row = start + band * R,rows = end - row < R ? end - row : R;
auto input = qX.AllocTensor<int8_t>();
DataCopyPad(input,xGm[static_cast<uint64_t>(row)* k],
{1,rows * k,0,0,0},{true,0,static_cast<uint8_t>((32 - rows * k % 32)% 32),0});
qX.EnQue(input);input = qX.DeQue<int8_t>();
Cast(h.Get<half>(),input,RoundMode::CAST_NONE,rows * k);PipeBarrier<PIPE_V>();
Cast(a.Get<int32_t>(),h.Get<half>(),RoundMode::CAST_RINT,rows * k);PipeBarrier<PIPE_V>();
qX.FreeTensor(input);
for(uint32_t kk = 0;kk < k;++kk){
Gather(columns.Get<int32_t>()[kk * R],a.Get<int32_t>(),
rowIndex.ReinterpretCast<uint32_t>(),kk * 4,rows);
PipeBarrier<PIPE_V>();
}
for(uint32_t col = 0;col < n;++col){
auto acc = accum.Get<int32_t>();auto prod = product.Get<int32_t>();
for(uint32_t kk = 0;kk < k;++kk){
const int32_t coefficient = w.GetValue(kk * n + col);
if(kk == 0)Muls(acc,columns.Get<int32_t>()[kk * R],coefficient,rows);
else{
Muls(prod,columns.Get<int32_t>()[kk * R],coefficient,rows);PipeBarrier<PIPE_V>();
Add(acc,acc,prod,rows);
}
PipeBarrier<PIPE_V>();
}
if constexpr(PACK_GELU){
auto z = planar[col * R];Cast(z,acc,RoundMode::CAST_RINT,rows);PipeBarrier<PIPE_V>();
Muls(z,z,s.GetValue(col),rows);PipeBarrier<PIPE_V>();
}else{
auto z = zbuf.Get<float>();Cast(z,acc,RoundMode::CAST_RINT,rows);PipeBarrier<PIPE_V>();
Muls(z,z,s.GetValue(col),rows);PipeBarrier<PIPE_V>();
gmg::Gelu7Count(z,planar[col * R],rows);
}
}
auto linear = index.Get<float>();
Gather(linear,planar,off.ReinterpretCast<uint32_t>(),0,rows * n);PipeBarrier<PIPE_V>();
if constexpr(PACK_GELU)gmg::Gelu7Count(linear,planar,rows * n);
auto output = qY.AllocTensor<half>();
if constexpr(PACK_GELU)Cast(output,planar,RoundMode::CAST_RINT,rows * n);
else Cast(output,linear,RoundMode::CAST_RINT,rows * n);
qY.EnQue(output);output = qY.DeQue<half>();
DataCopyPad(yGm[static_cast<uint64_t>(row)* n],output,
{1,rows * n * 2,0,0,0});
qY.FreeTensor(output);
}
qW.FreeTensor(w);qS.FreeTensor(s);
}
prefix += bands;start = end;
}
qG.FreeTensor(g);PipeBarrier<PIPE_ALL>();
#endif
}
__global__ __aicore__ void grouped_matmul_gelu_compact_row_vectors(
GM_ADDR x,GM_ADDR weight,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,
uint32_t m,uint32_t k,uint32_t n,uint32_t e,uint32_t cores){
KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
RunRowVectorPackets<false>(x,weight,scale,groups,y,m,k,n,e,cores,512,8,8);
}
__global__ __aicore__ void grouped_matmul_gelu_adaptive_row_vectors(
GM_ADDR x,GM_ADDR weight,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,
uint32_t m,uint32_t k,uint32_t n,uint32_t e,uint32_t cores,uint32_t rows){
KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
RunRowVectorPackets<true>(x,weight,scale,groups,y,m,k,n,e,cores,rows,k,n);
}
static bool LargeOutputTiles(uint32_t m, uint32_t n, uint32_t cores) {
    return uint64_t(m) * n >= 8ULL * cores * 32768
        && uint64_t(m) * n >= 4194304;
}
static void ChooseCubeTile(uint32_t m,uint32_t k,uint32_t n,uint32_t e,
uint32_t cores,uint64_t l1,uint64_t l0a,uint64_t l0b,uint64_t l0c,
uint32_t& bm,uint32_t& bn,uint32_t& ownerG){
static const uint32_t kCandidate[8][2] = {
    {64,128}, {64,256}, {128,128}, {256,64}, {512,32},
    {96,160}, {160,96}, {192,80}
};
const bool largeOutput = k > 256 && LargeOutputTiles(m, n, cores);
bm = kCandidate[0][0];
bn = kCandidate[0][1];
ownerG = 1;
if(k <= 256 && n <= 256)return;
const uint32_t experts = e == 0 ? 1 : e;
uint32_t rows =(m + experts - 1)/ experts;
if(rows == 0)rows = 1;
const uint32_t kp =(k + 31)/ 32 * 32;
const uint32_t nonempty = m < experts ? m : experts;
const uint64_t kByteCost = 25;
const uint64_t kMacCost = 8;
const uint64_t kInstrCost = 400000;
uint64_t best = ~0ULL;
uint32_t bestWidth = 0;
for(uint32_t i = 0;i < (largeOutput ? 8 : 5);++i){
const uint32_t tbm = kCandidate[i][0];
const uint32_t width = 2 * kCandidate[i][1];
if(4ULL * tbm * width > l0c)continue;
const uint32_t l0k = width == 320 ? 96 : ((width == 512 || width == 64) ? 64 : 128);
if(static_cast<uint64_t>(tbm)* l0k > l0a / 2)continue;
if(static_cast<uint64_t>(l0k)* width > l0b / 2)continue;
const uint32_t rowTiles =(rows + tbm - 1)/ tbm;
const uint32_t colTiles =(n + width - 1)/ width;
const uint64_t oneMmadL1 = static_cast<uint64_t>(kp)*(tbm + width);
const bool oneMmad = kp <= 256 && static_cast<uint64_t>(tbm)* kp <= l0a
&& static_cast<uint64_t>(width)* kp <= l0b
&& 4ULL * tbm * width <= l0c && oneMmadL1 <= l1;
uint32_t mode = gmg_native::STREAM;
uint32_t bk = 4 * l0k;
if(oneMmad){
mode = gmg_native::SINGLE;
bk = kp;
}else{
const uint64_t residentA = static_cast<uint64_t>(tbm)* kp;
const uint64_t minimumB = 2ULL * width * l0k;
if(residentA + minimumB <= l1){
const uint32_t limit = static_cast<uint32_t>((l1 - residentA)/ minimumB * l0k);
const uint32_t wholeK =(kp + l0k - 1)/ l0k * l0k;
bk = limit < wholeK ? limit : wholeK;
mode = gmg_native::FULL_A;
}
}
const uint64_t l1Bytes = mode == gmg_native::SINGLE ? oneMmadL1
:(mode == gmg_native::FULL_A
? static_cast<uint64_t>(tbm)* kp + 2ULL * bk * width
: 2ULL * bk *(tbm + width));
if(l1Bytes > l1)continue;
const uint32_t rowsUpper = nonempty +(m - nonempty)/ tbm;
const uint32_t taskUpper = rowsUpper * colTiles;
uint32_t producers = taskUpper < cores ? taskUpper : cores;
if(producers == 0)producers = 1;
const uint32_t rowOwners = experts * rowTiles;
const uint64_t macs = static_cast<uint64_t>(experts)* rowTiles * tbm
*(static_cast<uint64_t>(colTiles)* width)* kp;
const uint64_t wBytes = static_cast<uint64_t>(rowTiles)* experts * k * n;
const uint64_t yBytes = static_cast<uint64_t>(m)* n * 2;
const uint64_t ringBytes = 4ULL * m *(static_cast<uint64_t>(colTiles)* width + n);
const uint32_t lastOwnerG = mode == gmg_native::FULL_A ? colTiles : 1;
const uint64_t mpadI =(static_cast<uint64_t>(tbm)+ 15)/ 16 * 16;
const uint64_t taskInstr = mpadI / 16;
for(uint32_t g = 1;g <= lastOwnerG;++g){
const uint32_t columnGroups =(colTiles + g - 1)/ g;
const uint64_t owners = static_cast<uint64_t>(rowOwners)* columnGroups;
const uint64_t waves =(owners + producers - 1)/ producers;
const uint64_t bytes = static_cast<uint64_t>(columnGroups)* m * k
+ wBytes + yBytes + ringBytes;
const uint64_t instr = owners * taskInstr;
const uint64_t score = bytes * kByteCost
+ kMacCost *((waves * macs)/ owners)
+ kInstrCost * instr;
if(score < best ||(score == best && width > bestWidth)){
best = score;
bestWidth = width;
bm = tbm;
bn = kCandidate[i][1];
ownerG = g;
}
}
}
}
struct NativeConfig{
uint32_t producers,bm,width,l0k,bk,ownerG,mode,slots;
bool singleShot;
};
static NativeConfig ChooseNativeConfig(uint32_t m,uint32_t k,uint32_t n,
uint32_t e,uint32_t capacity,uint64_t l1,uint64_t l0a,
uint64_t l0b,uint64_t l0c,bool enableTallerStream){
NativeConfig config;
uint32_t ownerG = 1;
if(n <= 128){
config.width = n <= 32 ? 32 :(n <= 64 ? 64 : 128);
config.bm =(m + 127)/ 128 < capacity ? 32 : 128;
}else{
uint32_t bn;
ChooseCubeTile(m,k,n,e,capacity,l1,l0a,l0b,l0c,
config.bm,bn,ownerG);
config.width = 2 * bn;
}
config.l0k = config.width == 320 ? 96 : ((config.width == 512 || config.width == 64) ? 64 : 128);
const uint32_t kp =(k + 31)/ 32 * 32;
const uint64_t l1Single = static_cast<uint64_t>(kp)*(config.bm + config.width);
const bool oneMmad = kp <= 256 && static_cast<uint64_t>(config.bm)* kp <= l0a
&& static_cast<uint64_t>(config.width)* kp <= l0b
&& 4ULL * config.bm * config.width <= l0c && l1Single <= l1;
config.mode = gmg_native::STREAM;
{
const uint64_t capStream = l1 /(2ULL *(config.bm + config.width));
uint32_t bkStream = static_cast<uint32_t>(capStream / 32 * 32);
if(bkStream > kp)bkStream = kp;
if(bkStream < 4 * config.l0k)bkStream = 4 * config.l0k;
config.bk = bkStream;
}
if(oneMmad){
config.mode = gmg_native::SINGLE;
config.bk = kp;
}else{
const uint64_t residentA = static_cast<uint64_t>(config.bm)* kp;
const uint64_t minimumB = 2ULL * config.width * config.l0k;
if(residentA + minimumB <= l1){
const uint32_t limit =(l1 - residentA)/ minimumB * config.l0k;
const uint32_t wholeK =(kp + config.l0k - 1)/ config.l0k * config.l0k;
config.bk = limit < wholeK ? limit : wholeK;
{
const uint32_t chunksNow =(kp + config.bk - 1)/ config.bk;
if(chunksNow <= 2){
uint32_t deep =(kp + 3)/ 4;
deep =(deep + 31)/ 32 * 32;
if(deep < config.l0k)deep = config.l0k;
if(deep < config.bk)config.bk = deep;
}
}
config.mode = gmg_native::FULL_A;
}
}
const uint32_t nonempty = m < e ? m : e;
const uint32_t rowsUpper = nonempty +(m - nonempty)/ config.bm;
const uint32_t nTiles =(n + config.width - 1)/ config.width;
const uint32_t taskUpper = rowsUpper * nTiles;
config.singleShot = oneMmad && taskUpper <= capacity;
config.producers = taskUpper < capacity ? taskUpper : capacity;
config.slots = config.singleShot ? 1 : 4;
config.ownerG = config.mode == gmg_native::FULL_A ? ownerG : 1;
if(enableTallerStream && !LargeOutputTiles(m, n, capacity) && config.mode == gmg_native::STREAM
&& config.bm < 256 && config.width > 128
&& 2ULL * 256 * 128 <= l0a && 2ULL * 128 * 128 <= l0b
&& 4ULL * 256 * 128 <= l0c && 2ULL * 512 *(256 + 128)<= l1){
const uint64_t avg =(static_cast<uint64_t>(m)+ e - 1)/ e;
const uint64_t paddedRows = static_cast<uint64_t>(e)*((avg + 15)/ 16 * 16);
const uint64_t paddedN =(static_cast<uint64_t>(n)+ 31)/ 32 * 32;
const uint64_t oldScore = paddedRows *((static_cast<uint64_t>(n)+ config.width - 1)/ config.width)
+ static_cast<uint64_t>(e)*((avg + config.bm - 1)/ config.bm)* paddedN;
const uint64_t newScore = paddedRows *((static_cast<uint64_t>(n)+ 127)/ 128)
+ static_cast<uint64_t>(e)*((avg + 255)/ 256)* paddedN;
if(newScore < oldScore){
config.bm = 256;config.width = 128;config.l0k = 128;config.bk = 512;
config.mode = gmg_native::STREAM;config.ownerG = 1;
config.slots = 4;config.singleShot = false;
const uint32_t rowsUpper = nonempty +(m - nonempty)/ config.bm;
const uint32_t taskUpper = rowsUpper *((n + config.width - 1)/ config.width);
config.producers = taskUpper < capacity ? taskUpper : capacity;
}
}
if(n <= 128 && config.mode == gmg_native::FULL_A && kp >= 16ULL * config.l0k){
uint32_t tk = config.l0k;
const uint64_t aBytes = static_cast<uint64_t>(config.bm)* kp;
while(2 * tk <= 2048 && 2 * tk <= kp
&& 4ULL * config.bm * tk <= l0a && 4ULL * config.width * tk <= l0b
&& aBytes + 4ULL * config.width * tk <= l1)tk *= 2;
if(tk > config.l0k){
config.l0k = tk;
config.bk = config.bk / tk * tk;
if(config.bk < tk)config.bk = tk;
}
}
return config;
}
struct SingleExpertCost{uint32_t pad,packets,tasks;};
static SingleExpertCost EstimateSingleExpertCost(uint32_t m,uint32_t n,uint32_t producers,uint32_t bm){
const uint32_t p16=(n+15)/16*16;uint32_t packetRows=128;
while(packetRows*p16>4096)packetRows/=2;
const uint32_t full=m/bm,tail=m%bm,cycles=full/producers;
const uint32_t maxFull=(full+producers-1)/producers;
const uint32_t q=(bm/2+packetRows-1)/packetRows;
const uint32_t padFull=bm*maxFull,padTail=bm*cycles+(tail+15)/16*16;
const uint32_t packFull=q*maxFull,packTail=q*cycles+((tail+1)/2+packetRows-1)/packetRows;
return {padFull>padTail?padFull:padTail,packFull>packTail?packFull:packTail,
(full+(tail!=0?1:0)+producers-1)/producers};
}
static uint32_t ChooseSingleExpertBlock(uint32_t m,uint32_t k,uint32_t n,uint32_t producers,uint32_t width,
uint64_t l1,uint64_t l0a,uint64_t l0b,uint64_t l0c){
const uint32_t kp=(k+31)/32*32;const SingleExpertCost reference=EstimateSingleExpertCost(m,n,producers,128);
uint32_t selected=128;SingleExpertCost best=reference;bool accepted=false;
for(uint32_t bm=256;bm<=512;bm*=2){
if((m+bm-1)/bm<2*producers)continue;
if(uint64_t(bm)*kp>l0a||uint64_t(width)*kp>l0b||4ULL*bm*width>l0c
||uint64_t(kp)*(bm+width)>l1)continue;
const SingleExpertCost cost=EstimateSingleExpertCost(m,n,producers,bm);
const bool admissible=cost.pad<=reference.pad&&(cost.tasks<reference.tasks||cost.packets<reference.packets);
const bool better=!accepted||cost.tasks<best.tasks
||(cost.tasks==best.tasks&&(cost.packets<best.packets
||(cost.packets==best.packets&&(cost.pad<best.pad||(cost.pad==best.pad&&bm<selected)))));
if(admissible&&better){selected=bm;best=cost;accepted=true;}
}
return selected;
}
template<uint32_t K>
static void LaunchTinyStaticColumns(
GM_ADDR x,GM_ADDR weight,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,
uint32_t m,uint32_t n,uint32_t e,uint32_t cores,aclrtStream stream){
switch(n){
case 1:
grouped_matmul_gelu_tiny_static_kn<K,1><<<cores,nullptr,stream>>>(
x,weight,scale,groups,y,m,e);
break;
case 2:
grouped_matmul_gelu_tiny_static_kn<K,2><<<cores,nullptr,stream>>>(
x,weight,scale,groups,y,m,e);
break;
case 3:
grouped_matmul_gelu_tiny_static_kn<K,3><<<cores,nullptr,stream>>>(
x,weight,scale,groups,y,m,e);
break;
case 4:
grouped_matmul_gelu_tiny_static_kn<K,4><<<cores,nullptr,stream>>>(
x,weight,scale,groups,y,m,e);
break;
case 5:
grouped_matmul_gelu_tiny_static_kn<K,5><<<cores,nullptr,stream>>>(
x,weight,scale,groups,y,m,e);
break;
case 6:
grouped_matmul_gelu_tiny_static_kn<K,6><<<cores,nullptr,stream>>>(
x,weight,scale,groups,y,m,e);
break;
case 7:
grouped_matmul_gelu_tiny_static_kn<K,7><<<cores,nullptr,stream>>>(
x,weight,scale,groups,y,m,e);
break;
case 8:
grouped_matmul_gelu_tiny_static_kn<K,8><<<cores,nullptr,stream>>>(
x,weight,scale,groups,y,m,e);
break;
}
}
extern "C" void run_kernel(
	GM_ADDR x,
	const TensorGroupInfo &info_x,
	GM_ADDR weight,
	const TensorGroupInfo &info_weight,
	GM_ADDR scale,
	const TensorGroupInfo &info_scale,
	GM_ADDR group_list,
	const TensorGroupInfo &info_group_list,
	GM_ADDR y,
	const TensorGroupInfo &info_y,
	int64_t availableCoreNum,
	aclrtStream stream) {
	const uint32_t m = info_x.tensors[0].shape[0];
	const uint32_t k = info_x.tensors[0].shape[1];
	const uint32_t e = info_weight.tensors[0].shape[0];
	const uint32_t n = info_weight.tensors[0].shape[2];
	const char *soc = aclrtGetSocName();
	auto platform = platform_ascendc::PlatformAscendCManager::GetInstance();
	const auto arch = platform->GetCurNpuArch();
	const uint32_t aic = platform->GetCoreNumAic();
	const uint32_t aiv = platform->GetCoreNumAiv();
	uint32_t capacity = static_cast<uint32_t>(availableCoreNum);
	if (capacity > aic) capacity = aic;
	if (capacity > aiv / 2) capacity = aiv / 2;
	const bool a3 = soc != nullptr && std::strncmp(soc, "Ascend910_93", 12) == 0 && arch == NpuArch::DAV_2201;
	const uint32_t earlyTasks = m * ((n + 127) / 128);
	if (a3 && k >= 1 && k <= 8 && n <= 8 && earlyTasks <= 2 * capacity) {
		uint32_t cores = static_cast<uint32_t>(availableCoreNum) * 2;
		if (cores > aiv) cores = aiv;
		if (cores > earlyTasks) cores = earlyTasks;
		if (cores < 4 && aiv >= 4) cores = 4;
		const uint64_t tinyBytes = static_cast<uint64_t>(e) * (k * n + n * 4 + 8);
		if (m <= cores && tinyBytes <= 8192) {
			switch (k) {
			case 1:
				LaunchTinyStaticColumns<1>(x, weight, scale, group_list, y, m, n, e, cores, stream);
				break;
			case 2:
				LaunchTinyStaticColumns<2>(x, weight, scale, group_list, y, m, n, e, cores, stream);
				break;
			case 3:
				LaunchTinyStaticColumns<3>(x, weight, scale, group_list, y, m, n, e, cores, stream);
				break;
			case 4:
				LaunchTinyStaticColumns<4>(x, weight, scale, group_list, y, m, n, e, cores, stream);
				break;
			case 5:
				LaunchTinyStaticColumns<5>(x, weight, scale, group_list, y, m, n, e, cores, stream);
				break;
			case 6:
				LaunchTinyStaticColumns<6>(x, weight, scale, group_list, y, m, n, e, cores, stream);
				break;
			case 7:
				LaunchTinyStaticColumns<7>(x, weight, scale, group_list, y, m, n, e, cores, stream);
				break;
			case 8:
				LaunchTinyStaticColumns<8>(x, weight, scale, group_list, y, m, n, e, cores, stream);
				break;
			}
			return;
		}
	}
	uint64_t l1 = 0, l0a = 0, l0b = 0, l0c = 0, ub = 0;
	platform->GetCoreMemSize(platform_ascendc::CoreMemType::L1, l1);
	platform->GetCoreMemSize(platform_ascendc::CoreMemType::L0_A, l0a);
	platform->GetCoreMemSize(platform_ascendc::CoreMemType::L0_B, l0b);
	platform->GetCoreMemSize(platform_ascendc::CoreMemType::L0_C, l0c);
	platform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ub);
	if (a3 && k <= 8 && n <= 8 && m >= 512 && 110944ULL + (e * 8ULL + 31) / 32 * 32 + 8448 <= ub) {
		const uint32_t nonempty = m < e ? m : e;
		const uint32_t bandsUpper = nonempty + (m - nonempty) / 512;
		const uint32_t vectorCores = bandsUpper < capacity * 2 ? bandsUpper : capacity * 2;
		grouped_matmul_gelu_compact_row_vectors<<<vectorCores, nullptr, stream>>>(
			x, weight, scale, group_list, y, m, k, n, e, vectorCores);
		return;
	}
	if (a3 && m >= 512 && k <= 32 && n <= 32 && k * n <= 128) {
		const uint64_t fixedUb = (k * n + 31) / 32 * 32 + (n * 4 + 31) / 32 * 32 + 256ULL + (e * 8ULL + 31) / 32 * 32 + 8448;
		const uint32_t bytesPerRow = 11 * k + 14 * n + 16;
		uint32_t packetRows = 512;
		while (packetRows > 64 && (packetRows * n > 4096 || static_cast<uint64_t>(packetRows) * bytesPerRow + fixedUb > ub)) packetRows /= 2;
		if (packetRows * n <= 4096 && static_cast<uint64_t>(packetRows) * bytesPerRow + fixedUb <= ub) {
			const uint32_t nonempty = m < e ? m : e;
			const uint32_t bandsUpper = nonempty + (m - nonempty) / packetRows;
			const uint32_t vectorCores = bandsUpper < capacity * 2 ? bandsUpper : capacity * 2;
			grouped_matmul_gelu_adaptive_row_vectors<<<vectorCores, nullptr, stream>>>(
				x, weight, scale, group_list, y, m, k, n, e, vectorCores, packetRows);
			return;
		}
	}
	const uint32_t vectorTasks = m * ((n + 127) / 128);
	bool shortKVector = false;
	if (a3 && k <= 8 && n >= gmg::COLS && vectorTasks <= 8 * capacity) {
		const NativeConfig candidate = ChooseNativeConfig(m, k, n, e, capacity,
			l1, l0a, l0b, l0c, std::strcmp(soc, "Ascend910_9362") == 0);
		uint32_t vectorCores = static_cast<uint32_t>(availableCoreNum) * 2;
		if (vectorCores > aiv) vectorCores = aiv;
		if (vectorCores > vectorTasks) vectorCores = vectorTasks;
		const uint32_t nTiles = (n + gmg::COLS - 1) / gmg::COLS;
		shortKVector = candidate.mode == gmg_native::SINGLE && (!candidate.singleShot || e > capacity) && (vectorCores % nTiles == 0 || vectorTasks <= 2 * vectorCores);
	}
	if (!a3 || (k < 32 && vectorTasks <= 2 * capacity) || (a3 && shortKVector)) {
		uint32_t cores = static_cast<uint32_t>(availableCoreNum) * 2;
		if (cores > aiv) cores = aiv;
		if (cores > vectorTasks) cores = vectorTasks;
		if (cores < 4 && aiv >= 4) cores = 4;
		if (shortKVector && cores % ((n + gmg::COLS - 1) / gmg::COLS) == 0 && vectorTasks > cores) {
			grouped_matmul_gelu_resident_inputs<<<cores, nullptr, stream>>>(x, weight, scale, group_list, y, m, k, n, e, cores);
		} else {
			grouped_matmul_gelu_custom<<<cores, nullptr, stream>>>(x, weight, scale,
				group_list, y, m, k, n, e, cores);
		}
		return;
	}
	NativeConfig config = ChooseNativeConfig(m, k, n, e, capacity, l1, l0a, l0b, l0c,
		std::strcmp(soc, "Ascend910_9362") == 0);
	if (a3 && e == 1 && n <= 128 && config.mode == gmg_native::SINGLE && !config.singleShot && config.bm == 128) {
		config.bm = ChooseSingleExpertBlock(m, k, n, config.producers, config.width, l1, l0a, l0b, l0c);
	}
	const uint32_t kp = (k + 31) / 32 * 32;
	if (a3 && n <= 128 && k > 256 && uint64_t(m) >= 256ULL * e && uint64_t(m) >= 512ULL * capacity) {
		const uint32_t fbm = 256, fw = (n + 31) / 32 * 32;
		const uint64_t wb = uint64_t(kp) * fw;
		if (wb + 256ULL * fbm <= l1 && 256ULL * fbm <= l0a && 256ULL * fw <= l0b && 4ULL * fbm * fw <= l0c && 180224ULL + (e * 8ULL + 31) / 32 * 32 + 8448 <= ub) {
			uint32_t fbk = (l1 - wb) / (2 * fbm) / 128 * 128;
			if (fbk > 512) fbk = 512;
			void *fr = nullptr;
			aclrtMalloc(&fr, uint64_t(capacity) * 4 * fbm * fw * 4, ACL_MEM_MALLOC_HUGE_FIRST);
			grouped_matmul_gelu_native_unified<<<capacity, nullptr, stream>>>(x, weight, scale, group_list, y, (GM_ADDR)fr, nullptr, m, k, n, e, capacity, fbm, fw, 128, fbk, 1, 3, 4, false, 0, 0);
			aclrtSynchronizeStream(stream);
			aclrtFree(fr);
			return;
		}
	}
	const uint64_t weightBytes = uint64_t(e) * k * n;
	const bool weightPlanner = (weightBytes >= 67108864 || (weightBytes >= 33554432 && (kp >= 4096 || n >= 2048)))
		&& ((uint64_t(m) + 127) / 128) * ((uint64_t(n) + 255) / 256) >= capacity;
	if (a3 && k > 256 && (LargeOutputTiles(m, n, capacity) || weightPlanner) && 180224ULL + (e * 8ULL + 31) / 32 * 32 + 8448 <= ub) {
		void *tileRing = nullptr;
		const size_t tileBytes = size_t(config.producers) * 4 * 32768 * 4;
		aclrtMalloc(&tileRing, tileBytes, ACL_MEM_MALLOC_HUGE_FIRST);
		grouped_matmul_gelu_native_unified<<<config.producers, nullptr, stream>>>(
			x, weight, scale, group_list, y, (GM_ADDR)tileRing, nullptr, m, k, n, e,
			config.producers, config.bm, config.width, config.l0k, config.bk,
			config.ownerG, config.mode, 4, false, 0u,
			l0a >= 65536 && l0b >= 65536 && l0c >= 131072 ? uint32_t(l1) : 0u);
		aclrtSynchronizeStream(stream);
		aclrtFree(tileRing);
		return;
	}
	const bool largeSinglePacket = a3 && config.mode == gmg_native::SINGLE && !config.singleShot && kp <= 256 && n >= 256 && uint64_t(m) >= (n % 32 == 0 ? 128ULL : 64ULL) * e && ((uint64_t(m) + 127) / 128) * ((uint64_t(n) + 255) / 256) >= 4ULL * capacity && 128ULL * kp <= l0a && 256ULL * kp <= l0b && 4ULL * 128 * 256 <= l0c && 384ULL * kp <= l1 && 16384ULL * 10 + 256 + 256 * 4 + ((e * 8ULL + 31) / 32 * 32) + 8448 <= ub;
	if (largeSinglePacket) {
		void *shortRing = nullptr;
		aclrtMalloc(&shortRing, static_cast<size_t>(capacity) * 4 * 128 * 256 * sizeof(int32_t), ACL_MEM_MALLOC_HUGE_FIRST);
		grouped_matmul_gelu_activation_owner_wave<<<capacity, nullptr, stream>>>(x, weight, scale,
			group_list, y, (GM_ADDR)shortRing, nullptr, m, k, n, e, capacity, 128, 256, 128, kp, 1,
			gmg_native::SINGLE, 4, false, 0u, capacity);
		aclrtSynchronizeStream(stream);
		aclrtFree(shortRing);
		return;
	}
	const uint32_t fullM = (m + 15) / 16 * 16;
	const uint64_t compactUb = 4096ULL * (sizeof(int32_t) + sizeof(half) + sizeof(float)) + 256 + config.width * sizeof(float) + 8448;
	const bool compactMatrix = e == 1 && config.mode == gmg_native::SINGLE && n % 32 == 0 && n <= config.width && static_cast<uint64_t>(fullM) * config.width <= 8192 && static_cast<uint64_t>(fullM) * kp <= l0a && static_cast<uint64_t>(config.width) * kp <= l0b && 4ULL * fullM * config.width <= l0c && static_cast<uint64_t>(kp) * (fullM + config.width) <= l1 && compactUb <= ub;
	if (compactMatrix) {
		config.bm = fullM;
		config.producers = 1;
		config.singleShot = true;
		config.slots = 1;
		config.ownerG = 1;
	}
	const uint32_t singleRowTile = config.bm;
	const uint32_t singleRowCapacity = singleRowTile + gmg_native::CUBE_ROW_ALIGN;
	const bool singleNearUniform = config.mode == gmg_native::SINGLE && !config.singleShot && config.bm == 64 && config.width == 256 && n <= config.width && static_cast<uint64_t>((m + singleRowCapacity - 1) / singleRowCapacity) >= config.producers && static_cast<uint64_t>(singleRowCapacity) * kp <= l0a && static_cast<uint64_t>(config.width) * kp <= l0b && 4ULL * singleRowCapacity * config.width <= l0c && static_cast<uint64_t>(kp) * (singleRowCapacity + config.width) <= l1;
	if (singleNearUniform) config.bm = singleRowCapacity;
	const bool singleC0Weight = n == 32 && !(config.mode == gmg_native::FULL_A && static_cast<uint64_t>(m) / e >= 2ULL * config.bm && static_cast<uint64_t>(kp) * (config.bm + config.width) <= l1);
	const uint32_t streamBaseK = config.width == 64 ? 64 : 128;
	const bool narrowKPartition = !singleC0Weight && n <= 128 && 4ULL * config.producers <= capacity && kp >= 16ULL * streamBaseK && (n % 32 != 0 || config.producers == 1 || kp >= 4096);
	const bool heavyWeight = a3 && uint64_t(e)*k*n >= (64ULL<<20);
    if ((config.mode == gmg_native::STREAM && !singleC0Weight) || narrowKPartition
        || (heavyWeight && uint64_t(m)<=128ULL*e && kp>=2048)) {
		const uint32_t sbm = 128, swidth = n <= 128 ? config.width : 256, sl0k = 128;
		const uint32_t segment = ((k + 3) / 4 + sl0k - 1) / sl0k * sl0k;
		const uint32_t parts = (k + segment - 1) / segment;
		const uint64_t residentABytes = static_cast<uint64_t>(sbm) * segment;
		const uint64_t minimumBBytes = 2ULL * sl0k * swidth;
		const uint32_t rowUpper = (m < e ? m : e) + (m - (m < e ? m : e)) / sbm;
		const uint32_t nTiles = (n + swidth - 1) / swidth;
		const uint64_t partialBytes = static_cast<uint64_t>(rowUpper) * nTiles * parts * sbm * swidth * 4;
		const uint64_t taskLower = static_cast<uint64_t>((m + sbm - 1) / sbm) * nTiles * parts;
		if (parts >= 2 && residentABytes + minimumBBytes <= l1 && 2ULL * sbm * sl0k <= l0a && 2ULL * sl0k * swidth <= l0b && 4ULL * sbm * swidth <= l0c && partialBytes <= gmg_tc::kBudgetBytes && (taskLower >= capacity || narrowKPartition) && 180224ULL + (e * 8 + 31) / 32 * 32 + 8448 <= ub) {
			uint32_t sbk = static_cast<uint32_t>((l1 - residentABytes) / (2ULL * swidth) / sl0k * sl0k);
			if (sbk > 4 * sl0k) sbk = 4 * sl0k;
			if (sbk > segment) sbk = segment;
			uint32_t rectangularBk = 0;
			uint64_t allocationBytes = partialBytes;
			const uint64_t rectangularA = 192ULL * segment;
