struct Packet{TaskDesc task;uint32_t first,row,rows;};
__aicore__ inline void Prefetch(const Packet& packet,uint32_t slot,bool last){
const TaskDesc& task = packet.task;
const uint32_t p8 =(task.validN + 7)/ 8 * 8;
const uint64_t offset =(static_cast<uint64_t>(producer_)* slots_ + slot)* bm_ * width_
+(packet.first + packet.row)* width_;
