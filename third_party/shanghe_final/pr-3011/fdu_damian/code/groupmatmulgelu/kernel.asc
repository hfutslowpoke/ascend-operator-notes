#undef L2_CACHE_HINT
#include "kernel_operator.h"
#include "tiling/platform/platform_ascendc.h"
#include "acl/acl.h"
#include <cstring>
namespace gmg{
using namespace AscendC;
constexpr uint32_t COLS = 128;
constexpr uint32_t KSTEP = 32;
struct FloatPair{float hi,lo;};
__aicore__ inline FloatPair PairAdd(FloatPair a,FloatPair b){
volatile float rounded = a.hi + b.hi;
float sum = rounded;
float v = sum - a.hi;
float err =((a.hi -(sum - v))+(b.hi - v))+(a.lo + b.lo);
float hi = sum + err;
return{hi,err -(hi - sum)};
}
__aicore__ inline FloatPair PairNeg(FloatPair a){return{-a.hi,-a.lo};}
__aicore__ inline FloatPair PairMul(FloatPair a,FloatPair b){
volatile float rounded = a.hi * b.hi;
float product = rounded;
float ca = 4097.0f * a.hi,cb = 4097.0f * b.hi;
float ah = ca -(ca - a.hi),bh = cb -(cb - b.hi);
float al = a.hi - ah,bl = b.hi - bh;
float err =(((ah * bh - product)+ ah * bl)+ al * bh)+ al * bl;
err += a.hi * b.lo + a.lo * b.hi;
float hi = product + err;
return{hi,err -(hi - product)};
}
__aicore__ inline FloatPair PairDiv(FloatPair a,FloatPair b){
float q = a.hi / b.hi;
FloatPair rem = PairAdd(a,PairNeg(PairMul(b,{q,0.0f})));
return PairAdd({q,0.0f},{(rem.hi + rem.lo)/ b.hi,0.0f});
}
__aicore__ inline FloatPair PairExp(FloatPair x){
int32_t n = static_cast<int32_t>(x.hi * 1.4426950408889634f - 0.5f);
FloatPair ln2 ={0.6931471824645996f,-1.904654323148236e-9f};
FloatPair r = PairAdd(x,PairNeg(PairMul({static_cast<float>(n),0.0f},ln2)));
FloatPair term ={1.0f,0.0f},sum = term;
for(int j = 1;j <= 14;++j){
term = PairDiv(PairMul(term,r),{static_cast<float>(j),0.0f});
sum = PairAdd(sum,term);
}
union{uint32_t bits;float value;}power;
power.bits = static_cast<uint32_t>(127 + n)<< 23;
return PairMul(sum,{power.value,0.0f});
}
__aicore__ inline float StableGelu(float z){
if(z >= 7.089343070983887f)return z;
if(z <= -8.0f)return 0.0f;
float az = z < 0.0f ? -z : z;
FloatPair a ={az,0.0f};
FloatPair cubic = PairMul(PairMul(a,a),a);
FloatPair inner = PairAdd(a,PairMul(cubic,{0.044714998453855515f,1.5461444832776117e-9f}));
FloatPair exponent = PairMul(inner,{-1.5957691669464111f,4.534068032135963e-8f});
FloatPair tail = PairExp(exponent);
FloatPair numerator = z < 0.0f ? PairMul({z,0.0f},tail): FloatPair{z,0.0f};
FloatPair result = PairDiv(numerator,PairAdd({1.0f,0.0f},tail));
union{float value;uint32_t bits;}value;
value.value = result.hi;
if(result.lo != 0.0f &&(value.bits & 1U)== 0U){
if((result.lo > 0.0f)==(result.hi > 0.0f))++value.bits;
else --value.bits;
}
return value.value;
}
__aicore__ inline FloatPair PairExpHorner(FloatPair x){
float scaled = x.hi * 1.4426950408889634f;
int32_t n = static_cast<int32_t>(scaled +(scaled < 0.0f ? -0.5f : 0.5f));
FloatPair ln2 ={0.6931471824645996f,-1.904654323148236e-9f};
FloatPair r = PairAdd(x,PairNeg(PairMul({static_cast<float>(n),0.0f},ln2)));
FloatPair p ={2.4801587642286904e-05f,0.0f};
p = PairAdd(PairMul(p,r),{0.00019841270113829523f,0.0f});
p = PairAdd(PairMul(p,r),{0.0013888889225199819f,0.0f});
p = PairAdd(PairMul(p,r),{0.0083333337679505348f,0.0f});
p = PairAdd(PairMul(p,r),{0.041666667908430099f,0.0f});
p = PairAdd(PairMul(p,r),{0.1666666716337204f,0.0f});
p = PairAdd(PairMul(p,r),{0.5f,0.0f});
p = PairAdd(PairMul(p,r),{1.0f,0.0f});
p = PairAdd(PairMul(p,r),{1.0f,0.0f});
union{uint32_t bits;float value;}power;
power.bits = static_cast<uint32_t>(127 + n)<< 23;
return PairMul(p,{power.value,0.0f});
}
__aicore__ inline FloatPair FastStableGeluPair(float z){
float az = z < 0.0f ? -z : z;
FloatPair a ={az,0.0f};
FloatPair cubic = PairMul(PairMul(a,a),a);
FloatPair inner = PairAdd(a,PairMul(cubic,{0.044714998453855515f,1.5461444832776117e-9f}));
FloatPair exponent = PairMul(inner,{-1.5957691669464111f,4.534068032135963e-8f});
FloatPair tail = PairExpHorner(exponent);
FloatPair numerator = z < 0.0f ? PairMul({z,0.0f},tail): FloatPair{z,0.0f};
return PairDiv(numerator,PairAdd({1.0f,0.0f},tail));
}
__aicore__ inline float Fp16GridRound(float value){
volatile float split = value * 8193.0f;
float normal = split -(split - value);
volatile float units = value * 16777216.0f;
volatile float biased = units + 12582912.0f;
float subnormal =(biased - 12582912.0f)* 5.9604644775390625e-8f;
float magnitude = value < 0.0f ? -value : value;
return magnitude < 6.103515625e-05f ? subnormal : normal;
}
__aicore__ inline float GeluTwoLevel(float z){
if(!(z > -8.0f && z < 7.089343070983887f))return StableGelu(z);
FloatPair result = FastStableGeluPair(z);
float magnitude = result.hi < 0.0f ? -result.hi : result.hi;
float residual = result.lo < 0.0f ? -result.lo : result.lo;
float bound = residual * 1.01f + magnitude * 3.0e-10f;
float floorBound = magnitude * 1.2e-7f;
if(floorBound > bound)bound = floorBound;
if(Fp16GridRound(result.hi - bound)== Fp16GridRound(result.hi + bound))return result.hi;
return StableGelu(z);
}
constexpr uint32_t GELU_PACKET_SLOTS = 12;
template<uint32_t LANES>
__aicore__ inline LocalTensor<uint8_t> GeluMaskChunk(LocalTensor<float> scratch,uint32_t chunk){
auto masks = scratch[0 * LANES].ReinterpretCast<uint8_t>();
return masks[chunk * 32];
}
template<uint32_t LANES>
__aicore__ inline void GeluSparseCorrection(LocalTensor<float> z,LocalTensor<float> output,
LocalTensor<float> scratch){
for(uint32_t chunk = 0;chunk < LANES / 64;++chunk){
const uint64_t word = static_cast<uint64_t>(
GeluMaskChunk<LANES>(scratch,chunk).template ReinterpretCast<int64_t>().GetValue(0));
const uint32_t base = chunk * 64;
uint64_t rest = word;
while(rest != 0){
const uint64_t isolated = rest &(0ULL - rest);
const uint32_t i = base + static_cast<uint32_t>(
63 - CountLeadingZero(isolated));
output.SetValue(i,GeluTwoLevel(z.GetValue(i)));
rest ^= isolated;
}
}
}
constexpr float GELU_EPS_C0 = 2.5e-7f;
constexpr float GELU_EPS_C1 = 1.2e-7f;
constexpr float GELU_EPS_CEXP = 1.0e-7f;
constexpr float GELU_EXP_C[7]={
0.9999999999718443f,1.0000000281440986f,0.500000008440389f,
0.1666645587633144f,0.04166628033594205f,0.008371912192500938f,
0.001394460096297034f};
#if defined(__NPU_ARCH__)&& __NPU_ARCH__ == 2201
template<uint32_t LANES>
__aicore__ inline void GeluCatlass7Probe(LocalTensor<float> z,LocalTensor<float> output){
const float NEG_SQRT_EIGHT_OVER_PI = -1.595769121 * 0.044715;
const float TANH_APPROX_FACTOR = 1 / 0.044715;
Mul(output,z,z,LANES);PipeBarrier<PIPE_V>();
Mul(output,output,z,LANES);PipeBarrier<PIPE_V>();
Axpy(output,z,TANH_APPROX_FACTOR,LANES);PipeBarrier<PIPE_V>();
Muls(output,output,NEG_SQRT_EIGHT_OVER_PI,LANES);PipeBarrier<PIPE_V>();
Exp(output,output,LANES);PipeBarrier<PIPE_V>();
Adds(output,output,1.0f,LANES);PipeBarrier<PIPE_V>();
Div(output,z,output,LANES);PipeBarrier<PIPE_V>();
}
#endif
template<uint32_t LANES>
__aicore__ inline void GeluPacket(LocalTensor<float> z,LocalTensor<float> output,
LocalTensor<float> scratch,TEventID vecToScalar,TEventID scalarToVec){
#if defined(__NPU_ARCH__)&& __NPU_ARCH__ == 2201
gmg::GeluCatlass7Probe<LANES>(z,output);
return;
#endif
auto c = scratch[0 * LANES];
auto c3 = scratch[1 * LANES];
auto s = scratch[2 * LANES];
auto arg = scratch[3 * LANES];
auto tail = scratch[4 * LANES];
auto sig = scratch[5 * LANES];
auto eps = scratch[6 * LANES];
auto lower = scratch[7 * LANES];
auto upper = scratch[8 * LANES];
auto halves = scratch[9 * LANES];
auto diff = scratch[10 * LANES];
auto fold = scratch[11 * LANES];
auto lowerHalf = halves.ReinterpretCast<half>();
auto upperHalf = halves[LANES / 2].ReinterpretCast<half>();
Mul(c,z,z,LANES);PipeBarrier<PIPE_V>();
Mul(c3,c,z,LANES);PipeBarrier<PIPE_V>();
Muls(c3,c3,0.044714998453855515f,LANES);PipeBarrier<PIPE_V>();
Add(s,c3,z,LANES);PipeBarrier<PIPE_V>();
Muls(arg,s,-1.5957691669464111f,LANES);PipeBarrier<PIPE_V>();
Maxs(arg,arg,-87.0f,LANES);PipeBarrier<PIPE_V>();
Mins(arg,arg,88.0f,LANES);PipeBarrier<PIPE_V>();
Exp(tail,arg,LANES);PipeBarrier<PIPE_V>();
Mins(sig,tail,1.0f,LANES);PipeBarrier<PIPE_V>();
Adds(tail,tail,1.0f,LANES);PipeBarrier<PIPE_V>();
Div(output,z,tail,LANES);PipeBarrier<PIPE_V>();
Abs(arg,arg,LANES);PipeBarrier<PIPE_V>();
Muls(arg,arg,GELU_EPS_C1,LANES);PipeBarrier<PIPE_V>();
Adds(arg,arg,GELU_EPS_CEXP,LANES);PipeBarrier<PIPE_V>();
Mul(sig,sig,arg,LANES);PipeBarrier<PIPE_V>();
Adds(sig,sig,GELU_EPS_C0,LANES);PipeBarrier<PIPE_V>();
Abs(eps,output,LANES);PipeBarrier<PIPE_V>();
Mul(eps,eps,sig,LANES);PipeBarrier<PIPE_V>();
Sub(lower,output,eps,LANES);PipeBarrier<PIPE_V>();
Add(upper,output,eps,LANES);PipeBarrier<PIPE_V>();
Cast(lowerHalf,lower,RoundMode::CAST_RINT,LANES);PipeBarrier<PIPE_V>();
Cast(upperHalf,upper,RoundMode::CAST_RINT,LANES);PipeBarrier<PIPE_V>();
Cast(lower,lowerHalf,RoundMode::CAST_NONE,LANES);PipeBarrier<PIPE_V>();
Cast(upper,upperHalf,RoundMode::CAST_NONE,LANES);PipeBarrier<PIPE_V>();
Sub(diff,upper,lower,LANES);PipeBarrier<PIPE_V>();
Max(fold,diff,diff[LANES / 2],LANES / 2);PipeBarrier<PIPE_V>();
for(uint32_t span = LANES / 2;span > 64;span /= 2){
Max(fold,fold,fold[span / 2],span / 2);PipeBarrier<PIPE_V>();
}
const uint64_t fullMask[2]={~0ULL,~0ULL};
WholeReduceMax(fold,fold,fullMask,1,1,1,1,ReduceOrder::ORDER_ONLY_VALUE);
PipeBarrier<PIPE_V>();
SetFlag<HardEvent::V_S>(vecToScalar);WaitFlag<HardEvent::V_S>(vecToScalar);
if(fold.GetValue(0)== 0.0f)return;
for(uint32_t chunk = 0;chunk < LANES / 64;++chunk){
Compares(GeluMaskChunk<LANES>(scratch,chunk),diff[chunk * 64],0.0f,
CMPMODE::GT,64);
PipeBarrier<PIPE_V>();
}
SetFlag<HardEvent::V_S>(vecToScalar);WaitFlag<HardEvent::V_S>(vecToScalar);
GeluSparseCorrection<LANES>(z,output,scratch);
SetFlag<HardEvent::S_V>(scalarToVec);WaitFlag<HardEvent::S_V>(scalarToVec);
}
__aicore__ inline void Gelu7Count(LocalTensor<float> z,LocalTensor<float> output,uint32_t count){
const float NEG_SQRT_EIGHT_OVER_PI = -1.595769121 * 0.044715;
const float TANH_APPROX_FACTOR = 1 / 0.044715;
Mul(output,z,z,count);PipeBarrier<PIPE_V>();
Mul(output,output,z,count);PipeBarrier<PIPE_V>();
Axpy(output,z,TANH_APPROX_FACTOR,count);PipeBarrier<PIPE_V>();
Muls(output,output,NEG_SQRT_EIGHT_OVER_PI,count);PipeBarrier<PIPE_V>();
Exp(output,output,count);PipeBarrier<PIPE_V>();
Adds(output,output,1.0f,count);PipeBarrier<PIPE_V>();
Div(output,z,output,count);PipeBarrier<PIPE_V>();
}
__aicore__ inline void GeluBatch(LocalTensor<float> z,LocalTensor<float> output,
LocalTensor<float> scratch,uint32_t count,TEventID vecToScalar,TEventID scalarToVec){
if(count == 128){
GeluPacket<128>(z,output,scratch,vecToScalar,scalarToVec);
return;
}
auto paddedZ = scratch[64 * COLS];
Duplicate(paddedZ,0.0f,128);PipeBarrier<PIPE_V>();
Adds(paddedZ,z,0.0f,count);PipeBarrier<PIPE_V>();
GeluPacket<128>(paddedZ,output,scratch,vecToScalar,scalarToVec);
}
class Kernel{
public:
template<bool REUSE_INPUTS = false>
__aicore__ inline void Run(GM_ADDR x,GM_ADDR w,GM_ADDR scale,
GM_ADDR groups,GM_ADDR y,
uint32_t m,uint32_t k,uint32_t n,
uint32_t e,uint32_t cores){
xGm.SetGlobalBuffer((__gm__ int8_t*)x);
wGm.SetGlobalBuffer((__gm__ int8_t*)w);
sGm.SetGlobalBuffer((__gm__ float*)scale);
gGm.SetGlobalBuffer((__gm__ int64_t*)groups);
yGm.SetGlobalBuffer((__gm__ half*)y);
pipe.InitBuffer(qGroup,1,((e * 8 + 31)/ 32)* 32);
pipe.InitBuffer(qX,1,((k + 31)/ 32)* 32);
pipe.InitBuffer(qW,1,KSTEP * COLS);
pipe.InitBuffer(qScale,1,COLS * 4);
pipe.InitBuffer(qY,1,COLS * 2);
pipe.InitBuffer(bHalf,KSTEP * COLS * 2);
pipe.InitBuffer(bInt,KSTEP * COLS * 4);
pipe.InitBuffer(bAcc,COLS * 4);
pipe.InitBuffer(bProduct,COLS * 4);
pipe.InitBuffer(bZ,COLS * 4);
pipe.InitBuffer(bTail,COLS * 4);
#if !defined(__NPU_ARCH__)|| __NPU_ARCH__ != 2201
pipe.InitBuffer(bGelu,68 * COLS * 4);
#endif
auto scalarEvent = pipe.FetchEventID(HardEvent::MTE2_S);
#if !defined(__NPU_ARCH__)|| __NPU_ARCH__ != 2201
auto vecToScalar = pipe.FetchEventID(HardEvent::V_S);
#endif
#if !defined(__NPU_ARCH__)|| __NPU_ARCH__ != 2201
auto scalarToVec = pipe.FetchEventID(HardEvent::S_V);
#endif
auto groupLocal = qGroup.AllocTensor<int64_t>();
DataCopyPad(groupLocal,gGm,{1,e * 8,0,0,0},{false,0,0,0});
qGroup.EnQue(groupLocal);
const uint32_t nTiles =(n + COLS - 1)/ COLS;
const uint32_t firstTask = GetBlockIdx();
const bool hasFirst = firstTask < m * nTiles;
LocalTensor<int8_t> xFirst;
if(hasFirst){
xFirst = qX.AllocTensor<int8_t>();
DataCopyPad(xFirst,xGm[static_cast<uint64_t>(firstTask / nTiles)* k],
{1,k,0,0,0},{true,0,0,0});
qX.EnQue(xFirst);
}
SetFlag<HardEvent::MTE2_S>(scalarEvent);
WaitFlag<HardEvent::MTE2_S>(scalarEvent);
groupLocal = qGroup.DeQue<int64_t>();
LocalTensor<float> residentScale;
uint32_t lastExpert = e,lastCol = n;
uint32_t expert = 0;
for(uint32_t task = GetBlockIdx();task < m * nTiles;task += cores){
const uint32_t row = task / nTiles;
const uint32_t col = task % nTiles * COLS;
const uint32_t count = n - col < COLS ? n - col : COLS;
const uint32_t pitch =(count + 31)/ 32 * 32;
while(row >= groupLocal.GetValue(expert))++expert;
const bool reuse = REUSE_INPUTS && k <= KSTEP
&& lastExpert == expert && lastCol == col;
LocalTensor<int8_t> xLocal;
if(task == firstTask && hasFirst){
xLocal = qX.DeQue<int8_t>();
}else{
xLocal = qX.AllocTensor<int8_t>();
DataCopyPad(xLocal,xGm[static_cast<uint64_t>(row)* k],{1,k,0,0,0},{true,0,0,0});
qX.EnQue(xLocal);
xLocal = qX.DeQue<int8_t>();
SetFlag<HardEvent::MTE2_S>(scalarEvent);
WaitFlag<HardEvent::MTE2_S>(scalarEvent);
}
auto acc = bAcc.Get<int32_t>();
auto product = bProduct.Get<int32_t>();
auto wh = bHalf.Get<half>();
auto wi = bInt.Get<int32_t>();
for(uint32_t kb = 0;kb < k;kb += KSTEP){
const uint32_t ks = k - kb < KSTEP ? k - kb : KSTEP;
LocalTensor<int8_t> wb;
if(!reuse){
wb = qW.AllocTensor<int8_t>();
DataCopyPad(wb,wGm[(static_cast<uint64_t>(expert)* k + kb)* n + col],
{static_cast<uint16_t>(ks),count,n - count,0,0},{true,0,0,0});
qW.EnQue(wb);
wb = qW.DeQue<int8_t>();
Cast(wh,wb,RoundMode::CAST_NONE,ks * pitch);
PipeBarrier<PIPE_V>();
Cast(wi,wh,RoundMode::CAST_RINT,ks * pitch);
PipeBarrier<PIPE_V>();
}
for(uint32_t t = 0;t < ks;++t){
int32_t a = xLocal.GetValue(kb + t);
if(kb == 0 && t == 0){
Muls(acc,wi[t * pitch],a,count);
}else{
Muls(product,wi[t * pitch],a,count);
PipeBarrier<PIPE_V>();
Add(acc,acc,product,count);
}
PipeBarrier<PIPE_V>();
}
if(!reuse)qW.FreeTensor(wb);
}
qX.FreeTensor(xLocal);
LocalTensor<float> scales;
if constexpr(REUSE_INPUTS){
if(!reuse){
if(lastExpert < e)qScale.FreeTensor(residentScale);
residentScale = qScale.AllocTensor<float>();
DataCopyPad(residentScale,sGm[static_cast<uint64_t>(expert)* n + col],{1,count * 4,0,0,0},{false,0,0,0});
qScale.EnQue(residentScale);
residentScale = qScale.DeQue<float>();
}
scales = residentScale;
lastExpert = expert;lastCol = col;
}else{
scales = qScale.AllocTensor<float>();
DataCopyPad(scales,sGm[static_cast<uint64_t>(expert)* n + col],{1,count * 4,0,0,0},{false,0,0,0});
qScale.EnQue(scales);
scales = qScale.DeQue<float>();
}
auto z = bZ.Get<float>();
auto tail = bTail.Get<float>();
#if defined(__NPU_ARCH__)&& __NPU_ARCH__ == 2201
Duplicate(z,0.0f,128);PipeBarrier<PIPE_V>();
#endif
Cast(z,acc,RoundMode::CAST_RINT,count);
PipeBarrier<PIPE_V>();
Mul(z,z,scales,count);
PipeBarrier<PIPE_V>();
if constexpr(!REUSE_INPUTS)qScale.FreeTensor(scales);
#if defined(__NPU_ARCH__)&& __NPU_ARCH__ == 2201
GeluCatlass7Probe<128>(z,tail);
#else
GeluBatch(z,tail,bGelu.Get<float>(),count,vecToScalar,scalarToVec);
#endif
auto output = qY.AllocTensor<half>();
Cast(output,tail,RoundMode::CAST_RINT,count);
qY.EnQue(output);
output = qY.DeQue<half>();
DataCopyPad(yGm[static_cast<uint64_t>(row)* n + col],output,{1,count * 2,0,0,0});
qY.FreeTensor(output);
}
if constexpr(REUSE_INPUTS){
if(lastExpert < e)qScale.FreeTensor(residentScale);
}
qGroup.FreeTensor(groupLocal);
}
private:
TPipe pipe;
TQue<TPosition::VECIN,1> qGroup,qX,qW,qScale;
TQue<TPosition::VECOUT,1> qY;
TBuf<TPosition::VECCALC> bHalf,bInt,bAcc,bProduct;
TBuf<TPosition::VECCALC> bZ,bTail;
#if !defined(__NPU_ARCH__)|| __NPU_ARCH__ != 2201
TBuf<TPosition::VECCALC> bGelu;
#endif
GlobalTensor<int8_t> xGm,wGm;
GlobalTensor<float> sGm;
GlobalTensor<int64_t> gGm;
GlobalTensor<half> yGm;
};
}
__aicore__ inline void ComputeTinyPreloaded(
GM_ADDR x,GM_ADDR weight,GM_ADDR scale,GM_ADDR groups,GM_ADDR output,
uint32_t k,uint32_t n,uint32_t e){
using namespace AscendC;
const uint32_t row = GetBlockIdx();
TPipe pipe;
TBuf<TPosition::VECCALC> groupBuf,aBuf,bBuf,allScaleBuf,scaleBuf;
TBuf<TPosition::VECCALC> accBuf,zBuf,yBuf,outBuf;
pipe.InitBuffer(groupBuf,(e * 8 + 31)/ 32 * 32);
pipe.InitBuffer(aBuf,32);
pipe.InitBuffer(bBuf,(e * k * n + 31)/ 32 * 32);
pipe.InitBuffer(allScaleBuf,(e * n * 4 + 31)/ 32 * 32);
pipe.InitBuffer(scaleBuf,32);pipe.InitBuffer(accBuf,32);
pipe.InitBuffer(zBuf,32);pipe.InitBuffer(yBuf,32);pipe.InitBuffer(outBuf,32);
GlobalTensor<int8_t> xGm,wGm;
GlobalTensor<float> sGm;
GlobalTensor<int64_t> gGm;
GlobalTensor<half> yGm;
xGm.SetGlobalBuffer((__gm__ int8_t*)x);wGm.SetGlobalBuffer((__gm__ int8_t*)weight);
sGm.SetGlobalBuffer((__gm__ float*)scale);gGm.SetGlobalBuffer((__gm__ int64_t*)groups);
yGm.SetGlobalBuffer((__gm__ half*)output);
auto group = groupBuf.Get<int64_t>();auto a = aBuf.Get<int8_t>();
auto b = bBuf.Get<int8_t>();auto allScale = allScaleBuf.Get<float>();
auto ready = pipe.AllocEventID<HardEvent::MTE2_S>();
auto scalarReady = pipe.AllocEventID<HardEvent::S_V>();
auto outReady = pipe.AllocEventID<HardEvent::V_MTE3>();
DataCopyPad(group,gGm,{1,e * 8,0,0,0},{false,0,0,0});
DataCopyPad(a,xGm[static_cast<uint64_t>(row)* k],{1,k,0,0,0},{false,0,0,0});
DataCopyPad(b,wGm,{1,e * k * n,0,0,0},{false,0,0,0});
DataCopyPad(allScale,sGm,{1,e * n * 4,0,0,0},{false,0,0,0});
SetFlag<HardEvent::MTE2_S>(ready);WaitFlag<HardEvent::MTE2_S>(ready);
uint32_t expert = 0;
while(row >= group.GetValue(expert))++expert;
auto acc = accBuf.Get<int32_t>();auto scales = scaleBuf.Get<float>();
for(uint32_t col = 0;col < n;++col){
int32_t dot = 0;
for(uint32_t t = 0;t < k;++t)
dot += static_cast<int32_t>(a.GetValue(t))
* static_cast<int32_t>(b.GetValue((expert * k + t)* n + col));
acc.SetValue(col,dot);
scales.SetValue(col,allScale.GetValue(expert * n + col));
}
SetFlag<HardEvent::S_V>(scalarReady);WaitFlag<HardEvent::S_V>(scalarReady);
auto z = zBuf.Get<float>();auto y = yBuf.Get<float>();
Cast(z,acc,RoundMode::CAST_RINT,n);PipeBarrier<PIPE_V>();
Mul(z,z,scales,n);PipeBarrier<PIPE_V>();
gmg::Gelu7Count(z,y,n);
auto out = outBuf.Get<half>();Cast(out,y,RoundMode::CAST_RINT,n);
SetFlag<HardEvent::V_MTE3>(outReady);WaitFlag<HardEvent::V_MTE3>(outReady);
DataCopyPad(yGm[static_cast<uint64_t>(row)* n],out,{1,n * 2,0,0,0});
PipeBarrier<PIPE_ALL>();
pipe.ReleaseEventID<HardEvent::MTE2_S>(ready);
pipe.ReleaseEventID<HardEvent::S_V>(scalarReady);
pipe.ReleaseEventID<HardEvent::V_MTE3>(outReady);
}
template<uint32_t K,uint32_t N>
__aicore__ inline void ComputeTinyStaticKN(
GM_ADDR x,GM_ADDR weight,GM_ADDR scale,GM_ADDR groups,GM_ADDR output,
uint32_t e){
if constexpr(K == 1 && N == 1){
constexpr uint32_t k = K;
constexpr uint32_t n = N;
using namespace AscendC;
const uint32_t row = GetBlockIdx();
GlobalTensor<int8_t> xGm,wGm;
GlobalTensor<float> sGm;
GlobalTensor<int64_t> gGm;
GlobalTensor<half> yGm;
xGm.SetGlobalBuffer((__gm__ int8_t*)x);wGm.SetGlobalBuffer((__gm__ int8_t*)weight);
sGm.SetGlobalBuffer((__gm__ float*)scale);gGm.SetGlobalBuffer((__gm__ int64_t*)groups);
yGm.SetGlobalBuffer((__gm__ half*)output);
if constexpr(K == 1 && N == 1){
DataCacheCleanAndInvalid<int8_t,CacheLine::ENTIRE_DATA_CACHE,DcciDst::CACHELINE_OUT>(xGm);
GlobalTensor<uint64_t> xCache,gCache;
xCache.SetGlobalBuffer((__gm__ uint64_t*)x);gCache.SetGlobalBuffer((__gm__ uint64_t*)groups);
DataCachePreload(xCache,static_cast<int64_t>(row));
DataCachePreload(gCache,int16_t(0));
GlobalTensor<uint64_t> wCache,sCache;
wCache.SetGlobalBuffer((__gm__ uint64_t*)weight);sCache.SetGlobalBuffer((__gm__ uint64_t*)scale);
DataCachePreload(wCache,int16_t(0));
DataCachePreload(sCache,int16_t(0));
}
LocalTensor<int64_t> group(TPosition::VECCALC,0,1024);
LocalTensor<int8_t> a(TPosition::VECCALC,24576,32);
LocalTensor<int8_t> b(TPosition::VECCALC,8192,8192);
LocalTensor<float> allScale(TPosition::VECCALC,16384,2048);
if constexpr(K != 1 || N != 1){
DataCopyPad(group,gGm,{1,e * 8,0,0,0},{false,0,0,0});
}
if constexpr(K != 1 || N != 1){
DataCopyPad(a,xGm[static_cast<uint64_t>(row)* k],{1,k,0,0,0},{false,0,0,0});
DataCopyPad(b,wGm,{1,e * k * n,0,0,0},{false,0,0,0});
DataCopyPad(allScale,sGm,{1,e * n * 4,0,0,0},{false,0,0,0});
}
uint32_t expert = 0;
if constexpr(K == 1 && N == 1)
while(row >= gGm.GetValue(expert))++expert;
if constexpr(K != 1 || N != 1){
SetFlag<HardEvent::MTE2_S>(0);WaitFlag<HardEvent::MTE2_S>(0);
}
if constexpr(K != 1 || N != 1)
while(row >= group.GetValue(expert))++expert;
LocalTensor<float> z(TPosition::VECCALC,24608,8);
LocalTensor<float> y(TPosition::VECCALC,24640,8);
bool polynomial = false;
int32_t aValues[K];
#pragma unroll
for(uint32_t t = 0;t < K;++t)
if constexpr(K == 1 && N == 1)aValues[t]= static_cast<int32_t>(xGm.GetValue(row));
else aValues[t]= static_cast<int32_t>(a.GetValue(t));
#pragma unroll
for(uint32_t col = 0;col < n;++col){
int32_t dot = 0;
#pragma unroll
for(uint32_t t = 0;t < K;++t){
if constexpr(K == 1 && N == 1)dot += aValues[t]* static_cast<int32_t>(wGm.GetValue(expert));
else dot += aValues[t]* static_cast<int32_t>(b.GetValue((expert * k + t)* n + col));
}
float value;
if constexpr(K == 1 && N == 1)value = static_cast<float>(dot)* sGm.GetValue(expert);
else value = static_cast<float>(dot)* allScale.GetValue(expert * n + col);
z.SetValue(col,value);
if constexpr(K == 1 && N == 1){
const float square = value * value;
polynomial = square >= 5.960464477539063e-8f && square <= 1.0f;
if(polynomial){
float p = 0.0001177832527901046f;
p = p * square - 0.001243028906174004f;
p = p * square + 0.01020155753940344f;
p = p * square - 0.06681947410106659f;
p = p * square + 0.3989422917366028f;
union{float f;uint32_t u;}rne;
rne.f=0.5f * value + square * p;
const uint32_t mag=rne.u&0x7fffffff;
const uint16_t bits=((rne.u>>16)&0x8000)|(((mag+0xfff+((mag>>13)&1))>>13)-0x1c000);
LocalTensor<uint16_t> scalarOut(TPosition::VECCALC,24672,16);
scalarOut.SetValue(0,bits);
SetFlag<HardEvent::S_MTE3>(0);WaitFlag<HardEvent::S_MTE3>(0);
DataCopyPad(yGm[static_cast<uint64_t>(row)],scalarOut.ReinterpretCast<half>(),{1,2,0,0,0});
return;
}else{
y.SetValue(0,square * value);
}
}
}
SetFlag<HardEvent::S_V>(0);WaitFlag<HardEvent::S_V>(0);
if constexpr(K == 1 && N == 1){
if(!polynomial){
Axpy(y,z,float(1 / 0.044715),1);PipeBarrier<PIPE_V>();
Muls(y,y,float(-1.595769121 * 0.044715),1);PipeBarrier<PIPE_V>();
Exp(y,y,1);PipeBarrier<PIPE_V>();
Adds(y,y,1.0f,1);PipeBarrier<PIPE_V>();
Div(y,z,y,1);PipeBarrier<PIPE_V>();
}
}else{
gmg::Gelu7Count(z,y,n);
}
LocalTensor<half> out(TPosition::VECCALC,24672,16);Cast(out,y,RoundMode::CAST_RINT,n);
SetFlag<HardEvent::V_MTE3>(0);WaitFlag<HardEvent::V_MTE3>(0);
DataCopyPad(yGm[static_cast<uint64_t>(row)* n],out,{1,n * 2,0,0,0});
}else{
constexpr uint32_t k = K;
constexpr uint32_t n = N;
using namespace AscendC;
const uint32_t row = GetBlockIdx();
GlobalTensor<int8_t> xGm,wGm;
GlobalTensor<float> sGm;
GlobalTensor<int64_t> gGm;
GlobalTensor<half> yGm;
xGm.SetGlobalBuffer((__gm__ int8_t*)x);wGm.SetGlobalBuffer((__gm__ int8_t*)weight);
sGm.SetGlobalBuffer((__gm__ float*)scale);gGm.SetGlobalBuffer((__gm__ int64_t*)groups);
yGm.SetGlobalBuffer((__gm__ half*)output);
LocalTensor<int64_t> group(TPosition::VECCALC,0,1024);
LocalTensor<int8_t> a(TPosition::VECCALC,24576,32);
LocalTensor<int8_t> b(TPosition::VECCALC,8192,8192);
LocalTensor<float> allScale(TPosition::VECCALC,16384,2048);
if constexpr(K != 1 || N != 1){
DataCopyPad(group,gGm,{1,e * 8,0,0,0},{false,0,0,0});
}
DataCopyPad(a,xGm[static_cast<uint64_t>(row)* k],{1,k,0,0,0},{false,0,0,0});
DataCopyPad(b,wGm,{1,e * k * n,0,0,0},{false,0,0,0});
if constexpr(K != 1 || N != 1)SetFlag<HardEvent::MTE2_S>(0);
DataCopyPad(allScale,sGm,{1,e * n * 4,0,0,0},{false,0,0,0});
if constexpr(K != 1 || N != 1)SetFlag<HardEvent::MTE2_S>(1);
uint32_t expert = 0;
if constexpr(K == 1 && N == 1)
while(row >= gGm.GetValue(expert))++expert;
if constexpr(K == 1 && N == 1)SetFlag<HardEvent::MTE2_S>(0);
WaitFlag<HardEvent::MTE2_S>(0);
if constexpr(K != 1 || N != 1)
while(row >= group.GetValue(expert))++expert;
LocalTensor<float> z(TPosition::VECCALC,24608,8);
LocalTensor<float> y(TPosition::VECCALC,24640,8);
bool polynomial = false;
int32_t aValues[K];
#pragma unroll
for(uint32_t t = 0;t < K;++t)
aValues[t]= static_cast<int32_t>(a.GetValue(t));
int32_t dot0 = 0,dot1 = 0;
if constexpr(K != 1 || N != 1){
#pragma unroll
for(uint32_t t = 0;t < K;++t)
dot0 += aValues[t]* static_cast<int32_t>(b.GetValue((expert * k + t)* n));
if constexpr(N > 1){
#pragma unroll
for(uint32_t t = 0;t < K;++t)
dot1 += aValues[t]* static_cast<int32_t>(b.GetValue((expert * k + t)* n + 1));
}
WaitFlag<HardEvent::MTE2_S>(1);
}
#pragma unroll
for(uint32_t col = 0;col < n;++col){
int32_t dot = 0;
if constexpr(K != 1 || N != 1){
if(col == 0)dot = dot0;
else if(col == 1)dot = dot1;
else{
#pragma unroll
for(uint32_t t = 0;t < K;++t)
dot += aValues[t]
* static_cast<int32_t>(b.GetValue((expert * k + t)* n + col));
}
}else{
#pragma unroll
for(uint32_t t = 0;t < K;++t)
dot += aValues[t]
* static_cast<int32_t>(b.GetValue((expert * k + t)* n + col));
}
const float value = static_cast<float>(dot)* allScale.GetValue(expert * n + col);
z.SetValue(col,value);
if constexpr(K == 1 && N == 1){
const float square = value * value;
polynomial = square >= 5.960464477539063e-8f && square <= 1.0f;
if(polynomial){
float p = 0.0001177832527901046f;
p = p * square - 0.001243028906174004f;
p = p * square + 0.01020155753940344f;
p = p * square - 0.06681947410106659f;
p = p * square + 0.3989422917366028f;
y.SetValue(0,0.5f * value + square * p);
}else{
y.SetValue(0,square * value);
}
}
}
SetFlag<HardEvent::S_V>(0);WaitFlag<HardEvent::S_V>(0);
if constexpr(K == 1 && N == 1){
if(!polynomial){
Axpy(y,z,float(1 / 0.044715),1);PipeBarrier<PIPE_V>();
Muls(y,y,float(-1.595769121 * 0.044715),1);PipeBarrier<PIPE_V>();
Exp(y,y,1);PipeBarrier<PIPE_V>();
Adds(y,y,1.0f,1);PipeBarrier<PIPE_V>();
Div(y,z,y,1);PipeBarrier<PIPE_V>();
}
}else{
gmg::Gelu7Count(z,y,n);
}
LocalTensor<half> out(TPosition::VECCALC,24672,16);Cast(out,y,RoundMode::CAST_RINT,n);
SetFlag<HardEvent::V_MTE3>(0);WaitFlag<HardEvent::V_MTE3>(0);
DataCopyPad(yGm[static_cast<uint64_t>(row)* n],out,{1,n * 2,0,0,0});
}
}
template<uint32_t K,uint32_t N>
__global__ __vector__ void grouped_matmul_gelu_tiny_static_kn(
GM_ADDR x,GM_ADDR weight,GM_ADDR scale,GM_ADDR groups,GM_ADDR y,
uint32_t m,uint32_t e){
#if defined(__NPU_ARCH__)&& __NPU_ARCH__ == 2201
AscendC::InitSocState();
if(AscendC::GetBlockIdx()< m)ComputeTinyStaticKN<K,N>(x,weight,scale,groups,y,e);
AscendC::PipeBarrier<PIPE_ALL>();
#endif
}
__global__ __vector__ void grouped_matmul_gelu_custom(
GM_ADDR x,GM_ADDR weight,GM_ADDR scale,GM_ADDR group_list,GM_ADDR y,
uint32_t m,uint32_t k,uint32_t n,uint32_t e,uint32_t cores)
{
#if defined(__NPU_ARCH__)&& __NPU_ARCH__ == 2201
const uint64_t tinyBytes = static_cast<uint64_t>(e)*(k * n + n * 4 + 8);
if(k <= 8 && n <= 8 && m <= cores && tinyBytes <= 8192){
if(AscendC::GetBlockIdx()< m)ComputeTinyPreloaded(x,weight,scale,group_list,y,k,n,e);
return;
}
#endif
gmg::Kernel op;
op.Run(x,weight,scale,group_list,y,m,k,n,e,cores);
}
__global__ __vector__ void grouped_matmul_gelu_resident_inputs(
GM_ADDR x,GM_ADDR weight,GM_ADDR scale,GM_ADDR group_list,GM_ADDR y,
uint32_t m,uint32_t k,uint32_t n,uint32_t e,uint32_t cores)
{
gmg::Kernel op;
op.Run<true>(x,weight,scale,group_list,y,m,k,n,e,cores);
}
namespace gmg_native{
using namespace AscendC;
constexpr uint32_t SLOTS = 4;
constexpr uint32_t WHOLE_PACKET_LANES = 16384;
constexpr uint32_t READY_BASE = 8;
constexpr uint32_t FREE_BASE = 12;
constexpr uint32_t SINGLE = 0,FULL_A = 1,STREAM = 2;
constexpr uint32_t CUBE_ROW_ALIGN = 16;
struct TaskDesc{uint32_t expert,row,col,validM,validN;};
namespace gmg_tc{
constexpr uint64_t kBudgetBytes = 64ULL << 20;
constexpr bool kEnableTranscode = true;
constexpr uint32_t kPhase1Ub = 64 * 1024;
constexpr uint32_t kMaxBandRows = 4095;
constexpr uint16_t kFlag = 5;
__aicore__ inline uint32_t NPadOf(uint32_t n){return(n + 31)/ 32 * 32;}
__aicore__ inline uint32_t ChunksOf(uint32_t k,uint32_t bk){return(k + bk - 1)/ bk;}
__aicore__ inline uint32_t Phase1Rows(uint32_t n){
uint32_t rows =(kPhase1Ub - 64)/(2 * NPadOf(n));
if(rows < 1)rows = 1;
if(rows > kMaxBandRows)rows = kMaxBandRows;
return rows;
}
static uint32_t Phase1RowsHost(uint32_t n){
const uint32_t nPad =(n + 31)/ 32 * 32;
uint32_t rows =(kPhase1Ub - 64)/(2 * nPad);
if(rows < 1)rows = 1;
if(rows > kMaxBandRows)rows = kMaxBandRows;
return rows;
}
static uint64_t Phase1UbHost(uint32_t n){
const uint64_t nPad =(static_cast<uint64_t>(n)+ 31)/ 32 * 32;
return static_cast<uint64_t>(Phase1RowsHost(n))* 2 * nPad;
}
static uint64_t ImageBytesHost(uint32_t e,uint32_t k,uint32_t n,uint32_t bk){
const uint64_t chunks =(static_cast<uint64_t>(k)+ bk - 1)/ bk;
const uint64_t nPad =(static_cast<uint64_t>(n)+ 31)/ 32 * 32;
return static_cast<uint64_t>(e)* chunks * bk * nPad;
}
#if !defined(__DAV_C220_CUBE__)
__aicore__ inline void TranscodeAiv(TPipe& pipe,GM_ADDR weight,GM_ADDR image,
uint32_t k,uint32_t n,uint32_t e,uint32_t bk,uint32_t blocks){
GlobalTensor<int8_t> wGm;
GlobalTensor<int8_t> nzGm;
wGm.SetGlobalBuffer((__gm__ int8_t*)weight);
nzGm.SetGlobalBuffer((__gm__ int8_t*)image);
const uint32_t nPad = NPadOf(n);
const uint32_t band = Phase1Rows(n);
TBuf<TPosition::VECCALC> stageBuf;
TBuf<TPosition::VECCALC> pieceBuf;
pipe.InitBuffer(stageBuf,band * nPad);
pipe.InitBuffer(pieceBuf,band * nPad);
auto stage = stageBuf.Get<int8_t>();
auto piece = pieceBuf.Get<int8_t>();
auto mte2ToV = pipe.FetchEventID(HardEvent::MTE2_V);
auto vToMte3 = pipe.FetchEventID(HardEvent::V_MTE3);
auto mte3ToV = pipe.FetchEventID(HardEvent::MTE3_V);
auto vToMte2 = pipe.FetchEventID(HardEvent::V_MTE2);
SetFlag<HardEvent::MTE3_V>(mte3ToV);
SetFlag<HardEvent::V_MTE2>(vToMte2);
const uint32_t chunks = ChunksOf(k,bk);
const uint32_t slabCount = nPad / 32;
const uint32_t lane =(GetBlockIdx()/ 2)* 2 + GetSubBlockIdx();
const uint32_t lanes = blocks * 2;
uint32_t item = 0;
for(uint32_t expert = 0;expert < e;++expert){
for(uint32_t chunk = 0;chunk < chunks;++chunk){
const uint32_t remaining = k - chunk * bk;
const uint32_t qActual = remaining < bk ? remaining : bk;
const uint32_t qPadK =(qActual + 31)/ 32 * 32;
const uint32_t bands =(qActual + band - 1)/ band;
for(uint32_t b = 0;b < bands;++b,++item){
if(item % lanes != lane)continue;
const uint32_t row0 = b * band;
const uint32_t rows =(qActual - row0)< band
?(qActual - row0): band;
const uint64_t src = static_cast<uint64_t>(expert)* k * n
+ static_cast<uint64_t>(chunk)* bk * n
+ static_cast<uint64_t>(row0)* n;
const uint64_t dst = static_cast<uint64_t>(expert)* chunks * bk * nPad
+ static_cast<uint64_t>(chunk)* bk * nPad
+ static_cast<uint64_t>(row0)* 32;
WaitFlag<HardEvent::V_MTE2>(vToMte2);
DataCopyPad(stage,wGm[src],
{static_cast<uint16_t>(rows),n,0,0,0},
DataCopyPadExtParams<int8_t>{false,0,0,0});
SetFlag<HardEvent::MTE2_V>(mte2ToV);
WaitFlag<HardEvent::MTE2_V>(mte2ToV);
WaitFlag<HardEvent::MTE3_V>(mte3ToV);
for(uint32_t s = 0;s < slabCount;++s){
DataCopy(piece[s * rows * 32],stage[s * 32],
{static_cast<uint16_t>(rows),1,
static_cast<uint16_t>(nPad / 32 - 1),0});
}
SetFlag<HardEvent::V_MTE2>(vToMte2);
SetFlag<HardEvent::V_MTE3>(vToMte3);
WaitFlag<HardEvent::V_MTE3>(vToMte3);
DataCopyPad(nzGm[dst],piece,
{static_cast<uint16_t>(slabCount),rows * 32,0,
(qPadK - rows)* 32,0});
SetFlag<HardEvent::MTE3_V>(mte3ToV);
}
}
}
WaitFlag<HardEvent::MTE3_V>(mte3ToV);
WaitFlag<HardEvent::V_MTE2>(vToMte2);
SyncAll();
CrossCoreSetFlag<2,PIPE_MTE3>(kFlag);
}
#endif
}// namespace gmg_tc
#if !defined(__DAV_C220_CUBE__)
__aicore__ inline void PreparePitchedActivations(TPipe& pipe,GM_ADDR x,GM_ADDR image,
uint32_t m,uint32_t k,uint32_t pitch,uint32_t producers){
const uint32_t band = 32768 / pitch,bytes = band * pitch;
const uint32_t paddedK =(k + 31)/ 32 * 32;
TBuf<TPosition::VECIN> dataBuffer;
pipe.InitBuffer(dataBuffer,2 * bytes);
auto data = dataBuffer.Get<int8_t>();
GlobalTensor<int8_t> input,output;
input.SetGlobalBuffer((__gm__ int8_t*)x);output.SetGlobalBuffer((__gm__ int8_t*)image);
Duplicate(data.ReinterpretCast<int32_t>(),int32_t(0),2 * bytes / 4);
const auto clearReady = pipe.AllocEventID<HardEvent::V_MTE2>();
SetFlag<HardEvent::V_MTE2>(clearReady);WaitFlag<HardEvent::V_MTE2>(clearReady);
pipe.ReleaseEventID<HardEvent::V_MTE2>(clearReady);
TEventID free[2],loaded[2],ready[2];
for(uint32_t bank = 0;bank < 2;++bank){
free[bank]= pipe.AllocEventID<HardEvent::MTE3_MTE2>();
loaded[bank]= pipe.AllocEventID<HardEvent::MTE2_V>();
ready[bank]= pipe.AllocEventID<HardEvent::V_MTE3>();
SetFlag<HardEvent::MTE3_MTE2>(free[bank]);
}
const uint32_t lane =(GetBlockIdx()/ 2)* 2 + GetSubBlockIdx();
uint32_t sequence = 0;
for(uint32_t first = lane * band;first < m;first += 2 * producers * band){
const uint32_t rows = m - first < band ? m - first : band;
const uint32_t bank = sequence++ % 2;
auto stage = data[bank * bytes];
WaitFlag<HardEvent::MTE3_MTE2>(free[bank]);
DataCopyPad(stage,input[static_cast<uint64_t>(first)* k],
{static_cast<uint16_t>(rows),k,0,(pitch - paddedK)/ 32,0},
DataCopyPadExtParams<int8_t>{true,0,static_cast<uint8_t>(paddedK - k),0});
SetFlag<HardEvent::MTE2_V>(loaded[bank]);WaitFlag<HardEvent::MTE2_V>(loaded[bank]);
SetFlag<HardEvent::V_MTE3>(ready[bank]);WaitFlag<HardEvent::V_MTE3>(ready[bank]);
DataCopy(output[static_cast<uint64_t>(first)* pitch],stage,rows * pitch);
SetFlag<HardEvent::MTE3_MTE2>(free[bank]);
}
for(uint32_t bank = 0;bank < 2;++bank){
WaitFlag<HardEvent::MTE3_MTE2>(free[bank]);
pipe.ReleaseEventID<HardEvent::MTE3_MTE2>(free[bank]);
pipe.ReleaseEventID<HardEvent::MTE2_V>(loaded[bank]);
pipe.ReleaseEventID<HardEvent::V_MTE3>(ready[bank]);
}
PipeBarrier<PIPE_ALL>();pipe.Reset();
SyncAll<true>();CrossCoreSetFlag<2,PIPE_MTE3>(5);
}
#endif
#if defined(__NPU_ARCH__)&& __NPU_ARCH__ == 2201
#if defined(__DAV_C220_CUBE__)
constexpr IsResetLoad3dConfig kALoad3dConfig ={false,false};
class SingleProducer{
public:
__aicore__ inline SingleProducer(TPipe& pipe): pipe_(pipe){}
__aicore__ inline void Init(GM_ADDR x,GM_ADDR weight,GM_ADDR ring,
uint32_t k,uint32_t n,uint32_t producer,uint32_t bm,uint32_t width,
bool singleShot){
xGm_.SetGlobalBuffer((__gm__ int8_t*)x);
wGm_.SetGlobalBuffer((__gm__ int8_t*)weight);
ringGm_.SetGlobalBuffer((__gm__ int32_t*)ring);
k_ = k;n_ = n;kPad_ =(k + 31)/ 32 * 32;
producer_ = producer;bm_ = bm;width_ = width;
singleShot_ = singleShot;slots_ = singleShot ? 1 : 4;
pipe_.InitBuffer(a1_,bm_ * kPad_);
pipe_.InitBuffer(b1_,kPad_ * width_);
pipe_.InitBuffer(a2_,bm_ * kPad_);
pipe_.InitBuffer(b2_,kPad_ * width_);
pipe_.InitBuffer(c_,bm_ * width_ * sizeof(int32_t));
l1Ready_ = pipe_.AllocEventID<HardEvent::MTE2_MTE1>();
abReady_ = pipe_.AllocEventID<HardEvent::MTE1_M>();
cReady_ = pipe_.AllocEventID<HardEvent::M_FIX>();
if(!singleShot_){
l1Free_ = pipe_.AllocEventID<HardEvent::MTE1_MTE2>();
abFree_ = pipe_.AllocEventID<HardEvent::M_MTE1>();
cFree_ = pipe_.AllocEventID<HardEvent::FIX_M>();
SetFlag<HardEvent::MTE1_MTE2>(l1Free_);
SetFlag<HardEvent::M_MTE1>(abFree_);
}
}
__aicore__ inline void BeginOwner(uint32_t,uint32_t){}
__aicore__ inline void Produce(const TaskDesc& task,uint32_t sequence,bool){
if(!singleShot_)WaitFlag<HardEvent::MTE1_MTE2>(l1Free_);
const uint32_t mpad =(task.validM + 15)/ 16 * 16;
const uint32_t npad =(task.validN + 31)/ 32 * 32;
Nd2NzParams a;
a.ndNum = 1;a.nValue = task.validM;a.dValue = k_;
a.srcNdMatrixStride = 0;a.srcDValue = k_;
a.dstNzC0Stride = mpad;a.dstNzNStride = 1;a.dstNzMatrixStride = 0;
DataCopy(a1_.Get<int8_t>(),xGm_[static_cast<uint64_t>(task.row)* k_],a);
if(mpad > task.validM){
Fill<uint32_t>(a1_.Get<uint32_t>()[task.validM * 8],
{static_cast<uint16_t>(kPad_ / 32),static_cast<uint16_t>(mpad - task.validM),
static_cast<uint16_t>(task.validM),0u});
}
Nd2NzParams b;
b.ndNum = 1;b.nValue = k_;b.dValue = task.validN;
b.srcNdMatrixStride = 0;b.srcDValue = n_;
b.dstNzC0Stride = kPad_;b.dstNzNStride = 1;b.dstNzMatrixStride = 0;
DataCopy(b1_.Get<int8_t>(),
wGm_[static_cast<uint64_t>(task.expert)* k_ * n_ + task.col],b);
if(kPad_ > k_){
Fill<uint32_t>(b1_.Get<uint32_t>()[k_ * 8],
{static_cast<uint16_t>(npad / 32),static_cast<uint16_t>(kPad_ - k_),
static_cast<uint16_t>(k_),0u});
}
SetFlag<HardEvent::MTE2_MTE1>(l1Ready_);
WaitFlag<HardEvent::MTE2_MTE1>(l1Ready_);
if(!singleShot_)WaitFlag<HardEvent::M_MTE1>(abFree_);
LoadData2DParams ap;
ap.startIndex = 0;ap.repeatTimes = kPad_ / 32;ap.srcStride = mpad / 16;
ap.dstGap = 0;ap.ifTranspose = false;ap.sid = 0;ap.addrMode = 0;
for(uint32_t j = 0;j < mpad / 16;++j)
LoadData<int8_t>(a2_.Get<int8_t>()[j * 16 * kPad_],a1_.Get<int8_t>()[j * 512],ap);
LoadData2dTransposeParams bp;
bp.startIndex = 0;bp.repeatTimes = npad / 32;bp.srcStride = kPad_ / 32;
bp.dstGap = 1;bp.dstFracGap = 0;bp.addrMode = 0;
for(uint32_t i = 0;i < kPad_ / 32;++i)
LoadDataWithTranspose<int8_t>(b2_.Get<int8_t>()[i * 32 * npad],b1_.Get<int8_t>()[i * 1024],bp);
if(!singleShot_)SetFlag<HardEvent::MTE1_MTE2>(l1Free_);
SetFlag<HardEvent::MTE1_M>(abReady_);
WaitFlag<HardEvent::MTE1_M>(abReady_);
if(!singleShot_ && sequence != 0)WaitFlag<HardEvent::FIX_M>(cFree_);
MmadParams mm;
mm.m = mpad;mm.n = npad;mm.k = kPad_;
mm.unitFlag = 0;mm.cmatrixSource = false;mm.cmatrixInitVal = true;
mm.isBias = false;mm.kDirectionAlign = false;
mm.fmOffset = 0;mm.enSsparse = false;
mm.enWinogradA = false;mm.enWinogradB = false;
Mmad<int32_t,int8_t,int8_t>(c_.Get<int32_t>(),a2_.Get<int8_t>(),b2_.Get<int8_t>(),mm);
if(!singleShot_)SetFlag<HardEvent::M_MTE1>(abFree_);
SetFlag<HardEvent::M_FIX>(cReady_);
WaitFlag<HardEvent::M_FIX>(cReady_);
const uint32_t slot = sequence % slots_;
if(!singleShot_ && sequence >= slots_)CrossCoreWaitFlag<2>(FREE_BASE + slot);
FixpipeParamsV220 fp;
fp.nSize = npad;fp.mSize = task.validM;
fp.srcStride = mpad;fp.dstStride = width_;
fp.quantPre = QuantMode_t::NoQuant;fp.deqScalar = 0;
fp.ndNum = 1;fp.srcNdStride = 0;fp.dstNdStride = 0;
fp.reluEn = false;fp.unitFlag = 0;fp.isChannelSplit = false;
const uint64_t offset =(static_cast<uint64_t>(producer_)* slots_ + slot)* bm_ * width_;
Fixpipe<int32_t,int32_t,CFG_ROW_MAJOR>(ringGm_[offset],c_.Get<int32_t>(),fp);
CrossCoreSetFlag<2,PIPE_FIX>(READY_BASE + slot);
if(!singleShot_)SetFlag<HardEvent::FIX_M>(cFree_);
}
__aicore__ inline void PostCompute(uint32_t produced){
if(!singleShot_){
WaitFlag<HardEvent::MTE1_MTE2>(l1Free_);
WaitFlag<HardEvent::M_MTE1>(abFree_);
if(produced != 0)WaitFlag<HardEvent::FIX_M>(cFree_);
const uint32_t first = produced > slots_ ? produced - slots_ : 0;
for(uint32_t sequence = first;sequence < produced;++sequence)
CrossCoreWaitFlag<2>(FREE_BASE + sequence % slots_);
}
PipeBarrier<PIPE_ALL>();
pipe_.ReleaseEventID<HardEvent::MTE2_MTE1>(l1Ready_);
pipe_.ReleaseEventID<HardEvent::MTE1_M>(abReady_);
pipe_.ReleaseEventID<HardEvent::M_FIX>(cReady_);
if(!singleShot_){
pipe_.ReleaseEventID<HardEvent::MTE1_MTE2>(l1Free_);
pipe_.ReleaseEventID<HardEvent::M_MTE1>(abFree_);
pipe_.ReleaseEventID<HardEvent::FIX_M>(cFree_);
}
}
private:
TPipe& pipe_;
TBuf<TPosition::A1> a1_;
TBuf<TPosition::B1> b1_;
TBuf<TPosition::A2> a2_;
TBuf<TPosition::B2> b2_;
TBuf<TPosition::CO1> c_;
GlobalTensor<int8_t> xGm_,wGm_;
GlobalTensor<int32_t> ringGm_;
TEventID l1Ready_,abReady_,cReady_,l1Free_,abFree_,cFree_;
uint32_t k_,n_,kPad_,producer_,bm_,width_,slots_;
bool singleShot_;
};
class CompactStaticCubeProducer{
public:
__aicore__ inline void Init(GM_ADDR x,GM_ADDR weight,GM_ADDR ring,
uint32_t k,uint32_t n,uint32_t bm,uint32_t width){
xGm_.SetGlobalBuffer((__gm__ int8_t*)x);
wGm_.SetGlobalBuffer((__gm__ int8_t*)weight);
ringGm_.SetGlobalBuffer((__gm__ int32_t*)ring);
k_ = k;n_ = n;kPad_ =(k + 31)/ 32 * 32;
bm_ = bm;width_ = width;
}
__aicore__ inline void Produce(const TaskDesc& task){
LocalTensor<int8_t> a1(TPosition::A1,0,bm_ * kPad_);
LocalTensor<int8_t> b1(TPosition::B1,bm_ * kPad_,kPad_ * width_);
LocalTensor<int8_t> a2(TPosition::A2,0,bm_ * kPad_);
LocalTensor<int8_t> b2(TPosition::B2,0,kPad_ * width_);
LocalTensor<int32_t> c(TPosition::CO1,0,bm_ * width_);
const uint32_t mpad =(task.validM + 15)/ 16 * 16;
const uint32_t npad =(task.validN + 31)/ 32 * 32;
Nd2NzParams a;
a.ndNum = 1;a.nValue = task.validM;a.dValue = k_;
a.srcNdMatrixStride = 0;a.srcDValue = k_;
a.dstNzC0Stride = mpad;a.dstNzNStride = 1;a.dstNzMatrixStride = 0;
DataCopy(a1,xGm_[static_cast<uint64_t>(task.row)* k_],a);
if(mpad > task.validM){
Fill<uint32_t>(a1.ReinterpretCast<uint32_t>()[task.validM * 8],
{static_cast<uint16_t>(kPad_ / 32),static_cast<uint16_t>(mpad - task.validM),
static_cast<uint16_t>(task.validM),0u});
}
Nd2NzParams b;
b.ndNum = 1;b.nValue = k_;b.dValue = task.validN;
b.srcNdMatrixStride = 0;b.srcDValue = n_;
b.dstNzC0Stride = kPad_;b.dstNzNStride = 1;b.dstNzMatrixStride = 0;
DataCopy(b1,
wGm_[static_cast<uint64_t>(task.expert)* k_ * n_ + task.col],b);
if(kPad_ > k_){
Fill<uint32_t>(b1.ReinterpretCast<uint32_t>()[k_ * 8],
{static_cast<uint16_t>(npad / 32),static_cast<uint16_t>(kPad_ - k_),
static_cast<uint16_t>(k_),0u});
}
SetFlag<HardEvent::MTE2_MTE1>(0);
WaitFlag<HardEvent::MTE2_MTE1>(0);
LoadData2DParams ap;
ap.startIndex = 0;ap.repeatTimes = kPad_ / 32;ap.srcStride = mpad / 16;
ap.dstGap = 0;ap.ifTranspose = false;ap.sid = 0;ap.addrMode = 0;
for(uint32_t j = 0;j < mpad / 16;++j)
LoadData<int8_t>(a2[j * 16 * kPad_],a1[j * 512],ap);
LoadData2dTransposeParams bp;
bp.startIndex = 0;bp.repeatTimes = npad / 32;bp.srcStride = kPad_ / 32;
bp.dstGap = 1;bp.dstFracGap = 0;bp.addrMode = 0;
for(uint32_t i = 0;i < kPad_ / 32;++i)
LoadDataWithTranspose<int8_t>(b2[i * 32 * npad],b1[i * 1024],bp);
SetFlag<HardEvent::MTE1_M>(0);
WaitFlag<HardEvent::MTE1_M>(0);
MmadParams mm;
mm.m = mpad;mm.n = npad;mm.k = kPad_;
mm.unitFlag = 0;mm.cmatrixSource = false;mm.cmatrixInitVal = true;
mm.isBias = false;mm.kDirectionAlign = false;
mm.fmOffset = 0;mm.enSsparse = false;
mm.enWinogradA = false;mm.enWinogradB = false;
Mmad<int32_t,int8_t,int8_t>(c,a2,b2,mm);
SetFlag<HardEvent::M_FIX>(0);
WaitFlag<HardEvent::M_FIX>(0);
const uint32_t slot = 0;
FixpipeParamsV220 fp;
fp.nSize = npad;fp.mSize = task.validM;
fp.srcStride = mpad;fp.dstStride = width_;
fp.quantPre = QuantMode_t::NoQuant;fp.deqScalar = 0;
fp.ndNum = 1;fp.srcNdStride = 0;fp.dstNdStride = 0;
fp.reluEn = false;fp.unitFlag = 0;fp.isChannelSplit = false;
const uint64_t offset = 0;
Fixpipe<int32_t,int32_t,CFG_ROW_MAJOR>(ringGm_[offset],c,fp);
CrossCoreSetFlag<2,PIPE_FIX>(READY_BASE + slot);
}
__aicore__ inline void PostCompute(uint32_t){PipeBarrier<PIPE_ALL>();}
private:
GlobalTensor<int8_t> xGm_,wGm_;
GlobalTensor<int32_t> ringGm_;
uint32_t k_,n_,kPad_,bm_,width_;
};
class SingleProducerFast{
public:
