    return cfg;
}
constexpr auto kNStripe = AscendC::GetMatmulApiTiling<AType, BType, CType, BiasType,
    MatmulPairShape<64, 512, 8192>, MatmulPairShape<64, 512, 256>,
    MatmulPairShape<64, 256, 256>>(NStripeConfig());
static_assert(kNStripe.cfg.doMultiDataLoad && !kNStripe.cfg.doNorm &&
    kNStripe.cfg.scheduleType == ScheduleType::OUTER_PRODUCT &&
    kNStripe.cfg.iterateOrder == IterateOrder::ORDER_M && !kNStripe.cfg.enUnitFlag,
    "M118 isolated N-major pair strategy");
static_assert(kNStripe.baseM == 64 && kNStripe.baseN == 256 && kNStripe.baseK == 256 &&
    kNStripe.stepM == 1 && kNStripe.stepN == 2 && kNStripe.stepKa == 1 && kNStripe.stepKb == 1 &&
    kNStripe.depthA1 == 2 && kNStripe.depthB1 == 4, "M118 fixed L1/compute geometry");
static_assert(kNStripe.dbL0A == 2 && kNStripe.dbL0B == 1 && kNStripe.dbL0C == 1,
    "M118 same physical A2 bank across both N fragments");
static_assert(kNStripe.shareL1Size == 303104 && kNStripe.shareL1Size <= 524288 &&
    2 * 64 * 256 * sizeof(int32_t) == 131072, "M118 A1/B1 plus inherited quant, two CO1 fragments");
static_assert(!AscendC::IsBasicK(kNStripe) && !AscendC::IsBasicN(kNStripe),
    "M118 preserves complete runtime K and both N fragments");
using NStripeMM = matmul::MatmulImpl<AType, BType, CType, BiasType, kNStripe,
    AscendC::MatmulCallBackFunc<nullptr, nullptr, nullptr>, AscendC::Impl::Detail::GmmNStripeMdlPolicy>;

struct NStripeTask { uint32_t row, col, rows; };
static __aicore__ inline NStripeTask LocateNStripe(uint32_t e, uint32_t previousEnd,
    uint32_t rows, uint32_t task, uint32_t nPairs)
{
    const uint32_t rowTile = task / nPairs;
    const uint32_t pairCol = (task % nPairs + e + rowTile) % nPairs;
    const uint32_t row = rowTile * 64;
    return {previousEnd + row, pairCol * 512, (rows - row < 64 ? rows - row : 64)};
}
// M118_CONFIG_END


// GELU_SIMPLE_BEGIN
// Original cubic GELU: clipped FP32 short path, unclipped mixed-half bulk denominator.
// z/out/s0/s1 keep their independent original float allocations and interface.
// Short counts retain FP32; FP16 final output conversion remains at each caller.
static __aicore__ inline void ApplyGeluSimple(
    const LocalTensor<float>& out, const LocalTensor<float>& z,
    const LocalTensor<float>& s0, const LocalTensor<float>& s1,
    const LocalTensor<uint8_t>& signMask, uint32_t count)
{
 using namespace AscendC;
 Mul(s0,z,z,count);PipeBarrier<PIPE_V>();
 Muls(s0,s0,-1.5957691216057308f*0.044715f,count);PipeBarrier<PIPE_V>();
 Adds(s0,s0,-1.5957691216057308f,count);PipeBarrier<PIPE_V>();
 Mul(s0,s0,z,count);PipeBarrier<PIPE_V>();
 Maxs(s0,s0,-80.0f,count);PipeBarrier<PIPE_V>();
 Mins(s0,s0,80.0f,count);PipeBarrier<PIPE_V>();
 Exp(s0,s0,count);PipeBarrier<PIPE_V>();
 Adds(s0,s0,1.0f,count);PipeBarrier<PIPE_V>();
 Div(out,z,s0,count);PipeBarrier<PIPE_V>();
}
// GELU_SIMPLE_END

static __aicore__ inline uint32_t Min(uint32_t a, uint32_t b) { return a < b ? a : b; }
static __aicore__ inline uint32_t CeilDiv(uint32_t a, uint32_t b) { return (a + b - 1) / b; }

// SMALL_K_INLINE_BEGIN
// Complete AIV point products for the general K<=16 integer-exact domain.
// Every INT8 product and any partial sum are integral with |sum|<=262144,
// hence their FP32 Muls/Add sequence is exact. Scale is applied only AFTER
// an explicit FP32->INT32->FP32 round trip of the complete K dot product.
// No AIC, GM INT32 slot or cross-core ready/free flag participates here.
// M145_SMALLK_SHAPE_BEGIN
// Only shape/launch metadata, never actual group_list contents.
struct SmallKMeta {
    uint32_t m;
    uint32_t k;
    uint32_t n;
    uint32_t groups;
    uint32_t cores;
};
static_assert(sizeof(SmallKMeta) == 5 * sizeof(uint32_t), "SmallK shape fields only");
// M145_SMALLK_SHAPE_END
// M156_K_AXIS_BEGIN: fixed-capacity full-K vector dot, independent of old SmallK UB.
constexpr uint32_t kKAxisExplicitUB = 16384 + 32768 + 65536 + 1024 +
    4 * 4096 + 4096 + 64 + 4 * 128 * sizeof(float) + 256 + 256 + 32;
static_assert(kKAxisExplicitUB == 138848, "M156 explicit UB identity");
class KAxisDotKernel {
public:
    __aicore__ inline KAxisDotKernel(AscendC::TPipe& pipe, const SmallKMeta& t)
        : pipe_(pipe), t_(t) {}
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR w, GM_ADDR scale, GM_ADDR y)
    {
        x_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
        w_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(w));
        scale_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scale));
        y_.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y));
        const uint32_t halfRows = CeilDiv(t_.m, 2);
        firstRow_ = Min(AscendC::GetBlockIdx() * halfRows, t_.m);
        rows_ = Min(halfRows, t_.m - firstRow_);
        if (rows_ == 0) { return; }
        pipe_.InitBuffer(wQ_, 1, 16384);
        pipe_.InitBuffer(castH_, 32768);
        pipe_.InitBuffer(weightF_, 65536);
        pipe_.InitBuffer(xQ_, 1, 1024);
        pipe_.InitBuffer(xF_, 4096);
        pipe_.InitBuffer(gathered_, 4096);
        pipe_.InitBuffer(product_, 4096);
        pipe_.InitBuffer(offsets_, 4096);
        pipe_.InitBuffer(dotSlots_, 4096);
        pipe_.InitBuffer(reduceTmp_, 64);
        pipe_.InitBuffer(tmp_, 4 * 128 * sizeof(float));
        pipe_.InitBuffer(scaleQ_, 1, 256);
        pipe_.InitBuffer(outQ_, 1, 256);
        pipe_.InitBuffer(masks_, 32);
    }
    __aicore__ inline void Process()
    {
        using namespace AscendC;
        if (rows_ == 0) { return; }
        const uint32_t wElems = t_.k * t_.n;
        const uint32_t wCount = CeilDiv(wElems, 32) * 32;
        const uint32_t xCount = CeilDiv(t_.k, 32) * 32;
        const uint32_t kPad = CeilDiv(t_.k, 64) * 64;
        const uint32_t rowN = CeilDiv(t_.n, 16) * 16;
        const uint32_t used = rows_ * rowN;
        const uint32_t count = CeilDiv(used, 64) * 64;
        auto wh = castH_.Get<half>();
        auto wf = weightF_.Get<float>();
        auto xf = xF_.Get<float>();
        auto gathered = gathered_.Get<float>();
        auto product = product_.Get<float>();
        auto offI = offsets_.Get<int32_t>();
        auto offU = offI.ReinterpretCast<uint32_t>();
        auto slots = dotSlots_.Get<float>();
        auto reduceTmp = reduceTmp_.Get<float>();
        auto wi = wQ_.AllocTensor<int8_t>();
        DataCopyExtParams wp{1, wElems, 0, 0, 0};
        DataCopyPadExtParams<int8_t> wpad{true, 0,
            static_cast<uint8_t>(wCount - wElems), 0};
        DataCopyPad(wi, w_, wp, wpad);
        wQ_.EnQue(wi);
        wi = wQ_.DeQue<int8_t>();
        Cast(wh, wi, RoundMode::CAST_NONE, wCount);
        PipeBarrier<PIPE_V>();
        Cast(wf, wh, RoundMode::CAST_NONE, wCount);
        PipeBarrier<PIPE_V>();
        wQ_.FreeTensor(wi);
        // A3 CreateVecIndex requires int32; Gather interprets these nonnegative bits as uint32.
        CreateVecIndex<int32_t>(offI, 0, t_.k);
        PipeBarrier<PIPE_V>();
        Muls<int32_t>(offI, offI, static_cast<int32_t>(t_.n * sizeof(float)),
            static_cast<int32_t>(t_.k));
        PipeBarrier<PIPE_V>();
        Duplicate(product, 0.0f, kPad);
        Duplicate(slots, 0.0f, 1024);
        PipeBarrier<PIPE_V>();
        for (uint32_t r = 0; r < rows_; ++r) {
            auto xi = xQ_.AllocTensor<int8_t>();
            DataCopyExtParams xp{1, t_.k, 0, 0, 0};
            DataCopyPadExtParams<int8_t> xpad{true, 0,
                static_cast<uint8_t>(xCount - t_.k), 0};
            DataCopyPad(xi, x_[static_cast<uint64_t>(firstRow_ + r) * t_.k], xp, xpad);
            xQ_.EnQue(xi);
            xi = xQ_.DeQue<int8_t>();
            Cast(wh, xi, RoundMode::CAST_NONE, xCount);
            PipeBarrier<PIPE_V>();
            Cast(xf, wh, RoundMode::CAST_NONE, xCount);
            PipeBarrier<PIPE_V>();
            xQ_.FreeTensor(xi);
            for (uint32_t n = 0; n < t_.n; ++n) {
                // Keep the WFloat tensor base aligned; n*4 is a byte base offset.
                Gather(gathered, wf, offU, n * sizeof(float), t_.k);
                PipeBarrier<PIPE_V>();
                Mul(product, xf, gathered, t_.k);
                PipeBarrier<PIPE_V>();
                // Mul overwrites only real K; pre-zeroed K..KPad tail remains zero.
                // Each scalar result has its own 32-byte-aligned destination slot.
                ReduceSum<float>(slots[(r * rowN + n) * 8], product, reduceTmp,
                    static_cast<int32_t>(kPad));
                PipeBarrier<PIPE_V>();
            }
        }
        auto z = tmp_.GetWithOffset<float>(128, 0);
        auto out = tmp_.GetWithOffset<float>(128, 128 * sizeof(float));
        auto s0 = tmp_.GetWithOffset<float>(128, 2 * 128 * sizeof(float));
        auto s1 = tmp_.GetWithOffset<float>(128, 3 * 128 * sizeof(float));
        Duplicate(z, 0.0f, count);
        PipeBarrier<PIPE_V>();
        // The last ReduceSum includes V_S/S_V dependencies before reusing offsets.
        CreateVecIndex<int32_t>(offI, 0, used);
        PipeBarrier<PIPE_V>();
        Muls<int32_t>(offI, offI, 32, static_cast<int32_t>(used));
        PipeBarrier<PIPE_V>();
        Gather(z, slots, offU, 0, used);
        PipeBarrier<PIPE_V>();
        auto dots = s1.ReinterpretCast<int32_t>();
        Cast(dots, z, RoundMode::CAST_RINT, count);
        PipeBarrier<PIPE_V>();
        Cast(z, dots, RoundMode::CAST_NONE, count);
        PipeBarrier<PIPE_V>();
        const uint32_t dataN = CeilDiv(t_.n, 8) * 8;
        auto sc = scaleQ_.AllocTensor<float>();
        DataCopyExtParams sp{1, static_cast<uint32_t>(t_.n * sizeof(float)), 0, 0, 0};
        DataCopyPadExtParams<float> spad{true, 0, static_cast<uint8_t>(dataN - t_.n), 0};
        DataCopyPad(sc, scale_, sp, spad);
        scaleQ_.EnQue(sc);
        sc = scaleQ_.DeQue<float>();
        for (uint32_t r = 0; r < rows_; ++r) {
            Mul(z[r * rowN], z[r * rowN], sc, dataN);
        }
        PipeBarrier<PIPE_V>();
        scaleQ_.FreeTensor(sc);
        auto signMask = masks_.Get<uint8_t>();
        ApplyGeluSimple(out, z, s0, s1, signMask, count);
        auto yo = outQ_.AllocTensor<half>();
        Cast(yo, out, RoundMode::CAST_RINT, count);
        PipeBarrier<PIPE_V>();
        outQ_.EnQue(yo);
        yo = outQ_.DeQue<half>();
        DataCopyExtParams yp{static_cast<uint16_t>(rows_),
            static_cast<uint32_t>(t_.n * sizeof(half)), 0, 0, 0};
        DataCopyPad(y_[static_cast<uint64_t>(firstRow_) * t_.n], yo, yp);
        outQ_.FreeTensor(yo);
        const auto outputDone = pipe_.FetchEventID(HardEvent::MTE3_S);
        SetFlag<HardEvent::MTE3_S>(outputDone);
        WaitFlag<HardEvent::MTE3_S>(outputDone);
    }
private:
    AscendC::TPipe& pipe_;
    SmallKMeta t_;
    GlobalTensor<int8_t> x_, w_;
    GlobalTensor<float> scale_;
    GlobalTensor<half> y_;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> wQ_, xQ_, scaleQ_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQ_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> castH_, weightF_, xF_, gathered_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> product_, offsets_, dotSlots_, reduceTmp_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tmp_, masks_;
    uint32_t firstRow_ = 0, rows_ = 0;
};
// M156_K_AXIS_END

class SmallKKernel {
public:
    __aicore__ inline SmallKKernel(const Tiling& t)
    {
        t_.m = t.m;
        t_.k = t.k;
        t_.n = t.n;
        t_.groups = t.groups;
        t_.cores = t.cores;
    }

    __aicore__ inline SmallKKernel(const SmallKMeta& shape)
    {
        t_.m = shape.m;
        t_.k = shape.k;
        t_.n = shape.n;
        t_.groups = shape.groups;
        t_.cores = shape.cores;
    }

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR w, GM_ADDR scale,
        GM_ADDR groups, GM_ADDR y)
    {
        x_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
        w_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(w));
        scale_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scale));
        groups_.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups));
        y_.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y));
        // In mix(1,2), the raw AIV block index already enumerates both AIVs.
        worker_ = AscendC::GetBlockIdx();
        workers_ = t_.cores * AscendC::GetTaskRation();
        // No TPipe, TQue, or dynamic event allocation is used in this branch.
    }

    __aicore__ inline void Process()
    {
        if (t_.m == 1) {
            uint32_t lo = 0;
            uint32_t hi = t_.groups;
            while (lo < hi) {
                const uint32_t mid = lo + (hi - lo) / 2;
                if (groups_.GetValue(mid) > 0) {
                    hi = mid;
                } else {
                    lo = mid + 1;
                }
            }
            Compute(lo, 0, 0, 1, t_.n);
            return;
        }
        // M153_EXTENDED_E1_ROWS_BEGIN: one full half-row job per existing raw AIV.
        const uint32_t extendedRowN = CeilDiv(t_.n, 16) * 16;
        const uint64_t extendedWork = static_cast<uint64_t>(t_.m) * extendedRowN;
        if (t_.groups == 1 && t_.m >= 1 && t_.m <= 16 &&
            t_.k >= 1 && t_.k <= 3 && t_.n >= 1 && t_.n <= 256 &&
            extendedWork > 256 && extendedWork <= 4096) {
            const uint32_t halfRows = CeilDiv(t_.m, 2);
            const uint32_t firstRow = worker_ * halfRows;
            const uint32_t lastRow = Min(firstRow + halfRows, t_.m);
            if (firstRow < lastRow) {
                Compute(0, firstRow, 0, lastRow - firstRow, t_.n);
            }
            return;
        }
        // M153_EXTENDED_E1_ROWS_END
        const uint32_t rowN = CeilDiv(t_.n, 16) * 16;
        const uint32_t halfWorkRows = 128U / rowN;
        const uint32_t rowsPerJob = Min(16U, halfWorkRows > 0 ? halfWorkRows : 1U);
        uint32_t previousEnd = 0;
        uint32_t jobOrdinal = 0;
        for (uint32_t e = 0; e < t_.groups; ++e) {
            const uint32_t end = static_cast<uint32_t>(groups_.GetValue(e));
            const uint32_t rows = end - previousEnd;
            for (uint32_t offset = 0; offset < rows; offset += rowsPerJob) {
                if (jobOrdinal % 2U == worker_) {
                    Compute(e, previousEnd + offset, 0,
                        Min(rowsPerJob, rows - offset), t_.n);
                }
                ++jobOrdinal;
            }
            previousEnd = end;
        }
    }

    __aicore__ inline void Finish()
    {
        using namespace AscendC;
        // Consume the final release flags even after either Process early return.
        if (wReuse_) {
            WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
            wReuse_ = false;
        }
        if (xReuse_) {
            WaitFlag<HardEvent::V_MTE2>(EVENT_ID1);
            xReuse_ = false;
        }
        if (scaleReuse_) {
            WaitFlag<HardEvent::V_MTE2>(EVENT_ID2);
            scaleReuse_ = false;
        }
        if (outReuse_) {
            WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
            outReuse_ = false;
            // Explicit final GM-write completion before the scalar entry exits.
            SetFlag<HardEvent::MTE3_S>(EVENT_ID0);
            WaitFlag<HardEvent::MTE3_S>(EVENT_ID0);
        }
    }

private:
    __aicore__ inline void Compute(uint32_t e, uint32_t row, uint32_t col,
        uint32_t rows, uint32_t curN)
    {
        using namespace AscendC;
        const uint32_t weightN = CeilDiv(curN, 32) * 32;
        const uint32_t dataN = CeilDiv(curN, 8) * 8;
        const uint32_t rowN = CeilDiv(curN, 16) * 16;
        const uint32_t used = rows * rowN;
        const uint32_t count = CeilDiv(used, 64) * 64;
        // Byte offsets are 32B aligned, disjoint, and end at byte 105216.
        LocalTensor<int8_t> wi(TPosition::VECIN, 0, 4096);
        LocalTensor<int8_t> xi(TPosition::VECIN, 4096, 256);
        LocalTensor<float> sc(TPosition::VECIN, 4352, 256);
        LocalTensor<half> yo(TPosition::VECOUT, 5376, 4096);
        LocalTensor<float> wf(TPosition::VECCALC, 13568, 4096);
        LocalTensor<float> xf(TPosition::VECCALC, 29952, 256);
        LocalTensor<half> wh(TPosition::VECCALC, 30976, 4096);
        LocalTensor<float> z(TPosition::VECCALC, 39168, kBatchElems);
        LocalTensor<float> out(TPosition::VECCALC, 55552, kBatchElems);
        LocalTensor<float> s0(TPosition::VECCALC, 71936, kBatchElems);
        LocalTensor<float> s1(TPosition::VECCALC, 88320, kBatchElems);
        LocalTensor<uint8_t> signMask(TPosition::VECCALC, 104704, kMaskBytes);
        if (wReuse_) {
            WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
            wReuse_ = false;
        }
        // GM rows use the real N stride; each UB INT8 row pads to 32 bytes.
        DataCopyExtParams wp{static_cast<uint16_t>(t_.k), curN, t_.n - curN, 0, 0};
        DataCopyPadExtParams<int8_t> wpad{true, 0,
            static_cast<uint8_t>(weightN - curN), 0};
        DataCopyPad(wi, w_[static_cast<uint64_t>(e) * t_.k * t_.n + col], wp, wpad);
        SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
        WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
        // dav_c220 supports INT8->half and half->FP32, both exact for INT8.
        Cast(wh, wi, RoundMode::CAST_NONE, t_.k * weightN);
        PipeBarrier<PIPE_V>();
        Cast(wf, wh, RoundMode::CAST_NONE, t_.k * weightN);
        PipeBarrier<PIPE_V>();
        SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
        wReuse_ = true;

        if (xReuse_) {
            WaitFlag<HardEvent::V_MTE2>(EVENT_ID1);
            xReuse_ = false;
        }
        const uint32_t xElems = rows * t_.k;
        const uint32_t xCount = CeilDiv(xElems, 32) * 32;
        DataCopyExtParams xp{1, xElems, 0, 0, 0};
        DataCopyPadExtParams<int8_t> xpad{true, 0, static_cast<uint8_t>(xCount - xElems), 0};
        DataCopyPad(xi, x_[static_cast<uint64_t>(row) * t_.k], xp, xpad);
        SetFlag<HardEvent::MTE2_V>(EVENT_ID1);
        WaitFlag<HardEvent::MTE2_V>(EVENT_ID1);
        Cast(wh, xi, RoundMode::CAST_NONE, xCount);
        PipeBarrier<PIPE_V>();
        Cast(xf, wh, RoundMode::CAST_NONE, xCount);
        PipeBarrier<PIPE_V>();
        SetFlag<HardEvent::V_MTE2>(EVENT_ID1);
        xReuse_ = true;

        if (scaleReuse_) {
            WaitFlag<HardEvent::V_MTE2>(EVENT_ID2);
            scaleReuse_ = false;
        }
        DataCopyExtParams sp{1, static_cast<uint32_t>(curN * sizeof(float)), 0, 0, 0};
        DataCopyPadExtParams<float> spad{true, 0, static_cast<uint8_t>(dataN - curN), 0};
        DataCopyPad(sc, scale_[static_cast<uint64_t>(e) * t_.n + col], sp, spad);
        SetFlag<HardEvent::MTE2_V>(EVENT_ID2);
        WaitFlag<HardEvent::MTE2_V>(EVENT_ID2);
        Duplicate(z, 0.0f, count);
        Duplicate(s0, 0.0f, count);
        PipeBarrier<PIPE_V>();
        // xf is read by Scalar only after its Vector producer is complete.
        // V_S/S_V EVENT_ID0 remains independent of the DMA event classes.
        SetFlag<HardEvent::V_S>(EVENT_ID0);
        WaitFlag<HardEvent::V_S>(EVENT_ID0);
        for (uint32_t k = 0; k < t_.k; ++k) {
            for (uint32_t r = 0; r < rows; ++r) {
                const float xv = xf.GetValue(r * t_.k + k);
                Muls(s0[r * rowN], wf[k * weightN], xv, rowN);
            }
            PipeBarrier<PIPE_V>();
            Add(z, z, s0, count);
            PipeBarrier<PIPE_V>();
        }
        SetFlag<HardEvent::S_V>(EVENT_ID0);
        WaitFlag<HardEvent::S_V>(EVENT_ID0);
        auto dots = s1.ReinterpretCast<int32_t>();
        Cast(dots, z, RoundMode::CAST_RINT, count);
        PipeBarrier<PIPE_V>();
        Cast(z, dots, RoundMode::CAST_NONE, count);
        PipeBarrier<PIPE_V>();
        for (uint32_t r = 0; r < rows; ++r) {
            Mul(z[r * rowN], z[r * rowN], sc, dataN);
        }
        PipeBarrier<PIPE_V>();
        SetFlag<HardEvent::V_MTE2>(EVENT_ID2);
        scaleReuse_ = true;
        ApplyGeluSimple(out, z, s0, s1, signMask, count);
        if (outReuse_) {
            WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
            outReuse_ = false;
        }
        Cast(yo, out, RoundMode::CAST_RINT, count);
        PipeBarrier<PIPE_V>();
        SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
        WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
        // Every physical FP16 UB row occupies rowN*2 bytes (32-byte aligned).
        DataCopyExtParams yp{static_cast<uint16_t>(rows),
            static_cast<uint32_t>(curN * sizeof(half)), 0,
            static_cast<uint32_t>((t_.n - curN) * sizeof(half)), 0};
        DataCopyPad(y_[static_cast<uint64_t>(row) * t_.n + col], yo, yp);
        SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
        outReuse_ = true;
    }

    SmallKMeta t_;
    GlobalTensor<int8_t> x_, w_;
    GlobalTensor<float> scale_;
    GlobalTensor<int64_t> groups_;
    GlobalTensor<half> y_;
    bool wReuse_ = false, xReuse_ = false, scaleReuse_ = false, outReuse_ = false;
    uint32_t worker_ = 0;
    uint32_t workers_ = 0;
};
// M163_CAPACITY_SMALLK_BEGIN
// The same metadata-only predicate is expanded by Host and Device. Arguments
// are scalar metadata/already-computed uint64 bounds, with no side effects.
#define GMM_CAN_CAPACITY_OWNER(M,K,N,E,H,R,W) ((E)==1U && (K)>=1U && (K)<=16U && (N)>=1U && (N)<=512U && (H)*(R)<=4096ULL && (H)*static_cast<uint64_t>(K)<=256ULL && static_cast<uint64_t>(K)*(W)<=4096ULL)
#define GMM_CHOOSE_CAPACITY_OWNER(M,K,N,E,H,R,W) (GMM_CAN_CAPACITY_OWNER(M,K,N,E,H,R,W) && !(((M)<=16U && static_cast<uint64_t>(M)*(R)<=256ULL) || ((M)<=16U && (K)<=3U && (N)<=256U && static_cast<uint64_t>(M)*(R)>256ULL && static_cast<uint64_t>(M)*(R)<=4096ULL)))

constexpr uint32_t kCapacitySmallKExplicitUB = 4096 + 256 + 2048 + 8192 +
    16384 + 1024 + 8192 + 65536 + 512;
static_assert(kCapacitySmallKExplicitUB == 106240, "M163 private capacity UB");

// capacity grows; old raw SmallK and every global tiling constant stay intact.
class CapacitySmallKKernel {
public:
    __aicore__ inline CapacitySmallKKernel(AscendC::TPipe& pipe, const SmallKMeta& shape)
        : pipe_(pipe), t_(shape) {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR w, GM_ADDR scale, GM_ADDR y)
    {
        x_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
        w_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(w));
        scale_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scale));
        y_.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y));
        worker_ = AscendC::GetBlockIdx();
        pipe_.InitBuffer(wQ_, 1, 4096);
        pipe_.InitBuffer(xQ_, 1, 256);
        pipe_.InitBuffer(scaleQ_, 1, 512 * sizeof(float));
        pipe_.InitBuffer(outQ_, 1, kBatchElems * sizeof(half));
        pipe_.InitBuffer(weightF_, 4096 * sizeof(float));
        pipe_.InitBuffer(xF_, 256 * sizeof(float));
        pipe_.InitBuffer(castH_, 4096 * sizeof(half));
        pipe_.InitBuffer(tmp_, 4 * kBatchElems * sizeof(float));
        pipe_.InitBuffer(masks_, kMaskBytes);
    }

    __aicore__ inline void Process()
    {
        // Resource inequalities, not a 16-row assumption, bound each AIV.
        const uint32_t halfRows = CeilDiv(t_.m, 2);
        const uint32_t firstRow = worker_ * halfRows;
        const uint32_t lastRow = Min(firstRow + halfRows, t_.m);
        if (firstRow < lastRow) {
            Compute(0, firstRow, 0, lastRow - firstRow, t_.n);
        }
    }

private:
    __aicore__ inline void Compute(uint32_t e, uint32_t row, uint32_t col,
        uint32_t rows, uint32_t curN)
    {
        using namespace AscendC;
        const uint32_t weightN = CeilDiv(curN, 32) * 32;
        const uint32_t dataN = CeilDiv(curN, 8) * 8;
        const uint32_t rowN = CeilDiv(curN, 16) * 16;
        const uint32_t used = rows * rowN;
        const uint32_t count = CeilDiv(used, 64) * 64;
        auto wh = castH_.Get<half>();
        auto wf = weightF_.Get<float>();
        auto xf = xF_.Get<float>();
        auto wi = wQ_.AllocTensor<int8_t>();
        // GM rows use the real N stride; each UB INT8 row pads to 32 bytes.
        DataCopyExtParams wp{static_cast<uint16_t>(t_.k), curN, t_.n - curN, 0, 0};
        DataCopyPadExtParams<int8_t> wpad{true, 0,
            static_cast<uint8_t>(weightN - curN), 0};
        DataCopyPad(wi, w_[static_cast<uint64_t>(e) * t_.k * t_.n + col], wp, wpad);
        wQ_.EnQue(wi);
        wi = wQ_.DeQue<int8_t>();
        // dav_c220 supports INT8->half and half->FP32, both exact for INT8.
        Cast(wh, wi, RoundMode::CAST_NONE, t_.k * weightN);
        PipeBarrier<PIPE_V>();
        Cast(wf, wh, RoundMode::CAST_NONE, t_.k * weightN);
        PipeBarrier<PIPE_V>();
        wQ_.FreeTensor(wi);

        auto xi = xQ_.AllocTensor<int8_t>();
        const uint32_t xElems = rows * t_.k;
        const uint32_t xCount = CeilDiv(xElems, 32) * 32;
        DataCopyExtParams xp{1, xElems, 0, 0, 0};
        DataCopyPadExtParams<int8_t> xpad{true, 0, static_cast<uint8_t>(xCount - xElems), 0};
        DataCopyPad(xi, x_[static_cast<uint64_t>(row) * t_.k], xp, xpad);
        xQ_.EnQue(xi);
        xi = xQ_.DeQue<int8_t>();
        Cast(wh, xi, RoundMode::CAST_NONE, xCount);
        PipeBarrier<PIPE_V>();
        Cast(xf, wh, RoundMode::CAST_NONE, xCount);
        PipeBarrier<PIPE_V>();
        xQ_.FreeTensor(xi);

        auto sc = scaleQ_.AllocTensor<float>();
        DataCopyExtParams sp{1, static_cast<uint32_t>(curN * sizeof(float)), 0, 0, 0};
        DataCopyPadExtParams<float> spad{true, 0, static_cast<uint8_t>(dataN - curN), 0};
        DataCopyPad(sc, scale_[static_cast<uint64_t>(e) * t_.n + col], sp, spad);
        scaleQ_.EnQue(sc);
        sc = scaleQ_.DeQue<float>();
        auto z = tmp_.GetWithOffset<float>(kBatchElems, 0);
        auto out = tmp_.GetWithOffset<float>(kBatchElems, kBatchElems * sizeof(float));
        auto s0 = tmp_.GetWithOffset<float>(kBatchElems, 2 * kBatchElems * sizeof(float));
        auto s1 = tmp_.GetWithOffset<float>(kBatchElems, 3 * kBatchElems * sizeof(float));
        Duplicate(z, 0.0f, count);
        Duplicate(s0, 0.0f, count);
        PipeBarrier<PIPE_V>();
        // xf is read by Scalar only after its Vector producer is complete.
        // The queue event classes do not own V_S/S_V EVENT_ID0.
        SetFlag<HardEvent::V_S>(EVENT_ID0);
        WaitFlag<HardEvent::V_S>(EVENT_ID0);
        for (uint32_t k = 0; k < t_.k; ++k) {
            for (uint32_t r = 0; r < rows; ++r) {
                const float xv = xf.GetValue(r * t_.k + k);
                Muls(s0[r * rowN], wf[k * weightN], xv, rowN);
            }
            PipeBarrier<PIPE_V>();
            Add(z, z, s0, count);
            PipeBarrier<PIPE_V>();
        }
        SetFlag<HardEvent::S_V>(EVENT_ID0);
        WaitFlag<HardEvent::S_V>(EVENT_ID0);
        auto dots = s1.ReinterpretCast<int32_t>();
        Cast(dots, z, RoundMode::CAST_RINT, count);
        PipeBarrier<PIPE_V>();
        Cast(z, dots, RoundMode::CAST_NONE, count);
        PipeBarrier<PIPE_V>();
        for (uint32_t r = 0; r < rows; ++r) {
            Mul(z[r * rowN], z[r * rowN], sc, dataN);
        }
        PipeBarrier<PIPE_V>();
        scaleQ_.FreeTensor(sc);
        auto signMask = masks_.GetWithOffset<uint8_t>(kMaskBytes, 0);
        ApplyGeluSimple(out, z, s0, s1, signMask, count);
        auto yo = outQ_.AllocTensor<half>();
        Cast(yo, out, RoundMode::CAST_RINT, count);
        PipeBarrier<PIPE_V>();
        outQ_.EnQue(yo);
        yo = outQ_.DeQue<half>();
        // Every physical FP16 UB row occupies rowN*2 bytes (32-byte aligned).
        DataCopyExtParams yp{static_cast<uint16_t>(rows),
            static_cast<uint32_t>(curN * sizeof(half)), 0,
            static_cast<uint32_t>((t_.n - curN) * sizeof(half)), 0};
        DataCopyPad(y_[static_cast<uint64_t>(row) * t_.n + col], yo, yp);
        outQ_.FreeTensor(yo);
    }


    AscendC::TPipe& pipe_;
    SmallKMeta t_;
    GlobalTensor<int8_t> x_, w_;
    GlobalTensor<float> scale_;
    GlobalTensor<half> y_;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> wQ_, xQ_, scaleQ_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQ_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> weightF_, xF_, castH_, tmp_, masks_;
    uint32_t worker_ = 0;
};
// M163_CAPACITY_SMALLK_END

// M228_TINY_E1_BEGIN
// Capacity/work bounds only; the original K-axis route keeps its whole domain.
#define GMM_CAN_TINY_OWNER(M,K,N,E,H,R,W,B) ((E)==1U && (M)>=1U && (N)>=1U && (N)<=512U && (H)*static_cast<uint64_t>(K)<=256ULL && static_cast<uint64_t>(K)*(W)<=4096ULL && (B)<=4096ULL)
// Original traversal/short-work preference, separate from private capacities.
#define GMM_CHOOSE_TINY_OWNER(M,K,N,E,H,R,W,B) (GMM_CAN_TINY_OWNER(M,K,N,E,H,R,W,B) && (M)>=2U && (M)<=128U && (K)>=17U && (K)<=256U && static_cast<uint64_t>(M)*(K)*(N)<=32768ULL && !((M)<=16U && static_cast<uint64_t>(M)*(N)<=64ULL && static_cast<uint64_t>(K)*(N)<=16384ULL && static_cast<uint64_t>(M)*(N)*(K)<=32768ULL))
constexpr uint32_t kTinyE1ExplicitUBUpper = 4096 + 256 + 2048 + 8192 +
    16384 + 1024 + 8192 + 65536 + 512;
static_assert(kTinyE1ExplicitUBUpper == 106240, "M228 private tiny UB upper bound");
// E1 has the single legal group [0,M). Keep the capacity full-K computation,
// INT32 round trip, scale/GELU, row split and queue/event ownership intact.
class TinyE1Kernel {
public:
    __aicore__ inline TinyE1Kernel(AscendC::TPipe& pipe, const SmallKMeta& shape)
        : pipe_(pipe), t_(shape) {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR w, GM_ADDR scale, GM_ADDR y)
    {
        x_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
        w_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(w));
        scale_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scale));
        y_.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y));
        worker_ = AscendC::GetBlockIdx();
        // Private shape-sized slices, rounded to each instruction's physical width.
        const uint32_t halfRows = CeilDiv(t_.m, 2);
        const uint32_t weightElems = t_.k * CeilDiv(t_.n, 32) * 32;
        const uint32_t xCount = CeilDiv(halfRows * t_.k, 32) * 32;
        const uint32_t scaleCount = CeilDiv(t_.n, 8) * 8;
        batchElems_ = CeilDiv(halfRows * CeilDiv(t_.n, 16) * 16, 64) * 64;
        maskBytes_ = CeilDiv(batchElems_ / 8, 32) * 32;
        const uint32_t castElems = weightElems > xCount ? weightElems : xCount;
        pipe_.InitBuffer(wQ_, 1, weightElems);
        pipe_.InitBuffer(xQ_, 1, xCount);
        pipe_.InitBuffer(scaleQ_, 1, scaleCount * sizeof(float));
        pipe_.InitBuffer(outQ_, 1, batchElems_ * sizeof(half));
        pipe_.InitBuffer(weightF_, weightElems * sizeof(float));
        pipe_.InitBuffer(xF_, xCount * sizeof(float));
        pipe_.InitBuffer(castH_, castElems * sizeof(half));
        pipe_.InitBuffer(tmp_, 4 * batchElems_ * sizeof(float));
        pipe_.InitBuffer(masks_, maskBytes_);
    }

    __aicore__ inline void Process()
    {
        // Resource inequalities, not a 16-row assumption, bound each AIV.
        const uint32_t halfRows = CeilDiv(t_.m, 2);
        const uint32_t firstRow = worker_ * halfRows;
        const uint32_t lastRow = Min(firstRow + halfRows, t_.m);
        if (firstRow < lastRow) {
            Compute(0, firstRow, 0, lastRow - firstRow, t_.n);
        }
    }

private:
    __aicore__ inline void Compute(uint32_t e, uint32_t row, uint32_t col,
        uint32_t rows, uint32_t curN)
    {
        using namespace AscendC;
        const uint32_t weightN = CeilDiv(curN, 32) * 32;
        const uint32_t dataN = CeilDiv(curN, 8) * 8;
        const uint32_t rowN = CeilDiv(curN, 16) * 16;
        const uint32_t used = rows * rowN;
        const uint32_t count = CeilDiv(used, 64) * 64;
        auto wh = castH_.Get<half>();
        auto wf = weightF_.Get<float>();
        auto xf = xF_.Get<float>();
        auto wi = wQ_.AllocTensor<int8_t>();
        // GM rows use the real N stride; each UB INT8 row pads to 32 bytes.
        DataCopyExtParams wp{static_cast<uint16_t>(t_.k), curN, t_.n - curN, 0, 0};
        DataCopyPadExtParams<int8_t> wpad{true, 0,
            static_cast<uint8_t>(weightN - curN), 0};
        DataCopyPad(wi, w_[static_cast<uint64_t>(e) * t_.k * t_.n + col], wp, wpad);
        wQ_.EnQue(wi);
        wi = wQ_.DeQue<int8_t>();
        // dav_c220 supports INT8->half and half->FP32, both exact for INT8.
        Cast(wh, wi, RoundMode::CAST_NONE, t_.k * weightN);
        PipeBarrier<PIPE_V>();
        Cast(wf, wh, RoundMode::CAST_NONE, t_.k * weightN);
        PipeBarrier<PIPE_V>();
        wQ_.FreeTensor(wi);

        auto xi = xQ_.AllocTensor<int8_t>();
        const uint32_t xElems = rows * t_.k;
        const uint32_t xCount = CeilDiv(xElems, 32) * 32;
        DataCopyExtParams xp{1, xElems, 0, 0, 0};
        DataCopyPadExtParams<int8_t> xpad{true, 0, static_cast<uint8_t>(xCount - xElems), 0};
        DataCopyPad(xi, x_[static_cast<uint64_t>(row) * t_.k], xp, xpad);
        xQ_.EnQue(xi);
        xi = xQ_.DeQue<int8_t>();
        Cast(wh, xi, RoundMode::CAST_NONE, xCount);
        PipeBarrier<PIPE_V>();
        Cast(xf, wh, RoundMode::CAST_NONE, xCount);
        PipeBarrier<PIPE_V>();
        xQ_.FreeTensor(xi);

        auto sc = scaleQ_.AllocTensor<float>();
        DataCopyExtParams sp{1, static_cast<uint32_t>(curN * sizeof(float)), 0, 0, 0};
        DataCopyPadExtParams<float> spad{true, 0, static_cast<uint8_t>(dataN - curN), 0};
        DataCopyPad(sc, scale_[static_cast<uint64_t>(e) * t_.n + col], sp, spad);
        scaleQ_.EnQue(sc);
        sc = scaleQ_.DeQue<float>();
        auto z = tmp_.GetWithOffset<float>(batchElems_, 0);
        auto out = tmp_.GetWithOffset<float>(batchElems_, batchElems_ * sizeof(float));
        auto s0 = tmp_.GetWithOffset<float>(batchElems_, 2 * batchElems_ * sizeof(float));
        auto s1 = tmp_.GetWithOffset<float>(batchElems_, 3 * batchElems_ * sizeof(float));
        Duplicate(z, 0.0f, count);
        Duplicate(s0, 0.0f, count);
        PipeBarrier<PIPE_V>();
        // xf is read by Scalar only after its Vector producer is complete.
        // The queue event classes do not own V_S/S_V EVENT_ID0.
        SetFlag<HardEvent::V_S>(EVENT_ID0);
        WaitFlag<HardEvent::V_S>(EVENT_ID0);
        for (uint32_t k = 0; k < t_.k; ++k) {
            for (uint32_t r = 0; r < rows; ++r) {
                const float xv = xf.GetValue(r * t_.k + k);
                Muls(s0[r * rowN], wf[k * weightN], xv, rowN);
            }
            PipeBarrier<PIPE_V>();
            Add(z, z, s0, count);
            PipeBarrier<PIPE_V>();
        }
        SetFlag<HardEvent::S_V>(EVENT_ID0);
        WaitFlag<HardEvent::S_V>(EVENT_ID0);
        auto dots = s1.ReinterpretCast<int32_t>();
        Cast(dots, z, RoundMode::CAST_RINT, count);
        PipeBarrier<PIPE_V>();
        Cast(z, dots, RoundMode::CAST_NONE, count);
        PipeBarrier<PIPE_V>();
        for (uint32_t r = 0; r < rows; ++r) {
            Mul(z[r * rowN], z[r * rowN], sc, dataN);
        }
        PipeBarrier<PIPE_V>();
        scaleQ_.FreeTensor(sc);
        auto signMask = masks_.GetWithOffset<uint8_t>(maskBytes_, 0);
        ApplyGeluSimple(out, z, s0, s1, signMask, count);
        auto yo = outQ_.AllocTensor<half>();
        Cast(yo, out, RoundMode::CAST_RINT, count);
        PipeBarrier<PIPE_V>();
        outQ_.EnQue(yo);
        yo = outQ_.DeQue<half>();
        // Every physical FP16 UB row occupies rowN*2 bytes (32-byte aligned).
        DataCopyExtParams yp{static_cast<uint16_t>(rows),
            static_cast<uint32_t>(curN * sizeof(half)), 0,
            static_cast<uint32_t>((t_.n - curN) * sizeof(half)), 0};
        DataCopyPad(y_[static_cast<uint64_t>(row) * t_.n + col], yo, yp);
        outQ_.FreeTensor(yo);
    }


    AscendC::TPipe& pipe_;
    SmallKMeta t_;
    GlobalTensor<int8_t> x_, w_;
    GlobalTensor<float> scale_;
    GlobalTensor<half> y_;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> wQ_, xQ_, scaleQ_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQ_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> weightF_, xF_, castH_, tmp_, masks_;
    uint32_t worker_ = 0;
    uint32_t batchElems_ = 0, maskBytes_ = 0;
};
// M228_TINY_E1_END
// SMALL_K_INLINE_END

// L1_FUSED_LOWK_BEGIN
class FusedLowKKernel {
public:
    __aicore__ inline FusedLowKKernel(AscendC::TPipe& pipe, const Tiling& t)
        : pipe_(pipe), t_(t) {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR w, GM_ADDR scale,
        GM_ADDR groups, GM_ADDR y)
    {
        x_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
        w_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(w));
        scale_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scale));
        groups_.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups));
        y_.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y));
        // In mix(1,2), the raw AIV block index already enumerates both AIVs.
        worker_ = AscendC::GetBlockIdx();
        workers_ = t_.cores * 2U;
        // Two panel/scale entries: explicit UB 125184 bytes < 188416.
        // Weight input/FP16/two FP32 panels =
        // 4096+8192+32768; x input/FP32=256+1024; two scales=2048;
        // z/out/s0/s1=65536; FP16 output=8192; sign mask=512.
        pipe_.InitBuffer(wQ_, 1, 16 * kMaxN);
        pipe_.InitBuffer(xQ_, 1, 16 * 16);
        pipe_.InitBuffer(scaleQ_, 2, kMaxN * sizeof(float));
        pipe_.InitBuffer(outQ_, 1, kBatchElems * sizeof(half));
        pipe_.InitBuffer(weightF_, 2 * 16 * kMaxN * sizeof(float));
        pipe_.InitBuffer(xF_, 16 * 16 * sizeof(float));
        pipe_.InitBuffer(castH_, 16 * kMaxN * sizeof(half));
        pipe_.InitBuffer(tmp_, 4 * kBatchElems * sizeof(float));
        pipe_.InitBuffer(masks_, kMaskBytes);
        pipe_.InitBuffer(rowOffsets_, 64 * sizeof(uint32_t));
        pipe_.InitBuffer(rowGather_, 64 * sizeof(float));
        pipe_.InitBuffer(rowBroadcast_, 64 * 8 * sizeof(float));
        auto offsets = rowOffsets_.Get<uint32_t>();
        for (uint32_t r = 0; r < t_.tileM; ++r) {
            offsets.SetValue(r, r * t_.k * sizeof(float));
        }
        // Consume this initialization event before Compute reuses S_V ID0.
        AscendC::SetFlag<AscendC::HardEvent::S_V>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::S_V>(EVENT_ID0);
    }

    __aicore__ inline void Process()
    {
        const uint32_t tileRows = t_.tileM;
        uint32_t previousEnd = 0;
        uint32_t taskBase = 0;
        const uint32_t nTiles = CeilDiv(t_.n, kMaxN);
        for (uint32_t e = 0; e < t_.groups; ++e) {
            const uint32_t end = static_cast<uint32_t>(groups_.GetValue(e));
            const uint32_t rows = end - previousEnd;
            const uint32_t tasks = CeilDiv(rows, tileRows) * nTiles;
            uint32_t task = (worker_ + workers_ - taskBase) % workers_;
            for (; task < tasks; task += workers_) {
                const uint32_t row = (task / nTiles) * tileRows;
                const uint32_t col = (task % nTiles) * kMaxN;
                Compute(e, previousEnd + row, col, Min(tileRows, rows - row),
                    Min(kMaxN, t_.n - col));
            }
            taskBase = (taskBase + tasks) % workers_;
            previousEnd = end;
        }
        for(uint32_t slot=0;slot<2;++slot) {
            if(cacheValid_[slot]) {
                // Every cached scale's last Vector read ended at PIPE_V.
                scaleQ_.FreeTensor(cachedScale_[slot]);
                cacheValid_[slot]=false;
            }
        }
    }

private:
    __aicore__ inline void Compute(uint32_t e, uint32_t row, uint32_t col,
        uint32_t rows, uint32_t curN)
    {
        using namespace AscendC;
        const uint32_t weightN = CeilDiv(curN, 32) * 32;
        const uint32_t dataN = CeilDiv(curN, 8) * 8;
        const uint32_t rowN = CeilDiv(curN, 16) * 16;
        const uint32_t used = rows * rowN;
        const uint32_t count = CeilDiv(used, 64) * 64;
        auto wh = castH_.Get<half>();
        auto xf = xF_.Get<float>();
        uint32_t cacheSlot=2;
        for(uint32_t slot=0;slot<2;++slot) {
            if(cacheValid_[slot] && cachedExpert_[slot]==e &&
               cachedCol_[slot]==col && cachedCurN_[slot]==curN) {
                cacheSlot=slot;break;
            }
        }
        const bool reuse=cacheSlot<2;
        if(!reuse) {
            cacheSlot=nextVictim_;
            nextVictim_=(nextVictim_+1U)%2U;
        }
        auto wf=weightF_.GetWithOffset<float>(16*kMaxN,
            cacheSlot*16*kMaxN*sizeof(float));
        if (!reuse) {
            auto wi = wQ_.AllocTensor<int8_t>();
            // GM rows use the real N stride; each UB INT8 row pads to 32 bytes.
            DataCopyExtParams wp{static_cast<uint16_t>(t_.k), curN, t_.n - curN, 0, 0};
            DataCopyPadExtParams<int8_t> wpad{true, 0,
                static_cast<uint8_t>(weightN - curN), 0};
            DataCopyPad(wi, w_[static_cast<uint64_t>(e) * t_.k * t_.n + col], wp, wpad);
            wQ_.EnQue(wi);
            wi = wQ_.DeQue<int8_t>();
            // dav_c220 supports INT8->half and half->FP32, both exact for INT8.
            Cast(wh, wi, RoundMode::CAST_NONE, t_.k * weightN);
            PipeBarrier<PIPE_V>();
            Cast(wf, wh, RoundMode::CAST_NONE, t_.k * weightN);
            PipeBarrier<PIPE_V>();
            wQ_.FreeTensor(wi);
        }

        auto xi = xQ_.AllocTensor<int8_t>();
        const uint32_t xElems = rows * t_.k;
        const uint32_t xCount = CeilDiv(xElems, 32) * 32;
        DataCopyExtParams xp{1, xElems, 0, 0, 0};
        DataCopyPadExtParams<int8_t> xpad{true, 0, static_cast<uint8_t>(xCount - xElems), 0};
        DataCopyPad(xi, x_[static_cast<uint64_t>(row) * t_.k], xp, xpad);
        xQ_.EnQue(xi);
        xi = xQ_.DeQue<int8_t>();
        Cast(wh, xi, RoundMode::CAST_NONE, xCount);
        PipeBarrier<PIPE_V>();
        Cast(xf, wh, RoundMode::CAST_NONE, xCount);
        PipeBarrier<PIPE_V>();
        xQ_.FreeTensor(xi);

        if (!reuse) {
            if(cacheValid_[cacheSlot]) {
                // Only this FIFO victim is replaced; the other dequeued scale
                // and FP32 panel remain live. Prior readers finished at PIPE_V.
                scaleQ_.FreeTensor(cachedScale_[cacheSlot]);
            }
            auto sc = scaleQ_.AllocTensor<float>();
            DataCopyExtParams sp{1, static_cast<uint32_t>(curN * sizeof(float)), 0, 0, 0};
            DataCopyPadExtParams<float> spad{true, 0, static_cast<uint8_t>(dataN - curN), 0};
            DataCopyPad(sc, scale_[static_cast<uint64_t>(e) * t_.n + col], sp, spad);
            scaleQ_.EnQue(sc);
            cachedScale_[cacheSlot] = scaleQ_.DeQue<float>();
            cachedExpert_[cacheSlot] = e;
            cachedCol_[cacheSlot] = col;
            cachedCurN_[cacheSlot] = curN;
            cacheValid_[cacheSlot] = true;
        }
        auto sc = cachedScale_[cacheSlot];
        auto z = tmp_.GetWithOffset<float>(kBatchElems, 0);
        auto out = tmp_.GetWithOffset<float>(kBatchElems, kBatchElems * sizeof(float));
        auto s0 = tmp_.GetWithOffset<float>(kBatchElems, 2 * kBatchElems * sizeof(float));
        auto s1 = tmp_.GetWithOffset<float>(kBatchElems, 3 * kBatchElems * sizeof(float));
        Duplicate(z, 0.0f, count);
        Duplicate(s0, 0.0f, count);
        PipeBarrier<PIPE_V>();
        // xf is read by Scalar only after its Vector producer is complete.
        // The queue event classes do not own V_S/S_V EVENT_ID0.
        SetFlag<HardEvent::V_S>(EVENT_ID0);
        WaitFlag<HardEvent::V_S>(EVENT_ID0);
        auto offsets = rowOffsets_.Get<uint32_t>();
        auto gathered = rowGather_.Get<float>();
        auto broadcast = rowBroadcast_.Get<float>();
        // Brcb reads eight source scalars per repeat, including tail padding.
        Duplicate(gathered, 0.0f, t_.tileM);
        PipeBarrier<PIPE_V>();
        const uint8_t brcbRepeats = static_cast<uint8_t>((rows + 7) / 8);
        BrcbRepeatParams brcbRep{1, 8};
        BinaryRepeatParams productRep{1, 1, 0,
            static_cast<uint8_t>(rowN / 8), 0, 1};
        for (uint32_t k = 0; k < t_.k; ++k) {
            if (t_.k == 1) {
                // The existing xCount padding already covers ceil8(rows).
                Brcb(broadcast, xf, brcbRepeats, brcbRep);
            } else {
                Gather(gathered, xf, offsets, k * sizeof(float), rows);
                PipeBarrier<PIPE_V>();
                Brcb(broadcast, gathered, brcbRepeats, brcbRep);
            }
            PipeBarrier<PIPE_V>();
            for (uint32_t c = 0; c < dataN; c += 64) {
                const uint64_t mask = Min(64, dataN - c);
                Mul(s0[c], wf[k * weightN + c], broadcast, mask,
                    static_cast<uint8_t>(rows), productRep);
            }
            PipeBarrier<PIPE_V>();
            Add(z, z, s0, count);
            PipeBarrier<PIPE_V>();
        }
        SetFlag<HardEvent::S_V>(EVENT_ID0);
        WaitFlag<HardEvent::S_V>(EVENT_ID0);
        auto dots = s1.ReinterpretCast<int32_t>();
        Cast(dots, z, RoundMode::CAST_RINT, count);
        PipeBarrier<PIPE_V>();
        Cast(z, dots, RoundMode::CAST_NONE, count);
        PipeBarrier<PIPE_V>();
        BinaryRepeatParams scaleRep{1, 1, 1,
            static_cast<uint8_t>(rowN / 8), static_cast<uint8_t>(rowN / 8), 0};
        for (uint32_t c = 0; c < dataN; c += 64) {
            const uint64_t mask = Min(64, dataN - c);
            Mul(z[c], z[c], sc[c], mask, static_cast<uint8_t>(rows), scaleRep);
        }
        PipeBarrier<PIPE_V>();
        auto signMask = masks_.GetWithOffset<uint8_t>(kMaskBytes, 0);
        ApplyGeluSimple(out, z, s0, s1, signMask, count);
        auto yo = outQ_.AllocTensor<half>();
        Cast(yo, out, RoundMode::CAST_RINT, count);
        PipeBarrier<PIPE_V>();
        outQ_.EnQue(yo);
        yo = outQ_.DeQue<half>();
        // Every physical FP16 UB row occupies rowN*2 bytes (32-byte aligned).
        DataCopyExtParams yp{static_cast<uint16_t>(rows),
            static_cast<uint32_t>(curN * sizeof(half)), 0,
            static_cast<uint32_t>((t_.n - curN) * sizeof(half)), 0};
        DataCopyPad(y_[static_cast<uint64_t>(row) * t_.n + col], yo, yp);
        outQ_.FreeTensor(yo);
    }

    AscendC::TPipe& pipe_;
    const Tiling& t_;
    GlobalTensor<int8_t> x_, w_;
    GlobalTensor<float> scale_;
    GlobalTensor<int64_t> groups_;
    GlobalTensor<half> y_;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> wQ_, xQ_;
    AscendC::TQue<AscendC::TPosition::VECIN, 2> scaleQ_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQ_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> weightF_, xF_, castH_, tmp_, masks_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> rowOffsets_, rowGather_, rowBroadcast_;
    uint32_t worker_ = 0;
    uint32_t workers_ = 0;
    // Per-invocation cache only. weightF_ and the dequeued scaleQ_ tensor are
    // independent of castH_/xF_/tmp_/GELU scratch and output DMA buffers.
    LocalTensor<float> cachedScale_[2];
    uint32_t cachedExpert_[2]={0,0},cachedCol_[2]={0,0},cachedCurN_[2]={0,0};
    bool cacheValid_[2]={false,false};
    uint32_t nextVictim_=0;
};
// L1_FUSED_LOWK_END



template <class MMType>
class Kernel {
public:
    __aicore__ inline Kernel(MMType& mm, AscendC::TPipe& pipe, const Tiling& t)
        : mm_(mm), pipe_(pipe), t_(t) {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR weight, GM_ADDR scale,
        GM_ADDR groups, GM_ADDR y, GM_ADDR workspace)
    {
        x_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
        w_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(weight));
        scale_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scale));
        groups_.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups));
        y_.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y));
        c_.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(workspace));
        core_ = AscendC::GetBlockIdx();
        if ASCEND_IS_AIV {
            core_ /= AscendC::GetTaskRation();
            sub_ = AscendC::GetSubBlockIdx();
            // 16 rows, physically padded to 16 columns, allow both INT32
            // input and FP16 output rows to begin on 32-byte boundaries.
            pipe_.InitBuffer(inQ_, 1, kBatchElems * sizeof(int32_t));
            pipe_.InitBuffer(scaleQ_, 1, kMaxN * sizeof(float));
            pipe_.InitBuffer(outQ_, 1, kBatchElems * sizeof(half));
            pipe_.InitBuffer(tmp_, 4 * kBatchElems * sizeof(float));
            pipe_.InitBuffer(masks_, kMaskBytes);
            // Append independent metadata storage; original buffers keep offsets.
            pipe_.InitBuffer(groupCache_, 128 * sizeof(int64_t));
            groupBytes_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(groups));
        }
    }

    __aicore__ inline void Process()
    {
        LocalTensor<int64_t> localGroups;
        if ASCEND_IS_AIV {
            localGroups = groupCache_.Get<int64_t>();
            const uint32_t groupBytes = t_.groups * sizeof(int64_t);
            AscendC::DataCopyExtParams gp{1, groupBytes, 0, 0, 0};
            AscendC::DataCopyPadExtParams<int8_t> gpad{true, 0,
                static_cast<uint8_t>((32 - groupBytes % 32) % 32), 0};
            AscendC::DataCopyPad(localGroups.ReinterpretCast<int8_t>(), groupBytes_, gp, gpad);
            const auto groupReady = pipe_.FetchEventID(AscendC::HardEvent::MTE2_S);
            AscendC::SetFlag<AscendC::HardEvent::MTE2_S>(groupReady);
            AscendC::WaitFlag<AscendC::HardEvent::MTE2_S>(groupReady);
        }
        uint32_t previousEnd = 0;
        uint32_t taskBase = 0;
        const uint32_t nTiles = CeilDiv(t_.n, t_.tileN);
        for (uint32_t e = 0; e < t_.groups; ++e) {
            uint32_t end;
            if ASCEND_IS_AIV {
                end = static_cast<uint32_t>(localGroups.GetValue(e));
            } else {
                end = static_cast<uint32_t>(groups_.GetValue(e));
            }
            const uint32_t rows = end - previousEnd;
            const uint32_t tasks = CeilDiv(rows, t_.tileM) * nTiles;
            // taskBase is the global linear tile count modulo the core count.
            // Every AIC and both corresponding AIVs reconstruct the same list.
            uint32_t task = (core_ + t_.cores - taskBase) % t_.cores;
            for (; task < tasks; task += t_.cores) {
                const uint32_t row = (task / nTiles) * t_.tileM;
                // Other paths retain their producer/consumer column order.
                const uint32_t oldColTile = task % nTiles;
                const uint32_t colTile = t_.reserved == 1 || UseBFullKBundle(t_)
                    ? ColumnTileOrder(e, task / nTiles, oldColTile, nTiles) : oldColTile;
                const uint32_t col = colTile * t_.tileN;
                const uint32_t curM = Min(t_.tileM, rows - row);
                const uint32_t curN = Min(t_.tileN, t_.n - col);
                Compute(e, previousEnd + row, col, curM, curN);
            }
            taskBase = (taskBase + tasks) % t_.cores;
            previousEnd = end;
        }
        if ASCEND_IS_AIC {
            // Each used slot has one final, unconsumed release. Drain from
            // the oldest outstanding tile, including a zero-row AIV1.
            const uint32_t pending = Min(tileCount_, kSlots);
            for (uint32_t i = 0; i < pending; ++i) {
                const uint32_t slotIdx = (tileCount_ - pending + i) % kSlots;
                AscendC::CrossCoreWaitFlag(kFree + slotIdx);
            }
            mm_.End();
        }
    }

private:
    __aicore__ inline void Compute(uint32_t e, uint32_t row, uint32_t col,
        uint32_t curM, uint32_t curN)
    {
        // tileCount_ is local to this AIC/AIV group and continuous across
        // experts. Each slot owns separate GM storage and ready/free flags.
        const uint32_t slotIdx = tileCount_ % kSlots;
        const uint64_t slot = (static_cast<uint64_t>(core_) * kSlots + slotIdx)
            * t_.tileM * t_.tileN;
        if ASCEND_IS_AIC {
            // Select by the existing Matmul type; no Host/domain change.
            if constexpr (AscendC::Std::is_same<MMType, MM>::value) {
                // GM ownership is acquired once at the first actual write.
                // Independent input/Cube work may proceed while old GM is busy.
                bool slotAcquired = tileCount_ < kSlots;
                // ND input row strides remain the actual K and N, even for tails.
                // CANN 9.0.0's GM->L1 ND2NZ path takes element-valued srcDValue;
                // it zero pads the fragment to the Cube inner block dimensions.
                mm_.SetOrgShape(t_.m, t_.n, t_.k);
                mm_.SetSingleShape(curM, curN, t_.k);
                mm_.SetTensorA(x_[static_cast<uint64_t>(row) * t_.k]);
                mm_.SetTensorB(w_[static_cast<uint64_t>(e) * t_.k * t_.n + col]);
                while (mm_.Iterate()) {
                    // SingleShape <= baseM/baseN: exactly one output fragment.
                    // sequentialWrite=true gives compact curM x curN ND storage.
                    if (!slotAcquired) {
                        AscendC::CrossCoreWaitFlag(kFree + slotIdx);
                        slotAcquired = true;
                    }
                    mm_.GetTensorC(c_[slot], 0, true);
                }
                AscendC::CrossCoreSetFlag<2, PIPE_FIX>(kReady + slotIdx);
            } else {
                // First use of either slot needs no release. Later uses wait
                // only for both AIVs to finish the previous occupant of it.
                if (tileCount_ >= kSlots) {
                    AscendC::CrossCoreWaitFlag(kFree + slotIdx);
                }
                // ND input row strides remain the actual K and N, even for tails.
                // CANN 9.0.0's GM->L1 ND2NZ path takes element-valued srcDValue;
                // it zero pads the fragment to the Cube inner block dimensions.
                mm_.SetOrgShape(t_.m, t_.n, t_.k);
                mm_.SetSingleShape(curM, curN, t_.k);
                mm_.SetTensorA(x_[static_cast<uint64_t>(row) * t_.k]);
                mm_.SetTensorB(w_[static_cast<uint64_t>(e) * t_.k * t_.n + col]);
                while (mm_.Iterate()) {
                    // SingleShape <= baseM/baseN: exactly one output fragment.
                    // sequentialWrite=true gives compact curM x curN ND storage.
                    mm_.GetTensorC(c_[slot], 0, true);
                }
                AscendC::CrossCoreSetFlag<2, PIPE_FIX>(kReady + slotIdx);
            }
        }
        if ASCEND_IS_AIV {
            AscendC::CrossCoreWaitFlag(kReady + slotIdx);
            Epilogue(e, row, col, curM, curN, slot);
            // Mode 2 requires BOTH AIVs to release.  PIPE_MTE3 also drains
            // output stores; a zero-row participant still sends its release.
            AscendC::CrossCoreSetFlag<2, PIPE_MTE3>(kFree + slotIdx);
        }
        ++tileCount_;
    }

    __aicore__ inline void Epilogue(uint32_t e, uint32_t row, uint32_t col,
        uint32_t curM, uint32_t curN, uint64_t slot)
    {
        const uint32_t halfRows = CeilDiv(curM, 2);
        const uint32_t firstRow = sub_ * halfRows;
        const uint32_t lastRow = Min(firstRow + halfRows, curM);
        if (firstRow >= lastRow) { return; }
        const uint32_t dataN = CeilDiv(curN, 8) * 8;
        const uint32_t rowN = CeilDiv(curN, 16) * 16;
        LocalTensor<float> sc = scaleQ_.AllocTensor<float>();
        AscendC::DataCopyExtParams p{1, static_cast<uint32_t>(curN * sizeof(float)), 0, 0, 0};
        AscendC::DataCopyPadExtParams<float> pad{true, 0, static_cast<uint8_t>(dataN - curN), 0};
        AscendC::DataCopyPad(sc, scale_[static_cast<uint64_t>(e) * t_.n + col], p, pad);
        scaleQ_.EnQue(sc);
        sc = scaleQ_.DeQue<float>();
        LocalTensor<float> z = tmp_.GetWithOffset<float>(kBatchElems, 0);
        LocalTensor<float> out = tmp_.GetWithOffset<float>(kBatchElems, kBatchElems * sizeof(float));
        LocalTensor<float> s0 = tmp_.GetWithOffset<float>(kBatchElems, 2 * kBatchElems * sizeof(float));
        LocalTensor<float> s1 = tmp_.GetWithOffset<float>(kBatchElems, 3 * kBatchElems * sizeof(float));
        auto signMask = masks_.GetWithOffset<uint8_t>(kMaskBytes, 0);
        for (uint32_t r = firstRow; r < lastRow; r += kBatchRows) {
            const uint32_t rows = Min(kBatchRows, lastRow - r);
            const uint32_t used = rows * rowN;
            const uint32_t count = CeilDiv(used, 64) * 64;
            LocalTensor<int32_t> ci = inQ_.AllocTensor<int32_t>();
            // Official grouped_matmul DataCopyPad2D pattern: dstStride is
            // in 32-byte blocks; source stride is in bytes. Natural C0 pad
            // extends to dataN, then optional one-block gap reaches rowN.
            AscendC::DataCopyExtParams cp{static_cast<uint16_t>(rows),
                static_cast<uint32_t>(curN * sizeof(int32_t)), 0, (rowN - dataN) / 8, 0};
            AscendC::DataCopyPadExtParams<int32_t> cpad{true, 0,
                static_cast<uint8_t>(dataN - curN), 0};
            AscendC::DataCopyPad(ci, c_[slot + static_cast<uint64_t>(r) * curN], cp, cpad);
            inQ_.EnQue(ci);
            ci = inQ_.DeQue<int32_t>();
            // Explicit zeroes cover each physical row gap and the Compare
            // tail. Only actual/padded dataN columns are read from ci/sc.
            AscendC::Duplicate(z, 0.0f, count);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::UnaryRepeatParams castRep{1, 1,
                static_cast<uint8_t>(rowN / 8), static_cast<uint8_t>(rowN / 8)};
            AscendC::BinaryRepeatParams mulRep{1, 1, 1,
                static_cast<uint8_t>(rowN / 8), static_cast<uint8_t>(rowN / 8), 0};
            for (uint32_t c = 0; c < dataN; c += 64) {
                const uint64_t mask = Min(64, dataN - c);
                AscendC::Cast(z[c], ci[c], AscendC::RoundMode::CAST_NONE,
                    mask, static_cast<uint8_t>(rows), castRep);
            }
            AscendC::PipeBarrier<PIPE_V>();
            for (uint32_t c = 0; c < dataN; c += 64) {
                const uint64_t mask = Min(64, dataN - c);
                AscendC::Mul(z[c], z[c], sc[c], mask, static_cast<uint8_t>(rows), mulRep);
            }
            AscendC::PipeBarrier<PIPE_V>();
            inQ_.FreeTensor(ci);
            ApplyGeluSimple(out, z, s0, s1, signMask, count);
            LocalTensor<half> yo = outQ_.AllocTensor<half>();
            AscendC::Cast(yo, out, AscendC::RoundMode::CAST_RINT, count);
            AscendC::PipeBarrier<PIPE_V>();
            outQ_.EnQue(yo);
            yo = outQ_.DeQue<half>();
            AscendC::DataCopyExtParams yp{static_cast<uint16_t>(rows),
                static_cast<uint32_t>(curN * sizeof(half)), 0,
                static_cast<uint32_t>((t_.n - curN) * sizeof(half)), 0};
            AscendC::DataCopyPad(y_[static_cast<uint64_t>(row + r) * t_.n + col], yo, yp);
            outQ_.FreeTensor(yo);
        }
        scaleQ_.FreeTensor(sc);
    }

    MMType& mm_;
    AscendC::TPipe& pipe_;
    const Tiling& t_;
    GlobalTensor<int8_t> x_, w_;
    GlobalTensor<float> scale_;
    GlobalTensor<int64_t> groups_;
    GlobalTensor<int32_t> c_;
    GlobalTensor<half> y_;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQ_, scaleQ_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQ_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tmp_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> masks_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> groupCache_;
    GlobalTensor<int8_t> groupBytes_;
    uint32_t core_ = 0;
    uint32_t sub_ = 0;
    uint32_t tileCount_ = 0;
};

// M127_CONSUMER_BEGIN: original Init/FP32-scale-GELU Epilogue unchanged.
template<class MMType>
class FullAAivConsumer {
public:
    __aicore__ inline FullAAivConsumer(MMType& mm, AscendC::TPipe& pipe, const Tiling& t)
        : mm_(mm), pipe_(pipe), t_(t) {}
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR weight, GM_ADDR scale,
        GM_ADDR groups, GM_ADDR y, GM_ADDR workspace)
    {
        x_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
        w_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(weight));
        scale_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scale));
        groups_.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups));
        y_.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y));
        c_.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(workspace));
        core_ = AscendC::GetBlockIdx();
        if ASCEND_IS_AIV {
            core_ /= AscendC::GetTaskRation();
            sub_ = AscendC::GetSubBlockIdx();
            // 16 rows, physically padded to 16 columns, allow both INT32
            // input and FP16 output rows to begin on 32-byte boundaries.
            pipe_.InitBuffer(inQ_, 1, kBatchElems * sizeof(int32_t));
            pipe_.InitBuffer(scaleQ_, 1, kMaxN * sizeof(float));
            pipe_.InitBuffer(outQ_, 1, kBatchElems * sizeof(half));
            pipe_.InitBuffer(tmp_, 4 * kBatchElems * sizeof(float));
            pipe_.InitBuffer(masks_, kMaskBytes);
            // Append independent metadata storage; original buffers keep offsets.
            pipe_.InitBuffer(groupCache_, 128 * sizeof(int64_t));
            groupBytes_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(groups));
        }
    }

    __aicore__ inline void Process()
    {
        auto localGroups=groupCache_.Get<int64_t>();
        const uint32_t groupBytes=t_.groups*sizeof(int64_t);
        AscendC::DataCopyExtParams gp{1,groupBytes,0,0,0};
        AscendC::DataCopyPadExtParams<int8_t> pad{true,0,
            static_cast<uint8_t>((32-groupBytes%32)%32),0};
        AscendC::DataCopyPad(localGroups.ReinterpretCast<int8_t>(),groupBytes_,gp,pad);
        const auto groupReady=pipe_.FetchEventID(AscendC::HardEvent::MTE2_S);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_S>(groupReady);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_S>(groupReady);
        FullAJobIterator<LocalTensor<int64_t>> it(t_,localGroups,core_);
        FullAJob job;
        while (it.Next(job)) {
            for (uint32_t n=0;n<job.outputs;++n) {
                const uint32_t slotIdx=tileCount_%kSlots;
                const uint64_t slot=(static_cast<uint64_t>(core_)*kSlots+slotIdx)*128*256;
                AscendC::CrossCoreWaitFlag(kReady+slotIdx);
                Epilogue(job.expert,job.row,job.col+n*256,128,256,slot);
                AscendC::CrossCoreSetFlag<2,PIPE_MTE3>(kFree+slotIdx);
                ++tileCount_;
            }
        }
    }
private:
    __aicore__ inline void Epilogue(uint32_t e, uint32_t row, uint32_t col,
        uint32_t curM, uint32_t curN, uint64_t slot)
    {
        const uint32_t halfRows = CeilDiv(curM, 2);
        const uint32_t firstRow = sub_ * halfRows;
        const uint32_t lastRow = Min(firstRow + halfRows, curM);
        if (firstRow >= lastRow) { return; }
        const uint32_t dataN = CeilDiv(curN, 8) * 8;
        const uint32_t rowN = CeilDiv(curN, 16) * 16;
        LocalTensor<float> sc = scaleQ_.AllocTensor<float>();
        AscendC::DataCopyExtParams p{1, static_cast<uint32_t>(curN * sizeof(float)), 0, 0, 0};
        AscendC::DataCopyPadExtParams<float> pad{true, 0, static_cast<uint8_t>(dataN - curN), 0};
        AscendC::DataCopyPad(sc, scale_[static_cast<uint64_t>(e) * t_.n + col], p, pad);
        scaleQ_.EnQue(sc);
        sc = scaleQ_.DeQue<float>();
        LocalTensor<float> z = tmp_.GetWithOffset<float>(kBatchElems, 0);
        LocalTensor<float> out = tmp_.GetWithOffset<float>(kBatchElems, kBatchElems * sizeof(float));
        LocalTensor<float> s0 = tmp_.GetWithOffset<float>(kBatchElems, 2 * kBatchElems * sizeof(float));
        LocalTensor<float> s1 = tmp_.GetWithOffset<float>(kBatchElems, 3 * kBatchElems * sizeof(float));
        auto signMask = masks_.GetWithOffset<uint8_t>(kMaskBytes, 0);
        for (uint32_t r = firstRow; r < lastRow; r += kBatchRows) {
            const uint32_t rows = Min(kBatchRows, lastRow - r);
            const uint32_t used = rows * rowN;
            const uint32_t count = CeilDiv(used, 64) * 64;
            LocalTensor<int32_t> ci = inQ_.AllocTensor<int32_t>();
            // Official grouped_matmul DataCopyPad2D pattern: dstStride is
            // in 32-byte blocks; source stride is in bytes. Natural C0 pad
            // extends to dataN, then optional one-block gap reaches rowN.
            AscendC::DataCopyExtParams cp{static_cast<uint16_t>(rows),
                static_cast<uint32_t>(curN * sizeof(int32_t)), 0, (rowN - dataN) / 8, 0};
            AscendC::DataCopyPadExtParams<int32_t> cpad{true, 0,
                static_cast<uint8_t>(dataN - curN), 0};
            AscendC::DataCopyPad(ci, c_[slot + static_cast<uint64_t>(r) * curN], cp, cpad);
            inQ_.EnQue(ci);
            ci = inQ_.DeQue<int32_t>();
            // Explicit zeroes cover each physical row gap and the Compare
            // tail. Only actual/padded dataN columns are read from ci/sc.
            AscendC::Duplicate(z, 0.0f, count);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::UnaryRepeatParams castRep{1, 1,
                static_cast<uint8_t>(rowN / 8), static_cast<uint8_t>(rowN / 8)};
            AscendC::BinaryRepeatParams mulRep{1, 1, 1,
                static_cast<uint8_t>(rowN / 8), static_cast<uint8_t>(rowN / 8), 0};
            for (uint32_t c = 0; c < dataN; c += 64) {
                const uint64_t mask = Min(64, dataN - c);
                AscendC::Cast(z[c], ci[c], AscendC::RoundMode::CAST_NONE,
                    mask, static_cast<uint8_t>(rows), castRep);
            }
            AscendC::PipeBarrier<PIPE_V>();
            for (uint32_t c = 0; c < dataN; c += 64) {
                const uint64_t mask = Min(64, dataN - c);
                AscendC::Mul(z[c], z[c], sc[c], mask, static_cast<uint8_t>(rows), mulRep);
            }
            AscendC::PipeBarrier<PIPE_V>();
            inQ_.FreeTensor(ci);
            ApplyGeluSimple(out, z, s0, s1, signMask, count);
            LocalTensor<half> yo = outQ_.AllocTensor<half>();
            AscendC::Cast(yo, out, AscendC::RoundMode::CAST_RINT, count);
            AscendC::PipeBarrier<PIPE_V>();
            outQ_.EnQue(yo);
            yo = outQ_.DeQue<half>();
            AscendC::DataCopyExtParams yp{static_cast<uint16_t>(rows),
                static_cast<uint32_t>(curN * sizeof(half)), 0,
                static_cast<uint32_t>((t_.n - curN) * sizeof(half)), 0};
            AscendC::DataCopyPad(y_[static_cast<uint64_t>(row + r) * t_.n + col], yo, yp);
            outQ_.FreeTensor(yo);
        }
        scaleQ_.FreeTensor(sc);
    }

    MMType& mm_;
    AscendC::TPipe& pipe_;
    const Tiling& t_;
    GlobalTensor<int8_t> x_, w_;
    GlobalTensor<float> scale_;
    GlobalTensor<int64_t> groups_;
    GlobalTensor<int32_t> c_;
    GlobalTensor<half> y_;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQ_, scaleQ_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQ_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tmp_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> masks_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> groupCache_;
    GlobalTensor<int8_t> groupBytes_;
    uint32_t core_ = 0;
    uint32_t sub_ = 0;
    uint32_t tileCount_ = 0;
};
// M127_CONSUMER_END

// M255_THREEN_CONSUMER_BEGIN: original Init/FP32-scale-GELU Epilogue unchanged.
template<class MMType>
class FullAThreeBundleAivConsumer {
public:
    __aicore__ inline FullAThreeBundleAivConsumer(MMType& mm, AscendC::TPipe& pipe, const Tiling& t)
        : mm_(mm), pipe_(pipe), t_(t) {}
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR weight, GM_ADDR scale,
        GM_ADDR groups, GM_ADDR y, GM_ADDR workspace)
    {
        x_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
        w_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(weight));
        scale_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scale));
        groups_.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups));
        y_.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y));
        c_.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(workspace));
        core_ = AscendC::GetBlockIdx();
        if ASCEND_IS_AIV {
            core_ /= AscendC::GetTaskRation();
            sub_ = AscendC::GetSubBlockIdx();
            // 16 rows, physically padded to 16 columns, allow both INT32
            // input and FP16 output rows to begin on 32-byte boundaries.
            pipe_.InitBuffer(inQ_, 1, kBatchElems * sizeof(int32_t));
            pipe_.InitBuffer(scaleQ_, 1, kMaxN * sizeof(float));
            pipe_.InitBuffer(outQ_, 1, kBatchElems * sizeof(half));
            pipe_.InitBuffer(tmp_, 4 * kBatchElems * sizeof(float));
            pipe_.InitBuffer(masks_, kMaskBytes);
            // Append independent metadata storage; original buffers keep offsets.
            pipe_.InitBuffer(groupCache_, 128 * sizeof(int64_t));
            groupBytes_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(groups));
        }
    }

    __aicore__ inline void Process()
    {
        auto localGroups=groupCache_.Get<int64_t>();
        const uint32_t groupBytes=t_.groups*sizeof(int64_t);
        AscendC::DataCopyExtParams gp{1,groupBytes,0,0,0};
        AscendC::DataCopyPadExtParams<int8_t> pad{true,0,
            static_cast<uint8_t>((32-groupBytes%32)%32),0};
        AscendC::DataCopyPad(localGroups.ReinterpretCast<int8_t>(),groupBytes_,gp,pad);
        const auto groupReady=pipe_.FetchEventID(AscendC::HardEvent::MTE2_S);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_S>(groupReady);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_S>(groupReady);
        FullAThreeBundleJobIterator<LocalTensor<int64_t>> it(t_,localGroups,core_);
        FullAThreeBundleJob job;
        while (it.Next(job)) {
            for (uint32_t n=0;n<job.outputs;++n) {
                const uint32_t slotIdx=tileCount_%kSlots;
                const uint64_t slot=(static_cast<uint64_t>(core_)*kSlots+slotIdx)*128*256;
                AscendC::CrossCoreWaitFlag(kReady+slotIdx);
                Epilogue(job.expert,job.row,job.col+n*256,128,256,slot);
                AscendC::CrossCoreSetFlag<2,PIPE_MTE3>(kFree+slotIdx);
                ++tileCount_;
            }
        }
    }
private:
    __aicore__ inline void Epilogue(uint32_t e, uint32_t row, uint32_t col,
        uint32_t curM, uint32_t curN, uint64_t slot)
    {
        const uint32_t halfRows = CeilDiv(curM, 2);
        const uint32_t firstRow = sub_ * halfRows;
        const uint32_t lastRow = Min(firstRow + halfRows, curM);
        if (firstRow >= lastRow) { return; }
        const uint32_t dataN = CeilDiv(curN, 8) * 8;
        const uint32_t rowN = CeilDiv(curN, 16) * 16;
        LocalTensor<float> sc = scaleQ_.AllocTensor<float>();
        AscendC::DataCopyExtParams p{1, static_cast<uint32_t>(curN * sizeof(float)), 0, 0, 0};
        AscendC::DataCopyPadExtParams<float> pad{true, 0, static_cast<uint8_t>(dataN - curN), 0};
        AscendC::DataCopyPad(sc, scale_[static_cast<uint64_t>(e) * t_.n + col], p, pad);
        scaleQ_.EnQue(sc);
        sc = scaleQ_.DeQue<float>();
        LocalTensor<float> z = tmp_.GetWithOffset<float>(kBatchElems, 0);
        LocalTensor<float> out = tmp_.GetWithOffset<float>(kBatchElems, kBatchElems * sizeof(float));
        LocalTensor<float> s0 = tmp_.GetWithOffset<float>(kBatchElems, 2 * kBatchElems * sizeof(float));
        LocalTensor<float> s1 = tmp_.GetWithOffset<float>(kBatchElems, 3 * kBatchElems * sizeof(float));
        auto signMask = masks_.GetWithOffset<uint8_t>(kMaskBytes, 0);
        for (uint32_t r = firstRow; r < lastRow; r += kBatchRows) {
            const uint32_t rows = Min(kBatchRows, lastRow - r);
            const uint32_t used = rows * rowN;
            const uint32_t count = CeilDiv(used, 64) * 64;
            LocalTensor<int32_t> ci = inQ_.AllocTensor<int32_t>();
            // Official grouped_matmul DataCopyPad2D pattern: dstStride is
            // in 32-byte blocks; source stride is in bytes. Natural C0 pad
            // extends to dataN, then optional one-block gap reaches rowN.
            AscendC::DataCopyExtParams cp{static_cast<uint16_t>(rows),
                static_cast<uint32_t>(curN * sizeof(int32_t)), 0, (rowN - dataN) / 8, 0};
            AscendC::DataCopyPadExtParams<int32_t> cpad{true, 0,
                static_cast<uint8_t>(dataN - curN), 0};
            AscendC::DataCopyPad(ci, c_[slot + static_cast<uint64_t>(r) * curN], cp, cpad);
            inQ_.EnQue(ci);
            ci = inQ_.DeQue<int32_t>();
            // Explicit zeroes cover each physical row gap and the Compare
            // tail. Only actual/padded dataN columns are read from ci/sc.
            AscendC::Duplicate(z, 0.0f, count);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::UnaryRepeatParams castRep{1, 1,
                static_cast<uint8_t>(rowN / 8), static_cast<uint8_t>(rowN / 8)};
            AscendC::BinaryRepeatParams mulRep{1, 1, 1,
                static_cast<uint8_t>(rowN / 8), static_cast<uint8_t>(rowN / 8), 0};
            for (uint32_t c = 0; c < dataN; c += 64) {
                const uint64_t mask = Min(64, dataN - c);
                AscendC::Cast(z[c], ci[c], AscendC::RoundMode::CAST_NONE,
                    mask, static_cast<uint8_t>(rows), castRep);
            }
            AscendC::PipeBarrier<PIPE_V>();
            for (uint32_t c = 0; c < dataN; c += 64) {
                const uint64_t mask = Min(64, dataN - c);
                AscendC::Mul(z[c], z[c], sc[c], mask, static_cast<uint8_t>(rows), mulRep);
            }
            AscendC::PipeBarrier<PIPE_V>();
            inQ_.FreeTensor(ci);
            ApplyGeluSimple(out, z, s0, s1, signMask, count);
            LocalTensor<half> yo = outQ_.AllocTensor<half>();
            AscendC::Cast(yo, out, AscendC::RoundMode::CAST_RINT, count);
            AscendC::PipeBarrier<PIPE_V>();
            outQ_.EnQue(yo);
            yo = outQ_.DeQue<half>();
            AscendC::DataCopyExtParams yp{static_cast<uint16_t>(rows),
                static_cast<uint32_t>(curN * sizeof(half)), 0,
                static_cast<uint32_t>((t_.n - curN) * sizeof(half)), 0};
            AscendC::DataCopyPad(y_[static_cast<uint64_t>(row + r) * t_.n + col], yo, yp);
            outQ_.FreeTensor(yo);
        }
        scaleQ_.FreeTensor(sc);
    }

    MMType& mm_;
    AscendC::TPipe& pipe_;
    const Tiling& t_;
    GlobalTensor<int8_t> x_, w_;
    GlobalTensor<float> scale_;
    GlobalTensor<int64_t> groups_;
    GlobalTensor<int32_t> c_;
    GlobalTensor<half> y_;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQ_, scaleQ_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQ_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tmp_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> masks_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> groupCache_;
    GlobalTensor<int8_t> groupBytes_;
    uint32_t core_ = 0;
    uint32_t sub_ = 0;
    uint32_t tileCount_ = 0;
};
// M255_THREEN_CONSUMER_END

// M119_RESIDENT_BEGIN
// GM ownership ends after the entire AIV C share is in independent UB.
// The private C/scale and Y lifetimes remain independent of the GM free token.
constexpr uint32_t kResidentCElems = 8192;
static __aicore__ inline bool CanUseResidentConsumer(const Tiling& t)
{
    if (t.tileM == 0 || t.tileN == 0 || t.tileN > kMaxN) { return false; }
    const uint64_t share = static_cast<uint64_t>(CeilDiv(t.tileM, 2))
        * (CeilDiv(t.tileN, 16) * 16);
    const uint64_t tasksLower = static_cast<uint64_t>(CeilDiv(t.m, t.tileM))
        * CeilDiv(t.n, t.tileN);
    return share <= kResidentCElems && tasksLower >= 2ULL * t.cores;
}

struct ResidentTile {
    uint32_t e, row, col, curM, curN, ordinal;
};

class ResidentAivConsumer {
public:
    __aicore__ inline ResidentAivConsumer(AscendC::TPipe& pipe, const Tiling& t)
        : pipe_(pipe), t_(t) {}

    __aicore__ inline void Init(GM_ADDR scale, GM_ADDR groups, GM_ADDR y, GM_ADDR workspace)
    {
        scale_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scale));
        groups_.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups));
        groupBytes_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(groups));
        y_.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y));
        c_.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(workspace));
        core_ = AscendC::GetBlockIdx() / AscendC::GetTaskRation();
        sub_ = AscendC::GetSubBlockIdx();
        // 151040 bytes: C65536 + scale2048 + half16384 + float65536
        // + mask512 + private group endpoints1024. Only this consumer is Init'd.
        pipe_.InitBuffer(inQ_, 2, kResidentCElems * sizeof(int32_t));
        pipe_.InitBuffer(scaleQ_, 2, kMaxN * sizeof(float));
        pipe_.InitBuffer(outQ_, 2, kBatchElems * sizeof(half));
        pipe_.InitBuffer(tmp_, 4 * kBatchElems * sizeof(float));
        pipe_.InitBuffer(masks_, kMaskBytes);
        pipe_.InitBuffer(groupCache_, 128 * sizeof(int64_t));
    }

    __aicore__ inline void Process()
    {
        LocalTensor<int64_t> localGroups = groupCache_.Get<int64_t>();
        const uint32_t groupBytes = t_.groups * sizeof(int64_t);
        AscendC::DataCopyExtParams gp{1, groupBytes, 0, 0, 0};
        AscendC::DataCopyPadExtParams<int8_t> gpad{true, 0,
            static_cast<uint8_t>((32 - groupBytes % 32) % 32), 0};
        AscendC::DataCopyPad(localGroups.ReinterpretCast<int8_t>(), groupBytes_, gp, gpad);
        const auto groupReady = pipe_.FetchEventID(AscendC::HardEvent::MTE2_S);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_S>(groupReady);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_S>(groupReady);

        uint32_t previousEnd = 0;
        uint32_t taskBase = 0;
        const uint32_t nTiles = CeilDiv(t_.n, t_.tileN);
        ResidentTile pending{};
        bool havePending = false;
        uint32_t tileCount = 0;
        for (uint32_t e = 0; e < t_.groups; ++e) {
            const uint32_t end = static_cast<uint32_t>(localGroups.GetValue(e));
            const uint32_t rows = end - previousEnd;
            const uint32_t tasks = CeilDiv(rows, t_.tileM) * nTiles;
            uint32_t task = (core_ + t_.cores - taskBase) % t_.cores;
            for (; task < tasks; task += t_.cores) {
                // Same descriptor sequence as the original producer/consumer,
                // including the Norm column permutation and cross-group ordinal.
                const uint32_t row = (task / nTiles) * t_.tileM;
                const uint32_t oldColTile = task % nTiles;
                const uint32_t colTile = t_.reserved == 1 && nTiles > 1
                    ? (oldColTile + e + task / nTiles) % nTiles : oldColTile;
                const uint32_t col = colTile * t_.tileN;
                ResidentTile next{e, previousEnd + row, col,
                    Min(t_.tileM, rows - row), Min(t_.tileN, t_.n - col), tileCount};
                // Submit current Vector/Y work before a possible scalar wait
                // for the next ready. Two physical private stages permit its
                // MTE2 work to overlap commands already submitted for current.
                if (havePending) { Consume(pending); }
                Stage(next);
                pending = next;
                havePending = true;
                ++tileCount;
            }
            taskBase = (taskBase + tasks) % t_.cores;
            previousEnd = end;
        }
        if (havePending) { Consume(pending); }
        // AIC's old final free drain now proves only GM reader completion.
        // This separate local edge waits for ALL actual Y stores before exit.
        const auto outputDone = pipe_.FetchEventID(AscendC::HardEvent::MTE3_S);
        AscendC::SetFlag<AscendC::HardEvent::MTE3_S>(outputDone);
        AscendC::WaitFlag<AscendC::HardEvent::MTE3_S>(outputDone);
    }

private:
    __aicore__ inline void Stage(const ResidentTile& d)
    {
        const uint32_t slotIdx = d.ordinal % kSlots;
        const uint32_t halfRows = CeilDiv(d.curM, 2);
        const uint32_t firstRow = sub_ * halfRows;
        const uint32_t lastRow = Min(firstRow + halfRows, d.curM);
        AscendC::CrossCoreWaitFlag(kReady + slotIdx);
        if (firstRow < lastRow) {
            const uint32_t dataN = CeilDiv(d.curN, 8) * 8;
            const uint32_t rowN = CeilDiv(d.curN, 16) * 16;
            const uint64_t slot = (static_cast<uint64_t>(core_) * kSlots + slotIdx)
                * t_.tileM * t_.tileN;
            LocalTensor<int32_t> ci = inQ_.AllocTensor<int32_t>();
            AscendC::DataCopyExtParams cp{static_cast<uint16_t>(lastRow - firstRow),
                static_cast<uint32_t>(d.curN * sizeof(int32_t)), 0, (rowN - dataN) / 8, 0};
            AscendC::DataCopyPadExtParams<int32_t> cpad{true, 0,
                static_cast<uint8_t>(dataN - d.curN), 0};
            AscendC::DataCopyPad(ci, c_[slot + static_cast<uint64_t>(firstRow) * d.curN], cp, cpad);
            // No later operation reads this GM slot: all owned rows have been
            // copied by the MTE2 stream before its mode2 release can execute.
            AscendC::CrossCoreSetFlag<2, PIPE_MTE2>(kFree + slotIdx);
            inQ_.EnQue(ci);

            LocalTensor<float> sc = scaleQ_.AllocTensor<float>();
            AscendC::DataCopyExtParams p{1, static_cast<uint32_t>(d.curN * sizeof(float)), 0, 0, 0};
            AscendC::DataCopyPadExtParams<float> pad{true, 0,
                static_cast<uint8_t>(dataN - d.curN), 0};
            AscendC::DataCopyPad(sc, scale_[static_cast<uint64_t>(d.e) * t_.n + d.col], p, pad);
            scaleQ_.EnQue(sc);
        } else {
            // The zero-row AIV still consumes ready and releases exactly once.
            AscendC::CrossCoreSetFlag<2, PIPE_MTE2>(kFree + slotIdx);
        }
    }

    __aicore__ inline void Consume(const ResidentTile& d)
    {
        const uint32_t halfRows = CeilDiv(d.curM, 2);
        const uint32_t firstRow = sub_ * halfRows;
        const uint32_t lastRow = Min(firstRow + halfRows, d.curM);
        if (firstRow >= lastRow) { return; }
        const uint32_t dataN = CeilDiv(d.curN, 8) * 8;
        const uint32_t rowN = CeilDiv(d.curN, 16) * 16;
        LocalTensor<int32_t> ci = inQ_.DeQue<int32_t>();
        LocalTensor<float> sc = scaleQ_.DeQue<float>();
        LocalTensor<float> z = tmp_.GetWithOffset<float>(kBatchElems, 0);
        LocalTensor<float> out = tmp_.GetWithOffset<float>(kBatchElems, kBatchElems * sizeof(float));
        LocalTensor<float> s0 = tmp_.GetWithOffset<float>(kBatchElems, 2 * kBatchElems * sizeof(float));
        LocalTensor<float> s1 = tmp_.GetWithOffset<float>(kBatchElems, 3 * kBatchElems * sizeof(float));
        auto signMask = masks_.GetWithOffset<uint8_t>(kMaskBytes, 0);
        for (uint32_t r = firstRow; r < lastRow; r += kBatchRows) {
            const uint32_t rows = Min(kBatchRows, lastRow - r);
            const uint32_t used = rows * rowN;
            const uint32_t count = CeilDiv(used, 64) * 64;
            const uint32_t cOffset = (r - firstRow) * rowN;
            AscendC::Duplicate(z, 0.0f, count);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::UnaryRepeatParams castRep{1, 1,
                static_cast<uint8_t>(rowN / 8), static_cast<uint8_t>(rowN / 8)};
            AscendC::BinaryRepeatParams mulRep{1, 1, 1,
                static_cast<uint8_t>(rowN / 8), static_cast<uint8_t>(rowN / 8), 0};
            for (uint32_t c = 0; c < dataN; c += 64) {
                const uint64_t mask = Min(64, dataN - c);
                AscendC::Cast(z[c], ci[cOffset + c], AscendC::RoundMode::CAST_NONE,
                    mask, static_cast<uint8_t>(rows), castRep);
            }
            AscendC::PipeBarrier<PIPE_V>();
            // V_MTE2 reverse lifetime only after the final private C read.
            if (r + rows == lastRow) { inQ_.FreeTensor(ci); }
            for (uint32_t c = 0; c < dataN; c += 64) {
                const uint64_t mask = Min(64, dataN - c);
                AscendC::Mul(z[c], z[c], sc[c], mask, static_cast<uint8_t>(rows), mulRep);
            }
            AscendC::PipeBarrier<PIPE_V>();
            if (r + rows == lastRow) { scaleQ_.FreeTensor(sc); }
            ApplyGeluSimple(out, z, s0, s1, signMask, count);
            LocalTensor<half> yo = outQ_.AllocTensor<half>();
            AscendC::Cast(yo, out, AscendC::RoundMode::CAST_RINT, count);
            AscendC::PipeBarrier<PIPE_V>();
            outQ_.EnQue(yo);
            yo = outQ_.DeQue<half>();
            AscendC::DataCopyExtParams yp{static_cast<uint16_t>(rows),
                static_cast<uint32_t>(d.curN * sizeof(half)), 0,
                static_cast<uint32_t>((t_.n - d.curN) * sizeof(half)), 0};
            AscendC::DataCopyPad(y_[static_cast<uint64_t>(d.row + r) * t_.n + d.col], yo, yp);
            outQ_.FreeTensor(yo);
        }
    }

    AscendC::TPipe& pipe_;
    const Tiling& t_;
    GlobalTensor<float> scale_;
    GlobalTensor<int64_t> groups_;
    GlobalTensor<int8_t> groupBytes_;
    GlobalTensor<int32_t> c_;
    GlobalTensor<half> y_;
    AscendC::TQue<AscendC::TPosition::VECIN, 2> inQ_, scaleQ_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 2> outQ_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tmp_, masks_, groupCache_;
    uint32_t core_ = 0, sub_ = 0;
};
// M119_RESIDENT_END

// M9_AIC_PRODUCER_BEGIN
// M207_CONSUMER_BEGIN
class M207AivConsumer {
    static constexpr uint32_t kWholeRows = 64;
    static constexpr uint32_t kWholeElems = kWholeRows * kM207InnerN;
    static constexpr uint32_t kWholeMaskBytes = kWholeElems / 8;
    static constexpr uint32_t kWholeS1Bytes = kWholeElems * sizeof(half) > 128 * sizeof(float)
        ? kWholeElems * sizeof(half) : 128 * sizeof(float);
    static constexpr uint32_t kWholeTmpBytes = 2 * kWholeElems * sizeof(float) + kWholeS1Bytes;
    static constexpr uint32_t kExplicitUB = 2 * kWholeElems * sizeof(int32_t) +
        2 * kMaxN * sizeof(float) + 2 * kWholeElems * sizeof(half) +
        kWholeTmpBytes + kWholeMaskBytes + 128 * sizeof(int64_t);
    static_assert(kWholeElems == 8192 && kWholeS1Bytes == 16384 && kWholeTmpBytes == 81920 &&
        kExplicitUB == 184320 && kExplicitUB < 184 * 1024,
        "M207 whole64x128 Resident stays below the 188416-byte allocation limit");
public:
    __aicore__ inline M207AivConsumer(AscendC::TPipe& pipe, const Tiling& t)
        : pipe_(pipe), t_(t) {}

    __aicore__ inline void Init(GM_ADDR scale, GM_ADDR groups, GM_ADDR y, GM_ADDR workspace)
    {
        scale_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scale));
        groups_.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups));
        groupBytes_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(groups));
        y_.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y));
        c_.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(workspace));
        core_ = AscendC::GetBlockIdx() / AscendC::GetTaskRation();
        sub_ = AscendC::GetSubBlockIdx();
        // + mask1024 + private groups1024. Two physical C/scale/Y stages remain.
        pipe_.InitBuffer(inQ_, 2, kWholeElems * sizeof(int32_t));
        pipe_.InitBuffer(scaleQ_, 2, kMaxN * sizeof(float));
        pipe_.InitBuffer(outQ_, 2, kWholeElems * sizeof(half));
        pipe_.InitBuffer(tmp_, kWholeTmpBytes);
        pipe_.InitBuffer(masks_, kWholeMaskBytes);
        pipe_.InitBuffer(groupCache_, 128 * sizeof(int64_t));
    }

    __aicore__ inline void Process()
    {
        LocalTensor<int64_t> localGroups = groupCache_.Get<int64_t>();
        const uint32_t groupBytes = t_.groups * sizeof(int64_t);
        AscendC::DataCopyExtParams gp{1, groupBytes, 0, 0, 0};
        AscendC::DataCopyPadExtParams<int8_t> gpad{true, 0,
            static_cast<uint8_t>((32 - groupBytes % 32) % 32), 0};
        AscendC::DataCopyPad(localGroups.ReinterpretCast<int8_t>(), groupBytes_, gp, gpad);
        const auto groupReady = pipe_.FetchEventID(AscendC::HardEvent::MTE2_S);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_S>(groupReady);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_S>(groupReady);

        uint32_t previousEnd = 0;
        uint32_t taskBase = 0;
        const uint32_t nTiles = CeilDiv(t_.n, t_.tileN);
        ResidentTile pending{};
        bool havePending = false;
        uint32_t tileCount = 0;
        for (uint32_t e = 0; e < t_.groups; ++e) {
            const uint32_t end = static_cast<uint32_t>(localGroups.GetValue(e));
            const uint32_t rows = end - previousEnd;
            const uint32_t tasks = CeilDiv(rows, t_.tileM) * nTiles;
            uint32_t task = (core_ + t_.cores - taskBase) % t_.cores;
            for (; task < tasks; task += t_.cores) {
                // The original N256 outer job stays on this AIC/AIV pair.
                const uint32_t rowTile = task / nTiles;
                const uint32_t row = rowTile * t_.tileM;
                const uint32_t col = ColumnTileOrder(e, rowTile, task % nTiles, nTiles) * t_.tileN;
                const uint32_t curM = Min(t_.tileM, rows - row);
                const uint32_t outerN = Min(t_.tileN, t_.n - col);
                for (uint32_t inner = 0; inner < outerN; inner += kM207InnerN) {
                    ResidentTile next{e, previousEnd + row, col + inner,
                        curM, Min(kM207InnerN, outerN - inner), tileCount};
                    // Keep the original pending order and two private queue stages.
                    if (havePending) { Consume(pending); }
                    Stage(next);
                    pending = next;
                    havePending = true;
                    ++tileCount;
                }
            }
            taskBase = (taskBase + tasks) % t_.cores;
            previousEnd = end;
        }
        if (havePending) { Consume(pending); }
        // AIC's old final free drain now proves only GM reader completion.
        // This separate local edge waits for ALL actual Y stores before exit.
        const auto outputDone = pipe_.FetchEventID(AscendC::HardEvent::MTE3_S);
        AscendC::SetFlag<AscendC::HardEvent::MTE3_S>(outputDone);
        AscendC::WaitFlag<AscendC::HardEvent::MTE3_S>(outputDone);
    }

private:
    __aicore__ inline void Stage(const ResidentTile& d)
    {
        const uint32_t slotIdx = d.ordinal % kSlots;
        const uint32_t halfRows = CeilDiv(d.curM, 2);
        const uint32_t firstRow = sub_ * halfRows;
        const uint32_t lastRow = Min(firstRow + halfRows, d.curM);
        AscendC::CrossCoreWaitFlag(kReady + slotIdx);
        if (firstRow < lastRow) {
            const uint32_t dataN = CeilDiv(d.curN, 8) * 8;
            const uint32_t rowN = CeilDiv(d.curN, 16) * 16;
            const uint64_t slot = M207Slot(core_, d.ordinal);
            LocalTensor<int32_t> ci = inQ_.AllocTensor<int32_t>();
            AscendC::DataCopyExtParams cp{static_cast<uint16_t>(lastRow - firstRow),
                static_cast<uint32_t>(d.curN * sizeof(int32_t)), 0, (rowN - dataN) / 8, 0};
            AscendC::DataCopyPadExtParams<int32_t> cpad{true, 0,
                static_cast<uint8_t>(dataN - d.curN), 0};
            AscendC::DataCopyPad(ci, c_[slot + static_cast<uint64_t>(firstRow) * d.curN], cp, cpad);
            // No later operation reads this GM slot: all owned rows have been
            // copied by the MTE2 stream before its mode2 release can execute.
            AscendC::CrossCoreSetFlag<2, PIPE_MTE2>(kFree + slotIdx);
            inQ_.EnQue(ci);

            LocalTensor<float> sc = scaleQ_.AllocTensor<float>();
            AscendC::DataCopyExtParams p{1, static_cast<uint32_t>(d.curN * sizeof(float)), 0, 0, 0};
            AscendC::DataCopyPadExtParams<float> pad{true, 0,
                static_cast<uint8_t>(dataN - d.curN), 0};
            AscendC::DataCopyPad(sc, scale_[static_cast<uint64_t>(d.e) * t_.n + d.col], p, pad);
            scaleQ_.EnQue(sc);
        } else {
            // The zero-row AIV still consumes ready and releases exactly once.
            AscendC::CrossCoreSetFlag<2, PIPE_MTE2>(kFree + slotIdx);
        }
    }

    __aicore__ inline void Consume(const ResidentTile& d)
    {
        const uint32_t halfRows = CeilDiv(d.curM, 2);
        const uint32_t firstRow = sub_ * halfRows;
        const uint32_t lastRow = Min(firstRow + halfRows, d.curM);
        if (firstRow >= lastRow) { return; }
        const uint32_t dataN = CeilDiv(d.curN, 8) * 8;
        const uint32_t rowN = CeilDiv(d.curN, 16) * 16;
        const uint32_t rows = lastRow - firstRow;
        const uint32_t count = CeilDiv(rows * rowN, 64) * 64;
        LocalTensor<int32_t> ci = inQ_.DeQue<int32_t>();
        LocalTensor<float> sc = scaleQ_.DeQue<float>();
        LocalTensor<float> z = tmp_.GetWithOffset<float>(kWholeElems, 0);
        // Exact same-start FP32 Div alias; no subsequent reader needs the original z.
        LocalTensor<float> out = z;
        LocalTensor<float> s0 = tmp_.GetWithOffset<float>(kWholeElems, kWholeElems * sizeof(float));
        LocalTensor<float> s1 = tmp_.GetWithOffset<float>(kWholeS1Bytes / sizeof(float),
            2 * kWholeElems * sizeof(float));
        auto signMask = masks_.GetWithOffset<uint8_t>(kWholeMaskBytes, 0);
        AscendC::Duplicate(z, 0.0f, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::UnaryRepeatParams castRep{1, 1,
            static_cast<uint8_t>(rowN / 8), static_cast<uint8_t>(rowN / 8)};
        AscendC::BinaryRepeatParams mulRep{1, 1, 1,
            static_cast<uint8_t>(rowN / 8), static_cast<uint8_t>(rowN / 8), 0};
        for (uint32_t c = 0; c < dataN; c += 64) {
            const uint64_t mask = Min(64, dataN - c);
            AscendC::Cast(z[c], ci[c], AscendC::RoundMode::CAST_NONE,
                mask, static_cast<uint8_t>(rows), castRep);
        }
        AscendC::PipeBarrier<PIPE_V>();
        // Only the whole private C share was read, before its V_MTE2 reverse edge.
        inQ_.FreeTensor(ci);
        for (uint32_t c = 0; c < dataN; c += 64) {
            const uint64_t mask = Min(64, dataN - c);
            AscendC::Mul(z[c], z[c], sc[c], mask, static_cast<uint8_t>(rows), mulRep);
        }
        AscendC::PipeBarrier<PIPE_V>();
        scaleQ_.FreeTensor(sc);
        ApplyGeluSimple(out, z, s0, s1, signMask, count);
        LocalTensor<half> yo = outQ_.AllocTensor<half>();
        AscendC::Cast(yo, out, AscendC::RoundMode::CAST_RINT, count);
        AscendC::PipeBarrier<PIPE_V>();
        outQ_.EnQue(yo);
        yo = outQ_.DeQue<half>();
        AscendC::DataCopyExtParams yp{static_cast<uint16_t>(rows),
            static_cast<uint32_t>(d.curN * sizeof(half)), 0,
            static_cast<uint32_t>((t_.n - d.curN) * sizeof(half)), 0};
        AscendC::DataCopyPad(y_[static_cast<uint64_t>(d.row + firstRow) * t_.n + d.col], yo, yp);
        outQ_.FreeTensor(yo);
    }

    AscendC::TPipe& pipe_;
    const Tiling& t_;
    GlobalTensor<float> scale_;
    GlobalTensor<int64_t> groups_;
    GlobalTensor<int8_t> groupBytes_;
    GlobalTensor<int32_t> c_;
    GlobalTensor<half> y_;
    AscendC::TQue<AscendC::TPosition::VECIN, 2> inQ_, scaleQ_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 2> outQ_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tmp_, masks_, groupCache_;
    uint32_t core_ = 0, sub_ = 0;
};
// M207_CONSUMER_END

// M120_NSTRIPE_CONSUMER_BEGIN
constexpr uint32_t kM208ShareRows = 32;
constexpr uint32_t kM208ShareElems = kM208ShareRows * kMaxN;
constexpr uint32_t kM208MaskBytes = kM208ShareElems / 8;
constexpr uint32_t kM208UbBytes = kM208ShareElems * sizeof(int32_t)
    + kM208ShareElems * sizeof(half) + 4 * kM208ShareElems * sizeof(float)
    + kMaxN * sizeof(float) + kM208MaskBytes + 128 * sizeof(int64_t);
static_assert(kMaxN == 256 && kM208ShareElems == 8192 && kM208UbBytes == 183296
    && kM208UbBytes < 188416, "M208 one private NStripe share and original disjoint GELU regions");

template <class MMType>
class NStripeAivConsumer {
public:
    __aicore__ inline NStripeAivConsumer(MMType& mm, AscendC::TPipe& pipe, const Tiling& t)
        : mm_(mm), pipe_(pipe), t_(t) {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR weight, GM_ADDR scale,
        GM_ADDR groups, GM_ADDR y, GM_ADDR workspace)
    {
        x_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
        w_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(weight));
        scale_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scale));
        groups_.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups));
        y_.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y));
        c_.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(workspace));
        core_ = AscendC::GetBlockIdx() / AscendC::GetTaskRation();
        sub_ = AscendC::GetSubBlockIdx();
        // inQ itself owns the entire <=32x256 INT32 share; no duplicate C cache.
        // Exact UB183296 B: C32768 + Y16384 + four floats131072 + scale1024
        // + mask1024 + private group endpoints1024; no output/scratch alias.
        pipe_.InitBuffer(inQ_, 1, kM208ShareElems * sizeof(int32_t));
        pipe_.InitBuffer(scaleQ_, 1, kMaxN * sizeof(float));
        pipe_.InitBuffer(outQ_, 1, kM208ShareElems * sizeof(half));
        pipe_.InitBuffer(tmp_, 4 * kM208ShareElems * sizeof(float));
        pipe_.InitBuffer(masks_, kM208MaskBytes);
        pipe_.InitBuffer(groupCache_, 128 * sizeof(int64_t));
        groupBytes_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(groups));
    }

    __aicore__ inline void Process()
    {
        LocalTensor<int64_t> localGroups;
        if ASCEND_IS_AIV {
            localGroups = groupCache_.Get<int64_t>();
            const uint32_t groupBytes = t_.groups * sizeof(int64_t);
            AscendC::DataCopyExtParams gp{1, groupBytes, 0, 0, 0};
            AscendC::DataCopyPadExtParams<int8_t> gpad{true, 0,
                static_cast<uint8_t>((32 - groupBytes % 32) % 32), 0};
            AscendC::DataCopyPad(localGroups.ReinterpretCast<int8_t>(), groupBytes_, gp, gpad);
            const auto groupReady = pipe_.FetchEventID(AscendC::HardEvent::MTE2_S);
            AscendC::SetFlag<AscendC::HardEvent::MTE2_S>(groupReady);
            AscendC::WaitFlag<AscendC::HardEvent::MTE2_S>(groupReady);
        }
        uint32_t previousEnd = 0;
        uint32_t taskBase = 0;
        const uint32_t nPairs = t_.n / 512;
        for (uint32_t e = 0; e < t_.groups; ++e) {
            uint32_t end;
            if ASCEND_IS_AIV {
                end = static_cast<uint32_t>(localGroups.GetValue(e));
            } else {
                end = static_cast<uint32_t>(groups_.GetValue(e));
            }
            const uint32_t rows = end - previousEnd;
            const uint32_t tasks = CeilDiv(rows, 64) * nPairs;
            uint32_t task = (core_ + t_.cores - taskBase) % t_.cores;
            for (; task < tasks; task += t_.cores) {
                const auto loc = LocateNStripe(e, previousEnd, rows, task, nPairs);
                Compute(e, loc.row, loc.col, loc.rows, 256);
                Compute(e, loc.row, loc.col + 256, loc.rows, 256);
            }
            taskBase = (taskBase + tasks) % t_.cores;
            previousEnd = end;
        }
        // Free now proves GM read completion only. Drain every real Y store
        // independently before this AIV returns, including its final slot.
        if (tileCount_ != 0) {
            const auto outputDone = pipe_.FetchEventID(AscendC::HardEvent::MTE3_S);
            AscendC::SetFlag<AscendC::HardEvent::MTE3_S>(outputDone);
            AscendC::WaitFlag<AscendC::HardEvent::MTE3_S>(outputDone);
        }
    }


private:
    __aicore__ inline void Compute(uint32_t e, uint32_t row, uint32_t col,
        uint32_t curM, uint32_t curN)
    {
        // Exact original pair ordering: col then col+256, continuous across experts.
        const uint32_t slotIdx = tileCount_ % kSlots;
        const uint64_t slot = (static_cast<uint64_t>(core_) * kSlots + slotIdx)
            * t_.tileM * t_.tileN;
        AscendC::CrossCoreWaitFlag(kReady + slotIdx);
        Epilogue(e, row, col, curM, curN, slot, slotIdx);
        ++tileCount_;
    }

    __aicore__ inline void Epilogue(uint32_t e, uint32_t row, uint32_t col,
        uint32_t curM, uint32_t curN, uint64_t slot, uint32_t slotIdx)
    {
        const uint32_t halfRows = CeilDiv(curM, 2);
        const uint32_t firstRow = sub_ * halfRows;
        const uint32_t lastRow = Min(firstRow + halfRows, curM);
        if (firstRow >= lastRow) {
            // A zero-row AIV still consumes this Ready and releases exactly once.
            AscendC::CrossCoreSetFlag<2, PIPE_MTE2>(kFree + slotIdx);
            return;
        }
        const uint32_t rows = lastRow - firstRow;
        const uint32_t dataN = CeilDiv(curN, 8) * 8;
        const uint32_t rowN = CeilDiv(curN, 16) * 16;
        const uint32_t count = CeilDiv(rows * rowN, 64) * 64;
        LocalTensor<int32_t> ci = inQ_.AllocTensor<int32_t>();
        AscendC::DataCopyExtParams cp{static_cast<uint16_t>(rows),
            static_cast<uint32_t>(curN * sizeof(int32_t)), 0, (rowN - dataN) / 8, 0};
        AscendC::DataCopyPadExtParams<int32_t> cpad{true, 0,
            static_cast<uint8_t>(dataN - curN), 0};
        AscendC::DataCopyPad(ci, c_[slot + static_cast<uint64_t>(firstRow) * curN], cp, cpad);
        inQ_.EnQue(ci);
        ci = inQ_.DeQue<int32_t>();
        // Every actual C row is now in this private inQ tensor. No later read
        // references GM C; mode2 still requires both AIVs' MTE2 read completion.
        AscendC::CrossCoreSetFlag<2, PIPE_MTE2>(kFree + slotIdx);

        LocalTensor<float> sc = scaleQ_.AllocTensor<float>();
        AscendC::DataCopyExtParams p{1, static_cast<uint32_t>(curN * sizeof(float)), 0, 0, 0};
        AscendC::DataCopyPadExtParams<float> pad{true, 0, static_cast<uint8_t>(dataN - curN), 0};
        AscendC::DataCopyPad(sc, scale_[static_cast<uint64_t>(e) * t_.n + col], p, pad);
        scaleQ_.EnQue(sc);
        sc = scaleQ_.DeQue<float>();
        LocalTensor<float> z = tmp_.GetWithOffset<float>(kM208ShareElems, 0);
        LocalTensor<float> out = tmp_.GetWithOffset<float>(kM208ShareElems, kM208ShareElems * sizeof(float));
        LocalTensor<float> s0 = tmp_.GetWithOffset<float>(kM208ShareElems, 2 * kM208ShareElems * sizeof(float));
        LocalTensor<float> s1 = tmp_.GetWithOffset<float>(kM208ShareElems, 3 * kM208ShareElems * sizeof(float));
        auto signMask = masks_.GetWithOffset<uint8_t>(kM208MaskBytes, 0);
        AscendC::Duplicate(z, 0.0f, count);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::UnaryRepeatParams castRep{1, 1,
            static_cast<uint8_t>(rowN / 8), static_cast<uint8_t>(rowN / 8)};
        AscendC::BinaryRepeatParams mulRep{1, 1, 1,
            static_cast<uint8_t>(rowN / 8), static_cast<uint8_t>(rowN / 8), 0};
        for (uint32_t c = 0; c < dataN; c += 64) {
            const uint64_t mask = Min(64, dataN - c);
            AscendC::Cast(z[c], ci[c], AscendC::RoundMode::CAST_NONE,
                mask, static_cast<uint8_t>(rows), castRep);
        }
        AscendC::PipeBarrier<PIPE_V>();
        for (uint32_t c = 0; c < dataN; c += 64) {
            const uint64_t mask = Min(64, dataN - c);
            AscendC::Mul(z[c], z[c], sc[c], mask, static_cast<uint8_t>(rows), mulRep);
        }
        AscendC::PipeBarrier<PIPE_V>();
        inQ_.FreeTensor(ci);
        ApplyGeluSimple(out, z, s0, s1, signMask, count);
        LocalTensor<half> yo = outQ_.AllocTensor<half>();
        AscendC::Cast(yo, out, AscendC::RoundMode::CAST_RINT, count);
        AscendC::PipeBarrier<PIPE_V>();
        outQ_.EnQue(yo);
        yo = outQ_.DeQue<half>();
        AscendC::DataCopyExtParams yp{static_cast<uint16_t>(rows),
            static_cast<uint32_t>(curN * sizeof(half)), 0,
            static_cast<uint32_t>((t_.n - curN) * sizeof(half)), 0};
        AscendC::DataCopyPad(y_[static_cast<uint64_t>(row + firstRow) * t_.n + col], yo, yp);
        outQ_.FreeTensor(yo);
        scaleQ_.FreeTensor(sc);
    }

    MMType& mm_;
    AscendC::TPipe& pipe_;
    const Tiling& t_;
    GlobalTensor<int8_t> x_, w_;
    GlobalTensor<float> scale_;
    GlobalTensor<int64_t> groups_;
    GlobalTensor<int32_t> c_;
    GlobalTensor<half> y_;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQ_, scaleQ_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQ_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tmp_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> masks_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> groupCache_;
    GlobalTensor<int8_t> groupBytes_;
    uint32_t core_ = 0;
    uint32_t sub_ = 0;
    uint32_t tileCount_ = 0;
};
// M120_NSTRIPE_CONSUMER_END

// M118_PRODUCER_BEGIN
class NStripeAicProducer {
public:
    __aicore__ inline NStripeAicProducer(NStripeMM& mm, const Tiling& t) : mm_(mm), t_(t) {}
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR weight, GM_ADDR groups, GM_ADDR workspace)
    {
        x_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
        w_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(weight));
        groups_.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups));
        c_.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(workspace));
        core_ = AscendC::GetBlockIdx();
    }
    __aicore__ inline void Process()
    {
        uint32_t previousEnd = 0;
        uint32_t taskBase = 0;
        const uint32_t nPairs = t_.n / 512;
        for (uint32_t e = 0; e < t_.groups; ++e) {
            const uint32_t end = static_cast<uint32_t>(groups_.GetValue(e));
            const uint32_t rows = end - previousEnd;
            const uint32_t tasks = CeilDiv(rows, 64) * nPairs;
            uint32_t task = (core_ + t_.cores - taskBase) % t_.cores;
            for (; task < tasks; task += t_.cores) {
                const auto loc = LocateNStripe(e, previousEnd, rows, task, nPairs);
                ProducePair(e, loc.row, loc.col, loc.rows);
            }
            taskBase = (taskBase + tasks) % t_.cores;
            previousEnd = end;
        }
        if (pairCount_ != 0) {
            AscendC::CrossCoreWaitFlag(kFree);
            AscendC::CrossCoreWaitFlag(kFree + 1);
        }
        mm_.End();
    }
private:
    __aicore__ inline void ProducePair(uint32_t e, uint32_t row, uint32_t col, uint32_t curM)
    {
        const uint64_t slotBase = static_cast<uint64_t>(core_) * kSlots * 64 * 256;
        mm_.SetOrgShape(t_.m, t_.n, t_.k, t_.k, 256);
        mm_.SetSingleShape(curM, 512, t_.k);
        mm_.SetTensorA(x_[static_cast<uint64_t>(row) * t_.k]);
        mm_.SetTensorB(w_[static_cast<uint64_t>(e) * t_.k * t_.n + col]);
        while (mm_.Iterate()) {
            // Keep enSequentialWrite=true; the third argument is not a sync flag.
            mm_.GetTensorC(c_[slotBase], 0, true);
        }
        ++pairCount_;
    }
    NStripeMM& mm_;
    const Tiling& t_;
    GlobalTensor<int8_t> x_, w_;
    GlobalTensor<int64_t> groups_;
    GlobalTensor<int32_t> c_;
    uint32_t core_ = 0;
    uint32_t pairCount_ = 0;
};
// M118_PRODUCER_END
// AIC-only producer. The unchanged Kernel<StaticMM> AIV consumes each
// 128x256 coarse tile as one compact curM*curN GM slot.
class MdlPairAicProducer {
public:
    __aicore__ inline MdlPairAicProducer(MdlPairMM& mm, const Tiling& t)
        : mm_(mm), t_(t) {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR weight, GM_ADDR groups, GM_ADDR workspace)
    {
        x_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
        w_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(weight));
        groups_.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups));
        c_.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(workspace));
        core_ = AscendC::GetBlockIdx();
    }

    __aicore__ inline void Process()
    {
        uint32_t previousEnd = 0;
        uint32_t taskBase = 0;
        const uint32_t nTiles = CeilDiv(t_.n, t_.tileN);
        for (uint32_t e = 0; e < t_.groups; ++e) {
            const uint32_t end = static_cast<uint32_t>(groups_.GetValue(e));
            const uint32_t rows = end - previousEnd;
            const uint32_t tasks = CeilDiv(rows, t_.tileM) * nTiles;
            uint32_t task = (core_ + t_.cores - taskBase) % t_.cores;
            for (; task < tasks; task += t_.cores) {
                const uint32_t row = (task / nTiles) * t_.tileM;
                const uint32_t col = (task % nTiles) * t_.tileN;
                const uint32_t curM = Min(t_.tileM, rows - row);
                const uint32_t curN = Min(t_.tileN, t_.n - col);
                Compute(e, previousEnd + row, col, curM, curN);
            }
            taskBase = (taskBase + tasks) % t_.cores;
            previousEnd = end;
        }
        const uint32_t pending = Min(tileCount_, kSlots);
        for (uint32_t i = 0; i < pending; ++i) {
            const uint32_t slotIdx = (tileCount_ - pending + i) % kSlots;
            AscendC::CrossCoreWaitFlag(kFree + slotIdx);
        }
        mm_.End();
    }

private:
    __aicore__ inline void ProduceFragment(uint32_t e, uint32_t row, uint32_t col,
        uint32_t rows, uint32_t curN, uint64_t destination)
    {
        // Same M3 API contract: A/B keep actual K/N strides; C alone uses
        // compact curN rows. Non-sequential OUTER output preserves both
        // 64-row C fragments of a complete 128-row pair.
        mm_.SetOrgShape(t_.m, t_.n, t_.k, t_.k, curN);
        mm_.SetSingleShape(rows, curN, t_.k);
        mm_.SetTensorA(x_[static_cast<uint64_t>(row) * t_.k]);
        mm_.SetTensorB(w_[static_cast<uint64_t>(e) * t_.k * t_.n + col]);
        while (mm_.Iterate()) {
            mm_.GetTensorC(c_[destination], 0, false);
        }
    }

    __aicore__ inline void Compute(uint32_t e, uint32_t row, uint32_t col,
        uint32_t curM, uint32_t curN)
    {
        const uint32_t slotIdx = tileCount_ % kSlots;
        const uint64_t slot = (static_cast<uint64_t>(core_) * kSlots + slotIdx)
            * t_.tileM * t_.tileN;
        if (tileCount_ >= kSlots) {
            AscendC::CrossCoreWaitFlag(kFree + slotIdx);
        }
        if (curM > 64 && curM < 128) {
            // A partial second 64-row block disables the MDL pair buffer.
            // Keep two API tasks, as in M3, but merge their compact output
            // into ONE coarse slot before signalling the unchanged AIV.
            ProduceFragment(e, row, col, 64, curN, slot);
            ProduceFragment(e, row + 64, col, curM - 64, curN,
                slot + static_cast<uint64_t>(64) * curN);
        } else {
            // Complete 128 rows: one paired API task. <=64 rows: one task.
            ProduceFragment(e, row, col, curM, curN, slot);
        }
        AscendC::CrossCoreSetFlag<2, PIPE_FIX>(kReady + slotIdx);
        ++tileCount_;
    }

    MdlPairMM& mm_;
    const Tiling& t_;
    GlobalTensor<int8_t> x_, w_;
    GlobalTensor<int64_t> groups_;
    GlobalTensor<int32_t> c_;
    uint32_t core_ = 0;
    uint32_t tileCount_ = 0;
};
// M207_PRODUCER_BEGIN
class M207AicProducer {
public:
    __aicore__ inline M207AicProducer(M207MM& mm, const Tiling& t) : mm_(mm), t_(t) {}
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR weight, GM_ADDR groups, GM_ADDR workspace)
    {
        x_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
        w_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(weight));
        groups_.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups));
        c_.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(workspace));
        core_ = AscendC::GetBlockIdx();
    }
    __aicore__ inline void Process()
    {
        uint32_t previousEnd = 0;
        uint32_t taskBase = 0;
        const uint32_t nTiles = CeilDiv(t_.n, t_.tileN);
        for (uint32_t e = 0; e < t_.groups; ++e) {
            const uint32_t end = static_cast<uint32_t>(groups_.GetValue(e));
            const uint32_t rows = end - previousEnd;
            const uint32_t tasks = CeilDiv(rows, t_.tileM) * nTiles;
            uint32_t task = (core_ + t_.cores - taskBase) % t_.cores;
            for (; task < tasks; task += t_.cores) {
                const uint32_t rowTile = task / nTiles;
                const uint32_t row = rowTile * t_.tileM;
                const uint32_t col = ColumnTileOrder(e, rowTile, task % nTiles, nTiles) * t_.tileN;
                Compute(e, previousEnd + row, col,
                    Min(t_.tileM, rows - row), Min(t_.tileN, t_.n - col));
            }
            taskBase = (taskBase + tasks) % t_.cores;
            previousEnd = end;
        }
        const uint32_t pending = Min(tileCount_, kSlots);
        for (uint32_t i = 0; i < pending; ++i) {
            const uint32_t slotIdx = (tileCount_ - pending + i) % kSlots;
            AscendC::CrossCoreWaitFlag(kFree + slotIdx);
        }
        mm_.End();
    }
private:
    __aicore__ inline void Compute(uint32_t e, uint32_t row, uint32_t col,
        uint32_t curM, uint32_t curN)
    {
        // One outer N256 job and one unchanged input/shape sequence for both N128 pieces.
        mm_.SetOrgShape(t_.m, t_.n, t_.k, t_.k, curN);
        mm_.SetSingleShape(curM, curN, t_.k);
        mm_.SetTensorA(x_[static_cast<uint64_t>(row) * t_.k]);
        mm_.SetTensorB(w_[static_cast<uint64_t>(e) * t_.k * t_.n + col]);
        while (mm_.Iterate()) {
            const uint32_t slotIdx = tileCount_ % kSlots;
            const uint64_t slot = M207Slot(core_, tileCount_);
            // Acquire GM at its first write; the other CO1 bank may compute before this wait.
            if (tileCount_ >= kSlots) {
                AscendC::CrossCoreWaitFlag(kFree + slotIdx);
            }
            // Each actual base-N output begins at its own compact GM slot prefix.
            mm_.GetTensorC(c_[slot], 0, true);
            AscendC::CrossCoreSetFlag<2, PIPE_FIX>(kReady + slotIdx);
            ++tileCount_;
        }
    }
    M207MM& mm_;
    const Tiling& t_;
    GlobalTensor<int8_t> x_, w_;
    GlobalTensor<int64_t> groups_;
    GlobalTensor<int32_t> c_;
    uint32_t core_ = 0;
    uint32_t tileCount_ = 0;
};
// M207_PRODUCER_END

// M173_BUNDLE_PRODUCER_BEGIN: full B is invocation-local, reset at each bundle.
class BFullKBundleAicProducer {
public:
    __aicore__ inline BFullKBundleAicProducer(BFullKBundleMM& mm, const Tiling& t)
        : mm_(mm), t_(t) {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR weight, GM_ADDR groups, GM_ADDR workspace)
    {
        x_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
        w_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(weight));
        groups_.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups));
        c_.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(workspace));
        core_ = AscendC::GetBlockIdx();
    }

    __aicore__ inline void Process()
    {
        uint32_t previousEnd = 0;
        uint32_t taskBase = 0;
        const uint32_t nTiles = CeilDiv(t_.n, t_.tileN);
        for (uint32_t e = 0; e < t_.groups; ++e) {
            const uint32_t end = static_cast<uint32_t>(groups_.GetValue(e));
            const uint32_t rows = end - previousEnd;
            const uint32_t tasks = CeilDiv(rows, t_.tileM) * nTiles;
            uint32_t task = (core_ + t_.cores - taskBase) % t_.cores;
            for (; task < tasks; task += t_.cores) {
                const uint32_t row = (task / nTiles) * t_.tileM;
                const uint32_t col = ColumnTileOrder(e, task / nTiles, task % nTiles, nTiles) * t_.tileN;
                Compute(e, previousEnd + row, col,
                    Min(t_.tileM, rows - row), Min(t_.tileN, t_.n - col));
            }
            taskBase = (taskBase + tasks) % t_.cores;
            previousEnd = end;
        }
        const uint32_t pending = Min(tileCount_, kSlots);
        for (uint32_t i = 0; i < pending; ++i) {
            const uint32_t slotIdx = (tileCount_ - pending + i) % kSlots;
            AscendC::CrossCoreWaitFlag(kFree + slotIdx);
        }
        mm_.End();
    }

private:
    __aicore__ inline void ProduceFragment(uint32_t row, uint32_t rows,
        uint32_t curN, uint64_t destination)
    {
        // SetTensorA resets only this input and the scheduler iteration state.
        // The B-fullK specialization retains this bundle's input/cache.
        mm_.SetSingleShape(rows, curN, t_.k);
        mm_.SetTensorA(x_[static_cast<uint64_t>(row) * t_.k]);
        while (mm_.Iterate()) {
            mm_.GetTensorC(c_[destination], 0, false);
        }
    }

    __aicore__ inline void Compute(uint32_t e, uint32_t row, uint32_t col,
        uint32_t curM, uint32_t curN)
    {
        const uint32_t slotIdx = tileCount_ % kSlots;
        const uint64_t slot = (static_cast<uint64_t>(core_) * kSlots + slotIdx)
            * t_.tileM * t_.tileN;
        if (tileCount_ >= kSlots) {
            AscendC::CrossCoreWaitFlag(kFree + slotIdx);
        }
        // The new SetTensorB resets/releases the preceding bundle's cached B.
        // OrgKc keeps every fragment's destination compact with curN stride.
        mm_.SetOrgShape(t_.m, t_.n, t_.k, t_.k, curN);
        mm_.SetTensorB(w_[static_cast<uint64_t>(e) * t_.k * t_.n + col]);
        for (uint32_t offset = 0; offset < curM; offset += 128) {
            const uint32_t pieceM = Min(128U, curM - offset);
            const uint64_t destination = slot + static_cast<uint64_t>(offset) * curN;
            if (pieceM > 64 && pieceM < 128) {
                ProduceFragment(row + offset, 64, curN, destination);
                ProduceFragment(row + offset + 64, pieceM - 64, curN,
                    destination + static_cast<uint64_t>(64) * curN);
            } else {
                ProduceFragment(row + offset, pieceM, curN, destination);
            }
        }
        // All M pieces are complete before either AIV sees this coarse slot.
        AscendC::CrossCoreSetFlag<2, PIPE_FIX>(kReady + slotIdx);
        ++tileCount_;
    }

    BFullKBundleMM& mm_;
    const Tiling& t_;
    GlobalTensor<int8_t> x_, w_;
    GlobalTensor<int64_t> groups_;
    GlobalTensor<int32_t> c_;
    uint32_t core_ = 0;
    uint32_t tileCount_ = 0;
};
// M173_BUNDLE_PRODUCER_END

// M9_AIC_PRODUCER_END

// M127_PRODUCER_BEGIN
class FullAAicProducer {
public:
    __aicore__ inline FullAAicProducer(FullAMM& mm,AscendC::TPipe& pipe,const Tiling& t)
        : mm_(mm),pipe_(pipe),t_(t) {}
    __aicore__ inline void Init(GM_ADDR x,GM_ADDR w,GM_ADDR groups,GM_ADDR workspace)
    {
        x_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
        w_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(w));
        groups_.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups));
        c_.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(workspace));
        core_=AscendC::GetBlockIdx();
        // mm.Init has reserved its B1/event resources before this private SCM.
        pipe_.InitBuffer(aScm_,1,128*2048*sizeof(int8_t));
        // Alloc, not Fetch: reserve the independent read-done ID against later SDK Fetch.
        aReadDone_=pipe_.AllocEventID<AscendC::HardEvent::MTE1_MTE2>();
    }
    __aicore__ inline void Process()
    {
        FullAJobIterator<GlobalTensor<int64_t>> it(t_,groups_,core_);
        FullAJob job;
        while (it.Next(job)) {
            auto a=aScm_.AllocTensor<int8_t>();
            AscendC::Nd2NzParams p{};
            p.ndNum=1;p.nValue=128;p.dValue=t_.k;p.srcDValue=t_.k;
            p.dstNzC0Stride=128;p.dstNzNStride=1;
            AscendC::DataCopy(a,x_[static_cast<uint64_t>(job.row)*t_.k],p);
            aScm_.EnQue(a);a=aScm_.DeQue<int8_t>();
            for (uint32_t n=0;n<job.outputs;++n) {
                ProduceTile(job.expert,job.col+n*256,a);
            }
            // Last A1->L0 read must finish before another job's GM->A1 overwrite.
            // C ready/free protects separate GM C storage, never substitutes this edge.
            AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(aReadDone_);
            AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(aReadDone_);
            aScm_.FreeTensor(a);
        }
        const uint32_t pending=Min(tileCount_,kSlots);
        for(uint32_t i=0;i<pending;++i) {
            const uint32_t slotIdx=(tileCount_-pending+i)%kSlots;
            AscendC::CrossCoreWaitFlag(kFree+slotIdx);
        }
        mm_.End();
        pipe_.ReleaseEventID<AscendC::HardEvent::MTE1_MTE2>(aReadDone_);
    }
private:
    __aicore__ inline void ProduceTile(uint32_t e,uint32_t col,const LocalTensor<int8_t>& a)
    {
        const uint32_t slotIdx=tileCount_%kSlots;
        const uint64_t slot=(static_cast<uint64_t>(core_)*kSlots+slotIdx)*128*256;
        if(tileCount_>=kSlots) AscendC::CrossCoreWaitFlag(kFree+slotIdx);
        mm_.SetOrgShape(128,t_.n,t_.k,t_.k,256);
        mm_.SetSingleShape(128,256,t_.k);
        mm_.SetTensorA(a);
        mm_.SetTensorB(w_[static_cast<uint64_t>(e)*t_.k*t_.n+col]);
        while(mm_.Iterate()) mm_.GetTensorC(c_[slot],0,false);
        AscendC::CrossCoreSetFlag<2,PIPE_FIX>(kReady+slotIdx);
        ++tileCount_;
    }
    FullAMM& mm_; AscendC::TPipe& pipe_; const Tiling& t_;
    GlobalTensor<int8_t> x_,w_;GlobalTensor<int64_t> groups_;GlobalTensor<int32_t> c_;
    AscendC::TSCM<AscendC::TPosition::GM,1,&kFullAScmConfig> aScm_;
    AscendC::TEventID aReadDone_;
    uint32_t core_=0,tileCount_=0;
};
// M127_PRODUCER_END

