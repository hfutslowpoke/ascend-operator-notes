    "complete runtime K loops and tails must remain enabled");
static_assert(!AscendC::IsBasicM(kMdlPair), "two M blocks must stay enabled");
static_assert(kMdlPair.baseM == 64 && kMdlPair.baseN == 256 && kMdlPair.baseK == 128 &&
    kMdlPair.cfg.basicK == kMdlPair.baseK &&
    kMdlPair.stepM == 2 && kMdlPair.stepN == 1 &&
    kMdlPair.stepKa == 2 && kMdlPair.stepKb == 2 &&
    kMdlPair.depthA1 == 8 && kMdlPair.depthB1 == 4, "HT55 explicit pair/L1 shape");
static_assert(kMdlPair.dbL0A == 2 && kMdlPair.dbL0B == 2 && kMdlPair.dbL0C == 1 &&
    64 * 128 * 2 <= 65536 && 256 * 128 * 2 <= 65536 &&
    kMdlPair.shareL1Size <= 524160 && kMdlPair.shareL0CSize == 65536 &&
    kMdlPair.transLength == 65536 && kMdlPair.shareUbSize == 0,
    "HT55 2 physical C fragments remain separately live, total 131072");
static_assert(kMdlPair.shareL1Size <= 524288 &&
    2 * 64 * 256 * sizeof(int32_t) <= 131072, "L1 and two live L0C fragments fit");
using MdlPairMM = matmul::MatmulImpl<AType, BType, CType, BiasType, kMdlPair,
    AscendC::MatmulCallBackFunc<nullptr, nullptr, nullptr>, AscendC::Impl::Detail::GmmPairMdlPolicy>;
// M9_MDL_CONFIG_END

constexpr uint32_t kM207Mode = 9;
constexpr uint32_t kM207InnerN = 128;
constexpr uint32_t kM207SlotElems = 128 * 256; // Original Host M128/N256 slot stride.
static __aicore__ inline constexpr MatmulConfig M207Config()
{
    MatmulConfig cfg = CFG_MDL;
    cfg.singleCoreM = 128; cfg.singleCoreN = 256; cfg.singleCoreK = 8192;
    cfg.basicM = 128; cfg.basicN = 128; cfg.basicK = 256;
    cfg.enableSetBias = false;
    cfg.enableSetTail = true;
    cfg.enableSetOrgShape = true;
    cfg.enableStaticPadZeros = false;
    cfg.enUnitFlag = false;
    cfg.iterateOrder = IterateOrder::ORDER_N;
    cfg.scheduleType = ScheduleType::INNER_PRODUCT;
    return cfg;
}
static __aicore__ inline constexpr auto M207Tiling()
{
    auto tiling = AscendC::GetMatmulApiTiling<AType, BType, CType, BiasType,
        MatmulPairShape<128, 256, 8192>, MatmulPairShape<128, 128, 256>,
        MatmulPairShape<128, 128, 256>>(M207Config());
    // The public constant factory defaults to one C bank even when two fit.
    tiling.dbL0C = 2;
    tiling.shareL0CSize = 128 * 128 * sizeof(int32_t) * 2;
    return tiling;
}
constexpr auto kM207 = M207Tiling();
static_assert(kM207.cfg.doMultiDataLoad && !kM207.cfg.doNorm &&
    kM207.cfg.scheduleType == ScheduleType::INNER_PRODUCT &&
    kM207.cfg.iterateOrder == IterateOrder::ORDER_N && !kM207.cfg.enUnitFlag,
    "M207 native INNER uses the ordinary two-bank CO1 queue");
static_assert(kM207.baseM == 128 && kM207.baseN == 128 && kM207.baseK == 256 &&
    kM207.stepM == 1 && kM207.stepN == 1 && kM207.stepKa == 1 && kM207.stepKb == 1 &&
    kM207.depthA1 == 2 && kM207.depthB1 == 2, "M207 exact native/L1 geometry");
static_assert(kM207.dbL0A == 2 && kM207.dbL0B == 2 && kM207.dbL0C == 2 &&
    kM207.baseM * kM207.baseK * sizeof(int8_t) * kM207.dbL0A == 65536 &&
    kM207.baseN * kM207.baseK * sizeof(int8_t) * kM207.dbL0B == 65536 &&
    kM207.baseM * kM207.baseN * sizeof(int32_t) * kM207.dbL0C == 131072 &&
    kM207.shareL0CSize == 131072, "M207 A0/B0 and both independent C0 banks fit 2201");
static_assert(kM207.shareL1Size == 133120 && kM207.shareL1Size <= 524160 &&
    kM207.transLength == 65536 && kM207.shareUbSize == 0,
    "M207 L1 includes the original 2048-byte quant reserve; no new quant work");
static_assert(AscendC::IsBasicM(kM207) && !AscendC::NoTailM(kM207) &&
    !AscendC::IsBasicN(kM207) && !AscendC::NoTailN(kM207) &&
    !AscendC::IsBasicK(kM207) && !AscendC::NoTailK(kM207),
    "M207 real g/N tails and full runtime K; two N128 outputs are not reset jobs");
using M207MM = matmul::MatmulImpl<AType, BType, CType, BiasType, kM207>;
static __aicore__ inline bool UseM207(const Tiling& t)
{
    return t.reserved == kM207Mode;
}
static __aicore__ inline uint64_t M207Slot(uint32_t core, uint32_t ordinal)
{
    return (static_cast<uint64_t>(core) * kSlots + ordinal % kSlots) * kM207SlotElems;
}
// M207_CONFIG_END

