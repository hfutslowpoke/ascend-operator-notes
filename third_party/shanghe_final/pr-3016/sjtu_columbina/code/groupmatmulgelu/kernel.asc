    AscendC::MatmulCallBackFunc<nullptr, nullptr, nullptr>, AscendC::Impl::Detail::GmmPairMdlPolicy>;
static __aicore__ inline bool UseBFullKBundle(const Tiling& t)
{
    return t.reserved == 2 && t.tileM == 256 && t.tileN == 256;
}
static __aicore__ inline uint32_t ColumnTileOrder(uint32_t expert, uint32_t rowTile,
    uint32_t oldColTile, uint32_t nTiles)
{
    return nTiles > 1 ? (oldColTile + expert + rowTile) % nTiles : oldColTile;
}
