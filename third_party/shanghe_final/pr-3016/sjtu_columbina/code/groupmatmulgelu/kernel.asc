constexpr auto kFullA = AscendC::GetMatmulApiTiling<FullAType, BType, CType, BiasType,
    MatmulPairShape<128,256,2048>, MatmulPairShape<128,256,256>,
    MatmulPairShape<64,256,256>>(FullAConfig());
static_assert(kFullA.cfg.doMultiDataLoad && !kFullA.cfg.doNorm &&
    kFullA.cfg.scheduleType == ScheduleType::OUTER_PRODUCT &&
    kFullA.cfg.iterateOrder == IterateOrder::ORDER_N, "M127 original MDL M-oriented policy");
static_assert(kFullA.baseM == 64 && kFullA.baseN == 256 && kFullA.baseK == 256 &&
    kFullA.stepM == 2 && kFullA.stepN == 1 && kFullA.stepKa == 1 && kFullA.stepKb == 1 &&
    kFullA.depthA1 == 4 && kFullA.depthB1 == 2, "M127 two M fragments share one B1");
static_assert(!AscendC::IsBasicK(kFullA) && !AscendC::NoTailK(kFullA) &&
    !AscendC::IsBasicM(kFullA), "M127 complete runtime K and two M fragments");
static_assert(kFullA.dbL0A == 2 && kFullA.dbL0B == 1 && kFullA.dbL0C == 1,
    "M127 original L0 DB identity");
static_assert(kFullA.shareL1Size == 135168 && kFullA.shareL1Size + 128*2048 <= 524288,
    "M127 B1 131072 plus quant extras4096 plus external A262144");
static_assert(kFullA.shareL0CSize == 65536 && 2*64*256*sizeof(int32_t) == 131072,
    "M127 two live C fragments, never N512 accumulator");
static constexpr AscendC::TQueConfig kFullAScmConfig = {false,false,true,0,1,0,{},true};
using FullAMM = matmul::MatmulImpl<FullAType,BType,CType,BiasType,kFullA,
    AscendC::MatmulCallBackFunc<nullptr,nullptr,nullptr>,AscendC::Impl::Detail::GmmPairMdlPolicy>;

struct FullAJob { uint32_t expert, row, col, outputs; };
// Shared by AIC and BOTH AIV. Full pairs and odd tails have separate ordinals.
template<class GroupTensor>
class FullAJobIterator {
public:
    __aicore__ inline FullAJobIterator(const Tiling& t, const GroupTensor& g, uint32_t core)
        : t_(t), groups_(g), core_(core) {}
    __aicore__ inline bool Next(FullAJob& job)
    {
        const uint32_t q=t_.n/512, odd=(t_.n/256)%2;
        const uint64_t fullJobs=static_cast<uint64_t>(t_.m/128)*q;
        while (expert_<t_.groups) {
            const uint32_t end=static_cast<uint32_t>(groups_.GetValue(expert_));
            const uint32_t blocks=(end-previousEnd_)/128;
            while (blockInGroup_<blocks) {
                while (part_<q+odd) {
                    const uint32_t part=part_++;
                    const uint64_t b=blockBase_+blockInGroup_;
                    const uint64_t ordinal=part<q ? b*q+part : fullJobs+b;
                    if (ordinal%t_.cores == core_) {
                        job={expert_,previousEnd_+blockInGroup_*128,part*512,part<q?2U:1U};
                        return true;
                    }
                }
                part_=0; ++blockInGroup_;
            }
            blockBase_+=blocks; blockInGroup_=0; previousEnd_=end; ++expert_;
        }
        return false;
    }
private:
    const Tiling& t_; const GroupTensor& groups_; uint32_t core_;
    uint32_t expert_=0, previousEnd_=0, blockInGroup_=0, part_=0;
    uint64_t blockBase_=0;
};
// M127_CONFIG_END

static __aicore__ inline constexpr MatmulConfig FullAK128Config()
{
    MatmulConfig cfg=FullAConfig();
    cfg.basicK=128;
    return cfg;
}
// Independent Ka128/Kb256 L1 panels: retain two-M-fragment organization.
using M254L1Shape=AscendC::Std::tuple<AscendC::Std::integral_constant<int,128>,
    AscendC::Std::integral_constant<int,256>,AscendC::Std::integral_constant<int,128>,
    AscendC::Std::integral_constant<int,256>>;
constexpr auto kFullAK128=AscendC::GetMatmulApiTiling<FullAType,BType,CType,BiasType,
    MatmulPairShape<128,256,2048>,M254L1Shape,
    MatmulPairShape<64,256,128>>(FullAK128Config());
static_assert(kFullAK128.cfg.doMultiDataLoad && !kFullAK128.cfg.doNorm &&
    kFullAK128.cfg.scheduleType==ScheduleType::OUTER_PRODUCT &&
    kFullAK128.cfg.iterateOrder==IterateOrder::ORDER_N,
    "M254 preserves original FullA M-oriented complete-K policy");
static_assert(kFullAK128.baseM==64 && kFullAK128.baseN==256 && kFullAK128.baseK==128 &&
    kFullAK128.singleCoreM==128 && kFullAK128.singleCoreN==256 && kFullAK128.singleCoreK==2048,
    "M254 actual constexpr tiling must use K128, not the original K256 table");
static_assert(kFullAK128.stepM==2 && kFullAK128.stepN==1 &&
    kFullAK128.stepKa==1 && kFullAK128.stepKb==2 &&
    kFullAK128.depthA1==4 && kFullAK128.depthB1==4,
    "M254 B1 four K128 fragments retain the old K256 double-buffer coverage");
static_assert(kFullAK128.dbL0A==2 && kFullAK128.dbL0B==2 && kFullAK128.dbL0C==1 &&
    2*256*128*sizeof(int8_t)==65536 && 2*64*128*sizeof(int8_t)<=65536,
    "M254 L0B has two real 32768-byte banks; existing L0A fits");
// The SDK quant reserve scales with depthB1: 4*256*8=8192, not the old4096.
static_assert(kFullAK128.shareL1Size==4*256*128*sizeof(int8_t)+4*256*sizeof(uint64_t) &&
    kFullAK128.shareL1Size==139264 && kFullAK128.shareL1Size+128*2048<=524288,
    "M254 B1+quant139264 plus external A262144 =401408 within L1");
static_assert(kFullAK128.shareL0CSize==65536 && 2*64*256*sizeof(int32_t)==131072 &&
    kFullAK128.transLength==65536 && kFullAK128.shareUbSize==0,
    "M254 preserves the two C fragments and original output transfer resources");
static_assert(!AscendC::IsBasicK(kFullAK128) && !AscendC::NoTailK(kFullAK128) &&
    !AscendC::IsBasicM(kFullAK128),"M254 full runtime K and both M fragments retained");
using FullAK128MM=matmul::MatmulImpl<FullAType,BType,CType,BiasType,kFullAK128,
    AscendC::MatmulCallBackFunc<nullptr,nullptr,nullptr>,AscendC::Impl::Detail::GmmPairMdlPolicy>;
// M254_CONFIG_END

// Private P5 unitflag factory: the table, scheduler, output buffer and CopyOut all share this CFG.
static __aicore__ inline constexpr MatmulConfig P5M128UnitFlagConfig(){
 MatmulConfig c=FullAK128Config();c.enUnitFlag=true;return c;
}
static __aicore__ inline constexpr auto P5M128UnitFlagTiling(){
 auto t=AscendC::GetMatmulApiTiling<FullAType,BType,CType,BiasType,
  MatmulPairShape<128,256,2048>,M254L1Shape,MatmulPairShape<64,256,128>>(P5M128UnitFlagConfig());
 t.dbL0A=2;t.dbL0B=2;t.dbL0C=1;t.shareL0CSize=64*256*sizeof(int32_t);return t;
}
constexpr auto kP5M128UnitFlag=P5M128UnitFlagTiling();
static_assert(kP5M128UnitFlag.cfg.enUnitFlag && kP5M128UnitFlag.cfg.doMultiDataLoad &&
 !kP5M128UnitFlag.cfg.doNorm && kP5M128UnitFlag.cfg.scheduleType==ScheduleType::OUTER_PRODUCT &&
 kP5M128UnitFlag.cfg.iterateOrder==IterateOrder::ORDER_N,"all SDK modules use the private unitflag CFG");
static_assert(kP5M128UnitFlag.singleCoreM==128 && kP5M128UnitFlag.singleCoreN==256 && kP5M128UnitFlag.singleCoreK==2048 &&
 kP5M128UnitFlag.baseM==64 && kP5M128UnitFlag.baseN==256 && kP5M128UnitFlag.baseK==128 &&
 kP5M128UnitFlag.stepM==2 && kP5M128UnitFlag.stepN==1 && kP5M128UnitFlag.stepKa==1 && kP5M128UnitFlag.stepKb==2 &&
 kP5M128UnitFlag.depthA1==4 && kP5M128UnitFlag.depthB1==4,"exact parent M-pair K128 B2 organization");
static_assert(kP5M128UnitFlag.dbL0A==2 && kP5M128UnitFlag.dbL0B==2 && kP5M128UnitFlag.dbL0C==1 &&
 2*64*128<=65536 && 2*256*128==65536 && 2*64*256*sizeof(int32_t)==131072,"existing two C0 fragments, not two doubled queues");
static_assert(kP5M128UnitFlag.shareL1Size==139264 && 139264+128*2048==401408 && 401408<=524288 &&
 kP5M128UnitFlag.shareL0CSize==65536 && kP5M128UnitFlag.shareUbSize==0 && kP5M128UnitFlag.transLength==65536,
 "all SDK B1+quant and external A live allocations retained; SDK unitflag OUTER TBuf allocates two base-M fragments");
static_assert(!AscendC::NoTailK(kP5M128UnitFlag) && !AscendC::IsBasicK(kP5M128UnitFlag) &&
 !AscendC::IsBasicM(kP5M128UnitFlag),"complete K and both M fragments retained");
using P5M128UnitFlagMM=matmul::MatmulImpl<FullAType,BType,CType,BiasType,kP5M128UnitFlag,
 AscendC::MatmulCallBackFunc<nullptr,nullptr,nullptr>,AscendC::Impl::Detail::GmmPairMdlPolicy>;


struct FullAThreeBundleJob { uint32_t expert,row,col,outputs; };
template<class GroupTensor>
class FullAThreeBundleJobIterator {
public:
 __aicore__ inline FullAThreeBundleJobIterator(const Tiling& t,const GroupTensor& g,uint32_t core):t_(t),groups_(g),core_(core){}
 __aicore__ inline bool Next(FullAThreeBundleJob& job){
  const uint32_t nt=(t_.n+255)/256,bundles=(nt+2)/3;
  while(expert_<t_.groups){const uint32_t end=static_cast<uint32_t>(groups_.GetValue(expert_)),blocks=(end-previousEnd_)/128;
   while(blockInGroup_<blocks){while(bundle_<bundles){uint32_t b=bundle_++;uint64_t id=ordinal_++;
    if(id%t_.cores==core_){job={expert_,previousEnd_+blockInGroup_*128,b*3*256,nt-b*3<3?nt-b*3:3};return true;}}
    bundle_=0;++blockInGroup_;}
   blockInGroup_=0;previousEnd_=end;++expert_;}
  return false;
 }
private:const Tiling& t_;const GroupTensor& groups_;uint32_t core_,expert_=0,previousEnd_=0,blockInGroup_=0,bundle_=0;uint64_t ordinal_=0;
};
// M255_THREEN_JOB_END


