    kBFullKBundle.shareL1Size == 471040 && kBFullKBundle.shareL1Size <= 524288 &&
    kBFullKBundle.shareL0CSize == 65536 && 2 * 64 * 256 * sizeof(int32_t) == 131072,
    "M173 A1/B1/quant L1 and original two-fragment CO1 reservation");
static_assert(!AscendC::NoTailM(kBFullKBundle) && !AscendC::NoTailN(kBFullKBundle) &&
    !AscendC::NoTailK(kBFullKBundle) && !AscendC::IsBasicK(kBFullKBundle) &&
    !AscendC::IsBasicM(kBFullKBundle), "M173 complete runtime tails and K reduction");
