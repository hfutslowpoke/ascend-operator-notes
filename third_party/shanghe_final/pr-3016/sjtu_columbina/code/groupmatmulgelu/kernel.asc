// INCLUDING BUT NOT LIMITED TO NON-INFRINGEMENT, MERCHANTABILITY, OR FITNESS FOR A PARTICULAR PURPOSE.
// See LICENSE in the root of the software repository for the full text of the License.
template<uint32_t RawN = 128>
class RawAicProducer {
    static_assert(RawN == 32 || RawN == 128, "raw INT8 physical N descriptor");
public:
    __aicore__ inline RawAicProducer(AscendC::TPipe& pipe, const Tiling& t,
        uint32_t xRowStride=0, uint32_t wRowStride=0)
        : pipe_(pipe), t_(t), xRowStride_(xRowStride?xRowStride:t.k),
          wRowStride_(wRowStride?wRowStride:t.n) {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR weight,
        GM_ADDR groups, GM_ADDR workspace)
    {
        x_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
        w_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(weight));
        groups_.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups));
        c_.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(workspace));
        core_ = AscendC::GetBlockIdx();
        // Two physical A/B buffers at L1 and L0; one full-K accumulator.
        // Queues own forward readiness and per-buffer reverse reuse events.
        pipe_.InitBuffer(inQA1_, 2, 64 * 256 * sizeof(int8_t));
        pipe_.InitBuffer(inQB1_, 2, 256 * RawN * sizeof(int8_t));
        pipe_.InitBuffer(inQA2_, 2, 64 * 256 * sizeof(int8_t));
        pipe_.InitBuffer(inQB2_, 2, 256 * RawN * sizeof(int8_t));
        pipe_.InitBuffer(outQC_, 1, 64 * RawN * sizeof(int32_t));
    }

    __aicore__ inline void Process()
    {
        uint32_t previousEnd = 0;
        uint32_t taskBase = 0;
        const uint32_t nTiles = CeilDiv(t_.n, t_.tileN);
        for (uint32_t e = 0; e < t_.groups; ++e) {
            const uint32_t end = static_cast<uint32_t>(groups_.GetValue(e));
            const uint32_t rows = end - previousEnd;
            const uint32_t tasks = CeilDiv(rows, t_.tileM) * nTiles;
            // Identical task order to the unchanged AIV Kernel.
            uint32_t task = (core_ + t_.cores - taskBase) % t_.cores;
            for (; task < tasks; task += t_.cores) {
                const uint32_t row = (task / nTiles) * t_.tileM;
                const uint32_t col = (task % nTiles) * t_.tileN;
                const uint32_t curM = Min(t_.tileM, rows - row);
                const uint32_t curN = Min(t_.tileN, t_.n - col);
                Compute(e, previousEnd + row, col, curM, curN);
            }
            taskBase = (taskBase + tasks) % t_.cores;
            previousEnd = end;
        }
        // Drain the same two GM slots, including a zero-row AIV participant.
        const uint32_t pending = Min(tileCount_, kSlots);
        for (uint32_t i = 0; i < pending; ++i) {
            const uint32_t slotIdx = (tileCount_ - pending + i) % kSlots;
            AscendC::CrossCoreWaitFlag(kFree + slotIdx);
        }
    }

private:
    __aicore__ inline void Compute(uint32_t e, uint32_t row, uint32_t col,
        uint32_t curM, uint32_t curN)
    {
        const uint32_t slotIdx = tileCount_ % kSlots;
        const uint64_t slot = (static_cast<uint64_t>(core_) * kSlots + slotIdx)
            * t_.tileM * t_.tileN;
        if (tileCount_ >= kSlots) {
            AscendC::CrossCoreWaitFlag(kFree + slotIdx);
        }
        // Hold one INT32 accumulator for the complete K reduction.
        LocalTensor<int32_t> c0 = outQC_.AllocTensor<int32_t>();
        const uint32_t kTiles = CeilDiv(t_.k, 256);
        // Prologue: exactly one K fragment. K is positive by the contract.
        PrepareK(e, row, col, curM, curN, 0);
        for (uint32_t ki = 0; ki < kTiles; ++ki) {
            // Keep at most current and next in each depth-two L0 queue.
            // Physical buffers rotate across K fragments and output tiles.
            if (ki + 1 < kTiles) {
                PrepareK(e, row, col, curM, curN, (ki + 1) * 256);
            }
            ConsumeK(c0, ki == 0);
        }
        // Queue transfer supplies M_FIX only after the final accumulation.
        outQC_.EnQue(c0);
        c0 = outQC_.DeQue<int32_t>();
        AscendC::FixpipeParamsV220 fp;
        fp.nSize = static_cast<uint16_t>(curN);
        fp.mSize = static_cast<uint16_t>(curM);
        fp.srcStride = 64;
        fp.dstStride = curN;
        fp.ndNum = 1;
        fp.srcNdStride = 0;
        fp.dstNdStride = 0;
        fp.quantPre = ::QuantMode_t::NoQuant;
        fp.deqScalar = 0;
        fp.reluEn = false;
        fp.unitFlag = 0;
        fp.isChannelSplit = false;
        // Default CFG_ROW_MAJOR: one compact curM x curN INT32 result.
        AscendC::Fixpipe(c_[slot], c0, fp);
        AscendC::CrossCoreSetFlag<2, PIPE_FIX>(kReady + slotIdx);
        // FIX_M protects L0C reuse; the separate GM Free protects the slot.
        outQC_.FreeTensor(c0);
        ++tileCount_;
    }

    __aicore__ inline void PrepareK(uint32_t e, uint32_t row, uint32_t col,
        uint32_t curM, uint32_t curN, uint32_t k0)
    {
        const uint32_t curK = Min(256, t_.k - k0);
        LocalTensor<int8_t> a1 = inQA1_.AllocTensor<int8_t>();
        LocalTensor<int8_t> b1 = inQB1_.AllocTensor<int8_t>();
        // A3 InitConstValue supports uint16_t on L1. A zero uint16_t
        // view clears the complete INT8 allocation without conversion.
        // blockNum is in 32-byte blocks. Height/K padding is explicit;
        // ND2NZ alone only guarantees padding of the copied width.
        auto a1Zero = a1.ReinterpretCast<uint16_t>();
        auto b1Zero = b1.ReinterpretCast<uint16_t>();
        if (!(curM == 64 && curK == 256)) {
            AscendC::InitConstValue(a1Zero,
                AscendC::InitConstValueParams<uint16_t>{1, 512, 0, 0});
        }
        if (!(curN == RawN && curK == 256)) {
            AscendC::InitConstValue(b1Zero,
                AscendC::InitConstValueParams<uint16_t>{1, static_cast<uint16_t>(8 * RawN), 0, 0});
        }
        AscendC::PipeBarrier<PIPE_MTE2>();

        // All GM reads use real tails and real row strides K/N.
        // Fixed physical NZ heights are 64 for A and 256 for B.
        AscendC::Nd2NzParams pa{1, static_cast<uint16_t>(curM),
            static_cast<uint16_t>(curK), 0, static_cast<uint16_t>(xRowStride_), 64, 1, 0};
        AscendC::Nd2NzParams pb{1, static_cast<uint16_t>(curK),
            static_cast<uint16_t>(curN), 0, static_cast<uint16_t>(wRowStride_), 256, 1, 0};
        AscendC::DataCopy(a1, x_[static_cast<uint64_t>(row) * xRowStride_ + k0], pa);
        AscendC::DataCopy(b1,
            w_[static_cast<uint64_t>(e) * t_.k * wRowStride_
                + static_cast<uint64_t>(k0) * wRowStride_ + col], pb);
        inQA1_.EnQue(a1);
        inQB1_.EnQue(b1);
        a1 = inQA1_.DeQue<int8_t>();
        b1 = inQB1_.DeQue<int8_t>();

        LocalTensor<int8_t> a2 = inQA2_.AllocTensor<int8_t>();
        LocalTensor<int8_t> b2 = inQB2_.AllocTensor<int8_t>();
        // A: NZ -> ZZ. Offsets below are INT8 elements, not bytes
        // multiplied by an additional fractal size.
        AscendC::LoadData2DParams la;
        la.startIndex = 0;
        la.repeatTimes = 8;
        la.srcStride = 4;
        la.dstGap = 0;
        la.ifTranspose = false;
        for (uint32_t i = 0; i < 4; ++i) {
            AscendC::LoadData(a2[i * 4096], a1[i * 512], la);
        }
        // INT8 NN B requires the sample's SplitBTranspose path.
        AscendC::LoadData2dTransposeParams lb;
        lb.startIndex = 0;
        // Official SplitBTranspose: dstOffset=ceil(N/32)*1024;
        // srcOffset=1024, srcStride=ceil(K256/32)=8, eight K blocks.
        lb.repeatTimes = RawN / 32;
        lb.srcStride = 8;
        lb.dstGap = 1;
        lb.dstFracGap = 0;
        for (uint32_t i = 0; i < 8; ++i) {
            AscendC::LoadDataWithTranspose(b2[i * (32 * RawN)], b1[i * 1024], lb);
        }
        inQA2_.EnQue(a2);
        inQB2_.EnQue(b2);
        inQA1_.FreeTensor(a1);
        inQB1_.FreeTensor(b1);
    }

    __aicore__ inline void ConsumeK(LocalTensor<int32_t>& c0, bool firstK)
    {
        LocalTensor<int8_t> a2 = inQA2_.DeQue<int8_t>();
        LocalTensor<int8_t> b2 = inQB2_.DeQue<int8_t>();

        // Fixed m=64 avoids the m=1 GEMV L0A interpretation; fixed
        // RawN is a multiple of the INT8 B-transpose 32-column pitch.
        AscendC::MmadParams mp;
        mp.m = 64;
        mp.n = RawN;
        mp.k = 256;
        mp.cmatrixSource = false;
        mp.cmatrixInitVal = firstK;
        mp.unitFlag = 0;
        AscendC::Mmad(c0, a2, b2, mp);
        inQA2_.FreeTensor(a2);
        inQB2_.FreeTensor(b2);
    }

    AscendC::TPipe& pipe_;
    const Tiling& t_;
    GlobalTensor<int8_t> x_, w_;
    GlobalTensor<int64_t> groups_;
    GlobalTensor<int32_t> c_;
    AscendC::TQue<AscendC::TPosition::A1, 1> inQA1_;
    AscendC::TQue<AscendC::TPosition::B1, 1> inQB1_;
    AscendC::TQue<AscendC::TPosition::A2, 2> inQA2_;
    AscendC::TQue<AscendC::TPosition::B2, 2> inQB2_;
    AscendC::TQue<AscendC::TPosition::CO1, 1> outQC_;
    uint32_t xRowStride_, wRowStride_;
    uint32_t core_ = 0;
    uint32_t tileCount_ = 0;
};
// M19_RAW_END

// S1_PRODUCER_BEGIN: each (output tile, K part) owns a permanent GM slot.
class SplitKAicProducer {
public:
    __aicore__ inline SplitKAicProducer(AscendC::TPipe& pipe, const Tiling& t)
        : pipe_(pipe), t_(t) {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR weight,
        GM_ADDR groups, GM_ADDR workspace)
    {
        x_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
        w_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(weight));
        groups_.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups));
        c_.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(workspace));
        core_ = AscendC::GetBlockIdx();
        // Two physical A/B buffers at L1 and L0; one partial-K accumulator.
        // Queues own forward readiness and per-buffer reverse reuse events.
        pipe_.InitBuffer(inQA1_, 2, 64 * 256 * sizeof(int8_t));
        pipe_.InitBuffer(inQB1_, 2, 256 * 128 * sizeof(int8_t));
        pipe_.InitBuffer(inQA2_, 2, 64 * 256 * sizeof(int8_t));
        pipe_.InitBuffer(inQB2_, 2, 256 * 128 * sizeof(int8_t));
        pipe_.InitBuffer(outQC_, 1, 64 * 128 * sizeof(int32_t));
    }

    __aicore__ inline void Process()
    {
        uint32_t previousEnd = 0;
        uint32_t tileBase = 0;
        const uint32_t nTiles = CeilDiv(t_.n, 128);
        for (uint32_t e = 0; e < t_.groups; ++e) {
            const uint32_t end = static_cast<uint32_t>(groups_.GetValue(e));
            const uint32_t rows = end - previousEnd;
            const uint32_t tiles = CeilDiv(rows, 64) * nTiles;
            const uint32_t tasks = tiles * t_.splitKParts;
            const uint32_t taskBase = static_cast<uint32_t>(
                (static_cast<uint64_t>(tileBase) * t_.splitKParts) % t_.cores);
            uint32_t task = (core_ + t_.cores - taskBase) % t_.cores;
            for (; task < tasks; task += t_.cores) {
                const uint32_t tile = task / t_.splitKParts;
                const uint32_t part = task % t_.splitKParts;
                const uint32_t row = (tile / nTiles) * 64;
                const uint32_t col = (tile % nTiles) * 128;
                const uint64_t slot = ((static_cast<uint64_t>(tileBase) + tile)
                    * t_.splitKParts + part) * 8192;
                Compute(e, previousEnd + row, col, Min(64, rows - row),
                    Min(128, t_.n - col), part, slot);
            }
            tileBase += tiles;
            previousEnd = end;
        }
        // Every local task has consumed/free'd its queues. The unconditional
        // native barrier in the entry drains all pipes before publication.
    }

private:
    __aicore__ inline void Compute(uint32_t e, uint32_t row, uint32_t col,
        uint32_t curM, uint32_t curN, uint32_t part, uint64_t slot)
    {
        const uint32_t kTiles = CeilDiv(t_.k, 256);
        const uint32_t first = part * kTiles / t_.splitKParts;
        const uint32_t last = (part + 1) * kTiles / t_.splitKParts;
        LocalTensor<int32_t> c0 = outQC_.AllocTensor<int32_t>();
        PrepareK(e, row, col, curM, curN, first * 256);
        for (uint32_t ki = first; ki < last; ++ki) {
            if (ki + 1 < last) {
                PrepareK(e, row, col, curM, curN, (ki + 1) * 256);
            }
            ConsumeK(c0, ki == first);
        }
        outQC_.EnQue(c0);
        c0 = outQC_.DeQue<int32_t>();
        AscendC::FixpipeParamsV220 fp;
        fp.nSize = static_cast<uint16_t>(curN);
        fp.mSize = static_cast<uint16_t>(curM);
        fp.srcStride = 64;
        fp.dstStride = curN;
        fp.ndNum = 1;
        fp.srcNdStride = 0;
        fp.dstNdStride = 0;
        fp.quantPre = ::QuantMode_t::NoQuant;
        fp.deqScalar = 0;
        fp.reluEn = false;
        fp.unitFlag = 0;
        fp.isChannelSplit = false;
        AscendC::Fixpipe(c_[slot], c0, fp);
        outQC_.FreeTensor(c0);
    }

    __aicore__ inline void PrepareK(uint32_t e, uint32_t row, uint32_t col,
        uint32_t curM, uint32_t curN, uint32_t k0)
    {
        const uint32_t curK = Min(256, t_.k - k0);
        LocalTensor<int8_t> a1 = inQA1_.AllocTensor<int8_t>();
        LocalTensor<int8_t> b1 = inQB1_.AllocTensor<int8_t>();
        // A3 InitConstValue supports uint16_t on L1. A zero uint16_t
        // view clears the complete INT8 allocation without conversion.
        // blockNum is in 32-byte blocks. Height/K padding is explicit;
        // ND2NZ alone only guarantees padding of the copied width.
        auto a1Zero = a1.ReinterpretCast<uint16_t>();
        auto b1Zero = b1.ReinterpretCast<uint16_t>();
        if (!(curM == 64 && curK == 256)) {
            AscendC::InitConstValue(a1Zero,
                AscendC::InitConstValueParams<uint16_t>{1, 512, 0, 0});
        }
        if (!(curN == 128 && curK == 256)) {
            AscendC::InitConstValue(b1Zero,
                AscendC::InitConstValueParams<uint16_t>{1, 1024, 0, 0});
        }
        AscendC::PipeBarrier<PIPE_MTE2>();

        // All GM reads use real tails and real row strides K/N.
        // Fixed physical NZ heights are 64 for A and 256 for B.
        AscendC::Nd2NzParams pa{1, static_cast<uint16_t>(curM),
            static_cast<uint16_t>(curK), 0, static_cast<uint16_t>(t_.k), 64, 1, 0};
        AscendC::Nd2NzParams pb{1, static_cast<uint16_t>(curK),
            static_cast<uint16_t>(curN), 0, static_cast<uint16_t>(t_.n), 256, 1, 0};
        AscendC::DataCopy(a1, x_[static_cast<uint64_t>(row) * t_.k + k0], pa);
        AscendC::DataCopy(b1,
            w_[static_cast<uint64_t>(e) * t_.k * t_.n
                + static_cast<uint64_t>(k0) * t_.n + col], pb);
        inQA1_.EnQue(a1);
        inQB1_.EnQue(b1);
        a1 = inQA1_.DeQue<int8_t>();
        b1 = inQB1_.DeQue<int8_t>();

        LocalTensor<int8_t> a2 = inQA2_.AllocTensor<int8_t>();
        LocalTensor<int8_t> b2 = inQB2_.AllocTensor<int8_t>();
        // A: NZ -> ZZ. Offsets below are INT8 elements, not bytes
        // multiplied by an additional fractal size.
        AscendC::LoadData2DParams la;
        la.startIndex = 0;
        la.repeatTimes = 8;
        la.srcStride = 4;
        la.dstGap = 0;
        la.ifTranspose = false;
        for (uint32_t i = 0; i < 4; ++i) {
            AscendC::LoadData(a2[i * 4096], a1[i * 512], la);
        }
        // INT8 NN B requires the sample's SplitBTranspose path.
        AscendC::LoadData2dTransposeParams lb;
        lb.startIndex = 0;
        lb.repeatTimes = 4;
        lb.srcStride = 8;
        lb.dstGap = 1;
        lb.dstFracGap = 0;
        for (uint32_t i = 0; i < 8; ++i) {
            AscendC::LoadDataWithTranspose(b2[i * 4096], b1[i * 1024], lb);
        }
        inQA2_.EnQue(a2);
        inQB2_.EnQue(b2);
        inQA1_.FreeTensor(a1);
        inQB1_.FreeTensor(b1);
    }

    __aicore__ inline void ConsumeK(LocalTensor<int32_t>& c0, bool firstK)
    {
        LocalTensor<int8_t> a2 = inQA2_.DeQue<int8_t>();
        LocalTensor<int8_t> b2 = inQB2_.DeQue<int8_t>();

        // Fixed m=64 avoids the m=1 GEMV L0A interpretation; fixed
        // n=128 satisfies the INT8 B-transpose path's 32-column pitch.
        AscendC::MmadParams mp;
        mp.m = 64;
        mp.n = 128;
        mp.k = 256;
        mp.cmatrixSource = false;
        mp.cmatrixInitVal = firstK;
        mp.unitFlag = 0;
        AscendC::Mmad(c0, a2, b2, mp);
        inQA2_.FreeTensor(a2);
        inQB2_.FreeTensor(b2);
    }

    AscendC::TPipe& pipe_;
    const Tiling& t_;
    GlobalTensor<int8_t> x_, w_;
    GlobalTensor<int64_t> groups_;
    GlobalTensor<int32_t> c_;
    AscendC::TQue<AscendC::TPosition::A1, 1> inQA1_;
    AscendC::TQue<AscendC::TPosition::B1, 1> inQB1_;
    AscendC::TQue<AscendC::TPosition::A2, 2> inQA2_;
    AscendC::TQue<AscendC::TPosition::B2, 2> inQB2_;
    AscendC::TQue<AscendC::TPosition::CO1, 1> outQC_;
    uint32_t core_ = 0;
};
// S1_PRODUCER_END

// S1_REDUCER_BEGIN: called only after the single all-worker native barrier.
class SplitKReducer {
public:
    __aicore__ inline SplitKReducer(AscendC::TPipe& pipe, const Tiling& t)
        : pipe_(pipe), t_(t) {}
    __aicore__ inline void Init(GM_ADDR scale, GM_ADDR groups, GM_ADDR y, GM_ADDR workspace)
    {
        scale_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scale));
        groups_.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups));
        y_.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y));
        c_.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(workspace));
        worker_ = AscendC::GetBlockIdx();
        workers_ = t_.cores * AscendC::GetTaskRation();
        pipe_.InitBuffer(inQ_, 1, kBatchElems * sizeof(int32_t));
        pipe_.InitBuffer(scaleQ_, 1, kMaxN * sizeof(float));
        pipe_.InitBuffer(outQ_, 1, kBatchElems * sizeof(half));
        pipe_.InitBuffer(tmp_, 4 * kBatchElems * sizeof(float));
        pipe_.InitBuffer(masks_, kMaskBytes);
    }
    __aicore__ inline void Process()
    {
        uint32_t previousEnd = 0;
        uint64_t tileOrdinal = 0;
        uint64_t batchOrdinal = 0;
        const uint32_t nTiles = CeilDiv(t_.n, 128);
        for (uint32_t e = 0; e < t_.groups; ++e) {
            const uint32_t end = static_cast<uint32_t>(groups_.GetValue(e));
            const uint32_t rows = end - previousEnd;
            const uint32_t mTiles = CeilDiv(rows, 64);
            for (uint32_t mt = 0; mt < mTiles; ++mt) {
                const uint32_t row = mt * 64;
                const uint32_t curM = Min(64, rows - row);
                for (uint32_t nt = 0; nt < nTiles; ++nt) {
                    const uint32_t col = nt * 128;
                    const uint32_t curN = Min(128, t_.n - col);
                    for (uint32_t r = 0; r < curM; r += kBatchRows) {
                        if (batchOrdinal % workers_ == worker_) {
                            ReduceBatch(e, previousEnd + row, col,
                                Min(kBatchRows, curM - r), curN, tileOrdinal, r);
                        }
                        ++batchOrdinal;
                    }
                    ++tileOrdinal;
                }
            }
            previousEnd = end;
        }
    }
private:
    __aicore__ inline void ReduceBatch(uint32_t e, uint32_t row, uint32_t col,
        uint32_t rows, uint32_t curN, uint64_t tileOrdinal, uint32_t r)
    {
        const uint32_t dataN = CeilDiv(curN, 8) * 8;
        const uint32_t rowN = CeilDiv(curN, 16) * 16;
        LocalTensor<float> sc = scaleQ_.AllocTensor<float>();
        AscendC::DataCopyExtParams p{1, static_cast<uint32_t>(curN * sizeof(float)), 0, 0, 0};
        AscendC::DataCopyPadExtParams<float> pad{true, 0, static_cast<uint8_t>(dataN - curN), 0};
        AscendC::DataCopyPad(sc, scale_[static_cast<uint64_t>(e) * t_.n + col], p, pad);
        scaleQ_.EnQue(sc);
        sc = scaleQ_.DeQue<float>();
        LocalTensor<float> z = tmp_.GetWithOffset<float>(kBatchElems, 0);
        LocalTensor<float> out = tmp_.GetWithOffset<float>(kBatchElems, kBatchElems * sizeof(float));
        LocalTensor<float> s0 = tmp_.GetWithOffset<float>(kBatchElems, 2 * kBatchElems * sizeof(float));
        LocalTensor<float> s1 = tmp_.GetWithOffset<float>(kBatchElems, 3 * kBatchElems * sizeof(float));
        auto signMask = masks_.GetWithOffset<uint8_t>(kMaskBytes, 0);
        {
            const uint32_t used = rows * rowN;
            const uint32_t count = CeilDiv(used, 64) * 64;
            // s1 is integer-only until the complete reduction is cast to z.
            LocalTensor<int32_t> accum = s1.ReinterpretCast<int32_t>();
            AscendC::Duplicate(accum, static_cast<int32_t>(0), count);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::BinaryRepeatParams addRep{1, 1, 1,
                static_cast<uint8_t>(rowN / 8), static_cast<uint8_t>(rowN / 8),
                static_cast<uint8_t>(rowN / 8)};
            for (uint32_t part = 0; part < t_.splitKParts; ++part) {
                const uint64_t slot = (tileOrdinal * t_.splitKParts + part) * 8192;
                LocalTensor<int32_t> ci = inQ_.AllocTensor<int32_t>();
                AscendC::DataCopyExtParams cp{static_cast<uint16_t>(rows),
                    static_cast<uint32_t>(curN * sizeof(int32_t)), 0, (rowN - dataN) / 8, 0};
                AscendC::DataCopyPadExtParams<int32_t> cpad{true, 0,
                    static_cast<uint8_t>(dataN - curN), 0};
                AscendC::DataCopyPad(ci, c_[slot + static_cast<uint64_t>(r) * curN], cp, cpad);
                inQ_.EnQue(ci);
                ci = inQ_.DeQue<int32_t>();
                // ci row gaps are not initialized by DataCopyPad. Only dataN
                // lanes per physical row participate, never a blind count Add.
                for (uint32_t c = 0; c < dataN; c += 64) {
                    const uint64_t mask = Min(64, dataN - c);
                    AscendC::Add(accum[c], accum[c], ci[c], mask,
                        static_cast<uint8_t>(rows), addRep);
                }
                AscendC::PipeBarrier<PIPE_V>();
                inQ_.FreeTensor(ci);
            }
            // Explicit zeroes cover each physical row gap and the Compare
            // tail. Only actual/padded dataN columns are read from ci/sc.
            AscendC::Duplicate(z, 0.0f, count);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::UnaryRepeatParams castRep{1, 1,
                static_cast<uint8_t>(rowN / 8), static_cast<uint8_t>(rowN / 8)};
            AscendC::BinaryRepeatParams mulRep{1, 1, 1,
                static_cast<uint8_t>(rowN / 8), static_cast<uint8_t>(rowN / 8), 0};
            for (uint32_t c = 0; c < dataN; c += 64) {
                const uint64_t mask = Min(64, dataN - c);
                AscendC::Cast(z[c], accum[c], AscendC::RoundMode::CAST_NONE,
                    mask, static_cast<uint8_t>(rows), castRep);
            }
            AscendC::PipeBarrier<PIPE_V>();
            for (uint32_t c = 0; c < dataN; c += 64) {
                const uint64_t mask = Min(64, dataN - c);
                AscendC::Mul(z[c], z[c], sc[c], mask, static_cast<uint8_t>(rows), mulRep);
            }
            AscendC::PipeBarrier<PIPE_V>();
            ApplyGeluSimple(out, z, s0, s1, signMask, count);
            LocalTensor<half> yo = outQ_.AllocTensor<half>();
            AscendC::Cast(yo, out, AscendC::RoundMode::CAST_RINT, count);
            AscendC::PipeBarrier<PIPE_V>();
            outQ_.EnQue(yo);
            yo = outQ_.DeQue<half>();
            AscendC::DataCopyExtParams yp{static_cast<uint16_t>(rows),
                static_cast<uint32_t>(curN * sizeof(half)), 0,
                static_cast<uint32_t>((t_.n - curN) * sizeof(half)), 0};
            AscendC::DataCopyPad(y_[static_cast<uint64_t>(row + r) * t_.n + col], yo, yp);
            outQ_.FreeTensor(yo);
        }
        scaleQ_.FreeTensor(sc);
    }
    AscendC::TPipe& pipe_;
    const Tiling& t_;
    GlobalTensor<float> scale_;
    GlobalTensor<int64_t> groups_;
    GlobalTensor<int32_t> c_;
    GlobalTensor<half> y_;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQ_, scaleQ_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQ_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tmp_, masks_;
    uint32_t worker_ = 0;
    uint32_t workers_ = 0;
};
// S1_REDUCER_END

class WideSplitKAicProducer {
public:
    __aicore__ inline WideSplitKAicProducer(AscendC::TPipe& pipe, const Tiling& t)
        : pipe_(pipe), t_(t) {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR weight,
        GM_ADDR groups, GM_ADDR workspace)
    {
        x_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
        w_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(weight));
        groups_.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups));
        c_.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(workspace));
        core_ = AscendC::GetBlockIdx();
        // Two physical A/B buffers at L1 and L0; one partial-K accumulator.
        // Queues own forward readiness and per-buffer reverse reuse events.
        pipe_.InitBuffer(inQA1_, 2, 128 * 256 * sizeof(int8_t));
        pipe_.InitBuffer(inQB1_, 2, 256 * 128 * sizeof(int8_t));
        pipe_.InitBuffer(inQA2_, 2, 128 * 256 * sizeof(int8_t));
        pipe_.InitBuffer(inQB2_, 2, 256 * 128 * sizeof(int8_t));
        pipe_.InitBuffer(outQC_, 1, 128 * 128 * sizeof(int32_t));
    }

    __aicore__ inline void Process()
    {
        uint32_t previousEnd = 0;
        uint32_t tileBase = 0;
        const uint32_t nTiles = CeilDiv(t_.n, 128);
        for (uint32_t e = 0; e < t_.groups; ++e) {
            const uint32_t end = static_cast<uint32_t>(groups_.GetValue(e));
            const uint32_t rows = end - previousEnd;
            const uint32_t tiles = CeilDiv(rows, 128) * nTiles;
            const uint32_t tasks = tiles * t_.splitKParts;
            const uint32_t taskBase = static_cast<uint32_t>(
                (static_cast<uint64_t>(tileBase) * t_.splitKParts) % t_.cores);
            uint32_t task = (core_ + t_.cores - taskBase) % t_.cores;
            for (; task < tasks; task += t_.cores) {
                const uint32_t tile = task / t_.splitKParts;
                const uint32_t part = task % t_.splitKParts;
                const uint32_t row = (tile / nTiles) * 128;
                const uint32_t col = (tile % nTiles) * 128;
                const uint64_t slot = ((static_cast<uint64_t>(tileBase) + tile)
                    * t_.splitKParts + part) * 16384;
                Compute(e, previousEnd + row, col, Min(128, rows - row),
                    Min(128, t_.n - col), part, slot);
            }
            tileBase += tiles;
            previousEnd = end;
        }
        // Every local task has consumed/free'd its queues. The unconditional
        // native barrier in the entry drains all pipes before publication.
    }

private:
    __aicore__ inline void Compute(uint32_t e, uint32_t row, uint32_t col,
        uint32_t curM, uint32_t curN, uint32_t part, uint64_t slot)
    {
        const uint32_t kTiles = CeilDiv(t_.k, 256);
        const uint32_t first = part * kTiles / t_.splitKParts;
        const uint32_t last = (part + 1) * kTiles / t_.splitKParts;
        LocalTensor<int32_t> c0 = outQC_.AllocTensor<int32_t>();
        PrepareK(e, row, col, curM, curN, first * 256);
        for (uint32_t ki = first; ki < last; ++ki) {
            if (ki + 1 < last) {
                PrepareK(e, row, col, curM, curN, (ki + 1) * 256);
            }
            ConsumeK(c0, ki == first);
        }
        outQC_.EnQue(c0);
        c0 = outQC_.DeQue<int32_t>();
        AscendC::FixpipeParamsV220 fp;
        fp.nSize = static_cast<uint16_t>(curN);
        fp.mSize = static_cast<uint16_t>(curM);
        fp.srcStride = 128;
        fp.dstStride = curN;
        fp.ndNum = 1;
        fp.srcNdStride = 0;
        fp.dstNdStride = 0;
        fp.quantPre = ::QuantMode_t::NoQuant;
        fp.deqScalar = 0;
        fp.reluEn = false;
        fp.unitFlag = 0;
        fp.isChannelSplit = false;
        AscendC::Fixpipe(c_[slot], c0, fp);
        outQC_.FreeTensor(c0);
    }

    __aicore__ inline void PrepareK(uint32_t e, uint32_t row, uint32_t col,
        uint32_t curM, uint32_t curN, uint32_t k0)
    {
        const uint32_t curK = Min(256, t_.k - k0);
        LocalTensor<int8_t> a1 = inQA1_.AllocTensor<int8_t>();
        LocalTensor<int8_t> b1 = inQB1_.AllocTensor<int8_t>();
        // A3 InitConstValue supports uint16_t on L1. A zero uint16_t
        // view clears the complete INT8 allocation without conversion.
        // blockNum is in 32-byte blocks. Height/K padding is explicit;
        // ND2NZ alone only guarantees padding of the copied width.
        auto a1Zero = a1.ReinterpretCast<uint16_t>();
        auto b1Zero = b1.ReinterpretCast<uint16_t>();
        if (!(curM == 128 && curK == 256)) {
            AscendC::InitConstValue(a1Zero,
                AscendC::InitConstValueParams<uint16_t>{1, 1024, 0, 0});
        }
        if (!(curN == 128 && curK == 256)) {
            AscendC::InitConstValue(b1Zero,
                AscendC::InitConstValueParams<uint16_t>{1, 1024, 0, 0});
        }
        AscendC::PipeBarrier<PIPE_MTE2>();

        // All GM reads use real tails and real row strides K/N.
        // Fixed physical NZ heights are 128 for A and 256 for B.
        AscendC::Nd2NzParams pa{1, static_cast<uint16_t>(curM),
            static_cast<uint16_t>(curK), 0, static_cast<uint16_t>(t_.k), 128, 1, 0};
        AscendC::Nd2NzParams pb{1, static_cast<uint16_t>(curK),
            static_cast<uint16_t>(curN), 0, static_cast<uint16_t>(t_.n), 256, 1, 0};
        AscendC::DataCopy(a1, x_[static_cast<uint64_t>(row) * t_.k + k0], pa);
        AscendC::DataCopy(b1,
            w_[static_cast<uint64_t>(e) * t_.k * t_.n
                + static_cast<uint64_t>(k0) * t_.n + col], pb);
        inQA1_.EnQue(a1);
        inQB1_.EnQue(b1);
        a1 = inQA1_.DeQue<int8_t>();
        b1 = inQB1_.DeQue<int8_t>();

        LocalTensor<int8_t> a2 = inQA2_.AllocTensor<int8_t>();
        LocalTensor<int8_t> b2 = inQB2_.AllocTensor<int8_t>();
        // A: NZ -> ZZ. Offsets below are INT8 elements, not bytes
        // multiplied by an additional fractal size.
        AscendC::LoadData2DParams la;
        la.startIndex = 0;
        la.repeatTimes = 8;
        la.srcStride = 8;
        la.dstGap = 0;
        la.ifTranspose = false;
        for (uint32_t i = 0; i < 8; ++i) {
            AscendC::LoadData(a2[i * 4096], a1[i * 512], la);
        }
        // INT8 NN B requires the sample's SplitBTranspose path.
        AscendC::LoadData2dTransposeParams lb;
        lb.startIndex = 0;
        lb.repeatTimes = 4;
        lb.srcStride = 8;
        lb.dstGap = 1;
        lb.dstFracGap = 0;
        for (uint32_t i = 0; i < 8; ++i) {
            AscendC::LoadDataWithTranspose(b2[i * 4096], b1[i * 1024], lb);
        }
        inQA2_.EnQue(a2);
        inQB2_.EnQue(b2);
        inQA1_.FreeTensor(a1);
        inQB1_.FreeTensor(b1);
    }

    __aicore__ inline void ConsumeK(LocalTensor<int32_t>& c0, bool firstK)
    {
        LocalTensor<int8_t> a2 = inQA2_.DeQue<int8_t>();
        LocalTensor<int8_t> b2 = inQB2_.DeQue<int8_t>();

        // Fixed m=128 avoids the m=1 GEMV L0A interpretation; fixed
        // n=128 satisfies the INT8 B-transpose path's 32-column pitch.
        AscendC::MmadParams mp;
        mp.m = 128;
        mp.n = 128;
        mp.k = 256;
        mp.cmatrixSource = false;
        mp.cmatrixInitVal = firstK;
        mp.unitFlag = 0;
        AscendC::Mmad(c0, a2, b2, mp);
        inQA2_.FreeTensor(a2);
        inQB2_.FreeTensor(b2);
    }

    AscendC::TPipe& pipe_;
    const Tiling& t_;
    GlobalTensor<int8_t> x_, w_;
    GlobalTensor<int64_t> groups_;
    GlobalTensor<int32_t> c_;
    AscendC::TQue<AscendC::TPosition::A1, 1> inQA1_;
    AscendC::TQue<AscendC::TPosition::B1, 1> inQB1_;
    AscendC::TQue<AscendC::TPosition::A2, 2> inQA2_;
    AscendC::TQue<AscendC::TPosition::B2, 2> inQB2_;
    AscendC::TQue<AscendC::TPosition::CO1, 1> outQC_;
    uint32_t core_ = 0;
};

class WideSplitKReducer {
public:
    __aicore__ inline WideSplitKReducer(AscendC::TPipe& pipe, const Tiling& t)
        : pipe_(pipe), t_(t) {}
    __aicore__ inline void Init(GM_ADDR scale, GM_ADDR groups, GM_ADDR y, GM_ADDR workspace)
    {
        scale_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scale));
        groups_.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups));
        y_.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y));
        c_.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(workspace));
        worker_ = AscendC::GetBlockIdx();
        workers_ = t_.cores * AscendC::GetTaskRation();
        pipe_.InitBuffer(inQ_, 1, kBatchElems * sizeof(int32_t));
        pipe_.InitBuffer(scaleQ_, 1, kMaxN * sizeof(float));
        pipe_.InitBuffer(outQ_, 1, kBatchElems * sizeof(half));
        pipe_.InitBuffer(tmp_, 4 * kBatchElems * sizeof(float));
        pipe_.InitBuffer(masks_, kMaskBytes);
    }
    __aicore__ inline void Process()
    {
        uint32_t previousEnd = 0;
        uint64_t tileOrdinal = 0;
        uint64_t batchOrdinal = 0;
        const uint32_t nTiles = CeilDiv(t_.n, 128);
        for (uint32_t e = 0; e < t_.groups; ++e) {
            const uint32_t end = static_cast<uint32_t>(groups_.GetValue(e));
            const uint32_t rows = end - previousEnd;
            const uint32_t mTiles = CeilDiv(rows, 128);
            for (uint32_t mt = 0; mt < mTiles; ++mt) {
                const uint32_t row = mt * 128;
                const uint32_t curM = Min(128, rows - row);
                for (uint32_t nt = 0; nt < nTiles; ++nt) {
                    const uint32_t col = nt * 128;
                    const uint32_t curN = Min(128, t_.n - col);
                    for (uint32_t r = 0; r < curM; r += kBatchRows) {
                        if (batchOrdinal % workers_ == worker_) {
                            ReduceBatch(e, previousEnd + row, col,
                                Min(kBatchRows, curM - r), curN, tileOrdinal, r);
                        }
                        ++batchOrdinal;
                    }
                    ++tileOrdinal;
                }
            }
            previousEnd = end;
        }
    }
private:
    __aicore__ inline void ReduceBatch(uint32_t e, uint32_t row, uint32_t col,
        uint32_t rows, uint32_t curN, uint64_t tileOrdinal, uint32_t r)
    {
        const uint32_t dataN = CeilDiv(curN, 8) * 8;
        const uint32_t rowN = CeilDiv(curN, 16) * 16;
        LocalTensor<float> sc = scaleQ_.AllocTensor<float>();
        AscendC::DataCopyExtParams p{1, static_cast<uint32_t>(curN * sizeof(float)), 0, 0, 0};
        AscendC::DataCopyPadExtParams<float> pad{true, 0, static_cast<uint8_t>(dataN - curN), 0};
        AscendC::DataCopyPad(sc, scale_[static_cast<uint64_t>(e) * t_.n + col], p, pad);
        scaleQ_.EnQue(sc);
        sc = scaleQ_.DeQue<float>();
        LocalTensor<float> z = tmp_.GetWithOffset<float>(kBatchElems, 0);
        LocalTensor<float> out = tmp_.GetWithOffset<float>(kBatchElems, kBatchElems * sizeof(float));
        LocalTensor<float> s0 = tmp_.GetWithOffset<float>(kBatchElems, 2 * kBatchElems * sizeof(float));
        LocalTensor<float> s1 = tmp_.GetWithOffset<float>(kBatchElems, 3 * kBatchElems * sizeof(float));
        auto signMask = masks_.GetWithOffset<uint8_t>(kMaskBytes, 0);
        {
            const uint32_t used = rows * rowN;
            const uint32_t count = CeilDiv(used, 64) * 64;
            // s1 is integer-only until the complete reduction is cast to z.
            LocalTensor<int32_t> accum = s1.ReinterpretCast<int32_t>();
            AscendC::Duplicate(accum, static_cast<int32_t>(0), count);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::BinaryRepeatParams addRep{1, 1, 1,
                static_cast<uint8_t>(rowN / 8), static_cast<uint8_t>(rowN / 8),
                static_cast<uint8_t>(rowN / 8)};
            for (uint32_t part = 0; part < t_.splitKParts; ++part) {
                const uint64_t slot = (tileOrdinal * t_.splitKParts + part) * 16384;
                LocalTensor<int32_t> ci = inQ_.AllocTensor<int32_t>();
                AscendC::DataCopyExtParams cp{static_cast<uint16_t>(rows),
                    static_cast<uint32_t>(curN * sizeof(int32_t)), 0, (rowN - dataN) / 8, 0};
                AscendC::DataCopyPadExtParams<int32_t> cpad{true, 0,
                    static_cast<uint8_t>(dataN - curN), 0};
                AscendC::DataCopyPad(ci, c_[slot + static_cast<uint64_t>(r) * curN], cp, cpad);
                inQ_.EnQue(ci);
                ci = inQ_.DeQue<int32_t>();
                // ci row gaps are not initialized by DataCopyPad. Only dataN
                // lanes per physical row participate, never a blind count Add.
                for (uint32_t c = 0; c < dataN; c += 64) {
                    const uint64_t mask = Min(64, dataN - c);
                    AscendC::Add(accum[c], accum[c], ci[c], mask,
                        static_cast<uint8_t>(rows), addRep);
                }
                AscendC::PipeBarrier<PIPE_V>();
                inQ_.FreeTensor(ci);
            }
            // Explicit zeroes cover each physical row gap and the Compare
            // tail. Only actual/padded dataN columns are read from ci/sc.
            AscendC::Duplicate(z, 0.0f, count);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::UnaryRepeatParams castRep{1, 1,
                static_cast<uint8_t>(rowN / 8), static_cast<uint8_t>(rowN / 8)};
            AscendC::BinaryRepeatParams mulRep{1, 1, 1,
                static_cast<uint8_t>(rowN / 8), static_cast<uint8_t>(rowN / 8), 0};
            for (uint32_t c = 0; c < dataN; c += 64) {
                const uint64_t mask = Min(64, dataN - c);
                AscendC::Cast(z[c], accum[c], AscendC::RoundMode::CAST_NONE,
                    mask, static_cast<uint8_t>(rows), castRep);
            }
            AscendC::PipeBarrier<PIPE_V>();
            for (uint32_t c = 0; c < dataN; c += 64) {
                const uint64_t mask = Min(64, dataN - c);
                AscendC::Mul(z[c], z[c], sc[c], mask, static_cast<uint8_t>(rows), mulRep);
            }
            AscendC::PipeBarrier<PIPE_V>();
            ApplyGeluSimple(out, z, s0, s1, signMask, count);
            LocalTensor<half> yo = outQ_.AllocTensor<half>();
            AscendC::Cast(yo, out, AscendC::RoundMode::CAST_RINT, count);
            AscendC::PipeBarrier<PIPE_V>();
            outQ_.EnQue(yo);
            yo = outQ_.DeQue<half>();
            AscendC::DataCopyExtParams yp{static_cast<uint16_t>(rows),
                static_cast<uint32_t>(curN * sizeof(half)), 0,
                static_cast<uint32_t>((t_.n - curN) * sizeof(half)), 0};
            AscendC::DataCopyPad(y_[static_cast<uint64_t>(row + r) * t_.n + col], yo, yp);
            outQ_.FreeTensor(yo);
        }
        scaleQ_.FreeTensor(sc);
    }
    AscendC::TPipe& pipe_;
    const Tiling& t_;
    GlobalTensor<float> scale_;
    GlobalTensor<int64_t> groups_;
    GlobalTensor<int32_t> c_;
    GlobalTensor<half> y_;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQ_, scaleQ_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQ_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tmp_, masks_;
    uint32_t worker_ = 0;
    uint32_t workers_ = 0;
};
// M25_WIDE_BODY_END

static __aicore__ inline void CopyTiling(Tiling& t, GM_ADDR gm)
{
    uint32_t* dst = reinterpret_cast<uint32_t*>(&t);
    auto src = reinterpret_cast<__gm__ uint32_t*>(gm);
    for (uint32_t i = 0; i < sizeof(Tiling) / sizeof(uint32_t); ++i) {
        dst[i] = src[i];
    }
}

// M147_COPY_PARTS_BEGIN
// Preserve the uploaded ABI. Only final Norm1 avoids the unused tail.
static_assert(__builtin_offsetof(Tiling, mm) == 8 * sizeof(uint32_t),
    "M147 original eight-word metadata header");
static_assert(sizeof(Tiling) == 60 * sizeof(uint32_t) &&
    __builtin_offsetof(Tiling, splitKParts) == 58 * sizeof(uint32_t) &&
    __builtin_offsetof(Tiling, splitKTileUpper) == 59 * sizeof(uint32_t),
    "M147 original sixty-word metadata ABI");
static __aicore__ inline void CopyTilingHeader(Tiling& t, GM_ADDR gm)
{
    uint32_t* dst = reinterpret_cast<uint32_t*>(&t);
    auto src = reinterpret_cast<__gm__ uint32_t*>(gm);
    for (uint32_t i = 0; i < 8; ++i) { dst[i] = src[i]; }
}
static __aicore__ inline void CopyTilingTail(Tiling& t, GM_ADDR gm)
{
    uint32_t* dst = reinterpret_cast<uint32_t*>(&t);
    auto src = reinterpret_cast<__gm__ uint32_t*>(gm);
    // Never overwrite a head already updated by ChooseActualGroupPairMode.
    for (uint32_t i = 8; i < 60; ++i) { dst[i] = src[i]; }
}
// M147_COPY_PARTS_END

constexpr uint32_t kDirectStartGo = 0;
constexpr uint32_t kDirectFinalYDone = 7;

static __aicore__ inline bool HasUniform64Groups(const Tiling& t, GM_ADDR groupList)
{
    GlobalTensor<int64_t> boundaries;
    boundaries.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groupList));
    for (uint32_t e = 0; e < t.groups; ++e) {
        if (boundaries.GetValue(e) != static_cast<int64_t>(64) * (e + 1)) {
            return false;
        }
    }
    return true;
}

class Uniform64DirectAicProducer {
public:
    __aicore__ inline Uniform64DirectAicProducer(AscendC::TPipe& pipe, const Tiling& t)
        : pipe_(pipe), t_(t) {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR weight, GM_ADDR workspace)
    {
        x_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
        w_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(weight));
        c_.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(workspace));
        core_ = AscendC::GetBlockIdx();
        // Two physical L1 stages, one enqueued stage per depth-one queue.
        pipe_.InitBuffer(inQA1_, 2, 64 * 256 * sizeof(int8_t));
        pipe_.InitBuffer(inQB1_, 2, 256 * 256 * sizeof(int8_t));
        // N256/K256 consumes a whole 64KiB L0B: never allocate two B2s.
        pipe_.InitBuffer(inQA2_, 1, 64 * 256 * sizeof(int8_t));
        pipe_.InitBuffer(inQB2_, 1, 256 * 256 * sizeof(int8_t));
        pipe_.InitBuffer(outQC_, 2, 64 * 256 * sizeof(int32_t));
    }

    __aicore__ inline void Process()
    {
        const uint32_t nTiles = t_.n / 256;
        const uint32_t jobs = t_.groups * nTiles;
        // Uniform64: global job=e*nTiles+oldColTile. This is the same
        // core congruence and ordinal as Resident's expert/taskBase traversal.
        for (uint32_t job = core_; job < jobs; job += t_.cores) {
            const uint32_t e = job / nTiles;
            const uint32_t colTile = ColumnTileOrder(e, 0, job % nTiles, nTiles);
            Compute(e, e * 64, colTile * 256);
        }
        const uint32_t pending = Min(tileCount_, kSlots);
        for (uint32_t i = 0; i < pending; ++i) {
            const uint32_t slotIdx = (tileCount_ - pending + i) % kSlots;
            AscendC::CrossCoreWaitFlag(kFree + slotIdx);
        }
    }

private:
    __aicore__ inline void Compute(uint32_t e, uint32_t row, uint32_t col)
    {
        const uint32_t slotIdx = tileCount_ % kSlots;
        const uint64_t slot = (static_cast<uint64_t>(core_) * kSlots + slotIdx)
            * 64 * 256;
        if (tileCount_ >= kSlots) {
            AscendC::CrossCoreWaitFlag(kFree + slotIdx);
        }
        LocalTensor<int32_t> c0 = outQC_.AllocTensor<int32_t>();
        PrepareL1(e, row, col, 0);
        for (uint32_t k0 = 0; k0 < t_.k; k0 += 256) {
            const uint32_t curK = Min(256U, t_.k - k0);
            // DeQue CURRENT before preparing NEXT: depth1 never has two
            // un-DeQue'd stages, while the two physical buffers remain live.
            LocalTensor<int8_t> a1 = inQA1_.DeQue<int8_t>();
            LocalTensor<int8_t> b1 = inQB1_.DeQue<int8_t>();
            if (k0 + 256 < t_.k) { PrepareL1(e, row, col, k0 + 256); }
            LoadK(a1, b1, curK);
            ConsumeK(c0, curK, k0 == 0);
        }
        outQC_.EnQue(c0);
        c0 = outQC_.DeQue<int32_t>();
        AscendC::FixpipeParamsV220 fp;
        fp.nSize = 256;
        fp.mSize = 64;
        fp.srcStride = 64;
        fp.dstStride = 256;
        fp.ndNum = 1;
        fp.srcNdStride = 0;
        fp.dstNdStride = 0;
        fp.quantPre = ::QuantMode_t::NoQuant;
        fp.deqScalar = 0;
        fp.reluEn = false;
        fp.unitFlag = 0;
        fp.isChannelSplit = false;
        AscendC::Fixpipe(c_[slot], c0, fp);
        AscendC::CrossCoreSetFlag<2, PIPE_FIX>(kReady + slotIdx);
        outQC_.FreeTensor(c0); // Per-bank FIX_M protects reuse of each of the two physical C0 buffers.
        ++tileCount_;
    }

    __aicore__ inline void PrepareL1(uint32_t e, uint32_t row, uint32_t col, uint32_t k0)
    {
        const uint32_t curK = Min(256U, t_.k - k0);
        LocalTensor<int8_t> a1 = inQA1_.AllocTensor<int8_t>();
        LocalTensor<int8_t> b1 = inQB1_.AllocTensor<int8_t>();
        // Physical height/width is CURRENT Kc, not a padded K256 layout.
        AscendC::Nd2NzParams pa{1, 64, static_cast<uint16_t>(curK),
            0, static_cast<uint16_t>(t_.k), 64, 1, 0};
        AscendC::Nd2NzParams pb{1, static_cast<uint16_t>(curK), 256,
            0, static_cast<uint16_t>(t_.n), static_cast<uint16_t>(curK), 1, 0};
        AscendC::DataCopy(a1, x_[static_cast<uint64_t>(row) * t_.k + k0], pa);
        AscendC::DataCopy(b1, w_[static_cast<uint64_t>(e) * t_.k * t_.n
            + static_cast<uint64_t>(k0) * t_.n + col], pb);
        inQA1_.EnQue(a1);
        inQB1_.EnQue(b1);
    }

    __aicore__ inline void LoadK(LocalTensor<int8_t>& a1, LocalTensor<int8_t>& b1,
        uint32_t curK)
    {
        LocalTensor<int8_t> a2 = inQA2_.AllocTensor<int8_t>();
        LocalTensor<int8_t> b2 = inQB2_.AllocTensor<int8_t>();
        AscendC::LoadData2DParams la;
        la.startIndex = 0;
        la.repeatTimes = curK / 32;
        la.srcStride = 4;
        la.dstGap = 0;
        la.ifTranspose = false;
        for (uint32_t i = 0; i < 4; ++i) {
            AscendC::LoadData(a2[i * 16 * curK], a1[i * 512], la);
        }
        AscendC::LoadData2dTransposeParams lb;
        lb.startIndex = 0;
        lb.repeatTimes = 8;
        lb.srcStride = curK / 32;
        lb.dstGap = 1;
        lb.dstFracGap = 0;
        for (uint32_t q = 0; q < curK / 32; ++q) {
            AscendC::LoadDataWithTranspose(b2[q * 8192], b1[q * 1024], lb);
        }
        inQA2_.EnQue(a2);
        inQB2_.EnQue(b2);
        inQA1_.FreeTensor(a1); // MTE1_MTE2: current L1 read ends before reuse.
        inQB1_.FreeTensor(b1);
    }

    __aicore__ inline void ConsumeK(LocalTensor<int32_t>& c0, uint32_t curK, bool firstK)
    {
        LocalTensor<int8_t> a2 = inQA2_.DeQue<int8_t>();
        LocalTensor<int8_t> b2 = inQB2_.DeQue<int8_t>();
        AscendC::MmadParams mp;
        mp.m = 64;
        mp.n = 256;
        mp.k = curK;
        mp.cmatrixSource = false;
        mp.cmatrixInitVal = firstK;
        mp.unitFlag = 0;
        AscendC::Mmad(c0, a2, b2, mp);
        inQA2_.FreeTensor(a2); // M_MTE1: only one A2/B2 may be reused.
        inQB2_.FreeTensor(b2);
    }

    AscendC::TPipe& pipe_;
    const Tiling& t_;
    GlobalTensor<int8_t> x_, w_;
    GlobalTensor<int32_t> c_;
    AscendC::TQue<AscendC::TPosition::A1, 1> inQA1_;
    AscendC::TQue<AscendC::TPosition::B1, 1> inQB1_;
    AscendC::TQue<AscendC::TPosition::A2, 1> inQA2_;
    AscendC::TQue<AscendC::TPosition::B2, 1> inQB2_;
    AscendC::TQue<AscendC::TPosition::CO1, 1> outQC_;
    uint32_t core_ = 0;
    uint32_t tileCount_ = 0;
};
// M257_DIRECT_COMPONENTS_END

// HT05_NAMESPACE_BEGIN
class Whole32AliasQ2Consumer {
public:
    __aicore__ inline Whole32AliasQ2Consumer(AscendC::TPipe& pipe, const Tiling& t)
        : pipe_(pipe), t_(t) {}

    __aicore__ inline void Init(GM_ADDR scale, GM_ADDR groups, GM_ADDR y, GM_ADDR workspace)
    {
        scale_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scale));
        groups_.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups));
        groupBytes_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(groups));
        y_.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y));
        c_.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(workspace));
        core_ = AscendC::GetBlockIdx() / AscendC::GetTaskRation();
        sub_ = AscendC::GetSubBlockIdx();
        // C65536 + scale2048 + Y32768 + tmp81920 + mask1024 + groups1024.
        pipe_.InitBuffer(inQ_, 2, kResidentCElems * sizeof(int32_t));
        pipe_.InitBuffer(scaleQ_, 2, kMaxN * sizeof(float));
        pipe_.InitBuffer(outQ_, 2, 8192 * sizeof(half));
        pipe_.InitBuffer(tmp_, 81920);
        pipe_.InitBuffer(masks_, 1024);
        pipe_.InitBuffer(groupCache_, 128 * sizeof(int64_t));
    }

    __aicore__ inline void Process()
    {
        LocalTensor<int64_t> localGroups = groupCache_.Get<int64_t>();
        const uint32_t groupBytes = t_.groups * sizeof(int64_t);
        AscendC::DataCopyExtParams gp{1, groupBytes, 0, 0, 0};
        AscendC::DataCopyPadExtParams<int8_t> gpad{true, 0,
            static_cast<uint8_t>((32 - groupBytes % 32) % 32), 0};
        AscendC::DataCopyPad(localGroups.ReinterpretCast<int8_t>(), groupBytes_, gp, gpad);
        const auto groupReady = pipe_.FetchEventID(AscendC::HardEvent::MTE2_S);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_S>(groupReady);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_S>(groupReady);

        uint32_t previousEnd = 0;
        uint32_t taskBase = 0;
        const uint32_t nTiles = CeilDiv(t_.n, t_.tileN);
        ResidentTile pending{};
        bool havePending = false;
        uint32_t tileCount = 0;
        for (uint32_t e = 0; e < t_.groups; ++e) {
            const uint32_t end = static_cast<uint32_t>(localGroups.GetValue(e));
            const uint32_t rows = end - previousEnd;
            const uint32_t tasks = CeilDiv(rows, t_.tileM) * nTiles;
            uint32_t task = (core_ + t_.cores - taskBase) % t_.cores;
            for (; task < tasks; task += t_.cores) {
                // Same descriptor sequence as the original producer/consumer,
                // including the Norm column permutation and cross-group ordinal.
                const uint32_t row = (task / nTiles) * t_.tileM;
                const uint32_t oldColTile = task % nTiles;
                const uint32_t colTile = t_.reserved == 1 && nTiles > 1
                    ? (oldColTile + e + task / nTiles) % nTiles : oldColTile;
                const uint32_t col = colTile * t_.tileN;
                ResidentTile next{e, previousEnd + row, col,
                    Min(t_.tileM, rows - row), Min(t_.tileN, t_.n - col), tileCount};
                // Submit current Vector/Y work before a possible scalar wait
                // for the next ready. Two physical private stages permit its
                // MTE2 work to overlap commands already submitted for current.
                if (havePending) { Consume(pending); }
                Stage(next);
                pending = next;
                havePending = true;
                ++tileCount;
            }
            taskBase = (taskBase + tasks) % t_.cores;
            previousEnd = end;
        }
        if (havePending) { Consume(pending); }
        // AIC's old final free drain now proves only GM reader completion.
        // This separate local edge waits for ALL actual Y stores before exit.
        const auto outputDone = pipe_.FetchEventID(AscendC::HardEvent::MTE3_S);
        AscendC::SetFlag<AscendC::HardEvent::MTE3_S>(outputDone);
        AscendC::WaitFlag<AscendC::HardEvent::MTE3_S>(outputDone);
    }

private:
    __aicore__ inline void Stage(const ResidentTile& d)
    {
        const uint32_t slotIdx = d.ordinal % kSlots;
        const uint32_t halfRows = CeilDiv(d.curM, 2);
        const uint32_t firstRow = sub_ * halfRows;
        const uint32_t lastRow = Min(firstRow + halfRows, d.curM);
        AscendC::CrossCoreWaitFlag(kReady + slotIdx);
        if (firstRow < lastRow) {
            const uint32_t dataN = CeilDiv(d.curN, 8) * 8;
            const uint32_t rowN = CeilDiv(d.curN, 16) * 16;
            const uint64_t slot = (static_cast<uint64_t>(core_) * kSlots + slotIdx)
                * t_.tileM * t_.tileN;
            LocalTensor<int32_t> ci = inQ_.AllocTensor<int32_t>();
            AscendC::DataCopyExtParams cp{static_cast<uint16_t>(lastRow - firstRow),
                static_cast<uint32_t>(d.curN * sizeof(int32_t)), 0, (rowN - dataN) / 8, 0};
            AscendC::DataCopyPadExtParams<int32_t> cpad{true, 0,
                static_cast<uint8_t>(dataN - d.curN), 0};
            AscendC::DataCopyPad(ci, c_[slot + static_cast<uint64_t>(firstRow) * d.curN], cp, cpad);
            // No later operation reads this GM slot: all owned rows have been
            // copied by the MTE2 stream before its mode2 release can execute.
            AscendC::CrossCoreSetFlag<2, PIPE_MTE2>(kFree + slotIdx);
            inQ_.EnQue(ci);

            LocalTensor<float> sc = scaleQ_.AllocTensor<float>();
            AscendC::DataCopyExtParams p{1, static_cast<uint32_t>(d.curN * sizeof(float)), 0, 0, 0};
            AscendC::DataCopyPadExtParams<float> pad{true, 0,
                static_cast<uint8_t>(dataN - d.curN), 0};
            AscendC::DataCopyPad(sc, scale_[static_cast<uint64_t>(d.e) * t_.n + d.col], p, pad);
            scaleQ_.EnQue(sc);
        } else {
            // The zero-row AIV still consumes ready and releases exactly once.
            AscendC::CrossCoreSetFlag<2, PIPE_MTE2>(kFree + slotIdx);
        }
    }

    __aicore__ inline void Consume(const ResidentTile& d)
    {
        const uint32_t halfRows = CeilDiv(d.curM, 2);
        const uint32_t firstRow = sub_ * halfRows;
        const uint32_t lastRow = Min(firstRow + halfRows, d.curM);
        if (firstRow >= lastRow) { return; }
        const uint32_t dataN = CeilDiv(d.curN, 8) * 8;
        const uint32_t rowN = CeilDiv(d.curN, 16) * 16;
        LocalTensor<int32_t> ci = inQ_.DeQue<int32_t>();
        LocalTensor<float> sc = scaleQ_.DeQue<float>();
        LocalTensor<float> z = tmp_.GetWithOffset<float>(8192, 0);
        LocalTensor<float> out = z;
        LocalTensor<float> s0 = tmp_.GetWithOffset<float>(8192, 8192 * sizeof(float));
        LocalTensor<float> s1 = tmp_.GetWithOffset<float>(4096, 2 * 8192 * sizeof(float));
        auto signMask = masks_.GetWithOffset<uint8_t>(1024, 0);
        for (uint32_t r = firstRow; r < lastRow; r += 32) {
            const uint32_t rows = Min(32, lastRow - r);
            const uint32_t used = rows * rowN;
            const uint32_t count = CeilDiv(used, 64) * 64;
            const uint32_t cOffset = (r - firstRow) * rowN;
            AscendC::Duplicate(z, 0.0f, count);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::UnaryRepeatParams castRep{1, 1,
                static_cast<uint8_t>(rowN / 8), static_cast<uint8_t>(rowN / 8)};
            AscendC::BinaryRepeatParams mulRep{1, 1, 1,
                static_cast<uint8_t>(rowN / 8), static_cast<uint8_t>(rowN / 8), 0};
            for (uint32_t c = 0; c < dataN; c += 64) {
                const uint64_t mask = Min(64, dataN - c);
                AscendC::Cast(z[c], ci[cOffset + c], AscendC::RoundMode::CAST_NONE,
                    mask, static_cast<uint8_t>(rows), castRep);
            }
            AscendC::PipeBarrier<PIPE_V>();
            // V_MTE2 reverse lifetime only after the final private C read.
            if (r + rows == lastRow) { inQ_.FreeTensor(ci); }
            for (uint32_t c = 0; c < dataN; c += 64) {
                const uint64_t mask = Min(64, dataN - c);
                AscendC::Mul(z[c], z[c], sc[c], mask, static_cast<uint8_t>(rows), mulRep);
            }
            AscendC::PipeBarrier<PIPE_V>();
            if (r + rows == lastRow) { scaleQ_.FreeTensor(sc); }
            ApplyGeluSimple(out, z, s0, s1, signMask, count);
            LocalTensor<half> yo = outQ_.AllocTensor<half>();
            AscendC::Cast(yo, out, AscendC::RoundMode::CAST_RINT, count);
            AscendC::PipeBarrier<PIPE_V>();
            outQ_.EnQue(yo);
            yo = outQ_.DeQue<half>();
            AscendC::DataCopyExtParams yp{static_cast<uint16_t>(rows),
                static_cast<uint32_t>(d.curN * sizeof(half)), 0,
                static_cast<uint32_t>((t_.n - d.curN) * sizeof(half)), 0};
            AscendC::DataCopyPad(y_[static_cast<uint64_t>(d.row + r) * t_.n + d.col], yo, yp);
            outQ_.FreeTensor(yo);
        }
    }

    AscendC::TPipe& pipe_;
    const Tiling& t_;
    GlobalTensor<float> scale_;
    GlobalTensor<int64_t> groups_;
    GlobalTensor<int8_t> groupBytes_;
    GlobalTensor<int32_t> c_;
    GlobalTensor<half> y_;
    AscendC::TQue<AscendC::TPosition::VECIN, 2> inQ_, scaleQ_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 2> outQ_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tmp_, masks_, groupCache_;
    uint32_t core_ = 0, sub_ = 0;
};
// HT05_NAMESPACE_END

// HT06_NAMESPACE_BEGIN
constexpr uint32_t HT01A32Q1Rows=32;
constexpr uint32_t kWholeShare32Elems=32*256;
constexpr uint32_t kWholeShare32Mask=32*256/8;
class WholeShare32Q1Consumer {
public:
    __aicore__ inline WholeShare32Q1Consumer(AscendC::TPipe& pipe, const Tiling& t)
        : pipe_(pipe), t_(t) {}

    __aicore__ inline void Init(GM_ADDR scale, GM_ADDR groups, GM_ADDR y, GM_ADDR workspace)
    {
        scale_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scale));
        groups_.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups));
        groupBytes_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(groups));
        y_.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y));
        c_.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(workspace));
        core_ = AscendC::GetBlockIdx() / AscendC::GetTaskRation();
        sub_ = AscendC::GetSubBlockIdx();
        pipe_.InitBuffer(inQ_, 1, kResidentCElems * sizeof(int32_t));
        pipe_.InitBuffer(scaleQ_, 1, kMaxN * sizeof(float));
        pipe_.InitBuffer(outQ_, 1, kWholeShare32Elems * sizeof(half));
        pipe_.InitBuffer(tmp_, 4 * kWholeShare32Elems * sizeof(float));
        pipe_.InitBuffer(masks_, kWholeShare32Mask);
        pipe_.InitBuffer(groupCache_, 128 * sizeof(int64_t));
    }

    __aicore__ inline void Process()
    {
        LocalTensor<int64_t> localGroups = groupCache_.Get<int64_t>();
        const uint32_t groupBytes = t_.groups * sizeof(int64_t);
        AscendC::DataCopyExtParams gp{1, groupBytes, 0, 0, 0};
        AscendC::DataCopyPadExtParams<int8_t> gpad{true, 0,
            static_cast<uint8_t>((32 - groupBytes % 32) % 32), 0};
        AscendC::DataCopyPad(localGroups.ReinterpretCast<int8_t>(), groupBytes_, gp, gpad);
        const auto groupReady = pipe_.FetchEventID(AscendC::HardEvent::MTE2_S);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_S>(groupReady);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_S>(groupReady);

        uint32_t previousEnd = 0;
        uint32_t taskBase = 0;
        const uint32_t nTiles = CeilDiv(t_.n, t_.tileN);
        ResidentTile pending{};
        bool havePending = false;
        uint32_t tileCount = 0;
        for (uint32_t e = 0; e < t_.groups; ++e) {
            const uint32_t end = static_cast<uint32_t>(localGroups.GetValue(e));
            const uint32_t rows = end - previousEnd;
            const uint32_t tasks = CeilDiv(rows, t_.tileM) * nTiles;
            uint32_t task = (core_ + t_.cores - taskBase) % t_.cores;
            for (; task < tasks; task += t_.cores) {
                // Same descriptor sequence as the original producer/consumer,
                // including the Norm column permutation and cross-group ordinal.
                const uint32_t row = (task / nTiles) * t_.tileM;
                const uint32_t oldColTile = task % nTiles;
                const uint32_t colTile = t_.reserved == 1 && nTiles > 1
                    ? (oldColTile + e + task / nTiles) % nTiles : oldColTile;
                const uint32_t col = colTile * t_.tileN;
                ResidentTile next{e, previousEnd + row, col,
                    Min(t_.tileM, rows - row), Min(t_.tileN, t_.n - col), tileCount};
                // Submit current Vector/Y work before a possible scalar wait
                // for the next ready. Two physical private stages permit its
                // MTE2 work to overlap commands already submitted for current.
                if (havePending) { Consume(pending); }
                Stage(next);
                pending = next;
                havePending = true;
                ++tileCount;
            }
            taskBase = (taskBase + tasks) % t_.cores;
            previousEnd = end;
        }
        if (havePending) { Consume(pending); }
        // AIC's old final free drain now proves only GM reader completion.
        // This separate local edge waits for ALL actual Y stores before exit.
        const auto outputDone = pipe_.FetchEventID(AscendC::HardEvent::MTE3_S);
        AscendC::SetFlag<AscendC::HardEvent::MTE3_S>(outputDone);
        AscendC::WaitFlag<AscendC::HardEvent::MTE3_S>(outputDone);
    }

private:
    __aicore__ inline void Stage(const ResidentTile& d)
    {
        const uint32_t slotIdx = d.ordinal % kSlots;
        const uint32_t halfRows = CeilDiv(d.curM, 2);
        const uint32_t firstRow = sub_ * halfRows;
        const uint32_t lastRow = Min(firstRow + halfRows, d.curM);
        AscendC::CrossCoreWaitFlag(kReady + slotIdx);
        if (firstRow < lastRow) {
            const uint32_t dataN = CeilDiv(d.curN, 8) * 8;
            const uint32_t rowN = CeilDiv(d.curN, 16) * 16;
            const uint64_t slot = (static_cast<uint64_t>(core_) * kSlots + slotIdx)
                * t_.tileM * t_.tileN;
            LocalTensor<int32_t> ci = inQ_.AllocTensor<int32_t>();
            AscendC::DataCopyExtParams cp{static_cast<uint16_t>(lastRow - firstRow),
                static_cast<uint32_t>(d.curN * sizeof(int32_t)), 0, (rowN - dataN) / 8, 0};
            AscendC::DataCopyPadExtParams<int32_t> cpad{true, 0,
                static_cast<uint8_t>(dataN - d.curN), 0};
            AscendC::DataCopyPad(ci, c_[slot + static_cast<uint64_t>(firstRow) * d.curN], cp, cpad);
            // No later operation reads this GM slot: all owned rows have been
            // copied by the MTE2 stream before its mode2 release can execute.
            AscendC::CrossCoreSetFlag<2, PIPE_MTE2>(kFree + slotIdx);
            inQ_.EnQue(ci);

            LocalTensor<float> sc = scaleQ_.AllocTensor<float>();
            AscendC::DataCopyExtParams p{1, static_cast<uint32_t>(d.curN * sizeof(float)), 0, 0, 0};
            AscendC::DataCopyPadExtParams<float> pad{true, 0,
                static_cast<uint8_t>(dataN - d.curN), 0};
            AscendC::DataCopyPad(sc, scale_[static_cast<uint64_t>(d.e) * t_.n + d.col], p, pad);
            scaleQ_.EnQue(sc);
        } else {
            // The zero-row AIV still consumes ready and releases exactly once.
            AscendC::CrossCoreSetFlag<2, PIPE_MTE2>(kFree + slotIdx);
        }
    }

    __aicore__ inline void Consume(const ResidentTile& d)
    {
        const uint32_t halfRows = CeilDiv(d.curM, 2);
        const uint32_t firstRow = sub_ * halfRows;
        const uint32_t lastRow = Min(firstRow + halfRows, d.curM);
        if (firstRow >= lastRow) { return; }
        const uint32_t dataN = CeilDiv(d.curN, 8) * 8;
        const uint32_t rowN = CeilDiv(d.curN, 16) * 16;
        LocalTensor<int32_t> ci = inQ_.DeQue<int32_t>();
        LocalTensor<float> sc = scaleQ_.DeQue<float>();
        LocalTensor<float> z = tmp_.GetWithOffset<float>(kWholeShare32Elems, 0);
        LocalTensor<float> out = tmp_.GetWithOffset<float>(kWholeShare32Elems, kWholeShare32Elems * sizeof(float));
        LocalTensor<float> s0 = tmp_.GetWithOffset<float>(kWholeShare32Elems, 2 * kWholeShare32Elems * sizeof(float));
        LocalTensor<float> s1 = tmp_.GetWithOffset<float>(kWholeShare32Elems, 3 * kWholeShare32Elems * sizeof(float));
        auto signMask = masks_.GetWithOffset<uint8_t>(kWholeShare32Mask, 0);
        for (uint32_t r = firstRow; r < lastRow; r += HT01A32Q1Rows) {
            const uint32_t rows = Min(HT01A32Q1Rows, lastRow - r);
            const uint32_t used = rows * rowN;
            const uint32_t count = CeilDiv(used, 64) * 64;
            const uint32_t cOffset = (r - firstRow) * rowN;
            AscendC::Duplicate(z, 0.0f, count);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::UnaryRepeatParams castRep{1, 1,
                static_cast<uint8_t>(rowN / 8), static_cast<uint8_t>(rowN / 8)};
            AscendC::BinaryRepeatParams mulRep{1, 1, 1,
                static_cast<uint8_t>(rowN / 8), static_cast<uint8_t>(rowN / 8), 0};
            for (uint32_t c = 0; c < dataN; c += 64) {
                const uint64_t mask = Min(64, dataN - c);
                AscendC::Cast(z[c], ci[cOffset + c], AscendC::RoundMode::CAST_NONE,
                    mask, static_cast<uint8_t>(rows), castRep);
            }
            AscendC::PipeBarrier<PIPE_V>();
            // V_MTE2 reverse lifetime only after the final private C read.
            if (r + rows == lastRow) { inQ_.FreeTensor(ci); }
            for (uint32_t c = 0; c < dataN; c += 64) {
                const uint64_t mask = Min(64, dataN - c);
                AscendC::Mul(z[c], z[c], sc[c], mask, static_cast<uint8_t>(rows), mulRep);
            }
            AscendC::PipeBarrier<PIPE_V>();
            if (r + rows == lastRow) { scaleQ_.FreeTensor(sc); }
            ApplyGeluSimple(out, z, s0, s1, signMask, count);
            LocalTensor<half> yo = outQ_.AllocTensor<half>();
            AscendC::Cast(yo, out, AscendC::RoundMode::CAST_RINT, count);
            AscendC::PipeBarrier<PIPE_V>();
            outQ_.EnQue(yo);
            yo = outQ_.DeQue<half>();
            AscendC::DataCopyExtParams yp{static_cast<uint16_t>(rows),
                static_cast<uint32_t>(d.curN * sizeof(half)), 0,
                static_cast<uint32_t>((t_.n - d.curN) * sizeof(half)), 0};
            AscendC::DataCopyPad(y_[static_cast<uint64_t>(d.row + r) * t_.n + d.col], yo, yp);
            outQ_.FreeTensor(yo);
        }
    }

    AscendC::TPipe& pipe_;
    const Tiling& t_;
    GlobalTensor<float> scale_;
    GlobalTensor<int64_t> groups_;
    GlobalTensor<int8_t> groupBytes_;
    GlobalTensor<int32_t> c_;
    GlobalTensor<half> y_;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQ_, scaleQ_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQ_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tmp_, masks_, groupCache_;
    uint32_t core_ = 0, sub_ = 0;
};

// P4_INPUT_LOOKAHEAD_PRIVATE_BEGIN
static_assert(2*kResidentCElems*sizeof(int32_t)+2*kMaxN*sizeof(float)+
    kWholeShare32Elems*sizeof(half)+3*kWholeShare32Elems*sizeof(float)+
    kWholeShare32Mask+128*sizeof(int64_t)==184320 && 184320<=188416,
    "two C/scales plus independent z/out/denominator fit with original Y/mask/groups");
class P4InputLookaheadConsumer {
public:
    __aicore__ inline P4InputLookaheadConsumer(AscendC::TPipe& pipe, const Tiling& t)
        : pipe_(pipe), t_(t) {}

    __aicore__ inline void Init(GM_ADDR scale, GM_ADDR groups, GM_ADDR y, GM_ADDR workspace)
    {
        scale_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scale));
        groups_.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups));
        groupBytes_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(groups));
        y_.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y));
        c_.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(workspace));
        core_ = AscendC::GetBlockIdx() / AscendC::GetTaskRation();
        sub_ = AscendC::GetSubBlockIdx();
        pipe_.InitBuffer(inQ_, 2, kResidentCElems * sizeof(int32_t));
        pipe_.InitBuffer(scaleQ_, 2, kMaxN * sizeof(float));
        pipe_.InitBuffer(outQ_, 1, kWholeShare32Elems * sizeof(half));
        pipe_.InitBuffer(tmp_, 3 * kWholeShare32Elems * sizeof(float));
        pipe_.InitBuffer(masks_, kWholeShare32Mask);
        pipe_.InitBuffer(groupCache_, 128 * sizeof(int64_t));
    }

    __aicore__ inline void Process()
    {
        LocalTensor<int64_t> localGroups = groupCache_.Get<int64_t>();
        const uint32_t groupBytes = t_.groups * sizeof(int64_t);
        AscendC::DataCopyExtParams gp{1, groupBytes, 0, 0, 0};
        AscendC::DataCopyPadExtParams<int8_t> gpad{true, 0,
            static_cast<uint8_t>((32 - groupBytes % 32) % 32), 0};
        AscendC::DataCopyPad(localGroups.ReinterpretCast<int8_t>(), groupBytes_, gp, gpad);
        const auto groupReady = pipe_.FetchEventID(AscendC::HardEvent::MTE2_S);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_S>(groupReady);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_S>(groupReady);

        uint32_t previousEnd = 0;
        uint32_t taskBase = 0;
        const uint32_t nTiles = CeilDiv(t_.n, t_.tileN);
        ResidentTile pending{};
        bool havePending = false;
        uint32_t tileCount = 0;
        for (uint32_t e = 0; e < t_.groups; ++e) {
            const uint32_t end = static_cast<uint32_t>(localGroups.GetValue(e));
            const uint32_t rows = end - previousEnd;
            const uint32_t tasks = CeilDiv(rows, t_.tileM) * nTiles;
            uint32_t task = (core_ + t_.cores - taskBase) % t_.cores;
            for (; task < tasks; task += t_.cores) {
                // Same descriptor sequence as the original producer/consumer,
                // including the Norm column permutation and cross-group ordinal.
                const uint32_t row = (task / nTiles) * t_.tileM;
                const uint32_t oldColTile = task % nTiles;
                const uint32_t colTile = t_.reserved == 1 && nTiles > 1
                    ? (oldColTile + e + task / nTiles) % nTiles : oldColTile;
                const uint32_t col = colTile * t_.tileN;
                ResidentTile next{e, previousEnd + row, col,
                    Min(t_.tileM, rows - row), Min(t_.tileN, t_.n - col), tileCount};
                // Two real input/scale banks hold pending and next concurrently.
                // Stage's original PIPE_MTE2 release frees GM before pending math.
                Stage(next);
                if (havePending) { Consume(pending); }
                pending = next;
                havePending = true;
                ++tileCount;
            }
            taskBase = (taskBase + tasks) % t_.cores;
            previousEnd = end;
        }
        if (havePending) { Consume(pending); }
        // AIC's old final free drain now proves only GM reader completion.
        // This separate local edge waits for ALL actual Y stores before exit.
        const auto outputDone = pipe_.FetchEventID(AscendC::HardEvent::MTE3_S);
        AscendC::SetFlag<AscendC::HardEvent::MTE3_S>(outputDone);
        AscendC::WaitFlag<AscendC::HardEvent::MTE3_S>(outputDone);
    }

private:
    __aicore__ inline void Stage(const ResidentTile& d)
    {
        const uint32_t slotIdx = d.ordinal % kSlots;
        const uint32_t halfRows = CeilDiv(d.curM, 2);
        const uint32_t firstRow = sub_ * halfRows;
        const uint32_t lastRow = Min(firstRow + halfRows, d.curM);
        AscendC::CrossCoreWaitFlag(kReady + slotIdx);
        if (firstRow < lastRow) {
            const uint32_t dataN = CeilDiv(d.curN, 8) * 8;
            const uint32_t rowN = CeilDiv(d.curN, 16) * 16;
            const uint64_t slot = (static_cast<uint64_t>(core_) * kSlots + slotIdx)
                * t_.tileM * t_.tileN;
            LocalTensor<int32_t> ci = inQ_.AllocTensor<int32_t>();
            AscendC::DataCopyExtParams cp{static_cast<uint16_t>(lastRow - firstRow),
                static_cast<uint32_t>(d.curN * sizeof(int32_t)), 0, (rowN - dataN) / 8, 0};
            AscendC::DataCopyPadExtParams<int32_t> cpad{true, 0,
                static_cast<uint8_t>(dataN - d.curN), 0};
            AscendC::DataCopyPad(ci, c_[slot + static_cast<uint64_t>(firstRow) * d.curN], cp, cpad);
            // No later operation reads this GM slot: all owned rows have been
            // copied by the MTE2 stream before its mode2 release can execute.
            AscendC::CrossCoreSetFlag<2, PIPE_MTE2>(kFree + slotIdx);
            inQ_.EnQue(ci);

            LocalTensor<float> sc = scaleQ_.AllocTensor<float>();
            AscendC::DataCopyExtParams p{1, static_cast<uint32_t>(d.curN * sizeof(float)), 0, 0, 0};
            AscendC::DataCopyPadExtParams<float> pad{true, 0,
                static_cast<uint8_t>(dataN - d.curN), 0};
            AscendC::DataCopyPad(sc, scale_[static_cast<uint64_t>(d.e) * t_.n + d.col], p, pad);
            scaleQ_.EnQue(sc);
        } else {
            // The zero-row AIV still consumes ready and releases exactly once.
            AscendC::CrossCoreSetFlag<2, PIPE_MTE2>(kFree + slotIdx);
        }
    }

    __aicore__ inline void Consume(const ResidentTile& d)
    {
        const uint32_t halfRows = CeilDiv(d.curM, 2);
        const uint32_t firstRow = sub_ * halfRows;
        const uint32_t lastRow = Min(firstRow + halfRows, d.curM);
        if (firstRow >= lastRow) { return; }
        const uint32_t dataN = CeilDiv(d.curN, 8) * 8;
        const uint32_t rowN = CeilDiv(d.curN, 16) * 16;
        LocalTensor<int32_t> ci = inQ_.DeQue<int32_t>();
        LocalTensor<float> sc = scaleQ_.DeQue<float>();
        LocalTensor<float> z = tmp_.GetWithOffset<float>(kWholeShare32Elems, 0);
        LocalTensor<float> out = tmp_.GetWithOffset<float>(kWholeShare32Elems, kWholeShare32Elems * sizeof(float));
        LocalTensor<float> s0 = tmp_.GetWithOffset<float>(kWholeShare32Elems, 2 * kWholeShare32Elems * sizeof(float));
        // Frozen original ApplyGeluSimple never reads its s1 argument.
        auto signMask = masks_.GetWithOffset<uint8_t>(kWholeShare32Mask, 0);
        for (uint32_t r = firstRow; r < lastRow; r += HT01A32Q1Rows) {
            const uint32_t rows = Min(HT01A32Q1Rows, lastRow - r);
            const uint32_t used = rows * rowN;
            const uint32_t count = CeilDiv(used, 64) * 64;
            const uint32_t cOffset = (r - firstRow) * rowN;
            AscendC::Duplicate(z, 0.0f, count);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::UnaryRepeatParams castRep{1, 1,
                static_cast<uint8_t>(rowN / 8), static_cast<uint8_t>(rowN / 8)};
            AscendC::BinaryRepeatParams mulRep{1, 1, 1,
                static_cast<uint8_t>(rowN / 8), static_cast<uint8_t>(rowN / 8), 0};
            for (uint32_t c = 0; c < dataN; c += 64) {
                const uint64_t mask = Min(64, dataN - c);
                AscendC::Cast(z[c], ci[cOffset + c], AscendC::RoundMode::CAST_NONE,
                    mask, static_cast<uint8_t>(rows), castRep);
            }
            AscendC::PipeBarrier<PIPE_V>();
            // V_MTE2 reverse lifetime only after the final private C read.
            if (r + rows == lastRow) { inQ_.FreeTensor(ci); }
            for (uint32_t c = 0; c < dataN; c += 64) {
                const uint64_t mask = Min(64, dataN - c);
                AscendC::Mul(z[c], z[c], sc[c], mask, static_cast<uint8_t>(rows), mulRep);
            }
            AscendC::PipeBarrier<PIPE_V>();
            if (r + rows == lastRow) { scaleQ_.FreeTensor(sc); }
            ApplyGeluSimple(out, z, s0, s0, signMask, count);
            LocalTensor<half> yo = outQ_.AllocTensor<half>();
            AscendC::Cast(yo, out, AscendC::RoundMode::CAST_RINT, count);
            AscendC::PipeBarrier<PIPE_V>();
            outQ_.EnQue(yo);
            yo = outQ_.DeQue<half>();
            AscendC::DataCopyExtParams yp{static_cast<uint16_t>(rows),
                static_cast<uint32_t>(d.curN * sizeof(half)), 0,
                static_cast<uint32_t>((t_.n - d.curN) * sizeof(half)), 0};
            AscendC::DataCopyPad(y_[static_cast<uint64_t>(d.row + r) * t_.n + d.col], yo, yp);
            outQ_.FreeTensor(yo);
        }
    }

    AscendC::TPipe& pipe_;
    const Tiling& t_;
    GlobalTensor<float> scale_;
    GlobalTensor<int64_t> groups_;
    GlobalTensor<int8_t> groupBytes_;
    GlobalTensor<int32_t> c_;
    GlobalTensor<half> y_;
    AscendC::TQue<AscendC::TPosition::VECIN, 2> inQ_, scaleQ_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQ_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tmp_, masks_, groupCache_;
    uint32_t core_ = 0, sub_ = 0;
};
// P4_INPUT_LOOKAHEAD_PRIVATE_END

// HT06_NAMESPACE_END

// HT06_NAMESPACE_BEGIN
static __aicore__ inline constexpr MatmulConfig HT08C1Config() {
    MatmulConfig cfg = MdlPairConfig();
    cfg.singleCoreM=128; cfg.singleCoreN=256; cfg.singleCoreK=2048;
    cfg.basicM=64; cfg.basicN=128; cfg.basicK=128;
    cfg.iterateOrder=IterateOrder::ORDER_N; cfg.enUnitFlag=false;
    return cfg;
}
using HT08C1L1Shape=AscendC::Std::tuple<AscendC::Std::integral_constant<int,128>,
    AscendC::Std::integral_constant<int,128>,AscendC::Std::integral_constant<int,128>,
    AscendC::Std::integral_constant<int,256>>;
static __aicore__ inline constexpr auto HT08C1Tiling() {
    auto t=AscendC::GetMatmulApiTiling<FullAType,BType,CType,BiasType,
        MatmulPairShape<128,256,2048>,HT08C1L1Shape,MatmulPairShape<64,128,128>>(HT08C1Config());
    t.dbL0A=2; t.dbL0B=2; t.dbL0C=2;
    t.shareL0CSize=64*128*sizeof(int32_t)*2;
    return t;
}
constexpr auto kHT08C1=HT08C1Tiling();
static_assert(kHT08C1.baseM==64 && kHT08C1.baseN==128 && kHT08C1.baseK==128,
    "HT08 actual K128 compute geometry");
static_assert(kHT08C1.stepM==2 && kHT08C1.stepN==1 &&
    kHT08C1.stepKa==1 && kHT08C1.stepKb==2 &&
    kHT08C1.depthA1==4 && kHT08C1.depthB1==4,
    "HT08 actual new L1 reuse and K pipeline depths");
static_assert(kHT08C1.shareL1Size+128*2048<=524288,
    "HT08 simultaneous private A and SDK L1 fit");
static_assert(2*64*128<=65536 && 2*128*128<=65536 &&
    2*64*128*sizeof(int32_t)*2<=131072,
    "HT08 both input banks and outer two-fragment C0 fit");
static_assert(!AscendC::NoTailK(kHT08C1) && !AscendC::IsBasicK(kHT08C1),
    "HT08 preserves complete runtime K reduction and tails");
using HT08C1MM=matmul::MatmulImpl<FullAType,BType,CType,BiasType,kHT08C1, AscendC::MatmulCallBackFunc<nullptr,nullptr,nullptr>, AscendC::Impl::Detail::GmmPairMdlPolicy>;

// Each legal group is partitioned independently; empty groups emit no jobs.
struct HT08C1Job { uint32_t expert,row,col,curM,curN; };
template<class GroupTensor>
class HT08C1JobIterator {
public:
    __aicore__ inline HT08C1JobIterator(const Tiling& t,const GroupTensor& groups,uint32_t core)
        : t_(t),groups_(groups),core_(core) {}
    __aicore__ inline bool Next(HT08C1Job& job)
    {
        while(expert_<t_.groups) {
            const uint32_t end=static_cast<uint32_t>(groups_.GetValue(expert_));
            const uint32_t rows=end-previousEnd_;
            while(rowInGroup_<rows) {
                while(col_<t_.n) {
                    const uint32_t col=col_;
                    col_+=256;
                    const uint64_t ordinal=ordinal_++;
                    if(ordinal%t_.cores==core_) {
                        job={expert_,previousEnd_+rowInGroup_,col,
                            Min(128U,rows-rowInGroup_),Min(256U,t_.n-col)};
                        return true;
                    }
                }
                col_=0;rowInGroup_+=128;
            }
            rowInGroup_=0;previousEnd_=end;++expert_;
        }
        return false;
    }
private:
    const Tiling& t_;const GroupTensor& groups_;uint32_t core_;
    uint32_t expert_=0,previousEnd_=0,rowInGroup_=0,col_=0;
    uint64_t ordinal_=0;
};
class HT08C1Producer {
public:
    __aicore__ inline HT08C1Producer(HT08C1MM& mm,AscendC::TPipe& pipe,const Tiling& t)
        : mm_(mm),pipe_(pipe),t_(t) {}
    __aicore__ inline void Init(GM_ADDR x,GM_ADDR w,GM_ADDR groups,GM_ADDR workspace)
    {
        x_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
        w_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(w));
        groups_.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups));
        c_.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(workspace));
        core_=AscendC::GetBlockIdx();
        pipe_.InitBuffer(aScm_,1,128*2048*sizeof(int8_t));
        aReadDone_=pipe_.AllocEventID<AscendC::HardEvent::MTE1_MTE2>();
    }
    __aicore__ inline void Process()
    {
        HT08C1JobIterator<GlobalTensor<int64_t>> it(t_,groups_,core_);
        HT08C1Job job;
        while(it.Next(job)) {
            auto a=aScm_.AllocTensor<int8_t>();
            AscendC::Nd2NzParams p{};
            p.ndNum=1;p.nValue=job.curM;p.dValue=t_.k;p.srcDValue=t_.k;
            p.dstNzC0Stride=128;p.dstNzNStride=1;
            AscendC::DataCopy(a,x_[static_cast<uint64_t>(job.row)*t_.k],p);
            aScm_.EnQue(a);a=aScm_.DeQue<int8_t>();
            ProduceTile(job,a);
            // C ready/free never substitutes for the last external-A read edge.
            AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(aReadDone_);
            AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(aReadDone_);
            aScm_.FreeTensor(a);
        }
        const uint32_t pending=Min(tileCount_,kSlots);
        for(uint32_t i=0;i<pending;++i) {
            const uint32_t slotIdx=(tileCount_-pending+i)%kSlots;
            AscendC::CrossCoreWaitFlag(kFree+slotIdx);
        }
        mm_.End();
        pipe_.ReleaseEventID<AscendC::HardEvent::MTE1_MTE2>(aReadDone_);
    }
private:
    __aicore__ inline void ProduceTile(const HT08C1Job& job,const LocalTensor<int8_t>& a)
    {
        const uint32_t slotIdx=tileCount_%kSlots;
        const uint64_t slot=(static_cast<uint64_t>(core_)*kSlots+slotIdx)*128*256;
        if(tileCount_>=kSlots) AscendC::CrossCoreWaitFlag(kFree+slotIdx);
        // A is NZ with fixed macro-M stride; C uses compact curN rows.
        mm_.SetOrgShape(128,t_.n,t_.k,t_.k,job.curN);
        mm_.SetSingleShape(job.curM,job.curN,t_.k);
        mm_.SetTensorA(a);
        mm_.SetTensorB(w_[static_cast<uint64_t>(job.expert)*t_.k*t_.n+job.col]);
        while(mm_.Iterate()) mm_.GetTensorC(c_[slot],0,false);
        // Normal SDK iteration has completed every M/N fragment before publication.
        AscendC::CrossCoreSetFlag<2,PIPE_FIX>(kReady+slotIdx);
        ++tileCount_;
    }
    HT08C1MM& mm_;AscendC::TPipe& pipe_;const Tiling& t_;
    GlobalTensor<int8_t> x_,w_;GlobalTensor<int64_t> groups_;GlobalTensor<int32_t> c_;
    AscendC::TSCM<AscendC::TPosition::GM,1,&kFullAScmConfig> aScm_;
    AscendC::TEventID aReadDone_;
    uint32_t core_=0,tileCount_=0;
};
template<class MMType>
class HT08C1Consumer {
public:
    __aicore__ inline HT08C1Consumer(MMType& mm, AscendC::TPipe& pipe, const Tiling& t)
        : mm_(mm), pipe_(pipe), t_(t) {}
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR weight, GM_ADDR scale,
        GM_ADDR groups, GM_ADDR y, GM_ADDR workspace)
    {
        x_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
        w_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(weight));
        scale_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scale));
        groups_.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups));
        y_.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y));
        c_.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(workspace));
        core_ = AscendC::GetBlockIdx();
        if ASCEND_IS_AIV {
            core_ /= AscendC::GetTaskRation();
            sub_ = AscendC::GetSubBlockIdx();
            // 16 rows, physically padded to 16 columns, allow both INT32
            // input and FP16 output rows to begin on 32-byte boundaries.
            pipe_.InitBuffer(inQ_, 1, kBatchElems * sizeof(int32_t));
            pipe_.InitBuffer(scaleQ_, 1, kMaxN * sizeof(float));
            pipe_.InitBuffer(outQ_, 1, kBatchElems * sizeof(half));
            pipe_.InitBuffer(tmp_, 4 * kBatchElems * sizeof(float));
            pipe_.InitBuffer(masks_, kMaskBytes);
            // Append independent metadata storage; original buffers keep offsets.
            pipe_.InitBuffer(groupCache_, 128 * sizeof(int64_t));
            groupBytes_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(groups));
        }
    }

    __aicore__ inline void Process()
    {
        auto localGroups=groupCache_.Get<int64_t>();
        const uint32_t groupBytes=t_.groups*sizeof(int64_t);
        AscendC::DataCopyExtParams gp{1,groupBytes,0,0,0};
        AscendC::DataCopyPadExtParams<int8_t> pad{true,0,
            static_cast<uint8_t>((32-groupBytes%32)%32),0};
        AscendC::DataCopyPad(localGroups.ReinterpretCast<int8_t>(),groupBytes_,gp,pad);
        const auto groupReady=pipe_.FetchEventID(AscendC::HardEvent::MTE2_S);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_S>(groupReady);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_S>(groupReady);
        HT08C1JobIterator<LocalTensor<int64_t>> it(t_,localGroups,core_);
        HT08C1Job job;
        while(it.Next(job)) {
            const uint32_t slotIdx=tileCount_%kSlots;
            const uint64_t slot=(static_cast<uint64_t>(core_)*kSlots+slotIdx)*128*256;
            AscendC::CrossCoreWaitFlag(kReady+slotIdx);
            Epilogue(job.expert,job.row,job.col,job.curM,job.curN,slot);
            // Both participants release even when one has no rows in a tail.
            AscendC::CrossCoreSetFlag<2,PIPE_MTE3>(kFree+slotIdx);
            ++tileCount_;
        }
    }
private:
    __aicore__ inline void Epilogue(uint32_t e, uint32_t row, uint32_t col,
        uint32_t curM, uint32_t curN, uint64_t slot)
    {
        const uint32_t halfRows = CeilDiv(curM, 2);
        const uint32_t firstRow = sub_ * halfRows;
        const uint32_t lastRow = Min(firstRow + halfRows, curM);
        if (firstRow >= lastRow) { return; }
        const uint32_t dataN = CeilDiv(curN, 8) * 8;
        const uint32_t rowN = CeilDiv(curN, 16) * 16;
        LocalTensor<float> sc = scaleQ_.AllocTensor<float>();
        AscendC::DataCopyExtParams p{1, static_cast<uint32_t>(curN * sizeof(float)), 0, 0, 0};
        AscendC::DataCopyPadExtParams<float> pad{true, 0, static_cast<uint8_t>(dataN - curN), 0};
        AscendC::DataCopyPad(sc, scale_[static_cast<uint64_t>(e) * t_.n + col], p, pad);
        scaleQ_.EnQue(sc);
        sc = scaleQ_.DeQue<float>();
        LocalTensor<float> z = tmp_.GetWithOffset<float>(kBatchElems, 0);
        LocalTensor<float> out = tmp_.GetWithOffset<float>(kBatchElems, kBatchElems * sizeof(float));
        LocalTensor<float> s0 = tmp_.GetWithOffset<float>(kBatchElems, 2 * kBatchElems * sizeof(float));
        LocalTensor<float> s1 = tmp_.GetWithOffset<float>(kBatchElems, 3 * kBatchElems * sizeof(float));
        auto signMask = masks_.GetWithOffset<uint8_t>(kMaskBytes, 0);
        for (uint32_t r = firstRow; r < lastRow; r += kBatchRows) {
            const uint32_t rows = Min(kBatchRows, lastRow - r);
            const uint32_t used = rows * rowN;
            const uint32_t count = CeilDiv(used, 64) * 64;
            LocalTensor<int32_t> ci = inQ_.AllocTensor<int32_t>();
            // Official grouped_matmul DataCopyPad2D pattern: dstStride is
            // in 32-byte blocks; source stride is in bytes. Natural C0 pad
            // extends to dataN, then optional one-block gap reaches rowN.
            AscendC::DataCopyExtParams cp{static_cast<uint16_t>(rows),
                static_cast<uint32_t>(curN * sizeof(int32_t)), 0, (rowN - dataN) / 8, 0};
            AscendC::DataCopyPadExtParams<int32_t> cpad{true, 0,
                static_cast<uint8_t>(dataN - curN), 0};
            AscendC::DataCopyPad(ci, c_[slot + static_cast<uint64_t>(r) * curN], cp, cpad);
            inQ_.EnQue(ci);
            ci = inQ_.DeQue<int32_t>();
            // Explicit zeroes cover each physical row gap and the Compare
            // tail. Only actual/padded dataN columns are read from ci/sc.
            AscendC::Duplicate(z, 0.0f, count);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::UnaryRepeatParams castRep{1, 1,
                static_cast<uint8_t>(rowN / 8), static_cast<uint8_t>(rowN / 8)};
            AscendC::BinaryRepeatParams mulRep{1, 1, 1,
                static_cast<uint8_t>(rowN / 8), static_cast<uint8_t>(rowN / 8), 0};
            for (uint32_t c = 0; c < dataN; c += 64) {
                const uint64_t mask = Min(64, dataN - c);
                AscendC::Cast(z[c], ci[c], AscendC::RoundMode::CAST_NONE,
                    mask, static_cast<uint8_t>(rows), castRep);
            }
            AscendC::PipeBarrier<PIPE_V>();
            for (uint32_t c = 0; c < dataN; c += 64) {
                const uint64_t mask = Min(64, dataN - c);
                AscendC::Mul(z[c], z[c], sc[c], mask, static_cast<uint8_t>(rows), mulRep);
            }
            AscendC::PipeBarrier<PIPE_V>();
            inQ_.FreeTensor(ci);
            ApplyGeluSimple(out, z, s0, s1, signMask, count);
            LocalTensor<half> yo = outQ_.AllocTensor<half>();
            AscendC::Cast(yo, out, AscendC::RoundMode::CAST_RINT, count);
            AscendC::PipeBarrier<PIPE_V>();
            outQ_.EnQue(yo);
            yo = outQ_.DeQue<half>();
            AscendC::DataCopyExtParams yp{static_cast<uint16_t>(rows),
                static_cast<uint32_t>(curN * sizeof(half)), 0,
                static_cast<uint32_t>((t_.n - curN) * sizeof(half)), 0};
            AscendC::DataCopyPad(y_[static_cast<uint64_t>(row + r) * t_.n + col], yo, yp);
            outQ_.FreeTensor(yo);
        }
        scaleQ_.FreeTensor(sc);
    }

    MMType& mm_;
    AscendC::TPipe& pipe_;
    const Tiling& t_;
    GlobalTensor<int8_t> x_, w_;
    GlobalTensor<float> scale_;
    GlobalTensor<int64_t> groups_;
    GlobalTensor<int32_t> c_;
    GlobalTensor<half> y_;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQ_, scaleQ_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQ_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tmp_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> masks_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> groupCache_;
    GlobalTensor<int8_t> groupBytes_;
    uint32_t core_ = 0;
    uint32_t sub_ = 0;
    uint32_t tileCount_ = 0;
};

// HT06_NAMESPACE_END

// HT16_NAMESPACE_BEGIN
class HT16TransposeDot {
public:
    __aicore__ inline HT16TransposeDot(const Tiling& t)
    {
        t_.m = t.m;
        t_.k = t.k;
        t_.n = t.n;
        t_.groups = t.groups;
        t_.cores = t.cores;
    }

    __aicore__ inline HT16TransposeDot(const SmallKMeta& shape)
    {
        t_.m = shape.m;
        t_.k = shape.k;
        t_.n = shape.n;
        t_.groups = shape.groups;
        t_.cores = shape.cores;
    }

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR w, GM_ADDR scale,
        GM_ADDR groups, GM_ADDR y)
    {
        x_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
        w_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(w));
        scale_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scale));
        groups_.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups));
        y_.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y));
        // In mix(1,2), the raw AIV block index already enumerates both AIVs.
        worker_ = AscendC::GetBlockIdx();
        workers_ = t_.cores * AscendC::GetTaskRation();
        // No TPipe, TQue, or dynamic event allocation is used in this branch.
    }

    __aicore__ inline void Process()
    {
        if (t_.m == 1) {
            uint32_t lo = 0;
            uint32_t hi = t_.groups;
            while (lo < hi) {
                const uint32_t mid = lo + (hi - lo) / 2;
                if (groups_.GetValue(mid) > 0) {
                    hi = mid;
                } else {
                    lo = mid + 1;
                }
            }
            Compute(lo, 0, 0, 1, t_.n);
            return;
        }
        // M153_EXTENDED_E1_ROWS_BEGIN: one full half-row job per existing raw AIV.
        const uint32_t extendedRowN = CeilDiv(t_.n, 16) * 16;
        const uint64_t extendedWork = static_cast<uint64_t>(t_.m) * extendedRowN;
        if (t_.groups == 1 && t_.m >= 1 && t_.m <= 16 &&
            t_.k >= 1 && t_.k <= 3 && t_.n >= 1 && t_.n <= 256 &&
            extendedWork > 256 && extendedWork <= 4096) {
            const uint32_t halfRows = CeilDiv(t_.m, 2);
            const uint32_t firstRow = worker_ * halfRows;
            const uint32_t lastRow = Min(firstRow + halfRows, t_.m);
            if (firstRow < lastRow) {
                Compute(0, firstRow, 0, lastRow - firstRow, t_.n);
            }
            return;
        }
        // M153_EXTENDED_E1_ROWS_END
        const uint32_t rowN = CeilDiv(t_.n, 16) * 16;
        const uint32_t halfWorkRows = 128U / rowN;
        const uint32_t rowsPerJob = Min(16U, halfWorkRows > 0 ? halfWorkRows : 1U);
        uint32_t previousEnd = 0;
        uint32_t jobOrdinal = 0;
        for (uint32_t e = 0; e < t_.groups; ++e) {
            const uint32_t end = static_cast<uint32_t>(groups_.GetValue(e));
            const uint32_t rows = end - previousEnd;
            for (uint32_t offset = 0; offset < rows; offset += rowsPerJob) {
                if (jobOrdinal % 2U == worker_) {
                    Compute(e, previousEnd + offset, 0,
                        Min(rowsPerJob, rows - offset), t_.n);
                }
                ++jobOrdinal;
            }
            previousEnd = end;
        }
    }

    __aicore__ inline void Finish()
    {
        using namespace AscendC;
        // Consume the final release flags even after either Process early return.
        if (wReuse_) {
            WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
            wReuse_ = false;
        }
        if (xReuse_) {
            WaitFlag<HardEvent::V_MTE2>(EVENT_ID1);
            xReuse_ = false;
        }
        if (scaleReuse_) {
            WaitFlag<HardEvent::V_MTE2>(EVENT_ID2);
            scaleReuse_ = false;
        }
        if (outReuse_) {
            WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
            outReuse_ = false;
            // Explicit final GM-write completion before the scalar entry exits.
            SetFlag<HardEvent::MTE3_S>(EVENT_ID0);
            WaitFlag<HardEvent::MTE3_S>(EVENT_ID0);
        }
    }

private:
    __aicore__ inline void Compute(uint32_t e,uint32_t row,uint32_t col,
        uint32_t rows,uint32_t curN)
    {
        using namespace AscendC;
        // The exclusive M1 entry fixes rows=1,col=0; all physical pitches stay explicit.
        const uint32_t weightN=CeilDiv(curN,32)*32;
        const uint32_t dataN=CeilDiv(curN,8)*8;
        const uint32_t rowN=CeilDiv(curN,16)*16;
        const uint32_t count=CeilDiv(rows*rowN,64)*64;
        LocalTensor<int8_t> wi(TPosition::VECIN,0,4096);
        LocalTensor<int8_t> xi(TPosition::VECIN,4096,256);
        LocalTensor<float> sc(TPosition::VECIN,4352,256);
        LocalTensor<half> yo(TPosition::VECOUT,5376,4096);
        LocalTensor<float> wf(TPosition::VECCALC,13568,4096);
        LocalTensor<float> xf(TPosition::VECCALC,29952,256);
        LocalTensor<half> wh(TPosition::VECCALC,30976,4096);
        LocalTensor<float> z(TPosition::VECCALC,39168,kBatchElems);
        LocalTensor<float> out(TPosition::VECCALC,55552,kBatchElems);
        LocalTensor<float> s0(TPosition::VECCALC,71936,kBatchElems);
        LocalTensor<float> s1(TPosition::VECCALC,88320,kBatchElems);
        LocalTensor<uint8_t> signMask(TPosition::VECCALC,104704,kMaskBytes);
        // Parent ends105216. NewhalfT8192 and productFP3216384 are disjoint.
        LocalTensor<half> wt(TPosition::VECCALC,105216,4096);
        LocalTensor<float> product(TPosition::VECCALC,113408,4096);
        if(wReuse_) {WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);wReuse_=false;}
        if(curN==1) {
            // KN is already a contiguous K vector; no transpose is needed.
            DataCopyExtParams wp{1,t_.k,0,0,0};
            DataCopyPadExtParams<int8_t> wpad{true,0,static_cast<uint8_t>(32-t_.k),0};
            DataCopyPad(wi,w_[static_cast<uint64_t>(e)*t_.k*t_.n],wp,wpad);
            SetFlag<HardEvent::MTE2_V>(EVENT_ID0);WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
            Cast(wh,wi,RoundMode::CAST_NONE,32);PipeBarrier<PIPE_V>();
            Cast(wf,wh,RoundMode::CAST_NONE,32);PipeBarrier<PIPE_V>();
        } else {
            DataCopyExtParams wp{static_cast<uint16_t>(t_.k),curN,t_.n-curN,0,0};
            DataCopyPadExtParams<int8_t> wpad{true,0,static_cast<uint8_t>(weightN-curN),0};
            DataCopyPad(wi,w_[static_cast<uint64_t>(e)*t_.k*t_.n+col],wp,wpad);
            SetFlag<HardEvent::MTE2_V>(EVENT_ID0);WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
            // Exact operand storage only. Zero all missingK rows before realK cast.
            Duplicate(wh,static_cast<half>(0),16*weightN);PipeBarrier<PIPE_V>();
            Cast(wh,wi,RoundMode::CAST_NONE,t_.k*weightN);PipeBarrier<PIPE_V>();
            uint64_t srcList[16],dstList[16];
            for(uint32_t i=0;i<16;++i) {
                srcList[i]=(uint64_t)(wh[i*weightN].GetPhyAddr());
                dstList[i]=(uint64_t)(wt[i*16].GetPhyAddr());
            }
            TransDataTo5HDParams tp;
            tp.dstHighHalf=false;tp.srcHighHalf=false;
            tp.repeatTimes=static_cast<uint8_t>(weightN/16);
            tp.dstRepStride=16;tp.srcRepStride=1;
            TransDataTo5HD<half>(dstList,srcList,tp);PipeBarrier<PIPE_V>();
            Cast(wf,wt,RoundMode::CAST_NONE,16*weightN);PipeBarrier<PIPE_V>();
        }
        SetFlag<HardEvent::V_MTE2>(EVENT_ID0);wReuse_=true;
        // wh has finished allW/transpose reads, so its first32half can now stageX.
        if(xReuse_) {WaitFlag<HardEvent::V_MTE2>(EVENT_ID1);xReuse_=false;}
        DataCopyExtParams xp{1,t_.k,0,0,0};
        DataCopyPadExtParams<int8_t> xpad{true,0,static_cast<uint8_t>(32-t_.k),0};
        DataCopyPad(xi,x_[static_cast<uint64_t>(row)*t_.k],xp,xpad);
        SetFlag<HardEvent::MTE2_V>(EVENT_ID1);WaitFlag<HardEvent::MTE2_V>(EVENT_ID1);
        Cast(wh,xi,RoundMode::CAST_NONE,32);PipeBarrier<PIPE_V>();
        Cast(xf,wh,RoundMode::CAST_NONE,32);PipeBarrier<PIPE_V>();
        SetFlag<HardEvent::V_MTE2>(EVENT_ID1);xReuse_=true;
        if(scaleReuse_) {WaitFlag<HardEvent::V_MTE2>(EVENT_ID2);scaleReuse_=false;}
        DataCopyExtParams sp{1,static_cast<uint32_t>(curN*sizeof(float)),0,0,0};
        DataCopyPadExtParams<float> spad{true,0,static_cast<uint8_t>(dataN-curN),0};
        DataCopyPad(sc,scale_[static_cast<uint64_t>(e)*t_.n+col],sp,spad);
        SetFlag<HardEvent::MTE2_V>(EVENT_ID2);WaitFlag<HardEvent::MTE2_V>(EVENT_ID2);
        Duplicate(z,0.0f,count);Duplicate(s0,0.0f,count);PipeBarrier<PIPE_V>();
        if(curN==1) {
            Mul(product,wf,xf,static_cast<uint64_t>(16),static_cast<uint8_t>(1),{1,1,1,2,2,0});
            PipeBarrier<PIPE_V>();
            WholeReduceSum<float>(z,product,16,1,1,1,2);PipeBarrier<PIPE_V>();
        } else {
            for(uint32_t n0=0;n0<weightN;n0+=128) {
                const uint32_t repeat=Min(128U,weightN-n0);
                Mul(product[n0*16],wf[n0*16],xf,static_cast<uint64_t>(16),
                    static_cast<uint8_t>(repeat),{1,1,1,2,2,0});
                PipeBarrier<PIPE_V>();
                // dstRepStride is float elements; source strides are32Bblocks.
                WholeReduceSum<float>(z[n0],product[n0*16],16,static_cast<int32_t>(repeat),1,1,2);
                PipeBarrier<PIPE_V>();
            }
        }
        auto dots = s1.ReinterpretCast<int32_t>();
        Cast(dots, z, RoundMode::CAST_RINT, count);
        PipeBarrier<PIPE_V>();
        Cast(z, dots, RoundMode::CAST_NONE, count);
        PipeBarrier<PIPE_V>();
        for (uint32_t r = 0; r < rows; ++r) {
            Mul(z[r * rowN], z[r * rowN], sc, dataN);
        }
        PipeBarrier<PIPE_V>();
        SetFlag<HardEvent::V_MTE2>(EVENT_ID2);
        scaleReuse_ = true;
        ApplyGeluSimple(out, z, s0, s1, signMask, count);
        if (outReuse_) {
            WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
            outReuse_ = false;
        }
        Cast(yo, out, RoundMode::CAST_RINT, count);
        PipeBarrier<PIPE_V>();
        SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
        WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
        // Every physical FP16 UB row occupies rowN*2 bytes (32-byte aligned).
        DataCopyExtParams yp{static_cast<uint16_t>(rows),
            static_cast<uint32_t>(curN * sizeof(half)), 0,
            static_cast<uint32_t>((t_.n - curN) * sizeof(half)), 0};
        DataCopyPad(y_[static_cast<uint64_t>(row) * t_.n + col], yo, yp);
        SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
        outReuse_ = true;
    }

    SmallKMeta t_;
    GlobalTensor<int8_t> x_, w_;
    GlobalTensor<float> scale_;
    GlobalTensor<int64_t> groups_;
    GlobalTensor<half> y_;
    bool wReuse_ = false, xReuse_ = false, scaleReuse_ = false, outReuse_ = false;
    uint32_t worker_ = 0;
    uint32_t workers_ = 0;
};
// HT16_NAMESPACE_END

// HT06_NAMESPACE_BEGIN
static __aicore__ inline constexpr MatmulConfig Compact32Config() {
 MatmulConfig cfg=CFG_NORM;
 cfg.singleCoreM=32;cfg.singleCoreN=64;cfg.singleCoreK=128;
 cfg.basicM=32;cfg.basicN=64;cfg.basicK=128;
 cfg.enableSetBias=false;cfg.enableSetTail=true;cfg.enableSetOrgShape=true;
 return cfg;
}
static __aicore__ inline constexpr auto Compact32Tiling() {
 auto t=AscendC::GetMatmulApiTiling<AType,BType,CType,BiasType>(Compact32Config());
 t.dbL0A=2;t.dbL0B=2;t.dbL0C=2;
 t.shareL0CSize=32*64*sizeof(int32_t)*2;
 return t;
}
constexpr auto kCompact32=Compact32Tiling();
static_assert(kCompact32.baseM==32 && kCompact32.baseN==64 && kCompact32.baseK==128,"HT11 C exact geometry");
static_assert(kCompact32.dbL0A==2 && kCompact32.dbL0B==2 && kCompact32.dbL0C==2,"HT11 C exact banks");
static_assert(!AscendC::NoTailK(kCompact32),"HT11 C real K tails retained");
static_assert(2*32*128<=65536 && 2*64*128<=65536 && 2*32*64*sizeof(int32_t)<=131072,"HT11 C Norm resources fit");
using Compact32MM=matmul::MatmulImpl<AType,BType,CType,BiasType,kCompact32>;

// HT06_NAMESPACE_END

// HT26_NAMESPACE_BEGIN
class MdlPartial4Producer {
public:
    __aicore__ inline MdlPartial4Producer(MdlPairMM& mm,const Tiling& t):mm_(mm),t_(t) {}
    __aicore__ inline void Init(GM_ADDR x,GM_ADDR weight,GM_ADDR groups,GM_ADDR workspace) {
        x_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
        w_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(weight));
        groups_.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups));
        c_.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(workspace));
        core_=AscendC::GetBlockIdx();
    }
    __aicore__ inline void Process() {
        uint32_t previousEnd=0;
        uint64_t tileBase=0;
        const uint32_t nTiles=CeilDiv(t_.n,256);
        const uint32_t kBlocks=CeilDiv(t_.k,256);
        for(uint32_t e=0;e<t_.groups;++e) {
            const uint32_t end=static_cast<uint32_t>(groups_.GetValue(e));
            const uint32_t rows=end-previousEnd;
            const uint32_t tiles=CeilDiv(rows,128)*nTiles;
            const uint32_t tasks=tiles*4;
            const uint32_t taskBase=static_cast<uint32_t>((tileBase*4)%t_.cores);
            uint32_t task=(core_+t_.cores-taskBase)%t_.cores;
            for(;task<tasks;task+=t_.cores) {
                const uint32_t tile=task/4,part=task%4;
                const uint32_t row=(tile/nTiles)*128,col=(tile%nTiles)*256;
                const uint32_t curM=Min(128,rows-row),curN=Min(256,t_.n-col);
                const uint32_t first=part*kBlocks/4,last=(part+1)*kBlocks/4;
                const uint32_t k0=first*256,curK=Min(t_.k,last*256)-k0;
                const uint64_t slot=((tileBase+tile)*4+part)*32768;
                if(curM>64 && curM<128) {
                    ProduceFragment(e,previousEnd+row,col,64,curN,k0,curK,slot);
                    ProduceFragment(e,previousEnd+row+64,col,curM-64,curN,k0,curK,
                        slot+static_cast<uint64_t>(64)*curN);
                } else {
                    ProduceFragment(e,previousEnd+row,col,curM,curN,k0,curK,slot);
                }
            }
            tileBase+=tiles;previousEnd=end;
        }
        // SDK lifetime ends on every AIC, including idle workers. No ring drain.
        mm_.End();
        AscendC::PipeBarrier<PIPE_ALL>();
    }
private:
    __aicore__ inline void ProduceFragment(uint32_t e, uint32_t row, uint32_t col,
        uint32_t rows, uint32_t curN, uint32_t k0, uint32_t curK, uint64_t destination)
    {
        // Same M3 API contract: A/B keep actual K/N strides; C alone uses
        // compact curN rows. Non-sequential OUTER output preserves both
        // 64-row C fragments of a complete 128-row pair.
        mm_.SetOrgShape(t_.m, t_.n, t_.k, t_.k, curN);
        mm_.SetSingleShape(rows, curN, curK);
        mm_.SetTensorA(x_[static_cast<uint64_t>(row) * t_.k + k0]);
        mm_.SetTensorB(w_[static_cast<uint64_t>(e) * t_.k * t_.n + static_cast<uint64_t>(k0) * t_.n + col]);
        while (mm_.Iterate()) {
            mm_.GetTensorC(c_[destination], 0, false);
        }
    }
    MdlPairMM& mm_;const Tiling& t_;
    GlobalTensor<int8_t> x_,w_;GlobalTensor<int64_t> groups_;
    GlobalTensor<int32_t> c_;uint32_t core_=0;
};

class MdlPartial4Reducer {
public:
    __aicore__ inline MdlPartial4Reducer(AscendC::TPipe& pipe, const Tiling& t)
        : pipe_(pipe), t_(t) {}
    __aicore__ inline void Init(GM_ADDR scale, GM_ADDR groups, GM_ADDR y, GM_ADDR workspace)
    {
        scale_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scale));
        groups_.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups));
        y_.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y));
        c_.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(workspace));
        worker_ = AscendC::GetBlockIdx();
        workers_ = t_.cores * AscendC::GetTaskRation();
        pipe_.InitBuffer(inQ_, 1, kBatchElems * sizeof(int32_t));
        pipe_.InitBuffer(scaleQ_, 1, kMaxN * sizeof(float));
        pipe_.InitBuffer(outQ_, 1, kBatchElems * sizeof(half));
        pipe_.InitBuffer(tmp_, 4 * kBatchElems * sizeof(float));
        pipe_.InitBuffer(masks_, kMaskBytes);
    }
    __aicore__ inline void Process()
    {
        uint32_t previousEnd = 0;
        uint64_t tileOrdinal = 0;
        uint64_t batchOrdinal = 0;
        const uint32_t nTiles = CeilDiv(t_.n, 256);
        for (uint32_t e = 0; e < t_.groups; ++e) {
            const uint32_t end = static_cast<uint32_t>(groups_.GetValue(e));
            const uint32_t rows = end - previousEnd;
            const uint32_t mTiles = CeilDiv(rows, 128);
            for (uint32_t mt = 0; mt < mTiles; ++mt) {
                const uint32_t row = mt * 128;
                const uint32_t curM = Min(128, rows - row);
                for (uint32_t nt = 0; nt < nTiles; ++nt) {
                    const uint32_t col = nt * 256;
                    const uint32_t curN = Min(256, t_.n - col);
                    for (uint32_t r = 0; r < curM; r += kBatchRows) {
                        if (batchOrdinal % workers_ == worker_) {
                            ReduceBatch(e, previousEnd + row, col,
                                Min(kBatchRows, curM - r), curN, tileOrdinal, r);
                        }
                        ++batchOrdinal;
                    }
                    ++tileOrdinal;
                }
            }
            previousEnd = end;
        }
            // Early AIC completion/barrier is not final Y completion.
        const auto outputDone=pipe_.FetchEventID(AscendC::HardEvent::MTE3_S);
        AscendC::SetFlag<AscendC::HardEvent::MTE3_S>(outputDone);
        AscendC::WaitFlag<AscendC::HardEvent::MTE3_S>(outputDone);
    }
private:
    __aicore__ inline void ReduceBatch(uint32_t e, uint32_t row, uint32_t col,
        uint32_t rows, uint32_t curN, uint64_t tileOrdinal, uint32_t r)
    {
        const uint32_t dataN = CeilDiv(curN, 8) * 8;
        const uint32_t rowN = CeilDiv(curN, 16) * 16;
        LocalTensor<float> sc = scaleQ_.AllocTensor<float>();
        AscendC::DataCopyExtParams p{1, static_cast<uint32_t>(curN * sizeof(float)), 0, 0, 0};
        AscendC::DataCopyPadExtParams<float> pad{true, 0, static_cast<uint8_t>(dataN - curN), 0};
        AscendC::DataCopyPad(sc, scale_[static_cast<uint64_t>(e) * t_.n + col], p, pad);
        scaleQ_.EnQue(sc);
        sc = scaleQ_.DeQue<float>();
        LocalTensor<float> z = tmp_.GetWithOffset<float>(kBatchElems, 0);
        LocalTensor<float> out = tmp_.GetWithOffset<float>(kBatchElems, kBatchElems * sizeof(float));
        LocalTensor<float> s0 = tmp_.GetWithOffset<float>(kBatchElems, 2 * kBatchElems * sizeof(float));
        LocalTensor<float> s1 = tmp_.GetWithOffset<float>(kBatchElems, 3 * kBatchElems * sizeof(float));
        auto signMask = masks_.GetWithOffset<uint8_t>(kMaskBytes, 0);
        {
            const uint32_t used = rows * rowN;
            const uint32_t count = CeilDiv(used, 64) * 64;
            // s1 is integer-only until the complete reduction is cast to z.
            LocalTensor<int32_t> accum = s1.ReinterpretCast<int32_t>();
            AscendC::Duplicate(accum, static_cast<int32_t>(0), count);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::BinaryRepeatParams addRep{1, 1, 1,
                static_cast<uint8_t>(rowN / 8), static_cast<uint8_t>(rowN / 8),
                static_cast<uint8_t>(rowN / 8)};
            for (uint32_t part = 0; part < t_.splitKParts; ++part) {
                const uint64_t slot = (tileOrdinal * t_.splitKParts + part) * 32768;
                LocalTensor<int32_t> ci = inQ_.AllocTensor<int32_t>();
                AscendC::DataCopyExtParams cp{static_cast<uint16_t>(rows),
                    static_cast<uint32_t>(curN * sizeof(int32_t)), 0, (rowN - dataN) / 8, 0};
                AscendC::DataCopyPadExtParams<int32_t> cpad{true, 0,
                    static_cast<uint8_t>(dataN - curN), 0};
                AscendC::DataCopyPad(ci, c_[slot + static_cast<uint64_t>(r) * curN], cp, cpad);
                inQ_.EnQue(ci);
                ci = inQ_.DeQue<int32_t>();
                // ci row gaps are not initialized by DataCopyPad. Only dataN
                // lanes per physical row participate, never a blind count Add.
                for (uint32_t c = 0; c < dataN; c += 64) {
                    const uint64_t mask = Min(64, dataN - c);
                    AscendC::Add(accum[c], accum[c], ci[c], mask,
                        static_cast<uint8_t>(rows), addRep);
                }
                AscendC::PipeBarrier<PIPE_V>();
                inQ_.FreeTensor(ci);
            }
            // Explicit zeroes cover each physical row gap and the Compare
            // tail. Only actual/padded dataN columns are read from ci/sc.
            AscendC::Duplicate(z, 0.0f, count);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::UnaryRepeatParams castRep{1, 1,
                static_cast<uint8_t>(rowN / 8), static_cast<uint8_t>(rowN / 8)};
            AscendC::BinaryRepeatParams mulRep{1, 1, 1,
                static_cast<uint8_t>(rowN / 8), static_cast<uint8_t>(rowN / 8), 0};
            for (uint32_t c = 0; c < dataN; c += 64) {
                const uint64_t mask = Min(64, dataN - c);
                AscendC::Cast(z[c], accum[c], AscendC::RoundMode::CAST_NONE,
                    mask, static_cast<uint8_t>(rows), castRep);
            }
            AscendC::PipeBarrier<PIPE_V>();
            for (uint32_t c = 0; c < dataN; c += 64) {
                const uint64_t mask = Min(64, dataN - c);
                AscendC::Mul(z[c], z[c], sc[c], mask, static_cast<uint8_t>(rows), mulRep);
            }
            AscendC::PipeBarrier<PIPE_V>();
            ApplyGeluSimple(out, z, s0, s1, signMask, count);
            LocalTensor<half> yo = outQ_.AllocTensor<half>();
            AscendC::Cast(yo, out, AscendC::RoundMode::CAST_RINT, count);
            AscendC::PipeBarrier<PIPE_V>();
            outQ_.EnQue(yo);
            yo = outQ_.DeQue<half>();
            AscendC::DataCopyExtParams yp{static_cast<uint16_t>(rows),
                static_cast<uint32_t>(curN * sizeof(half)), 0,
                static_cast<uint32_t>((t_.n - curN) * sizeof(half)), 0};
            AscendC::DataCopyPad(y_[static_cast<uint64_t>(row + r) * t_.n + col], yo, yp);
            outQ_.FreeTensor(yo);
        }
        scaleQ_.FreeTensor(sc);
    }
    AscendC::TPipe& pipe_;
    const Tiling& t_;
    GlobalTensor<float> scale_;
    GlobalTensor<int64_t> groups_;
    GlobalTensor<int32_t> c_;
    GlobalTensor<half> y_;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQ_, scaleQ_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQ_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tmp_, masks_;
    uint32_t worker_ = 0;
    uint32_t workers_ = 0;
};
// HT26_NAMESPACE_END

// HT55_B07_PARTIAL4_REFUSAL_SELECTOR_BEGIN
constexpr uint64_t kPartial4RefusalBudget=64ULL*1024*1024;
static __aicore__ inline bool RefuseHT55ParentPartial4(const Tiling& t,GM_ADDR groupList)
{
    // Only the original Host-selected Partial4 leaf calls this entry.
    // All actual launch participants decide identically before any queue/Matmul Init.
    if(t.reserved!=2 || t.tileM!=128 || t.tileN!=256 ||
        t.splitKParts!=4 || t.cores==0 || t.k==0) return false;
    const uint64_t p1RingBytes=static_cast<uint64_t>(t.cores)*kSlots*128*256*sizeof(int32_t);
    if(p1RingBytes>kPartial4RefusalBudget) return false; // Keep original P4 capacity.
    const uint32_t kBlocks=CeilDiv(t.k,256);
    if(kBlocks<4) return false;
    GlobalTensor<int64_t> groups;
    groups.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groupList));
    uint32_t previous=0;
    uint64_t jobs=0;
    const uint32_t nTiles=CeilDiv(t.n,256);
    for(uint32_t e=0;e<t.groups;++e) {
        const int64_t raw=groups.GetValue(e);
        if(raw<static_cast<int64_t>(previous) || raw>static_cast<int64_t>(t.m)) return false;
        const uint32_t end=static_cast<uint32_t>(raw);
        jobs+=static_cast<uint64_t>(CeilDiv(end-previous,128))*nTiles;
        previous=end;
    }
    if(previous!=t.m || jobs==0 || jobs>t.splitKTileUpper) return false;
    const uint64_t p1Cost=((jobs+t.cores-1)/t.cores)*kBlocks;
    const uint64_t p4Cost=((jobs*4+t.cores-1)/t.cores)*((kBlocks+3)/4);
    // Cube-wave heuristic only; tails/real worker balance and pipeline effects remain.
    // With no estimated Cube advantage, avoid four GM partials and integer reduction.
    return p4Cost>=p1Cost;
}
static_assert(kMdlPair.singleCoreK==8192 && !AscendC::IsBasicK(kMdlPair) &&
    !AscendC::NoTailK(kMdlPair), "B07 P1 retains complete runtime K and K tails");
// HT55_B07_PARTIAL4_REFUSAL_SELECTOR_END


// FullA64_NAMESPACE_BEGIN
static __aicore__ inline constexpr MatmulConfig FullA64FullAConfig() {
    MatmulConfig cfg=FullAConfig();
    cfg.singleCoreM=64;cfg.singleCoreN=256;cfg.singleCoreK=1024;
    cfg.basicM=64;cfg.basicN=256;cfg.basicK=256;
    cfg.enableSetTail=true;cfg.enableSetOrgShape=true;
    return cfg;
}
static __aicore__ inline constexpr auto FullA64FullATiling() {
    auto t=AscendC::GetMatmulApiTiling<FullAType,BType,CType,BiasType,
        MatmulPairShape<64,256,1024>,MatmulPairShape<64,256,256>,
        MatmulPairShape<64,256,256>>(FullA64FullAConfig());
    t.dbL0A=2;t.dbL0B=1;t.dbL0C=1;
    t.shareL0CSize=64*256*sizeof(int32_t);
    return t;
}
constexpr auto kFullA64FullA=FullA64FullATiling();
static_assert(kFullA64FullA.singleCoreM==64 && kFullA64FullA.singleCoreN==256 &&
    kFullA64FullA.singleCoreK==1024 && kFullA64FullA.baseM==64 &&
    kFullA64FullA.baseN==256 && kFullA64FullA.baseK==256,"FullA64 physical shape and base geometry");
static_assert(kFullA64FullA.stepM==1 && kFullA64FullA.stepN==1 &&
    kFullA64FullA.stepKa==1 && kFullA64FullA.stepKb==1,"FullA64 external fullA and single B panel");
static_assert(kFullA64FullA.dbL0A==2 && kFullA64FullA.dbL0B==1 && kFullA64FullA.dbL0C==1 &&
    2*64*256==32768 && 256*256==65536 && 2*64*256*sizeof(int32_t)==131072,
    "FullA64 real A0/B0/C0 capacities incl OUTER lenFactor2");
static_assert(kFullA64FullA.shareL1Size+64*1024<=524288 &&
    kFullA64FullA.shareL0CSize==65536,"FullA64 complete SDK L1 plus one external A and C bank");
static_assert(!AscendC::NoTailM(kFullA64FullA) && !AscendC::NoTailN(kFullA64FullA) &&
    !AscendC::NoTailK(kFullA64FullA) && !AscendC::IsBasicK(kFullA64FullA),"FullA64 all actual M/N/K tails retained");
using FullA64FullAMM=matmul::MatmulImpl<FullAType,BType,CType,BiasType,kFullA64FullA,
    AscendC::MatmulCallBackFunc<nullptr,nullptr,nullptr>,AscendC::Impl::Detail::GmmPairMdlPolicy>;
struct FullA64Job {uint32_t expert,row,col,curM,outputs;};
// Same iterator for real GM endpoints and each AV's independent UB endpoints.
// Each global grouped-job ordinal owns at most two outputs on ONE AIC/AV pair.
template<class GroupTensor>
class FullA64JobIterator {
public:
    __aicore__ inline FullA64JobIterator(const Tiling& t,const GroupTensor& g,uint32_t core)
        :t_(t),groups_(g),core_(core) {}
    __aicore__ inline bool Next(FullA64Job& job) {
        const uint32_t nTiles=CeilDiv(t_.n,256),pairs=CeilDiv(nTiles,2);
        while(expert_<t_.groups) {
            const uint32_t end=static_cast<uint32_t>(groups_.GetValue(expert_));
            const uint32_t rows=end-previousEnd_;
            while(rowInGroup_<rows) {
                while(pair_<pairs) {
                    const uint32_t pair=pair_++;const uint64_t ordinal=ordinal_++;
                    if(ordinal%t_.cores==core_) {
                        const uint32_t firstN=pair*2;
                        job={expert_,previousEnd_+rowInGroup_,firstN*256,
                            Min(64,rows-rowInGroup_),Min(2,nTiles-firstN)};
                        return true;
                    }
                }
                pair_=0;rowInGroup_+=64;
            }
            rowInGroup_=0;pair_=0;previousEnd_=end;++expert_;
        }
        return false;
    }
private:
    const Tiling& t_;const GroupTensor& groups_;uint32_t core_;
    uint32_t expert_=0,previousEnd_=0,rowInGroup_=0,pair_=0;uint64_t ordinal_=0;
};
class FullA64Producer {
public:
    __aicore__ inline FullA64Producer(FullA64FullAMM& mm,AscendC::TPipe& pipe,const Tiling& t)
        :mm_(mm),pipe_(pipe),t_(t) {}
    __aicore__ inline void Init(GM_ADDR x,GM_ADDR w,GM_ADDR groups,GM_ADDR workspace) {
        x_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
        w_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(w));
        groups_.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups));
        c_.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(workspace));
        core_=AscendC::GetBlockIdx();
        pipe_.InitBuffer(aScm_,1,64*1024*sizeof(int8_t));
        aReadDone_=pipe_.AllocEventID<AscendC::HardEvent::MTE1_MTE2>();
    }
    __aicore__ inline void Process() {
        FullA64JobIterator<GlobalTensor<int64_t>> it(t_,groups_,core_);FullA64Job job;
        while(it.Next(job)) {
            auto a=aScm_.AllocTensor<int8_t>();
            // Exact physical64x1024 buffer, NOT claimed roundK-only clear.
            // Covers all missing M rows/K lanes, including one-row groups.
            auto zero=a.ReinterpretCast<uint16_t>();
            AscendC::InitConstValue(zero,AscendC::InitConstValueParams<uint16_t>{1,2048,0,0});
            AscendC::PipeBarrier<PIPE_MTE2>();
            AscendC::Nd2NzParams p{};
            p.ndNum=1;p.nValue=job.curM;p.dValue=t_.k;p.srcDValue=t_.k;
            p.dstNzC0Stride=64;p.dstNzNStride=1;
            AscendC::DataCopy(a,x_[static_cast<uint64_t>(job.row)*t_.k],p);
            aScm_.EnQue(a);a=aScm_.DeQue<int8_t>();
            for(uint32_t n=0;n<job.outputs;++n) {
                const uint32_t col=job.col+n*256,curN=Min(256,t_.n-col);
                Produce(job.expert,col,job.curM,curN,a);
            }
            // Independent last-A-read edge after BOTH real N outputs.
            AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(aReadDone_);
            AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(aReadDone_);
            aScm_.FreeTensor(a);
        }
        const uint32_t pending=Min(tileCount_,kSlots);
        for(uint32_t i=0;i<pending;++i) {
            const uint32_t slotIdx=(tileCount_-pending+i)%kSlots;
            AscendC::CrossCoreWaitFlag(kFree+slotIdx);
        }
        mm_.End();pipe_.ReleaseEventID<AscendC::HardEvent::MTE1_MTE2>(aReadDone_);
    }
private:
    __aicore__ inline void Produce(uint32_t e,uint32_t col,uint32_t curM,uint32_t curN,
        const LocalTensor<int8_t>& a) {
        const uint32_t slotIdx=tileCount_%kSlots;
        const uint64_t slot=(static_cast<uint64_t>(core_)*kSlots+slotIdx)*64*256;
        if(tileCount_>=kSlots) AscendC::CrossCoreWaitFlag(kFree+slotIdx);
        // Physical A orgM64/orgKa1024 matches NZ/TSCM and constant capacity.
        // B actual K/N, logical K and compact C pitch remain actual values.
        mm_.SetOrgShape(64,t_.n,1024,t_.k,curN);
        mm_.SetSingleShape(curM,curN,t_.k);
        mm_.SetTensorA(a);
        mm_.SetTensorB(w_[static_cast<uint64_t>(e)*t_.k*t_.n+col]);
        while(mm_.Iterate()) mm_.GetTensorC(c_[slot],0,false);
        AscendC::CrossCoreSetFlag<2,PIPE_FIX>(kReady+slotIdx);++tileCount_;
    }
    FullA64FullAMM& mm_;AscendC::TPipe& pipe_;const Tiling& t_;
    GlobalTensor<int8_t> x_,w_;GlobalTensor<int64_t> groups_;GlobalTensor<int32_t> c_;
    AscendC::TSCM<AscendC::TPosition::GM,1,&kFullAScmConfig> aScm_;
    AscendC::TEventID aReadDone_;uint32_t core_=0,tileCount_=0;
};
class FullA64ResidentConsumer {
public:
    __aicore__ inline FullA64ResidentConsumer(AscendC::TPipe& pipe, const Tiling& t)
        : pipe_(pipe), t_(t) {}

    __aicore__ inline void Init(GM_ADDR scale, GM_ADDR groups, GM_ADDR y, GM_ADDR workspace)
    {
        scale_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scale));
        groups_.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups));
        groupBytes_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(groups));
        y_.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y));
        c_.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(workspace));
        core_ = AscendC::GetBlockIdx() / AscendC::GetTaskRation();
        sub_ = AscendC::GetSubBlockIdx();
        // 151040 bytes: C65536 + scale2048 + half16384 + float65536
        // + mask512 + private group endpoints1024. Only this consumer is Init'd.
        pipe_.InitBuffer(inQ_, 2, kResidentCElems * sizeof(int32_t));
        pipe_.InitBuffer(scaleQ_, 2, kMaxN * sizeof(float));
        pipe_.InitBuffer(outQ_, 2, kBatchElems * sizeof(half));
        pipe_.InitBuffer(tmp_, 4 * kBatchElems * sizeof(float));
        pipe_.InitBuffer(masks_, kMaskBytes);
        pipe_.InitBuffer(groupCache_, 128 * sizeof(int64_t));
    }

    __aicore__ inline void Process()
    {
        LocalTensor<int64_t> localGroups = groupCache_.Get<int64_t>();
        const uint32_t groupBytes = t_.groups * sizeof(int64_t);
        AscendC::DataCopyExtParams gp{1, groupBytes, 0, 0, 0};
        AscendC::DataCopyPadExtParams<int8_t> gpad{true, 0,
            static_cast<uint8_t>((32 - groupBytes % 32) % 32), 0};
        AscendC::DataCopyPad(localGroups.ReinterpretCast<int8_t>(), groupBytes_, gp, gpad);
        const auto groupReady = pipe_.FetchEventID(AscendC::HardEvent::MTE2_S);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_S>(groupReady);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_S>(groupReady);

        ResidentTile pending{};bool havePending=false;uint32_t tileCount=0;
        FullA64JobIterator<LocalTensor<int64_t>> it(t_,localGroups,core_);FullA64Job job;
        while(it.Next(job)) {
            for(uint32_t n=0;n<job.outputs;++n) {
                const uint32_t col=job.col+n*256;
                // Per-OUTPUT local ordinal, not globalTile%core; matches producer.
                ResidentTile next{job.expert,job.row,col,job.curM,Min(256,t_.n-col),tileCount};
                if(havePending) { Consume(pending); }
                Stage(next);pending=next;havePending=true;++tileCount;
            }
        }
        if (havePending) { Consume(pending); }
        // AIC's old final free drain now proves only GM reader completion.
        // This separate local edge waits for ALL actual Y stores before exit.
        const auto outputDone = pipe_.FetchEventID(AscendC::HardEvent::MTE3_S);
        AscendC::SetFlag<AscendC::HardEvent::MTE3_S>(outputDone);
        AscendC::WaitFlag<AscendC::HardEvent::MTE3_S>(outputDone);
    }

private:
    __aicore__ inline void Stage(const ResidentTile& d)
    {
        const uint32_t slotIdx = d.ordinal % kSlots;
        const uint32_t halfRows = CeilDiv(d.curM, 2);
        const uint32_t firstRow = sub_ * halfRows;
        const uint32_t lastRow = Min(firstRow + halfRows, d.curM);
        AscendC::CrossCoreWaitFlag(kReady + slotIdx);
        if (firstRow < lastRow) {
            const uint32_t dataN = CeilDiv(d.curN, 8) * 8;
            const uint32_t rowN = CeilDiv(d.curN, 16) * 16;
            const uint64_t slot = (static_cast<uint64_t>(core_) * kSlots + slotIdx)
                * t_.tileM * t_.tileN;
            LocalTensor<int32_t> ci = inQ_.AllocTensor<int32_t>();
            AscendC::DataCopyExtParams cp{static_cast<uint16_t>(lastRow - firstRow),
                static_cast<uint32_t>(d.curN * sizeof(int32_t)), 0, (rowN - dataN) / 8, 0};
            AscendC::DataCopyPadExtParams<int32_t> cpad{true, 0,
                static_cast<uint8_t>(dataN - d.curN), 0};
            AscendC::DataCopyPad(ci, c_[slot + static_cast<uint64_t>(firstRow) * d.curN], cp, cpad);
            // No later operation reads this GM slot: all owned rows have been
            // copied by the MTE2 stream before its mode2 release can execute.
            AscendC::CrossCoreSetFlag<2, PIPE_MTE2>(kFree + slotIdx);
            inQ_.EnQue(ci);

            LocalTensor<float> sc = scaleQ_.AllocTensor<float>();
            AscendC::DataCopyExtParams p{1, static_cast<uint32_t>(d.curN * sizeof(float)), 0, 0, 0};
            AscendC::DataCopyPadExtParams<float> pad{true, 0,
                static_cast<uint8_t>(dataN - d.curN), 0};
            AscendC::DataCopyPad(sc, scale_[static_cast<uint64_t>(d.e) * t_.n + d.col], p, pad);
            scaleQ_.EnQue(sc);
        } else {
            // The zero-row AIV still consumes ready and releases exactly once.
            AscendC::CrossCoreSetFlag<2, PIPE_MTE2>(kFree + slotIdx);
        }
    }

    __aicore__ inline void Consume(const ResidentTile& d)
    {
        const uint32_t halfRows = CeilDiv(d.curM, 2);
        const uint32_t firstRow = sub_ * halfRows;
        const uint32_t lastRow = Min(firstRow + halfRows, d.curM);
        if (firstRow >= lastRow) { return; }
        const uint32_t dataN = CeilDiv(d.curN, 8) * 8;
        const uint32_t rowN = CeilDiv(d.curN, 16) * 16;
        LocalTensor<int32_t> ci = inQ_.DeQue<int32_t>();
        LocalTensor<float> sc = scaleQ_.DeQue<float>();
        LocalTensor<float> z = tmp_.GetWithOffset<float>(kBatchElems, 0);
        LocalTensor<float> out = tmp_.GetWithOffset<float>(kBatchElems, kBatchElems * sizeof(float));
        LocalTensor<float> s0 = tmp_.GetWithOffset<float>(kBatchElems, 2 * kBatchElems * sizeof(float));
        LocalTensor<float> s1 = tmp_.GetWithOffset<float>(kBatchElems, 3 * kBatchElems * sizeof(float));
        auto signMask = masks_.GetWithOffset<uint8_t>(kMaskBytes, 0);
        for (uint32_t r = firstRow; r < lastRow; r += kBatchRows) {
            const uint32_t rows = Min(kBatchRows, lastRow - r);
            const uint32_t used = rows * rowN;
            const uint32_t count = CeilDiv(used, 64) * 64;
            const uint32_t cOffset = (r - firstRow) * rowN;
            AscendC::Duplicate(z, 0.0f, count);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::UnaryRepeatParams castRep{1, 1,
                static_cast<uint8_t>(rowN / 8), static_cast<uint8_t>(rowN / 8)};
            AscendC::BinaryRepeatParams mulRep{1, 1, 1,
                static_cast<uint8_t>(rowN / 8), static_cast<uint8_t>(rowN / 8), 0};
            for (uint32_t c = 0; c < dataN; c += 64) {
                const uint64_t mask = Min(64, dataN - c);
                AscendC::Cast(z[c], ci[cOffset + c], AscendC::RoundMode::CAST_NONE,
                    mask, static_cast<uint8_t>(rows), castRep);
            }
            AscendC::PipeBarrier<PIPE_V>();
            // V_MTE2 reverse lifetime only after the final private C read.
            if (r + rows == lastRow) { inQ_.FreeTensor(ci); }
            for (uint32_t c = 0; c < dataN; c += 64) {
                const uint64_t mask = Min(64, dataN - c);
                AscendC::Mul(z[c], z[c], sc[c], mask, static_cast<uint8_t>(rows), mulRep);
            }
            AscendC::PipeBarrier<PIPE_V>();
            if (r + rows == lastRow) { scaleQ_.FreeTensor(sc); }
            ApplyGeluSimple(out, z, s0, s1, signMask, count);
            LocalTensor<half> yo = outQ_.AllocTensor<half>();
            AscendC::Cast(yo, out, AscendC::RoundMode::CAST_RINT, count);
            AscendC::PipeBarrier<PIPE_V>();
            outQ_.EnQue(yo);
            yo = outQ_.DeQue<half>();
            AscendC::DataCopyExtParams yp{static_cast<uint16_t>(rows),
                static_cast<uint32_t>(d.curN * sizeof(half)), 0,
                static_cast<uint32_t>((t_.n - d.curN) * sizeof(half)), 0};
            AscendC::DataCopyPad(y_[static_cast<uint64_t>(d.row + r) * t_.n + d.col], yo, yp);
            outQ_.FreeTensor(yo);
        }
    }

    AscendC::TPipe& pipe_;
    const Tiling& t_;
    GlobalTensor<float> scale_;
    GlobalTensor<int64_t> groups_;
    GlobalTensor<int8_t> groupBytes_;
    GlobalTensor<int32_t> c_;
    GlobalTensor<half> y_;
    AscendC::TQue<AscendC::TPosition::VECIN, 2> inQ_, scaleQ_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 2> outQ_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tmp_, masks_, groupCache_;
    uint32_t core_ = 0, sub_ = 0;
};
// FullA64_NAMESPACE_END

// M69_MODE_BEGIN: every AIC and both AIVs decide before Matmul construction/Init.
// participants read the same immutable cumulative boundaries independently.
static __aicore__ inline void ChooseActualGroupPairMode(Tiling& t, GM_ADDR groupList)
{
    if (t.reserved != 2 || t.k < 1024 || t.k > 8192
        || static_cast<uint64_t>(t.m) >= 128ULL * t.groups) {
        return;
    }
    GlobalTensor<int64_t> boundaries;
    boundaries.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groupList));
    uint32_t previousEnd = 0;
    for (uint32_t e = 0; e < t.groups; ++e) {
        const uint32_t end = static_cast<uint32_t>(boundaries.GetValue(e));
        if (end - previousEnd >= 128) {
            // One complete hardware reuse block exists: retain MDL128.
            return;
        }
        previousEnd = end;
    }
    // Host keeps max128 capacity; local slot stride shrinks consistently on
    // all three participants. Constant StaticMM supplies its own resources.
    t.reserved = 1;
    t.tileM = 64;
    t.tileN = 256;
}
// M69_MODE_END


// M212_NATIVE_SELECTOR_END

// M127_MODE_BEGIN: all three participants run this BEFORE any new Init.
static __aicore__ inline bool CanUseFullA(const Tiling& t,GM_ADDR groupList)
{
    if(t.reserved!=2 || t.tileM!=128 || t.tileN!=256 || t.cores==0 ||
        t.k<1024 || t.k>2048 || t.k%256 || t.n<512 || t.n%256 || t.m%128) return false;
    GlobalTensor<int64_t> boundaries;
    boundaries.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groupList));
    uint32_t previous=0;
    for(uint32_t e=0;e<t.groups;++e) {
        const int64_t raw=boundaries.GetValue(e);
        if(raw<previous || raw>t.m) return false;
        const uint32_t end=static_cast<uint32_t>(raw);
        if((end-previous)%128) return false;
        previous=end;
    }
    if(previous!=t.m) return false;
    const uint64_t blocks=t.m/128,n=t.n/256,full=blocks*(n/2);
    const uint64_t oldMax=(blocks*n+t.cores-1)/t.cores;
    for(uint32_t core=0;core<t.cores;++core) {
        const uint64_t pairs=full/t.cores+(core<full%t.cores?1:0);
        const uint64_t shifted=(core+t.cores-full%t.cores)%t.cores;
        const uint64_t tails=n%2 ? blocks/t.cores+(shifted<blocks%t.cores?1:0) : 0;
        if(2*pairs+tails>oldMax) return false;
    }
    return true;
}
// M127_MODE_END

static __aicore__ inline bool CanUseFullAThreeBundle(const Tiling& t){
 if(t.cores==0 || t.cores>128 || t.n<3*256 || t.n%256)return false;
 const uint64_t blocks=t.m/128,nt=t.n/256,bundles=(nt+2)/3;
 const uint64_t oldMax=(blocks*nt+t.cores-1)/t.cores;
 uint64_t outputs[128];for(uint32_t c=0;c<t.cores;++c)outputs[c]=0;
 uint64_t id=0;for(uint64_t b=0;b<blocks;++b)for(uint64_t q=0;q<bundles;++q){uint64_t n=nt-q*3;outputs[id++%t.cores]+=n<3?n:3;}
 for(uint32_t c=0;c<t.cores;++c)if(outputs[c]>oldMax)return false;
 return true;
}
// M255_THREEN_GATE_END


// HT55_B03_FAMILY_INSERT
// HT55_B03_FULLB_BEGIN: physical B residency is independent of coarse M ownership.
constexpr uint32_t kFullBSpan = 1024;
using FullBType = MatmulType<AscendC::TPosition::TSCM, CubeFormat::NZ, int8_t>;
static __aicore__ inline constexpr MatmulConfig FullBPersistentConfig()
{
    auto cfg = MdlPairConfig();
    cfg.singleCoreM = 64; cfg.singleCoreN = 256; cfg.singleCoreK = 1024;
    cfg.basicK = 128;
    return cfg;
}
static __aicore__ inline constexpr auto FullBPersistentTiling()
{
    auto t = AscendC::GetMatmulApiTiling<AType, FullBType, CType, BiasType,
        MatmulPairShape<64,256,1024>, MatmulPairShape<64,256,128>,
        MatmulPairShape<64,256,128>>(FullBPersistentConfig());
    // Two real K128 L0B banks; one M64 output has no coarse-C accumulation.
    t.dbL0A = 2; t.dbL0B = 2; t.dbL0C = 1;
    t.shareL0CSize = 64 * 256 * sizeof(int32_t);
    return t;
}
constexpr auto kFullBPersistent = FullBPersistentTiling();
static_assert(kFullBPersistent.baseM == 64 && kFullBPersistent.baseN == 256 &&
    kFullBPersistent.baseK == 128 && kFullBPersistent.singleCoreK == 1024,
    "FullB persistent fixed M64/N256/K128 geometry");
static_assert(kFullBPersistent.dbL0A == 2 && kFullBPersistent.dbL0B == 2 &&
    2*64*128 <= 65536 && 2*256*128 == 65536,
    "FullB physical L0A/B capacities");
static_assert(kFullBPersistent.shareL1Size + 1024*256 <= 524288 &&
    kFullBPersistent.shareL0CSize == 65536 && 2*64*256*sizeof(int32_t) == 131072,
    "FullB SDK L1 plus external B and OUTER C lenFactor2 fit");
static_assert(kFullBPersistent.stepM == 1 && kFullBPersistent.stepN == 1 &&
    kFullBPersistent.stepKa == 1 && kFullBPersistent.stepKb == 1 &&
    kFullBPersistent.depthA1 == 2 && kFullBPersistent.depthB1 == 2 &&
    kFullBPersistent.shareL1Size == 20480 && kFullBPersistent.transLength == 65536 &&
    kFullBPersistent.shareUbSize == 0,
    "FullB SDK A1=16384, quant=4096; external B is not reallocated by SDK");
static_assert(!AscendC::NoTailM(kFullBPersistent) && !AscendC::NoTailN(kFullBPersistent) &&
    !AscendC::NoTailK(kFullBPersistent) && !AscendC::IsBasicK(kFullBPersistent),
    "FullB runtime M/N tails and complete K reduction");
using FullBPersistentMM = matmul::MatmulImpl<AType,FullBType,CType,BiasType,kFullBPersistent,
    AscendC::MatmulCallBackFunc<nullptr,nullptr,nullptr>,AscendC::Impl::Detail::GmmPairMdlPolicy>;

struct FullBJob { uint32_t expert,row,col,curM,curN; };
// Exactly one shared expert/coarse-M/N enumeration on AIC and both AIVs.
// The coarse ordinal owns the whole bundle; each party then walks M64 pieces.
template<class GroupTensor>
class FullBJobIterator {
public:
    __aicore__ inline FullBJobIterator(const Tiling& t,const GroupTensor& g,uint32_t core)
        :t_(t),groups_(g),core_(core) {}
    __aicore__ inline bool Next(FullBJob& job)
    {
        const uint32_t nt=CeilDiv(t_.n,256);
        while(expert_<t_.groups) {
            const uint32_t end=static_cast<uint32_t>(groups_.GetValue(expert_));
            const uint32_t rows=end-previous_;
            const uint32_t jobs=CeilDiv(rows,kFullBSpan)*nt;
            if(!started_) {
                task_=(core_+t_.cores-base_)%t_.cores;
                started_=true;
            }
            if(task_<jobs) {
                const uint32_t id=task_; task_+=t_.cores;
                const uint32_t rowTile=id/nt;
                const uint32_t col=ColumnTileOrder(expert_,rowTile,id%nt,nt)*256;
                const uint32_t row=rowTile*kFullBSpan;
                job={expert_,previous_+row,col,Min(kFullBSpan,rows-row),Min(256U,t_.n-col)};
                return true;
            }
            base_=(base_+jobs)%t_.cores;
            previous_=end; ++expert_; started_=false;
        }
        return false;
    }
private:
    const Tiling& t_; const GroupTensor& groups_; uint32_t core_;
    uint32_t expert_=0,previous_=0,base_=0,task_=0; bool started_=false;
};

// This gate runs on Device before ANY Matmul/private-buffer Init. No Host GL read.
static __aicore__ inline bool CanUseFullBPersistent(const Tiling& t,GM_ADDR groupList)
{
    if(t.reserved!=2 || (t.tileM!=128 && t.tileM!=256) || t.tileN!=256 || t.cores==0 ||
       t.k==0 || t.k>1024 || t.k%32 || t.n==0) return false;
    GlobalTensor<int64_t> groups;
    groups.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groupList));
    uint32_t previous=0,maxRows=0; uint64_t jobs=0;
    for(uint32_t e=0;e<t.groups;++e) {
        const int64_t raw=groups.GetValue(e);
        if(raw<previous || raw>t.m) return false;
        const uint32_t end=static_cast<uint32_t>(raw),rows=end-previous;
        maxRows=rows>maxRows?rows:maxRows;
        jobs+=static_cast<uint64_t>(CeilDiv(rows,kFullBSpan))*CeilDiv(t.n,256);
        previous=end;
    }
    // A larger span must actually eliminate a B reload relative to its smaller span.
    const uint32_t priorSpan=kFullBSpan==512?256:512;
    return previous==t.m && maxRows>priorSpan && jobs>=t.cores;
}

// HT55_PADDED_COARSE_STREAM_GATE_BEGIN
static __aicore__ inline bool CanUseFullBPaddedCoarseStream(const Tiling& t,GM_ADDR groupList)
{
    if(t.reserved!=2 || (t.tileM!=128 && t.tileM!=256) || t.tileN!=256 ||
       t.cores==0 || t.groups==0 || t.groups>128 || t.k==0 || t.k>1024 ||
       t.k%32==0 || t.n==0) return false;
    const uint32_t kPitch=(t.k+31U)&~31U;
    if(kPitch*256U>1024U*256U ||
       kPitch*256U+kFullBPersistent.shareL1Size>524288U) return false;
    GlobalTensor<int64_t> groups;
    groups.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groupList));
    uint32_t previous=0,maxRows=0;uint64_t oldBundles=0,newBundles=0;
    for(uint32_t e=0;e<t.groups;++e) {
        const int64_t raw=groups.GetValue(e);
        if(raw<previous || raw>t.m) return false;
        const uint32_t end=static_cast<uint32_t>(raw),rows=end-previous;
        maxRows=rows>maxRows?rows:maxRows;
        oldBundles+=CeilDiv(rows,t.tileM);
        newBundles+=CeilDiv(rows,kFullBSpan);previous=end;
    }
    const uint64_t nt=(static_cast<uint64_t>(t.n)+255)/256;
    if(previous!=t.m || maxRows<=512 || newBundles*nt<t.cores ||
       newBundles>=oldBundles) return false;
    // Exact logical saved GM-B bytes must exceed the explicit K-tail zero bytes.
    // Divide by positive N to keep the comparison free of large M*K*N products.
    const uint64_t savedPerColumn=(oldBundles-newBundles)*t.k;
    const uint64_t clearPerColumn=newBundles*(kPitch-t.k);
    const uint64_t paddedN=(static_cast<uint64_t>(t.n)+31)/32*32;
    return savedPerColumn>clearPerColumn+clearPerColumn*(paddedN-t.n)/t.n;
}
static __aicore__ inline void RunFullBPaddedCoarseStreamAic(AscendC::TPipe& pipe,
    const Tiling& t,GM_ADDR x,GM_ADDR weight,GM_ADDR groupList,GM_ADDR workspace);
// HT55_PADDED_COARSE_STREAM_GATE_END

class FullBPersistentAicProducer {
public:
    __aicore__ inline FullBPersistentAicProducer(FullBPersistentMM& mm,AscendC::TPipe& pipe,const Tiling& t)
        :mm_(mm),pipe_(pipe),t_(t) {}
    __aicore__ inline void Init(GM_ADDR x,GM_ADDR weight,GM_ADDR groups,GM_ADDR workspace)
    {
        x_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
        w_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(weight));
        groups_.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups));
        c_.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(workspace));
        core_=AscendC::GetBlockIdx();
        pipe_.InitBuffer(bScm_,1,1024*256*sizeof(int8_t));
        bReadDone_=pipe_.AllocEventID<AscendC::HardEvent::MTE1_MTE2>();
    }
    __aicore__ inline void Process()
    {
        FullBJobIterator<GlobalTensor<int64_t>> it(t_,groups_,core_);
        FullBJob job;
        while(it.Next(job)) {
            auto b=bScm_.AllocTensor<int8_t>();
            // Non-transposed logical KxcurN B, NZ [ceil(N/32),K/16,16,32].
            // dstNzC0Stride is the complete physical K, NOT the K128 panel.
            // Gate enforces K%32=0; ND2NZ zeros the final N32 block padding.
            AscendC::Nd2NzParams p{};
            p.ndNum=1; p.nValue=t_.k; p.dValue=job.curN; p.srcDValue=t_.n;
            p.dstNzC0Stride=t_.k; p.dstNzNStride=1;
            AscendC::DataCopy(b,w_[static_cast<uint64_t>(job.expert)*t_.k*t_.n+job.col],p);
            bScm_.EnQue(b); b=bScm_.DeQue<int8_t>();
            for(uint32_t offset=0;offset<job.curM;offset+=64) {
                ProduceMicro(job.row+offset,Min(64U,job.curM-offset),job.curN,b);
            }
            // The complete last B1->B2 read precedes any overwrite, independent
            // of GM-C free flags. This is the only lifetime of this resident B.
            AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(bReadDone_);
            AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(bReadDone_);
            bScm_.FreeTensor(b);
        }
        const uint32_t pending=Min(tileCount_,kSlots);
        for(uint32_t i=0;i<pending;++i) {
            const uint32_t slot=(tileCount_-pending+i)%kSlots;
            AscendC::CrossCoreWaitFlag(kFree+slot);
        }
        mm_.End();
        pipe_.ReleaseEventID<AscendC::HardEvent::MTE1_MTE2>(bReadDone_);
    }
private:
    __aicore__ inline void ProduceMicro(uint32_t row,uint32_t rows,uint32_t curN,
        const LocalTensor<int8_t>& b)
    {
        const uint32_t slotIdx=tileCount_%kSlots;
        const uint64_t slot=(static_cast<uint64_t>(core_)*kSlots+slotIdx)*64*256;
        if(tileCount_>=kSlots) AscendC::CrossCoreWaitFlag(kFree+slotIdx);
        // A remains ND/GM with true K stride; B is external NZ with full-K stride.
        // OrgKc writes one compact actual rows x curN C prefix per M64 micro-output.
        mm_.SetOrgShape(t_.m,256,t_.k,t_.k,curN);
        mm_.SetSingleShape(rows,curN,t_.k);
        mm_.SetTensorA(x_[static_cast<uint64_t>(row)*t_.k]);
        mm_.SetTensorB(b);
        while(mm_.Iterate()) mm_.GetTensorC(c_[slot],0,false);
        AscendC::CrossCoreSetFlag<2,PIPE_FIX>(kReady+slotIdx);
        ++tileCount_;
    }
    FullBPersistentMM& mm_; AscendC::TPipe& pipe_; const Tiling& t_;
    GlobalTensor<int8_t> x_,w_; GlobalTensor<int64_t> groups_; GlobalTensor<int32_t> c_;
    AscendC::TSCM<AscendC::TPosition::GM,1,&kFullAScmConfig> bScm_;
    AscendC::TEventID bReadDone_; uint32_t core_=0,tileCount_=0;
};
// HT55_B03_FULLB_END

class FullBPersistentAivConsumer {
public:
    __aicore__ inline FullBPersistentAivConsumer(AscendC::TPipe& pipe, const Tiling& t)
        : pipe_(pipe), t_(t) {}

    __aicore__ inline void Init(GM_ADDR scale, GM_ADDR groups, GM_ADDR y, GM_ADDR workspace)
    {
        scale_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scale));
        groups_.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups));
        groupBytes_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(groups));
        y_.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(y));
        c_.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(workspace));
        core_ = AscendC::GetBlockIdx() / AscendC::GetTaskRation();
        sub_ = AscendC::GetSubBlockIdx();
        // 151040 bytes: C65536 + scale2048 + half16384 + float65536
        // + mask512 + private group endpoints1024. Only this consumer is Init'd.
        pipe_.InitBuffer(inQ_, 2, kResidentCElems * sizeof(int32_t));
        pipe_.InitBuffer(scaleQ_, 2, kMaxN * sizeof(float));
        pipe_.InitBuffer(outQ_, 2, kBatchElems * sizeof(half));
        pipe_.InitBuffer(tmp_, 4 * kBatchElems * sizeof(float));
        pipe_.InitBuffer(masks_, kMaskBytes);
        pipe_.InitBuffer(groupCache_, 128 * sizeof(int64_t));
    }

    __aicore__ inline void Process()
    {
        LocalTensor<int64_t> localGroups = groupCache_.Get<int64_t>();
        const uint32_t groupBytes = t_.groups * sizeof(int64_t);
        AscendC::DataCopyExtParams gp{1, groupBytes, 0, 0, 0};
        AscendC::DataCopyPadExtParams<int8_t> gpad{true, 0,
            static_cast<uint8_t>((32 - groupBytes % 32) % 32), 0};
        AscendC::DataCopyPad(localGroups.ReinterpretCast<int8_t>(), groupBytes_, gp, gpad);
        const auto groupReady = pipe_.FetchEventID(AscendC::HardEvent::MTE2_S);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_S>(groupReady);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_S>(groupReady);
        FullBJobIterator<LocalTensor<int64_t>> it(t_,localGroups,core_);
        FullBJob job;
        ResidentTile pending{}; bool havePending=false; uint32_t tileCount=0;
        while(it.Next(job)) {
            for(uint32_t offset=0;offset<job.curM;offset+=64) {
                ResidentTile next{job.expert,job.row+offset,job.col,
                    Min(64U,job.curM-offset),job.curN,tileCount};
                if(havePending) Consume(pending);
                Stage(next); pending=next; havePending=true; ++tileCount;
            }
        }
        if(havePending) Consume(pending);
        const auto outputDone=pipe_.FetchEventID(AscendC::HardEvent::MTE3_S);
        AscendC::SetFlag<AscendC::HardEvent::MTE3_S>(outputDone);
        AscendC::WaitFlag<AscendC::HardEvent::MTE3_S>(outputDone);
    }

private:
    __aicore__ inline void Stage(const ResidentTile& d)
    {
        const uint32_t slotIdx = d.ordinal % kSlots;
        const uint32_t halfRows = CeilDiv(d.curM, 2);
        const uint32_t firstRow = sub_ * halfRows;
        const uint32_t lastRow = Min(firstRow + halfRows, d.curM);
        AscendC::CrossCoreWaitFlag(kReady + slotIdx);
        if (firstRow < lastRow) {
            const uint32_t dataN = CeilDiv(d.curN, 8) * 8;
            const uint32_t rowN = CeilDiv(d.curN, 16) * 16;
            const uint64_t slot = (static_cast<uint64_t>(core_) * kSlots + slotIdx)
                * t_.tileM * t_.tileN;
            LocalTensor<int32_t> ci = inQ_.AllocTensor<int32_t>();
            AscendC::DataCopyExtParams cp{static_cast<uint16_t>(lastRow - firstRow),
                static_cast<uint32_t>(d.curN * sizeof(int32_t)), 0, (rowN - dataN) / 8, 0};
            AscendC::DataCopyPadExtParams<int32_t> cpad{true, 0,
                static_cast<uint8_t>(dataN - d.curN), 0};
            AscendC::DataCopyPad(ci, c_[slot + static_cast<uint64_t>(firstRow) * d.curN], cp, cpad);
            // No later operation reads this GM slot: all owned rows have been
            // copied by the MTE2 stream before its mode2 release can execute.
            AscendC::CrossCoreSetFlag<2, PIPE_MTE2>(kFree + slotIdx);
            inQ_.EnQue(ci);

            LocalTensor<float> sc = scaleQ_.AllocTensor<float>();
            AscendC::DataCopyExtParams p{1, static_cast<uint32_t>(d.curN * sizeof(float)), 0, 0, 0};
            AscendC::DataCopyPadExtParams<float> pad{true, 0,
                static_cast<uint8_t>(dataN - d.curN), 0};
            AscendC::DataCopyPad(sc, scale_[static_cast<uint64_t>(d.e) * t_.n + d.col], p, pad);
            scaleQ_.EnQue(sc);
        } else {
            // The zero-row AIV still consumes ready and releases exactly once.
            AscendC::CrossCoreSetFlag<2, PIPE_MTE2>(kFree + slotIdx);
        }
    }

    __aicore__ inline void Consume(const ResidentTile& d)
    {
        const uint32_t halfRows = CeilDiv(d.curM, 2);
        const uint32_t firstRow = sub_ * halfRows;
        const uint32_t lastRow = Min(firstRow + halfRows, d.curM);
        if (firstRow >= lastRow) { return; }
        const uint32_t dataN = CeilDiv(d.curN, 8) * 8;
        const uint32_t rowN = CeilDiv(d.curN, 16) * 16;
        LocalTensor<int32_t> ci = inQ_.DeQue<int32_t>();
        LocalTensor<float> sc = scaleQ_.DeQue<float>();
        LocalTensor<float> z = tmp_.GetWithOffset<float>(kBatchElems, 0);
        LocalTensor<float> out = tmp_.GetWithOffset<float>(kBatchElems, kBatchElems * sizeof(float));
        LocalTensor<float> s0 = tmp_.GetWithOffset<float>(kBatchElems, 2 * kBatchElems * sizeof(float));
        LocalTensor<float> s1 = tmp_.GetWithOffset<float>(kBatchElems, 3 * kBatchElems * sizeof(float));
        auto signMask = masks_.GetWithOffset<uint8_t>(kMaskBytes, 0);
        for (uint32_t r = firstRow; r < lastRow; r += kBatchRows) {
            const uint32_t rows = Min(kBatchRows, lastRow - r);
            const uint32_t used = rows * rowN;
            const uint32_t count = CeilDiv(used, 64) * 64;
            const uint32_t cOffset = (r - firstRow) * rowN;
            AscendC::Duplicate(z, 0.0f, count);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::UnaryRepeatParams castRep{1, 1,
                static_cast<uint8_t>(rowN / 8), static_cast<uint8_t>(rowN / 8)};
            AscendC::BinaryRepeatParams mulRep{1, 1, 1,
                static_cast<uint8_t>(rowN / 8), static_cast<uint8_t>(rowN / 8), 0};
            for (uint32_t c = 0; c < dataN; c += 64) {
                const uint64_t mask = Min(64, dataN - c);
                AscendC::Cast(z[c], ci[cOffset + c], AscendC::RoundMode::CAST_NONE,
                    mask, static_cast<uint8_t>(rows), castRep);
            }
            AscendC::PipeBarrier<PIPE_V>();
            // V_MTE2 reverse lifetime only after the final private C read.
            if (r + rows == lastRow) { inQ_.FreeTensor(ci); }
            for (uint32_t c = 0; c < dataN; c += 64) {
                const uint64_t mask = Min(64, dataN - c);
                AscendC::Mul(z[c], z[c], sc[c], mask, static_cast<uint8_t>(rows), mulRep);
            }
            AscendC::PipeBarrier<PIPE_V>();
            if (r + rows == lastRow) { scaleQ_.FreeTensor(sc); }
            ApplyGeluSimple(out, z, s0, s1, signMask, count);
            LocalTensor<half> yo = outQ_.AllocTensor<half>();
            AscendC::Cast(yo, out, AscendC::RoundMode::CAST_RINT, count);
            AscendC::PipeBarrier<PIPE_V>();
            outQ_.EnQue(yo);
            yo = outQ_.DeQue<half>();
            AscendC::DataCopyExtParams yp{static_cast<uint16_t>(rows),
                static_cast<uint32_t>(d.curN * sizeof(half)), 0,
                static_cast<uint32_t>((t_.n - d.curN) * sizeof(half)), 0};
            AscendC::DataCopyPad(y_[static_cast<uint64_t>(d.row + r) * t_.n + d.col], yo, yp);
            outQ_.FreeTensor(yo);
        }
    }

    AscendC::TPipe& pipe_;
    const Tiling& t_;
    GlobalTensor<float> scale_;
    GlobalTensor<int64_t> groups_;
    GlobalTensor<int8_t> groupBytes_;
    GlobalTensor<int32_t> c_;
    GlobalTensor<half> y_;
    AscendC::TQue<AscendC::TPosition::VECIN, 2> inQ_, scaleQ_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 2> outQ_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tmp_, masks_, groupCache_;
    uint32_t core_ = 0, sub_ = 0;
};
// HT55_B03_FAMILY_INSERT_END
} // namespace gmm_gelu

__attribute__((aligned(64))) __global__ __mix__(1,2) void GmmCubeNorm64Whole32AliasComplete(GM_ADDR x,GM_ADDR weight,GM_ADDR scale,
 GM_ADDR groupList,GM_ADDR y,__kfc_workspace__ GM_ADDR workspace,GM_ADDR tilingGm) {
 if ASCEND_IS_AIC { AscendC::CrossCoreSetFlag<2,PIPE_MTE2>(0); }
 if ASCEND_IS_AIV { AscendC::CrossCoreWaitFlag(0); }
 AscendC::TPipe pipe;gmm_gelu::Tiling t;gmm_gelu::CopyTilingHeader(t,tilingGm);
 t.tileM=64;t.tileN=256;t.reserved=1;
 if ASCEND_IS_AIC {
 gmm_gelu::StaticMM mm;mm.SetSubBlockIdx(0);mm.Init(static_cast<const TCubeTiling*>(nullptr),&pipe);gmm_gelu::Kernel<gmm_gelu::StaticMM> op(mm,pipe,t);op.Init(x,weight,scale,groupList,y,workspace);op.Process();
 AscendC::CrossCoreWaitFlag(7);
 }
 if ASCEND_IS_AIV {
 gmm_gelu::Whole32AliasQ2Consumer op(pipe,t);op.Init(scale,groupList,y,workspace);op.Process();
 AscendC::CrossCoreSetFlag<2,PIPE_MTE3>(7);
 }
}

// M212_NATIVE_ENTRY_BEGIN: one complete business, selected by necessary Host metadata only.
__attribute__((aligned(64))) __global__ __mix__(1, 2) void GmmCubeNativeComplete(GM_ADDR x, GM_ADDR weight,
    GM_ADDR scale, GM_ADDR groupList, GM_ADDR y,
    __kfc_workspace__ GM_ADDR workspace, GM_ADDR tilingGm)
{
    AscendC::TPipe pipe;
    gmm_gelu::Tiling t;
    gmm_gelu::CopyTilingHeader(t, tilingGm);
    // Original Host FullA identity, captured before the Device selector changes mode.
    const bool parentFullAEntry = t.reserved == 2 && t.k >= 1024 && t.k <= 2048 &&
        t.k % 256 == 0 && t.n >= 512 && t.n % 256 == 0 && t.m % 128 == 0;
    if (parentFullAEntry) { gmm_gelu::CopyTilingTail(t, tilingGm); }
    gmm_gelu::ChooseActualGroupPairMode(t, groupList);
    if (!parentFullAEntry && t.reserved != 1) { gmm_gelu::CopyTilingTail(t, tilingGm); }

    // Preserve the original FullA entry's first complete-business decision.
    if (parentFullAEntry && gmm_gelu::CanUseFullA(t, groupList)) {
        if ASCEND_IS_AIC {
            gmm_gelu::FullAMM mm;
            mm.SetSubBlockIdx(0);
            mm.Init(&t.mm, &pipe);
            gmm_gelu::FullAAicProducer op(mm, pipe, t);
            op.Init(x, weight, groupList, workspace);
            op.Process();
        }
        if ASCEND_IS_AIV {
            gmm_gelu::StaticMM mm;
            gmm_gelu::FullAAivConsumer<gmm_gelu::StaticMM> op(mm, pipe, t);
            op.Init(x, weight, scale, groupList, y, workspace);
            op.Process();
        }
        return;
    }
    // The necessary Host guard has N in [513,768], so N%512 cannot be zero.
    // Original NStripe eligibility is therefore false only in this entry.
    if ASCEND_IS_AIV {
        if (gmm_gelu::CanUseResidentConsumer(t)) {
            gmm_gelu::ResidentAivConsumer op(pipe, t);
            op.Init(scale, groupList, y, workspace);
            op.Process();
            return;
        }
    }
    if ASCEND_IS_AIC {
        if (t.reserved == 2) {
            gmm_gelu::MdlPairMM mm;
            mm.SetSubBlockIdx(0);
            mm.Init(&t.mm, &pipe);
            gmm_gelu::MdlPairAicProducer op(mm, t);
            op.Init(x, weight, groupList, workspace);
            op.Process();
        } else {
            gmm_gelu::StaticMM mm;
            mm.SetSubBlockIdx(0);
            if (parentFullAEntry) {
                mm.Init(&t.mm, &pipe);
            } else {
                mm.Init(static_cast<const TCubeTiling*>(nullptr), &pipe);
            }
            gmm_gelu::Kernel<gmm_gelu::StaticMM> op(mm, pipe, t);
            op.Init(x, weight, scale, groupList, y, workspace);
            op.Process();
        }
    }
    if ASCEND_IS_AIV {
        // Parent common consumer; the Matmul reference shell is never Init'd on AIV.
        gmm_gelu::StaticMM mm;
        gmm_gelu::Kernel<gmm_gelu::StaticMM> op(mm, pipe, t);
        op.Init(x, weight, scale, groupList, y, workspace);
        op.Process();
    }
}
// M212_NATIVE_ENTRY_END

// Independent business entries; Host launches exactly one per invocation.
// L1_LOWK_ENTRY_BEGIN: one complete multirow AIV-only business in MIX(1,2).
__attribute__((aligned(64))) __global__ __mix__(1, 2) void GmmVectorLowKComplete(GM_ADDR x, GM_ADDR weight,
    GM_ADDR scale, GM_ADDR groupList, GM_ADDR y,
    __kfc_workspace__ GM_ADDR workspace, GM_ADDR tilingGm)
{
    if ASCEND_IS_AIC {
        return;
    }
    if ASCEND_IS_AIV {
        AscendC::TPipe pipe;
        gmm_gelu::Tiling t;
        gmm_gelu::CopyTiling(t, tilingGm);
        gmm_gelu::FusedLowKKernel lowk(pipe, t);
        lowk.Init(x, weight, scale, groupList, y);
        lowk.Process();
    }
}
// L1_LOWK_ENTRY_END

// K5_SINGLE_ROW_ENTRY_BEGIN: one complete single-row business launch.

// K5_SINGLE_ROW_ENTRY_END

__attribute__((aligned(64))) __global__ __mix__(1, 2) void GmmCubeDynamicComplete(GM_ADDR x, GM_ADDR weight,
    GM_ADDR scale, GM_ADDR groupList, GM_ADDR y,
    __kfc_workspace__ GM_ADDR workspace, GM_ADDR tilingGm)
{
    AscendC::TPipe pipe;
    gmm_gelu::Tiling t;
    gmm_gelu::CopyTiling(t, tilingGm);
    gmm_gelu::MM mm;
    if ASCEND_IS_AIC {
        mm.SetSubBlockIdx(0);
        mm.Init(&t.mm, &pipe);
    }
// M119_DYNAMIC_DISPATCH_BEGIN
    if ASCEND_IS_AIV {
        if (gmm_gelu::CanUseResidentConsumer(t)) {
            gmm_gelu::ResidentAivConsumer resident(pipe, t);
            resident.Init(scale, groupList, y, workspace);
            resident.Process();
            return;
        }
    }
// M119_DYNAMIC_DISPATCH_END
    gmm_gelu::Kernel<gmm_gelu::MM> op(mm, pipe, t);
    op.Init(x, weight, scale, groupList, y, workspace);
    op.Process();
}

__attribute__((aligned(64))) __global__ __mix__(1, 2) void GmmCubeStaticComplete(GM_ADDR x, GM_ADDR weight,
    GM_ADDR scale, GM_ADDR groupList, GM_ADDR y,
    __kfc_workspace__ GM_ADDR workspace, GM_ADDR tilingGm)
{
    AscendC::TPipe pipe;
    gmm_gelu::Tiling t;
    gmm_gelu::CopyTilingHeader(t, tilingGm);
    gmm_gelu::ChooseActualGroupPairMode(t, groupList);
    if (t.reserved != 1) { gmm_gelu::CopyTilingTail(t, tilingGm); }
    // HT55_PADDED_COARSE_STREAM_DISPATCH_BEGIN
    if(gmm_gelu::CanUseFullBPaddedCoarseStream(t,groupList)) {
        if ASCEND_IS_AIC {
            AscendC::CrossCoreSetFlag<2,PIPE_MTE2>(0);
            t.tileM=64;
            gmm_gelu::RunFullBPaddedCoarseStreamAic(pipe,t,x,weight,groupList,workspace);
            AscendC::CrossCoreWaitFlag(7);
        }
        if ASCEND_IS_AIV {
            AscendC::CrossCoreWaitFlag(0);
            t.tileM=64;
            gmm_gelu::FullBPersistentAivConsumer op(pipe,t);
            op.Init(scale,groupList,y,workspace);op.Process();
            AscendC::CrossCoreSetFlag<2,PIPE_MTE3>(7);
        }
        return;
    }
    // HT55_PADDED_COARSE_STREAM_DISPATCH_END
    // HT55_B03_DISPATCH_BEGIN: no resources from the parent branch coexist.
    if (gmm_gelu::CanUseFullBPersistent(t,groupList)) {
        if ASCEND_IS_AIC {
            AscendC::CrossCoreSetFlag<2,PIPE_MTE2>(0);
            t.tileM=64;
            gmm_gelu::FullBPersistentMM mm;
            mm.SetSubBlockIdx(0); mm.Init(&t.mm,&pipe);
            gmm_gelu::FullBPersistentAicProducer op(mm,pipe,t);
            op.Init(x,weight,groupList,workspace); op.Process();
            AscendC::CrossCoreWaitFlag(7);
        }
        if ASCEND_IS_AIV {
            AscendC::CrossCoreWaitFlag(0);
            t.tileM=64;
            gmm_gelu::FullBPersistentAivConsumer op(pipe,t);
            op.Init(scale,groupList,y,workspace); op.Process();
            AscendC::CrossCoreSetFlag<2,PIPE_MTE3>(7);
        }
        return;
    }
    // HT55_B03_DISPATCH_END
// M119_STATIC_DISPATCH_BEGIN
    if ASCEND_IS_AIV {
        if (gmm_gelu::CanUseResidentConsumer(t)) {
            gmm_gelu::ResidentAivConsumer resident(pipe, t);
            resident.Init(scale, groupList, y, workspace);
            resident.Process();
            return;
        }
    }
// M119_STATIC_DISPATCH_END
    if ASCEND_IS_AIC {
        // M19_RAW_AIC_BEGIN: branch before every library Matmul Init.
        if (t.reserved == 3) {
            if (t.tileN == 32) {
                gmm_gelu::RawAicProducer<32> op(pipe, t);
                op.Init(x, weight, groupList, workspace);
                op.Process();
            } else {
                gmm_gelu::RawAicProducer<> op(pipe, t);
                op.Init(x, weight, groupList, workspace);
                op.Process();
            }
        } else
        // M19_RAW_AIC_END
        // M21_AIC_BEGIN: mutually exclusive with the original pair and Norm.
        if (t.reserved == 5) {
            gmm_gelu::WideMPairMM mm;
            mm.SetSubBlockIdx(0);
            mm.Init(&t.mm, &pipe);
            gmm_gelu::WideMPairAicProducer op(mm, t);
            op.Init(x, weight, groupList, workspace);
            op.Process();
        } else
        // M21_AIC_END
        // Exactly one Matmul object is initialized on the executed branch.
        // No later CO1 allocation follows the MDL object's two-fragment pool.
        if (t.reserved == 2) {
            if (gmm_gelu::UseBFullKBundle(t)) {
                gmm_gelu::BFullKBundleMM mm;
                mm.SetSubBlockIdx(0);
                mm.Init(&t.mm, &pipe);
                gmm_gelu::BFullKBundleAicProducer op(mm, t);
                op.Init(x, weight, groupList, workspace);
                op.Process();
            } else {
                gmm_gelu::MdlPairMM mm;
                mm.SetSubBlockIdx(0);
                mm.Init(&t.mm, &pipe);
                gmm_gelu::MdlPairAicProducer op(mm, t);
                op.Init(x, weight, groupList, workspace);
                op.Process();
            }
        } else {
            gmm_gelu::StaticMM mm;
            mm.SetSubBlockIdx(0);
            if (t.reserved == 1) {
                mm.Init(static_cast<const TCubeTiling*>(nullptr), &pipe);
            } else {
                mm.Init(&t.mm, &pipe);
            }
            gmm_gelu::Kernel<gmm_gelu::StaticMM> op(mm, pipe, t);
            op.Init(x, weight, scale, groupList, y, workspace);
            op.Process();
        }
    }
    if ASCEND_IS_AIV {
        // One unchanged AIV/numeric path for both Static Norm and MDL.
        // This uninitialized Matmul object is never called on the AIV.
        gmm_gelu::StaticMM mm;
        gmm_gelu::Kernel<gmm_gelu::StaticMM> op(mm, pipe, t);
        op.Init(x, weight, scale, groupList, y, workspace);
        op.Process();
    }
}


__attribute__((aligned(64))) __global__ __mix__(1, 2) void GmmCubeDirectComplete(
    GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groupList, GM_ADDR y,
    __kfc_workspace__ GM_ADDR workspace, GM_ADDR tilingGm)
{
    if ASCEND_IS_AIC {
        // AV must not read even the header or Init before this active AIC starts.
        AscendC::CrossCoreSetFlag<2, PIPE_MTE2>(gmm_gelu::kDirectStartGo);
        AscendC::TPipe pipe;
        gmm_gelu::Tiling t;
        gmm_gelu::CopyTilingHeader(t, tilingGm);
        if (gmm_gelu::HasUniform64Groups(t, groupList)) {
            gmm_gelu::Uniform64DirectAicProducer op(pipe, t);
            op.Init(x, weight, workspace);
            op.Process();
        } else {
            // so this is exactly the original Static producer, including tails.
            gmm_gelu::StaticMM mm;
            mm.SetSubBlockIdx(0);
            mm.Init(static_cast<const TCubeTiling*>(nullptr), &pipe);
            gmm_gelu::Kernel<gmm_gelu::StaticMM> op(mm, pipe, t);
            op.Init(x, weight, scale, groupList, y, workspace);
            op.Process();
        }
        // Resident's slot free is MTE2-only. BOTH AV final Y acks are required.
        AscendC::CrossCoreWaitFlag(gmm_gelu::kDirectFinalYDone);
    }
    if ASCEND_IS_AIV {
        AscendC::CrossCoreWaitFlag(gmm_gelu::kDirectStartGo);
        AscendC::TPipe pipe;
        gmm_gelu::Tiling t;
        gmm_gelu::CopyTilingHeader(t, tilingGm);
        gmm_gelu::ResidentAivConsumer op(pipe, t);
        op.Init(scale, groupList, y, workspace);
        op.Process(); // Original final MTE3_S drain precedes this return.
        AscendC::CrossCoreSetFlag<2, PIPE_MTE3>(gmm_gelu::kDirectFinalYDone);
    }
}
// M257_ENTRY_END

// M127_ENTRY_BEGIN: isolated resources; unchanged original entries remain available.
__attribute__((aligned(64))) __global__ __mix__(1,2) void GmmCubeFullAK256Complete(GM_ADDR x,GM_ADDR weight,
    GM_ADDR scale,GM_ADDR groupList,GM_ADDR y,__kfc_workspace__ GM_ADDR workspace,GM_ADDR tilingGm,
    uint32_t nStripeFallback)
{
    AscendC::TPipe pipe;gmm_gelu::Tiling t;
    gmm_gelu::CopyTiling(t,tilingGm);
    gmm_gelu::ChooseActualGroupPairMode(t,groupList);
    if(gmm_gelu::CanUseFullA(t,groupList)) {
        if ASCEND_IS_AIC {
            gmm_gelu::FullAMM mm;mm.SetSubBlockIdx(0);mm.Init(&t.mm,&pipe);
            gmm_gelu::FullAAicProducer op(mm,pipe,t);
            op.Init(x,weight,groupList,workspace);op.Process();
        }
        if ASCEND_IS_AIV {
            gmm_gelu::StaticMM mm;
            gmm_gelu::FullAAivConsumer<gmm_gelu::StaticMM> op(mm,pipe,t);
            op.Init(x,weight,scale,groupList,y,workspace);op.Process();
        }
        return;
    }
    if(nStripeFallback && t.reserved==1) {
        if ASCEND_IS_AIC {
            gmm_gelu::NStripeMM mm;mm.SetSubBlockIdx(0);mm.Init(&t.mm,&pipe);
            gmm_gelu::NStripeAicProducer op(mm,t);op.Init(x,weight,groupList,workspace);op.Process();
        }
        if ASCEND_IS_AIV {
            gmm_gelu::StaticMM mm;gmm_gelu::NStripeAivConsumer<gmm_gelu::StaticMM> op(mm,pipe,t);
            op.Init(x,weight,scale,groupList,y,workspace);op.Process();
        }
        return;
    }
    if ASCEND_IS_AIV {
        if(gmm_gelu::CanUseResidentConsumer(t)) {
            gmm_gelu::ResidentAivConsumer op(pipe,t);op.Init(scale,groupList,y,workspace);op.Process();return;
        }
    }
    if ASCEND_IS_AIC {
        if(t.reserved==2) {
            gmm_gelu::MdlPairMM mm;mm.SetSubBlockIdx(0);mm.Init(&t.mm,&pipe);
            gmm_gelu::MdlPairAicProducer op(mm,t);op.Init(x,weight,groupList,workspace);op.Process();
        } else {
            gmm_gelu::StaticMM mm;mm.SetSubBlockIdx(0);mm.Init(&t.mm,&pipe);
            gmm_gelu::Kernel<gmm_gelu::StaticMM> op(mm,pipe,t);
            op.Init(x,weight,scale,groupList,y,workspace);op.Process();
        }
    }
    if ASCEND_IS_AIV {
        gmm_gelu::StaticMM mm;gmm_gelu::Kernel<gmm_gelu::StaticMM> op(mm,pipe,t);
        op.Init(x,weight,scale,groupList,y,workspace);op.Process();
    }
}
// M127_ENTRY_END

// M254_ENTRY_BEGIN: isolated resources; unchanged original entries remain available.
__attribute__((aligned(64))) __global__ __mix__(1,2) void GmmCubeFullAK128Complete(GM_ADDR x,GM_ADDR weight,
    GM_ADDR scale,GM_ADDR groupList,GM_ADDR y,__kfc_workspace__ GM_ADDR workspace,GM_ADDR tilingGm,
    uint32_t nStripeFallback)
{
    AscendC::TPipe pipe;gmm_gelu::Tiling t;
    gmm_gelu::CopyTiling(t,tilingGm);
    gmm_gelu::ChooseActualGroupPairMode(t,groupList);
    if(gmm_gelu::CanUseFullA(t,groupList)) {
        // Both participants use one shared ThreeN descriptor sequence.
        if(gmm_gelu::CanUseFullAThreeBundle(t)) {
            if constexpr (AscendC::Impl::Detail::MatmulFeatureTrait<gmm_gelu::kP5M128UnitFlag>::IsUnitFlagEnabled()) {
                if ASCEND_IS_AIC {
                    gmm_gelu::P5M128UnitFlagMM mm;mm.SetSubBlockIdx(0);
                    mm.Init(static_cast<const TCubeTiling*>(nullptr),&pipe);
                    gmm_gelu::P5M128UnitFlagAicProducer op(mm,pipe,t);
                    op.Init(x,weight,groupList,workspace);op.Process();
                }
                if ASCEND_IS_AIV {
                    gmm_gelu::StaticMM mm;
                    gmm_gelu::FullAThreeBundleAivConsumer<gmm_gelu::StaticMM> op(mm,pipe,t);
                    op.Init(x,weight,scale,groupList,y,workspace);op.Process();
                }
                return;
            }
            // Unsupported feature keeps the exact original complete factory below.
            if ASCEND_IS_AIC {
                gmm_gelu::FullAK128MM mm;mm.SetSubBlockIdx(0);
                mm.Init(static_cast<const TCubeTiling*>(nullptr),&pipe);
                gmm_gelu::FullAThreeBundleAicProducer op(mm,pipe,t);
                op.Init(x,weight,groupList,workspace);op.Process();
            }
            if ASCEND_IS_AIV {
                gmm_gelu::StaticMM mm;
                gmm_gelu::FullAThreeBundleAivConsumer<gmm_gelu::StaticMM> op(mm,pipe,t);
                op.Init(x,weight,scale,groupList,y,workspace);op.Process();
            }
            return;
        }
        if ASCEND_IS_AIC {
            gmm_gelu::FullAK128MM mm;mm.SetSubBlockIdx(0);
            // Static table initialization cannot import the original t.mm K256/db1.
            mm.Init(static_cast<const TCubeTiling*>(nullptr),&pipe);
            gmm_gelu::FullAK128AicProducer op(mm,pipe,t);
            op.Init(x,weight,groupList,workspace);op.Process();
        }
        if ASCEND_IS_AIV {
            gmm_gelu::StaticMM mm;
            gmm_gelu::FullAAivConsumer<gmm_gelu::StaticMM> op(mm,pipe,t);
            op.Init(x,weight,scale,groupList,y,workspace);op.Process();
        }
        return;
    }
    if(nStripeFallback && t.reserved==1) {
        if ASCEND_IS_AIC {
            gmm_gelu::NStripeMM mm;mm.SetSubBlockIdx(0);mm.Init(&t.mm,&pipe);
            gmm_gelu::NStripeAicProducer op(mm,t);op.Init(x,weight,groupList,workspace);op.Process();
        }
        if ASCEND_IS_AIV {
            gmm_gelu::StaticMM mm;gmm_gelu::NStripeAivConsumer<gmm_gelu::StaticMM> op(mm,pipe,t);
            op.Init(x,weight,scale,groupList,y,workspace);op.Process();
        }
        return;
    }
    if ASCEND_IS_AIV {
        if(gmm_gelu::CanUseResidentConsumer(t)) {
            gmm_gelu::ResidentAivConsumer op(pipe,t);op.Init(scale,groupList,y,workspace);op.Process();return;
        }
    }
    if ASCEND_IS_AIC {
        if(t.reserved==2) {
            gmm_gelu::MdlPairMM mm;mm.SetSubBlockIdx(0);mm.Init(&t.mm,&pipe);
            gmm_gelu::MdlPairAicProducer op(mm,t);op.Init(x,weight,groupList,workspace);op.Process();
        } else {
            gmm_gelu::StaticMM mm;mm.SetSubBlockIdx(0);mm.Init(&t.mm,&pipe);
            gmm_gelu::Kernel<gmm_gelu::StaticMM> op(mm,pipe,t);
            op.Init(x,weight,scale,groupList,y,workspace);op.Process();
        }
    }
    if ASCEND_IS_AIV {
        gmm_gelu::StaticMM mm;gmm_gelu::Kernel<gmm_gelu::StaticMM> op(mm,pipe,t);
        op.Init(x,weight,scale,groupList,y,workspace);op.Process();
    }
}
// M254_ENTRY_END

// M120_NSTRIPE_ENTRY_BEGIN
// Host eligibility is metadata-only. Real group selection stays in this one
// complete business entry, independently and identically on AIC and both AIVs.
__attribute__((aligned(64))) __global__ __mix__(1, 2) void GmmCubeNStripeComplete(GM_ADDR x, GM_ADDR weight,
    GM_ADDR scale, GM_ADDR groupList, GM_ADDR y,
    __kfc_workspace__ GM_ADDR workspace, GM_ADDR tilingGm)
{
    AscendC::TPipe pipe;
    gmm_gelu::Tiling t;
    gmm_gelu::CopyTiling(t, tilingGm);
    gmm_gelu::ChooseActualGroupPairMode(t, groupList);
    if (t.reserved == 1) {
        if ASCEND_IS_AIC {
            gmm_gelu::NStripeMM mm;
            mm.SetSubBlockIdx(0);
            mm.Init(&t.mm, &pipe);
            gmm_gelu::NStripeAicProducer op(mm, t);
            op.Init(x, weight, groupList, workspace);
            op.Process();
        }
        if ASCEND_IS_AIV {
            gmm_gelu::StaticMM mm;
            gmm_gelu::NStripeAivConsumer<gmm_gelu::StaticMM> op(mm, pipe, t);
            op.Init(x, weight, scale, groupList, y, workspace);
            op.Process();
        }
        return;
    }
    // either changes mode2 to Norm1 or retains the complete MDL2 business.
    if ASCEND_IS_AIV {
        if (gmm_gelu::CanUseResidentConsumer(t)) {
            gmm_gelu::ResidentAivConsumer resident(pipe, t);
            resident.Init(scale, groupList, y, workspace);
            resident.Process();
            return;
        }
    }
    if ASCEND_IS_AIC {
        gmm_gelu::MdlPairMM mm;
        mm.SetSubBlockIdx(0);
        mm.Init(&t.mm, &pipe);
        gmm_gelu::MdlPairAicProducer op(mm, t);
        op.Init(x, weight, groupList, workspace);
        op.Process();
    }
    if ASCEND_IS_AIV {
        gmm_gelu::StaticMM mm;
        gmm_gelu::Kernel<gmm_gelu::StaticMM> op(mm, pipe, t);
        op.Init(x, weight, scale, groupList, y, workspace);
        op.Process();
    }
}
// M120_NSTRIPE_ENTRY_END

// NARROW_ALIGNED_INPUTS_ENTRY_BEGIN
namespace gmm_gelu {
static __aicore__ inline void CopyAlignedInputRows(AscendC::TPipe& pipe,
    const Tiling& t, GM_ADDR src, GM_ADDR dst, uint64_t totalRows,
    uint32_t logicalWidth, uint32_t physicalWidth, LocalTensor<int8_t> staging,
    AscendC::TEventID inputDone, AscendC::TEventID outputDone)
{
    GlobalTensor<int8_t> input, output;
    input.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(src));
    output.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(dst));
    const uint32_t rowsPerBatch = 32768U / physicalWidth;
    const uint64_t jobs = (totalRows + rowsPerBatch - 1) / rowsPerBatch;
    const uint32_t worker = AscendC::GetBlockIdx();
    const uint32_t workers = t.cores * AscendC::GetTaskRation();
    for (uint64_t job=worker; job<jobs; job+=workers) {
        const uint64_t first = job * rowsPerBatch;
        const uint32_t rows = static_cast<uint32_t>(
            totalRows-first < rowsPerBatch ? totalRows-first : rowsPerBatch);
        AscendC::DataCopyExtParams cp{static_cast<uint16_t>(rows),logicalWidth,0,0,0};
        AscendC::DataCopyPadExtParams<int8_t> pad{true,0,
            static_cast<uint8_t>(physicalWidth-logicalWidth),0};
        AscendC::DataCopyPad(staging,input[first*logicalWidth],cp,pad);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_S>(inputDone);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_S>(inputDone);
        // The flat padded batch is 32-byte aligned in both UB and GM.
        AscendC::DataCopy(output[first*physicalWidth],staging,rows*physicalWidth);
        AscendC::SetFlag<AscendC::HardEvent::MTE3_S>(outputDone);
        AscendC::WaitFlag<AscendC::HardEvent::MTE3_S>(outputDone);
    }
}
static __aicore__ inline void PrepareAlignedInputs(AscendC::TPipe& pipe,
    const Tiling& t, GM_ADDR x, GM_ADDR weight, GM_ADDR paddedX, GM_ADDR paddedW)
{
    AscendC::TBuf<AscendC::TPosition::VECCALC> staging;
    pipe.InitBuffer(staging,32768);
    auto bytes=staging.Get<int8_t>();
    const auto inputDone=pipe.FetchEventID(AscendC::HardEvent::MTE2_S);
    const auto outputDone=pipe.FetchEventID(AscendC::HardEvent::MTE3_S);
    // An aligned side already has the required physical row stride.
    if(t.k%32U!=0) {
        CopyAlignedInputRows(pipe,t,x,paddedX,t.m,t.k,(t.k+31U)&~31U,bytes,inputDone,outputDone);
    }
    if(t.n%32U!=0) {
        CopyAlignedInputRows(pipe,t,weight,paddedW,static_cast<uint64_t>(t.groups)*t.k,
            t.n,(t.n+31U)&~31U,bytes,inputDone,outputDone);
    }
}
}
__schedmode__(1) __attribute__((aligned(64))) __global__ __mix__(1,2)
void GmmCubeNarrowAlignedRawComplete(GM_ADDR x,GM_ADDR weight,GM_ADDR scale,
    GM_ADDR groupList,GM_ADDR y,__kfc_workspace__ GM_ADDR workspace,GM_ADDR tilingGm)
{
    AscendC::TPipe pipe; gmm_gelu::Tiling t; gmm_gelu::CopyTiling(t,tilingGm);
    const uint32_t xPitch=(t.k+31U)&~31U,wPitch=(t.n+31U)&~31U;
    const uint64_t ringBytes=static_cast<uint64_t>(t.cores)*gmm_gelu::kSlots*
        t.tileM*t.tileN*sizeof(int32_t);
    // Scratch contains only sides whose original row stride needs padding.
    const uint64_t packedXBytes=t.k%32U!=0?static_cast<uint64_t>(t.m)*xPitch:0;
    GM_ADDR paddedX=t.k%32U!=0?workspace+ringBytes:x;
    GM_ADDR paddedW=t.n%32U!=0?workspace+ringBytes+packedXBytes:weight;
    if ASCEND_IS_AIV {
        // Every batch's MTE3_S wait closes its GM publication and UB reuse.
        gmm_gelu::PrepareAlignedInputs(pipe,t,x,weight,paddedX,paddedW);
        // PrepareAlignedInputs has returned: its TBuf is out of scope.
        // Reset is deferred until the common publication barrier completes.
    }
    // All launched AICs and both AIVs participate, including idle workers.
    // Native flags11..14 are disjoint from the subsequent ring Ready/Free.
    AscendC::SyncAll<false>();
    if ASCEND_IS_AIV {
        // Only AIV resets: AIC retains TPipe's pre-set M_MTE1 event state.
        pipe.Reset();
    }
    if ASCEND_IS_AIC {
        if(t.tileN==32) {
            gmm_gelu::RawAicProducer<32> op(pipe,t,xPitch,wPitch);
            op.Init(paddedX,paddedW,groupList,workspace);op.Process();
        } else {
            gmm_gelu::RawAicProducer<> op(pipe,t,xPitch,wPitch);
            op.Init(paddedX,paddedW,groupList,workspace);op.Process();
        }
    }
    if ASCEND_IS_AIV {
        if(gmm_gelu::CanUseResidentConsumer(t)) {
            gmm_gelu::ResidentAivConsumer op(pipe,t);
            op.Init(scale,groupList,y,workspace);op.Process();
        } else {
            gmm_gelu::StaticMM mm;
            gmm_gelu::Kernel<gmm_gelu::StaticMM> op(mm,pipe,t);
            op.Init(x,weight,scale,groupList,y,workspace);op.Process();
        }
    }
}
// NARROW_ALIGNED_INPUTS_ENTRY_END

// S1_ENTRY_BEGIN: all launched workers participate exactly once, including idle workers.
__schedmode__(1) __attribute__((aligned(64))) __global__ __mix__(1, 2) void GmmCubeRawSplitComplete(GM_ADDR x, GM_ADDR weight,
    GM_ADDR scale, GM_ADDR groupList, GM_ADDR y,
    __kfc_workspace__ GM_ADDR workspace, GM_ADDR tilingGm)
{
    AscendC::TPipe pipe;
    gmm_gelu::Tiling t;
    gmm_gelu::CopyTiling(t, tilingGm);
    if ASCEND_IS_AIC {
        gmm_gelu::SplitKAicProducer op(pipe, t);
        op.Init(x, weight, groupList, workspace);
        op.Process();
    }
    // Native reserved flags 11..14 only. No per-slot Ready/Free protocol.
    AscendC::SyncAll<false>();
    if ASCEND_IS_AIV {
        gmm_gelu::SplitKReducer op(pipe, t);
        op.Init(scale, groupList, y, workspace);
        op.Process();
    }
}
// S1_ENTRY_END

// M25_WIDE_ENTRY_BEGIN: all launched workers participate exactly once, including idle workers.
__schedmode__(1) __attribute__((aligned(64))) __global__ __mix__(1, 2) void GmmCubeWideRawSplitComplete(GM_ADDR x, GM_ADDR weight,
    GM_ADDR scale, GM_ADDR groupList, GM_ADDR y,
    __kfc_workspace__ GM_ADDR workspace, GM_ADDR tilingGm)
{
    AscendC::TPipe pipe;
    gmm_gelu::Tiling t;
    gmm_gelu::CopyTiling(t, tilingGm);
    if ASCEND_IS_AIC {
        gmm_gelu::WideSplitKAicProducer op(pipe, t);
        op.Init(x, weight, groupList, workspace);
        op.Process();
    }
    // Native reserved flags 11..14 only. No per-slot Ready/Free protocol.
    AscendC::SyncAll<false>();
    if ASCEND_IS_AIV {
        gmm_gelu::WideSplitKReducer op(pipe, t);
        op.Init(scale, groupList, y, workspace);
        op.Process();
    }
}
// M25_WIDE_ENTRY_END

// M145_SMALLK_META_ENTRY_BEGIN
__attribute__((aligned(64))) __global__ __mix__(1, 2) void GmmVectorSmallComplete(GM_ADDR x, GM_ADDR weight,
    GM_ADDR scale, GM_ADDR groupList, GM_ADDR y,
    uint32_t scalarM, uint32_t scalarK, uint32_t scalarN, uint32_t scalarGroups)
{
    if ASCEND_IS_AIC {
        return;
    }
    if ASCEND_IS_AIV {
        // M156_K_AXIS_ENTRY_BEGIN: select before any old SmallK buffer Init.
        if (scalarGroups == 1 && scalarM >= 1 && scalarM <= 16 &&
            scalarK >= 17 && scalarK <= 1024 && scalarN >= 1 &&
            static_cast<uint64_t>(scalarM) * scalarN <= 64 &&
            static_cast<uint64_t>(scalarK) * scalarN <= 16384 &&
            static_cast<uint64_t>(scalarM) * scalarN * scalarK <= 32768) {
            AscendC::TPipe dotPipe;
            const gmm_gelu::SmallKMeta dotShape{scalarM, scalarK, scalarN, scalarGroups, 1U};
            gmm_gelu::KAxisDotKernel dot(dotPipe, dotShape);
            dot.Init(x, weight, scale, y);
            dot.Process();
            return;
        }
        // M156_K_AXIS_ENTRY_END
        // Preserve the original raw-AIV mapping and M1 early return.
        if (AscendC::GetBlockIdx() != 0) {
            if (AscendC::GetBlockIdx() != 1) {
                return;
            }
            if (scalarM == 1) {
                return;
            }
        }
        // M163_CAPACITY_ENTRY_BEGIN: old specialized routes retain priority.
        const uint64_t capacityHalfRows = (static_cast<uint64_t>(scalarM) + 1) / 2;
        const uint64_t capacityRowN = ((static_cast<uint64_t>(scalarN) + 15) / 16) * 16;
        const uint64_t capacityWeightN = ((static_cast<uint64_t>(scalarN) + 31) / 32) * 32;
        if (GMM_CHOOSE_CAPACITY_OWNER(scalarM, scalarK, scalarN, scalarGroups,
            capacityHalfRows, capacityRowN, capacityWeightN)) {
            AscendC::TPipe capacityPipe;
            const gmm_gelu::SmallKMeta capacityShape{scalarM, scalarK, scalarN, scalarGroups, 1U};
            gmm_gelu::CapacitySmallKKernel capacity(capacityPipe, capacityShape);
            capacity.Init(x, weight, scale, y);
            capacity.Process();
            return; // capacityPipe owns queue drain and final output completion.
        }
        // M163_CAPACITY_ENTRY_END
        // reserved4 Host dispatch always launches one original mix(1,2) block.
        const gmm_gelu::SmallKMeta shape{scalarM, scalarK, scalarN, scalarGroups, 1U};
        gmm_gelu::SmallKKernel small(shape);
        small.Init(x, weight, scale, groupList, y);
        small.Process();
        small.Finish();
    }
}
// M145_SMALLK_META_ENTRY_END
// M228_TINY_ENTRY_BEGIN
__attribute__((aligned(64))) __global__ __mix__(1, 2) void GmmVectorTinyComplete(
    GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groupList, GM_ADDR y,
    uint32_t scalarM, uint32_t scalarK, uint32_t scalarN)
{
    if ASCEND_IS_AIC {
        return;
    }
    if ASCEND_IS_AIV {
        if (AscendC::GetBlockIdx() > 1U) { return; }
        AscendC::TPipe tinyPipe;
        const gmm_gelu::SmallKMeta shape{scalarM, scalarK, scalarN, 1U, 1U};
        gmm_gelu::TinyE1Kernel tiny(tinyPipe, shape);
        tiny.Init(x, weight, scale, y);
        tiny.Process(); // TPipe owns the queue drain and final MTE3 completion.
    }
}
// M228_TINY_ENTRY_END
// HT05_ENTRIES_BEGIN


// HT05_ENTRIES_END
// HT06_ENTRIES_BEGIN
__attribute__((aligned(64))) __global__ __mix__(1, 2) void GmmCubeWhole32Complete(
    GM_ADDR x, GM_ADDR weight, GM_ADDR scale, GM_ADDR groupList, GM_ADDR y,
    __kfc_workspace__ GM_ADDR workspace, GM_ADDR tilingGm)
{
    AscendC::TPipe pipe;
    gmm_gelu::Tiling t;
    gmm_gelu::CopyTilingHeader(t, tilingGm);
    if ASCEND_IS_AIC {
        gmm_gelu::StaticMM mm;
        mm.SetSubBlockIdx(0);
        mm.Init(static_cast<const TCubeTiling*>(nullptr), &pipe);
        gmm_gelu::Kernel<gmm_gelu::StaticMM> op(mm, pipe, t);
        op.Init(x, weight, scale, groupList, y, workspace);
        op.Process();
    }
    if ASCEND_IS_AIV {
        gmm_gelu::P4InputLookaheadConsumer resident(pipe, t);
        resident.Init(scale, groupList, y, workspace);
        resident.Process();
    }
}

// HT06_ENTRIES_END
// HT06_ENTRIES_BEGIN

// HT06_ENTRIES_END
// HT16_ENTRY_BEGIN
__attribute__((aligned(64))) __global__ __mix__(1,2) void GmmVectorRowComplete(GM_ADDR x,GM_ADDR weight,GM_ADDR scale,GM_ADDR groupList,GM_ADDR y,uint32_t scalarM,uint32_t scalarK,uint32_t scalarN,uint32_t scalarGroups) {
 if ASCEND_IS_AIC {return;}
 if ASCEND_IS_AIV {
  if(AscendC::GetBlockIdx()!=0U) return;
  const gmm_gelu::SmallKMeta shape{scalarM,scalarK,scalarN,scalarGroups,1U};
  gmm_gelu::HT16TransposeDot op(shape);op.Init(x,weight,scale,groupList,y);op.Process();op.Finish();
 }
}
// HT16_ENTRY_END
// HT06_ENTRIES_BEGIN
__attribute__((aligned(64))) __global__ __mix__(1,2) void GmmCubeCompactComplete(GM_ADDR x,GM_ADDR weight,GM_ADDR scale,GM_ADDR groupList,GM_ADDR y,__kfc_workspace__ GM_ADDR workspace,GM_ADDR tilingGm) {
 AscendC::TPipe pipe;gmm_gelu::Tiling t;gmm_gelu::CopyTilingHeader(t,tilingGm);
 if ASCEND_IS_AIC {
  gmm_gelu::Compact32MM mm;mm.SetSubBlockIdx(0);mm.Init(static_cast<const TCubeTiling*>(nullptr),&pipe);
  gmm_gelu::Kernel<gmm_gelu::Compact32MM> op(mm,pipe,t);op.Init(x,weight,scale,groupList,y,workspace);op.Process();
 }
 if ASCEND_IS_AIV {
  gmm_gelu::Compact32MM mm;gmm_gelu::Kernel<gmm_gelu::Compact32MM> op(mm,pipe,t);op.Init(x,weight,scale,groupList,y,workspace);op.Process();
 }
 AscendC::PipeBarrier<PIPE_ALL>();
}
// HT06_ENTRIES_END
// HT26_ENTRIES_BEGIN
// HT26_ENTRIES_END

// HT55_B07_PARTIAL4_REFUSAL_ENTRIES_BEGIN
__schedmode__(1) __attribute__((aligned(64))) __global__ __mix__(1,2) void GmmCubePartial4RefusalComplete(
    GM_ADDR x,GM_ADDR weight,GM_ADDR scale,GM_ADDR groupList,GM_ADDR y,
    __kfc_workspace__ GM_ADDR workspace,GM_ADDR tilingGm)
{
    AscendC::TPipe pipe;gmm_gelu::Tiling t;gmm_gelu::CopyTiling(t,tilingGm);

    // HT55_B07_DIRECT_P1_BEGIN
    if(gmm_gelu::RefuseHT55ParentPartial4(t,groupList)) {
        if ASCEND_IS_AIC {
            // Exact parent full-K static factory. Never import P4 TCubeTiling or splice cfg.
            gmm_gelu::MdlPairMM mm;mm.SetSubBlockIdx(0);
            mm.Init(static_cast<const TCubeTiling*>(nullptr),&pipe);
            gmm_gelu::MdlPairAicProducer op(mm,t);
            op.Init(x,weight,groupList,workspace);op.Process();
        }
        if ASCEND_IS_AIV {
            // Original matching P1 ring consumer; shell is never Init'd on AIV.
            gmm_gelu::StaticMM mm;
            gmm_gelu::Kernel<gmm_gelu::StaticMM> op(mm,pipe,t);
            op.Init(x,weight,scale,groupList,y,workspace);op.Process();
        }
        // No Partial4 producer, INT32 reducer or split global barrier ran on this path.
        return;
    }
    // HT55_B07_DIRECT_P1_END

    if ASCEND_IS_AIC {
        gmm_gelu::MdlPairMM mm;mm.SetSubBlockIdx(0);
        mm.Init(static_cast<const TCubeTiling*>(nullptr),&pipe);
        gmm_gelu::MdlPartial4Producer op(mm,t);
        op.Init(x,weight,groupList,workspace);op.Process();
    }
    // All scheduled AIC and AIV workers, including idle workers, reach this once.
    // Reuse native reserved11..14. SDK/PIPE_ALL closes FIX before GM publication.
    AscendC::SyncAll<false>();
    if ASCEND_IS_AIV {
        gmm_gelu::MdlPartial4Reducer op(pipe,t);
        op.Init(scale,groupList,y,workspace);op.Process();
    }
}
// HT55_B07_PARTIAL4_REFUSAL_ENTRIES_END
// FullA64_ENTRIES_BEGIN
__attribute__((aligned(64))) __global__ __mix__(1,2) void GmmCubeFullA64Complete(GM_ADDR x,GM_ADDR weight,
    GM_ADDR scale,GM_ADDR groupList,GM_ADDR y,__kfc_workspace__ GM_ADDR workspace,GM_ADDR tilingGm)
{
    AscendC::TPipe pipe;gmm_gelu::Tiling t;gmm_gelu::CopyTilingHeader(t,tilingGm);
    if ASCEND_IS_AIC {
        gmm_gelu::FullA64FullAMM mm;mm.SetSubBlockIdx(0);
        mm.Init(static_cast<const TCubeTiling*>(nullptr),&pipe);
        gmm_gelu::FullA64Producer op(mm,pipe,t);
        op.Init(x,weight,groupList,workspace);op.Process();
    }
    if ASCEND_IS_AIV {
        // Only original Resident-qualified Host calls enter this route.
        gmm_gelu::FullA64ResidentConsumer op(pipe,t);
        op.Init(scale,groupList,y,workspace);op.Process();
    }
}
// FullA64_ENTRIES_END

// SINGLE_FULLA64_K128_B2_BEGIN
namespace gmm_gelu {

// FullA64 K128 paired L0 ping-pong; retain the original K256 L1 panels.
static __aicore__ inline constexpr MatmulConfig FullA64K128B2Config() {
    MatmulConfig cfg=FullA64FullAConfig();
    cfg.basicK=128;
    return cfg;
}
static __aicore__ inline constexpr auto FullA64K128B2Tiling() {
    auto t=AscendC::GetMatmulApiTiling<FullAType,BType,CType,BiasType,
        MatmulPairShape<64,256,1024>,MatmulPairShape<64,256,256>,
        MatmulPairShape<64,256,128>>(FullA64K128B2Config());
    t.dbL0A=2;t.dbL0B=2;t.dbL0C=1;
    t.shareL0CSize=64*256*sizeof(int32_t);
    return t;
}
constexpr auto kFullA64K128B2=FullA64K128B2Tiling();
static_assert(kFullA64K128B2.cfg.doMultiDataLoad && !kFullA64K128B2.cfg.doNorm &&
    kFullA64K128B2.cfg.scheduleType==ScheduleType::OUTER_PRODUCT &&
    kFullA64K128B2.cfg.iterateOrder==IterateOrder::ORDER_N,"retain FullA MDL policy");
static_assert(kFullA64K128B2.singleCoreM==64 && kFullA64K128B2.singleCoreN==256 &&
    kFullA64K128B2.singleCoreK==1024 && kFullA64K128B2.baseM==64 &&
    kFullA64K128B2.baseN==256 && kFullA64K128B2.baseK==128,"actual K128 table bound to MM");
static_assert(kFullA64K128B2.stepM==1 && kFullA64K128B2.stepN==1 &&
    kFullA64K128B2.stepKa==2 && kFullA64K128B2.stepKb==2 &&
    kFullA64K128B2.depthA1==4 && kFullA64K128B2.depthB1==4,"retain K256 L1 panels with K128 fragments");
static_assert(kFullA64K128B2.dbL0A==2 && kFullA64K128B2.dbL0B==2 &&
    kFullA64K128B2.dbL0C==1 && 2*64*128<=65536 && 2*256*128==65536,
    "joint SDK L0 ping-pong with two real 32768-byte B2 banks");
static_assert(kFullA64K128B2.shareL1Size==4*256*128+4*256*sizeof(uint64_t) &&
    kFullA64K128B2.shareL1Size==139264 && kFullA64K128B2.shareL1Size+64*1024==204800 &&
    kFullA64K128B2.shareL1Size+64*1024<=524288,"SDK B1 plus quant reserve plus external A live L1");
static_assert(kFullA64K128B2.shareL0CSize==65536 && 2*64*256*sizeof(int32_t)==131072 &&
    kFullA64K128B2.transLength==65536 && kFullA64K128B2.shareUbSize==0,
    "single C0 queue retains OUTER lenFactor2 capacity and original transfer");
static_assert(!AscendC::NoTailM(kFullA64K128B2) && !AscendC::NoTailN(kFullA64K128B2) &&
    !AscendC::NoTailK(kFullA64K128B2) && !AscendC::IsBasicK(kFullA64K128B2),"all actual tails retained");
using FullA64K128B2MM=matmul::MatmulImpl<FullAType,BType,CType,BiasType,kFullA64K128B2,
    AscendC::MatmulCallBackFunc<nullptr,nullptr,nullptr>,AscendC::Impl::Detail::GmmPairMdlPolicy>;

class FullA64K128B2Producer {
public:
    __aicore__ inline FullA64K128B2Producer(FullA64K128B2MM& mm,AscendC::TPipe& pipe,const Tiling& t)
        :mm_(mm),pipe_(pipe),t_(t) {}
    __aicore__ inline void Init(GM_ADDR x,GM_ADDR w,GM_ADDR groups,GM_ADDR workspace) {
        x_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
        w_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(w));
        groups_.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups));
        c_.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(workspace));
        core_=AscendC::GetBlockIdx();
        pipe_.InitBuffer(aScm_,1,64*1024*sizeof(int8_t));
        aReadDone_=pipe_.AllocEventID<AscendC::HardEvent::MTE1_MTE2>();
    }
    __aicore__ inline void Process() {
        FullA64JobIterator<GlobalTensor<int64_t>> it(t_,groups_,core_);FullA64Job job;
        while(it.Next(job)) {
            auto a=aScm_.AllocTensor<int8_t>();
            // Exact physical64x1024 buffer, NOT claimed roundK-only clear.
            // Covers all missing M rows/K lanes, including one-row groups.
            auto zero=a.ReinterpretCast<uint16_t>();
            AscendC::InitConstValue(zero,AscendC::InitConstValueParams<uint16_t>{1,2048,0,0});
            AscendC::PipeBarrier<PIPE_MTE2>();
            AscendC::Nd2NzParams p{};
            p.ndNum=1;p.nValue=job.curM;p.dValue=t_.k;p.srcDValue=t_.k;
            p.dstNzC0Stride=64;p.dstNzNStride=1;
            AscendC::DataCopy(a,x_[static_cast<uint64_t>(job.row)*t_.k],p);
            aScm_.EnQue(a);a=aScm_.DeQue<int8_t>();
            for(uint32_t n=0;n<job.outputs;++n) {
                const uint32_t col=job.col+n*256,curN=Min(256,t_.n-col);
                Produce(job.expert,col,job.curM,curN,a);
            }
            // Independent last-A-read edge after BOTH real N outputs.
            AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(aReadDone_);
            AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(aReadDone_);
            aScm_.FreeTensor(a);
        }
        const uint32_t pending=Min(tileCount_,kSlots);
        for(uint32_t i=0;i<pending;++i) {
            const uint32_t slotIdx=(tileCount_-pending+i)%kSlots;
            AscendC::CrossCoreWaitFlag(kFree+slotIdx);
        }
        mm_.End();pipe_.ReleaseEventID<AscendC::HardEvent::MTE1_MTE2>(aReadDone_);
    }
private:
    __aicore__ inline void Produce(uint32_t e,uint32_t col,uint32_t curM,uint32_t curN,
        const LocalTensor<int8_t>& a) {
        const uint32_t slotIdx=tileCount_%kSlots;
        const uint64_t slot=(static_cast<uint64_t>(core_)*kSlots+slotIdx)*64*256;
        if(tileCount_>=kSlots) AscendC::CrossCoreWaitFlag(kFree+slotIdx);
        // Physical A orgM64/orgKa1024 matches NZ/TSCM and constant capacity.
        // B actual K/N, logical K and compact C pitch remain actual values.
        mm_.SetOrgShape(64,t_.n,1024,t_.k,curN);
        mm_.SetSingleShape(curM,curN,t_.k);
        mm_.SetTensorA(a);
        mm_.SetTensorB(w_[static_cast<uint64_t>(e)*t_.k*t_.n+col]);
        while(mm_.Iterate()) mm_.GetTensorC(c_[slot],0,false);
        AscendC::CrossCoreSetFlag<2,PIPE_FIX>(kReady+slotIdx);++tileCount_;
    }
    FullA64K128B2MM& mm_;AscendC::TPipe& pipe_;const Tiling& t_;
    GlobalTensor<int8_t> x_,w_;GlobalTensor<int64_t> groups_;GlobalTensor<int32_t> c_;
    AscendC::TSCM<AscendC::TPosition::GM,1,&kFullAScmConfig> aScm_;
    AscendC::TEventID aReadDone_;uint32_t core_=0,tileCount_=0;
};
}
__attribute__((aligned(64))) __global__ __mix__(1,2) void GmmCubeFullA64K128B2Complete(GM_ADDR x,GM_ADDR weight,
    GM_ADDR scale,GM_ADDR groupList,GM_ADDR y,__kfc_workspace__ GM_ADDR workspace,GM_ADDR tilingGm)
{
    AscendC::TPipe pipe;gmm_gelu::Tiling t;gmm_gelu::CopyTilingHeader(t,tilingGm);
    if ASCEND_IS_AIC {
        gmm_gelu::FullA64K128B2MM mm;mm.SetSubBlockIdx(0);
        mm.Init(static_cast<const TCubeTiling*>(nullptr),&pipe);
        gmm_gelu::FullA64K128B2Producer op(mm,pipe,t);
        op.Init(x,weight,groupList,workspace);op.Process();
    }
    if ASCEND_IS_AIV {
        // Only original Resident-qualified Host calls enter this route.
        gmm_gelu::FullA64ResidentConsumer op(pipe,t);
        op.Init(scale,groupList,y,workspace);op.Process();
    }
}

namespace gmm_gelu {
// Only the original FullA64 Host provenance calls this private selector.
// Compare logical input loads, not HBM traffic or predicted execution time.
// HT55_L13_FULLB_COARSE_STREAM_BEGIN
static __aicore__ inline constexpr MatmulConfig FullBCoarseStreamConfig()
{
    auto cfg = MdlPairConfig();
    cfg.singleCoreM = 1024; cfg.singleCoreN = 256; cfg.singleCoreK = 1024;
    cfg.basicK = 128;
    cfg.iterateOrder = IterateOrder::ORDER_M;
    return cfg;
}
static __aicore__ inline constexpr auto FullBCoarseStreamTiling()
{
    auto t = AscendC::GetMatmulApiTiling<AType, FullBType, CType, BiasType,
        MatmulPairShape<1024,256,1024>, MatmulPairShape<64,256,128>,
        MatmulPairShape<64,256,128>>(FullBCoarseStreamConfig());
    // Two real K128 L0B banks; one M64 output has no coarse-C accumulation.
    t.dbL0A = 2; t.dbL0B = 2; t.dbL0C = 1;
    t.shareL0CSize = 64 * 256 * sizeof(int32_t);
    return t;
}
constexpr auto kFullBCoarseStream = FullBCoarseStreamTiling();
static_assert(kFullBCoarseStream.baseM == 64 && kFullBCoarseStream.baseN == 256 &&
    kFullBCoarseStream.baseK == 128 && kFullBCoarseStream.singleCoreK == 1024,
    "FullB persistent fixed M64/N256/K128 geometry");
static_assert(kFullBCoarseStream.dbL0A == 2 && kFullBCoarseStream.dbL0B == 2 &&
    2*64*128 <= 65536 && 2*256*128 == 65536,
    "FullB physical L0A/B capacities");
static_assert(kFullBCoarseStream.shareL1Size + 1024*256 <= 524288 &&
    kFullBCoarseStream.shareL0CSize == 65536 && 2*64*256*sizeof(int32_t) == 131072,
    "FullB SDK L1 plus external B and OUTER C lenFactor2 fit");
static_assert(kFullBCoarseStream.stepM == 1 && kFullBCoarseStream.stepN == 1 &&
    kFullBCoarseStream.stepKa == 1 && kFullBCoarseStream.stepKb == 1 &&
    kFullBCoarseStream.depthA1 == 2 && kFullBCoarseStream.depthB1 == 2 &&
    kFullBCoarseStream.shareL1Size == 20480 && kFullBCoarseStream.transLength == 65536 &&
    kFullBCoarseStream.shareUbSize == 0,
    "FullB SDK A1=16384, quant=4096; external B is not reallocated by SDK");
static_assert(!AscendC::NoTailM(kFullBCoarseStream) && !AscendC::NoTailN(kFullBCoarseStream) &&
    !AscendC::NoTailK(kFullBCoarseStream) && !AscendC::IsBasicK(kFullBCoarseStream),
    "FullB runtime M/N tails and complete K reduction");
static_assert(kFullBCoarseStream.singleCoreM==1024 &&
    kFullBCoarseStream.cfg.singleCoreM==1024 && kFullBSpan==1024 &&
    kFullBCoarseStream.cfg.iterateOrder==IterateOrder::ORDER_M &&
    !AscendC::IsBasicM(kFullBCoarseStream) && !AscendC::NoTailM(kFullBCoarseStream),
    "coarse runtime M must iterate every true M64 output including tails");
using FullBCoarseStreamMM = matmul::MatmulImpl<AType,FullBType,CType,BiasType,kFullBCoarseStream,
    AscendC::MatmulCallBackFunc<nullptr,nullptr,nullptr>,AscendC::Impl::Detail::GmmPairMdlPolicy>;

class FullBCoarseStreamAicProducer {
public:
    __aicore__ inline FullBCoarseStreamAicProducer(FullBCoarseStreamMM& mm,AscendC::TPipe& pipe,const Tiling& t)
        :mm_(mm),pipe_(pipe),t_(t) {}
    __aicore__ inline void Init(GM_ADDR x,GM_ADDR weight,GM_ADDR groups,GM_ADDR workspace)
    {
        x_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
        w_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(weight));
        groups_.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups));
        c_.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(workspace));
        core_=AscendC::GetBlockIdx();
        pipe_.InitBuffer(bScm_,1,1024*256*sizeof(int8_t));
        bReadDone_=pipe_.AllocEventID<AscendC::HardEvent::MTE1_MTE2>();
    }
    __aicore__ inline void Process()
    {
        FullBJobIterator<GlobalTensor<int64_t>> it(t_,groups_,core_);
        FullBJob job;
        while(it.Next(job)) {
            auto b=bScm_.AllocTensor<int8_t>();
            // Non-transposed logical KxcurN B, NZ [ceil(N/32),K/16,16,32].
            // dstNzC0Stride is the complete physical K, NOT the K128 panel.
            // Gate enforces K%32=0; ND2NZ zeros the final N32 block padding.
            AscendC::Nd2NzParams p{};
            p.ndNum=1; p.nValue=t_.k; p.dValue=job.curN; p.srcDValue=t_.n;
            p.dstNzC0Stride=t_.k; p.dstNzNStride=1;
            AscendC::DataCopy(b,w_[static_cast<uint64_t>(job.expert)*t_.k*t_.n+job.col],p);
            bScm_.EnQue(b); b=bScm_.DeQue<int8_t>();
            // Bind once per coarse epoch. SDK MLoop advances A by 64*trueK.
            mm_.SetOrgShape(t_.m,256,t_.k,t_.k,job.curN);
            mm_.SetSingleShape(job.curM,job.curN,t_.k);
            mm_.SetTensorA(x_[static_cast<uint64_t>(job.row)*t_.k]);
            mm_.SetTensorB(b);
            // ORDER_M disables M-axis L0DB; a single N tile cannot be N-db.
            // Thus each successful Iterate returns exactly one true M64 piece.
            while(mm_.Iterate()) {
                const uint32_t slotIdx=tileCount_%kSlots;
                const uint64_t slot=(static_cast<uint64_t>(core_)*kSlots+slotIdx)*64*256;
                // C0 may compute before this GM slot becomes read-free. Its own
                // SDK FIX_M lifetime remains independent of the AV read-free.
                if(tileCount_>=kSlots) AscendC::CrossCoreWaitFlag(kFree+slotIdx);
                // true => dstOffset zero and stride actual curN, NOT coarse M.
                mm_.GetTensorC(c_[slot],0,true);
                AscendC::CrossCoreSetFlag<2,PIPE_FIX>(kReady+slotIdx);
                ++tileCount_;
            }
            // The complete last B1->B2 read precedes any overwrite, independent
            // of GM-C free flags. This is the only lifetime of this resident B.
            AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(bReadDone_);
            AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(bReadDone_);
            bScm_.FreeTensor(b);
        }
        const uint32_t pending=Min(tileCount_,kSlots);
        for(uint32_t i=0;i<pending;++i) {
            const uint32_t slot=(tileCount_-pending+i)%kSlots;
            AscendC::CrossCoreWaitFlag(kFree+slot);
        }
        mm_.End();
        pipe_.ReleaseEventID<AscendC::HardEvent::MTE1_MTE2>(bReadDone_);
    }
private:
    FullBCoarseStreamMM& mm_; AscendC::TPipe& pipe_; const Tiling& t_;
    GlobalTensor<int8_t> x_,w_; GlobalTensor<int64_t> groups_; GlobalTensor<int32_t> c_;
    AscendC::TSCM<AscendC::TPosition::GM,1,&kFullAScmConfig> bScm_;
    AscendC::TEventID bReadDone_; uint32_t core_=0,tileCount_=0;
};
// HT55_L13_FULLB_COARSE_STREAM_END

// HT55_PADDED_COARSE_STREAM_PRODUCER_BEGIN
class FullBPaddedCoarseStreamAicProducer {
public:
    __aicore__ inline FullBPaddedCoarseStreamAicProducer(FullBCoarseStreamMM& mm,AscendC::TPipe& pipe,const Tiling& t)
        :mm_(mm),pipe_(pipe),t_(t) {}
    __aicore__ inline void Init(GM_ADDR x,GM_ADDR weight,GM_ADDR groups,GM_ADDR workspace)
    {
        x_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x));
        w_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(weight));
        groups_.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groups));
        c_.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(workspace));
        core_=AscendC::GetBlockIdx();
        pipe_.InitBuffer(bScm_,1,((t_.k+31U)&~31U)*256U*sizeof(int8_t));
        bReadDone_=pipe_.AllocEventID<AscendC::HardEvent::MTE1_MTE2>();
    }
    __aicore__ inline void Process()
    {
        FullBJobIterator<GlobalTensor<int64_t>> it(t_,groups_,core_);
        FullBJob job;
        while(it.Next(job)) {
            auto b=bScm_.AllocTensor<int8_t>();
            const uint32_t kPitch=(t_.k+31U)&~31U;
            const uint32_t tailK=kPitch-t_.k,nBlocks=CeilDiv(job.curN,32);
            // Each NZ N32 plane has Kpitch rows of32bytes. Only K-tail rows
            // can be read without a preceding GM copy; clear those exact rows.
            auto zero=b.ReinterpretCast<uint16_t>();
            AscendC::InitConstValue(zero[t_.k*16U],
                AscendC::InitConstValueParams<uint16_t>{static_cast<uint16_t>(nBlocks),
                    static_cast<uint16_t>(tailK),static_cast<uint16_t>(t_.k),0});
            AscendC::PipeBarrier<PIPE_MTE2>();
            // Actual copied rawK rows get their N32 width padding from ND2NZ.
            AscendC::Nd2NzParams p{};
            p.ndNum=1; p.nValue=t_.k; p.dValue=job.curN; p.srcDValue=t_.n;
            p.dstNzC0Stride=kPitch; p.dstNzNStride=1;
            AscendC::DataCopy(b,w_[static_cast<uint64_t>(job.expert)*t_.k*t_.n+job.col],p);
            bScm_.EnQue(b); b=bScm_.DeQue<int8_t>();
            // Bind once per coarse epoch. SDK MLoop advances A by 64*trueK.
            mm_.SetOrgShape(t_.m,256,t_.k,kPitch,job.curN);
            mm_.SetSingleShape(job.curM,job.curN,t_.k);
            mm_.SetTensorA(x_[static_cast<uint64_t>(job.row)*t_.k]);
            mm_.SetTensorB(b);
            // ORDER_M disables M-axis L0DB; a single N tile cannot be N-db.
            // Thus each successful Iterate returns exactly one true M64 piece.
            while(mm_.Iterate()) {
                const uint32_t slotIdx=tileCount_%kSlots;
                const uint64_t slot=(static_cast<uint64_t>(core_)*kSlots+slotIdx)*64*256;
                // C0 may compute before this GM slot becomes read-free. Its own
                // SDK FIX_M lifetime remains independent of the AV read-free.
                if(tileCount_>=kSlots) AscendC::CrossCoreWaitFlag(kFree+slotIdx);
                // true => dstOffset zero and stride actual curN, NOT coarse M.
                mm_.GetTensorC(c_[slot],0,true);
                AscendC::CrossCoreSetFlag<2,PIPE_FIX>(kReady+slotIdx);
                ++tileCount_;
            }
            // The complete last B1->B2 read precedes any overwrite, independent
            // of GM-C free flags. This is the only lifetime of this resident B.
            AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(bReadDone_);
            AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(bReadDone_);
            bScm_.FreeTensor(b);
        }
        const uint32_t pending=Min(tileCount_,kSlots);
        for(uint32_t i=0;i<pending;++i) {
            const uint32_t slot=(tileCount_-pending+i)%kSlots;
            AscendC::CrossCoreWaitFlag(kFree+slot);
        }
        mm_.End();
        pipe_.ReleaseEventID<AscendC::HardEvent::MTE1_MTE2>(bReadDone_);
    }
private:
    FullBCoarseStreamMM& mm_; AscendC::TPipe& pipe_; const Tiling& t_;
    GlobalTensor<int8_t> x_,w_; GlobalTensor<int64_t> groups_; GlobalTensor<int32_t> c_;
    AscendC::TSCM<AscendC::TPosition::GM,1,&kFullAScmConfig> bScm_;
    AscendC::TEventID bReadDone_; uint32_t core_=0,tileCount_=0;
};
static __aicore__ inline void RunFullBPaddedCoarseStreamAic(AscendC::TPipe& pipe,
    const Tiling& t,GM_ADDR x,GM_ADDR weight,GM_ADDR groupList,GM_ADDR workspace)
{
    FullBCoarseStreamMM mm;mm.SetSubBlockIdx(0);
    mm.Init(static_cast<const TCubeTiling*>(nullptr),&pipe);
    FullBPaddedCoarseStreamAicProducer op(mm,pipe,t);
    op.Init(x,weight,groupList,workspace);op.Process();
}
// HT55_PADDED_COARSE_STREAM_PRODUCER_END

static __aicore__ inline bool CanUseL13TrueKFullB1024(const Tiling& t,GM_ADDR groupList)
{
    if(t.reserved!=1 || t.tileM!=64 || t.tileN!=256 || t.cores==0 ||
       t.groups==0 || t.groups>128 || t.k==0 || t.k>1024 || t.k%32 || t.n==0) return false;
    GlobalTensor<int64_t> groups;
    groups.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(groupList));
    uint32_t previous=0;
    uint64_t m64Tiles=0,coarseTiles=0;
    for(uint32_t e=0;e<t.groups;++e) {
        const int64_t raw=groups.GetValue(e);
        if(raw<previous || raw>t.m) return false;
        const uint32_t end=static_cast<uint32_t>(raw),rows=end-previous;
        m64Tiles+=CeilDiv(rows,64);coarseTiles+=CeilDiv(rows,kFullBSpan);
        previous=end;
    }
    if(previous!=t.m) return false;
    const uint64_t nTiles=CeilDiv(t.n,256),nPairs=CeilDiv(static_cast<uint32_t>(nTiles),2);
    const uint64_t oldBLoads=m64Tiles*nTiles,newBLoads=coarseTiles*nTiles;
    // A real B reload must disappear, and coarse jobs must fill a core wave.
    if(newBLoads>=oldBLoads || newBLoads<t.cores) return false;
    const uint64_t parentAB=static_cast<uint64_t>(t.k)*
        (static_cast<uint64_t>(t.m)*nPairs+m64Tiles*t.n);
    const uint64_t residentAB=static_cast<uint64_t>(t.k)*
        (static_cast<uint64_t>(t.m)*nTiles+coarseTiles*t.n);
    return residentAB<parentAB;
}
}
__attribute__((aligned(64))) __global__ __mix__(1,2) void GmmCubeL13TrueKFullB1024Complete(GM_ADDR x,GM_ADDR weight,
    GM_ADDR scale,GM_ADDR groupList,GM_ADDR y,__kfc_workspace__ GM_ADDR workspace,GM_ADDR tilingGm)
{
    AscendC::TPipe pipe;gmm_gelu::Tiling t;gmm_gelu::CopyTilingHeader(t,tilingGm);
    // No parent MM/private buffers coexist with the mature true-K FullB path.
    if(gmm_gelu::CanUseL13TrueKFullB1024(t,groupList)) {
        if ASCEND_IS_AIC {
            AscendC::CrossCoreSetFlag<2,PIPE_MTE2>(0);
            gmm_gelu::FullBCoarseStreamMM mm;mm.SetSubBlockIdx(0);
            mm.Init(static_cast<const TCubeTiling*>(nullptr),&pipe);
            gmm_gelu::FullBCoarseStreamAicProducer op(mm,pipe,t);
            op.Init(x,weight,groupList,workspace);op.Process();
            AscendC::CrossCoreWaitFlag(7);
        }
        if ASCEND_IS_AIV {
            AscendC::CrossCoreWaitFlag(0);
            gmm_gelu::FullBPersistentAivConsumer op(pipe,t);
            op.Init(scale,groupList,y,workspace);op.Process();
            AscendC::CrossCoreSetFlag<2,PIPE_MTE3>(7);
        }
        return;
    }

    if ASCEND_IS_AIC {
        gmm_gelu::FullA64K128B2MM mm;mm.SetSubBlockIdx(0);
        mm.Init(static_cast<const TCubeTiling*>(nullptr),&pipe);
        gmm_gelu::FullA64K128B2Producer op(mm,pipe,t);
        op.Init(x,weight,groupList,workspace);op.Process();
    }
    if ASCEND_IS_AIV {
        // Only original Resident-qualified Host calls enter this route.
        gmm_gelu::FullA64ResidentConsumer op(pipe,t);
        op.Init(scale,groupList,y,workspace);op.Process();
    }
}
// SINGLE_FULLA64_K128_B2_END

namespace gmm_gelu {
// Common Host metadata contract. R comes from the interface, never hardcoded.
struct InputDesc {int64_t m,k,n,groups;};
enum class CompleteLeaf:uint32_t { Dynamic,Static,LowK,SmallK,RawSplit,WideRawSplit,NativeMixed,FullA,FullAK128,NStripe,Whole32,DirectDualC0,Compact32,Partial4,FullA64,Norm64Whole32Alias,FullA64K128B2,NarrowAlignedRaw };
struct ResourceCaps {
 static constexpr uint64_t kWhole32UbBytes=183296; // all live Q1+4FP32+Y+mask+GL
 static constexpr uint64_t kPartialBudgetBytes=64ULL*1024*1024; // private budget policy
 static constexpr uint32_t kWholeShareElems=8192,kFullA64KCap=1024;
};
static inline bool CanNorm64Whole32Alias(const Tiling& t){
 constexpr uint64_t liveUb=2ULL*8192*sizeof(int32_t)+2ULL*256*sizeof(float)+
     2ULL*8192*sizeof(half)+81920+1024+128*sizeof(int64_t);
 static_assert(liveUb==184320 && liveUb<184ULL*1024,"existing whole32 alias Q2 layout");
 return t.reserved==1 && t.tileM==64 && t.tileN==256 && t.cores>0 &&
     static_cast<uint64_t>((t.tileM+1)/2)*((t.tileN+15)/16*16)<=8192;
}
static inline bool CanRowTranspose(const InputDesc& d){
 const uint64_t wn=(d.n+31)/32*32;
 return d.m==1 && d.k<=16 && 16*wn<=4096 && d.k*wn<=4096 && (d.n+7)/8*8<=256;
}
static inline bool ChooseRowTranspose(const InputDesc& d){return CanRowTranspose(d) && d.groups>1 && d.k>=4;}
static inline bool CanWhole32(const Tiling& t){
 return t.reserved==1 && t.tileM==64 && t.tileN<=256 &&
  static_cast<uint64_t>((t.tileM+1)/2)*((t.tileN+15)/16*16)<=ResourceCaps::kWholeShareElems;
}
static inline bool ChooseWhole32(const Tiling& t){
 return CanWhole32(t) && ((static_cast<uint64_t>(t.m)+t.tileM-1)/t.tileM)*((t.n+t.tileN-1)/t.tileN)>=2ULL*t.cores;
}
static inline bool CanDirectDualC0(const Tiling& t){
 // Every K chunk is <=256 and 32-aligned; N/M are complete physical tiles.
 // Device checks actual uniform64 GL before any direct buffer/compute use.
 return t.reserved==1 && t.tileM==64 && t.tileN==256 && t.n%256==0 &&
  t.k%32==0 && t.k>=32 && t.k<=8192 && t.m==64ULL*t.groups && t.cores>0;
}
static inline bool ChooseDirect(const Tiling& t,bool nStripe,bool fullA,bool nativeMixed){
 // Explicit multi-K-slice preference, not a hardware necessity or case window.
 return CanDirectDualC0(t) && t.k>256 && !nStripe && !fullA && !nativeMixed;
}
static inline bool CanCompact32(const Tiling& t){return t.k<=128;}
static inline bool CanFullA64(const Tiling& t){return t.reserved==1 && t.tileM==64 && t.tileN==256 && t.k<=ResourceCaps::kFullA64KCap && (t.n+255)/256>=2;}
struct HostPlan {Tiling t;CompleteLeaf leaf;bool nStripeFallback;size_t userBytes,systemBytes;};
static inline HostPlan ChooseExecutionPlan(const InputDesc& d,int64_t availableCoreNum){
 const int64_t m=d.m,k=d.k,n=d.n,e=d.groups;
    Tiling t{};
    t.cores = static_cast<uint32_t>(availableCoreNum);
    t.groups = static_cast<uint32_t>(e);
    t.m = static_cast<uint32_t>(m);
    t.k = static_cast<uint32_t>(k);
    t.n = static_cast<uint32_t>(n);
    const int32_t baseM = static_cast<int32_t>(std::min<int64_t>(64, (m + 15) / 16 * 16));
    const int32_t baseN = static_cast<int32_t>(std::min<int64_t>(256, (n + 15) / 16 * 16));
    const int32_t baseK = static_cast<int32_t>(std::min<int64_t>(128, (k + 31) / 32 * 32));
    auto platform = platform_ascendc::PlatformAscendCManager::GetInstance();
    if (platform == nullptr) {
        throw std::runtime_error("GroupedMatmulGelu: platform initialization failed");
    }
    // ALIGNED_INPUTS_EARLY_HOST_BEGIN
    // Match the complete early-raw owner before any SDK tiling call. Alignment
    // storage is current-invocation data and remains inside the one kernel.
    const uint32_t earlyRawN = n <= 32 ? 32U : 128U;
    const uint64_t earlyRawNT = (static_cast<uint64_t>(n)+earlyRawN-1)/earlyRawN;
    const uint64_t earlyRawLower = ((static_cast<uint64_t>(m)+63)/64)*earlyRawNT;
    const uint64_t earlyInputBytes = (k%32!=0?static_cast<uint64_t>(m)*((k+31)/32*32):0)
        + (n%32!=0?static_cast<uint64_t>(e)*k*((n+31)/32*32):0);
    if(baseM==64 && n>=1 && n<256 && (static_cast<uint64_t>(k)+255)/256>=4 &&
       earlyRawLower>=static_cast<uint64_t>(availableCoreNum)) {
        const uint64_t nonemptyUpper=std::min<uint64_t>(t.groups,t.m);
        const uint64_t rawUpper=(nonemptyUpper+(t.m-nonemptyUpper)/64)*earlyRawNT;
        t.reserved=3;t.tileM=64;t.tileN=earlyRawN;
        t.cores=static_cast<uint32_t>(std::min<uint64_t>(availableCoreNum,rawUpper));
        const bool needsAlign=(k%32!=0 || n%32!=0) && earlyInputBytes<=1024ULL*1024*1024;
        const size_t ringBytes=static_cast<size_t>(t.cores)*kSlots*64*earlyRawN*sizeof(int32_t);
        return {t,needsAlign?CompleteLeaf::NarrowAlignedRaw:CompleteLeaf::Static,false,
            ringBytes+(needsAlign?static_cast<size_t>(earlyInputBytes):0),
            static_cast<size_t>(platform->GetLibApiWorkSpaceSize())};
    }
    // ALIGNED_INPUTS_EARLY_HOST_END
    // Full 64x256 base blocks define this general resource/algorithm domain.
    // Actual group boundaries, including one-row/empty groups, remain Device data.
    t.reserved = (m >= 64 && n >= 256 && k >= 256) ? 1U : 0U;
    // M10_HOST_BEGIN: only a shape-proven underfilled original Dynamic grid may reduce M.
    const int32_t parentM = t.reserved != 0 ? 64 : baseM;
    const int32_t parentN = t.reserved != 0 ? 256 : baseN;
    const uint64_t shapeGroups = std::min<uint64_t>(t.groups, t.m);
    const uint64_t parentTaskUpper = (shapeGroups + (t.m - shapeGroups) / parentM)
        * ((static_cast<uint64_t>(t.n) + parentN - 1) / parentN);
    int32_t gridM = parentM;
    int32_t gridN = parentN;
    if (t.reserved == 0 && parentTaskUpper < t.cores) {
        const int32_t mCandidates[] = {64, 32, 16};
        const int32_t nCandidates[] = {256, 128, 64, 32};
        bool found = false;
        bool bestFills = false;
        uint64_t bestLower = 0;
        uint64_t bestArea = 0;
        for (uint32_t mi = 0; mi < 3; ++mi) {
            const int32_t candidateM = mCandidates[mi];
            if (candidateM > parentM) { continue; }
            for (uint32_t ni = 0; ni < 4; ++ni) {
                // INT8 physical N is at least 32; an existing N16 grid stays N16.
                if (parentN < 32 && ni != 0) { break; }
                const int32_t candidateN = parentN < 32 ? parentN : nCandidates[ni];
                if (candidateN > parentN) { continue; }
                // Sum_e ceil(rows_e/Mtile) >= ceil(M/Mtile), even with empty groups.
                const uint64_t lower = ((static_cast<uint64_t>(t.m) + candidateM - 1) / candidateM)
                    * ((static_cast<uint64_t>(t.n) + candidateN - 1) / candidateN);
                const uint64_t area = static_cast<uint64_t>(candidateM) * candidateN;
                const bool fills = lower >= t.cores;
                bool better = !found || (fills && !bestFills);
                if (found && fills == bestFills) {
                    if (fills) {
                        better = area > bestArea || (area == bestArea && candidateN > gridN);
                    } else {
                        better = lower > bestLower || (lower == bestLower &&
                            (area < bestArea || (area == bestArea && candidateN > gridN)));
                    }
                }
                if (better) {
                    found = true;
                    bestFills = fills;
                    bestLower = lower;
                    bestArea = area;
                    gridM = candidateM;
                    gridN = candidateN;
                }
            }
        }
    }
    // A smaller M creates independent row blocks; pure N refinement is not adopted.
    const bool adaptiveGrid = t.reserved == 0 && gridM < parentM;
    if (adaptiveGrid) {
        // One full SDK tiling for the new grid; never splice resource fields.
        t.reserved = 0;
        matmul_tiling::MultiCoreMatmulTiling api(*platform);
        api.SetDim(1);
        api.SetAType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
            matmul_tiling::DataType::DT_INT8, false);
        api.SetBType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
            matmul_tiling::DataType::DT_INT8, false);
        api.SetCType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
            matmul_tiling::DataType::DT_INT32);
        api.SetBias(false);
        api.SetOrgShape(static_cast<int32_t>(m), static_cast<int32_t>(n), static_cast<int32_t>(k));
        api.SetShape(std::min<int32_t>(gridM, m), std::min<int32_t>(gridN, n), k);
        if (api.SetFixSplit(gridM, gridN, baseK) == -1) {
            throw std::runtime_error("GroupedMatmulGelu: adaptive fixed split rejected");
        }
        optiling::TCubeTiling mmHost;
        if (api.GetTiling(mmHost) == -1) {
            throw std::runtime_error("GroupedMatmulGelu: adaptive matmul tiling failed");
        }
        mmHost.SaveToBuffer(&t.mm, mmHost.GetDataSize());
        t.tileM = t.mm.baseM;
        t.tileN = t.mm.baseN;
        if (t.tileM == 0 || t.tileN == 0 || t.tileN > gmm_gelu::kMaxN) {
            throw std::runtime_error("GroupedMatmulGelu: unsupported adaptive tiling");
        }
    } else
    // M10_HOST_END: the original Static/Dynamic branch below is unchanged.

    if (t.reserved != 0) {
        // StaticMM obtains every resource field from kStaticNorm. t.mm remains
        // zero initialized; no dynamic metadata is spliced into this branch.
        t.tileM = 64;
        t.tileN = 256;
    } else {
        matmul_tiling::MultiCoreMatmulTiling api(*platform);
        api.SetDim(1);
        api.SetAType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
            matmul_tiling::DataType::DT_INT8, false);
        api.SetBType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
            matmul_tiling::DataType::DT_INT8, false);
        api.SetCType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
            matmul_tiling::DataType::DT_INT32);
        api.SetBias(false);
        api.SetOrgShape(static_cast<int32_t>(m), static_cast<int32_t>(n), static_cast<int32_t>(k));
        api.SetShape(std::min<int32_t>(baseM, m), std::min<int32_t>(baseN, n), k);
        api.SetFixSplit(baseM, baseN, baseK);
        optiling::TCubeTiling mmHost;
        if (api.GetTiling(mmHost) == -1) {
            throw std::runtime_error("GroupedMatmulGelu: matmul tiling failed");
        }
        mmHost.SaveToBuffer(&t.mm, mmHost.GetDataSize());
        t.tileM = t.mm.baseM;
        t.tileN = t.mm.baseN;
        if (t.tileM == 0 || t.tileN == 0 || t.tileN > gmm_gelu::kMaxN) {
            throw std::runtime_error("GroupedMatmulGelu: unsupported generated tiling");
        }
    }
    // Only shape metadata is read; group boundaries remain Device data.
    const uint64_t pairTaskLower = ((static_cast<uint64_t>(m) + 127) / 128)
        * ((static_cast<uint64_t>(n) + 255) / 256);
    // only for original Static and complete medium-K row-pair work.
    const bool underfilledMdl = t.reserved == 1 && k >= 1024 && k < 4096 && n >= 256
        && pairTaskLower >= (static_cast<uint64_t>(availableCoreNum) + 1) / 2
        && pairTaskLower < static_cast<uint64_t>(availableCoreNum);
    const bool lowerKFullwaveMdl = t.reserved == 1 && k >= 512 && k < 1024 && n >= 256 && n < 512
        && static_cast<uint64_t>(m) >= 128ULL * static_cast<uint64_t>(e)
        && pairTaskLower >= static_cast<uint64_t>(availableCoreNum);
    if ((t.reserved != 0 && k >= 1024 && n >= 256
        && (k < 4096 || m >= 256 * e)
        && pairTaskLower >= static_cast<uint64_t>(availableCoreNum)) || underfilledMdl || lowerKFullwaveMdl) {
        t.reserved = 2;
        // Expose the full coarse tile to the existing common AIV traversal.
        // Its 16-row UB batches stay unchanged; GM slots grow to 128x256.
        t.tileM = 128;
        t.tileN = 256;
    }
    // M9_HOST_END
    // M173_HOST_BEGIN: only the existing low-K MDL domain, natural B1 capacity
    // and a complete coarse wave. Groups remain Device data, including tails.
    const uint64_t bundleTaskLower = ((static_cast<uint64_t>(m) + 255) / 256)
        * ((static_cast<uint64_t>(n) + 255) / 256);
    if (lowerKFullwaveMdl && t.reserved == 2 && k <= 768
        && static_cast<uint64_t>(m) >= 256ULL * static_cast<uint64_t>(e)
        && bundleTaskLower >= static_cast<uint64_t>(availableCoreNum)) {
        t.tileM = 256; // API stays singleM128; common AIV and GM slots use M256.
    }
    // M173_HOST_END
    // M21_HOST_BEGIN: restrict the new pair to the original MDL domain.
    if (t.reserved == 2 && k >= 4096) {
        const uint64_t wideTaskLower = ((static_cast<uint64_t>(m) + 255) / 256)
            * ((static_cast<uint64_t>(n) + 127) / 128);
        if (m >= 512 * e && wideTaskLower >= static_cast<uint64_t>(availableCoreNum)) {
            t.reserved = 5;
            t.tileM = 256;
            t.tileN = 128;
        }
    }
    // M21_HOST_END
    // K3_SINGLE_ROW_HOST_BEGIN: bound complete SmallK padded output work.
    const uint64_t smallPaddedN = ((static_cast<uint64_t>(n) + 15) / 16) * 16;
    const uint64_t smallPaddedWork = static_cast<uint64_t>(m) * smallPaddedN;
    const bool extendedE1SmallK = e == 1 && m >= 1 && m <= 16 &&
        k >= 1 && k <= 3 && n >= 1 && n <= 256 &&
        smallPaddedWork > 256 && smallPaddedWork <= 4096;
    if ((m >= 1 && m <= 16 && k >= 1 && k <= 16
        && static_cast<uint64_t>(m) * smallPaddedN <= 256) || extendedE1SmallK) {
        t.reserved = 4;
        t.tileM = 16;
        t.tileN = 256;
        t.cores = 1; // One existing mix(1,2) block; no additional core.
    }
    // K3_SINGLE_ROW_HOST_END
    // M156_K_AXIS_HOST_BEGIN: independent K-axis resource and work capacity.
    const bool kAxisE1Dot = e == 1 && m >= 1 && m <= 16 && k >= 17 && k <= 1024 && n >= 1 &&
        static_cast<uint64_t>(m) * n <= 64 && static_cast<uint64_t>(k) * n <= 16384 &&
        static_cast<uint64_t>(m) * n * k <= 32768;
    if (kAxisE1Dot) {
        t.reserved = 4;
        t.tileM = 16;
        t.tileN = 256;
        t.cores = 1; // Same existing SmallKMeta mix(1,2) ABI; no extra kernel.
    }
    // M156_K_AXIS_HOST_END
    // At most g nonempty groups: sum ceil(rows/tileM) <= g+(M-g)/tileM.
    // This bound uses only shapes; actual group boundaries remain device data.
    const uint64_t g = std::min<uint64_t>(t.groups, t.m);
    // M19_HOST_BEGIN: only an underfilled Norm grid whose raw upper bound
    // still fits one wave. Bounds use shapes for arbitrary Device groups.
    if (t.reserved == 1) {
        const uint64_t oldUpper = (g + (t.m - g) / 64)
            * ((static_cast<uint64_t>(t.n) + 255) / 256);
        const uint64_t rawUpper = (g + (t.m - g) / 64)
            * ((static_cast<uint64_t>(t.n) + 127) / 128);
        if (oldUpper < static_cast<uint64_t>(availableCoreNum)
            && rawUpper <= static_cast<uint64_t>(availableCoreNum)) {
            t.reserved = 3;
            t.tileM = 64;
            t.tileN = 128;
        }
    }
    // M19_HOST_END
    // L1_LOWK_HOST_BEGIN: capacities admit short-K even below one AIV wave.
    const uint64_t lowKTaskLower = ((static_cast<uint64_t>(m) + 15) / 16)
        * ((static_cast<uint64_t>(n) + 255) / 256);
    const uint64_t lowKHalfRows=(static_cast<uint64_t>(m)+1)/2;
    const uint64_t lowKRowN=(static_cast<uint64_t>(n)+15)/16*16;
    const uint64_t lowKWeightN=(static_cast<uint64_t>(n)+31)/32*32;
    const bool capacityOwnerBeforeLowK=GMM_CHOOSE_CAPACITY_OWNER(m,k,n,e,
        lowKHalfRows,lowKRowN,lowKWeightN);
    if(k>=1 && k<=3 && t.reserved!=4 && !capacityOwnerBeforeLowK){
        t.reserved=6;t.tileM=16;t.tileN=256;
        const uint64_t nt=(static_cast<uint64_t>(n)+255)/256;
        const uint64_t l64=((static_cast<uint64_t>(m)+63)/64)*nt;
        const uint64_t u16=(g+(t.m-g)/16)*nt,u64=(g+(t.m-g)/64)*nt;
        const uint64_t av=2ULL*static_cast<uint64_t>(availableCoreNum);
        const uint64_t actualRowN=((std::min<int64_t>(n,256)+15)/16)*16;
        // Capacity plus nondecreasing useful AIV coverage, not mean group rows.
        if(64ULL*k<=256 && 64ULL*actualRowN<=4096 &&
           std::min<uint64_t>(l64,av)>=std::min<uint64_t>(lowKTaskLower,av) && u64<=u16)
            t.tileM=64;
        const uint64_t upper=(g+(t.m-g)/t.tileM)*nt;
        t.cores=static_cast<uint32_t>(std::max<uint64_t>(1,
            std::min<uint64_t>(availableCoreNum,(upper+1)/2)));
    }
    // L1_LOWK_HOST_END
    // S1_HOST_BEGIN: compare only the already selected identical raw64x128 body.
    // SDK/other-geometry work is unknown: retain its non-split/F preference.
    if(k>=4096 && t.reserved==3){
        const uint64_t splitUpper=(g+(t.m-g)/64)*((static_cast<uint64_t>(t.n)+127)/128);
        const uint64_t splitLower=((static_cast<uint64_t>(t.m)+63)/64)*
            ((static_cast<uint64_t>(t.n)+127)/128);
        const uint64_t kb=(static_cast<uint64_t>(t.k)+255)/256;
        const uint64_t rc=static_cast<uint64_t>(availableCoreNum);
        uint64_t best=((splitLower+rc-1)/rc)*kb,parts=1;
        // Producer uses floor(part*kb/P), reducer loops P; 2..kb is nonempty.
        // Ascending P and strict improvement retain fewer partials on ties.
        for(uint64_t p=2;p<=kb;++p){
            if(splitUpper*p*8192ULL*sizeof(int32_t)>ResourceCaps::kPartialBudgetBytes)continue;
            const uint64_t work=((splitUpper*p+rc-1)/rc)*((kb+p-1)/p);
            if(work<best){best=work;parts=p;}
        }
        if(parts>1){
            t.reserved=7;t.tileM=64;t.tileN=128;
            t.splitKParts=static_cast<uint32_t>(parts);
            t.splitKTileUpper=static_cast<uint32_t>(splitUpper);
            t.cores=static_cast<uint32_t>(std::min<uint64_t>(rc,splitUpper*parts));
        }
    }
    // S1_HOST_END
    // M24_DYNAMIC_RAW_ONEWAVE_BEGIN: complete metadata proof, real groups stay on Device.
    if (t.reserved == 0 && k >= 4096 && n > 128 && n < 256) {
        const uint64_t parentTaskLower = ((static_cast<uint64_t>(t.m) + t.tileM - 1) / t.tileM)
            * ((static_cast<uint64_t>(t.n) + t.tileN - 1) / t.tileN);
        const uint64_t rawTaskUpper = (g + (t.m - g) / 64)
            * ((static_cast<uint64_t>(t.n) + 127) / 128);
        if (parentTaskLower >= static_cast<uint64_t>(availableCoreNum)
            && rawTaskUpper <= static_cast<uint64_t>(availableCoreNum)) {
            t.reserved = 3;
            t.tileM = 64;
            t.tileN = 128;
        }
    }
    // M24_DYNAMIC_RAW_ONEWAVE_END
    if (t.reserved == 3 && k >= 4096) {
        const uint64_t wideSplitUpper = (g + (t.m - g) / 128)
            * ((static_cast<uint64_t>(t.n) + 127) / 128);
        const uint64_t wideKTiles = (static_cast<uint64_t>(t.k) + 255) / 256;
        if (wideSplitUpper > 0 && 2 * wideSplitUpper == static_cast<uint64_t>(availableCoreNum)
            && wideKTiles >= 2) {
            t.reserved = 8;
            t.tileM = 128;
            t.tileN = 128;
            t.splitKParts = 2;
            t.splitKTileUpper = static_cast<uint32_t>(wideSplitUpper);
            t.cores = static_cast<uint32_t>(availableCoreNum);
        }
    }
    // M25_WIDE_HOST_END
// M120_HOST_BEGIN
    // Full N pairs and K256 slices isolate the new producer lifetime. Actual
    // groups stay Device data; only actual Norm enters after the old selector.
    const uint64_t nStripeTaskLower = ((static_cast<uint64_t>(m) + 63) / 64)
        * (static_cast<uint64_t>(n) / 512);
    const bool nStripeEligible = (t.reserved == 1 || t.reserved == 2) && k % 256 == 0
        && n >= 512 && n % 512 == 0
        && nStripeTaskLower >= static_cast<uint64_t>(availableCoreNum);
// M120_HOST_END
// M127_HOST_BEGIN: metadata-only resource/geometry eligibility, actual groups stay Device data.
    const bool fullAEligible = t.reserved==2 && k>=1024 && k<=2048 && k%256==0 &&
        n>=512 && n%256==0 && m%128==0;
// M127_HOST_END
    // M163_CAPACITY_HOST_BEGIN: fill only the otherwise-Dynamic capacity domain.
    // All earlier specialized selectors have completed before this guard.
    const uint64_t capacityHalfRows = (static_cast<uint64_t>(m) + 1) / 2;
    const uint64_t capacityRowN = ((static_cast<uint64_t>(n) + 15) / 16) * 16;
    const uint64_t capacityWeightN = ((static_cast<uint64_t>(n) + 31) / 32) * 32;
    if (t.reserved == 0 && GMM_CHOOSE_CAPACITY_OWNER(m, k, n, e,
        capacityHalfRows, capacityRowN, capacityWeightN)) {
        t.reserved = 4;
        t.tileM = 16;
        t.tileN = 256; // Existing Host allocation metadata; not the new row width.
        t.cores = 1;
    }
    // M163_CAPACITY_HOST_END
    // LONG_K_NARROW_RAW_TILES_HOST_BEGIN
    // Complete raw K256 streaming for the otherwise-Dynamic one/two-N-tile
    // family. A full M64 wave avoids paying the raw setup on idle workers.
    // At least four K256 fragments amortize setup versus SDK K128 calls.
    // N<=32 uses the minimum legal INT8 transpose N32; other widths use
    // the established N128 producer with complete real tails and two slots.
    // The original Static N256 boundary and every specialized owner stay.
    const uint32_t narrowRawN = n <= 32 ? 32U : 128U;
    const uint64_t narrowRawTasksLower = ((static_cast<uint64_t>(m) + 63) / 64)
        * ((static_cast<uint64_t>(n) + narrowRawN - 1) / narrowRawN);
    const uint64_t alignedInputBytes = (k%32!=0?static_cast<uint64_t>(m)*((k+31)/32*32):0)
        + (n%32!=0?static_cast<uint64_t>(e)*k*((n+31)/32*32):0);
    // The legal input limits bound this allocation to 768MiB; keep an explicit
    // 1GiB private allocation ceiling, with no input-value or point identity.
    const bool narrowRawSelected = t.reserved==0 && t.tileM==64 && n>=1 && n<=256 &&
        (static_cast<uint64_t>(k)+255)/256>=4 &&
        narrowRawTasksLower>=static_cast<uint64_t>(availableCoreNum);
    const bool narrowAligned = narrowRawSelected && (k%32!=0 || n%32!=0) &&
        alignedInputBytes<=1024ULL*1024*1024;
    if (narrowRawSelected) {
        t.reserved = 3;
        t.tileM = 64;
        t.tileN = narrowRawN;
    }
    // LONG_K_NARROW_RAW_TILES_HOST_END
    const uint64_t taskUpper = (g + (t.m - g) / t.tileM)
        * ((static_cast<uint64_t>(t.n) + t.tileN - 1) / t.tileN);
    // S1_CLAMP_BEGIN
    if (t.reserved != 7 && t.reserved != 8) {
    t.cores = static_cast<uint32_t>(std::min<uint64_t>(t.cores, taskUpper));
    }
    // S1_CLAMP_END
    // M174_HOST_BEGIN: preserve every original selector and the clamped C0.
    // Only otherwise-common Norm without NStripe or Resident enters MDL128.
    // back to Norm64. Host reserves the maximum slot size without reclamping.
    const uint64_t originalCommonCores = t.cores;
    const uint64_t normTaskLower = ((static_cast<uint64_t>(m) + 63) / 64)
        * ((static_cast<uint64_t>(n) + 255) / 256);
    if (t.reserved == 1 && t.tileM == 64 && t.tileN == 256 && !nStripeEligible
        && k >= 4096 && k <= 8192
        && normTaskLower < 2ULL * originalCommonCores
        && pairTaskLower >= (originalCommonCores + 1) / 2) {
        t.reserved = 2;
        t.tileM = 128;
        t.tileN = 256;
    }
    // M174_HOST_END
    // M212_HOST_BEGIN: necessary Native metadata only; all original selectors and C0 are final.
    const bool nativeMixedEligible = t.reserved == 2 && k >= 1024 && k <= 8192 &&
        !nStripeEligible &&
        static_cast<uint64_t>(m) < 128ULL * static_cast<uint64_t>(e);
    // M212_HOST_END

    // Descriptor capacity first; workload preference remains explicit policy.
    // Explicit single-wave low-latency policy, not a physical capacity bound.
    const uint64_t compactUpper=(g+(m-g)/32)*((n+63)/64);
    const bool compact=t.reserved==0 && CanCompact32(t) && m>=32 && n>=64 && compactUpper<=static_cast<uint64_t>(availableCoreNum);
    if(compact){t.tileM=32;t.tileN=64;t.reserved=1;t.cores=static_cast<uint32_t>(std::min<uint64_t>(availableCoreNum,compactUpper));}
    const uint64_t partialUpper=(g+(m-g)/128)*((n+255)/256),kBlocks=(k+255)/256;
    const bool partial=t.reserved==2 && t.tileM==128 && t.tileN==256 && !fullAEligible && !nStripeEligible && !nativeMixedEligible
        && kBlocks>=4 && partialUpper<static_cast<uint64_t>(availableCoreNum) && partialUpper*4>=static_cast<uint64_t>(availableCoreNum)
        && partialUpper*4*128*256*sizeof(int32_t)<=ResourceCaps::kPartialBudgetBytes;
    if(partial){t.splitKParts=4;t.splitKTileUpper=partialUpper;t.cores=static_cast<uint32_t>(std::min<uint64_t>(availableCoreNum,partialUpper*4));}
    const uint64_t reuseLower=((static_cast<uint64_t>(m)+63)/64)*(((n+255)/256+1)/2);
    const bool direct=!compact && !partial && ChooseDirect(t,nStripeEligible,fullAEligible,nativeMixedEligible);
    const bool reuse64=!compact && !partial && !direct && CanFullA64(t) && !nStripeEligible && !fullAEligible && !nativeMixedEligible && reuseLower>=static_cast<uint64_t>(availableCoreNum);
    if(reuse64){const uint64_t upper=(g+(m-g)/64)*(((n+255)/256+1)/2);t.cores=static_cast<uint32_t>(std::min<uint64_t>(availableCoreNum,upper));}
    CompleteLeaf leaf;
    if(narrowAligned)leaf=CompleteLeaf::NarrowAlignedRaw;
    else if(compact)leaf=CompleteLeaf::Compact32;
    else if(partial)leaf=CompleteLeaf::Partial4;
    else if(direct)leaf=CompleteLeaf::DirectDualC0;
    else if(reuse64)leaf=CompleteLeaf::FullA64;
    else if(ChooseWhole32(t))leaf=CompleteLeaf::Whole32;
    else if(t.reserved==8)leaf=CompleteLeaf::WideRawSplit;
    else if(t.reserved==7)leaf=CompleteLeaf::RawSplit;
    else if(t.reserved==6)leaf=CompleteLeaf::LowK;
    else if(t.reserved==4)leaf=CompleteLeaf::SmallK;
    else if(nativeMixedEligible)leaf=CompleteLeaf::NativeMixed;
    // K128 double-B descriptor is an explicit catalog preference for the wider
    // external K panel, not an E/M/K/N point tuple. Original K256 stays active.
    else if(fullAEligible && t.k>1024)leaf=CompleteLeaf::FullAK128;
    else if(fullAEligible)leaf=CompleteLeaf::FullA;
    else if(nStripeEligible)leaf=CompleteLeaf::NStripe;
    else leaf=t.reserved?CompleteLeaf::Static:CompleteLeaf::Dynamic;
    // Existing complete-A64 improves owners only while the M128 plan underfills.
    bool fullAUnderfillRefined = false;
    if(leaf==CompleteLeaf::FullA && t.k<=ResourceCaps::kFullA64KCap){
        const uint64_t bundles=(((static_cast<uint64_t>(n)+255)/256)+1)/2;
        const uint64_t l128=((static_cast<uint64_t>(m)+127)/128)*bundles;
        const uint64_t l64=((static_cast<uint64_t>(m)+63)/64)*bundles;
        Tiling smallPanel=t;
        smallPanel.tileM=64;smallPanel.tileN=256;smallPanel.reserved=1;
        if(CanFullA64(smallPanel) && l128<static_cast<uint64_t>(availableCoreNum) && l64>l128){
            const uint64_t upper=(g+(m-g)/64)*bundles;
            smallPanel.cores=static_cast<uint32_t>(std::min<uint64_t>(availableCoreNum,upper));
            t=smallPanel;leaf=CompleteLeaf::FullA64;
            fullAUnderfillRefined = true;
        }
    }
    // Fine-M task preference, never a claim that actual groups are <=64.
    // Only refine the already selected compatible NativeMixed family.
    if(leaf==CompleteLeaf::NativeMixed && !nStripeEligible && m<=64ULL*g &&
       ((static_cast<uint64_t>(m)+63)/64)*((static_cast<uint64_t>(n)+255)/256)>=2ULL*t.cores){
        Tiling norm=t;norm.tileM=64;norm.tileN=256;norm.reserved=1;
        if(CanNorm64Whole32Alias(norm)){
            const uint64_t upper=(g+(static_cast<uint64_t>(m)-g)/64)*
                ((static_cast<uint64_t>(n)+255)/256);
            norm.cores=static_cast<uint32_t>(std::min<uint64_t>(norm.cores,upper));
            t=norm;leaf=CompleteLeaf::Norm64Whole32Alias;
        }
    }

    if (fullAUnderfillRefined && leaf == CompleteLeaf::FullA64) {
        leaf = CompleteLeaf::FullA64K128B2;
    }
    // HT55_L6_HOST_ROUTE_COMPONENT_RECOVERY_BEGIN
    // Reuse the existing fullB-or-fullA64 entry; Device code remains untouched.
    // Bounds hold for every legal device GL, without reading any endpoints here.
    if(leaf==CompleteLeaf::Static && t.reserved==2 &&
       (t.tileM==128 || t.tileM==256) && t.tileN==256 && t.cores>0 &&
       t.groups>0 && t.groups<=128 && t.k>0 &&
       t.k<=ResourceCaps::kFullA64KCap && t.k%32==0) {
        const uint64_t rows=t.m,cols=t.n;
        const uint64_t nTiles=(cols+255)/256,nPairs=(nTiles+1)/2;
        const uint64_t m64Lower=(rows+63)/64;
        const uint64_t coarseLower=(rows+kFullBSpan-1)/kFullBSpan;
        const uint64_t coarseUpper=g+(rows-g)/kFullBSpan;
        // S64>=ceil(M/64), ceil(M/span)<=Sspan<=g+floor((M-g)/span).
        // Both logical A+B element counts share the same positive rawK factor.
        const uint64_t fullAABLower=rows*nPairs+m64Lower*cols;
        const uint64_t fullBABUpper=rows*nTiles+coarseUpper*cols;
        Tiling resident=t;resident.reserved=1;resident.tileM=64;resident.tileN=256;
        if(CanFullA64(resident) && coarseLower*nTiles>=t.cores &&
           coarseUpper<m64Lower && fullBABUpper<fullAABLower) {
            // This entry consumes header metadata and a real M64 two-slot ring.
            // Its existing Device selector keeps all legal GL fallback complete.
            t=resident;leaf=CompleteLeaf::FullA64;
        }
    }
    // HT55_L6_HOST_ROUTE_COMPONENT_RECOVERY_END
    // HT55_B07_PARTIAL4_WORKSPACE_BEGIN: only the existing Partial4 leaf changes storage.
    const size_t parentPartial4Bytes=static_cast<size_t>(t.splitKTileUpper)*4*128*256*sizeof(int32_t);
    const size_t partial4P1RingBytes=static_cast<size_t>(t.cores)*kSlots*128*256*sizeof(int32_t);
    const size_t partial4RefusalBytes=partial4P1RingBytes<=ResourceCaps::kPartialBudgetBytes
        ?std::max(parentPartial4Bytes,partial4P1RingBytes):parentPartial4Bytes;
    static_assert(kPartial4RefusalBudget==ResourceCaps::kPartialBudgetBytes,
        "B07 retains the existing partial allocation cap");
    // HT55_B07_PARTIAL4_WORKSPACE_END

    const size_t alignedRingBytes=static_cast<size_t>(t.cores)*kSlots*t.tileM*t.tileN*sizeof(int32_t);
    const size_t userBytes=narrowAligned?alignedRingBytes+static_cast<size_t>(alignedInputBytes)
        :partial?partial4RefusalBytes
        :t.reserved==8?static_cast<size_t>(t.splitKTileUpper)*t.splitKParts*128*128*sizeof(int32_t)
        :t.reserved==7?static_cast<size_t>(t.splitKTileUpper)*t.splitKParts*64*128*sizeof(int32_t)
        :static_cast<size_t>(t.cores)*kSlots*t.tileM*t.tileN*sizeof(int32_t);
    return {t,leaf,nStripeEligible,userBytes,static_cast<size_t>(platform->GetLibApiWorkSpaceSize())};
}
static inline void RequireAcl(aclError c){if(c!=ACL_SUCCESS)throw std::runtime_error("GroupedMatmulGelu ACL failure: "+std::to_string(c));}
class WorkspaceOwner {
public:
 explicit WorkspaceOwner(aclrtStream stream):stream_(stream){}
 WorkspaceOwner(const WorkspaceOwner&)=delete;WorkspaceOwner& operator=(const WorkspaceOwner&)=delete;
 ~WorkspaceOwner(){if(metadata_)aclrtFree(metadata_);if(workspace_)aclrtFree(workspace_);}
 void Bind(const HostPlan& p){RequireAcl(aclrtMalloc(&workspace_,p.userBytes+p.systemBytes,ACL_MEM_MALLOC_HUGE_FIRST));RequireAcl(aclrtMalloc(&metadata_,sizeof(Tiling),ACL_MEM_MALLOC_HUGE_FIRST));RequireAcl(aclrtMemcpy(metadata_,sizeof(Tiling),&p.t,sizeof(Tiling),ACL_MEMCPY_HOST_TO_DEVICE));}
 GM_ADDR Workspace()const{return (GM_ADDR)workspace_;}GM_ADDR Metadata()const{return (GM_ADDR)metadata_;}
 void Complete(){RequireAcl(aclrtSynchronizeStream(stream_));}
private:aclrtStream stream_;void* workspace_=nullptr;void* metadata_=nullptr;
};
} // namespace gmm_gelu
extern "C" void run_kernel(
    GM_ADDR x, const TensorGroupInfo& info_x,
    GM_ADDR weight, const TensorGroupInfo& info_weight,
    GM_ADDR scale, const TensorGroupInfo& info_scale,
    GM_ADDR group_list, const TensorGroupInfo& info_group_list,
    GM_ADDR y, const TensorGroupInfo& info_y,
    int64_t availableCoreNum, aclrtStream stream)
{
    using namespace gmm_gelu;
    // Host reads metadata only; group_list and all tensor values stay on NPU.
    if (info_x.numTensors != 1 || info_weight.numTensors != 1 ||
        info_scale.numTensors != 1 || info_group_list.numTensors != 1 ||
        info_y.numTensors != 1 || availableCoreNum <= 0) {
        throw std::runtime_error("GroupedMatmulGelu: invalid tensor/core metadata");
    }
    const auto& ix = info_x.tensors[0];
    const auto& iw = info_weight.tensors[0];
    const auto& is = info_scale.tensors[0];
    const auto& ig = info_group_list.tensors[0];
    const auto& iy = info_y.tensors[0];
    if (ix.numDims != 2 || iw.numDims != 3 || is.numDims != 2 ||
        ig.numDims != 1 || iy.numDims != 2 || ix.dtype != 3 || iw.dtype != 3 ||
        is.dtype != 0 || ig.dtype != 6 || iy.dtype != 1) {
        throw std::runtime_error("GroupedMatmulGelu: invalid shape or dtype");
    }
    const int64_t m = ix.shape[0], k = ix.shape[1];
    const int64_t e = iw.shape[0], n = iw.shape[2];
    if (m < 1 || m > 65536 || k < 1 || k > 8192 || e < 1 || e > 128 ||
        n < 1 || n > 4096 || iw.shape[1] != k || is.shape[0] != e ||
        is.shape[1] != n || ig.shape[0] != e || iy.shape[0] != m || iy.shape[1] != n) {
        throw std::runtime_error("GroupedMatmulGelu: inconsistent dimensions");
    }

    const InputDesc input{m,k,n,e};WorkspaceOwner owner(stream);
    if(ChooseRowTranspose(input)){
        // GMM_EARLY_DISPATCH_BEGIN
        GmmVectorRowComplete<<<1,nullptr,stream>>>(x,weight,scale,group_list,y,m,k,n,e);
        // GMM_EARLY_DISPATCH_END
        owner.Complete();return;
    }
    const uint64_t h=(m+1)/2,rn=(n+15)/16*16,wn=(n+31)/32*32,batch=(h*rn+63)/64*64;
    if(GMM_CHOOSE_TINY_OWNER(m,k,n,e,h,rn,wn,batch)){
        GmmVectorTinyComplete<<<1,nullptr,stream>>>(x,weight,scale,group_list,y,m,k,n);
        owner.Complete();return;
    }
    const HostPlan plan=ChooseExecutionPlan(input,availableCoreNum);const Tiling& t=plan.t;
    owner.Bind(plan);GM_ADDR ws=owner.Workspace();GM_ADDR tg=owner.Metadata();
    // GMM_LATE_DISPATCH_BEGIN: each mutually exclusive leaf is a whole business.
    switch(plan.leaf){
     case CompleteLeaf::NarrowAlignedRaw:GmmCubeNarrowAlignedRawComplete<<<t.cores,nullptr,stream>>>(x,weight,scale,group_list,y,ws,tg);break;
     case CompleteLeaf::FullA64K128B2:GmmCubeFullA64K128B2Complete<<<t.cores,nullptr,stream>>>(x,weight,scale,group_list,y,ws,tg);break;
     case CompleteLeaf::Compact32:GmmCubeCompactComplete<<<t.cores,nullptr,stream>>>(x,weight,scale,group_list,y,ws,tg);break;
     case CompleteLeaf::Partial4:GmmCubePartial4RefusalComplete<<<t.cores,nullptr,stream>>>(x,weight,scale,group_list,y,ws,tg);break;
     case CompleteLeaf::FullA64:GmmCubeL13TrueKFullB1024Complete<<<t.cores,nullptr,stream>>>(x,weight,scale,group_list,y,ws,tg);break;
     case CompleteLeaf::Whole32:GmmCubeWhole32Complete<<<t.cores,nullptr,stream>>>(x,weight,scale,group_list,y,ws,tg);break;
